tiverseid': 133276}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133577&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ba25444b-692d-4013-8a90-c2e2a4840157', 'multiverseId': 133577}, 'multiverseid': 133577}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133878&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3dd00b09-ab6d-4995-a161-e706a1fe43a8', 'multiverseId': 133878}, 'multiverseid': 133878}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134179&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '97038c38-6b45-40a5-8b35-9aac71a64f35', 'multiverseId': 134179}, 'multiverseid': 134179}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132373&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '47dfffab-5ddc-45de-a5ae-dfef6d70b58c', 'multiverseId': 132373}, 'multiverseid': 132373}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132976&type=card', 'language': 'German', 'identifiers': {'scryfallId': '452e5c63-83c5-4790-a577-2c06d85f0538', 'multiverseId': 132976}, 'multiverseid': 132976}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134481&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'cabb4cd1-ab85-418d-bc73-76dce2c2d474', 'multiverseId': 134481}, 'multiverseid': 134481}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132675&type=card', 'language': 'French', 'identifiers': {'scryfallId': '9740adc2-6111-4622-bc55-6325b4c0692f', 'multiverseId': 132675}, 'multiverseid': 132675}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133277&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '8e563efc-cf0d-4ebb-ad6d-71619145db56', 'multiverseId': 133277}, 'multiverseid': 133277}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133578&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '2e451c38-4261-4230-a79b-6beed454e29e', 'multiverseId': 133578}, 'multiverseid': 133578}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133879&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b56c9b53-c9f8-4564-89a3-9531dd635e84', 'multiverseId': 133879}, 'multiverseid': 133879}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134180&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '6504b027-0f5f-49b0-9f0f-182e68c2103e', 'multiverseId': 134180}, 'multiverseid': 134180}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132374&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '32e140bd-9066-49de-8ba9-ebe6e29960d7', 'multiverseId': 132374}, 'multiverseid': 132374}]", "[{'name': 'Ith, Hoher Arkanier', 'text': 'Wachsamkeit\\n{T}: Enttappe eine angreifende Kreatur deiner Wahl. Verhindere allen Kampfschaden, der in diesem Zug dieser Kreatur zugefügt und von ihr zugefügt würde.\\nAussetzen 4 {W}{U}', 'type': 'Legendäre Kreatur — Mensch, Zauberer', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132977&type=card', 'language': 'German', 'identifiers': {'scryfallId': '06ae7876-6834-47c5-be42-bbdd6b3334a7', 'multiverseId': 132977}, 'multiverseid': 132977}, {'name': 'Ith, gran arcanista', 'text': 'Vigilancia.\\n{T}: Endereza la criatura atacante objetivo. Prevén todo el daño de combate que fuera a hacer y que se le fuera a hacer a esa criatura este turno.\\nSuspender 4—{W}{U}.', 'type': 'Criatura legendaria — Hechicero humano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134482&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '39dc7866-c63b-49e7-af60-3f56b71a0641', 'multiverseId': 134482}, 'multiverseid': 134482}, {'name': 'Ith, grand arcaniste', 'text': 'Vigilance\\n{T} : Dégagez la créature attaquante ciblée. Prévenez toutes les blessures de combat qui devraient être infligées à et par cette créature ce tour-ci.\\nSuspension 4 — {W}{U}', 'type': 'Créature légendaire : humain et sorcier', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132676&type=card', 'language': 'French', 'identifiers': {'scryfallId': '946144fe-7bf2-4536-8c17-f1d97e4108b5', 'multiverseId': 132676}, 'multiverseid': 132676}, {'name': 'Ith, Sommo Arcanista', 'text': 'Cautela\\n{T}: STAPpa una creatura attaccante bersaglio. Previeni tutto il danno da combattimento che verrebbe inflitto a e da quella creatura in questo turno.\\nSospendere 4—{W}{U}', 'type': 'Creatura Leggendaria — Mago Umano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133278&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '238e7de8-3935-4589-ac14-c0b6252b6552', 'multiverseId': 133278}, 'multiverseid': 133278}, {'name': '高位の秘儀術師、イス', 'text': '警戒\\n{T}：攻撃しているクリーチャー１体を対象とし、それをアンタップする。 このターン、それに与えられる戦闘ダメージとそれが与える戦闘ダメージをすべて軽減し、０にする。\\n待機 ４―{W}{U}', 'type': '伝説のクリーチャー — 人間・ウィザード', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133579&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '347986b7-168b-41bc-94b6-82e08018a389', 'multiverseId': 133579}, 'multiverseid': 133579}, {'name': 'Ith, Alto Arcanista', 'text': 'Vigilância\\n{T}: Desvire a criatura alvo atacante. Previna todo o dano de combate que seria causado a e causado por aquela criatura neste turno.\\nSuspender 4—{W}{U}', 'type': 'Criatura Lendária — Mago Humano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133880&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5483cf31-23eb-41ba-9763-a25216b824fb', 'multiverseId': 133880}, 'multiverseid': 133880}, {'name': 'Ис, Верховный Арканист', 'text': 'Бдительность\\n{T}: Разверните целевое атакующее существо. Предотвратите все боевые повреждения, которые будут нанесены им или ему на этом ходу.\\nОтсрочка 4—{W}{U}', 'type': 'Легендарное Существо — Человек Чародей', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134181&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'bb1d6383-d460-4861-9838-9c618e3e5015', 'multiverseId': 134181}, 'multiverseid': 134181}, {'name': '奥术大师伊斯', 'text': '警戒\\n{T}：重置目标进行攻击的生物。 于本回合中，防止该生物将受到与造成的所有战斗伤害。\\n延缓4～{W}{U}', 'type': '传奇生物～人类／法术师', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132375&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '6389cce7-5da2-4ce7-a766-317f51016c2b', 'multiverseId': 132375}, 'multiverseid': 132375}]", '[{\'name\': \'Ixidron\', \'text\': \'Sowie das Ixidron ins Spiel kommt, verdecke alle anderen Kreaturen außer Spielsteinen. Sie sind 2/2 Kreaturen.\\nStärke und Widerstandskraft des Ixidrons sind gleich der Anzahl an verdeckten Kreaturen im Spiel.\', \'type\': \'Kreatur — Illusion\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132979&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fb4d22f5-eca4-4048-86a9-79859ebf7ab0\', \'multiverseId\': 132979}, \'multiverseid\': 132979}, {\'name\': \'Íxidron\', \'text\': \'En cuanto Íxidron entre en juego, pon boca abajo todas las otras criaturas en juego que no sean fichas. Son criaturas 2/2.\\nTanto la fuerza como la resistencia de Íxidron son iguales al número de criaturas boca abajo que haya en juego.\', \'type\': \'Criatura — Ilusión\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134484&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ed1f271d-4d81-42cb-843b-e5ed7f267797\', \'multiverseId\': 134484}, \'multiverseid\': 134484}, {\'name\': \'Ixidron\', \'text\': "Au moment où Ixidron arrive en jeu, retournez toutes les autres créatures non-jeton en jeu face cachée. Ce sont des créatures 2/2.\\nLa force et l\'endurance d\'Ixidron sont chacune égale au nombre de créatures face cachée en jeu.", \'type\': \'Créature : illusion\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132678&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'18d11116-6dd5-4871-8dc9-058d8588b609\', \'multiverseId\': 132678}, \'multiverseid\': 132678}, {\'name\': \'Ixidron\', \'text\': \'Mentre Ixidron entra in gioco, gira a faccia in giù tutte le altre creature non pedina in gioco. Sono creature 2/2.\\nLa forza e la costituzione di Ixidron sono pari al numero di creature a faccia in giù in gioco.\', \'type\': \'Creatura — Illusione\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133280&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6cddcfdc-d58c-493f-a641-265db0afccc0\', \'multiverseId\': 133280}, \'multiverseid\': 133280}, {\'name\': \'イクシドロン\', \'text\': \'イクシドロンが場に出るに際し、場に出ている他のトークンでないクリーチャーをすべて裏向きにする。 それらは２/２のクリーチャーである。\\nイクシドロンのパワーとタフネスは、それぞれ場に出ている裏向きのクリーチャーの総数に等しい。\', \'type\': \'クリーチャー — イリュージョン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133581&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a831ed45-eaf6-4c9a-bd37-e15cd0eda1ff\', \'multiverseId\': 133581}, \'multiverseid\': 133581}, {\'name\': \'Ixidron\', \'text\': \'Conforme Ixidron entrar em jogo, vire para baixo a face de todas as outras criaturas que não sejam fichas em jogo. Elas serão criaturas 2/2.\\nO poder e a resistência de Ixidron são ambos iguais ao número de criaturas com a face voltada para baixo em jogo.\', \'type\': \'Criatura — Ilusão\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133882&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3be2c72c-1a20-4d67-9705-5c568cbf0932\', \'multiverseId\': 133882}, \'multiverseid\': 133882}, {\'name\': \'Иксидрон\', \'text\': \'При входе Иксидрона в игру, переверните все остальные существа (не фишки) лицом вниз. Все они являются существами 2/2.\\nСила и защита Иксидрона равны количеству существ в игре, лежащих лицом вниз.\', \'type\': \'Существо — Иллюзия\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134183&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'607677ad-9766-47af-821a-af9c5ee215df\', \'multiverseId\': 134183}, \'multiverseid\': 134183}, {\'name\': \'意塑影\', \'text\': \'于意塑影进场时，将场上所有非衍生物的其它生物翻为牌面朝下。 它们是2/2生物。\\n意塑影的力量与防御力各等同于场上牌面朝下生物的数量。\', \'type\': \'生物～虚影\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132377&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'471f83e2-f98e-4b96-aa65-85e82a5c1244\', \'multiverseId\': 132377}, \'multiverseid\': 132377}]', '[{\'name\': \'Jagende Monstrosität\', \'text\': \'Wenn du einen Kreaturenzauber spielst, opfere die Jagende Monstrosität.\', \'type\': \'Kreatur — Schrecken\', \'flavor\': \'Die meisten Lebewesen waren nach der phyrexianischen Invasion geschwächt und gelähmt, aber einige wurden noch schrecklicher als je zuvor.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133073&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f0b71e01-8cf3-4c6c-9aae-da175b824476\', \'multiverseId\': 133073}, \'multiverseid\': 133073}, {\'name\': \'Monstruosidad resbaladiza\', \'text\': \'Cuando juegues un hechizo de criatura, sacrifica la Monstruosidad resbaladiza.\', \'type\': \'Criatura — Horror\', \'flavor\': \'La mayoría de los seres vivos fueron debilitados y enmagrecidos por la invasión pirexiana, pero algunos crecieron más terribles que nunca.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134578&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3a86545f-2e6e-4fec-ac3b-4ea35c37329c\', \'multiverseId\': 134578}, \'multiverseid\': 134578}, {\'name\': \'Monstruosité fuyarde\', \'text\': \'Quand vous jouez un sort de créature, sacrifiez la Monstruosité fuyarde.\', \'type\': \'Créature : horreur\', \'flavor\': "Bon nombre de formes vivantes furent affaiblies dans les temps qui suivirent l\'invasion phyrexiane, mais certaines devinrent encore plus horribles qu\'elles ne l\'étaient.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132772&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9f8dd269-7747-42c3-9905-3520bd15c5fa\', \'multiverseId\': 132772}, \'multiverseid\': 132772}, {\'name\': \'Mostruosità Svolazzante\', \'text\': \'Quando giochi una magia creatura, sacrifica la Mostruosità Svolazzante.\', \'type\': \'Creatura — Orrore\', \'flavor\': "Molti esseri viventi erano indeboliti e stentati nel disastroso periodo successivo all\'invasione di Phyrexia, ma alcuni divennero più orribili che mai.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133374&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6ea1c1d9-d1c0-41d7-89cd-c6fe1af6e858\', \'multiverseId\': 133374}, \'multiverseid\': 133374}, {\'name\': \'走り回る大怪物\', \'text\': \'あなたがクリーチャー呪文をプレイしたとき、走り回る大怪物を生け贄に捧げる。\', \'type\': \'クリーチャー — ホラー\', \'flavor\': \'ほとんどの生き物は、ファイレクシアの侵攻の破壊的な影響で弱体化し、あるいは成長が止まってしまったが、中にはさらに恐ろしく成長したものもいる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133675&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'409d92ab-3c08-4cd5-904f-5bfbc185106b\', \'multiverseId\': 133675}, \'multiverseid\': 133675}, {\'name\': \'Monstruosidade Saltitante\', \'text\': \'Quando jogar uma mágica de criatura, sacrifique Monstruosidade Saltitante.\', \'type\': \'Criatura — Horror\', \'flavor\': \'A maioria das coisas vivas estava enfraquecida e atrofiada na conclusão da invasão phyrexiana, mas outras cresceram de forma mais horripilante que nunca.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133976&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'18b2b844-bca0-4b63-a82c-bea451e24590\', \'multiverseId\': 133976}, \'multiverseid\': 133976}, {\'name\': \'Скользящее Чудовище\', \'text\': \'Когда вы играете заклинание существа, пожертвуйте Скользящее Чудовище.\', \'type\': \'Существо — Ужас\', \'flavor\': \'Большая часть живых существ теряла силы и чахла от разрушительных последствий Фирексианского вторжения, но некоторые становились еще более ужасными.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134277&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8e652b41-5861-4abc-bb84-f3b5f46a03ca\', \'multiverseId\': 134277}, \'multiverseid\': 134277}, {\'name\': \'掠行巨兽\', \'text\': \'当你使用生物咒语时，牺牲掠行巨兽。\', \'type\': \'生物～惊惧兽\', \'flavor\': \'非瑞克西亚大侵攻所引致的摧毁性影响，让许多生灵变得衰弱而瘦小，但少数却变得更加奇形可怖。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132471&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0f1d445c-c588-4db7-b29c-d7abe4970ea5\', \'multiverseId\': 132471}, \'multiverseid\': 132471}]', '[{\'name\': \'Jaya Ballard, Magier für alle Fälle\', \'text\': \'{R}, {T}, wirf eine Karte aus deiner Hand ab: Zerstöre eine blaue bleibende Karte deiner Wahl.\\n{1}{R}, {T}, wirf eine Karte aus deiner Hand ab: Jaya Ballard fügt einer Kreatur oder einem Spieler deiner Wahl 3 Schadenspunkte zu. Eine Kreatur, der auf diese Weise Schaden zugefügt wurde, kann in diesem Zug nicht regeneriert werden.\\n{5}{R}{R}, {T}, wirf eine Karte aus deiner Hand ab: Jaya Ballard fügt allen Kreaturen und allen Spielern 6 Schadenspunkte zu.\', \'type\': \'Legendäre Kreatur — Mensch, Spruchwandler\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132980&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a2b22c8c-1de9-4986-b83f-e089fbc3d9ec\', \'multiverseId\': 132980}, \'multiverseid\': 132980}, {\'name\': \'Jaya Ballard, auxiliar de mago\', \'text\': \'{R}, {T}, descartar una carta: Destruye el permanente azul objetivo.\\n{1}{R}, {T}, descartar una carta: Jaya Ballard, auxiliar de mago hace 3 puntos de daño a la criatura o jugador objetivo. Una criatura que recibió daño de esta manera no puede ser regenerada este turno.\\n{5}{R}{R}, {T}, descartar una carta: Jaya Ballard hace 6 puntos de daño a cada criatura y jugador.\', \'type\': \'Criatura legendaria — Cambiahechizos humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134485&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'36bce810-7ff9-4d44-9925-a073141e35d6\', \'multiverseId\': 134485}, \'multiverseid\': 134485}, {\'name\': \'Jaya Ballard, mage de force\', \'text\': "{R}, {T}, défaussez-vous d\'une carte : Détruisez le permanent bleu ciblé.\\n{1}{R}, {T}, défaussez-vous d\'une carte : Jaya Ballard, mage de force inflige 3 blessures à une cible, créature ou joueur. Une créature blessée de cette manière ne peut pas être régénérée ce tour-ci.\\n{5}{R}{R}, {T}, défaussez-vous d\'une carte : Jaya Ballard inflige 6 blessures à chaque créature et à chaque joueur.", \'type\': \'Créature légendaire : humain et sortisan\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132679&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fcb3b8bf-4554-4c67-b422-ecb07fe70c66\', \'multiverseId\': 132679}, \'multiverseid\': 132679}, {\'name\': \'Jaya Ballard, Maga Specialista\', \'text\': \'{R}, {T}, Scarta una carta: Distruggi un permanente blu bersaglio.\\n{1}{R}, {T}, Scarta una carta: Jaya Ballard, Maga Specialista infligge 3 danni a una creatura o a un giocatore bersaglio. Una creatura a cui sia stato inflitto danno in questo modo non può essere rigenerata in questo turno.\\n{5}{R}{R}, {T}, Scarta una carta: Jaya Ballard infligge 6 danni a ogni creatura e a ogni giocatore.\', \'type\': \'Creatura Leggendaria — Mutamagia Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133281&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'235ac45a-5bca-4bed-b7ae-4532a3aefd34\', \'multiverseId\': 133281}, \'multiverseid\': 133281}, {\'name\': \'特務魔道士ヤヤ・バラード\', \'text\': \'{R}, {T}, カードを１枚捨てる：青のパーマネント１つを対象とし、それを破壊する。\\n{1}{R}, {T}, カードを１枚捨てる：クリーチャー１体かプレイヤー１人を対象とする。特務魔道士ヤヤ・バラードはそれに３点のダメージを与える。 このターン、これによりダメージを与えられたクリーチャーは再生できない。\\n{5}{R}{R}, {T}, カードを１枚捨てる：特務魔道士ヤヤ・バラードは、各クリーチャーと各プレイヤーに６点のダメージを与える。\', \'type\': \'伝説のクリーチャー — 人間・スペルシェイパー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133582&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e46aedae-da39-43bd-91d9-0ee01f48fadf\', \'multiverseId\': 133582}, \'multiverseid\': 133582}, {\'name\': \'Jaya Ballard, Mago Especialista\', \'text\': \'{R}, {T}, Descarte um card: Destrua a permanente alvo azul.\\n{1}{R}, {T}, Descarte um card: Jaya Ballard, Mago Especialista causa 3 pontos de dano à criatura alvo ou ao jogador alvo. Uma criatura que sofreu dano desta maneira não pode ser regenerada neste turno.\\n{5}{R}{R}, {T}, Descarte um card: Jaya Ballard causa 6 pontos de dano a cada criatura e a cada jogador.\', \'type\': \'Criatura Lendária — Magimodelador Humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133883&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e21d5e2c-43ea-441c-a726-646e4b776732\', \'multiverseId\': 133883}, \'multiverseid\': 133883}, {\'name\': \'Джайя Баллард, Маг-Десятник\', \'text\': \'{R}, {T}, Сбросьте карту: Уничтожьте целевой синий перманент.\\n{1}{R}, {T}, Сбросьте карту: Джайя Баллард, Маг-Десятник наносит 3 повреждения целевому существу или игроку. Поврежденное этим способом существо не может быть регенерировано на этом ходу.\\n{5}{R}{R}, {T}, Сбросьте карту: Джайя Баллард, Маг-Десятник наносит 6 повреждений всем существам и всем игрокам.\', \'type\': \'Легендарное Существо — Человек Заклинатель\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134184&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'255e2fc2-2b47-448f-903d-960c60cc6295\', \'multiverseId\': 134184}, \'multiverseid\': 134184}, {\'name\': \'特务法术师雅亚巴拉德\', \'text\': \'{R}，{T}，弃一张牌：消灭目标蓝色永久物。\\n{1}{R}，{T}，弃一张牌：特务法术师雅亚巴拉德对目标生物或牌手造成3点伤害。 以此法受到伤害的生物本回合不能重生。\\n{5}{R}{R}，{T}，弃一张牌：雅亚巴拉德对每个生物与牌手造成6点伤害。\', \'type\': \'传奇生物～人类／塑法师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132378&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3afbe03f-4c1f-4967-b881-c61a95fb15f1\', \'multiverseId\': 132378}, \'multiverseid\': 132378}]', '[{\'name\': \'Jedits Dragoner\', \'text\': \'Wachsamkeit\\nWenn Jedits Dragoner ins Spiel kommen, erhältst du 4 Lebenspunkte dazu.\', \'type\': \'Kreatur — Katze, Soldat\', \'flavor\': \'Nach der Zerstörung von Efrava wurden die Katzenkrieger über ganz Dominaria verstreut. Diejenigen, die Jedits Beispiel folgten, erwiesen sich als stark genug, um die Auswirkungen der Apokalypse zu überleben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132981&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a5138171-80dd-47cc-8028-49e56bc6c4ae\', \'multiverseId\': 132981}, \'multiverseid\': 132981}, {\'name\': \'Dragones de Jédit\', \'text\': \'Vigilancia.\\nCuando los Dragones de Jedit entren en juego, gana 4 vidas.\', \'type\': \'Criatura — Soldado felino\', \'flavor\': \'Después de que Efrava fue destruida, los guerreros felinos se desperdigaron por Dominaria. Aquellos que siguieron el ejemplo de Jédit fueron suficientemente fuertes como para sobrevivir los embates del apocalipsis.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134486&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ebaa6197-46fd-4c34-a9b5-02d2b3975c20\', \'multiverseId\': 134486}, \'multiverseid\': 134486}, {\'name\': \'Grognards de Jedit\', \'text\': \'Vigilance\\nQuand les Grognards de Jedit arrivent en jeu, vous gagnez 4 points de vie.\', \'type\': \'Créature : chat et soldat\', \'flavor\': "Après la destruction d\'Efrava, les guerriers félins s\'éparpillèrent dans tout Dominaria. Ceux qui suivirent l\'exemple de Jedit furent assez forts pour survivre aux ravages de l\'apocalypse.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132680&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8dc945e1-640e-4ded-9af7-1147924c7c4c\', \'multiverseId\': 132680}, \'multiverseid\': 132680}, {\'name\': \'Dragoni di Jedit\', \'text\': \'Cautela\\nQuando i Dragoni di Jedit entrano in gioco, guadagni 4 punti vita.\', \'type\': \'Creatura — Soldato Felino\', \'flavor\': "Dopo che Efrava venne distrutta, i guerrieri felini si sparsero in tutta Dominaria. Quelli che seguirono l\'esempio di Jedit furono abbastanza forti da sopravvivere alla devastazione dell\'apocalisse.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133282&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3566eba0-1d83-48ce-89bf-3053aaedd462\', \'multiverseId\': 133282}, \'multiverseid\': 133282}, {\'name\': \'ジェディットの竜騎兵\', \'text\': \'警戒\\nジェディットの竜騎兵が場に出たとき、あなたは４点のライフを得る。\', \'type\': \'クリーチャー — 猫・兵士\', \'flavor\': \'エフラヴァが破壊された後、猫戦士はドミナリア中に散らばっていった。 ジェディットに付き従っていった者たちは、最終戦争の惨劇の中を生き延びる強さを備えていた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133583&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'59e6f740-79dc-4899-aeb0-53553b42de21\', \'multiverseId\': 133583}, \'multiverseid\': 133583}, {\'name\': \'Dragões de Jedit\', \'text\': \'Vigilância\\nQuando Dragões de Jedit entra em jogo, você ganha 4 pontos de vida.\', \'type\': \'Criatura — Soldado Felino\', \'flavor\': \'Após a destruição de Efrava, os guerreiros felinos se espalharam por Dominária. Aqueles que seguiram o exemplo de Jedit foram fortes o suficiente para sobreviver à destruição do apocalipse.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133884&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'26ebe35e-1cf5-4539-b1dd-068ce2129616\', \'multiverseId\': 133884}, \'multiverseid\': 133884}, {\'name\': \'Драгуны Джедита\', \'text\': \'Бдительность\\nКогда Драгуны Джедита входят в игру, вы получаете 4 жизни.\', \'type\': \'Существо — Кот Солдат\', \'flavor\': \'После разрушения Эфравы коты-воины разбрелись по Доминарии. Последовавшие примеру Джедита были достаточно сильны, чтобы выжить в кошмарах апокалипсиса.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134185&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'91d0838a-30e4-4006-bd60-9ad565b3bc52\', \'multiverseId\': 134185}, \'multiverseid\': 134185}, {\'name\': \'杰迪的重装兵\', \'text\': \'警戒\\n当杰迪的重装兵进场时，你获得4点生命。\', \'type\': \'生物～猫／士兵\', \'flavor\': \'依法瓦城被毁之后，猫战士便散居多明纳里亚诸境。 效法杰迪而离乡者都锻炼得更加强悍，因而得以安渡末日战火。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132379&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'309f54a5-9ed4-49c8-b71c-6980d76e7290\', \'multiverseId\': 132379}, \'multiverseid\': 132379}]', "[{'name': 'Jhoiras Zeitkäfer', 'text': '{T}: Bestimme eine bleibende Karte deiner Wahl, die du kontrollierst, oder eine ausgesetzte Karte, die du besitzt. Falls auf dieser bleibenden Karte oder Karte mindestens eine Zeitmarke liegt, kannst du eine Zeitmarke von ihr entfernen oder eine weitere Zeitmarke auf sie legen.', 'type': 'Artefaktkreatur — Insekt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132982&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd18e2c6a-9333-496b-9bfe-9191bbea4c64', 'multiverseId': 132982}, 'multiverseid': 132982}, {'name': 'Insecto temporal de Jhoira', 'text': '{T}: Elige el permanente objetivo que controlas o la carta suspendida objetivo de la cual eres propietario. Si esa carta o permanente tiene un contador de tiempo sobre él, puedes remover un contador de tiempo o poner otro contador de tiempo sobre él.', 'type': 'Criatura artefacto — Insecto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134487&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5773ecc0-20a7-4807-89fe-f7f665e9ba31', 'multiverseId': 134487}, 'multiverseid': 134487}, {'name': 'Insectemporal de Djoïra', 'text': '{T} : Choisissez un permanent ciblé que vous contrôlez ou une carte en suspension que vous possédez. Si ce permanent ou carte a un marqueur « temps » sur lui, vous pouvez lui retirer un marqueur « temps » ou y mettre un autre marqueur « temps ».', 'type': 'Créature-artefact : insecte', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132681&type=card', 'language': 'French', 'identifiers': {'scryfallId': '7822442d-7273-4070-8378-5b602caa3eeb', 'multiverseId': 132681}, 'multiverseid': 132681}, {'name': 'Cronoinsetto di Jhoira', 'text': '{T}: Scegli un permanente bersaglio che controlli o una carta sospesa che possiedi. Se quel permanente o quella carta ha un segnalino tempo su di esso, puoi rimuovere un segnalino tempo da esso o mettere un altro segnalino tempo su di esso.', 'type': 'Creatura Artefatto — Insetto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133283&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ecb20537-3ca6-48fc-bce0-b514adf53aaf', 'multiverseId': 133283}, 'multiverseid': 133283}, {'name': 'ジョイラの時虫', 'text': '{T}：あなたがコントロールするパーマネント１つか、あなたがオーナーである待機状態のカード１枚を対象とする。 そのパーマネントかカードに時間カウンターが置かれている場合、あなたはそれから時間カウンターを１個取り除くかその上に時間カウンターを１個置くかしてもよい。', 'type': 'アーティファクト・クリーチャー — 昆虫', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133584&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '1cea0e9a-aa53-4fc0-b04c-98b2472582cd', 'multiverseId': 133584}, 'multiverseid': 133584}, {'name': 'Inseto-Ampulheta de Jhoira', 'text': '{T}: Escolha uma permanente alvo que você controla ou um card suspenso seu. Se aquela permanente ou card tiver um marcador temporal sobre ele, você poderá remover um marcador temporal dele ou colocar outro marcador temporal sobre ele.', 'type': 'Criatura Artefato — Inseto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133885&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '066de4ed-1866-4a7e-aa4c-635569a6359e', 'multiverseId': 133885}, 'multiverseid': 133885}, {'name': 'Временной Жучек Джойры', 'text': '{T}: Выберите целевой перманент под вашим контролем или вашу отсроченную карту. Если на этом перманенте (или карте) имеется временной жетон, вы можете убрать с него временной жетон или положить на него другой временной жетон.', 'type': 'Артефактное Существо — Насекомое', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134186&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '35161757-fdda-42e7-8787-fb59144a0b3f', 'multiverseId': 134186}, 'multiverseid': 134186}, {'name': '尤依拉的计时虫', 'text': '{T}：选择目标由你操控的永久物，或由你拥有且已延缓的牌。 如果该永久物或牌上有计时指示物，你可以从其上移去一个计时指示物，或在其上放置一个计时指示物。', 'type': '神器生物～昆虫', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132380&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '0ba0c720-7a9e-444b-bf1d-e25900b9a6b2', 'multiverseId': 132380}, 'multiverseid': 132380}]", "[{'name': 'Junger Dornenschwanzsceada', 'text': 'Fliegend\\nOpfere den Jungen Dornenschwanzsceada: Neutralisiere einen Zauberspruch deiner Wahl, falls sein Beherrscher nicht {2} bezahlt.', 'type': 'Kreatur — Sceada', 'flavor': 'Die jungen Sceadas fischen mit den psychischen Haken an ihren Schwanzfedern nach saftigen Gedanken und Erinnerungen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133081&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0029607b-8645-463f-b407-7ca69cb43b3b', 'multiverseId': 133081}, 'multiverseid': 133081}, {'name': 'Draco joven colapúa', 'text': 'Vuela.\\nSacrificar el Draco joven colapúa: Contrarresta el hechizo objetivo a menos que su controlador pague {2}.', 'type': 'Criatura — Draco', 'flavor': 'Los jóvenes dracos pescan con sus colas, intentando capturar suculentos pensamientos y memorias en sus anzuelos psíquicos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134586&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5d5ed71c-177f-42e1-9675-1aa706ee907f', 'multiverseId': 134586}, 'multiverseid': 134586}, {'name': 'Drakônnet dracodard', 'text': 'Vol\\nSacrifiez le Drakônnet dracodard : Contrecarrez le sort ciblé à moins que son contrôleur ne paie {2}.', 'type': 'Créature : drakôn', 'flavor': 'Les jeunes dracodards pêchent avec leur queue, espérant attraper pensées et souvenirs succulents avec leurs hameçons psychiques.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132780&type=card', 'language': 'French', 'identifiers': {'scryfallId': '85fcb802-d21f-408f-b890-b873ef22899c', 'multiverseId': 132780}, 'multiverseid': 132780}, {'name': 'Draghettino Codapunta', 'text': 'Volare\\nSacrifica il Draghettino Codapunta: Neutralizza una magia bersaglio a meno che il suo controllore non paghi {2}.', 'type': 'Creatura — Draghetto', 'flavor': 'I draghettini pescano con la coda, usandola come lenza per accalappiare succulenti pensieri e ricordi sugli uncini psichici.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133382&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b4a4edb1-1f99-46cd-a462-ea57c9d658ca', 'multiverseId': 133382}, 'multiverseid': 133382}, {'name': 'トゲ尾の仔ドレイク', 'text': '飛行\\nトゲ尾の仔ドレイクを生け贄に捧げる：呪文１つを対象とする。それのコントローラーが{2}を支払わないかぎり、それを打ち消す。', 'type': 'クリーチャー — ドレイク', 'flavor': '仔ドレイクは、精神の針でみずみずしい思考や記憶をひっかけ、尾で釣りあげる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133683&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f3b18287-6c23-4e5d-9879-054859fbf056', 'multiverseId': 133683}, 'multiverseid': 133683}, {'name': 'Dragonito de Cauda Espigada', 'text': 'Voar\\nSacrifique Dragonito de Cauda Espigada: Anule a mágica alvo, a menos que seu controlador pague {2}.', 'type': 'Criatura — Dragonete', 'flavor': 'Os dragonitos pescam com suas caudas, na tentativa de capturar pensamentos e memórias suculentas com seus anzóis psíquicos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133984&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '889473e8-afae-4c62-b41c-7ba4f13b7c40', 'multiverseId': 133984}, 'multiverseid': 133984}, {'name': 'Колючехвостый Драконыш', 'text': 'Полет\\nПожертвуйте Колючехвостого Драконыша: Прервите целевое заклинание если контролирующий его игрок не заплатит {2}.', 'type': 'Существо — Дрейк', 'flavor': 'Драконыши ловят рыбу своими хвостами, насаживая на свои психические снасти сочные мысли и воспоминания.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134285&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'e27d06e1-fbbf-43f3-8a7c-4e27e34c1c2d', 'multiverseId': 134285}, 'multiverseid': 134285}, {'name': '钉尾幼龙兽', 'text': '飞行\\n牺牲钉尾幼龙兽：除非目标咒语的操控者支付{2}，否则反击之。', 'type': '生物～龙兽', 'flavor': '幼龙兽用尾巴诱捕，以其上的心灵勾刺钓取肥美思绪与记忆。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132479&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '89976114-b224-4cb4-b4ae-e3c004c7c766', 'multiverseId': 132479}, 'multiverseid': 132479}]", "[{'name': 'Junger Mawcor', 'text': 'Fliegend\\n{T}: Der Junge Mawcor fügt einer Kreatur oder einem Spieler deiner Wahl 1 Schadenspunkt zu.\\nMorph {U}{U} (Du kannst diese Karte verdeckt für {3} als eine 2/2 Kreatur spielen. Decke sie zu einem beliebigen Zeitpunkt für ihre Morph-Kosten auf.)', 'type': 'Kreatur — Bestie', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132933&type=card', 'language': 'German', 'identifiers': {'scryfallId': '99097b9b-ef55-460b-b3dd-b056ffe408cc', 'multiverseId': 132933}, 'multiverseid': 132933}, {'name': 'Maucor novato', 'text': 'Vuela.\\n{T}: El Maucor novato hace 1 punto de daño a la criatura o jugador objetivo.\\nMetamorfosis {U}{U} (Puedes jugar esta carta boca abajo como una criatura 2/2 pagando {3}. Ponla boca arriba en cualquier momento pagando su coste de metamorfosis.)', 'type': 'Criatura — Bestia', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134438&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '23dcb5d0-f70f-431b-adbe-e51cd3b20dd1', 'multiverseId': 134438}, 'multiverseid': 134438}, {'name': 'Corgueule juvénile', 'text': 'Vol\\n{T} : Le Corgueule juvénile inflige 1 blessure à une cible, créature ou joueur.\\nMue {U}{U} (Vous pouvez jouer cette carte face cachée comme une créature 2/2 pour {3}. Retournez-la quand vous le désirez pour son coût de mue.)', 'type': 'Créature : bête', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132632&type=card', 'language': 'French', 'identifiers': {'scryfallId': '1bbc8b7b-0fc5-4b10-acaf-293143c7f763', 'multiverseId': 132632}, 'multiverseid': 132632}, {'name': 'Mawcor Implume', 'text': 'Volare\\n{T}: La Mawcor Implume infligge 1 danno a una creatura o a un giocatore bersaglio.\\nMetamorfosi {U}{U} (Puoi giocare questa carta a faccia in giù come una creatura 2/2 pagando {3}. Girala a faccia in su in qualsiasi momento pagando il suo costo di metamorfosi.)', 'type': 'Creatura — Bestia', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133234&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3c99aaf8-f924-463e-8778-64d74c51ad71', 'multiverseId': 133234}, 'multiverseid': 133234}, {'name': '巣立つ大口獣', 'text': '飛行\\n{T}：クリーチャー１体かプレイヤー１人を対象とする。巣立つ大口獣はそれに１点のダメージを与える。\\n変異 {U}{U} （あなたはこれを、{3}を支払うことで、裏向きの２/２のクリーチャーとしてプレイしてもよい。 いつでも変異コストを支払ってそれを表向きにすることができる。）', 'type': 'クリーチャー — ビースト', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133535&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'e959d01e-5a83-49e7-965b-de4d9c60c355', 'multiverseId': 133535}, 'multiverseid': 133535}, {'name': 'Mawcor Inexperiente', 'text': 'Voar\\n{T}: Mawcor Inexperiente causa 1 ponto de dano à criatura alvo ou ao jogador alvo.\\nMetamorfose {U}{U} (Você pode baixar este card com a face voltada para baixo como uma criatura 2/2 por {3}. Vire sua face para cima a qualquer momento pagando seu custo de metamorfose.)', 'type': 'Criatura — Besta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133836&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ab709e52-ac79-448e-882c-b3f3f2271938', 'multiverseId': 133836}, 'multiverseid': 133836}, {'name': 'Начинающий Чревовещатель', 'text': 'Полет\\n{T}: Начинающий Чревовещатель наносит 1 повреждение целевому существу или игроку.\\nОборотень {U}{U} (Вы можете играть эту карту лицом вниз как 2/2 существо за {3}. Переверните ее лицом вверх в любой момент за ее стоимость оборотня.)', 'type': 'Существо — Зверь', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134137&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '46f689f9-cf5a-4411-ad17-c714e619b605', 'multiverseId': 134137}, 'multiverseid': 134137}, {'name': '幼年飞喉怪', 'text': '飞行\\n{T}：幼年飞喉怪对目标生物或牌手造成1点伤害。\\n变身{U}{U}（你可牌面朝下地使用此牌并支付{3}，将其当成2/2生物。 可随时支付其变身费用使其翻回正面。）', 'type': '生物～野兽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132331&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '8be97f88-c48f-41b6-8618-1cfdbb824f58', 'multiverseId': 132331}, 'multiverseid': 132331}]", '[{\'name\': \'Kaervek der Gnadenlose\', \'text\': \'Immer wenn ein Gegner einen Zauberspruch spielt, fügt Kaervek der Gnadenlose einer Kreatur oder einem Spieler deiner Wahl Schadenspunkte in Höhe der umgewandelten Manakosten dieses Zauberspruchs zu.\', \'type\': \'Legendäre Kreatur — Mensch, Schamane\', \'flavor\': \'„Viele Ratten und Schakale werden von den Leichen satt, die seinen Weg pflastern — wenn sie genügend Abstand halten." —Mangara\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132983&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6c8d3e4f-fcc6-44d3-902c-38b6ece82c5a\', \'multiverseId\': 132983}, \'multiverseid\': 132983}, {\'name\': \'Kaervek el despiadado\', \'text\': \'Siempre que un oponente juegue un hechizo, Kaervek el despiadado hace daño a la criatura o jugador objetivo igual al coste de maná convertido de ese hechizo.\', \'type\': \'Criatura legendaria — Chamán humano\', \'flavor\': \'"Las ratas y los chacales festejan a su paso, pero no caminan con él." —Mangara\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134488&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4292de13-ead9-4770-a839-fb79cbc8476f\', \'multiverseId\': 134488}, \'multiverseid\': 134488}, {\'name\': "Kaervek l\'impitoyable", \'text\': "À chaque fois qu\'un adversaire joue un sort, Kaervek l\'impitoyable inflige un nombre de blessures égal au coût converti de mana de ce sort à une cible, créature ou joueur.", \'type\': \'Créature légendaire : humain et shamane\', \'flavor\': "« Rats et chacals festoient dans son sillage, mais même eux n\'osent l\'accompagner. » —Mangara", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132682&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a4399356-34b9-469b-a5e4-0139db9335a6\', \'multiverseId\': 132682}, \'multiverseid\': 132682}, {\'name\': \'Kaervek lo Spietato\', \'text\': \'Ogniqualvolta un avversario gioca una magia, Kaervek lo Spietato infligge un danno pari al costo di mana convertito di quella magia a una creatura o a un giocatore bersaglio.\', \'type\': \'Creatura Leggendaria — Sciamano Umano\', \'flavor\': \'"Topi e sciacalli banchettano nella sua scia, ma neppure loro cammineranno al suo fianco." —Mangara\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133284&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'def74db8-cf21-4f0e-bc89-b04956e7ca79\', \'multiverseId\': 133284}, \'multiverseid\': 133284}, {\'name\': \'無慈悲なる者ケアヴェク\', \'text\': \'いずれかの対戦相手が呪文をプレイするたび、クリーチャー１体かプレイヤー１人を対象とする。無慈悲なる者ケアヴェクはそれに、その呪文の点数で見たマナ・コストに等しい点数のダメージを与える。\', \'type\': \'伝説のクリーチャー — 人間・シャーマン\', \'flavor\': \'鼠やジャッカルは彼の通り道にたかっているが、それでも共に歩こうとはしていない。 ――マンガラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133585&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'26b48b90-7d2c-44c6-a12d-76f74d1af83a\', \'multiverseId\': 133585}, \'multiverseid\': 133585}, {\'name\': \'Kaervek, o Impiedoso\', \'text\': \'Toda vez que um oponente joga uma mágica, Kaervek, o Impiedoso, causa dano à criatura alvo ou ao jogador alvo igual ao custo de mana convertido daquela mágica.\', \'type\': \'Criatura Lendária — Xamã Humano\', \'flavor\': \'"Ratos e chacais alimentam-se de suas gavelas, mas nem mesmo eles caminhariam ao seu lado." —Mangara\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133886&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'052fc0e0-535f-4b33-a588-07e90e0c98ea\', \'multiverseId\': 133886}, \'multiverseid\': 133886}, {\'name\': \'Кайервек, Беспощадный\', \'text\': \'Когда оппонент играет заклинание, Кайервек, Беспощадный наносит повреждения целевому существу или игроку, равные конвертированной мана-стоимости этого заклинания.\', \'type\': \'Легендарное Существо — Человек Шаман\', \'flavor\': \'«Крысы и шакалы пируют в их выкосах, но даже они не будут ходить с ним», Мангара\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134187&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'df9c031b-14f5-44a6-b786-8746824e9a1a\', \'multiverseId\': 134187}, \'multiverseid\': 134187}, {\'name\': \'杀生者凯雷威克\', \'text\': \'每当任一对手使用咒语时，杀生者凯雷威克对目标生物或牌手造成伤害，其数量等同于该咒语的总法术力费用。\', \'type\': \'传奇生物～人类／祭师\', \'flavor\': \'「老鼠与豺狼随他身后尸迹大快朵颐，但就连他们也不愿与他同行。」 ～曼格拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132381&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bda65d0e-0c89-4a62-90a6-a154f65847a0\', \'multiverseId\': 132381}, \'multiverseid\': 132381}]', '[{\'name\': \'Kalkkiesel-Tümpel\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}.\\n{1}, {T}: Lege eine Speichermarke auf den Kalkkiesel-Tümpel.\\n{1}, entferne X Speichermarken vom Kalkkiesel-Tümpel: Erhöhe deinen Manavorrat um X Mana einer beliebigen Kombination aus {W} und/oder {U}.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132877&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'32922c1f-28eb-4135-b9b4-e344f39e0500\', \'multiverseId\': 132877}, \'multiverseid\': 132877}, {\'name\': \'Estanques calciformes\', \'text\': \'{T}: Agrega {1} a tu reserva de maná.\\n{1}, {T}: Pon un contador de almacenaje sobre los Estanques calciformes.\\n{1}, remover X contadores de almacenaje de los Estanques calciformes: Agrega X maná de cualquier combinación de {W} y/o {U} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134382&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'839eeec8-c602-4d5c-b515-d6077aa4b716\', \'multiverseId\': 134382}, \'multiverseid\': 134382}, {\'name\': \'Bassins calciformes\', \'text\': "{T} : Ajoutez {1} à votre réserve.\\n{1}, {T} : Mettez un marqueur « stock » sur les Bassins calciformes.\\n{1}, retirez X marqueurs « stock » des Bassins calciformes : Ajoutez X manas de n\'importe quelle combinaison de {W} et/ou {U} à votre réserve.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132576&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'98fbc5a1-2b53-4831-9259-7ea073ef8924\', \'multiverseId\': 132576}, \'multiverseid\': 132576}, {\'name\': \'Pozze Calciformi\', \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana.\\n{1}, {T}: Metti un segnalino magazzino sulle Pozze Calciformi\\n{1}, Rimuovi X segnalini magazzino dalle Pozze Calciformi: Aggiungi X mana in qualsiasi combinazione di {W} e/o {U} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133178&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'36c99f6f-ba74-4c08-8ff1-a96e79b70152\', \'multiverseId\': 133178}, \'multiverseid\': 133178}, {\'name\': \'石灰の池\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。\\n{1}, {T}：石灰の池の上に蓄積カウンターを１個置く。\\n{1}, 石灰の池から蓄積カウンターをＸ個取り除く：Ｘ点の{W}か{U}（あるいはその組み合わせ）をあなたのマナ・プールに加える。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133479&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cee4aa51-e0df-4967-8f46-2145222e9d3f\', \'multiverseId\': 133479}, \'multiverseid\': 133479}, {\'name\': \'Poças Calciformes\', \'text\': \'{T}: Adicione {1} à sua reserva de mana.\\n{1}, {T}: Coloque um marcador de estocagem sobre Poças Calciformes.\\n{1}, Remova X marcadores de estocagem de Poças Calciformes: Adicione X manas em qualquer combinação de {W} e/ou {U} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133780&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5481f076-7943-452b-bd8b-a93fda087d48\', \'multiverseId\': 133780}, \'multiverseid\': 133780}, {\'name\': \'Известняковые Заводи\', \'text\': \'{T}: Добавьте {1} в ваше хранилище маны.\\n{1}, {T}: Положите накопительный жетон на Известняковые Заводи.\\n{1}, Удалите X накопительных жетонов с Известняковых Заводей : Добавьте X маны в любых комбинациях {W} и/или {U} в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134081&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ba101e51-d721-426c-ab99-d14c3db66454\', \'multiverseId\': 134081}, \'multiverseid\': 134081}, {\'name\': \'石灰盐池\', \'text\': \'{T}：加{1}到你的法术力池中。\\n{1}，{T}：在石灰盐池上放置一个储藏指示物。\\n{1}，从石灰盐池上移去X个储藏指示物：加X点法术力到你的法术力池中，且为{W}和／或{U}的任意组合。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132275&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2446a0e5-8139-4942-a9bf-ba3958bb8aab\', \'multiverseId\': 132275}, \'multiverseid\': 132275}]', '[{\'name\': \'Keldonischer Hellebardier\', \'text\': \'Erstschlag\\nAussetzen 4 {R} (Statt diese Karte aus deiner Hand zu spielen, kannst du {R} bezahlen, sie ganz aus dem Spiel entfernen und vier Zeitmarken auf sie legen. Entferne zu Beginn deines Versorgungssegments eine Zeitmarke von ihr. Wenn du die letzte Zeitmarke entfernst, spiele die Karte, ohne ihre Manakosten zu bezahlen. Sie hat Eile.)\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132984&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3c8bb86f-85bf-425d-a56e-0ca68d359d58\', \'multiverseId\': 132984}, \'multiverseid\': 132984}, {\'name\': \'Alabardero keldon\', \'text\': \'Daña primero.\\nSuspender 4—{R} (En lugar de jugar esta carta de tu mano, puedes pagar {R} y removerla del juego con cuatro contadores de tiempo sobre ella. Al comienzo de tu mantenimiento, remueve un contador de tiempo. Cuando remuevas el último, juégala sin pagar su coste de maná. Tiene la habilidad de prisa.)\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134489&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e2785cb2-a905-4d3e-b793-451599d2893b\', \'multiverseId\': 134489}, \'multiverseid\': 134489}, {\'name\': \'Hallebardier kelde\', \'text\': \'Initiative\\nSuspension 4 — {R} (Plutôt que jouer cette carte depuis votre main, vous pouvez payer {R} et la retirer de la partie avec quatre marqueurs « temps » sur elle. Au début de votre entretien, retirez un marqueur « temps ». Quand vous retirez le dernier, jouez cette carte sans payer son coût de mana. Elle a la célérité.)\', \'type\': \'Créature : humain et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132683&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d31b7bc1-c1ee-449f-b22d-037045b49b8f\', \'multiverseId\': 132683}, \'multiverseid\': 132683}, {\'name\': \'Alabardiere di Keld\', \'text\': "Attacco improvviso\\nSospendere 4—{R} (Invece di giocare questa carta dalla tua mano, puoi pagare {R} e rimuoverla dal gioco con quattro segnalini tempo su di essa. All\'inizio del tuo mantenimento, rimuovi un segnalino tempo. Quando rimuovi l\'ultimo, gioca la carta senza pagare il suo costo di mana. Ha rapidità.)", \'type\': \'Creatura — Guerriero Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133285&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ffd94104-d33f-403e-9474-dae3f17d9d70\', \'multiverseId\': 133285}, \'multiverseid\': 133285}, {\'name\': \'ケルドの矛槍兵\', \'text\': \'先制攻撃\\n待機 ４―{R} （これをあなたの手札からプレイするのではなく、{R}を支払ってゲームから取り除き、その上に時間カウンターを４個置いてもよい。 あなたのアップキープの開始時に、時間カウンターを１個取り除く。 最後の１個を取り除いたとき、あなたはそれをマナ・コストを支払わずにプレイする。 それは速攻を持つ。）\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133586&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eb384fcd-cfab-415a-83bf-787fe2b1697a\', \'multiverseId\': 133586}, \'multiverseid\': 133586}, {\'name\': \'Alabardeiro Keldoniano\', \'text\': \'Iniciativa\\nSuspender 4—{R} (Em vez de jogar este card da sua mão, você pode pagar {R} e removê-lo do jogo com quatro marcadores temporais sobre ele. No início de sua manutenção, remova um marcador temporal. Quando remover o último, jogue-o sem pagar seu custo de mana. Ele tem ímpeto.)\', \'type\': \'Criatura — Guerreiro Humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133887&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3f5a992c-30e6-4a66-8e87-7c0b4002a189\', \'multiverseId\': 133887}, \'multiverseid\': 133887}, {\'name\': \'Келдонский Алебардщик\', \'text\': \'Первый удар\\nОтсрочка 4—{R} (Вместо того чтобы сыграть эту карту из вашей руки, заплатите {R} и удалите ее из игры с четырмя временными жетонами на ней. В начале вашего шага поддержки удалите один временной жетон. Когда вы удалите последний, сыграйте эту карту без оплаты ее мана-стоимости. Она получает ускорение.)\', \'type\': \'Существо — Человек Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134188&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0904630d-181b-4799-b736-ef9f1be03ed2\', \'multiverseId\': 134188}, \'multiverseid\': 134188}, {\'name\': \'凯尔顿长戟兵\', \'text\': \'先攻\\n延缓4～{R}（除了从你手上使用此牌，你可以支付{R}并将此牌移出对战，且上面有四个计时指示物。 在你的维持开始时，从其上移去一个计时指示物。 当你移去最后一个时，则使用它且不需支付其法术力费用。 它具有敏捷。）\', \'type\': \'生物～人类／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132382&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5386d519-7071-4200-a18d-51e1492ebe0e\', \'multiverseId\': 132382}, \'multiverseid\': 132382}]', '[{\'name\': \'Kerzen von Leng\', \'text\': \'{4}, {T}: Decke die oberste Karte deiner Bibliothek auf. Hat sie den gleichen Namen wie eine Karte in deinem Friedhof, lege sie auf deinen Friedhof. Ziehe sonst eine Karte.\', \'type\': \'Artefakt\', \'flavor\': \'„Ein Buch, das unter solchen Lichtbedingungen aufbewahrt wird, ist noch so frisch wie am Tag, an dem es geschrieben wurde." —Ettovard, Tolarianischer Archivar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132880&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c586a71a-3a39-469b-9ef1-02a7e94aac14\', \'multiverseId\': 132880}, \'multiverseid\': 132880}, {\'name\': \'Velas de Leng\', \'text\': \'{4}, {T}: Muestra la primera carta de tu biblioteca. Si tiene el mismo nombre que una carta en tu cementerio, ponla en tu cementerio. De lo contrario, roba una carta.\', \'type\': \'Artefacto\', \'flavor\': \'"Un tomo guardado bajo su luz está tan firme como el día en que fue escrito." —Éttovard, archivista tolariano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134385&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'92d01aef-55f8-4d89-a83e-f9d792fde4a4\', \'multiverseId\': 134385}, \'multiverseid\': 134385}, {\'name\': \'Bougies de Leng\', \'text\': "{4}, {T} : Révélez la carte du dessus de votre bibliothèque. Si elle a le même nom qu\'une carte de votre cimetière, mettez-la dans votre cimetière. Sinon, piochez une carte.", \'type\': \'Artefact\', \'flavor\': \'« Un grimoire entreposé sous leur lumière est aussi neuf que le jour où il a été écrit. » —Ettovard, archiviste tolarian\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132579&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cd6fced2-ad3e-489d-b0db-51a01db572ca\', \'multiverseId\': 132579}, \'multiverseid\': 132579}, {\'name\': \'Candele di Leng\', \'text\': \'{4}, {T}: Rivela la prima carta del tuo grimorio. Se ha lo stesso nome di una carta nel tuo cimitero, mettila nel tuo cimitero. Altrimenti, pesca una carta.\', \'type\': \'Artefatto\', \'flavor\': \'"Un tomo conservato nella sua luce è frusciante come il giorno in cui fu scritto." —Ettovard, archivista di Tolaria\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133181&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a08a4931-4531-458d-83fa-f3012601bacd\', \'multiverseId\': 133181}, \'multiverseid\': 133181}, {\'name\': \'レンの蝋燭\', \'text\': \'{4}, {T}：あなたのライブラリーの一番上のカードを公開する。 それがあなたの墓地にあるいずれかのカードと同じカード名であれば、それをあなたの墓地に置く。 そうでない場合、カードを引く。\', \'type\': \'アーティファクト\', \'flavor\': \'書をこの灯りに照らせば、それが書かれた時のように生き生きとしてくるのだ。 ――トレイリアの文書管理人、エトヴァード\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133482&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8245e446-b6e4-469e-b937-62f7e6f39638\', \'multiverseId\': 133482}, \'multiverseid\': 133482}, {\'name\': \'Velas de Leng\', \'text\': \'{4}, {T}: Revele o card do topo de seu grimório. Se ele tiver o mesmo nome que um card em seu cemitério, coloque-o em seu cemitério. Do contrário, compre um card.\', \'type\': \'Artefato\', \'flavor\': \'"Um tomo armazenado sob sua luz é tão nítido quanto no dia em que foi escrito." —Ettovard, arquivista tolariano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133783&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1d0e5a3b-7154-473a-969f-2bff68f03fc4\', \'multiverseId\': 133783}, \'multiverseid\': 133783}, {\'name\': \'Свечи из Ленга\', \'text\': \'{4}, {T}: Покажите верхнюю карту вашей библиотеки. Если она имеет то же название, что и карта в вашем кладбище, положите ее на ваше кладбище. В противном случае возьмите карту.\', \'type\': \'Артефакт\', \'flavor\': \'«Сохраненное в их огнях послание выглядит таким же четким, как и в день его написания», Эттовард, Толарианский архивариус\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134084&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7bd55be4-c65a-4f5b-9f05-9c1f5c39f352\', \'multiverseId\': 134084}, \'multiverseid\': 134084}, {\'name\': \'梁氏蜡烛\', \'text\': \'{4}，{T}：展示你的牌库顶牌。 如果你的坟墓场中有与它同名之牌，则将它置入你的坟墓场。 若否，则抓一张牌。\', \'type\': \'神器\', \'flavor\': \'「在其光辉下保存的书，就如同刚抄好的那天一样新。」 ～陶拉里亚书库辖员艾托瓦\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132278&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'796aa37e-7893-45dd-aac7-e0197917f4ce\', \'multiverseId\': 132278}, \'multiverseid\': 132278}]', '[{\'name\': \'Kherburg\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}.\\n{1}{R}, {T}: Bringe einen 0/1 roten Koboldspielstein namens Kobolde von Kherburg ins Spiel.\', \'type\': \'Legendäres Land\', \'flavor\': \'„Die gibt es immer noch? Dagegen sind Kakerlaken ja harmlos." —Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132985&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e5c563ac-b9c9-4246-ab53-583fe5dab477\', \'multiverseId\': 132985}, \'multiverseid\': 132985}, {\'name\': \'Fortaleza Kher\', \'text\': \'{T}: Agrega {1} a tu reserva de maná.\\n{1}{R}, {T}: Pon en juego una ficha de criatura Kóbold roja 0/1 llamada Kóbolds de la Fortaleza Kher.\', \'type\': \'Tierra legendaria\', \'flavor\': \'"¡¿Siguen aquí? Puede que las cucarachas finalmente hayan encontrado un par." —Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134490&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f67dd8ca-694f-45e8-8203-fcdb16b2d667\', \'multiverseId\': 134490}, \'multiverseid\': 134490}, {\'name\': \'Castel Kher\', \'text\': \'{T} : Ajoutez {1} à votre réserve.\\n{1}{R}, {T} : Mettez en jeu un jeton de créature 0/1 rouge Kobold appelé Kobolds de Castel Kher.\', \'type\': \'Terrain légendaire\', \'flavor\': \'« Ils sont encore là ? Les cafards ont peut-être enfin trouvé un adversaire à leur mesure. » —Téfeiri\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132684&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'96fc6946-6d04-4efe-96e9-3e56843d2452\', \'multiverseId\': 132684}, \'multiverseid\': 132684}, {\'name\': \'Roccaforte di Kher\', \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana.\\n{1}{R}, {T}: Metti in gioco una pedina creatura Coboldo 0/1 rossa con nome Coboldi della Roccaforte di Kher.\', \'type\': \'Terra Leggendaria\', \'flavor\': \'"Sono ancora qui? Forse lo scarafaggio ha finalmente trovato un degno avversario." —Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133286&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ecfbec65-5a23-445d-9473-64674a60ef65\', \'multiverseId\': 133286}, \'multiverseid\': 133286}, {\'name\': \'カー砦\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。\\n{1}{R}, {T}：「カー砦のコボルド」という名前の、赤の０/１のコボルド・クリーチャー・トークンを１体場に出す。\', \'type\': \'伝説の土地\', \'flavor\': \'まだいたのか？！ ゴキブリもついに敵とご対面か。 ――テフェリー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133587&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ae345f9d-6924-4d55-ba4c-98832f91b144\', \'multiverseId\': 133587}, \'multiverseid\': 133587}, {\'name\': \'Fortaleza de Kher\', \'text\': \'{T}: Adicione {1} à sua reserva de mana.\\n{1}{R}, {T}: Coloque em jogo uma ficha de criatura vermelha 0/1 do tipo Kobold com o nome Kobolds da Fortaleza de Kher.\', \'type\': \'Terreno Lendário\', \'flavor\': \'"Eles ainda estão aqui? As baratas finalmente encontraram seu par." — Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133888&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'db10a100-6288-47de-923e-236124a2b8af\', \'multiverseId\': 133888}, \'multiverseid\': 133888}, {\'name\': \'Башня Кэра\', \'text\': \'{T}: Добавьте {1} в ваше хранилище маны.\\n{1}{R}, {T}: Положите одну фишку существа 0/1 красный Кобольд с именем Кобольд Башни Кэра в игру.\', \'type\': \'Легендарная Земля\', \'flavor\': \'«Они все еще здесь? Таракан наконец-то найдет себе пару», Тефери\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134189&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'99d0bbe7-3a4d-4c4a-a2e9-f625f68b614b\', \'multiverseId\': 134189}, \'multiverseid\': 134189}, {\'name\': \'喀尔寨\', \'text\': \'{T}：加{1}到你的法术力池中。\\n{1}{R}，{T}：将一个0/1红色，名称为喀尔寨鬼崽的鬼崽衍生物放置进场。\', \'type\': \'传奇地\', \'flavor\': \'「他们还在？ 看来蟑螂终于遇上了对手。」 ～泰菲力\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132383&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bb4f3b44-4da6-449c-9af5-94c940013b39\', \'multiverseId\': 132383}, \'multiverseid\': 132383}]', '[{\'name\': \'Kinder von Korlis\', \'text\': \'Opfere die Kinder von Korlis: Du erhältst so viele Lebenspunkte dazu, wie du in diesem Zug Lebenspunkte verloren hast. (Schaden verursacht den Verlust von Lebenspunkten.)\', \'type\': \'Kreatur — Mensch, Rebell, Kleriker\', \'flavor\': \'„Unser Orden kann stolz auf viele Fälle von Selbstopferung zurückblicken. Aber in diesen freudlosen Zeiten ist es sogar einfach, Leute zu finden, die für jeden beliebigen Zweck sterben wollen." —Tavalus, Tempeldiener von Korlis\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132886&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7f02a368-97ea-4a52-a422-6db885f69bc6\', \'multiverseId\': 132886}, \'multiverseid\': 132886}, {\'name\': \'Hijos de Korlis\', \'text\': \'Sacrificar a los Hijos de Korlis: Ganas una cantidad de vida igual a la vida que has perdido este turno. (El daño causa pérdida de vida.)\', \'type\': \'Criatura — Clérigo rebelde humano\', \'flavor\': \'"Tenemos una orgullosa historia de autosacrificio. Pero es fácil, en estos tiempos difíciles, encontrar entre los nuestros alguien deseoso de morir por cualquier causa." —Távalus, acólito de Korlis\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134391&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4a8b8cd7-5dd4-4470-b6ae-8c4b7718d195\', \'multiverseId\': 134391}, \'multiverseid\': 134391}, {\'name\': \'Enfants de Korlis\', \'text\': \'Sacrifiez les Enfants de Korlis : Vous gagnez un nombre de points de vie égal au nombre de points de vie que vous avez perdu ce tour-ci. (Les blessures provoquent la perte de points de vie.)\', \'type\': \'Créature : humain et rebelle et clerc\', \'flavor\': "« Notre histoire ne manque pas de fiers sacrifices. Mais, dans ces temps incertains, il est facile de trouver parmi nous quelqu\'un qui est prêt à mourir pour n\'importe quelle cause. » —Tavalus, acolyte de Korlis", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132585&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9eb67d46-533c-4ad7-978d-f2b9a1e9b15e\', \'multiverseId\': 132585}, \'multiverseid\': 132585}, {\'name\': \'Bambini di Korlis\', \'text\': \'Sacrifica i Bambini di Korlis: Guadagni tanti punti vita quanti sono i punti vita che hai perso in questo turno. (Il danno causa la perdita di punti vita.)\', \'type\': \'Creatura — Chierico Ribelle Umano\', \'flavor\': \'"Noi abbiamo una fiera storia di abnegazione. Ma è facile, in questi tristi momenti, trovare qualcuno tra noi che sia impaziente di morire per una causa qualsiasi." —Tavalus, accolito di Korlis\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133187&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'670fb547-dc87-4ed3-8343-06cace2d4c59\', \'multiverseId\': 133187}, \'multiverseid\': 133187}, {\'name\': \'コーリスの子\', \'text\': \'コーリスの子を生け贄に捧げる：あなたはこのターン失ったライフの点数に等しい点数のライフを得る。 （ダメージによりライフは失われる。）\', \'type\': \'クリーチャー — 人間・レベル・クレリック\', \'flavor\': \'我々は自己犠牲の歴史を誇りに思っています。 しかし、このような希望の無い時においては、我らの中から喜んで死に向かう者を見つけるのは、どんな理由であれ容易いことでしょう。 ――コーリスの見習い僧、タヴァラス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133488&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'de20ff27-4256-421b-a20f-2a57ab5c15fa\', \'multiverseId\': 133488}, \'multiverseid\': 133488}, {\'name\': \'Filhos de Korlis\', \'text\': \'Sacrifique Filhos de Korlis: Você ganha uma quantidade de pontos de vida igual aos pontos de vida que perdeu neste turno. (O dano causa perda de vida.)\', \'type\': \'Criatura — Humano Rebelde Clérigo\', \'flavor\': \'"Nós temos uma orgulhosa história de auto-sacrifício. Mas é fácil, nesses tempos sombrios, encontrar alguém dentre nós ansioso por morrer por uma causa qualquer." —Tavalus, acólito de Korlis\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133789&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ffd58029-3a54-42b3-a41a-0c14f0358859\', \'multiverseId\': 133789}, \'multiverseid\': 133789}, {\'name\': \'Дети Корлиса\', \'text\': \'Пожертвуйте Детей Корлиса: Вы получаете столько жизни, сколько вы потеряли на этом ходу. (Повреждения причиняют потерю жизни.)\', \'type\': \'Существо — Человек Повстанец Священник\', \'flavor\': \'«Наш орден гордится историей самопожертвования. Но ведь нетрудно, особенно в эти суровые времена, найти среди нас того, кто жаждет смерти без особых причин», Тавалус, служитель Корлиса\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134090&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'295160dd-7b53-4537-9035-dffccaa7a19f\', \'multiverseId\': 134090}, \'multiverseid\': 134090}, {\'name\': \'寇利斯之子\', \'text\': \'牺牲寇利斯之子：你获得若干生命，其数量等同于你于本回合中所失去之生命数量。 （伤害会导致失去生命。）\', \'type\': \'生物～人类／反抗军／僧侣\', \'flavor\': \'「我们拥有自我牺牲的光荣传统。 但在这凄凉年代，要找出愿意为任何理由舍身者，并不是太难。」 ～寇利斯侍僧塔瓦勒\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132284&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'da9e39ed-7b4d-41cf-9787-9f1ebfcc1060\', \'multiverseId\': 132284}, \'multiverseid\': 132284}]', '[{\'name\': \'Kitzel der Jagd\', \'text\': \'Eine Kreatur deiner Wahl erhält +1/+2 bis zum Ende des Zuges.\\nRückblende {W} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten spielen. Entferne sie dann ganz aus dem Spiel.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133118&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0f55c9a6-55a5-4dbe-8028-90f5473df963\', \'multiverseId\': 133118}, \'multiverseid\': 133118}, {\'name\': \'Emoción de la caza\', \'text\': \'La criatura objetivo obtiene +1/+2 hasta el final del turno.\\nRetrospectiva {W} (Puedes jugar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego remuévela del juego.)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134623&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5e73877b-7b7f-455d-8611-667c5c3ec5f5\', \'multiverseId\': 134623}, \'multiverseid\': 134623}, {\'name\': \'Frisson de la chasse\', \'text\': "La créature ciblée gagne +1/+2 jusqu\'à la fin du tour.\\nFlashback {W} (Vous pouvez jouer cette carte depuis votre cimetière pour son coût de flashback. Retirez-la ensuite de la partie.)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132817&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ce83c415-a504-4f81-8920-b7368ae8c520\', \'multiverseId\': 132817}, \'multiverseid\': 132817}, {\'name\': \'Brivido della Caccia\', \'text\': \'Una creatura bersaglio prende +1/+2 fino alla fine del turno.\\nFlashback {W} (Puoi giocare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi rimuovila dal gioco).\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133419&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6a4af149-60b3-4bfb-8c1a-a7c3a5718bff\', \'multiverseId\': 133419}, \'multiverseid\': 133419}, {\'name\': \'狩りの興奮\', \'text\': \'クリーチャー１体を対象とする。それはターン終了時まで＋１/＋２の修整を受ける。\\nフラッシュバック {W} （あなたはフラッシュバック・コストで、このカードをあなたの墓地からプレイしてもよい。 その後それをゲームから取り除く）\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133720&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'db2118c4-9807-42f3-887e-9606b292df6e\', \'multiverseId\': 133720}, \'multiverseid\': 133720}, {\'name\': \'Emoção da Caça\', \'text\': \'A criatura alvo recebe +1/+2 até o final do turno.\\nRecapitular {W} (Você pode jogar este card de seu cemitério pagando seu custo de recapitulação. Depois remova-o do jogo.)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134021&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a966bfcd-5913-4318-a177-ad434597351b\', \'multiverseId\': 134021}, \'multiverseid\': 134021}, {\'name\': \'Трепет Охоты\', \'text\': \'Целевое существо получает +1/+2 до конца хода.\\nВоспоминание {W} (Вы можете играть эту карту из вашего кладбища за ее стоимость воспоминания. Затем уберите ее из игры.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134322&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b38fd85d-f970-4469-bf79-7dfa5799c4fb\', \'multiverseId\': 134322}, \'multiverseid\': 134322}, {\'name\': \'狩猎的激昂感\', \'text\': \'目标生物得+1/+2直到回合结束。\\n返照{W}（你可以从你的坟墓场使用此牌，并支付其返照费用， 然后将它移出对战。）\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132516&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d387fe7d-e8fa-4741-bb1c-4228f040f6e5\', \'multiverseId\': 132516}, \'multiverseid\': 132516}]', '[{\'name\': \'Klapperschlangenremasuri\', \'text\': \'Alle Remasuris haben Flankenangriff. (Immer wenn eine Kreatur ohne Flankenangriff einen Remasuri blockt, erhält die blockende Kreatur -1/-1 bis zum Ende des Zuges.)\', \'type\': \'Kreatur — Remasuri\', \'flavor\': \'„Sie umzingelten unsere Gruppe mit der Heimlichkeit von Schlangen und trieben uns dann wie Nutzvieh zusammen." —Merrik Aidar, Benalische Patrouille\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133072&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b12ac43e-58a1-4e56-9c7a-ad4bb19ef4e3\', \'multiverseId\': 133072}, \'multiverseid\': 133072}, {\'name\': \'Fragmentado de cascabel\', \'text\': \'Todos los Fragmentados tienen la habilidad de flanquear. (Siempre que una criatura sin la habilidad de flanquear bloquee a un Fragmentado, la criatura bloqueadora obtiene -1/-1 hasta el final del turno.)\', \'type\': \'Criatura — Fragmentado\', \'flavor\': \'"Rodearon nuestra patrulla con el sigilo de las serpientes, acorralándonos como a ganado." —Merrik Aidar, patrulla benalita\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134577&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b1d5220e-7b86-44db-b7d9-7db189c7b394\', \'multiverseId\': 134577}, \'multiverseid\': 134577}, {\'name\': \'Slivoïde crotale\', \'text\': "Tous les slivoïdes ont le débordement. (À chaque fois qu\'une créature sans le débordement bloque un slivoïde, la créature bloqueuse gagne -1/-1 jusqu\'à la fin du tour.)", \'type\': \'Créature : slivoïde\', \'flavor\': \'« Ils ont cerné notre patrouille avec la discrétion des serpents, nous parquant comme du bétail. » —Merrik Aidar, patrouilleur bénalian\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132771&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'aba93cf8-a75f-4a61-9c5c-73e2be3a0d64\', \'multiverseId\': 132771}, \'multiverseid\': 132771}, {\'name\': \'Tramutante Crotalo\', \'text\': \'Tutti i Tramutanti hanno aggirare. (Ogniqualvolta una creatura senza aggirare blocca un Tramutante, la creatura bloccante prende -1/-1 fino alla fine del turno.)\', \'type\': \'Creatura — Tramutante\', \'flavor\': \'"Accerchiarono la nostra pattuglia con la furtività dei serpenti, chiudendoci come bestiame in un recinto." —Merrik Aidar, pattuglia di Benalia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133373&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'df823548-62ff-48ac-bee9-eed997441509\', \'multiverseId\': 133373}, \'multiverseid\': 133373}, {\'name\': \'横這スリヴァー\', \'text\': \'すべてのスリヴァーは側面攻撃を持つ。 （側面攻撃を持たないいずれかのクリーチャーがスリヴァーをブロックするたび、そのブロックしているクリーチャーはターン終了時まで－１/－１の修整を受ける。）\', \'type\': \'クリーチャー — スリヴァー\', \'flavor\': \'やつらは蛇のように我々巡回兵をこっそり回り込み、家畜かのように我らを囲い込んだのだ。 ――ベナリアの巡回兵、メリク・エイダー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133674&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'606d39cc-5182-43cb-8ea2-f124609b9f89\', \'multiverseId\': 133674}, \'multiverseid\': 133674}, {\'name\': \'Fractius Víbora-Cornuda\', \'text\': \'Todos os Fractius têm flanquear. (Toda vez que uma criatura sem flanquear bloquear um Fractius, a criatura bloqueadora receberá -1/-1 até o final do turno.)\', \'type\': \'Criatura — Fractius\', \'flavor\': \'"Eles circundaram nossa patrulha com a malícia das cobras, encurralando-nos como gado." —Merrik Aidar, patrulha de Benália\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133975&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'14174624-e6b7-4d42-9afb-742f95e2175f\', \'multiverseId\': 133975}, \'multiverseid\': 133975}, {\'name\': \'Обходная Щепка\', \'text\': \'Все Щепки обладают способностью Обход. (Когда существо без обхода блокирует это существо, это блокирующее существо получает -1/-1 до конца хода.)\', \'type\': \'Существо — Щепка\', \'flavor\': \'«Они окружили наш патруль кольцом змей, загоняя нас как скот», Меррик Аидар, Бенлишский патрульный\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134276&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1208cdd6-3b46-48d4-a867-783a4d5068f2\', \'multiverseId\': 134276}, \'multiverseid\': 134276}, {\'name\': \'侧击裂片妖\', \'text\': \'所有裂片妖具有侧面攻击异能。 （每当一个不具侧面攻击之生物阻挡裂片妖时，该阻挡生物得-1/-1直到回合结束。）\', \'type\': \'生物～裂片妖\', \'flavor\': \'「他们如蛇般暗中环绕巡逻地，把我们当牲口似地包围住。」 ～宾纳里亚巡卫梅里可·艾达\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132470&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'77443d57-0c49-4ddd-afd6-5cbcce341e10\', \'multiverseId\': 132470}, \'multiverseid\': 132470}]', '[{\'name\': \'Knochenbrecherremasuri\', \'text\': \'Alle Remasuris erhalten +2/+0.\', \'type\': \'Kreatur — Remasuri\', \'flavor\': \'Als der Zeitfluss immer instabiler wurde, mühten sich die Kreaturen von Dominaria, sich daran anzupassen. Der unheimliche Druck, dem sie dabei ausgesetzt waren, ließ einige Arten aussterben, aber so plötzlich wie die Aschenregen entwickelten sich auch neue, tödliche Mutationen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132874&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0d3bc4aa-ed77-4d70-a01a-f88562d200e7\', \'multiverseId\': 132874}, \'multiverseid\': 132874}, {\'name\': \'Fragmentado quebrantahuesos\', \'text\': \'Todos los Fragmentados obtienen +2/+0.\', \'type\': \'Criatura — Fragmentado\', \'flavor\': \'A medida que las fisuras en el tiempo se hacían más y más inestables, las criaturas de Dominaria luchaban por adaptarse. La intensa presión llevó a muchos callejones sin salida, pero también a nuevas y letales formas que aparecieron tan de repente como las lluvias de cenizas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134379&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ad307f89-6ac9-492c-9e8a-7cd8068cd961\', \'multiverseId\': 134379}, \'multiverseid\': 134379}, {\'name\': \'Slivoïde scinde-os\', \'text\': \'Tous les slivoïdes gagnent +2/+0.\', \'type\': \'Créature : slivoïde\', \'flavor\': "Les créatures de Dominaria tentèrent de s\'adapter aux courants temporels de plus en plus instables. Beaucoup périrent, écrasées par tant de pressions contraires, mais de nouvelles formes de vie mortelles firent leur apparition aussi soudainement que les averses de cendres.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132573&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'67952806-3b08-4f61-bc17-6ee1291988c8\', \'multiverseId\': 132573}, \'multiverseid\': 132573}, {\'name\': \'Tramutante Spaccaossa\', \'text\': \'Tutti i Tramutanti prendono +2/+0.\', \'type\': \'Creatura — Tramutante\', \'flavor\': "Mentre i flussi temporali diventavano sempre più instabili, le creature di Dominaria lottavano per adattarsi. L\'intensa pressione portava a molte situazioni senza sbocchi ma anche a nuove forme letali che apparivano all\'improvviso come piogge di cenere.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133175&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dc33e4bc-bb3b-4a2c-bc2d-769f85babc95\', \'multiverseId\': 133175}, \'multiverseid\': 133175}, {\'name\': \'断骨スリヴァー\', \'text\': \'すべてのスリヴァーは＋２/＋０の修整を受ける。\', \'type\': \'クリーチャー — スリヴァー\', \'flavor\': \'時間の流れがどんどん不安定になっていく中、ドミナリアのクリーチャーは必死に適応しようとしていた。 過度の抑圧は多くの行き詰まりを迎えたが、決定的な新しい形が灰の雨のように突然姿を現すこともあった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133476&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'96695d5c-a578-4258-8ab4-2bc6d6a419da\', \'multiverseId\': 133476}, \'multiverseid\': 133476}, {\'name\': \'Fractius Lasca-Ossos\', \'text\': \'Todos os Fractius recebem +2/+0.\', \'type\': \'Criatura — Fractius\', \'flavor\': \'À medida que os rios do tempo se tornavam cada vez mais instáveis, as criaturas de Dominária lutavam para adaptar-se. As intensas pressões levaram a muitos becos sem saída, mas também a novas formas letais que surgiram tão repentinamente como as chuvas cinzentas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133777&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e455f86e-9a88-44bb-9bc2-01091c1f2b93\', \'multiverseId\': 133777}, \'multiverseid\': 133777}, {\'name\': \'Костедробящая Щепка\', \'text\': \'Все Щепки получают +2/+0.\', \'type\': \'Существо — Щепка\', \'flavor\': \'Когда ход времени становился все более и более нестабильным, существа Доминарии старались адаптироваться. Это интенсивное давление привело ко многим тупикам, но порождало и новые формы, которые появлялись неожиданно, как пепельные дожди.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134078&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7a8fc73f-3beb-42c3-a929-6ebdbad94139\', \'multiverseId\': 134078}, \'multiverseid\': 134078}, {\'name\': \'错骨裂片妖\', \'text\': \'所有裂片妖得+2/+0。\', \'type\': \'生物～裂片妖\', \'flavor\': \'随着时间流动愈发不稳，多明纳里亚的生物也试图适应之。 在这沉重压力下，许多失败结果与强大型态有如骤降灰雨般涌现。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132272&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'be209bc1-3d89-40c8-acd0-d413c972bdbb\', \'multiverseId\': 132272}, \'multiverseid\': 132272}]', '[{\'name\': \'Kohlenheizer\', \'text\': \'Wenn der Kohlenheizer ins Spiel kommt, erhöhe deinen Manavorrat um {R}{R}{R}, falls du ihn aus deiner Hand gespielt hast.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'„Was für ein toller Tag Ich habe drei solcher Kreaturen auf meine Gegnerin losgelassen und durfte zusehen, wie mein magisches Feuer ihre Soldaten wie überreife Früchte zerplatzen ließ." —Dobruk der Schwankende, Pyromagier\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132893&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'19ddc29b-949b-4b8f-9e8b-9a56ff2151bc\', \'multiverseId\': 132893}, \'multiverseid\': 132893}, {\'name\': \'Atizador de carbón\', \'text\': \'Cuando el Atizador de carbón entre en juego, si lo jugaste de tu mano, agrega {R}{R}{R} a tu reserva de maná.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'"¡La victoria es mía Envié tres de esas criaturas contra mi enemigo, y luego observé mientras mi mago de fuego explotaba sus soldados como frutas maduras." —Dóbruk el inestable, piromante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134398&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a3bd88da-bf14-4752-aae5-0d552c77992c\', \'multiverseId\': 134398}, \'multiverseid\': 134398}, {\'name\': \'Chauffeur de charbon\', \'text\': "Quand le Chauffeur de charbon arrive en jeu, si vous l\'avez joué depuis votre main, ajoutez {R}{R}{R} à votre réserve.", \'type\': \'Créature : élémental\', \'flavor\': "« Quelle belle journée J\'ai envoyé trois de ces créatures à mon ennemi, et j\'ai admiré mon feu magique qui faisait éclater ses soldats comme des fruits trop mûrs. » —Dobruk l\'instable, pyromancien", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132592&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b57b7fe1-b248-4592-8e6b-ff4a31ffbe9c\', \'multiverseId\': 132592}, \'multiverseid\': 132592}, {\'name\': \'Fuochista Carbonaio\', \'text\': "Quando il Fuochista Carbonaio entra in gioco, se l\'hai giocato dalla tua mano, aggiungi {R}{R}{R} alla tua riserva di mana.", \'type\': \'Creatura — Elementale\', \'flavor\': \'"Oggi è la mia giornata Ho spedito tre di quelle creature contro la mia nemica, poi sono stato a guardare mentre il mio mago di fuoco trangugiava i suoi soldati come frutti amari troppo maturi." —Dobruk l\\\'Instabile, piromante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133194&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'70ee4a48-587b-46c4-856d-5385ca6f4c10\', \'multiverseId\': 133194}, \'multiverseid\': 133194}, {\'name\': \'石炭焚き\', \'text\': \'石炭焚きが場に出たとき、それがあなたの手札からプレイしたものである場合、あなたのマナ・プールに{R}{R}{R}を加える。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'もらったぜ！ こいつらを三匹敵に送り込んでから魔法火を叩き込んだんだが、兵士がはじける様は熟れ過ぎた脾臓果みたいだったぜ！ ――紅蓮術士、不安定なドブルク\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133495&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'aef4213a-705c-4173-a652-98362d9e67c0\', \'multiverseId\': 133495}, \'multiverseid\': 133495}, {\'name\': \'Grelha de Carvão\', \'text\': \'Quando Grelha de Carvão entrar em jogo, se você o jogou de sua mão, adicione {R}{R}{R} à sua reserva de mana.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'"Ganhei o dia Enviei três dessas criaturas contra meu inimigo, então fiquei observando enquanto meu fogo mágico estourava seus soldados como furiosos frutos passados." —Dobruk, o Instável, piromante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133796&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d1bb2bba-6f2d-4825-9d6f-beaf16dacda1\', \'multiverseId\': 133796}, \'multiverseid\': 133796}, {\'name\': \'Угольный Кочегар\', \'text\': \'Когда Угольный Кочегар входит в игру, если вы сыграли его из своей руки, добавьте {R}{R}{R} в ваше хранилище маны.\', \'type\': \'Существо — Элементаль\', \'flavor\': \'«Это мой день Я послал на врагов трех таких бестий, а затем наблюдал, как от магического огня солдаты взрывались как перезрелые фрукты», Бобрук Баломут, маг-поджигатель\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134097&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'268911ec-4818-4c89-989d-9c0408772626\', \'multiverseId\': 134097}, \'multiverseid\': 134097}, {\'name\': \'煤司炉\', \'text\': \'当煤司炉进场时，若你从手上使用之，则加{R}{R}{R}到你的法术力池中。\', \'type\': \'生物～元素\', \'flavor\': \'「今日大胜！ 我把这生物派了三个去对抗敌人，接下来就是欣赏对手士兵身上喷出我的法术火焰，好象蒴果过熟爆开的景象。」 ～烈焰术士，火无常东布可\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132291&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'17549699-fe34-491f-961c-0371475ed8fb\', \'multiverseId\': 132291}, \'multiverseid\': 132291}]', '[{\'name\': \'Korallenschlawiner\', \'text\': \'Morph {U} (Du kannst diese Karte verdeckt für {3} als eine 2/2 Kreatur spielen. Decke sie zu einem beliebigen Zeitpunkt für ihre Morph-Kosten auf.)\\nWenn der Korallenschlawiner aufgedeckt wird, kannst du eine bleibende Karte deiner Wahl tappen oder enttappen.\', \'type\': \'Kreatur — Meervolk, Räuber\', \'flavor\': \'Sie warten in dunklen Tiefen auf dich und lachen vor Vorfreude.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132895&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5ec9fda6-a706-47ad-b974-a17b0eaf1c7f\', \'multiverseId\': 132895}, \'multiverseid\': 132895}, {\'name\': \'Embustera de coral\', \'text\': \'Metamorfosis {U} (Puedes jugar esta carta boca abajo como una criatura 2/2 pagando {3}. Ponla boca arriba en cualquier momento pagando su coste de metamorfosis.)\\nCuando la Embustera de coral se ponga boca arriba, puedes girar o enderezar el permanente objetivo.\', \'type\': \'Criatura — Bribón tritón\', \'flavor\': \'Esperan en profundidades oscuras, riendo ávidamente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134400&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c73454da-cfb1-4aa3-9f55-9d0e1bb95b29\', \'multiverseId\': 134400}, \'multiverseid\': 134400}, {\'name\': \'Escroc des coraux\', \'text\': "Mue {U} (Vous pouvez jouer cette carte face cachée comme une créature 2/2 pour {3}. Retournez-la quand vous le désirez pour son coût de mue.)\\nQuand l\'Escroc des coraux est retourné face visible, vous pouvez engager ou dégager le permanent ciblé.", \'type\': \'Créature : ondin et gredin\', \'flavor\': \'Ils attendent dans les profondeurs les plus sombres en ricanant.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132594&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'62a70d57-5d7b-4a5c-bf45-9277fe5e5982\', \'multiverseId\': 132594}, \'multiverseid\': 132594}, {\'name\': \'Imbrogliona Corallina\', \'text\': "Metamorfosi {U} (Puoi giocare questa carta a faccia in giù come una creatura 2/2 pagando {3}. Girala a faccia in su in qualsiasi momento pagando il suo costo di metamorfosi.)\\nQuando l\'Imbrogliona Corallina viene girata a faccia in su, puoi TAPpare o STAPpare un permanente bersaglio.", \'type\': \'Creatura — Tritone Farabutto\', \'flavor\': \'Aspettano nelle profondità più buie, ridendo con impazienza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133196&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'49bed690-510b-4959-a896-2760dda98581\', \'multiverseId\': 133196}, \'multiverseid\': 133196}, {\'name\': \'珊瑚のペテン師\', \'text\': \'変異 {U} （あなたはこれを、{3}を支払うことで、裏向きの２/２のクリーチャーとしてプレイしてもよい。 いつでも変異コストを支払ってそれを表向きにすることができる。）\\n珊瑚のペテン師が表向きになったとき、パーマネント１つを対象とする。あなたはそれをタップまたはアンタップしてもよい。\', \'type\': \'クリーチャー — マーフォーク・ならず者\', \'flavor\': \'やつらは暗い深みで、笑い続けながら待っている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133497&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6d3277b6-bda3-43e4-b01d-be32c5912f8b\', \'multiverseId\': 133497}, \'multiverseid\': 133497}, {\'name\': \'Trapaceira dos Corais\', \'text\': \'Metamorfose {U} (Você pode jogar este card com a face voltada para baixo como uma criatura 2/2 por {3}. Vire sua face para cima a qualquer momento pagando seu custo de metamorfose.)\\nQuando Trapaceira dos Corais for virada para cima, você poderá virar ou desvirar a permanente alvo.\', \'type\': \'Criatura — Ladino Tritão\', \'flavor\': \'Elas espreitam nas profundezas escuras, rindo avidamente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133798&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6e820576-b322-42b8-bfd4-dfe89fda52cc\', \'multiverseId\': 133798}, \'multiverseid\': 133798}, {\'name\': \'Коралловый Мошенник\', \'text\': \'Оборотень {U} (Вы можете играть эту карту лицом вниз как 2/2 существо за {3}. Переверните ее лицом вверх в любой момент за ее стоимость оборотня.)\\nКогда Коралловый Мошенник переворачивается лицом вверх, вы можете повернуть или развернуть целевой перманент.\', \'type\': \'Существо — Мерфолк Бродяга\', \'flavor\': \'Они поджидают в темных глубинах, нетерпеливо посмеиваясь.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134099&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'aaaf4b8b-4ed3-463c-bf8e-fe8dc8a4a4b7\', \'multiverseId\': 134099}, \'multiverseid\': 134099}, {\'name\': \'珊瑚诈术师\', \'text\': \'变身{U}（你可牌面朝下地使用此牌并支付{3}，将其当成2/2生物。 可随时支付其变身费用使其翻回正面。）\\n当珊瑚诈术师翻回正面时，你可以横置或重置目标永久物。\', \'type\': \'生物～人鱼／浪客\', \'flavor\': \'她们在黑暗深渊中等待，热切地笑着。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132293&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a712b1dd-c133-4fa5-9029-1b2d6f99bd3e\', \'multiverseId\': 132293}, \'multiverseid\': 132293}]', '[{\'name\': \'Korpulente Leiche\', \'text\': \'Verursacht Furcht\\nAussetzen 5 {B} (Statt diese Karte aus deiner Hand zu spielen, kannst du {B} bezahlen, sie ganz aus dem Spiel entfernen und fünf Zeitmarken auf sie legen. Entferne zu Beginn deines Versorgungssegments eine Zeitmarke von ihr. Wenn du die letzte Zeitmarke entfernst, spiele die Karte, ohne ihre Manakosten zu bezahlen. Sie hat Eile.)\', \'type\': \'Kreatur — Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132896&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6c8472a5-f0b1-44cb-a1d3-a5368b2aae50\', \'multiverseId\': 132896}, \'multiverseid\': 132896}, {\'name\': \'Cuerpo corpulento\', \'text\': \'Inspirar temor.\\nSuspender 5—{B} (En lugar de jugar esta carta de tu mano, puedes pagar {B} y removerla del juego con cinco contadores de tiempo sobre ella. Al comienzo de tu mantenimiento, remueve un contador de tiempo. Cuando remuevas el último, juégala sin pagar su coste de maná. Tiene la habilidad de prisa.)\', \'type\': \'Criatura — Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134401&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6e493c46-5b64-4d4c-9aa8-126b7e03a69d\', \'multiverseId\': 134401}, \'multiverseid\': 134401}, {\'name\': \'Cadavre corpulent\', \'text\': \'Peur\\nSuspension 5 — {B} (Plutôt que jouer cette carte depuis votre main, vous pouvez payer {B} et la retirer de la partie avec cinq marqueurs « temps » sur elle. Au début de votre entretien, retirez un marqueur « temps ». Quand vous retirez le dernier, jouez cette carte sans payer son coût de mana. Elle a la célérité.)\', \'type\': \'Créature : zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132595&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d4598322-e437-4853-b94d-f059efe55865\', \'multiverseId\': 132595}, \'multiverseid\': 132595}, {\'name\': \'Cadavere Obeso\', \'text\': "Paura\\nSospendere 5—{B} (Invece di giocare questa carta dalla tua mano, puoi pagare {B} e rimuoverla dal gioco con cinque segnalini tempo su di essa. All\'inizio del tuo mantenimento, rimuovi un segnalino tempo. Quando rimuovi l\'ultimo, gioca la carta senza pagare il suo costo di mana. Ha rapidità.)", \'type\': \'Creatura — Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133197&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2b4aae77-359d-4c91-995e-685c1aba76f7\', \'multiverseId\': 133197}, \'multiverseid\': 133197}, {\'name\': \'肥満死体\', \'text\': \'畏怖\\n待機 ５―{B} （これをあなたの手札からプレイするのではなく、{B}を支払ってゲームから取り除き、その上に時間カウンターを５個置いてもよい。 あなたのアップキープの開始時に、時間カウンターを１個取り除く。 最後の１個を取り除いたとき、あなたはそれをマナ・コストを支払わずにプレイする。 それは速攻を持つ。）\', \'type\': \'クリーチャー — ゾンビ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133498&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d9730dc8-c772-4861-99ea-d1b9c7409b12\', \'multiverseId\': 133498}, \'multiverseid\': 133498}, {\'name\': \'Cadáver Corpulento\', \'text\': \'Amedrontar\\nSuspender 5—{B} (Em vez de jogar este card da sua mão, você pode pagar {B} e removê-lo do jogo com cinco marcadores temporais sobre ele. No início de sua manutenção, remova um marcador temporal. Quando remover o último, jogue-o sem pagar seu custo de mana. Ele tem ímpeto.)\', \'type\': \'Criatura — Zumbi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133799&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8c7199ee-d5ee-4ad3-8e43-c0868f046958\', \'multiverseId\': 133799}, \'multiverseid\': 133799}, {\'name\': \'Тучный Труп\', \'text\': \'Страх\\nОтсрочка 5—{B} (Вместо того чтобы сыграть эту карту из вашей руки, вы можете заплатить {B} и удалить ее из игры с пятью временными жетонами на ней. В начале вашего шага поддержки удалите один временной жетон. Когда вы удалите последний, сыграйте эту карту без оплаты ее мана-стоимости. Она получает ускорение.)\', \'type\': \'Существо — Зомби\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134100&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9bff0a22-8e18-4c52-bbfb-57503f2908ec\', \'multiverseId\': 134100}, \'multiverseid\': 134100}, {\'name\': \'肥胖死尸\', \'text\': \'恐惧\\n延缓5～{B}（除了从你手上使用此牌，你可以支付{B}并将此牌移出对战，且上面有五个计时指示物。 在你的维持开始时，从其上移去一个计时指示物。 当你移去最后一个时，则使用它且不需支付其法术力费用。 它具有敏捷。）\', \'type\': \'生物～灵俑\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132294&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'266e3f4f-daeb-4b65-9d36-168277636716\', \'multiverseId\': 132294}, \'multiverseid\': 132294}]', '[{\'name\': \'Kraftlosigkeit\', \'text\': \'Aufblitzen (Du kannst diesen Zauberspruch zu jedem Zeitpunkt spielen, zu dem du einen Spontanzauber spielen könntest.)Kreaturenverzauberung\\nDie verzauberte Kreatur erhält-2/-1.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Mit einer kleinen Prise Magie kann man die entkräftigende Wirkung von Urborgs giftigen Winden zügeln.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132928&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c9f2a2e4-1620-4e88-be02-2f30ce1361ff\', \'multiverseId\': 132928}, \'multiverseid\': 132928}, {\'name\': \'Flaqueza\', \'text\': \'Destello (Puedes jugar este hechizo en cualquier momento en que pudieras jugar un instantáneo.)\\nEncantar criatura.\\nLa criatura encantada obtiene -2/-1.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"Sólo un poco de magia es suficiente para dominar el debilitante poder de los vientos venenosos de Urborg." —Rátadrabik de Urborg\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134433&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'32c75495-0ff3-4266-97ca-56a9b736da21\', \'multiverseId\': 134433}, \'multiverseid\': 134433}, {\'name\': \'Dépérissement\', \'text\': \'Flash (Vous pouvez jouer ce sort à tout moment où vous pourriez jouer un éphémère.)\\nEnchanter : créature\\nLa créature enchantée gagne -2/-1.\', \'type\': \'Enchantement : aura\', \'flavor\': "Un soupçon de magie suffit pour contrôler la force faiblissante des vents empoisonnés d\'Urborg.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132627&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'13bef4e5-6c1a-4965-b90e-2b87e856da7c\', \'multiverseId\': 132627}, \'multiverseid\': 132627}, {\'name\': \'Debolezza\', \'text\': \'Lampo (Puoi giocare questa magia in ogni momento in cui potresti giocare un istantaneo.)\\nIncanta creatura\\nLa creatura incantata prende -2/-1.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'Basta un lieve tocco di magia per imbrigliare la potenza debilitante dei venti venefici di Urborg.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133229&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6aa3adb7-c1a9-4166-b8c2-a4b88e0829e3\', \'multiverseId\': 133229}, \'multiverseid\': 133229}, {\'name\': \'虚弱\', \'text\': \'瞬速 （あなたはこの呪文を、あなたがインスタントをプレイできるときならいつでもプレイしてよい。）\\nエンチャント（クリーチャー）\\nエンチャントされているクリーチャーは－２/－１の修整を受ける。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'魔法に少し触れるだけで、アーボーグの瘴気の衰弱の力を操ることができる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133530&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1670a5c4-38ee-4908-a4e2-7c0bdb68c11e\', \'multiverseId\': 133530}, \'multiverseid\': 133530}, {\'name\': \'Debilidade\', \'text\': \'Lampejo (Você poderá jogar esta mágica a qualquer momento em que puder jogar uma mágica instantânea.)\\nEncantar Criatura\\nA criatura encantada recebe -2/-1.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Apenas um pequeno toque de mágica pode frear o poder enfraquecedor dos ventos venenosos de Urborg."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133831&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7749a132-e581-4059-91e8-3aeb179bddf0\', \'multiverseId\': 133831}, \'multiverseid\': 133831}, {\'name\': \'Немощность\', \'text\': \'Миг (Вы можете играть это заклинание в любое время когда вы можете играть мгновенные заклинания.)\\nЗачаровать существо\\nЗачарованное существо получает -2/-1.\', \'type\': \'Чары — Аура\', \'flavor\': \'Даже слабое прикосновение магии может использовать пожирающие силу ядовитые ветра Урборга.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134132&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fe3b6dcf-f72a-4b02-9321-55c73d0bf4a1\', \'multiverseId\': 134132}, \'multiverseid\': 134132}, {\'name\': \'无力感\', \'text\': \'闪现（你可以于你能够使用瞬间的时机下使用此咒语。）\\n生物结界\\n受此结界的生物得-2/-1。\', \'type\': \'结界～灵气\', \'flavor\': \'只要用点法术，就能驾驭乌尔博格的夺力毒风。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132326&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c5d5b6e7-0afb-4a8a-8fcc-3d32b43332f7\', \'multiverseId\': 132326}, \'multiverseid\': 132326}]', '[{\'name\': \'Kreischender Remasuri\', \'text\': \'Alle Remasuris haben „{T}: Ein Spieler deiner Wahl legt die oberste Karte seiner Bibliothek auf seinen Friedhof."\', \'type\': \'Kreatur — Remasuri\', \'flavor\': \'„Was meinen Leuten am meisten zusetzt, ist nicht die Gefahr, sondern wahrscheinlich das endlose Gekreische vor unserem Lager." —Merrik Aidar, Benalische Patrouille\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133065&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bcc85ef1-baf5-4543-a7ef-5eb4f878877f\', \'multiverseId\': 133065}, \'multiverseid\': 133065}, {\'name\': \'Fragmentado chillón\', \'text\': \'Todos los Fragmentados tienen "{T}: El jugador objetivo pone la primera carta de su biblioteca en su cementerio".\', \'type\': \'Criatura — Fragmentado\', \'flavor\': \'"Creo que lo que más desanima a mis hombres no es el peligro, sino los chillidos interminables fuera del campamento." —Merrik Aidar, patrulla benalita\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134570&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b4dec1e0-40a5-44e4-81db-0cea07556a62\', \'multiverseId\': 134570}, \'multiverseid\': 134570}, {\'name\': \'Slivoïde grinçant\', \'text\': \'Tous les slivoïdes ont « {T} : Le joueur ciblé met la carte du dessus de sa bibliothèque dans son cimetière. »\', \'type\': \'Créature : slivoïde\', \'flavor\': "« Ce qui fatigue le plus mes camarades, ce n\'est pas le danger, je pense, mais les glapissements incessants à la lisière de notre camp. » —Merrik Aidar, patrouilleur bénalian", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132764&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a0407b77-dfd5-45b8-a2a6-4db27c8a7abb\', \'multiverseId\': 132764}, \'multiverseid\': 132764}, {\'name\': \'Tramutante Stridente\', \'text\': \'Tutti i Tramutanti hanno "{T}: Un giocatore bersaglio mette nel proprio cimitero la prima carta del proprio grimorio."\', \'type\': \'Creatura — Tramutante\', \'flavor\': \'"Ciò che più logora la mia gente, credo, non è il pericolo, ma l\\\'incessante stridio fuori dall\\\'accampamento." —Merrik Aidar, pattuglia di Benalia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133366&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'549b8f3d-01c5-449f-8b99-eb09444e9f43\', \'multiverseId\': 133366}, \'multiverseid\': 133366}, {\'name\': \'奇声スリヴァー\', \'text\': \'すべてのスリヴァーは「{T}：プレイヤー１人を対象とする。そのプレイヤーは、自分のライブラリーの一番上のカードを自分の墓地に置く。」の能力を持つ。\', \'type\': \'クリーチャー — スリヴァー\', \'flavor\': \'人々が参っているのは危険にではなく、野営地の外で際限なく響き続けている奇声になのだ。 ――ベナリアの巡回兵、メリク・エイダー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133667&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'602a8869-d94e-4660-815c-4332c5bf707b\', \'multiverseId\': 133667}, \'multiverseid\': 133667}, {\'name\': \'Fractius Guinchante\', \'text\': \'Todos os Fractius têm "{T}: O jogador alvo coloca o card do topo de seu grimório em seu cemitério.\', \'type\': \'Criatura — Fractius\', \'flavor\': \'"O que cansa meu povo, acredito, não é o perigo, mas o incessante guinchar fora de nosso acampamento." —Merrik Aidar, patrulha de Benália\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133968&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'af7a08a5-d420-475c-9fcd-163c917a7bad\', \'multiverseId\': 133968}, \'multiverseid\': 133968}, {\'name\': \'Визжащяя Щепка\', \'text\': \'Все Щепки обладают способностью "{T}: Целевой игрок кладет верхнюю карту своей библиотеки на свое кладбище."\', \'type\': \'Существо — Щепка\', \'flavor\': \'«То, что подавляло моих людей более всего, я думаю, было не опасностью, а бесконечным визгом за пределами нашего лагеря», Меррик Аидар, Беналишский патрульный\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134269&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'99c20a64-687c-442f-917d-33d6b8cc42c6\', \'multiverseId\': 134269}, \'multiverseid\': 134269}, {\'name\': \'尖鸣裂片妖\', \'text\': \'所有裂片妖具有「{T}：目标牌手将其牌库顶牌置入其坟墓场。」\', \'type\': \'生物～裂片妖\', \'flavor\': \'「要说最让我们疲弱的东西，我想并不是危险，而是营地外永无止境的尖鸣。」 ～宾纳里亚巡卫梅里可·艾达\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132463&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8d0fb37c-c04f-4002-87ff-34bb803c6c27\', \'multiverseId\': 132463}, \'multiverseid\': 132463}]', '[{\'name\': \'Krosas Eingriff\', \'text\': \'Sekundenbruchteil (Solange dieser Zauberspruch sich auf dem Stapel befindet, können Spieler keine Zaubersprüche oder aktivierte Fähigkeiten spielen, die keine Manafähigkeiten sind.)\\nZerstöre ein Artefakt oder eine Verzauberung deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Legt diese Spruchrollen beiseite, es sind unnatürliche Waffen. Herz, Köpfchen und zwei Fäuste reichen aus." —Zyd, Kamahldruide\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132987&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fe8cdbe2-fb31-4366-8220-7f662d114885\', \'multiverseId\': 132987}, \'multiverseid\': 132987}, {\'name\': \'Abrazo krosano\', \'text\': \'Fracción de segundo (Mientras este hechizo esté en la pila, los jugadores no pueden jugar hechizos o habilidades activadas que no sean habilidades de maná.)\\nDestruye el artefacto o encantamiento objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Abandona esas armas sobrenaturales, esos pergaminos. El corazón, la mente y el puño son suficientes." —Zyd, druida kamahlita\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134492&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c59d7c09-97ed-4e1c-b13b-9ee6ca9eb77e\', \'multiverseId\': 134492}, \'multiverseid\': 134492}, {\'name\': \'Poigne krosiane\', \'text\': "Fraction de seconde (Tant que ce sort est sur la pile, les joueurs ne peuvent pas jouer de sorts ou de capacités activées qui ne sont pas des capacités de mana.)\\nDétruisez l\'artefact ciblé ou l\'enchantement ciblé.", \'type\': \'Éphémère\', \'flavor\': \'« Abandonnez ces armes surnaturelles, ces parchemins. Un cœur, un esprit et des poings suffisent. » —Zyd, druide kamahlite\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132686&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1664cddf-123d-4eb5-8213-cad6aa0d9d43\', \'multiverseId\': 132686}, \'multiverseid\': 132686}, {\'name\': \'Stretta di Krosa\', \'text\': \'Battibaleno (Fintanto che questa magia è in pila, i giocatori non possono giocare magie o abilità attivate che non siano abilità di mana.)\\nDistruggi un artefatto o un incantesimo bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Rinuncia a queste armi innaturali, queste pergamene. Il cuore, la mente e i pugni sono sufficienti." —Zyd, druido di Kamahl\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133288&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7f8b6e2f-965d-4000-a4d3-bb12be3ad487\', \'multiverseId\': 133288}, \'multiverseid\': 133288}, {\'name\': \'クローサの掌握\', \'text\': \'刹那 （この呪文がスタックにあるかぎり、プレイヤーは呪文やマナ能力でない起動型能力をプレイできない。）\\nアーティファクト１つかエンチャント１つを対象とし、それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'自然に反する武器や巻物など手放しなさい。 心臓と心と拳で十分ではありませんか。 ――カマーライトのドルイド、ジド\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133589&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'47a8cd2a-4230-4bf0-b57f-f1d1831b6ad3\', \'multiverseId\': 133589}, \'multiverseid\': 133589}, {\'name\': \'Garra Krosana\', \'text\': \'Fração de segundo (Enquanto esta mágica estiver na pilha, os jogadores não poderão jogar mágicas ou habilidades ativadas que não sejam habilidades de mana.)\\nDestrua o artefato alvo ou o encantamento alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Desista dessas armas artificiais, desses pergaminhos. O coração, a mente e o punho bastam." —Zyd, druida kamahliano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133890&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'54fbf0b3-4cec-47e6-ab5f-9fe627adf807\', \'multiverseId\': 133890}, \'multiverseid\': 133890}, {\'name\': \'Кросанская Хватка\', \'text\': \'Мгновение ока (До тех пор пока это заклинание находится в стеке, игроки не могут играть заклинания или активируемые способности, которые не являются мана-способностями.)\\nУничтожьте целевой артефакт или чары.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Оставь все неестественные орудия и заклинания. Сердце, разум и кулак вот все, что тебе нужно», Зид, Друид-камалит\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134191&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f94044cf-2186-4619-8f1a-6647209142b5\', \'multiverseId\': 134191}, \'multiverseid\': 134191}, {\'name\': \'克洛萨之攫\', \'text\': \'转瞬（只要此咒语在堆叠上，牌手便不能使用咒语或不是法术力异能的起动式异能。）\\n消灭目标神器或结界。\', \'type\': \'瞬间\', \'flavor\': \'「放弃那些违逆自然的武器与卷轴吧。 心，意，拳，这便够了。」 ～卡马尔宗德鲁伊季德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132385&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'df990840-2d8b-4a79-8280-df27b8d4ec5e\', \'multiverseId\': 132385}, \'multiverseid\': 132385}]', '[{\'name\': \'Krummklauen-Umwandler\', \'text\': \'Aufblitzen (Du kannst diesen Zauberspruch zu jedem Zeitpunkt spielen, zu dem du einen Spontanzauber spielen könntest.)\\nFliegend\\nWenn der Krummklauen-Umwandler ins Spiel kommt, vertausche Stärke und Widerstandskraft einer Kreatur deiner Wahl bis zum Ende des Zuges.\', \'type\': \'Kreatur — Vogel, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132897&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c8dadf53-c6c0-46e2-8da8-1df7c0592407\', \'multiverseId\': 132897}, \'multiverseid\': 132897}, {\'name\': \'Transmutador garracurva\', \'text\': \'Destello (Puedes jugar este hechizo en cualquier momento en que pudieras jugar un instantáneo.)\\nVuela.\\nCuando el Transmutador garracurva entre en juego, intercambia la fuerza con la resistencia de la criatura objetivo hasta el final del turno.\', \'type\': \'Criatura — Hechicero ave\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134402&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ced1c54c-15ef-4d41-9650-4562d61b5fee\', \'multiverseId\': 134402}, \'multiverseid\': 134402}, {\'name\': \'Transmutateur crocheserre\', \'text\': "Flash (Vous pouvez jouer ce sort à tout moment où vous pourriez jouer un éphémère.)\\nVol\\nQuand le Transmutateur crocheserre arrive en jeu, échangez la force et l\'endurance de la créature ciblée jusqu\'à la fin du tour.", \'type\': \'Créature : oiseau et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132596&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2186b985-933f-42f3-8549-086173966f9d\', \'multiverseId\': 132596}, \'multiverseid\': 132596}, {\'name\': \'Trasmutatore Artiglio Curvo\', \'text\': \'Lampo (Puoi giocare questa magia in ogni momento in cui potresti giocare un istantaneo.)\\nVolare\\nQuando il Trasmutatore Artiglio Curvo entra in gioco, scambia forza e costituzione di una creatura bersaglio fino alla fine del turno.\', \'type\': \'Creatura — Mago Uccello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133198&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'06d17a9d-b406-4d19-8c1a-0bfc9e26a18b\', \'multiverseId\': 133198}, \'multiverseid\': 133198}, {\'name\': \'歪んだ爪の変成者\', \'text\': \'瞬速 （あなたはこの呪文を、あなたがインスタントをプレイできるときならいつでもプレイしてよい。）\\n飛行\\n歪んだ爪の変成者が場に出たとき、クリーチャー１体を対象とし、ターン終了時まで、それのパワーとタフネスを入れ替える。\', \'type\': \'クリーチャー — 鳥・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133499&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b29b833f-0ba2-43c4-94ac-cf052fd44df1\', \'multiverseId\': 133499}, \'multiverseid\': 133499}, {\'name\': \'Transmutador de Garras Curvas\', \'text\': \'Lampejo (Você poderá jogar esta mágica a qualquer momento em que puder jogar uma mágica instantânea.)\\nVoar\\nQuando Transmutador de Garras Curvas entrar em jogo, permute o poder e a resistência da criatura alvo até o final do turno.\', \'type\': \'Criatura — Mago Pássaro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133800&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'09013866-5e24-4159-aa61-5ac5d1bbd9f3\', \'multiverseId\': 133800}, \'multiverseid\': 133800}, {\'name\': \'Маг Изогнутого Когтя\', \'text\': \'Миг (Вы можете играть это заклинание в любое время, когда вы можете играть мгновенные заклинания.)\\nПолет\\nКогда Маг Изогнутого Когтя входит в игру, поменяйте силу и защиту целевого существа до конца хода.\', \'type\': \'Существо — Птица Чародей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134101&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ac11dc37-88d2-4811-8426-b2eebbbb0716\', \'multiverseId\': 134101}, \'multiverseid\': 134101}, {\'name\': \'钩爪易质师\', \'text\': \'闪现（你可以于你能够使用瞬间的时机下使用此咒语。）\\n飞行\\n当钩爪易质师进场时，将目标生物之力量与防御力互换直到回合结束。\', \'type\': \'生物～鸟／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132295&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f1d9af6f-382c-404b-926f-3e9c6b9c25e4\', \'multiverseId\': 132295}, \'multiverseid\': 132295}]', "[{'name': 'Kurzfristige Isolation', 'text': 'Aufblitzen (Du kannst diesen Zauberspruch zu jedem Zeitpunkt spielen, zu dem du einen Spontanzauber spielen könntest.)Kreaturenverzauberung\\nDie verzauberte Kreatur hat Irrealität. (Er kann nur Kreaturen mit Irrealität blocken und nur von ihnen geblockt werden.)\\nVerhindere allen Schaden, der von der verzauberten Kreatur zugefügt würde.', 'type': 'Verzauberung — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133109&type=card', 'language': 'German', 'identifiers': {'scryfallId': '9f125b7c-f16a-41ba-8291-33deda58e8f5', 'multiverseId': 133109}, 'multiverseid': 133109}, {'name': 'Aislamiento temporal', 'text': 'Destello (Puedes jugar este hechizo en cualquier momento en que pudieras jugar un instantáneo.)\\nEncantar criatura.\\nLa criatura encantada tiene la habilidad de desvanecerse. (Sólo puede bloquear o ser bloqueada por criaturas con la habilidad de desvanecerse.)\\nPrevén todo el daño que fuera a ser hecho por la criatura encantada.', 'type': 'Encantamiento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134614&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'efaf22db-a8b1-4279-ae78-20906613d91b', 'multiverseId': 134614}, 'multiverseid': 134614}, {'name': 'Isolation temporelle', 'text': 'Flash (Vous pouvez jouer ce sort à tout moment où vous pourriez jouer un éphémère.)\\nEnchanter : créature\\nLa créature enchantée a la distorsion. (Elle ne peut bloquer ou être bloquée que par des créatures avec la distorsion.)\\nPrévenez toutes les blessures qui devraient être infligées par la créature enchantée.', 'type': 'Enchantement : aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132808&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a6dbb992-57f0-48c5-bee6-be5cf11ca652', 'multiverseId': 132808}, 'multiverseid': 132808}, {'name': 'Isolamento Temporale', 'text': 'Lampo (Puoi giocare questa magia in ogni momento in cui potresti giocare un istantaneo.)\\nIncanta creatura\\nLa creatura incantata ha ombra. (Può bloccare o essere bloccato solo da creature con ombra.)\\nPrevieni tutto il danno che verrebbe inflitto dalla creatura incantata.', 'type': 'Incantesimo — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133410&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '7a8388ab-1047-4224-a5f2-00239c4395fa', 'multiverseId': 133410}, 'multiverseid': 133410}, {'name': '時間の孤立', 'text': '瞬速 （あなたはこの呪文を、あなたがインスタントをプレイできるときならいつでもプレイしてよい。）\\nエンチャント（クリーチャー）\\nエンチャントされているクリーチャーはシャドーを持つ。 （それは、シャドーを持つクリーチャーのみをブロックでき、ブロックされる。）\\nエンチャントされているクリーチャーが与えるダメージをすべて軽減し、０にする。', 'type': 'エンチャント — オーラ', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133711&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '59811648-7171-42b4-837a-084254a630a9', 'multiverseId': 133711}, 'multiverseid': 133711}, {'name': 'Isolação Temporal', 'text': 'Lampejo (Você poderá jogar esta mágica a qualquer momento em que puder jogar uma mágica instantânea.)\\nEncantar Criatura\\nA criatura encantada tem sombra. (Ele só pode bloquear ou ser bloqueado por criaturas com sombra.)\\nPrevina todo o dano que seria causado pela criatura encantada.', 'type': 'Encantamento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134012&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5b96701e-9e43-4645-bf9a-005c6760b76e', 'multiverseId': 134012}, 'multiverseid': 134012}, {'name': 'Временная Изоляция', 'text': 'Миг (Вы можете играть это заклинание в любое время, когда вы можете играть мгновенные заклинания.)\\nЗачаровать существо\\nЗачарованное существо имеет тень. (Это существо может блокировать и быть заблокировано только существ(ами) с тенью.)\\nПредотвратите все повреждения, которые будут нанесены зачарованным существом.', 'type': 'Чары — Аура', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134313&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'cf241313-c315-4036-adea-9634ee57f9d5', 'multiverseId': 134313}, 'multiverseid': 134313}, {'name': '时间孤立', 'text': '闪现（你可以于你能够使用瞬间的时机下使用此咒语。）\\n生物结界\\n受此结界的生物具有次元幽影异能。 （它只能阻挡具次元幽影异能的生物，亦只能被具此异能的生物阻挡。）\\n防止受此结界的生物将造成的所有伤害。', 'type': '结界～灵气', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132507&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '4c9276c0-df10-40fb-927c-e5fc57421bb9', 'multiverseId': 132507}, 'multiverseid': 132507}]", "[{'name': 'Kurzzeitiges Flimmern', 'text': 'Entferne eine Kreatur, die du kontrollierst, ganz aus dem Spiel und bringe sie dann unter der Kontrolle ihres Besitzers ins Spiel zurück.\\nRückblende {3}{U} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten spielen. Entferne sie dann ganz aus dem Spiel.)', 'type': 'Spontanzauber', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133010&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4cd986eb-f847-4bf3-8c22-97d4e02a9623', 'multiverseId': 133010}, 'multiverseid': 133010}, {'name': 'Pestañeo momentáneo', 'text': 'Remueve del juego la criatura objetivo que controlas, luego regrésala al juego bajo el control de su propietario.\\nRetrospectiva {3}{U} (Puedes jugar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego remuévela del juego.)', 'type': 'Instantáneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134515&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '8f1a772e-d1de-4871-a906-390989f69785', 'multiverseId': 134515}, 'multiverseid': 134515}, {'name': 'Scintillement momentané', 'text': 'Retirez la créature ciblée que vous contrôlez de la partie, puis renvoyez-la en jeu sous le contrôle de son propriétaire.\\nFlashback {3}{U} (Vous pouvez jouer cette carte depuis votre cimetière pour son coût de flashback. Retirez-la ensuite de la partie.)', 'type': 'Éphémère', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132709&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e2fcad20-6c25-4adb-b93e-b32a633b1512', 'multiverseId': 132709}, 'multiverseid': 132709}, {'name': 'Intermittenza Momentanea', 'text': 'Rimuovi dal gioco una creatura bersaglio che controlli, poi rimettila in gioco sotto il controllo del suo proprietario.\\nFlashback {3}{U} (Puoi giocare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi rimuovila dal gioco).', 'type': 'Istantaneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133311&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '90e742a8-9c0b-4053-a1c9-f2297a3b22fa', 'multiverseId': 133311}, 'multiverseid': 133311}, {'name': '一瞬の瞬き', 'text': 'あなたがコントロールするクリーチャー１体を対象とし、それをゲームから取り除き、その後オーナーのコントロール下で場に戻す。\\nフラッシュバック {3}{U} （あなたはフラッシュバック・コストで、このカードをあなたの墓地からプレイしてもよい。 その後それをゲームから取り除く）', 'type': 'インスタント', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133612&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '1cffe7c2-86c4-4776-b627-278d7a03d4da', 'multiverseId': 133612}, 'multiverseid': 133612}, {'name': 'Piscadela Momentânea', 'text': 'Remova do jogo a criatura alvo que você controla, em seguida, devolva-a ao jogo sob o controle de seu dono.\\nRecapitular {3}{U} (Você pode jogar este card de seu cemitério pagando seu custo de recapitulação. Depois remova-o do jogo.)', 'type': 'Mágica Instantânea', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133913&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3d249577-00d9-4a9f-9a0a-15a9223b463e', 'multiverseId': 133913}, 'multiverseid': 133913}, {'name': 'Молниеносное Мигание', 'text': 'Удалите целевое существо под вашим контролем из игры, затем верните его в игру под контролем его владельца.\\nВоспоминание {3}{U} (Вы можете играть эту карту из вашего кладбища за ее стоимость воспоминания. Затем уберите ее из игры.)', 'type': 'Мгновенное заклинание', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134214&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'c3c2c182-b584-4afc-ae78-ff2756fde68e', 'multiverseId': 134214}, 'multiverseid': 134214}, {'name': '瞬时闪动', 'text': '将目标由你操控的生物移出对战，然后将它在你的操控下返回场上。\\n返照{3}{U}（你可以从你的坟墓场使用此牌，并支付其返照费用， 然后将它移出对战。）', 'type': '瞬间', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132408&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b710f969-4b85-4188-9cdb-6ff5305c739b', 'multiverseId': 132408}, 'multiverseid': 132408}]", '[{\'name\': \'Laugenelementar\', \'text\': \'Morph {5}{U}{U} (Du kannst diese Karte verdeckt für {3} als eine 2/2 Kreatur spielen. Decke sie zu einem beliebigen Zeitpunkt für ihre Morph-Kosten auf.)\\nWenn das Laugenelementar aufgedeckt wird, übergehen alle Gegner ihr nächstes Enttapp-Segment.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'Wasser vereint sich mit Wasser und lässt hinter sich die Welt ausgetrocknet zurück.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132876&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fec70c2a-2542-46cb-8dc9-3295d82694c8\', \'multiverseId\': 132876}, \'multiverseid\': 132876}, {\'name\': \'Elemental marítimo\', \'text\': \'Metamorfosis {5}{U}{U} (Puedes jugar esta carta boca abajo como una criatura 2/2 pagando {3}. Ponla boca arriba en cualquier momento pagando su coste de metamorfosis.)\\nCuando el Elemental marítimo se ponga boca arriba, cada oponente se salta su próximo paso de enderezar.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'El agua llama al agua, y el mundo queda agotado y reseco a su paso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134381&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'21dd4652-2a96-4b48-8366-316f2c5eb423\', \'multiverseId\': 134381}, \'multiverseid\': 134381}, {\'name\': \'Élémental des embruns\', \'text\': "Mue {5}{U}{U} (Vous pouvez jouer cette carte face cachée comme une créature 2/2 pour {3}. Retournez-la quand vous le désirez pour son coût de mue.)\\nQuand l\'Élémental des embruns est retourné face visible, chaque adversaire passe sa prochaine étape de dégagement.", \'type\': \'Créature : élémental\', \'flavor\': "L\'eau engendre l\'eau, et elle laisse un monde desséché dans son sillage.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132575&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b4aa7f43-7522-40cd-8a56-607f4374a3c5\', \'multiverseId\': 132575}, \'multiverseid\': 132575}, {\'name\': \'Elementale del Mare\', \'text\': "Metamorfosi {5}{U}{U} (Puoi giocare questa carta a faccia in giù come una creatura 2/2 pagando {3}. Girala a faccia in su in qualsiasi momento pagando il suo costo di metamorfosi.)\\nQuando l\'Elementale del Mare viene girata a faccia in su, ogni avversario salta il suo prossimo STAP.", \'type\': \'Creatura — Elementale\', \'flavor\': "L\'acqua attira l\'acqua e il mondo è lasciato esausto e inaridito nella sua scia.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133177&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'936cdf43-0044-4d6a-a170-c488e65ab179\', \'multiverseId\': 133177}, \'multiverseid\': 133177}, {\'name\': \'塩水の精霊\', \'text\': \'変異 {5}{U}{U} （あなたはこれを、{3}を支払うことで、裏向きの２/２のクリーチャーとしてプレイしてもよい。 いつでも変異コストを支払ってそれを表向きにすることができる。）\\n塩水の精霊が表向きになったとき、各対戦相手はそのプレイヤーの次のアンタップ・ステップを飛ばす。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'水は水を呼び、その後に残された世界は疲れ果て干からびていく。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133478&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2be77b3a-6cbb-4556-8622-0302761e4179\', \'multiverseId\': 133478}, \'multiverseid\': 133478}, {\'name\': \'Elemental de Salmoura\', \'text\': \'Metamorfose {5}{U}{U} (Você pode jogar este card com a face voltada para baixo como uma criatura 2/2 por {3}. Vire sua face para cima a qualquer momento pagando seu custo de metamorfose.)\\nQuando Elemental de Salmoura é virado para cima, cada oponente pula sua próxima etapa de desvirar.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Água chama água, e o mundo esgota-se e enfraquece-se com o seu despertar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133779&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'88816d0a-c168-4fcd-ba92-d5c03ca251c8\', \'multiverseId\': 133779}, \'multiverseid\': 133779}, {\'name\': \'Морской Элементаль\', \'text\': \'Оборотень {5}{U}{U} (Вы можете играть эту карту лицом вниз как 2/2 существо за {3}. Переверните его лицом вверх в любой момент за его стоимость оборотня.)\\nКогда Морской Элементаль переворачивается лицом вверх, каждый оппонент пропускает свой следующий шаг разворота.\', \'type\': \'Существо — Элементаль\', \'flavor\': \'Вода взывает к воде, и в этом бдении мир остается изнуренным и парализованным.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134080&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a72ec53c-26ad-40b5-b2e9-d4134607dbf3\', \'multiverseId\': 134080}, \'multiverseid\': 134080}, {\'name\': \'盐湖元素\', \'text\': \'变身{5}{U}{U}（你可牌面朝下地使用此牌并支付{3}，将其当成2/2生物。 可随时支付其变身费用使其翻回正面。）\\n当盐湖元素翻回正面时，每位对手略过其下一个重置步骤。\', \'type\': \'生物～元素\', \'flavor\': \'水份凝聚汇流，遗下一片干枯世界。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132274&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1cb64a04-4be7-4348-9652-274fea0f35fd\', \'multiverseId\': 132274}, \'multiverseid\': 132274}]', '[{\'name\': \'Lebendiges Lebensende\', \'text\': \'Lebendiges Lebensende ist schwarz.\\nAussetzen 3 {2}{B}{B}\\nJeder Spieler entfernt alle Kreaturenkarten in seinem Friedhof ganz aus dem Spiel, opfert dann alle Kreaturen, die er kontrolliert, und bringt dann alle Karten, die er auf diese Weise ganz aus dem Spiel entfernt hat, ins Spiel.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132991&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'08d568c6-f477-45ef-9b94-a6375dac4fdb\', \'multiverseId\': 132991}, \'multiverseid\': 132991}, {\'name\': \'Fin viviente\', \'text\': \'El Fin viviente es negro.\\nSuspender 3—{2}{B}{B}.\\nCada jugador remueve del juego todas las cartas de criatura de su cementerio, luego sacrifica todas las criaturas que controla, luego pone en juego todas las cartas que removió de esta manera.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134496&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'df5af86c-4b02-4ee7-8eb4-9f0bacaaaf50\', \'multiverseId\': 134496}, \'multiverseid\': 134496}, {\'name\': \'Fin vivante\', \'text\': "La Fin vivante est noire.\\nSuspension 3 — {2}{B}{B}\\nChaque joueur retire de la partie toutes les cartes de créature de son cimetière, puis sacrifie toutes les créatures qu\'il contrôle, et met ensuite en jeu toutes les cartes qu\'il a retirées de cette manière.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132690&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fe4f2992-f6b6-4022-a3eb-423a3e00e063\', \'multiverseId\': 132690}, \'multiverseid\': 132690}, {\'name\': \'Fine Vivente\', \'text\': \'Fine Vivente è nera.\\nSospendere 3—{2}{B}{B}\\nOgni giocatore rimuove dal gioco tutte le carte creatura nel proprio cimitero, poi sacrifica tutte le creature che controlla, poi mette in gioco tutte le carte che ha rimosso in questo modo.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133292&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'70e94584-fb87-48fa-b189-3cd0ee4c62a3\', \'multiverseId\': 133292}, \'multiverseid\': 133292}, {\'name\': \'死せる生\', \'text\': \'死せる生は黒である。\\n待機 ３―{2}{B}{B}\\n各プレイヤーは、自分の墓地にあるすべてのクリーチャー・カードをゲームから取り除き、その後自分がコントロールするすべてのクリーチャーを生け贄に捧げ、その後これによりゲームから取り除かれたすべてのカードを場に出す。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133593&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8f11b75d-5c74-4eb7-90b9-1b30e43c3e34\', \'multiverseId\': 133593}, \'multiverseid\': 133593}, {\'name\': \'Morte Vívida\', \'text\': \'Morte Vívida é preto.\\nSuspender 3—{2}{B}{B}\\nCada jogador remove do jogo todos os cards de criatura de seu próprio cemitério, então sacrifica todas as criaturas que ele controla e, em seguida coloca em jogo todos os cards que ele removeu desse modo.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133894&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e96a9ff7-e54e-4c52-ac39-f8b4302c1b5e\', \'multiverseId\': 133894}, \'multiverseid\': 133894}, {\'name\': \'Смерть Живого\', \'text\': \'Смерть Живого является черной.\\nОтсрочка 3—{2}{B}{B}\\nКаждый игрок удаляет все карты существ из своего кладбища из игры, затем жертвует всех существ под своим контролем, затем кладет в игру все карты существ, которые он или она удалили из игры таким образом.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134195&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dff18eb2-5cb2-4fff-839f-8bdc559597dc\', \'multiverseId\': 134195}, \'multiverseid\': 134195}, {\'name\': \'走骨行尸\', \'text\': \'走骨行尸是黑色。\\n延缓3～{2}{B}{B}\\n每位牌手将其坟墓场中所有生物牌移出对战，然后牺牲由他操控的所有生物，然后将他以此法移出对战的所有牌放置进场。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132389&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4c13421b-f690-430f-ac11-7f252b5b9da0\', \'multiverseId\': 132389}, \'multiverseid\': 132389}]', '[{\'name\': \'Lim-Dûl der Geisterbeschwörer\', \'text\': \'Immer wenn eine Kreatur, die ein Gegner kontrolliert, aus dem Spiel auf einen Friedhof gelegt wird, kannst du {1}{B} bezahlen. Falls du dies tust, bringe diese Karte unter deiner Kontrolle ins Spiel zurück. Falls es eine Kreatur ist, ist sie zusätzlich zu ihren anderen Kreaturentypen ein Zombie.\\n{1}{B}: Regeneriere einen Zombie deiner Wahl.\', \'type\': \'Legendäre Kreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132990&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'400b1641-3c05-4028-8e91-8e7aa95d94db\', \'multiverseId\': 132990}, \'multiverseid\': 132990}, {\'name\': \'Lim-Dûl el Nigromante\', \'text\': \'Siempre que una criatura que controla un oponente vaya a un cementerio desde el juego, puedes pagar {1}{B}. Si lo haces, regresa esa carta al juego bajo tu control. Si es una criatura, es un Zombie además de sus otros tipos de criatura.\\n{1}{B}: Regenera el Zombie objetivo.\', \'type\': \'Criatura legendaria — Hechicero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134495&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'85be3d08-505f-459f-b22e-03caeb1c724f\', \'multiverseId\': 134495}, \'multiverseid\': 134495}, {\'name\': \'Lim-Dûl, le Nécromancien\', \'text\': "À chaque fois qu\'une créature qu\'un adversaire contrôle est mise dans un cimetière depuis le jeu, vous pouvez payer {1}{B}. Si vous faites ainsi, renvoyez en jeu cette carte sous votre contrôle. Si c\'est une créature, c\'est un zombie en plus de ses autres types de créature.\\n{1}{B} : Régénérez le zombie ciblé.", \'type\': \'Créature légendaire : humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132689&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7a2fd786-3d67-41f1-a00f-fdc1723cb82f\', \'multiverseId\': 132689}, \'multiverseid\': 132689}, {\'name\': \'Lim-Dûl il Necromante\', \'text\': \'Ogniqualvolta una creatura controllata da un avversario viene messa in un cimitero dal gioco, puoi pagare {1}{B}. Se lo fai, rimetti quella carta in gioco sotto il tuo controllo. Se è una creatura, è uno Zombie in aggiunta ai propri altri tipi di creatura.\\n{1}{B}: Rigenera uno Zombie bersaglio.\', \'type\': \'Creatura Leggendaria — Mago Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133291&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7e95a42c-8e39-41f0-81a3-370ba9519fb5\', \'multiverseId\': 133291}, \'multiverseid\': 133291}, {\'name\': \'屍術師リム＝ドゥール\', \'text\': \'対戦相手がコントロールするいずれかのクリーチャーが場からいずれかの墓地に置かれるたび、あなたは{1}{B}を支払ってもよい。 そうした場合、そのカードをあなたのコントロール下で場に戻す。 それがクリーチャーである場合、それは他のクリーチャー・タイプに加えてゾンビでもある。\\n{1}{B}：ゾンビ１体を対象とし、それを再生する。\', \'type\': \'伝説のクリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133592&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a8750208-addc-4cf0-94d6-909a3c0a09c7\', \'multiverseId\': 133592}, \'multiverseid\': 133592}, {\'name\': \'Lim-Dûl, o Necromante\', \'text\': \'Toda vez que uma criatura que um oponente controla é colocada no cemitério vinda do jogo, você pode pagar {1}{B}. Se o fizer, devolva aquele card para o jogo sob seu controle. Se for uma criatura, ela será um Zumbi, além de seus outros tipos de criatura.\\n{1}{B}: Regenere o Zumbi alvo.\', \'type\': \'Criatura Lendária — Mago Humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133893&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6b9471e7-9118-4b24-b546-bb4e5b101bd7\', \'multiverseId\': 133893}, \'multiverseid\': 133893}, {\'name\': \'Лим-Дул, Некромант\', \'text\': \'Когда существо под контролем оппонента попадает на кладбище из игры, вы можете заплатить {1}{B}. Если вы это сделали, верните эту карту в игру под вашим контролем. Если это существо, оно получает Зомби в дополнение к его типам существа.\\n{1}{B}: Регенерируйте целевого Зомби.\', \'type\': \'Легендарное Существо — Человек Чародей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134194&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2384e0d0-6b7b-4890-bf90-167d8356fd43\', \'multiverseId\': 134194}, \'multiverseid\': 134194}, {\'name\': \'死灵术士林杜\', \'text\': \'每当一个由对手操控的生物从场上置入坟墓场时，你可以支付{1}{B}。 若你如此作，将该牌在你的操控下返回场上。 若它是生物，则它额外具有「灵俑」此生物类别。\\n{1}{B}：重生目标灵俑。\', \'type\': \'传奇生物～人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132388&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'feff3443-7626-4f8f-a928-58861cc6760b\', \'multiverseId\': 132388}, \'multiverseid\': 132388}]', '[{\'name\': \'Lotus-Blütezeit\', \'text\': \'Aussetzen 3 {0} (Statt diese Karte aus deiner Hand zu spielen, bezahle {0}, entferne sie ganz aus dem Spiel und lege drei Zeitmarken auf sie. Entferne zu Beginn deines Versorgungssegments eine Zeitmarke von ihr. Wenn du die letzte Zeitmarke entfernst, spiele die Karte, ohne ihre Manakosten zu bezahlen.)\\n{T}, opfere die Lotus-Blütezeit: Erhöhe deinen Manavorrat um drei Mana einer beliebigen Farbe.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132994&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9ba2db22-eaf9-4f0d-8ce2-7e04ec3d4b61\', \'multiverseId\': 132994}, \'multiverseid\': 132994}, {\'name\': \'Flor de loto\', \'text\': \'Suspender 3—{0} (En lugar de jugar esta carta de tu mano, paga {0} y remuévela del juego con tres contadores de tiempo sobre ella. Al comienzo de tu mantenimiento, remueve un contador de tiempo. Cuando remuevas el último, juégala sin pagar su coste de maná.)\\n{T}, sacrificar el Flor de loto: Agrega tres maná de un color cualquiera a tu reserva de maná.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134499&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'579997d4-921b-4a4f-ba82-e67c0a7e07b7\', \'multiverseId\': 134499}, \'multiverseid\': 134499}, {\'name\': \'Floraison de lotus\', \'text\': \'Suspension 3 — {0} (Plutôt que jouer cette carte depuis votre main, payez {0} et retirez-la de la partie avec trois marqueurs « temps » sur elle. Au début de votre entretien, retirez un marqueur « temps ». Quand vous retirez le dernier, jouez cette carte sans payer son coût de mana.)\\n{T}, sacrifiez la Floraison de lotus : Ajoutez trois manas de la couleur de votre choix à votre réserve.\', \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132693&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4b0f03ea-7552-463a-bdaf-14fcb33037bf\', \'multiverseId\': 132693}, \'multiverseid\': 132693}, {\'name\': \'Fiore di Loto\', \'text\': "Sospendere 3—{0} (Invece di giocare questa carta dalla tua mano, paga {0} e rimuovila dal gioco con tre segnalini tempo su di essa. All\'inizio del tuo mantenimento, rimuovi un segnalino tempo. Quando rimuovi l\'ultimo, gioca la carta senza pagare il suo costo di mana.)\\n{T}, Sacrifica il Fiore di Loto: Aggiungi tre mana di qualsiasi singolo colore alla tua riserva di mana.", \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133295&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'064d8ef5-3ea6-431b-a3de-6587e3ca6162\', \'multiverseId\': 133295}, \'multiverseid\': 133295}, {\'name\': \'睡蓮の花\', \'text\': \'待機 ３―{0} （これをあなたの手札からプレイするのではなく、{0}を支払ってゲームから取り除き、その上に時間カウンターを３個置く。 あなたのアップキープの開始時に、時間カウンターを１個取り除く。 最後の１個を取り除いたとき、あなたはそれをマナ・コストを支払わずにプレイする。）\\n{T}, 睡蓮の花を生け贄に捧げる：あなたのマナ・プールに、好きな色１色のマナ３点を加える。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133596&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4db2004d-c47f-4011-9c18-74be8c88e033\', \'multiverseId\': 133596}, \'multiverseid\': 133596}, {\'name\': \'Desabrochar do Lótus\', \'text\': \'Suspender 3—{0} (Em vez de jogar este card da sua mão, pague {0} e remova-o do jogo com três marcadores temporais sobre ele. No início de sua manutenção, remova um marcador temporal. Quando remover o último, jogue-o sem pagar seu custo de mana.)\\n{T}, Sacrifique Desabrochar do Lótus: Adicione três manas da mesma cor à sua reserva de mana.\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133897&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'486508b4-691e-4084-b73d-b228fc040e45\', \'multiverseId\': 133897}, \'multiverseid\': 133897}, {\'name\': \'Цветение Лотоса\', \'text\': \'Отсрочка 3—{0} (Вместо того чтобы сыграть эту карту из вашей руки, заплатите {0} и удалите ее из игры с тремя временными жетонами на ней. В начале вашего шага поддержки удалите один временной жетон. После удаления последнего жетона сыграйте эту карту без оплаты ее мана-стоимости.)\\n{T}, Пожертвуйте Цветение Лотоса: Добавьте три маны одного любого цвета в ваше хранилище маны.\', \'type\': \'Артефакт\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134198&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f6cb2a31-6715-4161-9323-3eb45c403d50\', \'multiverseId\': 134198}, \'multiverseid\': 134198}, {\'name\': \'盛开莲花\', \'text\': \'延缓3～{0}（除了从你手上使用此牌，你能支付{0}并将此牌移出对战，且上面有三个计时指示物。 在你的维持开始时，从其上移去一个计时指示物。 当你移去最后一个时，则使用它且不需支付其法术力费用。）\\n{T}，牺牲盛开莲花：加3点任意颜色的单色法术力到你的法术力池中。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132392&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3a0f5c05-ac31-43ce-adfa-13abdeb7802c\', \'multiverseId\': 132392}, \'multiverseid\': 132392}]', '[{\'name\': \'Lungenremasuri\', \'text\': \'Alle Remasuris haben Flugfähigkeit und „Falls diese Kreatur auf einen Friedhof gelegt würde, kannst du sie stattdessen oben auf die Bibliothek ihres Besitzers legen".\', \'type\': \'Kreatur — Remasuri\', \'flavor\': \'Er pumpt wie ein großer Blasebalg, um seine Artgenossen, tot wie lebendig, in Sicherheit zu bringen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133051&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'95601b42-5dda-4e52-b776-3f7e76bc9678\', \'multiverseId\': 133051}, \'multiverseid\': 133051}, {\'name\': \'Fragmentado pulmonar\', \'text\': \'Todos los Fragmentados tienen la habilidad de volar y "Si esta criatura fuera a un cementerio, en vez de eso, puedes ponerla en la parte superior de la biblioteca de su propietario".\', \'type\': \'Criatura — Fragmentado\', \'flavor\': \'Sisea como un gran fuelle, y sus hermanos, vivos y muertos, se elevan a un lugar seguro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134556&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e469119c-08cd-46d4-993d-5d285769c31e\', \'multiverseId\': 134556}, \'multiverseid\': 134556}, {\'name\': \'Slivoïde pulmonique\', \'text\': \'Tous les slivoïdes ont le vol et « Si cette créature devait être mise dans un cimetière, vous pouvez la mettre au-dessus de la bibliothèque de son propriétaire à la place. »\', \'type\': \'Créature : slivoïde\', \'flavor\': \'Il souffle, tel un grand soufflet, et ses frères morts ou vifs sont soulevés loin du danger.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132750&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9748b454-cd77-4ae6-86b8-8cd3e2b4f050\', \'multiverseId\': 132750}, \'multiverseid\': 132750}, {\'name\': \'Tramutante Polmonare\', \'text\': \'Tutti i Tramutanti hanno volare e "Se questa creatura sta per essere messa in un cimitero, puoi invece metterla in cima al grimorio del suo proprietario."\', \'type\': \'Creatura — Tramutante\', \'flavor\': \'Soffia come un grosso mantice e i suoi simili, sia vivi che morti, sono sollevati al sicuro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133352&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'92fd9d61-3c86-477c-8c9f-1be715e012bf\', \'multiverseId\': 133352}, \'multiverseid\': 133352}, {\'name\': \'肺臓スリヴァー\', \'text\': \'すべてのスリヴァーは、飛行と「このクリーチャーが墓地に置かれる場合、あなたは代わりにそれをオーナーのライブラリーの一番上に置いてもよい。」の能力を持つ。\', \'type\': \'クリーチャー — スリヴァー\', \'flavor\': \'それは巨大なふいごのような声を上げ、その仲間は生きているものも死んでいるものも、安全な場所まで持ち上げられる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133653&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'53a152fb-b3cb-4dd7-86b7-0697debedd20\', \'multiverseId\': 133653}, \'multiverseid\': 133653}, {\'name\': \'Fractius Pulmonar\', \'text\': \'Todos os Fractius têm voar e "Se esta criatura seria colocada em um cemitério, em vez disso, você pode colocá-la no topo do grimório de seu dono."\', \'type\': \'Criatura — Fractius\', \'flavor\': \'Como uma grande fole ele assobia, e seus semelhantes, mortos ou vivos, são elevados para a segurança.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133954&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'01f7660c-b52c-42ec-b010-3dab55298822\', \'multiverseId\': 133954}, \'multiverseid\': 133954}, {\'name\': \'Пульмоническая Щепка\', \'text\': \'Все Щепки обладают Полетом и способностью "Если это существо должно попасть на кладбище, вы можете вместо этого положить его наверх библиотеки владельца."\', \'type\': \'Существо — Щепка\', \'flavor\': \'Подобно огромным кузнечным мехам, они раздуваются, и их родичи, и мертвые и живые, взлетают на безопасную высоту.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134255&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'68bf14e9-33df-4125-8c43-87d303718e39\', \'multiverseId\': 134255}, \'multiverseid\': 134255}, {\'name\': \'涨肺裂片妖\', \'text\': \'所有裂片妖具有飞行异能与「如果此生物将被置入坟墓场，你可以改为将它置于其拥有者的牌库顶。」\', \'type\': \'生物～裂片妖\', \'flavor\': \'他发出嘶声巨响，其同伴不论死活均与之一同飞往安全地带。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132449&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ee7a5b17-e313-4cf1-a3bd-4ffdbc9df921\', \'multiverseId\': 132449}, \'multiverseid\': 132449}]', '[{\'name\': \'Macht des alten Krosa\', \'text\': \'Eine Kreatur deiner Wahl erhält +2/+2 bis zum Ende des Zuges. Spielst du diesen Zauberspruch während deiner Hauptphase, erhält diese Kreatur stattdessen +4/+4 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'Manchmal werden selbst bescheidene Waldkreaturen von mächtiger Strahlung aus der Vergangenheit bedacht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133002&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'24a5fd0d-3f37-4387-9433-0033f41803ed\', \'multiverseId\': 133002}, \'multiverseid\': 133002}, {\'name\': \'Poder de la antigua Krosa\', \'text\': \'La criatura objetivo obtiene +2/+2 hasta el final del turno. Si jugaste este hechizo durante tu fase principal, en vez de eso, esa criatura obtiene +4/+4 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'A veces incluso las más humildes criaturas del bosque son bendecidas con poderosas emanaciones del pasado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134507&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a026653a-aa15-462a-96da-1ff7ee94516b\', \'multiverseId\': 134507}, \'multiverseid\': 134507}, {\'name\': "Puissance de l\'ancienne Krosia", \'text\': "La créature ciblée gagne +2/+2 jusqu\'à la fin du tour. Si vous avez joué ce sort pendant votre phase principale, cette créature gagne +4/+4 jusqu\'à la fin du tour à la place.", \'type\': \'Éphémère\', \'flavor\': \'Parfois, même les créatures forestières les plus humbles recevaient les puissantes émanations du passé.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132701&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8e8f346d-bfb2-4444-8735-ed0b69834a9a\', \'multiverseId\': 132701}, \'multiverseid\': 132701}, {\'name\': \'Potenza della Vecchia Krosa\', \'text\': \'Una creatura bersaglio prende +2/+2 fino alla fine del turno. Se hai giocato questa magia durante la tua fase principale, quella creatura prende invece +4/+4 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'Talvolta anche le umili creature silvane possedevano il dono di potenti emanazioni del passato.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133303&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d9d6cf28-eba2-466e-a30f-f685c2f3887c\', \'multiverseId\': 133303}, \'multiverseid\': 133303}, {\'name\': \'古きクローサの力\', \'text\': \'クリーチャー１体を対象とする。それはターン終了時まで＋２/＋２の修整を受ける。 あなたがこの呪文を自分のメイン・フェイズにプレイした場合、代わりにそれはターン終了時まで＋４/＋４の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'時には控えめな森の生き物ですら、過去からの強力な力を受けることがある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133604&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'42c45f84-dc9c-4e39-b969-11796a42c1eb\', \'multiverseId\': 133604}, \'multiverseid\': 133604}, {\'name\': \'Bravura da Antiga Krosa\', \'text\': \'A criatura alvo recebe +2/+2 até o final do turno. Se você jogou esta mágica durante sua fase principal, em vez disso, aquela criatura receberá +4/+4 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Algumas vezes, até mesmo humildes criaturas da floresta foram dotadas com poderosas emanações do passado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133905&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a7dcf170-93ae-4e0f-8ee9-24b09aa61bf5\', \'multiverseId\': 133905}, \'multiverseid\': 133905}, {\'name\': \'Мощь Старого Кроса\', \'text\': \'Целевое существо получает +2/+2 до конца хода. Если вы играете это заклинание в вашей основной фазе, это существо получает вместо этого +4/+4 до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Иногда даже самые скромные лесные жители могут получить дары мощных эманаций прошлого.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134206&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0776a20e-4230-4955-bdc2-6a062226b447\', \'multiverseId\': 134206}, \'multiverseid\': 134206}, {\'name\': \'古克洛萨之力\', \'text\': \'目标生物得+2/+2直到回合结束。 如果你在你的行动阶段使用此咒语，则改为该生物得+4/+4直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'有时就连卑微的树林生物都会蒙受过往放射之力。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132400&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'06574d6d-a821-4144-a1fc-c97b4905839e\', \'multiverseId\': 132400}, \'multiverseid\': 132400}]', '[{\'name\': \'Machtremasuri\', \'text\': \'Alle Remasuris erhalten +2/+2.\', \'type\': \'Kreatur — Remasuri\', \'flavor\': \'„Das riesige Geschöpf rumpelte über den Kamm und zerbrach dabei Bäume wie Streichhölzer. Diejenigen, gegen die wir bereits kämpften, bellten vor Freude, und als ihre Muskeln plötzlich anschwollen, wussten wir, dass es Zeit war, zu fliehen." —Llanach, Wolkenwaldläufer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133003&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5e8dc63f-c1c2-441c-9a6e-e1d6e2953c30\', \'multiverseId\': 133003}, \'multiverseid\': 133003}, {\'name\': \'Fragmentado del poder\', \'text\': \'Todos los Fragmentados obtienen +2/+2.\', \'type\': \'Criatura — Fragmentado\', \'flavor\': \'"El coloso retumbó sobre el cerro, y tres árboles resecos se hicieron polvo frente a él. Los que ya estábamos combatiendo aullaron al verlo, sus músculos se hincharon de repente, y supimos que era el momento de huir." —Llánach, explorador de Veloceleste\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134508&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'86c774c1-120e-4350-a0d6-efa498f95a03\', \'multiverseId\': 134508}, \'multiverseid\': 134508}, {\'name\': \'Slivoïde de puissance\', \'text\': \'Tous les slivoïdes gagnent +2/+2.\', \'type\': \'Créature : slivoïde\', \'flavor\': "« La chose colossale dégringola du contrefort, précédée de débris d\'arbres. Celles que nous combattions déjà hurlèrent, leurs muscles se développant soudain, et nous sûmes instantanément qu\'il fallait fuir » —Llanach, ranger de Linciel", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132702&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0c3ec00d-52c7-430a-8b5b-c9d6d60c641d\', \'multiverseId\': 132702}, \'multiverseid\': 132702}, {\'name\': \'Tramutante Possente\', \'text\': \'Tutti i Tramutanti prendono +2/+2.\', \'type\': \'Creatura — Tramutante\', \'flavor\': \'"Quella cosa gigantesca rotolò oltre il crinale, sgretolando i tronchi d\\\'albero davanti a sé. Quando sopraggiunse, quelli con cui stavamo già combattendo gridarono, i loro muscoli improvvisamente rinforzati, e capimmo che era il momento di fuggire." —Llanach, Ranger di Cielsudario\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133304&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d01dcb8b-9e9d-4f74-b908-ea825fda352e\', \'multiverseId\': 133304}, \'multiverseid\': 133304}, {\'name\': \'増力スリヴァー\', \'text\': \'すべてのスリヴァーは＋２/＋２の修整を受ける。\', \'type\': \'クリーチャー — スリヴァー\', \'flavor\': \'でっかいやつが、すごい勢い木の幹を吹き飛ばしながら尾根を越えてきたんだ。 俺たちが戦ってたやつは、そいつが来たとたん一声吼えたかと思ったら、突然筋肉がうねりだしたのさ。逃げたほうがいいと思ったね。 ――スカイシュラウドのレインジャー、ラナック\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133605&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3e324c19-03d2-4d7e-b17f-a2ae378fa241\', \'multiverseId\': 133605}, \'multiverseid\': 133605}, {\'name\': \'Fractius do Poder\', \'text\': \'Todos os Fractius recebem +2/+2.\', \'type\': \'Criatura — Fractius\', \'flavor\': \'"A coisa colossal retumbou pela cadeia de montanhas, as cascas das árvores esfarelaram-se perante ela. Os que já estavam lutando, uivaram quando ela chegou, seus músculos agitando-se repentinamente, e nós soubemos que era hora de escapar." —Llanach, patrulheiro de Skyshroud\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133906&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c2966040-c6f1-4608-b340-7a7c10afa92b\', \'multiverseId\': 133906}, \'multiverseid\': 133906}, {\'name\': \'Могучая Щепка\', \'text\': \'Все Щепки получают +2/+2.\', \'type\': \'Существо — Щепка\', \'flavor\': \'«Колосальное нечто грохотало по гряде, древесная кора осыпалась впереди него. Однажды мы уже были поражены его ревом, когда оно приползало, его мускулы внезапно всколыхнулись, и мы знали, что настало время бежать», Ланах, Скайшраудский егерь\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134207&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'829980b1-2117-44e4-b8b0-a6bb3c2e6f50\', \'multiverseId\': 134207}, \'multiverseid\': 134207}, {\'name\': \'瀚力裂片妖\', \'text\': \'所有裂片妖得+2/+2。\', \'type\': \'生物～裂片妖\', \'flavor\': \'「那庞然大物自山脊隆隆而过，树干应声而倒。 正与我们缠斗的家伙见状长嚎，身上隆起大块肌肉；我们知道该逃了。」 ～天帷护林兵拉纳可\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132401&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0c3d1a08-4707-48ad-9088-b5722ebda59f\', \'multiverseId\': 132401}, \'multiverseid\': 132401}]', '[{\'name\': \'Magus der Scheibe\', \'text\': \'Der Magus der Scheibe kommt getappt ins Spiel.\\n{1}, {T}: Zerstöre alle Artefakte, Kreaturen und Verzauberungen.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'Die Lektüre der Tagebücher des Necromagiers Nevinyrral hinterlässt in seinen Jüngern den Drang, seine drakonischen Strafmaßnahmen durchzuführen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132996&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'52d96a6e-4f66-4fac-aeb9-37acbb7b8e97\', \'multiverseId\': 132996}, \'multiverseid\': 132996}, {\'name\': \'Mago del disco\', \'text\': \'El Mago del disco entra en juego girado.\\n{1}, {T}: Destruye todos los artefactos, criaturas y encantamientos.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'Estudiar el diario del nigromante Nevinyrral deja a los discípulos llenos de la urgencia de ejercitar su juicio draconiano.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134501&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8395a7ff-4456-46d9-b195-fb5faa72bd9e\', \'multiverseId\': 134501}, \'multiverseid\': 134501}, {\'name\': \'Mage du Disque\', \'text\': \'Le mage du Disque arrive en jeu engagé.\\n{1}, {T} : Détruisez tous les artefacts, toutes les créatures et tous les enchantements.\', \'type\': \'Créature : humain et sorcier\', \'flavor\': "L\'étude des journaux du nécromage Nevinyrral laisse les disciples en proie à l\'envie irrésistible d\'exercer son jugement draconien.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132695&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c3e21f0d-d9fe-4966-b3de-4cf5255efe64\', \'multiverseId\': 132695}, \'multiverseid\': 132695}, {\'name\': \'Magus del Disco\', \'text\': \'Il Magus del Disco entra in gioco TAPpato.\\n{1}, {T}: Distruggi tutti gli artefatti, le creature e gli incantesimi.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': "Studiare i diari del necromagio Nevinyrral lascia i discepoli in preda all\'impulso di applicare la sua punizione draconiana.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133297&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'15eeefbc-abac-4711-83f0-f8d112be4a7c\', \'multiverseId\': 133297}, \'multiverseid\': 133297}, {\'name\': \'円盤の大魔術師\', \'text\': \'円盤の大魔術師はタップ状態で場に出る。\\n{1}, {T}：すべてのアーティファクトとクリーチャーとエンチャントを破壊する。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'屍道士ネビニラルの日誌を学ぶことで、信奉者達は彼の過酷な審判の実行に駆り立てられていく。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133598&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a5c1a1b4-ee57-42b6-b629-99a1f2242914\', \'multiverseId\': 133598}, \'multiverseid\': 133598}, {\'name\': \'Mago do Disco\', \'text\': \'Mago do Disco entra em jogo virado.\\n{1}, {T}: Destrua todos os artefatos, criaturas e encantamentos.\', \'type\': \'Criatura — Mago Humano\', \'flavor\': \'Estudar os diários do necromago Nevinyrral deixa seus discípulos ansiosos por exercitar seu julgamento draconiano.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133899&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bccc8c43-106f-4db6-b1b4-c4b66ec65c86\', \'multiverseId\': 133899}, \'multiverseid\': 133899}, {\'name\': \'Волхв Диска\', \'text\': \'Волхв Диска входит в игру повернутым.\\n{1}, {T}: Уничтожьте все артефакты, существа и чары.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'Штудируя некромантские журналы, Невинирал держал своих учеников в ежовых рукавицах, заставляя их упражняться своими драконовскими наказаниями.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134200&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c040f5f5-0926-4430-ba15-2c333717fd44\', \'multiverseId\': 134200}, \'multiverseid\': 134200}, {\'name\': \'崇碟贤者\', \'text\': \'崇碟贤者须横置进场。\\n{1}，{T}：消灭所有神器，生物，与结界。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'研读死冥法师妮维亚洛的日志后，其门徒满怀冲劲地实践其严酷裁决。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132394&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0bc93811-fb4a-4e64-bfd3-6bc59cdd291c\', \'multiverseId\': 132394}, \'multiverseid\': 132394}]', '[{\'name\': \'Magus der Schriftrolle\', \'text\': \'{3}, {T}: Benenne eine Karte. Zeige eine zufällig bestimmte Karte aus deiner Hand offen vor. Falls diese Karte die genannte Karte ist, fügt der Magus der Schriftrolle einer Kreatur oder einem Spieler deiner Wahl 2 Schadenspunkte zu.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132999&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bd45f26a-b7b3-4bcf-a1c9-2ad2553e4ac4\', \'multiverseId\': 132999}, \'multiverseid\': 132999}, {\'name\': \'Mago del pergamino\', \'text\': \'{3}, {T}: Nombra una carta. Muestra una carta al azar de tu mano. Si es la carta nombrada, el Mago del pergamino hace 2 puntos de daño a la criatura o jugador objetivo.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134504&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ea22888f-d82c-4b63-adf0-9a9f73dca474\', \'multiverseId\': 134504}, \'multiverseid\': 134504}, {\'name\': \'Mage du Parchemin\', \'text\': "{3}, {T} : Nommez une carte. Révélez au hasard une carte de votre main. Si c\'est la carte nommée, le Mage du Parchemin inflige 2 blessures à une cible, créature ou joueur.", \'type\': \'Créature : humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132698&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'48740fe5-e60c-44ec-a88f-b1718d08414d\', \'multiverseId\': 132698}, \'multiverseid\': 132698}, {\'name\': \'Magus della Pergamena\', \'text\': \'{3}, {T}: Nomina una carta. Rivela una carta a caso dalla tua mano Se è la carta nominata, il Magus della Pergamena infligge 2 danni a una creatura o a un giocatore bersaglio.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133300&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'68c29044-c081-4859-82d4-b9b35ac7adb4\', \'multiverseId\': 133300}, \'multiverseid\': 133300}, {\'name\': \'巻物の大魔術師\', \'text\': \'{3}, {T}：クリーチャー１体かプレイヤー１人を対象とする。カード名を１つ指定する。 あなたの手札にあるカードを無作為に１枚公開する。 そのカードが指定したカード名のカードである場合、巻物の大魔術師はそれに２点のダメージを与える。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133601&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b3e46537-a0cb-48c3-99a9-ab7d71b76372\', \'multiverseId\': 133601}, \'multiverseid\': 133601}, {\'name\': \'Mago do Pergaminho\', \'text\': \'{3}, {T}: Nomeie um card. Revele um card aleatoriamente da sua mão. Se for o card nomeado, Mago do Pergaminho causará 2 pontos de dano à criatura alvo ou ao jogador alvo.\', \'type\': \'Criatura — Mago Humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133902&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8cbfa850-f3cc-4fb6-8b9e-0f2f878363d8\', \'multiverseId\': 133902}, \'multiverseid\': 133902}, {\'name\': \'Волхв Свитка\', \'text\': \'{3}, {T}: Назовите карту. Покажите случайную карту из вашей руки. Если это названная карта, Волхв Свитка наносит 2 повреждения целевому существу или игроку.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134203&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'106e4c23-fa10-4a95-98b4-cb0a643a0d34\', \'multiverseId\': 134203}, \'multiverseid\': 134203}, {\'name\': \'卷轴贤者\', \'text\': \'{3}，{T}：说出一个牌名。 从你手上随机展示一张牌。 若名称相同，则卷轴贤者对目标生物或牌手造成2点伤害。\', \'type\': \'生物～人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132397&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0aee7294-92c6-46c7-a09e-05b20b919bd4\', \'multiverseId\': 132397}, \'multiverseid\': 132397}]', '[{\'name\': \'Magus des Kandelabers\', \'text\': \'{X}, {T}: Enttappe X Länder deiner Wahl.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'„Ich frage mich manchmal, was Urza wohl davon hielte, dass die Naturmagier immer noch knurren, wenn sein Name genannt wird, aber die Werke seines Lehrlings verehren?" —Teferi, zu Jhoira\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132995&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a3cc252e-9790-4ab9-a358-78cd42e16ae8\', \'multiverseId\': 132995}, \'multiverseid\': 132995}, {\'name\': \'Mago del candelabro\', \'text\': \'{X}, {T}: Endereza X tierras objetivo.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'"¿Qué pensaría Urza, me pregunto, si oyera cómo los magos de la naturaleza todavía maldicen su nombre pero veneran el trabajo de su aprendiz?" —Teferi, a Jhoira\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134500&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6fc01766-df40-470e-83ba-f12019273e7a\', \'multiverseId\': 134500}, \'multiverseid\': 134500}, {\'name\': \'Mage du Candélabre\', \'text\': \'{X}, {T} : Dégagez X terrains ciblés.\', \'type\': \'Créature : humain et sorcier\', \'flavor\': "« Je me demande ce que penserait Urza s\'il apprenait que les mages de la nature crachent à la mention de son nom, mais qu\'il vénèrent le travail de son apprenti ? » —Téfeiri, à Djoïra", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132694&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c21bbbdd-4fda-4568-b9b2-29f041cffb18\', \'multiverseId\': 132694}, \'multiverseid\': 132694}, {\'name\': \'Magus del Candelabro\', \'text\': \'{X}, {T}: STAPpa X terre bersaglio.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': \'"Cosa penserebbe Urza, mi chiedo, se sentisse come i maghi della natura ancora parlano con acredine di lui, ma venerano l\\\'opera del suo apprendista?" —Teferi, a Jhoira\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133296&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'35e43206-ace5-44c2-a5ed-b7ac7293d714\', \'multiverseId\': 133296}, \'multiverseid\': 133296}, {\'name\': \'燭台の大魔術師\', \'text\': \'{X}, {T}：土地をＸ個対象とし、それらをアンタップする。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'そこらの魔道士がウルザの名前に噛み付く一方で、その弟子の仕事には賞賛を送っていると知ったら、彼は何を思うのかしら。 ――テフェリーからジョイラへ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133597&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'35d1d175-8c98-418c-978e-e0491fca1872\', \'multiverseId\': 133597}, \'multiverseid\': 133597}, {\'name\': \'Mago do Candelabro\', \'text\': \'{X}, {T}: Desvire X terrenos alvo.\', \'type\': \'Criatura — Mago Humano\', \'flavor\': \'"O que Urza pensaria, imagino, se pudesse ouvir como os magos da natureza ainda desprezam seu nome, mas veneram o trabalho de seu aprendiz?" —Teferi, para Jhoira\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133898&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b57a6914-1d8c-428f-8baa-91dcb4a6918d\', \'multiverseId\': 133898}, \'multiverseid\': 133898}, {\'name\': \'Волхв Канделябры\', \'text\': \'{X}, {T}: Разверните X целевых земель.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'«Можно себе представить, что подумал бы Урза, если бы узнал, что маги природы все еще огрызаются на его имя, но чтят работу его последователей?» Тефери, к Джойре\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134199&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a4108dfc-e5a0-4a82-bdeb-8bec92e083d6\', \'multiverseId\': 134199}, \'multiverseid\': 134199}, {\'name\': \'烛台贤者\', \'text\': \'{X}，{T}：重置X个目标地。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'「自然法师依旧对克撒嗤之以鼻，却崇敬其学徒之造物。克撒若能见到这景象，不知心中有何感想？」 ～泰菲力致尤依拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132393&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d4fe8e13-69f6-4e9d-b618-d244a4ee441c\', \'multiverseId\': 132393}, \'multiverseid\': 132393}]', '[{\'name\': \'Magus des Krugs\', \'text\': \'{T}, opfere den Magus des Krugs: Alle Spieler entfernen alle Karten, die sie auf ihrer Hand haben, verdeckt ganz aus dem Spiel und ziehen sieben Karten. Am Ende des Zugs werfen alle Spieler alle Karten aus ihrer Hand ab und bringen alle Karten, die sie auf diese Weise ganz aus dem Spiel entfernt haben, auf ihre Hand zurück.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132997&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fdcb2c49-64ee-4894-8a9c-49f946181856\', \'multiverseId\': 132997}, \'multiverseid\': 132997}, {\'name\': \'Mago de la jarra\', \'text\': \'{T}, sacrificar el Mago de la jarra: Cada jugador remueve del juego su mano boca abajo y roba siete cartas. Al final del turno, cada jugador descarta su mano y regresa a su mano las cartas que removió del juego de esta manera.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134502&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bdd67214-4d4f-4675-a6dc-58bf4bb16b85\', \'multiverseId\': 134502}, \'multiverseid\': 134502}, {\'name\': \'Mage de la Jarre\', \'text\': "{T}, sacrifiez le Mage de la Jarre : Chaque joueur retire de la partie sa main, face cachée, et pioche sept cartes. À la fin du tour, chaque joueur se défausse de sa main et renvoie dans sa main chaque carte qu\'il a retirée de la partie de cette manière.", \'type\': \'Créature : humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132696&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7985a7a2-e22d-453d-a3d5-1598118f90d2\', \'multiverseId\': 132696}, \'multiverseid\': 132696}, {\'name\': \'Magus della Giara\', \'text\': \'{T}, Sacrifica il Magus della Giara: Ogni giocatore rimuove la propria mano dal gioco a faccia in giù e pesca sette carte. Alla fine del turno, ogni giocatore scarta la propria mano e riprende in mano ogni carta che ha rimosso dal gioco in questo modo.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133298&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bb5b1b25-97bc-4de1-9f18-61624be9974e\', \'multiverseId\': 133298}, \'multiverseid\': 133298}, {\'name\': \'壺の大魔術師\', \'text\': \'{T}, 壺の大魔術師を生け贄に捧げる：各プレイヤーは自分の手札をゲームから取り除き、カードを７枚引く。 ターン終了時に、各プレイヤーは自分の手札を捨て、これによりゲームから取り除かれた各カードを自分の手札に戻す。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133599&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e00e6ebd-b5c1-4917-a6da-1029a79caae4\', \'multiverseId\': 133599}, \'multiverseid\': 133599}, {\'name\': \'Mago do Jarro\', \'text\': \'{T}, Sacrifique Mago do Jarro: Cada jogador remove do jogo a própria mão com a face voltada para baixo e compra sete cards. No final do turno, cada jogador descarta a própria mão e devolve para a própria mão cada card removido do jogo deste modo.\', \'type\': \'Criatura — Mago Humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133900&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6db7e696-1687-4930-9ad5-03cc75d32029\', \'multiverseId\': 133900}, \'multiverseid\': 133900}, {\'name\': \'Волхв Кувшина\', \'text\': \'{T}, Пожертвуйте Волхва Кувшина: Каждый игрок убирает свою руку из игры лицом вниз и берет семь карт. В конце хода, каждый игрок сбрасывает свою и возвращает в свою руку все карты убранные этим путем.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134201&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6995e0b4-3265-4668-98ad-860a9317f57c\', \'multiverseId\': 134201}, \'multiverseid\': 134201}, {\'name\': \'崇瓶贤者\', \'text\': \'{T}，牺牲崇瓶贤者：每位牌手将其手牌面朝下地移出对战，并抓七张牌。 在回合结束时，每位牌手弃掉其手牌，并将他以此法移出对战的牌移回其手上。\', \'type\': \'生物～人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132395&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b59d12be-6874-4aca-90b6-2f26ad4367af\', \'multiverseId\': 132395}, \'multiverseid\': 132395}]', '[{\'name\': \'Magus des Spiegels\', \'text\': \'{T}, opfere den Magus des Spiegels: Tausche deinen Lebenspunktestand mit dem eines Gegners deiner Wahl. Spiele diese Fähigkeit nur während deines Versorgungssegments.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'„Obacht Im Spiegel die Feindin mit all ihrem Besitz. Vertraue deinem Neid, nimm es"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132998&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f764ab22-5131-4aa1-b82f-4010f798fec2\', \'multiverseId\': 132998}, \'multiverseid\': 132998}, {\'name\': \'Mago del espejo\', \'text\': \'{T}, sacrificar el Mago del espejo: Intercambia el total de vidas con el oponente objetivo. Juega esta habilidad sólo durante tu mantenimiento.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'"¡Observa La imagen del enemigo y todo lo que posee. Confía en tu envidia, y tómalo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134503&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'855ff2b0-8e95-4230-ae29-2d571316a179\', \'multiverseId\': 134503}, \'multiverseid\': 134503}, {\'name\': \'Mage du Miroir\', \'text\': "{T}, sacrifiez le Mage du Miroir : Échangez votre total de points de vie contre celui de l\'adversaire ciblé. Ne jouez cette capacité que pendant votre entretien.", \'type\': \'Créature : humain et sorcier\', \'flavor\': "« Admirez L\'image de l\'ennemi et de tout ce qu\'il a. Confiez-vous à votre envie, et prenez-le. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132697&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4ce9cd75-b940-4017-8875-70ae266d4386\', \'multiverseId\': 132697}, \'multiverseid\': 132697}, {\'name\': \'Magus dello Specchio\', \'text\': \'{T}, Sacrifica il Magus dello Specchio: Scambia i punti vita con un avversario bersaglio. Gioca questa abilità solo durante il tuo mantenimento.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': \'"Guarda L\\\'immagine del nemico e di tutto ciò che possiede. Fidati della tua invidia e prenditelo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133299&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'836a3897-c8b1-4505-bb23-84bf5de14468\', \'multiverseId\': 133299}, \'multiverseid\': 133299}, {\'name\': \'鏡の大魔術師\', \'text\': \'{T}, 鏡の大魔術師を生け贄に捧げる：対戦相手１人を対象とし、そのプレイヤーとライフの総量を交換する。 この能力は、あなたのアップキープの間にのみプレイできる。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'しかと見よ！ その敵の姿を、その持つすべてを。 己の妬みに身を任せ、それを奪うのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133600&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6ec0c543-c28a-41a6-8153-f6cec916141a\', \'multiverseId\': 133600}, \'multiverseid\': 133600}, {\'name\': \'Mago do Espelho\', \'text\': \'{T}, Sacrifique Mago do Espelho: Permute os totais de pontos de vida com o oponente alvo. Use esta habilidade somente durante sua manutenção.\', \'type\': \'Criatura — Mago Humano\', \'flavor\': \'"Observa A imagem do inimigo e tudo o que ela tem. Confie em sua inveja e tome-os."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133901&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'07452726-94fe-41ef-8070-98004c5218e3\', \'multiverseId\': 133901}, \'multiverseid\': 133901}, {\'name\': \'Волхв Зеркала\', \'text\': \'{T}, Пожертвуйте Волхва Зеркала: Обменяйтесь количествами жизни с целевым оппонентом. Играйте эту способность только в течение вашего шага поддержки.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'«Смотри Это образ врага и всего, что у него есть. Доверься своей зависти и возьми все».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134202&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d21823a3-40a5-46cb-bbe5-47a7e94a0614\', \'multiverseId\': 134202}, \'multiverseid\': 134202}, {\'name\': \'崇镜贤者\', \'text\': \'{T}，牺牲崇镜贤者：与目标对手交换总生命。 你只可以于你的维持中使用此异能。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'「看好了！ 这是敌人的样子，以及她拥有的东西。 依妒忌行事，全部接收下来吧。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132396&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'285db635-fcd6-4f65-b8dd-3d57156d0380\', \'multiverseId\': 132396}, \'multiverseid\': 132396}]', '[{\'name\': \'Manaabschöpfer\', \'text\': \'Fliegend\\nImmer wenn der Manaabschöpfer einem Spieler Schaden zufügt, tappe ein Land deiner Wahl, das dieser Spieler kontrolliert. Dieses Land enttappt während des nächsten Enttapp-Segments seines Beherrschers nicht.\', \'type\': \'Kreatur — Egel\', \'flavor\': \'Sie überqueren die manaleeren Einöden auf der Suche nach reicherem Land.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133000&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9464bd99-3834-4788-a3e2-739da3c0ea27\', \'multiverseId\': 133000}, \'multiverseid\': 133000}, {\'name\': \'Deslizador de maná\', \'text\': \'Vuela.\\nSiempre que el Deslizador de maná haga daño a un jugador, gira la tierra objetivo que controla ese jugador. Esa tierra no se endereza durante el próximo paso de enderezar de su controlador.\', \'type\': \'Criatura — Sanguijuela\', \'flavor\': \'Más móviles que las sanguijuelas de tierra, los deslizadores atraviesan yermos hambrientos de maná en busca de tierras más ricas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134505&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e49540eb-8501-4879-801e-023dc53b148e\', \'multiverseId\': 134505}, \'multiverseid\': 134505}, {\'name\': \'Écumeur de mana\', \'text\': "Vol\\nÀ chaque fois que l\'Écumeur de mana inflige des blessures à un joueur, engagez le terrain ciblé que ce joueur contrôle. Ce terrain ne se dégage pas pendant la prochaine étape de dégagement de son contrôleur.", \'type\': \'Créature : sangsue\', \'flavor\': \'Ils traversent les étendues vidées de leur mana à la recherche de terres plus fertiles.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132699&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'734fdbd2-bfba-463b-895f-a2ef160b7f66\', \'multiverseId\': 132699}, \'multiverseid\': 132699}, {\'name\': \'Schiumatrice di Mana\', \'text\': \'Volare\\nOgniqualvolta la Schiumatrice di Mana infligge danno a un giocatore, TAPpa una terra bersaglio controllata da quel giocatore. Quella terra non STAPpa durante il prossimo STAP del suo controllore.\', \'type\': \'Creatura — Sanguisuga\', \'flavor\': \'Attraversano lande desolate digiune di mana in cerca di terre più ricche.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133301&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1f1fad48-d626-45c3-a8ce-88da4e07a02c\', \'multiverseId\': 133301}, \'multiverseid\': 133301}, {\'name\': \'マナを間引くもの\', \'text\': \'飛行\\nマナを間引くものがいずれかのプレイヤーにダメージを与えるたび、そのプレイヤーがコントロールする土地１つを対象とし、それをタップする。 その土地は、それのコントローラーの次のアンタップ・ステップにアンタップしない。\', \'type\': \'クリーチャー — ヒル\', \'flavor\': \'それはマナの乏しい荒地からより豊かな地に向けて移動していく。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133602&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'101a1ecc-7e94-4aef-a7f9-01175b32cc2a\', \'multiverseId\': 133602}, \'multiverseid\': 133602}, {\'name\': \'Escumadeira de Mana\', \'text\': \'Voar\\nToda vez que Escumadeira de Mana causar dano a um jogador, vire o terreno alvo que aquele jogador controla. Ele não pode ser desvirado durante a próxima etapa de desvirar de seu controlador.\', \'type\': \'Criatura — Sanguessuga\', \'flavor\': \'Elas atravessam desertos escassos de mana em busca de terras mais ricas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133903&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f96e4e65-52c5-4ca3-ade0-08dad1406c4e\', \'multiverseId\': 133903}, \'multiverseid\': 133903}, {\'name\': \'Манарезка\', \'text\': \'Полет\\nКогда Манарезка наносит повреждения игроку, поверните целевую землю под контролем этого игрока. Эта земля не разворачивается на следующем шаге разворота контролируещего ее игрока.\', \'type\': \'Существо — Пиявка\', \'flavor\': \'Они пересекают безмановые болота в поисках богатых земель.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134204&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b01b7e1b-bd51-4c83-aa95-5f1c2b52f70e\', \'multiverseId\': 134204}, \'multiverseid\': 134204}, {\'name\': \'魔力飞掠者\', \'text\': \'飞行\\n每当魔力飞掠者对牌手造成伤害时，横置目标由该牌手操控的地。 该地于其操控者的下一个重置步骤中不能重置。\', \'type\': \'生物～蛭\', \'flavor\': \'他们横越法术力枯竭的荒野，寻觅丰沛大地。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132398&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'08c6c69b-80b7-4ec1-81f6-e38b88095eb3\', \'multiverseId\': 132398}, \'multiverseid\': 132398}]', '[{\'name\': \'Mangara von Corondor\', \'text\': \'{T}: Entferne Mangara von Corondor und eine bleibende Karte deiner Wahl ganz aus dem Spiel.\', \'type\': \'Legendäre Kreatur — Mensch, Zauberer\', \'flavor\': \'„Ich wurde an diesen Ort gebracht und kann ihn nicht verlassen. Ich bin dem Bernstein entkommen, doch trotzdem noch gefangen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133001&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ee2f83af-477b-429f-847d-900e2b9b3318\', \'multiverseId\': 133001}, \'multiverseid\': 133001}, {\'name\': \'Mangara de Córondor\', \'text\': \'{T}: Remueve del juego a Mangara de Córondor y el permanente objetivo.\', \'type\': \'Criatura legendaria — Hechicero humano\', \'flavor\': \'"Fui traído a este lugar y no puedo dejarlo. Puedo estar libre del ámbar, pero sigo en prisión."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134506&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cb742079-5e2b-4539-877a-7b41a3e4f514\', \'multiverseId\': 134506}, \'multiverseid\': 134506}, {\'name\': \'Mangara de Corondor\', \'text\': \'{T} : Retirez de la partie Mangara de Corondor et le permanent ciblé.\', \'type\': \'Créature légendaire : humain et sorcier\', \'flavor\': "« J\'ai été amené en ce lieu et je ne peux pas partir. Je suis peut-être libéré de l\'ambre, mais je suis encore en prison. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132700&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'840b6a0b-6b82-4a1d-b295-b98892f75dcc\', \'multiverseId\': 132700}, \'multiverseid\': 132700}, {\'name\': \'Mangara di Corondor\', \'text\': \'{T}: Rimuovi dal gioco la Mangara di Corondor e un permanente bersaglio.\', \'type\': \'Creatura Leggendaria — Mago Umano\', \'flavor\': \'"Sono stato portato in questo luogo e non posso andarmene. Anche se mi sono liberato dell\\\'ambra, sono ancora prigioniero."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133302&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'80db325d-bae5-4084-97ff-0b7c5eb168e9\', \'multiverseId\': 133302}, \'multiverseid\': 133302}, {\'name\': \'コロンドールのマンガラ\', \'text\': \'{T}：パーマネント１つを対象とし、コロンドールのマンガラとそれをゲームから取り除く。\', \'type\': \'伝説のクリーチャー — 人間・ウィザード\', \'flavor\': \'我はこの地に連れられ、去ることができぬ。 琥珀からは解き放たれたが、未だに牢獄の中のままだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133603&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9695ec77-e574-4076-9018-36a01a5a9b11\', \'multiverseId\': 133603}, \'multiverseid\': 133603}, {\'name\': \'Mangara de Corondor\', \'text\': \'{T}: Remova do jogo Mangara de Corondor e a permanente alvo.\', \'type\': \'Criatura Lendária — Mago Humano\', \'flavor\': \'"Fui trazido a este local e não posso deixá-lo. Posso estar livre do âmbar, mas ainda estou aprisionado."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133904&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'21e1889f-ef80-4fc2-adcb-8588ed2ba134\', \'multiverseId\': 133904}, \'multiverseid\': 133904}, {\'name\': \'Мангара из Корондора\', \'text\': \'{T}: Удалите Мангару из Корондона и целевой перманент из игры.\', \'type\': \'Легендарное Существо — Человек Чародей\', \'flavor\': \'«Я прибыл в это место и не покину его. Я могу быть свободен от янтаря, но я по-прежнему в тюрьме».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134205&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7e1cbd42-9936-4e50-bb82-786b2df73d8f\', \'multiverseId\': 134205}, \'multiverseid\': 134205}, {\'name\': \'寇朗多的曼格拉\', \'text\': \'{T}：将寇朗多的曼格拉与目标永久物移出对战。\', \'type\': \'传奇生物～人类／法术师\', \'flavor\': \'「我被带到此地，却无从离去。 我虽从琥珀中重获自由，但依旧身处牢笼。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132399&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6e11969f-4259-4a7a-8b30-44aedb6ea905\', \'multiverseId\': 132399}, \'multiverseid\': 132399}]', '[{\'name\': \'Mauer aus Ätherflammen\', \'text\': \'Verteidiger\\nDie Mauer aus Ätherflammen kann Kreaturen mit Irrealität blocken, als ob diese nicht Irrealität hätten.\\n{R}: Die Mauer aus Ätherflammen erhält +1/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mauer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132856&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9855f6a5-3fd1-4fb9-8779-f992e52b35ed\', \'multiverseId\': 132856}, \'multiverseid\': 132856}, {\'name\': \'Muro llama de éter\', \'text\': \'Defensor.\\nEl Muro llama de éter puede bloquear criaturas que se desvanecen como si no tuvieran la habilidad de desvanecerse.\\n{R}: El Muro llama de éter obtiene +1/+0 hasta el final del turno.\', \'type\': \'Criatura — Muro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134361&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7c010f67-8cdb-4f61-b0fb-0d1cf71e04ec\', \'multiverseId\': 134361}, \'multiverseid\': 134361}, {\'name\': \'Mur de flammes aethériques\', \'text\': "Défenseur\\nLe Mur de flammes aethériques peut bloquer les créatures avec la distorsion comme si elles n\'avaient pas la distorsion.\\n{R} : Le Mur de flammes aethériques gagne +1/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : mur\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132555&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7b0a0730-0cb1-4bd2-b241-3b2a8ad596dd\', \'multiverseId\': 132555}, \'multiverseid\': 132555}, {\'name\': \'Muro di Fiamma Eterea\', \'text\': \'Difensore\\nIl Muro di Fiamma Eterea può bloccare le creature con ombra come se non avessero ombra.\\n{R}: Il Muro di Fiamma Eterea prende +1/+0 fino alla fine del turno.\', \'type\': \'Creatura — Muro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133157&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d0949bae-3316-4c8e-a3b4-b34fd4c9c48c\', \'multiverseId\': 133157}, \'multiverseid\': 133157}, {\'name\': \'霊気炎の壁\', \'text\': \'防衛\\n霊気炎の壁はシャドーを持つクリーチャーを、それらがシャドーを持たないかのようにブロックできる。\\n{R}：霊気炎の壁はターン終了時まで＋１/＋０の修整を受ける。\', \'type\': \'クリーチャー — 壁\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133458&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'47400933-6393-4db1-b6f3-0be490aae0ca\', \'multiverseId\': 133458}, \'multiverseid\': 133458}, {\'name\': \'Barreira de Fogo Etéreo\', \'text\': \'Defensor\\nBarreira de Fogo Etéreo pode bloquear criaturas com sombra como se elas não tivessem sombra.{R}: Barreira de Fogo Etéreo recebe\\n +1/+0 até o final do turno.\', \'type\': \'Criatura — Barreira\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133759&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a54660a6-42f7-4ff4-bf96-19f6ac6f8a4b\', \'multiverseId\': 133759}, \'multiverseid\': 133759}, {\'name\': \'Стена Эфирного Огня\', \'text\': \'Защитник\\nСтена Эфирного Огня может блокировать существ с тенью, как будто они не имеют тени.\\n{R}: Стена Эфирного Огня получает +1/+0 до конца хода.\', \'type\': \'Существо — Стена\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134060&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e81042bb-df54-45d6-b93e-5de7bf9e39ed\', \'multiverseId\': 134060}, \'multiverseid\': 134060}, {\'name\': \'乙太焰墙\', \'text\': \'守军\\n对于具次元幽影异能的生物，乙太焰墙能将后者视同不具该异能地进行阻挡。\\n{R}：乙太焰墙得+1/+0直到回合结束。\', \'type\': \'生物～墙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132254&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e1407382-be5e-4d40-ac7d-2ce7a424e12a\', \'multiverseId\': 132254}, \'multiverseid\': 132254}]', '[{\'name\': \'Mechanische Hydra\', \'text\': \'Die Mechanische Hydra kommt mit vier +1/+1-Marken ins Spiel.\\nImmer wenn die Mechanische Hydra angreift oder blockt, entferne eine +1/+1-Marke von ihr. Falls du dies tust, fügt die Mechanische Hydra einer Kreatur oder einem Spieler deiner Wahl 1 Schadenspunkt zu.\\n{T}: Lege eine +1/+1-Marke auf die Mechanische Hydra.\', \'type\': \'Artefaktkreatur — Hydra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132891&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d15fd2fd-8113-41ae-be45-3e23933d2eb9\', \'multiverseId\': 132891}, \'multiverseid\': 132891}, {\'name\': \'Hidra mecánica\', \'text\': \'La Hidra mecánica entra en juego con cuatro contadores +1/+1 sobre ella.\\nSiempre que la Hidra mecánica ataque o bloquee, remueve un contador +1/+1 de ella. Si lo haces, la Hidra mecánica hace 1 punto de daño a la criatura o jugador objetivo.\\n{T}: Pon un contador +1/+1 sobre la Hidra mecánica.\', \'type\': \'Criatura artefacto — Hidra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134396&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9c064787-cfae-4f3d-84a0-e9aab6939b6f\', \'multiverseId\': 134396}, \'multiverseid\': 134396}, {\'name\': \'Hydre mécanique\', \'text\': "L\'Hydre mécanique arrive en jeu avec quatre marqueurs +1/+1 sur elle.\\nÀ chaque fois que l\'Hydre mécanique attaque ou bloque, retirez-lui un marqueur +1/+1. Si vous faites ainsi, l\'Hydre mécanique inflige 1 blessure à une cible, créature ou joueur.\\n{T} : Mettez un marqueur +1/+1 sur l\'Hydre mécanique.", \'type\': \'Créature-artefact : hydre\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132590&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8bcaa365-b325-4f42-87a3-a9dda593c857\', \'multiverseId\': 132590}, \'multiverseid\': 132590}, {\'name\': \'Idra Meccanica\', \'text\': "L\'Idra Meccanica entra in gioco con quattro segnalini +1/+1 su di essa.\\nOgniqualvolta l\'Idra Meccanica attacca o blocca, rimuovi un segnalino +1/+1 da essa. Se lo fai, l\'Idra Meccanica infligge 1 danno a una creatura o a un giocatore bersaglio.\\n{T}: Metti un segnalino +1/+1 sull\'Idra Meccanica.", \'type\': \'Creatura Artefatto — Idra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133192&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f92d246e-3e10-4004-b9e0-1f614f82792f\', \'multiverseId\': 133192}, \'multiverseid\': 133192}, {\'name\': \'機械仕掛けのハイドラ\', \'text\': \'機械仕掛けのハイドラは、４個の＋１/＋１カウンターが置かれた状態で場に出る。\\n機械仕掛けのハイドラが攻撃するかブロックするたび、クリーチャー１体かプレイヤー１人を対象とする。機械仕掛けのハイドラの上から＋１/＋１カウンターを１個取り除く。 そうした場合、機械仕掛けのハイドラはそれに１点のダメージを与える。\\n{T}：機械仕掛けのハイドラの上に＋１/＋１カウンターを１個置く。\', \'type\': \'アーティファクト・クリーチャー — ハイドラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133493&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2a372167-52c7-4c08-921c-438015de1cb4\', \'multiverseId\': 133493}, \'multiverseid\': 133493}, {\'name\': \'Hidra Mecânica\', \'text\': \'Hidra Mecânica entra em jogo com quatro marcadores +1/+1 sobre ela.\\nToda vez que Hidra Mecânica atacar ou bloquear, remova um marcador +1/+1 dela. Se o fizer, Hidra Mecânica causará 1 ponto de dano à criatura alvo ou ao jogador alvo.\\n{T}: Coloque um marcador +1/+1 sobre Hidra Mecânica.\', \'type\': \'Criatura Artefato — Hidra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133794&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'709451ca-d8f1-4739-bf35-a316df368d7f\', \'multiverseId\': 133794}, \'multiverseid\': 133794}, {\'name\': \'Заводная Гидра\', \'text\': \'Заводная Гидра входит в игру с четырьмя жетонами +1/+1 на ней.\\nКогда Заводная Гидра атакует или блокирует, снимите с нее один жетон +1/+1. Если вы это сделали, Заводная Гидра наносит 1 повреждение целевому существу или игроку.\\n{T}: Положите один +1/+1 жетон на Заводную Гидру.\', \'type\': \'Артефактное Существо — Гидра\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134095&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f8a6b2be-44d1-4f03-b744-630d8e280599\', \'multiverseId\': 134095}, \'multiverseid\': 134095}, {\'name\': \'发条多头龙\', \'text\': \'发条多头龙进场时上面有四个+1/+1指示物。\\n每当发条多头龙进行攻击或阻挡时，从上面移去一个+1/+1指示物。 若你如此作，则发条多头龙对目标生物或牌手造成1点伤害。\\n{T}：在发条多头龙上放置一个+1/+1指示物。\', \'type\': \'神器生物～多头龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132289&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b6379a54-6972-41d8-9572-17a71332b9de\', \'multiverseId\': 132289}, \'multiverseid\': 132289}]', '[{\'name\': \'Medaillon des Gestrigen\', \'text\': \'Zaubersprüche, die du spielst, kosten beim Ausspielen für jede Karte mit demselben Namen in deinem Friedhof {1} weniger.\', \'type\': \'Artefakt\', \'flavor\': \'Jede Stunde, wenn das Uhrglas umgedreht wurde, flüsterte die Besitzerin des Medaillons ihrem Schmuckstück Geheimnisse zu. Dies würde ihr Vermächtnis sein, ihre Erinnerungen, falls die Zeitrisse sie verschlingen würden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132992&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'be911777-51a1-4eba-9bb8-b61e4f2849ad\', \'multiverseId\': 132992}, \'multiverseid\': 132992}, {\'name\': \'Relicario del ayer\', \'text\': \'Te cuesta {1} menos jugar hechizos por cada carta con el mismo nombre que ese hechizo en tu cementerio.\', \'type\': \'Artefacto\', \'flavor\': \'Cada hora, al invertir el reloj, su dueño susurraba al relicario, alimentándole secretos. Esto sería su legado, su memoria, si las brechas lo llevaran.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134497&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'55232d91-6076-4adc-b66d-be72c3b1dcd1\', \'multiverseId\': 134497}, \'multiverseid\': 134497}, {\'name\': \'Médaillon des hiers envolés\', \'text\': \'Les sorts que vous jouez coûtent {1} de moins à jouer pour chaque carte dans votre cimetière ayant le même nom que ce sort.\', \'type\': \'Artefact\', \'flavor\': "Toutes les heures, au basculement du sablier, son propriétaire avait murmuré ses secrets au médaillon. Ce serait son legs, sa mémoire, si les failles l\'emportaient.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132691&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f701c2ca-2506-49d5-8141-43e8bd031b3d\', \'multiverseId\': 132691}, \'multiverseid\': 132691}, {\'name\': \'Medaglione del Passato\', \'text\': \'Le magie che giochi costano {1} in meno per ogni carta con lo stesso nome di quella magia nel tuo cimitero.\', \'type\': \'Artefatto\', \'flavor\': \'Ogni ora, quando girava la clessidra, la proprietaria aveva sussurrato al medaglione, riempiendolo di segreti. Questo sarebbe il suo retaggio, la sua memoria, se gli squarci dovessero farla sparire.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133293&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1f904c98-70ab-4f34-8070-0c9c4aedcecc\', \'multiverseId\': 133293}, \'multiverseid\': 133293}, {\'name\': \'昨日の首飾り\', \'text\': \'あなたが呪文をプレイするためのコストは、あなたの墓地にあるその呪文と同じカード名のカード１枚につき{1}少なくなる。\', \'type\': \'アーティファクト\', \'flavor\': \'毎時、時刻が移り変わるたびに、持ち主は首飾りに秘密を囁き、しまいこんでいった。 裂け目が彼女を引きずり込んでいくなら、これは彼女の形見となり、彼女の記憶となるのだろう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133594&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9e8cc403-26c8-446a-8c20-3b4719158db8\', \'multiverseId\': 133594}, \'multiverseid\': 133594}, {\'name\': \'Medalhão de Outrora\', \'text\': \'As mágicas que você joga custam {1} a menos para serem jogadas para cada card com o mesmo nome daquela mágica no seu cemitério.\', \'type\': \'Artefato\', \'flavor\': \'A cada hora, abrindo o vidro, sua dona sussurrava ao medalhão, semeando-o com segredos. Este seria seu legado, sua memória, se as fendas a levassem.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133895&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'12524118-bed7-486e-92a0-cddee4088557\', \'multiverseId\': 133895}, \'multiverseid\': 133895}, {\'name\': \'Медальон Прошлого\', \'text\': \'Заклинания, которые вы играете, стоят на {1} меньше за каждую карту с таким же названием, находящуюся на вашем кладбище.\', \'type\': \'Артефакт\', \'flavor\': \'С каждым поворотом песочных часов их владелица что-то шептала медальону, наполняя его секретами. Это должно было стать ее наследием, ее памятью, если разлом все-таки настигнет ее.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134196&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'62b77f2c-7fba-4ffa-9325-0438d94c5e97\', \'multiverseId\': 134196}, \'multiverseid\': 134196}, {\'name\': \'昨日坠饰\', \'text\': \'对你使用的咒语而言，你的坟墓场中每有一张与该咒语同名的牌，其费用便减少{1}来使用。\', \'type\': \'神器\', \'flavor\': \'沙漏每翻转一回，其主人便向坠饰低语，将秘密埋藏其间。 若时缝将她带走，这将会是她的遗物与回忆。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132390&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b90c7d80-de9a-4235-afe3-eb38d4271813\', \'multiverseId\': 132390}, \'multiverseid\': 132390}]', '[{\'name\': \'Meister der Reiterei\', \'text\': \'Flankenangriff (Immer wenn eine Kreatur ohne Flankenangriff diese Kreatur blockt, erhält die blockende Kreatur -1/-1 bis zum Ende des Zuges.)\\nAndere Kreaturen mit Flankenangriff, die du kontrollierst, haben Flankenangriff. (Jedes Vorkommen von Flankenangriff wird unabhängig ausgelöst.)\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132883&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'34c9bfa7-0e5d-48ef-8c80-edbd7a2bbaac\', \'multiverseId\': 132883}, \'multiverseid\': 132883}, {\'name\': \'Maestro de caballería\', \'text\': \'Flanquea (Siempre que una criatura sin la habilidad de flanquear bloquee a esta criatura, la criatura bloqueadora obtiene -1/-1 hasta el final del turno.)\\nLas otras criaturas que controlas con la habilidad de flanquear tienen la habilidad de flanquear. (Cada copia de la habilidad de flanquear se dispara por separado.)\', \'type\': \'Criatura — Caballero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134388&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6a27bc70-fa6f-4a26-b318-879589912f83\', \'multiverseId\': 134388}, \'multiverseid\': 134388}, {\'name\': \'Maître de cavalerie\', \'text\': "Débordement (À chaque fois qu\'une créature sans le débordement bloque cette créature, la créature bloqueuse gagne -1/-1 jusqu\'à la fin du tour.)\\nLes autres créatures avec le débordement que vous contrôlez ont le débordement. (Chaque occurrence de débordement se déclenche séparément.)", \'type\': \'Créature : humain et chevalier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132582&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'12cf96bb-17c7-4eab-8898-30423a9599b2\', \'multiverseId\': 132582}, \'multiverseid\': 132582}, {\'name\': \'Capitano di Cavalleria\', \'text\': \'Aggirare (Ogniqualvolta una creatura senza aggirare blocca questa creatura, la creatura bloccante prende -1/-1 fino alla fine del turno.)\\nLe altre creature che controlli con aggirare hanno aggirare. (Ogni istanza di aggirare si innesca separatamente.)\', \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133184&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'170b7f8c-44f9-4167-b4f8-7a8c2aaa9471\', \'multiverseId\': 133184}, \'multiverseid\': 133184}, {\'name\': \'騎兵戦の達人\', \'text\': \'側面攻撃 （側面攻撃を持たないいずれかのクリーチャーがこのクリーチャーをブロックするたび、そのブロックしているクリーチャーはターン終了時まで－１/－１の修整を受ける。）\\nあなたがコントロールする他の側面攻撃を持つクリーチャーは側面攻撃を持つ。 （重複した各側面攻撃はそれぞれ誘発する。）\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133485&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d4a677d8-202c-4c99-988a-7f7516472768\', \'multiverseId\': 133485}, \'multiverseid\': 133485}, {\'name\': \'Mestre da Cavalaria\', \'text\': \'Flanquear (Toda vez que uma criatura sem flanquear bloquear esta criatura, a criatura bloqueadora receberá -1/-1 até o final do turno.)\\nAs outras criaturas que você controla com flanquear têm flanquear. (Cada ocorrência de flanquear é desencadeada separadamente.)\', \'type\': \'Criatura — Cavaleiro Humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133786&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f7ced7b8-4543-4330-9a63-a4036034fb19\', \'multiverseId\': 133786}, \'multiverseid\': 133786}, {\'name\': \'Мастер Кавалерии\', \'text\': \'Обход (Когда существо без обхода блокирует это существо, тогда это блокирующее существо получает -1/-1 до конца хода.)\\nДругие существа под вашим контролем с обходом получают обход. (Каждый экземпляр обхода срабатывает отдельно.)\', \'type\': \'Существо — Человек Рыцарь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134087&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'38eeb41d-7e71-41d9-a603-d9b420cb19ee\', \'multiverseId\': 134087}, \'multiverseid\': 134087}, {\'name\': \'骑兵领袖\', \'text\': \'侧面攻击（每当一个不具侧面攻击之生物阻挡此生物时，该阻挡生物得-1/-1直到回合结束。）\\n由你操控、且具侧面攻击异能的其它生物都具有侧面攻击异能。 （每个侧面攻击都会个别触发。）\', \'type\': \'生物～人类／骑士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132281&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b8010268-970d-4a75-8e5b-7ba436b1d32f\', \'multiverseId\': 132281}, \'multiverseid\': 132281}]', '[{\'name\': \'Messingmücke\', \'text\': \'Fliegend\\nDie Messingmücke enttappt nicht während deines Enttappsegments.\\nZu Beginn deines Versorgungssegments kannst du {1} bezahlen. Falls du dies tust, enttappe die Messingmücke.\', \'type\': \'Artefaktkreatur — Insekt\', \'flavor\': \'Ihr Gesumme stammt aus dem Mechanismus in ihrem Inneren, der langsam heruntertickt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132875&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d240b02d-f6f2-47c2-aa34-d19e003629b6\', \'multiverseId\': 132875}, \'multiverseid\': 132875}, {\'name\': \'Mosquito de latón\', \'text\': \'Vuela.\\nEl Mosquito de latón no endereza durante tu paso de enderezar.\\nAl comienzo de tu mantenimiento, puedes pagar {1}. Si lo haces, endereza el Mosquito de latón.\', \'type\': \'Criatura artefacto — Insecto\', \'flavor\': \'Su zumbido es el sonido de sus mecanismos internos, que no se apagan nunca.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134380&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bdd18879-8a34-499b-8802-dbbc262edf41\', \'multiverseId\': 134380}, \'multiverseid\': 134380}, {\'name\': "Moucheron d\'airain", \'text\': "Vol\\nLe Moucheron d\'airain ne se dégage pas pendant votre étape de dégagement.\\nAu début de votre entretien, vous pouvez payer {1}. Si vous faites ainsi, dégagez le Moucheron d\'airain.", \'type\': \'Créature-artefact : insecte\', \'flavor\': \'Son bourdonnement provient des remontoirs de ses mécanismes internes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132574&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'75035f6c-5b5f-4dc1-bb08-2a49e59079f1\', \'multiverseId\': 132574}, \'multiverseid\': 132574}, {\'name\': "Moscerino d\'Ottone", \'text\': "Volare\\nIl Moscerino D\'Ottone non STAPpa durante il tuo STAP.\\nAll\'inizio del tuo mantenimento, puoi pagare {1}. Se lo fai, STAPpa il Moscerino d\'Ottone.", \'type\': \'Creatura Artefatto — Insetto\', \'flavor\': \'Il suo ronzio è il rumore dei meccanismi interni che continuano a scaricarsi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133176&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'09686e65-73ed-46c2-8837-4ab16f0c8920\', \'multiverseId\': 133176}, \'multiverseid\': 133176}, {\'name\': \'真鍮の虻\', \'text\': \'飛行\\n真鍮の虻はあなたのアンタップ・ステップにアンタップしない。\\nあなたのアップキープの開始時に、あなたは{1}を支払ってもよい。 そうした場合、真鍮の虻をアンタップする。\', \'type\': \'アーティファクト・クリーチャー — 昆虫\', \'flavor\': \'その羽音は、中の機械が緩んでいく音だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133477&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f1991a7d-0b98-4ce9-9e1a-b0edea3493f0\', \'multiverseId\': 133477}, \'multiverseid\': 133477}, {\'name\': \'Mosquito de Bronze\', \'text\': \'Voar\\nMosquito de Bronze não desvira durante sua etapa de desvirar.\\nNo início de sua manutenção, você pode pagar {1}. Se fizer isso, desvire Mosquito de Bronze.\', \'type\': \'Criatura Artefato — Inseto\', \'flavor\': \'Seu zunido é o som de seus mecanismos internos, sempre reduzindo-se gradativamente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133778&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'906c57ca-efe3-4a95-b842-f23c98cf699f\', \'multiverseId\': 133778}, \'multiverseid\': 133778}, {\'name\': \'Латунный Москит\', \'text\': \'Полет\\nЛатунный Москит не разворачивается во время вашего шага разворота.\\nВ начале вашего шага поддержки вы можете заплатить {1}. Если вы это делаете, разверните Латунного Москита.\', \'type\': \'Артефактное Существо — Насекомое\', \'flavor\': \'Его жужжание - это звук внутренних механизмов, даже при падении.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134079&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e946fa32-8801-494f-91de-8963945ec303\', \'multiverseId\': 134079}, \'multiverseid\': 134079}, {\'name\': \'黄铜蚋虫\', \'text\': \'飞行\\n黄铜蚋虫于你的重置步骤中不能重置。\\n在你的维持开始时，你可以支付{1}。 若你如此作，则重置黄铜蚋虫。\', \'type\': \'神器生物～昆虫\', \'flavor\': \'其嗡响来自内部松垮的机械构造。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132273&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a25f62ce-5df2-45ab-b759-a061fdfa89e2\', \'multiverseId\': 132273}, \'multiverseid\': 132273}]', '[{\'name\': \'Meucheln\', \'text\': \'Zerstöre eine getappte Kreatur deiner Wahl.\', \'type\': \'Hexerei\', \'flavor\': \'Die Herrscher des alten Dominaria hatten immer Meuchler in der Hinterhand. Doch die Meistermeuchler kannten nur gegenüber ihresgleichen Loyalität. So überlebte ihre Brüderschaft den Niedergang der alten Monarchien.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132864&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'29f57d24-4d30-4713-870c-a19497638dca\', \'multiverseId\': 132864}, \'multiverseid\': 132864}, {\'name\': \'Asesinar\', \'text\': \'Destruye la criatura objetivo girada.\', \'type\': \'Conjuro\', \'flavor\': \'Los gobernantes de la antigua Dominaria mantenían asesinos como servidores. Sin embargo, la verdadera lealtad de estos maestros asesinos siempre estaba con sus pares. Esta hermandad de élite sobrevivió la caída de la vieja orden real.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134369&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5b8d6ae5-6aaf-4b89-b574-9a9b1c0dd153\', \'multiverseId\': 134369}, \'multiverseid\': 134369}, {\'name\': \'Meurtre\', \'text\': \'Détruisez la créature engagée ciblée.\', \'type\': \'Rituel\', \'flavor\': "Les dirigeants de l\'ancienne Dominaria avaient leurs assassins privés. Mais ces maîtres tueurs n\'étaient loyaux qu\'envers leurs pairs. Cette confrérie d\'élite survécut à la chute de la vieille monarchie.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132563&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f28d0bae-5cd6-435b-8d44-f9fafb5933bd\', \'multiverseId\': 132563}, \'multiverseid\': 132563}, {\'name\': \'Assassinare\', \'text\': \'Distruggi una creatura TAPpata bersaglio.\', \'type\': \'Stregoneria\', \'flavor\': "I regnanti dell\'antica Dominaria erano soliti ingaggiare assassini. Tuttavia, la vera lealtà di questi maestri dell\'omicidio fu sempre per i loro pari. Questa fratellanza d\'élite sopravvisse alla caduta del vecchio ordinamento reale.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133165&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1611b7e1-fc77-43b2-a239-a38930cf0afc\', \'multiverseId\': 133165}, \'multiverseid\': 133165}, {\'name\': \'暗殺\', \'text\': \'タップ状態のクリーチャー１体を対象とし、それを破壊する。\', \'type\': \'ソーサリー\', \'flavor\': \'かつてのドミナリアの君主は、ずっと暗殺者を雇っていた。 しかし、彼ら殺人に長けた者達の真の忠誠は、常に彼らの仲間に捧げられていた。 この同僚意識は、かつての王室の法が崩れた後でも生き残っている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133466&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'21f63d85-3480-4c7b-9bdb-aace8e9b2c06\', \'multiverseId\': 133466}, \'multiverseid\': 133466}, {\'name\': \'Assassinar\', \'text\': \'Destrua a criatura alvo virada.\', \'type\': \'Feitiço\', \'flavor\': \'Os soberanos da antiga Dominária mantinham assassinos como prestadores de serviços. Entretanto, a verdadeira lealdade desses assassinos especializados era voltada apenas aos seus colegas. Essa irmandade de elite sobreviveu à queda da antiga ordem real.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133767&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a73f176f-724f-4fd7-90a6-01bc85039764\', \'multiverseId\': 133767}, \'multiverseid\': 133767}, {\'name\': \'Предательское убийство\', \'text\': \'Уничтожьте целевое повернутое существо.\', \'type\': \'Волшебство\', \'flavor\': \'Правители древней Доминарии держали убийц на довольствии. Но истинная лояльность этих мастеров-убийц всегда была их собственной привелегией. Это элитное братство пережило падение старого королевского порядка.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134068&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9440ba8d-e88f-450a-aff2-9b3c27b6a23c\', \'multiverseId\': 134068}, \'multiverseid\': 134068}, {\'name\': \'行刺\', \'text\': \'消灭目标已横置的生物。\', \'type\': \'法术\', \'flavor\': \'在过去的多明纳里亚，各地统治者都会聘雇刺客。 不过，这些顶级杀手只对自己的同路人完全效忠。 即使旧王朝覆亡，这精英团体依旧安然无恙。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132262&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dd2ac22c-91f6-4fab-aae9-85ccc4c06538\', \'multiverseId\': 132262}, \'multiverseid\': 132262}]', '[{\'name\': \'Mishra, Handwerker-Wunderkind\', \'text\': \'Immer wenn du einen Artefaktzauber spielst, kannst du deinen Friedhof, deine Hand und/oder deine Bibliothek nach einer Karte mit demselben Namen wie dieser Zauber durchsuchen und ins Spiel bringen. Falls du auf diese Weise deine Bibliothek durchsucht hast, mische sie.\', \'type\': \'Legendäre Kreatur — Mensch, Handwerker\', \'flavor\': \'Eine Zeitreise sorgte dafür, dass ein begabtes junges Gehirn auf dunkle Gedanken kam.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133006&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9eb2aa8e-2cd7-4adc-9a79-4746df8c9c7c\', \'multiverseId\': 133006}, \'multiverseid\': 133006}, {\'name\': \'Mishra, artífice prodigio\', \'text\': \'Siempre que juegues un hechizo de artefacto, puedes buscar en tu cementerio, mano y/o biblioteca una carta con el mismo nombre que ese hechizo y ponerla en juego. Si buscas en tu biblioteca de esta manera, barájala.\', \'type\': \'Criatura legendaria — Artífice humano\', \'flavor\': \'Un pequeño viaje por el tiempo dio una inspiración oscura a una joven mente dotada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134511&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1c9a9c34-1272-4e33-ba60-c8c7473147a3\', \'multiverseId\': 134511}, \'multiverseid\': 134511}, {\'name\': \'Mishra, prodige artificier\', \'text\': "À chaque fois que vous jouez un sort d\'artefact, vous pouvez chercher dans votre cimetière, votre main et/ou votre bibliothèque une carte ayant le même nom que ce sort et la mettre en jeu. Si vous avez cherché dans votre bibliothèque de cette manière, mélangez-la.", \'type\': \'Créature légendaire : humain et artificier\', \'flavor\': \'Voyager dans le temps donna une sombre inspiration à un jeune génie talentueux.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132705&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'68abf90a-3d00-4abc-8585-f0c5fb3b39fe\', \'multiverseId\': 132705}, \'multiverseid\': 132705}, {\'name\': \'Mishra, Artefice Prodigio\', \'text\': \'Ogniqualvolta giochi una magia artefatto, puoi passare in rassegna il tuo cimitero, la tua mano e/o il tuo grimorio per una carta con lo stesso nome di quella magia e metterla in gioco. Se passi in rassegna il tuo grimorio in questo modo, rimescolalo.\', \'type\': \'Creatura Leggendaria — Artefice Umano\', \'flavor\': "Un soggiorno attraverso il tempo ha fornito un\'oscura ispirazione a una giovane mente dotata.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133307&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1eff7cde-e425-41a6-9532-6464faf3cae6\', \'multiverseId\': 133307}, \'multiverseid\': 133307}, {\'name\': \'工匠の神童、ミシュラ\', \'text\': \'あなたがアーティファクト呪文をプレイするたび、あなたは自分の墓地や手札やライブラリーからその呪文と同じカード名のカードを１枚探し、それを場に出す。 あなたがこれにより自分のライブラリーからカードを探した場合、それを切り直す。\', \'type\': \'伝説のクリーチャー — 人間・工匠\', \'flavor\': \'時間の中を漂うことで、才能ある若者の心に邪悪なひらめきが生まれた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133608&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'aaa86637-0829-416f-9f90-90c3b00470de\', \'multiverseId\': 133608}, \'multiverseid\': 133608}, {\'name\': \'Mishra, Prodígio Artífice\', \'text\': \'Toda vez que você joga uma mágica de artefato, você pode procurar em seu cemitério, mão e/ou grimório por um card com o mesmo nome daquela mágica e colocá-lo em jogo. Se procurar em seu grimório desta maneira, embaralhe-o.\', \'type\': \'Criatura Lendária — Artesão Humano\', \'flavor\': \'Uma residência provisória através do tempo deu uma inspiração sombria a uma jovem mente talentosa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133909&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'95932b35-ac24-4167-9f27-28ccdf797bc8\', \'multiverseId\': 133909}, \'multiverseid\': 133909}, {\'name\': \'Мишра, Гениальный Механик\', \'text\': \'Когда вы играете артефактное заклинание, вы можете найти на вашем кладбище, в руке и/или библиотеке карту с таким же названием, что и разыгрываемое заклинание, и положить ее в игру. После поиска карты перетасуйте библиотеку.\', \'type\': \'Легендарное Существо — Человек Механик\', \'flavor\': \'Непродолжительное пребывание во времени принесло темное вдохновение одному одаренному юному уму.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134210&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'767b6449-d696-4e83-9ab7-e31002cc17c4\', \'multiverseId\': 134210}, \'multiverseid\': 134210}, {\'name\': \'神器师逸才米斯拉\', \'text\': \'每当你使用神器咒语时，你可以从你的坟墓场，手牌和／或牌库中搜寻一张与该咒语同名的牌，并将它放置进场。 如果你以此法搜寻你的牌库，则将它洗牌。\', \'type\': \'传奇生物～人类／神器师\', \'flavor\': \'一段跨越时间的旅程，替聪颖的年轻心智激起黑暗灵感。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132404&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f843260c-8000-4496-8280-93b87fa472a9\', \'multiverseId\': 132404}, \'multiverseid\': 132404}]', "[{'name': 'Missionieren', 'text': 'Rückkauf {2}{W}{W} (Du kannst zusätzlich {2}{W}{W} bezahlen, sowie du diesen Zauberspruch spielst. Falls du dies tust, nimm diese Karte auf deine Hand, sowie sie verrechnet wird.)\\nÜbernimm die Kontrolle über eine Kreatur der Wahl eines Gegners, die er kontrolliert.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132923&type=card', 'language': 'German', 'identifiers': {'scryfallId': '968be828-427b-4a02-80f4-d01a0a942a05', 'multiverseId': 132923}, 'multiverseid': 132923}, {'name': 'Evangelizar', 'text': 'Recuperar {2}{W}{W} (Puedes pagar {2}{W}{W} adicionales en cuanto juegues este hechizo. Si lo haces, pon esta carta en tu mano en cuanto se resuelve.)\\nGana el control de la criatura objetivo que elija y controle un oponente.', 'type': 'Conjuro', 'flavor': 'Desplazada mil años de su hogar, sus noticias de la guerra han perdido su contexto, pero no su relevancia.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134428&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '33bd39ed-9cb4-4fa2-846c-8f80576fec4f', 'multiverseId': 134428}, 'multiverseid': 134428}, {'name': 'Évangélisation', 'text': 'Rappel {2}{W}{W} (Vous pouvez payer {2}{W}{W} supplémentaires au moment où vous jouez ce sort. Si vous faites ainsi, mettez cette carte dans votre main au moment où elle se résout.)\\nAcquérez le contrôle de la créature ciblée choisie par un adversaire qui la contrôle.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132622&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a206af1d-964f-441e-ba87-63daf465dda1', 'multiverseId': 132622}, 'multiverseid': 132622}, {'name': 'Evangelizzare', 'text': 'Riscatto {2}{W}{W} (Puoi pagare {2}{W}{W} addizionale mentre giochi questa magia. Se lo fai, riprendi in mano questa carta quando si risolve.)\\nPrendi il controllo di una creatura bersaglio scelta da un avversario che la controlla.', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133224&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ba59688f-6fbb-47fc-8358-ca97d3c5b92f', 'multiverseId': 133224}, 'multiverseid': 133224}, {'name': '福音', 'text': 'バイバック {2}{W}{W} （あなたはこの呪文をプレイするに際し、追加で{2}{W}{W}を支払ってもよい。 そうした場合、それの解決に際し、このカードをあなたの手札に加える。）\\nいずれかの対戦相手が選んだ、そのプレイヤーがコントロールするクリーチャー１体を対象とし、それのコントロールを得る。', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133525&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'a7a4bfed-8a03-406c-b70e-36939e505a1a', 'multiverseId': 133525}, 'multiverseid': 133525}, {'name': 'Evangelizar', 'text': 'Recuperar {2}{W}{W} (Você pode pagar um custo adicional de {2}{W}{W} ao jogar esta mágica. Se fizer isso, coloque este card em sua mão quando for resolvido.)\\nGanhe o controle da criatura alvo à escolha de um oponente e que seja controlada por ele.', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133826&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5b335e18-8ea7-460c-94ff-8906d2bcfc22', 'multiverseId': 133826}, 'multiverseid': 133826}, {'name': 'Проповедь Евангелия', 'text': 'Выкуп {2}{W}{W} (Вы можете заплатить дополнительно {2}{W}{W} при игре этого заклинания. Если вы делаете это, положите эту карту в вашу руку, когда она разрешится.)\\nВы получаете контроль над целевым существом по выбору оппонента, которое находится под его или ее контролем.', 'type': 'Волшебство', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134127&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '678e106e-40a7-4436-9e5c-c57789d16528', 'multiverseId': 134127}, 'multiverseid': 134127}, {'name': '传扬福音', 'text': '购回{2}{W}{W}（你使用此咒语时可以额外支付{2}{W}{W}。 若你如此做，则结算此咒语时将它放入你的手牌。）\\n获得由对手选择、且由其操控的目标生物之操控权。', 'type': '法术', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132321&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '61b4b7f3-8b56-4fce-a4a9-848162f6cd2d', 'multiverseId': 132321}, 'multiverseid': 132321}]", '[{\'name\': \'Mogg-Kriegsmarschall\', \'text\': \'Echo {1}{R} (Opfere zu Beginn deines Versorgungssegments diese bleibende Karte, falls sie seit deinem letzten Versorgungssegment unter deine Kontrolle gekommen ist, falls du nicht ihre Echokosten bezahlst.)\\nWenn der Mogg-Kriegsmarschall ins Spiel kommt oder aus dem Spiel auf einen Friedhof gelegt wird, bringe einen 1/1 roten Goblinspielstein ins Spiel.\', \'type\': \'Kreatur — Goblin, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133007&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b8bb7e7d-c0b1-457e-b88b-8e6101108ff9\', \'multiverseId\': 133007}, \'multiverseid\': 133007}, {\'name\': \'Mariscal de guerra mogg\', \'text\': \'Eco {1}{R} (Al comienzo de tu mantenimiento, si esto entró bajo tu control desde el comienzo de tu último mantenimiento, sacrifícalo a menos que pagues su coste de eco.)\\nCuando el Mariscal de guerra mogg entre en juego o vaya a un cementerio desde el juego, pon en juego una ficha de criatura Trasgo roja 1/1.\', \'type\': \'Criatura — Guerrero trasgo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134512&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6f835c5d-09fd-47d5-8263-e97795e0aded\', \'multiverseId\': 134512}, \'multiverseid\': 134512}, {\'name\': \'Maréchal de guerre mogg\', \'text\': "Écho {1}{R} (Au début de votre entretien, si ce permanent est passé sous votre contrôle depuis le début de votre dernier entretien, sacrifiez-le à moins que vous ne payiez son coût d\'écho.)\\nQuand le Maréchal de guerre mogg arrive en jeu ou qu\'il est mis dans un cimetière depuis le jeu, mettez en jeu un jeton de créature 1/1 rouge Gobelin.", \'type\': \'Créature : gobelin et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132706&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'409bd43f-3971-490b-8d37-a86a1357a878\', \'multiverseId\': 132706}, \'multiverseid\': 132706}, {\'name\': \'Mogg Maresciallo di Guerra\', \'text\': "Eco {1}{R} (All\'inizio del tuo mantenimento, se questo permanente è entrato sotto il tuo controllo dall\'inizio del tuo ultimo mantenimento, sacrificalo a meno che non paghi il suo costo di eco.)\\nQuando il Mogg Maresciallo di Guerra entra in gioco o viene messo in un cimitero dal gioco, metti in gioco una pedina creatura Goblin 1/1 rossa.", \'type\': \'Creatura — Guerriero Goblin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133308&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'846551b1-ee61-4266-af17-a087da7fb6f7\', \'multiverseId\': 133308}, \'multiverseid\': 133308}, {\'name\': \'モグの戦争司令官\', \'text\': \'エコー {1}{R} （あなたのアップキープの開始時に、これが直前のあなたのアップキープの開始時よりも後にあなたのコントロール下になっていた場合、それのエコー・コストを支払わないかぎり、それを生け贄に捧げる。）\\nモグの戦争司令官が場に出るか場からいずれかの墓地に置かれるかしたとき、赤の１/１のゴブリン・クリーチャー・トークンを１体場に出す。\', \'type\': \'クリーチャー — ゴブリン・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133609&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'aec7abe8-a9ee-4527-addc-985e202b71c8\', \'multiverseId\': 133609}, \'multiverseid\': 133609}, {\'name\': \'Marechal-de-Guerra Mogg\', \'text\': \'Eco {1}{R} (No início de sua manutenção, se esta permanente passou a estar sob o seu controle desde o início de sua última manutenção, sacrifique-a, a menos que você pague seu custo de eco.)\\nQuando Marechal-de-Guerra Mogg entrar em jogo ou for colocado no cemitério vindo do jogo, coloque em jogo uma ficha de criatura vermelha 1/1 do tipo Goblin.\', \'type\': \'Criatura — Guerreiro Goblin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133910&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'da6ccbab-2f06-425c-ae1c-c91c58e9f8f5\', \'multiverseId\': 133910}, \'multiverseid\': 133910}, {\'name\': \'Маршал Могг\', \'text\': \'Эхо {1}{R} (В начале вашего шага поддержки, если это существо попало под ваш контроль с момента начала вашего предыдущего шага поддержки, пожертвуйте его, если вы не заплатите его эхо-стоимость.)\\nКогда Маршал Могг входит в игру или попадает на кладбище из игры, положите одну фишку существа 1/1 красный Гоблин в игру.\', \'type\': \'Существо — Гоблин Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134211&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f8c9d8d3-eb33-449b-895d-5428461c13b5\', \'multiverseId\': 134211}, \'multiverseid\': 134211}, {\'name\': \'莫葛战场元帅\', \'text\': \'返响{1}{R}（在你的维持开始时，若你在你前一个维持开始后才操控它，则除非你支付其返响费用，否则牺牲之。）\\n当莫葛战场元帅进场或从场上置入坟墓场时，将一个1/1红色精灵衍生物放置进场。\', \'type\': \'生物～精灵／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132405&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d1b5d7c8-4448-41c4-a2e6-96dc71490a60\', \'multiverseId\': 132405}, \'multiverseid\': 132405}]', '[{\'name\': \'Mondgewebe\', \'text\': \'Ein Zauberspruch oder einer bleibende Karte deiner Wahl wird farblos.\', \'type\': \'Spontanzauber\', \'flavor\': \'Einst war er konstant am Himmel zu sehen, doch schon lange wird der Mond vom Dunst, der den Himmel erstickt, verdeckt. Allein dass man ihn wieder zu sehen bekam, war ein Anzeichen, dass die Welt sich änderte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133011&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'09dcc93e-34df-4b96-a1a9-e44bb2fc2a43\', \'multiverseId\': 133011}, \'multiverseid\': 133011}, {\'name\': \'Atadura lunar\', \'text\': \'El hechizo o permanente objetivo es incoloro.\', \'type\': \'Instantáneo\', \'flavor\': \'Antiguamente era una visión constante en el cielo, pero la luna estuvo mucho tiempo escondida tras la niebla que asfixia el firmamento. Poder vislumbrarla es un signo de que algo está cambiando.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134516&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4f78a0b4-780b-4f39-9245-0624915cc253\', \'multiverseId\': 134516}, \'multiverseid\': 134516}, {\'name\': \'Voile de lune\', \'text\': \'Le sort ou le permanent ciblé devient incolore.\', \'type\': \'Éphémère\', \'flavor\': \'Autrefois un symbole de constance dans le ciel, la lune était depuis longtemps cachée par la brume qui étouffe le firmament. Son apparition était signe de grands changements à venir.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132710&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'08957538-8e98-4439-9cd1-d5cbba710fdf\', \'multiverseId\': 132710}, \'multiverseid\': 132710}, {\'name\': \'Segno Lunare\', \'text\': \'Una magia o un permanente bersaglio diventa incolore.\', \'type\': \'Istantaneo\', \'flavor\': "Un tempo presenza costante nel cielo, la luna è stata celata dalla foschia che soffoca la volta celeste. La semplice vista della luna era diventata un segno che il cambiamento era nell\'aria", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133312&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b0b7985e-4699-4118-bd95-3147ad198835\', \'multiverseId\': 133312}, \'multiverseid\': 133312}, {\'name\': \'月の色\', \'text\': \'呪文１つかパーマネント１つを対象とする。それは無色になる。\', \'type\': \'インスタント\', \'flavor\': \'かつて空の普遍の光景だった月は、天空を埋め尽くしたもやに長く隠され続けていた。 それが現れる時、それこそが変化の兆しとなる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133613&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'aaf65582-90e2-43ef-a00d-51bbda3fa6e0\', \'multiverseId\': 133613}, \'multiverseid\': 133613}, {\'name\': \'Enlace Lunar\', \'text\': \'A mágica alvo ou a permanente alvo torna-se incolor.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Outrora uma visão constante nos céus, a lua ficou por muito tempo escondida pela neblina que asfixia os céus. A sua mera visão tornou-se um sinal de mudança no ar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133914&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e543d16d-58a9-4404-a7be-2caa2482c0b2\', \'multiverseId\': 133914}, \'multiverseid\': 133914}, {\'name\': \'Цвета Луны\', \'text\': \'Целевое заклинание или перманент становится бесцветным.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'В одном стойком видении в небесах луна была скрыта от взора душащим туманом. И весь этот вид давал понять, что перемены грядут.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134215&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c27974c2-090a-4931-a00e-ad8b0edcd6c5\', \'multiverseId\': 134215}, \'multiverseid\': 134215}, {\'name\': \'苍月纹饰\', \'text\': \'目标咒语或永久物成为无色。\', \'type\': \'瞬间\', \'flavor\': \'原本抬头可见的月亮，已被铺天盖地的尘雾掩盖许久。 现今若见到月亮，所象征的是大气有所改变。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132409&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2ab2c3dc-b55a-41ad-bb19-bf88257be6c3\', \'multiverseId\': 132409}, \'multiverseid\': 132409}]', '[{\'name\': \'Montagearbeiter\', \'text\': \'{T}: Ein Montagearbeiter deiner Wahl erhält +1/+1 bis zum Ende des Zuges.\', \'type\': \'Artefaktkreatur — Montagearbeiter\', \'flavor\': \'Obwohl ihre Fabriken längst zerstört sind, schuften einige von Mishras Schöpfungen immer noch in einsamen Gegenden, wo sie ohne Unterlass ihre vor langer Zeit erhaltenen Aufträgen erfüllen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132865&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'038270c4-2fc8-4d01-b231-4f9f996a3c6e\', \'multiverseId\': 132865}, \'multiverseid\': 132865}, {\'name\': \'Operario\', \'text\': \'{T}: El Operario objetivo obtiene +1/+1 hasta el final del turno.\', \'type\': \'Criatura artefacto — Operario\', \'flavor\': \'A pesar de que sus factorías fueron destruidas mucho tiempo antes, algunas de las creaciones de Mishra aún trabajan en áreas remotas, realizando una y otra vez la última tarea que les fue encomendada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134370&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b9b0a95f-e3ba-4e94-a0f3-f5eb9e1fcb8e\', \'multiverseId\': 134370}, \'multiverseid\': 134370}, {\'name\': \'Ouvrier spécialisé\', \'text\': "{T} : L\'ouvrier spécialisé ciblé gagne +1/+1 jusqu\'à la fin du tour.", \'type\': \'Créature-artefact : ouvrier spécialisé\', \'flavor\': \'Depuis la destruction de leurs usines, certaines des créations de Mishra travaillaient encore dans des régions isolées, répétant sans cesse leurs dernières instructions.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132564&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1f299a77-02f7-4998-91f8-f70aa73e181c\', \'multiverseId\': 132564}, \'multiverseid\': 132564}, {\'name\': \'Addetto-al-Montaggio\', \'text\': "{T}: L\'Addetto-al-Montaggio bersaglio prende +1/+1 fino alla fine del turno.", \'type\': \'Creatura Artefatto — Addetto-al-Montaggio\', \'flavor\': "Con le loro fabbriche da tempo distrutte, alcune delle creazioni di Mishra continuano a sgobbare in zone remote, ripetendo all\'infinito gli ultimi ordini ricevuti.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133166&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e953d51e-5769-46c5-a1a1-f6ba9d00604e\', \'multiverseId\': 133166}, \'multiverseid\': 133166}, {\'name\': \'組立作業員\', \'text\': \'{T}：組立作業員１体を対象とする。それはターン終了時まで＋１/＋１の修整を受ける。\', \'type\': \'アーティファクト・クリーチャー — 組立作業員\', \'flavor\': \'彼らの工廠が長き昔に破壊された結果、ミシュラの創造物のいくつかは、最後に与えられた命令を人里離れた地でひたすら繰り返し続けている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133467&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7deee934-9fa6-4e18-a4ed-20bfb196fcda\', \'multiverseId\': 133467}, \'multiverseid\': 133467}, {\'name\': \'Operário de Linha de Montagem\', \'text\': \'{T}: O Operário de Linha de Montagem alvo recebe +1/+1 até o final do turno.\', \'type\': \'Criatura Artefato — Operário-de-Linha-de-Montagem\', \'flavor\': \'Com suas fábricas há tempos destruídas, algumas das criações de Mishra ainda trabalham duro em áreas remotas, executando continuamente suas últimas ordens, eternamente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133768&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'02f94a1d-7713-45cb-8dda-a7c58954b556\', \'multiverseId\': 133768}, \'multiverseid\': 133768}, {\'name\': \'Рабочий-сборщик\', \'text\': \'{T}: Целевой Рабочий-сборщик получает +1/+1 до конца хода.\', \'type\': \'Артефактное Существо — Рабочий-сборщик\', \'flavor\': \'Даже после разрушения фабрик некоторые из творений Мишры продолжали усиленно трудиться в отдаленных областях, бесконечно выполняя и повторяя свои последние поручения.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134069&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0d0c577d-bb26-46d5-84eb-f10a21efe887\', \'multiverseId\': 134069}, \'multiverseid\': 134069}, {\'name\': \'组装工人\', \'text\': \'{T}：目标组装工人得+1/+1直到回合结束。\', \'type\': \'神器生物～组装工人\', \'flavor\': \'即使所属的工厂早已不存，某些米斯拉的作品依旧在偏远地带辛勤工作，不断地执行、查核最后收到的命令。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132263&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e447cf88-1210-4269-8b90-cf50a56f2156\', \'multiverseId\': 132263}, \'multiverseid\': 132263}]', '[{\'name\': \'Mungoblut\', \'text\': \'Kreaturenverzauberung\\nDie verzauberte Kreatur kann nicht das Ziel von Zaubersprüchen oder Fähigkeiten sein.\\nWenn Mungoblut in einen Friedhof gelegt wird, bringe Mungoblut auf die Hand seines Besitzers zurück.\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132863&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6a546e6b-053c-4fe2-b43f-da05ec2fe49d\', \'multiverseId\': 132863}, \'multiverseid\': 132863}, {\'name\': \'Aspecto de mangosta\', \'text\': \'Encantar criatura.\\nLa criatura encantada no puede ser objetivo de hechizos o habilidades.\\nCuando el Aspecto de mangosta vaya a un cementerio del juego, regresa el Aspecto de mangosta a la mano de su propietario.\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134368&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4b896887-36c4-440e-89a2-a330d1aa69af\', \'multiverseId\': 134368}, \'multiverseid\': 134368}, {\'name\': \'Aspect de la mangouste\', \'text\': "Enchanter : créature\\nLa créature enchantée ne peut être la cible de sorts ou de capacités.\\nQuand l\'Aspect de la mangouste est mis dans un cimetière depuis le jeu, renvoyez l\'Aspect de la mangouste dans la main de son propriétaire.", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132562&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8a864eef-71a6-46d0-b13a-aa46e2fd8c3b\', \'multiverseId\': 132562}, \'multiverseid\': 132562}, {\'name\': \'Aspetto della Mangusta\', \'text\': "Incanta creatura\\nLa creatura incantata non può essere bersaglio di magie o abilità.\\nQuando l\'Aspetto della Mangusta viene messo in un cimitero dal gioco, fai tornare l\'Aspetto della Mangusta in mano al suo proprietario.", \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133164&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'25f2cf62-0563-44a1-a357-6da82bfd9ebb\', \'multiverseId\': 133164}, \'multiverseid\': 133164}, {\'name\': \'マングースの血\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは、呪文や能力の対象にならない。\\nマングースの血が場からいずれかの墓地に置かれたとき、マングースの血をオーナーの手札に戻す。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133465&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6012b64e-d2be-4599-a84a-cec0757559af\', \'multiverseId\': 133465}, \'multiverseid\': 133465}, {\'name\': \'Face do Mangusto\', \'text\': \'Encantar Criatura\\nA criatura encantada não pode ser alvo de mágicas nem de habilidades.\\nQuando Face do Mangusto for colocado no cemitério vindo do jogo, devolva-o para a mão de seu dono.\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133766&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ff8cea9d-d3b6-4644-93a3-5967d40ba2a8\', \'multiverseId\': 133766}, \'multiverseid\': 133766}, {\'name\': \'Аспект Мангуста\', \'text\': \'Зачаровать существо\\nЗачарованное существо не может быть целью заклинаний или способностей.\\nКогда Аспект Мангуста попадает на кладбище из игры, верните Аспект Мангуста в руку его владельца.\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134067&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'28e9fe10-86c7-44c1-b2e4-8fd78fcd8b11\', \'multiverseId\': 134067}, \'multiverseid\': 134067}, {\'name\': \'猫鼬外貌\', \'text\': \'生物结界\\n受此结界的生物不能成为咒语或异能的目标。\\n当猫鼬外貌从场上进入坟墓场时，将猫鼬外貌移回其拥有者手上。\', \'type\': \'结界～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132261&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6f4d4b27-1be5-4a1d-aca4-67dc8fa20a0a\', \'multiverseId\': 132261}, \'multiverseid\': 132261}]', '[{\'name\': \'Muschelbewohnender Thallid\', \'text\': \'Verteidiger\\nLege zu Beginn deines Versorgungssegments eine Sporenmarke auf den Muschelbewohnenden Thalliden.\\nEntferne drei Sporenmarken vom Muschelbewohnenden Thalliden: Bringe einen 1/1 grünen Saprolingspielstein ins Spiel.\', \'type\': \'Kreatur — Pilzwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133113&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f1cf313c-0049-42f8-a366-b491184ce8c8\', \'multiverseId\': 133113}, \'multiverseid\': 133113}, {\'name\': \'Tálido morador de caparazón\', \'text\': \'Defensor.\\nAl comienzo de tu mantenimiento, pon un contador de espora sobre el Tálido morador de caparazón.\\nRemover tres contadores de espora del Tálido morador de caparazón: Pon en juego una ficha de criatura Saprolín verde 1/1.\', \'type\': \'Criatura — Hongo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134618&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2c64e984-62ae-48f3-917a-dcb208170c82\', \'multiverseId\': 134618}, \'multiverseid\': 134618}, {\'name\': \'Thallidé encoquillé\', \'text\': \'Défenseur\\nAu début de votre entretien, mettez un marqueur « spore » sur le Thallidé encoquillé.\\nRetirez trois marqueurs « spore » du Thallidé encoquillé : Mettez en jeu un jeton de créature 1/1 verte Saprobionte.\', \'type\': \'Créature : fongus\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132812&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d48fcec1-6337-42af-a836-3f53c49bc566\', \'multiverseId\': 132812}, \'multiverseid\': 132812}, {\'name\': \'Thallid col Guscio\', \'text\': "Difensore\\nAll\'inizio del tuo mantenimento, metti un segnalino spora sulla Thallid col Guscio.\\nRimuovi tre segnalini spora dalla Thallid col Guscio: Metti in gioco una pedina creatura Saprolingio 1/1 verde.", \'type\': \'Creatura — Fungus\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133414&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d627b7ee-67ad-48f3-8db1-2668d13f3127\', \'multiverseId\': 133414}, \'multiverseid\': 133414}, {\'name\': \'サリッドの殻住まい\', \'text\': \'防衛\\nあなたのアップキープの開始時に、サリッドの殻住まいの上に胞子カウンターを１個置く。\\nサリッドの殻住まいから胞子カウンターを３個取り除く：緑の１/１の苗木クリーチャー・トークンを１体場に出す。\', \'type\': \'クリーチャー — ファンガス\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133715&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a392570f-2543-4fc3-a5aa-3b6bf305b510\', \'multiverseId\': 133715}, \'multiverseid\': 133715}, {\'name\': \'Talídia Caracol\', \'text\': \'Defensor\\nNo início de sua manutenção, coloque um marcador de esporo sobre Talídia Caracol.\\nRemova três marcadores de esporo de Talídia Caracol: coloque em jogo uma ficha de criatura verde 1/1 do tipo Saprófita.\', \'type\': \'Criatura — Fungo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134016&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'96024acf-b2a8-4d3d-94e6-11581ae0b833\', \'multiverseId\': 134016}, \'multiverseid\': 134016}, {\'name\': \'Таллид Обитатель Раковин\', \'text\': \'Защитник\\nВ начале вашего шага поддержки положите жетон споры на Таллида Обитателя Раковин.\\nУдалите три жетона споры с Таллида Обитателя Раковин: Положите одну фишку существа 1/1 зеленый Сапролинг в игру.\', \'type\': \'Существо — Плесень\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134317&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'48ef332a-bfd6-4eae-8034-e35855d1d1bf\', \'multiverseId\': 134317}, \'multiverseid\': 134317}, {\'name\': \'蜗居散绿菌\', \'text\': \'守军\\n在你的维持开始时，在蜗居散绿菌上放置一个芽孢指示物。\\n从蜗居散绿菌上移去三个芽孢指示物：将一个1/1绿色腐生物衍生物放置进场。\', \'type\': \'生物～真菌\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132511&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'669e0594-62cb-465f-9b96-e0b8508d6284\', \'multiverseId\': 132511}, \'multiverseid\': 132511}]', '[{\'name\': \'Mwonvuli-Säuremoos\', \'text\': \'Zerstöre ein Land deiner Wahl. Durchsuche deine Bibliothek nach einem Wald und bringe diese Karte getappt ins Spiel. Mische danach deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': \'„Dem Leben folgt der Tod, dem Tod folgt neues Leben. Die Natur nährt sich vom eigenen Zerfall." —Ezrith, Druide der Dunklen Stunden\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133016&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d1799980-09fc-4856-9952-a6206a76f046\', \'multiverseId\': 133016}, \'multiverseid\': 133016}, {\'name\': \'Musgo ácido de Mwonvuli\', \'text\': \'Destruye la tierra objetivo. Busca en tu biblioteca una carta de bosque y pon en juego esa carta girada. Luego baraja tu biblioteca.\', \'type\': \'Conjuro\', \'flavor\': \'"La vida da paso a la muerte, y la muerte a nueva vida. La Naturaleza se alimenta de su propia descomposición." —Ezrith, druida de las Horas Sombrías\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134521&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7842fb0f-eb2b-445f-ba01-cb01744ce35e\', \'multiverseId\': 134521}, \'multiverseid\': 134521}, {\'name\': \'Mousse acide de la Mwônvouli\', \'text\': \'Détruisez le terrain ciblé. Cherchez dans votre bibliothèque une carte de forêt et mettez cette carte en jeu engagée. Mélangez ensuite votre bibliothèque.\', \'type\': \'Rituel\', \'flavor\': \'« La vie conduit à la mort, et la mort à une nouvelle vie. La Nature se nourrit de sa propre décomposition. » —Ezrith, druide des Heures sombres\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132715&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dfa92b1d-87c1-4f6c-ad9b-a24b11579f40\', \'multiverseId\': 132715}, \'multiverseid\': 132715}, {\'name\': \'Muschio Acido di Mwonvuli\', \'text\': \'Distruggi una terra bersaglio. Passa in rassegna il tuo grimorio per una carta Foresta e mettila in gioco TAPpata. Poi rimescola il tuo grimorio.\', \'type\': \'Stregoneria\', \'flavor\': \'"La vita cede il passo alla morte e la morte a una nuova vita. La natura si nutre della propria decomposizione." —Ezrith, druido delle Ore Buie\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133317&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'15f213ab-3593-4121-beaa-380b8a3d438f\', \'multiverseId\': 133317}, \'multiverseid\': 133317}, {\'name\': \'ムウォンヴーリーの酸苔\', \'text\': \'土地１つを対象とし、それを破壊する。 あなたのライブラリーから森カードを１枚探し、そのカードをタップ状態で場に出す。 その後あなたのライブラリーを切り直す。\', \'type\': \'ソーサリー\', \'flavor\': \'生は死への道を与え、死は新たな生となる。 自然は己の腐敗から飽きるほどの糧食を得るのだ。 ――暗刻教団のドルイド僧、エズリス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133618&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9a2a6679-8798-4b56-86a6-049a6e362195\', \'multiverseId\': 133618}, \'multiverseid\': 133618}, {\'name\': \'Limo Ácido de Mwonvuli\', \'text\': \'Destrua o terreno alvo. Procure em seu grimório por um card de Floresta e coloque-o em jogo virado. Depois, embaralhe seu grimório.\', \'type\': \'Feitiço\', \'flavor\': \'"A vida dá passagem à morte, e a morte a uma nova vida. A natureza alimenta-se de sua própria decadência." —Ezrith, druida das Horas Sombrias\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133919&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3f4f61ef-81c0-4839-831e-9434b76d6efb\', \'multiverseId\': 133919}, \'multiverseid\': 133919}, {\'name\': \'Кислотный Мох Мвонвули\', \'text\': \'Уничтожьте целевую землю. Поищите в вашей библиотеке карту Леса и положите эту карту в игру повернутой. Затем перетасуйте вашу библиотеку.\', \'type\': \'Волшебство\', \'flavor\': \'«Жизнь ведет к смерти, а смерть к новой жизни. Природа питается своими же разложениями», Эзрит, друид Темных времен\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134220&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'73449de1-902c-411d-8639-73286dfa530a\', \'multiverseId\': 134220}, \'multiverseid\': 134220}, {\'name\': \'木万弗黎酸苔\', \'text\': \'消灭目标地。 从你的牌库中搜寻一张树林牌，并将之横置进场。 然后将你的牌库洗牌。\', \'type\': \'法术\', \'flavor\': \'「生命为死亡引路，死亡带出新生。 自然靠本身残骸茁壮。」 ～黯刻德鲁伊易季司\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132414&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f4095ba0-5606-49d7-afdb-16b42d21e75f\', \'multiverseId\': 132414}, \'multiverseid\': 132414}]', '[{\'name\': \'Mystische Lehren\', \'text\': \'Durchsuche deine Bibliothek nach einer Spontanzauberkarte oder einer Karte mit Aufblitzen, zeige sie offen vor und nimm sie auf deine Hand. Mische danach deine Bibliothek.\\nRückblende {5}{B} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten spielen. Entferne sie dann ganz aus dem Spiel.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133017&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c8c3bbe3-41e0-45f0-8592-663dfb6bdd67\', \'multiverseId\': 133017}, \'multiverseid\': 133017}, {\'name\': \'Enseñanzas místicas\', \'text\': \'Busca en tu biblioteca una carta de instantáneo o con la habilidad de destello, muéstrala y ponla en tu mano. Luego baraja tu biblioteca.\\nRetrospectiva {5}{B} (Puedes jugar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego remuévela del juego.)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134522&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d1e98541-d899-4cfc-98ed-64ee1992832b\', \'multiverseId\': 134522}, \'multiverseid\': 134522}, {\'name\': \'Enseignements mystiques\', \'text\': "Cherchez dans votre bibliothèque une carte d\'éphémère ou une carte avec flash, révélez-la et mettez-la dans votre main. Mélangez ensuite votre bibliothèque.\\nFlashback {5}{B} (Vous pouvez jouer cette carte depuis votre cimetière pour son coût de flashback. Retirez-la ensuite de la partie.)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132716&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e9133056-c88b-4554-b209-514443eb2772\', \'multiverseId\': 132716}, \'multiverseid\': 132716}, {\'name\': \'Insegnamenti Mistici\', \'text\': \'Passa in rassegna il tuo grimorio per una carta istantaneo o una carta con lampo, rivelala e aggiungila alla tua mano. Poi rimescola il tuo grimorio.\\nFlashback {5}{B} (Puoi giocare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi rimuovila dal gioco).\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133318&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'50ee23be-af2a-4efe-9453-7e629e6fa341\', \'multiverseId\': 133318}, \'multiverseid\': 133318}, {\'name\': \'神秘の指導\', \'text\': \'あなたのライブラリーから、インスタント・カード１枚か瞬速を持つカード１枚を探し、それを公開してあなたの手札に加える。 その後あなたのライブラリーを切り直す。\\nフラッシュバック {5}{B} （あなたはフラッシュバック・コストで、このカードをあなたの墓地からプレイしてもよい。 その後それをゲームから取り除く）\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133619&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e52b7ff9-df17-4cc8-849d-9485d78c0f75\', \'multiverseId\': 133619}, \'multiverseid\': 133619}, {\'name\': \'Ensinamentos Místicos\', \'text\': \'Procure em seu grimório por um card de mágica instantânea ou um card com lampejo, revele-o e coloque-o em sua mão. Depois, embaralhe seu grimório.\\nRecapitular {5}{B} (Você pode jogar este card de seu cemitério pagando seu custo de recapitulação. Depois remova-o do jogo.)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133920&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'677e4aad-86e3-43bc-bd20-abcc7fc0c8e4\', \'multiverseId\': 133920}, \'multiverseid\': 133920}, {\'name\': \'Мистическое Учение\', \'text\': \'Поищите в вашей библиотеке карту мгновенного заклинания или карту со свойством Миг, предъявите ее и положите в вашу руку. Затем перетасуйте вашу библиотеку.\\nВоспоминание {5}{B} (Вы можете играть эту карту из вашего кладбища за ее стоимость воспоминания. Затем уберите ее из игры.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134221&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8d431ba9-82a6-4772-bc41-3497ac00a586\', \'multiverseId\': 134221}, \'multiverseid\': 134221}, {\'name\': \'神秘教谕\', \'text\': \'从你的牌库中搜寻一张瞬间牌或具闪现异能的牌，展示该牌，并将它置入你手上。 然后将你的牌库洗牌。\\n返照{5}{B}（你可以从你的坟墓场使用此牌，并支付其返照费用， 然后将它移出对战。）\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132415&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'011e8582-f126-4ccb-bbea-6c08e6891045\', \'multiverseId\': 132415}, \'multiverseid\': 132415}]', '[{\'name\': \'Nachtschattenmeuchler\', \'text\': \'Erstschlag\\nWenn der Nachtschattenmeuchler ins Spiel kommt, kannst du X schwarze Karten aus deiner Hand offen vorzeigen. Falls du das tust, erhält eine Kreatur deiner Wahl -X/-X bis zum Ende des Zuges.\\nWahnsinn {1}{B} (Falls du diese Karte aus deiner Hand abwirfst, kannst du sie für ihre Wahnsinn-Kosten spielen, anstatt sie auf deinen Friedhof zu legen.)\', \'type\': \'Kreatur — Mensch, Assassine\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133020&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'136bb523-7da9-4962-bbba-c033741c657b\', \'multiverseId\': 133020}, \'multiverseid\': 133020}, {\'name\': \'Asesina de belladona\', \'text\': \'Daña primero.\\nCuando la Asesina de belladona entre en juego, puedes mostrar X cartas negras de tu mano. Si lo haces, la criatura objetivo obtiene -X/-X hasta el final del turno.\\nDemencia {1}{B} (Si descartas esta carta, puedes jugarla por su coste de demencia en vez de ponerla en tu cementerio.)\', \'type\': \'Criatura — Asesino humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134525&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'94a469fd-4ff4-42e3-b61c-7544877e0866\', \'multiverseId\': 134525}, \'multiverseid\': 134525}, {\'name\': \'Assassin de la belladone\', \'text\': "Initiative\\nQuand l\'Assassin de la belladone arrive en jeu, vous pouvez révéler X cartes noires de votre main. Si vous faites ainsi, la créature ciblée gagne -X/-X jusqu\'à la fin du tour.\\nFolie {1}{B} (Si vous vous défaussez de cette carte, vous pouvez la jouer pour son coût de folie à la place de la mettre dans votre cimetière.)", \'type\': \'Créature : humain et assassin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132719&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4e7588ed-c74d-4d86-af86-217fe9ade3e1\', \'multiverseId\': 132719}, \'multiverseid\': 132719}, {\'name\': \'Assassina di Belladonna\', \'text\': "Attacco improvviso\\nQuando l\'Assassina di Belladonna entra in gioco, puoi rivelare X carte nere dalla tua mano. Se lo fai, una creatura bersaglio prende -X/-X fino alla fine del turno.\\nFollia {1}{B} (Se scarti questa carta, puoi giocarla pagando il suo costo di follia invece di metterla nel tuo cimitero.)", \'type\': \'Creatura — Assassino Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133321&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ba5ad272-d2b2-49d0-8c93-7dc8643428ce\', \'multiverseId\': 133321}, \'multiverseid\': 133321}, {\'name\': \'ベラドンナの暗殺者\', \'text\': \'先制攻撃\\nベラドンナの暗殺者が場に出たとき、クリーチャー１体を対象とする。あなたは自分の手札にある黒のカードをＸ枚公開してもよい。 そうした場合、そのクリーチャーはターン終了時まで－Ｘ/－Ｘの修整を受ける。\\nマッドネス {1}{B} （あなたがこのカードを捨てる場合、あなたはそれをあなたの墓地に置く代わりに、マッドネス・コストでそれをプレイしてもよい。）\', \'type\': \'クリーチャー — 人間・暗殺者\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133622&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'05ba925b-1e34-450b-9adf-f46c212a3556\', \'multiverseId\': 133622}, \'multiverseid\': 133622}, {\'name\': \'Assassino de Beladona\', \'text\': \'Iniciativa\\nQuando Assassino de Beladona entra em jogo, você pode revelar X cards pretos em sua mão. Se o fizer, a criatura alvo receberá -X/-X até o final do turno.\\nLoucura {1}{B} (Se descartar este card, você poderá jogá-lo pagando seu custo de loucura, em vez de colocá-lo em seu cemitério.)\', \'type\': \'Criatura — Assassino Humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133923&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2dff3a94-070c-44d9-811f-94e51cf69b03\', \'multiverseId\': 133923}, \'multiverseid\': 133923}, {\'name\': \'Убийца из Ночной Тени\', \'text\': \'Первый удар\\nКогда Убийца из Ночной Тени входит в игру, вы можете показать X черных карт из вашей руки. Если вы это сделали, целевое существо получает -X/-X до конца хода.\\nБешенство {1}{B} (Если вы сбрасываете эту карту, вы можете сыграть ее за ее стоимость бешенства вместо того чтобы положить ее на ваше кладбище.)\', \'type\': \'Существо — Человек Убийца\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134224&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e3a0fdf4-04f7-4745-9f92-7fb2af0d9d1d\', \'multiverseId\': 134224}, \'multiverseid\': 134224}, {\'name\': \'龙葵杀手\', \'text\': \'先攻\\n当龙葵杀手进场时，你可以从你手上展示X张黑色牌。 若你如此作，则目标生物得-X/-X直到回合结束。\\n疯魔{1}{B}（如果你弃掉此牌，可以改为使用它并支付其疯魔费用，而非直接将它置入你的坟墓场。）\', \'type\': \'生物～人类／杀手\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132418&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a4213d6f-0993-4674-861a-8c701e0c9429\', \'multiverseId\': 132418}, \'multiverseid\': 132418}]', '[{\'name\': \'Nantuko-Schamane\', \'text\': \'Wenn der Nantuko-Schamane ins Spiel kommt, ziehe eine Karte, falls du keine getappten Länder kontrollierst.\\nAussetzen 1 {2}{G}{G} (Statt diese Karte aus deiner Hand zu spielen, kannst du {2}{G}{G} bezahlen, sie ganz aus dem Spiel entfernen und eine Zeitmarke auf sie legen. Entferne zu Beginn deines Versorgungssegments eine Zeitmarke von ihr. Wenn du die letzte Zeitmarke entfernst, spiele die Karte, ohne ihre Manakosten zu bezahlen. Sie hat Eile.)\', \'type\': \'Kreatur — Insekt, Schamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133018&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'aed5afee-7dfc-4e1e-8128-70db24fdfc00\', \'multiverseId\': 133018}, \'multiverseid\': 133018}, {\'name\': \'Chamán nantuko\', \'text\': \'Cuando el Chamán nantuko entre en juego, si no controlas tierras giradas, roba una carta.\\nSuspender 1—{2}{G}{G} (En lugar de jugar esta carta de tu mano, puedes pagar {2}{G}{G} y removerla del juego con un contador de tiempo sobre ella. Al comienzo de tu mantenimiento, remueve un contador de tiempo. Cuando remuevas el último, juégala sin pagar su coste de maná. Tiene la habilidad de prisa.)\', \'type\': \'Criatura — Chamán insecto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134523&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5b818119-df22-4f63-8078-c60bb4eb07d6\', \'multiverseId\': 134523}, \'multiverseid\': 134523}, {\'name\': \'Shamane nantuko\', \'text\': \'Quand le Shamane nantuko arrive en jeu, si vous ne contrôlez pas de terrain engagé, piochez une carte.\\nSuspension 1 — {2}{G}{G} (Plutôt que jouer cette carte depuis votre main, vous pouvez payer {2}{G}{G} et la retirer de la partie avec un marqueur « temps » sur elle. Au début de votre entretien, retirez un marqueur « temps ». Quand vous retirez le dernier, jouez cette carte sans payer son coût de mana. Elle a la célérité.)\', \'type\': \'Créature : insecte et shamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132717&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1a76f185-28be-400b-bef4-e84f1ac86775\', \'multiverseId\': 132717}, \'multiverseid\': 132717}, {\'name\': \'Sciamano Nantuko\', \'text\': "Quando lo Sciamano Nantuko entra in gioco, se non controlli terre TAPpate, pesca una carta.\\nSospendere 1—{2}{G}{G} (Invece di giocare questa carta dalla tua mano, puoi pagare {2}{G}{G} e rimuoverla dal gioco con un segnalino tempo su di essa. All\'inizio del tuo mantenimento, rimuovi un segnalino tempo. Quando rimuovi l\'ultimo, gioca la carta senza pagare il suo costo di mana. Ha rapidità.)", \'type\': \'Creatura — Sciamano Insetto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133319&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d02829de-eed7-4f08-a669-aa65272e15c4\', \'multiverseId\': 133319}, \'multiverseid\': 133319}, {\'name\': \'ナントゥーコのシャーマン\', \'text\': \'ナントゥーコのシャーマンが場に出たとき、あなたがタップ状態の土地をコントロールしていない場合、カードを１枚引く。\\n待機 １―{2}{G}{G} （これをあなたの手札からプレイするのではなく、{2}{G}{G}を支払ってゲームから取り除き、その上に時間カウンターを１個置いてもよい。 あなたのアップキープの開始時に、時間カウンターを１個取り除く。 最後の１個を取り除いたとき、あなたはそれをマナ・コストを支払わずにプレイする。 それは速攻を持つ。）\', \'type\': \'クリーチャー — 昆虫・シャーマン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133620&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eef5bd89-e0b1-4b32-b98a-460594f039b1\', \'multiverseId\': 133620}, \'multiverseid\': 133620}, {\'name\': \'Xamã Nantuko\', \'text\': \'Quando Xamã Nantuko entrar em jogo, se você não controlar nenhum terreno virado, compre um card.\\nSuspender 1—{2}{G}{G} (Em vez de jogar este card da sua mão, você pode pagar {2}{G}{G} e removê-lo do jogo com um marcador temporal sobre ele. No início de sua manutenção, remova um marcador temporal. Quando remover o último, jogue-o sem pagar seu custo de mana. Ele tem ímpeto.)\', \'type\': \'Criatura — Xamã Inseto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133921&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'65941cbc-a206-488f-865d-bb602a6fb33c\', \'multiverseId\': 133921}, \'multiverseid\': 133921}, {\'name\': \'Шаман Нантуко\', \'text\': \'Когда Шаман Нантуко входит в игру, если вы контролируете неповернутые земли, возьмите карту.\\nОтсрочка 1—{2}{G}{G} (Вместо того чтобы сыграть эту карту из вашей руки, вы можете заплатить {2}{G}{G} и удалить ее из игры с одним временными жетоном на ней. В начале вашего шага поддержки, удалите один временной жетон. После удаления последнего жетона сыграйте эту карту без оплаты ее мана-стоимости. Она получает ускорение.)\', \'type\': \'Существо — Насекомое Шаман\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134222&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2ff8f650-3dd0-44da-b6eb-3c3797fc24d9\', \'multiverseId\': 134222}, \'multiverseid\': 134222}, {\'name\': \'螳人祭师\', \'text\': \'当螳人祭师进场时，若你未操控已横置的地，则抓一张牌。\\n延缓1～{2}{G}{G}（除了从你手上使用此牌，你可以支付{2}{G}{G}并将此牌移出对战，且上面有一个计时指示物。 在你的维持开始时，从其上移去一个计时指示物。 当你移去最后一个时，则使用它且不需支付其法术力费用。 它具有敏捷。）\', \'type\': \'生物～昆虫／祭师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132416&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9f463950-9206-4774-b433-e94fb934ac44\', \'multiverseId\': 132416}, \'multiverseid\': 132416}]', '[{\'name\': \'Nichtigmacher-Schweiger\', \'text\': \'Aufblitzen (Du kannst diesen Zauberspruch zu jedem Zeitpunkt spielen, zu dem du einen Spontanzauber spielen könntest.)\\nWenn der Nichtigmacher-Schweiger ins Spiel kommt, neutralisiere eine aktivierte Fähigkeit deiner Wahl. (Manafähigkeiten können nicht als Ziel bestimmt werden.)\\nImmer wenn du einen Zauberspruch spielst, kannst du den Nichtigmacher-Schweiger auf die Hand seines Besitzers zurückbringen.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133141&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cf23f22e-15a6-4bd5-bd23-2684258c1998\', \'multiverseId\': 133141}, \'multiverseid\': 133141}, {\'name\': \'Apaciguadora invalidamago\', \'text\': \'Destello (Puedes jugar este hechizo en cualquier momento en que pudieras jugar un instantáneo.)\\nCuando la Apaciguadora invalidamago entre en juego, contrarresta la habilidad activada objetivo. (Las habilidades de maná no pueden hacerse objetivo.)\\nSiempre que juegues un hechizo, puedes regresar la Apaciguadora invalidamago a la mano de su propietario.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134646&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7fbd6f2e-04c7-4f06-a0dd-db40b9f2bebf\', \'multiverseId\': 134646}, \'multiverseid\': 134646}, {\'name\': \'Videmage silencieuse\', \'text\': \'Flash (Vous pouvez jouer ce sort à tout moment où vous pourriez jouer un éphémère.)\\nQuand la Videmage silencieuse arrive en jeu, contrecarrez la capacité activée ciblée. (Les capacités de mana ne peuvent pas être ciblées.)\\nÀ chaque fois que vous jouez un sort, vous pouvez renvoyer la Videmage silencieuse dans la main de son propriétaire.\', \'type\': \'Créature : humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132840&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3d1bb606-8448-44ab-a028-eda1d3e3dacd\', \'multiverseId\': 132840}, \'multiverseid\': 132840}, {\'name\': \'Svuotamagie Placatrice\', \'text\': "Lampo (Puoi giocare questa magia in ogni momento in cui potresti giocare un istantaneo.)\\nQuando la Svuotamagie Placatrice entra in gioco, neutralizza un\'abilità attivata bersaglio. (Le abilità di mana non possono essere scelte come bersaglio.)\\nOgniqualvolta giochi una magia, puoi far tornare la Svuotamagie Placatrice in mano al suo proprietario.", \'type\': \'Creatura — Mago Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133442&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d51fa29d-f7b2-4871-8213-7383bd2f1b35\', \'multiverseId\': 133442}, \'multiverseid\': 133442}, {\'name\': \'虚空魔道士の沈黙者\', \'text\': \'瞬速 （あなたはこの呪文を、あなたがインスタントをプレイできるときならいつでもプレイしてよい。）\\n虚空魔道士の沈黙者が場に出たとき、起動型能力１つを対象とし、それを打ち消す。 （マナ能力は対象にできない。）\\nあなたがいずれかの呪文をプレイするたび、あなたは虚空魔道士の沈黙者をオーナーの手札に戻してもよい。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133743&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d113b51e-4e82-4587-9584-de933b8332ae\', \'multiverseId\': 133743}, \'multiverseid\': 133743}, {\'name\': \'Silenciador Mago do Vácuo\', \'text\': \'Lampejo (Você poderá jogar esta mágica a qualquer momento em que puder jogar uma mágica instantânea.)\\nQuando Silenciador Mago do Vácuo entrar em jogo, anule a habilidade ativada alvo. (As habilidades de mana não podem ser alvo.)\\nToda vez que você jogar uma mágica, você poderá devolver Silenciador Mago do Vácuo para a mão de seu dono.\', \'type\': \'Criatura — Mago Humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134044&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d59fb5e3-6789-4de3-80e6-2597b96a54f2\', \'multiverseId\': 134044}, \'multiverseid\': 134044}, {\'name\': \'Водворяющий Тишину Пустомаг\', \'text\': \'Миг (Вы можете играть это заклинание в любое время, когда вы можете играть мгновенные заклинания.)\\nКогда Водворяющий Тишину Пустомаг входит в игру, прервите целевую активируемую способность (Нельзя прицелиться в мана-способность.)\\nКогда вы играете заклинание, вы можете вернуть Водворяющего Тишину Пустомага в руку его владельца.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134345&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cc5eb3ab-2674-45fd-b1e7-ea6d8bc88759\', \'multiverseId\': 134345}, \'multiverseid\': 134345}, {\'name\': \'销法师静音使\', \'text\': \'闪现（你可以于你能够使用瞬间的时机下使用此咒语。）\\n当销法师静音使进场时，反击目标起动式异能。 （其目标不能是法术力异能）\\n每当你使用咒语时，你可以将销法师静音使移回其拥有者手上。\', \'type\': \'生物～人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132539&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b88a084e-086f-4e84-8863-c45643aeac5c\', \'multiverseId\': 132539}, \'multiverseid\': 132539}]', '[{\'name\': \'Norin der Vorsichtige\', \'text\': \'Wenn ein Spieler einen Zauberspruch spielt oder eine Kreatur angreift, entferne Norin den Vorsichtigen ganz aus dem Spiel. Bringe ihn am Ende des Zuges unter der Kontrolle seines Besitzers ins Spiel zurück.\', \'type\': \'Legendäre Kreatur — Mensch, Krieger\', \'flavor\': \'„Das gefällt mir irgendwie nicht."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133021&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0a90fc65-1b23-4669-a026-d0b8141ebfbd\', \'multiverseId\': 133021}, \'multiverseid\': 133021}, {\'name\': \'Norin el Precavido\', \'text\': \'Cuando un jugador juegue un hechizo o una criatura ataque, remueve del juego a Norin el Precavido. Regrésalo al juego bajo el control de su propietario al final del turno.\', \'type\': \'Criatura legendaria — Guerrero humano\', \'flavor\': \'"Tengo un mal presentimiento."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134526&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'437fb7aa-78ca-4209-a356-893100cce9a6\', \'multiverseId\': 134526}, \'multiverseid\': 134526}, {\'name\': \'Norin le circonspect\', \'text\': "Quand un joueur joue un sort ou qu\'une créature attaque, retirez Norin le circonspect de la partie. Renvoyez-le en jeu sous le contrôle de son propriétaire à la fin du tour.", \'type\': \'Créature légendaire : humain et guerrier\', \'flavor\': "« J\'ai un mauvais pressentiment. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132720&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dbae524c-47a5-47d8-a458-5e4d9cc3bccb\', \'multiverseId\': 132720}, \'multiverseid\': 132720}, {\'name\': \'Norin il Diffidente\', \'text\': \'Quando un giocatore gioca una magia o una creatura attacca, rimuovi dal gioco Norin il Diffidente. Rimettilo in gioco sotto il controllo del suo proprietario alla fine del turno.\', \'type\': \'Creatura Leggendaria — Guerriero Umano\', \'flavor\': \'"Ho una brutta sensazione riguardo a questo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133322&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'025975bc-d884-4076-9c83-258b367539e8\', \'multiverseId\': 133322}, \'multiverseid\': 133322}, {\'name\': \'二の足踏みのノリン\', \'text\': \'いずれかのプレイヤーが呪文をプレイするかクリーチャーが攻撃したとき、二の足踏みのノリンをゲームから取り除く。 ターン終了時に、それをオーナーのコントロール下で場に戻す。\', \'type\': \'伝説のクリーチャー — 人間・戦士\', \'flavor\': \'こいつは嫌な予感がするな。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133623&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3f5f906d-589e-43e1-93d9-f510ef3b5657\', \'multiverseId\': 133623}, \'multiverseid\': 133623}, {\'name\': \'Norin, o Cauteloso\', \'text\': \'Quando um jogador jogar uma mágica ou uma criatura atacar, remova Norin, o Cauteloso, do jogo. Devolva-o para o jogo, sob o controle de seu dono, no final do turno.\', \'type\': \'Criatura Lendária — Guerreiro Humano\', \'flavor\': \'"Tive um pressentimento ruim sobre isso."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133924&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1eebc1fd-aa27-4a5b-b6eb-ad9eff8a26ad\', \'multiverseId\': 133924}, \'multiverseid\': 133924}, {\'name\': \'Норин Осторожный\', \'text\': \'Когда игрок играет заклинание или существо атакует, уберите Норина, Осторожного из игры. Верните его в игру под контролем владельца в конце хода.\', \'type\': \'Легендарное Существо — Человек Воин\', \'flavor\': \'«У меня плохие предчувствия».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134225&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a5034286-d7c9-4909-93a9-9c844d0251d0\', \'multiverseId\': 134225}, \'multiverseid\': 134225}, {\'name\': \'谨慎的诺林\', \'text\': \'每当任一牌手使用咒语，或是任一生物攻击时，将谨慎的诺林移出对战。 在回合结束时，将它在其拥有者的操控下返回场上。\', \'type\': \'传奇生物～人类／战士\', \'flavor\': \'「我有个不好的预感。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132419&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b3427404-386a-491b-9ac4-0ce2d0eb7608\', \'multiverseId\': 132419}, \'multiverseid\': 132419}]', '[{\'name\': \'Opalwächter\', \'text\': \'Wenn ein Gegner einen Kreaturenzauber spielt, wird der Opalwächter zu einer 3/4 Gargoyle mit Flugfähigkeit und Schutz vor Rot, falls er eine Verzauberung ist.\', \'type\': \'Verzauberung\', \'flavor\': \'Er war ein Augenblick der Geschichte, in Stein gemeißelt — ein Augenblick, dessen Zeit wieder gekommen war.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133022&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ba566ab4-16ca-4932-accc-e9d6ef534126\', \'multiverseId\': 133022}, \'multiverseid\': 133022}, {\'name\': \'Guardián de ópalo\', \'text\': \'Cuando un oponente juegue un hechizo de criatura, si el Guardián de ópalo es un encantamiento, el Guardián de ópalo se convierte en una criatura Gárgola 3/4 con la habilidad de volar y protección contra rojo.\', \'type\': \'Encantamiento\', \'flavor\': \'Fue sólo un momento, grabado en la piedra; un momento cuyo tiempo ha vuelto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134527&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'40cf964d-fa16-4f88-a535-ed9e1b457580\', \'multiverseId\': 134527}, \'multiverseid\': 134527}, {\'name\': "Vigile d\'opale", \'text\': "Quand un adversaire joue un sort de créature, si le Vigile d\'opale est un enchantement, le Vigile d\'opale devient une créature 3/4 Gargouille avec le vol et la protection contre le rouge.", \'type\': \'Enchantement\', \'flavor\': "« C\'était un instant de temps, sculpté dans la pierre — et son temps était revenu. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132721&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0f4f5336-2830-4c93-ae18-b92af0d60d89\', \'multiverseId\': 132721}, \'multiverseid\': 132721}, {\'name\': "Guardiano d\'Opale", \'text\': "Quando un avversario gioca una magia creatura, se il Guardiano d\'Opale è un incantesimo, il Guardiano d\'Opale diventa una creatura Gargoyle 3/4 con volare e protezione dal rosso.", \'type\': \'Incantesimo\', \'flavor\': \'Fu un istante preciso, scolpito nel tempo—un momento destinato a ripetersi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133323&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'87356715-e465-49f7-8df5-4b1a6766aa50\', \'multiverseId\': 133323}, \'multiverseid\': 133323}, {\'name\': \'オパールの守護者\', \'text\': \'いずれかの対戦相手がクリーチャー呪文をプレイしたとき、オパールの守護者がエンチャントである場合、オパールの守護者は飛行とプロテクション（赤）を持つ３/４のガーゴイル・クリーチャーになる。\', \'type\': \'エンチャント\', \'flavor\': \'それは石の中に埋め込まれた一瞬の時――それはいずれ再び来る一瞬の時。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133624&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6ba98200-2c92-45b6-8351-236ce1274da9\', \'multiverseId\': 133624}, \'multiverseid\': 133624}, {\'name\': \'Guardião de Opala\', \'text\': \'Quando um oponente jogar uma mágica de criatura, se Guardião de Opala for um encantamento, ele se tornará uma criatura 3/4 do tipo Gárgula com a habilidade de voar e proteção contra o vermelho.\', \'type\': \'Encantamento\', \'flavor\': \'Foi um momento no tempo, esculpido na rocha um momento cuja hora retornara.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133925&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4c826ce5-f709-439b-8e7b-9684536e02ea\', \'multiverseId\': 133925}, \'multiverseid\': 133925}, {\'name\': \'Опаловый Страж\', \'text\': \'Когда оппонент играет заклинание существа, если Опаловый Страж является чарами, Опаловый страж Становится существом 3/4 Гаргулия с полетом и защитой от красного.\', \'type\': \'Чары\', \'flavor\': \'Это было мгновение во времени, застывшее в камне мгновение, чье время снова пришло.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134226&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5503508e-474f-4ec3-9fc0-be7ecc8fbe29\', \'multiverseId\': 134226}, \'multiverseid\': 134226}, {\'name\': \'蛋白石守护者\', \'text\': \'当任一对手使用生物咒语时，若蛋白石守护者为结界，则蛋白石守护者成为3/4，具飞行与反红保护异能的石像鬼生物。\', \'type\': \'结界\', \'flavor\': \'这作品将瞬间的姿态雕入石中～而那一刻的时间已再度到来。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132420&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cfdd82fe-8dba-40fc-a8b9-73476909170d\', \'multiverseId\': 132420}, \'multiverseid\': 132420}]', '[{\'name\': \'Ork-Kanonade\', \'text\': \'Ork-Kanonade fügt einer Kreatur oder einem Spieler deiner Wahl 2 Schadenspunkte und dir 3 Schadenspunkte zu.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Röschl Narbenbobbes Ladet die nächste Vulkankugel" —Einbein Thuj, Orkhauptmann\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133025&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d31e734e-cf37-45b1-b563-35b0290646f5\', \'multiverseId\': 133025}, \'multiverseid\': 133025}, {\'name\': \'Cañoneo orco\', \'text\': \'{T}: El Cañoneo orco hace 2 puntos de daño a la criatura o jugador objetivo y 3 puntos de daño a ti.\\nRoba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'"¡Tostado ¡Lomoquemado Carguen otra bola de volcán." —Stumphobbler Thuj, capitán orco\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134530&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ac813fba-098a-4904-ba07-a7578e44f2d9\', \'multiverseId\': 134530}, \'multiverseid\': 134530}, {\'name\': \'Canonnade orque\', \'text\': \'La canonnade orque inflige 2 blessures à une cible, créature ou joueur, et vous inflige 3 blessures.\\nPiochez une carte.\', \'type\': \'Éphémère\', \'flavor\': \'« Griyé Balafrhein Chargez un autre boulet de volcan. » —Thuj Kloshmoanion , capitaine orque\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132724&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'501117c9-6474-484e-acde-b7fe1ddd96d2\', \'multiverseId\': 132724}, \'multiverseid\': 132724}, {\'name\': \'Cannoneggiamento degli Orchi\', \'text\': \'Il Cannoneggiamento degli Orchi infligge 2 danni a una creatura o a un giocatore bersaglio e 3 danni a te.\\nPesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'"Polpetta Sfregiato Caricate un\\\'altra palla-vulcano." —Gambadilegno Thuj, Capitano degli Orchi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133326&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'46ea7638-30f9-4794-8c85-3137c82ec163\', \'multiverseId\': 133326}, \'multiverseid\': 133326}, {\'name\': \'オークの連続砲撃\', \'text\': \'クリーチャー１体かプレイヤー１人を対象とする。オークの連続砲撃はそれに２点のダメージを与え、あなたに３点のダメージを与える。\\nカードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': \'焦げ助！ 傷背！ 火山弾を装填しろ。 ――オークの隊長、足引きずりのサッジ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133627&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c74c2711-399a-4e1a-8649-d6b224b17ced\', \'multiverseId\': 133627}, \'multiverseid\': 133627}, {\'name\': \'Bombardeio Orc\', \'text\': \'Bombardeio Orc causa 2 pontos de dano à criatura alvo ou ao jogador alvo e 3 pontos de dano a você.\\nCompre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Crocante Cicatriz Carreguem outra bala vulcânica." —Thuj Passomanco, capitão orc\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133928&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'620202d5-579a-45d7-9b73-2b5344d176ab\', \'multiverseId\': 133928}, \'multiverseid\': 133928}, {\'name\': \'Канонада Орков\', \'text\': \'Канонада Орков наносит 2 повреждения целевому существу или игроку и 3 повреждения вам.\\nВозьмите карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Крипси Скарбак Заряжайте другое вулканическое ядро», Стапхоблер Туг, Капитан орков\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134229&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7ab3ffd4-2d42-4aa6-9644-f3e5cb7ea291\', \'multiverseId\': 134229}, \'multiverseid\': 134229}, {\'name\': \'半兽人炮轰\', \'text\': \'半兽人炮轰对目标生物或牌手造成2点伤害，并且对你造成3点伤害。\\n抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'「阿卷！ 老疤！ 把下一发火弹上膛。」 ～半兽人队长瘸腿索耶\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132423&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e0671101-b7f1-47ec-95fd-981dd62df70e\', \'multiverseId\': 132423}, \'multiverseid\': 132423}]', '[{\'name\': \'Paradiesfeder\', \'text\': \'Sowie die Paradiesfeder ins Spiel kommt, bestimme eine Farbe.\\nImmer wenn ein Spieler einen Zauberspruch der bestimmten Farbe spielt, kannst du 1 Lebenspunkt dazu erhalten.\\n{T}: Erhöhe deinen Manavorrat um ein Mana der bestimmten Farbe.\', \'type\': \'Artefakt\', \'flavor\': \'Ein letzter Hauch des Paradieses in einer untergegangenen Welt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133027&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2073d5fa-2497-443f-ba22-934966ed7cc3\', \'multiverseId\': 133027}, \'multiverseid\': 133027}, {\'name\': \'Pluma del paraíso\', \'text\': \'En cuanto la Pluma del paraíso entre en juego, elige un color.\\nSiempre que un jugador juegue un hechizo del color elegido, puedes ganar 1 vida.\\n{T}: Agrega un maná del color elegido a tu reserva de maná.\', \'type\': \'Artefacto\', \'flavor\': \'Un último vestigio de paraíso en un mundo caído.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134532&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b357b2a7-8d1c-4941-b961-0b8349d8a1f0\', \'multiverseId\': 134532}, \'multiverseid\': 134532}, {\'name\': \'Panache de paradis\', \'text\': "Au moment où le Panache de paradis arrive en jeu, choisissez une couleur.\\nÀ chaque fois qu\'un joueur joue un sort de la couleur choisie, vous pouvez gagner 1 point de vie.\\n{T} : Ajoutez un mana de la couleur choisie à votre réserve.", \'type\': \'Artefact\', \'flavor\': \'La dernière douceur du paradis dans un monde déchu.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132726&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9965382a-295f-4e06-b91e-5583311f7d1e\', \'multiverseId\': 132726}, \'multiverseid\': 132726}, {\'name\': \'Piuma del Paradiso\', \'text\': \'Mentre la Piuma del Paradiso entra in gioco, scegli un colore.\\nOgniqualvolta un giocatore gioca una magia del colore scelto, puoi guadagnare 1 punto vita.\\n{T}: Aggiungi un mana del colore scelto alla tua riserva di mana.\', \'type\': \'Artefatto\', \'flavor\': \'Un ultimo ciuffo di paradiso in un mondo decaduto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133328&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a1c1679a-6d06-497d-9df1-1896a3e245b5\', \'multiverseId\': 133328}, \'multiverseid\': 133328}, {\'name\': \'極楽の羽飾り\', \'text\': \'極楽の羽飾りが場に出るに際し、色を１色選ぶ。\\nいずれかのプレイヤーが選ばれた色の呪文をプレイするたび、あなたは１点のライフを得てもよい。\\n{T}：あなたのマナ・プールに、選ばれた色のマナ１点を加える。\', \'type\': \'アーティファクト\', \'flavor\': \'落ちぶれた世界の中の、楽園の最後の一欠片。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133629&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d53c33e0-e11c-441f-8533-2fdfe6c10740\', \'multiverseId\': 133629}, \'multiverseid\': 133629}, {\'name\': \'Pluma do Paraíso\', \'text\': \'Conforme Pluma do Paraíso entra em jogo, escolha uma cor.\\nToda vez que um jogador jogar uma mágica da cor escolhida, você poderá ganhar 1 ponto de vida.\\n{T}: Adicione um mana da cor escolhida à sua reserva de mana.\', \'type\': \'Artefato\', \'flavor\': \'Um último pedacinho do paraíso em um mundo decadente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133930&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8d914ad0-cfc2-42ef-9222-45b8f2b0a9bf\', \'multiverseId\': 133930}, \'multiverseid\': 133930}, {\'name\': \'Райское Перо\', \'text\': \'При входе Райского Пера в игру выберите цвет.\\nКогда игрок играет заклинание выбранного цвета, вы можете получить 1 жизнь.\\n{T}: Добавьте одну ману выбранного цвета в ваше хранилище маны.\', \'type\': \'Артефакт\', \'flavor\': \'Последний след рая в падшем мире.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134231&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ae047769-0b8a-4ed6-bcbb-36974267d503\', \'multiverseId\': 134231}, \'multiverseid\': 134231}, {\'name\': \'天堂羽饰\', \'text\': \'于天堂羽饰进场时，选择一种颜色。\\n每当牌手使用该色的咒语时，你可以获得1点生命。\\n{T}：加一点该色的法术力到你的法术力池中。\', \'type\': \'神器\', \'flavor\': \'天堂在破败世界中仅留此一缕。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132425&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9ac57421-b323-494c-9cd4-9c4bd0331c19\', \'multiverseId\': 132425}, \'multiverseid\': 132425}]', '[{\'name\': \'Paradoxer Dunst\', \'text\': \'Spielerverzauberung\\nZu Beginn des ersten Versorgungssegments des verzauberten Spielers erhält dieser Spieler ein zusätzliches Versorgungssegment nach diesem Segment.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Behalte deine Geschwindigkeit im Dunst gleichmäßig, damit du nicht deinem zukünftigen Ich auf die Fersen trittst oder dein Ich einen Moment hinter dir zum Stolpern bringst." —Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133028&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'70a14a43-4688-4667-b74e-34bf779dd02f\', \'multiverseId\': 133028}, \'multiverseid\': 133028}, {\'name\': \'Bruma paradojal\', \'text\': \'Encantar jugador.\\nAl comienzo del primer mantenimiento de cada turno del jugador encantado, ese jugador obtiene un mantenimiento adicional después de este paso.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"Mantén tu paso firme en la bruma, no sea cuestión de que pises los talones de tu yo futuro o te topes con tu yo de un momento pasado." —Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134533&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bba5bacd-6fdd-40e0-8c14-982e8520bc92\', \'multiverseId\': 134533}, \'multiverseid\': 134533}, {\'name\': \'Brume de paradoxe\', \'text\': "Enchanter : joueur\\nAu début du premier entretien du joueur enchanté à chaque tour, ce joueur gagne une étape d\'entretien supplémentaire après cette étape.", \'type\': \'Enchantement : aura\', \'flavor\': "« Traversez la brume d\'un pas régulier, vous risqueriez autrement de marcher sur le talon de votre avenir, ou de faire trébucher votre passé. » —Téfeiri", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132727&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a4ff465c-28c5-46bf-aada-db376c6f5c15\', \'multiverseId\': 132727}, \'multiverseid\': 132727}, {\'name\': \'Foschia Paradossale\', \'text\': "Incanta giocatore\\nAll\'inizio del primo mantenimento del giocatore incantato in ogni turno, quel giocatore gioca un mantenimento addizionale dopo questa sottofase.", \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Mantieni il passo costante attraverso la foschia, altrimenti potresti pestare i talloni del te stesso nel futuro o far inciampare il te stesso che ti sta seguendo." —Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133329&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cecdbc3b-4223-4c50-8377-a3887700aaca\', \'multiverseId\': 133329}, \'multiverseid\': 133329}, {\'name\': \'逆説のもや\', \'text\': \'エンチャント（プレイヤー）\\nエンチャントされているプレイヤーの各ターンの最初のアップキープの開始時に、そのプレイヤーはこのステップの直後に追加のアップキープ・ステップを得る。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'もやの中でも自分のペースを乱すな。未来のお前の足の上に着地しなければ、一瞬前の自分に足を引っ掛けられるぞ。 ――テフェリー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133630&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0311335d-5c5f-4c72-8ae4-c0eb79ff7477\', \'multiverseId\': 133630}, \'multiverseid\': 133630}, {\'name\': \'Bruma do Paradoxo\', \'text\': \'Encantar jogador\\nNo início da primeira manutenção do jogador encantado a cada turno, aquele jogador recebe uma etapa de manutenção adicional após esta etapa.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Mantenha o passo firme através da bruma, a fim de que não pise nos calcanhares do seu "eu" futuro nem tropece no seu "eu" de um minuto atrás." — Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133931&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'639bc72b-2f15-42a8-b79c-daf5bd23c594\', \'multiverseId\': 133931}, \'multiverseid\': 133931}, {\'name\': \'Туман Парадоксов\', \'text\': \'Зачаровать игрока\\nВ начале первого шага поддержки на каждом ходу зачарованного игрока этот игрок получает дополнительный шаг поддержки после окончания первого.\', \'type\': \'Чары — Аура\', \'flavor\': \'«Держи свой путь прямо через туман, не то ты будешь наступать себе же на пятки или вернешься в свое прошлое», Тефери\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134232&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f3c4cd03-26d1-43a7-8c1a-f9ae51961a9e\', \'multiverseId\': 134232}, \'multiverseid\': 134232}, {\'name\': \'奇诡迷雾\', \'text\': \'牌手结界\\n在受此结界的牌手每回合第一个维持开始时，该牌手在此步骤后额外得到一个维持步骤。\', \'type\': \'结界～灵气\', \'flavor\': \'「在迷雾中要放稳步调，以免踩到未来自己的脚跟，或是绊倒顷刻前的自己。」 ～泰菲力\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132426&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dc4e580e-3148-45e3-a9ed-2597700c2633\', \'multiverseId\': 132426}, \'multiverseid\': 132426}]', '[{\'name\': \'Pardischer Drache\', \'text\': \'Fliegend\\n{R}: Der Pardische Drache erhält +1/+0 bis zum Ende des Zuges.\\nAussetzen 2 {R}{R}\\nImmer wenn ein Gegner einen Zauberspruch spielt, kann dieser Spieler eine Zeitmarke auf den Pardischen Drachen legen, falls er ausgesetzt ist.\', \'type\': \'Kreatur — Drache\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133029&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'35317306-ceac-48ea-98b2-12ab5475b796\', \'multiverseId\': 133029}, \'multiverseid\': 133029}, {\'name\': \'Dragón párdico\', \'text\': \'Vuela.\\n{R}: El Dragón párdico obtiene +1/+0 hasta el final del turno.\\nSuspender 2—{R}{R}.\\nSiempre que un oponente juegue un hechizo, si el Dragón párdico está suspendido, ese jugador puede poner un contador de tiempo sobre el Dragón párdico.\', \'type\': \'Criatura — Dragón\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134534&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5eeda031-9b1b-4fa3-bde3-a4ce7bb8aff1\', \'multiverseId\': 134534}, \'multiverseid\': 134534}, {\'name\': \'Dragon pardique\', \'text\': "Vol\\n{R} : Le Dragon pardique gagne +1/+0 jusqu\'à la fin du tour.\\nSuspension 2 — {R}{R}\\nÀ chaque fois qu\'un adversaire joue un sort, si le Dragon pardique est en suspension, ce joueur peut mettre un marqueur « temps » sur le Dragon pardique.", \'type\': \'Créature : dragon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132728&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'401a714b-e5c8-4380-88bc-34c500a5288e\', \'multiverseId\': 132728}, \'multiverseid\': 132728}, {\'name\': \'Drago Pardico\', \'text\': \'Volare\\n{R}: Il Drago Pardico prende +1/+0 fino alla fine del turno.\\nSospendere 2—{R}{R}\\nOgniqualvolta un avversario gioca una magia, se il Drago Pardico è sospeso, quel giocatore può mettere un segnalino tempo sul Drago Pardico.\', \'type\': \'Creatura — Drago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133330&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'11c50fe3-7390-41d9-992c-48428b11cc21\', \'multiverseId\': 133330}, \'multiverseid\': 133330}, {\'name\': \'パーディック山のドラゴン\', \'text\': \'飛行\\n{R}：パーディック山のドラゴンはターン終了時まで＋１/＋０の修整を受ける。\\n待機 ２―{R}{R}\\nいずれかの対戦相手が呪文をプレイするたび、パーディック山のドラゴンが待機状態である場合、そのプレイヤーはパーディック山のドラゴンの上に時間カウンターを１個置いてもよい。\', \'type\': \'クリーチャー — ドラゴン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133631&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'66ef1bf5-0c51-43c5-b1e6-1127d302f437\', \'multiverseId\': 133631}, \'multiverseid\': 133631}, {\'name\': \'Dragão Párdico\', \'text\': \'Voar\\n{R}: Dragão Párdico recebe +1/+0 até o final do turno.\\nSuspender 2—{R}{R}\\nToda vez que um oponente jogar uma mágica, se Dragão Párdico estiver suspenso, aquele jogador poderá colocar um marcador temporal sobre Dragão Párdico.\', \'type\': \'Criatura — Dragão\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133932&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7b808fc4-8570-4211-b996-1f57083cbdee\', \'multiverseId\': 133932}, \'multiverseid\': 133932}, {\'name\': \'Пардикский Дракон\', \'text\': \'Полет\\n{R}: Пардикский Дракон получает +1/+0 до конца хода.\\nОтсрочка 2—{R}{R}\\nКогда оппонент играет заклинание, если Пардикский Дракон отсрочен, этот игрок может положить один временной жетон на Пардикского Дракона.\', \'type\': \'Существо — Дракон\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134233&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'eed0a599-9371-4ff1-a5f0-3b893af88317\', \'multiverseId\': 134233}, \'multiverseid\': 134233}, {\'name\': \'帕笛可巨龙\', \'text\': \'飞行\\n{R}：帕笛可巨龙得+1/+0直到回合结束。\\n延缓2～{R}{R}\\n每当对手使用咒语时，若帕笛可巨龙已延缓，则该牌手可以在帕笛可巨龙上放置一个计时指示物。\', \'type\': \'生物～龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132427&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f66d5a8f-fc37-4303-8a5f-3732593c24d5\', \'multiverseId\': 132427}, \'multiverseid\': 132427}]', '[{\'name\': \'Pentarchischer Paladin\', \'text\': \'Flankenangriff (Immer wenn eine Kreatur ohne Flankenangriff diese Kreatur blockt, erhält die blockende Kreatur -1/-1 bis zum Ende des Zuges.)\\nSowie der Pentarchische Paladin ins Spiel kommt, bestimme eine Farbe.\\n{W}{W}, {T}: Zerstöre eine bleibende Karte deiner Wahl der bestimmten Farbe.\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133031&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c6bec5f9-b335-4138-98b2-2c30cc1bf882\', \'multiverseId\': 133031}, \'multiverseid\': 133031}, {\'name\': \'Paladín pentarca\', \'text\': \'Flanquea (Siempre que una criatura sin la habilidad de flanquear bloquee a esta criatura, la criatura bloqueadora obtiene -1/-1 hasta el final del turno.)\\nEn cuanto el Paladín pentarca entre en juego, elige un color.\\n{W}{W}, {T}: Destruye el permanente objetivo del color elegido.\', \'type\': \'Criatura — Caballero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134536&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'539997e9-72d3-400f-a087-481d7d9488ac\', \'multiverseId\': 134536}, \'multiverseid\': 134536}, {\'name\': \'Paladin pentarque\', \'text\': "Débordement (À chaque fois qu\'une créature sans le débordement bloque cette créature, la créature bloqueuse gagne -1/-1 jusqu\'à la fin du tour.)\\nAu moment où le Paladin pentarque arrive en jeu, choisissez une couleur.\\n{W}{W}, {T} : Détruisez le permanent ciblé de la couleur choisie.", \'type\': \'Créature : humain et chevalier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132730&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'db37d0a4-4dbf-4443-82a0-ff8f11f150ca\', \'multiverseId\': 132730}, \'multiverseid\': 132730}, {\'name\': \'Paladino Pentarca\', \'text\': \'Aggirare (Ogniqualvolta una creatura senza aggirare blocca questa creatura, la creatura bloccante prende -1/-1 fino alla fine del turno.)\\nMentre il Paladino Pentarca entra in gioco, scegli un colore.\\n{W}{W}, {T}: Distruggi un permanente bersaglio del colore scelto.\', \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133332&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'248257d3-4bc4-4c24-8256-3132cd6b3ccb\', \'multiverseId\': 133332}, \'multiverseid\': 133332}, {\'name\': \'五制術の聖騎士\', \'text\': \'側面攻撃 （側面攻撃を持たないいずれかのクリーチャーがこのクリーチャーをブロックするたび、そのブロックしているクリーチャーはターン終了時まで－１/－１の修整を受ける。）\\n五制術の聖騎士が場に出るに際し、色を１色選ぶ。\\n{W}{W}, {T}：選ばれた色のパーマネント１つを対象とし、それを破壊する。\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133633&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'668070ad-16ae-43b0-b560-719a0b17d950\', \'multiverseId\': 133633}, \'multiverseid\': 133633}, {\'name\': \'Paladino Pentocrata\', \'text\': \'Flanquear (Toda vez que uma criatura sem flanquear bloquear esta criatura, a criatura bloqueadora receberá -1/-1 até o final do turno.)\\nConforme Paladino Pentocrata entra em jogo, escolha uma cor.\\n{W}{W}, {T}: Destrua a permanente alvo da cor escolhida.\', \'type\': \'Criatura — Cavaleiro Humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133934&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'944bce3a-a1c2-420e-898f-764ff115b08b\', \'multiverseId\': 133934}, \'multiverseid\': 133934}, {\'name\': \'Пентархический Паладин\', \'text\': \'Обход (Когда существо без обхода блокирует это существо, тогда это блокирующее существо получает -1/-1 до конца хода.)\\nПри входе Пентархического Паладина в игру выберите цвет.\\n{W}{W}, {T}: Уничтожьте целевой перманент выбранного цвета.\', \'type\': \'Существо — Человек Рыцарь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134235&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3244db63-b50b-40fa-949d-35378d8833d0\', \'multiverseId\': 134235}, \'multiverseid\': 134235}, {\'name\': \'伍领神圣武士\', \'text\': \'侧面攻击（每当一个不具侧面攻击之生物阻挡此生物时，该阻挡生物得-1/-1直到回合结束。）\\n于伍领神圣武士进场时，选择一种颜色。\\n{W}{W}，{T}：消灭目标该色永久物。\', \'type\': \'生物～人类／骑士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132429&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'92dda298-4c66-4d0d-b807-f10cffc1bea4\', \'multiverseId\': 132429}, \'multiverseid\': 132429}]', "[{'name': 'Pentarchischer Schutz', 'text': 'Kreaturenverzauberung\\nSowie der Pentarchische Schutz ins Spiel kommt, bestimme eine Farbe.\\nWenn der Pentarchische Schutz ins Spiel kommt, ziehe eine Karte.\\nDie verzauberte Kreatur hat Schutz vor dieser Farbe. Dieser Effekt entfernt den Pentarchischen Schutz nicht.', 'type': 'Verzauberung — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133032&type=card', 'language': 'German', 'identifiers': {'scryfallId': '9faebcf0-135e-4dcd-85fd-119ae1da28a6', 'multiverseId': 133032}, 'multiverseid': 133032}, {'name': 'Guarda pentarca', 'text': 'Encantar criatura.\\nEn cuanto la Guarda pentarca entre en juego, elige un color.\\nCuando la Guarda pentarca entre en juego, roba una carta.\\nLa criatura encantada tiene protección contra el color elegido. Este efecto no remueve la Guarda pentarca.', 'type': 'Encantamiento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134537&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '562605d1-765f-4606-8871-d96528ebb771', 'multiverseId': 134537}, 'multiverseid': 134537}, {'name': 'Rune de garde du pentarque', 'text': 'Enchanter : créature\\nAu moment où la Rune de garde du pentarque arrive en jeu, choisissez une couleur.\\nQuand la Rune de garde du pentarque arrive en jeu, piochez une carte.\\nLa créature enchantée a la protection contre la couleur choisie. Cet effet ne retire pas la Rune de garde du pentarque.', 'type': 'Enchantement : aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132731&type=card', 'language': 'French', 'identifiers': {'scryfallId': '13833298-2273-40a8-9112-d3a5aca978fd', 'multiverseId': 132731}, 'multiverseid': 132731}, {'name': 'Sigillo del Pentarca', 'text': 'Incanta creatura\\nMentre il Sigillo del Pentarca entra in gioco, scegli un colore.\\nQuando il Sigillo del Pentarca entra in gioco, pesca una carta.\\nLa creatura incantata ha protezione dal colore scelto. Questo effetto non rimuove il Sigillo del Pentarca.', 'type': 'Incantesimo — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133333&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'e4388cb0-86a3-48e4-b2b1-75caebdab64f', 'multiverseId': 133333}, 'multiverseid': 133333}, {'name': '五制術の護法印', 'text': 'エンチャント（クリーチャー）\\n五制術の護法印が場に出るに際し、色を１色選ぶ。\\n五制術の護法印が場に出たとき、カードを１枚引く。\\nエンチャントされているクリーチャーは、選ばれた色に対するプロテクションを持つ。 この効果は五制術の護法印を取り除かない。', 'type': 'エンチャント — オーラ', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133634&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '1887420f-306f-43ff-bfac-af712303c4f1', 'multiverseId': 133634}, 'multiverseid': 133634}, {'name': 'Protetor Pentocrata', 'text': 'Encantar Criatura\\nConforme Protetor Pentocrata entra em jogo, escolha uma cor.\\nQuando Protetor Pentocrata entrar em jogo, compre um card.\\nA criatura encantada tem proteção contra a cor escolhida. Este efeito não remove Protetor Pentocrata.', 'type': 'Encantamento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133935&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '826d80bd-8b44-496a-8cb7-7d2ebc900a58', 'multiverseId': 133935}, 'multiverseid': 133935}, {'name': 'Пентархическая Опека', 'text': 'Зачаровать существо\\nПри входе Пентархической Опеки в игру выберите цвет.\\nКогда Пентархическая Опека входит в игру возьмите карту.\\nЗачарованное существо получает защиту от выбранного цвета. Этот эффект не снимает Пентархическую Опеку.', 'type': 'Чары — Аура', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134236&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '2bcebb3a-1dc1-4131-af9a-21796f4cc11d', 'multiverseId': 134236}, 'multiverseid': 134236}, {'name': '伍领守护', 'text': '生物结界\\n于伍领守护进场时，选择一种颜色。\\n当伍领守护进场时，抓一张牌。\\n受此结界的生物具有反该色保护异能。 此效应不会移除伍领守护。', 'type': '结界～灵气', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132430&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'ce132054-4f6f-41c3-bfb1-193e78c67b1d', 'multiverseId': 132430}, 'multiverseid': 132430}]", '[{\'name\': \'Pflanzensucher\', \'text\': \'{G}, {T}, wirf eine Karte aus deiner Hand ab: Durchsuche deine Bibliothek nach einem Standardland, zeige es offen vor und nimm es auf deine Hand. Mische danach deine Bibliothek.\', \'type\': \'Kreatur — Elf, Spruchwandler\', \'flavor\': \'„Das Gerücht entstand bei den Schlangen, murmelte durch die Gräser und gab den Suchenden Hoffnung: Die Göttin Freyalise wäre im Wolkenwald gesehen worden."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132959&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'99fa1447-1e50-44f4-ade0-b151fa77c6c5\', \'multiverseId\': 132959}, \'multiverseid\': 132959}, {\'name\': \'Buscadora de verde\', \'text\': \'{G}, {T}, descartar una carta: Busca en tu biblioteca una carta de tierra básica, muéstrala y ponla en tu mano. Luego baraja tu biblioteca.\', \'type\': \'Criatura — Cambiahechizos elfo\', \'flavor\': \'"Hay un rumor que se corre entre las serpientes, susurrado por los juncos, inspirando a los buscadores: la diosa Freyalise está viva y en Veloceleste."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134464&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a00c2b0f-436b-40f5-8e13-333d4e86e584\', \'multiverseId\': 134464}, \'multiverseid\': 134464}, {\'name\': \'Chercheuse de verdure\', \'text\': "{G}, {T}, défaussez-vous d\'une carte : Cherchez dans votre bibliothèque une carte de terrain de base, révélez-la, et mettez-la dans votre main. Mélangez ensuite votre bibliothèque.", \'type\': \'Créature : elfe et sortisan\', \'flavor\': \'« Une rumeur est sifflée par les serpents, murmurée par les joncs, réjouissant les chercheurs : la déesse Freyalise est en vie à Linciel. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132658&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'21da5f94-e0c8-4503-b87a-ce46c28fe5fa\', \'multiverseId\': 132658}, \'multiverseid\': 132658}, {\'name\': \'Cercatrice Verde\', \'text\': \'{G}, {T}, Scarta una carta: Passa in rassegna il tuo grimorio per una carta terra base, rivelala e aggiungila alla tua mano. Poi rimescola il tuo grimorio.\', \'type\': \'Creatura — Mutamagia Elfo\', \'flavor\': \'"Una voce circola tra i serpenti, sussurrata dai giunchi e che ispira i cercatori: la dea Freyalise è viva a Cielsudario."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133260&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c6154899-5899-4d0a-bb75-aafbef475c2a\', \'multiverseId\': 133260}, \'multiverseid\': 133260}, {\'name\': \'緑探し\', \'text\': \'{G}, {T}, カードを１枚捨てる：あなたのライブラリーから基本土地カードを１枚探し、それを公開してあなたの手札に加える。 その後あなたのライブラリーを切り直す。\', \'type\': \'クリーチャー — エルフ・スペルシェイパー\', \'flavor\': \'蛇たちの噂や急流の囁きが、捜し求める者に語りかけます。女神フレイアリーズはスカイシュラウドに生きているのです。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133561&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'916b5981-d3f0-4120-b4a4-8cf1f52495d5\', \'multiverseId\': 133561}, \'multiverseid\': 133561}, {\'name\': \'Busca-verde\', \'text\': \'{G}, {T}, Descarte um card: Procure em seu grimório por um card de terreno básico, revele-o e coloque-o em sua mão. Depois, embaralhe seu grimório.\', \'type\': \'Criatura — Magimodelador Elfo\', \'flavor\': \'"Há um rumor que passa por entre as cobras, sussurrado pelos ventos ligeiros, inspirando aqueles que buscam: a deusa Freyalise está viva em Skyshroud."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133862&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'10c31e78-8665-46ba-af3f-8e31c11e72c8\', \'multiverseId\': 133862}, \'multiverseid\': 133862}, {\'name\': \'Искатель Цветущих Земель\', \'text\': \'{G}, {T}, Сбросьте карту: Поищите в вашей библиотеке карту базовой земли, покажите ее и положите в свою руку. Затем перемешайте вашу библиотеку.\', \'type\': \'Существо — Эльф Заклинатель\', \'flavor\': \'«Сплетня распространялась среди змей, шипящих по камышам, вдохновляя искателей: Богиня Фреялиз все еще живет в Скайшрауде».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134163&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6ac4841b-a9ac-416f-8b9e-78d681d12257\', \'multiverseId\': 134163}, \'multiverseid\': 134163}, {\'name\': \'寻碧者\', \'text\': \'{G}，{T}，弃一张牌：从你的牌库中搜寻一张基本地牌，展示该牌，并将它置入你手上。 然后将你的牌库洗牌。\', \'type\': \'生物～地精／塑法师\', \'flavor\': \'「有个谣言在蛇间流传，河流窃语，振奋了寻碧者：妃雅丽兹女神好端端地待在天帷。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132357&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'39c249dc-876d-4745-abda-c7024923bff3\', \'multiverseId\': 132357}, \'multiverseid\': 132357}]', "[{'name': 'Phantomwurm', 'text': 'Der Phantomwurm kommt mit vier +1/+1-Marken ins Spiel.\\nFalls dem Phantomwurm Schaden zugefügt werden würde, verhindere diesen Schaden. Entferne eine +1/+1-Marke vom Phantomwurm.', 'type': 'Kreatur — Wurm, Geist', 'flavor': 'Er starb zusammen mit dem Wald, doch beide existieren noch in einer verdrehten Form.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133034&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b014d4e1-f51a-41dc-afdb-7a98f053f7c3', 'multiverseId': 133034}, 'multiverseid': 133034}, {'name': 'Sierpe fantasma', 'text': 'La Sierpe fantasma entra en juego con cuatro contadores +1/+1 sobre ella.\\nSi se le fuera a hacer daño a la Sierpe fantasma, prevén ese daño. Remueve un contador +1/+1 de la Sierpe fantasma.', 'type': 'Criatura — Espíritu sierpe', 'flavor': 'Murió con el bosque, sin embargo ambos permanecen en una forma retorcida.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134539&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '45f37efb-8e54-4cb4-8bcf-6728793386b8', 'multiverseId': 134539}, 'multiverseid': 134539}, {'name': 'Guivre fantomatique', 'text': 'La Guivre fantomatique arrive en jeu avec quatre marqueurs +1/+1 sur elle.\\nSi des blessures devaient être infligées à la Guivre fantomatique, prévenez ces blessures. Retirez un marqueur +1/+1 de la Guivre fantomatique.', 'type': 'Créature : guivre et esprit', 'flavor': 'Elle est morte avec la forêt, mais toutes deux existent encore sous cette forme corrompue.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132733&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'bdb6cf3b-5ace-4bf3-a045-e0f79e061fe6', 'multiverseId': 132733}, 'multiverseid': 132733}, {'name': 'Wurm Fantasma', 'text': 'Il Wurm Fantasma entra in gioco con quattro segnalini +1/+1 su di esso.\\nSe sta per essere inflitto danno al Wurm Fantasma, previeni quel danno. Rimuovi un segnalino +1/+1 dal Wurm Fantasma.', 'type': 'Creatura — Wurm Spirito', 'flavor': 'È morto con la foresta, però entrambi perdurano in forma contorta.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133335&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '20d111cb-bd7a-4133-94ef-e2b2865fe8f5', 'multiverseId': 133335}, 'multiverseid': 133335}, {'name': '幻影のワーム', 'text': '幻影のワームは、４個の＋１/＋１カウンターが置かれた状態で場に出る。\\n幻影のワームにダメージが与えられる場合、そのダメージをすべて軽減し、０にする。 幻影のワームから＋１/＋１カウンターを１個取り除く。', 'type': 'クリーチャー — ワーム・スピリット', 'flavor': 'それは森と共に死んだが、共にねじくれた姿で生き延び続けている。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133636&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'a8f74c21-8d40-45e9-8064-bc34a4d99fe2', 'multiverseId': 133636}, 'multiverseid': 133636}, {'name': 'Vorme Fantasma', 'text': 'Vorme Fantasma entra em jogo com quatro marcadores +1/+1 sobre ele.\\nSe algum dano seria causado a Vorme Fantasma, previna aquele dano. Remova um marcador +1/+1 de Vorme Fantasma.', 'type': 'Criatura — Espírito Vorme', 'flavor': 'Ele morreu com a floresta, mas ambos ainda permanecem ali de uma forma distorcida.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133937&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c3663883-8be1-407e-8b19-6e105d8d8323', 'multiverseId': 133937}, 'multiverseid': 133937}, {'name': 'Фантомный Червь', 'text': 'Фантомный Червь входит в игру с четырмя +1/+1 жетонами на нем.\\nЕсли повреждения должны быть нанесены Фантомному Червю, предотвратите эти повреждения. Снимите один +1/+1 жетон с Фантомного Червя.', 'type': 'Существо — Вурм Дух', 'flavor': 'Он умирал вместе с лесом, хотя они оба еще влачили жалкое совместное существование.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134238&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '0470ee50-0704-40c7-932b-33c37c76d6c0', 'multiverseId': 134238}, 'multiverseid': 134238}, {'name': '幽魅亚龙', 'text': '幽魅亚龙进场时上面有四个+1/+1指示物。\\n若幽魅亚龙将受到伤害，则防止该伤害。 从幽魅亚龙上移去一个+1/+1指示物。', 'type': '生物～亚龙／精怪', 'flavor': '他与树林一同死亡，却均以扭曲形式茍存。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132432&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'fe7dc08b-6e27-4fc0-8ef8-f1570db0783d', 'multiverseId': 132432}, 'multiverseid': 132432}]", '[{\'name\': \'Phyrexianisches Totem\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {B}.\\n{2}{B}: Das Phyrexianische Totem wird bis zum Ende des Zuges zu einer 5/5 schwarzen Schrecken-Artefaktkreatur, die Trampelschaden verursacht.\\nImmer wenn dem Phyrexianischen Totem Schaden zugefügt wird, opfere entsprechend viele bleibende Karten, falls es eine Kreatur ist.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133036&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3945d504-db81-429b-987d-8002ae39a89c\', \'multiverseId\': 133036}, \'multiverseid\': 133036}, {\'name\': \'Tótem pirexiano\', \'text\': \'{T}: Agrega {B} a tu reserva de maná.\\n{2}{B}: El Tótem pirexiano es una criatura artefacto Horror negra 5/5 con la habilidad de arrollar hasta el final del turno.\\nSiempre que el Tótem pirexiano reciba daño, sacrifica esa cantidad de permanentes.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134541&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4b2e8b04-e1f3-4b2b-b260-28a02d2de4a3\', \'multiverseId\': 134541}, \'multiverseid\': 134541}, {\'name\': \'Totem de Phyrexia\', \'text\': "{T} : Ajoutez {B} à votre réserve.\\n{2}{B} : Le Totem de Phyrexia devient une créature-artefact 5/5 noire Horreur avec le piétinement jusqu\'à la fin du tour.\\nÀ chaque fois que le Totem de Phyrexia subit des blessures, si c\'est une créature, sacrifiez autant de permanents.", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132735&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8b8f8918-1648-461b-9f95-6f1b5215181c\', \'multiverseId\': 132735}, \'multiverseid\': 132735}, {\'name\': \'Totem di Phyrexia\', \'text\': \'{T}: Aggiungi {B} alla tua riserva di mana.\\n{2}{B}: Il Totem di Phyrexia diventa una creatura artefatto Orrore 5/5 nera con travolgere fino alla fine del turno.\\nOgniqualvolta viene inflitto danno al Totem di Phyrexia, se è una creatura, sacrifica altrettanti permanenti.\', \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133337&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0f65ddd3-f0aa-4ea0-8701-d8d843811cd7\', \'multiverseId\': 133337}, \'multiverseid\': 133337}, {\'name\': \'ファイレクシアのトーテム像\', \'text\': \'{T}：あなたのマナ・プールに{B}を加える。\\n{2}{B}：ターン終了時まで、ファイレクシアのトーテム像はトランプルを持つ黒の５/５のホラー・アーティファクト・クリーチャーになる。\\nファイレクシアのトーテム像にダメージが与えられるたび、それがクリーチャーである場合、その点数に等しい数のパーマネントを生け贄に捧げる。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133638&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0666988e-5dd4-4b49-b091-694771447e2f\', \'multiverseId\': 133638}, \'multiverseid\': 133638}, {\'name\': \'Totem Phyrexiano\', \'text\': \'{T}: Adicione {B} à sua reserva de mana.\\n{2}{B}: Totem Phyrexiano torna-se uma criatura artefato preta 5/5 do tipo Horror com atropelar até o final do turno.\\nToda vez que Totem Phyrexiano sofrer dano, se for uma criatura, sacrifique aquela quantidade de permanentes.\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133939&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cdc4eed0-5586-48bd-98cb-acb524a9f6f5\', \'multiverseId\': 133939}, \'multiverseid\': 133939}, {\'name\': \'Фирексийский Тотем\', \'text\': \'{T}: Добавьте {B} в ваше хранилище маны.\\n{2}{B}: Фирексийский Тотем становится артефактным существом 5/5 черный Ужас до конца хода.\\nКогда Фирексийскому Тотему наносятся повреждения, если он существо, пожертвуйте такое же количество перманентов.\', \'type\': \'Артефакт\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134240&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b9cc2069-c1e1-4141-9007-e9ef89d90191\', \'multiverseId\': 134240}, \'multiverseid\': 134240}, {\'name\': \'非瑞克西亚图腾像\', \'text\': \'{T}：加{B}到你的法术力池中。\\n{2}{B}：非瑞克西亚图腾像成为5/5黑色，具践踏异能的惊惧兽神器生物直到回合结束。\\n每当非瑞克西亚图腾像兽到伤害时，若它是生物，则你牺牲等量的永久物。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132434&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1a026318-b2f5-4d93-b989-a795ab14e20c\', \'multiverseId\': 132434}, \'multiverseid\': 132434}]', '[{\'name\': \'Pilzgebiete\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}.\\n{1}, {T}: Lege eine Speichermarke auf die Pilzgebiete.\\n{1}, entferne X Speichermarken von den Pilzgebieten: Erhöhe deinen Manavorrat um X Mana einer beliebigen Kombination aus {R} und/oder {G}.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132945&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8cc135f2-bc1f-4677-931e-bef867e4f031\', \'multiverseId\': 132945}, \'multiverseid\': 132945}, {\'name\': \'Alturas fungosas\', \'text\': \'{T}: Agrega {1} a tu reserva de maná.\\n{1}, {T}: Pon un contador de almacenaje sobre las Alturas fungosas.\\n{1}, remover X contadores de almacenaje de las Alturas fungosas: Agrega X maná de cualquier combinación de {R} y/o {G} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134450&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5b04ce8f-906c-49a4-8722-6e2326111a5a\', \'multiverseId\': 134450}, \'multiverseid\': 134450}, {\'name\': \'Étendues fongoïdes\', \'text\': "{T} : Ajoutez {1} à votre réserve.\\n{1}, {T} : Mettez un marqueur « stock » sur les Étendues fongoïdes.\\n{1}, retirez X marqueurs « stock » des Étendues fongoïdes : Ajoutez X manas de n\'importe quelle combinaison de {R} et/ou {G} à votre réserve.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132644&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ac1706ca-b1c3-49b5-8879-c7b62eef70bf\', \'multiverseId\': 132644}, \'multiverseid\': 132644}, {\'name\': \'Distese Fungine\', \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana.\\n{1}, {T}: Metti un segnalino magazzino sulle Distese Fungine.\\n{1}, Rimuovi X segnalini magazzino dalle Distese Fungine: Aggiungi X mana in qualsiasi combinazione di {R} e/o {G} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133246&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8b5e4788-0211-4e88-854a-d5bc1318a083\', \'multiverseId\': 133246}, \'multiverseid\': 133246}, {\'name\': \'菌類の到達地\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。\\n{1}, {T}：菌類の到達地の上に蓄積カウンターを１個置く。\\n{1}, 菌類の到達地から蓄積カウンターをＸ個取り除く：Ｘ点の{R}か{G}（あるいはその組み合わせ）をあなたのマナ・プールに加える。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133547&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'81743c3e-34ea-464b-821e-fdac329c500a\', \'multiverseId\': 133547}, \'multiverseid\': 133547}, {\'name\': \'Regiões Fungosas\', \'text\': \'{T}: Adicione {1} à sua reserva de mana.\\n{1}, {T}: Coloque um marcador de estocagem sobre Regiões Fungosas.\\n{1}, Remova X marcadores de estocagem de Regiões Fungosas: Adicione X manas em qualquer combinação de {R} e/ou {G} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133848&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'382fac82-bea5-47be-b3a1-428b4c8d2783\', \'multiverseId\': 133848}, \'multiverseid\': 133848}, {\'name\': \'Грибные Угодья\', \'text\': \'{T}: Добавьте {1} в ваше хранилище маны.\\n{1}, {T}: Положите накопительный жетон на Грибные Угодья.\\n{1}, Удалите X накопительных жетонов с Грибных Угодий: Добавьте X маны в любых комбинациях {R} и/или {G} в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134149&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d19c6539-daef-4e19-a9de-5b9acf5958c2\', \'multiverseId\': 134149}, \'multiverseid\': 134149}, {\'name\': \'真菌地带\', \'text\': \'{T}：加{1}到你的法术力池中。\\n{1}，{T}：在真菌地带上放置一个储藏指示物。\\n{1}，从真菌地带上移去X个储藏指示物：加X点法术力到你的法术力池中，且为{R}和／或{G}的任意组合。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132343&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5450554d-9796-4089-94d1-df0886e3dfd7\', \'multiverseId\': 132343}, \'multiverseid\': 132343}]', '[{\'name\': \'Pilzremasuri\', \'text\': \'Alle Remasuris haben „Immer wenn dieser Kreatur Schaden zugefügt wird, lege eine +1/+1-Marke auf sie. (Der Schaden wird zugefügt, bevor die Marke auf sie gelegt wird.)\', \'type\': \'Kreatur — Pilzwesen, Remasuri\', \'flavor\': \'„Wenn ein Remasuri dieser Rasse zu einem Schwarm stößt, hacken die anderen wie wild aufeinander ein, um damit ein schnelleres Wachstum zu ermöglichen." —Rukarumel, Beobachtungskladde\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132946&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fd5ac8ed-c1cd-426e-a352-26b876646a19\', \'multiverseId\': 132946}, \'multiverseid\': 132946}, {\'name\': \'Fragmentado fungoso\', \'text\': \'Cada Fragmentado tiene "Siempre que esta criatura reciba daño, pon un contador +1/+1 sobre ella". (El daño se hace antes de que le pongas el contador.)\', \'type\': \'Criatura — Fragmentado hongo\', \'flavor\': \'"Cuando uno de estos fragmentados ingresa a la colmena, los otros se atacan mutuamente con frenesí, asegurándose así su rápido crecimiento." —Rúkarumel, diario de observación\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134451&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9e5c4949-9625-4745-847e-0d297d73f030\', \'multiverseId\': 134451}, \'multiverseid\': 134451}, {\'name\': \'Slivoïde fongoïde\', \'text\': \'Tous les slivoïdes ont « À chaque fois que cette créature subit des blessures, mettez un marqueur +1/+1 sur elle. » (Les blessures sont infligées avant le placement du marqueur.)\', \'type\': \'Créature : fongus et slivoïde\', \'flavor\': "« Quand un slivoïde de cette espèce entre dans l\'essaim, les autres se taillent mutuellement en pièces pour accélérer leur croissance. » —Rukarumel, journal de recherches", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132645&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'825b064f-469f-4c56-bd65-31c11ff70a37\', \'multiverseId\': 132645}, \'multiverseid\': 132645}, {\'name\': \'Tramutante Fungus\', \'text\': \'Tutti i Tramutanti hanno "Ogniqualvolta viene inflitto danno a questa creatura, metti un segnalino +1/+1 su di essa." (Il danno viene inflitto prima che venga messo il segnalino.)\', \'type\': \'Creatura — Tramutante Fungus\', \'flavor\': \'"Quando un tramutante di questa specie entra nell\\\'alveare, gli altri si graffiano tra loro con scatti frenetici, garantendo così la loro rapida crescita." —Rukarumel, registro delle attività\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133247&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'28238d11-87cb-4098-881b-71bb3857b667\', \'multiverseId\': 133247}, \'multiverseid\': 133247}, {\'name\': \'菌類スリヴァー\', \'text\': \'すべてのスリヴァーは「このクリーチャーにダメージが与えられるたび、それの上に＋１/＋１カウンターを１個置く。」の能力を持つ。（ダメージはカウンターを置く前に与えられる。）\', \'type\': \'クリーチャー — ファンガス・スリヴァー\', \'flavor\': \'この種のスリヴァーが巣に来ると、互いが互いに狂ったように爪を立て、素早い成長を行いだす。 ――ルカルメルの観察日誌\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133548&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b17b6a97-6d25-440a-b3af-56ea4eedace2\', \'multiverseId\': 133548}, \'multiverseid\': 133548}, {\'name\': \'Fractius do Fungo\', \'text\': \'Todos os Fractius têm "Toda vez que esta criatura sofrer dano, coloque um marcador +1/+1 sobre ela." (O dano é causado antes que o marcador seja colocado.)\', \'type\': \'Criatura — Fractius Fungo\', \'flavor\': \'"Quando um fractius dessa raça entra na colônia, os outros se agarram freneticamente, garantindo, dessa forma, seu rápido crescimento." —Rukarumel, diário de campo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133849&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8d948b0d-1467-41d6-9c5f-1fb4b836cde7\', \'multiverseId\': 133849}, \'multiverseid\': 133849}, {\'name\': \'Плесневая Щепка\', \'text\': \'Все Щепки обладают способностью "Когда это существо наносит повреждения, положите на него жетон +1/+1." (Повреждения наносятся до того как кладется жетон.)\', \'type\': \'Существо — Плесень Щепка\', \'flavor\': \'«Когда осколок из этого выводка попадает в рой, другие в бешеном порыве разрывают друг друга, чтобы расти больше и больше», Рукарумель, личный полевой дневник\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134150&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'00365958-1f0d-4cf7-852d-27026e4a30ad\', \'multiverseId\': 134150}, \'multiverseid\': 134150}, {\'name\': \'真菌裂片妖\', \'text\': \'所有裂片妖具有「每当此生物受到伤害时，在其上放置一个+1/+1指示物。」（先受到伤害，然后才放置指示物。）\', \'type\': \'生物～真菌／裂片妖\', \'flavor\': \'「当这种裂片妖进入母巢，其它裂片妖便开始狂乱地彼此互抓，藉以迅速成长。」 ～陆卡陆梅的现场日志\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132344&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d15bc5b6-0c38-474f-bf3d-18cd75b38656\', \'multiverseId\': 132344}, \'multiverseid\': 132344}]', "[{'name': 'Plattenpanzerpegasus', 'text': 'Aufblitzen (Du kannst diesen Zauberspruch zu jedem Zeitpunkt spielen, zu dem du einen Spontanzauber spielen könntest.)\\nFliegend\\nFalls ein Zauberspruch einer Kreatur oder einem Spieler Schadenspunkte zufügen würde, verhindere 1 Schadenspunkt, den dieser Zauberspruch dieser Kreatur bzw. diesem Spieler zufügen würde.', 'type': 'Kreatur — Pegasus', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133043&type=card', 'language': 'German', 'identifiers': {'scryfallId': '8f6e8b20-aa93-4d3f-9d80-21faae857cc0', 'multiverseId': 133043}, 'multiverseid': 133043}, {'name': 'Pegaso con placas', 'text': 'Destello (Puedes jugar este hechizo en cualquier momento en que pudieras jugar un instantáneo.)\\nVuela.\\nSi un hechizo fuera a hacer daño a una criatura o jugador, prevén 1 punto de daño que ese hechizo le fuera a hacer a esa criatura o jugador.', 'type': 'Criatura — Pegaso', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134548&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd1ace5e3-7c60-42e7-b0ae-bc1560205a83', 'multiverseId': 134548}, 'multiverseid': 134548}, {'name': 'Pégase à plaques', 'text': 'Flash (Vous pouvez jouer ce sort à tout moment où vous pourriez jouer un éphémère.)\\nVol\\nSi un sort devait infliger des blessures à une créature ou un joueur, prévenez 1 blessure que ce sort devait infliger à cette créature ou ce joueur.', 'type': 'Créature : pégase', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132742&type=card', 'language': 'French', 'identifiers': {'scryfallId': '3f46f65e-ccc5-4384-bc05-72eab6ba3527', 'multiverseId': 132742}, 'multiverseid': 132742}, {'name': 'Pegaso Catafratto', 'text': 'Lampo (Puoi giocare questa magia in ogni momento in cui potresti giocare un istantaneo.)\\nVolare\\nSe una magia sta per infliggere danno a una creatura o a un giocatore, previeni 1 danno che quella magia sta per infliggere a quella creatura o a quel giocatore.', 'type': 'Creatura — Pegaso', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133344&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '8b166b0d-7e28-47f3-8d45-8ab5b0817355', 'multiverseId': 133344}, 'multiverseid': 133344}, {'name': '板金鎧のペガサス', 'text': '瞬速 （あなたはこの呪文を、あなたがインスタントをプレイできるときならいつでもプレイしてよい。）\\n飛行\\nいずれかの呪文がいずれかのプレイヤーかクリーチャーにダメージを与える場合、その呪文がそのクリーチャーやプレイヤーに与えるダメージを１点軽減する。', 'type': 'クリーチャー — ペガサス', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133645&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '2261e1ed-419b-4169-82e2-1e10fc99c8bd', 'multiverseId': 133645}, 'multiverseid': 133645}, {'name': 'Pégaso de Couraça', 'text': 'Lampejo (Você poderá jogar esta mágica a qualquer momento em que puder jogar uma mágica instantânea.)\\nVoar\\nSe a mágica for causar dano a uma criatura ou jogador, previna 1 ponto de dano que aquela mágica causaria àquela criatura ou jogador.', 'type': 'Criatura — Pégaso', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133946&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '6764865f-42bf-4589-be17-cf77e3471bf7', 'multiverseId': 133946}, 'multiverseid': 133946}, {'name': 'Бронированный Пегас', 'text': 'Миг (Вы можете играть это заклинание в любое время когда вы можете играть мгновенные заклинания.)\\nПолет\\nЕсли заклинание должно нанести повреждения существу или игроку, предотвратите 1 провреждение, которое это заклинание должно нанести этому существу или игроку.', 'type': 'Существо — Пегас', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134247&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '6ef45aac-fbf1-452b-8ae5-268cf70959df', 'multiverseId': 134247}, 'multiverseid': 134247}, {'name': '板甲飞马', 'text': '闪现（你可以于你能够使用瞬间的时机下使用此咒语。）\\n飞行\\n若任一咒语将对生物或牌手造成伤害，则防止此咒语将对该生物或牌手造成的1点伤害。', 'type': '生物～飞马', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132441&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'e1516054-41fc-4f9a-be85-73656a92e87b', 'multiverseId': 132441}, 'multiverseid': 132441}]", '[{\'name\': \'Plötzliche Beeinträchtigung\', \'text\': \'Sekundenbruchteil (Solange dieser Zauberspruch sich auf dem Stapel befindet, können Spieler keine Zaubersprüche oder aktivierte Fähigkeiten spielen, die keine Manafähigkeiten sind.)\\nAlle Kreaturen, die ein Spieler deiner Wahl kontrolliert, werden bis zum Ende des Zuges 0/2 und verlieren alle ihre Eigenschaften.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133098&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ace22e79-4b66-40d7-be58-92594c91bba6\', \'multiverseId\': 133098}, \'multiverseid\': 133098}, {\'name\': \'Despojo súbito\', \'text\': \'Fracción de segundo (Mientras este hechizo esté en la pila, los jugadores no pueden jugar hechizos o habilidades activadas que no sean habilidades de maná.)\\nLas criaturas que controla el jugador objetivo son 0/2 y pierden todas sus habilidades hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134603&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'43cffeab-3cc9-4be9-9a93-d203d2a9fd23\', \'multiverseId\': 134603}, \'multiverseid\': 134603}, {\'name\': \'Déliquescence soudaine\', \'text\': "Fraction de seconde (Tant que ce sort est sur la pile, les joueurs ne peuvent pas jouer de sorts ou de capacités activées qui ne sont pas des capacités de mana.)\\nLes créatures que le joueur ciblé contrôle deviennent 0/2 et perdent toutes leurs capacités jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132797&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'25f0de48-d038-47b4-a3ae-d6dfdfdb02e8\', \'multiverseId\': 132797}, \'multiverseid\': 132797}, {\'name\': \'Deperimento Improvviso\', \'text\': \'Battibaleno (Fintanto che questa magia è in pila, i giocatori non possono giocare magie o abilità attivate che non siano abilità di mana.)\\nLe creature controllate da un giocatore bersaglio diventano 0/2 e perdono tutte le abilità fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133399&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ae419d81-b14a-4fa7-a917-a5b6368d13af\', \'multiverseId\': 133399}, \'multiverseid\': 133399}, {\'name\': \'突然の俗化\', \'text\': \'刹那 （この呪文がスタックにあるかぎり、プレイヤーは呪文やマナ能力でない起動型能力をプレイできない。）\\nプレイヤー１人を対象とする。ターン終了時まで、そのプレイヤーがコントロールするクリーチャーは０/２になるとともにすべての能力を失う。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133700&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0af06570-f915-401e-a4e5-15ccd4f5c44e\', \'multiverseId\': 133700}, \'multiverseid\': 133700}, {\'name\': \'Estrago Repentino\', \'text\': \'Fração de segundo (Enquanto esta mágica estiver na pilha, os jogadores não poderão jogar mágicas ou habilidades ativadas que não sejam habilidades de mana.)\\nAs criaturas que o jogador alvo controla se tornam 0/2 e perdem todas as habilidades até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134001&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8e9c5729-c5b0-47c6-b892-a7073b990265\', \'multiverseId\': 134001}, \'multiverseid\': 134001}, {\'name\': \'Внезапная Порча\', \'text\': \'Мгновение ока (До тех пор пока это заклинание находится в стеке, игроки не могут играть заклинания или активируемые способности, которые не являются мана-способностями.)\\nСущества под контролем целевого игрока становятся 0/2 и теряют все свои способности до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134302&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7811e0eb-f526-4968-954a-75bc304a0d0d\', \'multiverseId\': 134302}, \'multiverseid\': 134302}, {\'name\': \'瞬息腐坏\', \'text\': \'转瞬（只要此咒语在堆叠上，牌手便不能使用咒语或不是法术力异能的起动式异能。）\\n直到回合结束，由目标牌手操控的生物成为0/2且失去所有异能。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132496&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0eb06dcd-8d85-487f-9650-3e280da9d607\', \'multiverseId\': 132496}, \'multiverseid\': 132496}]', '[{\'name\': \'Plötzlicher Schock\', \'text\': \'Sekundenbruchteil (Solange dieser Zauberspruch sich auf dem Stapel befindet, können Spieler keine Zaubersprüche oder aktivierte Fähigkeiten spielen, die keine Manafähigkeiten sind.)\\nPlötzlicher Schock fügt einer Kreatur oder einem Spieler deiner Wahl 2 Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'Lichtbogenmagier sind nicht gerade für ihre Geduld berüchtigt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133097&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5bff0c3a-2d50-4266-a9aa-2489e44a96ff\', \'multiverseId\': 133097}, \'multiverseid\': 133097}, {\'name\': \'Choque súbito\', \'text\': \'Fracción de segundo (Mientras este hechizo esté en la pila, los jugadores no pueden jugar hechizos o habilidades activadas que no sean habilidades de maná.)\\nEl Choque súbito hace 2 puntos de daño a la criatura o jugador objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'Los magos de arcos no son conocidos por su paciencia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134602&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4c823648-b53c-4097-8c21-6cf30642bc7e\', \'multiverseId\': 134602}, \'multiverseid\': 134602}, {\'name\': \'Choc soudain\', \'text\': \'Fraction de seconde (Tant que ce sort est sur la pile, les joueurs ne peuvent pas jouer de sorts ou de capacités activées qui ne sont pas des capacités de mana.)\\nLe Choc soudain inflige 2 blessures à une cible, créature ou joueur.\', \'type\': \'Éphémère\', \'flavor\': "Les mages à l\'arc de feu ne sont pas connus pour leur patience.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132796&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2d2ecf95-8c91-4259-87cf-1997f9ee02db\', \'multiverseId\': 132796}, \'multiverseid\': 132796}, {\'name\': \'Shock Improvviso\', \'text\': \'Battibaleno (Fintanto che questa magia è in pila, i giocatori non possono giocare magie o abilità attivate che non siano abilità di mana.)\\nLo Shock Improvviso infligge 2 danni a una creatura o a un giocatore bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'Gli arcimaghi non sono rinomati per la loro pazienza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133398&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2e4b2005-9dd0-4570-9e23-e2c943d05c3a\', \'multiverseId\': 133398}, \'multiverseid\': 133398}, {\'name\': \'突然のショック\', \'text\': \'刹那 （この呪文がスタックにあるかぎり、プレイヤーは呪文やマナ能力でない起動型能力をプレイできない。）\\nクリーチャー１体かプレイヤー１人を対象とする。突然のショックはそれに２点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'弧炎の魔道士ほど、辛抱が似合わない者達はいない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133699&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2c6612bd-2ef2-4747-80b2-4427b85047a4\', \'multiverseId\': 133699}, \'multiverseid\': 133699}, {\'name\': \'Choque Repentino\', \'text\': \'Fração de segundo (Enquanto esta mágica estiver na pilha, os jogadores não poderão jogar mágicas ou habilidades ativadas que não sejam habilidades de mana.)\\nChoque Repentino causa 2 pontos de dano à criatura alvo ou ao jogador alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os magos do Arco não são conhecidos por sua paciência.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134000&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f78aed8d-daf4-4421-8302-aad2f41abbb7\', \'multiverseId\': 134000}, \'multiverseid\': 134000}, {\'name\': \'Внезапный Шок\', \'text\': \'Мгновение ока (До тех пор пока это заклинание находится в стеке, игроки не могут играть заклинания или активируемые способности, которые не являются мана-способностями.)\\nВнезапный Шок наносит 2 повреждения целевому существу или игроку.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Верховные маги не знали устали.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134301&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3dc86990-c5e5-4bcf-98d1-1cf692d62553\', \'multiverseId\': 134301}, \'multiverseid\': 134301}, {\'name\': \'瞬息电震\', \'text\': \'转瞬（只要此咒语在堆叠上，牌手便不能使用咒语或不是法术力异能的起动式异能。）\\n瞬息电震对目标生物或牌手造成2点伤害。\', \'type\': \'瞬间\', \'flavor\': \'电弧法师当然不以耐心闻名。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132495&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cfe2c2f1-e6b1-47ec-96ce-23502eb677f9\', \'multiverseId\': 132495}, \'multiverseid\': 132495}]', '[{\'name\': \'Plötzlicher Tod\', \'text\': \'Sekundenbruchteil (Solange dieser Zauberspruch sich auf dem Stapel befindet, können Spieler keine Zaubersprüche oder aktivierte Fähigkeiten spielen, die keine Manafähigkeiten sind.)\\nEine Kreatur deiner Wahl erhält -4/-4 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'Manche Magier bemächtigten sich der Risse im Zeitgefüge, um anderen alternative Zeitstränge aufzuzwingen, in denen sie von unvorstellbarem Schrecken gepeinigt werden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133096&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'48d541ae-d99f-4636-9886-50ce66c72c7c\', \'multiverseId\': 133096}, \'multiverseid\': 133096}, {\'name\': \'Muerte súbita\', \'text\': \'Fracción de segundo (Mientras este hechizo esté en la pila, los jugadores no pueden jugar hechizos o habilidades activadas que no sean habilidades de maná.)\\nLa criatura objetivo obtiene -4/-4 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'Algunos magos juguetearon con las brechas temporales, forzando otras líneas temporales alternativas en las que acontecían horrores inimaginables.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134601&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7d5dce55-ab72-47c1-8993-1c16b1f1ef23\', \'multiverseId\': 134601}, \'multiverseid\': 134601}, {\'name\': \'Mort soudaine\', \'text\': "Fraction de seconde (Tant que ce sort est sur la pile, les joueurs ne peuvent pas jouer de sorts ou de capacités activées qui ne sont pas des capacités de mana.)\\nLa créature ciblée gagne -4/-4 jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': \'Certains mages utilisaient les lignes de temps alternatives pour faire subir les horreurs les plus inimaginables à leurs ennemis.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132795&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ef08d536-d56c-400a-9083-48462f739470\', \'multiverseId\': 132795}, \'multiverseid\': 132795}, {\'name\': \'Morte Improvvisa\', \'text\': \'Battibaleno (Fintanto che questa magia è in pila, i giocatori non possono giocare magie o abilità attivate che non siano abilità di mana.)\\nUna creatura bersaglio prende -4/-4 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'Alcuni maghi attinsero agli squarci temporali, forzando su altri linee temporali alternative in cui subiscono orrori impensabili.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133397&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2935fecd-1c23-41eb-9386-016a26fac9ce\', \'multiverseId\': 133397}, \'multiverseid\': 133397}, {\'name\': \'突然の死\', \'text\': \'刹那 （この呪文がスタックにあるかぎり、プレイヤーは呪文やマナ能力でない起動型能力をプレイできない。）\\nクリーチャー１体を対象とする。それはターン終了時まで－４/－４の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'魔道士の中には、時の裂け目の中に入り込み、他人の時の流れを変えて想像もできないような恐怖が彼らの上に襲い掛かるようにする者もいた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133698&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'45185f0e-ffd2-40ed-88d9-6ba5f3617a2b\', \'multiverseId\': 133698}, \'multiverseid\': 133698}, {\'name\': \'Morte Repentina\', \'text\': \'Fração de segundo (Enquanto esta mágica estiver na pilha, os jogadores não poderão jogar mágicas ou habilidades ativadas que não sejam habilidades de mana.)\\nA criatura alvo recebe -4/-4 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Alguns magos golpearam as fendas do tempo, impondo outras linhas do tempo alternativas, onde horrores inimagináveis lhes sucederam.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133999&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b72f80b3-57ae-40d3-b9a2-0682231e03cc\', \'multiverseId\': 133999}, \'multiverseid\': 133999}, {\'name\': \'Внезапная Смерть\', \'text\': \'Мгновение ока (До тех пор пока это заклинание находится в стеке, игроки не могут играть заклинания или активируемые способности, которые не являются мана-способностями.)\\nЦелевое существо получает -4/-4 до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Многие маги погибали во временном разломе, перескакивая из одной временной линии в другую, где невообразимые ужасы уничтожали их.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134300&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1446dfc1-b6c9-406e-bcac-ef54b44c531b\', \'multiverseId\': 134300}, \'multiverseid\': 134300}, {\'name\': \'骤死\', \'text\': \'转瞬（只要此咒语在堆叠上，牌手便不能使用咒语或不是法术力异能的起动式异能。）\\n目标生物得-4/-4直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'某些法师陷身时间裂缝，因此逼迫他人替换掉恐怖地影响自己的时间流。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132494&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'68f7f6b2-c9aa-4f46-bc1e-ae42ce6d0793\', \'multiverseId\': 132494}, \'multiverseid\': 132494}]', "[{'name': 'Prismalinse', 'text': '{T}: Erhöhe deinen Manavorrat um {1}.\\n{1},{T}: Erhöhe deinen Manavorrat um ein Mana einer beliebigen Farbe.', 'type': 'Artefakt', 'flavor': 'Sie bricht nicht Licht, sondern Mana, und formt dessen chaotische Strömungen in die festen Formen, die beim Zaubern benötigt werden.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133047&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'aa8a4535-5009-4dae-a3c5-1ae69509a5fe', 'multiverseId': 133047}, 'multiverseid': 133047}, {'name': 'Lente prismático', 'text': '{T}: Agrega {1} a tu reserva de maná.\\n{1}, {T}: Agrega un maná de cualquier color a tu reserva de maná.', 'type': 'Artefacto', 'flavor': 'No tuerce la luz sino el maná, alineando las corrientes caóticas en los ángulos necesarios para los propósitos místicos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134552&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '27ea2551-5f19-4efb-ad8e-480fdc10f6a9', 'multiverseId': 134552}, 'multiverseid': 134552}, {'name': 'Lentille prismatique', 'text': '{T} : Ajoutez {1} à votre réserve.\\n{1}, {T} : Ajoutez un mana de la couleur de votre choix à votre réserve.', 'type': 'Artefact', 'flavor': 'Elle ne canalise pas la lumière, mais le mana, alignant ses courants chaotiques pour obtenir les angles nécessaires aux objectifs du mystique.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132746&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'be991983-f4fb-4797-82f2-6dc61e3d4e88', 'multiverseId': 132746}, 'multiverseid': 132746}, {'name': 'Lente Prismatica', 'text': '{T}: Aggiungi {1} alla tua riserva di mana.\\n{1}, {T}: Aggiungi un mana di qualsiasi colore alla tua riserva di mana.', 'type': 'Artefatto', 'flavor': 'Non piega la luce ma il mana, allineandone le correnti caotiche in nette svolte necessarie ai fini del mistico.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133348&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3a5977f4-8a54-47ee-9cfc-6ecf64d709ac', 'multiverseId': 133348}, 'multiverseid': 133348}, {'name': '虹色のレンズ', 'text': '{T}：あなたのマナ・プールに{1}を加える。\\n{1}, {T}：あなたのマナ・プールに、好きな色１色のマナ１点を加える。', 'type': 'アーティファクト', 'flavor': 'それは光ではなくマナを曲げ、乱れた流れを神秘的な目的のために鋭い角度へと整列させる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133649&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'd558395e-15ed-4677-a6e2-8c4851c8d1cb', 'multiverseId': 133649}, 'multiverseid': 133649}, {'name': 'Lente Prismática', 'text': '{T}: Adicione {1} à sua reserva de mana.\\n{1}, {T}: Adicione um mana de qualquer cor à sua reserva de mana.', 'type': 'Artefato', 'flavor': 'Ela converte não luz, mas mana, alinhando suas correntes caóticas nos ângulos precisos necessários para os propósitos místicos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133950&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9380c64c-0fe8-4ba5-9750-d8468d0beb69', 'multiverseId': 133950}, 'multiverseid': 133950}, {'name': 'Призматические Линзы', 'text': '{T}: Добавьте {1} в ваше хранилище маны.\\n{1}, {T}: Добавьте одну ману любого цвета в ваше хранилище маны.', 'type': 'Артефакт', 'flavor': 'Они преломляли не свет, но ману, выравнивая ее хаотическое течение под острыми углами, требующимися для мистических целей.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134251&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '03adfd75-1a66-4419-aaaf-117beb38f9a0', 'multiverseId': 134251}, 'multiverseid': 134251}, {'name': '虹彩透镜', 'text': '{T}：加{1}到你的法术力池中。\\n{1}，{T}：加一点任意颜色的法术力到你的法术力池中。', 'type': '神器', 'flavor': '它所扭曲者并非光线，而是法术力，依秘教徒之需求将其混沌流向调校至适当锐角。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132445&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '84c05492-6c2d-4544-b6c3-97bf630c7d06', 'multiverseId': 132445}, 'multiverseid': 132445}]", '[{\'name\': \'Psionischer Remasuri\', \'text\': \'Alle Remasuris haben „{T}: Diese Kreatur fügt einer Kreatur oder einem Spieler deiner Wahl 2 Schadenspunkte und sich selbst 3 Schadenspunkte zu.\', \'type\': \'Kreatur — Remasuri\', \'flavor\': \'Sie entwickelten die Fähigkeit, ihre ganze neurale Energie in einen einzelnen Pulsschlag zu konzentrieren und damit einen zerstörerischen, aber meist auch selbstmörderischen Strahl psionischer Energie zu erzeugen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133048&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a26b2ce2-ae1f-4c69-b9e1-7bdc07ab0e82\', \'multiverseId\': 133048}, \'multiverseid\': 133048}, {\'name\': \'Fragmentado psiónico\', \'text\': \'Todos los Fragmentados tienen "{T}: Esta criatura hace 2 puntos de daño a la criatura o jugador objetivo y 3 puntos de daño a sí misma".\', \'type\': \'Criatura — Fragmentado\', \'flavor\': \'Evolucionaron la habilidad para concentrar su actividad neuronal en un único pulso, que causa una disruptiva ráfaga de energía psiónica que normalmente les resulta suicida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134553&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d271b8d9-b9e0-4287-aec2-20372fd1c68c\', \'multiverseId\': 134553}, \'multiverseid\': 134553}, {\'name\': \'Slivoïde psionique\', \'text\': "Tous les slivoïdes ont « {T} : Cette créature inflige 2 blessures à une cible, créature ou joueur, et s\'inflige 3 blessures. »", \'type\': \'Créature : slivoïde\', \'flavor\': "L\'évolution leur a donné la capacité de concentrer leur activité neurale en une pulsation, provoquant une explosion d\'énergie psionique généralement suicidaire.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132747&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b3b835c4-d9fa-4fa4-ad90-3a84e0f90698\', \'multiverseId\': 132747}, \'multiverseid\': 132747}, {\'name\': \'Tramutante Psionico\', \'text\': \'Tutti i Tramutanti hanno "{T}: Questa creatura infligge 2 danni a una creatura o a un giocatore bersaglio e 3 danni a se stessa."\', \'type\': \'Creatura — Tramutante\', \'flavor\': "Svilupparono la capacità di concentrare la loro attività neurale in un\'unica pulsazione, provocando un\'esplosione di energia psionica distruttiva, ma insolitamente suicida.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133349&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a5c7d015-5615-4533-8ecd-a4ed2a9b0d25\', \'multiverseId\': 133349}, \'multiverseid\': 133349}, {\'name\': \'心霊スリヴァー\', \'text\': \'すべてのスリヴァーは「{T}：クリーチャー１体かプレイヤー１人を対象とする。このクリーチャーはそれに２点のダメージを与え、自身に３点のダメージを与える。」の能力を持つ。\', \'type\': \'クリーチャー — スリヴァー\', \'flavor\': \'それは自身の神経作用を集中させてひとつの波動とする能力を進化で手に入れた。破壊的ではあるが、大抵は精神エネルギーにより自爆する羽目になる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133650&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fb5de9e3-4bb7-4c7f-973b-2da489135730\', \'multiverseId\': 133650}, \'multiverseid\': 133650}, {\'name\': \'Fractius Psíquico\', \'text\': \'Todos os Fractius têm "{T}: Esta criatura causa 2 pontos de dano à criatura alvo ou ao jogador alvo e 3 pontos de dano a ela mesma."\', \'type\': \'Criatura — Fractius\', \'flavor\': \'Eles desenvolveram a habilidade de concentrar sua atividade neural em uma única pulsação, causando uma explosão destruidora, mas geralmente suicida de energia psíquica.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133951&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5bdf9ef4-11ba-4249-b8ab-950c7033b521\', \'multiverseId\': 133951}, \'multiverseid\': 133951}, {\'name\': \'Психическая Щепка\', \'text\': \'Все Щепки обладают способностью "{T}: Это существо наносит 2 повреждения целевому существу или игроку и 3 повреждения себе."\', \'type\': \'Существо — Щепка\', \'flavor\': \'Они развили способность концентрировать свою нейроактивность в едином импульсе, вызывая разрушительный, но обычно самоубийственный выброс психической энергии.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134252&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a5c8ab9d-1295-4618-b71e-d4ac8e50dea5\', \'multiverseId\': 134252}, \'multiverseid\': 134252}, {\'name\': \'灵能裂片妖\', \'text\': \'所有裂片妖具有「{T}：此生物对目标生物或牌手造成2点伤害，并且对本身造成3点伤害。」\', \'type\': \'生物～裂片妖\', \'flavor\': \'他们演化出的能力，能将其神经活动专注至同一脉动，造成裂物且自毁的灵能冲击。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132446&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cb0f4cd5-e95d-4b1b-8e5e-cbc07326aa06\', \'multiverseId\': 132446}, \'multiverseid\': 132446}]', "[{'name': 'Psychotischer Anfall', 'text': 'Ein Spieler deiner Wahl zeigt die Karten auf seiner Hand und die oberste Karte seiner Bibliothek offen vor. Du bestimmst eine der auf diese Weise vorgezeigten Karten. Dieser Spieler legt die bestimmte Karte unter seine Bibliothek.\\nWahnsinn {1}{B} (Falls du diese Karte aus deiner Hand abwirfst, kannst du sie für ihre Wahnsinn-Kosten spielen, anstatt sie auf deinen Friedhof zu legen.)', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133049&type=card', 'language': 'German', 'identifiers': {'scryfallId': '7ea5aaea-3ee4-4ca7-a32a-63665ed3d2c5', 'multiverseId': 133049}, 'multiverseid': 133049}, {'name': 'Episodio psicótico', 'text': 'El jugador objetivo muestra su mano y la primera carta de su biblioteca. Elige una carta mostrada de esta manera. Ese jugador pone la carta elegida en la parte inferior de su biblioteca.\\nDemencia {1}{B} (Si descartas esta carta, puedes jugarla por su coste de demencia en vez de ponerla en tu cementerio.)', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134554&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'bae105a4-86f7-4617-b2c7-65ab8cfd21c5', 'multiverseId': 134554}, 'multiverseid': 134554}, {'name': 'Épisode psychotique', 'text': 'Le joueur ciblé révèle sa main et la carte du dessus de sa bibliothèque. Vous choisissez une carte révélée de cette manière. Ce joueur met la carte choisie au-dessous de sa bibliothèque.\\nFolie {1}{B} (Si vous vous défaussez de cette carte, vous pouvez la jouer pour son coût de folie à la place de la mettre dans votre cimetière.)', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132748&type=card', 'language': 'French', 'identifiers': {'scryfallId': '7337cd64-7fa7-4d0c-9ab4-ebc6d4bb9a40', 'multiverseId': 132748}, 'multiverseid': 132748}, {'name': 'Episodio Psicotico', 'text': 'Un giocatore bersaglio rivela la propria mano e la prima carta del proprio grimorio. Scegli una carta rivelata in questo modo. Quel giocatore mette la carta scelta in fondo al proprio grimorio.\\nFollia {1}{B} (Se scarti questa carta, puoi giocarla pagando il suo costo di follia invece di metterla nel tuo cimitero.)', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133350&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'f6abc2d1-f183-4833-bb19-88433e348b29', 'multiverseId': 133350}, 'multiverseid': 133350}, {'name': '病的な出来事', 'text': 'プレイヤー１人を対象とする。そのプレイヤーは自分の手札と自分のライブラリーの一番上のカードを公開する。 あなたはこれにより公開されたカードから１枚を選ぶ。 そのプレイヤーは選ばれたカードを自分のライブラリーの一番下に置く。\\nマッドネス {1}{B} （あなたがこのカードを捨てる場合、あなたはそれをあなたの墓地に置く代わりに、マッドネス・コストでそれをプレイしてもよい。）', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133651&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '72748917-a8c3-4d86-b74e-aba24b095cad', 'multiverseId': 133651}, 'multiverseid': 133651}, {'name': 'Episódio Psicótico', 'text': 'O jogador alvo revela sua própria mão e o card do topo de seu grimório. Você escolhe um card revelado deste modo. Aquele jogador coloca o card escolhido no fundo de seu grimório.\\nLoucura {1}{B} (Se descartar este card, você poderá jogá-lo pagando seu custo de loucura, em vez de colocá-lo em seu cemitério.)', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133952&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '25edb429-c3d0-42a7-a152-c1190e94722e', 'multiverseId': 133952}, 'multiverseid': 133952}, {'name': 'Психотический эпизод', 'text': 'Целевой игрок показывает свою руку и верхнюю карту своей библиотеки. Вы выбираете одну карту, показанную таким путем. Этот игрок кладет выбранную карту под низ своей библиотеки.\\nБешенство {1}{B} (Если вы сбрасываете эту карту, вы можете сыграть ее за ее стоимость бешенства вместо того чтобы положить ее на ваше кладбище.)', 'type': 'Волшебство', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134253&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'e3b0991a-4303-4aec-a73d-28244ce46801', 'multiverseId': 134253}, 'multiverseid': 134253}, {'name': '丧神片段', 'text': '目标牌手展示其手牌与其牌库顶牌。 你选择以此法展示的一张牌。 该牌手将此牌置于其牌库底。\\n疯魔{1}{B}（如果你弃掉此牌，可以改为使用它并支付其疯魔费用，而非直接将它置入你的坟墓场。）', 'type': '法术', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132447&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a7abd97f-4a16-4fa5-b0b7-cedc2c36631b', 'multiverseId': 132447}, 'multiverseid': 132447}]", '[{\'name\': \'Ranken des Zerfalls\', \'text\': \'Die Ranken des Zerfalls fügen einer Kreatur deiner Wahl X Schadenspunkte zu und du erhältst X Lebenspunkte dazu, wobei X gleich der Anzahl an Sümpfen ist, die du kontrollierst.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Selbst Sümpfe brauchen Nahrung. Wir kümmern uns darum, und im Gegenzug ernähren sie uns." —Ezrith, Druide der Dunklen Stunden\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133110&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7b1c9ac3-0ba6-4875-b48c-cad72da3dd6c\', \'multiverseId\': 133110}, \'multiverseid\': 133110}, {\'name\': \'Zarcillos de corrupción\', \'text\': \'Los Zarcillos de corrupción hacen X puntos de daño a la criatura objetivo y tú ganas X vidas, donde X es el número de pantanos que controlas.\', \'type\': \'Instantáneo\', \'flavor\': \'"Hasta los pantanos necesitan sustento. Se lo daremos, y ellos a cambio nos darán sustento a nosotros." —Ezrith, druida de las Horas Sombrías\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134615&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'59614b85-ec0a-4c7f-b0ae-a50ab6a77247\', \'multiverseId\': 134615}, \'multiverseid\': 134615}, {\'name\': \'Vrilles de corruption\', \'text\': \'Les Vrilles de corruption infligent X blessures à une créature ciblée et vous gagnez X points de vie, X étant le nombre de marais que vous contrôlez.\', \'type\': \'Éphémère\', \'flavor\': "« Même les marais doivent s\'alimenter. Nous leur donnerons pitance et en échange, ils nous nourriront. » —Ezrith, druide des Heures sombres", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132809&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5129b16e-8c99-4a62-8c34-b503c3464310\', \'multiverseId\': 132809}, \'multiverseid\': 132809}, {\'name\': \'Tentacoli della Corruzione\', \'text\': \'I Tentacoli della Corruzione infliggono X danni a una creatura bersaglio e guadagni X punti vita, dove X è pari al numero di Paludi che controlli.\', \'type\': \'Istantaneo\', \'flavor\': \'"Anche le paludi hanno bisogno di nutrimento. Noi glielo daremo e, in cambio, esse ci nutriranno." —Ezrith, druido delle Ore Buie\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133411&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2f5565a2-4b11-4145-aec8-3016ac4ebfc8\', \'multiverseId\': 133411}, \'multiverseid\': 133411}, {\'name\': \'堕落の触手\', \'text\': \'クリーチャー１体を対象とする。堕落の触手はそれにＸ点のダメージを与え、あなたはＸ点のライフを得る。Ｘはあなたがコントロールする沼の総数に等しい。\', \'type\': \'インスタント\', \'flavor\': \'沼ですら滋養が必要なのだ。 それを与えれば、代わりに我らにも滋養を与えてくれよう。 ――暗刻教団のドルイド僧、エズリス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133712&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d7116cf5-cc59-47a6-b098-7da33f0c129b\', \'multiverseId\': 133712}, \'multiverseid\': 133712}, {\'name\': \'Gavinhas da Corrupção\', \'text\': \'Gavinhas da Corrupção causa X pontos de dano à criatura alvo e você ganha X pontos de vida, sendo X igual ao número de Pântanos que você controla.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Até mesmo os pântanos precisam de sustento. Nós lhe daremos isso e, em retorno, eles nos sustentarão." —Ezrith, druida das Horas Sombrias\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134013&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4736eaf8-7361-4c87-b005-a4513681e281\', \'multiverseId\': 134013}, \'multiverseid\': 134013}, {\'name\': \'Усики Гнили\', \'text\': \'Усики Гнили наносят X повреждений целевому существу, и вы получаете X жизней, где X число Болот под вашим контролем.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Даже болота нуждаются в пропитании. Мы дадим им это, а взамен они защитят нас», Эзрит, Друид Темных времен\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134314&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'25636d18-7772-4d5c-818f-a424d7cdbe4e\', \'multiverseId\': 134314}, \'multiverseid\': 134314}, {\'name\': \'腐化卷须\', \'text\': \'腐化卷须对目标生物造成X点伤害且你获得X点生命，X为由你操控的沼泽之数量。\', \'type\': \'瞬间\', \'flavor\': \'「即使沼泽也需要养分。 我们将为其提供，而沼泽也将支持我们以为回报。」 ～黯刻德鲁伊易季司\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132508&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'01905c18-8067-4cd8-b742-022726ad19c4\', \'multiverseId\': 132508}, \'multiverseid\': 132508}]', '[{\'name\': \'Riedgrasremasuri\', \'text\': \'Alle Remasuris haben „Diese Kreatur erhält +1/+1, solange du einen Sumpf kontrollierst" und „{B}: Regeneriere diese Kreatur".\', \'type\': \'Kreatur — Remasuri\', \'flavor\': \'Ihr Fleisch ist so weich wie die Moore, in denen sie leben. Es sickert, um Wunden zu verstopfen, und es zieht sich zusammen, um Schläge abzumildern.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133068&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3b29b9ed-5a00-440b-be8a-0fe88098dd63\', \'multiverseId\': 133068}, \'multiverseid\': 133068}, {\'name\': \'Fragmentado de los juncos\', \'text\': \'Todos los Fragmentados tienen "Esta criatura obtiene +1/+1 mientras controles un pantano" y "{B}: Regenera esta criatura".\', \'type\': \'Criatura — Fragmentado\', \'flavor\': \'Su carne es tan pastosa como las ciénagas en las que viven: chorrea para cerrar cualquier herida y se hunde para absorber cualquier golpe.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134573&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'708817c1-47f0-4ae6-81bc-5b5fd3ac31fc\', \'multiverseId\': 134573}, \'multiverseid\': 134573}, {\'name\': \'Slivoïde des laîches\', \'text\': \'Tous les slivoïdes ont « Cette créature gagne +1/+1 tant que vous contrôlez un marais » et « {B} : Régénérez cette créature. »\', \'type\': \'Créature : slivoïde\', \'flavor\': \'Leur chair est aussi détrempée que les marécages dans lesquels ils vivent. Ils suintent pour panser leurs blessures et absorbent les coups comme des éponges.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132767&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fccb0960-1a5d-41b7-b2e9-9c78f0f7621b\', \'multiverseId\': 132767}, \'multiverseid\': 132767}, {\'name\': \'Tramutante del Falasco\', \'text\': \'Tutti i Tramutanti hanno "Questa creatura prende +1/+1 fintanto che controlli una Palude" e "{B}: Rigenera questa creatura."\', \'type\': \'Creatura — Tramutante\', \'flavor\': \'La loro carne è fradicia come le paludi in cui vivono, melmosa per riempire ogni ferita e molliccia per assorbire ogni colpo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133369&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cef8c271-398d-4113-9de5-0da64f177346\', \'multiverseId\': 133369}, \'multiverseid\': 133369}, {\'name\': \'菅草スリヴァー\', \'text\': \'すべてのスリヴァーは「このクリーチャーは、あなたが沼をコントロールするかぎり＋１/＋１の修整を受ける。」と「{B}：このクリーチャーを再生する。」の能力を持つ。\', \'type\': \'クリーチャー — スリヴァー\', \'flavor\': \'その肉体は住んでいる沼地と同じぐらいぬめり、うごめいては傷をふさぎ打撃を吸収している。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133670&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'26cc1d67-21d4-4086-b145-f665f9345f64\', \'multiverseId\': 133670}, \'multiverseid\': 133670}, {\'name\': \'Fractius Ciperáceo\', \'text\': \'Todos os Fractius têm "Esta criatura recebe +1/+1 enquanto você controlar um Pântano" e "{B}: Regenere esta criatura."\', \'type\': \'Criatura — Fractius\', \'flavor\': \'Sua carne é tão encharcada como o brejo onde vivem, gotejando para preencher qualquer ferida e expelindo para absorver qualquer golpe.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133971&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b31b8cdd-fdba-4480-8106-52d3bb2c9a3b\', \'multiverseId\': 133971}, \'multiverseid\': 133971}, {\'name\': \'Осоковая Щепка\', \'text\': \'Все Щепки обладают способностью "Это существо получает +1/+1 пока вы контролируете Болото" и "{B}: Регенерируйте это существо."\', \'type\': \'Существо — Щепка\', \'flavor\': \'Их плоть такая же вязкая, как и топи, в которых они живут, их выделения заполняют все впадины и хлюпают, поглощая любой удар.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134272&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8f24ba77-de1c-4959-82a9-416eb086be38\', \'multiverseId\': 134272}, \'multiverseid\': 134272}, {\'name\': \'蓑草裂片妖\', \'text\': \'所有裂片妖具有「只要你操控沼泽，此生物便得+1/+1」与「{B}：重生此生物。」\', \'type\': \'生物～裂片妖\', \'flavor\': \'其肉身有如所居之沼地般湿软，能够修补任何伤害、吸收所有冲击。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132466&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'58e390a8-0833-4e6b-b86e-5bb04e612a7f\', \'multiverseId\': 132466}, \'multiverseid\': 132466}]', '[{\'name\': \'Riff der Schiffe des Grauens\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}.\\n{1}, {T}: Lege eine Speichermarke auf das Riff der Schiffe des Grauens.\\n{1}, entferne X Speichermarken vom Riff der Schiffe des Grauens: Erhöhe deinen Manavorrat um X Mana einer beliebigen Kombination aus {U} und/oder {B}.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132911&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1a38c7dc-df31-44b5-8b7f-1143292617f9\', \'multiverseId\': 132911}, \'multiverseid\': 132911}, {\'name\': \'Arrecife nave pavorosa\', \'text\': \'{T}: Agrega {1} a tu reserva de maná.\\n{1}, {T}: Pon un contador de almacenaje sobre el Arrecife nave pavorosa.\\n{1}, remover X contadores de almacenaje del Arrecife nave pavorosa: Agrega X maná de cualquier combinación de {U} y/o {B} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134416&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'68276bed-a93c-427a-92b6-3f2289f4b5be\', \'multiverseId\': 134416}, \'multiverseid\': 134416}, {\'name\': "Brisants du navire de l\'effroi", \'text\': "{T} : Ajoutez {1} à votre réserve.\\n{1}, {T} : Mettez un marqueur « stock » sur les Brisants du navire de l\'effroi.\\n{1}, retirez X marqueurs « stock » des Brisants du navire de l\'effroi : Ajoutez X manas de n\'importe quelle combinaison de {U} et/ou {B} à votre réserve.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132610&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'28d90d98-9d15-4815-92f3-52b331a48849\', \'multiverseId\': 132610}, \'multiverseid\': 132610}, {\'name\': \'Barriera Terrore delle Navi\', \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana.\\n{1}, {T}: Metti un segnalino magazzino sulla Barriera Terrore delle Navi.\\n{1}, Rimuovi X segnalini magazzino dalla Barriera Terrore delle Navi: Aggiungi X mana in qualsiasi combinazione di {U} e/o {B} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133212&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bda36054-04aa-4d56-84ee-c17fb0a1bed7\', \'multiverseId\': 133212}, \'multiverseid\': 133212}, {\'name\': \'戦慄艦の浅瀬\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。\\n{1}, {T}：戦慄艦の浅瀬の上に蓄積カウンターを１個置く。\\n{1}, 戦慄艦の浅瀬から蓄積カウンターをＸ個取り除く：Ｘ点の{U}か{B}（あるいはその組み合わせ）をあなたのマナ・プールに加える。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133513&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bf0954a6-44c6-4632-92b4-866a4aa83219\', \'multiverseId\': 133513}, \'multiverseid\': 133513}, {\'name\': \'Recifes da Nau-Terror\', \'text\': \'{T}: Adicione {1} à sua reserva de mana.\\n{1}, {T}: Coloque um marcador de estocagem sobre Recifes da Nau-Terror.\\n{1}, Remova X marcadores de estocagem de Recifes da Nau-Terror: Adicione X manas em qualquer combinação de {U} e/ou {B} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133814&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4ef74671-6629-4ff4-a327-6767dfafdf96\', \'multiverseId\': 133814}, \'multiverseid\': 133814}, {\'name\': \'Риф Корабля Ужаса\', \'text\': \'{T}: Добавьте {1} в ваше хранилище маны.\\n{1}, {T}: Положите накопительный жетон на Риф Корабля Ужаса.\\n{1}, Удалите X накопительных жетонов с Рифа Корабля Ужаса : Добавьте X маны в любых комбинациях {U} и/или {B} в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134115&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0c14ef4f-345f-49d3-bf84-c261363c0d00\', \'multiverseId\': 134115}, \'multiverseid\': 134115}, {\'name\': \'惧舰礁岩\', \'text\': \'{T}：加{1}到你的法术力池中。\\n{1}，{T}：在惧舰礁岩上放置一个储藏指示物。\\n{1}，从惧舰礁岩上移去X个储藏指示物：加X点法术力到你的法术力池中，且为{U}和／或{B}的任意组合。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132309&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4cedbc1a-246f-4791-ba40-d85c704a2a54\', \'multiverseId\': 132309}, \'multiverseid\': 132309}]', '[{\'name\': \'Ritter des Heiligenscheins\', \'text\': \'Flankenangriff (Immer wenn eine Kreatur ohne Flankenangriff diese Kreatur blockt, erhält die blockende Kreatur -1/-1 bis zum Ende des Zuges.)\\nWürde der Ritter des Heiligenscheins zerstört, regeneriere ihn.\\n{2}: Der Ritter des Heiligenscheins kann in diesem Zug nicht regeneriert werden. Nur beliebige Gegner können diese Fähigkeit spielen.\', \'type\': \'Kreatur — Mensch, Rebell, Ritter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132986&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9bc27f84-b303-4e80-b113-f16a470cefc3\', \'multiverseId\': 132986}, \'multiverseid\': 132986}, {\'name\': \'Caballero del nimbo sagrado\', \'text\': \'Flanquea (Siempre que una criatura sin la habilidad de flanquear bloquee a esta criatura, la criatura bloqueadora obtiene -1/-1 hasta el final del turno.)\\nSi el Caballero del nimbo sagrado fuera a ser destruido, regenéralo.\\n{2}: El Caballero del nimbo sagrado no puede ser regenerado este turno. Sólo cualquier oponente puede jugar esta habilidad.\', \'type\': \'Criatura — Caballero rebelde humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134491&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d0242a18-e2de-4b8a-8227-b5e5e04a7c8e\', \'multiverseId\': 134491}, \'multiverseid\': 134491}, {\'name\': \'Chevalier du Halo sacré\', \'text\': "Débordement (À chaque fois qu\'une créature sans le débordement bloque cette créature, la créature bloqueuse gagne -1/-1 jusqu\'à la fin du tour.)\\nSi le Chevalier du Halo sacré devait être détruit, régénérez-le.\\n{2} : Le Chevalier du Halo sacré ne peut pas être régénéré ce tour-ci. Seul un adversaire peut jouer cette capacité.", \'type\': \'Créature : humain et rebelle et chevalier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132685&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b1aac3ee-723e-47a0-bfb7-6f08c0917c5d\', \'multiverseId\': 132685}, \'multiverseid\': 132685}, {\'name\': \'Cavaliere della Sacra Aureola\', \'text\': \'Aggirare (Ogniqualvolta una creatura senza aggirare blocca questa creatura, la creatura bloccante prende -1/-1 fino alla fine del turno.)\\nSe il Cavaliere della Sacra Aureola sta per essere distrutto, rigeneralo.\\n{2}: Il Cavaliere della Sacra Aureola non può essere rigenerato in questo turno. Solo gli avversari possono giocare questa abilità.\', \'type\': \'Creatura — Cavaliere Ribelle Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133287&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2f9eac81-94c0-4972-8a0e-06e8b01d04d2\', \'multiverseId\': 133287}, \'multiverseid\': 133287}, {\'name\': \'聖なる後光の騎士\', \'text\': \'側面攻撃 （側面攻撃を持たないいずれかのクリーチャーがこのクリーチャーをブロックするたび、そのブロックしているクリーチャーはターン終了時まで－１/－１の修整を受ける。）\\n聖なる後光の騎士が破壊される場合、それを再生する。\\n{2}：このターン、聖なる後光の騎士は再生できない。 いずれかの対戦相手のみがこの能力をプレイできる。\', \'type\': \'クリーチャー — 人間・レベル・騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133588&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'04fa5046-6701-4a92-b43d-4ae7f4632b6c\', \'multiverseId\': 133588}, \'multiverseid\': 133588}, {\'name\': \'Cavaleiro do Nimbo Sagrado\', \'text\': \'Flanquear (Toda vez que uma criatura sem flanquear bloquear esta criatura, a criatura bloqueadora receberá -1/-1 até o final do turno.)\\nSe Cavaleiro do Nimbo Sagrado estiver prestes a ser destruído, regenere-o.\\n{2}: Cavaleiro do Nimbo Sagrado não pode ser regenerado neste turno. Esta habilidade só pode ser jogada pelos oponentes.\', \'type\': \'Criatura — Cavaleiro Rebelde Humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133889&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e7609c74-a663-4711-9abb-b24796cfd9f9\', \'multiverseId\': 133889}, \'multiverseid\': 133889}, {\'name\': \'Рыцарь Священного Нимба\', \'text\': \'Обход (Когда существо без обхода блокирует это существо, это блокирующее существо получает -1/-1 до конца хода.)\\nЕсли Рыцарь Священного Нимба должен быть уничтожен, регенерируйте его.\\n{2}: Рыцарь Священного Нимба не может быть регенирирован в этом ходу. Эта способность может применяться только оппонентами.\', \'type\': \'Существо — Человек Повстанец Рыцарь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134190&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'56e55372-24b3-4772-8d29-e95dd63186ac\', \'multiverseId\': 134190}, \'multiverseid\': 134190}, {\'name\': \'圣玄云骑士\', \'text\': \'侧面攻击（每当一个不具侧面攻击之生物阻挡此生物时，该阻挡生物得-1/-1直到回合结束。）\\n如果圣玄云骑士将被消灭，则重生之。\\n{2}：圣玄云骑士本回合不能重生。 只有对手可以使用此异能。\', \'type\': \'生物～人类／反抗军／骑士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132384&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8df1dd91-3f62-4712-b92b-df2ce35b6265\', \'multiverseId\': 132384}, \'multiverseid\': 132384}]', '[{\'name\': \'Ruf in die Zwischenwelt\', \'text\': \'Bringe eine schwarze Kreaturenkarte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\\nWahnsinn {0} (Falls du diese Karte aus deiner Hand abwirfst, kannst du sie für ihre Wahnsinn-Kosten spielen, anstatt sie auf deinen Friedhof zu legen.)\', \'type\': \'Hexerei\', \'flavor\': \'Normalerweise wurde das Ritual nur von Schrecken und Grubengezücht durchgeführt. Die meisten unbedeutenden Magier hatten nur einen Verstand, den sie dabei verlieren konnten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132878&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'293c8cba-ddf3-4fc5-a756-a95853e6b955\', \'multiverseId\': 132878}, \'multiverseid\': 132878}, {\'name\': \'Llamar al submundo\', \'text\': \'Regresa la carta de criatura negra objetivo de tu cementerio a tu mano.\\nDemencia {0} (Si descartas esta carta, puedes jugarla por su coste de demencia en vez de ponerla en tu cementerio.)\', \'type\': \'Conjuro\', \'flavor\': \'El ritual era realizado normalmente por horrores y engendros del foso. Los magos menores tienen una única cordura para destruir realizándolo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134383&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6772553c-30e9-4233-8a40-f9811e925db4\', \'multiverseId\': 134383}, \'multiverseid\': 134383}, {\'name\': \'Appel au monde souterrain\', \'text\': \'Renvoyez une carte de créature noire ciblée depuis votre cimetière dans votre main.\\nFolie {0} (Si vous vous défaussez de cette carte, vous pouvez la jouer pour son coût de folie à la place de la mettre dans votre cimetière.)\', \'type\': \'Rituel\', \'flavor\': "Le rituel était d\'ordinaire uniquement pratiqué par les horreurs et les engeances de l\'Abîme. Un mage moins puissant risquait d\'y perdre le peu de santé mentale qui lui restait.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132577&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ddc7b9bb-0baa-4e4d-8749-d5952bf668cc\', \'multiverseId\': 132577}, \'multiverseid\': 132577}, {\'name\': \'Richiamo degli Inferi\', \'text\': \'Riprendi in mano una carta creatura nera bersaglio dal tuo cimitero.\\nFollia {0} (Se scarti questa carta, puoi giocarla pagando il suo costo di follia invece di metterla nel tuo cimitero.)\', \'type\': \'Stregoneria\', \'flavor\': "Il rituale veniva celebrato normalmente solo dagli orrori e dalle progenie dell\'abisso. I maghi minori avevano un solo equilibrio mentale da far crollare durante il lancio.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133179&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'158b302c-e3c0-442a-9139-85a1b8f387e3\', \'multiverseId\': 133179}, \'multiverseid\': 133179}, {\'name\': \'冥界への呼び声\', \'text\': \'あなたの墓地にある黒のクリーチャー・カード１枚を対象とし、それをあなたの手札に戻す。\\nマッドネス {0} （あなたがこのカードを捨てる場合、あなたはそれをあなたの墓地に置く代わりに、マッドネス・コストでそれをプレイしてもよい。）\', \'type\': \'ソーサリー\', \'flavor\': \'この儀式は、通常であれば邪霊や悪魔の落とし児でなければ行えない。 力のない魔道士にとって、この術のために投げ捨てられる理性は一つしかないのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133480&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'66176e86-212e-4efd-8959-50d463f010b8\', \'multiverseId\': 133480}, \'multiverseid\': 133480}, {\'name\': \'Chamado ao Mundo dos Mortos\', \'text\': \'Devolva o card de criatura alvo preto de seu cemitério para sua mão.\\nLoucura {0} (Se descartar este card, você poderá jogá-lo pagando seu custo de loucura, em vez de colocá-lo em seu cemitério.)\', \'type\': \'Feitiço\', \'flavor\': \'O ritual normalmente era realizado apenas pelos horrores e crias do antro. Os magos menores dispunham apenas de uma sanidade para queimar na conjuração.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133781&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3232e2d1-df9e-4926-803f-31375a7b6252\', \'multiverseId\': 133781}, \'multiverseid\': 133781}, {\'name\': \'Зов в Преисподнюю\', \'text\': \'Верните целевую карту черного существа из вашего кладбища в вашу руку.\\nБешенство {0} (Если вы сбрасываете эту карту, вы можете сыграть ее за ее стоимость бешенства вместо того чтобы положить ее на ваше кладбище.)\', \'type\': \'Волшебство\', \'flavor\': \'Этот ритуал обычно свершался только кошмарами и порождениями преисподней. Лишь немногие маги могли довести его до конца, не лишившись рассудка.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134082&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a91fc2cd-ae4e-4536-a170-050da6744d5b\', \'multiverseId\': 134082}, \'multiverseid\': 134082}, {\'name\': \'冥府呼唤\', \'text\': \'将目标黑色生物牌从你的坟墓场移回你手上。\\n疯魔{0}（如果你弃掉此牌，可以改为使用它并支付其疯魔费用，而非直接将它置入你的坟墓场。）\', \'type\': \'法术\', \'flavor\': \'此祭礼通常是惊惧兽与暗渊魔裔的专利。 只有疯到无可救药的法师才会冒丧失心智之险施咒。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132276&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e9c8383b-a238-4ee1-bfb0-c8e3067c1fd8\', \'multiverseId\': 132276}, \'multiverseid\': 132276}]', '[{\'name\': \'Ruinen der Akademie\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}.\\n{1}{U}, {T}: Lege eine Artefaktkarte deiner Wahl aus deinem Friedhof oben auf deine Bibliothek.\', \'type\': \'Legendäres Land\', \'flavor\': \'Einst wurden hier im Geheimen die besten magischen Geräte hergestellt. Nun durchwühlen Krabben die Überreste der Akademie, um ihre Panzer damit zu verzieren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132854&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'06910b92-e630-431f-98c2-6c49bb7947b0\', \'multiverseId\': 132854}, \'multiverseid\': 132854}, {\'name\': \'Ruinas de la Academia\', \'text\': \'{T}: Agrega {1} a tu reserva de maná.\\n{1}{U}, {T}: Pon la carta de artefacto objetivo de tu cementerio en la parte superior de tu biblioteca.\', \'type\': \'Tierra legendaria\', \'flavor\': \'Sus secretos alguna vez forjaron a los mejores artífices del mundo. Ahora los cangrejos saquean los restos para decorar sus caparazones.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134359&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6b266730-5715-47c0-949d-823fcdb0eb39\', \'multiverseId\': 134359}, \'multiverseid\': 134359}, {\'name\': "Ruines de l\'académie", \'text\': "{T} : Ajoutez {1} à votre réserve.\\n{1}{U}, {T} : Mettez la carte d\'artefact ciblée de votre cimetière au-dessus de votre bibliothèque.", \'type\': \'Terrain légendaire\', \'flavor\': "Ses secrets furent à l\'origine d\'un des plus grands artifices jamais connus. Désormais, les crabes se servent des gravats pour décorer leur carapace.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132553&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'40f2a7bb-3256-4e11-ba4f-2b03e995cd7c\', \'multiverseId\': 132553}, \'multiverseid\': 132553}, {\'name\': "Rovine dell\'Accademia", \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana.\\n{1}{U}, {T}: Metti in cima al tuo grimorio una carta artefatto bersaglio dal tuo cimitero.\', \'type\': \'Terra Leggendaria\', \'flavor\': \'I suoi segreti un tempo plasmarono il più grande artificio mai conosciuto. Ora i granchi saccheggiano le macerie per decorare i loro carapaci.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133155&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ad3d937d-f50b-4187-8401-6e4550e84129\', \'multiverseId\': 133155}, \'multiverseid\': 133155}, {\'name\': \'アカデミーの廃墟\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。\\n{1}{U}, {T}：あなたの墓地にあるアーティファクト・カード１枚を対象とし、それをあなたのライブラリーの一番上に置く。\', \'type\': \'伝説の土地\', \'flavor\': \'かつてその秘密は、歴代知られる中でも最高の技術を生み出した。 いまでは蟹が瓦礫をほじくり返して殻を飾るばかりだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133456&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c2ce8d84-b80b-4ff0-b2c7-35fe8e7d35d8\', \'multiverseId\': 133456}, \'multiverseid\': 133456}, {\'name\': \'Ruínas da Academia\', \'text\': \'{T}: Adicione {1} à sua reserva de mana.\\n{1}{U}, {T}: Coloque o card de artefato alvo em seu cemitério no topo de seu grimório.\', \'type\': \'Terreno Lendário\', \'flavor\': \'Seus segredos já forjaram o maior estratagema jamais conhecido. Agora os caranguejos saqueiam seus escombros para decorar suas carapaças.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133757&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f17adaf3-cd63-466b-a0cf-a562006e5217\', \'multiverseId\': 133757}, \'multiverseid\': 133757}, {\'name\': \'Руины Академии\', \'text\': \'{T}: Добавьте {1} в ваше хранилище маны.\\n{1}{U}, {T}: Положите целевую артефактную карту из вашего кладбища наверх вашей библиотеки.\', \'type\': \'Легендарная Земля\', \'flavor\': \'Ее секреты однажды открыли величайшую находку всех времен. Теперь лишь крабы растаскивают бут для украшения своих панцирей.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134058&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7c27e585-6bd2-458d-b806-50210414907b\', \'multiverseId\': 134058}, \'multiverseid\': 134058}, {\'name\': \'大学院废墟\', \'text\': \'{T}：加{1}到你的法术力池中。\\n{1}{U}，{T}：将目标神器牌从你的坟墓场置于你的牌库顶。\', \'type\': \'传奇地\', \'flavor\': \'其间秘密曾雕琢出不二奇械。 尔今螃蟹捞捡其间瓦砾来装饰外壳。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132252&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9bd1aa39-dba2-484c-a24e-b3a3d4e3cb3c\', \'multiverseId\': 132252}, \'multiverseid\': 132252}]', '[{\'name\': \'Rückprall\', \'text\': \'Du kannst eine blaue Karte aus deiner Hand ganz aus dem Spiel entfernen, anstatt die Manakosten von Rückprall zu bezahlen.\\nBringe eine Kreatur deiner Wahl auf die Hand ihres Besitzers zurück.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Wenn es sich in einigen Jahren noch einmal in unsere Nähe traut, wissen wir schon, wie wir es bekämpfen müssen." —Andorel, Tolarianischer Wachposten\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133077&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9109b72f-f871-4f1f-a0d3-58c8c2b36bc2\', \'multiverseId\': 133077}, \'multiverseid\': 133077}, {\'name\': \'Enviar al pasado\', \'text\': \'Puedes remover del juego una carta azul de tu mano en lugar de pagar el coste de maná de Enviar al pasado.\\nRegresa la criatura objetivo a la mano de su propietario.\', \'type\': \'Instantáneo\', \'flavor\': \'"Se ha ido. Si vuelve en unos años, nuestro conocimiento de cómo combatirlo será mucho mayor." —Ándorel, centinela tolariano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134582&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'175c2a2a-2e47-463c-8169-f027ba97c503\', \'multiverseId\': 134582}, \'multiverseid\': 134582}, {\'name\': \'Prise en retour\', \'text\': \'Vous pouvez retirer de la partie une carte bleue de votre main à la place de payer le coût de mana de la Prise en retour.\\nRenvoyez la créature ciblée dans la main de son propriétaire.\', \'type\': \'Éphémère\', \'flavor\': "« Si elle revient dans l\'avenir, nous saurons désormais comment la combattre. » —Andorel, sentinelle tolariane", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132776&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b7cb4d93-adb9-48cd-aefc-37d2612004a5\', \'multiverseId\': 132776}, \'multiverseid\': 132776}, {\'name\': \'Recupero\', \'text\': \'Puoi rimuovere dal gioco una carta blu dalla tua mano invece di pagare il costo di mana del Recupero.\\nFai tornare una creatura bersaglio in mano al suo proprietario.\', \'type\': \'Istantaneo\', \'flavor\': \'"Se ritorna fra qualche anno, le nostre conoscenze su come combatterlo saranno molto maggiori." —Andorel, sentinella di Tolaria\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133378&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1f73eaff-2ae0-46bb-b9ee-f8bbcbb850dd\', \'multiverseId\': 133378}, \'multiverseid\': 133378}, {\'name\': \'応じ返し\', \'text\': \'あなたは応じ返しのマナ・コストを支払うのではなく、あなたの手札にある青カードを１枚ゲームから取り除いてもよい。\\nクリーチャー１体を対象とし、それをオーナーの手札に戻す。\', \'type\': \'インスタント\', \'flavor\': \'何年か経って戻ってくるようなら、そいつとの戦い方もずっとうまくなってるだろうさ。 ――トレイリアの歩哨、アンドレル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133679&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ef33e58a-c6c6-4705-aed4-272b837fa575\', \'multiverseId\': 133679}, \'multiverseid\': 133679}, {\'name\': \'Ricochetear\', \'text\': \'Você pode remover do jogo um card azul em sua mão, em vez de pagar o custo de mana de Ricochetear.\\nDevolva a criatura alvo para a mão de seu dono.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Se ele voltar nos anos adiante, nosso conhecimento de como combatê-lo será tão grande quanto." —Andorel, sentinela tolariano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133980&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5052cff6-26c5-4d4b-a5e3-25fedc48e54f\', \'multiverseId\': 133980}, \'multiverseid\': 133980}, {\'name\': \'Раздраженный Ответ\', \'text\': \'Вы можете убрать одну синюю карту в вашей руке из игры вместо оплаты мана-стоимости Раздраженного Oтвета.\\nВерните целевое существо в руку его владельца.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Если оно вернется годы спустя, мы будем знать намного больше о том, как его победить», Андорель, Таларийский стражник\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134281&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b55ec166-fe72-4964-bfba-132faaa599ae\', \'multiverseId\': 134281}, \'multiverseid\': 134281}, {\'name\': \'突然跳回\', \'text\': \'你可以将你手上一张蓝色牌移出对战，而不支付突然跳回的法术力费用。\\n将目标生物移回其拥有者手上。\', \'type\': \'瞬间\', \'flavor\': \'「若他回到数年后，我们将有更多与其接战的知识。」 ～陶拉里亚哨兵安都瑞\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132475&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4056d1ed-d3a2-4ffd-b9bc-b8c5757e0186\', \'multiverseId\': 132475}, \'multiverseid\': 132475}]', '[{\'name\': \'Saffi Eriksdotter\', \'text\': \'Opfere Saffi Eriksdotter: Wenn eine Kreatur deiner Wahl in diesem Zug aus dem Spiel auf deinen Friedhof gelegt wird, bringe diese Karte ins Spiel zurück.\', \'type\': \'Legendäre Kreatur — Mensch, Späher\', \'flavor\': \'Bevor sie es richtig mitbekam, ging sie nicht mehr in tiefem Schnee, sondern in einer staubigen Einöde. Aus der Lichtspalte hinter ihr war eine hohle Stimme zu hören: „Saffi, warte auf mich"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133058&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'99c53b86-df47-4a2f-a1ca-f079c14bc024\', \'multiverseId\': 133058}, \'multiverseid\': 133058}, {\'name\': \'Saffi Eriksdotter\', \'text\': \'Sacrificar a Saffi Eriksdotter: Cuando la criatura objetivo vaya a un cementerio desde el juego este turno, regresa esa carta al juego.\', \'type\': \'Criatura legendaria — Explorador humano\', \'flavor\': \'En un abrir y cerrar de ojos, dio un paso entre nieve profunda y una planicie polvorienta. Desde un doblez de luz detrás de ella, una voz resonaba: "Saffi, espérame. . . ."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134563&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2d9d4967-d5e5-4998-b20b-040a148c84a6\', \'multiverseId\': 134563}, \'multiverseid\': 134563}, {\'name\': \'Saffi Eriksdotter\', \'text\': \'Sacrifiez Saffi Eriksdotter : Quand la créature ciblée est mise dans votre cimetière depuis le jeu ce tour-ci, renvoyez cette carte en jeu.\', \'type\': \'Créature légendaire : humain et éclaireur\', \'flavor\': "En un clin d\'œil, elle passa des neiges profondes au désert de poussière. Une voix déformée lui parvint de la déchirure de lumière derrière elle : « Saffi, attends-moi... »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132757&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'90ab8a1b-27f4-4df9-a2e9-fceb7e08a01c\', \'multiverseId\': 132757}, \'multiverseid\': 132757}, {\'name\': \'Saffi Eriksdotter\', \'text\': \'Sacrifica Saffi Eriksdotter: Quando una creatura bersaglio viene messa in un cimitero in questo turno, rimetti in gioco quella carta.\', \'type\': \'Creatura Leggendaria — Esploratore Umano\', \'flavor\': \'In un batter d\\\'occhio, procedette a grandi passi da distese innevate a deserti polverosi. Dalla striscia di luce alle sue spalle, una voce risuonò cupa: "Saffi, aspettami . . . ."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133359&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eba1957b-5a07-469a-a8ce-181e205a3cb1\', \'multiverseId\': 133359}, \'multiverseid\': 133359}, {\'name\': \'サッフィー・エリクスドッター\', \'text\': \'サッフィー・エリクスドッターを生け贄に捧げる：クリーチャー１体を対象とする。このターン、それがあなたの墓地に置かれたとき、そのカードを場に戻す。\', \'type\': \'伝説のクリーチャー — 人間・スカウト\', \'flavor\': \'ひと瞬きの間に、彼女は深い雪の中から埃立つ荒野へと歩み出ていた。 彼女の後の光の襞の中から、空ろな声が響いてきていた。「サッフィー、待ってくれ … … 。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133660&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7de8cac1-5b85-447b-b825-6cb02fa9a32b\', \'multiverseId\': 133660}, \'multiverseid\': 133660}, {\'name\': \'Saffi Eriksdotter\', \'text\': \'Sacrifique Saffi Eriksdotter: Quando a criatura alvo for colocada no seu cemitério vinda do jogo neste turno, devolva aquele card ao jogo.\', \'type\': \'Criatura Lendária — Batedor Humano\', \'flavor\': \'Num piscar de olhos, ela caminhou da neve profunda ao deserto empoeirado. De uma ruga de luz atrás dela, uma voz soou vazia: "Saffi, espere por mim. . . ."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133961&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'25274d29-aa70-47bf-858e-1c5a3aa6ec00\', \'multiverseId\': 133961}, \'multiverseid\': 133961}, {\'name\': \'Саффи Эриксдоттер\', \'text\': \'Пожертвуйте Саффи Эриксдоттера: Когда целевое существо попадает на ваше кладбище из игры на этом ходу, верните эту карту в игру.\', \'type\': \'Легендарное Существо — Человек Разведчик\', \'flavor\': \'В мгновение ока она перешагнула из глубоких снегов в пыльную пустошь. Из-за линии света зе ее спиной она услышала громкий голос: "Саффи, подожди меня . . . .»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134262&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'978db620-0581-4eed-87b8-ae70411d0fbc\', \'multiverseId\': 134262}, \'multiverseid\': 134262}, {\'name\': \'莎妃艾力克斯朵特\', \'text\': \'牺牲莎妃艾力克斯朵特：当目标生物本回合从场上置入你的坟墓场时，将该牌返回场上。\', \'type\': \'传奇生物～人类／斥候\', \'flavor\': \'转眼之间，她便从深雪大地奔赴扬尘荒野。 从她身后曳光之中，一个声音孤单地回荡着：「莎妃，等等我. . . .」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132456&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b8a27e7a-6b84-4ef2-a2c6-9d4519f258b1\', \'multiverseId\': 132456}, \'multiverseid\': 132456}]', '[{\'name\': \'Salzverkrustete Steppe\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}.\\n{1}, {T}: Lege eine Speichermarke auf die Salzverkrustete Steppe.\\n{1}, entferne X Speichermarken von der Salzverkrusteten Steppe: Erhöhe deinen Manavorrat um X Mana einer beliebigen Kombination aus {G} und/oder {W}.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133060&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'523500fb-1566-4031-bc07-80319e489858\', \'multiverseId\': 133060}, \'multiverseid\': 133060}, {\'name\': \'Estepa costra salina\', \'text\': \'{T}: Agrega {1} a tu reserva de maná.\\n{1}, {T}: Pon un contador de almacenaje sobre la Estepa costra salina.\\n{1}, remover X contadores de almacenaje de la Estepa costra salina: Agrega X maná de cualquier combinación de {G} y/o {W} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134565&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'99ee6b7a-e21d-4bfa-96d5-604541c5d4ad\', \'multiverseId\': 134565}, \'multiverseid\': 134565}, {\'name\': \'Steppes de sel\', \'text\': "{T} : Ajoutez {1} à votre réserve.\\n{1}, {T} : Mettez un marqueur « stock » sur les Steppes de sel.\\n{1}, retirez X marqueurs « stock » des Steppes de sel : Ajoutez X manas de n\'importe quelle combinaison de {G} et/ou {W} à votre réserve.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132759&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'68225b87-a403-4037-9936-37e6dbc9ce15\', \'multiverseId\': 132759}, \'multiverseid\': 132759}, {\'name\': \'Steppa Salata\', \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana.\\n{1}, {T}: Metti un segnalino magazzino sulla Steppa Salata.\\n{1}, Rimuovi X segnalini magazzino dalla Steppa Salata: Aggiungi X mana in qualsiasi combinazione di {G} e/o {W} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133361&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'784fcf0f-303c-429e-8a8f-b4dff6bdbe65\', \'multiverseId\': 133361}, \'multiverseid\': 133361}, {\'name\': \'塩汚れのステップ\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。\\n{1}, {T}：塩汚れのステップの上に蓄積カウンターを１個置く。\\n{1}, 塩汚れのステップから蓄積カウンターをＸ個取り除く：Ｘ点の{G}か{W}（あるいはその組み合わせ）をあなたのマナ・プールに加える。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133662&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3c249537-f327-4a62-bf60-19fb63a3232a\', \'multiverseId\': 133662}, \'multiverseid\': 133662}, {\'name\': \'Estepe Salina\', \'text\': \'{T}: Adicione {1} à sua reserva de mana.\\n{1}, {T}: Coloque um marcador de estocagem sobre Estepe Salina.\\n{1}, Remova X marcadores de estocagem de Estepe Salina: Adicione X manas em qualquer combinação de {G} e/ou {W} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133963&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a3d741b9-d81f-4e54-b696-80d0fde431b7\', \'multiverseId\': 133963}, \'multiverseid\': 133963}, {\'name\': \'Засоленная Степь\', \'text\': \'{T}: Добавьте {1} в ваше хранилище маны.\\n{1}, {T}: Положите накопительный жетон на Засоленную Степь.\\n{1}, Удалите X накопительных жетонов с Засоленной Степи: Добавьте X маны в любых комбинациях {G} и/или {W} в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134264&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'491f35d5-61a5-401e-9cbb-c2e71429e2b8\', \'multiverseId\': 134264}, \'multiverseid\': 134264}, {\'name\': \'盐壳草原\', \'text\': \'{T}：加{1}到你的法术力池中。\\n{1}，{T}：在盐壳草原上放置一个储藏指示物。\\n{1}，从盐壳草原上移去X个储藏指示物：加X点法术力到你的法术力池中，且为{G}和／或{W}的任意组合。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132458&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'336428c8-ef9d-41bb-a04e-9f4d0e8ff3e7\', \'multiverseId\': 132458}, \'multiverseid\': 132458}]', "[{'name': 'Sarpadische Reiche, Band VII', 'text': 'Sowie Sarpadische Reiche, Band VII ins Spiel kommt, bestimme weiß und Bürger, blau und Camarid, schwarz und Thrull, rot und Goblin oder grün und Saproling.\\n{3}, {T}: Bringe einen 1/1 Spielstein der bestimmten Farbe und des bestimmten Typs ins Spiel.', 'type': 'Artefakt', 'flavor': 'Die Vergangenheit überlebt niedergeschrieben auf den Seiten und wartet darauf, dass ihre Zeit erneut kommt.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132853&type=card', 'language': 'German', 'identifiers': {'scryfallId': '054dd777-392b-4d52-b51b-d37b494521d5', 'multiverseId': 132853}, 'multiverseid': 132853}, {'name': 'Imperios sarpadianos, Vol. VII', 'text': 'En cuanto Imperios sarpadianos, Vol. VII entre en juego, elige Ciudadano blanco, Camárido azul, Thrull negro, Trasgo rojo o Saprolín verde.\\n{3}, {T}: Pon en juego una ficha de criatura 1/1 del color y tipo elegido.', 'type': 'Artefacto', 'flavor': 'El pasado vive en sus páginas, esperando el momento para volver.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134358&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'afbcc66b-926b-4dd8-b13e-9a83464a475d', 'multiverseId': 134358}, 'multiverseid': 134358}, {'name': 'Les Empires sarpadiens, Vol. VII', 'text': 'Au moment où Les Empires sarpadiens, Vol. VII arrive en jeu, choisissez Citoyen blanc, Camaride bleu, Srâne noir, Gobelin rouge ou Saprobionte vert.\\n{3}, {T} : Mettez en jeu un jeton de créature 1/1 du type et de la couleur choisis.', 'type': 'Artefact', 'flavor': 'Le passé vit encore dans ses pages, attendant le bon moment pour ressurgir.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132552&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'bf2ebcc7-fd61-4053-904b-0e9b1ae088ef', 'multiverseId': 132552}, 'multiverseid': 132552}, {'name': 'Imperi di Sarpadia, Vol. VII', 'text': 'Mentre Imperi di Sarpadia, Vol. VII entra in gioco, scegli Cittadino bianco, Camarid blu, Thrull nero, Goblin rosso o Saprolingio verde.\\n{3}, {T}: Metti in gioco una pedina creatura 1/1 del colore e del tipo scelti.', 'type': 'Artefatto', 'flavor': 'Il passato vive ancora tra le sue pagine, in attesa che giunga il momento di ritornare.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133154&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '763ad86c-d330-448e-93a9-9fe6da2c259f', 'multiverseId': 133154}, 'multiverseid': 133154}, {'name': 'サーペイディア諸帝国史、 第七巻', 'text': 'サーペイディア諸帝国史、 第七巻が場にでる際に、あなたは「白の市民」「青のカマリッド」「黒のスラル」「赤のゴブリン」「緑の苗木」から１つを選ぶ。\\n{3}, {T}：選ばれた色とタイプの１/１のクリーチャー・トークンを１体場に出す。', 'type': 'アーティファクト', 'flavor': '過去は未だページの中に生き、再び来る時を待ち続ける。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133455&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9bdc8472-2271-446b-8fb6-4b92de2aa637', 'multiverseId': 133455}, 'multiverseid': 133455}, {'name': 'Impérios Sarpadianos, Vol. VII', 'text': 'Conforme Impérios Sarpadianos, Vol. VII entrar em jogo, escolha entre Cidadão branco, Camárida azul, Thrull preto, Goblin vermelho ou Saprófita verde.\\n{3}, {T}: Coloque em jogo uma ficha de criatura 1/1 da cor e tipo escolhidos.', 'type': 'Artefato', 'flavor': 'O passado ainda vive em suas páginas, aguardando o momento de voltar à vida novamente.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133756&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '58a79e62-0cd8-4ca1-88d6-fa9751183a80', 'multiverseId': 133756}, 'multiverseid': 133756}, {'name': 'Сарпадианские Империи, Том VII', 'text': 'При входе Сарпадианских Империй, Том VII в игру, выберите белый Гражданин, синий Камарид, черный Трулл, красный Гоблин или зеленый Сапролинг.\\n{3}, {T}: Положите одну фишку существа 1/1 с выбранным цветом и типом в игру.', 'type': 'Артефакт', 'flavor': 'Прошлое живет на ее страницах, ожидая возврата своего времени.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134057&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '0ccc9e4c-f812-466e-95f6-6346a5003a55', 'multiverseId': 134057}, 'multiverseid': 134057}, {'name': '撒尔帕汀帝国，卷 七', 'text': '于撒尔帕汀帝国，卷 七进场时，选择白色市民，蓝色卡马利，黑色索尔兽，红色精灵，或绿色腐生物。\\n{3}，{T}：将一个所选择的颜色与种类之1/1衍生物放置进场。', 'type': '神器', 'flavor': '过往依旧活在纸页间，等待再现的时机。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132251&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '47c8405a-06ed-43b6-a684-854985f54734', 'multiverseId': 132251}, 'multiverseid': 132251}]", "[{'name': 'Saugende Wellhornschnecke', 'text': 'Aufblitzen (Du kannst diesen Zauberspruch zu jedem Zeitpunkt spielen, zu dem du einen Spontanzauber spielen könntest.)\\nFliegend\\nWenn die Saugende Wellhornschnecke ins Spiel kommt, neutralisiere einen Zauberspruch deiner Wahl. Lege X +1/+1-Marken auf die Saugende Wellhornschnecke, wobei X gleich den umgewandelten Manakosten des Zauberspruchs ist.', 'type': 'Kreatur — Illusion', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132908&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2997fa05-b61d-4d4b-a569-7eaf94c42ccb', 'multiverseId': 132908}, 'multiverseid': 132908}, {'name': 'Buccino desecador', 'text': 'Destello (Puedes jugar este hechizo en cualquier momento en que pudieras jugar un instantáneo.)\\nVuela.\\nCuando el Buccino desecador entre en juego, contrarresta el hechizo objetivo. Pon X contadores +1/+1 sobre el Buccino desecador, donde X es el coste de maná convertido de ese hechizo.', 'type': 'Criatura — Ilusión', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134413&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c29f46f4-ff24-485f-ac90-d5241a12385a', 'multiverseId': 134413}, 'multiverseid': 134413}, {'name': 'Bulot puiseur', 'text': 'Flash (Vous pouvez jouer ce sort à tout moment où vous pourriez jouer un éphémère.)\\nVol\\nQuand le Bulot puiseur arrive en jeu, contrecarrez le sort ciblé. Mettez X marqueurs +1/+1 sur le Bulot puiseur, X étant le coût converti de mana de ce sort.', 'type': 'Créature : illusion', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132607&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'bd57da5a-93d9-4f06-8a1d-33de16b66679', 'multiverseId': 132607}, 'multiverseid': 132607}, {'name': 'Buccina Risucchiante', 'text': 'Lampo (Puoi giocare questa magia in ogni momento in cui potresti giocare un istantaneo.)\\nVolare\\nQuando la Buccina Risucchiante entra in gioco, neutralizza una magia bersaglio. Metti X segnalini +1/+1 sulla Buccina Risucchiante, dove X è pari al costo di mana convertito di quella magia.', 'type': 'Creatura — Illusione', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133209&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'fd3f642d-347a-400f-98f2-a3f0a84abd06', 'multiverseId': 133209}, 'multiverseid': 133209}, {'name': '吸収するウェルク', 'text': '瞬速 （あなたはこの呪文を、あなたがインスタントをプレイできるときならいつでもプレイしてよい。）\\n飛行\\n吸収するウェルクが場に出たとき、呪文１つを対象とし、それを打ち消す。 吸収するウェルクの上に＋１/＋１カウンターをＸ個置く。Ｘはその呪文の点数で見たマナ・コストに等しい。', 'type': 'クリーチャー — イリュージョン', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133510&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '228abc22-79f1-4d01-a6ce-b4d709cb4511', 'multiverseId': 133510}, 'multiverseid': 133510}, {'name': 'Búzio Drenante', 'text': 'Lampejo (Você poderá jogar esta mágica a qualquer momento em que puder jogar uma mágica instantânea.)\\nVoar\\nQuando Búzio Drenante entrar em jogo, anule a mágica alvo. Coloque X marcadores +1/+1 sobre Búzio Drenante, sendo X igual ao custo de mana convertido daquela mágica.', 'type': 'Criatura — Ilusão', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133811&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '87f1a16f-d25f-44e0-8c2e-5595a392d0a8', 'multiverseId': 133811}, 'multiverseid': 133811}, {'name': 'Канализационный Прыщ', 'text': 'Миг (Вы можете играть это заклинание в любое время когда вы можете играть мгновенные заклинания.)\\nПолет\\nКогда Канализационный Прыщ входит в игру, прервите целевое заклинание. Положите X +1/+1 жетонов на Канализационного Прыща, где X это конвертированная мана-стоимость прерванного заклинания.', 'type': 'Существо — Иллюзия', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134112&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '6d007364-e453-4d6f-8464-5fb45f0bee98', 'multiverseId': 134112}, 'multiverseid': 134112}, {'name': '吮咒蛾螺', 'text': '闪现（你可以于你能够使用瞬间的时机下使用此咒语。）\\n飞行\\n当吮咒蛾螺进场时，反击目标咒语。 在吮咒蛾螺上放置X个+1/+1指示物，X为该咒语的总法术力费用。', 'type': '生物～虚影', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132306&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'bb779e17-ff6a-46fe-aef1-52ceed7b0c47', 'multiverseId': 132306}, 'multiverseid': 132306}]", '[{\'name\': \'Schattenremasuri\', \'text\': \'Alle Remasuris haben Irrealität. (Er kann nur Kreaturen mit Irrealität blocken und nur von ihnen geblockt werden.)\', \'type\': \'Kreatur — Remasuri\', \'flavor\': \'Diese Remasuris, die seit der Überlagerung von Rath zwischen den Welten gefangen sind, gehören zu den letzten, die eine direkte Abstammung von der verschollenen Remasurikönigin nachweisen können.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133071&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a4295740-795b-4cec-a7a9-cf9da27c595d\', \'multiverseId\': 133071}, \'multiverseid\': 133071}, {\'name\': \'Fragmentado desvanecido\', \'text\': \'Todos los Fragmentados tienen la habilidad de desvanecerse. (Sólo pueden bloquear o ser bloqueados por criaturas con la habilidad de desvanecerse.)\', \'type\': \'Criatura — Fragmentado\', \'flavor\': \'Estos fragmentados, atrapados entre mundos desde la sobreposición de Rath, son los últimos en reivindicar un linaje directo de la Reina de los fragmentados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134576&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'020edaf5-505e-480c-a6e6-156587231061\', \'multiverseId\': 134576}, \'multiverseid\': 134576}, {\'name\': \'Slivoïde de distorsion\', \'text\': \'Tous les slivoïdes ont la distorsion. (Ils ne peuvent bloquer ou être bloqués que par des créatures avec la distorsion.)\', \'type\': \'Créature : slivoïde\', \'flavor\': \'Ces slivoïdes, pris au piège entre les mondes depuis le recouvrement rajhi, sont parmi les derniers à descendre directement de la Reine disparue des slivoïdes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132770&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3405bede-f915-46f2-97f5-4e2df76b0e95\', \'multiverseId\': 132770}, \'multiverseid\': 132770}, {\'name\': "Tramutante dell\'Ombra", \'text\': \'Tutti i Tramutanti hanno ombra. (Possono bloccare o essere bloccati solo da creature con ombra.)\', \'type\': \'Creatura — Tramutante\', \'flavor\': \'Questi tramutanti, intrappolati tra i mondi dalla sovrapposizione di Rath, sono tra gli ultimi a rivendicare una discendenza diretta dalla scomparsa Regina dei Tramutanti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133372&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'efd0f912-9420-4bc7-b10a-8d468037ecc7\', \'multiverseId\': 133372}, \'multiverseid\': 133372}, {\'name\': \'陰影スリヴァー\', \'text\': \'すべてのスリヴァーはシャドーを持つ。 （それは、シャドーを持つクリーチャーのみをブロックでき、ブロックされる。）\', \'type\': \'クリーチャー — スリヴァー\', \'flavor\': \'このスリヴァーはラースの被覆以来世界と世界の狭間にとらえられたままで、失われたスリヴァーの女王の系列に直結する最後の一族である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133673&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7d71c2c9-ba2b-4ecc-9165-c82182278fb5\', \'multiverseId\': 133673}, \'multiverseid\': 133673}, {\'name\': \'Fractius Sombra\', \'text\': \'Todos os Fractius têm sombra. (Eles só podem bloquear ou ser bloqueados por criaturas com sombra.)\', \'type\': \'Criatura — Fractius\', \'flavor\': \'Esses fractius, presos entre os mundos desde a sobreposição dos Rathi, estão entre os últimos a reivindicar descendência direta da longínqua Rainha Fractius.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133974&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3803d45f-b730-485e-8312-0888d9888aea\', \'multiverseId\': 133974}, \'multiverseid\': 133974}, {\'name\': \'Теневая Щепка\', \'text\': \'Все Щепки обладают способностью Тень. (Это существо может блокировать и быть заблокировано только существ(ами) с тенью.)\', \'type\': \'Существо — Щепка\', \'flavor\': \'Эти щепки, что были пойманы меж мирами с тех пор как Рати был сокрыт одни из последних, что непосредственно происходят от потерянной Королевы щепок.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134275&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'94c25131-46dc-4d7a-ada2-add8deca4fdb\', \'multiverseId\': 134275}, \'multiverseid\': 134275}, {\'name\': \'幽影裂片妖\', \'text\': \'所有裂片妖具有次元幽影异能。 （它们只能阻挡具次元幽影异能的生物，亦只能被具此异能的生物阻挡。）\', \'type\': \'生物～裂片妖\', \'flavor\': \'于瑞斯的时空覆盖中，这些裂片妖被囚于世间夹缝，是与已逝女王有直系血缘的末代裂片妖之一。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132469&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'aa95c3f2-9cd3-4912-b992-2f70605962ac\', \'multiverseId\': 132469}, \'multiverseid\': 132469}]', '[{\'name\': \'Schicksalsrad\', \'text\': \'Das Schicksalsrad ist rot.\\nAussetzen 4 {1}{R} (Statt diese Karte aus deiner Hand zu spielen, bezahle {1}{R}, entferne sie ganz aus dem Spiel und lege vier Zeitmarken auf sie. Entferne zu Beginn deines Versorgungssegments eine Zeitmarke von ihr. Wenn du die letzte Zeitmarke entfernst, spiele die Karte, ohne ihre Manakosten zu bezahlen.)\\nJeder Spieler wirft alle Karten aus seiner Hand ab und zieht dann sieben Karten.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133147&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d420a274-49b5-4b7b-9015-6ab1b72b8e6b\', \'multiverseId\': 133147}, \'multiverseid\': 133147}, {\'name\': \'Rueda del destino\', \'text\': \'Rueda del destino es roja.\\nSuspender 4—{1}{R} (En lugar de jugar esta carta de tu mano, paga {1}{R} y remuévela del juego con cuatro contadores de tiempo sobre ella. Al comienzo de tu mantenimiento, remueve un contador de tiempo. Cuando remuevas el último, juégala sin pagar su coste de maná.)\\nCada jugador descarta su mano, luego roba siete cartas.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134652&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a69ae6e7-90a2-4dbc-ae59-1196ffee4f06\', \'multiverseId\': 134652}, \'multiverseid\': 134652}, {\'name\': \'Roue du destin\', \'text\': \'La Roue du destin est rouge.\\nSuspension 4 — {1}{R} (Plutôt que jouer cette carte depuis votre main, payez {1}{R} et retirez-la de la partie avec quatre marqueurs « temps » sur elle. Au début de votre entretien, retirez un marqueur « temps ». Quand vous retirez le dernier, jouez cette carte sans payer son coût de mana.)\\nChaque joueur se défausse de sa main et pioche ensuite sept cartes.\', \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132846&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b7fb120f-730c-408d-bf31-7d9f69655fac\', \'multiverseId\': 132846}, \'multiverseid\': 132846}, {\'name\': \'Ruota del Fato\', \'text\': "Ruota del Fato è rossa.\\nSospendere 4—{1}{R} (Invece di giocare questa carta dalla tua mano, paga {1}{R} e rimuovila dal gioco con quattro segnalini tempo su di essa. All\'inizio del tuo mantenimento, rimuovi un segnalino tempo. Quando rimuovi l\'ultimo, gioca la carta senza pagare il suo costo di mana.)\\nOgni giocatore scarta la propria mano, poi pesca sette carte.", \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133448&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'74b76db7-10be-4ecf-91dc-e2d61b275cf4\', \'multiverseId\': 133448}, \'multiverseid\': 133448}, {\'name\': \'運命の車輪\', \'text\': \'運命の車輪は赤である。\\n待機 ４―{1}{R} （これをあなたの手札からプレイするのではなく、{1}{R}を支払ってゲームから取り除き、その上に時間カウンターを４個置く。 あなたのアップキープの開始時に、時間カウンターを１個取り除く。 最後の１個を取り除いたとき、あなたはそれをマナ・コストを支払わずにプレイする。）\\n各プレイヤーは自分の手札を捨て、その後カードを７枚引く。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133749&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ca1020a1-7156-4b21-8f8a-cb41e1223eaf\', \'multiverseId\': 133749}, \'multiverseid\': 133749}, {\'name\': \'Roda do Destino\', \'text\': \'Roda do Destino é vermelho.\\nSuspender 4—{1}{R} (Em vez de jogar este card da sua mão, pague {1}{R} e remova-o do jogo com quatro marcadores temporais sobre ele. No início de sua manutenção, remova um marcador temporal. Quando remover o último, jogue-o sem pagar seu custo de mana.)\\nCada jogador descarta a própria mão e depois compra sete cards.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134050&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e708dede-178d-4b31-a3aa-5eda01b9e8b5\', \'multiverseId\': 134050}, \'multiverseid\': 134050}, {\'name\': \'Колесо Судьбы\', \'text\': \'Колесо Судьбы красное.\\nОтсрочка 4—{1}{R} (Вместо того чтобы сыграть эту карту из вашей руки, заплатите {1}{R} и удалите ее из игры с четырьмя временными жетонами на ней. В начале вашего шага поддержки удалите один временной жетон. После удаления последнего жетона сыграйте эту карту без оплаты ее мана-стоимости.)\\nКаждый игрок сбрасывает свою руку, затем берет семь карт.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134351&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cfed041c-668e-4d03-936e-4f011a4d9a5b\', \'multiverseId\': 134351}, \'multiverseid\': 134351}, {\'name\': \'宿命之轮\', \'text\': \'宿命之轮是红色。\\n延缓4～{1}{R}（除了从你手上使用此牌，你能支付{1}{R}并将此牌移出对战，且上面有四个计时指示物。 在你的维持开始时，从其上移去一个计时指示物。 当你移去最后一个时，则使用它且不需支付其法术力费用。）\\n每位牌手弃掉其手牌，然后抓七张牌。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132545&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ede3c00e-10a7-4aec-9427-c60399273cbc\', \'multiverseId\': 132545}, \'multiverseid\': 132545}]', '[{\'name\': \'Schillernder Remasuri\', \'text\': \'Alle Remasuris haben „Immer wenn diese Kreatur als Ziel eines Zauberspruchs bestimmt wird, den ein Gegner kontrolliert, kannst du eine Karte ziehen."\', \'type\': \'Kreatur — Remasuri\', \'flavor\': \'„Wenn er getroffen wird, schimmert seine Haut in verschiedensten Farbsequenzen — ob ich die Bedeutung dieser Signale je herausfinden kann?" —Rukarumel, Beobachtungskladde\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133023&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'342371ec-c095-4102-83f4-1d2fa60afabf\', \'multiverseId\': 133023}, \'multiverseid\': 133023}, {\'name\': \'Fragmentado de opalina\', \'text\': \'Todos los Fragmentados tienen "Siempre que esta criatura sea el objetivo de un hechizo que controla un oponente, puedes robar una carta".\', \'type\': \'Criatura — Fragmentado\', \'flavor\': \'"Cuando es golpeado, su piel brilla con una secuencia de colores; un idioma de señales que pretendo desentrañar." —Rúkarumel, diario de observación\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134528&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'60cfe3c4-e0c2-4aa0-95c8-86a777c16fd7\', \'multiverseId\': 134528}, \'multiverseid\': 134528}, {\'name\': \'Slivoïde opalin\', \'text\': "Tous les slivoïdes ont « À chaque fois que cette créature devient la cible d\'un sort qu\'un adversaire contrôle, vous pouvez piocher une carte. »", \'type\': \'Créature : slivoïde\', \'flavor\': "« Quand il est frappé, sa peau scintille selon une séquence de couleurs — une forme de langage que j\'ai hâte de déchiffrer. » —Rukarumel, journal de recherches", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132722&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8606e9bb-94b9-4e05-9a82-140c294385cd\', \'multiverseId\': 132722}, \'multiverseid\': 132722}, {\'name\': \'Tramutante Opalino\', \'text\': \'Tutti i Tramutanti hanno "Ogniqualvolta questa creatura diventa bersaglio di una magia controllata da un avversario, puoi pescare una carta."\', \'type\': \'Creatura — Tramutante\', \'flavor\': \'"Quando colpito, la sua pelle brilla attraverso sequenze di colore—un linguaggio di segnalazione che sono ansioso di svelare." —Rukarumel, registro delle attività\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133324&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6a80eaca-6c8a-4dee-a3cd-6cb072d8a2ff\', \'multiverseId\': 133324}, \'multiverseid\': 133324}, {\'name\': \'乳白スリヴァー\', \'text\': \'すべてのスリヴァーは「このクリーチャーがいずれかの対戦相手がコントロールする呪文の対象となるたび、あなたはカードを１枚引いてもよい。」の能力を持つ。\', \'type\': \'クリーチャー — スリヴァー\', \'flavor\': \'打撃を受けると、その革は様々な色に変わっていく――解明したい彼らの言葉だ。 ――ルカルメルの観察日誌\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133625&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e3a44150-ea8d-4188-abe3-f9204ddcc632\', \'multiverseId\': 133625}, \'multiverseid\': 133625}, {\'name\': \'Fractius Opalino\', \'text\': \'Todos os Fractius têm "Toda vez que esta criatura se tornar alvo de uma mágica controlada por um oponente, você poderá comprar um card."\', \'type\': \'Criatura — Fractius\', \'flavor\': \'"Quando golpeado, sua pele cintila em seqüências de cores uma língua de sinais que estou louco para desvendar." —Rukarumel, diário de campo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133926&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a5898570-fff9-436c-af51-a9b7f9631e6f\', \'multiverseId\': 133926}, \'multiverseid\': 133926}, {\'name\': \'Опалиновая Щепка\', \'text\': \'Все Щепки обладают способностью "Когда это существо становится целью заклинания под контролем оппонента, вы можете взять карту."\', \'type\': \'Существо — Щепка\', \'flavor\': \'«При нападении их рой мерцает последовательностью цветов сигнальным языком, который мне так хотелось познать», Рукарумель, личный полевой дневник\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134227&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0e397ae2-3e88-4474-b5c2-16c4def58ae4\', \'multiverseId\': 134227}, \'multiverseid\': 134227}, {\'name\': \'清辉裂片妖\', \'text\': \'所有裂片妖具有「每当此生物成为由对手操控的咒语之目标时，你可以抓一张牌。」\', \'type\': \'生物～裂片妖\', \'flavor\': \'「一被碰触，其外皮便闪现多种色彩～我亟欲探究此信号语的意义。」 ～陆卡陆梅的现场日志\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132421&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1ecf860e-b854-49c5-b3e1-e686d57d994f\', \'multiverseId\': 132421}, \'multiverseid\': 132421}]', '[{\'name\': \'Schlangenauge\', \'text\': \'Aufblitzen (Du kannst diesen Zauberspruch zu jedem Zeitpunkt spielen, zu dem du einen Spontanzauber spielen könntest.)Kreaturenverzauberung\\nImmer wenn die verzauberte Kreatur einem Gegner Schaden zufügt, kannst du eine Karte ziehen.\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133024&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e63c7c4c-efd0-4a22-aa72-3ebcbc7650cc\', \'multiverseId\': 133024}, \'multiverseid\': 133024}, {\'name\': \'Ojo de ofidio\', \'text\': \'Destello (Puedes jugar este hechizo en cualquier momento en que pudieras jugar un instantáneo.)\\nEncantar criatura.\\nSiempre que la criatura encantada haga daño de combate a un oponente, puedes robar una carta.\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134529&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4a1ddbb6-e5a5-47e6-99fb-5ada3da5cbef\', \'multiverseId\': 134529}, \'multiverseid\': 134529}, {\'name\': "Œil d\'ophidien", \'text\': \'Flash (Vous pouvez jouer ce sort à tout moment où vous pourriez jouer un éphémère.)\\nEnchanter : créature\\nÀ chaque fois que la créature enchantée inflige des blessures à un adversaire, vous pouvez piocher une carte.\', \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132723&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3a3e3e09-3868-4a20-9e8b-9d7eb7dc468c\', \'multiverseId\': 132723}, \'multiverseid\': 132723}, {\'name\': "Occhio d\'Ofide", \'text\': \'Lampo (Puoi giocare questa magia in ogni momento in cui potresti giocare un istantaneo.)\\nIncanta creatura\\nOgniqualvolta la creatura incantata infligge danno a un avversario, puoi pescare una carta.\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133325&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'758ba396-cf26-41ef-a172-6bb95362953f\', \'multiverseId\': 133325}, \'multiverseid\': 133325}, {\'name\': \'知恵の蛇の眼\', \'text\': \'瞬速 （あなたはこの呪文を、あなたがインスタントをプレイできるときならいつでもプレイしてよい。）\\nエンチャント（クリーチャー）\\nエンチャントされているクリーチャーがいずれかの対戦相手にダメージを与えるたび、あなたはカードを１枚引いてもよい。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133626&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f6d98a41-e61c-4cdf-a1bf-d08c7c93d39d\', \'multiverseId\': 133626}, \'multiverseid\': 133626}, {\'name\': \'Olho Ofídico\', \'text\': \'Lampejo (Você poderá jogar esta mágica a qualquer momento em que puder jogar uma mágica instantânea.)\\nEncantar Criatura\\nToda vez que a criatura encantada causar dano de combate a um oponente, você poderá comprar um card.\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133927&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bf4e3bbf-9b79-49e5-9df6-ceccbe04bc4c\', \'multiverseId\': 133927}, \'multiverseid\': 133927}, {\'name\': \'Глаз Аспида\', \'text\': \'Миг (Вы можете играть это заклинание в любое время когда вы можете играть мгновенные заклинания.)\\nЗачаровать существо\\nКогда зачарованное существо наносит повреждения оппоненту, вы можете взять карту.\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134228&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b68885c1-e0ec-480c-8324-a58bd7e7821f\', \'multiverseId\': 134228}, \'multiverseid\': 134228}, {\'name\': \'欧菲迪安蛇眼\', \'text\': \'闪现（你可以于你能够使用瞬间的时机下使用此咒语。）\\n生物结界\\n每当受此结界的生物向对手造成伤害时，你可以抓一张牌\', \'type\': \'结界～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132422&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1c27d5db-51f4-4a8f-b3d6-c2797ca9a852\', \'multiverseId\': 132422}, \'multiverseid\': 132422}]', '[{\'name\': \'Schmelzstein-Wegbahner\', \'text\': \'{1}{R}, {T}, wirf eine Karte aus deiner Hand ab: Eine Kreatur deiner Wahl erhält +1/-1 und Eile bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Spruchwandler\', \'flavor\': \'Nachdem die Zeit der Evincare abgelaufen war, wurde der Schmelzstein unberechenbar und wild und damit zu einem perfekten Werkzeug für Magier, die eher verzweifelt als weise waren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132935&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'87c21563-0255-44a3-826b-b68355bc3b87\', \'multiverseId\': 132935}, \'multiverseid\': 132935}, {\'name\': \'Canalizador de piedra variable\', \'text\': \'{1}{R}, {T}, descartar una carta: La criatura objetivo obtiene +1/-1 y gana la habilidad de prisa hasta el final del turno.\', \'type\': \'Criatura — Cambiahechizos humano\', \'flavor\': \'Sin los évincar, la piedra variable se hizo errática y salvaje, una fuente de poder para magos más desesperados que sabios.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134440&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d8ba87ec-71bf-4a56-a1aa-6b5c80d065b0\', \'multiverseId\': 134440}, \'multiverseid\': 134440}, {\'name\': \'Canaliseur de fluipierre\', \'text\': "{1}{R}, {T}, défaussez-vous d\'une carte : La créature ciblée gagne +1/-1 et acquiert la célérité jusqu\'à la fin du tour.", \'type\': \'Créature : humain et sortisan\', \'flavor\': \'Avec la disparition des incarmals, la fluipierre devint sauvage et peu fiable, une source de puissance pour des mages plus désespérés que sages.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132634&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1832a221-e221-4e9f-a4fd-c1e3eade456f\', \'multiverseId\': 132634}, \'multiverseid\': 132634}, {\'name\': \'Incanalatore di Mutaroccia\', \'text\': \'{1}{R}, {T}, Scarta una carta: Una creatura bersaglio prende +1/-1 e ha rapidità fino alla fine del turno.\', \'type\': \'Creatura — Mutamagia Umano\', \'flavor\': \'Con gli evincari spariti, mutaroccia divenne imprevedibile e selvaggia, una fonte di potere per i maghi più disperati che saggi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133236&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b3833205-88f3-44d4-be24-a512adb3849e\', \'multiverseId\': 133236}, \'multiverseid\': 133236}, {\'name\': \'流動石の媒介者\', \'text\': \'{1}{R}, {T}, カードを１枚捨てる：クリーチャー１体を対象とする。それはターン終了時まで＋１/－１の修整を受けるとともに速攻を得る。\', \'type\': \'クリーチャー — 人間・スペルシェイパー\', \'flavor\': \'エヴィンカーが去って、流動石はさらに荒々しく移ろいやすくなり、理性よりも必死さが勝った魔道士の力の源となった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133537&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f0885afb-081d-4b3c-ab97-be3412530067\', \'multiverseId\': 133537}, \'multiverseid\': 133537}, {\'name\': \'Canalizador de Rochafluente\', \'text\': \'{1}{R}, {T}, Descarte um card: A criatura alvo recebe +1/-1 e recebe ímpeto até o final do turno.\', \'type\': \'Criatura — Magimodelador Humano\', \'flavor\': \'Com o fim dos evincars, as rochafluentes tornaram-se instáveis e selvagens, uma fonte de poder para magos mais desesperados que sábios.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133838&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1389ab49-d537-40d8-91e7-5960ce38b4bb\', \'multiverseId\': 133838}, \'multiverseid\': 133838}, {\'name\': \'Преобразователь Магического Камня\', \'text\': \'{1}{R}, {T}, Сбросьте карту: Целевое существо получает +1/-1 и Ускорение до конца хода.\', \'type\': \'Существо — Человек Заклинатель\', \'flavor\': \'После ухода очевидности в основание легли эксцентричность и дикость источники силы для магов скорее ненадежные, чем разумные.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134139&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'42239981-dcf5-4c7a-b269-ee616df2d61c\', \'multiverseId\': 134139}, \'multiverseid\': 134139}, {\'name\': \'液石通递人\', \'text\': \'{1}{R}，{T}，弃一张牌：目标生物得+1/-1且获得敏捷异能直到回合结束。\', \'type\': \'生物～人类／塑法师\', \'flavor\': \'液石在大魔将死后变得更加乖戾，也成为不顾后果的法师之力量来源。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132333&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'153ad0e0-3181-4971-819b-06ad56acbf3d\', \'multiverseId\': 132333}, \'multiverseid\': 132333}]', '[{\'name\': \'Schwarmstein\', \'text\': \'Kreaturen, die du kontrollierst, sind zusätzlich zu ihren anderen Kreaturentypen auch Remasuris.\', \'type\': \'Artefakt\', \'flavor\': \'Die Evincare von Rath verwendeten Schwarmsteine, um die Remasuris zu kontrollieren, aber bei der Überlagerung geriet diese Macht in unwissende Hände. Jetzt erzeugen die Steine nicht Meister, sondern Sklaven.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132967&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cac2683a-7f39-4a2d-92d5-dc67cfe36797\', \'multiverseId\': 132967}, \'multiverseid\': 132967}, {\'name\': \'Piedra de colmena\', \'text\': \'Las criaturas que controlas son Fragmentados además de sus otros tipos de criatura.\', \'type\': \'Artefacto\', \'flavor\': \'Los évincar de Rath usaban las piedras de colmena para controlar a los fragmentados, pero la sobreposición puso su poder en manos ignorantes. Ahora las piedras no tienen amos, sino esclavos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134472&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3f95b43f-5018-4b5f-b342-c43d3ea3576a\', \'multiverseId\': 134472}, \'multiverseid\': 134472}, {\'name\': \'Galessaim\', \'text\': \'Les créatures que vous contrôlez sont des slivoïdes en plus de leurs autres types de créature.\', \'type\': \'Artefact\', \'flavor\': "Les incarmals de Rajh utilisaient les galessaims pour contrôler les slivoïdes, mais leur pouvoir leur échappa. Aujourd\'hui, ces pierres ne font pas les maîtres, mais les esclaves.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132666&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0f739534-7694-49a3-90a1-55c9da8a85d3\', \'multiverseId\': 132666}, \'multiverseid\': 132666}, {\'name\': \'Pietralveare\', \'text\': \'Le creature che controlli sono Tramutanti in aggiunta ai propri altri tipi di creatura.\', \'type\': \'Artefatto\', \'flavor\': \'Gli evincari di Rath usavano le pietralveari per controllare i tramutanti, ma la sovrapposizione mise il loro potere in mani inconsapevoli. Ora le pietre non ti rendono padrone, ma schiavo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133268&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8534005b-f074-452b-8e16-0a6e8819be13\', \'multiverseId\': 133268}, \'multiverseid\': 133268}, {\'name\': \'巣石\', \'text\': \'あなたがコントロールするクリーチャーは、それの他のクリーチャー・タイプに加えてスリヴァーでもある。\', \'type\': \'アーティファクト\', \'flavor\': \'ラースのエヴィンカーは巣石でスリヴァーを操っていたが、次元被覆のためにその力は何とも知らない者の手に渡ってしまった。 今では石は主を持たないが、奴隷を従えている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133569&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c6299610-93c6-4073-99fb-15e573378f19\', \'multiverseId\': 133569}, \'multiverseid\': 133569}, {\'name\': \'Pedra-de-Colônia\', \'text\': \'As criaturas que você controla são Fractius, além de seus outros tipos de criatura.\', \'type\': \'Artefato\', \'flavor\': \'Os evincars de Rath usaram pedras-de-colônia para controlar os fractius, mas a sobreposição colocou seu poder em mãos negligentes. Agora as pedras não criam mestres, mas escravos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133870&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b48e4bfd-8515-4b54-bdf1-a9906a6be643\', \'multiverseId\': 133870}, \'multiverseid\': 133870}, {\'name\': \'Камень Роя\', \'text\': \'Существа под вашим контролем являются Щепками в дополнение к их другим типам существ.\', \'type\': \'Артефакт\', \'flavor\': \'Эвинкары Рата использовали этот камень, чтобы контролировать щепки, но беспечность привела его в небрежные руки. Сейчас камни превращают хозяев в рабов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134171&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'80a61a99-de2b-4fc8-b62e-07f3b1ef0eea\', \'multiverseId\': 134171}, \'multiverseid\': 134171}, {\'name\': \'母巢石\', \'text\': \'由你操控的生物额外具有「裂片妖」此生物类别。\', \'type\': \'神器\', \'flavor\': \'瑞斯大魔将利用母巢石来使唤裂片妖，但时空覆盖让这力量落入愚者之手。 现在它造就的并非主宰，而是奴隶。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132365&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0a3d2ea2-a7e5-4c01-a8f4-25f7b660fcfc\', \'multiverseId\': 132365}, \'multiverseid\': 132365}]', '[{\'name\': \'Schwefelschwall\', \'text\': \'Der Schwefelschwall fügt jeder Kreatur und jedem Spieler 2 Schadenspunkte zu. Spielst du diesen Zauberspruch während deiner Hauptphase, fügt der Schwefelschwall stattdessen allen Kreaturen und allen Spielern 3 Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'Die Keldonier bauten die Abzugskanäle, durch die giftige Dämpfe aufstiegen, geschickt in ihre Verteidigungsanlagen ein.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133099&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'100f8ec9-c3ec-4035-a80f-95861bb6a01f\', \'multiverseId\': 133099}, \'multiverseid\': 133099}, {\'name\': \'Ráfaga sulfurosa\', \'text\': \'La Ráfaga sulfurosa hace 2 puntos de daño a cada criatura y a cada jugador. Si jugaste este hechizo durante tu fase principal, en vez de eso, la Ráfaga sulfurosa hace 3 puntos de daño a cada criatura y a cada jugador.\', \'type\': \'Instantáneo\', \'flavor\': \'Los keldon usaban los respiraderos tóxicos que se abrían en la tierra para mejorar la defensa de sus hogares.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134604&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'74889d3f-83a1-496d-aa84-97f85d87dba1\', \'multiverseId\': 134604}, \'multiverseid\': 134604}, {\'name\': \'Salve sulfureuse\', \'text\': \'La Salve sulfureuse inflige 2 blessures à chaque créature et à chaque joueur. Si vous avez joué ce sort pendant votre phase principale, la Salve sulfureuse inflige 3 blessures à chaque créature et à chaque joueur à la place.\', \'type\': \'Éphémère\', \'flavor\': \'Les Keldes utilisaient les ventilations toxiques de la terre pour renforcer leurs défenses.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132798&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9f639ceb-bdbc-422a-996e-2d05edab2738\', \'multiverseId\': 132798}, \'multiverseid\': 132798}, {\'name\': \'Esplosione Sulfurea\', \'text\': "L\'Esplosione Sulfurea infligge 2 danni a ogni creatura e a ogni giocatore. Se hai giocato questa magia durante la tua fase principale, l\'Esplosione Sulfurea infligge invece 3 danni a ogni creatura e a ogni giocatore.", \'type\': \'Istantaneo\', \'flavor\': \'I Keldon sfruttavano gli sfiatatoi tossici nelle crepe della terra per rafforzare le loro difese domestiche.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133400&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'935c4c5b-18d3-492c-b8fb-d050f7b9db91\', \'multiverseId\': 133400}, \'multiverseid\': 133400}, {\'name\': \'硫黄破\', \'text\': \'硫黄破は各クリーチャーと各プレイヤーに、それぞれ２点のダメージを与える。 あなたがこの呪文をあなたのメイン・フェイズ中にプレイした場合、代わりに硫黄破は各クリーチャーと各プレイヤーに、それぞれ３点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'ケルド人は、地割れから噴き出す瘴気を本拠の守りの強化に使っている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133701&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1cc9c24d-0167-492f-890b-826126bc77c6\', \'multiverseId\': 133701}, \'multiverseid\': 133701}, {\'name\': \'Explosão Sulfurosa\', \'text\': \'Explosão Sulfurosa causa 2 pontos de dano a cada criatura e a cada jogador. Se você jogou esta mágica durante sua fase principal, em vez disso, Explosão Sulfurosa causa 3 pontos de dano a cada criatura e a cada jogador.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os keldonianos usaram as brechas tóxicas no solo rachado para reforçar as defesas de suas casas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134002&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'77b82b23-f8ed-4a49-9404-358cd8075956\', \'multiverseId\': 134002}, \'multiverseid\': 134002}, {\'name\': \'Серный Взрыв\', \'text\': \'Серный Взрыв наносит 2 повреждения каждому существу и каждому игроку. Если вы играете это заклинание в своей основной фазе, Серный Взрыв вместо этого наносит 3 повреждения каждому существу и каждому игроку.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Келдонцы использовали токсические выбросы из разломов земли для укрепления защиты своих домов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134303&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'da6ed6fe-c62e-4544-ace6-ac25add9ba05\', \'multiverseId\': 134303}, \'multiverseid\': 134303}, {\'name\': \'硫磺冲击波\', \'text\': \'硫磺冲击波对每个生物和牌手造成2点伤害。 如果你在你的行动阶段使用此咒语，则改为硫磺冲击波对每个生物和牌手造成3点伤害。\', \'type\': \'瞬间\', \'flavor\': \'凯尔顿人民利用地表喷出毒气的裂口来补强家乡的防御工事。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132497&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'26773a21-7668-4573-a35c-896cb6fcd036\', \'multiverseId\': 132497}, \'multiverseid\': 132497}]', '[{\'name\': \'Schwindsucht\', \'text\': \'Zerstöre eine Kreatur deiner Wahl. Ihr Beherrscher verliert Lebenspunkte in Höhe ihrer Stärke plus ihrer Widerstandskraft.\\nAussetzen 5 {1}{B} (Statt diese Karte aus deiner Hand zu spielen, kannst du {1}{B} bezahlen, sie ganz aus dem Spiel entfernen und fünf Zeitmarken auf sie legen. Entferne zu Beginn deines Versorgungssegments eine Zeitmarke von ihr. Wenn du die letzte Zeitmarke entfernst, spiele die Karte, ohne ihre Manakosten zu bezahlen.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133035&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e7d3afc5-303f-42e4-928d-6d80b5d457d9\', \'multiverseId\': 133035}, \'multiverseid\': 133035}, {\'name\': \'Tisis\', \'text\': \'Destruye la criatura objetivo. Su controlador pierde una cantidad de vida igual a su fuerza más su resistencia.\\nSuspender 5—{1}{B} (En lugar de jugar esta carta de tu mano, puedes pagar {1}{B} y removerla del juego con cinco contadores de tiempo sobre ella. Al comienzo de tu mantenimiento, remueve un contador de tiempo. Cuando remuevas el último, juégala sin pagar su coste de maná.)\', \'type\': \'Conjuro\', \'flavor\': \'Los chamanes más fervorosos se entregan voluntariamente a los conmocionadores con la esperanza de vislumbrar qué depara el futuro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134540&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'655fb19b-db32-49fb-8166-30f329f8b9e9\', \'multiverseId\': 134540}, \'multiverseid\': 134540}, {\'name\': \'Phtisie\', \'text\': \'Détruisez la créature ciblée. Son contrôleur perd un nombre de points de vie égal à sa force plus son endurance.\\nSuspension 5 — {1}{B} (Plutôt que jouer cette carte depuis votre main, vous pouvez payer {1}{B} et la retirer de la partie avec cinq marqueurs « temps » sur elle. Au début de votre entretien, retirez un marqueur « temps ». Quand vous retirez le dernier, jouez cette carte sans payer son coût de mana.)\', \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132734&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7ac87c59-976e-493a-ae0e-32fde3ea0869\', \'multiverseId\': 132734}, \'multiverseid\': 132734}, {\'name\': \'Tisi\', \'text\': "Distruggi una creatura bersaglio. Il suo controllore perde un ammontare di punti vita pari alla sua forza più la sua costituzione.\\nSospendere 5—{1}{B} (Invece di giocare questa carta dalla tua mano, puoi pagare {1}{B} e rimuoverla dal gioco con cinque segnalini tempo su di essa. All\'inizio del tuo mantenimento, rimuovi un segnalino tempo. Quando rimuovi l\'ultimo, gioca la carta senza pagare il suo costo di mana.)", \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133336&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e156966c-24e0-479f-9875-69c2ad2861aa\', \'multiverseId\': 133336}, \'multiverseid\': 133336}, {\'name\': \'結核\', \'text\': \'クリーチャー１体を対象とし、それを破壊する。 それのコントローラーは、それのパワーにそれのタフネスを加えた値に等しい点数のライフを失う。\\n待機 ５―{1}{B} （これをあなたの手札からプレイするのではなく、{1}{B}を支払ってゲームから取り除き、その上に時間カウンターを５個置いてもよい。 あなたのアップキープの開始時に、時間カウンターを１個取り除く。 最後の１個を取り除いたとき、あなたはそれをマナ・コストを支払わずにプレイする。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133637&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'926b75f2-1655-4a66-a802-14573da9a930\', \'multiverseId\': 133637}, \'multiverseid\': 133637}, {\'name\': \'Tísica\', \'text\': \'Destrua a criatura alvo. Seu controlador perde uma quantidade de pontos de vida igual ao seu poder mais a sua resistência.\\nSuspender 5—{1}{B} (Em vez de jogar este card da sua mão, você pode pagar {1}{B} e removê-lo do jogo com cinco marcadores temporais sobre ele. No início de sua manutenção, remova um marcador temporal. Quando remover o último, jogue-o sem pagar seu custo de mana.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133938&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b05be051-b6e4-4979-bfea-d00c14df92d0\', \'multiverseId\': 133938}, \'multiverseid\': 133938}, {\'name\': \'Чахотка\', \'text\': \'Уничтожьте целевое существо. Контролирующий его игрок теряет жизнь, равную сумме силы и защиты этого существа.\\nОтсрочка 5—{1}{B} (Вместо того чтобы сыграть эту карту из вашей руки, вы можете заплатить {1}{B} и удалить ее из игры с пятью временными жетонами на ней. В начале вашего шага поддержки удалите один временной жетон. После удаления последнего жетона сыграйте эту карту без оплаты ее мана-стоимости.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134239&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3f2486b0-0cbc-4f29-8816-9d76aa90af45\', \'multiverseId\': 134239}, \'multiverseid\': 134239}, {\'name\': \'痨病\', \'text\': \'消灭目标生物。 其操控者失去等同于其力量与防御力加总的生命。\\n延缓5～{1}{B}（除了从你手上使用此牌，你可以支付{1}{B}并将此牌移出对战，且上面有五个计时指示物。 在你的维持开始时，从其上移去一个计时指示物。 当你移去最后一个时，则使用它且不需支付其法术力费用。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132433&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'41457bea-56d2-4ff4-a461-c4b132978909\', \'multiverseId\': 132433}, \'multiverseid\': 132433}]', '[{\'name\': \'Scrybwaldläufer\', \'text\': \'Aufblitzen (Du kannst diesen Zauberspruch zu jedem Zeitpunkt spielen, zu dem du einen Spontanzauber spielen könntest.)\\nFliegend, Schutz vor Blau\\nBringe einen Wald, den du kontrollierst, auf die Hand seines Besitzers zurück: Enttappe eine Kreatur deiner Wahl. Spiele diese Fähigkeit nur einmal pro Zug.\', \'type\': \'Kreatur — Feenwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133066&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d6515fd0-5ccb-4adb-8235-a07dced78de7\', \'multiverseId\': 133066}, \'multiverseid\': 133066}, {\'name\': \'Exploradora de Scryb\', \'text\': \'Destello (Puedes jugar este hechizo en cualquier momento en que pudieras jugar un instantáneo.)\\nVuela, protección contra azul.\\nRegresar un bosque que controlas a la mano de su propietario: Endereza la criatura objetivo. Juega esta habilidad sólo una vez cada turno.\', \'type\': \'Criatura — Hada\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134571&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3068d6ab-69bf-48c8-8321-33f7b5c17b55\', \'multiverseId\': 134571}, \'multiverseid\': 134571}, {\'name\': \'Ranger de la Scrutaie\', \'text\': "Flash (Vous pouvez jouer ce sort à tout moment où vous pourriez jouer un éphémère.)\\nVol, protection contre le bleu\\nRenvoyez une forêt que vous contrôlez dans la main de son propriétaire : Dégagez la créature ciblée. Ne jouez cette capacité qu\'une seule fois par tour.", \'type\': \'Créature : peuple fée\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132765&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'628517f8-ce8d-45f6-9aef-08333bee4a1d\', \'multiverseId\': 132765}, \'multiverseid\': 132765}, {\'name\': \'Ranger di Scryb\', \'text\': \'Lampo (Puoi giocare questa magia in ogni momento in cui potresti giocare un istantaneo.)\\nVolare, protezione dal blu\\nFai tornare una Foresta che controlli in mano al suo proprietario: STAPpa una creatura bersaglio. Gioca questa abilità solo una volta per turno.\', \'type\': \'Creatura — Spiritello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133367&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5dda3b52-b17b-483e-aa64-844ac6761d41\', \'multiverseId\': 133367}, \'multiverseid\': 133367}, {\'name\': \'スクリブのレインジャー\', \'text\': \'瞬速 （あなたはこの呪文を、あなたがインスタントをプレイできるときならいつでもプレイしてよい。）\\n飛行、プロテクション（青）\\nあなたがコントロールする森を１つオーナーの手札に戻す：クリーチャー１体を対象とし、それをアンタップする。 この能力は、毎ターン１回のみプレイできる。\', \'type\': \'クリーチャー — フェアリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133668&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'602268fa-964a-4643-a056-b2ece5d5aea5\', \'multiverseId\': 133668}, \'multiverseid\': 133668}, {\'name\': \'Patrulheira de Scryb\', \'text\': \'Lampejo (Você poderá jogar esta mágica a qualquer momento em que puder jogar uma mágica instantânea.)\\nVoar, proteção contra o azul\\nDevolva uma Floresta que você controla para a mão de seu dono: Desvire a criatura alvo. Use esta habilidade apenas uma vez a cada turno.\', \'type\': \'Criatura — Fada\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133969&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a9e3ead4-02a6-40e6-a163-1b3a8e97d817\', \'multiverseId\': 133969}, \'multiverseid\': 133969}, {\'name\': \'Скрибский Лесничий\', \'text\': \'Миг (Вы можете играть это заклинание в любое время когда вы можете играть мгновенные заклинания.)\\nПолет, защита от синего\\nВерните Лес под вашим контролем в руку владельца: Разверните целевое существо. Играйте эту способность лишь один раз на каждом ходу.\', \'type\': \'Существо — Фея\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134270&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b3d2483e-930b-4c03-8551-6082374c14d3\', \'multiverseId\': 134270}, \'multiverseid\': 134270}, {\'name\': \'斯特巡林者\', \'text\': \'闪现（你可以于你能够使用瞬间的时机下使用此咒语。）\\n飞行，反蓝保护\\n将由你操控的一个树林移回其拥有者手上：重置目标生物。 此异能每回合中只能使用一次。\', \'type\': \'生物～仙灵\', \'flavor\': \'干枯大地依旧保护这少数诚心为家园奉献的灵魂。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132464&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e150bcd0-fd28-4dde-a98d-5f4bc4646d29\', \'multiverseId\': 132464}, \'multiverseid\': 132464}]', "[{'name': 'Seelenkreislauf', 'text': 'Kreatur-die-du-kontrollierst-Verzauberung\\nImmer wenn die verzauberte Kreatur Schaden zufügt, erhältst du ebenso viele Lebenspunkte dazu.\\nWenn der Seelenkreislauf in einen Friedhof gelegt wird, bringe den Seelenkreislauf auf die Hand seines Besitzers zurück.', 'type': 'Verzauberung — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133083&type=card', 'language': 'German', 'identifiers': {'scryfallId': '121b1fc7-0cc3-49c1-ae70-81b52e23e6c3', 'multiverseId': 133083}, 'multiverseid': 133083}, {'name': 'Ciclo espiritual', 'text': 'Encantar criatura que controlas.\\nSiempre que la criatura encantada haga daño, ganas esa cantidad de vida.\\nCuando el Ciclo espiritual vaya a un cementerio desde el juego, regresa el Ciclo espiritual a la mano de su propietario.', 'type': 'Encantamiento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134588&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'f1839e8c-ce9f-4868-97b4-82c380fc4927', 'multiverseId': 134588}, 'multiverseid': 134588}, {'name': 'Boucle spirituelle', 'text': 'Enchantez une créature que vous contrôlez\\nÀ chaque fois que la créature enchantée inflige des blessures, vous gagnez autant de points de vie.\\nQuand la Boucle spirituelle est mise dans un cimetière depuis le jeu, renvoyez la Boucle spirituelle dans la main de son propriétaire.', 'type': 'Enchantement : aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132782&type=card', 'language': 'French', 'identifiers': {'scryfallId': '88b00fcb-eb4c-4770-b60d-90104d3135c3', 'multiverseId': 132782}, 'multiverseid': 132782}, {'name': 'Ciclo Spirituale', 'text': 'Incanta creatura che controlli\\nOgniqualvolta la creatura incantata infligge danno, guadagni altrettanti punti vita.\\nQuando il Ciclo Spirituale viene messo in un cimitero dal gioco, fai tornare il Ciclo Spirituale in mano al suo proprietario.', 'type': 'Incantesimo — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133384&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '9c22e040-59a5-4b4a-8eee-31fd562aeec3', 'multiverseId': 133384}, 'multiverseid': 133384}, {'name': '魂の因縁', 'text': 'エンチャント（あなたがコントロールするクリーチャー）\\nエンチャントされているクリーチャーがダメージを与えるたび、あなたはそれに等しい点数のライフを得る。\\n魂の因縁が場からいずれかの墓地に置かれたとき、魂の因縁をオーナーの手札に戻す。', 'type': 'エンチャント — オーラ', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133685&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'fd45643e-35ca-4555-9040-8b2f7a0c69d7', 'multiverseId': 133685}, 'multiverseid': 133685}, {'name': 'Laço do Espírito', 'text': 'Encanta uma criatura que você controla\\nToda vez que a criatura encantada causar dano, você ganha aquela quantidade em pontos de vida.\\nQuando Laço do Espírito for colocado no cemitério vindo do jogo, devolva Laço do Espírito para a mão de seu dono.', 'type': 'Encantamento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133986&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '94513e67-2aed-430d-96e3-d819b4194db6', 'multiverseId': 133986}, 'multiverseid': 133986}, {'name': 'Духовный Цикл', 'text': 'Зачаровать существо под вашим контролем\\nКогда зачарованное существо наносит повреждение, вы получаете столько же жизни.\\nКогда Духовный Цикл попадает на кладбище из игры, верните Духовный Цикл в руку его владельца.', 'type': 'Чары — Аура', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134287&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '6523bdea-dac3-4420-8182-7b4b5c700d7b', 'multiverseId': 134287}, 'multiverseid': 134287}, {'name': '心灵连环', 'text': '生物结界（仅限由你操控的生物）\\n每当受此结界的生物造成伤害时，你获得等量的生命。\\n当心灵连环从场上置入坟墓场时，将心灵连环移回其拥有者手上。', 'type': '结界～灵气', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132481&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'be1da945-76dc-4d50-85c9-f35806d33de4', 'multiverseId': 132481}, 'multiverseid': 132481}]", '[{\'name\': \'Sengir-Nosferatu\', \'text\': \'Fliegend\\n{1}{B}, entferne den Sengir-Nosferatu ganz aus dem Spiel: Bringe einen 1/2 schwarzen Fledermausspielstein mit Flugfähigkeit ins Spiel. Er hat „{1}{B}, opfere diese Kreatur: Bringe eine ganz aus dem Spiel entfernte Karte namens Sengir-Nosferatu unter der Kontrolle ihres Besitzers ins Spiel zurück."\', \'type\': \'Kreatur — Vampir\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133069&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e70e3336-ce6a-4610-a40c-3f2e6c6db51f\', \'multiverseId\': 133069}, \'multiverseid\': 133069}, {\'name\': \'Nosferatu de Sengir\', \'text\': \'Vuela.\\n{1}{B}, remover del juego el Nosferatu de Sengir: Pon en juego una ficha de criatura Murciélago negra 1/2 con la habilidad de volar. Tiene "{1}{B}, sacrificar esta criatura: Regresa al juego bajo el control de su propietario una carta llamada Nosferatu de Sengir que esté removida del juego."\', \'type\': \'Criatura — Vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134574&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'788695bd-865b-4d3f-b302-43c069c88d26\', \'multiverseId\': 134574}, \'multiverseid\': 134574}, {\'name\': \'Nosferatu sengien\', \'text\': \'Vol\\n{1}{B}, retirez le Nosferatu sengien de la partie : Mettez en jeu un jeton de créature 1/2 noire Chauve-souris avec le vol. Il a « {1}{B}, sacrifiez cette créature : Renvoyez en jeu sous le contrôle de son propriétaire une carte appelée Nosferatu sengien qui est retirée de la partie. »\', \'type\': \'Créature : vampire\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132768&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fc6221d7-eea0-4aa8-ae3b-d748f94cb272\', \'multiverseId\': 132768}, \'multiverseid\': 132768}, {\'name\': \'Nosferatu di Sengir\', \'text\': \'Volare\\n{1}{B}, Rimuovi dal gioco il Nosferatu di Sengir: Metti in gioco una pedina creatura Pipistrello 1/2 nera con volare. Ha "{1}{B}, Sacrifica questa creatura: Rimetti in gioco sotto il controllo del suo proprietario una carta chiamata Nosferatu di Sengir che è stata rimossa dal gioco."\', \'type\': \'Creatura — Vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133370&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9849405a-9813-4b40-a29e-c9fd88f6ff2a\', \'multiverseId\': 133370}, \'multiverseid\': 133370}, {\'name\': \'センギアの吸血魔\', \'text\': \'飛行\\n{1}{B}, センギアの吸血魔をゲームから取り除く：飛行を持つ黒の１/２のコウモリ・クリーチャー・トークンを１体場に出す。 それは「{1}{B}, このクリーチャーを生け贄に捧げる：ゲームから取り除かれている『センギアの吸血魔』というカード名のカードを、オーナーのコントロール下で場に戻す。」の能力を持つ。\', \'type\': \'クリーチャー — 吸血鬼\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133671&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'136338f7-6d68-4d77-ab52-011779e40714\', \'multiverseId\': 133671}, \'multiverseid\': 133671}, {\'name\': \'Nosferatu de Sengir\', \'text\': \'Voar\\n{1}{B}, Remova Nosferatu de Sengir do jogo: Coloque em jogo uma ficha de criatura preta 1/2 do tipo morcego com a habilidade de voar. Ele tem "{1}{B}, Sacrifique esta criatura: Devolva ao jogo sob o controle de seu dono um card cujo nome seja Nosferatu de Sengir que tenha sido removido do jogo."\', \'type\': \'Criatura — Vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133972&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0c3ec322-002a-48d8-b593-b4ddad8be1d7\', \'multiverseId\': 133972}, \'multiverseid\': 133972}, {\'name\': \'Сенгирский Носферату\', \'text\': \'Полет\\n{1}{B}, Удалите Сенгирского Носферату из игры: Положите одну фишку существа 1/2 черная Летучая-мышь с полетом в игру. Она имеет "{1}{B}, Пожертвуйте это существо: Верните в игру под контролем ее владельца карту с названием Сенгирский Носферату, которая была удалена из игры."\', \'type\': \'Существо — Вампир\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134273&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'077871af-294f-43c8-b5f3-7f1322991d11\', \'multiverseId\': 134273}, \'multiverseid\': 134273}, {\'name\': \'辛格氏吸血妖\', \'text\': \'飞行\\n{1}{B}，将辛格氏吸血妖移出对战：将一个1/2黑色，具飞行异能的蝙蝠衍生物放置进场。 它具有「{1}{B}，牺牲此生物：将一张名称为辛格氏吸血妖、且被移出对战的牌在其拥有者的操控下移回场上。」\', \'type\': \'生物～吸血鬼\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132467&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'14795019-28f3-4228-8a19-9a640ed6c5de\', \'multiverseId\': 132467}, \'multiverseid\': 132467}]', '[{\'name\': \'Serras Rächer\', \'text\': \'Du kannst Serras Rächer nicht in deinem ersten, zweiten oder dritten Zug des Spiels ausspielen.\\nFliegend, Wachsamkeit\', \'type\': \'Kreatur — Engel\', \'flavor\': \'„Diejenigen, die das Leiden ertragen, die den Glauben besitzen, der sie auch durch schlechte Zeiten trägt — sie werden die Erlösung finden." —Das Lied von Allem, Gesang 904\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133070&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'431f4bd0-993b-46d4-b285-8af5cf606eb0\', \'multiverseId\': 133070}, \'multiverseid\': 133070}, {\'name\': \'Vengadora de Serra\', \'text\': \'No puedes jugar la Vengadora de Serra durante tu primer, segundo o tercer turno del juego.\\nVuela, vigilancia.\', \'type\': \'Criatura — Ángel\', \'flavor\': \'"Aquellos que resisten el sufrimiento, aquellos cuya fe brilla en los días más oscuros, ellos verán la salvación." —Canción de Todos, canto 904\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134575&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'98488b82-32ec-41fb-bdc4-7834e2dc7ab2\', \'multiverseId\': 134575}, \'multiverseid\': 134575}, {\'name\': \'Vengeresse de Serra\', \'text\': \'Vous ne pouvez pas jouer la Vengeresse de Serra pendant votre premier, deuxième ou troisième tour de la partie.\\nVol, vigilance\', \'type\': \'Créature : ange\', \'flavor\': \'« Ceux qui supportent la souffrance, ceux dont la foi éclaire les jours maléfiques, ceux-là seront sauvés. » —Geste du Grand Tout, chant 904\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132769&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0bd4144c-48d0-4741-a5e7-cbac00b4cb0b\', \'multiverseId\': 132769}, \'multiverseid\': 132769}, {\'name\': \'Vendicatrice di Serra\', \'text\': \'Non puoi giocare la Vendicatrice di Serra durante il tuo primo, secondo o terzo turno di gioco.\\nVolare, cautela\', \'type\': \'Creatura — Angelo\', \'flavor\': \'"Quelli che resistono di fronte alla sofferenza, quelli la cui fede splende a lungo nei giorni crudeli, questi vedranno la salvezza." —Canzone di Tutti, canto 904\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133371&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'be1ae3c4-6b60-4d31-a2cf-ef60b12c6e93\', \'multiverseId\': 133371}, \'multiverseid\': 133371}, {\'name\': \'セラの報復者\', \'text\': \'あなたはセラの報復者を、このゲームのあなたの第１ターンとあなたの第２ターンとあなたの第３ターンにはプレイできない。\\n飛行、警戒\', \'type\': \'クリーチャー — 天使\', \'flavor\': \'苦難に面し耐える者、邪悪な日々に信仰を持ち続ける者、彼らに救済あらん。 ――「万物の歌」、詩篇九〇四\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133672&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cfd22adc-2d04-4f17-9e45-d23b3b74b556\', \'multiverseId\': 133672}, \'multiverseid\': 133672}, {\'name\': \'Vingador de Serra\', \'text\': \'Você não pode jogar Vingador de Serra durante seu primeiro, segundo ou terceiro turno do jogo.\\nVoar, vigilância\', \'type\': \'Criatura — Anjo\', \'flavor\': \'"Aqueles que resistem em face ao sofrimento, aqueles cuja fé brilha forte em dias sombrios, esses encontrarão a salvação." —Canção de Todos, canto 904\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133973&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f6874261-bee5-414c-b7c7-bc0481a63154\', \'multiverseId\': 133973}, \'multiverseid\': 133973}, {\'name\': \'Мститель из Серры\', \'text\': \'Вы не можете играть Мстителя из Серры на первом, втором или третьем вашем ходу игры.\\nПолет, бдительность\', \'type\': \'Существо — Ангел\', \'flavor\': \'«Те, кого испытывали страданием, те, кого вера сохраняется в эти долгие недобрые дни все они увидят спасение», Песнь Сущего, канта 904\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134274&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6d980b6a-f315-4467-a3eb-6fb70bbe8e61\', \'multiverseId\': 134274}, \'multiverseid\': 134274}, {\'name\': \'撒拉复仇者\', \'text\': \'本盘游戏中，你在你的第一，第二，或第三回合都不能使用撒拉复仇者。\\n飞行，警戒\', \'type\': \'生物～天使\', \'flavor\': \'「在苦难中坚持下去，于黯境里散放信念光芒者，均将见证救赎。」 ～万物之歌，904节\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132468&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'90951df7-7548-4437-9db5-63bb961f7811\', \'multiverseId\': 132468}, \'multiverseid\': 132468}]', '[{\'name\': \'Seuchenremasuri\', \'text\': \'Alle Remasuris haben „Zu Beginn deines Versorgungssegments fügt dir diese Kreatur 1 Schadenspunkt zu."\', \'type\': \'Kreatur — Remasuri\', \'flavor\': \'Ein Remasuri teilt alles mit seinem Schwarm selbst seine Leiden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133038&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'935cd1c2-5114-4ea4-a8dc-08e3b18a5fab\', \'multiverseId\': 133038}, \'multiverseid\': 133038}, {\'name\': \'Fragmentado de la peste\', \'text\': \'Todos los Fragmentados tienen "Al comienzo de tu mantenimiento, esta criatura te hace 1 punto de daño".\', \'type\': \'Criatura — Fragmentado\', \'flavor\': \'Un fragmentado comparte todo con su colmena; incluso sus enfermedades.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134543&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e3738c9f-e2f5-484b-b038-907ec319c8b4\', \'multiverseId\': 134543}, \'multiverseid\': 134543}, {\'name\': \'Slivoïde pestiféré\', \'text\': \'Tous les slivoïdes ont « Au début de votre entretien, cette créature vous inflige 1 blessure. »\', \'type\': \'Créature : slivoïde\', \'flavor\': \'Un slivoïde partage tout avec son essaim — même ses maladies.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132737&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e145b800-89d6-43e5-88bd-5bec87a5af02\', \'multiverseId\': 132737}, \'multiverseid\': 132737}, {\'name\': \'Tramutante della Peste\', \'text\': \'Tutti i Tramutanti hanno "All\\\'inizio del tuo mantenimento, questa creatura ti infligge 1 danno."\', \'type\': \'Creatura — Tramutante\', \'flavor\': \'Un tramutante condivide tutto col suo alveare—perfino le sue piaghe.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133339&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c08bfc51-cfe4-4140-9354-3cf110679db4\', \'multiverseId\': 133339}, \'multiverseid\': 133339}, {\'name\': \'疫病スリヴァー\', \'text\': \'すべてのスリヴァーは「あなたのアップキープの開始時に、このクリーチャーはあなたに１点のダメージを与える。」の能力を持つ。\', \'type\': \'クリーチャー — スリヴァー\', \'flavor\': \'スリヴァーは群れとすべてを分かち合う――苦悩すらも。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133640&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'63b26157-df80-4b34-83f6-c7d4ae903cb7\', \'multiverseId\': 133640}, \'multiverseid\': 133640}, {\'name\': \'Fractius da Praga\', \'text\': \'Todos os Fractius têm "No início de sua manutenção, esta criatura causa 1 ponto de dano a você."\', \'type\': \'Criatura — Fractius\', \'flavor\': \'Um fractius compartilha tudo com a sua colônia até mesmo suas aflições.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133941&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8486742e-9c3a-4290-8c42-fde6c90ac0d7\', \'multiverseId\': 133941}, \'multiverseid\': 133941}, {\'name\': \'Чумная Щепка\', \'text\': \'Все Щепки обладают способностью "В начале вашего шага поддержки это существо наносит вам 1 повреждение."\', \'type\': \'Существо — Щепка\', \'flavor\': \'Щепки разделяют все с их роем даже их злоключения.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134242&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7beb0b24-6bfe-4902-af84-e8c52789596f\', \'multiverseId\': 134242}, \'multiverseid\': 134242}, {\'name\': \'疫病裂片妖\', \'text\': \'所有裂片妖具有「在你的维持开始时，此生物对你造成1点伤害。」\', \'type\': \'生物～裂片妖\', \'flavor\': \'裂片妖与母巢分享一切～连苦恼也不例外。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132436&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a9e9f736-60bc-452c-9230-92584dea0e22\', \'multiverseId\': 132436}, \'multiverseid\': 132436}]', '[{\'name\': \'Sog aus der Ewigkeit\', \'text\': \'Lege eine aufgedeckte Karte deiner Wahl, die ganz aus dem Spiel entfernt ist, auf den Friedhof ihres Besitzers.\', \'type\': \'Spontanzauber\', \'flavor\': \'Drachen bekämpft man am Besten, bevor sie schlüpfen. —Sprichwort der Femeref\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133050&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'afc43d76-e7b4-4274-bb07-33c429868cd3\', \'multiverseId\': 133050}, \'multiverseid\': 133050}, {\'name\': \'Extraer de la eternidad\', \'text\': \'Pon la carta boca arriba objetivo que está removida del juego en el cementerio de su propietario.\', \'type\': \'Instantáneo\', \'flavor\': \'Es mejor lidiar con los dragones antes de que nazcan. —Adagio femeref\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134555&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'824bc1d1-0549-4cd3-b14e-c16709b67e2a\', \'multiverseId\': 134555}, \'multiverseid\': 134555}, {\'name\': "Extraction de l\'éternité", \'text\': \'Mettez la carte face visible ciblée qui est retirée de la partie dans le cimetière de son propriétaire.\', \'type\': \'Éphémère\', \'flavor\': "Il vaut toujours mieux vaincre les dragons avant qu\'ils n\'éclosent. —Adage fémeiref", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132749&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'39c90197-1406-41ac-8c59-a605a1c541df\', \'multiverseId\': 132749}, \'multiverseid\': 132749}, {\'name\': "Richiamo dall\'Eternità", \'text\': \'Metti una carta rimossa dal gioco a faccia in su bersaglio nel cimitero del suo proprietario.\', \'type\': \'Istantaneo\', \'flavor\': \'È meglio sgominare i draghi prima che nascano. —adagio Femeref\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133351&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7485bce0-2236-4fb3-ae62-9af58bdeb3dc\', \'multiverseId\': 133351}, \'multiverseid\': 133351}, {\'name\': \'永遠からの引き抜き\', \'text\': \'ゲームから取り除かれている表向きのカード１枚を対象とし、それをオーナーの墓地に置く。\', \'type\': \'インスタント\', \'flavor\': \'ドラゴンは孵る前に倒せ。 ――フェメレフの諺\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133652&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'144c0aab-7599-4114-a485-8ffacf3397b8\', \'multiverseId\': 133652}, \'multiverseid\': 133652}, {\'name\': \'Arrancar da Eternidade\', \'text\': \'Coloque o card alvo com a face voltada para cima que foi removido do jogo no cemitério de seu dono.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'É melhor conquistar os dragões antes que comecem a chocar. —Provérbio de Femeref\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133953&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e1408cf1-a6ea-465f-84a6-f55fb80eb126\', \'multiverseId\': 133953}, \'multiverseid\': 133953}, {\'name\': \'Возврат из Вечности\', \'text\': \'Положите целевую карту, которая удалена из игры, лицом вверх на кладбище владельца.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Лучше захватить драконов перед тем как они вылупятся», Фемерефская поговорка\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134254&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0645c6f9-7fde-4a77-ba3f-bb1857a17863\', \'multiverseId\': 134254}, \'multiverseid\': 134254}, {\'name\': \'拽入来世\', \'text\': \'将目标牌面朝上、且被移出对战的牌置入其拥有者的坟墓场。\', \'type\': \'瞬间\', \'flavor\': \'想赢过龙，最好是在他们孵出来之前。 ～费米瑞甫格言\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132448&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'03d6bf27-fcfa-4163-94d6-dfc51c0f2ff3\', \'multiverseId\': 132448}, \'multiverseid\': 132448}]', '[{\'name\': \'Sorgfältiges Abwägen\', \'text\': \'Ein Spieler deiner Wahl zieht vier Karten und wirft dann drei Karten ab. Spielst du diesen Zauberspruch während deiner Hauptphase, zieht ein Spieler deiner Wahl stattdessen vier Karten und wirft dann zwei Karten ab.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Weise, die ihre Quellen überprüfen, werden für ihren Eifer meist auch belohnt." —Jhoira, zu Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132881&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'af25859e-5d79-4368-aabc-7092c70c5ba0\', \'multiverseId\': 132881}, \'multiverseid\': 132881}, {\'name\': \'Consideración detallada\', \'text\': \'El jugador objetivo roba cuatro cartas, después descarta tres cartas. Si jugaste este hechizo durante tu fase principal, en vez de eso ese jugador roba cuatro cartas, después descarta dos cartas.\', \'type\': \'Instantáneo\', \'flavor\': \'"Los sabios que se toman el tiempo para verificar sus fuentes se ven recompensados por su diligencia." —Jhoira, a Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134386&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c4c96cbe-7be6-4da7-a529-d4ee92e3c611\', \'multiverseId\': 134386}, \'multiverseid\': 134386}, {\'name\': \'Attention minutieuse\', \'text\': \'Le joueur ciblé pioche quatre cartes, puis se défausse de trois cartes. Si vous avez joué ce sort pendant votre phase principale, ce joueur pioche quatre cartes, puis se défausse de deux cartes à la place.\', \'type\': \'Éphémère\', \'flavor\': \'« Les sages qui prennent le temps de vérifier leurs sources sont récompensés pour leur zèle. » —Djoïra, à Téfeiri\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132580&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8e9273fc-068e-4512-9613-524687fc9d69\', \'multiverseId\': 132580}, \'multiverseid\': 132580}, {\'name\': \'Attenta Riflessione\', \'text\': \'Un giocatore bersaglio pesca quattro carte, poi scarta tre carte. Se hai giocato questa magia durante la tua fase principale, invece quel giocatore pesca quattro carte, poi scarta due carte.\', \'type\': \'Istantaneo\', \'flavor\': \'"I saggi che si prendono il tempo di verificare le loro fonti sono premiati per la loro diligenza." —Jhoira, a Teferi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133182&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'67eebfe9-9ca1-4591-9a39-fac62209905e\', \'multiverseId\': 133182}, \'multiverseid\': 133182}, {\'name\': \'入念な考慮\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーはカードを４枚引き、その後カードを３枚捨てる。 あなたがこの呪文をあなたのメイン・フェイズ中にプレイした場合、代わりにそのプレイヤーはカードを４枚引き、その後カードを２枚捨てる。\', \'type\': \'インスタント\', \'flavor\': \'情報源を調べるのに時間をかける賢者は、その勤勉さが報われるものなのですよ。 ――ジョイラからテフェリーへ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133483&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'781da8eb-4cee-4482-831b-4edcae7bca6e\', \'multiverseId\': 133483}, \'multiverseid\': 133483}, {\'name\': \'Consideração Cuidadosa\', \'text\': \'O jogador alvo compra quatro cards e então descarta três cards. Se você jogou esta mágica durante sua fase principal, em vez disso, o jogador compra quatro cards e então descarta dois cards.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Os sábios que dedicam tempo a verificar suas fontes são recompensados por sua diligência." —Jhoira, para Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133784&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'55f5d532-99e4-4924-99a7-03a1ea572a51\', \'multiverseId\': 133784}, \'multiverseid\': 133784}, {\'name\': \'Внимательное Рассмотрение\', \'text\': \'Целевой игрок берет четыре карты, затем сбрасывает три карты. Если вы сыграли это заклинание во время вашей основной фазы, вместо этого этот игрок берет четыре карты, затем сбрасывает две карты.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Мудрецы, не жалеющие времени на перепроверку источников, получают вознаграждение за свое усердие», Джойра, к Тефери\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134085&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'178e0257-ddd0-49b4-9356-8272c2b107ec\', \'multiverseId\': 134085}, \'multiverseid\': 134085}, {\'name\': \'细心考虑\', \'text\': \'目标牌手抓四张牌，然后弃三张牌。 如果你在你的行动阶段使用此咒语，则改为该牌手抓四张牌，然后弃两张牌。\', \'type\': \'瞬间\', \'flavor\': \'「愿花时间核对来源的智者，都会因勤勉而获益。」 ～尤依拉致泰菲力\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132279&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'34b2ce17-59f1-4658-b08f-01b3947e40d9\', \'multiverseId\': 132279}, \'multiverseid\': 132279}]', '[{\'name\': \'Spektrale Streitmacht\', \'text\': \'Verursacht Trampelschaden\\nImmer wenn die Spektrale Streitmacht angreift, enttappt sie nicht während deines nächsten Enttappsegments, falls der verteidigende Spieler keine schwarzen bleibenden Karten kontrolliert.\', \'type\': \'Kreatur — Elementarwesen, Geist\', \'flavor\': \'„Die Geister der alten Zeiten haben uns nicht ganz ungeschützt gelassen." —Uros, Ältester von Pendelhaven\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133078&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ee6df7b7-3627-486d-a156-493f32e44cec\', \'multiverseId\': 133078}, \'multiverseid\': 133078}, {\'name\': \'Fuerza espectral\', \'text\': \'Arrolla.\\nSiempre que la Fuerza espectral ataque, si el jugador defensor no controla permanentes negros, no se endereza durante tu próximo paso de enderezar.\', \'type\': \'Criatura — Espíritu elemental\', \'flavor\': \'"Los espíritus de antaño no nos han dejado indefensos." —Uros, anciana de Pendelhaven\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134583&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'573519b1-8a76-4848-909e-90082cec09e4\', \'multiverseId\': 134583}, \'multiverseid\': 134583}, {\'name\': \'Force spectrale\', \'text\': \'Piétinement\\nÀ chaque fois que la Force spectrale attaque, si le joueur défenseur ne contrôle pas de permanent noir, elle ne se dégage pas pendant votre prochaine étape de dégagement.\', \'type\': \'Créature : élémental et esprit\', \'flavor\': "« Les esprits d\'antan ne nous ont pas laissé sans défense. » —Uros, doyenne de Pendelhavre", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132777&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5000a57b-0213-4d8e-a65d-154404fba066\', \'multiverseId\': 132777}, \'multiverseid\': 132777}, {\'name\': \'Forza Spettrale\', \'text\': \'Travolgere\\nOgniqualvolta la Forza Spettrale attacca, se il giocatore in difesa non controlla permanenti neri, essa non STAPpa durante il tuo prossimo STAP.\', \'type\': \'Creatura — Spirito Elementale\', \'flavor\': \'"Gli spiriti degli antichi non ci hanno lasciati senza difese." —Uros, Anziana di Pendelhaven\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133379&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1e2d2b02-f3e7-4cbf-bed9-0e4430ded7ba\', \'multiverseId\': 133379}, \'multiverseid\': 133379}, {\'name\': \'幽体の魔力\', \'text\': \'トランプル\\n幽体の魔力が攻撃するたび、防御プレイヤーが黒のパーマネントをコントロールしていない場合、幽体の魔力はあなたの次のアンタップ・ステップにアンタップしない。\', \'type\': \'クリーチャー — エレメンタル・スピリット\', \'flavor\': \'古き精霊は我らを放っておきはせぬ。 ――ペンデルヘイヴンの古老、ユーロス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133680&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c8d4d404-da8b-4bd4-9948-a7da2832dfa9\', \'multiverseId\': 133680}, \'multiverseid\': 133680}, {\'name\': \'Força Espectral\', \'text\': \'Atropelar\\nToda vez que Força Espectral ataca, se o jogador defensor não controla nenhuma permanente preta, ele não desvira durante sua próxima etapa de desvirar.\', \'type\': \'Criatura — Espírito Elemental\', \'flavor\': \'"Os espíritos do passado não nos deixaram desprotegidos." —Uros, ancião de Pendelhaven\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133981&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f7a18282-bc8c-466f-89f4-0085cde03957\', \'multiverseId\': 133981}, \'multiverseid\': 133981}, {\'name\': \'Спектральная Сила\', \'text\': \'Пробивной удар\\nКогда Спектральная Сила атакует, если защищающийся игрок не контролирует ни одного черного перманента, Спектральная Сила не разворачивается на следующем вашем шаге разворота.\', \'type\': \'Существо — Элементаль Дух\', \'flavor\': \'«Духи прошлого все еще не покинули нас на произвол судьбы», Урос, Старец из Пендальхевена\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134282&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e8290d86-4ae6-49cf-8c7d-d1f3a2394d16\', \'multiverseId\': 134282}, \'multiverseid\': 134282}, {\'name\': \'幽灵元气兽\', \'text\': \'践踏\\n每当幽灵元气兽攻击时，若防御牌手未操控黑色永久物，则它于你的下一个重置步骤中不能重置。\', \'type\': \'生物～元素／精怪\', \'flavor\': \'「远古精怪并未弃我们不顾。」 ～潘得庇护地长老尤洛斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132476&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d767149d-4f12-4bdd-ac09-790c9f9cece3\', \'multiverseId\': 132476}, \'multiverseid\': 132476}]', '[{\'name\': \'Spinndrüsenremasuri\', \'text\': \'Alle Remasuris haben „Diese Kreatur kann blocken, als ob sie Flugfähigkeit hätte."\', \'type\': \'Kreatur — Remasuri\', \'flavor\': \'Jede neue Remasurigeneration entwickelt sich weiter, um sich die Eigenschaften der Beute, von der sich ihre Erzeuger ernährt haben, anzueignen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133082&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'56093935-0438-4624-8c5a-bbc90f412c7f\', \'multiverseId\': 133082}, \'multiverseid\': 133082}, {\'name\': \'Fragmentado hilandero\', \'text\': \'Todos los Fragmentados tienen "Esta criatura puede bloquear como si tuviera la habilidad de volar".\', \'type\': \'Criatura — Fragmentado\', \'flavor\': \'Cada nueva generación de fragmentados evoluciona asimilando las fortalezas de las presas que alimentaban a sus progenitores.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134587&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1bf8d2dd-99ca-4076-8c9a-6dfddeb89fc4\', \'multiverseId\': 134587}, \'multiverseid\': 134587}, {\'name\': \'Slivoïde à filière\', \'text\': \'Tous les slivoïdes ont « Cette créature peut bloquer comme si elle avait le vol. »\', \'type\': \'Créature : slivoïde\', \'flavor\': \'Chaque nouvelle génération de slivoïdes évolue pour assimiler les forces des proies dont se nourrissaient leurs progéniteurs.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132781&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2278fa6c-997e-4468-a679-2a8011773994\', \'multiverseId\': 132781}, \'multiverseid\': 132781}, {\'name\': \'Tramutante Filiera\', \'text\': \'Tutti i Tramutanti hanno "Questa creatura può bloccare come se avesse volare."\', \'type\': \'Creatura — Tramutante\', \'flavor\': \'Ogni nuova generazione di tramutanti si evolve per assimilare i punti di forza delle prede di cui si sono nutriti i loro progenitori.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133383&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fe297cc7-8361-4c4e-b4dc-8eee0de0a44b\', \'multiverseId\': 133383}, \'multiverseid\': 133383}, {\'name\': \'紡績スリヴァー\', \'text\': \'すべてのスリヴァーは「このクリーチャーは飛行を持つかのようにブロックできる。」の能力を持つ。\', \'type\': \'クリーチャー — スリヴァー\', \'flavor\': \'新世代のスリヴァーは、自分の祖先が食べた餌食の長所を吸収し進化する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133684&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'565ba6f1-bffe-4368-ac57-d35af5f25627\', \'multiverseId\': 133684}, \'multiverseid\': 133684}, {\'name\': \'Fractius de Fiandeira\', \'text\': \'Todos os Fractius têm "Esta criatura pode bloquear como se tivesse a habilidade de voar."\', \'type\': \'Criatura — Fractius\', \'flavor\': \'Cada nova geração de fractius se desenvolve para assimilar as forças da presa da qual seus progenitores se alimentaram.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133985&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f3911682-a400-4d18-aa9e-7bbcae70c563\', \'multiverseId\': 133985}, \'multiverseid\': 133985}, {\'name\': \'Прядильная Щепка\', \'text\': \'Все Щепки обладают способностью "Это существо может блокировать, как будто оно имеет полет."\', \'type\': \'Существо — Щепка\', \'flavor\': \'Каждое следующее поколение щепок развивалось и ассимилировало силы добычи, которую поедали их родители.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134286&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'91262932-ce32-4249-b428-4f31b1aca0d7\', \'multiverseId\': 134286}, \'multiverseid\': 134286}, {\'name\': \'丝疣裂片妖\', \'text\': \'所有裂片妖具有「此生物能视同具飞行异能地进行阻挡。」\', \'type\': \'生物～裂片妖\', \'flavor\': \'裂片妖能吸收所捕食的猎物长处，演化出新一代品种。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132480&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0b6fb12e-d0da-46bb-a9e2-315eb517b8c4\', \'multiverseId\': 132480}, \'multiverseid\': 132480}]', '[{\'name\': \'Sporensäender Thallid\', \'text\': \'Lege zu Beginn deines Versorgungssegments eine Sporenmarke auf jedes Pilzwesen, das du kontrollierst.\\nEntferne drei Sporenmarken vom Sporensäenden Thalliden: Bringe einen 1/1 grünen Saprolingspielstein ins Spiel.\', \'type\': \'Kreatur — Pilzwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133084&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'146427a1-f703-493c-b68b-4371ac1f97de\', \'multiverseId\': 133084}, \'multiverseid\': 133084}, {\'name\': \'Tálido siembraesporas\', \'text\': \'Al comienzo de tu mantenimiento, pon un contador de espora sobre cada Hongo que controlas.\\nRemover tres contadores de espora del Tálido siembraesporas: Pon en juego una ficha de criatura Saprolín verde 1/1.\', \'type\': \'Criatura — Hongo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134589&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4386eae2-9fe9-4719-8af0-357394a25de3\', \'multiverseId\': 134589}, \'multiverseid\': 134589}, {\'name\': \'Thallidé sèmespore\', \'text\': \'Au début de votre entretien, mettez un marqueur « spore » sur chaque fongus que vous contrôlez.\\nRetirez trois marqueurs « spore » du Thallidé sèmespore : Mettez en jeu un jeton de créature 1/1 verte Saprobionte.\', \'type\': \'Créature : fongus\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132783&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'24fd30a8-a514-452d-9cf0-62c44b859ea8\', \'multiverseId\': 132783}, \'multiverseid\': 132783}, {\'name\': \'Thallid Spargispore\', \'text\': "All\'inizio del tuo mantenimento, metti un segnalino spora su ogni Fungus che controlli.\\nRimuovi tre segnalini spora dalla Thallid Spargispore: Metti in gioco una pedina creatura Saprolingio 1/1 verde.", \'type\': \'Creatura — Fungus\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133385&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eeac8a98-04e1-481f-82b2-5ff4f5e78c34\', \'multiverseId\': 133385}, \'multiverseid\': 133385}, {\'name\': \'胞子撒きのサリッド\', \'text\': \'あなたのアップキープの開始時に、あなたがコントロールする各ファンガスの上に、それぞれ胞子カウンターを１個置く。\\n胞子撒きのサリッドから胞子カウンターを３個取り除く：緑の１/１の苗木クリーチャー・トークンを１体場に出す。\', \'type\': \'クリーチャー — ファンガス\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133686&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3148570f-c67e-48a7-ad24-9be45090e175\', \'multiverseId\': 133686}, \'multiverseid\': 133686}, {\'name\': \'Talídia Semeia-Esporo\', \'text\': \'No início de sua manutenção, coloque um marcador de esporo em cada Fungo que você controla.\\nRemova três marcadores de esporo de Talídia Semeia-Esporo: coloque em jogo uma ficha de criatura verde 1/1 do tipo Saprófita.\', \'type\': \'Criatura — Fungo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133987&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b547416b-8ab7-49fb-a4db-a821440404c1\', \'multiverseId\': 133987}, \'multiverseid\': 133987}, {\'name\': \'Сеящий Споры Таллид\', \'text\': \'В начале вашего шага поддержки положите жетон споры на каждую Плесень под вашим контролем.\\nУдалите три жетона споры с Сеящего Споры Таллида: Положите одну фишку существа 1/1 зеленый Сапролинг в игру.\', \'type\': \'Существо — Плесень\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134288&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d7c32e31-124e-445c-bb9c-3b3eb8e29b71\', \'multiverseId\': 134288}, \'multiverseid\': 134288}, {\'name\': \'孢舞散绿菌\', \'text\': \'在你的维持开始时，在每个由你操控的真菌上放置一个芽孢指示物。\\n从孢舞散绿菌上移去三个芽孢指示物：将一个1/1绿色腐生物衍生物放置进场。\', \'type\': \'生物～真菌\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132482&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2ef33fba-4465-4872-a923-c538200b2a38\', \'multiverseId\': 132482}, \'multiverseid\': 132482}]', "[{'name': 'Sprießen', 'text': 'Bringe einen 1/1 grünen Saprolingspielstein ins Spiel.', 'type': 'Spontanzauber', 'flavor': 'Die Jahrhunderte der zerrissenen Zeit hatten Dominaria seiner natürlichen Abwehrkräfte beraubt, aber die Natur kämpfte mit Armeen, die aus nur wenig mehr als Schmutz und Sonnenlicht entstanden waren, zurück.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133086&type=card', 'language': 'German', 'identifiers': {'scryfallId': '64e860b1-61b8-474b-8141-157feb69c574', 'multiverseId': 133086}, 'multiverseid': 133086}, {'name': 'Germinar', 'text': 'Pon en juego una ficha de criatura Saprolín verde 1/1.', 'type': 'Instantáneo', 'flavor': 'Siglos de conflicto temporal han despojado a Dominaria de sus defensas naturales, pero la naturaleza se defendió con ejércitos que eran poco más que luz de sol y mugre.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134591&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '51651c31-fdbd-4dcb-b9b8-6015bc17181b', 'multiverseId': 134591}, 'multiverseid': 134591}, {'name': 'Bourgeonnement', 'text': 'Mettez en jeu un jeton de créature 1/1 verte Saprobionte.', 'type': 'Éphémère', 'flavor': 'Des siècles de guerre temporelle avaient détruit les défenses naturelles de Dominaria, mais la nature contre-attaqua avec des armées faites de poussière et de lumière solaire.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132785&type=card', 'language': 'French', 'identifiers': {'scryfallId': '5c5d7d4d-7521-4476-9f73-355b097493b2', 'multiverseId': 132785}, 'multiverseid': 132785}, {'name': 'Germoglio', 'text': 'Metti in gioco una pedina creatura Saprolingio 1/1 verde.', 'type': 'Istantaneo', 'flavor': 'Secoli di conflitti temporali hanno privato Dominaria delle sue difese naturali, ma la natura ha reagito con eserciti costruiti con poco più che sporcizia e luce solare.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133387&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ec34a914-20fa-47a7-93ff-2b588f35f710', 'multiverseId': 133387}, 'multiverseid': 133387}, {'name': '芽吹き', 'text': '緑の１/１の苗木クリーチャー・トークンを１体場に出す。', 'type': 'インスタント', 'flavor': '数世紀の間にたびたび起こった戦乱は、ドミナリアの自然の防御を粉々にしたが、自然は埃と太陽の光に手を加えてできた軍団で反撃に出た。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133688&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f8458818-e756-4012-957d-f1430edba913', 'multiverseId': 133688}, 'multiverseid': 133688}, {'name': 'Germinar', 'text': 'Coloque em jogo uma ficha de criatura verde 1/1 do tipo Saprófita.', 'type': 'Mágica Instantânea', 'flavor': 'Séculos de conflitos temporais despiram Dominária de suas defesas naturais, mas a natureza revidou com exércitos criados a partir de pouco mais que sujeira e luz solar.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133989&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7aed6de9-7445-438a-8c49-35d2c4d8b048', 'multiverseId': 133989}, 'multiverseid': 133989}, {'name': 'Росток', 'text': 'Положите одну фишку существа 1/1 зеленый Сапролинг в игру.', 'type': 'Мгновенное заклинание', 'flavor': 'Столетия гражданской войны оставили Доминарию без естественных укрытий, и в ответ природа выступила с армиями, созданными из чего-то более крепкого, чем земля и солнечный свет.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134290&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'a6cf8bd3-6e69-435c-a340-a365bb75deb3', 'multiverseId': 134290}, 'multiverseid': 134290}, {'name': '萌芽', 'text': '将一个1/1绿色腐生物衍生物放置进场。', 'type': '瞬间', 'flavor': '断续争斗数世纪以来，多明纳里亚的大自然几无防卫能力，但大自然用尘垢与日光再加点别的，便能造出回击部队。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132484&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '4f71bd1d-8d9c-4755-914d-0806483a2f28', 'multiverseId': 132484}, 'multiverseid': 132484}]", '[{\'name\': \'Spross des Ur-Drachen\', \'text\': \'Fliegend\\n{2}: Durchsuche deine Bibliothek nach einer Drachenkarte und lege sie auf deinen Friedhof. Falls du das tust, wird der Spross des Ur-Drachen bis zum Ende des Zuges zu einer Kopie dieser Karte. Mische danach deine Bibliothek.\', \'type\': \'Legendäre Kreatur — Drache, Avatar\', \'flavor\': \'„Ich bin vom Blut des Ur-Drachen, das durch alle Drachen fließt."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133064&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'06d1bc0f-a77e-4e77-a9dc-993e50f68d36\', \'multiverseId\': 133064}, \'multiverseid\': 133064}, {\'name\': \'Vástago del ur-dragón\', \'text\': \'Vuela.\\n{2}: Busca en tu biblioteca una carta de Dragón y ponla en tu cementerio. Si lo haces, el Vástago del ur-dragón es una copia de esa carta hasta el final del turno. Luego baraja tu biblioteca.\', \'type\': \'Criatura legendaria — Avatar dragón\', \'flavor\': \'"Yo soy la sangre del ur-dragón, que corre en todos los dragones."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134569&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9b9561c5-94e6-4793-b00b-ba744da504b3\', \'multiverseId\': 134569}, \'multiverseid\': 134569}, {\'name\': "Scion de l\'Ur-Dragon", \'text\': "Vol\\n{2} : Cherchez dans votre bibliothèque une carte de dragon et mettez-la dans votre cimetière. Si vous faites ainsi, le Scion de l\'Ur-Dragon devient une copie de cette carte jusqu\'à la fin du tour. Mélangez ensuite votre bibliothèque.", \'type\': \'Créature légendaire : dragon et avatar\', \'flavor\': "« Je suis le sang de l\'Ur-Dragon qui coule dans les veines de tous les dragons. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132763&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d749682d-66ce-4835-a6c8-6e35aeb6dc12\', \'multiverseId\': 132763}, \'multiverseid\': 132763}, {\'name\': "Discendente dell\'Ur-Drago", \'text\': "Volare\\n{2}: Passa in rassegna il tuo grimorio per una carta Drago e mettila nel tuo cimitero. Se lo fai, il Discendente dell\'Ur-Drago diventa una copia di quella carta fino alla fine del turno. Poi rimescola il tuo grimorio.", \'type\': \'Creatura Leggendaria — Avatar Drago\', \'flavor\': \'"Sono sangue del sangue dell\\\'ur-drago, che scorre nelle vene di tutti i draghi."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133365&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2379b372-fb30-42ef-9f16-1f2dd125ad27\', \'multiverseId\': 133365}, \'multiverseid\': 133365}, {\'name\': \'始祖ドラゴンの末裔\', \'text\': \'飛行\\n{2}：あなたのライブラリーからドラゴン･カードを１枚探し、それをあなたの墓地に置く。 そうした場合、ターン終了時まで始祖ドラゴンの末裔はそのカードのコピーになる。 その後あなたのライブラリーを切り直す。\', \'type\': \'伝説のクリーチャー — ドラゴン・アバター\', \'flavor\': \'我こそは、すべてのドラゴンを流れる始祖ドラゴンの血なり。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133666&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7dd4e8cd-322b-42f9-b139-455273bc3395\', \'multiverseId\': 133666}, \'multiverseid\': 133666}, {\'name\': \'Herdeiro do Ur-Dragão\', \'text\': \'Voar\\n{2}: Procure em seu grimório por um card de Dragão e coloque-o em seu cemitério. Se fizer isso, Herdeiro do Ur-Dragão se tornará uma cópia daquele card até o final do turno. Depois, embaralhe seu grimório.\', \'type\': \'Criatura Lendária — Avatar Dragão\', \'flavor\': \'"Eu sou o sangue do ur-dragão, fluindo por toda a espécie dos dragões."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133967&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'88a4b76d-8f1d-46a6-8fd7-e9faf9c1fdef\', \'multiverseId\': 133967}, \'multiverseid\': 133967}, {\'name\': \'Наследник Прадраконов\', \'text\': \'Полет\\n{2}: Поищите в вашей библиотеке карту Дракона и положите ее на ваше кладбище. Если вы сделали это, Наследник Прадраконов становится копией этой карты до конца хода. После этого перетасуйте вашу библиотеку.\', \'type\': \'Легендарное Существо — Дракон Аватар\', \'flavor\': \'«Я кровь прадраконов, текущая во всех драконах».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134268&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f90a6a94-a865-4d1b-8082-33de6ddf6ce0\', \'multiverseId\': 134268}, \'multiverseid\': 134268}, {\'name\': \'太初龙后裔\', \'text\': \'飞行\\n{2}：从你的牌库中搜寻一张龙牌并将它置入你的坟墓场。 若你如此作，太初龙后裔成为该牌的复制直到回合结束。 然后将你的牌库洗牌。\', \'type\': \'传奇生物～龙／圣者\', \'flavor\': \'「吾乃太初龙之血，奔流于龙族间。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132462&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'755b9acf-f075-4a2e-a1da-fe9dff6ddfb0\', \'multiverseId\': 132462}, \'multiverseid\': 132462}]', '[{\'name\': \'Spukhymne\', \'text\': \'Ein Spieler deiner Wahl wirft zwei Karten aus seiner Hand ab. Spielst du diese Karte während deiner Hauptphase, wirft dieser Spieler stattdessen vier Karten ab.\', \'type\': \'Spontanzauber\', \'flavor\': \'Die Melodie der Hymne ist noch die gleiche wie zu Tourachs Zeiten, aber der Text änderte sich immer wieder, um sich an die Ängste der Zuhörer anzupassen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132964&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b4970155-0c21-4f81-8837-02028b9797c5\', \'multiverseId\': 132964}, \'multiverseid\': 132964}, {\'name\': \'Himno perturbador\', \'text\': \'El jugador objetivo descarta dos cartas. Si jugaste este hechizo durante tu fase principal, en vez de eso, ese jugador descarta cuatro cartas.\', \'type\': \'Instantáneo\', \'flavor\': \'La melodía del himno persiste desde la época de Tourach, pero la letra cambió para invocar los miedos de cada oyente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134469&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c8643e47-a92b-4556-86d7-ef1f85b76be4\', \'multiverseId\': 134469}, \'multiverseid\': 134469}, {\'name\': \'Hymne obsédant\', \'text\': \'Le joueur ciblé se défausse de deux cartes. Si vous avez joué cette carte pendant votre phase principale, ce joueur se défausse de quatre cartes à la place.\', \'type\': \'Éphémère\', \'flavor\': "La mélodie persiste depuis l\'époque de Tourach, mais les paroles changent pour invoquer les phobies de ceux qui l\'écoutent.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132663&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2749e3d6-26a3-46fe-ad5d-73bd0612ae0f\', \'multiverseId\': 132663}, \'multiverseid\': 132663}, {\'name\': \'Inno Ossessionante\', \'text\': \'Un giocatore bersaglio scarta due carte. Se hai giocato questa carta durante la tua fase principale, quel giocatore scarta invece quattro carte.\', \'type\': \'Istantaneo\', \'flavor\': "La melodia dell\'inno era rimasta tale fin dai tempi di Tourach, ma le parole erano cambiate per evocare le fobie di ogni ascoltatore.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133265&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b666a95a-fa4f-4851-98ce-970fbb49b446\', \'multiverseId\': 133265}, \'multiverseid\': 133265}, {\'name\': \'消えない賛歌\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーはカードを２枚捨てる。 あなたがこのカードをあなたのメイン・フェイズにプレイした場合、代わりにそのプレイヤーはカードを４枚捨てる。\', \'type\': \'インスタント\', \'flavor\': \'賛歌の旋律はトーラックの頃から変わらないが、その詩は聞いた者たちに恐怖を呼び起こすように変えられている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133566&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'25a6575c-466f-4f12-85da-9b3512ec34b1\', \'multiverseId\': 133566}, \'multiverseid\': 133566}, {\'name\': \'Hino Assombrado\', \'text\': \'O jogador alvo descarta dois cards. Se você jogou este card durante sua fase principal, em vez disso, aquele jogador descarta quatro cards.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'A melodia do hino perseverou desde o tempo de Tourach, mas as palavras foram alteradas para invocar as fobias de cada ouvinte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133867&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7dd04b88-b2d4-4c4c-854c-a9e2e3606d54\', \'multiverseId\': 133867}, \'multiverseid\': 133867}, {\'name\': \'Навязчивый Гимн\', \'text\': \'Целевой игрок сбрасывает две карты. Если вы сыграли это заклинание во время вашей основной фазы, то вместо двух этот игрок сбрасывает четыре карты.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Мелодия этого гимна сохранилась со времен Тораха, но его новый текст вызывает страх в каждом слушателе.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134168&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9286d49a-ec9c-4882-85e2-7f378b33cd67\', \'multiverseId\': 134168}, \'multiverseid\': 134168}, {\'name\': \'乱心赞歌\', \'text\': \'目标牌手弃两张牌。 如果你在你的行动阶段使用此牌，则改为该牌手弃四张牌。\', \'type\': \'瞬间\', \'flavor\': \'这赞歌的旋律自妥拉克的时代以来都没变过，但词句则经历多次修改，藉以挑起听闻者最深的恐惧。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132362&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fce09650-5274-4653-bb45-b8cbab310d55\', \'multiverseId\': 132362}, \'multiverseid\': 132362}]', '[{\'name\': \'Stachelbesetzter Remasuri\', \'text\': \'Alle Remasuris haben „{T}: Diese Kreatur fügt einer angreifenden oder blockenden Kreatur deiner Wahl 1 Schadenspunkt zu."\', \'type\': \'Kreatur — Remasuri\', \'flavor\': \'„Sie belagern uns schon lange, aber uns geht die Munition nicht aus. Gerade die Leichen unserer Gegner können wir gut einsetzen." —Adom Capashen, Benalischer Held\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133052&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f90a9b84-1ea7-40b4-92a6-48f5a4f62084\', \'multiverseId\': 133052}, \'multiverseid\': 133052}, {\'name\': \'Fragmentado de plumas\', \'text\': \'Todos los Fragmentados tienen "{T}: Esta criatura hace 1 punto de daño a la criatura atacante o bloqueadora objetivo".\', \'type\': \'Criatura — Fragmentado\', \'flavor\': \'"Hace mucho tiempo que nos mantienen bajo ataque, pero no nos faltan municiones. Los mismos cuerpos de nuestros enemigos nos arman contra ellos." —Ádom Capashen, héroe benalita\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134557&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'655b932c-f2ce-49e4-bf0f-b1fa2222fe97\', \'multiverseId\': 134557}, \'multiverseid\': 134557}, {\'name\': \'Slivoïde à aiguilles\', \'text\': \'Tous les slivoïdes ont « {T} : Cette créature inflige 1 blessure à la créature attaquante ou bloqueuse ciblée. »\', \'type\': \'Créature : slivoïde\', \'flavor\': \'« Nous sommes attaqués continuellement, mais nous ne manquons pas de munitions. Les corps mêmes de nos ennemis nous arment contre eux. » —Adom Capashen, héros bénalian\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132751&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'79fb4a39-5369-4e91-9333-89264aefa607\', \'multiverseId\': 132751}, \'multiverseid\': 132751}, {\'name\': \'Tramutante con Aculei\', \'text\': \'Tutti i Tramutanti hanno "{T}: Questa creatura infligge 1 danno a una creatura attaccante o bloccante bersaglio."\', \'type\': \'Creatura — Tramutante\', \'flavor\': \'"Per lungo tempo ci hanno tenuti sotto attacco, ma non ci mancano le munizioni. I corpi stessi dei nostri nemici ci servono come armi contro di loro." —Adom Capashen, eroe di Benalia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133353&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dbfe913f-5c1a-4ee3-88dc-b80e0c52cf07\', \'multiverseId\': 133353}, \'multiverseid\': 133353}, {\'name\': \'羽軸スリヴァー\', \'text\': \'すべてのスリヴァーは「{T}：攻撃しているかブロックしているクリーチャー１体を対象とする。このクリーチャーはそれに１点のダメージを与える。」の能力を持つ。\', \'type\': \'クリーチャー — スリヴァー\', \'flavor\': \'やつらの攻撃は長いこと続いたが、我々の武器が尽きることは無かった。 我らの敵の死体が、そのまま敵に対する武器となったのだからな。 ――ベナリアの英雄、エイドム・キャパシェン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133654&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9675ffc4-2559-4895-9f66-6cdc89ff9d27\', \'multiverseId\': 133654}, \'multiverseid\': 133654}, {\'name\': \'Fractius-Ouriço\', \'text\': \'Todos os Fractius têm "{T}: Esta criatura causa 1 ponto de dano à criatura alvo atacante ou bloqueadora."\', \'type\': \'Criatura — Fractius\', \'flavor\': \'"Por muito tempo eles nos atacaram, mas não nos falta munição. Os próprios corpos de nossos inimigos nos armam contra eles." —Adom Capashen, herói de Benália\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133955&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5317b566-d46e-4bde-bb6d-7216c9b1874f\', \'multiverseId\': 133955}, \'multiverseid\': 133955}, {\'name\': \'Перьевая Щепка\', \'text\': \'Все Щепки обладают способностью "{T}: Это существо наносит 1 повреждение целевому атакующему или блокирующему существу."\', \'type\': \'Существо — Щепка\', \'flavor\': \'«Они долго держали нас под атаками, но у нас хватало вооружения. Каждое тело наших врагов вооружало нас против них же самих», Адом Капашен, Беналишский герой\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134256&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0396d665-1c3f-4f9e-98ad-ee5064c3a38d\', \'multiverseId\': 134256}, \'multiverseid\': 134256}, {\'name\': \'刺毛裂片妖\', \'text\': \'所有裂片妖具有「{T}：此生物对目标进行攻击或阻挡的生物造成1点伤害。」\', \'type\': \'生物～裂片妖\', \'flavor\': \'「他们的攻势持续已久，但我们从不缺乏弹药。 敌人的身躯便提供我们充足的武装。」 ～宾纳里亚勇士艾栋·卡帕轩\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132450&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'606b4e5b-1653-426d-9672-e38258debc54\', \'multiverseId\': 132450}, \'multiverseid\': 132450}]', '[{\'name\': \'Stachelpflüger\', \'text\': \'Der Stachelpflüger kommt mit drei +1/+1-Marken ins Spiel.\\n{2}, entferne eine +1/+1-Marke vom Stachelpflüger: Lege eine +1/+1-Marke auf eine Kreatur deiner Wahl.\\n{2}, entferne eine +1/+1-Marke vom Stachelpflüger: Ein Land deiner Wahl wird zu einer 2/2 Kreatur, die weiterhin ein Land ist. Lege eine +1/+1-Marke auf sie.\', \'type\': \'Kreatur — Stachel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133080&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ffea530e-4e38-42fe-b131-b76a9f78cbc7\', \'multiverseId\': 133080}, \'multiverseid\': 133080}, {\'name\': \'Perforador cultivador\', \'text\': \'El Perforador cultivador entra en juego con tres contadores +1/+1 sobre él.\\n{2}, remover un contador +1/+1 del Perforador cultivador: Pon un contador +1/+1 sobre la criatura objetivo.\\n{2}, remover un contador +1/+1 del Perforador cultivador: La tierra objetivo es una criatura 2/2 que sigue siendo una tierra. Pon un contador +1/+1 sobre ella.\', \'type\': \'Criatura — Perforador\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134585&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8067ce94-fe27-4409-a3f7-3c820cfd1213\', \'multiverseId\': 134585}, \'multiverseid\': 134585}, {\'name\': \'Épix laboureur\', \'text\': "L\'Épix laboureur arrive en jeu avec trois marqueurs +1/+1 sur lui.\\n{2}, retirez un marqueur +1/+1 de l\'Épix laboureur : Mettez un marqueur +1/+1 sur la créature ciblée.\\n{2}, retirez un marqueur +1/+1 de l\'Épix laboureur : Le terrain ciblé devient une créature 2/2 qui est toujours un terrain. Mettez un marqueur +1/+1 sur lui.", \'type\': \'Créature : épix\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132779&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'401d5d08-4278-411b-818f-efacfac6e33d\', \'multiverseId\': 132779}, \'multiverseid\': 132779}, {\'name\': \'Pungiglione Coltivatore\', \'text\': \'Il Pungiglione Coltivatore entra in gioco con tre segnalini +1/+1 su di esso.\\n{2}, Rimuovi un segnalino +1/+1 dal Pungiglione Coltivatore: Metti un segnalino +1/+1 su una creatura bersaglio.\\n{2}, Rimuovi un segnalino +1/+1 dal Pungiglione Coltivatore: Una terra bersaglio diventa una creatura 2/2 che è ancora una terra. Metti un segnalino +1/+1 su di essa.\', \'type\': \'Creatura — Pungiglione\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133381&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a5777ad5-33d4-46f3-9397-5e42af98bebe\', \'multiverseId\': 133381}, \'multiverseid\': 133381}, {\'name\': \'スパイクの耕し手\', \'text\': \'スパイクの耕し手は、３個の＋１/＋１カウンターが置かれた状態で場に出る。\\n{2}, スパイクの耕し手から＋１/＋１カウンターを１個取り除く：クリーチャー１体を対象とし、それの上に＋１/＋１カウンターを１個置く。\\n{2}, スパイクの耕し手から＋１/＋１カウンターを１個取り除く：土地１つを対象とする。それは２/２のクリーチャーになる。それは土地でもある。 それの上に＋１/＋１カウンターを１個置く。\', \'type\': \'クリーチャー — スパイク\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133682&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d6ea7e26-562a-4cea-91ff-5afbdbead0ca\', \'multiverseId\': 133682}, \'multiverseid\': 133682}, {\'name\': \'Lavrador de Espículo\', \'text\': \'Lavrador de Espículo entra em jogo com três marcadores +1/+1 sobre ele.\\n{2}, Remova um marcador +1/+1 de Lavrador de Espículo: Coloque um marcador +1/+1 sobre criatura alvo.\\n{2}, Remova um marcador +1/+1 de Lavrador de Espículo: O terreno alvo torna-se uma criatura 2/2 que ainda é um terreno. Coloque um marcador +1/+1 sobre ele.\', \'type\': \'Criatura — Espículo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133983&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'400c33f1-12e8-4a78-8589-a0695b376777\', \'multiverseId\': 133983}, \'multiverseid\': 133983}, {\'name\': \'Колючий Культиватор\', \'text\': \'Колючий Культиватор входит в игру с тремя +1/+1 жетонами на нем.\\n{2}, Уберите один +1/+1 жетон с Колючего Культиватора: Положите один +1/+1 жетон на целевое существо.\\n{2}, Удалите один +1/+1 жетон с Колючего Культиватора: Целевая земля становится существом 2/2 и остается землей. Положите один +1/+1 жетон на нее.\', \'type\': \'Существо — Шип\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134284&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'17cdcf11-2b05-4882-9a22-e6e8c2d8a193\', \'multiverseId\': 134284}, \'multiverseid\': 134284}, {\'name\': \'耕作钉兽\', \'text\': \'耕作钉兽进场时上面有三个+1/+1指示物。\\n{2}，从耕作钉兽上移去一个+1/+1指示物：在目标生物上放置一个+1/+1指示物。\\n{2}，从耕作钉兽上移去一个+1/+1指示物：目标地成为2/2生物，且仍然是地。 在其上放置一个+1/+1指示物。\', \'type\': \'生物～钉兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132478&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f9cfccf9-839b-4788-b452-f7e53556b491\', \'multiverseId\': 132478}, \'multiverseid\': 132478}]', '[{\'name\': \'Steinbraue, Krosanischer Held\', \'text\': \'Verursacht Trampelschaden\\nImmer wenn eine Kreatur angreift, die du kontrollierst und die Trampelschaden verursacht, erhält sie +2/+2 bis zum Ende des Zuges.\', \'type\': \'Legendäre Kreatur — Zentaur, Krieger\', \'flavor\': \'Nur wenige Augenblicke, nachdem ein instabiler Riss im Zeitgefüge Steinbraue in die Einöde gebracht hatte, die einst sein geliebtes Krosa gewesen war, hatte er bereits voller Rachegelüste seine Streitaxt ergriffen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133088&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b7371329-2fd5-4eb7-ad63-2a7625f169f6\', \'multiverseId\': 133088}, \'multiverseid\': 133088}, {\'name\': \'Stonebrow, héroe de Krosa\', \'text\': \'Arrolla.\\nSiempre que una criatura con la habilidad de arrollar que controles ataque, obtiene +2/+2 hasta el final del turno.\', \'type\': \'Criatura legendaria — Guerrero centauro\', \'flavor\': \'Un instante después de que una brecha inestable dejó a Stonebrow en los yermos de su amada Krosa, levantó su hacha en un ataque de ira y venganza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134593&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'73636663-6ff3-4b82-8a1e-52738700edb5\', \'multiverseId\': 134593}, \'multiverseid\': 134593}, {\'name\': \'Fronderosh, héros de la Krosia\', \'text\': "Piétinement\\nÀ chaque fois qu\'une créature avec le piétinement que vous contrôlez attaque, elle gagne +2/+2 jusqu\'à la fin du tour.", \'type\': \'Créature légendaire : centaure et guerrier\', \'flavor\': \'Quelques instants après avoir été déposé par une faille dans les vestiges de sa chère Krosia, Fronderosh brandit sa hache et cria vengeance.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132787&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c6665b9f-050d-4a4b-9a4c-15cffa4032bb\', \'multiverseId\': 132787}, \'multiverseid\': 132787}, {\'name\': \'Asprociglio, Eroe di Krosa\', \'text\': \'Travolgere\\nOgniqualvolta una creatura con travolgere che controlli attacca, prende +2/+2 fino alla fine del turno.\', \'type\': \'Creatura Leggendaria — Guerriero Centauro\', \'flavor\': "Pochi istanti dopo che un volubile squarcio l\'aveva calato nella desolazione della sua amata Krosa, Asprociglio brandì la sua ascia per una vendetta accecata dall\'ira.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133389&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ea94dfc2-67ae-4ac9-a5f3-2fc77a9dccb3\', \'multiverseId\': 133389}, \'multiverseid\': 133389}, {\'name\': \'クローサの英雄、ストーンブラウ\', \'text\': \'トランプル\\nあなたがコントロールするトランプルを持つクリーチャーが攻撃するたび、それはターン終了時まで＋２/＋２の修整を受ける。\', \'type\': \'伝説のクリーチャー — ケンタウルス・戦士\', \'flavor\': \'気まぐれな裂け目がストーンブラウを荒野とかした彼の愛したクローサに落とした直後、彼は斧を手に、怒りに狂った復讐へと立ち上がった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133690&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2fbcaedd-51fd-4e9b-a802-9d20c61a72c9\', \'multiverseId\': 133690}, \'multiverseid\': 133690}, {\'name\': \'Testa-de-Pedra, Herói Krosano\', \'text\': \'Atropelar\\nToda a vez que uma criatura com atropelar que você controla ataca, ela recebe +2/+2 até o final do turno.\', \'type\': \'Criatura Lendária — Guerreiro Centauro\', \'flavor\': \'Momentos após uma fenda instável lançar Testa-de-Pedra nos desertos de sua amada Krosa, ele levantou seu machado clamando por vingança.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133991&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9e6c10fe-32a9-4436-8af0-cd9757d19295\', \'multiverseId\': 133991}, \'multiverseid\': 133991}, {\'name\': \'Стоунброу, Кросанский Герой\', \'text\': \'Пробивной удар\\nКогда существо под вашим контролем с пробивным ударом атакует, оно получает +2/+2 до конца хода.\', \'type\': \'Легендарное Существо — Кентавр Воин\', \'flavor\': \'В момент когда непостоянный разлом выбросил Стоунброу среди пустоши на месте его любимой Кросы, он поднял свой топор во имя яростной мести.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134292&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5f83ec03-1549-484a-a06a-f683661324f5\', \'multiverseId\': 134292}, \'multiverseid\': 134292}, {\'name\': \'克洛萨勇士石额\', \'text\': \'践踏\\n每当一个由你操控且具践踏异能的生物攻击时，该生物得+2/+2直到回合结束。\', \'type\': \'传奇生物～半人马／战士\', \'flavor\': \'一道时缝闪过，将石额丢在他深爱的克洛萨，而这片荒凉景象令他震怒不已，随即抡起巨斧展开复仇。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132486&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8394e6ab-6542-4daa-8641-0c2d69c8971a\', \'multiverseId\': 132486}, \'multiverseid\': 132486}]', '[{\'name\': \'Steinplatten von Trokair\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {W}.\\nWenn die Steinplatten von Trokair aus dem Spiel auf einen Friedhof gelegt werden, kannst du deine Bibliothek nach einer Ebene durchsuchen und sie getappt ins Spiel bringen. Falls du dies tust, mische danach deine Bibliothek.\', \'type\': \'Legendäres Land\', \'flavor\': \'Staubwinde zerfraßen die Steine langsam, aber im Boden, auf dem sie gelegen hatten, steckt immer noch viel Kraft.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132931&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e0ed612d-4fca-4276-b185-c96cd95f055f\', \'multiverseId\': 132931}, \'multiverseid\': 132931}, {\'name\': \'Lajas de Trokair\', \'text\': \'{T}: Agrega {W} a tu reserva de maná.\\nCuando las Lajas de Trokair vayan a un cementerio desde el juego, puedes buscar en tu biblioteca una carta de llanura y ponerla en juego girada. Si lo haces, baraja tu biblioteca.\', \'type\': \'Tierra legendaria\', \'flavor\': \'Vientos cargados de polvo erosionaron las piedras, pero el terreno donde estaban todavía conserva su poder.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134436&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0e649632-cff2-4064-9d87-4385cc11143f\', \'multiverseId\': 134436}, \'multiverseid\': 134436}, {\'name\': \'Dalles de Trokair\', \'text\': \'{T} : Ajoutez {W} à votre réserve.\\nQuand les Dalles de Trokair sont mises dans un cimetière depuis le jeu, vous pouvez chercher dans votre bibliothèque une carte de plaine et la mettre en jeu engagée. Si vous faites ainsi, mélangez votre bibliothèque.\', \'type\': \'Terrain légendaire\', \'flavor\': "Les vents chargés de poussière avaient usé les pierres, mais le sol où elles s\'étaient érigées renfermait encore leur puissance.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132630&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'24881121-d521-49a2-866f-04675013ed48\', \'multiverseId\': 132630}, \'multiverseid\': 132630}, {\'name\': \'Lastricato di Trokair\', \'text\': \'{T}: Aggiungi {W} alla tua riserva di mana.\\nQuando il Lastricato di Trokair viene messo in un cimitero dal gioco, puoi passare in rassegna il tuo grimorio per una carta Pianura e metterla in gioco TAPpata. Se lo fai, rimescola il tuo grimorio.\', \'type\': \'Terra Leggendaria\', \'flavor\': "I venti vorticanti di polvere hanno eroso le lastre, ma il terreno dov\'erano appoggiate ha ancora un certo potere.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133232&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9fb01fd2-4795-4853-b99b-6d9e8aae48cd\', \'multiverseId\': 133232}, \'multiverseid\': 133232}, {\'name\': \'トロウケアの敷石\', \'text\': \'{T}：あなたのマナ・プールに{W}を加える。\\nトロウケアの敷石が場からいずれかの墓地に置かれたとき、あなたは自分のライブラリーから平地カードを１枚探してもよい。そうしたなら、それをタップ状態で場に出す。 そうした場合、あなたのライブラリーを切り直す。\', \'type\': \'伝説の土地\', \'flavor\': \'その石は埃混じりの風に浸食されてしまったが、大地は未だに力を携えたままだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133533&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'db396c91-d99d-4569-ac2c-09ce9f50c158\', \'multiverseId\': 133533}, \'multiverseid\': 133533}, {\'name\': \'Lajes de Trokair\', \'text\': \'{T}: Adicione {W} à sua reserva de mana.\\nQuando Lajes de Trokair é colocado no cemitério vindo do jogo, você pode procurar em seu grimório por um card de Planície e colocá-lo em jogo virado. Se fizer isso, embaralhe seu grimório.\', \'type\': \'Terreno Lendário\', \'flavor\': \'Ventos perfurantes corroeram as rochas, mas o solo onde jaziam ainda tem poder.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133834&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6256c660-122d-4935-81ec-686b0a77523d\', \'multiverseId\': 133834}, \'multiverseid\': 133834}, {\'name\': \'Плиты Трокайра\', \'text\': \'{T}: Добавьте {W} в ваше хранилище маны.\\nКогда Плиты Трокайра попадают на кладбище из игры, вы можете найти в вашей библиотеке карту Равнин и положить ее в игру повернутой. Если вы это сделали, перетасуйте вашу библиотеку.\', \'type\': \'Легендарная Земля\', \'flavor\': \'Колючие пыльные ветра разъедали камни, но земля, на которой они лежали, по-прежнему удерживала силы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134135&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'99538f04-1316-4925-a13c-286c6790c4b4\', \'multiverseId\': 134135}, \'multiverseid\': 134135}, {\'name\': \'卓耶卡石板迹\', \'text\': \'{T}：加{W}到你的法术力池中。\\n当卓耶卡石板迹从场上进入坟墓场时，你可以从你的牌库中搜寻一张平原牌，并将它横置进场。 若你如此作，则将你的牌库洗牌。\', \'type\': \'传奇地\', \'flavor\': \'石板早受饱含砂尘的风侵蚀，但所立之大地依旧充满力量。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132329&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'639031c2-cd49-49f3-bb0a-37d16d6e4832\', \'multiverseId\': 132329}, \'multiverseid\': 132329}]', '[{\'name\': \'Sturmwolken-Dschinn\', \'text\': \'Fliegend\\nDer Sturmwolken-Dschinn kann nur fliegende Kreaturen blocken.\\n{R}{R}: Der Sturmwolken-Dschinn erhält +2/+0 bis zum Ende des Zuges und fügt dir 1 Schadenspunkt zu.\', \'type\': \'Kreatur — Dschinn\', \'flavor\': \'So unbeständig wie Gewitterregen, so schlüpfrig wie ein Aal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133090&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'80ee7c32-abb5-4292-aa3f-69297b40edcb\', \'multiverseId\': 133090}, \'multiverseid\': 133090}, {\'name\': \'Djinn nube de tormenta\', \'text\': \'Vuela.\\nEl Djinn nube de tormenta sólo puede bloquear criaturas con la habilidad de volar.\\n{R}{R}: El Djinn nube de tormenta obtiene +2/+0 hasta el final del turno y te hace 1 punto de daño.\', \'type\': \'Criatura — Djinn\', \'flavor\': \'Inestable como un relámpago, resbaladizo como una anguila.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134595&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a8ca7ca1-1e69-4594-ad34-fdbfd6e4a5c2\', \'multiverseId\': 134595}, \'multiverseid\': 134595}, {\'name\': \'Djinn des nuées de tempête\', \'text\': "Vol\\nLe Djinn des nuées de tempête ne peut bloquer que les créatures avec le vol.\\n{R}{R} : Le Djinn des nuées de tempête gagne +2/+0 jusqu\'à la fin du tour et vous inflige 1 blessure.", \'type\': \'Créature : djinn\', \'flavor\': "Aussi capricieux que l\'éclair, aussi glissant qu\'une anguille.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132789&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9a882a7e-482b-4863-b49c-054907e2aabf\', \'multiverseId\': 132789}, \'multiverseid\': 132789}, {\'name\': \'Genio Nubetempesta\', \'text\': \'Volare\\nIl Genio Nubetempesta può bloccare solo creature con volare.\\n{R}{R}: Il Genio Nubetempesta prende +2/+0 fino alla fine del turno e ti infligge 1 danno.\', \'type\': \'Creatura — Genio\', \'flavor\': \'Mutevole come i fulmini, viscido come le anguille.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133391&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'07563e79-6e0f-4a82-a8b7-eda55ca19ede\', \'multiverseId\': 133391}, \'multiverseid\': 133391}, {\'name\': \'嵐雲のジン\', \'text\': \'飛行\\n嵐雲のジンは、飛行を持つクリーチャーのみをブロックできる。\\n{R}{R}：嵐雲のジンは、ターン終了時まで＋２/＋０の修整を受けるとともに、あなたに１点のダメージを与える。\', \'type\': \'クリーチャー — ジン\', \'flavor\': \'稲妻のように気まぐれで、長魚のように滑り抜ける。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133692&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bf392112-89fb-4b12-842c-3a8571da49ad\', \'multiverseId\': 133692}, \'multiverseid\': 133692}, {\'name\': \'Gênio Nimbo-Cúmulo\', \'text\': \'Voar\\nGênio Nimbo-Cúmulo só pode bloquear criaturas com a habilidade de voar.\\n{R}{R}: Gênio Nimbo-Cúmulo recebe +2/+0 até o final do turno e causa 1 ponto de dano a você.\', \'type\': \'Criatura — Gênio\', \'flavor\': \'Tão inconstante quanto o relâmpago, tão escorregadio quanto as enguias.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133993&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3a3e32ba-ea84-41cf-9d09-97e2395ad357\', \'multiverseId\': 133993}, \'multiverseid\': 133993}, {\'name\': \'Джинн Грозового Облака\', \'text\': \'Полет\\nДжинн Грозового Облака может блокировать только существ с полетом.\\n{R}{R}: Джинн Грозового Облака получает +2/+0 до конца хода и наносит вам 1 повреждение.\', \'type\': \'Существо — Джинн\', \'flavor\': \'Переменчив как молния, изворотлив как угорь.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134294&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7064af6d-6c96-4a6f-89d1-830d7b861a1a\', \'multiverseId\': 134294}, \'multiverseid\': 134294}, {\'name\': \'暴风云巨灵\', \'text\': \'飞行\\n暴风云巨灵只能阻挡具飞行异能的生物。\\n{R}{R}：暴风云巨灵得+2/+0直到回合结束，且对你造成1点伤害。\', \'type\': \'生物～巨灵\', \'flavor\': \'无常如电，溜滑如鳗。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132488&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6066dda8-7e8f-4fcd-95e4-a0bd8ccf0241\', \'multiverseId\': 132488}, \'multiverseid\': 132488}]', '[{\'name\': \'Ständige Wiederholung\', \'text\': \'Rückkauf {3} (Du kannst zusätzlich {3} bezahlen, sowie du diesen Zauberspruch spielst. Falls du dies tust, nimm diese Karte auf deine Hand, sowie sie verrechnet wird.)\\nKopiere einen Spontanzauber oder eine Hexerei deiner Wahl. Du kannst neue Ziele für die Kopie bestimmen.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Die Nachwirkungen des Mirari sind immer noch zu spüren." —Zyd, Kamahldruide\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133053&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'463aa3ff-b406-42c5-b213-75296c5e84c2\', \'multiverseId\': 133053}, \'multiverseid\': 133053}, {\'name\': \'Reiterar\', \'text\': \'Recuperar {3} (Puedes pagar {3} adicionales en cuanto juegues este hechizo. Si lo haces, pon esta carta en tu mano en cuanto se resuelve.)\\nCopia el hechizo objetivo de instantáneo o de conjuro. Puedes elegir nuevos objetivos para la copia.\', \'type\': \'Instantáneo\', \'flavor\': \'"Todavía perduran los ecos del poder del Mirari." —Zyd, druida kamahlita\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134558&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c535f47a-526a-4a26-b0e9-3f451027d7a9\', \'multiverseId\': 134558}, \'multiverseid\': 134558}, {\'name\': \'Réitération\', \'text\': "Rappel {3} (Vous pouvez payer {3} supplémentaires au moment où vous jouez ce sort. Si vous faites ainsi, mettez cette carte dans votre main au moment où elle se résout.)\\nCopiez le sort d\'éphémère ou de rituel ciblé. Vous pouvez choisir de nouvelles cibles pour cette copie.", \'type\': \'Éphémère\', \'flavor\': \'« On peut encore sentir les échos du pouvoir du Mirari. » —Zyd, druide kamahlite\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132752&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'40b55779-07d5-431b-85d8-70dd8a2e2749\', \'multiverseId\': 132752}, \'multiverseid\': 132752}, {\'name\': \'Ripetere\', \'text\': \'Riscatto {3} (Puoi pagare {3} addizionale mentre giochi questa magia). Se lo fai, riprendi in mano questa carta quando si risolve.)\\nCopia una magia istantaneo o stregoneria bersaglio. Puoi scegliere nuovi bersagli per la copia.\', \'type\': \'Istantaneo\', \'flavor\': \'"Ancora permane l\\\'eco della potenza di Mirari." —Zyd, druido di Kamahl\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133354&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'61995ebd-ee30-42a6-92d5-13e57fcfb655\', \'multiverseId\': 133354}, \'multiverseid\': 133354}, {\'name\': \'反復\', \'text\': \'バイバック {3} （あなたはこの呪文をプレイするに際し、追加で{3}を支払ってもよい。 そうした場合、それの解決に際し、このカードをあなたの手札に加える。）\\nインスタント呪文１つかソーサリー呪文１つを対象とし、それをコピーする。 あなたはそのコピーの新しい対象を選んでもよい。\', \'type\': \'インスタント\', \'flavor\': \'ミラーリの力の反響は今でも残っています。 ――カマーライトのドルイド、ジド\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133655&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e1c899cb-ec73-40ae-9d95-bf9a48f95de1\', \'multiverseId\': 133655}, \'multiverseid\': 133655}, {\'name\': \'Reiterar\', \'text\': \'Recuperar {3} (Você pode pagar um custo adicional de {3} ao jogar esta mágica. Se fizer isso, coloque este card em sua mão quando for resolvido.)\\nCopie a mágica instantânea alvo ou a mágica de feitiço alvo. Você pode escolher novos alvos para a cópia.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Os ecos do poder de Mirari ainda são ouvidos." —Zyd, druida kamahliano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133956&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f659e195-1741-4377-81d1-79d714d36ba9\', \'multiverseId\': 133956}, \'multiverseid\': 133956}, {\'name\': \'Повторить\', \'text\': \'Выкуп {3} (Вы можете заплатить дополнительно {3} при игре этого заклинания. Если вы это делаете, положите эту карту в вашу руку, когда она разрешится.)\\nСкопируйте целевое мгновенное заклинание или заклинание волшебства. Вы можете выбрать новые цели для этой копии.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Эхо силы Мирари все еще медленно умирает», Зид, Дриуд-камалит\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134257&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c72a1f5e-5eeb-4f1d-8ae8-43e8d83acf34\', \'multiverseId\': 134257}, \'multiverseid\': 134257}, {\'name\': \'重诵\', \'text\': \'购回{3}（你使用此咒语时可以额外支付{3}。 若你如此做，则结算此咒语时将它放入你的手牌。）\\n复制目标瞬间或法术咒语。 你可以为该复制选择新的目标。\', \'type\': \'瞬间\', \'flavor\': \'「映奇宝珠的影响力依旧徘徊不去。」 ～卡马尔宗德鲁伊季德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132451&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'65f3da87-686f-4849-be47-900ecc4162a0\', \'multiverseId\': 132451}, \'multiverseid\': 132451}]', '[{\'name\': \'Stärke durch Überzahl\', \'text\': \'Eine Kreatur deiner Wahl erhält +X/+X und verursacht Trampelschaden bis zum Ende des Zuges, wobei X gleich der Anzahl der angreifenden Kreaturen ist.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Der Einsiedler stirbt. Der Ausgestoßene stirbt. Der einsame Wolf stirbt. In dieser Welt überleben nur diejenigen, die zusammenhalten." —Uros, Ältester von Pendelhaven\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133092&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'513c921e-6564-448a-9eef-25943aafc893\', \'multiverseId\': 133092}, \'multiverseid\': 133092}, {\'name\': \'Fuerza numérica\', \'text\': \'Hasta el final del turno, la criatura objetivo gana la habilidad de arrollar y obtiene +X/+X, donde X es el número de criaturas atacantes.\', \'type\': \'Instantáneo\', \'flavor\': \'"El ermitaño muere. El paria muere. El lobo solitario muere. Sólo quienes permanecen unidos sobreviven a este mundo." —Uros, anciana de Pendelhaven\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134597&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'59276aeb-1b2f-4c5c-8427-921c188e3bc9\', \'multiverseId\': 134597}, \'multiverseid\': 134597}, {\'name\': "L\'union fait la force", \'text\': "Jusqu\'à la fin du tour, la créature ciblée acquiert le piétinement et gagne +X/+X, X étant le nombre de créatures attaquantes.", \'type\': \'Éphémère\', \'flavor\': "« L\'ermite meurt. Le paria meurt. Le loup solitaire meurt aussi. Dans ce monde, seuls ceux qui s\'unissent survivent. » —Uros, doyenne de Pendelhavre", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132791&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6909393b-6486-4fca-ba5e-0148cca88505\', \'multiverseId\': 132791}, \'multiverseid\': 132791}, {\'name\': \'Forza nel Numero\', \'text\': \'Fino alla fine del turno, una creatura bersaglio ha travolgere e prende +X/+X, dove X è il numero di creature attaccanti.\', \'type\': \'Istantaneo\', \'flavor\': \'"L\\\'eremita muore. Il reietto muore. Il lupo solitario muore. Solo quanti rimangono uniti sopravvivono a questo mondo." —Uros, Anziana di Pendelhaven\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133393&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'813abec3-28e8-4711-bb11-c4aad830efba\', \'multiverseId\': 133393}, \'multiverseid\': 133393}, {\'name\': \'数の力\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それはトランプルを得るとともに＋Ｘ/＋Ｘの修整を受ける。Ｘは攻撃しているクリーチャーの総数に等しい。\', \'type\': \'インスタント\', \'flavor\': \'隠者も死す。 追われ者も死す。 一匹狼も死す。 この世界で生き残れるのは、共に力を合わせる者のみ。 ――ペンデルヘイヴンの古老、ユーロス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133694&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b32e162e-0497-4fd2-8f5e-ce7cacbf82b6\', \'multiverseId\': 133694}, \'multiverseid\': 133694}, {\'name\': \'Força em Números\', \'text\': \'Até o final do turno, a criatura alvo ganha atropelar e recebe +X/+X, sendo X igual ao número de criaturas atacantes.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"O eremita morre. O excomungado morre. O lobo solitário morre. Apenas os que permanecem juntos sobrevivem a este mundo." —Uros, ancião de Pendelhaven\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133995&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ff408920-32e2-417e-991e-7b4d307783fd\', \'multiverseId\': 133995}, \'multiverseid\': 133995}, {\'name\': \'Сила в Количестве\', \'text\': \'До конца хода целевое существо получает пробивной удар и +X/+X, где X число атакующих существ.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Отшельник умер. Изгнанник умер. Одинокий волк умер. Только те, кто держались друг друга, выжили в этом мире», Урос, Старец из Пендальхевена\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134296&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'be913f8a-67b7-4a42-9475-6a3edaae315d\', \'multiverseId\': 134296}, \'multiverseid\': 134296}, {\'name\': \'人多力量大\', \'text\': \'直到回合结束，目标生物获得践踏异能并得+X/+X，X为进行攻击的生物数量。\', \'type\': \'瞬间\', \'flavor\': \'「隐者已死。 黜人已死。 独行狼已死。 这世界只有团结一致者才能生存。 ～潘得庇护地长老尤洛斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132490&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d8df48e8-06f7-4ee7-80e1-0d80fcdc4334\', \'multiverseId\': 132490}, \'multiverseid\': 132490}]', '[{\'name\': \'Suche nach dem Morgen\', \'text\': \'Durchsuche deine Bibliothek nach einem Standardland und bringe es ins Spiel. Mische danach deine Bibliothek.\\nAussetzen 2 {G} (Statt diese Karte aus deiner Hand zu spielen, kannst du {G} bezahlen, sie ganz aus dem Spiel entfernen und zwei Zeitmarken auf sie legen. Entferne zu Beginn deines Versorgungssegments eine Zeitmarke von ihr. Wenn du die letzte Zeitmarke entfernst, spiele die Karte, ohne ihre Manakosten zu bezahlen.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133067&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7451b6e7-ac76-4b5c-a97e-b1ed173e6b71\', \'multiverseId\': 133067}, \'multiverseid\': 133067}, {\'name\': \'Buscar el mañana\', \'text\': \'Busca en tu biblioteca una carta de tierra básica y ponla en juego. Luego baraja tu biblioteca.\\nSuspender 2—{G} (En lugar de jugar esta carta de tu mano, puedes pagar {G} y removerla del juego con dos contadores de tiempo sobre ella. Al comienzo de tu mantenimiento, remueve un contador de tiempo. Cuando remuevas el último, juégala sin pagar su coste de maná.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134572&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7e75fd65-9cc7-4126-99af-95465e2c6c38\', \'multiverseId\': 134572}, \'multiverseid\': 134572}, {\'name\': \'À la recherche de demain\', \'text\': \'Cherchez dans votre bibliothèque une carte de terrain de base et mettez-la en jeu. Mélangez ensuite votre bibliothèque.\\nSuspension 2 — {G} (Plutôt que jouer cette carte depuis votre main, vous pouvez payer {G} et la retirer de la partie avec deux marqueurs « temps » sur elle. Au début de votre entretien, retirez un marqueur « temps ». Quand vous retirez le dernier, jouez cette carte sans payer son coût de mana.)\', \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132766&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cd403615-8609-4cb4-b304-0e8b9ed31a2d\', \'multiverseId\': 132766}, \'multiverseid\': 132766}, {\'name\': \'Ricerca di un Domani\', \'text\': "Passa in rassegna il tuo grimorio per una carta terra base e mettila in gioco. Poi rimescola il tuo grimorio.\\nSospendere 2—{G} (Invece di giocare questa carta dalla tua mano, puoi pagare {G} e rimuoverla dal gioco con due segnalini tempo su di essa. All\'inizio del tuo mantenimento, rimuovi un segnalino tempo. Quando rimuovi l\'ultimo, gioca la carta senza pagare il suo costo di mana.)", \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133368&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'efa63188-3445-4eea-85e7-e6b944efcb75\', \'multiverseId\': 133368}, \'multiverseid\': 133368}, {\'name\': \'明日への探索\', \'text\': \'あなたのライブラリーから基本土地カードを１枚探し、それを場に出す。 その後あなたのライブラリーを切り直す。\\n待機 ２―{G} （これをあなたの手札からプレイするのではなく、{G}を支払ってゲームから取り除き、その上に時間カウンターを２個置いてもよい。 あなたのアップキープの開始時に、時間カウンターを１個取り除く。 最後の１個を取り除いたとき、あなたはそれをマナ・コストを支払わずにプレイする。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133669&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9d966d43-819c-4b12-a4bc-7c350671ebde\', \'multiverseId\': 133669}, \'multiverseid\': 133669}, {\'name\': \'Buscar pelo Amanhã\', \'text\': \'Procure em seu grimório por um card de terreno básico e coloque-o em jogo. Depois, embaralhe seu grimório.\\nSuspender 2—{G} (Em vez de jogar este card da sua mão, você pode pagar {G} e removê-lo do jogo com dois marcadores temporais sobre ele. No início de sua manutenção, remova um marcador temporal. Quando remover o último, jogue-o sem pagar seu custo de mana.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133970&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c1371962-7009-4ee6-8b13-516936a3825b\', \'multiverseId\': 133970}, \'multiverseid\': 133970}, {\'name\': \'Поиски Завтрашнего\', \'text\': \'Поищите в вашей библиотеке карту базовой земли и положите ее в игру. Затем перетасуйте вашу библиотеку.\\nОтсрочка 2—{G} (Вместо того чтобы сыграть эту карту из вашей руки, вы можете заплатить {G} и удалить ее из игры с двумя временными жетонами на ней. В начале вашего шага поддержки удалите один временной жетон. После удаления последнего жетона сыграйте эту карту без оплаты ее мана-стоимости.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134271&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'04025ba0-8a06-4063-a622-14173c7d4ac4\', \'multiverseId\': 134271}, \'multiverseid\': 134271}, {\'name\': \'为来日探寻\', \'text\': \'从你的牌库中搜寻一张基本地牌并将之放置进场。 然后将你的牌库洗牌。\\n延缓2～{G}（除了从你手上使用此牌，你能支付{G}并将此牌移出对战，且上面有两个计时指示物。 在你的维持开始时，从其上移去一个计时指示物。 当你移去最后一个时，则使用它且不需支付其法术力费用。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132465&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b17c5e02-2ca5-4acf-885a-c09a47bf6079\', \'multiverseId\': 132465}, \'multiverseid\': 132465}]', "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133100&type=card', 'language': 'German', 'identifiers': {'scryfallId': '07ebab1b-dccc-4032-be60-540efcc88e93', 'multiverseId': 133100}, 'multiverseid': 133100}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134605&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '57063dc5-f353-4149-aad4-b376984e4ebd', 'multiverseId': 134605}, 'multiverseid': 134605}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132799&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd0c5d6fc-8f7f-4937-bb56-317ea7d5ea48', 'multiverseId': 132799}, 'multiverseid': 132799}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133401&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3472aa6d-eb0d-4e0f-8881-d6217b0bbd2a', 'multiverseId': 133401}, 'multiverseid': 133401}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133702&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f6d93054-8f72-4b08-ab44-0003ec639551', 'multiverseId': 133702}, 'multiverseid': 133702}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134003&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '18db3797-f668-4922-b7b7-d1cc25191b84', 'multiverseId': 134003}, 'multiverseid': 134003}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134304&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '66c5886c-e749-49da-a0d4-4575ae6c75c7', 'multiverseId': 134304}, 'multiverseid': 134304}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132498&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'fed05e9b-270c-4ba2-b00e-550e9cf6d6aa', 'multiverseId': 132498}, 'multiverseid': 132498}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133101&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'fce79d56-0f3a-47f1-a58a-eff9b9cd2804', 'multiverseId': 133101}, 'multiverseid': 133101}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134606&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c8a1a7ac-f952-45ea-b761-55491602b9e8', 'multiverseId': 134606}, 'multiverseid': 134606}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132800&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'aa27399e-5401-48a5-ac81-90c3c313cfd3', 'multiverseId': 132800}, 'multiverseid': 132800}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133402&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b6c343a9-7c54-47f4-a2cc-9e938e000b2f', 'multiverseId': 133402}, 'multiverseid': 133402}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133703&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '2dcfd6cc-32da-4171-8dab-e3ed4e0c976e', 'multiverseId': 133703}, 'multiverseid': 133703}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134004&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3a464b6e-5a2f-4b43-9006-c63b39d8c39f', 'multiverseId': 134004}, 'multiverseid': 134004}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134305&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '2283c918-9d44-4621-8c48-7d7198911c28', 'multiverseId': 134305}, 'multiverseid': 134305}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132499&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'cdbba5e0-e7e6-43a6-99c7-4d652253a271', 'multiverseId': 132499}, 'multiverseid': 132499}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133102&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5b33e8b8-5104-4269-a497-0b25fb107d3f', 'multiverseId': 133102}, 'multiverseid': 133102}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134607&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd958bcb1-6b04-4b45-b9e4-4d0e7402b486', 'multiverseId': 134607}, 'multiverseid': 134607}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132801&type=card', 'language': 'French', 'identifiers': {'scryfallId': '3e831888-4cce-4185-98f9-3a487093ba8d', 'multiverseId': 132801}, 'multiverseid': 132801}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133403&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3b840a73-51d4-4d75-b207-dc26fc638470', 'multiverseId': 133403}, 'multiverseid': 133403}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133704&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '8a907ce3-ffb2-47c1-85ca-13a67d6d711f', 'multiverseId': 133704}, 'multiverseid': 133704}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134005&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'dbf04772-a1ae-4a71-9f85-3aa4bca8a364', 'multiverseId': 134005}, 'multiverseid': 134005}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134306&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '7a4f5fef-7369-4f08-88f9-3737d898d4e5', 'multiverseId': 134306}, 'multiverseid': 134306}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132500&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '17fc6d2f-f0cd-496e-8074-215ff770190d', 'multiverseId': 132500}, 'multiverseid': 132500}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133103&type=card', 'language': 'German', 'identifiers': {'scryfallId': '3cc3891c-e5dc-479c-b1ab-e8ab048f47ac', 'multiverseId': 133103}, 'multiverseid': 133103}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134608&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5b20130e-073a-47ba-932c-98825044ef78', 'multiverseId': 134608}, 'multiverseid': 134608}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132802&type=card', 'language': 'French', 'identifiers': {'scryfallId': '7b6bf875-104e-4ede-91e9-466644ffea62', 'multiverseId': 132802}, 'multiverseid': 132802}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133404&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'f31cab29-5391-4352-83a7-c7ebca6743d3', 'multiverseId': 133404}, 'multiverseid': 133404}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133705&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f3e8b184-0d99-413e-a1ce-b8d896d93149', 'multiverseId': 133705}, 'multiverseid': 133705}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134006&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8c11eddd-8e66-47c3-912a-5b76cfccbb4b', 'multiverseId': 134006}, 'multiverseid': 134006}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134307&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '7ffa5f4d-bede-4e34-9126-b258bb9f2c37', 'multiverseId': 134307}, 'multiverseid': 134307}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132501&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '47b3e34c-131b-42d9-9a89-7c8a41abbe50', 'multiverseId': 132501}, 'multiverseid': 132501}]", '[{\'name\': \'Teferi, Magier von Zhalfir\', \'text\': \'Aufblitzen (Du kannst diesen Zauberspruch zu jedem Zeitpunkt spielen, zu dem du einen Spontanzauber spielen könntest.)\\nKreaturenkarten, die du besitzt und die nicht im Spiel sind, haben Aufblitzen.\\nJeder Gegner kann Zaubersprüche nur zu einem Zeitpunkt spielen, zu dem er auch eine Hexerei spielen könnte.\', \'type\': \'Legendäre Kreatur — Mensch, Zauberer\', \'flavor\': \'Um diese Welt zu retten, musste er alle anderen aufgeben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133106&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2e74e77c-6213-4b35-a9ac-d67de5b3ad48\', \'multiverseId\': 133106}, \'multiverseid\': 133106}, {\'name\': \'Teferi, mago de Zhalfir\', \'text\': \'Destello (Puedes jugar este hechizo en cualquier momento en que pudieras jugar un instantáneo.)\\nLas cartas de criatura de las cuales eres propietario que no están en juego tienen la habilidad de destello.\\nCada oponente puede jugar hechizos sólo en cualquier momento en que pudiera jugar un conjuro.\', \'type\': \'Criatura legendaria — Hechicero humano\', \'flavor\': \'Para salvar este plano, debemos abandonar todos los otros.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134611&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a56949a8-e576-48b0-8db1-752c9b2bb27b\', \'multiverseId\': 134611}, \'multiverseid\': 134611}, {\'name\': \'Téfeiri, mage de Zhalfir\', \'text\': "Flash (Vous pouvez jouer ce sort à tout moment où vous pourriez jouer un éphémère.)\\nLes cartes de créature que vous possédez qui ne sont pas en jeu ont flash.\\nChaque adversaire ne peut jouer des sorts qu\'à tout moment où il pourrait jouer un rituel.", \'type\': \'Créature légendaire : humain et sorcier\', \'flavor\': \'Pour sauver ce plan, il doit abandonner tous les autres.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132805&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8ed5bd56-e035-4ea5-a565-22c331f8d5f5\', \'multiverseId\': 132805}, \'multiverseid\': 132805}, {\'name\': \'Teferi, Mago di Zhalfir\', \'text\': \'Lampo (Puoi giocare questa magia in ogni momento in cui potresti giocare un istantaneo.)\\nLe carte creatura che possiedi che non sono in gioco hanno lampo.\\nOgni avversario può giocare magie solo quando potrebbe giocare una stregoneria.\', \'type\': \'Creatura Leggendaria — Mago Umano\', \'flavor\': \'Per salvare questo piano, deve rinunciare a tutti gli altri.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133407&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5118af7f-af3d-443e-9452-7ffe4c4df272\', \'multiverseId\': 133407}, \'multiverseid\': 133407}, {\'name\': \'ザルファーの魔道士、テフェリー\', \'text\': \'瞬速 （あなたはこの呪文を、あなたがインスタントをプレイできるときならいつでもプレイしてよい。）\\nあなたがオーナーである場に無いクリーチャー・カードは瞬速を持つ。\\n各対戦相手は、そのプレイヤーがソーサリーをプレイできるときにのみ呪文をプレイできる。\', \'type\': \'伝説のクリーチャー — 人間・ウィザード\', \'flavor\': \'この次元を救うため、彼はそれ以外のすべての次元を捨てねばならない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133708&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2b906394-ca85-47a8-aff2-5176eb0bc12f\', \'multiverseId\': 133708}, \'multiverseid\': 133708}, {\'name\': \'Teferi, Mago de Zhalfir\', \'text\': \'Lampejo (Você poderá jogar esta mágica a qualquer momento em que puder jogar uma mágica instantânea.)\\nOs seus cards de criatura que não estejam em jogo têm lampejo.\\nCada oponente só pode jogar mágicas quando puder jogar um feitiço.\', \'type\': \'Criatura Lendária — Mago Humano\', \'flavor\': \'Para salvar este plano, ele precisa abandonar todos os outros.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134009&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'080d2ba6-e7d3-4a83-9e97-d898b6185cfe\', \'multiverseId\': 134009}, \'multiverseid\': 134009}, {\'name\': \'Тефери, Маг Жалфири\', \'text\': \'Миг (Вы можете играть это заклинание в любое время, когда вы можете играть мгновенные заклинания.)\\nВсе карты существ, которыми вы владеете и которые не в игре, имеют свойство миг.\\nКаждый оппонент может играть заклинания только в то время, когда он или она может играть волшебство.\', \'type\': \'Легендарное Существо — Человек Чародей\', \'flavor\': \'Чтобы сохранить эту землю, он был вынужден отвергнуть все другие.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134310&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4562119e-6a6f-4d41-ba67-38415f87256e\', \'multiverseId\': 134310}, \'multiverseid\': 134310}, {\'name\': \'赛费尔法师泰菲力\', \'text\': \'闪现（你可以于你能够使用瞬间的时机下使用此咒语。）\\n由你所拥有、且不在场上的生物牌都具有闪现异能。\\n每位对手只可以于他能使用法术的时机下使用咒语。\', \'type\': \'传奇生物～人类／法术师\', \'flavor\': \'为了拯救此时空，他必须将其它的全拋下。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132504&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4131e108-d0bd-413c-b622-02b18589a399\', \'multiverseId\': 132504}, \'multiverseid\': 132504}]', '[{\'name\': \'Tektonischer Unhold\', \'text\': \'Echo {4}{R}{R} (Opfere zu Beginn deines Versorgungssegments diese bleibende Karte, falls sie seit deinem letzten Versorgungssegment unter deine Kontrolle gekommen ist, falls du nicht ihre Echokosten bezahlst.)\\nDer Tektonische Unhold greift in jedem Zug an, falls möglich.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'Die Barbaren von Pardia sind schon längst tot, doch die Berge kochen immer noch vor Zorn.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133105&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'aa4ed9bb-0e49-4ccc-a676-35e4e08da039\', \'multiverseId\': 133105}, \'multiverseid\': 133105}, {\'name\': \'Demonio tectónico\', \'text\': \'Eco {4}{R}{R} (Al comienzo de tu mantenimiento, si esto entró bajo tu control desde el comienzo de tu último mantenimiento, sacrifícalo a menos que pagues su coste de eco.)\\nEl Demonio tectónico ataca cada turno si puede.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Los bárbaros de Pardia murieron hace tiempo, pero sus montañas todavía humean con furia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134610&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f6f57725-eb34-49d3-b214-9d3da2a6c52d\', \'multiverseId\': 134610}, \'multiverseid\': 134610}, {\'name\': \'Fielleux tectonique\', \'text\': "Écho {4}{R}{R} (Au début de votre entretien, si ce permanent est passé sous votre contrôle depuis le début de votre dernier entretien, sacrifiez-le à moins que vous ne payiez son coût d\'écho.)\\nLe Fielleux tectonique attaque à chaque tour si possible.", \'type\': \'Créature : élémental\', \'flavor\': \'Les barbares de Pardia sont morts depuis longtemps, mais ses montagnes fulminent toujours de rage.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132804&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'894e6ccd-144b-417a-b849-e38e07f09a9d\', \'multiverseId\': 132804}, \'multiverseid\': 132804}, {\'name\': \'Demone Tettonico\', \'text\': "Eco {4}{R}{R} (All\'inizio del tuo mantenimento, se questo permanente è entrato sotto il tuo controllo dall\'inizio del tuo ultimo mantenimento, sacrificalo a meno che non paghi il suo costo di eco.)\\nIl Demone Tettonico attacca ogni turno se può farlo.", \'type\': \'Creatura — Elementale\', \'flavor\': \'I barbari di Pardia sono morti da tempo, ma le sue montagne continuano a bruciare di rabbia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133406&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'152700a2-7f7c-412a-b22c-f5d5be5a73e5\', \'multiverseId\': 133406}, \'multiverseid\': 133406}, {\'name\': \'地盤の悪鬼\', \'text\': \'エコー {4}{R}{R} （あなたのアップキープの開始時に、これが直前のあなたのアップキープの開始時よりも後にあなたのコントロール下になっていた場合、それのエコー・コストを支払わないかぎり、それを生け贄に捧げる。）\\n地盤の悪鬼は可能なら毎ターン攻撃に参加する。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'パーディック山の蛮族は死滅してずいぶんと経つが、山は今でも怒りの噴煙を上げている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133707&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6b570bc8-b287-4538-ba5d-8d5fca08daf6\', \'multiverseId\': 133707}, \'multiverseid\': 133707}, {\'name\': \'Demônio Tectônico\', \'text\': \'Eco {4}{R}{R} (No início de sua manutenção, se esta permanente passou a estar sob o seu controle desde o início de sua última manutenção, sacrifique-a, a menos que você pague seu custo de eco.)\\nDemônio Tectônico ataca a cada turno se estiver apto.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Os bárbaros de Pardia estão mortos há muito tempo, mas suas montanhas ainda ardem enfurecidas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134008&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'73bb9dbb-d5e3-4b07-a45d-1bbda9f50f78\', \'multiverseId\': 134008}, \'multiverseid\': 134008}, {\'name\': \'Тектонический Демон\', \'text\': \'Эхо {4}{R}{R} (В начале вашего шага поддержки, если это существо попало под ваш контроль с момента начала вашего предыдущего шага поддержки, пожертвуйте его, если вы не заплатите его эхо-стоимость.)\\nТектонический Демон атакует каждый ход, если может.\', \'type\': \'Существо — Элементаль\', \'flavor\': \'Варвары из Пардии давно вымерли, но их горы все еще теплятся яростью.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134309&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'41350413-6027-4a10-97fc-4835b7b640d9\', \'multiverseId\': 134309}, \'multiverseid\': 134309}, {\'name\': \'地壳邪鬼\', \'text\': \'返响{4}{R}{R}（在你的维持开始时，若你在你前一个维持开始后才操控它，则除非你支付其返响费用，否则牺牲之。）\\n地壳邪鬼每回合若能攻击，则必须攻击。\', \'type\': \'生物～元素\', \'flavor\': \'帕迪亚的野蛮人早已绝灭，但此地山脉依旧冒着愤怒气息。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132503&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5d33594f-3af9-4a53-8c30-56dcab91d7dd\', \'multiverseId\': 132503}, \'multiverseid\': 132503}]', '[{\'name\': \'Telekinetischer Remasuri\', \'text\': \'Alle Remasuris haben „{T}: Tappe eine bleibende Karte deiner Wahl".\', \'type\': \'Kreatur — Remasuri\', \'flavor\': \'„Remasuris haben einen sehr einfachen Leitinstinkt. Alles, was dem Schwarm nützt, ist gut. Alles andere ist schlecht." —Freyalise\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133107&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'29fbd4de-b551-40ac-9d79-59a8057a03c2\', \'multiverseId\': 133107}, \'multiverseid\': 133107}, {\'name\': \'Fragmentado telequinético\', \'text\': \'Todos los Fragmentados tienen "{T}: Gira el permanente objetivo".\', \'type\': \'Criatura — Fragmentado\', \'flavor\': \'"Los fragmentados tienen un instinto simple que los guía: todo lo que mejora la colmena es bienvenido, todo lo que se enfrenta a la colmena es atacado." —Freyalise\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134612&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4451c066-41b2-42b0-af4d-ce91c633ad0a\', \'multiverseId\': 134612}, \'multiverseid\': 134612}, {\'name\': \'Slivoïde télékinésique\', \'text\': \'Tous les slivoïdes ont « {T} : Engagez le permanent ciblé. »\', \'type\': \'Créature : slivoïde\', \'flavor\': "« Les slivoïdes sont guidés par les instincts les plus simples. Faites évoluer l\'essaim, et vous serez le bienvenu. Bloquez-le, et vous serez détruit. » —Freyalise", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132806&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0d1d24fd-1a9b-4b45-95fa-a405f9f47bf2\', \'multiverseId\': 132806}, \'multiverseid\': 132806}, {\'name\': \'Tramutante Telecinetico\', \'text\': \'Tutti i Tramutanti hanno "{T}: TAPpa un permanente bersaglio."\', \'type\': \'Creatura — Tramutante\', \'flavor\': \'"I Tramutanti sono guidati solo da un semplice istinto. Fai progredire l\\\'alveare e sarai benaccetto. Ostacola l\\\'alveare e avrai di fronte una resistenza accanita." —Freyalise\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133408&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f00a82b2-bb55-447e-86c4-45c8620ddbf9\', \'multiverseId\': 133408}, \'multiverseid\': 133408}, {\'name\': \'念動スリヴァー\', \'text\': \'すべてのスリヴァーは「{T}：パーマネント１つを対象とし、それをタップする。」の能力を持つ。\', \'type\': \'クリーチャー — スリヴァー\', \'flavor\': \'スリヴァーが従う本能は単純です。 群れを強くするならば歓迎されます。 群れを妨げるならば、容赦ない敵対に遭うでしょう。 ――フレイアリーズ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133709&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'94adbe16-2d26-43be-ab0a-105394bc13be\', \'multiverseId\': 133709}, \'multiverseid\': 133709}, {\'name\': \'Fractius Telecinético\', \'text\': \'Todos os Fractius têm "{T}: Vire a permanente alvo."\', \'type\': \'Criatura — Fractius\', \'flavor\': \'"Os fractius são orientados apenas pelo simples instinto. Promova a colônia e você será bem-vindo. Atrapalhe a colônia e você enfrentará dura oposição." —Freyalise\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134010&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8eb2b715-9c18-4900-8971-c7ab31709c70\', \'multiverseId\': 134010}, \'multiverseid\': 134010}, {\'name\': \'Телекенетическая Щепка\', \'text\': \'Все Щепки обладают способностью "{T}: Поверните целевой перманент."\', \'type\': \'Существо — Щепка\', \'flavor\': \'«Щепки руководствуются простым инстинктом. Помогаешь рою - и ты лучший друг, но если помешаешь - встретишь неустанное сопротивление», Фреялиз\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134311&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1b12b1eb-9419-4d82-8eca-6e2d06f49c1b\', \'multiverseId\': 134311}, \'multiverseid\': 134311}, {\'name\': \'念力裂片妖\', \'text\': \'所有裂片妖具有「{T}：横置目标永久物。」\', \'type\': \'生物～裂片妖\', \'flavor\': \'「裂片妖只靠单纯本能行事。 若有助母巢，你将受其欢迎。 若阻碍母巢，就准备不断遭其唱反调。」 ～妃雅丽兹\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132505&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0018dd78-98eb-4686-ad43-14173519f442\', \'multiverseId\': 132505}, \'multiverseid\': 132505}]', '[{\'name\': \'Thelon von Havenwood\', \'text\': \'Jedes Pilzwesen erhält +1/+1 für jede Sporenmarke auf ihr.\\n{B}{G}, entferne eine Pilzwesenkarte aus einem Friedhof ganz aus dem Spiel: Lege eine Sporenmarke auf jedes Pilzwesen im Spiel.\', \'type\': \'Legendäre Kreatur — Elf, Druide\', \'flavor\': \'„Der Anblick meiner Thalliden, die hier noch gedeihen, ist ein bittersüßes Willkommen in dieser kalten Einöde."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133114&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f4fb9c82-d143-4050-9e18-ada080bedd86\', \'multiverseId\': 133114}, \'multiverseid\': 133114}, {\'name\': \'Thélon de Havenwood\', \'text\': \'Cada Hongo obtiene +1/+1 por cada contador de espora sobre él.\\n{B}{G}, remover del juego una carta de hongo en un cementerio: Pon un contador de espora en cada Hongo en juego.\', \'type\': \'Criatura legendaria — Druida elfo\', \'flavor\': \'"Ver a mis tálidos aún prosperando es una bienvenida agridulce a este frío yermo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134619&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'06b1ef28-b2cc-4015-8d33-7df671e7a39b\', \'multiverseId\': 134619}, \'multiverseid\': 134619}, {\'name\': \'Thélon de Havrebois\', \'text\': "Chaque fongus gagne +1/+1 pour chaque marqueur « spore » sur lui.\\n{B}{G}, retirez de la partie une carte de fongus d\'un cimetière : Mettez un marqueur « spore » sur chaque fongus en jeu.", \'type\': \'Créature légendaire : elfe et druide\', \'flavor\': "« Voir mes thallidés ainsi proliférer dans ce désert froid m\'emplit d\'une douce amertume. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132813&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fcc088cb-45ae-42b3-bb4a-4f512d3a8382\', \'multiverseId\': 132813}, \'multiverseid\': 132813}, {\'name\': \'Thelon di Havenwood\', \'text\': \'Ogni Fungus prende +1/+1 per ogni segnalino spora su di esso.\\n{B}{G}, Rimuovi dal gioco una carta Fungus in un cimitero: Metti un segnalino spora su ogni Fungus in gioco.\', \'type\': \'Creatura Leggendaria — Druido Elfo\', \'flavor\': \'"La vista dei miei thallid ancora floridi è un\\\'accoglienza agrodolce in questa fredda desolazione."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133415&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ae10c32f-57b5-4347-8088-9c46ff662e47\', \'multiverseId\': 133415}, \'multiverseid\': 133415}, {\'name\': \'ヘイヴンウッドのセロン\', \'text\': \'各ファンガスは、それの上に置かれている胞子カウンター１個につき＋１/＋１の修整を受ける。\\n{B}{G}, いずれかの墓地にあるファンガス・カードを１枚ゲームから取り除く：場にある各ファンガスの上に、胞子カウンターをそれぞれ１個置く。\', \'type\': \'伝説のクリーチャー — エルフ・ドルイド\', \'flavor\': \'私のサリッドが、この冷たく荒廃した地にまだ繁栄している光景というのは、ほろ苦い歓迎なのだな。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133716&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2c828f1f-1f11-469d-b6c1-b7cf8113042e\', \'multiverseId\': 133716}, \'multiverseid\': 133716}, {\'name\': \'Thelon de Havenwood\', \'text\': \'Cada Fungo recebe +1/+1 para cada marcador de esporo sobre ele.\\n{B}{G}, Remova do jogo um card de Fungo de um cemitério: Coloque um marcador de esporo sobre cada Fungo em jogo.\', \'type\': \'Criatura Lendária — Druida Elfo\', \'flavor\': \'"A visão de minhas talídias ainda prosperando é uma recepção agridoce a este deserto gélido."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134017&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'25f829d6-dbb4-4b12-bc90-15e87cd2da2f\', \'multiverseId\': 134017}, \'multiverseid\': 134017}, {\'name\': \'Телон из Хейвенвуда\', \'text\': \'Каждая Плесень получает +1/+1 за каждый жетон споры на ней.\\n{B}{G}, Удалите карту Плесени из кладбища из игры: Положите жетон споры на каждую Плесень в игре.\', \'type\': \'Легендарное Существо — Эльф Друид\', \'flavor\': \'«Вид моих таллидов, что пышно разрастаются это единственное, что может утешить взор в этих холодных пустошах».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134318&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'52fce301-f274-4493-ab22-be1e833e5597\', \'multiverseId\': 134318}, \'multiverseid\': 134318}, {\'name\': \'海温森的瑟隆\', \'text\': \'对每个真菌而言，其上每有一个芽孢指示物，它便得+1/+1。\\n{B}{G}，将一张真菌牌从任一坟墓场移出对战：在每个由你操控的真菌上放置一个芽孢指示物。\', \'type\': \'传奇生物～地精／德鲁伊\', \'flavor\': \'「初抵此冰冷荒野，便看到我的散绿菌依旧兴盛，真是哭笑不得。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132512&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'557743cd-354b-40f1-97f3-d1482b73a319\', \'multiverseId\': 132512}, \'multiverseid\': 132512}]', '[{\'name\': \'Thelonischer Einsiedler\', \'text\': \'Alle Saprolinge erhalten +1/+1.\\nMorph {3}{G}{G} (Du kannst diese Karte verdeckt für {3} als eine 2/2 Kreatur spielen. Decke sie zu einem beliebigen Zeitpunkt für ihre Morph-Kosten auf.)\\nWenn der Thelonische Einsiedler aufgedeckt wird, bringe vier 1/1 grüne Saprolingspielsteine ins Spiel.\', \'type\': \'Kreatur — Elf, Schamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133115&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'53bf9704-b40c-428c-9840-4c64cfdb07f4\', \'multiverseId\': 133115}, \'multiverseid\': 133115}, {\'name\': \'Ermitaño thelonita\', \'text\': \'Todos los Saprolines obtienen +1/+1.\\nMetamorfosis {3}{G}{G} (Puedes jugar esta carta boca abajo como una criatura 2/2 pagando {3}. Ponla boca arriba en cualquier momento pagando su coste de metamorfosis.)\\nCuando el Ermitaño thelonita se ponga boca arriba, pon en juego cuatro fichas de criatura Saprolín verde 1/1.\', \'type\': \'Criatura — Chamán elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134620&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f8572b17-8b4f-448d-b28e-3ca7e0a99bb1\', \'multiverseId\': 134620}, \'multiverseid\': 134620}, {\'name\': \'Ermite thélonite\', \'text\': "Tous les saprobiontes gagnent +1/+1.\\nMue {3}{G}{G} (Vous pouvez jouer cette carte face cachée comme une créature 2/2 pour {3}. Retournez-la quand vous le désirez pour son coût de mue.)\\nQuand l\'Ermite thélonite est retourné face visible, mettez en jeu quatre jetons de créature 1/1 verte Saprobionte.", \'type\': \'Créature : elfe et shamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132814&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3404baad-b9b6-48df-a03b-8741748cabe1\', \'multiverseId\': 132814}, \'multiverseid\': 132814}, {\'name\': \'Eremita Seguace di Thelon\', \'text\': "Tutti i Saprolingi prendono +1/+1.\\nMetamorfosi {3}{G}{G} (Puoi giocare questa carta a faccia in giù come una creatura 2/2 pagando {3}. Girala a faccia in su in qualsiasi momento pagando il suo costo di metamorfosi.)\\nQuando l\'Eremita Seguace di Thelon viene girato a faccia in su, metti in gioco quattro pedine creatura Saprolingio 1/1 verdi.", \'type\': \'Creatura — Sciamano Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133416&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f86b95b5-653a-45e8-b16a-54974d2e9d73\', \'multiverseId\': 133416}, \'multiverseid\': 133416}, {\'name\': \'セロナイトの隠者\', \'text\': \'すべての苗木は＋１/＋１の修整を受ける。\\n変異 {3}{G}{G} （あなたはこれを、{3}を支払うことで、裏向きの２/２のクリーチャーとしてプレイしてもよい。 いつでも変異コストを支払ってそれを表向きにすることができる。）\\nセロナイトの隠者が表向きになったとき、緑の１/１の苗木クリーチャー・トークンを４体場に出す。\', \'type\': \'クリーチャー — エルフ・シャーマン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133717&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ec186cf5-a0fa-4877-b26f-d0edf1f4ed73\', \'multiverseId\': 133717}, \'multiverseid\': 133717}, {\'name\': \'Eremita Theloniano\', \'text\': \'Todos os Saprófitas recebem +1/+1.\\nMetamorfose {3}{G}{G} (Você pode baixar este card com a face voltada para baixo como uma criatura 2/2 por {3}. Vire sua face para cima a qualquer momento pagando seu custo de metamorfose.)\\nQuando Eremita Theloniano for virado para cima, coloque em jogo quatro fichas de criaturas verde 1/1 do tipo Saprófita.\', \'type\': \'Criatura — Xamã Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134018&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5d7f33db-af24-493f-ae68-f72808f3e755\', \'multiverseId\': 134018}, \'multiverseid\': 134018}, {\'name\': \'Отшельник Телонит\', \'text\': \'Все Сапролинги получают +1/+1.\\nОборотень {3}{G}{G} (Вы можете играть эту карту лицом вниз как 2/2 существо за {3}. Переверните ее лицом вверх в любой момент за ее стоимость оборотня.)\\nКогда Отшельник Тайлонит поворачивается лицом вверх, положите четыре фишки существа 1/1 зеленый Сапролинг в игру.\', \'type\': \'Существо — Эльф Шаман\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134319&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dae31cf0-f512-4ee1-9e05-6a5e817d06dc\', \'multiverseId\': 134319}, \'multiverseid\': 134319}, {\'name\': \'瑟隆门隐者\', \'text\': \'所有腐生物得+1/+1。\\n变身{3}{G}{G}（你可牌面朝下地使用此牌并支付{3}，将其当成2/2生物。 可随时支付其变身费用使其翻回正面。）\\n当瑟隆门隐者翻回正面时，将四个1/1绿色腐生物衍生物放置进场。\', \'type\': \'生物～地精／祭师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132513&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f9b22f4c-712b-4a02-91fb-5b2c21468b02\', \'multiverseId\': 132513}, \'multiverseid\': 132513}]', "[{'name': 'Tickendes Uhrwerk', 'text': 'Rückkauf {3} (Du kannst zusätzlich {3} bezahlen, sowie du diesen Zauberspruch spielst. Falls du dies tust, nimm diese Karte auf deine Hand, sowie sie verrechnet wird.)\\nBestimme eine Marke auf einer bleibenden oder ausgesetzten Karte deiner Wahl. Entferne diese Marke von dieser bleibenden Karte oder Karte oder lege eine weitere Marke derselben Art auf sie.', 'type': 'Spontanzauber', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132890&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0e1ce067-498b-4950-bec4-ece2b4d9522f', 'multiverseId': 132890}, 'multiverseid': 132890}, {'name': 'Vueltas del reloj', 'text': 'Recuperar {3} (Puedes pagar {3} adicionales en cuanto juegues este hechizo. Si lo haces, pon esta carta en tu mano en cuanto se resuelve.)\\nElige un contador sobre el permanente o carta suspendida objetivo. Remueve ese contador de esa carta o permanente o pon otro de esos contadores sobre él.', 'type': 'Instantáneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134395&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '6b70a0fc-b2b9-4c04-bd19-ed1e5d6cda78', 'multiverseId': 134395}, 'multiverseid': 134395}, {'name': 'Clepsydre', 'text': 'Rappel {3} (Vous pouvez payer {3} supplémentaires au moment où vous jouez ce sort. Si vous faites ainsi, mettez cette carte dans votre main au moment où elle se résout.)\\nChoisissez un marqueur sur le permanent ciblé ou la carte en suspension ciblée. Retirez ce marqueur de ce permanent ou de cette carte ou mettez un autre de ces marqueurs sur lui.', 'type': 'Éphémère', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132589&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ffca8848-5641-4f94-a9bc-f8c7a0f6f94b', 'multiverseId': 132589}, 'multiverseid': 132589}, {'name': 'Accelerazione Oraria', 'text': 'Riscatto {3} (Puoi pagare {3} addizionale mentre giochi questa magia). Se lo fai, riprendi in mano questa carta quando si risolve.)\\nScegli un segnalino su un permanente o una carta sospesa bersaglio. Rimuovi quel segnalino da quel permanente o da quella carta o metti su di esso o essa un altro di quei segnalini.', 'type': 'Istantaneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133191&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '1fd83997-618b-48e2-95b0-14c5b5b92da1', 'multiverseId': 133191}, 'multiverseid': 133191}, {'name': '時計回し', 'text': 'バイバック {3} （あなたはこの呪文をプレイするに際し、追加で{3}を支払ってもよい。 そうした場合、それの解決に際し、このカードをあなたの手札に加える。）\\nパーマネント１つか待機状態のカード１枚を対象とする。その上のカウンターを１個選ぶ。 そのパーマネントかカードの上のそのカウンターを取り除くか、そのカウンターをもう１個置く。', 'type': 'インスタント', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133492&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '0ba9bd7c-8e8b-4ae6-8292-ef9a64fe46d7', 'multiverseId': 133492}, 'multiverseid': 133492}, {'name': 'Ponteiro do Tempo', 'text': 'Recuperar {3} (Você pode pagar um custo adicional de {3} ao jogar esta mágica. Se fizer isso, coloque este card em sua mão quando for resolvido.)\\nEscolha um marcador na permanente alvo ou card suspenso alvo. Remova aquele marcador daquela permanente ou card ou coloque outro desses marcadores sobre ele.', 'type': 'Mágica Instantânea', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133793&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c9140127-d37b-43e5-ac7b-4e981681e516', 'multiverseId': 133793}, 'multiverseid': 133793}, {'name': 'Бег Часов', 'text': 'Выкуп {3} (Играя это заклинание, вы можете заплатить дополнительно {3}. Если вы делаете это, положите эту карту в вашу руку, когда она разрешится.)\\nВыберите жетон на целевом перманенте или отсроченной карте. Удалите этот жетон с этого перманента или карты или положите другой такой же жетон на него или нее.', 'type': 'Мгновенное заклинание', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134094&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '39d323bf-534f-42d4-8ba0-bae10188389c', 'multiverseId': 134094}, 'multiverseid': 134094}, {'name': '扭转时钟', 'text': '购回{3}（你使用此咒语时可以额外支付{3}。 若你如此做，则结算此咒语时将它放入你的手牌。）\\n在目标永久物或已延缓的牌上选择一个指示物。 将该指示物从该永久物或牌上移去，或在其上放置一个同样的指示物。', 'type': '瞬间', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132288&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b5423a95-9c3d-46de-89ab-b2225dfe4323', 'multiverseId': 132288}, 'multiverseid': 132288}]", '[{\'name\': \'Tiefseekrake\', \'text\': \'Der Tiefseekrake ist unblockbar.\\nAussetzen 9 {2}{U}\\nImmer wenn ein Gegner einen Zauberspruch spielt, entferne eine Zeitmarke vom Tiefseekraken, falls er ausgesetzt ist.\', \'type\': \'Kreatur — Krake\', \'flavor\': \'Die Spalte blieb tagelang offen und ließ uraltes Meerwasser einströmen. Sie schloss sich erst, als sich auch der letzte Riesententakel hindurchgequetscht hatte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132903&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'517c4eac-e81f-453f-8145-29b6bcc3585b\', \'multiverseId\': 132903}, \'multiverseid\': 132903}, {\'name\': \'Kraken del mar profundo\', \'text\': \'El Kraken del mar profundo es imbloqueable.\\nSuspender 9—{2}{U}.\\nSiempre que un oponente juegue un hechizo, si el Kraken del mar profundo está suspendido, remueve un contador de tiempo de él.\', \'type\': \'Criatura — Kraken\', \'flavor\': \'La grieta permaneció abierta por días, vertiendo agua marina antigua. Se cerró sólo después de que el último gran tentáculo se deslizó a través de ella.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134408&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9c566561-b819-4950-ba37-60e27620630f\', \'multiverseId\': 134408}, \'multiverseid\': 134408}, {\'name\': \'Kraken des abîmes\', \'text\': "Le Kraken des abîmes est imblocable.\\nSuspension 9 — {2}{U}\\nÀ chaque fois qu\'un adversaire joue un sort, si le Kraken des abîmes est en suspension, retirez-lui un marqueur « temps ».", \'type\': \'Créature : kraken\', \'flavor\': "La faille demeura ouverte pendant des jours, déversant son flot d\'eau de mer ancestrale. Elle ne se referma qu\'une fois que le dernier grand tentacule s\'y fut faufilé.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132602&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8ea04fce-3602-4d1f-ae20-1015cf25c506\', \'multiverseId\': 132602}, \'multiverseid\': 132602}, {\'name\': \'Kraken delle Profondità\', \'text\': \'La Kraken delle Profondità non può essere bloccata.\\nSospendere 9—{2}{U}\\nOgniqualvolta un avversario gioca una magia, se la Kraken delle Profondità è sospesa, rimuovi un segnalino tempo da essa.\', \'type\': \'Creatura — Kraken\', \'flavor\': "Lo squarcio rimase aperto per giorni, inondando tutto di antica acqua salmastra. Si chiuse solo dopo che l\'ultimo grande tentacolo si era fatto largo contorcendosi.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133204&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f8be0965-ce7b-4100-ba0f-31ec6c26be0f\', \'multiverseId\': 133204}, \'multiverseid\': 133204}, {\'name\': \'深海のクラーケン\', \'text\': \'深海のクラーケンはブロックされない。\\n待機 ９―{2}{U}\\nいずれかの対戦相手が呪文をプレイするたび、深海のクラーケンが待機状態である場合、それの上から時間カウンターを１個取り除く。\', \'type\': \'クリーチャー — クラーケン\', \'flavor\': \'裂け目は何日もの間、そこから古代の海水を放出し続けていた。 それが閉じたのは、最後の触手がうねり出た後のことだった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133505&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'17dc2e82-9dcb-49ee-a7fa-18688698c803\', \'multiverseId\': 133505}, \'multiverseid\': 133505}, {\'name\': \'Kraken do Mar Profundo\', \'text\': \'Kraken do Mar Profundo não pode ser bloqueado.\\nSuspender 9—{2}{U}\\nToda vez que um oponente jogar uma mágica, se Kraken do Mar Profundo estiver suspenso, remova um marcador temporal dele.\', \'type\': \'Criatura — Kraken\', \'flavor\': \'A fenda permaneceu aberta por dias, jorrando as águas de um mar primitivo. Ela só se fechou depois que o último grande tentáculo passou.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133806&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'df0e387a-2d37-4e94-af93-e09a25205078\', \'multiverseId\': 133806}, \'multiverseid\': 133806}, {\'name\': \'Глубоководный Кракен\', \'text\': \'Глубоководный Кракен не блокируется.\\nОтсрочка 9—{2}{U}\\nКогда оппонент играет заклинание, если Глубоководный Кракен отсрочен, удалите с него один временной жетон.\', \'type\': \'Существо — Кракен\', \'flavor\': \'Разлом оставался открытым многие дни, пропуская древние морские воды. Но все же он закрылся, когда последнее из громадных щупалец проскользнуло через него.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134107&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'872c9dac-5dc1-42f9-8d63-b8828bc68a52\', \'multiverseId\': 134107}, \'multiverseid\': 134107}, {\'name\': \'深海巨怪\', \'text\': \'深海巨怪不能被阻挡。\\n延缓9～{2}{U}\\n每当任一对手使用咒语时，若深海巨怪已延缓，则从其上移去一个计时指示物。\', \'type\': \'生物～巨海兽\', \'flavor\': \'时缝连着打开了几天，泄出远古海水。 直到最后一个巨大触手从其间挤出来，才得以关闭。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132301&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b634c7c2-fe71-4712-853e-b80e1559f20d\', \'multiverseId\': 132301}, \'multiverseid\': 132301}]', '[{\'name\': \'Tivadar von Thorn\', \'text\': \'Erstschlag, Schutz vor Rot\\nWenn Tivadar von Thorn ins Spiel kommt, zerstöre einen Goblin deiner Wahl.\', \'type\': \'Legendäre Kreatur — Mensch, Herrscher\', \'flavor\': \'Sein Schwert durchtrennte den Hals eines Goblins — aber es war nicht derjenige, den er angegriffen hatte. Als Tivadar aufblickte, war die Welt, die er gekannt hatte, verschwunden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133120&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c8cbc521-c4af-401c-b1d2-1857692d7c44\', \'multiverseId\': 133120}, \'multiverseid\': 133120}, {\'name\': \'Tivadar de Espino\', \'text\': \'Daña primero, protección contra rojo.\\nCuando Tivadar de Espino entre en juego, destruye el Trasgo objetivo.\', \'type\': \'Criatura legendaria — Señor humano\', \'flavor\': \'Su espada cayó sobre el cuello de un trasgo, pero no del trasgo que había atacado. Cuando Tivadar levantó la vista, el mundo que conocía ya no estaba allí.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134625&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'214a9518-2e78-4c34-aced-5d06ca961ec2\', \'multiverseId\': 134625}, \'multiverseid\': 134625}, {\'name\': \'Tivadar de Thorn\', \'text\': \'Initiative, protection contre le rouge\\nQuand Tivadar de Thorn arrive en jeu, détruisez le gobelin ciblé.\', \'type\': \'Créature légendaire : humain et seigneur\', \'flavor\': "Son épée s\'abattit sur la nuque d\'un gobelin — mais pas celui qu\'il avait chargé. Quand Tivadar leva les yeux, le monde qu\'il connaissait avait disparu.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132819&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7467d013-4f87-4f7f-b419-c2fa007ecc1c\', \'multiverseId\': 132819}, \'multiverseid\': 132819}, {\'name\': \'Tivadar di Thorn\', \'text\': \'Attacco improvviso, protezione dal rosso\\nQuando Tivadar di Thorn entra in gioco, distruggi un Goblin bersaglio.\', \'type\': \'Creatura Leggendaria — Signore Umano\', \'flavor\': \'La sua lama si abbatté sul collo di un goblin—ma non quello che aveva attaccato. Quando Tivadar sollevò lo sguardo, il mondo che aveva conosciuto era scomparso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133421&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b7e3b148-4a1c-43ae-bd84-a0f48dbf0130\', \'multiverseId\': 133421}, \'multiverseid\': 133421}, {\'name\': \'茨の騎士ティヴァダール\', \'text\': \'先制攻撃、プロテクション（赤）\\n茨の騎士ティヴァダールが場に出たとき、ゴブリン１体を対象とし、それを破壊する。\', \'type\': \'伝説のクリーチャー — 人間・ロード\', \'flavor\': \'彼の刃はゴブリンの首に振り下ろされた――しかし、それは彼が突撃した相手ではなかった。 ティヴァダールが視線を上げると、そこには彼の知っている世界は無かった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133722&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'394efa46-994d-4809-a10c-1b560e61e94a\', \'multiverseId\': 133722}, \'multiverseid\': 133722}, {\'name\': \'Tivadar de Thorn\', \'text\': \'Iniciativa, proteção contra o vermelho\\nQuando Tivadar de Thorn entrar em jogo, destrua o Goblin alvo.\', \'type\': \'Criatura Lendária — Senhor Humano\', \'flavor\': \'Sua lâmina castigou o pescoço de um goblin mas não o daquele que havia atacado. Quando Tivadar olhou para cima, o mundo que ele conhecera havia acabado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134023&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'72d5ad7e-06ca-4067-a6c8-efb37159494b\', \'multiverseId\': 134023}, \'multiverseid\': 134023}, {\'name\': \'Тивадар из Торна\', \'text\': \'Первый удар, защита от красного\\nКогда Тивадар из Торна входит в игру, уничтожьте целевого Гоблина.\', \'type\': \'Легендарное Существо — Человек Предводитель\', \'flavor\': \'Его клинок обрушился на шею гоблина но не того, в кого он целился. Когда Тивадар оторвал взгляд от пораженного гоблина, весь знакомый ему мир исчез.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134324&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c271f269-e96c-4653-9f60-05c057a96676\', \'multiverseId\': 134324}, \'multiverseid\': 134324}, {\'name\': \'荆城的提瓦达\', \'text\': \'先攻，反红保护\\n当荆城的提瓦达进场时，消灭目标精灵。\', \'type\': \'传奇生物～人类／领主\', \'flavor\': \'剑锋砍下了精灵头颅～却不是他所冲锋的对象。 当提瓦达环顾四方，他所熟悉的世界早已不存。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132518&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c0f65dea-70c3-4a75-af09-4f15c413c61a\', \'multiverseId\': 132518}, \'multiverseid\': 132518}]', '[{\'name\': \'Todessporen-Thallid\', \'text\': \'Lege zu Beginn deines Versorgungssegments eine Sporenmarke auf den Todessporen-Thalliden.\\nEntferne drei Sporenmarken vom Todessporen-Thalliden: Bringe einen 1/1 grünen Saprolingspielstein ins Spiel.\\nOpfere einen Saproling: Eine Kreatur deiner Wahl erhält -1/-1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Zombie, Pilzwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132902&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'56eb07e2-9edc-4e32-89e5-f983b51d481a\', \'multiverseId\': 132902}, \'multiverseid\': 132902}, {\'name\': \'Tálido espora mortal\', \'text\': \'Al comienzo de tu mantenimiento, pon un contador de espora sobre el Tálido espora mortal.\\nRemover tres contadores de espora del Tálido espora mortal: Pon en juego una ficha de criatura Saprolín verde 1/1.\\nSacrificar un Saprolín: La criatura objetivo obtiene -1/-1 hasta el final del turno.\', \'type\': \'Criatura — Hongo zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134407&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'935b0a87-d68d-4ad0-8df2-29656e9722d9\', \'multiverseId\': 134407}, \'multiverseid\': 134407}, {\'name\': \'Thallidé mortespore\', \'text\': "Au début de votre entretien, mettez un marqueur « spore » sur le Thallidé mortespore.\\nRetirez trois marqueurs « spore » du Thallidé mortespore : Mettez en jeu un jeton de créature 1/1 verte Saprobionte.\\nSacrifiez un Saprobionte : La créature ciblée gagne -1/-1 jusqu\'à la fin du tour.", \'type\': \'Créature : zombie et fongus\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132601&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'074f7338-cac5-4485-904c-986eb25cc012\', \'multiverseId\': 132601}, \'multiverseid\': 132601}, {\'name\': \'Thallid Spora Mortale\', \'text\': "All\'inizio del tuo mantenimento, metti un segnalino spora sulla Thallid Spora Mortale.\\nRimuovi tre segnalini spora dalla Thallid Spora Mortale: Metti in gioco una pedina creatura Saprolingio 1/1 verde.\\nSacrifica un Saprolingio: Una creatura bersaglio prende -1/-1 fino alla fine del turno.", \'type\': \'Creatura — Fungus Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133203&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fae1b147-48de-42c1-b5cc-6a4c17e6457b\', \'multiverseId\': 133203}, \'multiverseid\': 133203}, {\'name\': \'死胞子のサリッド\', \'text\': \'あなたのアップキープの開始時に、死胞子のサリッドの上に胞子カウンターを１個置く。\\n死胞子のサリッドから胞子カウンターを３個取り除く：緑の１/１の苗木クリーチャー・トークンを１体場に出す。\\n苗木を１体生け贄に捧げる：クリーチャー１体を対象とする。それはターン終了時まで－１/－１の修整を受ける。\', \'type\': \'クリーチャー — ゾンビ・ファンガス\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133504&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5fe678f5-ab00-4a2e-86f8-dd561a72339c\', \'multiverseId\': 133504}, \'multiverseid\': 133504}, {\'name\': \'Talídia Esporo Mortífero\', \'text\': \'No início de sua manutenção, coloque um marcador de esporo em Talídia Esporo Mortífero.\\nRemova três marcadores de esporo de Talídia Esporo Mortífero: coloque uma ficha de criatura verde 1/1 do tipo Saprófita em jogo.\\nSacrifique um Saprófita: A criatura alvo recebe -1/-1 até o final do turno.\', \'type\': \'Criatura — Fungo Zumbi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133805&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2fb725d8-e382-4ffc-8964-24f9775c7d7e\', \'multiverseId\': 133805}, \'multiverseid\': 133805}, {\'name\': \'Смертоносный Таллид\', \'text\': \'В начале вашего шага поддержки положите один жетон споры на Смертоносного Таллида.\\nУдалите три жетона спор со Смертоносного Таллида: Положите одну фишку существа 1/1 зеленого Сапролинга в игру.\\nПожертвуйте Сапролинга: Целевое существо получает -1/-1 до конца хода.\', \'type\': \'Существо — Зомби Плесень\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134106&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ebd1e71d-4194-4ec2-af15-8b09f20cbdad\', \'multiverseId\': 134106}, \'multiverseid\': 134106}, {\'name\': \'死孢散绿菌\', \'text\': \'在你的维持开始时，在死孢散绿菌上放置一个芽孢指示物。\\n从死孢散绿菌上移去三个芽孢指示物：将一个1/1绿色腐生物衍生物放置进场。\\n牺牲一个腐生物：目标生物得-1/-1直到回合结束。\', \'type\': \'生物～灵俑／真菌\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132300&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f081beee-265d-44a0-928e-dcc7f51f5840\', \'multiverseId\': 132300}, \'multiverseid\': 132300}]', '[{\'name\': \'Tolarianischer Wachposten\', \'text\': \'Fliegend\\n{U}, {T}, wirf eine Karte aus deiner Hand ab: Bringe eine bleibende Karte deiner Wahl, die du kontrollierst, auf die Hand ihres Besitzers zurück.\', \'type\': \'Kreatur — Mensch, Spruchwandler\', \'flavor\': \'„Ich versuche nicht nur unser Volk zu retten. Es geht um unsere Kultur und um die Hoffnung, dass wir wieder zu alter Größe emporsteigen können."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133121&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'352d1029-fbba-47a8-834c-8a8706893dbe\', \'multiverseId\': 133121}, \'multiverseid\': 133121}, {\'name\': \'Centinela tolariano\', \'text\': \'Vuela.\\n{U}, {T}, descartar una carta: Regresa el permanente objetivo que controles a la mano de su propietario.\', \'type\': \'Criatura — Cambiahechizos humano\', \'flavor\': \'"No intento rescatar sólo a nuestra gente. Es nuestra cultura, y nuestra esperanza de poder volver a la grandeza de antaño." —Ándorel, centinela tolariano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134626&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fa2cfae8-df9f-483e-a727-e8d9756a8cab\', \'multiverseId\': 134626}, \'multiverseid\': 134626}, {\'name\': \'Sentinelle tolariane\', \'text\': "Vol\\n{U}, {T}, défaussez-vous d\'une carte : Renvoyez le permanent ciblé que vous contrôlez dans la main de son propriétaire.", \'type\': \'Créature : humain et sortisan\', \'flavor\': "« Ce n\'est pas uniquement notre peuple que je veux sauver. C\'est notre culture, et l\'espoir de retrouver notre splendeur passée. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132820&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9bea4c25-1edc-492e-92e6-73425a1c66af\', \'multiverseId\': 132820}, \'multiverseid\': 132820}, {\'name\': \'Sentinella di Tolaria\', \'text\': \'Volare\\n{U}, {T}, Scarta una carta: Fai tornare un permanente bersaglio che controlli in mano al suo proprietario.\', \'type\': \'Creatura — Mutamagia Umano\', \'flavor\': \'"Non è solo il nostro popolo che cerco di salvare. È la nostra cultura e la speranza di poter recuperare la nostra grandezza."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133422&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'076c3176-2c3a-49c2-9b9a-22eccc56ed5e\', \'multiverseId\': 133422}, \'multiverseid\': 133422}, {\'name\': \'トレイリアの歩哨\', \'text\': \'飛行\\n{U}, {T}, カードを１枚捨てる：あなたがコントロールするパーマネント１つを対象とし、それをオーナーの手札に戻す。\', \'type\': \'クリーチャー — 人間・スペルシェイパー\', \'flavor\': \'助けようとしてるのは人々だけじゃない。 文化とか希望とか、素晴らしいものに変わるはずの物さ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133723&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f530e433-e32b-4294-9982-711a5bc1f8ec\', \'multiverseId\': 133723}, \'multiverseid\': 133723}, {\'name\': \'Sentinela Tolariano\', \'text\': \'Voar\\n{U}, {T}, Descarte um card: Devolva a permanente alvo que você controla para a mão de seu dono.\', \'type\': \'Criatura — Magimodelador Humano\', \'flavor\': \'"Não é apenas o nosso povo que tento resgatar. É a nossa cultura e a esperança de retornar à nossa grandiosidade."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134024&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'81f8b22c-8415-4267-b594-e2f367bf5ed5\', \'multiverseId\': 134024}, \'multiverseid\': 134024}, {\'name\': \'Толарианский Страж\', \'text\': \'Полет\\n{U}, {T}, Сбросьте карту: Верните целевой перманент под вашим контролем в руку владельца.\', \'type\': \'Существо — Человек Заклинатель\', \'flavor\': \'«Я пытаюсь спасти не только наших людей. Это в нашей культуре, и на том мы и стоим, что надеемся вернуться к величию»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134325&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a24b45a9-1fe4-4a0a-a386-79afd9cbae47\', \'multiverseId\': 134325}, \'multiverseid\': 134325}, {\'name\': \'陶拉里亚哨兵\', \'text\': \'飞行\\n{U}，{T}，弃一张牌：将目标由你操控的永久物移回其拥有者手上。\', \'type\': \'生物～人类／塑法师\', \'flavor\': \'「我救助的对象不只是同胞而已。 还包括了我们的文化，以及我们终能寻回荣光的希望。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132519&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cc2134e8-7ebc-4306-b0d4-f50598e1dd3b\', \'multiverseId\': 132519}, \'multiverseid\': 132519}]', '[{\'name\': \'Traubenkartusche\', \'text\': \'Die Traubenkartusche fügt einer Kreatur oder einem Spieler deiner Wahl 1 Schadenspunkt zu.\\nSturm (Wenn du diesen Zauberspruch spielst, kopiere ihn einmal für jeden Zauberspruch, der in diesem Zug bereits gespielt wurde. Du kannst neue Ziele für die Kopien bestimmen.)\', \'type\': \'Hexerei\', \'flavor\': \'Viele Magier versuchen, die mächtigen Artefakte nachzubauen, die im Lauf der Zeit oder durch die Apokalypse zerstört worden waren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132957&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'69a33c00-9f1b-4876-bb1b-b70538a2c692\', \'multiverseId\': 132957}, \'multiverseid\': 132957}, {\'name\': \'Metralla\', \'text\': \'La Metralla hace 1 punto de daño a la criatura o jugador objetivo.\\nTormenta (Cuando juegues este hechizo, cópialo por cada hechizo jugado antes que él en este turno. Puedes elegir nuevos objetivos para las copias.)\', \'type\': \'Conjuro\', \'flavor\': \'Los magos muchas veces buscan emular las poderosas reliquias perdidas con el tiempo y el apocalipsis.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134462&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'47288aa0-6eac-4a76-9ec7-a86f94f0e398\', \'multiverseId\': 134462}, \'multiverseid\': 134462}, {\'name\': \'Mitraille\', \'text\': \'La mitraille inflige 1 blessure à une cible, créature ou joueur.\\nDéluge (Quand vous jouez ce sort, copiez-le pour chaque sort joué avant lui ce tour-ci. Vous pouvez choisir de nouvelles cibles pour ces copies.)\', \'type\': \'Rituel\', \'flavor\': "Les mages cherchent souvent à imiter les puissantes reliques perdues dans le temps et l\'apocalypse.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132656&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'412f900b-25e4-4d4e-b075-7a213f5408ac\', \'multiverseId\': 132656}, \'multiverseid\': 132656}, {\'name\': \'Mitraglia\', \'text\': \'La Mitraglia infligge 1 danno a una creatura o a un giocatore bersaglio.\\nTempesta (Quando giochi questa magia, copiala per ogni magia giocata prima in questo turno. Puoi scegliere nuovi bersagli per le copie.)\', \'type\': \'Stregoneria\', \'flavor\': "I maghi spesso cercano di emulare le potenti reliquie smarrite nel tempo e nell\'apocalisse.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133258&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8d4e3cbe-23b7-4102-9139-d52515fc85af\', \'multiverseId\': 133258}, \'multiverseid\': 133258}, {\'name\': \'ぶどう弾\', \'text\': \'クリーチャー１体かプレイヤー１人を対象とする。ぶどう弾はそれに１点のダメージを与える。\\nストーム （あなたがこの呪文をプレイしたとき、それを、このターンそれより前にプレイされていた呪文の総数に等しい回数だけコピーする。 あなたはそのコピーの新しい対象を選んでもよい。）\', \'type\': \'ソーサリー\', \'flavor\': \'魔道士はしばしば、時や最終戦争で失われた強力な遺物を模倣する方法を求める。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133559&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dfa6e438-f513-49f7-86f9-d2c87d935a9c\', \'multiverseId\': 133559}, \'multiverseid\': 133559}, {\'name\': \'Metralha\', \'text\': \'Metralha causa 1 ponto de dano à criatura alvo ou ao jogador alvo.\\nRajada (Quando você jogar esta mágica, faça uma cópia dela para cada mágica jogada antes dela neste turno. Você pode escolher novos alvos para a cópia.)\', \'type\': \'Feitiço\', \'flavor\': \'Os magos freqüentemente tentam emular as poderosas relíquias perdidas para o tempo e o apocalipse.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133860&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a371cbdb-21ad-482d-861f-1eb38a7122bb\', \'multiverseId\': 133860}, \'multiverseid\': 133860}, {\'name\': \'Крупная Картечь\', \'text\': \'Крупная Картечь наносит 1 повреждение целевому существу или игроку.\\nШторм (Когда вы играете это заклинание, скопируйте его за каждое сыгранное в этом ходу заклинание. Вы можете выбрать новые цели для этих копий.)\', \'type\': \'Волшебство\', \'flavor\': \'Маги иногда пытаются сымитировать сильные реликты, потерянные во времени и апокалипсисе.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134161&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e6a967b0-0d64-47cd-8941-59bda88c02c2\', \'multiverseId\': 134161}, \'multiverseid\': 134161}, {\'name\': \'霰散弹\', \'text\': \'霰散弹对目标生物或牌手造成1点伤害。\\n风暴（当你使用此咒语时，本回合于它之前每使用过一个咒语，便将此咒语复制一次。） 你可以为每个复制品选择新的目标。）\', \'type\': \'法术\', \'flavor\': \'法师总想仿真那些毁于时间与末日战火的强大遗物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132355&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e79f5f81-c897-4a6a-8029-31aa371b9796\', \'multiverseId\': 132355}, \'multiverseid\': 132355}]', '[{\'name\': \'Traumschleicher\', \'text\': \'Wenn der Traumschleicher ins Spiel kommt, bringe eine bleibende Karte, die du kontrollierst, auf die Hand ihres Besitzers zurück.\', \'type\': \'Kreatur — Illusion\', \'flavor\': \'Was geschieht, wenn der Traum erwacht und der Schlafende langsam in der Erinnerung verblasst?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132912&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'923039a1-cc73-4338-b126-32a98e8a979b\', \'multiverseId\': 132912}, \'multiverseid\': 132912}, {\'name\': \'Acechador onírico\', \'text\': \'Cuando el Acechador onírico entre en juego, regresa un permanente que controles a la mano de su propietario.\', \'type\': \'Criatura — Ilusión\', \'flavor\': \'¿Qué sucede cuando el sueño es el que despierta y el soñador el que se desvanece en la memoria?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134417&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4f999b75-ab3a-4fcb-8bea-aa54d26ecf9d\', \'multiverseId\': 134417}, \'multiverseid\': 134417}, {\'name\': \'Pisteur des rêves\', \'text\': \'Quand le Pisteur des rêves arrive en jeu, renvoyez un permanent que vous contrôlez dans la main de son propriétaire.\', \'type\': \'Créature : illusion\', \'flavor\': "Qu\'arrive-t-il quand c\'est le rêve qui s\'éveille et le dormeur qui disparaît dans la mémoire ?", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132611&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e111135d-d996-427a-b5df-6919add7e6a0\', \'multiverseId\': 132611}, \'multiverseid\': 132611}, {\'name\': \'Cacciatore Onirico\', \'text\': \'Quando il Cacciatore Onirico entra in gioco, fai tornare un permanente che controlli in mano al suo proprietario.\', \'type\': \'Creatura — Illusione\', \'flavor\': \'Cosa accade quando è il sogno che si sveglia e il dormiente che svanisce nella memoria?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133213&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c9aed8e9-4f42-473c-985b-3ee78e271936\', \'multiverseId\': 133213}, \'multiverseid\': 133213}, {\'name\': \'夢で忍び寄るもの\', \'text\': \'夢で忍び寄るものが場に出たとき、あなたがコントロールするパーマネントを１つオーナーの手札に戻す。\', \'type\': \'クリーチャー — イリュージョン\', \'flavor\': \'夢が目覚め、眠れるものが記憶の彼方に消え時、いったい何が起こるのだろう？\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133514&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1dd044e4-de5b-4e1a-a0de-3757caf29a7c\', \'multiverseId\': 133514}, \'multiverseid\': 133514}, {\'name\': \'Caçador de Sonhos\', \'text\': \'Quando Caçador de Sonhos entrar em jogo, devolva uma permanente que você controla para a mão de seu dono.\', \'type\': \'Criatura — Ilusão\', \'flavor\': \'O que acontece quando é o sonho que acorda e o adormecido que desaparece na memória?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133815&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1d8b1a1b-f276-4160-b32c-ca6383174940\', \'multiverseId\': 133815}, \'multiverseid\': 133815}, {\'name\': \'Охотник на Сны\', \'text\': \'Когда Охотник на Сны входит в игру, верните целевой перманент под вашим контролем в руку владельца.\', \'type\': \'Существо — Иллюзия\', \'flavor\': \'Что случается, когда сон будит, и спящий растворяется в памяти?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134116&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0571cb72-2981-430b-bc62-c9d5311ca87e\', \'multiverseId\': 134116}, \'multiverseid\': 134116}, {\'name\': \'梦境潜影\', \'text\': \'当梦境潜影进场时，将由你操控的一个永久物移回其拥有者手上。\', \'type\': \'生物～虚影\', \'flavor\': \'如果醒来的是梦境，褪入记忆者是作梦的人，该会如何？\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132310&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'54391ab6-6e31-4195-bdff-374366cea48d\', \'multiverseId\': 132310}, \'multiverseid\': 132310}]', '[{\'name\': \'Triskelavus\', \'text\': \'Fliegend\\nDer Triskelavus kommt mit drei +1/+1-Marken ins Spiel.\\n{1}, entferne eine +1/+1-Marke vom Triskelavus: Bringe einen 1/1 Triskelavit-Artefaktkreaturspielstein mit Flugfähigkeit ins Spiel. Er hat „Opfere diese Kreatur: Diese Kreatur fügt einer Kreatur oder einem Spieler deiner Wahl 1 Schadenspunkt zu".\', \'type\': \'Artefaktkreatur — Konstrukt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133125&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a69978d6-5ac3-40b7-887b-4847adae75cc\', \'multiverseId\': 133125}, \'multiverseid\': 133125}, {\'name\': \'Trisquélavo\', \'text\': \'Vuela.\\nEl Trisquélavo entra en juego con tres contadores +1/+1 sobre él.\\n{1}, remover un contador +1/+1 del Trisquélavo: Pon en juego una ficha de criatura artefacto Trisquelavita 1/1 con la habilidad de volar. Tiene "Sacrificar esta criatura: Esta criatura hace 1 punto de daño a la criatura o jugador objetivo".\', \'type\': \'Criatura artefacto — Constructo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134630&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4ead6f9a-d25a-4171-885f-a119eb85ef29\', \'multiverseId\': 134630}, \'multiverseid\': 134630}, {\'name\': \'Triskelavus\', \'text\': \'Vol\\nLe Triskelavus arrive en jeu avec trois marqueurs +1/+1 sur lui.\\n{1}, retirez un marqueur a +1/+1 du Triskelavus : Mettez en jeu un jeton de créature-artefact 1/1 Triskelavite avec le vol. Il a « Sacrifiez cette créature : Cette créature inflige 1 blessure à une cible, créature ou joueur. »\', \'type\': \'Créature-artefact : construction\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132824&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6b1a3eb2-6f34-4163-9757-62eb5fcbc92e\', \'multiverseId\': 132824}, \'multiverseid\': 132824}, {\'name\': \'Triskelavus\', \'text\': \'Volare\\nTriskelavus entra in gioco con tre segnalini +1/+1 su di esso.\\n{1}, Rimuovi un segnalino +1/+1 da Triskelavus: Metti in gioco una pedina creatura artefatto Triskelavite 1/1 con volare. Ha "Sacrifica questa creatura: Questa creatura infligge 1 danno a una creatura o a un giocatore bersaglio."\', \'type\': \'Creatura Artefatto — Costrutto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133426&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d146aef3-e507-40e5-9a3c-de8ca667f0bd\', \'multiverseId\': 133426}, \'multiverseid\': 133426}, {\'name\': \'トリスケラバス\', \'text\': \'飛行\\nトリスケラバスは、３個の＋１/＋１カウンターが置かれた状態で場に出る。\\n{1}, トリスケラバスから＋１/＋１カウンターを１個取り除く：飛行を持つ１/１のトリスケラバイト・アーティファクト・クリーチャー・トークンを１個場に出す。 それは「このクリーチャーを生け贄に捧げる：クリーチャー１体かプレイヤー１人を対象とする。このクリーチャーはそれに１点のダメージを与える。」の能力を持つ。\', \'type\': \'アーティファクト・クリーチャー — 構築物\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133727&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d3978c55-6ab7-4ad8-a648-4ec7940deccb\', \'multiverseId\': 133727}, \'multiverseid\': 133727}, {\'name\': \'Triscelavus\', \'text\': \'Voar\\nTriscelavus entra em jogo com três marcadores +1/+1 sobre ele.\\n{1}, Remova um marcador +1/+1 de Triscelavus: Coloque em jogo uma ficha de criatura artefato 1/1 do tipo Triscelavite com a habilidade de voar. Ele tem "Sacrifique esta criatura: Esta criatura causa 1 ponto de dano à criatura alvo ou ao jogador alvo."\', \'type\': \'Criatura Artefato — Constructo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134028&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3d86654c-db52-48cc-bb6b-d34a7562c144\', \'multiverseId\': 134028}, \'multiverseid\': 134028}, {\'name\': \'Трискелавус\', \'text\': \'Полет\\nТрискелавус входит в игру с тремя +1/+1 жетонами на нем.\\n{1}, Удалите один +1/+1 жетон с Трискелавуса: Положите одну фишку артефактного существа 1/1 Трискелавит с полетом в игру. Она получает "Пожертвуйте это существо: Это существо наносит 1 повреждение целевому существу или игроку."\', \'type\': \'артефактное Существо — Конструкция\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134329&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e0049d7b-0369-4ca8-886f-287b1d02c467\', \'multiverseId\': 134329}, \'multiverseid\': 134329}, {\'name\': \'三节兽\', \'text\': \'飞行\\n三节兽进场时上面有三个+1/+1指示物。\\n{1}，从三节兽上移去一个+1/+1指示物：将一个1/1，具飞行异能的三分节神器生物衍生物放置进场。 它具有「牺牲此生物：此生物对目标生物或牌手造成1点伤害。」\', \'type\': \'神器生物～组构体\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132523&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'01fd87a7-0c2c-4197-a4d3-5ad38698aed5\', \'multiverseId\': 132523}, \'multiverseid\': 132523}]', '[{\'name\': \'Umklammerung des Verräters\', \'text\': \'Eine Kreatur deiner Wahl erhält +1/+0, wird schwarz und erhält Irrealität bis zum Ende des Zuges. (Er kann nur Kreaturen mit Irrealität blocken und nur von ihnen geblockt werden.)\\nRückblende {1}{B} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten spielen. Entferne sie dann ganz aus dem Spiel.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133122&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8f51198e-1563-49f9-8b0f-6d9469b6a9c8\', \'multiverseId\': 133122}, \'multiverseid\': 133122}, {\'name\': \'Agarre del traidor\', \'text\': \'La criatura objetivo obtiene +1/+0, es negra y gana la habilidad de desvanecerse hasta el final del turno. (Sólo puede bloquear o ser bloqueada por criaturas con la habilidad de desvanecerse.)\\nRetrospectiva {1}{B} (Puedes jugar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego remuévela del juego.)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134627&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a3cdf543-1814-41ee-99d6-7f4fb8d1e82a\', \'multiverseId\': 134627}, \'multiverseid\': 134627}, {\'name\': \'Emprise du traître\', \'text\': "La créature ciblée gagne +1/+0, devient noire et acquiert la distorsion jusqu\'à la fin du tour. (Elle ne peut bloquer ou être bloquée que par des créatures avec la distorsion.)\\nFlashback {1}{B} (Vous pouvez jouer cette carte depuis votre cimetière pour son coût de flashback. Retirez-la ensuite de la partie.)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132821&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5e052c2b-957a-49b6-a178-b650aa4cdbfd\', \'multiverseId\': 132821}, \'multiverseid\': 132821}, {\'name\': \'Morsa del Traditore\', \'text\': \'Una creatura bersaglio prende +1/+0, diventa nera e ha ombra fino alla fine del turno. (Può bloccare o essere bloccato solo da creature con ombra.)\\nFlashback {1}{B} (Puoi giocare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi rimuovila dal gioco).\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133423&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'65a0dd29-a7b8-4e9f-b2e0-9b838a6fe1b2\', \'multiverseId\': 133423}, \'multiverseid\': 133423}, {\'name\': \'裏切り者の手中\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋１/＋０の修整を受けるとともに黒になりシャドーを得る。 （それは、シャドーを持つクリーチャーのみをブロックでき、ブロックされる。）\\nフラッシュバック {1}{B} （あなたはフラッシュバック・コストで、このカードをあなたの墓地からプレイしてもよい。 その後それをゲームから取り除く）\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133724&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c02e0fd4-b332-47e4-b559-8d8635cf53f5\', \'multiverseId\': 133724}, \'multiverseid\': 133724}, {\'name\': \'Abraço do Traidor\', \'text\': \'A criatura alvo recebe +1/+0, torna-se preta e recebe sombra até o final do turno. (Ele só pode bloquear ou ser bloqueado por criaturas com sombra.)\\nRecapitular {1}{B} (Você pode jogar este card de seu cemitério pagando seu custo de recapitulação. Depois remova-o do jogo.)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134025&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c8139ab7-3e3c-4acb-b993-eed676b04f23\', \'multiverseId\': 134025}, \'multiverseid\': 134025}, {\'name\': \'Захват Предателя\', \'text\': \'Целевое существо получает +1/+0, становится черным и получает тень до конца хода. (Это существо может блокировать и быть заблокировано только существ(ами) с тенью.)\\nВоспоминание {1}{B} (Вы можете играть эту карту из вашего кладбища за ее стоимость воспоминания. Затем уберите ее из игры.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134326&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'658f5327-31db-4b6d-9698-bfe0ae6b86f6\', \'multiverseId\': 134326}, \'multiverseid\': 134326}, {\'name\': \'叛徒魔掌\', \'text\': \'直到回合结束，目标生物得+1/+0，成为黑色，且获得次元幽影异能。 （它只能阻挡具次元幽影异能的生物，亦只能被具此异能的生物阻挡。）\\n返照{1}{B}（你可以从你的坟墓场使用此牌，并支付其返照费用， 然后将它移出对战。）\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132520&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cda81916-b2f8-481e-ae86-a61c66dce646\', \'multiverseId\': 132520}, \'multiverseid\': 132520}]', '[{\'name\': \'Ungezieferhof\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}.\\n{T}: Regeneriere ein Insekt, eine Ratte, eine Spinne oder ein Eichhörnchen deiner Wahl.\', \'type\': \'Land\', \'flavor\': \'Wo Aasfresser in leergenagten Brustkörben hausen und Geschnatter aus leeren Augenhöhlen tönt, traut sich kaum jemand durch.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133104&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7e670159-84a1-47bf-850a-5ac04aa875e5\', \'multiverseId\': 133104}, \'multiverseid\': 133104}, {\'name\': \'Cemenjambre\', \'text\': \'{T}: Agrega {1} a tu reserva de maná.\\n{T}: Regenera el Insecto, Rata, Ardilla o Araña objetivo.\', \'type\': \'Tierra\', \'flavor\': \'Donde los carroñeros anidan en esqueletos vacíos y los gusanos reptan entre calaveras, pocos se animan a caminar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134609&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'44d38ad7-3b80-4994-a18e-21e8acd9c362\', \'multiverseId\': 134609}, \'multiverseid\': 134609}, {\'name\': \'Grouilletière\', \'text\': "{T} : Ajoutez {1} à votre réserve.\\n{T} : Régénérez l\'insecte, le rat, l\'araignée ou l\'écureuil ciblé.", \'type\': \'Terrain\', \'flavor\': "Là où les charognards se nichent dans des cages thoraciques évidées et les insectes vous observent depuis des orbites vides, peu osent s\'aventurer.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132803&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5cf16a0c-dfc7-414a-8947-62aa8eb27d9a\', \'multiverseId\': 132803}, \'multiverseid\': 132803}, {\'name\': \'Brulicampo\', \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana.\\n{T}: Rigenera un Insetto, Ratto, Ragno o Scoiattolo bersaglio.\', \'type\': \'Terra\', \'flavor\': \'Ben pochi osano intrufolarsi dove si annidano saprofagi in gabbie toraciche scavate e striscianti vermiciattoli sbirciano da orbite vuote.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133405&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3d6d60d0-05db-43ac-9717-854f5d60d6e5\', \'multiverseId\': 133405}, \'multiverseid\': 133405}, {\'name\': \'群がりの庭\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。\\n{T}：昆虫１体かネズミ１体か蜘蛛１体かリス１体を対象とし、それを再生する。\', \'type\': \'土地\', \'flavor\': \'空っぽの肋骨の中に死肉漁りが棲みつき、何も無い眼窩の中から甲高い声の生き物が覗き見ている場所に好きで侵入する者など、ほとんどいない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133706&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'80fbb013-8ccc-4012-a508-1d25b2107a9a\', \'multiverseId\': 133706}, \'multiverseid\': 133706}, {\'name\': \'Vermitério\', \'text\': \'{T}: Adicione {1} à sua reserva de mana.\\n{T}: Regenere o Inseto, Rato, Aranha ou Esquilo alvo.\', \'type\': \'Terreno\', \'flavor\': \'Onde os carniçais aninham-se em caixas torácicas ocas e répteis chiadores espreitam de cavidades oculares vazias, poucos são os que ousam atravessar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134007&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a4c2f7ba-8867-4a5e-ae96-06857bdd6745\', \'multiverseId\': 134007}, \'multiverseid\': 134007}, {\'name\': \'Двор Стаи\', \'text\': \'{T}: Добавьте {1} в ваше хранилище маны.\\n{T}: Регенерируйте целевое Насекомое, Крысу, Паука или Белку.\', \'type\': \'Земля\', \'flavor\': \'Там, где падальщики гнездились в полых реберных клетках, и пищащие выползки смотрели из пустых глазниц, немногие отваживались ходить.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134308&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4280e55e-b0cf-4a06-80ce-a0b14142a684\', \'multiverseId\': 134308}, \'multiverseid\': 134308}, {\'name\': \'暴群墓场\', \'text\': \'{T}：加{1}到你的法术力池中。\\n{T}：重生目标昆虫，老鼠，蜘蛛，或松鼠。\', \'type\': \'地\', \'flavor\': \'腐食者把胸腔啃得精光充当窝巢，吱叫爬行的东西从空荡的眼窝向外张望；少有人胆敢擅闯此地。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132502&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a890009f-ba92-44f9-8461-b61e16b285a9\', \'multiverseId\': 132502}, \'multiverseid\': 132502}]', '[{\'name\': \'Unterirdischer Schlurfer\', \'text\': \'Echo {3}{R} (Opfere zu Beginn deines Versorgungssegments diese bleibende Karte, falls sie seit deinem letzten Versorgungssegment unter deine Kontrolle gekommen ist, falls du nicht ihre Echokosten bezahlst.)\\nWenn der Unterirdische Schlurfer ins Spiel kommt oder das Spiel verlässt, fügt er allen nichtfliegenden Kreaturen 1 Schadenspunkt zu.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133095&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c0714107-f23f-4b1e-a63e-b901ca27b464\', \'multiverseId\': 133095}, \'multiverseid\': 133095}, {\'name\': \'Desollador subterráneo\', \'text\': \'Eco {3}{R} (Al comienzo de tu mantenimiento, si esto entró bajo tu control desde el comienzo de tu último mantenimiento, sacrifícalo a menos que pagues su coste de eco.)\\nCuando el Desollador subterráneo entre en juego o deje el juego, le hace 1 punto de daño a cada criatura sin la habilidad de volar.\', \'type\': \'Criatura — Elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134600&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d805ad1c-8b1a-4af3-8d76-62f775fe07f8\', \'multiverseId\': 134600}, \'multiverseid\': 134600}, {\'name\': \'Escogriffe souterrain\', \'text\': "Écho {3}{R} (Au début de votre entretien, si ce permanent est passé sous votre contrôle depuis le début de votre dernier entretien, sacrifiez-le à moins que vous ne payiez son coût d\'écho.)\\nQuand l\'Escogriffe souterrain arrive en jeu ou quitte le jeu, il inflige 1 blessure à chaque créature sans le vol.", \'type\': \'Créature : élémental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132794&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b79eabbb-bad6-4c1d-b920-adff4a8548da\', \'multiverseId\': 132794}, \'multiverseid\': 132794}, {\'name\': \'Errante Sotterranea\', \'text\': "Eco {1}{R} (All\'inizio del tuo mantenimento, se questo permanente è entrato sotto il tuo controllo dall\'inizio del tuo ultimo mantenimento, sacrificalo a meno che non paghi il suo costo di eco.)\\nQuando l\'Errante Sotterranea entra in gioco o lascia il gioco, infligge 1 danno a ogni creatura senza volare.", \'type\': \'Creatura — Elementale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133396&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ab1bd491-668b-4ae4-963f-4cb19de2a318\', \'multiverseId\': 133396}, \'multiverseid\': 133396}, {\'name\': \'地の底のシャンブラー\', \'text\': \'エコー {3}{R} （あなたのアップキープの開始時に、これが直前のあなたのアップキープの開始時よりも後にあなたのコントロール下になっていた場合、それのエコー・コストを支払わないかぎり、それを生け贄に捧げる。）\\n地の底のシャンブラーが場に出るか場から離れるかしたとき、それは飛行を持たない各クリーチャーにそれぞれ１点のダメージを与える。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133697&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'893f86af-410c-45f0-936d-b7f38cdef552\', \'multiverseId\': 133697}, \'multiverseid\': 133697}, {\'name\': \'Trôpego Subterrâneo\', \'text\': \'Eco {3}{R} (No início de sua manutenção, se esta permanente passou a estar sob o seu controle desde o início de sua última manutenção, sacrifique-a, a menos que você pague seu custo de eco.)\\nQuando Trôpego Subterrâneo entra em jogo ou deixa o jogo, ele causa 1 ponto de dano a cada criatura sem voar.\', \'type\': \'Criatura — Elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133998&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3bf6259f-7c15-4b71-b892-7dd70f7e8d61\', \'multiverseId\': 133998}, \'multiverseid\': 133998}, {\'name\': \'Подземное Шаркало\', \'text\': \'Эхо {3}{R} (В начале вашего шага поддержки, если это существо попало под ваш контроль с момента начала вашего предыдущего шага поддержки, пожертвуйте его, если вы не заплатите его эхо-стоимость.)\\nКогда Подземное Шаркало входит в игру или покидает игру, оно наносит 1 повреждение всем существам без полета.\', \'type\': \'Существо — Элементаль\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134299&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'074ec5f5-caaa-43d0-83a8-5df751227384\', \'multiverseId\': 134299}, \'multiverseid\': 134299}, {\'name\': \'地底跛行兽\', \'text\': \'返响{3}{R}（在你的维持开始时，若你在你前一个维持开始后才操控它，则除非你支付其返响费用，否则牺牲之。）\\n当地底跛行兽进场或离场时，它对每个不具飞行异能的生物造成1点伤害。\', \'type\': \'生物～元素\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132493&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fabee86e-f479-4074-9f82-1acf5c283845\', \'multiverseId\': 132493}, \'multiverseid\': 132493}]', "[{'name': 'Unvergänglicher Zorn', 'text': 'Kreaturenverzauberung\\nDie verzauberte Kreatur erhält +2/+2 und kann nicht blocken.\\nWenn der Unvergängliche Zorn in einen Friedhof gelegt wird, bringe den Unvergänglichen Zorn auf die Hand seines Besitzers zurück.', 'type': 'Verzauberung — Aura', 'flavor': 'Radha war im Wolkenwald geboren worden, aber ihr Temperament stammt aus Keld.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133129&type=card', 'language': 'German', 'identifiers': {'scryfallId': '489d7789-5335-4d4c-a640-c1b8d5cc53de', 'multiverseId': 133129}, 'multiverseid': 133129}, {'name': 'Furia inmortal', 'text': 'Encantar criatura.\\nLa criatura encantada obtiene +2/+2 y no puede bloquear.\\nCuando la Furia inmortal vaya a un cementerio desde el juego, regresa la Furia inmortal a la mano de su propietario.', 'type': 'Encantamiento — Aura', 'flavor': 'Radha nació en Veloceleste, pero su carácter era innegablemente keldon.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134634&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ceb530ec-efd8-44d7-89cb-0012b5a36855', 'multiverseId': 134634}, 'multiverseid': 134634}, {'name': 'Rage inextinguible', 'text': 'Enchanter : créature\\nLa créature enchantée gagne +2/+2 et ne peut pas bloquer.\\nQuand la Rage inextinguible est mise dans un cimetière depuis le jeu, renvoyez la Rage inextinguible dans la main de son propriétaire.', 'type': 'Enchantement : aura', 'flavor': 'Radha était née à Linciel, mais elle avait un caractère indéniablement kelde.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132828&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c1b18544-d790-4454-b0ea-3be3c40f81bc', 'multiverseId': 132828}, 'multiverseid': 132828}, {'name': 'Rabbia Imperitura', 'text': 'Incanta creatura\\nLa creatura incantata prende +2/+2 e non può bloccare.\\nQuando la Rabbia Imperitura viene messa in un cimitero dal gioco, fai tornare la Rabbia Imperitura in mano al suo proprietario.', 'type': 'Incantesimo — Aura', 'flavor': 'Radha era nata a Cielsudario, ma la sua indole è innegabilmente di Keld.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133430&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '0d244323-f0f5-4a71-bca4-4251d6feeec8', 'multiverseId': 133430}, 'multiverseid': 133430}, {'name': '死せざる怒り', 'text': 'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは、＋２/＋２の修整を受けるとともにブロックできない。\\n死せざる怒りが場からいずれかの墓地に置かれたとき、死せざる怒りをオーナーの手札に戻す。', 'type': 'エンチャント — オーラ', 'flavor': 'ラーダはスカイシュラウドの生まれだが、気質は疑いよう無くケルドン人だ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133731&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'd6907368-088a-4bad-b2b8-26de0ef0af05', 'multiverseId': 133731}, 'multiverseid': 133731}, {'name': 'Fúria Imortal', 'text': 'Encantar Criatura\\nA criatura encantada recebe +2/+2 e não pode bloquear.\\nQuando Fúria Imortal for colocado no cemitério vindo do jogo, devolva Fúria Imortal para a mão de seu dono.', 'type': 'Encantamento — Aura', 'flavor': 'Radha nasceu em Skyshroud, mas seu temperamento é inegavelmente keldoniano.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134032&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5fb2526b-3593-4513-b7cb-1d60d51a53a0', 'multiverseId': 134032}, 'multiverseid': 134032}, {'name': 'Бессмертная Ярость', 'text': 'Зачаровать существо\\nЗачарованное существо получает +2/+2 и не может блокировать.\\nКогда Бессмертная Ярость попадает на кладбище из игры, верните Бессмертную Ярость в руку ее владельца.', 'type': 'Чары — Аура', 'flavor': 'Рада родилась в Скайшрауде, но ее темперамент неоспоримо является Келдонским.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134333&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'b82d33c8-6066-4384-804c-21f9958a6a0f', 'multiverseId': 134333}, 'multiverseid': 134333}, {'name': '不熄愤怒', 'text': '生物结界\\n受此结界的生物得+2/+2且不能进行阻挡。\\n当不熄愤怒从场上置入坟墓场时，将不熄愤怒移回其拥有者手上。', 'type': '结界～灵气', 'flavor': '拉妲在天帷出生，但脾气百分百属于凯尔顿。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132527&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '7f1754da-b52b-4667-af8d-90cbcbc25dbb', 'multiverseId': 132527}, 'multiverseid': 132527}]", '[{\'name\': \'Unyarobienen\', \'text\': \'Fliegend\\n{G}: Die Unyarobienen erhalten +1/+1 bis zum Ende des Zuges.\\n{3}{G}, opfere die Unyarobienen: Die Unyarobienen fügen einer Kreatur oder einem Spieler deiner Wahl 2 Schadenspunkte zu.\', \'type\': \'Kreatur — Insekt\', \'flavor\': \'Als es keinen Dschungel mehr gab, in dem sie leben konnte, breitete sich „die stechende Pest" in ganz Dominaria aus.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133130&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'786d9df8-83eb-4616-a6d0-549d0097c60e\', \'multiverseId\': 133130}, \'multiverseid\': 133130}, {\'name\': \'Abejas de Unyaro\', \'text\': \'Vuela.\\n{G}: Las Abejas de Unyaro obtienen +1/+1 hasta el final del turno.\\n{3}{G}, sacrificar las Abejas de Unyaro: Las Abejas de Unyaro hacen 2 puntos de daño a la criatura o jugador objetivo.\', \'type\': \'Criatura — Insecto\', \'flavor\': \'Sin más jungla para contenerla, la "plaga de dagas" se esparció por toda Dominaria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134635&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ccc35ef7-06dc-495e-9829-e559eeeb6781\', \'multiverseId\': 134635}, \'multiverseid\': 134635}, {\'name\': "Abeilles de l\'Ounyaro", \'text\': "Vol\\n{G} : Les Abeilles de l\'Ounyaro gagnent +1/+1 jusqu\'à la fin du tour.\\n{3}{G}, sacrifiez les Abeilles de l\'Ounyaro : Les Abeilles de l\'Ounyaro infligent 2 blessures à une cible, créature ou joueur.", \'type\': \'Créature : insecte\', \'flavor\': \'Sans jungle pour la contenir, la « peste de dagues » se répandit sur Dominaria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132829&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a6c0892f-8901-43f6-8a1f-7c83de1d09ee\', \'multiverseId\': 132829}, \'multiverseid\': 132829}, {\'name\': \'Api di Unyaro\', \'text\': \'Volare\\n{G}: Le Api di Unyaro prendono +1/+1 fino alla fine del turno.\\n{3}{G}, Sacrifica le Api di Unyaro: Le Api di Unyaro infliggono 2 danni a una creatura o a un giocatore bersaglio.\', \'type\': \'Creatura — Insetto\', \'flavor\': \'Senza più giungla che la contenesse, l\\\'"epidemia dei pugnali" si diffuse in tutta Dominaria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133431&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d913b5fd-bfbe-404e-8823-0d12fc97c554\', \'multiverseId\': 133431}, \'multiverseid\': 133431}, {\'name\': \'ウンヤロ蜂\', \'text\': \'飛行\\n{G}：ウンヤロ蜂はターン終了時まで＋１/＋１の修整を受ける。\\n{3}{G}, ウンヤロ蜂を生け贄に捧げる：クリーチャー１体かプレイヤー１人を対象とする。ウンヤロ蜂はそれに２点のダメージを与える。\', \'type\': \'クリーチャー — 昆虫\', \'flavor\': \'住むべきジャングルが無くなったとき、「疫病刀」はドミナリア中に広がっていった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133732&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9fa72423-9ed4-4dad-8edb-452d47529f74\', \'multiverseId\': 133732}, \'multiverseid\': 133732}, {\'name\': \'Abelhas de Unyaro\', \'text\': \'Voar\\n{G}: Abelhas de Unyaro recebe +1/+1 até o final do turno.\\n{3}{G}, Sacrifique Abelhas de Unyaro: Abelhas de Unyaro causa 2 pontos de dano à criatura alvo ou ao jogador alvo.\', \'type\': \'Criatura — Inseto\', \'flavor\': \'Sem nenhuma floresta remanescente para abrigá-la, a "praga de adagas" espalhou-se por Dominária.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134033&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3a86932c-35a9-4929-8653-f1c4f48196f1\', \'multiverseId\': 134033}, \'multiverseid\': 134033}, {\'name\': \'Унярийские Пчелы\', \'text\': \'Полет\\n{G}: Унярийские Пчелы получают +1/+1 до конца хода.\\n{3}{G}, Пожертвуйте Унярийских Пчел: Унярийские Пчелы наносят 2 повреждения целевому существу или игроку.\', \'type\': \'Существо — Насекомое\', \'flavor\': \'«Кинжальная чума» распространилась по всей Доминарии, когда не осталось сдерживающих ее джунглей.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134334&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5d6a99fa-2cac-44fa-9312-c08ea21e71c4\', \'multiverseId\': 134334}, \'multiverseid\': 134334}, {\'name\': \'文亚若蜂\', \'text\': \'飞行\\n{G}：文亚若蜂得+1/+1直到回合结束。\\n{3}{G}，牺牲文亚若蜂：文亚若蜂对目标生物或牌手造成2点伤害。\', \'type\': \'生物～昆虫\', \'flavor\': \'失去丛林栖所之后，这股「千刀天灾」散播至多明纳里亚全境。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132528&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'67246ad7-4fb1-4004-84fd-e89c5ff70175\', \'multiverseId\': 132528}, \'multiverseid\': 132528}]', '[{\'name\': \'Uralter Groll\', \'text\': \'Zerstöre ein Artefakt deiner Wahl.\\nRückblende {G} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten spielen. Entferne sie dann ganz aus dem Spiel.)\', \'type\': \'Spontanzauber\', \'flavor\': \'Die Risse im Zeitgefüge erinnern Yavimaya an die vielen Feinde der Vergangenheit und liefern den Feuern immer wieder neue Nahrung.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132860&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'01d9fe52-ae7c-4e86-bee1-bb7161debd5d\', \'multiverseId\': 132860}, \'multiverseid\': 132860}, {\'name\': \'Agravio antiguo\', \'text\': \'Destruye el artefacto objetivo.\\nRetrospectiva {G} (Puedes jugar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego remuévela del juego.)\', \'type\': \'Instantáneo\', \'flavor\': \'Las brechas de tiempo recuerdan a Yavimaya los enemigos de su pasado y proveen nuevo combustible para sus fuegos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134365&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f36510cc-51c5-445c-93b5-a5c7862317d7\', \'multiverseId\': 134365}, \'multiverseid\': 134365}, {\'name\': \'Ancienne rancœur\', \'text\': "Détruisez l\'artefact ciblé.\\nFlashback {G} (Vous pouvez jouer cette carte depuis votre cimetière pour son coût de flashback. Retirez-la ensuite de la partie.)", \'type\': \'Éphémère\', \'flavor\': \'Les failles temporelles rappellent à la Yavimaya les ennemis de son passé et donnent une nouvelle énergie à ses feux.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132559&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3f1b0214-0d77-42ed-a34a-dd48a0f9243a\', \'multiverseId\': 132559}, \'multiverseid\': 132559}, {\'name\': \'Antico Rancore\', \'text\': \'Distruggi un artefatto bersaglio.\\nFlashback {G} (Puoi giocare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi rimuovila dal gioco).\', \'type\': \'Istantaneo\', \'flavor\': \'Gli squarci temporali ricordano a Yavimaya i nemici del suo passato e alimentano i suoi fuochi con nuovo combustibile.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133161&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'06f94fd0-5cdd-4ab0-9e88-7d3743454f16\', \'multiverseId\': 133161}, \'multiverseid\': 133161}, {\'name\': \'古えの遺恨\', \'text\': \'アーティファクト１つを対象とし、それを破壊する。\\nフラッシュバック {G} （あなたはフラッシュバック・コストで、このカードをあなたの墓地からプレイしてもよい。 その後それをゲームから取り除く）\', \'type\': \'インスタント\', \'flavor\': \'時の裂け目は、ヤヴィマヤに過去の敵を思い起こさせ、その火に新たな燃料を満たす。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133462&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b5df0f99-4359-4168-b31a-bb5d1c6e2274\', \'multiverseId\': 133462}, \'multiverseid\': 133462}, {\'name\': \'Rancor Antigo\', \'text\': \'Destrua o artefato alvo.\\nRecapitular {G} (Você pode jogar este card de seu cemitério pagando seu custo de recapitulação. Depois remova-o do jogo.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'As fendas do tempo lembram Yavimaya dos inimigos do passado e fornecem combustível novo para suas fogueiras.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133763&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'620d2b94-4da4-43d2-96c3-f82a72bdd737\', \'multiverseId\': 133763}, \'multiverseid\': 133763}, {\'name\': \'Древняя Злоба\', \'text\': \'Уничтожьте целевой артефакт.\\nВоспоминание {G} (Вы можете играть эту карту из вашего кладбища за ее стоимость воспоминания. Затем уберите ее из игры.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Временные разломы напомнили врагам Явимайи об их прошлом и подлили свежего масла в огонь.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134064&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'62bb9149-4e5d-4433-bb7c-332dd8f5252a\', \'multiverseId\': 134064}, \'multiverseid\': 134064}, {\'name\': \'长年怀恨\', \'text\': \'消灭目标神器。\\n返照{G}（你可以从你的坟墓场使用此牌，并支付其返照费用， 然后将它移出对战。）\', \'type\': \'瞬间\', \'flavor\': \'时间裂缝提醒着过往大敌的模样，让亚维马雅的怒火永保旺盛。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132258&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b4c11283-fd74-485d-9108-49fd69c57cf4\', \'multiverseId\': 132258}, \'multiverseid\': 132258}]', '[{\'name\': \'Urborg-Seelenfänger\', \'text\': \'{2}{B}, {T}, wirf eine Karte aus deiner Hand ab: Alle anderen Spieler verlieren 2 Lebenspunkte. Du erhältst so viele Lebenspunkte dazu, wie auf diese Weise Lebenspunkte verloren wurden.\', \'type\': \'Kreatur — Mensch, Spruchwandler\', \'flavor\': \'„Ich bin sozusagen Feinschmecker geworden. Jede Seele hat ihren eigenen, unverwechselbaren Geschmack. Die Kunst ist es jetzt, die richtige Gesellschaft für das Festmahl zu finden."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133131&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'509cc102-dbd3-4ee8-af1c-ed5c8de2c027\', \'multiverseId\': 133131}, \'multiverseid\': 133131}, {\'name\': \'Mago sifón de Urborg\', \'text\': \'{2}{B}, {T}, descartar una carta: Cada otro jugador pierde 2 vidas. Ganas vida igual a la cantidad de vida perdida de esta manera.\', \'type\': \'Criatura — Cambiahechizos humano\', \'flavor\': \'"Me he convertido en un gourmet. Cada alma tiene un sabor especial. El arte es invitar a la persona correcta al festín."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134636&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'79ee96b2-0134-45d2-8498-3c34a530f598\', \'multiverseId\': 134636}, \'multiverseid\': 134636}, {\'name\': "Siphonmage d\'Urborg", \'text\': "{2}{B}, {T}, défaussez-vous d\'une carte : Chaque autre joueur perd 2 points de vie. Vous gagnez autant de points de vie que ceux perdus de cette manière.", \'type\': \'Créature : humain et sortisan\', \'flavor\': "« Je suis devenu une sorte de gourmet. Chaque âme a sa saveur. Le secret de l\'art, c\'est de bien choisir les invités du festin. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132830&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'984e4ecd-afce-4d57-9527-8b1a5b55f94c\', \'multiverseId\': 132830}, \'multiverseid\': 132830}, {\'name\': \'Mago-Sifone di Urborg\', \'text\': \'{2}{B}, {T}, Scarta una carta: Ogni altro giocatore perde 2 punti vita. Guadagni tanti punti vita quanti sono i punti vita persi in questo modo.\', \'type\': \'Creatura — Mutamagia Umano\', \'flavor\': \'"Sono diventato una specie di buongustaio. Ogni anima ha un proprio sapore peculiare. La bravura sta nell\\\'invitare al banchetto la compagnia giusta."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133432&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3d6f4e27-44fd-426e-b092-a743941b6925\', \'multiverseId\': 133432}, \'multiverseid\': 133432}, {\'name\': \'アーボーグの吸魂魔道士\', \'text\': \'{2}{B}, {T}, カードを１枚捨てる：他の各プレイヤーは２点のライフを失う。 あなたはこれにより失われたライフに等しい点数のライフを得る。\', \'type\': \'クリーチャー — 人間・スペルシェイパー\', \'flavor\': \'私がなったのは美食家の類だ。 各々の魂には独自の風味がある。 正しい組み合わせを饗宴に招けるかどうかが腕の差なのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133733&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2014c785-7976-447f-9493-0672ceda618b\', \'multiverseId\': 133733}, \'multiverseid\': 133733}, {\'name\': \'Mago-Sifão de Urborg\', \'text\': \'{2}{B}, {T}, Descarte um card: Cada um dos outros jogadores perde 2 pontos de vida. Você ganha uma quantidade de pontos de vida igual à quantidade de pontos de vida perdida dessa maneira.\', \'type\': \'Criatura — Magimodelador Humano\', \'flavor\': \'"Eu me tornei uma espécie de gourmet. Cada alma tem seu próprio sabor distinto. A arte está em convidar a companhia certa para o banquete."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134034&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1b05b06a-2aa9-4976-890c-a2e1057a1540\', \'multiverseId\': 134034}, \'multiverseid\': 134034}, {\'name\': \'Урборгский Сифон-Маг\', \'text\': \'{2}{B}, {T}, Сбросьте карту: Каждый другой игрок теряет 2 жизни. Вы получаете количество жизней, равное количеству жизней потерянному таким образом.\', \'type\': \'Существо — Человек Заклинатель\', \'flavor\': \'«Я превратился в своего рода гурмана. Каждая душа имеет свой особенный вкус. Искусство в том, чтобы правильно пригласить компанию для пирушки».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134335&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d2936b21-a081-411b-914a-a1f3b83cf847\', \'multiverseId\': 134335}, \'multiverseid\': 134335}, {\'name\': \'乌尔博格吸魂法师\', \'text\': \'{2}{B}，{T}，弃一张牌：每位其它牌手各失去2点生命。 你获得若干生命，其数量等同于牌手以此法失去的生命总和。\', \'type\': \'生物～人类／塑法师\', \'flavor\': \'「我变成了某种美食家。 每个灵魂都有独特的风味。 最精采的部分在于邀请适当的伙伴赴宴。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132529&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f5af6e36-1541-4edc-b757-373a33b6d75f\', \'multiverseId\': 132529}, \'multiverseid\': 132529}]', '[{\'name\': \'Ursprünglicher Kraftmagier\', \'text\': \'Immer wenn eine andere Kreatur unter deiner Kontrolle ins Spiel kommt, erhält diese Kreatur +3/+3 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Elf, Schamane\', \'flavor\': \'Da ihre Rufe von den welkenden Wäldern nicht mehr vernommen wurden, leiteten die Naturschamanen die Lebenskraft in ihre Gleichgesinnten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133046&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fe3a7ad8-011e-47f0-b82f-66891da4984d\', \'multiverseId\': 133046}, \'multiverseid\': 133046}, {\'name\': \'Magofuerza primordial\', \'text\': \'Siempre que otra criatura entre en juego bajo tu control, esa criatura obtiene +3/+3 hasta el final del turno.\', \'type\': \'Criatura — Chamán elfo\', \'flavor\': \'Como sus plegarias no son escuchadas por los bosques resecos, los chamanes de la naturaleza canalizan la fuerza vital de sus hermanos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134551&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'454c6e2d-6134-4c23-9242-96d94aff0f35\', \'multiverseId\': 134551}, \'multiverseid\': 134551}, {\'name\': \'Mageforce primordial\', \'text\': "À chaque fois qu\'une autre créature arrive en jeu sous votre contrôle, cette créature gagne +3/+3 jusqu\'à la fin du tour.", \'type\': \'Créature : elfe et shamane\', \'flavor\': \'Les forêts flétries demeurant sourdes à leurs appels, les shamanes de la nature canalisèrent la force vitale de leurs frères.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132745&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'884fba4d-389d-4ab7-a680-9f0492de4b6f\', \'multiverseId\': 132745}, \'multiverseid\': 132745}, {\'name\': \'Mago della Forza Primordiale\', \'text\': "Ogniqualvolta un\'altra creatura entra in gioco sotto il tuo controllo, quella creatura prende +3/+3 fino alla fine del turno.", \'type\': \'Creatura — Sciamano Elfo\', \'flavor\': \'Le loro invocazioni ignorate dalle foreste inaridite, gli sciamani della natura incanalavano la forza vitale dei loro fratelli.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133347&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6d43426f-14f9-4583-b653-7971960bdfcf\', \'multiverseId\': 133347}, \'multiverseid\': 133347}, {\'name\': \'原初の腕力魔道士\', \'text\': \'他のクリーチャーがあなたのコントロール下で場に出るたび、そのクリーチャーはターン終了時まで＋３/＋３の修整を受ける。\', \'type\': \'クリーチャー — エルフ・シャーマン\', \'flavor\': \'自然のシャーマンたちの呼び声に萎えた森は答えず、代わりに彼らは仲間達の生命力を力とした。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133648&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f98dca84-15b1-43e3-9454-fc497734fd0c\', \'multiverseId\': 133648}, \'multiverseid\': 133648}, {\'name\': \'Mago da Força Primordial\', \'text\': \'Toda vez que outra criatura entra em jogo sob seu controle, aquela criatura recebe +3/+3 até o final do turno.\', \'type\': \'Criatura — Xamã Elfo\', \'flavor\': \'Como seus apelos não foram atendidos pelas florestas secas, os xamãs da natureza canalizaram a força vital de seus irmãos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133949&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'86a094eb-bc7c-41f9-a17a-98a893f1e2b7\', \'multiverseId\': 133949}, \'multiverseid\': 133949}, {\'name\': \'Верховный Силомаг\', \'text\': \'Когда другое существо входит в игру под вашим контролем, оно получает +3/+3 до конца хода.\', \'type\': \'Существо — Эльф Шаман\', \'flavor\': \'Их зовам не внимали иссушенные леса, истинные шаманы проводили жизненные силы их собственных братьев.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134250&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'61094f56-eefe-4047-a451-dd42a7f96209\', \'multiverseId\': 134250}, \'multiverseid\': 134250}, {\'name\': \'原初力法师\', \'text\': \'每当另一个生物在你的操控下进场时，该生物得+3/+3直到回合结束。\', \'type\': \'生物～地精／祭师\', \'flavor\': \'枯萎树林不再任其呼令，自然祭师转而连通其弟兄的生命力量。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132444&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'160c2e54-55a8-484a-8bcc-e88af8708fed\', \'multiverseId\': 132444}, \'multiverseid\': 132444}]', '[{\'name\': \'Urzas Fabrik\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}.\\n{7}, {T}: Bringe einen 2/2 Montagearbeiter-Artefaktkreaturspielstein ins Spiel.\', \'type\': \'Land — Urzas Land\', \'flavor\': \'„Obwohl ihre Weltbilder so unterschiedlich sind, harmonieren Urzas und Mishras Kreationen erstaunlich gut miteinander." —Aus dem Tagebuch von Tocasia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133132&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'919e4996-a3d7-47a2-8710-1453cb960895\', \'multiverseId\': 133132}, \'multiverseid\': 133132}, {\'name\': \'Factoría de Urza\', \'text\': \'{T}: Agrega {1} a tu reserva de maná.\\n{7}, {T}: Pon en juego una ficha de criatura artefacto Operario incolora 2/2.\', \'type\': \'Tierra — de-Urza\', \'flavor\': \'"Aunque sus ideales están muy apartados, las creaciones de Urza y Mishra conservan una sorprendente armonía entre ellas." —Del diario de Tocasia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134637&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8ed77399-b9c0-4af1-9a32-141293fb00bf\', \'multiverseId\': 134637}, \'multiverseid\': 134637}, {\'name\': "Usine d\'Urza", \'text\': \'{T} : Ajoutez {1} à votre réserve.\\n{7}, {T} : Mettez en jeu un jeton de créature-artefact 2/2 Ouvrier spécialisé.\', \'type\': "Terrain : terrain d\'Urza", \'flavor\': "« Bien que leurs idéaux soient opposés, les créations d\'Urza et de Mishra sont dotées d\'une surprenante harmonie. » —Tocasia, extrait de journal", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132831&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'589e3d90-ffed-418f-891b-39bc374083bf\', \'multiverseId\': 132831}, \'multiverseid\': 132831}, {\'name\': \'Fabbrica di Urza\', \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana.\\n{7}, {T}: Metti in gioco una pedina creatura artefatto Addetto-al-Montaggio 2/2.\', \'type\': \'Terra — Terreno di Urza\', \'flavor\': \'"Sebbene i loro ideali siano diametralmente opposti, le creazioni di Urza e di Mishra presentano una sorprendente armonia tra loro." —Tocasia, annotazione del diario\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133433&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4aa64262-c38c-4db9-a076-d4b7a5b6a3d1\', \'multiverseId\': 133433}, \'multiverseid\': 133433}, {\'name\': \'ウルザの工廠\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。\\n{7}, {T}：２/２の組立作業員・アーティファクト・クリーチャー・トークンを１体場に出す。\', \'type\': \'土地 — ウルザの\', \'flavor\': \'ウルザとミシュラの理想は遥かに距離があるが、互いの創造物には驚くべき調和がある。 ――トカシアの日記\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133734&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d5102005-6e23-49b7-95b3-f7f6fb6ed859\', \'multiverseId\': 133734}, \'multiverseid\': 133734}, {\'name\': \'Fábrica de Urza\', \'text\': \'{T}: Adicione {1} à sua reserva de mana.\\n{7}, {T}: Coloque em jogo uma ficha de criatura artefato 2/2 do tipo Operário-de-Linha-de-Montagem.\', \'type\': \'Terreno — De Urza\', \'flavor\': \'"Embora seus ideais sejam completamente diferentes, as criações de Urza e de Mishra apresentam uma surpreendente harmonia entre si." —Tocasia, diário\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134035&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'add981d8-d37c-43ac-b09e-6ad212cb01eb\', \'multiverseId\': 134035}, \'multiverseid\': 134035}, {\'name\': \'Фабрика Урзы\', \'text\': \'{T}: Добавьте {1} в ваше хранилище маны.\\n{7}, {T}: Положите в игру фишку артефактного существа 2/2 Рабочий-сборщик.\', \'type\': \'Земля — Фабрика-Урзы\', \'flavor\': \'«Хотя их идеалы сильно расходились, творения Урзы и Мишры на удивление гармонично сочетались друг с другом», Токасия, запись в журнале\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134336&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1ca7ead4-85bd-4547-9c38-39f0c6f5707e\', \'multiverseId\': 134336}, \'multiverseid\': 134336}, {\'name\': \'克撒的工厂\', \'text\': \'{T}：加{1}到你的法术力池中。\\n{7}，{T}：将一个2/2组装工人神器生物衍生物放置进场。\', \'type\': \'地～克撒的\', \'flavor\': \'「虽然他俩的理念南辕北辙，克撒与米斯拉所造之物却高度地彼此呼应。」 ～托卡西雅的日志片段\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132530&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b4522de1-7ca0-49c5-a159-b161ffe159db\', \'multiverseId\': 132530}, \'multiverseid\': 132530}]', '[{\'name\': \'Vampirremasuri\', \'text\': \'Alle Remasuris haben „Immer wenn eine Kreatur, der in diesem Zug durch diese Kreatur Schaden zugefügt wurde, auf einen Friedhof gelegt wird, lege eine +1/+1-Marke auf diese Kreatur".\', \'type\': \'Kreatur — Remasuri\', \'flavor\': \'Sie leben von der Stärke ihres Schwarms und auch von der ihrer Opfer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133133&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fd7829bf-5511-4192-adfa-9042f2135573\', \'multiverseId\': 133133}, \'multiverseid\': 133133}, {\'name\': \'Fragmentado vampírico\', \'text\': \'Todos los Fragmentados tienen "Siempre que una criatura que haya recibido daño de esta criatura este turno vaya a un cementerio, pon un contador +1/+1 sobre esta criatura".\', \'type\': \'Criatura — Fragmentado\', \'flavor\': \'Sacan su fuerza de su colmena y de sus víctimas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134638&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4e81d902-6b51-4d8e-8c8c-8f58d1273ac3\', \'multiverseId\': 134638}, \'multiverseid\': 134638}, {\'name\': \'Slivoïde vampirique\', \'text\': "Tous les slivoïdes ont « À chaque fois qu\'une créature blessée par cette créature ce tour-ci est mise dans un cimetière, mettez un marqueur +1/+1 sur cette créature. »", \'type\': \'Créature : slivoïde\', \'flavor\': \'Ils puisent la force de leur essaim et celle de leurs victimes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132832&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7c272cac-4c9c-4b47-9761-c90cdad1811d\', \'multiverseId\': 132832}, \'multiverseid\': 132832}, {\'name\': \'Tramutante Vampiro\', \'text\': \'Tutti i Tramutanti hanno "Ogniqualvolta una creatura a cui sia stato inflitto danno da questa creatura in questo turno viene messa in un cimitero, metti un segnalino +1/+1 su questa creatura."\', \'type\': \'Creatura — Tramutante\', \'flavor\': \'Attingono alla forza del loro alveare e delle loro vittime.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133434&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9f11da01-632a-4abe-98c1-2ae3089bf790\', \'multiverseId\': 133434}, \'multiverseid\': 133434}, {\'name\': \'吸血スリヴァー\', \'text\': \'すべてのスリヴァーは「このターン、このクリーチャーによってダメージを与えられたクリーチャーがいずれかの墓地に置かれるたび、このクリーチャーの上に＋１/＋１カウンターを１個置く。」の能力を持つ。\', \'type\': \'クリーチャー — スリヴァー\', \'flavor\': \'彼らは群れからも犠牲者からも力を得る。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133735&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'22fdcce7-029b-4268-b076-e5f35ba0e08d\', \'multiverseId\': 133735}, \'multiverseid\': 133735}, {\'name\': \'Fractius Vampírico\', \'text\': \'Todos os Fractius têm "Toda vez que uma criatura que tenha sofrido dano causado por esta criatura neste turno for colocada num cemitério, coloque um marcador +1/+1 sobre esta criatura."\', \'type\': \'Criatura — Fractius\', \'flavor\': \'Eles usavam a força de sua colônia e de suas vítimas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134036&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ea82ddbf-ae7d-4b29-b1ad-a391fbcbafd2\', \'multiverseId\': 134036}, \'multiverseid\': 134036}, {\'name\': \'Вампирическая Щепка\', \'text\': \'Все Щепки обладают способностью "Когда существо, которому было нанесено повреждение этим существом на этом ходу, попадает на кладбище, положите жетон +1/+1 на это существо."\', \'type\': \'Существо — Щепка\', \'flavor\': \'Они выбирают между силами своего роя и своих жертв.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134337&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b790e028-f8fa-448e-975a-00395e193cbb\', \'multiverseId\': 134337}, \'multiverseid\': 134337}, {\'name\': \'吸血裂片妖\', \'text\': \'所有裂片妖具有「每当本回合中曾受到此生物伤害的一个生物置入坟墓场时，在此生物上放置一个+1/+1指示物。」\', \'type\': \'生物～裂片妖\', \'flavor\': \'他们从母巢与自己刃下亡魂吸取力量。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132531&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6aba05cf-2846-49d9-8fce-103bec7c48a8\', \'multiverseId\': 132531}, \'multiverseid\': 132531}]', '[{\'name\': \'Vasall der Grube\', \'text\': \'Fliegend, verursacht Trampelschaden\\nOpfere zu Beginn deines Versorgungssegments eine Kreatur außer dem Vasallen der Grube. Falls du dies nicht kannst, fügt der Vasall der Grube dir 7 Schadenspunkte zu.\\nMorph {B}{B}{B}{B} (Du kannst diese Karte verdeckt für {3} als eine 2/2 Kreatur spielen. Decke sie zu einem beliebigen Zeitpunkt für ihre Morph-Kosten auf.)\', \'type\': \'Kreatur — Dämon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132988&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'82a1afb4-97a5-411b-841b-08c614e6639b\', \'multiverseId\': 132988}, \'multiverseid\': 132988}, {\'name\': \'Siervo del Abismo\', \'text\': \'Vuela, arrolla.\\nAl comienzo de tu mantenimiento, sacrifica una criatura distinta del Siervo del Abismo. Si no puedes, el Siervo del Abismo te hace 7 puntos de daño.\\nMetamorfosis {B}{B}{B}{B} (Puedes jugar esta carta boca abajo como una criatura 2/2 pagando {3}. Ponla boca arriba en cualquier momento pagando su coste de metamorfosis.)\', \'type\': \'Criatura — Demonio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134493&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'31f7fd2c-00c2-46ef-aade-b6edb4c2df98\', \'multiverseId\': 134493}, \'multiverseid\': 134493}, {\'name\': \'Lige de la fosse\', \'text\': \'Vol, piétinement\\nAu début de votre entretien, sacrifiez une créature autre que le Lige de la fosse. Si vous ne le pouvez pas, le Lige de la fosse vous inflige 7 blessures.\\nMue {B}{B}{B}{B} (Vous pouvez jouer cette carte face cachée comme une créature 2/2 pour {3}. Retournez-la quand vous le désirez pour son coût de mue.)\', \'type\': \'Créature : démon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132687&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1322b6fe-b7f5-4705-8888-9b7f07c038c0\', \'multiverseId\': 132687}, \'multiverseid\': 132687}, {\'name\': "Vassallo dell\'Abisso", \'text\': "Volare, travolgere\\nAll\'inizio del tuo mantenimento, sacrifica una creatura diversa dal Vassallo dell\'Abisso. Se non puoi farlo, il Vassallo dell\'Abisso ti infligge 7 danni.\\nMetamorfosi {B}{B}{B}{B} (Puoi giocare questa carta a faccia in giù come una creatura 2/2 pagando {3}. Girala a faccia in su in qualsiasi momento pagando il suo costo di metamorfosi.)", \'type\': \'Creatura — Demone\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133289&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cdb9bb0a-fd51-4a0b-bec5-8e6dce7a421a\', \'multiverseId\': 133289}, \'multiverseid\': 133289}, {\'name\': \'奈落のしもべ\', \'text\': \'飛行、トランプル\\nあなたのアップキープの開始時に、奈落のしもべ以外のクリーチャーを１体生け贄に捧げる。 それができない場合、奈落のしもべはあなたに７点のダメージを与える。\\n変異 {B}{B}{B}{B} （あなたはこれを、{3}を支払うことで、裏向きの２/２のクリーチャーとしてプレイしてもよい。 いつでも変異コストを支払ってそれを表向きにすることができる。）\', \'type\': \'クリーチャー — デーモン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133590&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bf963fca-6025-43ac-b2cc-c28d6281f896\', \'multiverseId\': 133590}, \'multiverseid\': 133590}, {\'name\': \'Soberano das Profundezas\', \'text\': \'Voar, atropelar\\nNo início de sua manutenção, sacrifique uma criatura que não seja Soberano das Profundezas. Se não puder, Soberano das Profundezas causará 7 pontos de dano a você.\\nMetamorfose {B}{B}{B}{B} (Você pode jogar este card com a face voltada para baixo como uma criatura 2/2 por {3}. Vire sua face para cima a qualquer momento pagando seu custo de metamorfose.)\', \'type\': \'Criatura — Demônio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133891&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'287f94ff-84f5-473b-9dd5-33e10ec11f0d\', \'multiverseId\': 133891}, \'multiverseid\': 133891}, {\'name\': \'Вассал Ямы\', \'text\': \'Полет, пробивной удар\\nВ начале вашего шага поддержки пожертвуйте существо, отличное от Вассала Ямы. Если это невозможно, Вассал Ямы наносит 7 повреждений вам.\\nОборотень {B}{B}{B}{B} (Вы можете играть эту карту лицом вниз как 2/2 существо за {3}. Переверните ее лицом вверх в любой момент за ее стоимость оборотня.)\', \'type\': \'Существо — Демон\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134192&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6c755d5a-69ad-4930-834e-3d9d65dc2bb5\', \'multiverseId\': 134192}, \'multiverseid\': 134192}, {\'name\': \'暗渊王侯\', \'text\': \'飞行，践踏\\n在你的维持开始时，牺牲一个暗渊王侯以外的生物。 若你无法如此作，则暗渊王侯对你造成7点伤害。\\n变身{B}{B}{B}{B}（你可牌面朝下地使用此牌并支付{3}，将其当成2/2生物。 可随时支付其变身费用使其翻回正面。）\', \'type\': \'生物～恶魔\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132386&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ab10d88d-7da9-4dfd-92a1-4e9a36fe2789\', \'multiverseId\': 132386}, \'multiverseid\': 132386}]', '[{\'name\': \'Vensers Remasuri\', \'type\': \'Artefaktkreatur — Remasuri\', \'flavor\': \'Venser bewunderte sein Werk und lächelte. Sein erster Prototyp hatte sich nur zu gut in den Schwarm eingefügt und war selber zum Raubtier geworden. Dieser hier, dachte er, würde zwar in den Stamm aufgenommen werden, aber immer noch seinen Befehlen gehorchen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133134&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f4d5b530-6d6e-4aa4-a6c1-e02e8413b219\', \'multiverseId\': 133134}, \'multiverseid\': 133134}, {\'name\': \'Fragmentado de Venser\', \'type\': \'Criatura artefacto — Fragmentado\', \'flavor\': \'Venser admiró su trabajo y sonrió. Su primer prototipo se había unido a la colmena muy bien, correteando con ellos y convirtiéndose en un cazador. Éste, pensó, sería aceptado en la colmena pero obedecería sus órdenes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134639&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fe9a83b6-c8e6-4d5b-ac2e-987132ef8e74\', \'multiverseId\': 134639}, \'multiverseid\': 134639}, {\'name\': \'Slivoïde de Venser\', \'type\': \'Créature-artefact : slivoïde\', \'flavor\': "Venser admira son travail et sourit. Le contact de son premier prototype avec l\'essaim avait fonctionné au-delà de ses espérances. Il chassait avec les autres slivoïdes et devenait un prédateur. Il serait accepté dans l\'essaim, mais il obéirait toujours à ses ordres.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132833&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7066d541-f21d-4a24-9b0b-fe19424020b7\', \'multiverseId\': 132833}, \'multiverseid\': 132833}, {\'name\': \'Tramutante di Venser\', \'type\': \'Creatura Artefatto — Tramutante\', \'flavor\': "Venser rimirò la sua opera e sorrise. Il suo primo prototipo si era unito alla mente collettiva fin troppo bene, mischiandosi con la covata e diventando lui stesso un predatore. Questo, pensò, sarebbe stato accolto nell\'alveare pur continuando a obbedire ai suoi ordini.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133435&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c91e6fc6-9029-40a9-b7a6-0b62d98548a6\', \'multiverseId\': 133435}, \'multiverseid\': 133435}, {\'name\': \'ヴェンセールのスリヴァー\', \'type\': \'アーティファクト・クリーチャー — スリヴァー\', \'flavor\': \'ヴェンセールは自身の細工物に見とれ、微笑んだ。 彼の最初の試作物は群れの意識に馴染み過ぎ、同族と共に生き、自らも捕食者となってしまったのだ。 こいつなら、群れに馴染みつつ、自分の命令にも従うだろう。彼はそう考えた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133736&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c3e0d74d-d28e-4cc1-8779-3387b8e314d3\', \'multiverseId\': 133736}, \'multiverseid\': 133736}, {\'name\': \'Fractius de Venser\', \'type\': \'Criatura Artefato — Fractius\', \'flavor\': \'Venser admirou sua obra e sorriu. Seu primeiro protótipo havia unido-se à mente da colônia muito bem, crescendo com a ninhada e tornando-se um predador. Este, pensou ele, seria aceito pela colônia, mas ainda obedeceria aos seus comandos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134037&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'32e083ae-009a-40d6-8646-c5ea88b79367\', \'multiverseId\': 134037}, \'multiverseid\': 134037}, {\'name\': \'Щепка Венсера\', \'type\': \'Артефактное Существо — Щепка\', \'flavor\': \'Венсер любовался на творение своих рук и улыбался. Его первый прототип присоединился к разуму роя слишком хорошо, в толпе и сам став хищником. Наверное этот будет принят в рой, но не перестанет подчиняться его воле.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134338&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ac6e77e0-7693-4443-adca-0e395785eb6d\', \'multiverseId\': 134338}, \'multiverseid\': 134338}, {\'name\': \'凡瑟的裂片妖\', \'type\': \'神器生物～裂片妖\', \'flavor\': \'凡瑟欣赏着自己的作品，满意地笑了。 他的首批原型作品早已混入母巢意识，分享同样的血脉，也顺利成为掠食者。 至于这一个，他认为将能为母巢接受，但依旧会服从自己的命令。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132532&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ef15b83d-68eb-4575-b458-f55ca8961477\', \'multiverseId\': 132532}, \'multiverseid\': 132532}]', '[{\'name\': \'Verfrühte Beerdigung\', \'text\': \'Zerstöre eine nichtschwarze Kreatur deiner Wahl, die ins Spiel gekommen ist, seitdem dein letzter Zug geendet hat.\', \'type\': \'Hexerei\', \'flavor\': \'„Diese Erde hier weiß, wie Tote schmecken. Mach ihr Appetit auf eine lebende Mahlzeit, und du hast einen tödlichen Verbündeten gewonnen." —Ezrith, Druide der Dunklen Stunden\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133045&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'498fdc16-346a-442f-8b74-6f17ed0f6f68\', \'multiverseId\': 133045}, \'multiverseid\': 133045}, {\'name\': \'Entierro prematuro\', \'text\': \'Destruye la criatura objetivo que no sea negra y que entró en juego desde que terminó tu último turno.\', \'type\': \'Conjuro\', \'flavor\': \'"Esta tierra conoce bien el sabor de la muerte. Si le fomentamos el hambre por una comida viva, puede ser un aliado mortal." —Ezrith, druida de las Horas Sombrías\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134550&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1ed4df61-a845-4ee8-a58c-1c4db887f5bd\', \'multiverseId\': 134550}, \'multiverseid\': 134550}, {\'name\': \'Enterrement prématuré\', \'text\': \'Détruisez la créature non-noire ciblée qui est arrivée en jeu depuis la fin de votre dernier tour.\', \'type\': \'Rituel\', \'flavor\': "« Cette terre connaît si bien le goût de la mort. Donnez-lui l\'appétit de ce qui est vivant, et elle devient un allié mortel. » —Ezrith, druide des Heures sombres", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132744&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9e11c4b8-d342-430a-93a9-a1e0e3d82f19\', \'multiverseId\': 132744}, \'multiverseid\': 132744}, {\'name\': \'Sepoltura Prematura\', \'text\': \'Distruggi una creatura non nera bersaglio che sia entrata in gioco dopo la fine del tuo ultimo turno.\', \'type\': \'Stregoneria\', \'flavor\': \'"Il terreno conosce bene il sapore dei morti. Fagli sentire la fame per un pasto vivo e può diventare un alleato letale." —Ezrith, druido delle Ore Buie\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133346&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'22252b3b-cb87-41bd-be81-58bc86134dff\', \'multiverseId\': 133346}, \'multiverseid\': 133346}, {\'name\': \'早すぎる埋葬\', \'text\': \'あなたの直前のターンの終了後に場に出た黒でないクリーチャー１体を対象とし、それを破壊する。\', \'type\': \'ソーサリー\', \'flavor\': \'土は死の味をよく知っている。 それに生けるものの味を教えれば、恐るべき味方となるであろう。 ――暗刻教団のドルイド僧、エズリス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133647&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c9fccac5-371c-4e4a-bae6-cf95789e8167\', \'multiverseId\': 133647}, \'multiverseid\': 133647}, {\'name\': \'Funeral Prematuro\', \'text\': \'Destrua a criatura alvo que não seja preta que entrou em jogo desde o final de seu último turno.\', \'type\': \'Feitiço\', \'flavor\': \'"O solo conhece bem o gosto dos mortos. Dê a ele o apetite por uma refeição viva, e ele pode tornar-se um aliado mortal." —Ezrith, druida das Horas Sombrias\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133948&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bdb9d8c8-45bf-4776-9a75-225d1323af90\', \'multiverseId\': 133948}, \'multiverseid\': 133948}, {\'name\': \'Ранние Похороны\', \'text\': \'Уничтожьте целевое нечерное существо, которое вошло в игру с конца вашего предыдущего хода.\', \'type\': \'Волшебство\', \'flavor\': \'«Эта почва прекрасно знает вкус смерти. Приучите ее жажде живой плоти, и она станет вашим смертельным союзником», Эзрит, друид Темных времен\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134249&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6bca5334-c425-4ac4-b74a-4e047eddac5d\', \'multiverseId\': 134249}, \'multiverseid\': 134249}, {\'name\': \'仓卒掩埋\', \'text\': \'消灭目标非黑色生物，且须为你上个回合结束后进场者。\', \'type\': \'法术\', \'flavor\': \'「这土壤熟知死者的气味。 若点醒它生食的欲望，便可成为强力盟友。」 ～黯刻德鲁伊易季司\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132443&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'68b4f27d-74f2-4258-8fb3-4ca1d1a0f5ad\', \'multiverseId\': 132443}, \'multiverseid\': 132443}]', '[{\'name\': \'Vermodern\', \'text\': \'Zerstöre ein Artefakt oder eine Verzauberung deiner Wahl mit umgewandelten Manakosten von X. Es bzw. sie kann nicht regeneriert werden. Du erhältst X Lebenspunkte dazu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Die Wälder sind untergegangen, aber der Geist von Krosa bleibt in diesen verschlingenden Sporen lebendig." —Zyd, Kamahldruide\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133008&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'37255d50-2f98-473d-8abc-e6b2cbe21619\', \'multiverseId\': 133008}, \'multiverseid\': 133008}, {\'name\': \'Enmohecer\', \'text\': \'Destruye el artefacto o encantamiento objetivo con coste de maná convertido igual a X. No puede ser regenerado. Ganas X vidas.\', \'type\': \'Instantáneo\', \'flavor\': \'"Los bosques sucumbieron a la ruina, pero el espíritu de Krosa permanece vivo y vital en estas esporas devoradoras." —Zyd, druida kamahlita\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134513&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0753516e-c7a2-4bd2-b374-371273fb0eb1\', \'multiverseId\': 134513}, \'multiverseid\': 134513}, {\'name\': \'Moisir\', \'text\': "Détruisez l\'artefact ou l\'enchantement ciblé dont le coût converti de mana est X. Il ne peut pas être régénéré. Vous gagnez X points de vie.", \'type\': \'Éphémère\', \'flavor\': "« Les forêts ont succombé à la destruction, mais l\'esprit de la Krosia reste en vie dans ces spores dévorantes. » —Zyd, druide kamahlite", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132707&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a196b0e1-ac24-414f-b6c0-a5a63702cea9\', \'multiverseId\': 132707}, \'multiverseid\': 132707}, {\'name\': \'Ammuffire\', \'text\': \'Distruggi un artefatto o un incantesimo bersaglio con costo di mana convertito pari a X. Non può essere rigenerato. Guadagni X punti vita.\', \'type\': \'Istantaneo\', \'flavor\': \'"Le foreste hanno ceduto alla rovina, ma lo spirito di Krosa resta vivo e vitale in queste spore divoratrici." —Zyd, druido di Kamahl\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133309&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'430bf401-d80b-43d2-8912-9138be2b6a30\', \'multiverseId\': 133309}, \'multiverseid\': 133309}, {\'name\': \'腐れ落ち\', \'text\': \'点数で見たマナ・コストがＸのアーティファクト１つかエンチャント１体を対象とし、それを破壊する。 それは再生できない。 あなたはＸ点のライフを得る。\', \'type\': \'インスタント\', \'flavor\': \'森は屈し廃墟となりましたが、クローサの精神は生き続け、この猛烈な胞子の生命力となっているのです。 ――カマーライトのドルイド、ジド\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133610&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'44cdde71-1b16-46d5-b497-9d5beb93997d\', \'multiverseId\': 133610}, \'multiverseid\': 133610}, {\'name\': \'Apodrecer\', \'text\': \'Destrua o artefato alvo ou o encantamento alvo com custo de mana convertido igual a X. Ela não pode ser regenerada. Você ganha X pontos de vida.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"As florestas sucumbiram à ruína, mas o espírito de Krosa permanece vivo e vibrante nesses esporos devoradores." —Zyd, druida kamahliano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133911&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fdf48a99-d00d-45cd-b0ed-003eeac17af0\', \'multiverseId\': 133911}, \'multiverseid\': 133911}, {\'name\': \'Формовка\', \'text\': \'Уничтожьте целевой артефакт или чары с конвертированной мана-стоимостью, равной X. Он не может быть регенерирован. Вы получаете X жизней.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Леса были уничтожены, но дух Кроса остался жив и здоров в этих разрушительных спорах», Зид, Друид-Камалит\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134212&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'265e4b79-07f0-4c5c-b478-4f05c98bc201\', \'multiverseId\': 134212}, \'multiverseid\': 134212}, {\'name\': \'腐朽\', \'text\': \'消灭目标总法术力费用为X的神器或结界。 它不能重生。 你获得X点生命。\', \'type\': \'瞬间\', \'flavor\': \'「树林已化为废墟，但这咨意吞噬的芽孢让克洛萨的精神依旧活灵活现。」 ～卡马尔宗德鲁伊季德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132406&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9b63e99f-95cf-44d6-9d6f-02dc718891cb\', \'multiverseId\': 132406}, \'multiverseid\': 132406}]', '[{\'name\': \'Verräter der Zwischenwelt\', \'text\': \'EileIrrealität (Diese Kreatur kann nur Kreaturen mit Irrealität blocken und nur von solchen geblockt werden.)\\nImmer wenn eine andere Kreatur aus dem Spiel auf deinen Friedhof gelegt wird, kannst du {B} bezahlen. Falls du dies tust, bringe den Verräter der Zwischenwelt aus deinem Friedhof ins Spiel zurück.\', \'type\': \'Kreatur — Geist\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133019&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ee7fa4e3-a6cf-441b-91bf-eb2da27ce799\', \'multiverseId\': 133019}, \'multiverseid\': 133019}, {\'name\': \'Traidor del submundo\', \'text\': \'Prisa.\\nSe desvanece (Esta criatura sólo puede bloquear o ser bloqueada por criaturas con la habilidad de desvanecerse.)\\nSiempre que otra criatura vaya a un cementerio desde el juego, puedes pagar {B}. Si lo haces, regresa el Traidor del submundo de tu cementerio al juego.\', \'type\': \'Criatura — Espíritu\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134524&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d1ef0b47-5004-4e94-b20b-231accbddaba\', \'multiverseId\': 134524}, \'multiverseid\': 134524}, {\'name\': \'Traître infernal\', \'text\': "Célérité\\nDistorsion (Cette créature ne peut bloquer ou être bloquée que par des créatures avec la distorsion.)\\nÀ chaque fois qu\'une autre créature est mise dans votre cimetière depuis le jeu, vous pouvez payer {B}. Si vous faites ainsi, renvoyez en jeu le Traître infernal depuis votre cimetière.", \'type\': \'Créature : esprit\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132718&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9c2d233c-231b-4f73-bc55-0cc81eccec32\', \'multiverseId\': 132718}, \'multiverseid\': 132718}, {\'name\': \'Traditore Abissale\', \'text\': "Rapidità\\nOmbra (Questa creatura può bloccare o essere bloccata soltanto da creature con ombra.)\\nOgniqualvolta un\'altra creatura viene messa nel tuo cimitero dal gioco, puoi pagare {B}. Se lo fai, rimetti in gioco il Traditore Abissale dal tuo cimitero.", \'type\': \'Creatura — Spirito\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133320&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'68624aed-0291-4f69-9d86-b093f2074f85\', \'multiverseId\': 133320}, \'multiverseid\': 133320}, {\'name\': \'冥界の裏切り者\', \'text\': \'速攻\\nシャドー （このクリーチャーは、シャドーを持つクリーチャーのみをブロックでき、ブロックされる。）\\n他のクリーチャーが場からあなたの墓地に置かれるたび、あなたは{B}を支払ってもよい。 そうした場合、あなたの墓地にある冥界の裏切り者を場に戻す。\', \'type\': \'クリーチャー — スピリット\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133621&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8a09cda5-5403-4602-91a9-eb6eae11cd2e\', \'multiverseId\': 133621}, \'multiverseid\': 133621}, {\'name\': \'Traidor Ínfero\', \'text\': \'Ímpeto\\nSombra (Esta criatura só pode bloquear ou ser bloqueada por criaturas com sombra.)\\nToda vez que outra criatura for colocada em seu cemitério vinda do jogo, você poderá pagar {B}. Se fizer isso, devolva Traidor Ínfero de seu cemitério ao jogo.\', \'type\': \'Criatura — Espírito\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133922&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5554e92e-32ee-4da0-847b-157a30e5bb7e\', \'multiverseId\': 133922}, \'multiverseid\': 133922}, {\'name\': \'Адский Предатель\', \'text\': \'Ускорение\\nТень (Это существо может блокировать и быть заблокировано только существ(ами) с тенью.)\\nКогда другое существо попадает на ваше кладбище из игры, вы можете заплатить {B}. Если вы это сделали, верните Адского Предателя из вашего кладбища в игру.\', \'type\': \'Существо — Дух\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134223&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'63a5b6d4-595e-4db7-8fdf-12be146b97f4\', \'multiverseId\': 134223}, \'multiverseid\': 134223}, {\'name\': \'阴间叛徒\', \'text\': \'敏捷\\n次元幽影（此生物只能阻挡具次元幽影异能的生物，亦只能被具此异能的生物阻挡。）\\n每当另一个生物从场上置入你的坟墓场时，你可以支付{B}。 若你如此作，则将阴间叛徒从你的坟墓场返回场上。\', \'type\': \'生物～精怪\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132417&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d75ed2ef-d41e-4de4-9a74-c05854bdf693\', \'multiverseId\': 132417}, \'multiverseid\': 132417}]', '[{\'name\': \'Vesuva\', \'text\': \'Sowie Vesuva ins Spiel kommt, kannst du ein Land im Spiel bestimmen. Falls du das tust, kommt Vesuva getappt als eine Kopie des bestimmten Lands ins Spiel.\', \'type\': \'Land\', \'flavor\': \'Es ist überall, wo du jemals schon gewesen bist.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133136&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ec448529-e715-492a-ba1d-ae622f4385cd\', \'multiverseId\': 133136}, \'multiverseid\': 133136}, {\'name\': \'Vesuva\', \'text\': \'En cuanto Vesuva entre en juego, puedes elegir una tierra en juego. Si lo haces, Vesuva entra en juego girada como una copia de la tierra elegida.\', \'type\': \'Tierra\', \'flavor\': \'Es todos los lugares que has visitado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134641&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8161e19c-6803-4e24-a207-986ead12ac75\', \'multiverseId\': 134641}, \'multiverseid\': 134641}, {\'name\': \'Vésuva\', \'text\': \'Au moment où le Vésuva arrive en jeu, vous pouvez choisir un terrain en jeu. Si vous faites ainsi, le Vésuva arrive en jeu engagé comme une copie du terrain choisi.\', \'type\': \'Terrain\', \'flavor\': "C\'est partout où vous avez été.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132835&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fcee76c4-9457-44e7-a347-c902111944ab\', \'multiverseId\': 132835}, \'multiverseid\': 132835}, {\'name\': \'Vesuva\', \'text\': \'Mentre Vesuva entra in gioco, puoi scegliere una terra in gioco. Se lo fai, Vesuva entra in gioco TAPpata come copia della terra scelta.\', \'type\': \'Terra\', \'flavor\': \'È ovunque tu sia mai stato.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133437&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'594ec722-342e-4263-8ea4-13ae37542cf1\', \'multiverseId\': 133437}, \'multiverseid\': 133437}, {\'name\': \'ヴェズーヴァ\', \'text\': \'ヴェズーヴァが場に出るに際し、あなたは場に出ている土地１つを選んでもよい。 そうした場合、ヴェズーヴァは選んだ土地のコピーとして、タップ状態で場に出る。\', \'type\': \'土地\', \'flavor\': \'君がいたあらゆる場所。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133738&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'615570cf-bd9f-4aa5-8ca8-38486f615834\', \'multiverseId\': 133738}, \'multiverseid\': 133738}, {\'name\': \'Vesuva\', \'text\': \'Conforme Vesuva entra em jogo, você pode escolher um terreno em jogo. Se fizer isso, Vesuva entrará em jogo virado como uma cópia do terreno escolhido.\', \'type\': \'Terreno\', \'flavor\': \'Onde você reencontra todos os lugares onde já esteve.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134039&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3d29a450-9f1d-4ce7-92d3-b094e5e3bfb4\', \'multiverseId\': 134039}, \'multiverseid\': 134039}, {\'name\': \'Везува\', \'text\': \'При входе Везувы в игру вы можете выбрать землю в игре. Если вы сделали это, Везува входит в игру повернутой как копия выбранной земли.\', \'type\': \'Земля\', \'flavor\': \'Она это все, где ты когда-либо побывал.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134340&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fe7e1338-e929-42e4-83b5-32587be2caa8\', \'multiverseId\': 134340}, \'multiverseid\': 134340}, {\'name\': \'维苏瓦\', \'text\': \'于维苏瓦进场时，你可以选择场上的一个地。 如果你如此作，则维苏瓦需横置进场，且为该地的复制。\', \'type\': \'地\', \'flavor\': \'它是你曾到过的所有地方。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132534&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f660f524-d396-4707-8433-627e6906454c\', \'multiverseId\': 132534}, \'multiverseid\': 132534}]', '[{\'name\': \'Vesuvischer Gestaltwandler\', \'text\': \'Sowie der Vesuvische Gestaltwandler ins Spiel kommt oder aufgedeckt wird, kannst du eine andere Kreatur im Spiel bestimmen. Falls du dies tust, wird der Vesuvische Gestaltwandler zu einer Kopie dieser Kreatur und erhält „Zu Beginn dieses Versorgungsegments kannst du diese Kreatur verdecken", bis er verdeckt wird.\\nMorph {1}{U}\', \'type\': \'Kreatur — Gestaltwandler\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133137&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'72782df2-2906-4b65-bd5c-59c206d63070\', \'multiverseId\': 133137}, \'multiverseid\': 133137}, {\'name\': \'Metamorfo vesuvano\', \'text\': \'En cuanto el Metamorfo vesuvano entre en juego o se ponga boca arriba, puedes elegir otra criatura en juego. Si lo haces, hasta que el Metamorfo vesuvano se ponga boca abajo, es una copia de esa criatura y gana "Al comienzo de tu mantenimiento, puedes poner esta criatura boca abajo".\\nMetamorfosis {1}{U}.\', \'type\': \'Criatura — Metamorfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134642&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bf38f7a3-92ef-4650-a90c-5d1aba837605\', \'multiverseId\': 134642}, \'multiverseid\': 134642}, {\'name\': \'Changeforme vésuvéen\', \'text\': "Au moment où le Changeforme vésuvéen arrive en jeu ou qu\'il est retourné face visible, vous pouvez choisir une autre créature en jeu. Si vous faites ainsi, jusqu\'à ce qu\'il soit retourné face cachée, le Changeforme vésuvéen devient une copie de cette créature et il acquiert « Au début de votre entretien, vous pouvez retourner cette créature face cachée. »\\nMue {1}{U}", \'type\': \'Créature : changeforme\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132836&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'398aa331-bf5f-42c3-90bc-17e73238da5a\', \'multiverseId\': 132836}, \'multiverseid\': 132836}, {\'name\': \'Polimorfo di Vesuva\', \'text\': \'Mentre il Polimorfo di Vesuva entra in gioco o viene girato a faccia in su, puoi scegliere un\\\'altra creatura in gioco. Se lo fai, finché il Polimorfo di Vesuva non viene girato a faccia in giù, diventa una copia di quella creatura e ha "All\\\'inizio del tuo mantenimento, puoi girare questa creatura a faccia in giù."\\nMetamorfosi {1}{U}\', \'type\': \'Creatura — Polimorfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133438&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'756cc051-13ea-4d66-bb6d-5f86d501834b\', \'multiverseId\': 133438}, \'multiverseid\': 133438}, {\'name\': \'ヴェズーヴァの多相の戦士\', \'text\': \'ヴェズーヴァの多相の戦士が場に出るか表向きになる際に、あなたは場に出ている他のクリーチャー１体を選んでもよい。 そうした場合、ヴェズーヴァの多相の戦士が裏向きになるまで、ヴェズーヴァの多相の戦士はそのクリーチャーのコピーとなり、「あなたのアップキープの開始時に、あなたはこのクリーチャーを裏向きにしてもよい。」の能力を得る。\\n変異 {1}{U}\', \'type\': \'クリーチャー — 多相の戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133739&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2c6d3af3-7b8f-4ac7-a6bc-f3bbd97f26f7\', \'multiverseId\': 133739}, \'multiverseid\': 133739}, {\'name\': \'Metamorfo Vesuviano\', \'text\': \'Conforme Metamorfo Vesuviano entra em jogo ou é virado para cima, você pode escolher outra criatura em jogo. Se fizer isso, até que Metamorfo Vesuviano seja virado para baixo, ele se torna uma cópia daquela criatura e ganha "No início de sua manutenção, você pode virar esta criatura para baixo."\\nMetamorfose {1}{U}\', \'type\': \'Criatura — Metamorfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134040&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c2c7f5bf-545c-462b-9a7e-993ba4ada32f\', \'multiverseId\': 134040}, \'multiverseid\': 134040}, {\'name\': \'Везуванский Оборотень\', \'text\': \'При входе Весуванского Оборотня в игру или при его повороте лицом вверх вы можете выбрать другое существо в игре. Если вы делаете это, до тех пор, пока Весуванский Оборотень не повернут лицом вниз, он становится копией этого существа и получает способность: "В начале вашего шага поддержки вы можете повернуть это существо лицом вниз."\\nOборотень {1}{U}\', \'type\': \'Существо — Оборотень\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134341&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'40a24287-a50d-4ffa-8f15-499843f096fb\', \'multiverseId\': 134341}, \'multiverseid\': 134341}, {\'name\': \'维苏瓦变形兽\', \'text\': \'于维苏瓦变形兽进场或翻回正面时，你可以选择场上的另一个生物。 若你如此作，则直到维苏瓦变形兽翻为牌面朝下为止，它成为该生物的复制，且获得「在你的维持开始时，你可以将此生物翻为牌面朝下。」\\n变身{1}{U}\', \'type\': \'生物～变形兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132535&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'29ef837e-bc86-438a-9489-6dd1b89cc784\', \'multiverseId\': 132535}, \'multiverseid\': 132535}]', '[{\'name\': \'Viashino-Klingentester\', \'text\': \'Aufblitzen (Du kannst diesen Zauberspruch zu jedem Zeitpunkt spielen, zu dem du einen Spontanzauber spielen könntest.)\\nWenn der Viashino-Klingentester ins Spiel kommt, erhält eine Kreatur deiner Wahl Erstschlag bis zum Ende des Zuges.\', \'type\': \'Kreatur — Viashino, Späher\', \'flavor\': \'„Bringe in einem Moment der Verzweiflung den Mut auf, und du kannst den Lauf der Geschichte ändern. So spricht der Bey."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133138&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'93430cff-0680-4fc4-9f3f-5d208216fdea\', \'multiverseId\': 133138}, \'multiverseid\': 133138}, {\'name\': \'Viashino explorador con cuchillas\', \'text\': \'Destello (Puedes jugar este hechizo en cualquier momento en que pudieras jugar un instantáneo.)\\nCuando el Viashino explorador con cuchillas entre en juego, la criatura objetivo gana la habilidad de dañar primero hasta el final del turno.\', \'type\': \'Criatura — Explorador viashino\', \'flavor\': \'"Sólo se necesita uno, que encuentre el valor en un momento desesperado, para cambiar el sentido de la historia. Así habla el bey."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134643&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'53c8e86e-37e1-4d93-a7b0-02e91c81f2a7\', \'multiverseId\': 134643}, \'multiverseid\': 134643}, {\'name\': \'Éclaireur aux lames viashino\', \'text\': "Flash (Vous pouvez jouer ce sort à tout moment où vous pourriez jouer un éphémère.)\\nQuand l\'Éclaireur aux lames viashino arrive en jeu, la créature ciblée acquiert l\'initiative jusqu\'à la fin du tour.", \'type\': \'Créature : viashino et éclaireur\', \'flavor\': "« Arme-toi de courage dans un moment désespéré, et tu feras changer le cours de l\'histoire. Le bey le dit. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132837&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'338e035e-5176-4289-91dc-6a13e18be7d0\', \'multiverseId\': 132837}, \'multiverseid\': 132837}, {\'name\': \'Esploralama Viashino\', \'text\': "Lampo (Puoi giocare questa magia in ogni momento in cui potresti giocare un istantaneo.)\\nQuando l\'Esploralama Viashino entra in gioco, una creatura bersaglio ha attacco improvviso fino alla fine del turno.", \'type\': \'Creatura — Esploratore Viashino\', \'flavor\': \'"Trova il coraggio in un momento disperato e cambierai il corso della storia. Così disse il bey."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133439&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0069c38e-290a-4602-aa10-0fb188a4afe3\', \'multiverseId\': 133439}, \'multiverseid\': 133439}, {\'name\': \'ヴィーアシーノの探り刃\', \'text\': \'瞬速 （あなたはこの呪文を、あなたがインスタントをプレイできるときならいつでもプレイしてよい。）\\nヴィーアシーノの探り刃が場に出たとき、クリーチャー１体を対象とする。それはターン終了時まで先制攻撃を得る。\', \'type\': \'クリーチャー — ヴィーアシーノ・スカウト\', \'flavor\': \'死に物狂いの時の中に勇気を見つけよ。さすれば歴史の流れは変えられよう。 そう長はおっしゃっている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133740&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'22554bb6-11ca-4f0e-ab07-dbbf8da473fc\', \'multiverseId\': 133740}, \'multiverseid\': 133740}, {\'name\': \'Laminobatedor Viashino\', \'text\': \'Lampejo (Você poderá jogar esta mágica a qualquer momento em que puder jogar uma mágica instantânea.)\\nQuando Laminobatedor Viashino entra em jogo, a criatura alvo ganha iniciativa até o final do turno.\', \'type\': \'Criatura — Batedor Viashino\', \'flavor\': \'"Encontre sua coragem em um momento de desespero e você mudará o rumo da história. Assim disse o bei."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134041&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7668031b-b108-421e-a172-2021170731b9\', \'multiverseId\': 134041}, \'multiverseid\': 134041}, {\'name\': \'Разведчик Виашино\', \'text\': \'Миг (Вы можете играть это заклинание в любое время когда вы можете играть мгновенные заклинания.)\\nКогда Разведчик Виашино входит в игру, целевое существо получает первый удар до конца хода.\', \'type\': \'Существо — Виашино Разведчик\', \'flavor\': \'«Найди в себе смелость в тяжелый миг, и ты развернешь бег истории. Да будет так»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134342&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'64013f64-8000-4f39-8ea3-b8ca6ea80840\', \'multiverseId\': 134342}, \'multiverseid\': 134342}, {\'name\': \'凡尔西诺负刃斥候\', \'text\': \'闪现（你可以于你能够使用瞬间的时机下使用此咒语。）\\n当凡尔西诺负刃斥候进场时，目标生物获得先攻异能直到回合结束。\', \'type\': \'生物～凡尔西诺／斥候\', \'flavor\': \'「在危急时刻拿出勇气，你就能改写历史。 先生是这么说的。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132536&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c817a28f-74c2-44e7-acfc-664ba70ce43f\', \'multiverseId\': 132536}, \'multiverseid\': 132536}]', '[{\'name\': \'Visceriden-Tiefkrabbler\', \'text\': \'{U}: Der Visceriden-Tiefkrabbler erhält +1/+0 bis zum Ende des Zuges.\\nAussetzen 4 {U} (Statt diese Karte aus deiner Hand zu spielen, kannst du {U} bezahlen, sie ganz aus dem Spiel entfernen und vier Zeitmarken auf sie legen. Entferne zu Beginn deines Versorgungssegments eine Zeitmarke von ihr. Wenn du die letzte Zeitmarke entfernst, spiele die Karte, ohne ihre Manakosten zu bezahlen. Sie hat Eile.)\', \'type\': \'Kreatur — Homarid, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133139&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a1d0b59d-a43e-4a22-ba3a-dbbd9c71ca8c\', \'multiverseId\': 133139}, \'multiverseid\': 133139}, {\'name\': \'Caminante profundo viscérido\', \'text\': \'{U}: El Caminante profundo viscérido obtiene +1/+0 hasta el final del turno.\\nSuspender 4—{U} (En lugar de jugar esta carta de tu mano, puedes pagar {U} y removerla del juego con cuatro contadores de tiempo sobre ella. Al comienzo de tu mantenimiento, remueve un contador de tiempo. Cuando remuevas el último, juégala sin pagar su coste de maná. Tiene la habilidad de prisa.)\', \'type\': \'Criatura — Guerrero homárido\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134644&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e51f1b22-fed1-46a9-bf62-544a4bc417ae\', \'multiverseId\': 134644}, \'multiverseid\': 134644}, {\'name\': \'Marcheur des profondeurs viscéride\', \'text\': "{U} : Le Marcheur des profondeurs viscéride gagne +1/+0 jusqu\'à la fin du tour.\\nSuspension 4 — {U} (Plutôt que jouer cette carte depuis votre main, vous pouvez payer {U} et la retirer de la partie avec quatre marqueurs « temps » sur elle. Au début de votre entretien, retirez un marqueur « temps ». Quand vous retirez le dernier, jouez cette carte sans payer son coût de mana. Elle a la célérité.)", \'type\': \'Créature : homaride et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132838&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'006d78e5-c4e1-4c5b-a1b0-bc875f2216ad\', \'multiverseId\': 132838}, \'multiverseid\': 132838}, {\'name\': \'Camminatore delle Profondità Visceride\', \'text\': "{U}: Il Camminatore delle Profondità Visceride prende +1/+0 fino alla fine del turno.\\nSospendere 4—{U} (Invece di giocare questa carta dalla tua mano, puoi pagare {U} e rimuoverla dal gioco con quattro segnalini tempo su di essa. All\'inizio del tuo mantenimento, rimuovi un segnalino tempo. Quando rimuovi l\'ultimo, gioca la carta senza pagare il suo costo di mana. Ha rapidità.)", \'type\': \'Creatura — Guerriero Homarid\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133440&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f9da0d92-11aa-45b6-8ffb-dc3e3446fd9c\', \'multiverseId\': 133440}, \'multiverseid\': 133440}, {\'name\': \'ヴィセリッドの深み歩き\', \'text\': \'{U}：ヴィセリッドの深み歩きはターン終了時まで＋１/＋０の修整を受ける。\\n待機 ４―{U} （これをあなたの手札からプレイするのではなく、{U}を支払ってゲームから取り除き、その上に時間カウンターを４個置いてもよい。 あなたのアップキープの開始時に、時間カウンターを１個取り除く。 最後の１個を取り除いたとき、あなたはそれをマナ・コストを支払わずにプレイする。 それは速攻を持つ。）\', \'type\': \'クリーチャー — ホマリッド・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133741&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e3b2cc2d-6b04-46a0-b43d-d19e340d9e6a\', \'multiverseId\': 133741}, \'multiverseid\': 133741}, {\'name\': \'Passo-Fundo Viscérida\', \'text\': \'{U}: Passo-Fundo Viscérida recebe +1/+0 até o final do turno.\\nSuspender 4—{U} (Em vez de jogar este card da sua mão, você pode pagar {U} e removê-lo do jogo com quatro marcadores temporais sobre ele. No início de sua manutenção, remova um marcador temporal. Quando remover o último, jogue-o sem pagar seu custo de mana. Ele tem ímpeto.)\', \'type\': \'Criatura — Guerreiro Homárida\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134042&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d4d71143-c038-43c9-8aec-2fdaa58327a9\', \'multiverseId\': 134042}, \'multiverseid\': 134042}, {\'name\': \'Глубоководный Висерид\', \'text\': \'{U}: Глубоководный Висерид получает +1/+0 до конца хода.\\nОтсрочка 4—{U} (Вместо того чтобы сыграть эту карту из вашей руки, вы можете заплатить {U} и удалить ее из игры с четырьмя временными жетонами на ней. В начале вашего шага поддержки удалите один временной жетон. После удаления последнего жетона сыграйте эту карту без оплаты ее мана-стоимости. Она получает ускорение.)\', \'type\': \'Существо — Хомарид Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134343&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a4be9476-d700-4fff-9867-400fd4463ebf\', \'multiverseId\': 134343}, \'multiverseid\': 134343}, {\'name\': \'维塞里深潜兵\', \'text\': \'{U}：维塞里深潜兵得+1/+0直到回合结束。\\n延缓4～{U}（除了从你手上使用此牌，你可以支付{U}并将此牌移出对战，且上面有四个计时指示物。 在你的维持开始时，从其上移去一个计时指示物。 当你移去最后一个时，则使用它且不需支付其法术力费用。 它具有敏捷。）\', \'type\': \'生物～荷马利／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132537&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'57045c44-1173-4312-82ea-f5a6e8f17116\', \'multiverseId\': 132537}, \'multiverseid\': 132537}]', '[{\'name\': \'Vision der Ahnen\', \'text\': \'Die Vision der Ahnen ist blau.\\nAussetzen 4 {U} (Statt diese Karte aus deiner Hand zu spielen, bezahle {U}, entferne sie ganz aus dem Spiel und lege vier Zeitmarken auf sie. Entferne zu Beginn deines Versorgungssegments eine Zeitmarke von ihr. Wenn du die letzte Zeitmarke entfernst, spiele die Karte, ohne ihre Manakosten zu bezahlen.)\\nEin Spieler deiner Wahl zieht drei Karten.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132859&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fd02464d-4953-49f1-a360-b5ea22c07530\', \'multiverseId\': 132859}, \'multiverseid\': 132859}, {\'name\': \'Visión ancestral\', \'text\': \'Visión ancestral es azul.\\nSuspender 4—{U} (En lugar de jugar esta carta de tu mano, paga {U} y remuévela del juego con cuatro contadores de tiempo sobre ella. Al comienzo de tu mantenimiento, remueve un contador de tiempo. Cuando remuevas el último, juégala sin pagar su coste de maná.)\\nEl jugador objetivo roba tres cartas.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134364&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ab88604a-9f33-469d-ab2f-a8cef853ce35\', \'multiverseId\': 134364}, \'multiverseid\': 134364}, {\'name\': \'Vision ancestrale\', \'text\': \'La Vision ancestrale est bleue.\\nSuspension 4 — {U} (Plutôt que jouer cette carte depuis votre main, payez {U} et retirez-la de la partie avec quatre marqueurs « temps » sur elle. Au début de votre entretien, retirez un marqueur « temps ». Quand vous retirez le dernier, jouez cette carte sans payer son coût de mana.)\\nLe joueur ciblé pioche trois cartes.\', \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132558&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'09e31208-0fd6-4a6d-823f-113e735f17b1\', \'multiverseId\': 132558}, \'multiverseid\': 132558}, {\'name\': \'Visione Ancestrale\', \'text\': "Visione Ancestrale è blu.\\nSospendere 4—{U} (Invece di giocare questa carta dalla tua mano, paga {U} e rimuovila dal gioco con quattro segnalini tempo su di essa. All\'inizio del tuo mantenimento, rimuovi un segnalino tempo. Quando rimuovi l\'ultimo, gioca la carta senza pagare il suo costo di mana.)\\nUn giocatore bersaglio pesca tre carte.", \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133160&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a1ad4f43-67e4-4ba1-85cd-4d81c723e5be\', \'multiverseId\': 133160}, \'multiverseid\': 133160}, {\'name\': \'祖先の幻視\', \'text\': \'祖先の幻視は青である。\\n待機 ４―{U} （これをあなたの手札からプレイするのではなく、{U}を支払ってゲームから取り除き、その上に時間カウンターを４個置く。 あなたのアップキープの開始時に、時間カウンターを１個取り除く。 最後の１個を取り除いたとき、あなたはそれをマナ・コストを支払わずにプレイする。）\\nプレイヤー１人を対象とする。そのプレイヤーはカードを３枚引く。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133461&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'161d9f6a-16f7-4b0b-8322-62e297cf9d49\', \'multiverseId\': 133461}, \'multiverseid\': 133461}, {\'name\': \'Visão Ancestral\', \'text\': \'Visão Ancestral é azul.\\nSuspender 4—{U} (Em vez de jogar este card da sua mão, pague {U} e remova-o do jogo com quatro marcadores temporais sobre ele. No início de sua manutenção, remova um marcador temporal. Quando remover o último, jogue-o sem pagar seu custo de mana.)\\nO jogador alvo compra três cards.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133762&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bac32c5a-9828-4225-8d77-e12a24c66b8f\', \'multiverseId\': 133762}, \'multiverseid\': 133762}, {\'name\': \'Родовое Видение\', \'text\': \'Родовое Видение является синим.\\nОтсрочка 4—{U} (Вместо того чтобы сыграть эту карту из вашей руки, заплатите {U} и удалите ее из игры с четырьмя временными жетонами на ней. В начале вашего шага поддержки удалите один временной жетон. Когда вы удалите последний, сыграйте эту карту без оплаты ее мана-стоимости.)\\nЦелевой игрок берет три карты.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134063&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e9100883-b8eb-43ad-86ba-596e9fc043a5\', \'multiverseId\': 134063}, \'multiverseid\': 134063}, {\'name\': \'先人的预视\', \'text\': \'先人的预视是蓝色。\\n延缓4～{U}（除了从你手上使用此牌，你能支付{U}并将此牌移出对战，且上面有四个计时指示物。 在你的维持开始时，从其上移去一个计时指示物。 当你移去最后一个时，则使用它且不需支付其法术力费用。）\\n目标牌手抓三张牌。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132257&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'53565bdf-9d99-46c6-a828-530262faf258\', \'multiverseId\': 132257}, \'multiverseid\': 132257}]', '[{\'name\': \'Vorreiter en-Kor\', \'text\': \'Flankenangriff (Immer wenn eine Kreatur ohne Flankenangriff diese Kreatur blockt, erhält die blockende Kreatur -1/-1 bis zum Ende des Zuges.)\\n{0}: Der nächste 1 Schadenspunkt, der dem Vorreiter en-Kor in diesem Zug zugefügt würde, wird stattdessen einer Kreatur deiner Wahl, die du kontrollierst, zugefügt.\', \'type\': \'Kreatur — Kor, Rebell, Ritter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133026&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6fca35d7-4778-4fee-b562-d4af2f8430d6\', \'multiverseId\': 133026}, \'multiverseid\': 133026}, {\'name\': \'Batidor en-Kor\', \'text\': \'Flanquea (Siempre que una criatura sin la habilidad de flanquear bloquee a esta criatura, la criatura bloqueadora obtiene -1/-1 hasta el final del turno.)\\n{0}: El siguiente punto de daño que se le fuera a hacer al Batidor en-Kor este turno, en vez de eso, se le hace a la criatura objetivo que controlas.\', \'type\': \'Criatura — Caballero rebelde kor\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134531&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1b8ffe21-cb25-4d98-8566-e250805d902d\', \'multiverseId\': 134531}, \'multiverseid\': 134531}, {\'name\': \'Cavalier en-Kor\', \'text\': "Débordement (À chaque fois qu\'une créature sans le débordement bloque cette créature, la créature bloqueuse gagne -1/-1 jusqu\'à la fin du tour.)\\n{0} : La prochaine 1 blessure qui devrait être infligée au Cavalier en-Kor ce tour-ci est infligée à une créature ciblée que vous contrôlez à la place.", \'type\': \'Créature : kor et rebelle et chevalier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132725&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f8ccb718-3da3-4147-a6dd-c237373c43e2\', \'multiverseId\': 132725}, \'multiverseid\': 132725}, {\'name\': \'Apripista en-Kor\', \'text\': "Aggirare (Ogniqualvolta una creatura senza aggirare blocca questa creatura, la creatura bloccante prende -1/-1 fino alla fine del turno.)\\n{0}: Il prossimo punto danno che verrebbe inflitto all\'Apripista en-Kor in questo turno viene invece inflitto a una creatura bersaglio che controlli.", \'type\': \'Creatura — Cavaliere Ribelle Kor\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133327&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'385084c1-140f-476e-b9f4-fa21f14fd402\', \'multiverseId\': 133327}, \'multiverseid\': 133327}, {\'name\': \'コーの先導\', \'text\': \'側面攻撃 （側面攻撃を持たないいずれかのクリーチャーがこのクリーチャーをブロックするたび、そのブロックしているクリーチャーはターン終了時まで－１/－１の修整を受ける。）\\n{0}：あなたがコントロールするクリーチャー１体を対象とする。このターン、次にコーの先導に与えられるダメージ１点は、代わりにそれに与えられる。\', \'type\': \'クリーチャー — コー・レベル・騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133628&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'62a7054f-88d2-43ec-ba20-463358fce5aa\', \'multiverseId\': 133628}, \'multiverseid\': 133628}, {\'name\': \'Vanguardeiro en-Kor\', \'text\': \'Flanquear (Toda vez que uma criatura sem flanquear bloquear esta criatura, a criatura bloqueadora receberá -1/-1 até o final do turno.)\\n{0}: O próximo 1 ponto de dano que seria causado a Vanguardeiro en-Kor neste turno, em vez disso, será causado à criatura alvo que você controla.\', \'type\': \'Criatura — Cavaleiro Rebelde Kor\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133929&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a2f7b4cf-d892-4e40-b5c7-aaebe37c270c\', \'multiverseId\': 133929}, \'multiverseid\': 133929}, {\'name\': \'Вестник эн-Кор\', \'text\': \'Обход (Когда существо без обхода блокирует это существо, тогда это блокирующее существо получает -1/-1 до конца хода.)\\n{0}: Следующее 1 повреждение, которое должно быть нанесено Вестнику эн-Кор в этот ход, наносится вместо этого целевому существу под вашим контролем.\', \'type\': \'Существо — Кориец Повстанец Рыцарь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134230&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'20e769d8-2e42-4160-b56e-1efe35434cdf\', \'multiverseId\': 134230}, \'multiverseid\': 134230}, {\'name\': \'寇族前导兵\', \'text\': \'侧面攻击（每当一个不具侧面攻击之生物阻挡此生物时，该阻挡生物得-1/-1直到回合结束。）\\n{0}：于本回合中，寇族前导兵将受到的下1点伤害改为对目标由你操控的生物造成之。\', \'type\': \'生物～寇族／反抗军／骑士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132424&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bceba2e9-0077-4538-962c-35465b8d514b\', \'multiverseId\': 132424}, \'multiverseid\': 132424}]', '[{\'name\': \'Vulkanerwachen\', \'text\': \'Zerstöre ein Land deiner Wahl.\\nSturm (Wenn du diesen Zauberspruch spielst, kopiere ihn einmal für jeden Zauberspruch, der in diesem Zug bereits gespielt wurde. Du kannst neue Ziele für die Kopien bestimmen.)\', \'type\': \'Hexerei\', \'flavor\': \'Unter lautem Krach öffnete sich das Land wie der Mund eines Titans mit Zähnen aus geschwärztem Fels und einer herumrollenden Zunge aus Magma.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133142&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c3167471-a3ee-43d0-bbdc-0221213db1ad\', \'multiverseId\': 133142}, \'multiverseid\': 133142}, {\'name\': \'Despertar volcánico\', \'text\': \'Destruye la tierra objetivo.\\nTormenta (Cuando juegues este hechizo, cópialo por cada hechizo jugado antes que él en este turno. Puedes elegir nuevos objetivos para las copias.)\', \'type\': \'Conjuro\', \'flavor\': \'Con un gran rugido, la tierra se abrió como el bostezo de un titán, con dientes de roca ennegrecida y una lengua de magma.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134647&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'00b9ce1b-528c-4f5a-b113-9a29f9765df2\', \'multiverseId\': 134647}, \'multiverseid\': 134647}, {\'name\': \'Éveil volcanique\', \'text\': \'Détruisez le terrain ciblé.\\nDéluge (Quand vous jouez ce sort, copiez-le pour chaque sort joué avant lui ce tour-ci. Vous pouvez choisir de nouvelles cibles pour ces copies.)\', \'type\': \'Rituel\', \'flavor\': "La terre s\'ouvrit dans un grondement sourd, tel le bâillement d\'un titan, avec des dents de roche noircie et une langue dégoulinante de magma.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132841&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5e21af9d-c6d8-435e-a9d2-74a45b80bf44\', \'multiverseId\': 132841}, \'multiverseid\': 132841}, {\'name\': \'Risveglio Vulcanico\', \'text\': \'Distruggi una terra bersaglio.\\nTempesta (Quando giochi questa magia, copiala per ogni magia giocata prima in questo turno. Puoi scegliere nuovi bersagli per le copie.)\', \'type\': \'Stregoneria\', \'flavor\': \'Con un rombo assordante, la terrà si aprì come lo sbadiglio di un titano, mostrando denti di roccia annerita e una sinuosa lingua di magma.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133443&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'453b9be8-05ee-4115-892a-c6f4fe3a8463\', \'multiverseId\': 133443}, \'multiverseid\': 133443}, {\'name\': \'火山の目覚め\', \'text\': \'土地１つを対象とし、それを破壊する。\\nストーム （あなたがこの呪文をプレイしたとき、それを、このターンそれより前にプレイされていた呪文の総数に等しい回数だけコピーする。 あなたはそのコピーの新しい対象を選んでもよい。）\', \'type\': \'ソーサリー\', \'flavor\': \'巨大な唸りを上げると、大地は巨人の欠伸のように口を開けた。歯は黒ずんだ岩で、溶岩は舐め回す舌だった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133744&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e3c014d3-181d-449d-bcbb-b2a533c4072a\', \'multiverseId\': 133744}, \'multiverseid\': 133744}, {\'name\': \'Despertar Vulcânico\', \'text\': \'Destrua o terreno alvo.\\nRajada (Quando você jogar esta mágica, faça uma cópia dela para cada mágica jogada antes dela neste turno. Você pode escolher novos alvos para a cópia.)\', \'type\': \'Feitiço\', \'flavor\': \'Com um grande rugido, a terra abriu-se como o bocejo de um titã, com dentes de rocha negra e uma extensa língua de magma.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134045&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c258b2f6-7455-4984-bf2e-1666e968873a\', \'multiverseId\': 134045}, \'multiverseid\': 134045}, {\'name\': \'Пробуждение Вулкана\', \'text\': \'Уничтожьте целевую землю.\\nШторм (Когда вы играете это заклинание, скопируйте его за каждое сыгранное в этом ходу заклинание. Вы можете выбрать новые цели для этих копий.)\', \'type\': \'Волшебство\', \'flavor\': \'С величайшим грохотом земля разверзлась, как будто зевнул титан с зубами почерневших камней и висящим языком магмы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134346&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'067484e5-0a95-46ab-a223-454fd5a8e76c\', \'multiverseId\': 134346}, \'multiverseid\': 134346}, {\'name\': \'唤醒火山\', \'text\': \'消灭目标地。\\n风暴（当你使用此咒语时，本回合于它之前每使用过一个咒语，便将此咒语复制一次。） 你可以为每个复制品选择新的目标。）\', \'type\': \'法术\', \'flavor\': \'大地似泰坦巨人狂啸，张嘴露出黑石齿牙与岩浆红舌。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132540&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f3e973ad-90ec-4a34-8661-99eef1121898\', \'multiverseId\': 132540}, \'multiverseid\': 132540}]', '[{\'name\': \'Wahnwitzremasuri\', \'text\': \'Alle Remasuris haben „{T}: Benenne eine Karte. Ein Gegner deiner Wahl zeigt eine zufällig bestimmte Karte aus seiner Hand offen vor. Falls es die genannte Karte ist, wirft dieser Spieler sie ab. Spiele diese Fähigkeit nur während deines Zuges."\', \'type\': \'Kreatur — Remasuri\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132904&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'63dbdcb2-cafd-4174-b34c-4d0df970eb88\', \'multiverseId\': 132904}, \'multiverseid\': 132904}, {\'name\': \'Fragmentado de demencia\', \'text\': \'Todos los Fragmentados tienen "{T}: Nombra una carta. El oponente objetivo muestra una carta al azar de su mano. Ese jugador luego descarta la carta mostrada si es la carta nombrada. Juega esta habilidad sólo durante tu turno".\', \'type\': \'Criatura — Fragmentado\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134409&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4d407d93-a81f-481b-b9d8-2eb9712f0c47\', \'multiverseId\': 134409}, \'multiverseid\': 134409}, {\'name\': \'Slivoïde dément\', \'text\': "Tous les slivoïdes ont « {T} : Nommez une carte. L\'adversaire ciblé révèle au hasard une carte de sa main. If it\'s the named card, that player discards it. Ne jouez cette capacité que pendant votre tour. »", \'type\': \'Créature : slivoïde\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132603&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b081c0f3-1111-41d2-b859-6b5134781e23\', \'multiverseId\': 132603}, \'multiverseid\': 132603}, {\'name\': \'Tramutante della Demenza\', \'text\': \'Tutti i Tramutanti hanno "{T}: Nomina una carta. Un avversario bersaglio rivela una carta a caso dalla propria mano. Se è la carta nominata, quel giocatore la scarta Gioca questa abilità solo durante il tuo turno."\', \'type\': \'Creatura — Tramutante\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133205&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'79a2e4e3-2c18-49eb-84b6-410a279992ef\', \'multiverseId\': 133205}, \'multiverseid\': 133205}, {\'name\': \'狂気スリヴァー\', \'text\': \'すべてのスリヴァーは「{T}：対戦相手１人を対象とする。カード名を１つ指定する。 そのプレイヤーは手札からカードを１枚無作為に選んで公開する。 それが指定されたカードだった場合、そのプレイヤーはそれを捨てる。 この能力は、あなたのターンにのみプレイできる。」を持つ。\', \'type\': \'クリーチャー — スリヴァー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133506&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'14e2ee5f-f0cc-4eef-839c-ccb0fcc13603\', \'multiverseId\': 133506}, \'multiverseid\': 133506}, {\'name\': \'Fractius da Demência\', \'text\': \'Todos os Fractius têm "{T}: Nomeie um card. O oponente alvo revela um card da própria mão aleatoriamente. Se for o card nomeado, aquele jogador o descarta. Use esta habilidade apenas durante o seu próprio turno."\', \'type\': \'Criatura — Fractius\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133807&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2d46f9d4-f630-4278-bab2-29944653f6f9\', \'multiverseId\': 133807}, \'multiverseid\': 133807}, {\'name\': \'Слабоумная Щепка\', \'text\': \'Все Щепки обладают способностью "{T}: Назовите карту. Целевой оппонент показывает одну случайную карту из своей руки. Eсли это названная карта, то этот игрок сбрасывает эту карту. Играйте эту способность только на вашем ходу."\', \'type\': \'Существо — Щепка\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134108&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'84ee7c31-535b-4302-b736-e75f68b368da\', \'multiverseId\': 134108}, \'multiverseid\': 134108}, {\'name\': \'痴呆裂片妖\', \'text\': \'所有裂片妖具有「{T}：说出一个牌名。 目标对手从其手上随机展示一张牌。 若名称相同，则该牌手将它弃掉。 你只可以于你的回合中使用此异能。」\', \'type\': \'生物～裂片妖\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132302&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2257d94e-7e5f-45a9-8c40-f48e295cc986\', \'multiverseId\': 132302}, \'multiverseid\': 132302}]', '[{\'name\': \'Wahrheit oder Fabel\', \'text\': \'Decke die fünf obersten Karten deiner Bibliothek auf und teile sie in zwei Haufen auf. Ein Gegner bestimmt einen dieser Haufen. Nimm eine Karte des bestimmten Haufens auf deine Hand und lege den Rest der auf diese Weise aufgedeckten Karten in beliebiger Reihenfolge unter deine Bibliothek.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133127&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'547877d4-3efd-44af-bd1f-b900abd54ffe\', \'multiverseId\': 133127}, \'multiverseid\': 133127}, {\'name\': \'Mito o verdad\', \'text\': \'Muestra las primeras cinco cartas de tu biblioteca y sepáralas en dos montones. Un oponente elige uno de esos montones. Pon una carta del montón elegido en tu mano, luego pon todas las otras cartas mostradas de esta manera en la parte inferior de tu biblioteca en cualquier orden.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134632&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'78999b1c-f1be-47a8-8e40-637ee7cb4814\', \'multiverseId\': 134632}, \'multiverseid\': 134632}, {\'name\': \'Conte ou vérité\', \'text\': "Révélez les cinq cartes du dessus de votre bibliothèque et séparez-les en deux piles. Un adversaire choisit une de ces piles. Mettez une carte de la pile choisie dans votre main, et mettez ensuite toutes les autres cartes révélées de cette manière au-dessous de votre bibliothèque dans n\'importe quel ordre.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132826&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0cf2d786-b092-4ba2-9ebe-c92ed009c0c6\', \'multiverseId\': 132826}, \'multiverseid\': 132826}, {\'name\': \'Verità o Menzogna\', \'text\': \'Rivela le prime cinque carte del tuo grimorio e separale in due pile. Un avversario sceglie una pila. Aggiungi alla tua mano una carta della pila scelta, poi metti tutte le altre carte rivelate in questo modo in fondo al tuo grimorio in qualsiasi ordine.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133428&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f4d294f2-0c25-48b3-81d3-b9d90a0c7c58\', \'multiverseId\': 133428}, \'multiverseid\': 133428}, {\'name\': \'真実か詐話か\', \'text\': \'あなたのライブラリーの一番上から５枚のカードを公開し、２つの束に分ける。 いずれかの対戦相手は、どちらか１つの束を選ぶ。 選ばれた束をあなたの手札に加え、これにより公開された他のすべてのカードを望む順番であなたのライブラリーの一番下に置く。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133729&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8b8362de-de87-41b3-b0c9-40486b306dfc\', \'multiverseId\': 133729}, \'multiverseid\': 133729}, {\'name\': \'Verdade ou Mentira\', \'text\': \'Revele os cinco cards do topo de seu grimório e separe-os em duas pilhas. Um oponente escolhe uma das pilhas. Coloque um card da pilha escolhida em sua mão e depois coloque todos os outros cards revelados deste modo no fundo de seu grimório em qualquer ordem.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134030&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a6758d4d-9a6f-4a93-b5bd-253c4b2b1887\', \'multiverseId\': 134030}, \'multiverseid\': 134030}, {\'name\': \'Правда или Вымысел\', \'text\': \'Предъявите пять верхних карт вашей библиотеки и разделите их на две стопки. Оппонент выбирает одну из них. Положите карту из выбранной стопки в вашу руку, затем положите все оставшиеся предъявленные этим путем карты в любом порядке под низ вашей библиотеки.\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134331&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ef131ab5-e294-4bba-a539-f8cfb1faa109\', \'multiverseId\': 134331}, \'multiverseid\': 134331}, {\'name\': \'虚实难解\', \'text\': \'展示你牌库顶的五张牌，并分成两堆。 由任一对手选择其中一堆。 将该堆中的一张牌置于你手上，然后将以此法展示的其它牌以任意顺序置于你的牌库底。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132525&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2abe54e7-4771-4a12-bca9-13b9bed3fbaf\', \'multiverseId\': 132525}, \'multiverseid\': 132525}]', "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132937&type=card', 'language': 'German', 'identifiers': {'scryfallId': '6c7c74ce-e20d-4c68-b1de-381586aa1291', 'multiverseId': 132937}, 'multiverseid': 132937}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134442&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '849640d8-b3f5-4635-b19f-74082bfbccbf', 'multiverseId': 134442}, 'multiverseid': 134442}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132636&type=card', 'language': 'French', 'identifiers': {'scryfallId': '9cdfbe8f-2301-43b9-8df2-ae0494167513', 'multiverseId': 132636}, 'multiverseid': 132636}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133238&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '23005f14-7a49-49e8-8833-a2f387753346', 'multiverseId': 133238}, 'multiverseid': 133238}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133539&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9dd780d9-9c38-4e48-9f60-a6aa9f3ca71f', 'multiverseId': 133539}, 'multiverseid': 133539}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133840&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '96c5e27b-d2da-4b65-86a1-559b570245bd', 'multiverseId': 133840}, 'multiverseid': 133840}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134141&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '2b4739a6-5dde-48fc-aba6-5877ce62bc90', 'multiverseId': 134141}, 'multiverseid': 134141}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132335&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '5a1cd33b-d606-4901-b1fd-f573e5584348', 'multiverseId': 132335}, 'multiverseid': 132335}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132938&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4e9b7d29-f1c6-45a2-b05b-ea0f1e1fb39f', 'multiverseId': 132938}, 'multiverseid': 132938}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134443&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'b0c1311d-1429-4aa7-8bcb-545019005046', 'multiverseId': 134443}, 'multiverseid': 134443}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132637&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c1ca0851-5431-4de4-a1a2-4650935261c7', 'multiverseId': 132637}, 'multiverseid': 132637}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133239&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b809d5cb-aced-4ddf-bee8-81e4df89c457', 'multiverseId': 133239}, 'multiverseid': 133239}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133540&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '71f57af8-fa11-4f20-8e56-4c7947e2c220', 'multiverseId': 133540}, 'multiverseid': 133540}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133841&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e24beddc-d8aa-4303-9093-911706b18e3a', 'multiverseId': 133841}, 'multiverseid': 133841}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134142&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '863fdf82-9ea8-4514-b067-1ef6b186b8b7', 'multiverseId': 134142}, 'multiverseid': 134142}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132336&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '45b9e32c-f712-4651-ab91-fffb866b9f97', 'multiverseId': 132336}, 'multiverseid': 132336}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132939&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd6a151d4-bdf0-45bd-8784-498b34e0e60c', 'multiverseId': 132939}, 'multiverseid': 132939}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134444&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '03435f9f-be82-454a-8f30-f28c76e7cc07', 'multiverseId': 134444}, 'multiverseid': 134444}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132638&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd633f36a-be42-47fd-b64f-63dca50b3a82', 'multiverseId': 132638}, 'multiverseid': 132638}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133240&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '18829627-287d-4863-b6d6-bf338a208637', 'multiverseId': 133240}, 'multiverseid': 133240}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133541&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '608efb14-b9b8-413a-8341-f022e0bdd7f6', 'multiverseId': 133541}, 'multiverseid': 133541}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133842&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0311abf1-738f-4bae-b062-d5254f888e1c', 'multiverseId': 133842}, 'multiverseid': 133842}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134143&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'f668d7f7-e718-4269-bd12-82b27d0d8584', 'multiverseId': 134143}, 'multiverseid': 134143}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132337&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9c8561bf-85ba-4795-b19c-32ae2352a43f', 'multiverseId': 132337}, 'multiverseid': 132337}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132940&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e19f91c2-4c79-4302-b5ea-528634c9b1b8', 'multiverseId': 132940}, 'multiverseid': 132940}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134445&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'b3a82ae6-fa00-4705-a790-deac1caae351', 'multiverseId': 134445}, 'multiverseid': 134445}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132639&type=card', 'language': 'French', 'identifiers': {'scryfallId': '60a3ba22-1437-4275-af07-a201b777a213', 'multiverseId': 132639}, 'multiverseid': 132639}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133241&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3c338cfc-8c92-4114-bdd9-4c405290ad0a', 'multiverseId': 133241}, 'multiverseid': 133241}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133542&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '397f4f53-fe5a-460f-808e-5b540883d666', 'multiverseId': 133542}, 'multiverseid': 133542}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133843&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5eebe644-2747-4fae-9c34-e586d7ad3725', 'multiverseId': 133843}, 'multiverseid': 133843}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134144&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'a06c65ab-e7e6-4fe7-bb2d-b391bf1300d6', 'multiverseId': 134144}, 'multiverseid': 134144}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132338&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'cfdd6e9b-4847-4422-be8b-f3216032bb74', 'multiverseId': 132338}, 'multiverseid': 132338}]", '[{\'name\': \'Weiser aus Epityr\', \'text\': \'Wenn der Weise aus Epityr ins Spiel kommt, betrachte die obersten vier Karten deiner Bibliothek und lege sie in beliebiger Reihenfolge zurück.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'Hellseher in ganz Dominaria ärgerten sich tot, als sich immer mehr Risse im Zeitgefüge öffneten und zufällige Leute plötzlich in die Zukunft sehen konnten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133059&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1bf98324-ddbf-4b81-aa35-f43db3317ec5\', \'multiverseId\': 133059}, \'multiverseid\': 133059}, {\'name\': \'Sabio de Épityr\', \'text\': \'Cuando el Sabio de Épityr entre en juego, mira las primeras cuatro cartas de la parte superior de tu biblioteca y regrésalas en cualquier orden.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'Los clarividentes de Dominaria enloquecieron con la sobrecarga de las brechas temporales en expansión, mientras otros ganaban el don de la visión del futuro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134564&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e1cc1433-caec-4ff5-b416-8c4aee66eae2\', \'multiverseId\': 134564}, \'multiverseid\': 134564}, {\'name\': "Sage d\'Epityr", \'text\': "Quand le Sage d\'Epityr arrive en jeu, regardez les quatre cartes du dessus de votre bibliothèque et remettez-les dessus dans l\'ordre de votre choix.", \'type\': \'Créature : humain et sorcier\', \'flavor\': "Les mediums de Dominaria étaient rendus fous par les images issues des failles temporelles de plus en plus nombreuses, tandis que d\'autres recevaient le don de voir l\'avenir.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132758&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'023fc9d3-4070-463f-9a38-26aa8f452ff7\', \'multiverseId\': 132758}, \'multiverseid\': 132758}, {\'name\': \'Saggio di Epityr\', \'text\': \'Quando il Saggio di Epityr entra in gioco, guarda le prime quattro carte del tuo grimorio, poi rimettile a posto in qualsiasi ordine.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': \'I chiaroveggenti in tutta Dominaria impazzivano per il sovraccarico dovuto agli squarci temporali sempre più larghi, mentre altre genti a caso ottenevano il dono della preveggenza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133360&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e33868ad-2781-41ad-b908-9776111157f7\', \'multiverseId\': 133360}, \'multiverseid\': 133360}, {\'name\': \'エピティアの賢者\', \'text\': \'エピティアの賢者が場に出たとき、あなたのライブラリーのカードを上から４枚見る。その後、それらを望む順番で戻す。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'ドミナリア全土の透視者達は、広がった時の裂け目の過負荷により狂気へと陥ったが、一方で未来視の恩恵にあずかれた者もいた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133661&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bb76c3c7-e5f5-4429-ab5f-18a29ec3025e\', \'multiverseId\': 133661}, \'multiverseid\': 133661}, {\'name\': \'Sábio de Epityr\', \'text\': \'Quando Sábio de Epityr entrar em jogo, olhe os quatro cards do topo de seu grimório e depois coloque-os de volta em qualquer ordem.\', \'type\': \'Criatura — Mago Humano\', \'flavor\': \'Os clarividentes de Dominária foram levados à loucura pela sobrecarga causada pelas fendas do tempo, enquanto outras pessoas comuns ganharam o dom da visão do futuro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133962&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fc032843-11c1-460d-a38b-7541a8625ad2\', \'multiverseId\': 133962}, \'multiverseid\': 133962}, {\'name\': \'Мудрец из Эпитир\', \'text\': \'Когда Мудрец из Эпитир входит в игру, посмотрите четыре верхних карты вашей библиотеки, затем положите их обратно в любом порядке.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'Провидцы по всей Доминарии сходили сума от наплывов видений от расширяющихся временных разломов, а другие самаритяне вдруг получали дары провидения.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134263&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'26ddd902-8389-48a3-bd07-4b5e550633a1\', \'multiverseId\': 134263}, \'multiverseid\': 134263}, {\'name\': \'艾比提智者\', \'text\': \'当艾比提智者进场时，检视你牌库顶的四张牌，然后将它们以任意顺序放回。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'时间裂缝让多明纳里亚各地的洞察家因讯息超载而发狂，但某些常人却因此获得预知能力。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132457&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5d156a1c-758e-4c0d-9bf3-e41fbe6f1721\', \'multiverseId\': 132457}, \'multiverseid\': 132457}]', "[{'name': 'Wettergegerbte Leibwächter', 'text': 'Solange die Wettergegerbten Leibwächter nicht getappt sind, wird aller Kampfschaden, der dir in diesem Zug von ungeblockten Kreaturen zugefügt würde, stattdessen den Wettergegerbten Leibwächtern zugefügt.\\nMorph {3}{W} (Du kannst diese Karte verdeckt für {3} als eine 2/2 Kreatur spielen. Decke sie zu einem beliebigen Zeitpunkt für ihre Morph-Kosten auf.)', 'type': 'Kreatur — Mensch, Soldat', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133145&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a9c4e743-318a-45af-bb66-424fd1eb8fc4', 'multiverseId': 133145}, 'multiverseid': 133145}, {'name': 'Guardaespaldas curtidos', 'text': 'Mientras los Guardaespaldas curtidos estén enderezados, todo el daño de combate que se te fuera a hacer por criaturas no bloqueadas se hace a los Guardaespaldas curtidos.\\nMetamorfosis {3}{W} (Puedes jugar esta carta boca abajo como una criatura 2/2 pagando {3}. Ponla boca arriba en cualquier momento pagando su coste de metamorfosis.)', 'type': 'Criatura — Soldado humano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134650&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '123318db-b439-463e-b79a-3f32382cce58', 'multiverseId': 134650}, 'multiverseid': 134650}, {'name': 'Gardes du corps hâlés', 'text': 'Tant que les Gardes du corps hâlés sont dégagés, toutes les blessures de combat qui vous seraient infligées par des créatures non-bloquées sont infligées aux Gardes du corps hâlés à la place.\\nMue {3}{W} (Vous pouvez jouer cette carte face cachée comme une créature 2/2 pour {3}. Retournez-la quand vous le désirez pour son coût de mue.)', 'type': 'Créature : humain et soldat', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132844&type=card', 'language': 'French', 'identifiers': {'scryfallId': '4444e63c-ecc3-474b-b92a-b60f439dd2b4', 'multiverseId': 132844}, 'multiverseid': 132844}, {'name': 'Guardie del Corpo Navigate', 'text': 'Fintanto che le Guardie del Corpo Navigate sono STAPpate, tutto il danno da combattimento che ti verrebbe inflitto da creature non bloccate viene invece inflitto alle Guardie del Corpo Navigate.\\nMetamorfosi {3}{W} (Puoi giocare questa carta a faccia in giù come una creatura 2/2 pagando {3}. Girala a faccia in su in qualsiasi momento pagando il suo costo di metamorfosi.)', 'type': 'Creatura — Soldato Umano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133446&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '5d3c593a-1097-4f74-9014-ff0fc68ddf6f', 'multiverseId': 133446}, 'multiverseid': 133446}, {'name': '雨ざらしのボディガード', 'text': '雨ざらしのボディガードがアンタップ状態であるかぎり、ブロックされていないクリーチャーからあなたに与えられるすべての戦闘ダメージは、代わりに雨ざらしのボディガードに与えられる。\\n変異 {3}{W} （あなたはこれを、{3}を支払うことで、裏向きの２/２のクリーチャーとしてプレイしてもよい。 いつでも変異コストを支払ってそれを表向きにすることができる。）', 'type': 'クリーチャー — 人間・兵士', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133747&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'eaf40e0b-50f8-469e-9626-69d75795f636', 'multiverseId': 133747}, 'multiverseid': 133747}, {'name': 'Guarda-Costas Desgastados', 'text': 'Enquanto Guarda-Costas Desgastados estiver desvirado, todo o dano de combate que seria causado a você por criaturas não bloqueadas, em vez disso, será causado a Guarda-Costas Desgastados.\\nMetamorfose {3}{W} (Você pode jogar este card com a face voltada para baixo como uma criatura 2/2 por {3}. Vire sua face para cima a qualquer momento pagando seu custo de metamorfose.)', 'type': 'Criatura — Soldado Humano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134048&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8e92a78b-7972-4825-9821-dec1f9ca0cb8', 'multiverseId': 134048}, 'multiverseid': 134048}, {'name': 'Обветренные Телохранители', 'text': 'До тех пор пока Обветренные Телохранители остаются неповернутыми, все боевые повреждения, которые должны наноситься вам незаблокированными существами, наносятся вместо этого Обветренным Телохранителям.\\nОборотень {3}{W} (Вы можете играть эту карту лицом вниз как 2/2 существо за {3}. Переверните ее лицом вверх в любой момент за ее стоимость оборотня.)', 'type': 'Существо — Человек Солдат', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134349&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '38c08163-7bec-4cd9-8aee-a2abfe1679c6', 'multiverseId': 134349}, 'multiverseid': 134349}, {'name': '历艰保镖', 'text': '只要历艰保镖未被横置，所有未受阻挡的生物将对你造成的伤害都改为对历艰保镖造成之。\\n变身{3}{W}（你可牌面朝下地使用此牌并支付{3}，将其当成2/2生物。 可随时支付其变身费用使其翻回正面。）', 'type': '生物～人类／士兵', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132543&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'ec510d31-b9c5-4ceb-8e61-bbbdc6b535a7', 'multiverseId': 132543}, 'multiverseid': 132543}]", '[{\'name\': \'Wetterkern-Totem\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {G}.\\n{2}{G}{G}{G}: Das Wetterkern-Totem wird bis zum Ende des Zuges zu einer 5/3 grünen Baumvolk-Artefaktkreatur, die Trampelschaden verursacht.\\nWenn das Wetterkern-Totem aus dem Spiel auf einen Friedhof gelegt wird, bringe diese Karte auf die Hand ihres Besitzers zurück, falls es eine Kreatur war.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133146&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dd9ce100-9ca9-4b4b-899b-64e18b5ed9d8\', \'multiverseId\': 133146}, \'multiverseid\': 133146}, {\'name\': \'Tótem de Semillaclima\', \'text\': \'{T}: Agrega {G} a tu reserva de maná.\\n{2}{G}{G}{G}: El Tótem de Semillaclima es una criatura artefacto Pueblo-arbóreo verde 5/3 con la habilidad de arrollar hasta el final del turno.\\nCuando el Tótem de Semillaclima vaya a un cementerio desde el juego, si era una criatura, regresa esta carta a la mano de su propietario.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134651&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b2cf7b06-8f78-4848-89f8-731a29d5ace7\', \'multiverseId\': 134651}, \'multiverseid\': 134651}, {\'name\': \'Totem de Brisengraine\', \'text\': "{T} : Ajoutez {G} à votre réserve.\\n{2}{G}{G}{G} : Le Totem de Brisengraine devient une créature-artefact 5/3 verte Sylvin avec le piétinement jusqu\'à la fin du tour.\\nQuand le Totem de Brisengraine est mis dans un cimetière depuis le jeu, s\'il était une créature, renvoyez cette carte dans la main de son propriétaire.", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132845&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f789867f-eddb-4446-aa30-56d70b13a592\', \'multiverseId\': 132845}, \'multiverseid\': 132845}, {\'name\': \'Totem di Seme del Vento\', \'text\': \'{T}: Aggiungi {G} alla tua riserva di mana.\\n{2}{G}{G}{G}: Il Totem di Seme del Vento diventa una creatura artefatto Silvantropo 5/3 verde con travolgere fino alla fine del turno.\\nQuando il Totem di Seme del Vento viene messo in un cimitero dal gioco, se era una creatura, fai tornare questa carta in mano al suo proprietario.\', \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133447&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4a5b4e16-aa98-47fb-9cbd-ad69b545919e\', \'multiverseId\': 133447}, \'multiverseid\': 133447}, {\'name\': \'ウェザーシードのトーテム像\', \'text\': \'{T}：あなたのマナ・プールに{G}を加える。\\n{2}{G}{G}{G}：ターン終了時まで、ウェザーシードのトーテム像はトランプルを持つ緑の５/３のツリーフォーク・アーティファクト・クリーチャーになる。\\nウェザーシードのトーテム像が場からいずれかの墓地に置かれたとき、それがクリーチャーである場合、そのカードをオーナーの手札に戻す。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133748&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b921bcf1-a885-4c0e-8e9b-312b08751bf5\', \'multiverseId\': 133748}, \'multiverseid\': 133748}, {\'name\': \'Totem da Semente dos Ventos\', \'text\': \'{T}: Adicione {G} à sua reserva de mana.\\n{2}{G}{G}{G}: Totem da Semente dos Ventos torna-se uma criatura artefato verde 5/3 do tipo Ent com atropelar até o final do turno.\\nQuando Totem da Semente dos Ventos for colocado no cemitério vindo do jogo, se era uma criatura, devolva este card para a mão de seu dono.\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134049&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'29b52e4f-9f96-4fec-8033-03ef39361b56\', \'multiverseId\': 134049}, \'multiverseid\': 134049}, {\'name\': \'Везерсидский Тотем\', \'text\': \'{T}: Добавьте {G} в ваше хранилище маны.\\n{2}{G}{G}{G}: Везерсидский тТотем становится артефактным существом 5/3 зеленый Лесовик с пробивным ударом до конца хода.\\nКогда Везерсидский Тотем попадает на кладбище из игры, если он был существом, верните эту карту в руку ее владельца.\', \'type\': \'Артефакт\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134350&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a895f446-be85-49d2-84bd-60f05868f582\', \'multiverseId\': 134350}, \'multiverseid\': 134350}, {\'name\': \'晴苗图腾像\', \'text\': \'{T}：加{G}到你的法术力池中。\\n{2}{G}{G}{G}：晴苗图腾像成为5/3绿色，具践踏异能的树妖神器生物直到回合结束。\\n当晴苗图腾像从场上置入坟墓场时，若它当时是生物，则将此牌移回其拥有者手上。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132544&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a856f067-0fd6-4ad7-b8d3-a1fbae62c298\', \'multiverseId\': 132544}, \'multiverseid\': 132544}]', '[{\'name\': \'Wilder Thallid\', \'text\': \'Lege zu Beginn deines Versorgungssegments eine Sporenmarke auf den Wilden Thalliden.\\nEntferne drei Sporenmarken vom Wilden Thalliden: Bringe einen 1/1 grünen Saprolingspielstein ins Spiel.\\nOpfere einen Saproling: Regeneriere ein Pilzwesen deiner Wahl.\', \'type\': \'Kreatur — Pilzwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133062&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d531aed3-5cad-4167-8078-19caeff6a8ac\', \'multiverseId\': 133062}, \'multiverseid\': 133062}, {\'name\': \'Tálido salvaje\', \'text\': \'Al comienzo de tu mantenimiento, pon un contador de espora sobre el Tálido salvaje.\\nRemover tres contadores de espora del Tálido salvaje: Pon en juego una ficha de criatura Saprolín verde 1/1.\\nSacrificar un Saprolín: Regenera el Hongo objetivo.\', \'type\': \'Criatura — Hongo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134567&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'402fc415-87a9-42ae-a475-dcbc28e647d4\', \'multiverseId\': 134567}, \'multiverseid\': 134567}, {\'name\': \'Thallidé sauvage\', \'text\': \'Au début de votre entretien, mettez un marqueur « spore » sur le Thallidé sauvage.\\nRetirez trois marqueurs « spore » du Thallidé sauvage : Mettez en jeu un jeton de créature 1/1 verte Saprobionte.\\nSacrifiez un saprobionte : Régénérez le fongus ciblé.\', \'type\': \'Créature : fongus\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132761&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'967884e7-fd9d-4ce0-a288-0c161712bdbb\', \'multiverseId\': 132761}, \'multiverseid\': 132761}, {\'name\': \'Thallid Selvaggia\', \'text\': "All\'inizio del tuo mantenimento, metti un segnalino spora sulla Thallid Selvaggia.\\nRimuovi tre segnalini spora dalla Thallid Selvaggia: Metti in gioco una pedina creatura Saprolingio 1/1 verde.\\nSacrifica un Saprolingio: Rigenera un Fungus bersaglio.", \'type\': \'Creatura — Fungus\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133363&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b8f56d2f-58fd-4bfa-bafd-20fd538521b4\', \'multiverseId\': 133363}, \'multiverseid\': 133363}, {\'name\': \'凶暴なサリッド\', \'text\': \'あなたのアップキープの開始時に、凶暴なサリッドの上に胞子カウンターを１個置く。\\n凶暴なサリッドから胞子カウンターを３個取り除く：緑の１/１の苗木クリーチャー・トークンを１体場に出す。\\n苗木を１体生け贄に捧げる：ファンガス１体を対象とし、それを再生する。\', \'type\': \'クリーチャー — ファンガス\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133664&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dd44367e-68df-471f-9f32-66c5b0121fcb\', \'multiverseId\': 133664}, \'multiverseid\': 133664}, {\'name\': \'Talídia Selvagem\', \'text\': \'No início de sua manutenção, coloque um marcador de esporo sobre Talídia Selvagem.\\nRemova três marcadores de esporo de Talídia Selvagem: Coloque em jogo uma ficha de criatura verde 1/1 do tipo Saprófita.\\nSacrifique um Saprófita: Regenere o Fungo alvo.\', \'type\': \'Criatura — Fungo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133965&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'de365f8b-34dd-4658-9776-7558671ad157\', \'multiverseId\': 133965}, \'multiverseid\': 133965}, {\'name\': \'Свирепый Таллид\', \'text\': \'В начале вашего шага поддержки положите один жетон споры на Свирепого Таллида.\\nУберите три жетона споры со Свирепого Таллида: Положите одну фишку существа 1/1 зеленый Сапролинг в игру.\\nПожертвуйте Сапролинга: Регенерируйте целевую Плесень.\', \'type\': \'Существо — Плесень\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134266&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0aa904d9-abb8-4237-9ecd-da294eff630d\', \'multiverseId\': 134266}, \'multiverseid\': 134266}, {\'name\': \'凶蛮散绿菌\', \'text\': \'在你的维持开始时，在凶蛮散绿菌上放置一个芽孢指示物。\\n从凶蛮散绿菌上移去三个芽孢指示物：将一个1/1绿色腐生物衍生物放置进场。\\n牺牲一个腐生物：重生目标真菌。\', \'type\': \'生物～真菌\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132460&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c22f54fd-4aa2-4e40-84bd-069b8ee7eb1b\', \'multiverseId\': 132460}, \'multiverseid\': 132460}]', '[{\'name\': \'Windumhang-Reiter\', \'text\': \'Flankenangriff (Immer wenn eine Kreatur ohne Flankenangriff diese Kreatur blockt, erhält die blockende Kreatur -1/-1 bis zum Ende des Zuges.)\\nImmer wenn der Windumhang-Reiter angreift, kannst du eine Kreatur deiner Wahl tappen.\\nImmer wenn der Windumhang-Reiter geblockt wird, kannst du den Windumhang-Reiter enttappen und aus dem Kampf entfernen.\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132962&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'13ae0317-bf52-4c9d-bd02-ca578502c5f4\', \'multiverseId\': 132962}, \'multiverseid\': 132962}, {\'name\': \'Caballero capaventus\', \'text\': \'Flanquea (Siempre que una criatura sin la habilidad de flanquear bloquee a esta criatura, la criatura bloqueadora obtiene -1/-1 hasta el final del turno.)\\nSiempre que el Caballero capaventus ataque, puedes girar la criatura objetivo.\\nSiempre que el Caballero capaventus sea bloqueado, puedes enderezar el Caballero capaventus y removerlo del combate.\', \'type\': \'Criatura — Caballero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134467&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'62849039-8d48-44c7-932b-05cd9d663803\', \'multiverseId\': 134467}, \'multiverseid\': 134467}, {\'name\': \'Cavalier soufflecape\', \'text\': "Débordement (À chaque fois qu\'une créature sans le débordement bloque cette créature, la créature bloqueuse gagne -1/-1 jusqu\'à la fin du tour.)\\nÀ chaque fois que le Cavalier soufflecape attaque, vous pouvez engager une créature ciblée.\\nÀ chaque fois que le Cavalier soufflecape devient bloqué, vous pouvez dégager le Cavalier soufflecape et le retirer du combat.", \'type\': \'Créature : humain et chevalier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132661&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'acca50d1-7043-4cea-9e5a-789f3ac8d16c\', \'multiverseId\': 132661}, \'multiverseid\': 132661}, {\'name\': \'Cavaliere di Mantovento\', \'text\': \'Aggirare (Ogniqualvolta una creatura senza aggirare blocca questa creatura, la creatura bloccante prende -1/-1 fino alla fine del turno.)\\nOgniqualvolta il Cavaliere di Mantovento attacca, puoi TAPpare una creatura bersaglio.\\nOgniqualvolta il Cavaliere di Mantovento viene bloccato, puoi STAPpare il Cavaliere di Mantovento e rimuoverlo dal combattimento.\', \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133263&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f2bf75da-0513-4883-a7aa-52e231dcbd65\', \'multiverseId\': 133263}, \'multiverseid\': 133263}, {\'name\': \'疾風衣の騎兵\', \'text\': \'側面攻撃 （側面攻撃を持たないいずれかのクリーチャーがこのクリーチャーをブロックするたび、そのブロックしているクリーチャーはターン終了時まで－１/－１の修整を受ける。）\\n疾風衣の騎兵が攻撃するたび、クリーチャー１体を対象とする。あなたはそれをタップしてもよい。\\n疾風衣の騎兵がブロックされた状態になるたび、あなたは疾風衣の騎兵をアンタップして戦闘から取り除いてもよい。\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133564&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'94dd9e44-4cda-41ac-840d-d5e7321e5fb9\', \'multiverseId\': 133564}, \'multiverseid\': 133564}, {\'name\': \'Cavaleiro do Manto Eólico\', \'text\': \'Flanquear (Toda vez que uma criatura sem flanquear bloquear esta criatura, a criatura bloqueadora receberá -1/-1 até o final do turno.)\\nToda vez que Cavaleiro do Manto Eólico atacar, você poderá virar a criatura alvo.\\nToda vez que Cavaleiro do Manto Eólico for bloqueado, você poderá desvirá-lo e removê-lo do combate.\', \'type\': \'Criatura — Cavaleiro Humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133865&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f973be07-301b-42f0-a346-4fa9ebe67e20\', \'multiverseId\': 133865}, \'multiverseid\': 133865}, {\'name\': \'Кавалер в Ветреном Плаще\', \'text\': \'Обход (Когда существо без обхода блокирует это существо, это блокирующее существо получает -1/-1 до конца хода.)\\nКогда Кавалер в Ветреном Плаще атакует, вы можете повернуть целевое существо.\\nКогда Кавалер в Ветреном Плаще становится заблокированным, вы можете развернуть Кавалера в Ветреном Плаще и убрать его из боя.\', \'type\': \'Существо — Человек Рыцарь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134166&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1014fc7b-4346-4829-a55b-4fc9659656e2\', \'multiverseId\': 134166}, \'multiverseid\': 134166}, {\'name\': \'风氅骑兵\', \'text\': \'侧面攻击（每当一个不具侧面攻击之生物阻挡此生物时，该阻挡生物得-1/-1直到回合结束。）\\n每当风氅骑兵攻击时，你可以横置目标生物。\\n每当风氅骑兵被阻挡时，你可以重置风氅骑兵并将它移出战斗。\', \'type\': \'生物～人类／骑士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132360&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'26a538e9-873a-480c-8347-5666d6f38f3c\', \'multiverseId\': 132360}, \'multiverseid\': 132360}]', '[{\'name\': \'Wolkenjagdturmfalke\', \'text\': \'Fliegend\\nWenn der Wolkenjagdturmfalke ins Spiel kommt, zerstöre eine Verzauberung deiner Wahl.\\n{W}: Eine bleibende Karte deiner Wahl wird bis zum Ende des Zuges weiß.\', \'type\': \'Kreatur — Vogel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132892&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c313fa25-1344-4421-8a9f-9764a0414ee7\', \'multiverseId\': 132892}, \'multiverseid\': 132892}, {\'name\': \'Cernícalo cazanubes\', \'text\': \'Vuela.\\nCuando el Cernícalo cazanubes entre en juego, destruye el encantamiento objetivo.\\n{W}: El permanente objetivo es blanco hasta el final del turno.\', \'type\': \'Criatura — Ave\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134397&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2fecfa1b-379e-41dc-bdfe-06b61226b9d7\', \'multiverseId\': 134397}, \'multiverseid\': 134397}, {\'name\': \'Crécerelle chasse-nuages\', \'text\': "Vol\\nQuand la Crécerelle chasse-nuages arrive en jeu, détruisez l\'enchantement ciblé.\\n{W} : Le permanent ciblé devient blanc jusqu\'à la fin du tour.", \'type\': \'Créature : oiseau\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132591&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3a11d049-5769-4005-800b-5232123b3535\', \'multiverseId\': 132591}, \'multiverseid\': 132591}, {\'name\': \'Gheppio Caccianubi\', \'text\': \'Volare\\nQuando il Gheppio Caccianubi entra in gioco, distruggi un incantesimo bersaglio.\\n{W}: Un permanente bersaglio diventa bianco fino alla fine del turno.\', \'type\': \'Creatura — Uccello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133193&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'095ed97f-624b-4aad-a1bb-6d980f376580\', \'multiverseId\': 133193}, \'multiverseid\': 133193}, {\'name\': \'雲を追うケストレル\', \'text\': \'飛行\\n雲を追うケストレルが場に出たとき、エンチャント１つを対象とし、それを破壊する。\\n{W}：パーマネント１つを対象とする。ターン終了時まで、それは白になる。\', \'type\': \'クリーチャー — 鳥\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133494&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7459f5f1-e661-48a4-8ae7-8f961d66f957\', \'multiverseId\': 133494}, \'multiverseid\': 133494}, {\'name\': \'Falconete Caça-Nuvens\', \'text\': \'Voar\\nQuando Falconete Caça-Nuvens entrar em jogo, destrua o encantamento alvo.\\n{W}: A permanente alvo torna-se branca até o final do turno.\', \'type\': \'Criatura — Ave\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133795&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ac9b174d-1d62-42c2-99ff-7abfa1cd7832\', \'multiverseId\': 133795}, \'multiverseid\': 133795}, {\'name\': \'Заоблачная Пустельга\', \'text\': \'Полет\\nКогда Заоблачная Пустельга входит в игру, уничтожьте целевые чары.\\n{W}: Целевой перманент становится белым до конца хода.\', \'type\': \'Существо — Птица\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134096&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'721a9394-915b-459e-89e7-1b1032fd1371\', \'multiverseId\': 134096}, \'multiverseid\': 134096}, {\'name\': \'逐云飞隼\', \'text\': \'飞行\\n当逐云飞隼进场时，消灭目标结界。\\n{W}：目标永久物成为白色直到回合结束。\', \'type\': \'生物～鸟\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132290&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4c47feac-7a54-47df-9730-2199430d9c49\', \'multiverseId\': 132290}, \'multiverseid\': 132290}]', '[{\'name\': \'Worte der Beschlagnahme\', \'text\': \'Sekundenbruchteil (Solange dieser Zauberspruch sich auf dem Stapel befindet, können Spieler keine Zaubersprüche oder aktivierte Fähigkeiten spielen, die keine Manafähigkeiten sind.)Enttappe eine bleibende Karte deiner Wahl und übernimm bis zum Ende des Zuges die Kontrolle über sie.\\n Sie erhält Eile bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Gehorche"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133149&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f7fa29a4-d5eb-4e84-8d60-e7ac440c047c\', \'multiverseId\': 133149}, \'multiverseid\': 133149}, {\'name\': \'Palabras de captura\', \'text\': \'Fracción de segundo (Mientras este hechizo esté en la pila, los jugadores no pueden jugar hechizos o habilidades activadas que no sean habilidades de maná.)\\nEndereza el permanente objetivo y gana el control de él hasta el final del turno. Gana la habilidad de prisa hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"¡Obedece"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134654&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'caed5841-95de-4d45-86a2-88be3400b340\', \'multiverseId\': 134654}, \'multiverseid\': 134654}, {\'name\': "Parole d\'appropriation", \'text\': "Fraction de seconde (Tant que ce sort est sur la pile, les joueurs ne peuvent pas jouer de sorts ou de capacités activées qui ne sont pas des capacités de mana.)\\nDégagez le permanent ciblé et acquérez-en le contrôle jusqu\'à la fin du tour. Il acquiert la célérité jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': \'« Obéis »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132848&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3e7d94df-03f8-4434-9a59-a88c39080685\', \'multiverseId\': 132848}, \'multiverseid\': 132848}, {\'name\': \'Parola di Possesso\', \'text\': \'Battibaleno (Fintanto che questa magia è in pila, i giocatori non possono giocare magie o abilità attivate che non siano abilità di mana.)\\nSTAPpa un permanente bersaglio e prendine il controllo fino alla fine del turno. Ha rapidità fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Obbedisci"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133450&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3b5578d0-e3d0-4cf9-8c8b-8b38be891a28\', \'multiverseId\': 133450}, \'multiverseid\': 133450}, {\'name\': \'捕縛の言葉\', \'text\': \'刹那 （この呪文がスタックにあるかぎり、プレイヤーは呪文やマナ能力でない起動型能力をプレイできない。）\\nパーマネント１つを対象とし、それをアンタップする。あなたはターン終了時までそれのコントロールを得る。 それはターン終了時まで速攻を得る。\', \'type\': \'インスタント\', \'flavor\': \'従え！\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133751&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'be891c92-21ca-470e-aa3f-87d02d00eba2\', \'multiverseId\': 133751}, \'multiverseid\': 133751}, {\'name\': \'Palavra de Controle\', \'text\': \'Fração de segundo (Enquanto esta mágica estiver na pilha, os jogadores não poderão jogar mágicas ou habilidades ativadas que não sejam habilidades de mana.)\\nDesvire a permanente alvo e ganhe o controle dela até o final do turno. Ela ganha ímpeto até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Obedeça"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134052&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3fea22ae-7d7c-4c5b-a8a5-1b5aa75722be\', \'multiverseId\': 134052}, \'multiverseid\': 134052}, {\'name\': \'Слово Овладения\', \'text\': \'Мгновение ока (До тех пор пока это заклинание находится в стеке, игроки не могут играть заклинания или активируемые способности, которые не являются мана-способностями.)\\nРазверните целевой перманент и получите контроль над ним до конца хода. Он получает ускорение до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Подчинись»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134353&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a1d24c68-fe37-4d23-b734-35cb7a84bc4c\', \'multiverseId\': 134353}, \'multiverseid\': 134353}, {\'name\': \'攫灵咒\', \'text\': \'转瞬（只要此咒语在堆叠上，牌手便不能使用咒语或不是法术力异能的起动式异能。）\\n重置目标永久物并获得其操控权直到回合结束。 它获得敏捷异能直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'「听令！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132547&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e62240a9-47dd-42f2-ac4e-3ec972a2dfa9\', \'multiverseId\': 132547}, \'multiverseid\': 132547}]', '[{\'name\': \'Wurmholzdryade\', \'text\': \'{G}: Die Wurmholzdryade erhält Waldtarnung bis zum Ende des Zuges und fügt dir 1 Schadenspunkt zu.\\n{B}: Die Wurmholzdryade erhält Sumpftarnung bis zum Ende des Zuges und fügt dir 1 Schadenspunkt zu.\', \'type\': \'Kreatur — Dryade\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133150&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'31370d74-c504-4414-8537-7e7def860472\', \'multiverseId\': 133150}, \'multiverseid\': 133150}, {\'name\': \'Dríada de Bosque gusano\', \'text\': \'{G}: La Dríada de Bosque gusano gana la habilidad de cruzar bosques hasta el final del turno y te hace 1 punto de daño.\\n{B}: La Dríada de Bosque gusano gana la habilidad de cruzar pantanos hasta el final del turno y te hace 1 punto de daño.\', \'type\': \'Criatura — Dríada\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134655&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'05124d8b-1628-4c5d-8b2a-500f36253a74\', \'multiverseId\': 134655}, \'multiverseid\': 134655}, {\'name\': \'Dryade de Boiverreux\', \'text\': "{G} : La Dryade de Boiverreux acquiert la traversée des forêts jusqu\'à la fin du tour et elle vous inflige 1 blessure.\\n{B} : La Dryade de Boiverreux acquiert la traversée des marais jusqu\'à la fin du tour et elle vous inflige 1 blessure.", \'type\': \'Créature : dryade\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132849&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5d1d5a34-42d8-4741-82fc-291b592ac250\', \'multiverseId\': 132849}, \'multiverseid\': 132849}, {\'name\': \'Driade di Vermibosco\', \'text\': \'{G}: La Driade di Vermibosco ha passa-Foreste fino alla fine del turno e ti infligge 1 danno.\\n{B}: La Driade di Vermibosco ha passa-Paludi fino alla fine del turno e ti infligge 1 danno.\', \'type\': \'Creatura — Driade\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133451&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c0c4dfe9-1bf2-4b40-8786-9dc085b83c9a\', \'multiverseId\': 133451}, \'multiverseid\': 133451}, {\'name\': \'ワームウッドのドライアド\', \'text\': \'{G}：ワームウッドのドライアドはターン終了時まで森渡りを得て、それはあなたに１点のダメージを与える。\\n{B}：ワームウッドのドライアドはターン終了時まで沼渡りを得て、それはあなたに１点のダメージを与える。\', \'type\': \'クリーチャー — ドライアド\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133752&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1294a8de-ddae-4e45-a284-c7a79ed3ccc1\', \'multiverseId\': 133752}, \'multiverseid\': 133752}, {\'name\': \'Dríade da Selva dos Vermes\', \'text\': \'{G}: Dríade da Selva dos Vermes ganha travessia de floresta até o final do turno e causa 1 ponto de dano a você.\\n{B}: Dríade da Selva dos Vermes ganha travessia de pântano até o final do turno e causa 1 ponto de dano a você.\', \'type\': \'Criatura — Dríade\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134053&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f1543232-1096-4096-8d2c-99053b448ecb\', \'multiverseId\': 134053}, \'multiverseid\': 134053}, {\'name\': \'Вормвудская Дриада\', \'text\': \'{G}: Вормвудская Дриада получает знание лесов до конца хода и наносит вам 1 повреждение.\\n{B}: Вормвудская Дриада получает знание болот до конца хода и наносит вам 1 повреждение.\', \'type\': \'Существо — Дриада\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134354&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4e2443ed-5157-4cc3-9e95-c12a90d19c2e\', \'multiverseId\': 134354}, \'multiverseid\': 134354}, {\'name\': \'蠕虫林树灵\', \'text\': \'{G}：蠕虫林树灵获得树林行者异能直到回合结束，且对你造成1点伤害。\\n{B}：蠕虫林树灵获得沼泽行者异能直到回合结束，且对你造成1点伤害。\', \'type\': \'生物～树灵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132548&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2d090374-55d2-4226-9a90-10293ef54b00\', \'multiverseId\': 132548}, \'multiverseid\': 132548}]', "[{'name': 'Wurmruf', 'text': 'Rückkauf {2}{G} (Du kannst zusätzlich {2}{G} bezahlen, sowie du diesen Zauberspruch spielst. Falls du dies tust, nimm diese Karte auf deine Hand, sowie sie verrechnet wird.)\\nBringe einen X/X grünen Wurmspielstein ins Spiel.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133151&type=card', 'language': 'German', 'identifiers': {'scryfallId': '1e18ca7d-4c2b-4cf1-8594-b5c75d11c1d1', 'multiverseId': 133151}, 'multiverseid': 133151}, {'name': 'Llamasierpe', 'text': 'Estímulo {2}{G}. (Puedes pagar {2}{G} adicionales en cuanto juegues este hechizo. Si lo haces, pon esta carta en tu mano en cuanto se resuelve.)\\nPon en juego una ficha de criatura Sierpe verde X/X.', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134656&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'decaf50a-faec-4183-8f3b-ebad1a2905cb', 'multiverseId': 134656}, 'multiverseid': 134656}, {'name': 'Adjuration des guivres', 'text': 'Rappel {2}{G} (Vous pouvez payer {2}{G} supplémentaires au moment où vous jouez ce sort. Si vous faites ainsi, mettez cette carte dans votre main au moment où elle se résout.)\\nMettez en jeu un jeton de créature X/X verte Guivre.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132850&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'efa55cb5-fbca-4228-8920-db99aaa20ff2', 'multiverseId': 132850}, 'multiverseid': 132850}, {'name': 'Convocawurm', 'text': 'Riscatto {2}{G} (Puoi pagare {2}{G} addizionale mentre giochi questa magia. Se lo fai, riprendi in mano questa carta quando si risolve.)\\nMetti in gioco una pedina creatura Wurm X/X verde.', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133452&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'acf6a152-704c-4fbe-b8df-90b38dbc4a70', 'multiverseId': 133452}, 'multiverseid': 133452}, {'name': 'ワーム呼び', 'text': 'バイバック {2}{G} （あなたはこの呪文をプレイするに際し、追加で{2}{G}を支払ってもよい。 そうした場合、それの解決に際し、このカードをあなたの手札に加える。）\\n緑のＸ/Ｘのワーム・クリーチャー・トークンを１体場に出す。', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133753&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '19357ba8-dacd-40f8-9087-2697696871d7', 'multiverseId': 133753}, 'multiverseid': 133753}, {'name': 'Vormevocação', 'text': 'Recuperar {2}{G} (Você pode pagar um custo adicional de {2}{G} ao jogar esta mágica. Se fizer isso, coloque este card em sua mão quando for resolvido.)\\nColoque em jogo uma ficha de criatura verde X/X do tipo Vorme.', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134054&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0efa2276-a19c-4b8d-8832-8087a69af9c2', 'multiverseId': 134054}, 'multiverseid': 134054}, {'name': 'Зов Червей', 'text': 'Выкуп {2}{G} (Вы можете заплатить дополнительно {2}{G} при игре этого заклинания. Если вы сделаете это, положите эту карту в вашу руку, когда она разрешится.)\\nПоложите фишку существа X/X зеленый Вурм в игру.', 'type': 'Волшебство', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134355&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'da966ee2-48c1-42d0-8236-0ccaec11e579', 'multiverseId': 134355}, 'multiverseid': 134355}, {'name': '亚龙召令', 'text': '购回{2}{G}（你使用此咒语时可以额外支付{2}{G}。 若你如此做，则结算此咒语时将它放入你的手牌。）\\n将一个X/X绿色亚龙衍生物放置进场。', 'type': '法术', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132549&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '687fabbf-af4b-46a8-8e1f-d82f086252fd', 'multiverseId': 132549}, 'multiverseid': 132549}]", '[{\'name\': \'Wütender Remasuri\', \'text\': \'Alle Remasuris haben Doppelschlag.\', \'type\': \'Kreatur — Remasuri\', \'flavor\': \'„Eine Zeitspalte öffnete sich, und unsere Pfeile blieben in der Luft hängen. Eigene Bewegung war unmöglich. Doch die Klaue des Remasuris zuckte weiter, blutige Striemen erschienen auf Theds Brust, und Blutfontänen hingen in der Luft." —Adom Capashen, Benalischer Held\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132947&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f7b968e1-c622-4a0c-b280-7dba2e3b7a03\', \'multiverseId\': 132947}, \'multiverseid\': 132947}, {\'name\': \'Fragmentado de la furia\', \'text\': \'Todos los Fragmentados tienen la habilidad de dañar dos veces.\', \'type\': \'Criatura — Fragmentado\', \'flavor\': \'"Se abrió una brecha, y nuestras flechas se detuvieron abruptamente. Moverse era como querer empujar el mundo. Pero la garra del fragmentado todavía se movía, y heridas rojas aparecían en el pecho de Thed mientras la sangre flotaba como cintas inmóviles en el aire." —Ádom Capashen, héroe benalita\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134452&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'681a6d21-b399-4e96-a67f-a19a59e8101a\', \'multiverseId\': 134452}, \'multiverseid\': 134452}, {\'name\': \'Slivoïde furieux\', \'text\': \'Tous les slivoïdes ont la double initiative.\', \'type\': \'Créature : slivoïde\', \'flavor\': "« Une faille s\'ouvrit, et nos flèches cessèrent de pleuvoir. Le temps s\'était soudain arrêté. Mais la pince du slivoïde remuait toujours. Des lignes écarlates zébraient la poitrine de Thed et des rubans de sang étaient suspendus dans les airs. » —Adom Capashen, héros bénalian", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132646&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8ab6f128-547b-4172-a4fb-0931c716ad92\', \'multiverseId\': 132646}, \'multiverseid\': 132646}, {\'name\': \'Tramutante Furioso\', \'text\': \'Tutti i Tramutanti hanno doppio attacco.\', \'type\': \'Creatura — Tramutante\', \'flavor\': \'"Si aprì uno squarcio e le nostre frecce improvvisamente furono immobili. Muoversi significava sfidare il mondo. Ma gli artigli del tramutante continuavano a contorcersi, nel petto di Thed apparvero rosse ferite e strisce di sangue rimanevano sospese in aria." —Adom Capashen, eroe di Benalia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133248&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6604cb23-dcfc-49b6-adef-092b08ec9610\', \'multiverseId\': 133248}, \'multiverseid\': 133248}, {\'name\': \'憤怒スリヴァー\', \'text\': \'すべてのスリヴァーは二段攻撃を持つ。\', \'type\': \'クリーチャー — スリヴァー\', \'flavor\': \'裂け目が開き、我らの矢は突然止まった。 動くことは世界を押し返すようなものだった。 しかし、スリヴァーの爪は動き続け、セッドの胸に赤い傷が見えたかと思うと、空中に赤い血の帯が浮かんだのだ。 ――ベナリアの英雄、エイドム・キャパシェン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133549&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'59fa339a-cb13-40b7-af57-9ef63003804e\', \'multiverseId\': 133549}, \'multiverseid\': 133549}, {\'name\': \'Fractius da Fúria\', \'text\': \'Todos os Fractius têm golpe duplo.\', \'type\': \'Criatura — Fractius\', \'flavor\': \'"Uma fenda abriu-se, e então nossas flechas foram abruptamente caladas. Mover-se era como empurrar o mundo. Mas as garras do fractius ainda se agitavam, feridas vermelhas apareceram no tórax de Thed, e fitas de sangue pairavam no ar." —Adom Capashen, herói de Benália\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133850&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ba9dade6-531d-453d-b651-196a154fad6a\', \'multiverseId\': 133850}, \'multiverseid\': 133850}, {\'name\': \'Яростная Щепка\', \'text\': \'Все Щепки обладают способностью Двойной Удар.\', \'type\': \'Существо — Щепки\', \'flavor\': \'«Разлом открылся, и наши стрелы внезапно остановились. Двигаться означало толкать мир. Но когти Осколков попрежнему дергались, красные раны появлялись на теле Теда, и струи крови летели по воздуху», Адом Капашен, Беналишский герой\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134151&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6e6721c3-0182-4c31-9707-c3bd12e58bb2\', \'multiverseId\': 134151}, \'multiverseid\': 134151}, {\'name\': \'怒火裂片妖\', \'text\': \'所有裂片妖具有连击异能。\', \'type\': \'生物～裂片妖\', \'flavor\': \'「一道时缝张开，我军射出的箭就此冻结住。 动根指头都像移山般困难。 但那裂片妖的利爪依旧抓动着，塞德的胸膛爆开一道红迹，鲜血一颗颗地悬在半空。」 ～宾纳里亚勇士艾栋·卡帕轩\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132345&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d01e2dda-366b-4274-b2c1-27e3e94743d4\', \'multiverseId\': 132345}, \'multiverseid\': 132345}]', "[{'name': 'Yavimayadryade', 'text': 'Waldtarnung\\nWenn die Yavimayadryade ins Spiel kommt, kannst du deine Bibliothek nach einem Wald durchsuchen und ihn getappt unter der Kontrolle eines Spielers deiner Wahl ins Spiel bringen. Falls du dies tust, mische danach deine Bibliothek.', 'type': 'Kreatur — Dryade', 'flavor': 'Die ausgetrocknete Erde beschützte immer noch die wenigen Seelen, die das Herz hatten, sie ihre Heimat zu nennen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133152&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a9bdf636-a918-4f59-b22e-ce436f8c5fdd', 'multiverseId': 133152}, 'multiverseid': 133152}, {'name': 'Dríada de Yavimaya', 'text': 'Cruza bosques.\\nCuando la Dríada de Yavimaya entre en juego, puedes buscar en tu biblioteca una carta de bosque y ponerla en juego girada bajo el control del jugador objetivo. Si lo haces, baraja tu biblioteca.', 'type': 'Criatura — Dríada', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134657&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ff338719-1eda-4ee9-96f1-bbad78ca9a64', 'multiverseId': 134657}, 'multiverseid': 134657}, {'name': 'Dryade de la Yavimaya', 'text': 'Traversée des forêts\\nQuand la Dryade de la Yavimaya arrive en jeu, vous pouvez chercher dans votre bibliothèque une carte de forêt et la mettre en jeu engagée sous le contrôle du joueur ciblé. Si vous faites ainsi, mélangez votre bibliothèque.', 'type': 'Créature : dryade', 'flavor': 'La terre ravagée protégeait toujours les quelques malheureux qui la considéraient encore comme leur foyer.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132851&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a0b102c5-0d2e-4836-931c-bcb0333fa621', 'multiverseId': 132851}, 'multiverseid': 132851}, {'name': 'Driade di Yavimaya', 'text': 'Passa-Foreste\\nQuando la Driade di Yavimaya entra in gioco, puoi passare in rassegna il tuo grimorio per una carta Foresta e metterla in gioco TAPpata sotto il controllo di un giocatore bersaglio. Se lo fai, rimescola il tuo grimorio.', 'type': 'Creatura — Driade', 'flavor': 'La terra inaridita proteggeva ancora quelle poche anime che avessero il coraggio di chiamarla casa.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133453&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'f1196c5b-60b7-45b1-8063-43ff5f32ba96', 'multiverseId': 133453}, 'multiverseid': 133453}, {'name': 'ヤヴィマヤのドライアド', 'text': '森渡り\\nヤヴィマヤのドライアドが場に出たとき、プレイヤー１人を対象とする。あなたは自分のライブラリーから森カードを１枚探してそのプレイヤーのコントロール下で場に出してもよい。 そうした場合、あなたのライブラリーを切り直す。', 'type': 'クリーチャー — ドライアド', 'flavor': '荒廃した大地も、そこを故郷と思う数少ない魂を守り続けている。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133754&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'be4d8901-5530-4a9e-9946-e4adb35a9f9e', 'multiverseId': 133754}, 'multiverseid': 133754}, {'name': 'Dríade de Yavimaya', 'text': 'Travessia de Floresta\\nQuando Dríade de Yavimaya entra em jogo, você pode procurar em seu grimório por um card de Floresta e colocá-lo em jogo virado sob o controle do jogador alvo. Se fizer isso, embaralhe seu grimório.', 'type': 'Criatura — Dríade', 'flavor': 'A terra ressecada ainda protegia aquelas poucas almas capazes de considerá-la como sua casa.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134055&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f592e45a-a46f-41cd-920d-544d4ae6c96c', 'multiverseId': 134055}, 'multiverseid': 134055}, {'name': 'Явимайская Дриада', 'text': 'Знание лесов\\nКогда Явимайская Дриада входит в игру, поищите в вашей библиотеке карту Леса и положите ее повернутой в игру под контролем целевого игрока. Если вы это сделаете, перетасуйте свою библиотеку.', 'type': 'Существо — Дриада', 'flavor': 'Выжженная земля до сих пор защищала те немногие души, которые называли ее домом.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134356&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '9b80900f-d039-43ec-9064-b9282fa2e69f', 'multiverseId': 134356}, 'multiverseid': 134356}, {'name': '亚维马雅树灵', 'text': '树林行者\\n当亚维马雅树灵进场时，你可以从你的牌库中搜寻一张树林牌，并将它在目标牌手的操控下横置进场。 若你如此作，则将你的牌库洗牌。', 'type': '生物～树灵', 'flavor': '干枯大地依旧保护这少数诚心为家园奉献的灵魂。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132550&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'e2ccd9d7-168e-4c46-bb23-75698b8cd0d6', 'multiverseId': 132550}, 'multiverseid': 132550}]", '[{\'name\': \'Zackenbewehrter Schocker\', \'text\': \'Verursacht Trampelschaden, Eile\\nImmer wenn der Zackenbewehrte Schocker einem Spieler Schaden zufügt, wirft dieser Spieler alle Karten aus seiner Hand ab und zieht dann ebenso viele Karten.\', \'type\': \'Kreatur — Insekt\', \'flavor\': \'Hitzköpfige Schamanen setzten sich freiwillig den Schockern aus, um dadurch möglicherweise Dinge über die Zukunft zu erfahren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132866&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4795c32d-3aac-43fd-bfd5-1dfe0be851ff\', \'multiverseId\': 132866}, \'multiverseid\': 132866}, {\'name\': \'Conmocionador espinoso\', \'text\': \'Arrolla, prisa.\\nSiempre que el Conmocionador espinoso haga daño a un jugador, ese jugador descarta todas las cartas de su mano, luego roba ese mismo número de cartas.\', \'type\': \'Criatura — Insecto\', \'flavor\': \'Sólo unos pocos chamanes soportan el dolor por voluntad propia, con la esperanza de vislumbrar qué depara el futuro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134371&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1d8cc640-8b2d-4dbe-8472-d6294bed01b1\', \'multiverseId\': 134371}, \'multiverseid\': 134371}, {\'name\': \'Affreux barbelé\', \'text\': "Piétinement, célérité\\nÀ chaque fois que l\'Affreux barbelé inflige des blessures à un joueur, ce joueur se défausse de toutes les cartes dans sa main, puis pioche autant de cartes.", \'type\': \'Créature : insecte\', \'flavor\': "Les shamanes les plus fervents acceptaient la souffrance dans l\'espoir d\'une vision de l\'avenir.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132565&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fd07fa23-e714-4bf1-8ebe-5e1caef22b9b\', \'multiverseId\': 132565}, \'multiverseid\': 132565}, {\'name\': \'Squassatore Spinato\', \'text\': \'Travolgere, rapidità\\nOgniqualvolta lo Squassatore Spinato infligge danno a un giocatore, quel giocatore scarta tutte le carte dalla propria mano, poi ne pesca altrettante.\', \'type\': \'Creatura — Insetto\', \'flavor\': \'Fervidi sciamani ubbidiscono di buon grado agli squassatori nella speranza di intravedere le sorti future.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133167&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d272c1da-86c0-4c19-a27d-9336960adbb6\', \'multiverseId\': 133167}, \'multiverseid\': 133167}, {\'name\': \'棘のショッカー\', \'text\': \'トランプル、速攻\\n棘のショッカーがいずれかのプレイヤーにダメージを与えるたび、そのプレイヤーは手札のカードをすべて捨て、その後その枚数に等しい枚数のカードを引く。\', \'type\': \'クリーチャー — 昆虫\', \'flavor\': \'熱狂的なシャーマンは、未来の運命を垣間見ることを願い、望んでショッカーを受け入れる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133468&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'918a54cf-fabe-468c-872a-6f55c2122f58\', \'multiverseId\': 133468}, \'multiverseid\': 133468}, {\'name\': \'Estraçalhador Farpado\', \'text\': \'Atropelar, ímpeto\\nToda vez que Estraçalhador Farpado causa dano a um jogador, aquele jogador descarta todos os cards na mão dele e, a seguir, compra a mesma quantidade de cards.\', \'type\': \'Criatura — Inseto\', \'flavor\': \'Os xamãs mais fervorosos se submentem voluntariamente aos estraçalhadores na esperança de vislumbrar as fortunas do futuro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133769&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'42aa5426-39c1-453e-a841-4251a3a0a43d\', \'multiverseId\': 133769}, \'multiverseid\': 133769}, {\'name\': \'Шипастый Обжига\', \'text\': \'Пробивной удар, ускорение\\nКогда Шипастый Обжига наносит повреждения игроку, этот игрок сбрасывает все карты в его или ее руке, затем берет такое же количество карт.\', \'type\': \'Существо — Насекомое\', \'flavor\': \'Ярые шаманы охотно покорились обжигам в надежде ухватить видения будущего.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134070&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'686ba604-641b-4a80-902f-6c71d6c78ac2\', \'multiverseId\': 134070}, \'multiverseid\': 134070}, {\'name\': \'带刺电击虫\', \'text\': \'践踏，敏捷\\n每当带刺电击虫对牌手造成伤害时，该牌手弃掉所有手牌，然后抓等量的牌。\', \'type\': \'生物～昆虫\', \'flavor\': \'一些热情祭师自愿让电击虫螫刺，希望能藉此瞥视未来运势。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132264&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8880b8bf-1ac6-43d2-80fe-1bda1f457ae8\', \'multiverseId\': 132264}, \'multiverseid\': 132264}]', "[{'name': 'Zauberzerplatzer', 'text': 'Rückkauf {3} (Du kannst zusätzlich {3} bezahlen, sowie du diesen Zauberspruch spielst. Falls du dies tust, nimm diese Karte auf deine Hand, sowie sie verrechnet wird.)\\nNeutralisiere einen Zauberspruch deiner Wahl mit umgewandelten Manakosten von X.', 'type': 'Spontanzauber', 'flavor': 'So denken unzivilisierte Magier.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133079&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c0521c5c-9ea3-4199-84e0-b2065e2eac27', 'multiverseId': 133079}, 'multiverseid': 133079}, {'name': 'Estallido de hechizo', 'text': 'Recuperar {3} (Puedes pagar {3} adicionales en cuanto juegues este hechizo. Si lo haces, pon esta carta en tu mano en cuanto se resuelve.)\\nContrarresta el hechizo objetivo con coste de maná convertido de X.', 'type': 'Instantáneo', 'flavor': 'La manera de pensar de un mago bruto.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134584&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'b9508284-7977-4531-9a92-096183452550', 'multiverseId': 134584}, 'multiverseid': 134584}, {'name': 'Explosion de sort', 'text': 'Rappel {3} (Vous pouvez payer {3} supplémentaires au moment où vous jouez ce sort. Si vous faites ainsi, mettez cette carte dans votre main au moment où elle se résout.)\\nContrecarrez le sort ciblé dont le coût converti de mana est de X.', 'type': 'Éphémère', 'flavor': 'Penser, façon magicien brutal.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132778&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'cfa6a5c5-92ed-495a-9afe-a87557ae16c1', 'multiverseId': 132778}, 'multiverseid': 132778}, {'name': 'Vampata di Magia', 'text': 'Riscatto {3} (Puoi pagare {3} addizionale mentre giochi questa magia). Se lo fai, riprendi in mano questa carta quando si risolve.)\\nNeutralizza una magia bersaglio con costo di mana convertito pari a X.', 'type': 'Istantaneo', 'flavor': 'Il modo di pensare del mago brutale.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133380&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '94aeb62d-ffef-4004-87b1-d24596ca4b3b', 'multiverseId': 133380}, 'multiverseid': 133380}, {'name': '呪文の噴出', 'text': 'バイバック {3} （あなたはこの呪文をプレイするに際し、追加で{3}を支払ってもよい。 そうした場合、それの解決に際し、このカードをあなたの手札に加える。）\\n点数で見たマナ・コストがＸの呪文１つを対象とし、それを打ち消す。', 'type': 'インスタント', 'flavor': '騒がしい魔道士の考え方。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133681&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '29998228-40df-46b3-a3d6-9e00afb36b4d', 'multiverseId': 133681}, 'multiverseid': 133681}, {'name': 'Explosão Mágica', 'text': 'Recuperar {3} (Você pode pagar um custo adicional de {3} ao jogar esta mágica. Se fizer isso, coloque este card em sua mão quando for resolvido.)\\nAnule a mágica alvo com custo de mana convertido igual a X.', 'type': 'Mágica Instantânea', 'flavor': 'A versão brutal do mago ao pensamento.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133982&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '4320814e-54a5-4164-b843-7f0a61859ac8', 'multiverseId': 133982}, 'multiverseid': 133982}, {'name': 'Взрыв Заклятия', 'text': 'Выкуп {3} (Вы можете заплатить дополнительно {3} при игре этого заклинания. Если вы делаете это, положите эту карту в вашу руку когда она разрешится.)\\nОтмените целевое заклинание с конвертированной мана-стоимостью X.', 'type': 'Мгновенное заклинание', 'flavor': 'Стиль мышления жестокого мага.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134283&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '5b1005b4-9cef-431b-99b3-3298b0913c64', 'multiverseId': 134283}, 'multiverseid': 134283}, {'name': '魔力爆发', 'text': '购回{3}（你使用此咒语时可以额外支付{3}。 若你如此做，则结算此咒语时将它放入你的手牌。）\\n反击目标总法术力费用为X的咒语。', 'type': '瞬间', 'flavor': '这可说是粗暴法术师的头脑力量。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132477&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a8bde867-8519-4152-8dea-aad0a82d9fc4', 'multiverseId': 132477}, 'multiverseid': 132477}]", '[{\'name\': \'Zeitatog-Totem\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {U}.\\n{1}{U}: Das Zeitatog-Totem wird bis zum Ende des Zuges zu einer 1/2 blauen Atog-Artefaktkreatur.\\n{0}: Das Zeitatog-Totem erhält +3/+3 bis zum Ende des Zuges. Du übergehst deinen nächsten Zug. Spiele diese Fähigkeit nur einmal pro Zug und nur, falls das Zeitatog-Totem eine Kreatur ist.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132888&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d50c6bb5-6ec8-48aa-9388-64fd321a3fde\', \'multiverseId\': 132888}, \'multiverseid\': 132888}, {\'name\': \'Tótem de cronatog\', \'text\': \'{T}: Agrega {U} a tu reserva de maná.\\n{1}{U}: El Tótem de cronatog es una criatura artefacto Atog azul 1/2 hasta el final del turno.\\n{0}: El Tótem de cronatog obtiene +3/+3 hasta el final del turno. Sáltate tu siguiente turno. Juega esta habilidad sólo una vez cada turno y sólo si el Tótem de cronatog es una criatura.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134393&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d82a05a8-ef91-4a0a-b79b-a3a5ac4e5921\', \'multiverseId\': 134393}, \'multiverseid\': 134393}, {\'name\': \'Totem du chronatog\', \'text\': "{T} : Ajoutez {U} à votre réserve.\\n{1}{U} : Le Totem du chronatog devient une créature-artefact 1/2 bleue Atog jusqu\'à la fin du tour.\\n{0} : Le Totem du chronatog gagne +3/+3 jusqu\'à la fin du tour. Vous passez votre prochain tour. Ne jouez cette capacité qu\'une seule fois par tour et uniquement si le Totem du chronatog est une créature.", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132587&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a62468c5-f17c-4690-bede-a9bd88322dd5\', \'multiverseId\': 132587}, \'multiverseid\': 132587}, {\'name\': "Totem dell\'Atog Temporale", \'text\': "{T}: Aggiungi {U} alla tua riserva di mana.\\n{1}{U}: Il Totem dell\'Atog Temporale diventa una creatura artefatto Atog 1/2 blu fino alla fine del turno.\\n{0}: Il Totem dell\'Atog Temporale prende +3/+3 fino alla fine del turno. Salta il tuo prossimo turno. Gioca questa abilità solo una volta per turno e solo se il Totem dell\'Atog Temporale è una creatura.", \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133189&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1949a8b1-d613-4b1c-bde7-70b7dfe9b08c\', \'multiverseId\': 133189}, \'multiverseid\': 133189}, {\'name\': \'時エイトグのトーテム像\', \'text\': \'{T}：あなたのマナ・プールに{U}を加える。\\n{1}{U}：ターン終了時まで、時エイトグのトーテム像は青の１/２のエイトグ・アーティファクト・クリーチャーになる。\\n{0}：時エイトグのトーテム像はターン終了時まで＋３/＋３の修整を受ける。 あなたの次のターンをとばす。 この能力は、各ターン１回のみ、時エイトグのトーテム像がクリーチャーである場合のみプレイできる。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133490&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'32ae3d7b-eca8-4e90-b968-41ca31d606fa\', \'multiverseId\': 133490}, \'multiverseid\': 133490}, {\'name\': \'Totem Cronatogue\', \'text\': \'{T}: Adicione {U} à sua reserva de mana.\\n{1}{U}: Totem Cronatogue torna-se uma criatura artefato azul 1/2 do tipo Atogue até o final do turno.{0}: Totem Cronatogue recebe +3/+3 até o final do turno.\\n Você pula seu próximo turno. Use esta habilidade apenas uma vez a cada turno e somente se Totem Cronatogue for uma criatura.\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133791&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'743eb29a-ab75-4544-9849-c05481f7129c\', \'multiverseId\': 133791}, \'multiverseid\': 133791}, {\'name\': \'Тотем Хронатога\', \'text\': \'{T}: Добавьте {U} в ваше хранилище маны.\\n{1}{U}: Тотем Хронатога становится 1/2 синим артефактным существом Атог до конца хода.\\n{0}: Тотем Хронатога получает +3/+3 до конца хода. Вы пропускаете ваш следующий ход. Играйте эту способность только один раз в ход и только если Тотем Хронатога является существом.\', \'type\': \'Артефакт\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134092&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'88cc63ad-d8a0-401b-8991-0285a7129b10\', \'multiverseId\': 134092}, \'multiverseid\': 134092}, {\'name\': \'时空阿托格图腾像\', \'text\': \'{T}：加{U}到你的法术力池中。\\n{1}{U}：时空阿托格图腾像成为1/2蓝色阿托格神器生物直到回合结束。\\n{0}：时空阿托格图腾像得+3/+3直到回合结束。 你略过你的下个回合。 此异能每回合只能使用一次，且于时空阿托格图腾像是生物时才能使用。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132286&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9fb98252-89f6-462a-a191-6330e959a489\', \'multiverseId\': 132286}, \'multiverseid\': 132286}]', '[{\'name\': \'Zeitkundiger\', \'text\': \'{1}{W}: Bringe den Zeitkundigen aus deinem Friedhof getappt ins Spiel zurück. Übergehe deinen nächsten Zug.\', \'type\': \'Kreatur — Riese\', \'flavor\': \'„In meinen Träumen höre ich die Stimmen meiner zukünftigen Ichs, die in Zeiten gestorben sind, die noch zu kommen haben. Ich verwende dieses Wissen, um diese dunklen Seiten der Zukunft zu vermeiden und meine Suche nach Frieden fortzusetzen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132889&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'61d7e100-04a1-46e2-8f01-25a174104160\', \'multiverseId\': 132889}, \'multiverseid\': 132889}, {\'name\': \'Cronósofo\', \'text\': \'{1}{W}: Regresa el Cronósofo de tu cementerio al juego girado. Sáltate tu siguiente turno.\', \'type\': \'Criatura — Gigante\', \'flavor\': \'"En mis sueños escucho voces de mis yos futuros que murieron en épocas que todavía no llegaron. Uso ese conocimiento para evitar esos oscuros futuros y continuar mi búsqueda de paz."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134394&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c212e7e7-eac7-4564-a6ed-c0da3bb6a16a\', \'multiverseId\': 134394}, \'multiverseid\': 134394}, {\'name\': \'Chronosavant\', \'text\': \'{1}{W} : Renvoyez en jeu, engagé, le Chronosavant depuis votre cimetière. Passez votre prochain tour.\', \'type\': \'Créature : géant\', \'flavor\': "« Dans mes rêves, j\'entends les voix de mes incarnations futures, tuées dans des époques encore à venir. Cette connaissance me permet d\'éviter ces avenirs sombres et de continuer ma quête de paix. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132588&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c0d72014-19f1-40dd-98a7-7e7f523b1f42\', \'multiverseId\': 132588}, \'multiverseid\': 132588}, {\'name\': \'Cronosapiente\', \'text\': \'{1}{W}: Rimetti in gioco TAPpato il Cronosapiente dal tuo cimitero. Salta il tuo prossimo turno.\', \'type\': \'Creatura — Gigante\', \'flavor\': \'"Nei miei sogni, sento le voci dei me stessi futuri che sono morti in tempi ancora da venire. Sfrutto quella conoscenza per evitare quegli oscuri futuri e continuare la mia ricerca della pace."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133190&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d92eea6e-de25-41ac-a3b8-cb0a83f2e103\', \'multiverseId\': 133190}, \'multiverseid\': 133190}, {\'name\': \'クロノサヴァント\', \'text\': \'{1}{W}：あなたの墓地にあるクロノサヴァントをタップ状態で場に出す。 あなたの次のターンをとばす。\', \'type\': \'クリーチャー — 巨人\', \'flavor\': \'夢の中で、私は未来の我ら自身が、未だ来たらぬ時の中で死す声を聞いた。 私はその知識を、そのような暗黒の未来を避けるために用い、平和の探求を続けている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133491&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'810320e0-6d71-4b82-b1f6-26806c421252\', \'multiverseId\': 133491}, \'multiverseid\': 133491}, {\'name\': \'Cronosábio\', \'text\': \'{1}{W}: Devolva Cronosábio de seu cemitério para o jogo virado. Pule seu próximo turno.\', \'type\': \'Criatura — Gigante\', \'flavor\': \'"Em meus sonhos, ouço vozes de minhas futuras personalidades que morreram em vidas ainda por vir. Uso este conhecimento para evitar aqueles futuros sombrios e continuar minha busca pela paz."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133792&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'676682f3-be94-48bd-9add-42fe4ad29319\', \'multiverseId\': 133792}, \'multiverseid\': 133792}, {\'name\': \'Хрономудрец\', \'text\': \'{1}{W}: Верните Хрономудреца из вашего кладбища в игру повернутым. Пропустите ваш следующий ход.\', \'type\': \'Существо — Гигант\', \'flavor\': \'«В моих мечтах я слышу голоса моего собственного будущего, которые умирают в еще не пришедшие часы. Я пользуюсь теми знаниями, чтобы избежать темных грядущих времен и продолжить поиски мира».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134093&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cfa9e329-1f00-4c20-83f3-c61b2715109e\', \'multiverseId\': 134093}, \'multiverseid\': 134093}, {\'name\': \'时间学者\', \'text\': \'{1}{W}：将时间学者从你的坟墓场横置进场。 略过你的下个回合。\', \'type\': \'生物～巨人\', \'flavor\': \'「在我梦中，可以听见未来将死去的我之声音。 我藉此避开这黑暗未来，并且继续研究和平之途。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132287&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'61940caa-5622-4912-9860-60c1ca9d3a4f\', \'multiverseId\': 132287}, \'multiverseid\': 132287}]', '[{\'name\': \'Zeitriss-Wolkenscholle\', \'text\': \'Fliegend\\nWenn die Zeitriss-Wolkenscholle ins Spiel kommt, bringe eine bleibende Karte deiner Wahl auf die Hand ihres Besitzers zurück.\\nAussetzen 3 {1}{U} (Statt diese Karte aus deiner Hand zu spielen, kannst du {1}{U} bezahlen, sie ganz aus dem Spiel entfernen und drei Zeitmarken auf sie legen. Entferne zu Beginn deines Versorgungssegments eine Zeitmarke von ihr. Wenn du die letzte Zeitmarke entfernst, spiele die Karte, ohne ihre Manakosten zu bezahlen. Sie hat Eile.)\', \'type\': \'Kreatur — Illusion\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133057&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d18df223-a157-433b-8674-9a44a2b8a77d\', \'multiverseId\': 133057}, \'multiverseid\': 133057}, {\'name\': \'Rayanube ala agrietada\', \'text\': \'Vuela.\\nCuando la Rayanube ala agrietada entre en juego, regresa el permanente objetivo a la mano de su propietario.\\nSuspender 3—{1}{U} (En lugar de jugar esta carta de tu mano, puedes pagar {1}{U} y removerla del juego con tres contadores de tiempo sobre ella. Al comienzo de tu mantenimiento, remueve un contador de tiempo. Cuando remuevas el último, juégala sin pagar su coste de maná. Tiene la habilidad de prisa.)\', \'type\': \'Criatura — Ilusión\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134562&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'aae31036-d0ae-4dea-92b0-abc73fef8467\', \'multiverseId\': 134562}, \'multiverseid\': 134562}, {\'name\': \'Pastenuage planefaille\', \'text\': \'Vol\\nQuand le Pastenuage planefaille arrive en jeu, renvoyez le permanent ciblé dans la main de son propriétaire.\\nSuspension 3 — {1}{U} (Plutôt que jouer cette carte depuis votre main, vous pouvez payer {1}{U} et la retirer de la partie avec trois marqueurs « temps » sur elle. Au début de votre entretien, retirez un marqueur « temps ». Quand vous retirez le dernier, jouez cette carte sans payer son coût de mana. Elle a la célérité.)\', \'type\': \'Créature : illusion\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132756&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2133f7da-1360-4490-a4a0-f7034d15d049\', \'multiverseId\': 132756}, \'multiverseid\': 132756}, {\'name\': \'Nubimanta Alasquarciata\', \'text\': "Volare\\nQuando la Nubimanta Alasquarciata entra in gioco, fai tornare un permanente bersaglio in mano al suo proprietario.\\nSospendere 3—{1}{U} (Invece di giocare questa carta dalla tua mano, puoi pagare {1}{U} e rimuoverla dal gioco con tre segnalini tempo su di essa. All\'inizio del tuo mantenimento, rimuovi un segnalino tempo. Quando rimuovi l\'ultimo, gioca la carta senza pagare il suo costo di mana. Ha rapidità.)", \'type\': \'Creatura — Illusione\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133358&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a0a64aa9-b9ec-4091-a91a-9e410458d4ed\', \'multiverseId\': 133358}, \'multiverseid\': 133358}, {\'name\': \'裂け目翼の雲間を泳ぐもの\', \'text\': \'飛行\\n裂け目翼の雲間を泳ぐものが場に出たとき、パーマネント１つを対象とし、それをオーナーの手札に戻す。\\n待機 ３―{1}{U} （これをあなたの手札からプレイするのではなく、{1}{U}を支払ってゲームから取り除き、その上に時間カウンターを３個置いてもよい。 あなたのアップキープの開始時に、時間カウンターを１個取り除く。 最後の１個を取り除いたとき、あなたはそれをマナ・コストを支払わずにプレイする。 それは速攻を持つ。）\', \'type\': \'クリーチャー — イリュージョン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133659&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'23b0facc-2211-4932-aead-5e5334179a59\', \'multiverseId\': 133659}, \'multiverseid\': 133659}, {\'name\': \'Desliza-Nuvens da Fenda\', \'text\': \'Voar\\nQuando Desliza-Nuvens da Fenda entrar em jogo, devolva a permanente alvo para a mão de seu dono.\\nSuspender 3—{1}{U} (Em vez de jogar este card da sua mão, você pode pagar {1}{U} e removê-lo do jogo com três marcadores temporais sobre ele. No início de sua manutenção, remova um marcador temporal. Quando remover o último, jogue-o sem pagar seu custo de mana. Ele tem ímpeto.)\', \'type\': \'Criatura — Ilusão\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133960&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d5f84217-1af2-409a-90c9-14cab511e319\', \'multiverseId\': 133960}, \'multiverseid\': 133960}, {\'name\': \'Разломный Наездник Облаков\', \'text\': \'Полет\\nКогда Разломный Наездник Облаков входит в игру, верните целевой перманент в руку его владельца.\\nОтсрочка 3—{1}{U} (Вместо того чтобы сыграть эту карту из вашей руки, вы можете заплатить {1}{U} и удалить ее из игры с тремя временными жетонами на ней. В начале вашего шага поддержки удалите один временной жетон. После удаления последнего жетона сыграйте эту карту без оплаты ее мана-стоимости. Она получает ускорение.)\', \'type\': \'Существо — Иллюзия\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134261&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'021c5c51-797d-4623-b805-fc170a1e409a\', \'multiverseId\': 134261}, \'multiverseid\': 134261}, {\'name\': \'时缝翔云影\', \'text\': \'飞行\\n当时缝翔云影进场时，将目标永久物移回其拥有者手上。\\n延缓3～{1}{U}（除了从你手上使用此牌，你可以支付{1}{U}并将此牌移出对战，且上面有三个计时指示物。 在你的维持开始时，从其上移去一个计时指示物。 当你移去最后一个时，则使用它且不需支付其法术力费用。 它具有敏捷。）\', \'type\': \'生物～虚影\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132455&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a6046ffa-7b95-4463-98e9-6198404c5c8a\', \'multiverseId\': 132455}, \'multiverseid\': 132455}]', '[{\'name\': \'Zeitstrudel\', \'text\': \'Lege eine Kreatur oder ein Land deiner Wahl oben auf die Bibliothek ihres bzw. seines Besitzers.\', \'type\': \'Hexerei\', \'flavor\': \'Als die Zeitrisse sich ausbreiteten und die Zeit auseinanderbrach, kamen immer mehr Besucher aus Vergangenheit und Zukunft, während die Bewohner der Gegenwart langsam verschwanden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133108&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f60e9467-d863-4738-9b91-e26b87616653\', \'multiverseId\': 133108}, \'multiverseid\': 133108}, {\'name\': \'Remolino temporal\', \'text\': \'Pon la criatura o tierra objetivo en la parte superior de la biblioteca de su propietario.\', \'type\': \'Conjuro\', \'flavor\': \'A medida que las fracturas temporales se multiplicaron y el mismo tiempo se desmoronó, comenzaron a aparecer visitantes del pasado y del futuro, y aquellos nativos del presente comenzaron a desaparecer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134613&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7f35a00d-8037-4dfe-8ac5-e2ee1b355851\', \'multiverseId\': 134613}, \'multiverseid\': 134613}, {\'name\': \'Remous temporels\', \'text\': \'Mettez la créature ciblée ou le terrain ciblé au-dessus de la bibliothèque de son propriétaire.\', \'type\': \'Rituel\', \'flavor\': "Alors que les fractures temporelles s\'étendaient et que le temps finissait par se déchirer, des visiteurs du passé et de l\'avenir faisaient leur apparition et les autochtones du présent commençaient à disparaître.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132807&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3e1478b6-704b-4e48-902d-dfb8ac15c2a9\', \'multiverseId\': 132807}, \'multiverseid\': 132807}, {\'name\': \'Mulinello Temporale\', \'text\': \'Metti una creatura o una terra bersaglio in cima al grimorio del suo proprietario.\', \'type\': \'Stregoneria\', \'flavor\': \'Mentre le fratture temporali si allargavano e il tempo stesso si sfilacciava lentamente, iniziarono a comparire visitatori sia dal passato che dal futuro e coloro che appartenevano al presente cominciarono a sparire.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133409&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4a84d082-0dea-4f97-b378-06f9686a6b54\', \'multiverseId\': 133409}, \'multiverseid\': 133409}, {\'name\': \'時間の渦\', \'text\': \'クリーチャー１体か土地１つを対象とし、それをオーナーのライブラリーの一番上に置く。\', \'type\': \'ソーサリー\', \'flavor\': \'時間のひびが広がり、時間自体がゆっくりと崩れていく中で、過去や未来から訪れるものが現れ始め、現在に生きる者達が消え始めていた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133710&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'089db438-2d10-483a-9fc6-2beda3c70fce\', \'multiverseId\': 133710}, \'multiverseid\': 133710}, {\'name\': \'Turbilhão Temporal\', \'text\': \'Coloque a criatura alvo ou o terreno alvo no topo do grimório de seu dono.\', \'type\': \'Feitiço\', \'flavor\': \'Conforme as fraturas temporais e o próprio tempo lentamente se desintegraram, começaram a surgir visitantes do passado e do futuro, e aqueles que pertenciam ao presente começaram a desaparecer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134011&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2dd9b4a6-1d6b-4dac-9c77-dff65208f969\', \'multiverseId\': 134011}, \'multiverseid\': 134011}, {\'name\': \'Временная Воронка\', \'text\': \'Положите целевое существо или землю наверх библиотеки владельца.\', \'type\': \'Волшебство\', \'flavor\': \'Когда распространились временные трещины и понемногу стало распадаться время, из прошлого и будущего начали появляться визитеры, а местные, живущие в настоящем, стали пропадать.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134312&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5882f481-16e0-4445-bd38-f0acaf84ddb7\', \'multiverseId\': 134312}, \'multiverseid\': 134312}, {\'name\': \'时间涡流\', \'text\': \'将目标生物或地置于其拥有者的牌库顶。\', \'type\': \'法术\', \'flavor\': \'随着时间裂口扩大，时间本身也逐渐支离破碎，过去与未来的事物逐一出现，而属于现在者则开始消失。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132506&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'726eb817-e334-4d04-bd0c-3e495c44fe19\', \'multiverseId\': 132506}, \'multiverseid\': 132506}]', '[{\'name\': \'Zu Staub zurückkehren\', \'text\': \'Entferne eine Artefakt oder eine Verzauberung deiner Wahl ganz aus dem Spiel. Hast du diesen Zauberspruch während deiner Hauptphase gespielt, kannst du bis zu einem weiteren Artefakt oder einer weiteren Verzauberung deiner Wahl ganz aus dem Spiel entfernen.\', \'type\': \'Spontanzauber\', \'flavor\': \'Manche Zeitstränge zerspleißen, verzweigen und vermischen sich. Andere enden unerwartet.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133055&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5b3cacf3-af24-438b-901b-3c39c0ef9ea0\', \'multiverseId\': 133055}, \'multiverseid\': 133055}, {\'name\': \'Volver al polvo\', \'text\': \'Remueve del juego el artefacto o encantamiento objetivo. Si jugaste este hechizo durante tu fase principal, puedes remover del juego otro artefacto o encantamiento objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'Su espada cayó sobre el cuello de un trasgo, pero no del trasgo que había atacado. Cuando Tivadar levantó la vista, el mundo que conocía ya no estaba allí.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134560&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e63731ae-81c5-4f42-baa6-9ecddd383c26\', \'multiverseId\': 134560}, \'multiverseid\': 134560}, {\'name\': \'Rendre à la poussière\', \'text\': "Retirez l\'artefact ou l\'enchantement ciblé de la partie. Si vous avez joué ce sort pendant votre phase principale, vous pouvez retirer jusqu\'à un autre artefact ou enchantement ciblé de la partie.", \'type\': \'Éphémère\', \'flavor\': "Certaines lignes temporelles se multiplient, se rejoignent et se séparent perpétuellement. D\'autres s\'achèvent de manière abrupte.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132754&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ed953bbb-579f-42a7-8cea-3f9ef1decfbd\', \'multiverseId\': 132754}, \'multiverseid\': 132754}, {\'name\': \'Ritornare Polvere\', \'text\': \'Rimuovi dal gioco un artefatto o un incantesimo bersaglio. Se hai giocato questa magia nella tua fase principale, puoi rimuovere dal gioco fino a un altro artefatto o incantesimo bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'Alcune linee temporali continuamente si sfilacciano, si ramificano e si mischiano. Altre terminano bruscamente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133356&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dd6f2f7e-d258-4c72-a522-2271dd123883\', \'multiverseId\': 133356}, \'multiverseid\': 133356}, {\'name\': \'土への帰結\', \'text\': \'アーティファクト１つかエンチャント１つを対象とし、それをゲームから取り除く。 あなたが土への帰結をあなたのメイン・フェイズ中にプレイした場合、あなたは他のアーティファクトかエンチャントを最大１つまで対象とし、それをゲームから取り除いてもよい。\', \'type\': \'インスタント\', \'flavor\': \'歴史の中には、ほつれ、枝分かれし、混ざり合うものがある。 それ以外はあっけなく終わるものだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133657&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cd7ed3a3-fb1a-4caf-82d1-df2705084a7f\', \'multiverseId\': 133657}, \'multiverseid\': 133657}, {\'name\': \'Voltar ao Pó\', \'text\': \'Remova de jogo o artefato alvo ou o encantamento alvo. Se você jogou esta mágica durante sua fase principal, você pode remover do jogo um outro artefato alvo ou encantamento alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Algumas linhas do tempo se desgastam, se ramificam e se mesclam. Outras se encerram bruscamente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133958&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2fdb1ebc-fb99-4f48-b447-07e860a3f687\', \'multiverseId\': 133958}, \'multiverseid\': 133958}, {\'name\': \'Возврат к Праху\', \'text\': \'Уберите целевой артефакт или чары из игры. Если вы сыграли это заклинание во время вашей основной фазы, вы можете убрать еще один дополнительный целевой артефакт или чары из игры.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Некоторые временные линие вечно расползаются, ветвятся и смешиваются. Другие неожиданно прерываются.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134259&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'db4857ab-c55d-4056-ba43-9efe4d7ed8fe\', \'multiverseId\': 134259}, \'multiverseid\': 134259}, {\'name\': \'终归浮尘\', \'text\': \'将目标神器或结界移出对战。 如果你在你的行动阶段使用此咒语，则你可以将至多另一个目标神器或结界移出对战。\', \'type\': \'瞬间\', \'flavor\': \'有些时间流会不停歇地摩擦、分支、混杂。 其它的则会突然结束。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132453&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'40bac8e1-d7f7-47c6-9f0a-49e38cafa1bc\', \'multiverseId\': 132453}, \'multiverseid\': 132453}]', '[{\'name\': \'Zweiköpfiger Remasuri\', \'text\': \'Alle Remasuris haben „Diese Kreatur kann nur von zwei oder mehr Kreaturen geblockt werden".\', \'type\': \'Kreatur — Remasuri\', \'flavor\': \'„Bei allen anderen Rassen wäre dies eine fatale Mutation, aber Remasuris scheinen daraus weitere Vorteile gewinnen zu können. Ich bin beeindruckt, habe aber Angst, es mir aus der Nähe anzuschauen." —Rukarumel, Beobachtungskladde\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133128&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'237906c7-03d0-4690-b58e-4fa1c2339ba3\', \'multiverseId\': 133128}, \'multiverseid\': 133128}, {\'name\': \'Fragmentado de dos cabezas\', \'text\': \'Todos los Fragmentados tienen "Esta criatura no puede ser bloqueada excepto por dos o más criaturas".\', \'type\': \'Criatura — Fragmentado\', \'flavor\': \'"Lo que podría ser una mutación letal en cualquier otra especie es simplemente una fuente de nuevos poderes. Estoy intrigado, pero demasiado temeroso de examinarlo más de cerca." —Rúkarumel, diario de observación\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134633&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dd25141c-fb71-4f07-a940-24b4b95b2638\', \'multiverseId\': 134633}, \'multiverseid\': 134633}, {\'name\': \'Slivoïde à deux têtes\', \'text\': \'Tous les slivoïdes ont « Cette créature ne peut pas être bloquée excepté par deux créatures ou plus. »\', \'type\': \'Créature : slivoïde\', \'flavor\': "« Une mutation qui serait fatale pour toute autre espèce n\'est qu\'une nouvelle source de pouvoirs. Cela m\'intrigue, mais c\'est un peu trop dangereux pour que je l\'examine de plus près. » —Rukarumel, journal de recherches", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132827&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7f1800b8-6015-4fe9-a3c9-c29eeb3a668a\', \'multiverseId\': 132827}, \'multiverseid\': 132827}, {\'name\': \'Tramutante a Due Teste\', \'text\': \'Tutti i Tramutanti hanno "Questa creatura non può essere bloccata tranne che da due o più creature."\', \'type\': \'Creatura — Tramutante\', \'flavor\': \'"Quella che sarebbe una mutazione fatale in qualsiasi altra specie non è altro che una fonte di nuovi poteri. Sono incuriosito, ma troppo timoroso per esaminarla più da vicino." —Rukarumel, registro delle attività\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133429&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eaddc2e4-1fb3-41e5-88e8-b0dc6ace2986\', \'multiverseId\': 133429}, \'multiverseid\': 133429}, {\'name\': \'双頭スリヴァー\', \'text\': \'すべてのスリヴァーは「このクリーチャーは２体以上のクリーチャーにしかブロックされない。」の能力を持つ。\', \'type\': \'クリーチャー — スリヴァー\', \'flavor\': \'他の種族であれば致命的な突然変異でも、これらにとっては単なる新たな力の源に過ぎない。 興味はそそられるが、より近くで観察するのは恐ろしすぎることだ。 ――ルカルメルの観察日誌\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133730&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'40943d18-c009-4955-8e7a-06a5a402e814\', \'multiverseId\': 133730}, \'multiverseid\': 133730}, {\'name\': \'Fractius de Duas Cabeças\', \'text\': \'Todos os Fractius têm "Esta criatura só pode ser bloqueada por duas ou mais criaturas."\', \'type\': \'Criatura — Fractius\', \'flavor\': \'"O que seria uma mutação fatal em qualquer outra espécie é simplesmente uma fonte de novos poderes. Estou intrigado, embora muito temeroso para examiná-lo mais de perto." —Rukarumel, diário de campo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134031&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'93f65d45-d436-4e21-bfca-963464685fba\', \'multiverseId\': 134031}, \'multiverseid\': 134031}, {\'name\': \'Двухголовая Щепка\', \'text\': \'Все Щепки обладают способностью "Это существо не может быть блокировано меньше чем двумя существами."\', \'type\': \'Существо — Щепка\', \'flavor\': \'«Такая смертельная для любой другой популяции мутация может оказаться чистейшим источником новой силы. Я заинтригован, хотя все еще боюсь изучать их более близко», Рукарумель, полевой личный дневник\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134332&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dbc668f0-7f5d-4ac0-a880-5cdced2812d7\', \'multiverseId\': 134332}, \'multiverseid\': 134332}, {\'name\': \'双头裂片妖\', \'text\': \'所有裂片妖具有「此生物只能被两个或更多生物阻挡。」\', \'type\': \'生物～裂片妖\', \'flavor\': \'「对其他物种而言的致命突变，却是他们的新力量来源。 这令我好奇不已，但也让我不敢更靠近来调查。」 ～陆卡陆梅的现场日志\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132526&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4c3e58ff-57bf-483e-afab-127f23c59f79\', \'multiverseId\': 132526}, \'multiverseid\': 132526}]', '[{\'name\': \'Zyklopenriese\', \'text\': \'Wenn der Zyklopenriese aus dem Spiel auf einen Friedhof gelegt wird, wird ein Land deiner Wahl zu einem Sumpf. Entferne den Zyklopenriesen ganz aus dem Spiel.\', \'type\': \'Kreatur — Zombie, Riese\', \'flavor\': \'Ein Auge der Gruft kann für Jahrhunderte geschlossen sein. Es öffnet sich, wenn die Welt, die es sehen kann, so verdreht und leer wie der Schurke ist, der in der Gruft begraben liegt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132899&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7e1a8855-19be-4a8e-92d5-740c793c6518\', \'multiverseId\': 132899}, \'multiverseid\': 132899}, {\'name\': \'Gigante ciclópeo\', \'text\': \'Cuando el Gigante ciclópeo vaya a un cementerio desde el juego, el tipo de la tierra objetivo se convierte en pantano. Remueve del juego el Gigante ciclópeo.\', \'type\': \'Criatura — Gigante zombie\', \'flavor\': \'Un Ojo de Tumba puede permanecer cerrado por siglos. Se abre cuando ve un mundo torcido y hueco como el engendro bajo su párpado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134404&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'00b1f225-f876-426e-8d14-2b13cd2bb029\', \'multiverseId\': 134404}, \'multiverseid\': 134404}, {\'name\': \'Géant cyclopéen\', \'text\': \'Quand le Géant cyclopéen est mis dans un cimetière depuis le jeu, le terrain ciblé devient un marais. Retirez le Géant cyclopéen de la partie.\', \'type\': \'Créature : zombie et géant\', \'flavor\': "Un tombœil peut rester clos pendant des siècles. Il s\'ouvre quand il voit un monde aussi corrompu et creux que le misérable situé sous son couvercle.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132598&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7d0929d8-3f80-4122-a5d6-e6c851a92c2f\', \'multiverseId\': 132598}, \'multiverseid\': 132598}, {\'name\': \'Gigante Ciclope\', \'text\': \'Quando il Gigante Ciclope viene messo in un cimitero dal gioco, una terra bersaglio diventa una Palude. Rimuovi dal gioco il Gigante Ciclope.\', \'type\': \'Creatura — Gigante Zombie\', \'flavor\': \'Un occhio-sepolcro può rimanere chiuso per secoli. Si apre quando vede un mondo così distorto e vano come lo sventurato che giace sotto il suo coperchio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133200&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ef85802c-52a0-4a77-a932-298b8448745f\', \'multiverseId\': 133200}, \'multiverseid\': 133200}, {\'name\': \'隻眼の巨人\', \'text\': \'隻眼の巨人が場からいずれかの墓地に置かれたとき、土地１つを対象とする。その土地は沼になる。 隻眼の巨人をゲームから取り除く。\', \'type\': \'クリーチャー — ゾンビ・巨人\', \'flavor\': \'墳墓の眼が数世紀の間開かれないことは珍しくない。 それが開くのは、世界が己の蓋の下の者と同じほど捻じくれ、空ろであると知った時だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133501&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9797d868-8947-45af-8c73-0cc0c7f3449f\', \'multiverseId\': 133501}, \'multiverseid\': 133501}, {\'name\': \'Gigante Ciclópico\', \'text\': \'Quando Gigante Ciclópico é colocado no cemitério vindo do jogo, o terreno alvo torna-se um Pântano. Remova Gigante Ciclópico do jogo.\', \'type\': \'Criatura — Gigante Zumbi\', \'flavor\': \'Um olho-tumba pode permanecer fechado por séculos. Ele se abre quando vê um mundo tão distorcido e desprezível quanto o desgraçado sob sua pálpebra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133802&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4fbadc94-65ce-4f83-9af0-85c9db804b24\', \'multiverseId\': 133802}, \'multiverseid\': 133802}, {\'name\': \'Гигантский Циклоп\', \'text\': \'Когда Гигантский Циклоп попадает на кладбище из игры, целевая земля становится Болотом. Удалите Гигантского Циклопа из игры.\', \'type\': \'Существо — Зомби Гигант\', \'flavor\': \'Могильный глаз может быть закрытым веками. Он открывается только тогда, когда мир становится таким же бессмысленным и злым, как и то, что таится за его веком.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134103&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'24a82f45-b96d-40b0-bbea-baf59e8e0f00\', \'multiverseId\': 134103}, \'multiverseid\': 134103}, {\'name\': \'单眼巨人\', \'text\': \'当单眼巨人从场上置入坟墓场时，目标地成为沼泽。 将单眼巨人移出对战。\', \'type\': \'生物～灵俑／巨人\', \'flavor\': \'坟墓眼饰可以一连阖上几个世纪。 当它发现这世界与眼皮底下的卑劣者一样扭曲而空虚时，便将睁眼。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132297&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2ddf2ae6-3430-478a-96ae-9111e0550eb4\', \'multiverseId\': 132297}, \'multiverseid\': 132297}]', '[{\'name\': \'Ältester von Pendelhaven\', \'text\': \'{T}: Alle 1/1 Kreaturen, die du kontrollierst, erhalten +1/+2 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Elf, Schamane\', \'flavor\': \'Der Älteste, der den immer weitervererbten Mantel von Jacques le Vert trägt, übernimmt damit auch die Bürde von dessen Mission, die Kreaturen von Pendelhaven zu beschützen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133030&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'98fa8396-0510-4de4-b6cb-d4e61960916d\', \'multiverseId\': 133030}, \'multiverseid\': 133030}, {\'name\': \'Anciana de Pendelhaven\', \'text\': \'{T}: Cada criatura 1/1 que controlas obtiene +1/+2 hasta el final del turno.\', \'type\': \'Criatura — Chamán elfo\', \'flavor\': \'El anciano que lleva el manto ancestral de Jacques le Vert carga también con su antigua misión: proteger a las criaturas de Pendelhaven.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134535&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1017fde3-fd57-462b-b687-98f200a2ae6d\', \'multiverseId\': 134535}, \'multiverseid\': 134535}, {\'name\': \'Doyenne de Pendelhavre\', \'text\': "{T} : Chaque créature 1/1 que vous contrôlez gagne +1/+2 jusqu\'à la fin du tour.", \'type\': \'Créature : elfe et shamane\', \'flavor\': \'Quiconque endosse la responsabilité ancestrale de Jacques le Vert doit continuer son ancienne mission : protéger les créatures de Pendelhavre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132729&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6c4f64cb-173d-46ba-8dfe-95e892ad3785\', \'multiverseId\': 132729}, \'multiverseid\': 132729}, {\'name\': \'Anziana di Pendelhaven\', \'text\': \'{T}: Ogni creatura 1/1 che controlli prende +1/+2 fino alla fine del turno.\', \'type\': \'Creatura — Sciamano Elfo\', \'flavor\': "L\'anziana che porta il manto ancestrale di Jacques le Vert è incaricata della di lui antica missione: proteggere le creature di Pendelhaven.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133331&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'de1b3524-66b8-4779-8496-bddf51a8d3b4\', \'multiverseId\': 133331}, \'multiverseid\': 133331}, {\'name\': \'ペンデルヘイヴンの古老\', \'text\': \'{T}：あなたがコントロールする各１/１クリーチャーは、それぞれターン終了時まで＋１/＋２の修整を受ける。\', \'type\': \'クリーチャー — エルフ・シャーマン\', \'flavor\': \'ジャック・ル・ヴェールの古きマントを負うその古老は、古き使命をも携え続けている。ペンデルヘイヴンの生き物を守ることだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133632&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'506d3aab-f143-42ce-8bcd-11ed0b6cf588\', \'multiverseId\': 133632}, \'multiverseid\': 133632}, {\'name\': \'Ancião de Pendelhaven\', \'text\': \'{T}: Cada criatura 1/1 que você controla recebe +1/+2 até o final do turno.\', \'type\': \'Criatura — Xamã Elfo\', \'flavor\': \'O ancião que carrega o manto ancestral de Jacques le Vert está incumbido de sua missão ancestral: proteger as criaturas de Pendelhaven.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133933&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dce3f61e-c864-43eb-ad7f-b3097916fab4\', \'multiverseId\': 133933}, \'multiverseid\': 133933}, {\'name\': \'Старец из Пендельхейвена\', \'text\': \'{T}: Все существа 1/1 под вашим контролем получают +1/+2 до конца хода.\', \'type\': \'Существо — Эльф Шаман\', \'flavor\': \'Старец, что нес родовую мантию Жака ле Верта, был посвящен своей древней миссии: защищать творенья Пендальхевена.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134234&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a9321bf9-2615-466f-ace4-be5270ab8924\', \'multiverseId\': 134234}, \'multiverseid\': 134234}, {\'name\': \'潘得庇护地长老\', \'text\': \'{T}：每个由你操控的1/1生物得+1/+2直到回合结束。\', \'type\': \'生物～地精／祭师\', \'flavor\': \'披上碧友贾克传世披风的长老，都继承他的长远使命：保护潘得庇护地之生灵。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132428&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7aa3dd8d-5b34-4e20-8c62-b4e34a81375f\', \'multiverseId\': 132428}, \'multiverseid\': 132428}]', '[{\'name\': \'Äthernetz\', \'text\': \'Aufblitzen (Du kannst diesen Zauberspruch zu jedem Zeitpunkt spielen, zu dem du einen Spontanzauber spielen könntest.)Kreaturenverzauberung\\nDie verzauberte Kreatur erhält +1/+1, kann blocken, als ob sie Flugfähigkeit hätte, und kann Kreaturen mit Irrealität blocken, als ob diese nicht Irrealität hätten.\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132855&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b043105d-7d6d-4a27-9a7f-756ad89987bf\', \'multiverseId\': 132855}, \'multiverseid\': 132855}, {\'name\': \'Telaraña de éter\', \'text\': \'Destello (Puedes jugar este hechizo en cualquier momento en que pudieras jugar un instantáneo.)\\nEncantar criatura.\\nLa criatura encantada obtiene +1/+1, puede bloquear como si tuviera la habilidad de volar y puede bloquear criaturas que se desvanecen como si no tuvieran la habilidad de desvanecerse.\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134360&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6ebb14d8-2106-4997-af74-79a5bb714329\', \'multiverseId\': 134360}, \'multiverseid\': 134360}, {\'name\': "Toile d\'Aether", \'text\': "Flash (Vous pouvez jouer ce sort à tout moment où vous pourriez jouer un éphémère.)\\nEnchanter : créature\\nLa créature enchantée gagne +1/+1, peut bloquer comme si elle avait le vol, et peut bloquer les créatures avec la distorsion comme si elles n\'avaient pas la distorsion.", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132554&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e36189c7-e1f5-45ee-8527-ae3c5975cad8\', \'multiverseId\': 132554}, \'multiverseid\': 132554}, {\'name\': \'Ragnatela Eterea\', \'text\': \'Lampo (Puoi giocare questa magia in ogni momento in cui potresti giocare un istantaneo.)\\nIncanta creatura\\nLa creatura incantata prende +1/+1, può bloccare come se avesse volare e può bloccare le creature con ombra come se non avessero ombra.\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133156&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8ca895e3-d715-4b3d-bb69-8b6f1dc42dfc\', \'multiverseId\': 133156}, \'multiverseid\': 133156}, {\'name\': \'霊気の網\', \'text\': \'瞬速 （あなたはこの呪文を、あなたがインスタントをプレイできるときならいつでもプレイしてよい。）\\nエンチャント（クリーチャー）\\nエンチャントされているクリーチャーは＋１/＋１の修整を受けるとともに、飛行を持つかのようにブロックでき、シャドーを持つクリーチャーを、それらがシャドーを持たないかのようにブロックできる。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133457&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0be3e021-826a-468e-b68b-050a1815dbb6\', \'multiverseId\': 133457}, \'multiverseid\': 133457}, {\'name\': \'Teia Etérea\', \'text\': \'Lampejo (Você poderá jogar esta mágica a qualquer momento em que puder jogar uma mágica instantânea.)\\nEncantar Criatura\\nA criatura encantada recebe +1/+1, pode bloquear como se tivesse a habilidade de voar e pode bloquear criaturas com sombra como se não tivessem sombra.\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133758&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8a9a67c4-2f02-47b1-8d75-31916be1b18a\', \'multiverseId\': 133758}, \'multiverseid\': 133758}, {\'name\': \'Эфирная Паутина\', \'text\': \'Миг (Вы можете играть это заклинание в любое время, когда вы можете играть мгновенные заклинания.)\\nЗачаровать существо\\nЗачарованное существо получает +1/+1, может блокировать как будто оно имеет полет и может блокировать существа с тенью как будто они не имеют тени.\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134059&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'72506c93-72f3-48eb-9c9f-9c6d019bb7dd\', \'multiverseId\': 134059}, \'multiverseid\': 134059}, {\'name\': \'乙太网\', \'text\': \'闪现（你可以于你能够使用瞬间的时机下使用此咒语。）\\n生物结界\\n受此结界的生物得+1/+1，能视同具飞行异能地进行阻挡，且对于具次元幽影异能的生物，此生物能将后者视同不具该异能地进行阻挡。\', \'type\': \'结界～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132253&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'790b4ec6-a43f-4b0c-a685-b358242fca4c\', \'multiverseId\': 132253}, \'multiverseid\': 132253}]']
printings: ['10E', '2ED', '2X2', '2XM', '30A', '3ED', '40K', '4BB', '4ED', '5ED', '6ED', '7ED', '8ED', '9ED', 'A25', 'AFC', 'AFR', 'AKH', 'AKR', 'ALA', 'ANA', 'ANB', 'ARC', 'ARN', 'ATH', 'AVR', 'BBD', 'BFZ', 'BLB', 'BNG', 'BRB', 'BRC', 'BRO', 'BRR', 'BTD', 'C13', 'C14', 'C15', 'C16', 'C17', 'C18', 'C19', 'C20', 'C21', 'CED', 'CEI', 'CHK', 'CLB', 'CLU', 'CM2', 'CMA', 'CMD', 'CMM', 'CMR', 'CN2', 'CNS', 'CST', 'DD1', 'DD2', 'DDC', 'DDD', 'DDE', 'DDF', 'DDG', 'DDH', 'DDI', 'DDJ', 'DDK', 'DDL', 'DDM', 'DDN', 'DDO', 'DDP', 'DDQ', 'DDR', 'DDS', 'DDT', 'DDU', 'DKM', 'DMC', 'DMR', 'DMU', 'DOM', 'DPA', 'DRB', 'DTK', 'DVD', 'E01', 'E02', 'ELD', 'EMA', 'EVG', 'F10', 'F12', 'FBB', 'FRF', 'G17', 'GK1', 'GK2', 'GN2', 'GN3', 'GNT', 'GRN', 'GS1', 'GVL', 'H09', 'HA1', 'HA3', 'HA4', 'HA5', 'HBG', 'HOP', 'HOU', 'ICE', 'IKO', 'IMA', 'INV', 'ISD', 'ITP', 'J14', 'J22', 'JMP', 'JVC', 'KHC', 'KHM', 'KLD', 'KLR', 'KTK', 'LCC', 'LCI', 'LEA', 'LEB', 'LRW', 'LTC', 'LTR', 'M10', 'M11', 'M12', 'M13', 'M14', 'M15', 'M19', 'M20', 'M21', 'MBS', 'MD1', 'ME1', 'ME3', 'MH2', 'MH3', 'MIC', 'MID', 'MIR', 'MKC', 'MKM', 'MM2', 'MM3', 'MMA', 'MMQ', 'MOC', 'MOM', 'MPS', 'MRD', 'NCC', 'NEO', 'NPH', 'ODY', 'OLEP', 'ONC', 'ONE', 'ONS', 'ORI', 'OTC', 'OTJ', 'P02', 'P10', 'P23', 'PAL00', 'PAL01', 'PAL02', 'PAL03', 'PAL04', 'PAL05', 'PAL06', 'PAL99', 'PALP', 'PANA', 'PARL', 'PC2', 'PCA', 'PCMP', 'PD2', 'PD3', 'PDGM', 'PELP', 'PF19', 'PF20', 'PGPX', 'PGRU', 'PHUK', 'PIDW', 'PIP', 'PL24', 'PLST', 'PMPS', 'PMPS06', 'PMPS07', 'PMPS08', 'PMPS09', 'PMPS10', 'PMPS11', 'POR', 'PPP1', 'PRES', 'PRM', 'PRW2', 'PRWK', 'PS11', 'PSAL', 'PSS2', 'PSS3', 'PSS4', 'PTC', 'PTK', 'PTSP', 'PTSR', 'PZ1', 'PZ2', 'RAV', 'REX', 'RIX', 'RNA', 'ROE', 'RQS', 'RTR', 'S99', 'SCD', 'SHM', 'SIR', 'SLC', 'SLD', 'SNC', 'SOI', 'SOM', 'STA', 'STX', 'SUM', 'TD0', 'TD2', 'THB', 'THS', 'TMP', 'TPR', 'TSP', 'TSR', 'UGL', 'UMA', 'UND', 'UNF', 'UNH', 'USG', 'UST', 'V11', 'V12', 'VOW', 'WAR', 'WC00', 'WC01', 'WC02', 'WC03', 'WC04', 'WC97', 'WC98', 'WC99', '