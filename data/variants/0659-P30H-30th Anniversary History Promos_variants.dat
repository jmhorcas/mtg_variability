rulings: ['[{\'date\': \'2007-07-15\', \'text\': "If Sengir Vampire deals nonlethal damage to a creature and then a different effect or damage source causes that creature to be put into a graveyard later in the turn, Sengir Vampire\'s ability will trigger and it will get a +1/+1 counter."}, {\'date\': \'2011-09-22\', \'text\': "Each time a creature is put into a graveyard from the battlefield, check whether Sengir Vampire had dealt any damage to it at any time during that turn. If so, Sengir Vampire\'s ability will trigger. It doesn\'t matter who controlled the creature or whose graveyard it was put into."}, {\'date\': \'2011-09-22\', \'text\': "If Sengir Vampire and a creature it dealt damage to are both put into a graveyard at the same time, Sengir Vampire\'s ability will trigger, but it will do nothing when it resolves."}]']
