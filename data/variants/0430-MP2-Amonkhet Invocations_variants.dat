mana_cost: ['{0}', '{1}{B}', '{1}{B}{B}', '{1}{B}{G}', '{1}{U}', '{1}{U}{U}', '{1}{U}{U}{U}', '{1}{W}', '{1}{W}{B}', '{2}{B}', '{2}{B}{B}', '{2}{G}', '{2}{R}', '{2}{R}{R}', '{2}{U}', '{2}{U}{U}', '{2}{W}', '{2}{W}{W}', '{3}{B}{B}', '{3}{B}{G}', '{3}{B}{R}', '{3}{R}', '{3}{U}{B}', '{3}{U}{U}', '{3}{W}', '{4}{R}', '{4}{U}{R}', '{4}{U}{U}', '{4}{W}{W}', '{6}{B}{B}', '{7}{U}{U}{U}', '{B}', '{B}{B}{B}', '{R}', '{U}', '{U}{U}', '{X}{B}']
