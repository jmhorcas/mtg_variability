pe': 'Beschwörung eines Zwergs', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '9f3d41a9-9876-4d4d-be59-91586fceb14e'}, 'multiverseid': None}, {'name': 'Comerciante enano', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'a83d6de8-bc33-48a3-a487-ca4c49c5ef10'}, 'multiverseid': None}, {'name': 'Marchande naine', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '452e4c21-d596-4621-a915-82b4c1804958'}, 'multiverseid': None}, {'name': 'Nano Mercante', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '100f1d05-f64f-45c8-a9ff-834347d48017'}, 'multiverseid': None}, {'name': 'Comerciante Anão', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2e965bc7-4543-41ae-8247-e301003202b9'}, 'multiverseid': None}]", "[{'name': 'Zwergenpony', 'text': '{1}{R}, {T}: Ein Zwerg Deiner Wahl erhält die Fähigkeit Gebirgstarnung bis zum Ende des Zuges.', 'type': 'Beschwörung eines Ponys', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'd2d547e9-a1af-4389-8f9f-21aea2d389d3'}, 'multiverseid': None}, {'name': 'Poni enano', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'acc84abc-b8f2-4fbf-8fd8-ac8abbd2f4a6'}, 'multiverseid': None}, {'name': 'Poney des nains', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'a8025c7d-5ca5-4ec3-b853-016cd1ad51ca'}, 'multiverseid': None}, {'name': 'Pony dei Nani', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'a4697de6-97ee-4e3e-9708-8169e4fcdf17'}, 'multiverseid': None}, {'name': 'Pônei do Anão', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8bf265f0-4016-4ddb-b4d2-03d0c8d08d13'}, 'multiverseid': None}]", "[{'name': 'Zwergischer Seefahrerclan', 'text': '{T}: Am Ende des Kampfes fügt der Seefahrerclan einer angreifenden oder blockenden Kreatur Deiner Wahl 2 Schadenspunkte zu. Benutze diese Fähigkeit nur dann, wenn der Beherrscher dieser Kreatur Inseln beherrscht.', 'type': 'Beschwörung von Zwergen', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '6a1ca951-6c4d-4f7f-9ab9-a3f2e5757008'}, 'multiverseid': None}, {'name': 'Clan de enanos del mar', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'cfe05f78-53f8-4925-989c-5f270f794f37'}, 'multiverseid': None}, {'name': 'Clan des mariniers nains', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'e2d4c8d2-51a2-4eb3-b0c7-1cc816bb977c'}, 'multiverseid': None}, {'name': 'Clan dei Nani di Mare', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '6a9795e9-245d-40bc-b865-11e7cf7e584d'}, 'multiverseid': None}, {'name': 'Anoes dos Clãs Marítimos', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '35ad5c0d-ad7d-4841-b66a-06fc1457141c'}, 'multiverseid': None}]", '[{\'name\': \'Äthersturm\', \'text\': \'Es können keine Beschwörungszauber mehr gesprochen werden.\\nJeder Spieler kann 4 Lebenspunkte bezahlen, um den Äthersturm zu begraben. Effekte, die Schaden verhindern oder umleiten, können hier nicht angewendet werden, um den Verlust der Lebenspunkte zu verhindern.\', \'type\': \'Verzauberung\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2760d255-99c3-4ef3-8b55-77bec2866c53\'}, \'multiverseid\': None}, {\'name\': \'Tormenta del éter\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'641debf8-76c2-4f1c-9f4d-f21b2198486b\'}, \'multiverseid\': None}, {\'name\': "Tempête d\'Aether", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e06a2cf2-c8b9-429c-a2ef-55284ac5e82c\'}, \'multiverseid\': None}, {\'name\': "Tempesta dell\'Etere", \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cb7b87e1-cb14-469c-91a6-d11fb961fe14\'}, \'multiverseid\': None}, {\'name\': \'Tempestade do Æter\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6ea04710-c474-4665-9990-0d8997ef1a15\'}, \'multiverseid\': None}]']
