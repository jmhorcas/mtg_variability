'multiverseid': None}]", '[{\'name\': \'Oberin der Abtei\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7d2478ac-f822-40b5-8d42-940c1198931b\'}, \'multiverseid\': None}, {\'name\': \'Abadesa\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'075a8809-e83d-4200-8486-ec4c1edffccf\'}, \'multiverseid\': None}, {\'name\': \'Mère abbesse\', \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fc02889e-19e1-43ee-b66b-d234c652d70f\'}, \'multiverseid\': None}, {\'name\': "Matrona dell\'Abbazia", \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b36f4bc4-8379-45a0-99fb-771e6f4889ba\'}, \'multiverseid\': None}, {\'name\': \'Matrona da Abadia\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'44111570-4029-44f6-877e-8adaa8263bbc\'}, \'multiverseid\': None}]', '[{\'name\': \'Oberin der Abtei\', \'text\': \'{W}, {T}: +0/+3 bis zum Ende des Zuges.\', \'type\': \'Beschwörung einer Klerikerin\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'017c1406-09d9-4e65-96fc-bda3d36090ec\'}, \'multiverseid\': None}, {\'name\': \'Abadesa\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'37ea44dc-2baf-4cd3-9b02-077946edc18e\'}, \'multiverseid\': None}, {\'name\': \'Mère abbesse\', \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1bf983e1-7d37-4e61-bd2f-487f51effb85\'}, \'multiverseid\': None}, {\'name\': "Matrona dell\'Abbazia", \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'36cab2a5-41d6-4cc9-9f9a-46326f211605\'}, \'multiverseid\': None}, {\'name\': \'Matrona da Abadia\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d7035d42-f59d-4a8a-9aef-7f20694f6ed9\'}, \'multiverseid\': None}]', "[{'name': 'Orkmine', 'text': 'Lege drei Erz-Marken auf die Orkmine, wenn sie ins Spiel kommt. Entferne eine Erz-Marke in Deiner Versorgungsphase und immer, wenn das verzauberte Land getappt wird. Wenn die letzte Erz-Marke entfernt ist, zerstöre das verzauberte Land, und die Orkmine fügt dem Beherrscher des Landes 2 Schadenspunkte zu.', 'type': 'Verzaubere Land', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '2f0eded1-bd57-4cac-b454-1dd3dfb7126a'}, 'multiverseid': None}, {'name': 'Mina orca', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'a577d058-eaf6-4de7-b2ff-1ee8c0eb91e3'}, 'multiverseid': None}, {'name': 'Mine orque', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '6cbcc2c2-6e78-43a3-99cc-f84332a62f8d'}, 'multiverseid': None}, {'name': 'Miniera degli Orchi', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '447c35fa-1e3d-4fc5-adfc-7ee6c5c4cdd3'}, 'multiverseid': None}, {'name': 'Mina órquica', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd89fb2b6-2f41-449a-a904-1d4ee0cc90c2'}, 'multiverseid': None}]", "[{'name': 'Prophezeiung', 'text': 'Zeige allen Spielern die oberste Karte der Bibliothek eines Gegners Deiner Wahl. Wenn es ein Land ist, erhältst Du einen Lebenspunkt dazu. Dieser Gegner mischt danach seine Bibliothek. Ziehe eine Karte während der nächsten Versorgungsphase.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '2e6da12d-7b82-4886-af07-171c4f420b2c'}, 'multiverseid': None}, {'name': 'Profecía', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'de9dbecf-8d35-4d29-8a4a-9c7b9cbcbb3a'}, 'multiverseid': None}, {'name': 'Prophétie', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'a7b6a8e7-1d8f-485b-8bd3-c8b0df9fae34'}, 'multiverseid': None}, {'name': 'Profezia', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'c2ac4c33-19a1-41a9-8df0-f81bbe7b831b'}, 'multiverseid': None}, {'name': 'Profecia', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e7c329c7-5891-4cd2-a93c-b3f440bf2623'}, 'multiverseid': None}]", "[{'name': 'Rashka, die Schlächterin', 'text': 'Kann fliegende Kreaturen blocken.\\nWenn sie zum Blocken schwarzer Kreaturen deklariert wird, erhält Rashka +1/+2 bis zum Ende des Zuges.', 'type': 'Beschwörung einer Legende', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '223dd04a-bf09-4c9e-b2f7-4f6ac9270fba'}, 'multiverseid': None}, {'name': 'Rashka la Destructora', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '4167dbc9-d253-4fc9-9ce0-c7cf2fdbd257'}, 'multiverseid': None}, {'name': 'Rashka la tueuse', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '79bf2786-c40a-4eb2-a40d-1def780d6335'}, 'multiverseid': None}, {'name': 'Rashka, la Carnefice', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '021c352e-b059-4ee1-a7bd-b0563df2eaba'}, 'multiverseid': None}, {'name': 'Rashka, a Matadora', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '30a0cc0d-28eb-4f2c-aa3d-3caeaa2fa2e9'}, 'multiverseid': None}]", "[{'name': 'Reveka, Gelehrte Zauberin', 'text': '{T}: Reveka fügt einer Kreatur oder einem Spieler Deiner Wahl 2 Schadenspunkte zu. Reveka enttappt nicht während Deiner nächsten Enttap-Phase.', 'type': 'Beschwörung einer Legende', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'e7502ae8-fcc3-44ac-9c05-0465bc66421e'}, 'multiverseid': None}, {'name': 'Reveka, Hechiccera Decana', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '79b8c5db-e03d-4da5-8d8a-25d8f4bf8f22'}, 'multiverseid': None}, {'name': 'Reveka, SajMage', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '1fc71f93-7927-47ec-adbd-124f918afcc2'}, 'multiverseid': None}, {'name': 'Reveka, Maga Sapiente', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '216e266f-ef10-4b63-8d58-293228a2e361'}, 'multiverseid': None}, {'name': 'Reveka, Maga Sábia', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '76e3c3d1-9f2a-46d4-ad03-f470009c1534'}, 'multiverseid': None}]", "[{'name': 'Riesenalbatros', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '86d3a89c-1dce-4fe9-85f7-e1ea3992a730'}, 'multiverseid': None}, {'name': 'Albatros gigante', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '8287a391-932e-4144-8641-68bb94c084f1'}, 'multiverseid': None}, {'name': 'Albatros géant', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '76ee2e5d-4812-46e4-a38e-e099bb7c829e'}, 'multiverseid': None}, {'name': 'Albatro Gigante', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '36514e39-4f17-4b35-9c58-5d45361d0a36'}, 'multiverseid': None}, {'name': 'Albatroz Gigante', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '55593f3d-c43b-4b27-a409-39cab87ade65'}, 'multiverseid': None}]", "[{'name': 'Riesenalbatros', 'text': 'Kann fliegen.\\n{1}{U}: Begrabe alle Kreaturen, die den Riesenalbatros in diesem Zug verletzt haben. Der Beherrscher dieser Kreaturen kann dies verhindern, indem er 2 Lebenspunkte pro Kreatur, die nicht begraben werden soll, bezahlt. Effekte, die Schaden verhindern oder umleiten, können hier nicht angewendet werden, um den Verlust der Lebenspunkte zu verhindern. Benutze diese Eigenschaft nur, wenn der Riesenalbatros aus dem Spiel auf dem Friedhof landet.', 'type': 'Beschwörung eines Albatrosses', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'df76f545-f281-4639-8e80-deebec6bf60c'}, 'multiverseid': None}, {'name': 'Albatros gigante', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'da2225ba-17bd-40b5-96c4-9347ab74e14d'}, 'multiverseid': None}, {'name': 'Albatros géant', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '544cb932-77de-489c-9030-365ed017b5b3'}, 'multiverseid': None}, {'name': 'Albatro Gigante', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '1301ca3b-e744-450d-a564-8fb577eb7555'}, 'multiverseid': None}, {'name': 'Albatroz Gigante', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c0026ab7-7800-4ad6-aee4-a76ff057d984'}, 'multiverseid': None}]", "[{'name': 'Riesenauster', 'text': 'Du kannst wählen, ob Du die Riesenauster während Deiner Enttap-Phase enttappt oder nicht.\\n{T}: Die getappte Zielkreatur enttappt nicht während der Enttap-Phase ihres Beherrschers, solange die Riesenauster getappt ist. Lege während Deiner Versorgungsphase eine -1/-1-Spielmarke auf diese Kreatur. Entferne alle diese -1/-1-Spielmarken von der Zielkreatur, wenn die Riesenauster enttappt wird oder das Spiel verlässt.', 'type': 'Beschwörung einer Auster', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '3d9ab46f-5063-4e0a-a56c-82261e3d51d0'}, 'multiverseid': None}, {'name': 'Ostra gigante', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'fa475241-c245-48da-801c-9ff514a0d353'}, 'multiverseid': None}, {'name': 'Huître géante', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '212db75c-9f05-4433-a03d-53b76a33f1d0'}, 'multiverseid': None}, {'name': 'Ostrica Gigante', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'b71868c9-3752-4a0b-be7d-594d91ddd654'}, 'multiverseid': None}, {'name': 'Ostra Gigante', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '978cf9ce-be6e-4daf-a417-5798e85e9f74'}, 'multiverseid': None}]", "[{'name': 'Riffpiraten', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '1f31c0f7-e1a9-41bf-9178-61e57f8beb58'}, 'multiverseid': None}, {'name': 'Piratas de los arrecifes', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '648574bb-85a1-4d01-a8f2-6f48084df97d'}, 'multiverseid': None}, {'name': 'Pirates des brisants', 'flavor'