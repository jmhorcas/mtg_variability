ne, 'language': 'Italian', 'identifiers': {'scryfallId': '8268fd6d-d684-4603-a65f-302fb48babde'}, 'multiverseid': None}, {'name': 'Trégua', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f3bfed3b-3d88-4b61-8d30-c1a340f8a366'}, 'multiverseid': None}]", "[{'name': 'Weidenfee', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '26ae7da0-1329-4c90-b86e-406a7e883434'}, 'multiverseid': None}, {'name': 'Hada de Sauce', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '6c6b4d0a-0d97-4252-8161-ff0d67a9803c'}, 'multiverseid': None}, {'name': 'Fée de Saule', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '1bc220bf-09f6-4ecc-a5d6-6750943a5a57'}, 'multiverseid': None}, {'name': 'Spiritello del Salice', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '03fe735a-0b59-46ee-9b00-b67ab9636760'}, 'multiverseid': None}, {'name': 'Sílfide da Sálix', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '65eaf95a-0c09-4198-9dc6-486c73866bb2'}, 'multiverseid': None}]", "[{'name': 'Weidenfee', 'text': 'Kann Fliegen', 'type': 'Beschwörung eines Feenwesens', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'f5199bdc-56d1-48fe-a4f4-b9d043b3fac2'}, 'multiverseid': None}, {'name': 'Hada de Sauce', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'ab446edb-b563-4344-999b-5ac166db99f1'}, 'multiverseid': None}, {'name': 'Fée de Saule', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '8d64740a-b8b3-4ba4-8561-7799ac70e155'}, 'multiverseid': None}, {'name': 'Spiritello del Salice', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'b60dbab9-28f4-4354-9727-b8222649d015'}, 'multiverseid': None}, {'name': 'Sílfide da Sálix', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '68dd58d2-1903-474a-b453-4a0f0e3df76e'}, 'multiverseid': None}]", "[{'name': 'Weidenpriesterin', 'text': '{T}: Nimm ein Feenwesen von Deiner Hand und bringe es direkt ins Spiel. Behandle diese Kreatur, als wäre sie gerade beschworen worden.\\n{2}{G}: Eine grüne Zielkreatur erhält Schutz vor schwarz bis zum Ende des Zuges.', 'type': 'Beschwörung eines Feenwesens', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '04ce2b57-4f45-47ca-9df8-9d6df8e01909'}, 'multiverseid': None}, {'name': 'Sacerdotisa de Sauce', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '6472b6ae-7232-4013-978e-313b0c768c9b'}, 'multiverseid': None}, {'name': 'Prêtresse de Saule', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'e29dc46e-1bed-4f8a-a138-8c72f029fda4'}, 'multiverseid': None}, {'name': 'Sacerdotessa del Salice', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'c22834f0-1b52-43cb-9288-54bfdbdedc29'}, 'multiverseid': None}, {'name': 'Sacerdotisa de Sálix', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c8c9f661-b421-4daa-b7ad-e458f77b2f1d'}, 'multiverseid': None}]", "[{'name': 'Winterhimmel', 'text': 'Wirf eine Münze; ein Gegner Deiner Wahl wählt Kopf oder Zahl, während die Münze in der Luft ist. Wenn der Wurf zu Deinen Gunsten ausgeht, fügt der Winterhimmel jeder Kreatur und jedem Spieler 1 Schadenspunkt zu. Andernfalls zieht jeder Spieler eine Karte.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '096fb39f-8282-407c-aab6-8a5c7a92db03'}, 'multiverseid': None}, {'name': 'Cielo invernal', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '4fb047e3-3826-4e6f-85aa-b5f5903cef32'}, 'multiverseid': None}, {'name': 'Ciel hivernal', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '14e375f5-2967-4968-a477-a96d77aceb33'}, 'multiverseid': None}, {'name': 'Cielo Invernale', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '059d9943-b6db-4898-9dfd-7213ada0ba78'}, 'multive