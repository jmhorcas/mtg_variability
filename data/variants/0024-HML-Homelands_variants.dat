an\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'60937f26-db72-4ae6-980c-6ab8c3bf5aa5\'}, \'multiverseid\': None}]', "[{'name': 'Irini Sengir', 'text': 'Das Sprechen weißer und grüner Verzauberungen verteuert sich um 2.', 'type': 'Beschwörung einer Legende', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '30dff4cf-a328-4faf-8470-9c77b6ba3fc3'}, 'multiverseid': None}, {'name': 'Irini Sengir', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '46d65260-6efc-48e7-ab60-e144b89b1214'}, 'multiverseid': None}, {'name': 'Irini Sengir', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'e22fb578-c468-4418-8a17-056a4c4e67fc'}, 'multiverseid': None}, {'name': 'Irina Sengir', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '3281ef1e-b636-4711-a4a1-1557c90aa28f'}, 'multiverseid': None}, {'name': 'Irini Sengir', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '59f4ae2f-3b88-41e5-b48f-567fc3228594'}, 'multiverseid': None}]", "[{'name': 'Jinx', 'text': 'Das Zielland wird zu einem Standardland Deiner Wahl bis zum Ende des Zuges. Ziehe eine Karte am Beginn der Versorgungsphase des nächsten Zuges.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'f3cb0f06-3f34-4ec3-8aa2-a50db1c85c00'}, 'multiverseid': None}, {'name': 'Maleficio', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '3c86c376-1eea-4dc8-a75d-0b7264943e53'}, 'multiverseid': None}, {'name': 'Mauvaise passe', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'bacf4acf-0047-4d88-93c4-c0561a2644db'}, 'multiverseid': None}, {'name': 'Iettatura', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '5535df70-656c-49d0-b301-a278e7b5f199'}, 'multiverseid': None}, {'name': 'Simpatia Nefasta', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a47