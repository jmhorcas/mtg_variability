nguage': 'French', 'identifiers': {'scryfallId': 'ca6a8789-4e02-4779-a126-ed9acdadbb3c'}, 'multiverseid': None}, {'name': 'Cascate di Koskun', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '11a1a24f-2970-419b-9630-e01835b0437b'}, 'multiverseid': None}, {'name': 'Cataratas de Koskun', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e97ca20e-1807-4b04-a80b-aa4942788114'}, 'multiverseid': None}]", "[{'name': 'Labyrinthminotaurus', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '567b57ea-edb0-4801-ad1a-84d4fe54b6b1'}, 'multiverseid': None}, {'name': 'Minotauro del Laberinto', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'd4b62e87-15ae-4aff-9488-102de273e1fe'}, 'multiverseid': None}, {'name': 'Minotaure des labyrinthes', 'text': 'Les créatures que le Minotaure des labyrinthes est désigné pour bloquer ne se dégagent pas pendant la prochaine phase de dégagement de leur contrôleur.', 'type': 'Invoquer: minotaure', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'dcb151ad-8e00-4d63-9d60-dca19435f571'}, 'multiverseid': None}, {'name': 'Minotauro del Labirinto', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'b59351c6-7fef-4d81-bdb8-d9e8d090cb89'}, 'multiverseid': None}, {'name': 'Minotauro do Labirinto', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0764cf50-c06b-4a1d-b929-43a3c6654e41'}, 'multiverseid': None}]", "[{'name': 'Labyrinthminotaurus', 'text': 'Alle Kreaturen, die zu blocken der Labyrinthminotaurus deklariert ist, enttappen nicht während der nächsten Enttap-Phase ihres Beherrschers.', 'type': 'Beschwörung eines Minotaurus', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'e1e03a2a-b6cb-4f99-b80e-c134fb7a5076'}, 'multiverseid': None}, {'name': 'Minotauro del Laberinto', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '2508bc05-85da-4df9-98e8-6d24fc6