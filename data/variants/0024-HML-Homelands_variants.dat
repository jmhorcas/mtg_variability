482-4e0e-a183-cc71b6d5a9eb'}, 'multiverseid': None}, {'name': 'Escarmoucheurs', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '0181f5d1-e62d-4201-a0bc-d914a014a079'}, 'multiverseid': None}, {'name': 'Banda di Assalitori', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '7108c82d-ff88-4d72-8a64-993b086d9c74'}, 'multiverseid': None}, {'name': 'Grupo de Emboscada', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '163ee31b-82f7-4565-9285-0a8fe7558785'}, 'multiverseid': None}]", "[{'name': 'Mammut-Zaumzeug', 'text': 'Die verzauberte Kreatur verliert ihre Flugfähigkeit. Wenn eine andere Kreatur deklariert wird, die verzauberte Kreatur zu blocken oder die verzauberte Kreatur zum Blocken einer anderen Kreatur deklariert wird, erhält diese andere Kreatur Erstschlag bis zum Ende des Zuges.', 'type': 'Verzaubere Kreatur', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '2ba22150-3456-4f6a-be2d-4a516420401b'}, 'multiverseid': None}, {'name': 'Arnés de mamut', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '0cc60561-e727-4b15-b712-041cd0032f62'}, 'multiverseid': None}, {'name': 'Harnachement de mammouth', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'f9b1bbb8-8ef7-40df-8143-244f02b613de'}, 'multiverseid': None}, {'name': 'Finimenti dei Mammut', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '0d10f76d-fc21-4a9d-ba1e-091f8570a9ae'}, 'multiverseid': None}, {'name': 'Arreio de Mamute', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fdb161e5-006f-445f-88e3-31468b7f73dd'}, 'multiverseid': None}]", '[{\'name\': \'Marjhan\', \'text\': \'Entappt nicht während Deiner Entapp-Phase. Marjhan kann nicht angreifen, wenn der verteidigende Spieler keine Inseln im Spiel hat. Wenn Du zu irgendeinem Zeitpunkt keine Inseln mehr beherrschst, begrabe Marjhan.\\n{U}{U}: Opfere eine Kreatur, um Marjhan zu entappen. Benutze diese Fähigkeit nur während Deiner Versorgungsphase.\\n{U}{U}: -1/-0 bis zum Ende des Zuges. Marjhan fügt einer nichtfliegenden angreifenden Zielkreatur 1 Schadenspunkt zu.\', \'type\': \'Beschwörung einer Schlange\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'86bb3682-7201-446a-9999-ed57bcc275db\'}, \'multiverseid\': None}, {\'name\': \'Marjhán\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d161fc06-be92-4674-80c5-26a699d42d84\'}, \'multiverseid\': None}, {\'name\': "Mar\'djhân", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f09173af-f0ff-4e14-a130-a0ec5715a0c6\'}, \'multiverseid\': None}, {\'name\': \'Marjhan\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8a77c269-7c15-4bcf-a0da-6c9543957c9f\'}, \'multiverseid\': None}, {\'name\': \'Marjhan\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1d33ab14-cf0d-4122-b88b-ab3e1981b33b\'}, \'multiverseid\': None}]', "[{'name': 'Mechanische Gnome', 'text': '3, {T}: Regeneriere eine Zielkreatur', 'type': 'Artefaktkreatur', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '82b92243-b4aa-4a63-9aca-0e54e5694c76'}, 'multiverseid': None}, {'name': 'Gnomos mecánicos', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '50668842-a186-49d4-be46-530af44b0e5b'}, 'multiverseid': None}, {'name': 'Gnomes mécaniques', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '8afff2de-5bf7-42f6-ba3d-dee2accd2b0a'}, 'multiverseid': None}, {'name': 'Gnomi Meccanici', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'a3e91097-3f7b-437d-a880-d1a3cdee7a57'}, 'multiverseid': None}, {'name': 'Gnomos Mecânicos', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0ef1a297-bdda-4034-ab1b-c453aa0e54a6'}, 'multiverseid': None}]", "[{'name': 'Mechanischer Schwarm', 'text': 'Kann nicht von Mauern geblockt werden.\\nLege vier +1/+0-Spielmarken auf den Mechanischen Schwarm, wenn er ins Spiel kommt. Jedesmal, wenn der Schwarm angegriffen oder eine Kreatur geblockt hat, entferne eine dieser Marken vom Schwarm.\\nX, {T}: Lege X neue +1/+0-Spielmarken auf den Mechanischen Schwarm. Es dürfen nie mehr als vier dieser Spielmarken auf dem Schwarm liegen. Benutze diese Fähigkeit nur während Deiner Versorgungsphase.', 'type': 'Artefaktkreatur', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '5a2f4b9d-8d59-4ade-95ba-001efecc577e'}, 'multiverseid': None}, {'name': 'Enjambre mecánico', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'db214467-33e1-40b6-ac08-3815d27d9e5d'}, 'multiverseid': None}, {'name': 'Nuée mécanique', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '136914d9-cbfc-4ead-92ce-91ea7f3ee856'}, 'multiverseid': None}, {'name': 'Sciame Meccanico', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'd7ee804d-77dc-4b15-858c-970fae71d391'}, 'multiverseid': None}, {'name': 'Enxame Mecânico', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2125836a-31e1-44ee-afe0-f5e56adacc29'}, 'multiverseid': None}]", "[{'name': 'Mechanisches Streitroß', 'text': 'Kann nicht von Artefaktkreaturen geblockt werden.\\nLege vier +1/+0 Spielmarken auf das Mechanische Streitroß, wenn es ins Spiel kommt. Jedesmal, wenn das Streitroß angegriffen oder eine Kreatur geblockt hat, entferne eine dieser Marken vom Streitroß.\\nX, {T}: Lege X neue +1/+0 Spielmarken auf das Mechanische Streitroß. Es dürfen nie mehr als vier dieser Spielmarken auf dem Roß liegen. Benutze diese Fähigkeit nur während Deiner Versorgungsphase.', 'type': 'Artefaktkreatur', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'f151cfa2-3972-4404-a583-65d8eb19fdad'}, 'multiverseid': None}, {'name': 'Corcel mecánico', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'd611cea9-34fd-40b7-be41-2c081f1b1098'}, 'multiverseid': None}, {'name': 'Destrier mécanique', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'e1a74bcd-0159-4276-9168-e0a485e46e46'}, 'multiverseid': None}, {'name': 'Destriero Meccanico', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '0082a621-29e8-4fcd-aa26-2e4217c3baf0'}, 'multiverseid': None}, {'name': 'Corcel Mecânico', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2e375ab6-5a03-4705-858c-dcc962a24a39'}, 'multiverseid': None}]", "[{'name': 'Meeresfee', 'text': 'Kann fliegen, Schutz vor rot', 'type': 'Beschwörung eines Feenwesens', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '7634af0b-cb3b-42c2-9c8f-65a932e89c45'}, 'multiverseid': None}, {'name': 'Hada marina', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '689fbd79-6fa9-461e-bf49-e0a01c5dc5dc'}, 'multiverseid': None}, {'name': 'Farfadet marine', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '320f2861-c8fa-4a03-936e-357abd72b1bb'}, 'multiverseid': None}, {'name': 'Spiritello Marino', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '4dd49ad4-58dd-4297-83cc-4c32b3dc184c'}, 'multiverseid': None}, {'name': 'Fada do Mar', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '62844241-0607-4a9f-9e74-94684791db4a'}, 'multiverseid': None}]", "[{'name': 'Meerestroll', 'text': '{U}: Regeneration. Benutze diese Fähigkeit nur während eines Zuges, in dem der Meerestroll eine blaue Kreatur geblockt hat oder eine blaue Kreatur ihn geblockt hat.', 'type': 'Beschwörung eines Trolls', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'b145fd48-8896-4ede-82af-01d52ea2ee77'}, 'multiverseid': None}, {'name': 'Trol de mar', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'cb661db1-0f22-4059-b195-aaaf050ab19a'}, 'multive