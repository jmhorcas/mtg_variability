name: ['Abyssal Gatekeeper', 'Abyssal Specter', 'Akroma, Angel of Wrath', 'Angel of Mercy', "Angel's Feather", 'Angelic Benediction', 'Angelic Page', 'Angelic Protector', 'Angelsong', 'Barren Moor', 'Barter in Blood', 'Breeding Pit', 'Cackling Imp', 'Charging Paladin', 'Consume Spirit', 'Corrupt', 'Cruel Edict', 'Daggerclaw Imp', 'Dark Banishing', 'Dark Ritual', "Demon's Horn", "Demon's Jester", 'Demonic Tutor', 'Duress', 'Dusk Imp', "Faith's Fetters", 'Fallen Angel', 'Foul Imp', 'Healing Salve', 'Icatian Priest', 'Kuro, Pitlord', 'Lord of the Pit', 'Luminous Angel', 'Marble Diamond', 'Oni Possession', 'Otherworldly Journey', 'Overeager Apprentice', 'Pacifism', 'Plains', 'Promise of Power', 'Reiver Demon', 'Reya Dawnbringer', 'Righteous Cause', 'Secluded Steppe', 'Serra Advocate', 'Serra Angel', "Serra's Boon", "Serra's Embrace", 'Soot Imp', 'Souldrinker', 'Stinkweed Imp', 'Sustainer of the Realm', 'Swamp', 'Twilight Shepherd', 'Unholy Strength', 'Venerable Monk']
