type: ['Artifact Creature — Zombie', 'Creature — Cat Warrior', 'Creature — Cat Wizard', 'Creature — Elf Berserker', 'Creature — Elf Shaman', 'Creature — Vampire Warrior', 'Creature — Zombie Wizard', 'Enchantment', 'Instant', 'Land', 'Land — Locus', 'Sorcery']
