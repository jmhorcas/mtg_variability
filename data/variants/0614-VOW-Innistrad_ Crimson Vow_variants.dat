地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=544363&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '21cfde17-5b12-4903-a4bd-663cb3486e2e', 'multiverseId': 544363}, 'multiverseid': 544363}, {'name': '숲', 'type': '기본 대지 — 숲', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=544373&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '9b366f00-b239-44c7-a8c5-eaf8fe1dd019', 'multiverseId': 544373}, 'multiverseid': 544373}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=544393&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'e632d599-802e-4808-9268-42987a744c1d', 'multiverseId': 544393}, 'multiverseid': 544393}, {'name': '樹林', 'type': '基本地 ～樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=544413&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '807b5187-f09b-4c86-99a2-196fe5e94014', 'multiverseId': 544413}, 'multiverseid': 544413}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=545651&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b60ec681-6d1e-41ed-bcfc-521045600fd4', 'multiverseId': 545651}, 'multiverseid': 545651}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=545656&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '9981fe45-46b5-4308-b98f-78fd8680587b', 'multiverseId': 545656}, 'multiverseid': 545656}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=545661&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2fd0f031-b9b3-486d-a3af-af1d39d07