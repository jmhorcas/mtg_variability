verseid=538260&type=card', 'language': 'French', 'identifiers': {'scryfallId': '342693e3-cecf-46fa-8526-10e9e2a8123a', 'multiverseId': 538260}, 'multiverseid': 538260}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538270&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b4e31e52-8a4c-4673-b1fc-019b17bd5029', 'multiverseId': 538270}, 'multiverseid': 538270}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538280&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '4ec1788b-5ce9-46bf-b9f8-267685a1a489', 'multiverseId': 538280}, 'multiverseid': 538280}, {'name': '섬', 'type': '기본 대지 — 섬', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538290&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'dbd3aa10-68ec-4be1-a686-058a7dae135d', 'multiverseId': 538290}, 'multiverseid': 538290}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538300&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '16e22843-b7ec-42aa-8742-dc4fcfa803dd', 'multiverseId': 538300}, 'multiverseid': 538300}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538310&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'bef38c4f-0a1e-407c-86d2-cb780ee98256', 'multiverseId': 538310}, 'multiverseid': 538310}, {'name': '海岛', 'type': '基本地 ～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538320&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '83f409de-af70-48c6-bc50-5b8a5865b224', 'multiverseId': 538320}, 'multiverseid': 538320}, {'name': '海島', 'type': '基本地 ～海島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538330&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'dff3b704-6e9d-4ede-a8ae-b4b3137285c5', 'multiverseId': 538330}, 'multiverseid': 538330}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538343&type=card', 'language': 'German', 'identifiers': {'scryfallId': '26f62243-ca76-49e7-bc8b-b53847341db3', 'multiverseId': 538343}, 'multiverseid': 538343}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538348&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '6f4f5a75-d0c5-46d0-ac93-38150c7eb15b', 'multiverseId': 538348}, 'multiverseid': 538348}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538353&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2849908c-fe62-404e-8970-baff6b970d48', 'multiverseId': 538353}, 'multiverseid': 538353}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538358&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '1315f033-cfb8-4b09-922a-68395590698b', 'multiverseId': 538358}, 'multiverseid': 538358}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538363&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '16e7d836-17f9-4f65-a5b7-bdbd2cdd1da2', 'multiverseId': 538363}, 'multiverseid': 538363}, {'name': '섬', 'type': '기본 대지 — 섬', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538368&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '902988a1-f8fb-4b05-949a-93bbd9092fd8', 'multiverseId': 538368}, 'multiverseid': 538368}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538373&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '4f3befe7-8235-4c46-8844-0ca0d4c7b036', 'multiverseId': 538373}, 'multiverseid': 538373}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538378&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '25956db0-98e6-4f9a-9d21-52813303347f', 'multiverseId': 538378}, 'multiverseid': 538378}, {'name': '海岛', 'type': '基本地 ～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538383&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '1f08f030-786e-4623-85ab-f69d32543133', 'multiverseId': 538383}, 'multiverseid': 538383}, {'name': '海島', 'type': '基本地 ～海島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538388&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'd47ee6f9-f2e9-4e2f-8723-03acf34504b6', 'multiverseId': 538388}, 'multiverseid': 538388}]", '[{\'name\': \'Jadar, Ghulrufer aus Nefalen\', \'text\': \'Zu Beginn deines Endsegments und falls du keine Kreaturen mit Verwesung kontrollierst, erzeuge einen 2/2 schwarzen Zombie-Kreaturenspielstein mit Verwesung. (Er kann nicht blocken. Wenn er angreift, opfere ihn am Ende des Kampfes.)\', \'type\': \'Legendäre Kreatur — Mensch, Zauberer\', \'flavor\': \'„Erhebe dich, meine Schönheit. Warum solltest du im Fluss verrotten, wenn du mir dienen kannst?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535197&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1596f7db-470b-483d-b269-ebb9caa1903d\', \'multiverseId\': 535197}, \'multiverseid\': 535197}, {\'name\': \'Jadar, llamamuertos de Nephalia\', \'text\': \'Al comienzo de tu paso final, si no controlas ninguna criatura con la habilidad de descomposición, crea una ficha de criatura Zombie negra 2/2 con la habilidad de descomposición. (No puede bloquear. Cuando ataque, sacrifícala al final del combate.)\', \'type\': \'Criatura legendaria — Hechicero humano\', \'flavor\': \'"Levántate, preciosidad. ¿Para qué pudrirte en el río si puedes servir bajo mis órdenes?".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535513&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4e669d3c-5431-4c27-8af8-01190c143328\', \'multiverseId\': 535513}, \'multiverseid\': 535513}, {\'name\': \'Jadar, meneur de goule de Néphalie\', \'text\': \'Au début de votre étape de fin, si vous ne contrôlez pas de créature avec la décomposition, créez un jeton de créature 2/2 noire Zombie avec la décomposition. (Il ne peut pas bloquer. Quand il attaque, sacrifiez-le à la fin du combat.)\', \'type\': \'Créature légendaire : humain et sorcier\', \'flavor\': \'« Lève-toi, mon joli. Pourquoi pourrir dans la rivière quand tu peux me servir ? »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535829&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9b0d88df-5c7d-43c7-89c1-72c0f81df3de\', \'multiverseId\': 535829}, \'multiverseid\': 535829}, {\'name\': \'Jadar, Evocaghoul di Nephalia\', \'text\': "All\'inizio della tua sottofase finale, se non controlli creature con decomposto, crea una pedina creatura Zombie 2/2 nera con decomposto. (Non può bloccare. Quando attacca, sacrificala alla fine del combattimento.)", \'type\': \'Creatura Leggendaria — Mago Umano\', \'flavor\': \'"Alzati, mio caro. Perché marcire nel fiume quando puoi servire ai miei ordini?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536145&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2dd2be5a-d372-4761-b7cb-a2bcfce2c851\', \'multiverseId\': 536145}, \'multiverseid\': 536145}, {\'name\': \'ネファリアのグール呼び、ジャダー\', \'text\': \'あなたの終了ステップの開始時に、あなたが腐乱を持つクリーチャーをコントロールしていない場合、腐乱を持つ黒の２/２のゾンビ・クリーチャー・トークン１体を生成する。（それではブロックできない。それが攻撃したとき、戦闘終了時に、それを生け贄に捧げる。）\', \'type\': \'伝説のクリーチャー — 人間・ウィザード\', \'flavor\': \'「立ち上がりなさい、我がかわいい子たちよ。川で腐っているくらいなら、私に仕えた方がよかろう？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536461&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'77d85d65-25cc-480e-bcf2-c704f4eb763f\', \'multiverseId\': 536461}, \'multiverseid\': 536461}, {\'name\': \'네팔리아의 악귀소환술사, 자다르\', \'text\': \'당신의 종료단 시작에, 당신이 부패를 가진 생물을 조종하지 않는다면, 부패를 가진 2/2 흑색 좀비 생물 토큰 한 개를 만든다. (그 생물은 방어할 수 없다. 그 생물이 공격할 때, 전투종료에 그 생물을 희생한다.)\', \'type\': \'전설적 생물 — 인간 마법사\', \'flavor\': \'"일어나거라, 귀여운 것들아. 내 명령을 따를 수 있는데 왜 강에서 썩으려 하느냐?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536777&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2cb7dbee-cafc-4969-af8f-1c5579bcad22\', \'multiverseId\': 536777}, \'multiverseid\': 536777}, {\'name\': \'Jadar, Invocador de Carniçais de Nefália\', \'text\': \'No início de sua etapa final, se você não controlar nenhuma criatura com decomposto, crie uma ficha de criatura Zumbi preta 2/2 com decomposto. (Ela não pode bloquear. Quando ela atacar, sacrifique-a no final do combate.)\', \'type\': \'Criatura Lendária — Humano Mago\', \'flavor\': \'"Levante-se, minha belezinha. Por que apodrecer no rio quando você pode me servir?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537093&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a5a64537-9a42-4ccd-ae9b-269a82b49a04\', \'multiverseId\': 537093}, \'multiverseid\': 537093}, {\'name\': \'Джадар, Призыватель из Нефалии\', \'text\': \'В начале вашего заключительного шага, если под вашим контролем нет существ с Трупной гнилью, создайте одну фишку существа 2/2 черный Зомби с Трупной гнилью. (Она не может блокировать. Когда она атакует, пожертвуйте ее в конце боя.)\', \'type\': \'Легендарное Существо — Человек Чародей\', \'flavor\': \'«Поднимайся, моя красавица. Зачем гнить в реке, когда ты можешь исполнять мои повеления?»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537409&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'16a3ac75-0086-45c5-bcfe-ac7641df69e9\', \'multiverseId\': 537409}, \'multiverseid\': 537409}, {\'name\': \'涅非利亚尸鬼牧者贾达\', \'text\': \'在你的结束步骤开始时，若你未操控具败朽异能的生物，则派出一个2/2黑色，具败朽异能的灵俑衍生生物。（它不能进行阻挡。当它攻击，在战斗结束时将它牺牲。）\', \'type\': \'传奇生物 ～人类／法术师\', \'flavor\': \'「起身，我的宝贝。如果你能服侍我，又何必烂在河里？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537725&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d13e4e5d-4faf-44bf-a52f-b62744ebd831\', \'multiverseId\': 537725}, \'multiverseid\': 537725}, {\'name\': \'涅非利亞屍鬼牧者賈達\', \'text\': \'在你的結束步驟開始時，若你未操控具敗朽異能的生物，則派出一個2/2黑色，具敗朽異能的殭屍衍生生物。（它不能進行阻擋。當它攻擊，在戰鬥結束時將它犧牲。）\', \'type\': \'傳奇生物 ～人類／魔法師\', \'flavor\': \'「起身，我的寶貝。如果你能服侍我，又何必爛在河裡？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538041&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e408b725-0b2f-40a1-a17e-d48a80aa4828\', \'multiverseId\': 538041}, \'multiverseid\': 538041}]', '[{\'name\': \'Jadar, Ghulrufer aus Nefalen\', \'text\': \'Zu Beginn deines Endsegments und falls du keine Kreaturen mit Verwesung kontrollierst, erzeuge einen 2/2 schwarzen Zombie-Kreaturenspielstein mit Verwesung.\', \'type\': \'Legendäre Kreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538511&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8608923b-045a-4310-b813-20ac3cbef48e\', \'multiverseId\': 538511}, \'multiverseid\': 538511}, {\'name\': \'Jadar, llamamuertos de Nephalia\', \'text\': \'Al comienzo de tu paso final, si no controlas ninguna criatura con la habilidad de descomposición, crea una ficha de criatura Zombie negra 2/2 con la habilidad de descomposición.\', \'type\': \'Criatura legendaria — Hechicero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538528&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'02b020b7-a861-4303-aa4c-da96eb7da7c1\', \'multiverseId\': 538528}, \'multiverseid\': 538528}, {\'name\': \'Jadar, meneur de goule de Néphalie\', \'text\': \'Au début de votre étape de fin, si vous ne contrôlez pas de créature avec la décomposition, créez un jeton de créature 2/2 noire Zombie avec la décomposition.\', \'type\': \'Créature légendaire : humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538545&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bc1acd1d-69fe-4278-a5b6-66367a8a6014\', \'multiverseId\': 538545}, \'multiverseid\': 538545}, {\'name\': \'Jadar, Evocaghoul di Nephalia\', \'text\': "All\'inizio della tua sottofase finale, se non controlli creature con decomposto, crea una pedina creatura Zombie 2/2 nera con decomposto.", \'type\': \'Creatura Leggendaria — Mago Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538562&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a0f60b84-7116-4ec0-9ed5-120bf7a130ff\', \'multiverseId\': 538562}, \'multiverseid\': 538562}, {\'name\': \'ネファリアのグール呼び、ジャダー\', \'text\': \'あなたの終了ステップの開始時に、あなたが腐乱を持つクリーチャーをコントロールしていない場合、腐乱を持つ黒の２/２のゾンビ・クリーチャー・トークン１体を生成する。\', \'type\': \'伝説のクリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538579&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d6df391e-c538-4b15-ac75-fadb9c0f085e\', \'multiverseId\': 538579}, \'multiverseid\': 538579}, {\'name\': \'네팔리아의 악귀소환술사, 자다르\', \'text\': \'당신의 종료단 시작에, 당신이 부패를 가진 생물을 조종하지 않는다면, 부패를 가진 2/2 흑색 좀비 생물 토큰 한 개를 만든다.\', \'type\': \'전설적 생물 — 인간 마법사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538596&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7332cbfb-6fb7-4c30-b10f-c8794d82a4f2\', \'multiverseId\': 538596}, \'multiverseid\': 538596}, {\'name\': \'Jadar, Invocador de Carniçais de Nefália\', \'text\': \'No início de sua etapa final, se você não controlar nenhuma criatura com decomposto, crie uma ficha de criatura Zumbi preta 2/2 com decomposto.\', \'type\': \'Criatura Lendária — Humano Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538613&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'11d240f7-2a39-4920-94f2-b560b42beeea\', \'multiverseId\': 538613}, \'multiverseid\': 538613}, {\'name\': \'Джадар, Призыватель из Нефалии\', \'text\': \'В начале вашего заключительного шага, если под вашим контролем нет существ с Трупной гнилью, создайте одну фишку существа 2/2 черный Зомби с Трупной гнилью.\', \'type\': \'Легендарное Существо — Человек Чародей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538630&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0b816053-a9de-4c2f-9819-0a77d1374887\', \'multiverseId\': 538630}, \'multiverseid\': 538630}, {\'name\': \'涅非利亚尸鬼牧者贾达\', \'text\': \'在你的结束步骤开始时，若你未操控具败朽异能的生物，则派出一个2/2黑色，具败朽异能的灵俑衍生生物。\', \'type\': \'传奇生物 ～人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538647&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9c3f2a53-f5c5-45e3-8a6d-ab4ad5aa30aa\', \'multiverseId\': 538647}, \'multiverseid\': 538647}, {\'name\': \'涅非利亞屍鬼牧者賈達\', \'text\': \'在你的結束步驟開始時，若你未操控具敗朽異能的生物，則派出一個2/2黑色，具敗朽異能的殭屍衍生生物。\', \'type\': \'傳奇生物 ～人類／魔法師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538664&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e8936039-acd0-4b9c-a832-88a6a2acf719\', \'multiverseId\': 538664}, \'multiverseid\': 538664}]', '[{\'name\': \'Katharer-Kommandosoldatin\', \'text\': \'Aufblitzen\\n{1}, opfere die Katharer-Kommandosoldatin: Zerstöre ein Artefakt oder eine Verzauberung deiner Wahl.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'„Ehrenhafte Taktiken sind etwas für ehrenhafte Feinde. Diese Werwölfe stellen unschuldigen Reisenden nach. Wenn es sein muss, werde ich ihnen im Schlaf die Klinge in den Rücken stoßen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535080&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f98cb8e4-0c8f-4322-89fa-89687049056d\', \'multiverseId\': 535080}, \'multiverseid\': 535080}, {\'name\': \'Incursora cátara\', \'text\': \'Destello.\\n{1}, sacrificar la Incursora cátara: Destruye el artefacto o encantamiento objetivo.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'"Las tácticas honradas son para los enemigos honrados. Estos licántropos dan caza a viajeros inocentes. Si hiciera falta, los apuñalaría por la espalda mientras duermen".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535396&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'92103c64-031c-411b-9556-36bd960b4573\', \'multiverseId\': 535396}, \'multiverseid\': 535396}, {\'name\': \'Commando cathare\', \'text\': \'Flash\\n{1}, sacrifiez le Commando cathare : Détruisez un artefact ciblé ou un enchantement ciblé.\', \'type\': \'Créature : humain et soldat\', \'flavor\': "« Réservons les tactiques respectables aux adversaires respectables. Ces loups-garous s\'en prennent aux voyageurs innocents. Je les poignarderai dans le dos pendant leur sommeil s\'il le faut. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535712&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ad55b388-2c93-410e-94aa-21cba42f82a1\', \'multiverseId\': 535712}, \'multiverseid\': 535712}, {\'name\': \'Catara del Commando\', \'text\': \'Lampo\\n{1}, Sacrifica la Catara del Commando: Distruggi un artefatto o un incantesimo bersaglio.\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'"Le tattiche onorevoli sono per gli avversari onorevoli. Questi mannari danno la caccia a viaggiatori innocenti. Li pugnalerò alle spalle nel sonno, se necessario."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536028&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'24af4987-2d8c-4f11-9117-5944f70cfdd5\', \'multiverseId\': 536028}, \'multiverseid\': 536028}, {\'name\': \'聖戦士の奇襲兵\', \'text\': \'瞬速\\n{1}, 聖戦士の奇襲兵を生け贄に捧げる：アーティファクトやエンチャントのうち１つを対象する。それを破壊する。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'「名誉ある戦略は名誉ある敵にこそふさわしい。でも、この人狼共は無辜の者を捕食しているのよ。眠っている間に後ろから刺し殺すことも厭わないわ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536344&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1704759d-4050-4182-b748-2eb541a72c08\', \'multiverseId\': 536344}, \'multiverseid\': 536344}, {\'name\': \'성전사 특공대원\', \'text\': \'섬광\\n{1}, 성전사 특공대원을 희생한다: 마법물체 또는 부여마법을 목표로 정한다. 그 목표를 파괴한다.\', \'type\': \'생물 — 인간 병사\', \'flavor\': \'"명예로운 전술은 명예로운 적을 위해 있는 거야. 이 늑대인간들은 무고한 여행자들을 먹이로 삼고 있다고. 필요하다면 난 그것들이 자고 있을 때 등에 칼을 찔러 넣을거야."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536660&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'42e2413b-6e29-4882-9b50-ce6cf9b90330\', \'multiverseId\': 536660}, \'multiverseid\': 536660}, {\'name\': \'Comando Cátaro\', \'text\': \'Lampejo\\n{1}, sacrifique Comando Cátaro: Destrua o artefato ou o encantamento alvo.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': \'"Táticas honradas são para oponentes honrados. Esses lobisomens estão atacando viajantes inocentes. Se precisar eu esfaqueio pelas costas enquanto eles dormem."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536976&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7162034f-6bf1-4f53-aee7-45168439e4dc\', \'multiverseId\': 536976}, \'multiverseid\': 536976}, {\'name\': \'Катар-Коммандос\', \'text\': \'Миг\\n{1}, пожертвуйте Катара-Коммандоса: уничтожьте целевой артефакт или чары.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'«Благородная тактика — для благородных врагов. Эти вервольфы охотятся на беззащитных путников. Если придется, я нанесу им удар в спину, пока они спят».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537292&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b40aca19-7e28-4ce9-84bb-a9dd51d8e136\', \'multiverseId\': 537292}, \'multiverseid\': 537292}, {\'name\': \'护教军突击兵\', \'text\': \'闪现\\n{1}，牺牲护教军突击兵：消灭目标神器或结界。\', \'type\': \'生物 ～人类／士兵\', \'flavor\': \'「正经战术是留给正经敌人用的。狼人滥捕无辜旅人，就算他们睡着我也会在他们后背捅上一刀。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537608&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bd61a3ac-b6fc-45b4-8b72-c3b9206187a5\', \'multiverseId\': 537608}, \'multiverseid\': 537608}, {\'name\': \'護教軍突擊兵\', \'text\': \'閃現\\n{1}，犧牲護教軍突擊兵：消滅目標神器或結界。\', \'type\': \'生物 ～人類／士兵\', \'flavor\': \'「正經戰術是留給正經敵人用的。狼人濫捕無辜旅人，就算他們睡著我也會在他們後背捅上一刀。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537924&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a46e0790-f887-411d-893f-da9ab273d7a2\', \'multiverseId\': 537924}, \'multiverseid\': 537924}]', '[{\'name\': \'Katilda, Morgenlicht-Oberste\', \'text\': \'Schutz vor Werwölfen\\nMensch-Kreaturen, die du kontrollierst, haben „{T}: Erzeuge ein Mana einer beliebigen Farbe dieser Kreatur."\\n{4}{G}{W}, {T}: Lege auf jede Kreatur, die du kontrollierst, eine +1/+1-Marke.\', \'type\': \'Legendäre Kreatur — Mensch, Hexenmeister\', \'flavor\': \'„Die Engel mögen uns verlassen haben, aber Ghrin-Danu nicht."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535340&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7c9958f0-b3ea-41cc-8ee0-4837a5007597\', \'multiverseId\': 535340}, \'multiverseid\': 535340}, {\'name\': \'Katilda, Gran Cierva del Alba\', \'text\': \'Protección contra Licántropos.\\nLas criaturas Humano que controlas tienen "{T}: Agrega un maná de cualquiera de los colores de esta criatura".\\n{4}{G}{W}, {T}: Pon un contador +1/+1 sobre cada criatura que controlas.\', \'type\': \'Criatura legendaria — Brujo humano\', \'flavor\': \'"Puede que los ángeles nos hayan abandonado, pero Ghrin-Danu no".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535656&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7ad4fd88-4507-45bf-8fbb-3ef92c321617\', \'multiverseId\': 535656}, \'multiverseid\': 535656}, {\'name\': \'Katilda, Première de Cerf-orient\', \'text\': "Protection contre les loups-garous\\nLes créatures Humain que vous contrôlez ont « {T} : Ajoutez un mana de n\'importe quelle couleur de cette créature. »\\n{4}{G}{W}, {T} : Mettez un marqueur +1/+1 sur chaque créature que vous contrôlez.", \'type\': \'Créature légendaire : humain et psychagogue\', \'flavor\': \'« Les anges nous ont peut-être abandonnés, mais pas Ghrin-Danu. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535972&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'37f6a174-4f3b-4f62-b60c-cf60d870d077\', \'multiverseId\': 535972}, \'multiverseid\': 535972}, {\'name\': \'Katilda, Prima Albacorno\', \'text\': \'Protezione dai Mannari\\nLe creature Umano che controlli hanno "{T}: Aggiungi un mana di un qualsiasi colore di questa creatura".\\n{4}{G}{W}, {T}: Metti un segnalino +1/+1 su ogni creatura che controlli.\', \'type\': \'Creatura Leggendaria — Warlock Umano\', \'flavor\': \'"Gli angeli ci avranno anche abbandonato, ma non Ghrin-Danu."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536288&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b1c1abc0-f64a-4647-b2bc-2406ae235a0f\', \'multiverseId\': 536288}, \'multiverseid\': 536288}, {\'name\': \'ドーンハルトの主導者、カティルダ\', \'text\': \'プロテクション（狼男）\\nあなたがコントロールしているすべての人間は「{T}：このクリーチャーの色のうち好きな色１色のマナ１点を加える。」を持つ。\\n{4}{G}{W}, {T}：あなたがコントロールしている各クリーチャーの上に、それぞれ＋１/＋１カウンター１個を置く。\', \'type\': \'伝説のクリーチャー — 人間・邪術師\', \'flavor\': \'「我々は天使に見捨てられたかもしれないが、グリン・ダヌーに見捨てられてはいない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536604&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'39739221-9688-45cb-97d0-ae3c5a2c064b\', \'multiverseId\': 536604}, \'multiverseid\': 536604}, {\'name\': \'새벽수사슴 지도자, 카틸다\', \'text\': \'늑대인간으로부터 보호\\n당신이 조종하는 인간 생물들은 "{T}: 이 생물의 색 중 하나인 색의 마나 한 개를 추가한다."를 가진다.\\n{4}{G}{W}, {T}: 당신이 조종하는 각 생물에 +1/+1 카운터를 한 개씩 올려놓는다.\', \'type\': \'전설적 생물 — 인간 흑마법사\', \'flavor\': \'"천사들은 우리를 버렸을 지 몰라도, 그린-다누는 그러지 않았다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536920&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'14323103-7535-4c97-bc02-b7f4523fa987\', \'multiverseId\': 536920}, \'multiverseid\': 536920}, {\'name\': \'Katilda, Líder Cervo da Aurora\', \'text\': \'Proteção contra Lobisomens\\nAs criaturas Humano que você controla têm "{T}: Adicione um mana de qualquer das cores desta criatura."\\n{4}{G}{W}, {T}: Coloque um marcador +1/+1 em cada criatura que você controla.\', \'type\': \'Criatura Lendária — Humano Bruxo\', \'flavor\': \'"Os anjos podem ter nos abandonado, mas Ghrin-Danu não abandonou."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537236&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'02bcd592-712c-423a-b976-e7356d27e7f9\', \'multiverseId\': 537236}, \'multiverseid\': 537236}, {\'name\': \'Катильда, Первейшая Донхарта\', \'text\': \'Защита от Вервольфов\\nСущества с типом Человек под вашим контролем имеют способность «{T}: добавьте одну ману любого из цветов этого существа».\\n{4}{G}{W}, {T}: положите один жетон +1/+1 на каждое существо под вашим контролем.\', \'type\': \'Легендарное Существо — Человек Колдун\', \'flavor\': \'«Ангелы, может, и бросили нас, но Грин-Дану — нет».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537552&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a32f8db0-cfbc-46fe-ab74-f82c994c6b4e\', \'multiverseId\': 537552}, \'multiverseid\': 537552}, {\'name\': \'曙鹿集巫首凯蒂妲\', \'text\': \'反狼人保护\\n由你操控的人类生物具有「{T}：加一点法术力，其颜色为此生物的任一颜色。」\\n{4}{G}{W}，{T}：在每个由你操控的生物上各放置一个+1/+1指示物。\', \'type\': \'传奇生物 ～人类／邪术师\', \'flavor\': \'「天使或许已经抛弃我们，但吉琳达努还没有。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537868&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5437618a-83cc-42f3-a79b-cd5c51aaf255\', \'multiverseId\': 537868}, \'multiverseid\': 537868}, {\'name\': \'曙鹿集巫首凱蒂妲\', \'text\': \'反狼人保護\\n由你操控的人類生物具有「{T}：加一點魔法力，其顏色為此生物的任一顏色。」\\n{4}{G}{W}，{T}：在每個由你操控的生物上各放置一個+1/+1指示物。\', \'type\': \'傳奇生物 ～人類／邪術師\', \'flavor\': \'「天使或許已經拋棄我們，但吉琳達努還沒有。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538184&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3fe77012-bb67-4094-a574-c7a6934c0a58\', \'multiverseId\': 538184}, \'multiverseid\': 538184}]', '[{\'name\': \'Kein Ausweg\', \'text\': \'Ein Gegner deiner Wahl wirft zwei Karten ab. Du erzeugst einen 2/2 schwarzen Zombie-Kreaturenspielstein mit Verwesung. (Er kann nicht blocken. Wenn er angreift, opfere ihn am Ende des Kampfes.)\', \'type\': \'Hexerei\', \'flavor\': \'In den labyrinthartigen Erdgängen kann es tödlich sein, falsch abzubiegen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535206&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2cd9855c-0852-4e72-9998-3d6e697cf28b\', \'multiverseId\': 535206}, \'multiverseid\': 535206}, {\'name\': \'Sin salida\', \'text\': \'El oponente objetivo descarta dos cartas. Creas una ficha de criatura Zombie negra 2/2 con la habilidad de descomposición. (No puede bloquear. Cuando ataque, sacrifícala al final del combate.)\', \'type\': \'Conjuro\', \'flavor\': \'En las callejuelas laberínticas de Erdwal, equivocarse de camino puede significar el fin.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535522&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d08db159-9c52-4ffc-8c81-478538f7fd09\', \'multiverseId\': 535522}, \'multiverseid\': 535522}, {\'name\': "Pas d\'échappatoire", \'text\': \'Un adversaire ciblé se défausse de deux cartes. Vous créez un jeton de créature 2/2 noire Zombie avec la décomposition. (Il ne peut pas bloquer. Quand il attaque, sacrifiez-le à la fin du combat.)\', \'type\': \'Rituel\', \'flavor\': "Dans les passages labyrinthiques de l\'Erdwal, prendre le mauvais chemin peut être fatal.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535838&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'71a155c4-8092-418b-8c4e-70a3d94c3585\', \'multiverseId\': 535838}, \'multiverseid\': 535838}, {\'name\': "Senza Via d\'Uscita", \'text\': \'Un avversario bersaglio scarta due carte. Crea una pedina creatura Zombie 2/2 nera con decomposto. (Non può bloccare. Quando attacca, sacrificala alla fine del combattimento.)\', \'type\': \'Stregoneria\', \'flavor\': "Nei passaggi labirintici dell\'Erdwal, una svolta sbagliata può essere fatale.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536154&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dd1f979d-6430-488a-9606-c4eff7cbc696\', \'multiverseId\': 536154}, \'multiverseid\': 536154}, {\'name\': \'八方塞がり\', \'text\': \'対戦相手１人を対象とする。そのプレイヤーはカード２枚を捨てる。あなたは腐乱を持つ黒の２/２のゾンビ・クリーチャー・トークン１体を生成する。（それではブロックできない。それが攻撃したとき、戦闘終了時に、それを生け贄に捧げる。）\', \'type\': \'ソーサリー\', \'flavor\': \'エルドワルの迷路のような路地では、誤った角を曲がってしまったら命取りになる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536470&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bb3478f2-0902-4c4a-949e-c3a4d4bd5b74\', \'multiverseId\': 536470}, \'multiverseid\': 536470}, {\'name\': \'출구 없음\', \'text\': \'상대를 목표로 정한다. 그 플레이어는 카드 두 장을 버린다. 당신은 부패를 가진 2/2 흑색 좀비 생물 토큰 한 개를 만든다. (그 생물은 방어할 수 없다. 그 생물이 공격할 때, 전투종료에 그 생물을 희생한다.)\', \'type\': \'집중마법\', \'flavor\': \'에르드왈의 미로와 같은 통로에서는, 길을 한 번 잘못 꺾기만 해도 치명적일 수 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536786&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0e1ec7f5-331c-472c-b1a4-6c67ce8e7d97\', \'multiverseId\': 536786}, \'multiverseid\': 536786}, {\'name\': \'Sem Escapatória\', \'text\': \'O oponente alvo descarta dois cards. Você cria uma ficha de criatura Zumbi preta 2/2 com decomposto. (Ela não pode bloquear. Quando ela atacar, sacrifique-a no final do combate.)\', \'type\': \'Feitiço\', \'flavor\': \'Nas passagens labirínticas do Erdwal, pegar o caminho errado pode ser fatal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537102&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'36706d0e-f0e7-4ff7-8dae-b15cb22a00d8\', \'multiverseId\': 537102}, \'multiverseid\': 537102}, {\'name\': \'Выхода Нет\', \'text\': \'Целевой оппонент сбрасывает две карты. Вы создаете одну фишку существа 2/2 черный Зомби с Трупной гнилью. (Она не может блокировать. Когда она атакует, пожертвуйте ее в конце боя.)\', \'type\': \'Волшебство\', \'flavor\': \'В лабиринтах улочек Эрдваля поворот не туда может оказаться фатальным.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537418&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b20c406b-ccc3-488b-b6af-ceefeb83225b\', \'multiverseId\': 537418}, \'multiverseid\': 537418}, {\'name\': \'无路可逃\', \'text\': \'目标对手弃两张牌。你派出一个2/2黑色，具败朽异能的灵俑衍生生物。（它不能进行阻挡。当它攻击，在战斗结束时将它牺牲。）\', \'type\': \'法术\', \'flavor\': \'尔卓道上通路交错颇似迷宫，一拐错弯可能就会丧命。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537734&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'314f89c7-d372-4248-a249-ea0411b560c5\', \'multiverseId\': 537734}, \'multiverseid\': 537734}, {\'name\': \'無路可逃\', \'text\': \'目標對手棄兩張牌。你派出一個2/2黑色，具敗朽異能的殭屍衍生生物。（它不能進行阻擋。當它攻擊，在戰鬥結束時將它犧牲。）\', \'type\': \'巫術\', \'flavor\': \'爾卓道上通路交錯頗似迷宮，一拐錯彎可能就會喪命。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538050&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'09abd160-6ed1-4e64-86de-bd696e7343bf\', \'multiverseId\': 538050}, \'multiverseid\': 538050}]', '[{\'name\': \'Kerzenfalle\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur hat Verteidiger.\\nVerhindere allen Kampfschaden, der von der verzauberten Kreatur zugefügt würde.\\nHexenzirkel — {2}{W}, opfere die Kerzenfalle: Schicke die verzauberte Kreatur ins Exil. Aktiviere diese Fähigkeit nur, falls du drei oder mehr Kreaturen mit unterschiedlicher Stärke kontrollierst.\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535079&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'daef0e30-16f1-424a-b94e-184e31b5a23f\', \'multiverseId\': 535079}, \'multiverseid\': 535079}, {\'name\': \'Trampa con velas\', \'text\': \'Encantar criatura.\\nLa criatura encantada tiene la habilidad de defensor.\\nPrevén todo el daño de combate que fuera a hacer la criatura encantada.\\nAquelarre — {2}{W}, sacrificar la Trampa con velas: Exilia la criatura encantada. Activa esto solo si controlas tres o más criaturas con fuerzas distintas.\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535395&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f0f808cb-2a01-4822-a644-01edf53ad117\', \'multiverseId\': 535395}, \'multiverseid\': 535395}, {\'name\': \'Piège à chandelles\', \'text\': "Enchanter : créature\\nLa créature enchantée a le défenseur.\\nPrévenez toutes les blessures de combat qui devraient être infligées par la créature enchantée.\\nCongrégation — {2}{W}, sacrifiez le Piège à chandelles : Exilez la créature enchantée. N\'activez que si vous contrôlez au moins trois créatures avec des forces différentes.", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535711&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f24d844e-b7ae-4451-b9f0-6256175f1f18\', \'multiverseId\': 535711}, \'multiverseid\': 535711}, {\'name\': \'Trappola di Candele\', \'text\': \'Incanta creatura\\nLa creatura incantata ha difensore.\\nPrevieni tutto il danno da combattimento che verrebbe inflitto dalla creatura incantata.\\nCongrega — {2}{W}, Sacrifica la Trappola di Candele: Esilia la creatura incantata. Attiva solo se controlli tre o più creature con forza diversa.\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536027&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cdb756fa-6a19-4776-9327-144a3f4bebd5\', \'multiverseId\': 536027}, \'multiverseid\': 536027}, {\'name\': \'蝋燭罠\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントしているクリーチャーは防衛を持つ。\\nエンチャントしているクリーチャーが与えるすべての戦闘ダメージを軽減する。\\n集会 — {2}{W}, 蝋燭罠を生け贄に捧げる：エンチャントしているクリーチャーを追放する。あなたがパワーが異なる３体以上のクリーチャーをコントロールしていなければ起動できない。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536343&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3134783e-7072-4ecd-8eb9-751335d7063d\', \'multiverseId\': 536343}, \'multiverseid\': 536343}, {\'name\': \'촛불함정\', \'text\': \'생물에게 부여\\n부여된 생물은 수비태세를 가진다.\\n부여된 생물이 입히려고 하는 모든 전투피해를 방지한다.\\n집회 — {2}{W}, 촛불함정을 희생한다: 부여된 생물을 추방한다. 당신이 서로 다른 공격력을 가진 생물을 세 개 이상 조종하는 경우에만 활성화할 수 있다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536659&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'647be82f-5f6c-4960-96fc-37f64a32c937\', \'multiverseId\': 536659}, \'multiverseid\': 536659}, {\'name\': \'Armadilha de Velas\', \'text\': \'Encantar criatura\\nA criatura encantada tem defensor.\\nPrevina todo o dano de combate que seria causado pela criatura encantada.\\nConventículo — {2}{W}, sacrifique Armadilha de Velas: Exile a criatura encantada. Ative somente se você controlar três ou mais criaturas com poderes diferentes.\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536975&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4996634e-d842-421f-9103-a5aa42db6edd\', \'multiverseId\': 536975}, \'multiverseid\': 536975}, {\'name\': \'Свечная Ловушка\', \'text\': \'Зачаровать существо\\nЗачарованное существо имеет способность Защитника.\\nПредотвратите все боевые повреждения, которые должны быть нанесены зачарованным существом.\\nШабаш — {2}{W}, пожертвуйте Свечную Ловушку: изгоните зачарованное существо. Активируйте, только если вы контролируете не менее трех существ с различными значениями силы.\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537291&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3b89b6d5-d317-4954-8c92-54a02b7ff473\', \'multiverseId\': 537291}, \'multiverseid\': 537291}, {\'name\': \'烛光陷阱\', \'text\': \'结附于生物\\n所结附的生物具有守军异能。\\n防止所结附的生物将造成的所有战斗伤害。\\n鸠集～{2}{W}，牺牲烛光陷阱：放逐所结附的生物。只能于你操控三个或更多力量各不相同的生物时起动。\', \'type\': \'结界 ～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537607&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b0a832fc-d332-4c55-8bfa-a19678a9ded0\', \'multiverseId\': 537607}, \'multiverseid\': 537607}, {\'name\': \'燭光陷阱\', \'text\': \'結附於生物\\n所結附的生物具有守軍異能。\\n防止所結附的生物將造成的所有戰鬥傷害。\\n鳩集～{2}{W}，犧牲燭光陷阱：放逐所結附的生物。只能於你操控三個或更多力量各不相同的生物時起動。\', \'type\': \'結界 ～靈氣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537923&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d8c3d7ad-f163-41b7-812b-f0412c21f619\', \'multiverseId\': 537923}, \'multiverseid\': 537923}]', '[{\'name\': \'Kerzenhainhexe\', \'text\': \'Hexenzirkel — Zu Beginn des Kampfes in deinem Zug und falls du drei oder mehr Kreaturen mit unterschiedlicher Stärke kontrollierst, erhält die Kerzenhainhexe Flugfähigkeit bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Hexenmeister\', \'flavor\': \'„Wie tausend Kerzen, die sich der Dunkelheit erwehren, sind wir am stärksten, wenn wir zusammenstehen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535078&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a8e62257-c55c-4caf-b867-af583a93cb99\', \'multiverseId\': 535078}, \'multiverseid\': 535078}, {\'name\': \'Bruja del marcavelas\', \'text\': \'Aquelarre — Al comienzo del combate en tu turno, si controlas tres o más criaturas con fuerzas distintas, la Bruja del marcavelas gana la habilidad de volar hasta el final del turno.\', \'type\': \'Criatura — Brujo humano\', \'flavor\': \'"Somos más fuertes cuando permanecemos unidas, al igual que mil velas que luchan contra la oscuridad".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535394&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0e0946c5-5d19-47fd-a93f-ac6eefa32b71\', \'multiverseId\': 535394}, \'multiverseid\': 535394}, {\'name\': \'Envoûteuse du bosquet aux chandelles\', \'text\': "Congrégation — Au début du combat pendant votre tour, si vous contrôlez au moins trois créatures avec des forces différentes, l\'Envoûteuse du bosquet aux chandelles acquiert le vol jusqu\'à la fin du tour.", \'type\': \'Créature : humain et psychagogue\', \'flavor\': \'« Tels mille bougies repoussant les ténèbres, nous sommes les plus forts quand nous faisons front ensemble. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535710&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6f758671-881b-4b80-9831-f14028d848d2\', \'multiverseId\': 535710}, \'multiverseid\': 535710}, {\'name\': \'Strega del Bosco delle Candele\', \'text\': "Congrega — All\'inizio del combattimento nel tuo turno, se controlli tre o più creature con forza diversa, la Strega del Bosco delle Candele ha volare fino alla fine del turno.", \'type\': \'Creatura — Warlock Umano\', \'flavor\': \'"Come mille candele che lottano contro l\\\'oscurità, siamo più forti quando restiamo uniti."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536026&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bcfa784f-5360-481d-a748-7c77b2c447df\', \'multiverseId\': 536026}, \'multiverseid\': 536026}, {\'name\': \'蝋燭林の魔女\', \'text\': \'集会 — あなたのターンの戦闘の開始時に、あなたがパワーが異なる３体以上のクリーチャーをコントロールしている場合、ターン終了時まで、蝋燭林の魔女は飛行を得る。\', \'type\': \'クリーチャー — 人間・邪術師\', \'flavor\': \'「闇に抗う千の蝋燭のように、共に立ち上がる我々はあらゆるものに勝ります。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536342&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b9102223-87a9-48d1-8c19-ff86a43aa90d\', \'multiverseId\': 536342}, \'multiverseid\': 536342}, {\'name\': \'촛불수풀 마녀\', \'text\': \'집회 — 당신의 턴 전투 시작에, 당신이 서로 공격력이 다른 생물을 세 개 이상 조종한다면, 촛불수풀 마녀는 턴종료까지 비행을 얻는다.\', \'type\': \'생물 — 인간 흑마법사\', \'flavor\': \'"촛불도 천 개가 모이면 어둠을 물리치는 것처럼, 우리는 함께할 때 가장 강하다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536658&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ee30094d-a7d4-439e-ae6a-9c6dec95e4ea\', \'multiverseId\': 536658}, \'multiverseid\': 536658}, {\'name\': \'Bruxa do Bosque das Velas\', \'text\': \'Conventículo — No início do combate no seu turno, se você controla três ou mais criaturas com poderes diferentes, Bruxa do Bosque das Velas ganha voar até o final do turno.\', \'type\': \'Criatura — Humano Bruxo\', \'flavor\': \'"Como mil velas rechaçando a escuridão, somos mais fortes quando nos unimos."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536974&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'51e898f3-53f1-45ac-aebb-28c6aa618e4b\', \'multiverseId\': 536974}, \'multiverseid\': 536974}, {\'name\': \'Ведьма Свечной Рощи\', \'text\': \'Шабаш — В начале боя во время вашего хода, если вы контролируете не менее трех существ с различными значениями силы, Ведьма Свечной Рощи получает Полет до конца хода.\', \'type\': \'Существо — Человек Колдун\', \'flavor\': \'«Как тысяча свечей, разгоняющих тьму, мы сильнее, когда мы вместе».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537290&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2c1af241-1e8c-4899-91df-c82d33bffc2c\', \'multiverseId\': 537290}, \'multiverseid\': 537290}, {\'name\': \'烛光林巫婆\', \'text\': \'鸠集～在你回合的战斗开始时，若你操控三个或更多力量各不相同的生物，则烛光林巫婆获得飞行异能直到回合结束。\', \'type\': \'生物 ～人类／邪术师\', \'flavor\': \'「烛光千缕便能照退黑暗，同心一致才能展现雄威。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537606&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d384011a-67cb-4b41-843b-7328c12805af\', \'multiverseId\': 537606}, \'multiverseid\': 537606}, {\'name\': \'燭光林巫婆\', \'text\': \'鳩集～在你回合的戰鬥開始時，若你操控三個或更多力量各不相同的生物，則燭光林巫婆獲得飛行異能直到回合結束。\', \'type\': \'生物 ～人類／邪術師\', \'flavor\': \'「燭光千縷便能照退黑暗，同心一致才能展現雄威。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537922&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3e65b3fb-41eb-4284-a18b-5536fadab18a\', \'multiverseId\': 537922}, \'multiverseid\': 537922}]', '[{\'name\': \'Kerzenschein-Kavallerie\', \'text\': \'Hexenzirkel — Zu Beginn des Kampfes in deinem Zug und falls du drei oder mehr Kreaturen mit unterschiedlicher Stärke kontrollierst, verursacht die Kerzenschein-Kavallerie Trampelschaden bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': \'„In dieser Nacht wird die Dunkelheit uns fürchten."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535277&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2af88275-499d-473b-97a3-e021c7e6918f\', \'multiverseId\': 535277}, \'multiverseid\': 535277}, {\'name\': \'Caballería alumbrada con velas\', \'text\': \'Aquelarre — Al comienzo del combate en tu turno, si controlas tres o más criaturas con fuerzas distintas, la Caballería alumbrada con velas gana la habilidad de arrollar hasta el final del turno.\', \'type\': \'Criatura — Caballero humano\', \'flavor\': \'"A partir de esta noche, la oscuridad tendrá miedo de nosotros".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535593&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d4f45c39-a2e6-4d66-976b-0a611f6adb8b\', \'multiverseId\': 535593}, \'multiverseid\': 535593}, {\'name\': \'Cavalerie aux chandelles\', \'text\': "Congrégation — Au début du combat pendant votre tour, si vous contrôlez au moins trois créatures avec des forces différentes, la Cavalerie aux chandelles acquiert le piétinement jusqu\'à la fin du tour.", \'type\': \'Créature : humain et chevalier\', \'flavor\': \'« Cette nuit, les ténèbres nous craindront. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535909&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5cb77215-3e7d-4c83-9bea-e684a2d8348f\', \'multiverseId\': 535909}, \'multiverseid\': 535909}, {\'name\': \'Cavalleria a Lume di Candela\', \'text\': "Congrega — All\'inizio del combattimento nel tuo turno, se controlli tre o più creature con forza diversa, la Cavalleria a Lume di Candela ha travolgere fino alla fine del turno.", \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': \'"Questa notte, il buio avrà paura di noi."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536225&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3de7532d-2777-4cb0-8e1a-38c8ae76472d\', \'multiverseId\': 536225}, \'multiverseid\': 536225}, {\'name\': \'蝋燭明かりの騎兵\', \'text\': \'集会 — あなたのターンの戦闘の開始時に、あなたがパワーが異なる３体以上のクリーチャーをコントロールしている場合、ターン終了時まで、蝋燭明かりの騎兵はトランプルを得る。\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': \'「今夜は、闇が我らを恐れるだろう。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536541&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'00ec1cdf-9dd5-4928-917f-2d168ba0698a\', \'multiverseId\': 536541}, \'multiverseid\': 536541}, {\'name\': \'촛불을 밝힌 기병대\', \'text\': \'집회 — 당신의 턴 전투 시작에, 당신이 서로 공격력이 다른 생물을 세 개 이상 조종한다면, 촛불을 밝힌 기병대는 턴종료까지 돌진을 얻는다.\', \'type\': \'생물 — 인간 기사\', \'flavor\': \'"오늘 밤에는, 어둠이 우리를 두려워할 것이다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536857&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'28565f09-4075-468c-8ced-2a416102a4a2\', \'multiverseId\': 536857}, \'multiverseid\': 536857}, {\'name\': \'Cavalaria à Luz de Velas\', \'text\': \'Conventículo — No início do combate no seu turno, se você controlar três ou mais criaturas com poderes diferentes, Cavalaria à Luz de Velas ganha atropelar até o final do turno.\', \'type\': \'Criatura — Humano Cavaleiro\', \'flavor\': \'"Esta noite as trevas nos temerão."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537173&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'374b48fc-5908-4f34-88ac-3664316aea6a\', \'multiverseId\': 537173}, \'multiverseid\': 537173}, {\'name\': \'Свечная Кавалерия\', \'text\': \'Шабаш — В начале боя во время вашего хода, если вы контролируете не менее трех существ с различными значениями силы, Свечная Кавалерия получает Пробивной удар до конца хода.\', \'type\': \'Существо — Человек Рыцарь\', \'flavor\': \'«В эту ночь темнота будет бояться нас».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537489&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'058c9b9d-d889-4e88-a069-01454a8eaf38\', \'multiverseId\': 537489}, \'multiverseid\': 537489}, {\'name\': \'烛光骑兵\', \'text\': \'鸠集～在你回合的战斗开始时，若你操控三个或更多力量各不相同的生物，则烛光骑兵获得践踏异能直到回合结束。\', \'type\': \'生物 ～人类／骑士\', \'flavor\': \'「今晚，该黑暗惧怕我们。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537805&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'353a5e8a-58a1-45a6-89e2-83337ef29ad2\', \'multiverseId\': 537805}, \'multiverseid\': 537805}, {\'name\': \'燭光騎兵\', \'text\': \'鳩集～在你回合的戰鬥開始時，若你操控三個或更多力量各不相同的生物，則燭光騎兵獲得踐踏異能直到回合結束。\', \'type\': \'生物 ～人類／騎士\', \'flavor\': \'「今晚，該黑暗懼怕我們。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538121&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c9d63a15-2203-44df-98ae-b23f21679995\', \'multiverseId\': 538121}, \'multiverseid\': 538121}]', '[{\'name\': \'Klingenbrand\', \'text\': \'Eine Kreatur deiner Wahl erhält Todesberührung bis zum Ende des Zuges.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'Skirsdag-Kultisten glauben, dass das richtige Gift eine verdorbene Seele „läutert", bevor sie sich auf den Weg zu Ormendahl macht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535171&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'22335b63-3764-4642-b307-50c6008f526d\', \'multiverseId\': 535171}, \'multiverseid\': 535171}, {\'name\': \'Marcar al rojo vivo\', \'text\': \'La criatura objetivo gana la habilidad de toque mortal hasta el final del turno.\\nRoba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'Los sectarios Skirsdag creen que el veneno adecuado "purifica" un alma corrompida antes de que esta llegue a Ormendahl.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535487&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'58540f21-8162-4e5f-a40a-5d9152e31aa6\', \'multiverseId\': 535487}, \'multiverseid\': 535487}, {\'name\': \'Lame-brandon\', \'text\': "Une créature ciblée acquiert le contact mortel jusqu\'à la fin du tour.\\nPiochez une carte.", \'type\': \'Éphémère\', \'flavor\': "Les cultistes de Skirsdag croient que le poison approprié « purifie » une âme souillée avant qu\'elle ne rejoigne Ormendahl.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535803&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b82053c3-df42-4cdd-b325-04050ee5212f\', \'multiverseId\': 535803}, \'multiverseid\': 535803}, {\'name\': \'Lame Ustionanti\', \'text\': \'Una creatura bersaglio ha tocco letale fino alla fine del turno.\\nPesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'I cultisti Skirsdag credono che il giusto veleno possa "purificare" un\\\'anima corrotta prima che si presenti a Ormendahl.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536119&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'521173a5-f1a7-4ab9-8037-72de04bf2f10\', \'multiverseId\': 536119}, \'multiverseid\': 536119}, {\'name\': \'焼印刃\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは接死を得る。\\nカード１枚を引く。\', \'type\': \'インスタント\', \'flavor\': \'スカースダグの狂信者は正しい毒を使えばオーメンダールにたどり着く前に穢れた魂を「浄化」する事が出来ると信じている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536435&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ac668d57-2329-4d50-a2a1-90b31cc56fe5\', \'multiverseId\': 536435}, \'multiverseid\': 536435}, {\'name\': \'불꽃칼날술\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 치명타를 얻는다.\\n카드 한 장을 뽑는다.\', \'type\': \'순간마법\', \'flavor\': \'스커스대그 광신도들은 올바른 독약을 사용하면 타락한 영혼이 오르멘달을 만나기 전에 그 영혼을 "정화"해 준다고 믿는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536751&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0daf5fbf-4dda-446e-8b2b-15c40d81b759\', \'multiverseId\': 536751}, \'multiverseid\': 536751}, {\'name\': \'Lâmina Cauterizante\', \'text\': \'A criatura alvo ganha toque mortífero até o final do turno.\\nCompre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os cultistas de Skirsdag acreditam que o veneno certo "purifica" uma alma maculada antes que ela siga para Ormendahl.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537067&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b0fa47d4-653b-4520-a5de-713eff35e3c5\', \'multiverseId\': 537067}, \'multiverseid\': 537067}, {\'name\': \'Клеймящие Клинки\', \'text\': \'Целевое существо получает Смертельное касание до конца хода.\\nВозьмите карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Культисты Скирдага верят, что правильный яд «очищает» испорченную душу перед тем, как та отправляется к Ормендалю.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537383&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e551fcfc-0581-44e9-bb00-9ff48ccdfdef\', \'multiverseId\': 537383}, \'multiverseid\': 537383}, {\'name\': \'炙烤剑尖\', \'text\': \'目标生物获得死触异能直到回合结束。\\n抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'史革达教众相信，在污化灵魂见到欧魔达之前，用对毒药便能将其「净化」。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537699&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2a10305c-5374-48e4-9e28-8cf0b332684d\', \'multiverseId\': 537699}, \'multiverseid\': 537699}, {\'name\': \'炙烤劍尖\', \'text\': \'目標生物獲得死觸異能直到回合結束。\\n抽一張牌。\', \'type\': \'瞬間\', \'flavor\': \'史革達教眾相信，在污化靈魂見到歐魔達之前，用對毒藥便能將其「淨化」。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538015&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'752a9fc6-1e52-4483-be22-3b37f0b37055\', \'multiverseId\': 538015}, \'multiverseid\': 538015}]', '[{\'name\': \'Klingendurchbohrter Skaab\', \'text\': \'Andere Zombies, die du kontrollierst, erhalten +1/+0.\', \'type\': \'Kreatur — Zombie, Soldat\', \'flavor\': \'Die überlebenden Mitglieder der Miliz wurden schneller wieder mit ihren gefallenen Kameraden vereint, als sie gehofft hatten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535320&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6eeb47a1-abf4-48d8-b30b-b11a63eaea9d\', \'multiverseId\': 535320}, \'multiverseid\': 535320}, {\'name\': \'Skaab armasuturadas\', \'text\': \'Los otros Zombies que controlas obtienen +1/+0.\', \'type\': \'Criatura — Soldado zombie\', \'flavor\': \'Los milicianos supervivientes se reunieron con sus compañeros fallecidos mucho antes de lo esperado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535636&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'72a1f412-3ae0-4638-8477-b981fb4e4c96\', \'multiverseId\': 535636}, \'multiverseid\': 535636}, {\'name\': \'Skaab maillé de lames\', \'text\': \'Les autres zombies que vous contrôlez gagnent +1/+0.\', \'type\': \'Créature : zombie et soldat\', \'flavor\': "Les miliciens survivants rejoignirent leurs camarades tombés plus vite qu\'ils ne l\'avaient espéré.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535952&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0076e178-d7f2-4b4b-a585-07c8d29c6dd2\', \'multiverseId\': 535952}, \'multiverseid\': 535952}, {\'name\': \'Skaab Lamacucita\', \'text\': \'Gli altri Zombie che controlli prendono +1/+0.\', \'type\': \'Creatura — Soldato Zombie\', \'flavor\': \'I miliziani sopravvissuti si riunirono con i compagni caduti prima di quanto sperassero.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536268&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e8e790c6-c674-4583-b780-5a78c93ca7aa\', \'multiverseId\': 536268}, \'multiverseid\': 536268}, {\'name\': \'縫込み刃のスカーブ\', \'text\': \'あなたがコントロールしていてこれでないすべてのゾンビは＋１/+０の修整を受ける。\', \'type\': \'クリーチャー — ゾンビ・兵士\', \'flavor\': \'生き残った民兵は願っていたより早く死んだ同胞と再会することになった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536584&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fe48940e-729c-4e0f-a31f-1e72055efb19\', \'multiverseId\': 536584}, \'multiverseid\': 536584}, {\'name\': \'칼을 꿰매붙인 스캅\', \'text\': \'당신이 조종하는 다른 좀비들은 +1/+0을 받는다.\', \'type\': \'생물 — 좀비 병사\', \'flavor\': \'살아남은 민병대 대원들은 그들이 기대했던 것보다 빨리 전우들과 재회했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536900&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'deb6dd9d-c45c-413f-ab07-ab990350d536\', \'multiverseId\': 536900}, \'multiverseid\': 536900}, {\'name\': \'Skaab das Lâminas Suturadas\', \'text\': \'Os outros Zumbis que você controla recebem +1/+0.\', \'type\': \'Criatura — Zumbi Soldado\', \'flavor\': \'Os membros sobreviventes da milícia reencontraram seus camaradas mortos mais cedo do que esperavam.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537216&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0529eb04-9ae3-4ac7-82cd-0821adb3cd8e\', \'multiverseId\': 537216}, \'multiverseid\': 537216}, {\'name\': \'Скааб Лезвий\', \'text\': \'Другие Зомби под вашим контролем получают +1/+0.\', \'type\': \'Существо — Зомби Солдат\', \'flavor\': \'Оставшиеся в живых ополченцы воссоединились с павшими товарищами раньше, чем они надеялись.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537532&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a35d079f-2735-4ddd-9853-0b14fbc55a7f\', \'multiverseId\': 537532}, \'multiverseid\': 537532}, {\'name\': \'刀扎尸嵌\', \'text\': \'由你操控的其他灵俑得+1/+0。\', \'type\': \'生物 ～灵俑／士兵\', \'flavor\': \'幸存民兵队员与过世战友的重逢之日，来得比他们想象的要早一些。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537848&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8e7495e6-ee0a-450f-8816-a90c76e8ec31\', \'multiverseId\': 537848}, \'multiverseid\': 537848}, {\'name\': \'刀扎屍嵌\', \'text\': \'由你操控的其他殭屍得+1/+0。\', \'type\': \'生物 ～殭屍／士兵\', \'flavor\': \'倖存民兵隊員與過世戰友的重逢之日，來得比他們想像的要早一些。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538164&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7b88be82-9888-4627-9f14-04e7889dca06\', \'multiverseId\': 538164}, \'multiverseid\': 538164}]', '[{\'name\': \'Knurrender Wolf\', \'text\': \'{1}{G}: Der Knurrende Wolf erhält +2/+2 bis zum Ende des Zuges. Aktiviere diese Fähigkeit nur einmal pro Zug.\', \'type\': \'Kreatur — Wolf\', \'flavor\': \'„Oh, den Engeln sei Dank. Es ist kein Werwolf, nur ein normaler Wo…"\\n—Bruno, Ulvenwald-Führer, letzte Worte\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535304&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bddf08cc-fac9-4d6e-a14f-1754114daa8f\', \'multiverseId\': 535304}, \'multiverseid\': 535304}, {\'name\': \'Lobo gruñidor\', \'text\': \'{1}{G}: El Lobo gruñidor obtiene +2/+2 hasta el final del turno. Activa esto solo una vez por turno.\', \'type\': \'Criatura — Lobo\', \'flavor\': \'"Uf, gracias a los ángeles. No es un licántropo, sino un lobo nor…".\\n—Últimas palabras de Bruno, guía de Ulvenwald\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535620&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ee3f24d7-6084-4432-a467-53af6fadd51b\', \'multiverseId\': 535620}, \'multiverseid\': 535620}, {\'name\': \'Loup menaçant\', \'text\': "{1}{G} : Le Loup menaçant gagne +2/+2 jusqu\'à la fin du tour. N\'activez qu\'une seule fois par tour.", \'type\': \'Créature : loup\', \'flavor\': "« Oh, les anges soient loués. Ce n\'est pas un loup-garou, c\'est juste un loup ordi... »\\n—Bruno, guide d\'Ulvenwald, derniers mots", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535936&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a97bcc03-3153-44be-94c8-5a30677ead67\', \'multiverseId\': 535936}, \'multiverseid\': 535936}, {\'name\': \'Lupo Ringhiante\', \'text\': \'{1}{G}: Il Lupo Ringhiante prende +2/+2 fino alla fine del turno. Attiva solo una volta per turno.\', \'type\': \'Creatura — Lupo\', \'flavor\': \'"Oh, grazie agli angeli. Non è un mannaro, è un normale lu..."\\n—Bruno, guida di Ulvenwald, ultime parole\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536252&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cae0aeee-e27b-437e-90e0-fad820756415\', \'multiverseId\': 536252}, \'multiverseid\': 536252}, {\'name\': \'うなる狼\', \'text\': \'{1}{G}：ターン終了時まで、うなる狼は＋２/＋２の修整を受ける。毎ターン１回しか起動できない。\', \'type\': \'クリーチャー — 狼\', \'flavor\': \'「ああ、天使様、感謝します。人狼ではないようです。どうやら普通のおお――」\\n――ウルヴェンワルドの先達、ブルーノの最後の言葉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536568&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eb61013a-73d5-4bc2-a2c5-62872096ce2e\', \'multiverseId\': 536568}, \'multiverseid\': 536568}, {\'name\': \'으르렁거리는 늑대\', \'text\': \'{1}{G}: 으르렁거리는 늑대는 턴종료까지 +2/+2를 받는다. 한 턴에 한 번만 활성화할 수 있다.\', \'type\': \'생물 — 늑대\', \'flavor\': \'"오 천사들에게 감사해야겠군. 늑대인간이 아니라, 그냥 늑대 두—"\\n—울벤왈드 안내인, 브루노의 마지막 유언\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536884&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c69ae3a3-3396-4230-931d-bd51749d342c\', \'multiverseId\': 536884}, \'multiverseid\': 536884}, {\'name\': \'Lobo Rosnador\', \'text\': \'{1}{G}: Lobo Rosnador recebe +2/+2 até o final do turno. Ative apenas uma vez a cada turno.\', \'type\': \'Criatura — Lobo\', \'flavor\': \'"Ah, graças aos anjos. Não é um lobisomem, só um lobo comu..."\\n— Bruno, guia do Ulvenwald, últimas palavras\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537200&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'28470013-2b18-4961-8eb0-e42aba194e8a\', \'multiverseId\': 537200}, \'multiverseid\': 537200}, {\'name\': \'Оскалившийся Волк\', \'text\': \'{1}{G}: Оскалившийся Волк получает +2/+2 до конца хода. Активируйте только один раз в каждом ходу.\', \'type\': \'Существо — Волк\', \'flavor\': \'«О, слава ангелам! Это не вервольф, это просто обычный во...»\\n— последние слова Бруно, уленвальдского проводника\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537516&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4d3f4310-303d-44ee-828b-929f51b10b59\', \'multiverseId\': 537516}, \'multiverseid\': 537516}, {\'name\': \'咆哮狼\', \'text\': \'{1}{G}：咆哮狼得+2/+2直到回合结束。每回合只能起动一次。\', \'type\': \'生物 ～狼\', \'flavor\': \'「噢，感恩天使。它不是狼人，只是头普通的拉～」\\n～沃文森向导布鲁诺的遗言\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537832&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cc64fd4a-3b2b-4542-a7dd-4d8a0a59d516\', \'multiverseId\': 537832}, \'multiverseid\': 537832}, {\'name\': \'咆哮狼\', \'text\': \'{1}{G}：咆哮狼得+2/+2直到回合結束。每回合只能起動一次。\', \'type\': \'生物 ～狼\', \'flavor\': \'「噢，感恩天使。牠不是狼人，只是頭普通的拉～」\\n～沃文森嚮導布魯諾的遺言\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538148&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'19818070-f75a-4278-83e2-85b2201cce75\', \'multiverseId\': 538148}, \'multiverseid\': 538148}]', '[{\'name\': \'Kraft der alten Sitten\', \'text\': \'Eine Kreatur deiner Wahl erhält +2/+2 bis zum Ende des Zuges.\\nHexenzirkel — Falls du dann drei oder mehr Kreaturen mit unterschiedlicher Stärke kontrollierst, ziehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'Aufgeladen mit der Macht ihres unterbrochenen Rituals schlugen die Morgenlicht-Hexen auf die Werwolf-Eindringlinge ein.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535293&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e7d27fce-2ecb-4c44-9ac2-dff4ae764b47\', \'multiverseId\': 535293}, \'multiverseid\': 535293}, {\'name\': \'Poder de las viejas costumbres\', \'text\': \'La criatura objetivo obtiene +2/+2 hasta el final del turno.\\nAquelarre — Luego, si controlas tres o más criaturas con fuerzas distintas, roba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'Rebosantes del poder del ritual interrumpido, las brujas de las Ciervas del Alba arremetieron contra los licántropos intrusos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535609&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'37d44c04-634e-4dc3-99b6-ae80ee1cc162\', \'multiverseId\': 535609}, \'multiverseid\': 535609}, {\'name\': \'Puissance des traditions\', \'text\': "Une créature ciblée gagne +2/+2 jusqu\'à la fin du tour.\\nCongrégation — Puis si vous contrôlez au moins trois créatures avec des forces différentes, piochez une carte.", \'type\': \'Éphémère\', \'flavor\': \'Auréolées de la puissance de leur rituel interrompu, les envoûteuses de Cerf-orient se déchaînèrent contre les intrus loups-garous.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535925&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'274e5f65-51d2-4d90-a6c4-5128d4e8af3e\', \'multiverseId\': 535925}, \'multiverseid\': 535925}, {\'name\': \'Potenza delle Antiche Usanze\', \'text\': \'Una creatura bersaglio prende +2/+2 fino alla fine del turno.\\nCongrega — Poi, se controlli tre o più creature con forza diversa, pesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'Traboccanti di potere dal loro rituale interrotto, le streghe Albacorno si scagliarono contro i mannari intrusi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536241&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cb1eee82-9665-40d3-bc39-1e486adf1a97\', \'multiverseId\': 536241}, \'multiverseid\': 536241}, {\'name\': \'旧き道の力\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋２/＋２の修整を受ける。\\n集会 — その後、あなたがパワーが異なる３体以上のクリーチャーをコントロールしているなら、カード１枚を引く。\', \'type\': \'インスタント\', \'flavor\': \'儀式が邪魔されたことで力が有り余っているドーンハルトの魔女は、人狼の侵入者共に猛攻撃した。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536557&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'131a78aa-0d07-4c00-8170-b733c0d5936e\', \'multiverseId\': 536557}, \'multiverseid\': 536557}, {\'name\': \'고대 전통의 힘\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 +2/+2를 받는다.\\n집회 — 그 후 당신이 서로 공격력이 다른 생물을 세 개 이상 조종한다면, 카드 한 장을 뽑는다.\', \'type\': \'순간마법\', \'flavor\': \'방해를 받은 의식에서 나온 넘쳐흐르는 힘과 함께, 새벽수사슴 마녀들은 늑대인간 침입자들에게 맹공을 가했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536873&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ed321710-543c-4f00-8ddd-bb5563be9d32\', \'multiverseId\': 536873}, \'multiverseid\': 536873}, {\'name\': \'Poder dos Costumes Antigos\', \'text\': \'A criatura alvo recebe +2/+2 até o final do turno.\\nConventículo — Depois, se você controlar três ou mais criaturas com poderes diferentes, compre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Ainda tomadas pelo poder do ritual que fora interrompido, as bruxas do Cervo da Aurora partiram para cima dos lobisomens intrusos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537189&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'747320ba-1073-43e1-aadf-40ebd3159acc\', \'multiverseId\': 537189}, \'multiverseid\': 537189}, {\'name\': \'Мощь Старины\', \'text\': \'Целевое существо получает +2/+2 до конца хода.\\nШабаш — Затем, если вы контролируете не менее трех существ с различными значениями силы, возьмите карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Переполненные силой от прерванного ритуала, ведьмы Донхарта ринулись на помешавших им вервольфов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537505&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c7405d00-3fd3-4aa3-be6a-939c9cf78e16\', \'multiverseId\': 537505}, \'multiverseid\': 537505}, {\'name\': \'古道之力\', \'text\': \'目标生物得+2/+2直到回合结束。\\n鸠集～然后如果你操控三个或更多力量各不相同的生物，则抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'曙鹿集女巫浑身满盈从遭阻仪式中获得的力量，奋起反击狼人入侵者。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537821&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f39138dc-15e3-447b-8007-e45b70ce9d9d\', \'multiverseId\': 537821}, \'multiverseid\': 537821}, {\'name\': \'古道之力\', \'text\': \'目標生物得+2/+2直到回合結束。\\n鳩集～然後如果你操控三個或更多力量各不相同的生物，則抽一張牌。\', \'type\': \'瞬間\', \'flavor\': \'曙鹿集女巫渾身滿盈從遭阻儀式中獲得的力量，奮起反擊狼人入侵者。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538137&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7dc5cc00-428f-4c38-85dc-93b18078ee8b\', \'multiverseId\': 538137}, \'multiverseid\': 538137}]', '[{\'name\': \'Kürbislaterne\', \'text\': \'{1}, {T}, opfere die Kürbislaterne: Schicke bis zu eine Karte deiner Wahl aus einem Friedhof ins Exil. Ziehe eine Karte.\\n{1}, schicke die Kürbislaterne aus deinem Friedhof ins Exil: Erzeuge ein Mana einer beliebigen Farbe.\', \'type\': \'Artefakt\', \'flavor\': \'Am Ende des Festivals war sie das Einzige, was noch grinste.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535367&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cc62733b-d293-4221-8f0a-b4e76308eed4\', \'multiverseId\': 535367}, \'multiverseid\': 535367}, {\'name\': \'Calabaza tallada\', \'text\': \'{1}, {T}, sacrificar la Calabaza tallada: Exilia hasta una carta objetivo de un cementerio. Roba una carta.\\n{1}, exiliar la Calabaza tallada de tu cementerio: Agrega un maná de cualquier color.\', \'type\': \'Artefacto\', \'flavor\': \'Cuando acabó el festival, era lo único que sonreía.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535683&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ff086d12-f591-4fe8-85e7-2bc4997bc92c\', \'multiverseId\': 535683}, \'multiverseid\': 535683}, {\'name\': \'Citrouille\', \'text\': "{1}, {T}, sacrifiez la Citrouille : Exilez jusqu\'à une carte ciblée depuis un cimetière. Piochez une carte.\\n{1}, exilez la Citrouille depuis votre cimetière : Ajoutez un mana de la couleur de votre choix.", \'type\': \'Artefact\', \'flavor\': "À la fin du Festival, c\'était la seule chose à encore sourire.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535999&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'21c6cbb0-56ca-4620-8ec9-14f470c81857\', \'multiverseId\': 535999}, \'multiverseid\': 535999}, {\'name\': \'Testa di Zucca\', \'text\': \'{1}, {T}, Sacrifica la Testa di Zucca: Esilia fino a una carta bersaglio da un cimitero. Pesca una carta.\\n{1}, Esilia la Testa di Zucca dal tuo cimitero: Aggiungi un mana di un qualsiasi colore.\', \'type\': \'Artefatto\', \'flavor\': "Alla fine del festival, era l\'unica che ancora sorrideva.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536315&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7804ce24-813c-4259-a89a-9489bd173c04\', \'multiverseId\': 536315}, \'multiverseid\': 536315}, {\'name\': \'ジャック・オー・ランタン\', \'text\': \'{1}, {T}, ジャック・オー・ランタンを生け贄に捧げる：墓地にあるカード最大１枚を対象とする。それを追放する。カード１枚を引く。\\n{1}, あなたの墓地にあるジャック・オー・ランタンを追放する：好きな色１色のマナ１点を加える。\', \'type\': \'アーティファクト\', \'flavor\': \'収穫祭が終わりを迎える頃、笑い続けていたのはこれだけだった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536631&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a5b02e53-69ca-487b-92bb-32de4607ed64\', \'multiverseId\': 536631}, \'multiverseid\': 536631}, {\'name\': \'잭오랜턴\', \'text\': \'{1}, {T}, 잭오랜턴을 희생한다: 무덤에 있는 카드를 최대 한 개까지 목표로 정한다. 그 카드를 추방한다. 카드 한 장을 뽑는다.\\n{1}, 당신의 무덤에서 잭오랜턴을 추방한다: 원하는 색의 마나 한 개를 추가한다.\', \'type\': \'마법물체\', \'flavor\': \'축제가 끝나갈 때쯤이 되자, 여전히 웃고 있는 것은 그것뿐이었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536947&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f8f825f1-8563-4833-9846-ed5070f32ed3\', \'multiverseId\': 536947}, \'multiverseid\': 536947}, {\'name\': \'Jack da Lanterna\', \'text\': \'{1}, {T}, sacrifique Jack da Lanterna: Exile até um card alvo de um cemitério. Compre um card.\\n{1}, exile Jack da Lanterna de seu cemitério: Adicione um mana de qualquer cor.\', \'type\': \'Artefato\', \'flavor\': \'Ao fim do festival, ele era o único que ainda sorria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537263&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'414ebc6e-592b-4d5d-be96-fe1bb80bf8a9\', \'multiverseId\': 537263}, \'multiverseid\': 537263}, {\'name\': \'Тыквенный Фонарь\', \'text\': \'{1}, {T}, пожертвуйте Тыквенный Фонарь: изгоните не более одной целевой карты из кладбища. Возьмите карту.\\n{1}, изгоните Тыквенный Фонарь из вашего кладбища: добавьте одну ману любого цвета.\', \'type\': \'Артефакт\', \'flavor\': \'К концу фестиваля только на его лице осталась улыбка.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537579&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'41c37448-278b-4421-a025-910294be244b\', \'multiverseId\': 537579}, \'multiverseid\': 537579}, {\'name\': \'南瓜灯\', \'text\': \'{1}，{T}，牺牲南瓜灯：将至多一张目标牌从坟墓场放逐。抓一张牌。\\n{1}，从你的坟墓场放逐南瓜灯：加一点任意颜色的法术力。\', \'type\': \'神器\', \'flavor\': \'收成节落幕时，只有它上面还挂着笑脸。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537895&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1e96fcb6-333d-468d-9341-5eab45bd42a3\', \'multiverseId\': 537895}, \'multiverseid\': 537895}, {\'name\': \'南瓜燈\', \'text\': \'{1}，{T}，犧牲南瓜燈：將至多一張目標牌從墳墓場放逐。抽一張牌。\\n{1}，從的墳墓場放逐南瓜燈：加一點任意顏色的魔法力。\', \'type\': \'神器\', \'flavor\': \'收成節落幕時，只有它上面還掛著笑臉。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538211&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'44fa0ba9-07dc-430f-9b81-6b52a42c381e\', \'multiverseId\': 538211}, \'multiverseid\': 538211}]', '[{\'name\': \'Lammholt-Terrorisierer\', \'text\': \'{3}{R}: Eine Kreatur deiner Wahl kann in diesem Zug nicht blocken.\', \'type\': \'Kreatur — Wolf\', \'flavor\': \'„Dieser Tovolar ist kein hirnloser Rohling. Er schickt seine heulenden Untergebenen aus, um ein Dorf monatelang zu terrorisieren. Schlaflose Nächte und Furcht fordern ihren Tribut. Erst dann, wenn die Moral am Tiefpunkt ist, schlägt er zu."\\n—Barnes, Dorfwache\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535240&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fd603e9f-72e9-46b7-a5ec-07ac70ec2b14\', \'multiverseId\': 535240}, \'multiverseid\': 535240}, {\'name\': \'Hostigador de Lambholt\', \'text\': \'{3}{R}: La criatura objetivo no puede bloquear este turno.\', \'type\': \'Criatura — Lobo\', \'flavor\': \'"Ese tal Tovolar no es una bestia sin cerebro. Envía a sus secuaces aulladores a que aterroricen una aldea durante meses. Las noches sin dormir y el miedo pasan factura… Y entonces ataca, cuando la moral está por los suelos".\\n—Barnes, guardia del pueblo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535556&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1e8c0d12-a645-4089-a395-23d292269f18\', \'multiverseId\': 535556}, \'multiverseid\': 535556}, {\'name\': \'Coureur de Lambholt\', \'text\': \'{3}{R} : Une créature ciblée ne peut pas bloquer ce tour-ci.\', \'type\': \'Créature : loup\', \'flavor\': "« Ce Tovolar n\'a rien d\'une brute écervelée. Il envoie ses sbires hurlants terroriser un village pendant des mois. Les nuits blanches et la peur font des ravages. Puis, quand le moral est au plus bas, il attaque. »\\n—Barnes, garde du village", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535872&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5a514798-3a2e-4f69-ba8c-2da72cf47c23\', \'multiverseId\': 535872}, \'multiverseid\': 535872}, {\'name\': \'Razziatore di Lambholt\', \'text\': \'{3}{R}: Una creatura bersaglio non può bloccare in questo turno.\', \'type\': \'Creatura — Lupo\', \'flavor\': \'"Questo Tovolar non è un bruto senza cervello. Manda i suoi servitori ululanti a terrorizzare il villaggio per mesi. Le notti insonni e la paura prendono il sopravvento. Solo allora, quando il morale è al minimo, dà il colpo di grazia."\\n—Barnes, guardia del villaggio\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536188&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9709c0ae-10b8-4a9a-bfea-4d399190209e\', \'multiverseId\': 536188}, \'multiverseid\': 536188}, {\'name\': \'ラムホルトの侵略者\', \'text\': \'{3}{R}：クリーチャー１体を対象とする。このターン、それではブロックできない。\', \'type\': \'クリーチャー — 狼\', \'flavor\': \'「このトヴォラーという者は無能な粗暴者なんかではない。彼はその吠える手下どもを村に送り込み、幾月にもわたって恐怖に怯えさせるのだ。眠れぬ夜と畏怖は皆の精神を削る。そして士気が一番盛り下がった頃を狙って、彼は襲うのだ。」\\n――村の見張り、バーンズ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536504&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'057d3c05-7256-4f26-8afb-8111759e11ba\', \'multiverseId\': 536504}, \'multiverseid\': 536504}, {\'name\': \'램홀트 해리어\', \'text\': \'{3}{R}: 생물을 목표로 정한다. 그 생물은 이 턴에 방어할 수 없다.\', \'type\': \'생물 — 늑대\', \'flavor\': \'"이 토볼라르라는 녀석은 덩치만 큰 멍청한 놈이 아니야. 그 녀석은 울부짖는 하수인들을 보내서 몇 달 동안 마을을 공포에 떨게 만들었지. 잠 못 이루는 밤과 공포 때문에 피해가 막심했지. 그 녀석은 사기가 가장 낮은 바로 그때가 돼서야 공격해 온다고."\\n—마을 경비대, 반스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536820&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'281caf2d-aa74-4b38-b465-36250fc47036\', \'multiverseId\': 536820}, \'multiverseid\': 536820}, {\'name\': \'Devastador de Lambholt\', \'text\': \'{3}{R}: A criatura alvo não pode bloquear neste turno.\', \'type\': \'Criatura — Lobo\', \'flavor\': \'"Esse Tovolar não é nenhum brutamontes mentecapto. Ele manda os lacaios uivantes para aterrorizar o vilarejo durante meses. As noites sem dormir aliadas ao medo cobram seu preço. E só aí, quando o moral está lá embaixo, é que ele ataca."\\n— Barnes, vigia do vilarejo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537136&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5d5e03ea-462e-487f-b3b2-572f53916ff7\', \'multiverseId\': 537136}, \'multiverseid\': 537136}, {\'name\': \'Ламбхольтский Налетчик\', \'text\': \'{3}{R}: целевое существо не может блокировать в этом ходу.\', \'type\': \'Существо — Волк\', \'flavor\': \'«Этот Товолар — не безмозглый громила. Сперва он несколько месяцев подряд отправляет своих воющих приспешников терроризировать деревню. Бессонные ночи и страх приносят свои плоды. Лишь когда дух селян падает на самое дно, он наносит удар».\\n— Барнс, деревенский стражник\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537452&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'41d27fbe-ba46-48c4-92a9-dfac807a0cc4\', \'multiverseId\': 537452}, \'multiverseid\': 537452}, {\'name\': \'羊屯猎兔犬\', \'text\': \'{3}{R}：目标生物本回合不能进行阻挡。\', \'type\': \'生物 ～狼\', \'flavor\': \'「这个托瓦拉并非无脑蛮汉。他会派遣手下嚎群接连数月侵扰村庄，让民众夜夜无眠，恐惧气息逐步蔓延。等到士气最低落时才会出手袭击。」\\n～村庄守夜人巴恩斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537768&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'77e30464-1ad6-4964-9fb6-29c06a1f28b3\', \'multiverseId\': 537768}, \'multiverseid\': 537768}, {\'name\': \'羊屯獵兔犬\', \'text\': \'{3}{R}：目標生物本回合不能進行阻擋。\', \'type\': \'生物 ～狼\', \'flavor\': \'「這個托瓦拉並非無腦蠻漢。他會派遣手下嚎群接連數月侵擾村莊，讓民眾夜夜無眠，恐懼氣息逐步蔓延。等到士氣最低落時才會出手襲擊。」\\n～村莊守夜人巴恩斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538084&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'955f0fbb-0c10-4c7e-b6b6-63e7e48aa58d\', \'multiverseId\': 538084}, \'multiverseid\': 538084}]', '[{\'name\': \'Lebendig gefressen\', \'text\': \'Opfere eine Kreatur oder bezahle {3}{B} als zusätzliche Kosten, um diesen Zauberspruch zu wirken.\\nSchicke eine Kreatur oder einen Planeswalker deiner Wahl ins Exil.\', \'type\': \'Hexerei\', \'flavor\': \'„Falls ihr ein Stöhnen aus dem Keller hört, ignoriert es. Teilt euch nicht auf. Versperrt einfach die Tür und verbarrikadiert sie."\\n—Emili, Hauptmann der Wache\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535185&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b4a29f47-2025-4ec3-bb69-8e7ff49bab83\', \'multiverseId\': 535185}, \'multiverseid\': 535185}, {\'name\': \'Devorado vivo\', \'text\': \'Como coste adicional para lanzar este hechizo, sacrifica una criatura o paga {3}{B}.\\nExilia la criatura o planeswalker objetivo.\', \'type\': \'Conjuro\', \'flavor\': \'"Si oyen una especie de gruñido en el sótano, no lo investiguen ni se separen. Simplemente, cierren la puerta y bloquéenla".\\n—Emili, capitana de la guardia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535501&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a241d7a1-5d38-4f7e-99f9-28d2ab6c9bca\', \'multiverseId\': 535501}, \'multiverseid\': 535501}, {\'name\': \'Dévoré vivant\', \'text\': \'En tant que coût supplémentaire pour lancer ce sort, sacrifiez une créature ou payez {3}{B}.\\nExilez une cible, créature ou planeswalker.\', \'type\': \'Rituel\', \'flavor\': "« Si vous entendez un grognement dans la cave, n\'allez pas jeter un œil. Ne vous séparez pas. Verrouillez la porte et barricadez-la. »\\n—Emili, capitaine de la garde", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535817&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0a10c2a5-7e9d-47db-90fa-b9964b65ec8f\', \'multiverseId\': 535817}, \'multiverseid\': 535817}, {\'name\': \'Mangiato Vivo\', \'text\': \'Come costo addizionale per lanciare questa magia, sacrifica una creatura o paga {3}{B}.\\nEsilia una creatura o un planeswalker bersaglio.\', \'type\': \'Stregoneria\', \'flavor\': \'"Se sentite un gemito provenire dalla cantina, non indagate. Non vi separate. Bloccate la porta e barricatevi."\\n—Emilia, capitana della guardia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536133&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f47423a9-7563-459a-b14b-171bdc6a4a89\', \'multiverseId\': 536133}, \'multiverseid\': 536133}, {\'name\': \'踊り食い\', \'text\': \'この呪文を唱えるための追加コストとして、クリーチャー１体を生け贄に捧げるか{3}{B}を支払う。\\nクリーチャーやプレインズウォーカーのうち１体を対象とする。それを追放する。\', \'type\': \'ソーサリー\', \'flavor\': \'「地下室からうめき声が聞こえても、確かめに行ってはだめ。別行動は厳禁。とにかく鍵を閉めて、扉を塞ぐのよ。」\\n――護衛隊長、エミリ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536449&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e61bafde-99f3-4901-8507-7bef3a8b2f85\', \'multiverseId\': 536449}, \'multiverseid\': 536449}, {\'name\': \'산 채로 잡아먹히다\', \'text\': \'이 주문을 발동하기 위한 추가비용으로, 생물 한 개를 희생하거나 {3}{B}를 지불한다.\\n생물 또는 플레인즈워커를 목표로 정한다. 그 목표를 추방한다.\', \'type\': \'집중마법\', \'flavor\': \'"지하실에서 신음 소리가 들리면, 조사하지 마라. 흩어지면 안 된다. 문을 잠그고 장애물을 설치해라."\\n—경비대 대장, 에밀리\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536765&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'216306ad-20c8-417f-8e7e-8d0a2d93db1a\', \'multiverseId\': 536765}, \'multiverseid\': 536765}, {\'name\': \'Comido Vivo\', \'text\': \'Como custo adicional para conjurar esta mágica, sacrifique uma criatura ou pague {3}{B}.\\nExile a criatura ou o planeswalker alvo.\', \'type\': \'Feitiço\', \'flavor\': \'"Se vocês ouvirem grunhidos no porão, não investiguem. Não se separem. Só tranquem a porta e façam uma barricada."\\n— Emili, capitã da guarda\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537081&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'63062154-fc6a-48d8-ac0d-f2ec53ac64c9\', \'multiverseId\': 537081}, \'multiverseid\': 537081}, {\'name\': \'Съедение Заживо\', \'text\': "В качестве дополнительной стоимости разыгрывания этого заклинания пожертвуйте существо или заплатите {3}{B}.\\nИзгоните целевое существо или planeswalker\'а.", \'type\': \'Волшебство\', \'flavor\': \'«Если услышите стон в подвале, не пытайтесь посмотреть, что там. Не вздумайте разделяться. Просто заприте дверь и подоприте ее как следует».\\n— Эмили, капитан стражи\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537397&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c2489e4a-1cbf-4345-9823-c280f14aba72\', \'multiverseId\': 537397}, \'multiverseid\': 537397}, {\'name\': \'生吞活剥\', \'text\': \'牺牲一个生物或支付{3}{B}，以作为施放此咒语的额外费用。\\n放逐目标生物或鹏洛客。\', \'type\': \'法术\', \'flavor\': \'「如果你听见地窖传出呻吟声，不要好奇妄动。不要分头行事。只管闩紧门口，全力顶住。」\\n～守卫队长艾蜜莉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537713&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'28acf0d7-4952-4b5b-a81f-316f90d7ad23\', \'multiverseId\': 537713}, \'multiverseid\': 537713}, {\'name\': \'生吞活剝\', \'text\': \'犧牲一個生物或支付{3}{B}，以作為施放此咒語的額外費用。\\n放逐目標生物或鵬洛客。\', \'type\': \'巫術\', \'flavor\': \'「如果你聽見地窖傳出呻吟聲，不要好奇妄動。不要分頭行事。只管閂緊門口，全力頂住。」\\n～守衛隊長艾蜜莉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538029&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2c2e87d3-e318-4146-9150-47a8912607ba\', \'multiverseId\': 538029}, \'multiverseid\': 538029}]', '[{\'name\': \'Leichenflicken\', \'text\': \'Opfere als zusätzliche Kosten, um diesen Zauberspruch zu wirken, eine beliebige Anzahl an Kreaturen.\\nErzeuge einen X/X blauen und schwarzen Zombie-Kreaturenspielstein mit Bedrohlichkeit, wobei X gleich der Gesamtstärke der geopferten Kreaturen ist.\\nRückblende {3}{U}{B} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten und zusätzliche Kosten wirken. Schicke sie danach ins Exil.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535322&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6534db7a-2f87-4c37-9de8-14ab2ebcd6e0\', \'multiverseId\': 535322}, \'multiverseid\': 535322}, {\'name\': \'Cadáver improvisado\', \'text\': \'Como coste adicional para lanzar este hechizo, sacrifica cualquier cantidad de criaturas.\\nCrea una ficha de criatura Zombie azul y negra X/X con la habilidad de amenaza, donde X es la fuerza total de las criaturas sacrificadas.\\nRetrospectiva {3}{U}{B}. (Puedes lanzar esta carta desde tu cementerio pagando su coste de retrospectiva y cualquier coste adicional. Luego exíliala.)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535638&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fd461d9d-197d-4625-828c-f2d06e698633\', \'multiverseId\': 535638}, \'multiverseid\': 535638}, {\'name\': \'Réparation de cadavre\', \'text\': "En tant que coût supplémentaire pour lancer ce sort, sacrifiez n\'importe quel nombre de créatures.\\nCréez un jeton de créature X/X bleue et noire Zombie avec la menace, X étant la force totale des créatures sacrifiées.\\nFlashback {3}{U}{B} (Vous pouvez lancer cette carte depuis votre cimetière pour son coût de flashback et ses coûts supplémentaires. Exilez-la ensuite.)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535954&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4ef32077-94a1-44b5-816c-c6b36020dd04\', \'multiverseId\': 535954}, \'multiverseid\': 535954}, {\'name\': \'Rabberciare Cadaveri\', \'text\': \'Come costo addizionale per lanciare questa magia, sacrifica un qualsiasi numero di creature.\\nCrea una pedina creatura Zombie X/X blu e nera con minacciare, dove X è la forza totale delle creature sacrificate.\\nFlashback {3}{U}{B} (Puoi lanciare questa carta dal tuo cimitero pagando il suo costo di flashback e qualsiasi costo addizionale. Poi esiliala.)\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536270&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1c5de052-2053-4f79-a3dc-a31603ea57a7\', \'multiverseId\': 536270}, \'multiverseid\': 536270}, {\'name\': \'継ぎ接ぎ死体\', \'text\': \'この呪文を唱えるための追加コストとして、望む数のクリーチャーを生け贄に捧げる。\\n威迫を持つ青黒のＸ/Ｘのゾンビ・クリーチャー・トークン１体を生成する。Ｘは生け贄に捧げたクリーチャーのパワーの合計に等しい。\\nフラッシュバック{3}{U}{B}（あなたはあなたの墓地にあるこのカードを、これのフラッシュバック・コストと追加コストで唱えてもよい。その後、これを追放する。）\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536586&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e9373bca-9da0-49ca-9c39-51b5740918be\', \'multiverseId\': 536586}, \'multiverseid\': 536586}, {\'name\': \'시체 꿰맞추기\', \'text\': \'이 주문을 발동하기 위한 추가비용으로, 생물을 원하는 수만큼 희생한다.\\n호전적을 가진 X/X 청색 및 흑색 좀비 생물 토큰 한 개를 만든다. X는 희생된 생물들의 공격력의 총합이다.\\n회상 {3}{U}{B} (당신은 이 카드의 회상 비용과 추가비용을 지불해 이 카드를 당신의 무덤에서 발동할 수 있다. 그 후 이 카드를 추방한다.)\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536902&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5965b62e-455e-47cb-a5f8-1da8918c8687\', \'multiverseId\': 536902}, \'multiverseid\': 536902}, {\'name\': \'Remendo de Cadáver\', \'text\': \'Como custo adicional para conjurar esta mágica, sacrifique qualquer número de criaturas.\\nCrie uma ficha de criatura Zumbi azul e preta X/X com ameaçar, sendo X o total de poder das criaturas sacrificadas.\\nRecapitular {3}{U}{B} (Você pode conjurar este card de seu cemitério pagando seu custo de recapitulação e quaisquer custos adicionais. Depois, exile-o.)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537218&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4088f301-d7ad-4bd2-a928-74a23dc6ca06\', \'multiverseId\': 537218}, \'multiverseid\': 537218}, {\'name\': \'Трупная Халтура\', \'text\': \'В качестве дополнительной стоимости разыгрывания этого заклинания пожертвуйте любое количество существ.\\nСоздайте одну фишку существа X/X синий и черный Зомби с Угрозой, где X — сумма значений силы пожертвованных существ.\\nВоспоминание {3}{U}{B} (Вы можете разыграть эту карту из вашего кладбища за ее стоимость Воспоминания и все дополнительные стоимости. Затем изгоните ее.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537534&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4a10ba0b-9f84-47ad-87de-e9f2e50015d7\', \'multiverseId\': 537534}, \'multiverseid\': 537534}, {\'name\': \'拼凑尸身\', \'text\': \'牺牲任意数量的生物，以作为施放此咒语的额外费用。\\n派出一个X/X，蓝黑双色，具威慑异能的灵俑衍生生物，X为所牺牲之生物的力量总和。\\n返照{3}{U}{B}（你可以从你坟墓场中施放此牌，并支付其返照费用以及任何额外费用，然后将它放逐。）\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537850&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a9178f5a-5103-47ee-97a5-fc4fc49f045d\', \'multiverseId\': 537850}, \'multiverseid\': 537850}, {\'name\': \'拼湊屍身\', \'text\': \'犧牲任意數量的生物，以作為施放此咒語的額外費用。\\n派出一個X/X，藍黑雙色，具威懾異能的殭屍衍生生物，X為所犧牲之生物的力量總和。\\n返照{3}{U}{B}（你可以從你墳墓場中施放此牌，並支付其返照費用以及任何額外費用，然後將它放逐。）\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538166&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'44f33b79-5c40-4e93-875b-c41351d69677\', \'multiverseId\': 538166}, \'multiverseid\': 538166}]', '[{\'name\': \'Leuchtfeuer der Hoffnung\', \'text\': \'Eine Kreatur deiner Wahl erhält +2/+2 bis zum Ende des Zuges. Falls sie ein Mensch ist, erhält sie stattdessen +3/+3 und Unzerstörbarkeit bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ich fiel auf die Knie. Ich rief Sigarda an. Und dann sah ich meine Peiniger in gesegnetem Sonnenlicht lodern."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535091&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f5f68b34-a106-4942-b4f0-40830baf7cb1\', \'multiverseId\': 535091}, \'multiverseid\': 535091}, {\'name\': \'Destello de fe\', \'text\': \'La criatura objetivo obtiene +2/+2 hasta el final del turno. Si es un Humano, en vez de eso, obtiene +3/+3 y gana la habilidad de indestructible hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"Me arrodillé y llamé a Sigarda. De repente, vi cómo mis verdugos quedaban abrasados por una luz solar bendita".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535407&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a2f41723-d29f-4f9b-bcf3-13b2296041ed\', \'multiverseId\': 535407}, \'multiverseid\': 535407}, {\'name\': \'Éclat de foi\', \'text\': "Une créature ciblée gagne +2/+2 jusqu\'à la fin du tour. Si c\'est un humain, à la place elle gagne +3/+3 et acquiert l\'indestructible jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': "« Je suis tombée à genoux. J\'ai imploré Sigarda. Puis j\'ai vu mes persécuteurs brûler sous une lumière solaire bénie. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535723&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cc86896c-31f3-4898-a2fa-06601dd80664\', \'multiverseId\': 535723}, \'multiverseid\': 535723}, {\'name\': \'Bagliore della Fede\', \'text\': \'Una creatura bersaglio prende +2/+2 fino alla fine del turno. Se è un Umano, invece prende +3/+3 e ha indistruttibile fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Caddi in ginocchio. Chiamai il nome di Sigarda. E in un attimo i miei persecutori bruciarono nella sacra luce solare."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536039&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a2f62bbd-7fba-4eb0-aee5-39d7fc3c4158\', \'multiverseId\': 536039}, \'multiverseid\': 536039}, {\'name\': \'ほとばしる信仰\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋２/＋２の修整を受ける。それが人間なら、代わりに、ターン終了時まで、それは＋３/＋３の修整を受け破壊不能を得る。\', \'type\': \'インスタント\', \'flavor\': \'「膝をつき、シガルダの名を呼んだ。すると拷問者が祝福の陽光で燃え立つのを見た。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536355&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'17a0dc79-6c08-4427-9310-981ddc02affc\', \'multiverseId\': 536355}, \'multiverseid\': 536355}, {\'name\': \'믿음의 불꽃\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 +2/+2를 받는다. 그 생물이 인간이라면, 대신 그 생물은 +3/+3을 받고 턴종료까지 무적을 얻는다.\', \'type\': \'순간마법\', \'flavor\': \'"나는 무릎을 꿇었다. 시가르다의 이름을 부르짖었다. 그러자 내게 고통을 주던 자들이 축복받은 태양빛에 불타오르는 것을 보았다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536671&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'deba88b1-1f05-4220-aa98-63bd44bccd45\', \'multiverseId\': 536671}, \'multiverseid\': 536671}, {\'name\': \'Chama da Fé\', \'text\': \'A criatura alvo recebe +2/+2 até o final do turno. Se ela for um Humano, em vez disso, ela recebe +3/+3 e ganha indestrutível até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Caí de joelhos. Invoquei Sigarda. E vi meus inimigos arderem na santa luz do sol."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536987&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2b81b356-7a44-4fcc-a22f-69e9c559035e\', \'multiverseId\': 536987}, \'multiverseid\': 536987}, {\'name\': \'Вспышка Веры\', \'text\': \'Целевое существо получает +2/+2 до конца хода. Если это Человек, то вместо этого оно получает +3/+3 и Неразрушимость до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Я упал на колени. Я воззвал к Сигарде. И тогда я увидел, как моих мучителей поразил благословенный солнечный свет».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537303&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'40861fc2-4266-4d1b-905e-b6a3efb7a267\', \'multiverseId\': 537303}, \'multiverseid\': 537303}, {\'name\': \'信念闪光\', \'text\': \'直到回合结束，目标生物得+2/+2。如果它是人类，则改为直到回合结束，它得+3/+3且获得不灭异能。\', \'type\': \'瞬间\', \'flavor\': \'「我屈身双膝跪地。我虔诚向席嘉妲祈祷。然后我就看到施虐恶物在受福阳光下熊熊燃烧。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537619&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fd299d34-23cd-402a-a06f-c2378805ca84\', \'multiverseId\': 537619}, \'multiverseid\': 537619}, {\'name\': \'信念閃光\', \'text\': \'直到回合結束，目標生物得+2/+2。如果它是人類，則改為直到回合結束，它得+3/+3且獲得不滅異能。\', \'type\': \'瞬間\', \'flavor\': \'「我屈身雙膝跪地。我虔誠向席嘉妲祈禱。然後我就看到施虐惡物在受福陽光下熊熊燃燒。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537935&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0f52f5cb-4629-4e1d-ae64-6cd748ece1d5\', \'multiverseId\': 537935}, \'multiverseid\': 537935}]', '[{\'name\': \'Licht für die Nacht\', \'text\': \'Das Licht für die Nacht fügt einem Ziel deiner Wahl X Schadenspunkte zu. Falls das Ziel eine Kreatur oder ein Planeswalker ist, fügt es ihm stattdessen X plus 1 Schadenspunkte zu.\\nRückblende — {3}{R}, entferne X Loyalitätsmarken von Planeswalkern, die du kontrollierst. Falls du den Zauberspruch auf diese Weise wirkst, kann X nicht 0 sein. (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten wirken. Schicke sie danach ins Exil.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535241&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d9ce6a5a-f843-480c-926e-3b4abb97864d\', \'multiverseId\': 535241}, \'multiverseid\': 535241}, {\'name\': \'Iluminar la noche\', \'text\': \'Iluminar la noche hace X puntos de daño a cualquier objetivo. En vez de eso, hace X más 1 puntos de daño si ese objetivo es una criatura o planeswalker.\\nRetrospectiva—{3}{R}, remover X contadores de lealtad de entre los planeswalkers que controlas. Si lanzas este hechizo de esta manera, X no puede ser 0. (Puedes lanzar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego exíliala.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535557&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b0cd9a41-e69d-4e49-b5d8-b49d562e318f\', \'multiverseId\': 535557}, \'multiverseid\': 535557}, {\'name\': \'Éclairer la nuit\', \'text\': "Éclairer la nuit inflige X blessures à n\'importe quelle cible. Il inflige X plus 1 blessure à la place si cette cible est une créature ou un planeswalker.\\nFlashback — {3}{R}, retirez X marqueurs « loyauté » parmi des planeswalkers que vous contrôlez. Si vous lancez ce sort de cette manière, X ne peut pas être 0. (Vous pouvez lancer cette carte depuis votre cimetière pour son coût de flashback. Exilez-la ensuite.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535873&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dc3c5826-e29b-4f86-a704-3dafef45a4e3\', \'multiverseId\': 535873}, \'multiverseid\': 535873}, {\'name\': \'Illuminare la Notte\', \'text\': \'Illuminare la Notte infligge X danni a un qualsiasi bersaglio. Infligge invece X danni più 1 se quel bersaglio è una creatura o un planeswalker.\\nFlashback—{3}{R}, Rimuovi X segnalini fedeltà scelti tra i planeswalker che controlli. Se hai lanciato questa magia in questo modo, X non può essere 0. (Puoi lanciare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi esiliala.)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536189&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dbf25046-4c98-49e3-b058-0daea79063eb\', \'multiverseId\': 536189}, \'multiverseid\': 536189}, {\'name\': \'夜を照らす\', \'text\': \'クリーチャーやプレインズウォーカーやプレイヤーのうち１つを対象とする。夜を照らすはそれにＸ点のダメージを与える。対象としたものがクリーチャーやプレインズウォーカーであるなら、代わりに、これはそれにＸに１を足した点数のダメージを与える。\\nフラッシュバック—{3}{R}, あなたがコントロールしているプレインズウォーカーの上から忠誠カウンターＸ個を取り除く。これによりあなたがこの呪文を唱えたなら、Ｘは０にできない。（あなたはあなたの墓地にあるこのカードをフラッシュバック・コストで唱えてもよい。その後、これを追放する。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536505&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fafb8e96-2479-45e7-9629-d604f7e192d5\', \'multiverseId\': 536505}, \'multiverseid\': 536505}, {\'name\': \'밤을 밝혀라\', \'text\': \'원하는 목표를 정한다. 밤을 밝혀라는 그 목표에게 피해 X점을 입힌다. 그 목표가 생물 또는 플레인즈워커라면, 밤을 밝혀라는 대신 X에 1을 더한 피해를 입힌다.\\n회상—{3}{R}, 당신이 조종하는 플레인즈워커들에서 충성 카운터를 총 X개 제거한다. 당신이 이런 식으로 이 주문을 발동한다면, X는 0이 될 수 없다. (당신은 이 카드의 회상 비용을 지불해 이 카드를 당신의 무덤에서 발동할 수 있다. 그 후 이 카드를 추방한다.)\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536821&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3d109781-253b-4be6-9344-93a9f61c0843\', \'multiverseId\': 536821}, \'multiverseid\': 536821}, {\'name\': \'Acender a Noite\', \'text\': \'Acender a Noite causa X pontos de dano a qualquer alvo. Se o alvo for uma criatura ou planeswalker, em vez disso, ele causa X pontos de dano mais 1.\\nRecapitular — {3}{R}, remova X marcadores de lealdade de planeswalkers que você controla. Se você conjurar esta mágica dessa forma, X não pode ser 0. (Você pode conjurar este card de seu cemitério pagando seu custo de recapitular. Depois, exile-o.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537137&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7eac7e83-a488-4315-b3b1-27b918ae0eae\', \'multiverseId\': 537137}, \'multiverseid\': 537137}, {\'name\': \'Зажечь Ночь\', \'text\': "Зажечь Ночь наносит X повреждений любой цели. Если та цель является существом или planeswalker\'ом, то вместо этого Зажечь Ночь наносит X плюс 1 повреждение.\\nВоспоминание — {3}{R}, удалите X жетонов верности, находящихся на planeswalker\'ах под вашим контролем. Если вы разыгрываете это заклинание таким образом, Х не может равняться 0. (Вы можете разыграть эту карту из вашего кладбища за ее стоимость Воспоминания. Затем изгоните ее.)", \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537453&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0ca13b76-409a-4a1e-a9e9-8a5220d638c1\', \'multiverseId\': 537453}, \'multiverseid\': 537453}, {\'name\': \'照亮黑夜\', \'text\': \'照亮黑夜对任意一个目标造成X点伤害。如果该目标为生物或鹏洛客，则改为它造成X加1点伤害。\\n返照～{3}{R}，从由你操控的鹏洛客上移去总共X个忠诚指示物。如果你以此法施放此咒语，则X不能为0。（你可以从你坟墓场中施放此牌，并支付其返照费用，然后将它放逐。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537769&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'116aa827-cdf6-4ba4-a0f5-dba595af05cc\', \'multiverseId\': 537769}, \'multiverseid\': 537769}, {\'name\': \'照亮黑夜\', \'text\': \'照亮黑夜對任意一個目標造成X點傷害。如果該目標為生物或鵬洛客，則改為它造成X加1點傷害。\\n返照～{3}{R}，從由你操控的鵬洛客上移去總共X個忠誠指示物。如果你以此法施放此咒語，則X不能為0。（你可以從你墳墓場中施放此牌，並支付其返照費用，然後將它放逐。）\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538085&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'af72fb4e-6af6-4e26-85b1-f099d8241cee\', \'multiverseId\': 538085}, \'multiverseid\': 538085}]', '[{\'name\': \'Licht für die Nacht\', \'text\': \'Das Licht für die Nacht fügt einem Ziel deiner Wahl X Schadenspunkte zu. Falls das Ziel eine Kreatur oder ein Planeswalker ist, fügt es ihm stattdessen X plus 1 Schadenspunkte zu.\\nRückblende — {3}{R}, entferne X Loyalitätsmarken von Planeswalkern, die du kontrollierst. Falls du den Zauberspruch auf diese Weise wirkst, kann X nicht 0 sein.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538772&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1fea0cff-911e-4496-866e-765b9a638026\', \'multiverseId\': 538772}, \'multiverseid\': 538772}, {\'name\': \'Iluminar la noche\', \'text\': \'Iluminar la noche hace X puntos de daño a cualquier objetivo. En vez de eso, hace X más 1 puntos de daño si ese objetivo es una criatura o planeswalker.\\nRetrospectiva—{3}{R}, remover X contadores de lealtad de entre los planeswalkers que controlas. Si lanzas este hechizo de esta manera, X no puede ser 0.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538832&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'212e6c4f-1aab-4ded-b1bf-b6a6e5cdb069\', \'multiverseId\': 538832}, \'multiverseid\': 538832}, {\'name\': \'Éclairer la nuit\', \'text\': "Éclairer la nuit inflige X blessures à n\'importe quelle cible. Il inflige X plus 1 blessure à la place si cette cible est une créature ou un planeswalker.\\nFlashback — {3}{R}, retirez X marqueurs « loyauté » parmi des planeswalkers que vous contrôlez. Si vous lancez ce sort de cette manière, X ne peut pas être 0.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538892&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b1acc289-24eb-4556-be9e-2eeca59cd518\', \'multiverseId\': 538892}, \'multiverseid\': 538892}, {\'name\': \'Illuminare la Notte\', \'text\': \'Illuminare la Notte infligge X danni a un qualsiasi bersaglio. Infligge invece X danni più 1 se quel bersaglio è una creatura o un planeswalker.\\nFlashback—{3}{R}, Rimuovi X segnalini fedeltà scelti tra i planeswalker che controlli. Se hai lanciato questa magia in questo modo, X non può essere 0.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538952&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1a9e3434-9d5e-4c89-896a-fede44efad32\', \'multiverseId\': 538952}, \'multiverseid\': 538952}, {\'name\': \'夜を照らす\', \'text\': \'クリーチャーやプレインズウォーカーやプレイヤーのうち１つを対象とする。夜を照らすはそれにＸ点のダメージを与える。対象としたものがクリーチャーやプレインズウォーカーであるなら、代わりに、これはそれにＸに１を足した点数のダメージを与える。\\nフラッシュバック—{3}{R}, あなたがコントロールしているプレインズウォーカーの上から忠誠カウンターＸ個を取り除く。これによりあなたがこの呪文を唱えたなら、Ｘは０にできない。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539012&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'943f6a78-10db-4506-ba8a-42f07dd1c335\', \'multiverseId\': 539012}, \'multiverseid\': 539012}]', '[{\'name\': \'Lier, Schüler der Versunkenen\', \'text\': \'Zaubersprüche können nicht neutralisiert werden.\\nSpontanzauber- und Hexereikarten in deinem Friedhof haben Rückblende. Die Rückblendekosten jeder Karte sind gleich ihren Manakosten.\', \'type\': \'Legendäre Kreatur — Mensch, Zauberer\', \'flavor\': \'Unter den Wellen regen sich verlorene Götter in ihrem Schlummer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535137&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0ea2d5e7-fae4-4397-8d2b-6f052279eaf5\', \'multiverseId\': 535137}, \'multiverseid\': 535137}, {\'name\': \'Lier, discípulo de los ahogados\', \'text\': \'Los hechizos no pueden ser contrarrestados.\\nCada carta de instantáneo y de conjuro en tu cementerio tiene la habilidad de retrospectiva. El coste de retrospectiva es igual al coste de maná de esa carta.\', \'type\': \'Criatura legendaria — Hechicero humano\', \'flavor\': \'Bajo las olas, los dioses perdidos se revuelven en su letargo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535453&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'416ae9d9-2619-47ca-b66f-a84c2324b88e\', \'multiverseId\': 535453}, \'multiverseid\': 535453}, {\'name\': \'Lier, disciple des noyés\', \'text\': "Les sorts ne peuvent pas être contrecarrés.\\nChaque carte d\'éphémère et de rituel dans votre cimetière a le flashback. Le coût de flashback est égal au coût de mana de cette carte-là.", \'type\': \'Créature légendaire : humain et sorcier\', \'flavor\': "Sous les vagues, des dieux perdus s\'agitent dans leur sommeil.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535769&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8b3590f5-b9d2-4c2c-b107-55ed796ee73a\', \'multiverseId\': 535769}, \'multiverseid\': 535769}, {\'name\': \'Lier, Discepolo degli Annegati\', \'text\': \'Le magie non possono essere neutralizzate.\\nOgni carta istantaneo e stregoneria nel tuo cimitero ha flashback. Il costo di flashback è pari al costo di mana di quella carta.\', \'type\': \'Creatura Leggendaria — Mago Umano\', \'flavor\': \'Sotto le onde, divinità perdute si agitano nel loro sonno.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536085&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'224fde3d-d42a-425a-86e6-3b5348228c0b\', \'multiverseId\': 536085}, \'multiverseid\': 536085}, {\'name\': \'溺神の信奉者、リーア\', \'text\': \'すべての呪文は打ち消されない。\\nあなたの墓地にありインスタントやソーサリーであるすべてのカードはフラッシュバックを持つ。そのフラッシュバック・コストは、そのカードのマナ・コストに等しい。\', \'type\': \'伝説のクリーチャー — 人間・ウィザード\', \'flavor\': \'波の奥底の迷える神々が、眠りから目を覚そうとしている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536401&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c9e21321-6556-4d1a-bb82-1ea12d72bc96\', \'multiverseId\': 536401}, \'multiverseid\': 536401}, {\'name\': \'수장된 자들의 사도, 리어\', \'text\': \'주문들은 무효화될 수 없다.\\n당신의 무덤에 있는 각 순간마법 및 집중마법 카드는 회상을 가진다. 회상 비용은 그 카드의 마나 비용과 같다.\', \'type\': \'전설적 생물 — 인간 마법사\', \'flavor\': \'파도 아래에서, 잊혀진 신들이 잠결에 몸을 흔든다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536717&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'97a7adb6-e275-42cb-9230-4a6e5ed157ad\', \'multiverseId\': 536717}, \'multiverseid\': 536717}, {\'name\': \'Lier, Discípulo dos Afogados\', \'text\': \'As mágicas não podem ser anuladas.\\nCada card de mágica instantânea ou de feitiço em seu cemitério tem recapitular. O custo de recapitular é igual ao custo de mana daquele card.\', \'type\': \'Criatura Lendária — Humano Mago\', \'flavor\': \'Sob as ondas, as divindades perdidas agitam-se em seu sono.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537033&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'df212a20-a8b7-40a1-904b-dd4c34119785\', \'multiverseId\': 537033}, \'multiverseid\': 537033}, {\'name\': \'Льер, Послушник Утопшего\', \'text\': \'Заклинания не могут быть отменены.\\nКаждая карта волшебства и мгновенного заклинания на вашем кладбище имеет Воспоминание. Стоимость Воспоминания равна мана-стоимости той карты.\', \'type\': \'Легендарное Существо — Человек Чародей\', \'flavor\': \'Под волнами забытые боги беспокойно ворочаются во сне.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537349&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'14806a40-1ffb-45a5-9755-0f6497c26af6\', \'multiverseId\': 537349}, \'multiverseid\': 537349}, {\'name\': \'翻涌神信徒列尔\', \'text\': \'咒语都不能被反击。\\n你坟墓场中的每张瞬间与法术牌均具有返照异能。其返照费用等同于该牌的法术力费用。\', \'type\': \'传奇生物 ～人类／法术师\', \'flavor\': \'浪潮之下，遗世神明在沉睡中动身。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537665&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1f1e25c1-da08-4fed-884f-10d654ecd4da\', \'multiverseId\': 537665}, \'multiverseid\': 537665}, {\'name\': \'翻湧神信徒列爾\', \'text\': \'咒語都不能被反擊。\\n你墳墓場中的每張瞬間與巫術牌均具有返照異能。其返照費用等同於該牌的魔法力費用。\', \'type\': \'傳奇生物 ～人類／魔法師\', \'flavor\': \'浪潮之下，遺世神明在沉睡中動身。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537981&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e874b439-f964-41a5-9b70-e90509cfee27\', \'multiverseId\': 537981}, \'multiverseid\': 537981}]', '[{\'name\': \'Lier, Schüler der Versunkenen\', \'text\': \'Zaubersprüche können nicht neutralisiert werden.\\nSpontanzauber- und Hexereikarten in deinem Friedhof haben Rückblende. Die Rückblendekosten jeder Karte sind gleich ihren Manakosten.\', \'type\': \'Legendäre Kreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538509&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'03bc52fc-1018-4897-b0b1-def60327a2ab\', \'multiverseId\': 538509}, \'multiverseid\': 538509}, {\'name\': \'Lier, discípulo de los ahogados\', \'text\': \'Los hechizos no pueden ser contrarrestados.\\nCada carta de instantáneo y de conjuro en tu cementerio tiene la habilidad de retrospectiva. El coste de retrospectiva es igual al coste de maná de esa carta.\', \'type\': \'Criatura legendaria — Hechicero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538526&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9192e891-261a-4170-b1c5-d13a74bf57b9\', \'multiverseId\': 538526}, \'multiverseid\': 538526}, {\'name\': \'Lier, disciple des noyés\', \'text\': "Les sorts ne peuvent pas être contrecarrés.\\nChaque carte d\'éphémère et de rituel dans votre cimetière a le flashback. Le coût de flashback est égal au coût de mana de cette carte-là.", \'type\': \'Créature légendaire : humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538543&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a8da84f6-da2f-4b4c-99f4-80b876e6bd6d\', \'multiverseId\': 538543}, \'multiverseid\': 538543}, {\'name\': \'Lier, Discepolo degli Annegati\', \'text\': \'Le magie non possono essere neutralizzate.\\nOgni carta istantaneo e stregoneria nel tuo cimitero ha flashback. Il costo di flashback è pari al costo di mana di quella carta.\', \'type\': \'Creatura Leggendaria — Mago Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538560&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'505455ea-506e-480d-b82f-3b719936c3f6\', \'multiverseId\': 538560}, \'multiverseid\': 538560}, {\'name\': \'溺神の信奉者、リーア\', \'text\': \'すべての呪文は打ち消されない。\\nあなたの墓地にありインスタントやソーサリーであるすべてのカードはフラッシュバックを持つ。そのフラッシュバック・コストは、そのカードのマナ・コストに等しい。\', \'type\': \'伝説のクリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538577&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6997e777-7ab5-4fde-81ad-4070f56df540\', \'multiverseId\': 538577}, \'multiverseid\': 538577}, {\'name\': \'수장된 자들의 사도, 리어\', \'text\': \'주문들은 무효화될 수 없다.\\n당신의 무덤에 있는 각 순간마법 및 집중마법 카드는 회상을 가진다. 회상 비용은 그 카드의 마나 비용과 같다.\', \'type\': \'전설적 생물 — 인간 마법사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538594&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8df72a98-2ede-443f-b9b3-25015c2bf0d4\', \'multiverseId\': 538594}, \'multiverseid\': 538594}, {\'name\': \'Lier, Discípulo dos Afogados\', \'text\': \'As mágicas não podem ser anuladas.\\nCada card de mágica instantânea ou de feitiço em seu cemitério tem recapitular. O custo de recapitular é igual ao custo de mana daquele card.\', \'type\': \'Criatura Lendária — Humano Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538611&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'03e4c486-6076-4a1d-acaa-ba3b8cdc74bd\', \'multiverseId\': 538611}, \'multiverseid\': 538611}, {\'name\': \'Льер, Послушник Утопшего\', \'text\': \'Заклинания не могут быть отменены.\\nКаждая карта волшебства и мгновенного заклинания на вашем кладбище имеет Воспоминание. Стоимость Воспоминания равна мана-стоимости той карты.\', \'type\': \'Легендарное Существо — Человек Чародей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538628&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b26735d8-34ea-4857-b8c4-339ab29d1a60\', \'multiverseId\': 538628}, \'multiverseid\': 538628}, {\'name\': \'翻涌神信徒列尔\', \'text\': \'咒语都不能被反击。\\n你坟墓场中的每张瞬间与法术牌均具有返照异能。其返照费用等同于该牌的法术力费用。\', \'type\': \'传奇生物 ～人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538645&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e81c8b33-8ae2-40db-b970-cdbc65ebe992\', \'multiverseId\': 538645}, \'multiverseid\': 538645}, {\'name\': \'翻湧神信徒列爾\', \'text\': \'咒語都不能被反擊。\\n你墳墓場中的每張瞬間與巫術牌均具有返照異能。其返照費用等同於該牌的魔法力費用。\', \'type\': \'傳奇生物 ～人類／魔法師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538662&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6b3c35c7-d516-4aa3-b5c6-e55842a73296\', \'multiverseId\': 538662}, \'multiverseid\': 538662}]', '[{\'name\': \'Liesa, Vergessener Erzengel\', \'text\': \'Fliegend, Lebensverknüpfung\\nImmer wenn eine andere Nichtspielsteinkreatur, die du kontrollierst, stirbt, bringe sie zu Beginn des nächsten Endsegments auf die Hand ihres Besitzers zurück.\\nFalls eine Kreatur, die ein Gegner kontrolliert, sterben würde, schicke sie stattdessen ins Exil.\', \'type\': \'Legendäre Kreatur — Engel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535343&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'044c62bc-75a7-4191-9f2d-ad51eac19b45\', \'multiverseId\': 535343}, \'multiverseid\': 535343}, {\'name\': \'Liesa, arcángel olvidado\', \'text\': \'Vuela, vínculo vital.\\nSiempre que otra criatura que no sea ficha que controlas muera, regresa esa carta a la mano de su propietario al comienzo del próximo paso final.\\nSi una criatura que controla un oponente fuera a morir, en vez de eso, exíliala.\', \'type\': \'Criatura legendaria — Ángel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535659&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'df5a8192-f69b-4c35-bd03-31465e1e835e\', \'multiverseId\': 535659}, \'multiverseid\': 535659}, {\'name\': \'Liesa, archange oublié\', \'text\': "Vol, lien de vie\\nÀ chaque fois qu\'une autre créature non-jeton que vous contrôlez meurt, renvoyez cette carte-là dans la main de son propriétaire au début de la prochaine étape de fin.\\nSi une créature qu\'un adversaire contrôle devait mourir, exilez-la à la place.", \'type\': \'Créature légendaire : ange\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535975&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4ef88728-3534-4ad1-868c-035502d892ff\', \'multiverseId\': 535975}, \'multiverseid\': 535975}, {\'name\': \'Liesa, Arcangelo Dimenticato\', \'text\': "Volare, legame vitale\\nOgniqualvolta un\'altra creatura non pedina che controlli muore, fai tornare quella carta in mano al suo proprietario all\'inizio della prossima sottofase finale.\\nSe una creatura controllata da un avversario sta per morire, invece esiliala.", \'type\': \'Creatura Leggendaria — Angelo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536291&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'87f94e74-b010-4f2d-bbc5-078cc48e90a2\', \'multiverseId\': 536291}, \'multiverseid\': 536291}, {\'name\': \'忘れられた大天使、リーサ\', \'text\': \'飛行、絆魂\\nあなたがコントロールしていてトークンでもこれでもないクリーチャー１体が死亡するたび、次の終了ステップの開始時に、そのカードをオーナーの手札に戻す。\\n対戦相手がコントロールしているクリーチャーが死亡するなら、代わりにそれを追放する。\', \'type\': \'伝説のクリーチャー — 天使\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536607&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b3524cc3-3505-4023-8e12-43c8358953bb\', \'multiverseId\': 536607}, \'multiverseid\': 536607}, {\'name\': \'잊혀진 대천사, 리사\', \'text\': \'비행, 생명연결\\n당신이 조종하는 다른 토큰이 아닌 생물이 죽을 때마다, 그 카드를 다음 종료단 시작에 소유자의 손으로 되돌린다.\\n상대가 조종하는 생물이 죽으려 한다면, 대신 그 생물을 추방한다.\', \'type\': \'전설적 생물 — 천사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536923&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f7cf64b7-5fc6-41c7-90e0-5c8bc48589a2\', \'multiverseId\': 536923}, \'multiverseid\': 536923}, {\'name\': \'Liesa, Arcanjo Esquecido\', \'text\': \'Voar, vínculo com a vida\\nToda vez que outra criatura não ficha que você controla morrer, devolva aquele card para a mão de seu dono no início da próxima etapa final.\\nSe uma criatura que um oponente controla morreria, em vez disso, exile-a.\', \'type\': \'Criatura Lendária — Anjo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537239&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'505c79ce-a1c1-490f-9381-9391e5333639\', \'multiverseId\': 537239}, \'multiverseid\': 537239}, {\'name\': \'Лиеса, Забытый Архангел\', \'text\': \'Полет, Цепь жизни\\nКаждый раз, когда другое не являющееся фишкой существо под вашим контролем умирает, верните ту карту в руку ее владельца в начале следующего заключительного шага.\\nЕсли существо под контролем оппонента должно умереть, изгоните его вместо этого.\', \'type\': \'Легендарное Существо — Ангел\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537555&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'76f1dd56-e280-4771-8627-6f9834e98edf\', \'multiverseId\': 537555}, \'multiverseid\': 537555}, {\'name\': \'遗世大天使莉艾莎\', \'text\': \'飞行，系命\\n每当另一个由你操控且非衍生物的生物死去，在下一个结束步骤开始时，将该牌移回其拥有者手上。\\n如果某个由对手操控的生物将死去，则改为将它放逐。\', \'type\': \'传奇生物 ～天使\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537871&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dc728c72-4e7f-435a-838f-6fab0c7927f6\', \'multiverseId\': 537871}, \'multiverseid\': 537871}, {\'name\': \'遺世大天使莉艾莎\', \'text\': \'飛行，繫命\\n每當另一個由你操控且非衍生物的生物死去，在下一個結束步驟開始時，將該牌移回其擁有者手上。\\n如果某個由對手操控的生物將死去，則改為將它放逐。\', \'type\': \'傳奇生物 ～天使\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538187&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5f39f576-b00f-47c4-a7bb-2cfa14beefa4\', \'multiverseId\': 538187}, \'multiverseid\': 538187}]', '[{\'name\': \'Liesa, Vergessener Erzengel\', \'text\': \'Fliegend, Lebensverknüpfung\\nImmer wenn eine andere Nichtspielsteinkreatur, die du kontrollierst, stirbt, bringe sie zu Beginn des nächsten Endsegments auf die Hand ihres Besitzers zurück.\\nFalls eine Kreatur, die ein Gegner kontrolliert, sterben würde, schicke sie stattdessen ins Exil.\', \'type\': \'Legendäre Kreatur — Engel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538517&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7ebb03bc-d049-41eb-af11-e1460c7e7724\', \'multiverseId\': 538517}, \'multiverseid\': 538517}, {\'name\': \'Liesa, arcángel olvidado\', \'text\': \'Vuela, vínculo vital.\\nSiempre que otra criatura que no sea ficha que controlas muera, regresa esa carta a la mano de su propietario al comienzo del próximo paso final.\\nSi una criatura que controla un oponente fuera a morir, en vez de eso, exíliala.\', \'type\': \'Criatura legendaria — Ángel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538534&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'82c1198a-0569-4718-aeb5-72acadfb9357\', \'multiverseId\': 538534}, \'multiverseid\': 538534}, {\'name\': \'Liesa, archange oublié\', \'text\': "Vol, lien de vie\\nÀ chaque fois qu\'une autre créature non-jeton que vous contrôlez meurt, renvoyez cette carte-là dans la main de son propriétaire au début de la prochaine étape de fin.\\nSi une créature qu\'un adversaire contrôle devait mourir, exilez-la à la place.", \'type\': \'Créature légendaire : ange\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538551&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'053122a9-aa82-45fd-8f2e-96ee107f52e0\', \'multiverseId\': 538551}, \'multiverseid\': 538551}, {\'name\': \'Liesa, Arcangelo Dimenticato\', \'text\': "Volare, legame vitale\\nOgniqualvolta un\'altra creatura non pedina che controlli muore, fai tornare quella carta in mano al suo proprietario all\'inizio della prossima sottofase finale.\\nSe una creatura controllata da un avversario sta per morire, invece esiliala.", \'type\': \'Creatura Leggendaria — Angelo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538568&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f808b4da-a54b-4d0f-a9b7-c1d8ef973fc5\', \'multiverseId\': 538568}, \'multiverseid\': 538568}, {\'name\': \'忘れられた大天使、リーサ\', \'text\': \'飛行、絆魂\\nあなたがコントロールしていてトークンでもこれでもないクリーチャー１体が死亡するたび、次の終了ステップの開始時に、そのカードをオーナーの手札に戻す。\\n対戦相手がコントロールしているクリーチャーが死亡するなら、代わりにそれを追放する。\', \'type\': \'伝説のクリーチャー — 天使\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538585&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1bf59521-a861-4c52-a559-02c3bb2d87b0\', \'multiverseId\': 538585}, \'multiverseid\': 538585}, {\'name\': \'잊혀진 대천사, 리사\', \'text\': \'비행, 생명연결\\n당신이 조종하는 다른 토큰이 아닌 생물이 죽을 때마다, 그 카드를 다음 종료단 시작에 소유자의 손으로 되돌린다.\\n상대가 조종하는 생물이 죽으려 한다면, 대신 그 생물을 추방한다.\', \'type\': \'전설적 생물 — 천사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538602&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ea8f939d-97a1-423d-8376-bedb256ebd0e\', \'multiverseId\': 538602}, \'multiverseid\': 538602}, {\'name\': \'Liesa, Arcanjo Esquecido\', \'text\': \'Voar, vínculo com a vida\\nToda vez que outra criatura não ficha que você controla morrer, devolva aquele card para a mão de seu dono no início da próxima etapa final.\\nSe uma criatura que um oponente controla morreria, em vez disso, exile-a.\', \'type\': \'Criatura Lendária — Anjo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538619&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'311fcf00-cbda-4cce-90f8-ad6835b6b9e7\', \'multiverseId\': 538619}, \'multiverseid\': 538619}, {\'name\': \'Лиеса, Забытый Архангел\', \'text\': \'Полет, Цепь жизни\\nКаждый раз, когда другое не являющееся фишкой существо под вашим контролем умирает, верните ту карту в руку ее владельца в начале следующего заключительного шага.\\nЕсли существо под контролем оппонента должно умереть, изгоните его вместо этого.\', \'type\': \'Легендарное Существо — Ангел\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538636&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'52360f8a-3a19-4bf3-9750-04ffe54608e2\', \'multiverseId\': 538636}, \'multiverseid\': 538636}, {\'name\': \'遗世大天使莉艾莎\', \'text\': \'飞行，系命\\n每当另一个由你操控且非衍生物的生物死去，在下一个结束步骤开始时，将该牌移回其拥有者手上。\\n如果某个由对手操控的生物将死去，则改为将它放逐。\', \'type\': \'传奇生物 ～天使\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538653&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bfc76ba2-621c-4e02-a465-66e7ce2acc04\', \'multiverseId\': 538653}, \'multiverseid\': 538653}, {\'name\': \'遺世大天使莉艾莎\', \'text\': \'飛行，繫命\\n每當另一個由你操控且非衍生物的生物死去，在下一個結束步驟開始時，將該牌移回其擁有者手上。\\n如果某個由對手操控的生物將死去，則改為將它放逐。\', \'type\': \'傳奇生物 ～天使\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538670&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0dad21e0-ae56-4310-b705-30200a883f82\', \'multiverseId\': 538670}, \'multiverseid\': 538670}]', '[{\'name\': \'Loyaler Dommelgreif\', \'text\': \'Aufblitzen\\nFliegend\\nWenn der Loyale Dommelgreif ins Spiel kommt, kannst du eine andere Kreatur, die du kontrollierst, auf die Hand ihres Besitzers zurückbringen.\', \'type\': \'Kreatur — Hippogryph\', \'flavor\': \'Silberstreif hatte zwar seine Reiterin verloren, aber nicht seinen Instinkt, der Menschheit zu helfen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535098&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7c05ec75-fa1c-4090-a501-b00dc2ea4d11\', \'multiverseId\': 535098}, \'multiverseid\': 535098}, {\'name\': \'Gryff leal\', \'text\': \'Destello.\\nVuela.\\nCuando la Gryff leal entre al campo de batalla, puedes regresar otra criatura que controlas a la mano de su propietario.\', \'type\': \'Criatura — Hipogrifo\', \'flavor\': \'Plumaplata perdió a su jinete, pero no su instinto para ayudar a la humanidad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535414&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1237ffce-51d7-4543-b174-68a403a9529f\', \'multiverseId\': 535414}, \'multiverseid\': 535414}, {\'name\': \'Gryff loyal\', \'text\': \'Flash\\nVol\\nQuand le Gryff loyal arrive sur le champ de bataille, vous pouvez renvoyer une autre créature que vous contrôlez dans la main de son propriétaire.\', \'type\': \'Créature : hippogriffe\', \'flavor\': "Gripoil avait perdu son cavalier, mais pas son instinct le poussant à aider l\'humanité.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535730&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1ca7b6d7-1ca0-4bea-828b-2ddd149869c9\', \'multiverseId\': 535730}, \'multiverseid\': 535730}, {\'name\': \'Gryff Leale\', \'text\': "Lampo\\nVolare\\nQuando il Gryff Leale entra nel campo di battaglia, puoi far tornare un\'altra creatura che controlli in mano al suo proprietario.", \'type\': \'Creatura — Ippogrifo\', \'flavor\': "Tracciargento aveva perso il suo cavaliere, ma non l\'istinto di proteggere l\'umanità.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536046&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eb28775f-50c6-405d-be72-7ecee5146d51\', \'multiverseId\': 536046}, \'multiverseid\': 536046}, {\'name\': \'忠実なグリフ\', \'text\': \'瞬速\\n飛行\\n忠実なグリフが戦場に出たとき、あなたがコントロールしていてこれでないクリーチャー１体をオーナーの手札に戻してもよい。\', \'type\': \'クリーチャー — ヒポグリフ\', \'flavor\': \'シルバーストリークは乗り手を失ったが、人間たちを助ける本能までは失っていない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536362&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dd8422b6-2304-4865-9019-4852cf0c0113\', \'multiverseId\': 536362}, \'multiverseid\': 536362}, {\'name\': \'충성스러운 그리프\', \'text\': \'섬광\\n비행\\n충성스러운 그리프가 전장에 들어올 때, 당신은 당신이 조종하는 다른 생물을 소유자의 손으로 되돌릴 수 있다.\', \'type\': \'생물 — 히포그리프\', \'flavor\': \'은빛줄기는 자신을 부리던 기수는 잃었지만, 인류를 돕겠다는 본능은 잃지 않았다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536678&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d64050a7-b1da-4793-8ad4-8140e64e3d6b\', \'multiverseId\': 536678}, \'multiverseid\': 536678}, {\'name\': \'Grifino Leal\', \'text\': \'Lampejo\\nVoar\\nQuando Grifino Leal entra no campo de batalha, você pode devolver outra criatura que você controla para a mão de seu dono.\', \'type\': \'Criatura — Hipogrifo\', \'flavor\': \'Flecha-de-prata perdeu sua amazona, mas não seu instinto de ajudar a humanidade.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536994&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2454b27b-b36c-4211-84e2-c269399bf6fc\', \'multiverseId\': 536994}, \'multiverseid\': 536994}, {\'name\': \'Верный Гриф\', \'text\': \'Миг\\nПолет\\nКогда Верный Гриф выходит на поле битвы, вы можете вернуть другое существо под вашим контролем в руку его владельца.\', \'type\': \'Существо — Гиппогриф\', \'flavor\': \'Среброискра потеряла наездника, но ее природное стремление помогать людям осталось с ней.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537310&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'013d8f19-2b78-41b9-bd29-2c66acbef7a6\', \'multiverseId\': 537310}, \'multiverseid\': 537310}, {\'name\': \'忠诚骏鹭\', \'text\': \'闪现\\n飞行\\n当忠诚骏鹭进战场时，你可以将另一个由你操控的生物移回其拥有者手上。\', \'type\': \'生物 ～骏鹰\', \'flavor\': \'虽然银纹失去了背上骑手，但并未忘记救助人类的本能。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537626&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'12c6c8af-9a0a-423e-87e4-15904b7997d6\', \'multiverseId\': 537626}, \'multiverseid\': 537626}, {\'name\': \'忠誠駿鷺\', \'text\': \'閃現\\n飛行\\n當忠誠駿鷺進戰場時，你可以將另一個由你操控的生物移回其擁有者手上。\', \'type\': \'生物 ～駿鷹\', \'flavor\': \'雖然銀紋失去了背上騎手，但並未忘記救助人類的本能。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537942&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c6860cfe-f05d-4518-8064-d05a50b5d256\', \'multiverseId\': 537942}, \'multiverseid\': 537942}]', '[{\'name\': \'Lähmungsnadel\', \'text\': \'Sowie die Lähmungsnadel ins Spiel kommt, bestimme einen Kartennamen.\\nAktivierte Fähigkeiten von Quellen mit dem bestimmten Namen können nicht aktiviert werden, es sei denn, es sind Manafähigkeiten.\', \'type\': \'Artefakt\', \'flavor\': \'Gelegentlich erinnert sich ein Skaab an zu viel aus einem früheren Leben. Glücklicherweise gibt es dagegen ein einfaches Mittel.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535371&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f2e0925a-7bd8-48c0-aa6e-7fd3d7aa4ac0\', \'multiverseId\': 535371}, \'multiverseid\': 535371}, {\'name\': \'Aguja medular\', \'text\': \'En cuanto la Aguja medular entre al campo de batalla, elige un nombre de carta.\\nLas habilidades activadas de las fuentes con el nombre elegido no pueden activarse a menos que sean habilidades de maná.\', \'type\': \'Artefacto\', \'flavor\': \'De vez en cuando, un skaab recuerda demasiado de su vida pasada. Menos mal que hay un remedio sencillo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535687&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6eb70fbc-b6a8-4bb1-8d1e-93fc27a22ccd\', \'multiverseId\': 535687}, \'multiverseid\': 535687}, {\'name\': \'Aiguille à sectionner\', \'text\': "Au moment où l\'Aiguille à sectionner arrive sur le champ de bataille, choisissez un nom de carte.\\nLes capacités activées des sources du nom choisi ne peuvent pas être activées à moins qu\'elles ne soient des capacités de mana.", \'type\': \'Artefact\', \'flavor\': \'Parfois, un skaab se souvient un peu trop de son ancienne vie. Heureusement, il existe un remède simple.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536003&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a2bfd669-8153-4f0b-b600-27a1a14d1197\', \'multiverseId\': 536003}, \'multiverseid\': 536003}, {\'name\': \'Ago Spinale\', \'text\': "Mentre l\'Ago Spinale entra nel campo di battaglia, scegli il nome di una carta.\\nLe abilità attivate delle fonti col nome scelto non possono essere attivate a meno che non siano abilità di mana.", \'type\': \'Artefatto\', \'flavor\': \'Occasionalmente, uno skaab ricorda troppo della sua vita precedente. Fortunatamente, la cura è semplice.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536319&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'46a502cb-d721-4a5b-ac90-a559989d8e90\', \'multiverseId\': 536319}, \'multiverseid\': 536319}, {\'name\': \'真髄の針\', \'text\': \'真髄の針が戦場に出るに際し、カードの名前１つを選ぶ。\\nその選ばれた名前を持つ発生源の起動型能力は、それがマナ能力でないかぎり起動できない。\', \'type\': \'アーティファクト\', \'flavor\': \'時折、スカーブの生前の記憶が蘇り過ぎてしまうことがある。幸いにも、それには単純な治療法がある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536635&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8a25ad2f-c81b-4eee-b681-9a379012c9dc\', \'multiverseId\': 536635}, \'multiverseid\': 536635}, {\'name\': \'연수에 꽂는 바늘\', \'text\': \'연수에 꽂는 바늘이 전장에 들어오면서, 카드 이름 하나를 선택한다.\\n선택한 이름을 가진 원천의 활성화능력은 마나 능력이 아닌 한 활성화될 수 없다.\', \'type\': \'마법물체\', \'flavor\': \'때때로 스캅은 생전의 기억을 너무 많이 기억해내기도 한다. 다행히, 손쉬운 치료법이 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536951&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5d8c6709-6912-4146-8e01-42b28b54b3e7\', \'multiverseId\': 536951}, \'multiverseid\': 536951}, {\'name\': \'Agulha Medular\', \'text\': \'Conforme Agulha Medular entrar no campo de batalha, escolha um nome de card.\\nAs habilidades ativadas de fontes com o nome escolhido não podem ser ativadas, a menos que sejam habilidades de mana.\', \'type\': \'Artefato\', \'flavor\': \'Ocasionalmente, um skaab se lembra demais de sua vida anterior. Por sorte, há uma cura fácil.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537267&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5cc8ec4e-ebad-4c9c-b782-73bc44836fb2\', \'multiverseId\': 537267}, \'multiverseid\': 537267}, {\'name\': \'Смертельная Игла\', \'text\': \'При выходе Смертельной Иглы на поле битвы выберите имя карты.\\nАктивируемые способности источников с выбранным именем не могут быть активированы, если только они не являются мана-способностями.\', \'type\': \'Артефакт\', \'flavor\': \'Иногда скааб слишком много вспоминает о своей прежней жизни. К счастью, для этого есть простое средство.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537583&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1f7e7c41-06e5-43bd-850b-ed374b8b15e0\', \'multiverseId\': 537583}, \'multiverseid\': 537583}, {\'name\': \'穿髓金针\', \'text\': \'于穿髓金针进战场时，选择一个牌名。\\n除了法术力异能之外，具有该名称之来源的起动式异能都不能起动。\', \'type\': \'神器\', \'flavor\': \'有的时候尸嵌会记得前生太多往事。幸运的是，有种办法可以简单解决。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537899&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8eb89ab4-8005-4f6f-90ce-1ab1dc6358ee\', \'multiverseId\': 537899}, \'multiverseid\': 537899}, {\'name\': \'穿髓金針\', \'text\': \'於穿髓金針進戰場時，選擇一個牌名。\\n除了魔法力異能之外，具有該名稱之來源的起動式異能都不能起動。\', \'type\': \'神器\', \'flavor\': \'有的時候屍嵌會記得前生太多往事。幸運的是，有種辦法可以簡單解決。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538215&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ef4ecff2-49e9-468f-81f0-5acb596055a4\', \'multiverseId\': 538215}, \'multiverseid\': 538215}]', '[{\'name\': \'Lähmungsnadel\', \'text\': \'Sowie die Lähmungsnadel ins Spiel kommt, bestimme einen Kartennamen.\\nAktivierte Fähigkeiten von Quellen mit dem bestimmten Namen können nicht aktiviert werden, es sei denn, es sind Manafähigkeiten.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538795&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4292c0ea-7419-4680-a98c-7734733f4587\', \'multiverseId\': 538795}, \'multiverseid\': 538795}, {\'name\': \'Aguja medular\', \'text\': \'En cuanto la Aguja medular entre al campo de batalla, elige un nombre de carta.\\nLas habilidades activadas de las fuentes con el nombre elegido no pueden activarse a menos que sean habilidades de maná.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538855&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'467ec37d-9c36-4d6c-b348-d2d18a5f86db\', \'multiverseId\': 538855}, \'multiverseid\': 538855}, {\'name\': \'Aiguille à sectionner\', \'text\': "Au moment où l\'Aiguille à sectionner arrive sur le champ de bataille, choisissez un nom de carte.\\nLes capacités activées des sources du nom choisi ne peuvent pas être activées à moins qu\'elles ne soient des capacités de mana.", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538915&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bdf52c15-20e2-4cf4-8350-e4a15754aeba\', \'multiverseId\': 538915}, \'multiverseid\': 538915}, {\'name\': \'Ago Spinale\', \'text\': "Mentre l\'Ago Spinale entra nel campo di battaglia, scegli il nome di una carta.\\nLe abilità attivate delle fonti col nome scelto non possono essere attivate a meno che non siano abilità di mana.", \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538975&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3158ce92-64be-4cc2-ae15-bf8934ba124c\', \'multiverseId\': 538975}, \'multiverseid\': 538975}, {\'name\': \'真髄の針\', \'text\': \'真髄の針が戦場に出るに際し、カードの名前１つを選ぶ。\\nその選ばれた名前を持つ発生源の起動型能力は、それがマナ能力でないかぎり起動できない。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539035&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e2fc771b-89ea-40fd-b66e-ce88d9fbbba6\', \'multiverseId\': 539035}, \'multiverseid\': 539035}]', "[{'name': 'Läuternder Drache', 'text': 'Fliegend\\nImmer wenn der Läuternde Drache angreift, fügt er einer Kreatur deiner Wahl, die der verteidigende Spieler kontrolliert, 1 Schadenspunkt zu. Falls die Kreatur ein Zombie ist, fügt der Läuternde Drache ihr stattdessen 2 Schadenspunkte zu.', 'type': 'Kreatur — Drache', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535250&type=card', 'language': 'German', 'identifiers': {'scryfallId': '43a048ab-0a64-4790-bbff-bd0511abd29b', 'multiverseId': 535250}, 'multiverseid': 535250}, {'name': 'Dragón purificador', 'text': 'Vuela.\\nSiempre que el Dragón purificador ataque, hace 1 punto de daño a la criatura objetivo que controla el jugador defensor. Si esa criatura es un Zombie, en vez de eso, el Dragón purificador le hace 2 puntos de daño.', 'type': 'Criatura — Dragón', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535566&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '9923e223-c24f-48da-8846-80fc80c6e504', 'multiverseId': 535566}, 'multiverseid': 535566}, {'name': 'Dragon purificateur', 'text': 'Vol\\nÀ chaque fois que le Dragon purificateur attaque, il inflige 1 blessure à une créature ciblée que le joueur défenseur contrôle. Si cette créature est un zombie, le Dragon purificateur lui inflige 2 blessures à la place.', 'type': 'Créature : dragon', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535882&type=card', 'language': 'French', 'identifiers': {'scryfallId': '8706385e-ba9f-40e2-b110-5181879597eb', 'multiverseId': 535882}, 'multiverseid': 535882}, {'name': 'Drago Purificatore', 'text': 'Volare\\nOgniqualvolta il Drago Purificatore attacca, infligge 1 danno a una creatura bersaglio controllata dal giocatore in difesa. Se quella creatura è uno Zombie, il Drago Purificatore le infligge invece 2 danni.', 'type': 'Creatura — Drago', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536198&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'de6a0b0b-82fb-46f4-9bfc-0301fae9fc20', 'multiverseId': 536198}, 'multiverseid': 536198}, {'name': '浄化するドラゴン', 'text': '飛行\\n浄化するドラゴンが攻撃するたび、防御プレイヤーがコントロールしているクリーチャー１体を対象とする。これはそれに１点のダメージを与える。そのクリーチャーがゾンビであるなら、代わりに、これはそれに２点のダメージを与える。', 'type': 'クリーチャー — ドラゴン', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536514&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'a73475d1-0b5d-4826-8a67-2c89fbd4cb2d', 'multiverseId': 536514}, 'multiverseid': 536514}, {'name': '정화하는 용', 'text': '비행\\n정화하는 용이 공격할 때마다, 수비플레이어가 조종하는 생물을 목표로 정한다. 정화하는 용은 그 생물에게 피해 1점을 입힌다. 그 생물이 좀비라면, 정화하는 용은 대신 그 생물에게 피해 2점을 입힌다.', 'type': '생물 — 용', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536830&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '4fd0cf09-93f5-4b61-b6de-a74ffcd6b288', 'multiverseId': 536830}, 'multiverseid': 536830}, {'name': 'Dragão Purificador', 'text': 'Voar\\nToda vez que Dragão Purificador ataca, ele causa 1 ponto de dano à criatura alvo que o jogador defensor controla. Se aquela criatura for um Zumbi, em vez disso, Dragão Purificador causa 2 pontos de dano a ela.', 'type': 'Criatura — Dragão', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537146&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3d7d242e-b40c-498a-96b4-0822ddfa60aa', 'multiverseId': 537146}, 'multiverseid': 537146}, {'name': 'Очищающий Дракон', 'text': 'Полет\\nКаждый раз, когда Очищающий Дракон атакует, он наносит 1 повреждение целевому существу под контролем защищающегося игрока. Если то существо является Зомби, вместо этого Очищающий Дракон наносит ему 2 повреждения.', 'type': 'Существо — Дракон', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537462&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '0fc489bf-b4f7-4b41-b519-e5c510f2b94d', 'multiverseId': 537462}, 'multiverseid': 537462}, {'name': '净焰巨龙', 'text': '飞行\\n每当净焰巨龙攻击时，它对目标由防御牌手操控的生物造成1点伤害。如果该生物是灵俑，则改为净焰巨龙对它造成2点伤害。', 'type': '生物 ～龙', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537778&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b715def3-6b73-47bf-85df-1cc1839f107e', 'multiverseId': 537778}, 'multiverseid': 537778}, {'name': '淨焰巨龍', 'text': '飛行\\n每當淨焰巨龍攻擊時，它對目標由防禦玩家操控的生物造成1點傷害。如果該生物是殭屍，則改為淨焰巨龍對它造成2點傷害。', 'type': '生物 ～龍', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538094&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '1164b4e7-96f9-42c9-9dfd-0341de745077', 'multiverseId': 538094}, 'multiverseid': 538094}]", '[{\'name\': \'Maske der Heckenhexe\', \'text\': \'Die ausgerüstete Kreatur erhält +1/+1.\\nDie ausgerüstete Kreatur kann von Kreaturen mit Stärke 4 oder mehr nicht geblockt werden.\\nAusrüsten {2} ({2}: Lege diese Karte an eine Kreatur deiner Wahl an, die du kontrollierst. Spiele Ausrüsten wie eine Hexerei.)\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': \'In Kessig wird selbst beim Feiern ein furchterregendes Gesicht getragen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535095&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9a4dd12e-b357-469b-b0c4-c1150ad50a0c\', \'multiverseId\': 535095}, \'multiverseid\': 535095}, {\'name\': \'Máscara de bruja protectora\', \'text\': \'La criatura equipada obtiene +1/+1.\\nLa criatura equipada no puede ser bloqueada por criaturas con fuerza de 4 o más.\\nEquipar {2}. ({2}: Anexa este Equipo a la criatura objetivo que controlas. Activa la habilidad de equipar como un conjuro.)\', \'type\': \'Artefacto — Equipo\', \'flavor\': \'En Kessig, hasta las celebraciones tienen una cara aterradora.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535411&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e6726bf2-3861-4978-a3ac-4dc700be2f3f\', \'multiverseId\': 535411}, \'multiverseid\': 535411}, {\'name\': "Masque d\'envoûteuse des haies", \'text\': "La créature équipée gagne +1/+1.\\nLa créature équipée ne peut pas être bloquée par des créatures de force supérieure ou égale à 4.\\nÉquipement {2} ({2} : Attachez à une créature ciblée que vous contrôlez. N\'attachez l\'équipement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Artefact : équipement\', \'flavor\': \'À Kessig, même les célébrations ont un visage effrayant.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535727&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'12359c6a-915e-4292-9acb-0113fb63430c\', \'multiverseId\': 535727}, \'multiverseid\': 535727}, {\'name\': \'Maschera della Strega delle Siepi\', \'text\': \'La creatura equipaggiata prende +1/+1.\\nLa creatura equipaggiata non può essere bloccata da creature con forza pari o superiore a 4.\\nEquipaggiare {2} ({2}: Assegna a una creatura bersaglio che controlli. Equipaggia solo come una stregoneria.)\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': \'Nel Kessig, anche i festeggiamenti hanno un velo di paura.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536043&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d33586cd-6b0f-4b65-9a2f-9b8e78b60684\', \'multiverseId\': 536043}, \'multiverseid\': 536043}, {\'name\': \'垣魔女の仮面\', \'text\': \'装備しているクリーチャーは＋１/＋１の修整を受ける。\\n装備しているクリーチャーは、パワーが４以上のクリーチャーにはブロックされない。\\n装備{2}（{2}：あなたがコントロールしているクリーチャー１体を対象とする。これをそれにつける。装備はソーサリーとしてのみ行う。）\', \'type\': \'アーティファクト — 装備品\', \'flavor\': \'ケッシグでは、祝祭でも恐ろしげな顔を被る。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536359&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ef55d341-00e5-4dbc-874e-5e81a9e5203c\', \'multiverseId\': 536359}, \'multiverseid\': 536359}, {\'name\': \'울타리마녀의 가면\', \'text\': \'장착된 생물은 +1/+1을 받는다.\\n장착된 생물은 공격력이 4 이상인 생물에게 방어될 수 없다.\\n장착 {2} ({2}: 당신이 조종하는 생물을 목표로 정한다. 그 생물에 이 장비를 부착한다. 집중마법 시기에만 장착할 수 있다.)\', \'type\': \'마법물체 — 장비\', \'flavor\': \'케시그에서는 축제 때조차도 무시무시한 가면을 쓴다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536675&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9f67d795-3126-46ed-9164-e82f0b06dcd8\', \'multiverseId\': 536675}, \'multiverseid\': 536675}, {\'name\': \'Máscara da Bruxa da Sebe\', \'text\': \'A criatura equipada recebe +1/+1.\\nA criatura equipada não pode ser bloqueada por criaturas com poder igual ou superior a 4.\\nEquipar {2} ({2}: Anexe este equipamento à criatura alvo que você controla. Equipe somente como um feitiço.)\', \'type\': \'Artefato — Equipamento\', \'flavor\': \'Em Kessig, mesmo a celebração tem uma aparência assustadora.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536991&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5b6d21e2-8a94-446d-bad1-c12bb02c9d2d\', \'multiverseId\': 536991}, \'multiverseid\': 536991}, {\'name\': \'Маска Сельской Ведьмы\', \'text\': \'Снаряженное существо получает +1/+1.\\nСнаряженное существо не может быть заблокировано существами с силой 4 или больше.\\nСнарядить {2} ({2}: прикрепите к целевому существу под вашим контролем. Снаряжайте только как волшебство.)\', \'type\': \'Артефакт — Снаряжение\', \'flavor\': \'В Кессиге даже у праздника страшное лицо.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537307&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a93662b5-496a-49ad-8dc2-3c71587c4f36\', \'multiverseId\': 537307}, \'multiverseid\': 537307}, {\'name\': \'祝仪巫婆面具\', \'text\': \'佩带此武具的生物得+1/+1。\\n佩带此武具的生物不能被力量等于或大于4的生物阻挡。\\n佩带{2}（{2}：贴附在目标由你操控的生物上。只能于法术时机佩带。）\', \'type\': \'神器 ～武具\', \'flavor\': \'在凯锡革，就连庆典也笼罩恐怖气氛。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537623&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a10397e3-c8c5-46f3-b5e6-d5e8f80c729e\', \'multiverseId\': 537623}, \'multiverseid\': 537623}, {\'name\': \'祝儀巫婆面具\', \'text\': \'佩帶此武具的生物得+1/+1。\\n佩帶此武具的生物不能被力量等於或大於4的生物阻擋。\\n佩帶{2}（{2}：貼附在目標由你操控的生物上。只能於巫術時機佩帶。）\', \'type\': \'神器 ～武具\', \'flavor\': \'在凱錫革，就連慶典也籠罩恐怖氣氛。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537939&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fd9601da-fae9-4bde-acc4-fef5e7c8dff2\', \'multiverseId\': 537939}, \'multiverseid\': 537939}]', '[{\'name\': \'Maske von Griselbrand\', \'text\': \'Die ausgerüstete Kreatur hat Flugfähigkeit und Lebensverknüpfung.\\nImmer wenn die ausgerüstete Kreatur stirbt, kannst du X Lebenspunkte bezahlen, wobei X gleich ihrer Stärke ist. Falls du dies tust, ziehe X Karten.\\nAusrüsten {3}\', \'type\': \'Legendäres Artefakt — Ausrüstung\', \'flavor\': \'Das Erbe des Bösen lebt weiter.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535201&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e939c5cb-7f5a-4a15-bd06-e11d4701b2c0\', \'multiverseId\': 535201}, \'multiverseid\': 535201}, {\'name\': \'Máscara de Griselbrand\', \'text\': \'La criatura equipada tiene las habilidades de volar y vínculo vital.\\nSiempre que la criatura equipada muera, puedes pagar X vidas, donde X es su fuerza. Si lo haces, roba X cartas.\\nEquipar {3}.\', \'type\': \'Artefacto legendario — Equipo\', \'flavor\': \'El legado del mal perdura.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535517&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0a390d36-b03a-4f56-8a1d-e1a4cbc94daf\', \'multiverseId\': 535517}, \'multiverseid\': 535517}, {\'name\': \'Masque de Griselbrand\', \'text\': \'La créature équipée a le vol et le lien de vie.\\nÀ chaque fois que la créature équipée meurt, vous pouvez payer X points de vie, X étant sa force. Si vous faites ainsi, piochez X cartes.\\nÉquipement {3}\', \'type\': \'Artefact légendaire : équipement\', \'flavor\': "L\'héritage du mal perdure.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535833&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'eb1717d8-f02a-4444-8adb-b83aa8c6a05f\', \'multiverseId\': 535833}, \'multiverseid\': 535833}, {\'name\': \'Maschera di Griselbrand\', \'text\': \'La creatura equipaggiata ha volare e legame vitale.\\nOgniqualvolta la creatura equipaggiata muore, puoi pagare X punti vita, dove X è la sua forza. Se lo fai, pesca X carte.\\nEquipaggiare {3}\', \'type\': \'Artefatto Leggendario — Equipaggiamento\', \'flavor\': \'Il retaggio del male continua.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536149&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'99c0d5e0-572c-41eb-8b81-efd9d75e1ff5\', \'multiverseId\': 536149}, \'multiverseid\': 536149}, {\'name\': \'グリセルブランドの仮面\', \'text\': \'装備しているクリーチャーは飛行と絆魂を持つ。\\n装備しているクリーチャーが死亡するたび、あなたはＸ点のライフを支払ってもよい。Ｘはそのクリーチャーのパワーに等しい。そうしたなら、カードＸ枚を引く。\\n装備{3}\', \'type\': \'伝説のアーティファクト — 装備品\', \'flavor\': \'悪の遺産は生き続ける。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536465&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'41837d82-809e-4ee7-bb04-de2530013711\', \'multiverseId\': 536465}, \'multiverseid\': 536465}, {\'name\': \'그리즐브랜드의 가면\', \'text\': \'장착된 생물은 비행 및 생명연결을 가진다.\\n장착된 생물이 죽을 때마다, 당신은 생명 X점을 지불할 수 있다. X는 그 생물의 공격력이다. 그렇게 한다면, 카드 X장을 뽑는다.\\n장착 {3}\', \'type\': \'전설적 마법물체 — 장비\', \'flavor\': \'악이 남긴 유산은 계속해서 살아간다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536781&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2d691b1e-df2f-4cfa-869a-f6ce59f07593\', \'multiverseId\': 536781}, \'multiverseid\': 536781}, {\'name\': \'Máscara de Griselbrand\', \'text\': \'A criatura equipada tem voar e vínculo com a vida.\\nToda vez que a criatura equipada morre, você pode pagar X pontos de vida, sendo X o poder da criatura. Se fizer isso, compre X cards.\\nEquipar {3}\', \'type\': \'Artefato Lendário — Equipamento\', \'flavor\': \'O legado do mal continua.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537097&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'188bf576-132c-4969-8fbb-0fdb8dba28d4\', \'multiverseId\': 537097}, \'multiverseid\': 537097}, {\'name\': \'Маска Гризельбранда\', \'text\': \'Снаряженное существо имеет Полет и Цепь жизни.\\nКаждый раз, когда зачарованное существо умирает, вы можете заплатить X жизней, где Х — значение его силы. Если вы это делаете, возьмите X карт.\\nСнарядить {3}\', \'type\': \'Легендарный Артефакт — Снаряжение\', \'flavor\': \'Наследие зла продолжает жить.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537413&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7c1e2ba7-1821-4808-b924-2baeae340634\', \'multiverseId\': 537413}, \'multiverseid\': 537413}, {\'name\': \'棘泽边的面具\', \'text\': \'佩带此武具的生物具有飞行与系命异能。\\n每当佩带此武具的生物死去时，你可以支付X点生命，X为其力量。若你如此作，则抓X张牌。\\n佩带{3}\', \'type\': \'传奇神器 ～武具\', \'flavor\': \'邪恶遗物得以继续流传。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537729&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ace8df21-1b49-4914-89b2-bfe922d27fa3\', \'multiverseId\': 537729}, \'multiverseid\': 537729}, {\'name\': \'棘澤邊的面具\', \'text\': \'佩帶此武具的生物具有飛行與繫命異能。\\n每當佩帶此武具的生物死去時，你可以支付X點生命，X為其力量。若你如此作，則抽X張牌。\\n佩帶{3}\', \'type\': \'傳奇神器 ～武具\', \'flavor\': \'邪惡遺物得以繼續流傳。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538045&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0208e967-3658-4db4-929e-225df01619ef\', \'multiverseId\': 538045}, \'multiverseid\': 538045}]', "[{'name': 'Maske von Griselbrand', 'text': 'Die ausgerüstete Kreatur hat Flugfähigkeit und Lebensverknüpfung.\\nImmer wenn die ausgerüstete Kreatur stirbt, kannst du X Lebenspunkte bezahlen, wobei X gleich ihrer Stärke ist. Falls du dies tust, ziehe X Karten.\\nAusrüsten {3}', 'type': 'Legendäres Artefakt — Ausrüstung', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538763&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0937b8ae-3f64-4d5f-9b49-7b4e1d8fb100', 'multiverseId': 538763}, 'multiverseid': 538763}, {'name': 'Máscara de Griselbrand', 'text': 'La criatura equipada tiene las habilidades de volar y vínculo vital.\\nSiempre que la criatura equipada muera, puedes pagar X vidas, donde X es su fuerza. Si lo haces, roba X cartas.\\nEquipar {3}.', 'type': 'Artefacto legendario — Equipo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538823&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'feef813a-6c1d-46e1-9971-80849745e335', 'multiverseId': 538823}, 'multiverseid': 538823}, {'name': 'Masque de Griselbrand', 'text': 'La créature équipée a le vol et le lien de vie.\\nÀ chaque fois que la créature équipée meurt, vous pouvez payer X points de vie, X étant sa force. Si vous faites ainsi, piochez X cartes.\\nÉquipement {3}', 'type': 'Artefact légendaire : équipement', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538883&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'da639c5c-bc17-469a-8c46-d252841f0075', 'multiverseId': 538883}, 'multiverseid': 538883}, {'name': 'Maschera di Griselbrand', 'text': 'La creatura equipaggiata ha volare e legame vitale.\\nOgniqualvolta la creatura equipaggiata muore, puoi pagare X punti vita, dove X è la sua forza. Se lo fai, pesca X carte.\\nEquipaggiare {3}', 'type': 'Artefatto Leggendario — Equipaggiamento', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538943&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '5f0cb98d-b19c-458c-b526-628d7b6ec3b2', 'multiverseId': 538943}, 'multiverseid': 538943}, {'name': 'グリセルブランドの仮面', 'text': '装備しているクリーチャーは飛行と絆魂を持つ。\\n装備しているクリーチャーが死亡するたび、あなたはＸ点のライフを支払ってもよい。Ｘはそのクリーチャーのパワーに等しい。そうしたなら、カードＸ枚を引く。\\n装備{3}', 'type': '伝説のアーティファクト — 装備品', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539003&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '37a9c6a6-3b36-4d45-92dc-5424c154e648', 'multiverseId': 539003}, 'multiverseid': 539003}]", '[{\'name\': \'Materialsammler\', \'text\': \'Falls es weder Tag noch Nacht ist, wird es Tag, sowie der Materialsammler ins Spiel kommt.\\nImmer wenn der Tag zur Nacht oder die Nacht zum Tag wird, kannst du eine bleibende Karte deiner Wahl, die kein Land ist, tappen oder enttappen.\', \'type\': \'Kreatur — Homunkulus\', \'flavor\': \'„Muss die Meisterin mit neuen Teilen beschäftigen, sonst kommt sie vielleicht auf die Idee, dass ich auch aus Teilen bestehe."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535118&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c4336a24-c42e-4839-a2a0-115900b58d1c\', \'multiverseId\': 535118}, \'multiverseid\': 535118}, {\'name\': \'Recolector de componentes\', \'text\': \'Si no es ni de día ni de noche, se hace de día en cuanto el Recolector de componentes entre al campo de batalla.\\nSiempre que se pase del día a la noche o de la noche al día, puedes girar o enderezar el permanente objetivo que no sea tierra.\', \'type\': \'Criatura — Homúnculo\', \'flavor\': \'"Mantener ocupada a la ama con trocitos o quizá ella pensar que yo también estar hecho de trocitos".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535434&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2fe0a591-2c39-420b-beb5-b4b6be7335c4\', \'multiverseId\': 535434}, \'multiverseid\': 535434}, {\'name\': \'Collecteur de composantes\', \'text\': "Si ce n\'est ni le jour ni la nuit, on passe au jour au moment où le Collecteur de composantes arrive sur le champ de bataille.\\nÀ chaque fois qu\'on passe du jour à la nuit ou de la nuit au jour, vous pouvez engager ou dégager un permanent non-terrain ciblé.", \'type\': \'Créature : homoncule\', \'flavor\': \'« Occuper maîtresse avec nouveaux morceaux sinon elle va se demander si je suis pas fait de morceaux aussi. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535750&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dbd4db48-74a0-42f6-80dd-31a40094a961\', \'multiverseId\': 535750}, \'multiverseid\': 535750}, {\'name\': \'Procacciatore di Componenti\', \'text\': \'Se non è né giorno né notte, diventa giorno mentre il Procacciatore di Componenti entra nel campo di battaglia.\\nOgniqualvolta il giorno diventa notte o la notte diventa giorno, puoi TAPpare o STAPpare un permanente non terra bersaglio.\', \'type\': \'Creatura — Omuncolo\', \'flavor\': \'"Meglio tenere la padrona occupata con nuovi pezzi o inizierà a chiedersi di che pezzi sono fatto io."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536066&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e9803818-dfee-43d2-9857-fb9e02da67a9\', \'multiverseId\': 536066}, \'multiverseid\': 536066}, {\'name\': \'材料収集家\', \'text\': \'材料収集家が戦場に出るに際し、昼でも夜でもないなら、昼になる。\\n昼が夜になるか夜が昼になるたび、土地でないパーマネント１つを対象とする。あなたはそれをタップまたはアンタップしてもよい。\', \'type\': \'クリーチャー — ホムンクルス\', \'flavor\': \'「ご主人様に新しい部品あげるだ。じゃないとボクも部品で出来ていると思われるだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536382&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a8bbdf7a-338b-4c5f-8d48-08ede4765e12\', \'multiverseId\': 536382}, \'multiverseid\': 536382}, {\'name\': \'부품 수집가\', \'text\': \'낮도 밤도 아니라면, 부품 수집가가 전장에 들어오면서 낮이 된다.\\n낮이 밤이 되거나 밤이 낮이 될 때마다, 대지가 아닌 지속물을 목표로 정한다. 당신은 그 지속물을 탭하거나 언탭할 수 있다.\', \'type\': \'생물 — 호문쿨루스\', \'flavor\': \'"계속해서 주인님이 사용할 부품들을 가져다드리지 않으면 언젠가는 나도 부품들로 사용할 수 있는 게 아닐까 궁금해하실 거야."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536698&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9ff7f7dd-8c86-48d8-8ded-e88b3549b507\', \'multiverseId\': 536698}, \'multiverseid\': 536698}, {\'name\': \'Coletor de Componentes\', \'text\': \'Se não for dia nem noite, torna-se dia conforme Coletor de Componentes entra no campo de batalha.\\nToda vez que o dia se torna noite ou a noite se torna dia, você pode virar ou desvirar a permanente alvo não de terreno.\', \'type\': \'Criatura — Homúnculo\', \'flavor\': \'"Melhor manter a patroa ocupada com peças novas, senão vai pensar que sou feito de peças também."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537014&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e58f849d-ee22-4b48-ba0f-e093a2467cf8\', \'multiverseId\': 537014}, \'multiverseid\': 537014}, {\'name\': \'Сборщик Компонентов\', \'text\': \'Если не стоит ни день, ни ночь, то при выходе Сборщика Компонентов на поле битвы наступает день.\\nКаждый раз, когда день становится ночью или ночь становится днем, вы можете повернуть или развернуть целевой не являющийся землей перманент.\', \'type\': \'Существо — Гомункул\', \'flavor\': \'«Если исправно не снабжать хозяйку новыми частями, она может задуматься: может, я тоже из частей».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537330&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3a261a9c-b50c-4aac-afc8-4bbdd4e50b5b\', \'multiverseId\': 537330}, \'multiverseid\': 537330}, {\'name\': \'材料搜集妖\', \'text\': \'如果当前既非白昼也非黑夜，则于材料搜集妖进战场时成为白昼。\\n每当白昼成为黑夜或黑夜成为白昼时，你可以横置或重置目标非地永久物。\', \'type\': \'生物 ～造妖\', \'flavor\': \'「要让主人忙着处理新材料，不然她或许会以为我也是材料。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537646&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4e06a936-7fca-4fb6-ab53-997263fb99ba\', \'multiverseId\': 537646}, \'multiverseid\': 537646}, {\'name\': \'材料搜集妖\', \'text\': \'如果當前既非白晝也非黑夜，則於材料搜集妖進戰場時成為白晝。\\n每當白晝成為黑夜或黑夜成為白晝時，你可以橫置或重置目標非地永久物。\', \'type\': \'生物 ～造妖\', \'flavor\': \'「要讓主人忙著處理新材料，不然她或許會以為我也是材料。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537962&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'38fb2093-3db3-4eb2-ad5e-34ce814f5470\', \'multiverseId\': 537962}, \'multiverseid\': 537962}]', '[{\'name\': \'Messerschleuderin aus Falkenrath\', \'text\': \'Immer wenn die Messerschleuderin aus Falkenrath angreift, fügt sie dem verteidigenden Spieler 1 Schadenspunkt zu.\', \'type\': \'Kreatur — Vampir\', \'flavor\': \'„Lady Anja sendet ihre Grüße. Den Rest ihrer Botschaft werde ich in deine Haut ritzen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535228&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8b69931f-6a7d-4847-a726-dff4a35dbcbc\', \'multiverseId\': 535228}, \'multiverseid\': 535228}, {\'name\': \'Perforadora de Falkenrath\', \'text\': \'Siempre que la Perforadora de Falkenrath ataque, hace 1 punto de daño al jugador defensor.\', \'type\': \'Criatura — Vampiro\', \'flavor\': \'"La dama Anje te manda recuerdos. Grabaré en tu piel el resto de su mensaje".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535544&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a139f36e-0446-46eb-9a72-844e904b47d8\', \'multiverseId\': 535544}, \'multiverseid\': 535544}, {\'name\': \'Perforatrice Falkenrath\', \'text\': \'À chaque fois que la Perforatrice Falkenrath attaque, elle inflige 1 blessure au joueur défenseur.\', \'type\': \'Créature : vampire\', \'flavor\': \'« Dame Anje vous transmet ses salutations. Je graverai le reste de son message sur votre peau. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535860&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'355109ae-4a51-4b7a-9ded-745bb4c9426b\', \'multiverseId\': 535860}, \'multiverseid\': 535860}, {\'name\': \'Perforatrice Falkenrath\', \'text\': \'Ogniqualvolta la Perforatrice Falkenrath attacca, infligge 1 danno al giocatore in difesa.\', \'type\': \'Creatura — Vampiro\', \'flavor\': \'"La signora Anje manda i suoi saluti. Inciderò il resto del messaggio sulla tua pelle."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536176&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'217614c3-cf7a-48bc-907f-e2368af9cc27\', \'multiverseId\': 536176}, \'multiverseid\': 536176}, {\'name\': \'ファルケンラスの打ち抜く者\', \'text\': \'ファルケンラスの打ち抜く者が攻撃するたび、これは防御プレイヤーに１点のダメージを与える。\', \'type\': \'クリーチャー — 吸血鬼\', \'flavor\': \'「エインジー様がよろしくって。残りの伝言はあなたの肌に刻んでおくわ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536492&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9b5106ff-b32c-42f2-90e8-60b94320a762\', \'multiverseId\': 536492}, \'multiverseid\': 536492}, {\'name\': \'팔켄라스 관통자\', \'text\': \'팔켄라스 관통자가 공격할 때마다, 팔켄라스 관통자는 수비플레이어에게 피해 1점을 입힌다.\', \'type\': \'생물 — 흡혈귀\', \'flavor\': \'"안지 마님이 안부를 전하셨다. 나머지 내용은 네 살갗에 새겨넣어 주마."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536808&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d28ff85c-60e8-4ece-90bf-fad3e00aa8b8\', \'multiverseId\': 536808}, \'multiverseid\': 536808}, {\'name\': \'Perfuradora Falkenrath\', \'text\': \'Toda vez que Perfuradora Falkenrath ataca, ela causa 1 ponto de dano ao jogador defensor.\', \'type\': \'Criatura — Vampiro\', \'flavor\': \'"Saudações da Senhora Anje. Vou gravar o restante da mensagem em sua pele."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537124&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7219c8be-a120-4cba-a647-6e733cab6148\', \'multiverseId\': 537124}, \'multiverseid\': 537124}, {\'name\': \'Фалькенратская Пронзательница\', \'text\': \'Каждый раз, когда Фалькенратская Пронзательница атакует, она наносит 1 повреждение защищающемуся игроку.\', \'type\': \'Существо — Вампир\', \'flavor\': \'«Госпожа Анже передает наилучшие пожелания. Остальную часть послания я вырежу у тебя на коже».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537440&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a2776149-3582-49a2-9b4c-42a9c1e83b89\', \'multiverseId\': 537440}, \'multiverseid\': 537440}, {\'name\': \'伐肯纳尖刃客\', \'text\': \'每当伐肯纳尖刃客攻击时，它对防御牌手造成1点伤害。\', \'type\': \'生物 ～吸血鬼\', \'flavor\': \'「安姬大人来信致意。我会把信中其他内容刻在你肌肤上。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537756&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f4496a0d-f24b-4d8f-b889-a9628ea096c3\', \'multiverseId\': 537756}, \'multiverseid\': 537756}, {\'name\': \'伐肯納尖刃客\', \'text\': \'每當伐肯納尖刃客攻擊時，它對防禦玩家造成1點傷害。\', \'type\': \'生物 ～吸血鬼\', \'flavor\': \'「安姬大人來信致意。我會把信中其他內容刻在你肌膚上。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538072&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'87ad62b2-4b1a-4fa2-8635-22291369c14a\', \'multiverseId\': 538072}, \'multiverseid\': 538072}]', '[{\'name\': \'Mondrausch\', \'text\': \'Eine Kreatur deiner Wahl, die du kontrollierst, erhält +X/+0 und Erstschlag und verursacht Trampelschaden bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'In dem Aufruhr hatte sie den Biss nicht einmal gespürt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535242&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c420dbcc-c3c7-4c60-a277-79c53fef1dce\', \'multiverseId\': 535242}, \'multiverseid\': 535242}, {\'name\': \'Frenesí lunar\', \'text\': \'La criatura objetivo que controlas obtiene +X/+0 y gana las habilidades de dañar primero y arrollar hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'El caos le provocó tal descarga de adrenalina que ni siquiera se percató del mordisco.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535558&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1f7c6a46-bfe0-49a0-822b-03ba835f4391\', \'multiverseId\': 535558}, \'multiverseid\': 535558}, {\'name\': \'Frénésie lunaire\', \'text\': "Une créature ciblée que vous contrôlez gagne +X/+0 et acquiert l\'initiative et le piétinement jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': "Dans le chaos engendré par l\'adrénaline, elle n\'avait même pas senti la morsure.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535874&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'797c4f2d-290c-4b25-83f7-3a359806e284\', \'multiverseId\': 535874}, \'multiverseid\': 535874}, {\'name\': \'Frenesia Lunare\', \'text\': \'Una creatura bersaglio che controlli prende +X/+0 e ha attacco improvviso e travolgere fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': "Con l\'adrenalina che le scorreva ancora in corpo, non aveva neanche sentito il morso.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536190&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'87a2421d-b7fb-4870-ab00-2c684996a2e9\', \'multiverseId\': 536190}, \'multiverseid\': 536190}, {\'name\': \'月の激情\', \'text\': \'あなたがコントロールしているクリーチャー１体を対象とする。ターン終了時まで、それは＋Ｘ/＋０の修整を受け先制攻撃とトランプルを得る。\', \'type\': \'インスタント\', \'flavor\': \'アドレナリンに溢れた混乱の中、彼女は噛まれた事すら気づかなかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536506&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'745b57ed-0e7a-42ff-b727-ea919fbcbabb\', \'multiverseId\': 536506}, \'multiverseid\': 536506}, {\'name\': \'달의 광분\', \'text\': \'당신이 조종하는 생물을 목표로 정한다. 그 생물은 턴종료까지 +X/+0을 받고 선제공격 및 돌진을 얻는다.\', \'type\': \'순간마법\', \'flavor\': \'아드레날린이 솟구치는 혼란 속에서 그녀는 물리는 것조차 느끼지 못했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536822&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'910e1eaa-46ad-47c6-b44d-32d705b350a3\', \'multiverseId\': 536822}, \'multiverseid\': 536822}, {\'name\': \'Frenesi Lunar\', \'text\': \'A criatura alvo que você controla recebe +X/+0 e ganha iniciativa e atropelar até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'No caos cheio de adrenalina, ela nem sentiu a mordida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537138&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3df05246-a2c1-4874-8876-80ae7b64e2d7\', \'multiverseId\': 537138}, \'multiverseid\': 537138}, {\'name\': \'Лунное Бешенство\', \'text\': \'Целевое существо под вашим контролем получает +X/+0, Первый удар и Пробивной удар до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'В адреналиновом хаосе она даже не почувствовала укуса.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537454&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b5e15032-c990-420d-8581-a1380f4bc644\', \'multiverseId\': 537454}, \'multiverseid\': 537454}, {\'name\': \'映月狂热\', \'text\': \'直到回合结束，目标由你操控的生物得+X/+0且获得先攻与践踏异能。\', \'type\': \'瞬间\', \'flavor\': \'在充满紧张氛围的混乱当中，她甚至没感觉自己已经被咬。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537770&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'84f1ab58-c5d2-4bda-964c-c90c9acfc4d2\', \'multiverseId\': 537770}, \'multiverseid\': 537770}, {\'name\': \'映月狂熱\', \'text\': \'直到回合結束，目標由你操控的生物得+X/+0且獲得先攻與踐踏異能。\', \'type\': \'瞬間\', \'flavor\': \'在充滿緊張氛圍的混亂當中，她甚至沒感覺自己已經被咬。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538086&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0fbf7162-5708-4010-a599-ac4746a82af8\', \'multiverseId\': 538086}, \'multiverseid\': 538086}]', '[{\'name\': \'Mondschleier-Regent\', \'text\': \'Fliegend\\nImmer wenn du einen Zauberspruch wirkst, kannst du alle Karten aus deiner Hand abwerfen. Falls du dies tust, ziehe für jede Farbe des Zauberspruchs eine Karte.\\nWenn der Mondschleier-Regent stirbt, fügt er einem Ziel deiner Wahl X Schadenspunkte zu, wobei X gleich der Anzahl an Farben unter den bleibenden Karten ist, die du kontrollierst.\', \'type\': \'Kreatur — Drache\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535244&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'00ce2f4f-15ab-42b2-a168-9d5e53f564a3\', \'multiverseId\': 535244}, \'multiverseid\': 535244}, {\'name\': \'Regente velo lunar\', \'text\': \'Vuela.\\nSiempre que lances un hechizo, puedes descartar tu mano. Si lo haces, roba una carta por cada uno de los colores de ese hechizo.\\nCuando el Regente velo lunar muera, hace X puntos de daño a cualquier objetivo, donde X es la cantidad de colores entre los permanentes que controlas.\', \'type\': \'Criatura — Dragón\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535560&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dd4959b9-67f6-4218-9af9-52f9788937d1\', \'multiverseId\': 535560}, \'multiverseid\': 535560}, {\'name\': \'Régent voilelune\', \'text\': "Vol\\nÀ chaque fois que vous lancez un sort, vous pouvez vous défausser de votre main. Si vous faites ainsi, piochez une carte pour chaque couleur de ce sort.\\nQuand le Régent voilelune meurt, il inflige X blessures à n\'importe quelle cible, X étant le nombre de couleurs parmi les permanents que vous contrôlez.", \'type\': \'Créature : dragon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535876&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e40364d7-d541-44e0-ba55-960bd38d7807\', \'multiverseId\': 535876}, \'multiverseid\': 535876}, {\'name\': \'Reggente del Velo Lunare\', \'text\': \'Volare\\nOgniqualvolta lanci una magia, puoi scartare la tua mano. Se lo fai, pesca una carta per ogni colore di quella magia.\\nQuando il Reggente del Velo Lunare muore, infligge X danni a un qualsiasi bersaglio, dove X è il numero di colori tra i permanenti che controlli.\', \'type\': \'Creatura — Drago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536192&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'aaf57c14-0669-4f74-80b9-a3d06c1823aa\', \'multiverseId\': 536192}, \'multiverseid\': 536192}, {\'name\': \'月の帳の執政\', \'text\': \'飛行\\nあなたが呪文を唱えるたび、あなたはあなたの手札を捨ててもよい。そうしたなら、その呪文の色１色につき１枚のカードを引く。\\n月の帳の執政が死亡したとき、クリーチャーやプレインズウォーカーやプレイヤーのうち１つを対象とする。これはそれにＸ点のダメージを与える。Ｘはあなたがコントロールしているパーマネントの中の色の種類数に等しい。\', \'type\': \'クリーチャー — ドラゴン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536508&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8d397421-2f54-4be7-8c19-6644ae29129d\', \'multiverseId\': 536508}, \'multiverseid\': 536508}, {\'name\': \'달빛장막 섭정\', \'text\': \'비행\\n당신이 주문을 발동할 때마다, 당신은 당신의 손을 버릴 수 있다. 그렇게 한다면, 그 주문의 각 색마다 카드 한 장을 뽑는다.\\n달빛장막 섭정이 죽을 때, 원하는 목표를 정한다. 달빛장막 섭정은 그 목표에게 피해 X점을 입힌다. X는 당신이 조종하는 지속물들이 가지고 있는 색의 총 수이다.\', \'type\': \'생물 — 용\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536824&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'52aa50ff-34b1-4d02-b4c0-32b20841e7af\', \'multiverseId\': 536824}, \'multiverseid\': 536824}, {\'name\': \'Regente do Véu Lunar\', \'text\': \'Voar\\nToda vez que você conjura uma mágica, você pode descartar sua mão. Se fizer isso, compre um card para cada uma das cores daquela mágica.\\nQuando Regente do Véu Lunar morre, ele causa X pontos de dano a qualquer alvo, sendo X o número de cores entre as das permanentes que você controla.\', \'type\': \'Criatura — Dragão\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537140&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3235058b-3694-4ecb-bec8-37ed87181ede\', \'multiverseId\': 537140}, \'multiverseid\': 537140}, {\'name\': \'Регент Лунного Покрова\', \'text\': \'Полет\\nКаждый раз, когда вы разыгрываете заклинание, вы можете сбросить вашу руку. Если вы это делаете, возьмите одну карту за каждый из цветов того заклинания.\\nКогда Регент Лунного Покрова умирает, он наносит Х повреждений любой цели, где Х — число цветов среди перманентов под вашим контролем.\', \'type\': \'Существо — Дракон\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537456&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3302650f-affb-460b-8d2e-50257da378d9\', \'multiverseId\': 537456}, \'multiverseid\': 537456}, {\'name\': \'月帷龙侯\', \'text\': \'飞行\\n每当你施放咒语时，你可以弃掉你的手牌。若你如此作，则该咒语每有一种颜色，便抓一张牌。\\n当月帷龙侯死去时，它对任意一个目标造成X点伤害，X为由你操控之永久物中的颜色数量。\', \'type\': \'生物 ～龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537772&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'16802736-4e49-41fd-9cdf-1b4f211dce3f\', \'multiverseId\': 537772}, \'multiverseid\': 537772}, {\'name\': \'月帷龍侯\', \'text\': \'飛行\\n每當你施放咒語時，你可以棄掉你的手牌。若你如此作，則該咒語每有一種顏色，便抽一張牌。\\n當月帷龍侯死去時，它對任意一個目標造成X點傷害，X為由你操控之永久物中的顏色數量。\', \'type\': \'生物 ～龍\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538088&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5bfd9e21-5214-4c07-b64a-709d46da869f\', \'multiverseId\': 538088}, \'multiverseid\': 538088}]', '[{\'name\': \'Mondschleier-Regent\', \'text\': \'Fliegend\\nImmer wenn du einen Zauberspruch wirkst, kannst du alle Karten aus deiner Hand abwerfen. Falls du dies tust, ziehe für jede Farbe des Zauberspruchs eine Karte.\\nWenn der Mondschleier-Regent stirbt, fügt er einem Ziel deiner Wahl X Schadenspunkte zu, wobei X gleich der Anzahl an Farben unter den bleibenden Karten ist, die du kontrollierst.\', \'type\': \'Kreatur — Drache\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538773&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'99cd690a-5843-43bd-aaa7-766b3445bf06\', \'multiverseId\': 538773}, \'multiverseid\': 538773}, {\'name\': \'Regente velo lunar\', \'text\': \'Vuela.\\nSiempre que lances un hechizo, puedes descartar tu mano. Si lo haces, roba una carta por cada uno de los colores de ese hechizo.\\nCuando el Regente velo lunar muera, hace X puntos de daño a cualquier objetivo, donde X es la cantidad de colores entre los permanentes que controlas.\', \'type\': \'Criatura — Dragón\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538833&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'21e93d81-4bb0-4775-8ffe-0deb7153d95d\', \'multiverseId\': 538833}, \'multiverseid\': 538833}, {\'name\': \'Régent voilelune\', \'text\': "Vol\\nÀ chaque fois que vous lancez un sort, vous pouvez vous défausser de votre main. Si vous faites ainsi, piochez une carte pour chaque couleur de ce sort.\\nQuand le Régent voilelune meurt, il inflige X blessures à n\'importe quelle cible, X étant le nombre de couleurs parmi les permanents que vous contrôlez.", \'type\': \'Créature : dragon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538893&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8306cd78-ad3b-4aee-a708-2c03a51e95d8\', \'multiverseId\': 538893}, \'multiverseid\': 538893}, {\'name\': \'Reggente del Velo Lunare\', \'text\': \'Volare\\nOgniqualvolta lanci una magia, puoi scartare la tua mano. Se lo fai, pesca una carta per ogni colore di quella magia.\\nQuando il Reggente del Velo Lunare muore, infligge X danni a un qualsiasi bersaglio, dove X è il numero di colori tra i permanenti che controlli.\', \'type\': \'Creatura — Drago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538953&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3d54ba38-b6df-497d-ab34-a3b6eb6d670e\', \'multiverseId\': 538953}, \'multiverseid\': 538953}, {\'name\': \'月の帳の執政\', \'text\': \'飛行\\nあなたが呪文を唱えるたび、あなたはあなたの手札を捨ててもよい。そうしたなら、その呪文の色１色につき１枚のカードを引く。\\n月の帳の執政が死亡したとき、クリーチャーやプレインズウォーカーやプレイヤーのうち１つを対象とする。これはそれにＸ点のダメージを与える。Ｘはあなたがコントロールしているパーマネントの中の色の種類数に等しい。\', \'type\': \'クリーチャー — ドラゴン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539013&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0f20b8bf-53da-4f75-b01b-8eb1ea2822e8\', \'multiverseId\': 539013}, \'multiverseid\': 539013}]', '[{\'name\': \'Morastmonster\', \'text\': \'Immer wenn das Morastmonster ins Spiel kommt oder angreift, lege eine Schleimmarke auf bis zu eine andere Kreatur deiner Wahl.\\nNicht-Schrecken-Kreaturen mit Schleimmarken verlieren alle Fähigkeiten und haben Basis-Stärke und -Widerstandskraft 2/2.\', \'type\': \'Kreatur — Schrecken\', \'flavor\': \'Das Schwierige ist nicht, seiner Spur zu folgen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535158&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c2b90468-dd97-42e1-8975-9fbad3cc0b24\', \'multiverseId\': 535158}, \'multiverseid\': 535158}, {\'name\': \'Monstruo del fango\', \'text\': \'Siempre que el Monstruo del fango entre al campo de batalla o ataque, pon un contador de fango sobre hasta una otra criatura objetivo.\\nLas criaturas que no sean Horror con contadores de fango sobre ellas pierden todas sus habilidades y tienen una fuerza y resistencia base de 2/2.\', \'type\': \'Criatura — Horror\', \'flavor\': \'Seguirle la pista no es lo complicado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535474&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5aa3c9f2-9898-415e-978f-e2c6f8d6e098\', \'multiverseId\': 535474}, \'multiverseid\': 535474}, {\'name\': \'Vasard\', \'text\': "À chaque fois que le Vasard arrive sur le champ de bataille ou qu\'il attaque, mettez un marqueur « boue » sur jusqu\'à une autre créature ciblée.\\nLes créatures non-Horreur avec des marqueurs « boue » sur elles perdent toutes leurs capacités et ont une force et une et endurance de base de 2/2.", \'type\': \'Créature : horreur\', \'flavor\': "Le traquer n\'est pas le plus difficile.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535790&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'71f3d2da-2aeb-4c8f-b518-0042c64b0855\', \'multiverseId\': 535790}, \'multiverseid\': 535790}, {\'name\': \'Mostro della Fanghiglia\', \'text\': "Ogniqualvolta il Mostro della Fanghiglia entra nel campo di battaglia o attacca, scegli fino a un\'altra creatura bersaglio e metti un segnalino melma su di essa.\\nLe creature non Orrore con segnalini melma perdono tutte le abilità e hanno forza e costituzione base 2/2.", \'type\': \'Creatura — Orrore\', \'flavor\': \'Trovarlo non è la parte difficile.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536106&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ebd2723a-236b-4069-883b-006126ed5e4c\', \'multiverseId\': 536106}, \'multiverseid\': 536106}, {\'name\': \'ヘドロの怪物\', \'text\': \'ヘドロの怪物が戦場に出るか攻撃するたび、これでないクリーチャー最大１体を対象とする。それの上にスライム・カウンター１個を置く。\\nスライム・カウンターが置かれていてホラーでないすべてのクリーチャーはすべての能力を失い基本のパワーとタフネスが２/２になる。\', \'type\': \'クリーチャー — ホラー\', \'flavor\': \'追跡するのが難しいわけじゃない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536422&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'53a57843-c8c0-4f28-bd72-2d0e2bb42454\', \'multiverseId\': 536422}, \'multiverseid\': 536422}, {\'name\': \'진흙 괴물\', \'text\': \'진흙 괴물이 전장에 들어오거나 공격할 때마다, 다른 생물을 최대 한 개까지 목표로 정한다. 그 생물에 점액 카운터 한 개를 올려놓는다.\\n점액 카운터를 가지고 있는 괴수가 아닌 생물들은 모든 능력을 잃고 기본 공격력 및 방어력이 2/2가 된다.\', \'type\': \'생물 — 괴수\', \'flavor\': \'그것을 추적하는 일은 어렵지 않다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536738&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'94a2baa5-7c14-42ec-9247-b699afa90ddc\', \'multiverseId\': 536738}, \'multiverseid\': 536738}, {\'name\': \'Monstro da Imundície\', \'text\': \'Toda vez que Monstro da Imundície entrar no campo de batalha ou atacar, coloque um marcador de limo em até uma outra criatura alvo.\\nAs criaturas não Horror com marcadores de limo perdem todas as habilidades e têm poder e resistência básicos 2/2.\', \'type\': \'Criatura — Horror\', \'flavor\': \'O difícil não é encontrá-lo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537054&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a5351651-38a5-4177-969f-28024977599c\', \'multiverseId\': 537054}, \'multiverseid\': 537054}, {\'name\': \'Илистое Чудовище\', \'text\': \'Каждый раз, когда Илистое Чудовище выходит на поле битвы или атакует, положите один жетон слизи на не более чем одно другое целевое существо.\\nНе являющиеся Ужасами существа с жетонами слизи на них теряют все способности и имеют базовую силу и выносливость 2/2.\', \'type\': \'Существо — Ужас\', \'flavor\': \'Выследить-то его не сложно.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537370&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'02b32039-95b9-4176-b4a1-093aef36f282\', \'multiverseId\': 537370}, \'multiverseid\': 537370}, {\'name\': \'泥泞怪物\', \'text\': \'每当泥泞怪物进战场或攻击时，在至多另一个目标生物上放置一个黏菌指示物。\\n所有其上有黏菌指示物的非惊惧兽生物都失去所有异能，且基础力量与防御力均为2/2。\', \'type\': \'生物 ～惊惧兽\', \'flavor\': \'追踪它并不难。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537686&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'48a59c03-595d-415b-815e-97fb2d341086\', \'multiverseId\': 537686}, \'multiverseid\': 537686}, {\'name\': \'泥濘怪物\', \'text\': \'每當泥濘怪物進戰場或攻擊時，在至多另一個目標生物上放置一個黏菌指示物。\\n所有其上有黏菌指示物的非驚懼獸生物都失去所有異能，且基礎力量與防禦力均為2/2。\', \'type\': \'生物 ～驚懼獸\', \'flavor\': \'追蹤它並不難。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538002&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'dc232d3a-7bc7-4545-ac19-bcf08b78641e\', \'multiverseId\': 538002}, \'multiverseid\': 538002}]', '[{\'name\': \'Morastmonster\', \'text\': \'Immer wenn das Morastmonster ins Spiel kommt oder angreift, lege eine Schleimmarke auf bis zu eine andere Kreatur deiner Wahl.\\nNicht-Schrecken-Kreaturen mit Schleimmarken verlieren alle Fähigkeiten und haben Basis-Stärke und -Widerstandskraft 2/2.\', \'type\': \'Kreatur — Schrecken\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538755&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b10338d1-5aa8-4997-a7f4-7aac9ec92a52\', \'multiverseId\': 538755}, \'multiverseid\': 538755}, {\'name\': \'Monstruo del fango\', \'text\': \'Siempre que el Monstruo del fango entre al campo de batalla o ataque, pon un contador de fango sobre hasta una otra criatura objetivo.\\nLas criaturas que no sean Horror con contadores de fango sobre ellas pierden todas sus habilidades y tienen una fuerza y resistencia base de 2/2.\', \'type\': \'Criatura — Horror\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538815&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'727e2e45-607a-490d-9ff9-54c1cc0eb8ce\', \'multiverseId\': 538815}, \'multiverseid\': 538815}, {\'name\': \'Vasard\', \'text\': "À chaque fois que le Vasard arrive sur le champ de bataille ou qu\'il attaque, mettez un marqueur « boue » sur jusqu\'à une autre créature ciblée.\\nLes créatures non-Horreur avec des marqueurs « boue » sur elles perdent toutes leurs capacités et ont une force et une et endurance de base de 2/2.", \'type\': \'Créature : horreur\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538875&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7ae0c6ad-e055-429c-859a-b0141fe5ce1c\', \'multiverseId\': 538875}, \'multiverseid\': 538875}, {\'name\': \'Mostro della Fanghiglia\', \'text\': "Ogniqualvolta il Mostro della Fanghiglia entra nel campo di battaglia o attacca, scegli fino a un\'altra creatura bersaglio e metti un segnalino melma su di essa.\\nLe creature non Orrore con segnalini melma perdono tutte le abilità e hanno forza e costituzione base 2/2.", \'type\': \'Creatura — Orrore\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538935&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9122a841-cd72-4ed8-95b1-494ccabfd76d\', \'multiverseId\': 538935}, \'multiverseid\': 538935}, {\'name\': \'ヘドロの怪物\', \'text\': \'ヘドロの怪物が戦場に出るか攻撃するたび、これでないクリーチャー最大１体を対象とする。それの上にスライム・カウンター１個を置く。\\nスライム・カウンターが置かれていてホラーでないすべてのクリーチャーはすべての能力を失い基本のパワーとタフネスが２/２になる。\', \'type\': \'クリーチャー — ホラー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538995&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c5758771-390d-4732-9c8f-8ac5c950a367\', \'multiverseId\': 538995}, \'multiverseid\': 538995}]', '[{\'name\': \'Morbide Opportunistin\', \'text\': \'Immer wenn eine oder mehrere andere Kreaturen sterben, ziehe eine Karte. Diese Fähigkeit wird nur einmal pro Zug ausgelöst.\', \'type\': \'Kreatur — Mensch, Räuber\', \'flavor\': \'Auf Innistrad beginnt der Glücksfall des einen normalerweise damit, dass ein anderer mit dem Gesicht nach unten im Schlamm liegt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535203&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3b583add-6e7d-442a-ac95-aa463e0f8473\', \'multiverseId\': 535203}, \'multiverseid\': 535203}, {\'name\': \'Oportunista morbosa\', \'text\': \'Siempre que una o más otras criaturas mueran, roba una carta. Esta habilidad solo se dispara una vez por turno.\', \'type\': \'Criatura — Bribón humano\', \'flavor\': \'En Innistrad, las riquezas se suelen obtener de personas tendidas en el barro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535519&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'55068928-0770-4c5f-90ce-330ff8556283\', \'multiverseId\': 535519}, \'multiverseid\': 535519}, {\'name\': \'Opportuniste morbide\', \'text\': "À chaque fois qu\'au moins une autre créature meurt, piochez une carte. Cette capacité ne se déclenche qu\'une seule fois par tour.", \'type\': \'Créature : humain et gredin\', \'flavor\': "Sur Innistrad, l\'aubaine d\'une personne commence généralement lorsqu\'une autre gît dans la boue.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535835&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f74acf9a-78f4-481b-b644-20376b5701f0\', \'multiverseId\': 535835}, \'multiverseid\': 535835}, {\'name\': \'Opportunista Macabra\', \'text\': \'Ogniqualvolta una o più altre creature muoiono, pesca una carta. Questa abilità si innesca solo una volta per turno.\', \'type\': \'Creatura — Farabutto Umano\', \'flavor\': \'Su Innistrad, i colpi di fortuna iniziano spesso con qualcun altro a faccia in giù nel fango.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536151&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b7489235-5097-4df1-885d-1c44b4c2cbbc\', \'multiverseId\': 536151}, \'multiverseid\': 536151}, {\'name\': \'病的な日和見主義者\', \'text\': \'これでない１体以上のクリーチャーが死亡するたび、カード１枚を引く。この能力は、毎ターン１回しか誘発しない。\', \'type\': \'クリーチャー — 人間・ならず者\', \'flavor\': \'イニストラードでは、ひとりの意外な授かり物はまず他の人が泥の中でうつ伏せになることから始まる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536467&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9ce49013-4c76-487d-98f7-5858d506fd0d\', \'multiverseId\': 536467}, \'multiverseid\': 536467}, {\'name\': \'병적인 기회주의자\', \'text\': \'다른 생물이 한 개 이상 죽을 때마다, 카드 한 장을 뽑는다. 이 능력은 한 턴에 한 번만 격발한다.\', \'type\': \'생물 — 인간 도적\', \'flavor\': \'이니스트라드에서 누군가의 횡재는 보통 다른 사람이 진창에 얼굴이 처박힌 상태에서 시작된다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536783&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f9462418-afb5-4ec5-a79b-517f34eb8030\', \'multiverseId\': 536783}, \'multiverseid\': 536783}, {\'name\': \'Oportunista Mórbida\', \'text\': \'Toda vez que uma ou mais outras criaturas morrerem, compre um card. Esta habilidade é desencadeada apenas uma vez a cada turno.\', \'type\': \'Criatura — Humano Ladino\', \'flavor\': \'Em Innistrad, o dia de sorte de alguém geralmente começa com outra pessoa de cara na lama.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537099&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b22263bc-a874-45c3-bd0f-a4c8e4356f84\', \'multiverseId\': 537099}, \'multiverseid\': 537099}, {\'name\': \'Зловещая Оппортунистка\', \'text\': \'Каждый раз, когда одно или несколько других существ умирают, возьмите карту. Эта способность срабатывает только один раз в каждом ходу.\', \'type\': \'Существо — Человек Бродяга\', \'flavor\': \'На Иннистраде удача одного человека обычно начинается с того, что другой лежит в грязи лицом вниз.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537415&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b4c6948c-4c7f-40f0-86b4-3b162bbb3968\', \'multiverseId\': 537415}, \'multiverseid\': 537415}, {\'name\': \'病态投机者\', \'text\': \'每当一个或数个其他生物死去时，抓一张牌。此异能每回合只会触发一次。\', \'type\': \'生物 ～人类／浪客\', \'flavor\': \'在依尼翠，横财往往由他人倒毙泥中而起。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537731&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3d557bb2-f27f-4253-bf78-3f1bd59b66e7\', \'multiverseId\': 537731}, \'multiverseid\': 537731}, {\'name\': \'病態投機者\', \'text\': \'每當一個或數個其他生物死去時，抽一張牌。此異能每回合只會觸發一次。\', \'type\': \'生物 ～人類／浪客\', \'flavor\': \'在依尼翠，橫財往往由他人倒斃泥中而起。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538047&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'763ad063-9318-45b8-b7a9-78dfa81393c5\', \'multiverseId\': 538047}, \'multiverseid\': 538047}]', '[{\'name\': \'Morgenlicht-Hüterinnen\', \'text\': \'Wachsamkeit\\nHexenzirkel — Zu Beginn des Kampfes in deinem Zug und falls du drei oder mehr Kreaturen mit unterschiedlicher Stärke kontrollierst, erhalten Kreaturen, die du kontrollierst, +1/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Hexenmeister\', \'flavor\': \'„Das Gleichgewicht von Tag und Nacht ist zerstört. Wir müssen den Schlüssel aus Mondsilber finden."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535324&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'db82626b-40da-4827-ac31-6b4debbdca62\', \'multiverseId\': 535324}, \'multiverseid\': 535324}, {\'name\': \'Protectoras de Ciervas del Alba\', \'text\': \'Vigilancia.\\nAquelarre — Al comienzo del combate en tu turno, si controlas tres o más criaturas con fuerzas distintas, las criaturas que controlas obtienen +1/+0 hasta el final del turno.\', \'type\': \'Criatura — Brujo humano\', \'flavor\': \'"Se quebró el equilibrio entre el día y la noche. Debemos encontrar la llave de platalunar".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535640&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b8e9bf2a-1245-4e7e-8903-2732869cd679\', \'multiverseId\': 535640}, \'multiverseid\': 535640}, {\'name\': \'Gardes de Cerf-orient\', \'text\': "Vigilance\\nCongrégation — Au début du combat pendant votre tour, si vous contrôlez au moins trois créatures avec des forces différentes, les créatures que vous contrôlez gagnent +1/ +0 jusqu\'à la fin du tour.", \'type\': \'Créature : humain et psychagogue\', \'flavor\': "« L\'équilibre entre le jour et la nuit est rompu. Nous devons trouver la clé d\'argent de lune. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535956&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'acdd76b7-b001-4a73-8929-af21ab6a4aa7\', \'multiverseId\': 535956}, \'multiverseid\': 535956}, {\'name\': \'Guardiane Albacorno\', \'text\': "Cautela\\nCongrega — All\'inizio del combattimento nel tuo turno, se controlli tre o più creature con forza diversa, le creature che controlli prendono +1/+0 fino alla fine del turno.", \'type\': \'Creatura — Warlock Umano\', \'flavor\': \'"L\\\'equilibrio tra il giorno e la notte è infranto. Dobbiamo trovare la Chiave di Selenargento."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536272&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ab1b1f07-ef81-412e-b5f7-245e770114a6\', \'multiverseId\': 536272}, \'multiverseid\': 536272}, {\'name\': \'ドーンハルトの管理人\', \'text\': \'警戒\\n集会 — あなたのターンの戦闘の開始時に、あなたがパワーが異なる３体以上のクリーチャーをコントロールしている場合、ターン終了時まで、あなたがコントロールしているすべてのクリーチャーは＋１/＋０の修整を受ける。\', \'type\': \'クリーチャー — 人間・邪術師\', \'flavor\': \'「昼と夜の均衡が破られた。月銀の鍵を見つけなければ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536588&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8066158b-2d4b-497a-8032-d1e2583512ec\', \'multiverseId\': 536588}, \'multiverseid\': 536588}, {\'name\': \'새벽수사슴 관리인\', \'text\': \'경계\\n집회 — 당신의 턴 전투 시작에, 당신이 서로 공격력이 다른 생물을 세 개 이상 조종한다면, 당신이 조종하는 생물들은 턴종료까지 +1/+0을 받는다.\', \'type\': \'생물 — 인간 흑마법사\', \'flavor\': \'"낮과 밤의 균형이 깨졌어. 은달빛 열쇠를 찾아야만 해."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536904&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d12d49eb-916d-4ec2-bd25-f0dc5567c160\', \'multiverseId\': 536904}, \'multiverseid\': 536904}, {\'name\': \'Guardiãs Cervo da Aurora\', \'text\': \'Vigilância\\nConventículo — No início do combate no seu turno, se você controlar três ou mais criaturas com poderes diferentes, as criaturas que você controla recebem +1/+0 até o final do turno.\', \'type\': \'Criatura — Humano Bruxo\', \'flavor\': \'"O equilíbrio entre o dia e a noite foi quebrado. Precisamos encontrar a Chave de Prata Lunar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537220&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'afa04e3e-d980-4d65-a46b-c5548b7697e9\', \'multiverseId\': 537220}, \'multiverseid\': 537220}, {\'name\': \'Стражницы Донхарта\', \'text\': \'Бдительность\\nШабаш — В начале боя во время вашего хода, если вы контролируете не менее трех существ с различными значениями силы, существа под вашим контролем получают +1/+0 до конца хода.\', \'type\': \'Существо — Человек Колдун\', \'flavor\': \'«Равновесие дня и ночи разрушено. Мы должны отыскать Ключ лунного серебра».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537536&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ff81025d-29a5-45b6-a8f8-1954fc742fc1\', \'multiverseId\': 537536}, \'multiverseid\': 537536}, {\'name\': \'曙鹿集护卫\', \'text\': \'警戒\\n鸠集～在你回合的战斗开始时，若你操控三个或更多力量各不相同的生物，则由你操控的生物得+1/+0直到回合结束。\', \'type\': \'生物 ～人类／邪术师\', \'flavor\': \'「昼夜平衡已被破坏，我们必须找到月银钥。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537852&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'456c1979-84a1-4237-8728-0fcf09790852\', \'multiverseId\': 537852}, \'multiverseid\': 537852}, {\'name\': \'曙鹿集護衛\', \'text\': \'警戒\\n鳩集～在你回合的戰鬥開始時，若你操控三個或更多力量各不相同的生物，則由你操控的生物得+1/+0直到回合結束。\', \'type\': \'生物 ～人類／邪術師\', \'flavor\': \'「晝夜平衡已被破壞，我們必須找到月銀鑰。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538168&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c9fb4b0a-05b9-49b6-8108-91104c4f0435\', \'multiverseId\': 538168}, \'multiverseid\': 538168}]', '[{\'name\': \'Morgenlicht-Mentorin\', \'text\': \'Wenn die Morgenlicht-Mentorin ins Spiel kommt, erzeuge einen 1/1 weißen Mensch-Kreaturenspielstein.\\nHexenzirkel — {5}{G}: Eine Kreatur deiner Wahl, die du kontrollierst, erhält +3/+3 und verursacht Trampelschaden bis zum Ende des Zuges. Aktiviere diese Fähigkeit nur, falls du drei oder mehr Kreaturen mit unterschiedlicher Stärke kontrollierst.\', \'type\': \'Kreatur — Mensch, Hexenmeister\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535281&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c4a5c982-a5e3-4d6f-9712-38549636831d\', \'multiverseId\': 535281}, \'multiverseid\': 535281}, {\'name\': \'Mentora de Ciervas del Alba\', \'text\': \'Cuando la Mentora de Ciervas del Alba entre al campo de batalla, crea una ficha de criatura Humano blanca 1/1.\\nAquelarre — {5}{G}: La criatura objetivo que controlas obtiene +3/+3 y gana la habilidad de arrollar hasta el final del turno. Activa esto solo si controlas tres o más criaturas con fuerzas distintas.\', \'type\': \'Criatura — Brujo humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535597&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5af6e8bf-4b06-4051-9830-aa9501a23b76\', \'multiverseId\': 535597}, \'multiverseid\': 535597}, {\'name\': \'Mentor de Cerf-orient\', \'text\': "Quand la Mentor de Cerf-orient arrive sur le champ de bataille, créez un jeton de créature 1/1 blanche Humain.\\nCongrégation — {5}{G} : Une créature ciblée que vous contrôlez gagne +3/+3 et acquiert le piétinement jusqu\'à la fin du tour. N\'activez que si vous contrôlez au moins trois créatures avec des forces différentes.", \'type\': \'Créature : humain et psychagogue\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535913&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4fa3bf23-e8c7-4835-a7e8-6b04493da19c\', \'multiverseId\': 535913}, \'multiverseid\': 535913}, {\'name\': \'Mentore Albacorno\', \'text\': \'Quando la Mentore Albacorno entra nel campo di battaglia, crea una pedina creatura Umano 1/1 bianca.\\nCongrega — {5}{G}: Una creatura bersaglio che controlli prende +3/+3 e ha travolgere fino alla fine del turno. Attiva solo se controlli tre o più creature con forza diversa.\', \'type\': \'Creatura — Warlock Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536229&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b1fb1c8b-9127-4f20-aa13-45e014e4f6b5\', \'multiverseId\': 536229}, \'multiverseid\': 536229}, {\'name\': \'ドーンハルトの導師\', \'text\': \'ドーンハルトの導師が戦場に出たとき、白の１/１の人間・クリーチャー・トークン１体を生成する。\\n集会 — {5}{G}：あなたがコントロールしているクリーチャー１体を対象とする。ターン終了時まで、それは＋３/＋３の修整を受けトランプルを得る。あなたがパワーが異なる３体以上のクリーチャーをコントロールしていなければ起動できない。\', \'type\': \'クリーチャー — 人間・邪術師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536545&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'10d6dd9a-4cf1-4879-b1cb-2178818c35b2\', \'multiverseId\': 536545}, \'multiverseid\': 536545}, {\'name\': \'새벽수사슴 스승\', \'text\': \'새벽수사슴 스승이 전장에 들어올 때, 1/1 백색 인간 생물 토큰 한 개를 만든다.\\n집회 — {5}{G}: 당신이 조종하는 생물을 목표로 정한다. 그 생물은 턴종료까지 +3/+3을 받고 돌진을 얻는다. 당신이 서로 다른 공격력을 가진 생물을 세 개 이상 조종하는 경우에만 활성화할 수 있다.\', \'type\': \'생물 — 인간 흑마법사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536861&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'660fe6b4-7c4b-43f0-acb0-5d3eb221dc07\', \'multiverseId\': 536861}, \'multiverseid\': 536861}, {\'name\': \'Mentora Cervo da Aurora\', \'text\': \'Quando Mentora Cervo da Aurora entrar no campo de batalha, crie uma ficha de criatura Humano branca 1/1.\\nConventículo — {5}{G}: A criatura alvo que você controla recebe +3/+3 e ganha atropelar até o final do turno. Ative somente se você controlar três ou mais criaturas com poderes diferentes.\', \'type\': \'Criatura — Humano Bruxo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537177&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f141550f-8ce3-4568-8a85-b9c546b8816a\', \'multiverseId\': 537177}, \'multiverseid\': 537177}, {\'name\': \'Наставница Донхарта\', \'text\': \'Когда Наставница Донхарта выходит на поле битвы, создайте одну фишку существа 1/1 белый Человек.\\nШабаш — {5}{G}: целевое существо под вашим контролем получает +3/+3 и Пробивной удар до конца хода. Активируйте, только если вы контролируете не менее трех существ с различными значениями силы.\', \'type\': \'Существо — Человек Колдун\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537493&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7363b46f-300d-4388-b5f3-4921b8d60929\', \'multiverseId\': 537493}, \'multiverseid\': 537493}, {\'name\': \'曙鹿集导师\', \'text\': \'当曙鹿集导师进战场时，派出一个1/1白色人类衍生生物。\\n鸠集～{5}{G}：直到回合结束，目标由你操控的生物得+3/+3且获得践踏异能。只能于你操控三个或更多力量各不相同的生物时起动。\', \'type\': \'生物 ～人类／邪术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537809&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dd0e1ae1-1f63-42bf-b318-dcdccc72309e\', \'multiverseId\': 537809}, \'multiverseid\': 537809}, {\'name\': \'曙鹿集導師\', \'text\': \'當曙鹿集導師進戰場時，派出一個1/1白色人類衍生生物。\\n鳩集～{5}{G}：直到回合結束，目標由你操控的生物得+3/+3且獲得踐踏異能。只能於你操控三個或更多力量各不相同的生物時起動。\', \'type\': \'生物 ～人類／邪術師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538125&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c42de694-4eb7-4dba-944c-e709538b9317\', \'multiverseId\': 538125}, \'multiverseid\': 538125}]', '[{\'name\': \'Morgenlicht-Verjüngerin\', \'text\': \'Wenn die Morgenlicht-Verjüngerin ins Spiel kommt, erhältst du 3 Lebenspunkte dazu.\\n{T}: Erzeuge ein Mana einer beliebigen Farbe.\', \'type\': \'Kreatur — Mensch, Hexenmeister\', \'flavor\': \'„Überall wo es Leben gibt, liegt Macht für jemanden, der die alten Sitten kennt."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535282&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4b2096b4-ce94-48bd-b762-1059d4992a35\', \'multiverseId\': 535282}, \'multiverseid\': 535282}, {\'name\': \'Vigorizadora de Ciervas del Alba\', \'text\': \'Cuando la Vigorizadora de Ciervas del Alba entre al campo de batalla, ganas 3 vidas.\\n{T}: Agrega un maná de cualquier color.\', \'type\': \'Criatura — Brujo humano\', \'flavor\': \'"Donde hay vida, hay poder para quien conoce las viejas costumbres".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535598&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9200f633-3792-4a41-a402-fb58deeae589\', \'multiverseId\': 535598}, \'multiverseid\': 535598}, {\'name\': \'Rajeunisseuse de Cerf-orient\', \'text\': \'Quand la Rajeunisseuse de Cerf-orient arrive sur le champ de bataille, vous gagnez 3 points de vie.\\n{T} : Ajoutez un mana de la couleur de votre choix.\', \'type\': \'Créature : humain et psychagogue\', \'flavor\': \'« Là où il y a de la vie, il y a du pouvoir pour qui connaît les traditions. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535914&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'25e1ea7f-5619-457e-84b3-eb90c5c53d7c\', \'multiverseId\': 535914}, \'multiverseid\': 535914}, {\'name\': \'Rinvigoritrice Albacorno\', \'text\': \'Quando la Rinvigoritrice Albacorno entra nel campo di battaglia, guadagni 3 punti vita.\\n{T}: Aggiungi un mana di un qualsiasi colore.\', \'type\': \'Creatura — Warlock Umano\', \'flavor\': \'"Ovunque ci sia vita c\\\'è potere, per chi conosce le antiche usanze."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536230&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'df6cd89f-5ab9-4689-be1e-b692092f093e\', \'multiverseId\': 536230}, \'multiverseid\': 536230}, {\'name\': \'ドーンハルトの再生者\', \'text\': \'ドーンハルトの再生者が戦場に出たとき、あなたは３点のライフを得る。\\n{T}：好きな色１色のマナ１点を加える。\', \'type\': \'クリーチャー — 人間・邪術師\', \'flavor\': \'「命ある場所には、古きを知る者の力がある。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536546&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ce7e78ba-fada-486b-ac5c-c672d1651e39\', \'multiverseId\': 536546}, \'multiverseid\': 536546}, {\'name\': \'새벽수사슴 원기회복사\', \'text\': \'새벽수사슴 원기회복사가 전장에 들어올 때, 당신은 생명 3점을 얻는다.\\n{T}: 원하는 색의 마나 한 개를 추가한다.\', \'type\': \'생물 — 인간 흑마법사\', \'flavor\': \'"생명이 있는 곳이라면, 옛 시대의 도를 아는 자가 사용할 수 있는 힘이 있다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536862&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8e137a55-1e54-428a-8b47-cfd8f5018bfd\', \'multiverseId\': 536862}, \'multiverseid\': 536862}, {\'name\': \'Rejuvenescedora Cervo da Aurora\', \'text\': \'Quando Rejuvenescedora Cervo da Aurora entra no campo de batalha, você ganha 3 pontos de vida.\\n{T}: Adicione um mana de qualquer cor.\', \'type\': \'Criatura — Humano Bruxo\', \'flavor\': \'"Onde quer que haja vida há poder para quem conhece os costumes antigos."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537178&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f7643528-b611-49d7-86d9-100d9ab5ed61\', \'multiverseId\': 537178}, \'multiverseid\': 537178}, {\'name\': \'Омолодительница Донхарта\', \'text\': \'Когда Омолодительница Донхарта выходит на поле битвы, вы получаете 3 жизни.\\n{T}: добавьте одну ману любого цвета.\', \'type\': \'Существо — Человек Колдун\', \'flavor\': \'«Везде, где есть жизнь, есть и сила для того, кто ведает старые пути».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537494&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5d206d0e-2e33-463b-95ac-ef68365ab480\', \'multiverseId\': 537494}, \'multiverseid\': 537494}, {\'name\': \'曙鹿集回春师\', \'text\': \'当曙鹿集回春师进战场时，你获得3点生命。\\n{T}：加一点任意颜色的法术力。\', \'type\': \'生物 ～人类／邪术师\', \'flavor\': \'「但凡有生命之处，知晓古道之人就能积聚力量。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537810&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9a832a4b-219d-446a-afc7-e574443384cf\', \'multiverseId\': 537810}, \'multiverseid\': 537810}, {\'name\': \'曙鹿集回春師\', \'text\': \'當曙鹿集回春師進戰場時，你獲得3點生命。\\n{T}：加一點任意顏色的魔法力。\', \'type\': \'生物 ～人類／邪術師\', \'flavor\': \'「但凡有生命之處，知曉古道之人就能積聚力量。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538126&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a08703a9-1d0a-4f74-b6a4-5a888497323d\', \'multiverseId\': 538126}, \'multiverseid\': 538126}]', '[{\'name\': \'Morkrutsumpf-Behemoth\', \'text\': \'Opfere eine Kreatur oder bezahle {1}{B} als zusätzliche Kosten, um diesen Zauberspruch zu wirken.\\nBedrohlich (Diese Kreatur kann nicht geblockt werden, außer von zwei oder mehr Kreaturen.)\', \'type\': \'Kreatur — Zombie, Riese\', \'flavor\': \'„Mal sehen, wie sich die kleinen zusammengeflickten Spielzeuge meines Bruders gegen das hier schlagen."\\n—Gisa die Ghulruferin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535204&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6f1f7705-2684-4a26-9e01-5635c3da4327\', \'multiverseId\': 535204}, \'multiverseid\': 535204}, {\'name\': \'Behemot de Morkrut\', \'text\': \'Como coste adicional para lanzar este hechizo, sacrifica una criatura o paga {1}{B}.\\nAmenaza. (Esta criatura no puede ser bloqueada excepto por dos o más criaturas.)\', \'type\': \'Criatura — Gigante zombie\', \'flavor\': \'"Veamos si los juguetitos suturados de mi hermano pueden con esto".\\n—Gisa, la Llamamuertos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535520&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b76d0f37-12a5-4f03-a29e-2ba641736556\', \'multiverseId\': 535520}, \'multiverseid\': 535520}, {\'name\': \'Béhémoth de Morkrut\', \'text\': \'En tant que coût supplémentaire pour lancer ce sort, sacrifiez une créature ou payez {1}{B}.\\nMenace (Cette créature ne peut pas être bloquée excepté par deux créatures ou plus.)\', \'type\': \'Créature : zombie et géant\', \'flavor\': \'« Que les petits jouets raccommodés de mon frère viennent se mesurer à ça. »\\n—Gisa, meneuse de goule\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535836&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a3c7fd7c-6ec5-447b-880f-5026e20b3e98\', \'multiverseId\': 535836}, \'multiverseid\': 535836}, {\'name\': \'Behemoth di Morkrut\', \'text\': \'Come costo addizionale per lanciare questa magia, sacrifica una creatura o paga {1}{B}.\\nMinacciare (Questa creatura non può essere bloccata tranne che da due o più creature.)\', \'type\': \'Creatura — Gigante Zombie\', \'flavor\': \'"Vediamo come se la cavano i giocattoli ricuciti di mio fratello con questo."\\n—Gisa l\\\'evocaghoul\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536152&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4263be68-3857-4171-9b12-559b8242fc2f\', \'multiverseId\': 536152}, \'multiverseid\': 536152}, {\'name\': \'モークラットのビヒモス\', \'text\': \'この呪文を唱えるための追加コストとして、クリーチャー１体を生け贄に捧げるか{1}{B}を支払う。\\n威迫（このクリーチャーは２体以上のクリーチャーによってしかブロックされない。）\', \'type\': \'クリーチャー — ゾンビ・巨人\', \'flavor\': \'「さて、我が弟君の継ぎ接ぎのちっぽけなオモチャがこいつに太刀打ちできるのかしらね。」\\n――グール呼びのギサ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536468&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cd889dec-4719-4be2-8415-d151fe82a793\', \'multiverseId\': 536468}, \'multiverseid\': 536468}, {\'name\': \'모르크루트 거대괴수\', \'text\': \'이 주문을 발동하기 위한 추가비용으로, 생물 한 개를 희생하거나 {1}{B}를 지불한다.\\n호전적 (이 생물은 두 개 이상의 생물에만 방어될 수 있다.)\', \'type\': \'생물 — 좀비 거인\', \'flavor\': \'"어디 내 동생이 꿰매 붙인 조그마한 인형들이 이것과 겨룰 수 있을지 한번 보자고."\\n—악귀소환술사 기샤\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536784&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'35dbe898-fc3e-4e39-9e5c-4f68887c194b\', \'multiverseId\': 536784}, \'multiverseid\': 536784}, {\'name\': \'Behemoth do Morkrut\', \'text\': \'Como custo adicional para conjurar esta mágica, sacrifique uma criatura ou pague {1}{B}.\\nAmeaçar (Esta criatura só pode ser bloqueada por duas ou mais criaturas.)\', \'type\': \'Criatura — Zumbi Gigante\', \'flavor\': \'"Quero ver os brinquedinhos costurados do meu irmão competirem com isso."\\n— Gisa, Invocadora de Carniçais\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537100&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e8ec7630-71fa-4db4-bad2-a2a91f136eb5\', \'multiverseId\': 537100}, \'multiverseid\': 537100}, {\'name\': \'Моркрутское Чудище\', \'text\': \'В качестве дополнительной стоимости разыгрывания этого заклинания пожертвуйте существо или заплатите {1}{B}.\\nУгроза (Это существо не может быть заблокировано менее чем двумя существами.)\', \'type\': \'Существо — Зомби Гигант\', \'flavor\': \'«Поглядим, что с этим смогут сделать сшитые игрушки моего братца».\\n— призывательница упырей Джиза\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537416&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'84e3ea8a-a12f-43f2-bd5b-461d29478986\', \'multiverseId\': 537416}, \'multiverseid\': 537416}, {\'name\': \'穆坎贝西摩斯\', \'text\': \'牺牲一个生物或支付{1}{B}，以作为施放此咒语的额外费用。\\n威慑（此生物只能被两个或更多生物阻挡。）\', \'type\': \'生物 ～灵俑／巨人\', \'flavor\': \'「我倒要看看弟弟拼接出来的小玩具有没有这东西厉害。」\\n～尸鬼牧者基沙\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537732&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d1042031-f7b0-4aa8-b87a-044b1b747598\', \'multiverseId\': 537732}, \'multiverseid\': 537732}, {\'name\': \'穆坎貝西摩斯\', \'text\': \'犧牲一個生物或支付{1}{B}，以作為施放此咒語的額外費用。\\n威懾（此生物只能被兩個或更多生物阻擋。）\', \'type\': \'生物 ～殭屍／巨人\', \'flavor\': \'「我倒要看看弟弟拼接出來的小玩具有沒有這東西厲害。」\\n～屍鬼牧者基沙\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538048&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'316ba12c-7654-40bb-be25-1deee5936b7d\', \'multiverseId\': 538048}, \'multiverseid\': 538048}]', '[{\'name\': \'Nekrosynthese\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur hat „Immer wenn eine andere Kreatur stirbt, lege eine +1/+1-Marke auf diese Kreatur."\\nWenn die verzauberte Kreatur stirbt, schaue dir die obersten X Karten deiner Bibliothek an, wobei X gleich ihrer Stärke ist. Nimm eine davon auf deine Hand und lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535205&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'811ffbd1-ec3c-4517-9aeb-dcc78c385535\', \'multiverseId\': 535205}, \'multiverseid\': 535205}, {\'name\': \'Necrosíntesis\', \'text\': \'Encantar criatura.\\nLa criatura encantada tiene "Siempre que otra criatura muera, pon un contador +1/+1 sobre esta criatura".\\nCuando la criatura encantada muera, mira las X primeras cartas de tu biblioteca, donde X es su fuerza. Pon una de esas cartas en tu mano y el resto en el fondo de tu biblioteca en un orden aleatorio.\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535521&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c3e2e555-4f36-48d0-ac65-1f4a621b0b51\', \'multiverseId\': 535521}, \'multiverseid\': 535521}, {\'name\': \'Nécrosynthèse\', \'text\': "Enchanter : créature\\nLa créature enchantée a « À chaque fois qu\'une autre créature meurt, mettez un marqueur +1/+1 sur cette créature. »\\nQuand la créature enchantée meurt, regardez les X cartes du dessus de votre bibliothèque, X étant sa force. Mettez l\'une de ces cartes dans votre main et le reste au-dessous de votre bibliothèque, dans un ordre aléatoire.", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535837&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3423863a-9131-4a94-9760-a77fcc29e538\', \'multiverseId\': 535837}, \'multiverseid\': 535837}, {\'name\': \'Necrosintesi\', \'text\': \'Incanta creatura\\nLa creatura incantata ha "Ogniqualvolta un\\\'altra creatura muore, metti un segnalino +1/+1 su questa creatura".\\nQuando la creatura incantata muore, guarda le prime X carte del tuo grimorio, dove X è la sua forza. Aggiungi una di quelle carte alla tua mano e metti le altre in fondo al tuo grimorio in ordine casuale.\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536153&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d367a669-7b36-4181-96c0-d856e269192d\', \'multiverseId\': 536153}, \'multiverseid\': 536153}, {\'name\': \'屍合成\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントしているクリーチャーは「これでないクリーチャー１体が死亡するたび、このクリーチャーの上に＋１/＋１カウンター１個を置く。」を持つ。\\nエンチャントしているクリーチャーが死亡したとき、あなたのライブラリーの一番上にあるカードＸ枚を見る。Ｘはそのクリーチャーのパワーに等しい。それらのカードのうち１枚をあなたの手札に、残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536469&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3b9fa534-b183-4deb-9113-5dd9af18af4d\', \'multiverseId\': 536469}, \'multiverseid\': 536469}, {\'name\': \'사령합성\', \'text\': \'생물에게 부여\\n부여된 생물은 "다른 생물이 죽을 때마다, 이 생물에 +1/+1 카운터 한 개를 올려놓는다."를 가진다.\\n부여된 생물이 죽을 때, 당신의 서고 맨 위 카드 X장을 본다. X는 그 생물의 공격력이다. 그 카드들 중 한 장을 당신의 손으로 가져가고 나머지 카드들은 무작위 순서로 당신의 서고 맨 밑에 놓는다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536785&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a828b160-c36a-4a46-9bf8-ca7f2cc40c66\', \'multiverseId\': 536785}, \'multiverseid\': 536785}, {\'name\': \'Necrossíntese\', \'text\': \'Encantar criatura\\nA criatura encantada tem "Toda vez que outra criatura morrer, coloque um marcador +1/+1 nesta criatura".\\nQuando a criatura encantada morrer, olhe os X cards do topo de seu grimório, sendo X o poder dela. Coloque um daqueles cards em sua mão e o restante no fundo de seu grimório em ordem aleatória.\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537101&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5ecad3bc-92fa-4763-9ec0-5f3fe7e93413\', \'multiverseId\': 537101}, \'multiverseid\': 537101}, {\'name\': \'Некросинтез\', \'text\': \'Зачаровать существо\\nЗачарованное существо имеет способность «Каждый раз, когда другое существо умирает, положите один жетон +1/+1 на это существо».\\nКогда зачарованное существо умирает, посмотрите X верхних карт вашей библиотеки, где X — значение его силы. Положите одну из тех карт в вашу руку, а остальные — в низ вашей библиотеки в случайном порядке.\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537417&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c1fe7801-803d-49b2-9dec-caabfe48fa56\', \'multiverseId\': 537417}, \'multiverseid\': 537417}, {\'name\': \'死冥聚合\', \'text\': \'结附于生物\\n所结附的生物具有「每当另一个生物死去时，在此生物上放置一个+1/+1指示物。」\\n当所结附的生物死去时，检视你牌库顶的X张牌，X为其力量。将其中一张置于你手上，其余的牌则以随机顺序置于你的牌库底。\', \'type\': \'结界 ～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537733&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c005b962-78b8-4709-901f-3ffd18f2a28f\', \'multiverseId\': 537733}, \'multiverseid\': 537733}, {\'name\': \'死冥聚合\', \'text\': \'結附於生物\\n所結附的生物具有「每當另一個生物死去時，在此生物上放置一個+1/+1指示物。」\\n當所結附的生物死去時，檢視你牌庫頂的X張牌，X為其力量。將其中一張置於你手上，其餘的牌則以隨機順序置於你的牌庫底。\', \'type\': \'結界 ～靈氣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538049&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'13ecc102-3822-40a9-9ce1-09699e5b2e7d\', \'multiverseId\': 538049}, \'multiverseid\': 538049}]', '[{\'name\': \'Nutze den Sturm\', \'text\': \'Erzeuge einen roten Elementarwesen-Kreaturenspielstein, der Trampelschaden verursacht, mit „Stärke und Widerstandskraft dieser Kreatur sind gleich der Anzahl an Spontanzauber- und Hexereikarten in deinem Friedhof plus der Anzahl an Karten mit Rückblende, die du besitzt und die sich im Exil befinden."\\nRückblende {6}{R} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten wirken. Schicke sie danach ins Exil.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535254&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f8185856-882d-45a1-97ab-9221b0ee982c\', \'multiverseId\': 535254}, \'multiverseid\': 535254}, {\'name\': \'Hacerse con la tormenta\', \'text\': \'Crea una ficha de criatura Elemental roja con la habilidad de arrollar y "Tanto la fuerza como la resistencia de esta criatura son iguales a la cantidad de cartas de instantáneo y de conjuro en tu cementerio más la cantidad de cartas con la habilidad de retrospectiva de las cuales eres propietario en el exilio".\\nRetrospectiva {6}{R}. (Puedes lanzar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego exíliala.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535570&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'34ce3b8b-1318-48ff-98d3-6994aad59b25\', \'multiverseId\': 535570}, \'multiverseid\': 535570}, {\'name\': "S\'emparer de la tempête", \'text\': "Créez un jeton de créature rouge Élémental avec le piétinement et « La force et l\'endurance de cette créature sont chacune égales au nombre de cartes d\'éphémère et de rituel dans votre cimetière plus le nombre de cartes avec le flashback que vous possédez en exil. »\\nFlashback {6}{R} (Vous pouvez lancer cette carte depuis votre cimetière pour son coût de flashback. Exilez-la ensuite.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535886&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9f774c9e-7446-42a8-adf3-bed574e6c415\', \'multiverseId\': 535886}, \'multiverseid\': 535886}, {\'name\': \'Catturare la Tempesta\', \'text\': \'Crea una pedina creatura Elementale rossa con travolgere e "La forza e la costituzione di questa creatura sono pari al numero di carte istantaneo e stregoneria nel tuo cimitero più il numero di carte con flashback che possiedi in esilio".\\nFlashback {6}{R} (Puoi lanciare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi esiliala.)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536202&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'944a94a0-735e-412b-b867-877e55570a5d\', \'multiverseId\': 536202}, \'multiverseid\': 536202}, {\'name\': \'嵐の捕縛\', \'text\': \'トランプルと「このクリーチャーのパワーとタフネスはそれぞれ、あなたの墓地にありインスタントやソーサリーであるカードの枚数と追放領域にありあなたがオーナーでありフラッシュバックを持つカードの枚数を足した値に等しい。」を持つ赤のエレメンタル・クリーチャー・トークン１体を生成する。\\nフラッシュバック{6}{R}（あなたはあなたの墓地から、このカードをフラッシュバック・コストで唱えてもよい。その後、これを追放する。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536518&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f1908a93-1209-420d-94a0-ebd8ff1b8623\', \'multiverseId\': 536518}, \'multiverseid\': 536518}, {\'name\': \'폭풍 붙잡기\', \'text\': \'돌진 및 "이 생물의 공격력 및 방어력은 각각 당신의 무덤에 있는 순간마법 및 집중마법의 수에 추방 영역에 있는 카드들 중 당신이 소유한 회상을 가진 카드의 수를 더한 것과 같다."를 가진 적색 정령 생물 토큰 한 개를 만든다.\\n회상 {6}{R} (당신은 이 카드의 회상 비용을 지불해 이 카드를 당신의 무덤에서 발동할 수 있다. 그 후 이 카드를 추방한다.)\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536834&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2124cdee-eb3e-4940-a510-46d4f909b864\', \'multiverseId\': 536834}, \'multiverseid\': 536834}, {\'name\': \'Apreender a Tempestade\', \'text\': \'Crie uma ficha de criatura Elemental vermelha com atropelar e "O poder e a resistência desta criatura são ambos iguais ao número de cards de mágica instantânea e feitiço em seu cemitério mais o número de cards com recapitular seus no exílio".\\nRecapitular {6}{R} (Você pode conjurar este card de seu cemitério pagando seu custo de recapitular. Depois, exile-o.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537150&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3f3d46ff-90e3-44d2-a108-3891c3cf1ece\', \'multiverseId\': 537150}, \'multiverseid\': 537150}, {\'name\': \'Покорить Бурю\', \'text\': \'Создайте одну фишку существа красный Элементаль с Пробивным ударом и способностью «Сила и выносливость этого существа равны количеству карт волшебства и мгновенных заклинаний на вашем кладбище в сумме с количеством принадлежащих вам карт с Воспоминанием в изгнании».\\nВоспоминание {6}{R} (Вы можете разыграть эту карту из вашего кладбища за ее стоимость Воспоминания. Затем изгоните ее.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537466&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8f58a575-fdc9-44e7-b308-0295502f71e9\', \'multiverseId\': 537466}, \'multiverseid\': 537466}, {\'name\': \'掌握风暴\', \'text\': \'派出一个红色元素衍生生物，且具有践踏与「此生物的力量和防御力各等同于你坟墓场中瞬间与法术牌数量和放逐区中由你拥有且具返照异能的牌数量之总和。」\\n返照{6}{R}（你可以从你坟墓场中施放此牌，并支付其返照费用，然后将它放逐。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537782&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'175d5d9a-46fd-4380-ba98-bd6669eef9b9\', \'multiverseId\': 537782}, \'multiverseid\': 537782}, {\'name\': \'掌握風暴\', \'text\': \'派出一個紅色元素衍生生物，且具有踐踏與「此生物的力量和防禦力各等同於你墳墓場中瞬間與巫術牌數量和放逐區中由你擁有且具返照異能的牌數量之總和。」\\n返照{6}{R}（你可以從你墳墓場中施放此牌，並支付其返照費用，然後將它放逐。）\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538098&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d5855d94-9eb5-420d-8ccb-34ea712ce63c\', \'multiverseId\': 538098}, \'multiverseid\': 538098}]', '[{\'name\': \'Okkultisten-Novizin\', \'text\': \'Wenn die Okkultisten-Novizin stirbt, ziehst du eine Karte und verlierst 1 Lebenspunkt.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'Überall in Gaven, in verschlossenen Schlafzimmern und verriegelten Scheunen, suchen die Jungen nach den Antworten, die die Älteren ihnen nicht geben konnten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535207&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'796c7a56-9a1d-4378-b9ee-cfe8fccb6bff\', \'multiverseId\': 535207}, \'multiverseid\': 535207}, {\'name\': \'Ocultista novata\', \'text\': \'Cuando la Ocultista novata muera, robas una carta y pierdes 1 vida.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'Por todo Gavony, los jóvenes buscan en habitaciones y graneros cerrados las respuestas que sus mayores no pudieron darles.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535523&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f5948485-7682-43d4-b1a0-c453db99f156\', \'multiverseId\': 535523}, \'multiverseid\': 535523}, {\'name\': \'Occultiste novice\', \'text\': "Quand l\'Occultiste novice meurt, vous piochez une carte et vous perdez 1 point de vie.", \'type\': \'Créature : humain et sorcier\', \'flavor\': "Partout en Gavonie, dans des chambres aux volets clos et des granges verrouillées, de jeunes gens cherchent les réponses que leurs aînés n\'ont pas su leur donner.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535839&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f9b822e7-d11c-4c92-b8a2-b28b8ddc907b\', \'multiverseId\': 535839}, \'multiverseid\': 535839}, {\'name\': \'Occultista Novizia\', \'text\': "Quando l\'Occultista Novizia muore, peschi una carta e perdi 1 punto vita.", \'type\': \'Creatura — Mago Umano\', \'flavor\': \'In tutta Gavony, nelle camere chiuse a chiave e nei fienili barricati, i giovani cercano le risposte che gli anziani non hanno saputo fornire.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536155&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ad230308-c340-4eab-a2b4-1bd6a9d0843b\', \'multiverseId\': 536155}, \'multiverseid\': 536155}, {\'name\': \'新米密教信者\', \'text\': \'新米密教信者が死亡したとき、あなたはカード１枚を引き、１点のライフを失う。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'ガヴォニー中で、年長者が答えてくれない秘密の答えを求めて、若者たちは閉ざされた寝室や施錠された家畜小屋を探る。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536471&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b3822b03-782c-4102-8f13-fabc85c6ed20\', \'multiverseId\': 536471}, \'multiverseid\': 536471}, {\'name\': \'초보 비술사\', \'text\': \'초보 비술사가 죽을 때, 당신은 카드 한 장을 뽑고 생명 1점을 잃는다.\', \'type\': \'생물 — 인간 마법사\', \'flavor\': \'가보니 전역에 걸쳐, 젊은이들은 문을 닫은 침실과 걸어 잠근 헛간 안에서 연장자들이 알려 주지 못한 답을 찾는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536787&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'fab4bca4-202a-436a-acef-120a0b2c7fda\', \'multiverseId\': 536787}, \'multiverseid\': 536787}, {\'name\': \'Ocultista Novata\', \'text\': \'Quando Ocultista Novata morre, você compra um card e perde 1 ponto de vida.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'Por toda Gavony, em quartos fechados e celeiros trancados, os jovens buscam as respostas que os mais velhos não conseguiram oferecer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537103&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b79a639f-72c3-415c-8c89-d2a846ff01d6\', \'multiverseId\': 537103}, \'multiverseid\': 537103}, {\'name\': \'Начинающая Оккультистка\', \'text\': \'Когда Начинающая Оккультистка умирает, вы берете карту и теряете 1 жизнь.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'По всей Гевоне, закрывшись в своих спальнях и заперевшись в сараях, молодые люди искали ответы, которые не смогли дать их старейшины.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537419&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'927b6c42-175f-4568-851b-e37792c502ae\', \'multiverseId\': 537419}, \'multiverseid\': 537419}, {\'name\': \'新手神秘学者\', \'text\': \'当新手神秘学者死去时，你抓一张牌且失去1点生命。\', \'type\': \'生物 ～人类／法术师\', \'flavor\': \'在整个加渥尼，都有年轻人将自己关在紧闭卧室与上锁谷仓之中，致力搜寻前一辈人未能给出的答案。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537735&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c63a1538-2ff5-444c-878e-c8225b1529e1\', \'multiverseId\': 537735}, \'multiverseid\': 537735}, {\'name\': \'新手神秘學者\', \'text\': \'當新手神秘學者死去時，你抽一張牌且失去1點生命。\', \'type\': \'生物 ～人類／魔法師\', \'flavor\': \'在整個加渥尼，都有年輕人將自己關在緊閉臥室與上鎖穀倉之中，致力搜尋前一輩人未能給出的答案。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538051&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f2e3025f-4b0b-4be1-bf55-aa073bd9f5c9\', \'multiverseId\': 538051}, \'multiverseid\': 538051}]', '[{\'name\': \'Olivias Mitternachtsmahl\', \'text\': \'Eine Kreatur deiner Wahl erhält -2/-2 bis zum Ende des Zuges. Falls es Nacht ist, erhält die Kreatur stattdessen -13/-13 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Du Arme warst mit deinem Ritual fast fertig, nicht wahr? Wie ausgesprochen unhöflich von mir. Um es wieder gutzumachen, schicke ich dir eine Einladung zu meiner Hochzeit."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535208&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bd0a7c04-a305-46de-bb74-25020702d263\', \'multiverseId\': 535208}, \'multiverseid\': 535208}, {\'name\': \'Emboscada de medianoche de Olivia\', \'text\': \'La criatura objetivo obtiene -2/-2 hasta el final del turno. Si es de noche, en vez de eso, esa criatura obtiene -13/-13 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"Ya casi habías acabado ese ritual, ¿verdad, cariño? Qué maleducada soy. Para compensártelo, te enviaré una invitación para mi boda".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535524&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d615b57c-2a44-4d69-83ab-11da56d46187\', \'multiverseId\': 535524}, \'multiverseid\': 535524}, {\'name\': "Embuscade d\'Olivia à minuit", \'text\': "Une créature ciblée gagne -2/-2 jusqu\'à la fin du tour. Si c\'est la nuit, cette créature gagne -13/-13 jusqu\'à la fin du tour à la place.", \'type\': \'Éphémère\', \'flavor\': "« Vous n\'aviez pas fini votre rituel, ma chère ? Comme c\'est malpoli de ma part. Pour me faire pardonner, je vous enverrai une invitation à mon mariage. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535840&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'aabebd63-eaba-4fbf-909d-daac0d09d9e4\', \'multiverseId\': 535840}, \'multiverseid\': 535840}, {\'name\': \'Agguato di Mezzanotte di Olivia\', \'text\': \'Una creatura bersaglio prende -2/-2 fino alla fine del turno. Se è notte, quella creatura prende invece -13/-13 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Avevi quasi finito il rituale, vero cara? Molto scortese da parte mia. Per farmi perdonare, ti manderò un invito al mio matrimonio."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536156&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cc7ecb0e-1da5-44ed-bb4f-3f03a6b8f370\', \'multiverseId\': 536156}, \'multiverseid\': 536156}, {\'name\': \'オリヴィアの真夜中の待ち伏せ\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは－２/－２の修整を受ける。夜であるなら、代わりに、ターン終了時まで、そのクリーチャーは－13/－13の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'「あと少しで儀式が完成するところだったのね、あなた。失礼な事をしたわ。お詫びに、私の結婚式へ招待するわ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536472&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f5f8e138-251e-4850-a598-80de1fadd30a\', \'multiverseId\': 536472}, \'multiverseid\': 536472}, {\'name\': \'올리비아의 한밤중 습격\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 -2/-2를 받는다. 밤이라면, 그 생물은 대신 턴종료까지 -13/-13을 받는다.\', \'type\': \'순간마법\', \'flavor\': \'"의식이 거의 끝나가고 있던 것 아니니, 아가야? 내가 무례했구나. 미안하니까, 내 결혼식에 참석할 수 있게 초대장을 보내 주겠어."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536788&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0ca27035-808c-4413-8905-9a88fef533b2\', \'multiverseId\': 536788}, \'multiverseid\': 536788}, {\'name\': \'Emboscada à Meia-noite de Olívia\', \'text\': \'A criatura alvo recebe -2/-2 até o final do turno. Se for noite, em vez disso, aquela criatura recebe -13/-13 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"E você estava quase acabando aquele ritual, não é, querida? Isso foi tão rude da minha parte... Vou compensar você com um convite para meu casamento."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537104&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ea5e94e7-09ae-43f2-8a0f-71b6cf6d8d95\', \'multiverseId\': 537104}, \'multiverseid\': 537104}, {\'name\': \'Полуночная Засада Оливии\', \'text\': \'Целевое существо получает -2/-2 до конца хода. Если стоит ночь, вместо этого то существо получает -13/-13 до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«А ты уже почти закончила тот ритуал, да, дорогая? Как невежливо с моей стороны... Знаешь, чтобы загладить вину, я пришлю тебе приглашение на мою свадьбу».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537420&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7a8be627-af18-4c23-87d8-083b784cc398\', \'multiverseId\': 537420}, \'multiverseid\': 537420}, {\'name\': \'奥莉薇亚午夜突袭\', \'text\': \'目标生物得-2/-2直到回合结束。如果当前是黑夜，则改为该生物得-13/-13直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'「亲爱的，你是不是差点就完成仪式了？瞧瞧我真是粗鲁。你们会收到我的婚礼邀请函，算是我的一点心意。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537736&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7246ef26-613c-4ad5-bbb1-d394d3770681\', \'multiverseId\': 537736}, \'multiverseid\': 537736}, {\'name\': \'奧莉薇亞午夜突襲\', \'text\': \'目標生物得-2/-2直到回合結束。如果當前是黑夜，則改為該生物得-13/-13直到回合結束。\', \'type\': \'瞬間\', \'flavor\': \'「親愛的，妳是不是差點就完成儀式了？瞧瞧我真是粗魯。妳們會收到我的婚禮邀請函，算是我的一點心意。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538052&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'21f90689-02c6-47a2-bdfe-7ceff90e3a80\', \'multiverseId\': 538052}, \'multiverseid\': 538052}]', '[{\'name\': \'Ominöses Spähnest\', \'text\': \'Wenn das Ominöse Spähnest ins Spiel kommt und immer wenn du einen Zauberspruch aus deinem Friedhof wirkst, erzeuge einen 1/1 blauen Vogel-Kreaturenspielstein mit Flugfähigkeit und „Diese Kreatur kann nur fliegende Kreaturen blocken."\', \'type\': \'Verzauberung\', \'flavor\': \'„Ein Rabe ist ein schlechtes Omen. Zwei sind ein Fluch. Ich weiß nicht, was das hier ist, aber es kann nichts Gutes sein."\\n—Verna, Priesterin von Sigarda\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535145&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1eae1599-021e-467a-902b-b5a5aae28cbf\', \'multiverseId\': 535145}, \'multiverseid\': 535145}, {\'name\': \'Nido siniestro\', \'text\': \'Cuando el Nido siniestro entre al campo de batalla o siempre que lances un hechizo desde tu cementerio, crea una ficha de criatura Ave azul 1/1 con la habilidad de volar y "Esta criatura solo puede bloquear a criaturas con la habilidad de volar".\', \'type\': \'Encantamiento\', \'flavor\': \'"Un cuervo es un mal presagio; dos, una maldición. Y esto pues no sé qué es, pero seguro que nada bueno".\\n—Verna, sacerdotisa de Sigarda\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535461&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c6d1a512-829b-4c43-abf6-6d93bfadea98\', \'multiverseId\': 535461}, \'multiverseid\': 535461}, {\'name\': \'Perchoir comminatoire\', \'text\': \'Quand le Perchoir comminatoire arrive sur le champ de bataille ou à chaque fois que vous lancez un sort depuis votre cimetière, créez un jeton de créature 1/1 bleue Oiseau avec le vol et « Cette créature ne peut bloquer que les créatures avec le vol. »\', \'type\': \'Enchantement\', \'flavor\': "« Un corbeau est un mauvais présage. Deux sont une malédiction. J\'ignore ce que ceci signifie, mais ça ne me dit rien qui vaille. »\\n—Verna, prêtresse de Sigarda", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535777&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'79ed6830-f69d-4d33-9b01-0b8fc75ba449\', \'multiverseId\': 535777}, \'multiverseid\': 535777}, {\'name\': \'Posatoio Infausto\', \'text\': \'Quando il Posatoio Infausto entra nel campo di battaglia o ogniqualvolta lanci una magia dal tuo cimitero, crea una pedina creatura Uccello 1/1 blu con volare e "Questa creatura può bloccare solo creature con volare".\', \'type\': \'Incantesimo\', \'flavor\': \'"Un corvo è un cattivo auspicio. Due sono una maledizione. Non so cosa significhi questo, ma non può essere niente di buono."\\n—Verna, sacerdotessa di Sigarda\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536093&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4f13c6d4-b994-4c13-b7b5-34b9f3fe9185\', \'multiverseId\': 536093}, \'multiverseid\': 536093}, {\'name\': \'不吉な休息地\', \'text\': \'不吉な休息地が戦場に出たときや、あなたがあなたの墓地から呪文を唱えるたび、飛行と「このクリーチャーでは飛行を持つクリーチャーしかブロックできない。」を持つ青の１/１の鳥・クリーチャー・トークン１体を生成する。\', \'type\': \'エンチャント\', \'flavor\': \'「一羽の鴉は縁起が悪い。二羽は呪いよ。これは何だかわからないけど、きっとよくないはずだわ。」\\n――シガルダの僧侶、ヴェルナ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536409&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c2e4321f-2ddb-433f-be9c-fcb55a4819c6\', \'multiverseId\': 536409}, \'multiverseid\': 536409}, {\'name\': \'불길한 횃대\', \'text\': \'불길한 횃대가 전장에 들어오거나 당신이 당신의 무덤에서 주문을 발동할 때마다, 비행 및 "이 생물은 비행을 가진 생물만을 방어할 수 있다."를 가진 1/1 청색 조류 생물 토큰 한 개를 만든다.\', \'type\': \'부여마법\', \'flavor\': \'"까마귀 한 마리는 불길한 징조야. 두 마리는 저주고. 이게 무엇인지는 모르겠지만, 좋은 게 아닌 건 분명해."\\n—시가르다의 사제, 베르나\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536725&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'af9f3238-0c7b-4eb3-836b-b297e5562d40\', \'multiverseId\': 536725}, \'multiverseid\': 536725}, {\'name\': \'Poleiro Agourento\', \'text\': \'Quando Poleiro Agourento entrar no campo de batalha ou toda vez que você conjurar uma mágica de seu cemitério, crie uma ficha de criatura Ave azul 1/1 com voar e "Esta criatura só pode bloquear criaturas com voar".\', \'type\': \'Encantamento\', \'flavor\': \'"Um corvo é mau agouro. Dois é uma maldição. Isso aí eu não sei o que é, mas deve ser bem ruim."\\n— Verna, sacerdotisa de Sigarda\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537041&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e0d6aba4-bf0d-44b0-b569-d3e96501fdbc\', \'multiverseId\': 537041}, \'multiverseid\': 537041}, {\'name\': \'Зловещий Насест\', \'text\': \'Когда Зловещий Насест выходит на поле битвы или каждый раз, когда вы разыгрываете заклинание из вашего кладбища, создайте одну фишку существа 1/1 синяя Птица с Полетом и способностью «Это существо может блокировать только существа с Полетом».\', \'type\': \'Чары\', \'flavor\': \'«Один ворон — плохое предзнаменование. Два — проклятие. Не знаю, что сулит нам это, но точно ничего хорошего».\\n— Верна, священница Сигарды\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537357&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a41a7c78-2980-4cee-9de4-1bc3592edc58\', \'multiverseId\': 537357}, \'multiverseid\': 537357}, {\'name\': \'恶兆宿巢\', \'text\': \'当恶兆宿巢进战场或每当你从你坟墓场中施放咒语时，派出一个1/1蓝色的鸟衍生生物，且具有飞行与「此生物只能阻挡具飞行异能的生物。」\', \'type\': \'结界\', \'flavor\': \'「一只乌鸦是凶兆，两只乌鸦是诅咒。我不知道这算什么，但反正不是好事。」\\n～席嘉妲僧侣文娜\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537673&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a69d1b3b-5f4f-485e-bb38-42ae6e4f595b\', \'multiverseId\': 537673}, \'multiverseid\': 537673}, {\'name\': \'惡兆宿巢\', \'text\': \'當惡兆宿巢進戰場或每當你從你墳墓場中施放咒語時，派出一個1/1藍色的鳥衍生生物，且具有飛行與「此生物只能阻擋具飛行異能的生物。」\', \'type\': \'結界\', \'flavor\': \'「一隻烏鴉是凶兆，兩隻烏鴉是詛咒。我不知道這算什麼，但反正不是好事。」\\n～席嘉妲僧侶文娜\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537989&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'474d1af9-c1a2-482a-82c1-0b8f899de3b7\', \'multiverseId\': 537989}, \'multiverseid\': 537989}]', '[{\'name\': \'Organsammler\', \'text\': \'Wenn der Organsammler ins Spiel kommt, schaue dir die obersten drei Karten deiner Bibliothek an, nimm eine davon auf deine Hand und lege den Rest auf deinen Friedhof.\', \'type\': \'Kreatur — Zombie\', \'flavor\': \'Die Leichenflickerin ist schon vor Jahren gestorben, aber ihr pflichtbewusster Assistent sorgt im Labor immer noch für ausreichende Lagerbestände.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535146&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'909042c3-2f4c-4a4f-b1f0-7cda3b40018c\', \'multiverseId\': 535146}, \'multiverseid\': 535146}, {\'name\': \'Coleccionista de órganos\', \'text\': \'Cuando el Coleccionista de órganos entre al campo de batalla, mira las tres primeras cartas de tu biblioteca, luego pon una de ellas en tu mano y el resto en tu cementerio.\', \'type\': \'Criatura — Zombie\', \'flavor\': \'La suturadora murió hace años, pero su solícito asistente se sigue ocupando de que el laboratorio esté bien provisto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535462&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'07a2b768-7497-4b0c-8bf3-5c464b81c16b\', \'multiverseId\': 535462}, \'multiverseid\': 535462}, {\'name\': "Collectionneur d\'organes", \'text\': "Quand le Collectionneur d\'organes arrive sur le champ de bataille, regardez les trois cartes du dessus de votre bibliothèque, puis mettez l\'une d\'entre elles dans votre main et le reste dans votre cimetière.", \'type\': \'Créature : zombie\', \'flavor\': \'La raccommodeuse est morte il y a des années, mais son assistant dévoué continue à approvisionner le laboratoire.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535778&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5acdc227-78cd-4e55-829d-afed5c908d07\', \'multiverseId\': 535778}, \'multiverseid\': 535778}, {\'name\': \'Accaparratore di Organi\', \'text\': "Quando l\'Accaparratore di Organi entra nel campo di battaglia, guarda le prime tre carte del tuo grimorio, poi aggiungine una alla tua mano e metti le altre nel tuo cimitero.", \'type\': \'Creatura — Zombie\', \'flavor\': \'La cucitrice morì anni fa, ma il suo ligio assistente continua a tenere il laboratorio ben rifornito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536094&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'12e1a445-726e-42fb-8bbb-901a74da4d80\', \'multiverseId\': 536094}, \'multiverseid\': 536094}, {\'name\': \'臓器の貯め込み屋\', \'text\': \'臓器の貯め込み屋が戦場に出たとき、あなたのライブラリーの一番上にあるカード３枚を見て、そのうち１枚をあなたの手札に、残りをあなたの墓地に置く。\', \'type\': \'クリーチャー — ゾンビ\', \'flavor\': \'縫い師は数年前に死亡したが、彼女の従順な助手は未だに研究所の備品を補充し続けている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536410&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'20279a55-bd2c-404a-876a-74989824abed\', \'multiverseId\': 536410}, \'multiverseid\': 536410}, {\'name\': \'장기 비축꾼\', \'text\': \'장기 비축꾼이 전장에 들어올 때, 당신의 서고 맨 위 카드 세 장을 본 후, 그중 한 장을 당신의 손에 넣고 나머지 카드는 당신의 무덤에 넣는다.\', \'type\': \'생물 — 좀비\', \'flavor\': \'봉합술사는 수 년 전에 죽었지만, 그녀의 충실한 조수는 여전히 연구실의 재료들이 잘 채워져 있게 관리한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536726&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c1e96c52-a979-4e8d-94d7-c5d0e22fdc13\', \'multiverseId\': 536726}, \'multiverseid\': 536726}, {\'name\': \'Colecionador de Órgãos\', \'text\': \'Quando Colecionador de Órgãos entrar no campo de batalha, olhe os três cards do topo de seu grimório e depois coloque um deles em sua mão e o restante em seu cemitério.\', \'type\': \'Criatura — Zumbi\', \'flavor\': \'A suturadora morreu há anos, mas seu dedicado assistente ainda mantém o laboratório bem abastecido.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537042&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d60e93ea-f960-4eb6-a565-96c4194f8187\', \'multiverseId\': 537042}, \'multiverseid\': 537042}, {\'name\': \'Стяжатель Органов\', \'text\': \'Когда Стяжатель Органов выходит на поле битвы, посмотрите три верхние карты вашей библиотеки, затем положите одну из них в вашу руку, а остальные — на ваше кладбище.\', \'type\': \'Существо — Зомби\', \'flavor\': \'Сшивательница умерла много лет назад, но ее послушный помощник до сих пор усердно снабжает лабораторию.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537358&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d3259dbb-f1d6-4cae-9f8c-387e157b1c28\', \'multiverseId\': 537358}, \'multiverseid\': 537358}, {\'name\': \'器官匿集怪\', \'text\': \'当器官匿集怪进战场时，检视你牌库顶的三张牌，然后将其中一张置于你手上，其余的牌则置入你的坟墓场。\', \'type\': \'生物 ～灵俑\', \'flavor\': \'虽然拼接师许多年前就已逝去，但她的忠诚助手仍尽心确保实验室材料充足。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537674&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'51ff5e43-5220-4d0b-80d9-a0adf7296033\', \'multiverseId\': 537674}, \'multiverseid\': 537674}, {\'name\': \'器官匿集怪\', \'text\': \'當器官匿集怪進戰場時，檢視你牌庫頂的三張牌，然後將其中一張置於你手上，其餘的牌則置入你的墳墓場。\', \'type\': \'生物 ～殭屍\', \'flavor\': \'雖然拼接師許多年前就已逝去，但她的忠誠助手仍盡心確保實驗室材料充足。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537990&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'40b6ce4b-9ca5-46d6-a5ed-67531a20186f\', \'multiverseId\': 537990}, \'multiverseid\': 537990}]', '[{\'name\': \'Pakt des Blutes\', \'text\': \'Ein Spieler deiner Wahl zieht zwei Karten und verliert 2 Lebenspunkte.\', \'type\': \'Spontanzauber\', \'flavor\': \'Griselbrands Niederlage bedeutete nicht das Ende des Skirsdag-Kults. Die Kultisten wandten sich einfach dem nächsten Dämon zu, der aus den Schatten auftauchte und ihnen Macht versprach.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535172&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a815033f-35ec-4b2e-8ffc-82d2cebac4bc\', \'multiverseId\': 535172}, \'multiverseid\': 535172}, {\'name\': \'Pacto sangriento\', \'text\': \'El jugador objetivo roba dos cartas y pierde 2 vidas.\', \'type\': \'Instantáneo\', \'flavor\': \'La derrota de Griselbrand no supuso el fin de la secta Skirsdag. Tan solo veneraron al siguiente demonio que emergiese de entre las sombras y que les ofreciese poder.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535488&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d8a50865-8403-4c0c-8f0e-abc664cc80ad\', \'multiverseId\': 535488}, \'multiverseid\': 535488}, {\'name\': \'Pacte sanguinolent\', \'text\': \'Un joueur ciblé pioche deux cartes et perd 2 points de vie.\', \'type\': \'Éphémère\', \'flavor\': "La défaite de Griselbrand ne marqua pas la fin des cultistes de Skirsdag. Ils n\'eurent qu\'à vénérer le prochain démon à émerger des ombres avec des promesses de pouvoir.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535804&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dc35a921-fa48-4e3e-8b36-a3690aced1f0\', \'multiverseId\': 535804}, \'multiverseid\': 535804}, {\'name\': \'Patto di Sangue\', \'text\': \'Un giocatore bersaglio pesca due carte e perde 2 punti vita.\', \'type\': \'Istantaneo\', \'flavor\': \'La sconfitta di Griselbrand non è stata la fine per il culto Skirsdag. Hanno semplicemente rivolto la loro adorazione al primo demone che è emerso dalle ombre portando offerte di potere.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536120&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2212958d-ffa4-4d02-bf4f-69b120ae087a\', \'multiverseId\': 536120}, \'multiverseid\': 536120}, {\'name\': \'血の契約\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーはカード２枚を引き２点のライフを失う。\', \'type\': \'インスタント\', \'flavor\': \'グリゼルブランドの敗北は、スカースダグ教団の終わりを意味するわけではなかった。彼らは暗黒から出現して力を授けてくれるよう次なる悪魔に信仰を向けたのであった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536436&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f6b21ca0-4049-49d2-9749-667cf4e138ec\', \'multiverseId\': 536436}, \'multiverseid\': 536436}, {\'name\': \'피의 서약\', \'text\': \'플레이어를 목표로 정한다. 그 플레이어는 카드 두 장을 뽑고 생명 2점을 잃는다.\', \'type\': \'순간마법\', \'flavor\': \'그리즐브랜드의 패배는 스커스대그 광신단의 종말로 이어지지 않았다. 그들은 단순히 그들에게 힘을 제공해 주겠다며 그림자 속에서 나타날 다음 악마로 예배의 대상을 바꿨을 뿐이었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536752&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'71e5fc31-96d0-4cbb-a449-13871fc6ff33\', \'multiverseId\': 536752}, \'multiverseid\': 536752}, {\'name\': \'Pacto Sanguíneo\', \'text\': \'O jogador alvo compra dois cards e perde 2 pontos de vida.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'A derrota de Griselbrand não marcou o fim do culto de Skirsdag. Seus adoradores simplesmente passaram a adorar o próximo demônio a emergir das sombras oferecendo poder.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537068&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5a94004a-913b-4fea-be0b-c2191c029b4d\', \'multiverseId\': 537068}, \'multiverseid\': 537068}, {\'name\': \'Кровавый Сговор\', \'text\': \'Целевой игрок берет две карты и теряет 2 жизни.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Поражение Гризельбранда не стало концом для культа Скирдага. Они просто стали поклоняться очередному демону, который явился из теней с предложением могущества.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537384&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'06295507-80cb-4a37-a3b8-e0da22ef3632\', \'multiverseId\': 537384}, \'multiverseid\': 537384}, {\'name\': \'鲜血契约\', \'text\': \'目标牌手抓两张牌并失去2点生命。\', \'type\': \'瞬间\', \'flavor\': \'棘泽边落败并非史革达教派的终点。他们就只是转而崇拜黯影中崛起的另一位恶魔，同样祈求对方赐予力量。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537700&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'142aa707-e25c-4170-881b-6db226a5c549\', \'multiverseId\': 537700}, \'multiverseid\': 537700}, {\'name\': \'鮮血契約\', \'text\': \'目標玩家抽兩張牌並失去2點生命。\', \'type\': \'瞬間\', \'flavor\': \'棘澤邊落敗並非史革達教派的終點。他們就只是轉而崇拜黯影中崛起的另一位惡魔，同樣祈求對方賜予力量。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538016&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'60c0d3c5-8063-4b9e-bd4c-dadac65f50c6\', \'multiverseId\': 538016}, \'multiverseid\': 538016}]', '[{\'name\': \'Pfad zum Festival\', \'text\': \'Durchsuche deine Bibliothek nach einer Standardland-Karte, bringe sie getappt ins Spiel und mische danach. Falls dann drei oder mehr Standardlandtypen unter den Ländern sind, die du kontrollierst, wende Hellsicht 1 an. (Schaue dir die oberste Karte deiner Bibliothek an. Du kannst sie unter deine Bibliothek legen.)\\nRückblende {4}{G} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten wirken. Schicke sie danach ins Exil.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535296&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'64a5439b-f067-44a2-9ff3-de8326aeb50c\', \'multiverseId\': 535296}, \'multiverseid\': 535296}, {\'name\': \'Camino hacia el festival\', \'text\': \'Busca en tu biblioteca una carta de tierra básica, pon esa carta en el campo de batalla girada y luego baraja. Luego, si hay tres o más tipos de tierra básica entre las tierras que controlas, adivina 1. (Mira la primera carta de tu biblioteca. Puedes poner esa carta en el fondo de tu biblioteca.)\\nRetrospectiva {4}{G}. (Puedes lanzar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego exíliala.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535612&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'68f438d4-d08b-472a-8948-15d146534e30\', \'multiverseId\': 535612}, \'multiverseid\': 535612}, {\'name\': \'Chemin du Festival\', \'text\': "Cherchez dans votre bibliothèque une carte de terrain de base, mettez-la sur le champ de bataille engagée, puis mélangez. Puis s\'il y a au moins trois types de terrain de base parmi les terrains que vous contrôlez, regard 1. (Regardez la carte du dessus de votre bibliothèque. Vous pouvez la mettre au-dessous de votre bibliothèque.)\\nFlashback {4}{G} (Vous pouvez lancer cette carte depuis votre cimetière pour son coût de flashback. Exilez-la ensuite.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535928&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'75f91f69-b903-4665-b73a-3f098578f3a4\', \'multiverseId\': 535928}, \'multiverseid\': 535928}, {\'name\': \'Sentiero per il Festival\', \'text\': \'Passa in rassegna il tuo grimorio per una carta terra base, mettila sul campo di battaglia TAPpata, poi rimescola. Poi, se ci sono tre o più tipi di terra base tra le terre che controlli, profetizza 1. (Guarda la prima carta del tuo grimorio. Puoi mettere quella carta in fondo al tuo grimorio.)\\nFlashback {4}{G} (Puoi lanciare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi esiliala.)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536244&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'907b2e6e-6fae-4f79-96f8-18546e73d4a4\', \'multiverseId\': 536244}, \'multiverseid\': 536244}, {\'name\': \'収穫祭への道\', \'text\': \'あなたのライブラリーから基本土地・カード１枚を探し、タップ状態で戦場に出す。その後、ライブラリーを切り直す。その後、あなたがコントロールしている土地の中の基本土地タイプの種類数が３以上であるなら、占術１を行う。（あなたのライブラリーの一番上にあるカード１枚を見る。あなたはそのカードをあなたのライブラリーの一番下に置いてもよい。）\\nフラッシュバック{4}{G}（あなたはあなたの墓地にあるこのカードをフラッシュバック・コストで唱えてもよい。その後、これを追放する。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536560&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2ac5fe27-8029-41f3-b782-9d0f6083b0b4\', \'multiverseId\': 536560}, \'multiverseid\': 536560}, {\'name\': \'축제로 향하는 길\', \'text\': \'당신의 서고에서 기본 대지 카드를 찾아, 그 카드를 전장에 탭된 채로 놓은 후, 서고를 섞는다. 그 후 당신이 조종하는 대지들이 가진 기본 대지 유형이 총 세 개 이상이라면, 점술 1을 한다. (당신의 서고 맨 위 카드 한 장을 본다. 당신은 그 카드를 당신의 서고 맨 밑에 놓을 수 있다.)\\n회상 {4}{G} (당신은 이 카드의 회상 비용을 지불해 이 카드를 당신의 무덤에서 발동할 수 있다. 그 후 이 카드를 추방한다.)\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536876&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'bd222ca7-e4cd-4e7c-a921-d66a39a43cbe\', \'multiverseId\': 536876}, \'multiverseid\': 536876}, {\'name\': \'Caminho do Festival\', \'text\': \'Procure um card de terreno básico em seu grimório, coloque aquele card no campo de batalha virado e depois embaralhe. Depois, se houver três ou mais tipos de terreno básico entre os tipos de terreno que você controla, use vidência 1. (Olhe o card do topo de seu grimório. Você pode colocar aquele card no fundo de seu grimório.)\\nRecapitular {4}{G} (Você pode conjurar este card de seu cemitério pagando seu custo de recapitular. Depois, exile-o.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537192&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'364856ae-c35c-4c7f-a306-1d999539f7a2\', \'multiverseId\': 537192}, \'multiverseid\': 537192}, {\'name\': \'Путь на Фестиваль\', \'text\': \'Найдите в вашей библиотеке карту базовой земли, положите ту карту на поле битвы повернутой, затем перетасуйте библиотеку. Затем, если под вашим контролем есть не менее трех типов базовых земель, предскажите 1. (Посмотрите верхнюю карту вашей библиотеки. Вы можете положить ту карту в низ вашей библиотеки.)\\nВоспоминание {4}{G} (Вы можете разыграть эту карту из вашего кладбища за ее стоимость Воспоминания. Затем изгоните ее.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537508&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4e4af257-966e-44a4-a676-4b8617ddbf55\', \'multiverseId\': 537508}, \'multiverseid\': 537508}, {\'name\': \'收成节光道\', \'text\': \'从你牌库中搜寻一张基本地牌，将该牌横置放进战场，然后洗牌。然后如果由你操控的地中有三种或更多基本地类别，则占卜1。（检视你牌库顶的牌。你可以将该牌置于你的牌库底。）\\n返照{4}{G}（你可以从你坟墓场中施放此牌，并支付其返照费用，然后将它放逐。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537824&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2a0b2f29-0d47-4225-bd40-eedf0d9e2ce6\', \'multiverseId\': 537824}, \'multiverseid\': 537824}, {\'name\': \'收成節光道\', \'text\': \'從你牌庫中搜尋一張基本地牌，將該牌橫置放進戰場，然後洗牌。然後如果由你操控的地中有三種或更多基本地類別，則占卜1。（檢視你牌庫頂的牌。你可以將該牌置於你的牌庫底。）\\n返照{4}{G}（你可以從你墳墓場中施放此牌，並支付其返照費用，然後將它放逐。）\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538140&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e2c28a21-86ee-43cd-831a-8a8c3c06dc4c\', \'multiverseId\': 538140}, \'multiverseid\': 538140}]', '[{\'name\': \'Phantomkutsche\', \'text\': \'Fliegend\\nWenn die Phantomkutsche ins Spiel kommt, kannst du deine Bibliothek nach einer Karte mit Rückblende oder Aufstören durchsuchen, sie auf deinen Friedhof legen und danach mischen.\', \'type\': \'Kreatur — Geist\', \'flavor\': \'Die Fahrt zum Abgrund ist kostenlos, aber die Rückfahrt wird teuer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535151&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'51d38030-5564-48e1-98ae-3610764c705c\', \'multiverseId\': 535151}, \'multiverseid\': 535151}, {\'name\': \'Carroza fantasmal\', \'text\': \'Vuela.\\nCuando la Carroza fantasmal entre al campo de batalla, puedes buscar en tu biblioteca una carta con las habilidades de retrospectiva o perturbar, ponerla en tu cementerio y luego barajar.\', \'type\': \'Criatura — Espíritu\', \'flavor\': \'No cuesta nada ir hasta el abismo, pero el viaje de vuelta tiene un precio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535467&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'589e5524-033d-46ff-a25a-ae2894d9b8d3\', \'multiverseId\': 535467}, \'multiverseid\': 535467}, {\'name\': \'Carrosse fantomatique\', \'text\': \'Vol\\nQuand le Carrosse fantomatique arrive sur le champ de bataille, vous pouvez chercher dans votre bibliothèque une carte avec le flashback ou la perturbation, la mettre dans votre cimetière, puis mélanger.\', \'type\': \'Créature : esprit\', \'flavor\': "Se rendre à l\'abysse est gratuit, mais en revenir vous coûtera cher.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535783&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1ccdcef2-c86e-46f9-a4a2-7b477b4ac2ca\', \'multiverseId\': 535783}, \'multiverseid\': 535783}, {\'name\': \'Carrozza Fantasma\', \'text\': \'Volare\\nQuando la Carrozza Fantasma entra nel campo di battaglia, puoi passare in rassegna il tuo grimorio per una carta con flashback o disturbare, metterla nel tuo cimitero, poi rimescolare.\', \'type\': \'Creatura — Spirito\', \'flavor\': "L\'ingresso nell\'abisso è gratis, ma il viaggio di ritorno ti costerà caro.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536099&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'187a825c-034c-4fdb-8904-d06d392b7488\', \'multiverseId\': 536099}, \'multiverseid\': 536099}, {\'name\': \'幻影の馬車\', \'text\': \'飛行\\n幻影の馬車が戦場に出たとき、あなたは「あなたのライブラリーからフラッシュバックか降霊を持つカード１枚を探し、あなたの墓地に置く。その後、ライブラリーを切り直す。」を選んでもよい。\', \'type\': \'クリーチャー — スピリット\', \'flavor\': \'深淵への道のりは無料だが、戻る旅は有料だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536415&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'481964b3-972e-41b0-8223-ebdbd8df5cc0\', \'multiverseId\': 536415}, \'multiverseid\': 536415}, {\'name\': \'혼령 마차\', \'text\': \'비행\\n혼령 마차가 전장에 들어올 때, 당신은 당신의 서고에서 회상 또는 소란을 가진 카드를 찾아, 당신의 무덤에 넣을 수 있다. 그렇게 한다면, 당신의 서고를 섞는다.\', \'type\': \'생물 — 신령\', \'flavor\': \'심연으로 들어갈 때는 통행료가 무료지만, 돌아오려면 대가를 지불해야만 할 것이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536731&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'51f61b0d-c8a7-41a6-be87-4911db322ec9\', \'multiverseId\': 536731}, \'multiverseid\': 536731}, {\'name\': \'Carruagem Fantasma\', \'text\': \'Voar\\nQuando Carruagem Fantasma entra no campo de batalha, você pode procurar em seu grimório um card com recapitular ou perturbar, colocá-lo em seu cemitério e depois embaralhar.\', \'type\': \'Criatura — Espírito\', \'flavor\': \'A passagem de ida para o abismo é grátis, mas a de volta vai lhe custar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537047&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'650ca645-ff7e-4499-96a8-0cd496e4e721\', \'multiverseId\': 537047}, \'multiverseid\': 537047}, {\'name\': \'Призрачный Экипаж\', \'text\': \'Полет\\nКогда Призрачный Экипаж выходит на поле битвы, вы можете найти в вашей библиотеке карту с Воспоминанием или Разупокоением, положить ее на ваше кладбище, затем перетасовать библиотеку.\', \'type\': \'Существо — Дух\', \'flavor\': \'Путь в бездну бесплатный, но за обратную поездку придется раскошелиться.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537363&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6155093b-cda6-4758-b471-cb631a184f73\', \'multiverseId\': 537363}, \'multiverseid\': 537363}, {\'name\': \'幽魅马车\', \'text\': \'飞行\\n当幽魅马车进战场时，你可以从你牌库中搜寻一张具返照或惊扰异能的牌，将它置入你的坟墓场，然后洗牌。\', \'type\': \'生物 ～精怪\', \'flavor\': \'去往深渊票价免费，但回来这程得搭上你的命。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537679&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e6a1423c-11b6-4ae7-8983-bce8d51e8b2c\', \'multiverseId\': 537679}, \'multiverseid\': 537679}, {\'name\': \'幽魅馬車\', \'text\': \'飛行\\n當幽魅馬車進戰場時，你可以從你牌庫中搜尋一張具返照或驚擾異能的牌，將它置入你的墳墓場，然後洗牌。\', \'type\': \'生物 ～精靈\', \'flavor\': \'去往深淵票價免費，但回來這程得搭上你的命。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537995&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ff6836ce-62ac-4146-aee3-f59d64e1db2e\', \'multiverseId\': 537995}, \'multiverseid\': 537995}]', '[{\'name\': \'Prominente Vampirin\', \'text\': \'Bedrohlich (Diese Kreatur kann nicht geblockt werden, außer von zwei oder mehr Kreaturen.)\\nWenn die Prominente Vampirin ins Spiel kommt und falls ein Gegner in diesem Zug Lebenspunkte verloren hat, lege eine +1/+1-Marke auf jeden anderen Vampir, den du kontrollierst.\\nSolange ein Gegner in diesem Zug Lebenspunkte verloren hat, kommt jeder andere Vampir, den du kontrollierst, mit einer zusätzlichen +1/+1-Marke ins Spiel.\', \'type\': \'Kreatur — Vampir, Adliger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535362&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'74ebc9c7-85a8-4217-acbd-9532e4d307cc\', \'multiverseId\': 535362}, \'multiverseid\': 535362}, {\'name\': \'Vampira de la alta sociedad\', \'text\': \'Amenaza. (Esta criatura no puede ser bloqueada excepto por dos o más criaturas.)\\nCuando la Vampira de la alta sociedad entre al campo de batalla, si un oponente perdió vidas este turno, pon un contador +1/+1 sobre cada otro Vampiro que controlas.\\nMientras un oponente haya perdido vidas este turno, cada otro Vampiro que controlas entra al campo de batalla con un contador +1/+1 adicional sobre él.\', \'type\': \'Criatura — Noble vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535678&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'267a5e20-7fa6-49a7-b681-2dde0d86ad0a\', \'multiverseId\': 535678}, \'multiverseid\': 535678}, {\'name\': \'Vampire mondaine\', \'text\': "Menace (Cette créature ne peut pas être bloquée excepté par deux créatures ou plus.)\\nQuand la Vampire mondaine arrive sur le champ de bataille, si un adversaire a perdu des points de vie ce tour-ci, mettez un marqueur +1/+1 sur chaque autre vampire que vous contrôlez.\\nTant qu\'un adversaire a perdu des points de vie ce tour-ci, chaque autre vampire que vous contrôlez arrive sur le champ de bataille avec un marqueur +1/+1 supplémentaire sur lui.", \'type\': \'Créature : vampire et noble\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535994&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dbcc6108-3dfa-460b-b7f5-2863dbad5644\', \'multiverseId\': 535994}, \'multiverseid\': 535994}, {\'name\': \'Vampira Mondana\', \'text\': \'Minacciare (Questa creatura non può essere bloccata tranne che da due o più creature.)\\nQuando la Vampira Mondana entra nel campo di battaglia, se un avversario ha perso punti vita in questo turno, metti un segnalino +1/+1 su ogni altro Vampiro che controlli.\\nFintanto che un avversario ha perso punti vita in questo turno, ogni altro Vampiro che controlli entra nel campo di battaglia con un segnalino +1/+1 addizionale.\', \'type\': \'Creatura — Nobile Vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536310&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7dddfe7d-ab56-429b-af65-4fa0cffcac9e\', \'multiverseId\': 536310}, \'multiverseid\': 536310}, {\'name\': \'吸血鬼の社交家\', \'text\': \'威迫（このクリーチャーは２体以上のクリーチャーによってしかブロックされない。）\\n吸血鬼の社交家が戦場に出たとき、このターンに対戦相手がライフを失っていた場合、あなたがコントロールしていてこれでない各吸血鬼の上にそれぞれ＋１/＋１カウンター１個を置く。\\nこのターンに対戦相手がライフを失っているかぎり、あなたがコントロールしていてこれでない各吸血鬼はそれぞれ追加で＋１/＋１カウンター１個が置かれた状態で戦場に出る。\', \'type\': \'クリーチャー — 吸血鬼・貴族\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536626&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'13f72990-c07e-4587-aed6-6f3d7a5e917d\', \'multiverseId\': 536626}, \'multiverseid\': 536626}, {\'name\': \'사교계 명사 흡혈귀\', \'text\': \'호전적 (이 생물은 두 개 이상의 생물에만 방어될 수 있다.)\\n사교계 명사 흡혈귀가 전장에 들어올 때, 이 턴에 생명점을 잃은 상대가 있다면, 당신이 조종하는 다른 각 흡혈귀에 +1/+1 카운터를 한 개씩 올려놓는다.\\n이 턴에 생명점을 잃은 상대가 있는 한, 당신이 조종하는 다른 각 흡혈귀는 +1/+1 카운터 한 개를 추가로 가지고 전장에 들어온다.\', \'type\': \'생물 — 흡혈귀 귀족\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536942&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'647ef781-73bb-49ca-b836-b323f5998b59\', \'multiverseId\': 536942}, \'multiverseid\': 536942}, {\'name\': \'Socialite Vampira\', \'text\': \'Ameaçar (Esta criatura só pode ser bloqueada por duas ou mais criaturas.)\\nQuando Socialite Vampira entrar no campo de batalha, se um oponente tiver perdido pontos de vida neste turno, coloque um marcador +1/+1 em cada outro Vampiro que você controla.\\nContanto que um oponente tenha perdido pontos de vida neste turno, cada outro Vampiro que você controla entra no campo de batalha com um marcador +1/+1 adicional.\', \'type\': \'Criatura — Vampiro Nobre\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537258&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d3b555c6-d5be-438e-9db7-b05b7216427f\', \'multiverseId\': 537258}, \'multiverseid\': 537258}, {\'name\': \'Вампирша, Светская Львица\', \'text\': \'Угроза (Это существо не может быть заблокировано менее чем двумя существами.)\\nКогда Вампирша, Светская Львица выходит на поле битвы, если оппонент терял жизнь в этом ходу, положите один жетон +1/+1 на каждого другого Вампира под вашим контролем.\\nПри условии, что оппонент терял жизнь в этом ходу, каждый другой Вампир под вашим контролем выходит на поле битвы с одним дополнительным жетоном +1/+1 на нем.\', \'type\': \'Существо — Вампир Аристократ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537574&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'76fe228b-0c06-41fe-94b8-5235b76138c3\', \'multiverseId\': 537574}, \'multiverseid\': 537574}, {\'name\': \'名流吸血鬼\', \'text\': \'威慑（此生物只能被两个或更多生物阻挡。）\\n当名流吸血鬼进战场时，若有对手本回合中失去过生命，则在每个由你操控的其他吸血鬼上各放置一个+1/+1指示物。\\n只要本回合中有对手失去过生命，每个由你操控的其他吸血鬼进战场时上面便额外有一个+1/+1指示物。\', \'type\': \'生物 ～吸血鬼／贵族\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537890&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5166dc85-40c9-4a25-a123-8fdc5df08c95\', \'multiverseId\': 537890}, \'multiverseid\': 537890}, {\'name\': \'名流吸血鬼\', \'text\': \'威懾（此生物只能被兩個或更多生物阻擋。）\\n當名流吸血鬼進戰場時，若有對手本回合中失去過生命，則在每個由你操控的其他吸血鬼上各放置一個+1/+1指示物。\\n只要本回合中有對手失去過生命，每個由你操控的其他吸血鬼進戰場時上面便額外有一個+1/+1指示物。\', \'type\': \'生物 ～吸血鬼／貴族\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538206&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'434d87ad-8129-4858-b07f-39ba52a5072f\', \'multiverseId\': 538206}, \'multiverseid\': 538206}]', '[{\'name\': \'Prozession der Ghule\', \'text\': \'Immer wenn eine oder mehrere Nichtspielsteinkreaturen sterben, erzeuge einen 2/2 schwarzen Zombie-Kreaturenspielstein mit Verwesung. Diese Fähigkeit wird nur einmal pro Zug ausgelöst. (Eine Kreatur mit Verwesung kann nicht blocken. Wenn sie angreift, opfere sie am Ende des Kampfes.)\', \'type\': \'Verzauberung\', \'flavor\': \'Es war ein Familientreffen zum Sterben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535189&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6412c096-9ddc-44ba-8a2c-158a621fc1fa\', \'multiverseId\': 535189}, \'multiverseid\': 535189}, {\'name\': \'Procesión macabra\', \'text\': \'Siempre que una o más criaturas que no sean fichas mueran, crea una ficha de criatura Zombie negra 2/2 con la habilidad de descomposición. Esta habilidad solo se dispara una vez por turno. (Una criatura con la habilidad de descomposición no puede bloquear. Cuando ataque, sacrifícala al final del combate.)\', \'type\': \'Encantamiento\', \'flavor\': \'Una reunión familiar de mala muerte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535505&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'13f9a545-bc8f-4254-bfd8-95daf9f4e945\', \'multiverseId\': 535505}, \'multiverseid\': 535505}, {\'name\': \'Procession de goules\', \'text\': "À chaque fois qu\'au moins une créature non-jeton meurt, créez un jeton de créature 2/2 noire Zombie avec la décomposition. Cette capacité ne se déclenche qu\'une seule fois par tour. (Une créature avec la décomposition ne peut pas bloquer. Quand elle attaque, sacrifiez-la à la fin du combat.)", \'type\': \'Enchantement\', \'flavor\': "C\'était une réunion de famille à réveiller les morts.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535821&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'34cf5db6-795b-4cb6-99b4-62d310286f38\', \'multiverseId\': 535821}, \'multiverseid\': 535821}, {\'name\': \'Processione Raccapricciante\', \'text\': \'Ogniqualvolta una o più creature non pedina muoiono, crea una pedina creatura Zombie 2/2 nera con decomposto. Questa abilità si innesca solo una volta per turno. (Una creatura con decomposto non può bloccare. Quando attacca, sacrificala alla fine del combattimento.)\', \'type\': \'Incantesimo\', \'flavor\': \'Una riunione di famiglia bella da morire.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536137&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6129e2e6-b6a0-4f48-86ca-e740580db28f\', \'multiverseId\': 536137}, \'multiverseid\': 536137}, {\'name\': \'グールの行進\', \'text\': \'トークンでない１体以上のクリーチャーが死亡するたび、腐乱を持つ黒の２/２のゾンビ・クリーチャー・トークン１体を生成する。この能力は、毎ターン１回しか誘発しない。（腐乱を持つクリーチャーではブロックできない。それが攻撃したとき、戦闘終了時に、それを生け贄に捧げる。）\', \'type\': \'エンチャント\', \'flavor\': \'死んでも参加したい親族会だったのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536453&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e56a0cd1-b889-427d-96e9-aacaa0b2e07c\', \'multiverseId\': 536453}, \'multiverseid\': 536453}, {\'name\': \'악귀들의 행렬\', \'text\': \'토큰이 아닌 생물이 한 개 이상 죽을 때마다, 부패를 가진 2/2 흑색 좀비 생물 토큰 한 개를 만든다. 이 능력은 한 턴에 한 번만 격발한다. (부패를 가진 생물은 방어할 수 없다. 그 생물이 공격할 때, 전투종료에 그 생물을 희생한다.)\', \'type\': \'부여마법\', \'flavor\': \'죽을 만큼 가치가 있는 가족 모임이었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536769&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'dbda171b-1904-41e9-984c-b856b9128f56\', \'multiverseId\': 536769}, \'multiverseid\': 536769}, {\'name\': \'Procissão de Carniçais\', \'text\': \'Toda vez que uma ou mais criaturas não ficha morrerem, crie uma ficha de criatura Zumbi preta 2/2 com decomposto. Esta habilidade é desencadeada apenas uma vez a cada turno. (Uma criatura com decomposto não pode bloquear. Quando ela atacar, sacrifique-a no final do combate.)\', \'type\': \'Encantamento\', \'flavor\': \'Foi uma reunião de família de matar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537085&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'61115cbc-0cb1-4a9a-8290-d50b00479ad3\', \'multiverseId\': 537085}, \'multiverseid\': 537085}, {\'name\': \'Упыриная Процессия\', \'text\': \'Каждый раз, когда одно или несколько не являющихся фишками существ умирают, создайте одну фишку существа 2/2 черный Зомби с Трупной гнилью. Эта способность срабатывает только один раз в каждом ходу. (Существо с Трупной гнилью не может блокировать. Когда оно атакует, пожертвуйте его в конце боя.)\', \'type\': \'Чары\', \'flavor\': \'Ради такого воссоединения семьи и умереть было не жалко.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537401&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5d1fd1c5-f17b-4305-add8-4514186eed90\', \'multiverseId\': 537401}, \'multiverseid\': 537401}, {\'name\': \'食尸鬼行列\', \'text\': \'每当一个或数个非衍生物的生物死去时，派出一个2/2黑色，具败朽异能的灵俑衍生生物。此异能每回合只会触发一次。（具败朽异能的生物不能进行阻挡。当它攻击，在战斗结束时将它牺牲。）\', \'type\': \'结界\', \'flavor\': \'归家团圆，虽死无憾。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537717&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1d45ec40-c3a7-4881-80d8-bb4fa50bd899\', \'multiverseId\': 537717}, \'multiverseid\': 537717}, {\'name\': \'食屍鬼行列\', \'text\': \'每當一個或數個非衍生物的生物死去時，派出一個2/2黑色，具敗朽異能的殭屍衍生生物。此異能每回合只會觸發一次。（具敗朽異能的生物不能進行阻擋。當它攻擊，在戰鬥結束時將它犧牲。）\', \'type\': \'結界\', \'flavor\': \'歸家團圓，雖死無憾。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538033&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'81932834-5f31-44cb-b4d3-b08892a8a1f6\', \'multiverseId\': 538033}, \'multiverseid\': 538033}]', '[{\'name\': \'Quakendes Gegenstück\', \'text\': \'Erzeuge einen Spielstein, der eine Kopie einer Nicht-Frosch-Kreatur deiner Wahl ist, außer dass er ein 1/1 grüner Frosch ist.\\nRückblende {3}{G}{U} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten wirken. Schicke sie danach ins Exil.)\', \'type\': \'Hexerei\', \'flavor\': \'Ein Frosch ist die aufrichtigste Form der Schmeichelei.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535323&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f87a21b9-6722-40f6-8178-fda29e06c5a4\', \'multiverseId\': 535323}, \'multiverseid\': 535323}, {\'name\': \'Homólogo croante\', \'text\': \'Crea una ficha que es una copia de la criatura objetivo que no sea Rana, excepto que es una Rana verde 1/1.\\nRetrospectiva {3}{G}{U}. (Puedes lanzar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego exíliala.)\', \'type\': \'Conjuro\', \'flavor\': \'Las ranas son la forma más sincera de adulación.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535639&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'79d731ee-6dba-4b53-8a3d-afcce920a873\', \'multiverseId\': 535639}, \'multiverseid\': 535639}, {\'name\': \'Homologue croassant\', \'text\': "Créez un jeton qui est une copie d\'une créature non-Grenouille ciblée, excepté que c\'est une grenouille 1/1 verte.\\nFlashback {3}{G}{U} (Vous pouvez lancer cette carte depuis votre cimetière pour son coût de flashback. Exilez-la ensuite.)", \'type\': \'Rituel\', \'flavor\': \'La grenouille est la forme de flatterie la plus sincère.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535955&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e8d6eb5e-8ae7-4135-83c6-c9d80c5bc27d\', \'multiverseId\': 535955}, \'multiverseid\': 535955}, {\'name\': \'Controparte Gracidante\', \'text\': \'Crea una pedina che è una copia di una creatura non Rana bersaglio, tranne che è una Rana 1/1 verde.\\nFlashback {3}{G}{U} (Puoi lanciare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi esiliala.)\', \'type\': \'Stregoneria\', \'flavor\': \'La rana è la più sincera forma di adulazione.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536271&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'55e1ff20-2659-441d-a695-9fc21363e6b1\', \'multiverseId\': 536271}, \'multiverseid\': 536271}, {\'name\': \'カエル声の写し身\', \'text\': \'カエルでないクリーチャー１体を対象とする。緑の１/１のカエルであることを除きそれのコピーであるトークン１体を生成する。\\nフラッシュバック{3}{G}{U}（あなたはあなたの墓地にあるこのカードをフラッシュバック・コストで唱えてもよい。その後、これを追放する。）\', \'type\': \'ソーサリー\', \'flavor\': \'カエルとは最も誠実な追従である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536587&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'05f5abc2-95b0-4e9c-9222-722e284ae152\', \'multiverseId\': 536587}, \'multiverseid\': 536587}, {\'name\': \'개굴거리는 동료\', \'text\': \'개구리가 아닌 생물을 목표로 정한다. 그 생물의 복사본이지만 1/1 녹색 개구리인 토큰 한 개를 만든다.\\n회상 {3}{G}{U} (당신은 이 카드의 회상 비용을 지불해 이 카드를 당신의 무덤에서 발동할 수 있다. 그 후 이 카드를 추방한다.)\', \'type\': \'집중마법\', \'flavor\': \'개구리는 가장 진실한 형태의 찬사이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536903&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6c2e1a36-f03d-4e9b-a6cc-2d8a29016415\', \'multiverseId\': 536903}, \'multiverseid\': 536903}, {\'name\': \'Contraparte Coaxante\', \'text\': \'Crie uma ficha que seja uma cópia da criatura não Sapo alvo, com a exceção de ser um Sapo verde 1/1.\\nRecapitular {3}{G}{U} (Você pode conjurar este card de seu cemitério pagando seu custo de recapitular. Depois, exile-o.)\', \'type\': \'Feitiço\', \'flavor\': \'O sapo é a forma mais sincera de lisonja.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537219&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0b3e7693-070c-4718-aeaa-51b452290eb1\', \'multiverseId\': 537219}, \'multiverseid\': 537219}, {\'name\': \'Квакающий Аналог\', \'text\': \'Создайте одну фишку, являющуюся копией целевого не являющегося Лягушкой существа, но при этом это 1/1 зеленая Лягушка.\\nВоспоминание {3}{G}{U} (Вы можете разыграть эту карту из вашего кладбища за ее стоимость Воспоминания. Затем изгоните ее.)\', \'type\': \'Волшебство\', \'flavor\': \'Лягушка — самая искренняя форма лести.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537535&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'08f6e0ea-f482-4579-a6f6-fb880b0e291f\', \'multiverseId\': 537535}, \'multiverseid\': 537535}, {\'name\': \'呱叫反身\', \'text\': \'派出一个衍生物，此衍生物为目标非蛙生物的复制品，但它是1/1绿色的蛙。\\n返照{3}{G}{U}（你可以从你坟墓场中施放此牌，并支付其返照费用，然后将它放逐。）\', \'type\': \'法术\', \'flavor\': \'青蛙是最真诚的奉承。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537851&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'157d2cef-e077-458c-9290-0bf486807a9a\', \'multiverseId\': 537851}, \'multiverseid\': 537851}, {\'name\': \'呱叫反身\', \'text\': \'派出一個衍生物，此衍生物為目標非蛙生物的複製品，但它是1/1綠色的蛙。\\n返照{3}{G}{U}（你可以從你墳墓場中施放此牌，並支付其返照費用，然後將它放逐。）\', \'type\': \'巫術\', \'flavor\': \'青蛙是最真誠的奉承。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538167&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'eb9f9d0f-32e8-4190-90c7-f081d99c3ebc\', \'multiverseId\': 538167}, \'multiverseid\': 538167}]', '[{\'name\': \'Quakendes Gegenstück\', \'text\': \'Erzeuge einen Spielstein, der eine Kopie einer Nicht-Frosch-Kreatur deiner Wahl ist, außer dass er ein 1/1 grüner Frosch ist.\\nRückblende {3}{G}{U}\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538786&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'423c67e8-495d-42d2-a6bc-f0e89be659f7\', \'multiverseId\': 538786}, \'multiverseid\': 538786}, {\'name\': \'Homólogo croante\', \'text\': \'Crea una ficha que es una copia de la criatura objetivo que no sea Rana, excepto que es una Rana verde 1/1.\\nRetrospectiva {3}{G}{U}.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538846&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3935f906-ca9e-4137-8fa6-b14858bf129b\', \'multiverseId\': 538846}, \'multiverseid\': 538846}, {\'name\': \'Homologue croassant\', \'text\': "Créez un jeton qui est une copie d\'une créature non-Grenouille ciblée, excepté que c\'est une grenouille 1/1 verte.\\nFlashback {3}{G}{U}", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538906&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2ab554bb-f329-4431-83c4-5512bc0c30b9\', \'multiverseId\': 538906}, \'multiverseid\': 538906}, {\'name\': \'Controparte Gracidante\', \'text\': \'Crea una pedina che è una copia di una creatura non Rana bersaglio, tranne che è una Rana 1/1 verde.\\nFlashback {3}{G}{U}\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538966&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'343e935d-0dfb-4835-8b1d-065faaabf4ac\', \'multiverseId\': 538966}, \'multiverseid\': 538966}, {\'name\': \'カエル声の写し身\', \'text\': \'カエルでないクリーチャー１体を対象とする。緑の１/１のカエルであることを除きそれのコピーであるトークン１体を生成する。\\nフラッシュバック {3}{G}{U}\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539026&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e0f0e9a8-a9f5-46b9-9fdd-cac0593160a8\', \'multiverseId\': 539026}, \'multiverseid\': 539026}]', '[{\'name\': \'Rache der Ertrunkenen\', \'text\': \'Der Besitzer einer Kreatur deiner Wahl legt sie auf oder unter seine Bibliothek. Du erzeugst einen 2/2 schwarzen Zombie-Kreaturenspielstein mit Verwesung. (Er kann nicht blocken. Wenn er angreift, opfere ihn am Ende des Kampfes.)\', \'type\': \'Spontanzauber\', \'flavor\': \'Ein schweres Netz bedeutet nicht immer einen guten Fang.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535154&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f90df85f-cfee-4c69-932b-860f27315162\', \'multiverseId\': 535154}, \'multiverseid\': 535154}, {\'name\': \'Venganza de los ahogados\', \'text\': \'El propietario de la criatura objetivo la pone en la parte superior o en el fondo de su biblioteca. Creas una ficha de criatura Zombie negra 2/2 con la habilidad de descomposición. (No puede bloquear. Cuando ataque, sacrifícala al final del combate.)\', \'type\': \'Instantáneo\', \'flavor\': \'Una red pesada no siempre supone una buena pesca.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535470&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ac1966ef-14a4-4ab9-b2ca-c3106d3a091a\', \'multiverseId\': 535470}, \'multiverseid\': 535470}, {\'name\': \'Revanche des noyés\', \'text\': "Le propriétaire d\'une créature ciblée la met au-dessus ou au-dessous de sa bibliothèque. Vous créez un jeton de créature 2/2 noire Zombie avec la décomposition. (Il ne peut pas bloquer. Quand il attaque, sacrifiez-le à la fin du combat.)", \'type\': \'Éphémère\', \'flavor\': "Un filet lourd n\'est pas toujours signe d\'une bonne pèche.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535786&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c2babd78-57a9-4f2f-9ed8-141ad158b219\', \'multiverseId\': 535786}, \'multiverseid\': 535786}, {\'name\': \'Vendetta degli Annegati\', \'text\': \'Il proprietario di una creatura bersaglio mette quella creatura in cima o in fondo al suo grimorio. Crei una pedina creatura Zombie 2/2 nera con decomposto. (Non può bloccare. Quando attacca, sacrificala alla fine del combattimento.)\', \'type\': \'Istantaneo\', \'flavor\': \'Una rete pesante non significa sempre una pesca fruttuosa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536102&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b9df8b1f-f0d4-4994-8708-f459de546f98\', \'multiverseId\': 536102}, \'multiverseid\': 536102}, {\'name\': \'溺死者の逆襲\', \'text\': \'クリーチャー１体を対象とする。それのオーナーはそれを自分のライブラリーの一番上か一番下に置く。あなたは腐乱を持つ黒の２/２のゾンビ・クリーチャー・トークン１体を生成する。（それではブロックできない。それが攻撃したとき、戦闘終了時に、それを生け贄に捧げる。）\', \'type\': \'インスタント\', \'flavor\': \'丈夫な網は必ずしも狙った獲物だけを捕らえるわけではない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536418&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f2abd200-e667-447c-8520-9eaa1fb849f1\', \'multiverseId\': 536418}, \'multiverseid\': 536418}, {\'name\': \'수장된 자들의 복수\', \'text\': \'생물을 목표로 정한다. 그 생물의 소유자는 그 생물을 자신의 서고 맨 위 또는 맨 밑에 놓는다. 당신은 부패를 가진 2/2 흑색 좀비 생물 토큰 한 개를 만든다. (그 생물은 방어할 수 없다. 그 생물이 공격할 때, 전투종료에 그 생물을 희생한다.)\', \'type\': \'순간마법\', \'flavor\': \'그물이 무겁다는 것이 풍어만을 의미하지는 않는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536734&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'aec8fc45-0827-466a-8515-01eca13d79be\', \'multiverseId\': 536734}, \'multiverseid\': 536734}, {\'name\': \'Vingança dos Afogados\', \'text\': \'O dono da criatura alvo a coloca no topo ou no fundo do próprio grimório. Você cria uma ficha de criatura Zumbi preta 2/2 com decomposto. (Ela não pode bloquear. Quando ela atacar, sacrifique-a no final do combate.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Uma rede pesada nem sempre pega coisa boa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537050&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c54780dc-2bb4-4d48-8b87-89077ef9a14e\', \'multiverseId\': 537050}, \'multiverseid\': 537050}, {\'name\': \'Месть Утопших\', \'text\': \'Владелец целевого существа кладет его на верх или в низ своей библиотеки. Вы создаете одну фишку существа 2/2 черный Зомби с Трупной гнилью. (Она не может блокировать. Когда она атакует, пожертвуйте ее в конце боя.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Тяжелая сеть не всегда означает добрый улов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537366&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fd12bc73-72bf-436b-a999-a666bdc79a52\', \'multiverseId\': 537366}, \'multiverseid\': 537366}, {\'name\': \'溺亡者复仇\', \'text\': \'目标生物的拥有者将它置于其牌库顶或牌库底。你派出一个2/2黑色，具败朽异能的灵俑衍生生物。（它不能进行阻挡。当它攻击，在战斗结束时将它牺牲。）\', \'type\': \'瞬间\', \'flavor\': \'沉重渔网不一定是有好收成。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537682&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d7866c38-9512-4a49-ba6a-579d83bdabe7\', \'multiverseId\': 537682}, \'multiverseid\': 537682}, {\'name\': \'溺亡者復仇\', \'text\': \'目標生物的擁有者將它置於其牌庫頂或牌庫底。你派出一個2/2黑色，具敗朽異能的殭屍衍生生物。（它不能進行阻擋。當它攻擊，在戰鬥結束時將它犧牲。）\', \'type\': \'瞬間\', \'flavor\': \'沉重漁網不一定是有好收成。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537998&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ec72815e-da61-42fa-b934-caff9654dc09\', \'multiverseId\': 537998}, \'multiverseid\': 537998}]', '[{\'name\': \'Reinigender Scheiterhaufen\', \'text\': \'Bestimme eines —\\n• Der Reinigende Scheiterhaufen fügt einer Kreatur oder einem Planeswalker deiner Wahl 3 Schadenspunkte zu.\\n• Wirf bis zu zwei Karten ab und ziehe dann entsprechend viele Karten.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Lass den Kummer dieses Körpers hinter dir. Sei gesegnet, Wesen aus Licht."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535225&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'57984c6a-5b11-4b3a-8b5c-37bd84134167\', \'multiverseId\': 535225}, \'multiverseid\': 535225}, {\'name\': \'Pira catártica\', \'text\': \'Elige uno:\\n• La Pira catártica hace 3 puntos de daño a la criatura o planeswalker objetivo.\\n• Descarta hasta dos cartas, luego roba esa misma cantidad de cartas.\', \'type\': \'Instantáneo\', \'flavor\': \'"Deja atrás los pesares de este cuerpo. Bendito seas, ser de luz".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535541&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6b876558-25e0-44d3-8694-e3ac5d737896\', \'multiverseId\': 535541}, \'multiverseid\': 535541}, {\'name\': \'Bûcher funéraire cathartique\', \'text\': "Choisissez l\'un —\\n• Le Bûcher funéraire cathartique inflige 3 blessures à une cible, créature ou planeswalker.\\n• Défaussez-vous de jusqu\'à deux cartes, puis piochez autant de cartes.", \'type\': \'Éphémère\', \'flavor\': \'« Laissez derrière vous la tristesse de ce corps. Soyez béni, être de lumière. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535857&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b7a21e87-433b-42f3-b7c7-e36286fbc1e5\', \'multiverseId\': 535857}, \'multiverseid\': 535857}, {\'name\': \'Pira Catartica\', \'text\': \'Scegli uno —\\n• La Pira Catartica infligge 3 danni a una creatura o a un planeswalker bersaglio.\\n• Scarta fino a due carte, poi pesca altrettante carte.\', \'type\': \'Istantaneo\', \'flavor\': \'"Abbandona i dispiaceri di questo corpo. Sii benedetto, essere di luce."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536173&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'da0fb2bf-4410-4825-94b5-4d5ab7bdb3d3\', \'multiverseId\': 536173}, \'multiverseid\': 536173}, {\'name\': \'安堵の火葬\', \'text\': \'以下から１つを選ぶ。\\n• クリーチャーやプレインズウォーカーのうち１体を対象とする。安堵の火葬はそれに３点のダメージを与える。\\n• カード最大２枚を捨て、その後その枚数に等しい枚数のカードを引く。\', \'type\': \'インスタント\', \'flavor\': \'「この肉体に宿る悲しみを捨て去れ。祝福されよ、光の者よ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536489&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8c1a48dd-d8ad-4445-9ec1-ca7344adbccb\', \'multiverseId\': 536489}, \'multiverseid\': 536489}, {\'name\': \'후련해지는 장작불\', \'text\': \'하나를 선택한다 —\\n• 생물 또는 플레인즈워커를 목표로 정한다. 후련해지는 장작불은 그 목표에게 피해 3점을 입힌다.\\n• 카드를 최대 두 장까지 버린 후, 그만큼의 카드를 뽑는다.\', \'type\': \'순간마법\', \'flavor\': \'"이 육신의 슬픔은 두고 가십시오. 축복합니다, 빛의 존재여."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536805&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2cdf7030-34f0-44ff-8ff7-6875ee892ea5\', \'multiverseId\': 536805}, \'multiverseid\': 536805}, {\'name\': \'Pira Catártica\', \'text\': \'Escolha um —\\n• Pira Catártica causa 3 pontos de dano à criatura ou ao planeswalker alvo.\\n• Descarte até dois cards e depois compre aquela quantidade de cards.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Deixe os pesares desse corpo para trás. Abençoado seja, ser de luz."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537121&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8f01046b-a981-4c78-9e75-002c5aeaaaa6\', \'multiverseId\': 537121}, \'multiverseid\': 537121}, {\'name\': \'Очистительный Костер\', \'text\': "Выберите одно —\\n• Очистительный Костер наносит 3 повреждения целевому существу или planeswalker\'у.\\n• Сбросьте не более двух карт, затем возьмите столько же карт.", \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Отбрось печали этого тела. Будь благословен, созданье света».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537437&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6f7d3134-8301-4486-a00d-f1d9bec2574e\', \'multiverseId\': 537437}, \'multiverseid\': 537437}, {\'name\': \'净灵葬火\', \'text\': \'选择一项～\\n•净灵葬火对目标生物或鹏洛客造成3点伤害。\\n•弃至多两张牌，然后抓等量的牌。\', \'type\': \'瞬间\', \'flavor\': \'「愿你忘却肉身所历伤悲。愿你蒙受祝福，化身光辉。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537753&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a62d5ad8-4db8-4563-ad3c-674e243d72e8\', \'multiverseId\': 537753}, \'multiverseid\': 537753}, {\'name\': \'淨靈葬火\', \'text\': \'選擇一項～\\n•淨靈葬火對目標生物或鵬洛客造成3點傷害。\\n•棄至多兩張牌，然後抽等量的牌。\', \'type\': \'瞬間\', \'flavor\': \'「願你忘卻肉身所歷傷悲。願你蒙受祝福，化身光輝。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538069&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'60d627fa-834a-4e6f-8e38-cdf3777b1dc4\', \'multiverseId\': 538069}, \'multiverseid\': 538069}]', '[{\'name\': \'Reiterin des Sonnenaufgangs\', \'text\': \'Eile, verursacht Trampelschaden\\nFalls es weder Tag noch Nacht ist, wird es Tag, sowie die Reiterin des Sonnenaufgangs ins Spiel kommt.\\nImmer wenn der Tag zur Nacht oder die Nacht zum Tag wird, lege eine +1/+1-Marke auf eine Kreatur deiner Wahl, die du kontrollierst.\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': \'„So wie wir kämpft auch der Morgen ums Überleben."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535356&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dbe8193b-4f9e-4516-be78-90a184d44232\', \'multiverseId\': 535356}, \'multiverseid\': 535356}, {\'name\': \'Jinete del amanecer\', \'text\': \'Arrolla, prisa.\\nSi no es ni de día ni de noche, se hace de día en cuanto la Jinete del amanecer entre al campo de batalla.\\nSiempre que se pase del día a la noche o de la noche al día, pon un contador +1/+1 sobre la criatura objetivo que controlas.\', \'type\': \'Criatura — Caballero humano\', \'flavor\': \'"La mañana lucha por sobrevivir, al igual que nosotros".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535672&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'80816740-83cf-4593-9acc-eaf1d9f86b99\', \'multiverseId\': 535672}, \'multiverseid\': 535672}, {\'name\': "Cavalière de l\'aurore", \'text\': "Piétinement, célérité\\nSi ce n\'est ni le jour ni la nuit, on passe au jour au moment où la Cavalière de l\'aurore arrive sur le champ de bataille.\\nÀ chaque fois qu\'on passe du jour à la nuit ou de la nuit au jour, mettez un marqueur +1/+1 sur une créature ciblée que vous contrôlez.", \'type\': \'Créature : humain et chevalier\', \'flavor\': \'« Comme nous, le matin lutte pour sa survie. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535988&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cdb39d3b-802d-44dd-875f-09b5d9422e77\', \'multiverseId\': 535988}, \'multiverseid\': 535988}, {\'name\': "Cavaliera dell\'Aurora", \'text\': "Travolgere, rapidità\\nSe non è né giorno né notte, diventa giorno mentre la Cavaliera dell\'Aurora entra nel campo di battaglia.\\nOgniqualvolta il giorno diventa notte o la notte diventa giorno, metti un segnalino +1/+1 su una creatura bersaglio che controlli.", \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': \'"Proprio come noi, anche il mattino lotta per sopravvivere."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536304&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'52f93feb-eaac-49d2-82d2-a0e8a990a0fa\', \'multiverseId\': 536304}, \'multiverseid\': 536304}, {\'name\': \'日の出の騎兵\', \'text\': \'トランプル、速攻\\n日の出の騎兵が戦場に出るに際し、昼でも夜でもないなら、昼になる。\\n昼が夜になるか夜が昼になるたび、あなたがコントロールしているクリーチャー１体を対象とする。それの上に＋１/＋１カウンター１個を置く。\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': \'「私たちと同じく、朝が己の生存をかけて戦っているのよ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536620&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6083f2d2-4080-4f27-8563-befaf07ec98d\', \'multiverseId\': 536620}, \'multiverseid\': 536620}, {\'name\': \'일출의 기수\', \'text\': \'돌진, 신속\\n낮도 밤도 아니라면, 일출의 기수가 전장에 들어오면서 낮이 된다.\\n낮이 밤이 되거나 밤이 낮이 될 때마다, 당신이 조종하는 생물을 목표로 정한다. 그 생물에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 인간 기사\', \'flavor\': \'"우리와 마찬가지로, 아침도 살아남기 위해 싸우고 있다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536936&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'bda10211-0dc1-4bca-82a6-4fa65ef647af\', \'multiverseId\': 536936}, \'multiverseid\': 536936}, {\'name\': \'Amazona da Aurora\', \'text\': \'Atropelar, ímpeto\\nSe não for dia nem noite, torna-se dia conforme Amazona da Aurora entra no campo de batalha.\\nToda vez que o dia se tornar noite ou a noite se tornar dia, coloque um marcador +1/+1 na criatura alvo que você controla.\', \'type\': \'Criatura — Humano Cavaleiro\', \'flavor\': \'"Como nós, a manhã luta para sobreviver."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537252&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'89c60ae3-e6b9-4a6c-a681-815890629171\', \'multiverseId\': 537252}, \'multiverseid\': 537252}, {\'name\': \'Всадница Восхода\', \'text\': \'Пробивной удар, Ускорение\\nЕсли не стоит ни день, ни ночь, то при выходе Всадницы Восхода на поле битвы наступает день.\\nКаждый раз, когда день становится ночью или ночь становится днем, положите один жетон +1/+1 на целевое существо под вашим контролем.\', \'type\': \'Существо — Человек Рыцарь\', \'flavor\': \'«Как и мы, утро борется за выживание».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537568&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fb989f0c-8f74-45d3-a72b-59da92e7022c\', \'multiverseId\': 537568}, \'multiverseid\': 537568}, {\'name\': \'日升骑兵\', \'text\': \'践踏，敏捷\\n如果当前既非白昼也非黑夜，则于日升骑兵进战场时成为白昼。\\n每当白昼成为黑夜或黑夜成为白昼时，在目标由你操控的生物上放置一个+1/+1指示物。\', \'type\': \'生物 ～人类／骑士\', \'flavor\': \'「跟我们一样，清晨也在艰苦求存。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537884&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'291c0b1a-3d7d-4957-b8c1-aa315d560498\', \'multiverseId\': 537884}, \'multiverseid\': 537884}, {\'name\': \'日昇騎兵\', \'text\': \'踐踏，敏捷\\n如果當前既非白晝也非黑夜，則於日昇騎兵進戰場時成為白晝。\\n每當白晝成為黑夜或黑夜成為白晝時，在目標由你操控的生物上放置一個+1/+1指示物。\', \'type\': \'生物 ～人類／騎士\', \'flavor\': \'「跟我們一樣，清晨也在艱苦求存。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538200&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'03406a03-3b0a-4218-98ec-00b41b95a661\', \'multiverseId\': 538200}, \'multiverseid\': 538200}]', '[{\'name\': \'Rem Karolus, unverzagter Jäger\', \'text\': \'Fliegend, Eile\\nFalls ein Zauberspruch dir oder einer anderen bleibenden Karte, die du kontrollierst, Schaden zufügen würde, verhindere den Schaden.\\nFalls ein Zauberspruch einem Gegner oder einer bleibenden Karte, die ein Gegner kontrolliert, Schaden zufügen würde, fügt er stattdessen entsprechend viele Schadenspunkte plus 1 zu.\', \'type\': \'Legendäre Kreatur — Mensch, Ritter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535347&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e0c6669a-dd7a-43df-9a52-d1a8e08444ff\', \'multiverseId\': 535347}, \'multiverseid\': 535347}, {\'name\': \'Rem Karolus, exterminador leal\', \'text\': \'Vuela, prisa.\\nSi un hechizo fuera a hacerte daño a ti o a otro permanente que controlas, prevén ese daño.\\nSi un hechizo fuera a hacer daño a un oponente o un permanente que controla un oponente, en vez de eso, hace esa misma cantidad de daño más 1.\', \'type\': \'Criatura legendaria — Caballero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535663&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e33fa2d1-8460-4da6-875b-d4faa25abd94\', \'multiverseId\': 535663}, \'multiverseid\': 535663}, {\'name\': \'Rem Karolus, tueur vaillant\', \'text\': "Vol, célérité\\nSi un sort devait infliger des blessures à vous ou à un autre permanent que vous contrôlez, prévenez ces blessures.\\nSi un sort devait infliger des blessures à un adversaire ou à un permanent qu\'un adversaire contrôle, il inflige autant de blessures plus 1 à la place.", \'type\': \'Créature légendaire : humain et chevalier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535979&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7872fd5d-edf2-450a-81f7-27d3154b4a60\', \'multiverseId\': 535979}, \'multiverseid\': 535979}, {\'name\': \'Rem Karolus, Sterminatore Intrepido\', \'text\': \'Volare, rapidità\\nSe una magia sta per infliggere danno a te o a un altro permanente che controlli, previeni quel danno.\\nSe una magia sta per infliggere danno a un avversario o a un permanente controllato da un avversario, infligge invece altrettanti danni più 1.\', \'type\': \'Creatura Leggendaria — Cavaliere Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536295&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'11b723d9-096e-4c05-a41b-f6a149b3cf76\', \'multiverseId\': 536295}, \'multiverseid\': 536295}, {\'name\': \'確固たる討伐者、レム・カロラス\', \'text\': \'飛行、速攻\\n呪文が、あなたやあなたがコントロールしていてこれでないパーマネントにダメージを与えるなら、そのダメージを軽減する。\\n呪文が、対戦相手や対戦相手がコントロールしているパーマネントにダメージを与えるなら、代わりに、それはその点数に１を足した点数のダメージを与える。\', \'type\': \'伝説のクリーチャー — 人間・騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536611&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'22d32b63-5425-4286-9eb6-1a245d37f1e3\', \'multiverseId\': 536611}, \'multiverseid\': 536611}, {\'name\': \'충직한 시해자, 렘 카롤러스\', \'text\': \'비행, 신속\\n주문이 당신 또는 당신이 조종하는 다른 지속물에게 피해를 입히려 한다면, 그 피해를 방지한다.\\n주문이 상대 또는 상대가 조종하는 지속물에 피해를 입히려고 하면, 그 주문은 대신 그 피해에 1을 더한 만큼 피해를 입힌다.\', \'type\': \'전설적 생물 — 인간 기사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536927&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2475c93f-f8dc-4d21-b24e-f151d7d5298a\', \'multiverseId\': 536927}, \'multiverseid\': 536927}, {\'name\': \'Rem Karolus, Matador Resoluto\', \'text\': \'Voar, ímpeto\\nSe uma mágica causaria dano a você ou a outra permanente que você controla, previna aquele dano.\\nSe uma mágica causaria dano a um oponente ou a uma permanente que um oponente controla, em vez disso, ela causa aquela quantidade de dano mais 1.\', \'type\': \'Criatura Lendária — Humano Cavaleiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537243&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6313bb73-8212-4e8d-877e-a6c8cff5bc37\', \'multiverseId\': 537243}, \'multiverseid\': 537243}, {\'name\': \'Рем Каролус, Храбрый Истребитель\', \'text\': \'Полет, Ускорение\\nЕсли заклинание должно нанести повреждения вам или другому перманенту под вашим контролем, предотвратите те повреждения.\\nЕсли заклинание должно нанести повреждения оппоненту или перманенту под контролем оппонента, вместо этого оно наносит то количество повреждений плюс 1.\', \'type\': \'Легендарное Существо — Человек Рыцарь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537559&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'59927cb6-4b4e-4163-9a40-11664c8a1aaa\', \'multiverseId\': 537559}, \'multiverseid\': 537559}, {\'name\': \'不渝克星连卡洛\', \'text\': \'飞行，敏捷\\n如果某咒语将对你或另一个由你操控的永久物造成伤害，则防止该伤害。\\n如果某咒语将向任一对手或任一由对手操控的永久物造成伤害，则改为它造成原数量加1点伤害。\', \'type\': \'传奇生物 ～人类／骑士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537875&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'72f7a5bf-4cf3-4b2d-8bff-0efbd91a0646\', \'multiverseId\': 537875}, \'multiverseid\': 537875}, {\'name\': \'不渝剋星連卡洛\', \'text\': \'飛行，敏捷\\n如果某咒語將對你或另一個由你操控的永久物造成傷害，則防止該傷害。\\n如果某咒語將向任一對手或任一由對手操控的永久物造成傷害，則改為它造成原數量加1點傷害。\', \'type\': \'傳奇生物 ～人類／騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538191&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6d6db4ed-7fac-4712-aed5-8c412b7ba451\', \'multiverseId\': 538191}, \'multiverseid\': 538191}]', '[{\'name\': \'Rem Karolus, unverzagter Jäger\', \'text\': \'Fliegend, Eile\\nFalls ein Zauberspruch dir oder einer anderen bleibenden Karte, die du kontrollierst, Schaden zufügen würde, verhindere den Schaden.\\nFalls ein Zauberspruch einem Gegner oder einer bleibenden Karte, die ein Gegner kontrolliert, Schaden zufügen würde, fügt er stattdessen entsprechend viele Schadenspunkte plus 1 zu.\', \'type\': \'Legendäre Kreatur — Mensch, Ritter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538521&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6c1e88bc-3212-431c-bee0-e5a5163ccd20\', \'multiverseId\': 538521}, \'multiverseid\': 538521}, {\'name\': \'Rem Karolus, exterminador leal\', \'text\': \'Vuela, prisa.\\nSi un hechizo fuera a hacerte daño a ti o a otro permanente que controlas, prevén ese daño.\\nSi un hechizo fuera a hacer daño a un oponente o un permanente que controla un oponente, en vez de eso, hace esa misma cantidad de daño más 1.\', \'type\': \'Criatura legendaria — Caballero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538538&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a7d6bc90-6ba4-4c86-b720-ac389cd790eb\', \'multiverseId\': 538538}, \'multiverseid\': 538538}, {\'name\': \'Rem Karolus, tueur vaillant\', \'text\': "Vol, célérité\\nSi un sort devait infliger des blessures à vous ou à un autre permanent que vous contrôlez, prévenez ces blessures.\\nSi un sort devait infliger des blessures à un adversaire ou à un permanent qu\'un adversaire contrôle, il inflige autant de blessures plus 1 à la place.", \'type\': \'Créature légendaire : humain et chevalier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538555&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8060ed9b-eb32-4a76-8a8e-6d6134c1b688\', \'multiverseId\': 538555}, \'multiverseid\': 538555}, {\'name\': \'Rem Karolus, Sterminatore Intrepido\', \'text\': \'Volare, rapidità\\nSe una magia sta per infliggere danno a te o a un altro permanente che controlli, previeni quel danno.\\nSe una magia sta per infliggere danno a un avversario o a un permanente controllato da un avversario, infligge invece altrettanti danni più 1.\', \'type\': \'Creatura Leggendaria — Cavaliere Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538572&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'22867559-b8a8-42cf-bd5c-166218c688c3\', \'multiverseId\': 538572}, \'multiverseid\': 538572}, {\'name\': \'確固たる討伐者、レム・カロラス\', \'text\': \'飛行、速攻\\n呪文が、あなたやあなたがコントロールしていてこれでないパーマネントにダメージを与えるなら、そのダメージを軽減する。\\n呪文が、対戦相手や対戦相手がコントロールしているパーマネントにダメージを与えるなら、代わりに、それはその点数に１を足した点数のダメージを与える。\', \'type\': \'伝説のクリーチャー — 人間・騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538589&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'41f16ab2-aa04-4583-8a0e-646a2060b1bc\', \'multiverseId\': 538589}, \'multiverseid\': 538589}, {\'name\': \'충직한 시해자, 렘 카롤러스\', \'text\': \'비행, 신속\\n주문이 당신 또는 당신이 조종하는 다른 지속물에게 피해를 입히려 한다면, 그 피해를 방지한다.\\n주문이 상대 또는 상대가 조종하는 지속물에 피해를 입히려고 하면, 그 주문은 대신 그 피해에 1을 더한 만큼 피해를 입힌다.\', \'type\': \'전설적 생물 — 인간 기사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538606&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f3b7effc-4a08-4624-9a87-473dd2e77059\', \'multiverseId\': 538606}, \'multiverseid\': 538606}, {\'name\': \'Rem Karolus, Matador Resoluto\', \'text\': \'Voar, ímpeto\\nSe uma mágica causaria dano a você ou a outra permanente que você controla, previna aquele dano.\\nSe uma mágica causaria dano a um oponente ou a uma permanente que um oponente controla, em vez disso, ela causa aquela quantidade de dano mais 1.\', \'type\': \'Criatura Lendária — Humano Cavaleiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538623&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5071d0ca-dec3-4233-aa03-cc9ac7e6fdcd\', \'multiverseId\': 538623}, \'multiverseid\': 538623}, {\'name\': \'Рем Каролус, Храбрый Истребитель\', \'text\': \'Полет, Ускорение\\nЕсли заклинание должно нанести повреждения вам или другому перманенту под вашим контролем, предотвратите те повреждения.\\nЕсли заклинание должно нанести повреждения оппоненту или перманенту под контролем оппонента, вместо этого оно наносит то количество повреждений плюс 1.\', \'type\': \'Легендарное Существо — Человек Рыцарь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538640&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cdedf3fd-fc9f-4314-985f-409bcbfd11c9\', \'multiverseId\': 538640}, \'multiverseid\': 538640}, {\'name\': \'不渝克星连卡洛\', \'text\': \'飞行，敏捷\\n如果某咒语将对你或另一个由你操控的永久物造成伤害，则防止该伤害。\\n如果某咒语将向任一对手或任一由对手操控的永久物造成伤害，则改为它造成原数量加1点伤害。\', \'type\': \'传奇生物 ～人类／骑士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538657&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'07e406dc-ef58-4ef0-840a-9326bdec5142\', \'multiverseId\': 538657}, \'multiverseid\': 538657}, {\'name\': \'不渝剋星連卡洛\', \'text\': \'飛行，敏捷\\n如果某咒語將對你或另一個由你操控的永久物造成傷害，則防止該傷害。\\n如果某咒語將向任一對手或任一由對手操控的永久物造成傷害，則改為它造成原數量加1點傷害。\', \'type\': \'傳奇生物 ～人類／騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538674&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b7a36c47-2377-4199-9e8b-bc2d3b0d3d3f\', \'multiverseId\': 538674}, \'multiverseid\': 538674}]', '[{\'name\': \'Ritual der Hoffnung\', \'text\': \'Kreaturen, die du kontrollierst, erhalten +1/+1 bis zum Ende des Zuges.\\nHexenzirkel — Falls du drei oder mehr Kreaturen mit unterschiedlicher Stärke kontrollierst, erhalten Kreaturen, die du kontrollierst, stattdessen +2/+1 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Heute können wir alles sein."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535105&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'282e168b-bcc0-417c-96bd-6868d1baeef0\', \'multiverseId\': 535105}, \'multiverseid\': 535105}, {\'name\': \'Ritual de la esperanza\', \'text\': \'Las criaturas que controlas obtienen +1/+1 hasta el final del turno.\\nAquelarre — Si controlas tres o más criaturas con fuerzas distintas, en vez de eso, las criaturas que controlas obtienen +2/+1 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"Esta noche podemos ser cualquier cosa".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535421&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b5bb64c8-6c41-4f16-a97e-fd6a87430836\', \'multiverseId\': 535421}, \'multiverseid\': 535421}, {\'name\': "Rituel d\'espoir", \'text\': "Les créatures que vous contrôlez gagnent +1/+1 jusqu\'à la fin du tour.\\nCongrégation — Si vous contrôlez au moins trois créatures avec des forces différentes, les créatures que vous contrôlez gagnent +2/+1 jusqu\'à la fin du tour à la place.", \'type\': \'Éphémère\', \'flavor\': \'« Ce soir, nous pouvons être ce que nous voulons. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535737&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'43896fe9-834d-4b0e-8ed7-b4f895e4abed\', \'multiverseId\': 535737}, \'multiverseid\': 535737}, {\'name\': \'Rituale di Speranza\', \'text\': \'Le creature che controlli prendono +1/+1 fino alla fine del turno.\\nCongrega — Se controlli tre o più creature con forza diversa, invece le creature che controlli prendono +2/+1 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Questa notte, possiamo essere ciò che vogliamo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536053&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a8616c14-da54-469c-94cd-1258cec449a7\', \'multiverseId\': 536053}, \'multiverseid\': 536053}, {\'name\': \'希望の儀式\', \'text\': \'ターン終了時まで、あなたがコントロールしているすべてのクリーチャーは＋１/＋１の修整を受ける。\\n集会 — あなたがパワーが異なる３体以上のクリーチャーをコントロールしているなら、 代わりに、ターン終了時まで、あなたがコントロールしているすべてのクリーチャーは＋２/＋１の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'「今夜は何にでもなれるのよ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536369&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ca49c7d8-cb1c-4e9d-9bc1-3881b4cdf886\', \'multiverseId\': 536369}, \'multiverseid\': 536369}, {\'name\': \'희망의 의식\', \'text\': \'당신이 조종하는 생물들은 턴종료까지 +1/+1을 받는다.\\n집회 — 당신이 서로 공격력이 다른 생물을 세 개 이상 조종한다면, 대신 당신이 조종하는 생물들은 턴종료까지 +2/+1을 받는다.\', \'type\': \'순간마법\', \'flavor\': \'"오늘 밤, 우리는 무엇이든 될 수 있다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536685&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'49fbdf5b-4e7f-4dd2-b708-284613f51d4a\', \'multiverseId\': 536685}, \'multiverseid\': 536685}, {\'name\': \'Ritual da Esperança\', \'text\': \'As criaturas que você controla recebem +1/+1 até o final do turno.\\nConventículo — Se você controlar três ou mais criaturas com poderes diferentes, em vez disso, as criaturas que você controla recebem +2/+1 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Esta noite nós podemos ser qualquer coisa."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537001&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dbb1c20e-e664-4189-851d-dea82cab6e7d\', \'multiverseId\': 537001}, \'multiverseid\': 537001}, {\'name\': \'Ритуал Надежды\', \'text\': \'Существа под вашим контролем получают +1/+1 до конца хода.\\nШабаш — Если вы контролируете не менее трех существ с различными значениями силы, то вместо этого существа под вашим контролем получают +2/+1 до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Сегодня ночью мы можем быть кем угодно».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537317&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4ec1a304-db62-42b1-ba60-e9d265bf84a4\', \'multiverseId\': 537317}, \'multiverseid\': 537317}, {\'name\': \'祈望仪式\', \'text\': \'由你操控的生物得+1/+1直到回合结束。\\n鸠集～如果你操控三个或更多力量各不相同的生物，则改为由你操控的生物得+2/+1直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'「今晚，我们就是一切。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537633&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6f616d80-96b5-4676-bd01-80d9ea149ef9\', \'multiverseId\': 537633}, \'multiverseid\': 537633}, {\'name\': \'祈望儀式\', \'text\': \'由你操控的生物得+1/+1直到回合結束。\\n鳩集～如果你操控三個或更多力量各不相同的生物，則改為由你操控的生物得+2/+1直到回合結束。\', \'type\': \'瞬間\', \'flavor\': \'「今晚，我們就是一切。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537949&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'82d4a716-f7f7-4f7e-bf94-60a951a625bc\', \'multiverseId\': 537949}, \'multiverseid\': 537949}]', '[{\'name\': \'Ritualwächterin\', \'text\': \'Hexenzirkel — Zu Beginn des Kampfes in deinem Zug und falls du drei oder mehr Kreaturen mit unterschiedlicher Stärke kontrollierst, erhält die Ritualwächterin Lebensverknüpfung bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'„Durch uralte Magie und durch die Gnade der Engel werden wir diese Nacht überleben."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535104&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8bb1b460-bbc5-4154-836b-ced9e6aad55e\', \'multiverseId\': 535104}, \'multiverseid\': 535104}, {\'name\': \'Guardiana del ritual\', \'text\': \'Aquelarre — Al comienzo del combate en tu turno, si controlas tres o más criaturas con fuerzas distintas, la Guardiana del ritual gana la habilidad de vínculo vital hasta el final del turno.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'"Por la magia antigua y por la gracia de los ángeles: sobreviviremos a esta noche".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535420&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6ec6586b-9840-48d1-8b59-f2b330be3f49\', \'multiverseId\': 535420}, \'multiverseid\': 535420}, {\'name\': \'Vigile du rituel\', \'text\': "Congrégation — Au début du combat pendant votre tour, si vous contrôlez au moins trois créatures avec des forces différentes, le Vigile du rituel acquiert le lien de vie jusqu\'à la fin du tour.", \'type\': \'Créature : humain et soldat\', \'flavor\': \'« Par les magies ancestrales, par la grâce des anges, nous survivrons à cette nuit. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535736&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'71d03f41-63d5-4a4b-bd46-04156a0d93ee\', \'multiverseId\': 535736}, \'multiverseid\': 535736}, {\'name\': \'Guardiana del Rituale\', \'text\': "Congrega — All\'inizio del combattimento nel tuo turno, se controlli tre o più creature con forza diversa, la Guardiana del Rituale ha legame vitale fino alla fine del turno.", \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'"Per l\\\'antica magia, per la grazia degli angeli, questa notte sopravvivremo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536052&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d8b290f7-592a-44df-8677-65e5fd7e1880\', \'multiverseId\': 536052}, \'multiverseid\': 536052}, {\'name\': \'儀式の守護者\', \'text\': \'集会 — あなたのターンの戦闘の開始時に、あなたがパワーが異なる３体以上のクリーチャーをコントロールしている場合、ターン終了時まで、儀式の守護者は絆魂を得る。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'「古の魔法と天使の恩寵によって、我らは夜を生き延びよう。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536368&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b57897e5-8613-4a81-a45d-02947ed5153c\', \'multiverseId\': 536368}, \'multiverseid\': 536368}, {\'name\': \'의식 수호자\', \'text\': \'집회 — 당신의 턴 전투 시작에, 당신이 서로 공격력이 다른 생물을 세 개 이상 조종한다면, 의식 수호자는 턴종료까지 생명연결을 얻는다.\', \'type\': \'생물 — 인간 병사\', \'flavor\': \'"고대의 마법과 천사의 은총으로, 우리는 이 밤을 견뎌낼 것이다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536684&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e6fd52b9-b3c3-48b3-82af-d755491bb4aa\', \'multiverseId\': 536684}, \'multiverseid\': 536684}, {\'name\': \'Guardiã do Ritual\', \'text\': \'Conventículo — No início do combate no seu turno, se você controlar três ou mais criaturas com poderes diferentes, Guardiã do Ritual ganha vínculo com a vida até o final do turno.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': \'"Pela magia antiga, pela graça dos anjos, sobreviveremos a esta noite."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537000&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c29c1c8f-fe2a-4c32-a19b-c68f7f6c22c2\', \'multiverseId\': 537000}, \'multiverseid\': 537000}, {\'name\': \'Стражница Ритуала\', \'text\': \'Шабаш — В начале боя во время вашего хода, если вы контролируете не менее трех существ с различными значениями силы, Стражница Ритуала получает Цепь жизни до конца хода.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'«Могущество древней магии и милость ангелов поможет нам пережить эту ночь».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537316&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'06b4dfd9-2744-4424-98dd-308a793934c4\', \'multiverseId\': 537316}, \'multiverseid\': 537316}, {\'name\': \'仪式守护者\', \'text\': \'鸠集～在你回合的战斗开始时，若你操控三个或更多力量各不相同的生物，则仪式守护者获得系命异能直到回合结束。\', \'type\': \'生物 ～人类／士兵\', \'flavor\': \'「得远古魔法加护，承天使恩典保佑，我们定能挺过长夜。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537632&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'abee4637-c365-4ab7-b397-06ddff67bd03\', \'multiverseId\': 537632}, \'multiverseid\': 537632}, {\'name\': \'儀式守護者\', \'text\': \'鳩集～在你回合的戰鬥開始時，若你操控三個或更多力量各不相同的生物，則儀式守護者獲得繫命異能直到回合結束。\', \'type\': \'生物 ～人類／士兵\', \'flavor\': \'「得遠古魔法加護，承天使恩典保佑，我們定能挺過長夜。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537948&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'67d8bd83-ff1c-4184-bc19-6995b0ecec21\', \'multiverseId\': 537948}, \'multiverseid\': 537948}]', '[{\'name\': \'Ritus der Harmonie\', \'text\': \'Immer wenn in diesem Zug eine Kreatur oder eine Verzauberung unter deiner Kontrolle ins Spiel kommt, ziehe eine Karte.\\nRückblende {2}{G}{W} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten wirken. Schicke sie danach ins Exil.)\', \'type\': \'Spontanzauber\', \'flavor\': \'Die Natur beugt sich dem Ruf der Hexen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535348&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bd51b582-b128-4e5a-ac60-4060f93cbc5d\', \'multiverseId\': 535348}, \'multiverseid\': 535348}, {\'name\': \'Rito de armonía\', \'text\': \'Siempre que una criatura o encantamiento entre al campo de batalla bajo tu control este turno, roba una carta.\\nRetrospectiva {2}{G}{W}. (Puedes lanzar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego exíliala.)\', \'type\': \'Instantáneo\', \'flavor\': \'La naturaleza cede ante la llamada de las brujas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535664&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'58661758-148c-48d0-b078-3a1623335f98\', \'multiverseId\': 535664}, \'multiverseid\': 535664}, {\'name\': "Rite de l\'harmonie", \'text\': "À chaque fois qu\'une créature ou un enchantement arrive sur le champ de bataille sous votre contrôle ce tour-ci, piochez une carte.\\nFlashback {2}{G}{W} (Vous pouvez lancer cette carte depuis votre cimetière pour son coût de flashback. Exilez-la ensuite.)", \'type\': \'Éphémère\', \'flavor\': "La nature se plie à l\'appel des envoûteuses.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535980&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'192fa1cb-7c19-4c59-8cf4-9fef63a69e45\', \'multiverseId\': 535980}, \'multiverseid\': 535980}, {\'name\': "Rito dell\'Armonia", \'text\': \'Ogniqualvolta una creatura o un incantesimo entra nel campo di battaglia sotto il tuo controllo in questo turno, pesca una carta.\\nFlashback {2}{G}{W} (Puoi lanciare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi esiliala.)\', \'type\': \'Istantaneo\', \'flavor\': \'La natura si piega al volere delle streghe.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536296&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cb8c155a-193b-4d94-85a1-0a253e8a93d3\', \'multiverseId\': 536296}, \'multiverseid\': 536296}, {\'name\': \'調和の儀式\', \'text\': \'このターン、クリーチャーやエンチャントのうち１つがあなたのコントロール下で戦場に出るたび、カード１枚を引く。\\nフラッシュバック{2}{G}{W}（あなたはあなたの墓地にあるこのカードをフラッシュバック・コストで唱えてもよい。その後、これを追放する。）\', \'type\': \'インスタント\', \'flavor\': \'魔女の呼び声に自然が応える。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536612&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f1c9dcdd-98ab-4cd9-8578-1260b528b414\', \'multiverseId\': 536612}, \'multiverseid\': 536612}, {\'name\': \'조화의 의식\', \'text\': \'이 턴에 생물 또는 부여마법이 당신의 조종하에 전장에 들어올 때마다, 카드 한 장을 뽑는다.\\n회상 {2}{G}{W} (당신은 이 카드의 회상 비용을 지불해 이 카드를 당신의 무덤에서 발동할 수 있다. 그 후 이 카드를 추방한다.)\', \'type\': \'순간마법\', \'flavor\': \'마녀들이 명령하면 자연은 그에 따른다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536928&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'50ed0be5-8460-4b76-9245-c898c5404ed0\', \'multiverseId\': 536928}, \'multiverseid\': 536928}, {\'name\': \'Rito de Harmonia\', \'text\': \'Toda vez que uma criatura ou um encantamento entrar no campo de batalha sob seu controle neste turno, compre um card.\\nRecapitular {2}{G}{W} (Você pode conjurar este card de seu cemitério pagando seu custo de recapitular. Depois, exile-o.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'A natureza curva-se à vontade das bruxas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537244&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cfb54944-bdbe-40e9-a956-b6a7e2601dae\', \'multiverseId\': 537244}, \'multiverseid\': 537244}, {\'name\': \'Обряд Гармонии\', \'text\': \'Каждый раз, когда существо или чары выходят на поле битвы под вашим контролем в этом ходу, возьмите карту.\\nВоспоминание {2}{G}{W} (Вы можете разыграть эту карту из вашего кладбища за ее стоимость Воспоминания. Затем изгоните ее.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Природа подчиняется призыву ведьм.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537560&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6271d582-0800-4930-8377-3e97f25a0f3a\', \'multiverseId\': 537560}, \'multiverseid\': 537560}, {\'name\': \'和谐仪式\', \'text\': \'本回合中，每当一个生物或结界在你的操控下进战场时，抓一张牌。\\n返照{2}{G}{W}（你可以从你坟墓场中施放此牌，并支付其返照费用，然后将它放逐。）\', \'type\': \'瞬间\', \'flavor\': \'自然听从女巫号令。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537876&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'22246dd6-d0f2-4b11-a12e-0c0d35e2f428\', \'multiverseId\': 537876}, \'multiverseid\': 537876}, {\'name\': \'和諧儀式\', \'text\': \'本回合中，每當一個生物或結界在你的操控下進戰場時，抽一張牌。\\n返照{2}{G}{W}（你可以從你墳墓場中施放此牌，並支付其返照費用，然後將它放逐。）\', \'type\': \'瞬間\', \'flavor\': \'自然聽從女巫號令。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538192&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d3b0d65c-b36c-4df4-bb5a-e72069a1c960\', \'multiverseId\': 538192}, \'multiverseid\': 538192}]', '[{\'name\': \'Ritus der Harmonie\', \'text\': \'Immer wenn in diesem Zug eine Kreatur oder eine Verzauberung unter deiner Kontrolle ins Spiel kommt, ziehe eine Karte.\\nRückblende {2}{G}{W}\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538791&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2da3afef-119c-4f33-84c1-d59974f510bb\', \'multiverseId\': 538791}, \'multiverseid\': 538791}, {\'name\': \'Rito de armonía\', \'text\': \'Siempre que una criatura o encantamiento entre al campo de batalla bajo tu control este turno, roba una carta.\\nRetrospectiva {2}{G}{W}.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538851&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'50bd4630-107a-4d29-8fe2-83251a9491f7\', \'multiverseId\': 538851}, \'multiverseid\': 538851}, {\'name\': "Rite de l\'harmonie", \'text\': "À chaque fois qu\'une créature ou un enchantement arrive sur le champ de bataille sous votre contrôle ce tour-ci, piochez une carte.\\nFlashback {2}{G}{W}", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538911&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f3d22123-82aa-4a14-a43d-ca0ac510c207\', \'multiverseId\': 538911}, \'multiverseid\': 538911}, {\'name\': "Rito dell\'Armonia", \'text\': \'Ogniqualvolta una creatura o un incantesimo entra nel campo di battaglia sotto il tuo controllo in questo turno, pesca una carta.\\nFlashback {2}{G}{W}\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538971&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'512b81ab-c8ac-45a4-9ca1-7245d7dffdc2\', \'multiverseId\': 538971}, \'multiverseid\': 538971}, {\'name\': \'調和の儀式\', \'text\': \'このターン、クリーチャーやエンチャントのうち１つがあなたのコントロール下で戦場に出るたび、カード１枚を引く。\\nフラッシュバック {2}{G}{W}\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539031&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'146b7692-cb9b-4808-b155-0a2a056b8cd5\', \'multiverseId\': 539031}, \'multiverseid\': 539031}]', '[{\'name\': \'Ritus des Vergessens\', \'text\': \'Opfere eine bleibende Karte, die kein Land ist, als zusätzliche Kosten, um diesen Zauberspruch zu wirken.\\nSchicke eine bleibende Karte deiner Wahl, die kein Land ist, ins Exil.\\nRückblende {2}{W}{B} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten und zusätzliche Kosten wirken. Schicke sie danach ins Exil.)\', \'type\': \'Hexerei\', \'flavor\': \'Rache ist ein endloser Kreislauf.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535349&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'47409e2a-3f7d-4144-9131-17b81fada375\', \'multiverseId\': 535349}, \'multiverseid\': 535349}, {\'name\': \'Rito de olvido\', \'text\': \'Como coste adicional para lanzar este hechizo, sacrifica un permanente que no sea tierra.\\nExilia el permanente objetivo que no sea tierra.\\nRetrospectiva {2}{W}{B}. (Puedes lanzar esta carta desde tu cementerio pagando su coste de retrospectiva y cualquier coste adicional. Luego exíliala.)\', \'type\': \'Conjuro\', \'flavor\': \'La venganza es un ciclo interminable.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535665&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'88095d94-c5be-457a-bf87-5b9853352b5d\', \'multiverseId\': 535665}, \'multiverseid\': 535665}, {\'name\': "Rite de l\'oubli", \'text\': \'En tant que coût supplémentaire pour lancer ce sort, sacrifiez un permanent non-terrain.\\nExilez un permanent non-terrain ciblé.\\nFlashback {2}{W}{B} (Vous pouvez lancer cette carte depuis votre cimetière pour son coût de flashback et ses coûts supplémentaires. Exilez-la ensuite.)\', \'type\': \'Rituel\', \'flavor\': \'La vengeance est un cycle sans fin.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535981&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dd1b2296-2b79-4035-ab30-6a42b9580dc4\', \'multiverseId\': 535981}, \'multiverseid\': 535981}, {\'name\': "Rito dell\'Oblio", \'text\': \'Come costo addizionale per lanciare questa magia, sacrifica un permanente non terra.\\nEsilia un permanente non terra bersaglio.\\nFlashback {2}{W}{B} (Puoi lanciare questa carta dal tuo cimitero pagando il suo costo di flashback e qualsiasi costo addizionale. Poi esiliala.)\', \'type\': \'Stregoneria\', \'flavor\': \'La vendetta è un cerchio senza fine.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536297&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e1b17bbe-f226-4438-9f99-0976879477a5\', \'multiverseId\': 536297}, \'multiverseid\': 536297}, {\'name\': \'忘却の儀式\', \'text\': \'この呪文を唱えるための追加コストとして、土地でないパーマネント１つを生け贄に捧げる。\\n土地でないパーマネント１つを対象とする。それを追放する。\\nフラッシュバック{2}{W}{B}（あなたはあなたの墓地にあるこのカードを、フラッシュバック・コストと追加コストで唱えてもよい。その後、これを追放する。）\', \'type\': \'ソーサリー\', \'flavor\': \'復讐は終わりのない円環である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536613&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2cc68d19-36cb-4b55-8283-b1c46a7fc5c7\', \'multiverseId\': 536613}, \'multiverseid\': 536613}, {\'name\': \'망각의 의식\', \'text\': \'이 주문을 발동하기 위한 추가비용으로, 대지가 아닌 지속물 한 개를 희생한다.\\n대지가 아닌 지속물을 목표로 정한다. 그 지속물을 추방한다.\\n회상 {2}{W}{B} (당신은 이 카드의 회상 비용과 추가비용을 지불해 이 카드를 당신의 무덤에서 발동할 수 있다. 그 후 이 카드를 추방한다.)\', \'type\': \'집중마법\', \'flavor\': \'복수는 끝이 없는 고리와 같다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536929&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9895ffa7-fc85-402c-9323-c8e35e7425f7\', \'multiverseId\': 536929}, \'multiverseid\': 536929}, {\'name\': \'Rito do Oblívio\', \'text\': \'Como custo adicional para conjurar esta mágica, sacrifique uma permanente não de terreno.\\nExile a permanente não de terreno alvo.\\nRecapitular {2}{W}{B} (Você pode conjurar este card de seu cemitério pagando seu custo de recapitulação e quaisquer custos adicionais. Depois, exile-o.)\', \'type\': \'Feitiço\', \'flavor\': \'A vingança é um ciclo sem fim.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537245&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d3175a7f-973b-4ed2-b20d-176ee690ed90\', \'multiverseId\': 537245}, \'multiverseid\': 537245}, {\'name\': \'Обряд Забвения\', \'text\': \'В качестве дополнительной стоимости разыгрывания этого заклинания пожертвуйте не являющийся землей перманент.\\nИзгоните целевой не являющийся землей перманент.\\nВоспоминание {2}{W}{B} (Вы можете разыграть эту карту из вашего кладбища за ее стоимость Воспоминания и все дополнительные стоимости. Затем изгоните ее.)\', \'type\': \'Волшебство\', \'flavor\': \'Месть — это бесконечный круг.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537561&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'df67f633-a032-404c-8153-b36201610a80\', \'multiverseId\': 537561}, \'multiverseid\': 537561}, {\'name\': \'逐世仪式\', \'text\': \'牺牲一个非地永久物，以作为施放此咒语的额外费用。\\n放逐目标非地永久物。\\n返照{2}{W}{B}（你可以从你坟墓场中施放此牌，并支付其返照费用以及任何额外费用，然后将它放逐。）\', \'type\': \'法术\', \'flavor\': \'复仇是个没有尽头的循环。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537877&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8b415fd3-e99c-439a-b68f-05a09fd7f06f\', \'multiverseId\': 537877}, \'multiverseid\': 537877}, {\'name\': \'逐世儀式\', \'text\': \'犧牲一個非地永久物，以作為施放此咒語的額外費用。\\n放逐目標非地永久物。\\n返照{2}{W}{B}（你可以從你墳墓場中施放此牌，並支付其返照費用以及任何額外費用，然後將它放逐。）\', \'type\': \'巫術\', \'flavor\': \'復仇是個沒有盡頭的循環。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538193&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f7fb6ad8-0ce5-4556-9e26-95e3c4cfe850\', \'multiverseId\': 538193}, \'multiverseid\': 538193}]', '[{\'name\': \'Ruf der Katharer\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur hat Wachsamkeit und „Zu Beginn deines Endsegments erzeugst du einen 1/1 weißen Mensch-Kreaturenspielstein."\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Einige Katharer ergaben sich nach Avacyns Auslöschung der Verzweiflung. Die Übrigen verdoppelten ihre Anstrengungen, um ihre Arbeit fortzuführen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535081&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ac7b8102-3097-49c0-8afd-d7004a245473\', \'multiverseId\': 535081}, \'multiverseid\': 535081}, {\'name\': \'Llamada cátara\', \'text\': \'Encantar criatura.\\nLa criatura encantada tiene la habilidad de vigilancia y "Al comienzo de tu paso final, crea una ficha de criatura Humano blanca 1/1".\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'Algunos cátaros sucumbieron a la desesperación tras el fin de Avacyn. Los demás se esforzaron el doble para llevar a cabo su trabajo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535397&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8e71a2a1-3f8d-43f6-8d26-1b97dbfbda52\', \'multiverseId\': 535397}, \'multiverseid\': 535397}, {\'name\': \'Appel du cathare\', \'text\': \'Enchanter : créature\\nLa créature enchantée a la vigilance et « Au début de votre étape de fin, créez un jeton de créature 1/1 blanche Humain. »\', \'type\': \'Enchantement : aura\', \'flavor\': "Certains cathares cédèrent au désespoir après la décréation d\'Avacyn. Les autres redoublèrent d\'efforts pour mener à bien sa mission.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535713&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'82bd7e1d-d77e-4600-892d-cce33c3dc2b8\', \'multiverseId\': 535713}, \'multiverseid\': 535713}, {\'name\': \'Chiamata dei Catari\', \'text\': \'Incanta creatura\\nLa creatura incantata ha cautela e "All\\\'inizio della tua sottofase finale, crea una pedina creatura Umano 1/1 bianca".\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'Alcuni catari piombarono nella disperazione dopo la caduta di Avacyn. Altri raddoppiarono i loro sforzi per continuare a portare il suo verbo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536029&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'189bdfed-c0ff-4153-b15c-243b5a45fd99\', \'multiverseId\': 536029}, \'multiverseid\': 536029}, {\'name\': \'聖戦士の召集\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントしているクリーチャーは警戒と「あなたの終了ステップの開始時に、白の１/１の人間・クリーチャー・トークン１体を生成する。」を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'アヴァシンの破滅により絶望に屈した聖戦士もいた。残りは彼女の能事を達成するために一層尽力した。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536345&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a5551f82-4685-4177-b21b-49fbd94ed1d6\', \'multiverseId\': 536345}, \'multiverseid\': 536345}, {\'name\': \'성전사의 부름\', \'text\': \'생물에게 부여\\n부여된 생물은 경계 및 "당신의 종료단 시작에, 1/1 백색 인간 생물 토큰 한 개를 만든다."를 가진다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'몇몇 성전사들은 아바신이 파괴되자 절망에 굴복했다. 나머지는 그녀의 일을 계속해나가기 위해 몇 배로 노력했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536661&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'cd33d8b2-0f4b-4d32-9e95-f7cc918dd89e\', \'multiverseId\': 536661}, \'multiverseid\': 536661}, {\'name\': \'Chamado Cátaro\', \'text\': \'Encantar criatura\\nA criatura encantada tem vigilância e "No início de sua etapa final, crie uma ficha de criatura Humano branca 1/1."\', \'type\': \'Encantamento — Aura\', \'flavor\': \'Alguns cátaros sucumbiram ao desespero quando do desfazer de Avacyn. O restante redobrou seus esforços para dar continuidade ao trabalho dela.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536977&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'91f5e702-8d06-4b69-bbe7-a29c1278dcd7\', \'multiverseId\': 536977}, \'multiverseid\': 536977}, {\'name\': \'Зов Катара\', \'text\': \'Зачаровать существо\\nЗачарованное существо имеет Бдительность и способность «В начале вашего заключительного шага создайте одну фишку существа 1/1 белый Человек».\', \'type\': \'Чары — Аура\', \'flavor\': \'После развоплощения Авацины некоторые катары предались унынию. Другие же удвоили усилия, чтобы продолжить ее работу.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537293&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c8bf1054-cb25-4406-813f-49c6a8d7c4a9\', \'multiverseId\': 537293}, \'multiverseid\': 537293}, {\'name\': \'护教军召令\', \'text\': \'结附于生物\\n所结附的生物具有警戒与「在你的结束步骤开始时，派出一个1/1白色人类衍生生物。」\', \'type\': \'结界 ～灵气\', \'flavor\': \'艾维欣离去后，有些护教军就此深陷绝望。而有些则加倍努力完成她未竟之事。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537609&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6c96cc5c-7547-4101-aa21-405defce240f\', \'multiverseId\': 537609}, \'multiverseid\': 537609}, {\'name\': \'護教軍召令\', \'text\': \'結附於生物\\n所結附的生物具有警戒與「在你的結束步驟開始時，派出一個1/1白色人類衍生生物。」\', \'type\': \'結界 ～靈氣\', \'flavor\': \'艾維欣離去後，有些護教軍就此深陷絕望。而有些則加倍努力完成她未竟之事。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537925&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bcf7c4fe-fd8c-4174-b10c-f4963c1a364c\', \'multiverseId\': 537925}, \'multiverseid\': 537925}]', '[{\'name\': \'Rückkehr zur Natur\', \'text\': \'Bestimme eines —\\n• Zerstöre ein Artefakt deiner Wahl.\\n• Zerstöre eine Verzauberung deiner Wahl.\\n• Schicke eine Karte deiner Wahl aus einem Friedhof ins Exil.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Sogar Stahl und Stein kehren mit der Zeit zu Ghrin-Danu zurück."\\n—Katilda, Morgenlicht-Oberste\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535300&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f7e8049b-3072-48f4-b55d-a04df2fb844d\', \'multiverseId\': 535300}, \'multiverseid\': 535300}, {\'name\': \'Regreso a la naturaleza\', \'text\': \'Elige uno:\\n• Destruye el artefacto objetivo.\\n• Destruye el encantamiento objetivo.\\n• Exilia la carta objetivo de un cementerio.\', \'type\': \'Instantáneo\', \'flavor\': \'"Con el tiempo, incluso el acero y la piedra regresan a Ghrin-Danu".\\n—Katilda, Gran Cierva del Alba\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535616&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3ec8c3ad-12a2-4925-8d96-056af72a1ea8\', \'multiverseId\': 535616}, \'multiverseid\': 535616}, {\'name\': \'Regain de la nature\', \'text\': "Choisissez l\'un —\\n• Détruisez un artefact ciblé.\\n• Détruisez un enchantement ciblé.\\n• Exilez une carte ciblée depuis un cimetière.", \'type\': \'Éphémère\', \'flavor\': "« Même l\'acier et la pierre finissent par revenir à Ghrin-Danu. »\\n—Katilda, Première de Cerf-orient", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535932&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a89a1bd4-f2b0-4642-88d0-617495642feb\', \'multiverseId\': 535932}, \'multiverseid\': 535932}, {\'name\': \'Restituire alla Natura\', \'text\': \'Scegli uno —\\n• Distruggi un artefatto bersaglio.\\n• Distruggi un incantesimo bersaglio.\\n• Esilia una carta bersaglio da un cimitero.\', \'type\': \'Istantaneo\', \'flavor\': \'"Persino l\\\'acciaio e la pietra tornano a Ghrin-Danu, col tempo."\\n—Katilda, Prima Albacorno\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536248&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'59c7bc1a-9191-4407-b823-09fbb5998d8e\', \'multiverseId\': 536248}, \'multiverseid\': 536248}, {\'name\': \'自然への回帰\', \'text\': \'以下から１つを選ぶ。\\n• アーティファクト１つを対象とする。それを破壊する。\\n• エンチャント１つを対象とする。それを破壊する。\\n• 墓地にあるカード１枚を対象とする。それを追放する。\', \'type\': \'インスタント\', \'flavor\': \'「鋼や石すらも、時が経てばグリン・ダヌーのもとに還る。」\\n――ドーンハルトの主導者、カティルダ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536564&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e1104099-e93a-457b-b044-db362b803f72\', \'multiverseId\': 536564}, \'multiverseid\': 536564}, {\'name\': \'자연으로의 회귀\', \'text\': \'하나를 선택한다 —\\n• 마법물체를 목표로 정한다. 그 마법물체를 파괴한다.\\n• 부여마법을 목표로 정한다. 그 부여마법을 파괴한다.\\n• 무덤에 있는 카드를 목표로 정한다. 그 카드를 추방한다.\', \'type\': \'순간마법\', \'flavor\': \'"강철과 바위도 때가 되면 그린-다누에게로 돌아온다."\\n—새벽수사슴 지도자, 카틸다\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536880&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1514f89d-a9eb-420e-96d6-7db4996d334b\', \'multiverseId\': 536880}, \'multiverseid\': 536880}, {\'name\': \'Retorno à Natureza\', \'text\': \'Escolha um —\\n• Destrua o artefato alvo.\\n• Destrua o encantamento alvo.\\n• Exile o card alvo de um cemitério.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Até a pedra e o metal voltam a Ghrin-Danu com o tempo."\\n— Katilda, Líder Cervo da Aurora\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537196&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'711405c7-06f5-4c2a-8306-00d427961751\', \'multiverseId\': 537196}, \'multiverseid\': 537196}, {\'name\': \'Возвращение к Природе\', \'text\': \'Выберите одно —\\n• Уничтожьте целевой артефакт.\\n• Уничтожьте целевые чары.\\n• Изгоните целевую карту из кладбища.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Даже сталь и камень со временем возвращаются к богине Грин-Дану».\\n— Катильда, Первейшая Донхарта\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537512&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c2927758-9a12-4b64-9849-4ad634e642b4\', \'multiverseId\': 537512}, \'multiverseid\': 537512}, {\'name\': \'回返自然\', \'text\': \'选择一项～\\n•消灭目标神器。\\n•消灭目标结界。\\n•将目标牌从坟墓场放逐。\', \'type\': \'瞬间\', \'flavor\': \'「就算是顽石寒钢，最终也会回归吉琳达努怀抱。」\\n～曙鹿集巫首凯蒂妲\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537828&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dd30727e-a25c-4e1e-9435-980f577a5273\', \'multiverseId\': 537828}, \'multiverseid\': 537828}, {\'name\': \'回返自然\', \'text\': \'選擇一項～\\n•消滅目標神器。\\n•消滅目標結界。\\n•將目標牌從墳墓場放逐。\', \'type\': \'瞬間\', \'flavor\': \'「就算是頑石寒鋼，最終也會回歸吉琳達努懷抱。」\\n～曙鹿集巫首凱蒂妲\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538144&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'36551f7f-6b74-4871-bdb9-b43f58111855\', \'multiverseId\': 538144}, \'multiverseid\': 538144}]', '[{\'name\': \'Saryth die Viper\', \'text\': \'Andere getappte Kreaturen, die du kontrollierst, haben Todesberührung.\\nAndere ungetappte Kreaturen, die du kontrollierst, haben Fluchsicherheit.\\n{1}, {T}: Enttappe eine andere Kreatur oder ein anderes Land deiner Wahl, die bzw. das du kontrollierst.\', \'type\': \'Legendäre Kreatur — Mensch, Hexenmeister\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535302&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'97075696-95bc-4898-b8c3-84c779187c0b\', \'multiverseId\': 535302}, \'multiverseid\': 535302}, {\'name\': \'Saryth, el Colmillo de la Víbora\', \'text\': \'Las otras criaturas giradas que controlas tienen la habilidad de toque mortal.\\nLas otras criaturas enderezadas que controlas tienen la habilidad de antimaleficio.\\n{1}, {T}: Endereza otra criatura o tierra objetivo que controlas.\', \'type\': \'Criatura legendaria — Brujo humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535618&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'aa7f711f-4d40-4c9e-bd8f-192d7b27d47c\', \'multiverseId\': 535618}, \'multiverseid\': 535618}, {\'name\': \'Saryth, croc de la vipère\', \'text\': \'Les autres créatures engagées que vous contrôlez ont le contact mortel.\\nLes autres créatures dégagées que vous contrôlez ont la défense talismanique.\\n{1}, {T} : Dégagez une autre créature ciblée ou un terrain ciblé que vous contrôlez.\', \'type\': \'Créature légendaire : humain et psychagogue\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535934&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'91f15bcc-9ee2-4440-8959-c51048352be5\', \'multiverseId\': 535934}, \'multiverseid\': 535934}, {\'name\': \'Saryth, la Zanna della Vipera\', \'text\': "Le altre creature TAPpate che controlli hanno tocco letale.\\nLe altre creature STAPpate che controlli hanno anti-malocchio.\\n{1}, {T}: STAPpa un\'altra creatura o terra bersaglio che controlli.", \'type\': \'Creatura Leggendaria — Warlock Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536250&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'97c72bf0-8681-4111-975f-e915dfbc3cac\', \'multiverseId\': 536250}, \'multiverseid\': 536250}, {\'name\': \'バイパーの牙、サリス\', \'text\': \'あなたがコントロールしていてこれでなくタップ状態であるすべてのクリーチャーは接死を持つ。\\nあなたがコントロールしていてこれでなくアンタップ状態であるすべてのクリーチャーは呪禁を持つ。\\n{1}, {T}：あなたがコントロールしているクリーチャーや土地のうちこれでない１つを対象とする。それをアンタップする。\', \'type\': \'伝説のクリーチャー — 人間・邪術師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536566&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5f364d01-693e-4f7c-9d9f-273f90d3920c\', \'multiverseId\': 536566}, \'multiverseid\': 536566}, {\'name\': \'독사의 송곳니, 사리스\', \'text\': \'당신이 조종하는 다른 탭된 생물들은 치명타를 가진다.\\n당신이 조종하는 다른 언탭된 생물들은 방호를 가진다.\\n{1}, {T}: 당신이 조종하는 다른 생물 또는 대지를 목표로 정한다. 그 목표를 언탭한다.\', \'type\': \'전설적 생물 — 인간 흑마법사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536882&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'520c695f-56fc-4f59-bf94-6ee496e7d2e3\', \'multiverseId\': 536882}, \'multiverseid\': 536882}, {\'name\': \'Saryth, a Presa da Víbora\', \'text\': \'As outras criaturas viradas que você controla têm toque mortífero.\\nAs outras criaturas desviradas que você controla têm resistência a magia.\\n{1}, {T}: Desvire outra criatura ou terreno alvo que você controla.\', \'type\': \'Criatura Lendária — Humano Bruxo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537198&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cf0af6a2-d7ea-4a82-aafc-f444352503ac\', \'multiverseId\': 537198}, \'multiverseid\': 537198}, {\'name\': \'Сарит, Зуб Гадюки\', \'text\': \'Другие повернутые существа под вашим контролем имеют Смертельное касание.\\nДругие неповернутые существа под вашим контролем имеют Порчеустойчивость.\\n{1}, {T}: разверните другое целевое существо или землю под вашим контролем.\', \'type\': \'Легендарное Существо — Человек Колдун\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537514&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3b4dc6ff-52fb-4815-8dc2-f15ebce2512f\', \'multiverseId\': 537514}, \'multiverseid\': 537514}, {\'name\': \'毒蛇之牙萨黎丝\', \'text\': \'由你操控且已横置的其他生物具有死触异能。\\n由你操控且未横置的其他生物具有辟邪异能。\\n{1}，{T}：重置另一个目标由你操控的生物或地。\', \'type\': \'传奇生物 ～人类／邪术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537830&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'88f33fab-2440-4e4b-9bde-52fe2628bb77\', \'multiverseId\': 537830}, \'multiverseid\': 537830}, {\'name\': \'毒蛇之牙薩黎絲\', \'text\': \'由你操控且已橫置的其他生物具有死觸異能。\\n由你操控且未橫置的其他生物具有辟邪異能。\\n{1}，{T}：重置另一個目標由你操控的生物或地。\', \'type\': \'傳奇生物 ～人類／邪術師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538146&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9c811c7f-4c4c-4d64-ba68-0676bc80cf49\', \'multiverseId\': 538146}, \'multiverseid\': 538146}]', '[{\'name\': \'Schalter umlegen\', \'text\': \'Neutralisiere einen Zauberspruch deiner Wahl, es sei denn, sein Beherrscher bezahlt {4}. Erzeuge einen 2/2 schwarzen Zombie-Kreaturenspielstein mit Verwesung. (Er kann nicht blocken. Wenn er angreift, opfere ihn am Ende des Kampfes.)\', \'type\': \'Spontanzauber\', \'flavor\': \'„Funktioniert jedes Mal! Nun, zumindest jedes Mal, wenn sie nicht explodieren."\\n—Barton, Leichenflicker\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535131&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d3d1a7bd-b9b1-4a68-8553-3dc442acf47f\', \'multiverseId\': 535131}, \'multiverseid\': 535131}, {\'name\': \'Accionar el interruptor\', \'text\': \'Contrarresta el hechizo objetivo a menos que su controlador pague {4}. Crea una ficha de criatura Zombie negra 2/2 con la habilidad de descomposición. (No puede bloquear. Cuando ataque, sacrifícala al final del combate.)\', \'type\': \'Instantáneo\', \'flavor\': \'"¡Nunca falla! Bueno, excepto cuando explotan".\\n—Barton, suturador\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535447&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f727af1b-1782-45e7-8bb6-1730cf5b4c6a\', \'multiverseId\': 535447}, \'multiverseid\': 535447}, {\'name\': \'Déclencher la machine\', \'text\': \'Contrecarrez un sort ciblé à moins que son contrôleur ne paie {4}. Créez un jeton de créature 2/2 noire Zombie avec la décomposition. (Il ne peut pas bloquer. Quand il attaque, sacrifiez-le à la fin du combat.)\', \'type\': \'Éphémère\', \'flavor\': "« Ça marche à chaque fois ! Enfin, à chaque fois qu\'ils n\'explosent pas, en tout cas. »\\n—Barton, raccommodeur", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535763&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f7b89d07-1d6c-4a97-a68b-a484e5544f94\', \'multiverseId\': 535763}, \'multiverseid\': 535763}, {\'name\': "Premere l\'Interruttore", \'text\': \'Neutralizza una magia bersaglio a meno che il suo controllore non paghi {4}. Crea una pedina creatura Zombie 2/2 nera con decomposto. (Non può bloccare. Quando attacca, sacrificala alla fine del combattimento.)\', \'type\': \'Istantaneo\', \'flavor\': \'"Funziona ogni volta! Beh, ogni volta che non esplode, almeno."\\n—Barton, cucitore\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536079&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7baaa603-03b4-4688-ac58-66210df0e148\', \'multiverseId\': 536079}, \'multiverseid\': 536079}, {\'name\': \'回路切り替え\', \'text\': \'呪文１つを対象とする。そのコントローラーが{4}を支払わないかぎり、それを打ち消す。腐乱を持つ黒の２/２のゾンビ・クリーチャー・トークン１体を生成する。（それではブロックできない。それが攻撃したとき、戦闘終了時に、それを生け贄に捧げる。）\', \'type\': \'インスタント\', \'flavor\': \'「必ず効果があるんだ！と言っても、爆発しなければの話だが。」\\n――縫い師、バートン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536395&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0d2ce798-8079-4a76-9c2f-6373d9ffa087\', \'multiverseId\': 536395}, \'multiverseid\': 536395}, {\'name\': \'스위치 누르기\', \'text\': \'주문을 목표로 정한다. 그 주문의 조종자가 {4}를 지불하지 않는 한 그 주문을 무효화한다. 부패를 가진 2/2 흑색 좀비 생물 토큰 한 개를 만든다. (그 생물은 방어할 수 없다. 그 생물이 공격할 때, 전투종료에 그 생물을 희생한다.)\', \'type\': \'순간마법\', \'flavor\': \'"항상 효과가 있지! 뭐, 그것들이 폭발하지 않을 때는 말이야."\\n—봉합술사, 바톤\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536711&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c2ef6b2f-3532-4353-a3f5-b9028be7fb25\', \'multiverseId\': 536711}, \'multiverseid\': 536711}, {\'name\': \'Acionar o Interruptor\', \'text\': \'Anule a mágica alvo, a menos que seu controlador pague {4}. Crie uma ficha de criatura Zumbi preta 2/2 com decomposto. (Ela não pode bloquear. Quando ela atacar, sacrifique-a no final do combate.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Sempre funciona! Bom, sempre que eles não explodem, né..."\\n— Barton, suturador\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537027&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5c212d6e-96e7-44cb-a72b-25f67b4cb4e3\', \'multiverseId\': 537027}, \'multiverseid\': 537027}, {\'name\': \'Щелчок Переключателя\', \'text\': \'Отмените целевое заклинание, если только контролирующий его игрок не заплатит {4}. Создайте одну фишку существа 2/2 черный Зомби с Трупной гнилью. (Она не может блокировать. Когда она атакует, пожертвуйте ее в конце боя.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Работает каждый раз! Ну, каждый раз, когда они не взрываются...»\\n— сшиватель Бартон\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537343&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1c0a915c-b344-426b-9f47-9a58cb5ced1e\', \'multiverseId\': 537343}, \'multiverseid\': 537343}, {\'name\': \'拨动开关\', \'text\': \'除非目标咒语的操控者支付{4}，否则反击之。派出一个2/2黑色，具败朽异能的灵俑衍生生物。（它不能进行阻挡。当它攻击，在战斗结束时将它牺牲。）\', \'type\': \'瞬间\', \'flavor\': \'「每次都有用！好吧，是每次没爆炸的时候。」\\n～拼接师巴顿\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537659&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'02bcb1a3-4203-49fb-9b0d-1154117d3d02\', \'multiverseId\': 537659}, \'multiverseid\': 537659}, {\'name\': \'撥動開關\', \'text\': \'除非目標咒語的操控者支付{4}，否則反擊之。派出一個2/2黑色，具敗朽異能的殭屍衍生生物。（它不能進行阻擋。當它攻擊，在戰鬥結束時將它犧牲。）\', \'type\': \'瞬間\', \'flavor\': \'「每次都有用！好吧，是每次沒爆炸的時候。」\\n～拼接師巴頓\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537975&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0b5e65fa-c921-4021-b290-3d8d4227f7ed\', \'multiverseId\': 537975}, \'multiverseid\': 537975}]', '[{\'name\': \'Schauplatz der Verheerung\', \'text\': \'{T}: Erzeuge {C}.\\n{2}, {T}, opfere den Schauplatz der Verheerung: Zerstöre ein Nichtstandardland deiner Wahl, das ein Gegner kontrolliert. Jeder Spieler durchsucht seine Bibliothek nach einer Standardland-Karte, bringt sie ins Spiel und mischt danach.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535376&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1f3de094-721e-4b50-9e05-88c130aa21f3\', \'multiverseId\': 535376}, \'multiverseid\': 535376}, {\'name\': \'Campo de ruina\', \'text\': \'{T}: Agrega {C}.\\n{2}, {T}, sacrificar el Campo de ruina: Destruye la tierra no básica objetivo que controla un oponente. Cada jugador busca en su biblioteca una carta de tierra básica, la pone en el campo de batalla y luego baraja.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535692&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4bcd1190-381a-4a78-92ee-102370bc8e33\', \'multiverseId\': 535692}, \'multiverseid\': 535692}, {\'name\': \'Champ de ruine\', \'text\': "{T} : Ajoutez {C}.\\n{2}, {T}, sacrifiez le Champ de ruine : Détruisez un terrain non-base ciblé qu\'un adversaire contrôle. Chaque joueur cherche dans sa bibliothèque une carte de terrain de base, la met sur le champ de bataille, puis mélange.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536008&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1982af81-6e4e-46f4-abe0-f99147b6676a\', \'multiverseId\': 536008}, \'multiverseid\': 536008}, {\'name\': \'Campo della Rovina\', \'text\': \'{T}: Aggiungi {C}.\\n{2}, {T}, Sacrifica il Campo della Rovina: Distruggi una terra non base bersaglio controllata da un avversario. Ogni giocatore passa in rassegna il proprio grimorio per una carta terra base, la mette sul campo di battaglia, poi rimescola.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536324&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f0135616-eb53-4550-9adc-1ad5165e56ae\', \'multiverseId\': 536324}, \'multiverseid\': 536324}, {\'name\': \'廃墟の地\', \'text\': \'{T}：{C}を加える。\\n{2}, {T}, 廃墟の地を生け贄に捧げる：対戦相手がコントロールしていて基本でない土地１つを対象とする。それを破壊する。各プレイヤーはそれぞれ、自分のライブラリーから基本土地・カード１枚を探し、戦場に出す。その後、ライブラリーを切り直す。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536640&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a15356b7-e369-4042-bdf9-91829d845e25\', \'multiverseId\': 536640}, \'multiverseid\': 536640}, {\'name\': \'파괴의 현장\', \'text\': \'{T}: {C}를 추가한다.\\n{2}, {T}, 파괴의 현장을 희생한다: 상대가 조종하는 기본 대지가 아닌 대지를 목표로 정한다. 그 대지를 파괴한다. 각 플레이어는 자신의 서고에서 기본 대지 카드 한 장을 찾아, 전장에 놓은 후, 서고를 섞는다.\', \'type\': \'대지\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536956&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e2a6f0ae-9bea-4d1e-a03d-519e1e1a3387\', \'multiverseId\': 536956}, \'multiverseid\': 536956}, {\'name\': \'Campo da Ruína\', \'text\': \'{T}: Adicione {C}.\\n{2}, {T}, sacrifique Campo da Ruína: Destrua o terreno alvo não básico que um oponente controla. Cada jogador procura no próprio grimório um card de terreno básico, coloca-o no campo de batalha e depois embaralha.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537272&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'41b0bd3e-7945-42ee-8538-aee5700805bd\', \'multiverseId\': 537272}, \'multiverseid\': 537272}, {\'name\': \'Гибельное Поле\', \'text\': \'{T}: добавьте {C}.\\n{2}, {T}, пожертвуйте Гибельное Поле: уничтожьте целевую небазовую землю под контролем оппонента. Каждый игрок ищет в своей библиотеке карту базовой земли, кладет ее на поле битвы, затем тасует библиотеку.\', \'type\': \'Земля\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537588&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ae88ac61-ab5c-4053-8ef7-083ed104699e\', \'multiverseId\': 537588}, \'multiverseid\': 537588}, {\'name\': \'战场遗迹\', \'text\': \'{T}：加{C}。\\n{2}，{T}，牺牲战场遗迹：消灭目标由对手操控的非基本地。每位牌手各从其牌库中搜寻一张基本地牌，将之放进战场，然后洗牌。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537904&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'00c6e5e2-fdb8-42da-b15f-fc8a3165b8c4\', \'multiverseId\': 537904}, \'multiverseid\': 537904}, {\'name\': \'戰場遺跡\', \'text\': \'{T}：加{C}。\\n{2}，{T}，犧牲戰場遺跡：消滅目標由對手操控的非基本地。每位玩家各從其牌庫中搜尋一張基本地牌，將之放進戰場，然後洗牌。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538220&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0fd1bd3f-8182-4d02-ac65-7cbff275b8ef\', \'multiverseId\': 538220}, \'multiverseid\': 538220}]', '[{\'name\': \'Scheideweg-Kerzenweiser\', \'text\': \'Wenn der Scheideweg-Kerzenweiser ins Spiel kommt, schicke bis zu eine Karte deiner Wahl aus einem Friedhof ins Exil.\\n{2}: Erzeuge ein Mana einer beliebigen Farbe.\', \'type\': \'Artefaktkreatur — Vogelscheuche\', \'flavor\': \'Drehen sich die Köpfe der Kerzenweiser mit, während du vorbeigehst, oder spielt dir nur das flackernde Licht einen Streich?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535366&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'882cfcc3-f1d3-49a7-84ad-a256f1e9f7ab\', \'multiverseId\': 535366}, \'multiverseid\': 535366}, {\'name\': \'Velaguía de la encrucijada\', \'text\': \'Cuando el Velaguía de la encrucijada entre al campo de batalla, exilia hasta una carta objetivo de un cementerio.\\n{2}: Agrega un maná de cualquier color.\', \'type\': \'Criatura artefacto — Espantapájaros\', \'flavor\': \'¿Es posible que los velaguías giren la cabeza para observar a quienes pasan o es tan solo un engaño de la luz titilante?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535682&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8cb6ea01-e3c5-4227-934e-3564073e3d60\', \'multiverseId\': 535682}, \'multiverseid\': 535682}, {\'name\': \'Guide-chandelle de la croisée\', \'text\': "Quand le Guide-chandelle de la croisée arrive sur le champ de bataille, exilez jusqu\'à une carte ciblée depuis un cimetière.\\n{2} : Ajoutez un mana de la couleur de votre choix.", \'type\': \'Créature-artefact : épouvantail\', \'flavor\': "Les têtes des guide-chandelles nous suivent-elles du regard, ou n\'est-ce qu\'une illusion des lumières vacillantes ?", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535998&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5210bb2c-8385-4d64-b876-f66b589509e8\', \'multiverseId\': 535998}, \'multiverseid\': 535998}, {\'name\': \'Candeliere Guida del Crocevia\', \'text\': \'Quando il Candeliere Guida del Crocevia entra nel campo di battaglia, esilia fino a una carta bersaglio da un cimitero.\\n{2}: Aggiungi un mana di un qualsiasi colore.\', \'type\': \'Creatura Artefatto — Spaventapasseri\', \'flavor\': \'Le teste dei candelieri guida si girano davvero a guardarti quando passi o è solo il baluginio delle fiammelle?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536314&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'34b60eee-6205-452e-977e-8ee75c8659a5\', \'multiverseId\': 536314}, \'multiverseid\': 536314}, {\'name\': \'岐路の蝋燭案内\', \'text\': \'岐路の蝋燭案内が戦場に出たとき、墓地にあるカード最大１枚を対象とする。それを追放する。\\n{2}：好きな色１色のマナ１点を加える。\', \'type\': \'アーティファクト・クリーチャー — カカシ\', \'flavor\': \'通り過ぎるときに蝋燭案内の顔が我々を追っているように見えたのだが、明滅する光によるただの錯覚だろうか？\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536630&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cf894988-ec0d-4812-b6b7-35a669c7b283\', \'multiverseId\': 536630}, \'multiverseid\': 536630}, {\'name\': \'교차로 촛불안내자\', \'text\': \'교차로 촛불안내자가 전장에 들어올 때, 무덤에 있는 카드를 최대 한 장까지 목표로 정한다. 그 카드를 추방한다.\\n{2}: 원하는 색의 마나 한 개를 추가한다.\', \'type\': \'마법물체 생물 — 허수아비\', \'flavor\': \'촛불안내자가 그 앞을 지나가는 당신을 따라 고개를 돌리는 것인가, 아니면 그저 흔들리는 불빛 때문에 그렇게 보이는 것인가?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536946&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a2a14fed-b194-48a9-914e-8936ff155e97\', \'multiverseId\': 536946}, \'multiverseid\': 536946}, {\'name\': \'Vela-guia da Encruzilhada\', \'text\': \'Quando Vela-guia da Encruzilhada entrar no campo de batalha, exile até um card alvo de um cemitério.\\n{2}: Adicione um mana de qualquer cor.\', \'type\': \'Criatura Artefato — Espantalho\', \'flavor\': \'Será que as cabeças das velas-guia se viram quando você passa, ou será apenas o jogo de luzes?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537262&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2f803e87-5292-4997-aabb-aeb003326558\', \'multiverseId\': 537262}, \'multiverseid\': 537262}, {\'name\': \'Свечной Проводник Перекрестка\', \'text\': \'Когда Свечной Проводник Перекрестка выходит на поле битвы, изгоните не более одной целевой карты из кладбища.\\n{2}: добавьте одну ману любого цвета.\', \'type\': \'Артефакт Существо — Пугало\', \'flavor\': \'Головы свечных проводников и правда поворачиваются, провожая тебя взглядом, или это просто игра мерцающего света?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537578&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bbc51c1c-d23c-4474-acef-14c9a01a6ec5\', \'multiverseId\': 537578}, \'multiverseid\': 537578}, {\'name\': \'岔路烛光向导\', \'text\': \'当岔路烛光向导进战场时，将至多一张目标牌从坟墓场放逐。\\n{2}：加一点任意颜色的法术力。\', \'type\': \'神器生物 ～稻草人\', \'flavor\': \'到底是烛光向导在你经过时扭头看了你，还是仅为闪烁烛光引起的错觉？\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537894&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6fdd7324-9be6-4ebd-ac2e-d2055a7d879e\', \'multiverseId\': 537894}, \'multiverseid\': 537894}, {\'name\': \'岔路燭光嚮導\', \'text\': \'當岔路燭光嚮導進戰場時，將至多一張目標牌從墳墓場放逐。\\n{2}：加一點任意顏色的魔法力。\', \'type\': \'神器生物 ～稻草人\', \'flavor\': \'到底是燭光嚮導在你經過時扭頭看了你，還是僅為閃爍燭光引起的錯覺？\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538210&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3b7957e4-1bd5-4ee9-8f6f-018eecd6c1a3\', \'multiverseId\': 538210}, \'multiverseid\': 538210}]', '[{\'name\': \'Schicksalhafte Abwesenheit\', \'text\': \'Zerstöre eine Kreatur oder einen Planeswalker deiner Wahl. Ihr bzw. sein Beherrscher stellt Nachforschungen an. (Er erzeugt einen farblosen Hinweis-Artefaktspielstein mit „{2}, opfere dieses Artefakt: Ziehe eine Karte.")\', \'type\': \'Spontanzauber\', \'flavor\': \'Sorin witterte eine Intrige und eilte zur Ruhe-Krypta seines Großvaters. Aber jemand anders war ihm zuvorgekommen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535090&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dfaaa19c-c20a-4398-9793-984ff5c2acfd\', \'multiverseId\': 535090}, \'multiverseid\': 535090}, {\'name\': \'Ausencia fatídica\', \'text\': \'Destruye la criatura o planeswalker objetivo. Su controlador investiga. (Crea una ficha de artefacto Pista incolora con "{2}, sacrificar este artefacto: Roba una carta".)\', \'type\': \'Instantáneo\', \'flavor\': \'Sorin sospechó que había una conspiración y fue corriendo a la cripta donde descansaba su abuelo. Sin embargo, alguien había llegado antes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535406&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'00de325c-1e4b-46ce-ba6d-75908e633e96\', \'multiverseId\': 535406}, \'multiverseid\': 535406}, {\'name\': \'Absence fatidique\', \'text\': "Détruisez une cible, créature ou planeswalker. Son contrôleur enquête. (Il crée un jeton d\'artefact incolore Indice avec « {2}, sacrifiez cet artefact : Piochez une carte. »)", \'type\': \'Éphémère\', \'flavor\': "Soupçonnant un complot, Sorin se précipita dans la crypte où reposait son grand-père. Mais quelqu\'un l\'y avait précédé.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535722&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d3267cd4-f894-4489-8a7b-e067245e3814\', \'multiverseId\': 535722}, \'multiverseid\': 535722}, {\'name\': \'Assenza Fatidica\', \'text\': \'Distruggi una creatura o un planeswalker bersaglio. Il suo controllore indaga. (Crea una pedina artefatto Indizio incolore con "{2}, Sacrifica questo artefatto: Pesca una carta".)\', \'type\': \'Istantaneo\', \'flavor\': \'Temendo un complotto, Sorin corse alla cripta di suo nonno. Ma qualcuno lo aveva preceduto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536038&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'41792950-3389-45c7-b33b-0f03a8f92199\', \'multiverseId\': 536038}, \'multiverseid\': 536038}, {\'name\': \'運命的不在\', \'text\': \'クリーチャーやプレインズウォーカーのうち１体を対象とする。それを破壊する。それのコントローラーは調査を行う。（そのプレイヤーは「{2}, このアーティファクトを生け贄に捧げる：カード１枚を引く。」を持つ無色の手掛かり・アーティファクト・トークン１つを生成する。）\', \'type\': \'インスタント\', \'flavor\': \'策略を察したソリンは祖父が眠る墓へと急いだ。しかしすでに先を越されたようだった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536354&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'25d6f3a6-d825-48a6-84e9-910ef412238d\', \'multiverseId\': 536354}, \'multiverseid\': 536354}, {\'name\': \'운명적 부재\', \'text\': \'생물 또는 플레인즈워커를 목표로 정한다. 그 목표를 파괴한다. 그 목표의 조종자는 조사한다. (그 플레이어는 "{2}, 이 마법물체를 희생한다: 카드 한 장을 뽑는다."를 가진 무색 단서 마법물체 토큰 한 개를 만든다.)\', \'type\': \'순간마법\', \'flavor\': \'음모를 감지한 소린은 자신의 조부가 잠들어 있는 무덤으로 달려갔다. 하지만 누군가가 먼저 그곳을 다녀간 뒤였다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536670&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e9cb0f88-aac8-4eca-bfb9-4762f66fe1cb\', \'multiverseId\': 536670}, \'multiverseid\': 536670}, {\'name\': \'Ausência Fatídica\', \'text\': \'Destrua a criatura ou o planeswalker alvo. O controlador daquela permanente investiga. (Ele cria uma ficha de artefato Pista incolor com "{2}, sacrifique este artefato: Compre um card".)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Sentindo uma trama no ar, Sorin correu para a cripta de seu avô. Mas outro alguém havia chegado primeiro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536986&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e31d0a2f-7363-47e6-9a93-09ff714b4271\', \'multiverseId\': 536986}, \'multiverseid\': 536986}, {\'name\': \'Роковое Отсутствие\', \'text\': "Уничтожьте целевое существо или planeswalker\'а. Контролирующий его игрок использует Дознание. (Он создает одну фишку бесцветного артефакта Улика со способностью «{2}, пожертвуйте этот артефакт: возьмите карту».)", \'type\': \'Мгновенное заклинание\', \'flavor\': \'Почувствовав заговор, Сорин устремился к склепу своего деда. Но кто-то другой добрался туда раньше.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537302&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7433ebbb-fa6d-49c6-b55d-7af074cbaf3c\', \'multiverseId\': 537302}, \'multiverseid\': 537302}, {\'name\': \'命定空棺\', \'text\': \'消灭目标生物或鹏洛客。其操控者探查。（该牌手派出一个无色线索衍生神器，且具有「{2}，牺牲此神器：抓一张牌。」）\', \'type\': \'瞬间\', \'flavor\': \'索霖感觉有诈，便急忙赶往祖父安息陵墓；但已然有人捷足先登。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537618&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8a654920-a2df-4571-b458-3babbd179979\', \'multiverseId\': 537618}, \'multiverseid\': 537618}, {\'name\': \'命定空棺\', \'text\': \'消滅目標生物或鵬洛客。其操控者探查。（該玩家派出一個無色線索衍生神器，且具有「{2}，犧牲此神器：抽一張牌。」）\', \'type\': \'瞬間\', \'flavor\': \'索霖感覺有詐，便急忙趕往祖父安息陵墓；但已然有人捷足先登。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537934&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'00e61620-5e82-4f6a-901f-b7668a95accb\', \'multiverseId\': 537934}, \'multiverseid\': 537934}]', "[{'name': 'Schicksalhafte Abwesenheit', 'text': 'Zerstöre eine Kreatur oder einen Planeswalker deiner Wahl. Ihr bzw. sein Beherrscher stellt Nachforschungen an.', 'type': 'Spontanzauber', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538741&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e770695f-ba8d-404d-9705-691fb94a4298', 'multiverseId': 538741}, 'multiverseid': 538741}, {'name': 'Ausencia fatídica', 'text': 'Destruye la criatura o planeswalker objetivo. Su controlador investiga.', 'type': 'Instantáneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538801&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '30da978a-9906-4186-b000-fb895d882cb0', 'multiverseId': 538801}, 'multiverseid': 538801}, {'name': 'Absence fatidique', 'text': 'Détruisez une cible, créature ou planeswalker. Son contrôleur enquête.', 'type': 'Éphémère', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538861&type=card', 'language': 'French', 'identifiers': {'scryfallId': '3e95752c-cc16-4207-9907-73fefd0cf0e9', 'multiverseId': 538861}, 'multiverseid': 538861}, {'name': 'Assenza Fatidica', 'text': 'Distruggi una creatura o un planeswalker bersaglio. Il suo controllore indaga.', 'type': 'Istantaneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538921&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '924558aa-ce08-4826-bd58-d32f63f138a5', 'multiverseId': 538921}, 'multiverseid': 538921}, {'name': '運命的不在', 'text': 'クリーチャーやプレインズウォーカーのうち１体を対象とする。それを破壊する。それのコントローラーは調査を行う。', 'type': 'インスタント', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538981&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'e8658f79-920d-434e-81db-ad1325f3ea95', 'multiverseId': 538981}, 'multiverseid': 538981}]", '[{\'name\': \'Schiffswrack-Morast\', \'text\': \'Der Schiffswrack-Morast kommt getappt ins Spiel, es sei denn, du kontrollierst zwei oder mehr andere Länder.\\n{T}: Erzeuge {U} oder {B}.\', \'type\': \'Land\', \'flavor\': \'Die Masten verlorener Schiffe ragen aus dem Schlamm, während die Knochen ihrer Seeleute darunter verrotten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535382&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2073fe59-ce03-466d-b9de-7bf6dfb3ce8f\', \'multiverseId\': 535382}, \'multiverseid\': 535382}, {\'name\': \'Cenagal de naufragios\', \'text\': \'El Cenagal de naufragios entra al campo de batalla girado a menos que controles otras dos o más tierras.\\n{T}: Agrega {U} o {B}.\', \'type\': \'Tierra\', \'flavor\': \'Los despojos de las embarcaciones condenadas sobresalen del fango, mientras que los de los marineros se pudren más abajo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535698&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4dbbaad6-09e0-4101-94c1-237832af2e81\', \'multiverseId\': 535698}, \'multiverseid\': 535698}, {\'name\': \'Marécage aux épaves\', \'text\': \'Le Marécage aux épaves arrive sur le champ de bataille engagé à moins que vous ne contrôliez au moins deux autres terrains.\\n{T} : Ajoutez {U} ou {B}.\', \'type\': \'Terrain\', \'flavor\': \'Les carcasses de vaisseaux condamnés saillissent de la boue tandis que les ossements de leurs équipages pourrissent en dessous.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536014&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'06758b47-21f9-44d7-8b0e-7e7c6d3a1c50\', \'multiverseId\': 536014}, \'multiverseid\': 536014}, {\'name\': \'Acquitrino dei Relitti\', \'text\': "L\'Acquitrino dei Relitti entra nel campo di battaglia TAPpato a meno che tu non controlli altre due o più terre.\\n{T}: Aggiungi {U} o {B}.", \'type\': \'Terra\', \'flavor\': \'Gli scheletri delle navi sventurate affiorano dalla fanghiglia, mentre gli scheletri dei marinai marciscono al di sotto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536330&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'68ef2c82-bcdf-4cac-8950-671f5acf031f\', \'multiverseId\': 536330}, \'multiverseid\': 536330}, {\'name\': \'難破船の湿地\', \'text\': \'あなたがこれでない２つ以上の土地をコントロールしていないかぎり、難破船の湿地はタップ状態で戦場に出る。\\n{T}：{U}か{B}を加える。\', \'type\': \'土地\', \'flavor\': \'悲運な船の竜骨が泥土から突出し、その下には船員の苔むした骸骨だけが残っている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536646&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'25168b70-26be-498a-b421-7c7b61a0a305\', \'multiverseId\': 536646}, \'multiverseid\': 536646}, {\'name\': \'난파선 습지대\', \'text\': \'난파선 습지대는 당신이 다른 대지를 두 개 이상 조종하지 않는 한 탭된 채로 전장에 들어온다.\\n{T}: {U} 또는 {B}를 추가한다.\', \'type\': \'대지\', \'flavor\': \'파멸을 맞이한 배의 뼈대가 진흙 밖으로 튀어나와 있고, 배에 타고 있던 선원들의 뼈는 그 아래에서 썩어 간다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536962&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'08de8bc8-5f8b-4fc4-bbf1-38f011f0b1ef\', \'multiverseId\': 536962}, \'multiverseid\': 536962}, {\'name\': \'Charco do Naufrágio\', \'text\': \'Charco do Naufrágio entra no campo de batalha virado, a menos que você controle dois ou mais outros terrenos.\\n{T}: Adicione {U} ou {B}.\', \'type\': \'Terreno\', \'flavor\': \'As ossadas dos navios arruinados se projetam da lama, enquanto as dos marinheiros se decompõem sob ela.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537278&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9eb4dcf3-ff80-49a6-9576-cf08e7d053f7\', \'multiverseId\': 537278}, \'multiverseid\': 537278}, {\'name\': \'Трясина Кораблекрушений\', \'text\': \'Трясина Кораблекрушений выходит на поле битвы повернутой, если под вашим контролем менее двух других земель.\\n{T}: добавьте {U} или {B}.\', \'type\': \'Земля\', \'flavor\': \'Кости погибших кораблей торчат из ила, а кости их матросов плесневеют внизу.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537594&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'985bff8d-af0f-47bf-b23b-197acb03fca8\', \'multiverseId\': 537594}, \'multiverseid\': 537594}, {\'name\': \'碎船沼地\', \'text\': \'除非你操控两个或更多其他地，否则碎船沼地须横置进战场。\\n{T}：加{U}或{B}。\', \'type\': \'地\', \'flavor\': \'遭难船只船身突出淤泥，船员尸身则在底下腐烂。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537910&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7e096902-e1d4-4ca2-8cbe-ab5b7c909a3c\', \'multiverseId\': 537910}, \'multiverseid\': 537910}, {\'name\': \'碎船沼地\', \'text\': \'除非你操控兩個或更多其他地，否則碎船沼地須橫置進戰場。\\n{T}：加{U}或{B}。\', \'type\': \'地\', \'flavor\': \'遭難船隻船身突出淤泥，船員屍身則在底下腐爛。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538226&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fdac2f1f-924a-423d-a1ea-ff6d5d772a73\', \'multiverseId\': 538226}, \'multiverseid\': 538226}]', '[{\'name\': \'Schiffswrack-Morast\', \'text\': \'Der Schiffswrack-Morast kommt getappt ins Spiel, es sei denn, du kontrollierst zwei oder mehr andere Länder.\\n{T}: Erzeuge {U} oder {B}.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538445&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d3420fe6-a806-41ba-b87a-3108f1aa9b56\', \'multiverseId\': 538445}, \'multiverseid\': 538445}, {\'name\': \'Cenagal de naufragios\', \'text\': \'El Cenagal de naufragios entra al campo de batalla girado a menos que controles otras dos o más tierras.\\n{T}: Agrega {U} o {B}.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538450&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8c71b6da-0783-4cf7-9370-d0c3b36057ec\', \'multiverseId\': 538450}, \'multiverseid\': 538450}, {\'name\': \'Marécage aux épaves\', \'text\': \'Le Marécage aux épaves arrive sur le champ de bataille engagé à moins que vous ne contrôliez au moins deux autres terrains.\\n{T} : Ajoutez {U} ou {B}.\', \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538455&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'51bda7e3-5260-4507-8dbf-f5fdd7025ecb\', \'multiverseId\': 538455}, \'multiverseid\': 538455}, {\'name\': \'Acquitrino dei Relitti\', \'text\': "L\'Acquitrino dei Relitti entra nel campo di battaglia TAPpato a meno che tu non controlli altre due o più terre.\\n{T}: Aggiungi {U} o {B}.", \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538460&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'08a42a2e-018e-45e8-a083-fc8eb089ca42\', \'multiverseId\': 538460}, \'multiverseid\': 538460}, {\'name\': \'難破船の湿地\', \'text\': \'あなたがこれでない２つ以上の土地をコントロールしていないかぎり、難破船の湿地はタップ状態で戦場に出る。\\n{T}：{U}か{B}を加える。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538465&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3ab1f0d9-a6b6-4af0-a5b3-dcce19374b95\', \'multiverseId\': 538465}, \'multiverseid\': 538465}, {\'name\': \'난파선 습지대\', \'text\': \'난파선 습지대는 당신이 다른 대지를 두 개 이상 조종하지 않는 한 탭된 채로 전장에 들어온다.\\n{T}: {U} 또는 {B}를 추가한다.\', \'type\': \'대지\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538470&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ebce3278-ca66-4fd5-9376-5146909cd49a\', \'multiverseId\': 538470}, \'multiverseid\': 538470}, {\'name\': \'Charco do Naufrágio\', \'text\': \'Charco do Naufrágio entra no campo de batalha virado, a menos que você controle dois ou mais outros terrenos.\\n{T}: Adicione {U} ou {B}.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538475&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a9c250d1-9ff7-45fb-a13a-82adf6b4a4ec\', \'multiverseId\': 538475}, \'multiverseid\': 538475}, {\'name\': \'Трясина Кораблекрушений\', \'text\': \'Трясина Кораблекрушений выходит на поле битвы повернутой, если под вашим контролем менее двух других земель.\\n{T}: добавьте {U} или {B}.\', \'type\': \'Земля\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538480&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'112b732a-5101-4478-81d4-b7e8f3274878\', \'multiverseId\': 538480}, \'multiverseid\': 538480}, {\'name\': \'碎船沼地\', \'text\': \'除非你操控两个或更多其他地，否则碎船沼地须横置进战场。\\n{T}：加{U}或{B}。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538485&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'591ff848-fa28-4eb0-8fdf-82b29df7451d\', \'multiverseId\': 538485}, \'multiverseid\': 538485}, {\'name\': \'碎船沼地\', \'text\': \'除非你操控兩個或更多其他地，否則碎船沼地須橫置進戰場。\\n{T}：加{U}或{B}。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538490&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a10c5b03-884b-4f1c-b66e-6432a2ffecb1\', \'multiverseId\': 538490}, \'multiverseid\': 538490}]', '[{\'name\': \'Schiffswrack-Sichter\', \'text\': \'Wenn die Schiffswrack-Sichter ins Spiel kommen, ziehe eine Karte und wirf dann eine Karte ab.\\nImmer wenn du eine Geist-Karte oder eine Karte mit Aufstören abwirfst, lege eine +1/+1-Marke auf die Schiffswrack-Sichter.\', \'type\': \'Kreatur — Geist\', \'flavor\': \'Eine loyale Mannschaft hält sogar nach dem Tod zusammen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535156&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d5f3a04c-6de4-47cf-b346-063c0d20e3d8\', \'multiverseId\': 535156}, \'multiverseid\': 535156}, {\'name\': \'Cernedores de naufragio\', \'text\': \'Cuando los Cernedores de naufragio entren al campo de batalla, roba una carta, luego descarta una carta.\\nSiempre que descartes una carta de Espíritu o una carta con la habilidad de perturbar, pon un contador +1/+1 sobre los Cernedores de naufragio.\', \'type\': \'Criatura — Espíritu\', \'flavor\': \'Una tripulación leal siempre permanece unida, incluso tras la muerte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535472&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'efd09790-67d8-420f-95c5-0589e604fb30\', \'multiverseId\': 535472}, \'multiverseid\': 535472}, {\'name\': \'Épurateurs des épaves\', \'text\': "Quand les Épurateurs des épaves arrivent sur le champ de bataille, piochez une carte, puis défaussez-vous d\'une carte.\\nÀ chaque fois que vous vous défaussez d\'une carte d\'esprit ou d\'une carte avec la perturbation, mettez un marqueur +1/+1 sur les Épurateurs des épaves.", \'type\': \'Créature : esprit\', \'flavor\': \'Un équipage loyal reste soudé, même après la mort.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535788&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fb21951e-96ea-4349-ac1b-93055de9b202\', \'multiverseId\': 535788}, \'multiverseid\': 535788}, {\'name\': \'Setacciatori dei Relitti\', \'text\': \'Quando i Setacciatori dei Relitti entrano nel campo di battaglia, pesca una carta, poi scarta una carta.\\nOgniqualvolta scarti una carta Spirito o una carta con disturbare, metti un segnalino +1/+1 sui Setacciatori dei Relitti.\', \'type\': \'Creatura — Spirito\', \'flavor\': \'Una ciurma leale non si separa mai, neanche dopo la morte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536104&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'29bf39ec-6ff9-49ba-8284-42f71d760935\', \'multiverseId\': 536104}, \'multiverseid\': 536104}, {\'name\': \'難破船の選別者\', \'text\': \'難破船の選別者が戦場に出たとき、カード１枚を引き、その後カード１枚を捨てる。\\nあなたがスピリット・カードや降霊を持つカード１枚を捨てるたび、難破船の選別者の上に＋１/＋１カウンター１個を置く。\', \'type\': \'クリーチャー — スピリット\', \'flavor\': \'忠実な船員は死後も団結するのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536420&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0547c2f0-190d-4890-8c9b-aa44f1ef6aa4\', \'multiverseId\': 536420}, \'multiverseid\': 536420}, {\'name\': \'난파선 조사꾼\', \'text\': \'난파선 조사꾼이 전장에 들어올 때, 카드 한 장을 뽑은 후, 카드 한 장을 버린다.\\n당신이 신령 카드 또는 소란을 가진 카드를 버릴 때마다, 난파선 조사꾼에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 신령\', \'flavor\': \'충직한 선원들은 죽은 뒤에도 함께 뭉친다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536736&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3b482d16-c8af-46f2-983d-4eaea32bdf52\', \'multiverseId\': 536736}, \'multiverseid\': 536736}, {\'name\': \'Vasculhadores de Naufrágios\', \'text\': \'Quando Vasculhadores de Naufrágios entrar no campo de batalha, compre um card e depois descarte um card.\\nToda vez que você descartar um card de Espírito ou um card com perturbar, coloque um marcador +1/+1 em Vasculhadores de Naufrágios.\', \'type\': \'Criatura — Espírito\', \'flavor\': \'Uma tripulação leal permanece unida mesmo depois da morte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537052&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ac390762-4a79-4ae4-9e52-415bc79e6443\', \'multiverseId\': 537052}, \'multiverseid\': 537052}, {\'name\': \'Просеиватели Кораблекрушений\', \'text\': \'Когда Просеиватели Кораблекрушений выходят на поле битвы, возьмите карту, затем сбросьте карту.\\nКаждый раз, когда вы сбрасываете карту Духа или карту с Разупокоением, положите один жетон +1/+1 на Просеивателей Кораблекрушений.\', \'type\': \'Существо — Дух\', \'flavor\': \'Верная команда держится вместе даже после смерти.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537368&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7290cf47-dbff-4a14-8745-a3db2b13896b\', \'multiverseId\': 537368}, \'multiverseid\': 537368}, {\'name\': \'船难筛寻灵\', \'text\': \'当船难筛寻灵进战场时，抓一张牌，然后弃一张牌。\\n每当你弃一张精怪牌或一张具惊扰异能的牌时，在船难筛寻灵上放置一个+1/+1指示物。\', \'type\': \'生物 ～精怪\', \'flavor\': \'忠心水手始终相伴，死后亦然。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537684&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a56d9437-bff4-4d0d-b5b5-65a3cd4f5695\', \'multiverseId\': 537684}, \'multiverseid\': 537684}, {\'name\': \'船難篩尋靈\', \'text\': \'當船難篩尋靈進戰場時，抽一張牌，然後棄一張牌。\\n每當你棄一張精靈牌或一張具驚擾異能的牌時，在船難篩尋靈上放置一個+1/+1指示物。\', \'type\': \'生物 ～精靈\', \'flavor\': \'忠心水手始終相伴，死後亦然。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538000&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fda77a4c-771e-4051-8b80-ea108748b68b\', \'multiverseId\': 538000}, \'multiverseid\': 538000}]', '[{\'name\': \'Schlingwurzelkriecher\', \'text\': \'{T}: Erzeuge ein Mana einer beliebigen Farbe.\\n{T}: Erzeuge zwei Mana genau einer beliebigen Farbe. Verwende dieses Mana nur, um Zaubersprüche aus deinem Friedhof zu wirken.\\n{G}{U}, {T}, schicke den Schlingwurzelkriecher ins Exil: Bringe eine Karte deiner Wahl mit Rückblende, die du besitzt, aus dem Exil auf deine Hand zurück.\', \'type\': \'Kreatur — Pflanze, Schrecken\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535350&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f0468de5-4b60-4d60-8834-941982ca5f48\', \'multiverseId\': 535350}, \'multiverseid\': 535350}, {\'name\': \'Enredadera raizespiral\', \'text\': \'{T}: Agrega un maná de cualquier color.\\n{T}: Agrega dos manás de un color cualquiera. Usa este maná solo para lanzar hechizos desde tu cementerio.\\n{G}{U}, {T}, exiliar la Enredadera raizespiral: Regresa del exilio a tu mano la carta objetivo con la habilidad de retrospectiva de la cual eres propietario.\', \'type\': \'Criatura — Horror planta\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535666&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'26a9dd6b-a270-4080-81bb-e6f09c15ac80\', \'multiverseId\': 535666}, \'multiverseid\': 535666}, {\'name\': \'Fureteur spiracine\', \'text\': "{T} : Ajoutez un mana de la couleur de votre choix.\\n{T} : Ajoutez deux manas d\'une seule couleur de votre choix. Ne dépensez ce mana que pour lancer des sorts depuis votre cimetière.\\n{G}{U}, {T}, exilez le Fureteur spiracine : Renvoyez une carte avec le flashback ciblée que vous possédez depuis l\'exil dans votre main.", \'type\': \'Créature : plante et horreur\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535982&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a5f6d218-35ef-465c-9e92-e5c7ac50b03b\', \'multiverseId\': 535982}, \'multiverseid\': 535982}, {\'name\': \'Rampicante di Viteradice\', \'text\': "{T}: Aggiungi un mana di un qualsiasi colore.\\n{T}: Aggiungi due mana di un qualsiasi colore. Spendi questo mana solo per lanciare magie dal tuo cimitero.\\n{G}{U}, {T}, Esilia il Rampicante di Viteradice: Riprendi in mano dall\'esilio una carta bersaglio con flashback che possiedi.", \'type\': \'Creatura — Orrore Pianta\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536298&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cbd17d0b-e6b0-42d2-aa50-cd52bf2c0f6a\', \'multiverseId\': 536298}, \'multiverseid\': 536298}, {\'name\': \'根のとぐろの忍び寄るもの\', \'text\': \'{T}：好きな色１色のマナ１点を加える。\\n{T}：好きな色１色のマナ２点を加える。このマナは、あなたの墓地から呪文を唱えるためにのみ使用できる。\\n{G}{U}, {T}, 根のとぐろの忍び寄るものを追放する：追放領域にありあなたがオーナーでフラッシュバックを持つカード１枚を対象とする。それをあなたの手札に戻す。\', \'type\': \'クリーチャー — 植物・ホラー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536614&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'84490779-c00f-4f52-8401-556ec5ece939\', \'multiverseId\': 536614}, \'multiverseid\': 536614}, {\'name\': \'뿌리고리 어기적괴수\', \'text\': \'{T}: 원하는 색의 마나 한 개를 추가한다.\\n{T}: 원하는 한 가지 색 마나 두 개를 추가한다. 이 마나는 당신의 무덤에서 주문을 발동하는 데에만 사용할 수 있다.\\n{G}{U}, {T}, 뿌리고리 어기적괴수를 추방한다: 추방 영역에 있는 당신이 소유한 회상을 가진 카드를 목표로 정한다. 그 카드를 당신의 손으로 되돌린다.\', \'type\': \'생물 — 식물 괴수\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536930&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'cd458022-bf3e-461e-a9bf-4198ac258f46\', \'multiverseId\': 536930}, \'multiverseid\': 536930}, {\'name\': \'Trepadeira Raizespiral\', \'text\': \'{T}: Adicione um mana de qualquer cor.\\n{T}: Adicione dois manas de uma cor à sua escolha. Gaste este mana somente para conjurar mágicas de seu cemitério.\\n{G}{U}, {T}, exile Trepadeira Raizespiral: Devolva o card alvo com recapitular que você possui do exílio para sua mão.\', \'type\': \'Criatura — Planta Horror\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537246&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bf6b4b46-4274-446c-a947-075d42675052\', \'multiverseId\': 537246}, \'multiverseid\': 537246}, {\'name\': \'Плетеный из Корней Ползун\', \'text\': \'{T}: добавьте одну ману любого цвета.\\n{T}: добавьте две маны любого одного цвета. Тратьте эту ману только на разыгрывание заклинаний из вашего кладбища.\\n{G}{U}, {T}, изгоните Плетеного из Корней Ползуна: верните принадлежащую вам целевую карту с Воспоминанием из изгнания в вашу руку.\', \'type\': \'Существо — Растение Ужас\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537562&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2106cc7e-cfed-460c-bddd-a8071448cfb8\', \'multiverseId\': 537562}, \'multiverseid\': 537562}, {\'name\': \'缠根匐行怪\', \'text\': \'{T}：加一点任意颜色的法术力。\\n{T}：加两点任意颜色的单色法术力。此法术力只能用来从你坟墓场中施放咒语。\\n{G}{U}，{T}，放逐缠根匐行怪：将目标由你拥有且具返照异能的牌从放逐区移回你手上。\', \'type\': \'生物 ～植物／惊惧兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537878&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b0103325-080f-4c35-9c39-e8760f1f4659\', \'multiverseId\': 537878}, \'multiverseid\': 537878}, {\'name\': \'纏根匐行怪\', \'text\': \'{T}：加一點任意顏色的魔法力。\\n{T}：加兩點任意顏色的單色魔法力。此魔法力只能用來從你墳墓場中施放咒語。\\n{G}{U}，{T}，放逐纏根匐行怪：將目標由你擁有且具返照異能的牌從放逐區移回你手上。\', \'type\': \'生物 ～植物／驚懼獸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538194&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9c6d99de-c2c9-404a-ab3d-81a29363f250\', \'multiverseId\': 538194}, \'multiverseid\': 538194}]', '[{\'name\': \'Schlüssel aus Mondsilber\', \'text\': \'{1}, {T}, opfere den Schlüssel aus Mondsilber: Durchsuche deine Bibliothek nach einer Artefaktkarte mit einer Manafähigkeit oder einer Standardland-Karte, zeige sie offen vor, nimm sie auf deine Hand und mische danach.\', \'type\': \'Artefakt\', \'flavor\': \'Um das Gleichgewicht von Tag und Nacht wiederherzustellen, muss das Sonnengold-Schloss des Celestus-Mechanismus wieder mit seinem lange verlorenen Schlüssel vereint werden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535368&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'24ac2597-4345-46e1-b9a0-b6b1b643ab11\', \'multiverseId\': 535368}, \'multiverseid\': 535368}, {\'name\': \'Llave de platalunar\', \'text\': \'{1}, {T}, sacrificar la Llave de platalunar: Busca en tu biblioteca una carta de artefacto con una habilidad de maná o una carta de tierra básica, muéstrala, ponla en tu mano y luego baraja.\', \'type\': \'Artefacto\', \'flavor\': \'La cerradura de orosolar del mecanismo Celestus debe reunirse con su llave perdida para restaurar el equilibrio entre el día y la noche.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535684&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c5f6ea73-18c4-42e8-a1f5-d74367b545e6\', \'multiverseId\': 535684}, \'multiverseid\': 535684}, {\'name\': "Clé d\'argent de lune", \'text\': "{1}, {T}, sacrifiez la Clé d\'argent de lune : Cherchez dans votre bibliothèque une carte d\'artefact avec une capacité de mana ou une carte de terrain de base, révélez-la, mettez-la dans votre main, puis mélangez.", \'type\': \'Artefact\', \'flavor\': "Pour restaurer l\'équilibre entre le jour et la nuit, la Serrure d\'or solaire du Celestus devait être réunie avec sa clé disparue.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536000&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8bfa6479-6e2a-42ee-87d5-e88222eb6cc0\', \'multiverseId\': 536000}, \'multiverseid\': 536000}, {\'name\': \'Chiave di Selenargento\', \'text\': "{1}, {T}, Sacrifica la Chiave di Selenargento: Passa in rassegna il tuo grimorio per una carta artefatto con un\'abilità di mana o una carta terra base, rivelala e aggiungila alla tua mano, poi rimescola.", \'type\': \'Artefatto\', \'flavor\': "Per ripristinare l\'equilibrio del giorno e della notte, la Serratura di Eliodoro del meccanismo del Celestus deve essere ricongiunta alla sua perduta chiave.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536316&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bb4a29c6-11bb-40cf-839b-d44eadf1e9cc\', \'multiverseId\': 536316}, \'multiverseid\': 536316}, {\'name\': \'月銀の鍵\', \'text\': \'{1}, {T}, 月銀の鍵を生け贄に捧げる：あなたのライブラリーからマナ能力を持つアーティファクト・カードや基本土地・カードのうち１枚を探し、公開し、あなたの手札に加える。その後、ライブラリーを切り直す。\', \'type\': \'アーティファクト\', \'flavor\': \'昼と夜の均衡を取り戻すためには、セレスタスの装置の日金の錠に長きに渡り失われた鍵が挿さらなければならない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536632&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1f8a7f9d-30c5-4669-9b44-cdd4bc970c9d\', \'multiverseId\': 536632}, \'multiverseid\': 536632}, {\'name\': \'은달빛 열쇠\', \'text\': \'{1}, {T}, 은달빛 열쇠를 희생한다: 당신의 서고에서 마나 능력을 가진 마법물체 카드 또는 기본 대지 카드를 찾아, 그 카드를 공개하고, 당신의 손에 넣은 후, 서고를 섞는다.\', \'type\': \'마법물체\', \'flavor\': \'낮과 밤의 균형을 회복하려면, 셀레스투스 기관에 있는 태양황금 자물쇠가 행방을 알 수 없게 된 지 오래인 열쇠와 다시 결합되어야만 한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536948&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b71eb1db-f92b-4d1b-b604-fe6bb5ffb0a6\', \'multiverseId\': 536948}, \'multiverseid\': 536948}, {\'name\': \'Chave de Prata Lunar\', \'text\': \'{1}, {T}, sacrifique Chave de Prata Lunar: Procure em seu grimório um card de artefato com uma habilidade de mana ou um card de terreno básico, revele-o, coloque-o em sua mão e depois embaralhe.\', \'type\': \'Artefato\', \'flavor\': \'Para restaurar o equilíbrio entre a noite e o dia, a Fechadura de Ouro Solar do Celestus precisa ser reunida com sua chave há muito perdida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537264&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'474a1e91-bfcd-4a96-bb0b-8c9dd02672b7\', \'multiverseId\': 537264}, \'multiverseid\': 537264}, {\'name\': \'Ключ Лунного Серебра\', \'text\': \'{1}, {T}, пожертвуйте Ключ Лунного Серебра: найдите в вашей библиотеке карту артефакта с мана-способностью или карту базовой земли, покажите ее, положите ее в вашу руку, затем перетасуйте библиотеку.\', \'type\': \'Артефакт\', \'flavor\': \'Чтобы восстановился баланс дня и ночи, Замок солнечного золота в механизме Целестуса должен воссоединиться с давно потерянным ключом.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537580&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0afcfc43-c0af-442f-8fde-ea27280914a6\', \'multiverseId\': 537580}, \'multiverseid\': 537580}, {\'name\': \'月银钥\', \'text\': \'{1}，{T}，牺牲月银钥：从你牌库中搜寻一张具法术力异能的神器牌或一张基本地牌，展示该牌，将它置于你手上，然后洗牌。\', \'type\': \'神器\', \'flavor\': \'要恢复日夜平衡，就必须用遗失已久的钥匙去打开穹天仪的核心机关～旭金锁。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537896&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4f50c9b1-56bd-4128-af74-ecdfcac3b44b\', \'multiverseId\': 537896}, \'multiverseid\': 537896}, {\'name\': \'月銀鑰\', \'text\': \'{1}，{T}，犧牲月銀鑰：從你牌庫中搜尋一張具魔法力異能的神器牌或一張基本地牌，展示該牌，將它置於你手上，然後洗牌。\', \'type\': \'神器\', \'flavor\': \'要恢復日夜平衡，就必須用遺失已久的鑰匙去打開穹天儀的核心機關～旭金鎖。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538212&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1cd2ea43-d74b-467a-8588-0332ce907c4e\', \'multiverseId\': 538212}, \'multiverseid\': 538212}]', '[{\'name\': \'Schreckensrudel-Raserei\', \'text\': \'Zerstöre ein Artefakt, eine Verzauberung oder ein Land deiner Wahl. Falls auf diese Weise ein Land zerstört wurde, kann sein Beherrscher seine Bibliothek nach bis zu zwei Standardland-Karten durchsuchen, sie getappt ins Spiel bringen und danach mischen. Anderenfalls kann er seine Bibliothek nach einer Standardland-Karte durchsuchen, sie getappt ins Spiel bringen und danach mischen.\\nRückblende {3}{R}{G}\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535329&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'daf28007-86f4-4307-8611-399bd9e293e8\', \'multiverseId\': 535329}, \'multiverseid\': 535329}, {\'name\': \'Estrago de Castanefasta\', \'text\': \'Destruye el artefacto, encantamiento o tierra objetivo. Si una tierra fue destruida de esta manera, su controlador puede buscar en su biblioteca hasta dos cartas de tierra básica, ponerlas en el campo de batalla giradas y luego barajar. De lo contrario, su controlador puede buscar en su biblioteca una carta de tierra básica, ponerla en el campo de batalla girada y luego barajar.\\nRetrospectiva {3}{R}{G}.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535645&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9f795085-62e6-42b4-ac91-262f15877a9f\', \'multiverseId\': 535645}, \'multiverseid\': 535645}, {\'name\': \'Sauvagerie de Noiresouche\', \'text\': "Détruisez un artefact ciblé, un enchantement ciblé ou un terrain ciblé. Si un terrain a été détruit de cette manière, son contrôleur peut chercher dans sa bibliothèque jusqu\'à deux cartes de terrain de base, les mettre sur le champ de bataille engagées, puis mélanger. Sinon, son contrôleur peut chercher dans sa bibliothèque une carte de terrain de base, la mettre sur le champ de bataille engagée, puis mélanger.\\nFlashback {3}{R}{G}", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535961&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'679e8c3b-e875-4f10-a22c-c066ac499b02\', \'multiverseId\': 535961}, \'multiverseid\': 535961}, {\'name\': \'Furia della Stirpe Funesta\', \'text\': \'Distruggi un artefatto, un incantesimo o una terra bersaglio. Se una terra è stata distrutta in questo modo, il suo controllore può passare in rassegna il proprio grimorio per trovare fino a due carte terra base, metterle sul campo di battaglia TAPpate, poi rimescolare. Altrimenti, il suo controllore può passare in rassegna il proprio grimorio per una carta terra base, metterla sul campo di battaglia TAPpata, poi rimescolare.\\nFlashback {3}{R}{G}\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536277&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3148fc88-d092-4a29-81a0-e23839d6a523\', \'multiverseId\': 536277}, \'multiverseid\': 536277}, {\'name\': \'凶兆の血の暴行\', \'text\': \'アーティファクトやエンチャントや土地のうち１つを対象とする。それを破壊する。これにより土地が破壊されたなら、それのコントローラーは「自分のライブラリーから基本土地・カード最大２枚を探し、タップ状態で戦場に出す。その後、ライブラリーを切り直す。」を選んでもよい。そうでないなら、それのコントローラーは「自分のライブラリーから基本土地・カード１枚を探し、タップ状態で戦場に出す。その後、ライブラリーを切り直す。」を選んでもよい。\\nフラッシュバック{3}{R}{G}\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536593&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e01d18c9-6e16-40d9-9b27-5f6654671307\', \'multiverseId\': 536593}, \'multiverseid\': 536593}, {\'name\': \'끔찍한 혈통의 광란\', \'text\': \'마법물체, 부여마법 또는 대지를 목표로 정한다. 그 목표를 파괴한다. 이런 식으로 대지가 파괴되었다면, 그 대지의 조종자는 자신의 서고에서 기본 대지 카드를 최대 두 장까지 찾아, 그 카드들을 탭된 채로 전장에 놓을 수 있다. 그렇게 한다면, 그 플레이어는 서고를 섞는다. 그렇지 않다면, 그 지속물의 조종자는 자신의 서고에서 기본 대지 카드를 찾아, 탭된 채로 전장에 놓을 수 있다. 그렇게 한다면, 그 플레이어는 서고를 섞는다.\\n회상 {3}{R}{G}\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536909&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a1953417-9238-4214-b8c7-e1e3284054a3\', \'multiverseId\': 536909}, \'multiverseid\': 536909}, {\'name\': \'Fúria da Linhagem Macabra\', \'text\': \'Destrua o artefato, encantamento ou terreno alvo. Se um terreno foi destruído dessa forma, seu controlador pode procurar no próprio grimório até dois cards de terreno básico, colocá-los no campo de batalha virados e depois embaralhar. Caso contrário, o controlador da permanente pode procurar no próprio grimório um card de terreno básico, colocá-lo no campo de batalha virado e depois embaralhar.\\nRecapitular {3}{R}{G}\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537225&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e95d905f-0879-4f01-8467-1801410bfd8e\', \'multiverseId\': 537225}, \'multiverseid\': 537225}, {\'name\': \'Буйство Лютого Рода\', \'text\': \'Уничтожьте целевой артефакт, чары или землю. Если таким образом была уничтожена земля, контролирующий ее игрок может найти в своей библиотеке не более двух карт базовых земель, положить их на поле битвы повернутыми, затем перетасовать библиотеку. В противном случае контролирующий тот перманент игрок может найти в своей библиотеке карту базовой земли, положить ее на поле битвы повернутой, затем перетасовать библиотеку.\\nВоспоминание {3}{R}{G}\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537541&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d7270a98-03ab-4b77-abc6-ead4c61e7b15\', \'multiverseId\': 537541}, \'multiverseid\': 537541}, {\'name\': \'怖狼脉狂愤\', \'text\': \'消灭目标神器，结界或地。如果以此法消灭一个地，则其操控者可以从其牌库中搜寻至多两张基本地牌，将它们横置放进战场，然后洗牌。若否，则其操控者可以从其牌库中搜寻一张基本地牌，将之横置放进战场，然后洗牌。\\n返照{3}{R}{G}\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537857&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0d78908d-1544-4ece-88e0-cab612b026f5\', \'multiverseId\': 537857}, \'multiverseid\': 537857}, {\'name\': \'怖狼脈狂憤\', \'text\': \'消滅目標神器，結界或地。如果以此法消滅一個地，則其操控者可以從其牌庫中搜尋至多兩張基本地牌，將它們橫置放進戰場，然後洗牌。若否，則其操控者可以從其牌庫中搜尋一張基本地牌，將之橫置放進戰場，然後洗牌。\\n返照{3}{R}{G}\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538173&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'05b4922c-ce34-4313-be9c-1fab55d15a5e\', \'multiverseId\': 538173}, \'multiverseid\': 538173}]', '[{\'name\': \'Schreckensrudel-Raserei\', \'text\': \'Zerstöre ein Artefakt, eine Verzauberung oder ein Land deiner Wahl. Falls auf diese Weise ein Land zerstört wurde, kann sein Beherrscher seine Bibliothek nach bis zu zwei Standardland-Karten durchsuchen, sie getappt ins Spiel bringen und danach mischen. Anderenfalls kann er seine Bibliothek nach einer Standardland-Karte durchsuchen, sie getappt ins Spiel bringen und danach mischen.\\nRückblende {3}{R}{G}\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538787&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'67fb9678-637e-409b-bb51-1885da1595b4\', \'multiverseId\': 538787}, \'multiverseid\': 538787}, {\'name\': \'Estrago de Castanefasta\', \'text\': \'Destruye el artefacto, encantamiento o tierra objetivo. Si una tierra fue destruida de esta manera, su controlador puede buscar en su biblioteca hasta dos cartas de tierra básica, ponerlas en el campo de batalla giradas y luego barajar. De lo contrario, su controlador puede buscar en su biblioteca una carta de tierra básica, ponerla en el campo de batalla girada y luego barajar.\\nRetrospectiva {3}{R}{G}.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538847&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cd229575-232f-4bd3-9b73-e4f75eb191f1\', \'multiverseId\': 538847}, \'multiverseid\': 538847}, {\'name\': \'Sauvagerie de Noiresouche\', \'text\': "Détruisez un artefact ciblé, un enchantement ciblé ou un terrain ciblé. Si un terrain a été détruit de cette manière, son contrôleur peut chercher dans sa bibliothèque jusqu\'à deux cartes de terrain de base, les mettre sur le champ de bataille engagées, puis mélanger. Sinon, son contrôleur peut chercher dans sa bibliothèque une carte de terrain de base, la mettre sur le champ de bataille engagée, puis mélanger.\\nFlashback {3}{R}{G}", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538907&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4e0ffdd8-f341-4196-a4bb-fb8a41b0c517\', \'multiverseId\': 538907}, \'multiverseid\': 538907}, {\'name\': \'Furia della Stirpe Funesta\', \'text\': \'Distruggi un artefatto, un incantesimo o una terra bersaglio. Se una terra è stata distrutta in questo modo, il suo controllore può passare in rassegna il proprio grimorio per trovare fino a due carte terra base, metterle sul campo di battaglia TAPpate, poi rimescolare. Altrimenti, il suo controllore può passare in rassegna il proprio grimorio per una carta terra base, metterla sul campo di battaglia TAPpata, poi rimescolare.\\nFlashback {3}{R}{G}\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538967&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'42e90367-3bd4-4528-ad67-b36de020e2c9\', \'multiverseId\': 538967}, \'multiverseid\': 538967}, {\'name\': \'凶兆の血の暴行\', \'text\': \'アーティファクトやエンチャントや土地のうち１つを対象とする。それを破壊する。これにより土地が破壊されたなら、それのコントローラーは「自分のライブラリーから基本土地・カード最大２枚を探し、タップ状態で戦場に出す。その後、ライブラリーを切り直す。」を選んでもよい。土地が破壊されなかったなら、それのコントローラーは「自分のライブラリーから基本土地・カード１枚を探し、タップ状態で戦場に出す。その後、ライブラリーを切り直す。」を選んでもよい。\\nフラッシュバック{3}{R}{G}\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539027&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c7dbb6fb-7679-4ef5-8c51-ce1eb16c846b\', \'multiverseId\': 539027}, \'multiverseid\': 539027}]', '[{\'name\': \'Schwefelvandale\', \'text\': \'Bedrohlich (Diese Kreatur kann nicht geblockt werden, außer von zwei oder mehr Kreaturen.)\\nFalls es weder Tag noch Nacht ist, wird es Tag, sowie der Schwefelvandale ins Spiel kommt.\\nImmer wenn der Tag zur Nacht oder die Nacht zum Tag wird, fügt der Schwefelvandale jedem Gegner 1 Schadenspunkt zu.\', \'type\': \'Kreatur — Teufel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535222&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'97be7cb0-8cc5-449e-9988-e084d5159aef\', \'multiverseId\': 535222}, \'multiverseid\': 535222}, {\'name\': \'Vándalo de azufre\', \'text\': \'Amenaza. (Esta criatura no puede ser bloqueada excepto por dos o más criaturas.)\\nSi no es ni de día ni de noche, se hace de día en cuanto el Vándalo de azufre entre al campo de batalla.\\nSiempre que se pase del día a la noche o de la noche al día, el Vándalo de azufre hace 1 punto de daño a cada oponente.\', \'type\': \'Criatura — Diablo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535538&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'62896b12-9df1-427f-9158-d1c861938f0a\', \'multiverseId\': 535538}, \'multiverseid\': 535538}, {\'name\': \'Vandale de soufre\', \'text\': "Menace (Cette créature ne peut pas être bloquée excepté par deux créatures ou plus.)\\nSi ce n\'est ni le jour ni la nuit, on passe au jour au moment où le Vandale de soufre arrive sur le champ de bataille.\\nÀ chaque fois qu\'on passe du jour à la nuit ou de la nuit au jour, le Vandale de soufre inflige 1 blessure à chaque adversaire.", \'type\': \'Créature : diable\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535854&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4873f048-72a7-49bd-8d8f-99605fa36642\', \'multiverseId\': 535854}, \'multiverseid\': 535854}, {\'name\': \'Vandalo di Zolfo\', \'text\': \'Minacciare (Questa creatura non può essere bloccata tranne che da due o più creature.)\\nSe non è né giorno né notte, diventa giorno mentre il Vandalo di Zolfo entra nel campo di battaglia.\\nOgniqualvolta il giorno diventa notte o la notte diventa giorno, il Vandalo di Zolfo infligge 1 danno a ogni avversario.\', \'type\': \'Creatura — Diavolo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536170&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'33eb6e2c-f4c7-4069-93cd-b95be8ae516a\', \'multiverseId\': 536170}, \'multiverseid\': 536170}, {\'name\': \'硫黄の蛮人\', \'text\': \'威迫（このクリーチャーは２体以上のクリーチャーによってしかブロックされない。）\\n硫黄の蛮人が戦場に出るに際し、昼でも夜でもないなら、昼になる。\\n昼が夜になるか夜が昼になるたび、硫黄の蛮人は各対戦相手にそれぞれ１点のダメージを与える。\', \'type\': \'クリーチャー — デビル\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536486&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3dccfe68-9db5-4418-b495-430c1aef084c\', \'multiverseId\': 536486}, \'multiverseid\': 536486}, {\'name\': \'유황 기물파괴자\', \'text\': \'호전적 (이 생물은 두 개 이상의 생물에만 방어될 수 있다.)\\n낮도 밤도 아니라면, 유황 기물파괴자가 전장에 들어오면서 낮이 된다.\\n낮이 밤이 되거나 밤이 낮이 될 때마다, 유황 기물파괴자는 각 상대에게 피해 1점을 입힌다.\', \'type\': \'생물 — 악령\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536802&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ab3c5614-5a41-4394-b2fc-8a12ef587189\', \'multiverseId\': 536802}, \'multiverseid\': 536802}, {\'name\': \'Vândalo do Enxofre\', \'text\': \'Ameaçar (Esta criatura só pode ser bloqueada por duas ou mais criaturas.)\\nSe não for dia nem noite, torna-se dia conforme Vândalo do Enxofre entra no campo de batalha.\\nToda vez que o dia se torna noite ou a noite se torna dia, Vândalo do Enxofre causa 1 ponto de dano a cada oponente.\', \'type\': \'Criatura — Diabo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537118&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9c9e4643-51db-4705-99c2-ecb749af9dfa\', \'multiverseId\': 537118}, \'multiverseid\': 537118}, {\'name\': \'Серный Вандал\', \'text\': \'Угроза (Это существо не может быть заблокировано менее чем двумя существами.)\\nЕсли не стоит ни день, ни ночь, то при выходе Серного Вандала на поле битвы наступает день.\\nКаждый раз, когда день становится ночью или ночь становится днем, Серный Вандал наносит 1 повреждение каждому оппоненту.\', \'type\': \'Существо — Дьявол\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537434&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2f688855-73cd-496e-940d-be9d240460a0\', \'multiverseId\': 537434}, \'multiverseid\': 537434}, {\'name\': \'硫磺破坏魔\', \'text\': \'威慑（此生物只能被两个或更多生物阻挡。）\\n如果当前既非白昼也非黑夜，则于硫磺破坏魔进战场时成为白昼。\\n每当白昼成为黑夜或黑夜成为白昼时，硫磺破坏魔向每位对手各造成1点伤害。\', \'type\': \'生物 ～魔鬼\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537750&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fe8f24cc-b962-480c-9d4b-523bb5403d0f\', \'multiverseId\': 537750}, \'multiverseid\': 537750}, {\'name\': \'硫磺破壞魔\', \'text\': \'威懾（此生物只能被兩個或更多生物阻擋。）\\n如果當前既非白晝也非黑夜，則於硫磺破壞魔進戰場時成為白晝。\\n每當白晝成為黑夜或黑夜成為白晝時，硫磺破壞魔向每位對手各造成1點傷害。\', \'type\': \'生物 ～魔鬼\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538066&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'64f7e339-1407-4194-b647-6801f86fe586\', \'multiverseId\': 538066}, \'multiverseid\': 538066}]', '[{\'name\': \'Schwindende Hoffnung\', \'text\': \'Bringe eine Kreatur deiner Wahl auf die Hand ihres Besitzers zurück. Falls ihr Manabetrag 3 oder weniger war, wende Hellsicht 1 an. (Schaue dir die oberste Karte deiner Bibliothek an. Du kannst sie unter deine Bibliothek legen.)\', \'type\': \'Spontanzauber\', \'flavor\': \'„Zumindest werde ich nicht zu einem … dieser Dinger."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535128&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a6087261-ab2e-4906-bd4f-7b4daefc818f\', \'multiverseId\': 535128}, \'multiverseid\': 535128}, {\'name\': \'Esperanza en extinción\', \'text\': \'Regresa la criatura objetivo a la mano de su propietario. Si su valor de maná era de 3 o menos, adivina 1. (Mira la primera carta de tu biblioteca. Puedes poner esa carta en el fondo de tu biblioteca.)\', \'type\': \'Instantáneo\', \'flavor\': \'"Al menos no me convertiré en… en una de esas cosas".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535444&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b384abe5-14ed-481d-bd47-0952fef9d47d\', \'multiverseId\': 535444}, \'multiverseid\': 535444}, {\'name\': \'Espoir volatilisé\', \'text\': \'Renvoyez une créature ciblée dans la main de son propriétaire. Si sa valeur de mana était inférieure ou égale à 3, regard 1. (Regardez la carte du dessus de votre bibliothèque. Vous pouvez la mettre au-dessous de votre bibliothèque.)\', \'type\': \'Éphémère\', \'flavor\': "« Au moins je ne deviendrai pas l\'une de... ces choses. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535760&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'265eceb9-68a1-404d-b52f-c3454f43c319\', \'multiverseId\': 535760}, \'multiverseid\': 535760}, {\'name\': \'Speranza Svanita\', \'text\': \'Fai tornare una creatura bersaglio in mano al suo proprietario. Se il suo valore di mana era pari o inferiore a 3, profetizza 1. (Guarda la prima carta del tuo grimorio. Puoi mettere quella carta in fondo al tuo grimorio.)\', \'type\': \'Istantaneo\', \'flavor\': \'"Almeno non diventerò una di... quelle cose."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536076&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cbee029b-b081-4b85-8f46-29c11f5f8ded\', \'multiverseId\': 536076}, \'multiverseid\': 536076}, {\'name\': \'消えゆく希望\', \'text\': \'クリーチャー１体を対象とする。それをオーナーの手札に戻す。それのマナ総量が３以下なら、占術１を行う。（あなたのライブラリーの一番上にあるカード１枚を見る。あなたはそのカードをあなたのライブラリーの一番下に置いてもよい。）\', \'type\': \'インスタント\', \'flavor\': \'「少なくとも私はならなくて済むわ……あの者たちのようには。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536392&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f46bda00-65ec-4ecb-a723-ba08ff2a990f\', \'multiverseId\': 536392}, \'multiverseid\': 536392}, {\'name\': \'쇠퇴하는 희망\', \'text\': \'생물을 목표로 정한다. 그 생물을 소유자의 손으로 되돌린다. 그 생물의 마나 값이 3 이하라면, 점술 1을 한다. (당신의 서고 맨 위 카드 한 장을 본다. 당신은 그 카드를 당신의 서고 맨 밑에 놓을 수 있다.)\', \'type\': \'순간마법\', \'flavor\': \'"최소한 내가 . . . 저렇게 되진 않겠지."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536708&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a69bba7b-577a-461a-8f21-97f63893be2f\', \'multiverseId\': 536708}, \'multiverseid\': 536708}, {\'name\': \'Esperança Evanescente\', \'text\': \'Devolva a criatura alvo para a mão de seu dono. Se o valor de mana dela for igual ou inferior a 3, use vidência 1. (Olhe o card do topo de seu grimório. Você pode colocar aquele card no fundo de seu grimório.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Pelo menos eu não vou virar uma... daquelas coisas."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537024&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'97505f69-fc61-44c2-8624-3fb307b533b7\', \'multiverseId\': 537024}, \'multiverseid\': 537024}, {\'name\': \'Угасающая Надежда\', \'text\': \'Верните целевое существо в руку его владельца. Если его мановая ценность была 3 или меньше, предскажите 1. (Посмотрите верхнюю карту вашей библиотеки. Вы можете положить ту карту в низ вашей библиотеки.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«По крайней мере, я не стану одной из... этих тварей».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537340&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7c3a71b1-9382-4304-bd6c-df03dcbe8728\', \'multiverseId\': 537340}, \'multiverseid\': 537340}, {\'name\': \'渐失希望\', \'text\': \'将目标生物移回其拥有者手上。如果其法术力值等于或小于3，则占卜1。（检视你牌库顶的牌。你可以将该牌置于你的牌库底。）\', \'type\': \'瞬间\', \'flavor\': \'「至少我不会成为…他们同类。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537656&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'58779999-ca70-41fe-a383-d6753e2be11b\', \'multiverseId\': 537656}, \'multiverseid\': 537656}, {\'name\': \'漸失希望\', \'text\': \'將目標生物移回其擁有者手上。如果其魔法力值等於或小於3，則占卜1。（檢視你牌庫頂的牌。你可以將該牌置於你的牌庫底。）\', \'type\': \'瞬間\', \'flavor\': \'「至少我不會成為…他們同類。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537972&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e746eb2d-55a9-4538-8286-5ed46f746a52\', \'multiverseId\': 537972}, \'multiverseid\': 537972}]', '[{\'name\': \'Seelenführer-Dommelgreif\', \'text\': \'Fliegend\\nWenn der Seelenführer-Dommelgreif ins Spiel kommt, schicke bis zu eine Karte deiner Wahl aus einem Friedhof ins Exil.\', \'type\': \'Kreatur — Hippogryph, Geist\', \'flavor\': \'Er führt die Seelen der Gerechten zu ihrer gesegneten Ruhe und die Geister der Bösen der Gerechtigkeit zu.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535109&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4d824a05-c063-4853-853c-824db55fa93a\', \'multiverseId\': 535109}, \'multiverseid\': 535109}, {\'name\': \'Gryff guía de almas\', \'text\': \'Vuela.\\nCuando el Gryff guía de almas entre al campo de batalla, exilia hasta una carta objetivo de un cementerio.\', \'type\': \'Criatura — Espíritu hipogrifo\', \'flavor\': \'Lleva las almas de los justos a su descanso bendito y a los espíritus del mal ante la justicia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535425&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b1a26a65-066c-4e47-86b7-1e20fc3c3b90\', \'multiverseId\': 535425}, \'multiverseid\': 535425}, {\'name\': \'Gryff guide-âmes\', \'text\': "Vol\\nQuand le Gryff guide-âmes arrive sur le champ de bataille, exilez jusqu\'à une carte ciblée depuis un cimetière.", \'type\': \'Créature : hippogriffe et esprit\', \'flavor\': \'Il conduit les âmes des justes à leur repos béni et les esprits malfaisants face à la justice.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535741&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'be923ce5-04e6-4616-a29e-47c6f708b05c\', \'multiverseId\': 535741}, \'multiverseid\': 535741}, {\'name\': \'Gryff Guidaspiriti\', \'text\': \'Volare\\nQuando il Gryff Guidaspiriti entra nel campo di battaglia, esilia fino a una carta bersaglio da un cimitero.\', \'type\': \'Creatura — Spirito Ippogrifo\', \'flavor\': \'Conduce le anime dei virtuosi al loro riposo benedetto e gli spiriti dei malvagi alla giustizia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536057&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8e5b9ef7-cc6d-4062-b14c-c282b7e66f77\', \'multiverseId\': 536057}, \'multiverseid\': 536057}, {\'name\': \'魂標グリフ\', \'text\': \'飛行\\n魂標グリフが戦場に出たとき、墓地にあるカード最大１枚を対象とする。それを追放する。\', \'type\': \'クリーチャー — ヒポグリフ・スピリット\', \'flavor\': \'それは清き魂を祝福の眠りへ、邪悪な霊を正義へと導く。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536373&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9d4547ae-6d3b-4af6-9d84-250d915c06d7\', \'multiverseId\': 536373}, \'multiverseid\': 536373}, {\'name\': \'영혼을 안내하는 그리프\', \'text\': \'비행\\n영혼을 안내하는 그리프가 전장에 들어올 때, 무덤에 있는 카드를 최대 한 장까지 목표로 정한다. 그 카드를 추방한다.\', \'type\': \'생물 — 히포그리프 신령\', \'flavor\': \'의인의 영혼은 축복받은 영면으로 인도하고, 사악한 영혼에게는 정의의 심판을 내린다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536689&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'270a59b8-be84-42aa-b8a4-4824d6183132\', \'multiverseId\': 536689}, \'multiverseid\': 536689}, {\'name\': \'Grifino Guia-almas\', \'text\': \'Voar\\nQuando Grifino Guia-almas entrar no campo de batalha, exile até um card alvo de um cemitério.\', \'type\': \'Criatura — Hipogrifo Espírito\', \'flavor\': \'Ele conduz as almas do justos ao descanso abençoado e os espíritos do mal à justiça.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537005&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ec972848-5ee5-4252-b4b2-6de577721310\', \'multiverseId\': 537005}, \'multiverseid\': 537005}, {\'name\': \'Гриф, Проводник Душ\', \'text\': \'Полет\\nКогда Гриф, Проводник Душ выходит на поле битвы, изгоните не более одной целевой карты из кладбища.\', \'type\': \'Существо — Гиппогриф Дух\', \'flavor\': \'Он ведет души праведников на благословенный покой, а духи зла — к правосудию.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537321&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dd2b723e-db9f-4a79-ae8b-95f91cf1e474\', \'multiverseId\': 537321}, \'multiverseid\': 537321}, {\'name\': \'导灵骏鹭\', \'text\': \'飞行\\n当导灵骏鹭进战场时，将至多一张目标牌从坟墓场放逐。\', \'type\': \'生物 ～骏鹰／精怪\', \'flavor\': \'它引导善魂前往受福歇息，押解恶灵接受正义审判。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537637&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'06653934-3b78-411d-af56-668e349dd61e\', \'multiverseId\': 537637}, \'multiverseid\': 537637}, {\'name\': \'導靈駿鷺\', \'text\': \'飛行\\n當導靈駿鷺進戰場時，將至多一張目標牌從墳墓場放逐。\', \'type\': \'生物 ～駿鷹／精靈\', \'flavor\': \'它引導善魂前往受福歇息，押解惡靈接受正義審判。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537953&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'883f55ab-ba61-4292-a9f2-75a3e2e85922\', \'multiverseId\': 537953}, \'multiverseid\': 537953}]', '[{\'name\': \'Seuchenwolf\', \'text\': \'{2}{G}: Der Seuchenwolf erhält Todesberührung bis zum Ende des Zuges.\', \'type\': \'Kreatur — Wolf\', \'flavor\': \'Wölfe, die Zombiefleisch fressen und es überleben, verbreiten die üblen Krankheiten der Toten auf ihren Streifzügen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535297&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'84203bcb-47a1-4796-965d-2cd815ed2e8c\', \'multiverseId\': 535297}, \'multiverseid\': 535297}, {\'name\': \'Lobo pestilente\', \'text\': \'{2}{G}: El Lobo pestilente gana la habilidad de toque mortal hasta el final del turno.\', \'type\': \'Criatura — Lobo\', \'flavor\': \'Los lobos que se alimentan de carne de zombies y logran sobrevivir portan las enfermedades pútridas de los muertos allá donde van.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535613&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a9c5b042-92c7-4ddc-a4d8-5fef3dfa59d3\', \'multiverseId\': 535613}, \'multiverseid\': 535613}, {\'name\': \'Loup pestiféré\', \'text\': "{2}{G} : Le Loup pestiféré acquiert le contact mortel jusqu\'à la fin du tour.", \'type\': \'Créature : loup\', \'flavor\': \'Les loups qui se nourrissent de la chair de zombie et y survivent portent les maladies abjectes des morts partout où ils vont.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535929&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'53a1c19d-9ee8-4ea8-a9ba-dfac0661c925\', \'multiverseId\': 535929}, \'multiverseid\': 535929}, {\'name\': \'Lupo Pestilenziale\', \'text\': \'{2}{G}: Il Lupo Pestilenziale ha tocco letale fino alla fine del turno.\', \'type\': \'Creatura — Lupo\', \'flavor\': \'I lupi che si cibano di carne di zombie e sopravvivono portano con sé le terribili malattie dei morti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536245&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c702327a-4691-4dd4-ae86-a880edb5b42b\', \'multiverseId\': 536245}, \'multiverseid\': 536245}, {\'name\': \'伝染病の狼\', \'text\': \'{2}{G}：ターン終了時まで、伝染病の狼は接死を得る。\', \'type\': \'クリーチャー — 狼\', \'flavor\': \'ゾンビの肉を喰らって生き延びた狼は死者の不浄な病を徘徊する先々へと運ぶ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536561&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d11ba348-257c-4a1e-a721-2dd3038413c3\', \'multiverseId\': 536561}, \'multiverseid\': 536561}, {\'name\': \'질병을 퍼뜨리는 늑대\', \'text\': \'{2}{G}: 질병을 퍼뜨리는 늑대는 턴종료까지 치명타를 얻는다.\', \'type\': \'생물 — 늑대\', \'flavor\': \'좀비의 살점을 먹고 살아남은 늑대들은 그것들이 배회하는 곳마다 망자의 역겨운 병을 옮긴다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536877&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f8c13d13-8f45-4b18-924e-a7a22e77c2e4\', \'multiverseId\': 536877}, \'multiverseid\': 536877}, {\'name\': \'Lobo Pestilento\', \'text\': \'{2}{G}: Lobo Pestilento ganha toque mortífero até o final do turno.\', \'type\': \'Criatura — Lobo\', \'flavor\': \'Os lobos que se banqueteiam com a carne dos zumbis e sobrevivem portam as vis doenças dos mortos por onde quer que vão.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537193&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ed569516-6754-45e7-8c54-c78ea9c5b4a3\', \'multiverseId\': 537193}, \'multiverseid\': 537193}, {\'name\': \'Чумной Волк\', \'text\': \'{2}{G}: Чумной Волк получает Смертельное касание до конца хода.\', \'type\': \'Существо — Волк\', \'flavor\': \'Волки, которые поедают плоть зомби и выживают, разносят нечестивые болезни мертвецов всюду, где появляются.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537509&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bc16a327-164a-4a23-8f03-5f93495d78bc\', \'multiverseId\': 537509}, \'multiverseid\': 537509}, {\'name\': \'瘟疫狼\', \'text\': \'{2}{G}：瘟疫狼获得死触异能直到回合结束。\', \'type\': \'生物 ～狼\', \'flavor\': \'吃过灵俑而幸存的狼群，会将亡者腐疫播散到它们所经之处。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537825&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b8859c49-5b28-4893-b9a4-9d16d019a5ce\', \'multiverseId\': 537825}, \'multiverseid\': 537825}, {\'name\': \'瘟疫狼\', \'text\': \'{2}{G}：瘟疫狼獲得死觸異能直到回合結束。\', \'type\': \'生物 ～狼\', \'flavor\': \'吃過殭屍而倖存的狼群，會將亡者腐疫播散到牠們所經之處。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538141&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3593a3f1-7f1d-4ed9-9df5-ce1a89de8e4a\', \'multiverseId\': 538141}, \'multiverseid\': 538141}]', '[{\'name\': \'Sich entfaltende Wildnis\', \'text\': \'{T}, opfere die Sich entfaltende Wildnis: Durchsuche deine Bibliothek nach einer Standardland-Karte, bringe sie getappt ins Spiel und mische danach.\', \'type\': \'Land\', \'flavor\': \'„Stenzen lodert vor neuer Hitze. Die Gezeiten von Nefalen sind chaotisch. Und überall dieser unnatürliche Frost. Das Land sendet eine Warnung aus."\\n—Katilda, Morgenlicht-Oberste\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535375&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a8ba6265-5c76-4942-ac1a-62ca3d419f79\', \'multiverseId\': 535375}, \'multiverseid\': 535375}, {\'name\': \'Terrenos expansivos\', \'text\': \'{T}, sacrificar los Terrenos expansivos: Busca en tu biblioteca una carta de tierra básica, ponla en el campo de batalla girada y luego baraja.\', \'type\': \'Tierra\', \'flavor\': \'"Stensia se quema con un calor nuevo, las olas de Nephalia son caóticas y hay heladas extrañas por doquier. La tierra nos está alertando".\\n—Katilda, Gran Cierva del Alba\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535691&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c1207e9a-d20c-44b6-9593-5392a18ef8ed\', \'multiverseId\': 535691}, \'multiverseid\': 535691}, {\'name\': \'Étendues sauvages en évolution\', \'text\': \'{T}, sacrifiez les Étendues sauvages en évolution : Cherchez dans votre bibliothèque une carte de terrain de base, mettez-la sur le champ de bataille engagée, puis mélangez.\', \'type\': \'Terrain\', \'flavor\': "« La Stensie brûle sous l\'effet de cette nouvelle chaleur. Les flots de la Néphalie sont chaotiques. Et partout, ce gel surnaturel. La terre envoit un avertissement. »\\n—Katilda, Première de Cerf-orient", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536007&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7685391b-04d1-4160-969c-b1d88783af7d\', \'multiverseId\': 536007}, \'multiverseid\': 536007}, {\'name\': \'Terre Selvagge in Evoluzione\', \'text\': \'{T}, Sacrifica le Terre Selvagge in Evoluzione: Passa in rassegna il tuo grimorio per una carta terra base, mettila sul campo di battaglia TAPpata, poi rimescola.\', \'type\': \'Terra\', \'flavor\': \'"Stensia arde di un nuovo calore. Le maree di Nephalia sono caotiche. E ovunque regna questo gelo innaturale. Le terre cercano di mandarci un avvertimento."\\n—Katilda, Prima Albacorno\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536323&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'38648246-0070-4681-990c-6d9b8daa51f6\', \'multiverseId\': 536323}, \'multiverseid\': 536323}, {\'name\': \'進化する未開地\', \'text\': \'{T}, 進化する未開地を生け贄に捧げる：あなたのライブラリーから基本土地・カード１枚を探し、タップ状態で戦場に出す。その後、ライブラリーを切り直す。\', \'type\': \'土地\', \'flavor\': \'「ステンシアの猛火は激しさを増している。ネファリアの高波は混沌さを増している。そして至る所に、不自然な霜が降りている。大地が我々に警告してるのよ。」\\n――ドーンハルトの主導者、カティルダ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536639&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8f0f6307-1da6-46fe-a3ca-b12a2dd02214\', \'multiverseId\': 536639}, \'multiverseid\': 536639}, {\'name\': \'진화하는 야생지\', \'text\': \'{T}, 진화하는 야생지를 희생한다: 당신의 서고에서 기본 대지 카드를 찾아, 탭된 채로 전장에 놓은 후, 서고를 섞는다.\', \'type\': \'대지\', \'flavor\': \'"스텐시아가 새로운 열기를 발하며 불타오르고 있어. 네팔리아아의 파도는 무질서하고. 그리고, 이 부자연스러운 서리가 사방에 깔렸지. 대지가 경고를 보내고 있는 거야."\\n—새벽수사슴 지도자, 카틸다\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536955&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'70f04427-ed79-4cbe-922f-75b36e993ecb\', \'multiverseId\': 536955}, \'multiverseid\': 536955}, {\'name\': \'Terras em Desenvolvimento\', \'text\': \'{T}, sacrifique Terras em Desenvolvimento: Procure um card de terreno básico em seu grimório, coloque-o no campo de batalha virado e depois embaralhe.\', \'type\': \'Terreno\', \'flavor\': \'"Stensia arde no calor. As marés de Nefália estão caóticas. E essa geada antinatural por toda parte. A terra está mandando um aviso."\\n— Katilda, Líder Cervo da Aurora\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537271&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8dce0edc-01bb-4c42-b15f-92197d928739\', \'multiverseId\': 537271}, \'multiverseid\': 537271}, {\'name\': \'Перерождающиеся Дебри\', \'text\': \'{T}, пожертвуйте Перерождающиеся Дебри: найдите в вашей библиотеке карту базовой земли, положите ее на поле битвы повернутой, затем перетасуйте библиотеку.\', \'type\': \'Земля\', \'flavor\': \'«Стенсия пылает новым жаром. В Нефалии — хаотичные приливы. И везде этот неестественный мороз. Земля посылает нам предупреждение».\\n— Катильда, Первейшая Донхарта\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537587&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7efcd8d1-c90b-4a47-9959-8dab03540e7b\', \'multiverseId\': 537587}, \'multiverseid\': 537587}, {\'name\': \'成形野地\', \'text\': \'{T}，牺牲成形野地：从你牌库中搜寻一张基本地牌，将之横置放进战场，然后洗牌。\', \'type\': \'地\', \'flavor\': \'「史顿襄新焰熊熊。涅非利亚乱浪滔滔。诡异冰霜肆虐四境。大地在发出警告。」\\n～曙鹿集巫首凯蒂妲\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537903&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'03398901-1ca1-4ef8-b4e6-fd03593928a3\', \'multiverseId\': 537903}, \'multiverseid\': 537903}, {\'name\': \'成形野地\', \'text\': \'{T}，犧牲成形野地：從你牌庫中搜尋一張基本地牌，將之橫置放進戰場，然後洗牌。\', \'type\': \'地\', \'flavor\': \'「史頓襄新焰熊熊。涅非利亞亂浪滔滔。詭異冰霜肆虐四境。大地在發出警告。」\\n～曙鹿集巫首凱蒂妲\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538219&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5f697b85-d1cc-4219-b5bf-8275a3bd22a5\', \'multiverseId\': 538219}, \'multiverseid\': 538219}]', '[{\'name\': \'Sichtung der Schattenbestie\', \'text\': \'Erzeuge einen 4/4 grünen Bestie-Kreaturenspielstein.\\nRückblende {6}{G} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten wirken. Schicke sie danach ins Exil.)\', \'type\': \'Hexerei\', \'flavor\': \'„Werwölfe hinterlassen Spuren. Vampire hinterlassen ausgesaugte Leichen. Das hier ist etwas anderes."\\n—Paulin, Fallensteller im Dämmerwald\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535303&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'39addfd6-57cd-4478-96d2-da16d358e74e\', \'multiverseId\': 535303}, \'multiverseid\': 535303}, {\'name\': \'Avistamiento de bestiasoscuras\', \'text\': \'Crea una ficha de criatura Bestia verde 4/4.\\nRetrospectiva {6}{G}. (Puedes lanzar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego exíliala.)\', \'type\': \'Conjuro\', \'flavor\': \'"Los licántropos dejan huellas. Los vampiros, cadáveres resecos. Esto es otra cosa".\\n—Paulin, trampero de Somberwald\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535619&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b2e9022f-9d75-4e3e-a2ef-1bdad7f77cfd\', \'multiverseId\': 535619}, \'multiverseid\': 535619}, {\'name\': \'Apparition de la bête des ombres\', \'text\': \'Créez un jeton de créature 4/4 verte Bête.\\nFlashback {6}{G} (Vous pouvez lancer cette carte depuis votre cimetière pour son coût de flashback. Exilez-la ensuite.)\', \'type\': \'Rituel\', \'flavor\': "« Les loups-garous laissent des empreintes. Les vampires, des cadavres vidés de leur sang. Il s\'agit d\'autre chose. »\\n—Paulin, trappeur de Somberwald", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535935&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cc7dfb28-2075-484a-ab60-1b2f5fb2fada\', \'multiverseId\': 535935}, \'multiverseid\': 535935}, {\'name\': "Avvistamento della Bestia d\'Ombra", \'text\': \'Crea una pedina creatura Bestia 4/4 verde.\\nFlashback {6}{G} (Puoi lanciare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi esiliala.)\', \'type\': \'Stregoneria\', \'flavor\': \'"I mannari lasciano impronte. I vampiri lasciano corpi prosciugati. Questo è diverso."\\n—Paulin, trappolatore di Somberwald\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536251&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f5043aee-57a9-431a-83e0-0f1b04a3b3d3\', \'multiverseId\': 536251}, \'multiverseid\': 536251}, {\'name\': \'影野獣の目撃\', \'text\': \'緑の４/４のビースト・クリーチャー・トークン１体を生成する。\\nフラッシュバック{6}{G}（あなたはあなたの墓地にあるこのカードをフラッシュバック・コストで唱えてもよい。その後、これを追放する。）\', \'type\': \'ソーサリー\', \'flavor\': \'「人狼は足跡を残す。吸血鬼は搾られた死体を残す。これは別の何かだ。」\\n――ソンバーワルドの罠師、パーリン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536567&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ae48b198-87ee-4509-814c-5e5a3084aa92\', \'multiverseId\': 536567}, \'multiverseid\': 536567}, {\'name\': \'그림자야수 목격\', \'text\': \'4/4 녹색 야수 생물 토큰 한 개를 만든다.\\n회상 {6}{G} (당신은 이 카드의 회상 비용을 지불해 이 카드를 당신의 무덤에서 발동할 수 있다. 그 후 이 카드를 추방한다.)\', \'type\': \'집중마법\', \'flavor\': \'"늑대인간들은 흔적을 남기지. 흡혈귀들은 말라비틀어진 시체를 남기고. 이건 그것들과는 뭔가 다른 거야."\\n—솜버왈드의 덫사냥꾼 폴린\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536883&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d40890c2-0f43-4fd4-a458-7ff746b33c49\', \'multiverseId\': 536883}, \'multiverseid\': 536883}, {\'name\': \'Avistamento da Fera Sombria\', \'text\': \'Crie uma ficha de criatura Besta verde 4/4.\\nRecapitular {6}{G} (Você pode conjurar este card de seu cemitério pagando seu custo de recapitular. Depois, exile-o.)\', \'type\': \'Feitiço\', \'flavor\': \'"Lobisomem deixa rastro. Vampiro deixa cadáver. Isso aqui é outra coisa."\\n— Paulin, armadilheiro de Somberwald\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537199&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'90456653-7309-47ee-b1f8-dbd8e0044b69\', \'multiverseId\': 537199}, \'multiverseid\': 537199}, {\'name\': \'Вид Сумеречного Зверя\', \'text\': \'Создайте одну фишку существа 4/4 зеленый Зверь.\\nВоспоминание {6}{G} (Вы можете разыграть эту карту из вашего кладбища за ее стоимость Воспоминания. Затем изгоните ее.)\', \'type\': \'Волшебство\', \'flavor\': \'«Вервольфы оставляют следы. Вампиры оставляют обескровленные трупы. А это что-то другое».\\n— Паулин, капканщик из Сомбервальда\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537515&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'079b12de-c2f5-4ce8-85a2-d42b1c37e3d4\', \'multiverseId\': 537515}, \'multiverseid\': 537515}, {\'name\': \'亲睹黯影兽\', \'text\': \'派出一个4/4绿色野兽衍生生物。\\n返照{6}{G}（你可以从你坟墓场中施放此牌，并支付其返照费用，然后将它放逐。）\', \'type\': \'法术\', \'flavor\': \'「狼人留下踪迹。吸血鬼留下干尸。这是其他东西留下的。」\\n～松柏森布陷人堡霖\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537831&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1a9aeacd-642d-4213-b41f-b39689ca4854\', \'multiverseId\': 537831}, \'multiverseid\': 537831}, {\'name\': \'親睹黯影獸\', \'text\': \'派出一個4/4綠色野獸衍生生物。\\n返照{6}{G}（你可以從你墳墓場中施放此牌，並支付其返照費用，然後將它放逐。）\', \'type\': \'巫術\', \'flavor\': \'「狼人留下蹤跡。吸血鬼留下乾屍。這是其他東西留下的。」\\n～松柏森佈陷人堡霖\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538147&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f4af947c-86c7-4cab-9cdd-a0d0c343a6fc\', \'multiverseId\': 538147}, \'multiverseid\': 538147}]', '[{\'name\': \'Sieg über die Horde\', \'text\': \'Dieser Zauberspruch kostet beim Wirken für jede Kreatur im Spiel {1} weniger.\\nZerstöre alle Kreaturen.\', \'type\': \'Hexerei\', \'flavor\': \'Odric empfand keine Freude an der Gewalt, aber auch keine Trauer um die verdorbenen Wesen, die er aus dem Weg räumte. Alles, was zählte, waren die Leben, die er gerettet hatte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535115&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'15a20d12-d304-45b6-9032-ed224ba7f68a\', \'multiverseId\': 535115}, \'multiverseid\': 535115}, {\'name\': \'Aniquilar a la horda\', \'text\': \'Te cuesta {1} menos lanzar este hechizo por cada criatura en el campo de batalla.\\nDestruye todas las criaturas.\', \'type\': \'Conjuro\', \'flavor\': \'A Odric no le gustaba la violencia, pero tampoco lamentó la muerte de las criaturas retorcidas que eliminó. Solo le importaban las vidas que logró salvar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535431&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'accb5dc5-9ed5-4e9b-b640-1772ccafb60e\', \'multiverseId\': 535431}, \'multiverseid\': 535431}, {\'name\': \'Victoire contre la horde\', \'text\': \'Ce sort coûte {1} de moins à lancer pour chaque créature sur le champ de bataille.\\nDétruisez toutes les créatures.\', \'type\': \'Rituel\', \'flavor\': "Odric ne se délectait guère de la violence, pas plus qu\'il ne pleurait les choses corrompues qu\'il pourfendait. Tout ce qui importait, c\'était les vies qu\'il avait sauvées.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535747&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4a9de959-6647-4e61-abb5-0114272ce36a\', \'multiverseId\': 535747}, \'multiverseid\': 535747}, {\'name\': "Annientare l\'Orda", \'text\': \'Questa magia costa {1} in meno per essere lanciata per ogni creatura sul campo di battaglia.\\nDistruggi tutte le creature.\', \'type\': \'Stregoneria\', \'flavor\': "Odric non provava alcuna gioia nella violenza, ma neanche piangeva gli orrori che aveva annientato. L\'unica cosa importante erano le vite che aveva salvato.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536063&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d66bb550-daed-49d5-a0c6-460c4a56e25e\', \'multiverseId\': 536063}, \'multiverseid\': 536063}, {\'name\': \'大群退治\', \'text\': \'この呪文を唱えるためのコストは、戦場にあるクリーチャー１体につき{1}少なくなる。\\nすべてのクリーチャーを破壊する。\', \'type\': \'ソーサリー\', \'flavor\': \'オドリックは暴力を避けようとしていたが、彼が斬り捨てた歪んだ者たちを嘆くこともなかった。唯一彼にとって大事なのは救った命だけなのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536379&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b2d221c4-2385-4974-a357-834f07af6192\', \'multiverseId\': 536379}, \'multiverseid\': 536379}, {\'name\': \'군단 격파\', \'text\': \'군단 격파는 전장에 있는 각 생물마다 발동하는 데 {1}이 덜 든다.\\n모든 생물을 파괴한다.\', \'type\': \'집중마법\', \'flavor\': \'오드릭은 폭력을 즐기지 않았지만 자신이 물리친 사악한 것들을 애도하지도 않았다. 그에게 중요한 것은 그가 구해낸 목숨들 뿐이었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536695&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5d97f100-00b3-4112-b3dc-a6fac2d6ae4a\', \'multiverseId\': 536695}, \'multiverseid\': 536695}, {\'name\': \'Subjugar a Horda\', \'text\': \'Esta mágica custa {1} a menos para ser conjurada para cada criatura no campo de batalha.\\nDestrua todas as criaturas.\', \'type\': \'Feitiço\', \'flavor\': \'A violência não deu nenhum prazer a Odric, mas ele também não lamentou a morte daquelas abominações. A única coisa que importava eram as vidas salvas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537011&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c6fe7ae9-ec87-49db-a89b-78fd6f46ca9a\', \'multiverseId\': 537011}, \'multiverseid\': 537011}, {\'name\': \'Истребить Орду\', \'text\': \'Стоимость разыгрывания этого заклинания уменьшается на {1} за каждое существо на поле битвы.\\nУничтожьте все существа.\', \'type\': \'Волшебство\', \'flavor\': \'Одрик не радовался насилию, но и не скорбел по тем ужасным тварям, с которыми расправлялся. Все, что для него имело значение, это жизни, которые он спасал.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537327&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b69c7a80-2a1d-43a6-9a7a-3f25e30b9262\', \'multiverseId\': 537327}, \'multiverseid\': 537327}, {\'name\': \'歼灭尸群\', \'text\': \'战场上每有一个生物，此咒语便减少{1}来施放。\\n消灭所有生物。\', \'type\': \'法术\', \'flavor\': \'欧吉克并未因暴力而欢喜，也没替除掉的扭曲怪物而伤悲。眼下最重要的，是他亲手救出的鲜活生命。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537643&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6cd66318-c37b-4bf5-a518-f56ccfba1a38\', \'multiverseId\': 537643}, \'multiverseid\': 537643}, {\'name\': \'殲滅屍群\', \'text\': \'戰場上每有一個生物，此咒語便減少{1}來施放。\\n消滅所有生物。\', \'type\': \'巫術\', \'flavor\': \'歐吉克並未因暴力而歡喜，也沒替除掉的扭曲怪物而傷悲。眼下最重要的，是他親手救出的鮮活生命。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537959&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fafd23d5-5966-414d-9112-83e8e9aee658\', \'multiverseId\': 537959}, \'multiverseid\': 537959}]', '[{\'name\': \'Sieg über die Horde\', \'text\': \'Dieser Zauberspruch kostet beim Wirken für jede Kreatur im Spiel {1} weniger.\\nZerstöre alle Kreaturen.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538746&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'338f6ebd-1115-4c4c-8dfd-b671e9cec7ba\', \'multiverseId\': 538746}, \'multiverseid\': 538746}, {\'name\': \'Aniquilar a la horda\', \'text\': \'Te cuesta {1} menos lanzar este hechizo por cada criatura en el campo de batalla.\\nDestruye todas las criaturas.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538806&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'03e3e40d-f381-443d-aebc-514e9004858f\', \'multiverseId\': 538806}, \'multiverseid\': 538806}, {\'name\': \'Victoire contre la horde\', \'text\': \'Ce sort coûte {1} de moins à lancer pour chaque créature sur le champ de bataille.\\nDétruisez toutes les créatures.\', \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538866&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'28ec926f-5a78-4e7a-a572-f0188cb5e929\', \'multiverseId\': 538866}, \'multiverseid\': 538866}, {\'name\': "Annientare l\'Orda", \'text\': \'Questa magia costa {1} in meno per essere lanciata per ogni creatura sul campo di battaglia.\\nDistruggi tutte le creature.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538926&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fb25d478-d7e2-4657-b4dd-caa2b7c3d53e\', \'multiverseId\': 538926}, \'multiverseid\': 538926}, {\'name\': \'大群退治\', \'text\': \'この呪文を唱えるためのコストは、戦場にあるクリーチャー１体につき{1}少なくなる。\\nすべてのクリーチャーを破壊する。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538986&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ade40e2e-5cb4-4ded-adf9-880e868ce194\', \'multiverseId\': 538986}, \'multiverseid\': 538986}]', "[{'name': 'Sigarda, Bewahrerin des Lichts', 'text': 'Fliegend, verursacht Trampelschaden\\nMenschen, die du kontrollierst, erhalten +1/+1.\\nHexenzirkel — Immer wenn Sigarda angreift und falls du drei oder mehr Kreaturen mit unterschiedlicher Stärke kontrollierst, schaue dir die obersten fünf Karten deiner Bibliothek an. Du kannst davon eine Mensch-Kreaturenkarte offen vorzeigen und auf deine Hand nehmen. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.', 'type': 'Legendäre Kreatur — Engel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535352&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5490ca90-ce69-4d55-9f9e-dc812f043438', 'multiverseId': 535352}, 'multiverseid': 535352}, {'name': 'Sigarda, campeona de la luz', 'text': 'Vuela, arrolla.\\nLos Humanos que controlas obtienen +1/+1.\\nAquelarre — Siempre que Sigarda ataque, si controlas tres o más criaturas con fuerzas distintas, mira las cinco primeras cartas de tu biblioteca. Puedes mostrar una carta de criatura Humano de entre ellas y ponerla en tu mano. Pon el resto en el fondo de tu biblioteca en un orden aleatorio.', 'type': 'Criatura legendaria — Ángel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535668&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'abaabad3-a219-468e-95ed-69b3542c5644', 'multiverseId': 535668}, 'multiverseid': 535668}, {'name': 'Sigarda, championne de la lumière', 'text': 'Vol, piétinement\\nLes humains que vous contrôlez gagnent +1/+1.\\nCongrégation — À chaque fois que Sigarda attaque, si vous contrôlez au moins trois créatures avec des forces différentes, regardez les cinq cartes du dessus de votre bibliothèque. Vous pouvez révéler une carte de créature Humain parmi elles et la mettre dans votre main. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.', 'type': 'Créature légendaire : ange', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535984&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'deb7662f-5f0a-4733-86e2-6ed76a37c73c', 'multiverseId': 535984}, 'multiverseid': 535984}, {'name': 'Sigarda, Campionessa della Luce', 'text': 'Volare, travolgere\\nGli Umani che controlli prendono +1/+1.\\nCongrega — Ogniqualvolta Sigarda attacca, se controlli tre o più creature con forza diversa, guarda le prime cinque carte del tuo grimorio. Puoi rivelare una carta creatura Umano scelta tra esse e aggiungerla alla tua mano. Metti le altre in fondo al tuo grimorio in ordine casuale.', 'type': 'Creatura Leggendaria — Angelo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536300&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c0fb1ee6-7c5f-4b3e-b1cf-0d48812a8a22', 'multiverseId': 536300}, 'multiverseid': 536300}, {'name': '光の勇者、シガルダ', 'text': '飛行、トランプル\\nあなたがコントロールしているすべての人間は＋１/＋１の修整を受ける。\\n集会 — 光の勇者、シガルダが攻撃するたび、あなたがパワーが異なる３体以上のクリーチャーをコントロールしている場合、あなたのライブラリーの一番上にあるカード５枚を見る。あなたは「その中から人間・クリーチャー・カード１枚を公開し、あなたの手札に加える。」を選んでもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。', 'type': '伝説のクリーチャー — 天使', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536616&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '810650dc-1127-4a9d-b180-b15ae06e0447', 'multiverseId': 536616}, 'multiverseid': 536616}, {'name': '빛의 투사, 시가르다', 'text': '비행, 돌진\\n당신이 조종하는 인간들은 +1/+1을 받는다.\\n집회 — 시가르다가 공격할 때마다, 당신이 서로 공격력이 다른 생물을 세 개 이상 조종한다면, 당신의 서고 맨 위 카드 다섯 장을 본다. 당신은 그중에서 인간 생물 카드 한 장을 공개하고 당신의 손으로 가져갈 수 있다. 나머지 카드들은 무작위 순서로 당신의 서고 맨 밑에 놓는다.', 'type': '전설적 생물 — 천사', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536932&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'd5a953c6-f70c-4cc1-bf51-013527484252', 'multiverseId': 536932}, 'multiverseid': 536932}, {'name': 'Sigarda, Campeã da Luz', 'text': 'Voar, atropelar\\nOs Humanos que você controla recebem +1/+1.\\nConventículo — Toda vez que Sigarda atacar, se você controlar três ou mais criaturas com poderes diferentes, olhe os cinco cards do topo de seu grimório. Você pode revelar um card de criatura Humano dentre eles e colocá-lo em sua mão. Coloque o restante no fundo de seu grimório em ordem aleatória.', 'type': 'Criatura Lendária — Anjo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537248&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a0d8c5bf-8cd3-4ecf-afe6-76bbbc04b800', 'multiverseId': 537248}, 'multiverseid': 537248}, {'name': 'Сигарда, Поборница Света', 'text': 'Полет, Пробивной удар\\nПерманенты с подтипом Человек под вашим контролем получают +1/+1.\\nШабаш — Каждый раз, когда Сигарда атакует, если вы контролируете не менее трех существ с различными значениями силы, посмотрите пять верхних карт вашей библиотеки. Вы можете показать находящуюся среди них карту существа-Человека и положить ее в вашу руку. Положите остальные карты в низ вашей библиотеки в случайном порядке.', 'type': 'Легендарное Существо — Ангел', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537564&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '65331b19-2d47-48df-9f7b-b29be9d26fab', 'multiverseId': 537564}, 'multiverseid': 537564}, {'name': '明光斗士席嘉妲', 'text': '飞行，践踏\\n由你操控的人类得+1/+1。\\n鸠集～每当席嘉妲攻击时，若你操控三个或更多力量各不相同的生物，则检视你牌库顶的五张牌。你可以展示其中的一张人类生物牌并将它置于你手上。将其余的牌以随机顺序置于你的牌库底。', 'type': '传奇生物 ～天使', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537880&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '30019729-3be7-4705-8d5d-01d128f350ce', 'multiverseId': 537880}, 'multiverseid': 537880}, {'name': '明光鬥士席嘉妲', 'text': '飛行，踐踏\\n由你操控的人類得+1/+1。\\n鳩集～每當席嘉妲攻擊時，若你操控三個或更多力量各不相同的生物，則檢視你牌庫頂的五張牌。你可以展示其中的一張人類生物牌並將它置於你手上。將其餘的牌以隨機順序置於你的牌庫底。', 'type': '傳奇生物 ～天使', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538196&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '710a62db-8433-47c2-aee3-e402f9b11326', 'multiverseId': 538196}, 'multiverseid': 538196}]", "[{'name': 'Sigarda, Bewahrerin des Lichts', 'text': 'Fliegend, verursacht Trampelschaden\\nMenschen, die du kontrollierst, erhalten +1/+1.\\nHexenzirkel — Immer wenn Sigarda angreift und falls du drei oder mehr Kreaturen mit unterschiedlicher Stärke kontrollierst, schaue dir die obersten fünf Karten deiner Bibliothek an. Du kannst davon eine Mensch-Kreaturenkarte offen vorzeigen und auf deine Hand nehmen. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.', 'type': 'Legendäre Kreatur — Engel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538522&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b548daa4-4284-488e-bf49-cc0cfda13b22', 'multiverseId': 538522}, 'multiverseid': 538522}, {'name': 'Sigarda, campeona de la luz', 'text': 'Vuela, arrolla.\\nLos Humanos que controlas obtienen +1/+1.\\nAquelarre — Siempre que Sigarda ataque, si controlas tres o más criaturas con fuerzas distintas, mira las cinco primeras cartas de tu biblioteca. Puedes mostrar una carta de criatura Humano de entre ellas y ponerla en tu mano. Pon el resto en el fondo de tu biblioteca en un orden aleatorio.', 'type': 'Criatura legendaria — Ángel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538539&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '7b8ff425-77b0-4c95-9de7-edc81826ce3b', 'multiverseId': 538539}, 'multiverseid': 538539}, {'name': 'Sigarda, championne de la lumière', 'text': 'Vol, piétinement\\nLes humains que vous contrôlez gagnent +1/+1.\\nCongrégation — À chaque fois que Sigarda attaque, si vous contrôlez au moins trois créatures avec des forces différentes, regardez les cinq cartes du dessus de votre bibliothèque. Vous pouvez révéler une carte de créature Humain parmi elles et la mettre dans votre main. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.', 'type': 'Créature légendaire : ange', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538556&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'f35bef27-ccaa-42f6-8e56-9ea011f51d15', 'multiverseId': 538556}, 'multiverseid': 538556}, {'name': 'Sigarda, Campionessa della Luce', 'text': 'Volare, travolgere\\nGli Umani che controlli prendono +1/+1.\\nCongrega — Ogniqualvolta Sigarda attacca, se controlli tre o più creature con forza diversa, guarda le prime cinque carte del tuo grimorio. Puoi rivelare una carta creatura Umano scelta tra esse e aggiungerla alla tua mano. Metti le altre in fondo al tuo grimorio in ordine casuale.', 'type': 'Creatura Leggendaria — Angelo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538573&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '84f02491-da2b-4bc9-8aac-400dc6a269f7', 'multiverseId': 538573}, 'multiverseid': 538573}, {'name': '光の勇者、シガルダ', 'text': '飛行、トランプル\\nあなたがコントロールしているすべての人間は＋１/＋１の修整を受ける。\\n集会 — 光の勇者、シガルダが攻撃するたび、あなたがパワーが異なる３体以上のクリーチャーをコントロールしている場合、あなたのライブラリーの一番上にあるカード５枚を見る。あなたは「その中から人間・クリーチャー・カード１枚を公開し、あなたの手札に加える。」を選んでもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。', 'type': '伝説のクリーチャー — 天使', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538590&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'b717229f-0b7b-4ab8-bb07-a3a4dc417805', 'multiverseId': 538590}, 'multiverseid': 538590}, {'name': '빛의 투사, 시가르다', 'text': '비행, 돌진\\n당신이 조종하는 인간들은 +1/+1을 받는다.\\n집회 — 시가르다가 공격할 때마다, 당신이 서로 공격력이 다른 생물을 세 개 이상 조종한다면, 당신의 서고 맨 위 카드 다섯 장을 본다. 당신은 그중에서 인간 생물 카드 한 장을 공개하고 당신의 손으로 가져갈 수 있다. 나머지 카드들은 무작위 순서로 당신의 서고 맨 밑에 놓는다.', 'type': '전설적 생물 — 천사', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538607&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '5ac7dacd-943a-43dd-8880-ddd0decc3a2b', 'multiverseId': 538607}, 'multiverseid': 538607}, {'name': 'Sigarda, Campeã da Luz', 'text': 'Voar, atropelar\\nOs Humanos que você controla recebem +1/+1.\\nConventículo — Toda vez que Sigarda atacar, se você controlar três ou mais criaturas com poderes diferentes, olhe os cinco cards do topo de seu grimório. Você pode revelar um card de criatura Humano dentre eles e colocá-lo em sua mão. Coloque o restante no fundo de seu grimório em ordem aleatória.', 'type': 'Criatura Lendária — Anjo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538624&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7a4a0ce1-887e-49a9-9d6a-9861cf138a0d', 'multiverseId': 538624}, 'multiverseid': 538624}, {'name': 'Сигарда, Поборница Света', 'text': 'Полет, Пробивной удар\\nПерманенты с подтипом Человек под вашим контролем получают +1/+1.\\nШабаш — Каждый раз, когда Сигарда атакует, если вы контролируете не менее трех существ с различными значениями силы, посмотрите пять верхних карт вашей библиотеки. Вы можете показать находящуюся среди них карту существа-Человека и положить ее в вашу руку. Положите остальные карты в низ вашей библиотеки в случайном порядке.', 'type': 'Легендарное Существо — Ангел', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538641&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'b35b10d7-fd71-45ad-a71b-a43ebaba48a2', 'multiverseId': 538641}, 'multiverseid': 538641}, {'name': '明光斗士席嘉妲', 'text': '飞行，践踏\\n由你操控的人类得+1/+1。\\n鸠集～每当席嘉妲攻击时，若你操控三个或更多力量各不相同的生物，则检视你牌库顶的五张牌。你可以展示其中的一张人类生物牌并将它置于你手上。将其余的牌以随机顺序置于你的牌库底。', 'type': '传奇生物 ～天使', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538658&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '1f03343c-0387-440a-94a6-17514dfb3172', 'multiverseId': 538658}, 'multiverseid': 538658}, {'name': '明光鬥士席嘉妲', 'text': '飛行，踐踏\\n由你操控的人類得+1/+1。\\n鳩集～每當席嘉妲攻擊時，若你操控三個或更多力量各不相同的生物，則檢視你牌庫頂的五張牌。你可以展示其中的一張人類生物牌並將它置於你手上。將其餘的牌以隨機順序置於你的牌庫底。', 'type': '傳奇生物 ～天使', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538675&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '87740456-3139-4685-a8c2-770945d4ea02', 'multiverseId': 538675}, 'multiverseid': 538675}]", '[{\'name\': \'Sigardas Pracht\', \'text\': \'Sowie Sigardas Pracht ins Spiel kommt, notiere deinen Lebenspunktestand.\\nZu Beginn deines Versorgungssegments ziehst du eine Karte, falls dein Lebenspunktestand größer oder gleich dem letzten Lebenspunktestand ist, den du für Sigardas Pracht notiert hast. Notiere dann deinen Lebenspunktestand.\\nImmer wenn du einen weißen Zauberspruch wirkst, erhältst du 1 Lebenspunkt dazu.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535107&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cd38ef71-fb97-4aa2-b2cc-f6a98d476d7a\', \'multiverseId\': 535107}, \'multiverseid\': 535107}, {\'name\': \'Resplandor de Sigarda\', \'text\': \'En cuanto el Resplandor de Sigarda entre al campo de batalla, anota tu total de vidas.\\nAl comienzo de tu mantenimiento, roba una carta si tu total de vidas es mayor o igual que el último total de vidas anotado por el Resplandor de Sigarda. Luego, anota tu total de vidas.\\nSiempre que lances un hechizo blanco, ganas 1 vida.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535423&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'17f191f7-ea23-4483-8dee-e4852d1f3aab\', \'multiverseId\': 535423}, \'multiverseid\': 535423}, {\'name\': \'Splendeur de Sigarda\', \'text\': \'Au moment où la Splendeur de Sigarda arrive sur le champ de bataille, notez votre total de points de vie.\\nAu début de votre entretien, piochez une carte si votre total de points de vie est supérieur ou égal au dernier total de points de vie noté pour la Splendeur de Sigarda. Puis notez votre total de points de vie.\\nÀ chaque fois que vous lancez un sort blanc, vous gagnez 1 point de vie.\', \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535739&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7032cece-6807-4896-a5cd-7cde89218c4b\', \'multiverseId\': 535739}, \'multiverseid\': 535739}, {\'name\': \'Splendore di Sigarda\', \'text\': "Mentre lo Splendore di Sigarda entra nel campo di battaglia, annota i tuoi punti vita.\\nAll\'inizio del tuo mantenimento, pesca una carta se i tuoi punti vita sono pari o superiori all\'ultimo valore annotato per lo Splendore di Sigarda. Poi annota i tuoi punti vita.\\nOgniqualvolta lanci una magia bianca, guadagni 1 punto vita.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536055&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d73be9a2-ebb2-49d9-b085-c2860a721986\', \'multiverseId\': 536055}, \'multiverseid\': 536055}, {\'name\': \'シガルダの輝き\', \'text\': \'シガルダの輝きが戦場に出るに際し、あなたのライフ総量を記録する。\\nあなたのアップキープの開始時に、あなたのライフ総量が直近にシガルダの輝きで記録したライフ総量以上であるなら、カード１枚を引く。その後、あなたのライフ総量を記録する。\\nあなたが白の呪文を唱えるたび、あなたは１点のライフを得る。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536371&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8421a380-7b58-41d6-9fbb-71a1f3c7c7ac\', \'multiverseId\': 536371}, \'multiverseid\': 536371}, {\'name\': \'시가르다의 광휘\', \'text\': \'시가르다의 광휘가 전장에 들어올 때, 당신의 생명 총점을 기록한다.\\n당신의 유지단 시작에, 당신의 생명 총점이 시가르다의 광휘에 마지막으로 기록된 생명 총점 이상이라면 카드 한 장을 뽑는다. 그 후 당신의 생명 총점을 기록한다.\\n당신이 백색 주문을 발동할 때마다, 당신은 생명 1점을 얻는다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536687&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'941bf3c1-8e93-4ece-ada6-c89af479058a\', \'multiverseId\': 536687}, \'multiverseid\': 536687}, {\'name\': \'Esplendor de Sigarda\', \'text\': \'Conforme Esplendor de Sigarda entrar no campo de batalha, tome nota de seu total de pontos de vida.\\nNo início de sua manutenção, compre um card se seu total de pontos de vida for igual ou superior ao último total de pontos de vida anotado para Esplendor de Sigarda. Depois, tome nota de seu total de pontos de vida.\\nToda vez que você conjura uma mágica branca, você ganha 1 ponto de vida.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537003&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5e589d3e-7b7b-4550-80d7-606a316aa316\', \'multiverseId\': 537003}, \'multiverseid\': 537003}, {\'name\': \'Великолепие Сигарды\', \'text\': \'При выходе Великолепия Сигарды на поле битвы запишите ваше количество жизней.\\nВ начале вашего шага поддержки возьмите карту, если количество ваших жизней превышает или равно последнему записанному количеству жизней для Великолепия Сигарды. Затем запишите ваше количество жизней.\\nКаждый раз, когда вы разыгрываете белое заклинание, вы получаете 1 жизнь.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537319&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d5a44af0-3cd2-4dc7-90e2-913015e27e7a\', \'multiverseId\': 537319}, \'multiverseid\': 537319}, {\'name\': \'席嘉妲辉耀\', \'text\': \'于席嘉妲辉耀进战场时，记下你的总生命。\\n在你的维持开始时，如果你的总生命等于或大于最后为席嘉妲辉耀记下的总生命，则抓一张牌。然后记下你的总生命。\\n每当你施放白色咒语时，你获得1点生命。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537635&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cbff73e1-b57d-4e92-9dc0-dea90b6cf2d0\', \'multiverseId\': 537635}, \'multiverseid\': 537635}, {\'name\': \'席嘉妲輝耀\', \'text\': \'於席嘉妲輝耀進戰場時，記下你的總生命。\\n在你的維持開始時，如果你的總生命等於或大於最後為席嘉妲輝耀記下的總生命，則抽一張牌。然後記下你的總生命。\\n每當你施放白色咒語時，你獲得1點生命。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537951&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'cfd034bc-f019-4d2a-a968-ddee600d7aa0\', \'multiverseId\': 537951}, \'multiverseid\': 537951}]', '[{\'name\': \'Sigardas Pracht\', \'text\': \'Sowie Sigardas Pracht ins Spiel kommt, notiere deinen Lebenspunktestand.\\nZu Beginn deines Versorgungssegments ziehst du eine Karte, falls dein Lebenspunktestand größer oder gleich dem letzten Lebenspunktestand ist, den du für Sigardas Pracht notiert hast. Notiere dann deinen Lebenspunktestand.\\nImmer wenn du einen weißen Zauberspruch wirkst, erhältst du 1 Lebenspunkt dazu.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538743&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'902ca677-acee-4e0b-b40a-3fc425b35540\', \'multiverseId\': 538743}, \'multiverseid\': 538743}, {\'name\': \'Resplandor de Sigarda\', \'text\': \'En cuanto el Resplandor de Sigarda entre al campo de batalla, anota tu total de vidas.\\nAl comienzo de tu mantenimiento, roba una carta si tu total de vidas es mayor o igual que el último total de vidas anotado por el Resplandor de Sigarda. Luego, anota tu total de vidas.\\nSiempre que lances un hechizo blanco, ganas 1 vida.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538803&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c12187ce-ec5c-4383-ad0e-ee467c69c3f3\', \'multiverseId\': 538803}, \'multiverseid\': 538803}, {\'name\': \'Splendeur de Sigarda\', \'text\': \'Au moment où la Splendeur de Sigarda arrive sur le champ de bataille, notez votre total de points de vie.\\nAu début de votre entretien, piochez une carte si votre total de points de vie est supérieur ou égal au dernier total de points de vie noté pour la Splendeur de Sigarda. Puis notez votre total de points de vie.\\nÀ chaque fois que vous lancez un sort blanc, vous gagnez 1 point de vie.\', \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538863&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'966f1a36-2da2-4fed-a13a-c1ae7f0fb684\', \'multiverseId\': 538863}, \'multiverseid\': 538863}, {\'name\': \'Splendore di Sigarda\', \'text\': "Mentre lo Splendore di Sigarda entra nel campo di battaglia, annota i tuoi punti vita.\\nAll\'inizio del tuo mantenimento, pesca una carta se i tuoi punti vita sono pari o superiori all\'ultimo valore annotato per lo Splendore di Sigarda. Poi annota i tuoi punti vita.\\nOgniqualvolta lanci una magia bianca, guadagni 1 punto vita.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538923&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a4f6f28d-bcf7-4e05-93cd-355739253046\', \'multiverseId\': 538923}, \'multiverseid\': 538923}, {\'name\': \'シガルダの輝き\', \'text\': \'シガルダの輝きが戦場に出るに際し、あなたのライフ総量を記録する。\\nあなたのアップキープの開始時に、あなたのライフ総量が直近にシガルダの輝きで記録したライフ総量以上であるなら、カード１枚を引く。その後、あなたのライフ総量を記録する。\\nあなたが白の呪文を唱えるたび、あなたは１点のライフを得る。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538983&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'39c7b696-87f0-41e5-ab16-46f7872b071f\', \'multiverseId\': 538983}, \'multiverseid\': 538983}]', '[{\'name\': \'Sigardische Retterin\', \'text\': \'Fliegend\\nWenn die Sigardische Retterin ins Spiel kommt und falls du sie gewirkt hast, bringe bis zu zwei Kreaturenkarten deiner Wahl mit Manabetrag 2 oder weniger aus deinem Friedhof ins Spiel zurück.\', \'type\': \'Kreatur — Engel\', \'flavor\': \'„Hinfort, Mondverfluchte! Diese Leute sind keine Beute für euch."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535108&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cedc9da9-21d1-42ab-bb24-6ca8fa3791d7\', \'multiverseId\': 535108}, \'multiverseid\': 535108}, {\'name\': \'Salvadora sigardiana\', \'text\': \'Vuela.\\nCuando la Salvadora sigardiana entre al campo de batalla, si la lanzaste, regresa hasta dos cartas de criatura objetivo con valor de maná de 2 o menos de tu cementerio al campo de batalla.\', \'type\': \'Criatura — Ángel\', \'flavor\': \'"¡Desaparezcan, malditos por la luna! Estas personas no son sus presas".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535424&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a546aaf1-65fb-4e2a-874d-302fb7b96340\', \'multiverseId\': 535424}, \'multiverseid\': 535424}, {\'name\': \'Sauveuse sigardienne\', \'text\': "Vol\\nQuand la Sauveuse sigardienne arrive sur le champ de bataille, si vous l\'avez lancée, renvoyez sur le champ de bataille depuis votre cimetière jusqu\'à deux cartes de créature ciblées avec une valeur de mana inférieure ou égale à 2.", \'type\': \'Créature : ange\', \'flavor\': \'« Allez-vous-en, maudits par la lune ! Ces gens ne seront pas vos proies. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535740&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'14e12d15-8ab3-4691-a99b-811153b21fc8\', \'multiverseId\': 535740}, \'multiverseid\': 535740}, {\'name\': \'Salvatrice di Sigarda\', \'text\': "Volare\\nQuando la Salvatrice di Sigarda entra nel campo di battaglia, se l\'hai lanciata, rimetti sul campo di battaglia fino a due carte creatura bersaglio con valore di mana pari o inferiore a 2 dal tuo cimitero.", \'type\': \'Creatura — Angelo\', \'flavor\': \'"Sparite, dannati! Queste persone non saranno vostre prede."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536056&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2272d161-fa66-4b1d-b3d1-a508ed6e8241\', \'multiverseId\': 536056}, \'multiverseid\': 536056}, {\'name\': \'シガルダ教の救済者\', \'text\': \'飛行\\nシガルダ教の救済者が戦場に出たとき、あなたがこれを唱えていた場合、あなたの墓地にあるマナ総量が２以下のクリーチャー・カード最大２枚を対象とする。それらを戦場に戻す。\', \'type\': \'クリーチャー — 天使\', \'flavor\': \'「月に呪われし者よ、立ち去れ！この者どもはお前たちの獲物ではない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536372&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3601089f-0ae5-41ca-806c-b197bf666cf5\', \'multiverseId\': 536372}, \'multiverseid\': 536372}, {\'name\': \'시가르다의 구원자\', \'text\': \'비행\\n시가르다의 구원자가 전장에 들어올 때, 당신이 시가르다의 구원자를 발동했다면, 당신의 무덤에 있는 마나 값이 2 이하인 생물 카드를 최대 두 장까지 목표로 정한다. 그 카드들을 전장으로 되돌린다.\', \'type\': \'생물 — 천사\', \'flavor\': \'"사라져라, 달빛의 저주를 받은 것아! 이 사람들은 네 먹잇감이 아니다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536688&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'67459523-b11a-4b20-96c7-a7d1ab8a6a98\', \'multiverseId\': 536688}, \'multiverseid\': 536688}, {\'name\': \'Salvadora Sigardiana\', \'text\': \'Voar\\nQuando Salvadora Sigardiana entrar no campo de batalha, se você a tiver conjurado, devolva de seu cemitério para o campo de batalha até dois cards de criatura alvo com valor de mana igual ou inferior a 2.\', \'type\': \'Criatura — Anjo\', \'flavor\': \'"Vá de retro, maldito da lua! Esse povo não é comida pra você não!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537004&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ecfb9683-4c17-4d62-88f9-b1cef2fb5d66\', \'multiverseId\': 537004}, \'multiverseid\': 537004}, {\'name\': \'Сигардианка-Спасительница\', \'text\': \'Полет\\nКогда Сигардианка-Спасительница выходит на поле битвы, если вы разыграли ее, верните не более двух целевых карт существ с мановой ценностью 2 или меньше из вашего кладбища на поле битвы.\', \'type\': \'Существо — Ангел\', \'flavor\': \'«Прочь, проклятые луной! Эти люди не станут вашей добычей».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537320&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0bdcdfac-9bf7-40c3-a8aa-0d2811c8499a\', \'multiverseId\': 537320}, \'multiverseid\': 537320}, {\'name\': \'席嘉妲济世使\', \'text\': \'飞行\\n当席嘉妲济世使进战场时，若它经你施放，则将至多两张目标法术力值等于或小于2的生物牌从你的坟墓场移回战场。\', \'type\': \'生物 ～天使\', \'flavor\': \'「月诅邪物退散！这些人不是你们的猎物。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537636&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5f874086-a6af-44ad-b567-480acbf09f99\', \'multiverseId\': 537636}, \'multiverseid\': 537636}, {\'name\': \'席嘉妲濟世使\', \'text\': \'飛行\\n當席嘉妲濟世使進戰場時，若它經你施放，則將至多兩張目標魔法力值等於或小於2的生物牌從你的墳墓場移回戰場。\', \'type\': \'生物 ～天使\', \'flavor\': \'「月詛邪物退散！這些人不是你們的獵物。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537952&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'027f5c98-b135-4e91-a6c4-23ca226ce60e\', \'multiverseId\': 537952}, \'multiverseid\': 537952}]', '[{\'name\': \'Sigardische Retterin\', \'text\': \'Fliegend\\nWenn die Sigardische Retterin ins Spiel kommt und falls du sie gewirkt hast, bringe bis zu zwei Kreaturenkarten deiner Wahl mit Manabetrag 2 oder weniger aus deinem Friedhof ins Spiel zurück.\', \'type\': \'Kreatur — Engel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538744&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c6ad2d4d-03c6-43e1-8169-8c83e3f80755\', \'multiverseId\': 538744}, \'multiverseid\': 538744}, {\'name\': \'Salvadora sigardiana\', \'text\': \'Vuela.\\nCuando la Salvadora sigardiana entre al campo de batalla, si la lanzaste, regresa hasta dos cartas de criatura objetivo con valor de maná de 2 o menos de tu cementerio al campo de batalla.\', \'type\': \'Criatura — Ángel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538804&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'09d26f8c-e7c6-4948-b15e-d7c76cef18ec\', \'multiverseId\': 538804}, \'multiverseid\': 538804}, {\'name\': \'Sauveuse sigardienne\', \'text\': "Vol\\nQuand la Sauveuse sigardienne arrive sur le champ de bataille, si vous l\'avez lancée, renvoyez sur le champ de bataille depuis votre cimetière jusqu\'à deux cartes de créature ciblées avec une valeur de mana inférieure ou égale à 2.", \'type\': \'Créature : ange\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538864&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'145dae6c-aebf-4e41-b13d-60f361393a96\', \'multiverseId\': 538864}, \'multiverseid\': 538864}, {\'name\': \'Salvatrice di Sigarda\', \'text\': "Volare\\nQuando la Salvatrice di Sigarda entra nel campo di battaglia, se l\'hai lanciata, rimetti sul campo di battaglia fino a due carte creatura bersaglio con valore di mana pari o inferiore a 2 dal tuo cimitero.", \'type\': \'Creatura — Angelo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538924&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ef5ee722-e98b-4bc7-97cd-a353a7575042\', \'multiverseId\': 538924}, \'multiverseid\': 538924}, {\'name\': \'シガルダ教の救済者\', \'text\': \'飛行\\nシガルダ教の救済者が戦場に出たとき、あなたがこれを唱えていた場合、あなたの墓地にあるマナ総量が２以下のクリーチャー・カード最大２枚を対象とする。それらを戦場に戻す。\', \'type\': \'クリーチャー — 天使\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538984&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'20e37010-b249-4242-a6e9-f6a2ae808f29\', \'multiverseId\': 538984}, \'multiverseid\': 538984}]', '[{\'name\': \'Signalhorn-Katharer\', \'text\': \'Wenn die Signalhorn-Katharer ins Spiel kommen, erzeuge einen 1/1 weißen Mensch-Kreaturenspielstein.\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': \'Der Klang der Trompete ist Warnung und Trost zugleich: Er warnt vor nahender Gefahr, erinnert die Dorfbewohner aber auch daran, dass jemand da ist, der sich ihr entgegenstellt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535085&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'39f92310-3f5e-490e-89e2-abd9ac49789e\', \'multiverseId\': 535085}, \'multiverseid\': 535085}, {\'name\': \'Cátaros del clarín\', \'text\': \'Cuando los Cátaros del clarín entren al campo de batalla, crea una ficha de criatura Humano blanca 1/1.\', \'type\': \'Criatura — Caballero humano\', \'flavor\': \'El sonido de la trompeta es a la vez advertencia y consuelo: los lugareños saben que se acerca algún peligro, pero también que hay quien luchará contra él.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535401&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7e20cf55-6529-46be-a894-2554c8fab80c\', \'multiverseId\': 535401}, \'multiverseid\': 535401}, {\'name\': \'Cathares au clairon\', \'text\': \'Quand les Cathares au clairon arrivent sur le champ de bataille, créez un jeton de créature 1/1 blanche Humain.\', \'type\': \'Créature : humain et chevalier\', \'flavor\': "Le son de la trompette est tout autant un avertissement qu\'un réconfort : il prévient d\'un danger mais rappelle aussi aux villageois que quelqu\'un est là pour y faire face.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535717&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'561234ca-2a41-46f0-8c6c-9d20b73a44ff\', \'multiverseId\': 535717}, \'multiverseid\': 535717}, {\'name\': \'Catari della Chiarina\', \'text\': \'Quando i Catari della Chiarina entrano nel campo di battaglia, crea una pedina creatura Umano 1/1 bianca.\', \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': "Il suono delle trombe è sia un avvertimento che un conforto: segnala l\'arrivo di un pericolo, ma ricorda anche alla gente del villaggio che qualcuno è pronto ad affrontarlo.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536033&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c540c836-8614-45c9-9ffc-5c0d83e4b540\', \'multiverseId\': 536033}, \'multiverseid\': 536033}, {\'name\': \'クラリオン吹きの聖戦士\', \'text\': \'クラリオン吹きの聖戦士が戦場に出たとき、白の１/１の人間・クリーチャー・トークン１体を生成する。\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': \'ラッパの音色は警戒と同時に安堵をもたらす。迫りくる危険を知らせると同時にそれに立ち向かう者がいる事を村の民に知らせるのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536349&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'10fad9b7-8c99-4dd1-9dbb-f2b98a61356e\', \'multiverseId\': 536349}, \'multiverseid\': 536349}, {\'name\': \'나팔수 성전사\', \'text\': \'나팔수 성전사가 전장에 들어올 때, 1/1 백색 인간 생물 토큰 한 개를 만든다.\', \'type\': \'생물 — 인간 기사\', \'flavor\': \'트럼펫 소리는 경고와 안심 양쪽을 모두 제공한다: 위험이 찾아온다는 뜻이기도 하지만, 누군가가 그에 맞서고 있다는 것을 마을 사람들에게 상기시켜 주기 때문이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536665&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'939b10a3-500e-467e-b156-7f9ae9b14b34\', \'multiverseId\': 536665}, \'multiverseid\': 536665}, {\'name\': \'Cátaros da Trombeta\', \'text\': \'Quando Cátaros da Trombeta entrar no campo de batalha, crie uma ficha de criatura branca 1/1 do tipo Humano.\', \'type\': \'Criatura — Humano Cavaleiro\', \'flavor\': \'O som do trompete é um aviso e um conforto: anuncia o perigo que se aproxima, mas também lembra o povo do vilarejo de que alguém está lá para enfrentá-lo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536981&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ac493a88-65f7-4529-94e1-67ff3b9cdc6a\', \'multiverseId\': 536981}, \'multiverseid\': 536981}, {\'name\': \'Трубящие Катары\', \'text\': \'Когда Трубящие Катары выходят на поле битвы, создайте одну фишку существа 1/1 белый Человек.\', \'type\': \'Существо — Человек Рыцарь\', \'flavor\': \'Звук трубы — это и предупреждение, и утешение: он возвещает приближение опасности, но и напоминает селянам, что у них есть те, кто готов противостоять угрозе.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537297&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dd3d6247-512d-48a9-94f0-16ce8da373dc\', \'multiverseId\': 537297}, \'multiverseid\': 537297}, {\'name\': \'司号护教军\', \'text\': \'当司号护教军进战场时，派出一个1/1白色人类衍生生物。\', \'type\': \'生物 ～人类／骑士\', \'flavor\': \'号角之声既引人担心，又令人宽慰：它虽是威胁来袭的警告，却也提醒村民尚有人挺身抗击。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537613&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2a02d658-de8f-410f-8ef1-6b2eba4ea0fe\', \'multiverseId\': 537613}, \'multiverseid\': 537613}, {\'name\': \'司號護教軍\', \'text\': \'當司號護教軍進戰場時，派出一個1/1白色人類衍生生物。\', \'type\': \'生物 ～人類／騎士\', \'flavor\': \'號角之聲既引人擔心，又令人寬慰：它雖是威脅來襲的警告，卻也提醒村民尚有人挺身抗擊。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537929&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'59a82a0e-5d1e-4cf0-931e-f7f25c4ea1b0\', \'multiverseId\': 537929}, \'multiverseid\': 537929}]', '[{\'name\': \'Silberbolzen\', \'text\': \'{3}, {T}, opfere den Silberbolzen: Er fügt einer Kreatur deiner Wahl 3 Schadenspunkte zu. Falls einem Werwolf auf diese Weise Schaden zugefügt wird, zerstöre ihn.\', \'type\': \'Artefakt\', \'flavor\': \'„Wenn ein Werwolf angreift, habt ihr nur Zeit für einen Schuss. Nutzt ihn gut."\\n—Kapitän Eberherz\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535372&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8ea3c033-4977-40d9-931c-9dade39b6d76\', \'multiverseId\': 535372}, \'multiverseid\': 535372}, {\'name\': \'Virote de plata\', \'text\': \'{3}, {T}, sacrificar el Virote de plata: Hace 3 puntos de daño a la criatura objetivo. Si un Licántropo recibe daño de esta manera, destrúyelo.\', \'type\': \'Artefacto\', \'flavor\': \'"Cuando ataca un licántropo, solo tienes tiempo para un disparo. Haz que valga la pena".\\n—Capitán Eberhart\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535688&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1ea0f533-6280-4cf4-a4b1-6ca041aba61a\', \'multiverseId\': 535688}, \'multiverseid\': 535688}, {\'name\': "Carreau d\'argent", \'text\': "{3}, {T}, sacrifiez le Carreau d\'argent : Il inflige 3 blessures à une créature ciblée. Si un loup-garou subit des blessures de cette manière, détruisez-le.", \'type\': \'Artefact\', \'flavor\': "« Quand un loup-garou charge, vous n\'avez le temps de tirer qu\'une seule fois. Mieux vaut ne pas le rater. »\\n—Capitaine Eberhart", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536004&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8b6c4a7e-effc-4dcb-9fbf-972925130bbb\', \'multiverseId\': 536004}, \'multiverseid\': 536004}, {\'name\': "Dardo d\'Argento", \'text\': "{3}, {T}, Sacrifica il Dardo d\'Argento: Infligge 3 danni a una creatura bersaglio. Se è stato inflitto danno a un Mannaro in questo modo, distruggilo.", \'type\': \'Artefatto\', \'flavor\': \'"Quando un mannaro carica verso di te, hai tempo per un solo colpo. Ti conviene fare centro."\\n—Capitano Eberheart\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536320&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'18f42c80-c990-4161-979e-49ec2bc23388\', \'multiverseId\': 536320}, \'multiverseid\': 536320}, {\'name\': \'銀弾\', \'text\': \'{3}, {T}, 銀弾を生け贄に捧げる：クリーチャー１体を対象とする。これはそれに３点のダメージを与える。これにより狼男がダメージを受けたなら、それを破壊する。\', \'type\': \'アーティファクト\', \'flavor\': \'「人狼が突撃して来たら、一発にすべてを賭けることになる。しっかり狙えよ。」\\n――エバハート船長\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536636&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8aa3f84c-6c95-4a3a-ac0a-2ef551589a92\', \'multiverseId\': 536636}, \'multiverseid\': 536636}, {\'name\': \'은화살\', \'text\': \'{3}, {T}, 은화살을 희생한다: 생물을 목표로 정한다. 은화살은 그 생물에게 피해 3점을 입힌다. 이런 식으로 늑대인간이 피해를 입었다면, 그 생물을 파괴한다.\', \'type\': \'마법물체\', \'flavor\': \'"늑대인간이 달려들면, 단 한 발을 쏠 수 있는 시간밖에 없어. 맞히는 게 최선이지."\\n—에버하트 대장\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536952&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'28e2848c-a598-4a8d-a33a-60a5f5801e64\', \'multiverseId\': 536952}, \'multiverseid\': 536952}, {\'name\': \'Virote de Prata\', \'text\': \'{3}, {T}, sacrifique Virote de Prata: Ele causa 3 pontos de dano à criatura alvo. Se um Lobisomem sofrer dano dessa forma, destrua-o.\', \'type\': \'Artefato\', \'flavor\': \'"Quando um lobisomem avança, você só tem tempo para um tiro. É bom que seja na mosca."\\n— Capitão Eberheart\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537268&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'995aa5a8-d8f3-459d-8a40-1e38eebb9a1c\', \'multiverseId\': 537268}, \'multiverseid\': 537268}, {\'name\': \'Серебряный Болт\', \'text\': \'{3}, {T}, пожертвуйте Серебряный Болт: он наносит 3 повреждения целевому существу. Если таким образом наносятся повреждения Вервольфу, уничтожьте его.\', \'type\': \'Артефакт\', \'flavor\': \'«Когда вервольф бросается в атаку, у тебя будет время только на один выстрел. Не промахнись».\\n— капитан Эберхарт\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537584&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'41a5e3e5-c6ea-4af7-b923-bb1ea59213d6\', \'multiverseId\': 537584}, \'multiverseid\': 537584}, {\'name\': \'银弩矢\', \'text\': \'{3}，{T}，牺牲银弩矢：它对目标生物造成3点伤害。如果某狼人以此法受到伤害，则消灭该狼人。\', \'type\': \'神器\', \'flavor\': \'「狼人冲锋后，你只有射一箭的机会。不要浪费。」\\n～船长艾博汉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537900&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'272e0040-00b2-4b90-9b75-520565e512ce\', \'multiverseId\': 537900}, \'multiverseid\': 537900}, {\'name\': \'銀弩矢\', \'text\': \'{3}，{T}，犧牲銀弩矢：它對目標生物造成3點傷害。如果某狼人以此法受到傷害，則消滅該狼人。\', \'type\': \'神器\', \'flavor\': \'「狼人衝鋒後，你只有射一箭的機會。不要浪費。」\\n～船長艾博漢\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538216&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'dd909b35-3e06-4843-8c1b-9269105e533d\', \'multiverseId\': 538216}, \'multiverseid\': 538216}]', '[{\'name\': \'Silberschmied aus Gaven\', \'text\': \'Wenn der Silberschmied aus Gaven ins Spiel kommt, lege je eine +1/+1-Marke auf bis zu zwei Kreaturen deiner Wahl.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'Nicht seine Schmiedekunst sondern sein Glaube verlieh der Klinge ihre unnachgiebige Schneide.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535093&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bf573e30-0271-4940-92a4-c2485498f87f\', \'multiverseId\': 535093}, \'multiverseid\': 535093}, {\'name\': \'Platero de Gavony\', \'text\': \'Cuando el Platero de Gavony entre al campo de batalla, pon un contador +1/+1 sobre cada una de hasta dos criaturas objetivo.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'Lo que dio al arma ese filo implacable no fue tanto el calor ni la fuerza de su brazo, sino su fe.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535409&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a3c8cf69-9bbe-46fc-aaf9-20282f6bebd9\', \'multiverseId\': 535409}, \'multiverseid\': 535409}, {\'name\': \'Orfèvre de Gavonie\', \'text\': "Quand l\'Orfèvre de Gavonie arrive sur le champ de bataille, ciblez jusqu\'à deux créatures. Mettez un marqueur +1/+1 sur chacune d\'elles.", \'type\': \'Créature : humain et soldat\', \'flavor\': "C\'était sa foi, davantage que la chaleur et la force de son bras, qui donnait à la lame son tranchant magistral.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535725&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'78293363-a6c8-44ad-9024-dd2801a66a02\', \'multiverseId\': 535725}, \'multiverseid\': 535725}, {\'name\': \'Forgiargento di Gavony\', \'text\': \'Quando il Forgiargento di Gavony entra nel campo di battaglia, scegli fino a due creature bersaglio e metti un segnalino +1/+1 su ciascuna.\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'Ancor più del calore e della forza del suo braccio, era la sua fede a donare alle lame un filo impeccabile.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536041&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'956d3334-925b-4fd5-912b-502ea139a568\', \'multiverseId\': 536041}, \'multiverseid\': 536041}, {\'name\': \'ガヴォニーの銀鍛冶師\', \'text\': \'ガヴォニーの銀鍛冶師が戦場に出たとき、クリーチャー最大２体を対象とする。それらの上にそれぞれ＋１/＋１カウンター１個を置く。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'刃に頑固なまでの切れ味を与えたのは、熱や腕の力にもまして、彼の信仰であった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536357&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'93c521d7-376b-4a32-8417-70d40f7b0ba1\', \'multiverseId\': 536357}, \'multiverseid\': 536357}, {\'name\': \'가보니 은대장장이\', \'text\': \'가보니 은대장장이가 전장에 들어올 때, 생물을 최대 두 개까지 목표로 정한다. 그 생물들에 각각 +1/+1 카운터를 한 개씩 올려놓는다.\', \'type\': \'생물 — 인간 병사\', \'flavor\': \'열기와 그의 팔힘보다도, 그의 믿음이 칼에 무뎌지지 않는 날이 서게 해 주었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536673&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a9c74f7d-a7a4-45b5-b53d-bcd5946409d5\', \'multiverseId\': 536673}, \'multiverseid\': 536673}, {\'name\': \'Prateiro de Gavony\', \'text\': \'Quando Prateiro de Gavony entrar no campo de batalha, coloque um marcador +1/+1 em cada uma de até duas criaturas alvo.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': \'Não era tanto o calor da forja ou a força bruta de seu braço que tornava o fio da lâmina tão implacável, mas sim sua fé.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536989&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'936cb55a-b742-4765-91dd-efa311d89d8a\', \'multiverseId\': 536989}, \'multiverseid\': 536989}, {\'name\': \'Гевонский Среброкователь\', \'text\': \'Когда Гевонский Среброкователь выходит на поле битвы, положите один жетон +1/+1 на каждое из не более двух целевых существ.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'Прочность клинку придал жар, придала сила рук, но прежде всего — непоколебимая вера.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537305&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'983a6e08-fcf4-4f8a-988b-5dce1529d2e1\', \'multiverseId\': 537305}, \'multiverseid\': 537305}, {\'name\': \'加渥尼银匠\', \'text\': \'当加渥尼银匠进战场时，在至多两个目标生物上各放置一个+1/+1指示物。\', \'type\': \'生物 ～人类／士兵\', \'flavor\': \'令其手中刀刃锐利无匹的，并非只是熊熊炉火或精巧手艺，还有虔诚信念。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537621&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'12fada4a-ae78-4f2d-89e2-ab2292f444fe\', \'multiverseId\': 537621}, \'multiverseid\': 537621}, {\'name\': \'加渥尼銀匠\', \'text\': \'當加渥尼銀匠進戰場時，在至多兩個目標生物上各放置一個+1/+1指示物。\', \'type\': \'生物 ～人類／士兵\', \'flavor\': \'令其手中刀刃銳利無匹的，並非只是熊熊爐火或精巧手藝，還有虔誠信念。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537937&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3bea1356-479c-49f9-a9cc-e4010ba54b45\', \'multiverseId\': 537937}, \'multiverseid\': 537937}]', '[{\'name\': \'Skaab-Bändigerin\', \'text\': \'Tappe drei ungetappte Kreaturen, die du kontrollierst: Tappe eine Kreatur deiner Wahl.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'Nachdem Udas Hutboutique in Selhof von Werwölfen zerstört worden war, ließ sie sich außerhalb der Stadt nieder und wandte sich einer anderen Art der Näherei zu.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535157&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9004f8a0-e5fc-4d8d-9d4e-dd3ee3d5712f\', \'multiverseId\': 535157}, \'multiverseid\': 535157}, {\'name\': \'Domadora de skaabs\', \'text\': \'Girar tres criaturas enderezadas que controlas: Gira la criatura objetivo.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'Después de que los licántropos destrozasen la tienda de sombreros que tenía Uda en Selhoff, se mudó a las afueras de la ciudad y comenzó a coser otras cosas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535473&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'76d66ebe-b01e-4ea3-9c1f-73217dd81628\', \'multiverseId\': 535473}, \'multiverseid\': 535473}, {\'name\': \'Dompteuse de skaab\', \'text\': \'Engagez trois créatures dégagées que vous contrôlez : Engagez une créature ciblée.\', \'type\': \'Créature : humain et sorcier\', \'flavor\': "Suite à la destruction de sa boutique de chapeaux à Selhoff par des loups-garous, Uda s\'installa hors de la ville pour s\'adonner à un nouveau type de couture.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535789&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5dbc5b3f-f8d7-4832-8b2f-65a8db34c6d3\', \'multiverseId\': 535789}, \'multiverseid\': 535789}, {\'name\': \'Mandriana di Skaab\', \'text\': \'TAPpa tre creature STAPpate che controlli: TAPpa una creatura bersaglio.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': \'Quando la sua cappelleria a Selhoff fu distrutta dai mannari, Uda si trasferì fuori città e si dedicò a un tipo diverso di cuciture.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536105&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'35cf58d8-df90-4708-ad60-d8df4d39b56b\', \'multiverseId\': 536105}, \'multiverseid\': 536105}, {\'name\': \'スカーブの世話人\', \'text\': \'あなたがコントロールしているアンタップ状態のクリーチャー３体をタップする：クリーチャー１体を対象とする。それをタップする。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'セルホフにあったウダの帽子屋が人狼によって破壊された後、彼女は町はずれで一風変わった裁縫を始めた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536421&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8d3fbbd4-778b-42af-830b-f0b892dec1d0\', \'multiverseId\': 536421}, \'multiverseid\': 536421}, {\'name\': \'스캅 조련사\', \'text\': \'당신이 조종하는 생물 세 개를 탭한다: 생물을 목표로 정한다. 그 생물을 탭한다.\', \'type\': \'생물 — 인간 마법사\', \'flavor\': \'셀호프에 있던 우다의 모자 양품점이 늑대인간들에게 파괴된 뒤, 그녀는 가게를 마을 바깥으로 옮기고 다른 종류의 재봉일을 시작했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536737&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5fbd79f6-354c-42c4-99fa-bbbc79026208\', \'multiverseId\': 536737}, \'multiverseid\': 536737}, {\'name\': \'Domadora de Skaabs\', \'text\': \'Vire três criaturas desviradas que você controla: Vire a criatura alvo.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'Depois que a chapelaria de Uda em Selhoff foi destruída por lobisomens, ela saiu da cidade e passou a se dedicar a outro tipo de costura.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537053&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c6211304-440b-4624-b954-12beda864386\', \'multiverseId\': 537053}, \'multiverseid\': 537053}, {\'name\': \'Пастушка Скаабов\', \'text\': \'Поверните три неповернутых существа под вашим контролем: поверните целевое существо.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'После того как шляпный магазинчик Уды в Селхоффе разорили вервольфы, она уехала из города и занялась другим видом шитья.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537369&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f307741a-16f3-4821-9ce5-9d23b5f43bd4\', \'multiverseId\': 537369}, \'multiverseid\': 537369}, {\'name\': \'尸嵌驯师\', \'text\': \'横置三个由你操控且未横置的生物：横置目标生物。\', \'type\': \'生物 ～人类／法术师\', \'flavor\': \'乌妲在塞贺开的精品帽屋毁于狼人之手后，她便搬出城镇，决心展现自己另一门缝纫手艺。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537685&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8c3bc85c-dcfa-4e02-914e-141d8b808548\', \'multiverseId\': 537685}, \'multiverseid\': 537685}, {\'name\': \'屍嵌馴師\', \'text\': \'橫置三個由你操控且未橫置的生物：橫置目標生物。\', \'type\': \'生物 ～人類／魔法師\', \'flavor\': \'烏妲在塞賀開的精品帽屋毀於狼人之手後，她便搬出城鎮，決心展現自己另一門縫紉手藝。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538001&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'cdf7d700-49f2-43dd-ae40-9a82974cd9e7\', \'multiverseId\': 538001}, \'multiverseid\': 538001}]', '[{\'name\': \'Slogurk der Überschleim\', \'text\': \'Verursacht Trampelschaden\\nImmer wenn eine Länderkarte von irgendwoher auf deinen Friedhof gelegt wird, lege eine +1/+1-Marke auf Slogurk den Überschleim.\\nEntferne drei +1/+1-Marken von Slogurk: Bringe ihn auf die Hand seines Besitzers zurück.\\nWenn Slogurk das Spiel verlässt, bringe bis zu drei Länderkarten deiner Wahl aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Legendäre Kreatur — Schlammwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535354&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1ec273ca-fc70-4f4c-907c-aa5b3cfa7bf6\', \'multiverseId\': 535354}, \'multiverseid\': 535354}, {\'name\': \'Lenthidro, el Fango Supremo\', \'text\': \'Arrolla.\\nSiempre que una carta de tierra vaya a tu cementerio desde cualquier parte, pon un contador +1/+1 sobre Lenthidro, el Fango Supremo.\\nRemover tres contadores +1/+1 de Lenthidro: Regrésalo a la mano de su propietario.\\nCuando Lenthidro deje el campo de batalla, regresa hasta tres cartas de tierra objetivo de tu cementerio a tu mano.\', \'type\': \'Criatura legendaria — Cieno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535670&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e6e994ec-1c2f-4083-ac86-8479b4fa6312\', \'multiverseId\': 535670}, \'multiverseid\': 535670}, {\'name\': \'Slogurk, suzerain de boue\', \'text\': "Piétinement\\nÀ chaque fois qu\'une carte de terrain est mise dans votre cimetière d\'où qu\'elle vienne, mettez un marqueur +1/+1 sur Slogurk, suzerain de boue.\\nRetirez trois marqueurs +1/+1 de Slogurk : Renvoyez-le dans la main de son propriétaire.\\nQuand Slogurk quitte le champ de bataille, renvoyez jusqu\'à trois cartes de terrain ciblées depuis votre cimetière dans votre main.", \'type\': \'Créature légendaire : limon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535986&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c00afbf0-72dd-4626-b12e-c45825ad6096\', \'multiverseId\': 535986}, \'multiverseid\': 535986}, {\'name\': \'Slogurk, la Melma Sovrana\', \'text\': \'Travolgere\\nOgniqualvolta una carta terra viene messa nel tuo cimitero da qualsiasi zona, metti un segnalino +1/+1 su Slogurk, la Melma Sovrana.\\nRimuovi tre segnalini +1/+1 da Slogurk: Fallo tornare in mano al suo proprietario.\\nQuando Slogurk lascia il campo di battaglia, riprendi in mano fino a tre carte terra bersaglio dal tuo cimitero.\', \'type\': \'Creatura Leggendaria — Melma\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536302&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9cec98a2-37a6-4459-9098-d71b5fe1f303\', \'multiverseId\': 536302}, \'multiverseid\': 536302}, {\'name\': \'大スライム、スローグルク\', \'text\': \'トランプル\\n土地・カード１枚がいずこかからあなたの墓地に置かれるたび、大スライム、スローグルクの上に＋１/＋１カウンター１個を置く。\\n大スライム、スローグルクの上から＋１/＋１カウンター３個を取り除く：これをオーナーの手札に戻す。\\n大スライム、スローグルクが戦場を離れたとき、あなたの墓地にある土地・カード最大３枚を対象とする。それらをあなたの手札に戻す。\', \'type\': \'伝説のクリーチャー — ウーズ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536618&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'676a0188-8035-41b8-8b11-02fb6b372d45\', \'multiverseId\': 536618}, \'multiverseid\': 536618}, {\'name\': \'초거대 점액괴물, 슬로거크\', \'text\': \'돌진\\n대지 카드가 어디에서든 당신의 무덤에 놓일 때마다, 초거대 점액괴물, 슬로거크에 +1/+1 카운터 한 개를 올려놓는다.\\n슬로거크에서 +1/+1 카운터 세 개를 제거한다: 슬로거크를 소유자의 손으로 되돌린다.\\n슬로거크가 전장을 떠날 때, 당신의 무덤에 있는 대지 카드를 최대 세 장까지 목표로 정한다. 그 카드들을 당신의 손으로 되돌린다.\', \'type\': \'전설적 생물 — 점액괴물\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536934&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'459d5916-4824-49af-8bff-b114c4f885bd\', \'multiverseId\': 536934}, \'multiverseid\': 536934}, {\'name\': \'Slogurk, o Limo Supremo\', \'text\': \'Atropelar\\nToda vez que um card de terreno for colocado no seu cemitério vindo de qualquer lugar, coloque um marcador +1/+1 em Slogurk, o Limo Supremo.\\nRemova três marcadores +1/+1 de Slogurk: Devolva-o para a mão de seu dono.\\nQuando Slogurk deixar o campo de batalha, devolva até três cards de terreno alvo de seu cemitério para sua mão.\', \'type\': \'Criatura Lendária — Lodo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537250&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4415303a-624c-479f-8932-2800fd26b94f\', \'multiverseId\': 537250}, \'multiverseid\': 537250}, {\'name\': \'Слогурк, Сверхслизь\', \'text\': \'Пробивной удар\\nКаждый раз, когда карта земли попадает откуда-либо на ваше кладбище, положите один жетон +1/+1 на Слогурка, Сверхслизь.\\nУдалите три жетона +1/+1 со Слогурка: верните его в руку его владельца.\\nКогда Слогурк покидает поле битвы, верните не более трех целевых карт земель из вашего кладбища в вашу руку.\', \'type\': \'Легендарное Существо — Тина\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537566&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9877d977-58ac-45c8-99ee-37aa57290b0d\', \'multiverseId\': 537566}, \'multiverseid\': 537566}, {\'name\': \'流浆王斯罗咕\', \'text\': \'践踏\\n每当一张地牌从任何区域进入你的坟墓场时，在流浆王斯罗咕上放置一个+1/+1指示物。\\n从斯罗咕上移去三个+1/+1指示物：将它移回其拥有者手上。\\n当斯罗咕离开战场时，将至多三张目标地牌从你的坟墓场移回你手上。\', \'type\': \'传奇生物 ～流浆\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537882&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'01e52373-c21b-4c20-9d40-a4a61f628732\', \'multiverseId\': 537882}, \'multiverseid\': 537882}, {\'name\': \'流漿王斯羅咕\', \'text\': \'踐踏\\n每當一張地牌從任何區域進入你的墳墓場時，在流漿王斯羅咕上放置一個+1/+1指示物。\\n從斯羅咕上移去三個+1/+1指示物：將它移回其擁有者手上。\\n當斯羅咕離開戰場時，將至多三張目標地牌從你的墳墓場移回你手上。\', \'type\': \'傳奇生物 ～流漿\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538198&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2a1f7fed-5a65-4622-b90e-960e1df28828\', \'multiverseId\': 538198}, \'multiverseid\': 538198}]', '[{\'name\': \'Slogurk der Überschleim\', \'text\': \'Verursacht Trampelschaden\\nImmer wenn eine Länderkarte von irgendwoher auf deinen Friedhof gelegt wird, lege eine +1/+1-Marke auf Slogurk den Überschleim.\\nEntferne drei +1/+1-Marken von Slogurk: Bringe ihn auf die Hand seines Besitzers zurück.\\nWenn Slogurk das Spiel verlässt, bringe bis zu drei Länderkarten deiner Wahl aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Legendäre Kreatur — Schlammwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538523&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'95e284d6-943d-4439-84be-58d581536b29\', \'multiverseId\': 538523}, \'multiverseid\': 538523}, {\'name\': \'Lenthidro, el Fango Supremo\', \'text\': \'Arrolla.\\nSiempre que una carta de tierra vaya a tu cementerio desde cualquier parte, pon un contador +1/+1 sobre Lenthidro, el Fango Supremo.\\nRemover tres contadores +1/+1 de Lenthidro: Regrésalo a la mano de su propietario.\\nCuando Lenthidro deje el campo de batalla, regresa hasta tres cartas de tierra objetivo de tu cementerio a tu mano.\', \'type\': \'Criatura legendaria — Cieno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538540&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'18a662b4-f0ab-4a17-a5ca-0a8bc03f1be2\', \'multiverseId\': 538540}, \'multiverseid\': 538540}, {\'name\': \'Slogurk, suzerain de boue\', \'text\': "Piétinement\\nÀ chaque fois qu\'une carte de terrain est mise dans votre cimetière d\'où qu\'elle vienne, mettez un marqueur +1/+1 sur Slogurk, suzerain de boue.\\nRetirez trois marqueurs +1/+1 de Slogurk : Renvoyez-le dans la main de son propriétaire.\\nQuand Slogurk quitte le champ de bataille, renvoyez jusqu\'à trois cartes de terrain ciblées depuis votre cimetière dans votre main.", \'type\': \'Créature légendaire : limon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538557&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'296ae0e9-a1ae-44df-ae72-460b1ada20c6\', \'multiverseId\': 538557}, \'multiverseid\': 538557}, {\'name\': \'Slogurk, la Melma Sovrana\', \'text\': \'Travolgere\\nOgniqualvolta una carta terra viene messa nel tuo cimitero da qualsiasi zona, metti un segnalino +1/+1 su Slogurk, la Melma Sovrana.\\nRimuovi tre segnalini +1/+1 da Slogurk: Fallo tornare in mano al suo proprietario.\\nQuando Slogurk lascia il campo di battaglia, riprendi in mano fino a tre carte terra bersaglio dal tuo cimitero.\', \'type\': \'Creatura Leggendaria — Melma\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538574&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b76e2961-fcbc-4f04-af62-73303eaf6465\', \'multiverseId\': 538574}, \'multiverseid\': 538574}, {\'name\': \'大スライム、スローグルク\', \'text\': \'トランプル\\n土地・カード１枚がいずこかからあなたの墓地に置かれるたび、大スライム、スローグルクの上に＋１/＋１カウンター１個を置く。\\n大スライム、スローグルクの上から＋１/＋１カウンター３個を取り除く：これをオーナーの手札に戻す。\\n大スライム、スローグルクが戦場を離れたとき、あなたの墓地にある土地・カード最大３枚を対象とする。それらをあなたの手札に戻す。\', \'type\': \'伝説のクリーチャー — ウーズ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538591&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'15decc7f-d50c-430f-8cab-e07449a59571\', \'multiverseId\': 538591}, \'multiverseid\': 538591}, {\'name\': \'초거대 점액괴물, 슬로거크\', \'text\': \'돌진\\n대지 카드가 어디에서든 당신의 무덤에 놓일 때마다, 초거대 점액괴물, 슬로거크에 +1/+1 카운터 한 개를 올려놓는다.\\n슬로거크에서 +1/+1 카운터 세 개를 제거한다: 슬로거크를 소유자의 손으로 되돌린다.\\n슬로거크가 전장을 떠날 때, 당신의 무덤에 있는 대지 카드를 최대 세 장까지 목표로 정한다. 그 카드들을 당신의 손으로 되돌린다.\', \'type\': \'전설적 생물 — 점액괴물\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538608&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'333c74b2-1198-48b9-8fb6-506db41753b1\', \'multiverseId\': 538608}, \'multiverseid\': 538608}, {\'name\': \'Slogurk, o Limo Supremo\', \'text\': \'Atropelar\\nToda vez que um card de terreno for colocado no seu cemitério vindo de qualquer lugar, coloque um marcador +1/+1 em Slogurk, o Limo Supremo.\\nRemova três marcadores +1/+1 de Slogurk: Devolva-o para a mão de seu dono.\\nQuando Slogurk deixar o campo de batalha, devolva até três cards de terreno alvo de seu cemitério para sua mão.\', \'type\': \'Criatura Lendária — Lodo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538625&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'37441216-59e5-42ce-b542-4d1217e33248\', \'multiverseId\': 538625}, \'multiverseid\': 538625}, {\'name\': \'Слогурк, Сверхслизь\', \'text\': \'Пробивной удар\\nКаждый раз, когда карта земли попадает откуда-либо на ваше кладбище, положите один жетон +1/+1 на Слогурка, Сверхслизь.\\nУдалите три жетона +1/+1 со Слогурка: верните его в руку владельца.\\nКогда Слогурк покидает поле битвы, верните не более трех целевых карт земель из вашего кладбища в вашу руку.\', \'type\': \'Легендарное Существо — Тина\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538642&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cb8c2909-9874-4fc5-9160-e0d4c529c02e\', \'multiverseId\': 538642}, \'multiverseid\': 538642}, {\'name\': \'流浆王斯罗咕\', \'text\': \'践踏\\n每当一张地牌从任何区域进入你的坟墓场时，在流浆王斯罗咕上放置一个+1/+1指示物。\\n从斯罗咕上移去三个+1/+1指示物：将它移回其拥有者手上。\\n当斯罗咕离开战场时，将至多三张目标地牌从你的坟墓场移回你手上。\', \'type\': \'传奇生物 ～流浆\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538659&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'da477af6-df77-4e4c-b4e4-3ce8a71ebfbc\', \'multiverseId\': 538659}, \'multiverseid\': 538659}, {\'name\': \'流漿王斯羅咕\', \'text\': \'踐踏\\n每當一張地牌從任何區域進入你的墳墓場時，在流漿王斯羅咕上放置一個+1/+1指示物。\\n從斯羅咕上移去三個+1/+1指示物：將它移回其擁有者手上。\\n當斯羅咕離開戰場時，將至多三張目標地牌從你的墳墓場移回你手上。\', \'type\': \'傳奇生物 ～流漿\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538676&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4707bf57-627e-4fc9-ac35-b7f17aa7a14d\', \'multiverseId\': 538676}, \'multiverseid\': 538676}]', '[{\'name\': \'Sonnengold-Sperrfeuer\', \'text\': \'Zerstöre eine Kreatur deiner Wahl mit Widerstandskraft 4 oder mehr.\', \'type\': \'Spontanzauber\', \'flavor\': \'Heida gestattete sich einen Augenblick der Zufriedenheit, als sie die Bestie fallen sah, und wandte sich dann ab, um nach dem nächsten Gegner zu suchen. Es würde eine lange, lange Nacht werden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535110&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d1a119ee-5ba5-4484-9bac-07204c241701\', \'multiverseId\': 535110}, \'multiverseid\': 535110}, {\'name\': \'Descarga de orosolar\', \'text\': \'Destruye la criatura objetivo con resistencia de 4 o más.\', \'type\': \'Instantáneo\', \'flavor\': \'Heida disfrutó al ver cómo moría la bestia y se marchó en busca de otro enemigo. Iba a ser una noche de lo más larga.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535426&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2a582983-e4a5-47b2-9001-308a7f2be789\', \'multiverseId\': 535426}, \'multiverseid\': 535426}, {\'name\': "Barrage d\'or solaire", \'text\': "Détruisez une créature ciblée d\'endurance supérieure ou égale à 4.", \'type\': \'Éphémère\', \'flavor\': "Heida s\'accorda un moment de satisfaction en regardant la bête tomber, puis se mit en quête d\'un autre ennemi. La nuit s\'annonçait longue, très longue.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535742&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'34b33bfb-cc75-4258-9369-1255a706aa97\', \'multiverseId\': 535742}, \'multiverseid\': 535742}, {\'name\': \'Raffica di Eliodoro\', \'text\': \'Distruggi una creatura bersaglio con costituzione pari o superiore a 4.\', \'type\': \'Istantaneo\', \'flavor\': "Heida si concesse un momento di soddisfazione nell\'osservare la bestia cadere, poi si girò in cerca di un altro avversario. Sarebbe stata una lunga, lunga notte.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536058&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d050a0b3-f5b1-44ca-9ceb-1bb662c49ee2\', \'multiverseId\': 536058}, \'multiverseid\': 536058}, {\'name\': \'日金の連射\', \'text\': \'タフネスが４以上のクリーチャー１体を対象とする。それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'ハイダは獣が崩れ落ちる姿を見つめながら、一瞬だけ喜びに浸った。そして次の敵へと振り返った。それは長い長い夜の始まりに過ぎなかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536374&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3ac88c09-2078-4af1-b55d-db840a98982c\', \'multiverseId\': 536374}, \'multiverseid\': 536374}, {\'name\': \'태양황금 일제사격\', \'text\': \'방어력이 4 이상인 생물을 목표로 정한다. 그 생물을 파괴한다.\', \'type\': \'순간마법\', \'flavor\': \'하이다는 짐승이 쓰러지는 것을 보고 잠시 만족한 뒤, 이내 다른 적을 찾아 몸을 돌렸다. 아주 길고 긴 밤이 될 터였다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536690&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'30947cfe-67d8-4876-864e-2c990c3e5278\', \'multiverseId\': 536690}, \'multiverseid\': 536690}, {\'name\': \'Salva de Ouro Solar\', \'text\': \'Destrua a criatura alvo com resistência igual ou superior a 4.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Heida concedeu-se um momento de satisfação assistindo à queda da fera, e então se virou para buscar outro oponente. Aquela seria uma noite longa, bem longa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537006&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8feb2107-bfb9-4f3c-a8ae-0eb8a9539fd6\', \'multiverseId\': 537006}, \'multiverseid\': 537006}, {\'name\': \'Залп Солнечного Золота\', \'text\': \'Уничтожьте целевое существо с выносливостью 4 или больше.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Хейда позволила себе остановиться на мгновение, удовлетворенно наблюдая за тем, как падает зверь, а затем повернулась в поисках нового врага. Ночь обещала быть долгой.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537322&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cb7f2caf-f244-4865-a8a3-36795afed8ea\', \'multiverseId\': 537322}, \'multiverseid\': 537322}, {\'name\': \'旭金齐射\', \'text\': \'消灭目标防御力等于或大于4的生物。\', \'type\': \'瞬间\', \'flavor\': \'在野兽倒下那一瞬间，亥妲放开紧绷神经沉浸这一胜利时刻，然后便转头去找下一个敌人。这注定会是个漫漫长夜。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537638&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3abfa703-f065-4651-ab2b-a3c405988159\', \'multiverseId\': 537638}, \'multiverseid\': 537638}, {\'name\': \'旭金齊射\', \'text\': \'消滅目標防禦力等於或大於4的生物。\', \'type\': \'瞬間\', \'flavor\': \'在野獸倒下那一瞬間，亥妲放開緊繃神經沉浸這一勝利時刻，然後便轉頭去找下一個敵人。這註定會是個漫漫長夜。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537954&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5281e38c-0d1f-4de9-9dbf-05758a1a310f\', \'multiverseId\': 537954}, \'multiverseid\': 537954}]', '[{\'name\': \'Sonnengold-Wächterin\', \'text\': \'Immer wenn die Sonnengold-Wächterin ins Spiel kommt oder angreift, schicke bis zu eine Karte deiner Wahl aus einem Friedhof ins Exil.\\nHexenzirkel — {1}{W}: Bestimme eine Farbe. Die Sonnengold-Wächterin erhält bis zum Ende des Zuges Fluchsicherheit vor der bestimmten Farbe und kann in diesem Zug von Kreaturen dieser Farbe nicht geblockt werden. Aktiviere diese Fähigkeit nur, falls du drei oder mehr Kreaturen mit unterschiedlicher Stärke kontrollierst.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535111&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6e9bc8b3-c25c-4f74-a6bb-b19b5dca0411\', \'multiverseId\': 535111}, \'multiverseid\': 535111}, {\'name\': \'Centinela de orosolar\', \'text\': \'Siempre que la Centinela de orosolar entre al campo de batalla o ataque, exilia hasta una carta objetivo de un cementerio.\\nAquelarre — {1}{W}: Elige un color. La Centinela de orosolar gana la habilidad de antimaleficio contra ese color hasta el final del turno y no puede ser bloqueada por criaturas de ese color este turno. Activa esto solo si controlas tres o más criaturas con fuerzas distintas.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535427&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'16c73a86-cc88-4674-a456-3af2133a75ad\', \'multiverseId\': 535427}, \'multiverseid\': 535427}, {\'name\': "Sentinelle d\'or solaire", \'text\': "À chaque fois que la Sentinelle d\'or solaire arrive sur le champ de bataille ou qu\'elle attaque, exilez jusqu\'à une carte ciblée depuis un cimetière.\\nCongrégation — {1}{W} : Choisissez une couleur. La Sentinelle d\'or solaire acquiert la défense talismanique contre cette couleur jusqu\'à la fin du tour et ne peut pas être bloquée par les créatures de cette couleur ce tour-ci. N\'activez que si vous contrôlez au moins trois créatures avec des forces différentes.", \'type\': \'Créature : humain et soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535743&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e97235a0-db8a-41af-b80b-edb494265786\', \'multiverseId\': 535743}, \'multiverseid\': 535743}, {\'name\': "Sentinella dell\'Eliodoro", \'text\': "Ogniqualvolta la Sentinella dell\'Eliodoro entra nel campo di battaglia o attacca, esilia fino a una carta bersaglio da un cimitero.\\nCongrega — {1}{W}: Scegli un colore. La Sentinella dell\'Eliodoro ha anti-malocchio da quel colore fino alla fine del turno e non può essere bloccata da creature di quel colore in questo turno. Attiva solo se controlli tre o più creature con forza diversa.", \'type\': \'Creatura — Soldato Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536059&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bd5729e3-4829-458e-b197-8ad999acdf20\', \'multiverseId\': 536059}, \'multiverseid\': 536059}, {\'name\': \'日金の歩哨\', \'text\': \'日金の歩哨が戦場に出るか攻撃するたび、墓地にあるカード最大１枚を対象とする。それを追放する。\\n集会 — {1}{W}：色１色を選ぶ。ターン終了時まで、日金の歩哨はその色からの呪禁を得る。このターン、これはその色のクリーチャーにはブロックされない。あなたがパワーが異なる３体以上のクリーチャーをコントロールしていなければ起動できない。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536375&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a00d3336-afb0-4d13-a321-3da77565a533\', \'multiverseId\': 536375}, \'multiverseid\': 536375}, {\'name\': \'태양황금 보초병\', \'text\': \'태양황금 보초병이 전장에 들어오거나 공격할 때마다, 무덤에 있는 카드를 최대 한 장까지 목표로 정한다. 그 카드를 추방한다.\\n집회 — {1}{W}: 색 하나를 선택한다. 태양황금 보초병은 턴종료까지 그 색으로부터 방호를 얻으며 이 턴에 그 색을 가진 생물들에게 방어될 수 없다. 당신이 서로 다른 공격력을 가진 생물을 세 개 이상 조종하는 경우에만 활성화할 수 있다.\', \'type\': \'생물 — 인간 병사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536691&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'77d66c28-c678-4e8c-b1f3-2dd4c33f9029\', \'multiverseId\': 536691}, \'multiverseid\': 536691}, {\'name\': \'Sentinela do Ouro Solar\', \'text\': \'Toda vez que Sentinela do Ouro Solar entrar no campo de batalha ou atacar, exile até um card alvo de um cemitério.\\nConventículo — {1}{W}: Escolha uma cor. Sentinela do Ouro Solar ganha resistência à magia daquela cor até o final do turno e não pode ser bloqueada por criaturas daquela cor neste turno. Ative somente se você controlar três ou mais criaturas com poderes diferentes.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537007&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'064cd08c-d68f-4ba4-8bfd-70dfe03b9d72\', \'multiverseId\': 537007}, \'multiverseid\': 537007}, {\'name\': \'Часовая Солнечного Золота\', \'text\': \'Каждый раз, когда Часовая Солнечного Золота выходит на поле битвы или атакует, изгоните не более одной целевой карты из кладбища.\\nШабаш — {1}{W}: выберите цвет. Часовая Солнечного Золота получает Порчеустойчивость от того цвета до конца хода и не может быть заблокирована существами того цвета в этом ходу. Активируйте, только если вы контролируете не менее трех существ с различными значениями силы.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537323&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f742da86-7a7b-4ce1-b014-e65d589b1cf3\', \'multiverseId\': 537323}, \'multiverseid\': 537323}, {\'name\': \'旭金哨卫\', \'text\': \'每当旭金哨卫进战场或攻击时，将至多一张目标牌从坟墓场放逐。\\n鸠集～{1}{W}：选择一种颜色。旭金哨卫获得反该色辟邪异能直到回合结束，且本回合不能被该色生物阻挡。只能于你操控三个或更多力量各不相同的生物时起动。\', \'type\': \'生物 ～人类／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537639&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'df71794e-92b1-43f4-be33-123c9453068f\', \'multiverseId\': 537639}, \'multiverseid\': 537639}, {\'name\': \'旭金哨衛\', \'text\': \'每當旭金哨衛進戰場或攻擊時，將至多一張目標牌從墳墓場放逐。\\n鳩集～{1}{W}：選擇一種顏色。旭金哨衛獲得反該色辟邪異能直到回合結束，且本回合不能被該色生物阻擋。只能於你操控三個或更多力量各不相同的生物時起動。\', \'type\': \'生物 ～人類／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537955&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1fea829f-0e95-4225-b1f2-8d4a48258f8e\', \'multiverseId\': 537955}, \'multiverseid\': 537955}]', '[{\'name\': \'Sonnengold-Wächterin\', \'text\': \'Immer wenn die Sonnengold-Wächterin ins Spiel kommt oder angreift, schicke bis zu eine Karte deiner Wahl aus einem Friedhof ins Exil.\\nHexenzirkel — {1}{W}: Bestimme eine Farbe. Die Sonnengold-Wächterin erhält bis zum Ende des Zuges Fluchsicherheit vor dieser Farbe und kann in diesem Zug von Kreaturen dieser Farbe nicht geblockt werden. Aktiviere diese Fähigkeit nur, falls du drei oder mehr Kreaturen mit unterschiedlicher Stärke kontrollierst.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538745&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7d340a13-f295-4d55-8521-c48560e4dd34\', \'multiverseId\': 538745}, \'multiverseid\': 538745}, {\'name\': \'Centinela de orosolar\', \'text\': \'Siempre que la Centinela de orosolar entre al campo de batalla o ataque, exilia hasta una carta objetivo de un cementerio.\\nAquelarre — {1}{W}: Elige un color. La Centinela de orosolar gana la habilidad de antimaleficio contra ese color hasta el final del turno y no puede ser bloqueada por criaturas de ese color este turno. Activa esto solo si controlas tres o más criaturas con fuerzas distintas.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538805&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'720028f2-2b78-47d2-9427-fe4a18fae697\', \'multiverseId\': 538805}, \'multiverseid\': 538805}, {\'name\': "Sentinelle d\'or solaire", \'text\': "À chaque fois que la Sentinelle d\'or solaire arrive sur le champ de bataille ou qu\'elle attaque, exilez jusqu\'à une carte ciblée depuis un cimetière.\\nCongrégation — {1}{W} : Choisissez une couleur. La Sentinelle d\'or solaire acquiert la défense talismanique contre cette couleur jusqu\'à la fin du tour et ne peut pas être bloquée par les créatures de cette couleur ce tour-ci. N\'activez que si vous contrôlez au moins trois créatures avec des forces différentes.", \'type\': \'Créature : humain et soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538865&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4b04d159-7357-4540-93ce-509cfb63a648\', \'multiverseId\': 538865}, \'multiverseid\': 538865}, {\'name\': "Sentinella dell\'Eliodoro", \'text\': "Ogniqualvolta la Sentinella dell\'Eliodoro entra nel campo di battaglia o attacca, esilia fino a una carta bersaglio da un cimitero.\\nCongrega — {1}{W}: Scegli un colore. La Sentinella dell\'Eliodoro ha anti-malocchio da quel colore fino alla fine del turno e non può essere bloccata da creature di quel colore in questo turno. Attiva solo se controlli tre o più creature con forza diversa.", \'type\': \'Creatura — Soldato Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538925&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f91a99e5-e12a-448b-b379-ff03009dbf8a\', \'multiverseId\': 538925}, \'multiverseid\': 538925}, {\'name\': \'日金の歩哨\', \'text\': \'日金の歩哨が戦場に出るか攻撃するたび、墓地にあるカード最大１枚を対象とする。それを追放する。\\n集会 — {1}{W}：色１色を選ぶ。ターン終了時まで、日金の歩哨はその色からの呪禁を得る。このターン、これはその色のクリーチャーにはブロックされない。あなたがパワーが異なる３体以上のクリーチャーをコントロールしていなければ起動できない。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538985&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'49121de4-eb3f-44e3-a9d9-60b149a2142b\', \'multiverseId\': 538985}, \'multiverseid\': 538985}]', '[{\'name\': \'Sonnenstreif-Phoenix\', \'text\': \'Fliegend\\nFalls es weder Tag noch Nacht ist, wird es Tag, sowie der Sonnenstreif-Phoenix ins Spiel kommt.\\nImmer wenn der Tag zur Nacht oder die Nacht zum Tag wird, kannst du {1}{R} bezahlen. Falls du dies tust, bringe den Sonnenstreif-Phoenix aus deinem Friedhof getappt ins Spiel zurück.\', \'type\': \'Kreatur — Phoenix\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535260&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9191aacd-261f-478a-b5cd-9e1ceccc3469\', \'multiverseId\': 535260}, \'multiverseid\': 535260}, {\'name\': \'Fénix de plumas solares\', \'text\': \'Vuela.\\nSi no es ni de día ni de noche, se hace de día en cuanto el Fénix de plumas solares entre al campo de batalla.\\nSiempre que se pase del día a la noche o de la noche al día, puedes pagar {1}{R}. Si lo haces, regresa el Fénix de plumas solares de tu cementerio al campo de batalla girado.\', \'type\': \'Criatura — Fénix\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535576&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'949d470e-06ff-4a29-be9f-b1ce4a90079d\', \'multiverseId\': 535576}, \'multiverseid\': 535576}, {\'name\': \'Phénix rayon de soleil\', \'text\': "Vol\\nSi ce n\'est ni le jour ni la nuit, on passe au jour au moment où le Phénix rayon de soleil arrive sur le champ de bataille.\\nÀ chaque fois qu\'on passe du jour à la nuit ou de la nuit au jour, vous pouvez payer {1}{R}. Si vous faites ainsi, renvoyez le Phénix rayon de soleil sur le champ de bataille, engagé, depuis votre cimetière.", \'type\': \'Créature : phénix\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535892&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d8f57f2b-7666-4162-8f2d-d2f2a97857d8\', \'multiverseId\': 535892}, \'multiverseid\': 535892}, {\'name\': \'Fenice Tracciasole\', \'text\': \'Volare\\nSe non è né giorno né notte, diventa giorno mentre la Fenice Tracciasole entra nel campo di battaglia.\\nOgniqualvolta il giorno diventa notte o la notte diventa giorno, puoi pagare {1}{R}. Se lo fai, rimetti sul campo di battaglia la Fenice Tracciasole TAPpata dal tuo cimitero.\', \'type\': \'Creatura — Fenice\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536208&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fa925937-8afd-41a9-a02d-8caee7168849\', \'multiverseId\': 536208}, \'multiverseid\': 536208}, {\'name\': \'太陽筋のフェニックス\', \'text\': \'飛行\\n太陽筋のフェニックスが戦場に出るに際し、昼でも夜でもないなら、昼になる。\\n昼が夜になるか夜が昼になるたび、あなたは{1}{R}を支払ってもよい。そうしたなら、あなたの墓地にある太陽筋のフェニックスをタップ状態で戦場に戻す。\', \'type\': \'クリーチャー — フェニックス\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536524&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8d546f19-fa98-4bc1-a7cc-04b4a43e5928\', \'multiverseId\': 536524}, \'multiverseid\': 536524}, {\'name\': \'태양궤적 불사조\', \'text\': \'비행\\n낮도 밤도 아니라면, 태양궤적 불사조가 전장에 들어오면서 낮이 된다.\\n낮이 밤이 되거나 밤이 낮이 될 때마다, 당신은 {1}{R}를 지불할 수 있다. 그렇게 한다면, 태양궤적 불사조를 당신의 무덤에서 탭된 채로 전장으로 되돌린다.\', \'type\': \'생물 — 불사조\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536840&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c76872e6-6131-4953-9cd1-2d998c397576\', \'multiverseId\': 536840}, \'multiverseid\': 536840}, {\'name\': \'Fênix Flecha-de-sol\', \'text\': \'Voar\\nSe não for dia nem noite, torna-se dia conforme Fênix Flecha-de-sol entra no campo de batalha.\\nToda vez que o dia se torna noite ou a noite se torna dia, você pode pagar {1}{R}. Se fizer isso, devolva Fênix Flecha-de-sol de seu cemitério para o campo de batalha virado.\', \'type\': \'Criatura — Fênix\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537156&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'36ee9a22-6961-4f78-8be6-8f3ba1f3b9e7\', \'multiverseId\': 537156}, \'multiverseid\': 537156}, {\'name\': \'Феникс Солнечной Вспышки\', \'text\': \'Полет\\nЕсли не стоит ни день, ни ночь, то при выходе Феникса Солнечной Вспышки на поле битвы наступает день.\\nКаждый раз, когда день становится ночью или ночь становится днем, вы можете заплатить {1}{R}. Если вы это делаете, верните Феникса Солнечной Вспышки из вашего кладбища на поле битвы повернутым.\', \'type\': \'Существо — Феникс\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537472&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4ff116a2-e12d-4619-9bff-817de0eaedb5\', \'multiverseId\': 537472}, \'multiverseid\': 537472}, {\'name\': \'旭缕凤凰\', \'text\': \'飞行\\n如果当前既非白昼也非黑夜，则于旭缕凤凰进战场时成为白昼。\\n每当白昼成为黑夜或黑夜成为白昼时，你可以支付{1}{R}。若你如此作，则将旭缕凤凰从你的坟墓场横置移回战场。\', \'type\': \'生物 ～凤凰\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537788&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0e0848dd-4ef6-4e96-a194-c877d1afa6bb\', \'multiverseId\': 537788}, \'multiverseid\': 537788}, {\'name\': \'旭縷鳳凰\', \'text\': \'飛行\\n如果當前既非白晝也非黑夜，則於旭縷鳳凰進戰場時成為白晝。\\n每當白晝成為黑夜或黑夜成為白晝時，你可以支付{1}{R}。若你如此作，則將旭縷鳳凰從你的墳墓場橫置移回戰場。\', \'type\': \'生物 ～鳳凰\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538104&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f1dc2963-7987-45c8-95fb-0c84bd782c95\', \'multiverseId\': 538104}, \'multiverseid\': 538104}]', '[{\'name\': \'Sonnenstreif-Phoenix\', \'text\': \'Fliegend\\nFalls es weder Tag noch Nacht ist, wird es Tag, sowie der Sonnenstreif-Phoenix ins Spiel kommt.\\nImmer wenn der Tag zur Nacht oder die Nacht zum Tag wird, kannst du {1}{R} bezahlen. Falls du dies tust, bringe den Sonnenstreif-Phoenix aus deinem Friedhof getappt ins Spiel zurück.\', \'type\': \'Kreatur — Phoenix\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538776&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'19970247-2ba8-469e-8c08-d6ae55488ca9\', \'multiverseId\': 538776}, \'multiverseid\': 538776}, {\'name\': \'Fénix de plumas solares\', \'text\': \'Vuela.\\nSi no es ni de día ni de noche, se hace de día en cuanto el Fénix de plumas solares entre al campo de batalla.\\nSiempre que se pase del día a la noche o de la noche al día, puedes pagar {1}{R}. Si lo haces, regresa el Fénix de plumas solares de tu cementerio al campo de batalla girado.\', \'type\': \'Criatura — Fénix\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538836&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3dde9f2f-f3a2-4ff8-a889-cdee8729ce1f\', \'multiverseId\': 538836}, \'multiverseid\': 538836}, {\'name\': \'Phénix rayon de soleil\', \'text\': "Vol\\nSi ce n\'est ni le jour ni la nuit, on passe au jour au moment où le Phénix rayon de soleil arrive sur le champ de bataille.\\nÀ chaque fois qu\'on passe du jour à la nuit ou de la nuit au jour, vous pouvez payer {1}{R}. Si vous faites ainsi, renvoyez le Phénix rayon de soleil sur le champ de bataille, engagé, depuis votre cimetière.", \'type\': \'Créature : phénix\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538896&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'89e5dc93-cc57-4e93-a74d-c7141dbc94ab\', \'multiverseId\': 538896}, \'multiverseid\': 538896}, {\'name\': \'Fenice Tracciasole\', \'text\': \'Volare\\nSe non è né giorno né notte, diventa giorno mentre la Fenice Tracciasole entra nel campo di battaglia.\\nOgniqualvolta il giorno diventa notte o la notte diventa giorno, puoi pagare {1}{R}. Se lo fai, rimetti sul campo di battaglia la Fenice Tracciasole TAPpata dal tuo cimitero.\', \'type\': \'Creatura — Fenice\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538956&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a48336ed-29f0-4b36-bf94-c6fd90c48aab\', \'multiverseId\': 538956}, \'multiverseid\': 538956}, {\'name\': \'太陽筋のフェニックス\', \'text\': \'飛行\\n太陽筋のフェニックスが戦場に出るに際し、昼でも夜でもないなら、昼になる。\\n昼が夜になるか夜が昼になるたび、あなたは{1}{R}を支払ってもよい。そうしたなら、あなたの墓地にある太陽筋のフェニックスをタップ状態で戦場に戻す。\', \'type\': \'クリーチャー — フェニックス\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539016&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'20bb9f6f-50fd-472e-9b60-10186dd6cedc\', \'multiverseId\': 539016}, \'multiverseid\': 539016}]', '[{\'name\': \'Spektraler Widersacher\', \'text\': \'Aufblitzen\\nFliegend\\nWenn der Spektrale Widersacher ins Spiel kommt, kannst du beliebig oft {1}{U} bezahlen. Wenn du diese Kosten ein- oder mehrmals bezahlst, lege entsprechend viele +1/+1-Marken auf den Spektralen Widersacher. Dann destabilisieren sich bis zu entsprechend viele andere Artefakte, Kreaturen und/oder Verzauberungen deiner Wahl.\', \'type\': \'Kreatur — Geist\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535159&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'95a40d9a-dc76-44ab-b744-b92ee817c420\', \'multiverseId\': 535159}, \'multiverseid\': 535159}, {\'name\': \'Adversario espectral\', \'text\': \'Destello.\\nVuela.\\nCuando el Adversario espectral entre al campo de batalla, puedes pagar {1}{U} tantas veces como quieras. Cuando pagues este coste una o más veces, pon esa misma cantidad de contadores +1/+1 sobre el Adversario espectral, luego salen de fase hasta esa misma cantidad de otros artefactos, criaturas y/o encantamientos objetivo.\', \'type\': \'Criatura — Espíritu\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535475&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7781efbc-ff3e-4a7b-b884-74f11c92a129\', \'multiverseId\': 535475}, \'multiverseid\': 535475}, {\'name\': \'Adversaire spectral\', \'text\': "Flash\\nVol\\nQuand l\'Adversaire spectral arrive sur le champ de bataille, vous pouvez payer {1}{U} autant de fois que vous le souhaitez. Quand vous payez ce coût au moins une fois, mettez autant de marqueurs +1/+1 sur l\'Adversaire spectral, puis jusqu\'à autant d\'autres cibles, artefacts, créatures et/ou enchantements, passent hors phase.", \'type\': \'Créature : esprit\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535791&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3d685abb-8fc6-4987-8fd6-98505c221c8e\', \'multiverseId\': 535791}, \'multiverseid\': 535791}, {\'name\': \'Avversario Spettrale\', \'text\': "Lampo\\nVolare\\nQuando l\'Avversario Spettrale entra nel campo di battaglia, puoi pagare {1}{U} un qualsiasi numero di volte. Quando paghi questo costo una o più volte, metti altrettanti segnalini +1/+1 sull\'Avversario Spettrale, poi fino ad altrettanti altri artefatti, creature e/o incantesimi bersaglio scompaiono.", \'type\': \'Creatura — Spirito\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536107&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eb13a21a-3e90-4b56-93a0-a3089ed17283\', \'multiverseId\': 536107}, \'multiverseid\': 536107}, {\'name\': \'幽体の敵対者\', \'text\': \'瞬速\\n飛行\\n幽体の敵対者が戦場に出たとき、あなたは{1}{U}を望む回数支払ってもよい。あなたがこのコストを１回以上支払ったとき、これでないアーティファクトやクリーチャーやエンチャントのうちその回数を最大とする数を対象とする。幽体の敵対者の上にその回数に等しい数の＋１/＋１カウンターを置く。その後、対象としたものはフェイズ・アウトする。\', \'type\': \'クリーチャー — スピリット\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536423&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3a97f862-d704-4be9-9c3f-41a3202e9cf4\', \'multiverseId\': 536423}, \'multiverseid\': 536423}, {\'name\': \'유령 적수\', \'text\': \'섬광\\n비행\\n유령 적수가 전장에 들어올 때, 당신은 원하는 횟수만큼 {1}{U}를 지불할 수 있다. 당신이 이 비용을 한 번 이상 지불할 때, 유령 적수에 +1/+1 카운터를 그만큼 올려놓은 후, 최대 그 수만큼 다른 마법물체, 생물 및/또는 부여마법을 목표로 정한다. 그 목표들은 페이즈 아웃한다.\', \'type\': \'생물 — 신령\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536739&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'eb566310-dc27-4d9f-ba28-28626524a724\', \'multiverseId\': 536739}, \'multiverseid\': 536739}, {\'name\': \'Adversário Espectral\', \'text\': \'Lampejo\\nVoar\\nQuando Adversário Espectral entra no campo de batalha, você pode pagar {1}{U} qualquer número de vezes. Quando pagar este custo uma ou mais vezes, coloque aquela quantidade de marcadores +1/+1 em Adversário Espectral. Em seguida, até aquela quantidade de artefatos, criaturas e/ou encantamentos alvo sai de fase.\', \'type\': \'Criatura — Espírito\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537055&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'79bdedcb-af3e-4910-a3e9-6e81edf86389\', \'multiverseId\': 537055}, \'multiverseid\': 537055}, {\'name\': \'Призрачный Противник\', \'text\': \'Миг\\nПолет\\nКогда Призрачный Противник выходит на поле битвы, вы можете заплатить {1}{U} любое количество раз. Когда вы оплачиваете эту стоимость один или несколько раз, положите такое же количество жетонов +1/+1 на Призрачного Противника, затем не более такого же количества других целевых артефактов, существ и/или чар уходит в противофазу.\', \'type\': \'Существо — Дух\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537371&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'52f7614e-c9be-4b72-937d-df7dc4db471b\', \'multiverseId\': 537371}, \'multiverseid\': 537371}, {\'name\': \'幽魂仇敌\', \'text\': \'闪现\\n飞行\\n当幽魂仇敌进战场时，你可以支付{1}{U}任意次数。当你支付此费用一次或数次时，根据该数量在幽魂仇敌上放置等量的+1/+1指示物，然后至多等量的其他目标神器，生物和／或结界跃离。\', \'type\': \'生物 ～精怪\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537687&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d4a6aae7-70d8-4a7d-b20c-3e7654a9ef5a\', \'multiverseId\': 537687}, \'multiverseid\': 537687}, {\'name\': \'幽魂仇敵\', \'text\': \'閃現\\n飛行\\n當幽魂仇敵進戰場時，你可以支付{1}{U}任意次數。當你支付此費用一次或數次時，根據該數量在幽魂仇敵上放置等量的+1/+1指示物，然後至多等量的其他目標神器，生物和／或結界躍離。\', \'type\': \'生物 ～精靈\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538003&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0151697e-426a-4d09-b04a-86e84aded967\', \'multiverseId\': 538003}, \'multiverseid\': 538003}]', '[{\'name\': \'Spektraler Widersacher\', \'text\': \'Aufblitzen\\nFliegend\\nWenn der Spektrale Widersacher ins Spiel kommt, kannst du beliebig oft {1}{U} bezahlen. Wenn du diese Kosten ein- oder mehrmals bezahlst, lege entsprechend viele +1/+1-Marken auf den Spektralen Widersacher. Dann destabilisieren sich bis zu entsprechend viele andere Artefakte, Kreaturen und/oder Verzauberungen deiner Wahl.\', \'type\': \'Kreatur — Geist\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538756&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7d1516a5-7e4e-4a42-8daa-d75248a9927d\', \'multiverseId\': 538756}, \'multiverseid\': 538756}, {\'name\': \'Adversario espectral\', \'text\': \'Destello.\\nVuela.\\nCuando el Adversario espectral entre al campo de batalla, puedes pagar {1}{U} tantas veces como quieras. Cuando pagues este coste una o más veces, pon esa misma cantidad de contadores +1/+1 sobre el Adversario espectral, luego salen de fase hasta esa misma cantidad de otros artefactos, criaturas y/o encantamientos objetivo.\', \'type\': \'Criatura — Espíritu\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538816&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'35a90f84-a1cc-4dbb-a4b9-e7b3c597362c\', \'multiverseId\': 538816}, \'multiverseid\': 538816}, {\'name\': \'Adversaire spectral\', \'text\': "Flash\\nVol\\nQuand l\'Adversaire spectral arrive sur le champ de bataille, vous pouvez payer {1}{U} autant de fois que vous le souhaitez. Quand vous payez ce coût au moins une fois, mettez autant de marqueurs +1/+1 sur l\'Adversaire spectral, puis jusqu\'à autant d\'autres cibles, artefacts, créatures et/ou enchantements, passent hors phase.", \'type\': \'Créature : esprit\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538876&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b81f81ba-ee6e-4df6-9bde-547e49970d81\', \'multiverseId\': 538876}, \'multiverseid\': 538876}, {\'name\': \'Avversario Spettrale\', \'text\': "Lampo\\nVolare\\nQuando l\'Avversario Spettrale entra nel campo di battaglia, puoi pagare {1}{U} un qualsiasi numero di volte. Quando paghi questo costo una o più volte, metti altrettanti segnalini +1/+1 sull\'Avversario Spettrale, poi fino ad altrettanti altri artefatti, creature e/o incantesimi bersaglio scompaiono.", \'type\': \'Creatura — Spirito\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538936&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e88828eb-6d39-49fa-83a2-a230663a55bc\', \'multiverseId\': 538936}, \'multiverseid\': 538936}, {\'name\': \'幽体の敵対者\', \'text\': \'瞬速\\n飛行\\n幽体の敵対者が戦場に出たとき、あなたは{1}{U}を望む回数支払ってもよい。あなたがこのコストを１回以上支払ったとき、これでないアーティファクトやクリーチャーやエンチャントのうちその回数を最大とする数を対象とする。幽体の敵対者の上にその回数に等しい数の＋１/＋１カウンターを置く。その後、対象としたものはフェイズ・アウトする。\', \'type\': \'クリーチャー — スピリット\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538996&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'44448c62-b82a-4d31-ac63-287780c15508\', \'multiverseId\': 538996}, \'multiverseid\': 538996}]', '[{\'name\': \'Spiel mit dem Feuer\', \'text\': \'Das Spiel mit dem Feuer fügt einem Ziel deiner Wahl 2 Schadenspunkte zu. Falls auf diese Weise einem Spieler Schaden zugefügt wird, wende Hellsicht 1 an. (Schaue dir die oberste Karte deiner Bibliothek an. Du kannst sie unter deine Bibliothek legen.)\', \'type\': \'Spontanzauber\', \'flavor\': \'Teufel finden die Behausungen der Menschen bedrückend kalt, dunkel und unverbrannt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535249&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d4ccbc10-3a24-455e-ae1f-b882102aca71\', \'multiverseId\': 535249}, \'multiverseid\': 535249}, {\'name\': \'Jugar con fuego\', \'text\': \'Jugar con fuego hace 2 puntos de daño a cualquier objetivo. Si un jugador recibe daño de esta manera, adivina 1. (Mira la primera carta de tu biblioteca. Puedes poner esa carta en el fondo de tu biblioteca.)\', \'type\': \'Instantáneo\', \'flavor\': \'Las moradas humanas son agobiantes para los diablos porque les falta calor, luz y fuego.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535565&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'74adccba-443a-4a8b-9ce8-5374c469cb3f\', \'multiverseId\': 535565}, \'multiverseid\': 535565}, {\'name\': "S\'amuser avec le feu", \'text\': "S\'amuser avec le feu inflige 2 blessures à n\'importe quelle cible. Si un joueur subit des blessures de cette manière, regard 1. (Regardez la carte du dessus de votre bibliothèque. Vous pouvez la mettre au-dessous de votre bibliothèque.)", \'type\': \'Éphémère\', \'flavor\': \'Les diables trouvent que les maisons humaines manquent cruellement de chaleur, de lumière et de feu.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535881&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7a8711e0-b98d-4029-b912-bfcfb0dd0b93\', \'multiverseId\': 535881}, \'multiverseid\': 535881}, {\'name\': \'Giocare col Fuoco\', \'text\': \'Giocare col Fuoco infligge 2 danni a un qualsiasi bersaglio. Se è stato inflitto danno a un giocatore in questo modo, profetizza 1. (Guarda la prima carta del tuo grimorio. Puoi mettere quella carta in fondo al tuo grimorio.)\', \'type\': \'Istantaneo\', \'flavor\': \'I diavoli trovano le dimore degli umani fastidiosamente fredde, buie e poco bruciate.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536197&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'99128386-9f59-4bb0-85e7-e50941bc4d12\', \'multiverseId\': 536197}, \'multiverseid\': 536197}, {\'name\': \'火遊び\', \'text\': \'クリーチャーやプレインズウォーカーやプレイヤーのうち１つを対象とする。火遊びはそれに２点のダメージを与える。これによりプレイヤーがダメージを受けたなら、あなたは占術１を行う。（あなたのライブラリーの一番上にあるカード１枚を見る。あなたはそのカードをあなたのライブラリーの一番下に置いてもよい。）\', \'type\': \'インスタント\', \'flavor\': \'悪魔にとって、人間の住処は抑圧的に冷たく、暗く、そして焦げ足りないのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536513&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7f91ff43-d5cd-4ccf-a868-318efa31c945\', \'multiverseId\': 536513}, \'multiverseid\': 536513}, {\'name\': \'불장난하기\', \'text\': \'원하는 목표를 정한다. 불장난하기는 그 목표에게 피해 2점을 입힌다. 이런 식으로 플레이어가 피해를 입었다면, 점술 1을 한다. (당신의 서고 맨 위 카드 한 장을 본다. 당신은 그 카드를 당신의 서고 맨 밑에 놓을 수 있다.)\', \'type\': \'순간마법\', \'flavor\': \'악령들은 인간들이 살고 있는 곳이 너무나도 춥고, 어둡고, 불타고 있지 않다고 생각한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536829&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'425a5e91-0038-433c-9f80-749be086b2b4\', \'multiverseId\': 536829}, \'multiverseid\': 536829}, {\'name\': \'Brincar com Fogo\', \'text\': \'Brincar com Fogo causa 2 pontos de dano a qualquer alvo. Se um jogador sofrer dano dessa forma, use vidência 1. (Olhe o card do topo de seu grimório. Você pode colocar aquele card no fundo de seu grimório.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os diabos acham as moradias humanas opressivamente frias, escuras e carentes de fogo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537145&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'58c046c6-a99f-41c3-9c47-1e81805cac76\', \'multiverseId\': 537145}, \'multiverseid\': 537145}, {\'name\': \'Игра с Огнем\', \'text\': \'Игра с Огнем наносит 2 повреждения любой цели. Если таким образом наносятся повреждения игроку, предскажите 1. (Посмотрите верхнюю карту вашей библиотеки. Вы можете положить ту карту в низ вашей библиотеки.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Дьяволы находят человеческие жилища слишком холодными, темными и необожженными.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537461&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'59c5b5ac-3fd8-426a-ad44-6c285bf6466b\', \'multiverseId\': 537461}, \'multiverseid\': 537461}, {\'name\': \'戏火作乐\', \'text\': \'戏火作乐对任意一个目标造成2点伤害。如果以此法对一位牌手造成伤害，则占卜1。（检视你牌库顶的牌。你可以将该牌置于你的牌库底。）\', \'type\': \'瞬间\', \'flavor\': \'魔鬼发现人类居所过于寒冷、黑暗、缺乏火光生机。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537777&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8c1d85fd-0659-41d6-8527-99c234571693\', \'multiverseId\': 537777}, \'multiverseid\': 537777}, {\'name\': \'戲火作樂\', \'text\': \'戲火作樂對任意一個目標造成2點傷害。如果以此法對一位玩家造成傷害，則占卜1。（檢視你牌庫頂的牌。你可以將該牌置於你的牌庫底。）\', \'type\': \'瞬間\', \'flavor\': \'魔鬼發現人類居所過於寒冷、黑暗、缺乏火光生機。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538093&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'297176f6-08f0-4ed6-8765-5446a70c4444\', \'multiverseId\': 538093}, \'multiverseid\': 538093}]', '[{\'name\': \'Spiel mit dem Feuer\', \'text\': \'Das Spiel mit dem Feuer fügt einem Ziel deiner Wahl 2 Schadenspunkte zu. Falls auf diese Weise einem Spieler Schaden zugefügt wird, wende Hellsicht 1 an.\', \'type\': \'Spontanzauber\', \'flavor\': \'Teufel finden die Behausungen der Menschen bedrückend kalt, dunkel und unverbrannt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539063&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0c9dde79-108e-45aa-9988-82e30f01ca6e\', \'multiverseId\': 539063}, \'multiverseid\': 539063}, {\'name\': \'Jugar con fuego\', \'text\': \'Jugar con fuego hace 2 puntos de daño a cualquier objetivo. Si un jugador recibe daño de esta manera, adivina 1.\', \'type\': \'Instantáneo\', \'flavor\': \'Las moradas humanas son agobiantes para los diablos porque les falta calor, luz y fuego.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539068&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'16a8ab2d-9eb2-4e7a-bde8-cd2f269f4a05\', \'multiverseId\': 539068}, \'multiverseid\': 539068}, {\'name\': "S\'amuser avec le feu", \'text\': "S\'amuser avec le feu inflige 2 blessures à n\'importe quelle cible. Si un joueur subit des blessures de cette manière, regard 1.", \'type\': \'Éphémère\', \'flavor\': \'Les diables trouvent que les maisons humaines manquent cruellement de chaleur, de lumière et de feu.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539073&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'19f262c8-b812-4deb-8b11-ae7a464b7f5a\', \'multiverseId\': 539073}, \'multiverseid\': 539073}, {\'name\': \'Giocare col Fuoco\', \'text\': \'Giocare col Fuoco infligge 2 danni a un qualsiasi bersaglio. Se è stato inflitto danno a un giocatore in questo modo, profetizza 1.\', \'type\': \'Istantaneo\', \'flavor\': \'I diavoli trovano le dimore degli umani fastidiosamente fredde, buie e poco bruciate.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539078&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f159df9b-23ee-4fdc-bfea-a189f130844a\', \'multiverseId\': 539078}, \'multiverseid\': 539078}, {\'name\': \'火遊び\', \'text\': \'クリーチャーやプレインズウォーカーやプレイヤーのうち１つを対象とする。火遊びはそれに２点のダメージを与える。これによりプレイヤーがダメージを受けたなら、あなたは占術１を行う。\', \'type\': \'インスタント\', \'flavor\': \'悪魔にとって、人間の住処は抑圧的に冷たく、暗く、そして焦げ足りないのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539083&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7746a252-ad34-4f5f-b013-4e49aac6db21\', \'multiverseId\': 539083}, \'multiverseid\': 539083}, {\'name\': \'불장난하기\', \'text\': \'원하는 목표를 정한다. 불장난하기는 그 목표에게 피해 2점을 입힌다. 이런 식으로 플레이어가 피해를 입었다면, 점술 1을 한다.\', \'type\': \'순간마법\', \'flavor\': \'악령들은 인간들이 살고 있는 곳이 너무나도 춥고, 어둡고, 불타고 있지 않다고 생각한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539088&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b652b80e-624a-4693-a4e8-3309fef09563\', \'multiverseId\': 539088}, \'multiverseid\': 539088}, {\'name\': \'Brincar com Fogo\', \'text\': \'Brincar com Fogo causa 2 pontos de dano a qualquer alvo. Se um jogador sofrer dano dessa forma, use vidência 1.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os diabos acham as moradias humanas opressivamente frias, escuras e carentes de fogo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539093&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a5c58d9e-2c40-4c89-8cf9-7b733b7b06ed\', \'multiverseId\': 539093}, \'multiverseid\': 539093}, {\'name\': \'Игра с Огнем\', \'text\': \'Игра с Огнем наносит 2 повреждения любой цели. Если таким образом наносятся повреждения игроку, предскажите 1.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Дьяволы находят человеческие жилища слишком холодными, темными и необожженными.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539098&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'514902bb-7395-4331-9c41-db0284f05ebe\', \'multiverseId\': 539098}, \'multiverseid\': 539098}, {\'name\': \'戏火作乐\', \'text\': \'戏火作乐对任意一个目标造成2点伤害。如果以此法对一位牌手造成伤害，则占卜1。\', \'type\': \'瞬间\', \'flavor\': \'魔鬼发现人类居所过于寒冷、黑暗、缺乏火光生机。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539103&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'49f274ee-1878-4b38-98b3-ae2566597dc9\', \'multiverseId\': 539103}, \'multiverseid\': 539103}, {\'name\': \'戲火作樂\', \'text\': \'戲火作樂對任意一個目標造成2點傷害。如果以此法對一位玩家造成傷害，則占卜1。\', \'type\': \'瞬間\', \'flavor\': \'魔鬼發現人類居所過於寒冷、黑暗、缺乏火光生機。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539108&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'44cc4a2b-404e-4548-9cbe-9b96341c1b1e\', \'multiverseId\': 539108}, \'multiverseid\': 539108}]', '[{\'name\': \'Springwolf\', \'text\': \'Aufblitzen\\nReichweite\', \'type\': \'Kreatur — Wolf\', \'flavor\': \'Da ihre übliche Beute von Werwölfen verscheucht worden war, entwickelten die Wölfe des Ulvenwalds einfallsreiche neue Jagdtechniken.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535271&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0a409c16-09b9-427c-a16e-48f4d0e0fee1\', \'multiverseId\': 535271}, \'multiverseid\': 535271}, {\'name\': \'Lobo brincador\', \'text\': \'Destello.\\nAlcance.\', \'type\': \'Criatura — Lobo\', \'flavor\': \'Dado que los licántropos habían espantado a sus presas habituales, los lobos de Ulvenwald tuvieron que adoptar técnicas de caza más imaginativas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535587&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0fb50e97-a02f-43b0-8dfa-fc902d4d4e91\', \'multiverseId\': 535587}, \'multiverseid\': 535587}, {\'name\': \'Loup bondissant\', \'text\': \'Flash\\nPortée\', \'type\': \'Créature : loup\', \'flavor\': "Leurs proies habituelles ayant fui les loups-garous, les loups d\'Ulvenwald adoptèrent de nouvelles techniques de chasse inventives.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535903&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'55428d86-7e46-43f6-8fc7-594e0a7161bb\', \'multiverseId\': 535903}, \'multiverseid\': 535903}, {\'name\': \'Lupo al Balzo\', \'text\': \'Lampo\\nRaggiungere\', \'type\': \'Creatura — Lupo\', \'flavor\': \'Con le loro prede abituali spaventate dai mannari, i lupi di Ulvenwald adottarono nuove e creative tecniche di caccia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536219&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'796a7456-5b80-46b5-a5f4-1377e2d72d10\', \'multiverseId\': 536219}, \'multiverseid\': 536219}, {\'name\': \'跳ねる狼\', \'text\': \'瞬速\\n到達\', \'type\': \'クリーチャー — 狼\', \'flavor\': \'普段の獲物が人狼の恐怖に逃げてしまったので、ウルヴェンワルドの狼は独創的な新しい狩猟技術を編み出した。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536535&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4dbcb3b6-537f-4174-a226-20cda779a77b\', \'multiverseId\': 536535}, \'multiverseid\': 536535}, {\'name\': \'껑충 뛰는 늑대\', \'text\': \'섬광\\n대공\', \'type\': \'생물 — 늑대\', \'flavor\': \'늑대인간들이 평소 사냥하던 먹잇감을 쫓아 버리자, 울벤왈드의 늑대들은 창의적인 새로운 사냥 기술을 만들어냈다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536851&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5fa37b64-da6a-4228-86b4-4636f30d182b\', \'multiverseId\': 536851}, \'multiverseid\': 536851}, {\'name\': \'Lobo Saltador\', \'text\': \'Lampejo\\nAlcance\', \'type\': \'Criatura — Lobo\', \'flavor\': \'Como suas presas habituais fugiram com medo dos lobisomens, os lobos de Ulvenwald tiveram de adotar técnicas inovativas de caça.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537167&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c477b192-d68b-4e35-a774-660be44ab0fe\', \'multiverseId\': 537167}, \'multiverseid\': 537167}, {\'name\': \'Ловчий Волк\', \'text\': \'Миг\\nЗахват\', \'type\': \'Существо — Волк\', \'flavor\': \'Обычную добычу волков Уленвальда распугали вервольфы, и тогда волки освоили новые охотничьи приемы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537483&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d15e63a1-3831-45c6-80d1-34943dc3cf10\', \'multiverseId\': 537483}, \'multiverseid\': 537483}, {\'name\': \'弹跃狼\', \'text\': \'闪现\\n延势\', \'type\': \'生物 ～狼\', \'flavor\': \'在平常猎物都被狼人吓跑之后，沃文森的狼不得不创新捕猎技巧。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537799&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e5b717a9-c421-4742-9fb2-ca3de9f1158f\', \'multiverseId\': 537799}, \'multiverseid\': 537799}, {\'name\': \'彈躍狼\', \'text\': \'閃現\\n延勢\', \'type\': \'生物 ～狼\', \'flavor\': \'在平常獵物都被狼人嚇跑之後，沃文森的狼不得不創新捕獵技巧。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538115&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'294941d8-15e2-4ef4-9974-b355783fbb65\', \'multiverseId\': 538115}, \'multiverseid\': 538115}]', '[{\'name\': \'Spukender Bergkamm\', \'text\': \'Der Spukende Bergkamm kommt getappt ins Spiel, es sei denn, du kontrollierst zwei oder mehr andere Länder.\\n{T}: Erzeuge {B} oder {R}.\', \'type\': \'Land\', \'flavor\': \'Wirbel aus Asche verbergen bröckelnde Klippen, tückische Verwerfungen und die sabbernden Mäuler unbekannter Übel.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535377&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ccd21198-b904-43a4-b0d9-e4d9d315aeb3\', \'multiverseId\': 535377}, \'multiverseid\': 535377}, {\'name\': \'Risco embrujado\', \'text\': \'El Risco embrujado entra al campo de batalla girado a menos que controles otras dos o más tierras.\\n{T}: Agrega {B} o {R}.\', \'type\': \'Tierra\', \'flavor\': \'Los torbellinos de ceniza ocultan acantilados desmoronados, descensos traicioneros y las fauces hambrientas de males desconocidos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535693&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'efe1cb82-defb-4145-9b40-5bd2c6f37141\', \'multiverseId\': 535693}, \'multiverseid\': 535693}, {\'name\': \'Contreforts hantés\', \'text\': \'Les Contreforts hantés arrivent sur le champ de bataille engagés à moins que vous ne contrôliez au moins deux autres terrains.\\n{T} : Ajoutez {B} ou {R}.\', \'type\': \'Terrain\', \'flavor\': "Des tourbillons de cendres dissimulent les falaises s\'effritant, les dénivelés traîtres et les gueules salivantes d\'abominations inconnues.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536009&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3ae9794a-3104-49e4-b7e8-998b3b3f5445\', \'multiverseId\': 536009}, \'multiverseid\': 536009}, {\'name\': \'Crinale Infestato\', \'text\': \'Il Crinale Infestato entra nel campo di battaglia TAPpato a meno che tu non controlli altre due o più terre.\\n{T}: Aggiungi {B} o {R}.\', \'type\': \'Terra\', \'flavor\': \'Mulinelli di cenere nascondono rupi in rovina, pericolosi strapiombi e le fauci sbavanti di mali ignoti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536325&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ef478f46-1fa0-40a8-9a57-e9087320f601\', \'multiverseId\': 536325}, \'multiverseid\': 536325}, {\'name\': \'憑依された峰\', \'text\': \'あなたがこれでない２つ以上の土地をコントロールしていないかぎり、憑依された峰はタップ状態で戦場に出る。\\n{T}：{B}か{R}を加える。\', \'type\': \'土地\', \'flavor\': \'灰の竜巻によって、崩れる崖や危険な谷底や未知の悪のよだれが垂れた大口が隠れているのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536641&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ecc7b935-bab4-4cb8-8dea-f168b0278b98\', \'multiverseId\': 536641}, \'multiverseid\': 536641}, {\'name\': \'귀신들린 산등성이\', \'text\': \'귀신들린 산등성이는 당신이 다른 대지를 두 개 이상 조종하지 않는 한 탭된 채로 전장에 들어온다.\\n{T}: {B} 또는 {R}를 추가한다.\', \'type\': \'대지\', \'flavor\': \'소용돌이치는 화산재가 무너져내리는 절벽과 위험한 폭포, 그리고 알려지지 않은 사악함을 질질 흘리는 아가리를 숨겨 준다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536957&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'da71870b-566a-4a34-a720-37c9fb29fb0a\', \'multiverseId\': 536957}, \'multiverseid\': 536957}, {\'name\': \'Cordilheira Assombrada\', \'text\': \'Cordilheira Assombrada entra no campo de batalha virada, a menos que você controle dois ou mais outros terrenos.\\n{T}: Adicione {B} ou {R}.\', \'type\': \'Terreno\', \'flavor\': \'Redemoinhos de cinzas ocultam penhascos desmoronantes, quedas traiçoeiras e as gorjas ignóbeis de males desconhecidos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537273&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'822f0435-02be-4b5d-b4df-69212b22d0d5\', \'multiverseId\': 537273}, \'multiverseid\': 537273}, {\'name\': \'Перевал Призраков\', \'text\': \'Перевал Призраков выходит на поле битвы повернутым, если под вашим контролем менее двух других земель.\\n{T}: добавьте {B} или {R}.\', \'type\': \'Земля\', \'flavor\': \'За пепельными вихрями скрываются осыпающиеся скалы, коварные пропасти и ненасытное чрево неизвестного зла.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537589&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e1d4c134-88b5-420e-9c13-36d395a833ed\', \'multiverseId\': 537589}, \'multiverseid\': 537589}, {\'name\': \'闹鬼山脊\', \'text\': \'除非你操控两个或更多其他地，否则闹鬼山脊须横置进战场。\\n{T}：加{B}或{R}。\', \'type\': \'地\', \'flavor\': \'漩涡灰雾之下，藏着的是崩毁山崖、险峻峭壁和恶物血口。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537905&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fd503753-c4f3-461b-b189-cf6f6e2ce475\', \'multiverseId\': 537905}, \'multiverseid\': 537905}, {\'name\': \'鬧鬼山脊\', \'text\': \'除非你操控兩個或更多其他地，否則鬧鬼山脊須橫置進戰場。\\n{T}：加{B}或{R}。\', \'type\': \'地\', \'flavor\': \'漩渦灰霧之下，藏著的是崩毀山崖、險峻峭壁和惡物血口。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538221&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'50392216-4bf9-484b-ac6d-a8aee49b79f9\', \'multiverseId\': 538221}, \'multiverseid\': 538221}]', "[{'name': 'Spukender Bergkamm', 'text': 'Der Spukende Bergkamm kommt getappt ins Spiel, es sei denn, du kontrollierst zwei oder mehr andere Länder.\\n{T}: Erzeuge {B} oder {R}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538442&type=card', 'language': 'German', 'identifiers': {'scryfallId': '89f54d65-04ee-40e8-91af-5b3a356b585c', 'multiverseId': 538442}, 'multiverseid': 538442}, {'name': 'Risco embrujado', 'text': 'El Risco embrujado entra al campo de batalla girado a menos que controles otras dos o más tierras.\\n{T}: Agrega {B} o {R}.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538447&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '6846bb76-a35d-4144-bebc-24e83b9552f6', 'multiverseId': 538447}, 'multiverseid': 538447}, {'name': 'Contreforts hantés', 'text': 'Les Contreforts hantés arrivent sur le champ de bataille engagés à moins que vous ne contrôliez au moins deux autres terrains.\\n{T} : Ajoutez {B} ou {R}.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538452&type=card', 'language': 'French', 'identifiers': {'scryfallId': '4a5a2b19-f19f-4645-acf1-98789b896caa', 'multiverseId': 538452}, 'multiverseid': 538452}, {'name': 'Crinale Infestato', 'text': 'Il Crinale Infestato entra nel campo di battaglia TAPpato a meno che tu non controlli altre due o più terre.\\n{T}: Aggiungi {B} o {R}.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538457&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c3334f89-74d0-41bd-9194-e3c23741680e', 'multiverseId': 538457}, 'multiverseid': 538457}, {'name': '憑依された峰', 'text': 'あなたがこれでない２つ以上の土地をコントロールしていないかぎり、憑依された峰はタップ状態で戦場に出る。\\n{T}：{B}か{R}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538462&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '0f0df9e5-88f1-4706-a200-ceb48d88e39f', 'multiverseId': 538462}, 'multiverseid': 538462}, {'name': '귀신들린 산등성이', 'text': '귀신들린 산등성이는 당신이 다른 대지를 두 개 이상 조종하지 않는 한 탭된 채로 전장에 들어온다.\\n{T}: {B} 또는 {R}를 추가한다.', 'type': '대지', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538467&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'e16832b7-65c5-446a-9d7d-07d39e6ffbdd', 'multiverseId': 538467}, 'multiverseid': 538467}, {'name': 'Cordilheira Assombrada', 'text': 'Cordilheira Assombrada entra no campo de batalha virada, a menos que você controle dois ou mais outros terrenos.\\n{T}: Adicione {B} ou {R}.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538472&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '90cf7daf-5519-424d-9012-f21ecdc5ca1b', 'multiverseId': 538472}, 'multiverseid': 538472}, {'name': 'Перевал Призраков', 'text': 'Перевал Призраков выходит на поле битвы повернутым, если под вашим контролем менее двух других земель.\\n{T}: добавьте {B} или {R}.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538477&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'f8b8c947-ef50-4af8-8f52-228f1f721460', 'multiverseId': 538477}, 'multiverseid': 538477}, {'name': '闹鬼山脊', 'text': '除非你操控两个或更多其他地，否则闹鬼山脊须横置进战场。\\n{T}：加{B}或{R}。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538482&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'e1fa70c0-bf67-4464-b2b9-3de363595547', 'multiverseId': 538482}, 'multiverseid': 538482}, {'name': '鬧鬼山脊', 'text': '除非你操控兩個或更多其他地，否則鬧鬼山脊須橫置進戰場。\\n{T}：加{B}或{R}。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538487&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'd9751a68-aa5c-4f37-a3e0-39a4fea8ee6c', 'multiverseId': 538487}, 'multiverseid': 538487}]", '[{\'name\': \'Starrender Beobachter\', \'text\': \'{T}: Erzeuge {U}. Verwende dieses Mana nur, um Aufstören-Kosten zu bezahlen oder einen Spontanzauber oder eine Hexerei zu wirken.\', \'type\': \'Kreatur — Homunkulus\', \'flavor\': \'„Tag 77: Der Homunkulus im Glas ahmt weiterhin jede meiner Bewegungen nach. Ich frage mich, was er schreibt?"\\n—Versuchsnotizen von Yzlkpk\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535165&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a0f45525-ddba-412f-affc-df1a2bc88c70\', \'multiverseId\': 535165}, \'multiverseid\': 535165}, {\'name\': \'Observadora sin párpado\', \'text\': \'{T}: Agrega {U}. Usa este maná solo para pagar un coste de perturbar o lanzar un hechizo de instantáneo o de conjuro.\', \'type\': \'Criatura — Homúnculo\', \'flavor\': \'"Día 77: El homúnculo del cristal sigue imitando todos mis movimientos. ¿Qué estará escribiendo?".\\n—Notas de laboratorio de Yzlkpk\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535481&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d4fcc6d8-0334-445c-8242-0f48bfe1b919\', \'multiverseId\': 535481}, \'multiverseid\': 535481}, {\'name\': \'Observateur au regard fixe\', \'text\': "{T} : Ajoutez {U}. Ne dépensez ce mana que pour payer un coût de perturbation ou lancer un sort d\'éphémère ou de rituel.", \'type\': \'Créature : homoncule\', \'flavor\': "« Jour 77 : l\'homoncule à l\'intérieur du cristal continue d\'imiter tous mes mouvements. Je me demande ce qu\'il est en train d\'écrire ? »\\n—Notes de laboratoire d\'Yzlkpk", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535797&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3431df9f-bfc3-4b67-b029-cd2c3c63c39a\', \'multiverseId\': 535797}, \'multiverseid\': 535797}, {\'name\': \'Osservatore Impassibile\', \'text\': \'{T}: Aggiungi {U}. Spendi questo mana solo per pagare un costo di disturbare o per lanciare una magia istantaneo o stregoneria.\', \'type\': \'Creatura — Omuncolo\', \'flavor\': \'"Giorno 77: L\\\'omuncolo nel cristallo continua a imitare i miei movimenti. Chissà cosa sta scrivendo?"\\n—Appunti di laboratorio di Yzlkpk\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536113&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5d1640b7-ee00-4227-87cf-efa073d348db\', \'multiverseId\': 536113}, \'multiverseid\': 536113}, {\'name\': \'またたかぬ観察者\', \'text\': \'{T}：{U}を加える。このマナは、降霊コストを支払うためか、インスタントやソーサリーである呪文を唱えるためにのみ使用できる。\', \'type\': \'クリーチャー — ホムンクルス\', \'flavor\': \'「77日目：水晶の中のホムンクルスは引き続き私の一挙手一投足を真似ている。一体何を書いているのだろうか？」\\n――イェゼルクピクの研究メモ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536429&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6fb533ed-d9c3-445a-942a-cb480c1008d9\', \'multiverseId\': 536429}, \'multiverseid\': 536429}, {\'name\': \'눈을 깜빡이지 않는 관찰자\', \'text\': \'{T}: {U}를 추가한다. 이 마나는 소란 비용을 지불하거나 순간마법 또는 집중마법 주문을 발동하는 데에만 사용할 수 있다.\', \'type\': \'생물 — 호문쿨루스\', \'flavor\': \'"제 77일: 수정 안에 있는 호문쿨루스가 계속해서 내 모든 동작을 모방한다. 저것은 뭘 기록하고 있는 것일까?"\\n—이젤크픽의 실험실 노트\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536745&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3795b93c-75e8-4715-be82-4350fdac8863\', \'multiverseId\': 536745}, \'multiverseid\': 536745}, {\'name\': \'Observador Arregalado\', \'text\': \'{T}: Adicione {U}. Gaste este mana somente para pagar um custo de perturbar ou conjurar uma mágica instantânea ou um feitiço.\', \'type\': \'Criatura — Homúnculo\', \'flavor\': \'"Dia 77: O homúnculo dentro do cristal continua a imitar todos os meus movimentos. Eu me pergunto... O que ele está escrevendo?"\\n— anotações do laboratório de Yzlkpk\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537061&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d1882bcf-03c2-4115-8937-d940753e9c2c\', \'multiverseId\': 537061}, \'multiverseid\': 537061}, {\'name\': \'Неусыпный Наблюдатель\', \'text\': \'{T}: добавьте {U}. Тратьте эту ману только на оплату стоимости Разупокоения или на разыгрывание мгновенного заклинания или заклинания волшебства.\', \'type\': \'Существо — Гомункул\', \'flavor\': \'«День 77: гомункул внутри кристалла продолжает повторять все мои движения. Интересно, что он там пишет?»\\n— лабораторные заметки Излкыпка\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537377&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0d3bffb0-4a74-4778-a2d7-2359b5cc138c\', \'multiverseId\': 537377}, \'multiverseid\': 537377}, {\'name\': \'凝目观客\', \'text\': \'{T}：加{U}。此法术力只能用来支付惊扰费用，或是施放瞬间或法术咒语。\', \'type\': \'生物 ～造妖\', \'flavor\': \'「第77天：水晶内的造妖仍继续模仿我的一举一动。我好奇他们会写什么呢？」\\n～耶泽萍的实验室纪录\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537693&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2e5da931-db6d-4316-88ac-4344fec60b3a\', \'multiverseId\': 537693}, \'multiverseid\': 537693}, {\'name\': \'凝目觀客\', \'text\': \'{T}：加{U}。此魔法力只能用來支付驚擾費用，或是施放瞬間或巫術咒語。\', \'type\': \'生物 ～造妖\', \'flavor\': \'「第77天：水晶內的造妖仍繼續模仿我的一舉一動。我好奇他們會寫什麼呢？」\\n～耶澤萍的實驗室紀錄\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538009&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'01021441-064f-4c08-aba0-a7332fbc1ec9\', \'multiverseId\': 538009}, \'multiverseid\': 538009}]', '[{\'name\': \'Stromkirch-Blutdiebin\', \'text\': \'Zu Beginn deines Endsegments und falls ein Gegner in diesem Zug Lebenspunkte verloren hat, lege eine +1/+1-Marke auf einen Vampir deiner Wahl, den du kontrollierst.\', \'type\': \'Kreatur — Vampir, Räuber\', \'flavor\': \'Als das Haus Voldaren aufstieg, wagten es einige Mitglieder der Stromkirch-Linie, sich von den Blutzehnten etwas zu „leihen".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535214&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a7d436c3-b4ea-4078-a2fa-77a0872bf32e\', \'multiverseId\': 535214}, \'multiverseid\': 535214}, {\'name\': \'Ladrona de sangre de Stromkirk\', \'text\': \'Al comienzo de tu paso final, si un oponente perdió vidas este turno, pon un contador +1/+1 sobre el Vampiro objetivo que controlas.\', \'type\': \'Criatura — Bribón vampiro\', \'flavor\': \'Con la casa Voldaren en auge, ciertos miembros de la dinastía Stromkirk decidieron "pedir prestados" algunos diezmos de sangre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535530&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'70bbdb42-4b96-494a-a646-2c70f7047842\', \'multiverseId\': 535530}, \'multiverseid\': 535530}, {\'name\': \'Voleuse de sang de Stromkirk\', \'text\': \'Au début de votre étape de fin, si un adversaire a perdu des points de vie ce tour-ci, mettez un marqueur +1/+1 sur un vampire ciblé que vous contrôlez.\', \'type\': \'Créature : vampire et gredin\', \'flavor\': "Avec l\'ascension de la Maison Voldaren, certains membres de la lignée Stromkirk prirent la liberté d\'« emprunter » une partie de la dîme de sang.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535846&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fbcfbab9-2fda-4d27-9cab-437c3c8ead95\', \'multiverseId\': 535846}, \'multiverseid\': 535846}, {\'name\': \'Ladra di Sangue di Stromkirk\', \'text\': "All\'inizio della tua sottofase finale, se un avversario ha perso punti vita in questo turno, metti un segnalino +1/+1 su un Vampiro bersaglio che controlli.", \'type\': \'Creatura — Farabutto Vampiro\', \'flavor\': \'Con la Casata Voldaren in ascesa, alcuni membri della stirpe Stromkirk si assunsero la libertà di prendere in "prestito" la tassa di sangue.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536162&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'15079c04-e326-4d7e-b11c-df9ea485d3ab\', \'multiverseId\': 536162}, \'multiverseid\': 536162}, {\'name\': \'流城の血泥棒\', \'text\': \'あなたの終了ステップの開始時に、このターンに対戦相手がライフを失っていた場合、あなたがコントロールしている吸血鬼１体を対象とする。それの上に＋１/＋１カウンター１個を置く。\', \'type\': \'クリーチャー — 吸血鬼・ならず者\', \'flavor\': \'ヴォルダーレン家が隆盛であるため、流城の血統の者の中には税血を「借りる」役割を買って出るものがいた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536478&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2208fc2a-e3d3-430f-a68a-b9b6002bd387\', \'multiverseId\': 536478}, \'multiverseid\': 536478}, {\'name\': \'스트롬커크 피 도둑\', \'text\': \'당신의 종료단 시작에, 상대가 이번 턴에 생명점을 잃었다면, 당신이 조종하는 흡혈귀를 목표로 정한다. 그 흡혈귀에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 흡혈귀 도적\', \'flavor\': \'볼다렌 가문이 우세해지자, 스트롬커크 혈통의 구성원 일부는 피 십일조를 "빌리기" 시작했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536794&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'685067c4-5231-46ed-b20b-18e090af2e1b\', \'multiverseId\': 536794}, \'multiverseid\': 536794}, {\'name\': \'Ladra de Sangue de Stromkirk\', \'text\': \'No início de sua etapa final, se um oponente perdeu pontos de vida neste turno, coloque um marcador +1/+1 no Vampiro alvo que você controla.\', \'type\': \'Criatura — Vampiro Ladino\', \'flavor\': \'Com a ascensão da Casa Voldaren, alguns membros da linhagem Stromkirk decidiram tomar "empréstimos" dos dízimos de sangue.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537110&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'90692054-1e6d-4523-bc2d-8959cafd42ae\', \'multiverseId\': 537110}, \'multiverseid\': 537110}, {\'name\': \'Стромкиркская Кровавая Воровка\', \'text\': \'В начале вашего заключительного шага, если оппонент терял жизнь в этом ходу, положите один жетон +1/+1 на целевого Вампира под вашим контролем.\', \'type\': \'Существо — Вампир Бродяга\', \'flavor\': \'С восхождением дома Волдаренов, некоторые из рода Стромкирков взяли на себя вольность «заимствовать» из кровавых десятин.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537426&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4b91b897-0d44-4be8-83f9-fd53c11c0bc9\', \'multiverseId\': 537426}, \'multiverseid\': 537426}, {\'name\': \'溪堡血贼\', \'text\': \'在你的结束步骤开始时，若有对手本回合中失去过生命，则在目标由你操控的吸血鬼上放置一个+1/+1指示物。\', \'type\': \'生物 ～吸血鬼／浪客\', \'flavor\': \'随着沃达连家族地位日渐提高，溪堡血脉中开始有人主动上门「预支」血税。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537742&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ef69a8d2-e4af-4e09-9cd9-65af4c00f850\', \'multiverseId\': 537742}, \'multiverseid\': 537742}, {\'name\': \'溪堡血賊\', \'text\': \'在你的結束步驟開始時，若有對手本回合中失去過生命，則在目標由你操控的吸血鬼上放置一個+1/+1指示物。\', \'type\': \'生物 ～吸血鬼／浪客\', \'flavor\': \'隨著沃達連家族地位日漸提高，溪堡血脈中開始有人主動上門「預支」血稅。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538058&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bf24e97d-847b-4f27-8d37-cc67f7ef6c2d\', \'multiverseId\': 538058}, \'multiverseid\': 538058}]', '[{\'name\': \'Sturmkreischer\', \'text\': \'Fliegend\\nSpontanzauber und Hexereien, die du wirkst, kosten beim Wirken {1} weniger.\\nImmer wenn du einen Spontanzauber oder eine Hexerei wirkst, erhält der Sturmkreischer +2/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Sceada, Schrecken\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535355&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ac266a7e-a836-4a01-b135-ef3d44a2810b\', \'multiverseId\': 535355}, \'multiverseid\': 535355}, {\'name\': \'Escrílix de la tormenta\', \'text\': \'Vuela.\\nTe cuesta {1} menos lanzar hechizos de instantáneo o de conjuro.\\nSiempre que lances un hechizo de instantáneo o de conjuro, el Escrílix de la tormenta obtiene +2/+0 hasta el final del turno.\', \'type\': \'Criatura — Horror draco\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535671&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0b09f6ac-0735-42f8-adb5-e3b3a23b4d74\', \'multiverseId\': 535671}, \'multiverseid\': 535671}, {\'name\': "Skreelix de l\'orage", \'text\': "Vol\\nLes sorts d\'éphémère et de rituel que vous lancez coûtent {1} de moins à lancer.\\nÀ chaque fois que vous lancez un sort d\'éphémère ou de rituel, le Skreelix de l\'orage gagne +2/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : drakôn et horreur\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535987&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b016bbaf-1c44-42f0-97f5-189dbd40008e\', \'multiverseId\': 535987}, \'multiverseid\': 535987}, {\'name\': \'Stridix Tempestoso\', \'text\': \'Volare\\nLe magie istantaneo e stregoneria che lanci costano {1} in meno per essere lanciate.\\nOgniqualvolta lanci una magia istantaneo o stregoneria, lo Stridix Tempestoso prende +2/+0 fino alla fine del turno.\', \'type\': \'Creatura — Orrore Draghetto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536303&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'16bf280c-5f7b-4217-82bc-dc8264762132\', \'multiverseId\': 536303}, \'multiverseid\': 536303}, {\'name\': \'嵐のスクリーリクス\', \'text\': \'飛行\\nあなたがインスタントやソーサリーである呪文を唱えるためのコストは{1}少なくなる。\\nあなたがインスタントやソーサリーである呪文を唱えるたび、ターン終了時まで、嵐のスクリーリクスは＋２/＋０の修整を受ける。\', \'type\': \'クリーチャー — ドレイク・ホラー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536619&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a9caa9b5-d40a-4ac7-8795-9249f77d382b\', \'multiverseId\': 536619}, \'multiverseid\': 536619}, {\'name\': \'폭풍 스크릴릭스\', \'text\': \'비행\\n당신이 발동하는 순간마법 주문 및 집중마법 주문은 발동하는 데 {1}이 덜 든다.\\n당신이 순간마법 또는 집중마법 주문을 발동할 때마다, 폭풍 스크릴릭스는 턴종료까지 +2/+0을 받는다.\', \'type\': \'생물 — 드레이크 괴수\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536935&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d538fcf3-9d18-493c-bbbd-d1c444f10af5\', \'multiverseId\': 536935}, \'multiverseid\': 536935}, {\'name\': \'Skreelix da Tempestade\', \'text\': \'Voar\\nAs mágicas instantâneas e os feitiços que você conjura custam {1} a menos para serem conjurados.\\nToda vez que você conjura uma mágica instantânea ou um feitiço, Skreelix da Tempestade recebe +2/+0 até o final do turno.\', \'type\': \'Criatura — Dragonete Horror\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537251&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ba3c69e1-b28a-4bad-8e9b-5704e19a7de5\', \'multiverseId\': 537251}, \'multiverseid\': 537251}, {\'name\': \'Штормовой Скриликс\', \'text\': \'Полет\\nРазыгрываемые вами мгновенные заклинания и заклинания волшебства стоят на {1} меньше.\\nКаждый раз, когда вы разыгрываете мгновенное заклинание или заклинание волшебства, Штормовой Скриликс получает +2/+0 до конца хода.\', \'type\': \'Существо — Дрейк Ужас\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537567&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f6091f25-6b46-4398-a704-ffeec37766fc\', \'multiverseId\': 537567}, \'multiverseid\': 537567}, {\'name\': \'暴风嘶奇黎\', \'text\': \'飞行\\n你施放的瞬间与法术咒语减少{1}来施放。\\n每当你施放瞬间或法术咒语时，暴风嘶奇黎得+2/+0直到回合结束。\', \'type\': \'生物 ～龙兽／惊惧兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537883&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'86c3d4c8-5e2e-4857-92cb-ebc96b0f8895\', \'multiverseId\': 537883}, \'multiverseid\': 537883}, {\'name\': \'暴風嘶奇黎\', \'text\': \'飛行\\n你施放的瞬間與巫術咒語減少{1}來施放。\\n每當你施放瞬間或巫術咒語時，暴風嘶奇黎得+2/+0直到回合結束。\', \'type\': \'生物 ～龍獸／驚懼獸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538199&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3e793b40-0e51-46be-aeff-ba6703b429b8\', \'multiverseId\': 538199}, \'multiverseid\': 538199}]', "[{'name': 'Sturmreiter-Geist', 'text': 'Aufblitzen\\nFliegend', 'type': 'Kreatur — Geist', 'flavor': 'Die müden Reisenden hielten die flackernden Lichter für einen Kerzenweiser, der den Weg zum Erntefest wies. Aus ihrer Erleichterung wurde Schrecken, als Blitze den Himmel erhellten.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535161&type=card', 'language': 'German', 'identifiers': {'scryfallId': '830da210-7179-4bab-bb47-452ae2ffa29b', 'multiverseId': 535161}, 'multiverseid': 535161}, {'name': 'Espíritu surcatormentas', 'text': 'Destello.\\nVuela.', 'type': 'Criatura — Espíritu', 'flavor': 'Los viajeros exhaustos confundieron esas luces titilantes con las de un velaguía que muestra el camino a la Cosechalia. Su consuelo se convirtió en espanto cuando un rayo iluminó el cielo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535477&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '1800beb9-081e-41fc-88e6-fbf676d822f8', 'multiverseId': 535477}, 'multiverseid': 535477}, {'name': 'Esprit de chevaucheur de tempête', 'text': 'Flash\\nVol', 'type': 'Créature : esprit', 'flavor': 'Les voyageurs fatigués prirent les lumières vacillantes pour un guide-chandelle indiquant le chemin de la Fête des moissons. Puis un éclair fendit le ciel, et leur soulagement se mua en terreur.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535793&type=card', 'language': 'French', 'identifiers': {'scryfallId': '6d51e0e5-cf32-4450-b164-100e70cf48fa', 'multiverseId': 535793}, 'multiverseid': 535793}, {'name': 'Spirito Cavalcatempeste', 'text': 'Lampo\\nVolare', 'type': 'Creatura — Spirito', 'flavor': 'I viaggiatori esausti confusero la luce tremolante per un candeliere guida che indicava la via per il Festival del Raccolto. Il loro sollievo mutò in terrore quando i fulmini illuminarono il cielo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536109&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '9782e268-7839-4fcf-93fe-d0861b2e5d65', 'multiverseId': 536109}, 'multiverseid': 536109}, {'name': '嵐乗りの精霊', 'text': '瞬速\\n飛行', 'type': 'クリーチャー — スピリット', 'flavor': '疲弊した旅人たちはその明滅する光を収穫祭への方向を示す蝋燭案内だと思い込んだ。彼らの安堵は雷と共に恐怖へと変わった。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536425&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '05b12445-c457-4326-9860-168a997a8cc7', 'multiverseId': 536425}, 'multiverseid': 536425}, {'name': '폭풍기수 정령', 'text': '섬광\\n비행', 'type': '생물 — 신령', 'flavor': '지친 여행자들은 깜빡이는 빛이 수확철을 가리키고 있는 촛불안내자라고 오해했다. 번개가 하늘을 밝히자 그들의 안도는 공포로 탈바꿈했다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536741&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '1b8ca0ae-c231-4ba4-8a45-481d01a844d1', 'multiverseId': 536741}, 'multiverseid': 536741}, {'name': 'Espírito Ginete de Tempestade', 'text': 'Lampejo\\nVoar', 'type': 'Criatura — Espírito', 'flavor': 'Tomados pelo cansaço, os viajantes confundiram as luzes tremeluzentes com as velas-guia para o Festival da Colheita. A sensação de alívio logo se transformou em terror quando um relâmpago iluminou o céu.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537057&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9e346354-dbbd-4f8f-a234-d006aad7727e', 'multiverseId': 537057}, 'multiverseid': 537057}, {'name': 'Дух Всадника Бури', 'text': 'Миг\\nПолет', 'type': 'Существо — Дух', 'flavor': 'Утомленные путники приняли мерцающие огоньки за свечи, указывающие путь на Седмицу Жатвы. Их облегчение превратилось в ужас, когда молния озарила небо.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537373&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '130f2d25-de49-4c73-bdda-bf2c9b66dc2b', 'multiverseId': 537373}, 'multiverseid': 537373}, {'name': '驭霆精怪', 'text': '闪现\\n飞行', 'type': '生物 ～精怪', 'flavor': '疲惫旅人看到闪光，以为自己见到了指向收成节的引路烛光。但这份放松心情在看到闪电大作后就化为恐惧。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537689&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '0f76fc3e-e2f1-4f48-8937-57c5444b0ba7', 'multiverseId': 537689}, 'multiverseid': 537689}, {'name': '馭霆精靈', 'text': '閃現\\n飛行', 'type': '生物 ～精靈', 'flavor': '疲憊旅人看到閃光，以為自己見到了指向收成節的引路燭光。但這份放鬆心情在看到閃電大作後就化為恐懼。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538005&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '2d5c886f-5a82-445c-add4-c2cbd29d525f', 'multiverseId': 538005}, 'multiverseid': 538005}]", '[{\'name\': \'Stürmt das Festival\', \'text\': \'Schaue dir die obersten fünf Karten deiner Bibliothek an. Du kannst davon bis zu zwei bleibende Karten mit Manabetrag 5 oder weniger ins Spiel bringen. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.\\nRückblende {7}{G}{G}{G} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten wirken. Schicke sie danach ins Exil.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535305&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c8d0906b-a103-451e-84e9-ef1a2e734adb\', \'multiverseId\': 535305}, \'multiverseid\': 535305}, {\'name\': \'Atacar el festival\', \'text\': \'Mira las cinco primeras cartas de tu biblioteca. Puedes poner en el campo de batalla hasta dos cartas de permanente con valor de maná de 5 o menos de entre ellas. Pon el resto en el fondo de tu biblioteca en un orden aleatorio.\\nRetrospectiva {7}{G}{G}{G}. (Puedes lanzar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego exíliala.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535621&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6be92552-bef7-41a1-a5f4-e2d1a7ee1fc6\', \'multiverseId\': 535621}, \'multiverseid\': 535621}, {\'name\': "À l\'assaut du Festival", \'text\': "Regardez les cinq cartes du dessus de votre bibliothèque. Parmi elles, vous pouvez mettre sur le champ de bataille jusqu\'à deux cartes de permanent avec une valeur de mana inférieure ou égale à 5. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.\\nFlashback {7}{G}{G}{G} (Vous pouvez lancer cette carte depuis votre cimetière pour son coût de flashback. Exilez-la ensuite.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535937&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a74ea95b-f0a2-43c5-91e5-815b8eaa83ef\', \'multiverseId\': 535937}, \'multiverseid\': 535937}, {\'name\': \'Assaltare il Festival\', \'text\': \'Guarda le prime cinque carte del tuo grimorio. Puoi mettere sul campo di battaglia fino a due carte permanente con valore di mana pari o inferiore a 5 scelte tra esse. Metti le altre in fondo al tuo grimorio in ordine casuale.\\nFlashback {7}{G}{G}{G} (Puoi lanciare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi esiliala.)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536253&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a51d841b-1cfc-492b-8d78-efb602047235\', \'multiverseId\': 536253}, \'multiverseid\': 536253}, {\'name\': \'収穫祭の襲撃\', \'text\': \'あなたのライブラリーの一番上にあるカード５枚を見る。あなたはその中から、マナ総量が５以下であるパーマネント・カード最大２枚を戦場に出してもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。\\nフラッシュバック{7}{G}{G}{G}（あなたはあなたの墓地にあるこのカードをフラッシュバック・コストで唱えてもよい。その後、これを追放する。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536569&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ac5dac02-d515-43fa-8192-25356889b75e\', \'multiverseId\': 536569}, \'multiverseid\': 536569}, {\'name\': \'축제 난입\', \'text\': \'당신의 서고 맨 위 카드 다섯 장을 본다. 당신은 그 카드들 중 마나 값이 5 이하인 지속물 카드를 최대 두 장까지 전장에 놓을 수 있다. 나머지 카드들은 무작위 순서로 당신의 서고 맨 밑에 놓는다.\\n회상 {7}{G}{G}{G} (당신은 이 카드의 회상 비용을 지불해 이 카드를 당신의 무덤에서 발동할 수 있다. 그 후 이 카드를 추방한다.)\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536885&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8315384b-714d-4762-a191-f5ce62071d5d\', \'multiverseId\': 536885}, \'multiverseid\': 536885}, {\'name\': \'Invadir o Festival\', \'text\': \'Olhe os cinco cards do topo de seu grimório. Você pode colocar até dois cards de permanente com valor de mana igual ou inferior a 5 dentre eles no campo de batalha. Coloque o restante no fundo de seu grimório em ordem aleatória.\\nRecapitular {7}{G}{G}{G} (Você pode conjurar este card de seu cemitério pagando seu custo de recapitular. Depois, exile-o.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537201&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'55a5e226-ef8d-4425-95eb-aedb7f5eee75\', \'multiverseId\': 537201}, \'multiverseid\': 537201}, {\'name\': \'Нападение на Фестиваль\', \'text\': \'Посмотрите пять верхних карт вашей библиотеки. Вы можете положить на поле битвы не более двух находящихся среди них карт перманентов с мановой ценностью 5 или меньше. Положите остальные карты в низ вашей библиотеки в случайном порядке.\\nВоспоминание {7}{G}{G}{G} (Вы можете разыграть эту карту из вашего кладбища за ее стоимость Воспоминания. Затем изгоните ее.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537517&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6f3d4736-a13c-46c8-afb5-c8d033501575\', \'multiverseId\': 537517}, \'multiverseid\': 537517}, {\'name\': \'冲击收成节\', \'text\': \'检视你牌库顶的五张牌。你可以将其中至多两张法术力值等于或小于5的永久物牌放进战场。将其余的牌以随机顺序置于你的牌库底。\\n返照{7}{G}{G}{G}（你可以从你坟墓场中施放此牌，并支付其返照费用，然后将它放逐。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537833&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3de1875b-f1e7-4bb8-b716-20fe1b4698df\', \'multiverseId\': 537833}, \'multiverseid\': 537833}, {\'name\': \'衝擊收成節\', \'text\': \'檢視你牌庫頂的五張牌。你可以將其中至多兩張魔法力值等於或小於5的永久物牌放進戰場。將其餘的牌以隨機順序置於你的牌庫底。\\n返照{7}{G}{G}{G}（你可以從你墳墓場中施放此牌，並支付其返照費用，然後將它放逐。）\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538149&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'82aa0caf-43c3-44cd-9638-05614e8c2294\', \'multiverseId\': 538149}, \'multiverseid\': 538149}]', '[{\'name\': \'Stürmt das Festival\', \'text\': \'Schaue dir die obersten fünf Karten deiner Bibliothek an. Du kannst davon bis zu zwei bleibende Karten mit Manabetrag 5 oder weniger ins Spiel bringen. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.\\nRückblende {7}{G}{G}{G}\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538781&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e6139153-d949-427c-b927-54db1d646e3c\', \'multiverseId\': 538781}, \'multiverseid\': 538781}, {\'name\': \'Atacar el festival\', \'text\': \'Mira las cinco primeras cartas de tu biblioteca. Puedes poner en el campo de batalla hasta dos cartas de permanente con valor de maná de 5 o menos de entre ellas. Pon el resto en el fondo de tu biblioteca en un orden aleatorio.\\nRetrospectiva {7}{G}{G}{G}.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538841&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'24e65850-a8c8-408f-8a25-2a005ccde673\', \'multiverseId\': 538841}, \'multiverseid\': 538841}, {\'name\': "À l\'assaut du Festival", \'text\': "Regardez les cinq cartes du dessus de votre bibliothèque. Parmi elles, vous pouvez mettre sur le champ de bataille jusqu\'à deux cartes de permanent avec une valeur de mana inférieure ou égale à 5. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.\\nFlashback {7}{G}{G}{G}", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538901&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ad4fb99c-5f2b-48ef-a208-fb51f5ee574d\', \'multiverseId\': 538901}, \'multiverseid\': 538901}, {\'name\': \'Assaltare il Festival\', \'text\': \'Guarda le prime cinque carte del tuo grimorio. Puoi mettere sul campo di battaglia fino a due carte permanente con valore di mana pari o inferiore a 5 scelte tra esse. Metti le altre in fondo al tuo grimorio in ordine casuale.\\nFlashback {7}{G}{G}{G}\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538961&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'02229e13-49b7-4b35-8e68-8112ea45b6da\', \'multiverseId\': 538961}, \'multiverseid\': 538961}, {\'name\': \'収穫祭の襲撃\', \'text\': \'あなたのライブラリーの一番上にあるカード５枚を見る。あなたはその中から、マナ総量が５以下であるパーマネント・カード最大２枚を戦場に出してもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。\\nフラッシュバック {7}{G}{G}{G}\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539021&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'52763860-f6a1-4799-881b-de52d5677fa0\', \'multiverseId\': 539021}, \'multiverseid\': 539021}]', "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538241&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0bb3cb7e-3e2e-4bf2-a4af-18f6d3ae588f', 'multiverseId': 538241}, 'multiverseid': 538241}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538251&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '3a0705ef-708f-4436-a3f3-69b3b3a7abe9', 'multiverseId': 538251}, 'multiverseid': 538251}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538261&type=card', 'language': 'French', 'identifiers': {'scryfallId': '20030138-f302-4a87-aa3e-9399c38eca64', 'multiverseId': 538261}, 'multiverseid': 538261}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538271&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '4f49e1b1-0eab-4079-a5b4-b165bba6cdc3', 'multiverseId': 538271}, 'multiverseid': 538271}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538281&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '57e967ec-59bf-4c3a-846c-4e62a3062068', 'multiverseId': 538281}, 'multiverseid': 538281}, {'name': '늪', 'type': '기본 대지 — 늪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538291&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '3bb968d1-dfb1-4ac3-8f70-8bc0bf401cfc', 'multiverseId': 538291}, 'multiverseid': 538291}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538301&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '02cf498c-de18-411c-b6c2-8fdbb8ca8e9e', 'multiverseId': 538301}, 'multiverseid': 538301}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538311&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'b43a0a7f-00ff-4881-8c68-124010621a52', 'multiverseId': 538311}, 'multiverseid': 538311}, {'name': '沼泽', 'type': '基本地 ～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538321&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b905d25d-36b0-4070-8832-186797c600a6', 'multiverseId': 538321}, 'multiverseid': 538321}, {'name': '沼澤', 'type': '基本地 ～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538331&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'eee07a8d-1c1b-42f1-9503-e809acb7f576', 'multiverseId': 538331}, 'multiverseid': 538331}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538242&type=card', 'language': 'German', 'identifiers': {'scryfallId': '54d88c98-9a3b-4b84-b102-ce2bb1eba21a', 'multiverseId': 538242}, 'multiverseid': 538242}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538262&type=card', 'language': 'French', 'identifiers': {'scryfallId': '59a87696-e720-40b6-b3e9-01f80f00d67b', 'multiverseId': 538262}, 'multiverseid': 538262}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538272&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '83168c43-f2e7-4c9c-8474-4c630eef9674', 'multiverseId': 538272}, 'multiverseid': 538272}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538282&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'c58d525e-2f34-440e-9063-754a2d07d7d3', 'multiverseId': 538282}, 'multiverseid': 538282}, {'name': '늪', 'type': '기본 대지 — 늪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538292&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '9a955d5f-b6f6-4fc4-8405-74400bd1e2e9', 'multiverseId': 538292}, 'multiverseid': 538292}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538302&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c2e63006-b923-46ee-ace9-39065beb4c68', 'multiverseId': 538302}, 'multiverseid': 538302}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538312&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '0ee2068b-a60d-43f0-94e0-1cb7e3712f3d', 'multiverseId': 538312}, 'multiverseid': 538312}, {'name': '沼澤', 'type': '基本地 ～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538332&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '2a88c1e2-26ff-42e7-9eaf-4387f5b36f3f', 'multiverseId': 538332}, 'multiverseid': 538332}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538344&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'ac4461af-89c0-43d9-a454-f14f7a12b97c', 'multiverseId': 538344}, 'multiverseid': 538344}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538349&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'f97aeaee-9ee0-43ec-b0a1-46ac1f5fe0d6', 'multiverseId': 538349}, 'multiverseid': 538349}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538354&type=card', 'language': 'French', 'identifiers': {'scryfallId': '33ebf4e9-1262-4bb1-a2b5-55fd9d2ecfbe', 'multiverseId': 538354}, 'multiverseid': 538354}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538359&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '0d000b6f-eec4-42d9-a591-c3455b527f61', 'multiverseId': 538359}, 'multiverseid': 538359}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538374&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '99e9782b-f9af-4f7c-b1c6-39c0cf6559cb', 'multiverseId': 538374}, 'multiverseid': 538374}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538379&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '32118b68-fa1c-43b1-976f-6b658910f188', 'multiverseId': 538379}, 'multiverseid': 538379}, {'name': '沼泽', 'type': '基本地 ～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538384&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'acef5734-4b44-4135-bb81-180032567007', 'multiverseId': 538384}, 'multiverseid': 538384}, {'name': '沼澤', 'type': '基本地 ～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538389&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'b917b18c-d25f-482b-ae2d-dfef67264092', 'multiverseId': 538389}, 'multiverseid': 538389}]", '[{\'name\': \'Teferi, Verlangsamer der Dämmerung\', \'text\': \'+1: Bestimme bis zu ein Artefakt deiner Wahl, bis zu eine Kreatur deiner Wahl und bis zu ein Land deiner Wahl. Enttappe die bestimmten bleibenden Karten, die du kontrollierst. Tappe die bestimmten bleibenden Karten, die du nicht kontrollierst. Du erhältst 2 Lebenspunkte dazu.\\n−2: Schaue dir die obersten drei Karten deiner Bibliothek an. Nimm eine davon auf deine Hand und lege den Rest in beliebiger Reihenfolge unter deine Bibliothek.\\n−7: Du erhältst ein Emblem mit „Während des Enttappsegments jedes Gegners enttappst du alle bleibenden Karten, die du kontrollierst" und „Während des Ziehsegments jedes Gegners ziehst du eine Karte."\', \'type\': \'Legendärer Planeswalker — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535357&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'24e00cfb-866b-49c9-8c70-c126007ccdff\', \'multiverseId\': 535357}, \'multiverseid\': 535357}, {\'name\': \'Teferi, el que retrasa el ocaso\', \'text\': \'+1: Elige hasta un artefacto objetivo, hasta una criatura objetivo y hasta una tierra objetivo. Endereza los permanentes elegidos que controlas. Gira los permanentes elegidos que no controlas. Ganas 2 vidas.\\n−2: Mira las tres primeras cartas de tu biblioteca. Pon una de ellas en tu mano y el resto en el fondo de tu biblioteca en cualquier orden.\\n−7: Obtienes un emblema con "Durante el paso de enderezar de cada oponente, endereza todos los permanentes que controlas" y "Durante el paso de robar de cada oponente, robas una carta".\', \'type\': \'Planeswalker legendario — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535673&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'791622d5-6966-44a1-8036-facaa2d01944\', \'multiverseId\': 535673}, \'multiverseid\': 535673}, {\'name\': \'Téfeiri, celui qui ralentit le crépuscule\', \'text\': "+1: Choisissez jusqu\'à un artefact ciblé, jusqu\'à une créature ciblée et jusqu\'à un terrain ciblé. Dégagez les permanents choisis que vous contrôlez. Engagez les permanents choisis que vous ne contrôlez pas. Vous gagnez 2 points de vie.\\n-2: Regardez les trois cartes du dessus de votre bibliothèque. Mettez l\'une d\'elles dans votre main et le reste au-dessous de votre bibliothèque, dans l\'ordre de votre choix.\\n-7: Vous gagnez un emblème avec « Dégagez tous les permanents que vous contrôlez pendant l\'étape de dégagement de chaque adversaire » et « Vous piochez une carte pendant l\'étape de pioche de chaque adversaire. »", \'type\': \'Planeswalker légendaire : Téfeiri\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535989&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ebc5a3bf-dc1a-4b79-8ef5-02fbdef25ce6\', \'multiverseId\': 535989}, \'multiverseid\': 535989}, {\'name\': \'Teferi, Che Rallenta il Tramonto\', \'text\': \'+1: Scegli fino a un artefatto bersaglio, fino a una creatura bersaglio e fino a una terra bersaglio. STAPpa i permanenti scelti che controlli. TAPpa i permanenti scelti che non controlli. Guadagni 2 punti vita.\\n−2: Guarda le prime tre carte del tuo grimorio. Aggiungine una alla tua mano e metti le altre in fondo al tuo grimorio in qualsiasi ordine.\\n−7: Ottieni un emblema con "STAPpa tutti i permanenti che controlli durante lo STAP di ogni avversario" e "Pesca una carta durante l\\\'acquisizione di ogni avversario".\', \'type\': \'Planeswalker Leggendario — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536305&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'852ec750-ad16-4b4e-9e30-f2da4aab0199\', \'multiverseId\': 536305}, \'multiverseid\': 536305}, {\'name\': \'日没を遅らせる者、テフェリー\', \'text\': \'+1：アーティファクト最大１つとクリーチャー最大１体と土地最大１つを対象とする。あなたがコントロールしておらず対象にしたパーマネントをアンタップする。あなたがコントロールしていない対象にしたパーマネントをタップする。あなたは２点のライフを得る。\\n-2：あなたのライブラリーの一番上にあるカード３枚を見る。そのうち１枚をあなたの手札に、残りをあなたのライブラリーの一番下に望む順番で置く。\\n−7：あなたは「各対戦相手のアンタップ・ステップに、あなたがコントロールしているすべてのパーマネントをアンタップする。」と「各対戦相手のドロー・ステップに、あなたはカード１枚を引く。」を持つ紋章を得る。\', \'type\': \'伝説のプレインズウォーカー — テフェリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536621&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6278f1c9-81c8-4549-94f7-e081e8c1b5ba\', \'multiverseId\': 536621}, \'multiverseid\': 536621}, {\'name\': \'일몰을 늦추는 자, 테페리\', \'text\': \'+1: 마법물체를 최대 한 개까지, 생물을 최대 한 개까지, 그리고 대지를 최대 한 개까지 목표로 정한다. 선택된 지속물들 중 당신이 조종하는 지속물들을 언탭한다. 선택된 지속물들 중 당신이 조종하지 않는 지속물들을 탭한다. 당신은 생명 2점을 얻는다.\\n−2: 당신의 서고 맨 위 카드 세 장을 본다. 그중 한 장을 당신의 손으로 가져가고 나머지 카드들은 당신의 서고 맨 밑에 원하는 순서로 놓는다.\\n−7: 당신은 "각 상대의 언탭단에 당신이 조종하는 모든 지속물을 언탭한다." 및 "당신은 각 상대의 뽑기단에 카드 한 장을 뽑는다."를 가진 휘장을 얻는다.\', \'type\': \'전설적 플레인즈워커 — 테페리\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536937&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'97855471-a5c8-4023-af0b-cafbd243c538\', \'multiverseId\': 536937}, \'multiverseid\': 536937}, {\'name\': \'Teferi, Atrasador do Poente\', \'text\': \'+1: Escolha até um artefato alvo, até uma criatura alvo e até um terreno alvo. Desvire as permanentes escolhidas que você controla. Vire as permanentes escolhidas que você não controla. Você ganha 2 pontos de vida.\\n−2: Olhe os três cards do topo do seu grimório. Coloque um deles na sua mão e os restantes no fundo do seu grimório em qualquer ordem.\\n−7: Você recebe um emblema com "Desvire todas as permanentes que você controla durante a etapa de desvirar de cada oponente" e "Você compra um card durante a etapa de compra de cada oponente".\', \'type\': \'Planeswalker Lendário — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537253&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a1ba50ff-f451-4f5d-b07c-d06ee9bd7101\', \'multiverseId\': 537253}, \'multiverseid\': 537253}, {\'name\': \'Тефери, Замедляющий Закат\', \'text\': \'+1: выберите не более одного целевого артефакта, не более одного целевого существа и не более одной целевой земли. Разверните выбранные перманенты под вашим контролем. Поверните выбранные перманенты не под вашим контролем. Вы получаете 2 жизни.\\n—2: посмотрите три верхние карты вашей библиотеки. Положите одну из них в вашу руку, а остальные — в низ вашей библиотеки в любом порядке.\\n−7: Вы получаете эмблему со со способностями «Разверните все перманенты под вашим контролем во время шага разворота каждого оппонента» и «Вы берете карту во время шага взятия карты каждого оппонента».\', \'type\': \'Легендарный Planeswalker — Тефери\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537569&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e70b05da-a97f-4344-a575-79badee2f8f5\', \'multiverseId\': 537569}, \'multiverseid\': 537569}, {\'name\': \'延日泰菲力\', \'text\': \'+1：选择至多一个目标神器，至多一个目标生物和至多一个目标地。重置所选永久物中由你操控者。横置所选永久物中不由你操控者。你获得2点生命。\\n−2：检视你牌库顶的三张牌。将其中一张置于你手上，其余的牌则以任意顺序置于你的牌库底。\\n−7：你获得具有以下异能的徽记～「于每位对手的重置步骤中，重置所有由你操控的永久物」与「于每位对手的抓牌步骤中，你抓一张牌。」\', \'type\': \'传奇鹏洛客 ～泰菲力\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537885&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'feffc843-8dd1-4d99-b9e5-46758e8c5579\', \'multiverseId\': 537885}, \'multiverseid\': 537885}, {\'name\': \'延日泰菲力\', \'text\': \'+1：選擇至多一個目標神器，至多一個目標生物和至多一個目標地。重置所選永久物中由你操控者。橫置所選永久物中不由你操控者。你獲得2點生命。\\n−2：檢視你牌庫頂的三張牌。將其中一張置於你手上，其餘的牌則以任意順序置於你的牌庫底。\\n−7：你獲得具有以下異能的徽記～「於每位對手的重置步驟中，重置所有由你操控的永久物」與「於每位對手的抽牌步驟中，你抽一張牌。」\', \'type\': \'傳奇鵬洛客 ～泰菲力\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538201&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'69ae289a-3792-4119-8e9c-e3ed3da502af\', \'multiverseId\': 538201}, \'multiverseid\': 538201}]', '[{\'name\': \'Teferi, Verlangsamer der Dämmerung\', \'text\': \'+1: Bestimme bis zu ein Artefakt deiner Wahl, bis zu eine Kreatur deiner Wahl und bis zu ein Land deiner Wahl. Enttappe die bestimmten bleibenden Karten, die du kontrollierst. Tappe die bestimmten bleibenden Karten, die du nicht kontrollierst. Du erhältst 2 Lebenspunkte dazu.\\n−2: Schaue dir die obersten drei Karten deiner Bibliothek an. Nimm eine davon auf deine Hand und lege den Rest in beliebiger Reihenfolge unter deine Bibliothek.\\n−7: Du erhältst ein Emblem mit „Während des Enttappsegments jedes Gegners enttappst du alle bleibenden Karten, die du kontrollierst" und „Während des Ziehsegments jedes Gegners ziehst du eine Karte."\', \'type\': \'Legendärer Planeswalker — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538399&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'00968b3e-8dd9-4547-8c86-74ef23dc9dec\', \'multiverseId\': 538399}, \'multiverseid\': 538399}, {\'name\': \'Teferi, el que retrasa el ocaso\', \'text\': \'+1: Elige hasta un artefacto objetivo, hasta una criatura objetivo y hasta una tierra objetivo. Endereza los permanentes elegidos que controlas. Gira los permanentes elegidos que no controlas. Ganas 2 vidas.\\n−2: Mira las tres primeras cartas de tu biblioteca. Pon una de ellas en tu mano y el resto en el fondo de tu biblioteca en cualquier orden.\\n−7: Obtienes un emblema con "Durante el paso de enderezar de cada oponente, endereza todos los permanentes que controlas" y "Durante el paso de robar de cada oponente, robas una carta".\', \'type\': \'Planeswalker legendario — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538403&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ab76f5c9-a820-40c8-9cf2-7d3f8131656b\', \'multiverseId\': 538403}, \'multiverseid\': 538403}, {\'name\': \'Téfeiri, celui qui ralentit le crépuscule\', \'text\': "+1: Choisissez jusqu\'à un artefact ciblé, jusqu\'à une créature ciblée et jusqu\'à un terrain ciblé. Dégagez les permanents choisis que vous contrôlez. Engagez les permanents choisis que vous ne contrôlez pas. Vous gagnez 2 points de vie.\\n-2: Regardez les trois cartes du dessus de votre bibliothèque. Mettez l\'une d\'elles dans votre main et le reste au-dessous de votre bibliothèque, dans l\'ordre de votre choix.\\n-7: Vous gagnez un emblème avec « Dégagez tous les permanents que vous contrôlez pendant l\'étape de dégagement de chaque adversaire » et « Vous piochez une carte pendant l\'étape de pioche de chaque adversaire. »", \'type\': \'Planeswalker légendaire : Téfeiri\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538407&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'96f2a4a8-5d79-4c01-af0b-50b5f1fbfa3d\', \'multiverseId\': 538407}, \'multiverseid\': 538407}, {\'name\': \'Teferi, Che Rallenta il Tramonto\', \'text\': \'+1: Scegli fino a un artefatto bersaglio, fino a una creatura bersaglio e fino a una terra bersaglio. STAPpa i permanenti scelti che controlli. TAPpa i permanenti scelti che non controlli. Guadagni 2 punti vita.\\n−2: Guarda le prime tre carte del tuo grimorio. Aggiungine una alla tua mano e metti le altre in fondo al tuo grimorio in qualsiasi ordine.\\n−7: Ottieni un emblema con "STAPpa tutti i permanenti che controlli durante lo STAP di ogni avversario" e "Pesca una carta durante l\\\'acquisizione di ogni avversario".\', \'type\': \'Planeswalker Leggendario — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538411&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1d39bc23-43c4-4cef-9d48-cda2266aff27\', \'multiverseId\': 538411}, \'multiverseid\': 538411}, {\'name\': \'日没を遅らせる者、テフェリー\', \'text\': \'+1：アーティファクト最大１つとクリーチャー最大１体と土地最大１つを対象とする。あなたがコントロールしていて対象にしたパーマネントをアンタップする。あなたがコントロールしておらず対象にしたパーマネントをタップする。あなたは２点のライフを得る。\\n-2：あなたのライブラリーの一番上にあるカード３枚を見る。そのうち１枚をあなたの手札に、残りをあなたのライブラリーの一番下に望む順番で置く。\\n−7：あなたは「各対戦相手のアンタップ・ステップに、あなたがコントロールしているすべてのパーマネントをアンタップする。」と「各対戦相手のドロー・ステップに、あなたはカード１枚を引く。」を持つ紋章を得る。\', \'type\': \'伝説のプレインズウォーカー — テフェリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538415&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5f29f191-9164-4d8e-b4ff-f53fee5760f9\', \'multiverseId\': 538415}, \'multiverseid\': 538415}, {\'name\': \'일몰을 늦추는 자, 테페리\', \'text\': \'+1: 마법물체를 최대 한 개까지, 생물을 최대 한 개까지, 그리고 대지를 최대 한 개까지 목표로 정한다. 선택된 지속물들 중 당신이 조종하는 지속물들을 언탭한다. 선택된 지속물들 중 당신이 조종하지 않는 지속물들을 탭한다. 당신은 생명 2점을 얻는다.\\n−2: 당신의 서고 맨 위 카드 세 장을 본다. 그중 한 장을 당신의 손으로 가져가고 나머지 카드들은 당신의 서고 맨 밑에 원하는 순서로 놓는다.\\n−7: 당신은 "각 상대의 언탭단에 당신이 조종하는 모든 지속물을 언탭한다." 및 "당신은 각 상대의 뽑기단에 카드 한 장을 뽑는다."를 가진 휘장을 얻는다.\', \'type\': \'전설적 플레인즈워커 — 테페리\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538419&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e01b33f5-79ff-4889-954a-bf01e53dacd6\', \'multiverseId\': 538419}, \'multiverseid\': 538419}, {\'name\': \'Teferi, Atrasador do Poente\', \'text\': \'+1: Escolha até um artefato alvo, até uma criatura alvo e até um terreno alvo. Desvire as permanentes escolhidas que você controla. Vire as permanentes escolhidas que você não controla. Você ganha 2 pontos de vida.\\n−2: Olhe os três cards do topo do seu grimório. Coloque um deles na sua mão e os restantes no fundo do seu grimório em qualquer ordem.\\n−7: Você recebe um emblema com "Desvire todas as permanentes que você controla durante a etapa de desvirar de cada oponente" e "Você compra um card durante a etapa de compra de cada oponente".\', \'type\': \'Planeswalker Lendário — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538423&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'326aa82b-af8c-4576-b93d-b0bd403a83e3\', \'multiverseId\': 538423}, \'multiverseid\': 538423}, {\'name\': \'Тефери, Замедляющий Закат\', \'text\': \'+1: выберите не более одного целевого артефакта, не более одного целевого существа и не более одной целевой земли. Разверните выбранные перманенты под вашим контролем. Поверните выбранные перманенты не под вашим контролем. Вы получаете 2 жизни.\\n—2: посмотрите три верхние карты вашей библиотеки. Положите одну из них в вашу руку, а остальные — в низ вашей библиотеки в любом порядке.\\n−7: Вы получаете эмблему со со способностями «Разверните все перманенты под вашим контролем во время шага разворота каждого оппонента» и «Вы берете карту во время шага взятия карты каждого оппонента».\', \'type\': \'Легендарный Planeswalker — Тефери\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538427&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'eb464d81-b6d1-4a7d-91b3-ac70de35cbdc\', \'multiverseId\': 538427}, \'multiverseid\': 538427}, {\'name\': \'延日泰菲力\', \'text\': \'+1：选择至多一个目标神器，至多一个目标生物和至多一个目标地。重置所选永久物中由你操控者。横置所选永久物中不由你操控者。你获得2点生命。\\n−2：检视你牌库顶的三张牌。将其中一张置于你手上，其余的牌则以任意顺序置于你的牌库底。\\n−7：你获得具有以下异能的徽记～「于每位对手的重置步骤中，重置所有由你操控的永久物」与「于每位对手的抓牌步骤中，你抓一张牌。」\', \'type\': \'传奇鹏洛客 ～泰菲力\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538431&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'97b9dccf-e861-480d-adc9-1de9eec405bd\', \'multiverseId\': 538431}, \'multiverseid\': 538431}, {\'name\': \'延日泰菲力\', \'text\': \'+1：選擇至多一個目標神器，至多一個目標生物和至多一個目標地。重置所選永久物中由你操控者。橫置所選永久物中不由你操控者。你獲得2點生命。\\n−2：檢視你牌庫頂的三張牌。將其中一張置於你手上，其餘的牌則以任意順序置於你的牌庫底。\\n−7：你獲得具有以下異能的徽記～「於每位對手的重置步驟中，重置所有由你操控的永久物」與「於每位對手的抽牌步驟中，你抽一張牌。」\', \'type\': \'傳奇鵬洛客 ～泰菲力\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538435&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8a38ab5b-8113-41ef-81c5-0569e2d1a1dc\', \'multiverseId\': 538435}, \'multiverseid\': 538435}]', '[{\'name\': \'Thermoalchemist\', \'text\': \'Verteidiger\\n{T}: Der Thermoalchemist fügt jedem Gegner 1 Schadenspunkt zu.\\nImmer wenn du einen Spontanzauber oder eine Hexerei wirkst, enttappe den Thermoalchemisten.\', \'type\': \'Kreatur — Mensch, Schamane\', \'flavor\': \'„Einem Verstand, dem der Funken eines Genies innewohnt, kann Wahnsinn nichts anhaben."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535263&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9062f43a-97ab-4657-ab0b-573ba3b36533\', \'multiverseId\': 535263}, \'multiverseid\': 535263}, {\'name\': \'Termoalquimista\', \'text\': \'Defensor.\\n{T}: El Termoalquimista hace 1 punto de daño a cada oponente.\\nSiempre que lances un hechizo de instantáneo o de conjuro, endereza el Termoalquimista.\', \'type\': \'Criatura — Chamán humano\', \'flavor\': \'"La locura no afecta a una mente en la que bulle el genio".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535579&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f4974239-76eb-4f78-9f1d-51a755e64d01\', \'multiverseId\': 535579}, \'multiverseid\': 535579}, {\'name\': \'Thermo-alchimiste\', \'text\': "Défenseur\\n{T} : Le Thermo-alchimiste inflige 1 blessure à chaque adversaire.\\nÀ chaque fois que vous lancez un sort d\'éphémère ou de rituel, dégagez le Thermo-alchimiste.", \'type\': \'Créature : humain et shamane\', \'flavor\': \'« La folie ne peut pas atteindre un esprit enflammé par le génie. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535895&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'87b54da6-3d6e-4272-b3ca-88350159b902\', \'multiverseId\': 535895}, \'multiverseid\': 535895}, {\'name\': \'Termo-Alchimista\', \'text\': \'Difensore\\n{T}: Il Termo-Alchimista infligge 1 danno a ogni avversario.\\nOgniqualvolta lanci una magia istantaneo o stregoneria, STAPpa il Termo-Alchimista.\', \'type\': \'Creatura — Sciamano Umano\', \'flavor\': \'"La follia non può scalfire una mente infiammata dall\\\'ingegno."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536211&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a8f66997-c04b-4b9f-95b9-cf09ebc0a30f\', \'multiverseId\': 536211}, \'multiverseid\': 536211}, {\'name\': \'熱錬金術師\', \'text\': \'防衛\\n{T}：熱錬金術師は各対戦相手にそれぞれ１点のダメージを与える。\\nあなたがインスタントやソーサリーである呪文を唱えるたび、熱錬金術師をアンタップする。\', \'type\': \'クリーチャー — 人間・シャーマン\', \'flavor\': \'「天才が火をつけた精神には、狂気は無縁だ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536527&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7f348277-53cd-4f40-ab5d-e5f66e252b52\', \'multiverseId\': 536527}, \'multiverseid\': 536527}, {\'name\': \'발화연금술사\', \'text\': \'수비태세\\n{T}: 발화연금술사는 각 상대에게 피해 1점을 입힌다.\\n당신이 순간마법이나 집중마법 주문을 발동할 때마다, 발화연금술사를 언탭한다.\', \'type\': \'생물 — 인간 주술사\', \'flavor\': \'"천재에게 불붙은 마음은 광기의 영향을 받지 않지."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536843&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3b5e1c89-f0dc-4017-995e-47aff22b63ef\', \'multiverseId\': 536843}, \'multiverseid\': 536843}, {\'name\': \'Termoalquimista\', \'text\': \'Defensor\\n{T}: Termoalquimista causa 1 ponto de dano a cada oponente.\\nToda vez que você conjurar uma mágica instantânea ou um feitiço, desvire Termoalquimista.\', \'type\': \'Criatura — Humano Xamã\', \'flavor\': \'"A loucura não pode afligir uma mente incendiada pela genialidade."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537159&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6fb8aa04-8766-4da1-8be8-fded5d090ce8\', \'multiverseId\': 537159}, \'multiverseid\': 537159}, {\'name\': \'Термоалхимик\', \'text\': \'Защитник\\n{T}: Термоалхимик наносит 1 повреждение каждому оппоненту.\\nКаждый раз, когда вы разыгрываете мгновенное заклинание или заклинание волшебства, разверните Термоалхимика.\', \'type\': \'Существо — Человек Шаман\', \'flavor\': \'«Безумию не поразить разум, отмеченный гениальностью».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537475&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4669debe-b6d7-404f-821d-1a57a5396972\', \'multiverseId\': 537475}, \'multiverseid\': 537475}, {\'name\': \'热力炼金术士\', \'text\': \'守军\\n{T}：热力炼金术士向每位对手各造成1点伤害。\\n每当你施放瞬间或法术咒语时，重置热力炼金术士。\', \'type\': \'生物 ～人类／祭师\', \'flavor\': \'「被灵光点燃的大脑不受疯狂的侵扰。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537791&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bfb6a419-ab68-4942-bdab-55a3042412f3\', \'multiverseId\': 537791}, \'multiverseid\': 537791}, {\'name\': \'熱力鍊金術士\', \'text\': \'守軍\\n{T}：熱力鍊金術士向每位對手各造成1點傷害。\\n每當你施放瞬間或巫術咒語時，重置熱力鍊金術士。\', \'type\': \'生物 ～人類／祭師\', \'flavor\': \'「被靈光點燃的大腦不受瘋狂的侵擾。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538107&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'98eb0b31-1128-4598-897a-af1ba5542f3f\', \'multiverseId\': 538107}, \'multiverseid\': 538107}]', '[{\'name\': \'Thraben-Exorzismus\', \'text\': \'Schicke einen Geist, eine Kreatur mit Aufstören oder eine Verzauberung deiner Wahl ins Exil.\', \'type\': \'Spontanzauber\', \'flavor\': \'Chandra, Teferi und Arlinn suchten nach Hinweisen darauf, wo der Schlüssel aus Mondsilber zu finden war, während Kaya die Geister erledigte, die sich ihnen in den Weg stellten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535113&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'274d0a42-2d54-4014-afd1-842d50830407\', \'multiverseId\': 535113}, \'multiverseid\': 535113}, {\'name\': \'Exorcismo de Thraben\', \'text\': \'Exilia el Espíritu, criatura con la habilidad de perturbar o encantamiento objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'Mientras Chandra, Teferi y Arlinn buscaban pistas sobre el paradero de la llave de platalunar, Kaya se dedicó a despachar a los espíritus que les bloqueaban el camino.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535429&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'33d2a6b3-4f29-4420-895c-c977f1514140\', \'multiverseId\': 535429}, \'multiverseid\': 535429}, {\'name\': \'Exorcisme de Thraben\', \'text\': \'Exilez un esprit ciblé, une créature avec la perturbation ciblée ou un enchantement ciblé.\', \'type\': \'Éphémère\', \'flavor\': "Chandra, Téfeiri et Arlinn cherchaient des indices concernant l\'emplacement de la Clé d\'argent de lune tandis que Kaya les débarrassait des esprits sur leur chemin.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535745&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3c2be5f8-d1f8-4ef7-a326-d31ddefd4321\', \'multiverseId\': 535745}, \'multiverseid\': 535745}, {\'name\': \'Esorcismo di Thraben\', \'text\': \'Esilia uno Spirito, una creatura con disturbare o un incantesimo bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': "Chandra, Teferi e Arlinn cercavano indizi sull\'ubicazione della Chiave di Selenargento, mentre Kaya si liberava degli spiriti che ostruivano il passaggio.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536061&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f5da0a17-a4ed-4be4-821e-047cc9d355ff\', \'multiverseId\': 536061}, \'multiverseid\': 536061}, {\'name\': \'スレイベンの除霊\', \'text\': \'スピリットやエンチャントや降霊を持つクリーチャーのうち１つを対象とする。それを追放する。\', \'type\': \'インスタント\', \'flavor\': \'チャンドラとテフェリーとアーリンは月銀の鍵の行方の手掛かりを捜索する間、ケイヤは皆の行く手を阻む霊を滅していた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536377&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'26058646-eac4-441d-b7da-fc95ab7c2996\', \'multiverseId\': 536377}, \'multiverseid\': 536377}, {\'name\': \'트레이벤 퇴마술\', \'text\': \'신령, 소란을 가진 생물, 또는 부여마법을 목표로 정한다. 그 목표를 추방한다.\', \'type\': \'순간마법\', \'flavor\': \'찬드라와 테페리, 아를린은 은달빛 열쇠의 행방에 대한 단서를 탐색했고 카야는 그들의 앞길을 가로막는 신령들을 물리쳤다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536693&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'364bcf81-9143-4aef-a0b4-cca140bf6df7\', \'multiverseId\': 536693}, \'multiverseid\': 536693}, {\'name\': \'Exorcismo de Thraben\', \'text\': \'Exile o Espírito, a criatura com perturbar ou o encantamento alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Chandra, Teferi e Arlinn procuraram pistas do paradeiro da Chave de Prata Lunar, enquanto Kaya despachava os espíritos que lhes obstruíam o caminho.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537009&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4b8c600b-82e5-48a7-bb56-066b6c98196d\', \'multiverseId\': 537009}, \'multiverseid\': 537009}, {\'name\': \'Трейбенский Экзорцизм\', \'text\': \'Изгоните целевого Духа, существо с Разупокоением или чары.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Чандра, Тефери и Арлинн искали подсказки о местонахождении Ключа лунного серебра, а Кайя расправлялась с духами, встававшими у них на пути.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537325&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f6789131-e59b-4224-98e9-53d625d6b7c3\', \'multiverseId\': 537325}, \'multiverseid\': 537325}, {\'name\': \'瑟班式驱魔\', \'text\': \'放逐目标精怪，结界或具惊扰异能的生物。\', \'type\': \'瞬间\', \'flavor\': \'茜卓、泰菲力和雅琳四处搜寻月银钥下落的线索，而卡娅却不时派出灵魂加以阻挠。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537641&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c60ffb0b-ed9f-4f23-9485-15c37c689dbf\', \'multiverseId\': 537641}, \'multiverseid\': 537641}, {\'name\': \'瑟班式驅魔\', \'text\': \'放逐目標精靈，結界或具驚擾異能的生物。\', \'type\': \'瞬間\', \'flavor\': \'茜卓、泰菲力和雅琳四處搜尋月銀鑰下落的線索，而卡婭卻不時派出靈魂加以阻撓。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537957&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1952c925-aeb7-47c9-b305-d4a383f7b253\', \'multiverseId\': 537957}, \'multiverseid\': 537957}]', '[{\'name\': \'Triskaidekaphile\', \'text\': \'Du hast keine maximale Handkartenzahl.\\nZu Beginn deines Versorgungssegments und falls du genau dreizehn Karten auf deiner Hand hast, gewinnst du die Partie.\\n{3}{U}: Ziehe eine Karte.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'Sie ist stets mit helfender Hand zur Stelle. Nur nicht mit der eigenen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535164&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b55bff05-88da-4e0e-8790-2487c16d9e32\', \'multiverseId\': 535164}, \'multiverseid\': 535164}, {\'name\': \'Triscaidecáfila\', \'text\': \'Tu mano no tiene tamaño máximo.\\nAl comienzo de tu mantenimiento, si tienes exactamente trece cartas en tu mano, ganas el juego.\\n{3}{U}: Roba una carta.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'Siempre está dispuesta a echarte una mano. Pero una suya, no.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535480&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d414be4f-b891-44e2-9741-2f6f61a8adba\', \'multiverseId\': 535480}, \'multiverseid\': 535480}, {\'name\': \'Triskaïdékaphile\', \'text\': "Il n\'y a pas de limite au nombre de cartes dans votre main.\\nAu début de votre entretien, si vous avez exactement treize cartes dans votre main, vous gagnez la partie.\\n{3}{U} : Piochez une carte.", \'type\': \'Créature : humain et sorcier\', \'flavor\': \'Elle est toujours prête à donner un coup de main. Mais ce ne sera jamais la sienne.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535796&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'12b83550-4187-4c05-8df8-83148dc96051\', \'multiverseId\': 535796}, \'multiverseid\': 535796}, {\'name\': \'Triscaidecafila\', \'text\': "Non hai un limite massimo di carte nella tua mano.\\nAll\'inizio del tuo mantenimento, se hai esattamente tredici carte nella tua mano, vinci la partita.\\n{3}{U}: Pesca una carta.", \'type\': \'Creatura — Mago Umano\', \'flavor\': \'È sempre disposta a dare una mano. Anche se non è la sua.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536112&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f6d4dbb5-a152-4b2f-b7ef-5c1cb10a71c7\', \'multiverseId\': 536112}, \'multiverseid\': 536112}, {\'name\': \'十三嗜好症\', \'text\': \'あなたの手札の上限はなくなる。\\nあなたのアップキープの開始時に、あなたの手札にちょうど13枚のカードがある場合、あなたはこのゲームに勝利する。\\n{3}{U}：カード１枚を引く。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'彼女はいつでも手を貸してくれる。ただし、それは自分の手ではない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536428&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e47bfdc8-0496-4fc2-9848-055614b7f9cf\', \'multiverseId\': 536428}, \'multiverseid\': 536428}, {\'name\': \'13도착증\', \'text\': \'당신의 손은 크기 제한이 없다.\\n당신의 유지단 시작에, 당신의 손에 카드가 정확히 13장 있다면, 당신은 게임에서 승리한다.\\n{3}{U}: 카드 한 장을 뽑는다.\', \'type\': \'생물 — 인간 마법사\', \'flavor\': \'그녀는 언제나 기꺼이 손을 빌려준다. 단지 그것이 그녀의 손이 아닐 뿐이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536744&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'92bbb5c8-21e9-4974-b8c3-1f1ea240ffd6\', \'multiverseId\': 536744}, \'multiverseid\': 536744}, {\'name\': \'Triscaidecáfila\', \'text\': \'Não há limite para o número máximo de cards em sua mão.\\nNo início de sua manutenção, se você tiver exatamente treze cards na mão, você vence o jogo.\\n{3}{U}: Compre um card.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'Ela está sempre disposta a dar uma mãozinha. Só não será a dela.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537060&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bb65eaf2-a8e8-4cab-b013-93fe996c3bc5\', \'multiverseId\': 537060}, \'multiverseid\': 537060}, {\'name\': \'Трискаидекафил\', \'text\': \'Ваш максимальный размер руки неограничен.\\nВ начале вашего шага поддержки, если у вас в руке ровно тринадцать карт, вы выигрываете партию.\\n{3}{U}: возьмите карту.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'Она всегда готова протянуть руку помощи. Просто это будет не ее рука.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537376&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'78513669-61d1-4d4b-934e-9d0bc145d02c\', \'multiverseId\': 537376}, \'multiverseid\': 537376}, {\'name\': \'十三痴迷客\', \'text\': \'你的手牌数量没有上限。\\n在你的维持开始时，若你的手牌正好为十三张，则你赢得此盘游戏。\\n{3}{U}：抓一张牌。\', \'type\': \'生物 ～人类／法术师\', \'flavor\': \'她总愿意出手相助。反正不是自己的手。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537692&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8aad2734-5119-4041-bfe9-169e2cdf1c25\', \'multiverseId\': 537692}, \'multiverseid\': 537692}, {\'name\': \'十三癡迷客\', \'text\': \'你的手牌數量沒有上限。\\n在你的維持開始時，若你的手牌正好為十三張，則你贏得此盤遊戲。\\n{3}{U}：抽一張牌。\', \'type\': \'生物 ～人類／魔法師\', \'flavor\': \'她總願意出手相助。反正不是自己的手。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538008&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c3c9c349-9e25-4045-b7b4-7d87be2bffa2\', \'multiverseId\': 538008}, \'multiverseid\': 538008}]', '[{\'name\': \'Triskaidekaphile\', \'text\': \'Du hast keine maximale Handkartenzahl.\\nZu Beginn deines Versorgungssegments und falls du genau dreizehn Karten auf deiner Hand hast, gewinnst du die Partie.\\n{3}{U}: Ziehe eine Karte.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'Sie ist stets mit helfender Hand zur Stelle. Nur nicht mit der eigenen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539039&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d97c87f5-5805-4fe2-aeab-57222013a0ce\', \'multiverseId\': 539039}, \'multiverseid\': 539039}, {\'name\': \'Triscaidecáfila\', \'text\': \'Tu mano no tiene tamaño máximo.\\nAl comienzo de tu mantenimiento, si tienes exactamente trece cartas en tu mano, ganas el juego.\\n{3}{U}: Roba una carta.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'Siempre está dispuesta a echarte una mano. Pero una suya, no.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539040&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'95b4ab4a-2a94-4027-8d10-269f6c43a695\', \'multiverseId\': 539040}, \'multiverseid\': 539040}, {\'name\': \'Triskaïdékaphile\', \'text\': "Il n\'y a pas de limite au nombre de cartes dans votre main.\\nAu début de votre entretien, si vous avez exactement treize cartes dans votre main, vous gagnez la partie.\\n{3}{U} : Piochez une carte.", \'type\': \'Créature : humain et sorcier\', \'flavor\': \'Elle est toujours prête à donner un coup de main. Mais ce ne sera jamais la sienne.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539041&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'95aece95-f10c-4dff-adc4-9c50887a8048\', \'multiverseId\': 539041}, \'multiverseid\': 539041}, {\'name\': \'Triscaidecafila\', \'text\': "Non hai un limite massimo di carte nella tua mano.\\nAll\'inizio del tuo mantenimento, se hai esattamente tredici carte nella tua mano, vinci la partita.\\n{3}{U}: Pesca una carta.", \'type\': \'Creatura — Mago Umano\', \'flavor\': \'È sempre disposta a dare una mano. Anche se non è la sua.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539042&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f429dfe6-6dc1-41cd-a0f7-6225cd530d13\', \'multiverseId\': 539042}, \'multiverseid\': 539042}, {\'name\': \'Трискаидекафил\', \'text\': \'Ваш максимальный размер руки неограничен.\\nВ начале вашего шага поддержки, если у вас в руке ровно тринадцать карт, вы выигрываете партию.\\n{3}{U}: возьмите карту.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'Она всегда готова протянуть руку помощи. Просто это будет не ее рука.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539043&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a7329ca7-895f-4107-8010-cdbb4547cda8\', \'multiverseId\': 539043}, \'multiverseid\': 539043}]', '[{\'name\': \'Triskaidekaphile\', \'text\': \'Du hast keine maximale Handkartenzahl.\\nZu Beginn deines Versorgungssegments und falls du genau dreizehn Karten auf deiner Hand hast, gewinnst du die Partie.\\n{3}{U}: Ziehe eine Karte.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538757&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cf9185f9-e037-4ab6-9e30-3e0f1808022a\', \'multiverseId\': 538757}, \'multiverseid\': 538757}, {\'name\': \'Triscaidecáfila\', \'text\': \'Tu mano no tiene tamaño máximo.\\nAl comienzo de tu mantenimiento, si tienes exactamente trece cartas en tu mano, ganas el juego.\\n{3}{U}: Roba una carta.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538817&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'285feeac-e1e5-4439-bff3-05a93d39013d\', \'multiverseId\': 538817}, \'multiverseid\': 538817}, {\'name\': \'Triskaïdékaphile\', \'text\': "Il n\'y a pas de limite au nombre de cartes dans votre main.\\nAu début de votre entretien, si vous avez exactement treize cartes dans votre main, vous gagnez la partie.\\n{3}{U} : Piochez une carte.", \'type\': \'Créature : humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538877&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e34ee71e-ab39-4a2a-9eaa-b4881c05c0b2\', \'multiverseId\': 538877}, \'multiverseid\': 538877}, {\'name\': \'Triscaidecafila\', \'text\': "Non hai un limite massimo di carte nella tua mano.\\nAll\'inizio del tuo mantenimento, se hai esattamente tredici carte nella tua mano, vinci la partita.\\n{3}{U}: Pesca una carta.", \'type\': \'Creatura — Mago Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538937&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'02808e27-0424-4ccd-a215-f5ae63eccb36\', \'multiverseId\': 538937}, \'multiverseid\': 538937}, {\'name\': \'十三嗜好症\', \'text\': \'あなたの手札の上限はなくなる。\\nあなたのアップキープの開始時に、あなたの手札にちょうど13枚のカードがある場合、あなたはこのゲームに勝利する。\\n{3}{U}：カード１枚を引く。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538997&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6e622bb5-5098-4de4-8e1f-3b4473f82c98\', \'multiverseId\': 538997}, \'multiverseid\': 538997}]', '[{\'name\': \'Umgraben\', \'text\': \'Bestimme bis zu drei Karten deiner Wahl in Friedhöfen. Die Besitzer der Karten mischen sie in ihre Bibliotheken. Du erhältst 2 Lebenspunkte dazu.\\nRückblende {1}{G} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten wirken. Schicke sie danach ins Exil.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535312&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d04e4a15-7422-4165-acfb-ea4c66ad9323\', \'multiverseId\': 535312}, \'multiverseid\': 535312}, {\'name\': \'Remover la tierra\', \'text\': \'Elige hasta tres cartas objetivo en los cementerios. Los propietarios de esas cartas las barajan en sus bibliotecas. Ganas 2 vidas.\\nRetrospectiva {1}{G}. (Puedes lanzar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego exíliala.)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535628&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4026cf3d-3766-458e-b52e-ba93641c221a\', \'multiverseId\': 535628}, \'multiverseid\': 535628}, {\'name\': \'Remuer la terre\', \'text\': "Choisissez jusqu\'à trois cartes ciblées dans les cimetières. Les propriétaires de ces cartes les mélangent dans leurs bibliothèques. Vous gagnez 2 points de vie.\\nFlashback {1}{G} (Vous pouvez lancer cette carte depuis votre cimetière pour son coût de flashback. Exilez-la ensuite.)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535944&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cf7a4c7d-1b59-4e9d-9f96-6b0723a9d25b\', \'multiverseId\': 535944}, \'multiverseid\': 535944}, {\'name\': \'Dissodare la Terra\', \'text\': \'Scegli fino a tre carte bersaglio nei cimiteri. I proprietari di quelle carte le rimescolano nei propri grimori. Guadagni 2 punti vita.\\nFlashback {1}{G} (Puoi lanciare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi esiliala.)\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536260&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9889ef91-9f85-4acc-8314-3665e22e25cc\', \'multiverseId\': 536260}, \'multiverseid\': 536260}, {\'name\': \'掘り返し\', \'text\': \'墓地にあるカード最大３枚を対象とする。それらのカードのオーナーはそれを自分のライブラリーに加えて切り直す。あなたは２点のライフを得る。\\nフラッシュバック{1}{G}（あなたはあなたの墓地にあるこのカードをフラッシュバック・コストで唱えてもよい。その後、これを追放する。）\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536576&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'21540971-0341-4564-a885-29a7b2400cf6\', \'multiverseId\': 536576}, \'multiverseid\': 536576}, {\'name\': \'대지 돌려놓기\', \'text\': \'무덤들에 있는 카드를 최대 세 장까지 목표로 정한다. 그 카드들의 소유자는 그 카드들을 자신의 서고에 섞어넣는다. 당신은 생명 2점을 얻는다.\\n회상 {1}{G} (당신은 이 카드의 회상 비용을 지불해 이 카드를 당신의 무덤에서 발동할 수 있다. 그 후 이 카드를 추방한다.)\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536892&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a88d7b64-47eb-4b67-a3bc-c00ff8a11b3b\', \'multiverseId\': 536892}, \'multiverseid\': 536892}, {\'name\': \'Revirar a Terra\', \'text\': \'Escolha até três cards alvo em quaisquer cemitérios. Os donos daqueles cards os embaralham nos próprios grimórios. Você ganha 2 pontos de vida.\\nRecapitular {1}{G} (Você pode conjurar este card de seu cemitério pagando seu custo de recapitular. Depois, exile-o.)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537208&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ff4fe74b-2b5b-4840-ab8f-9eb48de21f30\', \'multiverseId\': 537208}, \'multiverseid\': 537208}, {\'name\': \'Вскопать Землю\', \'text\': \'Выберите не более трех целевых карт на кладбищах. Владельцы тех карт втасовывают их в свои библиотеки. Вы получаете 2 жизни.\\nВоспоминание {1}{G} (Вы можете разыграть эту карту из вашего кладбища за ее стоимость Воспоминания. Затем изгоните ее.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537524&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e2a91d5a-77c4-4fd0-8ae9-d3d7a5653990\', \'multiverseId\': 537524}, \'multiverseid\': 537524}, {\'name\': \'翻松土壤\', \'text\': \'选择至多三张目标在坟墓场中的牌。这些牌的拥有者将其洗入各自的牌库。你获得2点生命。\\n返照{1}{G}（你可以从你坟墓场中施放此牌，并支付其返照费用，然后将它放逐。）\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537840&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1b71f4bc-0a7a-44d5-9155-80ea29a75456\', \'multiverseId\': 537840}, \'multiverseid\': 537840}, {\'name\': \'翻鬆土壤\', \'text\': \'選擇至多三張目標在墳墓場中的牌。這些牌的擁有者將其洗入各自的牌庫。你獲得2點生命。\\n返照{1}{G}（你可以從你墳墓場中施放此牌，並支付其返照費用，然後將它放逐。）\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538156&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5c806e75-7841-4765-be66-803753b96417\', \'multiverseId\': 538156}, \'multiverseid\': 538156}]', '[{\'name\': \'Ungebärdige Meute\', \'text\': \'Immer wenn eine andere Kreatur, die du kontrollierst, stirbt, lege eine +1/+1-Marke auf die Ungebärdige Meute.\', \'type\': \'Kreatur — Mensch\', \'flavor\': \'„Wir haben die Wirren überlebt! Tödliche Engel! Schrecken von jenseits des Mondes! Und jetzt glauben ein paar große Werwölfe, sie könnten uns Angst einjagen? Sie können es ja versuchen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535114&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5effb817-66ad-48ad-93c1-553ccf07f348\', \'multiverseId\': 535114}, \'multiverseid\': 535114}, {\'name\': \'Turba desordenada\', \'text\': \'Siempre que otra criatura que controlas muera, pon un contador +1/+1 sobre la Turba desordenada.\', \'type\': \'Criatura — Humano\', \'flavor\': \'"¡Sobrevivimos a las Penurias, a ángeles asesinos y a horrores de más allá de la luna! ¿Y ahora unos licántropos grandotes creen que nos van a asustar? Que lo intenten".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535430&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f0b78a8c-b89b-4374-9f12-3f99a5e53d27\', \'multiverseId\': 535430}, \'multiverseid\': 535430}, {\'name\': \'Foule indocile\', \'text\': "À chaque fois qu\'une autre créature que vous contrôlez meurt, mettez un marqueur +1/+1 sur la Foule indocile.", \'type\': \'Créature : humain\', \'flavor\': "« Nous avons survécu aux Calamités ! Aux anges tueurs ! Aux horreurs venues de par-delà la lune ! Et quelques loups-garous croient nous effrayer ? Qu\'ils essayent. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535746&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7bba883a-3366-436f-b729-a239ccae44be\', \'multiverseId\': 535746}, \'multiverseid\': 535746}, {\'name\': \'Folla Turbolenta\', \'text\': "Ogniqualvolta un\'altra creatura che controlli muore, metti un segnalino +1/+1 sulla Folla Turbolenta.", \'type\': \'Creatura — Umano\', \'flavor\': \'"Siamo sopravvissuti alle Tribolazioni! Ad angeli assassini! A orrori provenienti da oltre la luna! Ora dei grossi mannari pensano di poterci spaventare? Che ci provino."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536062&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'86dc2101-bfdf-4461-84c8-fea422dbe671\', \'multiverseId\': 536062}, \'multiverseid\': 536062}, {\'name\': \'物騒な群衆\', \'text\': \'あなたがコントロールしていてこれでないクリーチャー１体が死亡するたび、物騒な群衆の上に＋１/＋１カウンター１個を置く。\', \'type\': \'クリーチャー — 人間\', \'flavor\': \'「我々は大患期を生き延びた！殺戮の天使も！月の彼方の怪物も！今度は大きな人狼どもが我々を脅かそうとしてるって？上等だ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536378&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6b4c5297-5745-4958-bcc8-88dbc1a4308b\', \'multiverseId\': 536378}, \'multiverseid\': 536378}, {\'name\': \'통제가 불가능한 폭도\', \'text\': \'당신이 조종하는 다른 생물이 죽을 때마다, 통제가 불가능한 폭도에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 인간\', \'flavor\': \'"우리는 그 고역에서 살아남았어! 살인광 천사에게서도! 달 너머에서 찾아온 괴물한테서도! 이젠 덩치가 좀 큰 늑대인간들이 우리를 겁주려 한다고? 어디 해 보라지."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536694&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'556d93d1-c220-40cf-bc91-fca67db7fdd3\', \'multiverseId\': 536694}, \'multiverseid\': 536694}, {\'name\': \'Turba Incontrolável\', \'text\': \'Toda vez que outra criatura que você controla morrer, coloque um marcador +1/+1 em Turba Incontrolável.\', \'type\': \'Criatura — Humano\', \'flavor\': \'"Sobrevivemos às Tribulações! Anjos assassinos! Horrores de além da lua! E agora vêm uns lobisomens grandalhões achando que assustam? Podem tentar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537010&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a4c70b77-397d-4ea7-a25f-0342dc22bddf\', \'multiverseId\': 537010}, \'multiverseid\': 537010}, {\'name\': \'Неуправляемая Толпа\', \'text\': \'Каждый раз, когда другое существо под вашим контролем умирает, положите один жетон +1/+1 на Неуправляемую Толпу.\', \'type\': \'Существо — Человек\', \'flavor\': \'«Мы пережили Тягости! Ангелов-убийц! Ужасы с той стороны луны! А теперь какие-то вервольфы-переростки думают нас напугать? Ну, пусть попробуют».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537326&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ce26ccae-d2fe-428b-bd65-46ea79526c9c\', \'multiverseId\': 537326}, \'multiverseid\': 537326}, {\'name\': \'粗野群众\', \'text\': \'每当另一个由你操控的生物死去时，在粗野群众上放置一个+1/+1指示物。\', \'type\': \'生物 ～人类\', \'flavor\': \'「我们挺过了癫狂劫！杀人天使！月亮背面的异境惧物！现在有些大狼人觉得他们能吓到我们？但来无妨。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537642&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'63b9a477-6c2a-437a-8406-4c9a2cd0f185\', \'multiverseId\': 537642}, \'multiverseid\': 537642}, {\'name\': \'粗野群眾\', \'text\': \'每當另一個由你操控的生物死去時，在粗野群眾上放置一個+1/+1指示物。\', \'type\': \'生物 ～人類\', \'flavor\': \'「我們挺過了癲狂劫！殺人天使！月亮背面的異境懼物！現在有些大狼人覺得他們能嚇到我們？但來無妨。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537958&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'60607283-9cf9-413d-884b-3f8dfd05a4fc\', \'multiverseId\': 537958}, \'multiverseid\': 537958}]', '[{\'name\': \'Ungeladene Festivalgäste\', \'text\': \'Immer wenn du einen Spontanzauber oder eine Hexerei wirkst, erhalten die Ungeladenen Festivalgäste +2/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Teufel\', \'flavor\': \'So viele Kerzen. So viel Brennbares. So wenig Zeit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535233&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d4f833d7-be4f-4c68-a72d-3f0829e23f43\', \'multiverseId\': 535233}, \'multiverseid\': 535233}, {\'name\': \'Quemafiestas\', \'text\': \'Siempre que lances un hechizo de instantáneo o de conjuro, el Quemafiestas obtiene +2/+0 hasta el final del turno.\', \'type\': \'Criatura — Diablo\', \'flavor\': \'Tantas velas. Tantos inflamables. Tan poco tiempo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535549&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'acda6b72-1c8a-48ca-918e-56db0916672a\', \'multiverseId\': 535549}, \'multiverseid\': 535549}, {\'name\': \'Fracasseur de festival\', \'text\': "À chaque fois que vous lancez un sort d\'éphémère ou de rituel, le Fracasseur de festival gagne +2/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : diable\', \'flavor\': \'Tant de chandelles. Tant de choses qui brûlent. Si peu de temps.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535865&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'793a7da2-8625-4d2a-94e4-06f584797da9\', \'multiverseId\': 535865}, \'multiverseid\': 535865}, {\'name\': \'Guastafestival\', \'text\': \'Ogniqualvolta lanci una magia istantaneo o stregoneria, il Guastafestival prende +2/+0 fino alla fine del turno.\', \'type\': \'Creatura — Diavolo\', \'flavor\': \'Così tante candele. Così tanti materiali infiammabili. Così poco tempo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536181&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a57347c5-e8ee-4080-919c-18de2b6437ee\', \'multiverseId\': 536181}, \'multiverseid\': 536181}, {\'name\': \'祭り壊し\', \'text\': \'あなたがインスタントやソーサリーである呪文を唱えるたび、ターン終了時まで、祭り壊しは＋２/＋０の修整を受ける。\', \'type\': \'クリーチャー — デビル\', \'flavor\': \'蝋燭がいっぱいだ。燃えるものがいっぱいだ。時間がいくらあっても足りないよ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536497&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ea7dc79f-75d4-4077-ad1f-71ddccc5b124\', \'multiverseId\': 536497}, \'multiverseid\': 536497}, {\'name\': \'축제 불청객\', \'text\': \'당신이 순간마법 또는 집중마법 주문을 발동할 때마다, 축제 불청객은 턴종료까지 +2/+0을 받는다.\', \'type\': \'생물 — 악령\', \'flavor\': \'촛불도 엄청 많고, 잘 타는 것도 엄청 많은데, 시간이 너무 적다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536813&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c6b0af3f-fb75-4b5d-ad54-e20c9cba0fdd\', \'multiverseId\': 536813}, \'multiverseid\': 536813}, {\'name\': \'Estraga-festival\', \'text\': \'Toda vez que você conjura uma mágica instantânea ou um feitiço, Estraga-festival recebe +2/+0 até o final do turno.\', \'type\': \'Criatura — Diabo\', \'flavor\': \'Tanta vela. Tanta coisa inflamável. Tão pouco tempo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537129&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0ebc569f-f667-4a43-b276-532706ee5f3b\', \'multiverseId\': 537129}, \'multiverseid\': 537129}, {\'name\': \'Незваный Гость Фестиваля\', \'text\': \'Каждый раз, когда вы разыгрываете мгновенное заклинание или заклинание волшебства, Незваный Гость Фестиваля получает +2/+0 до конца хода.\', \'type\': \'Существо — Дьявол\', \'flavor\': \'Так много свечек. Так много горючих материалов. И так мало времени.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537445&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bfaea290-3902-4fcb-b182-c81a745c96cf\', \'multiverseId\': 537445}, \'multiverseid\': 537445}, {\'name\': \'收成节破坏魔\', \'text\': \'每当你施放瞬间或法术咒语时，收成节破坏魔得+2/+0直到回合结束。\', \'type\': \'生物 ～魔鬼\', \'flavor\': \'蜡烛很多，能烧的很多，时间太少。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537761&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'77749cab-f3e2-4578-bc9c-684ad5988028\', \'multiverseId\': 537761}, \'multiverseid\': 537761}, {\'name\': \'收成節破壞魔\', \'text\': \'每當你施放瞬間或巫術咒語時，收成節破壞魔得+2/+0直到回合結束。\', \'type\': \'生物 ～魔鬼\', \'flavor\': \'蠟燭很多，能燒的很多，時間太少。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538077&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f764fe05-8a8a-4174-a175-d52f2a4d535d\', \'multiverseId\': 538077}, \'multiverseid\': 538077}]', '[{\'name\': \'Unnatürliches Mondlicht\', \'text\': \'Es wird Nacht. Bis zum Ende des Zuges erhält eine Kreatur deiner Wahl +1/+0, verursacht Trampelschaden und hat „Immer wenn diese Kreatur einem Spieler Kampfschaden zufügt, ziehe eine Karte."\\nRückblende {2}{R}{G} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten wirken. Schicke sie danach ins Exil.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535360&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a7f57cdf-ae27-467c-aae4-7eca71ccd640\', \'multiverseId\': 535360}, \'multiverseid\': 535360}, {\'name\': \'Salida de la luna extraña\', \'text\': \'Se hace de noche. Hasta el final del turno, la criatura objetivo obtiene +1/+0 y gana la habilidad de arrollar y "Siempre que esta criatura haga daño de combate a un jugador, roba una carta".\\nRetrospectiva {2}{R}{G}. (Puedes lanzar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego exíliala.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535676&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'de5cc981-afe1-44fb-9622-678ac6697931\', \'multiverseId\': 535676}, \'multiverseid\': 535676}, {\'name\': \'Lever de lune surnaturel\', \'text\': "On passe à la nuit. Jusqu\'à la fin du tour, une créature ciblée gagne +1/+0 et acquiert le piétinement et « À chaque fois que cette créature inflige des blessures de combat à un joueur, piochez une carte. »\\nFlashback {2}{R}{G} (Vous pouvez lancer cette carte depuis votre cimetière pour son coût de flashback. Exilez-la ensuite.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535992&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7f24c011-4ebf-4f84-be17-b6005c11c053\', \'multiverseId\': 535992}, \'multiverseid\': 535992}, {\'name\': \'Chiaro di Luna Innaturale\', \'text\': \'Diventa notte. Fino alla fine del turno, una creatura bersaglio prende +1/+0 e ha travolgere e "Ogniqualvolta questa creatura infligge danno da combattimento a un giocatore, pesca una carta".\\nFlashback {2}{R}{G} (Puoi lanciare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi esiliala.)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536308&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'01f85313-6c09-4674-ae8b-1ca84226bff5\', \'multiverseId\': 536308}, \'multiverseid\': 536308}, {\'name\': \'不自然な月の出\', \'text\': \'夜になる。クリーチャー１体を対象とする。ターン終了時まで、それは＋１/＋０の修整を受けトランプルと「このクリーチャーがプレイヤー１人に戦闘ダメージを与えるたび、カード１枚を引く。」を得る。\\nフラッシュバック{2}{R}{G}（あなたはあなたの墓地にあるこのカードをフラッシュバック・コストで唱えてもよい。その後、これを追放する。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536624&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a7b2687e-86c3-455c-8684-defa38824ed4\', \'multiverseId\': 536624}, \'multiverseid\': 536624}, {\'name\': \'부자연스러운 월출\', \'text\': \'밤이 된다. 생물을 목표로 정한다. 그 생물은 턴종료까지 +1/+0을 받고 돌진 및 "이 생물이 플레이어에게 전투피해를 입힐 때마다, 카드 한 장을 뽑는다."를 얻는다.\\n회상 {2}{R}{G} (당신은 이 카드의 회상 비용을 지불해 이 카드를 당신의 무덤에서 발동할 수 있다. 그 후 이 카드를 추방한다.)\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536940&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'377a1cb8-1392-4e89-b9e7-acf36460dc05\', \'multiverseId\': 536940}, \'multiverseid\': 536940}, {\'name\': \'Nascer da Lua Antinatural\', \'text\': \'Torna-se noite. Até o final do turno, a criatura alvo recebe +1/+0 e ganha atropelar e "Toda vez que esta criatura causar dano de combate a um jogador, compre um card."\\nRecapitular {2}{R}{G} (Você pode conjurar este card de seu cemitério pagando seu custo de recapitular. Depois, exile-o.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537256&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5687e95d-6975-4d49-a0c9-a8f0cbb89dd7\', \'multiverseId\': 537256}, \'multiverseid\': 537256}, {\'name\': \'Неестественный Восход Луны\', \'text\': \'Наступает ночь. До конца хода целевое существо получает +1/+0, Пробивной удар и способность «Каждый раз, когда это существо наносит боевые повреждения игроку, возьмите карту».\\nВоспоминание {2}{R}{G} (Вы можете разыграть эту карту из вашего кладбища за ее стоимость Воспоминания. Затем изгоните ее.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537572&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bc3db3c1-eaf1-44f5-b428-b45f26861019\', \'multiverseId\': 537572}, \'multiverseid\': 537572}, {\'name\': \'异常月升\', \'text\': \'当前成为黑夜。直到回合结束，目标生物得+1/+0且获得践踏与「每当此生物对任一牌手造成战斗伤害时，抓一张牌。」\\n返照{2}{R}{G}（你可以从你坟墓场中施放此牌，并支付其返照费用，然后将它放逐。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537888&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f6a90169-1382-4f07-859a-94e26c18cae2\', \'multiverseId\': 537888}, \'multiverseid\': 537888}, {\'name\': \'異常月升\', \'text\': \'當前成為黑夜。直到回合結束，目標生物得+1/+0且獲得踐踏與「每當此生物對任一玩家造成戰鬥傷害時，抽一張牌。」\\n返照{2}{R}{G}（你可以從你墳墓場中施放此牌，並支付其返照費用，然後將它放逐。）\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538204&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c2d2b672-d1fe-4a6f-a14a-f8b015afd2ac\', \'multiverseId\': 538204}, \'multiverseid\': 538204}]', '[{\'name\': \'Unnatürliches Wachstum\', \'text\': \'Zu Beginn jedes Kampfes verdoppelst du bis zum Ende des Zuges Stärke und Widerstandskraft jeder Kreatur, die du kontrollierst.\', \'type\': \'Verzauberung\', \'flavor\': \'Mit der gestörten Abfolge von Tag und Nacht wurde der verdrehte Einfluss des Mondes nur stärker. Und stärker.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535313&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'59899d71-65b2-4122-865e-8abf26ae9a72\', \'multiverseId\': 535313}, \'multiverseid\': 535313}, {\'name\': \'Crecimiento antinatural\', \'text\': \'Al comienzo de cada combate, duplica la fuerza y la resistencia de cada criatura que controlas hasta el final del turno.\', \'type\': \'Encantamiento\', \'flavor\': \'Con los ciclos del día y la noche alterados, la influencia perversa de la luna no hacía más que crecer y crecer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535629&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a12b1569-c142-4573-836d-08a507b5d82f\', \'multiverseId\': 535629}, \'multiverseid\': 535629}, {\'name\': \'Croissance surnaturelle\', \'text\': "Au début de chaque combat, doublez la force et l\'endurance de chaque créature que vous contrôlez jusqu\'à la fin du tour.", \'type\': \'Enchantement\', \'flavor\': "Avec le dérèglement des cycles de jour et de nuit, l\'influence corrompue de la lune s\'étendait. Encore et encore.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535945&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c87fed7f-25d9-4971-a953-1efd40307f63\', \'multiverseId\': 535945}, \'multiverseid\': 535945}, {\'name\': \'Crescita Innaturale\', \'text\': "All\'inizio di ogni combattimento, raddoppia la forza e la costituzione di ogni creatura che controlli fino alla fine del turno.", \'type\': \'Incantesimo\', \'flavor\': "Con i cicli del giorno e della notte sempre più contorti, l\'influenza perversa della luna non poteva che crescere. E crescere ancora.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536261&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'01da0fab-9456-4d98-a4e4-81d2159b9dc1\', \'multiverseId\': 536261}, \'multiverseid\': 536261}, {\'name\': \'不自然な成長\', \'text\': \'各戦闘の開始時に、ターン終了時まで、あなたがコントロールしているすべてのクリーチャーのパワーとタフネスは２倍になる。\', \'type\': \'エンチャント\', \'flavor\': \'昼と夜の循環が乱された今、月の歪んだゆらめきが増すばかりであった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536577&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'28d80f33-a726-48fb-aafd-d5d481fc0392\', \'multiverseId\': 536577}, \'multiverseid\': 536577}, {\'name\': \'부자연스러운 성장\', \'text\': \'매 턴 전투 시작에, 당신이 조종하는 각 생물의 공격력 및 방어력을 턴종료까지 두 배로 만든다.\', \'type\': \'부여마법\', \'flavor\': \'낮과 밤의 순환이 풀리면서, 달의 뒤틀린 흔들림은 커져만 갔다. 계속해서 커져 갔다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536893&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'223d8455-fa0d-4d98-a281-2a4ae3fdf41c\', \'multiverseId\': 536893}, \'multiverseid\': 536893}, {\'name\': \'Crescimento Antinatural\', \'text\': \'No início de cada combate, dobre o poder e a resistência de cada criatura que você controla até o final do turno.\', \'type\': \'Encantamento\', \'flavor\': \'Com os ciclos do dia e da noite alterados, a influência distorcida da lua só fez crescer. E crescer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537209&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'42f984d8-c472-463a-b14b-6e64606bd186\', \'multiverseId\': 537209}, \'multiverseid\': 537209}, {\'name\': \'Неестественный Рост\', \'text\': \'В начале каждого боя удвойте силу и выносливость каждого существа под вашим контролем до конца хода.\', \'type\': \'Чары\', \'flavor\': \'Смена дня и ночи пошла вразнос, и неестественные лунные циклы лишь усиливались и усиливались. И усиливались.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537525&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3a43242f-1dc6-4efb-8cbb-53040b01bda0\', \'multiverseId\': 537525}, \'multiverseid\': 537525}, {\'name\': \'超凡成长\', \'text\': \'在每次战斗开始时，将每个由你操控之生物的力量和防御力均加倍直到回合结束。\', \'type\': \'结界\', \'flavor\': \'随着昼夜轮回消失，月亮的扭曲影响逐渐加剧。而且愈演愈烈。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537841&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ea467f68-4cec-4a94-9889-fd1714fdbfdf\', \'multiverseId\': 537841}, \'multiverseid\': 537841}, {\'name\': \'超凡成長\', \'text\': \'在每次戰鬥開始時，將每個由你操控之生物的力量和防禦力均加倍直到回合結束。\', \'type\': \'結界\', \'flavor\': \'隨著晝夜輪迴消失，月亮的扭曲影響逐漸加劇。而且愈演愈烈。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538157&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e95d8f8c-bde3-426c-90ff-7165e831c7ce\', \'multiverseId\': 538157}, \'multiverseid\': 538157}]', '[{\'name\': \'Unnatürliches Wachstum\', \'text\': \'Zu Beginn jedes Kampfes verdoppelst du bis zum Ende des Zuges Stärke und Widerstandskraft jeder Kreatur, die du kontrollierst.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538782&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4dc14b48-655a-4a35-a8b9-77850490b1e2\', \'multiverseId\': 538782}, \'multiverseid\': 538782}, {\'name\': \'Crecimiento antinatural\', \'text\': \'Al comienzo de cada combate, duplica la fuerza y la resistencia de cada criatura que controlas hasta el final del turno.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538842&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5d60bc12-9b93-4c46-8746-daa42cd9d159\', \'multiverseId\': 538842}, \'multiverseid\': 538842}, {\'name\': \'Croissance surnaturelle\', \'text\': "Au début de chaque combat, doublez la force et l\'endurance de chaque créature que vous contrôlez jusqu\'à la fin du tour.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538902&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c11d3cd1-4b7b-4e01-bf72-d971ece6ba83\', \'multiverseId\': 538902}, \'multiverseid\': 538902}, {\'name\': \'Crescita Innaturale\', \'text\': "All\'inizio di ogni combattimento, raddoppia la forza e la costituzione di ogni creatura che controlli fino alla fine del turno.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538962&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1cfe49d2-d62e-4840-8eb9-16e2c64f4429\', \'multiverseId\': 538962}, \'multiverseid\': 538962}, {\'name\': \'不自然な成長\', \'text\': \'各戦闘の開始時に、ターン終了時まで、あなたがコントロールしているすべてのクリーチャーのパワーとタフネスは２倍になる。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539022&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2e1b6caf-2fbf-42d5-ba33-02ce0df71abd\', \'multiverseId\': 539022}, \'multiverseid\': 539022}]', '[{\'name\': \'Unterwassergrab-Flickwerk\', \'text\': \'Wenn das Unterwassergrab-Flickwerk ins Spiel kommt, millt ein Spieler deiner Wahl drei Karten. (Er legt die obersten drei Karten seiner Bibliothek auf seinen Friedhof.)\\n{2}{U}: Das Unterwassergrab-Flickwerk kann in diesem Zug nicht geblockt werden.\', \'type\': \'Kreatur — Zombie, Schrecken\', \'flavor\': \'Wenn menschliche Leichen knapp sind, werden Leichenflicker kreativ.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535127&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'88f4a5e6-e1ad-4d16-95e3-0e1bf6a220ab\', \'multiverseId\': 535127}, \'multiverseid\': 535127}, {\'name\': \'Amalgama del cementerio marino\', \'text\': \'Cuando la Amalgama del cementerio marino entre al campo de batalla, el jugador objetivo muele tres cartas. (Pone las tres primeras cartas de su biblioteca en su cementerio.)\\n{2}{U}: La Amalgama del cementerio marino no puede ser bloqueada este turno.\', \'type\': \'Criatura — Horror zombie\', \'flavor\': \'Cuando no quedan suficientes cadáveres humanos, los suturadores apelan a la creatividad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535443&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b3d9ff63-49e5-4f1f-8204-f04bacc83505\', \'multiverseId\': 535443}, \'multiverseid\': 535443}, {\'name\': \'Amalgame du cimetière marin\', \'text\': "Quand l\'Amalgame du cimetière marin arrive sur le champ de bataille, un joueur ciblé meule trois cartes. (Il met les trois cartes du dessus de sa bibliothèque dans son cimetière.)\\n{2}{U} : L\'Amalgame du cimetière marin ne peut pas être bloqué ce tour-ci.", \'type\': \'Créature : zombie et horreur\', \'flavor\': \'Quand ils manquent de corps humains, les raccommodeurs se montrent créatifs.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535759&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e3025b1e-eb66-4c61-a679-9b2a50647508\', \'multiverseId\': 535759}, \'multiverseid\': 535759}, {\'name\': \'Amalgama della Relittopoli\', \'text\': "Quando l\'Amalgama della Relittopoli entra nel campo di battaglia, un giocatore bersaglio macina tre carte. (Mette nel suo cimitero le prime tre carte del suo grimorio.)\\n{2}{U}: L\'Amalgama della Relittopoli non può essere bloccato in questo turno.", \'type\': \'Creatura — Orrore Zombie\', \'flavor\': \'Quando i cadaveri umani scarseggiano, i cucitori diventano creativi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536075&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'22465a9b-9a57-4847-9328-5fabc72159d1\', \'multiverseId\': 536075}, \'multiverseid\': 536075}, {\'name\': \'溺墓の融合体\', \'text\': \'溺墓の融合体が戦場に出たとき、プレイヤー１人を対象とする。そのプレイヤーはカード３枚を切削する。（そのプレイヤーは自分のライブラリーの一番上にあるカード３枚を自分の墓地に置く。）\\n{2}{U}：このターン、溺墓の融合体はブロックされない。\', \'type\': \'クリーチャー — ゾンビ・ホラー\', \'flavor\': \'人間の死体が不足しているとき、縫い師は趣向を凝らす。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536391&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'08131940-c2b7-402c-ab95-e77e9b5594f2\', \'multiverseId\': 536391}, \'multiverseid\': 536391}, {\'name\': \'수장된 묘지의 합성체\', \'text\': \'수장된 묘지의 합성체가 전장에 들어올 때, 플레이어를 목표로 정한다. 그 플레이어는 카드 세 장을 민다. (그 플레이어는 자신의 서고 맨 위 카드 세 장을 자신의 무덤에 넣는다.)\\n{2}{U}: 수장된 묘지의 합성체는 이 턴에 방어될 수 없다.\', \'type\': \'생물 — 좀비 괴수\', \'flavor\': \'인간의 시체 공급이 원활하지 않은 시기에는, 봉합술사들은 창의적이 된다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536707&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e8491ff7-9f2c-4ed7-9411-7bd2b1e1b584\', \'multiverseId\': 536707}, \'multiverseid\': 536707}, {\'name\': \'Amálgama da Costa Náufraga\', \'text\': \'Quando Amálgama da Costa Náufraga entra no campo de batalha, o jogador alvo tritura três cards. (Ele coloca os três cards do topo do próprio grimório no próprio cemitério.)\\n{2}{U}: Amálgama da Costa Náufraga não pode ser bloqueada neste turno.\', \'type\': \'Criatura — Zumbi Horror\', \'flavor\': \'Quando os cadáveres humanos estão em falta, os suturadores usam a criatividade.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537023&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2488effb-6390-4f04-84e1-531b54f7cee5\', \'multiverseId\': 537023}, \'multiverseid\': 537023}, {\'name\': \'Конгломерат с Кладбища Кораблей\', \'text\': \'Когда Конгломерат с Кладбища Кораблей выходит на поле битвы, целевой игрок скручивает три карты. (Он кладет три верхние карты своей библиотеки на свое кладбище.)\\n{2}{U}: Конгломерат с Кладбища Кораблей не может быть заблокирован в этом ходу.\', \'type\': \'Существо — Зомби Ужас\', \'flavor\': \'Когда человеческих трупов не хватает, сшиватели проявляют чудеса смекалки.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537339&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'233a734a-7c83-4763-8a8d-1abae7c7b818\', \'multiverseId\': 537339}, \'multiverseid\': 537339}, {\'name\': \'沉船地拼合怪\', \'text\': \'当沉船地拼合怪进战场时，目标牌手磨三张牌。（他将其牌库顶的三张牌置入其坟墓场。）\\n{2}{U}：沉船地拼合怪本回合不能被阻挡。\', \'type\': \'生物 ～灵俑／惊惧兽\', \'flavor\': \'当缺少人类尸体时，拼接师就会发挥创意。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537655&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'69af50e7-33fe-4c6b-96a0-e45650b1b6f7\', \'multiverseId\': 537655}, \'multiverseid\': 537655}, {\'name\': \'沉船地拼合怪\', \'text\': \'當沉船地拼合怪進戰場時，目標玩家磨三張牌。（他將其牌庫頂的三張牌置入其墳墓場。）\\n{2}{U}：沉船地拼合怪本回合不能被阻擋。\', \'type\': \'生物 ～殭屍／驚懼獸\', \'flavor\': \'當缺少人類屍體時，拼接師就會發揮創意。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537971&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9fdf4dcf-3d1f-48ab-9557-ed71e882ed13\', \'multiverseId\': 537971}, \'multiverseid\': 537971}]', '[{\'name\': \'Vadrik, astraler Erzmagier\', \'text\': \'Falls es weder Tag noch Nacht ist, wird es Tag, sowie Vadrik, astraler Erzmagier, ins Spiel kommt.\\nSpontanzauber und Hexereien, die du wirkst, kosten beim Wirken {X} weniger, wobei X gleich Vadriks Stärke ist.\\nImmer wenn der Tag zur Nacht oder die Nacht zum Tag wird, lege eine +1/+1-Marke auf Vadrik.\', \'type\': \'Legendäre Kreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535361&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bddb8662-8eba-4be4-a1b9-c1d4c8b47d6c\', \'multiverseId\': 535361}, \'multiverseid\': 535361}, {\'name\': \'Vádrik, archimago astral\', \'text\': \'Si no es ni de día ni de noche, se hace de día en cuanto Vádrik, archimago astral entre al campo de batalla.\\nTe cuesta {X} menos lanzar hechizos de instantáneo o de conjuro, donde X es la fuerza de Vádrik.\\nSiempre que se pase del día a la noche o de la noche al día, pon un contador +1/+1 sobre Vádrik.\', \'type\': \'Criatura legendaria — Hechicero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535677&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4c3859ec-4b7d-45d7-8a49-0936ffa088d1\', \'multiverseId\': 535677}, \'multiverseid\': 535677}, {\'name\': \'Vadrik, archimage astral\', \'text\': "Si ce n\'est ni le jour ni la nuit, on passe au jour au moment où Vadrik, archimage astral arrive sur le champ de bataille.\\nLes sorts d\'éphémère et de rituel que vous lancez coûtent {X} de moins à lancer, X étant la force de Vadrik.\\nÀ chaque fois qu\'on passe du jour à la nuit ou de la nuit au jour, mettez un marqueur +1/+1 sur Vadrik.", \'type\': \'Créature légendaire : humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535993&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a7d91464-dd55-4b8b-b767-b2bc977e3978\', \'multiverseId\': 535993}, \'multiverseid\': 535993}, {\'name\': \'Vadrik, Arcimago Astrale\', \'text\': \'Se non è né giorno né notte, diventa giorno mentre Vadrik, Arcimago Astrale entra nel campo di battaglia.\\nLe magie istantaneo e stregoneria che lanci costano {X} in meno per essere lanciate, dove X è la forza di Vadrik.\\nOgniqualvolta il giorno diventa notte o la notte diventa giorno, metti un segnalino +1/+1 su Vadrik.\', \'type\': \'Creatura Leggendaria — Mago Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536309&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'23aa676e-32b4-4e68-b314-91bf2f07c64c\', \'multiverseId\': 536309}, \'multiverseid\': 536309}, {\'name\': \'星の大魔導師、ヴァドリック\', \'text\': \'星の大魔導師、ヴァドリックが戦場に出るに際し、昼でも夜でもないなら、昼になる。\\nあなたがインスタントやソーサリーである呪文を唱えるためのコストは{X}少なくなる。Ｘは星の大魔導師、ヴァドリックのパワーに等しい。\\n昼が夜になるか夜が昼になるたび、星の大魔導師、ヴァドリックの上に＋１/＋１カウンター１個を置く。\', \'type\': \'伝説のクリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536625&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dc11205b-5366-4890-ad69-1101ff54875b\', \'multiverseId\': 536625}, \'multiverseid\': 536625}, {\'name\': \'영계의 대마도사, 바드릭\', \'text\': \'낮도 밤도 아니라면, 영계의 대마도사, 바드릭이 전장에 들어오면서 낮이 된다.\\n당신이 발동하는 순간마법 주문 및 집중마법 주문은 발동하는 데 {X}가 덜 든다. X는 바드릭의 공격력이다.\\n낮이 밤이 되거나 밤이 낮이 될 때마다, 바드릭에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'전설적 생물 — 인간 마법사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536941&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4ccbf90a-a573-468d-8080-80bfad7bde4e\', \'multiverseId\': 536941}, \'multiverseid\': 536941}, {\'name\': \'Vadrik, Arquimago Astral\', \'text\': \'Se não for dia nem noite, torna-se dia conforme Vadrik, Arquimago Astral, entra no campo de batalha.\\nAs mágicas instantâneas e os feitiços que você conjura custam {X} a menos para serem conjuradas, sendo X o poder de Vadrik.\\nToda vez que o dia se tornar noite ou a noite se tornar dia, coloque um marcador +1/+1 em Vadrik.\', \'type\': \'Criatura Lendária — Humano Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537257&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b1e0b5e9-587c-4162-8105-2bb7d48aeb31\', \'multiverseId\': 537257}, \'multiverseid\': 537257}, {\'name\': \'Вадрик, Астральный Архимаг\', \'text\': \'Если не стоит ни день, ни ночь, то при выходе Вадрика, Астрального Архимага на поле битвы наступает день.\\nРазыгрываемые вами мгновенные заклинания и заклинания волшебства стоят на {X} меньше, где X — сила Вадрика.\\nКаждый раз, когда день становится ночью или ночь становится днем, положите один жетон +1/+1 на Вадрика.\', \'type\': \'Легендарное Существо — Человек Чародей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537573&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ea8a7b25-6573-46e8-a0e3-edbec410fe0c\', \'multiverseId\': 537573}, \'multiverseid\': 537573}, {\'name\': \'星相大法师瓦垂格\', \'text\': \'如果当前既非白昼也非黑夜，则于星相大法师瓦垂格进战场时成为白昼。\\n你施放的瞬间与法术咒语减少{X}来施放，X为瓦垂格的力量。\\n每当白昼成为黑夜或黑夜成为白昼时，在瓦垂格上放置一个+1/+1指示物。\', \'type\': \'传奇生物 ～人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537889&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'30ec1503-ee24-4475-9a2b-806006528e7b\', \'multiverseId\': 537889}, \'multiverseid\': 537889}, {\'name\': \'星相大法師瓦垂格\', \'text\': \'如果當前既非白晝也非黑夜，則於星相大法師瓦垂格進戰場時成為白晝。\\n你施放的瞬間與巫術咒語減少{X}來施放，X為瓦垂格的力量。\\n每當白晝成為黑夜或黑夜成為白晝時，在瓦垂格上放置一個+1/+1指示物。\', \'type\': \'傳奇生物 ～人類／魔法師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538205&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0a124cc6-df45-49b0-85a3-abd38f56b3bf\', \'multiverseId\': 538205}, \'multiverseid\': 538205}]', '[{\'name\': \'Vadrik, astraler Erzmagier\', \'text\': \'Falls es weder Tag noch Nacht ist, wird es Tag, sowie Vadrik, astraler Erzmagier, ins Spiel kommt.\\nSpontanzauber und Hexereien, die du wirkst, kosten beim Wirken {X} weniger, wobei X gleich Vadriks Stärke ist.\\nImmer wenn der Tag zur Nacht oder die Nacht zum Tag wird, lege eine +1/+1-Marke auf Vadrik.\', \'type\': \'Legendäre Kreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538524&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'70c5abf9-4b9d-43c1-b21c-8d5ca89ee5a5\', \'multiverseId\': 538524}, \'multiverseid\': 538524}, {\'name\': \'Vádrik, archimago astral\', \'text\': \'Si no es ni de día ni de noche, se hace de día en cuanto Vádrik, archimago astral entre al campo de batalla.\\nTe cuesta {X} menos lanzar hechizos de instantáneo o de conjuro, donde X es la fuerza de Vádrik.\\nSiempre que se pase del día a la noche o de la noche al día, pon un contador +1/+1 sobre Vádrik.\', \'type\': \'Criatura legendaria — Hechicero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538541&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7482aca0-c722-4396-96e4-60826761e4e1\', \'multiverseId\': 538541}, \'multiverseid\': 538541}, {\'name\': \'Vadrik, archimage astral\', \'text\': "Si ce n\'est ni le jour ni la nuit, on passe au jour au moment où Vadrik, archimage astral arrive sur le champ de bataille.\\nLes sorts d\'éphémère et de rituel que vous lancez coûtent {X} de moins à lancer, X étant la force de Vadrik.\\nÀ chaque fois qu\'on passe du jour à la nuit ou de la nuit au jour, mettez un marqueur +1/+1 sur Vadrik.", \'type\': \'Créature légendaire : humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538558&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9dd06c64-7bf7-4888-98df-029b074f8cb3\', \'multiverseId\': 538558}, \'multiverseid\': 538558}, {\'name\': \'Vadrik, Arcimago Astrale\', \'text\': \'Se non è né giorno né notte, diventa giorno mentre Vadrik, Arcimago Astrale entra nel campo di battaglia.\\nLe magie istantaneo e stregoneria che lanci costano {X} in meno per essere lanciate, dove X è la forza di Vadrik.\\nOgniqualvolta il giorno diventa notte o la notte diventa giorno, metti un segnalino +1/+1 su Vadrik.\', \'type\': \'Creatura Leggendaria — Mago Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538575&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'975a4550-a8c9-4a20-a09a-7ee5429acc99\', \'multiverseId\': 538575}, \'multiverseid\': 538575}, {\'name\': \'星の大魔導師、ヴァドリック\', \'text\': \'星の大魔導師、ヴァドリックが戦場に出るに際し、昼でも夜でもないなら、昼になる。\\nあなたがインスタントやソーサリーである呪文を唱えるためのコストは{X}少なくなる。Ｘは星の大魔導師、ヴァドリックのパワーに等しい。\\n昼が夜になるか夜が昼になるたび、星の大魔導師、ヴァドリックの上に＋１/＋１カウンター１個を置く。\', \'type\': \'伝説のクリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538592&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'77bb38a3-7496-402e-a294-7c8f86f3c1c5\', \'multiverseId\': 538592}, \'multiverseid\': 538592}, {\'name\': \'영계의 대마도사, 바드릭\', \'text\': \'낮도 밤도 아니라면, 영계의 대마도사, 바드릭이 전장에 들어오면서 낮이 된다.\\n당신이 발동하는 순간마법 주문 및 집중마법 주문은 발동하는 데 {X}가 덜 든다. X는 바드릭의 공격력이다.\\n낮이 밤이 되거나 밤이 낮이 될 때마다, 바드릭에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'전설적 생물 — 인간 마법사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538609&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'042693f8-5e99-44d4-8a22-a675a5e6ec58\', \'multiverseId\': 538609}, \'multiverseid\': 538609}, {\'name\': \'Vadrik, Arquimago Astral\', \'text\': \'Se não for dia nem noite, torna-se dia conforme Vadrik, Arquimago Astral, entra no campo de batalha.\\nAs mágicas instantâneas e os feitiços que você conjura custam {X} a menos para serem conjuradas, sendo X o poder de Vadrik.\\nToda vez que o dia se tornar noite ou a noite se tornar dia, coloque um marcador +1/+1 em Vadrik.\', \'type\': \'Criatura Lendária — Humano Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538626&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6b55bb8d-4eeb-469b-8fcf-a60ada9b247e\', \'multiverseId\': 538626}, \'multiverseid\': 538626}, {\'name\': \'Вадрик, Астральный Архимаг\', \'text\': \'Если не стоит ни день, ни ночь, то при выходе Вадрика, Астрального Архимага на поле битвы наступает день.\\nРазыгрываемые вами мгновенные заклинания и заклинания волшебства стоят на {X} меньше, где X — сила Вадрика.\\nКаждый раз, когда день становится ночью или ночь становится днем, положите один жетон +1/+1 на Вадрика.\', \'type\': \'Легендарное Существо — Человек Чародей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538643&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6a589f81-3069-4398-9c7c-330484ebdd53\', \'multiverseId\': 538643}, \'multiverseid\': 538643}, {\'name\': \'星相大法师瓦垂格\', \'text\': \'如果当前既非白昼也非黑夜，则于星相大法师瓦垂格进战场时成为白昼。\\n你施放的瞬间与法术咒语减少{X}来施放，X为瓦垂格的力量。\\n每当白昼成为黑夜或黑夜成为白昼时，在瓦垂格上放置一个+1/+1指示物。\', \'type\': \'传奇生物 ～人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538660&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3ad38333-1022-48b8-b211-eaced1eee6e3\', \'multiverseId\': 538660}, \'multiverseid\': 538660}, {\'name\': \'星相大法師瓦垂格\', \'text\': \'如果當前既非白晝也非黑夜，則於星相大法師瓦垂格進戰場時成為白晝。\\n你施放的瞬間與巫術咒語減少{X}來施放，X為瓦垂格的力量。\\n每當白晝成為黑夜或黑夜成為白晝時，在瓦垂格上放置一個+1/+1指示物。\', \'type\': \'傳奇生物 ～人類／魔法師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538677&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ef58038b-efae-4f70-acaa-f5c01536c3ad\', \'multiverseId\': 538677}, \'multiverseid\': 538677}]', '[{\'name\': \'Vampirischer Eindringling\', \'text\': \'Fliegend\\nDer Vampirische Eindringling kann nicht blocken.\', \'type\': \'Kreatur — Vampir, Späher\', \'flavor\': \'Die Voldaren haben angefangen, Blutopfer von den Dorfbewohnern in ihrem Gebiet zu verlangen. Ihre Agenten kommen vom Himmel, um die zeremoniellen Schalen in schauriger Stille einzusammeln.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535216&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'871a88ed-ce71-43d0-ab2a-d6f910edb1e6\', \'multiverseId\': 535216}, \'multiverseid\': 535216}, {\'name\': \'Vampiro entrometido\', \'text\': \'Vuela.\\nEl Vampiro entrometido no puede bloquear.\', \'type\': \'Criatura — Explorador vampiro\', \'flavor\': \'Los Voldaren comienzan a reclamar ofrendas de sangre a los aldeanos de su territorio. Sus agentes llegan del cielo para recolectar los boles ceremoniales con un silencio espeluznante.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535532&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c29d05a4-e3e4-4e38-a983-43ef23b66cba\', \'multiverseId\': 535532}, \'multiverseid\': 535532}, {\'name\': \'Intrus vampire\', \'text\': "Vol\\nL\'Intrus vampire ne peut pas bloquer.", \'type\': \'Créature : vampire et éclaireur\', \'flavor\': \'Les Voldaren ont commencé à exiger des villageois sur leur territoire des offrandes de sang. Leurs agents arrivent du ciel pour collecter les bols cérémoniaux dans un silence angoissé.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535848&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'80708009-3e05-4349-976b-e5717a174c02\', \'multiverseId\': 535848}, \'multiverseid\': 535848}, {\'name\': \'Vampiro Intruso\', \'text\': \'Volare\\nIl Vampiro Intruso non può bloccare.\', \'type\': \'Creatura — Esploratore Vampiro\', \'flavor\': \'I Voldaren hanno iniziato a esigere offerte di sangue dagli abitanti del loro territorio. I loro agenti arrivano dal cielo per raccogliere bacili cerimoniali in un silenzio inquietante.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536164&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'547e5d31-0646-4207-9ecb-79b11f3e465e\', \'multiverseId\': 536164}, \'multiverseid\': 536164}, {\'name\': \'吸血鬼の侵入者\', \'text\': \'飛行\\n吸血鬼の侵入者ではブロックできない。\', \'type\': \'クリーチャー — 吸血鬼・スカウト\', \'flavor\': \'ヴォルダーレンが自分の縄張りにいる村人の献血を求めるようになった。不気味な沈黙の中、彼らの手先が空からやってきては、儀式用の器を回収する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536480&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d0d2aacc-273a-45a7-bbf0-c69fdd5b5fa1\', \'multiverseId\': 536480}, \'multiverseid\': 536480}, {\'name\': \'흡혈귀 난입자\', \'text\': \'비행\\n흡혈귀 난입자는 방어할 수 없다.\', \'type\': \'생물 — 흡혈귀 정찰병\', \'flavor\': \'볼다렌 가문은 자신들의 영토에 있는 마을 사람들에게서 피를 공물로 바치라고 요구하기 시작했다. 가문의 대리인들은 섬뜩한 침묵과 함께 하늘로부터 내려와 의식을 거행하는 그릇을 수거해 간다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536796&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0834e2cb-e863-410d-bf80-936e9ff39161\', \'multiverseId\': 536796}, \'multiverseid\': 536796}, {\'name\': \'Vampiro Intruso\', \'text\': \'Voar\\nVampiro Intruso não pode bloquear.\', \'type\': \'Criatura — Vampiro Batedor\', \'flavor\': \'Os Voldaren começaram a exigir oferendas de sangue do povo dos vilarejos em seu território. Os agentes deles chegam do céu para coletar as bacias cerimoniais num silêncio insólito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537112&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cb5b5ae2-7807-4734-a2d1-bc53af0863cc\', \'multiverseId\': 537112}, \'multiverseid\': 537112}, {\'name\': \'Вампир-Нарушитель\', \'text\': \'Полет\\nВампир-Нарушитель не может блокировать.\', \'type\': \'Существо — Вампир Разведчик\', \'flavor\': \'Волдарены начали требовать кровавых подношений от селян, проживающих на их территории. Их посланники спускаются с небес, чтобы в жуткой тишине собрать церемониальные чаши.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537428&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e762555e-5ff7-49c6-8943-00d78a911769\', \'multiverseId\': 537428}, \'multiverseid\': 537428}, {\'name\': \'迳闯吸血鬼\', \'text\': \'飞行\\n迳闯吸血鬼不能进行阻挡。\', \'type\': \'生物 ～吸血鬼／斥候\', \'flavor\': \'沃达连血脉开始要求辖内村民供奉鲜血。其代表悄然从天而降，将各地祭祀钵收归囊中。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537744&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ec1e524c-e0a3-4f33-a096-795bedf2005a\', \'multiverseId\': 537744}, \'multiverseid\': 537744}, {\'name\': \'逕闖吸血鬼\', \'text\': \'飛行\\n逕闖吸血鬼不能進行阻擋。\', \'type\': \'生物 ～吸血鬼／斥候\', \'flavor\': \'沃達連血脈開始要求轄內村民供奉鮮血。其代表悄然從天而降，將各地祭祀缽收歸囊中。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538060&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'61c08dd4-1320-4e8b-9f05-cf0faacc010a\', \'multiverseId\': 538060}, \'multiverseid\': 538060}]', "[{'name': 'Verbrennen der Verfluchten', 'text': 'Das Verbrennen der Verfluchten fügt einer Kreatur deiner Wahl 5 Schadenspunkte und dem Beherrscher der Kreatur 2 Schadenspunkte zu. Falls die Kreatur in diesem Zug sterben würde, schicke sie stattdessen ins Exil.', 'type': 'Spontanzauber', 'flavor': 'Zurück blieb nur etwas Asche im Wind und der Geruch von versengtem Haar.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535224&type=card', 'language': 'German', 'identifiers': {'scryfallId': '8690b09b-0bf3-4823-92bb-7a0607b9aada', 'multiverseId': 535224}, 'multiverseid': 535224}, {'name': 'Quemar a los malditos', 'text': 'Quemar a los malditos hace 5 puntos de daño a la criatura objetivo y 2 puntos de daño al controlador de esa criatura. Si esa criatura fuera a morir este turno, en vez de eso, exíliala.', 'type': 'Instantáneo', 'flavor': 'Solo quedaron algunas brasas flotando y el olor a pelo quemado.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535540&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '24c5ad70-bc01-4853-81f0-eb4a18f24bf9', 'multiverseId': 535540}, 'multiverseid': 535540}, {'name': 'Immolez les maudits !', 'text': 'Immolez les maudits inflige 5 blessures à une créature ciblée et 2 blessures au contrôleur de cette créature. Si cette créature devait mourir ce tour-ci, exilez-la à la place.', 'type': 'Éphémère', 'flavor': 'Excepté quelques braises voletant et une odeur de poil brûlé, il ne restait rien.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535856&type=card', 'language': 'French', 'identifiers': {'scryfallId': '186011e8-5808-4d26-a78d-effeb6305897', 'multiverseId': 535856}, 'multiverseid': 535856}, {'name': 'Bruciare i Maledetti', 'text': 'Bruciare i Maledetti infligge 5 danni a una creatura bersaglio e 2 danni al controllore di quella creatura. Se quella creatura sta per morire in questo turno, invece esiliala.', 'type': 'Istantaneo', 'flavor': 'Non rimasero che braci e puzza di peli bruciati.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536172&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'f33c2f1a-2b6e-43eb-91f5-5bcee357c238', 'multiverseId': 536172}, 'multiverseid': 536172}, {'name': '忌み者の火刑', 'text': 'クリーチャー１体を対象とする。忌み者の火刑はそれに５点、そのクリーチャーのコントローラーに２点のダメージを与える。このターン、そのクリーチャーが死亡するなら、代わりにそれを追放する。', 'type': 'インスタント', 'flavor': '漂う燃えさしとくすぶる毛髪の匂いだけが残った。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536488&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '8cf06537-8761-4c98-bf5a-a56e5074a0f4', 'multiverseId': 536488}, 'multiverseid': 536488}, {'name': '저주받은 자 불태우기', 'text': '생물을 목표로 정한다. 저주받은 자 불태우기는 그 생물에게 피해 5점을 입히고 그 생물의 조종자에게 피해 2점을 입힌다. 그 생물이 이 턴에 죽게 된다면, 대신 추방한다.', 'type': '순간마법', 'flavor': '흩날리는 불씨 몇 개와 머리카락 타는 냄새만이 남았다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536804&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '51d52521-db8c-43e0-98aa-a1da7e8aa065', 'multiverseId': 536804}, 'multiverseid': 536804}, {'name': 'Queimar os Amaldiçoados', 'text': 'Queimar os Amaldiçoados causa 5 pontos de dano à criatura alvo e 2 pontos de dano ao controlador daquela criatura. Se aquela criatura for morrer neste turno, em vez disso, exile-a.', 'type': 'Mágica Instantânea', 'flavor': 'Só sobraram umas brasas no ar e o cheiro de cabelo queimado.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537120&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '357b0f8e-f8ba-456e-81df-7c4ccd032d2b', 'multiverseId': 537120}, 'multiverseid': 537120}, {'name': 'Сжечь Проклятых', 'text': 'Сжечь Проклятых наносит 5 повреждений целевому существу и 2 повреждения игроку, контролирующему то существо. Если то существо должно умереть в этом ходу, изгоните его вместо этого.', 'type': 'Мгновенное заклинание', 'flavor': 'Ничего не осталось, кроме пары угольков в воздухе да запаха паленой шерсти.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537436&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'b379de3c-f765-4afa-bbd4-5ba46dc25a52', 'multiverseId': 537436}, 'multiverseid': 537436}, {'name': '焚净遭诅者', 'text': '焚净遭诅者对目标生物造成5点伤害，且对该生物的操控者造成2点伤害。如果本回合中该生物将死去，则改为将它放逐。', 'type': '瞬间', 'flavor': '火光之后，唯有几缕余火和毛发烧焦气味尚存。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537752&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'e9281abd-1501-4175-8b5f-e1ed1dc0a68d', 'multiverseId': 537752}, 'multiverseid': 537752}, {'name': '焚淨遭詛者', 'text': '焚淨遭詛者對目標生物造成5點傷害，且對該生物的操控者造成2點傷害。如果本回合中該生物將死去，則改為將它放逐。', 'type': '瞬間', 'flavor': '火光之後，唯有幾縷餘火和毛髮燒焦氣味尚存。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538068&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'c89981e6-e3aa-4fa1-ba78-0f6797570865', 'multiverseId': 538068}, 'multiverseid': 538068}]", '[{\'name\': \'Verfaulte Vereinigung\', \'text\': \'Schicke bis zu eine Karte deiner Wahl aus einem Friedhof ins Exil. Erzeuge einen 2/2 schwarzen Zombie-Kreaturenspielstein mit Verwesung. (Er kann nicht blocken. Wenn er angreift, opfere ihn am Ende des Kampfes.)\\nRückblende {1}{B} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten wirken. Schicke sie danach ins Exil.)\', \'type\': \'Spontanzauber\', \'flavor\': \'Onkel und Tante Graufeld hatten gerne Gäste zum Abendessen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535209&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ce6d7214-b243-48ac-83da-fd56fd589e8b\', \'multiverseId\': 535209}, \'multiverseid\': 535209}, {\'name\': \'Reunión podrida\', \'text\': \'Exilia hasta una carta objetivo de un cementerio. Crea una ficha de criatura Zombie negra 2/2 con la habilidad de descomposición. (No puede bloquear. Cuando ataque, sacrifícala al final del combate.)\\nRetrospectiva {1}{B}. (Puedes lanzar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego exíliala.)\', \'type\': \'Instantáneo\', \'flavor\': \'A los tíos Greyfeld les encantaba tener invitados para cenar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535525&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1fa0c2fb-8d52-4d9f-b302-684077b26e84\', \'multiverseId\': 535525}, \'multiverseid\': 535525}, {\'name\': \'Retrouvailles pourries\', \'text\': "Exilez jusqu\'à une carte ciblée depuis un cimetière. Créez un jeton de créature 2/2 noire Zombie avec la décomposition. (Il ne peut pas bloquer. Quand il attaque, sacrifiez-le à la fin du combat.)\\nFlashback {1}{B} (Vous pouvez lancer cette carte depuis votre cimetière pour son coût de flashback. Exilez-la ensuite.)", \'type\': \'Éphémère\', \'flavor\': \'Tantine et tonton Grifeld adoraient inviter des gens à dîner.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535841&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c32ddb35-9e62-40ba-a8b1-eec0dcc6b1f9\', \'multiverseId\': 535841}, \'multiverseid\': 535841}, {\'name\': \'Ricongiungimento Putrido\', \'text\': \'Esilia fino a una carta bersaglio da un cimitero. Crea una pedina creatura Zombie 2/2 nera con decomposto. (Non può bloccare. Quando attacca, sacrificala alla fine del combattimento.)\\nFlashback {1}{B} (Puoi lanciare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi esiliala.)\', \'type\': \'Istantaneo\', \'flavor\': \'Zio e zia Greyfeld amavano avere ospiti a cena.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536157&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c8c8cefd-fd2d-4f53-84c3-6cd7304e2b56\', \'multiverseId\': 536157}, \'multiverseid\': 536157}, {\'name\': \'腐敗した再会\', \'text\': \'墓地にあるカード最大１枚を対象とする。それを追放する。腐乱を持つ黒の２/２のゾンビ・クリーチャー・トークン１体を生成する。（それではブロックできない。それが攻撃したとき、戦闘終了時に、それを生け贄に捧げる。）\\nフラッシュバック{1}{B}（あなたはあなたの墓地にあるこのカードをフラッシュバック・コストで唱えてもよい。その後、これを追放する。）\', \'type\': \'インスタント\', \'flavor\': \'グレイフェルド夫妻は夕食のお客が大好きだった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536473&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6784f09d-1232-49f1-9739-cbd4831afb29\', \'multiverseId\': 536473}, \'multiverseid\': 536473}, {\'name\': \'썩어 문드러진 재결합\', \'text\': \'무덤에 있는 카드를 최대 한 개까지 목표로 정한다. 그 카드를 추방한다. 부패를 가진 2/2 흑색 좀비 생물 토큰 한 개를 만든다. (그 생물은 방어할 수 없다. 그 생물이 공격할 때, 전투종료에 그 생물을 희생한다.)\\n회상 {1}{B} (당신은 이 카드의 회상 비용을 지불해 이 카드를 당신의 무덤에서 발동할 수 있다. 그 후 이 카드를 추방한다.)\', \'type\': \'순간마법\', \'flavor\': \'그레이펠드 외숙모 부부는 저녁식사에 손님이 찾아오는 것을 좋아했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536789&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'991050f5-cb38-4bad-b39c-8592de8745e0\', \'multiverseId\': 536789}, \'multiverseid\': 536789}, {\'name\': \'Reunião Apodrecida\', \'text\': \'Exile até um card alvo de um cemitério. Crie uma ficha de criatura Zumbi preta 2/2 com decomposto. (Ela não pode bloquear. Quando ela atacar, sacrifique-a no final do combate.)\\nRecapitular {1}{B} (Você pode conjurar este card de seu cemitério pagando seu custo de recapitular. Depois, exile-o.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'A tia e o tio Grisfeld adoravam ter convidados para o jantar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537105&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'03d91628-ea48-490f-aa5f-9ae736b93464\', \'multiverseId\': 537105}, \'multiverseid\': 537105}, {\'name\': \'Гнилостное Воссоединение\', \'text\': \'Изгоните не более одной целевой карты из кладбища. Создайте одну фишку существа 2/2 черный Зомби с Трупной гнилью. (Она не может блокировать. Когда она атакует, пожертвуйте ее в конце боя.)\\nВоспоминание {1}{B} (Вы можете разыграть эту карту из вашего кладбища за ее стоимость Воспоминания. Затем изгоните ее.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Тетушка и дядюшка Грейфельды любили, когда на ужин были гости.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537421&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8300452a-827b-49c0-a47b-09a7e0bd4de4\', \'multiverseId\': 537421}, \'multiverseid\': 537421}, {\'name\': \'腐身重逢\', \'text\': \'将至多一张目标牌从坟墓场放逐。派出一个2/2黑色，具败朽异能的灵俑衍生生物。（它不能进行阻挡。当它攻击，在战斗结束时将它牺牲。）\\n返照{1}{B}（你可以从你坟墓场中施放此牌，并支付其返照费用，然后将它放逐。）\', \'type\': \'瞬间\', \'flavor\': \'格雷非舅舅夫妇喜欢晚餐宴客。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537737&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'16e7ca89-9421-40f9-b1ce-6becbdac82f1\', \'multiverseId\': 537737}, \'multiverseid\': 537737}, {\'name\': \'腐身重逢\', \'text\': \'將至多一張目標牌從墳墓場放逐。派出一個2/2黑色，具敗朽異能的殭屍衍生生物。（它不能進行阻擋。當它攻擊，在戰鬥結束時將它犧牲。）\\n返照{1}{B}（你可以從你墳墓場中施放此牌，並支付其返照費用，然後將它放逐。）\', \'type\': \'瞬間\', \'flavor\': \'格雷非舅舅夫婦喜歡晚餐宴客。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538053&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3305b332-74d3-4537-85c9-92968d62ddfb\', \'multiverseId\': 538053}, \'multiverseid\': 538053}]', "[{'name': 'Verlassener Strand', 'text': 'Der Verlassene Strand kommt getappt ins Spiel, es sei denn, du kontrollierst zwei oder mehr andere Länder.\\n{T}: Erzeuge {W} oder {U}.', 'type': 'Land', 'flavor': 'Fluten im Unterwassergrab und unnatürlicher Frost haben den einst friedlichen Holzsteg tückisch morsch werden lassen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535374&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a9f27843-5e42-42f3-90c8-c4272b243d7f', 'multiverseId': 535374}, 'multiverseid': 535374}, {'name': 'Playa desierta', 'text': 'La Playa desierta entra al campo de batalla girada a menos que controles otras dos o más tierras.\\n{T}: Agrega {W} o {U}.', 'type': 'Tierra', 'flavor': 'Las inundaciones y heladas contranaturales del cementerio marino transformaron en un peligro traicionero a la tranquila pasarela de antaño.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535690&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '95e304cd-2261-4c85-9eee-02594f68e2f4', 'multiverseId': 535690}, 'multiverseid': 535690}, {'name': 'Plage désertée', 'text': 'La Plage désertée arrive sur le champ de bataille engagée à moins que vous ne contrôliez au moins deux autres terrains.\\n{T} : Ajoutez {W} ou {U}.', 'type': 'Terrain', 'flavor': 'Les inondations du cimetière marin et le gel surnaturel avaient fait de la promenade jadis si paisible un endroit traître et dangereux.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536006&type=card', 'language': 'French', 'identifiers': {'scryfallId': '46c0370e-a86e-47c5-ace8-55411ef95e09', 'multiverseId': 536006}, 'multiverseid': 536006}, {'name': 'Spiaggia Deserta', 'text': 'La Spiaggia Deserta entra nel campo di battaglia TAPpata a meno che tu non controlli altre due o più terre.\\n{T}: Aggiungi {W} o {U}.', 'type': 'Terra', 'flavor': 'Gli allagamenti della Relittopoli e il gelo innaturale avevano reso il pontile, un tempo pacifico, sorprendentemente pericoloso.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536322&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '53c102ab-fc27-4da0-9fe5-64c0ae70fea4', 'multiverseId': 536322}, 'multiverseid': 536322}, {'name': 'さびれた浜', 'text': 'あなたがこれでない２つ以上の土地をコントロールしていないかぎり、さびれた浜はタップ状態で戦場に出る。\\n{T}：{W}か{U}を加える。', 'type': '土地', 'flavor': '溺墓の洪水や不自然な霜によって、一時は平和的だった遊歩道が今は予想外で危険な場所に成り果てた。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536638&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ebee0620-f5ea-498b-82a4-d92a1dfffd17', 'multiverseId': 536638}, 'multiverseid': 536638}, {'name': '버려진 해변', 'text': '버려진 해변은 당신이 다른 대지를 두 개 이상 조종하지 않는 한 탭된 채로 전장에 들어온다.\\n{T}: {W} 또는 {U}를 추가한다.', 'type': '대지', 'flavor': '수장된 묘지에서 발생하는 홍수와 자연스럽지 못한 서리가 한때는 평화로웠던 판잣길을 눈에 보이는 것과는 달리 위험하게 만들었다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536954&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'f1106024-094a-4cdb-9268-fd2eb100425b', 'multiverseId': 536954}, 'multiverseid': 536954}, {'name': 'Praia Deserta', 'text': 'Praia Deserta entra no campo de batalha virada, a menos que você controle dois ou mais outros terrenos.\\n{T}: Adicione {W} ou {U}.', 'type': 'Terreno', 'flavor': 'As inundações e o congelamento antinatural na Costa Náufraga tornaram traiçoeiros caminhos outrora pacíficos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537270&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '959c6795-f2f5-4670-9282-1f41f4bb1075', 'multiverseId': 537270}, 'multiverseid': 537270}, {'name': 'Пустынный Пляж', 'text': 'Пустынный Пляж выходит на поле битвы повернутым, если под вашим контролем менее двух других земель.\\n{T}: добавьте {W} или {U}.', 'type': 'Земля', 'flavor': 'Затопленные кладбища и неестественные морозы сделали этот некогда безмятежный пляжный променад обманчиво вероломным.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537586&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '1b94dbfd-d0e0-4d78-897d-263233be9937', 'multiverseId': 537586}, 'multiverseid': 537586}, {'name': '荒废沙滩', 'text': '除非你操控两个或更多其他地，否则荒废沙滩须横置进战场。\\n{T}：加{W}或{U}。', 'type': '地', 'flavor': '沉船地的洪流和诡异冰霜，让这原本平稳的木板路径也变得颇为凶险。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537902&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'd2132aca-3271-44be-b7c0-5738f4ca62e5', 'multiverseId': 537902}, 'multiverseid': 537902}, {'name': '荒廢沙灘', 'text': '除非你操控兩個或更多其他地，否則荒廢沙灘須橫置進戰場。\\n{T}：加{W}或{U}。', 'type': '地', 'flavor': '沉船地的洪流和詭異冰霜，讓這原本平穩的木板路徑也變得頗為凶險。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538218&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '1e478cf6-a491-47b4-9576-0ab35f610b0b', 'multiverseId': 538218}, 'multiverseid': 538218}]", "[{'name': 'Verlassener Strand', 'text': 'Der Verlassene Strand kommt getappt ins Spiel, es sei denn, du kontrollierst zwei oder mehr andere Länder.\\n{T}: Erzeuge {W} oder {U}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538441&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd6712787-aef7-43a7-ba13-8e771698938b', 'multiverseId': 538441}, 'multiverseid': 538441}, {'name': 'Playa desierta', 'text': 'La Playa desierta entra al campo de batalla girada a menos que controles otras dos o más tierras.\\n{T}: Agrega {W} o {U}.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538446&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '7d115b4f-a0f9-4fd5-bfd7-ffae6bd0c302', 'multiverseId': 538446}, 'multiverseid': 538446}, {'name': 'Plage désertée', 'text': 'La Plage désertée arrive sur le champ de bataille engagée à moins que vous ne contrôliez au moins deux autres terrains.\\n{T} : Ajoutez {W} ou {U}.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538451&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'fa203cf4-f157-41cb-816c-f3d97d03405b', 'multiverseId': 538451}, 'multiverseid': 538451}, {'name': 'Spiaggia Deserta', 'text': 'La Spiaggia Deserta entra nel campo di battaglia TAPpata a meno che tu non controlli altre due o più terre.\\n{T}: Aggiungi {W} o {U}.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538456&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'd2595edd-9519-441e-833d-76ba943200d8', 'multiverseId': 538456}, 'multiverseid': 538456}, {'name': 'さびれた浜', 'text': 'あなたがこれでない２つ以上の土地をコントロールしていないかぎり、さびれた浜はタップ状態で戦場に出る。\\n{T}：{W}か{U}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538461&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '1af20135-df0c-4ff0-a4e1-4db82b90e3db', 'multiverseId': 538461}, 'multiverseid': 538461}, {'name': '버려진 해변', 'text': '버려진 해변은 당신이 다른 대지를 두 개 이상 조종하지 않는 한 탭된 채로 전장에 들어온다.\\n{T}: {W} 또는 {U}를 추가한다.', 'type': '대지', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538466&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'e5a77d55-2be3-4045-a6c2-c85ce19a8e55', 'multiverseId': 538466}, 'multiverseid': 538466}, {'name': 'Praia Deserta', 'text': 'Praia Deserta entra no campo de batalha virada, a menos que você controle dois ou mais outros terrenos.\\n{T}: Adicione {W} ou {U}.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538471&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c89f5b23-8528-4d74-b879-a0d675a0d0b7', 'multiverseId': 538471}, 'multiverseid': 538471}, {'name': 'Пустынный Пляж', 'text': 'Пустынный Пляж выходит на поле битвы повернутым, если под вашим контролем менее двух других земель.\\n{T}: добавьте {W} или {U}.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538476&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '5b408065-df2f-491c-89e0-405b159ef367', 'multiverseId': 538476}, 'multiverseid': 538476}, {'name': '荒废沙滩', 'text': '除非你操控两个或更多其他地，否则荒废沙滩须横置进战场。\\n{T}：加{W}或{U}。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538481&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '67b6b987-989e-48bf-8a32-3fdbc1c3cb0e', 'multiverseId': 538481}, 'multiverseid': 538481}, {'name': '荒廢沙灘', 'text': '除非你操控兩個或更多其他地，否則荒廢沙灘須橫置進戰場。\\n{T}：加{W}或{U}。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538486&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '46152e07-4910-4004-a245-628f61e54481', 'multiverseId': 538486}, 'multiverseid': 538486}]", '[{\'name\': \'Verrat des Rudels\', \'text\': \'Übernimm bis zum Ende des Zuges die Kontrolle über eine Kreatur deiner Wahl. Enttappe sie. Sie erhält Eile bis zum Ende des Zuges. Falls du einen Wolf oder Werwolf kontrollierst, wende Hellsicht 2 an. (Schaue dir die obersten zwei Karten deiner Bibliothek an. Du kannst eine beliebige Anzahl davon unter deine Bibliothek legen und den Rest in beliebiger Reihenfolge oben darauf.)\', \'type\': \'Hexerei\', \'flavor\': \'Selbst Arlinns eigenes Rudel konnte Tovolars Befehlsgeheul nicht widerstehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535248&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cde364c0-4e74-42d5-a2fc-bd2671c1bea6\', \'multiverseId\': 535248}, \'multiverseid\': 535248}, {\'name\': \'Traición de la manada\', \'text\': \'Gana el control de la criatura objetivo hasta el final del turno. Endereza esa criatura. Gana la habilidad de prisa hasta el final del turno. Si controlas un Lobo o Licántropo, adivina 2. (Mira las dos primeras cartas de tu biblioteca, luego pon cualquier cantidad de ellas en el fondo de tu biblioteca y el resto en la parte superior en cualquier orden.)\', \'type\': \'Conjuro\', \'flavor\': \'Fue demasiado difícil resistirse al aullido autoritario de Tovolar, incluso para la manada leal de Arlinn.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535564&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8f2ef2d3-0fe9-44eb-a8bb-dd39988fb252\', \'multiverseId\': 535564}, \'multiverseid\': 535564}, {\'name\': \'Trahison de la meute\', \'text\': "Acquérez le contrôle d\'une créature ciblée jusqu\'à la fin du tour. Dégagez cette créature. Elle acquiert la célérité jusqu\'à la fin du tour. Si vous contrôlez un loup ou un loup-garou, regard 2. (Regardez les deux cartes du dessus de votre bibliothèque. Mettez n\'importe quel nombre d\'entre elles au-dessous de votre bibliothèque et le reste, au-dessus, dans n\'importe quel ordre.)", \'type\': \'Rituel\', \'flavor\': "Il était trop difficile de résister au hurlement impérieux de Tovolar, même pour la propre meute d\'Arlinn.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535880&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'76203db6-95fa-4c0a-a2f3-6ab0b4b1de4a\', \'multiverseId\': 535880}, \'multiverseid\': 535880}, {\'name\': \'Tradimento del Branco\', \'text\': \'Prendi il controllo di una creatura bersaglio fino alla fine del turno. STAPpa quella creatura. Ha rapidità fino alla fine del turno. Se controlli un Lupo o un Mannaro, profetizza 2. (Guarda le prime due carte del tuo grimorio, poi mettine un qualsiasi numero in fondo al tuo grimorio e le altre in cima in qualsiasi ordine.)\', \'type\': \'Stregoneria\', \'flavor\': "L\'ululato di Tovolar era impossibile da resistere, anche per il fedele branco di Arlinn.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536196&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'727a0def-3ed0-4bde-a6e0-c44e4a80c39d\', \'multiverseId\': 536196}, \'multiverseid\': 536196}, {\'name\': \'群れの裏切り\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それのコントロールを得る。そのクリーチャーをアンタップする。ターン終了時まで、それは速攻を得る。あなたが狼や狼男をコントロールしているなら、占術２を行う。（あなたのライブラリーの一番上にあるカード２枚を見て、そのうちの望む枚数をあなたのライブラリーの一番下に、残りを一番上に、それぞれ望む順番で置く。）\', \'type\': \'ソーサリー\', \'flavor\': \'アーリンの忠実な群れですら、トヴォラーの招集の遠吠えには耐えがたいものがあった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536512&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c436c47d-f512-46b6-89a8-7ac3212ec785\', \'multiverseId\': 536512}, \'multiverseid\': 536512}, {\'name\': \'무리의 배신\', \'text\': \'생물을 목표로 정한다. 턴종료까지 그 생물의 조종권을 얻는다. 그 생물은 언탭되고 턴종료까지 신속을 얻는다. 당신이 늑대 또는 늑대인간을 조종한다면, 점술 2를 한다. (당신의 서고 맨 위 카드 두 장을 본다. 당신은 그 카드들 중 원하는 만큼을 당신의 서고 맨 밑에 놓고 나머지를 당신의 서고 맨 위에 원하는 순서대로 놓을 수 있다.)\', \'type\': \'집중마법\', \'flavor\': \'토볼라르가 울부짖으며 내린 명령은 아를린에게 충성하는 무리조차 저항할 수 없을 정도로 벅찼다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536828&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2976998e-51ea-45dc-b37d-46e80cc677ed\', \'multiverseId\': 536828}, \'multiverseid\': 536828}, {\'name\': \'Traição da Alcateia\', \'text\': \'Ganhe o controle da criatura alvo até o final do turno. Desvire aquela criatura. Ela ganha ímpeto até o final do turno. Se você controlar um Lobo ou um Lobisomem, use vidência 2. (Olhe os dois cards do topo do seu grimório. Depois, coloque qualquer número deles no fundo do seu grimório e o restante no topo em qualquer ordem.)\', \'type\': \'Feitiço\', \'flavor\': \'O uivo de comando de Tovolar era forte demais para resistir, mesmo para a leal alcateia da própria Arlinn.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537144&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d019e317-68b8-4c6e-807b-90930de7ffda\', \'multiverseId\': 537144}, \'multiverseid\': 537144}, {\'name\': \'Предательство Стаи\', \'text\': \'Получите контроль над целевым существом до конца хода. Разверните то существо. Оно получает Ускорение до конца хода. Если у вас под контролем есть Волк или Вервольф, предскажите 2. (Посмотрите две верхние карты вашей библиотеки, затем положите любое количество из них в низ вашей библиотеки, а остальные на верх вашей библиотеки в любом порядке.)\', \'type\': \'Волшебство\', \'flavor\': \'Владетельный вой Товолара был слишком силен, и даже верная стая Арлинн не могла сопротивляться ему.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537460&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c8c9702a-95e4-4805-8bda-4c6da7f2c02c\', \'multiverseId\': 537460}, \'multiverseid\': 537460}, {\'name\': \'狼群背叛\', \'text\': \'获得目标生物的操控权直到回合结束。重置该生物。它获得敏捷异能直到回合结束。如果你操控狼或狼人，则占卜2。（检视你牌库顶的两张牌，然后将其中任意数量的牌以任意顺序置于你牌库底，其余则以任意顺序置于你牌库顶。）\', \'type\': \'法术\', \'flavor\': \'托瓦拉号令狼嚎难以抗拒，纵连雅琳自己的忠诚狼群亦为之动摇。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537776&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3fc7857f-62f7-4ff8-a327-e816cf889045\', \'multiverseId\': 537776}, \'multiverseid\': 537776}, {\'name\': \'狼群背叛\', \'text\': \'獲得目標生物的操控權直到回合結束。重置該生物。它獲得敏捷異能直到回合結束。如果你操控狼或狼人，則占卜2。（檢視你牌庫頂的兩張牌，然後將其中任意數量的牌以任意順序置於你牌庫底，其餘則以任意順序置於你牌庫頂。）\', \'type\': \'巫術\', \'flavor\': \'托瓦拉號令狼嚎難以抗拒，縱連雅琳自己的忠誠狼群亦為之動搖。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538092&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'11f9ad41-fd29-40e3-91c5-540e4bc57b28\', \'multiverseId\': 538092}, \'multiverseid\': 538092}]', '[{\'name\': \'Verseuchter Widersacher\', \'text\': \'Todesberührung\\nWenn der Verseuchte Widersacher ins Spiel kommt, kannst du beliebig oft {2}{B} bezahlen. Wenn du diese Kosten ein- oder mehrmals bezahlst, lege entsprechend viele +1/+1-Marken auf den Verseuchten Widersacher. Erzeuge dann doppelt so viele 2/2 schwarze Zombie-Kreaturenspielsteine mit Verwesung. (Eine Kreatur mit Verwesung kann nicht blocken. Wenn sie angreift, opfere sie am Ende des Kampfes.)\', \'type\': \'Kreatur — Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535215&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'90db2134-4bcc-4a17-b122-fa4034af0173\', \'multiverseId\': 535215}, \'multiverseid\': 535215}, {\'name\': \'Adversario podrido\', \'text\': \'Toque mortal.\\nCuando el Adversario podrido entre al campo de batalla, puedes pagar {2}{B} tantas veces como quieras. Cuando pagues este coste una o más veces, pon esa misma cantidad de contadores +1/+1 sobre el Adversario podrido, luego crea el doble de esa cantidad de fichas de criatura Zombie negras 2/2 con la habilidad de descomposición. (Una criatura con la habilidad de descomposición no puede bloquear. Cuando ataque, sacrifícala al final del combate.)\', \'type\': \'Criatura — Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535531&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2bbb8ea1-c08e-4796-b3eb-530b78349885\', \'multiverseId\': 535531}, \'multiverseid\': 535531}, {\'name\': \'Adversaire souillé\', \'text\': "Contact mortel\\nQuand l\'Adversaire souillé arrive sur le champ de bataille, vous pouvez payer {2}{B} autant de fois que vous le souhaitez. Quand vous payez ce coût au moins une fois, mettez autant de marqueurs +1/+1 sur l\'Adversaire souillé, puis créez deux fois ce nombre de jetons de créature 2/2 noire Zombie avec la décomposition. (Une créature avec la décomposition ne peut pas bloquer. Quand elle attaque, sacrifiez-la à la fin du combat.)", \'type\': \'Créature : zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535847&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d84b8345-2e9b-46b1-a05d-746d45d769e6\', \'multiverseId\': 535847}, \'multiverseid\': 535847}, {\'name\': \'Avversario Corrotto\', \'text\': "Tocco letale\\nQuando l\'Avversario Corrotto entra nel campo di battaglia, puoi pagare {2}{B} un qualsiasi numero di volte. Quando paghi questo costo una o più volte, metti altrettanti segnalini +1/+1 sull\'Avversario Corrotto, poi crea il doppio di pedine creatura Zombie 2/2 nere con decomposto. (Una creatura con decomposto non può bloccare. Quando attacca, sacrificala alla fine del combattimento.)", \'type\': \'Creatura — Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536163&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'de9376e4-c7ff-44bc-a072-4ad7cbbc4708\', \'multiverseId\': 536163}, \'multiverseid\': 536163}, {\'name\': \'穢れた敵対者\', \'text\': \'接死\\n穢れた敵対者が戦場に出たとき、あなたは{2}{B}を望む回数支払ってもよい。あなたがこのコストを１回以上支払ったとき、その回数に等しい数の＋１/＋１カウンターを穢れた敵対者の上に置く。その後、その回数の２倍の数の、腐乱を持つ黒の２/２のゾンビ・クリーチャー・トークンを生成する。（腐乱を持つクリーチャーではブロックできない。それが攻撃したとき、戦闘終了時に、それを生け贄に捧げる。）\', \'type\': \'クリーチャー — ゾンビ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536479&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1802dcec-798a-46f6-ac48-97c513a310d8\', \'multiverseId\': 536479}, \'multiverseid\': 536479}, {\'name\': \'타락한 적수\', \'text\': \'치명타\\n타락한 적수가 전장에 들어올 때, 당신은 원하는 횟수만큼 {2}{B}를 지불할 수 있다. 당신이 이 비용을 한 번 이상 지불할 때, 타락한 적수에 그 수만큼 +1/+1 카운터를 올려놓은 후, 그 수의 두 배만큼 부패를 가진 2/2 흑색 좀비 생물 토큰을 만든다. (부패를 가진 생물은 방어할 수 없다. 그 생물이 공격할 때, 전투종료에 그 생물을 희생한다.)\', \'type\': \'생물 — 좀비\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536795&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8bcdb8ea-ea78-4e36-b9fb-5bf2c9b392e1\', \'multiverseId\': 536795}, \'multiverseid\': 536795}, {\'name\': \'Adversário Maculado\', \'text\': \'Toque mortífero\\nQuando Adversário Maculado entra no campo de batalha, você pode pagar {2}{B} qualquer número de vezes. Quando pagar este custo uma ou mais vezes, coloque aquela quantidade de marcadores +1/+1 em Adversário Maculado e depois crie duas vezes aquela quantidade de fichas de criatura Zumbi preta 2/2 com decomposto. (Uma criatura com decomposto não pode bloquear. Quando ela atacar, sacrifique-a no final do combate.)\', \'type\': \'Criatura — Zumbi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537111&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'56b28036-d8ca-4f2c-b0fd-7cf57bc4eb5f\', \'multiverseId\': 537111}, \'multiverseid\': 537111}, {\'name\': \'Порченый Противник\', \'text\': \'Смертельное касание\\nКогда Порченый Противник выходит на поле битвы, вы можете заплатить {2}{B} любое количество раз. Когда вы оплачиваете эту стоимость один или несколько раз, положите такое же количество жетонов +1/+1 на Порченого Противника, затем создайте такое же количество фишек существа 2/2 черный Зомби с Трупной гнилью в двойном размере. (Существо с Трупной гнилью не может блокировать. Когда оно атакует, пожертвуйте его в конце боя.)\', \'type\': \'Существо — Зомби\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537427&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e83857d7-1b1f-465e-bcbe-77d332fcef03\', \'multiverseId\': 537427}, \'multiverseid\': 537427}, {\'name\': \'败坏仇敌\', \'text\': \'死触\\n当败坏仇敌进战场时，你可以支付{2}{B}任意次数。当你支付一次或数次此费用时，根据该数量在败坏仇敌上放置等量的+1/+1指示物，然后派出两倍的2/2黑色，具败朽异能的灵俑衍生生物。（具败朽异能的生物不能进行阻挡。当它攻击，在战斗结束时将它牺牲。）\', \'type\': \'生物 ～灵俑\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537743&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f6181e39-48f8-44bc-b80f-0645fdaa522b\', \'multiverseId\': 537743}, \'multiverseid\': 537743}, {\'name\': \'敗壞仇敵\', \'text\': \'死觸\\n當敗壞仇敵進戰場時，你可以支付{2}{B}任意次數。當你支付一次或數次此費用時，根據該數量在敗壞仇敵上放置等量的+1/+1指示物，然後派出兩倍的2/2黑色，具敗朽異能的殭屍衍生生物。（具敗朽異能的生物不能進行阻擋。當它攻擊，在戰鬥結束時將它犧牲。）\', \'type\': \'生物 ～殭屍\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538059&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b77e4aa7-8c39-4017-b718-adba1fffb1b9\', \'multiverseId\': 538059}, \'multiverseid\': 538059}]', '[{\'name\': \'Verseuchter Widersacher\', \'text\': \'Todesberührung\\nWenn der Verseuchte Widersacher ins Spiel kommt, kannst du beliebig oft {2}{B} bezahlen. Wenn du diese Kosten ein- oder mehrmals bezahlst, lege entsprechend viele +1/+1-Marken auf den Verseuchten Widersacher. Erzeuge dann doppelt so viele 2/2 schwarze Zombie-Kreaturenspielsteine mit Verwesung.\', \'type\': \'Kreatur — Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538766&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8c5da065-5bb4-4b56-b366-bd110503e738\', \'multiverseId\': 538766}, \'multiverseid\': 538766}, {\'name\': \'Adversario podrido\', \'text\': \'Toque mortal.\\nCuando el Adversario podrido entre al campo de batalla, puedes pagar {2}{B} tantas veces como quieras. Cuando pagues este coste una o más veces, pon esa misma cantidad de contadores +1/+1 sobre el Adversario podrido, luego crea el doble de esa cantidad de fichas de criatura Zombie negras 2/2 con la habilidad de descomposición.\', \'type\': \'Criatura — Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538826&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fd54e891-1bea-44b6-862b-21289c6f5c9e\', \'multiverseId\': 538826}, \'multiverseid\': 538826}, {\'name\': \'Adversaire souillé\', \'text\': "Contact mortel\\nQuand l\'Adversaire souillé arrive sur le champ de bataille, vous pouvez payer {2}{B} autant de fois que vous le souhaitez. Quand vous payez ce coût au moins une fois, mettez autant de marqueurs +1/+1 sur l\'Adversaire souillé, puis créez deux fois ce nombre de jetons de créature 2/2 noire Zombie avec la décomposition.", \'type\': \'Créature : zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538886&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'89ca198c-7755-48c2-bebc-526e82886492\', \'multiverseId\': 538886}, \'multiverseid\': 538886}, {\'name\': \'Avversario Corrotto\', \'text\': "Tocco letale\\nQuando l\'Avversario Corrotto entra nel campo di battaglia, puoi pagare {2}{B} un qualsiasi numero di volte. Quando paghi questo costo una o più volte, metti altrettanti segnalini +1/+1 sull\'Avversario Corrotto, poi crea il doppio di pedine creatura Zombie 2/2 nere con decomposto.", \'type\': \'Creatura — Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538946&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'27c7cc26-3023-469b-ac60-bc744cceaa38\', \'multiverseId\': 538946}, \'multiverseid\': 538946}, {\'name\': \'穢れた敵対者\', \'text\': \'接死\\n穢れた敵対者が戦場に出たとき、あなたは{2}{B}を望む回数支払ってもよい。あなたがこのコストを１回以上支払ったとき、その回数に等しい数の＋１/＋１カウンターを穢れた敵対者の上に置く。その後、その回数の２倍の数の、腐乱を持つ黒の２/２のゾンビ・クリーチャー・トークンを生成する。\', \'type\': \'クリーチャー — ゾンビ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=539006&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9f258aa8-16c1-4292-bb97-bb1d068a577c\', \'multiverseId\': 539006}, \'multiverseid\': 539006}]', '[{\'name\': \'Verteidigung des Celestus\', \'text\': \'Verteile drei +1/+1-Marken auf eine, zwei oder drei Kreaturen deiner Wahl, die du kontrollierst.\', \'type\': \'Spontanzauber\', \'flavor\': \'Hexe, Werwolf und Katharer standen Seite an Seite um das Sonnengold-Schloss in der Mitte des Rituals, bereit, Tovolars Ansturm aufzuhalten — oder bei dem Versuch zu sterben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535285&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8c1a1f2f-5f87-4560-b4da-c17b5749dfc4\', \'multiverseId\': 535285}, \'multiverseid\': 535285}, {\'name\': \'Defender el Celestus\', \'text\': \'Distribuye tres contadores +1/+1 entre una, dos o tres criaturas objetivo que controlas.\', \'type\': \'Instantáneo\', \'flavor\': \'Brujas, licántropos y cátaros rodearon codo con codo la cerradura de orosolar, en el centro del ritual, con la intención de detener el asalto de Tovolar o morir en el intento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535601&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2544f4e3-6024-4364-b88d-13cff2459558\', \'multiverseId\': 535601}, \'multiverseid\': 535601}, {\'name\': \'Défendre le Celestus\', \'text\': \'Répartissez trois marqueurs +1/+1 entre une, deux ou trois créatures ciblées que vous contrôlez.\', \'type\': \'Éphémère\', \'flavor\': "Envoûteuse, loup-garou et cathare se tenaient épaule contre épaule autour de la serrure d\'or solaire au centre du rituel, déterminés à arrêter l\'assaut de Tovolar au péril de leurs vies.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535917&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0b57a826-f626-46f1-8994-ee3f60a2ce2b\', \'multiverseId\': 535917}, \'multiverseid\': 535917}, {\'name\': \'Difendere il Celestus\', \'text\': \'Distribuisci tre segnalini +1/+1 tra una, due o tre creature bersaglio che controlli.\', \'type\': \'Istantaneo\', \'flavor\': "Streghe, mannari e catari si schierarono fianco a fianco intorno alla Serratura di Eliodoro al centro del rituale, pronti a fermare l\'assalto di Tovolar anche a costo della vita.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536233&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1daf73a4-01a6-4e03-9e57-2c615b1984b2\', \'multiverseId\': 536233}, \'multiverseid\': 536233}, {\'name\': \'セレスタス防衛\', \'text\': \'あなたがコントロールしているクリーチャー１体か２体か３体を対象とし、それらの上に３個分をあなたの望むように割り振る。それらの上にその割り振った個数の＋１/＋１カウンターを置く。\', \'type\': \'インスタント\', \'flavor\': \'魔女と人狼と聖戦士は肩を並べて儀式の中心で日金の錠を囲った。彼らはトヴォラーの攻撃を阻止する覚悟が出来ていた。命を懸けても。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536549&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'63ee4c7b-586f-422d-8508-15cd47235fbc\', \'multiverseId\': 536549}, \'multiverseid\': 536549}, {\'name\': \'셀레스투스 방어\', \'text\': \'당신이 조종하는 생물 중 하나, 둘 또는 세 개를 목표로 정한다. 그 생물들에 +1/+1 카운터 세 개를 배분한다.\', \'type\': \'순간마법\', \'flavor\': \'마녀, 늑대인간, 그리고 성전사가 의식의 한가운데에 있는 태양황금 자물쇠를 둘러싸고 서로 어깨를 맞대고 섰다. 그들은 토볼라르의 공격을 막을, 최소한 그런 시도라도 해 볼 준비가 되어 있었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536865&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d1786745-21b4-4fd9-8230-5a62d3360dc5\', \'multiverseId\': 536865}, \'multiverseid\': 536865}, {\'name\': \'Defender o Celestus\', \'text\': \'Distribua três marcadores +1/+1 entre uma, duas ou três criaturas alvo que você controla.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Bruxas, lobisomens e cátaros se puseram lado a lado em torno da Fechadura de Ouro Solar, no centro do ritual, prontos para deter o assalto de Tovolar... ou morrer tentando.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537181&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'738d59ab-9528-4cca-88b3-e79b09f93def\', \'multiverseId\': 537181}, \'multiverseid\': 537181}, {\'name\': \'Защитить Целестус\', \'text\': \'Распределите три жетона +1/+1 между одним, двумя или тремя целевыми существами под вашим контролем.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Ведьма, вервольф и катар стояли плечом к плечу у Замка солнечного золота в центре ритуала, готовые остановить нападение Товолара — или умереть.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537497&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'69eacb97-5fab-494c-aedc-7d0d4c5f7868\', \'multiverseId\': 537497}, \'multiverseid\': 537497}, {\'name\': \'守卫穹天仪\', \'text\': \'将三个+1/+1指示物分配给一个，两个或三个目标由你操控的生物。\', \'type\': \'瞬间\', \'flavor\': \'女巫、狼人和护教军并肩站在仪式中心的旭金锁周围，准备誓死抵御托瓦拉的袭击。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537813&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'238102f2-efdb-43f8-a313-c430a9175d28\', \'multiverseId\': 537813}, \'multiverseid\': 537813}, {\'name\': \'守衛穹天儀\', \'text\': \'將三個+1/+1指示物分配給一個，兩個或三個目標由你操控的生物。\', \'type\': \'瞬間\', \'flavor\': \'女巫、狼人和護教軍並肩站在儀式中心的旭金鎖周圍，準備誓死抵禦托瓦拉的襲擊。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538129&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d08fc0d2-3e22-4e13-a33a-36af0a289ba0\', \'multiverseId\': 538129}, \'multiverseid\': 538129}]', '[{\'name\': \'Vivisektion\', \'text\': \'Opfere eine Kreatur als zusätzliche Kosten, um diesen Zauberspruch zu wirken.\\nZiehe drei Karten.\', \'type\': \'Hexerei\', \'flavor\': \'Obwohl ihre Arbeit meist geschmäht wird, sehen Leichenflicker sich als Vorreiter der Wissenschaft.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535166&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fd62fdc3-f5ad-4db6-8665-16729306d9c2\', \'multiverseId\': 535166}, \'multiverseid\': 535166}, {\'name\': \'Vivisección\', \'text\': \'Como coste adicional para lanzar este hechizo, sacrifica una criatura.\\nRoba tres cartas.\', \'type\': \'Conjuro\', \'flavor\': \'Aunque la mayoría piensa que su trabajo es una injuria, los suturadores se consideran los científicos más avanzados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535482&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9f9617ef-8b97-401c-a898-12caca606b8c\', \'multiverseId\': 535482}, \'multiverseid\': 535482}, {\'name\': \'Vivisection\', \'text\': \'En tant que coût supplémentaire pour lancer ce sort, sacrifiez une créature.\\nPiochez trois cartes.\', \'type\': \'Rituel\', \'flavor\': \'Bien que leur travail soit largement vilipendé, les raccommodeurs se considèrent comme étant à la pointe de la science.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535798&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'14dcfaf6-e2aa-4135-86ef-6b6b3b8582d0\', \'multiverseId\': 535798}, \'multiverseid\': 535798}, {\'name\': \'Vivisezione\', \'text\': \'Come costo addizionale per lanciare questa magia, sacrifica una creatura.\\nPesca tre carte.\', \'type\': \'Stregoneria\', \'flavor\': "Seppure siano spesso vilipesi, i cucitori sono tagliati per un lavoro che essi considerano all\'avanguardia.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536114&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a64dbc79-f197-4f34-9f05-7711e2cd3f34\', \'multiverseId\': 536114}, \'multiverseid\': 536114}, {\'name\': \'生体解剖\', \'text\': \'この呪文を唱えるための追加コストとして、クリーチャー１体を生け贄に捧げる。\\nカード３枚を引く。\', \'type\': \'ソーサリー\', \'flavor\': \'彼らの作品は広く蔑視されているが、縫い師は自身らが科学の最先端にいると自負している。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536430&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'00d11cae-335e-4671-956f-470fa1ee9287\', \'multiverseId\': 536430}, \'multiverseid\': 536430}, {\'name\': \'생체 해부\', \'text\': \'이 주문을 발동하기 위한 추가비용으로, 생물 한 개를 희생한다.\\n카드 세 장을 뽑는다.\', \'type\': \'집중마법\', \'flavor\': \'그들의 작업물이 널리 비난받고 있기는 하지만, 봉합술사들은 자신들이 과학의 최첨단에 서 있다고 여긴다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536746&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d916d82a-1b27-4a71-9f04-63570897ba25\', \'multiverseId\': 536746}, \'multiverseid\': 536746}, {\'name\': \'Vivissecção\', \'text\': \'Como custo adicional para conjurar esta mágica, sacrifique uma criatura.\\nCompre três cards.\', \'type\': \'Feitiço\', \'flavor\': \'Embora seu trabalho seja amplamente desprezado, os suturadores acreditam estar na vanguarda da ciência.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537062&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d1d646df-7a62-4026-a4d9-f454bbc1f774\', \'multiverseId\': 537062}, \'multiverseid\': 537062}, {\'name\': \'Вивисекция\', \'text\': \'В качестве дополнительной стоимости разыгрывания этого заклинания пожертвуйте существо.\\nВозьмите три карты.\', \'type\': \'Волшебство\', \'flavor\': \'Несмотря на то что их работа широко осуждается, сшиватели видят себя на переднем крае науки.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537378&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5ad8fbe9-0380-4248-a3d0-17c76b1f5a1f\', \'multiverseId\': 537378}, \'multiverseid\': 537378}, {\'name\': \'活体解剖\', \'text\': \'牺牲一个生物，以作为施放此咒语的额外费用。\\n抓三张牌。\', \'type\': \'法术\', \'flavor\': \'虽然拼接师的工作遭人唾弃，但他们觉得自己在引领技术尖端。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537694&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0bd73ca0-b159-4a95-9eb0-01d7b40fc038\', \'multiverseId\': 537694}, \'multiverseid\': 537694}, {\'name\': \'活體解剖\', \'text\': \'犧牲一個生物，以作為施放此咒語的額外費用。\\n抽三張牌。\', \'type\': \'巫術\', \'flavor\': \'雖然拼接師的工作遭人唾棄，但他們覺得自己在引領技術尖端。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538010&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d16da8e3-d459-4e66-adfd-c20519ab3451\', \'multiverseId\': 538010}, \'multiverseid\': 538010}]', '[{\'name\': \'Voldaren-Lauerer\', \'text\': \'Wenn der Voldaren-Lauerer ins Spiel kommt und falls ein Gegner in diesem Zug Lebenspunkte verloren hat, fügt er bis zu einer Kreatur oder einem Planeswalker deiner Wahl X Schadenspunkte zu, wobei X gleich der Anzahl an Vampiren ist, die du kontrollierst.\', \'type\': \'Kreatur — Vampir, Bogenschütze\', \'flavor\': \'„Erwischt."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535266&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c607a1e7-e3e7-47ec-a2b9-365980670466\', \'multiverseId\': 535266}, \'multiverseid\': 535266}, {\'name\': \'Emboscador de Voldaren\', \'text\': \'Cuando el Emboscador de Voldaren entre al campo de batalla, si un oponente perdió vidas este turno, hace X puntos de daño a hasta una criatura o planeswalker objetivo, donde X es la cantidad de Vampiros que controlas.\', \'type\': \'Criatura — Arquero vampiro\', \'flavor\': \'"Te tengo".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535582&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'67151bd8-2320-4bcd-8115-b6af7f9171da\', \'multiverseId\': 535582}, \'multiverseid\': 535582}, {\'name\': \'Embusqueur Voldaren\', \'text\': "Quand l\'Embusqueur Voldaren arrive sur le champ de bataille, si un adversaire a perdu des points de vie ce tour-ci, il inflige X blessures à jusqu\'à une cible, créature ou planeswalker, X étant le nombre de vampires que vous contrôlez.", \'type\': \'Créature : vampire et archer\', \'flavor\': "« Je t\'ai eu. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535898&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a89557a7-78e8-487c-9788-684e160ab4a1\', \'multiverseId\': 535898}, \'multiverseid\': 535898}, {\'name\': \'Assalitore Voldaren\', \'text\': "Quando l\'Assalitore Voldaren entra nel campo di battaglia, se un avversario ha perso punti vita in questo turno, scegli fino a una creatura o a un planeswalker bersaglio a cui l\'Assalitore Voldaren infligge X danni, dove X è il numero di Vampiri che controlli.", \'type\': \'Creatura — Arciere Vampiro\', \'flavor\': \'"Beccato."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536214&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f3944a41-4fee-4a82-b6e7-c3d67124d08b\', \'multiverseId\': 536214}, \'multiverseid\': 536214}, {\'name\': \'ヴォルダーレンの伏兵\', \'text\': \'ヴォルダーレンの伏兵が戦場に出たとき、このターンに対戦相手がライフを失っていた場合、クリーチャーやプレインズウォーカーのうち最大１体を対象とする。これはそれにＸ点のダメージを与える。Ｘはあなたがコントロールしている吸血鬼の数に等しい。\', \'type\': \'クリーチャー — 吸血鬼・射手\', \'flavor\': \'「見つけたぞ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536530&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'80be6f57-9c6f-4fb3-8efd-6cecf3ab949a\', \'multiverseId\': 536530}, \'multiverseid\': 536530}, {\'name\': \'볼다렌 매복꾼\', \'text\': \'볼다렌 매복꾼이 전장에 들어올 때, 이 턴에 생명점을 잃은 상대가 있다면, 생물 또는 플레인즈워커를 최대 한 개까지 목표로 정한다. 볼다렌 매복꾼은 그 목표에게 피해 X점을 입힌다. X는 당신이 조종하는 흡혈귀의 수이다.\', \'type\': \'생물 — 흡혈귀 궁수\', \'flavor\': \'"잡았다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536846&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b90dfb55-4242-4cf4-8cc0-8cd9d356d54a\', \'multiverseId\': 536846}, \'multiverseid\': 536846}, {\'name\': \'Emboscador Voldaren\', \'text\': \'Quando Emboscador Voldaren entra no campo de batalha, se um oponente perdeu pontos de vida neste turno, Emboscador Voldaren causa X pontos de dano a até uma criatura ou um planeswalker alvo, sendo X o número de Vampiros que você controla.\', \'type\': \'Criatura — Vampiro Arqueiro\', \'flavor\': \'"Te peguei."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537162&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'89e6350d-9167-4e0a-b795-c3de64598ec5\', \'multiverseId\': 537162}, \'multiverseid\': 537162}, {\'name\': \'Волдаренский Мастер Засад\', \'text\': "Когда Волдаренский Мастер Засад выходит на поле битвы, если оппонент терял жизнь в этом ходу, он наносит X повреждений не более чем одному целевому существу или planeswalker\'у, где X — количество Вампиров под вашим контролем.", \'type\': \'Существо — Вампир Лучник\', \'flavor\': \'«Попался».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537478&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a028dc22-bfe1-4cb3-bdee-1befc2570c65\', \'multiverseId\': 537478}, \'multiverseid\': 537478}, {\'name\': \'沃达连伏击客\', \'text\': \'当沃达连伏击客进战场时，若有对手本回合中失去过生命，则它对至多一个目标生物或鹏洛客造成X点伤害，X为由你操控的吸血鬼数量。\', \'type\': \'生物 ～吸血鬼／弓箭手\', \'flavor\': \'「逮到你了。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537794&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'44ab8740-2b40-4f43-9b65-9d8b3f1022cc\', \'multiverseId\': 537794}, \'multiverseid\': 537794}, {\'name\': \'沃達連伏擊客\', \'text\': \'當沃達連伏擊客進戰場時，若有對手本回合中失去過生命，則它對至多一個目標生物或鵬洛客造成X點傷害，X為由你操控的吸血鬼數量。\', \'type\': \'生物 ～吸血鬼／弓箭手\', \'flavor\': \'「逮到你了。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538110&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c517ebc5-1585-4f9d-b5eb-924ba9a6ccf0\', \'multiverseId\': 538110}, \'multiverseid\': 538110}]', '[{\'name\': \'Voldaren-Stecherin\', \'text\': \'Die Voldaren-Stecherin hat Erstschlag, solange sie angreift.\\n{2}{R}: Die Voldaren-Stecherin erhält +2/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Vampir, Krieger\', \'flavor\': \'Ein Duell bis aufs Blut bedeutet etwas ganz anderes, wenn ein Vampir beteiligt ist.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535267&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ca56383a-a311-4a60-b9aa-e6954881ed94\', \'multiverseId\': 535267}, \'multiverseid\': 535267}, {\'name\': \'Apuñaladora de Voldaren\', \'text\': \'La Apuñaladora de Voldaren tiene la habilidad de dañar primero mientras esté atacando.\\n{2}{R}: La Apuñaladora de Voldaren obtiene +2/+0 hasta el final del turno.\', \'type\': \'Criatura — Guerrero vampiro\', \'flavor\': \'Para los vampiros, un duelo a primera sangre significa algo muy distinto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535583&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a3305c7d-d8fa-4ae1-a215-db7ef73e3ff6\', \'multiverseId\': 535583}, \'multiverseid\': 535583}, {\'name\': \'Piqueuse Voldaren\', \'text\': "La Piqueuse Voldaren a l\'initiative tant qu\'elle attaque.\\n{2}{R} : La Piqueuse Voldaren gagne +2/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : vampire et guerrier\', \'flavor\': \'Un duel au premier sang prend une tout autre signification quand il implique un vampire.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535899&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4884e2c5-9253-477d-8625-cc2dcd53231e\', \'multiverseId\': 535899}, \'multiverseid\': 535899}, {\'name\': \'Pungolatrice Voldaren\', \'text\': \'La Pungolatrice Voldaren ha attacco improvviso fintanto che è attaccante.\\n{2}{R}: La Pungolatrice Voldaren prende +2/+0 fino alla fine del turno.\', \'type\': \'Creatura — Guerriero Vampiro\', \'flavor\': "Un duello al primo sangue assume un significato molto diverso quando c\'è di mezzo un vampiro.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536215&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'82229219-c5b2-41af-ab16-36d1062d0cb0\', \'multiverseId\': 536215}, \'multiverseid\': 536215}, {\'name\': \'ヴォルダーレンの刺剣士\', \'text\': \'ヴォルダーレンの刺剣士が攻撃しているかぎり、これは先制攻撃を持つ。\\n{2}{R}：ターン終了時まで、ヴォルダーレンの刺剣士は＋２/＋０の修整を受ける。\', \'type\': \'クリーチャー — 吸血鬼・戦士\', \'flavor\': \'「最初の出血までの決闘」は、吸血鬼が相手だとまるで違う意味を持つ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536531&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'610fd646-9c55-402d-83a5-3938b0269600\', \'multiverseId\': 536531}, \'multiverseid\': 536531}, {\'name\': \'볼다렌 칼침꾼\', \'text\': \'볼다렌 칼침꾼은 자신이 공격 중인 한 선제공격을 가진다.\\n{2}{R}: 볼다렌 칼침꾼은 턴종료까지 +2/+0을 받는다.\', \'type\': \'생물 — 흡혈귀 전사\', \'flavor\': \'피가 보일 때까지 결투한다는 말의 의미는 흡혈귀가 관련되었을 때에는 상당히 다른 의미가 된다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536847&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'41f680e4-04cd-49fd-bd7f-944f83f004dd\', \'multiverseId\': 536847}, \'multiverseid\': 536847}, {\'name\': \'Ferroadora Voldaren\', \'text\': \'Ferroadora Voldaren tem iniciativa enquanto estiver atacando.\\n{2}{R}: Ferroadora Voldaren recebe +2/+0 até o final do turno.\', \'type\': \'Criatura — Vampiro Guerreiro\', \'flavor\': \'Um duelo até o primeiro sangue tem um significado totalmente diferente quando há um vampiro envolvido.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537163&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'02548e03-1ce0-456b-8a6b-88f57de062d3\', \'multiverseId\': 537163}, \'multiverseid\': 537163}, {\'name\': \'Волдаренская Уязвительница\', \'text\': \'Пока Волдаренская Уязвительница атакует, она имеет Первый удар.\\n{2}{R}: Волдаренская Уязвительница получает +2/+0 до конца хода.\', \'type\': \'Существо — Вампир Воин\', \'flavor\': \'Дуэль до первой крови означает совершенно другое, когда в ней участвует вампир.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537479&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ceb1ceb9-7f85-4086-b0e2-c9fa99b3ca3b\', \'multiverseId\': 537479}, \'multiverseid\': 537479}, {\'name\': \'沃达连刺棘客\', \'text\': \'只要沃达连刺棘客正进行攻击，它便具有先攻异能。\\n{2}{R}：沃达连刺棘客得+2/+0直到回合结束。\', \'type\': \'生物 ～吸血鬼／战士\', \'flavor\': \'见血即止的决斗规矩，在有吸血鬼参与的情况下其意义已大不相同。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537795&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1c25dfc9-299c-4ef0-805a-4f4541faf393\', \'multiverseId\': 537795}, \'multiverseid\': 537795}, {\'name\': \'沃達連刺棘客\', \'text\': \'只要沃達連刺棘客正進行攻擊，它便具有先攻異能。\\n{2}{R}：沃達連刺棘客得+2/+0直到回合結束。\', \'type\': \'生物 ～吸血鬼／戰士\', \'flavor\': \'見血即止的決鬥規矩，在有吸血鬼參與的情況下其意義已大不相同。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538111&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'79fa8221-0249-4d28-a460-4cf1b0ca4bc0\', \'multiverseId\': 538111}, \'multiverseid\': 538111}]', "[{'name': 'Vorratskammer-Zombie', 'text': 'Verteidiger\\nTappe drei ungetappte Kreaturen, die du kontrollierst: Schaue dir die oberste Karte deiner Bibliothek an. Du kannst sie auf deinen Friedhof legen.', 'type': 'Kreatur — Zombie', 'flavor': 'Als die Katharer im verlassenen Labor ankamen, fanden sie dort viele der nicht abgeschlossenen Projekte vor, die jetzt aneinander nagten.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535136&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'af801c17-5a48-45a0-9b52-918badf17b3c', 'multiverseId': 535136}, 'multiverseid': 535136}, {'name': 'Zombie muerto de hambre', 'text': 'Defensor.\\nGirar tres criaturas enderezadas que controlas: Mira la primera carta de tu biblioteca. Puedes ponerla en tu cementerio.', 'type': 'Criatura — Zombie', 'flavor': 'Cuando los cátaros llegaron al laboratorio abandonado, se encontraron muchos proyectos sin acabar mordiéndose los unos a los otros.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535452&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '2b1a2e5d-f236-4171-924b-0c67f315ffa5', 'multiverseId': 535452}, 'multiverseid': 535452}, {'name': 'Zombie du cellier', 'text': 'Défenseur\\nEngagez trois créatures dégagées que vous contrôlez : Regardez la carte du dessus de votre bibliothèque. Vous pouvez la mettre dans votre cimetière.', 'type': 'Créature : zombie', 'flavor': 'Arrivés au laboratoire abandonné, les cathares découvrirent plusieurs projets inachevés en train de se ronger mutuellement.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535768&type=card', 'language': 'French', 'identifiers': {'scryfallId': '96642e92-44fa-42a6-a5f4-2c24f829aea0', 'multiverseId': 535768}, 'multiverseid': 535768}, {'name': 'Zombie della Dispensa', 'text': 'Difensore\\nTAPpa tre creature STAPpate che controlli: Guarda la prima carta del tuo grimorio. Puoi metterla nel tuo cimitero.', 'type': 'Creatura — Zombie', 'flavor': 'Quando i catari giunsero al laboratorio abbandonato, trovarono solo i progetti incompleti che si masticavano a vicenda.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536084&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '09a8e0ef-e24b-45a9-9308-f001f69108f5', 'multiverseId': 536084}, 'multiverseid': 536084}, {'name': '食糧庫のゾンビ', 'text': '防衛\\nあなたがコントロールしていてアンタップ状態のクリーチャー３体をタップする：あなたのライブラリーの一番上にあるカード１枚を見る。あなたはそれをあなたの墓地に置いてもよい。', 'type': 'クリーチャー — ゾンビ', 'flavor': '聖戦士が廃研究所で見たのは、お互いにかじりついている未完の実験体の数々だった。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536400&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '0ae3822d-7acd-41db-a51a-27819fa68c0f', 'multiverseId': 536400}, 'multiverseid': 536400}, {'name': '식품저장실 좀비', 'text': '수비태세\\n당신이 조종하는 언탭된 생물 세 개를 탭한다: 당신의 서고 맨 위 카드를 본다. 당신은 그 카드를 당신의 무덤에 넣을 수 있다.', 'type': '생물 — 좀비', 'flavor': '버려진 실험실에 도착한 성전사들은 수많은 미완성 프로젝트들이 서로를 갉아먹고 있는 것을 발견했다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536716&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'eadddcf0-65c5-4108-91a9-5238c5869fb1', 'multiverseId': 536716}, 'multiverseid': 536716}, {'name': 'Zumbi da Despensa', 'text': 'Defensor\\nVire três criaturas desviradas que você controla: Olhe o card do topo de seu grimório. Você pode colocá-lo em seu cemitério.', 'type': 'Criatura — Zumbi', 'flavor': 'Quando os cátaros chegaram no laboratório abandonado encontraram vários projetos inacabados mordiscando-se uns aos outros.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537032&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '791957ba-2c60-4be3-81f2-eb2ed15c3972', 'multiverseId': 537032}, 'multiverseid': 537032}, {'name': 'Зомби из Кладовой', 'text': 'Защитник\\nПоверните три неповернутых существа под вашим контролем: посмотрите верхнюю карту вашей библиотеки. Вы можете положить ее на ваше кладбище.', 'type': 'Существо — Зомби', 'flavor': 'Прибыв в заброшенную лабораторию, катары нашли множество незавершенных проектов, жадно грызущих друг друга.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537348&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '00d10b0a-c91c-42de-b7f7-7fe4853765e1', 'multiverseId': 537348}, 'multiverseid': 537348}, {'name': '食橱灵俑', 'text': '守军\\n横置三个由你操控且未横置的生物：检视你的牌库顶牌。你可以将它置入你的坟墓场。', 'type': '生物 ～灵俑', 'flavor': '护教军来到废弃实验室，只发现许多未完成的作品在互相啃食。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537664&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '3ecf83b8-d641-4cbb-9d2b-75055e284f49', 'multiverseId': 537664}, 'multiverseid': 537664}, {'name': '食櫥殭屍', 'text': '守軍\\n橫置三個由你操控且未橫置的生物：檢視你的牌庫頂牌。你可以將它置入你的墳墓場。', 'type': '生物 ～殭屍', 'flavor': '護教軍來到廢棄實驗室，只發現許多未完成的作品在互相啃食。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537980&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'e6316864-7143-4785-91a2-cd25fad8cdf0', 'multiverseId': 537980}, 'multiverseid': 537980}]", '[{\'name\': \'Vorreiter von Odric\', \'text\': \'Immer wenn der Vorreiter von Odric oder eine andere Kreatur, die du kontrollierst, stirbt, lege eine +1/+1-Marke auf eine Kreatur deiner Wahl, die du kontrollierst.\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': \'Begriffe wie „sichere Route" und „geräumter Bezirk" wecken den Galgenhumor der Katharer, die in den Ruinen von Thraben patrouillieren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535103&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f2f1102b-055f-4737-b9b3-621bb3f2d407\', \'multiverseId\': 535103}, \'multiverseid\': 535103}, {\'name\': \'Batidor de Odric\', \'text\': \'Siempre que el Batidor de Odric u otra criatura que controlas muera, pon un contador +1/+1 sobre la criatura objetivo que controlas.\', \'type\': \'Criatura — Caballero humano\', \'flavor\': \'Las palabras "ruta segura" o "distrito despejado" son fuentes de humor negro para los cátaros que patrullan las ruinas de Thraben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535419&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4828935f-c669-4c5e-bd06-41b94222ebd5\', \'multiverseId\': 535419}, \'multiverseid\': 535419}, {\'name\': "Cavalier d\'Odric", \'text\': "À chaque fois que le Cavalier d\'Odric ou une autre créature que vous contrôlez meurt, mettez un marqueur +1/+1 sur une créature ciblée que vous contrôlez.", \'type\': \'Créature : humain et chevalier\', \'flavor\': "Des expressions telles que « chemin sûr » et « quartier sécurisé » sont sources d\'humour noir pour les cathares patrouillant dans les ruines de Thraben.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=535735&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b158b6e1-e6af-4211-b54d-28728704dece\', \'multiverseId\': 535735}, \'multiverseid\': 535735}, {\'name\': \'Apripista di Odric\', \'text\': "Ogniqualvolta l\'Apripista di Odric o un\'altra creatura che controlli muore, metti un segnalino +1/+1 su una creatura bersaglio che controlli.", \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': \'Espressioni come "strada sicura" e "distretto sgombero" sono fonte di macabro umorismo per i catari che pattugliano le rovine di Thraben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536051&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'15ad08bd-84b4-4e03-97d8-64290003fa67\', \'multiverseId\': 536051}, \'multiverseid\': 536051}, {\'name\': \'オドリックの先導\', \'text\': \'オドリックの先導かあなたがコントロールしていてこれでないクリーチャー１体が死亡するたび、あなたがコントロールしているクリーチャー１体を対象とする。それの上に＋１/＋１カウンター１個を置く。\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': \'「安全な道筋」や「浄化地区」などという言葉はスレイベンの遺跡を巡回する聖戦士の間では皮肉な戯言の源である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536367&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'858b24f0-6c67-4267-a885-57684a562e03\', \'multiverseId\': 536367}, \'multiverseid\': 536367}, {\'name\': \'오드릭의 선두 기수\', \'text\': \'오드릭의 선두 기수 또는 당신이 조종하는 다른 생물이 죽을 때마다, 당신이 조종하는 생물을 목표로 정한다. 그 생물에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 인간 기사\', \'flavor\': \'"안전한 경로"나 "확실한 구획" 같은 용어는 트레이벤의 폐허들을 순찰하는 성전사들이 말하는 어두운 농담거리의 소재가 되어 준다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536683&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'22a314b0-56a2-454e-bf70-18f547236189\', \'multiverseId\': 536683}, \'multiverseid\': 536683}, {\'name\': \'Vanguardeiro de Odric\', \'text\': \'Toda vez que Vanguardeiro de Odric ou outra criatura que você controla morrer, coloque um marcador +1/+1 na criatura alvo que você controla.\', \'type\': \'Criatura — Humano Cavaleiro\', \'flavor\': \'Termos como "caminho seguro" e "distrito limpo" são uma das fontes do humor negro dos cátaros que patrulham as ruínas de Thraben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=536999&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e210e420-25f9-4842-938e-2459d3952b51\', \'multiverseId\': 536999}, \'multiverseid\': 536999}, {\'name\': \'Разъездчик Одрика\', \'text\': \'Каждый раз, когда Разъездчик Одрика или другое существо под вашим контролем умирает, положите один жетон +1/+1 на целевое существо под вашим контролем.\', \'type\': \'Существо — Человек Рыцарь\', \'flavor\': \'Такие понятия, как «безопасный маршрут» и «очищенный район», для катаров, патрулирующих развалины Трейбена, являются лишь источником мрачных шуток.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537315&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4a34dcf1-845e-4703-a6fb-159622143e0e\', \'multiverseId\': 537315}, \'multiverseid\': 537315}, {\'name\': \'欧吉克的前导兵\', \'text\': \'每当欧吉克的前导兵或另一个由你操控的生物死去时，在目标由你操控的生物上放置一个+1/+1指示物。\', \'type\': \'生物 ～人类／骑士\', \'flavor\': \'像「安全路线」、「区域无事」这样的回报，都是巡守瑟班遗迹的护教军口中黑色幽默的来源。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537631&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fcf2df6d-3cbf-4466-80fa-e7d37102ad65\', \'multiverseId\': 537631}, \'multiverseid\': 537631}, {\'name\': \'歐吉克的前導兵\', \'text\': \'每當歐吉克的前導兵或另一個由你操控的生物死去時，在目標由你操控的生物上放置一個+1/+1指示物。\', \'type\': \'生物 ～人類／騎士\', \'flavor\': \'像「安全路線」、「區域無事」這樣的回報，都是巡守瑟班遺跡的護教軍口中黑色幽默的來源。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=537947&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9a33e864-7b74-4c11-adc2-41e7d96e1181\', \'multiverseId\': 537947}, \'multiverseid\': 537947}]', "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538245&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e078824d-b411-4726-8e1e-83f9275c4415', 'multiverseId': 538245}, 'multiverseid': 538245}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538255&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '8f4c90a8-b352-4aec-b10e-9e4d74015d21', 'multiverseId': 538255}, 'multiverseid': 538255}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538265&type=card', 'language': 'French', 'identifiers': {'scryfallId': '74c18090-e53f-4d45-9180-0d5157b6eb34', 'multiverseId': 538265}, 'multiverseid': 538265}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=538275&type=card', 'language': 