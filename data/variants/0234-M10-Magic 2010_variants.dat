.com/Handlers/Image.ashx?multiverseid=199787&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a62d7580-87bb-4939-9078-4314eb2ddf97', 'multiverseId': 199787}, 'multiverseid': 199787}, {'name': 'Llanura', 'type': 'Tierra básica — Llanura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200783&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'df4bb83e-229e-4472-b6bb-e523945bc35d', 'multiverseId': 200783}, 'multiverseid': 200783}, {'name': 'Plaine', 'type': 'Terrain de base : plaine', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199538&type=card', 'language': 'French', 'identifiers': {'scryfallId': '0084c76e-e38f-4198-b459-2516cf6f8643', 'multiverseId': 199538}, 'multiverseid': 199538}, {'name': 'Pianura', 'type': 'Terra Base — Pianura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200534&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a7f8e46c-d11a-4630-9213-2f6b50b20cf9', 'multiverseId': 200534}, 'multiverseid': 200534}, {'name': '平地', 'type': '基本土地 — 平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200036&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f0742c42-c83a-45cc-8222-7fcee90e6c63', 'multiverseId': 200036}, 'multiverseid': 200036}, {'name': 'Planície', 'type': 'Terreno Básico — Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199289&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3aa829e5-9ae1-4aa6-b3f2-9062445f3866', 'multiverseId': 199289}, 'multiverseid': 199289}, {'name': 'Равнина', 'type': 'Базовая Земля — Равнина', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200285&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '110197ee-b47d-4682-b52a-8b462215aa92', 'multiverseId': 200285}, 'multiverseid': 200285}, {'name': '平原', 'type': '基本地～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=201032&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '679e39c7-736e-4b6a-8c4e-673269e1c989', 'multiverseId': 201032}, 'multiverseid': 201032}]", "[{'name': 'Ebene', 'type': 'Standardland — Ebene', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199788&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f5af815d-11b4-40bf-b63d-bcad413b6c5e', 'multiverseId': 199788}, 'multiverseid': 199788}, {'name': 'Llanura', 'type': 'Tierra básica — Llanura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200784&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'f2173a55-2e4e-4b7c-a807-7804b8c4e542', 'multiverseId': 200784}, 'multiverseid': 200784}, {'name': 'Plaine', 'type': 'Terrain de base : plaine', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199539&type=card', 'language': 'French', 'identifiers': {'scryfallId': '07952ee0-9369-4713-ba90-44434a28511b', 'multiverseId': 199539}, 'multiverseid': 199539}, {'name': 'Pianura', 'type': 'Terra Base — Pianura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200535&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '5d0e727e-4006-42f3-8743-cd3ebec2e58a', 'multiverseId': 200535}, 'multiverseid': 200535}, {'name': '平地', 'type': '基本土地 — 平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200037&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '8495746e-df4d-4aa3-9a70-5650f7b84fc3', 'multiverseId': 200037}, 'multiverseid': 200037}, {'name': 'Planície', 'type': 'Terreno Básico — Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199290&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b6631310-492d-4203-9da2-e198c4200162', 'multiverseId': 199290}, 'multiverseid': 199290}, {'name': 'Равнина', 'type': 'Базовая Земля — Равнина', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200286&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'f2e3290f-fd8a-4f56-9fbf-f815c6bdfab5', 'multiverseId': 200286}, 'multiverseid': 200286}, {'name': '平原', 'type': '基本地～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=201033&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '59aa0963-d76d-4621-b0e5-9bbee27f3419', 'multiverseId': 201033}, 'multiverseid': 201033}]", '[{\'name\': \'Ehre der Reinen\', \'text\': \'Weiße Kreaturen, die du kontrollierst, erhalten +1/+1.\', \'type\': \'Verzauberung\', \'flavor\': \'Gemeinsam bildeten die Soldaten eine goldene Klinge, die ihre Gegner zu Boden schickte und der Dunkelheit Wunden schlug.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199571&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'281cdca9-2ae1-44b7-9ab9-175090065fa5\', \'multiverseId\': 199571}, \'multiverseid\': 199571}, {\'name\': \'El honor de los puros\', \'text\': \'Las criaturas blancas que controlas obtienen +1/+1.\', \'type\': \'Encantamiento\', \'flavor\': \'Juntos, los soldados eran como una espada dorada, cortando a los enemigos y dañando la oscuridad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200567&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'02ea6e4b-92b3-4798-95ca-7101b6c19de0\', \'multiverseId\': 200567}, \'multiverseid\': 200567}, {\'name\': \'Honneur des purs\', \'text\': \'Les créatures blanches que vous contrôlez gagnent +1/+1.\', \'type\': \'Enchantement\', \'flavor\': "Ensemble, les soldats fonctionnaient comme une lame dorée qui tranchait l\'ennemi et déchirait les ténèbres.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199322&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'28f468a6-e0c7-41a7-98a0-6419d2cb1649\', \'multiverseId\': 199322}, \'multiverseid\': 199322}, {\'name\': \'Onore dei Puri\', \'text\': \'Le creature bianche che controlli prendono +1/+1.\', \'type\': \'Incantesimo\', \'flavor\': "Insieme i soldati erano come una lama dorata, che abbatte i nemici e sfregia l\'oscurità.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200318&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6d0953ba-1bfa-40af-9668-79107c8b24cc\', \'multiverseId\': 200318}, \'multiverseid\': 200318}, {\'name\': \'清浄の名誉\', \'text\': \'あなたがコントロールする白のクリーチャーは＋１/＋１の修整を受ける。\', \'type\': \'エンチャント\', \'flavor\': \'兵士達が揃って敵を切り倒し闇を切りひらく様は、まるで黄金の刃のようだった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199820&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1b72dc3f-6529-4a9b-b13e-72bf4cebf29d\', \'multiverseId\': 199820}, \'multiverseid\': 199820}, {\'name\': \'Honra do Puro\', \'text\': \'As criaturas brancas que você controla recebem +1/+1.\', \'type\': \'Encantamento\', \'flavor\': \'Juntos, os soldados eram como uma lâmina dourada que cortava seus inimigos e aniquilava a escuridão.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199073&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6b48bf41-3dfc-42ad-8c5b-1d232c779bdc\', \'multiverseId\': 199073}, \'multiverseid\': 199073}, {\'name\': \'Благородство Непорочных\', \'text\': \'Белые существа под вашим контролем получают +1/+1.\', \'type\': \'Чары\', \'flavor\': \'Вместе солдаты были золотым клинком, разящим врагов и увечащим тьму.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200069&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'59297644-95a1-49d2-b741-b5edee56def7\', \'multiverseId\': 200069}, \'multiverseid\': 200069}, {\'name\': \'纯净荣耀\', \'text\': \'由你操控的白色生物得+1/+1。\', \'type\': \'结界\', \'flavor\': \'团结一心的士兵有如金锋，能斩尽敌人、剿灭黑暗。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200816&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fd7d3878-e145-4c99-8b1e-37dd3315750b\', \'multiverseId\': 200816}, \'multiverseid\': 200816}]', '[{\'name\': \'Eichengestalt\', \'text\': \'Kreaturenverzauberung\\nDie verzauberte Kreatur erhält +3/+3.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Wenn eine Bestie sich in einer mächtigen Eiche versteckt, wofür benötigt man dann einen Bogen? Wenn sich die Eiche selbst um das knurrende Untier legt, wofür braucht man dann eine Axt?" —Dionus, Elfischer Erzdruide\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199752&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'50243dc0-d62c-49e4-b2a2-cfbe23332ddf\', \'multiverseId\': 199752}, \'multiverseid\': 199752}, {\'name\': \'Forma de roble\', \'text\': \'Encantar criatura.\\nLa criatura encantada obtiene +3/+3.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"Cuando la bestia se cubre con el poderoso roble, ¿de qué sirve un arco? Cuando el roble rodea a la bestia, ¿de qué sirve un hacha?" —Dionus, archidruida élfico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200748&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d2279294-6daa-4507-b14a-8d0f6fea542e\', \'multiverseId\': 200748}, \'multiverseid\': 200748}, {\'name\': \'Forme du chêne\', \'text\': \'Enchanter : créature\\nLa créature enchantée gagne +3/+3.\', \'type\': \'Enchantement : aura\', \'flavor\': "« Quand la bête s\'enveloppe du puissant chêne, à quoi sert un arc ? Quand le chêne enveloppe la bête mugissante, à quoi sert une hachette ? » —Dionus, archidruide elfe", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199503&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d0e249c6-e697-4bf1-bc12-c59abb6a3e4b\', \'multiverseId\': 199503}, \'multiverseid\': 199503}, {\'name\': \'Forma di Quercia\', \'text\': \'Incanta creatura\\nLa creatura incantata prende +3/+3.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Quando la bestia si nasconde nella quercia possente, cosa te ne fai di un arco? Quando la quercia si avvolge attorno alla bestia ringhiosa, cosa te ne fai di un\\\'accetta?" —Dionus, arcidruido elfico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200499&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6077f0c6-ae15-48c9-87b4-3962c1a563f7\', \'multiverseId\': 200499}, \'multiverseid\': 200499}, {\'name\': \'樫変化\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは＋３/＋３の修整を受ける。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「獣が強き樫の中に身を潜めたとき、弓が何の役に立つのか？ 樫が自らの中に怒れる獣を囲ったとき、斧が何の役に立つのか？」 ――エルフの大ドルイド、ダイオヌス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200001&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7970252a-9f37-4c07-b93a-afe0c5a69796\', \'multiverseId\': 200001}, \'multiverseid\': 200001}, {\'name\': \'Carvalhoforme\', \'text\': \'Encantar criatura\\nA criatura encantada recebe +3/+3.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Quando a besta se veste com o grande carvalho, de que serve uma flecha? Quando o carvalho recobre uma besta raivosa, de que serve um machado?" —Dionus, elfo arqueodruida\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199254&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'45e99c48-5cd9-431a-b376-5fb0bc2db7e4\', \'multiverseId\': 199254}, \'multiverseid\': 199254}, {\'name\': \'Дубовый Облик\', \'text\': \'Зачаровать существо\\nЗачарованное существо получает +3/+3.\', \'type\': \'Чары — Аура\', \'flavor\': \'«Когда зверь оборачивается могучим дубом, разве его сразит лук? Когда дуб оборачивается вокруг рычащего зверя, разве его взять топором?» — Дионус, эльфийский архидруид\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200250&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f1ebfc25-f720-4e8a-80fe-59274250a069\', \'multiverseId\': 200250}, \'multiverseid\': 200250}, {\'name\': \'橡树形体\', \'text\': \'结附于生物\\n所结附的生物得+3/+3。\', \'type\': \'结界～灵气\', \'flavor\': \'「如果野兽藏身在雄伟橡树中，弓岂能奈他何？ 如果橡树有咆哮的野兽护身，斧头岂能奈他何？」 ～妖精高位德鲁伊戴欧诺\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200997&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'594f58de-be35-4101-96e6-472025d57dd9\', \'multiverseId\': 200997}, \'multiverseid\': 200997}]', '[{\'name\': \'Eiskäfig\', \'text\': \'Kreaturenverzauberung\\nDie verzauberte Kreatur kann nicht angreifen oder blocken, und ihre aktivierten Fähigkeiten können nicht aktiviert werden.\\nWenn die verzauberte Kreatur das Ziel eines Zauberspruchs oder einer Fähigkeit wird, zerstöre den Eiskäfig.\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199611&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4a7dee5a-b367-4da2-ad17-ee61edfa0fa7\', \'multiverseId\': 199611}, \'multiverseid\': 199611}, {\'name\': \'Jaula de hielo\', \'text\': \'Encantar criatura.\\nLa criatura encantada no puede atacar o bloquear, y no pueden activarse sus habilidades activadas.\\nCuando la criatura encantada sea objetivo de un hechizo o habilidad, destruye la Jaula de hielo.\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200607&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'eb57ec79-9de7-4311-abce-1e08fdb1dfee\', \'multiverseId\': 200607}, \'multiverseid\': 200607}, {\'name\': \'Cage de glace\', \'text\': "Enchanter : créature\\nLa créature enchantée ne peut ni attaquer ni bloquer et ses capacités activées ne peuvent pas être activées.\\nQuand la créature enchantée devient la cible d\'un sort ou d\'une capacité, détruisez la Cage de glace.", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199362&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e7892357-0f97-4898-837d-71b57b67d949\', \'multiverseId\': 199362}, \'multiverseid\': 199362}, {\'name\': \'Gabbia di Ghiaccio\', \'text\': \'Incanta creatura\\nLa creatura incantata non può attaccare o bloccare e le sue abilità attivate non possono essere attivate.\\nQuando la creatura incantata diventa bersaglio di una magia o abilità, distruggi la Gabbia di Ghiaccio.\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200358&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9e7e7089-678b-457d-b71c-51c423556127\', \'multiverseId\': 200358}, \'multiverseid\': 200358}, {\'name\': \'氷の牢獄\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは攻撃したりブロックしたりできず、それの起動型能力は起動できない。\\nエンチャントされているクリーチャーが呪文や能力の対象になったとき、氷の牢獄を破壊する。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199860&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'75cf2376-dd5c-409e-9d04-e13ff5841cc9\', \'multiverseId\': 199860}, \'multiverseid\': 199860}, {\'name\': \'Jaula Congelada\', \'text\': \'Encantar criatura\\nA criatura encantada não pode atacar nem bloquear e suas habilidades ativadas não podem ser ativadas.\\nQuando a criatura encantada se tornar o alvo de uma mágica ou habilidade, destrua Jaula Congelada.\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199113&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7da3890b-1274-44eb-8ce4-b907eb606f9e\', \'multiverseId\': 199113}, \'multiverseid\': 199113}, {\'name\': \'Ледяная Клетка\', \'text\': \'Зачаровать существо\\nЗачарованное существо не может атаковать или блокировать, и его активируемые способности нельзя активировать.\\nКогда зачарованное существо становится целью заклинания или способности, уничтожьте Ледяную Клетку.\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200109&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fecd113f-80af-428d-a1fc-b06b20275f36\', \'multiverseId\': 200109}, \'multiverseid\': 200109}, {\'name\': \'寒冰槛\', \'text\': \'结附于生物\\n所结附的生物不能进行攻击或阻挡，其起动式异能也不能起动。\\n当所结附的生物成为咒语或异能的目标时，消灭寒冰槛。\', \'type\': \'结界～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200856&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1d0f4b2c-a7e2-4a0c-b3a9-9e775f559bd7\', \'multiverseId\': 200856}, \'multiverseid\': 200856}]', "[{'name': 'Elfischer Erzdruide', 'text': 'Andere Elfen-Kreaturen, die du kontrollierst, erhalten +1/+1.\\n{T}: Erhöhe deinen Manavorrat für jeden Elfen, den du kontrollierst, um {G}.', 'type': 'Kreatur — Elf, Druide', 'flavor': 'Er kennt den Namen jedes Elfen, der in den letzten vier Jahrhunderten geboren wurde. Bedeutender ist, dass alle seinen kennen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199731&type=card', 'language': 'German', 'identifiers': {'scryfallId': '29ed9266-ed11-4cea-8ced-76f3399eb8c6', 'multiverseId': 199731}, 'multiverseid': 199731}, {'name': 'Archidruida élfico', 'text': 'Las otras criaturas Elfo que controlas obtienen +1/+1.\\n{T}: Agrega {G} a tu reserva de maná por cada Elfo que controles.', 'type': 'Criatura — Druida elfo', 'flavor': 'Sabe el nombre de todos los elfos nacidos en los últimos cuatro siglos. Más importante aún, todos conocen el suyo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200727&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ff8d4998-f70c-410e-9fb9-f4a61c8cfb13', 'multiverseId': 200727}, 'multiverseid': 200727}, {'name': 'Archidruide elfe', 'text': 'Les autres créatures Elfe que vous contrôlez gagnent +1/+1.\\n{T} : Ajoutez {G} à votre réserve pour chaque elfe que vous contrôlez.', 'type': 'Créature : elfe et druide', 'flavor': 'Il connaît le nom de chaque elfe né durant les quatre derniers siècles. Mais plus important, tous connaissent le sien.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199482&type=card', 'language': 'French', 'identifiers': {'scryfallId': '421a041c-1b2c-4399-9b25-e3544392734b', 'multiverseId': 199482}, 'multiverseid': 199482}, {'name': 'Arcidruido Elfico', 'text': 'Le altre creature Elfo che controlli prendono +1/+1.\\n{T}: Aggiungi {G} alla tua riserva di mana per ogni Elfo che controlli.', 'type': 'Creatura — Druido Elfo', 'flavor': 'Conosce il nome di tutti gli elfi nati negli ultimi quattro secoli. Ma ancora più importante, loro conoscono il suo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200478&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '9a4ef719-0a52-4631-8455-44b6574cbdd6', 'multiverseId': 200478}, 'multiverseid': 200478}, {'name': 'エルフの大ドルイド', 'text': 'あなたがコントロールする他のエルフ・クリーチャーは＋１/＋１の修整を受ける。\\n{T}：あなたがコントロールするエルフ１体につき、あなたのマナ・プールに{G}を加える。', 'type': 'クリーチャー — エルフ・ドルイド', 'flavor': '彼は、ここ四世紀中に生まれた全てのエルフの名を知っている。 そしてさらに重要なのは、その誰もが彼を知っていることだ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199980&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'd8623918-dc10-48af-9466-c7fe933bb2ef', 'multiverseId': 199980}, 'multiverseid': 199980}, {'name': 'Arqueodruida Elfo', 'text': 'As outras criaturas do tipo Elfo que você controla recebem +1/+1.\\n{T}: Adicione {G} à sua reserva de mana para cada Elfo que você controlar.', 'type': 'Criatura — Elfo Druida', 'flavor': 'Ele sabe o nome de cada elfo nascido nos últimos quatro séculos. E o mais importante, eles todos sabem seu nome.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199233&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8139e7ef-dd52-41ff-a437-0a43be334b22', 'multiverseId': 199233}, 'multiverseid': 199233}, {'name': 'Эльфийский Архидруид', 'text': 'Другие существа-Эльфы под вашим контролем получают +1/+1.\\n{T}: добавьте {G} в ваше хранилище маны за каждого Эльфа под вашем контролем.', 'type': 'Существо — Эльф Друид', 'flavor': 'Он знает имена всех эльфов, родившихся за последние четыре столетия. Что еще более важно, все они знают его имя.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200229&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '95e21852-3f49-401a-9da8-02b35fb27f9b', 'multiverseId': 200229}, 'multiverseid': 200229}, {'name': '妖精高位德鲁伊', 'text': '由你操控的其他妖精生物得+1/+1。\\n{T}：你每操控一个妖精，便加{G}到你的法术力池中。', 'type': '生物～妖精／德鲁伊', 'flavor': '他能说出在过去四世纪中诞生的每个妖精名字。 更重要的是，他们全都认识他。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200976&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '921415f4-d1c9-4c51-a9ee-e5468bc775b7', 'multiverseId': 200976}, 'multiverseid': 200976}]", '[{\'name\': \'Elfischer Pfeifer\', \'text\': \'{G}, {T}: Du kannst eine Kreaturenkarte aus deiner Hand ins Spiel bringen.\', \'type\': \'Kreatur — Elf, Schamane\', \'flavor\': "Aus Gaea wuchs die Welt, und sie war still. Aus Gaea wuchsen die Elfen, und das war\'s dann mit der Ruhe. —Mythos der Elfen", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199732&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'667502d6-b198-4242-a4b4-583488727fb2\', \'multiverseId\': 199732}, \'multiverseid\': 199732}, {\'name\': \'Flautista élfica\', \'text\': \'{G}, {T}: Puedes poner en el campo de batalla una carta de criatura de tu mano.\', \'type\': \'Criatura — Chamán elfo\', \'flavor\': \'De Gaia, creció el mundo, y el mundo estuvo en silencio. De Gaia, crecieron los elfos del mundo, y el mundo dejó de estar el silencio. —Enseñanza élfica\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200728&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e9220fb7-0430-4f6b-9e13-d7230142b1fe\', \'multiverseId\': 200728}, \'multiverseid\': 200728}, {\'name\': \'Joueuse de flûte elfe\', \'text\': \'{G}, {T} : Vous pouvez mettre sur le champ de bataille une carte de créature de votre main.\', \'type\': \'Créature : elfe et shamane\', \'flavor\': \'Gaia créa le monde et il était silencieux. Gaia créa les elfes et il ne le fut plus. —Enseignement elfe\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199483&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'96a8c817-299f-4c91-bd97-b106e01ab5eb\', \'multiverseId\': 199483}, \'multiverseid\': 199483}, {\'name\': \'Pifferaio Elfico\', \'text\': \'{G}, {T}: Puoi mettere sul campo di battaglia una carta creatura dalla tua mano.\', \'type\': \'Creatura — Sciamano Elfo\', \'flavor\': \'Da Gea venne il mondo, e il mondo era silente. Da Gea vennero gli elfi del mondo, e il mondo non fu più in silenzio. —Insegnamento elfico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200479&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e0164aa5-a6c2-4676-8fbd-8b0ee17b1c07\', \'multiverseId\': 200479}, \'multiverseid\': 200479}, {\'name\': \'エルフの笛吹き\', \'text\': \'{G}, {T}：あなたは、あなたの手札にあるクリーチャー・カードを１枚戦場に出してもよい。\', \'type\': \'クリーチャー — エルフ・シャーマン\', \'flavor\': \'ガイアから世界が始まり、世界は静かだった。 ガイアから世界のエルフが生まれ、世界はもはや静かではなくなった。 ――エルフの教え\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199981&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e38f61d3-a21d-4c37-9684-484d4e61cca6\', \'multiverseId\': 199981}, \'multiverseid\': 199981}, {\'name\': \'Elfo Flautista\', \'text\': \'{G}, {T}: Você pode colocar no campo de batalha um card de criatura de sua mão.\', \'type\': \'Criatura — Elfo Xamã\', \'flavor\': \'De Gaia nasceu o mundo, e o mundo era quieto. De Gaia nasceram os elfos do mundo, e o mundo já não mais era quieto. — Ensinamento dos elfos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199234&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a1a565bc-079d-4630-aa74-6bd709d777db\', \'multiverseId\': 199234}, \'multiverseid\': 199234}, {\'name\': \'Эльфийский Дудочник\', \'text\': \'{G}, {T}: вы можете положить карту существа из вашей руки на поле битвы.\', \'type\': \'Существо — Эльф Шаман\', \'flavor\': \'Из Геи возник мир. И была тишина в мире. Из Геи возникли эльфы мира сего. И не стало тишины в мире. — Уроки эльфов\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200230&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dde826fb-5080-495c-9825-ce34f32f930a\', \'multiverseId\': 200230}, \'multiverseid\': 200230}, {\'name\': \'妖精吹笛手\', \'text\': \'{G}，{T}：你可以将一张生物牌从你手上放进战场。\', \'type\': \'生物～妖精／祭师\', \'flavor\': \'盖亚肇生世界，而后世界一片沉寂。 盖亚肇生世界中之妖精，而后世界不再沉寂。 ～妖精教诲\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200977&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8d3aae97-e15e-463e-b045-bc17d3b1a84f\', \'multiverseId\': 200977}, \'multiverseid\': 200977}]', '[{\'name\': \'Elfischer Visionär\', \'text\': \'Wenn der Elfische Visionär ins Spiel kommt, ziehe eine Karte.\', \'type\': \'Kreatur — Elf, Schamane\', \'flavor\': \'Vor jeder größeren Unternehmung sucht ein cylianischer Elf den Rat eines Visionärs, um den Willen der alten Gargantuas zu erfahren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199733&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'287d5e12-a0e0-41d7-bf83-8e0410502cf6\', \'multiverseId\': 199733}, \'multiverseid\': 199733}, {\'name\': \'Visionaria élfica\', \'text\': \'Cuando la Visionaria élfica entre al campo de batalla, roba una carta.\', \'type\': \'Criatura — Chamán elfo\', \'flavor\': \'Antes de una misión, un elfo cyliano busca el consejo de un visionario para conocer la voluntad de los antiguos gargantúa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200729&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'08aacd28-355d-438f-92e4-b28c7125046b\', \'multiverseId\': 200729}, \'multiverseid\': 200729}, {\'name\': \'Visionnaire elfe\', \'text\': \'Quand la Visionnaire elfe arrive sur le champ de bataille, piochez une carte.\', \'type\': \'Créature : elfe et shamane\', \'flavor\': "Avant tout projet d\'importance, un elfe cylian demande conseil à un visionnaire pour connaître la volonté des anciens gargantuesques.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199484&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b7c6b71f-e223-4676-bd18-d0e708988aa4\', \'multiverseId\': 199484}, \'multiverseid\': 199484}, {\'name\': \'Elfa Visionaria\', \'text\': "Quando l\'Elfa Visionaria entra nel campo di battaglia, pesca una carta.", \'type\': \'Creatura — Sciamano Elfo\', \'flavor\': "Prima di ogni grande missione, un\'elfa Cylian cerca la guida di una visionaria per apprendere la volontà degli antichi mastodonti.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200480&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'257463a2-a522-4dfe-b82d-0db4fe124ff7\', \'multiverseId\': 200480}, \'multiverseid\': 200480}, {\'name\': \'エルフの幻想家\', \'text\': \'エルフの幻想家が戦場に出たとき、カードを１枚引く。\', \'type\': \'クリーチャー — エルフ・シャーマン\', \'flavor\': \'どんな大事の前でも、シーリアのエルフは古きガルガンチュアンの意思を聞く幻視者の導きを求める。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199982&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'530de581-0832-4f77-b5b3-750131542936\', \'multiverseId\': 199982}, \'multiverseid\': 199982}, {\'name\': \'Visionário Élfico\', \'text\': \'Quando Visionário Élfico entra no campo de batalha, compre um card.\', \'type\': \'Criatura — Elfo Xamã\', \'flavor\': \'Antes de qualquer decisão importante, um elfo cyliano sempre busca a orientação de um visionário para saber qual a vontade dos anciãos gargantuas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199235&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0db0a1a6-a2d0-4051-845a-31449bc1edb3\', \'multiverseId\': 199235}, \'multiverseid\': 199235}, {\'name\': \'Эльфийский Прорицатель\', \'text\': \'Когда Эльфийский Прорицатель выходит на поле битвы, возьмите карту.\', \'type\': \'Существо — Эльф Шаман\', \'flavor\': \'Перед любым важным делом силийский эльф ищет совета у прорицателя, чтобы узнать волю древних исполинов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200231&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1081dea0-36d6-49d0-8191-2285dd76e958\', \'multiverseId\': 200231}, \'multiverseid\': 200231}, {\'name\': \'妖精幻视师\', \'text\': \'当妖精幻视师进战场时，抓一张牌。\', \'type\': \'生物～妖精／祭师\', \'flavor\': \'在作出任何重大承诺之前，塞利亚妖精会寻求幻视师的指导，好知晓巨兽祖先的意念。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200978&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e713e664-bec6-47b9-9eb0-10966787a915\', \'multiverseId\': 200978}, \'multiverseid\': 200978}]', '[{\'name\': \'Elite-Vorhut\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'Die Vorhut ist in der Lage, einen Kampf alleine zu entscheiden. Der Feind ist oft schon besiegt, bevor die Verstärkungen die Front erreicht haben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199564&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'00f755e9-6ff8-4808-bacf-889837121db6\', \'multiverseId\': 199564}, \'multiverseid\': 199564}, {\'name\': \'Vanguardia de élite\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'La vanguardia sabe cómo luchar una guerra sola. El enemigo normalmente es derrotado antes de que los refuerzos alcancen el frente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200560&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f6169add-001c-4ba8-bad3-8cc10b00a6c2\', \'multiverseId\': 200560}, \'multiverseid\': 200560}, {\'name\': "Avant-garde d\'élite", \'type\': \'Créature : humain et soldat\', \'flavor\': "L\'avant-garde sait faire la guerre seule. L\'ennemi est souvent vaincu avant que ses renforts n\'atteignent le front.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199315&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a7057661-2798-44e7-bc0a-18cd5dd44a58\', \'multiverseId\': 199315}, \'multiverseid\': 199315}, {\'name\': "Avanguardia d\'Elite", \'type\': \'Creatura — Soldato Umano\', \'flavor\': "L\'avanguardia è specializzata nel muovere guerra da sola. Il nemico viene spesso sconfitto prima che i rinforzi raggiungano il fronte.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200311&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'79450a76-1f46-46c4-b797-cff3352426da\', \'multiverseId\': 200311}, \'multiverseid\': 200311}, {\'name\': \'先兵の精鋭\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'先兵は、一人で戦場を賄える技量を持っている。 援軍が前線に達するよりも先に相手が倒されていることもしばしばだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199813&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e55dae0a-a7ef-43f7-a9b7-3cf295d3bf68\', \'multiverseId\': 199813}, \'multiverseid\': 199813}, {\'name\': \'Vanguarda de Elite\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': \'A vanguarda sabe bem como travar a guerra sozinha. Não é raro que o inimigo seja derrotado antes que seus reforços cheguem ao fronte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199066&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2f6ac94e-7756-41a7-8357-d753cb0f9fcf\', \'multiverseId\': 199066}, \'multiverseid\': 199066}, {\'name\': \'Элитный Авангард\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'Передовые отряды умело сражаются в одиночку. Зачастую враг терпит поражение еще до того, как подкрепление достигнет фронта.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200062&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e0524721-8093-48d8-817b-dbd185bc0812\', \'multiverseId\': 200062}, \'multiverseid\': 200062}, {\'name\': \'菁英先锋\', \'type\': \'生物～人类／士兵\', \'flavor\': \'先锋对于自行作战相当拿手。 敌人经常在后援部队赶到前就给打败。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200809&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5ad9c464-d5d7-4e86-b73c-0f45520dac6d\', \'multiverseId\': 200809}, \'multiverseid\': 200809}]', '[{\'name\': \'Engelsfeder\', \'text\': \'Immer wenn ein Spieler einen weißen Zauberspruch wirkt, kannst du 1 Lebenspunkt dazuerhalten.\', \'type\': \'Artefakt\', \'flavor\': \'Wird sie genommen, schneidet sie die Hand, die sie ergreift. Wird sie gegeben, heilt sie die Hand, die sie hält.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199761&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e323cd65-195a-45fb-b31c-e42b1b4cf77a\', \'multiverseId\': 199761}, \'multiverseid\': 199761}, {\'name\': \'Pluma de ángel\', \'text\': \'Siempre que un jugador lance un hechizo blanco, puedes ganar 1 vida.\', \'type\': \'Artefacto\', \'flavor\': \'Si es tomada, corta la mano que la agarra. Si es dada, cura la mano que la sostiene.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200757&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b1af7eed-fdf7-4843-a873-a097bdca51d8\', \'multiverseId\': 200757}, \'multiverseid\': 200757}, {\'name\': "Plume d\'ange", \'text\': "À chaque fois qu\'un joueur lance un sort blanc, vous pouvez gagner 1 point de vie.", \'type\': \'Artefact\', \'flavor\': \'Volée, elle tranche la main qui la serre. Donnée, elle soigne la main qui la tient.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199512&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'85554935-b8a4-4366-bb76-63530933736c\', \'multiverseId\': 199512}, \'multiverseid\': 199512}, {\'name\': "Piuma d\'Angelo", \'text\': \'Ogniqualvolta un giocatore lancia una magia bianca, puoi guadagnare 1 punto vita.\', \'type\': \'Artefatto\', \'flavor\': "Se viene presa, taglia la mano che l\'afferra. Se viene donata, cura la mano che la stringe.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200508&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3f21cb72-fe9c-421e-a36e-4bf152d58d1d\', \'multiverseId\': 200508}, \'multiverseid\': 200508}, {\'name\': \'天使の羽根\', \'text\': \'いずれかのプレイヤーが白の呪文を唱えるたび、あなたは１点のライフを得てもよい。\', \'type\': \'アーティファクト\', \'flavor\': \'抜かば、その掴みし手を切る。 与わば、その持ちし手を癒す。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200010&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1cf3a66d-a4d4-4946-bb84-96f55d7db416\', \'multiverseId\': 200010}, \'multiverseid\': 200010}, {\'name\': \'Pluma de Anjo\', \'text\': \'Toda vez que um jogador conjurar uma mágica branca, você pode ganhar 1 ponto de vida.\', \'type\': \'Artefato\', \'flavor\': \'Se for arrancada, corta a mão de quem a roubou. Se for concedida, cura a mão de quem a segurou.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199263&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'668d458b-302b-451d-bba7-219ead25c04e\', \'multiverseId\': 199263}, \'multiverseid\': 199263}, {\'name\': \'Перо Ангела\', \'text\': \'Каждый раз, когда игрок разыгрывает белое заклинание, вы можете получить 1 жизнь.\', \'type\': \'Артефакт\', \'flavor\': \'Оно порежет руку того, кто силой его захватит. Оно исцелит руку того, кому будет даровано.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200259&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'17cf74f5-60a4-47cd-8ff5-40b2fbac22bb\', \'multiverseId\': 200259}, \'multiverseid\': 200259}, {\'name\': \'天使翎羽\', \'text\': \'每当牌手施放任何白色咒语时，你可以获得1点生命。\', \'type\': \'神器\', \'flavor\': \'若遭冒犯，它将划破强夺之手。 若系馈送，它将治愈领受之手。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=201006&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6e17f39e-a0c0-46a4-aa2a-8d13a2979360\', \'multiverseId\': 201006}, \'multiverseid\': 201006}]', '[{\'name\': \'Entzündete Wut\', \'text\': \'Eine Kreatur deiner Wahl erhält +1/+0 und Erstschlag bis zum Ende des Zuges. (Sie fügt Kampfschaden vor Kreaturen ohne Erstschlag zu.)\', \'type\': \'Spontanzauber\', \'flavor\': \'„Zorn ist eine gefährliche Waffe. Deine Feinde werden versuchen, deine Wut gegen dich zu verwenden. Lasse sie lieber an ihnen aus." —Ajani Goldmähne\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199699&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1d9a141e-d070-4954-a7f4-d723be037e01\', \'multiverseId\': 199699}, \'multiverseid\': 199699}, {\'name\': \'Furia encendida\', \'text\': \'La criatura objetivo obtiene +1/+0 y gana la habilidad de dañar primero hasta el final del turno. (Hace daño de combate antes que las criaturas sin la habilidad de dañar primero.)\', \'type\': \'Instantáneo\', \'flavor\': \'"La ira es un arma peligrosa. Tus enemigos intentarán usar tu furia contra ti. Úsala contra ellos antes." —Ajani Melena Dorada\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200695&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3810c6f8-a3b6-4bac-825e-eb40e0dcb3a3\', \'multiverseId\': 200695}, \'multiverseid\': 200695}, {\'name\': \'Fureur embrasée\', \'text\': "La créature ciblée gagne +1/+0 et acquiert l\'initiative jusqu\'à la fin du tour. (Elle inflige des blessures de combat avant les créatures sans l\'initiative.)", \'type\': \'Éphémère\', \'flavor\': \'« La rage est une arme dangereuse. Tes ennemis essaieront de retourner ta propre colère contre toi. Devance-les. » —Ajani Crinièredor\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199450&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bd8c4bf5-0863-4fca-8645-95e9971919f4\', \'multiverseId\': 199450}, \'multiverseid\': 199450}, {\'name\': \'Furia Scatenata\', \'text\': \'Una creatura bersaglio prende +1/+0 e ha attacco improvviso fino alla fine del turno. (Infligge danno da combattimento prima delle creature senza attacco improvviso.)\', \'type\': \'Istantaneo\', \'flavor\': \'"La rabbia è un\\\'arma pericolosa. I tuoi nemici tenteranno di usare la tua ira contro di te. Usala per primo contro di loro." —Ajani Criniera D\\\'Oro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200446&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7531a656-58ad-4f90-b922-c7df55c4f5ce\', \'multiverseId\': 200446}, \'multiverseid\': 200446}, {\'name\': \'火をつける怒り\', \'text\': \'クリーチャー１体を対象とする。それはターン終了時まで＋１/＋０の修整を受けるとともに先制攻撃を得る。 （それは先制攻撃を持たないクリーチャーよりも先に戦闘ダメージを与える。）\', \'type\': \'インスタント\', \'flavor\': \'「怒りは危険な武器だ。 敵はお前の怒りがお前に向かうようにしてくるだろう。 まず奴らに対して使うことだ。」 ――黄金のたてがみのアジャニ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199948&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'581e120c-5c1d-48c4-934e-e76e2bbf5d29\', \'multiverseId\': 199948}, \'multiverseid\': 199948}, {\'name\': \'Fúria Inflamada\', \'text\': \'A criatura alvo recebe +1/+0 e ganha iniciativa até o final do turno. (Ela causa dano antes de criaturas sem a habilidade de iniciativa.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"A ira é uma arma poderosa. Seus inimigos tentarão usar sua raiva contra você. Use-a primeiro contra eles." —Ajani Juba D\\\'ouro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199201&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7f7b3d2d-8759-4cb5-ae4d-0ad122d1bebc\', \'multiverseId\': 199201}, \'multiverseid\': 199201}, {\'name\': \'Вспыхнувшая Ярость\', \'text\': \'Целевое существо получает +1/+0 и Первый удар до конца хода. (Оно наносит боевые повреждения раньше существ без Первого удара.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Ярость — опасное оружие. Враги попытаются использовать твой гнев против тебя. Так что направь его против них первым». — Златогривый Аджани\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200197&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2652d718-d801-4cfa-b360-c7a5587c6126\', \'multiverseId\': 200197}, \'multiverseid\': 200197}, {\'name\': \'点燃怒火\', \'text\': \'目标生物得+1/+0且获得先攻异能直到回合结束。 （它会比不具先攻异能的生物提前造成战斗伤害。）\', \'type\': \'瞬间\', \'flavor\': \'「怒火是个危险武器。 敌人会利用你的愤怒来对抗你。 该先拿来对付他们。」 ～金鬃阿耶尼\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200944&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d296a497-cdc2-4598-b46d-ce9a42a0bd7c\', \'multiverseId\': 200944}, \'multiverseid\': 200944}]', '[{\'name\': \'Erbarmen des Engels\', \'text\': \'Du erhältst 7 Lebenspunkte dazu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Bis zu jenem Tage hatte ich die Engel immer verflucht, diese gleichgültigen Lichter am Himmel. Doch sie belohnten meinen Groll mit geschenkter Zeit, und jedes dieser Jahre habe ich ihren Namen gewidmet." —Torian Sha, Seelenbewahrerin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199557&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2be73bcf-5a1a-4801-b98d-2458d5c6f75b\', \'multiverseId\': 199557}, \'multiverseid\': 199557}, {\'name\': \'Piedad del ángel\', \'text\': \'Gana 7 vidas.\', \'type\': \'Instantáneo\', \'flavor\': \'"Hasta ese día maldije a los ángeles, aquellas luces despreocupadas en el cielo. Ellos recompensaron mi desdén con el regalo del tiempo, y lo he dedicado todo a sus nombres." —Torian Sha, protectora de almas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200553&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6acb91a3-9e09-4837-a032-10fdfd3f386f\', \'multiverseId\': 200553}, \'multiverseid\': 200553}, {\'name\': \'Miséricorde des anges\', \'text\': \'Vous gagnez 7 points de vie.\', \'type\': \'Éphémère\', \'flavor\': "« Jusqu\'à ce jour j\'avais maudit l\'indifférence de ces astres célestes que sont les anges. Mais ils ont récompensé mon mépris par le don du temps. Je le consacre désormais à leur nom. » —Torian Sha, garde des âmes", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199308&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'61512a5a-e2e1-41a7-8762-80221f67f324\', \'multiverseId\': 199308}, \'multiverseid\': 199308}, {\'name\': "Clemenza dell\'Angelo", \'text\': \'Guadagni 7 punti vita.\', \'type\': \'Istantaneo\', \'flavor\': \'"Fino a quel giorno ho maledetto gli angeli, quelle luci indifferenti nel cielo. Hanno ricompensato il mio disprezzo col dono del tempo, e da allora ogni anno l\\\'ho speso in completa dedizione ai loro nomi." —Torian Sha, guardiana dell\\\'anima\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200304&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'59154035-d28e-458c-8c9e-590733b2d8fe\', \'multiverseId\': 200304}, \'multiverseid\': 200304}, {\'name\': \'天使の慈悲\', \'text\': \'あなたは７点のライフを得る。\', \'type\': \'インスタント\', \'flavor\': \'「その日が来るまで、私は空に輝く冷淡な光の天使達を呪っていました。 彼らは私の嘲笑に対して、時の長さを与えることで応えたのです。以来私は、毎年彼らの名の下に身を捧ぐようになったのです。」 ――魂の管理人、トーリアン・シャア\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199806&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b519c6a4-22d5-429a-9b86-09a08c591550\', \'multiverseId\': 199806}, \'multiverseid\': 199806}, {\'name\': \'Misericórdia de Anjo\', \'text\': \'Você ganha 7 pontos de vida.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Até então eu amaldiçoara os anjos, aqueles pontos de luz indiferentes no céu. Eles recompensaram meu desdém presenteando-me com tempo, e cada ano ganho gastei em sua devoção." —Torian Sha, encarregado das almas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199059&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'08d042ae-ad78-4f2a-90dc-7507b27a7689\', \'multiverseId\': 199059}, \'multiverseid\': 199059}, {\'name\': \'Милосердие Ангела\', \'text\': \'Вы получаете 7 жизней.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«До того дня я проклинала ангелов, эти равнодушные огни в небе. Они же вознаградили мое презрение даром времени, каждый год которого я провожу в почитании их имен». — Ториан Ша, стражница души\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200055&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'89bc8bb0-0e95-4740-a1cc-2de64d4d6a86\', \'multiverseId\': 200055}, \'multiverseid\': 200055}, {\'name\': \'天使的慈悲\', \'text\': \'你获得7点生命。\', \'type\': \'瞬间\', \'flavor\': \'「直到我诅咒天使的那天，他们都只是天上的冷酷光芒。 他们却以时间来回赠我的轻蔑，我所度过的每个年头都将为其奉献。」 ～护灵师朵莉恩•夏\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200802&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0a9cdfb7-669a-4010-beac-d27cd2701218\', \'multiverseId\': 200802}, \'multiverseid\': 200802}]', "[{'name': 'Erdbeben', 'text': 'Das Erdbeben fügt allen Spielern und allen nichtfliegenden Kreaturen X Schadenspunkte zu.', 'type': 'Hexerei', 'flavor': 'Wie Kiesel, die in einen Brunnen geworfen werden, fielen sie schreiend in die Kluft, die sich geöffnet hatte.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199689&type=card', 'language': 'German', 'identifiers': {'scryfallId': '89642129-d460-457f-8ba6-11475a650454', 'multiverseId': 199689}, 'multiverseid': 199689}, {'name': 'Terremoto', 'text': 'El Terremoto hace X puntos de daño a cada criatura que no tenga la habilidad de volar y a cada jugador.', 'type': 'Conjuro', 'flavor': 'Cayeron gritando a las profundidades del abismo como guijarros arrojados a un pozo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200685&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '06d69a65-a7b8-4e08-9b86-77c611b091ba', 'multiverseId': 200685}, 'multiverseid': 200685}, {'name': 'Tremblement de terre', 'text': 'Le Tremblement de terre inflige X blessures à chaque créature sans le vol et à chaque joueur.', 'type': 'Rituel', 'flavor': 'Ils tombèrent en hurlant dans les profondeurs de la faille comme des cailloux jetés dans un puits.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199440&type=card', 'language': 'French', 'identifiers': {'scryfallId': '793f07c5-ade3-47ad-b8af-d19b018b8f09', 'multiverseId': 199440}, 'multiverseid': 199440}, {'name': 'Terremoto', 'text': 'Il Terremoto infligge X danni a ogni creatura senza volare e a ogni giocatore.', 'type': 'Stregoneria', 'flavor': 'Caddero urlando nelle profondità del baratro come tanti sassolini lanciati in un pozzo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200436&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b77baa56-f6ab-478f-88c3-cb35a7c0dcad', 'multiverseId': 200436}, 'multiverseid': 200436}, {'name': '地震', 'text': '地震は飛行を持たない各クリーチャーと各プレイヤーにそれぞれＸ点のダメージを与える。', 'type': 'ソーサリー', 'flavor': '彼らはまるで井戸に投げ込まれたたくさんの小石のように、叫びながら地割れの深みに落ちていった。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199938&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '6bfbefe1-b0ac-4ad6-86b1-3d07130cb7d7', 'multiverseId': 199938}, 'multiverseid': 199938}, {'name': 'Terremoto', 'text': 'Terremoto causa X pontos de dano a cada criatura sem a habilidade de voar e a cada jogador.', 'type': 'Feitiço', 'flavor': 'Eles caíram urrando nas profundezas do abismo como pedrinhas atiradas em um poço.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199191&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2a69fd59-46e2-4c52-a468-37c3d07ad153', 'multiverseId': 199191}, 'multiverseid': 199191}, {'name': 'Землетрясение', 'text': 'Землетрясение наносит X повреждений каждому существу без Полета и каждому игроку.', 'type': 'Волшебство', 'flavor': 'С криками они полетели в бездну, словно брошенная в колодец пригоршня камней.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200187&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '96a9d40b-44e0-45b2-a1c4-5595e509ef40', 'multiverseId': 200187}, 'multiverseid': 200187}, {'name': '地震', 'text': '地震对每位牌手与每个不具飞行异能的生物各造成X点伤害。', 'type': '法术', 'flavor': '他们尖叫着掉进断层深处，好像把一堆小石头丢进井里一样。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200934&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c973caea-d5c1-4270-b9f7-69f2dd87136c', 'multiverseId': 200934}, 'multiverseid': 200934}]", '[{\'name\': \'Erfahrener Plattner\', \'text\': \'Andere Soldaten-Kreaturen, die du kontrollierst, erhalten +0/+1.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'„Mut ist ein stolzer und glänzender Schild. Er verbiegt sich nicht und verbirgt nichts. Um mit Mut zu kämpfen, müssen wir ihn in Stahl hüllen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199593&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8eb5efbf-168d-4b1c-966d-571a2c458414\', \'multiverseId\': 199593}, \'multiverseid\': 199593}, {\'name\': \'Forjaescudos veterano\', \'text\': \'Las otras criaturas Soldado que controlas obtienen +0/+1.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'"El valor es un escudo orgulloso y brillante. No se dobla o esconde. Para pelear con valor, debemos forjar con acero."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200589&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b665201b-c7aa-483b-90c6-68283ef014a7\', \'multiverseId\': 200589}, \'multiverseid\': 200589}, {\'name\': \'Maître armurier vétéran\', \'text\': \'Les autres créatures Soldat que vous contrôlez gagnent +0/+1.\', \'type\': \'Créature : humain et soldat\', \'flavor\': "« Le courage est un fier bouclier étincelant. Il ne plie ni se cache. Pour combattre avec courage, nous devons forger l\'acier. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199344&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cecb2ad7-0230-4286-bf09-9edb87ca3ef8\', \'multiverseId\': 199344}, \'multiverseid\': 199344}, {\'name\': \'Fabbro Veterano\', \'text\': \'Le altre creature Soldato che controlli prendono +0/+1.\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'"Il coraggio è uno scudo fiero e splendente. Non si piega e non si nasconde. Per combattere con coraggio, dobbiamo forgiare il metallo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200340&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e1b1a40c-9356-47ee-a3d2-83af7be0363f\', \'multiverseId\': 200340}, \'multiverseid\': 200340}, {\'name\': \'古参兵の鎧鍛冶\', \'text\': \'あなたがコントロールする他の兵士クリーチャーは＋０/＋１の修整を受ける。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'「勇気ってのは名誉と輝きのある盾だ。 よれることもなきゃ、隠れることもない。 勇気を持って戦うにゃ、俺らが鋼を鍛えなくちゃな。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199842&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a7d1cbbd-f8b3-4bba-8031-041f6257f3d8\', \'multiverseId\': 199842}, \'multiverseid\': 199842}, {\'name\': \'Forjador de Armadura Veterano\', \'text\': \'Outras criaturas do tipo Soldado que você controla recebem +0/+1.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': \'"A coragem é um escudo que resplandece. Não se curva nem se oculta. Para lutar com coragem, é preciso forjar o aço."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199095&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c2af129f-641b-439b-87d2-a449d040f6a7\', \'multiverseId\': 199095}, \'multiverseid\': 199095}, {\'name\': \'Ветеран-Кузнец Доспехов\', \'text\': \'Другие существа-Солдаты под вашим контролем получают +0/+1.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'«Отвага — это гордый и сверкающий щит. Он не сгибается и не прячется с глаз. А чтобы сражаться отважно, нужно ковать сталь».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200091&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'85d2073b-f94d-4c8f-9c04-cfbe6b8cea2a\', \'multiverseId\': 200091}, \'multiverseid\': 200091}, {\'name\': \'资深造铠师\', \'text\': \'由你操控的其他士兵生物得+0/+1。\', \'type\': \'生物～人类／士兵\', \'flavor\': \'「勇气就像辉煌而洁净的盾牌。 它不会折弯，也隐藏不住。 为了以勇气作战，我们必须打造钢铁。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200838&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a7dc18d0-839d-4c45-8524-0ad72e244b8a\', \'multiverseId\': 200838}, \'multiverseid\': 200838}]', '[{\'name\': \'Erfahrener Schwertschmied\', \'text\': \'Andere Soldaten-Kreaturen, die du kontrollierst, erhalten +1/+0.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'„Wahrheit ist wie eine ungekrümmte Klinge. Es gibt keine weichen Kanten oder gerundete Ecken. Um für die Wahrheit zu kämpfen, müssen wir sie in Stahl hüllen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199594&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4ec36104-3d18-4ab8-bebc-02f034f784c2\', \'multiverseId\': 199594}, \'multiverseid\': 199594}, {\'name\': \'Forjaespadas veterano\', \'text\': \'Las otras criaturas Soldado que controlas obtienen +1/+0.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'"La verdad es una hoja recta y afilada. No hay ángulos suaves o bordes redondeados. Para pelear por la verdad, debemos forjar con acero."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200590&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b360260e-1932-4660-98bd-509f9b959c67\', \'multiverseId\': 200590}, \'multiverseid\': 200590}, {\'name\': "Forgeuse d\'épées vétérane", \'text\': \'Les autres créatures Soldat que vous contrôlez gagnent +1/+0.\', \'type\': \'Créature : humain et soldat\', \'flavor\': "« La vérité est droite et tranchante. Elle ne connaît ni angles doux ni arrondis. Pour combattre pour la vérité, nous devons forger l\'acier. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199345&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'65ab474b-0891-4778-8f10-45a9e3fff180\', \'multiverseId\': 199345}, \'multiverseid\': 199345}, {\'name\': \'Forgiatrice Veterana\', \'text\': \'Le altre creature Soldato che controlli prendono +1/+0.\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'"La verità è una lama dritta e affilata. Non ci sono angoli molli né tagli arrotondati. Per combattere per la verità, dobbiamo forgiare il metallo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200341&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5ea738c5-e6ac-4ad5-8f5c-8f74d0dc06fd\', \'multiverseId\': 200341}, \'multiverseid\': 200341}, {\'name\': \'古参兵の剣鍛冶\', \'text\': \'あなたがコントロールする他の兵士・クリーチャーは＋１/＋０の修整を受ける。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'「真実ってのは、真っ直ぐな鋭い刃さ。 曲がることもなけりゃ、鈍ることもない。 真実のために戦うんなら、あたしらが鋼を鍛えなくちゃね。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199843&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c180dbe4-8e6b-47f0-bd68-0990da0a6564\', \'multiverseId\': 199843}, \'multiverseid\': 199843}, {\'name\': \'Forjador de Espada Veterano\', \'text\': \'Outras criaturas do tipo Soldado que você controla recebem +1/+0.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': \'"A verdade é uma aresta reta e precisa. Não permite ângulos suaves nem arestas arredondadas. Para lutar pela verdade, é preciso forjar o aço."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199096&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3e0355ba-85a7-463e-b638-20dd280da65d\', \'multiverseId\': 199096}, \'multiverseid\': 199096}, {\'name\': \'Ветеран-Кузнец Мечей\', \'text\': \'Другие существа-Солдаты под вашим контролем получают +1/+0.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'«Правда — это прямой, отточенный клинок. У нее нет тупых углов или закруглений. А чтобы сражаться за правду, нужно ковать сталь».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200092&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b3603a90-2086-4c99-9ec5-a67caa6a5900\', \'multiverseId\': 200092}, \'multiverseid\': 200092}, {\'name\': \'资深造剑师\', \'text\': \'由你操控的其他士兵生物得+1/+0。\', \'type\': \'生物～人类／士兵\', \'flavor\': \'「真理是把直挺的利剑。 上面没有弯角或是钝锋。 为了捍卫真理，我们必须打造钢铁。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200839&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fb021e36-ef1e-4495-9815-24c77c2aec8c\', \'multiverseId\': 200839}, \'multiverseid\': 200839}]', '[{\'name\': \'Erweckender Druide\', \'text\': \'Wenn der Erweckende Druide ins Spiel kommt, wird ein Wald deiner Wahl zu einer 4/5 grünen Baumhirten-Kreatur, solange der Erweckende Druide im Spiel ist. Er ist immer noch ein Land.\', \'type\': \'Kreatur — Mensch, Druide\', \'flavor\': \'Die Druiden von Mazar behandeln jeden Samen mit dem gleichen Respekt wie den Kämpfer, der aus ihm erwachsen wird.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199722&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'14d899c1-3da9-4175-bb31-fe727ae46547\', \'multiverseId\': 199722}, \'multiverseid\': 199722}, {\'name\': \'Druida despertador\', \'text\': \'Cuando el Druida despertador entre al campo de batalla, el bosque objetivo es una criatura Pueblo-arbóreo verde 4/5 mientras el Druida despertador esté en el campo de batalla. Sigue siendo una tierra.\', \'type\': \'Criatura — Druida humano\', \'flavor\': \'Los druidas de Mazar tratan a cada semilla con el respeto del guerrero en el que se convertirá.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200718&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2cc247dd-452f-4bd9-88dc-4775303d9f72\', \'multiverseId\': 200718}, \'multiverseid\': 200718}, {\'name\': \'Druide éveilleur\', \'text\': "Quand le Druide éveilleur arrive sur le champ de bataille, la forêt ciblée devient une créature 4/5 verte Sylvin tant que le Druide éveilleur est sur le champ de bataille. C\'est toujours un terrain.", \'type\': \'Créature : humain et druide\', \'flavor\': "Les druides de Mazar traitent chaque graine avec le respect qu\'ils accorderont au guerrier qu\'elle deviendra.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199473&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f8950b1a-1e4f-47d4-a9d8-6f82ff03a2bd\', \'multiverseId\': 199473}, \'multiverseid\': 199473}, {\'name\': \'Druido del Risveglio\', \'text\': \'Quando il Druido del Risveglio entra nel campo di battaglia, una Foresta bersaglio diventa una creatura Silvantropo 4/5 verde fintanto che il Druido del Risveglio è sul campo di battaglia. È ancora una terra.\', \'type\': \'Creatura — Druido Umano\', \'flavor\': \'I druidi di Mazar trattano ogni pigna con il rispetto dovuto al guerriero che diventerà.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200469&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'939b17fb-59a1-4f11-b8b9-73816b25f88e\', \'multiverseId\': 200469}, \'multiverseid\': 200469}, {\'name\': \'覚醒のドルイド\', \'text\': \'覚醒のドルイドが戦場に出たとき、森１つを対象とする。それは、覚醒のドルイドが戦場に出ているかぎり、緑の４/５のツリーフォーク・クリーチャーになる。 それは土地でもある。\', \'type\': \'クリーチャー — 人間・ドルイド\', \'flavor\': \'マザールのドルイドは、一つ一つの種房に対し、いずれなる戦士として敬意を払う。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199971&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'db98f97c-b3d2-4f8c-abb6-bbd5b9b6742f\', \'multiverseId\': 199971}, \'multiverseid\': 199971}, {\'name\': \'Druida Despertador\', \'text\': \'Quando Druida Despertador entra no campo de batalha, a Floresta alvo torna-se uma criatura verde 4/5 do tipo Ent enquanto Druida Despertador está no campo de batalha. Ela ainda conta como um terreno.\', \'type\': \'Criatura — Humano Druida\', \'flavor\': \'Os druidas de Mazar tratam cada pinha com o respeito devido ao guerreiro que ela se tornará um dia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199224&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'71673708-d7f2-4df3-a71d-4729e0ff940e\', \'multiverseId\': 199224}, \'multiverseid\': 199224}, {\'name\': \'Друид-Пробудитель\', \'text\': \'Когда Друид-Пробудитель выходит на поле битвы, целевой Лес становится существом 4/5 зеленый Лесовик, пока друид-Пробудитель находится на поле битвы. При этом он остается землей.\', \'type\': \'Существо — Человек Друид\', \'flavor\': \'Друиды Мазарского леса почтительно обращаются с каждой шишкой, ведь из нее вырастет славный воин.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200220&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5fcf9f97-ec62-45d4-82ed-4f21105254ce\', \'multiverseId\': 200220}, \'multiverseid\': 200220}, {\'name\': \'醒眠德鲁伊\', \'text\': \'当醒眠德鲁伊进战场时，只要醒眠德鲁伊仍在战场，目标树林便成为4/5绿色的树妖生物。 它仍然是地。\', \'type\': \'生物～人类／德鲁伊\', \'flavor\': \'每一个球果都受到麻栅德鲁伊的敬重，因为终将成为战士。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200967&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d7e3cb90-9884-446a-91b3-36f3f942f2d1\', \'multiverseId\': 200967}, \'multiverseid\': 200967}]', '[{\'name\': \'Essenzzerstäubung\', \'text\': \'Neutralisiere einen Kreaturenzauber deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'Einige Zauberer wetteifern darum, wessen Kreaturen die interessantesten Nacheffekte hinterlassen, wenn die Beschwörung daneben geht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199606&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1e5be5d9-f093-4744-b3fd-4310f6f2f287\', \'multiverseId\': 199606}, \'multiverseid\': 199606}, {\'name\': \'Esparcir la esencia\', \'text\': \'Contrarresta el hechizo objetivo de criatura.\', \'type\': \'Instantáneo\', \'flavor\': \'Algunos hechiceros compiten no por invocar las criaturas más interesantes, sino por crear los efectos más interesantes después de que la invocación sale mal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200602&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9378cd01-5dbc-4311-b3fb-206a24c33a63\', \'multiverseId\': 200602}, \'multiverseid\': 200602}, {\'name\': "Dispersion d\'essence", \'text\': \'Contrecarrez le sort de créature ciblé.\', \'type\': \'Éphémère\', \'flavor\': \'Certains sorciers concourent non pas pour invoquer les créatures les plus intéressantes, mais pour créer les effets secondaires les plus intéressants quand une invocation tourne mal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199357&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cba3f7df-938b-4b96-9e65-dc70ad7599d0\', \'multiverseId\': 199357}, \'multiverseid\': 199357}, {\'name\': \'Disperdere Essenza\', \'text\': \'Neutralizza una magia creatura bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': "Alcuni maghi si sfidano non a evocare le creature più interessanti, ma a creare i più interessanti effetti collaterali quando un\'evocazione impazzisce.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200353&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0ef8764d-f420-4e76-bdf5-ff8f089a3cf6\', \'multiverseId\': 200353}, \'multiverseid\': 200353}, {\'name\': \'本質の散乱\', \'text\': \'クリーチャー呪文１つを対象とし、それを打ち消す。\', \'type\': \'インスタント\', \'flavor\': \'どれだけ興味深い怪物を召喚するかではなく、召喚が間違った方向に行ったときにどれだけ興味深い結果が起こるかを競う魔術師もいる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199855&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ec9592ad-0851-42f1-9a75-e5dddd3c774c\', \'multiverseId\': 199855}, \'multiverseid\': 199855}, {\'name\': \'Espalhar Essência\', \'text\': \'Anule a mágica de criatura alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Alguns magos competem não para invocar as criaturas mais interessantes, mas para criar os efeitos colaterais mais interessantes quando uma invocação dá errado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199108&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cf06adbb-9572-4d13-ba16-da2b9529cb5d\', \'multiverseId\': 199108}, \'multiverseid\': 199108}, {\'name\': \'Разлет Эссенции\', \'text\': \'Отмените целевое заклинание существа.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Некоторые чародеи соревнуются не в том, кто вызовет самое интересное существо, а в том, кто создаст самое занимательное последействие в случае, если вызов окажется неудачным.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200104&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2cf68a90-a3d9-40e4-bfc4-3b614d0e6762\', \'multiverseId\': 200104}, \'multiverseid\': 200104}, {\'name\': \'菁华离散\', \'text\': \'反击目标生物咒语。\', \'type\': \'瞬间\', \'flavor\': \'有些法师比试并非以召唤出最有趣的生物来定胜负，而是看召唤出错后会有怎样有趣的后续影响。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200851&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cd60b97a-1576-4f45-9101-271cd1635e2f\', \'multiverseId\': 200851}, \'multiverseid\': 200851}]', '[{\'name\': \'Exkommunizieren\', \'text\': \'Lege eine Kreatur deiner Wahl oben auf die Bibliothek ihres Besitzers.\', \'type\': \'Hexerei\', \'flavor\': \'„Unsere Gesetze verbieten die Todesstrafe. Wir glauben, dass selbst die schlimmsten Übeltäter die Gelegenheit bekommen sollten, sich rein zu waschen." —Torian Sha, Seelenbewahrerin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199565&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'60ce2304-1cc1-49c8-a44a-53c039b2f0db\', \'multiverseId\': 199565}, \'multiverseid\': 199565}, {\'name\': \'Excomulgar\', \'text\': \'Pon la criatura objetivo en la parte superior de la biblioteca de su propietario.\', \'type\': \'Conjuro\', \'flavor\': \'"Nuestra ley prohíbe la pena capital. Creemos que hasta los criminales más peligrosos tienen una oportunidad de redimirse." —Torian Sha, protectora de almas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200561&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a86bc952-dabd-4d80-b157-d3c8f1f48f04\', \'multiverseId\': 200561}, \'multiverseid\': 200561}, {\'name\': \'Excommunication\', \'text\': \'Mettez la créature ciblée au-dessus de la bibliothèque de son propriétaire.\', \'type\': \'Rituel\', \'flavor\': \'« Nos lois interdisent la peine capitale. Même les criminels les plus impitoyables doivent avoir une chance de rédemption. » —Torian Sha, garde des âmes\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199316&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f715849e-aba3-4552-9e9d-f65c7617ab71\', \'multiverseId\': 199316}, \'multiverseid\': 199316}, {\'name\': \'Scomunicare\', \'text\': \'Metti una creatura bersaglio in cima al grimorio del suo proprietario.\', \'type\': \'Stregoneria\', \'flavor\': \'"Le nostre leggi proibiscono la pena capitale. Crediamo che anche i più grandi criminali meritino la possibilità di redimersi." —Torian Sha, guardiana dell\\\'anima\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200312&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'17f2f48c-e841-4ee8-943b-ed045afd7e8d\', \'multiverseId\': 200312}, \'multiverseid\': 200312}, {\'name\': \'破門\', \'text\': \'クリーチャー１体を対象とし、それをオーナーのライブラリーの一番上に置く。\', \'type\': \'ソーサリー\', \'flavor\': \'「私たちの法では極刑は禁じられています。 最も重い罪を犯したものですら、償う機会を与えられるべきであると信じているのです。」 ――魂の管理人、トーリアン・シャア\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199814&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c77ab6c9-113b-40d8-bce9-cacfa18afeb9\', \'multiverseId\': 199814}, \'multiverseid\': 199814}, {\'name\': \'Excomungar\', \'text\': \'Coloque a criatura alvo no topo do grimório de seu dono.\', \'type\': \'Feitiço\', \'flavor\': \'"Nossas leis proíbem a pena capital. Acreditamos que até mesmo os piores criminosos têm a chance de se redimirem." —Torian Sha, encarregado das almas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199067&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'84031cdb-e5b9-4692-863c-354bd5f34d49\', \'multiverseId\': 199067}, \'multiverseid\': 199067}, {\'name\': \'Отлучение\', \'text\': \'Положите целевое существо на верх библиотеки его владельца.\', \'type\': \'Волшебство\', \'flavor\': \'«Наш закон запрещает смертную казнь. Мы считаем, что даже самые страшные преступники должны иметь шанс искупить свою вину». — Ториан Ша, стражница души\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200063&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6bc757d7-fd4a-4b1f-8a76-684e685fc835\', \'multiverseId\': 200063}, \'multiverseid\': 200063}, {\'name\': \'逐出教会\', \'text\': \'将目标生物置于其拥有者的牌库顶。\', \'type\': \'法术\', \'flavor\': \'「我们的法律禁止极刑。 我们相信：即使是犯下最重罪行者，也该给他们机会自我救赎。」 ～护灵师朵莉恩•夏\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200810&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'95eb4a2a-29ed-4bfa-b2f8-81b6b7e53c96\', \'multiverseId\': 200810}, \'multiverseid\': 200810}]', '[{\'name\': \'Feierliche Gabe\', \'text\': \'Zerstöre ein Artefakt oder eine Verzauberung deiner Wahl. Du erhältst 4 Lebenspunkte dazu.\', \'type\': \'Hexerei\', \'flavor\': \'„Wir bitten um die Spende eines Kunstgegenstands." „Das Erfüllen der Bitte ist zwingend vorgeschrieben." —Tempelschilder\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199588&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dcfc0bde-ae92-4ec0-8c0d-73ac4c2d1d34\', \'multiverseId\': 199588}, \'multiverseid\': 199588}, {\'name\': \'Ofrenda solemne\', \'text\': \'Destruye el artefacto o encantamiento objetivo. Gana 4 vidas.\', \'type\': \'Conjuro\', \'flavor\': \'"Se sugiere donar una reliquia." "Lo sugerido es obligatorio." —Carteles del templo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200584&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c8f3349f-e413-4130-9d96-8f798738d10e\', \'multiverseId\': 200584}, \'multiverseid\': 200584}, {\'name\': \'Offrande solennelle\', \'text\': "Détruisez l\'artefact ciblé ou l\'enchantement ciblé. Vous gagnez 4 points de vie.", \'type\': \'Rituel\', \'flavor\': \'« Don de relique suggéré. » « La suggestion est obligatoire. » —Pancartes du temple\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199339&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a8b9af11-4b16-4655-a306-7fea9dff2a38\', \'multiverseId\': 199339}, \'multiverseid\': 199339}, {\'name\': \'Offerta Solenne\', \'text\': \'Distruggi un artefatto o un incantesimo bersaglio. Guadagni 4 punti vita.\', \'type\': \'Stregoneria\', \'flavor\': \'"Si suggerisce la donazione di una reliquia." "Il suggerimento è obbligatorio." —Cartelli del tempio\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200335&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'beb9be1a-5728-41e6-9819-7c95f384a03f\', \'multiverseId\': 200335}, \'multiverseid\': 200335}, {\'name\': \'真面目な捧げ物\', \'text\': \'アーティファクト１つかエンチャント１つを対象とし、それを破壊する。 あなたは４点のライフを得る。\', \'type\': \'ソーサリー\', \'flavor\': \'『寄進が推奨されています。』 『推奨とはすなわち強制です』 ――寺院の看板\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199837&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ae92777a-068c-4bca-90d0-b1005aa278bf\', \'multiverseId\': 199837}, \'multiverseid\': 199837}, {\'name\': \'Oferenda Solene\', \'text\': \'Destrua o artefato ou encantamento alvo. Você ganha 4 pontos de vida.\', \'type\': \'Feitiço\', \'flavor\': \'"Sugere-se a doação de uma relíquia." "A sugestão é obrigatória." —Avisos do templo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199090&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8ca5e2d0-9a99-476d-bbfa-f3e676c6a673\', \'multiverseId\': 199090}, \'multiverseid\': 199090}, {\'name\': \'Торжественное Приношение\', \'text\': \'Уничтожьте целевой артефакт или чары. Вы получаете 4 жизни.\', \'type\': \'Волшебство\', \'flavor\': \'«Принимаем пожертвования реликвиями». «Пожертвования обязательны!» — таблички на храме\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200086&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a957fdbc-4482-42b6-88c3-6d55c033af3c\', \'multiverseId\': 200086}, \'multiverseid\': 200086}, {\'name\': \'庄严献祭\', \'text\': \'消灭目标神器或结界。 你获得4点生命。\', \'type\': \'法术\', \'flavor\': \'「建议奉献宝物。」 「此建议为强制性。」 ～殿中标语\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200833&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'93bc9dbe-a1f1-49a7-a82c-d6ee5fd6fb60\', \'multiverseId\': 200833}, \'multiverseid\': 200833}]', '[{\'name\': \'Feuerball\', \'text\': \'Der Feuerball fügt X Schadenspunkte zu, die gleichmäßig auf eine beliebige Anzahl von Kreaturen und/oder Spielern deiner Wahl aufgeteilt werden (dabei wird abgerundet).\\nDer Feuerball kostet beim Wirken für jedes Ziel außer dem ersten {1} mehr.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199691&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b433fc32-2623-460a-9623-46e06296571f\', \'multiverseId\': 199691}, \'multiverseid\': 199691}, {\'name\': \'Bola de fuego\', \'text\': \'La Bola de fuego hace X puntos de daño dividido en partes iguales, redondeado hacia abajo, entre cualquier número de criaturas y/o jugadores objetivo.\\nLanzar la Bola de fuego cuesta {1} más por cada objetivo después del primero.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200687&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8c03e55c-55cf-4049-b4f2-20265ae59736\', \'multiverseId\': 200687}, \'multiverseid\': 200687}, {\'name\': \'Boule de feu\', \'text\': "La Boule de feu inflige X blessures réparties de manière égale, arrondies à l\'unité inférieure, entre n\'importe quel nombre de créatures et/ou de joueurs ciblés.\\nLa Boule de feu coûte {1} supplémentaire à lancer pour chaque cible après la première.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199442&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cdf95613-6b55-4479-afd1-f7dc99125f8c\', \'multiverseId\': 199442}, \'multiverseid\': 199442}, {\'name\': \'Palla di Fuoco\', \'text\': \'La Palla di Fuoco infligge X danni suddivisi equamente, arrotondati per difetto, tra un qualsiasi numero di creature e/o giocatori bersaglio.\\nLa Palla di Fuoco costa {1} in più per essere lanciata per ogni bersaglio oltre il primo.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200438&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6484e738-4daf-44c4-93b7-2f1d22760bf1\', \'multiverseId\': 200438}, \'multiverseid\': 200438}, {\'name\': \'火の玉\', \'text\': \'望む数のクリーチャーかプレイヤー（またはその組み合わせ）を対象とする。火の玉はそれらに、Ｘ点を均等に割った点数のダメージを与える（端数切捨て）。\\n火の玉を唱えるためのコストは、２つ目以降の対象１つにつき{1}多くなる。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199940&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'40cd8b6d-de79-4ca5-a2a3-ad3a15621e3b\', \'multiverseId\': 199940}, \'multiverseid\': 199940}, {\'name\': \'Bola de Fogo\', \'text\': \'Bola de Fogo causa X pontos de dano divididos igualmente, arredondados para baixo, a qualquer número de jogadores e/ou criaturas alvo.\\nBola de Fogo custa {1} a mais para ser conjurada para cada alvo após o primeiro.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199193&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'901c4ee9-0847-4a12-bc92-e37da6d0470b\', \'multiverseId\': 199193}, \'multiverseid\': 199193}, {\'name\': \'Огненный Шар\', \'text\': \'Огненный Шар наносит X повреждений, разделенных поровну (и округленных в меньшую сторону) между любым количеством целевых существ и (или) игроков.\\nДля каждой цели после первой разыгрывание Огненного Шара стоит на {1} больше.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200189&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f9c1f6b2-b8f9-441b-98b7-004bda265070\', \'multiverseId\': 200189}, \'multiverseid\': 200189}, {\'name\': \'火球\', \'text\': \'火球对任意数量的目标生物和／或牌手造成伤害，其数值为「将X平均分配给所有目标，小数点后舍去」\\n火球在第一个目标之外每有一个目标，其费用便增加{1}来施放。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200936&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'717ec6dd-9497-44a2-963f-7f2a774943db\', \'multiverseId\': 200936}, \'multiverseid\': 200936}]', '[{\'name\': \'Feuermasse\', \'text\': \'Die Feuermasse fügt jeder Kreatur 2 Schadenspunkte zu.\', \'type\': \'Hexerei\', \'flavor\': \'„Wer will schon jedes Ding einzeln anzünden müssen?" —Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199707&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8ba0ec8b-83b5-40e9-a381-d6d55a96fe33\', \'multiverseId\': 199707}, \'multiverseid\': 199707}, {\'name\': \'Detonación ígnea\', \'text\': \'La Detonación ígnea hace 2 puntos de daño a cada criatura.\', \'type\': \'Conjuro\', \'flavor\': \'"¿Quién quiere quemar cosas de a una a la vez?" —Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200703&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9475eaf9-981c-435c-802e-2f5b113236ae\', \'multiverseId\': 200703}, \'multiverseid\': 200703}, {\'name\': \'Pyroclasme\', \'text\': \'Le Pyroclasme inflige 2 blessures à chaque créature.\', \'type\': \'Rituel\', \'flavor\': "« Qui aurait l\'envie de n\'enflammer qu\'une seule chose à la fois ? » —Chandra Nalaàr", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199458&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c409178e-f4a9-4256-9106-d82fb86a46c8\', \'multiverseId\': 199458}, \'multiverseid\': 199458}, {\'name\': \'Piroclasma\', \'text\': \'Il Piroclasma infligge 2 danni a ogni creatura.\', \'type\': \'Stregoneria\', \'flavor\': \'"Chi vuole incendiare le cose una alla volta?" —Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200454&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'afe02266-9079-400a-adde-23148585a6a5\', \'multiverseId\': 200454}, \'multiverseid\': 200454}, {\'name\': \'紅蓮地獄\', \'text\': \'紅蓮地獄は各クリーチャーにそれぞれ２点のダメージを与える。\', \'type\': \'ソーサリー\', \'flavor\': \'「一つ一つ火をつけるなんて誰がやるんだい？」 ――チャンドラ・ナラー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199956&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b299ead2-7132-4728-a9f1-9604af7f90cb\', \'multiverseId\': 199956}, \'multiverseid\': 199956}, {\'name\': \'Piroclasma\', \'text\': \'Piroclasma causa 2 pontos de dano a cada criatura.\', \'type\': \'Feitiço\', \'flavor\': \'"Quem perderia tempo incendiando uma coisa de cada vez?" —Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199209&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7762489c-625b-4990-aa25-34bac6838dc1\', \'multiverseId\': 199209}, \'multiverseid\': 199209}, {\'name\': \'Пироклазм\', \'text\': \'Пироклазм наносит каждому существу 2 повреждения.\', \'type\': \'Волшебство\', \'flavor\': \'«Какой смысл поджигать все по очереди?» — Чандра Налаар\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200205&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'391b7dc6-cf8d-4288-ac1f-48ccee3c986d\', \'multiverseId\': 200205}, \'multiverseid\': 200205}, {\'name\': \'烈火断层\', \'text\': \'烈火断层对每个生物各造成2点伤害。\', \'type\': \'法术\', \'flavor\': \'「谁会想一个个点火？」 ～茜卓纳拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200952&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4b5000e2-7608-4e2b-b770-7a33fa3585c1\', \'multiverseId\': 200952}, \'multiverseid\': 200952}]', 