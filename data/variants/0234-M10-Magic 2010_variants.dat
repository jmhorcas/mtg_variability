}, 'multiverseid': 201047}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199803&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e6060114-d09c-465d-b2c2-d0151a5ff7d0', 'multiverseId': 199803}, 'multiverseid': 199803}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200799&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '81e68b97-fb57-4839-bf02-5da73f698457', 'multiverseId': 200799}, 'multiverseid': 200799}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199554&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'cc274229-6f85-4903-9b10-69f1d1f11a8c', 'multiverseId': 199554}, 'multiverseid': 199554}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200550&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'bbacd378-6037-4ae3-9ee6-3c97ad309d71', 'multiverseId': 200550}, 'multiverseid': 200550}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200052&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '1362f7e0-01db-48c8-88d4-1aa453d37172', 'multiverseId': 200052}, 'multiverseid': 200052}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199305&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c43c65d4-1178-4fcb-8105-0e0b5fb96757', 'multiverseId': 199305}, 'multiverseid': 199305}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200301&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '9bc1fad4-3ef2-4d0c-bc8d-7c1f52a62828', 'multiverseId': 200301}, 'multiverseid': 200301}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=201048&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'e290af3d-3e46-48fc-94e6-4b141c061eb5', 'multiverseId': 201048}, 'multiverseid': 201048}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199804&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c53b71cd-482d-45cd-aefd-d445f553ce12', 'multiverseId': 199804}, 'multiverseid': 199804}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200800&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '644517a5-3ae8-45c1-94aa-f614a318f019', 'multiverseId': 200800}, 'multiverseid': 200800}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199555&type=card', 'language': 'French', 'identifiers': {'scryfallId': '31aa567e-a479-477b-9fb9-1765f8078e05', 'multiverseId': 199555}, 'multiverseid': 199555}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200551&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'edf8991d-be4c-45ad-b002-b8fff5fb4df5', 'multiverseId': 200551}, 'multiverseid': 200551}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200053&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'eab5a201-3274-4966-bcd5-6db836b04a30', 'multiverseId': 200053}, 'multiverseid': 200053}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199306&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c64716cf-ede3-4b5a-8da3-5d9e000e771e', 'multiverseId': 199306}, 'multiverseid': 199306}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200302&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '6e7639bc-3da2-4f99-833f-2af482f43eee', 'multiverseId': 200302}, 'multiverseid': 200302}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=201049&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '599ada3e-1695-4db8-b426-189644bd0311', 'multiverseId': 201049}, 'multiverseid': 201049}]", '[{\'name\': \'Weise Eule\', \'text\': \'Fliegend\\nWenn die Weise Eule ins Spiel kommt, schaue dir die obersten vier Karten deiner Bibliothek an und lege sie in beliebiger Reihenfolge zurück.\', \'type\': \'Kreatur — Vogel\', \'flavor\': \'In manchen Eulen wohnen die Seelen der Erzmagier vergangener Tage.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199624&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c8b01c70-93f4-49d4-bc95-ef5bdca5ddff\', \'multiverseId\': 199624}, \'multiverseid\': 199624}, {\'name\': \'Búho sabio\', \'text\': \'Vuela.\\nCuando el Búho sabio entre al campo de batalla, mira las primeras cuatro cartas de tu biblioteca y regrésalas en cualquier orden.\', \'type\': \'Criatura — Ave\', \'flavor\': \'Algunos búhos albergan las almas de archimagos de otras eras.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200620&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'829674aa-0f53-4439-a08d-d38f9e2fda7d\', \'multiverseId\': 200620}, \'multiverseid\': 200620}, {\'name\': \'Hibou savant\', \'text\': "Vol\\nQuand le Hibou savant arrive sur le champ de bataille, regardez les quatre cartes du dessus de votre bibliothèque, puis remettez-les dessus dans l\'ordre de votre choix.", \'type\': \'Créature : oiseau\', \'flavor\': "Certaines chouettes abritent les âmes d\'archimage du temps jadis.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199375&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c9341fde-1ad7-4eee-97ac-c400f7006d1f\', \'multiverseId\': 199375}, \'multiverseid\': 199375}, {\'name\': \'Gufo Sapiente\', \'text\': \'Volare\\nQuando il Gufo Sapiente entra nel campo di battaglia, guarda le prime quattro carte del tuo grimorio, poi rimettile a posto in qualsiasi ordine.\', \'type\': \'Creatura — Uccello\', \'flavor\': \'Alcuni gufi ospitano le anime di arcimaghi del passato.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200371&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d1e3f23e-a27b-449f-aaf3-cd8dd6f042b1\', \'multiverseId\': 200371}, \'multiverseid\': 200371}, {\'name\': \'物知りフクロウ\', \'text\': \'飛行\\n物知りフクロウが戦場に出たとき、あなたのライブラリーのカードを一番上から４枚見る。その後、それらを望む順番で戻す。\', \'type\': \'クリーチャー — 鳥\', \'flavor\': \'フクロウの中には、数世代も前の大魔道士の魂を携えているものがいる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199873&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3ebc2809-03cd-4a57-9b99-e4d30f679ca4\', \'multiverseId\': 199873}, \'multiverseid\': 199873}, {\'name\': \'Coruja Sábia\', \'text\': \'Voar\\nQuando Coruja Sábia entra no campo de batalha, olhe os quatro cards do topo de seu grimório e depois coloque-os de volta em qualquer ordem.\', \'type\': \'Criatura — Ave\', \'flavor\': \'Algumas corujas abrigam as almas de arquimagos de eras passadas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199126&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0601b94b-466b-4fee-8e00-f8b859b566f1\', \'multiverseId\': 199126}, \'multiverseid\': 199126}, {\'name\': \'Мудрая Сова\', \'text\': \'Полет\\nКогда Мудрая Сова выходит на поле битвы, посмотрите четыре верхние карты вашей библиотеки, затем положите их обратно в любом порядке.\', \'type\': \'Существо — Птица\', \'flavor\': \'В некоторых совах живут души архимагов былых времен.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200122&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3ccbf054-af96-44bb-b1b1-c6ab2aafc13e\', \'multiverseId\': 200122}, \'multiverseid\': 200122}, {\'name\': \'睿智的猫头鹰\', \'text\': \'飞行\\n当睿智的猫头鹰进战场时，检视你牌库顶的四张牌，然后将它们以任意顺序放回。\', \'type\': \'生物～鸟\', \'flavor\': \'有些猫头鹰体内居有早已作古之大法师的灵魂。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200869&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'37e71796-9158-40d3-92f1-84cbfb56adbd\', \'multiverseId\': 200869}, \'multiverseid\': 200869}]', '[{\'name\': \'Weissagung\', \'text\': \'Ziehe zwei Karten.\', \'type\': \'Hexerei\', \'flavor\': \'„Der Schlüssel zu diesem Rätsel steckt in dir." —Doriel, Mentor der Mistralinsel\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199604&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e6616245-714e-4d81-8766-feb0176bfd84\', \'multiverseId\': 199604}, \'multiverseid\': 199604}, {\'name\': \'Adivinación\', \'text\': \'Roba dos cartas.\', \'type\': \'Conjuro\', \'flavor\': \'"La llave para desentrañar este misterio está dentro tuyo." —Doriel, mentor de la Isla Mistral\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200600&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2c0374c2-754f-41e0-bfa6-865dc94a76fd\', \'multiverseId\': 200600}, \'multiverseid\': 200600}, {\'name\': \'Divination\', \'text\': \'Piochez deux cartes.\', \'type\': \'Rituel\', \'flavor\': "« La clé qui te permettra de résoudre ce mystère est en toi. » —Doriel, mentor de l\'Île de Mistral", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199355&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'72ab0d90-949d-49c2-8fef-e0bfc26f3ec6\', \'multiverseId\': 199355}, \'multiverseid\': 199355}, {\'name\': \'Divinazione\', \'text\': \'Pesca due carte.\', \'type\': \'Stregoneria\', \'flavor\': \'"La chiave per risolvere questo enigma è dentro di te." —Doriel, mentore di Isola del Mistral\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200351&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5f377c12-96b7-4da6-aa90-30dcf56095cc\', \'multiverseId\': 200351}, \'multiverseid\': 200351}, {\'name\': \'予言\', \'text\': \'カードを２枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'「この謎を解く鍵はお前の中にある。」 ――北風島の導師、ドリエル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199853&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'87ad5a36-1016-4a36-8fa0-3676336a8b4b\', \'multiverseId\': 199853}, \'multiverseid\': 199853}, {\'name\': \'Divinação\', \'text\': \'Compre dois cards.\', \'type\': \'Feitiço\', \'flavor\': \'"A chave para desvendar esse mistério está dentro de você." —Doriel, mentor da Ilha Mistral\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199106&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2dbcc237-a3d1-4ea6-9f80-c61cf731b9c3\', \'multiverseId\': 199106}, \'multiverseid\': 199106}, {\'name\': \'Прорицание\', \'text\': \'Возьмите две карты.\', \'type\': \'Волшебство\', \'flavor\': \'«Ключ к этой загадке — в тебе». — Дориел, наставник с Острова Мистраль\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200102&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'176a721f-7dfa-4763-a799-1cca83c29201\', \'multiverseId\': 200102}, \'multiverseid\': 200102}, {\'name\': \'卜卦\', \'text\': \'抓两张牌。\', \'type\': \'法术\', \'flavor\': \'「解开谜题的关键就在你心中。」 ～西北风屿导师多瑞尔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200849&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4360aa9c-aebb-48b5-a5af-e41ea0993fa3\', \'multiverseId\': 200849}, \'multiverseid\': 200849}]', '[{\'name\': \'Weißer Ritter\', \'text\': \'Erstschlag (Diese Kreatur fügt Kampfschaden vor Kreaturen ohne Erstschlag zu.)\\nSchutz vor Schwarz (Diese Kreatur kann von nichts Schwarzem geblockt oder als Ziel bestimmt werden, von ihm Schaden zugefügt bekommen oder von ihm verzaubert werden.)\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199596&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'37656665-f4f2-4bad-ab4c-67952a8ad12e\', \'multiverseId\': 199596}, \'multiverseid\': 199596}, {\'name\': \'Caballero blanco\', \'text\': \'Daña primero. (Esta criatura hace daño de combate antes que las criaturas sin la habilidad de dañar primero.)\\nProtección contra negro. (Esta criatura no puede ser bloqueada, hecha objetivo, recibir daño de o estar encantada por nada negro.)\', \'type\': \'Criatura — Caballero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200592&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f467f98a-c3e3-4e38-bd19-10a08d6e2561\', \'multiverseId\': 200592}, \'multiverseid\': 200592}, {\'name\': \'Chevalier blanc\', \'text\': "Initiative (Cette créature inflige des blessures de combat avant les créatures sans l\'initiative.)\\nProtection contre le noir (Cette créature ne peut pas être bloquée, ciblée, blessée ou enchantée par quoi que ce soit de noir.)", \'type\': \'Créature : humain et chevalier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199347&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ce48d6e0-4e71-4ead-b8c6-133119633b7c\', \'multiverseId\': 199347}, \'multiverseid\': 199347}, {\'name\': \'Cavaliere Bianco\', \'text\': \'Attacco improvviso (Questa creatura infligge danno da combattimento prima delle creature senza attacco improvviso.)\\nProtezione dal nero (Questa creatura non può essere bloccata, bersagliata, non le può essere inflitto danno, né può essere incantata da nulla di nero.)\', \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200343&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fb1b2c0c-8fe0-42c0-842b-6443b36802ac\', \'multiverseId\': 200343}, \'multiverseid\': 200343}, {\'name\': \'白騎士\', \'text\': \'先制攻撃 （このクリーチャーは先制攻撃を持たないクリーチャーよりも先に戦闘ダメージを与える。）\\nプロテクション（黒） （このクリーチャーは黒のものに対して、ブロックされず、対象にならず、ダメージを与えられず、エンチャントされない。）\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199845&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fce82124-4f1d-47f7-af28-93f028b35bd0\', \'multiverseId\': 199845}, \'multiverseid\': 199845}, {\'name\': \'Cavaleiro Branco\', \'text\': \'Iniciativa (Esta criatura causa dano de combate antes das criaturas sem iniciativa.)\\nProteção contra o preto (Esta criatura não pode ser bloqueada, ser alvo, sofrer dano nem ser encantada por qualquer coisa da cor preta.)\', \'type\': \'Criatura — Humano Cavaleiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199098&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d08c8245-3c4c-4b8c-ae40-802c6ca29c6a\', \'multiverseId\': 199098}, \'multiverseid\': 199098}, {\'name\': \'Белый Рыцарь\', \'text\': \'Первый удар (Это существо наносит боевые повреждения раньше существ без Первого удара.)\\nЗащита от черного (Ни один черный объект не может блокировать это существо, делать его своей целью, наносить ему повреждения и зачаровывать его.)\', \'type\': \'Существо — Человек Рыцарь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200094&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'93e94a74-e890-4000-97a7-48cb79f997eb\', \'multiverseId\': 200094}, \'multiverseid\': 200094}, {\'name\': \'白骑士\', \'text\': \'先攻 （此生物会比不具先攻异能的生物提前造成战斗伤害。）\\n反黑保护 （此生物不能被黑色的东西所阻挡，指定为目标，造成伤害，或是被结附。）\', \'type\': \'生物～人类／骑士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200841&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9d1a48e8-33c1-4c7d-a060-d69bd080d8c2\', \'multiverseId\': 200841}, \'multiverseid\': 200841}]', "[{'name': 'Weltenreinigung', 'text': 'Zerstöre alle bleibenden Karten, die keine Länder sind.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199579&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'ad9f63a1-2853-45cc-a7a2-20b5cdec5244', 'multiverseId': 199579}, 'multiverseid': 199579}, {'name': 'Purificación planar', 'text': 'Destruye todos los permanentes que no sean tierras.', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200575&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '2cdfbc5f-0163-4d1d-91ed-06d452e2a03b', 'multiverseId': 200575}, 'multiverseid': 200575}, {'name': 'Dépuration planaire', 'text': 'Détruisez tous les permanents non-terrain.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199330&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b5302eea-0e5a-4dd8-9b01-cb9335a6e08e', 'multiverseId': 199330}, 'multiverseid': 199330}, {'name': 'Pulizia Planare', 'text': 'Distruggi tutti i permanenti non terra.', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200326&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'cde72cd9-ad68-4ed9-b7c4-ec17ee747fcc', 'multiverseId': 200326}, 'multiverseid': 200326}, {'name': '次元の浄化', 'text': 'すべての土地でないパーマネントを破壊する。', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199828&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '39a41f8c-d1c3-4c4a-9e6b-9c169828e110', 'multiverseId': 199828}, 'multiverseid': 199828}, {'name': 'Limpeza Planar', 'text': 'Destrua todas as permanentes que não sejam terrenos.', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199081&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '503d7f65-c468-4702-b141-fcb38b91eacd', 'multiverseId': 199081}, 'multiverseid': 199081}, {'name': 'Вселенское Очищение', 'text': 'Уничтожьте все перманенты, не являющиеся землями.', 'type': 'Волшебство', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200077&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '24ac5bea-f5cf-4f49-9810-e198c02d5b53', 'multiverseId': 200077}, 'multiverseid': 200077}, {'name': '净化时空', 'text': '消灭所有非地永久物。', 'type': '法术', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200824&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a00d4106-def3-406a-a0b7-88b637e634de', 'multiverseId': 200824}, 'multiverseid': 200824}]", '[{\'name\': \'Westwind-Sylphide\', \'text\': \'Fliegend\', \'type\': \'Kreatur — Feenwesen\', \'flavor\': \'„Ich habe es nie verstanden, warum so viele Wesen immer an Boden bleiben. Es gibt drei Dimensionen, aber sie nutzen nur zwei."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199637&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'38cd73f5-59eb-42e9-8ff3-c5518089cdeb\', \'multiverseId\': 199637}, \'multiverseid\': 199637}, {\'name\': \'Hada del céfiro\', \'text\': \'Vuela.\', \'type\': \'Criatura — Hada\', \'flavor\': \'"Nunca entendí por qué tantos seres se arrastran por el suelo. Hay tres dimensiones, pero usan sólo dos."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200633&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'90697db1-7a2f-4fb0-b82f-c22e3f36e9c5\', \'multiverseId\': 200633}, \'multiverseid\': 200633}, {\'name\': \'Farfadet du zéphir\', \'text\': \'Vol\', \'type\': \'Créature : peuple fée\', \'flavor\': "« Je n\'ai jamais compris pourquoi tant d\'êtres traînent ainsi au sol. Il y a trois dimensions, mais ils n\'en utilisent que deux. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199388&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'62eeb2a8-d52b-452f-8541-11a5a4418e7a\', \'multiverseId\': 199388}, \'multiverseid\': 199388}, {\'name\': \'Folletto dello Zefiro\', \'text\': \'Volare\', \'type\': \'Creatura — Spiritello\', \'flavor\': \'"Non ho mai capito perché così tanti esseri ingombrano il terreno. Esistono tre dimensioni, eppure ne usano solo due."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200384&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d2f24873-d567-4ae0-a88c-7ffaf9315538\', \'multiverseId\': 200384}, \'multiverseid\': 200384}, {\'name\': \'西風のスプライト\', \'text\': \'飛行\', \'type\': \'クリーチャー — フェアリー\', \'flavor\': \'「こんなに多くの生物が地面でうろうろしてるのは理解できないね。 世の中には三つの方向があるのに、二つしか使ってないんだから。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199886&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1e16c779-5505-4149-8a3c-1c7e453528be\', \'multiverseId\': 199886}, \'multiverseid\': 199886}, {\'name\': \'Silfo Zéfiro\', \'text\': \'Voar\', \'type\': \'Criatura — Fada\', \'flavor\': \'"Nunca entendi todas essas criaturas que vagueiam pelo chão. Das três dimensões eles só aproveitam duas."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199139&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'18b085f4-207b-443c-a124-3fc4a61ecb59\', \'multiverseId\': 199139}, \'multiverseid\': 199139}, {\'name\': \'Фея Западного Ветра\', \'text\': \'Полет\', \'type\': \'Существо — Фея\', \'flavor\': \'«Я до сих пор не понимаю, почему столько существ так неуклюже перемещаются по земле. Измерения ведь три, а они почему-то используют только два».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200135&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'941bc822-a6ed-49f3-9e77-869b07c28b64\', \'multiverseId\': 200135}, \'multiverseid\': 200135}, {\'name\': \'西风仙子\', \'text\': \'飞行\', \'type\': \'生物～仙灵\', \'flavor\': \'「我从来不懂为何那么多生物要在地上爬。 空间有三个面向，他们却只用到两个。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200882&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'91c6e924-f4f3-4394-82f3-353a57e6142d\', \'multiverseId\': 200882}, \'multiverseid\': 200882}]', "[{'name': 'Windsceada', 'text': 'Fliegend', 'type': 'Kreatur — Sceada', 'flavor': 'Sceadas sind die kleinen Vettern der Drachen und dienen oft mächtigen Zauberern als zusätzliche Augen und Ohren in der Luft.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199636&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'ec69e5ee-c9e3-4029-94eb-b71dd411d742', 'multiverseId': 199636}, 'multiverseid': 199636}, {'name': 'Draco del viento', 'text': 'Vuela.', 'type': 'Criatura — Draco', 'flavor': 'Un primo menor del dragón, el draco muchas veces es visto junto a poderosos hechiceros que los usan como ojos y oídos voladores.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200632&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e752db62-9ddf-40ea-b7f5-2c0508e58597', 'multiverseId': 200632}, 'multiverseid': 200632}, {'name': 'Drakôn des vents', 'text': 'Vol', 'type': 'Créature : drakôn', 'flavor': 'Petit cousin du dragon, le drakôn est souvent vu en compagnie de puissants sorciers qui les utilisent comme espions aériens.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199387&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'f10a6485-023e-4ca2-8348-aefc26d7e1a1', 'multiverseId': 199387}, 'multiverseid': 199387}, {'name': 'Draghetto del Vento', 'text': 'Volare', 'type': 'Creatura — Draghetto', 'flavor': 'Cugini più piccoli del drago, i draghetti vengono spesso visti al fianco di maghi potenti che li sfruttano come occhi e orecchie volanti.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200383&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '820d2cb1-fdb9-4339-9ec7-d78c3a6ce484', 'multiverseId': 200383}, 'multiverseid': 200383}, {'name': '風のドレイク', 'text': '飛行', 'type': 'クリーチャー — ドレイク', 'flavor': 'ドラゴンの小さな従兄弟であるドレイクは、彼らを空からの目や耳として用いている強力な魔術師の脇に仕えていることがよくある。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199885&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '07cc9256-956c-4b52-aba7-54313cef4236', 'multiverseId': 199885}, 'multiverseid': 199885}, {'name': 'Dragonete do Vento', 'text': 'Voar', 'type': 'Criatura — Dragonete', 'flavor': 'Primo menor do dragão, o dragonete geralmente acompanha poderosos magos que dele se valem como olhos e ouvidos com asas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199138&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b6f9bd7d-6428-4468-b9fd-83bf4a0c7d40', 'multiverseId': 199138}, 'multiverseid': 199138}, {'name': 'Ветряной Дрейк', 'text': 'Полет', 'type': 'Существо — Дрейк', 'flavor': 'Дрейков, малых родственников дракона, часто можно увидеть рядом с могущественными волшебниками, которые используют их как летающие глаза и уши.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200134&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '8498e574-2ea5-428c-abc7-30e7a39c87a3', 'multiverseId': 200134}, 'multiverseid': 200134}, {'name': '风龙兽', 'text': '飞行', 'type': '生物～龙兽', 'flavor': '龙兽是龙的远房亲戚，经常在强大法师的身旁出现，充任他们空中的耳目。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200881&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '11118242-8346-41a9-8a95-b97b770e9512', 'multiverseId': 200881}, 'multiverseid': 200881}]", '[{\'name\': \'Windsturm\', \'text\': \'Der Windsturm fügt allen fliegenden Kreaturen X Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Wir mögen keine Eindringlinge und Diebe, die unseren Himmel unsicher machen." —Dionus, Elfischer Erzdruide\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199760&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6c01101c-b61e-4a8b-a21d-b7d4342104a8\', \'multiverseId\': 199760}, \'multiverseid\': 199760}, {\'name\': \'Tormenta de viento\', \'text\': \'La Tormenta de viento hace X puntos de daño a cada criatura que tenga la habilidad de volar.\', \'type\': \'Instantáneo\', \'flavor\': \'"No nos gusta tener entrometidos y ladrones en nuestros cielos." —Dionus, archidruida élfico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200756&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'07a17433-db7b-4110-9faa-710c0eeed325\', \'multiverseId\': 200756}, \'multiverseid\': 200756}, {\'name\': \'Trombe\', \'text\': \'La Trombe inflige X blessures à chaque créature avec le vol.\', \'type\': \'Éphémère\', \'flavor\': "« Nous n\'aimons pas voir des importuns et des voleurs dans notre ciel. » —Dionus, archidruide elfe", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199511&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'371c342e-d669-4246-9487-35ab5652f86a\', \'multiverseId\': 199511}, \'multiverseid\': 199511}, {\'name\': \'Tempesta di Vento\', \'text\': \'La Tempesta di Vento infligge X danni a ogni creatura con volare.\', \'type\': \'Istantaneo\', \'flavor\': \'"Non ci piace che intrusi e ladri portino scompiglio nei nostri cieli." —Dionus, arcidruido elfico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200507&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'56888cda-9730-4995-b930-8c5b8c8fcd9b\', \'multiverseId\': 200507}, \'multiverseid\': 200507}, {\'name\': \'暴風\', \'text\': \'暴風は飛行を持つ各クリーチャーに、それぞれＸ点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'「我らの空を騒がせる侵略者や盗人は許さぬ。」 ――エルフの大ドルイド、ダイオヌス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200009&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f39effaa-3d87-49c1-9bbf-9b1517febffe\', \'multiverseId\': 200009}, \'multiverseid\': 200009}, {\'name\': \'Vendaval\', \'text\': \'Vendaval causa X pontos de dano a cada criatura com voar.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Não gostamos de intrusos e ladrões infestando nosso céu." —Dionus, elfo arqueodruida\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199262&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ad9622d5-4d73-4000-811a-9e49182cf28f\', \'multiverseId\': 199262}, \'multiverseid\': 199262}, {\'name\': \'Штормовой Ветер\', \'text\': \'Штормовой Ветер наносит Х повреждений каждому существу с Полетом.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Нам не нравится, когда незваные гости и воришки снуют в нашем небе». — Дионус, эльфийский архидруид\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200258&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'21dc6961-2841-4c79-a7a8-f7fd6c81b445\', \'multiverseId\': 200258}, \'multiverseid\': 200258}, {\'name\': \'大风暴\', \'text\': \'大风暴对每个具飞行异能的生物各造成X点伤害。\', \'type\': \'瞬间\', \'flavor\': \'「我们不要入侵者与小偷进入我们的天空。」 ～妖精高位德鲁伊戴欧诺\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=201005&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fbbcad54-093c-4d96-89ef-e4bfde168156\', \'multiverseId\': 201005}, \'multiverseid\': 201005}]', "[{'name': 'Wucherndes Wachstum', 'text': 'Durchsuche deine Bibliothek nach einer Standardland-Karte und bringe diese Karte getappt ins Spiel. Mische danach deine Bibliothek.', 'type': 'Hexerei', 'flavor': 'Die Natur lässt die Lösungen für ihre Probleme einfach sprießen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199756&type=card', 'language': 'German', 'identifiers': {'scryfallId': '76c0073e-b1b8-4622-a716-78c91fd74fc7', 'multiverseId': 199756}, 'multiverseid': 199756}, {'name': 'Crecimiento exuberante', 'text': 'Busca en tu biblioteca una carta de tierra básica y pon en el campo de batalla esa carta girada. Luego baraja tu biblioteca.', 'type': 'Conjuro', 'flavor': 'La naturaleza cultiva soluciones para sus problemas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200752&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '1e9a2f2c-b23c-4678-97ec-57ad910153cd', 'multiverseId': 200752}, 'multiverseid': 200752}, {'name': 'Croissance luxuriante', 'text': 'Cherchez dans votre bibliothèque une carte de terrain de base et mettez cette carte sur le champ de bataille engagée. Mélangez ensuite votre bibliothèque.', 'type': 'Rituel', 'flavor': 'La nature fait pousser les solutions de ses problèmes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199507&type=card', 'language': 'French', 'identifiers': {'scryfallId': '490d70a5-8f0a-4e22-a786-3ed87d33af20', 'multiverseId': 199507}, 'multiverseid': 199507}, {'name': 'Crescita Inarrestabile', 'text': 'Passa in rassegna il tuo grimorio per una carta terra base e mettila sul campo di battaglia TAPpata. Poi rimescola il tuo grimorio.', 'type': 'Stregoneria', 'flavor': 'La natura genera soluzioni ai propri problemi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200503&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '81ee30c6-4267-48d8-a877-d17cd54cd577', 'multiverseId': 200503}, 'multiverseid': 200503}, {'name': '不屈の自然', 'text': 'あなたのライブラリーから基本土地カードを１枚探し、そのカードをタップ状態で戦場に出す。 その後あなたのライブラリーを切り直す。', 'type': 'ソーサリー', 'flavor': '自然は問題の解決法を自ら育て上げる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200005&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'edeaae0a-0079-47ed-a0b0-3c1f0a50c08f', 'multiverseId': 200005}, 'multiverseid': 200005}, {'name': 'Crescimento Exuberante', 'text': 'Procure em seu grimório por um card de terreno básico e coloque-o virado no campo de batalha. Depois, embaralhe seu grimório.', 'type': 'Feitiço', 'flavor': 'A natureza cultiva as soluções aos seus próprios problemas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199258&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '77cc37f5-c99b-49c6-bcb0-08e9cdd29083', 'multiverseId': 199258}, 'multiverseid': 199258}, {'name': 'Буйный Рост', 'text': 'Найдите в вашей библиотеке карту базовой земли и положите ту карту на поле битвы повернутой. Затем перетасуйте вашу библиотеку.', 'type': 'Волшебство', 'flavor': 'Решения проблем природы вырастают сами.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200254&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'b4765b3a-4b49-4dc6-9c40-c5132ab185b9', 'multiverseId': 200254}, 'multiverseid': 200254}, {'name': '徒长', 'text': '从你的牌库中搜寻一张基本地牌，并将之横置进战场。 然后将你的牌库洗牌。', 'type': '法术', 'flavor': '大自然为其问题栽培答案。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=201001&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '00249225-12c9-4682-b66b-ecfb74077162', 'multiverseId': 201001}, 'multiverseid': 201001}]", '[{\'name\': \'Wurmzahn\', \'text\': \'Immer wenn ein Spieler einen grünen Zauberspruch wirkt, kannst du 1 Lebenspunkt dazuerhalten.\', \'type\': \'Artefakt\', \'flavor\': \'Ein Wurm kann sich nicht verstellen. Wenn er sein Maul öffnet, plant er, dich zu verspeisen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199777&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cc5d9b46-0255-4e54-93d0-206c04e00bc3\', \'multiverseId\': 199777}, \'multiverseid\': 199777}, {\'name\': \'Diente de sierpe\', \'text\': \'Siempre que un jugador lance un hechizo verde, puedes ganar 1 vida.\', \'type\': \'Artefacto\', \'flavor\': \'Una sierpe no sabe de engaños. Si abre la boca, planea comerte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200773&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5122884f-8bc4-4240-9b09-29d6fe13b3e0\', \'multiverseId\': 200773}, \'multiverseid\': 200773}, {\'name\': \'Dent de la guivre\', \'text\': "À chaque fois qu\'un joueur lance un sort vert, vous pouvez gagner 1 point de vie.", \'type\': \'Artefact\', \'flavor\': "La guivre n\'est pas bavarde. Si elle ouvre la gueule, c\'est pour vous dévorer.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199528&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e3dfe687-b247-4a8a-ab00-7df12ad8e1d2\', \'multiverseId\': 199528}, \'multiverseid\': 199528}, {\'name\': \'Dente del Wurm\', \'text\': \'Ogniqualvolta un giocatore lancia una magia verde, puoi guadagnare 1 punto vita.\', \'type\': \'Artefatto\', \'flavor\': "Un wurm non sa cosa sia l\'inganno. Se apre la bocca, vuole semplicemente mangiarti.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200524&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3164c034-2861-4b8e-8701-f50fc42b220d\', \'multiverseId\': 200524}, \'multiverseid\': 200524}, {\'name\': \'ワームの歯\', \'text\': \'いずれかのプレイヤーが緑の呪文を唱えるたび、あなたは１点のライフを得てもよい。\', \'type\': \'アーティファクト\', \'flavor\': \'ワームは欺かない。 そいつの口が開いたら、お前を食うつもりだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200026&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eba6a82a-0b6d-4297-96e5-a1f69da8298b\', \'multiverseId\': 200026}, \'multiverseid\': 200026}, {\'name\': \'Dente de Vorme\', \'text\': \'Toda vez que um jogador conjurar uma mágica verde, você pode ganhar 1 ponto de vida.\', \'type\': \'Artefato\', \'flavor\': \'Um vorme não sabe nada sobre engodos. Se ele abre a boca, ele quer comê-lo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199279&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b4912641-62c9-4c20-91c9-3e7955c6e343\', \'multiverseId\': 199279}, \'multiverseid\': 199279}, {\'name\': \'Клык Вурма\', \'text\': \'Каждый раз, когда игрок разыгрывает зеленое заклинание, вы можете получить 1 жизнь.\', \'type\': \'Артефакт\', \'flavor\': \'Вурм никогда не прибегает к обману. Если он раскрыл пасть, значит, он собирается вас съесть.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200275&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c1a4b6dd-f0e9-4cda-9805-c341491e1e30\', \'multiverseId\': 200275}, \'multiverseid\': 200275}, {\'name\': \'亚龙巨牙\', \'text\': \'每当牌手施放任何绿色咒语时，你可以获得1点生命。\', \'type\': \'神器\', \'flavor\': \'亚龙不会说谎。 它若张开嘴巴，就是要把你吃掉。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=201022&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'748c7daf-5373-4b00-a1f6-3b1e72f473e0\', \'multiverseId\': 201022}, \'multiverseid\': 201022}]', '[{\'name\': \'Wütender Goblin\', \'text\': \'Eile (Diese Kreatur kann angreifen und {T}, sobald sie unter deine Kontrolle kommt.)\', \'type\': \'Kreatur — Goblin, Berserker\', \'flavor\': \'Er tobte gegen die Welt, gegen seine Familie, gegen sein Leben. Aber hauptsächlich tobte er.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199708&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4d407e76-431a-4965-880c-c2ef57aa1b2b\', \'multiverseId\': 199708}, \'multiverseid\': 199708}, {\'name\': \'Trasgo furioso\', \'text\': \'Prisa. (Esta criatura puede atacar y {T} tan pronto como entre bajo tu control.)\', \'type\': \'Criatura — Berserker trasgo\', \'flavor\': \'Estaba furioso con su mundo, con su familia, con su vida. Pero principalmente, sólo estaba furioso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200704&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5959cadc-8501-49ca-8552-74d30e9b7249\', \'multiverseId\': 200704}, \'multiverseid\': 200704}, {\'name\': \'Gobelin enragé\', \'text\': \'Célérité (Cette créature peut attaquer et {T} dès le tour où elle arrive sous votre contrôle.)\', \'type\': \'Créature : gobelin et berserker\', \'flavor\': \'Il enrageait contre le monde, contre sa famille, contre lui-même. Mais avant tout, il aimait juste être enragé.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199459&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e436830e-99a6-4315-a5cb-56039edf8984\', \'multiverseId\': 199459}, \'multiverseid\': 199459}, {\'name\': \'Goblin Furioso\', \'text\': \'Rapidità (Questa creatura può attaccare e {T} non appena entra sotto il tuo controllo.)\', \'type\': \'Creatura — Berserker Goblin\', \'flavor\': "E\' arrabbiato con il mondo, con la propria famiglia e con la vita. Più che altro è arrabbiato e basta.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200455&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3db3ce3d-f4f1-406a-9fda-09a8e4dbfa9c\', \'multiverseId\': 200455}, \'multiverseid\': 200455}, {\'name\': \'怒り狂うゴブリン\', \'text\': \'速攻 （このクリーチャーは、あなたのコントロール下になってすぐに攻撃したり{T}したりできる。）\', \'type\': \'クリーチャー — ゴブリン・狂戦士\', \'flavor\': \'彼は世界に対して怒り、家族に対して怒り、自分の人生に対して怒っていた。 だが、だいたいは理由もなく怒っていたんだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199957&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9a2aabf8-7720-41d6-8e17-347dd77d4b80\', \'multiverseId\': 199957}, \'multiverseid\': 199957}, {\'name\': \'Goblin Enfurecido\', \'text\': \'Ímpeto (Esta criatura pode atacar e {T} assim que entra sob seu controle.)\', \'type\': \'Criatura — Goblin Amoque\', \'flavor\': \'Ele se enfurecia com o mundo, com sua família, com sua vida. Mas acima de tudo, ele se enfurecia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199210&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'51b22be5-0bd7-46cf-96e6-230f9fe46389\', \'multiverseId\': 199210}, \'multiverseid\': 199210}, {\'name\': \'Разъяренный Гоблин\', \'text\': \'Ускорение (Это существо может атаковать и {T}, как только оно попадает под ваш контроль.)\', \'type\': \'Существо — Гоблин Берсерк\', \'flavor\': \'Он злился на мир, на семью, на свою жизнь. А вообще-то, он просто злился.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200206&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b0f00334-f0f1-43fc-9056-160445485b37\', \'multiverseId\': 200206}, \'multiverseid\': 200206}, {\'name\': \'愤怒鬼怪\', \'text\': \'敏捷 （此生物受你操控时便能攻击与{T}。）\', \'type\': \'生物～鬼怪／狂战士\', \'flavor\': \'他对世界、家庭和他的生活都感到愤怒。 但大多时候他只是纯粹愤怒。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200953&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c547e525-6c42-4d70-a09b-7747c5c33807\', \'multiverseId\': 200953}, \'multiverseid\': 200953}]', '[{\'name\': \'Xathrid-Dämon\', \'text\': \'Fliegend, verursacht Trampelschaden\\nOpfere zu Beginn deines Versorgungssegments eine Kreatur außer dem Xathrid-Dämon; dann verliert jeder Gegner Lebenspunkte in Höhe der Stärke der geopferten Kreatur. Falls du keine Kreatur opfern kannst, tappe den Xathrid-Dämon, und du verlierst 7 Lebenspunkte.\', \'type\': \'Kreatur — Dämon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199677&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'36a5c156-bca4-4931-8b4a-92a625db060d\', \'multiverseId\': 199677}, \'multiverseid\': 199677}, {\'name\': \'Demonio de Xathrid\', \'text\': \'Vuela, arrolla.\\nAl comienzo de tu mantenimiento, sacrifica una criatura que no sea el Demonio de Xathrid, luego cada oponente pierde una cantidad de vidas igual a la fuerza de la criatura sacrificada. Si no puedes sacrificar una criatura, gira el Demonio de Xathrid y pierde 7 vidas.\', \'type\': \'Criatura — Demonio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200673&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a893b6ea-fd43-46da-aae8-4a5b665c50a6\', \'multiverseId\': 200673}, \'multiverseid\': 200673}, {\'name\': \'Démon de Xathrid\', \'text\': \'Vol, piétinement\\nAu début de votre entretien, sacrifiez une créature autre que le Démon de Xathrid, puis chaque adversaire perd un nombre de points de vie égal à la force de la créature sacrifiée. Si vous ne pouvez pas sacrifier de créature, engagez le Démon de Xathrid et vous perdez 7 points de vie.\', \'type\': \'Créature : démon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199428&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'67d29231-9c3e-444a-9b88-1ae19d900a6a\', \'multiverseId\': 199428}, \'multiverseid\': 199428}, {\'name\': \'Demone di Xathrid\', \'text\': "Volare, travolgere\\nAll\'inizio del tuo mantenimento, sacrifica una creatura diversa dal Demone di Xathrid , poi ogni avversario perde punti vita pari alla forza della creatura sacrificata. Se non puoi sacrificare una creatura, TAPpa il Demone di Xathrid e perdi 7 punti vita.", \'type\': \'Creatura — Demone\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200424&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'97010b4c-6d48-4d5b-b44c-2a313665fafe\', \'multiverseId\': 200424}, \'multiverseid\': 200424}, {\'name\': \'ザスリッドの悪魔\', \'text\': \'飛行、トランプル\\nあなたのアップキープの開始時に、ザスリッドの悪魔以外のクリーチャーを１体生け贄に捧げ、その後、各対戦相手はその生け贄に捧げられたクリーチャーのパワーに等しい点数のライフを失う。 あなたがクリーチャーを生け贄に捧げられない場合、ザスリッドの悪魔をタップし、あなたは７点のライフを失う。\', \'type\': \'クリーチャー — デーモン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199926&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7fbf760f-d43d-4993-be5b-68d065876436\', \'multiverseId\': 199926}, \'multiverseid\': 199926}, {\'name\': \'Demônio de Xathrid\', \'text\': \'Voar, atropelar\\nNo início de sua manutenção, sacrifique uma criatura que não seja Demônio de Xathrid. Depois, cada oponente perde uma quantidade de pontos de vida igual ao poder da criatura sacrificada. Se você não puder sacrificar uma criatura, vire Demônio de Xathrid e perca 7 pontos de vida.\', \'type\': \'Criatura — Demônio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199179&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0cad2719-5509-4a5f-8682-571250598b3a\', \'multiverseId\': 199179}, \'multiverseid\': 199179}, {\'name\': \'Демон Затрида\', \'text\': \'Полет, Пробивной удар\\nВ начале вашего шага поддержки пожертвуйте существо, отличное от Демона Затрида, затем каждый оппонент теряет количество жизней, равное силе пожертвованного существа. Если вы не можете пожертвовать существо, поверните Демона Затрида и вы теряете 7 жизней.\', \'type\': \'Существо — Демон\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200175&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e703adb1-e5da-4ec8-976a-6775ea1c58c9\', \'multiverseId\': 200175}, \'multiverseid\': 200175}, {\'name\': \'札兹离恶魔\', \'text\': \'飞行，践踏\\n在你的维持开始时，牺牲一个札兹离恶魔以外的生物，然后每位对手各失去若干生命，其数量等同于所牺牲之生物的力量。 如果你无法牺牲生物，则横置札兹离恶魔且你失去7点生命。\', \'type\': \'生物～恶魔\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200922&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'562b5f22-05bc-488c-903d-e2333104b4b4\', \'multiverseId\': 200922}, \'multiverseid\': 200922}]', "[{'name': 'Xathrids Tempeldienerin', 'text': '{1}{B}, {T}: Ein Spieler deiner Wahl verliert 1 Lebenspunkt.', 'type': 'Kreatur — Mensch, Kleriker', 'flavor': 'Wie alle Priesterinnen segnet sie nur diejenigen, die es wert sind.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199638&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'ea5249a4-2128-4771-a3e1-9b31b3ad2f0c', 'multiverseId': 199638}, 'multiverseid': 199638}, {'name': 'Acólita de Xathrid', 'text': '{1}{B}, {T}: El jugador objetivo pierde 1 vida.', 'type': 'Criatura — Clérigo humano', 'flavor': 'Como todos los sacerdotes, ella bendice sólo a aquellos que realmente se lo merecen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200634&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c4debbe5-b282-40d4-a97d-8025c1bf3fac', 'multiverseId': 200634}, 'multiverseid': 200634}, {'name': 'Acolyte de Xathrid', 'text': '{1}{B}, {T} : Le joueur ciblé perd 1 point de vie.', 'type': 'Créature : humain et clerc', 'flavor': 'Comme tous les prêtres, elle ne bénit que ceux qui en sont dignes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199389&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ccce739b-ac4b-48f5-b4ac-358e80249d7b', 'multiverseId': 199389}, 'multiverseid': 199389}, {'name': 'Accolita di Xathrid', 'text': '{1}{B}, {T}: Un giocatore bersaglio perde 1 punto vita.', 'type': 'Creatura — Chierico Umano', 'flavor': 'Come tutti i sacerdoti, dà la sua benedizione solo a quanti realmente la meritano.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200385&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '86783d9b-f3fd-4ac8-90df-3ae5185c6c24', 'multiverseId': 200385}, 'multiverseid': 200385}, {'name': 'ザスリッドの見習い僧', 'text': '{1}{B}, {T}：プレイヤー１人を対象とする。そのプレイヤーは１点のライフを失う。', 'type': 'クリーチャー — 人間・クレリック', 'flavor': '全ての僧侶と同様に、彼女も真に価値のあるものにのみ祝福を与える。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199887&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9b5f7707-d656-44b0-8f3b-4e261e5c80c7', 'multiverseId': 199887}, 'multiverseid': 199887}, {'name': 'Acólito de Xathrid', 'text': '{1}{B}, {T}: O jogador alvo perde 1 ponto de vida.', 'type': 'Criatura — Humano Clérigo', 'flavor': 'Como todos os sacerdotes, ela abençoa apenas aqueles que realmente merecem.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199140&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd38a9bcf-20fc-438e-b2ac-99540ba086c7', 'multiverseId': 199140}, 'multiverseid': 199140}, {'name': 'Служительница Затрида', 'text': '{1}{B}, {T}: целевой игрок теряет 1 жизнь.', 'type': 'Существо — Человек Священник', 'flavor': 'Как все священники, она благословляет только тех, кто этого истинно заслуживает.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200136&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'e5dbf01c-de59-4245-9fea-8177d5a2b7b7', 'multiverseId': 200136}, 'multiverseid': 200136}, {'name': '札兹离侍僧', 'text': '{1}{B}，{T}：目标牌手失去1点生命。', 'type': '生物～人类／僧侣', 'flavor': '她一如所有的僧侣，只替真正值得的人祝福。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200883&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '2c1570d7-98e7-4952-a14f-d9584b6f3f97', 'multiverseId': 200883}, 'multiverseid': 200883}]", '[{\'name\': \'Zauberbann-Rüstung\', \'text\': \'Die ausgerüstete Kreatur erhält +2/+4 und verliert Flugfähigkeit.Verhindere allen Nicht-Kampfschaden, der der ausgerüsteten Kreatur zugefügt würde.\\nAusrüsten {2} ({2}: Lege diese Karte an eine Kreatur deiner Wahl an, die du kontrollierst. Spiele Ausrüsten wie eine Hexerei.)\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199769&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'44e3efc0-d84b-4400-a11e-d3b5c03197b0\', \'multiverseId\': 199769}, \'multiverseid\': 199769}, {\'name\': \'Armadura ruina de magos\', \'text\': \'La criatura equipada obtiene +2/+4 y pierde la habilidad de volar.\\nPrevén todo el daño que no sea de combate que se le fuera a hacer a la criatura equipada.\\nEquipar {2}. ({2}: Anexa este equipo a la criatura objetivo que controles. Juega la habilidad de equipar como un conjuro.)\', \'type\': \'Artefacto — Equipo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200765&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a8b2562a-af43-4da7-a176-30bae680d816\', \'multiverseId\': 200765}, \'multiverseid\': 200765}, {\'name\': \'Armure fléaumage\', \'text\': "La créature équipée gagne +2/+4 et perd le vol.\\nPrévenez toutes les blessures non-combat qui devraient être infligées à la créature équipée.\\nÉquipement {2} ({2} : Attachez à la créature ciblée que vous contrôlez. N\'attachez l\'équipement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Artefact : équipement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199520&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6d4fe2b9-4143-4d8c-8337-a45612a6761f\', \'multiverseId\': 199520}, \'multiverseid\': 199520}, {\'name\': \'Armatura Rovinamaghi\', \'text\': \'La creatura equipaggiata prende +2/+4 e perde volare.\\nPrevieni tutto il danno non da combattimento che verrebbe inflitto alla creatura equipaggiata.\\nEquipaggiare {2} ({2}: Assegna a una creatura bersaglio che controlli. Equipaggia solo quando potresti lanciare una stregoneria.)\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200516&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4e70b90b-c10d-4629-b265-1d89f6069258\', \'multiverseId\': 200516}, \'multiverseid\': 200516}, {\'name\': \'魔道士封じの鎧\', \'text\': \'装備しているクリーチャーは＋２/＋４の修整を受けるとともに飛行を失う。\\n装備しているクリーチャーに与えられるすべての戦闘でないダメージを軽減する。\\n装備 {2} ({2}：あなたがコントロールするクリーチャー１体を対象とし、これをつける。 装備はソーサリーとしてのみ行う。）\', \'type\': \'アーティファクト — 装備品\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200018&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'537d66e8-bcf6-41d0-9a8c-090540e81d85\', \'multiverseId\': 200018}, \'multiverseid\': 200018}, {\'name\': \'Armadura Destrói-Mago\', \'text\': \'A criatura equipada recebe +2/+4 e perde voar.\\nPrevina todo o dano que não seja de combate que seria causado à criatura equipada.\\nEquipar {2} ({2}: Anexe a uma criatura alvo que você controla. Equipe somente quando puder jogar um feitiço.)\', \'type\': \'Artefato — Equipamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199271&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3e94ce60-1558-4f2b-80c6-5b9d15fe8fa8\', \'multiverseId\': 199271}, \'multiverseid\': 199271}, {\'name\': \'Заклятые Доспехи\', \'text\': \'Снаряженное существо получает +2/+4 и теряет Полет.\\nПредотвратите все небоевые повреждения, которые должны быть нанесены снаряженному существу.\\nСнарядить {2} ({2}: прикрепите к целевому существу под вашим контролем. Снаряжайте только как волшебство.)\', \'type\': \'Артефакт — Снаряжение\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200267&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b49eea79-16f7-41c3-b155-76d1bbfb18c4\', \'multiverseId\': 200267}, \'multiverseid\': 200267}, {\'name\': \'克法甲\', \'text\': \'佩带此武具的生物得+2/+4且失去飞行异能。\\n防止将对佩带此武具的生物造成之所有非战斗伤害。\\n佩带{2} （{2}：装备在目标由你操控的生物上； 佩带的时机视同法术。）\', \'type\': \'神器～武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=201014&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6d2a0881-7f97-4350-b44b-98d1f399c336\', \'multiverseId\': 201014}, \'multiverseid\': 201014}]', '[{\'name\': \'Zauberbuch\', \'text\': \'Es gibt keine Obergrenze für die Anzahl der Karten, die du auf der Hand halten darfst.\', \'type\': \'Artefakt\', \'flavor\': \'„Alles, was die weise Frau lernte, schrieb sie in ihr Buch, und als die Seiten schwarz vor Tinte waren, nahm sie weiße Tinte und begann von vorn." —Karn, Silbergolem\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199775&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ca91e27c-8dfc-4fe7-ac1b-616ede4cc340\', \'multiverseId\': 199775}, \'multiverseid\': 199775}, {\'name\': \'Libro de hechizos\', \'text\': \'Tu mano no tiene tamaño máximo.\', \'type\': \'Artefacto\', \'flavor\': \'"Todo lo que la mujer sabia aprendió lo escribió en un libro, y cuando las páginas estuvieron negras de tinta, tomó tinta blanca y comenzó de nuevo." —Karn, gólem de plata\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200771&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'45f078a6-003d-4ee7-98c1-d63bca89fddb\', \'multiverseId\': 200771}, \'multiverseid\': 200771}, {\'name\': \'Livre de sorts\', \'text\': "Il n\'y a pas de limite au nombre de cartes dans votre main.", \'type\': \'Artefact\', \'flavor\': "« Tout ce que la femme sage apprit, elle le consigna dans un livre. Et quand toutes les pages furent couvertes d\'encre noire, elle prit de l\'encre blanche et recommença. » —Karn, golem d\'argent", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199526&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2ee9c944-c0ac-4850-b1ee-13512b99f429\', \'multiverseId\': 199526}, \'multiverseid\': 199526}, {\'name\': \'Libro delle Magie\', \'text\': \'Non hai un limite massimo di carte nella tua mano.\', \'type\': \'Artefatto\', \'flavor\': \'"La saggia era solita annotare tutto ciò che imparava e quando le pagine furono nere d\\\'inchiostro, prese l\\\'inchiostro bianco e ricominciò." —Karn, golem d\\\'argento\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200522&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'061d28a9-35d0-4b1c-be0f-06af43c14ba1\', \'multiverseId\': 200522}, \'multiverseid\': 200522}, {\'name\': \'呪文書\', \'text\': \'あなたの手札の上限はなくなる。\', \'type\': \'アーティファクト\', \'flavor\': \'あの賢い女性は学んだことをすべて本に書き記したんです。ページがインクで真っ黒になると、白いインクでまた書き始めたんです。 ――銀のゴーレム、カーン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200024&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d1258fee-3c51-467b-90eb-d37820e8aadf\', \'multiverseId\': 200024}, \'multiverseid\': 200024}, {\'name\': \'Livro de Mágicas\', \'text\': \'Não há limite para o número máximo de cards em sua mão.\', \'type\': \'Artefato\', \'flavor\': \'"Tudo o que a mulher sábia aprendia, ela escrevia num livro e, quando as páginas estavam negras de tinta, ela pegava tinta branca e recomeçava a escrever." — Karn, golem de prata\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199277&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'16591e00-6738-405b-a4c5-9de35deef7d4\', \'multiverseId\': 199277}, \'multiverseid\': 199277}, {\'name\': \'Книга Заклинаний\', \'text\': \'Размер вашей руки неограничен.\', \'type\': \'Артефакт\', \'flavor\': \'«Все, что узнавала мудрая женщина, она записывала в книгу. Когда же страницы стали черными от чернил, она взяла белые чернила и начала все заново». — Карн, серебряный голем\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200273&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'51ed99ab-9c9b-4f13-b3bd-375444bd03d5\', \'multiverseId\': 200273}, \'multiverseid\': 200273}, {\'name\': \'法术书\', \'text\': \'你的手牌数量没有上限。\', \'type\': \'神器\', \'flavor\': \'「这个聪慧女子将所学的每样东西都写进书里；最后每一页都被墨水涂黑了，她又改用白墨水，重新开始。」 ～银魔像卡恩\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=201020&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a2bb6b6f-c288-4fc0-bcff-7919a7aa2746\', \'multiverseId\': 201020}, \'multiverseid\': 201020}]', "[{'name': 'Zeitschleife', 'text': 'Ein Spieler deiner Wahl erhält nach diesem Zug einen zusätzlichen Zug.', 'type': 'Hexerei', 'flavor': 'Freu dich nicht zu früh, wenn du den ersten Ansturm überstanden hast.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199630&type=card', 'language': 'German', 'identifiers': {'scryfallId': '370ed66a-3722-4731-b233-8d5b654db0a6', 'multiverseId': 199630}, 'multiverseid': 199630}, {'name': 'Distorsión temporal', 'text': 'El jugador objetivo toma un turno adicional después de éste.', 'type': 'Conjuro', 'flavor': 'Justo cuando creías que habías sobrevivido a la primera ola.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200626&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '9e4bee6e-95d4-438d-b396-efba97dea04a', 'multiverseId': 200626}, 'multiverseid': 200626}, {'name': 'Distorsion temporelle', 'text': 'Le joueur ciblé joue un tour supplémentaire après celui-ci.', 'type': 'Rituel', 'flavor': 'Et vous pensiez avoir survécu à la première vague.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199381&type=card', 'language': 'French', 'identifiers': {'scryfallId': '71812aa8-f7d6-4a2c-a31e-20e33a367f90', 'multiverseId': 199381}, 'multiverseid': 199381}, {'name': 'Distorsione Temporale', 'text': 'Un giocatore bersaglio gioca un altro turno dopo questo.', 'type': 'Stregoneria', 'flavor': 'Proprio quando pensavi di essere sopravvissuto alla prima ondata.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200377&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '4432b6cf-6d4a-4b5a-b839-f1634e2c51d7', 'multiverseId': 200377}, 'multiverseid': 200377}, {'name': '時間のねじれ', 'text': 'プレイヤー１人を対象とする。そのプレイヤーは、このターンに続いて追加の１ターンを行う。', 'type': 'ソーサリー', 'flavor': '第一波を凌いだと思ったその刹那。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199879&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '3a106b17-07e2-4fda-b56c-2afa7fd9a78b', 'multiverseId': 199879}, 'multiverseid': 199879}, {'name': 'Distorção Temporal', 'text': 'O jogador alvo joga um turno extra após este turno.', 'type': 'Feitiço', 'flavor': 'E você achou que tinha sobrevivido à primeira onda.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199132&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'bd489718-e499-4cd8-9707-640290fd1e5f', 'multiverseId': 199132}, 'multiverseid': 199132}, {'name': 'Искривление Времени', 'text': 'Целевой игрок делает дополнительный ход после этого хода.', 'type': 'Волшебство', 'flavor': 'Только вы подумали, что пережили первую волну...', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200128&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '1c3168db-9e3e-4924-a572-97a1f12b87fe', 'multiverseId': 200128}, 'multiverseid': 200128}, {'name': '时间弯曲', 'text': '目标牌手在本回合后进行额外的一个回合。', 'type': '法术', 'flavor': '就在你以为自己从第一波活下来后。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200875&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '370a9d67-6401-428a-a65e-3591704bfe49', 'multiverseId': 200875}, 'multiverseid': 200875}]", '[{\'name\': \'Zentauren-Renner\', \'type\': \'Kreatur — Zentaur, Krieger\', \'flavor\': \'„Zentauren kennen die wahre Freiheit. Nie wird die Versuchung sie zähmen oder die Furcht sie übermannen. Sie leben in vollkommener Harmonie, was wir noch lange nicht erreicht haben." —Ramal, Weiser aus Westtor\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199727&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9e03ef1a-76ac-4357-8706-5340e7dfaa87\', \'multiverseId\': 199727}, \'multiverseid\': 199727}, {\'name\': \'Cazador centauro\', \'type\': \'Criatura — Guerrero centauro\', \'flavor\': \'"Los centauros son realmente libres. Nunca serán dominados por la tentación o controlados por el miedo. Viven en completa armonía, algo todavía no logrado por nuestra gente." —Ramal, sabio del Portón Occidental\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200723&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'51d08184-9f54-43e6-8d62-2f003356f34c\', \'multiverseId\': 200723}, \'multiverseid\': 200723}, {\'name\': \'Coursier centaure\', \'type\': \'Créature : centaure et guerrier\', \'flavor\': "« Les centaures sont véritablement libres. Il ne seront jamais apprivoisés par la tentation ou contrôlés par la peur. Ils vivent en parfaite harmonie, un exploit que nous sommes encore loin d\'accomplir. » —Ramal, sage de Portorient", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199478&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'252a7049-ad0c-4b27-87c6-38c2c59b0e4e\', \'multiverseId\': 199478}, \'multiverseid\': 199478}, {\'name\': \'Corsiera Centaura\', \'type\': \'Creatura — Guerriero Centauro\', \'flavor\': \'"I centauri sono realmente liberi. Non saranno mai domati dalla tentazione né controllati dalla paura. Vivono in totale armonia, un\\\'impresa non ancora realizzata dalla nostra gente." —Ramal, saggio di Westgate\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200474&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6dac0038-fa9d-4685-b4e0-1df9d66cfa0e\', \'multiverseId\': 200474}, \'multiverseid\': 200474}, {\'name\': \'ケンタウルスの狩猟者\', \'type\': \'クリーチャー — ケンタウルス・戦士\', \'flavor\': \'「ケンタウルスは真に自由だ。 誘惑に負けることもなければ、恐怖に操られることもない。 彼らの生き様は、我らの類がまだ達していない完全な調和を成している。」 ――西門の賢者、ラマール\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199976&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7813c3e2-ed81-4e6b-9ec6-061cfd6280ce\', \'multiverseId\': 199976}, \'multiverseid\': 199976}, {\'name\': \'Centaura-Caçadora\', \'type\': \'Criatura — Centauro Guerreiro\', \'flavor\': \'"Os centauros são verdadeiramente livres. Não são domados pela tentação nem controlados pelo medo. Vivem em total harmonia — um feito ainda não alcançado por nossa raça." —Ramal, sábio de Portão Oeste\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199229&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b1999f64-7f0f-4b3a-a977-165002b8eaea\', \'multiverseId\': 199229}, \'multiverseid\': 199229}, {\'name\': \'Быстроногий Кентавр\', \'type\': \'Существо — Кентавр Воин\', \'flavor\': \'«Кентавры по-настоящему свободны. Их нельзя ни укротить соблазном, ни подчинить страхом. Они живут в полной гармонии, до сих пор не ведомой таким, как мы». — Рамаль, мудрец из Вестгейта\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200225&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'473d0253-3488-48a3-8b6d-72c898604196\', \'multiverseId\': 200225}, \'multiverseid\': 200225}, {\'name\': \'半人骏马\', \'type\': \'生物～半人马／战士\', \'flavor\': \'「半人马享有真正的自由。 他们永远不会因诱惑而被驯服，也不会因恐惧而遭控制。 生活在完全的和谐中，这是我们族类尚未达到的境界。」 ～西门智者拉默\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200972&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d1548c33-d0d0-443b-81db-ad622498dc95\', \'multiverseId\': 200972}, \'multiverseid\': 200972}]', '[{\'name\': \'Zersplittern\', \'text\': \'Zerstöre ein Artefakt deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'Tage der Planung. Wochen der Herstellung. Monate der Perfektionierung. Sekunden der Zerstörung.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199710&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'db25a7ea-1d15-4f92-a8a6-214418528b0f\', \'multiverseId\': 199710}, \'multiverseid\': 199710}, {\'name\': \'Romper\', \'text\': \'Destruye el artefacto objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'Días planeando. Semanas construyendo. Meses perfeccionando. Segundos aplastando.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200706&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c2fd1143-f723-4a13-9137-31f5b6575baa\', \'multiverseId\': 200706}, \'multiverseid\': 200706}, {\'name\': \'Fracasser\', \'text\': "Détruisez l\'artefact ciblé.", \'type\': \'Éphémère\', \'flavor\': \'Des jours de préparation. Des semaines de construction. Des mois de finition. Quelques secondes de destruction.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199461&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1c1c51cb-15cf-4030-b7da-c19ba3023b1e\', \'multiverseId\': 199461}, \'multiverseid\': 199461}, {\'name\': \'Distruggi Artefatto\', \'text\': \'Distruggi un artefatto bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'Giorni per progettarlo. Settimane per costruirlo. Mesi per perfezionarlo. Secondi per distruggerlo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200457&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'23c4d5c6-84c9-4014-bab2-f1db0b9f9556\', \'multiverseId\': 200457}, \'multiverseid\': 200457}, {\'name\': \'粉砕\', \'text\': \'アーティファクト１つを対象とし、それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'計画には数日。 建設には数週。 完成には数ヶ月。 破壊には数秒。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199959&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8d22a193-e955-4870-b383-d7f40a429754\', \'multiverseId\': 199959}, \'multiverseid\': 199959}, {\'name\': \'Estilhaçar\', \'text\': \'Destrua o artefato alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Dias planejando. Semanas construindo. Meses aperfeiçoando. Segundos estraçalhando.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199212&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'85396aac-c8a1-45a9-a352-347df9f1c6ea\', \'multiverseId\': 199212}, \'multiverseid\': 199212}, {\'name\': \'Раскол\', \'text\': \'Уничтожьте целевой артефакт.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Что планировалось днями, строилось неделями, совершенствовалось месяцами, разбивается в секунды.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200208&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'97dc1ba3-f224-484d-af65-62ef695f47c5\', \'multiverseId\': 200208}, \'multiverseid\': 200208}, {\'name\': \'粉碎\', \'text\': \'消灭目标神器。\', \'type\': \'瞬间\', \'flavor\': \'数日的计划， 数周的建造， 以及数月的整饰， 只要数秒就能破坏。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200955&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'04931c74-14d3-44a1-bd3e-0a493ba3fb25\', \'multiverseId\': 200955}, \'multiverseid\': 200955}]', '[{\'name\': \'Zertrampelndes Nashorn\', \'text\': \'Verursacht Trampelschaden (Falls diese Kreatur ihren Blockern genug Schaden zufügen würde, um sie zu zerstören, kannst du sie den Rest des Schadens dem verteidigenden Spieler oder Planeswalker zufügen lassen.)\', \'type\': \'Kreatur — Nashorn\', \'flavor\': \'„Manchmal frage ich mich, ob unsere Waffen und Rüstungen nicht ein Schritt in die falsche Richtung sind." —Soron, Rhox-Spießmeister\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199759&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d32d6463-1cd5-40c7-bbc8-fa465cbf655f\', \'multiverseId\': 199759}, \'multiverseid\': 199759}, {\'name\': \'Rinoceronte en estampida\', \'text\': \'Arrolla. (Si esta criatura fuera a hacer suficiente daño a sus bloqueadores como para destruirlos, puedes hacer que le haga el resto del daño al jugador o planeswalker defensor.)\', \'type\': \'Criatura — Rinoceronte\', \'flavor\': \'"A veces me pregunto si nuestras armas y armaduras no son un paso atrás." —Soron, maestro lancero rhox\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200755&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4dfe0bae-bfc6-4930-9c16-5f471ff87545\', \'multiverseId\': 200755}, \'multiverseid\': 200755}, {\'name\': \'Ruée de rhinocéros\', \'text\': "Piétinement (Si cette créature inflige suffisamment de blessures de combat à ses bloqueurs pour les détruire, vous pouvez faire qu\'elle inflige le reste de ses blessures au joueur ou au planeswalker défenseur.)", \'type\': \'Créature : rhinocéros\', \'flavor\': \'« Parfois, je me demande si nos armes et nos armures ne représentent pas une forme de handicap. » —Soron, maître piqueur rhox\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199510&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c2af2d00-da4f-4b18-a73e-0590f3e9054d\', \'multiverseId\': 199510}, \'multiverseid\': 199510}, {\'name\': \'Rinoceronte in Fuga\', \'text\': \'Travolgere (Se questa creatura sta per infliggere alle sue creature bloccanti danno sufficiente a distruggerle, puoi farle infliggere il resto del suo danno al giocatore in difesa o a un planeswalker.)\', \'type\': \'Creatura — Rinoceronte\', \'flavor\': \'"A volte mi chiedo se le nostre armi e armature non siano un passo indietro." —Soron, rhox picchiere\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200506&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'43a8ff7b-b581-4529-8d30-68aa2c7c6460\', \'multiverseId\': 200506}, \'multiverseid\': 200506}, {\'name\': \'暴走するサイ\', \'text\': \'トランプル （このクリーチャーが、自身をブロックしているすべてのクリーチャーを破壊するのに十分なダメージを与える場合、あなたはそれの残りのダメージを防御プレイヤーかプレインズウォーカーに与えてもよい。）\', \'type\': \'クリーチャー — サイ\', \'flavor\': \'「時々、俺たちの武器とか鎧は退化してるんじゃないかって思うんだ。」 ――ロウクスの長槍の達人、ソロン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200008&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'97f06910-5a73-404e-98d3-33a2bd8eb6fe\', \'multiverseId\': 200008}, \'multiverseid\': 200008}, {\'name\': \'Rinoceronte Desembestado\', \'text\': \'Atropelar (Se esta criatura fosse causar dano suficiente para destruir seus bloqueadores, você pode fazer com que ela cause o resto de seu dano ao planeswalker ou jogador defensor.)\', \'type\': \'Criatura — Rinoceronte\', \'flavor\': \'"Às vezes me pergunto se nossas armas e armaduras não estão obsoletas." —Soron, rhox mestre de lança\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199261&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'73e325eb-4891-4329-b803-8be6feb5d06a\', \'multiverseId\': 199261}, \'multiverseid\': 199261}, {\'name\': \'Мчащийся Носорог\', \'text\': \'Пробивной удар (Если это существо нанесло достаточно повреждений, чтобы уничтожить блокирующие его существа, вы можете заставить его нанести оставшиеся повреждения защищающемуся игроку или planeswalker-у.)\', \'type\': \'Существо — Носорог\', \'flavor\': \'«Иногда мне кажется, что наше оружие и доспехи — это шаг назад». — Сорон, рокс-пикинер\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200257&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6942ee41-46a5-4895-ac92-8883ac11b836\', \'multiverseId\': 200257}, \'multiverseid\': 200257}, {\'name\': \'狂奔犀牛\', \'text\': \'践踏 （如果此生物将造成的伤害足以消灭所有阻挡它的生物，你可以使它对防御牌手或鹏洛客造成所剩余数量的伤害。）\', \'type\': \'生物～犀牛\', \'flavor\': \'「有时我会怀疑我们的武器与铠甲是不是落后了点。」 ～罗克长矛精兵索隆\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=201004&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e0e92307-81e1-46a0-a321-79d40ad37070\', \'multiverseId\': 201004}, \'multiverseid\': 201004}]', "[{'name': 'Zobelbrauner Riesenhirsch', 'text': 'Der Zobelbraune Riesenhirsch kann nicht neutralisiert werden.\\nSchutz vor Blau und vor Schwarz (Diese Kreatur kann von nichts Blauem oder Schwarzem geblockt oder als Ziel bestimmt werden, von ihm Schaden zugefügt bekommen oder von ihm verzaubert werden.)', 'type': 'Kreatur — Hirsch', 'flavor': 'Schwer zu beschreiben und zu verhindern.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199741&type=card', 'language': 'German', 'identifiers': {'scryfallId': '02b63c88-adb9-45a1-ac01-8ef7d4c86f8f', 'multiverseId': 199741}, 'multiverseid': 199741}, {'name': 'Gran ciervo cibelino', 'text': 'El Gran ciervo cibelino no puede ser contrarrestado.\\nProtección contra azul y contra negro. (Esta criatura no puede ser bloqueada, hecha objetivo, recibir daño de o estar encantada por nada azul o negro.)', 'type': 'Criatura — Alce', 'flavor': 'Inefable e incorruptible.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200737&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c800c5c2-f432-4bd9-b32a-56b1c1c40947', 'multiverseId': 200737}, 'multiverseid': 200737}, {'name': 'Grand cerf-zibeline', 'text': 'Le Grand cerf-zibeline ne peut pas être contrecarré.\\nProtection contre le bleu et contre le noir (Cette créature ne peut pas être bloquée, ciblée, blessée ou enchantée par quoi que ce soit de bleu ou de noir.)', 'type': 'Créature : élan', 'flavor': 'Ineffable et incorruptible.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199492&type=card', 'language': 'French', 'identifiers': {'scryfallId': '3f393efb-7598-417e-86b9-2640465cca5f', 'multiverseId': 199492}, 'multiverseid': 199492}, {'name': 'Grande Zibellalce', 'text': 'La Grande Zibellalce non può essere neutralizzata.\\nProtezione dal blu e dal nero (Questa creatura non può essere bloccata, bersagliata, non le può essere inflitto danno, né può essere incantata da nulla di blu o nero.)', 'type': 'Creatura — Alce', 'flavor': 'Ineffabile e incorruttibile.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200488&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '769cfc22-eb49-4161-ad21-0f1bcdf744b8', 'multiverseId': 200488}, 'multiverseid': 200488}, {'name': '大貂皮鹿', 'text': '大貂皮鹿は打ち消されない。\\nプロテクション（青）、プロテクション（黒） （このクリーチャーは青か黒のものに対して、ブロックされず、対象にならず、ダメージを与えられず、エンチャントされない。）', 'type': 'クリーチャー — 大鹿', 'flavor': '気宇壮大にして、清廉潔白。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199990&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '0d09e80a-7217-47e5-82c1-650448fd0f62', 'multiverseId': 199990}, 'multiverseid': 199990}, {'name': 'Grande Palanca Vermelha', 'text': 'Grande Palanca Vermelha não pode ser anulado.\\nProteção contra o azul e o preto (Esta criatura não pode ser bloqueada, ser alvo, sofrer dano nem ser encantada por qualquer coisa da cor azul ou preta.)', 'type': 'Criatura — Alce', 'flavor': 'Inefável e incorruptível.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199243&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'bf0515b0-1415-498e-988a-d53d82770030', 'multiverseId': 199243}, 'multiverseid': 199243}, {'name': 'Благородный Олень-Соболь', 'text': 'Благородный Олень-Соболь не может быть отменен.\\nЗащита от синего и от черного (Ни один синий или черный объект не может блокировать это существо, делать его своей целью, наносить ему повреждения и зачаровывать его.)', 'type': 'Существо — Вапити', 'flavor': 'Неописуемая красота, неподкупное благородство.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200239&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'b38785a9-f21d-484e-8c66-c22c079c4461', 'multiverseId': 200239}, 'multiverseid': 200239}, {'name': '大型褐雄鹿', 'text': '大型褐雄鹿不能被反击。\\n反蓝保护，反黑保护 （此生物不能被蓝色或黑色的东西所阻挡，指定为目标，造成伤害，或是被结附。）', 'type': '生物～麋鹿', 'flavor': '难以言喻又无法污化。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200986&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '7c40912c-aee5-407e-8e25-cda0f75b58e0', 'multiverseId': 200986}, 'multiverseid': 200986}]", '[{\'name\': \'Zombie-Goliath\', \'type\': \'Kreatur — Zombie, Riese\', \'flavor\': \'„Phirax aus der Blutklamm hat einen kriegerischen Riesen gegen uns aufgehetzt? Muss ich das noch buchstabieren? Tötet den Riesen, höhlt seinen Schädel aus und schleudert ihn zurück in die Blutklamm. Also wirklich, welcher Nekromagier hat euch denn erschaffen?" —Keren-Dur, Nekromagier-Fürst\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199678&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'61128950-6e21-49b0-a51d-d2082ba943af\', \'multiverseId\': 199678}, \'multiverseid\': 199678}, {\'name\': \'Goliat zombie\', \'type\': \'Criatura — Gigante zombie\', \'flavor\': \'"¿Phirax de Risco Sangriento envió un gigante guerrero contra nosotros? ¿Qué tengo que hacer, deletreártelo? Maten al gigante, sáquenle el cráneo y llévenlo de vuelta a Risco Sangriento. En serio, ¿qué clase de sirvientes nigrománticos son ustedes?" —Keren-Dur, señor nigromante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200674&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e5ab82ea-7427-4f45-8c54-e64d40173e1f\', \'multiverseId\': 200674}, \'multiverseid\': 200674}, {\'name\': \'Goliath zombie\', \'type\': \'Créature : zombie et géant\', \'flavor\': "« Phirax des Contreforts de Sang nous envoie un géant de guerre ? Faut-il vraiment que je vous explique tout ? Tuez le géant, évidez son crâne et reconduisez-le aux Contreforts. Vraiment, il n\'y a plus de petit personnel, de nos jours ! » —Keren-Dur, seigneur nécromancien", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199429&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2961cd14-80b6-47e5-b557-8ab14542b095\', \'multiverseId\': 199429}, \'multiverseid\': 199429}, {\'name\': \'Golia Zombie\', \'type\': \'Creatura — Gigante Zombie\', \'flavor\': \'"Phirax di Crinale Sanguinario ci ha mandato contro un gigante della guerra? Beh, devo mettervelo per iscritto? Uccidete il gigante, vuotategli il teschio e rispeditelo a Crinale Sanguinario. Ma insomma, che razza di servitori necromanti siete?" —Keren-Dur, lord necromante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200425&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'51b88e3e-7062-4299-b26d-79ff78494569\', \'multiverseId\': 200425}, \'multiverseid\': 200425}, {\'name\': \'ゾンビの大巨人\', \'type\': \'クリーチャー — ゾンビ・巨人\', \'flavor\': \'「血の峠のファイラックスが巨人兵を送り込んできたと？ で、何じゃ、説明せねばわからんのか？ 巨人を殺し、髑髏を取り出して、それで血の峠を襲い返してやるがよい。 まったく、何のための屍術士の下僕じゃ？」 ――屍術士の王、ケレン＝ドゥール\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199927&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ae116ae6-584c-47d0-9576-8d42fa1d9164\', \'multiverseId\': 199927}, \'multiverseid\': 199927}, {\'name\': \'Golias Zumbi\', \'type\': \'Criatura — Zumbi Gigante\', \'flavor\': \'"Phirax das Montanhas Sanguíneas enviou um gigante guerreiro para nos atacar? E eu ainda tenho de lhes dizer o que fazer? Matem o gigante, esvaziem seu crânio e enviem-no de volta para as Montanhas Sanguíneas. Sinceramente, que espécie de asseclas necromantes vocês são?" —Keren-Dur, lorde necromante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199180&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ec730f64-f57a-4891-9be5-e61ec5c84d47\', \'multiverseId\': 199180}, \'multiverseid\': 199180}, {\'name\': \'Зомби-Голиаф\', \'type\': \'Существо — Зомби Гигант\', \'flavor\': \'«Фиракс Кровавого Хребта натравил на нас боевого гиганта? Мне что, надо вам все растолковывать, как детям? Прикончите гиганта, выскоблите его череп и отправьте труп обратно в горы. Честное слово, некудышные из вас прислужники некроманта!» — Керен-Дур, повелитель некромантов\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200176&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a9bfde61-098c-49e1-8f70-055912759a15\', \'multiverseId\': 200176}, \'multiverseid\': 200176}, {\'name\': \'巨硕灵俑\', \'type\': \'生物～灵俑／巨人\', \'flavor\': \'「血山脊费锐兹派了战巨人来打我们？ 什么，你要我一个个字慢慢念吗？ 杀了巨人，挖出头骨，把它送回血山脊。 我的天，你还算什么死灵术士的仆役？」 ～死灵术士领主格连度\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200923&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9c6f109d-f96a-4d05-aa1b-3159bc2c70e4\', \'multiverseId\': 200923}, \'multiverseid\': 200923}]', '[{\'name\': \'Zwang\', \'text\': \'Ein Gegner deiner Wahl zeigt die Karten auf seiner Hand offen vor. Du bestimmst eine Karte davon, die weder eine Kreatur noch ein Land ist. Dieser Spieler wirft diese Karte ab.\', \'type\': \'Hexerei\', \'flavor\': \'„Keine Panik. Ich werde dir nicht alle Geheimnisse entlocken. Nur das wichtigste." —Liliana Vess\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199651&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a972b748-5586-42b4-85d3-006371a24bab\', \'multiverseId\': 199651}, \'multiverseid\': 199651}, {\'name\': \'Coacción\', \'text\': \'El oponente objetivo muestra su mano. Eliges de ahí una carta que no sea de criatura ni de tierra. Ese jugador descarta esa carta.\', \'type\': \'Conjuro\', \'flavor\': \'"No te preocupes. No voy a quitarte todos tus secretos. Sólo los más valiosos." —Liliana Vess\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200647&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'733b1470-facd-4a2f-922f-b1dd360972e3\', \'multiverseId\': 200647}, \'multiverseid\': 200647}, {\'name\': \'Contrainte\', \'text\': "L\'adversaire ciblé révèle sa main. Vous y choisissez une carte non-terrain, non-créature. Ce joueur se défausse de cette carte.", \'type\': \'Rituel\', \'flavor\': "« Ne vous en faites pas. Je ne vais pas m\'emparer de tous vos secrets. Seulement des plus précieux. » —Liliana Vess", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199402&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'828ea2cf-c9ac-44ce-92ad-07225e0235ab\', \'multiverseId\': 199402}, \'multiverseid\': 199402}, {\'name\': \'Costrizione\', \'text\': \'Un avversario bersaglio rivela la sua mano. Scegli una carta non terra, non creatura da quella mano. Quel giocatore scarta quella carta.\', \'type\': \'Stregoneria\', \'flavor\': \'"Non preoccuparti. Non ti sottrarrò tutti i tuoi segreti. Solo quello più prezioso." —Liliana Vess\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200398&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ea78d6df-8071-47c7-a0a6-1d92da674b05\', \'multiverseId\': 200398}, \'multiverseid\': 200398}, {\'name\': \'強迫\', \'text\': \'対戦相手１人を対象とする。そのプレイヤーは自分の手札を公開する。 あなたはその中のクリーチャーでも土地でもないカードを１枚選ぶ。 そのプレイヤーはそのカードを捨てる。\', \'type\': \'ソーサリー\', \'flavor\': \'「心配しなくていいよ。 お前の秘密を全部奪うつもりはない。 一番大事なやつだけさ。」 ――リリアナ・ヴェス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199900&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'404eedba-5f4a-4014-a335-a84bdeea1b9b\', \'multiverseId\': 199900}, \'multiverseid\': 199900}, {\'name\': \'Coergir\', \'text\': \'O oponente alvo revela sua própria mão. Você escolhe um card que não seja uma criatura nem um terreno da mão dele. Aquele jogador descarta aquele card.\', \'type\': \'Feitiço\', \'flavor\': \'"Não tema. Não vou me apoderar de todos os seu segredos. Apenas o mais precioso." —Liliana Vess\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199153&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6abe6041-455d-4612-937d-941d5a139a9d\', \'multiverseId\': 199153}, \'multiverseid\': 199153}, {\'name\': \'Насилие\', \'text\': \'Целевой оппонент показывает свою руку. Вы выбираете из нее карту, не являющуюся ни существом, ни землей. Тот игрок сбрасывает ту карту.\', \'type\': \'Волшебство\', \'flavor\': \'«Не беспокойся. Я не собираюсь лишать тебя всех твоих секретов. Только самых ценных». — Лилиана Весс\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200149&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'97e63290-1063-43eb-9c97-3594aa93df52\', \'multiverseId\': 200149}, \'multiverseid\': 200149}, {\'name\': \'逼从\', \'text\': \'目标对手展示其手牌。 你选择其中一张非生物且非地的牌。 该牌手弃掉该牌。\', \'type\': \'法术\', \'flavor\': \'「别担心， 我不会把你所有的秘密都夺走。 我只拿最珍贵的那个。」 ～莉莲娜维斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200896&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d561bd52-b5ed-4536-a3b7-37f23b335b18\', \'multiverseId\': 200896}, \'multiverseid\': 200896}]', '[{\'name\': \'Zwillingszauber\', \'text\': \'Kopiere einen Spontanzauber oder eine Hexerei deiner Wahl. Du kannst neue Ziele für die Kopie bestimmen.\', \'type\': \'Spontanzauber\', \'flavor\': \'Nachahmung ist die gefährlichste Art des Schmeichelns.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199633&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cd4a4b73-68ee-4218-9a67-6bc7a601a8ce\', \'multiverseId\': 199633}, \'multiverseid\': 199633}, {\'name\': \'Jugada gemela\', \'text\': \'Copia el hechizo objetivo de instantáneo o de conjuro. Puedes elegir nuevos objetivos para la copia.\', \'type\': \'Instantáneo\', \'flavor\': \'La imitación es la forma más peligrosa de adulación.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200629&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'78134094-3e5e-4342-8082-edd3bcd92096\', \'multiverseId\': 200629}, \'multiverseid\': 200629}, {\'name\': \'Jumelance\', \'text\': "Copiez le sort d\'éphémère ou de rituel ciblé. Vous pouvez choisir de nouvelles cibles pour cette copie.", \'type\': \'Éphémère\', \'flavor\': "L\'imitation est la forme la plus dangereuse de la flatterie.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199384&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3299baa9-0ff2-4783-be4d-96d8dc8c899d\', \'multiverseId\': 199384}, \'multiverseid\': 199384}, {\'name\': \'Doppio Lancio\', \'text\': \'Copia una magia istantaneo o stregoneria bersaglio. Puoi scegliere nuovi bersagli per la copia.\', \'type\': \'Istantaneo\', \'flavor\': "L\'imitazione è la forma d\'adulazione più pericolosa.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200380&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e8d7dc45-6baa-491c-8d02-10bebd5bf279\', \'multiverseId\': 200380}, \'multiverseid\': 200380}, {\'name\': \'双つ術\', \'text\': \'インスタント呪文１つかソーサリー呪文１つを対象とし、それをコピーする。 あなたはそのコピーの新しい対象を選んでもよい。\', \'type\': \'インスタント\', \'flavor\': \'模倣は最も危険な形のお世辞だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199882&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'29e9948d-942b-4c8c-a5cc-1b7d43b40447\', \'multiverseId\': 199882}, \'multiverseid\': 199882}, {\'name\': \'Conjuração Dupla\', \'text\': \'Copie a mágica instantânea ou feitiço alvo. Você pode escolher novos alvos para a cópia.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'A imitação é a forma mais perigosa de bajulação.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199135&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'05553b5b-325c-4c12-989e-369715700e1f\', \'multiverseId\': 199135}, \'multiverseid\': 199135}, {\'name\': \'Парный Бросок\', \'text\': \'Скопируйте целевое мгновенное заклинание или заклинание волшебства. Вы можете выбрать новые цели для этой копии.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Самая опасная лесть — это подражание.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200131&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b30f20c0-43f0-42a8-a4e1-26d66688a87a\', \'multiverseId\': 200131}, \'multiverseid\': 200131}, {\'name\': \'双咒击\', \'text\': \'复制目标瞬间或法术咒语。 你可以为该复制选择新的目标。\', \'type\': \'瞬间\', \'flavor\': \'模仿是恭维的最危险形式。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200878&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'18dc428b-6942-458f-8e0d-c9120545dc62\', \'multiverseId\': 200878}, \'multiverseid\': 200878}]', '[{\'name\': \'Zwischenspurt\', \'text\': \'Kreaturen, die du kontrollierst, haben bis zum Ende des Zuges Eile. (Sie können angreifen und {T}, selbst falls sie gerade erst unter deine Kontrolle gekommen sind.)\', \'type\': \'Hexerei\', \'flavor\': \'Bedeutende Generäle gehen mit gutem Beispiel voran. Goblin-Häuptlinge treiben an, indem sie die Kasernen unter Strom setzen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199684&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'42879785-3bae-4667-9a17-c4fba005b94e\', \'multiverseId\': 199684}, \'multiverseid\': 199684}, {\'name\': \'Estallido de velocidad\', \'text\': \'Las criaturas que controlas ganan la habilidad de prisa hasta el final del turno. (Pueden atacar y {T} incluso si acaban de entrar bajo tu control.)\', \'type\': \'Conjuro\', \'flavor\': \'Los grandes generales inspiran con el ejemplo. Los caciques trasgo inspiran electrificando los barracones.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200680&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5b3a6407-55eb-41b4-818d-f73ee3b8fd29\', \'multiverseId\': 200680}, \'multiverseid\': 200680}, {\'name\': \'Explosion de vitesse\', \'text\': "Les créatures que vous contrôlez acquièrent la célérité jusqu\'à la fin du tour. (Elles peuvent attaquer et {T} même si elles viennent juste d\'arriver sous votre contrôle.)", \'type\': \'Rituel\', \'flavor\': \'Les grands généraux inspirent par leur exemple. Les chefs gobelins le font en électrifiant les baraquements.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199435&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0a97b4ac-4131-4231-964c-834751fba363\', \'multiverseId\': 199435}, \'multiverseid\': 199435}, {\'name\': \'Accelerazione\', \'text\': \'Le creature che controlli hanno rapidità fino alla fine del turno. (Possono attaccare e {T} anche se sono appena entrate sotto il tuo controllo.)\', \'type\': \'Stregoneria\', \'flavor\': "I grandi generali ispirano col loro esempio. I capitani goblin con l\'elettrificazione della caserma.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200431&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2aa62fb8-117e-4962-af14-440747e9e25b\', \'multiverseId\': 200431}, \'multiverseid\': 200431}, {\'name\': \'速さの炸裂\', \'text\': \'あなたがコントロールするクリーチャーは、ターン終了時まで速攻を得る。 （それらは、あなたのコントロール下になってすぐに攻撃したり{T}したりできる。）\', \'type\': \'ソーサリー\', \'flavor\': \'偉大なる将軍は実例を示してやる気を起こさせる。 ゴブリンの酋長は兵舎に電気を流してやる気を起こさせる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199933&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d28bbd9e-5686-4064-b269-860c9ece02ed\', \'multiverseId\': 199933}, \'multiverseid\': 199933}, {\'name\': \'Estouro Veloz\', \'text\': \'As criaturas que você controla ganham ímpeto até o final do turno. (Elas podem atacar e {T} mesmo quando acabam de passar ao seu controle.)\', \'type\': \'Feitiço\', \'flavor\': \'Grandes generais servem de inspiração ao dar o exemplo. Líderes goblin servem de inspiração eletrocutando os alojamentos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199186&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e9335197-691b-413b-9970-21a143b3efd4\', \'multiverseId\': 199186}, \'multiverseid\': 199186}, {\'name\': \'Всплеск Скорости\', \'text\': \'Существа под вашим контролем получают Ускорение до конца хода. (Они могут атаковать и {T}, даже если они только что попали под ваш контроль.)\', \'type\': \'Волшебство\', \'flavor\': \'Великие полководцы вдохновляют собственным примером. Гоблинские же предводители вдохновляют, пропуская электрический ток через казармы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200182&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2a227847-e64a-454b-ae80-745fa82e2552\', \'multiverseId\': 200182}, \'multiverseid\': 200182}, {\'name\': \'爆发速度\', \'text\': \'由你操控的生物获得敏捷异能直到回合结束。 （这些生物刚受你操控时便能攻击与{T}。）\', \'type\': \'法术\', \'flavor\': \'伟大将军以自身为榜样来激励下属。 鬼怪酋长则以电流来激励。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200929&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'018928f3-b064-4321-b4e6-8533da4dd501\', \'multiverseId\': 200929}, \'multiverseid\': 200929}]', '[{\'name\': \'Ätzender Schleim\', \'text\': \'Todesberührung (Kreaturen, denen von dieser Kreatur Schaden zugefügt wurde, werden zerstört. Du kannst den Kampfschaden dieser Kreatur auf beliebig viele Kreaturen aufteilen, die sie blockt oder von denen sie geblockt wird.)\\nWenn der Ätzende Schleim ins Spiel kommt, zerstöre ein Artefakt, eine Verzauberung oder ein Land deiner Wahl.\', \'type\': \'Kreatur — Schlammwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199720&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'80d62a6a-c403-4147-8e04-c2f4059f4971\', \'multiverseId\': 199720}, \'multiverseid\': 199720}, {\'name\': \'Fango ácido\', \'text\': \'Toque mortal. (Las criaturas que reciben daño de esta criatura son destruidas. Puedes dividir el daño de combate de esta criatura entre las criaturas que la bloquean o que ella bloquea.)\\nCuando el Fango ácido entre al campo de batalla, destruye el artefacto, encantamiento o tierra objetivo.\', \'type\': \'Criatura — Cieno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200716&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'42974eec-1ebc-4e59-8a0b-d324954c936c\', \'multiverseId\': 200716}, \'multiverseid\': 200716}, {\'name\': \'Boue acide\', \'text\': "Contact mortel (Les créatures qui subissent des blessures de cette créature sont détruites. Vous pouvez partager les blessures de combat de cette créature entre toutes les créatures qui la bloquent ou qu\'elle bloque.)\\nQuand la Boue acide arrive sur le champ de bataille, détruisez l\'artefact, l\'enchantement ou le terrain ciblé.", \'type\': \'Créature : limon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199471&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9fd5e19c-d153-46f4-a588-330cd2bdd38c\', \'multiverseId\': 199471}, \'multiverseid\': 199471}, {\'name\': \'Melma Acida\', \'text\': \'Tocco letale (Le creature a cui è stato inflitto danno da questa creatura vengono distrutte. Puoi dividere il danno da combattimento di questa creatura tra un numero qualsiasi di creature che bloccano o sono bloccate da essa.)\\nQuando la Melma Acida entra nel campo di battaglia, distruggi un artefatto, un incantesimo o una terra bersaglio.\', \'type\': \'Creatura — Melma\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200467&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7e867ff4-617c-437c-8713-96f7bb8309e9\', \'multiverseId\': 200467}, \'multiverseid\': 200467}, {\'name\': \'酸のスライム\', \'text\': \'接死 （このクリーチャーにダメージを与えられたクリーチャーは破壊される。 このクリーチャーの戦闘ダメージは、それがブロックしている、あるいはそれをブロックしているクリーチャーの中で好きなように割り振れる。）\\n酸のスライムが戦場に出たとき、アーティファクト１つかエンチャント１つか土地１つを対象とし、それを破壊する。\', \'type\': \'クリーチャー — ウーズ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199969&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'abc3c800-0282-4506-a8b9-cbdc3435a22f\', \'multiverseId\': 199969}, \'multiverseid\': 199969}, {\'name\': \'Limo Ácido\', \'text\': \'Toque mortífero (Criaturas que sofrem dano causado por essa criatura são destruídas. Você pode dividir o dano de combate dessa criatura entre quaisquer criaturas que a bloqueiem ou sejam bloqueadas por ela.)\\nQuando Limo Ácido entra no campo de batalha, destrua o artefato, encantamento ou terreno alvo.\', \'type\': \'Criatura — Lodo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199222&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ad389e81-1c35-4bbb-842a-dc20864078da\', \'multiverseId\': 199222}, \'multiverseid\': 199222}, {\'name\': \'Кислотная Слизь\', \'text\': \'Смертельное касание (Существа, которым это существо нанесло повреждения, уничтожаются. Вы можете распределить наносимые этим существом боевые повреждения между любыми блокирующими его или заблокированными им существами.)\\nКогда Кислотная Слизь выходит на поле битвы, уничтожьте целевой артефакт, чары или землю.\', \'type\': \'Существо — Тина\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200218&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4ed9845b-1f50-41ca-b9d6-c890af9c953a\', \'multiverseId\': 200218}, \'multiverseid\': 200218}, {\'name\': \'酸液黏菌\', \'text\': \'死触 （受到此生物之伤害的生物会被消灭。 你可以将此生物之战斗伤害在阻挡它或被它阻挡的任何生物之间分配。）\\n当酸液黏菌进战场时，消灭目标神器，结界，或地。\', \'type\': \'生物～流浆\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200965&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2d74bb79-23fd-45ee-a058-9b7d7924ad55\', \'multiverseId\': 200965}, \'multiverseid\': 200965}]', '[{\'name\': \'Überrennen\', \'text\': \'Kreaturen, die du kontrollierst, erhalten +3/+3 und verursachen bis zum Ende des Zuges Trampelschaden. (Falls eine Kreatur, die du kontrollierst, ihren Blockern genug Schaden zufügen würde, um sie zu zerstören, kannst du sie den Rest des Schadens dem verteidigenden Spieler oder Planeswalker zufügen lassen.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199753&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b37d7e4b-d7c3-4c48-afa2-df1ef3689c2b\', \'multiverseId\': 199753}, \'multiverseid\': 199753}, {\'name\': \'Sobrepasar\', \'text\': \'Las criaturas que controles obtienen +3/+3 y ganan la habilidad de arrollar hasta el final del turno. (Si una criatura que controles fuera a hacer suficiente daño a sus bloqueadores como para destruirlos, puedes hacer que le haga el resto del daño al jugador o planeswalker defensor.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200749&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6d85fb57-db30-4560-b13e-e441124f870b\', \'multiverseId\': 200749}, \'multiverseid\': 200749}, {\'name\': \'Envahissement\', \'text\': "Les créatures que vous contrôlez gagnent +3/+3 et acquièrent le piétinement jusqu\'à la fin du tour. (Si une créature que vous contrôlez inflige suffisamment de blessures de combat à ses bloqueurs pour les détruire, vous pouvez faire qu\'elle inflige le reste de ses blessures au joueur ou au planeswalker défenseur.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199504&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'99a86df0-476e-4ba8-b12a-52793d0327e2\', \'multiverseId\': 199504}, \'multiverseid\': 199504}, {\'name\': \'Sopraffare\', \'text\': \'Le creature che controlli prendono +3/+3 e hanno travolgere fino alla fine del turno. (Se una creatura che controlli sta per infliggere alle sue creature bloccanti danno sufficiente a distruggerle, puoi farle infliggere il resto del suo danno al giocatore in difesa o a un planeswalker.)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200500&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2a0e2e33-6e6b-4dd5-8842-472619ea21d9\', \'multiverseId\': 200500}, \'multiverseid\': 200500}, {\'name\': \'踏み荒らし\', \'text\': \'あなたがコントロールするクリーチャーは、ターン終了時まで＋３/＋３の修整を受けるとともにトランプルを得る。 （あなたがコントロールするクリーチャーが、自身をブロックしているすべてのクリーチャーを破壊するのに十分なダメージを与える場合、あなたはそれの残りのダメージを防御プレイヤーやプレインズウォーカーに与えてもよい。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200002&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'02ae8685-e099-4ca8-86f9-b4da7eb98743\', \'multiverseId\': 200002}, \'multiverseid\': 200002}, {\'name\': \'Ultrapassar\', \'text\': \'As criaturas que você controla recebem +3/+3 e ganham atropelar até o final do turno. (Se uma criatura que você controla fosse causar dano suficiente para destruir seus bloqueadores, você pode fazer com que ela cause o resto de seu dano ao jogador ou planeswalker defensor.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199255&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'223cd370-5d19-4987-985b-398295d30c71\', \'multiverseId\': 199255}, \'multiverseid\': 199255}, {\'name\': \'Набег\', \'text\': \'Существа под вашим контролем получают +3/+3 и Пробивной удар до конца хода. (Если существо под вашим контролем нанесло достаточно повреждений, чтобы уничтожить блокирующие его существа, вы можете заставить его нанести оставшиеся повреждения защищающемуся игроку или planeswalker-у.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200251&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5b10f6ab-0aad-40ac-8d97-387f534c7850\', \'multiverseId\': 200251}, \'multiverseid\': 200251}, {\'name\': \'横行\', \'text\': \'由你操控的生物得+3/+3并获得践踏异能直到回合结束。 （如果由你操控的某生物将造成的伤害足以消灭所有阻挡它的生物，你可以使它对防御牌手或鹏洛客造成所剩余数量的伤害。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200998&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'19937168-6096-4fed-8cd7-8f5bef291f71\', \'multiverseId\': 200998}, \'multiverseid\': 200998}]', '[{\'name\': \'Überzeugendes Trugbild\', \'text\': \'Landverzauberung\\nSowie das Überzeugende Trugbild ins Spiel kommt, bestimme einen Standardlandtyp.\\nDas verzauberte Land ist jetzt ein Land dieses Typs.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Wo wir sind? Du musst lernen, sinnvollere Fragen zu stellen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199601&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ed9be9ac-e430-4765-9bb2-5889732868cc\', \'multiverseId\': 199601}, \'multiverseid\': 199601}, {\'name\': \'Espejismo convincente\', \'text\': \'Encantar tierra.\\nEn cuanto el Espejismo convincente entre al campo de batalla, elige un tipo de tierra básica.\\nLa tierra encantada es del tipo elegido.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"¿Dónde estamos? Debes aprender a hacer preguntas más útiles que esa."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200597&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b14a21b5-0ef9-4d42-9faf-945746f0d298\', \'multiverseId\': 200597}, \'multiverseid\': 200597}, {\'name\': \'Mirage convaincant\', \'text\': \'Enchanter : terrain\\nAu moment où le Mirage convaincant arrive sur le champ de bataille, choisissez un type de terrain de base.\\nLe terrain enchanté est du type choisi.\', \'type\': \'Enchantement : aura\', \'flavor\': \'« Où sommes-nous ? Tu dois apprendre à poser des questions plus utiles. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199352&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'917afce5-8bb2-4598-a98a-f1defffaf497\', \'multiverseId\': 199352}, \'multiverseid\': 199352}, {\'name\': \'Miraggio Convincente\', \'text\': \'Incanta terra\\nMentre il Miraggio Convincente entra nel campo di battaglia, scegli un tipo di terra base.\\nLa terra incantata è del tipo scelto.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Dove siamo? Devi imparare a fare domande più utili di questa."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200348&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'62c0d282-d95a-4a82-b940-31b87be98da5\', \'multiverseId\': 200348}, \'multiverseid\': 200348}, {\'name\': \'見紛う蜃気楼\', \'text\': \'エンチャント（土地）\\n見紛う蜃気楼が戦場に出るに際し、基本土地タイプを１つ選ぶ。\\nエンチャントされている土地は、選ばれたタイプである。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「ここはどこだ、だって？ もっと意味のある質問をしてくれよ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199850&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1f220d9f-ba3e-49a2-ac91-0720192884b8\', \'multiverseId\': 199850}, \'multiverseid\': 199850}, {\'name\': \'Miragem Convincente\', \'text\': \'Encantar terreno\\nConforme Miragem Convincente entra no campo de batalha, escolha um tipo de terreno básico.\\nO terreno encantado é do tipo escolhido.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Onde estamos? Você deve aprender a fazer perguntas mais úteis que esta."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199103&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9fd2f32f-83c7-479b-a5fe-37446bbbae23\', \'multiverseId\': 199103}, \'multiverseid\': 199103}, {\'name\': \'Убедительный Мираж\', \'text\': \'Зачаровать землю\\nПри выходе Убедительного Миража на поле битвы, выберите тип базовой земли.\\nЗачарованная земля является землей выбранного типа.\', \'type\': \'Чары — Аура\', \'flavor\': \'«Где мы? Ты должен научиться задавать более полезные вопросы».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200099&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'742faa86-5e6d-40c8-b1ea-ad19d9e723a6\', \'multiverseId\': 200099}, \'multiverseid\': 200099}, {\'name\': \'逼真幻影\', \'text\': \'结附于地\\n于逼真幻影进战场时，选择一个基本地类别。\\n所结附的地为该类别。\', \'type\': \'结界～灵气\', \'flavor\': \'「我们在哪里？ 你得学会提出比这更有用的问题。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200846&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e11765a1-f46e-4723-be25-b493e9bc81f4\', \'multiverseId\': 200846}, \'multiverseid\': 200846}]']
