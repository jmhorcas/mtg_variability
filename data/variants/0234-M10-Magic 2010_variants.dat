er.wizards.com/Handlers/Image.ashx?multiverseid=199551&type=card', 'language': 'French', 'identifiers': {'scryfallId': '599d2a04-4f4d-4288-815e-973228c47ad2', 'multiverseId': 199551}, 'multiverseid': 199551}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200547&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'e6825f38-b9e8-4f1f-9b3d-7e1eb8ae4f10', 'multiverseId': 200547}, 'multiverseid': 200547}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200049&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'd9601139-6cad-4fd1-ad79-bb3653266056', 'multiverseId': 200049}, 'multiverseid': 200049}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199302&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '828d4fa8-8cef-4f33-a45e-4f91f444bc4f', 'multiverseId': 199302}, 'multiverseid': 199302}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200298&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '6419e3a3-3d38-4867-911f-19311fa43d92', 'multiverseId': 200298}, 'multiverseid': 200298}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=201045&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '5f88733b-8401-4d33-9c63-73764948ac5e', 'multiverseId': 201045}, 'multiverseid': 201045}]", "[{'name': 'Gedankenquelle', 'text': 'Ziehe X Karten.', 'type': 'Hexerei', 'flavor': 'Bruchstücke von Gedanken zerfallen weiter und vervielfältigen sich, bis sie zu einem Springquell erstaunlicher Erkenntnis werden.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199619&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b593286e-fe98-466b-870c-c1dd1b7bd79e', 'multiverseId': 199619}, 'multiverseid': 199619}, {'name': 'Manantial mental', 'text': 'Roba X cartas.', 'type': 'Conjuro', 'flavor': 'Fragmentos de pensamiento se refractan y multiplican, surgiendo en un geiser de inspiración apabullante.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200615&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '11b5c3ed-92c0-4582-a6c5-3346de642543', 'multiverseId': 200615}, 'multiverseid': 200615}, {'name': 'Source spirituelle', 'text': 'Piochez X cartes.', 'type': 'Rituel', 'flavor': 'Les fragments de pensée se réfractent et se multiplient, explosant dans un vertigineux geyser cérébral.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199370&type=card', 'language': 'French', 'identifiers': {'scryfallId': '8fddcf76-540d-4e06-ae46-0c61b46927f7', 'multiverseId': 199370}, 'multiverseid': 199370}, {'name': 'Molla Mentale', 'text': 'Pesca X carte.', 'type': 'Stregoneria', 'flavor': 'Frammenti di pensiero si riflettono e moltiplicano, travolti in un geyser di stordenti intuizioni.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200366&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '4849a28e-f113-4e1d-9c53-33bf91273a20', 'multiverseId': 200366}, 'multiverseid': 200366}, {'name': '思考の泉', 'text': 'カードをＸ枚引く。', 'type': 'ソーサリー', 'flavor': '思考の欠片は屈折し増加し、目がくらむような洞察へとうねり噴出する。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199868&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '06a95763-1051-4c39-8094-1b53e3006118', 'multiverseId': 199868}, 'multiverseid': 199868}, {'name': 'Esguicho Mental', 'text': 'Compre X cards.', 'type': 'Feitiço', 'flavor': 'Fragmentos de pensamento refratam-se e multiplicam-se, explodindo como um geyser de estonteante percepção.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199121&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '02a3eaa4-2c44-4da3-bfdf-542e67a07d89', 'multiverseId': 199121}, 'multiverseid': 199121}, {'name': 'Источник Разума', 'text': 'Возьмите Х карт.', 'type': 'Волшебство', 'flavor': 'Обрывки мыслей преломляются и преумножаются, изливаясь фонтаном опьяняющего прозрения.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200117&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '265a3080-2f37-474b-a36a-0025191ac2ce', 'multiverseId': 200117}, 'multiverseid': 200117}, {'name': '心灵甘泉', 'text': '抓X张牌。', 'type': '法术', 'flavor': '思绪碎片经过折射与散射，化为炫目智慧奔流而出。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200864&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '6aa22719-4e5b-47dd-95f0-c25b6387757f', 'multiverseId': 200864}, 'multiverseid': 200864}]", '[{\'name\': \'Gedankenzersetzung\', \'text\': \'Ein Spieler deiner Wahl wirft zwei Karten aus seiner Hand ab.\', \'type\': \'Hexerei\', \'flavor\': \'„Das Schöne an mentalen Angriffen ist, dass dein Opfer sich nicht daran erinnern kann." —Volrath\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199660&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1ba07fd3-012f-4d03-9736-1df2db85ea24\', \'multiverseId\': 199660}, \'multiverseid\': 199660}, {\'name\': \'Podredumbre mental\', \'text\': \'El jugador objetivo descarta dos cartas.\', \'type\': \'Conjuro\', \'flavor\': \'"La belleza de los ataques mentales es que tus víctimas nunca los recuerdan." —Volrath\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200656&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bae97b14-b75c-44c2-8a82-fca3bdd9f4f5\', \'multiverseId\': 200656}, \'multiverseid\': 200656}, {\'name\': \'Pourrissement cérébral\', \'text\': \'Le joueur ciblé se défausse de deux cartes.\', \'type\': \'Rituel\', \'flavor\': "« La beauté des attaques mentales, c\'est que vos victimes ne s\'en souviennent jamais. » —Wöhlrajh", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199411&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'eefe433d-c23f-4bea-9fcc-a0b342d29763\', \'multiverseId\': 199411}, \'multiverseid\': 199411}, {\'name\': \'Cancrena della Mente\', \'text\': \'Un giocatore bersaglio scarta due carte.\', \'type\': \'Stregoneria\', \'flavor\': \'"La bellezza degli attacchi mentali è che le tue vittime non li ricordano mai." —Volrath\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200407&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'18632a8f-3494-4484-b7ed-b7179d0e076c\', \'multiverseId\': 200407}, \'multiverseid\': 200407}, {\'name\': \'精神腐敗\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーはカードを２枚捨てる。\', \'type\': \'ソーサリー\', \'flavor\': \'精神攻撃の一番美しいところは、犠牲者がそれを覚えていないことだ。 ――ヴォルラス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199909&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6b29d6c0-21c6-4a58-a4b4-bf09dfc5dc49\', \'multiverseId\': 199909}, \'multiverseid\': 199909}, {\'name\': \'Estiolar a Mente\', \'text\': \'O jogador alvo descarta dois cards.\', \'type\': \'Feitiço\', \'flavor\': \'"O melhor de um ataque mental é que suas vítimas nunca se recordam dele." —Volrath\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199162&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e7960050-2b76-4354-b7d5-d765e0cb3250\', \'multiverseId\': 199162}, \'multiverseid\': 199162}, {\'name\': \'Гниение Разума\', \'text\': \'Целевой игрок сбрасывает две карты.\', \'type\': \'Волшебство\', \'flavor\': \'«Вся прелесть промывания мозгов заключается в том, что жертва никогда о нем не помнит». — Волрат\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200158&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4f93bad5-91a2-4cb5-a6b6-199d4e54cfa2\', \'multiverseId\': 200158}, \'multiverseid\': 200158}, {\'name\': \'心之衰\', \'text\': \'目标牌手弃两张牌。\', \'type\': \'法术\', \'flavor\': \'「精神攻击最美妙之处，就是中招者根本不记得自己中了招。」 ～瓦拉司\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200905&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2bdd1d2e-c873-451b-946f-83aaa7102583\', \'multiverseId\': 200905}, \'multiverseid\': 200905}]', '[{\'name\': \'Gedankenzertrümmerung\', \'text\': \'Ein Spieler deiner Wahl wirft X zufällig bestimmte Karten aus seiner Hand ab.\', \'type\': \'Hexerei\', \'flavor\': \'Dunkle Gedanken schlüpfen im Verstand und verdrehen sich immer weiter, bis sie Flügel bekommen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199661&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f389010b-7c33-45d7-a0d5-65746c465afa\', \'multiverseId\': 199661}, \'multiverseid\': 199661}, {\'name\': \'Romper la mente\', \'text\': \'El jugador objetivo descarta X cartas al azar.\', \'type\': \'Conjuro\', \'flavor\': \'Pensamientos oscuros nacen y latigan en la mente, tratando de salir volando.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200657&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f5546f42-318c-4475-a2b7-17eb141f2dd3\', \'multiverseId\': 200657}, \'multiverseid\': 200657}, {\'name\': \'Fracassement cérébral\', \'text\': \'Le joueur ciblé se défausse de X cartes au hasard.\', \'type\': \'Rituel\', \'flavor\': "Les pensées les plus noires éclosent et s\'ébrouent dans l\'esprit pour prendre leur envol.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199412&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dfe42a75-2dce-4912-890c-4b3a74ab85a3\', \'multiverseId\': 199412}, \'multiverseid\': 199412}, {\'name\': \'Frantumare la Mente\', \'text\': \'Un giocatore bersaglio scarta X carte a caso.\', \'type\': \'Stregoneria\', \'flavor\': \'Nascono pensieri oscuri, distorcendo la mente e faticando a prendere il volo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200408&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f758d573-bc27-48e8-badc-3373e9a8f4f6\', \'multiverseId\': 200408}, \'multiverseid\': 200408}, {\'name\': \'思考の粉砕\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーはカードをＸ枚無作為に選んで捨てる。\', \'type\': \'ソーサリー\', \'flavor\': \'邪悪な思考は精神の中で孵り錯乱し、懸命に飛び立とうとする。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199910&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f9f89778-74ff-4110-a923-2729fdcb0437\', \'multiverseId\': 199910}, \'multiverseid\': 199910}, {\'name\': \'Despedaça-Mente\', \'text\': \'O jogador alvo descarta X cards aleatoriamente.\', \'type\': \'Feitiço\', \'flavor\': \'Os pensamentos sombrios são incubados e deformados dentro da mente, distendendo-se para tomar asas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199163&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a345f8f1-8694-498b-9629-6c7bc2ff8cfe\', \'multiverseId\': 199163}, \'multiverseid\': 199163}, {\'name\': \'Пошатнувшийся Разум\', \'text\': \'Целевой игрок сбрасывает X случайно выбранных карт.\', \'type\': \'Волшебство\', \'flavor\': \'В недрах разума рождаются и мечутся темные мысли, пытаясь вылететь наружу.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200159&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b956b768-fff0-4fcd-b531-6b5a6954f249\', \'multiverseId\': 200159}, \'multiverseid\': 200159}, {\'name\': \'粉碎心灵\', \'text\': \'目标牌手随机弃X张牌。\', \'type\': \'法术\', \'flavor\': \'黑暗思绪在心灵中成形、扭曲，用尽力气想飞出来。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200906&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f49ab3ce-cea9-4486-b9c5-f59be79e46b3\', \'multiverseId\': 200906}, \'multiverseid\': 200906}]', '[{\'name\': \'Geistesverbrauch\', \'text\': \'Verwende nur schwarzes Mana für X.\\nGeistesverbrauch fügt einer Kreatur oder einem Spieler deiner Wahl X Schadenspunkte zu, und du erhältst X Lebenspunkte dazu.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199644&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dc314fb2-3348-43d7-b9a1-3cecac4f3bc7\', \'multiverseId\': 199644}, \'multiverseid\': 199644}, {\'name\': \'Consumir el espíritu\', \'text\': \'Usa sólo maná negro para pagar X.\\nConsumir el espíritu hace X puntos de daño a la criatura o jugador objetivo y ganas X vidas.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200640&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e994cba4-9ffb-4473-824d-47047ed69b9e\', \'multiverseId\': 200640}, \'multiverseid\': 200640}, {\'name\': "Absorption de l\'esprit", \'text\': "Ne dépensez que du mana noir pour X.\\nL\'Absorption de l\'esprit inflige X blessures à une cible, créature ou joueur, et vous gagnez X points de vie.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199395&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ca9442a0-ce15-4dd8-9ebd-683b3fbbaedc\', \'multiverseId\': 199395}, \'multiverseid\': 199395}, {\'name\': \'Spirito Struggente\', \'text\': \'Spendi solo mana nero per X.\\nLo Spirito Struggente infligge X danni a una creatura o a un giocatore bersaglio e tu guadagni X punti vita.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200391&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2f3b36e3-4e15-4db5-88ad-f840f3bad3ac\', \'multiverseId\': 200391}, \'multiverseid\': 200391}, {\'name\': \'魂の消耗\', \'text\': \'Ｘは黒マナでしか支払えない。\\nクリーチャー１体かプレイヤー１人を対象とする。魂の消耗はそれにＸ点のダメージを与え、あなたはＸ点のライフを得る。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199893&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3bd7ea76-f0ae-4cd8-a272-8b1ff398ce3d\', \'multiverseId\': 199893}, \'multiverseid\': 199893}, {\'name\': \'Consumir o Espírito\', \'text\': \'Use somente mana preto para pagar X.\\nConsumir o Espírito causa X pontos de dano à criatura ou ao jogador alvo e você ganha X pontos de vida.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199146&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'71223793-d533-4255-be0c-3daa926bf948\', \'multiverseId\': 199146}, \'multiverseid\': 199146}, {\'name\': \'Истребление Духа\', \'text\': \'Расходуйте на X только черную ману.\\nИстребление Духа наносит Х повреждений целевому существу или игроку, а вы получаете Х жизней.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200142&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3c257dcd-a6b3-46a6-9566-2e5ff18a931c\', \'multiverseId\': 200142}, \'multiverseid\': 200142}, {\'name\': \'吞噬灵魂\', \'text\': \'只能以黑色法术力支付X。\\n吞噬灵魂对目标生物或牌手造成X点伤害，且你获得X点生命。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200889&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5c655f5a-a536-421a-ab81-21dac19aa07c\', \'multiverseId\': 200889}, \'multiverseid\': 200889}]', '[{\'name\': \'Gepanzerter Höhenflug\', \'text\': \'Kreaturenverzauberung\\nDie verzauberte Kreatur erhält für jede Ebene, die du kontrollierst, +1/+1 und hat Flugfähigkeit.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Die Wiese tat sich vor mir auf, und ich fand einen Weg von der Niederlage unseres Volkes zu seinem höchsten Ruhm."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199558&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bed745fa-59b7-46be-ab1c-3fb12f88274b\', \'multiverseId\': 199558}, \'multiverseid\': 199558}, {\'name\': \'Ascenso acorazado\', \'text\': \'Encantar criatura.\\nLa criatura encantada obtiene +1/+1 por cada llanura que controles y tiene la habilidad de volar.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"La pradera se levantó bajo mis pies, y percibí una vía para transformar nuestra derrota en nuestra mayor gloria."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200554&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e35cf5c3-a67c-4396-ac78-2fff569e4300\', \'multiverseId\': 200554}, \'multiverseid\': 200554}, {\'name\': \'Ascension cuirassée\', \'text\': \'Enchanter : créature\\nLa créature enchantée gagne +1/+1 pour chaque plaine que vous contrôlez et elle a le vol.\', \'type\': \'Enchantement : aura\', \'flavor\': "« La prairie s\'étendit soudain au-dessous de moi, et je perçus le chemin qui mena notre peuple de la défaite à notre plus grande gloire. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199309&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'96dbb2d2-62ad-4583-a47a-fac66591c918\', \'multiverseId\': 199309}, \'multiverseid\': 199309}, {\'name\': \'Ascensione Corazzata\', \'text\': \'Incanta creatura\\nLa creatura incantata prende +1/+1 per ogni Pianura che controlli e ha volare.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Il terreno è spuntato sotto di me e ho scorto un cammino che dalla sconfitta del nostro popolo portava alla gloria suprema."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200305&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7f37f892-0727-4207-a314-e56ffbaf85ad\', \'multiverseId\': 200305}, \'multiverseid\': 200305}, {\'name\': \'鎧をまとった上昇\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは、あなたがコントロールする平地１つにつき＋１/＋１の修整を受けるとともに飛行を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「草原が私の足元で弾け、私に敗北からいと高き栄光への道を示してくれたのです。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199807&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9b504717-0d3b-46d6-91fe-bb1bc54fa1db\', \'multiverseId\': 199807}, \'multiverseid\': 199807}, {\'name\': \'Ascensão Armada\', \'text\': \'Encantar criatura\\nA criatura encantada recebe +1/+1 para cada Planície que você controla e tem voar.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"O prado surgiu sob meus pés e avistei um caminho que levava da derrota de nosso povo à nossa maior glória."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199060&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d6673110-cbfc-4aa9-9fc2-ed58e658c579\', \'multiverseId\': 199060}, \'multiverseid\': 199060}, {\'name\': \'Вознесение в Доспехах\', \'text\': \'Зачаровать существо\\nЗачарованное существо получает +1/+1 за каждую Равнину под вашим контролем и имеет Полет.\', \'type\': \'Чары — Аура\', \'flavor\': \'«Вдруг подо мной возник луг, и я увидел путь от поражения моего народа к вершине нашей славы».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200056&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d8ff3a90-579d-4e49-aee2-e09f272c0d13\', \'multiverseId\': 200056}, \'multiverseid\': 200056}, {\'name\': \'武装飞腾\', \'text\': \'结附于生物\\n你每操控一个平原，所结附的生物便得+1/+1且具有飞行异能。\', \'type\': \'结界～灵气\', \'flavor\': \'「脚下的牧草地离我远去，而我从伙伴的败象中找到通往光荣胜利之道。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200803&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f28486c0-0257-44d8-9474-086782974747\', \'multiverseId\': 200803}, \'multiverseid\': 200803}]', "[{'name': 'Gewaltiger Baloth', 'type': 'Kreatur — Bestie', 'flavor': 'Es ernährt sich von Früchten, Pflanzen, kleinen Waldtieren, großen Waldtieren, Wäldern, Obsthainen, Obstbauern und kleinen Städten.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199735&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'eb8962dd-1c98-4cc0-b3d4-1003304d3a01', 'multiverseId': 199735}, 'multiverseid': 199735}, {'name': 'Báloth enorme', 'type': 'Criatura — Bestia', 'flavor': 'Su dieta está compuesta de frutas, plantas, animales pequeños del bosque, animales grandes del bosque, bosques, arboledas frutales, agricultores de frutas y ciudades pequeñas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200731&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '2fefbcee-b82b-470d-b662-4139a5963369', 'multiverseId': 200731}, 'multiverseid': 200731}, {'name': 'Baloth énorme', 'type': 'Créature : bête', 'flavor': 'Il se nourrit de fruits, de plantes, de petits rongeurs forestiers, de gros animaux forestiers, de forêts, de vergers, de fermiers, de maraîchers et de petites villes... entre autres.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199486&type=card', 'language': 'French', 'identifiers': {'scryfallId': '25898316-7d3e-49d8-a479-37b3fbf5350f', 'multiverseId': 199486}, 'multiverseid': 199486}, {'name': 'Baloth Enorme', 'type': 'Creatura — Bestia', 'flavor': 'La sua dieta è composta da frutta, piante, piccoli animali del bosco, grossi animali del bosco, boschi, frutteti, fattorie e piccole città.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200482&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a9c97ce0-0275-485f-87b3-d4116c9627b7', 'multiverseId': 200482}, 'multiverseid': 200482}, {'name': '超大なベイロス', 'type': 'クリーチャー — ビースト', 'flavor': 'そいつの餌は、果物、植物、森の小動物、森のデカい動物、森そのもの、果樹園、果樹園の農夫、小都市などだ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199984&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '0b25e16c-13cb-4405-9c8e-1fee178a656f', 'multiverseId': 199984}, 'multiverseid': 199984}, {'name': 'Baloth Enorme', 'type': 'Criatura — Besta', 'flavor': 'Sua dieta consiste em frutas, plantas, animais silvestres pequenos, animais silvestres grandes, bosques, pomares, horticultores e pequenas cidades.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199237&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c8b46d4e-c017-4df8-80b8-6c2194675a71', 'multiverseId': 199237}, 'multiverseid': 199237}, {'name': 'Огромный Балот', 'type': 'Существо — Зверь', 'flavor': 'Он питается фруктами, травой, мелкими зверьками, а также крупной дичью, деревьями, фруктовыми садами, садовниками и небольшими городами.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200233&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '53c26951-22b9-47cf-b956-02c3e33be2b8', 'multiverseId': 200233}, 'multiverseid': 200233}, {'name': '庞大巴洛西', 'type': '生物～野兽', 'flavor': '他的食物包括水果，植物，林地里的小动物，林地里的大动物，林地，果园，果农，以及小城镇。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200980&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'af6fc633-be05-4ed3-98b2-72232b303b1a', 'multiverseId': 200980}, 'multiverseid': 200980}]", '[{\'name\': \'Gletscherfestung\', \'text\': \'Die Gletscherfestung kommt getappt ins Spiel, falls du nicht eine Ebene oder eine Insel kontrollierst.\\n{T}: Erhöhe deinen Manavorrat um {W} oder {U}.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199781&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'933238f3-bbf6-471d-b367-2aa6d3351e29\', \'multiverseId\': 199781}, \'multiverseid\': 199781}, {\'name\': \'Fortaleza glacial\', \'text\': \'La Fortaleza glacial entra al campo de batalla girada a menos que controles una llanura o una isla.\\n{T}: Agrega {W} o {U} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200777&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c69c9627-7ac8-4d39-93bb-f041cd2c73c3\', \'multiverseId\': 200777}, \'multiverseid\': 200777}, {\'name\': \'Forteresse glaciaire\', \'text\': \'La Forteresse glaciaire arrive sur le champ de bataille engagée à moins que vous ne contrôliez une plaine ou une île.\\n{T} : Ajoutez {W} ou {U} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199532&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e35fdcd0-fcfd-4c4d-bb31-a61eab27ba91\', \'multiverseId\': 199532}, \'multiverseid\': 199532}, {\'name\': \'Fortezza Glaciale\', \'text\': "La Fortezza Glaciale entra nel campo di battaglia TAPpata a meno che tu non controlli una Pianura o un\'Isola.\\n{T}: Aggiungi {W} o {U} alla tua riserva di mana.", \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200528&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b9122a4f-3736-4c8a-a7a2-df4de0915ece\', \'multiverseId\': 200528}, \'multiverseid\': 200528}, {\'name\': \'氷河の城砦\', \'text\': \'氷河の城砦は、あなたが平地か島をコントロールしていないかぎり、タップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{W}か{U}を加える。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200030&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'45477ca0-d902-4f2b-a2bc-3df0732a1635\', \'multiverseId\': 200030}, \'multiverseid\': 200030}, {\'name\': \'Fortaleza Glacial\', \'text\': \'Fortaleza Glacial entra no campo de batalha virado a menos que você controle uma Planície ou uma Ilha.\\n{T}: Adicione {W} ou {U} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199283&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6f77e3dc-c64e-45d8-aff7-25d0bdb63292\', \'multiverseId\': 199283}, \'multiverseid\': 199283}, {\'name\': \'Ледяная Крепость\', \'text\': \'Ледяная Крепость выходит на поле битвы повернутой, если только под вашим контролем нет Равнины или Острова.\\n{T}: добавьте {W} или {U} в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200279&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dfc7564b-552e-4185-a668-eee1685c21c2\', \'multiverseId\': 200279}, \'multiverseid\': 200279}, {\'name\': \'冰河要塞\', \'text\': \'除非你操控平原或海岛，否则冰河要塞须横置进战场。\\n{T}：加{W}或{U}到你的法术力池中。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=201026&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'33756488-14ec-4226-a46a-c85814fe58aa\', \'multiverseId\': 201026}, \'multiverseid\': 201026}]', '[{\'name\': \'Glorreicher Ansturm\', \'text\': \'Kreaturen, die du kontrollierst, erhalten +1/+1 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Die eigene Klinge ist nur so scharf wie die eigene Überzeugung." —Ajani Goldmähne\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199566&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1ad35824-c7b5-425b-9e6f-687f2daefe98\', \'multiverseId\': 199566}, \'multiverseid\': 199566}, {\'name\': \'Carga gloriosa\', \'text\': \'Las criaturas que controles obtienen +1/+1 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"Tu espada es tan afilada como tu fe." —Ajani Melena Dorada\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200562&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'92647c73-b9b7-4b64-b130-c70f1685223e\', \'multiverseId\': 200562}, \'multiverseid\': 200562}, {\'name\': \'Charge glorieuse\', \'text\': "Les créatures que vous contrôlez gagnent +1/+1 jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': \'« Une épée a le tranchant de la conviction de celui qui la manie. » —Ajani Crinièredor\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199317&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c2274fc7-f57a-45b9-bdfd-aaa93404a104\', \'multiverseId\': 199317}, \'multiverseid\': 199317}, {\'name\': \'Carica Gloriosa\', \'text\': \'Le creature che controlli prendono +1/+1 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"La tua lama è affilata solo quanto la tua convinzione." —Ajani Criniera D\\\'Oro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200313&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d5a6bb4f-d05d-4cc9-aa92-36e2a4e4ed9c\', \'multiverseId\': 200313}, \'multiverseid\': 200313}, {\'name\': \'栄光の突撃\', \'text\': \'あなたがコントロールするクリーチャーは、ターン終了時まで＋１/＋１の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'「刃の鋭さは、あくまでそれを持つ者の信念の鋭さでしかない。」 ――黄金のたてがみのアジャニ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199815&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'46afe8df-28b0-4295-beed-2573e435d392\', \'multiverseId\': 199815}, \'multiverseid\': 199815}, {\'name\': \'Investida Gloriosa\', \'text\': \'As criaturas que você controla recebem +1/+1 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"A lâmina é tão afiada quanto a convicção de quem a possui." —Ajani Juba D\\\'ouro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199068&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'93d4fc41-c14f-4501-845a-3e184e49c2c2\', \'multiverseId\': 199068}, \'multiverseid\': 199068}, {\'name\': \'Славный Натиск\', \'text\': \'Существа под вашим контролем получают +1/+1 до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Сила меча зависит от силы убеждений». — Златогривый Аджани\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200064&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'604d4006-2bd1-46c9-a8a5-763bb3ff894d\', \'multiverseId\': 200064}, \'multiverseid\': 200064}, {\'name\': \'辉煌冲锋\', \'text\': \'由你操控的生物得+1/+1直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'「信念有多坚定，其刀锋就有多锐利。」 ～金鬃阿耶尼\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200811&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cf598d6a-8cfc-479f-b391-03246c71b9b1\', \'multiverseId\': 200811}, \'multiverseid\': 200811}]', '[{\'name\': \'Goblin-Artillerie\', \'text\': \'{T}: Die Goblin-Artillerie fügt einer Kreatur oder einem Spieler deiner Wahl 2 Schadenspunkte und dir 3 Schadenspunkte zu.\', \'type\': \'Kreatur — Goblin, Krieger\', \'flavor\': \'Die meisten Goblins dürfen einmal das Katapult abfeuern, aber nur wenige erreichen den begehrten Rang des Munitionsfesthalters.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199693&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d32884a1-9490-4945-b5dc-979e90e10f83\', \'multiverseId\': 199693}, \'multiverseid\': 199693}, {\'name\': \'Artillería trasga\', \'text\': \'{T}: La Artillería trasga hace 2 puntos de daño a la criatura o jugador objetivo y 3 puntos de daño a ti.\', \'type\': \'Criatura — Guerrero trasgo\', \'flavor\': \'La mayoría de los trasgos pasan por disparar la catapulta, pero pocos logran el preciado título de Sujetador de Munición.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200689&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8916846c-ab68-4100-b1da-97e39dc2061f\', \'multiverseId\': 200689}, \'multiverseid\': 200689}, {\'name\': \'Artillerie gobeline\', \'text\': "{T} : L\'Artillerie gobeline inflige 2 blessures à une cible, créature ou joueur, et vous inflige 3 blessures.", \'type\': \'Créature : gobelin et guerrier\', \'flavor\': \'La plupart des gobelins tirent chacun leur tour avec la catapulte, mais peu sont ceux qui parviennent au grade de porte-munition.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199444&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6a351880-4be3-460e-b604-284d4c466fb5\', \'multiverseId\': 199444}, \'multiverseid\': 199444}, {\'name\': \'Artiglieria Goblin\', \'text\': "{T}: L\'Artiglieria Goblin infligge 2 danni a una creatura o a un giocatore bersaglio e 3 danni a te.", \'type\': \'Creatura — Guerriero Goblin\', \'flavor\': "Molti goblin fanno a turno per sparare con la catapulta, ma ben pochi ottengono l\'ambito titolo di Portatore di Munizioni.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200440&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3f2d8d05-c1db-45f4-a182-6346729ac687\', \'multiverseId\': 200440}, \'multiverseid\': 200440}, {\'name\': \'ゴブリン弩弓隊\', \'text\': \'{T}：クリーチャー１体かプレイヤー１人を対象とする。ゴブリン弩弓隊はそれに２点のダメージを与え、あなたに３点のダメージを与える。\', \'type\': \'クリーチャー — ゴブリン・戦士\', \'flavor\': \'投石器を発射する役はほとんどのゴブリンが順番にやるが、誰もがやりたがる弾薬係をやれるのはほとんどいない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199942&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'90db0619-5255-4e9d-bc07-1d35a0f8c8ec\', \'multiverseId\': 199942}, \'multiverseid\': 199942}, {\'name\': \'Artilharia Goblin\', \'text\': \'{T}: Artilharia Goblin causa 2 pontos de dano à criatura ou ao jogador alvo e 3 pontos de dano a você.\', \'type\': \'Criatura — Goblin Guerreiro\', \'flavor\': \'A maioria dos goblins tem sua chance de acionar a catapulta, porém poucos deles recebem o invejado título de Agarrador de Munição.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199195&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'18a545af-84de-4041-a55b-b097fb944062\', \'multiverseId\': 199195}, \'multiverseid\': 199195}, {\'name\': \'Гоблинская Артиллерия\', \'text\': \'{T}: Гоблинская Артиллерия наносит 2 повреждения целевому существу или игроку и 3 повреждения вам.\', \'type\': \'Существо — Гоблин Воин\', \'flavor\': \'Большинство гоблинов по очереди стреляют из катапульты, и лишь немногим удается получить столь желанное звание Держателя Снарядов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200191&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5d0bec8d-26dd-4084-9a8f-76e2b785d80e\', \'multiverseId\': 200191}, \'multiverseid\': 200191}, {\'name\': \'鬼怪大炮\', \'text\': \'{T}：鬼怪大炮对目标生物或牌手造成2点伤害，并且对你造成3点伤害。\', \'type\': \'生物～鬼怪／战士\', \'flavor\': \'大多数鬼怪都轮得到发射的机会，但只有少数能拥有人人渴望的弹药库称号。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200938&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'297bea3d-bb0d-4b38-9d2e-8222c4dc5f0f\', \'multiverseId\': 200938}, \'multiverseid\': 200938}]', '[{\'name\': \'Goblin-Häuptling\', \'text\': \'Eile (Diese Kreatur kann angreifen und {T}, sobald sie unter deine Kontrolle kommt.)\\nAndere Goblin-Kreaturen, die du kontrollierst, erhalten +1/+1 und Eile.\', \'type\': \'Kreatur — Goblin\', \'flavor\': \'„Wir sind die Goblins, die Erben der Reiche vergangener Häuptlinge. Wir ruhen erst nach dem Tod, und unsere Flammen sind unsere Kriegserklärung."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199694&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'02b80b54-b9b4-44b2-aff5-87ec292d0592\', \'multiverseId\': 199694}, \'multiverseid\': 199694}, {\'name\': \'Cacique trasgo\', \'text\': \'Prisa. (Esta criatura puede atacar y {T} tan pronto como entre bajo tu control.)\\nLas otras criaturas Trasgo que controlas obtienen +1/+1 y tienen la habilidad de prisa.\', \'type\': \'Criatura — Trasgo\', \'flavor\': \'"Somos trasgos, herederos de los imperios montañosos de los caciques del pasado. Para nosotros, el descanso es la muerte y el incendio una invitación a la guerra."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200690&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0d0daee8-0686-49ac-a525-a239f187d3ae\', \'multiverseId\': 200690}, \'multiverseid\': 200690}, {\'name\': \'Chef de clan gobelin\', \'text\': \'Célérité (Cette créature peut attaquer et {T} dès le tour où elle arrive sous votre contrôle.)\\nLes autres créatures Gobelin que vous contrôlez gagnent +1/+1 et ont la célérité.\', \'type\': \'Créature : gobelin\', \'flavor\': \'« Nous sommes les gobelins héritiers des empires montagneux des chefs de clan de jadis. Pour nous, le repos représente la mort, et le feu, notre appel à la guerre. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199445&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f6fd0ae9-1ce9-4e5f-a0e4-b0b1831f4662\', \'multiverseId\': 199445}, \'multiverseid\': 199445}, {\'name\': \'Capitano Goblin\', \'text\': \'Rapidità (Questa creatura può attaccare e {T} non appena entra sotto il tuo controllo.)\\nLe altre creature Goblin che controlli prendono +1/+1 e hanno rapidità.\', \'type\': \'Creatura — Goblin\', \'flavor\': \'"Siamo goblinoidi, eredi degli imperi montani di capitani del passato. Il riposo per noi è morte e l\\\'incendio la nostra chiamata alle armi."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200441&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'31006dc6-9ca9-4c66-b27c-e04491760a5b\', \'multiverseId\': 200441}, \'multiverseid\': 200441}, {\'name\': \'ゴブリンの酋長\', \'text\': \'速攻 （このクリーチャーは、あなたのコントロール下になってすぐに攻撃したり{T}したりできる。）\\nあなたがコントロールする他のゴブリン・クリーチャーは、＋１/＋１の修整を受けるとともに速攻を持つ。\', \'type\': \'クリーチャー — ゴブリン\', \'flavor\': \'「俺らゴブリン族、昔の酋長らの山の帝国の世継ぎ。 安静なんて死も同然。火つけは俺らの戦いの合図だ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199943&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'efc33ef6-2b21-4456-b182-0adc41562892\', \'multiverseId\': 199943}, \'multiverseid\': 199943}, {\'name\': \'Chefe Goblin\', \'text\': \'Ímpeto (Esta criatura pode atacar e {T} assim que entra sob seu controle.)\\nOutras criaturas do tipo Goblin que você controla recebem +1/+1 e têm ímpeto.\', \'type\': \'Criatura — Goblin\', \'flavor\': \'"Nós somos goblins, herdeiros dos impérios montanhosos de líderes do passado. Descansar nos leva à morte, e o desejo de incendiar nos leva à guerra."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199196&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1a822aa1-1c15-41ce-a214-4a0bf76a099e\', \'multiverseId\': 199196}, \'multiverseid\': 199196}, {\'name\': \'Гоблинский Предводитель\', \'text\': \'Ускорение (Это существо может атаковать и {T}, как только оно попадает под ваш контроль.)\\nДругие существа-Гоблины под вашим контролем получают +1/+1 и имеют Ускорение.\', \'type\': \'Существо — Гоблин\', \'flavor\': \'«Мы — гоблины, наследники горных империй былых вождей. Покой есть наша смерть, а вот поджог — наш призыв на войну».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200192&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1980189d-98aa-4bfd-91c8-0761f6aef86f\', \'multiverseId\': 200192}, \'multiverseid\': 200192}, {\'name\': \'鬼怪酋长\', \'text\': \'敏捷 （此生物受你操控时便能攻击与{T}。）\\n由你操控的其他鬼怪生物得+1/+1并具有敏捷异能。\', \'type\': \'生物～鬼怪\', \'flavor\': \'「我们是鬼怪族，数代酋长以来的山脉帝国传人。 不到死不休息，纵火就是战争的动力。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200939&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'819bd586-b176-4e83-a17a-820749639632\', \'multiverseId\': 200939}, \'multiverseid\': 200939}]', '[{\'name\': \'Goblin-Lanzenträger\', \'type\': \'Kreatur — Goblin, Krieger\', \'flavor\': \'Sobald sie das spitze Ende gefunden haben, werden sie zum Wachdienst befördert.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199695&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f51ad3ce-e8a6-4dd1-b584-7fec2713e982\', \'multiverseId\': 199695}, \'multiverseid\': 199695}, {\'name\': \'Lancero trasgo\', \'type\': \'Criatura — Guerrero trasgo\', \'flavor\': \'Cuando descubrió cuál extremo de la cosa era puntiagudo, fue ascendido al servicio de guardia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200691&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6da56cb8-ecfb-4694-b4a6-d807818f8171\', \'multiverseId\': 200691}, \'multiverseid\': 200691}, {\'name\': \'Piquier gobelin\', \'type\': \'Créature : gobelin et guerrier\', \'flavor\': "Une fois qu\'il eût découvert quelle extrémité était tranchante, il fut promu garde.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199446&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d812cf53-3419-40a1-9627-5ecdc4c18dbb\', \'multiverseId\': 199446}, \'multiverseid\': 199446}, {\'name\': \'Picchiere Goblin\', \'type\': \'Creatura — Guerriero Goblin\', \'flavor\': \'Quando riuscì a capire quale delle due estremità era appuntita, venne promosso ai servizi di guardia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200442&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d925224f-e6d3-4184-81e4-3166ea8cee36\', \'multiverseId\': 200442}, \'multiverseid\': 200442}, {\'name\': \'ゴブリンの長槍使い\', \'type\': \'クリーチャー — ゴブリン・戦士\', \'flavor\': \'棒のどっちが尖っているか理解ができたことで、彼は警備役に昇格した。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199944&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'49a4759c-cc45-4a25-9a93-abd6d40b0fbb\', \'multiverseId\': 199944}, \'multiverseid\': 199944}, {\'name\': \'Goblin Piqueiro\', \'type\': \'Criatura — Goblin Guerreiro\', \'flavor\': \'Assim que ele aprendeu qual das pontas era afiada, foi promovido à função de guarda.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199197&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f566da9b-ed37-47c0-8bb8-8ecfa67ce2b4\', \'multiverseId\': 199197}, \'multiverseid\': 199197}, {\'name\': \'Гоблин-Копейщик\', \'type\': \'Существо — Гоблин Воин\', \'flavor\': \'Когда он выучил, где у копья острый конец, ему доверили нести караульную службу.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200193&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8efe9140-c006-4b4b-841b-4927090c57ad\', \'multiverseId\': 200193}, \'multiverseid\': 200193}, {\'name\': \'鬼怪长矛兵\', \'type\': \'生物～鬼怪／战士\', \'flavor\': \'当他搞清楚这东西哪一头是尖端时，便晋升为守卫。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200940&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'783c88bd-138a-48c8-bf89-b253e164b4a8\', \'multiverseId\': 200940}, \'multiverseid\': 200940}]', '[{\'name\': \'Gorgonenflegel\', \'text\': \'Die ausgerüstete Kreatur erhält +1/+1 und Todesberührung. (Kreaturen, denen von dieser Kreatur Schaden zugefügt wurde, werden zerstört. Du kannst den Kampfschaden dieser Kreatur auf beliebig viele Kreaturen aufteilen, die sie blockt oder von denen sie geblockt wird.)\\nAusrüsten {2} ({2}: Lege diese Karte an eine Kreatur deiner Wahl an, die du kontrollierst. Spiele Ausrüsten wie eine Hexerei.)\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199766&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'64055929-2258-47ab-bc53-28041789b201\', \'multiverseId\': 199766}, \'multiverseid\': 199766}, {\'name\': \'Azote de gorgonas\', \'text\': \'La criatura equipada obtiene +1/+1 y tiene la habilidad de toque mortal. (Las criaturas que reciben daño de esta criatura son destruidas. Puedes dividir su daño de combate entre las criaturas que la bloquean o que ella bloquea.)\\nEquipar {2}. ({2}: Anexa este equipo a la criatura objetivo que controles. Juega la habilidad de equipar como un conjuro.)\', \'type\': \'Artefacto — Equipo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200762&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3fc65982-dbb5-48ea-ae0b-a26193a4ae13\', \'multiverseId\': 200762}, \'multiverseid\': 200762}, {\'name\': \'Fléau de la gorgone\', \'text\': "La créature équipée gagne +1/+1 et a le contact mortel. (Les créatures qui subissent des blessures de cette créature sont détruites. Vous pouvez partager ses blessures de combat entre toutes les créatures qui la bloquent ou qu\'elle bloque.)\\nÉquipement {2} ({2} : Attachez à la créature ciblée que vous contrôlez. N\'attachez l\'équipement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Artefact : équipement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199517&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c8b88946-4c24-477e-9f9d-a06df02c0222\', \'multiverseId\': 199517}, \'multiverseid\': 199517}, {\'name\': \'Gorgone Sferzante\', \'text\': \'La creatura equipaggiata prende +1/+1 e ha tocco letale. (Le creature a cui è stato inflitto danno da questa creatura vengono distrutte. Puoi dividere il suo danno da combattimento tra un numero qualsiasi di creature che bloccano o sono bloccate da essa.)\\nEquipaggiare {2} ({2}: Assegna a una creatura bersaglio che controlli. Equipaggia solo quando potresti lanciare una stregoneria.)\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200513&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f85406fd-726f-4e7e-9727-8268b51650f9\', \'multiverseId\': 200513}, \'multiverseid\': 200513}, {\'name\': \'ゴルゴンのフレイル\', \'text\': \'装備しているクリーチャーは＋１/＋１の修整を受けるとともに接死を持つ。 （このクリーチャーにダメージを与えられたクリーチャーは破壊される。 その戦闘ダメージは、それがブロックしている、あるいはそれをブロックしているクリーチャーの中で好きなように割り振れる。）\\n装備 {2} ({2}：あなたがコントロールするクリーチャー１体を対象とし、これをつける。 装備はソーサリーとしてのみ行う。）\', \'type\': \'アーティファクト — 装備品\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200015&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'aee0024b-e055-405a-88ed-63cbad83c3be\', \'multiverseId\': 200015}, \'multiverseid\': 200015}, {\'name\': \'Mangual Górgona\', \'text\': \'A criatura equipada recebe +1/+1 e tem toque mortífero. (Criaturas que sofrem dano causado por essa criatura são destruídas. Você pode dividir o dano de combate dessa criatura entre quaisquer criaturas que a bloqueiem ou sejam bloqueadas por ela.)\\nEquipar {2} ({2}: Anexe a uma criatura alvo que você controla. Equipe somente quando puder jogar um feitiço.)\', \'type\': \'Artefato — Equipamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199268&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7c73d4af-3cc1-4562-bb05-3b3a355bc380\', \'multiverseId\': 199268}, \'multiverseid\': 199268}, {\'name\': \'Цеп-Горгона\', \'text\': \'Снаряженное существо получает +1/+1 и имеет Смертельное касание. (Существа, которым это существо нанесло повреждения, уничтожаются. Вы можете распределить наносимые этим существом боевые повреждения между любыми блокирующими его или заблокированными им существами.)\\nСнарядить {2} ({2}: прикрепите к целевому существу под вашим контролем. Снаряжайте только как волшебство.)\', \'type\': \'Артефакт — Снаряжение\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200264&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b6a54cc7-a318-413c-a8e4-8d323ec61996\', \'multiverseId\': 200264}, \'multiverseid\': 200264}, {\'name\': \'蛇发妖连枷\', \'text\': \'佩带此武具的生物得+1/+1且具有死触异能。 （受到此生物之伤害的生物会被消灭。 你可以将此生物之战斗伤害在阻挡它或被它阻挡的任何生物之间分配。）\\n佩带{2} （{2}：装备在目标由你操控的生物上； 佩带的时机视同法术。）\', \'type\': \'神器～武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=201011&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5d1865b3-d522-4323-b6f9-370f8585b0c1\', \'multiverseId\': 201011}, \'multiverseid\': 201011}]', '[{\'name\': \'Greifen-Wachposten\', \'text\': \'Fliegend\\nWachsamkeit (Diese Kreatur wird beim Angreifen nicht getappt.)\', \'type\': \'Kreatur — Greif\', \'flavor\': \'Sobald ein Greifenwächter ein Gebiet für sich beansprucht hat, kann ihn nur der Tod von seinem Posten entfernen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199567&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d01ea777-1b63-421c-b399-ca35eb982957\', \'multiverseId\': 199567}, \'multiverseid\': 199567}, {\'name\': \'Grifo centinela\', \'text\': \'Vuela.\\nVigilancia. (Esta criatura no se gira al atacar.)\', \'type\': \'Criatura — Grifo\', \'flavor\': \'Una vez que un grifo centinela adopta un territorio como propio, sólo la muerte puede obligarlo a dejar su puesto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200563&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'31696e5b-20e6-4b66-a2f2-4e151bd0c35b\', \'multiverseId\': 200563}, \'multiverseid\': 200563}, {\'name\': \'Sentinelle griffon\', \'text\': "Vol\\nVigilance (Attaquer avec cette créature ne la fait pas s\'engager.)", \'type\': \'Créature : griffon\', \'flavor\': "Une fois qu\'une sentinelle griffon s\'approprie un territoire, seule la mort peut la forcer à abandonner son poste.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199318&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2a8902ed-731f-4379-aa00-708884c11413\', \'multiverseId\': 199318}, \'multiverseid\': 199318}, {\'name\': \'Grifone Sentinella\', \'text\': \'Volare\\nCautela (Questa creatura attacca senza TAPpare.)\', \'type\': \'Creatura — Grifone\', \'flavor\': \'Dopo che un grifone sentinella ha fatto proprio un territorio, solo la morte può costringerlo ad abbandonare la sua postazione.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200314&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0f7b64a4-30ce-4491-99a3-d837906752f1\', \'multiverseId\': 200314}, \'multiverseid\': 200314}, {\'name\': \'グリフィンの歩哨\', \'text\': \'飛行\\n警戒 （このクリーチャーは攻撃してもタップしない。）\', \'type\': \'クリーチャー — グリフィン\', \'flavor\': \'一度持ち場に着いたグリフィンの歩哨をそこから引き離すことができるのは死だけだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199816&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'595c8b9a-64f0-476c-9a41-1a281f9ff943\', \'multiverseId\': 199816}, \'multiverseid\': 199816}, {\'name\': \'Grifo Sentinela\', \'text\': \'Voar\\nVigilância (Atacar não faz com que esta criatura seja virada.)\', \'type\': \'Criatura — Grifo\', \'flavor\': \'Quando um grifo sentinela adota um território como seu, somente a morte pode forçá-lo a trair seu posto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199069&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2e2e2539-a3a5-47c1-90e4-9baa8046a50d\', \'multiverseId\': 199069}, \'multiverseid\': 199069}, {\'name\': \'Грифон-Часовой\', \'text\': \'Полет\\nБдительность (При нападении это существо не поворачивается.)\', \'type\': \'Существо — Грифон\', \'flavor\': \'Если уж грифон взял под свое крыло территорию, только смерть может заставить его покинуть свой пост.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200065&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d06adb1c-b614-4cd8-9fec-8f864edb57d3\', \'multiverseId\': 200065}, \'multiverseid\': 200065}, {\'name\': \'哨兵狮鹫\', \'text\': \'飞行\\n警戒 （此生物攻击时不需横置。）\', \'type\': \'生物～狮鹫\', \'flavor\': \'一旦哨兵狮鹫认定了自己的领域，便至死都不会离开岗位。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200812&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'45c64b2d-30e3-4b01-9add-ba7393e305cc\', \'multiverseId\': 200812}, \'multiverseid\': 200812}]', '[{\'name\': \'Grenzlandwaldläufer\', \'text\': \'Wenn der Grenzlandwaldläufer ins Spiel kommt, kannst du deine Bibliothek nach einer Standardland-Karte durchsuchen, sie offen vorzeigen und auf deine Hand nehmen. Falls du dies tust, mische danach deine Bibliothek.\', \'type\': \'Kreatur — Mensch, Späher\', \'flavor\': \'„Nur Dummköpfe und Banditen verwenden Straßen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199724&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5542730b-899d-47c1-bb4d-84e1ad180aef\', \'multiverseId\': 199724}, \'multiverseid\': 199724}, {\'name\': \'Guardabosque fronterizo\', \'text\': \'Cuando el Guardabosque fronterizo entre en el campo de batalla, puedes buscar en tu biblioteca una carta de tierra básica, mostrarla y ponerla en tu mano. Si lo haces, baraja tu biblioteca.\', \'type\': \'Criatura — Explorador humano\', \'flavor\': \'"Sólo los tontos y los bandidos usan los caminos."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200720&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e67f9553-eaba-4be1-9fbd-ae5461e05628\', \'multiverseId\': 200720}, \'multiverseid\': 200720}, {\'name\': \'Ranger des frontières\', \'text\': \'Quand le Ranger des frontières arrive sur le champ de bataille, vous pouvez chercher dans votre bibliothèque une carte de terrain de base, la révéler et la mettre dans votre main. Si vous faites ainsi, mélangez votre bibliothèque.\', \'type\': \'Créature : humain et éclaireur\', \'flavor\': "« Il n\'y a que les imbéciles et les bandits pour utiliser la route. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199475&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9a8680a3-5284-41af-8360-b18994952ba2\', \'multiverseId\': 199475}, \'multiverseid\': 199475}, {\'name\': \'Ranger delle Terre di Confine\', \'text\': \'Quando il Ranger delle Terre di Confine entra nel campo di battaglia, puoi passare in rassegna il tuo grimorio per una carta terra base, rivelarla e aggiungerla alla tua mano. Se lo fai, rimescola il tuo grimorio.\', \'type\': \'Creatura — Esploratore Umano\', \'flavor\': \'"Solo gli sciocchi e i banditi usano le strade."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200471&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7e5f41f7-5ded-4d2d-979b-0da8e1fb9236\', \'multiverseId\': 200471}, \'multiverseid\': 200471}, {\'name\': \'国境地帯のレインジャー\', \'text\': \'国境地帯のレインジャーが戦場に出たとき、あなたは自分のライブラリーから基本土地カードを1枚探してもよい。そうしたなら、それを公開してあなたの手札に加える。 そうした場合、あなたのライブラリーを切り直す。\', \'type\': \'クリーチャー — 人間・スカウト\', \'flavor\': \'「道なんかを使うのは馬鹿か山賊だけだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199973&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2abe981d-e1db-4e13-94fc-1ad1acea1700\', \'multiverseId\': 199973}, \'multiverseid\': 199973}, {\'name\': \'Patrulheiro de Fronteira\', \'text\': \'Quando Patrulheiro de Fronteira entra no campo de batalha, você pode procurar em seu grimório por um card de terreno básico, revelá-lo e colocá-lo em sua mão. Se fizer isso, embaralhe seu grimório.\', \'type\': \'Criatura — Humano Batedor\', \'flavor\': \'"Só os tolos e os bandidos viajam por estradas."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199226&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d2243e28-657f-4fa6-9875-63ffcca219a0\', \'multiverseId\': 199226}, \'multiverseid\': 199226}, {\'name\': \'Лесничий с Окраины\', \'text\': \'Когда Лесничий с Окраины выходит на поле битвы, вы можете найти в вашей библиотеке карту базовой земли, показать ее и положить в вашу руку. Если вы это делаете, перетасуйте вашу библиотеку.\', \'type\': \'Существо — Человек Разведчик\', \'flavor\': \'«По дорогам бродят лишь дураки да разбойники».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200222&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'46400622-0068-4ea6-9284-2b1e9b4b796c\', \'multiverseId\': 200222}, \'multiverseid\': 200222}, {\'name\': \'边境巡林者\', \'text\': \'当边境巡林者进战场时，你可以从你的牌库中搜寻一张基本地牌，展示该牌，并将它置入你手上。 若你如此作，则将你的牌库洗牌。\', \'type\': \'生物～人类／斥候\', \'flavor\': \'「只有笨蛋与山贼才走道路。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200969&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9c2638b2-eabc-46cf-8149-125c801539b9\', \'multiverseId\': 200969}, \'multiverseid\': 200969}]', "[{'name': 'Gähnender Spalt', 'text': 'Jeder Gegner opfert ein Land.', 'type': 'Hexerei', 'flavor': 'Der Kartenzeichner grummelte. Er seufzte, holte sein Pergament hervor und übermalte die Ewige Wiese mit einem großen schwarzen Fleck.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199719&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'bdee1aba-2c1b-4871-8d9c-db78b44808dc', 'multiverseId': 199719}, 'multiverseid': 199719}, {'name': 'Fisura profunda', 'text': 'Cada oponente sacrifica una tierra.', 'type': 'Conjuro', 'flavor': 'El mapeador gruñó. Suspiró, desenrolló su pergamino y pintó una gran mancha negra donde antes estaba la Pradera Eterna.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200715&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '14de4f59-ce34-4449-8a85-c43d75f8ec6f', 'multiverseId': 200715}, 'multiverseid': 200715}, {'name': 'Fissure béante', 'text': 'Chaque adversaire sacrifie un terrain.', 'type': 'Rituel', 'flavor': 'Le cartographe grimaça. Il soupira, déroula son parchemin et peignit une grosse tache noire là où se trouvait autrefois la Prairie Éternelle.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199470&type=card', 'language': 'French', 'identifiers': {'scryfallId': '69194217-bbba-4266-ae49-2410b6dd7e77', 'multiverseId': 199470}, 'multiverseid': 199470}, {'name': 'Fenditura Spalancata', 'text': 'Ogni avversario sacrifica una terra.', 'type': 'Stregoneria', 'flavor': 'Il cartografo aggrottò la fronte. Sospirò, srotolò la sua pergamena e tracciò una grossa macchia nera dove un tempo era indicata la Prateria Eterna.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200466&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3a275e95-ec40-4f50-85a6-da8833d02f85', 'multiverseId': 200466}, 'multiverseid': 200466}, {'name': '口を開く地割れ', 'text': '各対戦相手はそれぞれ土地を１つ生け贄に捧げる。', 'type': 'ソーサリー', 'flavor': '地図作り士は顔をしかめた。 彼はため息をつくと、羊皮紙を広げ、かつて永遠の麦畑として記されていた場所を黒く塗りつぶした。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199968&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '069532de-4c3b-45ec-acac-1a16c6ff6db8', 'multiverseId': 199968}, 'multiverseid': 199968}, {'name': 'Fissura Bocejadora', 'text': 'Cada oponente sacrifica um terreno.', 'type': 'Feitiço', 'flavor': 'O cartógrafo franziu a testa. Suspirou, desenrolou seu pergaminho e desenhou uma grande mancha preta onde antes ficava o Prado Eterno.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199221&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'bb4024f3-ef66-4e42-9122-2d0dc31a9795', 'multiverseId': 199221}, 'multiverseid': 199221}, {'name': 'Зияющая Расселина', 'text': 'Каждый оппонент приносит в жертву землю.', 'type': 'Волшебство', 'flavor': 'Картограф нахмурился. Затем вздохнул, развернул пергамент и нарисовал большую жирную точку в том месте, где когда-то был обозначен Вечный Луг.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200217&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'b032f039-a053-42fa-bd8e-9325bd684c76', 'multiverseId': 200217}, 'multiverseid': 200217}, {'name': '豁口裂缝', 'text': '每位对手各牺牲一个地。', 'type': '法术', 'flavor': '制图师皱起眉头。 他叹了口气，摊开羊皮纸，把地图上原本标记永恒牧原的地方涂黑。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200964&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c4318eac-13ac-4930-a6f0-9b52caf60d5b', 'multiverseId': 200964}, 'multiverseid': 200964}]", '[{\'name\': \'Göttliches Verdikt\', \'text\': \'Zerstöre eine angreifende oder blockende Kreatur deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'Riesen und Grubengezücht versuchten, die Säulen der Kathedrale umzuwerfen. Der Staub, der von ihnen übrig geblieben ist, weht immer noch durch die Straßen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199563&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'93dc9e2d-d862-40ed-9f27-74f1976e01d4\', \'multiverseId\': 199563}, \'multiverseid\': 199563}, {\'name\': \'Veredicto divino\', \'text\': \'Destruye la criatura atacante o bloqueadora objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'Gigantes y demonios intentaron derrumbar los pilares de la catedral. La delgada capa de sus restos aún se arremolina con la brisa allí afuera.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200559&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a5ecf19b-1af2-4303-ad7d-1ce64836de96\', \'multiverseId\': 200559}, \'multiverseid\': 200559}, {\'name\': \'Verdict divin\', \'text\': \'Détruisez la créature attaquante ou bloqueuse ciblée.\', \'type\': \'Éphémère\', \'flavor\': "Les géants et l\'engeance de l\'Abîme essayèrent de renverser les piliers de la cathédrale. La poussière fine de leurs cendres tourbillonne encore dans la brise.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199314&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b985ba59-e674-415e-aa5c-fd83d62715c5\', \'multiverseId\': 199314}, \'multiverseid\': 199314}, {\'name\': \'Verdetto Divino\', \'text\': \'Distruggi una creatura attaccante o bloccante bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': "I giganti e le progenie dell\'abisso tentarono di far crollare i pilastri della cattedrale. La polvere fine dei loro resti continua a turbinare nella brezza all\'esterno.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200310&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'04c9790d-7ae4-49d3-a47e-a342fd2a26a6\', \'multiverseId\': 200310}, \'multiverseid\': 200310}, {\'name\': \'神聖なる評決\', \'text\': \'攻撃かブロックしているクリーチャー１体を対象とし、それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'巨人や奈落の落とし児たちは、聖堂の柱を倒そうとしていた。 彼らの死体の塵は、いまだに外の風に舞っている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199812&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4aa8b32b-2101-41df-be5c-19be0946c94d\', \'multiverseId\': 199812}, \'multiverseid\': 199812}, {\'name\': \'Veredicto Divino\', \'text\': \'Destrua a criatura atacante ou bloqueadora alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Gigantes e crias do antro tentaram derrubar os pilares da catedral. A poeira dos seus restos mortais ainda esvoaça na brisa lá fora.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199065&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e2f2293d-f7cf-44b2-8b70-e4ba7d79bd45\', \'multiverseId\': 199065}, \'multiverseid\': 199065}, {\'name\': \'Божественный Приговор\', \'text\': \'Уничтожьте целевое атакующее или блокирующее существо.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Гиганты и порождения преисподней пытались повалить храмовые колонны. Их истлевший прах до сих пор кружит по ветру.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200061&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ab973017-dad1-4b23-bbac-b3cf331463a1\', \'multiverseId\': 200061}, \'multiverseid\': 200061}, {\'name\': \'明圣裁定\', \'text\': \'消灭目标进行攻击或阻挡的生物。\', \'type\': \'瞬间\', \'flavor\': \'巨人与暗渊魔裔曾试图弄垮教堂础柱。 他们遗体所化的尘埃至今仍随着门外微风打转。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200808&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'62b7f820-61c1-4604-bbb1-72a7c417cc0a\', \'multiverseId\': 200808}, \'multiverseid\': 200808}]', '[{\'name\': \'Hauptmann der Wache\', \'text\': \'Wachsamkeit (Diese Kreatur wird beim Angreifen nicht getappt.)\\nAndere Soldaten-Kreaturen, die du kontrollierst, erhalten +1/+1 und haben Wachsamkeit.\\nWenn der Hauptmann der Wache ins Spiel kommt, bringe drei 1/1 weiße Soldat-Kreaturenspielsteine ins Spiel.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199561&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ab083613-0539-4b9c-919e-06f7e57adc0e\', \'multiverseId\': 199561}, \'multiverseid\': 199561}, {\'name\': \'Capitán de la Guardia\', \'text\': \'Vigilancia. (Esta criatura no se gira al atacar.)\\nLas otras criaturas Soldado que controlas obtienen +1/+1 y tienen vigilancia.\\nCuando el Capitán de la Guardia entra en el campo de batalla, pon tres fichas de criatura Soldado blancas 1/1 en el campo de batalla.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200557&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'53d50dce-b58e-4845-98c3-fcbe969ede9e\', \'multiverseId\': 200557}, \'multiverseid\': 200557}, {\'name\': \'Capitaine des veilleurs\', \'text\': "Vigilance (Attaquer avec cette créature ne la fait pas s\'engager.)\\nLes autres créatures Soldat que vous contrôlez gagnent +1/+1 et ont la vigilance.\\nQuand le Capitaine des veilleurs arrive sur le champ de bataille, mettez trois jetons de créature 1/1 blanche Soldat sur le champ de bataille.", \'type\': \'Créature : humain et soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199312&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fc8d3297-866b-4e36-97e9-38be7bad25eb\', \'multiverseId\': 199312}, \'multiverseid\': 199312}, {\'name\': \'Capitano della Guardia\', \'text\': \'Cautela (Questa creatura attacca senza TAPpare.)\\nLe altre creature Soldato che controlli prendono +1/+1 e hanno cautela.\\nQuando il Capitano della Guardia entra nel campo di battaglia, metti sul campo di battaglia tre pedine creatura Soldato 1/1 bianche.\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200308&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bb53fb2a-c7eb-4dc8-b92b-bec2e255f036\', \'multiverseId\': 200308}, \'multiverseid\': 200308}, {\'name\': \'警備隊長\', \'text\': \'警戒 （このクリーチャーは攻撃してもタップしない。）\\nあなたがコントロールする他の兵士・クリーチャーは、＋１/＋１の修整を受けるとともに警戒を持つ。\\n警備隊長が戦場に出たとき、白の１/１の兵士・クリーチャー・トークンを３体戦場に出す。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199810&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c3e6de9a-76b1-4850-a435-c28c2d43379f\', \'multiverseId\': 199810}, \'multiverseid\': 199810}, {\'name\': \'Capitão da Vigilância\', \'text\': \'Vigilância (Atacar não faz com que esta criatura seja virada.)\\nOutras criaturas do tipo Soldado que você controla recebem +1/+1 e têm vigilância.\\nQuando Capitão da Vigilância entra no campo de batalha, coloque três fichas de criaturas brancas 1/1 do tipo Soldado no campo de batalha.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199063&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b587921b-cda7-48a6-86c8-4bc94c11a59d\', \'multiverseId\': 199063}, \'multiverseid\': 199063}, {\'name\': \'Капитан Стражи\', \'text\': \'Бдительность (Атакуя, это существо не поворачивается.)\\nДругие существа-Солдаты под вашим контролем получают +1/+1 и имеют Бдительность.\\nКогда Капитан Стражи выходит на поле битвы, положите на поле битвы три фишки существа 1/1 белый Солдат.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200059&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ed6ca5ed-d316-4b84-a717-20394911ad6b\', \'multiverseId\': 200059}, \'multiverseid\': 200059}, {\'name\': \'守望队长\', \'text\': \'警戒 （此生物攻击时不需横置。）\\n由你操控的其他士兵生物得+1/+1并具有警戒异能。\\n当守望队长进战场时，将三个1/1白色士兵衍生物放进战场。\', \'type\': \'生物～人类／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200806&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ae8022a1-bcec-4024-9188-e584ed53902c\', \'multiverseId\': 200806}, \'multiverseid\': 200806}]', '[{\'name\': \'Heer der geplagten Skelette\', \'text\': \'{B}: Regeneriere das Heer der geplagten Skelette. (Das nächste Mal, dass diese Kreatur in diesem Zug zerstört würde, wird sie nicht zerstört. Tappe sie stattdessen, entferne allen Schaden von ihr und entferne sie aus dem Kampf.)\', \'type\': \'Kreatur — Skelett\', \'flavor\': \'„Die Toten geben gute Soldaten ab. Sie können keine Befehle verweigern, geben nie auf, und hören nicht auf zu kämpfen, wenn mal ein Körperteil abgeschlagen wird." —Nevinyrral, Handbuch für Zauberer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199650&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3acf0c81-7211-4a23-8c13-2a59df796f36\', \'multiverseId\': 199650}, \'multiverseid\': 199650}, {\'name\': \'Esqueletos esclavos\', \'text\': \'{B}: Regenera a los Esqueletos esclavos. (La próxima vez que esta criatura fuera a ser destruida este turno, no lo es. En vez de eso, gírala, remueve todo el daño de ella y remuévela del combate.)\', \'type\': \'Criatura — Esqueleto\', \'flavor\': \'"Los muertos son buenos soldados. No pueden desobedecer órdenes, nunca se rinden y no dejan de pelear cuando se les cae una parte del cuerpo." —Nevinyrral, Manual del Nigromante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200646&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c3684944-1bfa-4631-84ee-a09301d0ab06\', \'multiverseId\': 200646}, \'multiverseid\': 200646}, {\'name\': \'Squelettes serviles\', \'text\': "{B} : Régénérez les Squelettes serviles. (La prochaine fois que cette créature devrait être détruite ce tour-ci, elle ne l\'est pas. À la place, engagez-la, retirez-lui toutes ses blessures et retirez-la du combat.)", \'type\': \'Créature : squelette\', \'flavor\': \'« Les morts font de bons soldats. Ils ne peuvent désobéir, ils ne se rendent pas, et ils ne cessent pas le combat quand un morceau de leur corps vient à tomber. » —Nevinyrral, Le guide du parfait nécromancien\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199401&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f95609db-665f-453e-aef4-a0bcf76c988d\', \'multiverseId\': 199401}, \'multiverseid\': 199401}, {\'name\': \'Scheletri Maledetti\', \'text\': \'{B}: Rigenera gli Scheletri Maledetti. (La prossima volta che questa creatura sta per essere distrutta in questo turno, non viene distrutta. Invece TAPpala, rimuovi da essa tutto il danno e rimuovila dal combattimento.)\', \'type\': \'Creatura — Scheletro\', \'flavor\': \'"I morti sono ottimi soldati. Non disobbediscono agli ordini, non si arrendono mai e non si fermano quando perdono una parte del corpo in battaglia." —Nevinyrral, Manuale del Necromante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200397&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7301b4d2-0af4-4473-8a22-6b0756c13a48\', \'multiverseId\': 200397}, \'multiverseid\': 200397}, {\'name\': \'蠢く骸骨\', \'text\': \'{B}：蠢く骸骨を再生する。 （このターン、次にこのクリーチャーが破壊される場合、破壊されない。 代わりに、それをタップし、それに与えられているダメージをすべて取り除き、それを戦闘から取り除く。）\', \'type\': \'クリーチャー — スケルトン\', \'flavor\': \'死者は兵士に絶好である。 命令に逆らうこともなければ、降伏することもありえない。しかも、身体のどこかが取れたぐらいでは戦いをやめないのだから。 ――ネビニラル「ネクロマンサーの手引き」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199899&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8378da35-33b6-42e8-8e3d-60f8f0307805\', \'multiverseId\': 199899}, \'multiverseid\': 199899}, {\'name\': \'Esqueletos de Carga\', \'text\': \'{B}: Regenere Esqueletos de Carga. (Na próxima vez em que esta criatura seria destruída neste turno, ela não será. Em vez disso, vire-a, remova todo o dano dela e remova-a do combate.)\', \'type\': \'Criatura — Esqueleto\', \'flavor\': \'"Os mortos dão bons soldados. Não podem desobedecer ordens, jamais se rendem e não param de lutar só por que lhes caiu alguma parte do corpo." — Nevinyrral, Manual do Necromante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199152&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8bb47c94-6185-456a-b5a0-a25260bb003e\', \'multiverseId\': 199152}, \'multiverseid\': 199152}, {\'name\': \'Неутомимые Скелеты\', \'text\': \'{B}: регенерируйте Неутомимых Скелетов. (В следующий раз при уничтожении этого существа в этом ходу, оно не уничтожается. Вместо этого поверните его, снимите с него все повреждения и удалите его из боя.)\', \'type\': \'Существо — Скелет\', \'flavor\': \'«Из мертвых получаются хорошие солдаты. Они не могут не подчиняться приказам, никогда не сдаются, не прекращают сражения, даже если отвалилась какая-то часть тела». — Невиниррал, Справочник некроманта\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200148&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'41a6e6cc-075b-469d-a848-c4577e4815af\', \'multiverseId\': 200148}, \'multiverseid\': 200148}, {\'name\': \'苦力骷髅妖\', \'text\': \'{B}：重生苦力骷髅妖。 （如果此生物下一次于本回合中将被消灭，则它不会被消灭， 而是改为将它横置，移除受过的所有伤害，并将它移出战斗。）\', \'type\': \'生物～骷髅妖\', \'flavor\': \'「死者可成为良好的士兵。 它们不会违背命令，它们从不投降，它们也不会因为身上随便哪块部份掉下来就停止战斗。」 ～妮维亚洛，《死灵术士手册》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200895&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'64fa46fe-254e-44b2-a236-c49c380a1408\', \'multiverseId\': 200895}, \'multiverseid\': 200895}]', '[{\'name\': \'Heilige Stärke\', \'text\': \'Kreaturenverzauberung\\nDie verzauberte Kreatur erhält +1/+2.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Das erste Kind, geboren unter der Sonne, wird nach Ehre streben und von deren Rechtschaffenheit gestärkt sein." —Codex der Constellari\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199570&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'05d1e7b8-7b7c-4f04-986d-a23a7303067d\', \'multiverseId\': 199570}, \'multiverseid\': 199570}, {\'name\': \'Fuerza sagrada\', \'text\': \'Encantar criatura.\\nLa criatura encantada obtiene +1/+2.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"Nacido bajo el sol, el primer niño buscará la fuente del honor y será fortificado por su rectitud." —Codex de los Constellari\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200566&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c3b206fa-6aad-46d4-96d4-42ca0643c147\', \'multiverseId\': 200566}, \'multiverseid\': 200566}, {\'name\': \'Force sacrée\', \'text\': \'Enchanter : créature\\nLa créature enchantée gagne +1/+2.\', \'type\': \'Enchantement : aura\', \'flavor\': "« Né sous le signe du soleil, le premier né cherchera les fondements de l\'honneur et sera fortifié par sa vertu. » —Codex des Constellari", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199321&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'85f561dc-85a3-410b-b8e6-ded5c1ba78a2\', \'multiverseId\': 199321}, \'multiverseid\': 199321}, {\'name\': \'Forza Sacra\', \'text\': \'Incanta creatura\\nLa creatura incantata prende +1/+2.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Nato sotto il sole, il primogenito cercherà il fondamento dell\\\'onore e sarà fortificato dalla sua rettitudine." —Codice dei Costellari\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200317&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'85a8a46e-a8fd-40d5-9b82-5684a334402f\', \'multiverseId\': 200317}, \'multiverseid\': 200317}, {\'name\': \'聖なる力\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは＋１/＋２の修整を受ける。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「陽の下に生まれし第一の児は、名誉の礎を求め、正義に守らるるであろう。」 ――星辰党写本\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199819&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e7e3a60a-e025-411c-9867-7417f0385b75\', \'multiverseId\': 199819}, \'multiverseid\': 199819}, {\'name\': \'Força Divina\', \'text\': \'Encantar criatura\\nA criatura encantada recebe +1/+2.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Nascido sob o sol, o primeiro filho buscará os fundamentos da honra e será fortalecido por sua retidão." —Códice de Constellari\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199072&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1a340c0f-71e2-419e-b1e9-ead3cd0b3715\', \'multiverseId\': 199072}, \'multiverseid\': 199072}, {\'name\': \'Святая Сила\', \'text\': \'Зачаровать существо\\nЗачарованное существо получает +1/+2.\', \'type\': \'Чары — Аура\', \'flavor\': \'«Рожденный под солнцем, первый ребенок устремится к оплоту чести и найдет силу в праведности». — Кодекс Констеллари\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200068&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d8470d62-2d1f-454e-8173-971b0e8177b1\', \'multiverseId\': 200068}, \'multiverseid\': 200068}, {\'name\': \'神圣之力\', \'text\': \'结附于生物\\n所结附的生物得+1/+2。\', \'type\': \'结界～灵气\', \'flavor\': \'「第一个孩子在阳光下诞生，将会寻找荣耀的基础，且有正义加护。」 ～繁星法典\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200815&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'eae59dcd-12bf-4f24-9c63-3396b7658a8e\', \'multiverseId\': 200815}, \'multiverseid\': 200815}]', '[{\'name\': \'Herr der Wilden Jagd\', \'text\': \'Bringe zu Beginn deines Versorgungssegments einen 2/2 grünen Wolf-Kreaturenspielstein ins Spiel.\\n{T}: Tappe alle ungetappten Wolf-Kreaturen, die du kontrollierst. Jeder auf diese Weise getappte Wolf fügt einer Kreatur deiner Wahl Schadenspunkte in Höhe seiner Stärke zu. Diese Kreatur fügt Schadenspunkte in Höhe ihrer Stärke zu, aufgeteilt auf eine beliebige Anzahl dieser Wölfe, wobei ihr Beherrscher die Aufteilung bestimmt.\', \'type\': \'Kreatur — Mensch, Schamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199746&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1afb01e7-f66d-418b-888f-d35202429891\', \'multiverseId\': 199746}, \'multiverseid\': 199746}, {\'name\': \'Maestro de la caza salvaje\', \'text\': \'Al comienzo de tu mantenimiento, pon en el campo de batalla una ficha de criatura Lobo verde 2/2.\\n{T}: Gira todas las criaturas Lobo enderezadas que controlas. {T}: Cada Lobo girado de esta manera hace daño igual a su fuerza a la criatura objetivo. Esa criatura hace daño igual a su fuerza dividido como elija su controlador entre cualquier cantidad de esos Lobos.\', \'type\': \'Criatura — Chamán humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200742&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3c1ecf48-ddfa-4519-b5a0-6d4b1b27e054\', \'multiverseId\': 200742}, \'multiverseid\': 200742}, {\'name\': \'Maître de la vénerie sauvage\', \'text\': \'Au début de votre entretien, mettez sur le champ de bataille un jeton de créature 2/2 verte Loup.\\n{T} : Engagez toutes les créatures Loup dégagées que vous contrôlez. Chaque loup engagé de cette manière inflige un nombre de blessures égal à sa force à la créature ciblée. Cette créature inflige un nombre de blessures égal à sa force, réparties de la manière que son contrôleur le choisit parmi un nombre quelconque de ces loups.\', \'type\': \'Créature : humain et shamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199497&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'34da6009-427b-48a9-8d0a-a5706809c761\', \'multiverseId\': 199497}, \'multiverseid\': 199497}, {\'name\': \'Maestro della Caccia Selvaggia\', \'text\': "All\'inizio del tuo mantenimento, metti sul campo di battaglia una pedina creatura Lupo 2/2 verde.\\n{T}: TAPpa tutte le creature Lupo STAPpate che controlli. Ogni Lupo TAPpato in questo modo infligge danno pari alla sua forza a una creatura bersaglio. Quella creatura infligge danno pari alla sua forza suddiviso a scelta del suo controllore tra un qualsiasi numero di quei Lupi.", \'type\': \'Creatura — Sciamano Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200493&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8774a55d-8c62-40cc-9d82-d7a5e2e8f381\', \'multiverseId\': 200493}, \'multiverseid\': 200493}, {\'name\': \'野生の狩りの達人\', \'text\': \'あなたのアップキープの開始時に、緑の２/２の狼・クリーチャー・トークンを１体戦場に出す。\\n{T}：クリーチャー１体を対象とする。あなたがコントロールするアンタップ状態の狼・クリーチャーをすべてタップする。 これによりタップされた狼は、それぞれそのクリーチャーに、自身のパワーに等しい点数のダメージを与える。 そのクリーチャーは、自身のパワーに等しい点数のダメージを、それのコントローラーの望むように、それらの狼に割り振って与える。\', \'type\': \'クリーチャー — 人間・シャーマン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199995&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'845731e6-e53e-4c0a-817e-3dd9ce13fd30\', \'multiverseId\': 199995}, \'multiverseid\': 199995}, {\'name\': \'Mestre da Caçada Selvagem\', \'text\': \'No início de sua manutenção, coloque no campo de batalha uma ficha de criatura verde 2/2 do tipo Lobo.\\n{T}: Vire todas as criaturas do tipo Lobo desviradas que você controle. Cada Lobo virado dessa maneira causa uma quantidade de dano igual ao seu poder à criatura alvo. Aquela criatura causa uma quantidade de dano igual ao seu poder dividido conforme escolhido por seu controlador entre qualquer número desses Lobos.\', \'type\': \'Criatura — Humano Xamã\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199248&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9aa20654-699a-4435-8746-3e1680981b55\', \'multiverseId\': 199248}, \'multiverseid\': 199248}, {\'name\': \'Хозяин Дикой Охоты\', \'text\': \'В начале вашего шага поддержки положите на поле битвы одну фишку существа 2/2 зеленый Волк.\\n{T}: поверните всех неповернутых существ-Волков под вашим контролем. Каждый повернутый таким образом Волк наносит целевому существу повреждения, равные своей силе. То существо наносит повреждения, равные своей силе, распределенные по желанию контролирующего его игрока между любым количеством тех Волков.\', \'type\': \'Существо — Человек Шаман\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200244&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d49934b3-1b5b-43f7-928b-77eaafcb3eda\', \'multiverseId\': 200244}, \'multiverseid\': 200244}, {\'name\': \'幽猎领袖\', \'text\': \'在你的维持开始时，将一个2/2绿色的狼衍生物放进战场。\\n{T}：横置所有由你操控且未横置的狼生物。 每个以此法横置的狼生物都对目标生物造成伤害，其数量等同于前者的力量。 该生物对任意数量的这些狼生物造成伤害，其总数量等同于该生物的力量，且其操控者可任意分配之。\', \'type\': \'生物～人类／祭师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200991&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e5e66ecd-6340-49d2-97e0-66ea3405322c\', \'multiverseId\': 200991}, \'multiverseid\': 200991}]', '[{\'name\': \'Herstellung\', \'text\': \'Durchsuche deine Bibliothek nach einer Artefaktkarte, zeige sie offen vor und nimm sie auf deine Hand. Mische danach deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': \'„Ich bin nur ein Meisterwerk davon entfernt, der Herrscher dieser armseligen Welt zu werden." —Saldrath, Meisterbastler\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199607&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9c376132-89e8-4805-8ae1-8db786eaede7\', \'multiverseId\': 199607}, \'multiverseid\': 199607}, {\'name\': \'Fabricar\', \'text\': \'Busca en tu biblioteca una carta de artefacto, muéstrala y ponla en tu mano. Luego baraja tu biblioteca.\', \'type\': \'Conjuro\', \'flavor\': \'"Estoy a una obra maestra de dominar este patético mundo." —Saldrath, maestro artífice\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200603&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0a2f98c4-3382-45af-a19c-96ba3078259a\', \'multiverseId\': 200603}, \'multiverseid\': 200603}, {\'name\': \'Fabrication\', \'text\': "Cherchez dans votre bibliothèque une carte d\'artefact, révélez-la et mettez-la dans votre main. Mélangez ensuite votre bibliothèque.", \'type\': \'Rituel\', \'flavor\': "« Je suis à un chef d\'œuvre près de régner sur ce monde pathétique. » —Saldrath, maître artificier", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199358&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'edcc85f7-a2a9-4a03-810d-910c27d74e42\', \'multiverseId\': 199358}, \'multiverseid\': 199358}, {\'name\': \'Fabbricare\', \'text\': \'Passa in rassegna il tuo grimorio per una carta artefatto, rivelala e aggiungila alla tua mano. Poi rimescola il tuo grimorio.\', \'type\': \'Stregoneria\', \'flavor\': \'"Sono a un capolavoro dal governare questo mondo patetico." —Saldrath, mastro artificiere\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200354&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'91801ece-b69e-403a-aca7-9cd6026513bf\', \'multiverseId\': 200354}, \'multiverseid\': 200354}, {\'name\': \'加工\', \'text\': \'あなたのライブラリーからアーティファクト・カードを１枚探し、それを公開してあなたの手札に加える。 その後あなたのライブラリーを切り直す。\', \'type\': \'ソーサリー\', \'flavor\': \'「このつまらぬ世界を支配するのに、作品が一つ足りぬ。」 ――練達の工匠、サルドラス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199856&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ebfac1b9-b074-4e6c-a09b-8f3fd5bd9656\', \'multiverseId\': 199856}, \'multiverseid\': 199856}, {\'name\': \'Fabricar\', \'text\': \'Procure em seu grimório por um card de artefato, revele-o e coloque-o em sua mão. Depois, embaralhe seu grimório.\', \'type\': \'Feitiço\', \'flavor\': \'"Mais uma obra de arte e serei capaz de governar este mundo patético." —Saldrath, mestre artífice\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199109&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ff0f4a72-dac6-46c6-8209-85c601033857\', \'multiverseId\': 199109}, \'multiverseid\': 199109}, {\'name\': \'Фабрикация\', \'text\': \'Найдите в вашей библиотеке карту артефакта, покажите ее и положите в вашу руку. Затем перетасуйте вашу библиотеку.\', \'type\': \'Волшебство\', \'flavor\': \'«Последний шедевр, и я стану повелителем этого жалкого мира». — Салдрат, мастер-изобретатель\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200105&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'aa2b1218-3b58-4bac-9a63-9cb6f97f1289\', \'multiverseId\': 200105}, \'multiverseid\': 200105}, {\'name\': \'装配\', \'text\': \'从你的牌库中搜寻一张神器牌，展示该牌，并将它置于你手上。 然后将你的牌库洗牌。\', \'type\': \'法术\', \'flavor\': \'「再有一个伟大作品，我就能统治这可悲的世界。」 ～神器大师索坠斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200852&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c0ccf269-8689-42fb-beec-14a7feff998a\', \'multiverseId\': 200852}, \'multiverseid\': 200852}]', "[{'name': 'Heulen des Nachtrudels', 'text': 'Bringe für jeden Wald, den du kontrollierst, einen 2/2 grünen Wolf-Kreaturenspielstein ins Spiel.', 'type': 'Hexerei', 'flavor': 'Das Rabenrevier ist für seine mörderischen Schrecken berüchtigt, aber selbst hier wird alles ruhig, wenn die Nachtwölfe heulen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199742&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'fadbb7c9-6e51-43af-a4e5-5e9a469c5a09', 'multiverseId': 199742}, 'multiverseid': 199742}, {'name': 'Aullido de la manada nocturna', 'text': 'Pon en el campo de batalla una ficha de criatura Lobo verde 2/2 por cada bosque que controles.', 'type': 'Conjuro', 'flavor': 'Los horrores de Coto de Cuervos son legendarios, pero incluso ese lugar embrujado calla cuando aúllan los lobos nocturnos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200738&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '31c36e26-75c7-475f-a3c9-710b30a90e5f', 'multiverseId': 200738}, 'multiverseid': 200738}, {'name': 'Hurlement de la meute nocturne', 'text': 'Mettez sur le champ de bataille un jeton de créature 2/2 verte Loup pour chaque forêt que vous contrôlez.', 'type': 'Rituel', 'flavor': 'Les horreurs meurtrières de la Garenne du Corbeau sont légendaires, mais même ce lieu hanté se tait quand les loups nocturnes commencent à hurler.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199493&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a5079311-7da1-4bb7-bf6f-fe9ebc4e4539', 'multiverseId': 199493}, 'multiverseid': 199493}, {'name': 'Ululato del Branco Notturno', 'text': 'Metti sul campo di battaglia una pedina creatura Lupo 2/2 verde per ogni Foresta che controlli.', 'type': 'Stregoneria', 'flavor': 'Gli orrori omicida di Volo del Corvo sono leggendari, ma anche questo posto infestato si acquieta quando ululano i lupi notturni.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200489&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'f60ca130-a13e-4e20-9e2f-05d93957d726', 'multiverseId': 200489}, 'multiverseid': 200489}, {'name': '夜の群れの雄叫び', 'text': 'あなたがコントロールする森１つにつき、緑の２/２の狼・クリーチャー・トークンを１体戦場に出す。', 'type': 'ソーサリー', 'flavor': 'レイヴンの地は、そのおぞましい恐怖で伝説となっているが、そんな呪われた場所でも夜狼の吠える時には静かになる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199991&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '04a910ad-b5d6-4778-a5b8-6c0d9f74598f', 'multiverseId': 199991}, 'multiverseid': 199991}, {'name': 'Uivo da Matilha Noturna', 'text': 'Coloque no campo de batalha uma ficha de criatura verde 2/2 do tipo Lobo para cada Floresta que você controle.', 'type': 'Feitiço', 'flavor': 'Os horrores assassinos da Toca do Corvo são lendários, mas até mesmo esse lugar assombrado fica em silêncio quando os lobos noturnos uivam.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199244&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd3cb6969-3b4f-41f0-957b-18602f67716c', 'multiverseId': 199244}, 'multiverseid': 199244}, {'name': 'Вой Ночной Стаи', 'text': 'Положите на поле битвы одну фишку существа 2/2 зеленый Волк за каждый Лес под вашим контролем.', 'type': 'Волшебство', 'flavor': 'О кровожадных ужасах Вороновых Угодий сложены легенды, но даже это жуткое место замолкает при вое ночных волков.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200240&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '6ff65295-5022-4e1e-854b-5a2ba07f62a0', 'multiverseId': 200240}, 'multiverseid': 200240}, {'name': '夜狼群之吼', 'text': '你每操控一个树林，便将一个2/2绿色的狼衍生物放进战场。', 'type': '法术', 'flavor': '生息于黑鸦地的凶猛惊惧兽非常闻名，但当夜狼长嚎，即使此般鬼境也会为之静默。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200987&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '58f32622-0f8c-47de-9406-24058bb2654d', 'multiverseId': 200987}, 'multiverseid': 200987}]", '[{\'name\': \'Heulende Todesfee\', \'text\': \'Fliegend\\nWenn die Heulende Todesfee ins Spiel kommt, verliert jeder Spieler 3 Lebenspunkte.\', \'type\': \'Kreatur — Geist\', \'flavor\': \'Die Bewohner hüllten ihr Dorf in magische Stille, und dennoch tropfte Blut aus ihren Ohren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199654&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cb18e3c0-0c7e-42fa-961a-cce434d998f3\', \'multiverseId\': 199654}, \'multiverseid\': 199654}, {\'name\': \'Banshee aulladora\', \'text\': \'Vuela.\\nCuando la Banshee aulladora entre al campo de batalla, cada jugador pierde 3 vidas.\', \'type\': \'Criatura — Espíritu\', \'flavor\': \'Los pobladores cubrieron la ciudad en un silencio mágico, pero sus oídos igual sangraron.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200650&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d08e24dc-b61d-4fe3-a59c-05fbb3be081e\', \'multiverseId\': 200650}, \'multiverseid\': 200650}, {\'name\': \'Banshee hurlante\', \'text\': \'Vol\\nQuand la Banshee hurlante arrive sur le champ de bataille, chaque joueur perd 3 points de vie.\', \'type\': \'Créature : esprit\', \'flavor\': "Les villageois enveloppèrent la ville d\'un silence magique, mais leurs oreilles saignaient toujours.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199405&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e6ffd5f3-57b0-4b3b-9aaf-e55c7eacc075\', \'multiverseId\': 199405}, \'multiverseid\': 199405}, {\'name\': \'Banshee Ululante\', \'text\': \'Volare\\nQuando la Banshee Ululante entra nel campo di battaglia, ogni giocatore perde 3 punti vita.\', \'type\': \'Creatura — Spirito\', \'flavor\': \'Gli abitanti ammantarono il villaggio in un silenzio magico, ma le loro orecchie continuarono a sanguinare.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200401&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'affa56ed-37a1-4815-a55c-2618e3b04267\', \'multiverseId\': 200401}, \'multiverseid\': 200401}, {\'name\': \'吠えたけるバンシー\', \'text\': \'飛行\\n吠えたけるバンシーが戦場に出たとき、各プレイヤーは３点のライフを失う。\', \'type\': \'クリーチャー — スピリット\', \'flavor\': \'村人は街を魔法の沈黙で覆ったが、それでも耳からは血が流れていた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199903&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'79d95549-792a-4e4f-bf71-7482ec208edf\', \'multiverseId\': 199903}, \'multiverseid\': 199903}, {\'name\': \'Banshee Clamante\', \'text\': \'Voar\\nQuando Banshee Clamante entra no campo de batalha, cada jogador perde 3 pontos de vida.\', \'type\': \'Criatura — Espírito\', \'flavor\': \'Os aldeões envolveram o vilarejo em um silêncio mágico, porém seus ouvidos ainda sangravam.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199156&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fd73d4de-63f9-4f3f-9d4b-7fb2a15f1f18\', \'multiverseId\': 199156}, \'multiverseid\': 199156}, {\'name\': \'Воющая Баньши\', \'text\': \'Полет\\nКогда Воющая Баньши выходит на поле битвы, каждый игрок теряет 3 жизни.\', \'type\': \'Существо — Дух\', \'flavor\': \'Селяне облачили деревушку в волшебную тишину, но кровь все равно сочилась из их ушей.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200152&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d6efa162-0bf4-4f8e-9f6c-14b5869c7888\', \'multiverseId\': 200152}, \'multiverseid\': 200152}, {\'name\': \'哭号女妖\', \'text\': \'飞行\\n当哭号女妖进战场时，每位牌手失去3点生命。\', \'type\': \'生物～精怪\', \'flavor\': \'村民以法术让这小镇寂静无声，但他们的耳朵依旧会流血。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200899&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3b9c9a8f-5f67-4c25-bce6-78d9aa0ec657\', \'multiverseId\': 200899}, \'multiverseid\': 200899}]', '[{\'name\': \'Himmlische Säuberung\', \'text\': \'Schicke eine schwarze oder rote bleibende Karte deiner Wahl ins Exil.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Wir können dein Fehlverhalten deutlich erkennen. Es ist egal, dass du es nicht sehen willst." —Urien von den Lichtträgern\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199562&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'499c8b8a-703e-4211-89be-c1256c61a60a\', \'multiverseId\': 199562}, \'multiverseid\': 199562}, {\'name\': \'Purga celestial\', \'text\': \'Exilia el permanente negro o rojo objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Vemos claramente los errores en tus acciones. No importa si tú elegiste no hacerlo." —Urien de los Portadores de Luz\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200558&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'daeb49f6-c142-423c-8943-591083bc3e7d\', \'multiverseId\': 200558}, \'multiverseid\': 200558}, {\'name\': \'Épuration céleste\', \'text\': \'Exilez le permanent noir ou rouge ciblé.\', \'type\': \'Éphémère\', \'flavor\': \'« Nous voyons clairement vos erreurs. Peu importe que vous choisissiez de ne pas les percevoir. » —Urien des Illumineurs\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199313&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'eff1cb4c-fd99-401b-8a34-03975edfe3b3\', \'multiverseId\': 199313}, \'multiverseid\': 199313}, {\'name\': \'Epurazione Celeste\', \'text\': \'Esilia un permanente nero o rosso bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Vediamo chiaramente l\\\'errore delle tue abitudini. Non importa che tu abbia scelto di non vederle." —Urien dei Brandiluce\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200309&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5b475d84-969d-4b1d-90cd-2a5572b47386\', \'multiverseId\': 200309}, \'multiverseid\': 200309}, {\'name\': \'天界の粛清\', \'text\': \'黒か赤のパーマネント１つを対象とし、それを追放する。\', \'type\': \'インスタント\', \'flavor\': \'「あなたの行動は明らかに過ちです。 あなたがそう思っていなくても関係はありません。」 ――光帯びのウリエン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199811&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2aad21f5-9cf9-469f-9a4b-c9309c950162\', \'multiverseId\': 199811}, \'multiverseid\': 199811}, {\'name\': \'Expurgo Celestial\', \'text\': \'Exile a permanente alvo preta ou vermelha.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Vemos claramente todos os seus erros. Não importa que você opte por não os ver." —Urien dos Portaluz\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199064&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'78f13154-45b2-4be3-ab92-077188542296\', \'multiverseId\': 199064}, \'multiverseid\': 199064}, {\'name\': \'Небесное Очищение\', \'text\': \'Изгоните целевой черный или красный перманент.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Ошибочность твоего пути для нас очевидна. Не важно, что ты сам этого не осознаешь». — Уриен из ордена Световластителей\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200060&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'258fdb65-f2c3-4bcb-b45c-db3f115df041\', \'multiverseId\': 200060}, \'multiverseid\': 200060}, {\'name\': \'天界涤净\', \'text\': \'放逐目标黑色或红色永久物。\', \'type\': \'瞬间\', \'flavor\': \'「我们很明白你的道路出了什么错。 就算你不想这么走也是一样。」 ～光昭教团的吴廉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200807&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f4940545-7f62-41e6-b69c-4983b4f52bf6\', \'multiverseId\': 200807}, \'multiverseid\': 200807}]', '[{\'name\': \'Hornschildkröte\', \'type\': \'Kreatur — Schildkröte\', \'flavor\': \'Es ist ein Fehler zu denken, dass sich Schildkröten unter ihrem Panzer verstecken. Sie brauchen nur Zeit zum Überlegen, wie sie am besten deinen Kopf abbeißen sollen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199610&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4189520e-0390-4d1b-aa6a-7f7c95d24edd\', \'multiverseId\': 199610}, \'multiverseid\': 199610}, {\'name\': \'Tortuga astada\', \'type\': \'Criatura — Tortuga\', \'flavor\': \'Es un error creer que las tortugas se esconden en sus caparazones. Simplemente necesitan tiempo para contemplar cómo morderte mejor la cabeza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200606&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a56008ca-0e3d-4072-8ed1-bd502be1656a\', \'multiverseId\': 200606}, \'multiverseid\': 200606}, {\'name\': \'Tortue cornue\', \'type\': \'Créature : tortue terrestre\', \'flavor\': "C\'est un tort de croire que les tortues se cachent dans leur carapace. Elles prennent simplement le temps de contempler la meilleure méthode pour vous arracher la tête.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199361&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'032a9ff1-99ae-4e8a-a59b-01dd2e318de7\', \'multiverseId\': 199361}, \'multiverseid\': 199361}, {\'name\': \'Tartaruga Cornuta\', \'type\': \'Creatura — Tartaruga\', \'flavor\': \'È un errore pensare che le tartarughe si nascondono nel guscio. Hanno solo bisogno di tempo per pensare al modo migliore per staccarti la testa a morsi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200357&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2beb6630-ef78-4d3a-b467-ece3cef7d937\', \'multiverseId\': 200357}, \'multiverseid\': 200357}, {\'name\': \'角海亀\', \'type\': \'クリーチャー — 海亀\', \'flavor\': \'亀が甲羅に隠れるというのは間違いだ。 彼らは単に、お前の頭の食いちぎり方をじっくり考える時間が欲しいだけだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199859&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c67e31fd-3fc7-4f6a-af75-4c5f5f886f11\', \'multiverseId\': 199859}, \'multiverseid\': 199859}, {\'name\': \'Tartaruga Marinha com Chifres\', \'type\': \'Criatura — Tartaruga\', \'flavor\': \'Não é verdade que tartarugas se escondem em seus cascos. Elas apenas tentam ganhar tempo para considerar o melhor modo de arrancar sua cabeça.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199112&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'14039235-e213-442f-a181-3acf496ce436\', \'multiverseId\': 199112}, \'multiverseid\': 199112}, {\'name\': \'Рогатая Черепаха\', \'type\': \'Существо — Черепаха\', \'flavor\': \'Было бы неправильно сказать, что черепахи «прячутся» в панцирь. Им просто нужно время, чтобы обдумать, как лучше откусить вам голову.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200108&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'600e9735-a8a2-42c6-b6fe-3a1a60a96c5d\', \'multiverseId\': 200108}, \'multiverseid\': 200108}, {\'name\': \'角龟\', \'type\': \'生物～龟\', \'flavor\': \'不该说乌龟躲藏在壳内。 他们只是需要点时间来思索该怎样把你的头咬掉。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200855&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'200bcd23-b011-43ce-bd8b-957cc3c77f90\', \'multiverseId\': 200855}, \'multiverseid\': 200855}]', '[{\'name\': \'Hypnotisierendes Gespenst\', \'text\': \'Fliegend\\nImmer wenn das Hypnotisierende Gespenst einem Gegner Schaden zufügt, wirft dieser Spieler eine zufällig bestimmte Karte aus seiner Hand ab.\', \'type\': \'Kreatur — Specter\', \'flavor\': \'Seine Opfer kann man an den Augen erkennen — gebrochen und jeglicher Träume beraubt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199655&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1dae2faf-ba29-41dd-a9b5-5cb1fa65974b\', \'multiverseId\': 199655}, \'multiverseid\': 199655}, {\'name\': \'Espectro hipnótico\', \'text\': \'Vuela.\\nSiempre que el Espectro hipnótico haga daño a un oponente, ese jugador descarta una carta al azar.\', \'type\': \'Criatura — Espectro\', \'flavor\': \'Sus víctimas se reconocen por sus ojos: cuencos vacíos, derramando sueños perdidos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200651&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5284cc8f-dd2f-4c0a-a61c-c1295b701e02\', \'multiverseId\': 200651}, \'multiverseid\': 200651}, {\'name\': \'Spectre hypnotiseur\', \'text\': "Vol\\nÀ chaque fois que le Spectre hypnotiseur inflige des blessures à un adversaire, ce joueur se défausse au hasard d\'une carte.", \'type\': \'Créature : spectre\', \'flavor\': "On reconnaît ses victimes à leurs yeux : des globes éclatés d\'où s\'écoulent des rêves brisés.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199406&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e6b81fb2-dd79-43de-ab53-b05f983eb451\', \'multiverseId\': 199406}, \'multiverseid\': 199406}, {\'name\': \'Spettro Ipnotico\', \'text\': \'Volare\\nOgniqualvolta lo Spettro Ipnotico infligge danno a un avversario, quel giocatore scarta una carta a caso.\', \'type\': \'Creatura — Spettro\', \'flavor\': \'Le sue vittime vengono riconosciute per i loro occhi: recipienti infranti che colano sogni spezzati.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200402&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cfb8f39f-a178-4d65-9f34-0977eaf0b82e\', \'multiverseId\': 200402}, \'multiverseid\': 200402}, {\'name\': \'惑乱の死霊\', \'text\': \'飛行\\n惑乱の死霊がいずれかの対戦相手にダメージを与えるたび、そのプレイヤーはカードを１枚無作為に選んで捨てる。\', \'type\': \'クリーチャー — スペクター\', \'flavor\': \'被害者は目を見ればわかる。血走った目から叶わぬ夢を流しているからだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199904&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fe418b5b-8383-4bce-b5dd-cbd70f5c37ec\', \'multiverseId\': 199904}, \'multiverseid\': 199904}, {\'name\': \'Espectro Hipnótico\', \'text\': \'Voar\\nToda vez que Espectro Hipnótico causa dano a um oponente, aquele jogador descarta um card aleatoriamente.\', \'type\': \'Criatura — Espectro\', \'flavor\': \'Suas vítimas são conhecidas pelos olhos: navios destroçados gotejando sonhos destruídos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199157&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'50ba11e0-0b4a-44db-925a-7fc45425dc30\', \'multiverseId\': 199157}, \'multiverseid\': 199157}, {\'name\': \'Усыпляющий Призрак\', \'text\': \'Полет\\nКаждый раз, когда Усыпляющий Призрак наносит повреждения оппоненту, тот игрок сбрасывает одну случайно выбранную карту.\', \'type\': \'Существо — Призрак\', \'flavor\': \'Его жертв можно узнать по глазам — растрескавшимся сосудам, из которых сочатся разбитые мечты.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200153&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'36cdda57-84b3-40c5-b1a1-a4a89a695650\', \'multiverseId\': 200153}, \'multiverseid\': 200153}, {\'name\': \'催眠幽灵\', \'text\': \'飞行\\n每当催眠幽灵向对手造成伤害时，该牌手随机弃一张牌。\', \'type\': \'生物～幽灵\', \'flavor\': \'遭袭者的眼睛都爆裂着血丝，破碎梦想从中流泄。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200900&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'68d5996a-10ea-4e34-a633-a9ffb962f0d0\', \'multiverseId\': 200900}, \'multiverseid\': 200900}]', '[{\'name\': \'Im Zauberbuch radieren\', \'text\': \'Ein Spieler deiner Wahl legt die obersten fünf Karten seiner Bibliothek auf seinen Friedhof.\', \'type\': \'Hexerei\', \'flavor\': \'Genialität wird überbewertet, vor allem bei anderen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199631&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3f6c28eb-2895-4125-b3e5-03452b38a8e3\', \'multiverseId\': 199631}, \'multiverseid\': 199631}, {\'name\': \'Depuración del tomo\', \'text\': \'El jugador objetivo pone las primeras cinco cartas de su biblioteca en su cementerio.\', \'type\': \'Conjuro\', \'flavor\': \'La genialidad está sobreestimada, especialmente la ajena.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200627&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'10a460f0-0873-4c85-8f7f-288859e18a23\', \'multiverseId\': 200627}, \'multiverseid\': 200627}, {\'name\': \'Écurage de grimoire\', \'text\': \'Le joueur ciblé met les cinq cartes du dessus de sa bibliothèque dans son cimetière.\', \'type\': \'Rituel\', \'flavor\': "Le génie est surfait, surtout quand il s\'agit de celui de quelqu\'un d\'autre.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199382&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dd98de9d-94fa-4ce8-9f37-c3c654d2dc7d\', \'multiverseId\': 199382}, \'multiverseid\': 199382}, {\'name\': \'Ripulire Tomi\', \'text\': \'Un giocatore bersaglio mette nel suo cimitero le prime cinque carte del suo grimorio.\', \'type\': \'Stregoneria\', \'flavor\': \'Il genio è sopravvalutato, soprattutto quando è quello di qualcun altro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200378&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bffb7b17-3067-40bd-a837-fef0fa6d2db7\', \'multiverseId\': 200378}, \'multiverseid\': 200378}, {\'name\': \'秘本掃き\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーは、自分のライブラリーの一番上から５枚のカードを自分の墓地に置く。\', \'type\': \'ソーサリー\', \'flavor\': \'才覚は過大評価される。他人のならなおさらだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199880&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c78b52d3-745a-42cd-b473-deb4a8d4e27f\', \'multiverseId\': 199880}, \'multiverseid\': 199880}, {\'name\': \'Procura no Tomo\', \'text\': \'O jogador alvo coloca os cinco primeiros cards de seu grimório em seu cemitério.\', \'type\': \'Feitiço\', \'flavor\': \'O talento é sempre superestimado, principalmente quando pertence aos outros.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199133&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bb945d48-96e1-437d-8f33-648a64e574a2\', \'multiverseId\': 199133}, \'multiverseid\': 199133}, {\'name\': \'Прочесывание Тома\', \'text\': \'Целевой игрок кладет пять верхних карт своей библиотеки на свое кладбище.\', \'type\': \'Волшебство\', \'flavor\': \'Гениальность всегда преувеличивается, особенно чужая.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200129&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'80288206-f347-4214-bf70-31486e4cff83\', \'multiverseId\': 200129}, \'multiverseid\': 200129}, {\'name\': \'清理书本\', \'text\': \'目标牌手将其牌库顶的五张牌置入其坟墓场。\', \'type\': \'法术\', \'flavor\': \'天赋总被过度评价，尤其是别人的天赋。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200876&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7feedffe-77b9-4dd2-86e2-0945efa35945\', \'multiverseId\': 200876}, \'multiverseid\': 200876}]', '[{\'name\': \'Immerändernde Weite\', \'text\': \'{T}, opfere die Immerändernde Weite: Durchsuche deine Bibliothek nach einem Standardland und bringe es getappt ins Spiel. Mische danach deine Bibliothek.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199784&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d1325abd-aa05-4e3e-9448-2b667497f578\', \'multiverseId\': 199784}, \'multiverseid\': 199784}, {\'name\': \'Expansión terramórfica\', \'text\': \'{T}, sacrificar la Expansión terramórfica: Busca en tu biblioteca una carta de tierra básica y ponla en el campo de batalla girada. Luego baraja tu biblioteca.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200780&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'55d7458d-3661-46c8-b717-31195de87211\', \'multiverseId\': 200780}, \'multiverseid\': 200780}, {\'name\': \'Immensité terramorphe\', \'text\': "{T}, sacrifiez l\'Immensité terramorphe : Cherchez dans votre bibliothèque une carte de terrain de base et mettez-la sur le champ de bataille engagée. Mélangez ensuite votre bibliothèque.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199535&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5a581ae0-6564-4f84-a8d4-4f26c591844e\', \'multiverseId\': 199535}, \'multiverseid\': 199535}, {\'name\': \'Distesa Terramorfica\', \'text\': \'{T}, Sacrifica la Distesa Terramorfica: Passa in rassegna il tuo grimorio per una carta terra base e mettila sul campo di battaglia TAPpata. Poi rimescola il tuo grimorio.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200531&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b8965a62-884c-4f6b-99d0-cfad61215165\', \'multiverseId\': 200531}, \'multiverseid\': 200531}, {\'name\': \'広漠なる変幻地\', \'text\': \'{T}, 広漠なる変幻地を生け贄に捧げる：あなたのライブラリーから基本土地カードを１枚探し、それをタップ状態で戦場に出す。 その後あなたのライブラリーを切り直す。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200033&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a9fe374f-d857-49e9-af4d-329e4a3c1cc5\', \'multiverseId\': 200033}, \'multiverseid\': 200033}, {\'name\': \'Vastidão Morfoterrena\', \'text\': \'{T}, Sacrifique Vastidão Morfoterrena: Procure em seu grimório por um card de terreno básico e coloque-o virado no campo de batalha. Depois, embaralhe seu grimório.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199286&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4f1216f5-7ba5-4b04-acf0-604c2f816e41\', \'multiverseId\': 199286}, \'multiverseid\': 199286}, {\'name\': \'Просторы Преображенных Земель\', \'text\': \'{T}, пожертвуйте Просторы Преображенных Земель: найдите в вашей библиотеке карту базовой земли и положите ее на поле битвы повернутой. Затем перетасуйте вашу библиотеку.\', \'type\': \'Земля\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200282&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3e3934e7-b8e6-43ad-8b12-6f5f16eb29d7\', \'multiverseId\': 200282}, \'multiverseid\': 200282}, {\'name\': \'地塑旷野\', \'text\': \'{T}，牺牲地塑旷野：从你的牌库中搜寻一张基本地牌，并将之横置进战场。 然后将你的牌库洗牌。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=201029&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e6dc4042-3f45-4a19-ae6f-7abb58df6bcb\', \'multiverseId\': 201029}, \'multiverseid\': 201029}]', '[{\'name\': \'In Betracht ziehen\', \'text\': \'Schaue dir die obersten drei Karten deiner Bibliothek an und lege sie in beliebiger Reihenfolge zurück. Du kannst danach deine Bibliothek mischen.\\nZiehe eine Karte.\', \'type\': \'Hexerei\', \'flavor\': \'Wer sich heute vorbereitet, gewinnt morgen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199623&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9aaea234-22e2-4d76-a905-4603160c7c64\', \'multiverseId\': 199623}, \'multiverseid\': 199623}, {\'name\': \'Reflexionar\', \'text\': \'Mira las primeras tres cartas de tu biblioteca, luego regrésalas en cualquier orden. Puedes barajar tu biblioteca.\\nRoba una carta.\', \'type\': \'Conjuro\', \'flavor\': \'El mañana pertenece a aquellos que se preparan para él hoy.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200619&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3073ed67-02dc-459f-ac1e-9f86c52901e3\', \'multiverseId\': 200619}, \'multiverseid\': 200619}, {\'name\': \'Contemplation\', \'text\': "Regardez les trois cartes du dessus de votre bibliothèque, puis remettez-les dessus dans l\'ordre de votre choix. Vous pouvez mélanger votre bibliothèque.\\nPiochez une carte.", \'type\': \'Rituel\', \'flavor\': "L\'avenir appartient à ceux qui s\'y préparent la veille.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199374&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'647c3c05-a6ee-4e55-b145-7af20d3740dc\', \'multiverseId\': 199374}, \'multiverseid\': 199374}, {\'name\': \'Ponderare\', \'text\': \'Guarda le prime tre carte del tuo grimorio, poi rimettile a posto in qualsiasi ordine. Puoi rimescolare il tuo grimorio.\\nPesca una carta.\', \'type\': \'Stregoneria\', \'flavor\': \'Il domani appartiene a quelli che oggi si preparano per esso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200370&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1682ad3f-2631-44af-b800-321c3d223e25\', \'multiverseId\': 200370}, \'multiverseid\': 200370}, {\'name\': \'思案\', \'text\': \'あなたのライブラリーの一番上から３枚のカードを見る。その後、それらを望む順番で戻す。 あなたはあなたのライブラリーを切り直してもよい。\\nカードを１枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'明日という日は、今日それを迎える準備をしている者のためにある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199872&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'91d24a5e-9daa-4c77-8e42-9ef9bfba56de\', \'multiverseId\': 199872}, \'multiverseid\': 199872}, {\'name\': \'Ponderar\', \'text\': \'Olhe os três cards do topo do seu grimório, e depois coloque-os de volta em qualquer ordem. Você pode embaralhar seu grimório.\\nCompre um card.\', \'type\': \'Feitiço\', \'flavor\': \'O amanhã pertence àqueles que se preparem para ele hoje.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199125&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'90003a88-40e0-4bf2-a52d-3da8f6baeb8f\', \'multiverseId\': 199125}, \'multiverseid\': 199125}, {\'name\': \'Размышления\', \'text\': \'Посмотрите три верхние карты вашей библиотеки, затем положите их обратно в любом порядке. Вы можете перетасовать вашу библиотеку.\\nВозьмите карту.\', \'type\': \'Волшебство\', \'flavor\': \'Завтра принадлежит тем, кто готовится к нему сегодня.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200121&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3ec03cec-342f-4177-8f1e-9446b4309ca4\', \'multiverseId\': 200121}, \'multiverseid\': 200121}, {\'name\': \'沉思\', \'text\': \'检视你牌库顶的三张牌，然后将它们以任意顺序放回。 你可以将你的牌库洗牌。\\n抓一张牌。\', \'type\': \'法术\', \'flavor\': \'明日属于今天就为它作好准备的人。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200868&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ea005b35-f7da-4ff6-982f-6905b5e46526\', \'multiverseId\': 200868}, \'multiverseid\': 200868}]', '[{\'name\': \'Infernoelementar\', \'text\': \'Immer wenn das Infernoelementar eine Kreatur blockt oder von ihr geblockt wird, fügt das Infernoelementar dieser Kreatur 3 Schadenspunkte zu.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'„Wer unbefugt unser Kloster betreten will, soll das bitte mit meinem Diener besprechen." —Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199697&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9075160b-7907-43ee-a318-e67de53b2462\', \'multiverseId\': 199697}, \'multiverseid\': 199697}, {\'name\': \'Elemental infernal\', \'text\': \'Siempre que el Elemental infernal bloquee o sea bloqueado por una criatura, el Elemental infernal hace 3 puntos de daño a esa criatura.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'"Aquellos que deseen invadir nuestro monasterio, por favor hablen con mi sirviente." —Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200693&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'15b68ae8-a7ec-46b8-8ca6-81913eb29c5f\', \'multiverseId\': 200693}, \'multiverseid\': 200693}, {\'name\': \'Élémental de la fournaise\', \'text\': "À chaque fois que l\'Élémental de la fournaise bloque ou devient bloqué par une créature, l\'Élémental de la fournaise inflige 3 blessures à cette créature.", \'type\': \'Créature : élémental\', \'flavor\': \'« Pour ceux qui voudraient envahir notre monastère, veuillez vous adresser à mon serviteur. » —Chandra Nalaàr\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199448&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0b42ea48-f196-4dbb-9321-2adbc72fecf4\', \'multiverseId\': 199448}, \'multiverseid\': 199448}, {\'name\': "Elementale dell\'Inferno", \'text\': "Ogniqualvolta l\'Elementale dell\'Inferno blocca o viene bloccato da una creatura, l\'Elementale dell\'Inferno infligge 3 danni a quella creatura.", \'type\': \'Creatura — Elementale\', \'flavor\': \'"Quanti desiderano invadere il nostro monastero sono pregati di rivolgersi al mio servitore." —Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200444&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'891e5bd4-daed-4845-abba-9b9a6411fe42\', \'multiverseId\': 200444}, \'multiverseid\': 200444}, {\'name\': \'業火の精霊\', \'text\': \'業火の精霊がいずれかのクリーチャーをブロックするかいずれかのクリーチャーにブロックされた状態になるたび、業火の精霊はそのクリーチャーに３点のダメージを与える。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'「あたしの領地を侵略したいって人は、あたしのしもべと遊んでもらうわよ。」 ――チャンドラ・ナラー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199946&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f800f730-a556-45d3-8ff4-b36c3ceca538\', \'multiverseId\': 199946}, \'multiverseid\': 199946}, {\'name\': \'Elemental do Inferno\', \'text\': \'Toda vez que Elemental do Inferno bloquear ou for bloqueado por uma criatura, ele causará 3 pontos de dano a essa criatura.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'"Aqueles que desejarem invadir nosso monastério, falem com meu servo." —Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199199&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0de16131-ae7e-4da6-8ae6-51b076b305fa\', \'multiverseId\': 199199}, \'multiverseid\': 199199}, {\'name\': \'Элементаль Ада\', \'text\': \'Каждый раз, когда Элементаль Ада блокирует или становится заблокирован существом, Элементаль Ада наносит тому существу 3 повреждения.\', \'type\': \'Существо — Элементаль\', \'flavor\': \'«Тем, кто пожелает захватить наш монастырь, просьба урегулировать этот вопрос с моим слугой». — Чандра Налаар\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200195&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b2b30101-d00d-4b7a-9e69-a13b77be6d32\', \'multiverseId\': 200195}, \'multiverseid\': 200195}, {\'name\': \'炼狱元素\', \'text\': \'每当炼狱元素阻挡生物或被生物阻挡时，炼狱元素对该生物造成3点伤害。\', \'type\': \'生物～元素\', \'flavor\': \'「想袭击我们修道院的人，请找我的仆从商量商量。」 ～茜卓纳拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200942&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6076637b-c23e-4194-a1da-284989229f52\', \'multiverseId\': 200942}, \'multiverseid\': 200942}]', "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199789&type=card', 'language': 'German', 'identifiers': {'scryfallId': '3c58c187-6ebf-405a-acd8-87c83dcc59f6', 'multiverseId': 199789}, 'multiverseid': 199789}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200785&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'f6a65c41-b921-4d70-a7ee-dad1717a06b2', 'multiverseId': 200785}, 'multiverseid': 200785}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=199540&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'aaa6da50-a9cd-4083-9ca5-5de425beae4d', 'multiverseId': 199540}, 'multiverseid': 199540}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200536&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '87e3d046-6677-44fe-ac49-9e9d66296f32', 'multiverseId': 200536}, 'multiverseid': 200536}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=200038&type=card', 'language': 'Japanese', 'identifiers': {'