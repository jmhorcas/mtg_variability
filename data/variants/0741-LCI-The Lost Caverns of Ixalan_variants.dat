anguage': 'Italian', 'identifiers': {'scryfallId': '4f6bfceb-a203-4486-a943-cf9d0e0eef0f', 'multiverseId': 639714}, 'multiverseid': 639714}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639724&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'edc294c6-39e7-4121-bfb9-25e0b61fc2bb', 'multiverseId': 639724}, 'multiverseid': 639724}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639734&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a526986e-2dfd-4c08-8f57-8e6ebb6ac769', 'multiverseId': 639734}, 'multiverseid': 639734}, {'name': '沼泽', 'type': '基本地 — 沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639744&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'fe80dc8d-82fa-4844-be32-48040f556f4d', 'multiverseId': 639744}, 'multiverseid': 639744}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639685&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'bcf6ab11-4c91-4547-ba88-3829f633f2ae', 'multiverseId': 639685}, 'multiverseid': 639685}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639695&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '974c8892-9d57-427e-a67b-a465bb560cc0', 'multiverseId': 639695}, 'multiverseid': 639695}, {'name': 'Marais', 'type': 'Terrain de base — marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639705&type=card', 'language': 'French', 'identifiers': {'scryfallId': '1c759fb2-8920-4fac-8969-f0fc7ad2b3ab', 'multiverseId': 639705}, 'multiverseid': 639705}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639715&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b43e3e8e-9045-414a-bd5d-896dc532d330', 'multiverseId': 639715}, 'multiverseid': 639715}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639725&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '6351a854-93a8-4d07-80d0-69bb293649f7', 'multiverseId': 639725}, 'multiverseid': 639725}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639735&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e9045991-a7a8-4fa2-a33b-c99d3e21e90d', 'multiverseId': 639735}, 'multiverseid': 639735}, {'name': '沼泽', 'type': '基本地 — 沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639745&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '31f2ee20-b00b-4516-b2fc-20a38ccc0011', 'multiverseId': 639745}, 'multiverseid': 639745}]", '[{\'name\': \'Synapsen-Nekromagier\', \'text\': \'Wenn der Synapsen-Nekromagier stirbt, erzeuge zwei 1/1 schwarze Pilzwesen-Kreaturenspielsteine mit „Diese Kreatur kann nicht blocken."\', \'type\': \'Kreatur — Pilzwesen, Zauberer\', \'flavor\': \'„Es bring nichts, sie umzubringen? Was sollen wir sonst tun? Sie mit einer Einladung zum Tee ablenken?"\\n—Mervin, Schürfer der Tollkühnen Koalition\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637151&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'aa3751af-f76e-4374-973e-2215436d3c7c\', \'multiverseId\': 637151}, \'multiverseid\': 637151}, {\'name\': \'Nigromagos sinápticos\', \'text\': \'Cuando los Nigromagos sinápticos mueran, crea dos fichas de criatura Hongo negras 1/1 con "Esta criatura no puede bloquear".\', \'type\': \'Criatura — Hechicero hongo\', \'flavor\': \'"¿Que matarlos no sirve de nada? ¿Y entonces qué hacemos? ¿Les servimos una infusión?".\\n—Mervin, prospector de la Coalición Azófar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637472&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'baa342be-ebef-4117-ae38-b2bb718339cd\', \'multiverseId\': 637472}, \'multiverseid\': 637472}, {\'name\': \'Nécromage de synapse\', \'text\': \'Quand le Nécromage de synapse meurt, créez deux jetons de créature 1/1 noire Fongus avec « Cette créature ne peut pas bloquer. »\', \'type\': \'Créature — fongus et sorcier\', \'flavor\': \'« Ça ne sert à rien de les tuer ? On fait quoi alors ? On les distrait en les invitant à prendre le thé ? »\\n—Mervin, prospecteur de la Coalition des hardis\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637793&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'111bc032-921a-4cc2-86fa-46d16d47ea07\', \'multiverseId\': 637793}, \'multiverseid\': 637793}, {\'name\': \'Necromago Sinaptico\', \'text\': \'Quando il Necromago Sinaptico muore, crea due pedine creatura Fungus 1/1 nere con "Questa creatura non può bloccare".\', \'type\': \'Creatura — Mago Fungus\', \'flavor\': \'"Ucciderli non serve a niente? Allora cosa dovremmo fare, distrarli con tè e biscotti?"\\n—Mervin, prospettore dell\\\'Alleanza di Bronzo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638114&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fb2ecd21-f2ae-44fe-be9c-96c35e1a1eca\', \'multiverseId\': 638114}, \'multiverseid\': 638114}, {\'name\': \'末梢の屍道士\', \'text\': \'末梢の屍道士が死亡したとき、「このクリーチャーではブロックできない。」を持つ黒の１/１のファンガス・クリーチャー・トークン２体を生成する。\', \'type\': \'クリーチャー — ファンガス・ウィザード\', \'flavor\': \'「殺しても無駄だって？じゃあどうするんだ？お茶会でも開いて気を逸らすか？」\\n――鉄面連合の探鉱者、メルヴィン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638435&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a4634b14-3962-48c0-aa67-e6bd609228e6\', \'multiverseId\': 638435}, \'multiverseid\': 638435}, {\'name\': \'Necromagos da Sinapse\', \'text\': \'Quando Necromagos da Sinapse morrer, crie duas fichas de criatura Fungo preta 1/1 com "Esta criatura não pode bloquear".\', \'type\': \'Criatura — Fungo Mago\', \'flavor\': \'"Não adianta matar? Então a gente faz o quê? Faz um chazinho pra eles?"\\n— Mervin, prospector da Coalizão Brônzea\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638756&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dd4e4bd3-b6d6-4194-b5c1-3ec7f6fe0d1b\', \'multiverseId\': 638756}, \'multiverseid\': 638756}, {\'name\': \'突蕈死灵法师\', \'text\': \'当突蕈死灵法师死去时，派出两个1/1黑色真菌衍生生物，且具有「此生物不能进行阻挡。」\', \'type\': \'生物 — 真菌／法术师\', \'flavor\': \'「杀死他们没有用？那我们能怎么办？开茶会引开他们？」\\n～莽霸联盟勘探员莫文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639077&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'45264fe0-1d99-4e2f-a304-d5410b4eafc4\', \'multiverseId\': 639077}, \'multiverseid\': 639077}]', '[{\'name\': \'Tarrians Aufzeichnungen // Das Grab des Aclazotz\', \'text\': \'(Transformierte Tarrians Aufzeichnungen.)\\n{T}: Erzeuge {B}.\\n{T}: Du kannst in diesem Zug einen Kreaturenzauber aus deinem Friedhof wirken. Falls du dies tust, kommt er mit einer Endgültigkeitsmarke ins Spiel und er ist zusätzlich zu seinen anderen Typen ein Vampir. (Falls eine Kreatur mit Endgültigkeitsmarke sterben würde, schicke sie stattdessen ins Exil.)\', \'type\': \'Legendäres Land — Höhle\', \'flavor\': None, \'faceName\': \'Das Grab des Aclazotz\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637152&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'79a16a1f-02ef-428a-865a-65e68a5c7266\', \'multiverseId\': 637152}, \'multiverseid\': 637152}, {\'name\': \'Diario de Tarrian // La tumba de Aclazotz\', \'text\': \'(Se transforma del Diario de Tarrian.)\\n{T}: Agrega {B}.\\n{T}: Puedes lanzar un hechizo de criatura desde tu cementerio este turno. Si lo haces, entra al campo de batalla con un contador de consumación sobre él y es un Vampiro además de sus otros tipos. (Si una criatura con un contador de consumación sobre ella fuera a morir, en vez de eso, exíliala.)\', \'type\': \'Tierra legendaria — Cueva\', \'flavor\': None, \'faceName\': \'La tumba de Aclazotz\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637473&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'421ea320-c215-4ee9-9eb1-ab8b551a8173\', \'multiverseId\': 637473}, \'multiverseid\': 637473}, {\'name\': "Journal de Tarrian // La Tombe d\'Aclazotz", \'text\': \'(Transformation du Journal de Tarrian.)\\n{T} : Ajoutez {B}.\\n{T} : Vous pouvez lancer un sort de créature depuis votre cimetière ce tour-ci. Si vous faites ainsi, il arrive sur le champ de bataille avec un marqueur « fatalité » sur lui et est un vampire en plus de ses autres types. (Si une créature avec un marqueur « fatalité » sur elle devait mourir, exilez-la à la place.)\', \'type\': \'Terrain légendaire — caverne\', \'flavor\': None, \'faceName\': "La Tombe d\'Aclazotz", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637794&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'789d1366-24f8-4e63-9589-130e7b390541\', \'multiverseId\': 637794}, \'multiverseid\': 637794}, {\'name\': \'Diario di Tarrian // La Tomba di Aclazotz\', \'text\': \'(Si trasforma dal Diario di Tarrian.)\\n{T}: Aggiungi {B}.\\n{T}: Puoi lanciare una magia creatura dal tuo cimitero in questo turno. Se lo fai, entra nel campo di battaglia con un segnalino finale ed è un Vampiro in aggiunta ai suoi altri tipi. (Se una creatura con un segnalino finale sta per morire, invece esiliala.)\', \'type\': \'Terra Leggendaria — Caverna\', \'flavor\': None, \'faceName\': \'La Tomba di Aclazotz\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638115&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0b029efe-189e-4e2f-88d5-4c992cfa6b16\', \'multiverseId\': 638115}, \'multiverseid\': 638115}, {\'name\': \'タリアンの日誌 // アクロゾズの墓所\', \'text\': \'（タリアンの日誌から変身する。）\\n{T}：{B}を加える。\\n{T}：このターン、あなたの墓地からクリーチャー・呪文１つを唱えてもよい。そうしたなら、それは他のタイプに加えて吸血鬼であり、最終カウンター１個が置かれた状態で戦場に出る。（最終カウンターが置かれているクリーチャーが死亡するなら、代わりにそれを追放する。）\', \'type\': \'伝説の土地 — 洞窟\', \'flavor\': None, \'faceName\': \'アクロゾズの墓所\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638436&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d8467297-6edd-419f-8ae1-7b832a9ce6a6\', \'multiverseId\': 638436}, \'multiverseid\': 638436}, {\'name\': \'Diário de Tarrian // A Tumba de Aclazotz\', \'text\': \'(Transformação de Diário de Tarrian.)\\n{T}: Adicione {B}.\\n{T}: Você pode conjurar uma mágica de criatura do seu cemitério neste turno. Se fizer isso, ela entrará no campo de batalha com um marcador de finalidade e será um Vampiro além de seus outros tipos. (Se uma criatura com marcador de finalidade morreria, em vez disso, exile-a.)\', \'type\': \'Terreno Lendário — Caverna\', \'flavor\': None, \'faceName\': \'A Tumba de Aclazotz\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638757&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'15bb2cd9-32f0-4791-bd0d-a23d7c5b14c9\', \'multiverseId\': 638757}, \'multiverseid\': 638757}, {\'name\': \'塔理安的日志 // 阿洛佐兹之墓\', \'text\': \'（由塔理安的日志转化。）\\n{T}：加{B}。\\n{T}：本回合中，你可以从你坟墓场中施放一个生物咒语。若你如此作，则它进战场时上面有一个终命指示物，且额外具有吸血鬼此类别。（如果其上有终命指示物的生物将死去，则改为放逐之。）\', \'type\': \'传奇地 — 洞窟\', \'flavor\': None, \'faceName\': \'阿洛佐兹之墓\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639078&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5a81314c-140f-41a4-9716-5b58f5d808b4\', \'multiverseId\': 639078}, \'multiverseid\': 639078}]', '[{\'name\': \'Tarrians Aufzeichnungen // Das Grab des Aclazotz\', \'text\': \'{T}, opfere ein anderes Artefakt oder eine andere Kreatur: Ziehe eine Karte. Aktiviere diese Fähigkeit wie eine Hexerei.\\n{2}, {T}, wirf deine Hand ab: Transformiere Tarrians Aufzeichnungen.\', \'type\': \'Legendäres Artefakt\', \'flavor\': \'Obwohl er offiziell wegen seiner Aclazotz verehrenden Schriften als Ketzer gilt, sehen die radikalsten Sekten der Kirche des Zwielichts Tarrian als einen heiligen Märtyrer.\', \'faceName\': \'Tarrians Aufzeichnungen\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637152&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'79a16a1f-02ef-428a-865a-65e68a5c7266\', \'multiverseId\': 637152}, \'multiverseid\': 637152}, {\'name\': \'Diario de Tarrian // La tumba de Aclazotz\', \'text\': \'{T}, sacrificar otro artefacto o criatura: Roba una carta. Activa esto solo como un conjuro.\\n{2}, {T}, descartar tu mano: Transforma el Diario de Tarrian.\', \'type\': \'Artefacto legendario\', \'flavor\': \'Aunque oficialmente se tildó a Tarrian de hereje por sus escritos de veneración hacia Aclazotz, las sectas más radicales de la Iglesia del Crepúsculo lo consideran un mártir sagrado.\', \'faceName\': \'Diario de Tarrian\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637473&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'421ea320-c215-4ee9-9eb1-ab8b551a8173\', \'multiverseId\': 637473}, \'multiverseid\': 637473}, {\'name\': "Journal de Tarrian // La Tombe d\'Aclazotz", \'text\': "{T}, sacrifiez un autre artefact ou une autre créature : Piochez une carte. N\'activez que lorsque vous pourriez lancer un rituel.\\n{2}, {T}, défaussez-vous de votre main : Transformez le Journal de Tarrian.", \'type\': \'Artefact légendaire\', \'flavor\': "Bien qu\'officiellement considéré comme un hérétique à cause de ses écrits révérencieux sur Aclazotz, Tarrian est vu comme un saint martyr par les sectes les plus radicales de l\'Église du crépuscule.", \'faceName\': \'Journal de Tarrian\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637794&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'789d1366-24f8-4e63-9589-130e7b390541\', \'multiverseId\': 637794}, \'multiverseid\': 637794}, {\'name\': \'Diario di Tarrian // La Tomba di Aclazotz\', \'text\': \'{T}, Sacrifica un altro artefatto o creatura: Pesca una carta. Attiva solo come una stregoneria.\\n{2}, {T}, Scarta la tua mano: Trasforma il Diario di Tarrian.\', \'type\': \'Artefatto Leggendario\', \'flavor\': \'Seppur giudicato ufficialmente un eretico per le sue scritture in venerazione di Aclazotz, Tarrian è visto come un martire sacro dalle sette più radicali della Chiesa del Vespro.\', \'faceName\': \'Diario di Tarrian\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638115&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0b029efe-189e-4e2f-88d5-4c992cfa6b16\', \'multiverseId\': 638115}, \'multiverseid\': 638115}, {\'name\': \'タリアンの日誌 // アクロゾズの墓所\', \'text\': \'{T}, アーティファクトやクリーチャーでありこれでない１つを生け贄に捧げる：カード１枚を引く。起動はソーサリーとしてのみ行う。\\n{2}, {T}, あなたの手札を捨てる：タリアンの日誌を変身させる。\', \'type\': \'伝説のアーティファクト\', \'flavor\': \'アクロゾズを敬う文を書いたとして異端者に認定されているタリアンであるが、薄暮教会の超急進派からは殉教者とみなされている。\', \'faceName\': \'タリアンの日誌\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638436&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d8467297-6edd-419f-8ae1-7b832a9ce6a6\', \'multiverseId\': 638436}, \'multiverseid\': 638436}, {\'name\': \'Diário de Tarrian // A Tumba de Aclazotz\', \'text\': \'{T}, sacrifique outro artefato ou outra criatura: Compre um card. Ative somente como um feitiço.\\n{2}, {T}, descarte sua mão: Transforme Diário de Tarrian.\', \'type\': \'Artefato Lendário\', \'flavor\': \'Embora oficialmente considerado herege por seus escritos reverentes sobre Aclazotz, Tarrian é visto como um santo mártir pelas seitas mais radicais da Igreja do Crepúsculo.\', \'faceName\': \'Diário de Tarrian\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638757&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'15bb2cd9-32f0-4791-bd0d-a23d7c5b14c9\', \'multiverseId\': 638757}, \'multiverseid\': 638757}, {\'name\': \'塔理安的日志 // 阿洛佐兹之墓\', \'text\': \'{T}，牺牲另一个神器或生物：抓一张牌。只能于法术时机起动。\\n{2}，{T}，弃掉你的手牌：转化塔理安的日志。\', \'type\': \'传奇神器\', \'flavor\': \'虽然塔理安因在文字中流露出对阿洛佐兹的崇敬之情而被定为异端，但在暮影教会最为极端的派别眼中，他与殉道圣士无异。\', \'faceName\': \'塔理安的日志\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639078&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5a81314c-140f-41a4-9716-5b58f5d808b4\', \'multiverseId\': 639078}, \'multiverseid\': 639078}]', '[{\'name\': \'Tarrians Seelenspalter\', \'text\': \'Die ausgerüstete Kreatur hat Wachsamkeit.\\nImmer wenn ein anderes Artefakt oder eine andere Kreatur aus dem Spiel auf einen Friedhof gelegt wird, lege eine +1/+1-Marke auf die ausgerüstete Kreatur.\\nAusrüsten {2}\', \'type\': \'Legendäres Artefakt — Ausrüstung\', \'flavor\': \'Tarrians heilige Waffe birgt immer noch ein Bruchstück seiner dunklen Macht … und seines Hungers.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637308&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'559e6c25-39fa-4914-b814-0779e0f24ac3\', \'multiverseId\': 637308}, \'multiverseid\': 637308}, {\'name\': \'Hendealmas de Tarrian\', \'text\': \'La criatura equipada tiene la habilidad de vigilancia.\\nSiempre que otro artefacto o criatura vaya a un cementerio desde el campo de batalla, pon un contador +1/+1 sobre la criatura equipada.\\nEquipar {2}.\', \'type\': \'Artefacto legendario — Equipo\', \'flavor\': \'El arma sagrada de Tarrian todavía conserva un fragmento de su poder oscuro... y de su hambre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637629&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f14ee3c8-d52c-4c71-afa6-684e6acceca7\', \'multiverseId\': 637629}, \'multiverseid\': 637629}, {\'name\': "Hachoir d\'âmes de Tarrian", \'text\': "La créature équipée a la vigilance.\\nÀ chaque fois qu\'un autre artefact ou qu\'une autre créature est mise dans un cimetière depuis le champ de bataille, mettez un marqueur +1/+1 sur la créature équipée.\\nÉquipement {2}", \'type\': \'Artefact légendaire — équipement\', \'flavor\': "L\'arme sacrée de Tarrian contient encore un fragment de sa sombre puissance... et sa faim.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637950&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'200ab5c2-64be-48cf-8dd9-e2456df7a8bd\', \'multiverseId\': 637950}, \'multiverseid\': 637950}, {\'name\': \'Fendianima di Tarrian\', \'text\': "La creatura equipaggiata ha cautela.\\nOgniqualvolta un altro artefatto o un\'altra creatura vengono messi in un cimitero dal campo di battaglia, metti un segnalino +1/+1 sulla creatura equipaggiata.\\nEquipaggiare {2}", \'type\': \'Artefatto Leggendario — Equipaggiamento\', \'flavor\': "L\'arma sacra di Tarrian contiene ancora un frammento del suo oscuro potere... e della sua brama.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638271&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a48b6916-03b0-4445-ab6c-c0b4a71e9e74\', \'multiverseId\': 638271}, \'multiverseid\': 638271}, {\'name\': \'タリアンの魂断ち\', \'text\': \'装備しているクリーチャーは警戒を持つ。\\nアーティファクトやクリーチャーでありこれでない１つが戦場から墓地に置かれるたび、装備しているクリーチャーの上に＋１/＋１カウンター１個を置く。\\n装備{2}\', \'type\': \'伝説のアーティファクト — 装備品\', \'flavor\': \'タリアンの聖なる武器は、未だ彼の闇の力の片鱗を秘めている……そして彼の飢えまでも。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638592&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8e56ee51-fafd-4357-b3f1-853ab3a79e42\', \'multiverseId\': 638592}, \'multiverseid\': 638592}, {\'name\': \'Laminalma de Tarrian\', \'text\': \'A criatura equipada tem vigilância.\\nToda vez que outro artefato ou outra criatura for colocado em um cemitério vindo do campo de batalha, coloque um marcador +1/+1 na criatura equipada.\\nEquipar {2}\', \'type\': \'Artefato Lendário — Equipamento\', \'flavor\': \'A arma sagrada de Tarrian ainda conserva um fragmento de seu poder sombrio... e de sua fome.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638913&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7c1bbde8-5884-4f09-b7a5-8439564fc2da\', \'multiverseId\': 638913}, \'multiverseid\': 638913}, {\'name\': \'塔理安的裂魂戟\', \'text\': \'佩带此武具的生物具有警戒异能。\\n每当另一个神器或生物从战场进入坟墓场时，在佩带此武具的生物上放置一个+1/+1指示物。\\n佩带{2}\', \'type\': \'传奇神器 — 武具\', \'flavor\': \'塔理安的圣兵上仍留有一丝他的黑暗力量…以及他的饥渴。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639234&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f7cc913e-5ea1-4e5e-89fb-3fbe96c7c26e\', \'multiverseId\': 639234}, \'multiverseid\': 639234}]', '[{\'name\': \'Tarrians Seelenspalter\', \'text\': \'Die ausgerüstete Kreatur hat Wachsamkeit.\\nImmer wenn ein anderes Artefakt oder eine andere Kreatur aus dem Spiel auf einen Friedhof gelegt wird, lege eine +1/+1-Marke auf die ausgerüstete Kreatur.\\nAusrüsten {2}\', \'type\': \'Legendäres Artefakt — Ausrüstung\', \'flavor\': \'Tarrians heilige Waffe birgt immer noch ein Bruchstück seiner dunklen Macht … und seines Hungers.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639847&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'23e6d369-882c-4aae-969a-3bf7f153dd33\', \'multiverseId\': 639847}, \'multiverseid\': 639847}, {\'name\': "Hachoir d\'âmes de Tarrian", \'text\': "La créature équipée a la vigilance.\\nÀ chaque fois qu\'un autre artefact ou qu\'une autre créature est mise dans un cimetière depuis le champ de bataille, mettez un marqueur +1/+1 sur la créature équipée.\\nÉquipement {2}", \'type\': \'Artefact légendaire — équipement\', \'flavor\': "L\'arme sacrée de Tarrian contient encore un fragment de sa sombre puissance... et sa faim.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639898&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3b31f86e-6414-41f8-8f6e-b914c24c5bd1\', \'multiverseId\': 639898}, \'multiverseid\': 639898}, {\'name\': \'タリアンの魂断ち\', \'text\': \'装備しているクリーチャーは警戒を持つ。\\nアーティファクトやクリーチャーでありこれでない１つが戦場から墓地に置かれるたび、装備しているクリーチャーの上に＋１/＋１カウンター１個を置く。\\n装備{2}\', \'type\': \'伝説のアーティファクト — 装備品\', \'flavor\': \'タリアンの聖なる武器は、未だ彼の闇の力の片鱗を秘めている……そして彼の飢えまでも。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639949&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1f570924-793f-48fc-8219-8c3bbb8ce5e2\', \'multiverseId\': 639949}, \'multiverseid\': 639949}, {\'name\': \'塔理安的裂魂戟\', \'text\': \'佩带此武具的生物具有警戒异能。\\n每当另一个神器或生物从战场进入坟墓场时，在佩带此武具的生物上放置一个+1/+1指示物。\\n佩带{2}\', \'type\': \'传奇神器 — 武具\', \'flavor\': \'塔理安的圣兵上仍留有一丝他的黑暗力量…以及他的饥渴。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=640000&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'01f9151b-fbeb-4590-8159-d5a36468641b\', \'multiverseId\': 640000}, \'multiverseid\': 640000}]', "[{'name': 'Tasche der Bastlerin', 'text': 'Wenn die Tasche der Bastlerin ins Spiel kommt, erzeuge zwei 1/1 farblose Gnom-Artefaktkreaturenspielsteine.\\n{W}, opfere die Tasche der Bastlerin: Du erhältst 3 Lebenspunkte dazu.', 'type': 'Artefakt', 'flavor': 'Nur mit Gnom bist du autonom.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637056&type=card', 'language': 'German', 'identifiers': {'scryfallId': '35b40fa8-1946-49aa-a555-5c7278b1e556', 'multiverseId': 637056}, 'multiverseid': 637056}, {'name': 'Macuto de chatarrera', 'text': 'Cuando el Macuto de chatarrera entre al campo de batalla, crea dos fichas de criatura artefacto Gnomo incoloras 1/1.\\n{W}, sacrificar el Macuto de chatarrera: Ganas 3 vidas.', 'type': 'Artefacto', 'flavor': 'Sin un gnomo, no salgas de casa ni por asomo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637377&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ab9ca8a0-2eb8-4856-b4c0-6d6225c059eb', 'multiverseId': 637377}, 'multiverseid': 637377}, {'name': 'Fourre-tout de bricoleur', 'text': 'Quand le Fourre-tout de bricoleur arrive sur le champ de bataille, créez deux jetons de créature-artefact 1/1 incolore Gnome.\\n{W}, sacrifiez le Fourre-tout de bricoleur : Vous gagnez 3 points de vie.', 'type': 'Artefact', 'flavor': 'Ne partez jamais sans gnome.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637698&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c4ed187c-d312-4ab1-a328-17b4ff092903', 'multiverseId': 637698}, 'multiverseid': 637698}, {'name': 'Sacca della Riparatrice', 'text': 'Quando la Sacca della Riparatrice entra nel campo di battaglia, crea due pedine creatura artefatto Gnomo 1/1 incolori.\\n{W}, Sacrifica la Sacca della Riparatrice: Guadagni 3 punti vita.', 'type': 'Artefatto', 'flavor': 'Mai uscire di casa senza uno gnomo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638019&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'be5f6e38-d18d-4845-a7e6-d2477547b020', 'multiverseId': 638019}, 'multiverseid': 638019}, {'name': '修繕士の手持ち鞄', 'text': '修繕士の手持ち鞄が戦場に出たとき、無色の１/１のノーム・アーティファクト・クリーチャー・トークン２体を生成する。\\n{W}, 修繕士の手持ち鞄を生け贄に捧げる：あなたは３点のライフを得る。', 'type': 'アーティファクト', 'flavor': 'お出かけの際はノームをお忘れなく。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638340&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9d152f2c-8e57-4d40-b191-994d6935316a', 'multiverseId': 638340}, 'multiverseid': 638340}, {'name': 'Bolsa do Latoeiro', 'text': 'Quando Bolsa do Latoeiro entrar no campo de batalha, crie duas fichas de criatura artefato Gnomo incolor 1/1.\\n{W}, sacrifique Bolsa do Latoeiro: Você ganha 3 pontos de vida.', 'type': 'Artefato', 'flavor': 'Jamais saia de casa sem um gnomo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638661&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b3c48527-b70b-4da3-a9bd-081c01c99122', 'multiverseId': 638661}, 'multiverseid': 638661}, {'name': '修补匠背袋', 'text': '当修补匠背袋进战场时，派出两个1/1无色地侏衍生神器生物。\\n{W}，牺牲修补匠背袋：你获得3点生命。', 'type': '神器', 'flavor': '出门在外，侏械必带。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638982&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '8b75eb5b-23d9-4b04-9e6e-dc7870c8a176', 'multiverseId': 638982}, 'multiverseid': 638982}]", '[{\'name\': \'Tektonische Gefahr\', \'text\': \'Die Tektonische Gefahr fügt jedem Gegner und jeder Kreatur, die er kontrolliert, 1 Schadenspunkt zu.\', \'type\': \'Hexerei\', \'flavor\': \'„Der Boden brennt, von der Decke baumeln Speere und ich glaube, eines dieser Pilzwesen wollte mich verfluchen. Und du sagst: ‚Keine Panik\\\'?!"\\n—Jino Grag, Späher der Tollkühnen Koalition\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637204&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'82ae59c6-63ac-4403-bdfb-f116afb16c8b\', \'multiverseId\': 637204}, \'multiverseid\': 637204}, {\'name\': \'Peligro tectónico\', \'text\': \'El Peligro tectónico hace 1 punto de daño a cada oponente y a cada criatura que controlan tus oponentes.\', \'type\': \'Conjuro\', \'flavor\': \'"El suelo está en llamas, el techo está hecho de lanzas y creo que un hongo trató de maldecirme. ¡No me digas que me tranquilice!".\\n—Jino Grag, explorador de la Coalición Azófar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637525&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6cc4988b-ddf2-4047-898d-e0947d3564f3\', \'multiverseId\': 637525}, \'multiverseid\': 637525}, {\'name\': \'Danger tectonique\', \'text\': "Le Danger tectonique inflige 1 blessure à chaque adversaire et à chaque créature qu\'il contrôle.", \'type\': \'Rituel\', \'flavor\': "« Le sol est en feu, le plafond est tapissé de lances, et je crois qu\'un champignon vient d\'essayer de me maudire. Ne me dites pas de ne pas paniquer ! »\\n—Jino Grag, éclaireur de la Coalition des hardis", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637846&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'aac1f199-bf87-407e-ac48-10b22f2dde20\', \'multiverseId\': 637846}, \'multiverseid\': 637846}, {\'name\': \'Insidia Tettonica\', \'text\': "L\'Insidia Tettonica infligge 1 danno a ogni avversario e a ogni creatura che controlla.", \'type\': \'Stregoneria\', \'flavor\': \'"Il terreno è in fiamme, il soffitto è fatto di spuntoni e credo che un fungo abbia cercato di maledirmi. E secondo voi non devo agitarmi?!"\\n—Jino Grag, esploratore dell\\\'Alleanza di Bronzo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638167&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fe84eb44-65b8-48d4-b9c6-2fa0eb7989da\', \'multiverseId\': 638167}, \'multiverseid\': 638167}, {\'name\': \'地盤の危険\', \'text\': \'地盤の危険は各対戦相手と対戦相手がコントロールしている各クリーチャーにそれぞれ１点のダメージを与える。\', \'type\': \'ソーサリー\', \'flavor\': \'「地面は火の海で、天井は槍が連なっている。おまけにキノコが今にも襲ってきそうだ。こんな状態で落ち着いていられるものか！」\\n――鉄面連合の斥候、ジーノ・グラッグ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638488&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0857e95d-c6da-44a3-a525-140b8d14142b\', \'multiverseId\': 638488}, \'multiverseid\': 638488}, {\'name\': \'Risco Tectônico\', \'text\': \'Risco Tectônico causa 1 ponto de dano a cada oponente e a cada criatura que ele controla.\', \'type\': \'Feitiço\', \'flavor\': \'"O chão tá pegando fogo, o teto tá cheio de lanças e eu acho que um cogumelo tentou me amaldiçoar. Não vem me dizer pra não entrar em pânico!"\\n— Jino Grag, batedor da Coalizão Brônzea\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638809&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dc395143-e50e-43eb-aa7f-a04e414e2422\', \'multiverseId\': 638809}, \'multiverseid\': 638809}, {\'name\': \'地壳灾害\', \'text\': \'地壳灾害向每位对手和每个由对手操控的生物各造成1点伤害。\', \'type\': \'法术\', \'flavor\': \'「地上着火，天上下矛，还有个蘑菇想要诅咒我。你让我怎么不慌张？」\\n～莽霸联盟斥候基诺格拉格\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639130&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cb8b9875-dd25-4b03-80f7-12c7c8ec8145\', \'multiverseId\': 639130}, \'multiverseid\': 639130}]', "[{'name': 'Thron der Grausamen Kapitänin // Die Grausame Kapitänin', 'text': 'Bedrohlich, verursacht Trampelschaden, Lebensverknüpfung, Fluchsicher\\nImmer wenn Die Grausame Kapitänin angreift, opfert jeder Gegner ein Nichtland-Permanent. Dann kannst du eine Kreaturenkarte, die ins Exil geschickt wurde, um Die Grausame Kapitänin anzufertigen, getappt und angreifend unter deiner Kontrolle ins Spiel bringen.', 'type': 'Legendäre Kreatur — Skelett, Geist, Pirat', 'flavor': None, 'faceName': 'Die Grausame Kapitänin', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636545&type=card', 'language': 'German', 'identifiers': {'scryfallId': '12eaf583-d46a-4445-81db-b1e4ed3f6a0f', 'multiverseId': 636545}, 'multiverseid': 636545}, {'name': 'Trono de la capitana siniestra // La capitana siniestra', 'text': 'Amenaza, arrolla, vínculo vital, antimaleficio.\\nSiempre que La capitana siniestra ataque, cada oponente sacrifica un permanente que no sea tierra. Luego, puedes poner en el campo de batalla girada y atacando bajo tu control una carta de criatura exiliada usada para elaborar a La capitana siniestra.', 'type': 'Criatura legendaria — Pirata espíritu esqueleto', 'flavor': None, 'faceName': 'La capitana siniestra', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636569&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '731de72e-3549-4265-80eb-25232fb047be', 'multiverseId': 636569}, 'multiverseid': 636569}, {'name': 'Trône de la Capitaine sinistre // La Capitaine sinistre', 'text': 'Menace, piétinement, lien de vie, défense talismanique\\nÀ chaque fois que la Capitaine sinistre attaque, chaque adversaire sacrifie un permanent non-terrain. Puis vous pouvez mettre une carte de créature exilée utilisée pour façonner La Capitaine sinistre sur le champ de bataille, sous votre contrôle, engagée et attaquante.', 'type': 'Créature légendaire — squelette et esprit et pirate', 'flavor': None, 'faceName': 'La Capitaine sinistre', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636593&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a0c36ca8-085f-47e0-b7be-6df3bec5f1bd', 'multiverseId': 636593}, 'multiverseid': 636593}, {'name': 'Trono della Capitana Lugubre // La Capitana Lugubre', 'text': 'Minacciare, travolgere, legame vitale, anti-malocchio\\nOgniqualvolta La Capitana Lugubre attacca, ogni avversario sacrifica un permanente non terra. Poi puoi mettere sul campo di battaglia sotto il tuo controllo TAPpata e attaccante una carta creatura esiliata usata per costruire La Capitana Lugubre.', 'type': 'Creatura Leggendaria — Pirata Spirito Scheletro', 'flavor': None, 'faceName': 'La Capitana Lugubre', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636617&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '1cec2c0d-3d1b-4501-bbe5-b47feba4d47e', 'multiverseId': 636617}, 'multiverseid': 636617}, {'name': '不気味な船長の玉座 // 不気味な船長', 'text': '威迫、トランプル、絆魂、呪禁\\n不気味な船長が攻撃するたび、各対戦相手はそれぞれ土地でないパーマネント１つを生け贄に捧げる。その後、あなたは「不気味な船長を作製するために追放されているクリーチャー・カード１枚をあなたのコントロール下でタップ状態かつ攻撃している状態で戦場に出す。」を選んでもよい。', 'type': '伝説のクリーチャー — スケルトン・スピリット・海賊', 'flavor': None, 'faceName': '不気味な船長', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636641&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'a38a7731-cfa9-43b4-8fb6-2227d231de7d', 'multiverseId': 636641}, 'multiverseid': 636641}, {'name': 'Trono da Capitã Sinistra // A Capitã Sinistra', 'text': 'Ameaçar, atropelar, vínculo com a vida, resistência a magia\\nToda vez que A Capitã Sinistra ataca, cada oponente sacrifica uma permanente não de terreno. Depois, você pode colocar um card de criatura exilado usado para construir A Capitã Sinistra no campo de batalha sob seu controle virado e atacando.', 'type': 'Criatura Lendária — Esqueleto Espírito Pirata', 'flavor': None, 'faceName': 'A Capitã Sinistra', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636665&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8be166c4-5a76-4d69-a320-830683dd6caa', 'multiverseId': 636665}, 'multiverseid': 636665}, {'name': '司命王座 // 司命', 'text': '威慑，践踏，系命，辟邪\\n每当司命攻击时，每位对手各牺牲一个非地永久物。然后你可以将一张用以化炼司命所放逐之生物牌在你操控下放进战场，其为横置且正进行攻击。', 'type': '传奇生物 — 骷髅妖／精怪／海盗', 'flavor': None, 'faceName': '司命', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636689&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '061b21bc-018d-457e-8c66-8c01a2548488', 'multiverseId': 636689}, 'multiverseid': 636689}]", "[{'name': 'Thron der Grausamen Kapitänin // Die Grausame Kapitänin', 'text': '{T}: Du millst zwei Karten.\\nAnfertigung mit einem Dinosaurier, einem Meervolk, einem Piraten und einem Vampir {4}', 'type': 'Legendäres Artefakt', 'flavor': None, 'faceName': 'Thron der Grausamen Kapitänin', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636545&type=card', 'language': 'German', 'identifiers': {'scryfallId': '12eaf583-d46a-4445-81db-b1e4ed3f6a0f', 'multiverseId': 636545}, 'multiverseid': 636545}, {'name': 'Trono de la capitana siniestra // La capitana siniestra', 'text': '{T}: Muele dos cartas.\\nElaborar con un Dinosaurio, un Tritón, un Pirata y un Vampiro {4}.', 'type': 'Artefacto legendario', 'flavor': None, 'faceName': 'Trono de la capitana siniestra', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636569&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '731de72e-3549-4265-80eb-25232fb047be', 'multiverseId': 636569}, 'multiverseid': 636569}, {'name': 'Trône de la Capitaine sinistre // La Capitaine sinistre', 'text': '{T} : Meulez deux cartes.\\nFaçonnez avec un dinosaure, un ondin, un pirate et un vampire {4}', 'type': 'Artefact légendaire', 'flavor': None, 'faceName': 'Trône de la Capitaine sinistre', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636593&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a0c36ca8-085f-47e0-b7be-6df3bec5f1bd', 'multiverseId': 636593}, 'multiverseid': 636593}, {'name': 'Trono della Capitana Lugubre // La Capitana Lugubre', 'text': '{T}: Macina due carte.\\nCostruisci con un Dinosauro, un Tritone, un Pirata e un Vampiro {4}', 'type': 'Artefatto Leggendario', 'flavor': None, 'faceName': 'Trono della Capitana Lugubre', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636617&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '1cec2c0d-3d1b-4501-bbe5-b47feba4d47e', 'multiverseId': 636617}, 'multiverseid': 636617}, {'name': '不気味な船長の玉座 // 不気味な船長', 'text': '{T}：カード２枚を切削する。\\n恐竜１つとマーフォーク１つと海賊１つと吸血鬼１つで作製{4}', 'type': '伝説のアーティファクト', 'flavor': None, 'faceName': '不気味な船長の玉座', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636641&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'a38a7731-cfa9-43b4-8fb6-2227d231de7d', 'multiverseId': 636641}, 'multiverseid': 636641}, {'name': 'Trono da Capitã Sinistra // A Capitã Sinistra', 'text': '{T}: Triture dois cards.\\nConstruir com um Dinossauro, um Tritão, um Pirata e um Vampiro {4}', 'type': 'Artefato Lendário', 'flavor': None, 'faceName': 'Trono da Capitã Sinistra', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636665&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8be166c4-5a76-4d69-a320-830683dd6caa', 'multiverseId': 636665}, 'multiverseid': 636665}, {'name': '司命王座 // 司命', 'text': '{T}：磨两张牌。\\n以一个恐龙、一个人鱼、一个海盗和一个吸血鬼化炼{4}', 'type': '传奇神器', 'flavor': None, 'faceName': '司命王座', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636689&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '061b21bc-018d-457e-8c66-8c01a2548488', 'multiverseId': 636689}, 'multiverseid': 636689}]", '[{\'name\': \'Tiefgoblin-Schädeldieb\', \'text\': \'Bedrohlich\\nZu Beginn deines Endsegments und falls du in diesem Zug abgestiegen bist, lege eine +1/+1-Marke auf den Tiefgoblin-Schädeldieb. (Du bist abgestiegen, falls eine Permanent-Karte von irgendwoher auf deinen Friedhof gelegt wurde.)\', \'type\': \'Kreatur — Goblin, Krieger\', \'flavor\': \'„Verzieh dich! Ich hab ihn zuerst gefunden!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637126&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'93548df3-6da2-444f-bad6-d8a93a78a88d\', \'multiverseId\': 637126}, \'multiverseid\': 637126}, {\'name\': \'Trasgo osirrecolector\', \'text\': \'Amenaza.\\nAl comienzo de tu paso final, si descendiste este turno, pon un contador +1/+1 sobre el Trasgo osirrecolector. (Descendiste si una carta de permanente fue a tu cementerio desde cualquier parte.)\', \'type\': \'Criatura — Guerrero trasgo\', \'flavor\': \'"¡Largo! ¡Yo lo encontré primero!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637447&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d1fe40f1-5fc0-4e70-9902-898d7f80b751\', \'multiverseId\': 637447}, \'multiverseid\': 637447}, {\'name\': \'Gobelin kleptocrâne des profondeurs\', \'text\': "Menace\\nAu début de votre étape de fin, si vous êtes descendu ce tour-ci, mettez un marqueur +1/+1 sur le Gobelin kleptocrâne des profondeurs. (Vous êtes descendu si une carte de permanent a été mise dans votre cimetière depuis n\'importe où.)", \'type\': \'Créature — gobelin et guerrier\', \'flavor\': "« Fiche le camp ! Je l\'ai trouvé le premier ! »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637768&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c66acbfe-db6d-4578-aa28-cf7581f6cf4b\', \'multiverseId\': 637768}, \'multiverseid\': 637768}, {\'name\': \'Goblin delle Profondità Cogliteschi\', \'text\': "Minacciare\\nAll\'inizio della tua sottofase finale, se sei sceso in questo turno, metti un segnalino +1/+1 sul Goblin delle Profondità Cogliteschi. (Sei sceso se una carta permanente è stata messa nel tuo cimitero da qualsiasi zona.)", \'type\': \'Creatura — Guerriero Goblin\', \'flavor\': \'"Sparisci! L\\\'ho trovato prima io!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638089&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a1ed5650-c962-407b-9866-caf1c06ce917\', \'multiverseId\': 638089}, \'multiverseid\': 638089}, {\'name\': \'深淵のゴブリンの骨取り\', \'text\': \'威迫\\nあなたの終了ステップの開始時に、このターンにあなたが落魄していた場合、深淵のゴブリンの骨取りの上に＋１/＋１カウンター１個を置く。（パーマネント・カードがいずこかからあなたの墓地に置かれたなら、あなたは落魄する。）\', \'type\': \'クリーチャー — ゴブリン・戦士\', \'flavor\': \'「あっちいけ！これは俺のもんだ！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638410&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ff926048-8e9e-4d93-ad28-36fc19802cb1\', \'multiverseId\': 638410}, \'multiverseid\': 638410}, {\'name\': \'Pega-crânio Goblin das Profundezas\', \'text\': \'Ameaçar\\nNo início de sua etapa final, se você desceu neste turno, coloque um marcador +1/+1 em Pega-crânio Goblin das Profundezas (Você desceu se um card de permanente foi colocado em seu cemitério vindo de qualquer lugar.)\', \'type\': \'Criatura — Goblin Guerreiro\', \'flavor\': \'"Sai! Eu achei primeiro!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638731&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2e8a5e24-95af-4209-a9e1-eedd4d22fc96\', \'multiverseId\': 638731}, \'multiverseid\': 638731}, {\'name\': \'深邃夺骨鬼怪\', \'text\': \'威慑\\n在你的结束步骤开始时，若你本回合中有落坟，则在深深邃夺骨鬼怪上放置一个+1/+1指示物。（如果有永久物牌从任何区域进入你的坟墓场，便算作你有落坟。）\', \'type\': \'生物 — 鬼怪／战士\', \'flavor\': \'「走开！我先发现的！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639052&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'406766a1-738d-43f4-8899-120d33d8b372\', \'multiverseId\': 639052}, \'multiverseid\': 639052}]', '[{\'name\': \'Tiefsee-Echo\', \'text\': \'Zu Beginn des Kampfes in deinem Zug erkundet das Tiefsee-Echo. Dann kannst du es bis zum Ende des Zuges zu einer Kopie einer anderen Kreatur, die du kontrollierst, werden lassen. (Um diese Kreatur erkunden zu lassen, decke die oberste Karte deiner Bibliothek auf. Falls die Karte ein Land ist, nimm sie auf deine Hand. Lege sonst eine +1/+1-Marke auf diese Kreatur und lege dann die Karte zurück oder auf deinen Friedhof.)\', \'type\': \'Kreatur — Meervolk, Geist\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637269&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'00bbf0a4-db08-4fb3-888c-1adc9a1661b4\', \'multiverseId\': 637269}, \'multiverseid\': 637269}, {\'name\': \'Eco de las profundidades\', \'text\': \'Al comienzo del combate en tu turno, el Eco de las profundidades explora. Luego, puedes hacer que se convierta en una copia de otra criatura que controlas hasta el final del turno. (Para que esta criatura explore, muestra la primera carta de tu biblioteca. Pon esa carta en tu mano si es una tierra. De lo contrario, pon un contador +1/+1 sobre esta criatura y luego devuelve la carta a su sitio o ponla en tu cementerio.)\', \'type\': \'Criatura — Espíritu tritón\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637590&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3d149c1b-20a6-43b5-a628-9649c624dca1\', \'multiverseId\': 637590}, \'multiverseid\': 637590}, {\'name\': \'Écho pélagique\', \'text\': "Au début du combat pendant votre tour, l\'Écho pélagique explore. Puis vous pouvez faire qu\'il devienne une copie d\'une autre créature que vous contrôlez jusqu\'à la fin du tour. (Pour faire explorer cette créature, révélez la carte du dessus de votre bibliothèque. Mettez cette carte dans votre main si c\'est un terrain. Sinon, mettez un marqueur +1/+1 sur cette créature, puis remettez la carte au-dessus de votre bibliothèque ou mettez-la dans votre cimetière.)", \'type\': \'Créature — ondin et esprit\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637911&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fd4ad8fd-0445-46d1-b9c1-bea83997ab1d\', \'multiverseId\': 637911}, \'multiverseid\': 637911}, {\'name\': \'Eco delle Profondità\', \'text\': "All\'inizio del combattimento nel tuo turno, l\'Eco delle Profondità esplora. Poi puoi farlo diventare una copia di un\'altra creatura che controlli fino alla fine del turno. (Per far esplorare questa creatura, rivela la prima carta del tuo grimorio. Se è una terra, aggiungila alla tua mano. Altrimenti, metti un segnalino +1/+1 su questa creatura, poi rimetti quella carta al suo posto o mettila nel tuo cimitero.)", \'type\': \'Creatura — Spirito Tritone\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638232&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'96b7d97a-a2a5-4698-bf7c-c632455d1aee\', \'multiverseId\': 638232}, \'multiverseid\': 638232}, {\'name\': \'深水淵の残響\', \'text\': \'あなたのターンの戦闘の開始時に、深水淵の残響は探検を行う。その後、「ターン終了時まで、これはあなたがコントロールしていてこれでないクリーチャー１体のコピーになる。」を選んでもよい。（このクリーチャーが探検を行うとは、「あなたのライブラリーの一番上のカードを公開する。それが土地なら、そのカードをあなたの手札に加える。そうでないなら、このクリーチャーの上に＋１/＋１カウンター１個を置く。その後、そのカードを戻すかあなたの墓地に置く。」ということである。）\', \'type\': \'クリーチャー — マーフォーク・スピリット\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638553&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'57921632-5d56-4e1f-b155-46809ecb755a\', \'multiverseId\': 638553}, \'multiverseid\': 638553}, {\'name\': \'Eco das Profundezas\', \'text\': \'No início do combate no seu turno, Eco das Profundezas explora. Em seguida, você pode fazer com que ele se torne uma cópia de outra criatura que você controla até o final do turno. (Para fazer esta criatura explorar, revele o card do topo de seu grimório. Coloque aquele card em sua mão se ele for um terreno. Caso contrário, coloque um marcador +1/+1 nesta criatura e, em seguida, devolva o card ao grimório ou coloque-o em seu cemitério.)\', \'type\': \'Criatura — Tritão Espírito\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638874&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bd37d357-1ebc-4074-a6c2-44cebc1adcec\', \'multiverseId\': 638874}, \'multiverseid\': 638874}, {\'name\': \'深涧念世灵\', \'text\': \'在你回合的战斗开始时，令深涧念世灵勘察。然后你可以使它成为另一个由你操控的生物之复制品直到回合结束。（令此生物勘察的流程是展示你的牌库顶牌。如果该牌是地，则置于你手上。若否，则在此生物上放置一个+1/+1指示物，然后将所展示的牌放回原位或置入你的坟墓场。）\', \'type\': \'生物 — 人鱼／精怪\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639195&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'64bcf8fb-0fbd-4ea9-9b41-99e357433d71\', \'multiverseId\': 639195}, \'multiverseid\': 639195}]', '[{\'name\': \'Tiefsee-Echo\', \'text\': \'Zu Beginn des Kampfes in deinem Zug erkundet das Tiefsee-Echo. Dann kannst du es bis zum Ende des Zuges zu einer Kopie einer anderen Kreatur, die du kontrollierst, werden lassen.\', \'type\': \'Kreatur — Meervolk, Geist\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639842&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a4691997-cc88-461b-ad82-b70a8c120122\', \'multiverseId\': 639842}, \'multiverseid\': 639842}, {\'name\': \'Écho pélagique\', \'text\': "Au début du combat pendant votre tour, l\'Écho pélagique explore. Puis vous pouvez faire qu\'il devienne une copie d\'une autre créature que vous contrôlez jusqu\'à la fin du tour.", \'type\': \'Créature — ondin et esprit\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639893&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'67ac198b-7da0-4941-98c7-fbe2e619ff98\', \'multiverseId\': 639893}, \'multiverseid\': 639893}, {\'name\': \'深水淵の残響\', \'text\': \'あなたのターンの戦闘の開始時に、深水淵の残響は探検を行う。その後、「ターン終了時まで、これはあなたがコントロールしていてこれでないクリーチャー１体のコピーになる。」を選んでもよい。\', \'type\': \'クリーチャー — マーフォーク・スピリット\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639944&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'94840768-56b6-4040-b037-941273ef114f\', \'multiverseId\': 639944}, \'multiverseid\': 639944}, {\'name\': \'深涧念世灵\', \'text\': \'在你回合的战斗开始时，令深涧念世灵勘察。然后你可以使它成为另一个由你操控的生物之复制品直到回合结束。\', \'type\': \'生物 — 人鱼／精怪\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639995&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d7d2c9e1-0614-4380-921e-e2245a565250\', \'multiverseId\': 639995}, \'multiverseid\': 639995}]', '[{\'name\': \'Tishanas Gezeitenbändigerin\', \'text\': \'Aufblitzen\\nWenn Tishanas Gezeitenbändigerin ins Spiel kommt, neutralisiere bis zu eine aktivierte oder ausgelöste Fähigkeit deiner Wahl. Falls eine Fähigkeit eines Artefakts, einer Kreatur oder eines Planeswalkers auf diese Weise neutralisiert wird, verliert jenes Permanent alle Fähigkeiten, solange Tishanas Gezeitenbändigerin im Spiel bleibt. (Manafähigkeiten können nicht als Ziel gewählt werden.)\', \'type\': \'Kreatur — Meervolk, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637104&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b49ee925-1060-4543-bffa-ea4e357d9876\', \'multiverseId\': 637104}, \'multiverseid\': 637104}, {\'name\': \'Enlazamarea de Tishana\', \'text\': \'Destello.\\nCuando la Enlazamarea de Tishana entre al campo de batalla, contrarresta hasta una habilidad activada o disparada objetivo. Si una habilidad de un artefacto, criatura o planeswalker es contrarrestada de esta manera, ese permanente pierde todas las habilidades mientras la Enlazamarea de Tishana permanezca en el campo de batalla. (Las habilidades de maná no pueden hacerse objetivo.)\', \'type\': \'Criatura — Hechicero tritón\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637425&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0a0ba2a7-69f0-4f1f-a7e3-5b9f9b25bdd8\', \'multiverseId\': 637425}, \'multiverseid\': 637425}, {\'name\': \'Ferre-marée de Tishana\', \'text\': "Flash\\nQuand la Ferre-marée de Tishana arrive sur le champ de bataille, contrecarrez jusqu\'à une capacité activée ou déclenchée ciblée. Si une capacité d\'un artefact, d\'une créature ou d\'un planeswalker est contrecarrée de cette manière, ce permanent perd toutes ses capacités tant que la Ferre-marée de Tishana reste sur le champ de bataille. (Les capacités de mana ne peuvent pas être ciblées.)", \'type\': \'Créature — ondin et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637746&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4c857031-65d8-417c-924a-103b8a450e0f\', \'multiverseId\': 637746}, \'multiverseid\': 637746}, {\'name\': \'Vincolaflusso di Tishana\', \'text\': "Lampo\\nQuando la Vincolaflusso di Tishana entra nel campo di battaglia, neutralizza fino a un\'abilità attivata o innescata bersaglio. Se un\'abilità di un artefatto, una creatura o un planeswalker viene neutralizzata in questo modo, quel permanente perde tutte le abilità fintanto che la Vincolaflusso di Tishana rimane sul campo di battaglia. (Le abilità di mana non possono essere bersagliate.)", \'type\': \'Creatura — Mago Tritone\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638067&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d8d52f64-ffef-41ec-a540-f0b413c87e81\', \'multiverseId\': 638067}, \'multiverseid\': 638067}, {\'name\': \'ティシャーナの潮縛り\', \'text\': \'瞬速\\nティシャーナの潮縛りが戦場に出たとき、起動型や誘発型である能力最大１つを対象とする。それを打ち消す。これによりアーティファクトやクリーチャーやプレインズウォーカーの能力が打ち消されたなら、ティシャーナの潮縛りが戦場にあり続けるかぎり、そのパーマネントはすべての能力を失う。（マナ能力は対象にできない。）\', \'type\': \'クリーチャー — マーフォーク・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638388&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b9ab2f41-0162-4623-b48c-e455f4f766f2\', \'multiverseId\': 638388}, \'multiverseid\': 638388}, {\'name\': \'Vinculadora de Maré de Tishana\', \'text\': \'Lampejo\\nQuando Vinculadora de Maré de Tishana entrar no campo de batalha, anule até uma habilidade ativada ou desencadeada alvo. Se uma habilidade de um artefato, uma criatura ou um planeswalker for anulada dessa forma, aquela permanente perderá todas as habilidades enquanto Vinculadora de Maré de Tishana permanecer no campo de batalha. (As habilidades de mana não podem ser alvo.)\', \'type\': \'Criatura — Tritão Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638709&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5576554f-08c2-4684-82c6-14c94f389dc2\', \'multiverseId\': 638709}, \'multiverseid\': 638709}, {\'name\': \'提莎娜的缚潮师\', \'text\': \'闪现\\n当提莎娜的缚潮师进战场时，反击至多一个目标起动式或触发式异能。如果以此法反击神器，生物或鹏洛客的异能，则于提莎娜的缚潮师仍在战场上的时段内，该永久物失去所有异能。（其目标不能是法术力异能。）\', \'type\': \'生物 — 人鱼／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639030&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'453752bd-56e0-488b-a990-dbdcb4b9ceeb\', \'multiverseId\': 639030}, \'multiverseid\': 639030}]', '[{\'name\': \'Tishanas Gezeitenbändigerin\', \'text\': \'Aufblitzen\\nWenn Tishanas Gezeitenbändigerin ins Spiel kommt, neutralisiere bis zu eine aktivierte oder ausgelöste Fähigkeit deiner Wahl. Falls eine Fähigkeit eines Artefakts, einer Kreatur oder eines Planeswalkers auf diese Weise neutralisiert wird, verliert jenes Permanent alle Fähigkeiten, solange Tishanas Gezeitenbändigerin im Spiel bleibt.\', \'type\': \'Kreatur — Meervolk, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639281&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ae0c567e-1877-43a6-bd92-c96cc62579a3\', \'multiverseId\': 639281}, \'multiverseid\': 639281}, {\'name\': \'Enlazamarea de Tishana\', \'text\': \'Destello.\\nCuando la Enlazamarea de Tishana entre al campo de batalla, contrarresta hasta una habilidad activada o disparada objetivo. Si una habilidad de un artefacto, criatura o planeswalker es contrarrestada de esta manera, ese permanente pierde todas las habilidades mientras la Enlazamarea de Tishana permanezca en el campo de batalla.\', \'type\': \'Criatura — Hechicero tritón\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639301&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'52d6cce6-a70a-4046-a6d1-31b334c5a09c\', \'multiverseId\': 639301}, \'multiverseid\': 639301}, {\'name\': \'Ferre-marée de Tishana\', \'text\': "Flash\\nQuand la Ferre-marée de Tishana arrive sur le champ de bataille, contrecarrez jusqu\'à une capacité activée ou déclenchée ciblée. Si une capacité d\'un artefact, d\'une créature ou d\'un planeswalker est contrecarrée de cette manière, ce permanent perd toutes ses capacités tant que la Ferre-marée de Tishana reste sur le champ de bataille.", \'type\': \'Créature — ondin et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639321&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'be7bf3a3-147c-4424-9128-cd391c9f8b22\', \'multiverseId\': 639321}, \'multiverseid\': 639321}, {\'name\': \'Vincolaflusso di Tishana\', \'text\': "Lampo\\nQuando la Vincolaflusso di Tishana entra nel campo di battaglia, neutralizza fino a un\'abilità attivata o innescata bersaglio. Se un\'abilità di un artefatto, una creatura o un planeswalker viene neutralizzata in questo modo, quel permanente perde tutte le abilità fintanto che la Vincolaflusso di Tishana rimane sul campo di battaglia.", \'type\': \'Creatura — Mago Tritone\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639341&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'65d5ad57-1beb-44c2-953f-bf4e1e44007e\', \'multiverseId\': 639341}, \'multiverseid\': 639341}, {\'name\': \'ティシャーナの潮縛り\', \'text\': \'瞬速\\nティシャーナの潮縛りが戦場に出たとき、起動型や誘発型である能力最大１つを対象とする。それを打ち消す。これによりアーティファクトやクリーチャーやプレインズウォーカーの能力が打ち消されたなら、ティシャーナの潮縛りが戦場にあり続けるかぎり、そのパーマネントはすべての能力を失う。\', \'type\': \'クリーチャー — マーフォーク・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639361&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b70d8f21-caf5-41e5-b133-8b3a5a7b78cd\', \'multiverseId\': 639361}, \'multiverseid\': 639361}, {\'name\': \'Vinculadora de Maré de Tishana\', \'text\': \'Lampejo\\nQuando Vinculadora de Maré de Tishana entrar no campo de batalha, anule até uma habilidade ativada ou desencadeada alvo. Se uma habilidade de um artefato, uma criatura ou um planeswalker for anulada dessa forma, aquela permanente perderá todas as habilidades enquanto Vinculadora de Maré de Tishana permanecer no campo de batalha.\', \'type\': \'Criatura — Tritão Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639381&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'87d1972c-ba33-40ac-bd4d-3da401f865af\', \'multiverseId\': 639381}, \'multiverseid\': 639381}, {\'name\': \'提莎娜的缚潮师\', \'text\': \'闪现\\n当提莎娜的缚潮师进战场时，反击至多一个目标起动式或触发式异能。如果以此法反击神器，生物或鹏洛客的异能，则于提莎娜的缚潮师仍在战场上的时段内，该永久物失去所有异能。\', \'type\': \'生物 — 人鱼／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639401&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'19fb4f86-7d82-491e-8a5f-4b16a30695fa\', \'multiverseId\': 639401}, \'multiverseid\': 639401}]', '[{\'name\': \'Tobender Brackzahn\', \'text\': \'Abwehr {3} (Immer wenn diese Kreatur das Ziel eines Zauberspruchs oder einer Fähigkeit wird, den bzw. die ein Gegner kontrolliert, neutralisiere ihn bzw. sie, es sei denn, jener Spieler bezahlt {3}.)\\nInselumwandlung {2} ({2}, wirf diese Karte ab: Durchsuche deine Bibliothek nach einer Insel-Karte, zeige sie offen vor, nimm sie auf deine Hand und mische danach.)\', \'type\': \'Kreatur — Dinosaurier\', \'flavor\': \'Uralte Glyphen sind weitaus schwieriger zu entziffern, wenn sie auf einem riesigen Raubtier stehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637086&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4196b124-fec1-4d7b-9b60-675a19d6f837\', \'multiverseId\': 637086}, \'multiverseid\': 637086}, {\'name\': \'Colmisalobre depredador\', \'text\': \'Rebatir {3}. (Siempre que esta criatura sea objetivo de un hechizo o habilidad que controla un oponente, contrarréstalo a menos que ese jugador pague {3}.)\\nCiclo de isla {2}. ({2}, descartar esta carta: Busca en tu biblioteca una carta de Isla, muéstrala, ponla en tu mano y luego baraja.)\', \'type\': \'Criatura — Dinosaurio\', \'flavor\': \'Resulta mucho más laborioso descifrar glifos antiguos si se encuentran en el cuerpo de un superdepredador.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637407&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'309283c0-1d7c-45cf-9fc2-976c32cbb997\', \'multiverseId\': 637407}, \'multiverseid\': 637407}, {\'name\': \'Croc-des-flots en maraude\', \'text\': "Parade {3} (À chaque fois que cette créature devient la cible d\'un sort ou d\'une capacité qu\'un adversaire contrôle, contrecarrez ce sort ou cette capacité à moins que ce joueur ne paie {3}.)\\nRecyclage d\'île {2} ({2}, défaussez-vous de cette carte : Cherchez dans votre bibliothèque une carte d\'île, révélez-la, mettez-la dans votre main, puis mélangez.)", \'type\': \'Créature — dinosaure\', \'flavor\': \'Les glyphes anciens sont plus difficiles à décrypter quand ils sont attachés à un superprédateur.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637728&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'68c0ee1f-415f-4443-a698-49afb0318159\', \'multiverseId\': 637728}, \'multiverseid\': 637728}, {\'name\': \'無法の塩水牙\', \'text\': \'護法{3}（このクリーチャーが対戦相手がコントロールしている呪文や能力の対象になるたび、そのプレイヤーが{3}を支払わないかぎり、その呪文や能力を打ち消す。）\\n島サイクリング{2}（{2}, このカードを捨てる：あなたのライブラリーから島・カード１枚を探し、公開し、あなたの手札に加える。その後、ライブラリーを切り直す。）\', \'type\': \'クリーチャー — 恐竜\', \'flavor\': \'頂点捕食者の体に刻まれているとなれば、古代象形の解読は輪をかけて困難なものになる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638370&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e3d5eaf3-3e36-4f12-ba89-3f01b12d4119\', \'multiverseId\': 638370}, \'multiverseid\': 638370}, {\'name\': \'Dentimarino Saqueador\', \'text\': \'Salvaguarda {3} (Toda vez que esta criatura se tornar alvo de uma mágica ou habilidade que um oponente controla, anule-a, a menos que aquele jogador pague {3}.)\\nReciclar Ilha {2} ({2}, descarte este card: Procure em seu grimório um card de Ilha, revele-o, coloque-o em sua mão e depois embaralhe.)\', \'type\': \'Criatura — Dinossauro\', \'flavor\': \'Glifos antigos são muito mais difíceis de decifrar quando anexados a um predador supremo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638691&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f5d04fcf-69d5-4f54-8e87-6c6f92b9c1cb\', \'multiverseId\': 638691}, \'multiverseid\': 638691}, {\'name\': \'劫掠海齿兽\', \'text\': \'守护{3}（每当此生物成为由对手操控之咒语或异能的目标时，除非该牌手支付{3}，否则反击之。）\\n循环海岛{2}（{2}，弃掉此牌：从你牌库中搜寻一张海岛牌，展示该牌，将它置于你手上，然后洗牌。）\', \'type\': \'生物 — 恐龙\', \'flavor\': \'当远古雕符出现在了顶级掠食者身上时，解读难度就大大增加。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639012&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e6be7175-984d-4af9-8889-8160a3652c92\', \'multiverseId\': 639012}, \'multiverseid\': 639012}]', '[{\'name\': \'Tobender Ceratops\', \'text\': \'Der Tobende Ceratops kann nicht geblockt werden, außer von drei oder mehr Kreaturen.\', \'type\': \'Kreatur — Dinosaurier\', \'flavor\': \'Da sie enge Räume und eine unbedeutende Tierwelt erwarteten, waren die Expeditionen der Legion des Zwielichts klein, mobil und nur leicht gepanzert. Nach massiven Verlustenentsandten sie nur noch gepanzerte Kolonnen .\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637196&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b8cd8085-93a3-43f7-8cf8-c406ae92b47e\', \'multiverseId\': 637196}, \'multiverseid\': 637196}, {\'name\': \'Ceratops arremetedor\', \'text\': \'El Ceratops arremetedor no puede ser bloqueado excepto por tres o más criaturas.\', \'type\': \'Criatura — Dinosaurio\', \'flavor\': \'Las primeras expediciones de la Legión del Crepúsculo eran pequeñas, móviles y poco acorazadas, ya que preveían espacios estrechos y una fauna insignificante. Cientos de bajas más tarde, empezaron a enviar pelotones blindados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637517&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'46bbc456-b6fe-4ce7-ac87-ec1531036c1c\', \'multiverseId\': 637517}, \'multiverseid\': 637517}, {\'name\': \'Cératops déchaîné\', \'text\': \'Le Cératops déchaîné ne peut pas être bloqué excepté par trois créatures ou plus.\', \'type\': \'Créature — dinosaure\', \'flavor\': "S\'attendant à des espaces exigus et à une faune distrayante, les premières expéditions de la Légion du crépuscule étaient petites en nombre, mobiles et peu protégées. Après plusieurs centaines de morts, ils commencèrent à envoyer des pelotons en armure de plates.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637838&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9deb6552-fe32-4fd0-863b-6d4793e904c9\', \'multiverseId\': 637838}, \'multiverseid\': 637838}, {\'name\': \'Triceratopo Infuriato\', \'text\': \'Il Triceratopo Infuriato non può essere bloccato tranne che da tre o più creature.\', \'type\': \'Creatura — Dinosauro\', \'flavor\': \'Prevedendo spazi stretti e una scarsità di fauna, le prime spedizioni della Legione del Vespro erano compatte, agili e dotate di armature leggere. Dopo centinaia di morti, iniziarono a inviare plotoni corazzati.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638159&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'51385d25-3658-4216-a7e0-0d736d07cb58\', \'multiverseId\': 638159}, \'multiverseid\': 638159}, {\'name\': \'暴走するケラトプス\', \'text\': \'暴走するケラトプスは３体以上のクリーチャーにしかブロックされない。\', \'type\': \'クリーチャー — 恐竜\', \'flavor\': \'薄暮軍団の第一次遠征部隊は土地の狭さや動物相のささやかさを見越し、軽装備で小回りが利く少数編成だった。数百名もの死傷者を出した後になって、重装甲の小隊を送り始めた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638480&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a69ea6fe-4058-4189-9794-98bf60713b49\', \'multiverseId\': 638480}, \'multiverseid\': 638480}, {\'name\': \'Cerátopo Rampante\', \'text\': \'Cerátopo Rampante só pode ser bloqueado por três ou mais criaturas.\', \'type\': \'Criatura — Dinossauro\', \'flavor\': \'Antevendo espaços apertados e uma fauna trivial, as primeiras expedições da Legião do Crepúsculo eram pequenas, móveis e com armaduras leves. Centenas de baixas depois, eles começaram a enviar pelotões com armaduras de placa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638801&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'31cf1b1c-a170-4017-9544-91604428bc5a\', \'multiverseId\': 638801}, \'multiverseid\': 638801}, {\'name\': \'莽闯犄角龙\', \'text\': \'莽闯犄角龙只能被三个或更多生物阻挡。\', \'type\': \'生物 — 恐龙\', \'flavor\': \'最初一批深入地底的暮影军团探险队以为洞窟里面地形狭窄、动物稀少，因此便散作灵活机动的小规模团队轻装出阵。在减员高达数百人之后，他们才开始派出装甲部队。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639122&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'88bcb93f-fb8c-4b46-9bb0-9ad7317159b8\', \'multiverseId\': 639122}, \'multiverseid\': 639122}]', "[{'name': 'Tobender Ceratops', 'text': 'Der Tobende Ceratops kann nicht geblockt werden, außer von drei oder mehr Kreaturen.', 'type': 'Kreatur — Dinosaurier', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639581&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c5b4d373-d733-448a-bbc3-74220b3168ad', 'multiverseId': 639581}, 'multiverseid': 639581}, {'name': 'Ceratops arremetedor', 'text': 'El Ceratops arremetedor no puede ser bloqueado excepto por tres o más criaturas.', 'type': 'Criatura — Dinosaurio', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639594&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '0692f69b-39ca-4b14-ad76-d86aa12a0507', 'multiverseId': 639594}, 'multiverseid': 639594}, {'name': 'Cératops déchaîné', 'text': 'Le Cératops déchaîné ne peut pas être bloqué excepté par trois créatures ou plus.', 'type': 'Créature — dinosaure', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639607&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a3453930-6a3d-45f3-9b5a-547bef4ca68f', 'multiverseId': 639607}, 'multiverseid': 639607}, {'name': 'Triceratopo Infuriato', 'text': 'Il Triceratopo Infuriato non può essere bloccato tranne che da tre o più creature.', 'type': 'Creatura — Dinosauro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639620&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '18d2ce96-ecbe-4575-8a42-65b92fd111b1', 'multiverseId': 639620}, 'multiverseid': 639620}, {'name': '暴走するケラトプス', 'text': '暴走するケラトプスは３体以上のクリーチャーにしかブロックされない。', 'type': 'クリーチャー — 恐竜', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639633&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '0fa249ad-bfda-4e80-a858-cb91c43aadb1', 'multiverseId': 639633}, 'multiverseid': 639633}, {'name': 'Cerátopo Rampante', 'text': 'Cerátopo Rampante só pode ser bloqueado por três ou mais criaturas.', 'type': 'Criatura — Dinossauro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639646&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ca31e54e-819b-4ce7-a8f3-19c7311f5922', 'multiverseId': 639646}, 'multiverseid': 639646}, {'name': '莽闯犄角龙', 'text': '莽闯犄角龙只能被三个或更多生物阻挡。', 'type': '生物 — 恐龙', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639659&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a222e4ed-ebf6-40c1-8dbd-87f37b60793a', 'multiverseId': 639659}, 'multiverseid': 639659}]", '[{\'name\': \'Tobender Dornenschwanz\', \'text\': \'Wenn der Tobende Dornenschwanz ins Spiel kommt, erhält eine Kreatur deiner Wahl, die du kontrollierst, +2/+0 und Unzerstörbarkeit bis zum Ende des Zuges.\\nSumpfumwandlung {2} ({2}, wirf diese Karte ab: Durchsuche deine Bibliothek nach einer Sumpf-Karte, zeige sie offen vor, nimm sie auf deine Hand und mische danach.)\', \'type\': \'Kreatur — Dinosaurier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637142&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'009d3683-58c6-4c3d-b6dc-6f42414195a3\', \'multiverseId\': 637142}, \'multiverseid\': 637142}, {\'name\': \'Colapúa enfurecido\', \'text\': \'Cuando el Colapúa enfurecido entre al campo de batalla, la criatura objetivo que controlas obtiene +2/+0 y gana la habilidad de indestructible hasta el final del turno.\\nCiclo de pantano {2}. ({2}, descartar esta carta: Busca en tu biblioteca una carta de Pantano, muéstrala, ponla en tu mano y luego baraja.)\', \'type\': \'Criatura — Dinosaurio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637463&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dbaae66a-7301-45bf-8c66-6781a9518cf8\', \'multiverseId\': 637463}, \'multiverseid\': 637463}, {\'name\': \'Dracodard déchaîné\', \'text\': "Quand le Dracodard déchaîné arrive sur le champ de bataille, une créature ciblée que vous contrôlez gagne +2/+0 et acquiert l\'indestructible jusqu\'à la fin du tour.\\nRecyclage de marais {2} ({2}, défaussez-vous de cette carte : Cherchez dans votre bibliothèque une carte de marais, révélez-la, mettez-la dans votre main, puis mélangez.)", \'type\': \'Créature — dinosaure\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637784&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d52e8add-7539-4c32-8ce9-b0b1cceeb094\', \'multiverseId\': 637784}, \'multiverseid\': 637784}, {\'name\': \'Codapunta Infuriato\', \'text\': \'Quando il Codapunta Infuriato entra nel campo di battaglia, una creatura bersaglio che controlli prende +2/+0 e ha indistruttibile fino alla fine del turno.\\nCiclopalude {2} ({2}, Scarta questa carta: Passa in rassegna il tuo grimorio per una carta Palude, rivelala e aggiungila alla tua mano, poi rimescola.)\', \'type\': \'Creatura — Dinosauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638105&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dfea31d1-8f22-4bb6-8541-6b1362fdf402\', \'multiverseId\': 638105}, \'multiverseid\': 638105}, {\'name\': \'猛り狂うトゲ尾\', \'text\': \'猛り狂うトゲ尾が戦場に出たとき、あなたがコントロールしているクリーチャー１体を対象とする。ターン終了時まで、それは＋２/＋０の修整を受け破壊不能を得る。\\n沼サイクリング {2} （{2}, このカードを捨てる：あなたのライブラリーから沼・カード１枚を探し、公開し、あなたの手札に加える。その後、ライブラリーを切り直す。）\', \'type\': \'クリーチャー — 恐竜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638426&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3b4ec6c7-8c8f-455c-9b2d-6bf9528634cc\', \'multiverseId\': 638426}, \'multiverseid\': 638426}, {\'name\': \'Cauda-espigada Rampante\', \'text\': \'Quando Cauda-espigada Rampante entra no campo de batalha, a criatura alvo que você controla recebe +2/+0 e ganha indestrutível até o final do turno.\\nReciclar Pântano {2} ({2}, descarte este card: procure em seu grimório um card de Pântano, revele-o, coloque-o em sua mão e depois embaralhe.)\', \'type\': \'Criatura — Dinossauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638747&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ec06ca87-4516-4183-b4d7-d247af35f3cd\', \'multiverseId\': 638747}, \'multiverseid\': 638747}, {\'name\': \'莽闯刺尾龙\', \'text\': \'当莽闯刺尾龙进战场时，直到回合结束，目标由你操控的生物得+2/+0且获得不灭异能。\\n循环沼泽{2}（{2}，弃掉此牌：从你牌库中搜寻一张沼泽牌，展示该牌，将它置于你手上，然后洗牌。）\', \'type\': \'生物 — 恐龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639068&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'16be6907-02b5-4351-bdc1-2ed44f609d07\', \'multiverseId\': 639068}, \'multiverseid\': 639068}]', '[{\'name\': \'Tollkuns Tunnelbohrer // Tecutlan, die Sengende Kluft\', \'text\': \'(Transformierter Tollkuns Tunnelbohrer.)\\n{T}: Erzeuge {R}.\\nImmer wenn du einen Bleibende-Karte-Zauberspruch mit Mana wirkst, das von Tecutlan, der Sengenden Kluft, erzeugt wurde, wende Entdeckung X an, wobei X gleich dem Manabetrag jenes Zauberspruchs ist.\', \'type\': \'Legendäres Land — Höhle\', \'flavor\': None, \'faceName\': \'Tecutlan, die Sengende Kluft\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637164&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'08bd6b3f-cd8a-4ba8-af5b-be751d73a0f8\', \'multiverseId\': 637164}, \'multiverseid\': 637164}, {\'name\': \'Perforatúneles de Azófar // Tecutlan, la grieta abrasadora\', \'text\': \'(Se transforma del Perforatúneles de Azófar.)\\n{T}: Agrega {R}.\\nSiempre que lances un hechizo de permanente usando maná producido por Tecutlan, la grieta abrasadora, descubre X, donde X es el valor de maná de ese hechizo.\', \'type\': \'Tierra legendaria — Cueva\', \'flavor\': None, \'faceName\': \'Tecutlan, la grieta abrasadora\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637485&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a46d169f-e265-4e44-80a9-3f269d622433\', \'multiverseId\': 637485}, \'multiverseid\': 637485}, {\'name\': "Broyeur de tunnel d\'Hardiesce // Tecutlan, la Faille ardente", \'text\': "(Transformation du Broyeur de tunnel d\'Hardiesce.)\\n{T} : Ajoutez {R}.\\nÀ chaque fois que vous lancez un sort de permanent avec du mana produit par Tecutlan, la Faille ardente, découvrez X, X étant la valeur de mana de ce sort.", \'type\': \'Terrain légendaire — caverne\', \'flavor\': None, \'faceName\': \'Tecutlan, la Faille ardente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637806&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ce606a5a-6823-460a-b459-f6b71fee867f\', \'multiverseId\': 637806}, \'multiverseid\': 637806}, {\'name\': \'Scavatunnel di Cuor di Bronzo // Tecutlan, lo Squarcio Rovente\', \'text\': \'(Si trasforma dalla Scavatunnel di Cuor di Bronzo.)\\n{T}: Aggiungi {R}.\\nOgniqualvolta lanci una magia permanente usando mana prodotto da Tecutlan, lo Squarcio Rovente, scopri X, dove X è il valore di mana di quella magia.\', \'type\': \'Terra Leggendaria — Caverna\', \'flavor\': None, \'faceName\': \'Tecutlan, lo Squarcio Rovente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638127&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1ce7a672-6299-47e1-9a1c-7a78cb90bfcc\', \'multiverseId\': 638127}, \'multiverseid\': 638127}, {\'name\': \'鉄面提督のトンネル掘削機 // 灼熱の裂け目、テクトラン\', \'text\': \'（鉄面提督のトンネル掘削機から変身する。）\\n{T}：{R}を加える。\\nあなたが灼熱の裂け目、テクトランによって生み出されたマナを使ってパーマネント・呪文１つを唱えるたび、発見Ｘを行う。Ｘは、その呪文のマナ総量に等しい。\', \'type\': \'伝説の土地 — 洞窟\', \'flavor\': None, \'faceName\': \'灼熱の裂け目、テクトラン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638448&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9b18e9fa-2888-46f7-ab15-6b013448e4ed\', \'multiverseId\': 638448}, \'multiverseid\': 638448}, {\'name\': \'Tatuzão da Bronze // Tecutlan, a Fenda Ardente\', \'text\': \'(Transformação de Tatuzão da Bronze.)\\n{T}: Adicione {R}.\\nToda vez que você conjurar uma mágica de permanente usando mana gerado por Tecutlan, a Fenda Ardente, descubra X, sendo X o valor de mana daquela mágica.\', \'type\': \'Terreno Lendário — Caverna\', \'flavor\': None, \'faceName\': \'Tecutlan, a Fenda Ardente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638769&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'94b0004b-595e-4d62-b5c8-f1d558ac8af4\', \'multiverseId\': 638769}, \'multiverseid\': 638769}, {\'name\': \'霸司的掘隧机 // 炙热裂缝蒂库澜\', \'text\': \'（由霸司的掘隧机转化。）\\n{T}：加{R}。\\n每当你利用炙热裂缝蒂库澜产生之法术力来施放永久物咒语时，倾探X，X为该咒语的法术力值。\', \'type\': \'传奇地 — 洞窟\', \'flavor\': None, \'faceName\': \'炙热裂缝蒂库澜\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639090&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ffb70f7c-4ca0-4f29-90da-7e6fd8662b81\', \'multiverseId\': 639090}, \'multiverseid\': 639090}]', '[{\'name\': \'Tollkuns Tunnelbohrer // Tecutlan, die Sengende Kluft\', \'text\': \'Wenn Tollkuns Tunnelbohrer ins Spiel kommt, wirf eine beliebige Anzahl an Karten ab und ziehe dann entsprechend viele Karten plus eine.\\nZu Beginn deines Endsegments und falls du in diesem Zug abgestiegen bist, lege eine Bohrungsmarke auf Tollkuns Tunnelbohrer. Falls dann drei oder mehr Bohrungsmarken auf ihm liegen, entferne sie und transformiere ihn. (Du bist abgestiegen, falls eine Permanent-Karte von irgendwoher auf deinen Friedhof gelegt wurde.)\', \'type\': \'Legendäres Artefakt\', \'flavor\': None, \'faceName\': \'Tollkuns Tunnelbohrer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637164&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'08bd6b3f-cd8a-4ba8-af5b-be751d73a0f8\', \'multiverseId\': 637164}, \'multiverseid\': 637164}, {\'name\': \'Perforatúneles de Azófar // Tecutlan, la grieta abrasadora\', \'text\': \'Cuando el Perforatúneles de Azófar entre al campo de batalla, descarta cualquier cantidad de cartas, luego roba esa misma cantidad de cartas más una.\\nAl comienzo de tu paso final, si descendiste este turno, pon un contador de perforación sobre el Perforatúneles de Azófar. Luego, si hay tres o más contadores de perforación sobre él, remueve esos contadores y transfórmalo. (Descendiste si una carta de permanente fue a tu cementerio desde cualquier parte.)\', \'type\': \'Artefacto legendario\', \'flavor\': None, \'faceName\': \'Perforatúneles de Azófar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637485&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a46d169f-e265-4e44-80a9-3f269d622433\', \'multiverseId\': 637485}, \'multiverseid\': 637485}, {\'name\': "Broyeur de tunnel d\'Hardiesce // Tecutlan, la Faille ardente", \'text\': "Quand le Broyeur de tunnel d\'Hardiesce arrive sur le champ de bataille, défaussez-vous de n\'importe quel nombre de cartes, puis piochez autant de cartes plus une.\\nAu début de votre étape de fin, si vous êtes descendu ce tour-ci, mettez un marqueur « forage » sur le Broyeur de tunnel d\'Hardiesce. Puis, s\'il y a au moins trois marqueurs « forage » sur lui, retirez ces marqueurs et transformez-le. (Vous êtes descendu si une carte de permanent a été mise dans votre cimetière depuis n\'importe où.)", \'type\': \'Artefact légendaire\', \'flavor\': None, \'faceName\': "Broyeur de tunnel d\'Hardiesce", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637806&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ce606a5a-6823-460a-b459-f6b71fee867f\', \'multiverseId\': 637806}, \'multiverseid\': 637806}, {\'name\': \'Scavatunnel di Cuor di Bronzo // Tecutlan, lo Squarcio Rovente\', \'text\': "Quando la Scavatunnel di Cuor di Bronzo entra nel campo di battaglia, scarta un qualsiasi numero di carte, poi pesca altrettante carte più una.\\nAll\'inizio della tua sottofase finale, se sei sceso in questo turno, metti un segnalino trivella sulla Scavatunnel di Cuor di Bronzo. Poi, se ci sono tre o più segnalini trivella su di essa, rimuovi quei segnalini e trasformala. (Sei sceso se una carta permanente è stata messa nel tuo cimitero da qualsiasi zona.)", \'type\': \'Artefatto Leggendario\', \'flavor\': None, \'faceName\': \'Scavatunnel di Cuor di Bronzo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638127&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1ce7a672-6299-47e1-9a1c-7a78cb90bfcc\', \'multiverseId\': 638127}, \'multiverseid\': 638127}, {\'name\': \'鉄面提督のトンネル掘削機 // 灼熱の裂け目、テクトラン\', \'text\': \'鉄面提督のトンネル掘削機が戦場に出たとき、望む枚数のカードを捨て、その後その枚数に１を足した枚数のカードを引く。\\nあなたの終了ステップの開始時に、このターンにあなたが落魄していた場合、鉄面提督のトンネル掘削機の上に掘削カウンター１個を置く。その後、これの上に３個以上の掘削カウンターがあるなら、それらのカウンターを取り除き、これを変身させる。（パーマネント・カードがいずこかからあなたの墓地に置かれたなら、あなたは落魄する。）\', \'type\': \'伝説のアーティファクト\', \'flavor\': None, \'faceName\': \'鉄面提督のトンネル掘削機\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638448&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9b18e9fa-2888-46f7-ab15-6b013448e4ed\', \'multiverseId\': 638448}, \'multiverseid\': 638448}, {\'name\': \'Tatuzão da Bronze // Tecutlan, a Fenda Ardente\', \'text\': \'Quando Tatuzão da Bronze entrar no campo de batalha, descarte qualquer número de cards e depois compre aquela quantidade de cards mais um.\\nNo início de sua etapa final, se você desceu neste turno, coloque um marcador de perfuração em Tatuzão da Bronze. Depois, se houver três ou mais marcadores de perfuração nele, remova aqueles marcadores e transforme-o. (Você desceu se um card de permanente foi colocado em seu cemitério vindo de qualquer lugar.)\', \'type\': \'Artefato Lendário\', \'flavor\': None, \'faceName\': \'Tatuzão da Bronze\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638769&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'94b0004b-595e-4d62-b5c8-f1d558ac8af4\', \'multiverseId\': 638769}, \'multiverseid\': 638769}, {\'name\': \'霸司的掘隧机 // 炙热裂缝蒂库澜\', \'text\': \'当霸司的掘隧机进战场时，弃任意数量的牌，然后抓该数量加一的牌。\\n在你的结束步骤开始时，若你本回合中有落坟，则在霸司的掘隧机上放置一个钻孔指示物。然后若其上有三个或更多钻孔指示物，则移去这些指示物并转化它。（如果有永久物牌从任何区域进入你的坟墓场，便算作你有落坟。）\', \'type\': \'传奇神器\', \'flavor\': None, \'faceName\': \'霸司的掘隧机\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639090&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ffb70f7c-4ca0-4f29-90da-7e6fd8662b81\', \'multiverseId\': 639090}, \'multiverseid\': 639090}]', '[{\'name\': \'Tollkühner Klingenmeister\', \'text\': \'Immer wenn der Tollkühne Klingenmeister angreift, während du zwei oder mehr Artefakte kontrollierst, erhält er +2/+1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Ork, Pirat\', \'flavor\': \'„Das Geheimnis ist die Beinarbeit. Und natürlich ein zweites Schwert."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637166&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cf545a7e-a1e4-42d4-9c64-6963e9a1ef77\', \'multiverseId\': 637166}, \'multiverseid\': 637166}, {\'name\': \'Maestro de filo de Azófar\', \'text\': \'Siempre que el Maestro de filo de Azófar ataque mientras controlas dos o más artefactos, obtiene +2/+1 hasta el final del turno.\', \'type\': \'Criatura — Pirata orco\', \'flavor\': \'"El secreto está en los pies... y en la segunda espada".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637487&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dfaeab3b-7745-4f97-97fb-84fa7184cade\', \'multiverseId\': 637487}, \'multiverseid\': 637487}, {\'name\': "Maître d\'épée intrépide", \'text\': "À chaque fois que le Maître d\'épée intrépide attaque pendant que vous contrôlez au moins deux artefacts, il gagne +2/+1 jusqu\'à la fin du tour.", \'type\': \'Créature — orque et pirate\', \'flavor\': "« Le secret, c\'est le jeu de jambes. Et une épée supplémentaire. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637808&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e24e0bd2-5533-4ed5-8531-f8cd85ed5c43\', \'multiverseId\': 637808}, \'multiverseid\': 637808}, {\'name\': \'Maestro di Spada Audace\', \'text\': \'Ogniqualvolta il Maestro di Spada Audace attacca mentre controlli due o più artefatti, prende +2/+1 fino alla fine del turno.\', \'type\': \'Creatura — Pirata Orco\', \'flavor\': \'"Il segreto è il gioco di gambe. E una spada in più."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638129&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2b033149-3904-46e3-a85d-5a810ff5c38e\', \'multiverseId\': 638129}, \'multiverseid\': 638129}, {\'name\': \'鉄面連合の刃使い\', \'text\': \'あなたが２つ以上のアーティファクトをコントロールしている間に鉄面連合の刃使いが攻撃するたび、ターン終了時まで、これは＋２/＋１の修整を受ける。\', \'type\': \'クリーチャー — オーク・海賊\', \'flavor\': \'「肝心なのはフットワークだ。あともう一本の剣を持つこと。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638450&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cc49316a-248f-444a-ab7d-064d126ee5b0\', \'multiverseId\': 638450}, \'multiverseid\': 638450}, {\'name\': \'Espadachim-mestre Brônzeo\', \'text\': \'Toda vez que Espadachim-mestre Brônzeo ataca enquanto você controla dois ou mais artefatos, ele recebe +2/+1 até o final do turno.\', \'type\': \'Criatura — Orc Pirata\', \'flavor\': \'"O segredo está no jogo de pés. Mais uma espada extra."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638771&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a2cfa018-bdf3-436e-8af1-5b43c9aa9f3c\', \'multiverseId\': 638771}, \'multiverseid\': 638771}, {\'name\': \'莽霸大剑师\', \'text\': \'每当莽霸大剑师于你操控两个或更多神器时攻击，它得+2/+1直到回合结束。\', \'type\': \'生物 — 半兽人／海盗\', \'flavor\': \'「秘诀在于脚下步法。外加多带一把剑。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639092&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ac1bffa6-af81-442a-99bf-20745fd81d8c\', \'multiverseId\': 639092}, \'multiverseid\': 639092}]', '[{\'name\': \'Totenklage der Vergessenen\', \'text\': \'Abstieg 8 — Bestimme eines. Falls dein Friedhof acht oder mehr Permanent-Karten enthält, sowie du diesen Zauberspruch wirkst, bestimme stattdessen eines oder mehrere.\\n• Bringe ein Nichtland-Permanent deiner Wahl auf die Hand seines Besitzers zurück.\\n• Ein Gegner deiner Wahl wirft eine Karte ab.\\n• Schaue dir die obersten drei Karten deiner Bibliothek an. Nimm eine davon auf deine Hand und lege den Rest auf deinen Friedhof.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637286&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bd678287-23fe-4725-b631-612430d6372f\', \'multiverseId\': 637286}, \'multiverseid\': 637286}, {\'name\': \'Lamento de los olvidados\', \'text\': \'Descender 8 — Elige uno. Si hay ocho o más cartas de permanente en tu cementerio al lanzar este hechizo, en vez de eso, elige uno o más.\\n• Regresa el permanente objetivo que no sea tierra a la mano de su propietario.\\n• El oponente objetivo descarta una carta.\\n• Mira las tres primeras cartas de tu biblioteca. Pon una de ellas en tu mano y el resto en tu cementerio.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637607&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'aa209fb1-b454-45c7-b8c8-9bef62092ac0\', \'multiverseId\': 637607}, \'multiverseid\': 637607}, {\'name\': \'Gémissement des oubliés\', \'text\': "Descente 8 — Choisissez l\'un. S\'il y a au moins huit cartes de permanent dans votre cimetière au moment où vous lancez ce sort, choisissez au moins un à la place.\\n• Renvoyez un permanent non-terrain ciblé dans la main de son propriétaire.\\n• Un adversaire ciblé se défausse d\'une carte.\\n• Regardez les trois cartes du dessus de votre bibliothèque. Mettez l\'une d\'elles dans votre main et le reste dans votre cimetière.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637928&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c4bb43d0-947e-4f18-8fa1-a14f0b244f10\', \'multiverseId\': 637928}, \'multiverseid\': 637928}, {\'name\': \'Lamento dei Dimenticati\', \'text\': \'Discesa 8 — Scegli uno. Se ci sono otto o più carte permanente nel tuo cimitero mentre lanci questa magia, scegli invece uno o più.\\n• Fai tornare un permanente non terra bersaglio in mano al suo proprietario.\\n• Un avversario bersaglio scarta una carta.\\n• Guarda le prime tre carte del tuo grimorio. Aggiungine una alla tua mano e metti le altre nel tuo cimitero.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638249&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2ef11243-a13f-49e6-b992-4f4c7f4b02af\', \'multiverseId\': 638249}, \'multiverseid\': 638249}, {\'name\': \'忘れられた者たちの壁\', \'text\': \'落魄８ ― 以下から１つを選ぶ。この呪文を唱えるに際してあなたの墓地に８枚以上のパーマネント・カードがあるなら、代わりに以下から１つ以上を選ぶ。\\n・土地でないパーマネント１つを対象とする。それをオーナーの手札に戻す。\\n・対戦相手１人を対象とする。そのプレイヤーはカード１枚を捨てる。\\n・あなたのライブラリーの一番上にあるカード３枚を見る。そのうち１枚をあなたの手札に、残りをあなたの墓地に置く。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638570&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0a88d327-5abd-440f-83a0-946dcac2a87e\', \'multiverseId\': 638570}, \'multiverseid\': 638570}, {\'name\': \'Lamúria dos Esquecidos\', \'text\': \'Descer 8 — Escolha um. Se houver oito ou mais cards de permanente em seu cemitério conforme você conjurar esta mágica, em vez disso, escolha um ou mais.\\n• Devolva a permanente alvo não de terreno à mão de seu dono.\\n• O oponente alvo descarta um card.\\n• Olhe os três cards do topo de seu grimório. Coloque um deles em sua mão e o restante em seu cemitério.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638891&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4d3efb96-c3ae-45ad-aef7-3edee13e260c\', \'multiverseId\': 638891}, \'multiverseid\': 638891}, {\'name\': \'遗世者厉嚎\', \'text\': \'落坟8～选择一项。如果于你施放此咒语时你坟墓场中有八张或更多永久物牌，则改为选择一项或多项。\\n•将目标非地永久物移回其拥有者手上。\\n•目标对手弃一张牌。\\n•检视你牌库顶的三张牌。将其中一张置于你手上，其余则置入你的坟墓场。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639212&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f2a8fd50-a980-415c-a9d4-266c849a64be\', \'multiverseId\': 639212}, \'multiverseid\': 639212}]', '[{\'name\': \'Totenklage der Vergessenen\', \'text\': \'Abstieg 8 — Bestimme eines. Falls dein Friedhof acht oder mehr Permanent-Karten enthält, sowie du diesen Zauberspruch wirkst, bestimme stattdessen eines oder mehrere.\\n• Bringe ein Nichtland-Permanent deiner Wahl auf die Hand seines Besitzers zurück.\\n• Ein Gegner deiner Wahl wirft eine Karte ab.\\n• Schaue dir die obersten drei Karten deiner Bibliothek an. Nimm eine davon auf deine Hand und lege den Rest auf deinen Friedhof.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639290&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ecb029af-0ca1-45a3-9fb6-4abab062e985\', \'multiverseId\': 639290}, \'multiverseid\': 639290}, {\'name\': \'Lamento de los olvidados\', \'text\': \'Descender 8 — Elige uno. Si hay ocho o más cartas de permanente en tu cementerio al lanzar este hechizo, en vez de eso, elige uno o más.\\n• Regresa el permanente objetivo que no sea tierra a la mano de su propietario.\\n• El oponente objetivo descarta una carta.\\n• Mira las tres primeras cartas de tu biblioteca. Pon una de ellas en tu mano y el resto en tu cementerio.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639310&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'278cccf5-25fa-4660-962a-b3f839be7794\', \'multiverseId\': 639310}, \'multiverseid\': 639310}, {\'name\': \'Gémissement des oubliés\', \'text\': "Descente 8 — Choisissez l\'un. S\'il y a au moins huit cartes de permanent dans votre cimetière au moment où vous lancez ce sort, choisissez au moins un à la place.\\n• Renvoyez un permanent non-terrain ciblé dans la main de son propriétaire.\\n• Un adversaire ciblé se défausse d\'une carte.\\n• Regardez les trois cartes du dessus de votre bibliothèque. Mettez l\'une d\'elles dans votre main et le reste dans votre cimetière.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639330&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7ac8d2f1-6f37-4091-9fa4-c72161393a93\', \'multiverseId\': 639330}, \'multiverseid\': 639330}, {\'name\': \'Lamento dei Dimenticati\', \'text\': \'Discesa 8 — Scegli uno. Se ci sono otto o più carte permanente nel tuo cimitero mentre lanci questa magia, scegli invece uno o più.\\n• Fai tornare un permanente non terra bersaglio in mano al suo proprietario.\\n• Un avversario bersaglio scarta una carta.\\n• Guarda le prime tre carte del tuo grimorio. Aggiungine una alla tua mano e metti le altre nel tuo cimitero.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639350&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'77a52c86-7476-440b-b7e0-a09fc42dfe42\', \'multiverseId\': 639350}, \'multiverseid\': 639350}, {\'name\': \'忘れられた者たちの嘆き\', \'text\': \'落魄８ ― 以下から１つを選ぶ。この呪文を唱えるに際してあなたの墓地に８枚以上のパーマネント・カードがあるなら、代わりに以下から１つ以上を選ぶ。\\n・土地でないパーマネント１つを対象とする。それをオーナーの手札に戻す。\\n・対戦相手１人を対象とする。そのプレイヤーはカード１枚を捨てる。\\n・あなたのライブラリーの一番上にあるカード３枚を見る。そのうち１枚をあなたの手札に、残りをあなたの墓地に置く。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639370&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ccf6caa7-02db-461b-96b2-d6063739b4cf\', \'multiverseId\': 639370}, \'multiverseid\': 639370}, {\'name\': \'Lamúria dos Esquecidos\', \'text\': \'Descer 8 — Escolha um. Se houver oito ou mais cards de permanente em seu cemitério conforme você conjurar esta mágica, em vez disso, escolha um ou mais.\\n• Devolva a permanente alvo não de terreno à mão de seu dono.\\n• O oponente alvo descarta um card.\\n• Olhe os três cards do topo de seu grimório. Coloque um deles em sua mão e o restante em seu cemitério.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639390&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8fb00790-368e-4544-a79c-ff816565825a\', \'multiverseId\': 639390}, \'multiverseid\': 639390}, {\'name\': \'遗世者厉嚎\', \'text\': \'落坟8～选择一项。如果于你施放此咒语时你坟墓场中有八张或更多永久物牌，则改为选择一项或多项。\\n•将目标非地永久物移回其拥有者手上。\\n•目标对手弃一张牌。\\n•检视你牌库顶的三张牌。将其中一张置于你手上，其余则置入你的坟墓场。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639410&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2cbab76e-1d60-4a45-ae93-b2f3b8c5bb1b\', \'multiverseId\': 639410}, \'multiverseid\': 639410}]', '[{\'name\': \'Totes Gewicht\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur erhält -2/-2.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Die angeheuerten Goblins waren nicht wie versprochen ihr Gewicht in Gold wert.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637124&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'764d8db0-0c57-4444-9c6c-c29c40e7d6e3\', \'multiverseId\': 637124}, \'multiverseid\': 637124}, {\'name\': \'Peso muerto\', \'text\': \'Encantar criatura.\\nLa criatura encantada obtiene -2/-2.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'Le dijeron que los trasgos que contrató valían su peso en oro. No fue así.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637445&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4f283cc5-53ed-4ffa-bc07-3b55a5c8828b\', \'multiverseId\': 637445}, \'multiverseid\': 637445}, {\'name\': \'Poids mort\', \'text\': \'Enchanter : créature\\nLa créature enchantée gagne -2/-2.\', \'type\': \'Enchantement — aura\', \'flavor\': "Les gobelins engagés ne valaient pas leur pesant d\'or, contrairement à ce qui avait été dit.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637766&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5dcb72cc-bcb0-4c3f-8cc2-b63bcf60ac3d\', \'multiverseId\': 637766}, \'multiverseid\': 637766}, {\'name\': \'Peso Morto\', \'text\': \'Incanta creatura\\nLa creatura incantata prende -2/-2.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'I goblin mercenari, a dispetto delle loro promesse, non valevano il loro peso in oro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638087&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d43c5510-e1a9-4933-8aa1-f70c2b4a8b46\', \'multiverseId\': 638087}, \'multiverseid\': 638087}, {\'name\': \'死の重み\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントしているクリーチャーは－２/－２の修整を受ける。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'雇われゴブリン達に宣伝通りの価値は無いようだった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638408&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5de0c6a5-e987-474d-a5f1-c2381726f9e5\', \'multiverseId\': 638408}, \'multiverseid\': 638408}, {\'name\': \'Peso Morto\', \'text\': \'Encantar criatura\\nA criatura encantada recebe -2/-2.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'Os goblins contratados não valiam, como anunciado, o próprio peso em ouro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638729&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0c8a88db-2ec7-4553-8282-fab3b82e77dc\', \'multiverseId\': 638729}, \'multiverseid\': 638729}, {\'name\': \'重负\', \'text\': \'结附于生物\\n所结附的生物得-2/-2。\', \'type\': \'结界 — 灵气\', \'flavor\': \'雇来的鬼怪并不像他们吹嘘的那样，值得搭上等重的金子。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639050&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'40437e92-2362-4d5c-a69f-87636ef3aecf\', \'multiverseId\': 639050}, \'multiverseid\': 639050}]', "[{'name': 'Treasure Map // Treasure Cove', 'text': '(Transformierte Schatzkarte.)\\n{T}: Erzeuge {C}.\\n{T}, opfere einen Schatz: Ziehe eine Karte.', 'type': 'Land', 'flavor': None, 'faceName': 'Treasure Cove', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637312&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'ebda3a15-c4cb-41f3-b2b8-1fa6866ca38b', 'multiverseId': 637312}, 'multiverseid': 637312}, {'name': 'Treasure Map // Treasure Cove', 'text': '(Se transforma del Mapa del tesoro.)\\n{T}: Agrega {C}.\\n{T}, sacrificar un Tesoro: Roba una carta.', 'type': 'Tierra', 'flavor': None, 'faceName': 'Treasure Cove', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637633&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '7e7ae8cf-2b11-4ed1-baa6-64e6ad70572d', 'multiverseId': 637633}, 'multiverseid': 637633}, {'name': 'Treasure Map // Treasure Cove', 'text': '(Transformation de la Carte au trésor.)\\n{T} : Ajoutez {C}.\\n{T}, sacrifiez un trésor : Piochez une carte.', 'type': 'Terrain', 'flavor': None, 'faceName': 'Treasure Cove', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637954&type=card', 'language': 'French', 'identifiers': {'scryfallId': '6ef7f898-0739-477d-84cc-1e9dfcdca16b', 'multiverseId': 637954}, 'multiverseid': 637954}, {'name': 'Treasure Map // Treasure Cove', 'text': '(Si trasforma dalla Mappa del Tesoro.)\\n{T}: Aggiungi {C}.\\n{T}, Sacrifica un Tesoro: Pesca una carta.', 'type': 'Terra', 'flavor': None, 'faceName': 'Treasure Cove', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638275&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '8f89881c-77a5-437d-abe9-3bc7f37dc91a', 'multiverseId': 638275}, 'multiverseid': 638275}, {'name': 'Treasure Map // Treasure Cove', 'text': '（宝物の地図から変身する。）\\n{T}：{C}を加える。\\n{T}, 宝物１つを生け贄に捧げる：カード１枚を引く。', 'type': '土地', 'flavor': None, 'faceName': 'Treasure Cove', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638596&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '7d6ab8d8-e467-46e6-8980-334b63bbdd55', 'multiverseId': 638596}, 'multiverseid': 638596}, {'name': 'Treasure Map // Treasure Cove', 'text': '(Transformação de Mapa do Tesouro.)\\n{T}: Adicione {C}.\\n{T}, sacrifique um Tesouro: Compre um card.', 'type': 'Terreno', 'flavor': None, 'faceName': 'Treasure Cove', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638917&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fd04185b-76db-4519-ba29-682221bccaa5', 'multiverseId': 638917}, 'multiverseid': 638917}, {'name': 'Treasure Map // Treasure Cove', 'text': '（由藏宝图转化。）\\n{T}：加{C}。\\n{T}，牺牲一个珍宝：抓一张牌。', 'type': '地', 'flavor': None, 'faceName': 'Treasure Cove', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639238&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '4ef948c8-c293-4c70-badd-87434a807bd2', 'multiverseId': 639238}, 'multiverseid': 639238}]", '[{\'name\': \'Treasure Map // Treasure Cove\', \'text\': \'{1}, {T}: Hellsicht 1. Lege eine Orientierungsmarke auf die Schatzkarte. Falls dann drei oder mehr Orientierungsmarken auf ihr liegen, entferne die Marken, transformiere die Schatzkarte und erzeuge drei Schatz-Spielsteine. (Sie sind Artefakte mit „{T}, opfere dieses Artefakt: Erzeuge ein Mana einer beliebigen Farbe.")\', \'type\': \'Artefakt\', \'flavor\': None, \'faceName\': \'Treasure Map\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637312&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ebda3a15-c4cb-41f3-b2b8-1fa6866ca38b\', \'multiverseId\': 637312}, \'multiverseid\': 637312}, {\'name\': \'Treasure Map // Treasure Cove\', \'text\': \'{1}, {T}: Adivina 1. Pon un contador de señal sobre el Mapa del tesoro. Luego, si hay tres o más contadores de señal sobre él, remueve esos contadores, transforma el Mapa del tesoro y crea tres fichas de Tesoro. (Son artefactos con "{T}, sacrificar este artefacto: Agrega un maná de cualquier color".)\', \'type\': \'Artefacto\', \'flavor\': None, \'faceName\': \'Treasure Map\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637633&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7e7ae8cf-2b11-4ed1-baa6-64e6ad70572d\', \'multiverseId\': 637633}, \'multiverseid\': 637633}, {\'name\': \'Treasure Map // Treasure Cove\', \'text\': "{1}, {T} : Regard 1. Mettez un marqueur « repère » sur la Carte au trésor. Puis, s\'il y a au moins trois marqueurs « repère » sur elle, retirez ces marqueurs, transformez la Carte au trésor, et créez trois jetons Trésor. (Ce sont des artefacts avec « {T}, sacrifiez cet artefact : Ajoutez un mana de la couleur de votre choix. »)", \'type\': \'Artefact\', \'flavor\': None, \'faceName\': \'Treasure Map\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637954&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6ef7f898-0739-477d-84cc-1e9dfcdca16b\', \'multiverseId\': 637954}, \'multiverseid\': 637954}, {\'name\': \'Treasure Map // Treasure Cove\', \'text\': \'{1}, {T}: Profetizza 1. Metti un segnalino orientamento sulla Mappa del Tesoro. Poi, se ci sono tre o più segnalini orientamento su di essa, rimuovi quei segnalini, trasforma la Mappa del Tesoro e crea tre pedine Tesoro. (Sono artefatti con "{T}, Sacrifica questo artefatto: Aggiungi un mana di un qualsiasi colore".)\', \'type\': \'Artefatto\', \'flavor\': None, \'faceName\': \'Treasure Map\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638275&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8f89881c-77a5-437d-abe9-3bc7f37dc91a\', \'multiverseId\': 638275}, \'multiverseid\': 638275}, {\'name\': \'Treasure Map // Treasure Cove\', \'text\': \'{1}, {T}：占術１を行う。宝物の地図の上に目印カウンター１個を置く。その後、これの上に３個以上の目印カウンターがあるなら、それらのカウンターを取り除き、宝物の地図を変身させ、宝物・トークン３つを生成する。（それらは、「{T}, このアーティファクトを生け贄に捧げる：好きな色１色のマナ１点を加える。」を持つアーティファクトである。）\', \'type\': \'アーティファクト\', \'flavor\': None, \'faceName\': \'Treasure Map\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638596&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7d6ab8d8-e467-46e6-8980-334b63bbdd55\', \'multiverseId\': 638596}, \'multiverseid\': 638596}, {\'name\': \'Treasure Map // Treasure Cove\', \'text\': \'{1}, {T}: Vidência 1. Coloque um marcador de marco em Mapa do Tesouro. Depois, se houver três ou mais marcadores de marco nele, remova aqueles marcadores, transforme Mapa do Tesouro e crie três fichas de Tesouro. (Elas são artefatos com "{T}, sacrifique este artefato: Adicione um mana de qualquer cor".)\', \'type\': \'Artefato\', \'flavor\': None, \'faceName\': \'Treasure Map\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638917&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fd04185b-76db-4519-ba29-682221bccaa5\', \'multiverseId\': 638917}, \'multiverseid\': 638917}, {\'name\': \'Treasure Map // Treasure Cove\', \'text\': \'{1}，{T}：占卜1。在藏宝图上放置一个地标指示物。然后如果其上有三个或更多地标指示物，则移去这些指示物，转化藏宝图，并派出三个珍宝衍生物。（它们是具有「{T}，牺牲此神器：加一点任意颜色的法术力」的神器。）\', \'type\': \'神器\', \'flavor\': None, \'faceName\': \'Treasure Map\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639238&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4ef948c8-c293-4c70-badd-87434a807bd2\', \'multiverseId\': 639238}, \'multiverseid\': 639238}]', '[{\'name\': \'Treibsandstrudel\', \'text\': \'Dieser Zauberspruch kostet beim Wirken {3} weniger, falls er eine getappte Kreatur als Ziel hat.\\nSchicke eine Kreatur deiner Wahl ins Exil.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Jene, die nach dem Blut und Atem der Lebenden trachten, werden ihren Durst mit Sand stillen."\\n—König Okinec Ahau\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637045&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'33aff739-49f9-451e-b9d6-8d382c323169\', \'multiverseId\': 637045}, \'multiverseid\': 637045}, {\'name\': \'Remolino de arenas movedizas\', \'text\': \'Te cuesta {3} menos lanzar este hechizo si hace objetivo a una criatura girada.\\nExilia la criatura objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Los que arrebatan la sangre y aliento de los vivos beberán arena hasta saciarse".\\n—Okinec Ahau, soberano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637366&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4a236f51-b287-434b-88f8-6015b8887fc9\', \'multiverseId\': 637366}, \'multiverseid\': 637366}, {\'name\': \'Tourbillon de sables mouvants\', \'text\': "Ce sort coûte {3} de moins à lancer s\'il cible une créature engagée.\\nExilez une créature ciblée.", \'type\': \'Éphémère\', \'flavor\': \'« Ceux qui volent le sang et le souffle des vivants se gorgeront de sable. »\\n—Souverain Okinec Ahau\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637687&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0f477b05-6ea2-4d5e-8ef7-a6d749a08faa\', \'multiverseId\': 637687}, \'multiverseid\': 637687}, {\'name\': \'Vortice di Sabbie Mobili\', \'text\': \'Questa magia costa {3} in meno per essere lanciata se bersaglia una creatura TAPpata.\\nEsilia una creatura bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Coloro che sottraggono il sangue e il respiro dei vivi, siano sfamati con la sabbia."\\n—Sovrano Okinec Ahau\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638008&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3ddf1c64-ebe2-488a-b839-025f9766524f\', \'multiverseId\': 638008}, \'multiverseid\': 638008}, {\'name\': \'流砂の渦巻き\', \'text\': \'この呪文がタップ状態のクリーチャーを対象とするなら、この呪文を唱えるためのコストは{3}少なくなる。\\nクリーチャー１体を対象とする。それを追放する。\', \'type\': \'インスタント\', \'flavor\': \'「生ける者の血と息を奪うものは、砂を飲まされることになるだろう。」\\n――君主のオキネク・アハウ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638329&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b8c13671-fa12-4614-9233-b5a8c54876b0\', \'multiverseId\': 638329}, \'multiverseid\': 638329}, {\'name\': \'Redemoinho de Areia Movediça\', \'text\': \'Esta mágica custa {3} a menos para ser conjurada se tiver como alvo uma criatura virada.\\nExile a criatura alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Os que roubariam o sangue e o alento dos vivos beberão sua porção das areias."\\n— Soberano Okinec Ahau\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638650&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'227c74db-6b02-4c69-a4d8-4435e11763c1\', \'multiverseId\': 638650}, \'multiverseid\': 638650}, {\'name\': \'流沙漩涡\', \'text\': \'如果此咒语以已横置的生物为目标，则它减少{3}来施放。\\n放逐目标生物。\', \'type\': \'瞬间\', \'flavor\': \'「对于那些窃取生者血液与呼吸的家伙来说，饮尽黄砂才是他们的归途。」\\n～豹王欧奇尼亚豪\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638971&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bb75c575-eff7-426c-9e54-023e8db835db\', \'multiverseId\': 638971}, \'multiverseid\': 638971}]', '[{\'name\': \'Triumphierender Biss\', \'text\': \'Der Triumphierende Biss fügt einer Kreatur deiner Wahl X Schadenspunkte zu, wobei X gleich 2 oder die größten Stärke unter den Dinosauriern ist, die du kontrollierst, je nachdem, welche Zahl größer ist.\', \'type\': \'Hexerei\', \'flavor\': \'Aufgrund ihrer knusprigen Schale und dem saftigen Inneren wurden Höhlenkrabbler schnell zur Lieblingsleckerei der Dinosauriergefährten des Imperiums der Sonne.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637205&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2f143e12-0276-4b24-8113-b533ac805b6f\', \'multiverseId\': 637205}, \'multiverseid\': 637205}, {\'name\': \'Dentellada triunfal\', \'text\': \'La Dentellada triunfal hace una cantidad de daño a la criatura objetivo igual a 2 o a la mayor fuerza entre los Dinosaurios que controlas, lo que sea mayor.\', \'type\': \'Conjuro\', \'flavor\': \'Los insectos de las cuevas se convirtieron rápidamente en uno de los tentempiés preferidos de los dinosaurios del Imperio del Sol por sus caparazones crujientes y su interior jugoso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637526&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b822f073-0ec7-4332-b7eb-03143a95da2c\', \'multiverseId\': 637526}, \'multiverseid\': 637526}, {\'name\': \'Morsure triomphale\', \'text\': \'La Morsure triomphale inflige à une créature ciblée un nombre de blessures égal à 2 ou à la force la plus élevée parmi les dinosaures que vous contrôlez, selon le plus élevé des deux.\', \'type\': \'Rituel\', \'flavor\': "Avec leur carapace croquante et leur chair bien juteuse, les rampeurs des cavernes devinrent rapidement l\'encas préféré des compagnons dinosaures de l\'Empire du Soleil.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637847&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0f55f896-0261-4fa0-adb5-9eb2629361b6\', \'multiverseId\': 637847}, \'multiverseid\': 637847}, {\'name\': \'Morso Trionfante\', \'text\': \'Il Morso Trionfante infligge a una creatura bersaglio danno pari a 2 o alla forza maggiore tra i Dinosauri che controlli, a seconda di quale numero sia maggiore.\', \'type\': \'Stregoneria\', \'flavor\': "Con carapaci croccanti e interiora succose, i brulicaverne divennero presto lo spuntino preferito dei dinosauri alleati dell\'Impero del Sole.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638168&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8ffad902-3938-424f-a06f-c762d7f9c95b\', \'multiverseId\': 638168}, \'multiverseid\': 638168}, {\'name\': \'勝利の嚙み砕き\', \'text\': \'クリーチャー１体を対象とする。勝利の噛み砕きはそれに、あなたがコントロールしている恐竜の中のパワーの最大値と２のうち大きいほうに等しい点数のダメージを与える。\', \'type\': \'ソーサリー\', \'flavor\': \'洞窟を這うものは硬い甲羅と瑞々しい臓物を持ち、太陽帝国が引き連れている恐竜にとってお気に入りの間食となった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638489&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2ded5e9f-012b-449e-86bd-c1c669776698\', \'multiverseId\': 638489}, \'multiverseid\': 638489}, {\'name\': \'Nhoc Triunfante\', \'text\': \'Nhoc Triunfante causa à criatura alvo dano igual a 2 ou ao maior poder entre os dos Dinossauros que você controla, o que for maior.\', \'type\': \'Feitiço\', \'flavor\': \'Com cascos crocantes e entranhas suculentas, as lacraias das cavernas se tornaram rapidamente um dos lanchinhos favoritos dos dinossauros do Império do Sol.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638810&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4beb92cd-6d9d-4c03-bf40-6721b179db1b\', \'multiverseId\': 638810}, \'multiverseid\': 638810}, {\'name\': \'得胜撕咬\', \'text\': \'得胜撕咬对目标生物造成伤害，其数量等同于2与「由你操控之恐龙中的最大力量」两者间较大者。\', \'type\': \'法术\', \'flavor\': \'洞窟爬虫外壳酥脆、内脏多汁，很快就成了烈阳帝国恐龙行伴的最爱点心。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639131&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a6435339-c869-4f04-a471-b50af206146e\', \'multiverseId\': 639131}, \'multiverseid\': 639131}]', '[{\'name\': \'Uchbenbak, das Große Malheur\', \'text\': \'Wachsamkeit, Bedrohlich\\nAbstieg 8 — {4}{U}{B}: Bringe Uchbenbak, das Große Malheur, aus deinem Friedhof mit einer Endgültigkeitsmarke ins Spiel zurück. Aktiviere diese Fähigkeit nur, falls dein Friedhof acht oder mehr Permanent-Karten enthält, und nur wie eine Hexerei. (Falls eine Kreatur mit Endgültigkeitsmarke sterben würde, schicke sie stattdessen ins Exil.)\', \'type\': \'Legendäre Kreatur — Skelett, Schrecken\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637284&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'761e77ca-6afe-48b7-b381-9da580863009\', \'multiverseId\': 637284}, \'multiverseid\': 637284}, {\'name\': \'Uchbenbak, el Gran Error\', \'text\': \'Vigilancia, amenaza.\\nDescender 8 — {4}{U}{B}: Regresa a Uchbenbak, el Gran Error de tu cementerio al campo de batalla con un contador de consumación sobre él. Activa esto solo si hay ocho o más cartas de permanente en tu cementerio y solo como un conjuro. (Si una criatura con un contador de consumación sobre ella fuera a morir, en vez de eso, exíliala.)\', \'type\': \'Criatura legendaria — Horror esqueleto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637605&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d306e78c-589b-4304-a999-b47e3f0e3e5a\', \'multiverseId\': 637605}, \'multiverseid\': 637605}, {\'name\': \'Uchbenbak, la Grande erreur\', \'text\': "Vigilance, menace\\nDescente 8 — {4}{U}{B} : Renvoyez Uchbenbak, la Grande erreur sur le champ de bataille depuis votre cimetière avec un marqueur « fatalité » sur lui. N\'activez que s\'il y a au moins huit cartes de permanent dans votre cimetière et que lorsque vous pourriez lancer un rituel. (Si une créature avec un marqueur « fatalité » sur elle devait mourir, exilez-la à la place.)", \'type\': \'Créature légendaire — squelette et horreur\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637926&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3dee4535-8843-427f-9bb1-246cdced4e1b\', \'multiverseId\': 637926}, \'multiverseid\': 637926}, {\'name\': \'Uchbenbak, il Grande Errore\', \'text\': \'Cautela, minacciare\\nDiscesa 8 — {4}{U}{B}: Rimetti sul campo di battaglia Uchbenbak, il Grande Errore dal tuo cimitero con un segnalino finale. Attiva solo se ci sono otto o più carte permanente nel tuo cimitero e solo come una stregoneria. (Se una creatura con un segnalino finale sta per morire, invece esiliala.)\', \'type\': \'Creatura Leggendaria — Orrore Scheletro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638247&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a185f474-0cf2-46a1-a216-9ba599e461c7\', \'multiverseId\': 638247}, \'multiverseid\': 638247}, {\'name\': \'大いなる過ち、ウチベンバク\', \'text\': \'警戒、威迫\\n落魄８ ― {4}{U}{B}：あなたの墓地にある大いなる過ち、ウチベンバクを最終カウンター１個が置かれた状態で戦場に戻す。あなたの墓地に８枚以上のパーマネント・カードがなければ起動できず、起動はソーサリーとしてのみ行う。（最終カウンターが置かれているクリーチャーが死亡するなら、代わりにそれを追放する。）\', \'type\': \'伝説のクリーチャー — スケルトン・ホラー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638568&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3d3e5a4f-cb4d-48ca-9c0d-d7f31ed41e4a\', \'multiverseId\': 638568}, \'multiverseid\': 638568}, {\'name\': \'Uchbenbak, o Grande Engano\', \'text\': \'Vigilância, ameaçar\\nDescer 8 — {4}{U}{B}: Devolva Uchbenbak, o Grande Engano, de seu cemitério ao campo de batalha com um marcador de finalidade. Ative somente se houver oito ou mais cards de permanente em seu cemitério e somente como um feitiço. (Se uma criatura com marcador de finalidade morreria, em vez disso, exile-a.)\', \'type\': \'Criatura Lendária — Esqueleto Horror\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638889&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ba029a9d-d90d-4c59-b7ff-7fcf3c938028\', \'multiverseId\': 638889}, \'multiverseid\': 638889}, {\'name\': \'厄灾骨绷霸\', \'text\': \'警戒，威慑\\n落坟8～{4}{U}{B}：将厄灾骨绷霸从你的坟墓场移回战场，且上面有一个终命指示物。只能于你坟墓场中有八张或更多永久物牌时起动，且仅限法术时机。（如果其上有终命指示物的生物将死去，则改为放逐之。）\', \'type\': \'传奇生物 — 骷髅妖／惊惧兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639210&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c7e9f220-e746-4e95-b37e-e4553b9738f0\', \'multiverseId\': 639210}, \'multiverseid\': 639210}]', '[{\'name\': \'Uchbenbak, das Große Malheur\', \'text\': \'Wachsamkeit, Bedrohlich\\nAbstieg 8 — {4}{U}{B}: Bringe Uchbenbak, das Große Malheur, aus deinem Friedhof mit einer Endgültigkeitsmarke ins Spiel zurück. Aktiviere diese Fähigkeit nur, falls dein Friedhof acht oder mehr Permanent-Karten enthält, und nur wie eine Hexerei.\', \'type\': \'Legendäre Kreatur — Skelett, Schrecken\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636542&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8bda563a-dab1-4913-8937-23b415725187\', \'multiverseId\': 636542}, \'multiverseid\': 636542}, {\'name\': \'Uchbenbak, el Gran Error\', \'text\': \'Vigilancia, amenaza.\\nDescender 8 — {4}{U}{B}: Regresa a Uchbenbak, el Gran Error de tu cementerio al campo de batalla con un contador de consumación sobre él. Activa esto solo si hay ocho o más cartas de permanente en tu cementerio y solo como un conjuro.\', \'type\': \'Criatura legendaria — Horror esqueleto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636566&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e4339246-a631-4b73-81d0-3485cfb3a779\', \'multiverseId\': 636566}, \'multiverseid\': 636566}, {\'name\': \'Uchbenbak, la Grande erreur\', \'text\': "Vigilance, menace\\nDescente 8 — {4}{U}{B} : Renvoyez Uchbenbak, la Grande erreur sur le champ de bataille depuis votre cimetière avec un marqueur « fatalité » sur lui. N\'activez que s\'il y a au moins huit cartes de permanent dans votre cimetière et que lorsque vous pourriez lancer un rituel.", \'type\': \'Créature légendaire — squelette et horreur\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636590&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'971682c4-c23a-4db0-8442-c28bc29ceb63\', \'multiverseId\': 636590}, \'multiverseid\': 636590}, {\'name\': \'Uchbenbak, il Grande Errore\', \'text\': \'Cautela, minacciare\\nDiscesa 8 — {4}{U}{B}: Rimetti sul campo di battaglia Uchbenbak, il Grande Errore dal tuo cimitero con un segnalino finale. Attiva solo se ci sono otto o più carte permanente nel tuo cimitero e solo come una stregoneria.\', \'type\': \'Creatura Leggendaria — Orrore Scheletro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636614&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'62e34cfe-0c04-4216-995b-9c7c8c165d0f\', \'multiverseId\': 636614}, \'multiverseid\': 636614}, {\'name\': \'大いなる過ち、ウチベンバク\', \'text\': \'警戒、威迫\\n落魄８ ― {4}{U}{B}：あなたの墓地にある大いなる過ち、ウチベンバクを最終カウンター１個が置かれた状態で戦場に戻す。あなたの墓地に８枚以上のパーマネント・カードがなければ起動できず、起動はソーサリーとしてのみ行う。\', \'type\': \'伝説のクリーチャー — スケルトン・ホラー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636638&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'df2dc158-a03c-43e9-94d2-9738250dfd51\', \'multiverseId\': 636638}, \'multiverseid\': 636638}, {\'name\': \'Uchbenbak, o Grande Erro\', \'text\': \'Vigilância, ameaçar\\nDescer 8 — {4}{U}{B}: Devolva Uchbenbak, o Grande Erro, de seu cemitério ao campo de batalha com um marcador de finalidade. Ative somente se houver oito ou mais cards de permanente em seu cemitério e somente como um feitiço.\', \'type\': \'Criatura Lendária — Esqueleto Horror\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636662&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'819bf718-56ba-49af-b856-ad3dadfb353a\', \'multiverseId\': 636662}, \'multiverseid\': 636662}, {\'name\': \'厄灾骨绷霸\', \'text\': \'警戒，威慑\\n落坟8～{4}{U}{B}：将厄灾骨绷霸从你的坟墓场移回战场，且上面有一个终命指示物。只能于你坟墓场中有八张或更多永久物牌时起动，且仅限法术时机。\', \'type\': \'传奇生物 — 骷髅妖／惊惧兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636686&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6da575ee-8030-4f37-87a2-2fb335a6bf7f\', \'multiverseId\': 636686}, \'multiverseid\': 636686}]', "[{'name': 'Umkämpfter Spielball', 'text': 'Immer wenn dir Kampfschaden zugefügt wird, übernimmt der angreifende Spieler die Kontrolle über den Umkämpften Spielball und enttappt ihn.\\n{2}, {T}: Ziehe eine Karte und lege eine Punktemarke auf den Umkämpften Spielball. Falls dann fünf oder mehr Punktemarken auf ihm liegen, opfere ihn und erzeuge einen Schatz-Spielstein.', 'type': 'Artefakt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637293&type=card', 'language': 'German', 'identifiers': {'scryfallId': '153bb228-682a-4537-9725-b9c5fb54fc5d', 'multiverseId': 637293}, 'multiverseid': 637293}, {'name': 'Pelota disputada', 'text': 'Siempre que recibas daño de combate, el jugador atacante gana el control de la Pelota disputada y la endereza.\\n{2}, {T}: Roba una carta y pon un contador de punto sobre la Pelota disputada. Luego, si tiene cinco o más contadores de punto sobre ella, sacrifícala y crea una ficha de Tesoro.', 'type': 'Artefacto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637614&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd2f9bb1d-1870-48d2-9a5a-3a4518274332', 'multiverseId': 637614}, 'multiverseid': 637614}, {'name': 'Balle contestée', 'text': 'À chaque fois que vous subissez des blessures de combat, le joueur attaquant acquiert le contrôle de la Balle contestée et la dégage.\\n{2}, {T} : Piochez une carte et mettez un marqueur « point » sur la Balle contestée. Puis, si elle a au moins cinq marqueurs « point » sur elle, sacrifiez-la et créez un jeton Trésor.', 'type': 'Artefact', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637935&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'cb601c06-f530-46ec-bbef-d533b9b54372', 'multiverseId': 637935}, 'multiverseid': 637935}, {'name': 'Palla Decisiva Contestata', 'text': 'Ogniqualvolta ti viene inflitto danno da combattimento, il giocatore attaccante prende il controllo della Palla Decisiva Contestata e la STAPpa.\\n{2}, {T}: Pesca una carta e metti un segnalino punto sulla Palla Decisiva Contestata. Poi, se ha cinque o più segnalini punto, sacrificala e crea una pedina Tesoro.', 'type': 'Artefatto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638256&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '16f4c1c3-8670-424d-9959-9e07ab21eff0', 'multiverseId': 638256}, 'multiverseid': 638256}, {'name': '激戦の球', 'text': 'あなたが戦闘ダメージを受けるたび、攻撃プレイヤーは激戦の球のコントロールを得て、これをアンタップする。\\n{2}, {T}：カード１枚を引き、激戦の球の上に得点カウンター１個を置く。その後、これの上に５個以上の得点カウンターがあるなら、これを生け贄に捧げ、宝物・トークン１つを生成する。', 'type': 'アーティファクト', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638577&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '6bedcc25-bac6-4fba-bb24-381ce79a7d7d', 'multiverseId': 638577}, 'multiverseid': 638577}, {'name': 'Bola de Jogo Disputada', 'text': 'Toda vez que você sofre dano de combate, o jogador atacante ganha o controle de Bola de Jogo Disputada e a desvira.\\n{2}, {T}: Compre um card e coloque um marcador de ponto em Bola de Jogo Disputada. Depois, se ela tiver cinco ou mais marcadores de ponto, sacrifique-a e crie uma ficha de Tesouro.', 'type': 'Artefato', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638898&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '6619eb51-447d-4236-85b1-36185c6d8d17', 'multiverseId': 638898}, 'multiverseid': 638898}, {'name': '争竞赛球', 'text': '每当你受到战斗伤害时，攻击牌手获得争竞赛球的操控权并将它重置。\\n{2}，{T}：抓一张牌并在争竞赛球上放置一个得分指示物。然后如果其上有五个或更多得分指示物，则牺牲它并派出一个珍宝衍生物。', 'type': '神器', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639219&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'fc6af29b-f61c-447a-83bd-e26f2a1e4b0d', 'multiverseId': 639219}, 'multiverseid': 639219}]", '[{\'name\': \'Unglücklicher Sturz\', \'text\': \'Der Besitzer eines Artefakts oder einer Kreatur deiner Wahl legt es bzw. sie auf oder unter seine Bibliothek.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Die wichtigste Regel hier unten ist dieselbe wie auf See: Überprüfe deine Knoten immer zweimal."\\n—Kapitänin Lannery Storm\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637105&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cbc27233-caa4-4dbf-8f45-121b1c3c5477\', \'multiverseId\': 637105}, \'multiverseid\': 637105}, {\'name\': \'Caída desafortunada\', \'text\': \'El propietario del artefacto o criatura objetivo pone ese permanente en la parte superior o en el fondo de su biblioteca.\', \'type\': \'Instantáneo\', \'flavor\': \'"Aquí abajo, la primera regla es la misma que en el agua: comprueba siempre los nudos dos veces".\\n—Capitana Lannery Tempestad\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637426&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7ab24ef5-bd4c-4dd1-837a-8f6b93037812\', \'multiverseId\': 637426}, \'multiverseid\': 637426}, {\'name\': \'Chute malencontreuse\', \'text\': "Le propriétaire d\'une cible, artefact ou créature, la met au-dessus ou au-dessous de sa bibliothèque.", \'type\': \'Éphémère\', \'flavor\': "« Ici, la première règle est la même que sur l\'océan : vérifier par deux fois ses nœuds. »\\n—Capitaine Lanneray Tempeste", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637747&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ee91b38a-004b-4a09-bc83-696113ffaa56\', \'multiverseId\': 637747}, \'multiverseid\': 637747}, {\'name\': \'Caduta Sfortunata\', \'text\': \'Il proprietario di un artefatto o di una creatura bersaglio mette quel permanente in cima o in fondo al suo grimorio.\', \'type\': \'Istantaneo\', \'flavor\': \'"La prima regola quaggiù è la stessa di quando siamo per mare: controlla sempre due volte i tuoi nodi."\\n—Capitana Lannery Fendiburrasca\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638068&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8d225318-f6cf-4084-a3bd-c9d7cbbeadc7\', \'multiverseId\': 638068}, \'multiverseid\': 638068}, {\'name\': \'不運な落下\', \'text\': \'アーティファクトやクリーチャーである１つを対象とする。それのオーナーはそれを自分のライブラリーの一番上か一番下に置く。\', \'type\': \'インスタント\', \'flavor\': \'「ここでも海でも、まず最初に知っておくべきルールは変わらないよ。結び目がちゃんと縛られているか確認することさ。」\\n――風雲船長ラネリー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638389&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ef468ed4-6ecf-4760-8968-e737451f8e57\', \'multiverseId\': 638389}, \'multiverseid\': 638389}, {\'name\': \'Tombo Azarado\', \'text\': \'O dono do artefato ou da criatura alvo o coloca no topo ou no fundo do próprio grimório.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"A primeira regra aqui embaixo é a mesma que no mar: sempre verifique seus nós duas vezes."\\n— Capitã Lannery Tormenta\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638710&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3e94e688-1b47-431b-aa22-a202d55445c5\', \'multiverseId\': 638710}, \'multiverseid\': 638710}, {\'name\': \'不幸坠落\', \'text\': \'目标神器或生物的拥有者将它置于其牌库顶或牌库底。\', \'type\': \'瞬间\', \'flavor\': \'「地底下的首要规矩跟水面上一样：时刻复查绳结有没有绑好。」\\n～兰娜莉速腾船长\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639031&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6ab76d38-9ac0-48d9-a657-dc76c872127f\', \'multiverseId\': 639031}, \'multiverseid\': 639031}]', '[{\'name\': \'Unterirdischer Schoner\', \'text\': \'Immer wenn der Unterirdische Schoner angreift, erkundet eine Kreatur deiner Wahl, die ihn in diesem Zug bemannt hat.\\nBemannen 1\', \'type\': \'Artefakt — Fahrzeug\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639818&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'420827cd-97f4-4ea9-b9cb-80c566f6a63d\', \'multiverseId\': 639818}, \'multiverseid\': 639818}, {\'name\': \'Goélette souterraine\', \'text\': "À chaque fois que la Goélette souterraine attaque, une créature ciblée qui l\'a pilotée ce tour-ci explore.\\nPilotage 1", \'type\': \'Artefact — véhicule\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639869&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'20d8b049-eafb-4902-b89c-23bf0986c8f7\', \'multiverseId\': 639869}, \'multiverseid\': 639869}, {\'name\': \'地底のスクーナー船\', \'text\': \'地底のスクーナー船が攻撃するたび、このターンにこれに搭乗したクリーチャー１体を対象とする。それは探検を行う。\\n搭乗１\', \'type\': \'アーティファクト — 機体\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639920&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ea4d5b78-5a75-4fae-ba0f-9a08e30657f3\', \'multiverseId\': 639920}, \'multiverseid\': 639920}, {\'name\': \'地底纵帆船\', \'text\': \'每当地底纵帆船攻击时，令目标本回合中搭载它的生物勘察。\\n搭载1\', \'type\': \'神器 — 载具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639971&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'877253ea-31d0-42b1-b2cf-baa0d9f7b975\', \'multiverseId\': 639971}, \'multiverseid\': 639971}]', '[{\'name\': \'Unternehmenslustiger Lauser\', \'text\': \'Zu Beginn deines Endsegments und falls du in diesem Zug abgestiegen bist, erzeuge einen Schatz-Spielstein. (Du bist abgestiegen, falls eine Permanent-Karte von irgendwoher auf deinen Friedhof gelegt wurde.)\', \'type\': \'Kreatur — Goblin, Pirat\', \'flavor\': \'„Er hätte gewollt, dass ich es bekomme!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637180&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9f055bba-8c79-4770-a5ee-24a0f6dbb76d\', \'multiverseId\': 637180}, \'multiverseid\': 637180}, {\'name\': \'Bribón empeñoso\', \'text\': \'Al comienzo de tu paso final, si descendiste este turno, crea una ficha de Tesoro. (Descendiste si una carta de permanente fue a tu cementerio desde cualquier parte.)\', \'type\': \'Criatura — Pirata trasgo\', \'flavor\': \'"¡Él hubiera querido que me lo quedara!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637501&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'046e9114-e6ca-4754-98a0-70620fb9058a\', \'multiverseId\': 637501}, \'multiverseid\': 637501}, {\'name\': \'Chenapan entreprenant\', \'text\': "Au début de votre étape de fin, si vous êtes descendu ce tour-ci, créez un jeton Trésor. (Vous êtes descendu si une carte de permanent a été mise dans votre cimetière depuis n\'importe où.)", \'type\': \'Créature — gobelin et pirate\', \'flavor\': "« Il aurait voulu que je l\'aie ! »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637822&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2293ada9-f1f8-4fb3-83b2-90b7f124f7e7\', \'multiverseId\': 637822}, \'multiverseid\': 637822}, {\'name\': \'Mascalzone Intraprendente\', \'text\': "All\'inizio della tua sottofase finale, se sei sceso in questo turno, crea una pedina Tesoro. (Sei sceso se una carta permanente è stata messa nel tuo cimitero da qualsiasi zona.)", \'type\': \'Creatura — Pirata Goblin\', \'flavor\': \'"Avrebbe voluto che l\\\'avessi io!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638143&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'96545c6f-dc57-4041-888e-4ecebe1a9c43\', \'multiverseId\': 638143}, \'multiverseid\': 638143}, {\'name\': \'実業的な悪党\', \'text\': \'あなたの終了ステップの開始時に、このターンにあなたが落魄していた場合、宝物・トークン１つを生成する。（パーマネント・カードがいずこかからあなたの墓地に置かれたなら、あなたは落魄する。）\', \'type\': \'クリーチャー — ゴブリン・海賊\', \'flavor\': \'「あいつならきっと俺に譲ってくれたはずだ！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638464&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'238e6cc4-1400-4cdf-ad04-06772a4b9375\', \'multiverseId\': 638464}, \'multiverseid\': 638464}, {\'name\': \'Biltre Empreendedor\', \'text\': \'No início de sua etapa final, se você desceu neste turno, crie uma ficha de Tesouro. (Você desceu se um card de permanente foi colocado em seu cemitério vindo de qualquer lugar.)\', \'type\': \'Criatura — Goblin Pirata\', \'flavor\': \'"Ele ia querer que eu ficasse com isso!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638785&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3bc68e8e-5c36-441f-bfe0-4142457a8744\', \'multiverseId\': 638785}, \'multiverseid\': 638785}, {\'name\': \'雄心无赖\', \'text\': \'在你的结束步骤开始时，若你本回合中有落坟，则派出一个珍宝衍生物。（如果有永久物牌从任何区域进入你的坟墓场，便算作你有落坟。）\', \'type\': \'生物 — 鬼怪／海盗\', \'flavor\': \'「他肯定不希望我能得到这玩意！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639106&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b8ae536f-b047-4971-9360-57e7c5f7ebc6\', \'multiverseId\': 639106}, \'multiverseid\': 639106}]', '[{\'name\': \'Unterwelt-Blutjäger\', \'text\': \'Wenn der Unterwelt-Blutjäger ins Spiel kommt, opfert jeder Spieler zwei Kreaturen.\', \'type\': \'Kreatur — Schrecken\', \'flavor\': \'Seine Artgenossen überrannten einst ganze Zivilisationen, doch dann rissen sie sich ob ihres unbändigen Hungers gegenseitig in Stücke. Nur er blieb übrig.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637111&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ac1c7ff4-3499-42cc-a9d7-a67936680d1a\', \'multiverseId\': 637111}, \'multiverseid\': 637111}, {\'name\': \'Rastreacrúor abismal\', \'text\': \'Cuando el Rastreacrúor abismal entre al campo de batalla, cada jugador sacrifica dos criaturas.\', \'type\': \'Criatura — Horror\', \'flavor\': \'Antaño, su raza arrasó civilizaciones enteras, pero su hambre interminable los hizo despedazarse entre ellos. Ahora, solo queda él.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637432&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7b5c620e-5a5e-4fe7-ab86-67d45644d0dd\', \'multiverseId\': 637432}, \'multiverseid\': 637432}, {\'name\': "Pisteur d\'entrailles des abysses", \'text\': "Quand le Pisteur d\'entrailles des abysses arrive sur le champ de bataille, chaque joueur sacrifie deux créatures.", \'type\': \'Créature — horreur\', \'flavor\': "Autrefois, ses frères anéantissaient d\'entières civilisations, mais ils ont fini par tous s\'entretuer pour tenter de satisfaire leur faim insatiable. Il ne reste plus que lui.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637753&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'72423325-643b-49a9-8d2e-ae17b12dd634\', \'multiverseId\': 637753}, \'multiverseid\': 637753}, {\'name\': \'Inseguisangue Abissale\', \'text\': "Quando l\'Inseguisangue Abissale entra nel campo di battaglia, ogni giocatore sacrifica due creature.", \'type\': \'Creatura — Orrore\', \'flavor\': "I suoi simili hanno un tempo sopraffatto intere civiltà, ma la loro fame insaziabile li ha fatti rivoltare l\'uno contro l\'altro. Ora rimane solo lui.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638074&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'334f9e3f-f8dd-4355-972b-64dd53f1acd5\', \'multiverseId\': 638074}, \'multiverseid\': 638074}, {\'name\': \'深淵の暴虐忍び\', \'text\': \'深淵の暴虐忍びが戦場に出たとき、各プレイヤーはそれぞれクリーチャー２体を生け贄に捧げる。\', \'type\': \'クリーチャー — ホラー\', \'flavor\': \'その仲間はかつて文明の至るところに蔓延っていたが、底なしの飢餓により互いを引き裂き合った。いまやこいつが最後の一体である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638395&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ef5caa8d-3dcd-40b1-ba9d-773e3cbb8190\', \'multiverseId\': 638395}, \'multiverseid\': 638395}, {\'name\': \'Seguessangue Abissal\', \'text\': \'Quando Seguessangue Abissal entra no campo de batalha, cada jogador sacrifica duas criaturas.\', \'type\': \'Criatura — Horror\', \'flavor\': \'Sua espécie sobrepujou civilizações inteiras, mas acabou dilacerando a si mesma em sua fome inaplacável. Hoje resta apenas ele.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638716&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a1ddfcc4-ff44-4cae-84c2-a9093bad13f0\', \'multiverseId\': 638716}, \'multiverseid\': 638716}, {\'name\': \'深渊虐袭怪\', \'text\': \'当深渊虐袭怪进战场时，每位牌手各牺牲两个生物。\', \'type\': \'生物 — 惊惧兽\', \'flavor\': \'它的同族扫平了一切文明，却仍未能满足无尽饕欲而彼此相食。如今只剩它一个留存于世。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639037&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'634f06c8-5784-4851-83d9-8134a89b3c11\', \'multiverseId\': 639037}, \'multiverseid\': 639037}]', '[{\'name\': \'Urtümlicher Knabbler\', \'text\': \'Wenn der Urtümliche Knabbler stirbt, wende Entdeckung 3 an. (Schicke Karten oben von deiner Bibliothek ins Exil, bis du eine Nichtland-Karte mit Manabetrag 3 oder weniger ins Exil schickst. Wirke sie, ohne ihre Manakosten zu bezahlen, oder nimm sie auf deine Hand. Lege den Rest in zufälliger Reihenfolge unter die Bibliothek.)\', \'type\': \'Kreatur — Insekt, Schrecken\', \'flavor\': \'Höhlenkrabbler verschlingen alles von Pflanzen bis hin zu Felsen — am liebsten mögen sie jedoch Frischfleisch.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637140&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9212a4e3-fb39-4323-b008-2b44b92baae2\', \'multiverseId\': 637140}, \'multiverseid\': 637140}, {\'name\': \'Roedor primordial\', \'text\': \'Cuando el Roedor primordial muera, descubre 3. (Exilia cartas de la parte superior de tu biblioteca hasta que exilies una carta que no sea tierra con valor de maná de 3 o menos. Lánzala sin pagar su coste de maná o ponla en tu mano. Pon el resto en el fondo en un orden aleatorio.)\', \'type\': \'Criatura — Horror insecto\', \'flavor\': \'Los insectos de las cuevas lo devoran todo, desde la materia vegetal hasta las rocas, pero su alimento preferido es la carne fresca.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637461&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b3ea2c76-de37-4c21-a9d9-ffc1ea3f610a\', \'multiverseId\': 637461}, \'multiverseid\': 637461}, {\'name\': \'Dévoreur primordial\', \'text\': "Quand le Dévoreur primordial meurt, découvrez 3. (Exilez les cartes du dessus de votre bibliothèque jusqu\'à ce que vous exiliez une carte non-terrain avec une valeur de mana inférieure ou égale à 3. Lancez-la sans payer son coût de mana ou mettez-la dans votre main. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.)", \'type\': \'Créature — insecte et horreur\', \'flavor\': \'Les rampeurs des cavernes dévorent tout, des matières végétales à la pierre, mais ils préfèrent la viande fraîche.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637782&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'66f038de-c32b-4241-81d0-a09cef764973\', \'multiverseId\': 637782}, \'multiverseid\': 637782}, {\'name\': \'Masticatore Primordiale\', \'text\': \'Quando il Masticatore Primordiale muore, scopri 3. (Esilia carte dalla cima del tuo grimorio finché non esili una carta non terra con valore di mana pari o inferiore a 3. Lanciala senza pagare il suo costo di mana o aggiungila alla tua mano. Metti le altre in fondo in ordine casuale.)\', \'type\': \'Creatura — Orrore Insetto\', \'flavor\': \'I brulicaverne divorano ogni cosa, dalla materia vegetale alla solida roccia, ma prediligono la carne fresca.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638103&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2054737d-02b0-4a77-a89a-81d2d334b2ff\', \'multiverseId\': 638103}, \'multiverseid\': 638103}, {\'name\': \'始源の齧り虫\', \'text\': \'始源の齧り虫が死亡したとき、発見３を行う。（マナ総量が３以下であり土地でないカード１枚が追放されるまで、あなたのライブラリーの一番上から１枚ずつ追放していく。それをマナ・コストを支払うことなく唱えるか、あなたの手札に加える。残りをあなたのライブラリーの一番下に無作為の順番で置く。）\', \'type\': \'クリーチャー — 昆虫・ホラー\', \'flavor\': \'洞窟を這う生き物は、岩だろうが植物だろうが口にできるものなら何でも喰らうが、一番の好物は新鮮な肉である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638424&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1759fbf4-c407-428b-aa2f-2db8b814a41b\', \'multiverseId\': 638424}, \'multiverseid\': 638424}, {\'name\': \'Mascador Primordial\', \'text\': \'Quando Mascador Primordial morrer, descubra 3. (Exile cards do topo do seu grimório até exilar um card não de terreno com valor de mana igual ou inferior a 3. Conjure sem pagar o custo de mana ou coloque-o na sua mão. Coloque o restante no fundo do grimório em ordem aleatória.)\', \'type\': \'Criatura — Inseto Horror\', \'flavor\': \'Os rastejadores das cavernas devoram qualquer coisa, de vegetais à rocha sólida, mas preferem carne fresca.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638745&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6ed51c88-783c-40bb-ba10-18973af7ccf9\', \'multiverseId\': 638745}, \'multiverseid\': 638745}, {\'name\': \'原初啮骨虫\', \'text\': \'当原初啮骨虫死去时，倾探3。（从你的牌库顶开始放逐牌，直到放逐一张法术力值等于或小于3的非地牌为止。施放之且不需支付其法术力费用，或将之置于你手上。将其余的牌以随机顺序置于你牌库底。）\', \'type\': \'生物 — 昆虫／惊惧兽\', \'flavor\': \'虽然洞窟爬虫万物皆能食，植物岩石全不忌，但它们还是更喜欢鲜肉。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639066&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c2bf3c66-e0c9-45ad-a3d1-05c0a4d57a19\', \'multiverseId\': 639066}, \'multiverseid\': 639066}]', '[{\'name\': \'Urwurzel-Pilgerreise\', \'text\': \'Immer wenn ein oder mehrere Nichtspielstein-Meervölker, die du kontrollierst, getappt werden, erzeuge einen 1/1 blauen Meervolk-Kreaturenspielstein mit Fluchsicherheit.\', \'type\': \'Verzauberung\', \'flavor\': \'„Diese Glyphen sind mehr als nur Wegweiser. Sie erzählen eine Geschichte. Aber wird sie als Triumph oder Tragödie ausgehen?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639812&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7b5ea4f8-fcfb-4033-abe7-dd5805b53024\', \'multiverseId\': 639812}, \'multiverseid\': 639812}, {\'name\': \'Pèlerinage de Plongeracine\', \'text\': "À chaque fois qu\'au moins un ondin non-jeton que vous contrôlez devient engagé, créez un jeton de créature 1/1 bleue Ondin avec la défense talismanique.", \'type\': \'Enchantement\', \'flavor\': \'« Ces glyphes représentent bien plus que des balises ! Ils racontent une histoire au fur et à mesure. Mais se termine-t-elle par une célébration ou une tragédie ?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639863&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'078f4131-1ae4-48bb-a384-5512a989d71c\', \'multiverseId\': 639863}, \'multiverseid\': 639863}, {\'name\': \'深根の巡礼\', \'text\': \'あなたがコントロールしていてトークンでない１体以上のマーフォークがタップ状態になるたび、呪禁を持つ青の１/１のマーフォーク・クリーチャー・トークン１体を生成する。\', \'type\': \'エンチャント\', \'flavor\': \'「これら象形はただの旅路の印ではない！これはそれぞれ物語を語っているのだ。しかし、その結末は大団円だろうか、それとも悲劇だろうか？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639914&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7a9664c3-c3ba-4f90-af4f-fe5241d7f9e3\', \'multiverseId\': 639914}, \'multiverseid\': 639914}, {\'name\': \'繁根林朝圣\', \'text\': \'每当一个或数个由你操控且非衍生物的人鱼成为横置时，派出一个1/1蓝色，具辟邪异能的人鱼衍生生物。\', \'type\': \'结界\', \'flavor\': \'「这些雕符不只是路标！一路上的内容能够连成一段故事。但这结局究竟是喜是悲？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639965&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8948a595-95e4-4898-ae8e-8e654c31ff74\', \'multiverseId\': 639965}, \'multiverseid\': 639965}]', '[{\'name\': \'Vergessenes Monument\', \'text\': \'{T}: Erzeuge {C}.\\nAndere Höhlen, die du kontrollierst, haben „{T}, bezahle 1 Lebenspunkt: Erzeuge ein Mana einer beliebigen Farbe."\', \'type\': \'Land — Höhle\', \'flavor\': \'Die Komon Winaq hinterließen kaum schriftliche Aufzeichnungen, aber im Weltenkern ist ihr Handwerk allgegenwärtig.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637318&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f5a4e101-72e7-4c6e-92c0-d702d04d429b\', \'multiverseId\': 637318}, \'multiverseid\': 637318}, {\'name\': \'Monumento olvidado\', \'text\': \'{T}: Agrega {C}.\\nLas otras Cuevas que controlas tienen "{T}, pagar 1 vida: Agrega un maná de cualquier color".\', \'type\': \'Tierra — Cueva\', \'flavor\': \'Los komon winaq dejaron pocos escritos, pero sus elaboraciones se alzan con fuerza por todo el núcleo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637639&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'686542da-e583-4d13-a4a6-e88d623336f4\', \'multiverseId\': 637639}, \'multiverseid\': 637639}, {\'name\': \'Monument oublié\', \'text\': \'{T} : Ajoutez {C}.\\nLes autres cavernes que vous contrôlez ont « {T}, Payez 1 point de vie : Ajoutez un mana de la couleur de votre choix. »\', \'type\': \'Terrain — caverne\', \'flavor\': "Les Komon Winaq ne laissèrent que peu d\'écrits derrière eux, mais leur œuvre se dresse partout dans le Noyau.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637960&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ed342c51-3dbc-4cef-9528-08f4c45f9a71\', \'multiverseId\': 637960}, \'multiverseid\': 637960}, {\'name\': \'Monumento Dimenticato\', \'text\': \'{T}: Aggiungi {C}.\\nLe altre Caverne che controlli hanno "{T}, Paga 1 punto vita: Aggiungi un mana di un qualsiasi colore".\', \'type\': \'Terra — Caverna\', \'flavor\': \'I Komon Winaq si sono lasciati alle spalle poche testimonianze scritte, ma il loro artigianato persiste in tutto il Nucleo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638281&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9ce5007a-676d-463f-84e3-045e08a09b85\', \'multiverseId\': 638281}, \'multiverseid\': 638281}, {\'name\': \'忘れられた聖像\', \'text\': \'{T}：{C}を加える。\\nあなたがコントロールしていてこれでないすべての洞窟は「{T}, １点のライフを支払う：好きな色１色のマナ１点を加える。」を持つ。\', \'type\': \'土地 — 洞窟\', \'flavor\': \'コモン・ウィナクが書き記したものは少ないが、彼らの遺産は中心核内に色濃く残っている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638602&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'29ccea90-4cf6-4be0-a371-2bee3560fe5f\', \'multiverseId\': 638602}, \'multiverseid\': 638602}, {\'name\': \'Monumento Esquecido\', \'text\': \'{T}: Adicione {C}.\\nAs outras Cavernas que você controla têm "{T}, pague 1 ponto de vida: Adicione um mana de qualquer cor."\', \'type\': \'Terreno — Caverna\', \'flavor\': \'Os komon winaq deixaram poucos registros escritos, mas suas obras permanecem firmes e fortes por todo o Núcleo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638923&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b7da9f8d-20fb-4b60-9e6f-742c55b47551\', \'multiverseId\': 638923}, \'multiverseid\': 638923}, {\'name\': \'遗世纪念碑\', \'text\': \'{T}：加{C}。\\n由你操控的其他洞窟具有「{T}，支付1点生命：加一点任意颜色的法术力。」\', \'type\': \'地 — 洞窟\', \'flavor\': \'虽然科门维纳家族未曾留下什么文字纪录，但他们的手工制品却遍布世界核心各处、屹立不摇。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639244&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fb2e9e79-5752-4f2c-9be9-65d2f17d1ca4\', \'multiverseId\': 639244}, \'multiverseid\': 639244}]', '[{\'name\': \'Vergrabener Schatz\', \'text\': \'{T}, opfere den Vergrabenen Schatz: Erzeuge ein Mana einer beliebigen Farbe.\\n{5}, schicke den Vergrabenen Schatz aus deinem Friedhof ins Exil: Entdeckung 5. Aktiviere diese Fähigkeit wie eine Hexerei. (Schicke Karten oben von deiner Bibliothek ins Exil, bis du eine Nichtland-Karte mit Manabetrag 5 oder weniger ins Exil schickst. Wirke sie, ohne ihre Manakosten zu bezahlen, oder nimm sie auf deine Hand. Lege den Rest in zufälliger Reihenfolge unter die Bibliothek.)\', \'type\': \'Artefakt — Schatz\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637288&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'672e112e-acfe-4479-9f1b-a95f785371be\', \'multiverseId\': 637288}, \'multiverseid\': 637288}, {\'name\': \'Tesoro enterrado\', \'text\': \'{T}, sacrificar el Tesoro enterrado: Agrega un maná de cualquier color.\\n{5}, exiliar el Tesoro enterrado de tu cementerio: Descubre 5. Activa esto solo como un conjuro. (Exilia cartas de la parte superior de tu biblioteca hasta que exilies una carta que no sea tierra con valor de maná de 5 o menos. Lánzala sin pagar su coste de maná o ponla en tu mano. Pon el resto en el fondo en un orden aleatorio.)\', \'type\': \'Artefacto — Tesoro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637609&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'60b3add3-d083-48f5-a92b-975beafdefa4\', \'multiverseId\': 637609}, \'multiverseid\': 637609}, {\'name\': \'Trésor enfoui\', \'text\': "{T}, sacrifiez le Trésor enfoui : Ajoutez un mana de la couleur de votre choix.\\n{5}, exilez le Trésor enfoui depuis votre cimetière : Découvrez 5. N\'activez que lorsque vous pourriez lancer un rituel. (Exilez les cartes du dessus de votre bibliothèque jusqu\'à ce que vous exiliez une carte non-terrain avec une valeur de mana inférieure ou égale à 5. Lancez-la sans payer son coût de mana ou mettez-la dans votre main. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.)", \'type\': \'Artefact — trésor\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637930&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'55d6592d-8730-4683-960d-66b4967d06b4\', \'multiverseId\': 637930}, \'multiverseid\': 637930}, {\'name\': \'Tesoro Sepolto\', \'text\': \'{T}, Sacrifica il Tesoro Sepolto: Aggiungi un mana di un qualsiasi colore.\\n{5}, Esilia il Tesoro Sepolto dal tuo cimitero: Scopri 5. Attiva solo come una stregoneria. (Esilia carte dalla cima del tuo grimorio finché non esili una carta non terra con valore di mana pari o inferiore a 5. Lanciala senza pagare il suo costo di mana o aggiungila alla tua mano. Metti le altre in fondo in ordine casuale.)\', \'type\': \'Artefatto — Tesoro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638251&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'195ba205-a7a9-4bc8-9005-039199f414a7\', \'multiverseId\': 638251}, \'multiverseid\': 638251}, {\'name\': \'埋もれた宝物\', \'text\': \'{T}, 埋もれた宝物を生け贄に捧げる：好きな色１色のマナ１点を加える。\\n{5}, あなたの墓地にある埋もれた宝物を追放する：発見５を行う。起動はソーサリーとしてのみ行う。（マナ総量が５以下であり土地でないカード１枚が追放されるまで、あなたのライブラリーの一番上から１枚ずつ追放していく。それをマナ・コストを支払うことなく唱えるか、あなたの手札に加える。残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'アーティファクト — 宝物\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638572&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'47b4ceaa-3f21-43b7-a991-2650962a9831\', \'multiverseId\': 638572}, \'multiverseid\': 638572}, {\'name\': \'Tesouro Enterrado\', \'text\': \'{T}, sacrifique Tesouro Enterrado: Adicione um mana de qualquer cor.\\n{5}, exile Tesouro Enterrado de seu cemitério: Descubra 5. Ative somente como um feitiço. (Exile cards do topo do seu grimório até exilar um card não de terreno com valor de mana igual ou inferior a 5. Conjure sem pagar o custo de mana ou coloque-o na sua mão. Coloque o restante no fundo do grimório em ordem aleatória.)\', \'type\': \'Artefato — Tesouro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638893&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'41fc6cdf-6dec-4361-9930-7e3d46acc52c\', \'multiverseId\': 638893}, \'multiverseid\': 638893}, {\'name\': \'遭埋珍宝\', \'text\': \'{T}，牺牲遭埋珍宝：加一点任意颜色的法术力。\\n{5}，从你的坟墓场放逐遭埋珍宝：倾探5。只能于法术时机起动。（从你的牌库顶开始放逐牌，直到放逐一张法术力值等于或小于5的非地牌为止。施放之且不需支付其法术力费用，或将之置于你手上。将其余的牌以随机顺序置于你牌库底。）\', \'type\': \'神器 — 珍宝\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639214&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'544a1289-997f-4309-ab8b-eb4a882cea11\', \'multiverseId\': 639214}, \'multiverseid\': 639214}]', '[{\'name\': \'Verhängnisvoller Einsturz\', \'text\': \'Der Verhängnisvolle Einsturz fügt jeder Kreatur und jedem Planeswalker X Schadenspunkte zu, wobei X gleich der Anzahl an Höhlen ist, die du kontrollierst, plus der Anzahl an Höhle-Karten in deinem Friedhof.\', \'type\': \'Hexerei\', \'flavor\': \'„Für ‚unsterbliche Eroberer\\\' scheinen diese Vampire aber sehr empfindlich auf hinabstürzende Felsen zu reagieren."\\n—Chara Rebal, Fledermausreiterin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637169&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'86c252b9-9a0b-4d79-b092-19080f6b8791\', \'multiverseId\': 637169}, \'multiverseid\': 637169}, {\'name\': \'Derrumbe calamitoso\', \'text\': \'El Derrumbe calamitoso hace X puntos de daño a cada criatura y a cada planeswalker, donde X es la cantidad de Cuevas que controlas más la cantidad de cartas de Cueva en tu cementerio.\', \'type\': \'Conjuro\', \'flavor\': \'"Si son \\\'conquistadores inmortales\\\', no entiendo por qué estos vampiros salen corriendo en cuanto ven que les va a aplastar una roca".\\n—Chara Rebal, jinete de murciélagos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637490&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fc82977c-1b98-4bdc-ae52-3014122c004e\', \'multiverseId\': 637490}, \'multiverseid\': 637490}, {\'name\': \'Effondrement désastreux\', \'text\': "L\'Effondrement désastreux inflige X blessures à chaque créature et à chaque planeswalker, X étant le nombre de cavernes que vous contrôlez plus le nombre de cartes de caverne dans votre cimetière.", \'type\': \'Rituel\', \'flavor\': "« Pour des \'conquérants immortels\', ces vampires semblent avoir tendance à se faire écraser par des rochers. »\\n—Chara Rebal, chevaucheur de chauve-souris", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637811&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'df811a4c-d9a1-44f6-8a0a-224b7baf2510\', \'multiverseId\': 637811}, \'multiverseid\': 637811}, {\'name\': \'Crollo Disastroso\', \'text\': \'Il Crollo Disastroso infligge X danni a ogni creatura e a ogni planeswalker, dove X è il numero di Caverne che controlli più il numero di carte Caverna nel tuo cimitero.\', \'type\': \'Stregoneria\', \'flavor\': \'"Per essere dei \\\'conquistatori immortali\\\', questi vampiri sembrano piuttosto suscettibili al peso dei macigni."\\n—Chara Rebal, cavalcatrice di pipistrelli\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638132&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1af5c49d-d412-468a-8971-58afa83905b2\', \'multiverseId\': 638132}, \'multiverseid\': 638132}, {\'name\': \'壊滅的な陥没\', \'text\': \'壊滅的な陥没は各クリーチャーと各プレインズウォーカーにそれぞれＸ点のダメージを与える。Ｘは、あなたがコントロールしている洞窟の数に、あなたの墓地にある洞窟・カードの枚数を足した数に等しい。\', \'type\': \'ソーサリー\', \'flavor\': \'「『不死の征服者』を謳う割には、吸血鬼共は大岩に潰されることにめっぽう弱いようだ。」\\n――コウモリの乗り手、チャラ・レバル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638453&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f1d406f0-45b1-47f4-a6db-8b3923200d4f\', \'multiverseId\': 638453}, \'multiverseid\': 638453}, {\'name\': \'Desmoronamento Calamitoso\', \'text\': \'Desmoronamento Calamitoso causa X pontos de dano a cada criatura e cada planeswalker, sendo X o número de Cavernas que você controla mais o número de cards de Caverna em seu cemitério.\', \'type\': \'Feitiço\', \'flavor\': \'"Para \\\'conquistadores imortais\\\', esses vampiros parecem deveras suscetíveis a esmagamento por pedregulhos."\\n— Chara Rebal, ginete de morcego\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638774&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a119199b-118a-4059-a8f6-7d2574edd89d\', \'multiverseId\': 638774}, \'multiverseid\': 638774}, {\'name\': \'灾难塌陷\', \'text\': \'灾难塌陷对每个生物和每个鹏洛客各造成X点伤害，X为由你操控的洞窟数量与你坟墓场中的洞窟牌数量之总和。\', \'type\': \'法术\', \'flavor\': \'这些自称『永生征服者』的吸血鬼，似乎很容易就被巨石压扁。」\\n～蝙蝠骑手查拉雷拔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639095&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ee3fd969-4af4-4dd0-bc0e-6370d8b0d716\', \'multiverseId\': 639095}, \'multiverseid\': 639095}]', '[{\'name\': \'Verpesteter Trank\', \'text\': \'Wenn der Verpestete Trank ins Spiel kommt oder aus dem Spiel auf einen Friedhof gelegt wird, ziehst du eine Karte und verlierst 1 Lebenspunkt.\', \'type\': \'Artefakt\', \'flavor\': \'„Schau mich nicht so an. Das trinke ich ganz sicher nicht."\\n—Dranach, Bootsmann der Schreckensflotte\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637138&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cecd74cc-5d24-4336-af3e-8c9eb38eef07\', \'multiverseId\': 637138}, \'multiverseid\': 637138}, {\'name\': \'Brebaje mefítico\', \'text\': \'Cuando el Brebaje mefítico entre al campo de batalla o vaya a un cementerio desde el campo de batalla, robas una carta y pierdes 1 vida.\', \'type\': \'Artefacto\', \'flavor\': \'"A mí no me mires. No me lo pienso beber".\\n—Dranach, oficial de la Flota Arrasadora\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637459&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1cf84523-9a94-40b2-a184-d271cf6f1146\', \'multiverseId\': 637459}, \'multiverseid\': 637459}, {\'name\': \'Philtre méphitique\', \'text\': \'Quand le Philtre méphitique arrive sur le champ de bataille ou est mis dans un cimetière depuis le champ de bataille, vous piochez une carte et vous perdez 1 point de vie.\', \'type\': \'Artefact\', \'flavor\': "« Ne me regardez pas comme ça. Je ne le boirai pas. »\\n—Dranach, maître d\'équipage de la Flotte implacable", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637780&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'edd99c2f-b776-42a1-87f9-7180ccf6edc8\', \'multiverseId\': 637780}, \'multiverseid\': 637780}, {\'name\': \'Pozione Mefitica\', \'text\': \'Quando la Pozione Mefitica entra nel campo di battaglia o viene messa in un cimitero dal campo di battaglia, peschi una carta e perdi 1 punto vita.\', \'type\': \'Artefatto\', \'flavor\': \'"Non guardare me, io quella non la bevo."\\n—Dranach, nostromo della Flotta Funesta\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638101&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c55fa87c-8e5b-4e81-9936-73782f3ab160\', \'multiverseId\': 638101}, \'multiverseid\': 638101}, {\'name\': \'毒気の薬\', \'text\': \'毒気の薬が戦場に出たか戦場から墓地に置かれたとき、カード１枚を引き、１点のライフを失う。\', \'type\': \'アーティファクト\', \'flavor\': \'「こっち見るなよ。俺は飲まないぞ。」\\n――凶兆艦隊の掌帆長、ドラナク\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638422&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dabedf10-c472-47a5-aa54-77936aac9615\', \'multiverseId\': 638422}, \'multiverseid\': 638422}, {\'name\': \'Poção Mefítica\', \'text\': \'Quando Poção Mefítica entra no campo de batalha ou é colocada num cemitério vinda do campo de batalha, você compra um card e perde 1 ponto de vida.\', \'type\': \'Artefato\', \'flavor\': \'"Não olha pra mim. Eu não vou beber, não."\\n— Dranach, contramestre da Frota Macabra\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638743&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b877c4f9-aa90-4cf7-9284-d192f6962cba\', \'multiverseId\': 638743}, \'multiverseid\': 638743}, {\'name\': \'恶毒药剂\', \'text\': \'当恶毒药剂进战场或从战场进入坟墓场时，你抓一张牌且失去1点生命。\', \'type\': \'神器\', \'flavor\': \'「别看我，我可不喝。」\\n～焦炬舰队水手长卓纳克\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639064&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ac11a034-c3d2-42cf-b20a-018f4a98d106\', \'multiverseId\': 639064}, \'multiverseid\': 639064}]', '[{\'name\': \'Verspielter Welpe\', \'text\': \'Aufblitzen\\nWenn der Verspielte Welpe ins Spiel kommt, bringe bis zu ein Permanent deiner Wahl, das du kontrollierst, auf die Hand seines Besitzers zurück.\', \'type\': \'Kreatur — Hund\', \'flavor\': \'„Entweder hat er einen Gnom sehr wütend gemacht, als er das geklaut hat, oder er macht einen sehr glücklich, wenn er es zurückbringt."\\n—Ihio, Marktverkäufer aus Oteclan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637037&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4252e005-0ddc-45d0-87f6-9af29ac93048\', \'multiverseId\': 637037}, \'multiverseid\': 637037}, {\'name\': \'Sabueso travieso\', \'text\': \'Destello.\\nCuando el Sabueso travieso entre al campo de batalla, regresa hasta un otro permanente objetivo que controlas a la mano de su propietario.\', \'type\': \'Criatura — Perro\', \'flavor\': \'"O enfadó mucho a un gnomo cuando se llevó eso o le alegrará el día cuando se lo devuelva".\\n—Ihio, vendedor del mercado de Oteclan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637358&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'42789a65-b13a-4ba9-8086-b095ef61014e\', \'multiverseId\': 637358}, \'multiverseid\': 637358}, {\'name\': \'Chiot malicieux\', \'text\': "Flash\\nQuand le Chiot malicieux arrive sur le champ de bataille, renvoyez jusqu\'à un autre permanent ciblé que vous contrôlez dans la main de son propriétaire.", \'type\': \'Créature — chien\', \'flavor\': "« Il a dû bien enrager un gnome quand il a volé ça, à moins qu\'il ne fasse un gnome heureux quand il lui rapportera. »\\n—Ihio, vendeur du marché d\'Oteclan", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637679&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c2c133d6-8a48-4d80-ab19-a07d6a334df9\', \'multiverseId\': 637679}, \'multiverseid\': 637679}, {\'name\': \'Cucciolo Dispettoso\', \'text\': \'Lampo\\nQuando il Cucciolo Dispettoso entra nel campo di battaglia, fai tornare fino a un altro permanente bersaglio che controlli in mano al suo proprietario.\', \'type\': \'Creatura — Canide\', \'flavor\': \'"Deve aver fatto arrabbiare uno gnomo prendendo quell\\\'aggeggio, o ne renderà uno molto felice quando lo riporterà."\\n—Ihio, mercante di Oteclan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638000&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'169c99ed-aad5-4740-adb8-00101e20c3ed\', \'multiverseId\': 638000}, \'multiverseid\': 638000}, {\'name\': \'悪戯好きの子犬\', \'text\': \'瞬速\\n悪戯好きの子犬が戦場に出たとき、あなたがコントロールしていてこれでないパーマネント最大１つを対象とする。それをオーナーの手札に戻す。\', \'type\': \'クリーチャー — 犬\', \'flavor\': \'「あれを奪われたことでノームが怒り狂ってるか、それを取り返したことでノームが大喜びしているかのどちらかだな。」\\n――オテクランの露天商、イヒオ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638321&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b01acbef-2126-4d2f-980f-09bd2bca69ff\', \'multiverseId\': 638321}, \'multiverseid\': 638321}, {\'name\': \'Filhote Travesso\', \'text\': \'Lampejo\\nQuando Filhote Travesso entrar no campo de batalha, devolva até uma outra permanente alvo que você controla à mão de seu dono.\', \'type\': \'Criatura — Cão\', \'flavor\': \'"Ou ele deixou um gnomo furioso quando pegou, ou vai deixar um gnomo muito feliz quando levar de volta."\\n— Ihio, comerciante do mercado de Oteclan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638642&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'957d7a5d-37dd-4d52-9fff-ce9397a98281\', \'multiverseId\': 638642}, \'multiverseid\': 638642}, {\'name\': \'恼人幼犬\', \'text\': \'闪现\\n当恼人幼犬进战场时，将至多另一个目标由你操控的永久物移回其拥有者手上。\', \'type\': \'生物 — 狗\', \'flavor\': \'「被他叼走的那台侏械会很生气，给他叼回来的那台侏械会很开心。」\\n～欧特克兰市集商贩伊西奥\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638963&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8adf4150-120e-4679-8cc4-65bcca8c6f90\', \'multiverseId\': 638963}, \'multiverseid\': 638963}]', '[{\'name\': \'Versteck des Höhlenforschers\', \'text\': \'Das Versteck des Höhlenforschers kommt mit zwei +1/+1-Marken ins Spiel.\\nImmer wenn eine Kreatur mit +1/+1-Marke, die du kontrollierst, stirbt, lege eine +1/+1-Marke auf das Versteck des Höhlenforschers.\\n{T}: Bewege eine +1/+1-Marke vom Versteck des Höhlenforschers auf eine Kreatur deiner Wahl. Aktiviere diese Fähigkeit wie eine Hexerei.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637219&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fa613c7a-ee3c-45a9-8496-5c4e23d6bc22\', \'multiverseId\': 637219}, \'multiverseid\': 637219}, {\'name\': \'Alijo de explorador\', \'text\': \'El Alijo de explorador entra al campo de batalla con dos contadores +1/+1 sobre él.\\nSiempre que una criatura que controlas con un contador +1/+1 sobre ella muera, pon un contador +1/+1 sobre el Alijo de explorador.\\n{T}: Mueve un contador +1/+1 del Alijo de explorador a la criatura objetivo. Activa esto solo como un conjuro.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637540&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'61751376-f086-4847-a796-ccd0a73fb4e6\', \'multiverseId\': 637540}, \'multiverseid\': 637540}, {\'name\': "Cache de l\'explorateur", \'text\': "La Cache de l\'explorateur arrive sur le champ de bataille avec deux marqueurs +1/+1 sur elle.\\nÀ chaque fois qu\'une créature que vous contrôlez avec un marqueur +1/+1 sur elle meurt, mettez un marqueur +1/+1 sur la Cache de l\'explorateur.\\n{T} : Déplacez un marqueur +1/+1 de la Cache de l\'explorateur sur une créature ciblée. N\'activez que lorsque vous pourriez lancer un rituel.", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637861&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'78bfb82f-a34d-4ebb-bcaa-2ea809117bde\', \'multiverseId\': 637861}, \'multiverseid\': 637861}, {\'name\': "Scorta Segreta dell\'Esploratore", \'text\': "La Scorta Segreta dell\'Esploratore entra nel campo di battaglia con due segnalini +1/+1.\\nOgniqualvolta una creatura con un segnalino +1/+1 che controlli muore, metti un segnalino +1/+1 sulla Scorta Segreta dell\'Esploratore.\\n{T}: Sposta un segnalino +1/+1 dalla Scorta Segreta dell\'Esploratore a una creatura bersaglio. Attiva solo come una stregoneria.", \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638182&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ee85efb1-2ce4-4b0c-841e-9e2fa607e237\', \'multiverseId\': 638182}, \'multiverseid\': 638182}, {\'name\': \'探検者の隠し場所\', \'text\': \'探検者の隠し場所は＋１/＋１カウンター２個が置かれた状態で戦場に出る。\\nあなたがコントロールしていて＋１/＋１カウンターが置かれているクリーチャー１体が死亡するたび、探検者の隠し場所の上に＋１/＋１カウンター１個を置く。\\n{T}：クリーチャー１体を対象とする。探検者の隠し場所の上から＋１/＋１カウンター１個をそれの上に動かす。起動はソーサリーとしてのみ行う。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638503&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b1cb1ea8-8eb6-44e6-a149-f97becccf56e\', \'multiverseId\': 638503}, \'multiverseid\': 638503}, {\'name\': \'Repositório do Explorador\', \'text\': \'Repositório do Explorador entra no campo de batalha com dois marcadores +1/+1.\\nToda vez que uma criatura que você controla com um marcador +1/+1 morrer, coloque um marcador +1/+1 em Repositório do Explorador.\\n{T}: Mova um marcador +1/+1 de Repositório do Explorador para a criatura alvo. Ative somente como um feitiço.\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638824&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'532ed762-68c8-46b8-ab8c-91d5c9086f34\', \'multiverseId\': 638824}, \'multiverseid\': 638824}, {\'name\': \'探险家密储\', \'text\': \'探险家密储进战场时上面有两个+1/+1指示物。\\n每当一个由你操控且其上有+1/+1指示物的生物死去时，在探险家密储上放置一个+1/+1指示物。\\n{T}：将一个+1/+1指示物从探险家密储移到目标生物上。只能于法术时机起动。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639145&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'199db39f-d575-46b4-86f9-31a52963a550\', \'multiverseId\': 639145}, \'multiverseid\': 639145}]', '[{\'name\': \'Versteckte Nekropolis\', \'text\': \'Die Versteckte Nekropolis kommt getappt ins Spiel.\\n{T}: Erzeuge {B}.\\n{4}{B}, {T}, opfere die Versteckte Nekropolis: Entdeckung 4. Aktiviere diese Fähigkeit wie eine Hexerei. (Schicke Karten oben von deiner Bibliothek ins Exil, bis du eine Nichtland-Karte mit Manabetrag 4 oder weniger ins Exil schickst. Wirke sie, ohne ihre Manakosten zu bezahlen, oder nimm sie auf deine Hand. Lege den Rest in zufälliger Reihenfolge unter die Bibliothek.)\', \'type\': \'Land — Höhle\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637321&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dd8737c3-e364-412c-83c4-fda6ec3ef209\', \'multiverseId\': 637321}, \'multiverseid\': 637321}, {\'name\': \'Necrópolis escondida\', \'text\': \'La Necrópolis escondida entra al campo de batalla girada.\\n{T}: Agrega {B}.\\n{4}{B}, {T}, sacrificar la Necrópolis escondida: Descubre 4. Activa esto solo como un conjuro. (Exilia cartas de la parte superior de tu biblioteca hasta que exilies una carta que no sea tierra con valor de maná de 4 o menos. Lánzala sin pagar su coste de maná o ponla en tu mano. Pon el resto en el fondo en un orden aleatorio.)\', \'type\': \'Tierra — Cueva\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637642&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'25b70440-1b83-4623-beff-a4a90cb5d685\', \'multiverseId\': 637642}, \'multiverseid\': 637642}, {\'name\': \'Nécropole cachée\', \'text\': "La Nécropole cachée arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {B}.\\n{4}{B}, {T}, sacrifiez la Nécropole cachée : Découvrez 4. N\'activez que lorsque vous pourriez lancer un rituel. (Exilez les cartes du dessus de votre bibliothèque jusqu\'à ce que vous exiliez une carte non-terrain avec une valeur de mana inférieure ou égale à 4. Lancez-la sans payer son coût de mana ou mettez-la dans votre main. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.)", \'type\': \'Terrain — caverne\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637963&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1cbc6307-8be5-4106-acaa-7878ec9321ad\', \'multiverseId\': 637963}, \'multiverseid\': 637963}, {\'name\': \'Necropoli Celata\', \'text\': \'La Necropoli Celata entra nel campo di battaglia TAPpata.\\n{T}: Aggiungi {B}.\\n{4}{B}, {T}, Sacrifica la Necropoli Celata: Scopri 4. Attiva solo come una stregoneria. (Esilia carte dalla cima del tuo grimorio finché non esili una carta non terra con valore di mana pari o inferiore a 4. Lanciala senza pagare il suo costo di mana o aggiungila alla tua mano. Metti le altre in fondo in ordine casuale.)\', \'type\': \'Terra — Caverna\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638284&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4b52cb48-0c31-480a-b92a-9c7976acca2f\', \'multiverseId\': 638284}, \'multiverseid\': 638284}, {\'name\': \'隠された死滅都市\', \'text\': \'隠された死滅都市はタップ状態で戦場に出る。\\n{T}：{B}を加える。\\n{4}{B}, {T}, 隠された死滅都市を生け贄に捧げる：発見４を行う。起動はソーサリーとしてのみ行う。（マナ総量が４以下であり土地でないカード１枚が追放されるまで、あなたのライブラリーの一番上から１枚ずつ追放していく。それをマナ・コストを支払うことなく唱えるか、あなたの手札に加える。残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'土地 — 洞窟\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638605&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cc81fdf8-a504-4e1c-861a-8022a96c48ee\', \'multiverseId\': 638605}, \'multiverseid\': 638605}, {\'name\': \'Necrópole Escondida\', \'text\': \'Necrópole Escondida entra no campo de batalha virada.\\n{T}: Adicione {B}.\\n{4}{B}, {T}, sacrifique Necrópole Escondida: Descubra 4. Ative somente como um feitiço. (Exile cards do topo do seu grimório até exilar um card não de terreno com valor de mana igual ou inferior a 4. Conjure sem pagar o custo de mana ou coloque-o na sua mão. Coloque o restante no fundo do grimório em ordem aleatória.)\', \'type\': \'Terreno — Caverna\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638926&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a8752a5e-5ea3-446d-ba6f-2d00ce004ece\', \'multiverseId\': 638926}, \'multiverseid\': 638926}, {\'name\': \'蔽匿陵寝\', \'text\': \'蔽匿陵寝须横置进战场。\\n{T}：加{B}。\\n{4}{B}，{T}，牺牲蔽匿陵寝：倾探4。只能于法术时机起动。（从你的牌库顶开始放逐牌，直到放逐一张法术力值等于或小于4的非地牌为止。施放之且不需支付其法术力费用，或将之置于你手上。将其余的牌以随机顺序置于你牌库底。）\', \'type\': \'地 — 洞窟\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639247&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3dfd59b9-7e88-41a9-a0ca-fd124bbbcaaf\', \'multiverseId\': 639247}, \'multiverseid\': 639247}]', '[{\'name\': \'Versteckter Katarakt\', \'text\': \'Der Versteckte Katarakt kommt getappt ins Spiel.\\n{T}: Erzeuge {U}.\\n{4}{U}, {T}, opfere den Versteckten Katarakt: Entdeckung 4. Aktiviere diese Fähigkeit wie eine Hexerei. (Schicke Karten oben von deiner Bibliothek ins Exil, bis du eine Nichtland-Karte mit Manabetrag 4 oder weniger ins Exil schickst. Wirke sie, ohne ihre Manakosten zu bezahlen, oder nimm sie auf deine Hand. Lege den Rest in zufälliger Reihenfolge unter die Bibliothek.)\', \'type\': \'Land — Höhle\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637319&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ceeb12b4-910b-46d6-aabe-ce5953ae80a2\', \'multiverseId\': 637319}, \'multiverseid\': 637319}, {\'name\': \'Catarata escondida\', \'text\': \'La Catarata escondida entra al campo de batalla girada.\\n{T}: Agrega {U}.\\n{4}{U}, {T}, sacrificar la Catarata escondida: Descubre 4. Activa esto solo como un conjuro. (Exilia cartas de la parte superior de tu biblioteca hasta que exilies una carta que no sea tierra con valor de maná de 4 o menos. Lánzala sin pagar su coste de maná o ponla en tu mano. Pon el resto en el fondo en un orden aleatorio.)\', \'type\': \'Tierra — Cueva\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637640&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e6dcf61e-f263-492d-814b-4c47e02be06b\', \'multiverseId\': 637640}, \'multiverseid\': 637640}, {\'name\': \'Cataracte cachée\', \'text\': "La Cataracte cachée arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {U}.\\n{4}{U}, {T}, sacrifiez la Cataracte cachée : Découvrez 4. N\'activez que lorsque vous pourriez lancer un rituel. (Exilez les cartes du dessus de votre bibliothèque jusqu\'à ce que vous exiliez une carte non-terrain avec une valeur de mana inférieure ou égale à 4. Lancez-la sans payer son coût de mana ou mettez-la dans votre main. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.)", \'type\': \'Terrain — caverne\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637961&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7bec53ab-ce43-4687-9b02-406fd682e970\', \'multiverseId\': 637961}, \'multiverseid\': 637961}, {\'name\': \'Cataratta Celata\', \'text\': \'La Cataratta Celata entra nel campo di battaglia TAPpata.\\n{T}: Aggiungi {U}.\\n{4}{U}, {T}, Sacrifica la Cataratta Celata: Scopri 4. Attiva solo come una stregoneria. (Esilia carte dalla cima del tuo grimorio finché non esili una carta non terra con valore di mana pari o inferiore a 4. Lanciala senza pagare il suo costo di mana o aggiungila alla tua mano. Metti le altre in fondo in ordine casuale.)\', \'type\': \'Terra — Caverna\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638282&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3f704181-3bf0-4814-b853-e1816cb83787\', \'multiverseId\': 638282}, \'multiverseid\': 638282}, {\'name\': \'隠された瀑布\', \'text\': \'隠された瀑布はタップ状態で戦場に出る。\\n{T}：{U}を加える。\\n{4}{U}, {T}, 隠された瀑布を生け贄に捧げる：発見４を行う。起動はソーサリーとしてのみ行う。（マナ総量が４以下であり土地でないカード１枚が追放されるまで、あなたのライブラリーの一番上から１枚ずつ追放していく。それをマナ・コストを支払うことなく唱えるか、あなたの手札に加える。残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'土地 — 洞窟\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638603&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'241ff1e7-0ab2-45ca-8fa3-a12a855328b7\', \'multiverseId\': 638603}, \'multiverseid\': 638603}, {\'name\': \'Catarata Escondida\', \'text\': \'Catarata Escondida entra no campo de batalha virada.\\n{T}: Adicione {U}.\\n{4}{U}, {T}, sacrifique Catarata Escondida: Descubra 4. Ative somente como um feitiço. (Exile cards do topo do seu grimório até exilar um card não de terreno com valor de mana igual ou inferior a 4. Conjure sem pagar o custo de mana ou coloque-o na sua mão. Coloque o restante no fundo do grimório em ordem aleatória.)\', \'type\': \'Terreno — Caverna\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638924&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d120f30f-c54d-4184-94ff-d58c267be349\', \'multiverseId\': 638924}, \'multiverseid\': 638924}, {\'name\': \'蔽匿瀑布\', \'text\': \'蔽匿瀑布须横置进战场。\\n{T}：加{U}。\\n{4}{U}，{T}，牺牲蔽匿瀑布：倾探4。只能于法术时机起动。（从你的牌库顶开始放逐牌，直到放逐一张法术力值等于或小于4的非地牌为止。施放之且不需支付其法术力费用，或将之置于你手上。将其余的牌以随机顺序置于你牌库底。）\', \'type\': \'地 — 洞窟\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639245&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7637d223-87b4-427d-9ee4-345771cff07c\', \'multiverseId\': 639245}, \'multiverseid\': 639245}]', '[{\'name\': \'Versteckter Lichthof\', \'text\': \'Der Versteckte Lichthof kommt getappt ins Spiel.\\n{T}: Erzeuge {W}.\\n{4}{W}, {T}, opfere den Versteckten Lichthof: Entdeckung 4. Aktiviere diese Fähigkeit wie eine Hexerei. (Schicke Karten oben von deiner Bibliothek ins Exil, bis du eine Nichtland-Karte mit Manabetrag 4 oder weniger ins Exil schickst. Wirke sie, ohne ihre Manakosten zu bezahlen, oder nimm sie auf deine Hand. Lege den Rest in zufälliger Reihenfolge unter die Bibliothek.)\', \'type\': \'Land — Höhle\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637320&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'54953853-472c-4461-9914-547dba135a53\', \'multiverseId\': 637320}, \'multiverseid\': 637320}, {\'name\': \'Patio escondido\', \'text\': \'El Patio escondido entra al campo de batalla girado.\\n{T}: Agrega {W}.\\n{4}{W}, {T}, sacrificar el Patio escondido: Descubre 4. Activa esto solo como un conjuro. (Exilia cartas de la parte superior de tu biblioteca hasta que exilies una carta que no sea tierra con valor de maná de 4 o menos. Lánzala sin pagar su coste de maná o ponla en tu mano. Pon el resto en el fondo en un orden aleatorio.)\', \'type\': \'Tierra — Cueva\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637641&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6c9ccb6a-e8ac-4e99-9ee5-a77b1b606049\', \'multiverseId\': 637641}, \'multiverseid\': 637641}, {\'name\': \'Cour cachée\', \'text\': "La Cour cachée arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {W}.\\n{4}{W}, {T}, sacrifiez la Cour cachée : Découvrez 4. N\'activez que lorsque vous pourriez lancer un rituel. (Exilez les cartes du dessus de votre bibliothèque jusqu\'à ce que vous exiliez une carte non-terrain avec une valeur de mana inférieure ou égale à 4. Lancez-la sans payer son coût de mana ou mettez-la dans votre main. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.)", \'type\': \'Terrain — caverne\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637962&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c253f388-4c1f-4e50-8c50-248f01c1b8b4\', \'multiverseId\': 637962}, \'multiverseid\': 637962}, {\'name\': \'Cortile Celato\', \'text\': \'Il Cortile Celato entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {W}.\\n{4}{W}, {T}, Sacrifica il Cortile Celato: Scopri 4. Attiva solo come una stregoneria. (Esilia carte dalla cima del tuo grimorio finché non esili una carta non terra con valore di mana pari o inferiore a 4. Lanciala senza pagare il suo costo di mana o aggiungila alla tua mano. Metti le altre in fondo in ordine casuale.)\', \'type\': \'Terra — Caverna\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638283&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e246e62d-7215-4fa3-ae76-440c9a122ed2\', \'multiverseId\': 638283}, \'multiverseid\': 638283}, {\'name\': \'隠された中庭\', \'text\': \'隠された中庭はタップ状態で戦場に出る。\\n{T}：{W}を加える。\\n{4}{W}, {T}, 隠された中庭を生け贄に捧げる：発見４を行う。起動はソーサリーとしてのみ行う。（マナ総量が４以下であり土地でないカード１枚が追放されるまで、あなたのライブラリーの一番上から１枚ずつ追放していく。それをマナ・コストを支払うことなく唱えるか、あなたの手札に加える。残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'土地 — 洞窟\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638604&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'37dd5d34-72a8-41a0-9617-e17e545d77c8\', \'multiverseId\': 638604}, \'multiverseid\': 638604}, {\'name\': \'Pátio Escondido\', \'text\': \'Pátio Escondido entra no campo de batalha virado.\\n{T}: Adicione {W}.\\n{4}{W}, {T}, sacrifique Pátio Escondido: Descubra 4. Ative somente como um feitiço. (Exile cards do topo do seu grimório até exilar um card não de terreno com valor de mana igual ou inferior a 4. Conjure sem pagar o custo de mana ou coloque-o na sua mão. Coloque o restante no fundo do grimório em ordem aleatória.)\', \'type\': \'Terreno — Caverna\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638925&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a09dd036-7f5c-4ae0-a9cf-bc158ea9e900\', \'multiverseId\': 638925}, \'multiverseid\': 638925}, {\'name\': \'蔽匿庭院\', \'text\': \'蔽匿庭院须横置进战场。\\n{T}：加{W}。\\n{4}{W}，{T}，牺牲蔽匿庭院：倾探4。只能于法术时机起动。（从你的牌库顶开始放逐牌，直到放逐一张法术力值等于或小于4的非地牌为止。施放之且不需支付其法术力费用，或将之置于你手上。将其余的牌以随机顺序置于你牌库底。）\', \'type\': \'地 — 洞窟\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639246&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'80fa2131-9208-4596-a84e-fd4fa8d42b49\', \'multiverseId\': 639246}, \'multiverseid\': 639246}]', '[{\'name\': \'Versteckter Vulkan\', \'text\': \'Der Versteckte Vulkan kommt getappt ins Spiel.\\n{T}: Erzeuge {R}.\\n{4}{R}, {T}, opfere den Versteckten Vulkan: Entdeckung 4. Aktiviere diese Fähigkeit wie eine Hexerei. (Schicke Karten oben von deiner Bibliothek ins Exil, bis du eine Nichtland-Karte mit Manabetrag 4 oder weniger ins Exil schickst. Wirke sie, ohne ihre Manakosten zu bezahlen, oder nimm sie auf deine Hand. Lege den Rest in zufälliger Reihenfolge unter die Bibliothek.)\', \'type\': \'Land — Höhle\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637323&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a542f005-eea8-4cae-9ef2-1047034f2667\', \'multiverseId\': 637323}, \'multiverseid\': 637323}, {\'name\': \'Volcán escondido\', \'text\': \'El Volcán escondido entra al campo de batalla girado.\\n{T}: Agrega {R}.\\n{4}{R}, {T}, sacrificar el Volcán escondido: Descubre 4. Activa esto solo como un conjuro. (Exilia cartas de la parte superior de tu biblioteca hasta que exilies una carta que no sea tierra con valor de maná de 4 o menos. Lánzala sin pagar su coste de maná o ponla en tu mano. Pon el resto en el fondo en un orden aleatorio.)\', \'type\': \'Tierra — Cueva\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637644&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'58f71ce2-a2d6-489f-9612-6118cc219f37\', \'multiverseId\': 637644}, \'multiverseid\': 637644}, {\'name\': \'Volcan caché\', \'text\': "Le Volcan caché arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {R}.\\n{4}{R}, {T}, sacrifiez le Volcan caché : Découvrez 4. N\'activez que lorsque vous pourriez lancer un rituel. (Exilez les cartes du dessus de votre bibliothèque jusqu\'à ce que vous exiliez une carte non-terrain avec une valeur de mana inférieure ou égale à 4. Lancez-la sans payer son coût de mana ou mettez-la dans votre main. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.)", \'type\': \'Terrain — caverne\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637965&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a8d40eb7-1605-4fa0-bcc5-e02f5a1ab93e\', \'multiverseId\': 637965}, \'multiverseid\': 637965}, {\'name\': \'Vulcano Celato\', \'text\': \'Il Vulcano Celato entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {R}.\\n{4}{R}, {T}, Sacrifica il Vulcano Celato: Scopri 4. Attiva solo come una stregoneria. (Esilia carte dalla cima del tuo grimorio finché non esili una carta non terra con valore di mana pari o inferiore a 4. Lanciala senza pagare il suo costo di mana o aggiungila alla tua mano. Metti le altre in fondo in ordine casuale.)\', \'type\': \'Terra — Caverna\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638286&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a890fdee-3107-458a-98f8-ea828dcc5a08\', \'multiverseId\': 638286}, \'multiverseid\': 638286}, {\'name\': \'隠された火山\', \'text\': \'隠された火山はタップ状態で戦場に出る。\\n{T}：{R}を加える。\\n{4}{R}, {T}, 隠された火山を生け贄に捧げる：発見４を行う。起動はソーサリーとしてのみ行う。（マナ総量が４以下であり土地でないカード１枚が追放されるまで、あなたのライブラリーの一番上から１枚ずつ追放していく。それをマナ・コストを支払うことなく唱えるか、あなたの手札に加える。残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'土地 — 洞窟\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638607&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1acb82c2-cb8a-417b-8456-882614a56c4d\', \'multiverseId\': 638607}, \'multiverseid\': 638607}, {\'name\': \'Vulcão Escondido\', \'text\': \'Vulcão Escondido entra no campo de batalha virado.\\n{T}: Adicione {R}.\\n{4}{R}, {T}, sacrifique Vulcão Escondido: Descubra 4. Ative somente como um feitiço. (Exile cards do topo do seu grimório até exilar um card não de terreno com valor de mana igual ou inferior a 4. Conjure sem pagar o custo de mana ou coloque-o na sua mão. Coloque o restante no fundo do grimório em ordem aleatória.)\', \'type\': \'Terreno — Caverna\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638928&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ac693853-ea6f-4e5a-a42e-8ec0e1458601\', \'multiverseId\': 638928}, \'multiverseid\': 638928}, {\'name\': \'蔽匿火山\', \'text\': \'蔽匿火山须横置进战场。\\n{T}：加{R}。\\n{4}{R}，{T}，牺牲蔽匿火山：倾探4。只能于法术时机起动。（从你的牌库顶开始放逐牌，直到放逐一张法术力值等于或小于4的非地牌为止。施放之且不需支付其法术力费用，或将之置于你手上。将其余的牌以随机顺序置于你牌库底。）\', \'type\': \'地 — 洞窟\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639249&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'25bdc1f9-86c2-4753-a617-eb90496f6ffb\', \'multiverseId\': 639249}, \'multiverseid\': 639249}]', '[{\'name\': \'Versteckter Zuchtgarten\', \'text\': \'Der Versteckte Zuchtgarten kommt getappt ins Spiel.\\n{T}: Erzeuge {G}.\\n{4}{G}, {T}, opfere den Versteckten Zuchtgarten: Entdeckung 4. Aktiviere diese Fähigkeit wie eine Hexerei. (Schicke Karten oben von deiner Bibliothek ins Exil, bis du eine Nichtland-Karte mit Manabetrag 4 oder weniger ins Exil schickst. Wirke sie, ohne ihre Manakosten zu bezahlen, oder nimm sie auf deine Hand. Lege den Rest in zufälliger Reihenfolge unter die Bibliothek.)\', \'type\': \'Land — Höhle\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637322&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'38f7927b-2e17-4c52-b881-f048e888f50c\', \'multiverseId\': 637322}, \'multiverseid\': 637322}, {\'name\': \'Vivero escondido\', \'text\': \'El Vivero escondido entra al campo de batalla girado.\\n{T}: Agrega {G}.\\n{4}{G}, {T}, sacrificar el Vivero escondido: Descubre 4. Activa esto solo como un conjuro. (Exilia cartas de la parte superior de tu biblioteca hasta que exilies una carta que no sea tierra con valor de maná de 4 o menos. Lánzala sin pagar su coste de maná o ponla en tu mano. Pon el resto en el fondo en un orden aleatorio.)\', \'type\': \'Tierra — Cueva\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637643&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f2b92a17-6e74-4092-a2e0-c130649946c6\', \'multiverseId\': 637643}, \'multiverseid\': 637643}, {\'name\': \'Pépinière cachée\', \'text\': "La Pépinière cachée arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {G}.\\n{4}{G}, {T}, sacrifiez la Pépinière cachée : Découvrez 4. N\'activez que lorsque vous pourriez lancer un rituel. (Exilez les cartes du dessus de votre bibliothèque jusqu\'à ce que vous exiliez une carte non-terrain avec une valeur de mana inférieure ou égale à 4. Lancez-la sans payer son coût de mana ou mettez-la dans votre main. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.)", \'type\': \'Terrain — caverne\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637964&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0fc3c45c-d147-4c48-af95-85240fffc955\', \'multiverseId\': 637964}, \'multiverseid\': 637964}, {\'name\': \'Vivaio Celato\', \'text\': \'Il Vivaio Celato entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {G}.\\n{4}{G}, {T}, Sacrifica il Vivaio Celato: Scopri 4. Attiva solo come una stregoneria. (Esilia carte dalla cima del tuo grimorio finché non esili una carta non terra con valore di mana pari o inferiore a 4. Lanciala senza pagare il suo costo di mana o aggiungila alla tua mano. Metti le altre in fondo in ordine casuale.)\', \'type\': \'Terra — Caverna\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638285&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'92b57db3-79f6-480d-84c1-c8bf5ebbe0dd\', \'multiverseId\': 638285}, \'multiverseid\': 638285}, {\'name\': \'隠された生育場\', \'text\': \'隠された生育場はタップ状態で戦場に出る。\\n{T}：{G}を加える。\\n{4}{G}, {T}, 隠された生育場を生け贄に捧げる：発見４を行う。起動はソーサリーとしてのみ行う。（マナ総量が４以下であり土地でないカード１枚が追放されるまで、あなたのライブラリーの一番上から１枚ずつ追放していく。それをマナ・コストを支払うことなく唱えるか、あなたの手札に加える。残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'土地 — 洞窟\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638606&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c6cc3895-9f64-4b77-96c5-f45bb95de4fb\', \'multiverseId\': 638606}, \'multiverseid\': 638606}, {\'name\': \'Viveiro Escondido\', \'text\': \'Viveiro Escondido entra no campo de batalha virado.\\n{T}: Adicione {G}.\\n{4}{G}, {T}, sacrifique Viveiro Escondido: Descubra 4. Ative somente como um feitiço. (Exile cards do topo do seu grimório até exilar um card não de terreno com valor de mana igual ou inferior a 4. Conjure sem pagar o custo de mana ou coloque-o na sua mão. Coloque o restante no fundo do grimório em ordem aleatória.)\', \'type\': \'Terreno — Caverna\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638927&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ce9f5e53-0d6f-4cdb-8fda-ea0c3e3a5f43\', \'multiverseId\': 638927}, \'multiverseid\': 638927}, {\'name\': \'蔽匿苗圃\', \'text\': \'蔽匿苗圃须横置进战场。\\n{T}：加{G}。\\n{4}{G}，{T}，牺牲蔽匿苗圃：倾探4。只能于法术时机起动。（从你的牌库顶开始放逐牌，直到放逐一张法术力值等于或小于4的非地牌为止。施放之且不需支付其法术力费用，或将之置于你手上。将其余的牌以随机顺序置于你牌库底。）\', \'type\': \'地 — 洞窟\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639248&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a04336fb-781f-4a28-83a3-248792bc2ba2\', \'multiverseId\': 639248}, \'multiverseid\': 639248}]', "[{'name': 'Versteinerung', 'text': 'Verzaubert ein Artefakt oder eine Kreatur\\nDas verzauberte Permanent kann nicht angreifen oder blocken und seine aktivierten Fähigkeiten können nicht aktiviert werden.', 'type': 'Verzauberung — Aura', 'flavor': 'Jene, die die Gesetze der Malamet missachten, werden zu kalten, stummen Mahnmalen für andere, die es ebenfalls erwägen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637044&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd21bcefb-52c9-4998-9bcb-7629270f7a5b', 'multiverseId': 637044}, 'multiverseid': 637044}, {'name': 'Petrificar', 'text': 'Encantar artefacto o criatura.\\nEl permanente encantado no puede atacar ni bloquear y no pueden activarse sus habilidades activadas.', 'type': 'Encantamiento — Aura', 'flavor': 'Quienes rompen las leyes de los malamet se convierten en frías y silenciosas advertencias para otros que pretendan hacerlo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637365&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '89372430-6074-4e3f-a7dd-2c5eccd1312e', 'multiverseId': 637365}, 'multiverseid': 637365}, {'name': 'Pétrification', 'text': 'Enchanter : artefact ou créature\\nLe permanent enchanté ne peut ni attaquer ni bloquer et ses capacités activées ne peuvent pas être activées.', 'type': 'Enchantement — aura', 'flavor': 'Quiconque enfreint les lois des Malamet devient un avertissement froid et silencieux aux autres qui penseraient essayer.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637686&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd6d7db05-3ef3-4c9a-878c-9026d04dd572', 'multiverseId': 637686}, 'multiverseid': 637686}, {'name': 'Pietrificare', 'text': 'Incanta artefatto o creatura\\nIl permanente incantato non può attaccare o bloccare e le sue abilità attivate non possono essere attivate.', 'type': 'Incantesimo — Aura', 'flavor': 'Chi infrange le leggi dei Malamet viene tramutato in un freddo, silente avvertimento per chi pensa di emularlo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638007&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'dd504cbb-33fc-466c-9cab-f6a41a71a08c', 'multiverseId': 638007}, 'multiverseid': 638007}, {'name': '石化', 'text': 'エンチャント（アーティファクトやクリーチャー）\\nエンチャントしているパーマネントでは攻撃もブロックもできず、それの起動型能力は起動できない。', 'type': 'エンチャント — オーラ', 'flavor': 'マラメトの法を破る者は、物言わぬ冷たき見せしめへと変えられるだろう。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638328&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'c1ea2462-9b73-4aa4-a5d5-ef48ca6680f7', 'multiverseId': 638328}, 'multiverseid': 638328}, {'name': 'Petrificar', 'text': 'Encantar artefato ou criatura\\nA permanente encantada não pode atacar nem bloquear e suas habilidades ativadas não podem ser ativadas.', 'type': 'Encantamento — Aura', 'flavor': 'Aqueles que violam as leis dos malamet acabam virando frias e silenciosas advertências aos outros.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638649&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '95b1a62c-d0bd-49bc-9ee0-3a48adce84a5', 'multiverseId': 638649}, 'multiverseid': 638649}, {'name': '石化术', 'text': '结附于神器或生物\\n所结附的永久物不能进行攻击或阻挡，其起动式异能也不能起动。', 'type': '结界 — 灵气', 'flavor': '违反豹族法例的人都会化作冰冷沉寂的石像，警示任何心存侥幸想要尝试的后人。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638970&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '759f82dc-ac3a-4503-8015-328a7edf044b', 'multiverseId': 638970}, 'multiverseid': 638970}]", "[{'name': 'Versunkene Zitadelle', 'text': 'Die Versunkene Zitadelle kommt getappt ins Spiel. Sowie sie ins Spiel kommt, bestimme eine Farbe.\\n{T}: Erzeuge ein Mana der bestimmten Farbe.\\n{T}: Erzeuge zwei Mana der bestimmten Farbe. Gib dieses Mana nur aus, um Fähigkeiten von Länderquellen zu aktivieren.', 'type': 'Land — Höhle', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637331&type=card', 'language': 'German', 'identifiers': {'scryfallId': '02b0c681-5fd0-4e24-b930-75eb26dd28e4', 'multiverseId': 637331}, 'multiverseid': 637331}, {'name': 'Ciudadela anegada', 'text': 'La Ciudadela anegada entra al campo de batalla girada. En cuanto entre, elige un color.\\n{T}: Agrega un maná del color elegido.\\n{T}: Agrega dos manás del color elegido. Usa este maná solo para activar habilidades de fuentes tierra.', 'type': 'Tierra — Cueva', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637652&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '1ccbc28e-0bb1-4d30-ad42-08c29a951f15', 'multiverseId': 637652}, 'multiverseid': 637652}, {'name': 'Citadelle engloutie', 'text': 'La Citadelle engloutie arrive sur le champ de bataille engagée. Au moment où elle arrive, choisissez une couleur.\\n{T} : Ajoutez un mana de la couleur choisie.\\n{T} : Ajoutez deux manas de la couleur choisie. Ne dépensez ce mana que pour activer des capacités de sources terrain.', 'type': 'Terrain — caverne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637973&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e0cd8914-53e9-4bcc-9166-c3ed09cf7bb6', 'multiverseId': 637973}, 'multiverseid': 637973}, {'name': 'Cittadella Sommersa', 'text': 'La Cittadella Sommersa entra nel campo di battaglia TAPpata. Mentre entra, scegli un colore.\\n{T}: Aggiungi un mana del colore scelto.\\n{T}: Aggiungi due mana del colore scelto. Spendi questo mana solo per attivare abilità di fonti terra.', 'type': 'Terra — Caverna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638294&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '859a8c93-22ac-4840-9365-c4432342f511', 'multiverseId': 638294}, 'multiverseid': 638294}, {'name': '沈んだ城塞', 'text': '沈んだ城塞はタップ状態で戦場に出る。これが戦場に出るに際し、色１色を選ぶ。\\n{T}：その選ばれた色のマナ１点を加える。\\n{T}：その選ばれた色のマナ２点を加える。このマナは、土地である発生源の能力を起動するためにしか支払えない。', 'type': '土地 — 洞窟', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638615&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'c270a941-d354-44b8-82ab-e6b8e4561753', 'multiverseId': 638615}, 'multiverseid': 638615}, {'name': 'Cidadela Submersa', 'text': 'Cidadela Submersa entra no campo de batalha virada. Conforme Cidadela Submersa entrar no campo de batalha, escolha uma cor.\\n{T}: Adicione um mana da cor escolhida.\\n{T}: Adicione dois manas da cor escolhida. Gaste esse mana somente para ativar habilidades de fontes terreno.', 'type': 'Terreno — Caverna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638936&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '11f84384-98e5-41f1-8adb-e03939c535de', 'multiverseId': 638936}, 'multiverseid': 638936}, {'name': '沉没殿堂', 'text': '沉没殿堂须横置进战场。于它进战场时，选择一种颜色。\\n{T}：加一点该色的法术力。\\n{T}：加两点该色的法术力。此法术力只能用来起动地来源的异能。', 'type': '地 — 洞窟', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639257&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '01933418-7783-4c1d-bd3d-da3907040c29', 'multiverseId': 639257}, 'multiverseid': 639257}]", "[{'name': 'Versunkene Zitadelle', 'text': 'Die Versunkene Zitadelle kommt getappt ins Spiel. Sowie sie ins Spiel kommt, bestimme eine Farbe.\\n{T}: Erzeuge ein Mana der bestimmten Farbe.\\n{T}: Erzeuge zwei Mana der bestimmten Farbe. Gib dieses Mana nur aus, um Fähigkeiten von Länderquellen zu aktivieren.', 'type': 'Land — Höhle', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639851&type=card', 'language': 'German', 'identifiers': {'scryfallId': '49178b47-5eb2-48a5-aa84-58bc4913f1f1', 'multiverseId': 639851}, 'multiverseid': 639851}, {'name': 'Citadelle engloutie', 'text': 'La Citadelle engloutie arrive sur le champ de bataille engagée. Au moment où elle arrive, choisissez une couleur.\\n{T} : Ajoutez un mana de la couleur choisie.\\n{T} : Ajoutez deux manas de la couleur choisie. Ne dépensez ce mana que pour activer des capacités de sources terrain.', 'type': 'Terrain — caverne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639902&type=card', 'language': 'French', 'identifiers': {'scryfallId': '57e9e3d6-3d49-4a6e-962c-f95ba7408ae0', 'multiverseId': 639902}, 'multiverseid': 639902}, {'name': '沈んだ城塞', 'text': '沈んだ城塞はタップ状態で戦場に出る。これが戦場に出るに際し、色１色を選ぶ。\\n{T}：その選ばれた色のマナ１点を加える。\\n{T}：その選ばれた色のマナ２点を加える。このマナは、土地である発生源の能力を起動するためにしか支払えない。', 'type': '土地 — 洞窟', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639953&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '45524383-4a61-493f-a122-915e0c1bcb7b', 'multiverseId': 639953}, 'multiverseid': 639953}, {'name': '沉没殿堂', 'text': '沉没殿堂须横置进战场。于它进战场时，选择一种颜色。\\n{T}：加一点该色的法术力。\\n{T}：加两点该色的法术力。此法术力只能用来起动地来源的异能。', 'type': '地 — 洞窟', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=640004&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '52e9134b-4978-4227-900b-ee99c421f070', 'multiverseId': 640004}, 'multiverseid': 640004}]", '[{\'name\': \'Versunkener Schiffsrumpf // Wasserdichte Gondel\', \'text\': \'Wachsamkeit\\nAbstieg 8 — Die Wasserdichte Gondel kann nicht geblockt werden, solange dein Friedhof acht oder mehr Permanent-Karten enthält.\\nBemannen 1 (Tappe eine beliebige Anzahl an Kreaturen, die du kontrollierst und die zusammen Stärke 1 oder mehr haben: Dieses Fahrzeug wird bis zum Ende des Zuges zu einer Artefaktkreatur.)\', \'type\': \'Artefakt — Fahrzeug\', \'flavor\': None, \'faceName\': \'Wasserdichte Gondel\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637106&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ae2873f6-0817-4fe6-bd5e-639a17286e79\', \'multiverseId\': 637106}, \'multiverseid\': 637106}, {\'name\': \'Coloso anegado // Vagón hermético\', \'text\': \'Vigilancia.\\nDescender 8 — El Vagón hermético no puede ser bloqueado mientras haya ocho o más cartas de permanente en tu cementerio.\\nTripular 1. (Girar cualquier cantidad de criaturas que controlas con una fuerza total de 1 o más: Este Vehículo se convierte en una criatura artefacto hasta el final del turno.)\', \'type\': \'Artefacto — Vehículo\', \'flavor\': None, \'faceName\': \'Vagón hermético\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637427&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'30085a0c-ea15-47ed-af92-4ae635c667d6\', \'multiverseId\': 637427}, \'multiverseid\': 637427}, {\'name\': "Carcasse gorgée d\'eau // Nacelle étanche", \'text\': "Vigilance\\nDescente 8 — La Nacelle étanche ne peut pas être bloquée tant qu\'il y a au moins huit cartes de permanent dans votre cimetière.\\nPilotage 1 (Engagez n\'importe quel nombre de créatures que vous contrôlez dont la force totale est supérieure ou égale à 1 : Ce véhicule devient une créature-artefact jusqu\'à la fin du tour.)", \'type\': \'Artefact — véhicule\', \'flavor\': None, \'faceName\': \'Nacelle étanche\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637748&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'198fa35d-54a1-478d-b74e-2f494c1defb4\', \'multiverseId\': 637748}, \'multiverseid\': 637748}, {\'name\': \'Relitto Affondato // Cabina Ermetica\', \'text\': \'Cautela\\nDiscesa 8 — La Cabina Ermetica non può essere bloccata fintanto che ci sono otto o più carte permanente nel tuo cimitero.\\nManovrare 1 (TAPpa un qualsiasi numero di creature che controlli con forza totale pari o superiore a 1: Questo Veicolo diventa una creatura artefatto fino alla fine del turno.)\', \'type\': \'Artefatto — Veicolo\', \'flavor\': None, \'faceName\': \'Cabina Ermetica\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638069&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d75e4cf8-1d95-44f5-8290-c3607e9ab084\', \'multiverseId\': 638069}, \'multiverseid\': 638069}, {\'name\': \'沈没船 // 潜水ゴンドラ\', \'text\': \'警戒\\n落魄８ ― あなたの墓地に８枚以上のパーマネント・カードがあるかぎり、潜水ゴンドラはブロックされない。\\n搭乗１（あなたがコントロールしている望む数のクリーチャーを、パワーの合計が１以上になるように選んでタップする：ターン終了時まで、この機体はアーティファクト・クリーチャーになる。）\', \'type\': \'アーティファクト — 機体\', \'flavor\': None, \'faceName\': \'潜水ゴンドラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638390&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'aceb4876-20ec-432e-a73c-e7c26bb46c2a\', \'multiverseId\': 638390}, \'multiverseid\': 638390}, {\'name\': \'Brutamontes Encharcado // Gôndola Impermeável\', \'text\': \'Vigilância\\nDescer 8 — Gôndola Impermeável não pode ser bloqueada enquanto houver oito ou mais cards de permanente em seu cemitério.\\nTripular 1 (Vire qualquer número de criaturas que você controla com total de poder igual ou superior a 1: Este Veículo torna-se uma criatura artefato até o final do turno.)\', \'type\': \'Artefato — Veículo\', \'flavor\': None, \'faceName\': \'Gôndola Impermeável\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638711&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5dfdf6e5-cd62-42d8-b144-2e75930984c4\', \'multiverseId\': 638711}, \'multiverseid\': 638711}, {\'name\': \'浸水船身 // 水密吊舱\', \'text\': \'警戒\\n落坟8～只要你坟墓场中有八张或更多永久物牌，水密吊舱便不能被阻挡。\\n搭载1（横置任意数量由你操控且力量总和等于或大于1的生物：此载具成为神器生物直到回合结束。）\', \'type\': \'神器 — 载具\', \'flavor\': None, \'faceName\': \'水密吊舱\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639032&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'05363f9a-26ed-4d67-ab33-a0426891d3cc\', \'multiverseId\': 639032}, \'multiverseid\': 639032}]', '[{\'name\': \'Versunkener Schiffsrumpf // Wasserdichte Gondel\', \'text\': \'{T}: Du millst eine Karte. (Lege die oberste Karte deiner Bibliothek auf deinen Friedhof.)\\nAnfertigung mit einer Insel {3}{U} ({3}{U}, schicke dieses Artefakt ins Exil, schicke eine Insel, die du kontrollierst, oder eine Insel-Karte aus deinem Friedhof ins Exil: Bringe diese Karte transformiert unter der Kontrolle ihres Besitzers ins Spiel zurück. Spiele Anfertigung wie eine Hexerei.)\', \'type\': \'Artefakt\', \'flavor\': None, \'faceName\': \'Versunkener Schiffsrumpf\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637106&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ae2873f6-0817-4fe6-bd5e-639a17286e79\', \'multiverseId\': 637106}, \'multiverseid\': 637106}, {\'name\': \'Coloso anegado // Vagón hermético\', \'text\': \'{T}: Muele una carta. (Pon la primera carta de tu biblioteca en tu cementerio.)\\nElaborar con Isla {3}{U}. ({3}{U}, exiliar este artefacto, exiliar una Isla que controlas o una carta de Isla de tu cementerio: Regresa esta carta transformada bajo el control de su propietario. Activa la habilidad de elaborar solo como un conjuro.)\', \'type\': \'Artefacto\', \'flavor\': None, \'faceName\': \'Coloso anegado\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637427&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'30085a0c-ea15-47ed-af92-4ae635c667d6\', \'multiverseId\': 637427}, \'multiverseid\': 637427}, {\'name\': "Carcasse gorgée d\'eau // Nacelle étanche", \'text\': "{T} : Meulez une carte. (Mettez la carte du dessus de votre bibliothèque dans votre cimetière.)\\nFaçonnez avec une île {3}{U} ({3}{U}, exilez cet artefact, exilez une île que vous contrôlez ou une carte d\'île de votre cimetière : Renvoyez cette carte transformée sous le contrôle de son propriétaire. Ne façonnez que lorsque vous pourriez lancer un rituel.)", \'type\': \'Artefact\', \'flavor\': None, \'faceName\': "Carcasse gorgée d\'eau", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637748&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'198fa35d-54a1-478d-b74e-2f494c1defb4\', \'multiverseId\': 637748}, \'multiverseid\': 637748}, {\'name\': \'Relitto Affondato // Cabina Ermetica\', \'text\': "{T}: Macina una carta. (Metti nel tuo cimitero la prima carta del tuo grimorio.)\\nCostruisci con Isole {3}{U} ({3}{U}, Esilia questo artefatto, Esilia un\'Isola che controlli o una carta Isola dal tuo cimitero: Rimetti questa carta trasformata sotto il controllo del suo proprietario. Costruisci solo come una stregoneria.)", \'type\': \'Artefatto\', \'flavor\': None, \'faceName\': \'Relitto Affondato\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638069&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d75e4cf8-1d95-44f5-8290-c3607e9ab084\', \'multiverseId\': 638069}, \'multiverseid\': 638069}, {\'name\': \'沈没船 // 潜水ゴンドラ\', \'text\': \'{T}：カード１枚を切削する。（あなたのライブラリーの一番上にあるカード１枚をあなたの墓地に置く。）\\n島で作製{3}{U} （{3}{U}, このアーティファクトを追放する, あなたがコントロールしている島やあなたの墓地にある島・カードである１つを追放する：このカードをオーナーのコントロール下で変身させた状態で戻す。作製はソーサリーとしてのみ行う。）\', \'type\': \'アーティファクト\', \'flavor\': None, \'faceName\': \'沈没船\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638390&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'aceb4876-20ec-432e-a73c-e7c26bb46c2a\', \'multiverseId\': 638390}, \'multiverseid\': 638390}, {\'name\': \'Brutamontes Encharcado // Gôndola Impermeável\', \'text\': \'{T}: Triture um card. (Coloque o card do topo de seu grimório em seu cemitério.)\\nConstruir com Ilha {3}{U} ({3}{U}, exile este artefato, exile outra Ilha que você controla ou um card de Ilha de seu cemitério: Devolva este card ao campo de batalha transformado sob o controle de seu dono. Construa somente como um feitiço.)\', \'type\': \'Artefato\', \'flavor\': None, \'faceName\': \'Brutamontes Encharcado\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638711&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5dfdf6e5-cd62-42d8-b144-2e75930984c4\', \'multiverseId\': 638711}, \'multiverseid\': 638711}, {\'name\': \'浸水船身 // 水密吊舱\', \'text\': \'{T}：磨一张牌。（将你牌库顶的一张牌置入你的坟墓场。）\\n以海岛化炼{3}{U}（{3}{U}，放逐此神器，放逐一个由你操控的海岛或一张你坟墓场中的海岛牌：将此牌在其拥有者的操控下移回且已转化。只能于法术时机化炼。）\', \'type\': \'神器\', \'flavor\': None, \'faceName\': \'浸水船身\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639032&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'05363f9a-26ed-4d67-ab33-a0426891d3cc\', \'multiverseId\': 639032}, \'multiverseid\': 639032}]', '[{\'name\': \'Verwirrendes Rätsel\', \'text\': \'Bestimme eines —\\n• Schaue dir die obersten vier Karten deiner Bibliothek an. Nimm eine davon auf deine Hand und lege den Rest auf deinen Friedhof.\\n• Neutralisiere einen Zauberspruch deiner Wahl, es sei denn, sein Beherrscher bezahlt {4}.\', \'type\': \'Spontanzauber\', \'flavor\': \'Die Entdecker lernten schnell, nicht an Stätten uralter Macht herumzupfuschen, ohne zuerst ihren Zweck in Erfahrung zu bringen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637068&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a3da6ada-28cb-4d3b-b779-434f8ec64f33\', \'multiverseId\': 637068}, \'multiverseid\': 637068}, {\'name\': \'Acertijo confuso\', \'text\': \'Elige uno:\\n• Mira las cuatro primeras cartas de tu biblioteca. Pon una de ellas en tu mano y el resto en tu cementerio.\\n• Contrarresta el hechizo objetivo a menos que su controlador pague {4}.\', \'type\': \'Instantáneo\', \'flavor\': \'Los exploradores aprendieron a no toquetear los lugares con poderes antiguos sin entender antes su propósito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637389&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8b3ffcfb-ee4d-492d-9e4a-e32a078bf604\', \'multiverseId\': 637389}, \'multiverseid\': 637389}, {\'name\': \'Mystère déroutant\', \'text\': "Choisissez l\'un —\\n• Regardez les quatre cartes du dessus de votre bibliothèque. Mettez l\'une d\'elles dans votre main et le reste dans votre cimetière.\\n• Contrecarrez un sort ciblé à moins que son contrôleur ne paie {4}.", \'type\': \'Éphémère\', \'flavor\': \'Les explorateurs apprirent à ne pas toucher aux sites anciens puissants sans connaître leur rôle passé.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637710&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d5bc6411-0fe9-491a-9251-020c7d62acfb\', \'multiverseId\': 637710}, \'multiverseid\': 637710}, {\'name\': \'Enigma Frustrante\', \'text\': \'Scegli uno —\\n• Guarda le prime quattro carte del tuo grimorio. Aggiungine una alla tua mano e metti le altre nel tuo cimitero.\\n• Neutralizza una magia bersaglio a meno che il suo controllore non paghi {4}.\', \'type\': \'Istantaneo\', \'flavor\': \'Gli esploratori impararono a non toccare i luoghi di antico potere senza prima comprenderne lo scopo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638031&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'48a413b4-e2fb-4b43-88a5-f79eae682592\', \'multiverseId\': 638031}, \'multiverseid\': 638031}, {\'name\': \'困惑の謎掛け\', \'text\': \'以下から１つを選ぶ。\\n・あなたのライブラリーの一番上にあるカード４枚を見る。そのうち１枚をあなたの手札に、残りをあなたの墓地に置く。\\n・呪文１つを対象とする。それのコントローラーが{4}を支払わないかぎり、それを打ち消す。\', \'type\': \'インスタント\', \'flavor\': \'探検隊は、古代の力が眠る遺跡に向こうの魂胆も知らないままちょっかいを出すべきではないと思い知らされた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638352&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'480d5397-a019-4385-8e7a-9a08e39b6ae5\', \'multiverseId\': 638352}, \'multiverseid\': 638352}, {\'name\': \'Charada Confusa\', \'text\': \'Escolha um —\\n• Olhe os quatro cards do topo do seu grimório. Coloque um deles em sua mão e o restante em seu cemitério.\\nAnule a mágica alvo, a menos que seu controlador pague {4}.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os exploradores aprendiam a não mexer com locais de poder antigo antes de descobrir seu propósito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638673&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1200e5a4-2c69-4315-a4e7-33eb75c03d74\', \'multiverseId\': 638673}, \'multiverseid\': 638673}, {\'name\': \'致乱谜题\', \'text\': \'选择一项～\\n•检视你牌库顶的四张牌。将其中一张置于你手上，其余则置入你的坟墓场。\\n•除非目标咒语的操控者支付{4}，否则反击之。\', \'type\': \'瞬间\', \'flavor\': \'探险队早已学会，在没弄清楚召力古迹的用途前，不要乱碰其中任何物品。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638994&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e4e32686-cbd4-4582-a157-b0d85790277d\', \'multiverseId\': 638994}, \'multiverseid\': 638994}]', '[{\'name\': \'Verwüstendes Brontodon\', \'text\': \'{1}, opfere das Verwüstende Brontodon: Zerstöre ein Artefakt oder eine Verzauberung deiner Wahl.\', \'type\': \'Kreatur — Dinosaurier\', \'flavor\': \'„Dann müssen wir wohl hoffen, dass diese uralten Monolithen, die unserem Volk seit Jahrhunderten als verschollen galten, nicht so wichtig waren."\\n—Toxayac, Historiker des Imperiums der Sonne\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637256&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c0ef5ff0-f19d-4ccd-ab8a-1abec4529944\', \'multiverseId\': 637256}, \'multiverseid\': 637256}, {\'name\': \'Brontodón aplastador\', \'text\': \'{1}, sacrificar el Brontodón aplastador: Destruye el artefacto o encantamiento objetivo.\', \'type\': \'Criatura — Dinosaurio\', \'flavor\': \'"Solo nos queda esperar que esos monolitos antiguos extraviados por nuestro pueblo durante siglos no fueran muy importantes".\\n—Toxayac, cronista del Imperio del Sol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637577&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f0f12107-74c7-4287-af26-17b93c7a2078\', \'multiverseId\': 637577}, \'multiverseid\': 637577}, {\'name\': \'Brontodonte farouche\', \'text\': \'{1}, sacrifiez le Brontodonte farouche : Détruisez une cible, artefact ou enchantement.\', \'type\': \'Créature — dinosaure\', \'flavor\': "« Je suppose que nous devons espérer que ces anciens monolithes de nos aïeux perdus pendant des siècles n\'étaient pas particulièrement importants. »\\n—Toxayac, historien de l\'Empire du Soleil", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637898&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'333e5a48-03a7-4a07-a150-259b3922abae\', \'multiverseId\': 637898}, \'multiverseid\': 637898}, {\'name\': \'Brontodonte Devastatore\', \'text\': \'{1}, Sacrifica il Brontodonte Devastatore: Distruggi un artefatto o un incantesimo bersaglio.\', \'type\': \'Creatura — Dinosauro\', \'flavor\': \'"Speriamo che quegli antichi monoliti che la nostra gente cercava da secoli non fossero troppo importanti."\\n—Toxayac, storico dell\\\'Impero del Sole\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638219&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a3e3d5c6-2e09-4526-b359-bebbbe87f0c2\', \'multiverseId\': 638219}, \'multiverseid\': 638219}, {\'name\': \'打ち壊すブロントドン\', \'text\': \'{1}, 打ち壊すブロントドンを生け贄に捧げる：アーティファクトやエンチャントである１つを対象とする。それを破壊する。\', \'type\': \'クリーチャー — 恐竜\', \'flavor\': \'「数世紀も失われていた古代の石柱だったんだが、大した内容が刻まれていなかったことを祈るとしよう。」\\n――太陽帝国の歴史家、トシャヤク\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638540&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bb1ac4cc-f536-4505-8627-8b3f72be62f0\', \'multiverseId\': 638540}, \'multiverseid\': 638540}, {\'name\': \'Brontodonte Destruidor\', \'text\': \'{1}, sacrifique Brontodonte Destruidor: Destrua o artefato ou encantamento alvo.\', \'type\': \'Criatura — Dinossauro\', \'flavor\': \'"Suponho que só nos resta a esperança de que aqueles monólitos antigos perdidos para o nosso povo por séculos não fossem particularmente importantes."\\n— Toxayac, historiador do Império do Sol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638861&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ca7047c7-0d7c-4ef9-8485-6f07142b3542\', \'multiverseId\': 638861}, \'multiverseid\': 638861}, {\'name\': \'痛击霆伟龙\', \'text\': \'{1}，牺牲痛击霆伟龙：消灭目标神器或结界。\', \'type\': \'生物 — 恐龙\', \'flavor\': \'「我觉得，就只希望这些失落我们人民手中千百年之久的远古巨石没那么重要好了。」\\n～烈阳帝国史家托夏亚\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639182&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'17e816f1-a2c9-4f98-bcf4-cfbeecb40da9\', \'multiverseId\': 639182}, \'multiverseid\': 639182}]', "[{'name': 'Verwüstendes Brontodon', 'text': '{1}, opfere das Verwüstende Brontodon: Zerstöre ein Artefakt oder eine Verzauberung deiner Wahl.', 'type': 'Kreatur — Dinosaurier', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639588&type=card', 'language': 'German', 'identifiers': {'scryfallId': '3324e203-773b-41c9-96ab-a23c6374d4eb', 'multiverseId': 639588}, 'multiverseid': 639588}, {'name': 'Brontodón aplastador', 'text': '{1}, sacrificar el Brontodón aplastador: Destruye el artefacto o encantamiento objetivo.', 'type': 'Criatura — Dinosaurio', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639601&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e01f6a5d-7192-4b97-9a3c-b09320e993f7', 'multiverseId': 639601}, 'multiverseid': 639601}, {'name': 'Brontodonte farouche', 'text': '{1}, sacrifiez le Brontodonte farouche : Détruisez une cible, artefact ou enchantement.', 'type': 'Créature — dinosaure', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639614&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b85dc11b-4a24-4f4d-890e-ff312cbb514f', 'multiverseId': 639614}, 'multiverseid': 639614}, {'name': 'Brontodonte Devastatore', 'text': '{1}, Sacrifica il Brontodonte Devastatore: Distruggi un artefatto o un incantesimo bersaglio.', 'type': 'Creatura — Dinosauro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639627&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '365725f6-705b-459c-921a-eaf74af7f2ed', 'multiverseId': 639627}, 'multiverseid': 639627}, {'name': '打ち壊すブロントドン', 'text': '{1}, 打ち壊すブロントドンを生け贄に捧げる：アーティファクトやエンチャントである１つを対象とする。それを破壊する。', 'type': 'クリーチャー — 恐竜', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639640&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '94a20f60-a8d2-43a6-b731-c25efcd3bdee', 'multiverseId': 639640}, 'multiverseid': 639640}, {'name': 'Brontodonte Destruidor', 'text': '{1}, sacrifique Brontodonte Destruidor: Destrua o artefato ou encantamento alvo.', 'type': 'Criatura — Dinossauro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639653&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '6fca1abb-996a-4b90-aa10-56340a6ad434', 'multiverseId': 639653}, 'multiverseid': 639653}, {'name': '痛击霆伟龙', 'text': '{1}，牺牲痛击霆伟龙：消灭目标神器或结界。', 'type': '生物 — 恐龙', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639666&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '0d844618-240f-485a-b1d1-5853afa9dc8f', 'multiverseId': 639666}, 'multiverseid': 639666}]", '[{\'name\': \'Vielversprechende Ader\', \'text\': \'{T}: Erzeuge {C}.\\n{1}, {T}, opfere die Vielversprechende Ader: Durchsuche deine Bibliothek nach einer Standardland-Karte, bringe sie getappt ins Spiel und mische danach.\', \'type\': \'Land — Höhle\', \'flavor\': \'Vereint unter dem Banner der Tollkühnen Koalition ließen die Piraten ihre Fehden ruhen, um die Schätze der Inneren Welt zu erbeuten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637325&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5a59c2ae-f4b9-4921-a5b4-b06dcabdf895\', \'multiverseId\': 637325}, \'multiverseid\': 637325}, {\'name\': \'Filón prometedor\', \'text\': \'{T}: Agrega {C}.\\n{1}, {T}, sacrificar el Filón prometedor: Busca en tu biblioteca una carta de tierra básica, ponla en el campo de batalla girada y luego baraja.\', \'type\': \'Tierra — Cueva\', \'flavor\': \'Unidos bajo la bandera de la Coalición Azófar, los piratas dejaron de lado sus contiendas para saquear el botín subterráneo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637646&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'de84436f-28de-4661-8f76-76e00cd926d5\', \'multiverseId\': 637646}, \'multiverseid\': 637646}, {\'name\': \'Veine prometteuse\', \'text\': \'{T} : Ajoutez {C}.\\n{1}, {T}, sacrifiez la Veine prometteuse : Cherchez dans votre bibliothèque une carte de terrain de base, mettez-la sur le champ de bataille engagée, puis mélangez.\', \'type\': \'Terrain — caverne\', \'flavor\': \'Unis sous la bannière de la Coalition des hardis, les pirates mirent de côté leurs querelles pour piller le trésor souterrain.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637967&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b8e2e99b-5502-42a6-8d06-354fd3ec3f37\', \'multiverseId\': 637967}, \'multiverseid\': 637967}, {\'name\': \'Vena Promettente\', \'text\': \'{T}: Aggiungi {C}.\\n{1}, {T}, Sacrifica la Vena Promettente: Passa in rassegna il tuo grimorio per una carta terra base, mettila sul campo di battaglia TAPpata, poi rimescola.\', \'type\': \'Terra — Caverna\', \'flavor\': "Uniti sotto lo stendardo dell\'Alleanza di Bronzo, i pirati misero da parte le loro rivalità per saccheggiare i bottini del sottosuolo.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638288&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d03c09c0-ea5c-4282-9350-32bfb5f667ff\', \'multiverseId\': 638288}, \'multiverseid\': 638288}, {\'name\': \'有望な鉱脈\', \'text\': \'{T}：{C}を加える。\\n{1}, {T}, 有望な鉱脈を生け贄に捧げる：あなたのライブラリーから基本土地・カード１枚を探し、タップ状態で戦場に出す。その後、ライブラリーを切り直す。\', \'type\': \'土地 — 洞窟\', \'flavor\': \'鉄面連合の旗のもとに集った海賊たちは、争いをやめ、共に地下に眠る財宝を目指すのだった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638609&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5d84e023-d607-465e-89f3-2f6292928694\', \'multiverseId\': 638609}, \'multiverseid\': 638609}, {\'name\': \'Veio Promissor\', \'text\': \'{T}: Adicione {C}.\\n{1}, {T}, sacrifique Veio Promissor: Procure em seu grimório um card de terreno básico, coloque-o no campo de batalha virado e depois embaralhe.\', \'type\': \'Terreno — Caverna\', \'flavor\': \'Unidos sob o estandarte da Coalizão Brônzea, piratas deixam suas rixas de lado para saquear as riquezas subterrâneas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638930&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a5cf0522-f797-4698-9fce-6ec78a598e0c\', \'multiverseId\': 638930}, \'multiverseid\': 638930}, {\'name\': \'诱人矿脉\', \'text\': \'{T}：加{C}。\\n{1}，{T}，牺牲诱人矿脉：从你牌库中搜寻一张基本地牌，将之横置放进战场，然后洗牌。\', \'type\': \'地 — 洞窟\', \'flavor\': \'海盗们抛弃世仇，团结在莽霸联盟的旗帜下，共同劫掠地底财宝。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639251&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'799dac52-a318-457d-ad9e-1edd7c62241a\', \'multiverseId\': 639251}, \'multiverseid\': 639251}]', '[{\'name\': \'Vitale Glyphe\', \'text\': \'Verzaubert ein Artefakt\\nDas verzauberte Artefakt ist zusätzlich zu seinen anderen Typen eine Golem-Kreatur mit Basis-Stärke und -Widerstandskraft 5/4.\\nWenn die Vitale Glyphe aus dem Spiel auf einen Friedhof gelegt wird, wende Entdeckung 3 an.\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637110&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9ab75d96-0667-4914-9b77-b7d0fc84b8ac\', \'multiverseId\': 637110}, \'multiverseid\': 637110}, {\'name\': \'Glifo zoético\', \'text\': \'Encantar artefacto.\\nEl artefacto encantado es una criatura Gólem con fuerza y resistencia base de 5/4 además de sus otros tipos.\\nCuando el Glifo zoético vaya a un cementerio desde el campo de batalla, descubre 3.\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637431&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4a0b6b89-d8f7-4bb8-94a1-af5c109860e2\', \'multiverseId\': 637431}, \'multiverseid\': 637431}, {\'name\': \'Glyphe zoétique\', \'text\': "Enchanter : artefact\\nL\'artefact enchanté est une créature Golem avec une force et une endurance de base de 5/4 en plus de ses autres types.\\nQuand le Glyphe zoétique est mis dans un cimetière depuis le champ de bataille, découvrez 3.", \'type\': \'Enchantement — aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637752&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1bc60c2e-1f23-4916-ba18-83d1b03f59d2\', \'multiverseId\': 637752}, \'multiverseid\': 637752}, {\'name\': \'Glifo Zootico\', \'text\': "Incanta artefatto\\nL\'artefatto incantato è una creatura Golem con forza e costituzione base 5/4 in aggiunta ai suoi altri tipi.\\nQuando il Glifo Zootico viene messo in un cimitero dal campo di battaglia, scopri 3.", \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638073&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'82af8798-bad9-4ed4-b2e9-9bc572d652c9\', \'multiverseId\': 638073}, \'multiverseid\': 638073}, {\'name\': \'生命ある象形\', \'text\': \'エンチャント（アーティファクト）\\nエンチャントしているアーティファクトは、他のタイプに加えてゴーレム・クリーチャーであり、基本のパワーとタフネスは５/４である。\\n生命ある象形が戦場から墓地に置かれたとき、発見３を行う。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638394&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5df8ecc6-2597-4b87-9865-3f8a763bd596\', \'multiverseId\': 638394}, \'multiverseid\': 638394}, {\'name\': \'Glifo Zoético\', \'text\': \'Encantar artefato\\nO artefato encantado é uma criatura Golem com poder e resistência básicos 5/4 além de seus outros tipos.\\nQuando Glifo Zoético for colocado em um cemitério vindo do campo de batalha, descubra 3.\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638715&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b553a6fc-5856-4dd1-b603-9974714dad7b\', \'multiverseId\': 638715}, \'multiverseid\': 638715}, {\'name\': \'生机雕符\', \'text\': \'结附于神器\\n所结附的神器是基础力量与防御力为5/4的魔像生物，且仍具有原本类别。\\n当生机雕符从战场进入坟墓场时，倾探3。\', \'type\': \'结界 — 灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639036&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'aa866017-ad02-4420-b9c6-76b74b5bf06d\', \'multiverseId\': 639036}, \'multiverseid\': 639036}]', '[{\'name\': \'Vito, Fanatiker des Aclazotz\', \'text\': \'Fliegend\\nImmer wenn du ein anderes Permanent opferst, erhältst du 2 Lebenspunkte dazu, falls es das erste Mal ist, dass diese Fähigkeit in diesem Zug verrechnet wird. Falls es das zweite Mal ist, verliert jeder Gegner 2 Lebenspunkte. Falls es das dritte Mal ist, erzeuge einen 4/3 weißen und schwarzen Vampir-Dämon-Kreaturenspielstein mit Flugfähigkeit.\', \'type\': \'Legendäre Kreatur — Vampir, Dämon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636543&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'474db6c5-562c-448b-a2b3-b633d9dda8f0\', \'multiverseId\': 636543}, \'multiverseid\': 636543}, {\'name\': \'Vito, fanático de Aclazotz\', \'text\': \'Vuela.\\nSiempre que sacrifiques otro permanente, ganas 2 vidas si es la primera vez que esta habilidad se resolvió este turno. Si es la segunda vez, cada oponente pierde 2 vidas. Si es la tercera vez, crea una ficha de criatura Demonio Vampiro blanca y negra 4/3 con la habilidad de volar.\', \'type\': \'Criatura legendaria — Demonio vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636567&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'662c93f9-c642-42a6-b58c-982940f45ea6\', \'multiverseId\': 636567}, \'multiverseid\': 636567}, {\'name\': "Vito, fanatique d\'Aclazotz", \'text\': "Vol\\nÀ chaque fois que vous sacrifiez un autre permanent, vous gagnez 2 points de vie si c\'est la première fois que cette capacité s\'est résolue ce tour-ci. Si c\'est la deuxième fois, chaque adversaire perd 2 points de vie. Si c\'est la troisième fois, créez un jeton de créature 4/3 blanche et noire Vampire et Démon avec le vol.", \'type\': \'Créature légendaire — vampire et démon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636591&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b1f27dc9-b1a3-4dd4-9355-c24c9eee5cba\', \'multiverseId\': 636591}, \'multiverseid\': 636591}, {\'name\': \'Vitor, Fanatico di Aclazotz\', \'text\': \'Volare\\nOgniqualvolta sacrifichi un altro permanente, guadagni 2 punti vita se è la prima volta che questa abilità si è risolta in questo turno. Se è la seconda volta, ogni avversario perde 2 punti vita. Se è la terza volta, crea una pedina creatura Demone Vampiro 4/3 bianca e nera con volare.\', \'type\': \'Creatura Leggendaria — Demone Vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636615&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e3e70d7f-f839-4d4a-8d50-7fca8511b66c\', \'multiverseId\': 636615}, \'multiverseid\': 636615}, {\'name\': \'アクロゾズの狂信者、ヴィト\', \'text\': \'飛行\\nあなたがこれでないパーマネント１つを生け贄に捧げるたび、このターンで初めてこの能力が解決されるなら、あなたは２点のライフを得る。２度目なら、各対戦相手はそれぞれ２点のライフを失う。３度目なら、飛行を持つ白黒の４/３の吸血鬼・デーモン・クリーチャー・トークン１体を生成する。\', \'type\': \'伝説のクリーチャー — 吸血鬼・デーモン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636639&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0a52c72c-44b2-4bb7-bf14-f954b3860681\', \'multiverseId\': 636639}, \'multiverseid\': 636639}, {\'name\': \'Vito, Fanático de Aclazotz\', \'text\': \'Voar\\nToda vez que você sacrifica outra permanente, você ganha 2 pontos de vida se essa for a primeira vez que essa habilidade é resolvida neste turno. Se for a segunda vez, cada oponente perde 2 pontos de vida. Se for a terceira vez, crie uma ficha de criatura Vampiro Demônio branca e preta 4/3 com voar.\', \'type\': \'Criatura Lendária — Vampiro Demônio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636663&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ad4286aa-75a1-4dfa-879d-c128c028dc27\', \'multiverseId\': 636663}, \'multiverseid\': 636663}, {\'name\': \'阿洛佐兹狂徒维托\', \'text\': \'飞行\\n每当你牺牲另一个永久物时，如果这是此异能在本回合第一次的结算，则你获得2点生命。如果是第二次的结算，则每位对手各失去2点生命。如果是第三次的结算，则派出一个4/3，白黑双色，具飞行异能的吸血鬼／恶魔衍生生物。\', \'type\': \'传奇生物 — 吸血鬼／恶魔\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636687&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b35f5a64-82b8-40ac-a9da-7a34ae74e1c6\', \'multiverseId\': 636687}, \'multiverseid\': 636687}]', '[{\'name\': \'Vito, Fanatiker des Aclazotz\', \'text\': \'Fliegend\\nImmer wenn du ein anderes Permanent opferst, erhältst du 2 Lebenspunkte dazu, falls es das erste Mal ist, dass diese Fähigkeit in diesem Zug verrechnet wird. Falls es das zweite Mal ist, verliert jeder Gegner 2 Lebenspunkte. Falls es das dritte Mal ist, erzeuge einen 4/3 weißen und schwarzen Vampir-Dämon-Kreaturenspielstein mit Flugfähigkeit.\', \'type\': \'Legendäre Kreatur — Vampir, Dämon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637285&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0521c58b-00a0-482d-a405-bbcfa31787fd\', \'multiverseId\': 637285}, \'multiverseid\': 637285}, {\'name\': \'Vito, fanático de Aclazotz\', \'text\': \'Vuela.\\nSiempre que sacrifiques otro permanente, ganas 2 vidas si es la primera vez que esta habilidad se resolvió este turno. Si es la segunda vez, cada oponente pierde 2 vidas. Si es la tercera vez, crea una ficha de criatura Demonio Vampiro blanca y negra 4/3 con la habilidad de volar.\', \'type\': \'Criatura legendaria — Demonio vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637606&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'94fb30a3-fdd7-4963-beb0-f0d9a05a6373\', \'multiverseId\': 637606}, \'multiverseid\': 637606}, {\'name\': "Vito, fanatique d\'Aclazotz", \'text\': "Vol\\nÀ chaque fois que vous sacrifiez un autre permanent, vous gagnez 2 points de vie si c\'est la première fois que cette capacité s\'est résolue ce tour-ci. Si c\'est la deuxième fois, chaque adversaire perd 2 points de vie. Si c\'est la troisième fois, créez un jeton de créature 4/3 blanche et noire Vampire et Démon avec le vol.", \'type\': \'Créature légendaire — vampire et démon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637927&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'be6b35fa-2895-4410-8f82-eebadc150680\', \'multiverseId\': 637927}, \'multiverseid\': 637927}, {\'name\': \'Vitor, Fanatico di Aclazotz\', \'text\': \'Volare\\nOgniqualvolta sacrifichi un altro permanente, guadagni 2 punti vita se è la prima volta che questa abilità si è risolta in questo turno. Se è la seconda volta, ogni avversario perde 2 punti vita. Se è la terza volta, crea una pedina creatura Demone Vampiro 4/3 bianca e nera con volare.\', \'type\': \'Creatura Leggendaria — Demone Vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638248&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'95ac2c6d-6018-40f1-a2b5-64bdb02f45e5\', \'multiverseId\': 638248}, \'multiverseid\': 638248}, {\'name\': \'アクロゾズの狂信者、ヴィト\', \'text\': \'飛行\\nあなたがこれでないパーマネント１つを生け贄に捧げるたび、このターンで初めてこの能力が解決されるなら、あなたは２点のライフを得る。２度目なら、各対戦相手はそれぞれ２点のライフを失う。３度目なら、飛行を持つ白黒の４/３の吸血鬼・デーモン・クリーチャー・トークン１体を生成する。\', \'type\': \'伝説のクリーチャー — 吸血鬼・デーモン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638569&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e439e672-2a89-425d-b4c8-3edf0e64626d\', \'multiverseId\': 638569}, \'multiverseid\': 638569}, {\'name\': \'Vito, Fanático de Aclazotz\', \'text\': \'Voar\\nToda vez que você sacrifica outra permanente, você ganha 2 pontos de vida se essa for a primeira vez que essa habilidade é resolvida neste turno. Se for a segunda vez, cada oponente perde 2 pontos de vida. Se for a terceira vez, crie uma ficha de criatura Vampiro Demônio branca e preta 4/3 com voar.\', \'type\': \'Criatura Lendária — Vampiro Demônio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638890&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'22c5ec6f-c86f-48c6-bba4-6a00621a0b38\', \'multiverseId\': 638890}, \'multiverseid\': 638890}, {\'name\': \'阿洛佐兹狂徒维托\', \'text\': \'飞行\\n每当你牺牲另一个永久物时，如果这是此异能在本回合第一次的结算，则你获得2点生命。如果是第二次的结算，则每位对手各失去2点生命。如果是第三次的结算，则派出一个4/3，白黑双色，具飞行异能的吸血鬼／恶魔衍生生物。\', \'type\': \'传奇生物 — 吸血鬼／恶魔\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639211&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f5ad4a15-224f-4a57-9938-0f654885a1a2\', \'multiverseId\': 639211}, \'multiverseid\': 639211}]', '[{\'name\': \'Vitos Inquisitorin\', \'text\': \'{B}, opfere eine andere Kreatur oder ein anderes Artefakt: Lege eine +1/+1-Marke auf Vitos Inquisitorin. Sie erhält Bedrohlichkeit bis zum Ende des Zuges.\', \'type\': \'Kreatur — Vampir, Ritter\', \'flavor\': \'„Wir läuten das Zeitalter des Unerschöpflichen Blutes ein. Jene, von denen gezehrt wird, werden genährt sein und jene, die zehren, werden gesättigt sein."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637159&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'81c42a87-ee39-4a6a-8704-08504697ee16\', \'multiverseId\': 637159}, \'multiverseid\': 637159}, {\'name\': \'Inquisidora de Vito\', \'text\': \'{B}, sacrificar otra criatura o artefacto: Pon un contador +1/+1 sobre la Inquisidora de Vito. Gana la habilidad de amenaza hasta el final del turno.\', \'type\': \'Criatura — Caballero vampiro\', \'flavor\': \'"Entramos en la Era de la Sangre Eterna, en la que aquellos que se alimentan se saciarán con aquellos que sirven de alimento".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637480&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'808f03ff-8ff4-450e-8362-b6182d69d75f\', \'multiverseId\': 637480}, \'multiverseid\': 637480}, {\'name\': \'Inquisitrice de Vito\', \'text\': "{B}, sacrifiez une autre créature ou un autre artefact : Mettez un marqueur +1/+1 sur l\'Inquisitrice de Vito. Elle acquiert la menace jusqu\'à la fin du tour.", \'type\': \'Créature — vampire et chevalier\', \'flavor\': "« Nous annonçons l\'Ère du Sang toujours ruisselant, où ceux qui sont nourriture seront nourris, et où ceux qui se nourrissent seront rassasiés. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637801&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0a263c11-e491-486b-ad49-3b47de9ce54f\', \'multiverseId\': 637801}, \'multiverseid\': 637801}, {\'name\': \'Inquisitrice di Vitor\', \'text\': "{B}, Sacrifica un\'altra creatura o artefatto: Metti un segnalino +1/+1 sull\'Inquisitrice di Vitor. Ha minacciare fino alla fine del turno.", \'type\': \'Creatura — Cavaliere Vampiro\', \'flavor\': \'"Inauguriamo l\\\'Era del Sangue Traboccante, dove coloro che sono preda diventeranno nutrimento e coloro che si nutrono saranno saziati."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638122&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fa23de94-8b7b-41f9-a036-ee5dee35ecaa\', \'multiverseId\': 638122}, \'multiverseid\': 638122}, {\'name\': \'ヴィトの審問官\', \'text\': \'{B}, クリーチャーやアーティファクトでありこれでない１つを生け贄に捧げる：ヴィトの審問官の上に＋１/＋１カウンター１個を置く。ターン終了時まで、これは威迫を得る。\', \'type\': \'クリーチャー — 吸血鬼・騎士\', \'flavor\': \'「溢れる血の時代は来たれり。喰われるものは喰らわれ、喰らうものは満たされる。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638443&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3b10924a-84a1-4262-b542-7491ad3adabc\', \'multiverseId\': 638443}, \'multiverseid\': 638443}, {\'name\': \'Inquisidora de Vito\', \'text\': \'{B}, sacrifique outra criatura ou outro artefato: Coloque um marcador +1/+1 em Inquisidora de Vito. Ele ganha ameaçar até o final do turno.\', \'type\': \'Criatura — Vampiro Cavaleiro\', \'flavor\': \'"Trazemos a Idade do Sangue Transbordante, quando o alimento será alimentado e os que se alimentam serão saciados."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638764&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3e845b6b-d92f-480d-91f1-e642083f107e\', \'multiverseId\': 638764}, \'multiverseid\': 638764}, {\'name\': \'维托的审判官\', \'text\': \'{B}，牺牲另一个生物或神器：在维托的审判官上放置一个+1/+1指示物。它获得威慑异能直到回合结束。\', \'type\': \'生物 — 吸血鬼／骑士\', \'flavor\': \'「我们行将开创朱光时代，觅食者终饱餐无忧，喂食者亦性命无愁。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639085&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'32e55146-250d-4852-a33b-f1528f76d66f\', \'multiverseId\': 639085}, \'multiverseid\': 639085}]', '[{\'name\': \'Vorhut der Rose\', \'text\': \'{1}, opfere eine andere Kreatur oder ein anderes Artefakt: Die Vorhut der Rose erhält Unzerstörbarkeit bis zum Ende des Zuges. Tappe sie.\', \'type\': \'Kreatur — Vampir, Ritter\', \'flavor\': \'„Keine einzelne Seele kann mehr wert sein als das Wohl Torrezons. Vorwärts."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637059&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4b377e4e-7745-4901-a1a1-c4526661dc37\', \'multiverseId\': 637059}, \'multiverseid\': 637059}, {\'name\': \'Vanguardia de la Rosa\', \'text\': \'{1}, sacrificar otra criatura o artefacto: La Vanguardia de la Rosa gana la habilidad de indestructible hasta el final del turno. Gírala.\', \'type\': \'Criatura — Caballero vampiro\', \'flavor\': \'"Ningún alma vale más que la salvación de Torrezón. Sigamos".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637380&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1fe4a6d5-c196-4e14-8ad6-0d8f0a61f2ac\', \'multiverseId\': 637380}, \'multiverseid\': 637380}, {\'name\': \'Avant-garde de la Rose\', \'text\': "{1}, sacrifiez une autre créature ou un autre artefact : L\'Avant-garde de la Rose acquiert l\'indestructible jusqu\'à la fin du tour. Engagez-la.", \'type\': \'Créature — vampire et chevalier\', \'flavor\': "« Nulle âme n\'a plus de valeur que sauver Torrezon. Avancez. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637701&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'25664b3e-6a2c-4fd6-b4e9-fb514b048aba\', \'multiverseId\': 637701}, \'multiverseid\': 637701}, {\'name\': \'Avanguardia della Rosa\', \'text\': "{1}, Sacrifica un\'altra creatura o artefatto: L\'Avanguardia della Rosa ha indistruttibile fino alla fine del turno. TAPpala.", \'type\': \'Creatura — Cavaliere Vampiro\', \'flavor\': \'"Non c\\\'è anima che valga più della salvezza di Torrezon. Procedete."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638022&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7235675b-9ae1-4bd2-884c-ae76b4bfa6d2\', \'multiverseId\': 638022}, \'multiverseid\': 638022}, {\'name\': \'薔薇の先兵\', \'text\': \'{1}, クリーチャーやアーティファクトでありこれでない１つを生け贄に捧げる：ターン終了時まで、薔薇の先兵は破壊不能を得る。これをタップする。\', \'type\': \'クリーチャー — 吸血鬼・騎士\', \'flavor\': \'「トレゾンの救いより価値のある命などない。押し進め。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638343&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7996d5c4-0312-4f0c-97d5-2fd5d64f6e3c\', \'multiverseId\': 638343}, \'multiverseid\': 638343}, {\'name\': \'Vanguarda da Rosa\', \'text\': \'{1}, sacrifique outra criatura ou outro artefato: Vanguarda da Rosa ganha indestrutível até o final do turno. Vire-o.\', \'type\': \'Criatura — Vampiro Cavaleiro\', \'flavor\': \'"Nenhuma alma vale mais que a salvação de Torrezon. Avante."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638664&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'42b5cefd-805b-4eed-adf1-51eafe12968e\', \'multiverseId\': 638664}, \'multiverseid\': 638664}, {\'name\': \'蔷薇先锋\', \'text\': \'{1}，牺牲另一个生物或神器：蔷薇先锋获得不灭异能直到回合结束。将它横置。\', \'type\': \'生物 — 吸血鬼／骑士\', \'flavor\': \'「没有谁的灵魂比救赎图瑞琮更重要。继续前进。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638985&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2bba3a39-7eab-446a-a6e8-14892bd4a9c4\', \'multiverseId\': 638985}, \'multiverseid\': 638985}]', '[{\'name\': \'Wabernde Emergenz\', \'text\': \'Bodenloser Abstieg — Bringe eine Nichtland-Permanent-Karte deiner Wahl mit Manabetrag kleiner oder gleich der Anzahl an Permanent-Karten in deinem Friedhof aus deinem Friedhof ins Spiel zurück.\', \'type\': \'Hexerei\', \'flavor\': \'Wegen veralteter Regeln der Tollkühnen Koalition bezüglich des Tragens von Hüten sind einige Mykoiden nun streng genommen Piratenkapitäne.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637283&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ee2d2760-3b4b-4124-9007-9e24d8394d00\', \'multiverseId\': 637283}, \'multiverseid\': 637283}, {\'name\': \'Aparición tentacular\', \'text\': \'Descenso abismal — Regresa al campo de batalla la carta de permanente objetivo que no sea tierra en tu cementerio con valor de maná menor o igual que la cantidad de cartas de permanente en tu cementerio.\', \'type\': \'Conjuro\', \'flavor\': \'Debido a ciertas normas arcaicas de la Coalición Azófar acerca de los sombreros, ahora algunos micoides son técnicamente capitanes piratas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637604&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'88e00b0b-7b68-4f9e-8514-f5acbf2e5d76\', \'multiverseId\': 637604}, \'multiverseid\': 637604}, {\'name\': \'Émergence frétillante\', \'text\': \'Descente insondable — Renvoyez sur le champ de bataille une carte de permanent non-terrain ciblée dans votre cimetière avec une valeur de mana inférieure ou égale au nombre de cartes de permanent dans votre cimetière.\', \'type\': \'Rituel\', \'flavor\': \'À cause des règlements archaïques de la Coalition des hardis concernant les chapeaux, quelques mycoïdes sont désormais techniquement des capitaines pirates.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637925&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3a4cd221-d0dd-4750-8b69-a0b276a720ed\', \'multiverseId\': 637925}, \'multiverseid\': 637925}, {\'name\': \'Affioramento Contorto\', \'text\': \'Discesa insondabile — Rimetti sul campo di battaglia una carta permanente non terra bersaglio dal tuo cimitero con valore di mana pari o inferiore al numero di carte permanente nel tuo cimitero.\', \'type\': \'Stregoneria\', \'flavor\': "A causa di arcaiche linee guida dell\'Alleanza di Bronzo riguardanti i copricapo, alcuni micoidi sono considerati tecnicamente dei capitani pirata.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638246&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9d71ffe7-f15e-483e-9fec-151c2ea75a11\', \'multiverseId\': 638246}, \'multiverseid\': 638246}, {\'name\': \'もがく出現\', \'text\': \'底なしの落魄 ― あなたの墓地にありマナ総量があなたの墓地にあるパーマネント・カードの枚数以下であり土地でないパーマネント・カード１枚を対象とする。それを戦場に戻す。\', \'type\': \'ソーサリー\', \'flavor\': \'鉄面連合には帽子に関する複雑な規則があるため、一部のマイコイドは書面上では海賊船長とみなされている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638567&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e135e840-ec54-4ff1-bbd6-176ffb5dda7e\', \'multiverseId\': 638567}, \'multiverseid\': 638567}, {\'name\': \'Emergência Rastejante\', \'text\': \'Descida insondável — Devolva ao campo de batalha o card de permanente não de terreno alvo com valor de mana igual ou inferior ao número de cards de permanente em seu cemitério.\', \'type\': \'Feitiço\', \'flavor\': \'Graças a certas diretrizes arcaicas da Coalizão Brônzea a respeito do uso de chapéus, alguns micoides agora são tecnicamente capitães piratas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638888&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cbe99019-c614-4213-bb35-38d706afb36d\', \'multiverseId\': 638888}, \'multiverseid\': 638888}, {\'name\': \'蠕菌突现\', \'text\': \'落坟无边～将目标非地且法术力值等于或小于你坟墓场中永久物牌数量的永久物牌从你的坟墓场移回战场。\', \'type\': \'法术\', \'flavor\': \'根据莽霸联盟关于帽子的陈年规定，有几个智蕈如今严格来说已是海盗船长。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639209&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c6fd4c90-f38c-47d6-8a84-4f0931af0d21\', \'multiverseId\': 639209}, \'multiverseid\': 639209}]', "[{'name': 'Wabernde Emergenz', 'text': 'Bodenloser Abstieg — Bringe eine Nichtland-Permanent-Karte deiner Wahl mit Manabetrag kleiner oder gleich der Anzahl an Permanent-Karten in deinem Friedhof aus deinem Friedhof ins Spiel zurück.', 'type': 'Hexerei', 'flavor': 'Wegen veralteter Regeln der Tollkühnen Koalition bezüglich des Tragens von Hüten sind einige Mykoiden nun streng genommen Piratenkapitäne.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639843&type=card', 'language': 'German', 'identifiers': {'scryfallId': '34b795c8-6e24-494a-85bb-03b929b2c83f', 'multiverseId': 639843}, 'multiverseid': 639843}, {'name': 'Émergence frétillante', 'text': 'Descente insondable — Renvoyez sur le champ de bataille une carte de permanent non-terrain ciblée dans votre cimetière avec une valeur de mana inférieure ou égale au nombre de cartes de permanent dans votre cimetière.', 'type': 'Rituel', 'flavor': 'À cause des règlements archaïques de la Coalition des hardis concernant les chapeaux, quelques mycoïdes sont désormais techniquement des capitaines pirates.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639894&type=card', 'language': 'French', 'identifiers': {'scryfallId': '0ff69b0b-9753-4439-a3fc-2e856c69e774', 'multiverseId': 639894}, 'multiverseid': 639894}, {'name': 'もがく出現', 'text': '底なしの落魄 ― あなたの墓地にありマナ総量があなたの墓地にあるパーマネント・カードの枚数以下であり土地でないパーマネント・カード１枚を対象とする。それを戦場に戻す。', 'type': 'ソーサリー', 'flavor': '鉄面連合には帽子に関する複雑な規則があるため、一部のマイコイドは書面上では海賊船長とみなされている。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639945&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'a10b50e8-5fcc-4f5b-a689-72b14fcbf484', 'multiverseId': 639945}, 'multiverseid': 639945}, {'name': '蠕菌突现', 'text': '落坟无边～将目标非地永久物牌从你的坟墓场移回战场，且其法术力值须等于或小于你坟墓场中的永久物牌数量。', 'type': '法术', 'flavor': '根据莽霸联盟关于帽子的陈年规定，有几个智蕈如今严格来说已是海盗船长。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639996&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '40b71fd5-f8d4-4b0e-9228-586c944ba6b4', 'multiverseId': 639996}, 'multiverseid': 639996}]", '[{\'name\': \'Wachposten der Namenlosen Stadt\', \'text\': \'Wachsamkeit\\nImmer wenn der Wachposten der Namenlosen Stadt ins Spiel kommt oder angreift, erzeuge einen Lageplan-Spielstein. (Er ist ein Artefakt mit „{1}, {T}, opfere dieses Artefakt: Eine Kreatur deiner Wahl, die du kontrollierst, erkundet. Aktiviere diese Fähigkeit wie eine Hexerei.")\', \'type\': \'Kreatur — Meervolk, Krieger, Späher\', \'flavor\': \'„Halt, Reisender. Was auch immer du suchst, hier wirst du es nicht finden."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637251&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'01738035-ec16-4b00-97d3-7f3704f0f9e8\', \'multiverseId\': 637251}, \'multiverseid\': 637251}, {\'name\': \'Centinela de la ciudad sin nombre\', \'text\': \'Vigilancia.\\nSiempre que la Centinela de la ciudad sin nombre entre al campo de batalla o ataque, crea una ficha de Mapa. (Es un artefacto con "{1}, {T}, sacrificar este artefacto: La criatura objetivo que controlas explora. Activa esto solo como un conjuro".)\', \'type\': \'Criatura — Explorador guerrero tritón\', \'flavor\': \'"Alto, viajera. Sea lo que sea que busques, aquí no lo encontrarás".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637572&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'02b3d5ba-523c-41b8-bb83-174c213c5ba1\', \'multiverseId\': 637572}, \'multiverseid\': 637572}, {\'name\': \'Sentinelle de la cité sans nom\', \'text\': "Vigilance\\nÀ chaque fois que la Sentinelle de la cité sans nom arrive sur le champ de bataille ou qu\'elle attaque, créez un jeton Carte. (C\'est un artefact avec « {1}, {T}, sacrifiez cet artefact : Une créature ciblée que vous contrôlez explore. N\'activez que lorsque vous pourriez lancer un rituel. »)", \'type\': \'Créature — ondin et guerrier et éclaireur\', \'flavor\': \'« Halte, voyageur. Quoi que tu recherches, tu ne le trouveras pas ici. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637893&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'26741248-03a6-4a06-a1f6-250c9e42452b\', \'multiverseId\': 637893}, \'multiverseid\': 637893}, {\'name\': \'Sentinella della Città Senza Nome\', \'text\': \'Cautela\\nOgniqualvolta la Sentinella della Città Senza Nome entra nel campo di battaglia o attacca, crea una pedina Mappa. (È un artefatto con "{1}, {T}, Sacrifica questo artefatto: Una creatura bersaglio che controlli esplora. Attiva solo come una stregoneria".)\', \'type\': \'Creatura — Esploratore Guerriero Tritone\', \'flavor\': \'"Fermo, straniero. Qualunque cosa cerchi, non la troverai qui."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638214&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ad924f29-d8f8-4f2b-a71d-389457b60ff0\', \'multiverseId\': 638214}, \'multiverseid\': 638214}, {\'name\': \'名もなき都市の歩哨\', \'text\': \'警戒\\n名もなき都市の歩哨が戦場に出るか攻撃するたび、地図・トークン１つを生成する。（それは「{1}, {T}, このアーティファクトを生け贄に捧げる：あなたがコントロールしているクリーチャー１体を対象とする。それは探検を行う。起動はソーサリーとしてのみ行う。」を持つアーティファクトである。）\', \'type\': \'クリーチャー — マーフォーク・戦士・スカウト\', \'flavor\': \'「旅人よ。何を探しているかは知らぬが、それはここにはない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638535&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9c9be5e4-a49f-4769-8606-3d7457c558df\', \'multiverseId\': 638535}, \'multiverseid\': 638535}, {\'name\': \'Sentinela da Cidade Sem Nome\', \'text\': \'Vigilância\\nToda vez que Sentinela da Cidade Sem Nome entrar no campo de batalha ou atacar, crie uma ficha de Mapa. (Ela é um artefato com "{1}, {T}, sacrifique este artefato: A criatura alvo que você controla explora. Ative somente como um feitiço".)\', \'type\': \'Criatura — Tritão Guerreiro Batedor\', \'flavor\': \'"Pare, viajante. O que quer que você procure, não vai encontrar aqui."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638856&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'37cdfaa4-fef6-4dfe-ad5c-3127ee1279c9\', \'multiverseId\': 638856}, \'multiverseid\': 638856}, {\'name\': \'无名城哨卫\', \'text\': \'警戒\\n每当无名城哨卫进战场或攻击时，派出一个地图衍生物。（它是具有「{1}，{T}，牺牲此神器：令目标由你操控的生物勘察。只能于法术时机起动」的神器。）\', \'type\': \'生物 — 人鱼／战士／斥候\', \'flavor\': \'「站住，旅人。不管你在找什么，它都不在这里。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639177&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e0a908c9-32fb-4531-b40d-5a6ec84bac95\', \'multiverseId\': 639177}, \'multiverseid\': 639177}]', '[{\'name\': \'Wachposten der Namenlosen Stadt\', \'text\': \'Wachsamkeit\\nImmer wenn der Wachposten der Namenlosen Stadt ins Spiel kommt oder angreift, erzeuge einen Lageplan-Spielstein.\', \'type\': \'Kreatur — Meervolk, Krieger, Späher\', \'flavor\': \'„Halt, Reisender. Was auch immer du suchst, hier wirst du es nicht finden."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639840&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e00f8726-ea77-4757-8485-384412c24e7c\', \'multiverseId\': 639840}, \'multiverseid\': 639840}, {\'name\': \'Sentinelle de la cité sans nom\', \'text\': "Vigilance\\nÀ chaque fois que la Sentinelle de la cité sans nom arrive sur le champ de bataille ou qu\'elle attaque, créez un jeton Carte.", \'type\': \'Créature — ondin et guerrier et éclaireur\', \'flavor\': \'« Halte, voyageur. Quoi que tu recherches, tu ne le trouveras pas ici. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639891&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4ff5f470-98c4-43f0-901d-ba128b5e5161\', \'multiverseId\': 639891}, \'multiverseid\': 639891}, {\'name\': \'名もなき都市の歩哨\', \'text\': \'警戒\\n名もなき都市の歩哨が戦場に出るか攻撃するたび、地図・トークン１つを生成する。\', \'type\': \'クリーチャー — マーフォーク・戦士・スカウト\', \'flavor\': \'「旅人よ。何を探しているかは知らぬが、それはここにはない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639942&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3390a6a0-db5a-441b-a463-2ea103263436\', \'multiverseId\': 639942}, \'multiverseid\': 639942}, {\'name\': \'无名城哨卫\', \'text\': \'警戒\\n每当无名城哨卫进战场或攻击时，派出一个地图衍生物。\', \'type\': \'生物 — 人鱼／战士／斥候\', \'flavor\': \'「站住，旅人。不管你在找什么，它都不在这里。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639993&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bdd661be-37fb-447f-8be9-d75d252fc111\', \'multiverseId\': 639993}, \'multiverseid\': 639993}]', '[{\'name\': \'Waghalsige Entdeckung\', \'text\': \'Bis zu drei Kreaturen deiner Wahl können in diesem Zug nicht blocken.\\nEntdeckung 4. (Schicke Karten oben von deiner Bibliothek ins Exil, bis du eine Nichtland-Karte mit Manabetrag 4 oder weniger ins Exil schickst. Wirke sie, ohne ihre Manakosten zu bezahlen, oder nimm sie auf deine Hand. Lege den Rest in zufälliger Reihenfolge unter die Bibliothek.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637172&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'aad5e551-59e3-49f0-a325-b4380706f8bc\', \'multiverseId\': 637172}, \'multiverseid\': 637172}, {\'name\': \'Hallazgo arriesgado\', \'text\': \'Hasta tres criaturas objetivo no pueden bloquear este turno.\\nDescubre 4. (Exilia cartas de la parte superior de tu biblioteca hasta que exilies una carta que no sea tierra con valor de maná de 4 o menos. Lánzala sin pagar su coste de maná o ponla en tu mano. Pon el resto en el fondo en un orden aleatorio.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637493&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4ef4da7f-f120-435a-86ef-40b77fcb3b01\', \'multiverseId\': 637493}, \'multiverseid\': 637493}, {\'name\': \'Découverte audacieuse\', \'text\': "Jusqu\'à trois créatures ciblées ne peuvent pas bloquer ce tour-ci.\\nDécouvrez 4. (Exilez les cartes du dessus de votre bibliothèque jusqu\'à ce que vous exiliez une carte non-terrain avec une valeur de mana inférieure ou égale à 4. Lancez-la sans payer son coût de mana ou mettez-la dans votre main. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637814&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8da2212c-030a-4f16-bae6-6f78bca98553\', \'multiverseId\': 637814}, \'multiverseid\': 637814}, {\'name\': \'Scoperta Audace\', \'text\': \'Fino a tre creature bersaglio non possono bloccare in questo turno.\\nScopri 4. (Esilia carte dalla cima del tuo grimorio finché non esili una carta non terra con valore di mana pari o inferiore a 4. Lanciala senza pagare il suo costo di mana o aggiungila alla tua mano. Metti le altre in fondo in ordine casuale.)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638135&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a481e363-d087-4522-9b27-a41c390d6118\', \'multiverseId\': 638135}, \'multiverseid\': 638135}, {\'name\': \'勇敢な発見\', \'text\': \'クリーチャー最大３体を対象とする。このターン、それらではブロックできない。\\n発見４を行う。（マナ総量が４以下であり土地でないカード１枚が追放されるまで、あなたのライブラリーの一番上から１枚ずつ追放していく。それをマナ・コストを支払うことなく唱えるか、あなたの手札に加える。残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638456&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'513ce3ff-0a01-43d1-b2e9-aaf1a3dd20cd\', \'multiverseId\': 638456}, \'multiverseid\': 638456}, {\'name\': \'Descoberta Destemida\', \'text\': \'Até três criaturas alvo não podem bloquear neste turno.\\nDescubra 4. (Exile cards do topo do seu grimório até exilar um card não de terreno com valor de mana igual ou inferior a 4. Conjure sem pagar o custo de mana ou coloque-o na sua mão. Coloque o restante no fundo do grimório em ordem aleatória.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638777&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6193b89b-2670-461e-90a9-52561d1c4421\', \'multiverseId\': 638777}, \'multiverseid\': 638777}, {\'name\': \'大胆发现\', \'text\': \'至多三个目标生物本回合不能进行阻挡。\\n倾探4。（从你的牌库顶开始放逐牌，直到放逐一张法术力值等于或小于4的非地牌为止。施放之且不需支付其法术力费用，或将之置于你手上。将其余的牌以随机顺序置于你牌库底。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639098&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b2a52dab-277c-4136-bb8b-f3cdfc382703\', \'multiverseId\': 639098}, \'multiverseid\': 639098}]', "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639527&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b96b4fc2-0b2a-4731-8827-e7c66b9811bb', 'multiverseId': 639527}, 'multiverseid': 639527}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639532&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'df237985-eeb4-42d6-9d3b-1a9421b9efce', 'multiverseId': 639532}, 'multiverseid': 639532}, {'name': 'Forêt', 'type': 'Terrain de base — forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639537&type=card', 'language': 'French', 'identifiers': {'scryfallId': '88217557-3e9f-4ea1-ab92-424f27015ceb', 'multiverseId': 639537}, 'multiverseid': 639537}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639542&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '8cbc59f0-c5de-4ca3-a6fb-416edf2d3672', 'multiverseId': 639542}, 'multiverseid': 639542}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639547&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '10d170ff-653e-48a8-8b3e-9796c0abf32e', 'multiverseId': 639547}, 'multiverseid': 639547}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639552&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '35697323-7356-4e3a-83b5-bda29f564840', 'multiverseId': 639552}, 'multiverseid': 639552}, {'name': '树林', 'type': '基本地 — 树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639557&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'aa3d4124-2e3c-4541-9b66-7a3111a7405d', 'multiverseId': 639557}, 'multiverseid': 639557}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639688&type=card', 'language': 'German', 'identifiers': {'scryfallId': '9b343859-2511-479e-b6c5-d83351d2021f', 'multiverseId': 639688}, 'multiverseid': 639688}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639698&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ddde4856-0e8d-4005-895b-2b83d26961df', 'multiverseId': 639698}, 'multiverseid': 639698}, {'name': 'Forêt', 'type': 'Terrain de base — forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639708&type=card', 'language': 'French', 'identifiers': {'scryfallId': '27f3a069-f5d9-4336-a1d9-502707463e9f', 'multiverseId': 639708}, 'multiverseid': 639708}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639718&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '42e1ea29-3678-42cc-9bb7-9a914899f99a', 'multiverseId': 639718}, 'multiverseid': 639718}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639728&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9ec685f6-3638-4201-b23e-4a4787cc3784', 'multiverseId': 639728}, 'multiverseid': 639728}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639738&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9cb4fbd3-a72b-455a-b0c9-7c887b87b2a1', 'multiverseId': 639738}, 'multiverseid': 639738}, {'name': '树林', 'type': '基本地 — 树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639748&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '5db76517-08d9-4d41-9216-62a8a9b11ca1', 'multiverseId': 639748}, 'multiverseid': 639748}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639689&type=card', 'language': 'German', 'identifiers': {'scryfallId': '180dabdb-ba37-483d-bd6a-0f013fcdc73e', 'multiverseId': 639689}, 'multiverseid': 639689}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639699&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '8586cdd1-a438-4939-9184-34dcce7b9952', 'multiverseId': 639699}, 'multiverseid': 639699}, {'name': 'Forêt', 'type': 'Terrain de base — forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639709&type=card', 'language': 'French', 'identifiers': {'scryfallId': '7b622234-cd9e-4272-ad40-b6a9f954c083', 'multiverseId': 639709}, 'multiverseid': 639709}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639719&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '6da69492-dcca-4a13-9b34-858ab470486d', 'multiverseId': 639719}, 'multiverseid': 639719}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639729&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '69aa37e6-bfa6-4c48-8493-67123d7e6c07', 'multiverseId': 639729}, 'multiverseid': 639729}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639739&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ce49f504-bee9-443f-9464-c91d19666003', 'multiverseId': 639739}, 'multiverseid': 639739}, {'name': '树林', 'type': '基本地 — 树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639749&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'ed40dc77-31a8-4a26-a1c0-c1603354ebef', 'multiverseId': 639749}, 'multiverseid': 639749}]", '[{\'name\': \'Wandbild des Meisters // Manufaktur des Meisters\', \'text\': \'Wenn das Wandbild des Meisters ins Spiel kommt, erzeuge einen 4/4 weißen und blauen Golem-Artefaktkreaturenspielstein.\\nAnfertigung mit einem Artefakt {4}{W}{W}{U} ({4}{W}{W}{U}, schicke dieses Artefakt ins Exil, schicke ein weiteres Artefakt, das du kontrollierst, oder eine Artefaktkarte aus deinem Friedhof ins Exil: Bringe diese Karte transformiert unter der Kontrolle ihres Besitzers ins Spiel zurück. Spiele Anfertigung wie eine Hexerei.)\', \'type\': \'Artefakt\', \'flavor\': \'„Die Fomori sind eine üble und halb verblasste Erinnerung, aber ihre Kriegsmaschinen haben uns viel über Plattnerkunst gelehrt."\\n—Anim Pakal, der Tausendste Mond\', \'faceName\': \'Wandbild des Meisters\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637274&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'08588d86-680d-4fa2-8945-e426bd28dcdb\', \'multiverseId\': 637274}, \'multiverseid\': 637274}, {\'name\': \'Mural guía de los maestros // Fábrica de los maestros\', \'text\': \'Cuando el Mural guía de los maestros entre al campo de batalla, crea una ficha de criatura artefacto Gólem blanca y azul 4/4.\\nElaborar con artefacto {4}{W}{W}{U}. ({4}{W}{W}{U}, exiliar este artefacto, exiliar otro artefacto que controlas o una carta de artefacto de tu cementerio: Regresa esta carta transformada bajo el control de su propietario. Activa la habilidad de elaborar solo como un conjuro.)\', \'type\': \'Artefacto\', \'flavor\': \'"Los fomori son un recuerdo vil y lejano, pero sus máquinas de guerra nos enseñaron mucho sobre la forja de armaduras a gran escala".\\n—Anim Pakal, la Milésima Luna\', \'faceName\': \'Mural guía de los maestros\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637595&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ca96426b-e748-4ecc-bf33-5b15a7c70277\', \'multiverseId\': 637595}, \'multiverseid\': 637595}, {\'name\': \'Peinture murale du maître // Manufacture du maître\', \'text\': "Quand la Peinture murale du maître arrive sur le champ de bataille, créez un jeton de créature-artefact 4/4 blanche et bleue Golem.\\nFaçonnez avec un artefact {4}{W}{W}{U} ({4}{W}{W}{U}, exilez cet artefact, exilez un autre artefact que vous contrôlez ou une carte d\'artefact de votre cimetière : Renvoyez cette carte transformée sous le contrôle de son propriétaire. Ne façonnez que lorsque vous pourriez lancer un rituel.)", \'type\': \'Artefact\', \'flavor\': "« Les Fomori sont un horrible souvenir lointain, mais leurs machines de guerre nous ont appris beaucoup sur l\'armurerie de masse. »\\n—Anim Pakal, la Millième lune", \'faceName\': \'Peinture murale du maître\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637916&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5bbba7fe-bc42-41a8-9c14-bca09836f0db\', \'multiverseId\': 637916}, \'multiverseid\': 637916}, {\'name\': \'Murale Guida del Maestro // Manifattura del Maestro\', \'text\': \'Quando il Murale Guida del Maestro entra nel campo di battaglia, crea una pedina creatura artefatto Golem 4/4 bianca e blu.\\nCostruisci con artefatti {4}{W}{W}{U} ({4}{W}{W}{U}, Esilia questo artefatto, Esilia un altro artefatto che controlli o una carta artefatto dal tuo cimitero: Rimetti questa carta trasformata sotto il controllo del suo proprietario. Costruisci solo come una stregoneria.)\', \'type\': \'Artefatto\', \'flavor\': \'"I Fomori sono un ricordo doloroso e lontano, ma le loro macchine da guerra ci hanno insegnato molto sulla costruzione di armature su larga scala."\\n—Anim Pakal, Millesima Luna\', \'faceName\': \'Murale Guida del Maestro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638237&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7deec2d0-bb05-4a47-9689-5aaaeedb217a\', \'multiverseId\': 638237}, \'multiverseid\': 638237}, {\'name\': \'主の案内壁画 // 主の組立工廠\', \'text\': \'主の案内壁画が戦場に出たとき、白青の４/４のゴーレム・アーティファクト・クリーチャー・トークン１体を生成する。\\nアーティファクトで作製{4}{W}{W}{U} （{4}{W}{W}{U}, このアーティファクトを追放する, あなたがコントロールしていてこれでないアーティファクトやあなたの墓地にあるアーティファクト・カードである１つを追放する：このカードをオーナーのコントロール下で変身させた状態で戻す。作製はソーサリーとしてのみ行う。）\', \'type\': \'アーティファクト\', \'flavor\': \'「フォモーリは我らにとって過去の忌まわしき記憶だが、奴らが用いた兵器の知識がなければ、大規模な装備の製作が不可能だっただろう。」\\n――千番目の月、アニム・パカル\', \'faceName\': \'主の案内壁画\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638558&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3a85e7cf-faf2-43f3-82a0-2a58816b02ca\', \'multiverseId\': 638558}, \'multiverseid\': 638558}, {\'name\': \'Mural-guia do Mestre // Manufatura do Mestre\', \'text\': \'Quando Mural-guia do Mestre entrar no campo de batalha, crie uma ficha de criatura artefato Golem branca e azul 4/4.\\nConstruir com artefato {4}{W}{W}{U} ({4}{W}{W}{U}, exile este artefato, exile outro artefato que você controla ou um card de artefato de seu cemitério: Devolva este card ao campo de batalha transformado sob o controle de seu dono. Construa somente como um feitiço.)\', \'type\': \'Artefato\', \'flavor\': \'"Os Fomori são uma lembrança sórdida e distante, mas as máquinas de guerra deles nos ensinaram muito sobre a fabricação de armaduras em larga escala."\\n— Anim Pakal, Milésima Lua\', \'faceName\': \'Mural-guia do Mestre\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638879&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'58694025-5fe6-480d-b82a-88984c0dc2e1\', \'multiverseId\': 638879}, \'multiverseid\': 638879}, {\'name\': \'大师装配画 // 大师组装厂\', \'text\': \'当大师装配画进战场时，派出一个4/4，白蓝双色的魔像衍生神器生物。\\n以神器化炼{4}{W}{W}{U}（{4}{W}{W}{U}，放逐另一个由你操控的神器或一张你坟墓场中的神器牌：将此牌在其拥有者的操控下移回且已转化。只能于法术时机化炼。）\', \'type\': \'神器\', \'flavor\': \'「虽然佛莫里人依旧是不堪回首的遥远回忆，但他们的战争机械对我们铸造大型装甲裨益良多。」\\n～千月统帅阿妮帕卡\', \'faceName\': \'大师装配画\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639200&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'70b198c6-08d5-4f5c-b487-a0ff1cd91f41\', \'multiverseId\': 639200}, \'multiverseid\': 639200}]', '[{\'name\': \'Wandbild des Meisters // Manufaktur des Meisters\', \'text\': \'{T}: Erzeuge einen 4/4 weißen und blauen Golem-Artefaktkreaturenspielstein. Aktiviere diese Fähigkeit nur, falls die Manufaktur des Meisters oder ein anderes Artefakt in diesem Zug unter deiner Kontrolle ins Spiel gekommen ist.\', \'type\': \'Artefakt\', \'flavor\': None, \'faceName\': \'Manufaktur des Meisters\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637274&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'08588d86-680d-4fa2-8945-e426bd28dcdb\', \'multiverseId\': 637274}, \'multiverseid\': 637274}, {\'name\': \'Mural guía de los maestros // Fábrica de los maestros\', \'text\': \'{T}: Crea una ficha de criatura artefacto Gólem blanca y azul 4/4. Activa esto solo si la Fábrica de los maestros u otro artefacto entró al campo de batalla bajo tu control este turno.\', \'type\': \'Artefacto\', \'flavor\': None, \'faceName\': \'Fábrica de los maestros\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637595&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ca96426b-e748-4ecc-bf33-5b15a7c70277\', \'multiverseId\': 637595}, \'multiverseid\': 637595}, {\'name\': \'Peinture murale du maître // Manufacture du maître\', \'text\': "{T} : Créez un jeton de créature-artefact 4/4 blanche et bleue Golem. N\'activez que si la Manufacture du maître ou un autre artefact est arrivé sur le champ de bataille sous votre contrôle ce tour-ci.", \'type\': \'Artefact\', \'flavor\': None, \'faceName\': \'Manufacture du maître\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637916&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5bbba7fe-bc42-41a8-9c14-bca09836f0db\', \'multiverseId\': 637916}, \'multiverseid\': 637916}, {\'name\': \'Murale Guida del Maestro // Manifattura del Maestro\', \'text\': \'{T}: Crea una pedina creatura artefatto Golem 4/4 bianca e blu. Attiva solo se la Manifattura del Maestro o un altro artefatto sono entrati nel campo di battaglia sotto il tuo controllo in questo turno.\', \'type\': \'Artefatto\', \'flavor\': None, \'faceName\': \'Manifattura del Maestro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638237&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7deec2d0-bb05-4a47-9689-5aaaeedb217a\', \'multiverseId\': 638237}, \'multiverseid\': 638237}, {\'name\': \'主の案内壁画 // 主の組立工廠\', \'text\': \'{T}：白青の４/４のゴーレム・アーティファクト・クリーチャー・トークン１体を生成する。主の組立工廠、またはこれでないアーティファクトがあなたのコントロール下で戦場に出たターンでなければ起動できない。\', \'type\': \'アーティファクト\', \'flavor\': None, \'faceName\': \'主の組立工廠\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638558&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3a85e7cf-faf2-43f3-82a0-2a58816b02ca\', \'multiverseId\': 638558}, \'multiverseid\': 638558}, {\'name\': \'Mural-guia do Mestre // Manufatura do Mestre\', \'text\': \'{T}: Crie uma ficha de criatura artefato Golem branca e azul 4/4. Ative somente se Manufatura do Mestre ou outro artefato tiver entrado no campo de batalha sob seu controle neste turno.\', \'type\': \'Artefato\', \'flavor\': None, \'faceName\': \'Manufatura do Mestre\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638879&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'58694025-5fe6-480d-b82a-88984c0dc2e1\', \'multiverseId\': 638879}, \'multiverseid\': 638879}, {\'name\': \'大师装配画 // 大师组装厂\', \'text\': \'{T}：派出一个4/4，白蓝双色的魔像衍生神器生物。只能于大师组装厂或另一个神器在你操控下进战场的回合中起动。\', \'type\': \'神器\', \'flavor\': None, \'faceName\': \'大师组装厂\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639200&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'70b198c6-08d5-4f5c-b487-a0ff1cd91f41\', \'multiverseId\': 639200}, \'multiverseid\': 639200}]', '[{\'name\': \'Wandelnder Thron\', \'text\': \'Abwehr {2}\\nSowie der Wandelnde Thron, ins Spiel kommt, bestimme einen Kreaturentyp.\\nDer Wandelnde Thron hat zusätzlich zu seinen anderen Typen den bestimmten Typ.\\nFalls eine ausgelöste Fähigkeit einer anderen Kreatur des bestimmten Typs, die du kontrollierst, ausgelöst wird, wird sie ein weiteres Mal ausgelöst.\', \'type\': \'Artefaktkreatur — Golem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637301&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4962aeaa-7fc2-4702-a71a-eaf79a3e205a\', \'multiverseId\': 637301}, \'multiverseid\': 637301}, {\'name\': \'Trono andante\', \'text\': \'Rebatir {2}.\\nEn cuanto el Trono andante entre al campo de batalla, elige un tipo de criatura.\\nEl Trono andante es del tipo elegido además de sus otros tipos.\\nSi se dispara una habilidad disparada de otra criatura que controlas del tipo elegido, se dispara una vez más.\', \'type\': \'Criatura artefacto — Gólem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637622&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'531b4514-2d12-4631-b606-4b1c3c1a93b0\', \'multiverseId\': 637622}, \'multiverseid\': 637622}, {\'name\': \'Trône errant\', \'text\': "Parade {2}\\nAu moment où le Trône errant arrive sur le champ de bataille, choisissez un type de créature.\\nLe Trône errant a le type choisi en plus de ses autres types.\\nSi une capacité déclenchée d\'une autre créature que vous contrôlez du type choisi se déclenche, elle se déclenche une fois de plus.", \'type\': \'Créature-artefact — golem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637943&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'575baf40-82d3-451f-8c6f-1f59aa77f304\', \'multiverseId\': 637943}, \'multiverseid\': 637943}, {\'name\': \'Trono Vagante\', \'text\': "Egida {2}\\nMentre il Trono Vagante entra nel campo di battaglia, scegli un tipo di creatura.\\nIl Trono Vagante ha il tipo scelto in aggiunta ai suoi altri tipi.\\nSe si innesca un\'abilità innescata di un\'altra creatura che controlli del tipo scelto, si innesca una volta in più.", \'type\': \'Creatura Artefatto — Golem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638264&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f99ae6f2-2bc7-4cfe-9501-fa38f8e1c015\', \'multiverseId\': 638264}, \'multiverseid\': 638264}, {\'name\': \'うろつく玉座\', \'text\': \'護法{2}\\nうろつく玉座が戦場に出るに際し、クリーチャー・タイプ１つを選ぶ。\\nうろつく玉座は、他のタイプに加えてその選ばれたタイプでもある。\\nあなたがコントロールしていてその選ばれたタイプでありこれでないクリーチャー１体の誘発型能力が誘発するなら、それは追加でもう１回誘発する。\', \'type\': \'アーティファクト・クリーチャー — ゴーレム\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638585&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3e8052bb-6fee-427a-ac42-8b237b98265a\', \'multiverseId\': 638585}, \'multiverseid\': 638585}, {\'name\': \'Trono Errante\', \'text\': \'Salvaguarda {2}\\nQuando Trono Errante entrar no campo de batalha, escolha um tipo de criatura.\\nTrono Errante é do tipo escolhido além de seus outros tipos.\\nSe uma habilidade desencadeada de outra criatura que você controla do tipo escolhido for desencadeada, ela será desencadeada uma vez adicional.\', \'type\': \'Criatura Artefato — Golem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638906&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a85ed56e-9b00-45d6-876a-f81d858d5e76\', \'multiverseId\': 638906}, \'multiverseid\': 638906}, {\'name\': \'游荡王座\', \'text\': \'守护{2}\\n于游荡王座进战场时，选择一种生物类别。\\n游荡王座额外具有所选类别。\\n如果由你操控且为所选类别之其他生物的触发式异能触发，则它额外触发一次。\', \'type\': \'神器生物 — 魔像\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639227&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6c53cfe9-498a-4259-aade-147544a29e14\', \'multiverseId\': 639227}, \'multiverseid\': 639227}]', '[{\'name\': \'Wandelnder Thron\', \'text\': \'Abwehr {2}\\nSowie der Wandelnde Thron, ins Spiel kommt, bestimme einen Kreaturentyp.\\nDer Wandelnde Thron hat zusätzlich zu seinen anderen Typen den bestimmten Typ.\\nFalls eine ausgelöste Fähigkeit einer anderen Kreatur des bestimmten Typs, die du kontrollierst, ausgelöst wird, wird sie ein weiteres Mal ausgelöst.\', \'type\': \'Artefaktkreatur — Golem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639291&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5a925ff7-b260-4321-b908-61f105a8d8ae\', \'multiverseId\': 639291}, \'multiverseid\': 639291}, {\'name\': \'Trono andante\', \'text\': \'Rebatir {2}.\\nEn cuanto el Trono andante entre al campo de batalla, elige un tipo de criatura.\\nEl Trono andante es del tipo elegido además de sus otros tipos.\\nSi se dispara una habilidad disparada de otra criatura que controlas del tipo elegido, se dispara una vez más.\', \'type\': \'Criatura artefacto — Gólem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639311&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'221f7cc1-23c7-4d26-8088-5e7934536c92\', \'multiverseId\': 639311}, \'multiverseid\': 639311}, {\'name\': \'Trône errant\', \'text\': "Parade {2}\\nAu moment où le Trône errant arrive sur le champ de bataille, choisissez un type de créature.\\nLe Trône errant a le type choisi en plus de ses autres types.\\nSi une capacité déclenchée d\'une autre créature que vous contrôlez du type choisi se déclenche, elle se déclenche une fois de plus.", \'type\': \'Créature-artefact — golem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639331&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'01624f17-f593-4cc9-8acc-496b1d65364b\', \'multiverseId\': 639331}, \'multiverseid\': 639331}, {\'name\': \'Trono Vagante\', \'text\': "Egida {2}\\nMentre il Trono Vagante entra nel campo di battaglia, scegli un tipo di creatura.\\nIl Trono Vagante ha il tipo scelto in aggiunta ai suoi altri tipi.\\nSe si innesca un\'abilità innescata di un\'altra creatura che controlli del tipo scelto, si innesca una volta in più.", \'type\': \'Creatura Artefatto — Golem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639351&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eda664e1-a7ce-42df-82a2-d92de8faea27\', \'multiverseId\': 639351}, \'multiverseid\': 639351}, {\'name\': \'うろつく玉座\', \'text\': \'護法{2}\\nうろつく玉座が戦場に出るに際し、クリーチャー・タイプ１つを選ぶ。\\nうろつく玉座は、他のタイプに加えてその選ばれたタイプでもある。\\nあなたがコントロールしていてその選ばれたタイプでありこれでないクリーチャー１体の誘発型能力が誘発するなら、それは追加でもう１回誘発する。\', \'type\': \'アーティファクト・クリーチャー — ゴーレム\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639371&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'114e62a9-3c65-4987-8939-e46b1e50f474\', \'multiverseId\': 639371}, \'multiverseid\': 639371}, {\'name\': \'Trono Errante\', \'text\': \'Salvaguarda {2}\\nQuando Trono Errante entrar no campo de batalha, escolha um tipo de criatura.\\nTrono Errante é do tipo escolhido além de seus outros tipos.\\nSe uma habilidade desencadeada de outra criatura que você controla do tipo escolhido for desencadeada, ela será desencadeada uma vez adicional.\', \'type\': \'Criatura Artefato — Golem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639391&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ff1134c8-fb2b-4fc7-bc2f-1a15723834d6\', \'multiverseId\': 639391}, \'multiverseid\': 639391}, {\'name\': \'游荡王座\', \'text\': \'守护{2}\\n于游荡王座进战场时，选择一种生物类别。\\n游荡王座额外具有所选类别。\\n如果由你操控且为所选类别之其他生物的触发式异能触发，则它额外触发一次。\', \'type\': \'神器生物 — 魔像\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639411&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'914e8764-c85a-4d6a-8856-6d39f69a66ea\', \'multiverseId\': 639411}, \'multiverseid\': 639411}]', '[{\'name\': \'Wanderung mit den Urahnen\', \'text\': \'Bringe bis zu eine Permanent-Karte deiner Wahl aus deinem Friedhof auf deine Hand zurück. Entdeckung 4. (Schicke Karten oben von deiner Bibliothek ins Exil, bis du eine Nichtland-Karte mit Manabetrag 4 oder weniger ins Exil schickst. Wirke sie, ohne ihre Manakosten zu bezahlen, oder nimm sie auf deine Hand. Lege den Rest in zufälliger Reihenfolge unter die Bibliothek.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637259&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'747ccb9a-4afd-4721-a978-e3660e89ebfc\', \'multiverseId\': 637259}, \'multiverseid\': 637259}, {\'name\': \'Caminar con los ancestros\', \'text\': \'Regresa hasta una carta de permanente objetivo de tu cementerio a tu mano. Descubre 4. (Exilia cartas de la parte superior de tu biblioteca hasta que exilies una carta que no sea tierra con valor de maná de 4 o menos. Lánzala sin pagar su coste de maná o ponla en tu mano. Pon el resto en el fondo en un orden aleatorio.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637580&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9375d6e4-6d8d-4aa6-8992-e9ffdad568bc\', \'multiverseId\': 637580}, \'multiverseid\': 637580}, {\'name\': \'Marche avec les ancêtres\', \'text\': "Renvoyez jusqu\'à une carte de permanent ciblée depuis votre cimetière dans votre main. Découvrez 4. (Exilez les cartes du dessus de votre bibliothèque jusqu\'à ce que vous exiliez une carte non-terrain avec une valeur de mana inférieure ou égale à 4. Lancez-la sans payer son coût de mana ou mettez-la dans votre main. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637901&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1f94a96a-4cd9-4894-a971-2fe7b6a7dd4a\', \'multiverseId\': 637901}, \'multiverseid\': 637901}, {\'name\': \'Camminare con gli Antenati\', \'text\': \'Riprendi in mano fino a una carta permanente bersaglio dal tuo cimitero. Scopri 4. (Esilia carte dalla cima del tuo grimorio finché non esili una carta non terra con valore di mana pari o inferiore a 4. Lanciala senza pagare il suo costo di mana o aggiungila alla tua mano. Metti le altre in fondo in ordine casuale.)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638222&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e62189f2-3f30-43ee-8d8d-83b9dfd7d4f5\', \'multiverseId\': 638222}, \'multiverseid\': 638222}, {\'name\': \'祖先との同行\', \'text\': \'あなたの墓地にあるパーマネント・カード最大１枚を対象とする。それをあなたの手札に戻す。発見４を行う。（マナ総量が４以下であり土地でないカード１枚が追放されるまで、あなたのライブラリーの一番上から１枚ずつ追放していく。それをマナ・コストを支払うことなく唱えるか、あなたの手札に加える。残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638543&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4eba094a-bc7e-4f88-9c7c-63797e93cc5a\', \'multiverseId\': 638543}, \'multiverseid\': 638543}, {\'name\': \'Caminhar com os Ancestrais\', \'text\': \'Devolva até um card de permanente alvo de seu cemitérioà sua mão. Descubra 4. (Exile cards do topo do seu grimório até exilar um card não de terreno com valor de mana igual ou inferior a 4. Conjure sem pagar o custo de mana ou coloque-o na sua mão. Coloque o restante no fundo do grimório em ordem aleatória.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638864&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'445ec7c1-cc8b-4c03-a5aa-2a505fdb9c5f\', \'multiverseId\': 638864}, \'multiverseid\': 638864}, {\'name\': \'先祖同行\', \'text\': \'将至多一张目标永久物牌从你的坟墓场移回你手上。倾探4。（从你的牌库顶开始放逐牌，直到放逐一张法术力值等于或小于4的非地牌为止。施放之且不需支付其法术力费用，或将之置于你手上。将其余的牌以随机顺序置于你牌库底。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639185&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4d9e78d5-8a10-4214-a52e-2c275c53cf78\', \'multiverseId\': 639185}, \'multiverseid\': 639185}]', '[{\'name\': \'Wasserflügel-Späherin\', \'text\': \'Fliegend\\nWenn die Wasserflügel-Späherin ins Spiel kommt, erzeuge einen Lageplan-Spielstein. (Er ist ein Artefakt mit „{1}, {T}, opfere dieses Artefakt: Eine Kreatur deiner Wahl, die du kontrollierst, erkundet. Aktiviere diese Fähigkeit wie eine Hexerei.")\', \'type\': \'Kreatur — Meervolk, Späher\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637108&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e2252f88-2326-4799-9906-cc2059fc7a05\', \'multiverseId\': 637108}, \'multiverseid\': 637108}, {\'name\': \'Exploradora aeroacuática\', \'text\': \'Vuela.\\nCuando la Exploradora aeroacuática entre al campo de batalla, crea una ficha de Mapa. (Es un artefacto con "{1}, {T}, sacrificar este artefacto: La criatura objetivo que controlas explora. Activa esto solo como un conjuro".)\', \'type\': \'Criatura — Explorador tritón\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637429&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'99b09308-54a6-4fe0-bd16-b3af3bf4e1f1\', \'multiverseId\': 637429}, \'multiverseid\': 637429}, {\'name\': \'Éclaireuse aquavente\', \'text\': "Vol\\nQuand l\'Éclaireuse aquavente arrive sur le champ de bataille, créez un jeton Carte. (C\'est un artefact avec « {1}, {T}, sacrifiez cet artefact : Une créature ciblée que vous contrôlez explore. N\'activez que lorsque vous pourriez lancer un rituel. »)", \'type\': \'Créature — ondin et éclaireur\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637750&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6b44b91b-c878-42ea-b71d-1ae981d01e17\', \'multiverseId\': 637750}, \'multiverseid\': 637750}, {\'name\': \'Esploratrice Acqualata\', \'text\': \'Volare\\nQuando l\\\'Esploratrice Acqualata entra nel campo di battaglia, crea una pedina Mappa. (È un artefatto con "{1}, {T}, Sacrifica questo artefatto: Una creatura bersaglio che controlli esplora. Attiva solo come una stregoneria".)\', \'type\': \'Creatura — Esploratore Tritone\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638071&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c7185f95-b46a-46c6-9e97-81bb2c932071\', \'multiverseId\': 638071}, \'multiverseid\': 638071}, {\'name\': \'水巻きの偵察\', \'text\': \'飛行\\n水巻きの偵察が戦場に出たとき、地図・トークン１つを生成する。（それは「{1}, {T}, このアーティファクトを生け贄に捧げる：あなたがコントロールしているクリーチャー１体を対象とする。それは探検を行う。起動はソーサリーとしてのみ行う。」を持つアーティファクトである。）\', \'type\': \'クリーチャー — マーフォーク・スカウト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638392&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7d49d17a-c36c-4b4b-9f42-121b9dcb3820\', \'multiverseId\': 638392}, \'multiverseid\': 638392}, {\'name\': \'Batedora de Mar e Céu\', \'text\': \'Voar\\nQuando Batedora de Mar e Céu entrar no campo de batalha, crie uma ficha de Mapa. (Ela é um artefato com "{1}, {T}, sacrifique este artefato: A criatura alvo que você controla explora. Ative somente como um feitiço".)\', \'type\': \'Criatura — Tritão Batedor\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638713&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0e40d916-cb75-4208-b7bb-46199e4cc8e2\', \'multiverseId\': 638713}, \'multiverseid\': 638713}, {\'name\': \'游风斥候\', \'text\': \'飞行\\n当游风斥候进战场时，派出一个地图衍生物。（它是具有「{1}，{T}，牺牲此神器：令目标由你操控的生物勘察。只能于法术时机起动」的神器。）\', \'type\': \'生物 — 人鱼／斥候\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639034&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'133d4514-6c18-41a8-8bda-ae3b6267ea86\', \'multiverseId\': 639034}, \'multiverseid\': 639034}]', '[{\'name\': \'Wegefinderin der Flussherolde\', \'text\': \'Wachsamkeit\\nWenn die Wegefinderin der Flussherolde ins Spiel kommt, erkundet sie. (Decke die oberste Karte deiner Bibliothek auf. Falls die Karte ein Land ist, nimm sie auf deine Hand. Lege sonst eine +1/+1-Marke auf diese Kreatur und lege dann die Karte zurück oder auf deinen Friedhof.)\', \'type\': \'Kreatur — Meervolk, Späher\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637249&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9b9e15c9-f157-4c24-a5c6-4f4ba5be05c9\', \'multiverseId\': 637249}, \'multiverseid\': 637249}, {\'name\': \'Guía de los Heraldos del Río\', \'text\': \'Vigilancia.\\nCuando la Guía de los Heraldos del Río entre al campo de batalla, explora. (Muestra la primera carta de tu biblioteca. Pon esa carta en tu mano si es una tierra. De lo contrario, pon un contador +1/+1 sobre esta criatura y luego devuelve la carta a su sitio o ponla en tu cementerio.)\', \'type\': \'Criatura — Explorador tritón\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637570&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5ca07d0e-380e-42b1-a429-316c779150d7\', \'multiverseId\': 637570}, \'multiverseid\': 637570}, {\'name\': "Guide des Hérauts de l\'onde", \'text\': "Vigilance\\nQuand la Guide des Hérauts de l\'onde arrive sur le champ de bataille, elle explore. (Révélez la carte du dessus de votre bibliothèque. Mettez cette carte dans votre main si c\'est un terrain. Sinon, mettez un marqueur +1/+1 sur cette créature, puis remettez la carte au-dessus de votre bibliothèque ou mettez-la dans votre cimetière.)", \'type\': \'Créature — ondin et éclaireur\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637891&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'28e1af60-cd55-464f-a54c-56d198e3e517\', \'multiverseId\': 637891}, \'multiverseid\': 637891}, {\'name\': \'Guida Araldo del Fiume\', \'text\': \'Cautela\\nQuando la Guida Araldo del Fiume entra nel campo di battaglia, esplora. (Rivela la prima carta del tuo grimorio. Se è una terra, aggiungila alla tua mano. Altrimenti, metti un segnalino +1/+1 su questa creatura, poi rimetti quella carta al suo posto o mettila nel tuo cimitero.)\', \'type\': \'Creatura — Esploratore Tritone\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638212&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6163bee2-35b5-4de3-9c5d-7dee83b1d7e0\', \'multiverseId\': 638212}, \'multiverseid\': 638212}, {\'name\': \'川守りの案内人\', \'text\': \'警戒\\n川守りの案内人が戦場に出たとき、これは探検を行う。（あなたのライブラリーの一番上にあるカード１枚を公開する。それが土地なら、そのカードをあなたの手札に加える。そうでないなら、このクリーチャーの上に＋１/＋１カウンター１個を置く。その後、そのカードを戻すかあなたの墓地に置く。）\', \'type\': \'クリーチャー — マーフォーク・スカウト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638533&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ea7945ba-d2ab-4e79-90ff-3fbb971f5e22\', \'multiverseId\': 638533}, \'multiverseid\': 638533}, {\'name\': \'Guia dos Arautos do Rio\', \'text\': \'Vigilância\\nQuando Guia dos Arautos do Rio entra no campo de batalha, ela explora. (Revele o card do topo de seu grimório. Coloque aquele card em sua mão se ele for um terreno. Caso contrário, coloque um marcador +1/+1 nesta criatura e, em seguida, devolva o card ao grimório ou coloque-o em seu cemitério.)\', \'type\': \'Criatura — Tritão Batedor\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638854&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3825d960-971a-44fa-923c-3f0309d42f2d\', \'multiverseId\': 638854}, \'multiverseid\': 638854}, {\'name\': \'川流使向导\', \'text\': \'警戒\\n当川流使向导进战场时，令它勘察。（展示你的牌库顶牌。如果该牌是地，则置于你手上。若否，则在此生物上放置一个+1/+1指示物，然后将所展示的牌放回原位或置入你的坟墓场。）\', \'type\': \'生物 — 人鱼／斥候\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639175&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9e42a377-0047-4d7b-bd77-687552eb127d\', \'multiverseId\': 639175}, \'multiverseid\': 639175}]', '[{\'name\': \'Wegelagernde Piraten\', \'text\': \'Wenn die Wegelagernden Piraten ins Spiel kommen und falls du ein Artefakt kontrollierst, tappe ein Artefakt oder eine Kreatur deiner Wahl, das bzw. die ein Gegner kontrolliert, und lege eine Betäubungsmarke auf es bzw. sie. (Falls ein Permanent mit Betäubungsmarke enttappt würde, entferne stattdessen eine davon.)\', \'type\': \'Kreatur — Mensch, Pirat\', \'flavor\': \'„Das einzige Getränk, das dich erwartet, ist Salzwasser."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637109&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2a69bac9-6694-4121-8494-28e093400592\', \'multiverseId\': 637109}, \'multiverseid\': 637109}, {\'name\': \'Piratas de abordaje\', \'text\': \'Cuando los Piratas de abordaje entren al campo de batalla, si controlas un artefacto, gira el artefacto o criatura objetivo que controla un oponente y pon un contador de aturdimiento sobre ese permanente. (Si un permanente con un contador de aturdimiento fuera a enderezarse, en vez de eso, remueve uno de esos contadores de él.)\', \'type\': \'Criatura — Pirata humano\', \'flavor\': \'"Lo único que beberás a partir de ahora es agua de mar".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637430&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4c000fd4-e0b0-49c5-87c0-ef118d812b07\', \'multiverseId\': 637430}, \'multiverseid\': 637430}, {\'name\': "Pirates à l\'abordage", \'text\': "Quand les Pirates à l\'abordage arrivent sur le champ de bataille, si vous contrôlez un artefact, engagez une cible, artefact ou créature, qu\'un adversaire contrôle et mettez un marqueur « étourdissement » sur elle. (Si un permanent avec un marqueur « étourdissement » devait devenir dégagé, retirez-lui-en un à la place.)", \'type\': \'Créature — humain et pirate\', \'flavor\': "« La seule chose qu\'il te reste à boire, c\'est la tasse. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637751&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6d954557-59c5-4bdb-9b82-f4bb1c1124a1\', \'multiverseId\': 637751}, \'multiverseid\': 637751}, {\'name\': \'Pirati Insidiosi\', \'text\': \'Quando i Pirati Insidiosi entrano nel campo di battaglia, se controlli un artefatto, TAPpa un artefatto o una creatura bersaglio controllati da un avversario e metti un segnalino stordimento su quel permanente. (Se un permanente con un segnalino stordimento sta per essere STAPpato, rimuovi invece un segnalino stordimento da esso.)\', \'type\': \'Creatura — Pirata Umano\', \'flavor\': \'"L\\\'unica cosa che berrai sarà acqua salata."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638072&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2b553024-96a8-4b13-b89a-a016b5b386a1\', \'multiverseId\': 638072}, \'multiverseid\': 638072}, {\'name\': \'待ち伏せる海賊\', \'text\': \'待ち伏せる海賊が戦場に出たとき、あなたがアーティファクトをコントロールしている場合、アーティファクトやクリーチャーであり対戦相手がコントロールしている１つを対象とする。それをタップし、それの上に麻痺カウンター１個を置く。（麻痺カウンターが置かれているパーマネントがアンタップ状態になるなら、代わりにそれの上から麻痺カウンター１個を取り除く。）\', \'type\': \'クリーチャー — 人間・海賊\', \'flavor\': \'「お前が今後口にできるのは海水だけだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638393&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fd664061-2186-4ab2-b4f3-24ff810c3ca9\', \'multiverseId\': 638393}, \'multiverseid\': 638393}, {\'name\': \'Piratas da Emboscada\', \'text\': \'Quando Piratas da Emboscada entrar no campo de batalha, se você controlar um artefato, vire o artefato ou a criatura alvo que um oponente controla e coloque um marcador de atordoamento naquela permanente. (Se uma permanente com um marcador de atordoamento se tornaria desvirada, em vez disso, remova um marcador de atordoamento dela.)\', \'type\': \'Criatura — Humano Pirata\', \'flavor\': \'"Sua única bebida no futuro será água do mar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638714&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'55c542c7-c564-4900-a847-d6359a772f09\', \'multiverseId\': 638714}, \'multiverseid\': 638714}, {\'name\': \'拦路海盗\', \'text\': \'当拦路海盗进战场时，若你操控神器，则横置目标由对手操控的神器或生物并在其上放置一个晕眩指示物。（如果某个其上有晕眩指示物的永久物将成为未横置，则改为从其上移去一个晕眩指示物。）\', \'type\': \'生物 — 人类／海盗\', \'flavor\': \'「你以后能喝到的就只有海水。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639035&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e4f5d797-131c-4602-94ff-1a6275f24c25\', \'multiverseId\': 639035}, \'multiverseid\': 639035}]', '[{\'name\': \'Wegsucher-Axtmaul\', \'text\': \'Wenn das Wegsucher-Axtmaul ins Spiel kommt, erkundet es. (Decke die oberste Karte deiner Bibliothek auf. Falls die Karte ein Land ist, nimm sie auf deine Hand. Lege sonst eine +1/+1-Marke auf diese Kreatur und lege dann die Karte zurück oder auf deinen Friedhof.)\', \'type\': \'Kreatur — Dinosaurier\', \'flavor\': \'Wenn du nicht weißt, welche Gefahren dich erwarten, nimm die größte Gefahr mit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637246&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'02f0b932-081d-4929-9177-9401a181d914\', \'multiverseId\': 637246}, \'multiverseid\': 637246}, {\'name\': \'Dentiferro abrecaminos\', \'text\': \'Cuando el Dentiferro abrecaminos entre al campo de batalla, explora. (Muestra la primera carta de tu biblioteca. Pon esa carta en tu mano si es una tierra. De lo contrario, pon un contador +1/+1 sobre esta criatura y luego devuelve la carta a su sitio o ponla en tu cementerio.)\', \'type\': \'Criatura — Dinosaurio\', \'flavor\': \'Si no sabes qué peligros te encontrarás, asegúrate de llevar el mayor peligro contigo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637567&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'af82b9d0-dc09-46a7-aae7-f827fe468407\', \'multiverseId\': 637567}, \'multiverseid\': 637567}, {\'name\': \'Gueule de hache pionnier\', \'text\': "Quand la Gueule de hache pionnier arrive sur le champ de bataille, elle explore. (Révélez la carte du dessus de votre bibliothèque. Mettez cette carte dans votre main si c\'est un terrain. Sinon, mettez un marqueur +1/+1 sur cette créature, puis remettez la carte au-dessus de votre bibliothèque ou mettez-la dans votre cimetière.)", \'type\': \'Créature — dinosaure\', \'flavor\': \'Quand vous ne savez pas quels dangers vous allez affronter, ayez le plus grand danger à vos côtés.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637888&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cc28c46e-8e05-4d13-85dd-d8c3f6dc688a\', \'multiverseId\': 637888}, \'multiverseid\': 637888}, {\'name\': \'Mascellascia Apripista\', \'text\': \'Quando la Mascellascia Apripista entra nel campo di battaglia, esplora. (Rivela la prima carta del tuo grimorio. Se è una terra, aggiungila alla tua mano. Altrimenti, metti un segnalino +1/+1 su questa creatura, poi rimetti quella carta al suo posto o mettila nel tuo cimitero.)\', \'type\': \'Creatura — Dinosauro\', \'flavor\': \'Quando non sai quali pericoli dovrai affrontare, porta al tuo fianco il pericolo più grande.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638209&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0c6d6fbb-7c6d-4344-bc34-1388d710d180\', \'multiverseId\': 638209}, \'multiverseid\': 638209}, {\'name\': \'開拓する斧顎\', \'text\': \'開拓する斧顎が戦場に出たとき、これは探検を行う。（あなたのライブラリーの一番上にあるカード１枚を公開する。それが土地なら、そのカードをあなたの手札に加える。そうでないなら、このクリーチャーの上に＋１/＋１カウンター１個を置く。その後、そのカードを戻すかあなたの墓地に置く。）\', \'type\': \'クリーチャー — 恐竜\', \'flavor\': \'想像もつかない危険を相手にする際は、考えうる最も危険な存在を共に連れてくるとよい。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638530&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5c753d4e-9b0f-4632-b537-427046bec4b1\', \'multiverseId\': 638530}, \'multiverseid\': 638530}, {\'name\': \'Desbravador Machadíbulo\', \'text\': \'Quando Desbravador Machadíbulo entra no campo de batalha, ela explora. (Revele o card do topo de seu grimório. Coloque aquele card em sua mão se ele for um terreno. Caso contrário, coloque um marcador +1/+1 nesta criatura e, em seguida, devolva o card ao grimório ou coloque-o em seu cemitério.)\', \'type\': \'Criatura — Dinossauro\', \'flavor\': \'Quando você não sabe que perigos vai encontrar, leve consigo o maior dos perigos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638851&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b4f49321-ca50-46e3-9ad8-ef55b31545f4\', \'multiverseId\': 638851}, \'multiverseid\': 638851}, {\'name\': \'探路斧颚龙\', \'text\': \'当探路斧颚龙进战场时，令它勘察。（展示你的牌库顶牌。如果该牌是地，则置于你手上。若否，则在此生物上放置一个+1/+1指示物，然后将所展示的牌放回原位或置入你的坟墓场。）\', \'type\': \'生物 — 恐龙\', \'flavor\': \'当你不知道会遇到何种凶险时，不妨将最大的凶险带在身边。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639172&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'774091f7-1412-4bd9-8a66-9c7961d4b9e0\', \'multiverseId\': 639172}, \'multiverseid\': 639172}]', '[{\'name\': \'Weiser der Tage\', \'text\': \'Wenn der Weise der Tage ins Spiel kommt, schaue dir die obersten drei Karten deiner Bibliothek an. Du kannst eine jener Karten zurück auf deine Bibliothek legen. Lege den Rest auf deinen Friedhof.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'„Auf dieses Zeitalter folgt ein weiteres."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637096&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'46671c42-b488-493d-bf8d-fd0f77782ef7\', \'multiverseId\': 637096}, \'multiverseid\': 637096}, {\'name\': \'Sabio de los días\', \'text\': \'Cuando el Sabio de los días entre al campo de batalla, mira las tres primeras cartas de tu biblioteca. Puedes poner una de esas cartas en la parte superior de tu biblioteca. Pon el resto en tu cementerio.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'"Tras esta era, otra".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637417&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0a07822d-a1a8-4c02-a451-8e35a14a407a\', \'multiverseId\': 637417}, \'multiverseid\': 637417}, {\'name\': \'Sage des jours\', \'text\': \'Quand le Sage des jours arrive sur le champ de bataille, regardez les trois cartes du dessus de votre bibliothèque. Vous pouvez remettre une de ces cartes au-dessus de votre bibliothèque. Mettez le reste dans votre cimetière.\', \'type\': \'Créature — humain et sorcier\', \'flavor\': \'« Après cette ère viendra une autre. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637738&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'104b830e-301d-4001-9bb3-8b99d6428479\', \'multiverseId\': 637738}, \'multiverseid\': 637738}, {\'name\': \'Saggio dei Giorni\', \'text\': \'Quando il Saggio dei Giorni entra nel campo di battaglia, guarda le prime tre carte del tuo grimorio. Puoi rimettere una di quelle carte in cima al tuo grimorio. Metti le altre nel tuo cimitero.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': \'"Un\\\'era segue l\\\'altra."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638059&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'38f272b2-3bcc-45e3-a537-8c76828f55cf\', \'multiverseId\': 638059}, \'multiverseid\': 638059}, {\'name\': \'日々の賢者\', \'text\': \'日々の賢者が戦場に出たとき、あなたのライブラリーの一番上にあるカード３枚を見る。そのうち１枚をあなたのライブラリーの一番上に置いてもよい。残りをあなたの墓地に置く。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'「時代が過ぎれば、また別の時代がくる。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638380&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'99d7b603-e9f8-4723-b27a-3ad3c148ad1d\', \'multiverseId\': 638380}, \'multiverseid\': 638380}, {\'name\': \'Sábio dos Dias\', \'text\': \'Quando Sábio dos Dias entrar no campo de batalha, olhe os três cards do topo de seu grimório. Você pode devolver um daqueles cards ao topo de seu grimório. Coloque o restante em seu cemitério.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'"Depois desta era virá outra."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638701&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d6a6df95-2e1e-493a-8e36-1c27ca1cd629\', \'multiverseId\': 638701}, \'multiverseid\': 638701}, {\'name\': \'岁月智者\', \'text\': \'当岁月智者进战场时，检视你牌库顶的三张牌。你可以将其中一张放回你的牌库顶。将其余的牌置入你的坟墓场。\', \'type\': \'生物 — 人类／法术师\', \'flavor\': \'「此纪过后，还有来纪。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639022&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3f70f134-69fe-4dcf-be38-ade677f18e8e\', \'multiverseId\': 639022}, \'multiverseid\': 639022}]', '[{\'name\': \'Widerhallende Tiefen\', \'text\': \'Du kannst die Widerhallenden Tiefen getappt als Kopie einer beliebigen Länderkarte in einem Friedhof ins Spiel kommen lassen, außer dass sie zusätzlich zu ihren anderen Typen eine Höhle sind.\\n{T}: Erzeuge {C}.\', \'type\': \'Land — Höhle\', \'flavor\': \'Die stillen, ruhigen Gewässer spiegeln das wider, was war, und nicht das, was ist.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637317&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7569d653-ed04-4cdc-aae2-18650b7a3345\', \'multiverseId\': 637317}, \'multiverseid\': 637317}, {\'name\': \'Profundidades resonantes\', \'text\': \'Puedes hacer que las Profundidades resonantes entren al campo de batalla giradas como una copia de cualquier carta de tierra en un cementerio, excepto que son una Cueva además de sus otros tipos.\\n{T}: Agrega {C}.\', \'type\': \'Tierra — Cueva\', \'flavor\': \'Las aguas inmóviles y enmudecidas reflejan lo que había, no lo que hay.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637638&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'42549578-7116-4a34-a575-4b1a6e4bf0ee\', \'multiverseId\': 637638}, \'multiverseid\': 637638}, {\'name\': \'Profondeurs résonnantes\', \'text\': "Vous pouvez faire que les Profondeurs résonnantes arrivent sur le champ de bataille engagées comme une copie de n\'importe quelle carte de terrain dans un cimetière, excepté que c\'est une caverne en plus de ses autres types.\\n{T} : Ajoutez {C}.", \'type\': \'Terrain — caverne\', \'flavor\': \'Les eaux calmes et silencieuses reflètent ce qui était, pas ce qui est.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637959&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d47be1f8-dd83-4505-b2b4-58ebb3c1ebb5\', \'multiverseId\': 637959}, \'multiverseid\': 637959}, {\'name\': \'Profondità Riecheggianti\', \'text\': \'Puoi far entrare le Profondità Riecheggianti nel campo di battaglia TAPpate come una copia di qualsiasi carta terra in un cimitero, tranne che è una Caverna in aggiunta ai suoi altri tipi.\\n{T}: Aggiungi {C}.\', \'type\': \'Terra — Caverna\', \'flavor\': "L\'acqua calma e silente riflette ciò che era, non ciò che è.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638280&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'82084568-bae4-429c-963c-534319f3a9cc\', \'multiverseId\': 638280}, \'multiverseid\': 638280}, {\'name\': \'残響する深淵\', \'text\': \'残響する深淵を、他のタイプに加えて洞窟であることを除き、墓地にある土地・カード１枚のコピーとしてタップ状態で戦場に出してもよい。\\n{T}：{C}を加える。\', \'type\': \'土地 — 洞窟\', \'flavor\': \'静かな水面には今の姿ではなく、かつての姿が浮かび上がる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638601&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e2568114-751f-48f6-acc8-865c4aa6734d\', \'multiverseId\': 638601}, \'multiverseid\': 638601}, {\'name\': \'Profundezas Ecoantes\', \'text\': \'Você pode fazer com que Profundezas Ecoantes entre no campo de batalha virada como uma cópia de qualquer card de terreno em um cemitério, exceto por ser uma Caverna além de seus outros tipos.\\n{T}: Adicione {C}.\', \'type\': \'Terreno — Caverna\', \'flavor\': \'As águas plácidas e silenciosas refletem o que foi, não o que é.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638922&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'14c69b70-3664-4d63-bdaf-3a66b82ee0a7\', \'multiverseId\': 638922}, \'multiverseid\': 638922}, {\'name\': \'回响深渊\', \'text\': \'你可以使回响深渊当成坟墓场中任一地牌的复制品来横置进入战场，但它额外具有洞窟此类别。\\n{T}：加{C}。\', \'type\': \'地 — 洞窟\', \'flavor\': \'沉静池水倒映的皆为过往，而非当下。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639243&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0e61fdec-fcf6-4d28-a467-a4a91d37ab17\', \'multiverseId\': 639243}, \'multiverseid\': 639243}]', '[{\'name\': \'Widerhallende Tiefen\', \'text\': \'Du kannst die Widerhallenden Tiefen getappt als Kopie einer beliebigen Länderkarte in einem Friedhof ins Spiel kommen lassen, außer dass sie zusätzlich zu ihren anderen Typen eine Höhle sind.\\n{T}: Erzeuge {C}.\', \'type\': \'Land — Höhle\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639293&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3bee24eb-8a47-498a-bf05-845a8bbfe6da\', \'multiverseId\': 639293}, \'multiverseid\': 639293}, {\'name\': \'Profundidades resonantes\', \'text\': \'Puedes hacer que las Profundidades resonantes entren al campo de batalla giradas como una copia de cualquier carta de tierra en un cementerio, excepto que son una Cueva además de sus otros tipos.\\n{T}: Agrega {C}.\', \'type\': \'Tierra — Cueva\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639313&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d488256d-b9ec-45db-ac7f-ab1cc1888396\', \'multiverseId\': 639313}, \'multiverseid\': 639313}, {\'name\': \'Profondeurs résonnantes\', \'text\': "Vous pouvez faire que les Profondeurs résonnantes arrivent sur le champ de bataille engagées comme une copie de n\'importe quelle carte de terrain dans un cimetière, excepté que c\'est une caverne en plus de ses autres types.\\n{T} : Ajoutez {C}.", \'type\': \'Terrain — caverne\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639333&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a191f8c3-4d23-4908-b190-6bdd3aba766c\', \'multiverseId\': 639333}, \'multiverseid\': 639333}, {\'name\': \'Profondità Riecheggianti\', \'text\': \'Puoi far entrare le Profondità Riecheggianti nel campo di battaglia TAPpate come una copia di qualsiasi carta terra in un cimitero, tranne che è una Caverna in aggiunta ai suoi altri tipi.\\n{T}: Aggiungi {C}.\', \'type\': \'Terra — Caverna\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639353&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3c13433e-e837-4685-a5fd-8408559fa045\', \'multiverseId\': 639353}, \'multiverseid\': 639353}, {\'name\': \'残響する深淵\', \'text\': \'残響する深淵を、他のタイプに加えて洞窟であることを除き、墓地にある土地・カード１枚のコピーとしてタップ状態で戦場に出してもよい。\\n{T}：{C}を加える。\', \'type\': \'土地 — 洞窟\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639373&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dc000a56-f8d7-4f3f-9b50-a6592bc38fd0\', \'multiverseId\': 639373}, \'multiverseid\': 639373}, {\'name\': \'Profundezas Ecoantes\', \'text\': \'Você pode fazer com que Profundezas Ecoantes entre no campo de batalha virada como uma cópia de qualquer card de terreno em um cemitério, exceto por ser uma Caverna além de seus outros tipos.\\n{T}: Adicione {C}.\', \'type\': \'Terreno — Caverna\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639393&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e4e41d7b-405a-41bf-80a1-7c6bdbaaa49c\', \'multiverseId\': 639393}, \'multiverseid\': 639393}, {\'name\': \'回响深渊\', \'text\': \'你可以使回响深渊当成坟墓场中任一地牌的复制品来横置进入战场，但它额外具有洞窟此类别。\\n{T}：加{C}。\', \'type\': \'地 — 洞窟\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639413&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d340190d-337a-4bee-8c1f-4f5e38f0ea77\', \'multiverseId\': 639413}, \'multiverseid\': 639413}]', '[{\'name\': \'Wächterin der Großen Pforte\', \'text\': \'Tappe als zusätzliche Kosten, um diesen Zauberspruch zu wirken, vier ungetappte Artefakte, Kreaturen und/oder Länder, die du kontrollierst.\\nFliegend\', \'type\': \'Kreatur — Engel\', \'flavor\': \'Der Weltenkern wurde von den Göttern der Tiefen versiegelt, die den Engeln die Aufgabe auferlegten, seine goldenen Pforten bis in alle Ewigkeit zu bewachen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637028&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'825bbd87-efb2-4ff6-8fb5-480c1a9118ea\', \'multiverseId\': 637028}, \'multiverseid\': 637028}, {\'name\': \'Guardiana de la gran puerta\', \'text\': \'Como coste adicional para lanzar este hechizo, gira cuatro criaturas, tierras y/o artefactos enderezados que controlas.\\nVuela.\', \'type\': \'Criatura — Ángel\', \'flavor\': \'Los Dioses Profundos sellaron el núcleo tiempo ha y encomendaron a los ángeles la tarea eterna de defender sus puertas doradas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637349&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bcc9a45e-00c4-4f82-ae14-5e14a029eb6c\', \'multiverseId\': 637349}, \'multiverseid\': 637349}, {\'name\': \'Gardienne de la Grande porte\', \'text\': \'En tant que coût supplémentaire pour lancer ce sort, engagez quatre artefacts, créatures et/ou terrains dégagés que vous contrôlez.\\nVol\', \'type\': \'Créature — ange\', \'flavor\': \'Le Noyau avait été depuis longtemps scellé par les Dieux des Profondeurs, qui donnèrent aux anges la mission éternelle de défendre ses portes dorées.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637670&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ac623240-8595-461e-bab2-764528a758e0\', \'multiverseId\': 637670}, \'multiverseid\': 637670}, {\'name\': \'Guardiana della Grande Porta\', \'text\': \'Come costo addizionale per lanciare questa magia, TAPpa quattro artefatti, creature e/o terre STAPpati che controlli.\\nVolare\', \'type\': \'Creatura — Angelo\', \'flavor\': "Il Nucleo fu sigillato molto tempo fa dagli Dei Profondi, che assegnarono agli angeli l\'eterno compito di difenderne i cancelli dorati.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637991&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'26e3c47a-22e1-448d-9e3c-4547e84ec01e\', \'multiverseId\': 637991}, \'multiverseid\': 637991}, {\'name\': \'大いなる扉の守護者\', \'text\': \'この呪文を唱えるための追加コストとして、アーティファクトやクリーチャーや土地でありあなたがコントロールしていてアンタップ状態である４つをタップする。\\n飛行\', \'type\': \'クリーチャー — 天使\', \'flavor\': \'古の時代、中心核は深淵の神々により封印された。神々はそして、黄金の門を永久に守るという使命を天使たちに課したのだった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638312&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2e4a4d95-d7d8-49c1-9ef9-3e166e8bb1b8\', \'multiverseId\': 638312}, \'multiverseid\': 638312}, {\'name\': \'Guardiã da Grande Porta\', \'text\': \'Como custo adicional para conjurar esta mágica, vire quatro artefatos, criaturas e/ou terrenos desvirados que você controla.\\nVoar\', \'type\': \'Criatura — Anjo\', \'flavor\': \'O Núcleo foi selado há muito tempo pelos Deuses das Profundezas, que atribuíram aos anjos a eterna tarefa de defender seus portões dourados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638633&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'44b03bf4-9d80-4ce9-9a0e-40f227a1188f\', \'multiverseId\': 638633}, \'multiverseid\': 638633}, {\'name\': \'伟门守护使\', \'text\': \'横置四个由你操控且未横置的神器，生物和／或地，以作为施放此咒语的额外费用。\\n飞行\', \'type\': \'生物 — 天使\', \'flavor\': \'深邃尊神很久以前就将世界核心封印，并派出天使永世守卫黄金伟门。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638954&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9aadc3f7-7eeb-4cb1-9cea-a75a34d4517d\', \'multiverseId\': 638954}, \'multiverseid\': 638954}]', '[{\'name\': \'Wünschelrutenapparat // Drusengrotte\', \'text\': \'(Transformierter Wünschelrutenapparat.)\\n{T}: Erzeuge {R}.\\n{2}{R}, {T}: Bis zum Ende des Zuges erhält eine Kreatur deiner Wahl Eile und +X/+0, wobei X gleich der Anzahl an Artefakten ist, die du kontrollierst. Aktiviere diese Fähigkeit wie eine Hexerei.\', \'type\': \'Land — Höhle\', \'flavor\': None, \'faceName\': \'Drusengrotte\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637177&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4a631b8c-7c9b-402f-af6b-43e5619af57c\', \'multiverseId\': 637177}, \'multiverseid\': 637177}, {\'name\': \'Aparato de radiestesia // Gruta de geodas\', \'text\': \'(Se transforma del Aparato de radiestesia.)\\n{T}: Agrega {R}.\\n{2}{R}, {T}: Hasta el final del turno, la criatura objetivo gana la habilidad de prisa y obtiene +X/+0, donde X es la cantidad de artefactos que controlas. Activa esto solo como un conjuro.\', \'type\': \'Tierra — Cueva\', \'flavor\': None, \'faceName\': \'Gruta de geodas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637498&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'02abec6d-6528-403f-b65d-cf60d9256dd4\', \'multiverseId\': 637498}, \'multiverseid\': 637498}, {\'name\': \'Appareil de sourcier // Grotte aux géodes\', \'text\': "(Transformation de l\'Appareil de sourcier.)\\n{T} : Ajoutez {R}.\\n{2}{R}, {T} : Jusqu\'à la fin du tour, une créature ciblée acquiert la célérité et gagne +X/+0, X étant le nombre d\'artefacts que vous contrôlez. N\'activez que lorsque vous pourriez lancer un rituel.", \'type\': \'Terrain — caverne\', \'flavor\': None, \'faceName\': \'Grotte aux géodes\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637819&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'44d8bc32-a842-4de0-9d74-ac2eee1f8436\', \'multiverseId\': 637819}, \'multiverseid\': 637819}, {\'name\': \'Dispositivo da Rabdomante // Grotta di Geodi\', \'text\': \'(Si trasforma dal Dispositivo da Rabdomante.)\\n{T}: Aggiungi {R}.\\n{2}{R}, {T}: Fino alla fine del turno, una creatura bersaglio ha rapidità e prende +X/+0, dove X è il numero di artefatti che controlli. Attiva solo come una stregoneria.\', \'type\': \'Terra — Caverna\', \'flavor\': None, \'faceName\': \'Grotta di Geodi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638140&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4ad47217-5600-4336-8c11-921c786985e0\', \'multiverseId\': 638140}, \'multiverseid\': 638140}, {\'name\': \'探査装置 // 晶洞の岩屋\', \'text\': \'（探査装置から変身する。）\\n{T}：{R}を加える。\\n{2}{R}, {T}：クリーチャー１体を対象とする。ターン終了時まで、それは速攻を得て＋Ｘ/＋０の修整を受ける。Ｘは、あなたがコントロールしているアーティファクトの数に等しい。起動はソーサリーとしてのみ行う。\', \'type\': \'土地 — 洞窟\', \'flavor\': None, \'faceName\': \'晶洞の岩屋\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638461&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'523854a0-f090-4be6-ab78-b2e817e0272d\', \'multiverseId\': 638461}, \'multiverseid\': 638461}, {\'name\': \'Dispositivo de Radiestesia // Grota do Geodo\', \'text\': \'(Transformação de Dispositivo de Radiestesia.)\\n{T}: Adicione {R}.\\n{2}{R}, {T}: Até o final do turno, a criatura alvo ganha ímpeto e recebe +X/+0, sendo X o número de artefatos que você controla. Ative somente como um feitiço.\', \'type\': \'Terreno — Caverna\', \'flavor\': None, \'faceName\': \'Grota do Geodo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638782&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d1c54d1a-c9a9-458a-a11a-f8e05bd2e26b\', \'multiverseId\': 638782}, \'multiverseid\': 638782}, {\'name\': \'探源装置 // 晶岩石室\', \'text\': \'（由探源装置转化。）\\n{T}：加{R}。\\n{2}{R}，{T}：直到回合结束，目标生物获得敏捷异能且得+X/+0，X为由你操控的神器数量。只能于法术时机起动。\', \'type\': \'地 — 洞窟\', \'flavor\': None, \'faceName\': \'晶岩石室\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639103&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'58c6d7ea-bc5b-464b-892d-0d3cb3854cd2\', \'multiverseId\': 639103}, \'multiverseid\': 639103}]', '[{\'name\': \'Wünschelrutenapparat // Drusengrotte\', \'text\': \'Immer wenn der Wünschelrutenapparat oder ein anderes Artefakt unter deiner Kontrolle ins Spiel kommt, erhält bis zu eine Kreatur deiner Wahl, die du kontrollierst, +1/+0 und Eile bis zum Ende des Zuges. Transformiere dann den Wünschelrutenapparat, falls du vier oder mehr Artefakte kontrollierst.\', \'type\': \'Artefakt\', \'flavor\': \'„Ein wenig Innovation kann dir gewaltige Schätze einbringen."\\n—Admiralin Beckett Tollkun\', \'faceName\': \'Wünschelrutenapparat\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637177&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4a631b8c-7c9b-402f-af6b-43e5619af57c\', \'multiverseId\': 637177}, \'multiverseid\': 637177}, {\'name\': \'Aparato de radiestesia // Gruta de geodas\', \'text\': \'Siempre que el Aparato de radiestesia u otro artefacto entre al campo de batalla bajo tu control, hasta una criatura objetivo que controlas obtiene +1/+0 y gana la habilidad de prisa hasta el final del turno. Luego, transforma el Aparato de radiestesia si controlas cuatro o más artefactos.\', \'type\': \'Artefacto\', \'flavor\': \'"Un poco de innovación puede dar grandes recompensas".\\n—Almirante Beckett Azófar\', \'faceName\': \'Aparato de radiestesia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637498&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'02abec6d-6528-403f-b65d-cf60d9256dd4\', \'multiverseId\': 637498}, \'multiverseid\': 637498}, {\'name\': \'Appareil de sourcier // Grotte aux géodes\', \'text\': "À chaque fois que l\'Appareil de sourcier ou qu\'un autre artefact arrive sur le champ de bataille sous votre contrôle, jusqu\'à une créature ciblée que vous contrôlez gagne +1/+0 et acquiert la célérité jusqu\'à la fin du tour. Puis transformez l\'Appareil de sourcier si vous contrôlez au moins quatre artefacts.", \'type\': \'Artefact\', \'flavor\': \'« Une petite innovation peut donner de gros résultats. »\\n—Amirale Beckett Hardiesce\', \'faceName\': \'Appareil de sourcier\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637819&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'44d8bc32-a842-4de0-9d74-ac2eee1f8436\', \'multiverseId\': 637819}, \'multiverseid\': 637819}, {\'name\': \'Dispositivo da Rabdomante // Grotta di Geodi\', \'text\': \'Ogniqualvolta il Dispositivo da Rabdomante o un altro artefatto entra nel campo di battaglia sotto il tuo controllo, fino a una creatura bersaglio che controlli prende +1/+0 e ha rapidità fino alla fine del turno. Poi trasforma il Dispositivo da Rabdomante se controlli quattro o più artefatti.\', \'type\': \'Artefatto\', \'flavor\': \'"Una piccola innovazione può portare a grandi risultati."\\n—Ammiraglio Beckett Cuor di Bronzo\', \'faceName\': \'Dispositivo da Rabdomante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638140&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4ad47217-5600-4336-8c11-921c786985e0\', \'multiverseId\': 638140}, \'multiverseid\': 638140}, {\'name\': \'探査装置 // 晶洞の岩屋\', \'text\': \'探査装置、またはこれでないアーティファクト１つがあなたのコントロール下で戦場に出るたび、あなたがコントロールしているクリーチャー最大１体を対象とする。ターン終了時まで、それは＋１/＋０の修整を受け速攻を得る。その後、あなたが４つ以上のアーティファクトをコントロールしているなら、探査装置を変身させる。\', \'type\': \'アーティファクト\', \'flavor\': \'「小さな変革も、大きな稼ぎに繋がるのさ。」\\n――鉄面提督ベケット\', \'faceName\': \'探査装置\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638461&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'523854a0-f090-4be6-ab78-b2e817e0272d\', \'multiverseId\': 638461}, \'multiverseid\': 638461}, {\'name\': \'Dispositivo de Radiestesia // Grota do Geodo\', \'text\': \'Toda vez que Dispositivo de Radiestesia ou outro artefato entra no campo de batalha sob seu controle, até uma criatura alvo que você controla recebe +1/+0 e ganha ímpeto até o final do turno. Depois, transforme Dispositivo de Radiestesia se você controlar quatro ou mais artefatos.\', \'type\': \'Artefato\', \'flavor\': \'"Uma pequena inovação pode levar a grandes ganhos."\\n— Almirante Beckett Bronze\', \'faceName\': \'Dispositivo de Radiestesia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638782&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d1c54d1a-c9a9-458a-a11a-f8e05bd2e26b\', \'multiverseId\': 638782}, \'multiverseid\': 638782}, {\'name\': \'探源装置 // 晶岩石室\', \'text\': \'每当探源装置或另一个神器在你操控下进战场时，直到回合结束，至多一个目标由你操控的生物得+1/+0且获得敏捷异能。然后若你操控四个或更多神器，则转化探源装置。\', \'type\': \'神器\', \'flavor\': \'「小发明可能带来大收获。」\\n～贝克蒂霸司总帅\', \'faceName\': \'探源装置\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639103&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'58c6d7ea-bc5b-464b-892d-0d3cb3854cd2\', \'multiverseId\': 639103}, \'multiverseid\': 639103}]', '[{\'name\': \'Zahnrad-Ringer\', \'text\': \'Aufblitzen\\nWenn der Zahnrad-Ringer ins Spiel kommt, erhält eine Kreatur deiner Wahl, die ein Gegner kontrolliert, -2/-0 bis zum Ende des Zuges.\', \'type\': \'Artefaktkreatur — Gnom\', \'flavor\': \'Jahre voller Abenteuer und Widrigkeiten auf hoher See konnten Brog nicht gegen die Demütigung wappnen, einen Ringkampf gegen eine Zahnrad-Puppe zu verlieren, die nicht einmal halb so groß war wie er.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637067&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5d9adc6e-8f2e-4723-9247-fd1db574e955\', \'multiverseId\': 637067}, \'multiverseid\': 637067}, {\'name\': \'Luchador mecánico\', \'text\': \'Destello.\\nCuando el Luchador mecánico entre al campo de batalla, la criatura objetivo que controla un oponente obtiene -2/-0 hasta el final del turno.\', \'type\': \'Criatura artefacto — Gnomo\', \'flavor\': \'Ni todos sus años de aventuras y peligros en alta mar prepararon a Brog para su humillante derrota en un combate contra un muñeco mecánico que no le llegaba ni a la cintura.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637388&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2eda50a5-7c89-433b-9b25-7c9cbb5263fa\', \'multiverseId\': 637388}, \'multiverseid\': 637388}, {\'name\': \'Lutteur mécanique\', \'text\': "Flash\\nQuand le Lutteur mécanique arrive sur le champ de bataille, une créature ciblée qu\'un adversaire contrôle gagne -2/-0 jusqu\'à la fin du tour.", \'type\': \'Créature-artefact — gnome\', \'flavor\': "Des années d\'aventures et d\'adversité en pleine mer n\'avaient pas préparé Brog à l\'humiliation de perdre une confrontation contre une poupée mécanique faisant la moitié de sa taille.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637709&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'921f2f8d-720d-45c9-a108-2d451a9ace25\', \'multiverseId\': 637709}, \'multiverseid\': 637709}, {\'name\': \'Lottatore a Ingranaggi\', \'text\': \'Lampo\\nQuando il Lottatore a Ingranaggi entra nel campo di battaglia, una creatura bersaglio controllata da un avversario prende -2/-0 fino alla fine del turno.\', \'type\': \'Creatura Artefatto — Gnomo\', \'flavor\': "Anni di avventure e avversità in mare aperto non avevo preparato Brog all\'umiliazione di perdere un incontro con un bambolotto a ingranaggi che gli arrivava a malapena al ginocchio.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638030&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0757df09-b5db-4fc3-8a96-f881e906783a\', \'multiverseId\': 638030}, \'multiverseid\': 638030}, {\'name\': \'歯車式闘士\', \'text\': \'瞬速\\n歯車式闘士が戦場に出たとき、対戦相手がコントロールしているクリーチャー１体を対象とする。ターン終了時まで、それは－２/－０の修整を受ける。\', \'type\': \'アーティファクト・クリーチャー — ノーム\', \'flavor\': \'長年にわたる大海原での冒険や逆境の経験を以てしても、背丈の半分にも満たない機械人形との練習試合に負けるという屈辱をブログは覚悟していなかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638351&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'211e8146-02ec-4c7a-a6cd-b574c31d8743\', \'multiverseId\': 638351}, \'multiverseid\': 638351}, {\'name\': \'Lutador Mecânico\', \'text\': \'Lampejo\\nQuando Lutador Mecânico entra no campo de batalha, a criatura alvo que um oponente controla recebe -2/-0 até o final do turno.\', \'type\': \'Criatura Artefato — Gnomo\', \'flavor\': \'Anos de aventuras e adversidades em mar aberto não prepararam Brog para a humilhação de perder treinando contra um boneco mecânico com menos da metade de seu tamanho.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638672&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e9df7af8-b230-4c06-8759-0a0a36b6177b\', \'multiverseId\': 638672}, \'multiverseid\': 638672}, {\'name\': \'齿轮摔角械\', \'text\': \'闪现\\n当齿轮摔角械进战场时，目标由对手操控的生物得-2/-0直到回合结束。\', \'type\': \'神器生物 — 地侏\', \'flavor\': \'虽然布洛葛早在惊涛骇浪中出生入死历练多年，但当他在拳赛中输给个头不及自己一半的齿轮机械时，还是很难咽下这口气。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638993&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a3d898f4-c46c-455f-9b4b-ef0dbd6f26d9\', \'multiverseId\': 638993}, \'multiverseid\': 638993}]', '[{\'name\': \'Zauberhafte Höhle\', \'text\': \'{T}: Erzeuge {C}.\\n{1}, {T}: Erzeuge ein Mana einer beliebigen Farbe.\\n{4}, {T}, opfere die Zauberhafte Höhle: Lege zwei +1/+1-Marken auf eine Kreatur deiner Wahl. Aktiviere diese Fähigkeit wie eine Hexerei.\', \'type\': \'Land — Höhle\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637314&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cfb49a51-fb92-4560-8c37-0a37ac1745ac\', \'multiverseId\': 637314}, \'multiverseid\': 637314}, {\'name\': \'Cueva cautivadora\', \'text\': \'{T}: Agrega {C}.\\n{1}, {T}: Agrega un maná de cualquier color.\\n{4}, {T}, sacrificar la Cueva cautivadora: Pon dos contadores +1/+1 sobre la criatura objetivo. Activa esto solo como un conjuro.\', \'type\': \'Tierra — Cueva\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637635&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5abd4625-3500-4877-95af-d90348376da5\', \'multiverseId\': 637635}, \'multiverseid\': 637635}, {\'name\': \'Caverne captivante\', \'text\': "{T} : Ajoutez {C}.\\n{1}, {T} : Ajoutez un mana de la couleur de votre choix.\\n{4}, {T}, sacrifiez la Caverne captivante : Mettez deux marqueurs +1/+1 sur une créature ciblée. N\'activez que lorsque vous pourriez lancer un rituel.", \'type\': \'Terrain — caverne\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637956&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2e0b1d4a-92cf-47d8-9505-3aa23e187b68\', \'multiverseId\': 637956}, \'multiverseid\': 637956}, {\'name\': \'Caverna Accattivante\', \'text\': \'{T}: Aggiungi {C}.\\n{1}, {T}: Aggiungi un mana di un qualsiasi colore.\\n{4}, {T}, Sacrifica la Caverna Accattivante: Metti due segnalini +1/+1 su una creatura bersaglio. Attiva solo come una stregoneria.\', \'type\': \'Terra — Caverna\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638277&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2eb04f12-d7a5-42f7-b7cb-71de919228ff\', \'multiverseId\': 638277}, \'multiverseid\': 638277}, {\'name\': \'魅惑の洞窟\', \'text\': \'{T}：{C}を加える。\\n{1}, {T}：好きな色１色のマナ１点を加える。\\n{4}, {T}, 魅惑の洞窟を生け贄に捧げる：クリーチャー１体を対象とする。それの上に＋１/＋１カウンター２個を置く。起動はソーサリーとしてのみ行う。\', \'type\': \'土地 — 洞窟\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638598&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eeba6461-786f-45ad-9bc1-b2a6fdbeec60\', \'multiverseId\': 638598}, \'multiverseid\': 638598}, {\'name\': \'Caverna Fascinante\', \'text\': \'{T}: Adicione {C}.\\n{1}, {T}: Adicione um mana de qualquer cor.\\n{4}, {T}, sacrifique Caverna Fascinante: Coloque dois marcadores +1/+1 na criatura alvo. Ative somente como um feitiço.\', \'type\': \'Terreno — Caverna\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638919&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0c622d91-c924-4bf5-ab22-af69d98881a7\', \'multiverseId\': 638919}, \'multiverseid\': 638919}, {\'name\': \'魅惑洞窟\', \'text\': \'{T}：加{C}。\\n{1}，{T}：加一点任意颜色的法术力。\\n{4}，{T}，牺牲魅惑洞窟：在目标生物上放置两个+1/+1指示物。只能于法术时机起动。\', \'type\': \'地 — 洞窟\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639240&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'313280da-e33e-45f9-8764-587738804c4f\', \'multiverseId\': 639240}, \'multiverseid\': 639240}]', '[{\'name\': \'Zehntfordernde Klinge // Verschlingende Grabkammer\', \'text\': \'Wenn die Zehntfordernde Klinge ins Spiel kommt, opfert jeder Gegner eine Kreatur.\\nAnfertigung mit einer Kreatur {4}{B} ({4}{B}, schicke dieses Artefakt ins Exil, schicke eine Kreatur, die du kontrollierst, oder eine Kreaturenkarte aus deinem Friedhof ins Exil: Bringe diese Karte transformiert unter der Kontrolle ihres Besitzers ins Spiel zurück. Spiele Anfertigung wie eine Hexerei.)\', \'type\': \'Artefakt\', \'flavor\': \'„Stille meinen Durst, auf dass wir beide frei sein mögen."\\n—Verblasste Inschrift\', \'faceName\': \'Zehntfordernde Klinge\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637155&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5f31a618-0949-444a-895d-742af425bd3c\', \'multiverseId\': 637155}, \'multiverseid\': 637155}, {\'name\': \'Hoja diezmal // Sepulcro ávido\', \'text\': \'Cuando la Hoja diezmal entre al campo de batalla, cada oponente sacrifica una criatura.\\nElaborar con criatura {4}{B}. ({4}{B}, exiliar este artefacto, exiliar una criatura que controlas o una carta de criatura de tu cementerio: Regresa esta carta transformada bajo el control de su propietario. Activa la habilidad de elaborar solo como un conjuro.)\', \'type\': \'Artefacto\', \'flavor\': \'"Sacia mi sed para que ambos podamos ser libres".\\n—Inscripción desgastada\', \'faceName\': \'Hoja diezmal\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637476&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'137d8316-1fd4-4a72-989e-7459cee6133d\', \'multiverseId\': 637476}, \'multiverseid\': 637476}, {\'name\': \'Lame de prélèvement // Sépulcre dévorant\', \'text\': \'Quand la Lame de prélèvement arrive sur le champ de bataille, chaque adversaire sacrifie une créature.\\nFaçonnez avec une créature {4}{B} ({4}{B}, exilez cet artefact, exilez une créature que vous contrôlez ou une carte de créature de votre cimetière : Renvoyez cette carte transformée sous le contrôle de son propriétaire. Ne façonnez que lorsque vous pourriez lancer un rituel.)\', \'type\': \'Artefact\', \'flavor\': \'« Étanchez ma soif, que nous puissions tous deux être libres. »\\n—Inscription effacée\', \'faceName\': \'Lame de prélèvement\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637797&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ffab79f7-cc4a-4702-a176-75989cf962a1\', \'multiverseId\': 637797}, \'multiverseid\': 637797}, {\'name\': \'Lama del Tributo // Sepolcro Divoratore\', \'text\': \'Quando la Lama del Tributo entra nel campo di battaglia, ogni avversario sacrifica una creatura.\\nCostruisci con creature {4}{B} ({4}{B}, Esilia questo artefatto, Esilia una creatura che controlli o una carta creatura dal tuo cimitero: Rimetti questa carta trasformata sotto il controllo del suo proprietario. Costruisci solo come una stregoneria.)\', \'type\': \'Artefatto\', \'flavor\': \'"Placa la mia sete e saremo entrambi liberi."\\n—Iscrizione consumata\', \'faceName\': \'Lama del Tributo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638118&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fc69e4f8-3f8d-4a57-8a59-29a3d345d7d6\', \'multiverseId\': 638118}, \'multiverseid\': 638118}, {\'name\': \'税血の刃 // 貪る墓所\', \'text\': \'税血の刃が戦場に出たとき、各対戦相手はそれぞれクリーチャー１体を生け贄に捧げる。\\nクリーチャーで作製{4}{B} （{4}{B}, このアーティファクトを追放する, あなたがコントロールしているクリーチャーやあなたの墓地にあるクリーチャー・カードである１つを追放する：このカードをオーナーのコントロール下で変身させた状態で戻す。作製はソーサリーとしてのみ行う。）\', \'type\': \'アーティファクト\', \'flavor\': \'「我が乾きを満たせ、さすれば我ら共に自由となろう。」\\n――掠れた記述\', \'faceName\': \'税血の刃\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638439&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e1611f7e-a44c-4856-b797-f87ccdef4059\', \'multiverseId\': 638439}, \'multiverseid\': 638439}, {\'name\': \'Lâmina da Coleta // Sepulcro Consumidor\', \'text\': \'Quando Lâmina da Coleta entra no campo de batalha, cada oponente sacrifica uma criatura.\\nConstruir com criatura {4}{B} ({4}{B}, exile este artefato, exile uma criatura que você controla ou um card de criatura de seu cemitério: Devolva este card ao campo de batalha transformado sob o controle de seu dono. Construa somente como um feitiço.)\', \'type\': \'Artefato\', \'flavor\': \'"Sacie minha sede para que ambos nos libertemos."\\n— inscrição esmaecida\', \'faceName\': \'Lâmina da Coleta\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638760&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c60866db-610e-473a-aee4-66a679b2b0a3\', \'multiverseId\': 638760}, \'multiverseid\': 638760}, {\'name\': \'奉献祭刃 // 噬人坟墓\', \'text\': \'当奉献祭刃进战场时，每位对手各牺牲一个生物。\\n以生物化炼{4}{B}（{4}{B}，放逐此神器，放逐一个由你操控的生物或一张你坟墓场中的生物牌：将此牌在其拥有者的操控下移回且已转化。只能于法术时机化炼。）\', \'type\': \'神器\', \'flavor\': \'「解我干渴，你我同得解脱。」\\n～模糊不清的铭文\', \'faceName\': \'奉献祭刃\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639081&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'813d1eb6-80f4-40a6-94ea-4260e67ced92\', \'multiverseId\': 639081}, \'multiverseid\': 639081}]', '[{\'name\': \'Zehntfordernde Klinge // Verschlingende Grabkammer\', \'text\': \'Zu Beginn deines Versorgungssegments verliert jeder Gegner 1 Lebenspunkt und du erhältst 1 Lebenspunkt dazu.\', \'type\': \'Artefakt\', \'flavor\': None, \'faceName\': \'Verschlingende Grabkammer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637155&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5f31a618-0949-444a-895d-742af425bd3c\', \'multiverseId\': 637155}, \'multiverseid\': 637155}, {\'name\': \'Hoja diezmal // Sepulcro ávido\', \'text\': \'Al comienzo de tu mantenimiento, cada oponente pierde 1 vida y tú ganas 1 vida.\', \'type\': \'Artefacto\', \'flavor\': None, \'faceName\': \'Sepulcro ávido\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637476&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'137d8316-1fd4-4a72-989e-7459cee6133d\', \'multiverseId\': 637476}, \'multiverseid\': 637476}, {\'name\': \'Lame de prélèvement // Sépulcre dévorant\', \'text\': \'Au début de votre entretien, chaque adversaire perd 1 point de vie et vous gagnez 1 point de vie.\', \'type\': \'Artefact\', \'flavor\': None, \'faceName\': \'Sépulcre dévorant\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637797&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ffab79f7-cc4a-4702-a176-75989cf962a1\', \'multiverseId\': 637797}, \'multiverseid\': 637797}, {\'name\': \'Lama del Tributo // Sepolcro Divoratore\', \'text\': "All\'inizio del tuo mantenimento, ogni avversario perde 1 punto vita e tu guadagni 1 punto vita.", \'type\': \'Artefatto\', \'flavor\': None, \'faceName\': \'Sepolcro Divoratore\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638118&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fc69e4f8-3f8d-4a57-8a59-29a3d345d7d6\', \'multiverseId\': 638118}, \'multiverseid\': 638118}, {\'name\': \'税血の刃 // 貪る墓所\', \'text\': \'あなたのアップキープの開始時に、各対戦相手はそれぞれ１点のライフを失い、あなたは１点のライフを得る。\', \'type\': \'アーティファクト\', \'flavor\': None, \'faceName\': \'貪る墓所\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638439&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e1611f7e-a44c-4856-b797-f87ccdef4059\', \'multiverseId\': 638439}, \'multiverseid\': 638439}, {\'name\': \'Lâmina da Coleta // Sepulcro Consumidor\', \'text\': \'No início de sua manutenção, cada oponente perde 1 ponto de vida e você ganha 1 ponto de vida.\', \'type\': \'Artefato\', \'flavor\': None, \'faceName\': \'Sepulcro Consumidor\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638760&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c60866db-610e-473a-aee4-66a679b2b0a3\', \'multiverseId\': 638760}, \'multiverseid\': 638760}, {\'name\': \'奉献祭刃 // 噬人坟墓\', \'text\': \'在你的维持开始时，每位对手各失去1点生命且你获得1点生命。\', \'type\': \'神器\', \'flavor\': None, \'faceName\': \'噬人坟墓\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639081&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'813d1eb6-80f4-40a6-94ea-4260e67ced92\', \'multiverseId\': 639081}, \'multiverseid\': 639081}]', '[{\'name\': \'Zerrüttende Wanderglyphe\', \'text\': \'Immer wenn die Zerrüttende Wanderglyphe angreift, schicke eine Karte deiner Wahl aus dem Friedhof eines Gegners ins Exil.\', \'type\': \'Artefaktkreatur — Golem\', \'flavor\': \'Wo die Sporen Fuß fassen, zermalmt sie den Boden zu Staub.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637295&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3378d560-3007-432e-851f-f500d6bbc5a5\', \'multiverseId\': 637295}, \'multiverseid\': 637295}, {\'name\': \'Glifoandante agitador\', \'text\': \'Siempre que el Glifoandante agitador ataque, exilia la carta objetivo del cementerio de un oponente.\', \'type\': \'Criatura artefacto — Gólem\', \'flavor\': \'Hace añicos el suelo en cualquier lugar donde las esporas empiezan a enraizarse.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637616&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7fe65a25-64bb-4f6c-8f13-f51419d3a830\', \'multiverseId\': 637616}, \'multiverseid\': 637616}, {\'name\': \'Glyphe errant perturbateur\', \'text\': "À chaque fois que le Glyphe errant perturbateur attaque, exilez une carte ciblée depuis le cimetière d\'un adversaire.", \'type\': \'Créature-artefact — golem\', \'flavor\': \'Partout où les spores commencent à se fixer, il écrase le sol.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637937&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'be46b5cd-d9c8-4a2d-a699-27044af3e8e3\', \'multiverseId\': 637937}, \'multiverseid\': 637937}, {\'name\': \'Girovaglifo Sabotatore\', \'text\': \'Ogniqualvolta il Girovaglifo Sabotatore attacca, esilia una carta bersaglio dal cimitero di un avversario.\', \'type\': \'Creatura Artefatto — Golem\', \'flavor\': \'Dove le spore iniziano ad attecchire, riduce il terreno in pietrisco.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638258&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ce071c40-6743-4008-9d77-7c943aca315b\', \'multiverseId\': 638258}, \'multiverseid\': 638258}, {\'name\': \'歩く彫像の攪乱者\', \'text\': \'歩く彫像の攪乱者が攻撃するたび、対戦相手の墓地にあるカード１枚を対象とする。それを追放する。\', \'type\': \'アーティファクト・クリーチャー — ゴーレム\', \'flavor\': \'胞子が根付くその時、地面は瓦礫と化す。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638579&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b1a2fe8a-1522-41b4-8b8c-70077292c938\', \'multiverseId\': 638579}, \'multiverseid\': 638579}, {\'name\': \'Glifâmbulo Disruptor\', \'text\': \'Toda vez que Glifâmbulo Disruptor atacar, exile o card alvo do cemitério de um oponente.\', \'type\': \'Criatura Artefato — Golem\', \'flavor\': \'Onde quer que os esporos comecem a se alojar, ele transforma o solo em pó.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638900&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7a9fed65-9ee5-42c5-80de-bab2b499618f\', \'multiverseId\': 638900}, \'multiverseid\': 638900}, {\'name\': \'滋扰漫游符\', \'text\': \'每当滋扰漫游符攻击时，将目标牌从任一对手的坟墓场放逐。\', \'type\': \'神器生物 — 魔像\', \'flavor\': \'一旦孢子在某处集聚，它就会将该地锤个粉碎。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639221&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3c5d6228-8369-4202-b9e8-35e9b0ac2e71\', \'multiverseId\': 639221}, \'multiverseid\': 639221}]', '[{\'name\': \'Zorn des Schreckensmauls\', \'text\': \'Bis zum Ende des Zuges erhält eine angreifende Kreatur deiner Wahl +2/+2, verursacht Trampelschaden und hat „Immer wenn diese Kreatur einem Spieler Kampfschaden zufügt, zerstöre ein Artefakt deiner Wahl, das jener Spieler kontrolliert."\', \'type\': \'Spontanzauber\', \'flavor\': \'„Das ist das fünfte Schiff, das wir in drei Tagen verloren haben! Können wir sie nicht aus etwas Robusterem bauen?"\\n—Malcolm Lee\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637179&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6c734a0f-a97a-42f0-be53-547d6956110f\', \'multiverseId\': 637179}, \'multiverseid\': 637179}, {\'name\': \'Ira del fauces pavorosas\', \'text\': \'Hasta el final del turno, la criatura atacante objetivo obtiene +2/+2 y gana la habilidad de arrollar y "Siempre que esta criatura haga daño de combate a un jugador, destruye el artefacto objetivo que controla ese jugador".\', \'type\': \'Instantáneo\', \'flavor\': \'"¡Es la quinta nave que perdemos en tres días! ¿No podemos construirlas con algo más resistente?".\\n—Malcolm Lee\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637500&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8af70249-6e43-4c8d-9ff5-fff79e85aef4\', \'multiverseId\': 637500}, \'multiverseid\': 637500}, {\'name\': \'Colère du gueuleffroi\', \'text\': "Jusqu\'à la fin du tour, une créature attaquante ciblée gagne +2/+2 et acquiert le piétinement et « À chaque fois que cette créature inflige des blessures de combat à un joueur, détruisez un artefact ciblé que ce joueur contrôle. »", \'type\': \'Éphémère\', \'flavor\': "« C\'est le cinquième navire perdu en trois jours ! Ne pourrait-on pas les construire un peu plus solides ? »\\n—Malcolm Lee", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637821&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'863c77df-ed56-4a1a-b452-f8be1e505767\', \'multiverseId\': 637821}, \'multiverseid\': 637821}, {\'name\': \'Ira della Fauce del Terrore\', \'text\': \'Fino alla fine del turno, una creatura attaccante bersaglio prende +2/+2 e ha travolgere e "Ogniqualvolta questa creatura infligge danno da combattimento a un giocatore, distruggi un artefatto bersaglio controllato da quel giocatore".\', \'type\': \'Istantaneo\', \'flavor\': \'"È la quinta nave che perdiamo in tre giorni! Non potremmo costruirle con materiali più robusti?"\\n—Malcolm Lee\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638142&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d1c24212-f703-49c6-9f80-49d28c5d14f2\', \'multiverseId\': 638142}, \'multiverseid\': 638142}, {\'name\': \'戦慄大口の怒り\', \'text\': \'攻撃クリーチャー１体を対象とする。ターン終了時まで、それは＋２/＋２の修整を受けトランプルと「このクリーチャーがプレイヤー１人に戦闘ダメージを与えるたび、そのプレイヤーがコントロールしているアーティファクト１つを対象とする。それを破壊する。」を得る。\', \'type\': \'インスタント\', \'flavor\': \'「この三日間で沈んだ船はこれで五隻目だぞ！もっと頑丈な素材で作れないのか？」\\n――マルコム・リー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638463&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a0aa685d-9858-462f-b54d-11f507f1d835\', \'multiverseId\': 638463}, \'multiverseid\': 638463}, {\'name\': \'Ira da Bocarra Sinistra\', \'text\': \'Até o final do turno, a criatura atacante alvo recebe +2/+2 e ganha atropelar e "Toda vez que esta criatura causar dano de combate a um jogador, destrua o artefato alvo que aquele jogador controla".\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"É o quinto navio perdido em três dias! Não podemos construí-los com alguma coisa mais forte?"\\n— Malcolm Lee\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638784&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'38e57125-3623-4b1a-8f07-ba560afa9d4c\', \'multiverseId\': 638784}, \'multiverseid\': 638784}, {\'name\': \'血口龙怒火\', \'text\': \'直到回合结束，目标进行攻击的生物得+2/+2且获得践踏与「每当此生物对任一牌手造成战斗伤害时，消灭目标由该牌手操控的神器。」\', \'type\': \'瞬间\', \'flavor\': \'「这已经三天来损失的第五艘了！我们就不能用更坚固的东西来造船吗？」\\n～马科姆李\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639105&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e906106f-5fa7-4411-9045-15d1e39fd0fb\', \'multiverseId\': 639105}, \'multiverseid\': 639105}]', '[{\'name\': \'Zoyowa Lavazunge\', \'text\': \'Todesberührung\\nZu Beginn deines Endsegments und falls du in diesem Zug abgestiegen bist, kann jeder Gegner eine Karte abwerfen oder ein Permanent opfern. Zoyowa Lavazunge fügt jedem Gegner, der dies nicht getan hat, 3 Schadenspunkte zu. (Du bist abgestiegen, falls eine Permanent-Karte von irgendwoher auf deinen Friedhof gelegt wurde.)\', \'type\': \'Legendäre Kreatur — Goblin, Hexenmeister\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637287&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4dbb6f97-58f6-4456-aaea-f1e993ca0dd2\', \'multiverseId\': 637287}, \'multiverseid\': 637287}, {\'name\': \'Zoyowa Lavalingüe\', \'text\': \'Toque mortal.\\nAl comienzo de tu paso final, si descendiste este turno, cada oponente puede descartar una carta o sacrificar un permanente. Zoyowa Lavalingüe hace 3 puntos de daño a cada oponente que no lo hizo. (Descendiste si una carta de permanente fue a tu cementerio desde cualquier parte.)\', \'type\': \'Criatura legendaria — Brujo trasgo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637608&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3a4bb9d0-d2bc-4f83-8da4-dad1babcf8a8\', \'multiverseId\': 637608}, \'multiverseid\': 637608}, {\'name\': \'Zoyowa Langue-de-lave\', \'text\': "Contact mortel\\nAu début de votre étape de fin, si vous êtes descendu ce tour-ci, chaque adversaire peut se défausser d\'une carte ou sacrifier un permanent. Zoyowa Langue-de-lave inflige 3 blessures à chaque adversaire qui n\'a pas fait ainsi. (Vous êtes descendu si une carte de permanent a été mise dans votre cimetière depuis n\'importe où.)", \'type\': \'Créature légendaire — gobelin et psychagogue\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637929&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'79d2dd77-97a8-42c8-b0ae-e55cc38a403a\', \'multiverseId\': 637929}, \'multiverseid\': 637929}, {\'name\': \'Zoyowa Lingualavica\', \'text\': "Tocco letale\\nAll\'inizio della tua sottofase finale, se sei sceso in questo turno, ogni avversario può scartare una carta o sacrificare un permanente. Zoyowa Lingualavica infligge 3 danni a ogni avversario che non l\'ha fatto. (Sei sceso se una carta permanente è stata messa nel tuo cimitero da qualsiasi zona.)", \'type\': \'Creatura Leggendaria — Warlock Goblin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638250&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f5ff37c7-fefc-48f9-ad84-0fddee8d09c3\', \'multiverseId\': 638250}, \'multiverseid\': 638250}, {\'name\': \'溶岩舌のゾヨワ\', \'text\': \'接死\\nあなたの終了ステップの開始時に、このターンにあなたが落魄していた場合、各対戦相手はそれぞれカード１枚を捨てるか、パーマネント１つを生け贄に捧げてもよい。溶岩舌のゾヨワは、そうしなかった各対戦相手にそれぞれ３点のダメージを与える。（パーマネント・カードがいずこかからあなたの墓地に置かれたなら、あなたは落魄する。）\', \'type\': \'伝説のクリーチャー — ゴブリン・邪術師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638571&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'29b951b4-2326-4b4f-838e-67a82dfebae2\', \'multiverseId\': 638571}, \'multiverseid\': 638571}, {\'name\': \'Zoyowa Língua-de-lava\', \'text\': \'Toque mortífero\\nNo início de sua etapa final, se você desceu neste turno, cada oponente pode descartar um card ou sacrificar uma permanente. Zoyowa Língua-de-lava causa 3 pontos de dano a cada oponente que não o tiver feito. (Você desceu se um card de permanente foi colocado em seu cemitério vindo de qualquer lugar.)\', \'type\': \'Criatura Lendária — Goblin Bruxo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638892&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4430c681-387f-4e00-8a26-ab65af89fab0\', \'multiverseId\': 638892}, \'multiverseid\': 638892}, {\'name\': \'熔岩舌佐佑瓦\', \'text\': \'死触\\n在你的结束步骤开始时，若你本回合中有落坟，则每位对手各可以弃一张牌或牺牲一个永久物。熔岩舌佐佑瓦向每位未如此作的对手各造成3点伤害。（如果有永久物牌从任何区域进入你的坟墓场，便算作你有落坟。）\', \'type\': \'传奇生物 — 鬼怪／邪术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639213&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3b9642f7-e246-4fe0-b3ed-95136ff17ee8\', \'multiverseId\': 639213}, \'multiverseid\': 639213}]', '[{\'name\': \'Zoyowa Lavazunge\', \'text\': \'Todesberührung\\nZu Beginn deines Endsegments und falls du in diesem Zug abgestiegen bist, kann jeder Gegner eine Karte abwerfen oder ein Permanent opfern. Zoyowa Lavazunge fügt jedem Gegner, der dies nicht getan hat, 3 Schadenspunkte zu.\', \'type\': \'Legendäre Kreatur — Goblin, Hexenmeister\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636544&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d46edce5-819e-49d0-8833-39bf0f0afb77\', \'multiverseId\': 636544}, \'multiverseid\': 636544}, {\'name\': \'Zoyowa Lavalingüe\', \'text\': \'Toque mortal.\\nAl comienzo de tu paso final, si descendiste este turno, cada oponente puede descartar una carta o sacrificar un permanente. Zoyowa Lavalingüe hace 3 puntos de daño a cada oponente que no lo hizo.\', \'type\': \'Criatura legendaria — Brujo trasgo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636568&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'569baff2-0364-4a23-9ce0-227aa383b319\', \'multiverseId\': 636568}, \'multiverseid\': 636568}, {\'name\': \'Zoyowa Langue-de-lave\', \'text\': "Contact mortel\\nAu début de votre étape de fin, si vous êtes descendu ce tour-ci, chaque adversaire peut se défausser d\'une carte ou sacrifier un permanent. Zoyowa Langue-de-lave inflige 3 blessures à chaque adversaire qui n\'a pas fait ainsi.", \'type\': \'Créature légendaire — gobelin et psychagogue\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636592&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7b2c1f07-9990-44a5-a591-6c9c2b11f799\', \'multiverseId\': 636592}, \'multiverseid\': 636592}, {\'name\': \'Zoyowa Lingualavica\', \'text\': "Tocco letale\\nAll\'inizio della tua sottofase finale, se sei sceso in questo turno, ogni avversario può scartare una carta o sacrificare un permanente. Zoyowa Lingualavica infligge 3 danni a ogni avversario che non l\'ha fatto.", \'type\': \'Creatura Leggendaria — Warlock Goblin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636616&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'99c7eefa-4b19-4e0a-b3e3-25cf69fe1d35\', \'multiverseId\': 636616}, \'multiverseid\': 636616}, {\'name\': \'溶岩舌のゾヨワ\', \'text\': \'接死\\nあなたの終了ステップの開始時に、このターンにあなたが落魄していた場合、各対戦相手はそれぞれカード１枚を捨てるか、パーマネント１つを生け贄に捧げてもよい。溶岩舌のゾヨワは、そうしなかった各対戦相手にそれぞれ３点のダメージを与える。\', \'type\': \'伝説のクリーチャー — ゴブリン・邪術師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636640&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dc328464-8e67-4167-a216-ae675cb16268\', \'multiverseId\': 636640}, \'multiverseid\': 636640}, {\'name\': \'Zoyowa Língua-de-lava\', \'text\': \'Toque mortífero\\nNo início de sua etapa final, se você desceu neste turno, cada oponente pode descartar um card ou sacrificar uma permanente. Zoyowa Língua-de-lava causa 3 pontos de dano a cada oponente que não o tiver feito.\', \'type\': \'Criatura Lendária — Goblin Bruxo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636664&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a79d3894-1598-46b4-acd6-fed4253ace72\', \'multiverseId\': 636664}, \'multiverseid\': 636664}, {\'name\': \'熔岩舌佐佑瓦\', \'text\': \'死触\\n在你的结束步骤开始时，若你本回合中有落坟，则每位对手各可以弃一张牌或牺牲一个永久物。熔岩舌佐佑瓦向每位未如此作的对手各造成3点伤害。\', \'type\': \'传奇生物 — 鬼怪／邪术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=636688&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7ed3e69b-ee12-4309-9858-04e33f5d713d\', \'multiverseId\': 636688}, \'multiverseid\': 636688}]', '[{\'name\': \'Zoyowas Recht\', \'text\': \'Der Besitzer eines Artefakts oder einer Kreatur deiner Wahl mit Manabetrag 1 oder mehr mischt es bzw. sie in seine Bibliothek. Dann wendet jener Spieler Entdeckung X an, wobei X gleich seinem bzw. ihrem Manabetrag ist. (Er schickt Karten oben von seiner Bibliothek ins Exil, bis er eine Nichtland-Karte mit Manabetrag X oder weniger aufdeckt. Er wirkt sie, ohne ihre Manakosten zu bezahlen, oder nimmt sie auf seine Hand. Er legt den Rest in zufälliger Reihenfolge unter seine Bibliothek.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637208&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9d944ea6-4706-464c-9f0f-f4ad9f9889dd\', \'multiverseId\': 637208}, \'multiverseid\': 637208}, {\'name\': \'Justicia de Zoyowa\', \'text\': \'El propietario del artefacto o criatura objetivo con valor de maná de 1 o más baraja ese permanente en su biblioteca. Luego, ese jugador descubre X, donde X es su valor de maná. (Exilia cartas de la parte superior de su biblioteca hasta que exilie una carta que no sea tierra con ese valor de maná o menos. La lanza sin pagar su coste de maná o la pone en su mano. Pone el resto en el fondo en un orden aleatorio.)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637529&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7aa9a34e-072e-4cd5-8dcb-7f5236b5a414\', \'multiverseId\': 637529}, \'multiverseid\': 637529}, {\'name\': \'Justice de Zoyowa\', \'text\': "Le propriétaire d\'une cible, artefact ou créature, avec une valeur de mana supérieure ou égale à 1 la mélange dans sa bibliothèque. Puis ce joueur découvre X, X étant sa valeur de mana. (Il exile les cartes du dessus de sa bibliothèque jusqu\'à ce qu\'il exile une carte non-terrain avec cette valeur de mana ou moins. Il la lance sans payer son coût de mana ou la met dans sa main. Il met le reste au-dessous de sa bibliothèque dans un ordre aléatoire.)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637850&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b1569477-6a09-42f7-a36a-10e508bb50e2\', \'multiverseId\': 637850}, \'multiverseid\': 637850}, {\'name\': \'Giustizia di Zoyowa\', \'text\': \'Il proprietario di un artefatto o di una creatura bersaglio con valore di mana pari o superiore a 1 lo rimescola nel suo grimorio. Poi quel giocatore scopre X, dove X è il suo valore di mana. (Esilia carte dalla cima del suo grimorio finché non esilia una carta non terra con valore di mana pari o inferiore. La lancia senza pagare il suo costo di mana o la aggiunge alla sua mano. Mette le altre in fondo in ordine casuale.)\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638171&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9ffa49bc-1be8-4c8b-a1cf-f4542f914692\', \'multiverseId\': 638171}, \'multiverseid\': 638171}, {\'name\': \'ゾヨワの裁き\', \'text\': \'アーティファクトやクリーチャーでありマナ総量が１以上である１つを対象とする。オーナーはそれを自分のライブラリーに加えて切り直す。その後、そのプレイヤーは発見Ｘを行う。Ｘは、それのマナ総量に等しい。（マナ総量がそれ以下であり土地でないカード１枚が追放されるまで、そのプレイヤーは自分のライブラリーの一番上から１枚ずつ追放していく。そのプレイヤーはそれをマナ・コストを支払うことなく唱えるか、自分の手札に加える。残りを自分のライブラリーの一番下に無作為の順番で置く。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638492&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b84b30fe-0d03-44a9-8ad2-8c9bc6b1f470\', \'multiverseId\': 638492}, \'multiverseid\': 638492}, {\'name\': \'Justiça de Zoyowa\', \'text\': \'O dono do artefato ou da criatura alvo com valor de mana igual ou superior a 1 o embaralha no próprio grimório. Depois, aquele jogador descobre X, sendo X seu valor de mana. (Ele exila cards do topo do próprio grimório até exilar um card não de terreno com valor de mana igual ou inferior. Ele o conjura sem pagar seu custo de mana ou o coloca na própria mão. Ele coloca o restante no fundo do grimório em ordem aleatória.)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638813&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bc91ee7e-3923-4701-b0b8-0f701bf6e3d4\', \'multiverseId\': 638813}, \'multiverseid\': 638813}, {\'name\': \'佐佑瓦断治\', \'text\': \'目标法术力值等于或大于1之神器或生物的拥有者将它洗入其牌库。然后该牌手倾探X，X为其法术力值。（该牌手从其的牌库顶开始放逐牌，直到放逐一张法术力值等于或小于该数值的非地牌为止。其施放之且不需支付其法术力费用，或将之置于手上，并将其余的牌以随机顺序置于牌库底。）\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639134&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7b6a8c87-0ec3-45a4-87a1-0229e19d751e\', \'multiverseId\': 639134}, \'multiverseid\': 639134}]', '[{\'name\': \'Zu den Toten gesellen\', \'text\': \'Eine Kreatur deiner Wahl erhält -5/-5 bis zum Ende des Zuges.\\nAbstieg 4 — Jene Kreatur erhält stattdessen -10/-10 bis zum Ende des Zuges, falls dein Friedhof vier oder mehr Permanent-Karten enthält.\', \'type\': \'Spontanzauber\', \'flavor\': \'Je mehr Kreaturen in den Abgrund zu Tode stürzen, desto mehr wütende Echos erwachen, die andere hinabzerren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637136&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'438a0561-0a81-4c6c-8d82-cfa0b99471b5\', \'multiverseId\': 637136}, \'multiverseid\': 637136}, {\'name\': \'Acompañar a los muertos\', \'text\': \'La criatura objetivo obtiene -5/-5 hasta el final del turno.\\nDescender 4 — En vez de eso, esa criatura obtiene -10/-10 hasta el final del turno si hay cuatro o más cartas de permanente en tu cementerio.\', \'type\': \'Instantáneo\', \'flavor\': \'Cuantas más criaturas se precipitan hacia la muerte en el abismo, más ecos enfurecidos se alzan para arrastrar a las demás.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637457&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fd27ef21-76c7-46d3-98d5-32a394c60786\', \'multiverseId\': 637457}, \'multiverseid\': 637457}, {\'name\': \'Rejoindre les morts\', \'text\': "Une créature ciblée gagne -5/-5 jusqu\'à la fin du tour.\\nDescente 4 — Cette créature gagne -10/-10 jusqu\'à la fin du tour à la place s\'il y a au moins quatre cartes de permanent dans votre cimetière.", \'type\': \'Éphémère\', \'flavor\': "Plus les créatures qui plongent vers leur mort dans l\'abysse sont nombreuses, plus les Échos enragés qui remontent pour en attirer d\'autres sont nombreux.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637778&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'452f00be-df5a-4907-a980-a249743f13bc\', \'multiverseId\': 637778}, \'multiverseid\': 637778}, {\'name\': \'Unirsi ai Morti\', \'text\': \'Una creatura bersaglio prende -5/-5 fino alla fine del turno.\\nDiscesa 4 — Quella creatura prende invece -10/-10 fino alla fine del turno se ci sono quattro o più carte permanente nel tuo cimitero.\', \'type\': \'Istantaneo\', \'flavor\': \'Più sono le creature che trovano la morte negli abissi, più sono gli Echi iracondi che ne emergono per portarne altre con sé.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638099&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1ab1123a-94c0-401b-b09e-2dab008e2a64\', \'multiverseId\': 638099}, \'multiverseid\': 638099}, {\'name\': \'死者の仲間入り\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは－５/－５の修整を受ける。\\n落魄４ ― あなたの墓地に４枚以上のパーマネント・カードがあるなら、代わりに、ターン終了時まで、それは－10/－10の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'奈落に落ちる者が多ければ多いほど、怒って引きずり下ろそうとする残響は増えていく。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638420&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d55d62ad-bf71-406c-bca0-50712bc4c1e2\', \'multiverseId\': 638420}, \'multiverseid\': 638420}, {\'name\': \'Juntar-se aos Mortos\', \'text\': \'A criatura alvo recebe -5/-5 até o final do turno.\\nDescer 4 — Se houver quatro ou mais cards de permanente em seu cemitério, em vez disso, aquela criatura receberá -10/-10 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Quanto mais criaturas mergulham para a morte no abismo, mais Ecos furiosos emergem para arrastar outras para o fundo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638741&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bce5efa1-1bcd-4f31-a6cf-dd22ad6eb8bd\', \'multiverseId\': 638741}, \'multiverseid\': 638741}, {\'name\': \'亡灵征列\', \'text\': \'目标生物得-5/-5直到回合结束。\\n落坟4～如果你坟墓场中有四张或更多永久物牌，则改为该生物得-10/-10直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'落入深渊不幸堕亡的生灵越多，起身复返拖人入列的念世灵也越多。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639062&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'acd6418d-256e-4ad8-8a06-52dd4874b5c0\', \'multiverseId\': 639062}, \'multiverseid\': 639062}]', "[{'name': 'Überraschende Wendungen // Pilzlabyrinth', 'text': '(Transformierte Überraschende Wendungen.)\\n{T}: Erzeuge {G}.\\n{3}{G}, {T}: Schaue dir die obersten vier Karten deiner Bibliothek an. Du kannst davon eine Kreaturenkarte offen vorzeigen und auf deine Hand nehmen. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.', 'type': 'Land — Höhle', 'flavor': None, 'faceName': 'Pilzlabyrinth', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637257&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4f3e92d6-6755-4e37-9ff3-05dd2db281a3', 'multiverseId': 637257}, 'multiverseid': 637257}, {'name': 'Huecos y recovecos // Laberinto de micoides', 'text': '(Se transforma de los Huecos y recovecos.)\\n{T}: Agrega {G}.\\n{3}{G}, {T}: Mira las cuatro primeras cartas de tu biblioteca. Puedes mostrar una carta de criatura de entre ellas y poner esa carta en tu mano. Pon el resto en el fondo de tu biblioteca en un orden aleatorio.', 'type': 'Tierra — Cueva', 'flavor': None, 'faceName': 'Laberinto de micoides', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637578&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '424b221d-3cc5-42b9-85de-915253e0c70b', 'multiverseId': 637578}, 'multiverseid': 637578}, {'name': 'Tours et détours // Labyrinthe mycoïde', 'text': '(Transformation des Tours et détours.)\\n{T} : Ajoutez {G}.\\n{3}{G}, {T} : Regardez les quatre cartes du dessus de votre bibliothèque. Vous pouvez révéler une carte de créature parmi elles et mettre cette carte dans votre main. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.', 'type': 'Terrain — caverne', 'flavor': None, 'faceName': 'Labyrinthe mycoïde', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637899&type=card', 'language': 'French', 'identifiers': {'scryfallId': '66d23aac-f706-425a-a984-ae90a9156223', 'multiverseId': 637899}, 'multiverseid': 637899}, {'name': 'Curve e Svolte // Labirinto Micoide', 'text': '(Si trasforma dalle Curve e Svolte.)\\n{T}: Aggiungi {G}.\\n{3}{G}, {T}: Guarda le prime quattro carte del tuo grimorio. Puoi rivelare una carta creatura scelta tra esse e aggiungerla alla tua mano. Metti le altre in fondo al tuo grimorio in ordine casuale.', 'type': 'Terra — Caverna', 'flavor': None, 'faceName': 'Labirinto Micoide', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638220&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '6ddc8583-301d-4f56-a6be-8e8a5a7e76df', 'multiverseId': 638220}, 'multiverseid': 638220}, {'name': '一往一来 // マイコイドの迷路', 'text': '（一往一来から変身する。）\\n{T}：{G}を加える。\\n{3}{G}, {T}：あなたのライブラリーの一番上にあるカード４枚を見る。「その中からクリーチャー・カード１枚を公開し、あなたの手札に加える。」を選んでもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。', 'type': '土地 — 洞窟', 'flavor': None, 'faceName': 'マイコイドの迷路', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638541&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ab47708d-db34-4a38-be13-8588c30c0923', 'multiverseId': 638541}, 'multiverseid': 638541}, {'name': 'Voltas e Reviravoltas // Labirinto Micoide', 'text': '(Transformação de Voltas e Reviravoltas.)\\n{T}: Adicione {G}.\\n{3}{G}, {T}: Olhe os quatro cards do topo do seu grimório. Você pode revelar um card de criatura dentre eles e colocar aquele card em sua mão. Coloque o restante no fundo de seu grimório em ordem aleatória.', 'type': 'Terreno — Caverna', 'flavor': None, 'faceName': 'Labirinto Micoide', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638862&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7e159db3-3add-4eef-b54b-7eeec0f681f2', 'multiverseId': 638862}, 'multiverseid': 638862}, {'name': '蜿蜒径路 // 智蕈迷宫', 'text': '（由蜿蜒径路转化。）\\n{T}：加{G}。\\n{3}{G}，{T}：检视你牌库顶的四张牌。你可以展示其中一张生物牌并置于你手上。将其余的牌以随机顺序置于你牌库底。', 'type': '地 — 洞窟', 'flavor': None, 'faceName': '智蕈迷宫', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639183&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'aa84d892-699d-4b2c-b6b7-084c61232cda', 'multiverseId': 639183}, 'multiverseid': 639183}]", "[{'name': 'Überraschende Wendungen // Pilzlabyrinth', 'text': 'Falls eine Kreatur, die du kontrollierst, erkunden würde, wendest du stattdessen Hellsicht 1 an und jene Kreatur erkundet danach.\\nWenn die Überraschenden Wendungen ins Spiel kommen, erkundet eine Kreatur deiner Wahl, die du kontrollierst.\\nWenn ein Land unter deiner Kontrolle ins Spiel kommt und falls du sieben oder mehr Länder kontrollierst, transformiere die Überraschenden Wendungen.', 'type': 'Verzauberung', 'flavor': None, 'faceName': 'Überraschende Wendungen', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637257&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4f3e92d6-6755-4e37-9ff3-05dd2db281a3', 'multiverseId': 637257}, 'multiverseid': 637257}, {'name': 'Huecos y recovecos // Laberinto de micoides', 'text': 'Si una criatura que controlas fuera a explorar, en vez de eso, adivinas 1, luego esa criatura explora.\\nCuando los Huecos y recovecos entren al campo de batalla, la criatura objetivo que controlas explora.\\nCuando una tierra entre al campo de batalla bajo tu control, si controlas siete o más tierras, transforma los Huecos y recovecos.', 'type': 'Encantamiento', 'flavor': None, 'faceName': 'Huecos y recovecos', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637578&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '424b221d-3cc5-42b9-85de-915253e0c70b', 'multiverseId': 637578}, 'multiverseid': 637578}, {'name': 'Tours et détours // Labyrinthe mycoïde', 'text': 'Si une créature que vous contrôlez devrait explorer, à la place vous appliquez regard 1, puis cette créature explore.\\nQuand les Tours et détours arrivent sur le champ de bataille, une créature ciblée que vous contrôlez explore.\\nQuand un terrain arrive sur le champ de bataille sous votre contrôle, si vous contrôlez au moins sept terrains, transformez les Tours et détours.', 'type': 'Enchantement', 'flavor': None, 'faceName': 'Tours et détours', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637899&type=card', 'language': 'French', 'identifiers': {'scryfallId': '66d23aac-f706-425a-a984-ae90a9156223', 'multiverseId': 637899}, 'multiverseid': 637899}, {'name': 'Curve e Svolte // Labirinto Micoide', 'text': 'Se una creatura che controlli sta per esplorare, invece profetizzi 1, poi quella creatura esplora.\\nQuando le Curve e Svolte entrano nel campo di battaglia, una creatura bersaglio che controlli esplora.\\nQuando una terra entra nel campo di battaglia sotto il tuo controllo, se controlli sette o più terre, trasforma le Curve e Svolte.', 'type': 'Incantesimo', 'flavor': None, 'faceName': 'Curve e Svolte', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638220&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '6ddc8583-301d-4f56-a6be-8e8a5a7e76df', 'multiverseId': 638220}, 'multiverseid': 638220}, {'name': '一往一来 // マイコイドの迷路', 'text': 'あなたがコントロールしているクリーチャー１体が探検を行うなら、その代わりにあなたは占術１を行い、その後、そのクリーチャーは探検を行う。\\n一往一来が戦場に出たとき、あなたがコントロールしているクリーチャー１体を対象とする。それは探検を行う。\\n土地１つがあなたのコントロール下で戦場に出たとき、あなたが７つ以上の土地をコントロールしている場合、一往一来を変身させる。', 'type': 'エンチャント', 'flavor': None, 'faceName': '一往一来', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638541&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ab47708d-db34-4a38-be13-8588c30c0923', 'multiverseId': 638541}, 'multiverseid': 638541}, {'name': 'Voltas e Reviravoltas // Labirinto Micoide', 'text': 'Se uma criatura que você controla exploraria, em vez disso, você usa vidência 1 e depois aquela criatura explora.\\nQuando Voltas e Reviravoltas entra no campo de batalha, a criatura alvo que você controla explora.\\nQuando um terreno entrar no campo de batalha sob seu controle, se você controlar sete ou mais terrenos, transforme Voltas e Reviravoltas.', 'type': 'Encantamento', 'flavor': None, 'faceName': 'Voltas e Reviravoltas', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638862&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7e159db3-3add-4eef-b54b-7eeec0f681f2', 'multiverseId': 638862}, 'multiverseid': 638862}, {'name': '蜿蜒径路 // 智蕈迷宫', 'text': '如果某个由你操控的生物将勘察，则改为你占卜1，然后该生物勘察。\\n当蜿蜒径路进战场时，令目标由你操控的生物勘察。\\n当一个地在你操控下进战场时，若你操控七个或更多地，则转化蜿蜒径路。', 'type': '结界', 'flavor': None, 'faceName': '蜿蜒径路', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639183&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'aa84d892-699d-4b2c-b6b7-084c61232cda', 'multiverseId': 639183}, 'multiverseid': 639183}]", '[{\'name\': \'Überwältigende Größe\', \'text\': \'Eine Kreatur deiner Wahl erhält +3/+3 und verursacht Trampelschaden bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Nicht so tragisch, das Dach des Tempels musste sowieso mal wieder neu gedeckt werden."\\n—Kusi, Oltec-Gärtner\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637254&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fe999e4a-c785-4f2f-b748-952a8f4e83b1\', \'multiverseId\': 637254}, \'multiverseid\': 637254}, {\'name\': \'Magnitud magnífica\', \'text\': \'La criatura objetivo obtiene +3/+3 y gana la habilidad de arrollar hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"Bueno... De todas formas, al templo ya le hacía falta un techo nuevo".\\n—Kusi, jardinero oltec\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637575&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'09dd129e-568e-4dd0-ad04-51dabace0e69\', \'multiverseId\': 637575}, \'multiverseid\': 637575}, {\'name\': \'Taille impressionnante\', \'text\': "Une créature ciblée gagne +3/+3 et acquiert le piétinement jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': \'« Ah... Il fallait remplacer le toit du temple de toute façon. »\\n—Kusi, jardinier oltèque\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=637896&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c564c29a-6ebe-4f65-aa14-5dc5cfdc3602\', \'multiverseId\': 637896}, \'multiverseid\': 637896}, {\'name\': \'Dimensioni Sconcertanti\', \'text\': \'Una creatura bersaglio prende +3/+3 e ha travolgere fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Oh beh... il tetto del tempio andava cambiato comunque."\\n—Kusi, giardiniere Oltec\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638217&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6fed46a0-5d9b-49a6-97c0-67d0260746b9\', \'multiverseId\': 638217}, \'multiverseid\': 638217}, {\'name\': \'圧倒的巨体\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋３/＋３の修整を受けトランプルを得る。\', \'type\': \'インスタント\', \'flavor\': \'「まあいいか……どのみち神殿の屋根は葺き替えるつもりだったし。」\\n――オルテカの庭師、クシ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638538&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'58164f89-b36f-4724-8704-dd7ef46a45c3\', \'multiverseId\': 638538}, \'multiverseid\': 638538}, {\'name\': \'Tamanho Desconcertante\', \'text\': \'A criatura alvo recebe +3/+3 e ganha atropelar até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Ah. Bem... tava na hora de reformar o telhado do templo, mesmo."\\n— Kusi, jardineiro olteca\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=638859&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9b9642d8-3dcd-4012-966d-ed476b465ae7\', \'multiverseId\': 638859}, \'multiverseid\': 638859}, {\'name\': \'巨大体形\', \'text\': \'直到回合结束，目标生物得+3/+3且获得践踏异能。\', \'type\': \'瞬间\', \'flavor\': \'「啊…反正殿堂的屋顶也该翻新了。」\\n～欧尔特克园丁库西\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=639180&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'83d24e7f-ff8b-4607-91da-94d34f4ad623\', \'multiverseId\': 639180}, \'multiverseid\': 639180}]']
