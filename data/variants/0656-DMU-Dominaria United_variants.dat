: None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578592&type=card', 'language': 'French', 'identifiers': {'scryfallId': '94991df8-64af-4f94-b90b-31ffe080f54f', 'multiverseId': 578592}, 'multiverseid': 578592}, {'name': 'Pianura', 'type': 'Terra Base — Pianura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578607&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'dcf852f0-3141-4aeb-8763-50ea870e830e', 'multiverseId': 578607}, 'multiverseid': 578607}, {'name': '平地', 'type': '基本土地 — 平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578622&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '65e7805d-d13d-4a29-b806-f8a77a17e8dd', 'multiverseId': 578622}, 'multiverseid': 578622}, {'name': 'Planície', 'type': 'Terreno Básico — Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578652&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '84d49693-e7e0-4b9d-bd95-ba10bf275281', 'multiverseId': 578652}, 'multiverseid': 578652}, {'name': '平原', 'type': '基本地 ～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578682&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '2b69cb34-76a2-4ddb-a223-ff45c46c4aee', 'multiverseId': 578682}, 'multiverseid': 578682}]", "[{'name': 'Ebene', 'type': 'Standardland — Ebene', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578563&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0c892519-1c39-4dd5-a22a-9a68b51a33fa', 'multiverseId': 578563}, 'multiverseid': 578563}, {'name': 'Llanura', 'type': 'Tierra básica — Llanura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578578&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c2eaa0d6-9b3c-49ea-b0dc-7c2a82031d9b', 'multiverseId': 578578}, 'multiverseid': 578578}, {'name': 'Plaine', 'type': 'Terrain de base : plaine', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578593&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c2a97bde-1390-4277-a52c-f1f0310f0d13', 'multiverseId': 578593}, 'multiverseid': 578593}, {'name': 'Pianura', 'type': 'Terra Base — Pianura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578608&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '5709a449-41ec-4544-adf5-f808968ff0d2', 'multiverseId': 578608}, 'multiverseid': 578608}, {'name': '平地', 'type': '基本土地 — 平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578623&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9c3107e6-7892-49f4-bb2f-6478be5f014e', 'multiverseId': 578623}, 'multiverseid': 578623}, {'name': 'Planície', 'type': 'Terreno Básico — Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578653&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fbea47d4-0bf6-423d-bbb6-02ec90963e71', 'multiverseId': 578653}, 'multiverseid': 578653}, {'name': '平原', 'type': '基本地 ～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578683&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '101fe98a-3387-4298-8868-3e213c33c838', 'multiverseId': 578683}, 'multiverseid': 578683}]", '[{\'name\': \'Elas il-Kor, Sadistische Pilgerin\', \'text\': \'Todesberührung\\nImmer wenn eine andere Kreatur unter deiner Kontrolle ins Spiel kommt, erhältst du 1 Lebenspunkt dazu.\\nImmer wenn eine andere Kreatur, die du kontrollierst, stirbt, verliert jeder Gegner 1 Lebenspunkt.\', \'type\': \'Legendäre Kreatur — Phyrexianer, Kor, Kleriker\', \'flavor\': \'„Alles wird sich der Flüsternden beugen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574939&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'59071bcc-cebc-4cb7-bb99-66c01bc99a57\', \'multiverseId\': 574939}, \'multiverseid\': 574939}, {\'name\': \'Elas il-Kor, peregrina sádica\', \'text\': \'Toque mortal.\\nSiempre que otra criatura entre al campo de batalla bajo tu control, ganas 1 vida.\\nSiempre que otra criatura que controlas muera, cada oponente pierde 1 vida.\', \'type\': \'Criatura legendaria — Clérigo kor pirexiano\', \'flavor\': \'"Todos se inclinarán ante la Susurradora".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575200&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'13b40148-029f-494e-a982-c99890a7863c\', \'multiverseId\': 575200}, \'multiverseid\': 575200}, {\'name\': \'Elas il-Kor, pèlerine sadique\', \'text\': "Contact mortel\\nÀ chaque fois qu\'une autre créature arrive sur le champ de bataille sous votre contrôle, vous gagnez 1 point de vie.\\nÀ chaque fois qu\'une autre créature que vous contrôlez meurt, chaque adversaire perd 1 point de vie.", \'type\': \'Créature légendaire : phyrexian et kor et clerc\', \'flavor\': \'« Tous se prosterneront devant la Susurrante. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575461&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bb914efb-02ae-401c-9e4f-b26fddd14c66\', \'multiverseId\': 575461}, \'multiverseid\': 575461}, {\'name\': \'Elas il-Kor, Pellegrina Sadica\', \'text\': "Tocco letale\\nOgniqualvolta un\'altra creatura entra nel campo di battaglia sotto il tuo controllo, guadagni 1 punto vita.\\nOgniqualvolta un\'altra creatura che controlli muore, ogni avversario perde 1 punto vita.", \'type\': \'Creatura Leggendaria — Chierico Kor Phyrexiano\', \'flavor\': \'"Tutti si inchineranno alla Bisbigliante."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575722&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4d50cdb7-3c54-4837-a305-008c5e161060\', \'multiverseId\': 575722}, \'multiverseid\': 575722}, {\'name\': \'残忍な巡礼者、コー追われのエラス\', \'text\': \'接死\\nこれでないクリーチャー１体があなたのコントロール下で戦場に出るたび、あなたは１点のライフを得る。\\nあなたがコントロールしていてこれでないクリーチャー１体が死亡するたび、各対戦相手はそれぞれ１点のライフを失う。\', \'type\': \'伝説のクリーチャー — ファイレクシアン・コー・クレリック\', \'flavor\': \'「すべてが囁く者にひれ伏すだろう。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575983&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5c9b1a7d-4923-46b5-b176-692d9f7c1415\', \'multiverseId\': 575983}, \'multiverseid\': 575983}, {\'name\': \'Elas il-Kor, Peregrina Sádica\', \'text\': \'Toque mortífero\\nToda vez que outra criatura entra no campo de batalha sob seu controle, você ganha 1 ponto de vida.\\nToda vez que outra criatura que você controla morre, cada oponente perde 1 ponto de vida.\', \'type\': \'Criatura Lendária — Phyrexiano Kor Clérigo\', \'flavor\': \'"Todos vão se curvar perante a Sussurradora."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576505&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2f49ed76-c140-45b5-8102-40cececfd499\', \'multiverseId\': 576505}, \'multiverseid\': 576505}, {\'name\': \'虐之华寇族黜人依拉丝\', \'text\': \'死触\\n每当另一个生物在你的操控下进战场时，你获得1点生命。\\n每当另一个由你操控的生物死去时，每位对手各失去1点生命。\', \'type\': \'传奇生物 ～非瑞人／寇族／僧侣\', \'flavor\': \'「一切都将臣服于细语者。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577027&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0e987a85-cb65-401f-8ded-ea2dba412245\', \'multiverseId\': 577027}, \'multiverseid\': 577027}]', '[{\'name\': \'Elas il-Kor, Sadistische Pilgerin\', \'text\': \'Todesberührung\\nImmer wenn eine andere Kreatur unter deiner Kontrolle ins Spiel kommt, erhältst du 1 Lebenspunkt dazu.\\nImmer wenn eine andere Kreatur, die du kontrollierst, stirbt, verliert jeder Gegner 1 Lebenspunkt.\', \'type\': \'Legendäre Kreatur — Phyrexianer, Kor, Kleriker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577884&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'501c398e-f80f-4cf9-9604-582f7912f4dc\', \'multiverseId\': 577884}, \'multiverseid\': 577884}, {\'name\': \'Elas il-Kor, pèlerine sadique\', \'text\': "Contact mortel\\nÀ chaque fois qu\'une autre créature arrive sur le champ de bataille sous votre contrôle, vous gagnez 1 point de vie.\\nÀ chaque fois qu\'une autre créature que vous contrôlez meurt, chaque adversaire perd 1 point de vie.", \'type\': \'Créature légendaire : phyrexian et kor et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577925&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2e121a8d-c05e-4b28-8c30-19ab4d9d716d\', \'multiverseId\': 577925}, \'multiverseid\': 577925}, {\'name\': \'残忍な巡礼者、コー追われのエラス\', \'text\': \'接死\\nこれでないクリーチャー１体があなたのコントロール下で戦場に出るたび、あなたは１点のライフを得る。\\nあなたがコントロールしていてこれでないクリーチャー１体が死亡するたび、各対戦相手はそれぞれ１点のライフを失う。\', \'type\': \'伝説のクリーチャー — ファイレクシアン・コー・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577966&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'48205903-d82e-42a9-be57-583ec3b28e3f\', \'multiverseId\': 577966}, \'multiverseid\': 577966}, {\'name\': \'虐之华寇族黜人依拉丝\', \'text\': \'死触\\n每当另一个生物在你的操控下进战场时，你获得1点生命。\\n每当另一个由你操控的生物死去时，每位对手各失去1点生命。\', \'type\': \'传奇生物 ～非瑞人／寇族／僧侣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578007&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e5524b6d-088d-4a6f-ac12-3a436da5611e\', \'multiverseId\': 578007}, \'multiverseid\': 578007}]', '[{\'name\': \'Elas il-Kor, Sadistische Pilgerin\', \'text\': \'Todesberührung\\nImmer wenn eine andere Kreatur unter deiner Kontrolle ins Spiel kommt, erhältst du 1 Lebenspunkt dazu.\\nImmer wenn eine andere Kreatur, die du kontrollierst, stirbt, verliert jeder Gegner 1 Lebenspunkt.\', \'type\': \'Legendäre Kreatur — Phyrexianer, Kor, Kleriker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578091&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ef5e26e4-92ac-46eb-b72b-9aec60692ce1\', \'multiverseId\': 578091}, \'multiverseid\': 578091}, {\'name\': \'Elas il-Kor, peregrina sádica\', \'text\': \'Toque mortal.\\nSiempre que otra criatura entre al campo de batalla bajo tu control, ganas 1 vida.\\nSiempre que otra criatura que controlas muera, cada oponente pierde 1 vida.\', \'type\': \'Criatura legendaria — Clérigo kor pirexiano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578132&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d85c6e56-50ec-4808-93c8-655a7d02bc07\', \'multiverseId\': 578132}, \'multiverseid\': 578132}, {\'name\': \'Elas il-Kor, pèlerine sadique\', \'text\': "Contact mortel\\nÀ chaque fois qu\'une autre créature arrive sur le champ de bataille sous votre contrôle, vous gagnez 1 point de vie.\\nÀ chaque fois qu\'une autre créature que vous contrôlez meurt, chaque adversaire perd 1 point de vie.", \'type\': \'Créature légendaire : phyrexian et kor et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578173&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e06edb9a-50d8-4f66-b995-20537ec0908d\', \'multiverseId\': 578173}, \'multiverseid\': 578173}, {\'name\': \'Elas il-Kor, Pellegrina Sadica\', \'text\': "Tocco letale\\nOgniqualvolta un\'altra creatura entra nel campo di battaglia sotto il tuo controllo, guadagni 1 punto vita.\\nOgniqualvolta un\'altra creatura che controlli muore, ogni avversario perde 1 punto vita.", \'type\': \'Creatura Leggendaria — Chierico Kor Phyrexiano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578214&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2dce3503-e7a2-44c8-9a8c-91858f76b497\', \'multiverseId\': 578214}, \'multiverseid\': 578214}, {\'name\': \'残忍な巡礼者、コー追われのエラス\', \'text\': \'接死\\nこれでないクリーチャー１体があなたのコントロール下で戦場に出るたび、あなたは１点のライフを得る。\\nあなたがコントロールしていてこれでないクリーチャー１体が死亡するたび、各対戦相手はそれぞれ１点のライフを失う。\', \'type\': \'伝説のクリーチャー — ファイレクシアン・コー・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578255&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4e751b2e-e0b9-4c03-a72a-8c3aeb80a983\', \'multiverseId\': 578255}, \'multiverseid\': 578255}, {\'name\': \'Elas il-Kor, Peregrina Sádica\', \'text\': \'Toque mortífero\\nToda vez que outra criatura entra no campo de batalha sob seu controle, você ganha 1 ponto de vida.\\nToda vez que outra criatura que você controla morre, cada oponente perde 1 ponto de vida.\', \'type\': \'Criatura Lendária — Phyrexiano Kor Clérigo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578337&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cbe77109-e16a-4523-9b97-c79c116cf994\', \'multiverseId\': 578337}, \'multiverseid\': 578337}, {\'name\': \'虐之华寇族黜人依拉丝\', \'text\': \'死触\\n每当另一个生物在你的操控下进战场时，你获得1点生命。\\n每当另一个由你操控的生物死去时，每位对手各失去1点生命。\', \'type\': \'传奇生物 ～非瑞人／寇族／僧侣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578419&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b475cf6d-fe1c-47ce-a12f-02419a5c6fae\', \'multiverseId\': 578419}, \'multiverseid\': 578419}]', '[{\'name\': \'Elektrostatische Infanterie\', \'text\': \'Verursacht Trampelschaden\\nImmer wenn du einen Spontanzauber oder eine Hexerei wirkst, lege eine +1/+1-Marke auf die Elektrostatische Infanterie.\', \'type\': \'Kreatur — Zwerg, Zauberer\', \'flavor\': \'„Das ist nicht ganz das, was ich mir unter ‚geballte Ladung\\\' vorgestellt habe, aber mir gefällt euer Enthusiasmus!"\\n—Balmor, Feldherr der Kampfmagier\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574863&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'33b99ff3-8694-47ee-86ff-971e8e3c6d09\', \'multiverseId\': 574863}, \'multiverseid\': 574863}, {\'name\': \'Infantería electrostática\', \'text\': \'Arrolla.\\nSiempre que lances un hechizo de instantáneo o de conjuro, pon un contador +1/+1 sobre la Infantería electrostática.\', \'type\': \'Criatura — Hechicero enano\', \'flavor\': \'"No me refería a eso cuando te pedí que cargaras, ¡pero aprecio tu entusiasmo!".\\n—Balmor, capitán mago de guerra\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575124&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fed06c92-804a-4107-845b-a26adcb5f2b4\', \'multiverseId\': 575124}, \'multiverseid\': 575124}, {\'name\': \'Infanterie électrostatique\', \'text\': "Piétinement\\nÀ chaque fois que vous lancez un sort d\'éphémère ou de rituel, mettez un marqueur +1/+1 sur l\'Infanterie électrostatique.", \'type\': \'Créature : nain et sorcier\', \'flavor\': "« Ce n\'est pas exactement ce que j\'avais en tête quand j\'ai dit de charger, mais j\'apprécie votre enthousiasme ! »\\n— Balmor, capitaine mage de bataille", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575385&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'51a22d31-1f58-4e93-b1f8-09dbc523de2c\', \'multiverseId\': 575385}, \'multiverseid\': 575385}, {\'name\': \'Fanteria Elettrostatica\', \'text\': \'Travolgere\\nOgniqualvolta lanci una magia istantaneo o stregoneria, metti un segnalino +1/+1 sulla Fanteria Elettrostatica.\', \'type\': \'Creatura — Mago Nano\', \'flavor\': \'"Non è esattamente quello che avevo in mente quando ho detto \\\'carica\\\', ma apprezzo il tuo entusiasmo!"\\n—Balmor, mago combattente capitano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575646&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'411ec2ba-a4e4-4527-b888-284baa77ecd4\', \'multiverseId\': 575646}, \'multiverseid\': 575646}, {\'name\': \'静電式歩兵\', \'text\': \'トランプル\\nあなたがインスタントやソーサリーである呪文を唱えるたび、静電式歩兵の上に＋１/＋１カウンター１個を置く。\', \'type\': \'クリーチャー — ドワーフ・ウィザード\', \'flavor\': \'「『チャージしろ』って言ったらこういうことになるとは思わなかった。だが気合いは認める！」\\n――戦闘魔道士の隊長、バルモア\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575907&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3f7702a9-115c-4067-86ab-1cc656e570d9\', \'multiverseId\': 575907}, \'multiverseid\': 575907}, {\'name\': \'Infantaria Eletrostática\', \'text\': \'Atropelar\\nToda vez que você conjurar uma mágica instantânea ou um feitiço, coloque um marcador +1/+1 em Infantaria Eletrostática.\', \'type\': \'Criatura — Anão Mago\', \'flavor\': \'"Não é bem o que eu quis dizer com \\\'carga\\\', mas gostei do entusiasmo!"\\n— Balmor, capitão dos magos de combate\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576429&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e1522558-0963-438d-92a8-5489148e031e\', \'multiverseId\': 576429}, \'multiverseid\': 576429}, {\'name\': \'静电步兵\', \'text\': \'践踏\\n每当你施放瞬间或法术咒语时，在静电步兵上放置一个+1/+1指示物。\', \'type\': \'生物 ～矮人／法术师\', \'flavor\': \'「我想说的是『充』电而不是『冲』锋，但我喜欢你的劲头！」\\n～战巫师队长巴尔莫\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576951&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5b805f87-079c-47db-826d-de98a1728397\', \'multiverseId\': 576951}, \'multiverseid\': 576951}]', '[{\'name\': \'Elfheim-Wurm\', \'text\': \'Wachsamkeit, verursacht Trampelschaden\', \'type\': \'Kreatur — Wurm\', \'flavor\': \'Würmer verschlingen alles, was ihren Weg kreuzt, daher sorgen die Elfen dafür, dass ihr Weg durch möglichst viele Phyrexianer führt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574902&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6c90421a-1bc2-4ab3-9a43-8ef540c31b6f\', \'multiverseId\': 574902}, \'multiverseid\': 574902}, {\'name\': \'Sierpe del elfhogar\', \'text\': \'Vigilancia, arrolla.\', \'type\': \'Criatura — Sierpe\', \'flavor\': \'Las sierpes arrasan con todo lo que se encuentre en su camino, así que los elfos se aseguran de llevarlas por donde haya la mayor cantidad de pirexianos posible.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575163&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fe17612f-7dfe-480e-943e-cb459eab219a\', \'multiverseId\': 575163}, \'multiverseid\': 575163}, {\'name\': \'Guivre terrelfe\', \'text\': \'Vigilance, piétinement\', \'type\': \'Créature : guivre\', \'flavor\': "Les guivres consument tout sur leur chemin, alors les elfes s\'assurent que leur chemin traverse le plus de Phyrexians possible.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575424&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'35cb2f55-1f3f-4436-95fc-0d86dda102b3\', \'multiverseId\': 575424}, \'multiverseid\': 575424}, {\'name\': \'Wurm del Regno Elfico\', \'text\': \'Cautela, travolgere\', \'type\': \'Creatura — Wurm\', \'flavor\': \'I wurm consumano ogni cosa sul loro cammino, quindi gli elfi fanno in modo che il loro cammino passi attraverso quanti più Phyrexiani possibile.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575685&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'91b0ed7d-1345-4428-aafe-ce9e61b9b2fe\', \'multiverseId\': 575685}, \'multiverseid\': 575685}, {\'name\': \'エルフェイムのワーム\', \'text\': \'警戒、トランプル\', \'type\': \'クリーチャー — ワーム\', \'flavor\': \'ワームは目の前にあるものすべてを食らうため、エルフはその通り道に可能な限り多くのファイレクシア人が重なるように仕向けた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575946&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5eff3e1b-abf7-48ef-bee5-4c21adc9e892\', \'multiverseId\': 575946}, \'multiverseid\': 575946}, {\'name\': \'Vorme de Elfilar\', \'text\': \'Vigilância, atropelar\', \'type\': \'Criatura — Vorme\', \'flavor\': \'Os vormes consomem tudo por onde passam, por isso os elfos fazem questão de incluir o maior número possível de phyrexianos no caminho deles.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576468&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d50feafe-46df-421a-bb0a-abaab9fe345a\', \'multiverseId\': 576468}, \'multiverseid\': 576468}, {\'name\': \'妖精乡亚龙\', \'text\': \'警戒，践踏\', \'type\': \'生物 ～亚龙\', \'flavor\': \'亚龙会吞噬沿途的一切，因此妖精只需确保它们是沿着非瑞克西亚人最多的那条路前进。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576990&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'15e8e807-7924-4111-8a6b-0277d72d656f\', \'multiverseId\': 576990}, \'multiverseid\': 576990}]', '[{\'name\': \'Elfische Hydromagierin\', \'text\': \'Bonus {3}{U} (Du kannst zusätzlich {3}{U} bezahlen, sowie du diesen Zauberspruch wirkst.)\\nWenn die Elfische Hydromagierin ins Spiel kommt und falls ihre Bonuskosten bezahlt wurden, erzeuge einen Spielstein, der eine Kopie einer Kreatur deiner Wahl ist, die du kontrollierst.\', \'type\': \'Kreatur — Elf, Zauberer\', \'flavor\': \'„Wasser erinnert sich an jedes Lebewesen, dessen Teil es jemals war. Wir müssen diese Erinnerung nur an die Oberfläche holen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574903&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d96503d4-a408-4e69-b06b-88766e0c213e\', \'multiverseId\': 574903}, \'multiverseid\': 574903}, {\'name\': \'Hidromante élfica\', \'text\': \'Estímulo {3}{U}. (Puedes pagar {3}{U} adicionales al lanzar este hechizo.)\\nCuando la Hidromante élfica entre al campo de batalla, si fue estimulada, crea una ficha que es una copia de la criatura objetivo que controlas.\', \'type\': \'Criatura — Hechicero elfo\', \'flavor\': \'"El agua tiene en la memoria todo ser viviente del que formó parte. Solo debemos conducir esos recuerdos a la superficie".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575164&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4e869c01-f6a0-402b-9c68-c714042e05fb\', \'multiverseId\': 575164}, \'multiverseid\': 575164}, {\'name\': \'Hydromancienne elfe\', \'text\': "Kick {3}{U} (Vous pouvez payer {3}{U} supplémentaires au moment où vous lancez ce sort.)\\nQuand l\'Hydromancienne elfe arrive sur le champ de bataille, si elle a été kickée, créez un jeton qui est une copie d\'une créature ciblée que vous contrôlez.", \'type\': \'Créature : elfe et sorcier\', \'flavor\': "« L\'eau se souvient de tous les êtres vivants dont elle a fait partie. Il suffit de faire remonter ce souvenir à la surface. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575425&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2ab2cede-81ff-4fdf-933c-d73327ef6a5c\', \'multiverseId\': 575425}, \'multiverseid\': 575425}, {\'name\': \'Idromante Elfica\', \'text\': "Potenziamento {3}{U} (Puoi pagare {3}{U} addizionale mentre lanci questa magia.)\\nQuando l\'Idromante Elfica entra nel campo di battaglia, se è stata potenziata, crea una pedina che è una copia di una creatura bersaglio che controlli.", \'type\': \'Creatura — Mago Elfo\', \'flavor\': \'"L\\\'acqua ricorda ogni essere vivente di cui abbia mai fatto parte. Dobbiamo solo riportare a galla questo ricordo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575686&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'68530844-85e7-4164-9447-898ab4310547\', \'multiverseId\': 575686}, \'multiverseid\': 575686}, {\'name\': \'エルフの水流術師\', \'text\': \'キッカー{3}{U}（この呪文を唱えるに際し、追加で{3}{U}を支払ってもよい。）\\nエルフの水流術師が戦場に出たとき、これがキッカーされていた場合、あなたがコントロールしているクリーチャー１体を対象とする。それのコピーであるトークン１つを生成する。\', \'type\': \'クリーチャー — エルフ・ウィザード\', \'flavor\': \'「水は関わりの持った生命をすべて記憶している。ただその記憶を表面に浮かび上がらせればいい。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575947&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'142cdbaf-00bd-4fec-95cf-614e5d7745f2\', \'multiverseId\': 575947}, \'multiverseid\': 575947}, {\'name\': \'Hidromante Élfica\', \'text\': \'Reforçar {3}{U} (Você pode pagar um custo adicional de {3}{U} ao conjurar esta mágica.)\\nQuando Hidromante Élfica entrar no campo de batalha, se ela foi reforçada, crie uma ficha que seja uma cópia da criatura alvo que você controla.\', \'type\': \'Criatura — Elfo Mago\', \'flavor\': \'"A água sempre se lembra de todos os seres vivos dos quais fez parte. Só precisamos trazer essa memória à tona."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576469&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'485eb5b4-36a5-421f-a376-4f3ef27e3387\', \'multiverseId\': 576469}, \'multiverseid\': 576469}, {\'name\': \'妖精流水术士\', \'text\': \'增幅{3}{U}（你施放此咒语时可以额外支付{3}{U}。）\\n当妖精流水术士进战场时，若它已增幅，则派出一个衍生物，此衍生物为目标由你操控的生物之复制品。\', \'type\': \'生物 ～妖精／法术师\', \'flavor\': \'「流水记得自己经过的每一个生灵。我们做的就只是重显记忆。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576991&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ae9a0414-8710-41c5-839c-bf607ba15227\', \'multiverseId\': 576991}, \'multiverseid\': 576991}]', '[{\'name\': \'Entschlossene Verstärkungen\', \'text\': \'Aufblitzen\\nWenn die Entschlossenen Verstärkungen ins Spiel kommen, erzeuge einen 1/1 weißen-Soldat-Kreaturenspielstein.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'Die Kampfmoral übersteht selten das plötzliche Auftauchen eines Trupps von Sursi-Plänklern in der Flanke einer Armee.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574770&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b40e30e2-683b-488f-ab8c-80ea3fe38547\', \'multiverseId\': 574770}, \'multiverseid\': 574770}, {\'name\': \'Refuerzos decididos\', \'text\': \'Destello.\\nCuando los Refuerzos decididos entren al campo de batalla, crea una ficha de criatura Soldado blanca 1/1.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'La aparición repentina de una brigada de escaramuzadores de Sursi en el flanco de un ejército es un golpe casi mortal para la moral.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575031&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e7c6f388-d379-4fc6-81f8-0ee7c22a32c4\', \'multiverseId\': 575031}, \'multiverseid\': 575031}, {\'name\': \'Renforts résolus\', \'text\': \'Flash\\nQuand les Renforts résolus arrivent sur le champ de bataille, créez un jeton de créature 1/1 blanche Soldat.\', \'type\': \'Créature : humain et soldat\', \'flavor\': "Le moral survit rarement à l\'apparition soudaine d\'une escouade d\'assaillants Sursi sur le flanc d\'une armée.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575292&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8c1394f3-2b50-414e-9532-76515acab122\', \'multiverseId\': 575292}, \'multiverseid\': 575292}, {\'name\': \'Rinforzi Risoluti\', \'text\': \'Lampo\\nQuando i Rinforzi Risoluti entrano nel campo di battaglia, crea una pedina creatura Soldato 1/1 bianca.\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'Raramente il morale di un esercito sopravvive alla comparsa improvvisa di una squadra di ricognitori di Sursi ai suoi fianchi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575553&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a227d87a-09fb-4ef7-8d12-e4ab55f02f76\', \'multiverseId\': 575553}, \'multiverseid\': 575553}, {\'name\': \'毅然たる援軍\', \'text\': \'瞬速\\n毅然たる援軍が戦場に出たとき、白の１/１の兵士・クリーチャー・トークン１体を生成する。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'軍隊の側面にサーシの散兵が突然現れると士気はほぼ確実に砕かれる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575814&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4c494cc0-8004-4de8-b333-8f4268894864\', \'multiverseId\': 575814}, \'multiverseid\': 575814}, {\'name\': \'Reforços Resolutos\', \'text\': \'Lampejo\\nQuando Reforços Resolutos entrar no campo de batalha, crie uma ficha de criatura Soldado branca 1/1.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': \'Raramente o moral de um exército resiste à súbita aparição de um esquadrão de escaramuçadores de Sursi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576336&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8256d00d-9d34-4fdb-a8f4-53310d4d8d8a\', \'multiverseId\': 576336}, \'multiverseid\': 576336}, {\'name\': \'坚定援兵\', \'text\': \'闪现\\n当坚定援兵进战场时，派出一个1/1白色士兵衍生生物。\', \'type\': \'生物 ～人类／士兵\', \'flavor\': \'眼见侧翼杀出一队苏西侦卫时，鲜有军队还能留有战意。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576858&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'662fb694-6e36-4625-8370-517d580f5d77\', \'multiverseId\': 576858}, \'multiverseid\': 576858}]', '[{\'name\': \'Entschlossene Verstärkungen\', \'text\': \'Aufblitzen\\nWenn die Entschlossenen Verstärkungen ins Spiel kommen, erzeuge einen 1/1 weißen-Soldat-Kreaturenspielstein.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'Die Kampfmoral übersteht selten das plötzliche Auftauchen eines Trupps von Sursi-Plänklern in der Flanke einer Armee.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577728&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'92df74b4-69a0-4fe3-bf6e-c9e7c561ddc5\', \'multiverseId\': 577728}, \'multiverseid\': 577728}, {\'name\': \'Refuerzos decididos\', \'text\': \'Destello.\\nCuando los Refuerzos decididos entren al campo de batalla, crea una ficha de criatura Soldado blanca 1/1.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'La aparición repentina de una brigada de escaramuzadores de Sursi en el flanco de un ejército es un golpe casi mortal para la moral.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577733&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a705d80a-0b4f-4e4d-9df8-0faf58245759\', \'multiverseId\': 577733}, \'multiverseid\': 577733}, {\'name\': \'Renforts résolus\', \'text\': \'Flash\\nQuand les Renforts résolus arrivent sur le champ de bataille, créez un jeton de créature 1/1 blanche Soldat.\', \'type\': \'Créature : humain et soldat\', \'flavor\': "Le moral survit rarement à l\'apparition soudaine d\'une escouade d\'assaillants Sursi sur le flanc d\'une armée.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577738&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1a696667-2267-4542-ad13-5d6398c24708\', \'multiverseId\': 577738}, \'multiverseid\': 577738}, {\'name\': \'Rinforzi Risoluti\', \'text\': \'Lampo\\nQuando i Rinforzi Risoluti entrano nel campo di battaglia, crea una pedina creatura Soldato 1/1 bianca.\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'Raramente il morale di un esercito sopravvive alla comparsa improvvisa di una squadra di ricognitori di Sursi ai suoi fianchi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577743&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ccd6ad69-e939-4bcf-8266-309279b61916\', \'multiverseId\': 577743}, \'multiverseid\': 577743}, {\'name\': \'毅然たる援軍\', \'text\': \'瞬速\\n毅然たる援軍が戦場に出たとき、白の１/１の兵士・クリーチャー・トークン１体を生成する。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'軍隊の側面にサーシの散兵が突然現れると士気はほぼ確実に砕かれる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577748&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'daaa6855-b742-4a18-913d-ce3020d00671\', \'multiverseId\': 577748}, \'multiverseid\': 577748}, {\'name\': \'Reforços Resolutos\', \'text\': \'Lampejo\\nQuando Reforços Resolutos entrar no campo de batalha, crie uma ficha de criatura Soldado branca 1/1.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': \'Raramente o moral de um exército resiste à súbita aparição de um esquadrão de escaramuçadores de Sursi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577758&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fcc578e4-1df8-482a-ad27-7011fc3083c1\', \'multiverseId\': 577758}, \'multiverseid\': 577758}, {\'name\': \'坚定援兵\', \'text\': \'闪现\\n当坚定援兵进战场时，派出一个1/1白色士兵衍生生物。\', \'type\': \'生物 ～人类／士兵\', \'flavor\': \'眼见侧翼杀出一队苏西侦卫时，鲜有军队还能留有战意。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577768&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0709247f-74dc-4d24-a9eb-b059cc4ea27e\', \'multiverseId\': 577768}, \'multiverseid\': 577768}]', '[{\'name\': \'Erbstück des Helden\', \'text\': \'Die ausgerüstete Kreatur erhält +2/+1.\\nSolange die ausgerüstete Kreatur legendär ist, verursacht sie Trampelschaden und hat Eile.\\nAusrüsten {2}\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': \'„Eine Klinge ist nur ein Werkzeug. Ihre Macht kommt von der Hand, die sie führt."\\n—Danitha\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574972&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9d465b1c-da91-40a9-999e-82dfd73c28c9\', \'multiverseId\': 574972}, \'multiverseid\': 574972}, {\'name\': \'Herencia del héroe\', \'text\': \'La criatura equipada obtiene +2/+1.\\nMientras la criatura equipada sea legendaria, tiene las habilidades de arrollar y prisa.\\nEquipar {2}.\', \'type\': \'Artefacto — Equipo\', \'flavor\': \'"Una hoja no es más que una herramienta. Su fuerza proviene de la mano que la empuña".\\n—Danitha\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575233&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'69144c0a-06af-4c2c-9b2b-a8875fc44b53\', \'multiverseId\': 575233}, \'multiverseid\': 575233}, {\'name\': \'Héritage du héros\', \'text\': \'La créature équipée gagne +2/+1.\\nTant que la créature équipée est légendaire, elle a le piétinement et la célérité.\\nÉquipement {2}\', \'type\': \'Artefact : équipement\', \'flavor\': "« L\'épée n\'est qu\'un outil. Sa puissance vient de la main qui la brandit. »\\n—Danitha", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575494&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0b36a0aa-c50b-41ee-8446-468e4dd62cc3\', \'multiverseId\': 575494}, \'multiverseid\': 575494}, {\'name\': "Cimelio dell\'Eroe", \'text\': \'La creatura equipaggiata prende +2/+1.\\nFintanto che la creatura equipaggiata è leggendaria, ha travolgere e rapidità.\\nEquipaggiare {2}\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': \'"Una spada è solo uno strumento. Il suo potere deriva dalla mano che la brandisce."\\n—Danitha\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575755&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'74dd34f9-e021-4fe3-85da-9d7e11e73b75\', \'multiverseId\': 575755}, \'multiverseid\': 575755}, {\'name\': \'英雄の家宝\', \'text\': \'装備しているクリーチャーは＋２/＋１の修整を受ける。\\n装備しているクリーチャーが伝説であるかぎり、それはトランプルと速攻を持つ。\\n装備{2}\', \'type\': \'アーティファクト — 装備品\', \'flavor\': \'「刃はただの道具よ。それの力はそれを握る者から来るの。」\\n――ダニサ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576016&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4eab1d4b-d665-48ae-aee2-42c453ffa73c\', \'multiverseId\': 576016}, \'multiverseid\': 576016}, {\'name\': \'Herança do Herói\', \'text\': \'A criatura equipada recebe +2/+1.\\nEnquanto a criatura equipada for lendária, ela terá atropelar e ímpeto.\\nEquipar {2}\', \'type\': \'Artefato — Equipamento\', \'flavor\': \'"Uma espada é apenas uma ferramenta. O poder dela vem da mão que a empunha."\\n— Danitha\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576538&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d8ae3f7d-ffc5-41e7-9464-32ddaf022051\', \'multiverseId\': 576538}, \'multiverseid\': 576538}, {\'name\': \'英雄传家宝\', \'text\': \'佩带此武具的生物得+2/+1。\\n只要佩带此武具的生物是传奇，它便具有践踏与敏捷异能。\\n佩带{2}\', \'type\': \'神器 ～武具\', \'flavor\': \'「刀剑不过是工具。其力量来自于挥舞它们的手。」\\n～达妮莎\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577060&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e6ea0b43-243a-40d9-87a2-905b2e6c2612\', \'multiverseId\': 577060}, \'multiverseid\': 577060}]', '[{\'name\': \'Ertai der Wiedererweckte\', \'text\': \'Aufblitzen\\nWenn Ertai der Wiedererweckte ins Spiel kommt, bestimme bis zu eines —\\n• Neutralisiere einen Zauberspruch, eine aktivierte oder eine ausgelöste Fähigkeit deiner Wahl. Sein bzw. ihr Beherrscher zieht eine Karte.\\n• Zerstöre eine andere Kreatur oder einen anderen Planeswalker deiner Wahl. Ihr bzw. sein Beherrscher zieht eine Karte.\', \'type\': \'Legendäre Kreatur — Phyrexianer, Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574940&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f05442d9-b4f4-41ac-9913-74552dbb3b28\', \'multiverseId\': 574940}, \'multiverseid\': 574940}, {\'name\': \'Ertai resucitado\', \'text\': \'Destello.\\nCuando Ertai resucitado entre al campo de batalla, elige hasta uno:\\n• Contrarresta el hechizo, habilidad activada o habilidad disparada objetivo. Su controlador roba una carta.\\n• Destruye otra criatura o planeswalker objetivo. Su controlador roba una carta.\', \'type\': \'Criatura legendaria — Hechicero humano pirexiano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575201&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6804dfc1-da93-43c5-86ee-a19047fdd418\', \'multiverseId\': 575201}, \'multiverseid\': 575201}, {\'name\': \'Ertaï revenu à la vie\', \'text\': "Flash\\nQuand Ertaï revenu à la vie arrive sur le champ de bataille, choisissez jusqu\'à l\'un —\\n• Contrecarrez une cible, sort, capacité activée ou capacité déclenchée. Son contrôleur pioche une carte.\\n• Détruisez une cible, autre créature ou planeswalker. Son contrôleur pioche une carte.", \'type\': \'Créature légendaire : phyrexian et humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575462&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2d99c94b-1ef7-455c-b1a7-8fe12acd579f\', \'multiverseId\': 575462}, \'multiverseid\': 575462}, {\'name\': \'Ertai Risorto\', \'text\': "Lampo\\nQuando Ertai Risorto entra nel campo di battaglia, scegli fino a uno —\\n• Neutralizza una magia, un\'abilità attivata o un\'abilità innescata bersaglio. Il suo controllore pesca una carta.\\n• Distruggi un\'altra creatura o planeswalker bersaglio. Il suo controllore pesca una carta.", \'type\': \'Creatura Leggendaria — Mago Umano Phyrexiano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575723&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6f321846-4e0e-4a62-b1fc-6f8fa532e586\', \'multiverseId\': 575723}, \'multiverseid\': 575723}, {\'name\': \'復活したアーテイ\', \'text\': \'瞬速\\n復活したアーテイが戦場に出たとき、以下から最大１つを選ぶ。\\n・呪文や起動型能力や誘発型能力のうち１つを対象とする。それを打ち消す。それのコントローラーはカード１枚を引く。\\n・クリーチャーやプレインズウォーカーのうちこれでない１体を対象とする。それを破壊する。それのコントローラーはカード１枚を引く。\', \'type\': \'伝説のクリーチャー — ファイレクシアン・人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575984&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'53b7f496-0544-4d94-8ca3-365f34db60b9\', \'multiverseId\': 575984}, \'multiverseid\': 575984}, {\'name\': \'Ertai Ressuscitado\', \'text\': \'Lampejo\\nQuando Ertai Ressuscitado entrar no campo de batalha, escolha até um —\\n• Anule a mágica, a habilidade ativada ou a habilidade desencadeada alvo. Seu controlador compra um card.\\n• Destrua outra criatura ou outro planeswalker alvo. Seu controlador compra um card.\', \'type\': \'Criatura Lendária — Phyrexiano Humano Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576506&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5fc05268-01da-44a9-b38d-6ad0160adf01\', \'multiverseId\': 576506}, \'multiverseid\': 576506}, {\'name\': \'复生的尔泰\', \'text\': \'闪现\\n当复生的尔泰进战场时，选择至多一项～\\n•反击目标咒语，起动式异能或触发式异能。其操控者抓一张牌。\\n•消灭另一个目标生物或鹏洛客。其操控者抓一张牌。\', \'type\': \'传奇生物 ～非瑞人／人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577028&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b5d4ed4b-71df-4ce0-84a0-b216c43e36e3\', \'multiverseId\': 577028}, \'multiverseid\': 577028}]', '[{\'name\': \'Ertai der Wiedererweckte\', \'text\': \'Aufblitzen\\nWenn Ertai der Wiedererweckte ins Spiel kommt, bestimme bis zu eines —\\n• Neutralisiere einen Zauberspruch, eine aktivierte oder eine ausgelöste Fähigkeit deiner Wahl. Sein bzw. ihr Beherrscher zieht eine Karte.\\n• Zerstöre eine andere Kreatur oder einen anderen Planeswalker deiner Wahl. Ihr bzw. sein Beherrscher zieht eine Karte.\', \'type\': \'Legendäre Kreatur — Phyrexianer, Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577885&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0f2bdb94-d9c7-44b8-8392-0ea4f38f1959\', \'multiverseId\': 577885}, \'multiverseid\': 577885}, {\'name\': \'Ertaï revenu à la vie\', \'text\': "Flash\\nQuand Ertaï revenu à la vie arrive sur le champ de bataille, choisissez jusqu\'à l\'un —\\n• Contrecarrez une cible, sort, capacité activée ou capacité déclenchée. Son contrôleur pioche une carte.\\n• Détruisez une cible, autre créature ou planeswalker. Son contrôleur pioche une carte.", \'type\': \'Créature légendaire : phyrexian et humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577926&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1edf59a7-98d5-412f-bf70-232af6fc6eea\', \'multiverseId\': 577926}, \'multiverseid\': 577926}, {\'name\': \'復活したアーテイ\', \'text\': \'瞬速\\n復活したアーテイが戦場に出たとき、以下から最大１つを選ぶ。\\n・呪文や起動型能力や誘発型能力のうち１つを対象とする。それを打ち消す。それのコントローラーはカード１枚を引く。\\n・クリーチャーやプレインズウォーカーのうちこれでない１体を対象とする。それを破壊する。それのコントローラーはカード１枚を引く。\', \'type\': \'伝説のクリーチャー — ファイレクシアン・人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577967&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'93a5c90e-c62f-49e5-88d5-50f452498147\', \'multiverseId\': 577967}, \'multiverseid\': 577967}, {\'name\': \'复生的尔泰\', \'text\': \'闪现\\n当复生的尔泰进战场时，选择至多一项～\\n•反击目标咒语，起动式异能或触发式异能。其操控者抓一张牌。\\n•消灭另一个目标生物或鹏洛客。其操控者抓一张牌。\', \'type\': \'传奇生物 ～非瑞人／人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578008&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a993928c-8a95-451d-9edb-ed7d0b2e0a07\', \'multiverseId\': 578008}, \'multiverseid\': 578008}]', '[{\'name\': \'Ertai der Wiedererweckte\', \'text\': \'Aufblitzen\\nWenn Ertai der Wiedererweckte ins Spiel kommt, bestimme bis zu eines —\\n• Neutralisiere einen Zauberspruch, eine aktivierte oder eine ausgelöste Fähigkeit deiner Wahl. Sein bzw. ihr Beherrscher zieht eine Karte.\\n• Zerstöre eine andere Kreatur oder einen anderen Planeswalker deiner Wahl. Ihr bzw. sein Beherrscher zieht eine Karte.\', \'type\': \'Legendäre Kreatur — Phyrexianer, Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578092&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7b2f859d-8564-4eda-895f-7a7d5560de15\', \'multiverseId\': 578092}, \'multiverseid\': 578092}, {\'name\': \'Ertai resucitado\', \'text\': \'Destello.\\nCuando Ertai resucitado entre al campo de batalla, elige hasta uno:\\n• Contrarresta el hechizo, habilidad activada o habilidad disparada objetivo. Su controlador roba una carta.\\n• Destruye otra criatura o planeswalker objetivo. Su controlador roba una carta.\', \'type\': \'Criatura legendaria — Hechicero humano pirexiano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578133&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'daeafa16-091a-4586-aeec-945e7446b25b\', \'multiverseId\': 578133}, \'multiverseid\': 578133}, {\'name\': \'Ertaï revenu à la vie\', \'text\': "Flash\\nQuand Ertaï revenu à la vie arrive sur le champ de bataille, choisissez jusqu\'à l\'un —\\n• Contrecarrez une cible, sort, capacité activée ou capacité déclenchée. Son contrôleur pioche une carte.\\n• Détruisez une cible, autre créature ou planeswalker. Son contrôleur pioche une carte.", \'type\': \'Créature légendaire : phyrexian et humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578174&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1219b986-5331-410e-8474-58e0b1f5bd70\', \'multiverseId\': 578174}, \'multiverseid\': 578174}, {\'name\': \'Ertai Risorto\', \'text\': "Lampo\\nQuando Ertai Risorto entra nel campo di battaglia, scegli fino a uno —\\n• Neutralizza una magia, un\'abilità attivata o un\'abilità innescata bersaglio. Il suo controllore pesca una carta.\\n• Distruggi un\'altra creatura o planeswalker bersaglio. Il suo controllore pesca una carta.", \'type\': \'Creatura Leggendaria — Mago Umano Phyrexiano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578215&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ff0ddfdb-b1c3-4fb7-abb6-0cc01c68519e\', \'multiverseId\': 578215}, \'multiverseid\': 578215}, {\'name\': \'復活したアーテイ\', \'text\': \'瞬速\\n復活したアーテイが戦場に出たとき、以下から最大１つを選ぶ。\\n・呪文や起動型能力や誘発型能力のうち１つを対象とする。それを打ち消す。それのコントローラーはカード１枚を引く。\\n・クリーチャーやプレインズウォーカーのうちこれでない１体を対象とする。それを破壊する。それのコントローラーはカード１枚を引く。\', \'type\': \'伝説のクリーチャー — ファイレクシアン・人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578256&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'37d6a62b-7290-4be0-99cd-3f54da07ccf4\', \'multiverseId\': 578256}, \'multiverseid\': 578256}, {\'name\': \'Ertai Ressuscitado\', \'text\': \'Lampejo\\nQuando Ertai Ressuscitado entrar no campo de batalha, escolha até um —\\n• Anule a mágica, a habilidade ativada ou a habilidade desencadeada alvo. Seu controlador compra um card.\\n• Destrua outra criatura ou outro planeswalker alvo. Seu controlador compra um card.\', \'type\': \'Criatura Lendária — Phyrexiano Humano Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578338&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dd402140-721d-4f87-9d17-e9aff050d018\', \'multiverseId\': 578338}, \'multiverseid\': 578338}, {\'name\': \'复生的尔泰\', \'text\': \'闪现\\n当复生的尔泰进战场时，选择至多一项～\\n•反击目标咒语，起动式异能或触发式异能。其操控者抓一张牌。\\n•消灭另一个目标生物或鹏洛客。其操控者抓一张牌。\', \'type\': \'传奇生物 ～非瑞人／人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578420&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b87b5f49-8830-425b-82c6-5ca6cac04dc1\', \'multiverseId\': 578420}, \'multiverseid\': 578420}]', '[{\'name\': \'Ertais Hohn\', \'text\': \'Dieser Zauberspruch kostet beim Wirken {U} weniger, falls ein Gegner in diesem Zug zwei oder mehr Zaubersprüche gewirkt hat.\\nNeutralisiere einen Zauberspruch deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„So etwas Besonderes bist du nicht, Karn. Alles, was zusammengebaut wurde, lässt sich auseinandernehmen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574789&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6e160f0b-f6d2-45aa-82b0-c3abd228b7f6\', \'multiverseId\': 574789}, \'multiverseid\': 574789}, {\'name\': \'Desprecio de Ertai\', \'text\': \'Te cuesta {U} menos lanzar este hechizo si un oponente lanzó dos o más hechizos este turno.\\nContrarresta el hechizo objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"No te creas especial, Karn. Todo lo que fue construido se puede desarmar".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575050&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'13525df4-c852-48ef-9b26-c4c1a99bcf75\', \'multiverseId\': 575050}, \'multiverseid\': 575050}, {\'name\': \'Mépris selon Ertaï\', \'text\': \'Ce sort coûte {U} de moins à lancer si un adversaire a lancé au moins deux sorts ce tour-ci.\\nContrecarrez un sort ciblé.\', \'type\': \'Éphémère\', \'flavor\': "« Tu n\'es rien de spécial, Karn. Tout ce qui a été assemblé peut être désassemblé. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575311&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'24078bd1-e504-44dd-a8fc-94dc29d7fa32\', \'multiverseId\': 575311}, \'multiverseid\': 575311}, {\'name\': \'Sdegno di Ertai\', \'text\': \'Questa magia costa {U} in meno per essere lanciata se un avversario ha lanciato due o più magie in questo turno.\\nNeutralizza una magia bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Non sei così speciale, Karn. Ciò che è stato montato può essere smontato."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575572&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8579c760-5aa5-4484-bce7-c78479744fba\', \'multiverseId\': 575572}, \'multiverseid\': 575572}, {\'name\': \'アーテイの嘲笑\', \'text\': \'このターンに対戦相手１人が２つ以上の呪文を唱えていたなら、この呪文を唱えるコストは{U}少なくなる。\\n呪文１つを対象とする。それを打ち消す。\', \'type\': \'インスタント\', \'flavor\': \'「カーン、お前は特別なんかじゃない。組み立てられたものは解体されうるのだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575833&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e88652b1-ff68-4a89-a477-6bdaa10d3143\', \'multiverseId\': 575833}, \'multiverseid\': 575833}, {\'name\': \'Escárnio de Ertai\', \'text\': \'Esta mágica custa {U} a menos para ser conjurada se um oponente conjurou duas ou mais mágicas neste turno.\\nAnule a mágica alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Você não é tão especial, Karn. Tudo que foi montado pode ser desmontado."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576355&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7b7bb8a1-0954-4219-b570-2f2589d9aae5\', \'multiverseId\': 576355}, \'multiverseid\': 576355}, {\'name\': \'尔泰的轻蔑\', \'text\': \'如果任一对手本回合中施放过两个或更多咒语，则此咒语减少{U}来施放。\\n反击目标咒语。\', \'type\': \'瞬间\', \'flavor\': \'「卡恩，你并不特别。只要是拼组出来的东西就能拆得掉。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576877&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8eec2e1a-7bd0-4058-b94c-7f171e5a5d86\', \'multiverseId\': 576877}, \'multiverseid\': 576877}]', '[{\'name\': \'Erzengel des Zorns\', \'text\': \'Bonus {B} und/oder {R} (Du kannst zusätzlich {B} und/oder {R} bezahlen, sowie du diesen Zauberspruch wirkst.)\\nFliegend, Lebensverknüpfung\\nWenn der Erzengel des Zorns ins Spiel kommt und falls seine Bonuskosten bezahlt wurden, fügt er einem Ziel deiner Wahl 2 Schadenspunkte zu.\\nWenn der Erzengel des Zorns ins Spiel kommt und falls zwei seiner Bonuskosten bezahlt wurden, fügt er einem Ziel deiner Wahl 2 Schadenspunkte zu.\', \'type\': \'Kreatur — Engel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574744&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'23a6b9c9-76d0-408d-8555-fbbccf2bbf56\', \'multiverseId\': 574744}, \'multiverseid\': 574744}, {\'name\': \'Arcángel de la ira\', \'text\': \'Estímulo {B} y/o {R}. (Puedes pagar {B} y/o {R} adicionales al lanzar este hechizo.)\\nVuela, vínculo vital.\\nCuando el Arcángel de la ira entre al campo de batalla, si fue estimulado, hace 2 puntos de daño a cualquier objetivo.\\nCuando el Arcángel de la ira entre al campo de batalla, si fue estimulado dos veces, hace 2 puntos de daño a cualquier objetivo.\', \'type\': \'Criatura — Ángel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575005&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1b32bdc6-6991-4afa-933c-84419bbe0a9d\', \'multiverseId\': 575005}, \'multiverseid\': 575005}, {\'name\': \'Archange de la colère\', \'text\': "Kick {B} et/ou {R} (Vous pouvez payer {B} et/ou {R} supplémentaires au moment où vous lancez ce sort.)\\nVol, lien de vie\\nQuand l\'Archange de la colère arrive sur le champ de bataille, s\'il a été kické, il inflige 2 blessures à n\'importe quelle cible.\\nQuand l\'Archange de la colère arrive sur le champ de bataille, s\'il a été kické deux fois, il inflige 2 blessures à n\'importe quelle cible.", \'type\': \'Créature : ange\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575266&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'01975463-c80c-4bc8-b893-8d063281926a\', \'multiverseId\': 575266}, \'multiverseid\': 575266}, {\'name\': "Arcangelo dell\'Ira", \'text\': "Potenziamento {B} e/o {R} (Puoi pagare {B} e/o {R} addizionali mentre lanci questa magia.)\\nVolare, legame vitale\\nQuando l\'Arcangelo dell\'Ira entra nel campo di battaglia, se è stato potenziato, infligge 2 danni a un qualsiasi bersaglio.\\nQuando l\'Arcangelo dell\'Ira entra nel campo di battaglia, se è stato potenziato due volte, infligge 2 danni a un qualsiasi bersaglio.", \'type\': \'Creatura — Angelo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575527&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'73767d83-8ffb-482e-8ea5-1318637dfe4d\', \'multiverseId\': 575527}, \'multiverseid\': 575527}, {\'name\': \'怒りの大天使\', \'text\': \'キッカー{B}、キッカー{R}（この呪文を唱えるに際し、追加で{B}や{R}を支払ってもよい。）\\n飛行、絆魂\\n怒りの大天使が戦場に出たとき、これがキッカーされていた場合、クリーチャーやプレインズウォーカーやプレイヤーのうち１つを対象とする。これはそれに２点のダメージを与える。\\n怒りの大天使が戦場に出たとき、２回キッカーされていた場合、クリーチャーやプレインズウォーカーやプレイヤーのうち１つを対象とする。これはそれに２点のダメージを与える。\', \'type\': \'クリーチャー — 天使\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575788&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ef05e0d0-0709-4d5b-abb6-03e172c84c2c\', \'multiverseId\': 575788}, \'multiverseid\': 575788}, {\'name\': \'Arcanjo da Ira\', \'text\': \'Reforçar {B} e/ou {R} (Você pode pagar um custo adicional de {B} e/ou {R} ao conjurar esta mágica.)\\nVoar, vínculo com a vida\\nQuando Arcanjo da Ira entra no campo de batalha, se ele foi reforçado, ele causa 2 pontos de dano a qualquer alvo.\\nQuando Arcanjo da Ira entra no campo de batalha, se ele foi reforçado duas vezes, ele causa 2 pontos de dano a qualquer alvo.\', \'type\': \'Criatura — Anjo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576310&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e1658253-0d68-49fb-8afc-24b24326cf0f\', \'multiverseId\': 576310}, \'multiverseid\': 576310}, {\'name\': \'忿怒大天使\', \'text\': \'增幅{B}和／或{R}（你施放此咒语时可以额外支付{B}和／或{R}。）\\n飞行，系命\\n当忿怒大天使进战场时，若它已增幅，则它对任意一个目标造成2点伤害。\\n当忿怒大天使进战场时，若它已增幅两次，则它对任意一个目标造成2点伤害。\', \'type\': \'生物 ～天使\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576832&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a1feb7fb-6f58-4419-a823-c061b22b3606\', \'multiverseId\': 576832}, \'multiverseid\': 576832}]', '[{\'name\': \'Erzengel des Zorns\', \'text\': \'Bonus {B} und/oder {R}\\nFliegend, Lebensverknüpfung\\nWenn der Erzengel des Zorns ins Spiel kommt und falls seine Bonuskosten bezahlt wurden, fügt er einem Ziel deiner Wahl 2 Schadenspunkte zu.\\nWenn der Erzengel des Zorns ins Spiel kommt und falls zwei seiner Bonuskosten bezahlt wurden, fügt er einem Ziel deiner Wahl 2 Schadenspunkte zu.\', \'type\': \'Kreatur — Engel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577539&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4a3c66d7-fee4-4b67-beff-188ac66efc60\', \'multiverseId\': 577539}, \'multiverseid\': 577539}, {\'name\': \'Archange de la colère\', \'text\': "Kick {B} et/ou {R}\\nVol, lien de vie\\nQuand l\'Archange de la colère arrive sur le champ de bataille, s\'il a été kické, il inflige 2 blessures à n\'importe quelle cible.\\nQuand l\'Archange de la colère arrive sur le champ de bataille, s\'il a été kické deux fois, il inflige 2 blessures à n\'importe quelle cible.", \'type\': \'Créature : ange\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577579&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c6cf041a-3e73-42ee-8dcb-21fb96f73a39\', \'multiverseId\': 577579}, \'multiverseid\': 577579}, {\'name\': \'怒りの大天使\', \'text\': \'キッカー{B}、キッカー{R}\\n飛行、絆魂\\n怒りの大天使が戦場に出たとき、これがキッカーされていた場合、クリーチャーやプレインズウォーカーやプレイヤーのうち１つを対象とする。これはそれに２点のダメージを与える。\\n怒りの大天使が戦場に出たとき、２回キッカーされていた場合、クリーチャーやプレインズウォーカーやプレイヤーのうち１つを対象とする。これはそれに２点のダメージを与える。\', \'type\': \'クリーチャー — 天使\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577619&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f0d588a1-402c-44fc-b76f-37b9945469e2\', \'multiverseId\': 577619}, \'multiverseid\': 577619}, {\'name\': \'忿怒大天使\', \'text\': \'增幅{B}和／或{R}\\n飞行，系命\\n当忿怒大天使进战场时，若它已增幅，则它对任意一个目标造成2点伤害。\\n当忿怒大天使进战场时，若它已增幅两次，则它对任意一个目标造成2点伤害。\', \'type\': \'生物 ～天使\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577659&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3f624240-4440-496f-8343-9b63c6d82824\', \'multiverseId\': 577659}, \'multiverseid\': 577659}]', '[{\'name\': \'Essenzzerstäubung\', \'text\': \'Neutralisiere einen Kreaturenzauber deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Phyrexianer verschmutzen alles, was sie berühren. Die Lösung ist also einfach: Lass nicht zu, dass sie etwas berühren."\\n—Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574790&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cab0d680-d788-4f26-ac5a-64e0896702ea\', \'multiverseId\': 574790}, \'multiverseid\': 574790}, {\'name\': \'Esparcir la esencia\', \'text\': \'Contrarresta el hechizo de criatura objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Los pirexianos contaminan todo lo que tocan, así que la solución es fácil: no dejes que toquen nada".\\n—Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575051&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c76a9f87-45ce-461d-acf8-566f2488da55\', \'multiverseId\': 575051}, \'multiverseid\': 575051}, {\'name\': "Dispersion d\'essence", \'text\': \'Contrecarrez un sort de créature ciblé.\', \'type\': \'Éphémère\', \'flavor\': "« Les Phyrexians polluent tout ce qu\'ils touchent, alors la solution est simple : ne pas les laisser toucher quoi que ce soit. »\\n—Téfeiri", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575312&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'73d7acab-a4fa-4e29-8135-11644be7622c\', \'multiverseId\': 575312}, \'multiverseid\': 575312}, {\'name\': \'Disperdere Essenza\', \'text\': \'Neutralizza una magia creatura bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"I Phyrexiani corrompono tutto ciò che toccano, quindi la soluzione è semplice: non lasciare che tocchino nulla."\\n—Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575573&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'405f3242-2eef-4207-a463-853b51827329\', \'multiverseId\': 575573}, \'multiverseid\': 575573}, {\'name\': \'本質の散乱\', \'text\': \'クリーチャー・呪文１つを対象とする。それを打ち消す。\', \'type\': \'インスタント\', \'flavor\': \'「ファイレクシア人は触れるものをすべて穢す。だから解決策は単純だ。奴らに何も触れさせないことだ。」\\n――テフェリー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575834&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d248a71e-4510-4603-9025-609428387fda\', \'multiverseId\': 575834}, \'multiverseid\': 575834}, {\'name\': \'Espalhar Essência\', \'text\': \'Anule a mágica de criatura alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Os phyrexianos poluem tudo em que tocam, então a solução é simples: não os deixar tocar em nada."\\n— Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576356&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'64f445d2-728b-4d06-887e-342b2f25f0c9\', \'multiverseId\': 576356}, \'multiverseid\': 576356}, {\'name\': \'菁华离散\', \'text\': \'反击目标生物咒语。\', \'type\': \'瞬间\', \'flavor\': \'「非瑞克西亚人碰过的东西都会被污染，解决方案也很简单：别让他们碰任何东西。」\\n～泰菲力\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576878&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9aefe0db-bec4-4515-b0ed-cebc193e8292\', \'multiverseId\': 576878}, \'multiverseid\': 576878}]', "[{'name': 'Flammen des Sieges', 'text': 'Bonus {2}{U} (Du kannst zusätzlich {2}{U} bezahlen, sowie du diesen Zauberspruch wirkst.)\\nFalls die Bonuskosten dieses Zauberspruchs bezahlt wurden, ziehe eine Karte. Die Flammen des Sieges fügen einer Kreatur oder einem Planeswalker deiner Wahl so viele Schadenspunkte zu, wie du Karten auf deiner Hand hast.', 'type': 'Spontanzauber', 'flavor': 'Die Trommeln und Hörner waren zu erwarten, aber der Goblin-Tanz war eine nette Überraschung.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574864&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'ccf0e66f-d6ed-4016-aee8-9559f2e9e0ec', 'multiverseId': 574864}, 'multiverseid': 574864}, {'name': 'Fuegos de la victoria', 'text': 'Estímulo {2}{U}. (Puedes pagar {2}{U} adicionales al lanzar este hechizo.)\\nSi este hechizo fue estimulado, roba una carta. Los Fuegos de la victoria hacen una cantidad de daño a la criatura o planeswalker objetivo igual a la cantidad de cartas en tu mano.', 'type': 'Instantáneo', 'flavor': 'Esperábamos los tambores y los cuernos, pero el baile trasgo fue una sorpresa de lo más agradable.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575125&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e7b0f270-b51c-47fc-b263-1231562f1775', 'multiverseId': 575125}, 'multiverseid': 575125}, {'name': 'Feux de victoire', 'text': 'Kick {2}{U} (Vous pouvez payer {2}{U} supplémentaires au moment où vous lancez ce sort.)\\nSi ce sort a été kické, piochez une carte. Les Feux de victoire infligent à une cible, créature ou planeswalker, un nombre de blessures égal au nombre de cartes dans votre main.', 'type': 'Éphémère', 'flavor': 'Les tambours et les cors étaient plus ou moins prévus, mais la danse de gobelins était une surprise agréable.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575386&type=card', 'language': 'French', 'identifiers': {'scryfallId': '33d1fdc2-2a2e-4c14-ac1b-897b6c65195c', 'multiverseId': 575386}, 'multiverseid': 575386}, {'name': 'Falò della Vittoria', 'text': 'Potenziamento {2}{U} (Puoi pagare {2}{U} addizionale mentre lanci questa magia.)\\nSe questa magia è stata potenziata, pesca una carta. Il Falò della Vittoria infligge danno pari al numero di carte nella tua mano a una creatura o a un planeswalker bersaglio.', 'type': 'Istantaneo', 'flavor': 'I tamburi e i corni erano prevedibili, ma la danza dei goblin fu una piacevole sorpresa.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575647&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c76f8764-e411-4e7b-aebf-b1a9ca351662', 'multiverseId': 575647}, 'multiverseid': 575647}, {'name': '勝利の炎', 'text': 'キッカー{2}{U}（この呪文を唱えるに際し、追加で{2}{U}を支払ってもよい。）\\nクリーチャーやプレインズウォーカーのうち１体を対象とする。この呪文がキッカーされていたなら、カード１枚を引く。勝利の炎はそれに、あなたの手札にあるカードの枚数に等しい点数のダメージを与える。', 'type': 'インスタント', 'flavor': '太鼓と笛は期待していたものの、ゴブリンの踊りはうれしい誤算だった。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575908&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'cc134f3b-8e72-4325-a06c-8840cf59f641', 'multiverseId': 575908}, 'multiverseid': 575908}, {'name': 'Fogueira da Vitória', 'text': 'Reforçar {2}{U} (Você pode pagar um custo adicional de {2}{U} ao conjurar esta mágica.)\\nSe esta mágica foi reforçada, compre um card. Fogueira da Vitória causa à criatura ou ao planeswalker alvo uma quantidade de dano igual ao número de cards em sua mão.', 'type': 'Mágica Instantânea', 'flavor': 'Os tambores e as trompas já eram esperados, mas a dança dos goblins foi uma boa surpresa.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576430&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '57f4dd71-6e97-4792-bbde-f757dac966aa', 'multiverseId': 576430}, 'multiverseid': 576430}, {'name': '胜利烟火', 'text': '增幅{2}{U}（你施放此咒语时可以额外支付{2}{U}。）\\n如果此咒语已增幅，则抓一张牌。胜利烟火对目标生物或鹏洛客造成等同于你手牌数量的伤害。', 'type': '瞬间', 'flavor': '欢鼓齐鸣、号乐阵阵～传统庆祝方式悉数登场，而鬼怪舞蹈则更是意外之喜。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576952&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9a49ab15-facc-45e1-af40-5587225838f8', 'multiverseId': 576952}, 'multiverseid': 576952}]", '[{\'name\': \'Frontbrecher-Baloth\', \'text\': \'Abkommandieren (Sowie diese Kreatur angreift, kannst du eine nicht angreifende Kreatur ohne Einsatzverzögerung, die du kontrollierst, tappen. Wenn du dies tust, addiere ihre Stärke bis zum Ende des Zuges zur Stärke dieser Kreatur.)\\nDer Frontbrecher-Baloth kann von Kreaturen mit Stärke 2 oder weniger nicht geblockt werden.\', \'type\': \'Kreatur — Bestie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574909&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5b972a2d-4db9-476e-b432-d51d21cf6724\', \'multiverseId\': 574909}, \'multiverseid\': 574909}, {\'name\': \'Báloth rompelíneas\', \'text\': \'Reclutar. (En cuanto esta criatura ataque, puedes girar una criatura que controlas sin mareo de invocación que no esté atacando. Cuando lo hagas, añade su fuerza a la de esta criatura hasta el final del turno.)\\nEl Báloth rompelíneas no puede ser bloqueado por criaturas con fuerza de 2 o menos.\', \'type\': \'Criatura — Bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575170&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2253fe41-9598-4169-95e7-f48fd2cc4b2b\', \'multiverseId\': 575170}, \'multiverseid\': 575170}, {\'name\': \'Baloth briseur de ligne\', \'text\': "Enrôlement (Au moment où cette créature attaque, vous pouvez engager une créature non-attaquante que vous contrôlez sans mal d\'invocation. Quand vous faites ainsi, ajoutez sa force à celle de cette créature jusqu\'à la fin du tour.)\\nLe Baloth briseur de ligne ne peut pas être bloqué par des créatures de force inférieure ou égale à 2.", \'type\': \'Créature : bête\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575431&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fda24467-dc42-408b-ad98-b0efb4d3555e\', \'multiverseId\': 575431}, \'multiverseid\': 575431}, {\'name\': \'Baloth Tagliasentieri\', \'text\': \'Arruolare (Mentre questa creatura attacca, puoi TAPpare una creatura non attaccante che controlli non affetta da debolezza da evocazione. Quando lo fai, aggiungi la sua forza a quella di questa creatura fino alla fine del turno.)\\nIl Baloth Tagliasentieri non può essere bloccato da creature con forza pari o inferiore a 2.\', \'type\': \'Creatura — Bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575692&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7b02d0d4-f355-4cee-9ddb-be34c8bbaa98\', \'multiverseId\': 575692}, \'multiverseid\': 575692}, {\'name\': \'戦線破りのベイロス\', \'text\': \'後援（このクリーチャーが攻撃するに際し、あなたがコントロールしていて召喚酔いの影響を受けておらず攻撃してもいないクリーチャー１体をタップしてもよい。そうしたとき、ターン終了時まで、このクリーチャーのパワーにそのタップしたクリーチャーのパワーを足す。）\\n戦線破りのベイロスは、パワーが２以下のクリーチャーにはブロックされない。\', \'type\': \'クリーチャー — ビースト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575953&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1c58d901-ef2f-4051-9e9d-6fb611ca8bda\', \'multiverseId\': 575953}, \'multiverseid\': 575953}, {\'name\': \'Baloth Fura-linha\', \'text\': \'Alistar (Conforme esta criatura ataca, você pode virar uma criatura não atacante que você controla sem enjoo de invocação. Quando fizer isso, adicione o poder dela ao desta criatura até o final do turno.)\\nBaloth Fura-linha não pode ser bloqueado por criaturas de poder igual ou inferior a 2.\', \'type\': \'Criatura — Besta\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576475&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'649915b0-5bdc-4d5d-a0f3-9c11e7b45da5\', \'multiverseId\': 576475}, \'multiverseid\': 576475}, {\'name\': \'破阵巴洛西\', \'text\': \'征列（于此生物攻击时，你可以横置一个由你操控、不具召唤失调且未进行攻击的生物。当你如此作时，将所横置生物的力量加至此生物直到回合结束。）\\n破阵巴洛西不能被力量等于或小于2的生物阻挡。\', \'type\': \'生物 ～野兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576997&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0541db4f-1683-4026-8cfe-7c130a65f44d\', \'multiverseId\': 576997}, \'multiverseid\': 576997}]', '[{\'name\': \'Frostfaust-Schreiter\', \'text\': \'Abwehr {2} (Immer wenn diese Kreatur das Ziel eines Zauberspruchs oder einer Fähigkeit wird, den bzw. die ein Gegner kontrolliert, neutralisiere ihn bzw. sie, es sei denn, jener Spieler bezahlt {2}.)\\nWenn der Frostfaust-Schreiter ins Spiel kommt, tappe eine Kreatur deiner Wahl, die ein Gegner kontrolliert, und lege eine Betäubungsmarke auf sie. (Falls eine bleibende Karte mit Betäubungsmarke enttappt würde, entferne stattdessen eine davon.)\', \'type\': \'Kreatur — Elementarwesen, Riese\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574792&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'648e2b42-b8f4-48a2-86e2-5d5d74d01d11\', \'multiverseId\': 574792}, \'multiverseid\': 574792}, {\'name\': \'Montaraz puño escarchado\', \'text\': \'Rebatir {2}. (Siempre que esta criatura sea objetivo de un hechizo o habilidad que controla un oponente, contrarréstalo a menos que ese jugador pague {2}.)\\nCuando el Montaraz puño escarchado entre al campo de batalla, gira la criatura objetivo que controla un oponente y pon un contador de aturdimiento sobre ella. (Si un permanente con un contador de aturdimiento fuera a enderezarse, en vez de eso, remueve uno de esos contadores de él.)\', \'type\': \'Criatura — Gigante elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575053&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'26e98a6c-19bc-4c23-a514-27c5d99ec1e6\', \'multiverseId\': 575053}, \'multiverseid\': 575053}, {\'name\': \'Enjambeur poing-de-gel\', \'text\': "Parade {2} (À chaque fois que cette créature devient la cible d\'un sort ou d\'une capacité qu\'un adversaire contrôle, contrecarrez ce sort ou cette capacité à moins que ce joueur ne paie {2}.)\\nQuand l\'Enjambeur poing-de-gel arrive sur le champ de bataille, engagez une créature ciblée qu\'un adversaire contrôle et mettez un marqueur « étourdissement » sur elle. (Si un permanent avec un marqueur « étourdissement » devait devenir dégagé, retirez-lui en un à la place.)", \'type\': \'Créature : élémental et géant\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575314&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'59e7b08b-664c-43e0-8f33-8138bf108d68\', \'multiverseId\': 575314}, \'multiverseid\': 575314}, {\'name\': \'Ramingo dal Pugno Gelido\', \'text\': \'Egida {2} (Ogniqualvolta questa creatura diventa bersaglio di una magia o abilità controllata da un avversario, neutralizza quella magia o abilità a meno che quel giocatore non paghi {2}.)\\nQuando il Ramingo dal Pugno Gelido entra nel campo di battaglia, TAPpa una creatura bersaglio controllata da un avversario e metti un segnalino stordimento su di essa. (Se un permanente con un segnalino stordimento sta per essere STAPpato, rimuovi invece un segnalino stordimento da esso.)\', \'type\': \'Creatura — Gigante Elementale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575575&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'461071a9-0287-4123-a2b1-468f8a1ee31d\', \'multiverseId\': 575575}, \'multiverseid\': 575575}, {\'name\': \'霜拳の徘徊者\', \'text\': \'護法{2}（このクリーチャーが対戦相手がコントロールしている呪文や能力の対象になるたび、そのプレイヤーが{2}を支払わないかぎり、その呪文や能力を打ち消す。）\\n霜拳の徘徊者が戦場に出たとき、対戦相手がコントロールしているクリーチャー１体を対象とする。それをタップし、それの上に麻痺カウンター１個を置く。（麻痺カウンターが置かれたパーマネントがアンタップ状態になるなら、代わりにそれの上から麻痺カウンター１個を取り除く。）\', \'type\': \'クリーチャー — エレメンタル・巨人\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575836&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fc54876d-ba92-4596-8928-c92bf1e4d7f8\', \'multiverseId\': 575836}, \'multiverseid\': 575836}, {\'name\': \'Andarilho do Punho Gélido\', \'text\': \'Salvaguarda {2} (Toda vez que esta criatura se tornar alvo de uma mágica ou habilidade que um oponente controla, anule-a, a menos que aquele jogador pague {2}.)\\nQuando Andarilho do Punho Gélido entrar no campo de batalha, vire a criatura alvo que um oponente controla e coloque um marcador de atordoamento nela. (Se uma permanente com um marcador de atordoamento se tornaria desvirada, em vez disso, remova um marcador de atordoamento dela.)\', \'type\': \'Criatura — Elemental Gigante\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576358&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fb5979cd-51a9-4bbd-8a9d-b52ef065c21b\', \'multiverseId\': 576358}, \'multiverseid\': 576358}, {\'name\': \'霜拳神行客\', \'text\': \'守护{2}（每当此生物成为由对手操控之咒语或异能的目标时，除非该牌手支付{2}，否则反击之。）\\n当霜拳神行客进战场时，横置目标由对手操控的生物并在其上放置一个晕眩指示物。（如果某个其上有晕眩指示物的永久物将成为未横置，则改为从其上移去一个晕眩指示物。）\', \'type\': \'生物 ～元素／巨人\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576880&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f43f0d5c-457c-4136-9461-d07cbf2ecfad\', \'multiverseId\': 576880}, \'multiverseid\': 576880}]', '[{\'name\': \'Fäulniswalze\', \'text\': \'Verteidiger\\n{2}{B}, {T}: Jeder Gegner verliert X Lebenspunkte, wobei X gleich der Anzahl an Kreaturen mit Verteidiger ist, die du kontrollierst.\', \'type\': \'Kreatur — Phyrexianer\', \'flavor\': \'„Halte dich fern. Sie mag defekt sein, aber keineswegs gutartig."\\n—Stenn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574823&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cb20104c-90a3-40f3-82ad-dfcd99a78259\', \'multiverseId\': 574823}, \'multiverseid\': 574823}, {\'name\': \'Contenedor de la plaga\', \'text\': \'Defensor.\\n{2}{B}, {T}: Cada oponente pierde X vidas, donde X es la cantidad de criaturas con la habilidad de defensor que controlas.\', \'type\': \'Criatura — Pirexiano\', \'flavor\': \'"Mantén la distancia. Que esté roto no significa que sea inofensivo".\\n—Stenn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575084&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dd94eb72-5e39-41c5-bd8d-a10ec7a02bf4\', \'multiverseId\': 575084}, \'multiverseid\': 575084}, {\'name\': \'Tas de fléau\', \'text\': \'Défenseur\\n{2}{B}, {T} : Chaque adversaire perd X points de vie, X étant le nombre de créatures avec le défenseur que vous contrôlez.\', \'type\': \'Créature : phyrexian\', \'flavor\': "« Gardez vos distances. Il est peut-être endommagé, mais il n\'est pas pour autant inoffensif. »\\n—Stenn", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575345&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'47f60b65-f9a9-4c4b-9cc8-62c341b0deb9\', \'multiverseId\': 575345}, \'multiverseid\': 575345}, {\'name\': \'Batteria del Contagio\', \'text\': \'Difensore\\n{2}{B}, {T}: Ogni avversario perde X punti vita, dove X è il numero di creature con difensore che controlli.\', \'type\': \'Creatura — Phyrexiano\', \'flavor\': \'"Mantieni le distanze. Sarà anche rotta, ma di certo non è innocua."\\n—Stenn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575606&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2defb281-fbeb-47cb-aa17-ba806fede2e4\', \'multiverseId\': 575606}, \'multiverseid\': 575606}, {\'name\': \'荒廃の塊\', \'text\': \'防衛\\n{2}{B},{T}：各対戦相手はそれぞれＸ点のライフを失う。Ｘはあなたがコントロールしていて防衛を持つクリーチャーの数に等しい。\', \'type\': \'クリーチャー — ファイレクシアン\', \'flavor\': \'「距離を保て。故障しているかもしれんが、無害には程遠い。」\\n――ステン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575867&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3339ec25-8fd2-4a1d-b417-cad0c95df8fb\', \'multiverseId\': 575867}, \'multiverseid\': 575867}, {\'name\': \'Pilha de Praga\', \'text\': \'Defensor\\n{2}{B}, {T}: Cada oponente perde X pontos de vida, sendo X o número de criaturas com defensor que você controla.\', \'type\': \'Criatura — Phyrexiano\', \'flavor\': \'"Mantenha distância. Isso pode estar quebrado, mas está longe de ser inofensivo."\\n— Stenn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576389&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'64397cfb-c734-4071-a65e-969afc41840a\', \'multiverseId\': 576389}, \'multiverseid\': 576389}, {\'name\': \'枯萎堆垛\', \'text\': \'守军\\n{2}{B}，{T}：每位对手各失去X点生命，X为由你操控且具守军异能的生物数量。\', \'type\': \'生物 ～非瑞人\', \'flavor\': \'「保持距离。它或许坏了，但远没到无害的程度。」\\n～斯特恩\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576911&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fac42943-3f3d-41fa-9f93-8632d08092af\', \'multiverseId\': 576911}, \'multiverseid\': 576911}]', '[{\'name\': \'Gaeas Macht\', \'text\': \'Domäne — Eine Kreatur deiner Wahl erhält bis zum Ende des Zuges +1/+1 für jeden Standardlandtyp unter den Ländern, die du kontrollierst.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Warum sollten wir uns um das Holz im Stamm eines Baumes streiten, wenn seine Äste Platz genug für alle bieten?"\\n—Multani\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574905&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6b1e70bc-ff72-4af5-beb9-e836c3b13410\', \'multiverseId\': 574905}, \'multiverseid\': 574905}, {\'name\': \'Poderío de Gaia\', \'text\': \'Dominio — La criatura objetivo obtiene +1/+1 hasta el final del turno por cada tipo de tierra básica entre las tierras que controlas.\', \'type\': \'Instantáneo\', \'flavor\': \'"¿Por qué deberíamos luchar por la madera del tronco de un árbol si hay espacio para todos en sus ramas?".\\n—Multani\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575166&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0c38be40-ba2c-4c19-8f48-d5194cfb5e0b\', \'multiverseId\': 575166}, \'multiverseid\': 575166}, {\'name\': \'Puissance de Gaia\', \'text\': "Domaine — Une créature ciblée gagne +1/+1 jusqu\'à la fin du tour pour chaque type de terrain de base parmi les terrains que vous contrôlez.", \'type\': \'Éphémère\', \'flavor\': "« Pourquoi se battre pour un tronc d\'arbre quand ses branches ont suffisamment de place pour tous ? »\\n—Multani", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575427&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'71704f60-e262-4650-8580-6de98503dc6c\', \'multiverseId\': 575427}, \'multiverseid\': 575427}, {\'name\': \'Potenza di Gea\', \'text\': \'Dominio — Una creatura bersaglio prende +1/+1 fino alla fine del turno per ogni tipo di terra base tra le terre che controlli.\', \'type\': \'Istantaneo\', \'flavor\': \'"Perché combattere per il legno del tronco di un albero quando i suoi rami hanno spazio per tutti?"\\n—Multani\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575688&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'914ea4aa-c4b1-4d43-a650-00c9f7522c52\', \'multiverseId\': 575688}, \'multiverseid\': 575688}, {\'name\': \'ガイアの力\', \'text\': \'版図 ― クリーチャー１体を対象とする。ターン終了時まで、それはあなたがコントロールしている土地の中の基本土地タイプ１種類につき＋１/＋１の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'「なぜ先を争って樹の幹を切り開くのだ？ 枝の隙間に皆の居場所があるではないか。」\\n――ムルタニ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575949&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'81a65cb0-a0c2-4eed-b24e-92e58546d826\', \'multiverseId\': 575949}, \'multiverseid\': 575949}, {\'name\': \'Força de Gaia\', \'text\': \'Dominar — A criatura alvo recebe +1/+1 até o final do turno para cada tipo de terreno básico entre os terrenos que você controla.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Por que disputar a madeira do tronco de uma árvore quando seus galhos podem abrigar a todos?"\\n— Multani\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576471&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2ec79ab8-05c0-4c74-a9cc-fc3dd7dff8ec\', \'multiverseId\': 576471}, \'multiverseid\': 576471}, {\'name\': \'盖亚之力\', \'text\': \'领土～由你操控的地中每有一种基本地类别，目标生物便得+1/+1直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'「既然树枝上有足够的地方能容纳所有人，又何必为树干上的一块木头而争吵？」\\n～穆塔尼\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576993&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9305b3cc-c59d-41ea-a0d7-ae9fd5eb5027\', \'multiverseId\': 576993}, \'multiverseid\': 576993}]', '[{\'name\': \'Garna, Blutfaust von Keld\', \'text\': \'Immer wenn eine andere Kreatur, die du kontrollierst, stirbt, ziehst du eine Karte, falls die Kreatur angreifend war. Anderenfalls fügt Garna, Blutfaust von Keld, jedem Gegner 1 Schadenspunkt zu.\', \'type\': \'Legendäre Kreatur — Mensch, Berserker\', \'flavor\': \'„Mal sehen, wer mehr von ihnen tötet, Radha."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574941&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b804219a-057c-4ed3-9aee-20f409a904a2\', \'multiverseId\': 574941}, \'multiverseid\': 574941}, {\'name\': \'Garna, puñosangriento de Keld\', \'text\': \'Siempre que otra criatura que controlas muera, roba una carta si estaba atacando. De lo contrario, Garna, puñosangriento de Keld hace 1 punto de daño a cada oponente.\', \'type\': \'Criatura legendaria — Berserker humano\', \'flavor\': \'"A ver quién consigue más muertes, Radha".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575202&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bfdeb5ab-2283-4d49-8f2c-1eb442d630d2\', \'multiverseId\': 575202}, \'multiverseid\': 575202}, {\'name\': \'Garna, poing-de-sang de Keld\', \'text\': "À chaque fois qu\'une autre créature que vous contrôlez meurt, piochez une carte si elle attaquait. Sinon, Garna, poing-de-sang de Keld inflige 1 blessure à chaque adversaire.", \'type\': \'Créature légendaire : humain et berserker\', \'flavor\': \'« Voyons qui en tue le plus, Radha. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575463&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dccd1ca3-24ea-4d5b-9820-ee642f2adf4a\', \'multiverseId\': 575463}, \'multiverseid\': 575463}, {\'name\': \'Garna, Pugno Sanguinario di Keld\', \'text\': "Ogniqualvolta un\'altra creatura che controlli muore, pesca una carta se era attaccante. Altrimenti, Garna, Pugno Sanguinario di Keld infligge 1 danno a ogni avversario.", \'type\': \'Creatura Leggendaria — Berserker Umano\', \'flavor\': \'"Vediamo chi ne abbatte di più, Radha."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575724&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'70639e81-1f5f-482e-b5d8-bce4d22e49c0\', \'multiverseId\': 575724}, \'multiverseid\': 575724}, {\'name\': \'ケルドの血拳、ガルナ\', \'text\': \'あなたがコントロールしていてこれでないクリーチャー１体が死亡するたび、それが攻撃していたなら、カード１枚を引く。そうでないなら、ケルドの血拳、ガルナは各対戦相手にそれぞれ１点のダメージを与える。\', \'type\': \'伝説のクリーチャー — 人間・狂戦士\', \'flavor\': \'「ラーダ、誰がたくさん殺せるか勝負しよう。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575985&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'be272c0c-be9b-47f4-b210-45d0447ab0c6\', \'multiverseId\': 575985}, \'multiverseid\': 575985}, {\'name\': \'Garna, Punho Sangrento de Keld\', \'text\': \'Toda vez que outra criatura que você controla morrer, compre um card se ela estava atacando. Caso contrário, Garna, Punho Sangrento de Keld, causa 1 ponto de dano a cada oponente.\', \'type\': \'Criatura Lendária — Humano Amoque\', \'flavor\': \'"Radha, vamos ver quem mata mais."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576507&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1b35ad0c-271f-40e3-a984-99c3ab078a60\', \'multiverseId\': 576507}, \'multiverseid\': 576507}, {\'name\': \'凯尔顿血拳加娜\', \'text\': \'每当另一个由你操控的生物死去时，如果它正进行攻击，则抓一张牌。若否，则凯尔顿血拳加娜向每位对手各造成1点伤害。\', \'type\': \'传奇生物 ～人类／狂战士\', \'flavor\': \'「拉妲，我们来比比谁的人头更多。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577029&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'28014314-ca9c-4fa2-93d4-2f3c365de50e\', \'multiverseId\': 577029}, \'multiverseid\': 577029}]', '[{\'name\': \'Garna, Blutfaust von Keld\', \'text\': \'Immer wenn eine andere Kreatur, die du kontrollierst, stirbt, ziehst du eine Karte, falls die Kreatur angreifend war. Anderenfalls fügt Garna, Blutfaust von Keld, jedem Gegner 1 Schadenspunkt zu.\', \'type\': \'Legendäre Kreatur — Mensch, Berserker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577886&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'724996e7-3352-430e-84fb-8f2e2f9ebcef\', \'multiverseId\': 577886}, \'multiverseid\': 577886}, {\'name\': \'Garna, poing-de-sang de Keld\', \'text\': "À chaque fois qu\'une autre créature que vous contrôlez meurt, piochez une carte si elle attaquait. Sinon, Garna, poing-de-sang de Keld inflige 1 blessure à chaque adversaire.", \'type\': \'Créature légendaire : humain et berserker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577927&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d9583e8b-e254-4d1c-80c1-afead3429527\', \'multiverseId\': 577927}, \'multiverseid\': 577927}, {\'name\': \'ケルドの血拳、ガルナ\', \'text\': \'あなたがコントロールしていてこれでないクリーチャー１体が死亡するたび、それが攻撃していたなら、カード１枚を引く。そうでないなら、ケルドの血拳、ガルナは各対戦相手にそれぞれ１点のダメージを与える。\', \'type\': \'伝説のクリーチャー — 人間・狂戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577968&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4e065a2c-5762-47a0-9d8f-4dabc6767709\', \'multiverseId\': 577968}, \'multiverseid\': 577968}, {\'name\': \'凯尔顿血拳加娜\', \'text\': \'每当另一个由你操控的生物死去时，如果它正进行攻击，则抓一张牌。若否，则凯尔顿血拳加娜向每位对手各造成1点伤害。\', \'type\': \'传奇生物 ～人类／狂战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578009&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ab1a7384-94a2-4e3e-a21c-77bec42ac910\', \'multiverseId\': 578009}, \'multiverseid\': 578009}]', '[{\'name\': \'Garna, Blutfaust von Keld\', \'text\': \'Immer wenn eine andere Kreatur, die du kontrollierst, stirbt, ziehst du eine Karte, falls die Kreatur angreifend war. Anderenfalls fügt Garna, Blutfaust von Keld, jedem Gegner 1 Schadenspunkt zu.\', \'type\': \'Legendäre Kreatur — Mensch, Berserker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578093&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'05fccc04-3e47-4ddd-bb9b-0d2f52e2c1cf\', \'multiverseId\': 578093}, \'multiverseid\': 578093}, {\'name\': \'Garna, puñosangriento de Keld\', \'text\': \'Siempre que otra criatura que controlas muera, roba una carta si estaba atacando. De lo contrario, Garna, puñosangriento de Keld hace 1 punto de daño a cada oponente.\', \'type\': \'Criatura legendaria — Berserker humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578134&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4dcfbb28-20f6-40e9-b3a0-18017b65996d\', \'multiverseId\': 578134}, \'multiverseid\': 578134}, {\'name\': \'Garna, poing-de-sang de Keld\', \'text\': "À chaque fois qu\'une autre créature que vous contrôlez meurt, piochez une carte si elle attaquait. Sinon, Garna, poing-de-sang de Keld inflige 1 blessure à chaque adversaire.", \'type\': \'Créature légendaire : humain et berserker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578175&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7aa7b19d-b294-49ff-a256-92e69b05938b\', \'multiverseId\': 578175}, \'multiverseid\': 578175}, {\'name\': \'Garna, Pugno Sanguinario di Keld\', \'text\': "Ogniqualvolta un\'altra creatura che controlli muore, pesca una carta se era attaccante. Altrimenti, Garna, Pugno Sanguinario di Keld infligge 1 danno a ogni avversario.", \'type\': \'Creatura Leggendaria — Berserker Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578216&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a7fc7190-04f5-454b-9625-c6f674444ebc\', \'multiverseId\': 578216}, \'multiverseid\': 578216}, {\'name\': \'ケルドの血拳、ガルナ\', \'text\': \'あなたがコントロールしていてこれでないクリーチャー１体が死亡するたび、それが攻撃していたなら、カード１枚を引く。そうでないなら、ケルドの血拳、ガルナは各対戦相手にそれぞれ１点のダメージを与える。\', \'type\': \'伝説のクリーチャー — 人間・狂戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578257&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4ff6a59f-e053-4672-a1b7-1a9d4c242f73\', \'multiverseId\': 578257}, \'multiverseid\': 578257}, {\'name\': \'Garna, Punho Sangrento de Keld\', \'text\': \'Toda vez que outra criatura que você controla morrer, compre um card se ela estava atacando. Caso contrário, Garna, Punho Sangrento de Keld, causa 1 ponto de dano a cada oponente.\', \'type\': \'Criatura Lendária — Humano Amoque\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578339&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7c5a61e3-23b5-470c-901b-c21fa17efee7\', \'multiverseId\': 578339}, \'multiverseid\': 578339}, {\'name\': \'凯尔顿血拳加娜\', \'text\': \'每当另一个由你操控的生物死去时，如果它正进行攻击，则抓一张牌。若否，则凯尔顿血拳加娜向每位对手各造成1点伤害。\', \'type\': \'传奇生物 ～人类／狂战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578421&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'37cccf6c-6936-4a47-8349-577693f05145\', \'multiverseId\': 578421}, \'multiverseid\': 578421}]', '[{\'name\': \'Gebet der Bindung\', \'text\': \'Aufblitzen\\nWenn das Gebet der Bindung ins Spiel kommt, schicke bis zu eine bleibende Karte deiner Wahl, die kein Land ist und die ein Gegner kontrolliert, ins Exil, bis das Gebet der Bindung das Spiel verlässt. Du erhältst 2 Lebenspunkte dazu.\', \'type\': \'Verzauberung\', \'flavor\': \'Wenn ein phyrexianischer Agent nicht getötet werden kann, muss er eingesperrt werden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574769&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'be718030-c658-46ba-bd0f-c57078d77a94\', \'multiverseId\': 574769}, \'multiverseid\': 574769}, {\'name\': \'Plegaria vinculante\', \'text\': \'Destello.\\nCuando la Plegaria vinculante entre al campo de batalla, exilia hasta un permanente objetivo que no sea tierra que controla un oponente hasta que la Plegaria vinculante deje el campo de batalla. Ganas 2 vidas.\', \'type\': \'Encantamiento\', \'flavor\': \'Si no se puede eliminar a un agente pirexiano, es necesario contenerlo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575030&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'106df5af-e0da-4037-99f4-dd50e3a7ff72\', \'multiverseId\': 575030}, \'multiverseid\': 575030}, {\'name\': "Prière d\'emprisonnement", \'text\': "Flash\\nQuand la Prière d\'emprisonnement arrive sur le champ de bataille, exilez jusqu\'à un permanent non-terrain ciblé qu\'un adversaire contrôle jusqu\'à ce que la Prière d\'emprisonnement quitte le champ de bataille. Vous gagnez 2 points de vie.", \'type\': \'Enchantement\', \'flavor\': \'Quand un agent phyrexian ne peut pas être tué, il doit être immobilisé.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575291&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e8f46cd4-28e0-4ff9-a8aa-f20d76322f67\', \'multiverseId\': 575291}, \'multiverseid\': 575291}, {\'name\': \'Preghiera Vincolante\', \'text\': \'Lampo\\nQuando la Preghiera Vincolante entra nel campo di battaglia, esilia fino a un permanente non terra bersaglio controllato da un avversario finché la Preghiera Vincolante non lascia il campo di battaglia. Guadagni 2 punti vita.\', \'type\': \'Incantesimo\', \'flavor\': \'Quando un agente Phyrexiano non può essere ucciso, deve essere contenuto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575552&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e3f406e4-0221-4265-b399-de907c3c8e35\', \'multiverseId\': 575552}, \'multiverseid\': 575552}, {\'name\': \'束縛の祈り手\', \'text\': \'瞬速\\n束縛の祈り手が戦場に出たとき、対戦相手がコントロールしていて土地でないパーマネント最大１つを対象とする。それを、束縛の祈り手が戦場を離れるまで追放する。あなたは２点のライフを得る。\', \'type\': \'エンチャント\', \'flavor\': \'ファイレクシア人の工作員が殺せないなら、収容するしかない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575813&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'35ccf59f-e987-4414-a5dd-2492b257167e\', \'multiverseId\': 575813}, \'multiverseid\': 575813}, {\'name\': \'Oração do Aprisionamento\', \'text\': \'Lampejo\\nQuando Oração do Aprisionamento entrar no campo de batalha, exile até uma permanente alvo não de terreno que um oponente controla até que Oração do Aprisionamento deixe o campo de batalha. Você ganha 2 pontos de vida.\', \'type\': \'Encantamento\', \'flavor\': \'Quando um agente phyrexiano não pode ser morto, ele precisa ser contido.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576335&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0722d103-7c9d-43ac-814b-b8be9fadf72c\', \'multiverseId\': 576335}, \'multiverseid\': 576335}, {\'name\': \'束缚祷文\', \'text\': \'闪现\\n当束缚祷文进战场时，放逐至多一个目标由对手操控的非地永久物，直到束缚祷文离开战场为止。你获得2点生命。\', \'type\': \'结界\', \'flavor\': \'既然杀不尽非瑞克西亚密探，就必须能将之看住。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576857&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dbcac1c8-38d5-4d1a-8a54-7d233dfdb0ff\', \'multiverseId\': 576857}, \'multiverseid\': 576857}]', '[{\'name\': \'Gebietstreuer Maro\', \'text\': \'Domäne — Stärke und Widerstandskraft des Gebietstreuen Maro sind gleich der doppelten Anzahl an Standardlandtypen unter den Ländern, die du kontrollierst.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'Die Koalition war mehr als nur Verträge und Allianzen: Sie war die Seele einer Welt, die sich gegen die eindringende Flut erhob.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574925&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'84a56267-e497-481d-8296-fed87c3603b9\', \'multiverseId\': 574925}, \'multiverseid\': 574925}, {\'name\': \'Maro territorial\', \'text\': \'Dominio — Tanto la fuerza como la resistencia del Maro territorial son iguales al doble de la cantidad de tipos de tierra básica entre las tierras que controlas.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'La Coalición iba más allá de meros tratados y alianzas: era el alma de un mundo que se alzaba contra la oleada invasora.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575186&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'04ddb746-c84e-4282-a203-7b75d5d3a1b2\', \'multiverseId\': 575186}, \'multiverseid\': 575186}, {\'name\': \'Maro territorial\', \'text\': "Domaine — La force et l\'endurance du Maro territorial sont chacune égales au double du nombre de types de terrain de base parmi les terrains que vous contrôlez.", \'type\': \'Créature : élémental\', \'flavor\': "La Coalition représentait bien plus que des traités et des alliances : c\'était l\'âme d\'un monde qui se soulevait pour lutter contre l\'envahisseur.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575447&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'eb0d4973-2760-4707-9816-19cd54dd80f1\', \'multiverseId\': 575447}, \'multiverseid\': 575447}, {\'name\': \'Maro Territoriale\', \'text\': \'Dominio — La forza e la costituzione del Maro Territoriale sono pari al doppio del numero di tipi di terra base tra le terre che controlli.\', \'type\': \'Creatura — Elementale\', \'flavor\': "La Coalizione era molto più che trattati e alleanze: era l\'anima di un mondo che si ribellava a un\'invasione.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575708&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bfc8bf85-b793-47d0-a245-0139b917ec73\', \'multiverseId\': 575708}, \'multiverseid\': 575708}, {\'name\': \'属地のマロー\', \'text\': \'版図 ― 属地のマローのパワーとタフネスはそれぞれ、あなたがコントロールしている土地の中の基本土地タイプの種類数の２倍に等しい。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'連合はただの条約や同盟ではなかった。押し寄せる侵略者に対して立ち上がった世界の魂だったのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575969&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'090a66f5-5a31-4175-8956-eddb1b73c813\', \'multiverseId\': 575969}, \'multiverseid\': 575969}, {\'name\': \'Maro Territorial\', \'text\': \'Dominar — O poder e a resistência de Maro Territorial são ambos iguais ao dobro do número de tipos de terreno básico entre os terrenos que você controla.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'A Coalizão era mais que tratados e alianças: era a alma de um mundo se erguendo contra a maré invasora.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576491&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'371d3b73-0ac7-40c0-b42c-c9b8038d7187\', \'multiverseId\': 576491}, \'multiverseid\': 576491}, {\'name\': \'据地玛洛\', \'text\': \'领土～据地玛洛的力量和防御力各等同于由你操控之地中基本地类别数量的两倍。\', \'type\': \'生物 ～元素\', \'flavor\': \'多明联盟并非只是协定与联合：而是世界之灵面对侵攻浪潮的团结与抗争。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577013&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'aa9b249b-25d3-4720-9542-44b34cb72c8d\', \'multiverseId\': 577013}, \'multiverseid\': 577013}]', "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578499&type=card', 'language': 'German', 'identifiers': {'scryfallId': '3c515698-1a00-46a8-8e8b-edcf43d03f7c', 'multiverseId': 578499}, 'multiverseid': 578499}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578504&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5918154f-1a06-43e8-88ae-ff52de4512f2', 'multiverseId': 578504}, 'multiverseid': 578504}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578509&type=card', 'language': 'French', 'identifiers': {'scryfallId': '72e8ff20-1b79-4c10-a3b9-18d68080f61d', 'multiverseId': 578509}, 'multiverseid': 578509}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578514&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'd7119804-823f-4bc9-98f4-a67578d09e62', 'multiverseId': 578514}, 'multiverseid': 578514}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578519&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '8c08e2da-2a43-4033-91a1-a40cb19a74ce', 'multiverseId': 578519}, 'multiverseid': 578519}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578529&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0919e40a-6e81-4aa6-8917-739017ab4e56', 'multiverseId': 578529}, 'multiverseid': 578529}, {'name': '山脉', 'type': '基本地 ～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578539&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9d0fde77-1ea4-4375-a6c0-b751e464c63a', 'multiverseId': 578539}, 'multiverseid': 578539}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578570&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd0025ec5-b43c-438f-866c-1d4562e6c37b', 'multiverseId': 578570}, 'multiverseid': 578570}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578585&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '32b33f45-0e1e-425f-9034-1d620e32834a', 'multiverseId': 578585}, 'multiverseid': 578585}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578600&type=card', 'language': 'French', 'identifiers': {'scryfallId': '6b00b1c3-b295-4855-9eca-f5027bd169fb', 'multiverseId': 578600}, 'multiverseid': 578600}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578615&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '754e116d-3096-477f-a2fb-f7f3d1fd1f7a', 'multiverseId': 578615}, 'multiverseid': 578615}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578630&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '7cc95c9e-90c7-4409-a322-fc96fafaa613', 'multiverseId': 578630}, 'multiverseid': 578630}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578660&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8d2bb9d3-b589-4b75-9a42-4ec45b2c7147', 'multiverseId': 578660}, 'multiverseid': 578660}, {'name': '山脉', 'type': '基本地 ～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578690&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b4b35588-aba7-4842-b411-231749e4a720', 'multiverseId': 578690}, 'multiverseid': 578690}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578571&type=card', 'language': 'German', 'identifiers': {'scryfallId': '408a3172-73b0-41ba-8782-d8e4075c4858', 'multiverseId': 578571}, 'multiverseid': 578571}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578586&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'aa3afe42-fe6e-431e-b046-60a2a0a66aab', 'multiverseId': 578586}, 'multiverseid': 578586}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578601&type=card', 'language': 'French', 'identifiers': {'scryfallId': '501d4a43-ca20-4133-9071-e162d368b53b', 'multiverseId': 578601}, 'multiverseid': 578601}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578616&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '68eadd01-df22-4288-8bdc-e4c344d756fb', 'multiverseId': 578616}, 'multiverseid': 578616}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578631&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '6d50c838-1fbb-4230-b107-a0101381ade3', 'multiverseId': 578631}, 'multiverseid': 578631}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578661&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '70fc6fe4-2f6a-44c5-972d-f226c8d5c199', 'multiverseId': 578661}, 'multiverseid': 578661}, {'name': '山脉', 'type': '基本地 ～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578691&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '3663008a-d4b8-4322-93fd-0e0dcc955eb1', 'multiverseId': 578691}, 'multiverseid': 578691}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578572&type=card', 'language': 'German', 'identifiers': {'scryfallId': '68726dc0-d8ac-45a1-bf48-66da76b589d5', 'multiverseId': 578572}, 'multiverseid': 578572}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578587&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5a966829-c3f8-4be9-b3f0-0e4f6cffaf8f', 'multiverseId': 578587}, 'multiverseid': 578587}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578602&type=card', 'language': 'French', 'identifiers': {'scryfallId': '9ab2055a-7d1e-48c2-9d37-491793f62e70', 'multiverseId': 578602}, 'multiverseid': 578602}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578617&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '6ab4bc69-467e-4fb8-b266-df36329b36e5', 'multiverseId': 578617}, 'multiverseid': 578617}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578632&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '24657c9e-d70f-4768-a6ff-bc7c9aa1be27', 'multiverseId': 578632}, 'multiverseid': 578632}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578662&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '16c1c844-22e6-419d-88ee-27220b78e41e', 'multiverseId': 578662}, 'multiverseid': 578662}, {'name': '山脉', 'type': '基本地 ～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578692&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '4ef82bd9-2c03-415f-b7ab-2b5869b9c400', 'multiverseId': 578692}, 'multiverseid': 578692}]", '[{\'name\': \'Geborgener Mana-Arbeiter\', \'text\': \'{1}: Erzeuge ein Mana einer beliebigen Farbe. Aktiviere diese Fähigkeit nur einmal pro Zug.\', \'type\': \'Artefaktkreatur — Konstrukt\', \'flavor\': \'„Wenn Kriegswaffen für friedliche Zwecke genutzt werden, weißt du, dass die Gesellschaft Fortschritte gemacht hat."\\n—Jodah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574978&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'69aba12d-bfd6-4880-a002-7f92d8c56737\', \'multiverseId\': 574978}, \'multiverseid\': 574978}, {\'name\': \'Autómata de maná recuperado\', \'text\': \'{1}: Agrega un maná de cualquier color. Activa esto solo una vez por turno.\', \'type\': \'Criatura artefacto — Constructo\', \'flavor\': \'"Cuando las armas militares se reacondicionan para fines pacíficos, sabes que la sociedad avanza por fin".\\n—Jodah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575239&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'524a0632-f686-4cb9-bcac-a26f78b2b406\', \'multiverseId\': 575239}, \'multiverseid\': 575239}, {\'name\': \'Ouvrier de mana de récupération\', \'text\': "{1} : Ajoutez un mana de la couleur de votre choix. N\'activez qu\'une seule fois par tour.", \'type\': \'Créature-artefact : construction\', \'flavor\': \'« Lorsque des armes de guerre sont recyclées à des fins pacifiques, vous savez que la société a progressé. »\\n—Jodah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575500&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'db347880-2f96-450c-bf49-e132f99ed498\', \'multiverseId\': 575500}, \'multiverseid\': 575500}, {\'name\': \'Manautoma di Recupero\', \'text\': \'{1}: Aggiungi un mana di un qualsiasi colore. Attiva solo una volta per turno.\', \'type\': \'Creatura Artefatto — Costrutto\', \'flavor\': \'"Quando le armi da guerra vengono riutilizzate per fini pacifici, significa che la società sta progredendo."\\n—Jodah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575761&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'27717915-692b-4895-b4e6-1f4622fa69eb\', \'multiverseId\': 575761}, \'multiverseid\': 575761}, {\'name\': \'発掘されたマナ労働機\', \'text\': \'{1}：好きな色１色のマナ１点を加える。毎ターン１回しか起動できない。\', \'type\': \'アーティファクト・クリーチャー — 構築物\', \'flavor\': \'「戦争の武器が平和目的で再利用される、それが社会の前進の証だ。」\\n――ジョダー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576022&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'aadca085-2224-45ee-94f4-585a7eb78240\', \'multiverseId\': 576022}, \'multiverseid\': 576022}, {\'name\': \'Operário a Mana Reciclado\', \'text\': \'{1}: Adicione um mana de qualquer cor. Ative apenas uma vez a cada turno.\', \'type\': \'Criatura Artefato — Constructo\', \'flavor\': \'"Quando armas de guerra são reaproveitadas para fins pacíficos, você sabe que a sociedade avançou."\\n— Jodah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576544&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'685e6010-ecc1-460f-8e6a-201f0cdd495a\', \'multiverseId\': 576544}, \'multiverseid\': 576544}, {\'name\': \'回收魔力工人\', \'text\': \'{1}：加一点任意颜色的法术力。每回合只能起动一次。\', \'type\': \'神器生物 ～组构体\', \'flavor\': \'「当战争兵器被改造用于和平用途后，你就知道社会已然进步。」\\n～裘达\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577066&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4bfded9c-cffb-4b4e-bc69-daf6cc8ae185\', \'multiverseId\': 577066}, \'multiverseid\': 577066}]', '[{\'name\': \'Gebrochene Flügel\', \'text\': \'Zerstöre ein Artefakt, eine Verzauberung oder eine fliegende Kreatur deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Serra lenkt unsere Schüsse ins Ziel. Außerdem habe ich gerade die Kanonen neu justiert."\\n—Tiana\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574898&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'93d510d4-b6a6-4d98-8e36-eb997bc78a09\', \'multiverseId\': 574898}, \'multiverseid\': 574898}, {\'name\': \'Alas rotas\', \'text\': \'Destruye el artefacto, encantamiento o criatura con la habilidad de volar objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Gracias a Serra, siempre damos en el blanco. Además, los arreglillos que hice a los cañones también ayudan".\\n—Tiana\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575159&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'35556da2-3f82-4d5d-92e5-de8c621ccd84\', \'multiverseId\': 575159}, \'multiverseid\': 575159}, {\'name\': \'Ailes brisées\', \'text\': \'Détruisez une cible, artefact, enchantement ou créature avec le vol.\', \'type\': \'Éphémère\', \'flavor\': "« Serra guide notre visée. Et j\'ai aussi réglé les canons. »\\n—Tiana", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575420&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'713c9969-0f10-4638-8fe4-4143e4124435\', \'multiverseId\': 575420}, \'multiverseid\': 575420}, {\'name\': \'Ali Spezzate\', \'text\': \'Distruggi un artefatto, un incantesimo o una creatura con volare bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Serra guida la nostra mira. Ma ho anche appena calibrato i cannoni."\\n—Tiana\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575681&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'472085c5-6b11-4dfa-8c19-4a6e47f52b09\', \'multiverseId\': 575681}, \'multiverseid\': 575681}, {\'name\': \'壊れた翼\', \'text\': \'飛行を持つクリーチャーやアーティファクトやエンチャントのうち１つを対象とする。それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'「我々の砲撃にはセラのご加護があります。砲の整備も私が今したところですし。」\\n――ティアナ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575942&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cb908589-bb20-4b2f-86f2-0ac11e468c26\', \'multiverseId\': 575942}, \'multiverseid\': 575942}, {\'name\': \'Asas Quebradas\', \'text\': \'Destrua o artefato, o encantamento ou a criatura com voar alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Serra guia nossa mira. Mas eu também dei uma calibradinha nos canhões."\\n— Tiana\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576464&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f40671bb-84e2-4656-94c4-a680ee1adf4f\', \'multiverseId\': 576464}, \'multiverseid\': 576464}, {\'name\': \'翅翼断裂\', \'text\': \'消灭目标神器，结界或具飞行异能的生物。\', \'type\': \'瞬间\', \'flavor\': \'「撒拉保佑我们百发百中。另外，我刚刚还调校了一下火力。」\\n～蒂娅娜\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576986&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e3682ebf-5c9f-4870-ac18-228561e5a4cb\', \'multiverseId\': 576986}, \'multiverseid\': 576986}]', '[{\'name\': \'Gedenkplatz der Helden\', \'text\': \'{T}: Erzeuge {C}.\\n{T}: Erzeuge ein Mana einer beliebigen Farbe. Gib dieses Mana nur aus, um einen legendären Zauberspruch zu wirken.\\n{T}: Erzeuge ein Mana einer beliebigen Farbe einer legendären bleibenden Karte, die du kontrollierst.\\n{3}, {T}, schicke den Gedenkplatz der Helden ins Exil: Eine legendäre Kreatur deiner Wahl erhält Fluchsicherheit und Unzerstörbarkeit bis zum Ende des Zuges.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574993&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'13e8502b-c2c3-493b-bb5f-0a9a5f2bb45e\', \'multiverseId\': 574993}, \'multiverseid\': 574993}, {\'name\': \'Plaza de los héroes\', \'text\': \'{T}: Agrega {C}.\\n{T}: Agrega un maná de cualquier color. Usa este maná solo para lanzar un hechizo legendario.\\n{T}: Agrega un maná de cualquier color entre los permanentes legendarios que controlas.\\n{3}, {T}, exiliar la Plaza de los héroes: La criatura legendaria objetivo gana las habilidades de antimaleficio e indestructible hasta el final del turno.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575254&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1c44a324-10d0-4a02-9e1d-8414cbb79115\', \'multiverseId\': 575254}, \'multiverseid\': 575254}, {\'name\': \'Esplanade des héros\', \'text\': "{T} : Ajoutez {C}.\\n{T} : Ajoutez un mana de la couleur de votre choix. Ne dépensez ce mana que pour lancer un sort légendaire.\\n{T} : Ajoutez un mana de la couleur de votre choix parmi les couleurs des permanents légendaires que vous contrôlez.\\n{3}, {T}, exilez l\'Esplanade des héros : une créature légendaire ciblée acquiert la défense talismanique et l\'indestructible jusqu\'à la fin du tour.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575515&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2f111b43-b674-4aca-a2d9-f32a77f306cc\', \'multiverseId\': 575515}, \'multiverseid\': 575515}, {\'name\': \'Piazza degli Eroi\', \'text\': \'{T}: Aggiungi {C}.\\n{T}: Aggiungi un mana di un qualsiasi colore. Spendi questo mana solo per lanciare una magia leggendaria.\\n{T}: Aggiungi un mana di un qualsiasi colore tra i permanenti leggendari che controlli.\\n{3}, {T}, Esilia la Piazza degli Eroi: Una creatura leggendaria bersaglio ha anti-malocchio e indistruttibile fino alla fine del turno.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575776&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'170feb7a-af35-4029-92f0-51e35b72536d\', \'multiverseId\': 575776}, \'multiverseid\': 575776}, {\'name\': \'英雄の公有地\', \'text\': \'{T}：{C}を加える。\\n{T}：好きな色１色のマナ１点を加える。このマナは、伝説の呪文を唱えるためにしか支払えない。\\n{T}：あなたがコントロールしている伝説のパーマネントの中の色１色のマナ１点を加える。\\n{3},{T},英雄の公有地を追放する：伝説のクリーチャー１体を対象とする。ターン終了時まで、それは呪禁と破壊不能を得る。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576037&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'709cd7f0-1637-4292-8730-312bf90556e2\', \'multiverseId\': 576037}, \'multiverseid\': 576037}, {\'name\': \'Praça dos Heróis\', \'text\': \'{T}: Adicione {C}.\\n{T}: Adicione um mana de qualquer cor. Gaste este mana somente para conjurar uma mágica lendária.\\n{T}: Adicione um mana de qualquer cor entre as permanentes lendárias que você controla.\\n{3}, {T}, exile Praça dos Heróis: A criatura lendária alvo ganha resistência a magia e indestrutível até o final do turno.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576559&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e829c85c-ef39-42ae-86eb-f7888f8216b1\', \'multiverseId\': 576559}, \'multiverseid\': 576559}, {\'name\': \'群英广场\', \'text\': \'{T}：加{C}。\\n{T}：加一点任意颜色的法术力。此法术力只能用来施放传奇咒语。\\n{T}：加一点法术力，其颜色为由你操控之传奇永久物所具有的任一颜色。\\n{3}，{T}，放逐群英广场：目标传奇生物获得辟邪与不灭异能直到回合结束。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577081&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'140a7fab-3590-44c7-a012-328a94af2fdb\', \'multiverseId\': 577081}, \'multiverseid\': 577081}]', '[{\'name\': \'Gedenkplatz der Helden\', \'text\': \'{T}: Erzeuge {C}.\\n{T}: Erzeuge ein Mana einer beliebigen Farbe. Gib dieses Mana nur aus, um einen legendären Zauberspruch zu wirken.\\n{T}: Erzeuge ein Mana einer beliebigen Farbe einer legendären bleibenden Karte, die du kontrollierst.\\n{3}, {T}, schicke den Gedenkplatz der Helden ins Exil: Eine legendäre Kreatur deiner Wahl erhält Fluchsicherheit und Unzerstörbarkeit bis zum Ende des Zuges.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577576&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5d0367a4-eae6-4e7e-99e0-8c183d1a9fd9\', \'multiverseId\': 577576}, \'multiverseid\': 577576}, {\'name\': \'Esplanade des héros\', \'text\': "{T} : Ajoutez {C}.\\n{T} : Ajoutez un mana de la couleur de votre choix. Ne dépensez ce mana que pour lancer un sort légendaire.\\n{T} : Ajoutez un mana de la couleur de votre choix parmi les couleurs des permanents légendaires que vous contrôlez.\\n{3}, {T}, exilez l\'Esplanade des héros : une créature légendaire ciblée acquiert la défense talismanique et l\'indestructible jusqu\'à la fin du tour.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577616&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3cf0885b-0aa3-42e2-a7bf-bd1085e23c5f\', \'multiverseId\': 577616}, \'multiverseid\': 577616}, {\'name\': \'英雄の公有地\', \'text\': \'{T}：{C}を加える。\\n{T}：好きな色１色のマナ１点を加える。このマナは、伝説の呪文を唱えるためにしか支払えない。\\n{T}：あなたがコントロールしている伝説のパーマネントの中の色１色のマナ１点を加える。\\n{3},{T},英雄の公有地を追放する：伝説のクリーチャー１体を対象とする。ターン終了時まで、それは呪禁と破壊不能を得る。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577656&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2b58cf92-bf23-49c0-912f-1124f820c7d8\', \'multiverseId\': 577656}, \'multiverseid\': 577656}, {\'name\': \'群英广场\', \'text\': \'{T}：加{C}。\\n{T}：加一点任意颜色的法术力。此法术力只能用来施放传奇咒语。\\n{T}：加一点法术力，其颜色为由你操控之传奇永久物所具有的任一颜色。\\n{3}，{T}，放逐群英广场：目标传奇生物获得辟邪与不灭异能直到回合结束。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577696&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4caafc80-bde6-4d2d-a8e9-e28f7e139fb3\', \'multiverseId\': 577696}, \'multiverseid\': 577696}]', '[{\'name\': \'Geifernde Barrikade\', \'text\': \'Verteidiger\\n{2}{B}, opfere eine Kreatur: Du erhältst 1 Lebenspunkt dazu und ziehst eine Karte.\', \'type\': \'Kreatur — Nachtmahr, Mauer\', \'flavor\': \'„Wer braucht Steinmauern, wenn man sich hinter einer undurchdringlichen Barriere aus schreienden Nachtmahren verstecken kann?"\\n—Braids\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574836&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7649a5a5-91b9-4085-8cd5-dd07139b2f3a\', \'multiverseId\': 574836}, \'multiverseid\': 574836}, {\'name\': \'Barricada quejumbrosa\', \'text\': \'Defensor.\\n{2}{B}, sacrificar una criatura: Ganas 1 vida y robas una carta.\', \'type\': \'Criatura — Muro pesadilla\', \'flavor\': \'"¿Para qué quieres murallas de piedra cuando puedes esconderte detrás de una barrera infranqueable de pesadillas ensordecedoras?".\\n—Trenzas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575097&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d9054d2f-7819-462a-9705-2d852bd38e17\', \'multiverseId\': 575097}, \'multiverseid\': 575097}, {\'name\': \'Barricade ricanante\', \'text\': \'Défenseur\\n{2}{B}, sacrifiez une créature : Vous gagnez 1 point de vie et vous piochez une carte.\', \'type\': \'Créature : cauchemar et mur\', \'flavor\': \'« À quoi bon un mur de pierre quand on peut se cacher derrière une barrière impénétrable de cauchemars hurlants ? »\\n—Nattes\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575358&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a07b0c45-9d7c-4a3b-bdbd-58cf0c06b4de\', \'multiverseId\': 575358}, \'multiverseid\': 575358}, {\'name\': \'Barricata Farfugliante\', \'text\': \'Difensore\\n{2}{B}, Sacrifica una creatura: Guadagni 1 punto vita e peschi una carta.\', \'type\': \'Creatura — Muro Incubo\', \'flavor\': \'"A chi servono le mura di pietra quando puoi nasconderti dietro una barriera impenetrabile di incubi urlanti?"\\n—Braids\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575619&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'18fe1787-582f-4125-a07f-48261239f213\', \'multiverseId\': 575619}, \'multiverseid\': 575619}, {\'name\': \'囈語のバリケード\', \'text\': \'防衛\\n{2}{B},クリーチャー１体を生け贄に捧げる：あなたは１点のライフを得、カード１枚を引く。\', \'type\': \'クリーチャー — ナイトメア・壁\', \'flavor\': \'「泣き叫ぶ悪夢でできた、何人たりとも通さない壁があるなら、石の壁なんていらないだろう？」\\n――ブレイズ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575880&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1b91260d-ca33-4ea5-9052-51f87e50686d\', \'multiverseId\': 575880}, \'multiverseid\': 575880}, {\'name\': \'Barricada de Murmúrios\', \'text\': \'Defensor\\n{2}{B}, sacrifique uma criatura: Você ganha 1 ponto de vida e compra um card.\', \'type\': \'Criatura — Pesadelo Barreira\', \'flavor\': \'"Quem precisa de muralhas de pedra quando você pode se esconder atrás de uma barreira impenetrável de pesadelos a gritar?"\\n— Braids\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576402&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'20b32c14-c845-4dd4-b13f-d27ee9d44da1\', \'multiverseId\': 576402}, \'multiverseid\': 576402}, {\'name\': \'妄语屏障\', \'text\': \'守军\\n{2}{B}，牺牲一个生物：你获得1点生命且抓一张牌。\', \'type\': \'生物 ～梦魇／墙\', \'flavor\': \'「如果能躲在无法穿透的尖叫梦魇屏障背后，谁又需要石头墙呢？」\\n～布蕾德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576924&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'21b11e8b-e701-4c2f-b0a9-d5d38cd93b51\', \'multiverseId\': 576924}, \'multiverseid\': 576924}]', "[{'name': 'Gemeinsame Erkundung', 'text': 'Bonus {G} (Du kannst zusätzlich {G} bezahlen, sowie du diesen Zauberspruch wirkst.)\\nHellsicht 2, ziehe dann eine Karte. Falls die Bonuskosten dieses Zauberspruchs bezahlt wurden, kannst du eine Länderkarte aus deiner Hand ins Spiel bringen.', 'type': 'Spontanzauber', 'flavor': 'Die Tolarianer hatten die Landkarten, aber nur die Yavimayaner konnten sie lesen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574797&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5e484b14-e8e2-4ea6-a9ee-f221eede1206', 'multiverseId': 574797}, 'multiverseid': 574797}, {'name': 'Exploración conjunta', 'text': 'Estímulo {G}. (Puedes pagar {G} adicional al lanzar este hechizo.)\\nAdivina 2 y luego roba una carta. Si este hechizo fue estimulado, puedes poner en el campo de batalla una carta de tierra de tu mano.', 'type': 'Instantáneo', 'flavor': 'Los tolarianos disponían de los mapas, pero los únicos que sabían interpretarlos eran los habitantes de Yavimaya.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575058&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'caeb36f3-ed59-4d7a-9bf3-17976c8ad794', 'multiverseId': 575058}, 'multiverseid': 575058}, {'name': 'Exploration en commun', 'text': 'Kick {G} (Vous pouvez payer {G} supplémentaire au moment où vous lancez ce sort.)\\nRegard 2, puis piochez une carte. Si ce sort a été kické, vous pouvez mettre sur le champ de bataille une carte de terrain de votre main.', 'type': 'Éphémère', 'flavor': 'Les Tolarians avaient les cartes, mais seuls les Yavimayans savaient les lire.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575319&type=card', 'language': 'French', 'identifiers': {'scryfallId': '688fad8c-7f83-4a72-9f5c-5c937c0ba073', 'multiverseId': 575319}, 'multiverseid': 575319}, {'name': 'Esplorazione Congiunta', 'text': 'Potenziamento {G} (Puoi pagare {G} addizionale mentre lanci questa magia.)\\nProfetizza 2, poi pesca una carta. Se questa magia è stata potenziata, puoi mettere sul campo di battaglia una carta terra dalla tua mano.', 'type': 'Istantaneo', 'flavor': 'A Tolaria avevano le mappe, ma solo la gente di Yavimaya sapeva come leggerle.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575580&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '5724ba78-9194-4530-9b1d-b33bd3e2f068', 'multiverseId': 575580}, 'multiverseid': 575580}, {'name': '連携探索', 'text': 'キッカー{G}（この呪文を唱えるに際し、追加で{G}を支払ってもよい。）\\n占術２を行い、その後、カード１枚を引く。この呪文がキッカーされていたなら、あなたはあなたの手札にある土地・カード１枚を戦場に出してもよい。', 'type': 'インスタント', 'flavor': '地図はトレイリア人が持っていたが、読めるのはヤヴィマヤ人だけだった。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575841&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '0d48d218-18fa-4a48-ad91-7f83be1f5b56', 'multiverseId': 575841}, 'multiverseid': 575841}, {'name': 'Exploração Conjunta', 'text': 'Reforçar {G} (Você pode pagar um custo adicional de {G} ao conjurar esta mágica.)\\nUse vidência 2 e depois compre um card. Se esta mágica foi reforçada, você pode colocar no campo de batalha um card de terreno da sua mão.', 'type': 'Mágica Instantânea', 'flavor': 'Os tolarianos tinham os mapas, mas só os yavimayanos sabiam lê-los.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576363&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'befee755-d877-479a-9107-4601f7e1626d', 'multiverseId': 576363}, 'multiverseid': 576363}, {'name': '携手探险', 'text': '增幅{G}（你施放此咒语时可以额外支付{G}。)\\n占卜2，然后抓一张牌。如果此咒语已增幅，则你可以将一张地牌从你手上放进战场。', 'type': '瞬间', 'flavor': '地图虽在陶拉里亚人手中，但只有亚维马雅人才能读懂。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576885&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '3a1ff6e8-0aaa-4d67-b1c9-2d9950ac7dd3', 'multiverseId': 576885}, 'multiverseid': 576885}]", '[{\'name\': \'Geothermisches Moor\', \'text\': \'({T}: Erzeuge {B} oder {R}.)\\nDas Geothermische Moor kommt getappt ins Spiel.\', \'type\': \'Land — Sumpf, Gebirge\', \'flavor\': \'Es gibt noch einige wenige Orte, an denen die natürlichen Gefahren noch größer sind als diejenigen durch phyrexianische Schläfer-Agenten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574988&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e0368d68-286e-46b3-9a72-ff6e1a5bd299\', \'multiverseId\': 574988}, \'multiverseid\': 574988}, {\'name\': \'Ciénaga geotérmica\', \'text\': \'({T}: Agrega {B} o {R}.)\\nLa Ciénaga geotérmica entra al campo de batalla girada.\', \'type\': \'Tierra — Pantano montaña\', \'flavor\': \'Todavía existen algunos lugares donde incluso la amenaza de los agentes durmientes de Pirexia palidece frente a los peligros naturales.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575249&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c818146b-90ab-41f1-a0f5-28dd2ae6a169\', \'multiverseId\': 575249}, \'multiverseid\': 575249}, {\'name\': \'Marécage géothermique\', \'text\': \'({T} : Ajoutez {B} ou {R}.)\\nLe Marécage géothermique arrive sur le champ de bataille engagé.\', \'type\': \'Terrain : marais et montagne\', \'flavor\': \'Il subsiste encore quelques lieux où les dangers naturels dépassent même ceux que posent les agents en sommeil phyrexians.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575510&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3c658689-91d9-4082-9ee9-4bd86d6b2920\', \'multiverseId\': 575510}, \'multiverseid\': 575510}, {\'name\': \'Acquitrino Geotermico\', \'text\': "({T}: Aggiungi {B} o {R}.)\\nL\'Acquitrino Geotermico entra nel campo di battaglia TAPpato.", \'type\': \'Terra — Palude Montagna\', \'flavor\': \'Esistono ancora alcuni luoghi dove i pericoli naturali superano persino quelli rappresentati dagli agenti dormienti Phyrexiani.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575771&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'38096046-c7db-4fb5-966f-b76daeb6dfb0\', \'multiverseId\': 575771}, \'multiverseid\': 575771}, {\'name\': \'地熱の沼\', \'text\': \'（{T}：{B}か{R}を加える。）\\n地熱の沼はタップ状態で戦場に出る。\', \'type\': \'土地 — 沼・山\', \'flavor\': \'ファイレクシア人の潜伏工作員との遭遇よりも危険を伴う自然の脅威がいまだにいくつか存在する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576032&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fcdb4fec-32cf-4ff2-94c3-6bb283f761d5\', \'multiverseId\': 576032}, \'multiverseid\': 576032}, {\'name\': \'Charco Geotérmico\', \'text\': \'({T}: Adicione {B} ou {R}.)\\nCharco Geotérmico entra no campo de batalha virado.\', \'type\': \'Terreno — Pântano Montanha\', \'flavor\': \'Ainda existem alguns poucos lugares onde os perigos naturais superam até mesmo os apresentados pelos agentes adormecidos phyrexianos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576554&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dc915c54-aea9-44be-ace9-8ebf5854a5d2\', \'multiverseId\': 576554}, \'multiverseid\': 576554}, {\'name\': \'地热腐沼\', \'text\': \'（{T}：加{B}或{R}。）\\n地热腐沼须横置进战场。\', \'type\': \'地 ～沼泽／山脉\', \'flavor\': \'如今在某些地方，仍然是自然变化比潜藏密探更凶险。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577076&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6dae5be3-42be-423e-987f-6512409a26e3\', \'multiverseId\': 577076}, \'multiverseid\': 577076}]', '[{\'name\': \'Gesalbter Friedensstifter\', \'text\': \'Wachsamkeit\\nSowie der Gesalbte Friedensstifter ins Spiel kommt, schaue dir die Hand eines Gegners an und bestimme dann einen beliebigen Kartennamen.\\nZaubersprüche mit dem bestimmten Namen, die deine Gegner wirken, kosten beim Wirken {2} mehr.\\nAktivierte Fähigkeiten von Quellen mit dem bestimmten Namen kosten beim Aktivieren {2} mehr, es sei denn, es sind Manafähigkeiten.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574743&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c0bbd5dd-8d7b-4f15-9e70-03c9eb624e7f\', \'multiverseId\': 574743}, \'multiverseid\': 574743}, {\'name\': \'Pacificador ungido\', \'text\': \'Vigilancia.\\nEn cuanto el Pacificador ungido entre al campo de batalla, mira la mano de un oponente y luego elige cualquier nombre de carta.\\nA tus oponentes les cuesta {2} más lanzar hechizos con el nombre elegido.\\nCuesta {2} más activar las habilidades activadas de las fuentes con el nombre elegido a menos que sean habilidades de maná.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575004&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6e8439e0-8050-4b69-90b8-d6128042c2c8\', \'multiverseId\': 575004}, \'multiverseid\': 575004}, {\'name\': \'Garant de la paix consacré\', \'text\': "Vigilance\\nAu moment où le Garant de la paix consacré arrive sur le champ de bataille, regardez la main d\'un adversaire, puis choisissez n\'importe quel nom de carte.\\nLes sorts que vos adversaires lancent du nom choisi coûtent {2} de plus à lancer.\\nLes capacités activées des sources du nom choisi coûtent {2} de plus à activer à moins qu\'elles ne soient des capacités de mana.", \'type\': \'Créature : humain et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575265&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'809c3a94-8ca7-4339-9024-927ac8130bf9\', \'multiverseId\': 575265}, \'multiverseid\': 575265}, {\'name\': \'Pacificatore Consacrato\', \'text\': \'Cautela\\nMentre il Pacificatore Consacrato entra nel campo di battaglia, guarda la mano di un avversario, poi scegli il nome di una carta qualsiasi.\\nLe magie con il nome scelto che i tuoi avversari lanciano costano {2} in più per essere lanciate.\\nLe abilità attivate delle fonti con il nome scelto costano {2} in più per essere attivate a meno che non siano abilità di mana.\', \'type\': \'Creatura — Chierico Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575526&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'100719eb-93da-4a70-ae19-84911b18f4f6\', \'multiverseId\': 575526}, \'multiverseid\': 575526}, {\'name\': \'選定された平和の番人\', \'text\': \'警戒\\n選定された平和の番人が戦場に出るに際し、対戦相手１人の手札を見て、その後、カードの名前１つを選ぶ。\\n対戦相手がその選ばれた名前を持つ呪文を唱えるためのコストは{2}多くなる。\\nその選ばれた名前を持つ発生源の起動型能力を起動するためのコストは、それがマナ能力でないかぎり{2}多くなる。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575787&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6d0180cc-19c9-4d95-a096-3306a5df77a1\', \'multiverseId\': 575787}, \'multiverseid\': 575787}, {\'name\': \'Guardião da Paz Ungido\', \'text\': \'Vigilância\\nConforme Guardião da Paz Ungido entrar no campo de batalha, olhe a mão de um oponente e depois escolha qualquer nome de card.\\nAs mágicas que seus oponentes conjuram com o nome escolhido custam {2} a mais para serem conjuradas.\\nAs habilidades ativadas de fontes com o nome escolhido custam {2} a mais para serem ativadas, a menos que sejam habilidades de mana.\', \'type\': \'Criatura — Humano Clérigo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576309&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4f805e69-3e2b-4411-9866-12c063066796\', \'multiverseId\': 576309}, \'multiverseid\': 576309}, {\'name\': \'祝圣和平护卫\', \'text\': \'警戒\\n于祝圣和平护卫进战场时，检视任一对手的手牌，然后任意选择一个牌名。\\n对手施放之具该名称的咒语增加{2}来施放。\\n除了法术力异能之外，具有该名称之来源的起动式异能都增加{2}来起动。\', \'type\': \'生物 ～人类／僧侣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576831&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b598af4e-55d3-45c1-93b2-ac4862941ca5\', \'multiverseId\': 576831}, \'multiverseid\': 576831}]', '[{\'name\': \'Gesalbter Friedensstifter\', \'text\': \'Wachsamkeit\\nSowie der Gesalbte Friedensstifter ins Spiel kommt, schaue dir die Hand eines Gegners an und bestimme dann einen beliebigen Kartennamen.\\nZaubersprüche mit dem bestimmten Namen, die deine Gegner wirken, kosten beim Wirken {2} mehr.\\nAktivierte Fähigkeiten von Quellen mit dem bestimmten Namen kosten beim Aktivieren {2} mehr, es sei denn, es sind Manafähigkeiten.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577538&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8158860b-8305-4c80-82cb-3b063c334f18\', \'multiverseId\': 577538}, \'multiverseid\': 577538}, {\'name\': \'Garant de la paix consacré\', \'text\': "Vigilance\\nAu moment où le Garant de la paix consacré arrive sur le champ de bataille, regardez la main d\'un adversaire, puis choisissez n\'importe quel nom de carte.\\nLes sorts que vos adversaires lancent du nom choisi coûtent {2} de plus à lancer.\\nLes capacités activées des sources du nom choisi coûtent {2} de plus à activer à moins qu\'elles ne soient des capacités de mana.", \'type\': \'Créature : humain et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577578&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'260f5bcb-208b-4861-b435-7416ae466db1\', \'multiverseId\': 577578}, \'multiverseid\': 577578}, {\'name\': \'選定された平和の番人\', \'text\': \'警戒\\n選定された平和の番人が戦場に出るに際し、対戦相手１人の手札を見て、その後、カードの名前１つを選ぶ。\\n対戦相手がその選ばれた名前を持つ呪文を唱えるためのコストは{2}多くなる。\\nその選ばれた名前を持つ発生源の起動型能力を起動するためのコストは、それがマナ能力でないかぎり{2}多くなる。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577618&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ab02f425-a18e-45c5-b62d-15ef845329ab\', \'multiverseId\': 577618}, \'multiverseid\': 577618}, {\'name\': \'祝圣和平护卫\', \'text\': \'警戒\\n于祝圣和平护卫进战场时，检视任一对手的手牌，然后任意选择一个牌名。\\n对手施放之具该名称的咒语增加{2}来施放。\\n除了法术力异能之外，具有该名称之来源的起动式异能都增加{2}来起动。\', \'type\': \'生物 ～人类／僧侣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577658&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'646d0936-7b38-456b-b016-539b29c9acbb\', \'multiverseId\': 577658}, \'multiverseid\': 577658}]', '[{\'name\': \'Geschmolzener Zufluss\', \'text\': \'({T}: Erzeuge {U} oder {R}.)\\nDer Geschmolzene Zufluss kommt getappt ins Spiel.\', \'type\': \'Land — Insel, Gebirge\', \'flavor\': \'Shiv ist zwar gefährlich, aber auch voller Leben und Mana, was es für ambitionierte Magier zu einem verlockenden Reiseziel macht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574992&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'255f1553-af6c-4b4b-a70a-9354c7fd0fd7\', \'multiverseId\': 574992}, \'multiverseid\': 574992}, {\'name\': \'Afluente fundido\', \'text\': \'({T}: Agrega {U} o {R}.)\\nEl Afluente fundido entra al campo de batalla girado.\', \'type\': \'Tierra — Isla montaña\', \'flavor\': \'A pesar de sus peligros, en Shiv abundan tanto la vida como el maná, lo que lo convierte en un destino muy tentador para los magos más ambiciosos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575253&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0dcaa0eb-417c-47fb-b45f-8fb57f2b2416\', \'multiverseId\': 575253}, \'multiverseid\': 575253}, {\'name\': \'Chenal en fusion\', \'text\': \'({T} : Ajoutez {U} ou {R}.)\\nLe Chenal en fusion arrive sur le champ de bataille engagé.\', \'type\': \'Terrain : île et montagne\', \'flavor\': \'Bien que dangereux, Shiv est une explosion de vie et de mana, ce qui en fait une destination attrayante pour les mages ambitieux.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575514&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8c1ed783-f55e-40f3-8915-9ef7497093ef\', \'multiverseId\': 575514}, \'multiverseid\': 575514}, {\'name\': \'Affluente Magmatico\', \'text\': "({T}: Aggiungi {U} o {R}.)\\nL\'Affluente Magmatico entra nel campo di battaglia TAPpato.", \'type\': \'Terra — Isola Montagna\', \'flavor\': \'Per quanto pericolosa, Shiv pullula di vita e di mana, che ne fanno una meta allettante per i maghi più ambiziosi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575775&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eb813627-0921-499d-876e-d2204fa363af\', \'multiverseId\': 575775}, \'multiverseid\': 575775}, {\'name\': \'溶鉄の支流\', \'text\': \'（{T}：{U}か{R}を加える。）\\n溶鉄の支流はタップ状態で戦場に出る。\', \'type\': \'土地 — 島・山\', \'flavor\': \'危険であるにしろ、シヴは生命とマナを湛え、野心家の邪術師にとっては魅力的な場所なのである。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576036&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'28f34685-281a-46ea-994a-fcd498e3ff4a\', \'multiverseId\': 576036}, \'multiverseid\': 576036}, {\'name\': \'Afluente Derretido\', \'text\': \'({T}: Adicione {U} ou {R}.)\\nAfluente Derretido entra no campo de batalha virado.\', \'type\': \'Terreno — Ilha Montanha\', \'flavor\': \'Mesmo perigosa, Shiv é rica em vida e mana, o que faz dela um destino tentador para magos ambiciosos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576558&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'13bdcd8e-77cb-4121-ba44-5df49836700a\', \'multiverseId\': 576558}, \'multiverseid\': 576558}, {\'name\': \'熔火支流\', \'text\': \'（{T}：加{U}或{R}。）\\n熔火支流须横置进战场。\', \'type\': \'地 ～海岛／山脉\', \'flavor\': \'西瓦虽然危机四伏，但其勃勃生机与充沛法力仍令无数有志法师心向往之。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577080&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b1889229-b08c-4201-be52-285c62040daf\', \'multiverseId\': 577080}, \'multiverseid\': 577080}]', '[{\'name\': \'Gespenstische Erscheinung\', \'text\': \'Wachsamkeit\\nDie Gespenstische Erscheinung kann nicht geblockt werden, solange du in diesem Zug einen Spontanzauber oder eine Hexerei gewirkt hast.\', \'type\': \'Kreatur — Illusion\', \'flavor\': \'Einige schlimme Träume verfolgen dich für immer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574794&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3fca5ebc-b1d5-475f-a86b-0e6543fda038\', \'multiverseId\': 574794}, \'multiverseid\': 574794}, {\'name\': \'Imaginario inquietante\', \'text\': \'Vigilancia.\\nEl Imaginario inquietante no puede ser bloqueado mientras hayas lanzado un hechizo de instantáneo o de conjuro este turno.\', \'type\': \'Criatura — Ilusión\', \'flavor\': \'Hay pesadillas que te acompañan para siempre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575055&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a33ff768-e785-4dd1-895f-705b0167f090\', \'multiverseId\': 575055}, \'multiverseid\': 575055}, {\'name\': \'Notion obsédante\', \'text\': "Vigilance\\nLa Notion obsédante ne peut pas être bloquée tant que vous avez lancé un sort d\'éphémère ou de rituel ce tour-ci.", \'type\': \'Créature : illusion\', \'flavor\': \'Certains cauchemars vous accompagnent pour la vie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575316&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d6ade8ee-ea50-40e7-8ae9-a0d8b427a941\', \'multiverseId\': 575316}, \'multiverseid\': 575316}, {\'name\': \'Fantasma Inquietante\', \'text\': \'Cautela\\nIl Fantasma Inquietante non può essere bloccato se hai lanciato una magia istantaneo o stregoneria in questo turno.\', \'type\': \'Creatura — Illusione\', \'flavor\': \'Alcuni incubi non ti lasciano mai.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575577&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d627724e-0e90-43d4-a3a3-e64bea0a193d\', \'multiverseId\': 575577}, \'multiverseid\': 575577}, {\'name\': \'消えない想像体\', \'text\': \'警戒\\nこのターンにあなたがインスタントやソーサリーである呪文を唱えていたなら、消えない想像体はブロックされない。\', \'type\': \'クリーチャー — イリュージョン\', \'flavor\': \'忘れられない悪夢だってある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575838&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0b7292b2-40d3-4561-a1b1-c0021ca66b47\', \'multiverseId\': 575838}, \'multiverseid\': 575838}, {\'name\': \'Alucinação Assombrosa\', \'text\': \'Vigilância\\nAlucinação Assombrosa não pode ser bloqueada contanto que você tenha conjurado uma mágica instantânea ou um feitiço neste turno.\', \'type\': \'Criatura — Ilusão\', \'flavor\': \'Alguns pesadelos acompanham você a vida toda.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576360&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'80f88b05-4067-4989-9c23-86ee5726b571\', \'multiverseId\': 576360}, \'multiverseid\': 576360}, {\'name\': \'不散拟体\', \'text\': \'警戒\\n只要你本回合中施放过瞬间或法术咒语，不散拟体便不能被阻挡。\', \'type\': \'生物 ～虚影\', \'flavor\': \'有些噩梦会永远缠着你。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576882&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ffd3a2f0-c00a-4336-9b50-55672f570ca1\', \'multiverseId\': 576882}, \'multiverseid\': 576882}]', '[{\'name\': \'Gezeitenbecken-Schildkröte\', \'text\': \'{2}{U}: Hellsicht 1. (Schaue dir die oberste Karte deiner Bibliothek an. Du kannst sie unter deine Bibliothek legen.)\', \'type\': \'Kreatur — Schildkröte\', \'flavor\': \'Von Zauberern als mobiles Hellsichtbecken geschätzt, trägt es Visionen, die es aus den Tiefen des Meeres zieht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574810&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'68428a39-b061-4b28-a678-8f9b38b713a3\', \'multiverseId\': 574810}, \'multiverseid\': 574810}, {\'name\': \'Tortuga poza de marea\', \'text\': \'{2}{U}: Adivina 1. (Mira la primera carta de tu biblioteca. Puedes poner esa carta en el fondo de tu biblioteca.)\', \'type\': \'Criatura — Tortuga\', \'flavor\': \'Los hechiceros la consideran una fuente de adivinaciones en movimiento, ya que muestra visiones provenientes de las profundidades marinas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575071&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'369e242f-2370-4533-9a86-d1c02ccdc9f0\', \'multiverseId\': 575071}, \'multiverseid\': 575071}, {\'name\': \'Tortue intercotidale\', \'text\': \'{2}{U} : Regard 1. (Regardez la carte du dessus de votre bibliothèque. Vous pouvez la mettre au-dessous de votre bibliothèque.)\', \'type\': \'Créature : tortue terrestre\', \'flavor\': "Prisée par les sorciers comme bassin de scrutation mobile, elle apporte des visions des profondeurs de l\'océan.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575332&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d1e171e6-6ec8-4a48-b406-cd0e343dafd2\', \'multiverseId\': 575332}, \'multiverseid\': 575332}, {\'name\': \'Testuggine Pozza di Marea\', \'text\': \'{2}{U}: Profetizza 1. (Guarda la prima carta del tuo grimorio. Puoi mettere quella carta in fondo al tuo grimorio.)\', \'type\': \'Creatura — Tartaruga\', \'flavor\': \'Apprezzata dai maghi come specchio divinatorio vivente, mostra visioni pescate dagli abissi del mare.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575593&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0fa9b894-1774-4451-8b2d-2c6817dfb2a3\', \'multiverseId\': 575593}, \'multiverseid\': 575593}, {\'name\': \'潮溜まりの亀\', \'text\': \'{2}{U}：占術１を行う。（あなたのライブラリーの一番上にあるカード１枚を見る。あなたはそのカードをあなたのライブラリーの一番下に置いてもよい。）\', \'type\': \'クリーチャー — 海亀\', \'flavor\': \'移動型の占術プールとして魔術師に重宝されているこの亀は、深海から引き出される幻影を秘めている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575854&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b60e36eb-e7d3-4825-959a-ad8067cf37fe\', \'multiverseId\': 575854}, \'multiverseid\': 575854}, {\'name\': \'Tartaruga Poça-de-maré\', \'text\': \'{2}{U}: Vidência 1. (Olhe o card do topo de seu grimório. Você pode colocar aquele card no fundo de seu grimório.)\', \'type\': \'Criatura — Tartaruga\', \'flavor\': "Cobiçada pelos magos como espelho d\'água de vidência móvel, ela traz visões das profundezas do mar.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576376&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'52db71c8-0924-4a61-9efb-80a5eaccf1a0\', \'multiverseId\': 576376}, \'multiverseid\': 576376}, {\'name\': \'潮湖龟\', \'text\': \'{2}{U}：占卜1。（检视你牌库顶的牌。你可以将该牌置于你的牌库底。）\', \'type\': \'生物 ～龟\', \'flavor\': \'它是法师们眼中珍贵的移动占卜池，承载着取自深洋的视象。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576898&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7e33ce8d-2622-4595-9928-ddedaaef7b8c\', \'multiverseId\': 576898}, \'multiverseid\': 576898}]', '[{\'name\': \'Ghitu-Verstärkerin\', \'text\': \'Bonus {2}{U} (Du kannst zusätzlich {2}{U} bezahlen, sowie du diesen Zauberspruch wirkst.)\\nWenn die Ghitu-Verstärkerin ins Spiel kommt und falls ihre Bonuskosten bezahlt wurden, bringe eine Kreatur deiner Wahl, die ein Gegner kontrolliert, auf die Hand ihres Besitzers zurück.\\nImmer wenn du einen Spontanzauber oder eine Hexerei wirkst, erhält die Ghitu-Verstärkerin +2/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574868&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'64af364a-75bc-4808-a7c1-6d3db090d595\', \'multiverseId\': 574868}, \'multiverseid\': 574868}, {\'name\': \'Amplificadora ghitu\', \'text\': \'Estímulo {2}{U}. (Puedes pagar {2}{U} adicionales al lanzar este hechizo.)\\nCuando la Amplificadora ghitu entre al campo de batalla, si fue estimulada, regresa la criatura objetivo que controla un oponente a la mano de su propietario.\\nSiempre que lances un hechizo de instantáneo o de conjuro, la Amplificadora ghitu obtiene +2/+0 hasta el final del turno.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575129&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dd246b67-da31-4c63-b607-54698ab20d71\', \'multiverseId\': 575129}, \'multiverseid\': 575129}, {\'name\': \'Amplificatrice guitûke\', \'text\': "Kick {2}{U} (Vous pouvez payer {2}{U} supplémentaires au moment où vous lancez ce sort.)\\nQuand l\'Amplificatrice guitûke arrive sur le champ de bataille, si elle a été kickée, renvoyez une créature ciblée qu\'un adversaire contrôle dans la main de son propriétaire.\\nÀ chaque fois que vous lancez un sort d\'éphémère ou de rituel, l\'Amplificatrice guitûke gagne +2/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575390&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b2ecefeb-363e-45e1-8219-8b69a46a1773\', \'multiverseId\': 575390}, \'multiverseid\': 575390}, {\'name\': \'Amplificatrice Ghitu\', \'text\': "Potenziamento {2}{U} (Puoi pagare {2}{U} addizionale mentre lanci questa magia.)\\nQuando l\'Amplificatrice Ghitu entra nel campo di battaglia, se è stata potenziata, fai tornare una creatura bersaglio controllata da un avversario in mano al suo proprietario.\\nOgniqualvolta lanci una magia istantaneo o stregoneria, l\'Amplificatrice Ghitu prende +2/+0 fino alla fine del turno.", \'type\': \'Creatura — Mago Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575651&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ac34a51a-9948-4029-8dab-afd8cc5bf632\', \'multiverseId\': 575651}, \'multiverseid\': 575651}, {\'name\': \'ギトゥの増幅士\', \'text\': \'キッカー{2}{U}（この呪文を唱えるに際し、追加で{2}{U}を支払ってもよい。）\\nギトゥの増幅士が戦場に出たとき、これがキッカーされていた場合、対戦相手がコントロールしているクリーチャー１体を対象とする。それをオーナーの手札に戻す。\\nあなたがインスタントやソーサリーである呪文を唱えるたび、ターン終了時まで、ギトゥの増幅士は＋２/＋０の修整を受ける。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575912&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ca2fe1e7-1e20-4814-8471-d5558d449a35\', \'multiverseId\': 575912}, \'multiverseid\': 575912}, {\'name\': \'Amplificadora Ghitu\', \'text\': \'Reforçar {2}{U} (Você pode pagar um custo adicional de {2}{U} ao conjurar esta mágica.)\\nQuando Amplificadora Ghitu entra no campo de batalha, se ela foi reforçada, devolva a criatura alvo que um oponente controla para a mão de seu dono.\\nToda vez que você conjura uma mágica instantânea ou um feitiço, Amplificadora Ghitu recebe +2/+0 até o final do turno.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576434&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5f781989-0f00-4e02-a355-67bec7710eea\', \'multiverseId\': 576434}, \'multiverseid\': 576434}, {\'name\': \'基图增效师\', \'text\': \'增幅{2}{U}（你施放此咒语时可以额外支付{2}{U}。）\\n当基图增效师进战场时，若它已增幅，则将目标由对手操控的生物移回其拥有者手上。\\n每当你施放瞬间或法术咒语时，基图增效师得+2/+0直到回合结束。\', \'type\': \'生物 ～人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576956&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'89edd130-fba1-4517-a609-6798d690edc6\', \'multiverseId\': 576956}, \'multiverseid\': 576956}]', '[{\'name\': \'Goblin-Klauber\', \'text\': \'{R}, {T}, wirf eine Karte ab: Ziehe eine Karte.\', \'type\': \'Kreatur — Goblin\', \'flavor\': \'Shivanische Goblins arbeiten seit unzähligen Generationen auf der Manabarkasse und haben dadurch ein unübertroffenes Auge für nützliche Relikte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574869&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'eea84f9c-2dbe-4bfd-964f-7294ccc59663\', \'multiverseId\': 574869}, \'multiverseid\': 574869}, {\'name\': \'Trasgo recolector\', \'text\': \'{R}, {T}, descartar una carta: Roba una carta.\', \'type\': \'Criatura — Trasgo\', \'flavor\': \'Los trasgos shivanos llevan infinidad de generaciones trabajando en la instalación de maná, por lo que tienen muy buen ojo para encontrar reliquias útiles.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575130&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e1bff81a-abf5-4ac7-9b13-6eef55928c49\', \'multiverseId\': 575130}, \'multiverseid\': 575130}, {\'name\': \'Glaneur gobelin\', \'text\': "{R}, {T}, défaussez-vous d\'une carte : Piochez une carte.", \'type\': \'Créature : gobelin\', \'flavor\': "D\'innombrables générations de gobelins shivâns ont travaillé sur la Plate-forme de mana, ce qui leur a donné un œil sans égal pour trouver des reliques utiles.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575391&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'922b74c6-2a32-489d-b875-3190e89f70e6\', \'multiverseId\': 575391}, \'multiverseid\': 575391}, {\'name\': \'Selettore Goblin\', \'text\': \'{R}, {T}, Scarta una carta: Pesca una carta.\', \'type\': \'Creatura — Goblin\', \'flavor\': "Innumerevoli generazioni di goblin di Shiv hanno lavorato all\'Impianto di Mana, sviluppando un occhio attento per le reliquie di valore.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575652&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'10c37d25-53d6-45fb-a9ee-c2c4087bcd8f\', \'multiverseId\': 575652}, \'multiverseid\': 575652}, {\'name\': \'ゴブリンのがらくた拾い\', \'text\': \'{R},{T},カード１枚を捨てる：カード１枚を引く。\', \'type\': \'クリーチャー — ゴブリン\', \'flavor\': \'シヴ山のゴブリンは何世代にもわたりマナ・リグで働いているため、使える材料を見分ける目において並ぶものはない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575913&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e8ccc6af-e5ff-44e5-9ed9-0920b4a78b73\', \'multiverseId\': 575913}, \'multiverseid\': 575913}, {\'name\': \'Selecionador Goblin\', \'text\': \'{R}, {T}, descarte um card: Compre um card.\', \'type\': \'Criatura — Goblin\', \'flavor\': \'Incontáveis gerações de goblins de Shiv já trabalharam na Plataforma de Mana, o que lhes dá um olho incomparável para relíquias úteis.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576435&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a1fd66f4-60f5-4df9-8da4-47cb14a7dfb6\', \'multiverseId\': 576435}, \'multiverseid\': 576435}, {\'name\': \'筛物鬼怪\', \'text\': \'{R}，{T}，弃一张牌：抓一张牌。\', \'type\': \'生物 ～鬼怪\', \'flavor\': \'西瓦鬼怪世世代代都在魔力钻探机上操作，让他们拥有无以伦比的眼力，能鉴别有用的遗宝。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576957&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8391e715-12b9-4b87-9fb4-cd5a8f3193dc\', \'multiverseId\': 576957}, \'multiverseid\': 576957}]', '[{\'name\': \'Goldene Fleute\', \'text\': \'Immer wenn die Goldene Fleute angreift, schicke jede Kreatur, die sie in diesem Zug bemannt hat, ins Exil. Bringe sie zu Beginn des nächsten Endsegments unter der Kontrolle ihres Besitzers getappt ins Spiel zurück.\\nBemannen 1 (Tappe eine beliebige Anzahl an Kreaturen, die du kontrollierst und die zusammen Stärke 1 oder mehr haben: Dieses Fahrzeug wird bis zum Ende des Zuges zu einer Artefaktkreatur.)\', \'type\': \'Legendäres Artefakt — Fahrzeug\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574971&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'096163d7-54da-4706-a9bd-c6ff44c667d5\', \'multiverseId\': 574971}, \'multiverseid\': 574971}, {\'name\': \'Bajel Áureo\', \'text\': \'Siempre que el Bajel Áureo ataque, exilia cada criatura que lo tripuló este turno. Regrésalas al campo de batalla giradas bajo el control de su propietario al comienzo del próximo paso final.\\nTripular 1. (Girar cualquier cantidad de criaturas que controlas con una fuerza total de 1 o más: Este Vehículo se convierte en una criatura artefacto hasta el final del turno.)\', \'type\': \'Artefacto legendario — Vehículo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575232&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b59fd9a0-32bb-46f4-b924-969c733ea85a\', \'multiverseId\': 575232}, \'multiverseid\': 575232}, {\'name\': \'Galion Doré\', \'text\': "À chaque fois que le Galion Doré attaque, exilez chaque créature qui le pilotait ce tour-ci. Renvoyez-la sur le champ de bataille, engagée, sous le contrôle de son propriétaire au début de la prochaine étape de fin.\\nPilotage 1 (Engagez n\'importe quel nombre de créatures que vous contrôlez dont la force totale est supérieure ou égale à 1 : Ce véhicule devient une créature-artefact jusqu\'à la fin du tour.)", \'type\': \'Artefact légendaire : véhicule\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575493&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'554ea88b-05b8-4740-9517-a209a4dd9d2e\', \'multiverseId\': 575493}, \'multiverseid\': 575493}, {\'name\': \'Argosia Dorata\', \'text\': "Ogniqualvolta l\'Argosia Dorata attacca, esilia ogni creatura che l\'ha manovrata in questo turno. Rimetti quelle creature sul campo di battaglia TAPpate sotto il controllo dei rispettivi proprietari all\'inizio della prossima sottofase finale.\\nManovrare 1 (TAPpa un qualsiasi numero di creature che controlli con forza totale pari o superiore a 1: Questo Veicolo diventa una creatura artefatto fino alla fine del turno.)", \'type\': \'Artefatto Leggendario — Veicolo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575754&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'14f4eb60-e9d2-4d51-ba02-d52bba27dfd1\', \'multiverseId\': 575754}, \'multiverseid\': 575754}, {\'name\': \'金色の大帆船\', \'text\': \'金色の大帆船が攻撃するたび、このターンにこれに搭乗したすべてのクリーチャーを追放する。次の終了ステップの開始時に、それらをオーナーのコントロール下でタップ状態で戦場に戻す。\\n搭乗１（あなたがコントロールしている望む数のクリーチャーを、パワーの合計が１以上になるように選んでタップする：ターン終了時まで、この機体はアーティファクト・クリーチャーになる。）\', \'type\': \'伝説のアーティファクト — 機体\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576015&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3b1858f1-cfe9-4a30-ac5c-b6b61f5d3c8b\', \'multiverseId\': 576015}, \'multiverseid\': 576015}, {\'name\': \'Carraca Dourada\', \'text\': \'Toda vez que Carraca Dourada atacar, exile cada criatura que a tripulou neste turno. Devolva-as ao campo de batalha viradas sob controle de seus donos no início da próxima etapa final.\\nTripular 1 (Vire qualquer número de criaturas que você controla com total de poder igual ou superior a 1: Este Veículo torna-se uma criatura artefato até o final do turno.)\', \'type\': \'Artefato Lendário — Veículo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576537&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6cf7b370-8924-4b52-b833-c7abbd61ec86\', \'multiverseId\': 576537}, \'multiverseid\': 576537}, {\'name\': \'黄金阿格西号\', \'text\': \'每当黄金阿格西号攻击时，放逐所有本回合中搭载过它的生物。在下一个结束步骤开始时，将它们在其拥有者的操控下横置移回战场。\\n搭载1（横置任意数量由你操控且力量总和等于或大于1的生物：此载具成为神器生物直到回合结束。）\', \'type\': \'传奇神器 ～载具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577059&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c83999b2-5a66-4a60-a9da-2f101e2f0dae\', \'multiverseId\': 577059}, \'multiverseid\': 577059}]', '[{\'name\': \'Gravierte Tafel\', \'text\': \'{1}, {T}, opfere die Gravierte Tafel: Decke die obersten fünf Karten deiner Bibliothek auf. Nimm davon eine Länderkarte auf deine Hand und lege den Rest in zufälliger Reihenfolge unter deine Bibliothek. Falls du auf diese Weise keine Karte auf deine Hand genommen hast, ziehe eine Karte.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574973&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fedffaca-626a-4998-b6ad-fd3126165efa\', \'multiverseId\': 574973}, \'multiverseid\': 574973}, {\'name\': \'Tablilla inscrita\', \'text\': \'{1}, {T}, sacrificar la Tablilla inscrita: Muestra las cinco primeras cartas de tu biblioteca. Pon una carta de tierra de entre ellas en tu mano y el resto en el fondo de tu biblioteca en un orden aleatorio. Si no pusiste una carta en tu mano de esta manera, roba una carta.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575234&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e466983d-7886-437f-99a9-ccc881e487d6\', \'multiverseId\': 575234}, \'multiverseid\': 575234}, {\'name\': "Tablette couverte d\'inscriptions", \'text\': "{1}, {T}, sacrifiez la Tablette couverte d\'inscriptions : Révélez les cinq cartes du dessus de votre bibliothèque. Mettez une carte de terrain parmi elles dans votre main et le reste au-dessous de votre bibliothèque, dans un ordre aléatoire. Si vous n\'avez pas mis de carte dans votre main de cette manière, piochez une carte.", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575495&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'793331f7-3e52-461b-a3c6-f7fbc2f2c49c\', \'multiverseId\': 575495}, \'multiverseid\': 575495}, {\'name\': \'Tavoletta Incisa\', \'text\': \'{1}, {T}, Sacrifica la Tavoletta Incisa: Rivela le prime cinque carte del tuo grimorio. Aggiungi alla tua mano una carta terra scelta tra esse e metti le altre in fondo al tuo grimorio in ordine casuale. Se non hai aggiunto una carta alla tua mano in questo modo, pesca una carta.\', \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575756&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'061608cc-f3c3-45a1-a54a-2432953be766\', \'multiverseId\': 575756}, \'multiverseid\': 575756}, {\'name\': \'刻まれたタブレット\', \'text\': \'{1}, {T}, 刻まれたタブレットを生け贄に捧げる：あなたのライブラリーの一番上にあるカード５枚を公開する。その中から土地・カード１枚をあなたの手札に、残りをあなたのライブラリーの一番下に無作為の順番で置く。これによりカードを手札に加えなかったなら、カード１枚を引く。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576017&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'23a5a2e0-4578-4201-b864-a63e4e585c32\', \'multiverseId\': 576017}, \'multiverseid\': 576017}, {\'name\': \'Tábua Entalhada\', \'text\': \'{1}, {T}, sacrifique Tábua Entalhada: Revele os cinco cards do topo de seu grimório. Coloque um card de terreno dentre eles em sua mão e o restante no fundo de seu grimório em ordem aleatória. Se você não colocou um card em sua mão dessa forma, compre um card.\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576539&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3e180711-2afa-423c-8fae-7e946f296117\', \'multiverseId\': 576539}, \'multiverseid\': 576539}, {\'name\': \'雕印石板\', \'text\': \'{1}，{T}，牺牲雕印石板：展示你牌库顶的五张牌。将其中一张地牌置于你手上，其余则以随机顺序置于你的牌库底。如果你未以此法将牌置于手上，则抓一张牌。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577061&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b4e08b7f-c4b7-4746-b623-5d70078684db\', \'multiverseId\': 577061}, \'multiverseid\': 577061}]', '[{\'name\': \'Gründung des Dritten Pfades\', \'text\': \'Überblättern (Wähle ein Kapitel und beginne mit so vielen Sagenmarken. Füge nach deinem Ziehsegment eine hinzu. Übersprungene Kapitel werden nicht ausgelöst. Opfern nach III.)\\nI — Du kannst einen Spontanzauber oder eine Hexerei mit Manabetrag 1 oder 2 aus deiner Hand wirken, ohne seine bzw. ihre Manakosten zu bezahlen.\\nII — Ein Spieler deiner Wahl millt vier Karten.\\nIII — Schicke eine Spontanzauber- oder Hexereikarte deiner Wahl aus deinem Friedhof ins Exil. Kopiere sie. Du kannst die Kopie wirken.\', \'type\': \'Verzauberung — Sage\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574791&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'70995e14-7430-4ba3-915e-9d2770bedaf2\', \'multiverseId\': 574791}, \'multiverseid\': 574791}, {\'name\': \'Fundación del Tercer Camino\', \'text\': \'Adelanto. (Elige un capítulo y empieza con esa misma cantidad de contadores de sabiduría. Añade uno después de tu paso de robar. Los capítulos omitidos no se disparan. Sacrifica esta Saga después de III.)\\nI — Puedes lanzar un hechizo de instantáneo o de conjuro con valor de maná de 1 o 2 desde tu mano sin pagar su coste de maná.\\nII — El jugador objetivo muele cuatro cartas.\\nIII — Exilia la carta de instantáneo o de conjuro objetivo de tu cementerio. Cópiala. Puedes lanzar la copia.\', \'type\': \'Encantamiento — Saga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575052&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6de1afc7-0a9e-4510-bbbb-aac6ddc151a5\', \'multiverseId\': 575052}, \'multiverseid\': 575052}, {\'name\': \'Fondation de la Troisième Voie\', \'text\': "Lecture rapide (Choisissez un chapitre et commencez avec autant de marqueurs « sapience ». Ajoutez-en un après votre étape de pioche. Les chapitres passés ne se déclenchent pas. Sacrifiez après III.)\\nI — Vous pouvez lancer un sort d\'éphémère ou de rituel avec une valeur de mana de 1 ou 2 depuis votre main sans payer son coût de mana.\\nII — Un joueur ciblé meule quatre cartes.\\nIII — Exilez une carte d\'éphémère ou de rituel ciblée de votre cimetière. Copiez-la. Vous pouvez lancer la copie.", \'type\': \'Enchantement : saga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575313&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8f45caaf-7313-49f1-b9bd-f02fa8fab8a8\', \'multiverseId\': 575313}, \'multiverseid\': 575313}, {\'name\': \'Fondare il Terzo Cammino\', \'text\': \'Saltare pagina (Scegli un capitolo e inizia con quel numero di segnalini sapere. Aggiungine uno dopo la tua acquisizione. I capitoli saltati non si innescano. Sacrifica dopo III.)\\nI — Puoi lanciare una magia istantaneo o stregoneria con valore di mana 1 o 2 dalla tua mano senza pagare il suo costo di mana.\\nII — Un giocatore bersaglio macina quattro carte.\\nIII — Esilia una carta istantaneo o stregoneria bersaglio dal tuo cimitero. Copia quella carta. Puoi lanciare la copia.\', \'type\': \'Incantesimo — Saga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575574&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'70c639ed-d5e2-4577-8e80-dd06cad5f70b\', \'multiverseId\': 575574}, \'multiverseid\': 575574}, {\'name\': \'第三の道の創設\', \'text\': \'先読（章を選び、それに等しい数の伝承カウンターで始める。あなたのドロー・ステップの後に、伝承カウンター１個を追加する。飛ばされた章は誘発しない。IIIの後に、生け贄に捧げる。）\\nI — あなたはあなたの手札から、インスタントやソーサリーでありマナ総量が１や２である呪文１つを、マナ・コストを支払うことなく唱えてもよい。\\nII — プレイヤー１人を対象とする。そのプレイヤーはカード４枚を切削する。\\nIII — あなたの墓地にありインスタントやソーサリーであるカード１枚を対象とする。それを追放し、コピーする。あなたはそのコピーを唱えてもよい。\', \'type\': \'エンチャント — 英雄譚\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575835&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'16b1a824-cd71-4067-bc3b-f2c89467cc31\', \'multiverseId\': 575835}, \'multiverseid\': 575835}, {\'name\': \'Fundação da Terceira Via\', \'text\': \'Adiantar leitura (Escolha um capítulo e comece com aquela quantidade de marcadores de conhecimento. Adicione um após sua etapa de compra. Os capítulos pulados não são desencadeados. Sacrifique-a após III.)\\nI — Você pode conjurar uma mágica instantânea ou um feitiço com valor de mana 1 ou 2 de sua mão sem pagar seu custo de mana.\\nII — O jogador alvo tritura quatro cards.\\nIII — Exile o card de mágica instantânea ou de feitiço alvo de seu cemitério. Copie-o. Você pode conjurar a cópia.\', \'type\': \'Encantamento — Saga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576357&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'32673656-6f3b-4d7a-b381-fbe438d55acd\', \'multiverseId\': 576357}, \'multiverseid\': 576357}, {\'name\': \'蹊径创会纪\', \'text\': \'跳读（选择一个章节，此传纪一开始就有该数量的学问指示物。于你抓牌步骤后再加一个。跳过的章节不会触发。到III后牺牲之。）\\nI — 你可以从你手上施放一个法术力值为1或2的瞬间或法术咒语，且不需支付其法术力费用。\\nII — 目标牌手磨四张牌。\\nIII — 将目标瞬间或法术牌从你的坟墓场放逐。将其复制。你可以施放该复制品。\', \'type\': \'结界 ～传纪\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576879&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'efe02422-ca63-4075-8d17-691ad6a73257\', \'multiverseId\': 576879}, \'multiverseid\': 576879}]', '[{\'name\': \'Hackebeil-Himmelsreiter\', \'text\': \'Aufblitzen\\nBonus {2}{R} (Du kannst zusätzlich {2}{R} bezahlen, sowie du diesen Zauberspruch wirkst.)\\nFliegend\\nWenn der Hackebeil-Himmelsreiter ins Spiel kommt und falls seine Bonuskosten bezahlt wurden, fügt er einem Ziel deiner Wahl X Schadenspunkte zu, wobei X gleich der Anzahl an angreifenden Kreaturen ist.\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574753&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1aa1efe4-5110-4e28-a961-5de5131187db\', \'multiverseId\': 574753}, \'multiverseid\': 574753}, {\'name\': \'Jinete celeste carnicero\', \'text\': \'Destello.\\nEstímulo {2}{R}. (Puedes pagar {2}{R} adicionales al lanzar este hechizo.)\\nVuela.\\nCuando el Jinete celeste carnicero entre al campo de batalla, si fue estimulado, hace X puntos de daño a cualquier objetivo, donde X es la cantidad de criaturas atacantes.\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575014&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'afeb24cb-65e5-47c4-8b25-bb43a51ac665\', \'multiverseId\': 575014}, \'multiverseid\': 575014}, {\'name\': \'Cavalier céleste tranchant\', \'text\': "Flash\\nKick {2}{R} (Vous pouvez payer {2}{R} supplémentaires au moment où vous lancez ce sort.)\\nVol\\nQuand le Cavalier céleste tranchant arrive sur le champ de bataille, s\'il a été kické, il inflige X blessures à n\'importe quelle cible, X étant le nombre de créatures attaquantes.", \'type\': \'Créature : humain et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575275&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e071f04d-8e66-4f9c-98aa-3defe2e34d4a\', \'multiverseId\': 575275}, \'multiverseid\': 575275}, {\'name\': \'Cavalcacielo Fendente\', \'text\': \'Lampo\\nPotenziamento {2}{R} (Puoi pagare {2}{R} addizionale mentre lanci questa magia.)\\nVolare\\nQuando il Cavalcacielo Fendente entra nel campo di battaglia, se è stato potenziato, infligge X danni a un qualsiasi bersaglio, dove X è il numero di creature attaccanti.\', \'type\': \'Creatura — Guerriero Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575536&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'15b0cb19-136d-436b-b8e6-8c3c44bef52a\', \'multiverseId\': 575536}, \'multiverseid\': 575536}, {\'name\': \'肉裂きの空乗り\', \'text\': \'瞬速\\nキッカー{2}{R}（この呪文を唱えるに際し、追加で{2}{R}を支払ってもよい。）\\n飛行\\n肉裂きの空乗りが戦場に出たとき、これがキッカーされていた場合、クリーチャーやプレインズウォーカーやプレイヤーのうち１つを対象とする。これはそれにＸ点のダメージを与える。Ｘは攻撃クリーチャーの数に等しい。\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575797&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7d3132ea-a19c-43f5-a68a-11b8cc798397\', \'multiverseId\': 575797}, \'multiverseid\': 575797}, {\'name\': \'Ginete Celeste Decepador\', \'text\': \'Lampejo\\nReforçar {2}{R} (Você pode pagar um custo adicional de {2}{R} ao conjurar esta mágica.)\\nVoar\\nQuando Ginete Celeste Decepador entra no campo de batalha, se ele foi reforçado, ele causa X pontos de dano a qualquer alvo, sendo X o número de criaturas atacantes.\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576319&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dcaea183-bbbe-4518-82f5-8b584029ecf2\', \'multiverseId\': 576319}, \'multiverseid\': 576319}, {\'name\': \'挥扫驭空兵\', \'text\': \'闪现\\n增幅{2}{R}（你施放此咒语时可以额外支付{2}{R}。）\\n飞行\\n当挥扫驭空兵进战场时，若它已增幅，则它对任意一个目标造成X点伤害，X为进行攻击的生物数量。\', \'type\': \'生物 ～人类／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576841&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'217fc4a6-bb89-42ab-9db0-2fc7069af279\', \'multiverseId\': 576841}, \'multiverseid\': 576841}]', "[{'name': 'Hammerhand', 'text': 'Verzaubert eine Kreatur\\nWenn die Hammerhand ins Spiel kommt, kann eine Kreatur deiner Wahl in diesem Zug nicht blocken.\\nDie verzauberte Kreatur erhält +1/+1 und hat Eile.', 'type': 'Verzauberung — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574870&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'cae1ba75-65a1-45c7-9c1b-96b12ff32c82', 'multiverseId': 574870}, 'multiverseid': 574870}, {'name': 'Mano de martillo', 'text': 'Encantar criatura.\\nCuando la Mano de martillo entre al campo de batalla, la criatura objetivo no puede bloquear este turno.\\nLa criatura encantada obtiene +1/+1 y tiene la habilidad de prisa.', 'type': 'Encantamiento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575131&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'b1580de8-1adb-4a32-ab7d-980446a60a0c', 'multiverseId': 575131}, 'multiverseid': 575131}, {'name': 'Main à percussion', 'text': 'Enchanter : créature\\nQuand la Main à percussion arrive sur le champ de bataille, une créature ciblée ne peut pas bloquer ce tour-ci.\\nLa créature enchantée gagne +1/+1 et a la célérité.', 'type': 'Enchantement : aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575392&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'f78d5a74-c29e-4727-a002-2ab1258ea609', 'multiverseId': 575392}, 'multiverseid': 575392}, {'name': 'Brachiomartello', 'text': 'Incanta creatura\\nQuando il Brachiomartello entra nel campo di battaglia, una creatura bersaglio non può bloccare in questo turno.\\nLa creatura incantata prende +1/+1 e ha rapidità.', 'type': 'Incantesimo — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575653&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'fc10c62b-5590-409c-b045-8a737e2888c5', 'multiverseId': 575653}, 'multiverseid': 575653}, {'name': '槌手', 'text': 'エンチャント（クリーチャー）\\n槌手が戦場に出たとき、クリーチャー１体を対象とする。このターン、それではブロックできない。\\nエンチャントしているクリーチャーは＋１/＋１の修整を受け速攻を持つ。', 'type': 'エンチャント — オーラ', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575914&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'a065c451-a11a-41df-b025-0d4b6eae4121', 'multiverseId': 575914}, 'multiverseid': 575914}, {'name': 'Mão de Martelo', 'text': 'Encantar criatura\\nQuando Mão de Martelo entra no campo de batalha, a criatura alvo não pode bloquear neste turno.\\nA criatura encantada recebe +1/+1 e tem ímpeto.', 'type': 'Encantamento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576436&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7aa7a999-a5e0-4779-8491-8d129f85950b', 'multiverseId': 576436}, 'multiverseid': 576436}, {'name': '手力如锤', 'text': '结附于生物\\n当手力如锤进战场时，目标生物本回合不能进行阻挡。\\n所结附的生物得+1/+1且具有敏捷异能。', 'type': '结界 ～灵气', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576958&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f94cb689-676a-465a-a2ec-b2417b6f10f3', 'multiverseId': 576958}, 'multiverseid': 576958}]", '[{\'name\': \'Heilige Gipfel\', \'text\': \'({T}: Erzeuge {R} oder {W}.)\\nDie Heiligen Gipfel kommen getappt ins Spiel.\', \'type\': \'Land — Gebirge, Ebene\', \'flavor\': \'In den schwebenden Städten Serras sind alle willkommen, doch wenige außer den Treuesten versuchen den Aufstieg.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574995&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'113d8f66-aa3b-4c51-a8eb-251126b7b8c3\', \'multiverseId\': 574995}, \'multiverseid\': 574995}, {\'name\': \'Cumbres sagradas\', \'text\': \'({T}: Agrega {R} o {W}.)\\nLas Cumbres sagradas entran al campo de batalla giradas.\', \'type\': \'Tierra — Montaña llanura\', \'flavor\': \'Las ciudades flotantes de Serra acogen a todo el mundo, pero solo los más fervorosos creyentes intentan alcanzarlas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575256&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ca7ed673-8715-4f3c-bd21-46c093e05fab\', \'multiverseId\': 575256}, \'multiverseid\': 575256}, {\'name\': \'Pics sacrés\', \'text\': \'({T} : Ajoutez {R} ou {W}.)\\nLes Pics sacrés arrivent sur le champ de bataille engagés.\', \'type\': \'Terrain : montagne et plaine\', \'flavor\': "Tout le monde est le bienvenu dans les cités flottantes de Serra, mais seuls les plus croyants tentent l\'ascension.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575517&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d11a7266-df41-48ed-a34e-b13b249c9fd4\', \'multiverseId\': 575517}, \'multiverseid\': 575517}, {\'name\': \'Picchi Sacri\', \'text\': \'({T}: Aggiungi {R} o {W}.)\\nI Picchi Sacri entrano nel campo di battaglia TAPpati.\', \'type\': \'Terra — Montagna Pianura\', \'flavor\': "Chiunque è il benvenuto nelle città fluttuanti di Serra, ma solo i più fedeli tentano l\'ascesa.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575778&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4f1a1435-ea3c-48a3-8016-b66c5f0af441\', \'multiverseId\': 575778}, \'multiverseid\': 575778}, {\'name\': \'聖なる峰\', \'text\': \'（{T}：{R}か{W}を加える。）\\n聖なる峰はタップ状態で戦場に出る。\', \'type\': \'土地 — 山・平地\', \'flavor\': \'セラの浮遊都市は誰でも受け入れるが、そこに昇ろうと試みるのは最も信心深い者だけである。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576039&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'945165ca-3075-4f1f-b150-917f434707d0\', \'multiverseId\': 576039}, \'multiverseid\': 576039}, {\'name\': \'Picos Sagrados\', \'text\': \'({T}: Adicione {R} ou {W}.)\\nPicos Sagrados entra no campo de batalha virado.\', \'type\': \'Terreno — Montanha Planície\', \'flavor\': \'Todos são bem-vindos nas cidades flutuantes de Serra, embora apenas os mais devotos arrisquem a subida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576561&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'04bfc590-e030-4439-ba47-b843dd88eb78\', \'multiverseId\': 576561}, \'multiverseid\': 576561}, {\'name\': \'圣洁山峰\', \'text\': \'（{T}：加{R}或{W}。）\\n圣洁山峰须横置进战场。\', \'type\': \'地 ～山脉／平原\', \'flavor\': \'漂浮空中的撒拉都市欢迎所有人到访，但仅有寥寥无几的虔诚信徒才会尝试跻身其间。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577083&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2aafcfac-5ac5-4b1f-8068-8d72c4745ac6\', \'multiverseId\': 577083}, \'multiverseid\': 577083}]', "[{'name': 'Herdenwanderung', 'text': 'Domäne — Erzeuge für jeden Standardlandtyp unter den Ländern, die du kontrollierst, einen 3/3 grünen Bestie-Kreaturenspielstein.\\n{1}{G}, wirf die Herdenwanderung ab: Durchsuche deine Bibliothek nach einer Standardland-Karte, zeige sie offen vor, nimm sie auf deine Hand und mische danach. Du erhältst 3 Lebenspunkte dazu.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574906&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'cb5f4ff4-fd10-4223-8732-d19c0883c52f', 'multiverseId': 574906}, 'multiverseid': 574906}, {'name': 'Migración de la manada', 'text': 'Dominio — Crea una ficha de criatura Bestia verde 3/3 por cada tipo de tierra básica entre las tierras que controlas.\\n{1}{G}, descartar la Migración de la manada: Busca en tu biblioteca una carta de tierra básica, muéstrala, ponla en tu mano y luego baraja. Ganas 3 vidas.', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575167&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4bc89e98-4aa5-4a2d-9b41-83ce05043c0e', 'multiverseId': 575167}, 'multiverseid': 575167}, {'name': 'Migration de troupeau', 'text': 'Domaine — Créez un jeton de créature 3/3 verte Bête pour chaque type de terrain de base parmi les terrains que vous contrôlez.\\n{1}{G}, défaussez-vous de la Migration de troupeau : Cherchez dans votre bibliothèque une carte de terrain de base, révélez-la, mettez-la dans votre main, puis mélangez. Vous gagnez 3 points de vie.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575428&type=card', 'language': 'French', 'identifiers': {'scryfallId': '24dd53ce-9fa3-40c3-8e59-014969b3c34c', 'multiverseId': 575428}, 'multiverseid': 575428}, {'name': 'Migrazione della Mandria', 'text': 'Dominio — Crea una pedina creatura Bestia 3/3 verde per ogni tipo di terra base tra le terre che controlli.\\n{1}{G}, Scarta la Migrazione della Mandria: Passa in rassegna il tuo grimorio per una carta terra base, rivelala e aggiungila alla tua mano, poi rimescola. Guadagni 3 punti vita.', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575689&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'e977840b-ff10-4506-a462-a15109e984a4', 'multiverseId': 575689}, 'multiverseid': 575689}, {'name': '群れの渡り', 'text': '版図 — あなたがコントロールしている土地の中の基本土地タイプ１種類につき１体の、緑の３/３のビースト・クリーチャー・トークンを生成する。\\n{1}{G},群れの渡りを捨てる：あなたのライブラリーから基本土地・カード１枚を探し、公開し、あなたの手札に加える。その後、ライブラリーを切り直す。あなたは３点のライフを得る。', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575950&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '103da4a3-a147-4c9c-afa5-212de10992bb', 'multiverseId': 575950}, 'multiverseid': 575950}, {'name': 'Migração do Rebanho', 'text': 'Dominar — Crie uma ficha de criatura Besta verde 3/3 para cada tipo de terreno básico entre os terrenos que você controla.\\n{1}{G}, descarte Migração do Rebanho: Procure um card de terreno básico em seu grimório, revele-o, coloque-o em sua mão e depois embaralhe. Você ganha 3 pontos de vida.', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576472&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '258baa5b-5f54-4535-8a1a-ab146e14b8c0', 'multiverseId': 576472}, 'multiverseid': 576472}, {'name': '兽群迁徙', 'text': '领土～由你操控的地中每有一种基本地类别，便派出一个3/3绿色野兽衍生生物。\\n{1}{G}，弃掉兽群迁徙：从你牌库中搜寻一张基本地牌，展示该牌，将它置于你手上，然后洗牌。你获得3点生命。', 'type': '法术', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576994&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9b7e3867-c76b-419b-a1f4-4792ec20da51', 'multiverseId': 576994}, 'multiverseid': 576994}]", "[{'name': 'Herdenwanderung', 'text': 'Domäne — Erzeuge für jeden Standardlandtyp unter den Ländern, die du kontrollierst, einen 3/3 grünen Bestie-Kreaturenspielstein.\\n{1}{G}, wirf die Herdenwanderung ab: Durchsuche deine Bibliothek nach einer Standardland-Karte, zeige sie offen vor, nimm sie auf deine Hand und mische danach. Du erhältst 3 Lebenspunkte dazu.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577485&type=card', 'language': 'German', 'identifiers': {'scryfallId': '22e7a0ad-f4ee-4a4d-9ddd-7d8c6f62034d', 'multiverseId': 577485}, 'multiverseid': 577485}, {'name': 'Migration de troupeau', 'text': 'Domaine — Créez un jeton de créature 3/3 verte Bête pour chaque type de terrain de base parmi les terrains que vous contrôlez.\\n{1}{G}, défaussez-vous de la Migration de troupeau : Cherchez dans votre bibliothèque une carte de terrain de base, révélez-la, mettez-la dans votre main, puis mélangez. Vous gagnez 3 points de vie.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577486&type=card', 'language': 'French', 'identifiers': {'scryfallId': '560885f2-49b5-4991-9943-26f318c00c08', 'multiverseId': 577486}, 'multiverseid': 577486}]", "[{'name': 'Herdenwanderung', 'text': 'Domäne — Erzeuge für jeden Standardlandtyp unter den Ländern, die du kontrollierst, einen 3/3 grünen Bestie-Kreaturenspielstein.\\n{1}{G}, wirf die Herdenwanderung ab: Durchsuche deine Bibliothek nach einer Standardland-Karte, zeige sie offen vor, nimm sie auf deine Hand und mische danach. Du erhältst 3 Lebenspunkte dazu.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577568&type=card', 'language': 'German', 'identifiers': {'scryfallId': '63885719-d0ef-4684-9ca5-95e051bb6999', 'multiverseId': 577568}, 'multiverseid': 577568}, {'name': 'Migration de troupeau', 'text': 'Domaine — Créez un jeton de créature 3/3 verte Bête pour chaque type de terrain de base parmi les terrains que vous contrôlez.\\n{1}{G}, défaussez-vous de la Migration de troupeau : Cherchez dans votre bibliothèque une carte de terrain de base, révélez-la, mettez-la dans votre main, puis mélangez. Vous gagnez 3 points de vie.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577608&type=card', 'language': 'French', 'identifiers': {'scryfallId': '8cbb60f7-cc11-4857-9d55-b6b2c4d24b13', 'multiverseId': 577608}, 'multiverseid': 577608}, {'name': '群れの渡り', 'text': '版図 — あなたがコントロールしている土地の中の基本土地タイプ１種類につき１体の、緑の３/３のビースト・クリーチャー・トークンを生成する。\\n{1}{G},群れの渡りを捨てる：あなたのライブラリーから基本土地・カード１枚を探し、公開し、あなたの手札に加える。その後、ライブラリーを切り直す。あなたは３点のライフを得る。', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577648&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'fe3a93be-6096-439e-b391-002502e2c06a', 'multiverseId': 577648}, 'multiverseid': 577648}, {'name': '兽群迁徙', 'text': '领土～由你操控的地中每有一种基本地类别，便派出一个3/3绿色野兽衍生生物。\\n{1}{G}，弃掉兽群迁徙：从你牌库中搜寻一张基本地牌，展示该牌，将它置于你手上，然后洗牌。你获得3点生命。', 'type': '法术', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577688&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'dde9ee8a-0867-452b-95d9-cb423d944cb8', 'multiverseId': 577688}, 'multiverseid': 577688}]", '[{\'name\': \'Heroischer Ansturm\', \'text\': \'Bonus {1}{R} (Du kannst zusätzlich {1}{R} bezahlen, sowie du diesen Zauberspruch wirkst.)\\nKreaturen, die du kontrollierst, erhalten +2/+1 bis zum Ende des Zuges. Falls die Bonuskosten dieses Zauberspruchs bezahlt wurden, verursachen die Kreaturen außerdem Trampelschaden bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Für Keld! Für Benalia! Für Dominaria!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574761&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'98c62f70-7829-4665-ac51-4349672d8329\', \'multiverseId\': 574761}, \'multiverseid\': 574761}, {\'name\': \'Carga heroica\', \'text\': \'Estímulo {1}{R}. (Puedes pagar {1}{R} adicionales al lanzar este hechizo.)\\nLas criaturas que controlas obtienen +2/+1 hasta el final del turno. Si este hechizo fue estimulado, esas criaturas también ganan la habilidad de arrollar hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"¡Por Keld! ¡Por Benalia! ¡Por Dominaria!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575022&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5ae0a21f-df68-4d3b-9523-07778cff1674\', \'multiverseId\': 575022}, \'multiverseid\': 575022}, {\'name\': \'Charge héroïque\', \'text\': "Kick {1}{R} (Vous pouvez payer {1}{R} supplémentaires au moment où vous lancez ce sort.)\\nLes créatures que vous contrôlez gagnent +2/+1 jusqu\'à la fin du tour. Si ce sort a été kické, ces créatures acquièrent aussi le piétinement jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': \'« Pour Keld ! Pour Bénalia ! Pour Dominaria ! »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575283&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'81bb516b-3869-4b84-99ce-c15458290573\', \'multiverseId\': 575283}, \'multiverseid\': 575283}, {\'name\': \'Carica Eroica\', \'text\': \'Potenziamento {1}{R} (Puoi pagare {1}{R} addizionale mentre lanci questa magia.)\\nLe creature che controlli prendono +2/+1 fino alla fine del turno. Se questa magia è stata potenziata, quelle creature hanno anche travolgere fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Per Keld! Per Benalia! Per Dominaria!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575544&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9fd830c2-22c6-40e3-930b-215659d919e4\', \'multiverseId\': 575544}, \'multiverseid\': 575544}, {\'name\': \'英雄的突撃\', \'text\': \'キッカー{1}{R}（この呪文を唱えるに際し、追加で{1}{R}を支払ってもよい。）\\nターン終了時まで、あなたがコントロールしているすべてのクリーチャーは＋２/＋１の修整を受ける。この呪文がキッカーされていたなら、ターン終了時まで、それらのクリーチャーはトランプルも得る。\', \'type\': \'インスタント\', \'flavor\': \'「ケルドのために！ベナリアのために！ドミナリアのために！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575805&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0fbfe5fd-2f66-4a15-a9f5-05b217e4c7d1\', \'multiverseId\': 575805}, \'multiverseid\': 575805}, {\'name\': \'Carga Heroica\', \'text\': \'Reforçar {1}{R} (Você pode pagar um custo adicional de {1}{R} ao conjurar esta mágica.)\\nAs criaturas que você controla recebem +2/+1 até o final do turno. Se esta mágica foi reforçada, aquelas criaturas também ganham atropelar até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Por Keld! Por Benália! Por Dominária!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576327&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'42c14e47-de59-4c40-b82b-a9443078d539\', \'multiverseId\': 576327}, \'multiverseid\': 576327}, {\'name\': \'勇士冲锋\', \'text\': \'增幅{1}{R}（你施放此咒语时可以额外支付{1}{R}。）\\n由你操控的生物得+2/+1直到回合结束。如果此咒语已增幅，则这些生物再获得践踏异能直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'「为了凯尔顿！为了宾纳里亚！为了多明纳里亚！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576849&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b772e686-a5f7-4ff5-a2f5-561dc118f657\', \'multiverseId\': 576849}, \'multiverseid\': 576849}]', '[{\'name\': \'Himmelsritter der Koalition\', \'text\': \'Fliegend\\nAbkommandieren (Sowie diese Kreatur angreift, kannst du eine nicht angreifende Kreatur ohne Einsatzverzögerung, die du kontrollierst, tappen. Wenn du dies tust, addiere ihre Stärke bis zum Ende des Zuges zur Stärke dieser Kreatur.)\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574755&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'84458999-b6c3-42d7-a9d8-00f9b1e7e239\', \'multiverseId\': 574755}, \'multiverseid\': 574755}, {\'name\': \'Caballero celeste de la Coalición\', \'text\': \'Vuela.\\nReclutar. (En cuanto esta criatura ataque, puedes girar una criatura que controlas sin mareo de invocación que no esté atacando. Cuando lo hagas, añade su fuerza a la de esta criatura hasta el final del turno.)\', \'type\': \'Criatura — Caballero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575016&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'da2ee395-f162-4f59-b2c0-12c540ea8acf\', \'multiverseId\': 575016}, \'multiverseid\': 575016}, {\'name\': \'Chevalier céleste de la coalition\', \'text\': "Vol\\nEnrôlement (Au moment où cette créature attaque, vous pouvez engager une créature non-attaquante que vous contrôlez sans mal d\'invocation. Quand vous faites ainsi, ajoutez sa force à celle de cette créature jusqu\'à la fin du tour.)", \'type\': \'Créature : humain et chevalier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575277&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'82867c9f-7059-4535-9050-d7f5ca6d0aa1\', \'multiverseId\': 575277}, \'multiverseid\': 575277}, {\'name\': \'Cavaliere dei Cieli della Coalizione\', \'text\': \'Volare\\nArruolare (Mentre questa creatura attacca, puoi TAPpare una creatura non attaccante che controlli non affetta da debolezza da evocazione. Quando lo fai, aggiungi la sua forza a quella di questa creatura fino alla fine del turno.)\', \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575538&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'effdc3fc-5f8d-4ef5-b774-318ea5c89526\', \'multiverseId\': 575538}, \'multiverseid\': 575538}, {\'name\': \'連合の空騎士\', \'text\': \'飛行\\n後援（このクリーチャーが攻撃するに際し、あなたがコントロールしていて召喚酔いの影響を受けておらず攻撃してもいないクリーチャー１体をタップしてもよい。そうしたとき、ターン終了時まで、このクリーチャーのパワーにそのタップしたクリーチャーのパワーを足す。）\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575799&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'47e1d7e3-23df-4ffa-be10-4c74f4d9ab0c\', \'multiverseId\': 575799}, \'multiverseid\': 575799}, {\'name\': \'Cavaleiro Celeste da Coalizão\', \'text\': \'Voar\\nAlistar (Conforme esta criatura ataca, você pode virar uma criatura não atacante que você controla sem enjoo de invocação. Quando fizer isso, adicione o poder dela ao desta criatura até o final do turno.)\', \'type\': \'Criatura — Humano Cavaleiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576321&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'27238b2b-6658-48a3-a2c3-e392e8fffc07\', \'multiverseId\': 576321}, \'multiverseid\': 576321}, {\'name\': \'联盟空骑士\', \'text\': \'飞行\\n征列（于此生物攻击时，你可以横置一个由你操控、不具召唤失调且未进行攻击的生物。当你如此作时，将所横置生物的力量加至此生物直到回合结束。）\', \'type\': \'生物 ～人类／骑士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576843&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'afaee46f-dac9-4f6c-bc83-43435a36109e\', \'multiverseId\': 576843}, \'multiverseid\': 576843}]', '[{\'name\': \'Hochfliegender Sceada\', \'text\': \'Fliegend\', \'type\': \'Kreatur — Sceada\', \'flavor\': \'Die ohnehin spektakulären Aussichten von den Türmen der Akademie in Lat-Nam werden manchmal noch durch den Anblick von Sceadas bereichert, die in den Ozean tauchen, um kleine Haie zu fressen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574807&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5cd5d2aa-972d-40ab-9f66-cf617ebbc4ec\', \'multiverseId\': 574807}, \'multiverseid\': 574807}, {\'name\': \'Draco planeador\', \'text\': \'Vuela.\', \'type\': \'Criatura — Draco\', \'flavor\': \'Las vistas desde las torres de la Escuela de Lat-Nam, espectaculares por sí solas, se ven a veces sublimadas por la momentánea presencia de los dracos que se sumergen en el océano para devorar pequeños tiburones.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575068&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'707056ea-2cc7-4853-ad0f-ece6c4bd280c\', \'multiverseId\': 575068}, \'multiverseid\': 575068}, {\'name\': \'Drakôn aérien\', \'text\': \'Vol\', \'type\': \'Créature : drakôn\', \'flavor\': "Les vues déjà spectaculaires depuis les tours de l\'Université à Lat-Nam le sont encore plus quand on peut apercevoir les drakôns qui plongent dans l\'océan pour dévorer de petits requins.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575329&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'73285c55-f32a-483a-8fa6-695e64ccd268\', \'multiverseId\': 575329}, \'multiverseid\': 575329}, {\'name\': \'Draghetto Volteggiante\', \'text\': \'Volare\', \'type\': \'Creatura — Draghetto\', \'flavor\': "Il panorama dalle torri dell\'Istituto di Lat-Nam, già di per sé spettacolare, è talvolta impreziosito da fugaci apparizioni di draghetti che si tuffano nell\'oceano per divorare gli squali più piccoli.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575590&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d2186076-472b-42e5-8420-790f2ac31c86\', \'multiverseId\': 575590}, \'multiverseid\': 575590}, {\'name\': \'飛翔するドレイク\', \'text\': \'飛行\', \'type\': \'クリーチャー — ドレイク\', \'flavor\': \'ただでさえ目を見張るラト＝ナム大学棟からの眺めは、小サメを狩ろうと海へ飛び込むドレイクの姿により一層引き立てられる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575851&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'600fb6d5-75a0-4e16-8bc6-d56548791dd3\', \'multiverseId\': 575851}, \'multiverseid\': 575851}, {\'name\': \'Dragonete Planador\', \'text\': \'Voar\', \'type\': \'Criatura — Dragonete\', \'flavor\': \'A vista já espetacular das torres da Faculdade de Lat-Nam às vezes fica ainda melhor com os vislumbres dos dragonetes mergulhando no oceano para devorar pequenos tubarões.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576373&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7811a54f-34e3-4124-b0b0-6574d315bd2c\', \'multiverseId\': 576373}, \'multiverseid\': 576373}, {\'name\': \'翱翔龙兽\', \'text\': \'飞行\', \'type\': \'生物 ～龙兽\', \'flavor\': \'从大学院拉特南分院的高塔登高远望，其壮阔景象已然美不胜收；而有时还能看到龙兽俯冲洋面叼食幼鲨，更在秀丽画卷上增添生动点缀。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576895&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7bda146e-bfa8-4243-aaf3-859504e74662\', \'multiverseId\': 576895}, \'multiverseid\': 576895}]', '[{\'name\': \'Hochmütiger Dschinn\', \'text\': \'Fliegend\\nDie Stärke des Hochmütigen Dschinns ist gleich der Anzahl an Spontanzauber- und Hexereikarten in deinem Friedhof.\\nSpontanzauber und Hexereien, die du wirkst, kosten beim Wirken {1} weniger.\', \'type\': \'Kreatur — Dschinn\', \'flavor\': \'„Ich finde dein Outfit toll. Es ist so … rustikal."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574793&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5334f2b2-d248-48a7-9690-7bc561eee7a8\', \'multiverseId\': 574793}, \'multiverseid\': 574793}, {\'name\': \'Djinn arrogante\', \'text\': \'Vuela.\\nLa fuerza del Djinn arrogante es igual a la cantidad de cartas de instantáneo y de conjuro en tu cementerio.\\nTe cuesta {1} menos lanzar hechizos de instantáneo o de conjuro.\', \'type\': \'Criatura — Djinn\', \'flavor\': \'"Me encanta tu ropa. Es muy... rústica".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575054&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6f616c8c-29ef-43ec-b7a2-e08d5caa1812\', \'multiverseId\': 575054}, \'multiverseid\': 575054}, {\'name\': \'Djinn hautain\', \'text\': "Vol\\nLa force du Djinn hautain est égale au nombre de cartes d\'éphémère et de rituel dans votre cimetière.\\nLes sorts d\'éphémère et de rituel que vous lancez coûtent {1} de moins à lancer.", \'type\': \'Créature : djinn\', \'flavor\': "« J\'adore votre tenue. Elle est tellement... rustique. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575315&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2cc6d039-82d4-49b0-af6c-d4650f9b0cdb\', \'multiverseId\': 575315}, \'multiverseid\': 575315}, {\'name\': \'Genio Altezzoso\', \'text\': \'Volare\\nLa forza del Genio Altezzoso è pari al numero di carte istantaneo e carte stregoneria nel tuo cimitero.\\nLe magie istantaneo e stregoneria che lanci costano {1} in meno per essere lanciate.\', \'type\': \'Creatura — Genio\', \'flavor\': \'"Adoro il tuo vestito. È così... rustico."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575576&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'70f2e479-1039-4017-bdcc-da03468c5ffc\', \'multiverseId\': 575576}, \'multiverseid\': 575576}, {\'name\': \'傲慢なジン\', \'text\': \'飛行\\n傲慢なジンのパワーは、あなたの墓地にありインスタントやソーサリーであるカードの枚数に等しい。\\nあなたがインスタントやソーサリーである呪文を唱えるためのコストは{1}少なくなる。\', \'type\': \'クリーチャー — ジン\', \'flavor\': \'「素敵な衣装だ。なんていうか……質素だね。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575837&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f68d18c8-4977-4ba5-a56b-d7671cbfc8ea\', \'multiverseId\': 575837}, \'multiverseid\': 575837}, {\'name\': \'Gênio Arrogante\', \'text\': \'Voar\\nO poder de Gênio Arrogante é igual ao número de cards de mágica instantânea e de feitiço em seu cemitério.\\nAs mágicas instantâneas e os feitiços que você conjura custam {1} a menos para serem conjurados.\', \'type\': \'Criatura — Gênio\', \'flavor\': \'"Eu adoro esse seu traje. É tão... rústico!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576359&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7dd42703-9992-4ab2-9f32-1ef4d1ef6eb7\', \'multiverseId\': 576359}, \'multiverseid\': 576359}, {\'name\': \'狂妄巨灵\', \'text\': \'飞行\\n狂妄巨灵的力量等同于你坟墓场中瞬间与法术牌的数量加总。\\n你施放的瞬间与法术咒语减少{1}来施放。\', \'type\': \'生物 ～巨灵\', \'flavor\': \'「我喜欢你的装扮。看上去非常…淳朴。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576881&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6f14b386-cdd0-4c7e-8ee7-ccd4eca09984\', \'multiverseId\': 576881}, \'multiverseid\': 576881}]', '[{\'name\': \'Hochmütiger Dschinn\', \'text\': \'Fliegend\\nDie Stärke des Hochmütigen Dschinns ist gleich der Anzahl an Spontanzauber- und Hexereikarten in deinem Friedhof.\\nSpontanzauber und Hexereien, die du wirkst, kosten beim Wirken {1} weniger.\', \'type\': \'Kreatur — Dschinn\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577549&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f99008bc-022d-45a7-a405-7e43972fd1ac\', \'multiverseId\': 577549}, \'multiverseid\': 577549}, {\'name\': \'Djinn hautain\', \'text\': "Vol\\nLa force du Djinn hautain est égale au nombre de cartes d\'éphémère et de rituel dans votre cimetière.\\nLes sorts d\'éphémère et de rituel que vous lancez coûtent {1} de moins à lancer.", \'type\': \'Créature : djinn\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577589&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3721b9a0-6a12-4f37-9a2a-02d00ff15a1a\', \'multiverseId\': 577589}, \'multiverseid\': 577589}, {\'name\': \'傲慢なジン\', \'text\': \'飛行\\n傲慢なジンのパワーは、あなたの墓地にありインスタントやソーサリーであるカードの枚数に等しい。\\nあなたがインスタントやソーサリーである呪文を唱えるためのコストは{1}少なくなる。\', \'type\': \'クリーチャー — ジン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577629&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b719cf08-bc22-447f-935c-edaa338dd88a\', \'multiverseId\': 577629}, \'multiverseid\': 577629}, {\'name\': \'狂妄巨灵\', \'text\': \'飞行\\n狂妄巨灵的力量等同于你坟墓场中瞬间与法术牌的数量加总。\\n你施放的瞬间与法术咒语减少{1}来施放。\', \'type\': \'生物 ～巨灵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577669&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fe7e8f8b-243f-477e-ae73-85a45daf286a\', \'multiverseId\': 577669}, \'multiverseid\': 577669}]', '[{\'name\': \'Hurloon-Schlachtgesang\', \'text\': \'Bonus {W} (Du kannst zusätzlich {W} bezahlen, sowie du diesen Zauberspruch wirkst.)\\nDer Hurloon-Schlachtgesang fügt einer Kreatur oder einem Planeswalker deiner Wahl 4 Schadenspunkte zu. Falls die Bonuskosten dieses Zauberspruchs bezahlt wurden, erhältst du 4 Lebenspunkte dazu.\', \'type\': \'Spontanzauber\', \'flavor\': \'Die magischen Echos der Gebirgskette von Hurloon verstärken die Macht von gesungenen Zaubern erheblich.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574872&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'80f09739-2995-466c-b62a-bd61a20a05d9\', \'multiverseId\': 574872}, \'multiverseid\': 574872}, {\'name\': \'Himno de batalla de Hurloon\', \'text\': \'Estímulo {W}. (Puedes pagar {W} adicional al lanzar este hechizo.)\\nEl Himno de batalla de Hurloon hace 4 puntos de daño a la criatura o planeswalker objetivo. Si este hechizo fue estimulado, ganas 4 vidas.\', \'type\': \'Instantáneo\', \'flavor\': \'Los ecos mágicos de la cordillera de Hurloon amplifican en gran medida la potencia de los hechizos que se cantan o recitan.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575133&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b3a0eabd-8d69-4578-8838-b370dfc5a1b5\', \'multiverseId\': 575133}, \'multiverseid\': 575133}, {\'name\': \'Hymne de bataille du Hurloon\', \'text\': "Kick {W} (Vous pouvez payer {W} supplémentaire au moment où vous lancez ce sort.)\\nL\'Hymne de bataille du Hurloon inflige 4 blessures à une cible, créature ou planeswalker. Si ce sort a été kické, vous gagnez 4 points de vie.", \'type\': \'Éphémère\', \'flavor\': \'Les échos magiques de la chaîne montagneuse du Hurloon augmentent grandement la puissance des sorts basés sur le chant ou la parole.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575394&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'86726f36-6c9a-46e2-8112-967885cb8c6a\', \'multiverseId\': 575394}, \'multiverseid\': 575394}, {\'name\': \'Inno di Guerra di Hurloon\', \'text\': "Potenziamento {W} (Puoi pagare {W} addizionale mentre lanci questa magia.)\\nL\'Inno di Guerra di Hurloon infligge 4 danni a una creatura o a un planeswalker bersaglio. Se questa magia è stata potenziata, guadagni 4 punti vita.", \'type\': \'Istantaneo\', \'flavor\': "Gli echi magici della catena montuosa di Hurloon aumentano notevolmente la potenza delle magie basate sul canto o sull\'orazione.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575655&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'12e13c22-2d37-4411-9003-d17c6cdc8eca\', \'multiverseId\': 575655}, \'multiverseid\': 575655}, {\'name\': \'ハールーンの戦賛歌\', \'text\': \'キッカー{W}（この呪文を唱えるに際し、追加で{W}を支払ってもよい。）\\nクリーチャーやプレインズウォーカーのうち１体を対象とする。ハールーンの戦賛歌はそれに４点のダメージを与える。この呪文がキッカーされていたなら、あなたは４点のライフを得る。\', \'type\': \'インスタント\', \'flavor\': \'ハールーンの山脈の不思議なこだまは、歌や斉唱によって呪文の効果を大幅に増幅させる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575916&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'37fa029a-cc2a-4025-81c1-026a04691305\', \'multiverseId\': 575916}, \'multiverseid\': 575916}, {\'name\': \'Hino de Batalha de Hurloon\', \'text\': \'Reforçar {W} (Você pode pagar um custo adicional de {W} ao conjurar esta mágica.)\\nHino de Batalha de Hurloon causa 4 pontos de dano à criatura ou ao planeswalker alvo. Se esta mágica foi reforçada, você ganha 4 pontos de vida.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os ecos mágicos da cordilheira de Hurloon aumentam significativamente a potência das magias cantadas ou recitadas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576438&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c81f30c3-9d60-4011-ad0c-4aece358d0d6\', \'multiverseId\': 576438}, \'multiverseid\': 576438}, {\'name\': \'夏浓战歌\', \'text\': \'增幅{W}（你施放此咒语时可以额外支付{W}。）\\n夏浓战歌对目标生物或鹏洛客造成4点伤害。如果此咒语已增幅，则你获得4点生命。\', \'type\': \'瞬间\', \'flavor\': \'回荡在夏浓山脉的魔法之声会应和歌声或讲词来大幅提升咒语强度。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576960&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'91d38750-43bf-48d1-92ac-55fac3c3242a\', \'multiverseId\': 576960}, \'multiverseid\': 576960}]', '[{\'name\': \'Höhlen von Koilos\', \'text\': \'{T}: Erzeuge {C}.\\n{T}: Erzeuge {W} oder {B}. Die Höhlen von Koilos fügen dir 1 Schadenspunkt zu.\', \'type\': \'Land\', \'flavor\': \'Nach Jahren der Stille widerhallen in den Höhlen wieder die grausigen Geräusche von Phyrexianern, die sich auf den Krieg vorbereiten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574985&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'758c34fe-1268-4273-b33e-189d1f6a2da7\', \'multiverseId\': 574985}, \'multiverseid\': 574985}, {\'name\': \'Cuevas de Koilos\', \'text\': \'{T}: Agrega {C}.\\n{T}: Agrega {W} o {B}. Las Cuevas de Koilos te hacen 1 punto de daño.\', \'type\': \'Tierra\', \'flavor\': \'Tras años de silencio, en las cuevas vuelve a resonar el espeluznante eco de los pirexianos que se preparan para la guerra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575246&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ed3656c0-da91-44b4-8056-52edd565090c\', \'multiverseId\': 575246}, \'multiverseid\': 575246}, {\'name\': \'Cavernes de Koïlos\', \'text\': \'{T} : Ajoutez {C}.\\n{T} : Ajoutez {W} ou {B}. Les Cavernes de Koïlos vous infligent 1 blessure.\', \'type\': \'Terrain\', \'flavor\': "Après des années de silence, les cavernes se font à nouveau l\'écho des sons horribles des Phyrexians se préparant pour la guerre.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575507&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3dc5e72f-ec22-49c7-bd91-b93ab3aa8b58\', \'multiverseId\': 575507}, \'multiverseid\': 575507}, {\'name\': \'Caverne di Koilos\', \'text\': \'{T}: Aggiungi {C}.\\n{T}: Aggiungi {W} o {B}. Le Caverne di Koilos ti infliggono 1 danno.\', \'type\': \'Terra\', \'flavor\': \'Dopo anni di silenzio, le caverne tornano a riecheggiare con i raccapriccianti rumori dei preparativi di guerra Phyrexiani.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575768&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e5672728-86e5-4d19-9660-379f9c54fb08\', \'multiverseId\': 575768}, \'multiverseid\': 575768}, {\'name\': \'コイロスの洞窟\', \'text\': \'{T}：{C}を加える。\\n{T}：{W}か{B}を加える。コイロスの洞窟はあなたに１点のダメージを与える。\', \'type\': \'土地\', \'flavor\': \'沈黙の時を経て、戦争の準備をするファイレクシア人の不気味な音が洞窟から鳴り響いた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576029&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'15d4567d-f377-4c2f-9775-c867b834f205\', \'multiverseId\': 576029}, \'multiverseid\': 576029}, {\'name\': \'Cavernas de Koilos\', \'text\': \'{T}: Adicione {C}.\\n{T}: Adicione {W} ou {B}. Cavernas de Koilos causa 1 ponto de dano a você.\', \'type\': \'Terreno\', \'flavor\': \'Depois de anos de silêncio, as cavernas ecoam novamente os sons dos phyrexianos se preparando para a guerra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576551&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0c5e3209-715c-411e-a01c-77ed372637e0\', \'multiverseId\': 576551}, \'multiverseid\': 576551}, {\'name\': \'喀洛斯洞窟\', \'text\': \'{T}：加{C}。\\n{T}：加{W}或{B}。喀洛斯洞窟对你造成1点伤害。\', \'type\': \'地\', \'flavor\': \'沉寂多年后，洞窟内再度回荡起非瑞克西亚人备战声响。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577073&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7cb6ddb8-a1e7-449f-be7b-324788159997\', \'multiverseId\': 577073}, \'multiverseid\': 577073}]', "[{'name': 'Höhlen von Koilos', 'text': '{T}: Erzeuge {C}.\\n{T}: Erzeuge {W} oder {B}. Die Höhlen von Koilos fügen dir 1 Schadenspunkt zu.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577370&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'aada0766-6a00-405d-a1d4-0ea9d0b6e325', 'multiverseId': 577370}, 'multiverseid': 577370}, {'name': 'Cuevas de Koilos', 'text': '{T}: Agrega {C}.\\n{T}: Agrega {W} o {B}. Las Cuevas de Koilos te hacen 1 punto de daño.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577376&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'eac31593-20e0-4c7a-ae57-89a0d98a7b94', 'multiverseId': 577376}, 'multiverseid': 577376}, {'name': 'Cavernes de Koïlos', 'text': '{T} : Ajoutez {C}.\\n{T} : Ajoutez {W} ou {B}. Les Cavernes de Koïlos vous infligent 1 blessure.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577382&type=card', 'language': 'French', 'identifiers': {'scryfallId': '5f6e020b-bb39-4782-8ab8-c728f9ea1072', 'multiverseId': 577382}, 'multiverseid': 577382}, {'name': 'Caverne di Koilos', 'text': '{T}: Aggiungi {C}.\\n{T}: Aggiungi {W} o {B}. Le Caverne di Koilos ti infliggono 1 danno.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577388&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'bdf83b44-eb20-48ac-9e37-b69d91af7393', 'multiverseId': 577388}, 'multiverseid': 577388}, {'name': 'コイロスの洞窟', 'text': '{T}：{C}を加える。\\n{T}：{W}か{B}を加える。コイロスの洞窟はあなたに１点のダメージを与える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577394&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '75deeca5-1b85-4c00-bd58-ee746312b857', 'multiverseId': 577394}, 'multiverseid': 577394}, {'name': 'Cavernas de Koilos', 'text': '{T}: Adicione {C}.\\n{T}: Adicione {W} ou {B}. Cavernas de Koilos causa 1 ponto de dano a você.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577406&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fa5f6bf5-9e61-44ca-90d4-956c0593886e', 'multiverseId': 577406}, 'multiverseid': 577406}, {'name': '喀洛斯洞窟', 'text': '{T}：加{C}。\\n{T}：加{W}或{B}。喀洛斯洞窟对你造成1点伤害。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577418&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '4e401185-db39-4a7b-bbe8-cfed92be2edf', 'multiverseId': 577418}, 'multiverseid': 577418}]", '[{\'name\': \'Idyllischer Strand\', \'text\': \'({T}: Erzeuge {W} oder {U}.)\\nDer Idyllische Strand kommt getappt ins Spiel.\', \'type\': \'Land — Ebene, Insel\', \'flavor\': \'In der Tradition der ursprünglichen Akademie von Tolaria wird jeder tolarianische Campus in der Nähe eines Gewässers gebaut.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574990&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'827a45d0-8eda-4435-a252-f28b69e47b09\', \'multiverseId\': 574990}, \'multiverseid\': 574990}, {\'name\': \'Litoral idílico\', \'text\': \'({T}: Agrega {W} o {U}.)\\nEl Litoral idílico entra al campo de batalla girado.\', \'type\': \'Tierra — Llanura isla\', \'flavor\': \'Según la tradición de la primera Academia tolariana, todos los campus tolarianos se construyen cerca de una masa de agua.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575251&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c6f38d01-1a5f-4ee0-9947-c2003400f5d2\', \'multiverseId\': 575251}, \'multiverseid\': 575251}, {\'name\': \'Plage idyllique\', \'text\': \'({T} : Ajoutez {W} ou {U}.)\\nLa Plage idyllique arrive sur le champ de bataille engagée.\', \'type\': \'Terrain : plaine et île\', \'flavor\': "Dans la tradition de la première Académie tolariane, chaque campus tolarian est construit proche d\'une étendue d\'eau.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575512&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e5b62126-9660-4086-9aa3-4e29578803ad\', \'multiverseId\': 575512}, \'multiverseid\': 575512}, {\'name\': \'Litorale Idilliaco\', \'text\': \'({T}: Aggiungi {W} o {U}.)\\nIl Litorale Idilliaco entra nel campo di battaglia TAPpato.\', \'type\': \'Terra — Pianura Isola\', \'flavor\': "Per mantenere viva la tradizione dell\'Accademia di Tolaria originale, ogni campus di Tolaria viene eretto nelle vicinanze di uno specchio d\'acqua.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575773&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'54fc8668-60fb-497b-a939-5d62c93d47c7\', \'multiverseId\': 575773}, \'multiverseid\': 575773}, {\'name\': \'理想的な浜方\', \'text\': \'（{T}：{W}か{U}を加える。）\\n理想的な浜方はタップ状態で戦場に出る。\', \'type\': \'土地 — 平地・島\', \'flavor\': \'元祖トレイリアのアカデミーの伝統にならい、トレイリアの全キャンパスは水際に建設されている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576034&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ff9bec98-b603-4dbf-9058-d9eb095266c5\', \'multiverseId\': 576034}, \'multiverseid\': 576034}, {\'name\': \'Beira-mar Idílica\', \'text\': \'({T}: Adicione {W} ou {U}.)\\nBeira-mar Idílica entra no campo de batalha virada.\', \'type\': \'Terreno — Planície Ilha\', \'flavor\': \'Seguindo a tradição da Academia Tolariana original, todo campus tolariano é construído próximo à água.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576556&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'835debc5-4294-46d9-9d10-af228a7d4ff2\', \'multiverseId\': 576556}, \'multiverseid\': 576556}, {\'name\': \'田园滩岸\', \'text\': \'（{T}：加{W}或{U}。）\\n田园滩岸须横置进战场。\', \'type\': \'地 ～平原／海岛\', \'flavor\': \'按照旧陶拉里亚大学院的传统，每个陶拉里亚校园都傍水而建。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577078&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'14efefe9-bd66-4f22-ab8c-5545cbce3d23\', \'multiverseId\': 577078}, \'multiverseid\': 577078}]', '[{\'name\': \'Impuls\', \'text\': \'Schaue dir die obersten vier Karten deiner Bibliothek an. Nimm eine davon auf deine Hand und lege den Rest in beliebiger Reihenfolge unter deine Bibliothek.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ich habe schon immer schnelle Entscheidungen getroffen. Jetzt, wo ich älter und weiser bin, bin ich nur besser darin, die richtigen zu treffen."\\n—Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574796&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d9f5a7a6-fa9b-441a-bf29-90d690ca7edd\', \'multiverseId\': 574796}, \'multiverseid\': 574796}, {\'name\': \'Impulso\', \'text\': \'Mira las cuatro primeras cartas de tu biblioteca. Pon una de ellas en tu mano y el resto en el fondo de tu biblioteca en cualquier orden.\', \'type\': \'Instantáneo\', \'flavor\': \'"Tomo mis decisiones casi sin pensar desde siempre, pero ahora la edad y la sabiduría me ayudan a acertar".\\n—Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575057&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b30ed454-77ac-4df1-bc17-92b6fbf0879f\', \'multiverseId\': 575057}, \'multiverseid\': 575057}, {\'name\': \'Impulsion\', \'text\': "Regardez les quatre cartes du dessus de votre bibliothèque. Mettez l\'une d\'elles dans votre main et le reste au-dessous de votre bibliothèque, dans l\'ordre de votre choix.", \'type\': \'Éphémère\', \'flavor\': "« J\'ai toujours pris des décisions sans réfléchir. Mais je sais mieux prendre les bonnes maintenant que je suis plus vieux et plus expérimenté. »\\n—Téfeiri", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575318&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7ff2e532-264a-44cf-8888-360511c0e111\', \'multiverseId\': 575318}, \'multiverseid\': 575318}, {\'name\': \'Impulso\', \'text\': \'Guarda le prime quattro carte del tuo grimorio. Aggiungine una alla tua mano e metti le altre in fondo al tuo grimorio in qualsiasi ordine.\', \'type\': \'Istantaneo\', \'flavor\': \'"Ho sempre preso decisioni affrettate. Sono solo diventato più bravo a prendere quelle giuste, ora che sono più anziano e saggio."\\n—Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575579&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'305cfee0-fc76-4140-8699-4b2a9eb87f6d\', \'multiverseId\': 575579}, \'multiverseid\': 575579}, {\'name\': \'衝動\', \'text\': \'あなたのライブラリーの一番上にあるカード４枚を見る。そのうち１枚をあなたの手札に、残りをあなたのライブラリーの一番下に望む順番で置く。\', \'type\': \'インスタント\', \'flavor\': \'「私は常日頃から即断してきた。年を重ねて賢くなるにつれ、正しい方を選べるようになっただけなのだ。」\\n――テフェリー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575840&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fd434e48-b5f4-4a42-882d-d440c08181bf\', \'multiverseId\': 575840}, \'multiverseid\': 575840}, {\'name\': \'Impulso\', \'text\': \'Olhe os quatro cards do topo de seu grimório. Coloque um deles na sua mão e os restantes no fundo do seu grimório em qualquer ordem.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Eu sempre tomei decisões rápidas. Simplesmente melhorei minha capacidade de tomar as decisões certas, agora que estou mais velho e mais sábio."\\n— Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576362&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'72a2a631-7b0c-41fe-9844-8fd5d290bb7d\', \'multiverseId\': 576362}, \'multiverseid\': 576362}, {\'name\': \'冲动\', \'text\': \'检视你牌库顶的四张牌。将其中一张置于你手上，其余的牌则以任意顺序置于你的牌库底。\', \'type\': \'瞬间\', \'flavor\': \'「我一向决断迅速。只是我现在随着年岁阅历增长，决断也越来越正确。」\\n～泰菲力\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576884&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'20f3f3da-6cb7-4b7a-9783-729a61cba64f\', \'multiverseId\': 576884}, \'multiverseid\': 576884}]', "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578497&type=card', 'language': 'German', 'identifiers': {'scryfallId': '7191b696-6f3d-40e4-8fa8-4fa7133f28ea', 'multiverseId': 578497}, 'multiverseid': 578497}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578502&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '9347624c-7c3f-4d22-83fe-31fca7cb75f8', 'multiverseId': 578502}, 'multiverseid': 578502}, {'name': 'Île', 'type': 'Terrain de base : Île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578507&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ddf8f690-53e0-4c82-969a-30fbd6fa5666', 'multiverseId': 578507}, 'multiverseid': 578507}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578512&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ec97acd5-607d-412e-9ca7-dbe0f6624f92', 'multiverseId': 578512}, 'multiverseid': 578512}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578517&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '69a37eaf-5432-4484-813a-dc160220ae5c', 'multiverseId': 578517}, 'multiverseid': 578517}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578527&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0609369b-c7ae-4c61-845c-03f102c11425', 'multiverseId': 578527}, 'multiverseid': 578527}, {'name': '海岛', 'type': '基本地 ～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578537&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '86e8e4d1-b28f-4c0c-81a5-cdc9cac068b6', 'multiverseId': 578537}, 'multiverseid': 578537}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578564&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c48208e3-e80b-4b59-8a04-d2751ec0518f', 'multiverseId': 578564}, 'multiverseid': 578564}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578579&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ee6b903d-fa39-4774-8ef8-9693dd96a3ef', 'multiverseId': 578579}, 'multiverseid': 578579}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578594&type=card', 'language': 'French', 'identifiers': {'scryfallId': '77f9444e-ef29-40d7-9b78-f7d3e7accf28', 'multiverseId': 578594}, 'multiverseid': 578594}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578609&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'eaf5cc6b-ce45-4bdb-9499-bf75ab188040', 'multiverseId': 578609}, 'multiverseid': 578609}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578624&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'b5234e2c-ab5f-4c3e-87bc-59650669fb4c', 'multiverseId': 578624}, 'multiverseid': 578624}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578654&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd54c21f9-57ef-4538-ad37-be873e764137', 'multiverseId': 578654}, 'multiverseid': 578654}, {'name': '海岛', 'type': '基本地 ～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578684&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '748b6d36-f60f-4e8d-97c2-87dd74ba8d30', 'multiverseId': 578684}, 'multiverseid': 578684}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578565&type=card', 'language': 'German', 'identifiers': {'scryfallId': '674faaa4-f86c-4443-a7e1-66a37b51b5fd', 'multiverseId': 578565}, 'multiverseid': 578565}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578580&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'b0e4887f-1da7-47f8-bdb2-5a68c65b8589', 'multiverseId': 578580}, 'multiverseid': 578580}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578595&type=card', 'language': 'French', 'identifiers': {'scryfallId': '19777ce9-715f-4941-a616-07378dcc958c', 'multiverseId': 578595}, 'multiverseid': 578595}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578610&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3f8f6ba5-7a2c-4e03-9ca8-601f666f2c9d', 'multiverseId': 578610}, 'multiverseid': 578610}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578625&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'a60c0ed8-e318-445c-8019-18f7b559eeb2', 'multiverseId': 578625}, 'multiverseid': 578625}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578655&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '67cc5a5d-b938-4b98-9800-9d0c2e0a36b6', 'multiverseId': 578655}, 'multiverseid': 578655}, {'name': '海岛', 'type': '基本地 ～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578685&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '09c25f9d-4fa7-455c-9e89-e9fa398d8b87', 'multiverseId': 578685}, 'multiverseid': 578685}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578566&type=card', 'language': 'German', 'identifiers': {'scryfallId': '721987ab-7a42-444c-bd4d-9bd7df2884b0', 'multiverseId': 578566}, 'multiverseid': 578566}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578581&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'a78dd264-aaf7-4243-877a-458fd3c357eb', 'multiverseId': 578581}, 'multiverseid': 578581}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578596&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b1e84937-a878-4820-83be-b335e7961db5', 'multiverseId': 578596}, 'multiverseid': 578596}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578611&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '6ee33d97-8a0d-4fcd-8ad6-e71a527ba35c', 'multiverseId': 578611}, 'multiverseid': 578611}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578626&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f47b9e5b-4aa2-45f0-8caa-dd965eddf196', 'multiverseId': 578626}, 'multiverseid': 578626}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578656&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5dfe75bf-7510-4ba7-b920-f94f07832631', 'multiverseId': 578656}, 'multiverseid': 578656}, {'name': '海岛', 'type': '基本地 ～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578686&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '0669acf1-85c1-436f-9b05-3bd35073ce37', 'multiverseId': 578686}, 'multiverseid': 578686}]", '[{\'name\': \'Ivy die Zauberdiebin\', \'text\': \'Fliegend\\nImmer wenn ein Spieler einen Zauberspruch wirkt, der nur eine einzelne Kreatur, die nicht Ivy die Zauberdiebin ist, als Ziel hat, kannst du den Zauberspruch kopieren. Die Kopie hat Ivy als Ziel. (Eine Kopie eines Aura-Zauberspruchs wird zu einem Spielstein.)\', \'type\': \'Legendäre Kreatur — Feenwesen, Räuber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574942&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'91f24fc4-e4a5-4120-86e6-099d866e896f\', \'multiverseId\': 574942}, \'multiverseid\': 574942}, {\'name\': \'Ivy, robahechizos jubilosa\', \'text\': \'Vuela.\\nSiempre que un jugador lance un hechizo que solo haga objetivo a una única criatura que no sea Ivy, robahechizos jubilosa, puedes copiar ese hechizo. La copia hace objetivo a Ivy. (Una copia de un hechizo de Aura se convierte en una ficha.)\', \'type\': \'Criatura legendaria — Bribón hada\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575203&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d0cab902-4dd3-426c-bb06-140ac51046be\', \'multiverseId\': 575203}, \'multiverseid\': 575203}, {\'name\': \'Lierre, volesort joyeuse\', \'text\': "Vol\\nÀ chaque fois qu\'un joueur lance un sort qui cible une seule créature autre que Lierre, volesort joyeuse, vous pouvez copier ce sort. Cette copie cible Lierre. (Une copie d\'un sort d\'aura devient un jeton.)", \'type\': \'Créature légendaire : peuple fée et gredin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575464&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'aeefa768-0930-4738-a219-c402ccf88b59\', \'multiverseId\': 575464}, \'multiverseid\': 575464}, {\'name\': \'Ivy, Razziamagie Gioiosa\', \'text\': \'Volare\\nOgniqualvolta un giocatore lancia una magia che bersaglia solo una creatura diversa da Ivy, Razziamagie Gioiosa, puoi copiare quella magia. La copia bersaglia Ivy. (Una copia di una magia Aura diventa una pedina.)\', \'type\': \'Creatura Leggendaria — Farabutto Spiritello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575725&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1cffa013-5716-4b9b-803e-a4c0f1c2baea\', \'multiverseId\': 575725}, \'multiverseid\': 575725}, {\'name\': \'陽気な呪文盗み、アイヴィー\', \'text\': \'飛行\\nプレイヤー１人が陽気な呪文盗み、アイヴィーでないクリーチャー１体だけを対象とする呪文を唱えるたび、あなたはその呪文をコピーしてもよい。そのコピーは陽気な呪文盗み、アイヴィーを対象とする。（オーラ・呪文のコピーはトークンになる。）\', \'type\': \'伝説のクリーチャー — フェアリー・ならず者\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575986&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5c231b8d-dc5e-456f-af47-0f24cea02d97\', \'multiverseId\': 575986}, \'multiverseid\': 575986}, {\'name\': \'Hera, Cleptomaga Alegre\', \'text\': \'Voar\\nToda vez que um jogador conjura uma mágica que tenha como alvo uma única criatura que não seja Hera, Cleptomaga Alegre, você pode copiar aquela mágica. A cópia tem Hera como alvo. (Uma cópia de uma mágica de Aura se torna uma ficha.)\', \'type\': \'Criatura Lendária — Fada Ladino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576508&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7dcf3068-2484-4cbb-a33f-fab62ced4032\', \'multiverseId\': 576508}, \'multiverseid\': 576508}, {\'name\': \'欢笑窃咒客艾薇\', \'text\': \'飞行\\n每当任一牌手施放仅以单一生物为目标的咒语，且该生物不是欢笑窃咒客艾薇时，你可以复制该咒语。该复制品以艾薇为目标。（灵气咒语的复制品会成为衍生物。）\', \'type\': \'传奇生物 ～仙灵／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577030&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6506f03e-2e84-4ba7-a986-5543705800ed\', \'multiverseId\': 577030}, \'multiverseid\': 577030}]', '[{\'name\': \'Ivy die Zauberdiebin\', \'text\': \'Fliegend\\nImmer wenn ein Spieler einen Zauberspruch wirkt, der nur eine einzelne Kreatur, die nicht Ivy die Zauberdiebin ist, als Ziel hat, kannst du den Zauberspruch kopieren. Die Kopie hat Ivy als Ziel.\', \'type\': \'Legendäre Kreatur — Feenwesen, Räuber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577887&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ed4ab11d-b9e9-4884-8fe3-5ed5e852ec7f\', \'multiverseId\': 577887}, \'multiverseid\': 577887}, {\'name\': \'Lierre, volesort joyeuse\', \'text\': "Vol\\nÀ chaque fois qu\'un joueur lance un sort qui cible une seule créature autre que Lierre, volesort joyeuse, vous pouvez copier ce sort. Cette copie cible Lierre.", \'type\': \'Créature légendaire : peuple fée et gredin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577928&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'60c6b321-e2cc-44dc-8086-a702d35e67d1\', \'multiverseId\': 577928}, \'multiverseid\': 577928}, {\'name\': \'陽気な呪文盗み、アイヴィー\', \'text\': \'飛行\\nプレイヤー１人が陽気な呪文盗み、アイヴィーでないクリーチャー１体だけを対象とする呪文を唱えるたび、あなたはその呪文をコピーしてもよい。そのコピーは陽気な呪文盗み、アイヴィーを対象とする。\', \'type\': \'伝説のクリーチャー — フェアリー・ならず者\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577969&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9afefa50-b66e-47d0-860b-fc6886fe1ff5\', \'multiverseId\': 577969}, \'multiverseid\': 577969}, {\'name\': \'欢笑窃咒客艾薇\', \'text\': \'飞行\\n每当任一牌手施放仅以单一生物为目标的咒语，且该生物不是欢笑窃咒客艾薇时，你可以复制该咒语。该复制品以艾薇为目标。\', \'type\': \'传奇生物 ～仙灵／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578010&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'44bd6e23-35a3-4e9f-a2d4-b1096a75c9ed\', \'multiverseId\': 578010}, \'multiverseid\': 578010}]', '[{\'name\': \'Ivy die Zauberdiebin\', \'text\': \'Fliegend\\nImmer wenn ein Spieler einen Zauberspruch wirkt, der nur eine einzelne Kreatur, die nicht Ivy die Zauberdiebin ist, als Ziel hat, kannst du den Zauberspruch kopieren. Die Kopie hat Ivy als Ziel.\', \'type\': \'Legendäre Kreatur — Feenwesen, Räuber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578094&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c463615a-9544-4f99-a244-858f3cf4150b\', \'multiverseId\': 578094}, \'multiverseid\': 578094}, {\'name\': \'Ivy, robahechizos jubilosa\', \'text\': \'Vuela.\\nSiempre que un jugador lance un hechizo que solo haga objetivo a una única criatura que no sea Ivy, robahechizos jubilosa, puedes copiar ese hechizo. La copia hace objetivo a Ivy.\', \'type\': \'Criatura legendaria — Bribón hada\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578135&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b572ba61-92ca-4364-9b42-142d5a868d1a\', \'multiverseId\': 578135}, \'multiverseid\': 578135}, {\'name\': \'Lierre, volesort joyeuse\', \'text\': "Vol\\nÀ chaque fois qu\'un joueur lance un sort qui cible une seule créature autre que Lierre, volesort joyeuse, vous pouvez copier ce sort. Cette copie cible Lierre.", \'type\': \'Créature légendaire : peuple fée et gredin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578176&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0990f46e-3d1c-4102-931a-e25785038f57\', \'multiverseId\': 578176}, \'multiverseid\': 578176}, {\'name\': \'Ivy, Razziamagie Gioiosa\', \'text\': \'Volare\\nOgniqualvolta un giocatore lancia una magia che bersaglia solo una creatura diversa da Ivy, Razziamagie Gioiosa, puoi copiare quella magia. La copia bersaglia Ivy.\', \'type\': \'Creatura Leggendaria — Farabutto Spiritello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578217&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e76f2c2b-1f13-4dde-807a-e63bce6a1905\', \'multiverseId\': 578217}, \'multiverseid\': 578217}, {\'name\': \'陽気な呪文盗み、アイヴィー\', \'text\': \'飛行\\nプレイヤー１人が陽気な呪文盗み、アイヴィーでないクリーチャー１体だけを対象とする呪文を唱えるたび、あなたはその呪文をコピーしてもよい。そのコピーは陽気な呪文盗み、アイヴィーを対象とする。\', \'type\': \'伝説のクリーチャー — フェアリー・ならず者\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578258&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c5fe7b4d-4bce-4d45-a946-ffce20c52e85\', \'multiverseId\': 578258}, \'multiverseid\': 578258}, {\'name\': \'Hera, Cleptomaga Alegre\', \'text\': \'Voar\\nToda vez que um jogador conjura uma mágica que tenha como alvo uma única criatura que não seja Hera, Cleptomaga Alegre, você pode copiar aquela mágica. A cópia tem Hera como alvo.\', \'type\': \'Criatura Lendária — Fada Ladino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578340&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cba0af0a-f850-4502-89d1-c63360f0c1c7\', \'multiverseId\': 578340}, \'multiverseid\': 578340}, {\'name\': \'欢笑窃咒客艾薇\', \'text\': \'飞行\\n每当任一牌手施放仅以单一生物为目标的咒语，且该生物不是欢笑窃咒客艾薇时，你可以复制该咒语。该复制品以艾薇为目标。\', \'type\': \'传奇生物 ～仙灵／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578422&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1d89795c-04d2-403c-8db6-5430b8214a05\', \'multiverseId\': 578422}, \'multiverseid\': 578422}]', '[{\'name\': \'Jaya, feurige Verhandlerin\', \'text\': \'+1: Erzeuge einen 1/1 roten Mönch-Kreaturenspielstein mit Bravour.\\n−1: Schicke die obersten zwei Karten deiner Bibliothek ins Exil. Bestimme eine davon. Du kannst sie in diesem Zug spielen.\\n−2: Bestimme eine Kreatur deiner Wahl, die ein Gegner kontrolliert. Immer wenn du in diesem Zug angreifst, fügt Jaya, feurige Verhandlerin, der Kreatur so viele Schadenspunkte zu, wie Kreaturen angreifen.\\n−8: Du erhältst ein Emblem mit „Immer wenn du einen roten Spontanzauber oder eine rote Hexerei wirkst, kopiere ihn bzw. sie zweimal. Du kannst neue Ziele für die Kopien bestimmen."\', \'type\': \'Legendärer Planeswalker — Jaya\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574874&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6c88e5fb-0d33-4953-bbfb-a8537bc2ec0a\', \'multiverseId\': 574874}, \'multiverseid\': 574874}, {\'name\': \'Jaya, negociadora ardiente\', \'text\': \'+1: Crea una ficha de criatura Monje roja 1/1 con la habilidad de destreza.\\n−1: Exilia las dos primeras cartas de tu biblioteca. Elige una de ellas. Puedes jugar esa carta este turno.\\n−2: Elige una criatura objetivo que controla un oponente. Siempre que ataques este turno, Jaya, negociadora ardiente hace una cantidad de daño a esa criatura igual a la cantidad de criaturas atacantes.\\n−8: Obtienes un emblema con "Siempre que lances un hechizo de instantáneo o de conjuro rojo, cópialo dos veces. Puedes elegir nuevos objetivos para las copias".\', \'type\': \'Planeswalker legendario — Jaya\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575135&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d14737e5-c05c-489c-9396-7a60378c2882\', \'multiverseId\': 575135}, \'multiverseid\': 575135}, {\'name\': \'Jaya, négociatrice ardente\', \'text\': "+1: Créez un jeton de créature 1/1 rouge Moine avec la prouesse.\\n-1: Exilez les deux cartes du dessus de votre bibliothèque. Choisissez l\'une d\'elles. Vous pouvez jouer cette carte ce tour-ci.\\n-2: Choisissez une créature ciblée qu\'un adversaire contrôle. À chaque fois que vous attaquez ce tour-ci, Jaya, négociatrice ardente inflige un nombre de blessures égal au nombre de créatures attaquantes à cette créature.\\n-8: Vous gagnez un emblème avec « À chaque fois que vous lancez un sort d\'éphémère ou de rituel rouge copiez-le deux fois. Vous pouvez choisir de nouvelles cibles pour ces copies. »", \'type\': \'Planeswalker légendaire : Jaya\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575396&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8c9a38aa-d7b3-47dc-a05d-b7acb4c6ae11\', \'multiverseId\': 575396}, \'multiverseid\': 575396}, {\'name\': \'Jaya, Negoziatrice Ardente\', \'text\': \'+1: Crea una pedina creatura Monaco 1/1 rossa con prodezza.\\n−1: Esilia le prime due carte del tuo grimorio. Scegli una di quelle carte. Puoi giocare quella carta in questo turno.\\n−2: Scegli una creatura bersaglio controllata da un avversario. Ogniqualvolta attacchi in questo turno, Jaya, Negoziatrice Ardente infligge a quella creatura danno pari al numero di creature attaccanti.\\n−8: Ottieni un emblema con "Ogniqualvolta lanci una magia istantaneo o stregoneria rossa, copiala due volte. Puoi scegliere nuovi bersagli per le copie".\', \'type\': \'Planeswalker Leggendario — Jaya\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575657&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'495dba2b-1f04-46f6-9918-3a90285c96ec\', \'multiverseId\': 575657}, \'multiverseid\': 575657}, {\'name\': \'焦熱の交渉人、ヤヤ\', \'text\': \'+1：果敢を持つ赤の１/１のモンク・クリーチャー・トークン１体を生成する。\\n−1：あなたのライブラリーの一番上にあるカード２枚を追放する。そのうち１枚を選ぶ。このターン、あなたはそのカードをプレイしてもよい。\\n−2：対戦相手がコントロールしているクリーチャー１体を対象とする。このターンにあなたが攻撃するたび、焦熱の交渉人、ヤヤはそのクリーチャーに攻撃クリーチャーの数に等しい点数のダメージを与える。\\n−8：あなたは「あなたがインスタントやソーサリーである赤の呪文を唱えるたび、それを２回コピーする。あなたはそれらのコピーの新しい対象を選んでもよい。」を持つ紋章を得る。\', \'type\': \'伝説のプレインズウォーカー — ヤヤ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575918&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2249969d-1aa9-4855-b8fe-ac45d5c7830e\', \'multiverseId\': 575918}, \'multiverseid\': 575918}, {\'name\': \'Jaya, Negociadora Flamejante\', \'text\': \'+1: Crie uma ficha de criatura Monge vermelha 1/1 com destreza.\\n−1: Exile os dois cards do topo de seu grimório. Escolha um deles. Você pode jogar aquele card neste turno.\\n−2: Escolha a criatura alvo que um oponente controla. Toda vez que você atacar neste turno, Jaya, Negociadora Flamejante, causará àquela criatura dano igual ao número de criaturas atacantes.\\n−8: Você recebe um emblema com "Toda vez que você conjurar uma mágica instantânea ou um feitiço vermelho, copie-o duas vezes. Você pode escolher novos alvos para as cópias".\', \'type\': \'Planeswalker Lendário — Jaya\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576440&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9d4e48d4-a97e-4369-a08a-0db6c37730ed\', \'multiverseId\': 576440}, \'multiverseid\': 576440}, {\'name\': \'烈火来使雅亚\', \'text\': \'+1：派出一个1/1红色，具灵技异能的修行僧衍生生物。\\n−1：放逐你牌库顶的两张牌。选择其中一张。本回合中，你可以使用该牌。\\n−2：选择目标由对手操控的生物。本回合中，每当你攻击时，烈火来使雅亚对该生物造成伤害，其数量等同于进行攻击的生物数量。\\n−8：你获得具有以下异能的徽记～「每当你施放红色瞬间或法术咒语时，将其复制两次。你可以为每个复制品选择新的目标。」\', \'type\': \'传奇鹏洛客 ～雅亚\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576962&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7dfa8670-9162-48d3-a488-3a2dbdad6579\', \'multiverseId\': 576962}, \'multiverseid\': 576962}]', '[{\'name\': \'Jaya, feurige Verhandlerin\', \'text\': \'+1: Erzeuge einen 1/1 roten Mönch-Kreaturenspielstein mit Bravour.\\n−1: Schicke die obersten zwei Karten deiner Bibliothek ins Exil. Bestimme eine davon. Du kannst sie in diesem Zug spielen.\\n−2: Bestimme eine Kreatur deiner Wahl, die ein Gegner kontrolliert. Immer wenn du in diesem Zug angreifst, fügt Jaya, feurige Verhandlerin, der Kreatur so viele Schadenspunkte zu, wie Kreaturen angreifen.\\n−8: Du erhältst ein Emblem mit „Immer wenn du einen roten Spontanzauber oder eine rote Hexerei wirkst, kopiere ihn bzw. sie zweimal. Du kannst neue Ziele für die Kopien bestimmen."\', \'type\': \'Legendärer Planeswalker — Jaya\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577436&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'82c9f750-2508-44bd-b5c6-3c5305b37943\', \'multiverseId\': 577436}, \'multiverseid\': 577436}, {\'name\': \'Jaya, negociadora ardiente\', \'text\': \'+1: Crea una ficha de criatura Monje roja 1/1 con la habilidad de destreza.\\n−1: Exilia las dos primeras cartas de tu biblioteca. Elige una de ellas. Puedes jugar esa carta este turno.\\n−2: Elige una criatura objetivo que controla un oponente. Siempre que ataques este turno, Jaya, negociadora ardiente hace una cantidad de daño a esa criatura igual a la cantidad de criaturas atacantes.\\n−8: Obtienes un emblema con "Siempre que lances un hechizo de instantáneo o de conjuro rojo, cópialo dos veces. Puedes elegir nuevos objetivos para las copias".\', \'type\': \'Planeswalker legendario — Jaya\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577441&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'890f1585-1c21-4a6c-b674-2ea633a5426d\', \'multiverseId\': 577441}, \'multiverseid\': 577441}, {\'name\': \'Jaya, négociatrice ardente\', \'text\': "+1: Créez un jeton de créature 1/1 rouge Moine avec la prouesse.\\n-1: Exilez les deux cartes du dessus de votre bibliothèque. Choisissez l\'une d\'elles. Vous pouvez jouer cette carte ce tour-ci.\\n-2: Choisissez une créature ciblée qu\'un adversaire contrôle. À chaque fois que vous attaquez ce tour-ci, Jaya, négociatrice ardente inflige un nombre de blessures égal au nombre de créatures attaquantes à cette créature.\\n-8: Vous gagnez un emblème avec « À chaque fois que vous lancez un sort d\'éphémère ou de rituel rouge copiez-le deux fois. Vous pouvez choisir de nouvelles cibles pour ces copies. »", \'type\': \'Planeswalker légendaire : Jaya\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577446&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5c5105dc-6f56-42db-b6b9-7c2521405618\', \'multiverseId\': 577446}, \'multiverseid\': 577446}, {\'name\': \'Jaya, Negoziatrice Ardente\', \'text\': \'+1: Crea una pedina creatura Monaco 1/1 rossa con prodezza.\\n−1: Esilia le prime due carte del tuo grimorio. Scegli una di quelle carte. Puoi giocare quella carta in questo turno.\\n−2: Scegli una creatura bersaglio controllata da un avversario. Ogniqualvolta attacchi in questo turno, Jaya, Negoziatrice Ardente infligge a quella creatura danno pari al numero di creature attaccanti.\\n−8: Ottieni un emblema con "Ogniqualvolta lanci una magia istantaneo o stregoneria rossa, copiala due volte. Puoi scegliere nuovi bersagli per le copie".\', \'type\': \'Planeswalker Leggendario — Jaya\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577451&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'26913457-32b2-4b91-9d90-0c9abd6c8673\', \'multiverseId\': 577451}, \'multiverseid\': 577451}, {\'name\': \'焦熱の交渉人、ヤヤ\', \'text\': \'+1：果敢を持つ赤の１/１のモンク・クリーチャー・トークン１体を生成する。\\n−1：あなたのライブラリーの一番上にあるカード２枚を追放する。そのうち１枚を選ぶ。このターン、あなたはそのカードをプレイしてもよい。\\n−2：対戦相手がコントロールしているクリーチャー１体を対象とする。このターンにあなたが攻撃するたび、焦熱の交渉人、ヤヤはそのクリーチャーに攻撃クリーチャーの数に等しい点数のダメージを与える。\\n−8：あなたは「あなたがインスタントやソーサリーである赤の呪文を唱えるたび、それを２回コピーする。あなたはそれらのコピーの新しい対象を選んでもよい。」を持つ紋章を得る。\', \'type\': \'伝説のプレインズウォーカー — ヤヤ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577456&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d84101c1-c0a6-4656-a56f-0501280cdb80\', \'multiverseId\': 577456}, \'multiverseid\': 577456}, {\'name\': \'Jaya, Negociadora Flamejante\', \'text\': \'+1: Crie uma ficha de criatura Monge vermelha 1/1 com destreza.\\n−1: Exile os dois cards do topo de seu grimório. Escolha um deles. Você pode jogar aquele card neste turno.\\n−2: Escolha a criatura alvo que um oponente controla. Toda vez que você atacar neste turno, Jaya, Negociadora Flamejante, causará àquela criatura dano igual ao número de criaturas atacantes.\\n−8: Você recebe um emblema com "Toda vez que você conjurar uma mágica instantânea ou um feitiço vermelho, copie-o duas vezes. Você pode escolher novos alvos para as cópias".\', \'type\': \'Planeswalker Lendário — Jaya\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577466&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8f4ce91d-965e-4aac-bcb1-35018811ce2c\', \'multiverseId\': 577466}, \'multiverseid\': 577466}, {\'name\': \'烈火来使雅亚\', \'text\': \'+1：派出一个1/1红色，具灵技异能的修行僧衍生生物。\\n−1：放逐你牌库顶的两张牌。选择其中一张。本回合中，你可以使用该牌。\\n−2：选择目标由对手操控的生物。本回合中，每当你攻击时，烈火来使雅亚对该生物造成伤害，其数量等同于进行攻击的生物数量。\\n−8：你获得具有以下异能的徽记～「每当你施放红色瞬间或法术咒语时，将其复制两次。你可以为每个复制品选择新的目标。」\', \'type\': \'传奇鹏洛客 ～雅亚\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577476&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b23e22b6-4b73-4362-98c7-34ed1a80ee81\', \'multiverseId\': 577476}, \'multiverseid\': 577476}]', '[{\'name\': \'Jayas Infernado\', \'text\': \'Jayas Infernado fügt einer Kreatur oder einem Planeswalker deiner Wahl 5 Schadenspunkte zu. Hellsicht 1. (Schaue dir die oberste Karte deiner Bibliothek an. Du kannst sie unter deine Bibliothek legen.)\', \'type\': \'Hexerei\', \'flavor\': \'„Trotz all ihrer angeblichen Fortschritte sind die Phyrexianer immer noch nicht feuerfest."\\n—Jaya Ballard\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574875&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d2a197fb-cea0-4b8b-92d0-5693073242d4\', \'multiverseId\': 574875}, \'multiverseid\': 574875}, {\'name\': \'Pirotorbellino de Jaya\', \'text\': \'El Pirotorbellino de Jaya hace 5 puntos de daño a la criatura o planeswalker objetivo. Adivina 1. (Mira la primera carta de tu biblioteca. Puedes poner esa carta en el fondo de tu biblioteca.)\', \'type\': \'Conjuro\', \'flavor\': \'"Puede que los pirexianos estén muy desarrollados, pero todavía no son ignífugos".\\n—Jaya Ballard\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575136&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9e993396-f3b1-4667-8f3d-116b0a9214a2\', \'multiverseId\': 575136}, \'multiverseid\': 575136}, {\'name\': \'Tornade de feu de Jaya\', \'text\': \'La Tornade de feu de Jaya inflige 5 blessures à une cible, créature ou planeswalker. Regard 1. (Regardez la carte du dessus de votre bibliothèque. Vous pouvez la mettre au-dessous de votre bibliothèque.)\', \'type\': \'Rituel\', \'flavor\': \'« En dépit de toutes leurs supposées avances, les Phyrexians ne sont toujours pas ignifugés. »\\n—Jaya Ballard\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575397&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bf220776-424d-4eef-a99f-8328f7c06ee9\', \'multiverseId\': 575397}, \'multiverseid\': 575397}, {\'name\': \'Tornado di Fuoco di Jaya\', \'text\': \'Il Tornado di Fuoco di Jaya infligge 5 danni a una creatura o a un planeswalker bersaglio. Profetizza 1. (Guarda la prima carta del tuo grimorio. Puoi mettere quella carta in fondo al tuo grimorio.)\', \'type\': \'Stregoneria\', \'flavor\': \'"Per quanto si vantino di essere avanzati, i Phyrexiani non sono ancora ignifughi."\\n—Jaya Ballard\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575658&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fb66c179-e164-4960-a898-1dedd1bd9198\', \'multiverseId\': 575658}, \'multiverseid\': 575658}, {\'name\': \'ヤヤの火災旋風\', \'text\': \'クリーチャーやプレインズウォーカーのうち１体を対象とする。ヤヤの火災旋風はそれに５点のダメージを与える。占術１を行う。（あなたのライブラリーの一番上にあるカード１枚を見る。あなたはそのカードをあなたのライブラリーの一番下に置いてもよい。）\', \'type\': \'ソーサリー\', \'flavor\': \'「ファイレクシア人って進んでいるらしいけど、やっぱり火には弱いみたいね。」\\n――ヤヤ・バラード\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575919&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'633d71c2-c863-4b24-b1cd-c13acd1325e7\', \'multiverseId\': 575919}, \'multiverseid\': 575919}, {\'name\': \'Tornado de Fogo de Jaya\', \'text\': \'Tornado de Fogo de Jaya causa 5 pontos de dano à criatura ou ao planeswalker alvo. Vidência 1. (Olhe o card do topo de seu grimório. Você pode colocar aquele card no fundo de seu grimório.)\', \'type\': \'Feitiço\', \'flavor\': \'"Mesmo com todos aqueles supostos avanços, os phyrexianos ainda não são à prova de fogo."\\n— Jaya Ballard\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576441&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2f1bd794-c26c-472b-8edf-d37f6e67ac2c\', \'multiverseId\': 576441}, \'multiverseid\': 576441}, {\'name\': \'雅亚的火龙卷\', \'text\': \'雅亚的火龙卷对目标生物或鹏洛客造成5点伤害。占卜1。（检视你牌库顶的牌。你可以将该牌置于你的牌库底。）\', \'type\': \'法术\', \'flavor\': \'「不管非瑞克西亚人怎么进化，他们仍然还是不防火。」\\n～雅亚巴拉德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576963&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'66eb717c-ee98-4e2f-a197-987ebdb71c36\', \'multiverseId\': 576963}, \'multiverseid\': 576963}]', '[{\'name\': \'Jedermann-Festnahme\', \'text\': \'Wenn die Jedermann-Festnahme ins Spiel kommt, schicke eine Kreatur oder einen Planeswalker deiner Wahl, die bzw. den ein Gegner kontrolliert, ins Exil, bis die Jedermann-Festnahme das Spiel verlässt.\', \'type\': \'Verzauberung\', \'flavor\': \'„Was lauert hinter den Gesichtern derjenigen, von denen du glaubst, du kannst ihnen vertrauen?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574752&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d6de58d8-ef4e-484e-819a-8c70d3b38f19\', \'multiverseId\': 574752}, \'multiverseid\': 574752}, {\'name\': \'Arresto del ciudadano\', \'text\': \'Cuando el Arresto del ciudadano entre al campo de batalla, exilia la criatura o planeswalker objetivo que controla un oponente hasta que el Arresto del ciudadano deje el campo de batalla.\', \'type\': \'Encantamiento\', \'flavor\': \'"¿Qué se oculta tras el rostro de aquellos en quien crees poder confiar?".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575013&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a51c8032-8a16-4f7a-b935-8c45b298f964\', \'multiverseId\': 575013}, \'multiverseid\': 575013}, {\'name\': \'Arrestation par un citoyen\', \'text\': "Quand l\'Arrestation par un citoyen arrive sur le champ de bataille, exilez une cible qu\'un adversaire contrôle, créature ou planeswalker, jusqu\'à ce que l\'Arrestation par un citoyen quitte le champ de bataille.", \'type\': \'Enchantement\', \'flavor\': "« Qu\'est-ce qui se dissimule derrière les visages de ceux en qui vous pensez pouvoir avoir confiance ? »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575274&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f212a542-bd76-4d0a-960f-49c47064e48a\', \'multiverseId\': 575274}, \'multiverseid\': 575274}, {\'name\': \'Arresto del Cittadino\', \'text\': "Quando l\'Arresto del Cittadino entra nel campo di battaglia, esilia una creatura o un planeswalker bersaglio controllati da un avversario finché l\'Arresto del Cittadino non lascia il campo di battaglia.", \'type\': \'Incantesimo\', \'flavor\': \'"Cosa si cela dietro i volti di coloro che ritieni degni di fiducia?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575535&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d0ca02f5-add9-4207-a4b7-7f6f9afef286\', \'multiverseId\': 575535}, \'multiverseid\': 575535}, {\'name\': \'市民の拘束\', \'text\': \'市民の拘束が戦場に出たとき、クリーチャーやプレインズウォーカーのうち対戦相手がコントロールしている１体を対象とする。それを、市民の拘束が戦場を離れるまで追放する。\', \'type\': \'エンチャント\', \'flavor\': \'「諸君が信頼を置けると思った者の顔の裏に、一体何が潜んでいると思う？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575796&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a7198707-b1c9-4694-84d2-3167e4dd5650\', \'multiverseId\': 575796}, \'multiverseid\': 575796}, {\'name\': \'Prisão de Cidadão\', \'text\': \'Quando Prisão de Cidadão entrar no campo de batalha, exile a criatura ou o planeswalker alvo que um oponente controla até que Prisão de Cidadão deixe o campo de batalha.\', \'type\': \'Encantamento\', \'flavor\': \'"O que se esconde por trás dos rostos daqueles em quem você acredita poder confiar?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576318&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ae59a0fb-94ca-4286-83eb-e8ac1d99d59a\', \'multiverseId\': 576318}, \'multiverseid\': 576318}, {\'name\': \'市民逮捕\', \'text\': \'当市民逮捕进战场时，放逐目标由对手操控的生物或鹏洛客，直到市民逮捕离开战场为止。\', \'type\': \'结界\', \'flavor\': \'「还不来看看忠厚之人表皮底下是副什么面孔？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576840&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e80bfae1-d8b5-4f5a-a7e7-dad92e6721b4\', \'multiverseId\': 576840}, \'multiverseid\': 576840}]', '[{\'name\': \'Jhoira, zeitlose Erfinderin\', \'text\': \'{T}: Lege zwei Innovationsmarken auf Jhoira, zeitlose Erfinderin. Dann kannst du eine Artefaktkarte mit Manabetrag X oder weniger aus deiner Hand ins Spiel bringen, wobei X gleich der Anzahl an Innovationsmarken auf Jhoira ist.\', \'type\': \'Legendäre Kreatur — Mensch, Handwerker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574943&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ba297ae2-919e-4fa5-83b2-961318daf9c2\', \'multiverseId\': 574943}, \'multiverseid\': 574943}, {\'name\': \'Jhoira, innovadora atemporal\', \'text\': \'{T}: Pon dos contadores de ingenio sobre Jhoira, innovadora atemporal. Luego, puedes poner en el campo de batalla una carta de artefacto con valor de maná de X o menos de tu mano, donde X es la cantidad de contadores de ingenio sobre Jhoira.\', \'type\': \'Criatura legendaria — Artífice humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575204&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7b4fb065-5eb4-4300-bf37-ad5e2bb20636\', \'multiverseId\': 575204}, \'multiverseid\': 575204}, {\'name\': \'Djoïra, innovatrice sans âge\', \'text\': "{T} : Mettez deux marqueurs « ingénuité » sur Djoïra, innovatrice sans âge, puis vous pouvez mettre sur le champ de bataille une carte d\'artefact avec une valeur de mana inférieure ou égale à X depuis votre main, X étant le nombre de marqueurs « ingénuité » sur Djoïra.", \'type\': \'Créature légendaire : humain et artificier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575465&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cbb5ca5f-0754-4a61-915c-1a030e50c300\', \'multiverseId\': 575465}, \'multiverseid\': 575465}, {\'name\': \'Jhoira, Innovatrice Eterna\', \'text\': \'{T}: Metti due segnalini ingegno su Jhoira, Innovatrice Eterna, poi puoi mettere sul campo di battaglia una carta artefatto con valore di mana pari o inferiore a X dalla tua mano, dove X è il numero di segnalini ingegno su Jhoira.\', \'type\': \'Creatura Leggendaria — Artefice Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575726&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'31830bd1-12a2-4ee1-890f-21bb9c1a3984\', \'multiverseId\': 575726}, \'multiverseid\': 575726}, {\'name\': \'老いざる革新者、ジョイラ\', \'text\': \'{T}：老いざる革新者、ジョイラの上に発明カウンター２個を置く。その後、あなたの手札にありマナ総量がＸ以下であるアーティファクト・カード１枚を戦場に出してもよい。Ｘは老いざる革新者、ジョイラの上にある発明カウンターの数に等しい。\', \'type\': \'伝説のクリーチャー — 人間・工匠\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575987&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'83b433ac-0ad8-40bd-8871-ad9b7ee701ed\', \'multiverseId\': 575987}, \'multiverseid\': 575987}, {\'name\': \'Jhoira, Inovadora Eterna\', \'text\': \'{T}: Coloque dois marcadores de engenhosidade em Jhoira, Inovadora Eterna. Depois, você pode colocar no campo de batalha um card de artefato com valor de mana igual ou inferior a X da sua mão, sendo X o número de marcadores de engenhosidade em Jhoira.\', \'type\': \'Criatura Lendária — Humano Artesão\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576509&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5150aa67-c19a-43bf-a6ef-f8c073bc853f\', \'multiverseId\': 576509}, \'multiverseid\': 576509}, {\'name\': \'长生发明家尤依拉\', \'text\': \'{T}：在长生发明家尤依拉上放置两个精妙指示物，然后你可以将一张法术力值等于或小于X的神器牌从你手上放进战场，X为尤依拉上精妙指示物的数量。\', \'type\': \'传奇生物 ～人类／神器师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577031&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'255f9954-0a07-4ea1-be50-73d25bc16360\', \'multiverseId\': 577031}, \'multiverseid\': 577031}]', '[{\'name\': \'Jhoira, zeitlose Erfinderin\', \'text\': \'{T}: Lege zwei Innovationsmarken auf Jhoira, zeitlose Erfinderin. Dann kannst du eine Artefaktkarte mit Manabetrag X oder weniger aus deiner Hand ins Spiel bringen, wobei X gleich der Anzahl an Innovationsmarken auf Jhoira ist.\', \'type\': \'Legendäre Kreatur — Mensch, Handwerker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577888&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b71d51f4-a639-4729-831c-33013b928e06\', \'multiverseId\': 577888}, \'multiverseid\': 577888}, {\'name\': \'Djoïra, innovatrice sans âge\', \'text\': "{T} : Mettez deux marqueurs « ingénuité » sur Djoïra, innovatrice sans âge, puis vous pouvez mettre sur le champ de bataille une carte d\'artefact avec une valeur de mana inférieure ou égale à X depuis votre main, X étant le nombre de marqueurs « ingénuité » sur Djoïra.", \'type\': \'Créature légendaire : humain et artificier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577929&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'12107673-0597-4627-8e4a-3fb53cfde61b\', \'multiverseId\': 577929}, \'multiverseid\': 577929}, {\'name\': \'老いざる革新者、ジョイラ\', \'text\': \'{T}：老いざる革新者、ジョイラの上に発明カウンター２個を置く。その後、あなたの手札にありマナ総量がＸ以下であるアーティファクト・カード１枚を戦場に出してもよい。Ｘは老いざる革新者、ジョイラの上にある発明カウンターの数に等しい。\', \'type\': \'伝説のクリーチャー — 人間・工匠\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577970&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9263bde2-33a4-4005-9eb4-45dbed365516\', \'multiverseId\': 577970}, \'multiverseid\': 577970}, {\'name\': \'长生发明家尤依拉\', \'text\': \'{T}：在长生发明家尤依拉上放置两个精妙指示物，然后你可以将一张法术力值等于或小于X的神器牌从你手上放进战场，X为尤依拉上精妙指示物的数量。\', \'type\': \'传奇生物 ～人类／神器师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578011&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'aed00141-3534-4565-b055-4f23daaec50c\', \'multiverseId\': 578011}, \'multiverseid\': 578011}]', '[{\'name\': \'Jhoira, zeitlose Erfinderin\', \'text\': \'{T}: Lege zwei Innovationsmarken auf Jhoira, zeitlose Erfinderin. Dann kannst du eine Artefaktkarte mit Manabetrag X oder weniger aus deiner Hand ins Spiel bringen, wobei X gleich der Anzahl an Innovationsmarken auf Jhoira ist.\', \'type\': \'Legendäre Kreatur — Mensch, Handwerker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578095&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1c891fa4-bebd-4f81-8cd7-49b52b337c49\', \'multiverseId\': 578095}, \'multiverseid\': 578095}, {\'name\': \'Jhoira, innovadora atemporal\', \'text\': \'{T}: Pon dos contadores de ingenio sobre Jhoira, innovadora atemporal. Luego, puedes poner en el campo de batalla una carta de artefacto con valor de maná de X o menos de tu mano, donde X es la cantidad de contadores de ingenio sobre Jhoira.\', \'type\': \'Criatura legendaria — Artífice humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578136&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'026e1622-90bf-4868-bc62-4c5108f83097\', \'multiverseId\': 578136}, \'multiverseid\': 578136}, {\'name\': \'Djoïra, innovatrice sans âge\', \'text\': "{T} : Mettez deux marqueurs « ingénuité » sur Djoïra, innovatrice sans âge, puis vous pouvez mettre sur le champ de bataille une carte d\'artefact avec une valeur de mana inférieure ou égale à X depuis votre main, X étant le nombre de marqueurs « ingénuité » sur Djoïra.", \'type\': \'Créature légendaire : humain et artificier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578177&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6a3c1418-425a-4132-a72a-f8d4b4575607\', \'multiverseId\': 578177}, \'multiverseid\': 578177}, {\'name\': \'Jhoira, Innovatrice Eterna\', \'text\': \'{T}: Metti due segnalini ingegno su Jhoira, Innovatrice Eterna, poi puoi mettere sul campo di battaglia una carta artefatto con valore di mana pari o inferiore a X dalla tua mano, dove X è il numero di segnalini ingegno su Jhoira.\', \'type\': \'Creatura Leggendaria — Artefice Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578218&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a9504f81-247b-4eee-b989-294dc2c0f10b\', \'multiverseId\': 578218}, \'multiverseid\': 578218}, {\'name\': \'老いざる革新者、ジョイラ\', \'text\': \'{T}：老いざる革新者、ジョイラの上に発明カウンター２個を置く。その後、あなたの手札にありマナ総量がＸ以下であるアーティファクト・カード１枚を戦場に出してもよい。Ｘは老いざる革新者、ジョイラの上にある発明カウンターの数に等しい。\', \'type\': \'伝説のクリーチャー — 人間・工匠\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578259&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'54fcef76-c2df-455d-9e3d-c8eb963fd0a0\', \'multiverseId\': 578259}, \'multiverseid\': 578259}, {\'name\': \'Jhoira, Inovadora Eterna\', \'text\': \'{T}: Coloque dois marcadores de engenhosidade em Jhoira, Inovadora Eterna. Depois, você pode colocar no campo de batalha um card de artefato com valor de mana igual ou inferior a X da sua mão, sendo X o número de marcadores de engenhosidade em Jhoira.\', \'type\': \'Criatura Lendária — Humano Artesão\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578341&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fba4ac2f-f707-4942-ae9f-62e4803ac54e\', \'multiverseId\': 578341}, \'multiverseid\': 578341}, {\'name\': \'长生发明家尤依拉\', \'text\': \'{T}：在长生发明家尤依拉上放置两个精妙指示物，然后你可以将一张法术力值等于或小于X的神器牌从你手上放进战场，X为尤依拉上精妙指示物的数量。\', \'type\': \'传奇生物 ～人类／神器师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578423&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b4be6ca3-4e88-4561-a5f9-4acf73bb46f1\', \'multiverseId\': 578423}, \'multiverseid\': 578423}]', '[{\'name\': \'Jodah der Einende\', \'text\': \'Legendäre Kreaturen, die du kontrollierst, erhalten +X/+X, wobei X gleich der Anzahl an legendären Kreaturen ist, die du kontrollierst.\\nImmer wenn du einen legendären Zauberspruch aus deiner Hand wirkst, schicke Karten oben von deiner Bibliothek ins Exil, bis du eine legendäre Nichtland-Karte mit niedrigerem Manabetrag ins Exil schickst. Du kannst die Karte wirken, ohne ihre Manakosten zu bezahlen. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.\', \'type\': \'Legendäre Kreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574944&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'34423a91-14bb-4a5c-8251-47f023adae54\', \'multiverseId\': 574944}, \'multiverseid\': 574944}, {\'name\': \'Jodah, el Unificador\', \'text\': \'Las criaturas legendarias que controlas obtienen +X/+X, donde X es la cantidad de criaturas legendarias que controlas.\\nSiempre que lances un hechizo legendario desde tu mano, exilia cartas de la parte superior de tu biblioteca hasta que exilies una carta legendaria que no sea tierra con menor valor de maná. Puedes lanzar esa carta sin pagar su coste de maná. Pon el resto en el fondo de tu biblioteca en un orden aleatorio.\', \'type\': \'Criatura legendaria — Hechicero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575205&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d4f81a5d-7139-49e0-8530-92366b824acb\', \'multiverseId\': 575205}, \'multiverseid\': 575205}, {\'name\': "Jodah, l\'Unificateur", \'text\': "Les créatures légendaires que vous contrôlez gagnent +X/+X, X étant le nombre de créatures légendaires que vous contrôlez.\\nÀ chaque fois que vous lancez un sort légendaire depuis votre main, exilez les cartes du dessus de votre bibliothèque jusqu\'à ce que vous exiliez une carte non-terrain légendaire avec une valeur de mana inférieure. Vous pouvez lancer cette carte sans payer son coût de mana. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.", \'type\': \'Créature légendaire : humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575466&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c783f8db-2865-43af-8c65-e1971a6ac0c8\', \'multiverseId\': 575466}, \'multiverseid\': 575466}, {\'name\': "Jodah, l\'Unificatore", \'text\': \'Le creature leggendarie che controlli prendono +X/+X, dove X è il numero di creature leggendarie che controlli.\\nOgniqualvolta lanci una magia leggendaria dalla tua mano, esilia carte dalla cima del tuo grimorio finché non esili una carta non terra leggendaria con valore di mana inferiore. Puoi lanciare quella carta senza pagare il suo costo di mana. Metti le altre in fondo al tuo grimorio in ordine casuale.\', \'type\': \'Creatura Leggendaria — Mago Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575727&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1bd651da-ecc5-4210-a99e-a97a1674e2ce\', \'multiverseId\': 575727}, \'multiverseid\': 575727}, {\'name\': \'統べるもの、ジョダー\', \'text\': \'あなたがコントロールしているすべての伝説のクリーチャーは＋Ｘ/＋Ｘの修整を受ける。Ｘはあなたがコントロールしている伝説のクリーチャーの数に等しい。\\nあなたがあなたの手札から伝説の呪文を唱えるたび、マナ総量がそれより小さく伝説であり土地でないカード１枚が追放されるまで、あなたのライブラリーの一番上から１枚ずつ追放していく。あなたはそのカードをマナ・コストを支払うことなく唱えてもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'伝説のクリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575988&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'593009c7-308a-467c-9680-77147bf1b1af\', \'multiverseId\': 575988}, \'multiverseid\': 575988}, {\'name\': \'Jodah, o Unificador\', \'text\': \'As criaturas lendárias que você controla recebem +X/+X, sendo X o número de criaturas lendárias que você controla.\\nToda vez que você conjurar uma mágica lendária da sua mão, exile cards do topo de seu grimório até exilar um card lendário não de terreno com valor de mana inferior. Você pode conjurar aquele card sem pagar seu custo de mana. Coloque o restante no fundo de seu grimório em ordem aleatória.\', \'type\': \'Criatura Lendária — Humano Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576510&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7dd637fd-c995-428e-8929-eb792a7b96a8\', \'multiverseId\': 576510}, \'multiverseid\': 576510}, {\'name\': \'诸界一统裘达\', \'text\': \'由你操控的传奇生物得+X/+X，X为由你操控的传奇生物数量。\\n每当你从你手上施放传奇咒语时，从你牌库顶开始放逐牌，直到放逐一张法术力值比它小的传奇非地牌为止。你可以施放该牌，且不需支付其法术力费用。将其余的牌以随机顺序置于你牌库底。\', \'type\': \'传奇生物 ～人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577032&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'495ce2ee-217d-4944-ad9d-b04db785b8af\', \'multiverseId\': 577032}, \'multiverseid\': 577032}]', '[{\'name\': \'Jodah der Einende\', \'text\': \'Legendäre Kreaturen, die du kontrollierst, erhalten +X/+X, wobei X gleich der Anzahl an legendären Kreaturen ist, die du kontrollierst.\\nImmer wenn du einen legendären Zauberspruch aus deiner Hand wirkst, schicke Karten oben von deiner Bibliothek ins Exil, bis du eine legendäre Nichtland-Karte mit niedrigerem Manabetrag ins Exil schickst. Du kannst die Karte wirken, ohne ihre Manakosten zu bezahlen. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.\', \'type\': \'Legendäre Kreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578096&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c4dba795-b090-42c2-94ef-fa1db2ce8a6a\', \'multiverseId\': 578096}, \'multiverseid\': 578096}, {\'name\': \'Jodah, el Unificador\', \'text\': \'Las criaturas legendarias que controlas obtienen +X/+X, donde X es la cantidad de criaturas legendarias que controlas.\\nSiempre que lances un hechizo legendario desde tu mano, exilia cartas de la parte superior de tu biblioteca hasta que exilies una carta legendaria que no sea tierra con menor valor de maná. Puedes lanzar esa carta sin pagar su coste de maná. Pon el resto en el fondo de tu biblioteca en un orden aleatorio.\', \'type\': \'Criatura legendaria — Hechicero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578137&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2dee273f-326d-4b20-bacd-160c58c553f3\', \'multiverseId\': 578137}, \'multiverseid\': 578137}, {\'name\': "Jodah, l\'Unificateur", \'text\': "Les créatures légendaires que vous contrôlez gagnent +X/+X, X étant le nombre de créatures légendaires que vous contrôlez.\\nÀ chaque fois que vous lancez un sort légendaire depuis votre main, exilez les cartes du dessus de votre bibliothèque jusqu\'à ce que vous exiliez une carte non-terrain légendaire avec une valeur de mana inférieure. Vous pouvez lancer cette carte sans payer son coût de mana. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.", \'type\': \'Créature légendaire : humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578178&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6ffc45d6-f9bc-4656-ab76-781c136ab8e5\', \'multiverseId\': 578178}, \'multiverseid\': 578178}, {\'name\': "Jodah, l\'Unificatore", \'text\': \'Le creature leggendarie che controlli prendono +X/+X, dove X è il numero di creature leggendarie che controlli.\\nOgniqualvolta lanci una magia leggendaria dalla tua mano, esilia carte dalla cima del tuo grimorio finché non esili una carta non terra leggendaria con valore di mana inferiore. Puoi lanciare quella carta senza pagare il suo costo di mana. Metti le altre in fondo al tuo grimorio in ordine casuale.\', \'type\': \'Creatura Leggendaria — Mago Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578219&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6b3556bb-680f-4533-b209-d40782ec5c72\', \'multiverseId\': 578219}, \'multiverseid\': 578219}, {\'name\': \'統べるもの、ジョダー\', \'text\': \'あなたがコントロールしているすべての伝説のクリーチャーは＋Ｘ/＋Ｘの修整を受ける。Ｘはあなたがコントロールしている伝説のクリーチャーの数に等しい。\\nあなたがあなたの手札から伝説の呪文を唱えるたび、マナ総量がそれより小さく伝説であり土地でないカード１枚が追放されるまで、あなたのライブラリーの一番上から１枚ずつ追放していく。あなたはそのカードをマナ・コストを支払うことなく唱えてもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'伝説のクリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578260&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a92b1c3e-d23d-407c-8184-3ec3ed6bf11b\', \'multiverseId\': 578260}, \'multiverseid\': 578260}, {\'name\': \'Jodah, o Unificador\', \'text\': \'As criaturas lendárias que você controla recebem +X/+X, sendo X o número de criaturas lendárias que você controla.\\nToda vez que você conjurar uma mágica lendária da sua mão, exile cards do topo de seu grimório até exilar um card lendário não de terreno com valor de mana inferior. Você pode conjurar aquele card sem pagar seu custo de mana. Coloque o restante no fundo de seu grimório em ordem aleatória.\', \'type\': \'Criatura Lendária — Humano Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578342&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6c0cfc89-9127-4426-bfa1-15767314c4a3\', \'multiverseId\': 578342}, \'multiverseid\': 578342}, {\'name\': \'诸界一统裘达\', \'text\': \'由你操控的传奇生物得+X/+X，X为由你操控的传奇生物数量。\\n每当你从你手上施放传奇咒语时，从你牌库顶开始放逐牌，直到放逐一张法术力值比它小的传奇非地牌为止。你可以施放该牌，且不需支付其法术力费用。将其余的牌以随机顺序置于你牌库底。\', \'type\': \'传奇生物 ～人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578424&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a09bbadf-6b4e-40e4-91a2-4c4a56788247\', \'multiverseId\': 578424}, \'multiverseid\': 578424}]', '[{\'name\': \'Jodah der Einende\', \'text\': \'Legendäre Kreaturen, die du kontrollierst, erhalten +X/+X, wobei X gleich der Anzahl an legendären Kreaturen ist, die du kontrollierst.\\nImmer wenn du einen legendären Zauberspruch aus deiner Hand wirkst, schicke Karten oben von deiner Bibliothek ins Exil, bis du eine legendäre Nichtland-Karte mit niedrigerem Manabetrag ins Exil schickst. Du kannst die Karte wirken, ohne ihre Manakosten zu bezahlen. Lege den Rest in zufälliger Reihenfolge unter die Bibliothek.\', \'type\': \'Legendäre Kreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577889&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'21e84f2a-d423-45fc-88c0-065ec041e215\', \'multiverseId\': 577889}, \'multiverseid\': 577889}, {\'name\': "Jodah, l\'Unificateur", \'text\': "Les créatures légendaires que vous contrôlez gagnent +X/+X, X étant le nombre de créatures légendaires que vous contrôlez.\\nÀ chaque fois que vous lancez un sort légendaire depuis votre main, exilez les cartes du dessus de votre bibliothèque jusqu\'à ce que vous exiliez une carte non-terrain légendaire avec une valeur de mana inférieure. Vous pouvez lancer cette carte sans payer son coût de mana. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.", \'type\': \'Créature légendaire : humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577930&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4842bf2b-f67a-4aa4-8de7-345cd30633f5\', \'multiverseId\': 577930}, \'multiverseid\': 577930}, {\'name\': \'統べるもの、ジョダー\', \'text\': \'あなたがコントロールしているすべての伝説のクリーチャーは＋Ｘ/＋Ｘの修整を受ける。Ｘはあなたがコントロールしている伝説のクリーチャーの数に等しい。\\nあなたがあなたの手札から伝説の呪文を唱えるたび、マナ総量がそれより小さく伝説であり土地でないカード１枚が追放されるまで、あなたのライブラリーの一番上から１枚ずつ追放していく。あなたはそのカードをマナ・コストを支払うことなく唱えてもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'伝説のクリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577971&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4516ec09-9f35-4b12-9a4e-8c43511e7727\', \'multiverseId\': 577971}, \'multiverseid\': 577971}, {\'name\': \'诸界一统裘达\', \'text\': \'由你操控的传奇生物得+X/+X，X为由你操控的传奇生物数量。\\n每当你从你手上施放传奇咒语时，从你牌库顶开始放逐牌，直到放逐一张法术力值比它小的传奇非地牌为止。你可以施放该牌，且不需支付其法术力费用。将其余的牌以随机顺序置于你牌库底。\', \'type\': \'传奇生物 ～人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=578012&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c25c8746-de24-46d2-9513-5908ed6e152b\', \'multiverseId\': 578012}, \'multiverseid\': 578012}]', '[{\'name\': \'Jodahs Codex\', \'text\': \'Domäne — {5}, {T}: Ziehe eine Karte. Diese Fähigkeit kostet beim Aktivieren für jeden Standardlandtyp unter den Ländern, die du kontrollierst, {1} weniger.\', \'type\': \'Artefakt\', \'flavor\': \'„Falls du dich an nichts anderes aus der Geschichte unserer Welt erinnerst, erinnere dich daran: Phyrexianer können besiegt werden."\\n—Jodah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574974&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'da6746a3-62d4-4bf8-9aa5-82054562699d\', \'multiverseId\': 574974}, \'multiverseid\': 574974}, {\'name\': \'Códice de Jodah\', \'text\': \'Dominio — {5}, {T}: Roba una carta. Te cuesta {1} menos activar esta habilidad por cada tipo de tierra básica entre las tierras que controlas.\', \'type\': \'Artefacto\', \'flavor\': \'"Si hay algo que debes recordar de la historia de nuestro mundo, es que se puede derrotar a los pirexianos".\\n—Jodah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575235&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f8848b79-69a7-4bfb-b59f-3edff84e62db\', \'multiverseId\': 575235}, \'multiverseid\': 575235}, {\'name\': \'Codex de Jodah\', \'text\': \'Domaine — {5}, {T} : Piochez une carte. Cette capacité coûte {1} de moins à activer pour chaque type de terrain de base parmi les terrains que vous contrôlez.\', \'type\': \'Artefact\', \'flavor\': "« S\'il faut se souvenir d\'une chose dans l\'histoire de notre monde, c\'est celle-ci : les Phyrexians peuvent être vaincus. »\\n—Jodah", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575496&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5fbd7c28-6579-4786-8e71-ddd0cfc8531a\', \'multiverseId\': 575496}, \'multiverseid\': 575496}, {\'name\': \'Codice di Jodah\', \'text\': \'Dominio — {5}, {T}: Pesca una carta. Questa abilità costa {1} in meno per essere attivata per ogni tipo di terra base tra le terre che controlli.\', \'type\': \'Artefatto\', \'flavor\': \'"Se dovessi ricordare una sola cosa della storia del nostro mondo, fa\\\' che sia questa: i Phyrexiani possono essere sconfitti."\\n—Jodah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575757&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b602edf9-e8c4-4b4a-9012-ae19b3a6aa60\', \'multiverseId\': 575757}, \'multiverseid\': 575757}, {\'name\': \'ジョダーの写本\', \'text\': \'版図 — {5},{T}：カード１枚を引く。この能力を起動するためのコストは、あなたがコントロールしている土地の中の基本土地タイプ１種類につき{1}少なくなる。\', \'type\': \'アーティファクト\', \'flavor\': \'「我らが世界の歴史をなにひとつ覚えてないなら、これだけは覚えておくといい：ファイレクシア人は倒せる。」\\n――ジョダー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576018&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'998570a4-e596-4319-9a50-f2a420f9e99f\', \'multiverseId\': 576018}, \'multiverseid\': 576018}, {\'name\': \'Códice de Jodah\', \'text\': \'Dominar — {5}, {T}: Compre um card. Esta habilidade custa {1} a menos para ser ativada para cada tipo de terreno básico entre os terrenos que você controla.\', \'type\': \'Artefato\', \'flavor\': \'Se há uma coisa que você precisa se lembrar da história de nosso mundo, é que os phyrexianos podem ser derrotados."\\n— Jodah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576540&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b63c3a08-ba7b-46d9-aba5-7c938d7fa0fe\', \'multiverseId\': 576540}, \'multiverseid\': 576540}, {\'name\': \'裘达的手抄本\', \'text\': \'领土～{5}，{T}：抓一张牌。由你操控的地中每有一种基本地类别，此异能便减少{1}来起动。\', \'type\': \'神器\', \'flavor\': \'「如果你不晓得我们世界的其他历史，那就请记住这条：非瑞克西亚人能被击败。」\\n～裘达\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=577062&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e87ca025-4b65-47be-aa7a-79102d55e34e\', \'multiverseId\': 577062}, \'multiverseid\': 577062}]', '[{\'name\': \'Kampfforschung\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur hat „Immer wenn diese Kreatur einem Spieler Kampfschaden zufügt, ziehe eine Karte."\\nSolange die verzauberte Kreatur legendär ist, erhält sie +1/+1 und hat Abwehr {1}. (Immer wenn die verzauberte Kreatur das Ziel eines Zauberspruchs oder einer Fähigkeit wird, den bzw. die ein Gegner kontrolliert, neutralisiere ihn bzw. sie, es sei denn, jener Spieler bezahlt {1}.)\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574785&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'16fd01cb-01d2-44eb-93bd-b3f36f795863\', \'multiverseId\': 574785}, \'multiverseid\': 574785}, {\'name\': \'Investigación de combate\', \'text\': \'Encantar criatura.\\nLa criatura encantada tiene "Siempre que esta criatura haga daño de combate a un jugador, roba una carta".\\nMientras la criatura encantada sea legendaria, obtiene +1/+1 y tiene la habilidad de rebatir {1}. (Siempre que sea objetivo de un hechizo o habilidad que controla un oponente, contrarréstalo a menos que ese jugador pague {1}.)\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575046&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a50a0f66-984f-4d21-b7ef-e2b87a679f13\', \'multiverseId\': 575046}, \'multiverseid\': 575046}, {\'name\': \'Recherche de combat\', \'text\': "Enchanter : créature\\nLa créature enchantée a « À chaque fois que cette créature inflige des blessures de combat à un joueur, piochez une carte. »\\nTant que la créature enchantée est légendaire, elle gagne +1/+1 et elle a parade {1} (À chaque fois que la créature enchantée devient la cible d\'un sort ou d\'une capacité qu\'un adversaire contrôle, contrecarrez ce sort ou cette capacité à moins que ce joueur ne paie {1}.)", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575307&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d3d32899-366a-4f20-99fd-f4df3d40ea97\', \'multiverseId\': 575307}, \'multiverseid\': 575307}, {\'name\': \'Ricerca da Combattimento\', \'text\': \'Incanta creatura\\nLa creatura incantata ha "Ogniqualvolta questa creatura infligge danno da combattimento a un giocatore, peschi una carta".\\nFintanto che la creatura incantata è leggendaria, prende +1/+1 e ha egida {1}. (Ogniqualvolta la creatura incantata diventa bersaglio di una magia o abilità controllata da un avversario, neutralizza quella magia o abilità a meno che quel giocatore non paghi {1}.)\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575568&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f1860418-2cfe-43cb-8974-2987dda34cbe\', \'multiverseId\': 575568}, \'multiverseid\': 575568}, {\'name\': \'戦闘研究\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントしているクリーチャーは「このクリーチャーがプレイヤー１人に戦闘ダメージを与えるたび、カード１枚を引く。」を持つ。\\nエンチャントしているクリーチャーが伝説であるかぎり、それは＋１/＋１の修整を受け護法{1}を持つ。（それが対戦相手がコントロールしている呪文や能力の対象になるたび、そのプレイヤーが{1}を支払わないかぎり、その呪文や能力を打ち消す。）\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575829&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ab533389-509b-4167-a354-897e3807d653\', \'multiverseId\': 575829}, \'multiverseid\': 575829}, {\'name\': \'Pesquisa de Combate\', \'text\': \'Encantar criatura\\nA criatura encantada tem "Toda vez que esta criatura causar dano de combate a um jogador, compre um card".\\nEnquanto a criatura encantada for lendária, ela receberá +1/+1 e terá salvaguarda {1}. (Toda vez que a criatura encantada se tornar alvo de uma mágica ou habilidade que um oponente controla, anule-a, a menos que aquele jogador pague {1}.)\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576351&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d8714420-f59e-4eba-90bd-49c683f12678\', \'multiverseId\': 576351}, \'multiverseid\': 576351}, {\'name\': \'实战研究\', \'text\': \'结附于生物\\n所结附的生物具有「每当此生物对任一牌手造成战斗伤害时，你抓一张牌。」\\n只要所结附的生物是传奇，它便得+1/+1且具有守护{1}。（每当所结附的生物成为由对手操控之咒语或异能的目标时，除非该牌手支付{1}，否则反击之。）\', \'type\': \'结界 ～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576873&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'736c8337-c1cf-409d-a90e-ca0dcb4eb349\', \'multiverseId\': 576873}, \'multiverseid\': 576873}]', '[{\'name\': \'Kampfschwingen-Mystiker\', \'text\': \'Bonus {R} (Du kannst zusätzlich {R} bezahlen, sowie du diesen Zauberspruch wirkst.)\\nFliegend\\nWenn der Kampfschwingen-Mystiker ins Spiel kommt und falls seine Bonuskosten bezahlt wurden, wirf deine Hand ab und ziehe dann zwei Karten.\', \'type\': \'Kreatur — Vogel, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574784&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a8b59735-fa44-44d9-a6c7-b44bfeea1a60\', \'multiverseId\': 574784}, \'multiverseid\': 574784}, {\'name\': \'Místico ala de guerra\', \'text\': \'Estímulo {R}. (Puedes pagar {R} adicional al lanzar este hechizo.)\\nVuela.\\nCuando el Místico ala de guerra entre al campo de batalla, si fue estimulado, descarta tu mano y luego roba dos cartas.\', \'type\': \'Criatura — Hechicero ave\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575045&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3a13a527-ea7b-464a-a76a-15650432c9cb\', \'multiverseId\': 575045}, \'multiverseid\': 575045}, {\'name\': \'Mystique battaile\', \'text\': "Kick {R} (Vous pouvez payer {R} supplémentaire au moment où vous lancez ce sort.)\\nVol\\nQuand le Mystique battaile arrive sur le champ de bataille, s\'il a été kické, défaussez-vous de votre main, puis piochez deux cartes.", \'type\': \'Créature : oiseau et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575306&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'753a9bbd-1489-4161-8a96-4fcd90b757fb\', \'multiverseId\': 575306}, \'multiverseid\': 575306}, {\'name\': \'Mistico Alarmigero\', \'text\': \'Potenziamento {R} (Puoi pagare {R} addizionale mentre lanci questa magia.)\\nVolare\\nQuando il Mistico Alarmigero entra nel campo di battaglia, se è stato potenziato, scarta la tua mano, poi pesca due carte.\', \'type\': \'Creatura — Mago Uccello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575567&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b8cac80d-9734-41ee-9cef-b13f6df422e8\', \'multiverseId\': 575567}, \'multiverseid\': 575567}, {\'name\': \'戦羽の神秘家\', \'text\': \'キッカー{R}（この呪文を唱えるに際し、追加で{R}を支払ってもよい。）\\n飛行\\n戦羽の神秘家が戦場に出たとき、これがキッカーされていた場合、あなたの手札を捨て、その後、カード２枚を引く。\', \'type\': \'クリーチャー — 鳥・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575828&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b49eda3a-93b5-42b1-88e7-92beb5729203\', \'multiverseId\': 575828}, \'multiverseid\': 575828}, {\'name\': \'Místico da Asa Bélica\', \'text\': \'Reforçar {R} (Você pode pagar um custo adicional de {R} ao conjurar esta mágica.)\\nVoar\\nQuando Místico da Asa Bélica entrar no campo de batalha, se ele foi reforçado, descarte sua mão e depois compre dois cards.\', \'type\': \'Criatura — Ave Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576350&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'13c00105-5f2a-45a5-bc7a-51beec7bb0ef\', \'multiverseId\': 576350}, \'multiverseid\': 576350}, {\'name\': \'战翼秘教徒\', \'text\': \'增幅{R}（你施放此咒语时可以额外支付{R}。）\\n飞行\\n当战翼秘教徒进战场时，若它已增幅，则弃掉你的手牌，然后抓两张牌。\', \'type\': \'生物 ～鸟／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=576872&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'68430ee4-6598-4545-b3cc-4d1442d52425\', \'multiverseId\': 576872}, \'multiverseid\': 576872}]', '[{\'name\': \'Karn, Living Legacy\', \'text\': \'+1: Create a tapped Powerstone token. (It\\\'s an artifact with "{T}: Add {C}. This mana can\\\'t be spent to cast a nonartifact spell.")\\n−1: Pay any amount of mana. Look at that many cards from the top of your library, then put one of those cards into your hand and the rest on the bottom of your library in a random order.\\n−7: You get an emblem with "Tap an untapped artifact you control: This emblem deals 1 damage to any target."\', \'type\': \'Legendary Planeswalker — Karn\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=574742&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'467cc4eb-3331-49c0-9c37-1f24b92c5e4b\', \'multiverseId\': 574742}, \'multiverseid\': 574742}, {\'name\': \'Karn, Living Legacy\', \'text\': \'+1: Create a tapped Powerstone token. (It\\\'s an artifact with "{T}: Add {C}. This mana can\\\'t be spent to cast a nonartifact spell.")\\n−1: Pay any amount of mana. Look at that many cards from the top of your library, then put one of those cards into your hand and the rest on the bottom of your library in a random order.\\n−7: You get an emblem with "Tap an untapped artifact you control: This emblem deals 1 damage to any target."\', \'type\': \'Legendary Planeswalker — Karn\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575003&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e58ec1fd-d183-422d-b5be-6c810b9f94c0\', \'multiverseId\': 575003}, \'multiverseid\': 575003}, {\'name\': \'Karn, Living Legacy\', \'text\': \'+1: Create a tapped Powerstone token. (It\\\'s an artifact with "{T}: Add {C}. This mana can\\\'t be spent to cast a nonartifact spell.")\\n−1: Pay any amount of mana. Look at that many cards from the top of your library, then put one of those cards into your hand and the rest on the bottom of your library in a random order.\\n−7: You get an emblem with "Tap an untapped artifact you control: This emblem deals 1 damage to any target."\', \'type\': \'Legendary Planeswalker — Karn\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=575264&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8da56d79-a264-4940-a1e8-d21d25c4aad2\', \'multiverseId\': 575264}, \'multiverseid\': 575264}, {\'name\': \'Karn, Living Legacy\'