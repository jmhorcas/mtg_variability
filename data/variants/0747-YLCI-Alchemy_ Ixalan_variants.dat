type: ['Artifact', 'Artifact Creature — Gnome', 'Artifact Creature — Golem', 'Creature — Dinosaur', 'Creature — Fungus', 'Creature — Human Druid', 'Creature — Human Knight', 'Creature — Insect Horror', 'Creature — Merfolk Wizard', 'Creature — Orc Pirate', 'Creature — Vampire Soldier', 'Instant', 'Instant — Chorus', 'Legendary Creature — Cat Shaman', 'Legendary Creature — Dinosaur Pirate', 'Legendary Creature — Spirit', 'Legendary Creature — Vampire Knight', 'Sorcery', 'Sorcery — Chorus']
