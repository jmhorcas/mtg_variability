subtypes: ['Cat', 'Chorus', 'Dinosaur', 'Druid', 'Fungus', 'Gnome', 'Golem', 'Horror', 'Human', 'Insect', 'Knight', 'Merfolk', 'Orc', 'Pirate', 'Shaman', 'Soldier', 'Spirit', 'Vampire', 'Wizard']
