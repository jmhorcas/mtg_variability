subtypes: ['Advisor', 'Ajani', 'Archer', 'Assassin', 'Aura', 'Chandra', 'Cleric', 'Druid', 'Elemental', 'Elf', 'Equipment', 'Faerie', 'Forest', 'Garruk', 'Giant', 'Goblin', 'Incarnation', 'Island', 'Jace', 'Kithkin', 'Knight', 'Liliana', 'Merfolk', 'Mountain', 'Plains', 'Ranger', 'Rogue', 'Scout', 'Shaman', 'Shapeshifter', 'Soldier', 'Swamp', 'Treefolk', 'Warrior', 'Wizard']
