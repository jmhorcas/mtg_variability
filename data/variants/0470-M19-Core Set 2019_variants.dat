ers': {'scryfallId': '78bebe00-2298-4296-af23-c6e5f1f70f21', 'multiverseId': 448821}, 'multiverseid': 448821}, {'name': '숲', 'type': '기본 대지 — 숲', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449102&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'aed87099-6a13-4ee8-9d91-69df330f21b4', 'multiverseId': 449102}, 'multiverseid': 449102}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449383&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5d92d6e7-19c7-41f7-9c12-d6a5cc38f771', 'multiverseId': 449383}, 'multiverseid': 449383}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449664&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'd673e99a-f320-4340-9a24-6a298bc62f8f', 'multiverseId': 449664}, 'multiverseid': 449664}, {'name': '树林', 'type': '基本地 ～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449945&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '75203077-ae32-48ca-9ee1-48792f2c93a4', 'multiverseId': 449945}, 'multiverseid': 449945}, {'name': '樹林', 'type': '基本地 ～樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450226&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '61e6b387-8861-491d-a362-78eac6c5f96f', 'multiverseId': 450226}, 'multiverseid': 450226}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447698&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4a1d4cfc-7bc8-4db1-8e0a-26fc1c562412', 'multiverseId': 447698}, 'multiverseid': 447698}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447979&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '6f50aef4-28de-4154-953e-bdd81c3176e2', 'multiverseId': 447979}, 'multiverseid': 447979}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448260&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ddfde139-1e62-407e-a9dd-9ba94f62a615', 'multiverseId': 448260}, 'multiverseid': 448260}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448541&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '4090f97b-6236-4ded-81f6-bf2a85646f55', 'multiverseId': 448541}, 'multiverseid': 448541}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448822&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '4654a14b-990f-4269-b181-f4716248f67b', 'multiverseId': 448822}, 'multiverseid': 448822}, {'name': '숲', 'type': '기본 대지 — 숲', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449103&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '555b8945-b347-4b59-812c-2ed545652667', 'multiverseId': 449103}, 'multiverseid': 449103}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449384&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5972f732-c72a-4670-8058-41576de4b587', 'multiverseId': 449384}, 'multiverseid': 449384}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449665&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '99a707d7-4aa9-4962-93c5-fced8d1bb8da', 'multiverseId': 449665}, 'multiverseid': 449665}, {'name': '树林', 'type': '基本地 ～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449946&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '6ed76a77-4ded-49ba-a950-93eb6655895a', 'multiverseId': 449946}, 'multiverseid': 449946}, {'name': '樹林', 'type': '基本地 ～樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450227&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'ffdf56cb-6e2e-4773-999d-7b0b755f8f32', 'multiverseId': 450227}, 'multiverseid': 450227}]", '[{\'name\': \'Waldlandstrom\', \'text\': \'Der Waldlandstrom kommt getappt ins Spiel.\\n{T}: Erzeuge {G} oder {U}.\', \'type\': \'Land\', \'flavor\': \'Die Wege, die sich das Wasser durch das Land bahnt, reflektieren die Wege, auf denen Ätherströme die Wolken durchdringen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447678&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d11efc31-85ab-4744-aea5-5dc9533b075c\', \'multiverseId\': 447678}, \'multiverseid\': 447678}, {\'name\': \'Arroyo forestal\', \'text\': \'El Arroyo forestal entra al campo de batalla girado.\\n{T}: Agrega {G} o {U}.\', \'type\': \'Tierra\', \'flavor\': \'El agua esculpe su camino por la tierra para reflejar el curso del éter que surca las nubes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447959&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'82a6344d-57c3-49da-a868-3ab4759a8cd8\', \'multiverseId\': 447959}, \'multiverseid\': 447959}, {\'name\': \'Ruisseau des sylves\', \'text\': \'Le Ruisseau des sylves arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {G} ou {U}.\', \'type\': \'Terrain\', \'flavor\': "Les cours d\'eau creusent leur lit dans la terre pour refléter les chemins que prennent les flux d\'Éther dans les nuages.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448240&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'90aa2754-1e1a-4045-89d8-8413caaa97ee\', \'multiverseId\': 448240}, \'multiverseid\': 448240}, {\'name\': \'Ruscello nel Bosco\', \'text\': \'Il Ruscello nel Bosco entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {G} o {U}.\', \'type\': \'Terra\', \'flavor\': "I corsi d\'acqua scavano nel terreno percorsi paralleli a quelli tracciati dai flussi d\'etere tra le nuvole.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448521&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0ce11bc9-2023-4ce4-91f6-d1551381bd23\', \'multiverseId\': 448521}, \'multiverseid\': 448521}, {\'name\': \'森林地の小川\', \'text\': \'森林地の小川はタップ状態で戦場に出る。\\n{T}：{G}か{U}を加える。\', \'type\': \'土地\', \'flavor\': \'霊気の流れが雲を通り抜ける道を映し出すかのように、小川もその経路を形作る。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448802&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f45f452b-0632-45fd-ac59-c9a2b8ffaeb5\', \'multiverseId\': 448802}, \'multiverseid\': 448802}, {\'name\': \'삼림지 개울\', \'text\': \'삼림지 개울은 탭된 채로 전장에 들어온다.\\n{T}: {G} 또는 {U}를 추가한다.\', \'type\': \'대지\', \'flavor\': \'대지를 뚫고 흐르는 물길은 마치 구름을 뚫고 흐르는 에테르 강을 연상시킨다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449083&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2e409d30-c9d1-4432-b112-aca3d8a7f6e4\', \'multiverseId\': 449083}, \'multiverseid\': 449083}, {\'name\': \'Riacho da Floresta\', \'text\': \'Riacho da Floresta entra no campo de batalha virado.\\n{T}: Adicione {G} ou {U}.\', \'type\': \'Terreno\', \'flavor\': "Os cursos d\'água traçam no terreno percursos paralelos aos desenhados pelos fluxos de éter entre as nuvens.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449364&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0214adb7-6834-40d2-a9b5-7d63c79c81f9\', \'multiverseId\': 449364}, \'multiverseid\': 449364}, {\'name\': \'Лесной Ручей\', \'text\': \'Лесной Ручей выходит на поле битвы повернутым.\\n{T}: добавьте {G} или {U}.\', \'type\': \'Земля\', \'flavor\': \'Ручьи и реки промывают себе путь в земле, повторяя узоры, что эфирные потоки рисуют в облаках.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449645&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'14838f3e-c7b2-49aa-96df-e584dc074e0f\', \'multiverseId\': 449645}, \'multiverseid\': 449645}, {\'name\': \'林地溪流\', \'text\': \'林地溪流须横置进战场。\\n{T}：加{G}或{U}。\', \'type\': \'地\', \'flavor\': \'溪流自大地穿行而过，照映出乙太流穿越云间的路径。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449926&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'55363864-0e53-4f96-b75b-31ee5d439b49\', \'multiverseId\': 449926}, \'multiverseid\': 449926}, {\'name\': \'林地溪流\', \'text\': \'林地溪流須橫置進戰場。\\n{T}：加{G}或{U}。\', \'type\': \'地\', \'flavor\': \'溪流自大地穿行而過，照映出乙太流穿越雲間的路徑。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450207&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9b27688d-16f0-46ee-a098-10859899fc56\', \'multiverseId\': 450207}, \'multiverseid\': 450207}]', '[{\'name\': \'Wandelnde Leiche\', \'type\': \'Kreatur — Zombie\', \'flavor\': \'„Eine herkömmliche Armee verköstigen zu müssen ist eine Frage der Logistik. Bei Zombies ist das eher ein Vorteil. Ihr Hunger ist der Grund, warum sie kämpfen. Ihr Hunger ist der Grund, warum man sie fürchtet."\\n—Jadar, Ghulrufer aus Nefalen\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447543&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6eba4abe-b77e-4d27-9681-7afdc4c867f4\', \'multiverseId\': 447543}, \'multiverseid\': 447543}, {\'name\': \'Cadáver ambulante\', \'type\': \'Criatura — Zombie\', \'flavor\': \'"La alimentación de un ejército normal supone un problema de logística. Con los zombies, es una ventaja. Su alimentación es aquello por lo que luchan. Su alimentación es aquello por lo que se les teme".\\n—Jadar, llamamuertos de Nephalia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447824&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fee385b7-89c8-4fca-acdd-afa1cc24681e\', \'multiverseId\': 447824}, \'multiverseid\': 447824}, {\'name\': \'Cadavre ambulant\', \'type\': \'Créature : zombie\', \'flavor\': "« Nourrir une armée normale revient à résoudre un problème de logistique. Avec des zombies, pas de problème, bien au contraire. Ils combattent pour se nourrir. C\'est même pour ça qu\'on les redoute. »\\n—Jadar, meneur de goule de Néphalie", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448105&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1a77a3ed-3ba9-478e-9773-bc7540c47623\', \'multiverseId\': 448105}, \'multiverseid\': 448105}, {\'name\': \'Cadavere Ambulante\', \'type\': \'Creatura — Zombie\', \'flavor\': \'"Sfamare un esercito normale è un problema di logistica. Con gli zombie, è un vantaggio. La fame è il motivo per cui combattono. La fame è il motivo per cui sono temuti."\\n—Jadar, evocaghoul di Nephalia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448386&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'df9a8e8d-4076-4e14-a275-e0f2f35c2dc1\', \'multiverseId\': 448386}, \'multiverseid\': 448386}, {\'name\': \'歩く死骸\', \'type\': \'クリーチャー — ゾンビ\', \'flavor\': \'「普通の軍隊の場合、食糧確保が問題となる。ゾンビの場合、それが強みになる。奴らは食うために戦い、食うから恐れられる。」\\n――ネファリアのグール呼び、ジャダー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448667&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e1604ee2-85ac-409b-88b2-fa2bf12ed25c\', \'multiverseId\': 448667}, \'multiverseid\': 448667}, {\'name\': \'걸어다니는 시체\', \'type\': \'생물 — 좀비\', \'flavor\': \'"식량은 일반 부대의 병참술에서는 골치 아픈 문제이지만 좀비를 다룰 때는 중요한 자산이 된다. 식량이야말로 좀비들이 싸우는 이유이며, 적들이 그들을 두려워하는 원인이기 때문이다."\\n—네팔리아의 악귀소환술사, 자다르\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448948&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'27881e1a-0389-4361-b78c-afb739c0ff73\', \'multiverseId\': 448948}, \'multiverseid\': 448948}, {\'name\': \'Cadáver Ambulante\', \'type\': \'Criatura — Zumbi\', \'flavor\': \'"A alimentação de um exército normal é um problema de logística. A alimentação de zumbis é uma vantagem. Eles lutam para comer. E são temidos por isso."\\n— Jadar, invocador de carniçais de Nefália\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449229&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b128c220-932a-4e7f-8ea6-0aca0904ea8e\', \'multiverseId\': 449229}, \'multiverseid\': 449229}, {\'name\': \'Ходячий Труп\', \'type\': \'Существо — Зомби\', \'flavor\': \'«Для обычной армии пища — это проблема снабжения. Для армии зомби — тактическое преимущество. Их пища — это то, почему они сражаются. Их пища — это то, почему их боятся».\\n— Джадар, призыватель упырей из Нефалии\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449510&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ac99dcc2-66c4-413e-acaf-a05e16dbb614\', \'multiverseId\': 449510}, \'multiverseid\': 449510}, {\'name\': \'行尸\', \'type\': \'生物 ～灵俑\', \'flavor\': \'「正常的军队要考虑食粮补给的问题。而这正是灵俑部队的优点。他们因进食而战。也因进食而被人惧怕。」\\n～涅非利亚尸鬼牧者贾达\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449791&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'629d5cd8-ea12-44cf-ab51-1e2220ee945f\', \'multiverseId\': 449791}, \'multiverseid\': 449791}, {\'name\': \'行屍\', \'type\': \'生物 ～殭屍\', \'flavor\': \'「正常的軍隊要考慮食糧補給的問題。而這正是殭屍部隊的優點。他們因進食而戰。也因進食而被人懼怕。」\\n～涅非利亞屍鬼牧者賈達\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450072&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1ac19c5f-1114-4783-866b-5504eb5a1154\', \'multiverseId\': 450072}, \'multiverseid\': 450072}]', '[{\'name\': \'Wasserschlinge\', \'text\': \'Verzaubert eine Kreatur\\nWenn die Wasserschlinge ins Spiel kommt, tappe die verzauberte Kreatur.\\nDie verzauberte Kreatur enttappt nicht während des Enttappsegments ihres Beherrschers.\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450292&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6a06ec62-1f0b-4950-998b-7f9da4510d25\', \'multiverseId\': 450292}, \'multiverseid\': 450292}, {\'name\': \'Encadenamiento acuático\', \'text\': \'Encantar criatura.\\nCuando el Encadenamiento acuático entre al campo de batalla, gira la criatura encantada.\\nLa criatura encantada no se endereza durante el paso de enderezar de su controlador.\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450326&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fc5937ea-0b90-4111-9d43-b0807a3df2d8\', \'multiverseId\': 450326}, \'multiverseid\': 450326}, {\'name\': \'Nœud découlant\', \'text\': "Enchanter : créature\\nQuand le Nœud découlant arrive sur le champ de bataille, engagez la créature enchantée.\\nLa créature enchantée ne se dégage pas pendant l\'étape de dégagement de son contrôleur.", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450360&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4b83a937-04a9-4c80-91e5-8f533fd43494\', \'multiverseId\': 450360}, \'multiverseid\': 450360}, {\'name\': "Nodo d\'Acqua", \'text\': "Incanta creatura\\nQuando il Nodo d\'Acqua entra nel campo di battaglia, TAPpa la creatura incantata.\\nLa creatura incantata non STAPpa durante lo STAP del suo controllore.", \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450394&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'88d711f2-fcea-4ab8-ba4a-049efe252212\', \'multiverseId\': 450394}, \'multiverseid\': 450394}, {\'name\': \'水結び\', \'text\': \'エンチャント（クリーチャー）\\n水結びが戦場に出たとき、エンチャントされているクリーチャーをタップする。\\nエンチャントされているクリーチャーは、それのコントローラーのアンタップ・ステップにアンタップしない。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450428&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'084c8d32-a1db-4c20-b6ff-e79d1f2be8d6\', \'multiverseId\': 450428}, \'multiverseid\': 450428}, {\'name\': \'물매듭\', \'text\': \'생물에게 부여\\n물매듭이 전장에 들어올 때, 부여된 생물을 탭한다.\\n부여된 생물은 조종자의 언탭단에 언탭되지 않는다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450462&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ac6ba5fd-84cf-4c07-82de-9616cb65555a\', \'multiverseId\': 450462}, \'multiverseid\': 450462}, {\'name\': "Nó D\'água", \'text\': "Encantar criatura\\nQuando Nó D\'água entrar no campo de batalha, vire a criatura encantada.\\nA criatura encantada não é desvirada durante a etapa de desvirar de seu controlador.", \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450496&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f9441f98-8445-4393-95d0-75d9a3c30156\', \'multiverseId\': 450496}, \'multiverseid\': 450496}, {\'name\': \'Водяной Узел\', \'text\': \'Зачаровать существо\\nКогда Водяной Узел выходит на поле битвы, поверните зачарованное существо.\\nЗачарованное существо не разворачивается во время шага разворота контролирующего его игрока.\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450530&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c45bdb5c-53b9-4f3f-bca3-181ea5abd904\', \'multiverseId\': 450530}, \'multiverseid\': 450530}, {\'name\': \'水结纠缠\', \'text\': \'结附于生物\\n当水结纠缠进战场时，横置所结附的生物。\\n所结附的生物于其操控者的重置步骤中不能重置。\', \'type\': \'结界 ～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450564&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'eb4a99e2-9bb1-43ed-ad89-ae3f5a8af003\', \'multiverseId\': 450564}, \'multiverseid\': 450564}, {\'name\': \'水結糾纏\', \'text\': \'結附於生物\\n當水結糾纏進戰場時，橫置所結附的生物。\\n所結附的生物於其操控者的重置步驟中不能重置。\', \'type\': \'結界 ～靈氣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450598&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'44aebd25-41bb-45e9-b5f7-9f4f3299eec4\', \'multiverseId\': 450598}, \'multiverseid\': 450598}]', '[{\'name\': \'Weise der Renaturierung\', \'text\': \'Wenn die Weise der Renaturierung ins Spiel kommt, kannst du ein Artefakt oder eine Verzauberung deiner Wahl zerstören.\', \'type\': \'Kreatur — Elf, Schamane\', \'flavor\': \'„Was einst von Steinmetzen errichtet, von Schmieden geformt oder von Magiern ins Leben gerufen wurde, werde ich an die Erde zurückgeben."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447613&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'badb2299-98d2-4c38-87e9-9a91125d2d34\', \'multiverseId\': 447613}, \'multiverseid\': 447613}, {\'name\': \'Sabia de la recuperación\', \'text\': \'Cuando la Sabia de la recuperación entre al campo de batalla, puedes destruir el encantamiento o artefacto objetivo.\', \'type\': \'Criatura — Chamán elfo\', \'flavor\': \'"Aquello que construyeron los canteros, forjaron los herreros o animaron los magos, yo lo regresaré al abrazo de la tierra".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447894&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fb09469f-5ff3-4a64-9340-15994e0e17fe\', \'multiverseId\': 447894}, \'multiverseid\': 447894}, {\'name\': \'Sage du reboisement\', \'text\': "Quand la Sage du reboisement arrive sur le champ de bataille, vous pouvez détruire l\'artefact ciblé ou l\'enchantement ciblé.", \'type\': \'Créature : elfe et shamane\', \'flavor\': \'« Ce qui jadis fut construit par des maçons, forgé par des forgerons ou animé par des magiciens, je le rends à la terre. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448175&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6c3816b1-ef3b-4586-b58f-70053b680cf1\', \'multiverseId\': 448175}, \'multiverseid\': 448175}, {\'name\': \'Saggia della Rivendicazione\', \'text\': \'Quando la Saggia della Rivendicazione entra nel campo di battaglia, puoi distruggere un artefatto o un incantesimo bersaglio.\', \'type\': \'Creatura — Sciamano Elfo\', \'flavor\': \'"Ciò che un tempo fu modellato dai tagliapietre, plasmato dai fabbri o infuso di vita dai maghi, io restituirò all\\\'abbraccio della terra."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448456&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'91d00dce-081f-4f4e-a19d-1a07afebbae1\', \'multiverseId\': 448456}, \'multiverseid\': 448456}, {\'name\': \'再利用の賢者\', \'text\': \'再利用の賢者が戦場に出たとき、アーティファクト１つかエンチャント１つを対象とする。あなたはそれを破壊してもよい。\', \'type\': \'クリーチャー — エルフ・シャーマン\', \'flavor\': \'「かつて石工によって作り出され、職人によって形が整えられ、そして魔道士によって命を与えられたものは、我によって再び大地の抱擁の中へと戻される。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448737&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3de9e707-8ed7-44b5-8793-ec21a4a56c77\', \'multiverseId\': 448737}, \'multiverseid\': 448737}, {\'name\': \'교화의 현자\', \'text\': \'교화의 현자가 전장에 들어올 때, 마법물체나 부여마법을 목표로 정한다. 당신은 그 목표를 파괴할 수 있다.\', \'type\': \'생물 — 엘프 주술사\', \'flavor\': \'"석공이 만들었든 대장장이가 만들었든 혹은 마도사가 생명을 불어넣었든 나는 그것들을 자연의 품으로 되돌릴 것이다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449018&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5beff4f0-154d-4f43-922a-32ee0b13602c\', \'multiverseId\': 449018}, \'multiverseid\': 449018}, {\'name\': \'Sábio da Reivindicação\', \'text\': \'Quando Sábio da Reivindicação entra no campo de batalha, você pode destruir o artefato ou encantamento alvo.\', \'type\': \'Criatura — Elfo Xamã\', \'flavor\': \'"Aquilo que um dia foi formado por pedreiros, moldado por ferreiros ou animado por magos, eu devolverei ao abraço da terra."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449299&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ff972c41-27f5-4d9c-a2f6-e731d7f94bfc\', \'multiverseId\': 449299}, \'multiverseid\': 449299}, {\'name\': \'Возвращающая к Истокам\', \'text\': \'Когда Возвращающая к Истокам выходит на поле битвы, вы можете уничтожить целевой артефакт или чары.\', \'type\': \'Существо — Эльф Шаман\', \'flavor\': \'«То, что когда-то возвели строители, выковали кузнецы или оживили маги, я возвращаю в объятья земли».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449580&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'75c2501c-1dff-4845-a7b6-89ea789adfa4\', \'multiverseId\': 449580}, \'multiverseid\': 449580}, {\'name\': \'复碧智者\', \'text\': \'当复碧智者进战场时，你可以消灭目标神器或结界。\', \'type\': \'生物 ～妖精／祭师\', \'flavor\': \'「无论是由石匠塑造，由铁匠锻造，或由法师赐予生命者，我都会让它们重归大地怀抱。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449861&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f176864d-0786-48a4-91ba-89f3f272828e\', \'multiverseId\': 449861}, \'multiverseid\': 449861}, {\'name\': \'復碧智者\', \'text\': \'當復碧智者進戰場時，你可以消滅目標神器或結界。\', \'type\': \'生物 ～妖精／祭師\', \'flavor\': \'「無論是由石匠塑造，由鐵匠鍛造，或由法師賜予生命者，我都會讓它們重歸大地懷抱。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450142&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0b54a5b3-9bd3-43f0-ab55-ecc9a623864a\', \'multiverseId\': 450142}, \'multiverseid\': 450142}]', '[{\'name\': \'Weissagung\', \'text\': \'Ziehe zwei Karten.\', \'type\': \'Hexerei\', \'flavor\': \'„Die Sterne kennen dein Schicksal. Mögest du akzeptieren, was sie dir enthüllen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447468&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'73089d34-dcb7-49eb-8fb8-2a2a8b4a157d\', \'multiverseId\': 447468}, \'multiverseid\': 447468}, {\'name\': \'Adivinación\', \'text\': \'Roba dos cartas.\', \'type\': \'Conjuro\', \'flavor\': \'"Las estrellas deciden tu destino. Acepta el destino que ellas te revelan".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447749&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'94473549-156c-4975-89c2-b34b00c66ea5\', \'multiverseId\': 447749}, \'multiverseid\': 447749}, {\'name\': \'Divination\', \'text\': \'Piochez deux cartes.\', \'type\': \'Rituel\', \'flavor\': "« Les astres influencent ton destin. Puisses-tu accepter ce qu\'ils révèlent ainsi. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448030&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6259da93-db21-4dc5-adf8-11f52d37ceec\', \'multiverseId\': 448030}, \'multiverseid\': 448030}, {\'name\': \'Divinazione\', \'text\': \'Pesca due carte.\', \'type\': \'Stregoneria\', \'flavor\': \'"Le stelle tracciano il tuo destino. Che tu possa accettare il fato da loro appreso."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448311&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'51f50113-ceee-4e9d-a6f0-0b4350e85c15\', \'multiverseId\': 448311}, \'multiverseid\': 448311}, {\'name\': \'予言\', \'text\': \'カードを２枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'「星があなたの運命を示します。明かされた定めをどうか受け入れられますよう。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448592&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ccfa3022-dd4d-4eb2-887d-4b5fc202a41a\', \'multiverseId\': 448592}, \'multiverseid\': 448592}, {\'name\': \'점\', \'text\': \'카드 두 장을 뽑는다.\', \'type\': \'집중마법\', \'flavor\': \'"별들이 네 운명을 가리킨다. 네게 밝혀진 운명을 받아들여라."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448873&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3d14bcfe-5752-45e4-82f6-c0a0829466bd\', \'multiverseId\': 448873}, \'multiverseid\': 448873}, {\'name\': \'Divinação\', \'text\': \'Compre dois cards.\', \'type\': \'Feitiço\', \'flavor\': \'"As estrelas marcam seu destino. Que você aceite a sina assim revelada."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449154&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bc48778b-67d6-400e-9afe-4cc17d49c516\', \'multiverseId\': 449154}, \'multiverseid\': 449154}, {\'name\': \'Прорицание\', \'text\': \'Возьмите две карты.\', \'type\': \'Волшебство\', \'flavor\': \'«Звезды отмечают твою судьбу. Тебе остается принять предсказанную участь».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449435&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'274eb26a-451a-4233-aa72-b7b69a635040\', \'multiverseId\': 449435}, \'multiverseid\': 449435}, {\'name\': \'卜卦\', \'text\': \'抓两张牌。\', \'type\': \'法术\', \'flavor\': \'「星相记录了你的命途。接受由此揭露的命运吧。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449716&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3f3efe11-0135-44e5-8af7-e2446379a05e\', \'multiverseId\': 449716}, \'multiverseid\': 449716}, {\'name\': \'卜卦\', \'text\': \'抽兩張牌。\', \'type\': \'巫術\', \'flavor\': \'「星相記錄了你的命途。接受由此揭露的命運吧。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449997&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'746a5919-637a-4fbd-8327-c37871e33f22\', \'multiverseId\': 449997}, \'multiverseid\': 449997}]', '[{\'name\': \'Wellenross\', \'text\': \'Das Wellenross kann von grünen Kreaturen nicht geblockt werden.\\nImmer wenn das Wellenross einem Gegner Schaden zufügt, kannst du eine Karte ziehen. Falls du dies tust, wirf eine Karte ab.\\n{1}{U}: Das Wellenross erhält +2/-2 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Pferd, Fisch\', \'flavor\': \'Zieht es vorbei, reichen die Wellen zum Himmel.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447494&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3f0eb313-ab6b-4491-8f11-1131c2557a2f\', \'multiverseId\': 447494}, \'multiverseid\': 447494}, {\'name\': \'Corcel del oleaje\', \'text\': \'El Corcel del oleaje no puede ser bloqueado por criaturas verdes.\\nSiempre que el Corcel del oleaje haga daño a un oponente, puedes robar una carta. Si lo haces, descarta una carta.\\n{1}{U}: El Corcel del oleaje obtiene +2/-2 hasta el final del turno.\', \'type\': \'Criatura — Pez caballo\', \'flavor\': \'Cuando pasa, las olas rozan el cielo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447775&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'92ab7c05-f4d3-4887-821d-4348cfbd3141\', \'multiverseId\': 447775}, \'multiverseid\': 447775}, {\'name\': \'Jument de la houle\', \'text\': "La Jument de la houle ne peut pas être bloquée par des créatures vertes.\\nÀ chaque fois que la Jument de la houle inflige des blessures à un adversaire, vous pouvez piocher une carte. Si vous faites ainsi, défaussez-vous d\'une carte.\\n{1}{U} : La Jument de la houle gagne +2/-2 jusqu\'à la fin du tour.", \'type\': \'Créature : cheval et poisson\', \'flavor\': \'Quand elle passe, les vagues caressent le ciel.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448056&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'17525cb4-97ff-40a8-a97d-3545e7abcbbe\', \'multiverseId\': 448056}, \'multiverseid\': 448056}, {\'name\': \'Destriero dei Flutti\', \'text\': \'Il Destriero dei Flutti non può essere bloccato dalle creature verdi.\\nOgniqualvolta il Destriero dei Flutti infligge danno a un avversario, puoi pescare una carta. Se lo fai, scarta una carta.\\n{1}{U}: Il Destriero dei Flutti prende +2/-2 fino alla fine del turno.\', \'type\': \'Creatura — Pesce Cavallo\', \'flavor\': \'Al suo passaggio, le onde toccano il cielo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448337&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9805d117-ea38-4cd5-b8d3-ad6ef46b4dc4\', \'multiverseId\': 448337}, \'multiverseid\': 448337}, {\'name\': \'波濤牝馬\', \'text\': \'波濤牝馬は緑のクリーチャーによってはブロックされない。\\n波濤牝馬が対戦相手にダメージを与えるたび、あなたはカードを１枚引いてもよい。そうしたなら、カード１枚を捨てる。\\n{1}{U}：ターン終了時まで、波濤牝馬は＋２/－２の修整を受ける。\', \'type\': \'クリーチャー — 馬・魚\', \'flavor\': \'それが走り去るとき、波は空に触れる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448618&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ec3b8e20-41e1-4b2b-9c4f-e9e7404c874e\', \'multiverseId\': 448618}, \'multiverseid\': 448618}, {\'name\': \'격동 암말\', \'text\': \'격동 암말은 녹색 생물에게 방어될 수 없다.\\n격동 암말이 상대에게 피해를 입힐 때마다, 당신은 카드 한 장을 뽑을 수 있다. 그렇게 한다면, 카드 한 장을 버린다.\\n{1}{U}: 격동 암말은 턴종료까지 +2/-2를 받는다.\', \'type\': \'생물 — 말 어류\', \'flavor\': \'그것이 지나가면, 파도가 하늘에 닿는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448899&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'05fc0158-cd45-40ed-bc2f-8a5df4b98433\', \'multiverseId\': 448899}, \'multiverseid\': 448899}, {\'name\': \'Égua da Ondulação\', \'text\': \'Égua da Ondulação não pode ser bloqueada por criaturas verdes.\\nToda vez que Égua da Ondulação causa dano a um oponente, você pode comprar um card. Se fizer isso, descarte um card.\\n{1}{U}: Égua da Ondulação recebe +2/-2 até o final do turno.\', \'type\': \'Criatura — Cavalo Peixe\', \'flavor\': \'Quando ela passa, as ondas tocam os céus.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449180&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ab31a27a-0c11-4883-9759-67c60909450f\', \'multiverseId\': 449180}, \'multiverseid\': 449180}, {\'name\': \'Кобылица Всплесков\', \'text\': \'Кобылица Всплесков не может быть заблокирована зелеными существами.\\nКаждый раз, когда Кобылица Всплесков наносит повреждения оппоненту, вы можете взять карту. Если вы это делаете, сбросьте карту.\\n{1}{U}: Кобылица Всплесков получает +2/-2 до конца хода.\', \'type\': \'Существо — Лошадь Рыба\', \'flavor\': \'Когда она скачет, волны касаются небес.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449461&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d8d9d6d9-2a26-413d-8126-768be6cc53f8\', \'multiverseId\': 449461}, \'multiverseid\': 449461}, {\'name\': \'兴潮牝马\', \'text\': \'兴潮牝马不能被绿色生物阻挡。\\n每当兴潮牝马向任一对手造成伤害时，你可以抓一张牌。若你如此作，则弃一张牌。\\n{1}{U}：兴潮牝马得+2/-2直到回合结束。\', \'type\': \'生物 ～马／鱼\', \'flavor\': \'所经之处，骇浪惊涛高及天。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449742&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e1db5442-bcd0-4db0-90f8-746e40af3514\', \'multiverseId\': 449742}, \'multiverseid\': 449742}, {\'name\': \'興潮牝馬\', \'text\': \'興潮牝馬不能被綠色生物阻擋。\\n每當興潮牝馬向任一對手造成傷害時，你可以抽一張牌。若你如此作，則棄一張牌。\\n{1}{U}：興潮牝馬得+2/-2直到回合結束。\', \'type\': \'生物 ～馬／魚\', \'flavor\': \'所經之處，駭浪驚濤高及天。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450023&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'acd473d8-8564-4677-a386-009d30d3e60c\', \'multiverseId\': 450023}, \'multiverseid\': 450023}]', '[{\'name\': \'Widerstand leisten\', \'text\': \'Kreaturen, die du kontrollierst, erhalten +1/+0 und Unzerstörbarkeit bis zum Ende des Zuges. (Schaden und Effekte, die „zerstören", zerstören sie nicht.)\', \'type\': \'Spontanzauber\', \'flavor\': \'In diesem Augenblick vergaßen sie jede Furcht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447443&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c99143af-4799-4c99-a004-b4f1587b2a7a\', \'multiverseId\': 447443}, \'multiverseid\': 447443}, {\'name\': \'Resistir\', \'text\': \'Las criaturas que controlas obtienen +1/+0 y ganan la habilidad de indestructible hasta el final del turno. (El daño y los efectos que dicen "destruir" no las destruyen.)\', \'type\': \'Instantáneo\', \'flavor\': \'Por un instante olvidaron todo miedo e hicieron frente al enemigo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447724&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'89749008-b9ae-4a45-8e10-2c58da23d2c4\', \'multiverseId\': 447724}, \'multiverseid\': 447724}, {\'name\': \'Prise de position\', \'text\': "Les créatures que vous contrôlez gagnent +1/+0 et acquièrent l\'indestructible jusqu\'à la fin du tour. (Les blessures et les effets qui disent « détruisez » ne les détruisent pas.)", \'type\': \'Éphémère\', \'flavor\': \'Pendant un instant, ils se sont redressés, la tête haute, oubliant leur peur.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448005&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'70cc92c9-18c8-4fdc-95fd-87a90870d533\', \'multiverseId\': 448005}, \'multiverseid\': 448005}, {\'name\': \'Opporre Resistenza\', \'text\': \'Le creature che controlli prendono +1/+0 e hanno indistruttibile fino alla fine del turno. (Il danno e gli effetti che dicono "distruggi" non le distruggono.)\', \'type\': \'Istantaneo\', \'flavor\': \'Per un istante restarono a testa alta, dimenticando ogni timore.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448286&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ea18bff6-cb37-401d-bbab-81bdf6d59e8d\', \'multiverseId\': 448286}, \'multiverseid\': 448286}, {\'name\': \'抗戦\', \'text\': \'ターン終了時まで、あなたがコントロールしているクリーチャーは＋１/＋０の修整を受け、破壊不能を得る。（ダメージや「破壊する」と書かれた効果では、それらは破壊されない。）\', \'type\': \'インスタント\', \'flavor\': \'その瞬間、みなが堂々となり恐れは消えた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448567&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'54c1b86b-b48f-4c1e-988a-44e7e9780807\', \'multiverseId\': 448567}, \'multiverseid\': 448567}, {\'name\': \'대항하기\', \'text\': \'당신이 조종하는 생물들은 턴종료까지 +1/+0을 받고 무적을 얻는다. (피해와 "파괴"라고 명시된 효과로 파괴되지 않는다.)\', \'type\': \'순간마법\', \'flavor\': \'그 순간, 그들은 모든 공포를 잊고 용맹스럽게 맞섰다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448848&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'71b23834-dc6e-4ca3-95de-59c7285a2123\', \'multiverseId\': 448848}, \'multiverseid\': 448848}, {\'name\': \'Opor Resistência\', \'text\': \'As criaturas que você controla recebem +1/+0 e ganham indestrutível até o final do turno. (O dano e os efeitos que dizem "destrua" não as destroem.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Por um momento eles se ergueram, esquecendo-se de todo e qualquer medo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449129&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1869b1bf-70bd-4492-ba73-735d507f1a29\', \'multiverseId\': 449129}, \'multiverseid\': 449129}, {\'name\': \'Решительный Отпор\', \'text\': \'Существа под вашим контролем получают +1/+0 и Неразрушимость до конца хода. (Повреждения и эффекты с указанием «уничтожьте» не уничтожают их.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Несколько мгновений они стояли во весь рост, позабыв про страх.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449410&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c72c078d-c978-419c-953b-b55180f4e4fa\', \'multiverseId\': 449410}, \'multiverseid\': 449410}, {\'name\': \'奋勇抗敌\', \'text\': \'直到回合结束，由你操控的生物得+1/+0且获得不灭异能。（伤害与注明「消灭」的效应不会将它们消灭。）\', \'type\': \'瞬间\', \'flavor\': \'他们在那一刻忘却所有恐惧，奋勇抗敌。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449691&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e52cba82-2e4b-4c97-98e8-033f7103caba\', \'multiverseId\': 449691}, \'multiverseid\': 449691}, {\'name\': \'奮勇抗敵\', \'text\': \'直到回合結束，由你操控的生物得+1/+0且獲得不滅異能。（傷害與註明「消滅」的效應不會將它們消滅。）\', \'type\': \'瞬間\', \'flavor\': \'他們在那一刻忘卻所有恐懼，奮勇抗敵。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449972&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'05c8482f-b32e-4a2e-bbeb-413b8925673c\', \'multiverseId\': 449972}, \'multiverseid\': 449972}]', '[{\'name\': \'Wieder aufstehendes Skelett\', \'text\': \'{1}{B}: Bringe das Wieder aufstehende Skelett aus deinem Friedhof getappt ins Spiel zurück.\', \'type\': \'Kreatur — Skelett, Krieger\', \'flavor\': \'„Manchmal kommen sie mit einem falschen Schenkelknochen oder einem schiefen Kiefer daher, aber sie tauchen immer wieder auf."\\n—Zul Ashur, Lichfürst\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447533&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9142f3b4-74df-400f-afaf-47ed49fbfa64\', \'multiverseId\': 447533}, \'multiverseid\': 447533}, {\'name\': \'Esqueleto reconstruyéndose\', \'text\': \'{1}{B}: Regresa el Esqueleto reconstruyéndose de tu cementerio al campo de batalla girado.\', \'type\': \'Criatura — Guerrero esqueleto\', \'flavor\': \'"Puede que aparezcan con un hueso mal puesto o sin la mandíbula, pero siempre aparecen".\\n—Zul Ashur, señor liche\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447814&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5d218dff-d3f6-460e-8a42-13bc2f41d580\', \'multiverseId\': 447814}, \'multiverseid\': 447814}, {\'name\': \'Squelette réassemblable\', \'text\': \'{1}{B} : Renvoyez sur le champ de bataille, engagé, le Squelette réassemblable depuis votre cimetière.\', \'type\': \'Créature : squelette et guerrier\', \'flavor\': \'« Ils ont parfois le mauvais fémur ou la mauvaise mâchoire, mais ils viennent toujours. »\\n—Zul Ashur, seigneur liche\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448095&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9fc5fa68-9621-437b-a041-5c55ad969ec0\', \'multiverseId\': 448095}, \'multiverseid\': 448095}, {\'name\': \'Scheletro Riassemblato\', \'text\': \'{1}{B}: Rimetti sul campo di battaglia lo Scheletro Riassemblato TAPpato dal tuo cimitero.\', \'type\': \'Creatura — Guerriero Scheletro\', \'flavor\': \'"Possono farsi vivi con il femore o la mandibola sbagliati, ma si fanno sempre vivi."\\n—Zul Ashur, signore dei lich\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448376&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7b95c976-ab18-4ff6-8050-22c315b39f09\', \'multiverseId\': 448376}, \'multiverseid\': 448376}, {\'name\': \'組み直しの骸骨\', \'text\': \'{1}{B}：あなたの墓地から組み直しの骸骨をタップ状態で戦場に戻す。\', \'type\': \'クリーチャー — スケルトン・戦士\', \'flavor\': \'「脚や顎の骨が違っていることもあるが、必ずこの場に現れる。」\\n――死者の王、ザル・アシュール\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448657&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'365fcee8-997c-4c8c-b6bf-4df1ddab3621\', \'multiverseId\': 448657}, \'multiverseid\': 448657}, {\'name\': \'재조립 해골\', \'text\': \'{1}{B}: 재조립 해골을 당신의 무덤에서 탭된 채로 전장으로 되돌린다.\', \'type\': \'생물 — 해골 전사\', \'flavor\': \'"가끔 남의 대퇴골이나 턱뼈를 달고 나타나서 그렇지, 언제나 나타나기는 나타나더군."\\n—리치 군주 줄 아슈르\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448938&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a00c35c1-c09f-4e83-a02b-402027d16368\', \'multiverseId\': 448938}, \'multiverseid\': 448938}, {\'name\': \'Esqueleto Remontado\', \'text\': \'{1}{B}: Devolva Esqueleto Remontado de seu cemitério para o campo de batalha virado.\', \'type\': \'Criatura — Esqueleto Guerreiro\', \'flavor\': \'"Eles podem até vir com um fêmur ou uma mandíbula trocados, mas sempre vêm."\\n— Zul Ashur, senhor lich\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449219&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'198f3441-ec72-43b8-be3b-96139049cafc\', \'multiverseId\': 449219}, \'multiverseid\': 449219}, {\'name\': \'Пересобирающийся Скелет\', \'text\': \'{1}{B}: верните Пересобирающийся Скелет из вашего кладбища на поле битвы повернутым.\', \'type\': \'Существо — Скелет Воин\', \'flavor\': \'«Они могут явиться с берцовой костью не на месте или с чужой челюстью, но они всегда являются».\\n— Зул Ашур, лорд-лич\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449500&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'71aed92c-ee82-4180-871a-f437f4ca85db\', \'multiverseId\': 449500}, \'multiverseid\': 449500}, {\'name\': \'重组骷髅妖\', \'text\': \'{1}{B}：将重组骷髅妖从你的坟墓场横置移回战场。\', \'type\': \'生物 ～骷髅妖／战士\', \'flavor\': \'「他们现身时可能装错了大腿骨或颔骨，但他们总是会现身。」\\n～巫妖领主祝亚许\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449781&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8da0ee87-892a-4fdc-9ede-76dd0672ba32\', \'multiverseId\': 449781}, \'multiverseid\': 449781}, {\'name\': \'重組骷髏妖\', \'text\': \'{1}{B}：將重組骷髏妖從你的墳墓場橫置移回戰場。\', \'type\': \'生物 ～骷髏妖／戰士\', \'flavor\': \'「他們現身時可能裝錯了大腿骨或頷骨，但他們總是會現身。」\\n～巫妖領主祝亞許\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450062&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2c6b4873-9e16-45cb-8686-a0472de9f392\', \'multiverseId\': 450062}, \'multiverseid\': 450062}]', '[{\'name\': \'Wildholzklauen\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur erhält +1/+1 und verursacht Trampelschaden. (Sie kann beim Angreifen dem verteidigenden Spieler oder Planeswalker überschüssigen Kampfschaden zufügen.)\\n{2}{G}: Bringe die Wildholzklauen aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447619&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3e0ab2e8-74d3-428b-80e2-2341b4ffa3b5\', \'multiverseId\': 447619}, \'multiverseid\': 447619}, {\'name\': \'Garras del bosque salvaje\', \'text\': \'Encantar criatura.\\nLa criatura encantada obtiene +1/+1 y tiene la habilidad de arrollar. (Puede hacer el daño de combate sobrante al jugador o planeswalker al que ataca.)\\n{2}{G}: Regresa las Garras del bosque salvaje de tu cementerio a tu mano.\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447900&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'319efe4d-8e43-49d0-ba6f-9fdd4666ea75\', \'multiverseId\': 447900}, \'multiverseid\': 447900}, {\'name\': \'Serres du bois sauvage\', \'text\': "Enchanter : créature\\nLa créature enchantée gagne +1/+1 et a le piétinement. (Elle peut infliger son surplus de blessures de combat au joueur ou au planeswalker qu\'elle attaque.)\\n{2}{G} : Renvoyez les Serres du bois sauvage depuis votre cimetière dans votre main.", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448181&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bc360b6b-fecb-43cf-b619-e0d7bebf464f\', \'multiverseId\': 448181}, \'multiverseid\': 448181}, {\'name\': \'Artigli del Bosco Selvaggio\', \'text\': \'Incanta creatura\\nLa creatura incantata prende +1/+1 e ha travolgere. (Può infliggere il danno da combattimento in eccesso al giocatore o al planeswalker che sta attaccando.)\\n{2}{G}: Riprendi in mano gli Artigli del Bosco Selvaggio dal tuo cimitero.\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448462&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'58bcc515-a728-4272-a04b-31796ce8cbcc\', \'multiverseId\': 448462}, \'multiverseid\': 448462}, {\'name\': \'野生林の鉤爪\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは＋１/＋１の修整を受け、トランプルを持つ。（これは余剰の戦闘ダメージをこれが攻撃しているプレイヤーかプレインズウォーカーに与えることができる。）\\n{2}{G}：あなたの墓地から野生林の鉤爪をあなたの手札に戻す。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448743&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'60a80732-70f1-4e46-97b8-9e652ef7d365\', \'multiverseId\': 448743}, \'multiverseid\': 448743}, {\'name\': \'야생림의 발톱\', \'text\': \'생물에게 부여\\n부여된 생물은 +1/+1을 받고 돌진을 가진다. (그 생물은 여분의 전투피해를 공격 중인 플레이어 또는 플레인즈워커에게 입힐 수 있다.)\\n{2}{G}: 야생림의 발톱을 당신의 무덤에서 당신의 손으로 되돌린다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449024&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'31b5abe4-4fa9-47af-875b-8f0d3d01ddf8\', \'multiverseId\': 449024}, \'multiverseid\': 449024}, {\'name\': \'Gadanhos do Bosque Selvagem\', \'text\': \'Encantar criatura\\nA criatura encantada recebe +1/+1 e tem atropelar. (Ela pode causar seu dano de combate excedente ao jogador ou planeswalker que ela estiver atacando.)\\n{2}{G}: Devolva Gadanhos do Bosque Selvagem de seu cemitério para sua mão.\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449305&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dea4998e-0091-42cc-935a-ba9e77cc8983\', \'multiverseId\': 449305}, \'multiverseid\': 449305}, {\'name\': \'Когти Лесной Чащи\', \'text\': \'Зачаровать существо\\nЗачарованное существо получает +1/+1 и имеет Пробивной удар. (Оно может нанести избыточные боевые повреждения игроку или planeswalker-у, которого атакует.)\\n{2}{G}: верните Когти Лесной Чащи из вашего кладбища в вашу руку.\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449586&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8586147b-e89a-4cb6-a993-be271c772ef0\', \'multiverseId\': 449586}, \'multiverseid\': 449586}, {\'name\': \'野林利爪\', \'text\': \'结附于生物\\n所结附的生物得+1/+1且具有践踏异能。（它攻击时造成之过量战斗伤害能对防御牌手或鹏洛客造成之。）\\n{2}{G}：将野林利爪从你的坟墓场移回你手上。\', \'type\': \'结界 ～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449867&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b28cfa65-d972-455c-9d5b-29a8e451a3e6\', \'multiverseId\': 449867}, \'multiverseid\': 449867}, {\'name\': \'野林利爪\', \'text\': \'結附於生物\\n所結附的生物得+1/+1且具有踐踏異能。（它造成之過量戰鬥傷害能對所攻擊的玩家或鵬洛客造成之。）\\n{2}{G}：將野林利爪從你的墳墓場移回你手上。\', \'type\': \'結界 ～靈氣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450148&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3b99b081-99cb-4ed2-914b-1cc331cc5658\', \'multiverseId\': 450148}, \'multiverseid\': 450148}]', '[{\'name\': \'Windvertraute Sphinx\', \'text\': \'Fliegend\\nImmer wenn eine Kreatur mit Flugfähigkeit angreift, kannst du eine Karte ziehen.\', \'type\': \'Kreatur — Sphinx\', \'flavor\': \'„Dein Kopf ist zu voll mit albernen Sorgen, um das leise Flüstern zu vernehmen, das die Brise mit sich trägt."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447501&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9138a0aa-02f7-434a-9beb-91f07d7e4d0a\', \'multiverseId\': 447501}, \'multiverseid\': 447501}, {\'name\': \'Esfinge leevientos\', \'text\': \'Vuela.\\nSiempre que una criatura con la habilidad de volar ataque, puedes robar una carta.\', \'type\': \'Criatura — Esfinge\', \'flavor\': \'"Tu mente está demasiado llena de preocupaciones banales para oír los sutiles susurros que porta la brisa".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447782&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9dc19828-c63f-40fe-89ac-237967a48551\', \'multiverseId\': 447782}, \'multiverseid\': 447782}, {\'name\': \'Sphinx déchiffre-vent\', \'text\': "Vol\\nÀ chaque fois qu\'une créature avec le vol attaque, vous pouvez piocher une carte.", \'type\': \'Créature : sphinx\', \'flavor\': "« L\'inquiétude irraisonnée parasite ton cerveau au point de te rendre sourd aux murmures portés par la brise. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448063&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e74e5f56-8676-41d9-8694-67550abc9887\', \'multiverseId\': 448063}, \'multiverseid\': 448063}, {\'name\': \'Sfinge Scrutavento\', \'text\': \'Volare\\nOgniqualvolta una creatura con volare attacca, puoi pescare una carta.\', \'type\': \'Creatura — Sfinge\', \'flavor\': \'"La tua mente è troppo piena di preoccupazioni inutili per riuscire a percepire il sottile sussurro portato dalla brezza."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448344&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8be88437-af30-43da-8f54-83d3226d244d\', \'multiverseId\': 448344}, \'multiverseid\': 448344}, {\'name\': \'風読みのスフィンクス\', \'text\': \'飛行\\n飛行を持つクリーチャーが１体攻撃するたび、あなたはカードを１枚引いてもよい。\', \'type\': \'クリーチャー — スフィンクス\', \'flavor\': \'「お前の心は愚かな心配事で一杯になっている。それでは風が運んでくるかすかな囁きは聴こえまい。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448625&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'57222d86-d6d9-4945-8009-528c7b7ef962\', \'multiverseId\': 448625}, \'multiverseid\': 448625}, {\'name\': \'바람을 읽는 스핑크스\', \'text\': \'비행\\n비행을 가진 생물이 공격할 때마다, 당신은 카드 한 장을 뽑을 수 있다.\', \'type\': \'생물 — 스핑크스\', \'flavor\': \'"어리석은 근심으로 가득찬 네 마음은 미풍의 속삭임을 들을 수 없다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448906&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'58c84fbc-546b-4bb3-a038-a0cc27c46f6e\', \'multiverseId\': 448906}, \'multiverseid\': 448906}, {\'name\': \'Esfinge Leitora de Ventos\', \'text\': \'Voar\\nToda vez que uma criatura com voar ataca, você pode comprar um card.\', \'type\': \'Criatura — Esfinge\', \'flavor\': \'"Sua mente está cheia demais de preocupações tolas para ouvir os sussurros sutis que a brisa traz."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449187&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'487b961f-ccf0-4807-ad8a-6329d4230c34\', \'multiverseId\': 449187}, \'multiverseid\': 449187}, {\'name\': \'Сфинкс, Предсказатель Ветров\', \'text\': \'Полет\\nКаждый раз, когда существо с Полетом атакует, вы можете взять карту.\', \'type\': \'Существо — Сфинкс\', \'flavor\': \'«Ваш ум слишком занят заботами о мелочах, чтобы расслышать, что вполголоса нашептывает ветер».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449468&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ed01683f-7196-44ce-bdb1-cae976782f42\', \'multiverseId\': 449468}, \'multiverseid\': 449468}, {\'name\': \'风信史芬斯\', \'text\': \'飞行\\n每当一个具飞行异能的生物攻击时，你可以抓一张牌。\', \'type\': \'生物 ～史芬斯\', \'flavor\': \'「你的脑袋塞满了愚蠢的担忧，以致无法听到微风带来的细微低语。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449749&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d62fdae6-f4df-48b2-ba1e-7c8f4602d958\', \'multiverseId\': 449749}, \'multiverseid\': 449749}, {\'name\': \'風信史芬斯\', \'text\': \'飛行\\n每當一個具飛行異能的生物攻擊時，你可以抽一張牌。\', \'type\': \'生物 ～史芬斯\', \'flavor\': \'「你的腦袋塞滿了愚蠢的擔憂，以致無法聽到微風帶來的細微低語。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450030&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d356cb30-cb74-48e2-b861-118bd7df56a1\', \'multiverseId\': 450030}, \'multiverseid\': 450030}]', "[{'name': 'Wurzelschlinge', 'text': 'Verhindere allen Kampfschaden, der in diesem Zug zugefügt würde.', 'type': 'Spontanzauber', 'flavor': 'In diesem Kampf wurden nur ein paar Speere, Helme und der Stolz der Soldaten beschädigt.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447616&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a026beda-2459-46aa-abf3-6b56aff96c2b', 'multiverseId': 447616}, 'multiverseid': 447616}, {'name': 'Apresar con raíces', 'text': 'Prevén todo el daño de combate que se fuera a hacer este turno.', 'type': 'Instantáneo', 'flavor': 'Las únicas víctimas fueron una lanza rota, un yelmo perdido y algunos egos magullados.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447897&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'f5b35714-56b6-4d72-b55e-d32a1d03f4ec', 'multiverseId': 447897}, 'multiverseid': 447897}, {'name': 'Collet de racines', 'text': 'Prévenez toutes les blessures de combat qui devraient être infligées ce tour-ci.', 'type': 'Éphémère', 'flavor': 'Les seules victimes étaient une lance brisée, un heaume égaré et quelques fiertés blessées.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448178&type=card', 'language': 'French', 'identifiers': {'scryfallId': '4cfb6275-e2d1-4a08-854a-6d7f469d545c', 'multiverseId': 448178}, 'multiverseid': 448178}, {'name': 'Trappola di Radici', 'text': 'Previeni tutto il danno da combattimento che verrebbe inflitto in questo turno.', 'type': 'Istantaneo', 'flavor': 'Le uniche vittime furono una lancia spezzata, un elmo perduto e qualche ego ferito.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448459&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '9ecbf75f-cc1c-4f47-a53f-8ae6e485511d', 'multiverseId': 448459}, 'multiverseid': 448459}, {'name': '根の罠', 'text': 'このターン、与えられる戦闘ダメージをすべて軽減する。', 'type': 'インスタント', 'flavor': '被害は、折れた槍、なくなった兜、そして傷ついたプライドだった。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448740&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '2b21af86-9a50-4c5e-ab31-3d8a57d79396', 'multiverseId': 448740}, 'multiverseid': 448740}, {'name': '뿌리 덫', 'text': '이 턴에 입혀지려 하는 모든 전투피해를 방지한다.', 'type': '순간마법', 'flavor': '부상을 입은 것은 부러진 창, 잃어버린 투구, 그리고 상처입은 자존심뿐이었다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449021&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '4944efeb-6db8-4c9b-a84e-d59163b2a37a', 'multiverseId': 449021}, 'multiverseid': 449021}, {'name': 'Armadilha de Raízes', 'text': 'Previna todo o dano de combate que seria causado neste turno.', 'type': 'Mágica Instantânea', 'flavor': 'As únicas baixas foram uma lança partida, um elmo perdido e alguns egos feridos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449302&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c0cadaa4-16d8-4937-a584-60f38b6a9020', 'multiverseId': 449302}, 'multiverseid': 449302}, {'name': 'Силки Корней', 'text': 'Предотвратите все боевые повреждения, которые должны быть нанесены в этом ходу.', 'type': 'Мгновенное заклинание', 'flavor': 'Потерь было немного: сломанное копье, помятый шлем да пострадавшая гордость.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449583&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'cc623978-5d54-47c6-9bfa-6c23d1dd701e', 'multiverseId': 449583}, 'multiverseid': 449583}, {'name': '重根绊索', 'text': '于本回合中，防止将造成的所有战斗伤害。', 'type': '瞬间', 'flavor': '仅有的战损是折断一柄长矛，丢失一顶头盔，以及丧失部分信心。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449864&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '11b67653-67be-4b5a-bcba-ab90b45e1afd', 'multiverseId': 449864}, 'multiverseid': 449864}, {'name': '重根絆索', 'text': '於本回合中，防止將造成的所有戰鬥傷害。', 'type': '瞬間', 'flavor': '僅有的戰損是折斷一柄長矛，丟失一頂頭盔，以及喪失部分信心。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450145&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'd0a85ab4-a18f-48b5-ba74-9fd3ced470e3', 'multiverseId': 450145}, 'multiverseid': 450145}]", '[{\'name\': \'Zentauren-Renner\', \'type\': \'Kreatur — Zentaur, Krieger\', \'flavor\': \'„Zentauren kennen die wahre Freiheit. Nie wird die Versuchung sie zähmen oder die Furcht sie übermannen. Sie leben in vollkommener Harmonie, was wir noch lange nicht erreicht haben."\\n—Ramal, Weiser aus Westtor\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447588&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'49e0acec-7f47-4605-92b9-5066fe31f7ba\', \'multiverseId\': 447588}, \'multiverseid\': 447588}, {\'name\': \'Cazador centauro\', \'type\': \'Criatura — Guerrero centauro\', \'flavor\': \'"Los centauros son realmente libres. Nunca serán dominados por la tentación o controlados por el miedo. Viven en completa armonía, algo todavía no logrado por nuestra gente".\\n—Ramal, sabio del Portón Occidental\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447869&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'008ba2ff-4158-4575-8494-90a3649109a4\', \'multiverseId\': 447869}, \'multiverseid\': 447869}, {\'name\': \'Coursier centaure\', \'type\': \'Créature : centaure et guerrier\', \'flavor\': "« Les centaures sont véritablement libres. Ils ne seront jamais apprivoisés par la tentation ou contrôlés par la peur. Ils vivent en parfaite harmonie, un exploit que nous sommes encore loin d\'accomplir. »\\n—Ramal, sage de Portorient", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448150&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'da2139a4-fc6a-4697-abaa-1dd7d2ac9ab2\', \'multiverseId\': 448150}, \'multiverseid\': 448150}, {\'name\': \'Corsiera Centaura\', \'type\': \'Creatura — Guerriero Centauro\', \'flavor\': \'"I centauri sono realmente liberi. Non saranno mai domati dalla tentazione né controllati dalla paura. Vivono in totale armonia, un\\\'impresa non ancora realizzata dalla nostra gente."\\n—Ramal, saggio di Westgate\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448431&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'01889fc8-c681-4426-875b-2873c417cc54\', \'multiverseId\': 448431}, \'multiverseid\': 448431}, {\'name\': \'ケンタウルスの狩猟者\', \'type\': \'クリーチャー — ケンタウルス・戦士\', \'flavor\': \'「ケンタウルスは真に自由だ。誘惑に負けることもなければ、恐怖に操られることもない。彼らの生き様は、我らの類がまだ達していない完全な調和を成している。」\\n――西門の賢者、ラマール\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448712&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1fd5aa72-ce3e-4b9d-b8be-ca13924e53d1\', \'multiverseId\': 448712}, \'multiverseid\': 448712}, {\'name\': \'발빠른 켄타우로스\', \'type\': \'생물 — 켄타우로스 전사\', \'flavor\': \'"이 생물은 진정으로 자유로운 존재다. 어떤 유혹으로도 이들을 길들일 수 없고 두려움을 이용해 조종할 수도 없다. 이들은 완벽한 조화를 이루며 살아가는데, 이는 우리 종족이 아직 달성하지 못한 위대한 업적이다."\\n—서쪽 관문의 현자 라말\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448993&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e8da8488-b9d2-4fe8-9bdc-eb85ec28bff4\', \'multiverseId\': 448993}, \'multiverseid\': 448993}, {\'name\': \'Centaura-caçadora\', \'type\': \'Criatura — Centauro Guerreiro\', \'flavor\': \'"Os centauros são verdadeiramente livres. Não são domados pela tentação nem controlados pelo medo. Vivem em total harmonia — um feito ainda não alcançado por nossa raça."\\n— Ramal, sábio de Portão Ocidental\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449274&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'97eeaa57-a39b-4ce2-92dd-241c0bfca0e1\', \'multiverseId\': 449274}, \'multiverseid\': 449274}, {\'name\': \'Быстроногий Кентавр\', \'type\': \'Существо — Кентавр Воин\', \'flavor\': \'«Кентавры по-настоящему свободны. Их нельзя ни укротить соблазном, ни подчинить страхом. Они живут в полной гармонии, до сих пор не ведомой таким, как мы».\\n— Рамаль, мудрец из Вестгейта\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449555&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cb12555a-5144-4662-b469-ded270f80edc\', \'multiverseId\': 449555}, \'multiverseid\': 449555}, {\'name\': \'半人骏马\', \'type\': \'生物 ～半人马／战士\', \'flavor\': \'「半人马享有真正的自由。他们永远不会因诱惑而被驯服，也不会因恐惧而遭控制。生活在完全的和谐中，这是我们族类尚未达到的境界。」\\n～西门智者拉默\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449836&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'73b5d296-b584-40d1-b60a-cbcca16feead\', \'multiverseId\': 449836}, \'multiverseid\': 449836}, {\'name\': \'半人駿馬\', \'type\': \'生物 ～半人馬／戰士\', \'flavor\': \'「半人馬享有真正的自由。他們永遠不會因誘惑而被馴服，也不會因恐懼而遭控制。生活在完全的和諧中，這是我們族類尚未達到的境界。」\\n～西門智者拉默\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450117&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'43344396-5de4-41ef-97d4-0071d6516a96\', \'multiverseId\': 450117}, \'multiverseid\': 450117}]', '[{\'name\': \'Zerlumpte Mumie\', \'text\': \'Wenn die Zerlumpte Mumie stirbt, verliert jeder Gegner 2 Lebenspunkte.\', \'type\': \'Kreatur — Zombie, Schakal\', \'flavor\': \'Die Toten, die außerhalb der Mauern der Stadt Naktamun umherwandern, haben nur noch den Wunsch, ihren Fluch weiterzugeben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450276&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d78d90e9-aff4-4250-9f05-22cdd59d958c\', \'multiverseId\': 450276}, \'multiverseid\': 450276}, {\'name\': \'Momia andrajosa\', \'text\': \'Cuando la Momia andrajosa muera, cada oponente pierde 2 vidas.\', \'type\': \'Criatura — Chacal zombie\', \'flavor\': \'Los muertos que se alejan de la seguridad de la ciudad de Naktamun solo buscan esparcir su maldición.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450310&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'998145aa-d56c-471f-9e0a-e99d8a07745b\', \'multiverseId\': 450310}, \'multiverseid\': 450310}, {\'name\': \'Momie en lambeaux\', \'text\': \'Quand la Momie en lambeaux meurt, chaque adversaire perd 2 points de vie.\', \'type\': \'Créature : zombie et chacal\', \'flavor\': "Les morts qui s\'aventurent par-delà les murs protecteurs de la ville de Naktamon ne cherchent qu\'à répandre leur malédiction.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450344&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2e96f422-229b-4b84-bdb9-e55268664c7e\', \'multiverseId\': 450344}, \'multiverseid\': 450344}, {\'name\': \'Mummia Lacera\', \'text\': \'Quando la Mummia Lacera muore, ogni avversario perde 2 punti vita.\', \'type\': \'Creatura — Sciacallo Zombie\', \'flavor\': \'I morti che abbandonano la sicurezza della città di Naktamun bramano solo diffondere la propria maledizione.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450378&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'af7b4519-7652-484c-aee1-bff8a61b7f38\', \'multiverseId\': 450378}, \'multiverseid\': 450378}, {\'name\': \'ぼろぼろのミイラ\', \'text\': \'ぼろぼろのミイラが死亡したとき、各対戦相手はそれぞれ２点のライフを失う。\', \'type\': \'クリーチャー — ゾンビ・ジャッカル\', \'flavor\': \'安全なナクタムンの街の外をうろつく死者たちは、自身の呪いを広めることのみを渇望する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450412&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bdf82c30-c036-4707-a559-706291686b88\', \'multiverseId\': 450412}, \'multiverseid\': 450412}, {\'name\': \'넝마 미라\', \'text\': \'넝마 미라가 죽을 때, 각 상대는 생명 2점을 잃는다.\', \'type\': \'생물 — 좀비 자칼\', \'flavor\': \'안전한 도시 나크타문을 벗어나 배회하는 망자들에게는 오직 저주를 퍼뜨리려는 욕망만이 남아 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450446&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'05ab9a48-731c-4995-9509-7b6fb825b304\', \'multiverseId\': 450446}, \'multiverseid\': 450446}, {\'name\': \'Múmia Esfarrapada\', \'text\': \'Quando Múmia Esfarrapada morre, cada oponente perde 2 pontos de vida.\', \'type\': \'Criatura — Zumbi Chacal\', \'flavor\': \'Os mortos que se aventuram além da segurança da cidade de Nactamon desejam apenas propagar sua maldição.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450480&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d7b0ceda-5e18-49de-a33c-a3e14360621f\', \'multiverseId\': 450480}, \'multiverseid\': 450480}, {\'name\': \'Растрепанная Мумия\', \'text\': \'Когда Растрепанная Мумия умирает, каждый оппонент теряет 2 жизни.\', \'type\': \'Существо — Зомби Шакал\', \'flavor\': \'Мертвецы, бродящие за безопасными пределами города Нактамун, жаждут лишь заразить других своим проклятьем.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450514&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'24821021-1e5c-463d-bb8f-1dc1c53ee1f2\', \'multiverseId\': 450514}, \'multiverseid\': 450514}, {\'name\': \'褴褛木乃伊\', \'text\': \'当褴褛木乃伊死去时，每位对手各失去2点生命。\', \'type\': \'生物 ～灵俑／豺狼\', \'flavor\': \'他们死后漂浪在拿塔蒙城护帘之外，唯愿能有更多的人遭受这般诅咒。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450548&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bbefc3d9-7221-403d-81d2-17b12af1f59d\', \'multiverseId\': 450548}, \'multiverseid\': 450548}, {\'name\': \'襤褸木乃伊\', \'text\': \'當襤褸木乃伊死去時，每位對手各失去2點生命。\', \'type\': \'生物 ～殭屍／豺狼\', \'flavor\': \'他們死後漂浪在拿塔蒙城護簾之外，唯願能有更多的人遭受這般詛咒。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450582&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a991e836-3bb1-4482-8eb0-b753cef3aa40\', \'multiverseId\': 450582}, \'multiverseid\': 450582}]', '[{\'name\': \'Zunder-Öde\', \'text\': \'Die Zunder-Öde kommt getappt ins Spiel.\\n{T}: Erzeuge {B} oder {R}.\', \'type\': \'Land\', \'flavor\': \'„Diese Welt gehört mir und mit meinem Eigentum verfahre ich, wie es mir gefällt."\\n—Nicol Bolas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447666&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5e2a7caf-e720-4993-9a4d-b8bef7754a9f\', \'multiverseId\': 447666}, \'multiverseid\': 447666}, {\'name\': \'Yermos de ceniza\', \'text\': \'Los Yermos de ceniza entran al campo de batalla girados.\\n{T}: Agrega {B} o {R}.\', \'type\': \'Tierra\', \'flavor\': \'"Hago lo que quiero con lo que es mío. Y todo es mío".\\n—Nicol Bolas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447947&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'18059f65-c1c1-4286-90ce-13dc6df6f758\', \'multiverseId\': 447947}, \'multiverseid\': 447947}, {\'name\': \'Landes de cendres\', \'text\': \'Les Landes de cendres arrivent sur le champ de bataille engagées.\\n{T} : Ajoutez {B} ou {R}.\', \'type\': \'Terrain\', \'flavor\': "« Je fais ce que je veux avec ce qui m\'appartient. Et tout m\'appartient. »\\n—Nicol Bolas", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448228&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f24bf1ce-8eed-4b57-b9ef-e32c09768de8\', \'multiverseId\': 448228}, \'multiverseid\': 448228}, {\'name\': \'Distese di Cenere\', \'text\': \'Le Distese di Cenere entrano nel campo di battaglia TAPpate.\\n{T}: Aggiungi {B} o {R}.\', \'type\': \'Terra\', \'flavor\': \'"Dispongo come meglio credo di ciò che mi appartiene. E qui tutto mi appartiene."\\n—Nicol Bolas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448509&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'95e304a0-5aa0-4780-82b7-deaab440063b\', \'multiverseId\': 448509}, \'multiverseid\': 448509}, {\'name\': \'燃え殻の痩せ地\', \'text\': \'燃え殻の痩せ地はタップ状態で戦場に出る。\\n{T}：{B}か{R}を加える。\', \'type\': \'土地\', \'flavor\': \'「我のものを使い、我の選んだことをやるまでよ。すべては我のものだからのう。」\\n――ニコル・ボーラス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448790&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c33b5ede-7009-416e-8fcd-8f49d3de74d7\', \'multiverseId\': 448790}, \'multiverseid\': 448790}, {\'name\': \'잿더미 황무지\', \'text\': \'잿더미 황무지는 탭된 채로 전장에 들어온다.\\n{T}: {B} 또는 {R}를 추가한다.\', \'type\': \'대지\', \'flavor\': \'"내 것은 내 뜻대로 할 테다. 그리고 이 모든 게 다 내 것이다."\\n—니콜 볼라스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449071&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'73a5d702-96ca-4559-a28f-05cfaa175aaa\', \'multiverseId\': 449071}, \'multiverseid\': 449071}, {\'name\': \'Desolação de Cinzas\', \'text\': \'Desolação de Cinzas entra no campo de batalha virada.\\n{T}: Adicione {B} ou {R}.\', \'type\': \'Terreno\', \'flavor\': \'"Faço o que me apraz com o que é meu. E tudo isso é meu."\\n— Nicol Bolas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449352&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'697760d9-e265-4f52-93f9-288dd1c42981\', \'multiverseId\': 449352}, \'multiverseid\': 449352}, {\'name\': \'Пепельные Пустоши\', \'text\': \'Пепельные Пустоши выходят на поле битвы повернутыми.\\n{T}: добавьте {B} или {R}.\', \'type\': \'Земля\', \'flavor\': \'«С тем, что принадлежит мне, я поступаю, как мне вздумается. А мне принадлежит все».\\n— Никол Болас\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449633&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fbc19d50-b1e2-4c71-a555-2057ea711da4\', \'multiverseId\': 449633}, \'multiverseid\': 449633}, {\'name\': \'煤烬瘠地\', \'text\': \'煤烬瘠地须横置进战场。\\n{T}：加{B}或{R}。\', \'type\': \'地\', \'flavor\': \'「我的事物随我处置。而今一切尽归我有。」\\n～尼可波拉斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449914&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1cf2597a-6b2b-4984-8af8-5abff3269191\', \'multiverseId\': 449914}, \'multiverseid\': 449914}, {\'name\': \'煤燼瘠地\', \'text\': \'煤燼瘠地須橫置進戰場。\\n{T}：加{B}或{R}。\', \'type\': \'地\', \'flavor\': \'「我的事物隨我處置。而今一切盡歸我有。」\\n～尼可波拉斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450195&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'80e11b7a-5dd2-4dcd-8db9-fc0860dcbb1d\', \'multiverseId\': 450195}, \'multiverseid\': 450195}]', '[{\'name\': \'Zuverlässiges Lasttier\', \'text\': \'Wenn das Zuverlässige Lasttier ins Spiel kommt, bringe eine Artefaktkarte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Kreatur — Bestie\', \'flavor\': \'„Butterblume ist mit mir bis ans Ende der Welt und wieder zurück gereist."\\n—Hewen Frit, Händler\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447458&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'44cf6f68-71f7-4c44-9074-a0d085f40741\', \'multiverseId\': 447458}, \'multiverseid\': 447458}, {\'name\': \'Bestia de carga leal\', \'text\': \'Cuando la Bestia de carga leal entre al campo de batalla, regresa la carta de artefacto objetivo de tu cementerio a tu mano.\', \'type\': \'Criatura — Bestia\', \'flavor\': \'"Margarita ha viajado conmigo hasta el confín del mundo y de regreso".\\n—Hewen Frit, mercader\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447739&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'38c2633b-1d12-475a-8079-e5d6987a1925\', \'multiverseId\': 447739}, \'multiverseid\': 447739}, {\'name\': \'Bête de somme fidèle\', \'text\': "Quand la Bête de somme fidèle arrive sur le champ de bataille, renvoyez une carte d\'artefact ciblée depuis votre cimetière dans votre main.", \'type\': \'Créature : bête\', \'flavor\': "« Marguerite a voyagé avec moi jusqu\'au bout du monde. »\\n—Hewen Frit, marchand", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448020&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cc0b3633-188d-4d0f-bcfd-f33392113ded\', \'multiverseId\': 448020}, \'multiverseid\': 448020}, {\'name\': \'Bestia da Carico Fidata\', \'text\': \'Quando la Bestia da Carico Fidata entra nel campo di battaglia, riprendi in mano una carta artefatto bersaglio dal tuo cimitero.\', \'type\': \'Creatura — Bestia\', \'flavor\': \'"Margaret ha viaggiato con me fino alla fine del mondo."\\n—Hewen Frit, mercante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448301&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'82723204-f519-48e1-a7a6-7504f0dc2028\', \'multiverseId\': 448301}, \'multiverseid\': 448301}, {\'name\': \'信頼できる荷役獣\', \'text\': \'信頼できる荷役獣が戦場に出たとき、あなたの墓地からアーティファクト・カード１枚を対象とし、それをあなたの手札に戻す。\', \'type\': \'クリーチャー — ビースト\', \'flavor\': \'「マーガレットは世界の果てまで私と共に旅をして、また帰ってきた。」\\n――商人、ヒューウェン・フリット\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448582&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7a669ff9-6692-4ec6-af1a-a802e2f13d59\', \'multiverseId\': 448582}, \'multiverseid\': 448582}, {\'name\': \'충직한 짐 운반 동물\', \'text\': \'충직한 짐 운반 동물이 전장에 들어올 때, 당신의 무덤에 있는 마법물체 카드를 목표로 정한다. 그 카드를 당신의 손으로 되돌린다.\', \'type\': \'생물 — 야수\', \'flavor\': \'"마가렛은 나와 함께 세상 끝까지 갔다가 돌아왔지."\\n—상인, 휴웬 프리트\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448863&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'609edac2-9351-4813-bb96-e21777987e58\', \'multiverseId\': 448863}, \'multiverseid\': 448863}, {\'name\': \'Besta de Carga Confiável\', \'text\': \'Quando Besta de Carga Confiável entrar no campo de batalha, devolva o card de artefato alvo de seu cemitério para sua mão.\', \'type\': \'Criatura — Besta\', \'flavor\': \'"Margaret viajou comigo até o fim do mundo e de volta."\\n— Hewen Frit, comerciante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449144&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fb4440ce-34fe-479a-b687-2f5a69c47f4e\', \'multiverseId\': 449144}, \'multiverseid\': 449144}, {\'name\': \'Верный Тяжеловоз\', \'text\': \'Когда Верный Тяжеловоз выходит на поле битвы, верните целевую карту артефакта из вашего кладбища в вашу руку.\', \'type\': \'Существо — Зверь\', \'flavor\': \'«Маргарет протопала со мной до самого края света и обратно».\\n— Хьюен Фрит, купец\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449425&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6ede5680-6255-4a0b-9104-b9e3e5cc0292\', \'multiverseId\': 449425}, \'multiverseid\': 449425}, {\'name\': \'可靠驮兽\', \'text\': \'当可靠驮兽进战场时，将目标神器牌从你的坟墓场移回你手上。\', \'type\': \'生物 ～野兽\', \'flavor\': \'「玛格丽特已经伴我往返于天涯海角。」\\n～商人赫文费特\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449706&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e3e6af32-1327-4a7f-b82a-068b151dc218\', \'multiverseId\': 449706}, \'multiverseid\': 449706}, {\'name\': \'可靠馱獸\', \'text\': \'當可靠馱獸進戰場時，將目標神器牌從你的墳墓場移回你手上。\', \'type\': \'生物 ～野獸\', \'flavor\': \'「瑪格麗特已經伴我往返於天涯海角。」\\n～商人赫文費特\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449987&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1c5b6911-4e15-4aff-a43c-04e8db6858b9\', \'multiverseId\': 449987}, \'multiverseid\': 449987}]', '[{\'name\': \'Zwang\', \'text\': \'Ein Gegner deiner Wahl zeigt die Karten auf seiner Hand offen vor. Du bestimmst davon eine Karte, die weder eine Kreatur noch ein Land ist. Der Spieler wirft die bestimmte Karte ab.\', \'type\': \'Hexerei\', \'flavor\': \'„Es tut mehr weh, wenn du daran denkst."\\n—Hake, Folterer der Kabbalisten\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447511&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'511452bd-2eaf-4b94-af03-2a9615fc1a2c\', \'multiverseId\': 447511}, \'multiverseid\': 447511}, {\'name\': \'Coacción\', \'text\': \'El oponente objetivo muestra su mano. Tú eliges de ahí una carta que no sea tierra ni criatura. Ese jugador descarta esa carta.\', \'type\': \'Conjuro\', \'flavor\': \'"Duele más si piensas en ello".\\n—Garfios, torturador de la Cábala\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447792&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d90b8802-5d91-4d50-a283-3771a01ff199\', \'multiverseId\': 447792}, \'multiverseid\': 447792}, {\'name\': \'Contrainte\', \'text\': "L\'adversaire ciblé révèle sa main. Vous y choisissez une carte non-créature non-terrain. Ce joueur se défausse de cette carte.", \'type\': \'Rituel\', \'flavor\': "« C\'est sensiblement plus douloureux si vous y pensez. »\\n—Crochets, tortionnaire de la Coterie", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448073&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'549ebae9-42c3-4d9c-be07-d9374ba85584\', \'multiverseId\': 448073}, \'multiverseid\': 448073}, {\'name\': \'Costrizione\', \'text\': \'Un avversario bersaglio rivela la sua mano. Scegli una carta non terra, non creatura da quella mano. Quel giocatore scarta quella carta.\', \'type\': \'Stregoneria\', \'flavor\': \'"Fa ancora più male se ci pensi."\\n—Uncino, torturatore della Cabala\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448354&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f42d7763-3524-4aa7-be9b-a00f0cb0c709\', \'multiverseId\': 448354}, \'multiverseid\': 448354}, {\'name\': \'強迫\', \'text\': \'対戦相手１人を対象とする。そのプレイヤーは自分の手札を公開する。あなたはその中からクリーチャーでも土地でもないカード１枚を選ぶ。そのプレイヤーはそのカードを捨てる。\', \'type\': \'ソーサリー\', \'flavor\': \'「考えるとなおさら痛いぞ。」\\n――陰謀団の拷問官、フックス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448635&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c9f3da65-b3cd-4d86-ae90-ade92b41cdc1\', \'multiverseId\': 448635}, \'multiverseid\': 448635}, {\'name\': \'구속\', \'text\': \'상대를 목표로 정한다. 그 플레이어는 자신의 손을 공개한다. 그중 생물이 아니고 대지가 아닌 카드 한 장을 선택한다. 그 플레이어는 그 카드를 버린다.\', \'type\': \'집중마법\', \'flavor\': \'"너무 깊게 생각하면 더 아프다고."\\n—도당의 고문기술자, 훅스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448916&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2410e18b-0f0b-4217-b548-9335e46d8ed8\', \'multiverseId\': 448916}, \'multiverseid\': 448916}, {\'name\': \'Coagir\', \'text\': \'O oponente alvo revela a própria mão. Você escolhe um card que não seja um terreno nem uma criatura da mão dele. Aquele jogador descarta aquele card.\', \'type\': \'Feitiço\', \'flavor\': \'"Dói mais quando você pensa no assunto."\\n— Hooks, torturador da Cabala\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449197&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'262ae2ac-8500-4ec1-91ec-b326cf485a79\', \'multiverseId\': 449197}, \'multiverseid\': 449197}, {\'name\': \'Насилие\', \'text\': \'Целевой оппонент показывает свою руку. Вы выбираете из нее карту, не являющуюся ни существом, ни землей. Тот игрок сбрасывает ту карту.\', \'type\': \'Волшебство\', \'flavor\': \'«Будет еще больнее, если об этом думать».\\n— Крюк, палач Кабала\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449478&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b3d10c8d-81d3-473f-a6c2-a404a612f342\', \'multiverseId\': 449478}, \'multiverseid\': 449478}, {\'name\': \'逼从\', \'text\': \'目标对手展示其手牌。你选择其中一张非生物且非地的牌。该牌手弃掉该牌。\', \'type\': \'法术\', \'flavor\': \'「再想也只不过是徒添伤感。」\\n～柯帮刑吏虎克\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449759&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4bf98dad-a181-409a-9011-81768dedd26a\', \'multiverseId\': 449759}, \'multiverseid\': 449759}, {\'name\': \'逼從\', \'text\': \'目標對手展示其手牌。你選擇其中一張非生物且非地的牌。該玩家棄掉該牌。\', \'type\': \'巫術\', \'flavor\': \'「再想也只不過是徒添傷感。」\\n～柯幫刑吏虎克\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450040&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c98976b1-2980-440e-a36d-41cfa4bffdbd\', \'multiverseId\': 450040}, \'multiverseid\': 450040}]', '[{\'name\': \'Zweiköpfiger Zombie\', \'text\': \'Bedrohlich (Diese Kreatur kann nicht geblockt werden, außer von zwei oder mehr Kreaturen.)\', \'type\': \'Kreatur — Zombie\', \'flavor\': \'„Näht die Torsos mit Engelshaar aneinander, damit sie im Kampf auch kooperieren."\\n—Foliant des Leichenflickers\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447540&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e9131e5a-6984-494f-9fe9-bcafe00f4d9e\', \'multiverseId\': 447540}, \'multiverseid\': 447540}, {\'name\': \'Zombie de dos cabezas\', \'text\': \'Amenaza. (Esta criatura no puede ser bloqueada excepto por dos o más criaturas.)\', \'type\': \'Criatura — Zombie\', \'flavor\': \'"Cose juntos ambos torsos con hilo de ángel para asegurarte de que cooperan en el combate".\\n—Manual del suturador\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447821&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5960e716-6a5c-426d-b0ff-d2d1600e4ee6\', \'multiverseId\': 447821}, \'multiverseid\': 447821}, {\'name\': \'Zombie bicéphale\', \'text\': \'Menace (Cette créature ne peut pas être bloquée excepté par deux créatures ou plus.)\', \'type\': \'Créature : zombie\', \'flavor\': "« Coudre les torses ensemble avec un cheveu d\'ange pour assurer leur coopération au combat. »\\n—Le grimoire du raccommodeur", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448102&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4c8e2a9a-443b-45c4-bec9-94b8844897dc\', \'multiverseId\': 448102}, \'multiverseid\': 448102}, {\'name\': \'Zombie Bicefalo\', \'text\': \'Minacciare (Questa creatura non può essere bloccata tranne che da due o più creature.)\', \'type\': \'Creatura — Zombie\', \'flavor\': \'"Cuci i due busti con capelli d\\\'angelo per assicurarti che lottino fianco a fianco."\\n—Il Tomo del Cucitore\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448383&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2ac97e25-c008-492c-856f-d5ffd5999ae1\', \'multiverseId\': 448383}, \'multiverseid\': 448383}, {\'name\': \'双頭ゾンビ\', \'text\': \'威迫（このクリーチャーは２体以上のクリーチャーによってしかブロックされない。）\', \'type\': \'クリーチャー — ゾンビ\', \'flavor\': \'「彼らが戦いで協力するよう、胴は天使の髪で縫い合わせる。」\\n――縫い師の秘本\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448664&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5808d391-e03d-4e44-b40a-5f4a4939d899\', \'multiverseId\': 448664}, \'multiverseid\': 448664}, {\'name\': \'쌍두 좀비\', \'text\': \'호전적 (이 생물은 두 개 이상의 생물에만 방어될 수 있다.)\', \'type\': \'생물 — 좀비\', \'flavor\': \'"전투에서 상반신들이 서로 협력하게 하려면 그것들을 천사의 머리칼로 꿰매어 붙여야 한다."\\n—봉합술사의 고서\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448945&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f9325d1f-1fdf-4026-92c5-22a212bb7874\', \'multiverseId\': 448945}, \'multiverseid\': 448945}, {\'name\': \'Zumbi de Duas Cabeças\', \'text\': \'Ameaçar (Esta criatura só pode ser bloqueada por duas ou mais criaturas.)\', \'type\': \'Criatura — Zumbi\', \'flavor\': \'"Suture os torsos com cabelo de anjo para garantir que eles cooperem em batalha."\\n— O Tomo do Suturador\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449226&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3a9b43c6-7dfb-4d93-bc5f-a5e129159cdc\', \'multiverseId\': 449226}, \'multiverseid\': 449226}, {\'name\': \'Двухголовый Зомби\', \'text\': \'Угроза (Это существо не может быть заблокировано менее чем двумя существами.)\', \'type\': \'Существо — Зомби\', \'flavor\': \'«Чтобы в битве два торса действовали заодно, сшивать их надобно волосом ангела».\\n— «Фолиант сшивателя»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449507&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d29bd165-f003-4bbf-ba50-4f5bb90f587b\', \'multiverseId\': 449507}, \'multiverseid\': 449507}, {\'name\': \'双头灵俑\', \'text\': \'威慑（此生物只能被两个或更多生物阻挡。）\', \'type\': \'生物 ～灵俑\', \'flavor\': \'「用天使头发缝合尸身，便能确保他们在战斗中互相合作。」\\n～《拼接师文典》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449788&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5fab9612-47b9-4a42-83cb-a90743ff652e\', \'multiverseId\': 449788}, \'multiverseid\': 449788}, {\'name\': \'雙頭殭屍\', \'text\': \'威懾（此生物只能被兩個或更多生物阻擋。）\', \'type\': \'生物 ～殭屍\', \'flavor\': \'「用天使頭髮縫合屍身，便能確保他們在戰鬥中互相合作。」\\n～《拼接師文典》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450069&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'dbd61113-a5b1-4a22-b890-f386b53d4c9f\', \'multiverseId\': 450069}, \'multiverseid\': 450069}]', '[{\'name\': \'Zwergenpriester\', \'text\': \'Wenn der Zwergenpriester ins Spiel kommt, erhältst du für jede Kreatur, die du kontrollierst, 1 Lebenspunkt dazu.\', \'type\': \'Kreatur — Zwerg, Kleriker\', \'flavor\': \'„Diese geschichtsträchtigen Hallen stehen unter meinem Schutz."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447428&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d69c220c-414e-498f-9e39-8b03b0e75e61\', \'multiverseId\': 447428}, \'multiverseid\': 447428}, {\'name\': \'Enano sacerdote\', \'text\': \'Cuando el Enano sacerdote entre al campo de batalla, ganas 1 vida por cada criatura que controlas.\', \'type\': \'Criatura — Enano clérigo\', \'flavor\': \'"Estos salones legendarios están bajo mi protección".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447709&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0cdab638-5dc9-47e9-82b8-f2760834d06f\', \'multiverseId\': 447709}, \'multiverseid\': 447709}, {\'name\': \'Prêtre nain\', \'text\': \'Quand le Prêtre nain arrive sur le champ de bataille, vous gagnez 1 point de vie pour chaque créature que vous contrôlez.\', \'type\': \'Créature : nain et clerc\', \'flavor\': "« Ces salles chargées d\'histoire sont sous ma protection. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447990&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f684af8d-80f8-4bc3-a88d-52e02a8a1df9\', \'multiverseId\': 447990}, \'multiverseid\': 447990}, {\'name\': \'Sacerdote dei Nani\', \'text\': \'Quando il Sacerdote dei Nani entra nel campo di battaglia, guadagni 1 punto vita per ogni creatura che controlli.\', \'type\': \'Creatura — Chierico Nano\', \'flavor\': \'"Queste sale colme di storia sono sotto la mia protezione."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448271&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7f2a13e2-ba94-451d-9d62-16d0df5b5a2b\', \'multiverseId\': 448271}, \'multiverseid\': 448271}, {\'name\': \'ドワーフの僧侶\', \'text\': \'ドワーフの僧侶が戦場に出たとき、あなたはあなたがコントロールしているクリーチャー１体につき１点のライフを得る。\', \'type\': \'クリーチャー — ドワーフ・クレリック\', \'flavor\': \'「この名高い場所は私の守護下にある。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448552&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d63d20dd-fcd5-441c-99ea-5f29cb4352d9\', \'multiverseId\': 448552}, \'multiverseid\': 448552}, {\'name\': \'드워프 사제\', \'text\': \'드워프 사제가 전장에 들어올 때, 당신은 당신이 조종하는 생물 한 개당 생명 1점을 얻는다.\', \'type\': \'생물 — 드워프 성직자\', \'flavor\': \'"이 역사의 전당들은 제 보호하에 있습니다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448833&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'11001689-cd07-4d64-9bed-0840925f742c\', \'multiverseId\': 448833}, \'multiverseid\': 448833}, {\'name\': \'Sacerdote dos Anões\', \'text\': \'Quando Sacerdote dos Anões entra no campo de batalha, você ganha 1 ponto de vida para cada criatura que você controla.\', \'type\': \'Criatura — Anão Clérigo\', \'flavor\': \'"Esses salões célebres estão sob minha proteção."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449114&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0f962d4c-d1b7-4f5f-9672-4a76e531142f\', \'multiverseId\': 449114}, \'multiverseid\': 449114}, {\'name\': \'Пастырь Гномов\', \'text\': \'Когда Пастырь Гномов выходит на поле битвы, вы получаете 1 жизнь за каждое существо под вашим контролем.\', \'type\': \'Существо — Гном Священник\', \'flavor\': \'«Эти прославленные залы — под моей защитой».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449395&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e5b7b718-a44b-4fe6-87ce-6bea985d5b63\', \'multiverseId\': 449395}, \'multiverseid\': 449395}, {\'name\': \'矮人僧侣\', \'text\': \'当矮人僧侣进战场时，你每操控一个生物，便获得1点生命。\', \'type\': \'生物 ～矮人／僧侣\', \'flavor\': \'「这些宏伟大厅悉数由我保护。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449676&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bba5e0d1-4bf9-42a2-84fc-1bdcd4c518ef\', \'multiverseId\': 449676}, \'multiverseid\': 449676}, {\'name\': \'矮人僧侶\', \'text\': \'當矮人僧侶進戰場時，你每操控一個生物，便獲得1點生命。\', \'type\': \'生物 ～矮人／僧侶\', \'flavor\': \'「這些宏偉大廳悉數由我保護。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449957&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'20720b79-1d82-4754-b061-63554f9541b5\', \'multiverseId\': 449957}, \'multiverseid\': 449957}]', '[{\'name\': \'Ägide der Himmel\', \'text\': \'Eine Kreatur deiner Wahl erhält +1/+7 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'Innere Stärke bleibt verborgen, bis sie von entscheidender Bedeutung wird.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447418&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0f75a1e0-2657-4be4-852b-a9b3f9befdf7\', \'multiverseId\': 447418}, \'multiverseid\': 447418}, {\'name\': \'Égida de los cielos\', \'text\': \'La criatura objetivo obtiene +1/+7 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'La fuerza interior no se nota hasta que marca la diferencia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447699&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1dafa1df-7391-4c33-83db-94ff0ef53291\', \'multiverseId\': 447699}, \'multiverseid\': 447699}, {\'name\': \'Égide des Cieux\', \'text\': "La créature ciblée gagne +1/+7 jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': "La force intérieure ne se remarque que lorsqu\'elle fait toute la différence.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447980&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2a355222-b84a-44d7-ab8a-456d2e152d7a\', \'multiverseId\': 447980}, \'multiverseid\': 447980}, {\'name\': \'Egida dei Cieli\', \'text\': \'Una creatura bersaglio prende +1/+7 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'La forza interiore resta celata, affiorando solo nel momento in cui è indispensabile.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448261&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3b206660-c842-44e2-8ac1-3e048d062c5d\', \'multiverseId\': 448261}, \'multiverseid\': 448261}, {\'name\': \'天界の神盾\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋１/＋７の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'状況が一変して初めて内なる強さに気付く。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448542&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c5880f18-f3ad-4e60-9fdc-500f00840bc1\', \'multiverseId\': 448542}, \'multiverseid\': 448542}, {\'name\': \'천상의 방패\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 +1/+7을 받는다.\', \'type\': \'순간마법\', \'flavor\': \'내면의 힘은 차이가 나타나기 전까지는 알아차릴 수 없다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448823&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f1905e02-1a0c-4009-84aa-cc67be6637ae\', \'multiverseId\': 448823}, \'multiverseid\': 448823}, {\'name\': \'Égide dos Céus\', \'text\': \'A criatura alvo recebe +1/+7 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'A força interior jamais é vista até fazer toda a diferença.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449104&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'67f9e8e2-9344-49d0-8f8f-3e2043e45a6c\', \'multiverseId\': 449104}, \'multiverseid\': 449104}, {\'name\': \'Эгида Небес\', \'text\': \'Целевое существо получает +1/+7 до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Внутренняя сила не видна до тех пор, пока не становится решающим фактором.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449385&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ec98b7e8-0dea-4d67-b01b-716e09aac686\', \'multiverseId\': 449385}, \'multiverseid\': 449385}, {\'name\': \'天国庇佑\', \'text\': \'目标生物得+1/+7直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'唯有显威之时，方能见证内心之力。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449666&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'328159af-6def-49ca-9fc6-58be617b0752\', \'multiverseId\': 449666}, \'multiverseid\': 449666}, {\'name\': \'天國庇佑\', \'text\': \'目標生物得+1/+7直到回合結束。\', \'type\': \'瞬間\', \'flavor\': \'唯有顯威之時，方能見證內心之力。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449947&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'64cbdaaf-875a-418f-820c-66d34161765b\', \'multiverseId\': 449947}, \'multiverseid\': 449947}]', '[{\'name\': \'Ätherschild-Handwerkerin\', \'text\': \'Zu Beginn des Kampfes in deinem Zug erhält eine Artefaktkreatur deiner Wahl, die du kontrollierst, +2/+2 und Unzerstörbarkeit bis zum Ende des Zuges. (Schaden und Effekte, die „zerstören", zerstören sie nicht.)\', \'type\': \'Kreatur — Zwerg, Handwerker\', \'flavor\': \'Die meisten Handwerker arbeiten mit Metall, doch einige bevorzugen etwas raffiniertere Materialien.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447419&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d6d992cc-889b-410f-8a48-17d8715b5933\', \'multiverseId\': 447419}, \'multiverseid\': 447419}, {\'name\': \'Artífice de escudos de éter\', \'text\': \'Al comienzo del combate en tu turno, la criatura artefacto objetivo que controlas obtiene +2/+2 y gana la habilidad de indestructible hasta el final del turno. (El daño y los efectos que dicen "destruir" no la destruyen.)\', \'type\': \'Criatura — Enano artífice\', \'flavor\': \'La mayoría de los herreros trabajan el metal, pero algunos prefieren materiales más delicados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447700&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'440a9311-608e-4312-bfa8-3858970d3ae4\', \'multiverseId\': 447700}, \'multiverseid\': 447700}, {\'name\': "Artificière au bouclier d\'Éther", \'text\': "Au début du combat pendant votre tour, une créature-artefact ciblée que vous contrôlez gagne +2/+2 et acquiert l\'indestructible jusqu\'à la fin du tour. (Les blessures et les effets qui disent « détruisez » ne la détruisent pas.)", \'type\': \'Créature : nain et artificier\', \'flavor\': \'La plupart des forgerons travaillent le métal, mais certains préfèrent les matériaux plus délicats.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447981&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2ddac49a-26b9-457a-ad50-2118b89d56a1\', \'multiverseId\': 447981}, \'multiverseid\': 447981}, {\'name\': \'Artefice dello Scudo Etereo\', \'text\': \'All\\\'inizio del combattimento nel tuo turno, una creatura artefatto bersaglio che controlli prende +2/+2 e ha indistruttibile fino alla fine del turno. (Il danno e gli effetti che dicono "distruggi" non la distruggono.)\', \'type\': \'Creatura — Artefice Nano\', \'flavor\': "In genere i fabbri lavorano il metallo, ma c\'è chi preferisce materiali più delicati.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448262&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3e70fd22-af29-4a73-b19e-1476aeeaca38\', \'multiverseId\': 448262}, \'multiverseid\': 448262}, {\'name\': \'霊気盾の工匠\', \'text\': \'あなたのターンの戦闘の開始時に、あなたがコントロールしているアーティファクト・クリーチャー１体を対象とする。ターン終了時まで、それは＋２/＋２の修整を受け、破壊不能を得る。（ダメージや「破壊」と書かれた効果では、それは破壊されない。）\', \'type\': \'クリーチャー — ドワーフ・工匠\', \'flavor\': \'金属を成形する鍛冶屋は多いが、もっと繊細な物質を好む者もいる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448543&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'50423f04-95f8-4793-acb4-2f5ec13f6fea\', \'multiverseId\': 448543}, \'multiverseid\': 448543}, {\'name\': \'에테르방패 기능공\', \'text\': \'당신의 턴 전투 시작에, 당신이 조종하는 마법물체 생물을 목표로 정한다. 그 생물은 턴종료까지 +2/+2를 받고 무적을 얻는다. (피해와 "파괴"라고 명시된 효과로 파괴되지 않는다.)\', \'type\': \'생물 — 드워프 기능공\', \'flavor\': \'많은 대장장이들은 금속을 다루지만, 몇몇은 더 섬세한 재료를 선호한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448824&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ce31db7d-e9c5-4e74-a562-b750e689d536\', \'multiverseId\': 448824}, \'multiverseid\': 448824}, {\'name\': \'Artífice do Escudo Etéreo\', \'text\': \'No início do combate no seu turno, a criatura artefato alvo que você controla recebe +2/+2 e ganha indestrutível até o final do turno. (Dano e efeitos que dizem "destrua" não a destroem.)\', \'type\': \'Criatura — Anão Artesão\', \'flavor\': \'A maioria dos ferreiros molda metais, mas alguns preferem materiais mais delicados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449105&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d394b4ba-9b11-4da1-9b29-0613532ca5ef\', \'multiverseId\': 449105}, \'multiverseid\': 449105}, {\'name\': \'Мастерица Эфирных Щитов\', \'text\': \'В начале боя во время вашего хода целевой артефакт существо под вашим контролем получает +2/+2 и Неразрушимость до конца хода. (Повреждения и эффекты с указанием «уничтожьте» не уничтожают его.)\', \'type\': \'Существо — Гном Механик\', \'flavor\': \'Большинство кузнецов работает с металлом, но некоторые предпочитают более тонкие материалы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449386&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7e90b85a-eb94-4656-9a3f-53ce43eacddd\', \'multiverseId\': 449386}, \'multiverseid\': 449386}, {\'name\': \'乙太盾神器师\', \'text\': \'在你回合的战斗开始时，直到回合结束，目标由你操控的神器生物得+2/+2且获得不灭异能。（伤害与注明「消灭」的效应不会将它消灭。）\', \'type\': \'生物 ～矮人／神器师\', \'flavor\': \'大多数工匠都在打造金属，但有些则偏好使用更精巧的原料。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449667&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bb49f239-6c05-494f-b4a5-50e414969a65\', \'multiverseId\': 449667}, \'multiverseid\': 449667}, {\'name\': \'乙太盾神器師\', \'text\': \'在你回合的戰鬥開始時，直到回合結束，目標由你操控的神器生物得+2/+2且獲得不滅異能。（傷害與註明「消滅」的效應不會將它消滅。)\', \'type\': \'生物 ～矮人／神器師\', \'flavor\': \'大多數工匠都在打造金屬，但有些則偏好使用更精巧的原料。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449948&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0242f13d-8c22-409b-ae8f-f65707e6525f\', \'multiverseId\': 449948}, \'multiverseid\': 449948}]', '[{\'name\': \'Äthertunnel\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur erhält +1/+0 und kann nicht geblockt werden.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Wenn du keinen Eingang finden kannst, dann erschaffe dir einen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447460&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'514ab1e5-fae2-44cd-a6f2-e45ed182729c\', \'multiverseId\': 447460}, \'multiverseid\': 447460}, {\'name\': \'Túnel de éter\', \'text\': \'Encantar criatura.\\nLa criatura encantada obtiene +1/+0 y no puede ser bloqueada.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'Si no encuentras la entrada, créala.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447741&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d5a8fef2-34ac-4b24-9652-dc44146a2715\', \'multiverseId\': 447741}, \'multiverseid\': 447741}, {\'name\': "Tunnel d\'Éther", \'text\': \'Enchanter : créature\\nLa créature enchantée gagne +1/+0 et ne peut pas être bloquée.\', \'type\': \'Enchantement : aura\', \'flavor\': \'Si vous ne trouvez pas la porte, créez-en une.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448022&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c2fbbd39-f7c5-48be-8006-204c75855849\', \'multiverseId\': 448022}, \'multiverseid\': 448022}, {\'name\': "Tunnel d\'Etere", \'text\': \'Incanta creatura\\nLa creatura incantata prende +1/+0 e non può essere bloccata.\', \'type\': \'Incantesimo — Aura\', \'flavor\': "Se non riesci a trovare una via d\'uscita, creane una.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448303&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'768d35bc-b68d-491c-9afb-fcc1ae9912e4\', \'multiverseId\': 448303}, \'multiverseid\': 448303}, {\'name\': \'霊気トンネル\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは＋１/＋０の修整を受け、ブロックされない。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'入り口が見つからないのなら、作ればいい。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448584&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'86f8fc58-9879-446e-bbbc-4b24391df265\', \'multiverseId\': 448584}, \'multiverseid\': 448584}, {\'name\': \'에테르 터널\', \'text\': \'생물에게 부여\\n부여된 생물은 +1/+0을 받고 방어될 수 없다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'문을 찾을 수 없다면, 직접 만들어라.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448865&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'63c0ca3e-2b62-4847-8eed-c1be2b330ffc\', \'multiverseId\': 448865}, \'multiverseid\': 448865}, {\'name\': \'Túnel Etéreo\', \'text\': \'Encantar criatura\\nA criatura encantada recebe +1/+0 e não pode ser bloqueada.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'Se não conseguir achar uma porta, faça uma.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449146&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e014c7b3-0180-45f6-bb0c-73258494760e\', \'multiverseId\': 449146}, \'multiverseid\': 449146}, {\'name\': \'Эфирный Тоннель\', \'text\': \'Зачаровать существо\\nЗачарованное существо получает +1/+0 и не может быть заблокировано.\', \'type\': \'Чары — Аура\', \'flavor\': \'Если не можешь найти дверь, сделай свою.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449427&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f5ada326-ca84-4434-a4a6-b9cb70c95694\', \'multiverseId\': 449427}, \'multiverseid\': 449427}, {\'name\': \'乙太通道\', \'text\': \'结附于生物\\n所结附的生物得+1/+0且不能被阻挡。\', \'type\': \'结界 ～灵气\', \'flavor\': \'如果你找不到门路，那就自己造一条。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449708&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'68864807-47d8-4a46-bf45-8f23bff87b72\', \'multiverseId\': 449708}, \'multiverseid\': 449708}, {\'name\': \'乙太通道\', \'text\': \'結附於生物\\n所結附的生物得+1/+0且不能被阻擋。\', \'type\': \'結界 ～靈氣\', \'flavor\': \'如果你找不到門路，那就自己造一條。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449989&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'be4dda2c-938a-4e8c-9c6c-54e365dbb01f\', \'multiverseId\': 449989}, \'multiverseid\': 449989}]', '[{\'name\': \'Öffnet die Gräber\', \'text\': \'Immer wenn eine Nichtspielsteinkreatur, die du kontrollierst, stirbt, erzeuge einen 2/2 schwarzen Zombie-Kreaturenspielstein.\', \'type\': \'Verzauberung\', \'flavor\': \'Es war eine Nacht wie jede andere. Doch es sollte zu einer Nacht werden, die niemand je vergessen würde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447529&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6245b302-f01f-4420-a4c8-cef4fa92e075\', \'multiverseId\': 447529}, \'multiverseid\': 447529}, {\'name\': \'Abrir las tumbas\', \'text\': \'Siempre que una criatura que controlas que no sea ficha muera, crea una ficha de criatura Zombie negra 2/2.\', \'type\': \'Encantamiento\', \'flavor\': \'Era una noche como cualquier otra, pero pronto se convertiría en una noche que nadie olvidaría nunca.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447810&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4dc95f4e-1ba4-4b3a-a6bb-238727257828\', \'multiverseId\': 447810}, \'multiverseid\': 447810}, {\'name\': \'Ouvrez les tombes !\', \'text\': "À chaque fois qu\'une créature non-jeton que vous contrôlez meurt, créez un jeton de créature 2/2 noire Zombie.", \'type\': \'Enchantement\', \'flavor\': "C\'était une nuit comme une autre. Elle allait bientôt devenir une nuit que personne n\'oublierait jamais.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448091&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fa52f476-97df-4867-882d-69318637e520\', \'multiverseId\': 448091}, \'multiverseid\': 448091}, {\'name\': \'Aprire le Tombe\', \'text\': \'Ogniqualvolta una creatura non pedina che controlli muore, crea una pedina creatura Zombie 2/2 nera.\', \'type\': \'Incantesimo\', \'flavor\': \'Era una notte come tutte le altre. Ben presto divenne una notte che nessuno avrebbe mai dimenticato.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448372&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7ce7646a-1013-4acb-8780-e36d6e0192cd\', \'multiverseId\': 448372}, \'multiverseid\': 448372}, {\'name\': \'墓地解放\', \'text\': \'あなたがコントロールしていてトークンでないクリーチャーが１体死亡するたび、黒の２/２のゾンビ・クリーチャー・トークンを１体生成する。\', \'type\': \'エンチャント\', \'flavor\': \'いつも通りの夜だった。すぐに誰もが忘れられない夜になったのだが。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448653&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'920de35a-da49-4285-bc05-61524bfada4a\', \'multiverseId\': 448653}, \'multiverseid\': 448653}, {\'name\': \'무덤 개방\', \'text\': \'당신이 조종하는 토큰이 아닌 생물이 죽을 때마다, 2/2 흑색 좀비 생물 토큰 한 개를 만든다.\', \'type\': \'부여마법\', \'flavor\': \'별다를 것 없는 밤이었다. 이내 누구도 잊지 못할 밤이 될 터였다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448934&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'249fbf43-77e8-4f0e-b96d-2ef200428dc8\', \'multiverseId\': 448934}, \'multiverseid\': 448934}, {\'name\': \'Abrir os Túmulos\', \'text\': \'Toda vez que uma criatura que você controla que não seja uma ficha morrer, crie uma ficha de criatura preta 2/2 do tipo Zumbi.\', \'type\': \'Encantamento\', \'flavor\': \'Era uma noite como qualquer outra. Mas logo se tornaria uma noite que ninguém jamais esqueceria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449215&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b3a25f51-1b6e-44c8-82d2-fa02603c161f\', \'multiverseId\': 449215}, \'multiverseid\': 449215}, {\'name\': \'Разрывание Могил\', \'text\': \'Каждый раз, когда не являющееся фишкой существо под вашим контролем умирает, создайте одну фишку существа 2/2 черный Зомби.\', \'type\': \'Чары\', \'flavor\': \'Стояла ночь — такая же, как любая другая. Но ей суждено было стать ночью, которую не забудут никогда.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449496&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a3ff0c48-c274-4781-9d34-ac2f60b442d2\', \'multiverseId\': 449496}, \'multiverseid\': 449496}, {\'name\': \'开坟现墓\', \'text\': \'每当一个由你操控且非衍生物的生物死去时，派出一个2/2黑色灵俑衍生生物。\', \'type\': \'结界\', \'flavor\': \'原本只是个寻常夜晚，但很快就会让人永生难忘。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449777&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'12ede320-d71c-4a6a-9f41-e84274d0c0e7\', \'multiverseId\': 449777}, \'multiverseid\': 449777}, {\'name\': \'開墳現墓\', \'text\': \'每當一個由你操控且非衍生物的生物死去時，派出一個2/2黑色殭屍衍生生物。\', \'type\': \'結界\', \'flavor\': \'原本只是個尋常夜晚，但很快就會讓人永生難忘。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450058&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ba9ea873-ceeb-41e4-aed0-19b5a6790942\', \'multiverseId\': 450058}, \'multiverseid\': 450058}]', '[{\'name\': \'Überschwemmter Knochenacker\', \'text\': \'Der Überschwemmte Knochenacker kommt getappt ins Spiel.\\n{T}: Erzeuge {U} oder {B}.\', \'type\': \'Land\', \'flavor\': \'„Noch lange nachdem man dem Land die letzten Geheimnisse entlockt hat, wird es Mysterien geben, die tief unter dem Meer begraben liegen."\\n—Kiora\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447675&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'efac887c-d471-44a1-8723-d511f57be9f3\', \'multiverseId\': 447675}, \'multiverseid\': 447675}, {\'name\': \'Osario sumergido\', \'text\': \'El Osario sumergido entra al campo de batalla girado.\\n{T}: Agrega {U} o {B}.\', \'type\': \'Tierra\', \'flavor\': \'"Siglos después de que la tierra haya entregado el último de sus secretos, seguirá habiendo misterios en las profundidades marinas".\\n—Kiora\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447956&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b1eca54a-592b-4cb7-8533-357eeaa7f016\', \'multiverseId\': 447956}, \'multiverseid\': 447956}, {\'name\': \'Ossuaire submergé\', \'text\': "L\'Ossuaire submergé arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {U} ou {B}.", \'type\': \'Terrain\', \'flavor\': \'« Longtemps après la découverte des derniers secrets gardés par la terre, les fonds marins recèleront encore de nombreux mystères. »\\n—Kiora\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448237&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fe0d60ed-301d-415e-92fe-359cd0bab5e0\', \'multiverseId\': 448237}, \'multiverseid\': 448237}, {\'name\': \'Ossario Sommerso\', \'text\': "L\'Ossario Sommerso entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {U} o {B}.", \'type\': \'Terra\', \'flavor\': \'"Dopo che la terra avrà rivelato l\\\'ultimo dei suoi segreti, si celeranno ancora misteri nelle profondità del mare."\\n—Kiora\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448518&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6cfc0e76-1a34-4441-aea7-8b8f923027a1\', \'multiverseId\': 448518}, \'multiverseid\': 448518}, {\'name\': \'水没した骨塚\', \'text\': \'水没した骨塚はタップ状態で戦場に出る。\\n{T}：{U}か{B}を加える。\', \'type\': \'土地\', \'flavor\': \'「地上が踏破しつくされても、海の深部には未知の領域がずっと眠り続けているのよ。」\\n――キオーラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448799&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d7e1fcce-c993-4c3b-83a3-08392eddfa31\', \'multiverseId\': 448799}, \'multiverseid\': 448799}, {\'name\': \'물에 잠긴 납골지\', \'text\': \'물에 잠긴 납골지는 탭된 채로 전장에 들어온다.\\n{T}: {U} 또는 {B}를 추가한다.\', \'type\': \'대지\', \'flavor\': \'"대지의 마지막 비밀이 밝혀지고 오랜 시간이 흘러도 심해는 여전히 신비의 지역으로 남아 있을 것이다."\\n—키오라\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449080&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3014e383-714c-4e29-819e-6252d24fa68e\', \'multiverseId\': 449080}, \'multiverseid\': 449080}, {\'name\': \'Ossário Submerso\', \'text\': \'Ossário Submerso entra no campo de batalha virado.\\n{T}: Adicione {U} ou {B}.\', \'type\': \'Terreno\', \'flavor\': \'"Muito depois de a terra ter revelado o último de seus segredos, ainda haverá mistérios nas profundezas do mar."\\n— Kiora\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449361&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7a8042ac-02bd-466a-83a0-d4e4387ef3cb\', \'multiverseId\': 449361}, \'multiverseid\': 449361}, {\'name\': \'Затопленное Кладбище\', \'text\': \'Затопленное Кладбище выходит на поле битвы повернутым.\\n{T}: добавьте {U} или {B}.\', \'type\': \'Земля\', \'flavor\': \'«Когда-нибудь суша раскроет все свои секреты, но еще долго после этого тайны будут оставаться в глубинах морей».\\n— Киора\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449642&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ac0b3e70-b2fd-48b7-bff7-a11117463a90\', \'multiverseId\': 449642}, \'multiverseid\': 449642}, {\'name\': \'水下聚骨场\', \'text\': \'水下聚骨场须横置进战场。\\n{T}：加{U}或{B}。\', \'type\': \'地\', \'flavor\': \'「大地早已显露其所有的秘密，然而深海依然暗藏玄机。」\\n～奇奥拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449923&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'64919442-c3f6-45df-ad76-609b0386a466\', \'multiverseId\': 449923}, \'multiverseid\': 449923}, {\'name\': \'水下聚骨場\', \'text\': \'水下聚骨場須橫置進戰場。\\n{T}：加{U}或{B}。\', \'type\': \'地\', \'flavor\': \'「大地早已顯露其所有的祕密，然而深海依然暗藏玄機。」\\n～奇奧拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450204&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'190a6fbd-c705-4f05-9315-ce56bc935b89\', \'multiverseId\': 450204}, \'multiverseid\': 450204}]']
