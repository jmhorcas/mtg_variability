ttp://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449940&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'fbda0fbf-69d1-4cb8-9a28-7d8db4ec5bd5', 'multiverseId': 449940}, 'multiverseid': 449940}, {'name': '山脈', 'type': '基本地 ～山脈', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450221&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '11bf6a73-c6f3-4f6b-a6e5-d90081260a7a', 'multiverseId': 450221}, 'multiverseid': 450221}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447693&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2c3bba9e-f49c-4233-a147-488d56ff111e', 'multiverseId': 447693}, 'multiverseid': 447693}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447974&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '60a9fb2d-a26a-4b87-9d0a-c7334d656461', 'multiverseId': 447974}, 'multiverseid': 447974}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448255&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd8c81a6f-23a8-4bfb-82ac-be311160cf89', 'multiverseId': 448255}, 'multiverseid': 448255}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448536&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '7cca970d-7a45-4696-9369-fd18a361cf35', 'multiverseId': 448536}, 'multiverseid': 448536}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448817&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '8810ca3d-57ec-4188-8cc8-4ec8624bd821', 'multiverseId': 448817}, 'multiverseid': 448817}, {'name': '산', 'type': '기본 대지 — 산', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449098&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'b0c67901-2a16-4853-a952-14b4541090b4', 'multiverseId': 449098}, 'multiverseid': 449098}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449379&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '86d9e973-da3e-46f5-a9b1-158a487cf8c8', 'multiverseId': 449379}, 'multiverseid': 449379}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449660&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '80e5ac40-d03c-4a56-9ed2-425fe47547fd', 'multiverseId': 449660}, 'multiverseid': 449660}, {'name': '山脉', 'type': '基本地 ～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449941&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '70d1d9e3-add2-4800-9575-89c03c9cd4a4', 'multiverseId': 449941}, 'multiverseid': 449941}, {'name': '山脈', 'type': '基本地 ～山脈', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450222&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'f02b3c9e-42aa-4665-9463-b05672aa8823', 'multiverseId': 450222}, 'multiverseid': 450222}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447694&type=card', 'language': 'German', 'identifiers': {'scryfallId': '8b8807d3-44c3-4b49-9c93-7b0eb814e6df', 'multiverseId': 447694}, 'multiverseid': 447694}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447975&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5d87e877-7f9c-43d3-aa54-a0082f15bd2f', 'multiverseId': 447975}, 'multiverseid': 447975}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448256&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd3b9e052-a2df-4cc8-9071-7aec9b8432ec', 'multiverseId': 448256}, 'multiverseid': 448256}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448537&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '9da2767c-7a0e-44cd-b6b3-8ae8f5e8ba8a', 'multiverseId': 448537}, 'multiverseid': 448537}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448818&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'e043fa22-1e0a-4882-8a68-3eba1bdf96ba', 'multiverseId': 448818}, 'multiverseid': 448818}, {'name': '산', 'type': '기본 대지 — 산', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449099&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '9a623e14-4f85-4dac-b9de-8c2d87b08dc4', 'multiverseId': 449099}, 'multiverseid': 449099}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449380&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b90dafa0-9a3c-4c6d-acb8-fc6c836963da', 'multiverseId': 449380}, 'multiverseid': 449380}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449661&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '9f9d09d9-d34a-4cbf-9153-5f5baf633951', 'multiverseId': 449661}, 'multiverseid': 449661}, {'name': '山脉', 'type': '基本地 ～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449942&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '30487d8a-c338-4a8c-8f22-fcb190c2ee03', 'multiverseId': 449942}, 'multiverseid': 449942}, {'name': '山脈', 'type': '基本地 ～山脈', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450223&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '1d41bd18-9420-41e0-ba11-cf3da4ca6a42', 'multiverseId': 450223}, 'multiverseid': 450223}]", '[{\'name\': \'Gebrochene Allmacht\', \'text\': \'Jeder Spieler verliert die Hälfte seiner Lebenspunkte, wirft dann die Hälfte seiner Handkarten ab und opfert dann die Hälfte der Kreaturen, die er kontrolliert. Es wird jedes Mal aufgerundet.\', \'type\': \'Hexerei\', \'flavor\': \'Die Große Wiederherstellung heilte das Multiversum und zerstörte die große Macht von Nicol Bolas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447514&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3c4c9ff9-0d2d-412e-b503-c08c59292884\', \'multiverseId\': 447514}, \'multiverseid\': 447514}, {\'name\': \'Omnipotencia desvanecida\', \'text\': \'Cada jugador pierde la mitad de sus vidas, luego descarta la mitad de las cartas en su mano y luego sacrifica la mitad de las criaturas que controla, redondeando hacia arriba cada vez.\', \'type\': \'Conjuro\', \'flavor\': \'La Reparación que sanó el Multiverso también menoscabó los poderes de Nicol Bolas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447795&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a7a5d52e-f5bb-4e13-a813-8dbfdef66bc5\', \'multiverseId\': 447795}, \'multiverseid\': 447795}, {\'name\': \'Omnipotence étiolée\', \'text\': "Chaque joueur perd la moitié de ses points de vie, puis se défausse de la moitié des cartes de sa main, puis sacrifie la moitié des créatures qu\'il contrôle. Arrondissez à l\'unité supérieure à chaque fois.", \'type\': \'Rituel\', \'flavor\': \'La grande Restauration qui sauva le Multivers affaiblit les pouvoirs de Nicol Bolas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448076&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'65d1a183-4d9d-4bff-bb1c-0357f1c87bdd\', \'multiverseId\': 448076}, \'multiverseid\': 448076}, {\'name\': \'Onnipotenza Disgregata\', \'text\': \'Ogni giocatore perde metà dei suoi punti vita, poi scarta metà delle carte nella sua mano, poi sacrifica metà delle creature che controlla. Arrotonda per eccesso ogni volta.\', \'type\': \'Stregoneria\', \'flavor\': \'La Grande Riparazione che ha guarito il Multiverso ha anche ridotto a brandelli il potere di Nicol Bolas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448357&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dfea9845-fdc2-4398-960c-f4ac2e632bbb\', \'multiverseId\': 448357}, \'multiverseid\': 448357}, {\'name\': \'消耗した全能\', \'text\': \'各プレイヤーはそれぞれ、自分のライフの半分を失い、自分の手札にあるカードの半数を捨て、その後自分がコントロールしているクリーチャーの半数を生け贄に捧げる。それぞれの端数は切り上げる。\', \'type\': \'ソーサリー\', \'flavor\': \'多元宇宙を救った大修復は、同時にニコル・ボーラスの力を磨り減らした。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448638&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ae3da4f4-0e53-4875-849f-4e66e61ead24\', \'multiverseId\': 448638}, \'multiverseid\': 448638}, {\'name\': \'마모되는 전능함\', \'text\': \'각 플레이어는 자신의 생명점 절반을 잃고, 자신의 손에 있는 카드의 절반을 버리고, 자신이 조종하는 생물의 절반을 희생한다. 매번 올림해서 계산한다.\', \'type\': \'집중마법\', \'flavor\': \'다우주를 회복시킨 위대한 수복은 니콜 볼라스의 힘의 실마리도 함께 풀어내었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448919&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'292fab42-fb13-4496-8ebc-5d859c4f7678\', \'multiverseId\': 448919}, \'multiverseid\': 448919}, {\'name\': \'Onipotência Desfibradora\', \'text\': \'Cada jogador perde metade dos pontos de vida, depois descarta metade dos cards da própria mão e, em seguida, sacrifica metade das criaturas que controla. Arredonde tudo para cima.\', \'type\': \'Feitiço\', \'flavor\': \'A Grande Emenda que curou o Multiverso também desenredou o poder de Nicol Bolas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449200&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a75cb248-573a-42b1-b064-e3a9058109c7\', \'multiverseId\': 449200}, \'multiverseid\': 449200}, {\'name\': \'Угасающее Всемогущество\', \'text\': \'Каждый игрок теряет половину своих жизней, затем сбрасывает половину карт из своей руки, затем жертвует половину существ под своим контролем. Всегда округляйте в большую сторону.\', \'type\': \'Волшебство\', \'flavor\': \'Великое Исцеление, закрывшее раны Мультивселенной, расплело нити могущества Никола Боласа.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449481&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9239b6ad-f22e-40d3-ad54-738e2a058cf2\', \'multiverseId\': 449481}, \'multiverseid\': 449481}, {\'name\': \'全能渐散\', \'text\': \'每位牌手各失去一半数量的生命，然后各弃一半数量的手牌，然后各牺牲一半数量由其操控的生物。各数量小数点后均进位。\', \'type\': \'法术\', \'flavor\': \'世界愈合疗愈了多重宇宙，同时也打乱了尼可波拉斯的力量之源。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449762&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1aa8b49f-98ed-47d6-bb79-fdf345208590\', \'multiverseId\': 449762}, \'multiverseid\': 449762}, {\'name\': \'全能漸散\', \'text\': \'每位玩家各失去一半數量的生命，然後各棄一半數量的手牌，然後各犧牲一半數量由其操控的生物。各數量小數點後均進位。\', \'type\': \'巫術\', \'flavor\': \'世界癒合療癒了多重宇宙，同時也打亂了尼可波拉斯的力量之源。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450043&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ede2c77c-a2c5-416c-8a98-8ae50f26ce7d\', \'multiverseId\': 450043}, \'multiverseid\': 450043}]', '[{\'name\': \'Gedankensymbiont\', \'text\': \'Fliegend\\nWenn der Gedankensymbiont ins Spiel kommt, wirft ein Gegner deiner Wahl eine Karte ab und du ziehst eine Karte.\', \'type\': \'Kreatur — Nachtmahr, Schrecken\', \'flavor\': \'„Ich drehe mich um und sehe nichts, aber ich weiß, dass er da ist. Seine Finger wühlen in meinem Verstand und basteln neue Ideen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447639&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'670f52b5-1496-4ba8-a4d9-1f7737575cf6\', \'multiverseId\': 447639}, \'multiverseid\': 447639}, {\'name\': \'Simbionte mental\', \'text\': \'Vuela.\\nCuando el Simbionte mental entre al campo de batalla, el oponente objetivo descarta una carta y tú robas una carta.\', \'type\': \'Criatura — Horror pesadilla\', \'flavor\': \'"Cuando me giro, no veo nada, pero sé que está detrás de mí. Siento sus dedos hurgando en mi mente, dando forma a nuevas ideas".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447920&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6f5871ce-d754-4bfe-81e3-c30ec5f4f62d\', \'multiverseId\': 447920}, \'multiverseid\': 447920}, {\'name\': \'Symbiote psychique\', \'text\': "Vol\\nQuand le Symbiote psychique arrive sur le champ de bataille, l\'adversaire ciblé se défausse d\'une carte et vous piochez une carte.", \'type\': \'Créature : cauchemar et horreur\', \'flavor\': "« Je me retourne et ne vois rien, pourtant je sais qu\'il se trouve derrière moi. Ses doigts fouillent mon esprit, façonnent des idées nouvelles. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448201&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'285ae798-8635-4711-be4b-fd46e8ebfac5\', \'multiverseId\': 448201}, \'multiverseid\': 448201}, {\'name\': \'Simbionte Psichico\', \'text\': \'Volare\\nQuando il Simbionte Psichico entra nel campo di battaglia, un avversario bersaglio scarta una carta e tu peschi una carta.\', \'type\': \'Creatura — Orrore Incubo\', \'flavor\': \'"Mi giro e non vedo nulla, eppure so che è dietro di me. Le sue dita rovistano nella mia mente per concepire nuove idee."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448482&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b353f109-4158-4433-a2bf-6e701c943459\', \'multiverseId\': 448482}, \'multiverseid\': 448482}, {\'name\': \'心理共生体\', \'text\': \'飛行\\n心理共生体が戦場に出たとき、対戦相手１人を対象とする。そのプレイヤーはカード１枚を捨て、あなたはカードを１枚引く。\', \'type\': \'クリーチャー — ナイトメア・ホラー\', \'flavor\': \'「振り向いても何も見えないが、後ろにいることは分かっている。指で私の精神を掻き回し、思考を作り替えるのだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448763&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3f8325cb-2503-4593-ba21-84226594213f\', \'multiverseId\': 448763}, \'multiverseid\': 448763}, {\'name\': \'정신 공생자\', \'text\': \'비행\\n정신 공생자가 전장에 들어올 때, 상대를 목표로 정한다. 그 플레이어는 카드를 한 장 버리고 당신은 카드를 한 장 뽑는다.\', \'type\': \'생물 — 나이트메어 괴수\', \'flavor\': \'"내가 뒤를 돌아보아도 아무 것도 보이지 않지만, 그것이 내 뒤에 있다는 것을 알아. 그 녀석의 손가락이 내 마음 속을 휘저어서 새로운 생각들을 만들어내."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449044&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4f7c386d-8e5f-4dba-87cb-6cd683f19b3e\', \'multiverseId\': 449044}, \'multiverseid\': 449044}, {\'name\': \'Simbionte Psíquico\', \'text\': \'Voar\\nQuando Simbionte Psíquico entra no campo de batalha, o oponente alvo descarta um card e você compra um card.\', \'type\': \'Criatura — Pesadelo Horror\', \'flavor\': \'"Eu me viro e não vejo nada, mas sei que ele está atrás de mim. Seus dedos vasculham minha mente, engendrando ideias novas."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449325&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7bc1449e-1c28-4f4f-878f-61c494d00be7\', \'multiverseId\': 449325}, \'multiverseid\': 449325}, {\'name\': \'Экстрасенсорный Симбионт\', \'text\': \'Полет\\nКогда Экстрасенсорный Симбионт выходит на поле битвы, целевой оппонент сбрасывает карту, а вы берете карту.\', \'type\': \'Существо — Кошмар Ужас\', \'flavor\': \'«Я поворачиваюсь и ничего не вижу, но знаю, что он за моей спиной. Его пальцы копаются в моем разуме, складывая новые мысли».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449606&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e154d6c2-d6df-464f-b766-be2522269408\', \'multiverseId\': 449606}, \'multiverseid\': 449606}, {\'name\': \'心灵共生体\', \'text\': \'飞行\\n当心灵共生体进战场时，目标对手弃一张牌且你抓一张牌。\', \'type\': \'生物 ～梦魇／惊惧兽\', \'flavor\': \'「我转身望去，什么也没看见，但我确信它就在身后。它的手指在我脑中拨弄，正欲构筑全新思想。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449887&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'79399dd7-b603-43e7-8d90-fe7676ec81d0\', \'multiverseId\': 449887}, \'multiverseid\': 449887}, {\'name\': \'心靈共生體\', \'text\': \'飛行\\n當心靈共生體進戰場時，目標對手棄一張牌且你抽一張牌。\', \'type\': \'生物 ～夢魘／驚懼獸\', \'flavor\': \'「我轉身望去，什麼也沒看見，但我確信它就在身後。它的手指在我腦中撥弄，正欲構築全新思想。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450168&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0e8cfa5a-9920-4748-83a4-e68cf931e767\', \'multiverseId\': 450168}, \'multiverseid\': 450168}]', '[{\'name\': \'Gedankenzersetzung\', \'text\': \'Ein Spieler deiner Wahl wirft zwei Karten ab.\', \'type\': \'Hexerei\', \'flavor\': \'So manche Erfinder scheitern an dem Druck, ein makelloses Konstrukt zu entwerfen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447526&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'aba1ad2d-1485-4eec-bb49-e4d1adecf6a2\', \'multiverseId\': 447526}, \'multiverseid\': 447526}, {\'name\': \'Podredumbre mental\', \'text\': \'El jugador objetivo descarta dos cartas.\', \'type\': \'Conjuro\', \'flavor\': \'Más de un inventor se ha venido abajo por la presión de crear el diseño perfecto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447807&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6b730933-f830-4ab1-8eab-06578e620401\', \'multiverseId\': 447807}, \'multiverseid\': 447807}, {\'name\': \'Pourrissement cérébral\', \'text\': \'Le joueur ciblé se défausse de deux cartes.\', \'type\': \'Rituel\', \'flavor\': "Plus d\'un inventeur s\'est fourvoyé dans la quête de la conception parfaite.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448088&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'18e817b5-fe94-4758-bb56-9e175c143677\', \'multiverseId\': 448088}, \'multiverseid\': 448088}, {\'name\': \'Cancrena della Mente\', \'text\': \'Un giocatore bersaglio scarta due carte.\', \'type\': \'Stregoneria\', \'flavor\': "Più di un inventore è stato schiacciato dall\'ossessione di creare il progetto perfetto.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448369&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8502efc9-e319-42ac-a39c-31cb3b72278e\', \'multiverseId\': 448369}, \'multiverseid\': 448369}, {\'name\': \'精神腐敗\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーはカード２枚を捨てる。\', \'type\': \'ソーサリー\', \'flavor\': \'完璧な設計を生み出すという重圧に潰された発明者は数知れない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448650&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'228e26b0-f08b-4361-8e56-3243c5dbcd82\', \'multiverseId\': 448650}, \'multiverseid\': 448650}, {\'name\': \'정신 부패\', \'text\': \'플레이어를 목표로 정한다. 그 플레이어는 카드 두 장을 버린다.\', \'type\': \'집중마법\', \'flavor\': \'많은 발명가들이 완벽한 디자인을 만들려는 스트레스에 못 이겨 쓰러진다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448931&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'18106568-e22e-4d4f-b3b6-741878f17082\', \'multiverseId\': 448931}, \'multiverseid\': 448931}, {\'name\': \'Estiolar a Mente\', \'text\': \'O jogador alvo descarta dois cards.\', \'type\': \'Feitiço\', \'flavor\': \'Muitos inventores entraram em colapso ante à pressão de criar um projeto impecável.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449212&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'55287287-f372-49c1-a3c5-492d07154ca1\', \'multiverseId\': 449212}, \'multiverseid\': 449212}, {\'name\': \'Гниение Разума\', \'text\': \'Целевой игрок сбрасывает две карты.\', \'type\': \'Волшебство\', \'flavor\': \'Многих изобретателей подкосило стремление создать безупречное произведение.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449493&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4716c3b3-2140-4ba7-9340-365fe8a7f1ee\', \'multiverseId\': 449493}, \'multiverseid\': 449493}, {\'name\': \'心之衰\', \'text\': \'目标牌手弃两张牌。\', \'type\': \'法术\', \'flavor\': \'许多发明家因创造无瑕设计的压力而崩溃。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449774&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0a42077d-2fab-4112-9244-97f9537449c2\', \'multiverseId\': 449774}, \'multiverseid\': 449774}, {\'name\': \'心之衰\', \'text\': \'目標玩家棄兩張牌。\', \'type\': \'巫術\', \'flavor\': \'許多發明家因創造無瑕設計的壓力而崩潰。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450055&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8588e55d-5187-4176-865a-97d7caa5a423\', \'multiverseId\': 450055}, \'multiverseid\': 450055}]', '[{\'name\': \'Geduldiger Wiederaufbau\', \'text\': \'Zu Beginn deines Versorgungssegments legt ein Gegner deiner Wahl die obersten drei Karten seiner Bibliothek auf seinen Friedhof. Dann ziehst du für jedes Land, das auf diese Weise auf jenen Friedhof gelegt wurde, eine Karte.\', \'type\': \'Verzauberung\', \'flavor\': \'Nicol Bolas wird nicht ruhen, bis er seine einstige Macht wiedererlangt hat.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447484&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b0ebd570-450d-4017-8f0d-ffc87a8442b1\', \'multiverseId\': 447484}, \'multiverseid\': 447484}, {\'name\': \'Reconstrucción paciente\', \'text\': \'Al comienzo de tu mantenimiento, el oponente objetivo pone las tres primeras cartas de su biblioteca en su cementerio. Luego, robas una carta por cada carta de tierra que vaya al cementerio de esta manera.\', \'type\': \'Encantamiento\', \'flavor\': \'Nicol Bolas no descansó hasta regresar a su antigua gloria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447765&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'11f87734-d2a3-41e9-9a0f-54029493f65f\', \'multiverseId\': 447765}, \'multiverseid\': 447765}, {\'name\': \'Reconstruction patiente\', \'text\': "Au début de votre entretien, l\'adversaire ciblé met les trois cartes du dessus de sa bibliothèque dans son cimetière, puis vous piochez une carte pour chaque carte de terrain mise dans ce cimetière de cette manière.", \'type\': \'Enchantement\', \'flavor\': "Nicol Bolas ne connaîtrait le repos qu\'une fois sa gloire passée retrouvée.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448046&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bc79d3cd-dbd9-4990-a938-9ccb6e4ee4b3\', \'multiverseId\': 448046}, \'multiverseid\': 448046}, {\'name\': \'Ricostruzione Paziente\', \'text\': "All\'inizio del tuo mantenimento, un avversario bersaglio mette nel suo cimitero le prime tre carte del suo grimorio, poi tu peschi una carta per ogni carta terra messa in quel cimitero in questo modo.", \'type\': \'Incantesimo\', \'flavor\': \'Nicol Bolas avrebbe trovato riposo solo dopo aver ripristinato il suo antico splendore.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448327&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'16c3aa3b-135c-4394-9c8d-45175c298ca9\', \'multiverseId\': 448327}, \'multiverseid\': 448327}, {\'name\': \'悠長な再構築\', \'text\': \'あなたのアップキープの開始時に、対戦相手１人を対象とする。そのプレイヤーは、自分のライブラリーの一番上からカードを３枚自分の墓地に置く。その後あなたはこれにより墓地に置かれた土地・カード１枚につきカードを１枚引く。\', \'type\': \'エンチャント\', \'flavor\': \'かつての栄光を取り戻すまでニコル・ボーラスに休息はない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448608&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'25e1794b-c3c6-4cd6-a0e2-90060e4c351a\', \'multiverseId\': 448608}, \'multiverseid\': 448608}, {\'name\': \'끈기 있는 재건\', \'text\': \'당신의 유지단 시작에, 상대를 목표로 정한다. 그 플레이어는 자신의 서고 맨 위 카드 세 장을 자신의 무덤에 넣고, 당신은 이런 식으로 무덤에 놓인 대지 카드 한 장당 카드 한 장을 뽑는다.\', \'type\': \'부여마법\', \'flavor\': \'니콜 볼라스는 자신의 옛 영광을 되찾을 때까지 쉬지 않을 것이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448889&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'53ac5c8c-dca7-4bb2-879f-6232b316f809\', \'multiverseId\': 448889}, \'multiverseid\': 448889}, {\'name\': \'Reconstrução Paciente\', \'text\': \'No início de sua manutenção, o oponente alvo coloca os três cards do topo do próprio grimório no próprio cemitério. Em seguida, você compra um card para cada card de terreno colocado no cemitério dessa forma.\', \'type\': \'Encantamento\', \'flavor\': \'Nicol Bolas não descansaria até recuperar a antiga glória.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449170&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'09f626fd-db10-481c-8aca-8f7f372b53be\', \'multiverseId\': 449170}, \'multiverseid\': 449170}, {\'name\': \'Терпеливое Восстановление\', \'text\': \'В начале вашего шага поддержки целевой оппонент кладет три верхние карты своей библиотеки на свое кладбище, затем вы берете одну карту за каждую карту земли, положенную на то кладбище таким образом.\', \'type\': \'Чары\', \'flavor\': \'Никол Болас не мог успокоиться, пока не вернул себе былое могущество.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449451&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'19463c57-cc37-42c9-9429-4d12e7c63e93\', \'multiverseId\': 449451}, \'multiverseid\': 449451}, {\'name\': \'耐心复原\', \'text\': \'在你的维持开始时，目标对手将其牌库顶的三张牌置入其坟墓场，然后每以此法将一张地牌置入该坟墓场，你便抓一张牌。\', \'type\': \'结界\', \'flavor\': \'不重振昔日雄风，尼可波拉斯誓不罢休。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449732&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'eb8ac3db-9563-4b38-9272-e3046753cb9c\', \'multiverseId\': 449732}, \'multiverseid\': 449732}, {\'name\': \'耐心復原\', \'text\': \'在你的維持開始時，目標對手將其牌庫頂的三張牌置入其墳墓場，然後每以此法將一張地牌置入該墳墓場，你便抽一張牌。\', \'type\': \'結界\', \'flavor\': \'不重振昔日雄風，尼可波拉斯誓不罷休。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450013&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a73db0ec-f238-4959-805b-8bfb58c2c05a\', \'multiverseId\': 450013}, \'multiverseid\': 450013}]', '[{\'name\': \'Gefräßige Harpyie\', \'text\': \'Fliegend\\n{1}, opfere eine andere Kreatur: Lege eine +1/+1-Marke auf die Gefräßige Harpyie.\', \'type\': \'Kreatur — Harpyie\', \'flavor\': \'Der Vorrat einer Harpyie ist ein dreckiger, blutiger Haufen aus Schmuckstücken und Leichen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447532&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b1b6d54a-880e-4ef5-9c8c-3862de86e970\', \'multiverseId\': 447532}, \'multiverseid\': 447532}, {\'name\': \'Arpía voraz\', \'text\': \'Vuela.\\n{1}, sacrificar otra criatura: Pon un contador +1/+1 sobre la Arpía voraz.\', \'type\': \'Criatura — Arpía\', \'flavor\': \'Las provisiones de una arpía consisten en un montón sucio y sanguinolento de cacharros y cadáveres.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447813&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'30e543b2-4b1d-4cc6-bd04-1ab7a733dec8\', \'multiverseId\': 447813}, \'multiverseid\': 447813}, {\'name\': \'Harpie vorace\', \'text\': \'Vol\\n{1}, sacrifiez une autre créature : Mettez un marqueur +1/+1 sur la Harpie vorace.\', \'type\': \'Créature : harpie\', \'flavor\': "Le butin d\'une harpie est un amas immonde et sanguinolent de babioles et de cadavres.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448094&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'312f4d25-35c2-4802-a9cb-5455916cd0fa\', \'multiverseId\': 448094}, \'multiverseid\': 448094}, {\'name\': \'Arpia Famelica\', \'text\': "Volare\\n{1}, Sacrifica un\'altra creatura: Metti un segnalino +1/+1 sull\'Arpia Famelica.", \'type\': \'Creatura — Arpia\', \'flavor\': "Il bottino di un\'arpia non è che uno sporco mucchio insanguinato di cadaveri e gingilli.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448375&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2cdd2066-f990-4302-bbc9-041e486a0ba2\', \'multiverseId\': 448375}, \'multiverseid\': 448375}, {\'name\': \'貪欲なハーピー\', \'text\': \'飛行\\n{1}, 他のクリーチャー１体を生け贄に捧げる：貪欲なハーピーの上に＋１/＋１カウンターを１個置く。\', \'type\': \'クリーチャー — ハーピー\', \'flavor\': \'ハーピーが溜め込むものは、不潔で、血に汚れた光り物や死体の山だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448656&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'058ff51a-be31-42a8-8dbd-45845d4daad0\', \'multiverseId\': 448656}, \'multiverseid\': 448656}, {\'name\': \'굶주린 하피\', \'text\': \'비행\\n{1}, 다른 생물 한 개를 희생한다: 굶주린 하피에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 하피\', \'flavor\': \'하피의 수집품은 장신구와 시체가 켜켜이 쌓여 피로 얼룩진 역겨운 산이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448937&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5b354ec4-1042-4831-904b-0e8d732f14ba\', \'multiverseId\': 448937}, \'multiverseid\': 448937}, {\'name\': \'Harpia Voraz\', \'text\': \'Voar\\n{1}, sacrifique outra criatura: Coloque um marcador +1/+1 em Harpia Voraz.\', \'type\': \'Criatura — Harpia\', \'flavor\': \'O tesouro de uma harpia é uma pilha nojenta e ensanguentada de quinquilharias e cadáveres.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449218&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f9b94816-950b-4352-816e-8b2ba69557b2\', \'multiverseId\': 449218}, \'multiverseid\': 449218}, {\'name\': \'Прожорливая Гарпия\', \'text\': \'Полет\\n{1}, пожертвуйте другое существо: положите один жетон +1/+1 на Прожорливую Гарпию.\', \'type\': \'Существо — Гарпия\', \'flavor\': \'Сокровища гарпии — это гниющая куча окровавленных безделушек и трупов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449499&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'72bf7732-5f89-42d0-868e-e5c2b9f1fed9\', \'multiverseId\': 449499}, \'multiverseid\': 449499}, {\'name\': \'贪婪哈痞\', \'text\': \'飞行\\n{1}，牺牲另一个生物：在贪婪哈痞上放置一个+1/+1指示物。\', \'type\': \'生物 ～哈痞\', \'flavor\': \'哈痞的藏品是一堆肮脏染血的琐物和死尸。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449780&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b178173a-6a4e-47ea-a9d4-cad574ce0a1a\', \'multiverseId\': 449780}, \'multiverseid\': 449780}, {\'name\': \'貪婪哈痞\', \'text\': \'飛行\\n{1}，犧牲另一個生物：在貪婪哈痞上放置一個+1/+1指示物。\', \'type\': \'生物 ～哈痞\', \'flavor\': \'哈痞的藏品是一堆骯髒染血的瑣物和死屍。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450061&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c0165470-da1e-41c6-8b02-cb3771da2577\', \'multiverseId\': 450061}, \'multiverseid\': 450061}]', '[{\'name\': \'Geheimnisbergerin\', \'text\': \'Wenn die Geheimnisbergerin ins Spiel kommt, bringe eine Spontanzauber- oder Hexereikarte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Kreatur — Meervolk, Zauberer\', \'flavor\': \'Der größte Schatz der Tiefe ist ein Echo von oben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447487&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'abfdbdf2-6ed9-452b-b653-8049af387eb7\', \'multiverseId\': 447487}, \'multiverseid\': 447487}, {\'name\': \'Rescatadora de secretos\', \'text\': \'Cuando la Rescatadora de secretos entre al campo de batalla, regresa la carta de instantáneo o de conjuro objetivo de tu cementerio a tu mano.\', \'type\': \'Criatura — Hechicero tritón\', \'flavor\': \'El mayor tesoro de las profundidades es un eco de la superficie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447768&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c6611a7a-c4d2-4a64-88bb-c869633ed0fa\', \'multiverseId\': 447768}, \'multiverseid\': 447768}, {\'name\': \'Récupératrice de secrets\', \'text\': "Quand la Récupératrice de secrets arrive sur le champ de bataille, renvoyez une carte d\'éphémère ou de rituel ciblée depuis votre cimetière dans votre main.", \'type\': \'Créature : ondin et sorcier\', \'flavor\': \'Le plus grand trésor des profondeurs est un écho de la surface.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448049&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4e15c2e2-c825-4198-97b6-56c4daabdea1\', \'multiverseId\': 448049}, \'multiverseid\': 448049}, {\'name\': \'Recuperatrice di Segreti\', \'text\': \'Quando la Recuperatrice di Segreti entra nel campo di battaglia, riprendi in mano dal tuo cimitero una carta istantaneo o stregoneria bersaglio.\', \'type\': \'Creatura — Mago Tritone\', \'flavor\': "Il più grande tesoro delle profondità è l\'eco della superficie.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448330&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4a10d3b3-c5d1-4439-9090-4f7de907298f\', \'multiverseId\': 448330}, \'multiverseid\': 448330}, {\'name\': \'秘密の回収者\', \'text\': \'秘密の回収者が戦場に出たとき、あなたの墓地からインスタントかソーサリーであるカード１枚を対象とし、それをあなたの手札に戻す。\', \'type\': \'クリーチャー — マーフォーク・ウィザード\', \'flavor\': \'深海の一番の宝物は上からの模倣だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448611&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2deb45bd-e532-4c16-b198-cee18ae71c5a\', \'multiverseId\': 448611}, \'multiverseid\': 448611}, {\'name\': \'비밀의 구조자\', \'text\': \'비밀의 구조자가 전장에 들어올 때, 당신의 무덤에 있는 순간마법 또는 집중마법 카드를 목표로 정한다. 그 카드를 당신의 손으로 되돌린다.\', \'type\': \'생물 — 인어 마법사\', \'flavor\': \'심해의 가장 귀한 보물은 위에서 들려 오는 메아리이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448892&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'71209af6-d9b3-42fc-be8c-64f2f0241937\', \'multiverseId\': 448892}, \'multiverseid\': 448892}, {\'name\': \'Recuperadora de Segredos\', \'text\': \'Quando Recuperadora de Segredos entrar no campo de batalha, devolva o card de mágica instantânea ou de feitiço alvo de seu cemitério para a sua mão.\', \'type\': \'Criatura — Tritão Mago\', \'flavor\': \'O maior tesouro das profundezas é um eco da superfície.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449173&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9200d737-a6a5-423b-a2e2-8f21a6a8b7bf\', \'multiverseId\': 449173}, \'multiverseid\': 449173}, {\'name\': \'Собирательница Тайн\', \'text\': \'Когда Собирательница Тайн выходит на поле битвы, верните целевую карту мгновенного заклинания или волшебства из вашего кладбища в вашу руку.\', \'type\': \'Существо — Мерфолк Чародей\', \'flavor\': \'Величайшее сокровище глубин — отзвук с поверхности.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449454&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'66cfe534-c0f3-4ad7-9031-2ceca45bdc78\', \'multiverseId\': 449454}, \'multiverseid\': 449454}, {\'name\': \'探密客\', \'text\': \'当探密客进战场时，将目标瞬间或法术牌从你的坟墓场移回你手上。\', \'type\': \'生物 ～人鱼／法术师\', \'flavor\': \'深洋中最珍贵的宝物，恰也是水面上备受重视之物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449735&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'be4b9105-a0ed-4de2-8d29-e3b888391774\', \'multiverseId\': 449735}, \'multiverseid\': 449735}, {\'name\': \'探密客\', \'text\': \'當探密客進戰場時，將目標瞬間或巫術牌從你的墳墓場移回你手上。\', \'type\': \'生物 ～人魚／魔法師\', \'flavor\': \'深洋中最珍貴的寶物，恰也是水面上備受重視之物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450016&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0dceec45-b61a-49bf-852c-9cb3b152aceb\', \'multiverseId\': 450016}, \'multiverseid\': 450016}]', '[{\'name\': \'Geisterform\', \'text\': \'Bis zu zwei Kreaturen deiner Wahl können in diesem Zug nicht geblockt werden.\', \'type\': \'Hexerei\', \'flavor\': \'„Schlösserknacken ist was für Anfänger."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447475&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f4459be6-c103-46ef-9d20-a043e9bd9a4d\', \'multiverseId\': 447475}, \'multiverseid\': 447475}, {\'name\': \'Forma fantasmal\', \'text\': \'Hasta dos criaturas objetivo no pueden ser bloqueadas este turno.\', \'type\': \'Conjuro\', \'flavor\': \'"Lo de forzar candados es para principiantes".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447756&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0f809fb2-ebe3-4037-b046-762f90e8fbaa\', \'multiverseId\': 447756}, \'multiverseid\': 447756}, {\'name\': \'Forme fantôme\', \'text\': "Jusqu\'à deux créatures ciblées ne peuvent pas être bloquées ce tour-ci.", \'type\': \'Rituel\', \'flavor\': "« Crocheter les serrures, c\'est bon pour les amateurs. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448037&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a543b5eb-3b16-4143-b723-f28b570e8f7c\', \'multiverseId\': 448037}, \'multiverseid\': 448037}, {\'name\': \'Forma Spettrale\', \'text\': \'Fino a due creature bersaglio non possono essere bloccate in questo turno.\', \'type\': \'Stregoneria\', \'flavor\': \'"È da principianti forzare le serrature."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448318&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'91900201-1bb9-4bee-9d8c-f43f74030606\', \'multiverseId\': 448318}, \'multiverseid\': 448318}, {\'name\': \'幽体化\', \'text\': \'クリーチャー最大２体を対象とする。このターン、それらはブロックされない。\', \'type\': \'ソーサリー\', \'flavor\': \'「錠前破りは素人のすることだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448599&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6549ded8-8c95-44c0-9455-d823ed90bdaa\', \'multiverseId\': 448599}, \'multiverseid\': 448599}, {\'name\': \'유령화\', \'text\': \'생물을 최대 두 개까지 목표로 정한다. 그 생물들은 이번 턴에 방어될 수 없다.\', \'type\': \'집중마법\', \'flavor\': \'"자물쇠를 따는 건 초보나 하는 일이지."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448880&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b183ed57-b13a-4617-afc3-40f52ce5123b\', \'multiverseId\': 448880}, \'multiverseid\': 448880}, {\'name\': \'Fantasmorfia\', \'text\': \'Até duas criaturas alvo não podem ser bloqueadas neste turno.\', \'type\': \'Feitiço\', \'flavor\': \'"Arrombar fechaduras é para principiantes."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449161&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ff0f361f-6aaa-46ac-9571-3cea0ea998ab\', \'multiverseId\': 449161}, \'multiverseid\': 449161}, {\'name\': \'Призрачная Форма\', \'text\': \'До двух целевых существ не могут быть заблокированы в этом ходу.\', \'type\': \'Волшебство\', \'flavor\': \'«Взламывать замки — это для новичков».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449442&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c959cff3-dff9-4b3b-9128-4dbeb2cd6e5a\', \'multiverseId\': 449442}, \'multiverseid\': 449442}, {\'name\': \'鬼影形体\', \'text\': \'至多两个目标生物本回合不能被阻挡。\', \'type\': \'法术\', \'flavor\': \'「初学者才撬锁。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449723&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e97dce97-4030-49ae-89f1-ea8a13773e5f\', \'multiverseId\': 449723}, \'multiverseid\': 449723}, {\'name\': \'鬼影形體\', \'text\': \'至多兩個目標生物本回合不能被阻擋。\', \'type\': \'巫術\', \'flavor\': \'「初學者才撬鎖。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450004&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f88f83a5-e5f4-4b49-a219-c3728251eaef\', \'multiverseId\': 450004}, \'multiverseid\': 450004}]', '[{\'name\': \'Gelehrter der Sterne\', \'text\': \'Wenn der Gelehrte der Sterne ins Spiel kommt und falls du ein Artefakt kontrollierst, ziehe eine Karte.\', \'type\': \'Kreatur — Mensch, Handwerker\', \'flavor\': \'„Der Pfad der Sterne ist so verlässlich wie die Instrumente, die ihn vermessen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447488&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c15498fa-8667-49f8-a608-d4e94fd27b82\', \'multiverseId\': 447488}, \'multiverseid\': 447488}, {\'name\': \'Erudito de la astronomía\', \'text\': \'Cuando el Erudito de la astronomía entre al campo de batalla, si controlas un artefacto, roba una carta.\', \'type\': \'Criatura — Artífice humano\', \'flavor\': \'"El camino de las estrellas es tan fiable como los instrumentos que miden sus posiciones".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447769&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'07272fc8-e35f-4ae3-ad14-4e9eab4edf4d\', \'multiverseId\': 447769}, \'multiverseid\': 447769}, {\'name\': \'Érudit des étoiles\', \'text\': "Quand l\'Érudit des étoiles arrive sur le champ de bataille, si vous contrôlez un artefact, piochez une carte.", \'type\': \'Créature : humain et artificier\', \'flavor\': \'« Le mouvement des étoiles est aussi fiable que les instruments qui le mesurent. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448050&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'46dd5dc8-2bf0-4a1a-b595-b9bd8f57917e\', \'multiverseId\': 448050}, \'multiverseid\': 448050}, {\'name\': \'Studioso delle Stelle\', \'text\': \'Quando lo Studioso delle Stelle entra nel campo di battaglia, se controlli un artefatto, pesca una carta.\', \'type\': \'Creatura — Artefice Umano\', \'flavor\': \'"I movimenti delle stelle sono affidabili quanto gli strumenti che li misurano."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448331&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8a944a0a-d079-40e5-a9cb-580863efbd8a\', \'multiverseId\': 448331}, \'multiverseid\': 448331}, {\'name\': \'星学者\', \'text\': \'星学者が戦場に出たとき、あなたがアーティファクトをコントロールしている場合、カードを１枚引く。\', \'type\': \'クリーチャー — 人間・工匠\', \'flavor\': \'「星の軌道は、それを測る道具と同等に信頼できる。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448612&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0ddac080-27ca-4c1f-973d-c465f32306b7\', \'multiverseId\': 448612}, \'multiverseid\': 448612}, {\'name\': \'별 연구가\', \'text\': \'별 연구가가 전장에 들어올 때, 당신이 마법물체를 조종한다면, 카드 한 장을 뽑는다.\', \'type\': \'생물 — 인간 기능공\', \'flavor\': \'"별들의 경로는 그것들을 측량하는 도구들 만큼이나 믿을만하지."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448893&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8403b6ee-8e53-48b7-812e-b0985013cc9a\', \'multiverseId\': 448893}, \'multiverseid\': 448893}, {\'name\': \'Escolástico das Estrelas\', \'text\': \'Quando Escolástico das Estrelas entrar no campo de batalha, se você controlar um artefato, compre um card.\', \'type\': \'Criatura — Humano Artesão\', \'flavor\': \'"O caminho das estrelas é tão confiável quanto os instrumentos que as medem."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449174&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6a564bbc-7206-4123-8a6a-4f4881b35a7e\', \'multiverseId\': 449174}, \'multiverseid\': 449174}, {\'name\': \'Ученый Звездочет\', \'text\': \'Когда Ученый Звездочет выходит на поле битвы, если под вашим контролем есть артефакт, возьмите карту.\', \'type\': \'Существо — Человек Механик\', \'flavor\': \'«Путь звезд надежен настолько, насколько надежны инструменты для его измерения».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449455&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b1ba34e9-e62b-453e-8db5-ab3af1b3eb0a\', \'multiverseId\': 449455}, \'multiverseid\': 449455}, {\'name\': \'星相学者\', \'text\': \'当星相学者进战场时，若你操控神器，则抓一张牌。\', \'type\': \'生物 ～人类／神器师\', \'flavor\': \'「星辰的行迹稳定不变，如同量测它们的工具。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449736&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8336ca7f-9cbe-4971-9e06-9ef17929af9c\', \'multiverseId\': 449736}, \'multiverseid\': 449736}, {\'name\': \'星相學者\', \'text\': \'當星相學者進戰場時，若你操控神器，則抽一張牌。\', \'type\': \'生物 ～人類／神器師\', \'flavor\': \'「星辰的行跡穩定不變，如同量測它們的工具。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450017&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'56e67f8e-bd63-4f20-b3f1-165e504afec3\', \'multiverseId\': 450017}, \'multiverseid\': 450017}]', '[{\'name\': \'Gelehrter des Horizonts\', \'text\': \'Fliegend\\nWenn der Gelehrte des Horizonts ins Spiel kommt, wende Hellsicht 2 an. (Schaue dir die obersten zwei Karten deiner Bibliothek an. Du kannst eine beliebige Anzahl davon unter deine Bibliothek legen und den Rest in beliebiger Reihenfolge oben darauf.)\', \'type\': \'Kreatur — Sphinx\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447476&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'796801c8-7680-4de2-b947-6e86579073d0\', \'multiverseId\': 447476}, \'multiverseid\': 447476}, {\'name\': \'Erudito del horizonte\', \'text\': \'Vuela.\\nCuando el Erudito del horizonte entre al campo de batalla, adivina 2. (Mira las dos primeras cartas de tu biblioteca, luego pon cualquier cantidad de ellas en el fondo de tu biblioteca y el resto en la parte superior en cualquier orden.)\', \'type\': \'Criatura — Esfinge\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447757&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'42d016eb-7157-4e21-9ee4-7093f53209c9\', \'multiverseId\': 447757}, \'multiverseid\': 447757}, {\'name\': "Érudit de l\'horizon", \'text\': "Vol\\nQuand l\'Érudit de l\'horizon arrive sur le champ de bataille, regard 2. (Regardez les deux cartes du dessus de votre bibliothèque. Mettez n\'importe quel nombre d\'entre elles au-dessous de votre bibliothèque et le reste, au-dessus, dans n\'importe quel ordre.)", \'type\': \'Créature : sphinx\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448038&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'977a2544-d2b8-4b66-8ad3-f6c963da5d9d\', \'multiverseId\': 448038}, \'multiverseid\': 448038}, {\'name\': "Studioso dell\'Orizzonte", \'text\': "Volare\\nQuando lo Studioso dell\'Orizzonte entra nel campo di battaglia, profetizza 2. (Guarda le prime due carte del tuo grimorio, poi mettine un qualsiasi numero in fondo al tuo grimorio e le altre in cima in qualsiasi ordine.)", \'type\': \'Creatura — Sfinge\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448319&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d9f2352e-e236-4498-bd9a-d9d556a1381f\', \'multiverseId\': 448319}, \'multiverseid\': 448319}, {\'name\': \'地平の識者\', \'text\': \'飛行\\n地平の識者が戦場に出たとき、占術２を行う。（あなたのライブラリーの一番上からカードを２枚見て、そのうちの望む枚数を望む順番であなたのライブラリーの一番下に、残りを望む順番で一番上に置く。）\', \'type\': \'クリーチャー — スフィンクス\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448600&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'95e61653-9ab5-458a-98f5-3509462dec5e\', \'multiverseId\': 448600}, \'multiverseid\': 448600}, {\'name\': \'지평선의 학자\', \'text\': \'비행\\n지평선의 학자가 전장에 들어올 때, 점술 2를 한다. (당신의 서고 맨 위 카드 두 장을 본다. 당신은 그 카드들 중 원하는 만큼을 당신의 서고 맨 밑에 놓고 나머지를 당신의 서고 맨 위에 원하는 순서대로 놓을 수 있다.)\', \'type\': \'생물 — 스핑크스\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448881&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b376862f-a243-45e8-88dd-4ae8cce00041\', \'multiverseId\': 448881}, \'multiverseid\': 448881}, {\'name\': \'Escolástico do Horizonte\', \'text\': \'Voar\\nQuando Escolástico do Horizonte entrar no campo de batalha, use vidência 2. (Olhe os dois cards do topo do seu grimório. Depois, coloque qualquer número deles no fundo do seu grimório e o resto no topo em qualquer ordem.)\', \'type\': \'Criatura — Esfinge\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449162&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'62943b7c-9709-4035-9ac0-edb9c625f2da\', \'multiverseId\': 449162}, \'multiverseid\': 449162}, {\'name\': \'Исследователь Горизонтов\', \'text\': \'Полет\\nКогда Исследователь Горизонтов выходит на поле битвы, предскажите 2. (Посмотрите две верхние карты вашей библиотеки, затем положите любое количество из них в низ вашей библиотеки, а остальные на верх вашей библиотеки в любом порядке.)\', \'type\': \'Существо — Сфинкс\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449443&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a03106c7-a578-4962-bf29-cfd2325c7e74\', \'multiverseId\': 449443}, \'multiverseid\': 449443}, {\'name\': \'天际学者\', \'text\': \'飞行\\n当天际学者进战场时，占卜2。（检视你牌库顶的两张牌，然后将其中任意数量的牌以任意顺序置于你牌库底，其余则以任意顺序置于你牌库顶。）\', \'type\': \'生物 ～史芬斯\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449724&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d04dc243-d203-4ed0-887d-62df120bb6d6\', \'multiverseId\': 449724}, \'multiverseid\': 449724}, {\'name\': \'天際學者\', \'text\': \'飛行\\n當天際學者進戰場時，占卜2。（檢視你牌庫頂的兩張牌，然後將其中任意數量的牌以任意順序置於你牌庫底，其餘則以任意順序置於你牌庫頂。）\', \'type\': \'生物 ～史芬斯\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450005&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4f9a36fd-6675-4c20-91fb-383cd28779db\', \'multiverseId\': 450005}, \'multiverseid\': 450005}]', '[{\'name\': \'Geschenk des Paradieses\', \'text\': \'Verzaubert ein Land\\nWenn das Geschenk des Paradieses ins Spiel kommt, erhältst du 3 Lebenspunkte dazu.\\nDas verzauberte Land hat „{T}: Erzeuge zwei Mana genau einer beliebigen Farbe."\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447601&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1da7540a-5dd1-45f8-bbf5-1deec038619e\', \'multiverseId\': 447601}, \'multiverseid\': 447601}, {\'name\': \'Obsequio del paraíso\', \'text\': \'Encantar tierra.\\nCuando el Obsequio del paraíso entre al campo de batalla, ganas 3 vidas.\\nLa tierra encantada tiene "{T}: Agrega dos manás de un color cualquiera".\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447882&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ce7b3e2d-0dc7-4409-bbe8-4ef483b1bd1a\', \'multiverseId\': 447882}, \'multiverseid\': 447882}, {\'name\': \'Don de paradis\', \'text\': "Enchanter : terrain\\nQuand le Don de paradis arrive sur le champ de bataille, vous gagnez 3 points de vie.\\nLe terrain enchanté a « {T} : Ajoutez deux manas d\'une seule couleur de votre choix. »", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448163&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'92ae7f58-3655-4df2-a8af-1c717a6b8d02\', \'multiverseId\': 448163}, \'multiverseid\': 448163}, {\'name\': \'Dono del Paradiso\', \'text\': \'Incanta terra\\nQuando il Dono del Paradiso entra nel campo di battaglia, guadagni 3 punti vita.\\nLa terra incantata ha "{T}: Aggiungi due mana di un qualsiasi colore".\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448444&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b56a9add-f9ef-4ee7-9c80-1e77b1f29128\', \'multiverseId\': 448444}, \'multiverseid\': 448444}, {\'name\': \'楽園の贈り物\', \'text\': \'エンチャント（土地）\\n楽園の贈り物が戦場に出たとき、あなたは３点のライフを得る。\\nエンチャントされている土地は「{T}：好きな色１色のマナ２点を加える。」を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448725&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'aebff783-590a-46ec-95e6-a3d96e8869de\', \'multiverseId\': 448725}, \'multiverseid\': 448725}, {\'name\': \'낙원의 선물\', \'text\': \'대지에 부여\\n낙원의 선물이 전장에 들어올 때, 당신은 생명 3점을 얻는다.\\n부여된 대지는 "{T}: 원하는 한 가지 색의 마나 두 개를 추가한다."를 가진다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449006&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'67e5a853-58ec-44a5-9070-c4181b949037\', \'multiverseId\': 449006}, \'multiverseid\': 449006}, {\'name\': \'Dádiva do Paraíso\', \'text\': \'Encantar terreno\\nQuando Dádiva do Paraíso entra no campo de batalha, você ganha 3 pontos de vida.\\nO terreno encantando tem "{T}: Adicione dois manas de uma cor à sua escolha."\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449287&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'48c61b2d-e2f1-41cd-9f2f-ff93eb29bac9\', \'multiverseId\': 449287}, \'multiverseid\': 449287}, {\'name\': \'Дарованный Рай\', \'text\': \'Зачаровать землю\\nКогда Дарованный Рай выходит на поле битвы, вы получаете 3 жизни.\\nЗачарованная земля имеет способность «{T}: добавьте две маны любого одного цвета».\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449568&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'28fdba41-cc49-4276-a0b2-a44df698ca04\', \'multiverseId\': 449568}, \'multiverseid\': 449568}, {\'name\': \'天堂赋礼\', \'text\': \'结附于地\\n当天堂赋礼进战场时，你获得3点生命。\\n所结附的地具有「{T}：加两点任意颜色的单色法术力。」\', \'type\': \'结界 ～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449849&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'239448d2-a3ee-4112-9693-33e6defd3098\', \'multiverseId\': 449849}, \'multiverseid\': 449849}, {\'name\': \'天堂賦禮\', \'text\': \'結附於地\\n當天堂賦禮進戰場時，你獲得3點生命。\\n所結附的地具有「{T}：加兩點任意顏色的單色魔法力。」\', \'type\': \'結界 ～靈氣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450130&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d9171952-e0ef-47cc-9265-8e85442eb618\', \'multiverseId\': 450130}, \'multiverseid\': 450130}]', "[{'name': 'Ghirapur-Führer', 'text': '{2}{G}: Eine Kreatur deiner Wahl, die du kontrollierst, kann in diesem Zug von Kreaturen mit Stärke 2 oder weniger nicht geblockt werden.', 'type': 'Kreatur — Elf, Späher', 'flavor': 'Messebesucher waren hocherfreut, dass Ghirapur auch außerhalb des Messegeländes Wunder zu bieten hatte.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447599&type=card', 'language': 'German', 'identifiers': {'scryfallId': '04ea4d7e-87e2-4e46-a2ce-225722b5fe9d', 'multiverseId': 447599}, 'multiverseid': 447599}, {'name': 'Guía de Ghirapur', 'text': '{2}{G}: La criatura objetivo que controlas no puede ser bloqueada por criaturas con fuerza de 2 o menos este turno.', 'type': 'Criatura — Explorador elfo', 'flavor': 'A los visitantes de la feria les gustó descubrir que, incluso fuera de sus terrenos, Ghirapur era una ciudad llena de maravillas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447880&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e30628f1-4cbc-4acc-9461-46309bbba578', 'multiverseId': 447880}, 'multiverseid': 447880}, {'name': 'Guide de Ghirapur', 'text': '{2}{G} : Une créature ciblée que vous contrôlez ne peut pas être bloquée par des créatures de force inférieure ou égale à 2 ce tour-ci.', 'type': 'Créature : elfe et éclaireur', 'flavor': 'Les visiteurs furent ravis de découvrir que même en dehors du champ de foire, Ghirapur était une cité merveilleuse.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448161&type=card', 'language': 'French', 'identifiers': {'scryfallId': '8f4fafb3-c403-418e-a868-91572c1dbf1e', 'multiverseId': 448161}, 'multiverseid': 448161}, {'name': 'Guida di Ghirapur', 'text': '{2}{G}: Una creatura bersaglio che controlli non può essere bloccata da creature con forza pari o inferiore a 2 in questo turno.', 'type': 'Creatura — Esploratore Elfo', 'flavor': 'I visitatori furono lieti di scoprire che le meraviglie di Ghirapur non erano confinate tra i banchi della fiera.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448442&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '7f74760e-53c9-4177-bb6a-5f7e23aa8edf', 'multiverseId': 448442}, 'multiverseid': 448442}, {'name': 'ギラプールの案内人', 'text': '{2}{G}：あなたがコントロールしているクリーチャー１体を対象とする。このターン、それはパワーが２以下のクリーチャーによってはブロックされない。', 'type': 'クリーチャー — エルフ・スカウト', 'flavor': '博覧会を訪れる人々は、会場外も含めてギラプール全体に満ち溢れる驚きを満喫した。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448723&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '124f4c61-8077-43e3-bfd0-7aac67f58ba4', 'multiverseId': 448723}, 'multiverseid': 448723}, {'name': '기라푸르 안내원', 'text': '{2}{G}: 당신이 조종하는 생물을 목표로 정한다. 그 생물은 이 턴에 공격력이 2 이하인 생물에게 방어될 수 없다.', 'type': '생물 — 엘프 정찰병', 'flavor': '박람회 참가자들은 박람회장 밖에서도 기라푸르가 경이로운 도시라는 사실에 경탄했다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449004&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '1d6342f7-4ee3-4395-999f-d3a4080f7d10', 'multiverseId': 449004}, 'multiverseid': 449004}, {'name': 'Guia de Ghirapur', 'text': '{2}{G}: A criatura alvo que você controla não pode ser bloqueada neste turno por criaturas com poder igual ou inferior a 2.', 'type': 'Criatura — Elfo Batedor', 'flavor': 'Os visitantes da Feira se encantaram ao descobrir que mesmo fora da feira Ghirapur era uma cidade de maravilhas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449285&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '11497811-201b-44e9-9eee-42edb38d31eb', 'multiverseId': 449285}, 'multiverseid': 449285}, {'name': 'Гирапурский Проводник', 'text': '{2}{G}: целевое существо под вашим контролем не может быть заблокировано существами с силой 2 или меньше в этом ходу.', 'type': 'Существо — Эльф Разведчик', 'flavor': 'Приехавшие на Ярмарку с удовольствием обнаружили, что и за пределами ярмарочной площади Гирапур был настоящим городом чудес.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449566&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'db5af126-0954-4833-9f10-696d9fa09df9', 'multiverseId': 449566}, 'multiverseid': 449566}, {'name': '吉拉波向导', 'text': '{2}{G}：目标由你操控的生物本回合不能被力量等于或小于2的生物阻挡。', 'type': '生物 ～妖精／斥候', 'flavor': '观展的人们惊喜地发现，即便是出了展区，吉拉波这座城市也处处充满神奇。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449847&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f43c6b39-a1f6-4ba8-9db3-dceddb1dcb84', 'multiverseId': 449847}, 'multiverseid': 449847}, {'name': '吉拉波嚮導', 'text': '{2}{G}：目標由你操控的生物本回合不能被力量等於或小於2的生物阻擋。', 'type': '生物 ～妖精／斥候', 'flavor': '觀展的人們驚喜地發現，即便是出了展區，吉拉波這座城市也處處充滿神奇。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450128&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '4f81d2ca-ac1f-4a52-a58f-768d7366c2ad', 'multiverseId': 450128}, 'multiverseid': 450128}]", '[{\'name\': \'Giftpfeil-Bogenschütze\', \'text\': \'Reichweite (Diese Kreatur kann fliegende Kreaturen blocken.)\\nTodesberührung (Eine beliebige Menge Schadenspunkte, die er einer Kreatur zufügt, sind ausreichend, um diese zu zerstören.)\\nImmer wenn eine andere Kreatur stirbt, verliert jeder Gegner 1 Lebenspunkt.\', \'type\': \'Kreatur — Elf, Bogenschütze\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447638&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d3fb5f65-4124-4e7c-9216-b852fb2b55b1\', \'multiverseId\': 447638}, \'multiverseid\': 447638}, {\'name\': \'Arquero puntaponzoña\', \'text\': \'Alcance. (Esta criatura puede bloquear a criaturas con la habilidad de volar.)\\nToque mortal. (Cualquier cantidad de daño que esto haga a una criatura es suficiente para destruirla.)\\nSiempre que otra criatura muera, cada oponente pierde 1 vida.\', \'type\': \'Criatura — Arquero elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447919&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9b35f425-de90-4465-ac26-49b274e56315\', \'multiverseId\': 447919}, \'multiverseid\': 447919}, {\'name\': \'Archer aux pointes empoisonnées\', \'text\': "Portée (Cette créature peut bloquer les créatures avec le vol.)\\nContact mortel (Le nombre de blessures que cette créature inflige à une créature, quel qu\'il soit, est suffisant pour la détruire.)\\nÀ chaque fois qu\'une autre créature meurt, chaque adversaire perd 1 point de vie.", \'type\': \'Créature : elfe et archer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448200&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3b064578-3b2f-4f49-8df7-06cb1dedc5fb\', \'multiverseId\': 448200}, \'multiverseid\': 448200}, {\'name\': \'Arciere della Punta Venefica\', \'text\': "Raggiungere (Questa creatura può bloccare le creature con volare.)\\nTocco letale (Qualsiasi danno che questa creatura infligge a una creatura è sufficiente a distruggerla.)\\nOgniqualvolta un\'altra creatura muore, ogni avversario perde 1 punto vita.", \'type\': \'Creatura — Arciere Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448481&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'729a67ed-c672-4a16-afd3-fd1b1435ec77\', \'multiverseId\': 448481}, \'multiverseid\': 448481}, {\'name\': \'毒矢尻の射手\', \'text\': \'到達（このクリーチャーで飛行を持つクリーチャーをブロックできる。）\\n接死（これが何らかのダメージをクリーチャーに与えたら、それだけで破壊する。）\\n他のクリーチャーが１体死亡するたび、各対戦相手はそれぞれ１点のライフを失う。\', \'type\': \'クリーチャー — エルフ・射手\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448762&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'962e62b8-dd55-48dc-87de-ad6ac062ce3a\', \'multiverseId\': 448762}, \'multiverseid\': 448762}, {\'name\': \'독화살 궁수\', \'text\': \'대공 (이 생물은 비행을 가진 생물을 방어할 수 있다.)\\n치명타 (이 생물에게 피해를 입은 생물은 입은 피해의 양에 상관없이 파괴된다.)\\n다른 생물이 죽을 때마다, 각 상대는 생명 1점을 잃는다.\', \'type\': \'생물 — 엘프 궁수\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449043&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2d40ed6d-55cc-4f7e-843b-364a7faadfd8\', \'multiverseId\': 449043}, \'multiverseid\': 449043}, {\'name\': \'Arqueiro da Ponta Envenenada\', \'text\': \'Alcance (Esta criatura pode bloquear criaturas com voar.)\\nToque mortífero (Qualquer quantidade de dano que esta criatura cause a uma criatura é suficiente para destruí-la.)\\nToda vez que outra criatura morre, cada oponente perde 1 ponto de vida.\', \'type\': \'Criatura — Elfo Arqueiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449324&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'99b59866-40f9-4a8f-b14c-16d940823831\', \'multiverseId\': 449324}, \'multiverseid\': 449324}, {\'name\': \'Ядоносный Лучник\', \'text\': \'Захват (Это существо может блокировать существа с Полетом.)\\nСмертельное касание (Любое количество повреждений, которое этот объект наносит существу, достаточно, чтобы его уничтожить.)\\nКаждый раз, когда другое существо умирает, каждый оппонент теряет 1 жизнь.\', \'type\': \'Существо — Эльф Лучник\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449605&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d05ac104-09a3-47ff-b8d8-719c7bb97a8c\', \'multiverseId\': 449605}, \'multiverseid\': 449605}, {\'name\': \'沾毒箭手\', \'text\': \'延势（此生物能阻挡具飞行异能的生物。）\\n死触（它对生物造成的任何数量伤害都足以消灭后者。）\\n每当另一个生物死去时，每位对手各失去1点生命。\', \'type\': \'生物 ～妖精／弓箭手\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449886&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6d314a67-8ea2-46d3-84a0-d5d375823633\', \'multiverseId\': 449886}, \'multiverseid\': 449886}, {\'name\': \'沾毒箭手\', \'text\': \'延勢（此生物能阻擋具飛行異能的生物。）\\n死觸（它對生物造成的任何數量傷害都足以消滅後者。）\\n每當另一個生物死去時，每位對手各失去1點生命。\', \'type\': \'生物 ～妖精／弓箭手\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450167&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8fc42097-f274-44e6-ac14-055e3adbc870\', \'multiverseId\': 450167}, \'multiverseid\': 450167}]', '[{\'name\': \'Gigantosaurus\', \'type\': \'Kreatur — Dinosaurier\', \'flavor\': \'„Jeder Zahn ist so lang wie ein Pferd und alle sechzehn Tage wachsen ihm neue. Komm, wir schauen uns das aus der Nähe an!"\\n—Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447602&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b303488c-7bf8-451a-98be-a5e65d74a287\', \'multiverseId\': 447602}, \'multiverseid\': 447602}, {\'name\': \'Gigantosaurio\', \'type\': \'Criatura — Dinosaurio\', \'flavor\': \'"Cada diente es tan largo como un caballo, y le crecen nuevos cada dieciséis días. ¡Te lo enseñaré más de cerca!".\\n—Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447883&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'44ccc075-57f7-4f09-93c8-f6826d4636fe\', \'multiverseId\': 447883}, \'multiverseid\': 447883}, {\'name\': \'Giganotosaurus\', \'type\': \'Créature : dinosaure\', \'flavor\': "« Chaque dent fait la taille d\'un cheval, et de nouvelles poussent tous les seize jours. Allons voir de plus près ! »\\n—Vivien Reid", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448164&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f30a1203-71b5-454f-b354-abd9f3170524\', \'multiverseId\': 448164}, \'multiverseid\': 448164}, {\'name\': \'Gigantosauro\', \'type\': \'Creatura — Dinosauro\', \'flavor\': \'"Ogni dente è lungo come un cavallo e ne spunta uno nuovo ogni sedici giorni. Diamo un\\\'occhiata più da vicino!"\\n—Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448445&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e12fbd02-adff-429c-8e86-96f3e875784c\', \'multiverseId\': 448445}, \'multiverseid\': 448445}, {\'name\': \'ギガントサウルス\', \'type\': \'クリーチャー — 恐竜\', \'flavor\': \'「歯の一本一本が馬ほどの長さで、新しい歯が16日おきに生えてくるの。もっと近くで見てみましょう。」\\n――ビビアン・リード\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448726&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c7f7445d-0412-4aeb-b4a7-376b430e075b\', \'multiverseId\': 448726}, \'multiverseid\': 448726}, {\'name\': \'기간토사우르스\', \'type\': \'생물 — 공룡\', \'flavor\': \'"이빨은 하나하나가 말처럼 길고, 16일마다 새로운 이빨이 솟아나지. 가까이 가서 보도록 할까!"\\n—비비안 레이드\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449007&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4197228a-d114-4a61-b2f4-bb39a9d8a472\', \'multiverseId\': 449007}, \'multiverseid\': 449007}, {\'name\': \'Gigantossauro\', \'type\': \'Criatura — Dinossauro\', \'flavor\': \'"Cada dente é do tamanho de um cavalo, e dentes novos crescem a cada dezesseis dias. Vamos ver mais de perto!"\\n— Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449288&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'887a26a3-54d0-45f5-8590-8296aae0243b\', \'multiverseId\': 449288}, \'multiverseid\': 449288}, {\'name\': \'Гигантозавр\', \'type\': \'Существо — Динозавр\', \'flavor\': \'«Каждый зуб размером с лошадь, а за шестнадцать дней вырастают новые. Давайте поглядим поближе!»\\n— Вивьен Рейд\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449569&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'549ba61d-3e95-457b-81d8-1e732e547381\', \'multiverseId\': 449569}, \'multiverseid\': 449569}, {\'name\': \'巨太龙\', \'type\': \'生物 ～恐龙\', \'flavor\': \'「每颗巨齿都有一匹马那般长，每隔十六天还会新长出一批。我们来仔细瞧瞧！」\\n～薇薇安瑞德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449850&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ad7f9c07-2cb7-4b79-94a1-2cf5a376f29d\', \'multiverseId\': 449850}, \'multiverseid\': 449850}, {\'name\': \'巨太龍\', \'type\': \'生物 ～恐龍\', \'flavor\': \'「每顆巨齒都有一匹馬那般長，每隔十六天還會新長出一批。我們來仔細瞧瞧！」\\n～薇薇安瑞德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450131&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'86b7dd99-291f-4018-93ce-63b4838b7666\', \'multiverseId\': 450131}, \'multiverseid\': 450131}]', '[{\'name\': \'Gipfel der Macht\', \'text\': \'Schicke die obersten sieben Karten deiner Bibliothek ins Exil. Bis zum Ende des Zuges kannst du Karten wirken, die keine Länder sind und die auf diese Weise ins Exil geschickt wurden.\\nFalls dieser Zauberspruch aus deiner Hand gewirkt wurde, erzeuge zehn Mana genau einer beliebigen Farbe.\', \'type\': \'Hexerei\', \'flavor\': \'„Was ich verlange, soll geschehen."\\n—Nicol Bolas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447546&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'58abb67a-7993-496d-8969-fd1d40ac4894\', \'multiverseId\': 447546}, \'multiverseid\': 447546}, {\'name\': \'Cúspide del poder\', \'text\': \'Exilia las siete primeras cartas de tu biblioteca. Hasta el final del turno, puedes lanzar las cartas que no sean tierra exiliadas de esta manera.\\nSi este hechizo fue lanzado desde tu mano, agrega diez manás de un color cualquiera.\', \'type\': \'Conjuro\', \'flavor\': \'"Todo será como yo lo desee".\\n—Nicol Bolas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447827&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'de3b6558-c866-4be2-a76c-9f349116795c\', \'multiverseId\': 447827}, \'multiverseid\': 447827}, {\'name\': \'Zénith du pouvoir\', \'text\': "Exilez les sept cartes du dessus de votre bibliothèque. Jusqu\'à la fin du tour, vous pouvez lancer les cartes non-terrain exilées de cette manière.\\nSi ce sort a été lancé depuis votre main, ajoutez dix manas d\'une seule couleur de votre choix.", \'type\': \'Rituel\', \'flavor\': "« C\'est ma volonté, donc ce sera une réalité. »\\n—Nicol Bolas", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448108&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e2ddbc6b-0a9f-4a05-83d2-6cfd90099618\', \'multiverseId\': 448108}, \'multiverseid\': 448108}, {\'name\': \'Apice del Potere\', \'text\': \'Esilia le prime sette carte del tuo grimorio. Fino alla fine del turno, puoi lanciare le carte non terra esiliate in questo modo.\\nSe questa magia è stata lanciata dalla tua mano, aggiungi dieci mana di un qualsiasi colore.\', \'type\': \'Stregoneria\', \'flavor\': \'"Ogni mio desiderio si compie."\\n—Nicol Bolas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448389&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0f107793-6915-4c33-9d96-23069d69838e\', \'multiverseId\': 448389}, \'multiverseid\': 448389}, {\'name\': \'力の頂点\', \'text\': \'あなたのライブラリーの一番上からカードを７枚追放する。ターン終了時まで、あなたはこれにより追放された土地でないカードを唱えてもよい。\\nこの呪文があなたの手札から唱えられたなら、好きな色１色のマナ10点を加える。\', \'type\': \'ソーサリー\', \'flavor\': \'「我が望めば、その通りになる。」\\n――ニコル・ボーラス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448670&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'900d3730-e29e-4032-84e5-963c7aed97ca\', \'multiverseId\': 448670}, \'multiverseid\': 448670}, {\'name\': \'힘의 정점\', \'text\': \'당신의 서고 맨 위 카드 일곱 장을 추방한다. 턴종료까지, 당신은 이렇게 추방된 대지가 아닌 카드들을 발동할 수 있다.\\n이 주문이 당신의 손에서 발동되었다면, 원하는 한 가지 색의 마나 열 개를 추가한다.\', \'type\': \'집중마법\', \'flavor\': \'"내가 원하니, 그대로 되리라."\\n—니콜 볼라스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448951&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5ff6b261-1c17-48ec-a9eb-bfd5cb099309\', \'multiverseId\': 448951}, \'multiverseid\': 448951}, {\'name\': \'Ápice do Poder\', \'text\': \'Exile os sete cards do topo de seu grimório. Até o final do turno, você pode conjurar os cards que não sejam terreno exilados desta maneira.\\nSe esta mágica foi conjurada de sua mão, adicione dez manas de qualquer cor.\', \'type\': \'Feitiço\', \'flavor\': \'"Como eu desejar, assim será."\\n— Nicol Bolas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449232&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f41dc1eb-f8b2-4a62-91b1-fda20d3a5c42\', \'multiverseId\': 449232}, \'multiverseid\': 449232}, {\'name\': \'Вершина Могущества\', \'text\': \'Изгоните семь верхних карт вашей библиотеки. До конца хода вы можете разыграть не являющиеся землями карты, изгнанные таким образом.\\nЕсли это заклинание было разыграно из вашей руки, добавьте десять ман любого одного цвета.\', \'type\': \'Волшебство\', \'flavor\': \'«Как я пожелаю, так и будет».\\n— Никол Болас\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449513&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2abb623a-ca71-46b5-9aee-b69890552bd9\', \'multiverseId\': 449513}, \'multiverseid\': 449513}, {\'name\': \'无上力量\', \'text\': \'放逐你牌库顶的七张牌。直到回合结束，你可以施放以此法放逐的非地牌。\\n如果此咒语是从你手上施放，则加十点任意颜色的单色法术力。\', \'type\': \'法术\', \'flavor\': \'「吾之所欲，必能成型。」\\n～尼可波拉斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449794&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d7cad186-e0a8-44d4-8dcb-9a24c94b1a61\', \'multiverseId\': 449794}, \'multiverseid\': 449794}, {\'name\': \'無上力量\', \'text\': \'放逐你牌庫頂的七張牌。直到回合結束，你可以施放以此法放逐的非地牌。\\n如果此咒語是從你手上施放，則加十點任意顏色的單色魔法力。\', \'type\': \'巫術\', \'flavor\': \'「吾之所欲，必能成型。」\\n～尼可波拉斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450075&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f8d3375f-4851-4660-befb-060640b77af6\', \'multiverseId\': 450075}, \'multiverseid\': 450075}]', '[{\'name\': \'Goblin-Anstifter\', \'text\': \'{T}: Eine Kreatur deiner Wahl erhält Eile bis zum Ende des Zuges. (Sie kann in diesem Zug angreifen und {T}.)\', \'type\': \'Kreatur — Goblin, Krieger\', \'flavor\': \'Kleine Worte können eine große Wirkung haben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447560&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'daafe1ec-0cb8-4d3f-bbf3-1b99091aa29d\', \'multiverseId\': 447560}, \'multiverseid\': 447560}, {\'name\': \'Trasgo espoleador\', \'text\': \'{T}: La criatura objetivo gana la habilidad de prisa hasta el final del turno. (Puede atacar y {T} este turno.)\', \'type\': \'Criatura — Guerrero trasgo\', \'flavor\': \'Las palabras nimias avivan grandes llamas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447841&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4cf8d27a-62b8-4fbc-9e28-e40db63da2bf\', \'multiverseId\': 447841}, \'multiverseid\': 447841}, {\'name\': \'Motiveur gobelin\', \'text\': "{T} : La créature ciblée acquiert la célérité jusqu\'à la fin du tour. (Elle peut attaquer et {T} ce tour-ci.)", \'type\': \'Créature : gobelin et guerrier\', \'flavor\': \'Les petits mots attisent de grands feux.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448122&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e272dd75-6df9-467a-a2d7-86bbaff78236\', \'multiverseId\': 448122}, \'multiverseid\': 448122}, {\'name\': \'Goblin Motivatore\', \'text\': \'{T}: Una creatura bersaglio ha rapidità fino alla fine del turno. (Può attaccare e {T} in questo turno.)\', \'type\': \'Creatura — Guerriero Goblin\', \'flavor\': \'Parole umili possono alimentare grandi roghi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448403&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0d86dde3-493c-4881-ac00-f505f821e8c3\', \'multiverseId\': 448403}, \'multiverseid\': 448403}, {\'name\': \'ゴブリンの激励者\', \'text\': \'{T}：クリーチャー１体を対象とする。ターン終了時まで、それは速攻を得る。（このターン、それは攻撃したり{T}したりできる。）\', \'type\': \'クリーチャー — ゴブリン・戦士\', \'flavor\': \'少しの言葉が大きな炎を起こす。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448684&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7b369a71-de45-4a80-8019-5db0aaeb093d\', \'multiverseId\': 448684}, \'multiverseid\': 448684}, {\'name\': \'고블린 동기부여가\', \'text\': \'{T}: 생물을 목표로 정한다. 그 생물은 턴종료까지 신속을 얻는다. (이 턴에 그 생물은 공격하거나 {T}할 수 있다.)\', \'type\': \'생물 — 고블린 전사\', \'flavor\': \'말 몇 마디가 거대한 불길을 일으킨다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448965&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9d56119b-ff3f-4232-b44b-aac0d421c345\', \'multiverseId\': 448965}, \'multiverseid\': 448965}, {\'name\': \'Motivador Goblin\', \'text\': \'{T}: A criatura alvo ganha ímpeto até o final do turno. (Ela pode atacar e {T} neste turno.)\', \'type\': \'Criatura — Goblin Guerreiro\', \'flavor\': \'Palavras curtas instigam chamas grandes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449246&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'63c6e27b-2b51-4e45-b725-082b9c4e9d65\', \'multiverseId\': 449246}, \'multiverseid\': 449246}, {\'name\': \'Убедительный Гоблин\', \'text\': \'{T}: целевое существо получает Ускорение до конца хода. (Оно может атаковать и {T} в этом ходу.)\', \'type\': \'Существо — Гоблин Воин\', \'flavor\': \'Маленькие слова раздувают большое пламя.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449527&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d5d34043-11ba-454b-a00c-4e6c908a1338\', \'multiverseId\': 449527}, \'multiverseid\': 449527}, {\'name\': \'激励鬼怪\', \'text\': \'{T}：目标生物获得敏捷异能直到回合结束。（它此回合便能攻击与{T}。）\', \'type\': \'生物 ～鬼怪／战士\', \'flavor\': \'微言细语亦能煽起熊熊烈焰。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449808&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'79e2c134-7de6-4218-85e9-faef08d97a01\', \'multiverseId\': 449808}, \'multiverseid\': 449808}, {\'name\': \'激勵鬼怪\', \'text\': \'{T}：目標生物獲得敏捷異能直到回合結束。（它此回合便能攻擊與{T}。）\', \'type\': \'生物 ～鬼怪／戰士\', \'flavor\': \'微言細語亦能煽起熊熊烈焰。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450089&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'591624b9-ba49-4ec1-9ae1-98ac625d8fa7\', \'multiverseId\': 450089}, \'multiverseid\': 450089}]', '[{\'name\': \'Goblin-Aufhetzer\', \'text\': \'Wenn der Goblin-Aufhetzer ins Spiel kommt, erzeuge einen 1/1 roten Goblin-Kreaturenspielstein.\', \'type\': \'Kreatur — Goblin, Räuber\', \'flavor\': \'„Die schaffen wir. Du gehst vor!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447559&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'daed414d-7bcc-4032-a60f-fe5127817dba\', \'multiverseId\': 447559}, \'multiverseid\': 447559}, {\'name\': \'Trasgo instigador\', \'text\': \'Cuando el Trasgo instigador entre al campo de batalla, crea una ficha de criatura Trasgo roja 1/1.\', \'type\': \'Criatura — Bribón trasgo\', \'flavor\': \'"Podemos con ellos. ¡Tú primero!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447840&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6a695993-3336-46a8-b7bf-466697a82e2a\', \'multiverseId\': 447840}, \'multiverseid\': 447840}, {\'name\': \'Instigateur gobelin\', \'text\': "Quand l\'Instigateur gobelin arrive sur le champ de bataille, créez un jeton de créature 1/1 rouge Gobelin.", \'type\': \'Créature : gobelin et gredin\', \'flavor\': \'« On peut les battre. Toi, vas-y le premier ! »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448121&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a410dfea-a0b0-4284-8dc7-ec49e0ac806f\', \'multiverseId\': 448121}, \'multiverseid\': 448121}, {\'name\': \'Goblin Istigatore\', \'text\': \'Quando il Goblin Istigatore entra nel campo di battaglia, crea una pedina creatura Goblin 1/1 rossa.\', \'type\': \'Creatura — Farabutto Goblin\', \'flavor\': \'"Possiamo farcela. Vai avanti tu!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448402&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fdc08e8b-7300-4172-a6e8-cd12e5eda0b7\', \'multiverseId\': 448402}, \'multiverseid\': 448402}, {\'name\': \'ゴブリンの扇動者\', \'text\': \'ゴブリンの扇動者が戦場に出たとき、赤の１/１のゴブリン・クリーチャー・トークンを１体生成する。\', \'type\': \'クリーチャー — ゴブリン・ならず者\', \'flavor\': \'「とっ捕まえるぞ。先に行け！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448683&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bf60045e-f3d5-49ae-9933-98637b6122a1\', \'multiverseId\': 448683}, \'multiverseid\': 448683}, {\'name\': \'고블린 선동가\', \'text\': \'고블린 선동가가 전장에 들어올 때, 1/1 적색 고블린 생물 토큰 한 개를 만든다.\', \'type\': \'생물 — 고블린 도적\', \'flavor\': \'"쓰러트릴 수 있어. 네가 먼저 가!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448964&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'91702eca-4290-4d1f-a351-ebfa229440e1\', \'multiverseId\': 448964}, \'multiverseid\': 448964}, {\'name\': \'Instigador Goblin\', \'text\': \'Quando Instigador Goblin entrar no campo de batalha, crie uma ficha de criatura vermelha 1/1 do tipo Goblin.\', \'type\': \'Criatura — Goblin Ladino\', \'flavor\': \'"A gente pode com eles. Vai na frente!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449245&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c6e8847a-6302-418a-bafb-35fd91a0d61f\', \'multiverseId\': 449245}, \'multiverseid\': 449245}, {\'name\': \'Гоблинский Зачинщик\', \'text\': \'Когда Гоблинский Зачинщик выходит на поле битвы, создайте одну фишку существа 1/1 красный Гоблин.\', \'type\': \'Существо — Гоблин Бродяга\', \'flavor\': \'«Сейчас мы им покажем! Иди первым».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449526&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0ee02f79-965a-4cae-bc30-66115f9a40a7\', \'multiverseId\': 449526}, \'multiverseid\': 449526}, {\'name\': \'煽动鬼怪\', \'text\': \'当煽动鬼怪进战场时，派出一个1/1红色鬼怪衍生生物。\', \'type\': \'生物 ～鬼怪／浪客\', \'flavor\': \'「我们能解决他们。你先上！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449807&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e159f0c6-0f54-4c0a-8314-ddec4ec15014\', \'multiverseId\': 449807}, \'multiverseid\': 449807}, {\'name\': \'煽動鬼怪\', \'text\': \'當煽動鬼怪進戰場時，派出一個1/1紅色鬼怪衍生生物。\', \'type\': \'生物 ～鬼怪／浪客\', \'flavor\': \'「我們能解決他們。你先上！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450088&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b4808dd4-a4fd-4c21-a102-b3b212572d7b\', \'multiverseId\': 450088}, \'multiverseid\': 450088}]', '[{\'name\': \'Goblin-Verschrotter\', \'text\': \'Andere Goblins, die du kontrollierst, erhalten +1/+1.\\nOpfere einen Goblin: Zerstöre ein Artefakt deiner Wahl.\', \'type\': \'Kreatur — Goblin, Krieger\', \'flavor\': \'„Die Leute hier sind wie besessen von ihren Geräten. Wir tun ihnen einen Gefallen, wenn wir ein paar davon verschrotten."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447561&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'23fc54ec-fd2d-4b27-923f-3f652a31489e\', \'multiverseId\': 447561}, \'multiverseid\': 447561}, {\'name\': \'Maestro chatarrero trasgo\', \'text\': \'Los otros Trasgos que controlas obtienen +1/+1.\\nSacrificar un Trasgo: Destruye el artefacto objetivo.\', \'type\': \'Criatura — Guerrero trasgo\', \'flavor\': \'"Aquí la gente está demasiado enamorada de sus aparatos. Les viene bien que machaquemos alguno de vez en cuando".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447842&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'26d350c1-5430-4404-8f15-aaf59828b095\', \'multiverseId\': 447842}, \'multiverseid\': 447842}, {\'name\': \'Maître-vandale gobelin\', \'text\': "Les autres gobelins que vous contrôlez gagnent +1/+1.\\nSacrifiez un gobelin : Détruisez l\'artefact ciblé.", \'type\': \'Créature : gobelin et guerrier\', \'flavor\': \'« Les gens du coin aiment trop leurs machines. Ça leur fait du bien quand on en fracasse une de temps en temps. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448123&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7cb2ca2b-3d72-40c2-bee1-b80de4def35b\', \'multiverseId\': 448123}, \'multiverseid\': 448123}, {\'name\': \'Goblin Rottamatore\', \'text\': \'Gli altri Goblin che controlli prendono +1/+1.\\nSacrifica un Goblin: Distruggi un artefatto bersaglio.\', \'type\': \'Creatura — Guerriero Goblin\', \'flavor\': \'"La gente da queste parti è troppo affezionata ai propri congegni. Se ne spacchiamo qualcuno ogni tanto, è per il loro bene."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448404&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'17f4ff29-2a8c-4d26-8479-c62cd0f71555\', \'multiverseId\': 448404}, \'multiverseid\': 448404}, {\'name\': \'ゴブリンの損壊名手\', \'text\': \'あなたがコントロールしている他のゴブリンは＋１/＋１の修整を受ける。\\nゴブリン１体を生け贄に捧げる：アーティファクト１つを対象とし、それを破壊する。\', \'type\': \'クリーチャー — ゴブリン・戦士\', \'flavor\': \'「この辺りの奴らはカラクリが好きすぎる。しょっちゅうぶち壊してれば少しはマシになるかね。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448685&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'15450d28-6061-4c92-aacb-aae509636139\', \'multiverseId\': 448685}, \'multiverseid\': 448685}, {\'name\': \'고블린 쓰레기수집가\', \'text\': \'당신이 조종하는 다른 고블린들은 +1/+1을 받는다.\\n고블린 한 개를 희생한다: 마법물체를 목표로 정한다. 그 마법물체를 파괴한다.\', \'type\': \'생물 — 고블린 전사\', \'flavor\': \'"이곳에 있는 녀석들은 다들 잡동사니를 너무 좋아해. 자주 한 개씩 부숴 놓는 게 그 녀석들한테도 좋은 일이야."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448966&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8d416b01-57dc-4a19-9f98-1b910e9680b7\', \'multiverseId\': 448966}, \'multiverseid\': 448966}, {\'name\': \'Mestre Desmantelador Goblin\', \'text\': \'Os outros Goblins que você controla recebem +1/+1.\\nSacrifique um Goblin: Destrua o artefato alvo.\', \'type\': \'Criatura — Goblin Guerreiro\', \'flavor\': \'"Esse povo daqui gosta um pouco demais dessas engenhocas. Fazemos um favor para eles quebrando algumas de vez em quando."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449247&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e943fafe-b8c3-4d9f-979a-4f5009c7805d\', \'multiverseId\': 449247}, \'multiverseid\': 449247}, {\'name\': \'Гоблинский Крушила\', \'text\': \'Другие Гоблины под вашим контролем получают +1/+1.\\nПожертвуйте Гоблина: уничтожьте целевой артефакт.\', \'type\': \'Существо — Гоблин Воин\', \'flavor\': \'«Местный народ жить не может без своих прибамбасов. Им только на пользу, если мы поломаем несколько штук».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449528&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'57ef7c6b-01a9-4e4e-a538-f7c193d19016\', \'multiverseId\': 449528}, \'multiverseid\': 449528}, {\'name\': \'坏物鬼怪\', \'text\': \'由你操控的其他鬼怪得+1/+1。\\n牺牲一个鬼怪：消灭目标神器。\', \'type\': \'生物 ～鬼怪／战士\', \'flavor\': \'「这里的人过度迷恋自己的发明。不时砸掉一些对他们有好处。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449809&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'53c0f677-f872-4e7d-a674-0009ac580201\', \'multiverseId\': 449809}, \'multiverseid\': 449809}, {\'name\': \'壞物鬼怪\', \'text\': \'由你操控的其他鬼怪得+1/+1。\\n犧牲一個鬼怪：消滅目標神器。\', \'type\': \'生物 ～鬼怪／戰士\', \'flavor\': \'「這裡的人過度迷戀自己的發明。不時砸掉一些對他們有好處。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450090&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'26dcb53e-9982-4cac-9450-c770cccde873\', \'multiverseId\': 450090}, \'multiverseid\': 450090}]', '[{\'name\': \'Gossenschütze\', \'text\': \'Immer wenn du einen Spontanzauber oder eine Hexerei wirkst, fügt der Gossenschütze jedem Gegner 2 Schadenspunkte zu.\', \'type\': \'Kreatur — Goblin, Schamane\', \'flavor\': \'„Ich hab ein neues Spielzeug. Willst du\\\'s mal sehen?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447562&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'447cbeb4-2b04-4ba7-8d3d-fa92ed2dcbf6\', \'multiverseId\': 447562}, \'multiverseid\': 447562}, {\'name\': \'Disparacuneta\', \'text\': \'Siempre que lances un hechizo de instantáneo o de conjuro, el Disparacuneta hace 2 puntos de daño a cada oponente.\', \'type\': \'Criatura — Chamán trasgo\', \'flavor\': \'"He encontrado un juguete nuevo. ¿Quieres jugar?".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447843&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7e63a921-2a85-4042-b0e0-224477e4b6f8\', \'multiverseId\': 447843}, \'multiverseid\': 447843}, {\'name\': \'Gobelin des rues\', \'text\': "À chaque fois que vous lancez un sort d\'éphémère ou de rituel, le Gobelin des rues inflige 2 blessures à chaque adversaire.", \'type\': \'Créature : gobelin et shamane\', \'flavor\': "« J\'ai un nouveau joujou. Tu veux jouer ? »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448124&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'89f122c8-86b2-4213-a536-52c4a57295cd\', \'multiverseId\': 448124}, \'multiverseid\': 448124}, {\'name\': \'Cecchino\', \'text\': \'Ogniqualvolta lanci una magia istantaneo o stregoneria, il Cecchino infligge 2 danni a ogni avversario.\', \'type\': \'Creatura — Sciamano Goblin\', \'flavor\': \'"Ho trovato un nuovo giocattolo. Vuoi provarlo?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448405&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bd51d91f-8e98-4c8f-8fd2-d9ba2be47d8c\', \'multiverseId\': 448405}, \'multiverseid\': 448405}, {\'name\': \'どぶ潜み\', \'text\': \'あなたがインスタントかソーサリーである呪文を唱えるたび、どぶ潜みは各対戦相手にそれぞれ２点のダメージを与える。\', \'type\': \'クリーチャー — ゴブリン・シャーマン\', \'flavor\': \'「新しいオモチャを見つけたのさ。遊んでみるか？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448686&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d35ca1bd-79d1-494b-9844-7551f8e661e6\', \'multiverseId\': 448686}, \'multiverseid\': 448686}, {\'name\': \'시궁창 저격수\', \'text\': \'당신이 순간마법 또는 집중마법 주문을 발동할 때마다, 시궁창 저격수는 각 상대에게 피해 2점을 입힌다.\', \'type\': \'생물 — 고블린 주술사\', \'flavor\': \'"새 장난감을 찾았어. 같이 놀래?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448967&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'58fe189f-4b19-4ceb-b286-b1bcd114c984\', \'multiverseId\': 448967}, \'multiverseid\': 448967}, {\'name\': \'Atirador da Sarjeta\', \'text\': \'Toda vez que você conjura uma mágica instantânea ou um feitiço, Atirador da Sarjeta causa 2 pontos de dano a cada oponente.\', \'type\': \'Criatura — Goblin Xamã\', \'flavor\': \'"Achei um brinquedo novo. Quer brincar?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449248&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'98f53191-eb49-46be-8340-299a2a454fa1\', \'multiverseId\': 449248}, \'multiverseid\': 449248}, {\'name\': \'Бездомный Уязвитель\', \'text\': \'Каждый раз, когда вы разыгрываете мгновенное заклинание или заклинание волшебства, Бездомный Уязвитель наносит 2 повреждения каждому оппоненту.\', \'type\': \'Существо — Гоблин Шаман\', \'flavor\': \'«Я нашел новую игрушку. Поиграем?»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449529&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b78bb8c2-2df0-4f84-8507-9728c58c6262\', \'multiverseId\': 449529}, \'multiverseid\': 449529}, {\'name\': \'贫窟伏击客\', \'text\': \'每当你施放瞬间或法术咒语时，贫窟伏击客向每位对手各造成2点伤害。\', \'type\': \'生物 ～鬼怪／祭师\', \'flavor\': \'「我发现一件新玩具。一起玩吗？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449810&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'03a8ef24-c987-4d22-8f8c-92afef62757e\', \'multiverseId\': 449810}, \'multiverseid\': 449810}, {\'name\': \'貧窟伏擊客\', \'text\': \'每當你施放瞬間或巫術咒語時，貧窟伏擊客向每位對手各造成2點傷害。\', \'type\': \'生物 ～鬼怪／祭師\', \'flavor\': \'「我發現一件新玩具。一起玩嗎？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450091&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ff4584bf-9a4a-4d58-8314-bb237c3c3c82\', \'multiverseId\': 450091}, \'multiverseid\': 450091}]', '[{\'name\': \'Grünhain-Wächterin\', \'text\': \'Wachsamkeit (Diese Kreatur wird beim Angreifen nicht getappt.)\', \'type\': \'Kreatur — Elf, Späher\', \'flavor\': \'Schon wenn du dich dem Wald näherst, spürst du ihre Blicke. Begibst du dich hinein, spürst du ihre Klinge.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447604&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'daba0f46-33a6-4924-8109-a3ff651eb074\', \'multiverseId\': 447604}, \'multiverseid\': 447604}, {\'name\': \'Centinela maderaverde\', \'text\': \'Vigilancia. (Esta criatura no se gira al atacar.)\', \'type\': \'Criatura — Explorador elfo\', \'flavor\': \'Cuando te acerques al bosque, sentirás sus ojos sobre ti. Si entras, sentirás el filo de su arma.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447885&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2f9d9c4b-2936-4a8d-8ea4-c7aac141626a\', \'multiverseId\': 447885}, \'multiverseid\': 447885}, {\'name\': \'Sentinelle de Boisvert\', \'text\': "Vigilance (Attaquer avec cette créature ne la fait pas s\'engager.)", \'type\': \'Créature : elfe et éclaireur\', \'flavor\': \'À un kilomètre des sylves, vous sentirez son regard posé sur vous. Sur son territoire, vous sentirez sa lame.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448166&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'64c273f0-cde4-4f15-a35e-18c537bd3656\', \'multiverseId\': 448166}, \'multiverseid\': 448166}, {\'name\': \'Sentinella del Bosco Verdeggiante\', \'text\': \'Cautela (Questa creatura attacca senza TAPpare.)\', \'type\': \'Creatura — Esploratore Elfo\', \'flavor\': \'A un miglio dal bosco, sentirai il suo sguardo posarsi su di te. Una volta raggiunti i primi alberi, sentirai la sua spada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448447&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c6e38ca7-ac71-475b-953e-611ad9b1c527\', \'multiverseId\': 448447}, \'multiverseid\': 448447}, {\'name\': \'緑林の歩哨\', \'text\': \'警戒（このクリーチャーは攻撃してもタップしない。）\', \'type\': \'クリーチャー — エルフ・スカウト\', \'flavor\': \'森林の周囲１マイルまで近づけば、彼女の視線を感じる。森林の境界の内側に入れば、彼女の刃を感じることになる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448728&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a6f7fd6a-8e3f-4eaf-9308-43819c7e68fe\', \'multiverseId\': 448728}, \'multiverseid\': 448728}, {\'name\': \'산림 경비병\', \'text\': \'경계 (이 생물은 공격하면서 탭되지 않는다.)\', \'type\': \'생물 — 엘프 정찰병\', \'flavor\': \'삼림에서 멀리 떨어지지 않은 곳이면, 그녀가 당신을 지켜보는 것을 느낄 수 있다. 삼림 안에서는, 그녀의 칼날을 느낄 수 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449009&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1686c231-e242-461f-8f45-374acd07c04d\', \'multiverseId\': 449009}, \'multiverseid\': 449009}, {\'name\': \'Sentinela de Mataverde\', \'text\': \'Vigilância (Esta criatura não é virada para atacar.)\', \'type\': \'Criatura — Elfo Batedor\', \'flavor\': \'A mais de um quilômetro da mata você sentirá o olhar dela. Dentro de suas fronteiras, você sentirá sua lâmina.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449290&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3bb95643-384d-4a92-955c-2d9b3b566a5d\', \'multiverseId\': 449290}, \'multiverseid\': 449290}, {\'name\': \'Стражница Зеленого Леса\', \'text\': \'Бдительность (Атакуя, это существо не поворачивается.)\', \'type\': \'Существо — Эльф Разведчик\', \'flavor\': \'Приблизившись на милю к лесу, ты почувствуешь на себе ее взгляд. Перейди границу — и почувствуешь ее клинок.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449571&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'97f1838b-bd64-4083-96e9-89422d759b30\', \'multiverseId\': 449571}, \'multiverseid\': 449571}, {\'name\': \'翠林哨兵\', \'text\': \'警戒（此生物攻击时不需横置。）\', \'type\': \'生物 ～妖精／斥候\', \'flavor\': \'在林地外一哩的范围内，你就能感受到她的目光。在林地之内，你就能感受到她的利刃。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449852&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c04956e5-4129-4253-9b90-31348db55e5f\', \'multiverseId\': 449852}, \'multiverseid\': 449852}, {\'name\': \'翠林哨兵\', \'text\': \'警戒（此生物攻擊時不需橫置。）\', \'type\': \'生物 ～妖精／斥候\', \'flavor\': \'在林地外一哩的範圍內，你就能感受到她的目光。在林地之內，你就能感受到她的利刃。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450133&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'dc97fa0c-662e-44a5-b638-4d092d2067cf\', \'multiverseId\': 450133}, \'multiverseid\': 450133}]', "[{'name': 'Gänzlich verlaufen', 'text': 'Lege eine bleibende Karte deiner Wahl, die kein Land ist, oben auf die Bibliothek ihres Besitzers.', 'type': 'Spontanzauber', 'flavor': 'Fblzzp konnte Menschenmassen noch nie leiden.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447498&type=card', 'language': 'German', 'identifiers': {'scryfallId': '1e4587ab-6f53-4922-a9c9-f653c7fb8381', 'multiverseId': 447498}, 'multiverseid': 447498}, {'name': 'Perdido por completo', 'text': 'Pon el permanente objetivo que no sea tierra en la parte superior de la biblioteca de su propietario.', 'type': 'Instantáneo', 'flavor': 'Fblthp siempre había odiado las multitudes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447779&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ba57b9db-400a-422a-9ce2-c370d15c565f', 'multiverseId': 447779}, 'multiverseid': 447779}, {'name': 'Complètement perdu', 'text': 'Mettez le permanent non-terrain ciblé au-dessus de la bibliothèque de son propriétaire.', 'type': 'Éphémère', 'flavor': 'Fblthp avait toujours eu la foule en horreur.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448060&type=card', 'language': 'French', 'identifiers': {'scryfallId': '1e279979-bb5d-4f75-8ebb-f6b66d847657', 'multiverseId': 448060}, 'multiverseid': 448060}, {'name': 'Completamente Perso', 'text': 'Metti un permanente non terra bersaglio in cima al grimorio del suo proprietario.', 'type': 'Istantaneo', 'flavor': 'Fblthp ha sempre odiato la folla.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448341&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '4a0a4df9-311c-4e20-9f61-bf13af520602', 'multiverseId': 448341}, 'multiverseid': 448341}, {'name': '道迷い', 'text': '土地でないパーマネント１つを対象とし、それをオーナーのライブラリーの一番上に置く。', 'type': 'インスタント', 'flavor': 'フブルスプは昔から人ごみが嫌いだった。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448622&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '96db8547-b168-4a95-965a-a8e16a9edd2d', 'multiverseId': 448622}, 'multiverseid': 448622}, {'name': '난 누군가 또 여긴 어딘가', 'text': '대지가 아닌 지속물을 목표로 정한다. 그 지속물을 소유자의 서고 맨 위에 놓는다.', 'type': '순간마법', 'flavor': '프블뜹은 항상 사람 많은 곳을 싫어했다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448903&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '8856ce1a-f1e3-4fa8-93f7-67a57613a751', 'multiverseId': 448903}, 'multiverseid': 448903}, {'name': 'Totalmente Perdido', 'text': 'Coloque a permanente alvo que não seja um terreno no topo do grimório de seu dono.', 'type': 'Mágica Instantânea', 'flavor': 'Fblthp sempre odiou multidões.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449184&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '484c3a69-9cbd-4ac2-9a04-8531bd97d95a', 'multiverseId': 449184}, 'multiverseid': 449184}, {'name': 'Окончательно Заблудившийся', 'text': 'Положите целевой не являющийся землей перманент на верх библиотеки его владельца.', 'type': 'Мгновенное заклинание', 'flavor': 'Фыблтып всегда ненавидел толпы.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449465&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '567d2078-e7b9-4583-84d8-5b79ff34bc7c', 'multiverseId': 449465}, 'multiverseid': 449465}, {'name': '完全迷途', 'text': '将目标非地永久物置于其拥有者的牌库顶。', 'type': '瞬间', 'flavor': '夫毕佐向来讨厌群众。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449746&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'eede691f-1485-4bc9-b26f-4c4d9a7fb867', 'multiverseId': 449746}, 'multiverseid': 449746}, {'name': '完全迷途', 'text': '將目標非地永久物置於其擁有者的牌庫頂。', 'type': '瞬間', 'flavor': '夫畢佐向來討厭群眾。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450027&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '3439c32e-1d9c-4df3-9b4e-2bf9ddee7363', 'multiverseId': 450027}, 'multiverseid': 450027}]", '[{\'name\': \'Göttliche Anrufung\', \'text\': \'Zerstöre ein Artefakt oder eine Verzauberung deiner Wahl. Du erhältst 4 Lebenspunkte dazu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Zerstöre, was dich zerstört. Verbanne deine Bürde in die Dunkelheit und errichte den Gläubigen eine Zuflucht aus Licht."\\n—Das Lied von Allem, Gesang 1008\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447433&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f494bbd6-b506-48fe-af77-77187525c047\', \'multiverseId\': 447433}, \'multiverseid\': 447433}, {\'name\': \'Invocar a lo divino\', \'text\': \'Destruye el artefacto o encantamiento objetivo. Ganas 4 vidas.\', \'type\': \'Instantáneo\', \'flavor\': \'"Deja ir todo lo que te haga daño. Arroja tus culpas a la oscuridad y construye un refugio de luz para los fieles".\\n—Canción de Todos, canto 1008\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447714&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'defb69ae-805c-451a-9b71-062c4836b1c0\', \'multiverseId\': 447714}, \'multiverseid\': 447714}, {\'name\': \'Invocation de la divinité\', \'text\': "Détruisez l\'artefact ciblé ou l\'enchantement ciblé. Vous gagnez 4 points de vie.", \'type\': \'Éphémère\', \'flavor\': \'« Débarrassez-vous de tout ce qui vous nuit. Reléguez vos tourments aux ténèbres, et construisez un abri de lumière pour les fidèles. »\\n—Geste du Grand Tout, chant 1008\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447995&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8b0bd23a-87ec-476e-94c7-dd562d1e8af0\', \'multiverseId\': 447995}, \'multiverseid\': 447995}, {\'name\': \'Invocare il Divino\', \'text\': \'Distruggi un artefatto o un incantesimo bersaglio. Guadagni 4 punti vita.\', \'type\': \'Istantaneo\', \'flavor\': \'"Spogliati di tutto ciò che ti causa dolore. Getta i tuoi fardelli nell\\\'oscurità ed erigi una casa di luce per i fedeli."\\n—Canzone di Tutti, canto 1008\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448276&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f22b7a6c-50e8-4a00-aca9-81700400496d\', \'multiverseId\': 448276}, \'multiverseid\': 448276}, {\'name\': \'神聖の発動\', \'text\': \'アーティファクト１つかエンチャント１つを対象とし、それを破壊する。あなたは４点のライフを得る。\', \'type\': \'インスタント\', \'flavor\': \'「そなたを害する一切を退けよ。重荷を闇に投げ捨て、誠実な人々のために光の家を築け。」\\n――「万物の歌」、詩編一〇〇八\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448557&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'58684689-cc9d-4005-9366-8febb8ab7095\', \'multiverseId\': 448557}, \'multiverseid\': 448557}, {\'name\': \'신성 기원\', \'text\': \'마법물체 또는 부여마법을 목표로 정한다. 그 목표를 파괴한다. 당신은 생명 4점을 얻는다.\', \'type\': \'순간마법\', \'flavor\': \'"그대를 해하는 모든 것을 그저 흘러가게 두어라. 어둠 속으로 짐을 벗어던지고 신실한 빛의 집을 지어올려라."\\n—모두의 노래, 1008절\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448838&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ce0b3748-f6c6-4591-ab1c-a12b7af4c50c\', \'multiverseId\': 448838}, \'multiverseid\': 448838}, {\'name\': \'Invocar o Divino\', \'text\': \'Destrua o artefato ou encantamento alvo. Você ganha 4 pontos de vida.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Abandone tudo que o fere. Jogue seus fardos às trevas e construa uma casa de luz para os fiéis."\\n— Canção de Todos, canto 1008\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449119&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a7f4ec04-e268-4c90-a3a3-e5c9f0134676\', \'multiverseId\': 449119}, \'multiverseid\': 449119}, {\'name\': \'Призыв к Божественному\', \'text\': \'Уничтожьте целевой артефакт или чары. Вы получаете 4 жизни.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Отпусти все, что ранит тебя. Отбрось тяготы во тьму и возведи для праведных чертог света».\\n— «Песнь Сущего», стих 1008\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449400&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f6baf927-f97f-4293-b9f0-e4a6e8c8f7b0\', \'multiverseId\': 449400}, \'multiverseid\': 449400}, {\'name\': \'召现神力\', \'text\': \'消灭目标神器或结界。你获得4点生命。\', \'type\': \'瞬间\', \'flavor\': \'「抛弃一切害人之物。弃重荷于黑暗，宿信徒以明光。」\\n～《万物之歌》，1008节\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449681&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'825424e2-4203-4da8-9def-08968177d837\', \'multiverseId\': 449681}, \'multiverseid\': 449681}, {\'name\': \'召現神力\', \'text\': \'消滅目標神器或結界。你獲得4點生命。\', \'type\': \'瞬間\', \'flavor\': \'「拋棄一切害人之物。棄重荷於黑暗，宿信徒以明光。」\\n～《萬物之歌》，1008節\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449962&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0bcc3edb-7c08-4180-83b5-e6e11331f57a\', \'multiverseId\': 449962}, \'multiverseid\': 449962}]', '[{\'name\': \'Habgieriger Halunke\', \'text\': \'Der Habgierige Halunke erhält +1/+0, solange er angreift.\', \'type\': \'Kreatur — Mensch, Pirat\', \'flavor\': \'„Die Beute verlangt nach mir. Sie ruft meinen Namen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450293&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'40493bbe-677b-4713-80b9-141515c7cb1f\', \'multiverseId\': 450293}, \'multiverseid\': 450293}, {\'name\': \'Truhan avaricioso\', \'text\': \'El Truhan avaricioso obtiene +1/+0 mientras esté atacando.\', \'type\': \'Criatura — Pirata humano\', \'flavor\': \'"El pillaje me llama. Literalmente, usa mi nombre".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450327&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1c3bd382-f4c5-4fe0-8ada-5c47170fa607\', \'multiverseId\': 450327}, \'multiverseid\': 450327}, {\'name\': \'Vaurien avide\', \'text\': "Le Vaurien avide gagne +1/+0 tant qu\'il attaque.", \'type\': \'Créature : humain et pirate\', \'flavor\': "« J\'entends l\'appel du pillage. Il m\'appelle par mon nom. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450361&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'504f4999-d127-4d3b-9149-4af816aa5145\', \'multiverseId\': 450361}, \'multiverseid\': 450361}, {\'name\': \'Canaglia Arraffona\', \'text\': \'La Canaglia Arraffona prende +1/+0 fintanto che è attaccante.\', \'type\': \'Creatura — Pirata Umano\', \'flavor\': \'"Sento il richiamo del saccheggio. Sta gridando il mio nome."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450395&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f3ca6c28-2a4f-4ee5-84a6-a8841cbf164f\', \'multiverseId\': 450395}, \'multiverseid\': 450395}, {\'name\': \'欲深い悪漢\', \'text\': \'欲深い悪漢が攻撃しているかぎり、これは＋１/＋０の修整を受ける。\', \'type\': \'クリーチャー — 人間・海賊\', \'flavor\': \'「略奪の呼び声が聞こえる。俺を名指しで呼んでいるんだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450429&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c91bf5a5-df17-4200-8a72-2b141777cd53\', \'multiverseId\': 450429}, \'multiverseid\': 450429}, {\'name\': \'움켜잡는 악당\', \'text\': \'움켜잡는 악당은 공격 중인 한 +1/+0을 받는다.\', \'type\': \'생물 — 인간 해적\', \'flavor\': \'"약탈이 나를 부르는 게 들려. 정확히 내 이름을 부르고 있어."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450463&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7e371460-dc09-4611-9eb2-e8eb3f51d6fe\', \'multiverseId\': 450463}, \'multiverseid\': 450463}, {\'name\': \'Canalha Ganancioso\', \'text\': \'Canalha Ganancioso receberá +1/+0 enquanto estiver atacando.\', \'type\': \'Criatura — Humano Pirata\', \'flavor\': \'"Consigo ouvir a pilhagem. Ela me chama pelo nome."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450497&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6ddc6d24-8b4b-45fa-af41-a36ecc123a77\', \'multiverseId\': 450497}, \'multiverseid\': 450497}, {\'name\': \'Алчный Головорез\', \'text\': \'Пока Алчный Головорез атакует, он получает +1/+0.\', \'type\': \'Существо — Человек Пират\', \'flavor\': \'«Я уже слышу, как зовет добыча. Она зовет меня по имени».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450531&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'40c8ef51-3dd4-44c2-8d35-f544965c1180\', \'multiverseId\': 450531}, \'multiverseid\': 450531}, {\'name\': \'贪婪恶棍\', \'text\': \'只要贪婪恶棍正进行攻击，它便得+1/+0。\', \'type\': \'生物 ～人类／海盗\', \'flavor\': \'「我听到了劫夺的呼唤。它指名道姓要我去。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450565&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1e4ef520-211a-44c8-a968-b31acc5f80c8\', \'multiverseId\': 450565}, \'multiverseid\': 450565}, {\'name\': \'貪婪惡棍\', \'text\': \'只要貪婪惡棍正進行攻擊，它便得+1/+0。\', \'type\': \'生物 ～人類／海盜\', \'flavor\': \'「我聽到了劫奪的呼喚。它指名道姓要我去。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450599&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c4d95e9f-77e0-496f-be51-bac2e6d65dff\', \'multiverseId\': 450599}, \'multiverseid\': 450599}]', '[{\'name\': \'Hainsucher-Dryade\', \'text\': \'{T}: Schaue dir die oberste Karte deiner Bibliothek an. Falls es eine Länderkarte ist, kannst du sie offen vorzeigen und auf deine Hand nehmen.\', \'type\': \'Kreatur — Dryade\', \'flavor\': \'„Das Land kennt sein Schicksal bereits. Ich bitte es nur, mir davon zu erzählen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447595&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0c9ff32b-2278-4718-902f-d456cf36c315\', \'multiverseId\': 447595}, \'multiverseid\': 447595}, {\'name\': \'Dríada buscadora de verde\', \'text\': \'{T}: Mira la primera carta de tu biblioteca. Si es una carta de tierra, puedes mostrarla y ponerla en tu mano.\', \'type\': \'Criatura — Dríada\', \'flavor\': \'"La tierra ya conoce su destino, solo le pido que me lo cuente".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447876&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'baad1cd1-2ec1-4def-90fe-045eb2f0c2d9\', \'multiverseId\': 447876}, \'multiverseid\': 447876}, {\'name\': \'Dryade chercheuse de verdure\', \'text\': "{T} : Regardez la carte du dessus de votre bibliothèque. Si c\'est une carte de terrain, vous pouvez la révéler et la mettre dans votre main.", \'type\': \'Créature : dryade\', \'flavor\': "« La terre connaît déjà sa destinée. Je lui demande simplement de partager l\'histoire avec moi. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448157&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a2164bb6-6f0a-4714-bc2b-3442a5dcef55\', \'multiverseId\': 448157}, \'multiverseid\': 448157}, {\'name\': \'Driade Cercatrice Verde\', \'text\': \'{T}: Guarda la prima carta del tuo grimorio. Se è una carta terra, puoi rivelarla e aggiungerla alla tua mano.\', \'type\': \'Creatura — Driade\', \'flavor\': \'"La terra conosce già il suo destino. Io mi limito a chiederle di raccontarmi la sua storia."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448438&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e78b046f-88ac-488a-86d8-330074f540a6\', \'multiverseId\': 448438}, \'multiverseid\': 448438}, {\'name\': \'緑探しのドライアド\', \'text\': \'{T}：あなたのライブラリーの一番上のカードを見る。それが土地・カードであるなら、あなたはそれを公開してあなたの手札に加えてもよい。\', \'type\': \'クリーチャー — ドライアド\', \'flavor\': \'「土地にはもうその運命が分かっている。私はただそのお話を聞かせてもらうだけ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448719&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'136bc1bd-a449-4330-bb16-c7d84d3b465d\', \'multiverseId\': 448719}, \'multiverseid\': 448719}, {\'name\': \'드라이어드 녹림추적자\', \'text\': \'{T}: 당신의 서고 맨 위 카드를 본다. 만약 그 카드가 대지 카드라면, 당신은 그 카드를 공개하고 당신의 손으로 가져갈 수 있다.\', \'type\': \'생물 — 드라이어드\', \'flavor\': \'"대지는 이미 자신의 운명을 알고 있습니다. 저는 단지 그 이야기를 저에게도 들려달라고 할 뿐이죠."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449000&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'81f68d36-8d60-4c61-97c8-5bc9bd7036e6\', \'multiverseId\': 449000}, \'multiverseid\': 449000}, {\'name\': \'Dríade Busca-verde\', \'text\': \'{T}: Olhe o card do topo de seu grimório. Se for um card de terreno, você pode revelá-lo e colocá-lo em sua mão.\', \'type\': \'Criatura — Dríade\', \'flavor\': \'"A terra já conhece o próprio destino. Eu só peço que ela compartilhe comigo essa história."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449281&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c2cf0cf1-d74d-4c0f-8683-3e3048a85bb5\', \'multiverseId\': 449281}, \'multiverseid\': 449281}, {\'name\': \'Дриада-Искательница\', \'text\': \'{T}: посмотрите верхнюю карту вашей библиотеки. Если это карта земли, вы можете показать ее и положить в вашу руку.\', \'type\': \'Существо — Дриада\', \'flavor\': \'«Земля уже знает свою судьбу. Я просто прошу ее поделиться своей историей со мной».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449562&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'de8fae5f-a9c5-47d7-afbd-e685b7887fbd\', \'multiverseId\': 449562}, \'multiverseid\': 449562}, {\'name\': \'寻碧树灵\', \'text\': \'{T}：检视你的牌库顶牌。如果该牌是地牌，你可以展示该牌并置于你手上。\', \'type\': \'生物 ～树灵\', \'flavor\': \'「大地早已知晓自己的命运。我不过是求其与我分享。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449843&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b0b52e76-5c5c-43fc-98be-67e3585b9e1f\', \'multiverseId\': 449843}, \'multiverseid\': 449843}, {\'name\': \'尋碧樹靈\', \'text\': \'{T}：檢視你的牌庫頂牌。如果該牌是地牌，你可以展示該牌並置於你手上。\', \'type\': \'生物 ～樹靈\', \'flavor\': \'「大地早已知曉自己的命運。我不過是求其與我分享。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450124&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e3d4a27e-5e2f-4efc-97fa-4630d7373a91\', \'multiverseId\': 450124}, \'multiverseid\': 450124}]', '[{\'name\': \'Heroische Verstärkung\', \'text\': \'Erzeuge zwei 1/1 weiße Soldat-Kreaturenspielsteine. Bis zum Ende des Zuges erhalten Kreaturen, die du kontrollierst, +1/+1 und Eile. (Sie können in diesem Zug angreifen und {T}.)\', \'type\': \'Hexerei\', \'flavor\': \'Die Schmerzenschreie wurden schnell von Kampfgebrüll abgelöst.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447634&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c590ab41-ebb4-4b8f-b470-72c4d823fb2a\', \'multiverseId\': 447634}, \'multiverseid\': 447634}, {\'name\': \'Refuerzos heroicos\', \'text\': \'Crea dos fichas de criatura Soldado blancas 1/1. Hasta el final del turno, las criaturas que controlas obtienen +1/+1 y ganan la habilidad de prisa. (Pueden atacar y {T} este turno.)\', \'type\': \'Conjuro\', \'flavor\': \'Los gritos de angustia se convirtieron enseguida en rugidos de acción.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447915&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'eb743d92-5c75-40f2-aa83-09fe0be233f2\', \'multiverseId\': 447915}, \'multiverseid\': 447915}, {\'name\': \'Renforts héroïques\', \'text\': "Créez deux jetons de créature 1/1 blanche Soldat. Jusqu\'à la fin du tour, les créatures que vous contrôlez gagnent +1/+1 et acquièrent la célérité. (Elles peuvent attaquer et {T} ce tour-ci.)", \'type\': \'Rituel\', \'flavor\': "Les hurlements d\'angoisse encouragèrent rapidement les cris d\'action.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448196&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2d26989d-9158-4244-86c1-e7d917027a9b\', \'multiverseId\': 448196}, \'multiverseid\': 448196}, {\'name\': \'Rinforzi Eroici\', \'text\': \'Crea due pedine creatura Soldato 1/1 bianche. Fino alla fine del turno, le creature che controlli prendono +1/+1 e hanno rapidità. (Possono attaccare e {T} in questo turno.)\', \'type\': \'Stregoneria\', \'flavor\': \'Le urla di agonia presto si trasformarono in grida di incitamento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448477&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f4a467e5-c140-49e9-a311-84420a349cdf\', \'multiverseId\': 448477}, \'multiverseid\': 448477}, {\'name\': \'英雄的援軍\', \'text\': \'白の１/１の兵士・クリーチャー・トークンを２体生成する。ターン終了時まで、あなたがコントロールしているクリーチャーは＋１/＋１の修整を受け、速攻を得る。（このターン、それらは攻撃したり{T}したりできる。）\', \'type\': \'ソーサリー\', \'flavor\': \'苦痛の叫びはたちまち行動の声を駆り立てた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448758&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'45f8328e-e054-42ba-87bc-449606572377\', \'multiverseId\': 448758}, \'multiverseid\': 448758}, {\'name\': \'영웅적인 지원군\', \'text\': \'1/1 백색 병사 생물 토큰 두 개를 만든다. 턴종료까지, 당신이 조종하는 생물들은 +1/+1을 받고 신속을 얻는다. (그 생물들은 이 턴에 공격하거나 {T}할 수 있다.)\', \'type\': \'집중마법\', \'flavor\': \'분노의 외침은 곧 행동의 외침으로 변했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449039&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e596db6e-0a4f-4c1d-bc0d-a7e652d22eb8\', \'multiverseId\': 449039}, \'multiverseid\': 449039}, {\'name\': \'Reforços Heroicos\', \'text\': \'Crie duas fichas de criatura brancas 1/1 do tipo Soldado. Até o final do turno, as criaturas que você controla recebem +1/+1 e ganham ímpeto. (Elas podem atacar e {T} neste turno.)\', \'type\': \'Feitiço\', \'flavor\': \'Os gritos de angústia rapidamente instigaram brados de ação.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449320&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'013c662e-a6f5-4c6a-88ae-728462e3f284\', \'multiverseId\': 449320}, \'multiverseid\': 449320}, {\'name\': \'Героическое Подкрепление\', \'text\': \'Создайте две фишки существа 1/1 белый Солдат. До конца хода существа под вашим контролем получают +1/+1 и Ускорение. (Они могут атаковать и {T} в этом ходу.)\', \'type\': \'Волшебство\', \'flavor\': \'Крикам отчаяния эхом ответили призывы к действиям.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449601&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3e9fa07f-23fd-4691-b62e-dbad464310d0\', \'multiverseId\': 449601}, \'multiverseid\': 449601}, {\'name\': \'英勇增援\', \'text\': \'派出两个1/1白色士兵衍生生物。直到回合结束，由你操控的生物得+1/+1且获得敏捷异能。（它们此回合便能攻击与{T}。）\', \'type\': \'法术\', \'flavor\': \'苦痛呻吟迅速唤来行动呐喊。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449882&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ee9b4697-f7f3-4605-81a6-9eff7c8794d1\', \'multiverseId\': 449882}, \'multiverseid\': 449882}, {\'name\': \'英勇增援\', \'text\': \'派出兩個1/1白色士兵衍生生物。直到回合結束，由你操控的生物得+1/+1且獲得敏捷異能。（它們此回合便能攻擊與{T}。）\', \'type\': \'巫術\', \'flavor\': \'苦痛呻吟迅速喚來行動吶喊。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450163&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'96221ac5-60a3-41ca-9221-2ad8cf39ad03\', \'multiverseId\': 450163}, \'multiverseid\': 450163}]', '[{\'name\': \'Heroldin des Glaubens\', \'text\': \'Fliegend\\nImmer wenn die Heroldin des Glaubens angreift, erhältst du 2 Lebenspunkte dazu.\', \'type\': \'Kreatur — Engel\', \'flavor\': \'Die Kleriker beteten für die Erlösung. Die Soldaten beteten für den Sieg. Beide Gebete wurden erhört.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447430&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ec80c814-c98e-4a96-b819-a4be72b3a403\', \'multiverseId\': 447430}, \'multiverseid\': 447430}, {\'name\': \'Heraldo de la fe\', \'text\': \'Vuela.\\nSiempre que la Heraldo de la fe ataque, ganas 2 vidas.\', \'type\': \'Criatura — Ángel\', \'flavor\': \'Los clérigos rogaban por la salvación; los guerreros, por la victoria. Ambas plegarias obtuvieron respuesta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447711&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8c7367cd-de34-452d-83c4-f8ec3cf83515\', \'multiverseId\': 447711}, \'multiverseid\': 447711}, {\'name\': \'Héraut de la foi\', \'text\': \'Vol\\nÀ chaque fois que le Héraut de la foi attaque, vous gagnez 2 points de vie.\', \'type\': \'Créature : ange\', \'flavor\': \'Les clercs prièrent pour le salut. Les soldats prièrent pour la victoire. Toutes leurs prières furent exaucées.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447992&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9de6c68a-ebe7-433a-b6cc-3103fc296794\', \'multiverseId\': 447992}, \'multiverseid\': 447992}, {\'name\': \'Araldo della Fede\', \'text\': "Volare\\nOgniqualvolta l\'Araldo della Fede attacca, guadagni 2 punti vita.", \'type\': \'Creatura — Angelo\', \'flavor\': \'I chierici imploravano la salvezza, i soldati la vittoria. Entrambe le suppliche sono state esaudite.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448273&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cd6f426d-d5a0-4f21-ac84-dab99c38b508\', \'multiverseId\': 448273}, \'multiverseid\': 448273}, {\'name\': \'信仰の伝令\', \'text\': \'飛行\\n信仰の伝令が攻撃するたび、あなたは２点のライフを得る。\', \'type\': \'クリーチャー — 天使\', \'flavor\': \'司祭は救済を祈った。兵士は勝利を祈った。どちらの祈りも聞き届けられた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448554&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d1b4c3c1-97f9-43ba-8c52-b05ff00ed2c9\', \'multiverseId\': 448554}, \'multiverseid\': 448554}, {\'name\': \'신앙의 전령\', \'text\': \'비행\\n신앙의 전령이 공격할 때마다, 당신은 생명 2점을 얻는다.\', \'type\': \'생물 — 천사\', \'flavor\': \'사제들은 구원을 위해 기도한다. 병사들은 승리를 위해 기도한다. 두 기도 모두 응답을 받았다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448835&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'938842db-e3dd-4fac-b5b9-07a3423b39b6\', \'multiverseId\': 448835}, \'multiverseid\': 448835}, {\'name\': \'Arauto da Fé\', \'text\': \'Voar\\nToda vez que Arauto da Fé ataca, você ganha 2 pontos de vida.\', \'type\': \'Criatura — Anjo\', \'flavor\': \'Os clérigos rezaram pela salvação. Os soldados rezaram pela vitória. Ambas as rezas foram atendidas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449116&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c91b5573-f0cf-4bf8-9fe2-267ef6a9e521\', \'multiverseId\': 449116}, \'multiverseid\': 449116}, {\'name\': \'Вестница Веры\', \'text\': \'Полет\\nКаждый раз, когда Вестница Веры атакует, вы получаете 2 жизни.\', \'type\': \'Существо — Ангел\', \'flavor\': \'Священники молились о спасении. Солдаты молились о победе. Обе молитвы были услышаны.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449397&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'794d61fe-d674-4356-81ee-1a22ad1937ed\', \'multiverseId\': 449397}, \'multiverseid\': 449397}, {\'name\': \'信念传令使\', \'text\': \'飞行\\n每当信念传令使攻击时，你获得2点生命。\', \'type\': \'生物 ～天使\', \'flavor\': \'僧侣祈救赎；士兵求胜利；两者皆得应。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449678&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c5d48144-cd11-45a3-88aa-d19f7217f39a\', \'multiverseId\': 449678}, \'multiverseid\': 449678}, {\'name\': \'信念傳令使\', \'text\': \'飛行\\n每當信念傳令使攻擊時，你獲得2點生命。\', \'type\': \'生物 ～天使\', \'flavor\': \'僧侶祈救贖；士兵求勝利；兩者皆得應。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449959&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1feadb68-83cf-416f-b0cf-6212ab6c3f80\', \'multiverseId\': 449959}, \'multiverseid\': 449959}]', '[{\'name\': \'Himmelsreiter-Patrouille\', \'text\': \'Fliegend\\nZu Beginn des Kampfes in deinem Zug kannst du {G}{U} bezahlen. Wenn du dies tust, lege eine +1/+1-Marke auf eine andere Kreatur deiner Wahl, die du kontrollierst, und jene Kreatur erhält Flugfähigkeit bis zum Ende des Zuges.\', \'type\': \'Kreatur — Elf, Späher\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447642&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'86b6460d-9197-4ee9-b66f-b81d21bb6d0d\', \'multiverseId\': 447642}, \'multiverseid\': 447642}, {\'name\': \'Batallón de jinetes celestes\', \'text\': \'Vuela.\\nAl comienzo del combate en tu turno, puedes pagar {G}{U}. Cuando lo hagas, pon un contador +1/+1 sobre otra criatura objetivo que controlas, y esa criatura gana la habilidad de volar hasta el final del turno.\', \'type\': \'Criatura — Explorador elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447923&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'79b1ec93-42a9-49e2-837e-a6356e0a9cc7\', \'multiverseId\': 447923}, \'multiverseid\': 447923}, {\'name\': \'Patrouille de cavaliers célestes\', \'text\': "Vol\\nAu début du combat pendant votre tour, vous pouvez payer {G}{U}. Quand vous faites ainsi, mettez un marqueur +1/+1 sur une autre créature ciblée que vous contrôlez, et cette créature acquiert le vol jusqu\'à la fin du tour.", \'type\': \'Créature : elfe et éclaireur\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448204&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b30e88c9-d4cc-4225-8cb9-44460ccbba07\', \'multiverseId\': 448204}, \'multiverseid\': 448204}, {\'name\': \'Pattuglia Cavalcacielo\', \'text\': "Volare\\nAll\'inizio del combattimento nel tuo turno, puoi pagare {G}{U}. Quando lo fai, metti un segnalino +1/+1 su un\'altra creatura bersaglio che controlli e quella creatura ha volare fino alla fine del turno.", \'type\': \'Creatura — Esploratore Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448485&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e06e2172-c68a-416c-8dbd-2c073a745257\', \'multiverseId\': 448485}, \'multiverseid\': 448485}, {\'name\': \'空乗りの巡回兵\', \'text\': \'飛行\\nあなたのターンの戦闘の開始時に、あなたは{G}{U} を支払ってもよい。そうしたとき、あなたがコントロールしている他のクリーチャー１体を対象とし、それの上に＋１/＋１カウンターを１個置き、ターン終了時まで、そのクリーチャーは飛行を得る。\', \'type\': \'クリーチャー — エルフ・スカウト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448766&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cff9b118-53b0-43c8-af75-afcc5d1a51cb\', \'multiverseId\': 448766}, \'multiverseid\': 448766}, {\'name\': \'하늘기수 순찰대\', \'text\': \'비행\\n당신의 턴 전투 시작에, 당신은 {G}{U}를 지불할 수 있다. 당신이 그렇게 할 때, 당신이 조종하는 다른 생물을 목표로 정한다. 그 생물에 +1/+1 카운터 한 개를 올려놓고 그 생물은 턴종료까지 비행을 얻는다.\', \'type\': \'생물 — 엘프 정찰병\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449047&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c5c7c4e9-b658-47c5-8e28-9c105f99ee59\', \'multiverseId\': 449047}, \'multiverseid\': 449047}, {\'name\': \'Patrulha da Cavalaria Celeste\', \'text\': \'Voar\\nNo início do combate no seu turno, você pode pagar {G}{U}. Quando fizer isso, coloque um marcador +1/+1 em outra criatura alvo que você controla. Aquela criatura ganha voar até o final do turno.\', \'type\': \'Criatura — Elfo Batedor\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449328&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fe83238d-4372-4043-a022-ee822ebb6280\', \'multiverseId\': 449328}, \'multiverseid\': 449328}, {\'name\': \'Патруль Небесных Всадников\', \'text\': \'Полет\\nВ начале боя во время вашего хода вы можете заплатить {G}{U}. Когда вы это делаете, положите один жетон +1/+1 на другое целевое существо под вашим контролем, и то существо получает Полет до конца хода.\', \'type\': \'Существо — Эльф Разведчик\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449609&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ec2f9fc9-7c8e-43a7-ba9f-46b777c81a02\', \'multiverseId\': 449609}, \'multiverseid\': 449609}, {\'name\': \'驭空巡侦员\', \'text\': \'飞行\\n在你回合的战斗开始时，你可以支付{G}{U}。当你如此作时，在另一个目标由你操控的生物上放置一个+1/+1指示物，且该生物获得飞行异能直到回合结束。\', \'type\': \'生物 ～妖精／斥候\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449890&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'096b026d-b492-4812-9c4e-60d0580a6ce3\', \'multiverseId\': 449890}, \'multiverseid\': 449890}, {\'name\': \'馭空巡偵員\', \'text\': \'飛行\\n在你回合的戰鬥開始時，你可以支付{G}{U}。當你如此作時，在另一個目標由你操控的生物上放置一個+1/+1指示物，且該生物獲得飛行異能直到回合結束。\', \'type\': \'生物 ～妖精／斥候\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450171&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8d08fea5-4aa1-4fc6-9338-2a1d1a2e33a2\', \'multiverseId\': 450171}, \'multiverseid\': 450171}]', '[{\'name\': \'Hochlandsee\', \'text\': \'Der Hochlandsee kommt getappt ins Spiel.\\n{T}: Erzeuge {U} oder {R}.\', \'type\': \'Land\', \'flavor\': \'„An Orten wie diesen frage ich mich oft, ob das Leben noch mehr zu bieten hat als nur Blut und Schätze … Ach, auch egal."\\n—Boyl Bocksalz, Sturmflotten-Matrose\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447670&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b851b69e-1acb-4ab8-990c-198fd854f048\', \'multiverseId\': 447670}, \'multiverseid\': 447670}, {\'name\': \'Lago de las tierras altas\', \'text\': \'El Lago de las tierras altas entra al campo de batalla girado.\\n{T}: Agrega {U} o {R}.\', \'type\': \'Tierra\', \'flavor\': \'"Un lugar así hace que me pregunte si hay algo más en la vida que la sangre y los tesoros... Bah, no".\\n—Boyl Cubosalado, lobo de mar de la Flota Tempestuosa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447951&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3191180e-6535-4d30-8519-d97b1b2db04a\', \'multiverseId\': 447951}, \'multiverseid\': 447951}, {\'name\': \'Lac des hautes terres\', \'text\': \'Le Lac des hautes terres arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {U} ou {R}.\', \'type\': \'Terrain\', \'flavor\': \'« Quand on voit un lieu tel que celui-ci, on se dit que la vie ne se limite pas au sang et aux trésors... Si, en fait. »\\n—Boyl Grindessel, mathurin de la Flotte de la tempête\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448232&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ac8f7903-a813-4c22-91d7-37c3d7f35ff8\', \'multiverseId\': 448232}, \'multiverseid\': 448232}, {\'name\': "Lago dell\'Altopiano", \'text\': "Il Lago dell\'Altopiano entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {U} o {R}.", \'type\': \'Terra\', \'flavor\': \'"Davanti a un posto del genere, mi chiedo se nella vita ci sia qualcosa di più che zuffe e bottini... Noo."\\n—Boyl Zucca Salata, mozzo della Flotta Fendiburrasca\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448513&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9b81ddab-21dd-4cb2-9a21-bbeda67390be\', \'multiverseId\': 448513}, \'multiverseid\': 448513}, {\'name\': \'高地の湖\', \'text\': \'高地の湖はタップ状態で戦場に出る。\\n{T}：{U}か{R}を加える。\', \'type\': \'土地\', \'flavor\': \'「こういう風景を見ると考えちまうんだよなぁ……、人生には血と宝物より大事なものがあるかも……。まぁ、ないな。」\\n――風雲艦隊の船方、ボイル・バックソルト\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448794&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dd01d401-9215-4f5c-8eb8-530d31e3597b\', \'multiverseId\': 448794}, \'multiverseid\': 448794}, {\'name\': \'산악 호수\', \'text\': \'산악 호수는 탭된 채로 전장에 들어온다.\\n{T}: {U} 또는 {R}를 추가한다.\', \'type\': \'대지\', \'flavor\': \'"이런 곳을 보고 있자니 피와 보물 말고도 인생에 무엇인가가 더 있을까 궁금해지는군 . . . 설마."\\n—스톰 선단 선원, 보일 벅솔트\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449075&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9623f0e7-d342-4131-a4de-7acb66ad166e\', \'multiverseId\': 449075}, \'multiverseid\': 449075}, {\'name\': \'Lago Montanhês\', \'text\': \'Lago Montanhês entra no campo de batalha virado.\\n{T}: Adicione {U} ou {R}.\', \'type\': \'Terreno\', \'flavor\': \'"Um lugar como esse faz com que eu me pergunte se a vida não é mais do que sangue e tesouros... Nah."\\n— Boyl Ferrassal, marinheiro da Frota da Tormenta\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449356&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'80a57a69-afdf-4bff-bc29-4ac778235865\', \'multiverseId\': 449356}, \'multiverseid\': 449356}, {\'name\': \'Горное Озеро\', \'text\': \'Горное Озеро выходит на поле битвы повернутым.\\n{T}: добавьте {U} или {R}.\', \'type\': \'Земля\', \'flavor\': \'«Такое место заставляет задуматься: а может быть, в жизни есть что-то еще, кроме кровопролития и сокровищ?.. Да нет, глупости».\\n— Бойл Баксолт, матрос Штормовой Флотилии\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449637&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f4e9d777-b8b2-4719-a492-7fc2d2d5fef9\', \'multiverseId\': 449637}, \'multiverseid\': 449637}, {\'name\': \'高地湖泊\', \'text\': \'高地湖泊须横置进战场。\\n{T}：加{U}或{R}。\', \'type\': \'地\', \'flavor\': \'「见此美景，不禁让我沉思生命中除了杀戮和寻宝之外是否该有其他元素. . .算了。」\\n～速腾舰队水手博依巴绍\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449918&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ef005859-68a6-48d4-ba8c-1b1c1b9d6758\', \'multiverseId\': 449918}, \'multiverseid\': 449918}, {\'name\': \'高地湖泊\', \'text\': \'高地湖泊須橫置進戰場。\\n{T}：加{U}或{R}。\', \'type\': \'地\', \'flavor\': \'「見此美景，不禁讓我沉思生命中除了殺戮和尋寶之外是否該有其他元素. . .算了。」\\n～速騰艦隊水手博依巴紹\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450199&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'cfe75979-b915-4183-88df-745973647e93\', \'multiverseId\': 450199}, \'multiverseid\': 450199}]', '[{\'name\': \'Hochlandwild\', \'text\': \'Wenn das Hochlandwild stirbt, erhältst du 2 Lebenspunkte dazu.\', \'type\': \'Kreatur — Hirsch\', \'flavor\': \'„Erlege einen Hirsch und kröne Arel mit seinen Hörnern. Sie hört das Flüstern unserer Ahnen."\\n—Chianul, Zweifach-Flüsterer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447605&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'debd2ea2-eae4-4775-ae18-926ba66f915e\', \'multiverseId\': 447605}, \'multiverseid\': 447605}, {\'name\': \'Presa de las tierras altas\', \'text\': \'Cuando la Presa de las tierras altas muera, ganas 2 vidas.\', \'type\': \'Criatura — Alce\', \'flavor\': \'"Abatan un ciervo y pónganle sus cuernos en la cabeza de Arel. Así escuchará la sabiduría de nuestros ancestros".\\n—Chianul, Doble susurro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447886&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b62eb3a9-62f1-431a-a1d5-376e6f10255f\', \'multiverseId\': 447886}, \'multiverseid\': 447886}, {\'name\': \'Gibier des hautes terres\', \'text\': \'Quand le Gibier des hautes terres meurt, vous gagnez 2 points de vie.\', \'type\': \'Créature : élan\', \'flavor\': "« Abats un cerf et fixe ses cornes sur la tête d\'Arel. Elle entend la sagesse de nos ancêtres. »\\n—Chëanul, le Passeur de murmures", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448167&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1ec3ff68-cd64-48c4-8ab3-687dda3e3184\', \'multiverseId\': 448167}, \'multiverseid\': 448167}, {\'name\': "Preda dell\'Altopiano", \'text\': "Quando la Preda dell\'Altopiano muore, guadagni 2 punti vita.", \'type\': \'Creatura — Alce\', \'flavor\': \'"Abbatti un cervo e poni le corna sulla testa di Arel. Riesce a udire la saggezza dei nostri antenati."\\n—Chianul, Duplice Sussurro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448448&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'81fb9658-b23b-4761-a4dd-b3a8eefb34cb\', \'multiverseId\': 448448}, \'multiverseid\': 448448}, {\'name\': \'高地の獲物\', \'text\': \'高地の獲物が死亡したとき、あなたは２点のライフを得る。\', \'type\': \'クリーチャー — 大鹿\', \'flavor\': \'「雄鹿をしとめて、その角をアレルの頭に固定せよ。彼女には先祖の英知が聞こえる。」\\n――二度囁く者、チアヌル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448729&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'26d2a8fa-6a8b-46b7-8cf9-82b18a833943\', \'multiverseId\': 448729}, \'multiverseid\': 448729}, {\'name\': \'고산지대 사냥감\', \'text\': \'고산지대 사냥감이 죽을 때, 당신은 생명 2점을 얻는다.\', \'type\': \'생물 — 엘크\', \'flavor\': \'"수사슴을 쓰러뜨리고 그 뿔을 아렐의 머리에 대라. 그녀는 우리의 선조의 지헤를 듣는다."\\n—두 번 속삭이는 자, 치아눌\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449010&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'04621eeb-879c-4d7b-aa2d-a5f0f339bfd4\', \'multiverseId\': 449010}, \'multiverseid\': 449010}, {\'name\': \'Caça do Planalto\', \'text\': \'Quando Caça do Planalto morre, você ganha 2 pontos de vida.\', \'type\': \'Criatura — Alce\', \'flavor\': \'"Abata um cervo e coloque os chifres na cabeça de Arel. Ela ouve a sabedoria de nossos ancestrais."\\n— Chianul, Sussurrador Duplo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449291&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d16215a1-c069-4487-874d-18966469a6ac\', \'multiverseId\': 449291}, \'multiverseid\': 449291}, {\'name\': \'Горная Дичь\', \'text\': \'Когда Горная Дичь умирает, вы получаете 2 жизни.\', \'type\': \'Существо — Вапити\', \'flavor\': \'«Забейте оленя и прикрепите рога к голове Арель. Она слышит мудрость наших предков».\\n— Чианул, Шепчущий Дважды\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449572&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4fe6f8fc-2a28-4a27-a8e5-cc37ffd4510a\', \'multiverseId\': 449572}, \'multiverseid\': 449572}, {\'name\': \'高地猎物\', \'text\': \'当高地猎物死去时，你获得2点生命。\', \'type\': \'生物 ～麋鹿\', \'flavor\': \'「猎杀一头雄鹿，把犄角绑在阿瑞尔头上。她能听见先祖的智慧。」\\n～通灵祭师恰努尔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449853&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'596c3e9e-d706-46fb-9ff5-4db0684b210d\', \'multiverseId\': 449853}, \'multiverseid\': 449853}, {\'name\': \'高地獵物\', \'text\': \'當高地獵物死去時，你獲得2點生命。\', \'type\': \'生物 ～麋鹿\', \'flavor\': \'「獵殺一頭雄鹿，把犄角綁在阿瑞爾頭上。她能聽見先祖的智慧。」\\n～通靈祭師恰努爾\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450134&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ebb05362-f4df-4e1d-b42e-65876a800ac6\', \'multiverseId\': 450134}, \'multiverseid\': 450134}]', '[{\'name\': \'Hornist der Miliz\', \'text\': \'Wachsamkeit (Diese Kreatur wird beim Angreifen nicht getappt.)\\nWenn der Hornist der Miliz ins Spiel kommt, schaue dir die obersten vier Karten deiner Bibliothek an. Du kannst davon eine Kreaturenkarte mit Stärke 2 oder weniger offen vorzeigen und auf deine Hand nehmen. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447446&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'64d4d023-4e12-48a2-a5d8-1b2841cc03bd\', \'multiverseId\': 447446}, \'multiverseid\': 447446}, {\'name\': \'Clarín de la milicia\', \'text\': \'Vigilancia. (Esta criatura no se gira al atacar.)\\nCuando el Clarín de la milicia entre al campo de batalla, mira las cuatro primeras cartas de tu biblioteca. Puedes mostrar una carta de criatura con fuerza de 2 o menos que se encuentre entre ellas y ponerla en tu mano. Pon el resto en el fondo de tu biblioteca en un orden aleatorio.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447727&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cd366950-0eb6-491e-bd12-713ddf617a23\', \'multiverseId\': 447727}, \'multiverseid\': 447727}, {\'name\': \'Sonneur de la milice\', \'text\': "Vigilance (Attaquer avec cette créature ne la fait pas s\'engager.)\\nQuand le Sonneur de la milice arrive sur le champ de bataille, regardez les quatre cartes du dessus de votre bibliothèque. Vous pouvez révéler une carte de créature de force inférieure ou égale à 2 parmi elles et la mettre dans votre main. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.", \'type\': \'Créature : humain et soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448008&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'565b9858-486a-4b6f-be4b-4eec96325404\', \'multiverseId\': 448008}, \'multiverseid\': 448008}, {\'name\': \'Trombettiere della Milizia\', \'text\': \'Cautela (Questa creatura attacca senza TAPpare.)\\nQuando il Trombettiere della Milizia entra nel campo di battaglia, guarda le prime quattro carte del tuo grimorio. Puoi rivelare una carta creatura con forza pari o inferiore a 2 scelta tra esse e aggiungerla alla tua mano. Metti le altre in fondo al tuo grimorio in ordine casuale.\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448289&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b59ca82f-ab72-40be-9e35-aeabb0f22c43\', \'multiverseId\': 448289}, \'multiverseid\': 448289}, {\'name\': \'民兵のラッパ手\', \'text\': \'警戒（このクリーチャーは攻撃してもタップしない。）\\n民兵のラッパ手が戦場に出たとき、あなたのライブラリーの一番上からカードを４枚見る。あなたはその中からパワーが２以下のクリーチャー・カード１枚を公開してあなたの手札に加えてもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448570&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5bd98eef-9a02-48d2-bf14-5abbf271be27\', \'multiverseId\': 448570}, \'multiverseid\': 448570}, {\'name\': \'민병대 나팔수\', \'text\': \'경계 (이 생물은 공격하면서 탭되지 않는다.)\\n민병대 나팔수가 전장에 들어올 때, 당신의 서고 맨 위 카드 네 장을 본다. 당신은 그중에서 공격력이 2 이하인 생물 카드 한 장을 공개하고 당신의 손으로 가져갈 수 있다. 나머지 카드들은 무작위 순서로 당신의 서고 맨 밑에 놓는다.\', \'type\': \'생물 — 인간 병사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448851&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e0351f4e-49bc-462b-8105-d713d6de3ac5\', \'multiverseId\': 448851}, \'multiverseid\': 448851}, {\'name\': \'Corneteiro da Milícia\', \'text\': \'Vigilância (Esta criatura não é virada para atacar.)\\nQuando Corneteiro da Milícia entrar no campo de batalha, olhe os quatro cards do topo de seu grimório. Você pode revelar um card de criatura com poder igual ou inferior a 2 dentre eles e colocá-lo em sua mão. Coloque o restante no fundo de seu grimório em ordem aleatória.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449132&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4b54636a-d583-4676-9664-058e3ec05580\', \'multiverseId\': 449132}, \'multiverseid\': 449132}, {\'name\': \'Сигнальщик Ополчения\', \'text\': \'Бдительность (Атакуя, это существо не поворачивается.)\\nКогда Сигнальщик Ополчения выходит на поле битвы, посмотрите четыре верхние карты вашей библиотеки. Вы можете показать находящуюся среди них карту существа с силой 2 или меньше и положить ее в вашу руку. Положите остальные карты в низ вашей библиотеки в случайном порядке.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449413&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1f85ee5a-3f87-475a-bd69-57d07200b153\', \'multiverseId\': 449413}, \'multiverseid\': 449413}, {\'name\': \'司号民兵\', \'text\': \'警戒（此生物攻击时不需横置。）\\n当司号民兵进战场时，检视你牌库顶的四张牌。你可以展示其中的一张力量等于或小于2的生物牌，并将它置于你手上。将其余的牌以随机顺序置于你的牌库底。\', \'type\': \'生物 ～人类／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449694&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b6019e06-15ed-4972-9ddf-74e4b02d7b90\', \'multiverseId\': 449694}, \'multiverseid\': 449694}, {\'name\': \'司號民兵\', \'text\': \'警戒（此生物攻擊時不需橫置。）\\n當司號民兵進戰場時，檢視你牌庫頂的四張牌。你可以展示其中的一張力量等於或小於2的生物牌，並將它置於你手上。將其餘的牌以隨機順序置於你的牌庫底。\', \'type\': \'生物 ～人類／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449975&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'aa32d808-6117-47fc-8cb8-a42c4a2f4b94\', \'multiverseId\': 449975}, \'multiverseid\': 449975}]', '[{\'name\': \'Hort des Drachen\', \'text\': \'Immer wenn ein Drache unter deiner Kontrolle ins Spiel kommt, lege eine Goldmarke auf den Hort des Drachen.\\n{T}, entferne eine Goldmarke vom Hort des Drachen: Ziehe eine Karte.\\n{T}: Erzeuge ein Mana einer beliebigen Farbe.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447650&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ce8acf7f-e151-4d5e-8b8a-ee21e0990269\', \'multiverseId\': 447650}, \'multiverseid\': 447650}, {\'name\': \'Botín del dragón\', \'text\': \'Siempre que un Dragón entre al campo de batalla bajo tu control, pon un contador de oro sobre el Botín del dragón.\\n{T}, remover un contador de oro del Botín del dragón: Roba una carta.\\n{T}: Agrega un maná de cualquier color.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447931&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b2517ffb-3d5e-4d29-ad57-d3286e42e0eb\', \'multiverseId\': 447931}, \'multiverseid\': 447931}, {\'name\': \'Butin du dragon\', \'text\': "À chaque fois qu\'un dragon arrive sur le champ de bataille sous votre contrôle, mettez un marqueur « or » sur le Butin du dragon.\\n{T}, retirez un marqueur « or » du Butin du dragon : Piochez une carte.\\n{T} : Ajoutez un mana de la couleur de votre choix.", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448212&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'94cd823c-61e5-4331-ab38-87c9b2131729\', \'multiverseId\': 448212}, \'multiverseid\': 448212}, {\'name\': \'Bottino del Drago\', \'text\': \'Ogniqualvolta un Drago entra nel campo di battaglia sotto il tuo controllo, metti un segnalino oro sul Bottino del Drago.\\n{T}, Rimuovi un segnalino oro dal Bottino del Drago: Pesca una carta.\\n{T}: Aggiungi un mana di un qualsiasi colore.\', \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448493&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'af27c69b-edf1-4379-aeb3-c90db6493825\', \'multiverseId\': 448493}, \'multiverseid\': 448493}, {\'name\': \'ドラゴンの財宝\', \'text\': \'ドラゴンが１体あなたのコントロール下で戦場に出るたび、ドラゴンの財宝の上に黄金カウンターを１個置く。\\n{T}, ドラゴンの財宝の上から黄金カウンターを１個取り除く：カードを１枚引く。\\n{T}：好きな色１色のマナ１点を加える。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448774&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1f2f988f-728e-4ec4-a096-b49b46287d53\', \'multiverseId\': 448774}, \'multiverseid\': 448774}, {\'name\': \'용의 보물창고\', \'text\': \'용이 당신의 조종하에 전장에 들어올 때마다, 용의 보물창고에 금 카운터 한 개를 올려놓는다.\\n{T}, 용의 보물창고에서 금 카운터 한 개를 제거한다: 카드 한 장을 뽑는다.\\n{T}: 원하는 색의 마나 한 개를 추가한다.\', \'type\': \'마법물체\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449055&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'88a89fb0-f39f-4540-8fa9-b925fff2b405\', \'multiverseId\': 449055}, \'multiverseid\': 449055}, {\'name\': \'Tesouro do Dragão\', \'text\': \'Toda vez que um Dragão entrar no campo de batalha sob o seu controle, coloque um marcador de ouro em Tesouro do Dragão.\\n{T}, remova um marcador de ouro de Tesouro do Dragão: Compre um card.\\n{T}: Adicione um mana de qualquer cor.\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449336&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'13182e2f-bbe0-462d-8f32-fba14d18a429\', \'multiverseId\': 449336}, \'multiverseid\': 449336}, {\'name\': \'Сокровища Дракона\', \'text\': \'Каждый раз, когда Дракон выходит на поле битвы под вашим контролем, положите один жетон золота на Сокровища Дракона.\\n{T}, удалите один жетон золота с Сокровищ Дракона: возьмите карту.\\n{T}: добавьте одну ману любого цвета.\', \'type\': \'Артефакт\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449617&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'96927b33-eff2-4d5f-ac79-3a23d00758aa\', \'multiverseId\': 449617}, \'multiverseid\': 449617}, {\'name\': \'巨龙宝库\', \'text\': \'每当一个龙在你的操控下进战场时，在巨龙宝库上放置一个黄金指示物。\\n{T}，从巨龙宝库上移去一个黄金指示物：抓一张牌。\\n{T}：加一点任意颜色的法术力。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449898&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fe8773d7-47e7-4504-bbcc-e3a5fb6d795d\', \'multiverseId\': 449898}, \'multiverseid\': 449898}, {\'name\': \'巨龍寶庫\', \'text\': \'每當一個龍在你的操控下進戰場時，在巨龍寶庫上放置一個黃金指示物。\\n{T}，從巨龍寶庫上移去一個黃金指示物：抽一張牌。\\n{T}：加一點任意顏色的魔法力。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450179&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'faa2d451-df6f-4531-a874-f1df9f4661c4\', \'multiverseId\': 450179}, \'multiverseid\': 450179}]', '[{\'name\': \'Höllische Narben\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur erhält +2/+0 und hat „Wenn diese Kreatur stirbt, ziehe eine Karte."\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Derjenige, der im Leben von einem Dämon gezeichnet wird, bleibt nach seinem Tode als Dämon in Erinnerung.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447520&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'21c16563-cdeb-4285-8b3a-00d4d87c84f7\', \'multiverseId\': 447520}, \'multiverseid\': 447520}, {\'name\': \'Cicatrices infernales\', \'text\': \'Encantar criatura.\\nLa criatura encantada obtiene +2/+0 y tiene "Cuando esta criatura muera, roba una carta".\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'Quien queda marcado por un demonio en vida será recordado como uno de ellos en la muerte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447801&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4f734a0c-bffb-4e00-9995-308f7ac9e022\', \'multiverseId\': 447801}, \'multiverseid\': 447801}, {\'name\': \'Scarification infernale\', \'text\': \'Enchanter : créature\\nLa créature enchantée gagne +2/+0 et a « Quand cette créature meurt, piochez une carte ».\', \'type\': \'Enchantement : aura\', \'flavor\': \'Qui est marqué de son vivant par un démon sera considéré comme tel après sa mort.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448082&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'01448925-9d68-4b1c-86eb-a78ede059d5f\', \'multiverseId\': 448082}, \'multiverseid\': 448082}, {\'name\': \'Sfregio Infernale\', \'text\': \'Incanta creatura\\nLa creatura incantata prende +2/+0 e ha "Quando questa creatura muore, pesca una carta".\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'Chi è marchiato da un demone in vita certamente sarà ricordato come tale nella morte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448363&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2f02d130-0b78-4d7a-ac96-3d507eb08529\', \'multiverseId\': 448363}, \'multiverseid\': 448363}, {\'name\': \'冥府の傷跡\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは＋２/＋０の修整を受け、「このクリーチャーが死亡したとき、カードを１枚引く。」を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'悪魔によって印を受けた生ある者は、死んだ者として記憶されるだろう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448644&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a1cbff55-41dd-424e-95db-06df3fbb7b56\', \'multiverseId\': 448644}, \'multiverseid\': 448644}, {\'name\': \'지옥에서 입은 흉터\', \'text\': \'생물에게 부여\\n부여된 생물은 +2/+0을 받고 "이 생물이 죽을 때, 카드 한 장을 뽑는다."를 가진다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'생전에 악마에게 낙인 찍힌 자는 죽어서도 그 오명을 씻을 수 없다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448925&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a0a8c1f3-71a4-4797-a035-1aad3ca66753\', \'multiverseId\': 448925}, \'multiverseid\': 448925}, {\'name\': \'Escarificação Infernal\', \'text\': \'Encantar criatura\\nA criatura encantada recebe +2/+0 e tem "Quando esta criatura morrer, compre um card."\', \'type\': \'Encantamento — Aura\', \'flavor\': \'Aquele que é marcado por um demônio em vida, certamente será lembrado como um na morte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449206&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ee38fca7-65e9-4798-9941-5ead9e2f3481\', \'multiverseId\': 449206}, \'multiverseid\': 449206}, {\'name\': \'Шрамы Преисподней\', \'text\': \'Зачаровать существо\\nЗачарованное существо получает +2/+0 и имеет способность «Когда это существо умирает, возьмите карту».\', \'type\': \'Чары — Аура\', \'flavor\': \'Того, кого демон отметил при жизни, запомнят таким и после смерти.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449487&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1abd7baa-cb73-434e-adf8-13f937693e41\', \'multiverseId\': 449487}, \'multiverseid\': 449487}, {\'name\': \'炼狱留痕\', \'text\': \'结附于生物\\n所结附的生物得+2/+0且具有「当此生物死去时，抓一张牌。」\', \'type\': \'结界 ～灵气\', \'flavor\': \'生前得恶魔印记者，死后亦被以恶魔相待。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449768&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b560a990-43f4-4ed0-a23c-95a35401f6ca\', \'multiverseId\': 449768}, \'multiverseid\': 449768}, {\'name\': \'獄境留痕\', \'text\': \'結附於生物\\n所結附的生物得+2/+0且具有「當此生物死去時，抽一張牌。」\', \'type\': \'結界 ～靈氣\', \'flavor\': \'生前得惡魔印記者，死後亦被以惡魔相待。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450049&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a45d5014-39be-4d83-9111-bf4c4457d0a8\', \'multiverseId\': 450049}, \'multiverseid\': 450049}]', '[{\'name\': \'Infektiöser Schrecken\', \'text\': \'Immer wenn der Infektiöse Schrecken angreift, verliert jeder Gegner 2 Lebenspunkte.\', \'type\': \'Kreatur — Zombie, Schrecken\', \'flavor\': \'In der gesamten Geschichte von Grixis ist noch nie jemand an Altersschwäche gestorben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447518&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dd663725-5b70-4415-b3fd-a054feca10f0\', \'multiverseId\': 447518}, \'multiverseid\': 447518}, {\'name\': \'Horror infeccioso\', \'text\': \'Siempre que el Horror infeccioso ataque, cada oponente pierde 2 vidas.\', \'type\': \'Criatura — Horror zombie\', \'flavor\': \'En la historia de Grixis, nadie ha muerto nunca por simple vejez.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447799&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b57e993d-f067-4901-9bbe-5317ca0b5365\', \'multiverseId\': 447799}, \'multiverseid\': 447799}, {\'name\': \'Horreur infectieuse\', \'text\': "À chaque fois que l\'Horreur infectieuse attaque, chaque adversaire perd 2 points de vie.", \'type\': \'Créature : zombie et horreur\', \'flavor\': "Dans toute l\'histoire de Grixis, jamais personne n\'est mort de vieillesse.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448080&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3c079adc-5901-478a-b8c4-25422bf7c227\', \'multiverseId\': 448080}, \'multiverseid\': 448080}, {\'name\': \'Orrore Infetto\', \'text\': "Ogniqualvolta l\'Orrore Infetto attacca, ogni avversario perde 2 punti vita.", \'type\': \'Creatura — Orrore Zombie\', \'flavor\': \'In tutta la storia di Grixis, mai nessuno è morto di vecchiaia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448361&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'82841781-7c6c-4a60-b2cc-f416e6747b57\', \'multiverseId\': 448361}, \'multiverseid\': 448361}, {\'name\': \'感染性の恐怖\', \'text\': \'感染性の恐怖が攻撃するたび、各対戦相手はそれぞれ２点のライフを失う。\', \'type\': \'クリーチャー — ゾンビ・ホラー\', \'flavor\': \'グリクシスの歴史の中で、誰かが老衰で死んだことなど一度も無い。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448642&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'239bc7ea-8fde-4ff0-aac0-cd21d9eb4771\', \'multiverseId\': 448642}, \'multiverseid\': 448642}, {\'name\': \'전염성 괴수\', \'text\': \'전염성 괴수가 공격할 때마다, 각 상대는 생명 2점을 잃는다.\', \'type\': \'생물 — 좀비 괴수\', \'flavor\': \'그릭시스의 역사에 늙어서 죽은 이는 하나도 없다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448923&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'43c75369-77d7-49d2-92b0-688de3a2b3cf\', \'multiverseId\': 448923}, \'multiverseid\': 448923}, {\'name\': \'Horror Infeccioso\', \'text\': \'Toda vez que Horror Infeccioso ataca, cada oponente perde 2 pontos de vida.\', \'type\': \'Criatura — Zumbi Horror\', \'flavor\': \'Jamais na história de Grixis alguém morreu de velhice.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449204&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8d0b5b8c-12b7-4c26-9193-0860ad2599fd\', \'multiverseId\': 449204}, \'multiverseid\': 449204}, {\'name\': \'Заразный Ужас\', \'text\': \'Каждый раз, когда Заразный Ужас атакует, каждый оппонент теряет 2 жизни.\', \'type\': \'Существо — Зомби Ужас\', \'flavor\': \'Во всей истории Гриксиса нет никого, кто умер бы от старости.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449485&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b9e0d37f-235b-41ff-b217-09f8de721d77\', \'multiverseId\': 449485}, \'multiverseid\': 449485}, {\'name\': \'播疫惊惧兽\', \'text\': \'每当播疫惊惧兽攻击时，每位对手各失去2点生命。\', \'type\': \'生物 ～灵俑／惊惧兽\', \'flavor\': \'有史以来，格利极从没人因衰老而过世。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449766&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'585e11b3-c9ec-425c-880c-527847904e26\', \'multiverseId\': 449766}, \'multiverseid\': 449766}, {\'name\': \'播疫驚懼獸\', \'text\': \'每當播疫驚懼獸攻擊時，每位對手各失去2點生命。\', \'type\': \'生物 ～殭屍／驚懼獸\', \'flavor\': \'有史以來，格利極從沒人因衰老而過世。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450047&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ba5b2aa3-7d59-476f-a846-ed76407b930e\', \'multiverseId\': 450047}, \'multiverseid\': 450047}]', '[{\'name\': \'Inferno-Teufelsbraten\', \'text\': \'Verursacht Trampelschaden (Diese Kreatur kann beim Angreifen überschüssigen Kampfschaden dem verteidigenden Spieler oder Planeswalker zufügen.)\\nZu Beginn jedes Endsegments und falls der Inferno-Teufelsbraten in diesem Zug angegriffen oder geblockt hat, mischt sein Besitzer ihn in seine Bibliothek.\', \'type\': \'Kreatur — Teufelsbraten\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447565&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'da9412bf-4200-4887-a542-5ad907757338\', \'multiverseId\': 447565}, \'multiverseid\': 447565}, {\'name\': \'Infernal del averno\', \'text\': \'Arrolla. (Esta criatura puede hacer el daño de combate sobrante al jugador o planeswalker al que ataca.)\\nAl comienzo de cada paso final, si el Infernal del averno atacó o bloqueó este turno, su propietario lo baraja en su biblioteca.\', \'type\': \'Criatura — Infernal\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447846&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'332cd12c-25aa-4b61-a4db-d2362940f576\', \'multiverseId\': 447846}, \'multiverseid\': 447846}, {\'name\': \'Monstruosité de la fournaise\', \'text\': "Piétinement (Cette créature peut infliger son surplus de blessures de combat au joueur ou au planeswalker qu\'elle attaque.)\\nAu début de chaque étape de fin, si la Monstruosité de la fournaise a attaqué ou bloqué ce tour-ci, son propriétaire la mélange dans sa bibliothèque.", \'type\': \'Créature : monstruosité\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448127&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d91abd97-1526-4974-907d-ab68b4146142\', \'multiverseId\': 448127}, \'multiverseid\': 448127}, {\'name\': \'Infernale delle Lingue di Fuoco\', \'text\': "Travolgere (Questa creatura può infliggere il danno da combattimento in eccesso al giocatore o al planeswalker che sta attaccando.)\\nAll\'inizio di ogni sottofase finale, se l\'Infernale delle Lingue di Fuoco ha attaccato o bloccato in questo turno, il suo proprietario lo rimescola nel proprio grimorio.", \'type\': \'Creatura — Infernale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448408&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7ed2c65b-8e2b-4aa1-a3d0-fbfcaab306e0\', \'multiverseId\': 448408}, \'multiverseid\': 448408}, {\'name\': \'業火のヘリオン\', \'text\': \'トランプル（このクリーチャーは余剰の戦闘ダメージをこれが攻撃しているプレイヤーかプレインズウォーカーに与えることができる。）\\n各終了ステップの開始時に、このターン業火のヘリオンが攻撃したかブロックしていた場合、これのオーナーはこれを自分のライブラリーに加えて切り直す。\', \'type\': \'クリーチャー — ヘリオン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448689&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a3da3737-7846-484a-9903-f6ca78baa728\', \'multiverseId\': 448689}, \'multiverseid\': 448689}, {\'name\': \'지옥불 헬리온\', \'text\': \'돌진 (이 생물은 여분의 전투피해를 공격 중인 플레이어 또는 플레인즈워커에게 입힐 수 있다.)\\n각 종료단 시작에, 지옥불 헬리온이 이 턴에 공격했거나 방어했다면, 지옥불 헬리온의 소유자는 지옥불 헬리온을 자신의 서고에 섞어넣는다.\', \'type\': \'생물 — 헬리온\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448970&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'114e885f-13a4-4c35-831b-b4d6f554f835\', \'multiverseId\': 448970}, \'multiverseid\': 448970}, {\'name\': \'Avernal do Inferno\', \'text\': \'Atropelar (Esta criatura pode causar seu dano de combate excedente ao jogador ou planeswalker que ela estiver atacando.)\\nNo início de cada etapa final, se Avernal do Inferno atacou ou bloqueou neste turno, seu dono o embaralha no próprio grimório.\', \'type\': \'Criatura — Avernal\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449251&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7e8da565-f6ca-455e-832e-4cb23d60f525\', \'multiverseId\': 449251}, \'multiverseid\': 449251}, {\'name\': \'Геллион Преисподней\', \'text\': \'Пробивной удар (Это существо может нанести избыточные боевые повреждения игроку или planeswalker-у, которого атакует.)\\nВ начале каждого заключительного шага, если Геллион Преисподней атаковал или блокировал в этом ходу, то его владелец втасовывает его в свою библиотеку.\', \'type\': \'Существо — Геллион\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449532&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9ba516b3-3ae0-49f0-8ae3-21d13646e152\', \'multiverseId\': 449532}, \'multiverseid\': 449532}, {\'name\': \'业火地狱兽\', \'text\': \'践踏（此生物造成之过量战斗伤害能对所攻击的牌手或鹏洛客造成之。）\\n在每个结束步骤开始时，若业火地狱兽本回合曾进行攻击或阻挡，则其拥有者将它洗入其牌库。\', \'type\': \'生物 ～地狱兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449813&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c156d8da-cec9-4ec4-9ca5-00688f43ea26\', \'multiverseId\': 449813}, \'multiverseid\': 449813}, {\'name\': \'業火地獄獸\', \'text\': \'踐踏（此生物造成之過量戰鬥傷害能對所攻擊的玩家或鵬洛客造成之。）\\n在每個結束步驟開始時，若業火地獄獸本回合曾進行攻擊或阻擋，則其擁有者將它洗入其牌庫。\', \'type\': \'生物 ～地獄獸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450094&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0857a2bd-47e2-4299-9d3f-c8497ac5688a\', \'multiverseId\': 450094}, \'multiverseid\': 450094}]', '[{\'name\': \'Ins Gedächtnis zurückrufen\', \'text\': \'Bringe eine Karte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Hexerei\', \'flavor\': \'„Die Knochen werden dir ihre Geschichte erzählen … wenn du ihre Sprache sprichst."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447614&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'23e27597-644d-4faf-9ed8-67bdd1732a98\', \'multiverseId\': 447614}, \'multiverseid\': 447614}, {\'name\': \'Recordar\', \'text\': \'Regresa la carta objetivo de tu cementerio a tu mano.\', \'type\': \'Conjuro\', \'flavor\': \'"Los huesos del pasado nos contarán sus historias... si hablas su lengua".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447895&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'267be552-ff6a-42c2-8829-6d9f4ca015a7\', \'multiverseId\': 447895}, \'multiverseid\': 447895}, {\'name\': \'Souvenance\', \'text\': \'Renvoyez une carte ciblée depuis votre cimetière dans votre main.\', \'type\': \'Rituel\', \'flavor\': \'« Les os du passé vous raconteront leur histoire — si vous savez parler leur langage. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448176&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e20be466-a69d-40d2-855e-0d9cea0931a6\', \'multiverseId\': 448176}, \'multiverseid\': 448176}, {\'name\': \'Rammentare\', \'text\': \'Riprendi in mano una carta bersaglio dal tuo cimitero.\', \'type\': \'Stregoneria\', \'flavor\': \'"Le ossa del passato raccontano le loro storie: se sai come parlare la loro lingua."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448457&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b9f8044d-f8f1-4ca0-a776-da2664b27d91\', \'multiverseId\': 448457}, \'multiverseid\': 448457}, {\'name\': \'喚起\', \'text\': \'あなたの墓地からカード１枚を対象とし、それをあなたの手札に戻す。\', \'type\': \'ソーサリー\', \'flavor\': \'「骨は彼らの過去を語ってくれる。言葉を理解できるのならね。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448738&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'180ca5fd-eef0-4ee4-9611-083d30ce488c\', \'multiverseId\': 448738}, \'multiverseid\': 448738}, {\'name\': \'재수집\', \'text\': \'당신의 무덤에 있는 카드를 목표로 정한다. 그 카드를 당신의 손으로 되돌린다.\', \'type\': \'집중마법\', \'flavor\': \'"과거의 뼈들은 자신들의 이야기를 해 줄 것이다—그들의 언어를 말하는 방법만 알면 말이다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449019&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'dfbc4267-7f9f-4e3e-8fae-a4e0d5f6496c\', \'multiverseId\': 449019}, \'multiverseid\': 449019}, {\'name\': \'Recordar\', \'text\': \'Devolva o card alvo de seu cemitério para sua mão.\', \'type\': \'Feitiço\', \'flavor\': \'"Os ossos do passado contarão as próprias histórias — se você souber a língua deles."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449300&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'47493e8a-89c4-4beb-a944-d326d4b9e1b6\', \'multiverseId\': 449300}, \'multiverseid\': 449300}, {\'name\': \'Припоминание\', \'text\': \'Верните целевую карту из вашего кладбища в вашу руку.\', \'type\': \'Волшебство\', \'flavor\': \'«Кости прошлого расскажут свои истории — если ты умеешь говорить на их языке».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449581&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c9a1af28-d955-48b7-9988-68c116f94fce\', \'multiverseId\': 449581}, \'multiverseid\': 449581}, {\'name\': \'重拾记忆\', \'text\': \'将目标牌从你的坟墓场移回你手上。\', \'type\': \'法术\', \'flavor\': \'「逝者的骨骸会诉说他们的故事～只要你了解他们的语言。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449862&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'931117d4-898e-4357-a492-a5a2201f9dd1\', \'multiverseId\': 449862}, \'multiverseid\': 449862}, {\'name\': \'重拾記憶\', \'text\': \'將目標牌從你的墳墓場移回你手上。\', \'type\': \'巫術\', \'flavor\': \'「逝者的骨骸會訴說他們的故事～只要你了解他們的語言。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450143&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b41eceef-0c6d-41a9-8a7b-3d1a16435b09\', \'multiverseId\': 450143}, \'multiverseid\': 450143}]', "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447683&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a7cb4b90-00b9-4cf7-b237-909ff6feacd9', 'multiverseId': 447683}, 'multiverseid': 447683}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447964&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '673f8453-3acb-4aab-a0b6-ff2e54c6d74d', 'multiverseId': 447964}, 'multiverseid': 447964}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448245&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2eb3fd0d-953e-4608-89f9-e9d9c638cab5', 'multiverseId': 448245}, 'multiverseid': 448245}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448526&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '1891f2d7-14b9-4977-9b1c-64049175d9ea', 'multiverseId': 448526}, 'multiverseid': 448526}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448807&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f0a3d2d9-6fce-441b-a9f5-a7d920b10ac1', 'multiverseId': 448807}, 'multiverseid': 448807}, {'name': '섬', 'type': '기본 대지 — 섬', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449088&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '8714de69-8521-4fe0-9142-337ce2d1fafd', 'multiverseId': 449088}, 'multiverseid': 449088}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449369&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '855f505f-2b89-4b0f-be14-9170b5ad8992', 'multiverseId': 449369}, 'multiverseid': 449369}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449650&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '03722c17-fd86-4c5b-a4ea-9e2d95029e5e', 'multiverseId': 449650}, 'multiverseid': 449650}, {'name': '海岛', 'type': '基本地 ～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449931&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '0cfdf064-7d5d-4388-9dba-e9384b1dc808', 'multiverseId': 449931}, 'multiverseid': 449931}, {'name': '海島', 'type': '基本地 ～海島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450212&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '1dff3ae9-3f00-4289-815c-bbafacbf9198', 'multiverseId': 450212}, 'multiverseid': 450212}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447684&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b3c49038-035d-4fd1-af84-7a80de73e6aa', 'multiverseId': 447684}, 'multiverseid': 447684}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447965&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c0c6ee95-49dc-4b16-bbee-b65a4cbd144c', 'multiverseId': 447965}, 'multiverseid': 447965}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448246&type=card', 'language': 'French', 'identifiers': {'scryfallId': '524874df-523c-4200-b208-9592161f1da9', 'multiverseId': 448246}, 'multiverseid': 448246}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448527&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c469fc98-9378-4949-ad5e-066b6834633b', 'multiverseId': 448527}, 'multiverseid': 448527}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448808&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'fbe63302-85c0-4916-9a20-01fe59ce26df', 'multiverseId': 448808}, 'multiverseid': 448808}, {'name': '섬', 'type': '기본 대지 — 섬', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449089&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'c590504d-2fa8-4cec-891d-0cc9c148decf', 'multiverseId': 449089}, 'multiverseid': 449089}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449370&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5a46bdb7-2fbd-4fc8-bc2c-0d7951b848ee', 'multiverseId': 449370}, 'multiverseid': 449370}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449651&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '75a9fedd-f1a1-4517-aa93-68e73c341b03', 'multiverseId': 449651}, 'multiverseid': 449651}, {'name': '海岛', 'type': '基本地 ～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449932&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '8d3e285f-ae77-4159-8156-6dc9852e24ec', 'multiverseId': 449932}, 'multiverseid': 449932}, {'name': '海島', 'type': '基本地 ～海島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450213&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'ded56098-15b9-43ef-b895-6beaa8f7c77d', 'multiverseId': 450213}, 'multiverseid': 450213}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447685&type=card', 'language': 'German', 'identifiers': {'scryfallId': '9ec20a8e-654e-4513-8304-3d9c01ab8889', 'multiverseId': 447685}, 'multiverseid': 447685}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447966&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '56f8e4d1-ba7a-40b6-b091-9d2640567a95', 'multiverseId': 447966}, 'multiverseid': 447966}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448247&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'f9f6a345-2328-4960-b9b0-ff3ddcf9ce5a', 'multiverseId': 448247}, 'multiverseid': 448247}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448528&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '8430415c-a152-49da-8c42-8830f52d4f9c', 'multiverseId': 448528}, 'multiverseid': 448528}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448809&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'c8f2b28a-aed6-4b9c-8bc5-a9142c3b68e7', 'multiverseId': 448809}, 'multiverseid': 448809}, {'name': '섬', 'type': '기본 대지 — 섬', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449090&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '47e58a50-a798-4080-a49b-67baea10d913', 'multiverseId': 449090}, 'multiverseid': 449090}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449371&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '78edb7e4-2838-4055-b13d-631da31eebb1', 'multiverseId': 449371}, 'multiverseid': 449371}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449652&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'd8ec8292-5417-44d4-82e1-522c447ae87b', 'multiverseId': 449652}, 'multiverseid': 449652}, {'name': '海岛', 'type': '基本地 ～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449933&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '75b7bc30-c719-4cf0-ad76-f2832aca6015', 'multiverseId': 449933}, 'multiverseid': 449933}, {'name': '海島', 'type': '基本地 ～海島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450214&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '74710f08-aa23-4bed-8fe5-9b09d0e52707', 'multiverseId': 450214}, 'multiverseid': 450214}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447686&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'cd6cd960-fa23-46c7-934a-ac648c2d31f1', 'multiverseId': 447686}, 'multiverseid': 447686}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447967&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '80b2e7a5-fc86-48fb-b68f-723feb4a6d0c', 'multiverseId': 447967}, 'multiverseid': 447967}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448248&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2bbbb24a-cec1-45ef-81bb-3e0d348f3ddd', 'multiverseId': 448248}, 'multiverseid': 448248}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448529&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '99ec7e5a-929c-49e9-9f86-349f453ec3b6', 'multiverseId': 448529}, 'multiverseid': 448529}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448810&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'e411b968-8131-43f7-8862-b121ba5fb534', 'multiverseId': 448810}, 'multiverseid': 448810}, {'name': '섬', 'type': '기본 대지 — 섬', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449091&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'bd66a669-77b2-41aa-bd58-1422ff525318', 'multiverseId': 449091}, 'multiverseid': 449091}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449372&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8147ae0c-3a59-47a1-b624-2df0b9177c93', 'multiverseId': 449372}, 'multiverseid': 449372}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449653&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'cea52528-df75-4b6a-bcd3-a6a56aed4d63', 'multiverseId': 449653}, 'multiverseid': 449653}, {'name': '海岛', 'type': '基本地 ～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449934&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'e3facb4e-33ce-49ed-b61d-e657abff0a1b', 'multiverseId': 449934}, 'multiverseid': 449934}, {'name': '海島', 'type': '基本地 ～海島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450215&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '0c8e318d-a49b-4fb9-87b1-172c4fd5f692', 'multiverseId': 450215}, 'multiverseid': 450215}]", '[{\'name\': \'Inspirierter Ansturm\', \'text\': \'Kreaturen, die du kontrollierst, erhalten +2/+1 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Unmöglich! Wie konnten sie uns überrennen? Wir hatten Barrikaden, Kriegselefanten ... und auf jeden von ihnen kamen zehn von uns!"\\n—General Avitora\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447432&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'05921fdb-d2a3-45f1-aef4-9239aa3c524d\', \'multiverseId\': 447432}, \'multiverseid\': 447432}, {\'name\': \'Carga inspirada\', \'text\': \'Las criaturas que controlas obtienen +2/+1 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"¡Imposible! ¿Cómo pudieron vencernos? Teníamos barricadas, elefantes… ¡y ellos eran diez veces menos que nosotros!".\\n—General Avitora\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447713&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a4d1419f-8488-4d2c-be77-2c5530b34bca\', \'multiverseId\': 447713}, \'multiverseid\': 447713}, {\'name\': \'Charge inspirée\', \'text\': "Les créatures que vous contrôlez gagnent +2/+1 jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': \'« Impossible ! Comment ont-ils réussi à nous submerger ? Nous avions des barricades, des éléphants de guerre... et ils avaient à peine un dixième de nos troupes ! »\\n—Général Avitora\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447994&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0b72b4ba-fc51-4854-89bc-6a866b1791d2\', \'multiverseId\': 447994}, \'multiverseid\': 447994}, {\'name\': \'Carica Ispirata\', \'text\': \'Le creature che controlli prendono +2/+1 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Impossibile! Come possono averci sbaragliato? Avevamo barricate, elefanti da guerra... ed erano appena un decimo di noi!"\\n—Generale Avitora\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448275&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'99523cf8-02b3-4c1d-a882-8883100d3e8f\', \'multiverseId\': 448275}, \'multiverseid\': 448275}, {\'name\': \'鼓舞する突撃\', \'text\': \'ターン終了時まで、あなたがコントロールしているクリーチャーは＋２/＋１の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'「ありえぬ！なぜ我々を蹂躙しえたのだ？防壁も象も用意していたのに……。しかも、奴らは我々の十分の一しかいなかったのだぞ！」\\n――アヴィトーラ将軍\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448556&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'59e70396-7c6c-41c5-abf6-6d4173c7d7ac\', \'multiverseId\': 448556}, \'multiverseid\': 448556}, {\'name\': \'영감을 얻은 돌진\', \'text\': \'당신이 조종하는 생물들은 턴종료까지 +2/+1을 받는다.\', \'type\': \'순간마법\', \'flavor\': \'"말도 안 돼! 어떻게 녀석들이 우리 방어진을 뚫었지? 바리케이드도 있고 전투 코끼리도 있는데... 게다가 녀석들은 우리 병력의 십분의 일밖에 안 된다고!"\\n—아비토라 장군\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448837&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'984f1e05-45c0-4d20-bfc1-ede3d45845a5\', \'multiverseId\': 448837}, \'multiverseid\': 448837}, {\'name\': \'Ataque Inspirado\', \'text\': \'As criaturas que você controla recebem +2/+1 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Impossível! Como eles conseguiram nos sobrepujar? Nós tínhamos barricadas, elefantes de guerra... e eles eram pouco mais de um décimo de nosso exército!"\\n— General Avitora\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449118&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4e2c594f-6f0c-4970-9cfb-25e2bff0cd2a\', \'multiverseId\': 449118}, \'multiverseid\': 449118}, {\'name\': \'Вдохновенный Натиск\', \'text\': \'Существа под вашим контролем получают +2/+1 до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Это невозможно! Как им удалось нас перебороть? У нас были баррикады, боевые слоны... а их вообще было в десять раз меньше!»\\n— генерал Авитора\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449399&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b061b246-48ce-43d8-89b8-921bc54974c7\', \'multiverseId\': 449399}, \'multiverseid\': 449399}, {\'name\': \'鼓舞冲锋\', \'text\': \'由你操控的生物得+2/+1直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'「不可能！我们怎会给打到溃败？我们有路障，战象. . . 而且他们数量不到我们的一成！」\\n～阿维托拉将军\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449680&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cef7853f-7b3a-4252-bd79-16743c4f728a\', \'multiverseId\': 449680}, \'multiverseid\': 449680}, {\'name\': \'鼓舞衝鋒\', \'text\': \'由你操控的生物得+2/+1直到回合結束。\', \'type\': \'瞬間\', \'flavor\': \'「不可能！我們怎會給打到潰敗？我們有路障，戰象. . .而且他們數量不到我們的一成！」\\n～阿維托拉將軍\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449961&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d8b494b8-77a9-4fd0-9316-4dbd6bdac751\', \'multiverseId\': 449961}, \'multiverseid\': 449961}]', '[{\'name\': \'Isareth die Erweckerin\', \'text\': \'Todesberührung\\nImmer wenn Isareth die Erweckerin angreift, kannst du {X} bezahlen. Wenn du dies tust, bringe eine Kreaturenkarte deiner Wahl mit umgewandelten Manakosten von X mit einer Leichenmarke auf ihr aus deinem Friedhof ins Spiel zurück. Falls jene Kreatur das Spiel verlassen würde, schicke sie ins Exil, anstatt sie irgendwo anders hinzulegen.\', \'type\': \'Legendäre Kreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447521&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7dbb3dd5-103c-4d73-81b0-3c474cb0d54c\', \'multiverseId\': 447521}, \'multiverseid\': 447521}, {\'name\': \'Isareth, la Resucitadora\', \'text\': \'Toque mortal.\\nSiempre que Isareth, la Resucitadora ataque, puedes pagar {X}. Cuando lo hagas, regresa la carta de criatura objetivo con coste de maná convertido de X de tu cementerio al campo de batalla con un contador de cadáveres sobre ella. Si esa criatura fuera a dejar el campo de batalla, exíliala en vez de ponerla en cualquier otro lado.\', \'type\': \'Criatura legendaria — Hechicero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447802&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'eb4424f2-ac08-4138-b839-b785de3d3e38\', \'multiverseId\': 447802}, \'multiverseid\': 447802}, {\'name\': "Isareth l\'éveilleuse", \'text\': "Contact mortel\\nÀ chaque fois qu\'Isareth l\'éveilleuse attaque, vous pouvez payer {X}. Quand vous faites ainsi, renvoyez sur le champ de bataille, depuis votre cimetière, une carte de créature avec un coût converti de mana de X ciblée avec un marqueur « cadavre » sur elle. Si cette créature devait quitter le champ de bataille, exilez-la à la place de la mettre autre part.", \'type\': \'Créature légendaire : humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448083&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f599746e-7a0d-49aa-b745-2129800a4fcc\', \'multiverseId\': 448083}, \'multiverseid\': 448083}, {\'name\': \'Isareth, la Risvegliatrice\', \'text\': \'Tocco letale\\nOgniqualvolta Isareth, la Risvegliatrice attacca, puoi pagare {X}. Quando lo fai, rimetti sul campo di battaglia una carta creatura bersaglio con costo di mana convertito pari a X dal tuo cimitero con un segnalino carogna. Se quella creatura sta per lasciare il campo di battaglia, esiliala invece di metterla in qualsiasi altra zona.\', \'type\': \'Creatura Leggendaria — Mago Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448364&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c87b785d-29a0-4f3f-a0f4-e0812eac298a\', \'multiverseId\': 448364}, \'multiverseid\': 448364}, {\'name\': \'呼び覚ます者イザレス\', \'text\': \'接死\\n呼び覚ます者イザレスが攻撃するたび、あなたは{X}を支払ってもよい。そうしたとき、あなたの墓地から点数で見たマナ・コストがＸのクリーチャー・カード１枚を対象とし、それを死体カウンターが１個置かれた状態で戦場に戻す。そのクリーチャーが戦場を離れるなら、それを他の領域に置く代わりに追放する。\', \'type\': \'伝説のクリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448645&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'15a96817-a8da-4b57-80a9-a48a28e073a9\', \'multiverseId\': 448645}, \'multiverseid\': 448645}, {\'name\': \'일깨우는 자 이자레스\', \'text\': \'치명타\\n일깨우는 자 이자레스가 공격할 때마다, 당신은 {X}를 지불할 수 있다. 그렇게 할 때, 당신의 무덤에서 전환마나비용이 X인 생물 카드를 목표로 정한다. 그 카드를 시체 카운터 한 개를 가진 채로 전장으로 되돌린다. 그 생물이 전장을 떠나려 한다면, 다른 곳에 놓는 대신 그 생물을 추방한다.\', \'type\': \'전설적 생물 — 인간 마법사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448926&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'41678c7c-ae81-4754-88c7-39a3fea81ed7\', \'multiverseId\': 448926}, \'multiverseid\': 448926}, {\'name\': \'Isareth, a Despertadora\', \'text\': \'Toque mortífero\\nToda vez que Isareth, a Despertadora, ataca, você pode pagar {X}. Quando fizer isso, devolva o card de criatura alvo com custo de mana convertido X de seu cemitério para o campo de batalha com um marcador de cadáver. Se aquela criatura for deixar o campo de batalha, em vez de colocá-la em qualquer outro lugar, exile-a.\', \'type\': \'Criatura Lendária — Humano Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449207&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'98c06d18-b428-4c96-a674-699984573997\', \'multiverseId\': 449207}, \'multiverseid\': 449207}, {\'name\': \'Изарет Пробудительница\', \'text\': \'Смертельное касание\\nКаждый раз, когда Изарет Пробудительница атакует, вы можете заплатить {X}. Когда вы это делаете, верните целевую карту существа с конвертированной мана-стоимостью X из вашего кладбища на поле битвы с одним жетоном трупа на ней. Если то существо должно покинуть поле битвы, изгоните его вместо того, чтобы поместить его в какую-либо другую зону.\', \'type\': \'Легендарное Существо — Человек Чародей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449488&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3a0498be-c564-49cc-beb7-384960888156\', \'multiverseId\': 449488}, \'multiverseid\': 449488}, {\'name\': \'唤尸依萨蕾\', \'text\': \'死触\\n每当唤尸依萨蕾攻击时，你可以支付{X}。当你如此作时，将目标总法术力费用为X的生物牌从你的坟墓场移回战场，且其上有一个尸体指示物。如果该生物将离开战场，则改为将它放逐，而非置入其他区域。\', \'type\': \'传奇生物 ～人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449769&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d5429e78-c0f5-4fe1-a748-adb8a2ab60b3\', \'multiverseId\': 449769}, \'multiverseid\': 449769}, {\'name\': \'喚屍依薩蕾\', \'text\': \'死觸\\n每當喚屍依薩蕾攻擊時，你可以支付{X}。當你如此作時，將目標總魔法力費用為X的生物牌從你的墳墓場移回戰場，且其上有一個屍體指示物。如果該生物將離開戰場，則改為將它放逐，而非置入其他區域。\', \'type\': \'傳奇生物 ～人類／魔法師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450050&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6d6d4f78-272f-450a-81f1-a13d4f72d175\', \'multiverseId\': 450050}, \'multiverseid\': 450050}]', "[{'name': 'Isolieren', 'text': 'Schicke eine bleibende Karte deiner Wahl mit umgewandelten Manakosten von 1 ins Exil.', 'type': 'Spontanzauber', 'flavor': 'Dreier Verbrechen ist er schuldig, zweimal bat er um Gnade, doch nur ein Schicksal erwartet ihn.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447434&type=card', 'language': 'German', 'identifiers': {'scryfallId': '8ace6b07-b1b8-4e7a-8574-1a83e2aa2de3', 'multiverseId': 447434}, 'multiverseid': 447434}, {'name': 'Aislar', 'text': 'Exilia el permanente objetivo con coste de maná convertido de 1.', 'type': 'Instantáneo', 'flavor': 'Tres fueron sus crímenes y dos, sus súplicas; pero al final, su destino fue singular.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447715&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ffc5d073-3473-4236-9d78-7aa0526988e8', 'multiverseId': 447715}, 'multiverseid': 447715}, {'name': 'Isoler', 'text': 'Exilez un permanent ciblé avec un coût converti de mana de 1.', 'type': 'Éphémère', 'flavor': 'Ses crimes furent triples, ses supplications doubles, et son sort singulier.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447996&type=card', 'language': 'French', 'identifiers': {'scryfallId': '517b1696-9bd9-469e-8133-ee381a55fb23', 'multiverseId': 447996}, 'multiverseid': 447996}, {'name': 'Isolare', 'text': 'Esilia un permanente bersaglio con costo di mana convertito pari a 1.', 'type': 'Istantaneo', 'flavor': 'Triplice fu il suo delitto, duplice la sua supplica, singolare il suo destino.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448277&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'cf5b7ec7-f918-448b-8371-2ef5e222f89c', 'multiverseId': 448277}, 'multiverseid': 448277}, {'name': '疎外', 'text': '点数で見たマナ・コストが１のパーマネント１つを対象とし、それを追放する。', 'type': 'インスタント', 'flavor': '三度の罪に、二倍の嘆願。一風変わった彼の運命。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448558&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '2bb0a1a8-8889-4a71-ae91-33bc92765c9c', 'multiverseId': 448558}, 'multiverseid': 448558}, {'name': '격리', 'text': '전환마나비용이 1인 지속물을 목표로 정한다. 그 지속물을 추방한다.', 'type': '순간마법', 'flavor': '그의 죄는 세 가지였고, 그의 간청은 두 가지였으며, 그의 운명은 한 가지였다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448839&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '96e2a13d-8210-4509-8d30-2a07088942f2', 'multiverseId': 448839}, 'multiverseid': 448839}, {'name': 'Isolar', 'text': 'Exile a permanente alvo com custo de mana convertido igual a 1.', 'type': 'Mágica Instantânea', 'flavor': 'Triplo foi seu crime, dupla sua súplica, singular seu destino.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449120&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b45b8466-1a03-4287-baae-42fdd76901a1', 'multiverseId': 449120}, 'multiverseid': 449120}, {'name': 'Изоляция', 'text': 'Изгоните целевой перманент с конвертированной мана-стоимостью 1.', 'type': 'Мгновенное заклинание', 'flavor': 'Троекратны были его преступления, двукратны мольбы, но единственной в своем роде стала судьба.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449401&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '4afb3e44-5602-4919-9130-c1c9022a6b96', 'multiverseId': 449401}, 'multiverseid': 449401}, {'name': '孤立', 'text': '放逐目标总法术力费用为1的永久物。', 'type': '瞬间', 'flavor': '三重罪行，两倍求饶，一生孤独。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449682&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'fef712f1-8fa6-4b82-9340-ee06975f250a', 'multiverseId': 449682}, 'multiverseid': 449682}, {'name': '孤立', 'text': '放逐目標總魔法力費用為1的永久物。', 'type': '瞬間', 'flavor': '三重罪行，兩倍求饒，一生孤獨。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449963&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '12bc70e9-9ff2-4aa0-9f8e-2dfa9e7d1198', 'multiverseId': 449963}, 'multiverseid': 449963}]", '[{\'name\': \'Kaplanin der Morgendämmerung\', \'text\': \'Lebensverknüpfung (Schaden, der von dieser Kreatur zugefügt wird, lässt dich entsprechend viele Lebenspunkte dazuerhalten.)\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': \'„Möge das Licht durch mich scheinen und den Verlorenen den Weg weisen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447427&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d4eeb405-0a34-44db-b7eb-c848b363eda1\', \'multiverseId\': 447427}, \'multiverseid\': 447427}, {\'name\': \'Capellana del amanecer\', \'text\': \'Vínculo vital. (El daño hecho por esta criatura también hace que ganes esa misma cantidad de vidas.)\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': \'"Que la luz resplandezca a través de mí y guíe a aquellos que se perdieron".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447708&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ca898aa3-4d10-4c07-a186-13566381aef9\', \'multiverseId\': 447708}, \'multiverseid\': 447708}, {\'name\': \'Aumônière du point du jour\', \'text\': \'Lien de vie (Les blessures infligées par cette créature vous font aussi gagner autant de points de vie.)\', \'type\': \'Créature : humain et clerc\', \'flavor\': \'« Puisse la lumière éclairer à travers moi ceux qui se sont égarés. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447989&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a730ed0a-d0b0-4d8a-b9e0-ad61ed9becf8\', \'multiverseId\': 447989}, \'multiverseid\': 447989}, {\'name\': "Cappellana dell\'Aurora", \'text\': \'Legame vitale (Il danno inflitto da questa creatura ti fa anche guadagnare altrettanti punti vita.)\', \'type\': \'Creatura — Chierico Umano\', \'flavor\': \'"Che la luce possa splendere attraverso di me per guidare chi è perduto."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448270&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0555bb51-e7ff-48b0-81b7-a5f79f990689\', \'multiverseId\': 448270}, \'multiverseid\': 448270}, {\'name\': \'夜明けの司祭\', \'text\': \'絆魂（このクリーチャーがダメージを与えると、さらにあなたはその点数分のライフを得る。）\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': \'「私の発する光が迷える者を導かんことを。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448551&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7f8f37a0-0edb-4706-a071-fdcfbe1b82ac\', \'multiverseId\': 448551}, \'multiverseid\': 448551}, {\'name\': \'여명의 사제\', \'text\': \'생명연결 (이 생물이 피해를 입히면 당신은 그 피해만큼 생명점을 얻는다.)\', \'type\': \'생물 — 인간 성직자\', \'flavor\': \'"나를 통해 길 잃은 자들을 인도할 빛을 비추소서."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448832&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4067f67f-d4d1-42ab-826d-b32f454ca989\', \'multiverseId\': 448832}, \'multiverseid\': 448832}, {\'name\': \'Capelã do Raiar do Dia\', \'text\': \'Vínculo com a vida (O dano causado por esta criatura faz com que você ganhe uma quantidade equivalente de pontos de vida.)\', \'type\': \'Criatura — Humano Clérigo\', \'flavor\': \'"Que através de mim brilhe a luz para guiar os que se perderam."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449113&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e698b645-c319-425c-86dc-ad68f60a027a\', \'multiverseId\': 449113}, \'multiverseid\': 449113}, {\'name\': \'Капеллан Рассвета\', \'text\': \'Цепь жизни (Повреждения, наносимые этим существом, также заставляют вас получить такое же количество жизней.)\', \'type\': \'Существо — Человек Священник\', \'flavor\': \'«Пусть свет пройдет через меня, чтобы направить заблудившихся».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449394&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'81eb5ae8-3335-432a-b7a4-58851b27ba26\', \'multiverseId\': 449394}, \'multiverseid\': 449394}, {\'name\': \'破晓教士\', \'text\': \'系命（此生物所造成的伤害会让你获得等量的生命。）\', \'type\': \'生物 ～人类／僧侣\', \'flavor\': \'「愿明光照我身，引领迷途之人。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449675&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d67ee9fb-9936-498c-9906-fc0599e0376a\', \'multiverseId\': 449675}, \'multiverseid\': 449675}, {\'name\': \'破曉教士\', \'text\': \'繫命（此生物所造成的傷害會讓你獲得等量的生命。）\', \'type\': \'生物 ～人類／僧侶\', \'flavor\': \'「願明光照我身，引領迷途之人。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449956&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8500e46d-215c-4ec9-af16-9862d1e28681\', \'multiverseId\': 449956}, \'multiverseid\': 449956}]', '[{\'name\': \'Kargische Drachenreiterin\', \'text\': \'Solange du einen Drachen kontrollierst, hat die Kargische Drachenreiterin Flugfähigkeit. (Sie kann außer von fliegenden Kreaturen und Kreaturen mit Reichweite nicht geblockt werden.)\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': \'„Nur diejenigen, die den Drachen den gebührenden Respekt entgegenbringen, dürfen mit uns reiten."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450278&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1cec30d7-8a6b-46f6-b040-637ae8ff68fa\', \'multiverseId\': 450278}, \'multiverseid\': 450278}, {\'name\': \'Jinete de dragones kargana\', \'text\': \'Mientras controles un Dragón, la Jinete de dragones kargana tiene la habilidad de volar. (No puede ser bloqueada excepto por criaturas que tengan la habilidad de volar o alcance.)\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': \'"Solo los que respetan a los dragones como se merecen son dignos de llevar este título".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450312&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3cba41c2-4e69-4b6f-ab4a-6ff07ae372a4\', \'multiverseId\': 450312}, \'multiverseid\': 450312}, {\'name\': \'Cavalier-dragon kargan\', \'text\': \'Tant que vous contrôlez un dragon, le Cavalier-dragon kargan a le vol. (Il ne peut pas être bloqué excepté par des créatures avec le vol ou la portée.)\', \'type\': \'Créature : humain et guerrier\', \'flavor\': \'« Seuls ceux qui accordent aux dragons le respect qui leur est dû peuvent porter notre titre. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450346&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c319fc6c-2b98-4fc9-9a8d-902bed4d1ede\', \'multiverseId\': 450346}, \'multiverseid\': 450346}, {\'name\': \'Cavalcadraghi di Karga\', \'text\': \'Fintanto che controlli un Drago, la Cavalcadraghi di Karga ha volare. (Non può essere bloccata tranne che da creature con volare o raggiungere.)\', \'type\': \'Creatura — Guerriero Umano\', \'flavor\': \'"Solo coloro che trattano i draghi con il dovuto rispetto possono fregiarsi del nostro titolo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450380&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'acd463c1-5c93-41e7-97b7-4a7b425a08dd\', \'multiverseId\': 450380}, \'multiverseid\': 450380}, {\'name\': \'カルガの竜騎兵\', \'text\': \'あなたがドラゴンをコントロールしているかぎり、カルガの竜騎兵は飛行を持つ。（これは飛行や到達を持たないクリーチャーによってはブロックされない。）\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': \'「ドラゴンに敬意を払う者のみが、この称号を受けるに値する。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450414&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'af879d92-9028-4d5b-b614-5620ab250f44\', \'multiverseId\': 450414}, \'multiverseid\': 450414}, {\'name\': \'카르가 용기수\', \'text\': \'당신이 용을 조종하는 한, 카르가 용기수는 비행을 가진다. (그 생물은 비행이나 대공을 가진 생물에게만 방어될 수 있다.)\', \'type\': \'생물 — 인간 전사\', \'flavor\': \'"용들에게 그들이 받아야 마땅한 존경을 바치는 이들만이 우리의 칭호를 감당할 자격이 있다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450448&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ac395ea5-0c46-422d-ae21-262f85cc21bc\', \'multiverseId\': 450448}, \'multiverseid\': 450448}, {\'name\': \'Ginete de Dragão Karganiano\', \'text\': \'Enquanto você controlar um Dragão, Ginete de Dragão Karganiano terá voar. (Ele só pode ser bloqueado por criaturas com voar ou alcance.)\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': \'"Somente aqueles que respeitam os dragões como eles merecem podem receber nosso título."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450482&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'277d3c3a-c35a-454b-a0a5-0037426d1edf\', \'multiverseId\': 450482}, \'multiverseid\': 450482}, {\'name\': \'Каргская Наездница Драконов\', \'text\': \'Пока у вас под контролем есть Дракон, Каргская Наездница Драконов имеет Полет. (Она может быть заблокирована только существами с Полетом или Захватом.)\', \'type\': \'Существо — Человек Воин\', \'flavor\': \'«Лишь те, кто относится к драконам с подобающим уважением, могут носить этот титул».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450516&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3f30be4f-668e-4c49-8f07-f31839534ae3\', \'multiverseId\': 450516}, \'multiverseid\': 450516}, {\'name\': \'卡加龙骑士\', \'text\': \'只要你操控龙，卡加龙骑士便具有飞行异能。（它只能被具飞行或延势异能的生物阻挡。）\', \'type\': \'生物 ～人类／战士\', \'flavor\': \'「给予龙应有的尊重者，才配冠上我们的称号。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450550&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'80ed49d7-6c66-4ddb-bee2-d86a79f6ed97\', \'multiverseId\': 450550}, \'multiverseid\': 450550}, {\'name\': \'卡加龍騎士\', \'text\': \'只要你操控龍，卡加龍騎士便具有飛行異能。（它只能被具飛行或延勢異能的生物阻擋。）\', \'type\': \'生物 ～人類／戰士\', \'flavor\': \'「給予龍應有的尊重者，才配冠上我們的稱號。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450584&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9d43b81e-3112-4b29-842f-dfdbee8de935\', \'multiverseId\': 450584}, \'multiverseid\': 450584}]', '[{\'name\': \'Katalysierendes Elementarwesen\', \'text\': \'Opfere das Katalysierende Elementarwesen: Erzeuge {R}{R}.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'Als der Hypersturm-Generator den roten Bereich erreichte, stieg ein Wesen aus dem Lichtbogen empor.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447549&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'abba4d39-b55a-4883-a414-de6d79e875ae\', \'multiverseId\': 447549}, \'multiverseid\': 447549}, {\'name\': \'Elemental catalizador\', \'text\': \'Sacrificar el Elemental catalizador: Agrega {R}{R}.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Justo cuando el generador de hiperrayo traspasó la línea roja, un ser emergió del arco brillante.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447830&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'360b9c5f-fd3f-4f6c-ae91-a85abb5fbe0c\', \'multiverseId\': 447830}, \'multiverseid\': 447830}, {\'name\': \'Élémental catalytique\', \'text\': "Sacrifiez l\'Élémental catalytique : Ajoutez {R}{R}.", \'type\': \'Créature : élémental\', \'flavor\': "Alors que le générateur hyperélectrique passait dans le rouge, un être surgit de l\'arc.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448111&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7fb6064f-7823-433f-b85b-20cc29060ed5\', \'multiverseId\': 448111}, \'multiverseid\': 448111}, {\'name\': \'Elementale Catalizzatore\', \'text\': "Sacrifica l\'Elementale Catalizzatore: Aggiungi {R}{R}.", \'type\': \'Creatura — Elementale\', \'flavor\': \'Il generatore di ipertempeste superò la soglia critica e dalla scarica emerse una forma di vita.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448392&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7abbab39-20b7-4a76-8016-b67ebba69eb5\', \'multiverseId\': 448392}, \'multiverseid\': 448392}, {\'name\': \'触媒の精霊\', \'text\': \'触媒の精霊を生け贄に捧げる：{R}{R}を加える。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'超嵐生成器がじわじわと臨界を超えると、放電の中から何かが姿を現した。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448673&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'84e9258a-3fdd-4b80-9a7e-be102856adee\', \'multiverseId\': 448673}, \'multiverseid\': 448673}, {\'name\': \'촉매 정령\', \'text\': \'촉매 정령을 희생한다: {R}{R}를 추가한다.\', \'type\': \'생물 — 정령\', \'flavor\': \'초폭풍 생성기가 한계치를 넘어서자, 번개로부터 어떤 존재가 나타났다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448954&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b009d8e7-b60c-4ee2-8251-85f11077f2cf\', \'multiverseId\': 448954}, \'multiverseid\': 448954}, {\'name\': \'Elemental Catalizador\', \'text\': \'Sacrifique Elemental Catalizador: Adicione {R}{R}.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Quando o gerador hipertempéstico passou lentamente da linha vermelha, um ser emergiu do arco.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449235&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e10eaf6a-244b-48c0-86c2-d0de58ae7912\', \'multiverseId\': 449235}, \'multiverseid\': 449235}, {\'name\': \'Элементаль-Катализатор\', \'text\': \'Пожертвуйте Элементаля-Катализатора: добавьте {R}{R}.\', \'type\': \'Существо — Элементаль\', \'flavor\': \'Когда стрелка гиперштормового генератора пересекла красную черту, из разрядов появилось существо.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449516&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1d73ba3a-9ebf-4088-a015-2b50301a16e9\', \'multiverseId\': 449516}, \'multiverseid\': 449516}, {\'name\': \'触媒元素\', \'text\': \'牺牲触媒元素：加{R}{R}。\', \'type\': \'生物 ～元素\', \'flavor\': \'超风暴发生器一过临界值，电弧中便冒出一个生物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449797&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'943d72b1-8266-4c16-a552-67c5fcef759c\', \'multiverseId\': 449797}, \'multiverseid\': 449797}, {\'name\': \'觸媒元素\', \'text\': \'犧牲觸媒元素：加{R}{R}。\', \'type\': \'生物 ～元素\', \'flavor\': \'超風暴發生器一過臨界值，電弧中便冒出一個生物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450078&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f793a2df-51ac-4547-a74e-020ccae1d10c\', \'multiverseId\': 450078}, \'multiverseid\': 450078}]', "[{'name': 'Kehrtwendung', 'text': 'Tausche die Kontrolle über zwei Kreaturen deiner Wahl aus.', 'type': 'Hexerei', 'flavor': 'Begrüße deinen neuen Freund.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447495&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'da6fbc4e-597b-469a-b1e0-579ea152bdd5', 'multiverseId': 447495}, 'multiverseid': 447495}, {'name': 'Cambiazo', 'text': 'Intercambia el control de dos criaturas objetivo.', 'type': 'Conjuro', 'flavor': 'Saluda a tu nuevo amigo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447776&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'bfd302c1-e467-43fa-9296-9cee54f53991', 'multiverseId': 447776}, 'multiverseid': 447776}, {'name': 'Volte-face', 'text': 'Échangez le contrôle de deux créatures ciblées.', 'type': 'Rituel', 'flavor': 'Dis bonjour à ton nouvel ami.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448057&type=card', 'language': 'French', 'identifiers': {'scryfallId': '66ceb426-81e8-4ee7-8c61-27e3d51e9808', 'multiverseId': 448057}, 'multiverseid': 448057}, {'name': 'Scambio', 'text': 'Scambia il controllo di due creature bersaglio.', 'type': 'Stregoneria', 'flavor': 'Saluta il tuo nuovo amichetto.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448338&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'dd522f6f-2171-4352-8a01-85f8f5683053', 'multiverseId': 448338}, 'multiverseid': 448338}, {'name': 'どんでん返し', 'text': 'クリーチャー２体を対象とし、それらのコントロールを交換する。', 'type': 'ソーサリー', 'flavor': '新しいお友達にこんにちはしましょう。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448619&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'e34feed9-db77-4f19-86c7-a3d17689b0e6', 'multiverseId': 448619}, 'multiverseid': 448619}, {'name': '바꿔치기', 'text': '생물 두 개를 목표로 정한다. 두 생물의 조종권을 교환한다.', 'type': '집중마법', 'flavor': '새로운 친구와 인사를 나눌 시간이다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448900&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'b297bec6-8a79-4975-9123-c9a3db4655b7', 'multiverseId': 448900}, 'multiverseid': 448900}, {'name': 'Escambo', 'text': 'Permute o controle de duas criaturas alvo.', 'type': 'Feitiço', 'flavor': 'Diga olá para seu novo amigo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449181&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f3ebb3ee-3151-432c-a530-f87c465c701b', 'multiverseId': 449181}, 'multiverseid': 449181}, {'name': 'Подмена', 'text': 'Поменяйте контроль над двумя целевыми существами.', 'type': 'Волшебство', 'flavor': 'Поздоровайся с новым другом.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449462&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'c14cdd20-014a-4881-b77e-14a35a63e9d1', 'multiverseId': 449462}, 'multiverseid': 449462}, {'name': '私密交换', 'text': '交换两个目标生物的操控权。', 'type': '法术', 'flavor': '跟你的新朋友打个招呼。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449743&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '66ffd7a3-4a8f-4c01-8588-280bce4287b9', 'multiverseId': 449743}, 'multiverseid': 449743}, {'name': '私密交換', 'text': '交換兩個目標生物的操控權。', 'type': '巫術', 'flavor': '跟你的新朋友打個招呼。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450024&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '621bfe73-e40d-47fc-9000-540a3d37c275', 'multiverseId': 450024}, 'multiverseid': 450024}]", "[{'name': 'Kind der Nacht', 'text': 'Lebensverknüpfung (Schaden, der von dieser Kreatur zugefügt wird, lässt dich ebenso viele Lebenspunkte dazuerhalten.)', 'type': 'Kreatur — Vampir', 'flavor': 'Sünden, die bei Tageslicht grauenhaft wirken, sind in der Dunkelheit der Nacht deutlich amüsanter.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447506&type=card', 'language': 'German', 'identifiers': {'scryfallId': '85a3e5e0-4ce1-4d67-99d7-0cdc439615e3', 'multiverseId': 447506}, 'multiverseid': 447506}, {'name': 'Hijo de la noche', 'text': 'Vínculo vital. (El daño hecho por esta criatura también hace que ganes esa misma cantidad de vidas.)', 'type': 'Criatura — Vampiro', 'flavor': 'Pecados que serían horripilantes a la luz del día son más placenteros en la oscuridad de la noche.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447787&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '7912e3b9-7895-49ee-a82f-7483ba1f4f8e', 'multiverseId': 447787}, 'multiverseid': 447787}, {'name': 'Enfant de la nuit', 'text': 'Lien de vie (Les blessures infligées par cette créature vous font aussi gagner autant de points de vie.)', 'type': 'Créature : vampire', 'flavor': 'Les péchés qui sont trop horribles à la lumière du jour deviennent plus plaisants dans les ombres de la nuit.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448068&type=card', 'language': 'French', 'identifiers': {'scryfallId': '6d97a512-a221-4e48-a3b9-4062e021cc9f', 'multiverseId': 448068}, 'multiverseid': 448068}, {'name': 'Figlia della Notte', 'text': 'Legame vitale (Il danno inflitto da questa creatura ti fa anche guadagnare altrettanti punti vita.)', 'type': 'Creatura — Vampiro', 'flavor': 'Peccati che sarebbero troppo raccapriccianti alla luce del giorno sono resi più piacevoli dal buio della notte.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448349&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '6eebe6c3-761e-4c4c-98b4-941bbbb3a25e', 'multiverseId': 448349}, 'multiverseid': 448349}, {'name': '夜の子', 'text': '絆魂（このクリーチャーがダメージを与えると、さらにあなたはその点数分のライフを得る。）', 'type': 'クリーチャー — 吸血鬼', 'flavor': '陽の光の下ではあまりに陰惨な罪も、夜の闇の下ではより喜ばしい。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448630&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '107b00b6-3f87-433d-a55e-fc1111bb5f21', 'multiverseId': 448630}, 'multiverseid': 448630}, {'name': '밤의 자식', 'text': '생명연결 (이 생물이 피해를 입히면 당신은 그 피해만큼 생명점을 얻는다.)', 'type': '생물 — 흡혈귀', 'flavor': '낮에는 끔찍해 보이는 일들이 밤에는 할만하게 느껴진다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448911&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '1dbfece0-99e0-4486-9e17-e88bcd5e0fbb', 'multiverseId': 448911}, 'multiverseid': 448911}, {'name': 'Filha da Noite', 'text': 'Vínculo com a vida (O dano causado por esta criatura faz com que você ganhe uma quantidade equivalente de pontos de vida.)', 'type': 'Criatura — Vampiro', 'flavor': 'Pecados que seriam cruentos demais à luz do dia se fazem mais agradáveis na calada da noite.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449192&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1d117b95-2e2b-44cd-9e4f-530cfa93b398', 'multiverseId': 449192}, 'multiverseid': 449192}, {'name': 'Дитя Ночи', 'text': 'Цепь жизни (Повреждения, наносимые этим существом, также заставляют вас получить такое же количество жизней.)', 'type': 'Существо — Вампир', 'flavor': 'Грехи, слишком отвратительные в свете дня, становятся гораздо приятнее в ночной тьме.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449473&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '16daebce-23ad-4cdd-ba48-c78cf76b9884', 'multiverseId': 449473}, 'multiverseid': 449473}, {'name': '暗夜之子', 'text': '系命（此生物所造成的伤害会让你获得等量的生命。）', 'type': '生物 ～吸血鬼', 'flavor': '光天化日下过于恶心的罪恶，在暗夜笼罩下就显得没那么面目可憎。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449754&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '49c87d9b-6716-4f11-9057-e0cccb3dfedb', 'multiverseId': 449754}, 'multiverseid': 449754}, {'name': '暗夜之子', 'text': '繫命（此生物所造成的傷害會讓你獲得等量的生命。）', 'type': '生物 ～吸血鬼', 'flavor': '光天化日下過於噁心的罪惡，在暗夜籠罩下就顯得沒那麼面目可憎。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450035&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '248e0a46-f0a2-4055-bbdc-19a19c48aa26', 'multiverseId': 450035}, 'multiverseid': 450035}]", '[{\'name\': \'Klerikerin des Hofes\', \'text\': \'Lebensverknüpfung (Schaden, der von dieser Kreatur zugefügt wird, lässt dich entsprechend viele Lebenspunkte dazuerhalten.)\\nDie Klerikerin des Hofes erhält +1/+1, solange du einen Ajani-Planeswalker kontrollierst.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': \'„Die Heiler von Bant sind unübertroffen. Vieles verdanke ich allein ihrer Unterweisung."\\n—Ajani Goldmähne\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450264&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1e897ce2-ecd7-47ad-a48f-bbc6feaacf96\', \'multiverseId\': 450264}, \'multiverseid\': 450264}, {\'name\': \'Clériga de la corte\', \'text\': \'Vínculo vital. (El daño hecho por esta criatura también hace que ganes esa misma cantidad de vidas.)\\nLa Clériga de la corte obtiene +1/+1 mientras controles un planeswalker Ajani.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': \'"Los sanadores de Bant son insuperables. Jamás podré compensarlos por su tutelaje".\\n—Ajani Melena Dorada\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450298&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fdd6408f-7177-4759-91d6-cf662c80df69\', \'multiverseId\': 450298}, \'multiverseid\': 450298}, {\'name\': \'Clerc de la cour\', \'text\': \'Lien de vie (Les blessures infligées par cette créature vous font aussi gagner autant de points de vie.)\\nLa Clerc de la cour gagne +1/+1 tant que vous contrôlez un planeswalker Ajani.\', \'type\': \'Créature : humain et clerc\', \'flavor\': \'« Les guérisseurs de Bant sont les plus renommés de tous. Je dois beaucoup à leur tutelle. »\\n—Ajani Crinièredor\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450332&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2d8e2da5-8f6b-40fc-adec-42727dd2814a\', \'multiverseId\': 450332}, \'multiverseid\': 450332}, {\'name\': \'Chierica di Corte\', \'text\': \'Legame vitale (Il danno inflitto da questa creatura ti fa anche guadagnare altrettanti punti vita.)\\nLa Chierica di Corte prende +1/+1 fintanto che controlli un planeswalker Ajani.\', \'type\': \'Creatura — Chierico Umano\', \'flavor\': \'"I guaritori di Bant non sono secondi a nessuno. Sono infinitamente riconoscente di averli avuti come tutori."\\n—Ajani Criniera D\\\'Oro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450366&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dff80249-efa4-4862-9fd4-c6ec01db64e1\', \'multiverseId\': 450366}, \'multiverseid\': 450366}, {\'name\': \'宮廷の僧侶\', \'text\': \'絆魂（このクリーチャーがダメージを与えると、さらにあなたはその点数分のライフを得る。）\\nあなたがアジャニ・プレインズウォーカーをコントロールしているかぎり、宮廷の僧侶は＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': \'「バントの癒し手たちは何者にも代えがたい。今の私は彼らの庇護があったからこそだ。」\\n――黄金のたてがみのアジャニ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450400&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e3bc6d66-315c-4a0c-a440-28ab7a2a2a78\', \'multiverseId\': 450400}, \'multiverseid\': 450400}, {\'name\': \'법정 성직자\', \'text\': \'생명연결 (이 생물이 피해를 입히면 당신은 그 피해만큼 생명점을 얻는다.)\\n법정 성직자는 당신이 아자니 플레인즈워커를 조종하는 한 +1/+1을 받는다.\', \'type\': \'생물 — 인간 성직자\', \'flavor\': \'"반트의 치유사들은 최고 중의 최고이다. 그들의 지도로 나는 많은 것을 얻을 수 있었다."\\n—아자니 골드메인\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450434&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'de0a7301-b70c-4578-b072-92e25dc99171\', \'multiverseId\': 450434}, \'multiverseid\': 450434}, {\'name\': \'Clériga da Corte\', \'text\': \'Vínculo com a vida (O dano causado por esta criatura faz com que você ganhe uma quantidade equivalente de pontos de vida.)\\nClériga da Corte receberá +1/+1 enquanto você controlar um planeswalker Ajani.\', \'type\': \'Criatura — Humano Clérigo\', \'flavor\': \'"Os curandeiros de Bant são incomparáveis. Eu lhes devo muito por tê-los tido como tutores."\\n— Ajani Juba D\\\'ouro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450468&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'05b1a0bd-1b7b-450c-bf9a-f6047397df5d\', \'multiverseId\': 450468}, \'multiverseid\': 450468}, {\'name\': \'Придворная Священница\', \'text\': \'Цепь жизни (Повреждения, наносимые этим существом, также заставляют вас получить такое же количество жизней.)\\nПридворная Священница получает +1/+1, пока вы контролируете planeswalker-а Аджани.\', \'type\': \'Существо — Человек Священник\', \'flavor\': \'«Целители Бэнта не знают себе равных. Они научили меня своему мастерству, и я многим им обязан».\\n— Златогривый Аджани\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450502&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ccc4e372-18e5-44c4-919e-be37f5d48d37\', \'multiverseId\': 450502}, \'multiverseid\': 450502}, {\'name\': \'庭园僧侣\', \'text\': \'系命（此生物所造成的伤害会让你获得等量的生命。）\\n只要你操控阿耶尼鹏洛客，庭园僧侣便得+1/+1。\', \'type\': \'生物 ～人类／僧侣\', \'flavor\': \'「班特治疗师的医术举世无双。他们的指导让我受益良多。」\\n～金鬃阿耶尼\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450536&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ddf4bee3-5750-4762-8978-386efc8b547a\', \'multiverseId\': 450536}, \'multiverseid\': 450536}, {\'name\': \'庭園僧侶\', \'text\': \'繫命（此生物所造成的傷害會讓你獲得等量的生命。）\\n只要你操控阿耶尼鵬洛客，庭園僧侶便得+1/+1。\', \'type\': \'生物 ～人類／僧侶\', \'flavor\': \'「班特治療師的醫術舉世無雙。他們的指導讓我受益良多。」\\n～金鬃阿耶尼\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450570&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'93738cda-5a27-4900-89e4-9be4fb807f8c\', \'multiverseId\': 450570}, \'multiverseid\': 450570}]', '[{\'name\': \'Knochen zu Asche\', \'text\': \'Neutralisiere einen Kreaturenzauber deiner Wahl.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ich kann mir ein schlimmeres Ende ausmalen. Hmmm, vielleicht doch nicht."\\n—Ludevic, Nekro-Alchemist\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447464&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'94777499-6ad9-44a1-b83b-35edb752bb04\', \'multiverseId\': 447464}, \'multiverseid\': 447464}, {\'name\': \'Huesos en cenizas\', \'text\': \'Contrarresta el hechizo de criatura objetivo.\\nRoba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'"Puedo imaginar peores maneras de partir. Ahora que lo pienso, tal vez no".\\n—Ludevic, necroalquimista\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447745&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'66c6d7b1-0eba-43a4-82c5-255ed7832c67\', \'multiverseId\': 447745}, \'multiverseid\': 447745}, {\'name\': \'Os en cendres\', \'text\': \'Contrecarrez le sort de créature ciblé.\\nPiochez une carte.\', \'type\': \'Éphémère\', \'flavor\': "« Ce n\'est pas la pire façon de mourir. Après réflexion, peut-être que si. »\\n—Ludevic, nécro-alchimiste", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448026&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0dba6f34-6bb3-4311-94d1-0fd9b0160623\', \'multiverseId\': 448026}, \'multiverseid\': 448026}, {\'name\': \'Ossa in Cenere\', \'text\': \'Neutralizza una magia creatura bersaglio.\\nPesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'"Mi vengono in mente modi peggiori per andarsene. A pensarci bene, forse no."\\n—Ludevic, necro-alchimista\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448307&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0dfc9af7-47db-415b-a90c-339cacdea21e\', \'multiverseId\': 448307}, \'multiverseid\': 448307}, {\'name\': \'骨を灰に\', \'text\': \'クリーチャー・呪文１つを対象とし、それを打ち消す。\\nカードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': \'「もっと悪い死にようも考え得る。いや待てよ、そうでもないか。」\\n――屍錬金術師、ルーデヴィック\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448588&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3e07509f-6cdc-4aea-afb8-c1924f947fda\', \'multiverseId\': 448588}, \'multiverseid\': 448588}, {\'name\': \'뼈에서 재로\', \'text\': \'생물 주문을 목표로 정한다. 그 주문을 무효화한다.\\n카드 한 장을 뽑는다.\', \'type\': \'순간마법\', \'flavor\': \'"더 처참하게 죽는 방법이야 많... 은 게 아니라 없군."\\n—사령연금술사 루데비치\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448869&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ef25f60e-b889-4826-9658-9a3d1f748f44\', \'multiverseId\': 448869}, \'multiverseid\': 448869}, {\'name\': \'De Ossos a Cinzas\', \'text\': \'Anule a mágica de criatura alvo.\\nCompre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Posso imaginar meios piores de partir. Pensando bem, acho que não."\\n— Ludevic, necroalquimista\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449150&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6e548b85-d5ed-4de4-89a1-57887fcccee4\', \'multiverseId\': 449150}, \'multiverseid\': 449150}, {\'name\': \'Из Костей в Прах\', \'text\': \'Отмените целевое заклинание существа.\\nВозьмите карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Есть смерти и похуже. Хотя нет, пожалуй, нет».\\n— Людевик, некроалхимик\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449431&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'935b1a0e-2464-48ed-a6d0-cfb610a301a9\', \'multiverseId\': 449431}, \'multiverseid\': 449431}, {\'name\': \'白骨化灰\', \'text\': \'反击目标生物咒语。\\n抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'「我能想到更糟的告别法。不过仔细想想，那也许还算不上。」\\n～死灵炼金术士卢德维\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449712&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'43e644e2-3f51-4cb3-bdc1-897623fd8287\', \'multiverseId\': 449712}, \'multiverseid\': 449712}, {\'name\': \'白骨化灰\', \'text\': \'反擊目標生物咒語。\\n抽一張牌。\', \'type\': \'瞬間\', \'flavor\': \'「我能想到更糟的告別法。不過仔細想想，那也許還算不上。」\\n～死靈鍊金術士盧德維\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449993&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'65e05241-45c7-4bca-bb87-fa3a4c447e9b\', \'multiverseId\': 449993}, \'multiverseid\': 449993}]', '[{\'name\': \'Knochendrache\', \'text\': \'Fliegend\\n{3}{B}{B}, schicke sieben andere Karten aus deinem Friedhof ins Exil: Bringe den Knochendrachen aus deinem Friedhof getappt ins Spiel zurück.\', \'type\': \'Kreatur — Drache, Skelett\', \'flavor\': \'Sein Gebrüll ist das Klappern tausender Knochen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447505&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6834aeb3-a6dd-43f2-8c91-9f2305ec749d\', \'multiverseId\': 447505}, \'multiverseid\': 447505}, {\'name\': \'Dragón de huesos\', \'text\': \'Vuela.\\n{3}{B}{B}, exiliar otras siete cartas de tu cementerio: Regresa el Dragón de huesos de tu cementerio al campo de batalla girado.\', \'type\': \'Criatura — Esqueleto dragón\', \'flavor\': \'Su rugido suena como el repiqueteo de mil huesos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447786&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'da5ee4eb-27c1-41c6-ba6b-7e61363994e4\', \'multiverseId\': 447786}, \'multiverseid\': 447786}, {\'name\': "Dragon d\'os", \'text\': "Vol\\n{3}{B}{B}, exilez sept autres cartes de votre cimetière : Renvoyez sur le champ de bataille, engagé, le Dragon d\'os depuis votre cimetière.", \'type\': \'Créature : dragon et squelette\', \'flavor\': "Son rugissement est le fracas de milliers d\'os.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448067&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b2b5be08-a5b7-4c70-b091-afd0907edc14\', \'multiverseId\': 448067}, \'multiverseid\': 448067}, {\'name\': "Drago d\'Ossa", \'text\': "Volare\\n{3}{B}{B}, Esilia altre sette carte dal tuo cimitero: Rimetti sul campo di battaglia il Drago d\'Ossa TAPpato dal tuo cimitero.", \'type\': \'Creatura — Scheletro Drago\', \'flavor\': "Il suo ruggito è l\'acciottolio di migliaia di ossa.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448348&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'49fe233b-26f5-41a7-95ca-b2b835da2933\', \'multiverseId\': 448348}, \'multiverseid\': 448348}, {\'name\': \'骨ドラゴン\', \'text\': \'飛行\\n{3}{B}{B}, あなたの墓地から他のカード７枚を追放する：あなたの墓地から骨ドラゴンをタップ状態で戦場に戻す。\', \'type\': \'クリーチャー — ドラゴン・スケルトン\', \'flavor\': \'その咆哮は千の骨がぶつかり合う音だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448629&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5bf63bab-eeb9-4d8c-b380-3b4c4299a9d6\', \'multiverseId\': 448629}, \'multiverseid\': 448629}, {\'name\': \'해골 용\', \'text\': \'비행\\n{3}{B}{B}, 당신의 무덤에서 다른 카드 일곱 장을 추방한다: 해골 용을 당신의 무덤에서 탭된 채로 전장으로 되돌린다.\', \'type\': \'생물 — 용 해골\', \'flavor\': \'그것의 포효는 수천 개의 뼈들이 달그락거리는 소리이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448910&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'556db0da-73e6-499b-b74f-09de54276541\', \'multiverseId\': 448910}, \'multiverseid\': 448910}, {\'name\': \'Dragão de Ossos\', \'text\': \'Voar\\n{3}{B}{B}, exile sete outros cards de seu cemitério: Devolva Dragão de Ossos de seu cemitério para o campo de batalha virado.\', \'type\': \'Criatura — Dragão Esqueleto\', \'flavor\': \'Seu rugido é a batida de milhares de ossos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449191&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ced37329-5219-47f4-b6da-12f2d9b6366a\', \'multiverseId\': 449191}, \'multiverseid\': 449191}, {\'name\': \'Костяной Дракон\', \'text\': \'Полет\\n{3}{B}{B}, изгоните семь других карт из вашего кладбища: верните Костяного Дракона из вашего кладбища на поле битвы повернутым.\', \'type\': \'Существо — Дракон Скелет\', \'flavor\': \'Его рев — перестук тысячи костей.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449472&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9f56653d-0d88-4f84-9e07-efb57235b2e4\', \'multiverseId\': 449472}, \'multiverseid\': 449472}, {\'name\': \'骸骨巨龙\', \'text\': \'飞行\\n{3}{B}{B}，从你的坟墓场放逐七张其他牌：将骸骨巨龙从你的坟墓场横置移回战场。\', \'type\': \'生物 ～龙／骷髅妖\', \'flavor\': \'身上骨骸敲击，便是其咆哮怒吼。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449753&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b5ed5ef4-7677-4e55-96a3-a722fd8d578a\', \'multiverseId\': 449753}, \'multiverseid\': 449753}, {\'name\': \'骸骨巨龍\', \'text\': \'飛行\\n{3}{B}{B}，從你的墳墓場放逐七張其他牌：將骸骨巨龍從你的墳墓場橫置移回戰場。\', \'type\': \'生物 ～龍／骷髏妖\', \'flavor\': \'身上骨骸敲擊，便是其咆哮怒吼。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450034&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6c4311ec-5d84-41ee-8a80-5fab77d7634b\', \'multiverseId\': 450034}, \'multiverseid\': 450034}]', '[{\'name\': \'Kolossale Erhabenheit\', \'text\': \'Zu Beginn deines Versorgungssegments und falls du eine Kreatur mit Stärke 4 oder mehr kontrollierst, ziehe eine Karte.\', \'type\': \'Verzauberung\', \'flavor\': \'„Macht errichtet nicht nur Imperien. Sie beschützt sie auch."\\n—Inti, Ritter des Imperiums der Sonne\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447590&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1ba5e5ee-9f83-49f8-a0af-dccdd5e3afe4\', \'multiverseId\': 447590}, \'multiverseid\': 447590}, {\'name\': \'Majestad colosal\', \'text\': \'Al comienzo de tu mantenimiento, si controlas una criatura con fuerza de 4 o más, roba una carta.\', \'type\': \'Encantamiento\', \'flavor\': \'"El poder no solo erige imperios, también los protege".\\n—Inti, caballero del Imperio del Sol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447871&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ad6ecef9-4d2f-4e1f-8a2b-50bc34f666d7\', \'multiverseId\': 447871}, \'multiverseid\': 447871}, {\'name\': \'Majesté colossale\', \'text\': \'Au début de votre entretien, si vous contrôlez une créature de force supérieure ou égale à 4, piochez une carte.\', \'type\': \'Enchantement\', \'flavor\': "« La puissance ne construit pas simplement des empires. Elle les protège. »\\n—Inti, chevalier de l\'Empire du Soleil", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448152&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'203306c4-13bb-48a4-b299-0c996f0fe0c1\', \'multiverseId\': 448152}, \'multiverseid\': 448152}, {\'name\': \'Maestà Colossale\', \'text\': "All\'inizio del tuo mantenimento, se controlli una creatura con forza pari o superiore a 4, pesca una carta.", \'type\': \'Incantesimo\', \'flavor\': \'"La potenza non si limita a costruire imperi. Deve anche proteggerli."\\n—Inti, cavaliere dell\\\'Impero del Sole\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448433&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e41fed7c-bfb3-4065-bb79-e41c29aa7862\', \'multiverseId\': 448433}, \'multiverseid\': 448433}, {\'name\': \'巨大な威厳\', \'text\': \'あなたのアップキープの開始時に、あなたがパワーが４以上のクリーチャーをコントロールしている場合、カードを１枚引く。\', \'type\': \'エンチャント\', \'flavor\': \'「覇権は帝国を作り上げるだけではない。帝国を守っているのだ。」\\n――太陽帝国の騎士、インティ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448714&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7a51c841-9db2-426f-906e-bf9a24a2c99f\', \'multiverseId\': 448714}, \'multiverseid\': 448714}, {\'name\': \'거대한 위엄\', \'text\': \'당신의 유지단 시작에, 당신이 공격력이 4 이상인 생물을 조종한다면, 카드 한 장을 뽑는다.\', \'type\': \'부여마법\', \'flavor\': \'"힘은 제국을 건설하기만 하는 게 아니야. 지켜 주기도 하지."\\n—태양 제국의 기사, 인티\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448995&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'48eb6803-c820-426b-8694-5876dba0d6bf\', \'multiverseId\': 448995}, \'multiverseid\': 448995}, {\'name\': \'Majestade Colossal\', \'text\': \'No início de sua manutenção, se você controlar uma criatura com poder igual ou superior a 4, compre um card.\', \'type\': \'Encantamento\', \'flavor\': \'"A força não apenas constrói impérios. Ela os protege."\\n— Inti, cavaleira do Império do Sol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449276&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b88408f6-b0e0-4a41-8c3b-2ff2becefa8c\', \'multiverseId\': 449276}, \'multiverseid\': 449276}, {\'name\': \'Колоссальное Величие\', \'text\': \'В начале вашего шага поддержки, если вы контролируете существо с силой не менее 4, возьмите карту.\', \'type\': \'Чары\', \'flavor\': \'«Могущество не только строит империи. Оно защищает их».\\n— Инти, рыцарь Империи Солнца\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449557&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e733ad97-7fc1-414e-8cd2-19f2c68371c7\', \'multiverseId\': 449557}, \'multiverseid\': 449557}, {\'name\': \'巨兽扬威\', \'text\': \'在你的维持开始时，若你操控力量等于或大于4的生物，则抓一张牌。\', \'type\': \'结界\', \'flavor\': \'「强威不仅能建立帝国；它还能守护帝国。」\\n～烈阳帝国骑士因缇\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449838&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b7afff69-530c-4d5d-aa6a-a995754fe397\', \'multiverseId\': 449838}, \'multiverseid\': 449838}, {\'name\': \'巨獸揚威\', \'text\': \'在你的維持開始時，若你操控力量等於或大於4的生物，則抽一張牌。\', \'type\': \'結界\', \'flavor\': \'「強威不僅能建立帝國；它還能守護帝國。」\\n～烈陽帝國騎士因緹\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450119&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c86a2831-e078-471f-9abe-76fc20005c8a\', \'multiverseId\': 450119}, \'multiverseid\': 450119}]', '[{\'name\': \'Kolossales Schreckensmaul\', \'text\': \'Verursacht Trampelschaden (Diese Kreatur kann beim Angreifen überschüssigen Kampfschaden dem verteidigenden Spieler oder Planeswalker zufügen.)\', \'type\': \'Kreatur — Dinosaurier\', \'flavor\': \'Wenn die Erde bebt, lauf. Wenn du sein Gebrüll vernimmst, flieh. Wenn du in sein Maul starrst, zu spät …\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447589&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a4a4cee9-569b-41db-8049-210682e37141\', \'multiverseId\': 447589}, \'multiverseid\': 447589}, {\'name\': \'Fauces pavorosas colosal\', \'text\': \'Arrolla. (Esta criatura puede hacer el daño de combate sobrante al jugador o planeswalker al que ataca.)\', \'type\': \'Criatura — Dinosaurio\', \'flavor\': \'Si sientes que la tierra se mueve, corre. Si escuchas su rugido, huye. Si le ves los dientes... ya es demasiado tarde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447870&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'60112bf6-e215-4c4c-9cbb-9eda00ede2da\', \'multiverseId\': 447870}, \'multiverseid\': 447870}, {\'name\': \'Gueuleffroi colossal\', \'text\': "Piétinement (Cette créature peut infliger son surplus de blessures de combat au joueur ou au planeswalker qu\'elle attaque.)", \'type\': \'Créature : dinosaure\', \'flavor\': "Si vous sentez la terre trembler, courez. Si vous entendez son cri, fuyez. Si vous voyez ses dents, c\'est qu\'il est déjà trop tard.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448151&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b0dd2cc1-7d66-44de-99c9-72db72e9194e\', \'multiverseId\': 448151}, \'multiverseid\': 448151}, {\'name\': \'Fauce del Terrore Colossale\', \'text\': \'Travolgere (Questa creatura può infliggere il danno da combattimento in eccesso al giocatore o al planeswalker che sta attaccando.)\', \'type\': \'Creatura — Dinosauro\', \'flavor\': \'Se avverti il terreno tremare, corri. Se senti il suo ruggito, scappa. Se ne vedi i denti, è troppo tardi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448432&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'74460641-ddd3-42de-a801-1611c6ff439a\', \'multiverseId\': 448432}, \'multiverseid\': 448432}, {\'name\': \'巨大な戦慄大口\', \'text\': \'トランプル（このクリーチャーは余剰の戦闘ダメージをこれが攻撃しているプレイヤーかプレインズウォーカーに与えることができる。）\', \'type\': \'クリーチャー — 恐竜\', \'flavor\': \'大地の揺れを感じたら、逃げろ。鳴き声が聞こえたら、逃げろ。歯が見えたら、手遅れだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448713&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bcdd3fcd-3ca9-4bdf-92bb-8ff1b4ecfee4\', \'multiverseId\': 448713}, \'multiverseid\': 448713}, {\'name\': \'거대한 공포턱\', \'text\': \'돌진 (이 생물은 여분의 전투피해를 공격 중인 플레이어 또는 플레인즈워커에게 입힐 수 있다.)\', \'type\': \'생물 — 공룡\', \'flavor\': \'땅의 흔들림이 느껴지면, 도망쳐라. 녀석이 울부짖는 소리가 들리면, 달아나라. 녀석의 이빨이 보인다면, 이미 늦었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448994&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'358b1478-c831-4c64-ac04-5edc5d04f94e\', \'multiverseId\': 448994}, \'multiverseid\': 448994}, {\'name\': \'Bocarra Sinistra Colossal\', \'text\': \'Atropelar (Esta criatura pode causar seu dano de combate excedente ao jogador ou planeswalker que ela estiver atacando.)\', \'type\': \'Criatura — Dinossauro\', \'flavor\': \'Se sentir o chão tremer, corra. Se ouvir seu urro, fuja. Se vir seus dentes, é tarde demais.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449275&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'72926e2d-1516-4bb5-9ebd-eb1273bcfe55\', \'multiverseId\': 449275}, \'multiverseid\': 449275}, {\'name\': \'Исполинский Смертеглот\', \'text\': \'Пробивной удар (Это существо может нанести избыточные боевые повреждения игроку или planeswalker-у, которого атакует.)\', \'type\': \'Существо — Динозавр\', \'flavor\': \'Если чувствуешь, как трясется земля, беги. Если слышишь, как он ревет, спасайся. Если видишь его зубы — уже слишком поздно.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449556&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'eed40b9b-f87f-420a-b44e-19977a1758b4\', \'multiverseId\': 449556}, \'multiverseid\': 449556}, {\'name\': \'庞巨血口龙\', \'text\': \'践踏 （此生物造成之过量战斗伤害能对所攻击的牌手或鹏洛客造成之。）\', \'type\': \'生物 ～恐龙\', \'flavor\': \'如果你感到大地震颤，快跑。如果你听到吼声咆哮，快逃。如果你看到利齿现形，晚了。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449837&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f7651a1c-6870-4809-8022-fc155ff945ac\', \'multiverseId\': 449837}, \'multiverseid\': 449837}, {\'name\': \'龐巨血口龍\', \'text\': \'踐踏（此生物造成之過量戰鬥傷害能對所攻擊的玩家或鵬洛客造成之。）\', \'type\': \'生物 ～恐龍\', \'flavor\': \'如果你感到大地震顫，快跑。如果你聽到吼聲咆哮，快逃。如果你看到利齒現形，晚了。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450118&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4a755012-37dc-4dd8-86d1-74c8c2843a55\', \'multiverseId\': 450118}, \'multiverseid\': 450118}]', '[{\'name\': \'Käfig des Hieromanten\', \'text\': \'Wenn der Käfig des Hieromanten ins Spiel kommt, schicke eine bleibende Karte deiner Wahl, die kein Land ist und die ein Gegner kontrolliert, ins Exil, bis der Käfig des Hieromanten das Spiel verlässt.\', \'type\': \'Verzauberung\', \'flavor\': \'Das Gesetz schützt, aber schränkt auch ein.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447431&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'459ae2ae-354f-426c-8cef-daae4f135b6c\', \'multiverseId\': 447431}, \'multiverseid\': 447431}, {\'name\': \'Jaula de hieromante\', \'text\': \'Cuando la Jaula de hieromante entre al campo de batalla, exilia el permanente objetivo que no sea tierra que controla un oponente hasta que la Jaula de hieromante deje el campo de batalla.\', \'type\': \'Encantamiento\', \'flavor\': \'La ley protege, pero también contiene.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447712&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'183bfd23-56f3-43f0-8121-91070ba79233\', \'multiverseId\': 447712}, \'multiverseid\': 447712}, {\'name\': \'Cage du hiéromancien\', \'text\': "Quand la Cage du hiéromancien arrive sur le champ de bataille, exilez un permanent non-terrain ciblé qu\'un adversaire contrôle jusqu\'à ce que la Cage du hiéromancien quitte le champ de bataille.", \'type\': \'Enchantement\', \'flavor\': \'La loi protège et maîtrise.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447993&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'63b27376-7aba-4ce7-b71c-d0a7c74ea0e5\', \'multiverseId\': 447993}, \'multiverseid\': 447993}, {\'name\': \'Gabbia dello Ieromante\', \'text\': \'Quando la Gabbia dello Ieromante entra nel campo di battaglia, esilia un permanente non terra bersaglio controllato da un avversario finché la Gabbia dello Ieromante non lascia il campo di battaglia.\', \'type\': \'Incantesimo\', \'flavor\': \'La legge reclude per proteggere.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448274&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'264b847e-195c-4b70-af85-49f92d397efb\', \'multiverseId\': 448274}, \'multiverseid\': 448274}, {\'name\': \'秘儀術師の檻\', \'text\': \'秘儀術師の檻が戦場に出たとき、対戦相手がコントロールしていて土地でないパーマネント１つを対象とする。秘儀術師の檻が戦場を離れるまでそれを追放する。\', \'type\': \'エンチャント\', \'flavor\': \'法は守護であるとともに拘束である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448555&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d051cbe8-f71c-4b33-916e-f3d694c1b2f9\', \'multiverseId\': 448555}, \'multiverseid\': 448555}, {\'name\': \'성령술사의 철창\', \'text\': \'성령술사의 철창이 전장에 들어올 때, 상대가 조종하는 대지가 아닌 지속물을 목표로 정한다. 그 지속물을 성령술사의 철창이 전장을 떠날 때까지 추방한다.\', \'type\': \'부여마법\', \'flavor\': \'법은 보호해 주지만 또한 구속도 한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448836&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9927f7f7-3c99-4e12-95f7-c2e49572aa27\', \'multiverseId\': 448836}, \'multiverseid\': 448836}, {\'name\': \'Jaula do Hieromante\', \'text\': \'Quando Jaula do Hieromante entrar no campo de batalha, exile a permanente alvo que não seja terreno que um oponente controla até que Jaula do Hieromante deixe o campo de batalha.\', \'type\': \'Encantamento\', \'flavor\': \'A lei protege, mas também contém.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449117&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b5fd069a-bd38-4ea0-b73d-eafdb81dc727\', \'multiverseId\': 449117}, \'multiverseid\': 449117}, {\'name\': \'Клетка Иероманта\', \'text\': \'Когда Клетка Иероманта выходит на поле битвы, изгоните целевой не являющийся землей перманент под контролем оппонента до тех пор, пока Клетка Иероманта не покинет поле битвы.\', \'type\': \'Чары\', \'flavor\': \'Закон защищает — но он же и сдерживает.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449398&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2c310f22-121e-493c-8cd8-8d72b1e70c01\', \'multiverseId\': 449398}, \'multiverseid\': 449398}, {\'name\': \'圣术士囚笼\', \'text\': \'当圣术士囚笼进战场时，放逐目标由对手操控的非地永久物，直到圣术士囚笼离开战场为止。\', \'type\': \'结界\', \'flavor\': \'法律既有保护，也有惩罚。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449679&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'41db643b-0293-425b-a133-75ca827e2dd8\', \'multiverseId\': 449679}, \'multiverseid\': 449679}, {\'name\': \'聖術士囚籠\', \'text\': \'當聖術士囚籠進戰場時，放逐目標由對手操控的非地永久物，直到聖術士囚籠離開戰場為止。\', \'type\': \'結界\', \'flavor\': \'法律既有保護，也有懲罰。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449960&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d38f2477-c338-4a9f-adf3-510fc2de89f0\', \'multiverseId\': 449960}, \'multiverseid\': 449960}]', '[{\'name\': \'Königlicher Blutfürst\', \'text\': \'Fliegend\\nZu Beginn jedes Endsegments und falls du in diesem Zug Lebenspunkte dazuerhalten hast, erzeuge einen 1/1 schwarzen Fledermaus-Kreaturenspielstein mit Flugfähigkeit.\', \'type\': \'Kreatur — Vampir, Soldat\', \'flavor\': \'Jene von höherer Abstammung erwartet auch Höheres als der Tod.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447640&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dd61de55-f163-4a4e-9dcf-7a1bfb8cf663\', \'multiverseId\': 447640}, \'multiverseid\': 447640}, {\'name\': \'Señor sangriento regio\', \'text\': \'Vuela.\\nAl comienzo de cada paso final, si ganaste vidas este turno, crea una ficha de criatura Murciélago negra 1/1 con la habilidad de volar.\', \'type\': \'Criatura — Soldado vampiro\', \'flavor\': \'Quienes vienen de noble cuna reciben una muerte aún más noble.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447921&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'31e2b1fd-89bb-4edc-b0f5-31f785c24342\', \'multiverseId\': 447921}, \'multiverseid\': 447921}, {\'name\': \'Seigneur de sang royal\', \'text\': \'Vol\\nAu début de chaque étape de fin, si vous avez gagné des points de vie ce tour-ci, créez un jeton de créature 1/1 noire Chauve-souris avec le vol.\', \'type\': \'Créature : vampire et soldat\', \'flavor\': \'Ceux qui ont eu une naissance respectable ont droit à une mort plus que respectable.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448202&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3cd1500f-4bae-47cc-868d-e729b618b042\', \'multiverseId\': 448202}, \'multiverseid\': 448202}, {\'name\': \'Signore Sanguinario Regale\', \'text\': "Volare\\nAll\'inizio di ogni sottofase finale, se hai guadagnato punti vita in questo turno, crea una pedina creatura Pipistrello 1/1 nera con volare.", \'type\': \'Creatura — Soldato Vampiro\', \'flavor\': \'Coloro che sono nobili di nascita meritano una morte altrettanto nobile.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448483&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7e9682b7-9c38-4ed7-bf65-5e5cc7c49c86\', \'multiverseId\': 448483}, \'multiverseid\': 448483}, {\'name\': \'威厳ある血王\', \'text\': \'飛行\\n各終了ステップの開始時に、このターンあなたがライフを得ていた場合、飛行を持つ黒の１/１のコウモリ・クリーチャー・トークンを１体生成する。\', \'type\': \'クリーチャー — 吸血鬼・兵士\', \'flavor\': \'尊厳ある生誕は尊厳ある死を得る。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448764&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'20277fe4-b151-4f72-a10c-27b8d57db6d5\', \'multiverseId\': 448764}, \'multiverseid\': 448764}, {\'name\': \'위풍당당한 혈군주\', \'text\': \'비행\\n각 종료단 시작에, 당신이 이 턴에 생명점을 얻었다면, 비행을 가진 1/1 흑색 박쥐 생물 토큰 한 개를 만든다.\', \'type\': \'생물 — 흡혈귀 병사\', \'flavor\': \'존경받으며 태어난 자들이 가장 존경받는 죽음을 얻는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449045&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'384147f2-ce61-46f5-aeca-d33cd46b8cea\', \'multiverseId\': 449045}, \'multiverseid\': 449045}, {\'name\': \'Senhor Vampiro Régio\', \'text\': \'Voar\\nNo início de cada etapa final, se você ganhou pontos de vida neste turno, crie uma ficha de criatura preta 1/1 do tipo Morcego com voar.\', \'type\': \'Criatura — Vampiro Soldado\', \'flavor\': \'Os de estimado berço recebem a mais estimada morte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449326&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e06220e2-78ce-42fd-a0b2-e4686fb88d1e\', \'multiverseId\': 449326}, \'multiverseid\': 449326}, {\'name\': \'Царственный Кровавый Лорд\', \'text\': \'Полет\\nВ начале каждого заключительного шага, если в этом ходу вы получали жизни, создайте одну фишку существа 1/1 черная Летучая_мышь с Полетом.\', \'type\': \'Существо — Вампир Солдат\', \'flavor\': \'Те, кому довелось родиться в достопочтенной семье, и смерти заслуживают достопочтенной.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449607&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'76ca51fc-3068-46d3-977d-9a2a3b2c140f\', \'multiverseId\': 449607}, \'multiverseid\': 449607}, {\'name\': \'威严血领\', \'text\': \'飞行\\n在每个结束步骤开始时，若本回合中你曾获得生命，则派出一个1/1黑色，具飞行异能的蝙蝠衍生生物。\', \'type\': \'生物 ～吸血鬼／士兵\', \'flavor\': \'生有尊贵身分，死亦华美可期。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449888&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d3bcf7b5-8950-4de7-a8d8-b92df643ce8a\', \'multiverseId\': 449888}, \'multiverseid\': 449888}, {\'name\': \'威嚴血領\', \'text\': \'飛行\\n在每個結束步驟開始時，若本回合中你曾獲得生命，則派出一個1/1黑色，具飛行異能的蝙蝠衍生生物。\', \'type\': \'生物 ～吸血鬼／士兵\', \'flavor\': \'生有尊貴身分，死亦華美可期。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450169&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a4fbee80-958e-447d-8a87-c53c7b9fb903\', \'multiverseId\': 450169}, \'multiverseid\': 450169}]', '[{\'name\': \'Landschaftswechsel\', \'text\': \'Opfere eine beliebige Anzahl an Ländern. Durchsuche deine Bibliothek nach bis zu entsprechend vielen Länderkarten, bringe sie getappt ins Spiel und mische dann deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': \'„Ob es uns nun gefällt oder nicht, unsere Ankunft hat die Landschaft nachhaltig verändert."\\n—Malcolm, Navigator der Streitlustigen\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447618&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'be6878a5-bc86-4447-85c6-31bb6cb773b8\', \'multiverseId\': 447618}, \'multiverseid\': 447618}, {\'name\': \'Cambio de paisaje\', \'text\': \'Sacrifica cualquier cantidad de tierras. Busca en tu biblioteca hasta esa cantidad de cartas de tierra, ponlas en el campo de batalla giradas y luego baraja tu biblioteca.\', \'type\': \'Conjuro\', \'flavor\': \'"Nos guste o no, nuestra llegada alteró el ecosistema".\\n—Malcolm, timonel del Beligerante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447899&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d0db1b3b-e95a-4df8-9f98-c057fd7c97a5\', \'multiverseId\': 447899}, \'multiverseid\': 447899}, {\'name\': \'Changelieu\', \'text\': "Sacrifiez n\'importe quel nombre de terrains. Cherchez dans votre bibliothèque jusqu\'au même nombre de cartes de terrain, mettez-les sur le champ de bataille engagées et mélangez votre bibliothèque.", \'type\': \'Rituel\', \'flavor\': "« Qu\'on le veuille ou non, notre arrivée à modifié le paysage. »\\n—Malcolm, navigateur sur Le Belligérant", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448180&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2ca44d07-fe0c-48bf-ab02-6c53d4e4208c\', \'multiverseId\': 448180}, \'multiverseid\': 448180}, {\'name\': \'Morforama\', \'text\': \'Sacrifica un qualsiasi numero di terre. Passa in rassegna il tuo grimorio per trovare fino ad altrettante carte terra, mettile sul campo di battaglia TAPpate, poi rimescola il tuo grimorio.\', \'type\': \'Stregoneria\', \'flavor\': \'"Che ci piaccia o no, il panorama è cambiato dopo il nostro arrivo."\\n—Malcolm, navigatore della Belligerante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448461&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fb22a541-575f-4cfe-8f6a-b5bef3bbd884\', \'multiverseId\': 448461}, \'multiverseid\': 448461}, {\'name\': \'風景の変容\', \'text\': \'望む数の土地を生け贄に捧げる。あなたのライブラリーから、その数以下の枚数の土地・カードを探してタップ状態で戦場に出し、その後あなたのライブラリーを切り直す。\', \'type\': \'ソーサリー\', \'flavor\': \'「良し悪しは別として、我々の到着は風景を変えてしまった。」\\n――「喧嘩腰」号の航海士、マルコム\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448742&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ac420911-6efd-4d4c-9a28-fa35f918964a\', \'multiverseId\': 448742}, \'multiverseid\': 448742}, {\'name\': \'풍경 변화\', \'text\': \'대지를 원하는 수만큼 희생한다. 당신의 서고에서 대지 카드를 최대 그만큼 찾아, 전장에 탭된 채로 놓은 후, 당신의 서고를 섞는다.\', \'type\': \'집중마법\', \'flavor\': \'"좋든 싫든, 우리가 도착해서 지형이 변했습니다."\\n—교전 집단의 항해사, 말콤\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449023&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'876675e9-fffc-4cf0-8a9b-13c12ae14e54\', \'multiverseId\': 449023}, \'multiverseid\': 449023}, {\'name\': \'Metapaisagem\', \'text\': \'Sacrifique um número qualquer de terrenos. Procure aquela quantidade de cards de terreno em seu grimório, coloque-os no campo de batalha virados e depois embaralhe seu grimório.\', \'type\': \'Feitiço\', \'flavor\': \'"Gostemos ou não, nossa chegada alterou a paisagem."\\n— Malcolm, navegador do Beligerante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449304&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'81e313b8-ed16-45d2-9f34-810570946f5d\', \'multiverseId\': 449304}, \'multiverseid\': 449304}, {\'name\': \'Местоизменение\', \'text\': \'Пожертвуйте любое количество земель. Найдите в вашей библиотеке не более такого же количества карт земель, положите их на поле битвы повернутыми, затем перетасуйте вашу библиотеку.\', \'type\': \'Волшебство\', \'flavor\': \'«Нравится нам это или нет, но наше появление изменило здешний ландшафт».\\n— Малкольм, штурман «Буяна»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449585&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'508d2041-5ffb-4321-b5d9-bd775dc5ad4b\', \'multiverseId\': 449585}, \'multiverseid\': 449585}, {\'name\': \'变境\', \'text\': \'牺牲任意数量的地。从你的牌库中搜寻至多该数量的地牌，将它们横置进战场，然后将你的牌库洗牌。\', \'type\': \'法术\', \'flavor\': \'「不管怎样，我们的到来已经改变了地境。」\\n～好战者号领航员马科姆\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449866&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a40bab65-0fd4-499b-b7ed-fcd030108e08\', \'multiverseId\': 449866}, \'multiverseid\': 449866}, {\'name\': \'變境\', \'text\': \'犧牲任意數量的地。從你的牌庫中搜尋至多該數量的地牌，將它們橫置進戰場，然後將你的牌庫洗牌。\', \'type\': \'巫術\', \'flavor\': \'「不管怎樣，我們的到來已經改變了地境。」\\n～好戰者號領航員馬科姆\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450147&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'144367d3-b9af-4cd1-8524-8af290d0ea43\', \'multiverseId\': 450147}, \'multiverseid\': 450147}]', '[{\'name\': \'Lathliss, Königin der Drachen\', \'text\': \'Fliegend\\nImmer wenn ein anderer Nichtspielstein-Drache unter deiner Kontrolle ins Spiel kommt, erzeuge einen 5/5 roten Drache-Kreaturenspielstein mit Flugfähigkeit.\\n{1}{R}: Drachen, die du kontrollierst, erhalten +1/+0 bis zum Ende des Zuges.\', \'type\': \'Legendäre Kreatur — Drache\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447566&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'adb3ecbb-002d-4af1-aded-9677f6f23e38\', \'multiverseId\': 447566}, \'multiverseid\': 447566}, {\'name\': \'Lathliss, reina dragón\', \'text\': \'Vuela.\\nSiempre que otro Dragón que no sea ficha entre al campo de batalla bajo tu control, crea una ficha de criatura Dragón roja 5/5 con la habilidad de volar.\\n{1}{R}: Los Dragones que controlas obtienen +1/+0 hasta el final del turno.\', \'type\': \'Criatura legendaria — Dragón\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447847&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4e1ac4bb-2607-4639-8533-214d05d61ff4\', \'multiverseId\': 447847}, \'multiverseid\': 447847}, {\'name\': \'Lathliss, reine des dragons\', \'text\': "Vol\\nÀ chaque fois qu\'un autre dragon non-jeton arrive sur le champ de bataille sous votre contrôle, créez un jeton de créature 5/5 rouge Dragon avec le vol.\\n{1}{R} : Les dragons que vous contrôlez gagnent +1/+0 jusqu\'à la fin du tour.", \'type\': \'Créature légendaire : dragon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448128&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1f0c8c37-a94b-4045-8d7b-7ddc51ddd60b\', \'multiverseId\': 448128}, \'multiverseid\': 448128}, {\'name\': \'Lathliss, Regina dei Draghi\', \'text\': \'Volare\\nOgniqualvolta un altro Drago non pedina entra nel campo di battaglia sotto il tuo controllo, crea una pedina creatura Drago 5/5 rossa con volare.\\n{1}{R}: I Draghi che controlli prendono +1/+0 fino alla fine del turno.\', \'type\': \'Creatura Leggendaria — Drago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448409&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6a93060b-ec04-464e-88e2-2cf6f18ac8b4\', \'multiverseId\': 448409}, \'multiverseid\': 448409}, {\'name\': \'ドラゴンの女王、ラスリス\', \'text\': \'飛行\\nトークンでない他のドラゴンが１体あなたのコントロール下で戦場に出るたび、飛行を持つ赤の５/５のドラゴン・クリーチャー・トークンを１体生成する。\\n{1}{R}：ターン終了時まで、あなたがコントロールしているドラゴンは＋１/＋０の修整を受ける。\', \'type\': \'伝説のクリーチャー — ドラゴン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448690&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'671c9a07-2a76-4c4d-9c64-10b5ebbbffe7\', \'multiverseId\': 448690}, \'multiverseid\': 448690}, {\'name\': \'용의 여왕, 라틀리스\', \'text\': \'비행\\n다른 토큰이 아닌 용이 당신의 조종하에 전장에 들어올 때마다, 비행을 가진 5/5 적색 용 생물 토큰 한 개를 만든다.\\n{1}{R}: 당신이 조종하는 용들은 턴종료까지 +1/+0을 받는다.\', \'type\': \'전설적 생물 — 용\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448971&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'893800cb-d9bf-46c8-9860-ba85e2de57a7\', \'multiverseId\': 448971}, \'multiverseid\': 448971}, {\'name\': \'Lathliss, Rainha dos Dragões\', \'text\': \'Voar\\nToda vez que outro Dragão que não seja uma ficha entrar no campo de batalha sob o seu controle, crie uma ficha de criatura vermelha 5/5 do tipo Dragão com voar.\\n{1}{R}: Os Dragões que você controla recebem +1/+0 até o final do turno.\', \'type\': \'Criatura Lendária — Dragão\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449252&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3e52a614-f779-458a-9617-f2b0b4f8cbcb\', \'multiverseId\': 449252}, \'multiverseid\': 449252}, {\'name\': \'Латлисс, Королева Драконов\', \'text\': \'Полет\\nКаждый раз, когда другой не являющийся фишкой Дракон выходит на поле битвы под вашим контролем, создайте одну фишку существа 5/5 красный Дракон с Полетом.\\n{1}{R}: Драконы под вашим контролем получают +1/+0 до конца хода.\', \'type\': \'Легендарное Существо — Дракон\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449533&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'85641a77-b198-4905-8b8e-bb67ff19d8cd\', \'multiverseId\': 449533}, \'multiverseid\': 449533}, {\'name\': \'龙后拉黎丝\', \'text\': \'飞行\\n每当另一个非衍生物的龙在你的操控下进战场时，派出一个5/5红色，具飞行异能的龙衍生生物。\\n{1}{R}：由你操控的龙得+1/+0直到回合结束。\', \'type\': \'传奇生物 ～龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449814&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'55c17d53-e30a-4deb-8fce-54bded74d1b8\', \'multiverseId\': 449814}, \'multiverseid\': 449814}, {\'name\': \'龍后拉黎絲\', \'text\': \'飛行\\n每當另一個非衍生物的龍在你的操控下進戰場時，派出一個5/5紅色，具飛行異能的龍衍生生物。\\n{1}{R}：由你操控的龍得+1/+0直到回合結束。\', \'type\': \'傳奇生物 ～龍\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450095&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'92a0b898-099a-45f4-835e-1c265c78a024\', \'multiverseId\': 450095}, \'multiverseid\': 450095}]', '[{\'name\': \'Lavaaxt\', \'text\': \'Die Lavaaxt fügt einem Spieler oder Planeswalker deiner Wahl 5 Schadenspunkte zu.\', \'type\': \'Hexerei\', \'flavor\': \'„Fang!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447567&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'61015b12-890f-40b8-b22a-1df423ff4b0a\', \'multiverseId\': 447567}, \'multiverseid\': 447567}, {\'name\': \'Hacha de lava\', \'text\': \'El Hacha de lava hace 5 puntos de daño al jugador o planeswalker objetivo.\', \'type\': \'Conjuro\', \'flavor\': \'"¡Atrapa!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447848&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'40003269-c5e3-4c5f-9980-9dc4efc8bbdc\', \'multiverseId\': 447848}, \'multiverseid\': 447848}, {\'name\': \'Hache de lave\', \'text\': \'La Hache de lave inflige 5 blessures à une cible, joueur ou planeswalker.\', \'type\': \'Rituel\', \'flavor\': \'« Attrape ! »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448129&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cddc202b-3cdd-4a07-8d59-3b33e94c12d9\', \'multiverseId\': 448129}, \'multiverseid\': 448129}, {\'name\': \'Ascia di Lava\', \'text\': "L\'Ascia di Lava infligge 5 danni a un giocatore o a un planeswalker bersaglio.", \'type\': \'Stregoneria\', \'flavor\': \'"Lascia!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448410&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'593f6fbf-bb63-4203-bd30-fe9709acd3d9\', \'multiverseId\': 448410}, \'multiverseid\': 448410}, {\'name\': \'溶岩の斧\', \'text\': \'プレイヤー１人かプレインズウォーカー１体を対象とする。溶岩の斧はそれに５点のダメージを与える。\', \'type\': \'ソーサリー\', \'flavor\': \'「そらよッ！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448691&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'032a0f66-472a-4e6d-89d1-d771c3857694\', \'multiverseId\': 448691}, \'multiverseid\': 448691}, {\'name\': \'용암도끼\', \'text\': \'플레이어 또는 플레인즈워커를 목표로 정한다. 용암도끼는 그 목표에게 피해 5점을 입힌다.\', \'type\': \'집중마법\', \'flavor\': \'"잡아!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448972&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'45ff0122-6144-4caa-974f-8d5050c813cf\', \'multiverseId\': 448972}, \'multiverseid\': 448972}, {\'name\': \'Machado de Lava\', \'text\': \'Machado de Lava causa 5 pontos de dano ao jogador ou planeswalker alvo.\', \'type\': \'Feitiço\', \'flavor\': \'"Pega!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449253&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ba180133-20e0-4bae-aeda-62a762e744e4\', \'multiverseId\': 449253}, \'multiverseid\': 449253}, {\'name\': \'Топор из Лавы\', \'text\': \'Топор из Лавы наносит 5 повреждений целевому игроку или planeswalker-у.\', \'type\': \'Волшебство\', \'flavor\': \'«Лови!»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449534&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bb61bf87-58ae-4845-bc1b-3ee8b85623b9\', \'multiverseId\': 449534}, \'multiverseid\': 449534}, {\'name\': \'熔岩斧\', \'text\': \'熔岩斧对目标牌手或鹏洛客造成5点伤害。\', \'type\': \'法术\', \'flavor\': \'「接招！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449815&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d2ddea7e-7fcf-41b3-af79-24c7aca3696b\', \'multiverseId\': 449815}, \'multiverseid\': 449815}, {\'name\': \'熔岩斧\', \'text\': \'熔岩斧對目標玩家或鵬洛客造成5點傷害。\', \'type\': \'巫術\', \'flavor\': \'「接招！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450096&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3bf592f2-9d41-405a-9074-399a8126f3ad\', \'multiverseId\': 450096}, \'multiverseid\': 450096}]', '[{\'name\': \'Lena, selbstloser Champion\', \'text\': \'Wenn Lena, selbstloser Champion, ins Spiel kommt, erzeuge für jede Nichtspielsteinkreatur, die du kontrollierst, einen 1/1 weißen Soldat-Kreaturenspielstein.\\nOpfere Lena: Kreaturen, die du kontrollierst und deren Stärke kleiner ist als die Stärke von Lena, erhalten Unzerstörbarkeit bis zum Ende des Zuges.\', \'type\': \'Legendäre Kreatur — Mensch, Ritter\', \'flavor\': \'„Jene, die Böses tun, und solche, die gar nichts tun, haben gleichermaßen nur Verachtung verdient."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447438&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c674c3c8-4a25-45cb-9b83-8f24d07d1da9\', \'multiverseId\': 447438}, \'multiverseid\': 447438}, {\'name\': \'Lena, campeona abnegada\', \'text\': \'Cuando Lena, campeona abnegada entre al campo de batalla, crea una ficha de criatura Soldado blanca 1/1 por cada criatura que no sea ficha que controlas.\\nSacrificar a Lena: Las criaturas que controlas con fuerza menor que la fuerza de Lena ganan la habilidad de indestructible hasta el final del turno.\', \'type\': \'Criatura legendaria — Caballero humano\', \'flavor\': \'"Quienes hacen el mal y quienes no hacen nada se merecen el mismo desprecio".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447719&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'474bca5e-fdaa-40b9-b3f0-92feddac91ae\', \'multiverseId\': 447719}, \'multiverseid\': 447719}, {\'name\': \'Lena, championne dévouée\', \'text\': "Quand Lena, championne dévouée arrive sur le champ de bataille, créez un jeton de créature 1/1 blanche Soldat pour chaque créature non-jeton que vous contrôlez.\\nSacrifiez Lena : Les créatures que vous contrôlez de force inférieure à celle de Lena acquièrent l\'indestructible jusqu\'à la fin du tour.", \'type\': \'Créature légendaire : humain et chevalier\', \'flavor\': \'« Ceux qui font le mal et ceux qui ne font rien méritent autant mon mépris. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448000&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a009f81c-16ed-4560-8abe-704bac6dd494\', \'multiverseId\': 448000}, \'multiverseid\': 448000}, {\'name\': \'Lena, Campionessa Altruista\', \'text\': \'Quando Lena, Campionessa Altruista entra nel campo di battaglia, crea una pedina creatura Soldato 1/1 bianca per ogni creatura non pedina che controlli.\\nSacrifica Lena: Le creature che controlli con forza inferiore alla forza di Lena hanno indistruttibile fino alla fine del turno.\', \'type\': \'Creatura Leggendaria — Cavaliere Umano\', \'flavor\': \'"Gli ignavi sono meritevoli di disprezzo tanto quanto i malvagi."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448281&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'735e6682-57f3-4253-9ef3-1cc6c0f77c54\', \'multiverseId\': 448281}, \'multiverseid\': 448281}, {\'name\': \'無私の勇者、レナ\', \'text\': \'無私の勇者、レナが戦場に出たとき、あなたがコントロールしていてトークンでないクリーチャー１体につき、白の１/１の兵士・クリーチャー・トークンを１体生成する。\\n無私の勇者、レナを生け贄に捧げる：ターン終了時まで、あなたがコントロールしていて、無私の勇者、レナよりもパワーが小さいクリーチャーは、破壊不能を得る。\', \'type\': \'伝説のクリーチャー — 人間・騎士\', \'flavor\': \'「悪を行う者も、何も行わない者も、等しく侮蔑に値する。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448562&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'db3e9f13-328c-4b47-b998-fb33892ed0c1\', \'multiverseId\': 448562}, \'multiverseid\': 448562}, {\'name\': \'헌신적인 용사, 레나\', \'text\': \'헌신적인 용사, 레나가 전장에 들어올 때, 당신이 조종하는 토큰이 아닌 각 생물마다 1/1 백색 병사 생물 토큰 한 개를 만든다.\\n레나를 희생한다: 레나보다 공격력이 낮은 당신이 조종하는 생물들은 턴종료까지 무적을 얻는다.\', \'type\': \'전설적 생물 — 인간 기사\', \'flavor\': \'"악을 행하는 자들과 아무 것도 하지 않는 자들은 똑같이 비난받아 마땅하다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448843&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ab143907-c9fd-4d5c-9328-e884cd17b385\', \'multiverseId\': 448843}, \'multiverseid\': 448843}, {\'name\': \'Lena, Campeã Altruísta\', \'text\': \'Quando Lena, Campeã Altruísta, entrar no campo de batalha, crie uma ficha de criatura branca 1/1 do tipo Soldado para cada criatura que você controla que não seja uma ficha.\\nSacrifique Lena: As criaturas que você controla com poder menor que o de Lena ganham indestrutível até o final do turno.\', \'type\': \'Criatura Lendária — Humano Cavaleiro\', \'flavor\': \'"Os que praticam o mal e os que nada fazem são igualmente merecedores de desprezo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449124&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2f6bc58c-90a9-4a3b-a007-c78adf3dc3b4\', \'multiverseId\': 449124}, \'multiverseid\': 449124}, {\'name\': \'Лина, Самоотверженная Заступница\', \'text\': \'Когда Лина, Самоотверженная Заступница выходит на поле битвы, создайте одну фишку существа 1/1 белый Солдат за каждое не являющееся фишкой существо под вашим контролем.\\nПожертвуйте Лину: существа под вашим контролем с силой меньше, чем сила Лины, получают Неразрушимость до конца хода.\', \'type\': \'Легендарное Существо — Человек Рыцарь\', \'flavor\': \'«Те, кто делают зло, и те, кто не делают ничего, одинаково достойны презрения».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449405&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1e97308f-934f-4a71-bb0e-670b96bc5c56\', \'multiverseId\': 449405}, \'multiverseid\': 449405}, {\'name\': \'无私斗士莉娜\', \'text\': \'当无私斗士莉娜进战场时，你每操控一个非衍生物的生物，便派出一个1/1白色士兵衍生生物。\\n牺牲莉娜：由你操控且力量小于莉娜的生物获得不灭异能直到回合结束。\', \'type\': \'传奇生物 ～人类／骑士\', \'flavor\': \'「旁观者与作恶者无异，都应遭人唾弃。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449686&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2218ac83-ddf7-415a-9640-64bd5e947356\', \'multiverseId\': 449686}, \'multiverseid\': 449686}, {\'name\': \'無私鬥士莉娜\', \'text\': \'當無私鬥士莉娜進戰場時，你每操控一個非衍生物的生物，便派出一個1/1白色士兵衍生生物。\\n犧牲莉娜：由你操控且力量小於莉娜的生物獲得不滅異能直到回合結束。\', \'type\': \'傳奇生物 ～人類／騎士\', \'flavor\': \'「旁觀者與作惡者無異，都應遭人唾棄。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449967&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'59e79b1c-89c7-4b6e-abe0-9792dd2bb797\', \'multiverseId\': 449967}, \'multiverseid\': 449967}]', "[{'name': 'Leoniden-Kriegsführer', 'text': 'Immer wenn der Leoniden-Kriegsführer angreift, erzeuge zwei getappte und angreifende 1/1 weiße Katze-Kreaturenspielsteine mit Lebensverknüpfung.', 'type': 'Kreatur — Katze, Soldat', 'flavor': 'Wenn ein Leonide auf die Jagd geht, ist sein Rudel gewiss nicht fern.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447440&type=card', 'language': 'German', 'identifiers': {'scryfallId': '18526286-7214-4945-9c6a-3a3565db7859', 'multiverseId': 447440}, 'multiverseid': 447440}, {'name': 'Líder de guerra leonino', 'text': 'Siempre que el Líder de guerra leonino ataque, crea dos fichas de criatura Felino blancas 1/1 con la habilidad de vínculo vital giradas y atacando.', 'type': 'Criatura — Soldado felino', 'flavor': 'Cuando un leonino sale a cazar, hay muchos más en las cercanías.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447721&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'f5edb6f4-c84c-4428-aaa8-6f37061be93e', 'multiverseId': 447721}, 'multiverseid': 447721}, {'name': 'Chef de guerre léonin', 'text': 'À chaque fois que le Chef de guerre léonin attaque, créez deux jetons de créature 1/1 blanche Chat avec le lien de vie, engagés et attaquants.', 'type': 'Créature : chat et soldat', 'flavor': 'Un léonin chasse rarement seul.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448002&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd7ab5dd3-f95c-43a0-85c2-f90fbee367c5', 'multiverseId': 448002}, 'multiverseid': 448002}, {'name': 'Condottiero Leonid', 'text': 'Ogniqualvolta il Condottiero Leonid attacca, crea due pedine creatura Felino 1/1 bianche con legame vitale TAPpate e attaccanti.', 'type': 'Creatura — Soldato Felino', 'flavor': 'Un leonid non va mai a caccia da solo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448283&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b261931d-b66b-4040-8089-7b815516640d', 'multiverseId': 448283}, 'multiverseid': 448283}, {'name': 'レオニンの戦導者', 'text': 'レオニンの戦導者が攻撃するたび、絆魂を持つ白の１/１の猫・クリーチャー・トークンを２体タップ状態で攻撃している状態で生成する。', 'type': 'クリーチャー — 猫・兵士', 'flavor': '狩りをするレオニンを１人見かけたら、必ず近くにもっといる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448564&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'c1458fe6-5ebd-4c55-9548-758d4ca27fe2', 'multiverseId': 448564}, 'multiverseid': 448564}, {'name': '레오닌 전장사령관', 'text': '레오닌 전장사령관이 공격할 때마다, 탭되어 공격 중인 생명연결을 가진 1/1 백색 고양이 생물 토큰 두 개를 만든다.', 'type': '생물 — 고양이 병사', 'flavor': '레오닌 하나가 사냥을 할 때는, 근처에 분명히 더 많은 무리가 있다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448845&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '99ed1318-8217-498a-8e44-cceeb220edfb', 'multiverseId': 448845}, 'multiverseid': 448845}, {'name': 'Líder de Guerra Leonino', 'text': 'Toda vez que Líder de Guerra Leonino atacar, crie duas fichas de criatura branca 1/1 do tipo Felino com vínculo com a vida viradas e atacando.', 'type': 'Criatura — Felino Soldado', 'flavor': 'Quando um leonino caça, certamente há muitos outros por perto.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449126&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9af48e50-9e3b-46fe-93a3-9732579a8049', 'multiverseId': 449126}, 'multiverseid': 449126}, {'name': 'Леонинский Военачальник', 'text': 'Каждый раз, когда Леонинский Военачальник атакует, создайте две фишки существа 1/1 белая Кошка с Цепью жизни повернутыми и атакующими.', 'type': 'Существо — Кошка Солдат', 'flavor': 'Если один леонинец охотится, то остальные где-то неподалеку.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449407&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'c2986e34-2375-42af-9817-9d1fef002806', 'multiverseId': 449407}, 'multiverseid': 449407}, {'name': '领战狮族', 'text': '每当领战狮族攻击时，派出两个1/1白色，具系命异能的猫衍生生物，它们为横置且正进行攻击。', 'type': '生物 ～猫／士兵', 'flavor': '狮族一人狩猎，多人必不远之。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449688&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '510f806a-183d-4960-94ad-27d24ab46471', 'multiverseId': 449688}, 'multiverseid': 449688}, {'name': '領戰獅族', 'text': '每當領戰獅族攻擊時，派出兩個1/1白色，具繫命異能的貓衍生生物，它們為橫置且正進行攻擊。', 'type': '生物 ～貓／士兵', 'flavor': '獅族一人狩獵，多人必不遠之。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449969&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '9c3df7fd-0cbd-490e-a923-c126cde8939c', 'multiverseId': 449969}, 'multiverseid': 449969}]", '[{\'name\': \'Leoniden-Vorhut\', \'text\': \'Zu Beginn des Kampfes in deinem Zug und falls du drei oder mehr Kreaturen kontrollierst, erhält die Leoniden-Vorhut +1/+1 bis zum Ende des Zuges und du erhältst 1 Lebenspunkt dazu.\', \'type\': \'Kreatur — Katze, Soldat\', \'flavor\': \'Die besten Kämpfer sind geübt im Töten und im Heilen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447439&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e409af98-82dd-47b7-a229-945a7e9f2107\', \'multiverseId\': 447439}, \'multiverseid\': 447439}, {\'name\': \'Vanguardia leonina\', \'text\': \'Al comienzo del combate en tu turno, si controlas tres o más criaturas, la Vanguardia leonina obtiene +1/+1 hasta el final del turno y ganas 1 vida.\', \'type\': \'Criatura — Soldado felino\', \'flavor\': \'Los mejores luchadores saben tanto de herir como de curar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447720&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'95910503-dc57-4c91-93db-adea57335a95\', \'multiverseId\': 447720}, \'multiverseid\': 447720}, {\'name\': \'Avant-garde léonine\', \'text\': "Au début du combat pendant votre tour, si vous contrôlez au moins trois créatures, l\'Avant-garde léonine gagne +1/+1 jusqu\'à la fin du tour et vous gagnez 1 point de vie.", \'type\': \'Créature : chat et soldat\', \'flavor\': \'Les meilleurs guerriers savent aussi bien blesser que soigner.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448001&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'542d6f47-8e54-4f03-ab90-c9b52796eb1b\', \'multiverseId\': 448001}, \'multiverseid\': 448001}, {\'name\': \'Avanguardia Leonid\', \'text\': "All\'inizio del combattimento nel tuo turno, se controlli tre o più creature, l\'Avanguardia Leonid prende +1/+1 fino alla fine del turno e tu guadagni 1 punto vita.", \'type\': \'Creatura — Soldato Felino\', \'flavor\': \'I migliori combattenti sono abili nel ferire quanto nel curare.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448282&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b91fbb4e-ce88-42da-ad5f-14be6e717c01\', \'multiverseId\': 448282}, \'multiverseid\': 448282}, {\'name\': \'レオニンの先兵\', \'text\': \'あなたのターンの戦闘の開始時に、あなたが３体以上のクリーチャーをコントロールしている場合、ターン終了時まで、レオニンの先兵は＋１/＋１の修整を受ける。あなたは１点のライフを得る。\', \'type\': \'クリーチャー — 猫・兵士\', \'flavor\': \'最強の戦士は、傷をつけるのにも癒すのにも長けている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448563&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6bfdb7f6-3622-484e-99f6-9608eb17ae8c\', \'multiverseId\': 448563}, \'multiverseid\': 448563}, {\'name\': \'레오닌 선봉대\', \'text\': \'당신의 턴 전투 시작에, 당신이 생물을 세 개 이상 조종한다면, 레오닌 선봉대는 턴종료까지 +1/+1을 받고 당신은 생명 1점을 얻는다.\', \'type\': \'생물 — 고양이 병사\', \'flavor\': \'최고의 투사는 상처를 입히는 것도 치료하는 것도 능숙하다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448844&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f4b35f0a-a1c7-4333-b1a5-6504f8a15df3\', \'multiverseId\': 448844}, \'multiverseid\': 448844}, {\'name\': \'Vanguardeira Leonina\', \'text\': \'No início do combate no seu turno, se você controlar três ou mais criaturas, Vanguardeira Leonina receberá +1/+1 até o final do turno e você ganhará 1 ponto de vida.\', \'type\': \'Criatura — Felino Soldado\', \'flavor\': \'Os melhores combatentes são habilidosos tanto para ferir quanto para curar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449125&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5317e14b-6926-452c-ac89-c8d81b95cacc\', \'multiverseId\': 449125}, \'multiverseid\': 449125}, {\'name\': \'Леонинский Авангард\', \'text\': \'В начале боя во время вашего хода, если вы контролируете не менее трех существ, Леонинский Авангард получает +1/+1 до конца хода, а вы получаете 1 жизнь.\', \'type\': \'Существо — Кошка Солдат\', \'flavor\': \'Лучшие бойцы искусны и в нанесении ран, и в лечении.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449406&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ccaa5846-2f52-4a79-ad1a-fbe15311187d\', \'multiverseId\': 449406}, \'multiverseid\': 449406}, {\'name\': \'狮族先锋\', \'text\': \'在你回合的战斗开始时，若你操控三个或更多生物，则狮族先锋得+1/+1直到回合结束，且你获得1点生命。\', \'type\': \'生物 ～猫／士兵\', \'flavor\': \'最优秀的战士既善于致伤，亦精于治伤。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449687&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5bd5578c-f150-4a67-9c49-0b0003d606d1\', \'multiverseId\': 449687}, \'multiverseid\': 449687}, {\'name\': \'獅族先鋒\', \'text\': \'在你回合的戰鬥開始時，若你操控三個或更多生物，則獅族先鋒得+1/+1直到回合結束，且你獲得1點生命。\', \'type\': \'生物 ～貓／士兵\', \'flavor\': \'最優秀的戰士既善於致傷，亦精於治傷。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449968&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'79bb1b65-a970-4cf0-86ac-a646823271c1\', \'multiverseId\': 449968}, \'multiverseid\': 449968}]', '[{\'name\': \'Leuchtende Fesseln\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur kann nicht angreifen oder blocken.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Dieser Kampf ist für dich zu Ende, Vampir. Gewöhne dich besser an deinen Durst."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447442&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c05525d2-acff-4c9c-974c-9a6172b2b613\', \'multiverseId\': 447442}, \'multiverseid\': 447442}, {\'name\': \'Ataduras luminosas\', \'text\': \'Encantar criatura.\\nLa criatura encantada no puede atacar ni bloquear.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"Ya cumpliste tu papel en esta batalla, vampiro. Ahora acostúmbrate a tu sed".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447723&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'31458030-1861-427d-b9ee-5151f78f4ae6\', \'multiverseId\': 447723}, \'multiverseid\': 447723}, {\'name\': \'Liens lumineux\', \'text\': \'Enchanter : créature\\nLa créature enchantée ne peut ni attaquer ni bloquer.\', \'type\': \'Enchantement : aura\', \'flavor\': \'« Ton rôle dans ce combat est terminé, vampire. Habitue-toi à ta soif. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448004&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5b3add5f-dbcf-40b8-a8d3-3b76891dea6a\', \'multiverseId\': 448004}, \'multiverseid\': 448004}, {\'name\': \'Vincoli Luminosi\', \'text\': \'Incanta creatura\\nLa creatura incantata non può attaccare o bloccare.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"La tua parte in questa battaglia è terminata, vampiro. Ora abituati alla tua sete."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448285&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1b20797b-3ec1-4843-9dce-0e01813a6e81\', \'multiverseId\': 448285}, \'multiverseid\': 448285}, {\'name\': \'光明の縛め\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーでは攻撃もブロックもできない。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「吸血鬼よ、お前の出番は終わりました。せいぜい渇望に慣れなさい。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448566&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6ba8b600-d6d2-46c7-a4a9-6e3c9e0bc6d4\', \'multiverseId\': 448566}, \'multiverseid\': 448566}, {\'name\': \'빛나는 구속\', \'text\': \'생물에게 부여\\n부여된 생물은 공격하거나 방어할 수 없다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'"이 전투에서 네 역할은 끝났다, 흡혈귀야. 갈증에 익숙해지도록 해라."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448847&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'da2f36a9-fa92-428f-96f8-7f8aa2600de8\', \'multiverseId\': 448847}, \'multiverseid\': 448847}, {\'name\': \'Amarras Luminosas\', \'text\': \'Encantar criatura\\nA criatura encantada não pode atacar nem bloquear.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Sua participação nesta luta acabou, vampiro. Acostume-se a sua sede."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449128&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'09c5e6d2-f19e-4b18-89af-199828cf97ea\', \'multiverseId\': 449128}, \'multiverseid\': 449128}, {\'name\': \'Узы Света\', \'text\': \'Зачаровать существо\\nЗачарованное существо не может атаковать или блокировать.\', \'type\': \'Чары — Аура\', \'flavor\': \'«Для тебя это сражение окончено, вампир. Привыкай к своей жажде».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449409&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0581a40c-424e-4f4c-a132-42d0c2bf9f98\', \'multiverseId\': 449409}, \'multiverseid\': 449409}, {\'name\': \'光缕禁锢\', \'text\': \'结附于生物\\n所结附的生物不能进行攻击或阻挡。\', \'type\': \'结界 ～灵气\', \'flavor\': \'「吸血鬼，你的战斗到此为止。好好体会饥渴的滋味吧。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449690&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f3bc5d6b-21ac-48b0-bf3f-d327e7c48d62\', \'multiverseId\': 449690}, \'multiverseid\': 449690}, {\'name\': \'光縷禁錮\', \'text\': \'結附於生物\\n所結附的生物不能進行攻擊或阻擋。\', \'type\': \'結界 ～靈氣\', \'flavor\': \'「吸血鬼，你的戰鬥到此為止。好好體會飢渴的滋味吧。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449971&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a1725ea1-0279-487c-8fca-afecf0047d37\', \'multiverseId\': 449971}, \'multiverseid\': 449971}]', '[{\'name\': \'Lichs Umarmung\', \'text\': \'Zerstöre eine Kreatur deiner Wahl. Du erhältst 3 Lebenspunkte dazu.\', \'type\': \'Hexerei\', \'flavor\': \'Ein Lich muss sterbliche Seelen konsumieren, um sein ewiges Leben zu erhalten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447522&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3df04e88-ffd5-4799-a4b2-81aaf6f2d354\', \'multiverseId\': 447522}, \'multiverseid\': 447522}, {\'name\': \'Caricia del liche\', \'text\': \'Destruye la criatura objetivo. Ganas 3 vidas.\', \'type\': \'Conjuro\', \'flavor\': \'Un liche debe consumir almas mortales para seguir manteniendo su vida eterna.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447803&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e43efb7e-c80a-4a8c-b97d-344932c25089\', \'multiverseId\': 447803}, \'multiverseid\': 447803}, {\'name\': \'Caresse de la liche\', \'text\': \'Détruisez une créature ciblée. Vous gagnez 3 points de vie.\', \'type\': \'Rituel\', \'flavor\': "Une liche doit se nourrir d\'âmes mortelles pour sustenter sa vie éternelle.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448084&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'30131b6d-e1b0-415c-9f23-e8586a6ecdf2\', \'multiverseId\': 448084}, \'multiverseid\': 448084}, {\'name\': \'Carezza del Lich\', \'text\': \'Distruggi una creatura bersaglio. Guadagni 3 punti vita.\', \'type\': \'Stregoneria\', \'flavor\': \'Un lich deve nutrirsi di anime mortali per alimentare la sua vita eterna.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448365&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'87a1dec1-a593-4461-9f82-c45383de53f0\', \'multiverseId\': 448365}, \'multiverseid\': 448365}, {\'name\': \'リッチの愛撫\', \'text\': \'クリーチャー１体を対象とし、それを破壊する。あなたは３点のライフを得る。\', \'type\': \'ソーサリー\', \'flavor\': \'その永遠の命を養うため、リッチは定命の者の魂を消費しなければならない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448646&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'47bf4de3-5fbc-499d-904e-f329ee541bd2\', \'multiverseId\': 448646}, \'multiverseid\': 448646}, {\'name\': \'리치의 포옹\', \'text\': \'생물을 목표로 정한다. 그 생물을 파괴한다. 당신은 생명 3점을 얻는다.\', \'type\': \'집중마법\', \'flavor\': \'리치는 불멸의 삶을 유지하기 위해 필멸자들의 영혼을 양식으로 삼아야 한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448927&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'20437cc0-fbf7-4930-a5c8-594d91ee66db\', \'multiverseId\': 448927}, \'multiverseid\': 448927}, {\'name\': \'Carícia do Lich\', \'text\': \'Destrua a criatura alvo. Você ganha 3 pontos de vida.\', \'type\': \'Feitiço\', \'flavor\': \'Um lich precisa consumir almas mortais para alimentar sua vida eterna.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449208&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0719f4ba-62a3-414a-baf8-86ceb0e3a0f3\', \'multiverseId\': 449208}, \'multiverseid\': 449208}, {\'name\': \'Ласка Лича\', \'text\': \'Уничтожьте целевое существо. Вы получаете 3 жизни.\', \'type\': \'Волшебство\', \'flavor\': \'Лич должен пожирать смертные души, чтобы поддерживать свою вечную жизнь.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449489&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'deb689a6-daba-41be-9586-1fbcac3f3eb6\', \'multiverseId\': 449489}, \'multiverseid\': 449489}, {\'name\': \'巫妖抚慰\', \'text\': \'消灭目标生物。你获得3点生命。\', \'type\': \'法术\', \'flavor\': \'巫妖须不断吸食生者灵魂，方能维系自己的永恒生命。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449770&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'78966f41-9866-47e5-b135-5c507e97c9a6\', \'multiverseId\': 449770}, \'multiverseid\': 449770}, {\'name\': \'巫妖撫慰\', \'text\': \'消滅目標生物。你獲得3點生命。\', \'type\': \'巫術\', \'flavor\': \'巫妖須不斷吸食生者靈魂，方能維繫自己的永恆生命。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450051&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'af7eaa6a-a330-4f1a-8a52-968526853925\', \'multiverseId\': 450051}, \'multiverseid\': 450051}]', '[{\'name\': \'Lieferantin des Leichenflickers\', \'text\': \'Wenn die Lieferantin des Leichenflickers ins Spiel kommt oder stirbt, lege die obersten drei Karten deiner Bibliothek auf deinen Friedhof.\', \'type\': \'Kreatur — Zombie\', \'flavor\': \'Nichts wird verschwendet.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447538&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b1a30145-6f32-4794-b356-7d232869f470\', \'multiverseId\': 447538}, \'multiverseid\': 447538}, {\'name\': \'Proveedora de suturador\', \'text\': \'Cuando la Proveedora de suturador entre al campo de batalla o muera, pon las tres primeras cartas de tu biblioteca en tu cementerio.\', \'type\': \'Criatura — Zombie\', \'flavor\': \'No hay que desperdiciar ningún pedazo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447819&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'765846c2-f170-49e5-8356-275d3eeaf473\', \'multiverseId\': 447819}, \'multiverseid\': 447819}, {\'name\': \'Approvisionneuse du raccommodeur\', \'text\': "Quand l\'Approvisionneuse du raccommodeur arrive sur le champ de bataille ou meurt, mettez les trois cartes du dessus de votre bibliothèque dans votre cimetière.", \'type\': \'Créature : zombie\', \'flavor\': \'Rien ne se perd.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448100&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c17d2518-08c0-483d-92be-f5976eacfcb9\', \'multiverseId\': 448100}, \'multiverseid\': 448100}, {\'name\': \'Rifornitrice dei Cucitori\', \'text\': \'Quando la Rifornitrice dei Cucitori entra nel campo di battaglia o muore, metti nel tuo cimitero le prime tre carte del tuo grimorio.\', \'type\': \'Creatura — Zombie\', \'flavor\': \'Niente va sprecato.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448381&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ebdb8254-b32d-4f76-858f-5d99d9b18ea7\', \'multiverseId\': 448381}, \'multiverseid\': 448381}, {\'name\': \'縫い師への供給者\', \'text\': \'縫い師への供給者が戦場に出るか死亡したとき、あなたのライブラリーの一番上からカードを３枚あなたの墓地に置く。\', \'type\': \'クリーチャー — ゾンビ\', \'flavor\': \'どんな部位も無駄にはならない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448662&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1b912968-0770-4541-85e1-57bbc9ab6699\', \'multiverseId\': 448662}, \'multiverseid\': 448662}, {\'name\': \'봉합술사의 공급자\', \'text\': \'봉합술사의 공급자가 전장에 들어오거나 죽을 때, 당신의 서고 맨 위 카드 세 장을 당신의 무덤에 넣는다.\', \'type\': \'생물 — 좀비\', \'flavor\': \'어떤 부분도 버리는 법이 없다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448943&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2c8796ea-3750-4140-9c3e-0332f1f2e245\', \'multiverseId\': 448943}, \'multiverseid\': 448943}, {\'name\': \'Fornecedora do Suturador\', \'text\': \'Quando Fornecedora do Suturador entrar no campo de batalha ou morrer, coloque os três cards do topo de seu grimório em seu cemitério.\', \'type\': \'Criatura — Zumbi\', \'flavor\': \'Nenhuma peça desperdiçada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449224&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fc8724f8-cab6-4258-ac47-1d927158f66b\', \'multiverseId\': 449224}, \'multiverseid\': 449224}, {\'name\': \'Поставщик Сшивателя\', \'text\': \'Когда Поставщик Сшивателя выходит на поле битвы или умирает, положите три верхние карты вашей библиотеки на ваше кладбище.\', \'type\': \'Существо — Зомби\', \'flavor\': \'Ни одна часть не пропадает.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449505&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8b63c0d4-35e0-4657-94a5-466361640afa\', \'multiverseId\': 449505}, \'multiverseid\': 449505}, {\'name\': \'拼接师备尸\', \'text\': \'当拼接师备尸进战场或死去时，将你牌库顶的三张牌置入你的坟墓场。\', \'type\': \'生物 ～灵俑\', \'flavor\': \'一个部位也不浪费。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449786&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'df19163f-6efa-4703-819e-aa4fa04ef97d\', \'multiverseId\': 449786}, \'multiverseid\': 449786}, {\'name\': \'拼接師備屍\', \'text\': \'當拼接師備屍進戰場或死去時，將你牌庫頂的三張牌置入你的墳墓場。\', \'type\': \'生物 ～殭屍\', \'flavor\': \'一個部位也不浪費。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450067&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8ffc4148-8ecc-4039-8f99-bdbb68ffd4ed\', \'multiverseId\': 450067}, \'multiverseid\': 450067}]', '[{\'name\': \'Liliana die Nekromagierin\', \'text\': \'+1: Ein Spieler deiner Wahl verliert 2 Lebenspunkte.\\n—1: Bringe eine Kreaturenkarte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\\n—7: Zerstöre bis zu zwei Kreaturen deiner Wahl. Bringe bis zu zwei Kreaturenkarten aus Friedhöfen unter deiner Kontrolle ins Spiel.\', \'type\': \'Legendärer Planeswalker — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450272&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ad7e88ba-62b0-4187-a138-3af417416a9d\', \'multiverseId\': 450272}, \'multiverseid\': 450272}, {\'name\': \'Liliana, la nigromante\', \'text\': \'+1: El jugador objetivo pierde 2 vidas.\\n−1: Regresa la carta de criatura objetivo de tu cementerio a tu mano.\\n−7: Destruye hasta dos criaturas objetivo. Pon en el campo de batalla bajo tu control hasta dos cartas de criatura de cementerios.\', \'type\': \'Planeswalker legendario — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450306&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'819c32ed-12d8-4d9c-94e4-4eb274121544\', \'multiverseId\': 450306}, \'multiverseid\': 450306}, {\'name\': \'Liliana, la Nécromancienne\', \'text\': "+1 : Le joueur ciblé perd 2 points de vie.\\n-1 : Renvoyez une carte de créature ciblée depuis votre cimetière dans votre main.\\n-7 : Détruisez jusqu\'à deux créatures ciblées. Mettez sur le champ de bataille, sous votre contrôle, jusqu\'à deux cartes de créature des cimetières.", \'type\': \'Planeswalker légendaire : Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450340&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'88022dde-1519-4d79-8213-9dcb0a42eb57\', \'multiverseId\': 450340}, \'multiverseid\': 450340}, {\'name\': \'Liliana, la Necromante\', \'text\': \'+1: Un giocatore bersaglio perde 2 punti vita.\\n-1: Riprendi in mano una carta creatura bersaglio dal tuo cimitero.\\n-7: Distruggi fino a due creature bersaglio. Metti sul campo di battaglia sotto il tuo controllo fino a due carte creatura dai cimiteri.\', \'type\': \'Planeswalker Leggendario — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450374&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d64938e7-2d0d-4a39-876c-46f3601d00a6\', \'multiverseId\': 450374}, \'multiverseid\': 450374}, {\'name\': \'屍術師、リリアナ\', \'text\': \'+1：プレイヤー１人を対象とする。そのプレイヤーは２点のライフを失う。\\n-1：あなたの墓地からクリーチャー・カード１枚を対象とし、それをあなたの手札に戻す。\\n-7：クリーチャー最大２体を対象とし、それらを破壊する。墓地からクリーチャー・カード最大２枚をあなたのコントロール下で戦場に出す。\', \'type\': \'伝説のプレインズウォーカー — リリアナ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450408&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'36eefc29-8c56-4d77-97ea-3e023ad3ed29\', \'multiverseId\': 450408}, \'multiverseid\': 450408}, {\'name\': \'사령술사, 릴리아나\', \'text\': \'+1: 플레이어를 목표로 정한다. 그 플레이어는 생명 2점을 잃는다.\\n−1: 당신의 무덤에 있는 생물 카드를 목표로 정한다. 그 카드를 당신의 손으로 되돌린다.\\n−7: 생물을 최대 두 개까지 목표로 정한다. 그 생물들을 파괴한다. 무덤들에서 생물 카드를 최대 두 장까지 당신의 조종하에 전장에 놓는다.\', \'type\': \'전설적 플레인즈워커 — 릴리아나\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450442&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'755970a3-8198-46f3-8825-60b691a02591\', \'multiverseId\': 450442}, \'multiverseid\': 450442}, {\'name\': \'Liliana, a Necromante\', \'text\': \'+1: O jogador alvo perde 2 pontos de vida.\\n−1: Devolva o card de criatura alvo de seu cemitério para a sua mão.\\n−7: Destrua até duas criaturas alvo. Coloque até dois cards de criatura de qualquer cemitério no campo de batalha sob o seu controle.\', \'type\': \'Planeswalker Lendário — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450476&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2ee112ae-32d3-40c0-8492-ba49181e432e\', \'multiverseId\': 450476}, \'multiverseid\': 450476}, {\'name\': \'Лилиана, Некромант\', \'text\': \'+1: целевой игрок теряет 2 жизни.\\n—1: верните целевую карту существа из вашего кладбища в вашу руку.\\n—7: уничтожьте не более двух целевых существ. Положите на поле битвы под вашим контролем не более двух карт существ из кладбищ.\', \'type\': \'Легендарный Planeswalker — Лилиана\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450510&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'237097ae-7365-4192-b8ca-067cec72e13d\', \'multiverseId\': 450510}, \'multiverseid\': 450510}, {\'name\': \'死灵术士莉莲娜\', \'text\': \'+1：目标牌手失去2点生命。\\n−1：将目标生物牌从你的坟墓场移回你手上。\\n−7：消灭至多两个目标生物。将至多两张生物牌在你的操控下从坟墓场放进战场。\', \'type\': \'传奇鹏洛客 ～莉莲娜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450544&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'672c446f-dff7-4fc1-9d2d-45285d6cc858\', \'multiverseId\': 450544}, \'multiverseid\': 450544}, {\'name\': \'死靈術士莉蓮娜\', \'text\': \'+1：目標玩家失去2點生命。\\n−1：將目標生物牌從你的墳墓場移回你手上。\\n−7：消滅至多兩個目標生物。將至多兩張生物牌在你的操控下從墳墓場放進戰場。\', \'type\': \'傳奇鵬洛客 ～莉蓮娜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450578&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ffc7f28d-b79d-4eda-99a1-bdb10eafa7fe\', \'multiverseId\': 450578}, \'multiverseid\': 450578}]', '[{\'name\': \'Liliana, vom Tode unberührt\', \'text\': \'+1: Lege die obersten drei Karten deiner Bibliothek auf deinen Friedhof. Falls darunter mindestens eine Zombiekarte ist, verliert jeder Gegner 2 Lebenspunkte und du erhältst 2 Lebenspunkte dazu.\\n−2: Eine Kreatur deiner Wahl erhält -X/-X bis zum Ende des Zuges, wobei X gleich der Anzahl an Zombies ist, die du kontrollierst.\\n−3: Du kannst in diesem Zug Zombiekarten aus deinem Friedhof wirken.\', \'type\': \'Legendärer Planeswalker — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447523&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0733a3dc-2fdd-45e6-a99d-53dee374bef3\', \'multiverseId\': 447523}, \'multiverseid\': 447523}, {\'name\': \'Liliana, a salvo de la muerte\', \'text\': \'+1: Pon las tres primeras cartas de tu biblioteca en tu cementerio. Si al menos una de ellas es una carta de Zombie, cada oponente pierde 2 vidas y tú ganas 2 vidas.\\n−2: La criatura objetivo obtiene -X/-X hasta el final del turno, donde X es la cantidad de Zombies que controlas.\\n−3: Puedes lanzar cartas de Zombie de tu cementerio este turno.\', \'type\': \'Planeswalker legendario — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447804&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a2826143-0b16-417b-932f-2caa141fb6d0\', \'multiverseId\': 447804}, \'multiverseid\': 447804}, {\'name\': \'Liliana, épargnée par la mort\', \'text\': "+1 : Mettez les trois cartes du dessus de votre bibliothèque dans votre cimetière. Si au moins une d\'elles est une carte de zombie, chaque adversaire perd 2 points de vie et vous gagnez 2 points de vie.\\n-2 : La créature ciblée gagne -X/-X jusqu\'à la fin du tour, X étant le nombre de zombies que vous contrôlez.\\n-3 : Vous pouvez lancer des cartes de zombie depuis votre cimetière ce tour-ci.", \'type\': \'Planeswalker légendaire : Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448085&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d19efeea-ca87-4029-bc4e-30a3b9390982\', \'multiverseId\': 448085}, \'multiverseid\': 448085}, {\'name\': \'Liliana, Inviolata dalla Morte\', \'text\': \'+1: Metti nel tuo cimitero le prime tre carte del tuo grimorio. Se almeno una di esse è una carta Zombie, ogni avversario perde 2 punti vita e tu guadagni 2 punti vita.\\n-2: Una creatura bersaglio prende -X/-X fino alla fine del turno, dove X è il numero di Zombie che controlli.\\n-3: Puoi lanciare carte Zombie dal tuo cimitero in questo turno.\', \'type\': \'Planeswalker Leggendario — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448366&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9712ae33-6421-4778-ad57-a91c48307953\', \'multiverseId\': 448366}, \'multiverseid\': 448366}, {\'name\': \'死が触れぬ者、リリアナ\', \'text\': \'+1：あなたのライブラリーの一番上からカードを３枚あなたの墓地に置く。そのうち少なくとも１枚がゾンビ・カードであるなら、各対戦相手はそれぞれ２点のライフを失い、あなたは２点のライフを得る。\\n-2：クリーチャー１体を対象とする。ターン終了時まで、それは－Ｘ/－Ｘの修整を受ける。Ｘはあなたがコントロールしているゾンビの総数に等しい。\\n-3：このターン、あなたはあなたの墓地からゾンビ・カードを唱えてもよい。\', \'type\': \'伝説のプレインズウォーカー — リリアナ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448647&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'47813ac0-abc3-4fe9-9c84-16d2d56de3de\', \'multiverseId\': 448647}, \'multiverseid\': 448647}, {\'name\': \'죽음을 피하는 자, 릴리아나\', \'text\': \'+1: 당신의 서고 맨 위 카드 세 장을 당신의 무덤에 넣는다. 그 카드들 중 최소 한 장이 좀비 카드라면, 각 상대는 생명 2점을 잃고 당신은 생명 2점을 얻는다.\\n−2: 생물을 목표로 정한다. 그 생물은 턴종료까지 -X/-X를 받는다. X는 당신이 조종하는 좀비의 수이다.\\n−3: 당신은 이 턴에 당신의 무덤에 있는 좀비 카드들을 발동할 수 있다.\', \'type\': \'전설적 플레인즈워커 — 릴리아나\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448928&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4688bab2-ca0a-4d70-8bbb-e5d2ba53fab1\', \'multiverseId\': 448928}, \'multiverseid\': 448928}, {\'name\': \'Liliana, Intocada pela Morte\', \'text\': \'+1: Coloque os três cards do topo de seu grimório em seu cemitério. Se ao menos um deles for um card de Zumbi, cada oponente perde 2 pontos de vida e você ganha 2 pontos de vida.\\n−2: A criatura alvo recebe -X/-X até o final do turno, sendo X o número de Zumbis que você controla.\\n−3: Você pode conjurar cards de Zumbi a partir de seu cemitério neste turno.\', \'type\': \'Planeswalker Lendário — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449209&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'813498b7-d173-40d9-a04a-287b274cf413\', \'multiverseId\': 449209}, \'multiverseid\': 449209}, {\'name\': \'Лилиана, Нетронутая Смертью\', \'text\': \'+1: положите три верхние карты вашей библиотеки на ваше кладбище. Если хотя бы одна из них — карта Зомби, то каждый оппонент теряет 2 жизни, а вы получаете 2 жизни.\\n—2: целевое существо получает -X/-X до конца хода, где Х — количество Зомби под вашим контролем.\\n−3: в этом ходу вы можете разыгрывать карты Зомби из вашего кладбища.\', \'type\': \'Легендарный Planeswalker — Лилиана\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449490&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'76560aa9-e69a-45a3-8aee-7b75bd0a2014\', \'multiverseId\': 449490}, \'multiverseid\': 449490}, {\'name\': \'长生不死莉莲娜\', \'text\': \'+1：将你牌库顶的三张牌置入你的坟墓场。如果其中至少有一张是灵俑牌，则每位对手各失去2点生命且你获得2点生命。\\n−2：目标生物得-X/-X直到回合结束，X为由你操控的灵俑数量。\\n−3：本回合中，你可以从你坟墓场中施放灵俑牌。\', \'type\': \'传奇鹏洛客 ～莉莲娜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449771&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'429beca6-504c-4b64-91ca-270abbe282e3\', \'multiverseId\': 449771}, \'multiverseid\': 449771}, {\'name\': \'長生不死莉蓮娜\', \'text\': \'+1：將你牌庫頂的三張牌置入你的墳墓場。如果其中至少有一張是殭屍牌，則每位對手各失去2點生命且你獲得2點生命。\\n−2：目標生物得-X/-X直到回合結束，X為由你操控的殭屍數量。\\n−3：本回合中，你可以從你墳墓場中施放殭屍牌。\', \'type\': \'傳奇鵬洛客 ～莉蓮娜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450052&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'706d0e97-c12b-4498-af41-49904812fd02\', \'multiverseId\': 450052}, \'multiverseid\': 450052}]', '[{\'name\': \'Lilianas Ausbeute\', \'text\': \'Ein Gegner deiner Wahl wirft eine Karte aus seiner Hand ab.\\nSchaue dir die obersten fünf Karten deiner Bibliothek an. Du kannst davon eine schwarze Karte offen vorzeigen und auf deine Hand nehmen. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450275&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'34c6de4d-a71b-4b4b-a35e-e5a878d38f1d\', \'multiverseId\': 450275}, \'multiverseid\': 450275}, {\'name\': \'Botín de Liliana\', \'text\': \'El oponente objetivo descarta una carta.\\nMira las cinco primeras cartas de tu biblioteca. Puedes mostrar una carta negra que se encuentre entre ellas y ponerla en tu mano. Pon el resto en el fondo de tu biblioteca en un orden aleatorio.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450309&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2e466a24-7900-49cb-beac-4ce73e1633b3\', \'multiverseId\': 450309}, \'multiverseid\': 450309}, {\'name\': \'Butin de Liliana\', \'text\': "L\'adversaire ciblé se défausse d\'une carte.\\nRegardez les cinq cartes du dessus de votre bibliothèque. Vous pouvez révéler une carte noire parmi elles et la mettre dans votre main. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450343&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e335732c-8ed2-4243-858e-590752ce97e0\', \'multiverseId\': 450343}, \'multiverseid\': 450343}, {\'name\': \'Spoglie di Liliana\', \'text\': \'Un avversario bersaglio scarta una carta.\\nGuarda le prime cinque carte del tuo grimorio. Puoi rivelare una carta nera scelta tra esse e aggiungerla alla tua mano. Metti le altre in fondo al tuo grimorio in ordine casuale.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450377&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a3366605-d386-471b-b923-257447a42142\', \'multiverseId\': 450377}, \'multiverseid\': 450377}, {\'name\': \'リリアナの餌食\', \'text\': \'対戦相手１人を対象とする。そのプレイヤーはカード１枚を捨てる。\\nあなたのライブラリーの一番上からカードを５枚見る。あなたはその中から黒のカード１枚を公開してあなたの手札に加えてもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450411&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1bb772d7-69df-423c-a0d5-05c4ec438bab\', \'multiverseId\': 450411}, \'multiverseid\': 450411}, {\'name\': \'릴리아나의 전리품\', \'text\': \'상대를 목표로 정한다. 그 플레이어는 카드 한 장을 버린다.\\n당신의 서고 맨 위 카드 다섯 장을 본다. 당신은 그중에서 흑색 카드 한 장을 공개하고 당신의 손으로 가져갈 수 있다. 나머지 카드들은 무작위 순서로 당신의 서고 맨 밑에 넣는다.\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450445&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5e201649-dc8a-4cfc-9d2f-cb1a66358e43\', \'multiverseId\': 450445}, \'multiverseid\': 450445}, {\'name\': \'Espólios de Liliana\', \'text\': \'O oponente alvo descarta um card.\\nOlhe os cinco cards do topo de seu grimório. Você pode revelar um card preto dentre eles e colocá-lo em sua mão. Coloque o restante no fundo de seu grimório em ordem aleatória.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450479&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'95ea0ba7-3837-4622-8751-95b39f32fec6\', \'multiverseId\': 450479}, \'multiverseid\': 450479}, {\'name\': \'Трофеи Лилианы\', \'text\': \'Целевой оппонент сбрасывает карту.\\nПосмотрите пять верхних карт вашей библиотеки. Вы можете показать находящуюся среди них черную карту и положить ее в вашу руку. Положите остальные карты в низ вашей библиотеки в случайном порядке.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450513&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'58d905ec-390d-4284-b0b2-2109b21be2ce\', \'multiverseId\': 450513}, \'multiverseid\': 450513}, {\'name\': \'莉莲娜的斩获\', \'text\': \'目标对手弃一张牌。\\n检视你牌库顶的五张牌。你可以展示其中的一张黑色牌，并将它置于你手上。将其余的牌以随机顺序置于你的牌库底。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450547&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'458d5f9a-d311-41a8-8f70-d2da1e6d2a44\', \'multiverseId\': 450547}, \'multiverseid\': 450547}, {\'name\': \'莉蓮娜的斬獲\', \'text\': \'目標對手棄一張牌。\\n檢視你牌庫頂的五張牌。你可以展示其中的一張黑色牌，並將它置於你手上。將其餘的牌以隨機順序置於你的牌庫底。\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450581&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'64e1ed32-a9cf-4788-af0f-064543e89b7f\', \'multiverseId\': 450581}, \'multiverseid\': 450581}]', '[{\'name\': \'Lilianas Vertrag\', \'text\': \'Wenn Lilianas Vertrag ins Spiel kommt, ziehst du vier Karten und verlierst 4 Lebenspunkte.\\nZu Beginn deines Versorgungssegments und falls du vier oder mehr Dämonen mit unterschiedlichen Namen kontrollierst, gewinnst du die Partie.\', \'type\': \'Verzauberung\', \'flavor\': \'Unsterblichkeit ist jeden Preis wert.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447524&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a0243098-8817-4015-aa4c-a80badb8fd46\', \'multiverseId\': 447524}, \'multiverseid\': 447524}, {\'name\': \'Contrato de Liliana\', \'text\': \'Cuando el Contrato de Liliana entre al campo de batalla, robas cuatro cartas y pierdes 4 vidas.\\nAl comienzo de tu mantenimiento, si controlas cuatro o más Demonios con nombres diferentes, ganas el juego.\', \'type\': \'Encantamiento\', \'flavor\': \'La inmortalidad a cualquier precio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447805&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'17e4c9f7-63fd-4044-ac26-3ec5814b53b0\', \'multiverseId\': 447805}, \'multiverseid\': 447805}, {\'name\': \'Pacte de Liliana\', \'text\': \'Quand le Pacte de Liliana arrive sur le champ de bataille, vous piochez quatre cartes et vous perdez 4 points de vie.\\nAu début de votre entretien, si vous contrôlez au moins quatre démons avec des noms différents, vous gagnez la partie.\', \'type\': \'Enchantement\', \'flavor\': "L\'immortalité n\'a pas de prix.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448086&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'89b39650-ea79-4b83-b95e-061ebde90a2a\', \'multiverseId\': 448086}, \'multiverseid\': 448086}, {\'name\': \'Contratto di Liliana\', \'text\': "Quando il Contratto di Liliana entra nel campo di battaglia, pesca quattro carte e perdi 4 punti vita.\\nAll\'inizio del tuo mantenimento, se controlli quattro o più Demoni con nomi diversi, vinci la partita.", \'type\': \'Incantesimo\', \'flavor\': "Nessun prezzo è eccessivo per l\'immortalità.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448367&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1ee1d7f9-2075-484c-ab5f-3cda42fe596d\', \'multiverseId\': 448367}, \'multiverseid\': 448367}, {\'name\': \'リリアナの契約\', \'text\': \'リリアナの契約が戦場に出たとき、あなたはカードを４枚引き、あなたは４点のライフを失う。\\nあなたのアップキープの開始時に、あなたが異なる名前のデーモンを４体以上コントロールしている場合、あなたはこのゲームに勝利する。\', \'type\': \'エンチャント\', \'flavor\': \'不老不死にはどんな代償も払う価値がある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448648&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9cd6a96c-e88e-4ee7-9444-f6d50b287954\', \'multiverseId\': 448648}, \'multiverseid\': 448648}, {\'name\': \'릴리아나의 계약\', \'text\': \'릴리아나의 계약이 전장에 들어올 때, 당신은 카드 네 장을 뽑고 생명 4점을 잃는다.\\n당신의 유지단 시작에, 당신이 서로 이름이 다른 악마를 네 개 이상 조종한다면, 당신은 게임에서 승리한다.\', \'type\': \'부여마법\', \'flavor\': \'불멸에는 어떤 값을 치러도 아깝지 않다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448929&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e9139675-d543-4db2-adc6-a49ff47f1843\', \'multiverseId\': 448929}, \'multiverseid\': 448929}, {\'name\': \'Contrato de Liliana\', \'text\': \'Quando Contrato de Liliana entra no campo de batalha, você compra quatro cards e perde 4 pontos de vida.\\nNo início de sua manutenção, se controlar quatro ou mais Demônios com nomes diferentes, você vence o jogo.\', \'type\': \'Encantamento\', \'flavor\': \'A imortalidade vale qualquer preço.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449210&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'89db19a7-f05a-4992-8498-5a4e446aba41\', \'multiverseId\': 449210}, \'multiverseid\': 449210}, {\'name\': \'Контракт Лилианы\', \'text\': \'Когда Контракт Лилианы выходит на поле битвы, вы берете четыре карты и теряете 4 жизни.\\nВ начале вашего шага поддержки, если вы контролируете не менее четырех Демонов с различными именами, то вы выигрываете партию.\', \'type\': \'Чары\', \'flavor\': \'Бессмертие стоит любой заплаченной цены.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449491&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5171a98c-5ba0-4943-a1e6-68fe5ffadff2\', \'multiverseId\': 449491}, \'multiverseid\': 449491}, {\'name\': \'莉莲娜的契约\', \'text\': \'当莉莲娜的契约进战场时，你抓四张牌且失去4点生命。\\n在你的维持开始时，若你操控四个或更多恶魔，且其名称各不相同，则你赢得这盘游戏。\', \'type\': \'结界\', \'flavor\': \'长生不死值得付出一切代价去争取。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449772&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8b71cc81-5d79-4087-8a4b-ec0654698029\', \'multiverseId\': 449772}, \'multiverseid\': 449772}, {\'name\': \'莉蓮娜的契約\', \'text\': \'當莉蓮娜的契約進戰場時，你抽四張牌且失去4點生命。\\n在你的維持開始時，若你操控四個或更多惡魔，且其名稱各不相同，則你贏得這盤遊戲。\', \'type\': \'結界\', \'flavor\': \'長生不死值得付出一切代價去爭取。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450053&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e3a33836-4680-40c9-9157-ca2550c4ebd2\', \'multiverseId\': 450053}, \'multiverseid\': 450053}]', "[{'name': 'Llanowarelfen', 'text': '{T}: Erzeuge {G}.', 'type': 'Kreatur — Elf, Druide', 'flavor': 'Geduldig und offenherzig wie das Leben, aber zugleich tückisch und erbarmungslos wie die Natur.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450295&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd52e98f4-01ab-478d-8bc0-8aceeaaae5f1', 'multiverseId': 450295}, 'multiverseid': 450295}, {'name': 'Elfos de Llanowar', 'text': '{T}: Agrega {G}.', 'type': 'Criatura — Druida elfo', 'flavor': 'Tan pacientes y generosos como la vida; tan duros y crueles como la naturaleza.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450329&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ca55dd51-4a02-41a7-a10c-587b27d8be35', 'multiverseId': 450329}, 'multiverseid': 450329}, {'name': 'Elfes de Llanowar', 'text': '{T} : Ajoutez {G}.', 'type': 'Créature : elfe et druide', 'flavor': 'Aussi patients et généreux que la vie, aussi durs et impitoyables que la nature.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450363&type=card', 'language': 'French', 'identifiers': {'scryfallId': '147df8db-145d-4d54-a0b0-3b80491da198', 'multiverseId': 450363}, 'multiverseid': 450363}, {'name': 'Elfi di Llanowar', 'text': '{T}: Aggiungi {G}.', 'type': 'Creatura — Druido Elfo', 'flavor': 'Pazienti e generosi come la vita, inesorabili e inclementi come la natura.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450397&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c559e7a0-9f33-49df-ac3f-dd82731ced0f', 'multiverseId': 450397}, 'multiverseid': 450397}, {'name': 'ラノワールのエルフ', 'text': '{T}：{G}を加える。', 'type': 'クリーチャー — エルフ・ドルイド', 'flavor': '生命のように強靭で寛容。自然のように厳格で残酷。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450431&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '442f8b1f-e7d2-44bd-abeb-ce36f7d5c237', 'multiverseId': 450431}, 'multiverseid': 450431}, {'name': '라노워 엘프', 'text': '{T}: {G}를 추가한다.', 'type': '생물 — 엘프 드루이드', 'flavor': '생명처럼 참을성 있고 자비로우며, 자연처럼 가혹하고 무자비하다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450465&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'cced6e39-a2b6-4a0e-a6fc-904032244d50', 'multiverseId': 450465}, 'multiverseid': 450465}, {'name': 'Elfos de Llanowar', 'text': '{T}: Adicione {G}.', 'type': 'Criatura — Elfo Druida', 'flavor': 'Pacientes e generosos como a vida, severos e impiedosos como a natureza.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450499&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c0a37e72-e519-463e-8837-d883d66c12c6', 'multiverseId': 450499}, 'multiverseid': 450499}, {'name': 'Лановарские Эльфы', 'text': '{T}: добавьте {G}.', 'type': 'Существо — Эльф Друид', 'flavor': 'Терпеливые и великодушные, как сама жизнь, жестокие и безжалостные, как сама природа.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450533&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '68f93eec-7ff3-4f29-9544-163e2bb4c845', 'multiverseId': 450533}, 'multiverseid': 450533}, {'name': '罗堰妖精', 'text': '{T}：加{G}。', 'type': '生物 ～妖精／德鲁伊', 'flavor': '如生命般耐心慷慨，如自然般严苛无情。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450567&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '4437cf83-5495-4753-9a19-bfd1de3f56d4', 'multiverseId': 450567}, 'multiverseid': 450567}, {'name': '羅堰妖精', 'text': '{T}：加{G}。', 'type': '生物 ～妖精／德魯伊', 'flavor': '如生命般耐心慷慨，如自然般嚴苛無情。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450601&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '6097f629-978b-426b-b57e-e9e17b17626f', 'multiverseId': 450601}, 'multiverseid': 450601}]", "[{'name': 'Loxodon-Frontbrecher', 'type': 'Kreatur — Elefant, Soldat', 'flavor': 'Loxodons haben eine kräftige Statur und einen starken Geist. Sie kämpfen stets an vorderster Front, egal wie schlecht die Chancen stehen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447441&type=card', 'language': 'German', 'identifiers': {'scryfallId': '034fb7f0-4165-4381-a5a8-577d7d338660', 'multiverseId': 447441}, 'multiverseid': 447441}, {'name': 'Loxodón rompelíneas', 'type': 'Criatura — Soldado elefante', 'flavor': 'Los loxodones son firmes de aspecto y de espíritu. Ocurra lo que ocurra, siempre son los primeros en lanzarse a la batalla.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447722&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'f87bb506-333b-41cc-b53a-3be56987e5df', 'multiverseId': 447722}, 'multiverseid': 447722}, {'name': 'Briseur de ligne loxodon', 'type': 'Créature : éléphant et soldat', 'flavor': 'Les loxodons ont un physique et un esprit inflexibles. Quelles que soient les chances de victoire, ils sont toujours les premiers au combat.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448003&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b866b9f8-224f-4ebe-b23a-ee14d0dad829', 'multiverseId': 448003}, 'multiverseid': 448003}, {'name': 'Lossodonte Spezzaranghi', 'type': 'Creatura — Elefante Soldato', 'flavor': 'I lossodonti sono saldi nel fisico e nello spirito. Anche quando le speranze sono esigue, sono sempre in prima linea.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448284&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ead00ab5-093c-4f82-8e83-961623606025', 'multiverseId': 448284}, 'multiverseid': 448284}, {'name': 'ロクソドンの戦線砕き', 'type': 'クリーチャー — 象・兵士', 'flavor': 'ロクソドンは身も心も固い。勝ち目があろうとなかろうと、彼らは常に先陣を切る。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448565&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f9a6744d-8761-4331-890e-96412b9f66ed', 'multiverseId': 448565}, 'multiverseid': 448565}, {'name': '록소돈 전열 파괴자', 'type': '생물 — 코끼리 병사', 'flavor': '록소돈은 체구도 정신도 굳건하다. 어떤 경우에도, 그들은 가장 먼저 전투에 뛰어든다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448846&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '6867cdb6-cd03-4b9c-be89-a572d4cbf625', 'multiverseId': 448846}, 'multiverseid': 448846}, {'name': 'Desformador Loxodonte', 'type': 'Criatura — Elefante Soldado', 'flavor': 'Os loxodontes são firmes em estatura e em espírito. Não importa a situação. Eles sempre entram primeiro na batalha.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449127&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'bef0902c-2887-4bef-b831-183894b82754', 'multiverseId': 449127}, 'multiverseid': 449127}, {'name': 'Прорвавший Строй Локсодон', 'type': 'Существо — Слон Солдат', 'flavor': 'Локсодоны крепки телом и духом. Как бы ни велика была опасность, они первыми отправляются в бой.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449408&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '386294da-91a7-45ec-b8e7-2df9865a1eb0', 'multiverseId': 449408}, 'multiverseid': 449408}, {'name': '破阵象族', 'type': '生物 ～象／士兵', 'flavor': '象族身心强健。无论胜算几何，他们总会率先参加战斗。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449689&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '952981ec-be04-445e-bc74-04e64c438bf8', 'multiverseId': 449689}, 'multiverseid': 449689}, {'name': '破陣象族', 'type': '生物 ～象／士兵', 'flavor': '象族身心強健。無論勝算幾何，他們總會率先參加戰鬥。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449970&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '3ccfd7bd-5365-47c0-ba54-fb0c03a7b41e', 'multiverseId': 449970}, 'multiverseid': 449970}]", '[{\'name\': \'Luftelementar\', \'text\': \'Fliegend (Diese Kreatur kann außer von fliegenden Kreaturen und Kreaturen mit Reichweite nicht geblockt werden.)\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'Mit dem herannahenden Schiff erhob sich auch das Jade-Totem hoch in die Lüfte. Seine Macht erwachte. Steinerne Augen begannen zu glühen. Der Atem der Welt entwich und erweckte einen Sturm.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450289&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c156e90c-3972-4835-b755-02ff6556360d\', \'multiverseId\': 450289}, \'multiverseid\': 450289}, {\'name\': \'Elemental de aire\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar o alcance.)\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Mientras el barco se acercaba, el tótem de jade se elevó en el cielo. El poder se anudó en torno a él como un remolino. Los ojos de piedra centellearon. Entonces, el mundo exhaló un soplido y surgió un huracán.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450323&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e746c762-1e4d-4435-89b3-a43a60922ae6\', \'multiverseId\': 450323}, \'multiverseid\': 450323}, {\'name\': "Élémental d\'air", \'text\': \'Vol (Cette créature ne peut pas être bloquée excepté par des créatures avec le vol ou la portée.)\', \'type\': \'Créature : élémental\', \'flavor\': "Tandis que le navire approchait, le totem de jade s\'éleva dans les airs. Il y eut une soudaine ondulation d\'énergie. Des yeux de pierre crépitèrent. Le monde exprima son rejet en un souffle et une trombe se forma.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450357&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9a377787-84f6-4931-abe1-7323766a8a89\', \'multiverseId\': 450357}, \'multiverseid\': 450357}, {\'name\': "Elementale dell\'Aria", \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare o raggiungere.)\', \'type\': \'Creatura — Elementale\', \'flavor\': "All\'avvicinarsi della nave, il totem di giada si innalzò nel cielo. Il suo potere riverberò nell\'aria e i suoi occhi di pietra brillarono crepitando. Il respiro del mondo sibilò attraverso di esso e un vento di tempesta prese vita.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450391&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e56512aa-5963-4619-af28-1b34bfd95c30\', \'multiverseId\': 450391}, \'multiverseid\': 450391}, {\'name\': \'大気の精霊\', \'text\': \'飛行（このクリーチャーは飛行や到達を持たないクリーチャーによってはブロックされない。）\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'船が近づくと、翡翠のトーテム像が頭上高く現れた。力の波動を感じた。石の目が光り緊張が高まった。それが息を一吹きすると、暴風が巻き起こった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450425&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b0c92919-1f69-477a-ad26-615a91901d25\', \'multiverseId\': 450425}, \'multiverseid\': 450425}, {\'name\': \'공기의 정령\', \'text\': \'비행 (이 생물은 비행이나 대공을 가진 생물에게만 방어될 수 있다.)\', \'type\': \'생물 — 정령\', \'flavor\': \'배가 다가가자, 비취 토템이 머리 위로 높이 떠올랐다. 힘이 물결쳤다. 암석으로 된 눈이 빛나며 우지끈 소리를 냈다. 거대한 숨을 내쉬자, 폭풍이 일어났다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450459&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'94186ffd-182d-4044-b9f8-b2b55956e8a4\', \'multiverseId\': 450459}, \'multiverseid\': 450459}, {\'name\': \'Elemental do Ar\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com voar ou alcance.)\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Quando o navio se aproximou, o totem de jade assomava nas alturas. Sentiu-se uma ondulação de poder. Olhos de pedra brilharam e crepitaram. Dele sibilou um sopro do mundo. E dele nasceu uma tempestade.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450493&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d9a5534a-a267-467c-bb58-968072373986\', \'multiverseId\': 450493}, \'multiverseid\': 450493}, {\'name\': \'Элементаль Воздуха\', \'text\': \'Полет (Это существо может быть заблокировано только существами с Полетом или Захватом.)\', \'type\': \'Существо — Элементаль\', \'flavor\': \'Когда корабль приблизился к берегу, высоко в небо поднялся нефритовый тотем. Воздух задрожал от сгустившейся мощи. Каменные глаза засияли, затрещали разряды. С шумом вырвалось дыхание мира, и яростный ураган ожил.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450527&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f3b5db24-3bf9-4aeb-ab3f-b50d9f881517\', \'multiverseId\': 450527}, \'multiverseid\': 450527}, {\'name\': \'大气元素\', \'text\': \'飞行（此生物只能被具飞行或延势异能的生物阻挡。）\', \'type\': \'生物 ～元素\', \'flavor\': \'随着船只逐渐靠近，翠玉图腾像呼啸升空。其间能量涌动，石像眼睛突然发光、碎裂，叹出一口世间气息，一股风暴就此成型。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450561&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e42ff8e1-99b2-4ae4-a700-c96cdbc760d1\', \'multiverseId\': 450561}, \'multiverseid\': 450561}, {\'name\': \'大氣元素\', \'text\': \'飛行（此生物只能被具飛行或延勢異能的生物阻擋。）\', \'type\': \'生物 ～元素\', \'flavor\': \'隨著船隻逐漸靠近，翠玉圖騰像呼嘯升空。其間能量湧動，石像眼睛突然發光、碎裂，歎出一口世間氣息，一股風暴就此成型。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450595&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e211fce7-b65f-4ed5-9995-14c62f388b32\', \'multiverseId\': 450595}, \'multiverseid\': 450595}]', '[{\'name\': \'Luftfahrtpionierin\', \'text\': \'Wenn die Luftfahrtpionierin ins Spiel kommt, erzeuge einen 1/1 farblosen Thopter-Artefaktkreaturenspielstein mit Flugfähigkeit.\', \'type\': \'Kreatur — Mensch, Handwerker\', \'flavor\': \'„Sie sagen, Perfektion sei unmöglich, aber das sagten sie auch übers Fliegen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447463&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b6b987d3-642e-4f39-b822-7b8457c05c9c\', \'multiverseId\': 447463}, \'multiverseid\': 447463}, {\'name\': \'Pionera de la aviación\', \'text\': \'Cuando la Pionera de la aviación entre al campo de batalla, crea una ficha de criatura artefacto Tóptero incolora 1/1 con la habilidad de volar.\', \'type\': \'Criatura — Artífice humano\', \'flavor\': \'"Dicen que la perfección es inalcanzable, pero lo mismo decían de volar".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447744&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3fd8d020-e13e-49d9-a088-1f7e6fd9a113\', \'multiverseId\': 447744}, \'multiverseid\': 447744}, {\'name\': "Pionnière de l\'aviation", \'text\': "Quand la Pionnière de l\'aviation arrive sur le champ de bataille, créez un jeton de créature-artefact 1/1 incolore Mécanoptère avec le vol.", \'type\': \'Créature : humain et artificier\', \'flavor\': \'« Ils disent que la perfection est impossible, mais ils disaient la même chose à propos du vol. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448025&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5ed1f61d-d514-4507-877b-bbe7afa2008b\', \'multiverseId\': 448025}, \'multiverseid\': 448025}, {\'name\': "Pioniera dell\'Aviazione", \'text\': "Quando la Pioniera dell\'Aviazione entra nel campo di battaglia, crea una pedina creatura artefatto Tottero 1/1 incolore con volare.", \'type\': \'Creatura — Artefice Umano\', \'flavor\': \'"Dicono che la perfezione non esiste, così come dicevano che era impossibile volare."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448306&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5437db2a-d262-4da0-b551-9dfa98490e7d\', \'multiverseId\': 448306}, \'multiverseid\': 448306}, {\'name\': \'飛行の先駆者\', \'text\': \'飛行の先駆者が戦場に出たとき、飛行を持つ無色の１/１の飛行機械・アーティファクト・クリーチャー・トークンを１体生成する。\', \'type\': \'クリーチャー — 人間・工匠\', \'flavor\': \'「完璧など不可能だと人は言いますが、飛行もかつてはそう言われていたんです。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448587&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'098fdc44-38c3-41bc-870c-d31b57fae1e7\', \'multiverseId\': 448587}, \'multiverseid\': 448587}, {\'name\': \'항공 개척자\', \'text\': \'항공 개척자가 전장에 들어올 때, 비행을 가진 1/1 무색 날틀 마법물체 생물 토큰 한 개를 만든다.\', \'type\': \'생물 — 인간 기능공\', \'flavor\': \'"사람들은 완벽이 손에 넣을 수 없는 거라고들 하지만, 하늘을 나는 것에 대해서도 그렇게 말했지."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448868&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2658b023-2cec-4b39-8311-b6e7e23e645a\', \'multiverseId\': 448868}, \'multiverseid\': 448868}, {\'name\': \'Pioneira da Aviação\', \'text\': \'Quando Pioneira da Aviação entrar no campo de batalha, crie uma ficha de criatura artefato incolor 1/1 do tipo Tóptero com voar.\', \'type\': \'Criatura — Humano Artesão\', \'flavor\': \'"Dizem que a perfeição é inatingível, mas diziam o mesmo sobre voar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449149&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8aa29451-2d12-40a9-b4a9-726b730b207a\', \'multiverseId\': 449149}, \'multiverseid\': 449149}, {\'name\': \'Первая Воздухоплавательница\', \'text\': \'Когда Первая Воздухоплавательница выходит на поле битвы, создайте одну фишку артефакта существа 1/1 бесцветный Топтер с Полетом.\', \'type\': \'Существо — Человек Механик\', \'flavor\': \'«Говорят, что совершенства достичь нельзя, но так говорили и про полеты».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449430&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bff3e298-03c3-4c79-8c0d-3ecf2c44eef2\', \'multiverseId\': 449430}, \'multiverseid\': 449430}, {\'name\': \'翔空先驱\', \'text\': \'当翔空先驱进战场时，派出一个1/1无色，具飞行异能的振翼机衍生神器生物。\', \'type\': \'生物 ～人类／神器师\', \'flavor\': \'「他们口口声声说完美不可及，但他们之前对飞行也是这态度。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449711&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'217030db-f935-4dfc-ae8c-0d3d7f075606\', \'multiverseId\': 449711}, \'multiverseid\': 449711}, {\'name\': \'翔空先驅\', \'text\': \'當翔空先驅進戰場時，派出一個1/1無色，具飛行異能的振翼機衍生神器生物。\', \'type\': \'生物 ～人類／神器師\', \'flavor\': \'「他們口口聲聲說完美不可及，但他們之前對飛行也是這態度。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449992&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5cf82df0-84a4-4675-b6c1-b5f4da48d08b\', \'multiverseId\': 449992}, \'multiverseid\': 449992}]', '[{\'name\': \'Luftraumüberwacher\', \'text\': \'Fliegend\\nWenn der Luftraumüberwacher ins Spiel kommt, ziehe eine Karte.\', \'type\': \'Artefaktkreatur — Thopter\', \'flavor\': \'Der Senat nutzt viele dieser Thopter, vor allem, um Schmutz über andere Senatoren zu sammeln.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447663&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f6996be7-0251-4b79-bfd3-d4400e0952b6\', \'multiverseId\': 447663}, \'multiverseid\': 447663}, {\'name\': \'Escrutacielos\', \'text\': \'Vuela.\\nCuando el Escrutacielos entre al campo de batalla, roba una carta.\', \'type\': \'Criatura artefacto — Tóptero\', \'flavor\': \'El senado municipal usa a discreción los tópteros, sobre todo para sacar los trapos sucios a los senadores rivales.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447944&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1901d9d8-2e92-4713-8afe-612045f3ceed\', \'multiverseId\': 447944}, \'multiverseid\': 447944}, {\'name\': \'Scruteciel\', \'text\': \'Vol\\nQuand le Scruteciel arrive sur le champ de bataille, piochez une carte.\', \'type\': \'Créature-artefact : mécanoptère\', \'flavor\': \'Le sénat municipal utilise beaucoup les mécanoptères, essentiellement pour trouver des informations compromettantes sur les sénateurs rivaux.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448225&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'580ab8bf-70b7-457a-8ebe-e3a70c898811\', \'multiverseId\': 448225}, \'multiverseid\': 448225}, {\'name\': \'Aerosorvegliante\', \'text\': "Volare\\nQuando l\'Aerosorvegliante entra nel campo di battaglia, pesca una carta.", \'type\': \'Creatura Artefatto — Tottero\', \'flavor\': \'Il senato municipale fa ampio uso dei totteri, principalmente per raccogliere informazioni compromettenti sui senatori rivali.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448506&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dccab86b-cab6-42c6-9843-c6e34e27f1cf\', \'multiverseId\': 448506}, \'multiverseid\': 448506}, {\'name\': \'空中走査器\', \'text\': \'飛行\\n空中走査器が戦場に出たとき、カードを１枚引く。\', \'type\': \'アーティファクト・クリーチャー — 飛行機械\', \'flavor\': \'その地方議員は飛行機械を活用している。主に対立候補の汚行を収集するためだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448787&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'934e79ba-4fda-493d-935f-d18ed13e4ebc\', \'multiverseId\': 448787}, \'multiverseid\': 448787}, {\'name\': \'하늘 탐색기\', \'text\': \'비행\\n하늘 탐색기가 전장에 들어올 때, 카드 한 장을 뽑는다.\', \'type\': \'마법물체 생물 — 날틀\', \'flavor\': \'지방의 원로가 날틀의 폭넓은 사용법을 만들어냈는데, 대부분은 적대적인 의원의 뒤를 캐는 것이었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449068&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4b450646-16d6-4a9e-a2d1-35e1459a2f74\', \'multiverseId\': 449068}, \'multiverseid\': 449068}, {\'name\': \'Sonda Aérea\', \'text\': \'Voar\\nQuando Sonda Aérea entrar no campo de batalha, compre um card.\', \'type\': \'Criatura Artefato — Tóptero\', \'flavor\': \'O senado municipal faz largo uso dos tópteros, em sua maior parte para descobrir os podres de senadores rivais.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449349&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'757a6e1b-d6f1-4602-8a15-d93f89a8efe0\', \'multiverseId\': 449349}, \'multiverseid\': 449349}, {\'name\': \'Небесный Соглядатай\', \'text\': \'Полет\\nКогда Небесный Соглядатай выходит на поле битвы, возьмите карту.\', \'type\': \'Артефакт Существо — Топтер\', \'flavor\': \'Городской сенат широко использует топтеров — в основном для сбора компромата на сенаторов-конкурентов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449630&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cd652c70-7ebc-407b-9014-634ddb02bfc1\', \'multiverseId\': 449630}, \'multiverseid\': 449630}, {\'name\': \'巡天扑翼机\', \'text\': \'飞行\\n当巡天扑翼机进战场时，抓一张牌。\', \'type\': \'神器生物 ～振翼机\', \'flavor\': \'市议会广泛使用扑翼机，多数是为了搜集敌对议员的污点。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449911&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'636604b2-f4fd-4f75-8c89-d11571ab1d7e\', \'multiverseId\': 449911}, \'multiverseid\': 449911}, {\'name\': \'巡天撲翼機\', \'text\': \'飛行\\n當巡天撲翼機進戰場時，抽一張牌。\', \'type\': \'神器生物 ～振翼機\', \'flavor\': \'市議會廣泛使用撲翼機，多數是為了搜集敵對議員的污點。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450192&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e2aadd15-f99b-4bdc-aeb6-ed4fc545a8ca\', \'multiverseId\': 450192}, \'multiverseid\': 450192}]', '[{\'name\': \'Luftschiff-Ingenieurin\', \'text\': \'Solange du ein Artefakt kontrollierst, erhält die Luftschiff-Ingenieurin +2/+0 und hat Flugfähigkeit.\', \'type\': \'Kreatur — Mensch, Handwerker\', \'flavor\': \'Die Besten ihres Handwerks kennen jeden Zentimeter und jede Schraube ihres Schiffs.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447628&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'54c64bd2-b857-4a08-ac3d-7b7332897f46\', \'multiverseId\': 447628}, \'multiverseid\': 447628}, {\'name\': \'Ingeniera aérea\', \'text\': \'Mientras controles un artefacto, la Ingeniera aérea obtiene +2/+0 y tiene la habilidad de volar.\', \'type\': \'Criatura — Artífice humano\', \'flavor\': \'Los más brillantes de la industria se conocen cada tornillo de las estructuras, de arriba abajo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447909&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'06e9f19b-9444-446a-8fbb-df2b05caa857\', \'multiverseId\': 447909}, \'multiverseid\': 447909}, {\'name\': \'Ingénieure aérienne\', \'text\': "Tant que vous contrôlez un artefact, l\'Ingénieure aérienne gagne +2/+0 et a le vol.", \'type\': \'Créature : humain et artificier\', \'flavor\': \'Les meilleurs ingénieurs connaissent le moindre boulon de leurs gréements, de la proue à la poupe.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448190&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'147a914f-16f0-4983-ab1e-60dac7358aee\', \'multiverseId\': 448190}, \'multiverseid\': 448190}, {\'name\': \'Ingegnera Aerea\', \'text\': "Fintanto che controlli un artefatto, l\'Ingegnera Aerea prende +2/+0 e ha volare.", \'type\': \'Creatura — Artefice Umano\', \'flavor\': \'I migliori nel loro campo conoscono ogni bullone del proprio mezzo, da prua a poppa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448471&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0f5feeba-a1ef-4000-8396-31cec8b36f23\', \'multiverseId\': 448471}, \'multiverseid\': 448471}, {\'name\': \'空の技師\', \'text\': \'あなたがアーティファクトをコントロールしているかぎり、空の技師は＋２/＋０の修整を受け、飛行を持つ。\', \'type\': \'クリーチャー — 人間・工匠\', \'flavor\': \'同業のうち最良の者は、船首から船尾まで、ネジ１本に至るまで知り尽くしている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448752&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ada3396c-81df-4fd9-83d9-857de1c5bbdd\', \'multiverseId\': 448752}, \'multiverseid\': 448752}, {\'name\': \'항공 기술자\', \'text\': \'당신이 마법물체를 조종하는 한, 항공 기술자는 +2/+0을 받고 비행을 가진다.\', \'type\': \'생물 — 인간 기능공\', \'flavor\': \'최고의 기술자는 나사 하나하나를 이물에서 고물까지 빠짐없이 알고 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449033&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'41689138-8a80-49c2-96ac-4e83180ad3ce\', \'multiverseId\': 449033}, \'multiverseid\': 449033}, {\'name\': \'Engenheira Aérea\', \'text\': \'Enquanto você controlar um artefato, Engenheira Aérea receberá +2/+0 e terá voar.\', \'type\': \'Criatura — Humano Artesão\', \'flavor\': \'Os melhores do ramo conhecem cada parafuso da armação, de ponta a ponta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449314&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'46ab3f3c-9e53-422e-b089-0cc21035ed84\', \'multiverseId\': 449314}, \'multiverseid\': 449314}, {\'name\': \'Воздушный Инженер\', \'text\': \'Пока вы контролируете артефакт, Воздушный Инженер получает +2/+0 и имеет Полет.\', \'type\': \'Существо — Человек Механик\', \'flavor\': \'Лучшие в своем деле знают каждую заклепку своего судна, от носа до кормы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449595&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'35edd33c-f55e-42a0-bae8-423a235e8e3a\', \'multiverseId\': 449595}, \'multiverseid\': 449595}, {\'name\': \'空行工程师\', \'text\': \'只要你操控神器，空行工程师便得+2/+0且具有飞行异能。\', \'type\': \'生物 ～人类／神器师\', \'flavor\': \'业内最顶尖的人熟悉从船头到船尾的每一颗螺栓。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449876&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1a8c5ba9-7dd9-4c8d-8851-f2fe391fc784\', \'multiverseId\': 449876}, \'multiverseid\': 449876}, {\'name\': \'空行工程師\', \'text\': \'只要你操控神器，空行工程師便得+2/+0且具有飛行異能。\', \'type\': \'生物 ～人類／神器師\', \'flavor\': \'業內最頂尖的人熟悉從船頭到船尾的每一顆螺栓。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450157&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'14207e59-3d7c-4e4f-a20b-366f1524801a\', \'multiverseId\': 450157}, \'multiverseid\': 450157}]', '[{\'name\': \'Makabrer Walzer\', \'text\': \'Bringe bis zu zwei Kreaturenkarten deiner Wahl aus deinem Friedhof auf deine Hand zurück und wirf dann eine Karte ab.\', \'type\': \'Hexerei\', \'flavor\': \'Liliana lässt sich nie von jemand anderem führen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447525&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5cdd8b64-1652-4bca-8707-f4c3a0d373a5\', \'multiverseId\': 447525}, \'multiverseid\': 447525}, {\'name\': \'Vals macabro\', \'text\': \'Regresa hasta dos cartas de criatura objetivo de tu cementerio a tu mano, luego descarta una carta.\', \'type\': \'Conjuro\', \'flavor\': \'A Liliana nadie le marca el ritmo. Nunca.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447806&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dea1f7ed-5977-4668-949d-f8591845c412\', \'multiverseId\': 447806}, \'multiverseid\': 447806}, {\'name\': \'Valse macabre\', \'text\': "Renvoyez jusqu\'à deux cartes de créature ciblées depuis votre cimetière dans votre main, et défaussez-vous ensuite d\'une carte.", \'type\': \'Rituel\', \'flavor\': "Liliana n\'est pas du genre à se laisser guider.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448087&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'49c87f3f-9c6c-4003-baba-39e87545af8a\', \'multiverseId\': 448087}, \'multiverseid\': 448087}, {\'name\': \'Valzer Macabro\', \'text\': \'Riprendi in mano fino a due carte creatura bersaglio dal tuo cimitero, poi scarta una carta.\', \'type\': \'Stregoneria\', \'flavor\': \'Liliana non è il tipo che si lascia condurre dagli altri.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448368&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'597b2fd0-3325-49c0-a0ed-38dbefb8b1e8\', \'multiverseId\': 448368}, \'multiverseid\': 448368}, {\'name\': \'死の円舞曲\', \'text\': \'あなたの墓地からクリーチャー・カード最大２枚を対象とし、それらをあなたの手札に戻し、その後カード１枚を捨てる。\', \'type\': \'ソーサリー\', \'flavor\': \'リリアナは、誰かのリードに合わせたりしない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448649&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'350b9e78-52c7-466b-841d-d53c1ecd551c\', \'multiverseId\': 448649}, \'multiverseid\': 448649}, {\'name\': \'죽음의 왈츠\', \'text\': \'당신의 무덤에 있는 생물 카드를 최대 두 장까지 목표로 정한다. 그 카드들을 당신의 손으로 되돌린 후, 카드 한 장을 버린다.\', \'type\': \'집중마법\', \'flavor\': \'릴리아나는 절대 누군가의 지시에 따라 움직이지 않는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448930&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4725bf8d-3986-4b0c-b26b-af2889ddf61a\', \'multiverseId\': 448930}, \'multiverseid\': 448930}, {\'name\': \'Valsa Macabra\', \'text\': \'Devolva até dois cards de criatura alvo de seu cemitério para sua mão e depois descarte um card.\', \'type\': \'Feitiço\', \'flavor\': \'Liliana não é de aceitar a liderança de outros.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449211&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d588821a-8370-449c-ab92-0d2a8bc97315\', \'multiverseId\': 449211}, \'multiverseid\': 449211}, {\'name\': \'Жуткий Вальс\', \'text\': \'Верните не более двух целевых карт существ из вашего кладбища в вашу руку, затем сбросьте карту.\', \'type\': \'Волшебство\', \'flavor\': \'Лилиана не из тех, кого можно вести.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449492&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ab242cb6-e92a-485f-9e8b-dd259adbafa4\', \'multiverseId\': 449492}, \'multiverseid\': 449492}, {\'name\': \'亡者华尔滋\', \'text\': \'将至多两张目标生物牌从你的坟墓场移回你手上，然后弃一张牌。\', \'type\': \'法术\', \'flavor\': \'莉莲娜从不是被带着走的那一位。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449773&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f9b1d62c-ef39-4dab-8fdc-a0a416181515\', \'multiverseId\': 449773}, \'multiverseid\': 449773}, {\'name\': \'亡者華爾滋\', \'text\': \'將至多兩張目標生物牌從你的墳墓場移回你手上，然後棄一張牌。\', \'type\': \'巫術\', \'flavor\': \'莉蓮娜從不是被帶著走的那一位。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450054&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'22a7a9b9-b4eb-4f24-8a1a-281ed1350cb1\', \'multiverseId\': 450054}, \'multiverseid\': 450054}]', "[{'name': 'Manalith', 'text': '{T}: Erzeuge ein Mana einer beliebigen Farbe.', 'type': 'Artefakt', 'flavor': 'Planeswalker suchen im ganzen Multiversum nach bedeutenden Monumenten, da diese meist unwissentlich in manareichen Gegenden erbaut wurden.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447657&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a8d1fa11-ae27-40fd-9748-94a077cb5c25', 'multiverseId': 447657}, 'multiverseid': 447657}, {'name': 'Manalito', 'text': '{T}: Agrega un maná de cualquier color.', 'type': 'Artefacto', 'flavor': 'Los Planeswalkers buscan grandes monumentos por el Multiverso, sabiendo que sus constructores fueron sin quererlo atraídos por la convergencia de maná en el área.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447938&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '66dc6598-1375-4651-aa63-6e5f8a3f9342', 'multiverseId': 447938}, 'multiverseid': 447938}, {'name': 'Manalithe', 'text': '{T} : Ajoutez un mana de la couleur de votre choix.', 'type': 'Artefact', 'flavor': 'Les Planeswalkers recherchent de grands monuments partout dans le Multivers, sachant que leurs architectes étaient attirés à leur insu par la convergence du mana dans leur secteur.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448219&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'f7ecfc5a-d32b-4b01-ab5a-5dd280570347', 'multiverseId': 448219}, 'multiverseid': 448219}, {'name': 'Manalito', 'text': '{T}: Aggiungi un mana di un qualsiasi colore.', 'type': 'Artefatto', 'flavor': 'I Planeswalker cercano grandi monumenti in tutto il Multiverso, sapendo che i loro costruttori erano inconsciamente attirati dalla convergenza di mana nella zona.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448500&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c091d91b-a81c-44e8-b9e0-9ebba1eaa25b', 'multiverseId': 448500}, 'multiverseid': 448500}, {'name': 'マナリス', 'text': '{T}：好きな色１色のマナ１点を加える。', 'type': 'アーティファクト', 'flavor': 'プレインズウォーカーは多元宇宙のあらゆる場所で大いなる遺跡を探す。その建設者がその場所に集まるマナに知らず知らず惹き付けられたと知っているからだ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448781&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '6e5633ca-4f11-43f4-805c-7eae5eb2aec2', 'multiverseId': 448781}, 'multiverseid': 448781}, {'name': '마나석탑', 'text': '{T}: 원하는 색의 마나 한 개를 추가한다.', 'type': '마법물체', 'flavor': '플레인즈워커들은 거대한 기념비를 세운 이들이 의도치 않게 그 지역에서 마나가 결합하는 지점에 이끌렸다는 사실을 알고 있기에, 다차원 우주 전체에 걸쳐 이러한 기념비를 찾는다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449062&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '9fafe8ae-ad7c-4a72-8e5f-fdd508447ace', 'multiverseId': 449062}, 'multiverseid': 449062}, {'name': 'Manólito', 'text': '{T}: Adicione um mana de qualquer cor.', 'type': 'Artefato', 'flavor': 'Os planeswalkers buscam grandes monumentos por todo o Multiverso, sabendo que seus construtores foram inadvertidamente atraídos pela convergência de mana na área.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449343&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '069b3a3e-5ac6-4920-96c1-276e5b7b9131', 'multiverseId': 449343}, 'multiverseid': 449343}, {'name': 'Маналит', 'text': '{T}: добавьте одну ману любого цвета.', 'type': 'Артефакт', 'flavor': 'По всей Мультивселенной planeswalker-ы ищут великие монументы, зная о том, что их создатели, сами того не сознавая, были привлечены к этим местам слиянием потоков маны.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449624&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '77d3f10d-1144-471b-80cb-75f77adb38c2', 'multiverseId': 449624}, 'multiverseid': 449624}, {'name': '魔力巨石', 'text': '{T}：加一点任意颜色的法术力。', 'type': '神器', 'flavor': '鹏洛客在多重宇宙间寻找巨大纪念碑，因为他们晓得其建造者是不自觉地受该处聚集的法术力吸引而来。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449905&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'ca7d60ed-e37c-4709-b677-74d9197ad498', 'multiverseId': 449905}, 'multiverseid': 449905}, {'name': '魔力巨石', 'text': '{T}：加一點任意顏色的魔法力。', 'type': '神器', 'flavor': '鵬洛客在多重宇宙間尋找巨大紀念碑，因為他們曉得其建造者是不自覺地受該處聚集的魔法力吸引而來。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450186&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '1d9ebb49-5282-4cda-a23a-4178d6031c90', 'multiverseId': 450186}, 'multiverseid': 450186}]", '[{\'name\': \'Mentor der Sanften\', \'text\': \'Immer wenn eine andere Kreatur mit Stärke 2 oder weniger unter deiner Kontrolle ins Spiel kommt, kannst du {1} bezahlen. Falls du dies tust, ziehe eine Karte.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'„In diesen Hallen gibt es kein Bestehen oder Scheitern. Deine wahre Prüfung kommt beim nächsten Vollmond."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447444&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'09d73149-84d9-480f-af92-761bdd2db2b3\', \'multiverseId\': 447444}, \'multiverseid\': 447444}, {\'name\': \'Mentor de los mansos\', \'text\': \'Siempre que otra criatura con fuerza de 2 o menos entre al campo de batalla bajo tu control, puedes pagar {1}. Si lo haces, roba una carta.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'"En estos salones no se aprueba o reprueba. El verdadero examen llega con la primera luna llena".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447725&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'018efff8-26ff-4f3f-980a-4400ada78c27\', \'multiverseId\': 447725}, \'multiverseid\': 447725}, {\'name\': \'Mentor des humbles\', \'text\': "À chaque fois qu\'une autre créature avec une force inférieure ou égale à 2 arrive sur le champ de bataille sous votre contrôle, vous pouvez payer {1}. Si vous faites ainsi, piochez une carte.", \'type\': \'Créature : humain et soldat\', \'flavor\': "« Ici il n\'y a pas d\'échec ou de réussite. Votre véritable examen de passage, c\'est la première pleine lune. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448006&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'52026a12-2e50-4e42-84c8-d05f96ce9c18\', \'multiverseId\': 448006}, \'multiverseid\': 448006}, {\'name\': \'Mentore degli Umili\', \'text\': "Ogniqualvolta un\'altra creatura con forza pari o inferiore a 2 entra nel campo di battaglia sotto il tuo controllo, puoi pagare {1}. Se lo fai, pesca una carta.", \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'"In queste sale non c\\\'è promosso o bocciato. La vostra vera prova avviene con la prima luna piena."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448287&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5313a397-0c04-41f8-af74-c10e1cd46ad4\', \'multiverseId\': 448287}, \'multiverseid\': 448287}, {\'name\': \'弱者の師\', \'text\': \'パワーが２以下の他のクリーチャーが１体あなたのコントロール下で戦場に出るたび、あなたは{1}を支払ってもよい。そうしたなら、カードを１枚引く。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'「これらの広間では、成功も失敗もありません。真の試練は最初の満月と共に訪れます。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448568&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'73a8a5fd-a3dc-4b1c-b585-56e0abbe7e61\', \'multiverseId\': 448568}, \'multiverseid\': 448568}, {\'name\': \'온순한 자들의 스승\', \'text\': \'공격력이 2 이하인 다른 생물이 당신의 조종하에 전장에 들어올 때마다, 당신은 {1}을 지불할 수 있다. 그렇게 한다면, 카드 한 장을 뽑는다.\', \'type\': \'생물 — 인간 병사\', \'flavor\': \'"이 교실에서는 합격도, 낙제도 없다. 제군들은 보름달이 뜨는 밤에 진정한 시험을 치르게 될 것이다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448849&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9646a7f8-882e-4b55-bdbc-3b0be0df955e\', \'multiverseId\': 448849}, \'multiverseid\': 448849}, {\'name\': \'Mentor dos Humildes\', \'text\': \'Toda vez que outra criatura com poder igual ou inferior a 2 entra no campo de batalha sob o seu controle, você pode pagar {1}. Se fizer isso, compre um card.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': \'"Nestes salões não há aprovação nem reprovação. Seu verdadeiro teste vem com a primeira lua cheia."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449130&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'517ff22c-ec1e-4d83-ac16-cefdbd4e99da\', \'multiverseId\': 449130}, \'multiverseid\': 449130}, {\'name\': \'Наставник Кротких\', \'text\': \'Каждый раз, когда другое существо с силой 2 или меньше выходит на поле битвы под вашим контролем, вы можете заплатить {1}. Если вы это делаете, возьмите карту.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'«В этих стенах нет понятий "сдал" и "провалился". Ваш настоящий экзамен начнется в первое полнолуние».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449411&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a2964ac2-64ee-431f-af34-55128f9f7278\', \'multiverseId\': 449411}, \'multiverseid\': 449411}, {\'name\': \'驯良明师\', \'text\': \'每当另一个力量等于或小于2的生物在你的操控下进战场时，你可以支付{1}。若你如此作，则抓一张牌。\', \'type\': \'生物 ～人类／士兵\', \'flavor\': \'「这课堂没有过不过关的问题。真正的考验会在第一次满月时到来。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449692&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'751f0cd3-b354-4ab9-9184-f41af26b5172\', \'multiverseId\': 449692}, \'multiverseid\': 449692}, {\'name\': \'馴良明師\', \'text\': \'每當另一個力量等於或小於2的生物在你的操控下進戰場時，你可以支付{1}。若你如此作，則抽一張牌。\', \'type\': \'生物 ～人類／士兵\', \'flavor\': \'「這課堂沒有過不過關的問題。真正的考驗會在第一次滿月時到來。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449973&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e45242f7-cbba-4bb3-bf74-81773736e17d\', \'multiverseId\': 449973}, \'multiverseid\': 449973}]', '[{\'name\': \'Meteorgolem\', \'text\': \'Wenn der Meteorgolem ins Spiel kommt, zerstöre eine bleibende Karte deiner Wahl, die kein Land ist und die ein Gegner kontrolliert.\', \'type\': \'Artefaktkreatur — Golem\', \'flavor\': \'Der Einschlag ließ die Soldaten erzittern — dann erhob sich etwas aus dem Krater.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447659&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0cdcf9f7-4466-4d43-a281-9ecb47e412fb\', \'multiverseId\': 447659}, \'multiverseid\': 447659}, {\'name\': \'Gólem meteoro\', \'text\': \'Cuando el Gólem meteoro entre al campo de batalla, destruye el permanente objetivo que no sea tierra que controla un oponente.\', \'type\': \'Criatura artefacto — Gólem\', \'flavor\': \'El impacto dispersó a los soldados y, después, algo emergió del cráter.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447940&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dd647110-55e5-4bdc-b655-a76c99688729\', \'multiverseId\': 447940}, \'multiverseid\': 447940}, {\'name\': \'Golem météoritique\', \'text\': "Quand le Golem météoritique arrive sur le champ de bataille, détruisez un permanent non-terrain ciblé qu\'un adversaire contrôle.", \'type\': \'Créature-artefact : golem\', \'flavor\': "L\'impact dispersa les soldats, puis quelque chose émergea du cratère.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448221&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f72e8a2f-3835-4c35-8de9-8de83eb2963b\', \'multiverseId\': 448221}, \'multiverseid\': 448221}, {\'name\': \'Golem Meteora\', \'text\': \'Quando il Golem Meteora entra nel campo di battaglia, distruggi un permanente non terra bersaglio controllato da un avversario.\', \'type\': \'Creatura Artefatto — Golem\', \'flavor\': "L\'impatto disperse i soldati, poi dal cratere emerse qualcosa.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448502&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'62387f53-f6ac-4117-9d3b-80ca4d677ab0\', \'multiverseId\': 448502}, \'multiverseid\': 448502}, {\'name\': \'隕石ゴーレム\', \'text\': \'隕石ゴーレムが戦場に出たとき、対戦相手がコントロールしていて土地でないパーマネント１つを対象とし、それを破壊する。\', \'type\': \'アーティファクト・クリーチャー — ゴーレム\', \'flavor\': \'その衝撃で兵士たちは散り散りになった。すると、その穴から何かが現れた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448783&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fe4e53b5-47ae-454c-952e-5802ce6e62e1\', \'multiverseId\': 448783}, \'multiverseid\': 448783}, {\'name\': \'유성 골렘\', \'text\': \'유성 골렘이 전장에 들어올 때, 상대가 조종하는 대지가 아닌 지속물을 목표로 정한다. 그 지속물을 파괴한다.\', \'type\': \'마법물체 생물 — 골렘\', \'flavor\': \'충격이 병사들을 흩어놓았다—그 후 구덩이에서 무엇인가가 나왔다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449064&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'031ceaca-d32e-4a48-b65b-f26e72d2caa8\', \'multiverseId\': 449064}, \'multiverseid\': 449064}, {\'name\': \'Golem Meteórico\', \'text\': \'Quando Golem Meteórico entrar no campo de batalha, destrua a permanente alvo que um oponente controla que não seja um terreno.\', \'type\': \'Criatura Artefato — Golem\', \'flavor\': \'O impacto dispersou os soldados — e então algo surgiu da cratera.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449345&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'52c8b076-b0eb-46f8-ace9-319aac3b7f7a\', \'multiverseId\': 449345}, \'multiverseid\': 449345}, {\'name\': \'Метеоритный Голем\', \'text\': \'Когда Метеоритный Голем выходит на поле битвы, уничтожьте целевой не являющийся землей перманент под контролем оппонента.\', \'type\': \'Артефакт Существо — Голем\', \'flavor\': \'От удара солдаты разлетелись в стороны — а потом что-то поднялось из кратера.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449626&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bdd7171a-340b-4e86-9243-350351112432\', \'multiverseId\': 449626}, \'multiverseid\': 449626}, {\'name\': \'陨石魔像\', \'text\': \'当陨石魔像进战场时，消灭目标由对手操控的非地永久物。\', \'type\': \'神器生物 ～魔像\', \'flavor\': \'冲击将士兵四散震飞～随后坑中有人影起身。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449907&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6949c859-a617-4dcc-8a0b-dac8dae9038d\', \'multiverseId\': 449907}, \'multiverseid\': 449907}, {\'name\': \'隕石魔像\', \'text\': \'當隕石魔像進戰場時，消滅目標由對手操控的非地永久物。\', \'type\': \'神器生物 ～魔像\', \'flavor\': \'衝擊將士兵四散震飛～隨後坑中有人影起身。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450188&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b81b1d02-cde4-476a-a938-7ab618b42cbf\', \'multiverseId\': 450188}, \'multiverseid\': 450188}]', '[{\'name\': \'Modifizierende Metamorphose\', \'text\': \'Verzaubert eine Kreatur\\nSowie die Modifizierende Metamorphose ins Spiel kommt, bestimme eine Kreatur.\\nDie verzauberte Kreatur ist eine Kopie der bestimmten Kreatur.\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447477&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'609dc8fd-f878-45f1-8335-ec6ac7ae572c\', \'multiverseId\': 447477}, \'multiverseid\': 447477}, {\'name\': \'Alteración metamórfica\', \'text\': \'Encantar criatura.\\nEn cuanto la Alteración metamórfica entre al campo de batalla, elige una criatura.\\nLa criatura encantada es una copia de la criatura elegida.\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447758&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'92a77aea-67c5-46aa-9ea2-6e61a6e35ed6\', \'multiverseId\': 447758}, \'multiverseid\': 447758}, {\'name\': \'Altération métamorphe\', \'text\': "Enchanter : créature\\nAu moment où l\'Altération métamorphe arrive sur le champ de bataille, choisissez une créature.\\nLa créature enchantée est une copie de la créature choisie.", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448039&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9faadf96-c040-4f31-b4d4-896248461e51\', \'multiverseId\': 448039}, \'multiverseid\': 448039}, {\'name\': \'Alterazione Metamorfica\', \'text\': "Incanta creatura\\nMentre l\'Alterazione Metamorfica entra nel campo di battaglia, scegli una creatura.\\nLa creatura incantata è una copia della creatura scelta.", \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448320&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b756c895-e4f3-4ffe-8182-d605bf9f8b1d\', \'multiverseId\': 448320}, \'multiverseid\': 448320}, {\'name\': \'変態変異\', \'text\': \'エンチャント（クリーチャー）\\n変態変異が戦場に出るに際し、クリーチャー１体を選ぶ。\\nエンチャントされているクリーチャーは、その選ばれたクリーチャーのコピーになる。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448601&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'13a1ca18-47b1-4c39-88f2-1d3d1890a6d1\', \'multiverseId\': 448601}, \'multiverseid\': 448601}, {\'name\': \'변성 개조\', \'text\': \'생물에게 부여\\n변성 개조가 전장에 들어오면서, 생물 한 개를 선택한다.\\n부여된 생물은 선택된 생물의 복사본이다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448882&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'05006a0d-e4c1-446c-82d3-088ca3bfe8b4\', \'multiverseId\': 448882}, \'multiverseid\': 448882}, {\'name\': \'Alteração Metamórfica\', \'text\': \'Encantar criatura\\nConforme Alteração Metamórfica entrar no campo de batalha, escolha uma criatura.\\nA criatura encantada é uma cópia da criatura escolhida.\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449163&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'508bc496-6781-470e-908e-afe4422e311a\', \'multiverseId\': 449163}, \'multiverseid\': 449163}, {\'name\': \'Метаморфическое Преобразование\', \'text\': \'Зачаровать существо\\nПри выходе Метаморфического Преобразования на поле битвы выберите существо.\\nЗачарованное существо является копией выбранного существа.\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449444&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2afead4a-65dc-4168-8b6c-c91678e7dbb7\', \'multiverseId\': 449444}, \'multiverseid\': 449444}, {\'name\': \'拟形变幻\', \'text\': \'结附于生物\\n于拟形变幻进战场时，选择一个生物。\\n所结附的生物是所选生物的复制品。\', \'type\': \'结界 ～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449725&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3bdf03ba-73cb-4f08-a5c5-baaf58b461ed\', \'multiverseId\': 449725}, \'multiverseid\': 449725}, {\'name\': \'擬形變幻\', \'text\': \'結附於生物\\n於擬形變幻進戰場時，選擇一個生物。\\n所結附的生物是所選生物的複製品。\', \'type\': \'結界 ～靈氣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450006&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7b654c62-33d6-4566-8f53-a29c7dadb1d0\', \'multiverseId\': 450006}, \'multiverseid\': 450006}]', '[{\'name\': \'Moraststampfer\', \'type\': \'Kreatur — Bestie\', \'flavor\': \'„Trotz ihrer enormen Größe sind sie sanfte Pflanzenfresser. Nähere dich mit Bedacht und summe eine Melodie, um sie wissen zu lassen, dass du ihnen nicht schaden willst."\\n—Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447504&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'adfcd566-db5e-4da2-9a30-774fb4cf004b\', \'multiverseId\': 447504}, \'multiverseid\': 447504}, {\'name\': \'Pisapantanos\', \'type\': \'Criatura — Bestia\', \'flavor\': \'"Son herbívoros pacíficos, a pesar de su tamaño. Acércate con cuidado y tararea una canción para que sepan que no les vas a hacer daño".\\n—Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447785&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c9b56a39-8105-432c-b413-54283ec5035d\', \'multiverseId\': 447785}, \'multiverseid\': 447785}, {\'name\': \'Piétineur des marécages\', \'type\': \'Créature : bête\', \'flavor\': "« Malgré leur taille, ce sont de paisibles herbivores. Approchez-vous avec prudence, et fredonnez un air pour qu\'ils sachent que vous ne leur voulez aucun mal. »\\n—Vivien Reid", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448066&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'59bb8b44-9e2d-4afc-a2b3-07024df66b08\', \'multiverseId\': 448066}, \'multiverseid\': 448066}, {\'name\': \'Calcapaludi\', \'type\': \'Creatura — Bestia\', \'flavor\': \'"A dispetto delle loro dimensioni, sono erbivori piuttosto innocui. Avvicinati con cautela e intona una melodia, così capiranno che le tue intenzioni sono pacifiche."\\n—Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448347&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'822f1855-4669-47c9-aadd-7998a9a26d0e\', \'multiverseId\': 448347}, \'multiverseid\': 448347}, {\'name\': \'沼踏み\', \'type\': \'クリーチャー — ビースト\', \'flavor\': \'「大きさによらず、優しい草食動物なのよ。ゆっくり近づいて、鼻歌を歌って敵意はないと知らせるの。」\\n――ビビアン・リード\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448628&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0c35f262-c7c1-4885-a5e3-0b7cfe1d0e44\', \'multiverseId\': 448628}, \'multiverseid\': 448628}, {\'name\': \'늪지 괴수\', \'type\': \'생물 — 야수\', \'flavor\': \'"그것들은 크긴 하지만 온순한 초식동물이야. 조심스럽게 다가간 다음, 해칠 생각이 없다고 소리를 내서 알려 줘."\\n—비비안 레이드\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448909&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'999f6e23-c604-48e6-b776-20abd36b7741\', \'multiverseId\': 448909}, \'multiverseid\': 448909}, {\'name\': \'Calca-pântano\', \'type\': \'Criatura — Besta\', \'flavor\': \'"São herbívoros gentis, a despeito do tamanho. Aproxime-se com cuidado e murmure uma melodia para mostrar que não lhes quer fazer mal.\\n— Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449190&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'009367ce-d0f9-4413-a0b1-42dd5f79fd5b\', \'multiverseId\': 449190}, \'multiverseid\': 449190}, {\'name\': \'Болотный Тяжелоступ\', \'type\': \'Существо — Зверь\', \'flavor\': \'«Не смотри на его размер. Это скромное травоядное животное. Подойди к нему осторожнее и напевай что-нибудь под нос — покажи, что не желаешь зла».\\n— Вивьен Рейд\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449471&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e91701b5-253f-4483-8fe9-f780e90b0671\', \'multiverseId\': 449471}, \'multiverseid\': 449471}, {\'name\': \'腐沼跺地兽\', \'type\': \'生物 ～野兽\', \'flavor\': \'「它们虽然个头大，但都是温顺的食草动物。小心靠近，然后口中哼点小曲，让它们知道你没有恶意。」\\n～薇薇安瑞德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449752&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ef8eac4c-b41a-4379-9b89-a31e82b1636e\', \'multiverseId\': 449752}, \'multiverseid\': 449752}, {\'name\': \'腐沼跺地獸\', \'type\': \'生物 ～野獸\', \'flavor\': \'「牠們雖然個頭大，但都是溫順的食草動物。小心靠近，然後口中哼點小曲，讓牠們知道你沒有惡意。」\\n～薇薇安瑞德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450033&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'34046fae-d2e5-409e-b2a5-a2fa19e30308\', \'multiverseId\': 450033}, \'multiverseid\': 450033}]', '[{\'name\': \'Mord\', \'text\': \'Zerstöre eine Kreatur deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Es ist keine Arbeit, wenn es dir Spaß macht."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447527&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'132a0b8b-be76-448a-902c-910f4ab5dca3\', \'multiverseId\': 447527}, \'multiverseid\': 447527}, {\'name\': \'Asesinato\', \'text\': \'Destruye la criatura objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"No es trabajo si lo disfrutas".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447808&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b46b68c2-5a5c-4e99-a2f9-56819c712bf5\', \'multiverseId\': 447808}, \'multiverseid\': 447808}, {\'name\': \'Homicide\', \'text\': \'Détruisez la créature ciblée.\', \'type\': \'Éphémère\', \'flavor\': "« Si on prend plaisir à une chose, ce n\'est pas un travail. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448089&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'42c044d8-f675-4ca7-9917-a7bcc0d488b1\', \'multiverseId\': 448089}, \'multiverseid\': 448089}, {\'name\': \'Omicidio\', \'text\': \'Distruggi una creatura bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Se ti diverte, non è lavoro."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448370&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0a2245d5-975d-42b9-ac62-d7c0051b65f6\', \'multiverseId\': 448370}, \'multiverseid\': 448370}, {\'name\': \'殺害\', \'text\': \'クリーチャー１体を対象とし、それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'「楽しんでいるなら仕事とは言えない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448651&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'204be1a2-f31b-4638-93e5-b71bc6e99ace\', \'multiverseId\': 448651}, \'multiverseid\': 448651}, {\'name\': \'살인\', \'text\': \'생물을 목표로 정한다. 그 생물을 파괴한다.\', \'type\': \'순간마법\', \'flavor\': \'"즐긴다면야 일도 아니지."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448932&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'090e107d-5eef-40d3-ac47-1cd6074c4933\', \'multiverseId\': 448932}, \'multiverseid\': 448932}, {\'name\': \'Homicídio\', \'text\': \'Destrua a criatura alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Não é trabalho se te dá prazer."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449213&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'edf11a20-16a4-4995-9b3a-a6d478f9e49c\', \'multiverseId\': 449213}, \'multiverseid\': 449213}, {\'name\': \'Убийство\', \'text\': \'Уничтожьте целевое существо.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Какая же это работа, если от нее одно удовольствие?»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449494&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'352184e6-a695-4a30-ac2a-b0a5a86cf1a1\', \'multiverseId\': 449494}, \'multiverseid\': 449494}, {\'name\': \'谋杀\', \'text\': \'消灭目标生物。\', \'type\': \'瞬间\', \'flavor\': \'「如果你乐在其中，那就不叫工作。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449775&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4b35e9ec-fe83-4b80-bba6-856103f0dcbd\', \'multiverseId\': 449775}, \'multiverseid\': 449775}, {\'name\': \'謀殺\', \'text\': \'消滅目標生物。\', \'type\': \'瞬間\', \'flavor\': \'「如果你樂在其中，那就不叫工作。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450056&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'cdaaeac0-b88b-410c-965b-743994933151\', \'multiverseId\': 450056}, \'multiverseid\': 450056}]', "[{'name': 'Mystischer Archäologe', 'text': '{3}{U}{U}: Ziehe zwei Karten.', 'type': 'Kreatur — Mensch, Zauberer', 'flavor': 'Die Freude über die Entdeckung treibt den Stand des Wissens voran.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447480&type=card', 'language': 'German', 'identifiers': {'scryfallId': '50bc6175-208f-4dce-bae7-e7b95c8db17c', 'multiverseId': 447480}, 'multiverseid': 447480}, {'name': 'Especialista en arqueología mística', 'text': '{3}{U}{U}: Roba dos cartas.', 'type': 'Criatura — Hechicero humano', 'flavor': 'El placer del descubrimiento mueve la búsqueda del conocimiento.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447761&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5dde5be3-1c72-4835-9c7d-c61830072670', 'multiverseId': 447761}, 'multiverseid': 447761}, {'name': 'Archéologue mystique', 'text': '{3}{U}{U} : Piochez deux cartes.', 'type': 'Créature : humain et sorcier', 'flavor': 'Le plaisir de la découverte encourage la poursuite de la connaissance.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448042&type=card', 'language': 'French', 'identifiers': {'scryfallId': '4b72cb5a-2bec-453b-8f34-e84b1cb49d12', 'multiverseId': 448042}, 'multiverseid': 448042}, {'name': 'Archeista Misticista', 'text': '{3}{U}{U}: Pesca due carte.', 'type': 'Creatura — Mago Umano', 'flavor': 'La ricerca della conoscenza è motivata dal piacere della scoperta.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448323&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b3d0a12a-1bd9-4cf6-a959-0466c41624b0', 'multiverseId': 448323}, 'multiverseid': 448323}, {'name': '神秘の考古学者', 'text': '{3}{U}{U}：カードを２枚引く。', 'type': 'クリーチャー — 人間・ウィザード', 'flavor': '発見の喜びは知識追求の原動力となる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448604&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f5fd1bd7-fccc-434c-ae60-d8792cea1335', 'multiverseId': 448604}, 'multiverseid': 448604}, {'name': '신비한 고고학자', 'text': '{3}{U}{U}: 카드 두 장을 뽑는다.', 'type': '생물 — 인간 마법사', 'flavor': '발견의 기쁨이 지식의 추구에 박차를 가한다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448885&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'd5f09036-c41f-40f2-9f78-074f101ee61e', 'multiverseId': 448885}, 'multiverseid': 448885}, {'name': 'Especialista em Arqueologia Espiritual', 'text': '{3}{U}{U}: Compre dois cards.', 'type': 'Criatura — Humano Mago', 'flavor': 'A delícia da descoberta compele a busca pelo conhecimento.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449166&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '85aa2b22-790c-40c3-9c32-1505c5208822', 'multiverseId': 449166}, 'multiverseid': 449166}, {'name': 'Археолог-Мистик', 'text': '{3}{U}{U}: возьмите две карты.', 'type': 'Существо — Человек Чародей', 'flavor': 'Радость открытий движет теми, кто жаждет знаний.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449447&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'b8cd0644-6e15-4d14-a30f-8c0b42612b2c', 'multiverseId': 449447}, 'multiverseid': 449447}, {'name': '神秘考古学家', 'text': '{3}{U}{U}：抓两张牌。', 'type': '生物 ～人类／法术师', 'flavor': '发现之喜推动求知之道。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449728&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '60cb7a92-4ad7-4c08-80b2-51518837ad26', 'multiverseId': 449728}, 'multiverseid': 449728}, {'name': '神秘考古學家', 'text': '{3}{U}{U}：抽兩張牌。', 'type': '生物 ～人類／魔法師', 'flavor': '發現之喜推動求知之道。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450009&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '69031103-8121-41ad-a119-59d7c4dd2df3', 'multiverseId': 450009}, 'multiverseid': 450009}]", '[{\'name\': \'Mäanderstrom\', \'text\': \'Der Mäanderstrom kommt getappt ins Spiel.\\n{T}: Erzeuge {W} oder {U}.\', \'type\': \'Land\', \'flavor\': \'Der Strom teilt sich in zahllose Arme, die alle ins Halimar-Meer münden. Nur wenige Reisende finden zweimal denselben Weg.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447671&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3c38d3eb-699f-4241-9d4e-fea02386e881\', \'multiverseId\': 447671}, \'multiverseid\': 447671}, {\'name\': \'Río serpenteante\', \'text\': \'El Río serpenteante entra al campo de batalla girado.\\n{T}: Agrega {W} o {U}.\', \'type\': \'Tierra\', \'flavor\': \'El río se bifurcaba en muchos canales hasta llegar al mar de Halimar. Pocos eran los viajeros que podían seguir el mismo canal dos veces.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447952&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'18b52503-8442-47ca-b59a-6810e10e9cbd\', \'multiverseId\': 447952}, \'multiverseid\': 447952}, {\'name\': \'Rivière sinueuse\', \'text\': \'La Rivière sinueuse arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {W} ou {U}.\', \'type\': \'Terrain\', \'flavor\': "La rivière se scindait en plusieurs canaux en s\'écoulant vers la mer d\'Halimar. Peu de voyageurs parvenaient à suivre le même deux fois.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448233&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fa989e6a-954e-4957-825a-78814962d1a2\', \'multiverseId\': 448233}, \'multiverseid\': 448233}, {\'name\': \'Fiume Serpeggiante\', \'text\': \'Il Fiume Serpeggiante entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {W} o {U}.\', \'type\': \'Terra\', \'flavor\': \'Il fiume si divideva in molti canali fluendo verso il Mare di Halimar. Pochi viaggiatori sapevano percorrere lo stesso due volte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448514&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'71e5e878-ce47-4aee-a03e-363157194360\', \'multiverseId\': 448514}, \'multiverseid\': 448514}, {\'name\': \'曲がりくねる川\', \'text\': \'曲がりくねる川はタップ状態で戦場に出る。\\n{T}：{W}か{U}を加える。\', \'type\': \'土地\', \'flavor\': \'川は幾度も分岐を繰り返しハリマーの海に注ぎ込む。旅人が同じ川筋をふたたび辿ることは難しかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448795&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6ebe3a6c-18bd-4b84-9b20-5a86a4fa04ce\', \'multiverseId\': 448795}, \'multiverseid\': 448795}, {\'name\': \'굽이치는 강\', \'text\': \'굽이치는 강은 탭된 채로 전장에 들어온다.\\n{T}: {W} 또는 {U}를 추가한다.\', \'type\': \'대지\', \'flavor\': \'강은 수많은 줄기로 갈라져 할리마르해로 흘러갔다. 같은 강줄기를 다시 따라가는 것은 불가능하다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449076&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a7cd1c99-b3bb-4e2c-898b-47f736bd8abb\', \'multiverseId\': 449076}, \'multiverseid\': 449076}, {\'name\': \'Rio Sinuoso\', \'text\': \'Rio Sinuoso entra no campo de batalha virado.\\n{T}: Adicione {W} ou {U}.\', \'type\': \'Terreno\', \'flavor\': \'O rio dividia-se em vários canais ao fluir para o Mar de Halimar. Poucos viajantes conseguiam seguir o mesmo canal duas vezes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449357&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2219579e-4c76-46cb-8c44-be1a98801f5a\', \'multiverseId\': 449357}, \'multiverseid\': 449357}, {\'name\': \'Извилистая Река\', \'text\': \'Извилистая Река выходит на поле битвы повернутой.\\n{T}: добавьте {W} или {U}.\', \'type\': \'Земля\', \'flavor\': \'Впадая в Халимарское море, река разделяется на множество рукавов. Немногим путешественникам удавалось пройти одним и тем же путем дважды.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449638&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ef384d22-81a0-4106-a8df-da0417509b48\', \'multiverseId\': 449638}, \'multiverseid\': 449638}, {\'name\': \'蜿蜒河流\', \'text\': \'蜿蜒河流须横置进战场。\\n{T}：加{W}或{U}。\', \'type\': \'地\', \'flavor\': \'河流奔向哈利玛海途中折出众多支流。鲜有旅人能循着同一条支流走两次。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449919&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f0b6b0bd-b46f-4fe9-b61d-58b3c1df6ce2\', \'multiverseId\': 449919}, \'multiverseid\': 449919}, {\'name\': \'蜿蜒河流\', \'text\': \'蜿蜒河流須橫置進戰場。\\n{T}：加{W}或{U}。\', \'type\': \'地\', \'flavor\': \'河流奔向哈利瑪海途中折出眾多支流。鮮有旅人能循著同一條支流走兩次。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450200&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2d0fd38c-2a17-4f51-8a2b-37182117547a\', \'multiverseId\': 450200}, \'multiverseid\': 450200}]', '[{\'name\': \'Mächtiger Sprung\', \'text\': \'Eine Kreatur deiner Wahl erhält +2/+2 und Flugfähigkeit bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ich spüre in der Zweiten Sonne die Herrlichkeit des Gott-Pharaos und erhebe mich auf ihren Strahlen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447445&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'13f01d60-20ee-4aef-9704-f5dee451252b\', \'multiverseId\': 447445}, \'multiverseid\': 447445}, {\'name\': \'Salto formidable\', \'text\': \'La criatura objetivo obtiene +2/+2 y gana la habilidad de volar hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"Percibo la presencia del Dios Faraón en el Segundo Sol, y sus rayos me elevan".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447726&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'36576ef6-19a7-42a2-9c39-fbf7cc74dde1\', \'multiverseId\': 447726}, \'multiverseid\': 447726}, {\'name\': \'Sacré saut\', \'text\': "La créature ciblée gagne +2/+2 et acquiert le vol jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': "« Je sens la présence du Dieu-Pharaon dans le Second Soleil et je m\'élève, portée par ses rayons. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448007&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fb6ddeef-0424-42c8-8215-caae6fe0b8e7\', \'multiverseId\': 448007}, \'multiverseid\': 448007}, {\'name\': \'Balzo Possente\', \'text\': \'Una creatura bersaglio prende +2/+2 e ha volare fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Avverto la presenza del Dio Faraone nel secondo sole e mi innalzo dinanzi ai suoi raggi."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448288&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'59f750e1-5a0b-4d45-88ff-615156cbb322\', \'multiverseId\': 448288}, \'multiverseid\': 448288}, {\'name\': \'力強い跳躍\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋２/＋２の修整を受け、飛行を得る。\', \'type\': \'インスタント\', \'flavor\': \'「副陽に王神の存在を感じる。私はその光に向かうわ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448569&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cc2f21c4-e2c8-4a82-979d-b134c74edf47\', \'multiverseId\': 448569}, \'multiverseid\': 448569}, {\'name\': \'힘찬 도약\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 +2/+2를 받고 비행을 얻는다.\', \'type\': \'순간마법\', \'flavor\': \'"두 번째 태양에서 신 파라오의 존재가 느껴진다. 난 그 빛을 받고 일어서리라."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448850&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3463c283-5394-4260-ba65-2b8dc5b171e9\', \'multiverseId\': 448850}, \'multiverseid\': 448850}, {\'name\': \'Salto Poderoso\', \'text\': \'A criatura alvo recebe +2/+2 e ganha voar até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Sinto a presença do Faraó-Deus no Segundo Sol, e seus raios me elevam."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449131&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'29688e6c-4e2b-4063-852b-1fabc7f0d0dc\', \'multiverseId\': 449131}, \'multiverseid\': 449131}, {\'name\': \'Мощный Прыжок\', \'text\': \'Целевое существо получает +2/+2 и Полет до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Я чувствую Бога-Фараона во Втором Солнце — и поднимаюсь на его лучах».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449412&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1b246e82-c7a2-4add-8b36-9b2ce7cfab89\', \'multiverseId\': 449412}, \'multiverseid\': 449412}, {\'name\': \'大步飞跃\', \'text\': \'直到回合结束，目标生物得+2/+2且获得飞行异能。\', \'type\': \'瞬间\', \'flavor\': \'「我感受到神日中法老神的存在，我朝其光芒而起。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449693&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5019f6f4-9b20-48d8-a9d2-ec44712fcd6b\', \'multiverseId\': 449693}, \'multiverseid\': 449693}, {\'name\': \'大步飛躍\', \'text\': \'直到回合結束，目標生物得+2/+2且獲得飛行異能。\', \'type\': \'瞬間\', \'flavor\': \'「我感受到神日中法老神的存在，我朝其光芒而起。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449974&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'093ff58a-86da-44b9-abe2-19f0c9ea159b\', \'multiverseId\': 449974}, \'multiverseid\': 449974}]', '[{\'name\': \'Mühlstein\', \'text\': \'{2}, {T}: Ein Spieler deiner Wahl legt die obersten zwei Karten seiner Bibliothek auf seinen Friedhof.\', \'type\': \'Artefakt\', \'flavor\': \'So wie ein Gebirge ist auch ein Verstand niemals so grandios und mächtig, dass er nicht zu Staub werden könnte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447660&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8bbd6edf-58d6-4bb1-b0d8-c99c52693d02\', \'multiverseId\': 447660}, \'multiverseid\': 447660}, {\'name\': \'Rueda de molino\', \'text\': \'{2}, {T}: El jugador objetivo pone las dos primeras cartas de su biblioteca en su cementerio.\', \'type\': \'Artefacto\', \'flavor\': \'Las mentes, como las montañas, nunca son tan magníficas y poderosas como para no poder ser reducidas a polvo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447941&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'41950111-1251-49ac-baed-b1b29ebd2d5a\', \'multiverseId\': 447941}, \'multiverseid\': 447941}, {\'name\': \'Meule\', \'text\': \'{2}, {T} : Le joueur ciblé met les deux cartes du dessus de sa bibliothèque dans son cimetière.\', \'type\': \'Artefact\', \'flavor\': "À l\'instar des montagnes, tout esprit, si grandiose et puissant soit-il, peut être réduit en poussière.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448222&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8b07aca5-956f-4cb9-b540-93a9fc0ba1a4\', \'multiverseId\': 448222}, \'multiverseid\': 448222}, {\'name\': \'Pietra da Macina Magica\', \'text\': \'{2}, {T}: Un giocatore bersaglio mette nel suo cimitero le prime due carte del suo grimorio.\', \'type\': \'Artefatto\', \'flavor\': \'Le menti, come le montagne, non sono mai tanto grandi e potenti da non poter essere ridotte in polvere.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448503&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'924f46ff-a92a-4830-b885-042faa47493e\', \'multiverseId\': 448503}, \'multiverseid\': 448503}, {\'name\': \'石臼\', \'text\': \'{2}, {T}：プレイヤー１人を対象とする。そのプレイヤーは、自分のライブラリーの一番上からカードを２枚自分の墓地に置く。\', \'type\': \'アーティファクト\', \'flavor\': \'精神も山も似たようなもので、粉々にできないほど壮大で力強いわけでもない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448784&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7d9bdf37-1cd8-4843-bb7c-7dedc71d958b\', \'multiverseId\': 448784}, \'multiverseid\': 448784}, {\'name\': \'맷돌\', \'text\': \'{2}, {T}: 플레이어를 목표로 정한다. 그 플레이어는 자신의 서고 맨 위 카드 두 장을 자신의 무덤에 넣는다.\', \'type\': \'마법물체\', \'flavor\': \'사람의 정신은 산과 같다. 그 아무리 크고 아름다운 산일지라도 시간이 흐르면 먼지가 된다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449065&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0bc47732-f741-4f88-8866-5c25b2152c54\', \'multiverseId\': 449065}, \'multiverseid\': 449065}, {\'name\': \'Mó\', \'text\': \'{2}, {T}: O jogador alvo coloca os dois cards do topo do próprio grimório no próprio cemitério.\', \'type\': \'Artefato\', \'flavor\': \'As mentes, assim como as montanhas, jamais são tão grandiosas e poderosas que não possam ser reduzidas a pó.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449346&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b2b7a1d7-00d8-4d6a-ac39-602c4a1db8eb\', \'multiverseId\': 449346}, \'multiverseid\': 449346}, {\'name\': \'Мельничный Жернов\', \'text\': \'{2}, {T}: целевой игрок кладет две верхние карты своей библиотеки на свое кладбище.\', \'type\': \'Артефакт\', \'flavor\': \'Умы, как и горы, могут казаться величественными и несокрушимыми, пока не сотрешь их в пыль.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449627&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'966bc621-6426-4deb-b446-8b312faff306\', \'multiverseId\': 449627}, \'multiverseid\': 449627}, {\'name\': \'研磨石轮\', \'text\': \'{2}，{T}：目标牌手将其牌库顶的两张牌置入其坟墓场。\', \'type\': \'神器\', \'flavor\': \'头脑就像山脉一般，无论多么雄伟宏大，都依旧可以化为尘埃。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449908&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'305080a5-9ece-4a4e-96ad-6bba50eb1426\', \'multiverseId\': 449908}, \'multiverseid\': 449908}, {\'name\': \'研磨石輪\', \'text\': \'{2}，{T}：目標玩家將其牌庫頂的兩張牌置入其墳墓場。\', \'type\': \'神器\', \'flavor\': \'頭腦就像山脈一般，無論多麼雄偉宏大，都依舊可以化為塵埃。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450189&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'198fbcf4-9185-4af1-8be5-cf0b2664a57c\', \'multiverseId\': 450189}, \'multiverseid\': 450189}]', '[{\'name\': \'Naturalisieren\', \'text\': \'Zerstöre ein Artefakt oder eine Verzauberung deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Und falls du mir noch einmal drohst, werden aus deinen glänzenden Stahlhosen Dolchdornranken sprießen."\\n—Iveta, Dach-Läuferin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447607&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'076a2a79-26db-4e86-9c47-f734851df3ea\', \'multiverseId\': 447607}, \'multiverseid\': 447607}, {\'name\': \'Naturalizar\', \'text\': \'Destruye el artefacto o encantamiento objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Y si vuelves a amenazarme, brotarán hiedras dagaespina de tus brillantes pantalones metálicos".\\n—Iveta, corredora de los tejados\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447888&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e9ef337b-0da7-4477-bf92-29f694b5443c\', \'multiverseId\': 447888}, \'multiverseid\': 447888}, {\'name\': \'Naturalisation\', \'text\': "Détruisez l\'artefact ciblé ou l\'enchantement ciblé.", \'type\': \'Éphémère\', \'flavor\': \'« Une menace de plus, et vos jambières en acier rutilant se couvriront de ronces daguépine. »\\n—Iveta, coureuse des toits\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448169&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'19e93392-92c9-4cef-a2dd-6ab696344245\', \'multiverseId\': 448169}, \'multiverseid\': 448169}, {\'name\': \'Ritorno alla Natura\', \'text\': \'Distruggi un artefatto o un incantesimo bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"E se mi minacci un\\\'altra volta, nei tuoi lucenti pantaloni di acciaio spunterà un cespuglio di rovi."\\n—Iveta, velocista dei tetti\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448450&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9d71aeb3-7525-4fe3-98ca-b1d1a4150ef8\', \'multiverseId\': 448450}, \'multiverseid\': 448450}, {\'name\': \'帰化\', \'text\': \'アーティファクト１つかエンチャント１つを対象とし、それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'「今度あたしを脅したら、ピカピカの鋼のズボンから剣茨の蔦が這い出てくるからね。」\\n――屋上の走り手、イヴェータ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448731&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6491bfb4-2921-4eb6-8dda-fd48bd0378e4\', \'multiverseId\': 448731}, \'multiverseid\': 448731}, {\'name\': \'자연화\', \'text\': \'마법물체나 부여마법을 목표로 정한다. 그 목표를 파괴한다.\', \'type\': \'순간마법\', \'flavor\': \'"날 한 번만 더 위협하면 네 반짝이는 강철 바지에서 비수가시 넝쿨이 자라나게 하겠어."\\n—옥상 주자, 이베타\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449012&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ab7d361a-4453-41fa-a812-b592c2ebf2da\', \'multiverseId\': 449012}, \'multiverseid\': 449012}, {\'name\': \'Naturalizar\', \'text\': \'Destrua o artefato ou encantamento alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"E se vocês me ameaçarem de novo, vão nascer vinhas espinho-de-adaga nessas suas calças de aço reluzente."\\n— Iveta, corredora de telhados\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449293&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f4ab4bb5-a55d-4059-98cb-9dac79872858\', \'multiverseId\': 449293}, \'multiverseid\': 449293}, {\'name\': \'Приживание\', \'text\': \'Уничтожьте целевой артефакт или чары.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Еще одна угроза — и твои блестящие доспехи насквозь прорастут колючим терновником».\\n— Ивета, бегущая по крышам\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449574&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2af238ee-8188-48a5-b389-5767f5b9bd9c\', \'multiverseId\': 449574}, \'multiverseid\': 449574}, {\'name\': \'回归自然\', \'text\': \'消灭目标神器或结界。\', \'type\': \'瞬间\', \'flavor\': \'「如果你胆敢再威胁我，我就让你那闪闪发亮的铁裤子长出锋利荆棘。」\\n～屋顶奔越者依薇塔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449855&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'eaf80ea2-d840-4cef-83ae-89a07f655383\', \'multiverseId\': 449855}, \'multiverseid\': 449855}, {\'name\': \'回歸自然\', \'text\': \'消滅目標神器或結界。\', \'type\': \'瞬間\', \'flavor\': \'「如果你膽敢再威脅我，我就讓你那閃閃發亮的鐵褲子長出鋒利荊棘。」\\n～屋頂奔越者依薇塔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450136&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2cd28fbe-079f-44d1-9afa-db10059e2a76\', \'multiverseId\': 450136}, \'multiverseid\': 450136}]', '[{\'name\': \'Nebelrufer\', \'text\': \'Opfere den Nebelrufer: Falls bis zum Ende des Zuges eine Nichtspielsteinkreatur ins Spiel kommen würde und sie nicht gewirkt wurde, schicke sie stattdessen ins Exil.\', \'type\': \'Kreatur — Meervolk, Zauberer\', \'flavor\': \'Gastfreundschaft ist denen unbekannt, die lieber ungestört bleiben wollen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447479&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1135865d-d3f1-4ea4-aaa0-9884984b30fd\', \'multiverseId\': 447479}, \'multiverseid\': 447479}, {\'name\': \'Invocaniebla\', \'text\': \'Sacrificar el Invocaniebla: Hasta el final del turno, si una criatura que no sea ficha fuera a entrar al campo de batalla y no fue lanzada, en vez de eso, exíliala.\', \'type\': \'Criatura — Hechicero tritón\', \'flavor\': \'La hospitalidad es poco relevante para aquellos que no quieren ser molestados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447760&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'14d9d8d9-a038-48a0-b91d-211e77501f1b\', \'multiverseId\': 447760}, \'multiverseid\': 447760}, {\'name\': \'Meneur de brume\', \'text\': "Sacrifiez le Meneur de brume : Jusqu\'à la fin du tour, si une créature non-jeton devait arriver sur le champ de bataille et qu\'elle n\'a pas été lancée, exilez-la à la place.", \'type\': \'Créature : ondin et sorcier\', \'flavor\': "L\'hospitalité importe peu à ceux qui ne souhaitent pas être dérangés.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448041&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'02f102fe-e0e7-4238-be2b-8c1b977be720\', \'multiverseId\': 448041}, \'multiverseid\': 448041}, {\'name\': \'Evocabruma\', \'text\': "Sacrifica l\'Evocabruma: Fino alla fine del turno, se una creatura non pedina sta per entrare nel campo di battaglia e non è stata lanciata, invece esiliala.", \'type\': \'Creatura — Mago Tritone\', \'flavor\': "L\'ospitalità poco importa a coloro che non vogliono essere disturbati.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448322&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3c9abae9-520c-4874-926b-0b6f277d3914\', \'multiverseId\': 448322}, \'multiverseid\': 448322}, {\'name\': \'霧の呼び手\', \'text\': \'霧の呼び手を生け贄に捧げる：ターン終了時まで、トークンでないクリーチャーが、それが唱えられることなく戦場に出るなら、代わりにそれを追放する。\', \'type\': \'クリーチャー — マーフォーク・ウィザード\', \'flavor\': \'もてなしは邪魔されたくない者へ対する小さな配慮から成る。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448603&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ecf8edab-d346-43d2-9713-87be257622b8\', \'multiverseId\': 448603}, \'multiverseid\': 448603}, {\'name\': \'안개소환사\', \'text\': \'안개소환사를 희생한다: 턴종료까지, 토큰이 아닌 생물이 발동되지 않고 전장에 들어오려 하면, 대신 그 생물을 추방한다.\', \'type\': \'생물 — 인어 마법사\', \'flavor\': \'친절한 대접은 방해받지 않으려는 사람들을 신경 써 주는 것이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448884&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a0e6c7ca-19ab-40c1-82e6-766b76a860b9\', \'multiverseId\': 448884}, \'multiverseid\': 448884}, {\'name\': \'Invocador das Brumas\', \'text\': \'Sacrifique Invocador das Brumas: Até o final do turno, se uma criatura que não seja uma ficha entraria no campo de batalha sem ser conjurada, em vez disso, exile-a.\', \'type\': \'Criatura — Tritão Mago\', \'flavor\': \'A hospitalidade não importa muito para os que não querem ser perturbados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449165&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'64f42c2d-ceed-4c33-9680-0785e8710f45\', \'multiverseId\': 449165}, \'multiverseid\': 449165}, {\'name\': \'Призыватель Туманов\', \'text\': \'Пожертвуйте Призывателя Туманов: до конца хода, если не являющееся фишкой существо должно выйти на поле битвы и оно не было разыграно как заклинание, изгоните его вместо этого.\', \'type\': \'Существо — Мерфолк Чародей\', \'flavor\': \'Гостеприимность не заботит тех, кто не желает, чтобы их беспокоили.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449446&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'46a43428-ca34-496d-9f5e-17bf23d748a4\', \'multiverseId\': 449446}, \'multiverseid\': 449446}, {\'name\': \'漫雾师\', \'text\': \'牺牲漫雾师：直到回合结束，如果某非衍生物的生物将进战场，且未有牌手施放之，则改为将它放逐。\', \'type\': \'生物 ～人鱼／法术师\', \'flavor\': \'不愿受扰者从不讲究什么待客之道。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449727&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a873e6ec-2a7e-4150-9d1c-1b40deffbf12\', \'multiverseId\': 449727}, \'multiverseid\': 449727}, {\'name\': \'漫霧師\', \'text\': \'犧牲漫霧師：直到回合結束，如果某非衍生物的生物將進戰場，且未有玩家施放之，則改為將它放逐。\', \'type\': \'生物 ～人魚／魔法師\', \'flavor\': \'不願受擾者從不講究什麼待客之道。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450008&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6d4cb10f-6544-4bc1-8e6c-8c5ac36abd00\', \'multiverseId\': 450008}, \'multiverseid\': 450008}]', '[{\'name\': \'Nebelschleier-Heroldin\', \'text\': \'Die Nebelschleier-Heroldin kann nicht geblockt werden.\', \'type\': \'Kreatur — Meervolk, Krieger\', \'flavor\': \'Voller List führten die Flussherolde einen Kleinkrieg gegen ihre Feinde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450291&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4f1d6304-7dcc-4ab7-affb-d45688e9bdae\', \'multiverseId\': 450291}, \'multiverseid\': 450291}, {\'name\': \'Heraldo capa de niebla\', \'text\': \'La Heraldo capa de niebla no puede ser bloqueada.\', \'type\': \'Criatura — Guerrero tritón\', \'flavor\': \'Con un sigilo incomparable, los Heraldos del Río libraban una batalla continua contra las fuerzas enemigas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450325&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5ec9c979-0a49-496d-bd64-f9e3e35ba5b3\', \'multiverseId\': 450325}, \'multiverseid\': 450325}, {\'name\': "Héraut à l\'habit de brume", \'text\': "Le Héraut à l\'habit de brume ne peut pas être bloqué.", \'type\': \'Créature : ondin et guerrier\', \'flavor\': "Avec une discrétion sans pareille, les Hérauts de l\'onde se livraient à une bataille perpétuelle contre des forces ennemies.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450359&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fd71923d-f07f-4ea2-88b4-7fc8495c9551\', \'multiverseId\': 450359}, \'multiverseid\': 450359}, {\'name\': \'Araldo dal Manto di Bruma\', \'text\': "L\'Araldo dal Manto di Bruma non può essere bloccato.", \'type\': \'Creatura — Guerriero Tritone\', \'flavor\': \'Maestri di furtività, gli Araldi del Fiume combatterono senza sosta contro le forze nemiche.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450393&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'79a54468-a4f4-443f-bd44-191c37267139\', \'multiverseId\': 450393}, \'multiverseid\': 450393}, {\'name\': \'霧まといの川守り\', \'text\': \'霧まといの川守りはブロックされない。\', \'type\': \'クリーチャー — マーフォーク・戦士\', \'flavor\': \'川守りは比類ない隠密性を備えており、敵勢力を相手に長期戦を戦った。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450427&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a142b6fd-d538-4eaf-89ef-144170044d9a\', \'multiverseId\': 450427}, \'multiverseid\': 450427}, {\'name\': \'안개를 두른 전령\', \'text\': \'안개를 두른 전령은 방어될 수 없다.\', \'type\': \'생물 — 인어 전사\', \'flavor\': \'따라올 수 없는 은신술을 이용해, 강 전령들은 세 무리의 적 군세들과 동시에 맞서 싸웠다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450461&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2f44502a-c7c8-4286-acf4-ad5ee4603cc7\', \'multiverseId\': 450461}, \'multiverseid\': 450461}, {\'name\': \'Arauta do Manto de Bruma\', \'text\': \'Arauta do Manto de Bruma não pode ser bloqueada.\', \'type\': \'Criatura — Tritão Guerreiro\', \'flavor\': \'Com furtividade ímpar, os Arautos do Rio travaram uma longa e árdua batalha contra as forças inimigas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450495&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6bbe8ec5-5b67-4e85-9958-9bf172db5967\', \'multiverseId\': 450495}, \'multiverseid\': 450495}, {\'name\': \'Укрытая Туманом Вестница\', \'text\': \'Укрытая Туманом Вестница не может быть заблокирована.\', \'type\': \'Существо — Мерфолк Воин\', \'flavor\': \'Речные Вестники, которым не было равных в искусстве незаметности, вели затяжную войну с врагами.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450529&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'928b090a-a0f8-49e5-9484-3228c1df5cc7\', \'multiverseId\': 450529}, \'multiverseid\': 450529}, {\'name\': \'雾隐传令\', \'text\': \'雾隐传令不能被阻挡。\', \'type\': \'生物 ～人鱼／战士\', \'flavor\': \'川流使凭借无匹匿踪绝技，与敌对势力拉锯对抗。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450563&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0c35b514-85a2-4e8c-a7ff-45676a686436\', \'multiverseId\': 450563}, \'multiverseid\': 450563}, {\'name\': \'霧隱傳令\', \'text\': \'霧隱傳令不能被阻擋。\', \'type\': \'生物 ～人魚／戰士\', \'flavor\': \'川流使憑借無匹匿蹤絕技，與敵對勢力拉鋸對抗。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450597&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e3dc0bfc-04fe-4e2a-b7db-5cad59f9fab8\', \'multiverseId\': 450597}, \'multiverseid\': 450597}]', '[{\'name\': \'Nebelwand\', \'text\': \'Verteidiger (Diese Kreatur kann nicht angreifen.)\', \'type\': \'Kreatur — Mauer\', \'flavor\': \'Der Meeresgrund ist mit den Knochen jener übersät, die es gewagt haben, in den Nebel zu segeln.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447500&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'645d6b71-c272-4f79-968e-9ab0c808639d\', \'multiverseId\': 447500}, \'multiverseid\': 447500}, {\'name\': \'Muro de niebla\', \'text\': \'Defensor. (Esta criatura no puede atacar.)\', \'type\': \'Criatura — Muro\', \'flavor\': \'Los huesos de los locos que se atrevieron a cruzar la niebla yacen ahora en el fondo del mar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447781&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1db18592-14b1-4f22-9304-90787a919047\', \'multiverseId\': 447781}, \'multiverseid\': 447781}, {\'name\': \'Mur de brume\', \'text\': \'Défenseur (Cette créature ne peut pas attaquer).\', \'type\': \'Créature : mur\', \'flavor\': "Les fonds marins sont couverts des ossements des inconscients qui ont osé s\'aventurer dans la brume.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448062&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ebfed765-84df-4f09-a4fc-87f9975e49de\', \'multiverseId\': 448062}, \'multiverseid\': 448062}, {\'name\': \'Muro di Nebbia\', \'text\': \'Difensore (Questa creatura non può attaccare.)\', \'type\': \'Creatura — Muro\', \'flavor\': \'Il fondale è disseminato delle ossa degli stolti che hanno osato avventurarsi nella nebbia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448343&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bbdaa206-330f-46c1-8e4d-276cac3d2904\', \'multiverseId\': 448343}, \'multiverseid\': 448343}, {\'name\': \'霧の壁\', \'text\': \'防衛（このクリーチャーでは攻撃できない。）\', \'type\': \'クリーチャー — 壁\', \'flavor\': \'霧の中へ漕ぎ進むことを望んだ愚か者たちの骨で海底はまだら模様だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448624&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'53862a87-3d5d-4a6d-9810-51527790091a\', \'multiverseId\': 448624}, \'multiverseid\': 448624}, {\'name\': \'안개의 벽\', \'text\': \'수비태세 (이 생물은 공격할 수 없다.)\', \'type\': \'생물 — 벽\', \'flavor\': \'수면에는 겁 없이 안개 속으로 항해해 들어간 어리석은 자들의 뼈가 점점이 떠 있었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448905&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'89ecc987-889a-40ba-b96e-b9e8139c6bf9\', \'multiverseId\': 448905}, \'multiverseid\': 448905}, {\'name\': \'Barreira da Névoa\', \'text\': \'Defensor (Esta criatura não pode atacar.)\', \'type\': \'Criatura — Barreira\', \'flavor\': \'O fundo do oceano é salpicado pelos ossos dos tolos que ousaram navegar no nevoeiro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449186&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b4508d22-f429-4038-bfd4-b10f1b844304\', \'multiverseId\': 449186}, \'multiverseid\': 449186}, {\'name\': \'Стена Тумана\', \'text\': \'Защитник (Это существо не может атаковать.)\', \'type\': \'Существо — Стена\', \'flavor\': \'Морское дно усеяно костями глупцов, посмевших заплыть в туман.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449467&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'48160f34-667b-45fb-985d-236bc54439e8\', \'multiverseId\': 449467}, \'multiverseid\': 449467}, {\'name\': \'迷雾墙\', \'text\': \'守军（此生物不能攻击。）\', \'type\': \'生物 ～墙\', \'flavor\': \'原本敢于深入迷雾的诸位勇士，如今都已化作尸骨散落海底。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449748&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8b57a9f0-f6ba-4add-8825-f17e5b39cb30\', \'multiverseId\': 449748}, \'multiverseid\': 449748}, {\'name\': \'迷霧牆\', \'text\': \'守軍（此生物不能攻擊。）\', \'type\': \'生物 ～牆\', \'flavor\': \'原本敢於深入迷霧的諸位勇士，如今都已化作屍骨散落海底。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450029&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4f2d5431-251f-4cf0-bfb3-a4766daa0f2f\', \'multiverseId\': 450029}, \'multiverseid\': 450029}]', '[{\'name\': \'Neugeborener Vampir\', \'text\': \'{2}, {T}: Jeder Gegner verliert 1 Lebenspunkt und du erhältst 1 Lebenspunkt dazu.\', \'type\': \'Kreatur — Vampir\', \'flavor\': \'Eines Tages werden sie vielleicht zum Inbegriff der tödlichen Eleganz. Im Moment werden sie nur vom Durst beherrscht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447541&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d07704db-4bcc-479e-9a8f-57d0af9851bc\', \'multiverseId\': 447541}, \'multiverseid\': 447541}, {\'name\': \'Vampiro neonato\', \'text\': \'{2}, {T}: Cada oponente pierde 1 vida y tú ganas 1 vida.\', \'type\': \'Criatura — Vampiro\', \'flavor\': \'Un día serán parangones de la elegancia letal. De momento no pueden exhibir nada más que su sed.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447822&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4be289d2-3503-42a7-a27c-3a5a4d248bbe\', \'multiverseId\': 447822}, \'multiverseid\': 447822}, {\'name\': \'Nouveau-né vampire\', \'text\': \'{2}, {T} : Chaque adversaire perd 1 point de vie et vous gagnez 1 point de vie.\', \'type\': \'Créature : vampire\', \'flavor\': "Un jour, ils seront peut-être des modèles d\'élégance meurtrière. À l\'heure actuelle, ils n\'ont rien sinon soif.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448103&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6d942afa-d290-4632-b09b-f365c13cd4c6\', \'multiverseId\': 448103}, \'multiverseid\': 448103}, {\'name\': \'Vampiro Neonato\', \'text\': \'{2}, {T}: Ogni avversario perde 1 punto vita e tu guadagni 1 punto vita.\', \'type\': \'Creatura — Vampiro\', \'flavor\': \'Un giorno, forse, saranno esempi di letale eleganza. Per il momento, non conoscono altro che la sete.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448384&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'630e60d8-52ca-43b8-831c-bd7a7b7cd589\', \'multiverseId\': 448384}, \'multiverseid\': 448384}, {\'name\': \'吸血鬼の新生子\', \'text\': \'{2}, {T}：各対戦相手はそれぞれ１点のライフを失い、あなたは１点のライフを得る。\', \'type\': \'クリーチャー — 吸血鬼\', \'flavor\': \'いつか、彼らは優雅の極致として模範となるだろう。今のところは、彼らには渇きしかない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448665&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0a274edf-fc50-4311-8776-d244fc4a0ba7\', \'multiverseId\': 448665}, \'multiverseid\': 448665}, {\'name\': \'신생 흡혈귀\', \'text\': \'{2}, {T}: 각 상대는 생명 1점을 잃고 당신은 생명 1점을 얻는다.\', \'type\': \'생물 — 흡혈귀\', \'flavor\': \'언젠가는, 그들이 치명적인 아름다움의 귀감이 될 것이다. 지금의 그들에게는, 갈증밖에 없다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448946&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6b498959-bcb9-48bc-a126-7f6d844d1c4e\', \'multiverseId\': 448946}, \'multiverseid\': 448946}, {\'name\': \'Neófito Vampiro\', \'text\': \'{2}, {T}: Cada oponente perde 1 ponto de vida e você ganha 1 ponto de vida.\', \'type\': \'Criatura — Vampiro\', \'flavor\': \'Um dia, poderão ser modelos de elegância mortífera. No momento, não têm nada além de sede.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449227&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1fd3bd41-a562-416a-b0c8-e1b31af194b7\', \'multiverseId\': 449227}, \'multiverseid\': 449227}, {\'name\': \'Новообращенный Вампир\', \'text\': \'{2}, {T}: каждый оппонент теряет 1 жизнь, а вы получаете 1 жизнь.\', \'type\': \'Существо — Вампир\', \'flavor\': \'Настанет день, и они станут образцами смертельной элегантности. Сейчас же у них нет ничего, кроме жажды.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449508&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'eed8a07e-0348-4e6e-af8e-e9b8edd31b87\', \'multiverseId\': 449508}, \'multiverseid\': 449508}, {\'name\': \'吸血稚儿\', \'text\': \'{2}，{T}：每位对手各失去1点生命且你获得1点生命。\', \'type\': \'生物 ～吸血鬼\', \'flavor\': \'或有一天，他们会成为致命与优雅并存的典范。但眼下他们只有饱食之欲。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449789&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e3e540d2-7fc1-47c4-a58b-e5ca55e9632a\', \'multiverseId\': 449789}, \'multiverseid\': 449789}, {\'name\': \'吸血稚兒\', \'text\': \'{2}，{T}：每位對手各失去1點生命且你獲得1點生命。\', \'type\': \'生物 ～吸血鬼\', \'flavor\': \'或有一天，他們會成為致命與優雅並存的典範。但眼下他們只有飽食之欲。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450070&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f73e3e88-f158-46e6-937d-92490f308ce8\', \'multiverseId\': 450070}, \'multiverseid\': 450070}]', '[{\'name\': \'Nexus des Schicksals\', \'text\': \'Du erhältst nach diesem Zug einen zusätzlichen Zug.\\nFalls der Nexus des Schicksals von irgendwoher auf einen Friedhof gelegt würde, zeige ihn offen vor und mische ihn stattdessen in die Bibliothek seines Besitzers.\', \'type\': \'Spontanzauber\', \'flavor\': \'Sarkhan reiste zu einem Grab und in die Vergangenheit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450287&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a8b816a4-a8e7-4fb5-964d-bfd9eb1accf0\', \'multiverseId\': 450287}, \'multiverseid\': 450287}, {\'name\': \'Nexo del destino\', \'text\': \'Juega un turno adicional después de este.\\nSi el Nexo del destino fuera a ir a un cementerio desde cualquier parte, en vez de eso, muestra el Nexo del destino y barájalo en la biblioteca de su propietario.\', \'type\': \'Instantáneo\', \'flavor\': \'Sarkhan se adentró en una tumba y viajó atrás en el tiempo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450321&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ed20aa82-2c84-4b1a-b0ec-91e7c6c1220e\', \'multiverseId\': 450321}, \'multiverseid\': 450321}, {\'name\': \'Nexus du destin\', \'text\': "Jouez un tour supplémentaire après celui-ci.\\nSi le Nexus du destin devait être mis dans un cimetière d\'où qu\'il vienne, révélez le Nexus du destin et mélangez-le dans la bibliothèque de son propriétaire à la place.", \'type\': \'Éphémère\', \'flavor\': \'Sarkhan erra dans un tombeau et dans le passé.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450355&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'27c2da24-f81a-4213-abf5-cee3acc4a234\', \'multiverseId\': 450355}, \'multiverseid\': 450355}, {\'name\': \'Fulcro del Destino\', \'text\': \'Gioca un turno extra dopo questo.\\nSe il Fulcro del Destino sta per essere messo in un cimitero da qualsiasi zona, rivela invece il Fulcro del Destino e rimescolalo nel grimorio del suo proprietario.\', \'type\': \'Istantaneo\', \'flavor\': \'Sarkhan si addentrò in una tomba e viaggiò indietro nel tempo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450389&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d22584b6-8ded-47aa-a59e-3830417bac3b\', \'multiverseId\': 450389}, \'multiverseid\': 450389}, {\'name\': \'運命のきずな\', \'text\': \'このターンに続いて追加の１ターンを行う。\\n運命のきずながいずれかの領域から墓地に置かれるなら、代わりに運命のきずなを公開し、オーナーのライブラリーに加えて切り直す。\', \'type\': \'インスタント\', \'flavor\': \'サルカンは墓へと迷い込み、時をさかのぼった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450423&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3b4665e1-0c14-4af3-9509-1f936e831529\', \'multiverseId\': 450423}, \'multiverseid\': 450423}, {\'name\': \'운명의 결합점\', \'text\': \'이번 턴 후에 추가로 턴을 얻는다.\\n운명의 결합점이 어디서든 무덤에 놓이려 하면, 대신에 운명의 결합점을 공개하고 소유자의 서고에 섞어넣는다.\', \'type\': \'순간마법\', \'flavor\': \'사르칸은 무덤을 방황하며 시간을 거슬러 올랐다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450457&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1611248a-012c-4174-81c9-77adbb198d93\', \'multiverseId\': 450457}, \'multiverseid\': 450457}, {\'name\': \'Nexo do Destino\', \'text\': \'Jogue um turno extra após este.\\nSe Nexo do Destino seria colocado num cemitério vindo de qualquer lugar, em vez disso, revele-o e embaralhe-o no grimório de seu dono.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Sarkhan entrou em uma tumba e viajou rumo ao passado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450491&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'315a87bd-66d4-4c9d-95ba-1492a12652a5\', \'multiverseId\': 450491}, \'multiverseid\': 450491}, {\'name\': \'Нексус Судьбы\', \'text\': \'Сделайте дополнительный ход вслед за этим.\\nЕсли Нексус Судьбы должен попасть откуда-либо на кладбище, покажите Нексус Судьбы и втасуйте его в библиотеку его владельца вместо этого.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Сархан забрел в гробницу и перенесся назад во времени.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450525&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f2b976d5-e844-4899-b6a7-d4f587473631\', \'multiverseId\': 450525}, \'multiverseid\': 450525}, {\'name\': \'龙命连结点\', \'text\': \'于本回合后进行额外的一个回合。\\n如果龙命连结点将从任何区域置入坟墓场，则改为展示龙命连结点，并将它洗入其拥有者的牌库。\', \'type\': \'瞬间\', \'flavor\': \'萨坎步入一处坟墓，然后回到了过去。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450559&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'049021a4-9c7d-4728-9226-f5dd16358b76\', \'multiverseId\': 450559}, \'multiverseid\': 450559}, {\'name\': \'龍命連結點\', \'text\': \'於本回合後進行額外的一個回合。\\n如果龍命連結點將從任何區域置入墳墓場，則改為展示龍命連結點，並將它洗入其擁有者的牌庫。\', \'type\': \'瞬間\', \'flavor\': \'薩坎步入一處墳墓，然後回到了過去。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450593&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'657ae4b7-014f-4f72-8364-cdb62150a76d\', \'multiverseId\': 450593}, \'multiverseid\': 450593}]', '[{\'name\': \'Nicol Bolas, der Zerstörer // Nicol Bolas, der Emporgestiegene\', \'text\': \'+2: Ziehe zwei Karten.\\n−3: Nicol Bolas, der Emporgestiegene, fügt einer Kreatur oder einem Planeswalker deiner Wahl 10 Schadenspunkte zu.\\n−4: Bringe eine Kreaturen- oder Planeswalkerkarte deiner Wahl aus einem Friedhof unter deiner Kontrolle ins Spiel.\\n−12: Schicke alle bis auf die unterste Karte der Bibliothek eines Spielers deiner Wahl ins Exil.\', \'type\': \'Legendärer Planeswalker — Bolas\', \'flavor\': None, \'faceName\': \'Nicol Bolas, der Emporgestiegene\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447635&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'571eff83-d371-496e-9832-559699a3af66\', \'multiverseId\': 447635}, \'multiverseid\': 447635}, {\'name\': \'Nicol Bolas, el Devastador // Nicol Bolas, el Resurgido\', \'text\': \'+2: Roba dos cartas.\\n−3: Nicol Bolas, el Resurgido hace 10 puntos de daño a la criatura o planeswalker objetivo.\\n−4: Pon en el campo de batalla bajo tu control la carta de criatura o planeswalker objetivo de un cementerio.\\n−12: Exilia todas las cartas de la biblioteca del jugador objetivo excepto la última.\', \'type\': \'Planeswalker legendario — Bolas\', \'flavor\': None, \'faceName\': \'Nicol Bolas, el Resurgido\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447916&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d312674e-58c9-4d2e-8dda-1a83eedbdf44\', \'multiverseId\': 447916}, \'multiverseid\': 447916}, {\'name\': \'Nicol Bolas, le dévastateur // Nicol Bolas, le transcendé\', \'text\': "+2 : Piochez deux cartes.\\n-3 : Nicol Bolas, le transcendé inflige 10 blessures à une cible, créature ou planeswalker.\\n-4 : Mettez sur le champ de bataille, sous votre contrôle, une carte de créature ou de planeswalker ciblée depuis un cimetière.\\n-12 : Exilez toutes les cartes de la bibliothèque du joueur ciblé à l\'exception de la carte du dessous.", \'type\': \'Planeswalker légendaire : Bolas\', \'flavor\': None, \'faceName\': \'Nicol Bolas, le transcendé\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448197&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'08cb2718-2ae3-4fc8-9933-2513379fceb8\', \'multiverseId\': 448197}, \'multiverseid\': 448197}, {\'name\': "Nicol Bolas, il Devastatore // Nicol Bolas, l\'Asceso", \'text\': "+2: Pesca due carte.\\n-3: Nicol Bolas, l\'Asceso infligge 10 danni a una creatura o a un planeswalker bersaglio.\\n-4: Metti sul campo di battaglia sotto il tuo controllo una carta creatura o planeswalker bersaglio da un cimitero.\\n-12: Esilia tutte le carte del grimorio di un giocatore bersaglio tranne l\'ultima.", \'type\': \'Planeswalker Leggendario — Bolas\', \'flavor\': None, \'faceName\': "Nicol Bolas, l\'Asceso", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448478&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fbc8453b-85c2-47b2-a68f-a9f37662737a\', \'multiverseId\': 448478}, \'multiverseid\': 448478}, {\'name\': \'破滅の龍、ニコル・ボーラス // 覚醒の龍、ニコル・ボーラス\', \'text\': \'+2：カードを２枚引く。\\n-3：クリーチャー１体かプレインズウォーカー１体を対象とする。覚醒の龍、ニコル・ボーラスはそれに10点のダメージを与える。\\n-4：墓地からクリーチャーかプレインズウォーカーであるカード１枚を対象とし、それをあなたのコントロール下で戦場に出す。\\n-12：プレイヤー１人を対象とし、そのプレイヤーのライブラリーの一番下以外のカードをすべて追放する。\', \'type\': \'伝説のプレインズウォーカー — ボーラス\', \'flavor\': None, \'faceName\': \'覚醒の龍、ニコル・ボーラス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448759&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3faea98d-5e8e-476d-811c-b1ef024c172d\', \'multiverseId\': 448759}, \'multiverseid\': 448759}, {\'name\': \'유린자, 니콜 볼라스 // 부활자, 니콜 볼라스\', \'text\': \'+2: 카드 두 장을 뽑는다.\\n−3: 생물이나 플레인즈워커를 목표로 정한다. 부활자, 니콜 볼라스는 그 목표에게 피해 10점을 입힌다.\\n−4: 무덤에 있는 생물 또는 플레인즈워커 카드를 목표로 정한다. 그 카드를 당신의 조종하에 전장에 놓는다.\\n−12: 플레이어를 목표로 정한다. 그 플레이어의 서고에서 맨 밑 카드 한 장을 제외한 모든 카드를 추방한다.\', \'type\': \'전설적 플레인즈워커 — 볼라스\', \'flavor\': None, \'faceName\': \'부활자, 니콜 볼라스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449040&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'211f7ddc-9cdd-421c-afdc-00e4f99eeee1\', \'multiverseId\': 449040}, \'multiverseid\': 449040}, {\'name\': \'Nicol Bolas, o Devastador // Nicol Bolas, o Erguido\', \'text\': \'+2: Compre dois cards.\\n−3: Nicol Bolas, o Erguido, causa 10 pontos de dano à criatura ou ao planeswalker alvo.\\n−4: Coloque o card de criatura ou planeswalker alvo de um cemitério no campo de batalha sob o seu controle.\\n−12: Exile todos os cards exceto o último do grimório do jogador alvo.\', \'type\': \'Planeswalker Lendário — Nicol Bolas\', \'flavor\': None, \'faceName\': \'Nicol Bolas, o Erguido\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449321&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d87e1196-9663-40d8-8d07-2727f85c9081\', \'multiverseId\': 449321}, \'multiverseid\': 449321}, {\'name\': \'Никол Болас, Опустошитель // Никол Болас, Возвысившийся\', \'text\': \'+2: возьмите две карты.\\n−3: Никол Болас, Возвысившийся наносит 10 повреждений целевому существу или planeswalker-у.\\n−4: положите целевую карту существа или planeswalker-а из кладбища на поле битвы под вашим контролем.\\n—12: изгоните все карты из библиотеки целевого игрока, кроме нижней.\', \'type\': \'Легендарный Planeswalker — Болас\', \'flavor\': None, \'faceName\': \'Никол Болас, Возвысившийся\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449602&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'84009f20-5010-4aae-b363-91565efb8c3f\', \'multiverseId\': 449602}, \'multiverseid\': 449602}, {\'name\': \'烈龙尼可波拉斯 // 飞升尼可波拉斯\', \'text\': \'+2：抓两张牌。\\n−3：飞升尼可波拉斯对目标生物或鹏洛客造成10点伤害。\\n−4：将目标生物或鹏洛客牌在你的操控下从坟墓场放进战场。\\n−12：放逐目标牌手牌库中除了最后一张以外的所有牌。\', \'type\': \'传奇鹏洛客 ～波拉斯\', \'flavor\': None, \'faceName\': \'飞升尼可波拉斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449883&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0e13fb45-8dff-4457-ba60-ea7333ed782d\', \'multiverseId\': 449883}, \'multiverseid\': 449883}, {\'name\': \'烈龍尼可波拉斯 // 飛昇尼可波拉斯\', \'text\': \'+2：抽兩張牌。\\n−3：飛昇尼可波拉斯對目標生物或鵬洛客造成10點傷害。\\n−4：將目標生物或鵬洛客牌在你的操控下從墳墓場放進戰場。\\n−12：放逐目標玩家牌庫中除了最後一張以外的所有牌。\', \'type\': \'傳奇鵬洛客 ～波拉斯\', \'flavor\': None, \'faceName\': \'飛昇尼可波拉斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450164&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'49c27422-cc00-4ee0-ba86-84a617b3dc85\', \'multiverseId\': 450164}, \'multiverseid\': 450164}]', '[{\'name\': \'Nicol Bolas, der Zerstörer // Nicol Bolas, der Emporgestiegene\', \'text\': \'Fliegend\\nWenn Nicol Bolas, der Zerstörer, ins Spiel kommt, wirft jeder Gegner eine Karte ab.\\n{4}{U}{B}{R}: Schicke Nicol Bolas, den Zerstörer, ins Exil und bringe ihn dann transformiert unter der Kontrolle seines Besitzers ins Spiel zurück. Aktiviere diese Fähigkeit nur zu einem Zeitpunkt, zu dem du auch eine Hexerei wirken könntest.\', \'type\': \'Legendäre Kreatur — Ältester, Drache\', \'flavor\': None, \'faceName\': \'Nicol Bolas, der Zerstörer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447635&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'571eff83-d371-496e-9832-559699a3af66\', \'multiverseId\': 447635}, \'multiverseid\': 447635}, {\'name\': \'Nicol Bolas, el Devastador // Nicol Bolas, el Resurgido\', \'text\': \'Vuela.\\nCuando Nicol Bolas, el Devastador entre al campo de batalla, cada oponente descarta una carta.\\n{4}{U}{B}{R}: Exilia a Nicol Bolas, el Devastador. Luego regrésalo al campo de batalla transformado bajo el control de su propietario. Activa esta habilidad solo cuando puedas lanzar un conjuro.\', \'type\': \'Criatura legendaria — Dragón anciano\', \'flavor\': None, \'faceName\': \'Nicol Bolas, el Devastador\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447916&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d312674e-58c9-4d2e-8dda-1a83eedbdf44\', \'multiverseId\': 447916}, \'multiverseid\': 447916}, {\'name\': \'Nicol Bolas, le dévastateur // Nicol Bolas, le transcendé\', \'text\': "Vol\\nQuand Nicol Bolas, le dévastateur arrive sur le champ de bataille, chaque adversaire se défausse d\'une carte.\\n{4}{U}{B}{R} : Exilez Nicol Bolas, le dévastateur, puis renvoyez-le sur le champ de bataille, transformé, sous le contrôle de son propriétaire. N\'activez cette capacité que lorsque vous pourriez lancer un rituel.", \'type\': \'Créature légendaire : ancêtre et dragon\', \'flavor\': None, \'faceName\': \'Nicol Bolas, le dévastateur\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448197&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'08cb2718-2ae3-4fc8-9933-2513379fceb8\', \'multiverseId\': 448197}, \'multiverseid\': 448197}, {\'name\': "Nicol Bolas, il Devastatore // Nicol Bolas, l\'Asceso", \'text\': \'Volare\\nQuando Nicol Bolas, il Devastatore entra nel campo di battaglia, ogni avversario scarta una carta.\\n{4}{U}{B}{R}: Esilia Nicol Bolas, il Devastatore, poi rimettilo sul campo di battaglia trasformato sotto il controllo del suo proprietario. Attiva questa abilità solo quando potresti lanciare una stregoneria.\', \'type\': \'Creatura Leggendaria — Antico Drago\', \'flavor\': None, \'faceName\': \'Nicol Bolas, il Devastatore\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448478&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fbc8453b-85c2-47b2-a68f-a9f37662737a\', \'multiverseId\': 448478}, \'multiverseid\': 448478}, {\'name\': \'破滅の龍、ニコル・ボーラス // 覚醒の龍、ニコル・ボーラス\', \'text\': \'飛行\\n破滅の龍、ニコル・ボーラスが戦場に出たとき、各対戦相手はそれぞれカード１枚を捨てる。\\n{4}{U}{B}{R}：破滅の龍、ニコル・ボーラスを追放し、その後、これを変身させた状態でオーナーのコントロール下で戦場に戻す。この能力は、あなたがソーサリーを唱えられるときにのみ起動できる。\', \'type\': \'伝説のクリーチャー — エルダー・ドラゴン\', \'flavor\': None, \'faceName\': \'破滅の龍、ニコル・ボーラス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448759&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3faea98d-5e8e-476d-811c-b1ef024c172d\', \'multiverseId\': 448759}, \'multiverseid\': 448759}, {\'name\': \'유린자, 니콜 볼라스 // 부활자, 니콜 볼라스\', \'text\': \'비행\\n유린자, 니콜 볼라스가 전장에 들어올 때, 각 상대는 카드 한 장을 버린다.\\n{4}{U}{B}{R}: 유린자, 니콜 볼라스를 추방한 후, 소유자의 조종하에 변신된 상태로 전장으로 되돌린다. 당신이 집중마법을 발동할 수 있는 시기에만 이 능력을 활성화할 수 있다.\', \'type\': \'전설적 생물 — 장로 용\', \'flavor\': None, \'faceName\': \'유린자, 니콜 볼라스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449040&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'211f7ddc-9cdd-421c-afdc-00e4f99eeee1\', \'multiverseId\': 449040}, \'multiverseid\': 449040}, {\'name\': \'Nicol Bolas, o Devastador // Nicol Bolas, o Erguido\', \'text\': \'Voar\\nQuando Nicol Bolas, o Devastador, entra no campo de batalha, cada oponente descarta um card.\\n{4}{U}{B}{R}: Exile Nicol Bolas, o Devastador, e depois devolva-o ao campo de batalha transformado sob o controle de seu dono. Ative esta habilidade somente nos momentos em que poderia conjurar um feitiço.\', \'type\': \'Criatura Lendária — Dragão Ancião\', \'flavor\': None, \'faceName\': \'Nicol Bolas, o Devastador\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449321&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d87e1196-9663-40d8-8d07-2727f85c9081\', \'multiverseId\': 449321}, \'multiverseid\': 449321}, {\'name\': \'Никол Болас, Опустошитель // Никол Болас, Возвысившийся\', \'text\': \'Полет\\nКогда Никол Болас, Опустошитель выходит на поле битвы, каждый оппонент сбрасывает карту.\\n{4}{U}{B}{R}: изгоните Никола Боласа, Опустошителя, затем верните его на поле битвы трансформированным под контролем его владельца. Активируйте эту способность только при возможности разыгрывать волшебство.\', \'type\': \'Легендарное Существо — Старейшина Дракон\', \'flavor\': None, \'faceName\': \'Никол Болас, Опустошитель\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449602&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'84009f20-5010-4aae-b363-91565efb8c3f\', \'multiverseId\': 449602}, \'multiverseid\': 449602}, {\'name\': \'烈龙尼可波拉斯 // 飞升尼可波拉斯\', \'text\': \'飞行\\n当烈龙尼可波拉斯进战场时，每位对手各弃一张牌。\\n{4}{U}{B}{R}：放逐烈龙尼可波拉斯，然后将他在其拥有者的操控下移回战场且已转化。只可以于你能施放法术的时机下起动此异能。\', \'type\': \'传奇生物 ～长老／龙\', \'flavor\': None, \'faceName\': \'烈龙尼可波拉斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449883&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0e13fb45-8dff-4457-ba60-ea7333ed782d\', \'multiverseId\': 449883}, \'multiverseid\': 449883}, {\'name\': \'烈龍尼可波拉斯 // 飛昇尼可波拉斯\', \'text\': \'飛行\\n當烈龍尼可波拉斯進戰場時，每位對手各棄一張牌。\\n{4}{U}{B}{R}：放逐烈龍尼可波拉斯，然後將他在其擁有者的操控下移回戰場且已轉化。只可以於你能施放巫術的時機下起動此異能。\', \'type\': \'傳奇生物 ～長老／龍\', \'flavor\': None, \'faceName\': \'烈龍尼可波拉斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450164&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'49c27422-cc00-4ee0-ba86-84a617b3dc85\', \'multiverseId\': 450164}, \'multiverseid\': 450164}]', '[{\'name\': \'Omenverheißerin\', \'text\': \'Wenn die Omenverheißerin ins Spiel kommt, wende Hellsicht 2 an. (Schaue dir die obersten zwei Karten deiner Bibliothek an. Du kannst eine beliebige Anzahl davon unter deine Bibliothek legen und den Rest in beliebiger Reihenfolge oben darauf.)\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'Ihre Prophezeiungen erstaunen sie noch, während sie sie verkündet.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447481&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'81163817-5e5d-4b3b-b6d9-777c99780da5\', \'multiverseId\': 447481}, \'multiverseid\': 447481}, {\'name\': \'Presagiadora\', \'text\': \'Cuando la Presagiadora entre al campo de batalla, adivina 2. (Mira las dos primeras cartas de tu biblioteca, luego pon cualquier cantidad de ellas en el fondo de tu biblioteca y el resto en la parte superior en cualquier orden.)\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'Sus profecías la asombran a medida que las enuncia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447762&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'835196dc-8bc6-485a-99ed-f2411be67bf6\', \'multiverseId\': 447762}, \'multiverseid\': 447762}, {\'name\': \'Sibylle\', \'text\': "Quand la Sibylle arrive sur le champ de bataille, regard 2. (Regardez les deux cartes du dessus de votre bibliothèque. Mettez n\'importe quel nombre d\'entre elles au-dessous de votre bibliothèque et le reste, au-dessus, dans n\'importe quel ordre.)", \'type\': \'Créature : humain et sorcier\', \'flavor\': "Ses prophéties l\'ébahissent au moment même où elle les énonce.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448043&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'92e09bfe-2875-46ae-b8e5-31a748e3daa4\', \'multiverseId\': 448043}, \'multiverseid\': 448043}, {\'name\': \'Sibilla\', \'text\': \'Quando la Sibilla entra nel campo di battaglia, profetizza 2. (Guarda le prime due carte del tuo grimorio, poi mettine un qualsiasi numero in fondo al tuo grimorio e le altre in cima in qualsiasi ordine.)\', \'type\': \'Creatura — Mago Umano\', \'flavor\': "Le sue profezie la sorprendono nell\'istante in cui le pronuncia.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448324&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1587c56a-eff5-4158-9675-2fe721d84b2d\', \'multiverseId\': 448324}, \'multiverseid\': 448324}, {\'name\': \'前兆語り\', \'text\': \'前兆語りが戦場に出たとき、占術２を行う。（あなたのライブラリーの一番上からカードを２枚見て、そのうちの望む枚数を望む順番であなたのライブラリーの一番下に、残りを望む順番で一番上に置く。）\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'彼女が発する予言の内容は、彼女自身さえも驚かせる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448605&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'38f03d3e-74ca-4eb1-ba85-31f3e4e593fc\', \'multiverseId\': 448605}, \'multiverseid\': 448605}, {\'name\': \'흉조의 예언자\', \'text\': \'흉조의 예언자가 전장에 들어올 때, 점술 2를 한다. (당신의 서고 맨 위 카드 두 장을 본다. 당신은 그 카드들 중 원하는 만큼을 당신의 서고 맨 밑에 놓고 나머지를 당신의 서고 맨 위에 원하는 순서대로 놓을 수 있다.)\', \'type\': \'생물 — 인간 마법사\', \'flavor\': \'그녀도 자신의 입에서 나오는 예언을 듣고 놀랐다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448886&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'45dd1e51-41a8-4461-9559-0a3e849051c6\', \'multiverseId\': 448886}, \'multiverseid\': 448886}, {\'name\': \'Sibila\', \'text\': \'Quando Sibila entrar no campo de batalha, use vidência 2. (Olhe os dois cards do topo do seu grimório. Depois, coloque qualquer número deles no fundo do seu grimório e o resto no topo em qualquer ordem.)\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'Suas profecias a assombram mesmo enquanto ela as profere.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449167&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bcf18d59-e282-4fca-a625-894c4c96d70e\', \'multiverseId\': 449167}, \'multiverseid\': 449167}, {\'name\': \'Вещунья\', \'text\': \'Когда Вещунья выходит на поле битвы, предскажите 2. (Посмотрите две верхние карты вашей библиотеки, затем положите любое количество из них в низ вашей библиотеки, а остальные на верх вашей библиотеки в любом порядке.)\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'Ее пророчества изумляют ее саму даже тогда, когда она их произносит.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449448&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b7612fb6-3a6f-492e-a30a-8422809a7708\', \'multiverseId\': 449448}, \'multiverseid\': 449448}, {\'name\': \'示兆先知\', \'text\': \'当示兆先知进战场时，占卜2。（检视你牌库顶的两张牌，然后将其中任意数量的牌以任意顺序置于你牌库底，其余则以任意顺序置于你牌库顶。）\', \'type\': \'生物 ～人类／法术师\', \'flavor\': \'当她说出那些预言时连自己也大吃一惊。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449729&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'91418a11-4b2f-41df-a80a-03d8128584e3\', \'multiverseId\': 449729}, \'multiverseid\': 449729}, {\'name\': \'示兆先知\', \'text\': \'當示兆先知進戰場時，占卜2。（檢視你牌庫頂的兩張牌，然後將其中任意數量的牌以任意順序置於你牌庫底，其餘則以任意順序置於你牌庫頂。）\', \'type\': \'生物 ～人類／魔法師\', \'flavor\': \'當她說出那些預言時連自己也大吃一驚。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450010&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'cada3381-df22-4cd5-889f-57d63d0eef75\', \'multiverseId\': 450010}, \'multiverseid\': 450010}]', '[{\'name\': \'Onakke-Oger\', \'type\': \'Kreatur — Oger, Krieger\', \'flavor\': \'Die Onakke haben mit anderen Ogern nichts gemein. Sie sind sowohl intelligent als auch geschäftig und setzen ihre rohe Kraft ohne Brutalität ein.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447570&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b8c82a58-5332-492d-a1cd-c7dc407281ec\', \'multiverseId\': 447570}, \'multiverseid\': 447570}, {\'name\': \'Ogro onakke\', \'type\': \'Criatura — Guerrero ogro\', \'flavor\': \'Los ogros que conoces no se parecen en nada a los Onakke. Estos tenían inteligencia y capacidad de elaboración; poseían fuerza bruta, pero no eran brutos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447851&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1b970c98-5d42-4d75-bfbe-ac6ed3378d2a\', \'multiverseId\': 447851}, \'multiverseid\': 447851}, {\'name\': \'Ogre onakke\', \'type\': \'Créature : ogre et guerrier\', \'flavor\': "Les ogres communs n\'ont rien à voir avec les Onakke. Intelligents et travailleurs, ces derniers possèdent une force brute sans être des brutes eux-mêmes.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448132&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'acb89071-9577-466c-9ef8-5359b7125cd4\', \'multiverseId\': 448132}, \'multiverseid\': 448132}, {\'name\': \'Ogre degli Onakke\', \'type\': \'Creatura — Guerriero Ogre\', \'flavor\': \'Gli ogre che conosciamo non hanno niente a che vedere con gli Onakke. Intelligenti e operosi, erano dotati di forza bruta, ma non per questo brutali.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448413&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fb399be6-52fa-4007-8341-432427ced5e2\', \'multiverseId\': 448413}, \'multiverseid\': 448413}, {\'name\': \'オナッケのオーガ\', \'type\': \'クリーチャー — オーガ・戦士\', \'flavor\': \'君の知るオーガはオナッケとは別物だ。知性と技術の両方を持ち、暴れずとも甚大な力を持っていた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448694&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'924bc180-2569-41cb-b622-7f374c491600\', \'multiverseId\': 448694}, \'multiverseid\': 448694}, {\'name\': \'오낙케 오우거\', \'type\': \'생물 — 오우거 전사\', \'flavor\': \'오낙케는 당신이 아는 오우거와 전혀 다르다. 지성과 근면성을 겸비한 그들은, 짐승같은 힘을 가졌지만 야만적이지 않았다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448975&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ce83f1fb-13db-4d48-a72c-369dc7c34489\', \'multiverseId\': 448975}, \'multiverseid\': 448975}, {\'name\': \'Ogro Onakke\', \'type\': \'Criatura — Ogro Guerreiro\', \'flavor\': \'Os ogros que você conhece não são como os Onakke. Inteligentes e engenhosos, eles tinham força bruta sem serem brutos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449256&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7e6194e1-afb5-49ae-9734-008f58cfe375\', \'multiverseId\': 449256}, \'multiverseid\': 449256}, {\'name\': \'Огр Онакке\', \'type\': \'Существо — Огр Воин\', \'flavor\': \'Онакке не похожи на обычных огров. Они обладают и острым умом, и упрямой мощью; в них есть грубая сила, но нет тупой грубости.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449537&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'59c8479d-e005-44a6-b13a-918f750f6151\', \'multiverseId\': 449537}, \'multiverseid\': 449537}, {\'name\': \'欧纳克食人魔\', \'type\': \'生物 ～食人魔／战士\', \'flavor\': \'欧纳克一族和你所知的食人魔完全不同。他们聪明又勤奋，身怀蛮力却不粗蛮。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449818&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6b23d9f2-faeb-44b6-a729-828886328807\', \'multiverseId\': 449818}, \'multiverseid\': 449818}, {\'name\': \'歐納克食人魔\', \'type\': \'生物 ～食人魔／戰士\', \'flavor\': \'歐納克一族和你所知的食人魔完全不同。他們聰明又勤奮，身懷蠻力卻不粗蠻。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450099&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3048babc-6549-4914-b916-d1c2c99c9699\', \'multiverseId\': 450099}, \'multiverseid\': 450099}]', '[{\'name\': \'Orakel der Dunkelheit\', \'text\': \'{1}, opfere eine Kreatur: Schicke die oberste Karte deiner Bibliothek ins Exil. Du kannst die Karte in diesem Zug spielen. (Du bezahlst immer noch ihre Kosten. Du kannst auf diese Weise nur dann ein Land spielen, falls du in diesem Zug noch eines spielen darfst.)\', \'type\': \'Kreatur — Goblin, Schamane\', \'flavor\': \'Man braucht keine Augen, um die Zukunft zu sehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447551&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bc69d5a8-5a9c-47a4-b9fe-b87293fb8a23\', \'multiverseId\': 447551}, \'multiverseid\': 447551}, {\'name\': \'Oráculo de habitasombras\', \'text\': \'{1}, sacrificar una criatura: Exilia la primera carta de tu biblioteca. Puedes jugar esa carta este turno. (Sigues pagando sus costes. Puedes jugar una tierra de esta manera solo si te queda una jugada de tierra disponible.)\', \'type\': \'Criatura — Chamán trasgo\', \'flavor\': \'Los ojos no son necesarios para ver el futuro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447832&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'13eb8cc2-7aa8-47b5-ac74-e7d99146aa4b\', \'multiverseId\': 447832}, \'multiverseid\': 447832}, {\'name\': \'Oracle sciaphile\', \'text\': "{1}, sacrifiez une créature : Exilez la carte du dessus de votre bibliothèque. Vous pouvez jouer cette carte ce tour-ci. (Vous payez toujours ses coûts. Vous ne pouvez jouer un terrain de cette manière que s\'il vous reste une mise en jeu de terrain disponible.)", \'type\': \'Créature : gobelin et shamane\', \'flavor\': "Inutile d\'avoir des yeux pour voir l\'avenir.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448113&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b28f24d7-2869-44fb-a526-eab888bacc52\', \'multiverseId\': 448113}, \'multiverseid\': 448113}, {\'name\': "Oracolo Abitante dell\'Oscurità", \'text\': \'{1}, Sacrifica una creatura: Esilia la prima carta del tuo grimorio. Puoi giocare quella carta in questo turno. (Paghi comunque i suoi costi. Puoi giocare una terra in questo modo solo se potresti giocarne una normalmente.)\', \'type\': \'Creatura — Sciamano Goblin\', \'flavor\': \'Non servono gli occhi per vedere il futuro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448394&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d6a42054-d97b-43cc-8dae-60a92d751584\', \'multiverseId\': 448394}, \'multiverseid\': 448394}, {\'name\': \'闇住まいの神託者\', \'text\': \'{1}, クリーチャー１体を生け贄に捧げる：あなたのライブラリーの一番上のカードを追放する。このターン、あなたはそのカードをプレイしてもよい。（そのコストは支払う必要がある。これにより土地をプレイするには、あなたは土地プレイを残している必要がある。）\', \'type\': \'クリーチャー — ゴブリン・シャーマン\', \'flavor\': \'未来を見るのに目は必要ない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448675&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f25d5dd5-6fb6-4885-9010-7f99e9bf3574\', \'multiverseId\': 448675}, \'multiverseid\': 448675}, {\'name\': \'어둠의 거주자 예언자\', \'text\': \'{1}, 생물 한 개를 희생한다: 당신의 서고 맨 위 카드를 추방한다. 당신은 이 턴에 그 카드를 플레이할 수 있다. (여전히 발동 비용은 지불해야 한다. 당신은 대지 플레이 회수가 남아 있는 경우에만 이런 식으로 대지를 플레이할 수 있다.)\', \'type\': \'생물 — 고블린 주술사\', \'flavor\': \'미래를 보는 데에는 눈이 필요하지 않다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448956&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d95fa62c-c506-49a9-b99b-df53d219bf8a\', \'multiverseId\': 448956}, \'multiverseid\': 448956}, {\'name\': \'Oráculo Habitante do Escuro\', \'text\': \'{1}, sacrifique uma criatura: Exile o card do topo de seu grimório. Você pode jogar aquele card neste turno. (Você ainda paga seus custos. Você só pode jogar um terreno desta forma se ainda puder jogar um terreno.)\', \'type\': \'Criatura — Goblin Xamã\', \'flavor\': \'Não é preciso olhos para ver o futuro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449237&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'38f13c0d-891e-4b7a-b048-2939d6bf0c65\', \'multiverseId\': 449237}, \'multiverseid\': 449237}, {\'name\': \'Оракул, Обитатель Тьмы\', \'text\': \'{1}, пожертвуйте существо: изгоните верхнюю карту вашей библиотеки. Вы можете разыграть ту карту в этом ходу. (Вы должны оплатить ее стоимости. Вы можете разыграть таким образом землю, только если у вас осталась возможность разыгрывания земли в этом ходу.)\', \'type\': \'Существо — Гоблин Шаман\', \'flavor\': \'Чтобы заглянуть в будущее, не обязательно иметь глаза.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449518&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'986f7b2d-48eb-46db-a72e-70d3319a7d83\', \'multiverseId\': 449518}, \'multiverseid\': 449518}, {\'name\': \'暗栖先知\', \'text\': \'{1}，牺牲一个生物：放逐你的牌库顶牌。本回合中，你可以使用该牌。（你依旧要支付其费用。你只能于你仍有可使用地数的时候，才能以此法使用地。）\', \'type\': \'生物 ～鬼怪／祭师\', \'flavor\': \'预见未来不需用眼。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449799&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b2684123-9ce8-4c92-a7da-b7cf7670a431\', \'multiverseId\': 449799}, \'multiverseid\': 449799}, {\'name\': \'暗棲先知\', \'text\': \'{1}，犧牲一個生物：放逐你的牌庫頂牌。本回合中，你可以使用該牌。（你依舊要支付其費用。你只能於你仍有可使用地數的時候，才能以此法使用地。）\', \'type\': \'生物 ～鬼怪／祭師\', \'flavor\': \'預見未來不需用眼。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450080&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'86141e4d-a922-41b4-847e-5c2357d00d68\', \'multiverseId\': 450080}, \'multiverseid\': 450080}]', '[{\'name\': \'Oreskos-Scharfkralle\', \'type\': \'Kreatur — Katze, Krieger\', \'flavor\': \'Die Leoniden von Oreskos greifen schnell zu den Waffen, aber nicht etwa, da sie leicht reizbar wären, sondern da sie es genießen, in den Kampf zu ziehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447448&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0a92d258-f938-4c97-9d3e-cf77dd2a937b\', \'multiverseId\': 447448}, \'multiverseid\': 447448}, {\'name\': \'Garraveloz de Oreskos\', \'type\': \'Criatura — Guerrero felino\', \'flavor\': \'No cuesta mucho ofender a los leoninos de Oreskos, no porque sean susceptibles, sino porque siempre están preparados para luchar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447729&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e6d8a0b3-2855-43b3-a441-011a2733e4f9\', \'multiverseId\': 447729}, \'multiverseid\': 447729}, {\'name\': "Lestegriffe d\'Oreskos", \'type\': \'Créature : chat et guerrier\', \'flavor\': "Les léonins d\'Oreskos prennent rapidement ombrage, non pas parce qu\'ils sont susceptibles, mais parce qu\'ils sont toujours prêts à se battre.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448010&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'18d118cb-18e6-42d3-9742-d4882144e438\', \'multiverseId\': 448010}, \'multiverseid\': 448010}, {\'name\': \'Artiglio Rapido di Oreskos\', \'type\': \'Creatura — Guerriero Felino\', \'flavor\': "I leonid di Oreskos sono facili all\'offesa non perché suscettibili, ma perché sempre pronti a combattere.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448291&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fc72774c-e5b6-4b20-af74-388bc488e00f\', \'multiverseId\': 448291}, \'multiverseid\': 448291}, {\'name\': \'オレスコスの速爪\', \'type\': \'クリーチャー — 猫・戦士\', \'flavor\': \'オレスコスのレオニンたちが些細なことで怒るのは気難しいからではなく、常に喧嘩をする準備ができているからだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448572&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'60e6c297-187e-4084-bfaf-cdb9e7db6642\', \'multiverseId\': 448572}, \'multiverseid\': 448572}, {\'name\': \'빠른발톱 오레스코스\', \'type\': \'생물 — 고양이 전사\', \'flavor\': \'오레스코스의 레오닌들은 화를 잘 낸다—예민해서가 아니라, 언제든 전투할 준비가 되어 있기 때문이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448853&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'977cec7f-4880-4d40-951c-e3c9a5d7ebbd\', \'multiverseId\': 448853}, \'multiverseid\': 448853}, {\'name\': \'Garra-veloz de Oreskos\', \'type\': \'Criatura — Felino Guerreiro\', \'flavor\': \'Os leoninos de Oreskos se ofendem facilmente — não por serem sensíveis demais, mas por estarem sempre prontos para uma briga.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449134&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6d7be8bb-c6be-4364-aaf2-07c2373ab1ab\', \'multiverseId\': 449134}, \'multiverseid\': 449134}, {\'name\': \'Быстрый Коготь из Ореска\', \'type\': \'Существо — Кошка Воин\', \'flavor\': \'Леонинцев из Ореска очень легко оскорбить — не потому, что они такие чувствительные, а потому, что они всегда готовы подраться.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449415&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c3c76c3c-a26e-420f-8d06-7cb8d1259bfa\', \'multiverseId\': 449415}, \'multiverseid\': 449415}, {\'name\': \'俄瑞恣迅爪兵\', \'type\': \'生物 ～猫／战士\', \'flavor\': \'俄瑞恣狮族的性情火爆并不是因为敏感易怒，而是因为天性好战。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449696&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'25d6d09a-68c5-4b60-8602-eb1774411f54\', \'multiverseId\': 449696}, \'multiverseid\': 449696}, {\'name\': \'俄瑞恣迅爪兵\', \'type\': \'生物 ～貓／戰士\', \'flavor\': \'俄瑞恣獅族的性情火爆並不是因為敏感易怒，而是因為天性好戰。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449977&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'037f8b60-5cce-44f6-ae8e-18f7965abf9f\', \'multiverseId\': 449977}, \'multiverseid\': 449977}]', '[{\'name\': \'Ortungsturm\', \'text\': \'{T}: Erzeuge {C}.\\n{1}, {T}: Bis zum Ende des Zuges können deine Gegner und Kreaturen mit Fluchsicherheit, die deine Gegner kontrollieren, das Ziel von Zaubersprüchen und Fähigkeiten sein, die du kontrollierst, als ob sie keine Fluchsicherheit hätten.\', \'type\': \'Land\', \'flavor\': \'Sein Licht enttarnt Feinde und legt Geheimnisse offen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447667&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'aec45066-9d20-49bc-a65d-0ee8d798a601\', \'multiverseId\': 447667}, \'multiverseid\': 447667}, {\'name\': \'Torre de detección\', \'text\': \'{T}: Agrega {C}.\\n{1}, {T}: Hasta el final del turno, tus oponentes y las criaturas que controlan tus oponentes con antimaleficio pueden ser objetivo de hechizos y habilidades que controlas como si no tuvieran la habilidad de antimaleficio.\', \'type\': \'Tierra\', \'flavor\': \'Su luz delata a los enemigos y expone los secretos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447948&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7ebf53a9-fb38-47c5-80c1-a0fb89cc9e60\', \'multiverseId\': 447948}, \'multiverseid\': 447948}, {\'name\': \'Tour de détection\', \'text\': "{T} : Ajoutez {C}.\\n{1}, {T} : Jusqu\'à la fin du tour, vos adversaires avec la défense talismanique et les créatures avec la défense talismanique que vos adversaires contrôlent peuvent être la cible de sorts et de capacités que vous contrôlez comme s\'ils n\'avaient pas la défense talismanique.", \'type\': \'Terrain\', \'flavor\': \'Sa lumière expose les ennemis et dévoile les secrets.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448229&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'374d233c-592f-404a-be3f-167301d9b2b0\', \'multiverseId\': 448229}, \'multiverseid\': 448229}, {\'name\': \'Torre di Avvistamento\', \'text\': \'{T}: Aggiungi {C}.\\n{1}, {T}: Fino alla fine del turno, i tuoi avversari e le creature con anti-malocchio controllate dai tuoi avversari possono essere bersaglio di magie e abilità che controlli come se non avessero anti-malocchio.\', \'type\': \'Terra\', \'flavor\': \'La sua luce espone i nemici e mette a nudo i segreti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448510&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2272db09-7ce8-4270-bca1-d50da83efcd1\', \'multiverseId\': 448510}, \'multiverseid\': 448510}, {\'name\': \'探知の塔\', \'text\': \'{T}：{C}を加える。\\n{1}, {T}：ターン終了時まで、呪禁を持つ対戦相手と、対戦相手がコントロールしていて呪禁を持つクリーチャーは、それらが呪禁を持っていないかのように、あなたがコントロールしている呪文や能力の対象にできる。\', \'type\': \'土地\', \'flavor\': \'その光は敵を晒し秘密を暴く。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448791&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'20174847-8754-4966-83a8-0563c68c678e\', \'multiverseId\': 448791}, \'multiverseid\': 448791}, {\'name\': \'탐지탑\', \'text\': \'{T}: {C}를 추가한다.\\n{1}, {T}: 턴종료까지, 방호를 가진 당신의 상대들과 상대들이 조종하는 방호를 가진 생물들은 방호가 없는 것처럼 당신의 주문이나 능력의 목표로 정해질 수 있다.\', \'type\': \'대지\', \'flavor\': \'탑의 빛은 적들을 드러내고 비밀을 발가벗긴다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449072&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'810122f3-a660-4236-8080-b398a674666a\', \'multiverseId\': 449072}, \'multiverseid\': 449072}, {\'name\': \'Torre de Detecção\', \'text\': \'{T}: Adicione {C}.\\n{1}, {T}: Até o final do turno, seus oponentes e as criaturas que seus oponentes controlam com resistência a magia podem ser alvo de mágicas e habilidades que você controla como se não tivessem resistência a magia.\', \'type\': \'Terreno\', \'flavor\': \'Sua luz expõe os inimigos e revela segredos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449353&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'963460ff-a717-4030-aa8f-e5b3253f21ef\', \'multiverseId\': 449353}, \'multiverseid\': 449353}, {\'name\': \'Башня Обнаружения\', \'text\': \'{T}: добавьте {C}.\\n{1}, {T}: до конца хода ваши оппоненты и существа под контролем ваших оппонентов с Порчеустойчивостью могут быть целями заклинаний и способностей под вашим контролем, как если бы у них не было Порчеустойчивости.\', \'type\': \'Земля\', \'flavor\': \'Ее свет разоблачает врагов и раскрывает секреты.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449634&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'af9cbfe4-4a9a-402d-9343-b3b55118c2c1\', \'multiverseId\': 449634}, \'multiverseid\': 449634}, {\'name\': \'探测塔\', \'text\': \'{T}：加{C}。\\n{1}，{T}：直到回合结束，对具辟邪异能的对手及由对手操控且具该异能的生物而言，你能将其视同不具该异能地指定为由你操控之咒语或异能的目标。\', \'type\': \'地\', \'flavor\': \'它的灯光能暴露敌人，揭露秘密。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449915&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2ee5e602-be17-4391-a442-a4fa43bc9a1d\', \'multiverseId\': 449915}, \'multiverseid\': 449915}, {\'name\': \'探測塔\', \'text\': \'{T}：加{C}。\\n{1}，{T}：直到回合結束，對具辟邪異能的對手及由對手操控且具該異能的生物而言，你能將其視同不具該異能地指定為由你操控之咒語或異能的目標。\', \'type\': \'地\', \'flavor\': \'它的燈光能暴露敵人，揭露秘密。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450196&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'58236ae8-251f-45d2-b84a-646b169ae980\', \'multiverseId\': 450196}, \'multiverseid\': 450196}]', '[{\'name\': \'Palladia-Mors, die Verwüsterin\', \'text\': \'Fliegend, Wachsamkeit, verursacht Trampelschaden\\nPalladia-Mors, die Verwüsterin, hat Fluchsicherheit, falls sie noch keinen Schaden zugefügt hat.\', \'type\': \'Legendäre Kreatur — Ältester, Drache\', \'flavor\': \'Schwester von Nicol Bolas. Überlebende des Krieges der Drachenältesten. Die bösartigste ihrer Art.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447637&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4080386c-dbe6-48e8-9514-f8db0a26f959\', \'multiverseId\': 447637}, \'multiverseid\': 447637}, {\'name\': \'Palladia-Mors, la Desoladora\', \'text\': \'Vuela, vigilancia, arrolla.\\nPalladia-Mors, la Desoladora tiene la habilidad de antimaleficio si aún no ha hecho daño.\', \'type\': \'Criatura legendaria — Dragón anciano\', \'flavor\': \'Hermana de Nicol Bolas. Superviviente de la guerra de los dragones ancianos. La más cruel de su estirpe.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447918&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6ae78c65-3e06-4aa8-ba65-e3a8a32871b4\', \'multiverseId\': 447918}, \'multiverseid\': 447918}, {\'name\': \'Palladia-Mors, la destructrice\', \'text\': "Vol, vigilance, piétinement\\nPalladia-Mors, la destructrice a la défense talismanique si elle n\'a pas encore infligé de blessures.", \'type\': \'Créature légendaire : ancêtre et dragon\', \'flavor\': \'Sœur de Nicol Bolas. Survivante de la Guerre des ancêtres dragons. La plus cruelle de son espèce.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448199&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bd219f49-9a08-4fa4-845c-f8abe53d2e40\', \'multiverseId\': 448199}, \'multiverseid\': 448199}, {\'name\': \'Palladia-Mors, la Rovinosa\', \'text\': \'Volare, cautela, travolgere\\nPalladia-Mors, la Rovinosa ha anti-malocchio se non ha ancora inflitto danno.\', \'type\': \'Creatura Leggendaria — Antico Drago\', \'flavor\': \'Sorella di Nicol Bolas, sopravvissuta alla Guerra degli Antichi Draghi, la più feroce della sua stirpe.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448480&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d57503fc-65c9-4343-b882-651ec28e0c1d\', \'multiverseId\': 448480}, \'multiverseid\': 448480}, {\'name\': \'殲滅の龍、パラディア＝モルス\', \'text\': \'飛行、警戒、トランプル\\n殲滅の龍、パラディア＝モルスがまだダメージを与えていないなら、これは呪禁を持つ。\', \'type\': \'伝説のクリーチャー — エルダー・ドラゴン\', \'flavor\': \'ニコル・ボーラスの妹であり、巨竜戦争の生存者。同類の中で最も獰猛。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448761&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c4eb3069-dad5-48d9-b968-a2e5a83df7ca\', \'multiverseId\': 448761}, \'multiverseid\': 448761}, {\'name\': \'멸망시키는 자, 팔라디아-모르스\', \'text\': \'비행, 경계, 돌진\\n멸망시키는 자, 팔라디아-모르스는 아직 피해를 입힌 적이 없다면 방호를 가진다.\', \'type\': \'전설적 생물 — 장로 용\', \'flavor\': \'니콜 볼라스의 자매. 장로 용 전쟁의 생존자. 그녀의 동족 중 가장 잔인하다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449042&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a4a4b064-a8de-414f-9f9f-cebd1a068513\', \'multiverseId\': 449042}, \'multiverseid\': 449042}, {\'name\': \'Palladia-Mors, a Arruinadora\', \'text\': \'Voar, vigilância, atropelar\\nPalladia-Mors, a Arruinadora, terá resistência a magia se ainda não tiver causado dano.\', \'type\': \'Criatura Lendária — Dragão Ancião\', \'flavor\': \'Irmã de Nicol Bolas. Sobrevivente da Guerra dos Dragões Anciãos. A mais maligna de sua espécie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449323&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'83b2080b-f9af-4b8c-bd40-b8ad35d4ec83\', \'multiverseId\': 449323}, \'multiverseid\': 449323}, {\'name\': \'Палладия-Морс, Разрушительница\', \'text\': \'Полет, Бдительность, Пробивной удар\\nПалладия-Морс, Разрушительница имеет Порчеустойчивость, если еще не наносила повреждения.\', \'type\': \'Легендарное Существо — Старейшина Дракон\', \'flavor\': \'Сестра Никола Боласа. Выжившая в Войне драконов-старейшин. Самая жестокая из своего рода.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449604&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4b5a8d05-e1c1-4ae7-9361-970aad9a7816\', \'multiverseId\': 449604}, \'multiverseid\': 449604}, {\'name\': \'烬龙派蒂墨司\', \'text\': \'飞行，警戒，践踏\\n如果烬龙派蒂墨司还没造成过伤害，则它具有辟邪异能。\', \'type\': \'传奇生物 ～长老／龙\', \'flavor\': \'尼可波拉斯的妹妹。长老龙之战的幸存者。在其族内最为残暴。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449885&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dc7ce68d-23ed-4bb4-989b-f526883b8d75\', \'multiverseId\': 449885}, \'multiverseid\': 449885}, {\'name\': \'燼龍派蒂墨司\', \'text\': \'飛行，警戒，踐踏\\n如果燼龍派蒂墨司還沒造成過傷害，則它具有辟邪異能。\', \'type\': \'傳奇生物 ～長老／龍\', \'flavor\': \'尼可波拉斯的妹妹。長老龍之戰的倖存者。在其族內最為殘暴。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450166&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b33bea15-ae44-4635-bf40-92b13680d1df\', \'multiverseId\': 450166}, \'multiverseid\': 450166}]', '[{\'name\': \'Pegasus-Renner\', \'text\': \'Fliegend\\nImmer wenn der Pegasus-Renner angreift, erhält eine andere angreifende Kreatur deiner Wahl Flugfähigkeit bis zum Ende des Zuges.\', \'type\': \'Kreatur — Pegasus\', \'flavor\': \'Ein Pegasus wählt sich seinen Reiter. Er trägt die Würdigen in die Lüfte und stößt alle anderen hinab.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447449&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c089b642-89ea-414f-acaa-09074d550c47\', \'multiverseId\': 447449}, \'multiverseid\': 447449}, {\'name\': \'Pegaso de combate\', \'text\': \'Vuela.\\nSiempre que el Pegaso de combate ataque, otra criatura atacante objetivo gana la habilidad de volar hasta el final del turno.\', \'type\': \'Criatura — Pegaso\', \'flavor\': \'Un pegaso elige a su jinete; llevará a los dignos hasta las nubes, pero arrojará al suelo al resto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447730&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1c7cfd90-2668-4746-b50e-07bec07a92db\', \'multiverseId\': 447730}, \'multiverseid\': 447730}, {\'name\': \'Coursier pégase\', \'text\': "Vol\\nÀ chaque fois que le Coursier pégase attaque, une autre créature attaquante ciblée acquiert le vol jusqu\'à la fin du tour.", \'type\': \'Créature : pégase\', \'flavor\': "Un pégase choisit son cavalier, portant celui qui en est digne jusqu\'au firmament, et jetant les autres au sol.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448011&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ea533e80-0f21-4540-9161-b7b9cc51f8af\', \'multiverseId\': 448011}, \'multiverseid\': 448011}, {\'name\': \'Pegaso Corsiere\', \'text\': "Volare\\nOgniqualvolta il Pegaso Corsiere attacca, un\'altra creatura attaccante bersaglio ha volare fino alla fine del turno.", \'type\': \'Creatura — Pegaso\', \'flavor\': "Ogni pegaso sceglie il proprio cavaliere, conducendo tra le nubi l\'unico ritenuto degno e scagliando tutti gli altri a terra.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448292&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'60b78f25-bd9a-4e57-84e5-0daf3c13a398\', \'multiverseId\': 448292}, \'multiverseid\': 448292}, {\'name\': \'ペガサスの駿馬\', \'text\': \'飛行\\nペガサスの駿馬が攻撃するたび、他の攻撃クリーチャー１体を対象とする。ターン終了時まで、それは飛行を得る。\', \'type\': \'クリーチャー — ペガサス\', \'flavor\': \'ペガサスは乗り手を選ぶ。相応しい者を雲上に運び、他の者はすべて地面に落とすのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448573&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'454b439f-a5c8-4910-a990-9e48f738ab81\', \'multiverseId\': 448573}, \'multiverseid\': 448573}, {\'name\': \'페가수스 군마\', \'text\': \'비행\\n페가수스 군마가 공격할 때마다, 공격 중인 다른 생물을 목표로 정한다. 그 생물은 턴종료까지 비행을 얻는다.\', \'type\': \'생물 — 페가수스\', \'flavor\': \'구름을 뚫고 날아오를 수 있는 페가수스는 자신의 기수를 직접 정하며, 자격 없는 자들을 땅에 내동댕이친다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448854&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4e0421ae-f69f-4391-8d3e-ee4802083a60\', \'multiverseId\': 448854}, \'multiverseid\': 448854}, {\'name\': \'Pégaso Veloz\', \'text\': \'Voar\\nToda vez que Pégaso Veloz ataca, outra criatura atacante alvo ganha voar até o final do turno.\', \'type\': \'Criatura — Pégaso\', \'flavor\': \'É o pégaso quem escolhe seu ginete, levando os dignos às nuvens e todos os outros ao chão.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449135&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ba0a512d-07a2-48d9-b02d-087a93566a58\', \'multiverseId\': 449135}, \'multiverseid\': 449135}, {\'name\': \'Быстрокрылый Пегас\', \'text\': \'Полет\\nКаждый раз, когда Быстрокрылый Пегас атакует, другое целевое атакующее существо получает Полет до конца хода.\', \'type\': \'Существо — Пегас\', \'flavor\': \'Пегас сам выбирает своего наездника: достойного он поднимает к облакам, а остальных сбрасывает на землю.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449416&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4b39a431-f3ed-435e-8b7c-c693cc76d623\', \'multiverseId\': 449416}, \'multiverseid\': 449416}, {\'name\': \'飞天骏马\', \'text\': \'飞行\\n每当飞天骏马攻击时，另一个目标进行攻击的生物获得飞行异能直到回合结束。\', \'type\': \'生物 ～飞马\', \'flavor\': \'飞马会挑选自己的骑手，合格者能坐上马背直闯云霄，不够格的则会被无情抛落地面。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449697&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dd7f18e0-3917-4a1a-8350-e8be3561613f\', \'multiverseId\': 449697}, \'multiverseid\': 449697}, {\'name\': \'飛天駿馬\', \'text\': \'飛行\\n每當飛天駿馬攻擊時，另一個目標進行攻擊的生物獲得飛行異能直到回合結束。\', \'type\': \'生物 ～飛馬\', \'flavor\': \'飛馬會挑選自己的騎手，合格者能坐上馬背直闖雲霄，不夠格的則會被無情拋落地面。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449978&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2b58d387-fcb7-4dc5-ac85-6f245dcbb28d\', \'multiverseId\': 449978}, \'multiverseid\': 449978}]', '[{\'name\': \'Pelakka-Wurm\', \'text\': \'Verursacht Trampelschaden\\nWenn der Pelakka-Wurm ins Spiel kommt, erhältst du 7 Lebenspunkte dazu.\\nWenn der Pelakka-Wurm stirbt, ziehe eine Karte.\', \'type\': \'Kreatur — Wurm\', \'flavor\': \'Er frisst, was er fressen will — also alles, was sich bewegt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447609&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'744844b6-001b-41ed-926f-b765e42f6b0c\', \'multiverseId\': 447609}, \'multiverseid\': 447609}, {\'name\': \'Sierpe de Pelakka\', \'text\': \'Arrolla.\\nCuando la Sierpe de Pelakka entre al campo de batalla, ganas 7 vidas.\\nCuando la Sierpe de Pelakka muera, roba una carta.\', \'type\': \'Criatura — Sierpe\', \'flavor\': \'Come lo que quiere comer, que es todo lo que se mueva.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447890&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6ff038cc-8d90-4fe0-84ad-3de04b326331\', \'multiverseId\': 447890}, \'multiverseid\': 447890}, {\'name\': \'Guivre de Pelakka\', \'text\': \'Piétinement\\nQuand la Guivre de Pelakka arrive sur le champ de bataille, vous gagnez 7 points de vie.\\nQuand la Guivre de Pelakka meurt, piochez une carte.\', \'type\': \'Créature : guivre\', \'flavor\': "Elle mange tout ce qu\'elle veut — et elle veut tout ce qui bouge.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448171&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'33aa95da-d53f-486f-937c-44d89c581835\', \'multiverseId\': 448171}, \'multiverseid\': 448171}, {\'name\': \'Wurm di Pelakka\', \'text\': \'Travolgere\\nQuando il Wurm di Pelakka entra nel campo di battaglia, guadagni 7 punti vita.\\nQuando il Wurm di Pelakka muore, pesca una carta.\', \'type\': \'Creatura — Wurm\', \'flavor\': \'Mangia tutto quel che vuole... che è tutto quel che si muove.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448452&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d98bbb65-ac98-47e7-a4d3-7cadb0d3a519\', \'multiverseId\': 448452}, \'multiverseid\': 448452}, {\'name\': \'ペラッカのワーム\', \'text\': \'トランプル\\nペラッカのワームが戦場に出たとき、あなたは７点のライフを得る。\\nペラッカのワームが死亡したとき、カードを１枚引く。\', \'type\': \'クリーチャー — ワーム\', \'flavor\': \'そいつは食いたいものを食う。つまり、動くものなら何でもだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448733&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'62b7fb29-167b-4f17-9ba9-cb56257e1288\', \'multiverseId\': 448733}, \'multiverseid\': 448733}, {\'name\': \'펠라카 웜\', \'text\': \'돌진\\n펠라카 웜이 전장에 들어올 때, 당신은 생명 7점을 얻는다.\\n펠라카 웜이 죽을 때, 카드 한 장을 뽑는다.\', \'type\': \'생물 — 웜\', \'flavor\': \'웜은 움직이는 것이라면 닥치는 대로 먹는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449014&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b7c7b95c-63fd-4fa2-b1b6-73656dfb3701\', \'multiverseId\': 449014}, \'multiverseid\': 449014}, {\'name\': \'Vorme de Pelakka\', \'text\': \'Atropelar\\nQuando Vorme de Pelakka entra no campo de batalha, você ganha 7 pontos de vida.\\nQuando Vorme de Pelakka morrer, compre um card.\', \'type\': \'Criatura — Vorme\', \'flavor\': \'Ele come o que deseja comer, ou seja, qualquer coisa que se mova.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449295&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'68aa5139-68de-4aa4-bde1-22d262d92c65\', \'multiverseId\': 449295}, \'multiverseid\': 449295}, {\'name\': \'Вурм Ущелья Пелакка\', \'text\': \'Пробивной удар\\nКогда Вурм Ущелья Пелакка выходит на поле битвы, вы получаете 7 жизней.\\nКогда Вурм Ущелья Пелакка умирает, возьмите карту.\', \'type\': \'Существо — Вурм\', \'flavor\': \'Он ест то, что хочет, — то есть все, что движется.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449576&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f32a6304-6fec-4480-9448-b7b24442bf31\', \'multiverseId\': 449576}, \'multiverseid\': 449576}, {\'name\': \'皮拉卡亚龙\', \'text\': \'践踏\\n当皮拉卡亚龙进战场时，你获得7点生命。\\n当皮拉卡亚龙死去时，抓一张牌。\', \'type\': \'生物 ～亚龙\', \'flavor\': \'它想吃什么就吃什么～也就是任何会动的东西。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449857&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a38b3bb1-a063-4009-9119-d8bc170fe06e\', \'multiverseId\': 449857}, \'multiverseid\': 449857}, {\'name\': \'皮拉卡亞龍\', \'text\': \'踐踏\\n當皮拉卡亞龍進戰場時，你獲得7點生命。\\n當皮拉卡亞龍死去時，抽一張牌。\', \'type\': \'生物 ～亞龍\', \'flavor\': \'牠想吃什麼就吃什麼～也就是任何會動的東西。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450138&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'86709178-bf10-4f81-983f-889a53d051c5\', \'multiverseId\': 450138}, \'multiverseid\': 450138}]', '[{\'name\': \'Pendel der Strukturen\', \'text\': \'Wenn das Pendel der Strukturen ins Spiel kommt, erhältst du 3 Lebenspunkte dazu.\\n{5}, {T}, opfere das Pendel der Strukturen: Ziehe eine Karte.\', \'type\': \'Artefakt\', \'flavor\': \'Sein ausgeklügeltes Design enthüllt die Geheimnisse des Ätherflusses.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450269&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f033b7e0-18bb-4cee-a67b-fb619dba6a8f\', \'multiverseId\': 450269}, \'multiverseid\': 450269}, {\'name\': \'Péndulo de patrones\', \'text\': \'Cuando el Péndulo de patrones entre al campo de batalla, ganas 3 vidas.\\n{5}, {T}, sacrificar el Péndulo de patrones: Roba una carta.\', \'type\': \'Artefacto\', \'flavor\': \'Su elaborado diseño revela los secretos del flujo de éter.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450303&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5c51f398-87bb-4b32-abce-580e04da5cdc\', \'multiverseId\': 450303}, \'multiverseid\': 450303}, {\'name\': \'Pendule à motifs\', \'text\': \'Quand le Pendule à motifs arrive sur le champ de bataille, vous gagnez 3 points de vie.\\n{5}, {T}, sacrifiez le Pendule à motifs : Piochez une carte.\', \'type\': \'Artefact\', \'flavor\': "Ses motifs complexes révèlent les secrets du flux de l\'Éther.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450337&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c77a831e-3970-416b-99b0-77e942ea0a54\', \'multiverseId\': 450337}, \'multiverseid\': 450337}, {\'name\': \'Pendolo dei Diagrammi\', \'text\': \'Quando il Pendolo dei Diagrammi entra nel campo di battaglia, guadagni 3 punti vita.\\n{5}, {T}, Sacrifica il Pendolo dei Diagrammi: Pesca una carta.\', \'type\': \'Artefatto\', \'flavor\': "Gli intricati disegni che traccia rivelano i segreti dei flussi dell\'etere.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450371&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'84a7ce6c-7e17-43e6-9958-bb94b1868961\', \'multiverseId\': 450371}, \'multiverseid\': 450371}, {\'name\': \'霊紋の振り子\', \'text\': \'霊紋の振り子が戦場に出たとき、あなたは３点のライフを得る。\\n{5}, {T}, 霊紋の振り子を生け贄に捧げる：カードを１枚引く。\', \'type\': \'アーティファクト\', \'flavor\': \'精緻な紋様が霊気の流れの秘密を解き明かす。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450405&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ca03eb16-3d7c-4d5e-a835-05deece21380\', \'multiverseId\': 450405}, \'multiverseid\': 450405}, {\'name\': \'문양을 그리는 추\', \'text\': \'문양을 그리는 추가 전장에 들어올 때, 당신은 생명 3점을 얻는다.\\n{5}, {T}, 문양을 빚는 추를 희생한다: 카드 한 장을 뽑는다.\', \'type\': \'마법물체\', \'flavor\': \'그것의 정교한 무늬는 에테르의 흐름에 감춰진 비밀을 보여준다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450439&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1be25df2-d161-4881-858e-3de12e49cdce\', \'multiverseId\': 450439}, \'multiverseid\': 450439}, {\'name\': \'Pêndulo dos Padrões\', \'text\': \'Quando Pêndulo dos Padrões entra no campo de batalha, você ganha 3 pontos de vida.\\n{5}, {T}, Sacrifique Pêndulo dos Padrões: Compre um card.\', \'type\': \'Artefato\', \'flavor\': \'Seus desenhos elaborados revelam segredos do fluxo do éter.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450473&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ba2b9ecc-da9c-4242-a132-a7cf26f1c6ee\', \'multiverseId\': 450473}, \'multiverseid\': 450473}, {\'name\': \'Маятник Узоров\', \'text\': \'Когда Маятник Узоров выходит на поле битвы, вы получаете 3 жизни.\\n{5}, {T}, пожертвуйте Маятник Узоров: возьмите карту.\', \'type\': \'Артефакт\', \'flavor\': \'Его замысловатая конструкция раскрывает тайны эфира.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450507&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6507beee-4728-4c0e-8aa4-a96f5d8f9020\', \'multiverseId\': 450507}, \'multiverseid\': 450507}, {\'name\': \'调律钟摆\', \'text\': \'当调律钟摆进战场时，你获得3点生命。\\n{5}，{T}，牺牲调律钟摆：抓一张牌。\', \'type\': \'神器\', \'flavor\': \'此精巧设计透露出乙太流的秘密。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450541&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4f8d844c-6670-4f25-a639-ab95bba6efde\', \'multiverseId\': 450541}, \'multiverseid\': 450541}, {\'name\': \'調律鐘擺\', \'text\': \'當調律鐘擺進戰場時，你獲得3點生命。\\n{5}，{T}，犧牲調律鐘擺：抽一張牌。\', \'type\': \'神器\', \'flavor\': \'此精巧設計透露出乙太流的秘密。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450575&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f05b7ec0-19cb-47c0-9e00-378f502c007c\', \'multiverseId\': 450575}, \'multiverseid\': 450575}]', '[{\'name\': \'Pestross\', \'text\': \'Das Pestross kann von weißen Kreaturen nicht geblockt werden.\\nWenn das Pestross ins Spiel kommt, erhalten Kreaturen, die deine Gegner kontrollieren, -1/-1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Nachtmahr, Pferd\', \'flavor\': \'Zieht es vorbei, träumen die Schlafenden von Krankheit und Tod.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447531&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2ba07c3a-1afe-48c7-9615-a93e0596bc76\', \'multiverseId\': 447531}, \'multiverseid\': 447531}, {\'name\': \'Corcel de la plaga\', \'text\': \'El Corcel de la plaga no puede ser bloqueado por criaturas blancas.\\nCuando el Corcel de la plaga entre al campo de batalla, las criaturas que controlan tus oponentes obtienen -1/-1 hasta el final del turno.\', \'type\': \'Criatura — Caballo pesadilla\', \'flavor\': \'Cuando pasa, aquellos que duermen sueñan con enfermedades y muerte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447812&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6da22f1d-b3db-4358-ba1f-a86defd60a26\', \'multiverseId\': 447812}, \'multiverseid\': 447812}, {\'name\': \'Jument de la peste\', \'text\': "La Jument de la peste ne peut pas être bloquée par des créatures blanches.\\nQuand la Jument de la peste arrive sur le champ de bataille, les créatures que vos adversaires contrôlent gagnent -1/-1 jusqu\'à la fin du tour.", \'type\': \'Créature : cauchemar et cheval\', \'flavor\': \'Quand elle passe, ceux qui dorment rêvent de maladie et de mort.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448093&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9790be8b-5ec5-47f7-9720-a9eb551949f9\', \'multiverseId\': 448093}, \'multiverseid\': 448093}, {\'name\': \'Destriero della Piaga\', \'text\': \'Il Destriero della Piaga non può essere bloccato dalle creature bianche.\\nQuando il Destriero della Piaga entra nel campo di battaglia, le creature controllate dai tuoi avversari prendono -1/-1 fino alla fine del turno.\', \'type\': \'Creatura — Cavallo Incubo\', \'flavor\': \'Al suo passaggio, coloro che dormono sognano malattia e morte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448374&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1a3401f9-9a59-41b6-9614-0818a3452748\', \'multiverseId\': 448374}, \'multiverseid\': 448374}, {\'name\': \'疫病牝馬\', \'text\': \'疫病牝馬は白のクリーチャーによってはブロックされない。\\n疫病牝馬が戦場に出たとき、ターン終了時まで、対戦相手がコントロールしているクリーチャーは－１/－１の修整を受ける。\', \'type\': \'クリーチャー — ナイトメア・馬\', \'flavor\': \'それが走り去るとき、眠る者は病の夢を見て死ぬ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448655&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'736bfddc-196a-4f9d-a563-6dd94f900c7d\', \'multiverseId\': 448655}, \'multiverseid\': 448655}, {\'name\': \'역병 암말\', \'text\': \'역병 암말은 백색 생물에게 방어될 수 없다.\\n역병 암말이 전장에 들어올 때, 당신의 상대들이 조종하는 생물들은 턴종료까지 -1/-1을 받는다.\', \'type\': \'생물 — 나이트메어 말\', \'flavor\': \'그것이 지나가면, 잠든 자들이 병마와 죽음을 꿈꾼다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448936&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c2f06342-3803-492d-9a4d-d0f137489f06\', \'multiverseId\': 448936}, \'multiverseid\': 448936}, {\'name\': \'Égua da Pestilência\', \'text\': \'Égua da Pestilência não pode ser bloqueada por criaturas brancas.\\nQuando Égua da Pestilência entra no campo de batalha, as criaturas que seus oponentes controlam recebem -1/-1 até o final do turno.\', \'type\': \'Criatura — Pesadelo Cavalo\', \'flavor\': \'Quando ela passa, os que dormem sonham com doenças e morte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449217&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f87c4911-729e-4a78-b333-8c727135b76c\', \'multiverseId\': 449217}, \'multiverseid\': 449217}, {\'name\': \'Кобылица Мора\', \'text\': \'Кобылица Мора не может быть заблокирована белыми существами.\\nКогда Кобылица Мора выходит на поле битвы, существа под контролем ваших оппонентов получают -1/-1 до конца хода.\', \'type\': \'Существо — Кошмар Лошадь\', \'flavor\': \'Когда она скачет, тем, кто спит, снятся сны о болезни и смерти.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449498&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2bc98ec0-ee19-4ce2-99f8-f532d73a7808\', \'multiverseId\': 449498}, \'multiverseid\': 449498}, {\'name\': \'散疫牝马\', \'text\': \'散疫牝马不能被白色生物阻挡。\\n当散疫牝马进战场时，由对手操控的生物得-1/-1直到回合结束。\', \'type\': \'生物 ～梦魇／马\', \'flavor\': \'所经之处，沉沉眠者梦厉疾。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449779&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dc8c5974-9f7a-4ee0-bf69-202d06d173c5\', \'multiverseId\': 449779}, \'multiverseid\': 449779}, {\'name\': \'散疫牝馬\', \'text\': \'散疫牝馬不能被白色生物阻擋。\\n當散疫牝馬進戰場時，由對手操控的生物得-1/-1直到回合結束。\', \'type\': \'生物 ～夢魘／馬\', \'flavor\': \'所經之處，沉沉眠者夢厲疾。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450060&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6ce4eef0-8b09-47d1-a31e-1960556ddd65\', \'multiverseId\': 450060}, \'multiverseid\': 450060}]', '[{\'name\': \'Pfeilhagelveteran\', \'text\': \'Wenn der Pfeilhagelveteran ins Spiel kommt, fügt er einer Kreatur deiner Wahl, die ein Gegner kontrolliert, so viele Schadenspunkte zu, wie du Goblins kontrollierst.\', \'type\': \'Kreatur — Goblin, Krieger\', \'flavor\': \'„Füllt die Lüfte mit Zeug!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447585&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e5be194c-99da-4281-a189-c0bd6a89fc6f\', \'multiverseId\': 447585}, \'multiverseid\': 447585}, {\'name\': \'Veterano de salvas\', \'text\': \'Cuando el Veterano de salvas entre al campo de batalla, hace una cantidad de daño a la criatura objetivo que controla un oponente igual a la cantidad de Trasgos que controlas.\', \'type\': \'Criatura — Guerrero trasgo\', \'flavor\': \'"¡Llenemos los cielos de... cosas!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447866&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'83e8b51e-a804-4c3f-8e35-00c31963f528\', \'multiverseId\': 447866}, \'multiverseid\': 447866}, {\'name\': \'Vétéran de la volée\', \'text\': "Quand le Vétéran de la volée arrive sur le champ de bataille, il inflige à une créature ciblée qu\'un adversaire contrôle un nombre de blessures égal au nombre de gobelins que vous contrôlez.", \'type\': \'Créature : gobelin et guerrier\', \'flavor\': \'« Mettez des machins plein le ciel ! »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448147&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4b5d4a2d-9f29-43be-a5f8-16a8daa93440\', \'multiverseId\': 448147}, \'multiverseid\': 448147}, {\'name\': \'Veterano delle Raffiche\', \'text\': \'Quando il Veterano delle Raffiche entra nel campo di battaglia, infligge danno pari al numero di Goblin che controlli a una creatura bersaglio controllata da un avversario.\', \'type\': \'Creatura — Guerriero Goblin\', \'flavor\': \'"Riempite il cielo con quello che trovate!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448428&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'50536ce0-71c4-42e0-b2ed-87e642d9d9aa\', \'multiverseId\': 448428}, \'multiverseid\': 448428}, {\'name\': \'斉射の古参兵\', \'text\': \'斉射の古参兵が戦場に出たとき、対戦相手がコントロールしているクリーチャー１体を対象とする。これはそれにあなたがコントロールしているゴブリンの総数に等しい点数のダメージを与える。\', \'type\': \'クリーチャー — ゴブリン・戦士\', \'flavor\': \'「空を埋め尽くせ！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448709&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2f66e8ad-3474-4fdf-9570-b21324faa7e9\', \'multiverseId\': 448709}, \'multiverseid\': 448709}, {\'name\': \'일제사격 베테랑\', \'text\': \'일제사격 베테랑이 전장에 들어올 때, 상대가 조종하는 생물을 목표로 정한다. 일제사격 베테랑은 그 생물에게 당신이 조종하는 고블린의 수만큼 피해를 입힌다.\', \'type\': \'생물 — 고블린 전사\', \'flavor\': \'"하늘을 가득 채워!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448990&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c93a045a-37c6-49a6-9e71-9f45e1e75f7a\', \'multiverseId\': 448990}, \'multiverseid\': 448990}, {\'name\': \'Veterano das Saraivadas\', \'text\': \'Quando Veterano das Saraivadas entra no campo de batalha, ele causa à criatura alvo que um oponente controla uma quantidade de dano igual ao número de Goblins que você controla.\', \'type\': \'Criatura — Goblin Guerreiro\', \'flavor\': \'"Encham o céu com tudo o que tiverem!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449271&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'98608bbe-08de-41cd-8f5c-7946a35c7171\', \'multiverseId\': 449271}, \'multiverseid\': 449271}, {\'name\': \'Опытный Застрельщик\', \'text\': \'Когда Опытный Застрельщик выходит на поле битвы, он наносит целевому существу под контролем оппонента повреждения, равные количеству Гоблинов под вашим контролем.\', \'type\': \'Существо — Гоблин Воин\', \'flavor\': \'«Наполнить небо всяким!»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449552&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e56dd50a-1852-4f10-947a-20c649e61684\', \'multiverseId\': 449552}, \'multiverseid\': 449552}, {\'name\': \'齐射老手\', \'text\': \'当齐射老手进战场时，它向目标由对手操控的生物造成伤害，其数量等同于由你操控的鬼怪数量。\', \'type\': \'生物 ～鬼怪／战士\', \'flavor\': \'「填满天空，什么都好！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449833&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'738fb797-6635-470f-8358-e65926fa7513\', \'multiverseId\': 449833}, \'multiverseid\': 449833}, {\'name\': \'齊射老手\', \'text\': \'當齊射老手進戰場時，它向目標由對手操控的生物造成傷害，其數量等同於由你操控的鬼怪數量。\', \'type\': \'生物 ～鬼怪／戰士\', \'flavor\': \'「填滿天空，什麼都好！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450114&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8e5a128d-7360-4a95-962a-3efd14811b18\', \'multiverseId\': 450114}, \'multiverseid\': 450114}]', '[{\'name\': \'Phantomherrscher\', \'text\': \'Fliegend\\nAndere Geister, die du kontrollierst, erhalten +1/+1.\', \'type\': \'Kreatur — Geist\', \'flavor\': \'Das Wissen eines Königs verschwindet nicht einfach mit seinem letzten Herzschlag.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447493&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1288c28f-115f-47ca-9ac7-2625bdfa472a\', \'multiverseId\': 447493}, \'multiverseid\': 447493}, {\'name\': \'Fantasma supremo\', \'text\': \'Vuela.\\nLos otros Espíritus que controlas obtienen +1/+1.\', \'type\': \'Criatura — Espíritu\', \'flavor\': \'El conocimiento de un rey no desaparece cuando su corazón deja de latir.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447774&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f94d44ed-3b8e-4683-81b3-6d98ec0d6b31\', \'multiverseId\': 447774}, \'multiverseid\': 447774}, {\'name\': \'Fantôme suprême\', \'text\': \'Vol\\nLes autres esprits que vous contrôlez gagnent +1/+1.\', \'type\': \'Créature : esprit\', \'flavor\': "Le savoir d\'un roi ne disparaît pas quand son cœur s\'arrête de battre.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448055&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2591cbd0-e313-407f-b9ee-9e88b7a4c9b0\', \'multiverseId\': 448055}, \'multiverseid\': 448055}, {\'name\': \'Fantasma Supremo\', \'text\': \'Volare\\nGli altri Spiriti che controlli prendono +1/+1.\', \'type\': \'Creatura — Spirito\', \'flavor\': \'Lo scibile di un re non svanisce quando il suo cuore cessa di battere.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448336&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ad25c399-95b8-4799-8cdd-bfca929b4a11\', \'multiverseId\': 448336}, \'multiverseid\': 448336}, {\'name\': \'至高の幻影\', \'text\': \'飛行\\nあなたがコントロールしている他のスピリットは＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — スピリット\', \'flavor\': \'王の叡智はその心臓が鼓動をやめたとて消えてなくなりはしない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448617&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8379b2f3-2ebd-4092-9e89-c6db5386803e\', \'multiverseId\': 448617}, \'multiverseid\': 448617}, {\'name\': \'지고한 환상\', \'text\': \'비행\\n당신이 조종하는 다른 신령들은 +1/+1을 받는다.\', \'type\': \'생물 — 신령\', \'flavor\': \'왕의 지식은 심장이 멈추더라도 사라지지 않는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448898&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'983e274c-d185-4b76-91f6-58e03e2b3c80\', \'multiverseId\': 448898}, \'multiverseid\': 448898}, {\'name\': \'Fantasma Supremo\', \'text\': \'Voar\\nOs outros Espíritos que você controla recebem +1/+1.\', \'type\': \'Criatura — Espírito\', \'flavor\': \'O conhecimento de um rei não desaparece quando o coração para de bater.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449179&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5642690f-d27d-4a4b-a7c3-83d69756f41d\', \'multiverseId\': 449179}, \'multiverseid\': 449179}, {\'name\': \'Верховный Призрак\', \'text\': \'Полет\\nДругие Духи под вашим контролем получают +1/+1.\', \'type\': \'Существо — Дух\', \'flavor\': \'Знания короля не пропадают, когда перестает биться его сердце.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449460&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c68344fa-8711-475f-9426-ffcde2936f90\', \'multiverseId\': 449460}, \'multiverseid\': 449460}, {\'name\': \'超凡幽魅\', \'text\': \'飞行\\n由你操控的其他精怪得+1/+1。\', \'type\': \'生物 ～精怪\', \'flavor\': \'国王的智识不会随着心脏停止跳动而消逝。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449741&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5b0cb49a-6395-4117-8393-9bed4ec8e665\', \'multiverseId\': 449741}, \'multiverseid\': 449741}, {\'name\': \'超凡幽魅\', \'text\': \'飛行\\n由你操控的其他精靈得+1/+1。\', \'type\': \'生物 ～精靈\', \'flavor\': \'國王的智識不會隨著心臟停止跳動而消逝。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450022&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c921e17c-f38a-4329-84b6-8ccb192956a6\', \'multiverseId\': 450022}, \'multiverseid\': 450022}]', "[{'name': 'Phylakterion-Lich', 'text': 'Unzerstörbar\\nSowie der Phylakterion-Lich ins Spiel kommt, lege eine Phylakterion-Marke auf ein Artefakt, das du kontrollierst.\\nWenn du keine bleibenden Karten mit Phylakterion-Marken kontrollierst, opfere den Phylakterion-Lich.', 'type': 'Kreatur — Zombie', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447530&type=card', 'language': 'German', 'identifiers': {'scryfallId': '24b7808e-ed44-4ab6-b7e3-6be110e2d2ba', 'multiverseId': 447530}, 'multiverseid': 447530}, {'name': 'Liche de la filacteria', 'text': 'Indestructible.\\nEn cuanto el Liche de la filacteria entre al campo de batalla, pon un contador de filacteria sobre un artefacto que controlas.\\nCuando no controles permanentes con contadores de filacteria sobre ellos, sacrifica el Liche de la filacteria.', 'type': 'Criatura — Zombie', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447811&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '85d2115c-ef1a-47a3-aafa-df9d7954e3ce', 'multiverseId': 447811}, 'multiverseid': 447811}, {'name': 'Liche aux phylactères', 'text': 'Indestructible\\nAu moment où la Liche aux phylactères arrive sur le champ de bataille, mettez un marqueur « phylactère » sur un artefact que vous contrôlez.\\nQuand vous ne contrôlez pas de permanents avec des marqueurs « phylactère » sur eux, sacrifiez la Liche aux phylactères.', 'type': 'Créature : zombie', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448092&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e410bc5e-5f04-4614-8b1b-606ca221f101', 'multiverseId': 448092}, 'multiverseid': 448092}, {'name': 'Lich del Filatterio', 'text': 'Indistruttibile\\nMentre il Lich del Filatterio entra nel campo di battaglia, metti un segnalino filatterio su un artefatto che controlli.\\nQuando non controlli permanenti con segnalini filatterio, sacrifica il Lich del Filatterio.', 'type': 'Creatura — Zombie', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448373&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '2ecfe585-3e52-414d-a8af-4e3baec0ae93', 'multiverseId': 448373}, 'multiverseid': 448373}, {'name': '聖句札の死者', 'text': '破壊不能\\n聖句札の死者が戦場に出るに際し、あなたがコントロールしているアーティファクト１つの上に聖句カウンターを１個置く。\\nあなたが聖句カウンターが置かれているパーマネントをコントロールしていないとき、聖句札の死者を生け贄に捧げる。', 'type': 'クリーチャー — ゾンビ', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448654&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'a1dd2c87-d240-4c24-b634-ed8205f741e1', 'multiverseId': 448654}, 'multiverseid': 448654}, {'name': '부적 리치', 'text': '무적\\n부적 리치가 전장에 들어오면서, 당신이 조종하는 마법물체 한 개에 부적 카운터 한 개를 올려놓는다.\\n당신이 부적 카운터를 가진 지속물을 조종하지 않을 때, 부적 리치를 희생한다.', 'type': '생물 — 좀비', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448935&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '4a107d1e-eb1c-44f9-82bb-41e09fc18eb5', 'multiverseId': 448935}, 'multiverseid': 448935}, {'name': 'Lich do Talismã', 'text': 'Indestrutível\\nQuando Lich do Talismã entrar no campo de batalha, coloque um marcador de talismã em um artefato que você controla.\\nQuando você não controlar nenhuma permanente com marcadores de talismã, sacrifique Lich do Talismã.', 'type': 'Criatura — Zumbi', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449216&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5ee40726-2d76-47c7-a858-a0786d1b346e', 'multiverseId': 449216}, 'multiverseid': 449216}, {'name': 'Лич с Филактерией', 'text': 'Неразрушимость\\nПри выходе Лича с Филактерией на поле битвы положите один жетон филактерии на артефакт под вашим контролем.\\nКогда под вашим контролем нет перманентов с жетонами филактерии на них, пожертвуйте Лича с Филактерией.', 'type': 'Существо — Зомби', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449497&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '7582c7a8-b519-4afe-b9a9-9052ec9a0ca1', 'multiverseId': 449497}, 'multiverseid': 449497}, {'name': '避邪符巫妖', 'text': '不灭\\n于避邪符巫妖进战场时，在一个由你操控的神器上放置一个避邪符指示物。\\n当你未操控其上有避邪符指示物的永久物时，牺牲避邪符巫妖。', 'type': '生物 ～灵俑', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449778&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'd204333a-7c6c-416c-a012-49d2ff9b0053', 'multiverseId': 449778}, 'multiverseid': 449778}, {'name': '避邪符巫妖', 'text': '不滅\\n於避邪符巫妖進戰場時，在一個由你操控的神器上放置一個避邪符指示物。\\n當你未操控其上有避邪符指示物的永久物時，犧牲避邪符巫妖。', 'type': '生物 ～殭屍', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450059&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '8d81d312-0ef1-434b-8fbc-67368cd601b6', 'multiverseId': 450059}, 'multiverseid': 450059}]", '[{\'name\': \'Prachtvoller Engel\', \'text\': \'Fliegend\\nZu Beginn jedes Endsegments und falls du in diesem Zug 5 oder mehr Lebenspunkte dazuerhalten hast, erzeuge einen 4/4 weißen Engel-Kreaturenspielstein mit Flugfähigkeit und Wachsamkeit.\\n{3}{W}{W}{W}: Bis zum Ende des Zuges erhält der Prachtvolle Engel +2/+2 und Lebensverknüpfung.\', \'type\': \'Kreatur — Engel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447451&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7ca55757-63cf-418d-9ee7-afc54c53ef79\', \'multiverseId\': 447451}, \'multiverseid\': 447451}, {\'name\': \'Ángel resplandeciente\', \'text\': \'Vuela.\\nAl comienzo de cada paso final, si has ganado 5 o más vidas este turno, crea una ficha de criatura Ángel blanca 4/4 con las habilidades de volar y vigilancia.\\n{3}{W}{W}{W}: Hasta el final del turno, el Ángel resplandeciente obtiene +2/+2 y gana la habilidad de vínculo vital.\', \'type\': \'Criatura — Ángel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447732&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a00c35e8-8395-490a-96dd-25952adda963\', \'multiverseId\': 447732}, \'multiverseid\': 447732}, {\'name\': \'Ange resplendissant\', \'text\': "Vol\\nAu début de chaque étape de fin, si vous avez gagné au moins 5 points de vie ce tour-ci, créez un jeton de créature 4/4 blanche Ange avec le vol et la vigilance.\\n{3}{W}{W}{W} : Jusqu\'à la fin du tour, l\'Ange resplendissant gagne +2/+2 et acquiert le lien de vie.", \'type\': \'Créature : ange\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448013&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5f081bb8-0766-4b9a-86ed-a0b6fe2c0e4a\', \'multiverseId\': 448013}, \'multiverseid\': 448013}, {\'name\': \'Angelo Splendente\', \'text\': "Volare\\nAll\'inizio di ogni sottofase finale, se hai guadagnato 5 o più punti vita in questo turno, crea una pedina creatura Angelo 4/4 bianca con volare e cautela.\\n{3}{W}{W}{W}: Fino alla fine del turno, l\'Angelo Splendente prende +2/+2 e ha legame vitale.", \'type\': \'Creatura — Angelo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448294&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'28d33195-34f3-436f-86bb-ce24fa5f1c23\', \'multiverseId\': 448294}, \'multiverseid\': 448294}, {\'name\': \'輝かしい天使\', \'text\': \'飛行\\n各終了ステップの開始時に、このターンあなたが５点以上のライフを得ていた場合、飛行と警戒を持つ白の４/４の天使・クリーチャー・トークンを１体生成する。\\n{3}{W}{W}{W}：ターン終了時まで、輝かしい天使は＋２/＋２の修整を受け、絆魂を得る。\', \'type\': \'クリーチャー — 天使\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448575&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'21a656b8-9b91-4a36-a17c-0c709d2e00d8\', \'multiverseId\': 448575}, \'multiverseid\': 448575}, {\'name\': \'휘황찬란한 천사\', \'text\': \'비행\\n각 종료단 시작에, 당신이 이 턴에 생명 5점 이상을 얻었다면, 비행과 경계를 가진 4/4 백색 천사 생물 토큰 한 개를 만든다.\\n{3}{W}{W}{W}: 턴종료까지, 휘황찬란한 천사는 +2/+2를 받고 생명연결을 얻는다.\', \'type\': \'생물 — 천사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448856&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0d8e0942-1e9b-400e-a3e7-0ee50f8e2db6\', \'multiverseId\': 448856}, \'multiverseid\': 448856}, {\'name\': \'Anjo Resplandecente\', \'text\': \'Voar\\nNo início de cada etapa final, se você ganhou 5 ou mais pontos de vida neste turno, crie uma ficha de criatura branca 4/4 do tipo Anjo com voar e vigilância.\\n{3}{W}{W}{W}: Até o final do turno, Anjo Resplandecente recebe +2/+2 e ganha vínculo com a vida.\', \'type\': \'Criatura — Anjo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449137&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e9e54c03-a278-45e9-b4e2-6f18fca4ed4e\', \'multiverseId\': 449137}, \'multiverseid\': 449137}, {\'name\': \'Блистательный Ангел\', \'text\': \'Полет\\nВ начале каждого заключительного шага, если в этом ходу вы получили не менее 5 жизней, создайте одну фишку существа 4/4 белый Ангел с Полетом и Бдительностью.\\n{3}{W}{W}{W}: до конца хода Блистательный Ангел получает +2/+2 и Цепь жизни.\', \'type\': \'Существо — Ангел\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449418&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2f86b9f6-74af-4be7-be90-70299fd7be87\', \'multiverseId\': 449418}, \'multiverseid\': 449418}, {\'name\': \'华辉天使\', \'text\': \'飞行\\n在每个结束步骤开始时，若本回合中你获得了5点或更多生命，则派出一个4/4白色，具飞行与警戒异能的天使衍生生物。\\n{3}{W}{W}{W}：直到回合结束，华辉天使得+2/+2且获得系命异能。\', \'type\': \'生物 ～天使\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449699&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'be282acf-b056-4a2a-bdba-fc6014e5243c\', \'multiverseId\': 449699}, \'multiverseid\': 449699}, {\'name\': \'華輝天使\', \'text\': \'飛行\\n在每個結束步驟開始時，若本回合中你獲得了5點或更多生命，則派出一個4/4白色，具飛行與警戒異能的天使衍生生物。\\n{3}{W}{W}{W}：直到回合結束，華輝天使得+2/+2且獲得繫命異能。\', \'type\': \'生物 ～天使\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449980&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'dc157d29-9ce5-4f07-ad45-959dc7df28c8\', \'multiverseId\': 449980}, \'multiverseid\': 449980}]', '[{\'name\': \'Prügelnder Oger\', \'text\': \'Bedrohlich (Diese Kreatur kann nicht geblockt werden, außer von zwei oder mehr Kreaturen.)\\nImmer wenn der Prügelnde Oger angreift, kannst du eine andere Kreatur opfern. Falls du dies tust, erhält der Prügelnde Oger +2/+2 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Oger, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447630&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4f275ce8-07ac-486e-ab9e-9c9fd2ecb0b3\', \'multiverseId\': 447630}, \'multiverseid\': 447630}, {\'name\': \'Ogro machacaplastador\', \'text\': \'Amenaza. (Esta criatura no puede ser bloqueada excepto por dos o más criaturas.)\\nSiempre que el Ogro machacaplastador ataque, puedes sacrificar otra criatura. Si lo haces, el Ogro machacaplastador obtiene +2/+2 hasta el final del turno.\', \'type\': \'Criatura — Guerrero ogro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447911&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4cc0281f-f0ce-4b76-a630-7a80629a9ad7\', \'multiverseId\': 447911}, \'multiverseid\': 447911}, {\'name\': \'Ogre lyncherixe\', \'text\': "Menace (Cette créature ne peut pas être bloquée excepté par deux créatures ou plus.)\\nÀ chaque fois que l\'Ogre lyncherixe attaque, vous pouvez sacrifier une autre créature. Si vous faites ainsi, l\'Ogre lyncherixe gagne +2/+2 jusqu\'à la fin du tour.", \'type\': \'Créature : ogre et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448192&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'21427f61-8ba1-445b-a9d1-7684fdef9271\', \'multiverseId\': 448192}, \'multiverseid\': 448192}, {\'name\': \'Ogre Rissazzuffa\', \'text\': "Minacciare (Questa creatura non può essere bloccata tranne che da due o più creature.)\\nOgniqualvolta l\'Ogre Rissazzuffa attacca, puoi sacrificare un\'altra creatura. Se lo fai, l\'Ogre Rissazzuffa prende +2/+2 fino alla fine del turno.", \'type\': \'Creatura — Guerriero Ogre\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448473&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2bbff0b0-1b97-49de-977a-8e3c1e7f2a15\', \'multiverseId\': 448473}, \'multiverseid\': 448473}, {\'name\': \'殴りつけるオーガ\', \'text\': \'威迫（このクリーチャーは２体以上のクリーチャーによってしかブロックされない。）\\n殴りつけるオーガが攻撃するたび、あなたは他のクリーチャー１体を生け贄に捧げてもよい。そうしたなら、ターン終了時まで、殴りつけるオーガは＋２/＋２の修整を受ける。\', \'type\': \'クリーチャー — オーガ・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448754&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3976c4d8-e419-4e83-a91f-3a01f7b12f08\', \'multiverseId\': 448754}, \'multiverseid\': 448754}, {\'name\': \'싸움꾼 오우거\', \'text\': \'호전적 (이 생물은 두 개 이상의 생물에만 방어될 수 있다.)\\n싸움꾼 오우거가 공격할 때마다, 당신은 다른 생물 한 개를 희생할 수 있다. 그렇게 한다면, 싸움꾼 오우거는 턴종료까지 +2/+2를 받는다.\', \'type\': \'생물 — 오우거 전사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449035&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f32f51de-fa62-43f6-9728-8446f806aad3\', \'multiverseId\': 449035}, \'multiverseid\': 449035}, {\'name\': \'Ogro Briguento\', \'text\': \'Ameaçar (Esta criatura só pode ser bloqueada por duas ou mais criaturas.)\\nToda vez que Ogro Briguento ataca, você pode sacrificar outra criatura. Se fizer isso, Ogro Briguento recebe +2/+2 até o final do turno.\', \'type\': \'Criatura — Ogro Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449316&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ea52ede2-36f4-446c-b7ed-1f28d2fa77d4\', \'multiverseId\': 449316}, \'multiverseid\': 449316}, {\'name\': \'Огр-Кулакобоец\', \'text\': \'Угроза (Это существо не может быть заблокировано менее чем двумя существами.)\\nКаждый раз, когда Огр-Кулакобоец атакует, вы можете пожертвовать другое существо. Если вы это делаете, Огр-Кулакобоец получает +2/+2 до конца хода.\', \'type\': \'Существо — Огр Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449597&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0b6f46a8-6248-4d20-9079-23efd742d83b\', \'multiverseId\': 449597}, \'multiverseid\': 449597}, {\'name\': \'殴斗食人魔\', \'text\': \'威慑（此生物只能被两个或更多生物阻挡。）\\n每当殴斗食人魔攻击时，你可以牺牲另一个生物。若你如此作，则殴斗食人魔得+2/+2直到回合结束。\', \'type\': \'生物 ～食人魔／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449878&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ad3e3f6f-6692-42d9-b250-77048704b8d7\', \'multiverseId\': 449878}, \'multiverseid\': 449878}, {\'name\': \'毆鬥食人魔\', \'text\': \'威懾（此生物只能被兩個或更多生物阻擋。）\\n每當毆鬥食人魔攻擊時，你可以犧牲另一個生物。若你如此作，則毆鬥食人魔得+2/+2直到回合結束。\', \'type\': \'生物 ～食人魔／戰士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450159&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3f14d9ef-420e-4dad-b010-9c69875e183f\', \'multiverseId\': 450159}, \'multiverseid\': 450159}]', '[{\'name\': \'Psychische Korrosion\', \'text\': \'Immer wenn du eine Karte ziehst, legt jeder Gegner die obersten zwei Karten seiner Bibliothek auf seinen Friedhof.\', \'type\': \'Verzauberung\', \'flavor\': \'„Ein ruinierter Verstand ist in meinen Augen ein schlimmeres Schicksal als der Tod."\\n—Jace Beleren\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447485&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d6d5950c-77a0-446e-888b-0a6796e8de3e\', \'multiverseId\': 447485}, \'multiverseid\': 447485}, {\'name\': \'Corrosión psíquica\', \'text\': \'Siempre que robes una carta, cada oponente pone las dos primeras cartas de su biblioteca en su cementerio.\', \'type\': \'Encantamiento\', \'flavor\': \'"Destrozar una mente es darle a alguien un destino peor que la muerte. Supone un poder terrorífico".\\n—Jace Beleren\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447766&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dbbc3c8e-ffe7-4868-8322-5dc0ab716150\', \'multiverseId\': 447766}, \'multiverseid\': 447766}, {\'name\': \'Corrosion psychique\', \'text\': \'À chaque fois que vous piochez une carte, chaque adversaire met les deux cartes du dessus de sa bibliothèque dans son cimetière.\', \'type\': \'Enchantement\', \'flavor\': "« Briser l\'esprit d\'autrui, c\'est le condamner à un sort pire que la mort. C\'est un pouvoir terrifiant. »\\n—Jace Beleren", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448047&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fa428c35-48c9-4c04-87b9-c276d2d3ccdd\', \'multiverseId\': 448047}, \'multiverseid\': 448047}, {\'name\': \'Corrosione Psichica\', \'text\': \'Ogniqualvolta peschi una carta, ogni avversario mette nel proprio cimitero le prime due carte del proprio grimorio.\', \'type\': \'Incantesimo\', \'flavor\': \'"Annientare la mente di un\\\'altra persona significa infliggerle un destino peggiore della morte. È un potere terrificante."\\n—Jace Beleren\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448328&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8e374ba2-d93b-42c0-b4df-ca11e88cac60\', \'multiverseId\': 448328}, \'multiverseid\': 448328}, {\'name\': \'心理腐食\', \'text\': \'あなたがカードを１枚引くたび、各対戦相手はそれぞれ自分のライブラリーの一番上からカードを２枚自分の墓地に置く。\', \'type\': \'エンチャント\', \'flavor\': \'「人の精神を壊すということは、死よりつらい運命を与えるということだ。恐ろしい力だよ。」\\n――ジェイス・ベレレン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448609&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ca818a18-f359-49c0-81ed-343e769f215e\', \'multiverseId\': 448609}, \'multiverseid\': 448609}, {\'name\': \'정신 침식\', \'text\': \'당신이 카드를 뽑을 때마다, 각 상대는 자신의 서고 맨 위 카드 두 장을 자신의 무덤에 넣는다.\', \'type\': \'부여마법\', \'flavor\': \'"다른 이의 정신을 부수는 것은 죽음보다 더한 운명을 내리는 것이지. 그것은 무시무시한 힘이야."\\n—제이스 벨레렌\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448890&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d4333fab-4017-4c84-89de-e9f357020f0c\', \'multiverseId\': 448890}, \'multiverseid\': 448890}, {\'name\': \'Corrosão Psíquica\', \'text\': \'Toda vez que você compra um card, cada oponente coloca os dois cards do topo do próprio grimório no próprio cemitério.\', \'type\': \'Encantamento\', \'flavor\': \'"Despedaçar a mente alheia é condenar a um destino pior que a morte. É um poder aterrorizante."\\n— Jace Beleren\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449171&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'65131cbf-3078-4013-b325-ba60a2a8827a\', \'multiverseId\': 449171}, \'multiverseid\': 449171}, {\'name\': \'Разъедание Разума\', \'text\': \'Каждый раз, когда вы берете карту, каждый оппонент кладет две верхние карты своей библиотеки на свое кладбище.\', \'type\': \'Чары\', \'flavor\': \'«Разрушить чужой разум — значит обречь на судьбу, еще худшую, чем смерть. Это ужасающая сила».\\n— Джейс Белерен\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449452&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'153b7709-1521-4f25-8724-e1d6f4da8155\', \'multiverseId\': 449452}, \'multiverseid\': 449452}, {\'name\': \'心灵侵蚀\', \'text\': \'每当你抓一张牌时，每位对手各将其牌库顶的两张牌置入其坟墓场。\', \'type\': \'结界\', \'flavor\': \'「粉碎心灵会让对方生不如死。这种力量令人恐惧。」\\n～杰斯贝连\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449733&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'da3da372-f422-4915-b1ae-c9a3f286fd1b\', \'multiverseId\': 449733}, \'multiverseid\': 449733}, {\'name\': \'心靈侵蝕\', \'text\': \'每當你抽一張牌時，每位對手各將其牌庫頂的兩張牌置入其墳墓場。\', \'type\': \'結界\', \'flavor\': \'「粉碎心靈會讓對方生不如死。這種力量令人恐懼。」\\n～傑斯貝連\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450014&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3cc323a2-a361-46fa-90e5-6622556c5f9e\', \'multiverseId\': 450014}, \'multiverseid\': 450014}]', '[{\'name\': \'Quälende Stimme\', \'text\': \'Wirf als zusätzliche Kosten, um diesen Zauberspruch zu wirken, eine Karte ab.\\nZiehe zwei Karten.\', \'type\': \'Hexerei\', \'flavor\': \'„Unwillkommene Gedanken drängen sich in meinem Kopf. Sind das die Ausgeburten meines eigenen Wahns oder das Flüstern eines Anderen?"\\n—Sarkhan Vol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447581&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7b19c3da-5031-4094-afda-581a6d569619\', \'multiverseId\': 447581}, \'multiverseid\': 447581}, {\'name\': \'Voz del tormento\', \'text\': \'Como coste adicional para lanzar este hechizo, descarta una carta.\\nRoba dos cartas.\', \'type\': \'Conjuro\', \'flavor\': \'"En mi mente se agolpan pensamientos no deseados. ¿Son fruto de mi propia locura, o solo son los susurros de la de otro?".\\n—Sarkhan Vol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447862&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cd1e735b-ac51-420a-bb43-96238542e99d\', \'multiverseId\': 447862}, \'multiverseid\': 447862}, {\'name\': \'Voix lancinante\', \'text\': "En tant que coût supplémentaire pour lancer ce sort, défaussez-vous d\'une carte.\\nPiochez deux cartes.", \'type\': \'Rituel\', \'flavor\': "« Des pensées inopportunes m\'emplissent l\'esprit. Sont-elles le reflet de ma propre folie, ou les murmures d\'une autre ? »\\n—Sarkhan Vol", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448143&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2833e2e5-34e4-4d3f-a930-3cd2388b367f\', \'multiverseId\': 448143}, \'multiverseid\': 448143}, {\'name\': \'Voce Torturante\', \'text\': \'Come costo addizionale per lanciare questa magia, scarta una carta.\\nPesca due carte.\', \'type\': \'Stregoneria\', \'flavor\': \'"Pensieri molesti affollano la mia mente. Sono il frutto della mia stessa follia o i sussurri di un estraneo?"\\n—Sarkhan Vol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448424&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8d0f454e-9235-4cd4-a7fd-c5d0ebcd7fd8\', \'multiverseId\': 448424}, \'multiverseid\': 448424}, {\'name\': \'苦しめる声\', \'text\': \'この呪文を唱えるための追加コストとして、カード１枚を捨てる。\\nカードを２枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'「不愉快な思考が私の精神を圧迫する。これは私の狂気によるものなのか、それとも誰か別の者の囁きなのか？」\\n――サルカン・ヴォル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448705&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a5e75544-683b-4b1a-a690-512832b9d4c7\', \'multiverseId\': 448705}, \'multiverseid\': 448705}, {\'name\': \'괴롭히는 목소리\', \'text\': \'이 주문을 발동하기 위한 추가비용으로, 카드 한 장을 버린다.\\n카드 두 장을 뽑는다.\', \'type\': \'집중마법\', \'flavor\': \'"달갑지 않은 생각들이 내 정신을 가득 채운다. 나 자신의 광기인가, 아니면 다른 누군가의 속삭임인가?"\\n—사르칸 볼\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448986&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5ba86015-c935-450d-8b42-ed8527bf3de6\', \'multiverseId\': 448986}, \'multiverseid\': 448986}, {\'name\': \'Voz Atormentadora\', \'text\': \'Como custo adicional para conjurar esta mágica, descarte um card.\\nCompre dois cards.\', \'type\': \'Feitiço\', \'flavor\': \'"Pensamentos indesejados enchem a minha mente. Será que são a minha própria loucura ou os sussurros de outro?"\\n— Sarkhan Vol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449267&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'aba80534-0a4a-42e9-b6a4-19b1c93bde27\', \'multiverseId\': 449267}, \'multiverseid\': 449267}, {\'name\': \'Мучающий Голос\', \'text\': \'В качестве дополнительной стоимости разыгрывания этого заклинания сбросьте карту.\\nВозьмите две карты.\', \'type\': \'Волшебство\', \'flavor\': \'«Мысли, которых я не ждал, заполняют мою голову. Что это — мое собственное безумие или шепот чужих голосов?»\\n— Сархан Воль\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449548&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0f021bd0-983c-47f1-b5bf-d648a6a3ab0b\', \'multiverseId\': 449548}, \'multiverseid\': 449548}, {\'name\': \'折磨幽声\', \'text\': \'弃一张牌，以作为施放此咒语的额外费用。\\n抓两张牌。\', \'type\': \'法术\', \'flavor\': \'「讨厌的想法在我脑海中挥之不去。这是我自己的疯狂，还是他者的细语？」\\n～萨坎沃\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449829&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9e1a6d65-7f7e-4691-89fe-8ed82b3f0904\', \'multiverseId\': 449829}, \'multiverseid\': 449829}, {\'name\': \'折磨幽聲\', \'text\': \'棄一張牌，以作為施放此咒語的額外費用。\\n抽兩張牌。\', \'type\': \'巫術\', \'flavor\': \'「討厭的想法在我腦海中揮之不去。這是我自己的瘋狂，還是他者的細語？」\\n～薩坎沃\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450110&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2f0c11cc-0876-4af5-a88f-932b6974cf31\', \'multiverseId\': 450110}, \'multiverseid\': 450110}]', '[{\'name\': \'Rache nehmen\', \'text\': \'Zerstöre eine getappte Kreatur deiner Wahl.\', \'type\': \'Hexerei\', \'flavor\': \'„Dein Tod ist Balsam für die Seelen und alle werden vor Erleichterung aufatmen, wenn sie von eben diesem erfahren."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447457&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0a693042-4b2d-46c5-810d-8bc393d3b59b\', \'multiverseId\': 447457}, \'multiverseid\': 447457}, {\'name\': \'Vengarse\', \'text\': \'Destruye la criatura objetivo girada.\', \'type\': \'Conjuro\', \'flavor\': \'"Tu muerte será un bálsamo; tu desaparición, un cambio bienvenido; y todos suspirarán de alivio al conocer tu deceso".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447738&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d438c6aa-f3a0-48d2-aef4-bd17a99eb8ac\', \'multiverseId\': 447738}, \'multiverseid\': 447738}, {\'name\': \'Prendre sa vengeance\', \'text\': \'Détruisez la créature engagée ciblée.\', \'type\': \'Rituel\', \'flavor\': "« Ta mort sera un réconfort, ta disparition un doux changement et tous pousseront un soupir de soulagement à l\'annonce de ton trépas. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448019&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'90f54ce2-a295-4f40-9d31-b824f1a9651f\', \'multiverseId\': 448019}, \'multiverseid\': 448019}, {\'name\': \'Vendicare\', \'text\': \'Distruggi una creatura TAPpata bersaglio.\', \'type\': \'Stregoneria\', \'flavor\': \'"La tua morte porterà conforto, la tua dipartita sarà un gradito cambiamento e tutti tireranno un sospiro di sollievo quando sapranno della tua scomparsa."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448300&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eccc5937-1f4f-4f67-a590-7a1759c3b547\', \'multiverseId\': 448300}, \'multiverseid\': 448300}, {\'name\': \'返報\', \'text\': \'タップ状態のクリーチャー１体を対象とし、それを破壊する。\', \'type\': \'ソーサリー\', \'flavor\': \'「貴様の死は慰めとなろう。貴様の消滅は喜ばしき修正となろう。そして貴様の終わりを知った時には皆が安堵するであろう。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448581&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'798966b4-30ef-43c0-8ded-3a107db14215\', \'multiverseId\': 448581}, \'multiverseid\': 448581}, {\'name\': \'원수 갚기\', \'text\': \'탭된 생물을 목표로 정한다. 그 생물을 파괴한다.\', \'type\': \'집중마법\', \'flavor\': \'"네 죽음은 위안이, 네 소멸은 환영받는 정정이 될 것이며, 모두가 네 종말을 알고 평온한 한숨을 내쉴 것이다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448862&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'fbb3969d-d977-414a-99c2-d57c2c950031\', \'multiverseId\': 448862}, \'multiverseid\': 448862}, {\'name\': \'Obter Vingança\', \'text\': \'Destrua a criatura alvo virada.\', \'type\': \'Feitiço\', \'flavor\': \'"Sua morte será um bálsamo, seu perecimento, uma correção muito bem-vinda, e todos suspirarão em paz ao saber de seu fim."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449143&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'655626c5-8575-48bd-9e37-32e8ef77085e\', \'multiverseId\': 449143}, \'multiverseid\': 449143}, {\'name\': \'Свершить Возмездие\', \'text\': \'Уничтожьте целевое повернутое существо.\', \'type\': \'Волшебство\', \'flavor\': \'«Смерть твоя станет бальзамом, уход — желанной переменой, и каждый облегченно вздохнет, узнав о твоей кончине».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449424&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cae4aacf-34cb-432a-bc4a-2809c33c48c0\', \'multiverseId\': 449424}, \'multiverseid\': 449424}, {\'name\': \'报仇\', \'text\': \'消灭目标已横置的生物。\', \'type\': \'法术\', \'flavor\': \'「你的死亡抚慰人心，你的离世彰显天理；闻听你已毙命，所有人都将如释重负。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449705&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'db9973e9-fa76-4aa4-aa92-ad02703ad69d\', \'multiverseId\': 449705}, \'multiverseid\': 449705}, {\'name\': \'報仇\', \'text\': \'消滅目標已橫置的生物。\', \'type\': \'巫術\', \'flavor\': \'「你的死亡撫慰人心，你的離世彰顯天理；聞聽你已斃命，所有人都將如釋重負。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449986&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5bca30c7-06b3-4181-a259-7a3d1c439c1e\', \'multiverseId\': 449986}, \'multiverseid\': 449986}]', "[{'name': 'Rankenmauer', 'text': 'Verteidiger (Diese Kreatur kann nicht angreifen.)\\nReichweite (Diese Kreatur kann fliegende Kreaturen blocken.)', 'type': 'Kreatur — Pflanze, Mauer', 'flavor': 'Wie alle Dschungelpflanzen müssen auch die Ranken mit allen Mitteln um Sonnenlicht kämpfen. Sobald sie sich ihren Platz gesichert haben, verflechten sie sich zu einem starken, dornigen und undurchdringbaren Gewebe.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447627&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'fff5386e-b8ab-4752-a585-26229defad91', 'multiverseId': 447627}, 'multiverseid': 447627}, {'name': 'Muro de enredaderas', 'text': 'Defensor. (Esta criatura no puede atacar.)\\nAlcance. (Esta criatura puede bloquear a criaturas con la habilidad de volar.)', 'type': 'Criatura — Muro planta', 'flavor': 'Al igual que todas las plantas de la selva, las enredaderas deben luchar por un poco de luz. Una vez que su lugar está asegurado, crecen fuertes, afiladas e impenetrables.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447908&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '411bd9aa-16da-44ea-aed0-c325e0ba6020', 'multiverseId': 447908}, 'multiverseid': 447908}, {'name': 'Mur de vignes', 'text': 'Défenseur (Cette créature ne peut pas attaquer).\\nPortée (Cette créature peut bloquer les créatures avec le vol.)', 'type': 'Créature : plante et mur', 'flavor': 'Comme les autres plantes de la jungle, les lianes doivent se battre pour profiter de la lumière du soleil. Une fois leur place sécurisée, elles deviennent plus fortes, plus acérées et impénétrables.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448189&type=card', 'language': 'French', 'identifiers': {'scryfallId': '525e908e-6177-417a-a538-9edcbe520b35', 'multiverseId': 448189}, 'multiverseid': 448189}, {'name': 'Muro di Liane', 'text': 'Difensore (Questa creatura non può attaccare.)\\nRaggiungere (Questa creatura può bloccare le creature con volare.)', 'type': 'Creatura — Muro Pianta', 'flavor': 'Come tutte le piante della giungla, le liane devono aprirsi un varco con gli artigli per la luce del sole. Dopo essersi assicurate un posto, crescono forti, affilate e impenetrabili.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448470&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'd36b4caa-fd92-433a-ae92-a8cd2c42beee', 'multiverseId': 448470}, 'multiverseid': 448470}, {'name': '蔦の壁', 'text': '防衛（このクリーチャーでは攻撃できない。）\\n到達（このクリーチャーで飛行を持つクリーチャーをブロックできる。）', 'type': 'クリーチャー — 植物・壁', 'flavor': 'すべての密林の植物同様、その蔦も陽の光を求めて戦う必要がある。その場所が確保できたら、それは強く、鋭く、誰も通れないまでに成長する。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448751&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '8f18c477-3861-4a9c-af1c-59179896d1d5', 'multiverseId': 448751}, 'multiverseid': 448751}, {'name': '덩굴의 벽', 'text': '수비태세 (이 생물은 공격할 수 없다.)\\n대공 (이 생물은 비행을 가진 생물을 방어할 수 있다.)', 'type': '생물 — 식물 벽', 'flavor': '정글의 다른 식물들과 마찬가지로, 덩굴들도 햇빛을 받고자 힘겨운 경쟁을 벌여야만 한다. 그렇게 뿌리내린 덩굴은 더없이 강하고 날카로우며, 좀처럼 뚫기 어렵게 자라난다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449032&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'e25738c0-3d36-44d1-b754-9a744072abe4', 'multiverseId': 449032}, 'multiverseid': 449032}, {'name': 'Barreira de Trepadeiras', 'text': 'Defensor (Esta criatura não pode atacar.)\\nAlcance (Esta criatura pode bloquear criaturas com voar.)', 'type': 'Criatura — Planta Barreira', 'flavor': 'Como todas as plantas das selvas, as trepadeiras precisam fazer um esforço notável para encontrar a luz do sol. Uma vez conquistado seu lugar, elas crescem robustas, afiadas e impenetráveis.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449313&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '52c1fa9a-eccc-42e3-b4f8-69c512c3cccc', 'multiverseId': 449313}, 'multiverseid': 449313}, {'name': 'Стена Лиан', 'text': 'Защитник (Это существо не может атаковать.)\\nЗахват (Это существо может блокировать существа с Полетом.)', 'type': 'Существо — Растение Стена', 'flavor': 'Как все растения в джунглях, лианы вынуждены бороться за солнечный свет. Отвоевав себе место, они разрастаются, становясь сильными, колкими и непроходимыми.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449594&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '91b851ca-a611-4f11-a6de-33987fa49ed7', 'multiverseId': 449594}, 'multiverseid': 449594}, {'name': '藤蔓墙', 'text': '守军（此生物不能攻击。）\\n延势（此生物能阻挡具飞行异能的生物。）', 'type': '生物 ～植物／墙', 'flavor': '藤蔓一如所有丛林植物，必须奋力挤出空间来争夺阳光。一旦保住了位置，它们便长得更韧，更尖锐，也更牢固。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449875&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '553cf1fa-d889-4c6c-982f-06f7654db8d6', 'multiverseId': 449875}, 'multiverseid': 449875}, {'name': '藤蔓牆', 'text': '守軍（此生物不能攻擊。）\\n延勢（此生物能阻擋具飛行異能的生物。）', 'type': '生物 ～植物／牆', 'flavor': '藤蔓一如所有叢林植物，必須奮力擠出空間來爭奪陽光。一旦保住了位置，他們便長得更韌，更尖銳，也更牢固。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450156&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '192f8c20-9268-4e33-9693-790e25d1debf', 'multiverseId': 450156}, 'multiverseid': 450156}]", "[{'name': 'Rankenross', 'text': 'Fluchsicher (Diese Kreatur kann nicht das Ziel von Zaubersprüchen oder Fähigkeiten sein, die deine Gegner kontrollieren.)\\nDas Rankenross kann von schwarzen Kreaturen nicht geblockt werden.', 'type': 'Kreatur — Elementarwesen, Pferd', 'flavor': 'Zieht es vorbei, werden die Toten durch blühendes Leben ersetzt.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447624&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2f4c3898-f80d-44a2-99b4-903d668d92be', 'multiverseId': 447624}, 'multiverseid': 447624}, {'name': 'Corcel de la hiedra', 'text': 'Antimaleficio. (Esta criatura no puede ser objetivo de hechizos o habilidades que controlan tus oponentes.)\\nEl Corcel de la hiedra no puede ser bloqueado por criaturas negras.', 'type': 'Criatura — Caballo elemental', 'flavor': 'Cuando pasa, florece la vida allá donde yacían los muertos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447905&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '8c43a293-6b60-4e45-a5a1-de0322a1d8c1', 'multiverseId': 447905}, 'multiverseid': 447905}, {'name': 'Jument des lianes', 'text': 'Défense talismanique (Cette créature ne peut pas être la cible de sorts ou de capacités que vos adversaires contrôlent.)\\nLa Jument des lianes ne peut pas être bloquée par des créatures noires.', 'type': 'Créature : élémental et cheval', 'flavor': 'Quand elle passe, les morts sont submergés par une vie florissante.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448186&type=card', 'language': 'French', 'identifiers': {'scryfallId': '08836e3c-91aa-499f-8e22-de03989743c4', 'multiverseId': 448186}, 'multiverseid': 448186}, {'name': 'Destriero dei Viticci', 'text': 'Anti-malocchio (Questa creatura non può essere bersaglio di magie o abilità controllate dai tuoi avversari.)\\nIl Destriero dei Viticci non può essere bloccato dalle creature nere.', 'type': 'Creatura — Cavallo Elementale', 'flavor': 'Al suo passaggio, i morti lasciano posto alla vita rigogliosa.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448467&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '7fd00374-8690-4f4c-9064-5daca1851639', 'multiverseId': 448467}, 'multiverseid': 448467}, {'name': '蔦草牝馬', 'text': '呪禁（このクリーチャーは、対戦相手がコントロールしている呪文や能力の対象にならない。）\\n蔦草牝馬は黒のクリーチャーによってはブロックされない。', 'type': 'クリーチャー — エレメンタル・馬', 'flavor': 'それが走り去るとき、死者は栄える命に代わる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448748&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '370558af-7c99-4c58-842b-bcb6aff20a85', 'multiverseId': 448748}, 'multiverseid': 448748}, {'name': '덩굴 암말', 'text': '방호 (이 생물은 상대가 조종하는 주문이나 능력의 목표로 정해질 수 없다.)\\n덩굴 암말은 흑색 생물에게 방어될 수 없다.', 'type': '생물 — 정령 말', 'flavor': '그것이 지나가면, 넘쳐흐르는 생명이 죽음을 지워낸다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449029&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '38c6518f-4353-48d8-85b2-b3f5f60b55ed', 'multiverseId': 449029}, 'multiverseid': 449029}, {'name': 'Égua das Lianas', 'text': 'Resistência a magia (Esta criatura não pode ser alvo de mágicas ou habilidades controladas por seus oponentes.)\\nÉgua das Lianas não pode ser bloqueada por criaturas pretas.', 'type': 'Criatura — Elemental Cavalo', 'flavor': 'Quando ela passa, a morte dá lugar à vida florescente.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449310&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1593ec6e-e5b5-4543-a738-b54f056f5122', 'multiverseId': 449310}, 'multiverseid': 449310}, {'name': 'Кобылица Лиан', 'text': 'Порчеустойчивость (Это существо не может быть целью заклинаний или способностей под контролем ваших оппонентов.)\\nКобылица Лиан не может быть заблокирована черными существами.', 'type': 'Существо — Элементаль Лошадь', 'flavor': 'Когда она скачет, цветущая жизнь заменяет собой смерть.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449591&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '58d5fc63-c158-4862-8376-621773f5e985', 'multiverseId': 449591}, 'multiverseid': 449591}, {'name': '藤蔓牝马', 'text': '辟邪（此生物不能成为由对手操控之咒语或异能的目标。）\\n藤蔓牝马不能被黑色生物阻挡。', 'type': '生物 ～元素／马', 'flavor': '所经之处，枯骨朽尸展新碧。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449872&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '01231e87-5035-437b-97ad-a64cd1a65431', 'multiverseId': 449872}, 'multiverseid': 449872}, {'name': '藤蔓牝馬', 'text': '辟邪（此生物不能成為由對手操控之咒語或異能的目標。）\\n藤蔓牝馬不能被黑色生物阻擋。', 'type': '生物 ～元素／馬', 'flavor': '所經之處，枯骨朽屍展新碧。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450153&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '3fe970af-4acd-4fda-a840-bc736b44ce99', 'multiverseId': 450153}, 'multiverseid': 450153}]", '[{\'name\': \'Reinigende Nova\', \'text\': \'Bestimme eines —\\n• Zerstöre alle Kreaturen.\\n• Zerstöre alle Artefakte und Verzauberungen.\', \'type\': \'Hexerei\', \'flavor\': \'Das Allerletzte, was die Dämonen erblickten, war Gnade in ihrer reinsten Form.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447426&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b9acb1b9-a72a-4be5-93c7-aa8700c202ca\', \'multiverseId\': 447426}, \'multiverseid\': 447426}, {\'name\': \'Nova purificadora\', \'text\': \'Elige uno:\\n• Destruye todas las criaturas.\\n• Destruye todos los artefactos y encantamientos.\', \'type\': \'Conjuro\', \'flavor\': \'En sus últimos instantes, los demonios presenciaron la gracia en su forma más pura.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447707&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d85cfa4f-0bbe-4624-b991-041f32881483\', \'multiverseId\': 447707}, \'multiverseid\': 447707}, {\'name\': \'Nova purificatrice\', \'text\': "Choisissez l\'un —\\n• Détruisez toutes les créatures.\\n• Détruisez tous les artefacts et tous les enchantements.", \'type\': \'Rituel\', \'flavor\': "Dans leurs derniers instants, les démons contemplèrent la grâce à l\'état pur.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447988&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d4cd2775-6c74-41c1-8eac-8d766817d5d0\', \'multiverseId\': 447988}, \'multiverseid\': 447988}, {\'name\': \'Nova Purificatrice\', \'text\': \'Scegli uno —\\n● Distruggi tutte le creature.\\n● Distruggi tutti gli artefatti e gli incantesimi.\', \'type\': \'Stregoneria\', \'flavor\': \'Negli ultimi momenti di vita, i demoni contemplarono la grazia nella sua forma più pura.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448269&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'72d603e2-b651-4209-b5de-031dc3c3c09b\', \'multiverseId\': 448269}, \'multiverseid\': 448269}, {\'name\': \'浄化の輝き\', \'text\': \'以下から１つを選ぶ。\\n• クリーチャーをすべて破壊する。\\n• アーティファクトとエンチャントをすべて破壊する。\', \'type\': \'ソーサリー\', \'flavor\': \'最期の瞬間、悪魔たちは恩寵の本来の姿を見上げていた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448550&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e5fe8fc1-5144-4552-aee6-ef3f8f7ed900\', \'multiverseId\': 448550}, \'multiverseid\': 448550}, {\'name\': \'정화하는 신성\', \'text\': \'하나를 선택한다 —\\n• 모든 생물을 파괴한다.\\n• 모든 마법물체와 부여마법을 파괴한다.\', \'type\': \'집중마법\', \'flavor\': \'최후의 순간에, 악마들은 순수한 모습으로 은총을 갈구했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448831&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0725f113-a426-4a61-8976-738885125473\', \'multiverseId\': 448831}, \'multiverseid\': 448831}, {\'name\': \'Nova Purificadora\', \'text\': \'Escolha um —\\n• Destrua todas as criaturas.\\n• Destrua todos os artefatos e encantamentos.\', \'type\': \'Feitiço\', \'flavor\': \'Nos momentos finais, os demônios contemplaram a graça em sua forma mais pura.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449112&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'69fc1eea-84fc-4dd2-85f2-b67243b14090\', \'multiverseId\': 449112}, \'multiverseid\': 449112}, {\'name\': \'Очистительная Вспышка\', \'text\': \'Выберите одно —\\n• Уничтожьте все существа.\\n• Уничтожьте все артефакты и чары.\', \'type\': \'Волшебство\', \'flavor\': \'В последние секунды жизни демоны узрели милосердие в его чистейшем виде.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449393&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'63d8fd1a-7d25-46ea-a394-17ef9fe374c8\', \'multiverseId\': 449393}, \'multiverseid\': 449393}, {\'name\': \'涤净散华\', \'text\': \'选择一项～\\n•消灭所有生物。\\n•消灭所有神器和结界。\', \'type\': \'法术\', \'flavor\': \'在生命的最后时刻，恶魔仰望天空，眼中只见至纯光辉。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449674&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2d2dfd9a-8d7d-48ec-9170-69aa1a3a5be0\', \'multiverseId\': 449674}, \'multiverseid\': 449674}, {\'name\': \'滌淨散華\', \'text\': \'選擇一項～\\n•消滅所有生物。\\n•消滅所有神器和結界。\', \'type\': \'巫術\', \'flavor\': \'在生命的最後時刻，惡魔仰望天空，眼中只見至純光輝。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449955&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ed8a17e3-3383-4ee8-b1a8-dfb2555e8311\', \'multiverseId\': 449955}, \'multiverseid\': 449955}]', '[{\'name\': \'Respektloser Pyromagier\', \'text\': \'{R}, {T}, wirf eine Karte ab: Ziehe eine Karte.\\n{2}{R}, {T}, opfere den Respektlosen Pyromagier: Er fügt einer Kreatur deiner Wahl 4 Schadenspunkte zu.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'„Verbrennen. Verbrennen. Behalten. Verbrennen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447553&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'33dbec65-666f-43e1-9d55-499d40931323\', \'multiverseId\': 447553}, \'multiverseid\': 447553}, {\'name\': \'Piromante desdeñoso\', \'text\': \'{R}, {T}, descartar una carta: Roba una carta.\\n{2}{R}, {T}, sacrificar el Piromante desdeñoso: Hace 4 puntos de daño a la criatura objetivo.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'"Quemar, quemar, salvar, quemar...".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447834&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cc5bdb75-1c56-4277-a531-672e60847454\', \'multiverseId\': 447834}, \'multiverseid\': 447834}, {\'name\': \'Pyromancien dédaigneux\', \'text\': "{R}, {T}, défaussez-vous d\'une carte : Piochez une carte.\\n{2}{R}, {T}, sacrifiez le Pyromancien dédaigneux : Il inflige 4 blessures à la créature ciblée.", \'type\': \'Créature : humain et sorcier\', \'flavor\': \'« On brûle. On brûle. On garde. On brûle. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448115&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'36540aad-7de8-4bb9-b5b1-be6bbe12d77d\', \'multiverseId\': 448115}, \'multiverseid\': 448115}, {\'name\': \'Piromante Presuntuoso\', \'text\': \'{R}, {T}, Scarta una carta: Pesca una carta.\\n{2}{R}, {T}, Sacrifica il Piromante Presuntuoso: Infligge 4 danni a una creatura bersaglio.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': \'"Lo brucio. Lo brucio. Lo tengo. Lo brucio."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448396&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b416ea40-3bfc-421b-a618-dac9263cfc7c\', \'multiverseId\': 448396}, \'multiverseid\': 448396}, {\'name\': \'放逐紅蓮術師\', \'text\': \'{R}, {T}, カード１枚を捨てる：カードを１枚引く。\\n{2}{R}, {T}, 放逐紅蓮術師を生け贄に捧げる：クリーチャー１体を対象とする。これはそれに４点のダメージを与える。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'「燃やす。燃やす。もらう。燃やす。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448677&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c0b0998e-8189-4982-ab63-b340d5385a0e\', \'multiverseId\': 448677}, \'multiverseid\': 448677}, {\'name\': \'거만한 화염술사\', \'text\': \'{R}. {T}, 카드 한 장을 버린다: 카드 한 장을 뽑는다.\\n{2}{R}, {T}, 거만한 화염술사를 희생한다: 생물을 목표로 정한다. 거만한 화염술사는 그 생물에게 피해 4점을 입힌다.\', \'type\': \'생물 — 인간 마법사\', \'flavor\': \'"불타라. 불타라. 계속. 불타라."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448958&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c340ec1d-d943-4b15-929b-7b9dbf30f557\', \'multiverseId\': 448958}, \'multiverseid\': 448958}, {\'name\': \'Piromante Desdenhoso\', \'text\': \'{R}, {T}, descarte um card: Compre um card.\\n{2}{R}, {T}, sacrifique Piromante Desdenhoso: Ele causa 4 pontos de dano à criatura alvo.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'"Queima. Queima. Guarda. Queima."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449239&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8edb90bb-9f5e-44c8-b368-aec7d680c9b5\', \'multiverseId\': 449239}, \'multiverseid\': 449239}, {\'name\': \'Пренебрежительный Пиромант\', \'text\': \'{R}, {T}, сбросьте карту: возьмите карту.\\n{2}{R}, {T}, пожертвуйте Пренебрежительного Пироманта: он наносит 4 повреждения целевому существу.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'«Сжечь. Сжечь. Оставить. Сжечь».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449520&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0bc9f451-c62a-4354-90c7-ab7aec885467\', \'multiverseId\': 449520}, \'multiverseid\': 449520}, {\'name\': \'高傲烈焰术士\', \'text\': \'{R}，{T}，弃一张牌：抓一张牌。\\n{2}{R}，{T}，牺牲高傲烈焰术士：它对目标生物造成4点伤害。\', \'type\': \'生物 ～人类／法术师\', \'flavor\': \'「烧掉。烧掉。留下。烧掉。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449801&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ecd5195d-d0eb-44cc-bf73-50fff5c00def\', \'multiverseId\': 449801}, \'multiverseid\': 449801}, {\'name\': \'高傲烈焰術士\', \'text\': \'{R}，{T}，棄一張牌：抽一張牌。\\n{2}{R}，{T}，犧牲高傲烈焰術士：它對目標生物造成4點傷害。\', \'type\': \'生物 ～人類／魔法師\', \'flavor\': \'「燒掉。燒掉。留下。燒掉。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450082&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ad52fec7-ea3f-4ee6-ae11-bf88f5939531\', \'multiverseId\': 450082}, \'multiverseid\': 450082}]', '[{\'name\': \'Reumütiger Kleriker\', \'text\': \'Fliegend\\nOpfere den Reumütigen Kleriker: Schicke alle Karten aus dem Friedhof eines Spielers deiner Wahl ins Exil.\', \'type\': \'Kreatur — Geist, Kleriker\', \'flavor\': \'Zu Lebzeiten eine Fassade aufrechtzuerhalten genügt nicht, um ewigen Frieden zu finden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447450&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fc76687e-c128-43e8-8a2d-d334f6374131\', \'multiverseId\': 447450}, \'multiverseid\': 447450}, {\'name\': \'Clérigo arrepentido\', \'text\': \'Vuela.\\nSacrificar el Clérigo arrepentido: Exilia todas las cartas del cementerio del jugador objetivo.\', \'type\': \'Criatura — Clérigo espíritu\', \'flavor\': \'Una vida entera dedicada a mantener las apariencias no basta para ganarse el descanso eterno.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447731&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7d14d911-2cc4-490f-b3b7-8b34e9d5e0b1\', \'multiverseId\': 447731}, \'multiverseid\': 447731}, {\'name\': \'Clerc pénitent\', \'text\': \'Vol\\nSacrifiez le Clerc pénitent : Exilez toutes les cartes du cimetière du joueur ciblé.\', \'type\': \'Créature : esprit et clerc\', \'flavor\': "Une vie passée à sauver les apparences ne suffit pas pour mériter le repos pour l\'éternité.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448012&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7cfcf5c4-fd27-40e7-8cd7-55d1bdceb95d\', \'multiverseId\': 448012}, \'multiverseid\': 448012}, {\'name\': \'Chierico Contrito\', \'text\': \'Volare\\nSacrifica il Chierico Contrito: Esilia tutte le carte dal cimitero di un giocatore bersaglio.\', \'type\': \'Creatura — Chierico Spirito\', \'flavor\': \'Non basta una vita trascorsa a salvare le apparenze per meritarsi il riposo eterno.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448293&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8ca1fafd-02c9-437c-af84-92169e5428b9\', \'multiverseId\': 448293}, \'multiverseid\': 448293}, {\'name\': \'悔恨する僧侶\', \'text\': \'飛行\\n悔恨する僧侶を生け贄に捧げる：プレイヤー１人を対象とし、そのプレイヤーの墓地からカードをすべて追放する。\', \'type\': \'クリーチャー — スピリット・クレリック\', \'flavor\': \'生涯を通じて世間体を保っても、永遠の休息を得るには十分でない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448574&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2fc22176-b173-4732-9d15-54537fe50dd4\', \'multiverseId\': 448574}, \'multiverseid\': 448574}, {\'name\': \'뉘우치는 성직자\', \'text\': \'비행\\n뉘우치는 성직자를 희생한다: 플레이어를 목표로 정한다. 그 플레이어의 무덤에 있는 모든 카드를 추방한다.\', \'type\': \'생물 — 신령 성직자\', \'flavor\': \'일생 동안 외모를 가꿔도 영원의 휴식을 얻기엔 충분치 않다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448855&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'27fec36b-6caa-4127-93fb-519a47a0edc0\', \'multiverseId\': 448855}, \'multiverseid\': 448855}, {\'name\': \'Clérigo Arrependido\', \'text\': \'Voar\\nSacrifique Clérigo Arrependido: Exile todos os cards do cemitério do jogador alvo.\', \'type\': \'Criatura — Espírito Clérigo\', \'flavor\': \'Uma vida de aparências não é suficiente para garantir uma eternidade de descanso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449136&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'11e3b029-cac4-47c0-8815-25f47619b090\', \'multiverseId\': 449136}, \'multiverseid\': 449136}, {\'name\': \'Раскаявшийся Священник\', \'text\': \'Полет\\nПожертвуйте Раскаявшегося Священника: изгоните все карты из кладбища целевого игрока.\', \'type\': \'Существо — Дух Священник\', \'flavor\': \'Он всю свою жизнь притворялся, но оказалось, что этого недостаточно для вечного покоя.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449417&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'35c45e2b-9740-4acd-9c9c-ef2833e27f54\', \'multiverseId\': 449417}, \'multiverseid\': 449417}, {\'name\': \'悔恨僧侣\', \'text\': \'飞行\\n牺牲悔恨僧侣：放逐目标牌手坟墓场中的所有牌。\', \'type\': \'生物 ～精怪／僧侣\', \'flavor\': \'假意奉供一生也换不来永世安息。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449698&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'74aafa99-d09b-4cdf-84b4-4ea6fc4eaad7\', \'multiverseId\': 449698}, \'multiverseid\': 449698}, {\'name\': \'悔恨僧侶\', \'text\': \'飛行\\n犧牲悔恨僧侶：放逐目標玩家墳墓場中的所有牌。\', \'type\': \'生物 ～精靈／僧侶\', \'flavor\': \'假意奉供一生也換不來永世安息。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449979&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3547b876-7b97-4869-9cce-7c61b06a04a6\', \'multiverseId\': 449979}, \'multiverseid\': 449979}]', '[{\'name\': \'Revitalisieren\', \'text\': \'Du erhältst 3 Lebenspunkte dazu.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ein Heiltrank ist kein Ersatz für einen Medikus, aber fürs Erste hält er deine Innereien an Ort und Stelle."\\n—Torricks, Frontmedikus\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447452&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9b38df8e-3dcf-4dbc-b8ae-4828aea8511d\', \'multiverseId\': 447452}, \'multiverseid\': 447452}, {\'name\': \'Revivificar\', \'text\': \'Ganas 3 vidas.\\nRoba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'"La poción no sustituye la labor de un buen cirujano, pero evitará que se te salgan las tripas".\\n—Torricks, médico de guerra\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447733&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a20d8f89-ecc6-48b3-9d93-38b97fa2c200\', \'multiverseId\': 447733}, \'multiverseid\': 447733}, {\'name\': \'Revitaliser\', \'text\': \'Vous gagnez 3 points de vie.\\nPiochez une carte.\', \'type\': \'Éphémère\', \'flavor\': \'« Une potion ne vaut pas un bon chirurgien, mais ça retient les morceaux. »\\n—Torricks, carabin de campagne\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448014&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'89bb189c-4764-4b62-9684-fa5c26ad2140\', \'multiverseId\': 448014}, \'multiverseid\': 448014}, {\'name\': \'Rivitalizzare\', \'text\': \'Guadagni 3 punti vita.\\nPesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'"Una pozione non può sostituire un abile chirurgo, ma tiene insieme i pezzi."\\n—Torricks, medico da campo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448295&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'db3c28ec-4191-4e45-a0fc-5f8bc6551c40\', \'multiverseId\': 448295}, \'multiverseid\': 448295}, {\'name\': \'活力回復\', \'text\': \'あなたは３点のライフを得る。\\nカードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': \'薬は腕利きの医師の代わりにはならないが、臓器をとどめておくことはできる。\\n――戦場の衛生兵、トリックス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448576&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dfc66a92-b43b-49cb-b461-7a2c2cbe78d4\', \'multiverseId\': 448576}, \'multiverseid\': 448576}, {\'name\': \'재활\', \'text\': \'당신은 생명 3점을 얻는다.\\n카드 한 장을 뽑는다.\', \'type\': \'순간마법\', \'flavor\': \'"물약이 솜씨 좋은 의사만은 못하겠지만, 견디게는 해 줄 걸세."\\n—전투 치유사, 토릭스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448857&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'98477609-3b14-4ced-a9b3-515975cadbbd\', \'multiverseId\': 448857}, \'multiverseid\': 448857}, {\'name\': \'Revitalizar\', \'text\': \'Você ganha 3 pontos de vida.\\nCompre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Uma poção não substitui um bom cirurgião, mas mantém os pedaços no lugar."\\n— Torricks, socorrista do campo de batalha\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449138&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'189a1555-f423-45a7-b660-f2a552a19699\', \'multiverseId\': 449138}, \'multiverseid\': 449138}, {\'name\': \'Восстановление Сил\', \'text\': \'Вы получаете 3 жизни.\\nВозьмите карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Зелье не заменит умелого хирурга, но у тебя хотя бы кишки не вывалятся».\\n— Торрикс, полевой медик\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449419&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'25832c97-68c9-48fe-aaf5-788da858427a\', \'multiverseId\': 449419}, \'multiverseid\': 449419}, {\'name\': \'再现活力\', \'text\': \'你获得3点生命。\\n抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'「药水虽代替不了妙手回春的医士，但好歹能堵上你的伤口。」\\n～战场医护员托瑞克\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449700&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3bfca64f-7070-4b79-9a8d-060172f22a77\', \'multiverseId\': 449700}, \'multiverseid\': 449700}, {\'name\': \'再現活力\', \'text\': \'你獲得3點生命。\\n抽一張牌。\', \'type\': \'瞬間\', \'flavor\': \'「藥水雖代替不了妙手回春的醫士，但好歹能堵上你的傷口。」\\n～戰場醫護員托瑞克\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449981&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'50874479-6ddb-4f93-9f44-26b1fb990ba4\', \'multiverseId\': 449981}, \'multiverseid\': 449981}]', '[{\'name\': \'Rhox-Orakel\', \'text\': \'Wenn das Rhox-Orakel ins Spiel kommt, ziehe eine Karte.\', \'type\': \'Kreatur — Nashorn, Mönch\', \'flavor\': \'„Je weiter ich in die Zukunft blicke, desto schemenhafter werden die Bilder. Selbst jetzt ist auf mittlerer Strecke alles vom Feuer verzerrt."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447615&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'871169f7-0723-4253-97e1-2bf94009240a\', \'multiverseId\': 447615}, \'multiverseid\': 447615}, {\'name\': \'Oráculo rhox\', \'text\': \'Cuando el Oráculo rhox entre al campo de batalla, roba una carta.\', \'type\': \'Criatura — Monje rinoceronte\', \'flavor\': \'"Cuanto más lejano es el futuro que escruto, más borrosa se hace la visión. Incluso ahora, el fuego oscurece las medias distancias".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447896&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f3a1b000-83c8-44de-9dd9-7b0e6f33180e\', \'multiverseId\': 447896}, \'multiverseid\': 447896}, {\'name\': \'Oracle rhox\', \'text\': "Quand l\'Oracle rhox arrive sur le champ de bataille, piochez une carte.", \'type\': \'Créature : rhinocéros et moine\', \'flavor\': "« Plus loin je regarde dans l\'avenir, moins je suis certain de ce que je vois. Aujourd\'hui encore, le moyen terme est obscurci par le feu. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448177&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'28b675ea-3450-4f3d-ab36-85033cd4b934\', \'multiverseId\': 448177}, \'multiverseid\': 448177}, {\'name\': \'Oracolo Rhox\', \'text\': "Quando l\'Oracolo Rhox entra nel campo di battaglia, pesca una carta.", \'type\': \'Creatura — Monaco Rinoceronte\', \'flavor\': \'"Più il mio sguardo si addentra nel futuro, più incerta è la mia visione. Persino ora, la media distanza è oscurata dal fuoco."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448458&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cb4c2f71-58ab-4781-a89c-4ce8185791d0\', \'multiverseId\': 448458}, \'multiverseid\': 448458}, {\'name\': \'ロウクスの神託者\', \'text\': \'ロウクスの神託者が戦場に出たとき、カードを１枚引く。\', \'type\': \'クリーチャー — サイ・モンク\', \'flavor\': \'「先の未来を見るほど、視界が不確かになる。今も、炎が間を遮っている。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448739&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dc3a16d4-25ab-422e-998d-4116177427d5\', \'multiverseId\': 448739}, \'multiverseid\': 448739}, {\'name\': \'록스 예언자\', \'text\': \'록스 예언자가 전장에 들어올 때, 카드 한 장을 뽑는다.\', \'type\': \'생물 — 코뿔소 승려\', \'flavor\': \'"미래를 더 자세히 들여다 볼 수록, 내 환상은 더 불확실해진다. 심지어 지금도, 중간은 불길로 가로막혀 있다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449020&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d74bfd86-03c3-462d-84dc-08b2bba96067\', \'multiverseId\': 449020}, \'multiverseid\': 449020}, {\'name\': \'Oráculo de Rhox\', \'text\': \'Quando Oráculo de Rhox entrar no campo de batalha, compre um card.\', \'type\': \'Criatura — Rinoceronte Monge\', \'flavor\': \'"Quanto mais adiante perscruto o futuro, menos certa é minha visão. Neste momento, mesmo o médio prazo se oculta em chamas."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449301&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8cbbe8f8-ead5-4fa0-8c05-e82d3a8485e0\', \'multiverseId\': 449301}, \'multiverseid\': 449301}, {\'name\': \'Рокс-Оракул\', \'text\': \'Когда Рокс-Оракул выходит на поле битвы, возьмите карту.\', \'type\': \'Существо — Носорог Монах\', \'flavor\': \'«Чем дальше я заглядываю в будущее, тем туманнее становятся видения. Даже сейчас на среднем расстоянии все застит огонь».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449582&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c89ad505-e6e8-4b05-bb37-438fc0a0d037\', \'multiverseId\': 449582}, \'multiverseid\': 449582}, {\'name\': \'罗克先知\', \'text\': \'当罗克先知进战场时，抓一张牌。\', \'type\': \'生物 ～犀牛／修行僧\', \'flavor\': \'「我望向未来，看得越远，我的预示就越难确定。即使是现在，中间不远处也因火焰而变得模糊不清。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449863&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'db3364d3-5479-44f4-a080-d46b53d9ae4f\', \'multiverseId\': 449863}, \'multiverseid\': 449863}, {\'name\': \'羅克先知\', \'text\': \'當羅克先知進戰場時，抽一張牌。\', \'type\': \'生物 ～犀牛／修行僧\', \'flavor\': \'「我望向未來，看得越遠，我的預示就越難確定。即使是現在，中間不遠處也因火焰而變得模糊不清。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450144&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'46a6165a-9712-47e6-baeb-4a13ff66eb97\', \'multiverseId\': 450144}, \'multiverseid\': 450144}]', '[{\'name\': \'Riesenspinne\', \'text\': \'Reichweite (Diese Kreatur kann fliegende Kreaturen blocken.)\', \'type\': \'Kreatur — Spinne\', \'flavor\': \'„Nach allem, was ich schon überlebt habe, ist es schwer, sich noch vor irgendetwas zu fürchten."\\n—Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447600&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'92003ba1-8263-4094-9f96-22ca3b0e4a8a\', \'multiverseId\': 447600}, \'multiverseid\': 447600}, {\'name\': \'Araña gigante\', \'text\': \'Alcance. (Esta criatura puede bloquear a criaturas con la habilidad de volar.)\', \'type\': \'Criatura — Araña\', \'flavor\': \'"Después de todo a lo que sobreviví, poco me asusta ya".\\n—Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447881&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'063370ec-22c2-4081-a429-a0d075278d4e\', \'multiverseId\': 447881}, \'multiverseid\': 447881}, {\'name\': \'Araignée géante\', \'text\': \'Portée (Cette créature peut bloquer les créatures avec le vol.)\', \'type\': \'Créature : araignée\', \'flavor\': "« Après tout ce à quoi j\'ai survécu, plus grand chose ne me fait peur. »\\n—Vivien Reid", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448162&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'26368db3-140d-4ce8-83d3-4c237db55173\', \'multiverseId\': 448162}, \'multiverseid\': 448162}, {\'name\': \'Ragno Gigante\', \'text\': \'Raggiungere (Questa creatura può bloccare le creature con volare.)\', \'type\': \'Creatura — Ragno\', \'flavor\': \'"Con tutto quello che ho passato, è difficile che qualcosa mi spaventi."\\n—Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448443&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4c216c3a-ced5-44c3-9830-f9326c525213\', \'multiverseId\': 448443}, \'multiverseid\': 448443}, {\'name\': \'大蜘蛛\', \'text\': \'到達（このクリーチャーで飛行を持つクリーチャーをブロックできる。）\', \'type\': \'クリーチャー — 蜘蛛\', \'flavor\': \'「これまで生き残ってきた経験から、もう何も怖いと思えなくなったわ。」\\n――ビビアン・リード\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448724&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a7f6456d-deb2-4d99-8e9a-a065f330b081\', \'multiverseId\': 448724}, \'multiverseid\': 448724}, {\'name\': \'거대한 거미\', \'text\': \'대공 (이 생물은 비행을 가진 생물을 방어할 수 있다.)\', \'type\': \'생물 — 거미\', \'flavor\': \'"여태까지 다양한 것들로부터 살아남은 덕에, 이제는 뭘 봐도 겁에 질리는 게 힘들군."\\n—비비안 레이드\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449005&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'54e67aa0-8e6f-4e9f-8fde-59f32cae84e5\', \'multiverseId\': 449005}, \'multiverseid\': 449005}, {\'name\': \'Aranha Gigante\', \'text\': \'Alcance (Esta criatura pode bloquear criaturas com voar.)\', \'type\': \'Criatura — Aranha\', \'flavor\': \'"Depois de tudo a que eu sobrevivi, hoje em dia é difícil me assustar com o que quer que seja."\\n— Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449286&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'afe8c958-431f-4aa5-ad50-54ca96565932\', \'multiverseId\': 449286}, \'multiverseid\': 449286}, {\'name\': \'Гигантский Паук\', \'text\': \'Захват (Это существо может блокировать существа с Полетом.)\', \'type\': \'Существо — Паук\', \'flavor\': \'«После всего того, что я пережила, мне уже трудно хоть чего-то испугаться».\\n— Вивьен Рейд\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449567&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'39abe9cb-48db-443b-affd-67236e66b6b3\', \'multiverseId\': 449567}, \'multiverseid\': 449567}, {\'name\': \'巨型蜘蛛\', \'text\': \'延势（此生物能阻挡具飞行异能的生物。）\', \'type\': \'生物 ～蜘蛛\', \'flavor\': \'「经过种种历难之后，再也没有什么东西能吓到我了。」\\n～薇薇安瑞德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449848&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'67e9ac87-a058-4a55-b0fc-27d55350165c\', \'multiverseId\': 449848}, \'multiverseid\': 449848}, {\'name\': \'巨型蜘蛛\', \'text\': \'延勢（此生物能阻擋具飛行異能的生物。）\', \'type\': \'生物 ～蜘蛛\', \'flavor\': \'「經過種種歷難之後，再也沒有什麼東西能嚇到我了。」\\n～薇薇安瑞德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450129&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4ba2c9a5-a32f-4878-bf9e-0f77de8adf0f\', \'multiverseId\': 450129}, \'multiverseid\': 450129}]', '[{\'name\': \'Ritterehre\', \'text\': \'Verzaubert eine Kreatur\\nWenn die Ritterehre ins Spiel kommt, erzeuge einen 2/2 weißen Ritter-Kreaturenspielstein mit Wachsamkeit. (Er wird beim Angreifen nicht getappt.)\\nDie verzauberte Kreatur erhält +2/+2 und hat Wachsamkeit.\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447437&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ad49ce99-cb28-4f5a-bdf7-73f3dbe6e0ce\', \'multiverseId\': 447437}, \'multiverseid\': 447437}, {\'name\': \'Valor de caballero\', \'text\': \'Encantar criatura.\\nCuando el Valor de caballero entre al campo de batalla, crea una ficha de criatura Caballero blanca 2/2 con la habilidad de vigilancia. (Esta criatura no se gira al atacar.)\\nLa criatura encantada obtiene +2/+2 y tiene la habilidad de vigilancia.\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447718&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b6976aab-2c01-40e9-ad8f-fc8c4163b8dc\', \'multiverseId\': 447718}, \'multiverseid\': 447718}, {\'name\': \'Valeur chevaleresque\', \'text\': "Enchanter : créature\\nQuand la Valeur chevaleresque arrive sur le champ de bataille, créez un jeton de créature 2/2 blanche Chevalier avec la vigilance. (Attaquer avec cette créature ne la fait pas s\'engager.)\\nLa créature enchantée gagne +2/+2 et a la vigilance.", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447999&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a6d05394-8719-4367-aa5f-ec8a67f447bb\', \'multiverseId\': 447999}, \'multiverseid\': 447999}, {\'name\': \'Valore Cavalleresco\', \'text\': \'Incanta creatura\\nQuando il Valore Cavalleresco entra nel campo di battaglia, crea una pedina creatura Cavaliere 2/2 bianca con cautela. (Attacca senza TAPpare.)\\nLa creatura incantata prende +2/+2 e ha cautela.\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448280&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ba66b50a-2e49-455d-ab56-7e37596a72ce\', \'multiverseId\': 448280}, \'multiverseid\': 448280}, {\'name\': \'騎士の勇気\', \'text\': \'エンチャント（クリーチャー）\\n騎士の勇気が戦場に出たとき、警戒を持つ白の２/２の騎士・クリーチャー・トークンを１体生成する。（それは攻撃してもタップしない。）\\nエンチャントされているクリーチャーは＋２/＋２の修整を受け、警戒を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448561&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'33d2504d-2b1f-4209-a46d-0cd0c521ce00\', \'multiverseId\': 448561}, \'multiverseid\': 448561}, {\'name\': \'기사의 용감함\', \'text\': \'생물에게 부여\\n기사의 용감함이 전장에 들어올 때, 경계를 가진 2/2 백색 기사 생물 토큰 한 개를 만든다. (그 생물은 공격하면서 탭되지 않는다.)\\n부여된 생물은 +2/+2를 받고 경계를 가진다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448842&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'806ddc57-21bb-4201-84e8-87007b799dab\', \'multiverseId\': 448842}, \'multiverseid\': 448842}, {\'name\': \'Heroísmo Cavaleiroso\', \'text\': \'Encantar criatura\\nQuando Heroísmo Cavaleiroso entrar no campo de batalha, crie uma ficha de criatura branca 2/2 do tipo Cavaleiro com vigilância. (Ela não é virada para atacar.)\\nA criatura encantada recebe +2/+2 e tem vigilância.\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449123&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'142742c1-a63c-4cef-8c83-b269a713b890\', \'multiverseId\': 449123}, \'multiverseid\': 449123}, {\'name\': \'Рыцарская Доблесть\', \'text\': \'Зачаровать существо\\nКогда Рыцарская Доблесть выходит на поле битвы, создайте одну фишку существа 2/2 белый Рыцарь с Бдительностью. (Атакуя, это существо не поворачивается.)\\nЗачарованное существо получает +2/+2 и имеет Бдительность.\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449404&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a9001fd1-e909-4fb3-9c2c-400f84986781\', \'multiverseId\': 449404}, \'multiverseid\': 449404}, {\'name\': \'骑士骁勇\', \'text\': \'结附于生物\\n当骑士骁勇进战场时，派出一个2/2白色，具警戒异能的骑士衍生生物。（它攻击时不需横置。）\\n所结附的生物得+2/+2且具有警戒异能。\', \'type\': \'结界 ～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449685&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4feda0a5-1fe4-4f90-a61e-7ff78cf27e68\', \'multiverseId\': 449685}, \'multiverseid\': 449685}, {\'name\': \'騎士驍勇\', \'text\': \'結附於生物\\n當騎士驍勇進戰場時，派出一個2/2白色，具警戒異能的騎士衍生生物。（它攻擊時不需橫置。）\\n所結附的生物得+2/+2且具有警戒異能。\', \'type\': \'結界 ～靈氣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449966&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f793894e-467d-4e7c-ac1c-616d798f99f8\', \'multiverseId\': 449966}, \'multiverseid\': 449966}]', '[{\'name\': \'Ritterliche Kavallerie\', \'text\': \'Wachsamkeit (Diese Kreatur wird beim Angreifen nicht getappt.)\\nWenn die Ritterliche Kavallerie ins Spiel kommt, erzeuge einen 2/2 weißen Ritter-Kreaturenspielstein mit Wachsamkeit.\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': \'„Unsere Pflicht endet nicht an unseren Grenzen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447429&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e3e743ca-b214-4566-8a7b-369262b36734\', \'multiverseId\': 447429}, \'multiverseid\': 447429}, {\'name\': \'Caballería intrépida\', \'text\': \'Vigilancia. (Esta criatura no se gira al atacar.)\\nCuando la Caballería intrépida entre al campo de batalla, crea una ficha de criatura Caballero blanca 2/2 con la habilidad de vigilancia.\', \'type\': \'Criatura — Caballero humano\', \'flavor\': \'"Nuestro deber no se ciñe a lo que está dentro de nuestras fronteras".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447710&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bcfc7d93-1c2b-4ff6-b984-afb5c388aa33\', \'multiverseId\': 447710}, \'multiverseid\': 447710}, {\'name\': \'Cavalerie vaillante\', \'text\': "Vigilance (Attaquer avec cette créature ne la fait pas s\'engager.)\\nQuand la Cavalerie vaillante arrive sur le champ de bataille, créez un jeton de créature 2/2 blanche Chevalier avec la vigilance.", \'type\': \'Créature : humain et chevalier\', \'flavor\': "« Notre devoir ne s\'arrête pas à nos frontières. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447991&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3e161042-aa71-4953-9b62-e43ff75dc503\', \'multiverseId\': 447991}, \'multiverseid\': 447991}, {\'name\': \'Cavalleria Intrepida\', \'text\': \'Cautela (Questa creatura attacca senza TAPpare.)\\nQuando la Cavalleria Intrepida entra nel campo di battaglia, crea una pedina creatura Cavaliere 2/2 bianca con cautela.\', \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': \'"I nostri doveri non conoscono frontiere."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448272&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'63e0466d-aed1-412d-83a5-0dfd5d3638b5\', \'multiverseId\': 448272}, \'multiverseid\': 448272}, {\'name\': \'凛々しい騎兵隊\', \'text\': \'警戒（このクリーチャーは攻撃してもタップしない。）\\n凛々しい騎兵隊が戦場に出たとき、警戒を持つ白の２/２の騎士・クリーチャー・トークンを１体生成する。\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': \'「我々の任務は国境で止まらない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448553&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2adfffbc-6903-4374-96fd-c89e6f548098\', \'multiverseId\': 448553}, \'multiverseid\': 448553}, {\'name\': \'용맹한 기병대\', \'text\': \'경계 (이 생물은 공격하면서 탭되지 않는다.)\\n용맹한 기병대가 전장에 들어올 때, 경계를 가진 2/2 백색 기사 생물 토큰 한 개를 만든다.\', \'type\': \'생물 — 인간 기사\', \'flavor\': \'"우리의 임무는 국경 안쪽으로 국한되지 않는다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448834&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'23e53e04-c207-43cb-a8ee-9cb388935676\', \'multiverseId\': 448834}, \'multiverseid\': 448834}, {\'name\': \'Cavalaria Galante\', \'text\': \'Vigilância (Esta criatura não é virada para atacar.)\\nQuando Cavalaria Galante entrar no campo de batalha, crie uma ficha de criatura branca 2/2 do tipo Cavaleiro com vigilância.\', \'type\': \'Criatura — Humano Cavaleiro\', \'flavor\': \'"Nosso dever não termina em nossas fronteiras."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449115&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b06c3d37-16a0-4ec6-ab28-95116613c1d2\', \'multiverseId\': 449115}, \'multiverseid\': 449115}, {\'name\': \'Доблестная Кавалерия\', \'text\': \'Бдительность (Атакуя, это существо не поворачивается.)\\nКогда Доблестная Кавалерия выходит на поле битвы, создайте одну фишку существа 2/2 белый Рыцарь с Бдительностью.\', \'type\': \'Существо — Человек Рыцарь\', \'flavor\': \'«Наш долг простирается дальше, чем наши границы».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449396&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5ae6bad3-4781-4921-9ff9-42f06b32872f\', \'multiverseId\': 449396}, \'multiverseid\': 449396}, {\'name\': \'华铠骑兵\', \'text\': \'警戒（此生物攻击时不需横置。）\\n当华铠骑兵进战场时，派出一个2/2白色，具警戒异能的骑士衍生生物。\', \'type\': \'生物 ～人类／骑士\', \'flavor\': \'「我们的职责不只是守卫边境。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449677&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'20014e0e-04dd-441a-b7a4-1ff4476884f8\', \'multiverseId\': 449677}, \'multiverseid\': 449677}, {\'name\': \'華鎧騎兵\', \'text\': \'警戒（此生物攻擊時不需橫置。）\\n當華鎧騎兵進戰場時，派出一個2/2白色，具警戒異能的騎士衍生生物。\', \'type\': \'生物 ～人類／騎士\', \'flavor\': \'「我們的職責不只是守衛邊境。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449958&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'66e71ed1-bec9-4987-99d3-aee76e2dbc5c\', \'multiverseId\': 449958}, \'multiverseid\': 449958}]', '[{\'name\': \'Ritterlicher Schwur\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur erhält +2/+2.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Solange mein Glaube fortbesteht, werde auch ich fortbestehen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447436&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'75ca2fdc-34e8-445e-b449-bbdb2a4776e4\', \'multiverseId\': 447436}, \'multiverseid\': 447436}, {\'name\': \'Juramento de caballero\', \'text\': \'Encantar criatura.\\nLa criatura encantada obtiene +2/+2.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"Mientras la fe me acompañe, seguiré adelante".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447717&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'83e63446-64ef-4b44-914f-bf2298909e63\', \'multiverseId\': 447717}, \'multiverseid\': 447717}, {\'name\': \'Promesse de la chevalière\', \'text\': \'Enchanter : créature\\nLa créature enchantée gagne +2/+2.\', \'type\': \'Enchantement : aura\', \'flavor\': \'« Tant que ma foi sera inébranlable, je le serai aussi. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447998&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'43884105-84a2-4d5e-aca7-f0d7cb541934\', \'multiverseId\': 447998}, \'multiverseid\': 447998}, {\'name\': \'Promessa della Cavaliera\', \'text\': \'Incanta creatura\\nLa creatura incantata prende +2/+2.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Finché la mia fede persiste, io farò altrettanto."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448279&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4b7c617f-4371-4860-a50f-9e55fdcae9a7\', \'multiverseId\': 448279}, \'multiverseid\': 448279}, {\'name\': \'騎士の誓約\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは＋２/＋２の修整を受ける。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「信念の続くかぎり、私も進もう。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448560&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6fb8d1a7-530a-4035-a82c-4c3cb825b402\', \'multiverseId\': 448560}, \'multiverseid\': 448560}, {\'name\': \'기사의 약속\', \'text\': \'생물에게 부여\\n부여된 생물은 +2/+2를 받는다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'"내 믿음이 남아 있는 한, 나도 그러하리라."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448841&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'83ab1cce-602e-4a8c-a831-6bd8bb6091ae\', \'multiverseId\': 448841}, \'multiverseid\': 448841}, {\'name\': \'Juramento da Cavaleira\', \'text\': \'Encantar criatura\\nA criatura encantada recebe +2/+2.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Enquanto minha fé perdurar, eu combaterei."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449122&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'afc19b28-d9f2-433f-aae7-0e865ebfc669\', \'multiverseId\': 449122}, \'multiverseid\': 449122}, {\'name\': \'Рыцарский Обет\', \'text\': \'Зачаровать существо\\nЗачарованное существо получает +2/+2.\', \'type\': \'Чары — Аура\', \'flavor\': \'«Пока не гаснет моя вера, я не отступлю».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449403&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'57783280-f3d5-414e-a9fb-8716ceb0111d\', \'multiverseId\': 449403}, \'multiverseid\': 449403}, {\'name\': \'骑士誓言\', \'text\': \'结附于生物\\n所结附的生物得+2/+2。\', \'type\': \'结界 ～灵气\', \'flavor\': \'「抱持坚定信念，便能屹立不摇。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449684&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0772f8fb-c5af-443a-a282-90d081c2c92e\', \'multiverseId\': 449684}, \'multiverseid\': 449684}, {\'name\': \'騎士誓言\', \'text\': \'結附於生物\\n所結附的生物得+2/+2。\', \'type\': \'結界 ～靈氣\', \'flavor\': \'「抱持堅定信念，便能屹立不搖。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449965&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4d0781af-fe5f-4031-8603-63c9f39c5b2f\', \'multiverseId\': 449965}, \'multiverseid\': 449965}]', '[{\'name\': \'Ritternovize\', \'text\': \'Verteidiger (Diese Kreatur kann nicht angreifen.)\\nSolange der Ritternovize verzaubert oder ausgerüstet ist, kann er angreifen, als ob er nicht Verteidiger hätte.\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': \'Selbst der größte Held fängt klein an.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447447&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d9a6374d-97b7-47e3-b63f-40a94f106441\', \'multiverseId\': 447447}, \'multiverseid\': 447447}, {\'name\': \'Caballero principiante\', \'text\': \'Defensor. (Esta criatura no puede atacar.)\\nMientras la Caballero principiante esté encantada o equipada, puede atacar como si no tuviera la habilidad de defensor.\', \'type\': \'Criatura — Caballero humano\', \'flavor\': \'Hasta la heroína más grande comienza de cero.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447728&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7408214c-d2ba-4efe-b893-6f25c17ac0e8\', \'multiverseId\': 447728}, \'multiverseid\': 447728}, {\'name\': \'Chevalier novice\', \'text\': "Défenseur (Cette créature ne peut pas attaquer).\\nTant que le Chevalier novice est enchanté ou équipé, il peut attaquer comme s\'il n\'avait pas le défenseur.", \'type\': \'Créature : humain et chevalier\', \'flavor\': \'Même les plus grands héros commencent avec rien.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448009&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8f4d33ec-809e-42a7-9006-0c92d8f91146\', \'multiverseId\': 448009}, \'multiverseid\': 448009}, {\'name\': \'Cavaliere Novizio\', \'text\': \'Difensore (Questa creatura non può attaccare.)\\nFintanto che il Cavaliere Novizio è incantato o equipaggiato, può attaccare come se non avesse difensore.\', \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': \'Persino il più grande degli eroi comincia da zero.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448290&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e9ce6b97-0120-41d6-9ed2-e531615ed972\', \'multiverseId\': 448290}, \'multiverseid\': 448290}, {\'name\': \'新米騎士\', \'text\': \'防衛（このクリーチャーでは攻撃できない。）\\n新米騎士がエンチャントされているか装備しているかぎり、これは防衛を持たないかのように攻撃できる。\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': \'最も偉大な英雄も最初は無名だった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448571&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'26c6baab-b0f6-4805-86a4-c1e6014e9f30\', \'multiverseId\': 448571}, \'multiverseid\': 448571}, {\'name\': \'견습 기사\', \'text\': \'수비태세 (이 생물은 공격할 수 없다.)\\n견습 기사가 부여되거나 장착된 한, 견습 기사는 수비태세가 없는 것처럼 공격할 수 있다.\', \'type\': \'생물 — 인간 기사\', \'flavor\': \'위대한 영웅조차도 처음에는 빈 손부터 시작한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448852&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'71f84996-53cc-4f70-976c-674d575a292f\', \'multiverseId\': 448852}, \'multiverseid\': 448852}, {\'name\': \'Cavaleiro Novato\', \'text\': \'Defensor (Esta criatura não pode atacar.)\\nEnquanto Cavaleiro Novato estiver encantado ou equipado, ele poderá atacar como se não tivesse defensor.\', \'type\': \'Criatura — Humano Cavaleiro\', \'flavor\': \'Até mesmo o maior dos heróis começa sem nada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449133&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'98f89c9a-29d8-4b44-b5dc-83ee8f088418\', \'multiverseId\': 449133}, \'multiverseid\': 449133}, {\'name\': \'Рыцарь-Новичок\', \'text\': \'Защитник (Это существо не может атаковать.)\\nПока Рыцарь-Новичок зачарован или снаряжен, он может атаковать, как если бы у него не было способности Защитника.\', \'type\': \'Существо — Человек Рыцарь\', \'flavor\': \'Даже величайший из героев начинает с нуля.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449414&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cc94c191-6adf-4080-a2f3-e20b890168ac\', \'multiverseId\': 449414}, \'multiverseid\': 449414}, {\'name\': \'新手骑士\', \'text\': \'守军（此生物不能攻击。）\\n只要新手骑士上结附了灵气或佩带了武具，它便能视同不具守军异能地进行攻击。\', \'type\': \'生物 ～人类／骑士\', \'flavor\': \'就算是最伟大的英雄，刚起步时也是一张白纸。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449695&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dec3ba8a-5d2a-4d14-8704-5ca54747ce0a\', \'multiverseId\': 449695}, \'multiverseid\': 449695}, {\'name\': \'新手騎士\', \'text\': \'守軍（此生物不能攻擊。）\\n只要新手騎士上結附了靈氣或佩帶了武具，它便能視同不具守軍異能地進行攻擊。\', \'type\': \'生物 ～人類／騎士\', \'flavor\': \'就算是最偉大的英雄，剛起步時也是一張白紙。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449976&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f29d1968-b955-4989-baad-990067f519a0\', \'multiverseId\': 449976}, \'multiverseid\': 449976}]', "[{'name': 'Rostschwingenfalke', 'text': 'Fliegend', 'type': 'Kreatur — Vogel', 'flavor': 'Sie sind in der weiten Prärie sowie im Buschland heimisch und nisten nicht selten in den Skeletten von Drachen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447453&type=card', 'language': 'German', 'identifiers': {'scryfallId': '699f70ce-0301-4718-a03f-8ec3cc18994f', 'multiverseId': 447453}, 'multiverseid': 447453}, {'name': 'Halcón alaherrumbre', 'text': 'Vuela.', 'type': 'Criatura — Ave', 'flavor': 'El hábitat natural de los halcones son las praderas y los montes, pero de vez en cuando también anidan en esqueletos de dragón.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447734&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5164b5e6-46e1-4117-8b8f-f1fff556a83a', 'multiverseId': 447734}, 'multiverseid': 447734}, {'name': 'Faucon aux ailes de rouille', 'text': 'Vol', 'type': 'Créature : oiseau', 'flavor': 'Coutumiers des vastes prairies et de la brousse, les faucons nichent parfois dans des ossements de dragon.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448015&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'be839a9c-f99d-4b26-94bb-c790d101f62e', 'multiverseId': 448015}, 'multiverseid': 448015}, {'name': 'Falcone Alabrunita', 'text': 'Volare', 'type': 'Creatura — Uccello', 'flavor': 'Sebbene abituati a steppe e vaste praterie, a volte i falconi fanno il nido negli scheletri di drago.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448296&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c741e1fd-5caa-4344-9ad6-266049da8fa9', 'multiverseId': 448296}, 'multiverseid': 448296}, {'name': '錆色翼の隼', 'text': '飛行', 'type': 'クリーチャー — 鳥', 'flavor': '広大な草原や低木地では、隼はドラゴンの骨をねぐらにしていることがある。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448577&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'cb86f237-9783-44f5-ac35-a1ae2637dd0b', 'multiverseId': 448577}, 'multiverseid': 448577}, {'name': '부식날개 매', 'text': '비행', 'type': '생물 — 조류', 'flavor': '넓은 초원과 관목지에서 살아가는 매들은, 때때로 용의 뼈를 횃대로 삼는다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448858&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'ce101c21-888c-48bb-bdab-519bd9da55b1', 'multiverseId': 448858}, 'multiverseid': 448858}, {'name': 'Falcão da Asa Rubiginosa', 'text': 'Voar', 'type': 'Criatura — Ave', 'flavor': 'Nativos de vastas pradarias e cerrados, os falcões ocasionalmente fazem ninhos em esqueletos de dragões.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449139&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9549c94d-c1fe-402c-8da9-11563295734d', 'multiverseId': 449139}, 'multiverseid': 449139}, {'name': 'Бурокрылый Сокол', 'text': 'Полет', 'type': 'Существо — Птица', 'flavor': 'Соколы водятся в бескрайних степях и прериях и временами устраивают гнезда в драконьих скелетах.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449420&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'fadd61ce-888a-4e48-aaa9-7d7c30af2819', 'multiverseId': 449420}, 'multiverseid': 449420}, {'name': '褐翼猎鹰', 'text': '飞行', 'type': '生物 ～鸟', 'flavor': '猎鹰以辽阔草原与灌丛为家，偶而在龙骸上停歇。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449701&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '3b3592eb-36b2-4024-9af4-d840a27ff9b3', 'multiverseId': 449701}, 'multiverseid': 449701}, {'name': '褐翼獵鷹', 'text': '飛行', 'type': '生物 ～鳥', 'flavor': '獵鷹以遼闊草原與灌叢為家，偶而在龍骸上停歇。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449982&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'efb81457-e821-45a3-b86e-d059959428ff', 'multiverseId': 449982}, 'multiverseid': 449982}]", '[{\'name\': \'Runenbewehrter Armasaurus\', \'text\': \'Immer wenn ein Gegner eine Fähigkeit einer Kreatur oder eines Landes aktiviert, die keine Manafähigkeit ist, kannst du eine Karte ziehen.\', \'type\': \'Kreatur — Dinosaurier\', \'flavor\': \'Die heiligsten Stätten des Imperiums der Sonne werden von mehr als nur Gebeten beschützt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447617&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2eb9a8d9-5f08-4a26-9ce3-bba8ca4c0a77\', \'multiverseId\': 447617}, \'multiverseid\': 447617}, {\'name\': \'Armasaurio rúnico\', \'text\': \'Siempre que un oponente active una habilidad de una criatura o una tierra que no sea una habilidad de maná, puedes robar una carta.\', \'type\': \'Criatura — Dinosaurio\', \'flavor\': \'Los lugares más sagrados del Imperio del Sol están protegidos por algo más que plegarias.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447898&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'61ec826d-9ea7-4e7e-8fe3-b363a55ac52e\', \'multiverseId\': 447898}, \'multiverseid\': 447898}, {\'name\': \'Armosaure runique\', \'text\': "À chaque fois qu\'un adversaire active une capacité d\'une créature ou d\'un terrain qui n\'est pas une capacité de mana, vous pouvez piocher une carte.", \'type\': \'Créature : dinosaure\', \'flavor\': "Les sites les plus sacrés de l\'Empire du Soleil sont protégés par bien plus que des prières.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448179&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f9815cc5-b657-4d26-a1b0-387cc873f090\', \'multiverseId\': 448179}, \'multiverseid\': 448179}, {\'name\': \'Armasauro Runico\', \'text\': "Ogniqualvolta un avversario attiva un\'abilità di una creatura o di una terra che non è un\'abilità di mana, puoi pescare una carta.", \'type\': \'Creatura — Dinosauro\', \'flavor\': "I luoghi più sacri dell\'Impero del Sole sono protetti da molto più delle sole preghiere.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448460&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'edf51084-74bb-4b8f-beea-452bbca25770\', \'multiverseId\': 448460}, \'multiverseid\': 448460}, {\'name\': \'秘紋のアルマサウルス\', \'text\': \'対戦相手がクリーチャーか土地の、マナ能力でない能力を起動するたび、あなたはカードを１枚引いてもよい。\', \'type\': \'クリーチャー — 恐竜\', \'flavor\': \'太陽帝国で最も神聖な場所は、祈り以上のもので守られている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448741&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'215e1483-9bd9-404f-b778-9ed3bda8ec3a\', \'multiverseId\': 448741}, \'multiverseid\': 448741}, {\'name\': \'신비의 아르마사우루스\', \'text\': \'상대가 생물이나 대지의 마나 능력이 아닌 능력을 활성화할 때마다, 당신은 카드 한 장을 뽑을 수 있다.\', \'type\': \'생물 — 공룡\', \'flavor\': \'태양 제국의 가장 신성한 지역들은 기도 이상의 수단으로 보호되고 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449022&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'12813658-0cd5-42af-9b42-afb444f2e0a1\', \'multiverseId\': 449022}, \'multiverseid\': 449022}, {\'name\': \'Armassauro Rúnico\', \'text\': \'Toda vez que um oponente ativa uma habilidade de uma criatura ou terreno que não seja uma habilidade de mana, você pode comprar um card.\', \'type\': \'Criatura — Dinossauro\', \'flavor\': \'Os lugares mais sagrados do Império do Sol são protegidos por mais que orações.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449303&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'86b25ded-1930-4f33-80c3-13d1d732ae6d\', \'multiverseId\': 449303}, \'multiverseid\': 449303}, {\'name\': \'Рунический Армазавр\', \'text\': \'Каждый раз, когда оппонент активирует способность существа или земли, не являющуюся мана-способностью, вы можете взять карту.\', \'type\': \'Существо — Динозавр\', \'flavor\': \'Самые священные места Империи Солнца охраняются не только молитвами.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449584&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'db419606-ee6c-4ef8-8599-75fa0688ba3d\', \'multiverseId\': 449584}, \'multiverseid\': 449584}, {\'name\': \'符脊悍扫龙\', \'text\': \'每当任一对手起动生物或地上不属法术力异能之异能时，你可以抓一张牌。\', \'type\': \'生物 ～恐龙\', \'flavor\': \'烈阳帝国最神圣的场所远不止有祈祷保护。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449865&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ddaf4d2b-aa37-4ed8-b937-97d2b208a0bc\', \'multiverseId\': 449865}, \'multiverseid\': 449865}, {\'name\': \'符脊悍掃龍\', \'text\': \'每當任一對手起動生物或地上不屬魔法力異能之異能時，你可以抽一張牌。\', \'type\': \'生物 ～恐龍\', \'flavor\': \'烈陽帝國最神聖的場所遠不止有祈禱保護。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450146&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5cb2d232-314f-447d-9780-73915d14e246\', \'multiverseId\': 450146}, \'multiverseid\': 450146}]', '[{\'name\': \'Rätselhafter Sceada\', \'text\': \'Fliegend\\nDie Stärke des Rätselhaften Sceadas ist gleich der Anzahl an Spontanzauber- und Hexerei-Karten in deinem Friedhof.\', \'type\': \'Kreatur — Sceada\', \'flavor\': \'Viele Geweihte glauben, dass er unvorstellbare Geheimnisse hütet. Kefnet weiß, dass dem nicht so ist, begrüßt aber die kostenlosen Fütterungen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447633&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'32d1f132-5da4-4c70-8cf2-8b128361cfef\', \'multiverseId\': 447633}, \'multiverseid\': 447633}, {\'name\': \'Draco enigma\', \'text\': \'Vuela.\\nLa fuerza del Draco enigma es igual a la cantidad de cartas de instantáneo y de conjuro en tu cementerio.\', \'type\': \'Criatura — Draco\', \'flavor\': \'Muchos iniciados creen que conoce secretos más allá de la imaginación. Muchos se convirtieron en comida tratando de averiguarlos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447914&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'72419a53-cb79-49ab-8aea-1d8be57ca413\', \'multiverseId\': 447914}, \'multiverseid\': 447914}, {\'name\': \'Drakôn du logogriphe\', \'text\': "Vol\\nLa force du Drakôn du logogriphe est égale au nombre de cartes d\'éphémère et de rituel dans votre cimetière.", \'type\': \'Créature : drakôn\', \'flavor\': "De nombreux adeptes pensent qu\'il détient des secrets dépassant l\'imagination. Nombreux sont ceux à lui avoir servi de dîner en essayant de les percer.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448195&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b4536d60-ad3b-4507-aef1-18c79cb463a4\', \'multiverseId\': 448195}, \'multiverseid\': 448195}, {\'name\': \'Draghetto degli Enigmi\', \'text\': \'Volare\\nLa forza del Draghetto degli Enigmi è pari al numero di carte istantaneo e stregoneria nel tuo cimitero.\', \'type\': \'Creatura — Draghetto\', \'flavor\': \'Numerosi iniziati credono che sia a conoscenza di segreti inimmaginabili. Molti di coloro che hanno tentato di carpirli sono stati trasformati in pasto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448476&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'40d7e534-7f25-4fdc-94aa-c2a87724d65e\', \'multiverseId\': 448476}, \'multiverseid\': 448476}, {\'name\': \'奇怪なドレイク\', \'text\': \'飛行\\n奇怪なドレイクのパワーは、あなたの墓地にあるインスタントかソーサリーであるカードの総数に等しい。\', \'type\': \'クリーチャー — ドレイク\', \'flavor\': \'多くの修練者は、そいつが想像を超える秘密を保持していると信じている。大勢がそれを知ろうとして餌食となった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448757&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3c4f8ca6-70cf-4472-9183-694bfe7b3bc3\', \'multiverseId\': 448757}, \'multiverseid\': 448757}, {\'name\': \'수수께끼 드레이크\', \'text\': \'비행\\n수수께끼 드레이크의 공격력은 당신의 무덤에 있는 순간마법과 집중마법 카드의 수의 합과 같다.\', \'type\': \'생물 — 드레이크\', \'flavor\': \'많은 입회자들은 그것이 상상을 넘어서는 비밀을 가지고 있다고 생각한다. 대부분이 이 비밀을 알아내려다 먹잇감이 되었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449038&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c8003552-3b28-4257-aa54-ee95a128edab\', \'multiverseId\': 449038}, \'multiverseid\': 449038}, {\'name\': \'Dragonete dos Enigmas\', \'text\': \'Voar\\nO poder de Dragonete dos Enigmas é igual ao número de cards de mágica instantânea e feitiço em seu cemitério.\', \'type\': \'Criatura — Dragonete\', \'flavor\': \'Muitos iniciados creem que ele possua segredos além da imaginação. Muitos viraram refeição tentando descobri-los.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449319&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c8f91bd2-df28-416e-8846-68ac3bf0bc84\', \'multiverseId\': 449319}, \'multiverseid\': 449319}, {\'name\': \'Дрейк Загадок\', \'text\': \'Полет\\nСила Дрейка Загадок равна количеству карт мгновенных заклинаний и волшебства на вашем кладбище.\', \'type\': \'Существо — Дрейк\', \'flavor\': \'Многие послушники думают, что он хранит непостижимые тайны. Многие стали его пищей, пытаясь их выведать.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449600&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'437a29eb-9399-4890-8683-b73b0a5e2e45\', \'multiverseId\': 449600}, \'multiverseid\': 449600}, {\'name\': \'谜翼龙兽\', \'text\': \'飞行\\n谜翼龙兽的力量等同于你坟墓场中瞬间与法术牌的数量加总。\', \'type\': \'生物 ～龙兽\', \'flavor\': \'祀徒相信它身上藏有远超想象的秘密。但大多数想要解开秘密的人都成了它的盘中餐。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449881&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bcf3e3cf-6458-4b7e-bf63-d81f070ccfd5\', \'multiverseId\': 449881}, \'multiverseid\': 449881}, {\'name\': \'謎翼龍獸\', \'text\': \'飛行\\n謎翼龍獸的力量等同於你墳墓場中瞬間與巫術牌的數量加總。\', \'type\': \'生物 ～龍獸\', \'flavor\': \'祀徒相信牠身上藏有遠超想像的秘密。但大多數想要解開祕密的人都成了牠的盤中餐。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450162&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c7e0b0bf-537f-4494-9dee-1a71b252d4c3\', \'multiverseId\': 450162}, \'multiverseid\': 450162}]', '[{\'name\': \'Rätselmeister-Sphinx\', \'text\': \'Fliegend\\nWenn die Rätselmeister-Sphinx ins Spiel kommt, kannst du eine Kreatur deiner Wahl, die ein Gegner kontrolliert, auf die Hand ihres Besitzers zurückbringen.\', \'type\': \'Kreatur — Sphinx\', \'flavor\': \'„Gib mir eine simple Antwort auf eine simple Frage, Reisender, und du darfst passieren."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450268&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'451a86c2-d7f5-40ab-a6b1-8cf799696662\', \'multiverseId\': 450268}, \'multiverseid\': 450268}, {\'name\': \'Esfinge de los misterios\', \'text\': \'Vuela.\\nCuando la Esfinge de los misterios entre al campo de batalla, puedes regresar la criatura objetivo que controla un oponente a la mano de su propietario.\', \'type\': \'Criatura — Esfinge\', \'flavor\': \'"Para avanzar en tu viaje solo tienes que responder una pregunta sencilla...".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450302&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d33fd0d1-9075-4c09-a8d7-6c452d4a646a\', \'multiverseId\': 450302}, \'multiverseid\': 450302}, {\'name\': \'Sphinge maîtresse des énigmes\', \'text\': "Vol\\nQuand la Sphinge maîtresse des énigmes arrive sur le champ de bataille, vous pouvez renvoyer une créature ciblée qu\'un adversaire contrôle dans la main de son propriétaire.", \'type\': \'Créature : sphinx\', \'flavor\': \'« Pour passer, il suffit de répondre à une simple question, voyageur. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450336&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'232adafa-56ec-4e4c-b581-36f0e1a7c9a7\', \'multiverseId\': 450336}, \'multiverseid\': 450336}, {\'name\': \'Sfinge Maestra degli Arcani\', \'text\': \'Volare\\nQuando la Sfinge Maestra degli Arcani entra nel campo di battaglia, puoi far tornare una creatura bersaglio controllata da un avversario in mano al suo proprietario.\', \'type\': \'Creatura — Sfinge\', \'flavor\': \'"Per proseguire incolume, viaggiatore, dovrai solo rispondere a una semplice domanda."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450370&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'626105f5-96ee-4728-8aa9-14737bd9ac74\', \'multiverseId\': 450370}, \'multiverseid\': 450370}, {\'name\': \'謎かけ達人スフィンクス\', \'text\': \'飛行\\n謎かけ達人スフィンクスが戦場に出たとき、対戦相手がコントロールしているクリーチャー１体を対象とする。あなたはそれをオーナーの手札に戻してもよい。\', \'type\': \'クリーチャー — スフィンクス\', \'flavor\': \'「安全な道中に必要なものは、簡単な問いに対する簡単な答えのみですよ、旅人さん。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450404&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f4c44b4f-ed2f-40e2-af95-45f416cf6aef\', \'multiverseId\': 450404}, \'multiverseid\': 450404}, {\'name\': \'수수께끼의 대가 스핑크스\', \'text\': \'비행\\n수수께끼의 대가 스핑크스가 전장에 들어올 때, 상대가 조종하는 생물을 목표로 정한다. 당신은 그 생물을 소유자의 손으로 되돌릴 수 있다.\', \'type\': \'생물 — 스핑크스\', \'flavor\': \'"안전한 길은 간단한 질문에는 간단한 대답만 하기를 요구한다네, 여행자여."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450438&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0a608e85-a246-4cad-906e-33ccb139ad7e\', \'multiverseId\': 450438}, \'multiverseid\': 450438}, {\'name\': \'Esfinge Mestra dos Enigmas\', \'text\': \'Voar\\nQuando Esfinge Mestra dos Enigmas entra no campo de batalha, você pode devolver a criatura alvo que um oponente controla para a mão de seu dono.\', \'type\': \'Criatura — Esfinge\', \'flavor\': \'"Sua passagem em segurança requer uma resposta simples a uma pergunta simples, viajante."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450472&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'42afaee0-86dc-4d4c-bce9-011401ecb04f\', \'multiverseId\': 450472}, \'multiverseid\': 450472}, {\'name\': \'Сфинкс, Мастер Загадок\', \'text\': \'Полет\\nКогда Сфинкс, Мастер Загадок выходит на поле битвы, вы можете вернуть целевое существо под контролем оппонента в руку его владельца.\', \'type\': \'Существо — Сфинкс\', \'flavor\': \'«Чтобы пройти, нужно лишь дать простой ответ на простой вопрос, путник».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450506&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'52aab117-1b4a-45c4-a63a-6a3007277fde\', \'multiverseId\': 450506}, \'multiverseid\': 450506}, {\'name\': \'设谜史芬斯\', \'text\': \'飞行\\n当设谜史芬斯进战场时，你可以将目标由对手操控的生物移回其拥有者手上。\', \'type\': \'生物 ～史芬斯\', \'flavor\': \'「旅人呀，想要安全通过，只需简单地回答一个简单问题。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450540&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9e19ce78-8cf4-426a-9c70-b0a428eba2cb\', \'multiverseId\': 450540}, \'multiverseid\': 450540}, {\'name\': \'設謎史芬斯\', \'text\': \'飛行\\n當設謎史芬斯進戰場時，你可以將目標由對手操控的生物移回其擁有者手上。\', \'type\': \'生物 ～史芬斯\', \'flavor\': \'「旅人呀，想要安全通過，只需簡單地回答一個簡單問題。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450574&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5fd0b1c5-f337-49b3-badd-b2a56f8de63d\', \'multiverseId\': 450574}, \'multiverseid\': 450574}]', '[{\'name\': \'Sai, Meister-Thopterist\', \'text\': \'Immer wenn du einen Artefaktzauber wirkst, erzeuge einen 1/1 farblosen Thopter-Artefaktkreaturenspielstein mit Flugfähigkeit.\\n{1}{U}, opfere zwei Artefakte: Ziehe eine Karte.\', \'type\': \'Legendäre Kreatur — Mensch, Handwerker\', \'flavor\': \'„Ohne die Kunst ist Handwerk nur eine umständliche Art, den Schrottplatz zu füllen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447486&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6f9aad42-23a3-48af-bc88-00747a2007d5\', \'multiverseId\': 447486}, \'multiverseid\': 447486}, {\'name\': \'Sai, maestro topterista\', \'text\': \'Siempre que lances un hechizo de artefacto, crea una ficha de criatura artefacto Tóptero incolora 1/1 con la habilidad de volar.\\n{1}{U}, sacrificar dos artefactos: Roba una carta.\', \'type\': \'Criatura legendaria — Artífice humano\', \'flavor\': \'"La tecnología sin arte no es más que una forma muy cara de llenar el vertedero".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447767&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c3fe1687-425d-4784-a648-61e2697f6cfd\', \'multiverseId\': 447767}, \'multiverseid\': 447767}, {\'name\': \'Sai, maître mécanoptériste\', \'text\': "À chaque fois que vous lancez un sort d\'artefact, créez un jeton de créature-artefact 1/1 incolore Mécanoptère avec le vol.\\n{1}{U}, sacrifiez deux artefacts : Piochez une carte.", \'type\': \'Créature légendaire : humain et artificier\', \'flavor\': \'« Une industrie sans talent artistique est une façon distinguée de remplir un dépôt de ferraille. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448048&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b874a1f6-7c11-4696-bac7-711e135518c3\', \'multiverseId\': 448048}, \'multiverseid\': 448048}, {\'name\': \'Sayi, Maestro Totterista\', \'text\': \'Ogniqualvolta lanci una magia artefatto, crea una pedina creatura artefatto Tottero 1/1 incolore con volare.\\n{1}{U}, Sacrifica due artefatti: Pesca una carta.\', \'type\': \'Creatura Leggendaria — Artefice Umano\', \'flavor\': \'"Se non è accompagnata dall\\\'arte, l\\\'operosità non è che un metodo elaborato per riempire un deposito di ferraglia."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448329&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b2398274-429d-411c-8ebd-4c6ed114b423\', \'multiverseId\': 448329}, \'multiverseid\': 448329}, {\'name\': \'練達飛行機械職人、サイ\', \'text\': \'あなたがアーティファクト・呪文を唱えるたび、飛行を持つ無色の１/１の飛行機械・アーティファクト・クリーチャー・トークンを１体生成する。\\n{1}{U}, アーティファクト２つを生け贄に捧げる：カードを１枚引く。\', \'type\': \'伝説のクリーチャー — 人間・工匠\', \'flavor\': \'「芸術のない産業なんて、おしゃれにゴミ置き場のゴミを増やすだけさ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448610&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'06f5fa7e-8a28-49ae-9273-be72cae53d17\', \'multiverseId\': 448610}, \'multiverseid\': 448610}, {\'name\': \'숙달된 날틀제작자, 세이\', \'text\': \'당신이 마법물체 주문을 발동할 때마다, 비행을 가진 1/1 무색 날틀 마법물체 생물 토큰 한 개를 만든다.\\n{1}{U}, 마법물체 두 개를 희생한다: 카드 한 장을 뽑는다.\', \'type\': \'전설적 생물 — 인간 기능공\', \'flavor\': \'"예술이 없는 산업은 쓰레기장을 채우는 좋은 방법일 뿐이지."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448891&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'06bd53ad-9460-4c88-a42c-b99bafad3ac5\', \'multiverseId\': 448891}, \'multiverseid\': 448891}, {\'name\': \'Sai, Topterista Mestre\', \'text\': \'Toda vez que você conjurar uma mágica de artefato, crie uma ficha de criatura artefato incolor 1/1 do tipo Tóptero com voar.\\n{1}{U}, sacrifique dois artefatos: Compre um card.\', \'type\': \'Criatura Lendária — Humano Artesão\', \'flavor\': \'"A perícia sem o talento artístico é só uma forma sofisticada de encher o ferro-velho."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449172&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dedd9dc0-1d32-4fab-9b06-3d357db71f13\', \'multiverseId\': 449172}, \'multiverseid\': 449172}, {\'name\': \'Сай, Мастер-Топтерист\', \'text\': \'Каждый раз, когда вы разыгрываете заклинание артефакта, создайте одну фишку артефакта существа 1/1 бесцветный Топтер с Полетом.\\n{1}{U}, пожертвуйте два артефакта: возьмите карту.\', \'type\': \'Легендарное Существо — Человек Механик\', \'flavor\': \'«Производство без вдохновения — просто излишне сложный способ наполнения свалок».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449453&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a7c28c4b-3e68-42a6-8d75-d164e27337ef\', \'multiverseId\': 449453}, \'multiverseid\': 449453}, {\'name\': \'扑翼大师塞埃\', \'text\': \'每当你施放神器咒语时，派出一个1/1无色，具飞行异能的振翼机衍生神器生物。\\n{1}{U}，牺牲两个神器：抓一张牌。\', \'type\': \'传奇生物 ～人类／神器师\', \'flavor\': \'「量产品若不加修饰，产出物与垃圾无异。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449734&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a16b26a2-4253-4f85-a93a-c2a6330ad079\', \'multiverseId\': 449734}, \'multiverseid\': 449734}, {\'name\': \'撲翼大師塞埃\', \'text\': \'每當你施放神器咒語時，派出一個1/1無色，具飛行異能的振翼機衍生神器生物。\\n{1}{U}，犧牲兩個神器：抽一張牌。\', \'type\': \'傳奇生物 ～人類／神器師\', \'flavor\': \'「量產品若不加修飾，產出物與垃圾無異。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450015&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c3e2b144-8702-435b-8f06-4700ef7482c3\', \'multiverseId\': 450015}, \'multiverseid\': 450015}]', '[{\'name\': \'Sarkhan Drachenseele\', \'text\': \'+2: Sarkhan Drachenseele fügt allen Gegnern und allen Kreaturen, die deine Gegner kontrollieren, je 1 Schadenspunkt zu.\\n—3: Sarkhan Drachenseele fügt einem Spieler oder einem Planeswalker deiner Wahl 4 Schadenspunkte zu.\\n—9: Durchsuche deine Bibliothek nach einer beliebigen Anzahl an Drache-Kreaturenkarten, bringe sie ins Spiel und mische dann deine Bibliothek.\', \'type\': \'Legendärer Planeswalker — Sarkhan\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450277&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5e23f237-6dde-43d5-a520-68aa5c29cf0c\', \'multiverseId\': 450277}, \'multiverseid\': 450277}, {\'name\': \'Sarkhan, almadragón\', \'text\': \'+2: Sarkhan, almadragón hace 1 punto de daño a cada oponente y a cada criatura que controlan tus oponentes.\\n−3: Sarkhan, almadragón hace 4 puntos de daño al jugador o planeswalker objetivo.\\n−9: Busca en tu biblioteca cualquier cantidad de cartas de criatura Dragón, ponlas en el campo de batalla y luego baraja tu biblioteca.\', \'type\': \'Planeswalker legendario — Sarkhan\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450311&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c4bbbc4d-9f4d-4160-8d08-e345eb3599f5\', \'multiverseId\': 450311}, \'multiverseid\': 450311}, {\'name\': \'Sarkhan, âme-dragon\', \'text\': "+2 : Sarkhan, âme-dragon inflige 1 blessure à chaque adversaire et à chaque créature que vos adversaires contrôlent.\\n-3 : Sarkhan, âme-dragon inflige 4 blessures à une cible, joueur ou planeswalker.\\n-9 : Cherchez dans votre bibliothèque n\'importe quel nombre de cartes de créature Dragon, mettez-les sur le champ de bataille et mélangez ensuite votre bibliothèque.", \'type\': \'Planeswalker légendaire : Sarkhan\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450345&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'903b15ce-1205-4b1c-8d2f-970d3632f257\', \'multiverseId\': 450345}, \'multiverseid\': 450345}, {\'name\': \'Sarkhan, Anima di Drago\', \'text\': \'+2: Sarkhan, Anima di Drago infligge 1 danno a ogni avversario e a ogni creatura controllata dai tuoi avversari.\\n-3: Sarkhan, Anima di Drago infligge 4 danni a un giocatore o a un planeswalker bersaglio.\\n-9: Passa in rassegna il tuo grimorio per un qualsiasi numero di carte creatura Drago, mettile sul campo di battaglia, poi rimescola il tuo grimorio.\', \'type\': \'Planeswalker Leggendario — Sarkhan\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450379&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7443fd81-febb-4e20-a7ba-fd2f1ea0ef3a\', \'multiverseId\': 450379}, \'multiverseid\': 450379}, {\'name\': \'龍魂、サルカン\', \'text\': \'+2：龍魂、サルカンは各対戦相手と対戦相手がコントロールしている各クリーチャーに、それぞれ１点のダメージを与える。\\n-3：プレイヤー１人かプレインズウォーカー１体を対象とする。龍魂、サルカンはそれに４点のダメージを与える。\\n-9：あなたのライブラリーから望む数のドラゴン・クリーチャー・カードを探して戦場に出す。その後あなたのライブラリーを切り直す。\', \'type\': \'伝説のプレインズウォーカー — サルカン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450413&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3f65c28a-982f-4c2f-8176-dd1a18a6ce16\', \'multiverseId\': 450413}, \'multiverseid\': 450413}, {\'name\': \'용의 영혼, 사르칸\', \'text\': \'+2: 용의 영혼, 사르칸은 각 상대와 당신의 상대들이 조종하는 각 생물에게 피해 1점을 입힌다.\\n−3: 플레이어나 플레인즈워커를 목표로 정한다. 용의 영혼, 사르칸은 그 목표에게 피해 4점을 입힌다.\\n−9: 당신의 서고에서 용 생물 카드를 원하는 만큼 찾아, 전장에 놓은 후, 당신의 서고를 섞는다.\', \'type\': \'전설적 플레인즈워커 — 사르칸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450447&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b0c10a98-4d2e-4a01-ac48-e711fb272d6a\', \'multiverseId\': 450447}, \'multiverseid\': 450447}, {\'name\': \'Sarkhan, Alma de Dragão\', \'text\': \'+2: Sarkhan, Alma de Dragão, causa 1 ponto de dano a cada oponente e a cada criatura que seus oponentes controlam.\\n−3: Sarkhan, Alma de Dragão, causa 4 pontos de dano ao jogador ou planeswalker alvo.\\n−9: Procure qualquer quantidade de cards de criatura do tipo Dragão em seu grimório, coloque-os no campo de batalha e depois embaralhe seu grimório.\', \'type\': \'Planeswalker Lendário — Sarkhan\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450481&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'90ff8315-7345-43df-9393-199f9b8084cf\', \'multiverseId\': 450481}, \'multiverseid\': 450481}, {\'name\': \'Сархан, Душа Дракона\', \'text\': \'+2: Сархан, Душа Дракона наносит по 1 повреждению каждому оппоненту и каждому существу под контролем ваших оппонентов.\\n—3: Сархан, Душа Дракона наносит 4 повреждения целевому игроку или planeswalker-у.\\n—9: найдите в вашей библиотеке любое количество карт существ-Драконов, положите их на поле битвы, затем перетасуйте вашу библиотеку.\', \'type\': \'Легендарный Planeswalker — Сархан\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450515&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9b40ffb0-3a32-4b51-9117-6fe594e1fcdf\', \'multiverseId\': 450515}, \'multiverseid\': 450515}, {\'name\': \'龙魂合一萨坎\', \'text\': \'+2：龙魂合一萨坎向每位对手和每个由对手操控的生物各造成1点伤害。\\n−3：龙魂合一萨坎对目标牌手或鹏洛客造成4点伤害。\\n−9：从你的牌库中搜寻任意数量的龙生物牌，将它们放进战场，然后将你的牌库洗牌。\', \'type\': \'传奇鹏洛客 ～萨坎\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450549&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3221c221-2638-48c3-9bb5-48a9b9945c71\', \'multiverseId\': 450549}, \'multiverseid\': 450549}, {\'name\': \'龍魂合一薩坎\', \'text\': \'+2：龍魂合一薩坎向每位對手和每個由對手操控的生物各造成1點傷害。\\n−3：龍魂合一薩坎對目標玩家或鵬洛客造成4點傷害。\\n−9：從你的牌庫中搜尋任意數量的龍生物牌，將它們放進戰場，然後將你的牌庫洗牌。\', \'type\': \'傳奇鵬洛客 ～薩坎\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450583&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2129c3d9-9fd7-41ed-9793-869ab1f21979\', \'multiverseId\': 450583}, \'multiverseid\': 450583}]', '[{\'name\': \'Sarkhan Feuerblut\', \'text\': \'+1: Du kannst eine Karte abwerfen. Falls du dies tust, ziehe eine Karte.\\n+1: Erzeuge zwei Mana in einer beliebigen Kombination von Farben. Verwende dieses Mana nur, um Drache-Zaubersprüche zu wirken.\\n−7: Erzeuge vier 5/5 rote Drache-Kreaturenspielsteine mit Flugfähigkeit.\', \'type\': \'Legendärer Planeswalker — Sarkhan\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447571&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0c83cf0e-0dce-4d8f-82e1-16653d08d3a9\', \'multiverseId\': 447571}, \'multiverseid\': 447571}, {\'name\': \'Sarkhan, sangrefuego\', \'text\': \'+1: Puedes descartar una carta. Si lo haces, roba una carta.\\n+1: Agrega dos manás de cualquier combinación de colores. Gasta este maná solo para lanzar hechizos de Dragón.\\n−7: Crea cuatro fichas de criatura Dragón rojas 5/5 con la habilidad de volar.\', \'type\': \'Planeswalker legendario — Sarkhan\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447852&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ef406160-46b1-4a4f-875c-6af7008f5696\', \'multiverseId\': 447852}, \'multiverseid\': 447852}, {\'name\': \'Sarkhan, le sang de feu\', \'text\': "+1 : Vous pouvez vous défausser d\'une carte. Si vous faites ainsi, piochez une carte.\\n+1 : Ajoutez deux manas de la combinaison de mana coloré de votre choix. Ne dépensez ce mana que pour lancer des sorts de dragon.\\n-7 : Créez quatre jetons de créature 5/5 rouge Dragon avec le vol.", \'type\': \'Planeswalker légendaire : Sarkhan\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448133&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'560509d4-5a56-4d78-b4d4-66182fa650d6\', \'multiverseId\': 448133}, \'multiverseid\': 448133}, {\'name\': \'Sarkhan, Sangue Infuocato\', \'text\': \'+1: Puoi scartare una carta. Se lo fai, pesca una carta.\\n+1: Aggiungi due mana in qualsiasi combinazione di colori. Spendi questo mana solo per lanciare magie Drago.\\n-7: Crea quattro pedine creatura Drago 5/5 rosse con volare.\', \'type\': \'Planeswalker Leggendario — Sarkhan\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448414&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8de22e34-2a9b-4b70-b9a8-1ef3bd5f2ef3\', \'multiverseId\': 448414}, \'multiverseid\': 448414}, {\'name\': \'火の血脈、サルカン\', \'text\': \'+1：あなたはカード１枚を捨ててもよい。そうしたなら、カードを１枚引く。\\n+1：望む色の組み合わせのマナ２点を加える。このマナは、ドラゴン・呪文を唱えるためにのみ使用できる。\\n-7：飛行を持つ赤の５/５のドラゴン・クリーチャー・トークンを４体生成する。\', \'type\': \'伝説のプレインズウォーカー — サルカン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448695&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7ecea5ad-f79b-4f53-aee7-98c1a5130294\', \'multiverseId\': 448695}, \'multiverseid\': 448695}, {\'name\': \'불의 피, 사르칸\', \'text\': \'+1: 당신은 카드 한 장을 버릴 수 있다. 그렇게 한다면, 카드 한 장을 뽑는다.\\n+1: 원하는 색의 조합으로 마나 두 개를 추가한다. 이 마나는 용 주문을 발동하는 데에만 사용할 수 있다.\\n−7: 비행을 가진 5/5 적색 용 생물 토큰 네 개를 만든다.\', \'type\': \'전설적 플레인즈워커 — 사르칸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448976&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'043dfa80-7668-4741-bbbd-6dbe5ced9804\', \'multiverseId\': 448976}, \'multiverseid\': 448976}, {\'name\': \'Sarkhan, Sangue de Fogo\', \'text\': \'+1: Você pode descartar um card. Se fizer isso, compre um card.\\n+1: Adicione dois manas em qualquer combinação de cores. Gaste este mana somente para conjurar mágicas de Dragão.\\n−7: Crie quatro fichas de criatura vermelha 5/5 do tipo Dragão com voar.\', \'type\': \'Planeswalker Lendário — Sarkhan\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449257&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'30f4b257-0313-48d7-b1ef-bb2f31a1e21a\', \'multiverseId\': 449257}, \'multiverseid\': 449257}, {\'name\': \'Сархан, Огненная Кровь\', \'text\': \'+1: вы можете сбросить карту. Если вы это делаете, возьмите карту.\\n+1: добавьте две маны в любой комбинации цветов. Тратьте эту ману только на разыгрывание заклинаний Драконов.\\n−7: создайте четыре фишки существа 5/5 красный Дракон с Полетом.\', \'type\': \'Легендарный Planeswalker — Сархан\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449538&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0c4b3ddc-4957-412e-a80d-fe862db304a0\', \'multiverseId\': 449538}, \'multiverseid\': 449538}, {\'name\': \'炎血萨坎\', \'text\': \'+1：你可以弃一张牌。若你如此作，则抓一张牌。\\n+1：加两点法术力，其颜色组合由你选择。此法术力只能用来施放龙咒语。\\n−7：派出四个5/5红色，具飞行异能的龙衍生生物。\', \'type\': \'传奇鹏洛客 ～萨坎\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449819&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b9f9bd7b-a0d9-44ac-af2c-3a3e0716bea4\', \'multiverseId\': 449819}, \'multiverseid\': 449819}, {\'name\': \'炎血薩坎\', \'text\': \'+1：你可以棄一張牌。若你如此作，則抽一張牌。\\n+1：加兩點魔法力，其顏色組合由你選擇。此魔法力只能用來施放龍咒語。\\n-7：派出四個5/5紅色，具飛行異能的龍衍生生物。\', \'type\': \'傳奇鵬洛客 ～薩坎\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450100&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d94a386d-2881-4cf6-9a47-e2bdd0c661f9\', \'multiverseId\': 450100}, \'multiverseid\': 450100}]', '[{\'name\': \'Sarkhans Drachenfeuer\', \'text\': \'Sarkhans Drachenfeuer fügt einem Ziel deiner Wahl 3 Schadenspunkte zu.\\nSchaue dir die obersten fünf Karten deiner Bibliothek an. Du kannst davon eine rote Karte offen vorzeigen und auf deine Hand nehmen. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': \'„Ich bin am meisten ich selbst, wenn ich am wenigsten Mensch bin."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450279&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dde82e4e-3a47-4713-b666-e66fb6de26cb\', \'multiverseId\': 450279}, \'multiverseid\': 450279}, {\'name\': \'Fuegodragón de Sarkhan\', \'text\': \'El Fuegodragón de Sarkhan hace 3 puntos de daño a cualquier objetivo.\\nMira las cinco primeras cartas de tu biblioteca. Puedes mostrar una carta roja que se encuentre entre ellas y ponerla en tu mano. Pon el resto en el fondo de tu biblioteca en un orden aleatorio.\', \'type\': \'Conjuro\', \'flavor\': \'"Soy más auténtico cuanto menos humano".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450313&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dd539a26-cc30-4c88-83b7-a7d2dcaf23bf\', \'multiverseId\': 450313}, \'multiverseid\': 450313}, {\'name\': \'Feu des dragons de Sarkhan\', \'text\': "Le Feu des dragons de Sarkhan inflige 3 blessures à n\'importe quelle cible.\\nRegardez les cinq cartes du dessus de votre bibliothèque. Vous pouvez révéler une carte rouge parmi elles et la mettre dans votre main. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.", \'type\': \'Rituel\', \'flavor\': "« C\'est lorsque je suis le moins humain que je suis le plus proche de mon essence. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450347&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'602dd3db-0891-41bf-96fb-1513b1bee322\', \'multiverseId\': 450347}, \'multiverseid\': 450347}, {\'name\': \'Fuoco Draconico di Sarkhan\', \'text\': \'Il Fuoco Draconico di Sarkhan infligge 3 danni a un qualsiasi bersaglio.\\nGuarda le prime cinque carte del tuo grimorio. Puoi rivelare una carta rossa scelta tra esse e aggiungerla alla tua mano. Metti le altre in fondo al tuo grimorio in ordine casuale.\', \'type\': \'Stregoneria\', \'flavor\': \'"Sono pienamente me stesso quando sono meno umano."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450381&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'83d97246-290b-4cc7-8f25-ea3f242ca242\', \'multiverseId\': 450381}, \'multiverseid\': 450381}, {\'name\': \'サルカンの竜火\', \'text\': \'クリーチャー１体かプレインズウォーカー１体かプレイヤー１人を対象とする。サルカンの竜火はそれに３点のダメージを与える。\\nあなたのライブラリーの一番上からカードを５枚見る。あなたはその中から赤のカード１枚を公開してあなたの手札に加えてもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'ソーサリー\', \'flavor\': \'「一番自分らしいと感じるのは、人間とかけ離れているときだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450415&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5af286b5-666e-464d-89d6-a372141b669e\', \'multiverseId\': 450415}, \'multiverseid\': 450415}, {\'name\': \'사르칸의 용의 불\', \'text\': \'원하는 목표를 정한다. 사르칸의 용의 불은 그 목표에게 피해 3점을 입힌다.\\n당신의 서고 맨 위 카드 다섯 장을 본다. 당신은 그중에서 적색 카드 한 장을 공개하고 당신의 손으로 가져갈 수 있다. 나머지 카드들은 무작위 순서로 당신의 서고 맨 밑에 넣는다.\', \'type\': \'집중마법\', \'flavor\': \'"인간인 부분이 가장 적을 때가 나 자신에 가장 가까운 모습이다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450449&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c113c9a4-bb0c-4eca-bfd7-b89bb266cb69\', \'multiverseId\': 450449}, \'multiverseid\': 450449}, {\'name\': \'Fogo Dragônico de Sarkhan\', \'text\': \'Fogo Dragônico de Sarkhan causa 3 pontos de dano a qualquer alvo.\\nOlhe os cinco cards do topo de seu grimório. Você pode revelar um card vermelho dentre eles e colocá-lo em sua mão. Coloque o restante no fundo de seu grimório em ordem aleatória.\', \'type\': \'Feitiço\', \'flavor\': \'"É quando sou menos humano que me sinto mais próximo da minha essência."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450483&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8bed06c3-990c-4a20-87b3-c5bdfb76354d\', \'multiverseId\': 450483}, \'multiverseid\': 450483}, {\'name\': \'Драконий Огонь Сархана\', \'text\': \'Драконий Огонь Сархана наносит 3 повреждения любой цели.\\nПосмотрите пять верхних карт вашей библиотеки. Вы можете показать находящуюся среди них красную карту и положить ее в вашу руку. Положите остальные карты в низ вашей библиотеки в случайном порядке.\', \'type\': \'Волшебство\', \'flavor\': \'«Я больше всего похож на себя, когда меньше всего похож на человека».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450517&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1c624b0e-9f3a-4e7a-897e-3bfc2776586a\', \'multiverseId\': 450517}, \'multiverseid\': 450517}, {\'name\': \'萨坎的龙炎\', \'text\': \'萨坎的龙炎对任意一个目标造成3点伤害。\\n检视你牌库顶的五张牌。你可以展示其中的一张红色牌，并将它置于你手上。将其余的牌以随机顺序置于你的牌库底。\', \'type\': \'法术\', \'flavor\': \'「我的人性越少，本性越显。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450551&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'28da87b4-fb48-4774-b7b7-883a7cf29ba1\', \'multiverseId\': 450551}, \'multiverseid\': 450551}, {\'name\': \'薩坎的龍炎\', \'text\': \'薩坎的龍炎對任意一個目標造成3點傷害。\\n檢視你牌庫頂的五張牌。你可以展示其中的一張紅色牌，並將它置於你手上。將其餘的牌以隨機順序置於你的牌庫底。\', \'type\': \'巫術\', \'flavor\': \'「我的人性越少，本性越顯。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450585&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d1a90488-46cf-4bcb-8b95-d4e9e34dce23\', \'multiverseId\': 450585}, \'multiverseid\': 450585}]', '[{\'name\': \'Sarkhans Drachenwelpe\', \'text\': \'Fliegend (Diese Kreatur kann außer von fliegenden Kreaturen und Kreaturen mit Reichweite nicht geblockt werden.)\\nImmer wenn du eine Fähigkeit eines Sarkhan-Planeswalkers aktivierst, fügt Sarkhans Drachenwelpe einem Ziel deiner Wahl 1 Schadenspunkt zu.\', \'type\': \'Kreatur — Drache\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450280&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'41fc8fe3-3dad-44a0-a029-34c414b54f68\', \'multiverseId\': 450280}, \'multiverseid\': 450280}, {\'name\': \'Cría de Sarkhan\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar o alcance.)\\nSiempre que actives una habilidad de un planeswalker Sarkhan, la Cría de Sarkhan hace 1 punto de daño a cualquier objetivo.\', \'type\': \'Criatura — Dragón\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450314&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4e4a9aea-a51f-4ad3-a278-fd8fda24cf18\', \'multiverseId\': 450314}, \'multiverseid\': 450314}, {\'name\': \'Dragonnet de Sarkhan\', \'text\': "Vol (Cette créature ne peut pas être bloquée excepté par des créatures avec le vol ou la portée.)\\nÀ chaque fois que vous activez une capacité d\'un planeswalker Sarkhan, le Dragonnet de Sarkhan inflige 1 blessure à n\'importe quelle cible.", \'type\': \'Créature : dragon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450348&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'804ad940-8855-4f7d-aa71-b1d0550edecc\', \'multiverseId\': 450348}, \'multiverseid\': 450348}, {\'name\': \'Cucciolo di Sarkhan\', \'text\': "Volare (Questa creatura non può essere bloccata tranne che da creature con volare o raggiungere.)\\nOgniqualvolta attivi un\'abilità di un planeswalker Sarkhan, il Cucciolo di Sarkhan infligge 1 danno a un qualsiasi bersaglio.", \'type\': \'Creatura — Drago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450382&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2524f4b3-5f17-452f-a041-0f1995d8a707\', \'multiverseId\': 450382}, \'multiverseid\': 450382}, {\'name\': \'サルカンの仔竜\', \'text\': \'飛行（このクリーチャーは飛行や到達を持たないクリーチャーによってはブロックされない。）\\nあなたがサルカン・プレインズウォーカーの能力を起動するたび、クリーチャー１体かプレインズウォーカー１体かプレイヤー１人を対象とする。サルカンの仔竜はそれに１点のダメージを与える。\', \'type\': \'クリーチャー — ドラゴン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450416&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2b23ae39-1b1e-45c1-9612-3d9fe2b5c786\', \'multiverseId\': 450416}, \'multiverseid\': 450416}, {\'name\': \'사르칸의 새끼용\', \'text\': \'비행 (이 생물은 비행이나 대공을 가진 생물에게만 방어될 수 있다.)\\n당신이 사르칸 플레인즈워커의 능력을 활성화할 때마다, 원하는 목표를 정한다. 사르칸의 새끼용은 그 목표에게 피해 1점을 입힌다.\', \'type\': \'생물 — 용\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450450&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6ca181be-3142-4c66-8356-82f47a2b3849\', \'multiverseId\': 450450}, \'multiverseid\': 450450}, {\'name\': \'Filhote de Sarkhan\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com voar ou alcance.)\\nToda vez que você ativa uma habilidade de um planeswalker Sarkhan, Filhote de Sarkhan causa 1 ponto de dano a qualquer alvo.\', \'type\': \'Criatura — Dragão\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450484&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2674c445-7909-47e3-a354-e16d313b3e0a\', \'multiverseId\': 450484}, \'multiverseid\': 450484}, {\'name\': \'Детеныш Сархана\', \'text\': \'Полет (Это существо может быть заблокировано только существами с Полетом или Захватом.)\\nКаждый раз, когда вы активируете способность planeswalker-а Сархана, Детеныш Сархана наносит 1 повреждение любой цели.\', \'type\': \'Существо — Дракон\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450518&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c373d74a-3ee0-4cfe-9e8e-fce6dd7869d8\', \'multiverseId\': 450518}, \'multiverseid\': 450518}, {\'name\': \'萨坎的幼龙\', \'text\': \'飞行 （此生物只能被具飞行或延势异能的生物阻挡。）\\n每当你起动萨坎鹏洛客的异能时，萨坎的幼龙对任意一个目标造成1点伤害。\', \'type\': \'生物 ～龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450552&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'964f92b6-be36-466e-8e4d-102833f280ea\', \'multiverseId\': 450552}, \'multiverseid\': 450552}, {\'name\': \'薩坎的幼龍\', \'text\': \'飛行（此生物只能被具飛行或延勢異能的生物阻擋。）\\n每當你起動薩坎鵬洛客的異能時，薩坎的幼龍對任意一個目標造成1點傷害。\', \'type\': \'生物 ～龍\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450586&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'16827b24-c758-43af-b32a-e0a1b6ddef21\', \'multiverseId\': 450586}, \'multiverseid\': 450586}]', '[{\'name\': \'Sarkhans Entfesselung\', \'text\': \'Immer wenn du einen Kreaturenzauber mit Stärke 4, 5 oder 6 wirkst, fügt Sarkhans Entfesselung einem Ziel deiner Wahl 4 Schadenspunkte zu.\\nImmer wenn du einen Kreaturenzauber mit Stärke 7 oder mehr wirkst, fügt Sarkhans Entfesselung allen Gegnern sowie allen Kreaturen und Planeswalkern, die sie kontrollieren, je 4 Schadenspunkte zu.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447572&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'802749d4-1750-4229-82dd-98f18c5ccdcd\', \'multiverseId\': 447572}, \'multiverseid\': 447572}, {\'name\': \'Desatadura de Sarkhan\', \'text\': \'Siempre que lances un hechizo de criatura con fuerza de 4, 5 o 6, la Desatadura de Sarkhan hace 4 puntos de daño a cualquier objetivo.\\nSiempre que lances un hechizo de criatura con fuerza de 7 o más, la Desatadura de Sarkhan hace 4 puntos de daño a cada oponente y a cada criatura y planeswalker que controla.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447853&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'24eeef5e-be5f-4ec3-a86d-98c70ab5ce6c\', \'multiverseId\': 447853}, \'multiverseid\': 447853}, {\'name\': \'Descellement de Sarkhan\', \'text\': "À chaque fois que vous lancez un sort de créature avec une force de 4, 5 ou 6, le Descellement de Sarkhan inflige 4 blessures à n\'importe quelle cible.\\nÀ chaque fois que vous lancez un sort de créature avec une force supérieure ou égale à 7, le Descellement de Sarkhan inflige 4 blessures à chaque adversaire et à chaque créature et planeswalker qu\'il contrôle.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448134&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'55cc1e15-8857-4f23-af58-b952fee00a84\', \'multiverseId\': 448134}, \'multiverseid\': 448134}, {\'name\': \'Apertura del Sigillo di Sarkhan\', \'text\': "Ogniqualvolta lanci una magia creatura con forza pari a 4, 5 o 6, l\'Apertura del Sigillo di Sarkhan infligge 4 danni a un qualsiasi bersaglio.\\nOgniqualvolta lanci una magia creatura con forza pari o superiore a 7, l\'Apertura del Sigillo di Sarkhan infligge 4 danni a ogni avversario e a ogni creatura e planeswalker che controlla.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448415&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b11b4405-bf79-4606-b85b-511ac77f5a2e\', \'multiverseId\': 448415}, \'multiverseid\': 448415}, {\'name\': \'サルカンの封印破り\', \'text\': \'あなたが、パワーが４か５か６であるクリーチャー・呪文を唱えるたび、クリーチャー１体かプレインズウォーカー１体かプレイヤー１人を対象とする。サルカンの封印破りはそれに４点のダメージを与える。\\nあなたが、パワーが７以上であるクリーチャー・呪文を唱えるたび、サルカンの封印破りは各対戦相手と対戦相手がコントロールしている各クリーチャーと各プレインズウォーカーにそれぞれ４点のダメージを与える。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448696&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'94bd6e4c-651b-4adb-8f92-1a904a7f1b3d\', \'multiverseId\': 448696}, \'multiverseid\': 448696}, {\'name\': \'사르칸의 봉인 해제\', \'text\': \'당신이 공격력이 4, 5, 또는 6인 생물 주문을 발동할 때마다, 원하는 목표를 정한다. 사르칸의 봉인 해제는 그 목표에게 피해 4점을 입힌다.\\n당신이 공격력이 7 이상인 생물 주문을 발동할 때마다, 사르칸의 봉인 해제는 각 상대와 그들이 조종하는 각 생물과 플레인즈워커에게 피해 4점을 입힌다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448977&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1e039807-7a99-44c5-a5ac-83c1fae4672d\', \'multiverseId\': 448977}, \'multiverseid\': 448977}, {\'name\': \'Ruptura de Sarkhan\', \'text\': \'Toda vez que você conjura uma mágica de criatura com 4, 5 ou 6 de poder, Ruptura de Sarkhan causa 4 pontos de dano a qualquer alvo.\\nToda vez que você conjura uma mágica de criatura com poder igual ou superior a 7, Ruptura de Sarkhan causa 4 pontos de dano a cada oponente e a cada criatura e planeswalker que ele controla.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449258&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'669af0ac-fd92-4ad2-9224-0863bab4676f\', \'multiverseId\': 449258}, \'multiverseid\': 449258}, {\'name\': \'Распечатывание Сархана\', \'text\': \'Каждый раз, когда вы разыгрываете заклинание существа с силой 4, 5 или 6, Распечатывание Сархана наносит 4 повреждения любой цели.\\nКаждый раз, когда вы разыгрываете заклинание существа с силой не менее 7, Распечатывание Сархана наносит 4 повреждения каждому оппоненту и каждому существу и planeswalker-у под их контролем.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449539&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'448ad3f3-1b3a-4865-81ab-96a3e880a6ab\', \'multiverseId\': 449539}, \'multiverseid\': 449539}, {\'name\': \'萨坎解印\', \'text\': \'每当你施放力量为4，5或6的生物咒语时，萨坎解印对任意一个目标造成4点伤害。\\n每当你施放力量等于或大于7的生物咒语时，萨坎解印向每位对手和每个由对手操控的生物和鹏洛客各造成4点伤害。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449820&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1526dbf1-49ce-4ae1-9ed2-cf47435e7f55\', \'multiverseId\': 449820}, \'multiverseid\': 449820}, {\'name\': \'薩坎解印\', \'text\': \'每當你施放力量為4，5或6的生物咒語時，薩坎解印對任意一個目標造成4點傷害。\\n每當你施放力量等於或大於7的生物咒語時，薩坎解印向每位對手和每個由對手操控的生物和鵬洛客各造成4點傷害。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450101&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4bfaae29-472b-4d85-97e7-094e84376121\', \'multiverseId\': 450101}, \'multiverseid\': 450101}]', '[{\'name\': \'Satyr-Verzauberer\', \'text\': \'Immer wenn du einen Verzauberungszauber wirkst, ziehe eine Karte.\', \'type\': \'Kreatur — Satyr, Druide\', \'flavor\': \'„Die magischen Fäden, die diesen Ort beschützen, wurden von meinem Willen allein gesponnen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447641&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ed0a817b-bb12-4474-ae02-8dc110614028\', \'multiverseId\': 447641}, \'multiverseid\': 447641}, {\'name\': \'Encantador sátiro\', \'text\': \'Siempre que lances un hechizo de encantamiento, roba una carta.\', \'type\': \'Criatura — Druida sátiro\', \'flavor\': \'"Mi voluntad tejió los hilos de la magia que protege este lugar".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447922&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3a292b33-50ee-416e-bf94-61e8c922f95e\', \'multiverseId\': 447922}, \'multiverseid\': 447922}, {\'name\': \'Enchanteur satyre\', \'text\': "À chaque fois que vous lancez un sort d\'enchantement, piochez une carte.", \'type\': \'Créature : satyre et druide\', \'flavor\': \'« Les fils magiques qui protègent ce lieu ont été tissés par ma volonté. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448203&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c19fba90-c52b-4280-9702-fe0a348ea6c8\', \'multiverseId\': 448203}, \'multiverseid\': 448203}, {\'name\': \'Satiro Incantatore\', \'text\': \'Ogniqualvolta lanci una magia incantesimo, pesca una carta.\', \'type\': \'Creatura — Druido Satiro\', \'flavor\': \'"È stata la mia volontà a intessere le fila della magia che protegge questo luogo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448484&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b9c98199-2439-4f84-8e75-b59100f56afb\', \'multiverseId\': 448484}, \'multiverseid\': 448484}, {\'name\': \'サテュロスの結界師\', \'text\': \'あなたがエンチャント・呪文を唱えるたび、カードを１枚引く。\', \'type\': \'クリーチャー — サテュロス・ドルイド\', \'flavor\': \'「この場所を守る魔法の糸は私の意志により張られている。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448765&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e9aa3646-4df8-4fed-8299-168d02466c64\', \'multiverseId\': 448765}, \'multiverseid\': 448765}, {\'name\': \'사티로스 마법부여사\', \'text\': \'당신이 부여마법 주문을 발동할 때마다, 카드 한 장을 뽑는다.\', \'type\': \'생물 — 사티로스 드루이드\', \'flavor\': \'"이곳을 지키는 마법의 실타래는 내 의지로 짜여 있다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449046&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6d821834-e03e-4308-a249-dc6a452a4ed8\', \'multiverseId\': 449046}, \'multiverseid\': 449046}, {\'name\': \'Encantador Sátiro\', \'text\': \'Toda vez que você conjurar uma mágica de encantamento, compre um card.\', \'type\': \'Criatura — Sátiro Druida\', \'flavor\': \'"Os fios de magia que protegem este lugar foram tecidos por minha vontade."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449327&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a5dcc840-a071-47ac-ba8c-d36e46ebad4a\', \'multiverseId\': 449327}, \'multiverseid\': 449327}, {\'name\': \'Сатир-Чародей\', \'text\': \'Каждый раз, когда вы разыгрываете заклинание чар, возьмите карту.\', \'type\': \'Существо — Сатир Друид\', \'flavor\': \'«Нити магии, защищающие это место, сплетены моей волей».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449608&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6265b139-108d-413c-a63f-0dea90391f95\', \'multiverseId\': 449608}, \'multiverseid\': 449608}, {\'name\': \'施咒羊蹄人\', \'text\': \'每当你施放结界咒语时，抓一张牌。\', \'type\': \'生物 ～羊蹄人／德鲁伊\', \'flavor\': \'「保护此地的缕缕魔法由我的意志织成。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449889&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'889b2a0a-bf17-490d-b946-977b6f94d1a3\', \'multiverseId\': 449889}, \'multiverseid\': 449889}, {\'name\': \'施咒羊蹄人\', \'text\': \'每當你施放結界咒語時，抽一張牌。\', \'type\': \'生物 ～羊蹄人／德魯伊\', \'flavor\': \'「保護此地的縷縷魔法由我的意志織成。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450170&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0e07a8b3-7692-4aa3-b0d0-3ff81cc6ee78\', \'multiverseId\': 450170}, \'multiverseid\': 450170}]', '[{\'name\': \'Schauderholz-Zwillinge\', \'text\': \'Verursacht Trampelschaden (Diese Kreatur kann beim Angreifen überschüssigen Kampfschaden dem verteidigenden Spieler oder Planeswalker zufügen.)\\nDie Schauderholz-Zwillinge können in jedem Kampf eine zusätzliche Kreatur blocken.\', \'type\': \'Kreatur — Baumhirte\', \'flavor\': \'Mit jeder vergehenden Jahreszeit verwachsen sie stärker ineinander.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447598&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9bda72b8-ba49-4794-aac3-610c42b3a857\', \'multiverseId\': 447598}, \'multiverseid\': 447598}, {\'name\': \'Mellizos cortezahorror\', \'text\': \'Arrolla. (Esta criatura puede hacer el daño de combate sobrante al jugador o planeswalker al que ataca.)\\nLos Mellizos cortezahorror pueden bloquear una criatura adicional cada combate.\', \'type\': \'Criatura — Pueblo-arbóreo\', \'flavor\': \'Tienen una relación más y más estrecha con cada cambio de estación.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447879&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'00029ee8-dff4-46a0-99ca-7c9ad1402fe6\', \'multiverseId\': 447879}, \'multiverseid\': 447879}, {\'name\': \'Jumeaux pâlécorces\', \'text\': "Piétinement (Cette créature peut infliger son surplus de blessures de combat au joueur ou au planeswalker qu\'elle attaque.)\\nLes Jumeaux pâlécorces peuvent bloquer une créature supplémentaire à chaque combat.", \'type\': \'Créature : sylvin\', \'flavor\': \'Ils se rapprochent à chaque saison qui passe.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448160&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2ffe5d85-a9a6-43a1-b0d9-cea33f8ad16f\', \'multiverseId\': 448160}, \'multiverseid\': 448160}, {\'name\': \'Gemelli dalla Tetra Corteccia\', \'text\': \'Travolgere (Questa creatura può infliggere il danno da combattimento in eccesso al giocatore o al planeswalker che sta attaccando.)\\nI Gemelli dalla Tetra Corteccia possono bloccare una creatura addizionale in ogni combattimento.\', \'type\': \'Creatura — Silvantropo\', \'flavor\': \'Diventano sempre più uniti con il passare delle stagioni.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448441&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a3713831-b982-4e5c-ac81-6a66186aab54\', \'multiverseId\': 448441}, \'multiverseid\': 448441}, {\'name\': \'恐吠の双子\', \'text\': \'トランプル（このクリーチャーは余剰の戦闘ダメージをこれが攻撃しているプレイヤーかプレインズウォーカーに与えることができる。）\\n各戦闘で、恐吠の双子は追加で１体のクリーチャーをブロックできる。\', \'type\': \'クリーチャー — ツリーフォーク\', \'flavor\': \'季節が過ぎゆくにつれ、二人の仲は育ってゆく。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448722&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0d4f950c-4f5a-4274-8b40-d24f83797409\', \'multiverseId\': 448722}, \'multiverseid\': 448722}, {\'name\': \'유령껍질 쌍둥이\', \'text\': \'돌진 (이 생물은 여분의 전투피해를 공격 중인 플레이어 또는 플레인즈워커에게 입힐 수 있다.)\\n유령껍질 쌍둥이는 매 전투마다 생물 한 개를 추가로 방어할 수 있다.\', \'type\': \'생물 — 인목\', \'flavor\': \'그들은 계절이 지날 때마다 더 가깝게 자라난다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449003&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'cbaa084c-e277-4d15-9fbf-67445edd413d\', \'multiverseId\': 449003}, \'multiverseid\': 449003}, {\'name\': \'Gêmeos Cascamedonha\', \'text\': \'Atropelar (Esta criatura pode causar seu dano de combate excedente ao jogador ou planeswalker que ela estiver atacando.)\\nGêmeos Cascamedonha pode bloquear uma criatura adicional a cada combate.\', \'type\': \'Criatura — Ent\', \'flavor\': \'Eles se tornam mais próximos a cada estação que passa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449284&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'350d7202-ed34-4b8d-9b67-efe5db84395a\', \'multiverseId\': 449284}, \'multiverseid\': 449284}, {\'name\': \'Белокорые Близнецы\', \'text\': \'Пробивной удар (Это существо может нанести избыточные боевые повреждения игроку или planeswalker-у, которого атакует.)\\nБелокорые Близнецы могут блокировать дополнительное существо в каждом бою.\', \'type\': \'Существо — Лесовик\', \'flavor\': \'С каждым новым сезоном они срастаются еще теснее.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449565&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2688cdfd-9392-416f-b0bc-75aef7fe0d39\', \'multiverseId\': 449565}, \'multiverseid\': 449565}, {\'name\': \'双面白皮木\', \'text\': \'践踏（此生物造成之过量战斗伤害能对所攻击的牌手或鹏洛客造成之。）\\n双面白皮木每次战斗可以额外多阻挡一个生物。\', \'type\': \'生物 ～树妖\', \'flavor\': \'每过一季他们便靠近一些。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449846&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b062ac74-4602-4e40-8ef5-b411529c7388\', \'multiverseId\': 449846}, \'multiverseid\': 449846}, {\'name\': \'雙面白皮木\', \'text\': \'踐踏（此生物造成之過量戰鬥傷害能對所攻擊的玩家或鵬洛客造成之。）\\n雙面白皮木每次戰鬥可以額外多阻擋一個生物。\', \'type\': \'生物 ～樹妖\', \'flavor\': \'每過一季他們便靠近一些。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450127&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'dd14b2ca-2735-483c-b9b0-e723061e620f\', \'multiverseId\': 450127}, \'multiverseid\': 450127}]', '[{\'name\': \'Schildross\', \'text\': \'Das Schildross kann von roten Kreaturen nicht geblockt werden.\\nWenn das Schildross ins Spiel kommt oder das Ziel eines Zauberspruchs oder einer Fähigkeit wird, den bzw. die ein Gegner kontrolliert, erhältst du 3 Lebenspunkte dazu.\', \'type\': \'Kreatur — Pferd\', \'flavor\': \'Zieht es vorbei, siegt Ordnung über Chaos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447454&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8efdf589-20d3-4408-a618-601cb545f4b8\', \'multiverseId\': 447454}, \'multiverseid\': 447454}, {\'name\': \'Corcel de la protección\', \'text\': \'El Corcel de la protección no puede ser bloqueado por criaturas rojas.\\nCuando el Corcel de la protección entre al campo de batalla o se convierta en objetivo de un hechizo o habilidad que controla un oponente, ganas 3 vidas.\', \'type\': \'Criatura — Caballo\', \'flavor\': \'Cuando pasa, el orden vence al caos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447735&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2a9002b9-9455-4fd5-8f2a-ff5c69cfe200\', \'multiverseId\': 447735}, \'multiverseid\': 447735}, {\'name\': \'Jument du bouclier\', \'text\': "La Jument du bouclier ne peut pas être bloquée par des créatures rouges.\\nQuand la Jument du bouclier arrive sur le champ de bataille ou devient la cible d\'un sort ou d\'une capacité qu\'un adversaire contrôle, vous gagnez 3 points de vie.", \'type\': \'Créature : cheval\', \'flavor\': "Quand elle passe, l\'ordre triomphe du chaos.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448016&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b81785ec-a018-44b7-bd5a-0f084d153958\', \'multiverseId\': 448016}, \'multiverseid\': 448016}, {\'name\': \'Destriero dello Scudo\', \'text\': \'Il Destriero dello Scudo non può essere bloccato dalle creature rosse.\\nQuando il Destriero dello Scudo entra nel campo di battaglia o diventa bersaglio di una magia o abilità controllata da un avversario, guadagni 3 punti vita.\', \'type\': \'Creatura — Cavallo\', \'flavor\': "Al suo passaggio, l\'ordine trionfa sul caos.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448297&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8200f45f-6592-4fcc-adf1-6a0045a195c4\', \'multiverseId\': 448297}, \'multiverseid\': 448297}, {\'name\': \'防御牝馬\', \'text\': \'防御牝馬は赤のクリーチャーによってはブロックされない。\\n防御牝馬が戦場に出たか、対戦相手がコントロールしている呪文や能力の対象になったとき、あなたは３点のライフを得る。\', \'type\': \'クリーチャー — 馬\', \'flavor\': \'それが走り去るとき、秩序は混沌を制する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448578&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1e923914-c910-4295-bfc0-0df223d88781\', \'multiverseId\': 448578}, \'multiverseid\': 448578}, {\'name\': \'방패 암말\', \'text\': \'방패 암말은 적색 생물에게 방어될 수 없다.\\n방패 암말이 전장에 들어오거나 상대가 조종하는 주문이나 능력의 목표가 될 때, 당신은 생명 3점을 얻는다.\', \'type\': \'생물 — 말\', \'flavor\': \'그것이 지나가면, 질서가 혼돈을 무찌른다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448859&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c1c2dff5-36cb-4b93-9c7f-cfd679d1c9a3\', \'multiverseId\': 448859}, \'multiverseid\': 448859}, {\'name\': \'Égua do Escudo\', \'text\': \'Égua do Escudo não pode ser bloqueada por criaturas vermelhas.\\nQuando Égua do Escudo entra no campo de batalha ou se torna alvo de uma mágica ou habilidade que um oponente controla, você ganha 3 pontos de vida.\', \'type\': \'Criatura — Cavalo\', \'flavor\': \'Quando ela passa, a ordem derrota o caos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449140&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6d2b01b8-a7fb-408d-a09c-627a4943b0d4\', \'multiverseId\': 449140}, \'multiverseid\': 449140}, {\'name\': \'Кобылица Заслона\', \'text\': \'Кобылица Заслона не может быть заблокирована красными существами.\\nКогда Кобылица Заслона выходит на поле битвы или становится целью заклинания или способности под контролем оппонента, вы получаете 3 жизни.\', \'type\': \'Существо — Лошадь\', \'flavor\': \'Когда она скачет, порядок побеждает хаос.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449421&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5c9b8809-f4f0-4253-bd8a-7e5f0af6ec6e\', \'multiverseId\': 449421}, \'multiverseid\': 449421}, {\'name\': \'盾护牝马\', \'text\': \'盾护牝马不能被红色生物阻挡。\\n当盾护牝马进战场或成为由对手操控之咒语或异能的目标时，你获得3点生命。\', \'type\': \'生物 ～马\', \'flavor\': \'所经之处，守序之秩压乱世。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449702&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2f74b9e5-dfea-44d8-b21e-9a837271f775\', \'multiverseId\': 449702}, \'multiverseid\': 449702}, {\'name\': \'盾護牝馬\', \'text\': \'盾護牝馬不能被紅色生物阻擋。\\n當盾護牝馬進戰場或成為由對手操控之咒語或異能的目標時，你獲得3點生命。\', \'type\': \'生物 ～馬\', \'flavor\': \'所經之處，守序之秩壓亂世。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449983&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'35784705-c02e-4382-90aa-84ed1460e1de\', \'multiverseId\': 449983}, \'multiverseid\': 449983}]', '[{\'name\': \'Schlafzauber\', \'text\': \'Tappe alle Kreaturen, die ein Spieler deiner Wahl kontrolliert. Die Kreaturen enttappen nicht während des nächsten Enttappsegments jenes Spielers.\', \'type\': \'Hexerei\', \'flavor\': \'„Ich gestatte ihnen so wundersame Träume, dass sie zögern, in die Welt der Wachen zurückzukehren."\\n—Garild, Meervolkmagier\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447491&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'79835a23-0023-483c-9ec9-713799614f6d\', \'multiverseId\': 447491}, \'multiverseid\': 447491}, {\'name\': \'Dormir\', \'text\': \'Gira todas las criaturas que controla el jugador objetivo. Esas criaturas no se enderezan durante el próximo paso de enderezar de ese jugador.\', \'type\': \'Conjuro\', \'flavor\': \'"Les he dado sueños tan maravillosos que dudan si regresar al mundo consciente".\\n—Garild, hechicero tritón\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447772&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c436033d-40bc-4cb1-a6da-887b04434320\', \'multiverseId\': 447772}, \'multiverseid\': 447772}, {\'name\': \'Sommeil\', \'text\': \'Engagez toutes les créatures que le joueur ciblé contrôle. Ces créatures ne se dégagent pas pendant la prochaine étape de dégagement de ce joueur.\', \'type\': \'Rituel\', \'flavor\': "« Je leur donne des rêves si merveilleux qu\'ils hésitent à revenir dans le monde conscient. »\\n—Garild, mage ondin", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448053&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3be3a79e-4ce9-4a71-b13e-cc1af5e21285\', \'multiverseId\': 448053}, \'multiverseid\': 448053}, {\'name\': \'Dormire\', \'text\': \'TAPpa tutte le creature controllate da un giocatore bersaglio. Quelle creature non STAPpano durante il prossimo STAP di quel giocatore.\', \'type\': \'Stregoneria\', \'flavor\': \'"Do loro sogni così meravigliosi che esitano a ritornare nel mondo cosciente."\\n—Garild, mago tritone\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448334&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'39ff2bdb-0e03-4058-9c06-c5fa9b117633\', \'multiverseId\': 448334}, \'multiverseid\': 448334}, {\'name\': \'睡眠\', \'text\': \'プレイヤー１人を対象とし、そのプレイヤーがコントロールしているクリーチャーをすべてタップする。それらのクリーチャーは、そのプレイヤーの次のアンタップ・ステップにアンタップしない。\', \'type\': \'ソーサリー\', \'flavor\': \'「やつらに夢をくれてやったよ。あまりに素晴らしくて、現実世界へ帰って来たくなくなるやつをな。」\\n――マーフォークの魔道士、ガリルド\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448615&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ad0a8520-ab55-4877-b766-5e7776b7a7b2\', \'multiverseId\': 448615}, \'multiverseid\': 448615}, {\'name\': \'수면술\', \'text\': \'플레이어를 목표로 정한다. 그 플레이어가 조종하는 모든 생물을 탭한다. 그 생물들은 그 플레이어의 다음 언탭단에 언탭되지 않는다.\', \'type\': \'집중마법\', \'flavor\': \'"내가 선사하는 꿈은 너무 감미로워서 꿈꾸는 자들이 현실 세계로 돌아오는 것을 망설여하지."\\n—인어 마도사 가릴드\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448896&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e4858804-4177-42f7-b74a-830d00e0c5ea\', \'multiverseId\': 448896}, \'multiverseid\': 448896}, {\'name\': \'Dormir\', \'text\': \'Vire todas as criaturas que o jogador alvo controla. Essas criaturas não são desviradas durante a próxima etapa de desvirar daquele jogador.\', \'type\': \'Feitiço\', \'flavor\': \'"Dei-lhes sonhos tão maravilhosos que eles hesitam recobrar a consciência."\\n— Garild, tritão mago\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449177&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9ed25042-5505-4d65-b323-70c12b3bf897\', \'multiverseId\': 449177}, \'multiverseid\': 449177}, {\'name\': \'Сон\', \'text\': \'Поверните все существа под контролем целевого игрока. Те существа не разворачиваются во время следующего шага разворота того игрока.\', \'type\': \'Волшебство\', \'flavor\': \'«Я дарю им такие чудесные сны, что они неохотно возвращаются в мир бодрствующих».\\n— Гарилд, мерфолк-волшебник\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449458&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'93051276-8bbf-4461-b180-80d303a719c4\', \'multiverseId\': 449458}, \'multiverseid\': 449458}, {\'name\': \'眠梦咒\', \'text\': \'横置所有由目标牌手操控的生物。这些生物于该牌手的下一个重置步骤中不能重置。\', \'type\': \'法术\', \'flavor\': \'「我给他们的幻梦奇妙无比，让他们舍不得回到清醒的世界。」\\n～人鱼法师加俐得\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449739&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ec2f765c-f8c4-4ede-81a0-fd714fa33061\', \'multiverseId\': 449739}, \'multiverseid\': 449739}, {\'name\': \'眠夢咒\', \'text\': \'橫置所有由目標玩家操控的生物。這些生物於該玩家的下一個重置步驟中不能重置。\', \'type\': \'巫術\', \'flavor\': \'「我給他們的幻夢奇妙無比，讓他們捨不得回到清醒的世界。」\\n～人魚法師加俐得\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450020&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3b69b4be-6e34-463c-969b-71f01111deab\', \'multiverseId\': 450020}, \'multiverseid\': 450020}]', '[{\'name\': \'Schmelzen\', \'text\': \'Zerstöre ein Artefakt deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'Die alten Waffen müssen zwangsläufig den neuen weichen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447575&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b224763b-98ff-4ce5-90ea-1fdea76128c6\', \'multiverseId\': 447575}, \'multiverseid\': 447575}, {\'name\': \'Fundido\', \'text\': \'Destruye el artefacto objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'La creación de armas nuevas exige que se destruyan otras.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447856&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1c3611e6-8091-4144-b02d-fc3a9ec7c797\', \'multiverseId\': 447856}, \'multiverseid\': 447856}, {\'name\': \'Liquation\', \'text\': "Détruisez l\'artefact ciblé.", \'type\': \'Éphémère\', \'flavor\': "Créer de nouvelles armes impose d\'en détruire d\'autres.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448137&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b88847a9-6c6b-4926-98b4-c7f793fb3030\', \'multiverseId\': 448137}, \'multiverseid\': 448137}, {\'name\': \'Scorificare\', \'text\': \'Distruggi un artefatto bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'Per creare nuove armi è necessario distruggere quelle esistenti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448418&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b28e75fb-9da9-4905-ab60-74cddabe6e78\', \'multiverseId\': 448418}, \'multiverseid\': 448418}, {\'name\': \'溶解\', \'text\': \'アーティファクト１つを対象とし、それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'新しい武器ができると、他のものを破壊したくなる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448699&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'efc428ce-b9b3-4a7c-89dc-df98ec97f821\', \'multiverseId\': 448699}, \'multiverseid\': 448699}, {\'name\': \'제련\', \'text\': \'마법물체를 목표로 정한다. 그 마법물체를 파괴한다.\', \'type\': \'순간마법\', \'flavor\': \'새로운 무기의 탄생은 필연적으로 다른 무기들의 파괴로 이어진다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448980&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c1e07179-b7c8-4510-bb98-fc385a9c935d\', \'multiverseId\': 448980}, \'multiverseid\': 448980}, {\'name\': \'Fundir\', \'text\': \'Destrua o artefato alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'A criação de novas armas requer a destruição de outras.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449261&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'687d0b7c-1d97-4a2c-b729-62c51110dd54\', \'multiverseId\': 449261}, \'multiverseid\': 449261}, {\'name\': \'Расплавить\', \'text\': \'Уничтожьте целевой артефакт.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Создание нового оружия требует разрушения старого.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449542&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'52190944-10dd-4ee5-b426-2fc540d04726\', \'multiverseId\': 449542}, \'multiverseid\': 449542}, {\'name\': \'热熔\', \'text\': \'消灭目标神器。\', \'type\': \'瞬间\', \'flavor\': \'不毁旧兵，无以造新刃。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449823&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dddf533c-1aba-4e15-9f4d-1e2ef587b826\', \'multiverseId\': 449823}, \'multiverseid\': 449823}, {\'name\': \'熱熔\', \'text\': \'消滅目標神器。\', \'type\': \'瞬間\', \'flavor\': \'不毀舊兵，無以造新刃。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450104&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'84ce2699-3ab9-4453-a741-6e0f1ad9a6ac\', \'multiverseId\': 450104}, \'multiverseid\': 450104}]', '[{\'name\': \'Schmelztiegel der Welten\', \'text\': \'Du kannst Länderkarten aus deinem Friedhof spielen.\', \'type\': \'Artefakt\', \'flavor\': \'Aus der dunkelsten Asche erwachsen die stärksten Samen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447647&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ad6575ce-9c01-4abf-b26c-1254ddb6b7c7\', \'multiverseId\': 447647}, \'multiverseid\': 447647}, {\'name\': \'Crisol de mundos\', \'text\': \'Puedes jugar cartas de tierra de tu cementerio.\', \'type\': \'Artefacto\', \'flavor\': \'En las cenizas más oscuras crecen las semillas más fuertes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447928&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7f9bc593-bc63-4a80-96a7-839e29d640e1\', \'multiverseId\': 447928}, \'multiverseid\': 447928}, {\'name\': \'Creuset des mondes\', \'text\': \'Vous pouvez jouer des cartes de terrain depuis votre cimetière.\', \'type\': \'Artefact\', \'flavor\': "C\'est dans les cendres les plus noires que poussent les plantes les plus robustes.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448209&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'97f3e9af-ced3-4782-831c-b17a0c78edf8\', \'multiverseId\': 448209}, \'multiverseid\': 448209}, {\'name\': \'Crogiolo di Mondi\', \'text\': \'Puoi giocare carte terra dal tuo cimitero.\', \'type\': \'Artefatto\', \'flavor\': \'Tra le ceneri più scure crescono i semi più robusti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448490&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0bba6a14-0ed2-4656-98c3-465c670ea799\', \'multiverseId\': 448490}, \'multiverseid\': 448490}, {\'name\': \'世界のるつぼ\', \'text\': \'あなたはあなたの墓地から土地・カードをプレイしてもよい。\', \'type\': \'アーティファクト\', \'flavor\': \'漆黒の灰燼にこそ、強靱な種が芽を葺く。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448771&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'388a9195-533f-48ba-b4c1-b5978ab2df81\', \'multiverseId\': 448771}, \'multiverseid\': 448771}, {\'name\': \'세계의 도가니\', \'text\': \'당신은 당신의 무덤으로부터 대지 카드를 플레이할 수 있다.\', \'type\': \'마법물체\', \'flavor\': \'가장 새까만 잿더미에서 가장 강한 씨앗이 자라난다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449052&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c81d985d-0dbc-47f4-a31e-c5247ce2617b\', \'multiverseId\': 449052}, \'multiverseid\': 449052}, {\'name\': \'Crisol dos Mundos\', \'text\': \'Você pode jogar cards de terreno de seu cemitério.\', \'type\': \'Artefato\', \'flavor\': \'Em meio às cinzas mais escuras crescem as sementes mais fortes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449333&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ebba8c30-fe38-48cb-8618-e6f08a19fa00\', \'multiverseId\': 449333}, \'multiverseid\': 449333}, {\'name\': \'Тигель Миров\', \'text\': \'Вы можете разыгрывать карты земель из вашего кладбища.\', \'type\': \'Артефакт\', \'flavor\': \'Из самого черного пепла всходят самые сильные побеги.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449614&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8db58e32-a547-4b6a-9dcc-33b49e01cd12\', \'multiverseId\': 449614}, \'multiverseid\': 449614}, {\'name\': \'世间锤炼\', \'text\': \'你可以从你的坟墓场中使用地牌。\', \'type\': \'神器\', \'flavor\': \'从最暗沉的灰烬中长出最坚强的种子。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449895&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'215a8ddd-ccf8-4faf-a76f-87dc0660fd6d\', \'multiverseId\': 449895}, \'multiverseid\': 449895}, {\'name\': \'世間錘鍊\', \'text\': \'你可以從你的墳墓場中使用地牌。\', \'type\': \'神器\', \'flavor\': \'從最暗沉的灰燼中長出最堅強的種子。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450176&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a39783c2-c02b-4d0b-8528-7911a2ef097e\', \'multiverseId\': 450176}, \'multiverseid\': 450176}]', '[{\'name\': \'Schmälern\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur erhält -6/-0.\\nWenn die verzauberte Kreatur blockt, zerstöre sie. (Die angreifende Kreatur bleibt geblockt.)\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Der Zauberer hatte keinen Platz mehr für seine Sammlung, also musste er improvisieren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447470&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'414e95bc-0cc5-439c-8aac-23159e00c111\', \'multiverseId\': 447470}, \'multiverseid\': 447470}, {\'name\': \'Achicar\', \'text\': \'Encantar criatura.\\nLa criatura encantada obtiene -6/-0.\\nCuando la criatura encantada bloquee, destrúyela. (La criatura atacante permanece bloqueada.)\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'No había espacio para ampliar la colección, así que el hechicero improvisó una solución.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447751&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5b0a08b4-255f-4367-92ed-5880a7be9bbb\', \'multiverseId\': 447751}, \'multiverseid\': 447751}, {\'name\': \'Rétrécir\', \'text\': \'Enchanter : créature\\nLa créature enchantée gagne -6/-0.\\nQuand la créature enchantée bloque, détruisez-la. (La créature attaquante reste bloquée.)\', \'type\': \'Enchantement : aura\', \'flavor\': "Il n\'y avait plus la place de continuer la collection, le sorcier dut donc improviser.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448032&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7fe4e33b-0f66-431f-98f3-0444f602eb4f\', \'multiverseId\': 448032}, \'multiverseid\': 448032}, {\'name\': \'Diminuire\', \'text\': \'Incanta creatura\\nLa creatura incantata prende -6/-0.\\nQuando la creatura incantata blocca, distruggila. (La creatura attaccante rimane bloccata.)\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'La collezione non aveva spazio per crescere, così il mago trovò una soluzione improvvisata.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448313&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'05cf63a1-25dd-44de-8653-342b60e76d4f\', \'multiverseId\': 448313}, \'multiverseid\': 448313}, {\'name\': \'萎凋\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは－６/－０の修整を受ける。\\nエンチャントされているクリーチャーでブロックしたとき、それを破壊する。（攻撃クリーチャーはブロックされたままである。）\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'コレクションを増やす場所がなくなり、魔術師は即興の解決策を思いついた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448594&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c4934076-637f-4af6-a046-1f7fb224d0bc\', \'multiverseId\': 448594}, \'multiverseid\': 448594}, {\'name\': \'감쇠\', \'text\': \'생물에게 부여\\n부여된 생물은 -6/-0을 받는다.\\n부여된 생물이 방어할 때, 그 생물을 파괴한다. (공격 중인 생물은 방어된 채로 남는다.)\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'수집품을 늘릴 공간이 모자랐기에, 마법사는 즉흥적으로 해결책을 생각해냈다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448875&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1c45d1ec-a170-42ae-88b6-8b954257c402\', \'multiverseId\': 448875}, \'multiverseid\': 448875}, {\'name\': \'Minguar\', \'text\': \'Encantar criatura\\nA criatura encantada recebe -6/-0.\\nQuando a criatura encantada bloquear, destrua-a. (A criatura atacante permanece bloqueada.)\', \'type\': \'Encantamento — Aura\', \'flavor\': \'A coleção não tinha espaço para aumentar, de modo que o mago improvisou uma solução.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449156&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5f13f4bc-ae4f-44e3-b16f-9c767a028db4\', \'multiverseId\': 449156}, \'multiverseid\': 449156}, {\'name\': \'Съеживание\', \'text\': \'Зачаровать существо\\nЗачарованное существо получает -6/-0.\\nКогда зачарованное существо блокирует, уничтожьте его. (Атакующее существо остается заблокированным.)\', \'type\': \'Чары — Аура\', \'flavor\': \'У волшебника не хватало места для растущей коллекции, так что пришлось импровизировать.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449437&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'403d90f9-c5fe-47a7-b9c3-48fd47ac48d6\', \'multiverseId\': 449437}, \'multiverseid\': 449437}, {\'name\': \'缩微\', \'text\': \'结附于生物\\n所结附的生物得-6/-0。\\n当所结附的生物进行阻挡时，将它消灭。（攻击生物仍已被阻挡。）\', \'type\': \'结界 ～灵气\', \'flavor\': \'由于无处摆放更多藏品，法术师即兴想出了一个解决方法。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449718&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'22caaa96-9d9b-46d0-b114-673926977302\', \'multiverseId\': 449718}, \'multiverseid\': 449718}, {\'name\': \'縮微\', \'text\': \'結附於生物\\n所結附的生物得-6/-0。\\n當所結附的生物進行阻擋時，將它消滅。（攻擊生物仍已被阻擋。）\', \'type\': \'結界 ～靈氣\', \'flavor\': \'由於無處擺放更多藏品，魔法師即興想出了一個解決方法。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449999&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3d358884-312c-462a-8342-5c201ee2575f\', \'multiverseId\': 449999}, \'multiverseid\': 449999}]', '[{\'name\': \'Schnappender Sceada\', \'text\': \'Fliegend\', \'type\': \'Kreatur — Sceada\', \'flavor\': \'Übellaunig, schlecht abgerichtet und störrisch wie ein Maultier: Der Sceada ist der perfekte Prüfstein für seinen Beherrscher.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447492&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8f07df7a-5750-4e85-8b62-a7c48c237c8a\', \'multiverseId\': 447492}, \'multiverseid\': 447492}, {\'name\': \'Draco mordiente\', \'text\': \'Vuela.\', \'type\': \'Criatura — Draco\', \'flavor\': \'El draco tiene un genio de mil demonios, cuesta mucho educarlo y es tan testarudo como una mula: es la prueba perfecta de la fuerza de voluntad de su amo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447773&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4481d071-755c-443f-b0a1-729a86bf7367\', \'multiverseId\': 447773}, \'multiverseid\': 447773}, {\'name\': \'Drakôn happeur\', \'text\': \'Vol\', \'type\': \'Créature : drakôn\', \'flavor\': "Véritable tête de mule, d\'humeur toujours massacrante et de surcroît mal dressé, le drakôn représente le test idéal pour la volonté de son maître.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448054&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'255629e5-3676-4605-9acd-61a0e8f066c3\', \'multiverseId\': 448054}, \'multiverseid\': 448054}, {\'name\': \'Draghetto Azzannatore\', \'text\': \'Volare\', \'type\': \'Creatura — Draghetto\', \'flavor\': \'Con un brutto carattere, mal addestrato e testardo come un mulo, il draghetto è la prova perfetta per la volontà del maestro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448335&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'992e65b3-46de-4f22-a36c-707a44308b9b\', \'multiverseId\': 448335}, \'multiverseid\': 448335}, {\'name\': \'噛みつきドレイク\', \'text\': \'飛行\', \'type\': \'クリーチャー — ドレイク\', \'flavor\': \'下劣な性格で、ほとんど訓練されず、ラバ並みに頑固なドレイクこそ、主人の意思を試すには完璧な材料だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448616&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'337bef2b-e28d-4cc5-90f2-ee61fde4daca\', \'multiverseId\': 448616}, \'multiverseid\': 448616}, {\'name\': \'달려드는 드레이크\', \'text\': \'비행\', \'type\': \'생물 — 드레이크\', \'flavor\': \'성질이 고약하고, 잘 훈련되지 않았으며, 노새처럼 고집 센 드레이크는 주인의 의지를 시험하기에 딱 좋은 생물이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448897&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'06b00e9a-6f65-475f-862a-74bd4d047bb3\', \'multiverseId\': 448897}, \'multiverseid\': 448897}, {\'name\': \'Dragonete Trinchador\', \'text\': \'Voar\', \'type\': \'Criatura — Dragonete\', \'flavor\': \'Mal-humorado, com pouco treinamento e teimoso como uma mula, o dragonete é o teste perfeito para a força de vontade do mestre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449178&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3a03fee6-e95e-47b8-94cd-ce33078e5bd3\', \'multiverseId\': 449178}, \'multiverseid\': 449178}, {\'name\': \'Кусачий Дрейк\', \'text\': \'Полет\', \'type\': \'Существо — Дрейк\', \'flavor\': \'Вспыльчивый, плохо обучаемый и упрямый как осел, дрейк станет идеальным испытанием силы воли своего хозяина.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449459&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b3736980-942a-4efd-8e41-226267d15c79\', \'multiverseId\': 449459}, \'multiverseid\': 449459}, {\'name\': \'闪光龙兽\', \'text\': \'飞行\', \'type\': \'生物 ～龙兽\', \'flavor\': \'这龙兽的脾气暴躁，训练不足，个性固执，非常适合测试主人的意志。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449740&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'02b0a762-0336-4434-8387-1b9567cccf87\', \'multiverseId\': 449740}, \'multiverseid\': 449740}, {\'name\': \'閃光龍獸\', \'text\': \'飛行\', \'type\': \'生物 ～龍獸\', \'flavor\': \'這龍獸的脾氣暴躁，訓練不足，個性固執，非常適合測試主人的意志。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450021&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'df6e6b97-cf9f-442d-921a-37f55c3c62be\', \'multiverseId\': 450021}, \'multiverseid\': 450021}]', '[{\'name\': \'Schock\', \'text\': \'Der Schock fügt einem Ziel deiner Wahl 2 Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'Die Werkzeuge der Erfinder wurden zu Waffen der Revolution.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447573&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'10ac2812-6b02-46da-9ad7-69add3da07a3\', \'multiverseId\': 447573}, \'multiverseid\': 447573}, {\'name\': \'Choque\', \'text\': \'El Choque hace 2 puntos de daño a cualquier objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'Las herramientas de invención se convirtieron en las armas de la revolución.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447854&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'28092626-2777-4c7e-b7d5-4357bbbc690f\', \'multiverseId\': 447854}, \'multiverseid\': 447854}, {\'name\': \'Choc\', \'text\': "Le Choc inflige 2 blessures à n\'importe quelle cible.", \'type\': \'Éphémère\', \'flavor\': "Les outils de l\'invention devinrent les armes de la révolution.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448135&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9beabd8a-89cd-4de1-904f-7e658e9f3a38\', \'multiverseId\': 448135}, \'multiverseid\': 448135}, {\'name\': \'Shock\', \'text\': \'Lo Shock infligge 2 danni a un qualsiasi bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': "Gli strumenti dell\'invenzione divennero le armi della rivoluzione.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448416&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e16d94c3-e1fd-4a9c-9150-c386b5c2a34e\', \'multiverseId\': 448416}, \'multiverseid\': 448416}, {\'name\': \'ショック\', \'text\': \'クリーチャー１体かプレインズウォーカー１体かプレイヤー１人を対象とする。ショックはそれに２点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'発明の賜物が革命の業物になった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448697&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'36e52ff9-1ae3-4b0b-8ee4-4d424d379a72\', \'multiverseId\': 448697}, \'multiverseid\': 448697}, {\'name\': \'충격\', \'text\': \'원하는 목표를 정한다. 충격은 그 목표에게 피해 2점을 입힌다.\', \'type\': \'순간마법\', \'flavor\': \'발명의 도구가 혁명의 무기가 되었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448978&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f356f9e5-59f1-4216-b089-16b753732c0f\', \'multiverseId\': 448978}, \'multiverseid\': 448978}, {\'name\': \'Choque\', \'text\': \'Choque causa 2 pontos de dano a qualquer alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'As ferramentas da invenção tornaram-se as armas da revolução.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449259&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7ee64a19-c659-42c1-862d-d4e682421b06\', \'multiverseId\': 449259}, \'multiverseid\': 449259}, {\'name\': \'Шок\', \'text\': \'Шок наносит 2 повреждения любой цели.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Инструменты изобретателей стали оружием революции.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449540&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b028c2ff-e679-4337-a6de-5b6f04878f76\', \'multiverseId\': 449540}, \'multiverseid\': 449540}, {\'name\': \'电震\', \'text\': \'电震对任意一个目标造成2点伤害。\', \'type\': \'瞬间\', \'flavor\': \'发明的工具成为了革命的武器。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449821&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ebf87353-1d87-4159-a473-7a62e81ef3ec\', \'multiverseId\': 449821}, \'multiverseid\': 449821}, {\'name\': \'電震\', \'text\': \'電震對任意一個目標造成2點傷害。\', \'type\': \'瞬間\', \'flavor\': \'發明的工具成為了革命的武器。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450102&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c90be96b-4624-4e5a-a829-4c0b215f9aba\', \'multiverseId\': 450102}, \'multiverseid\': 450102}]', '[{\'name\': \'Schurkenhandschuhe\', \'text\': \'Immer wenn die ausgerüstete Kreatur einem Spieler Kampfschaden zufügt, kannst du eine Karte ziehen.\\nAusrüsten {2} ({2}: Lege diese Karte an eine Kreatur deiner Wahl an, die du kontrollierst. Spiele Ausrüsten wie eine Hexerei.)\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': \'Diebstahl muss von Anfang bis zum Ende mit äußerster Raffinesse durchgeführt werden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447661&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dd181fab-c25b-4e44-a589-e83b649fb525\', \'multiverseId\': 447661}, \'multiverseid\': 447661}, {\'name\': \'Guantes del bribón\', \'text\': \'Siempre que la criatura equipada haga daño de combate a un jugador, puedes robar una carta.\\nEquipar {2}. ({2}: Anexa este Equipo a la criatura objetivo que controlas. Activa la habilidad de equipar como un conjuro.)\', \'type\': \'Artefacto — Equipo\', \'flavor\': \'Robar requiere sutileza desde el comienzo del hurto hasta el final.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447942&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'93ebaeb5-59ae-46c1-acbd-0ea3e2620479\', \'multiverseId\': 447942}, \'multiverseid\': 447942}, {\'name\': \'Gants de gredin\', \'text\': "À chaque fois que la créature équipée inflige des blessures de combat à un joueur, vous pouvez piocher une carte.\\nÉquipement {2} ({2} : Attachez à la créature ciblée que vous contrôlez. N\'attachez l\'équipement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Artefact : équipement\', \'flavor\': \'Le vol requiert une certaine subtilité, du début à la fin du cambriolage.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448223&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b69d6a30-b298-4e57-8028-b76bf4a58d16\', \'multiverseId\': 448223}, \'multiverseid\': 448223}, {\'name\': \'Guanti del Farabutto\', \'text\': \'Ogniqualvolta la creatura equipaggiata infligge danno da combattimento a un giocatore, puoi pescare una carta.\\nEquipaggiare {2} ({2}: Assegna a una creatura bersaglio che controlli. Equipaggia solo quando potresti lanciare una stregoneria.)\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': "Il ladrocinio richiede delicatezza, dall\'inizio alla fine del colpo.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448504&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a7874293-fc74-448b-a6dd-cd02d5108b5d\', \'multiverseId\': 448504}, \'multiverseid\': 448504}, {\'name\': \'ならず者の手袋\', \'text\': \'装備しているクリーチャーがプレイヤー１人に戦闘ダメージを与えるたび、あなたはカードを１枚引いてもよい。\\n装備{2}（{2}：あなたがコントロールしているクリーチャー１体を対象とし、これをそれにつける。装備はソーサリーとしてのみ行う。）\', \'type\': \'アーティファクト — 装備品\', \'flavor\': \'初めから終わりまで、盗みには繊細さが欠かせない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448785&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'21f7cdb7-efb8-4748-af6a-e64541f8401f\', \'multiverseId\': 448785}, \'multiverseid\': 448785}, {\'name\': \'도적의 장갑\', \'text\': \'장착된 생물이 플레이어에게 전투피해를 입힐 때마다, 당신은 카드 한 장을 뽑을 수 있다.\\n장착 {2} ({2}: 당신이 조종하는 생물을 목표로 정한다. 그 생물에 이 장비를 부착한다. 당신이 집중마법을 발동할 수 있는 시기에만 장착할 수 있다.)\', \'type\': \'마법물체 — 장비\', \'flavor\': \'도둑질은 그 시작부터 끝까지 교묘함을 필요로 한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449066&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4fb9c7be-5b82-476e-a196-b70cb8028814\', \'multiverseId\': 449066}, \'multiverseid\': 449066}, {\'name\': \'Luvas de Ladino\', \'text\': \'Toda vez que a criatura equipada causa dano de combate a um jogador, você pode comprar um card.\\nEquipar {2} ({2}: Anexe à criatura alvo que você controla. Equipe somente como um feitiço.)\', \'type\': \'Artefato — Equipamento\', \'flavor\': \'A ladroagem requer sutileza, do início ao fim do roubo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449347&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ad10b9c3-9abb-477a-bad6-417bcb2f7bf2\', \'multiverseId\': 449347}, \'multiverseid\': 449347}, {\'name\': \'Перчатки Плута\', \'text\': \'Каждый раз, когда снаряженное существо наносит боевые повреждения игроку, вы можете взять карту.\\nСнарядить {2} ({2}: прикрепите к целевому существу под вашим контролем. Снаряжайте только как волшебство.)\', \'type\': \'Артефакт — Снаряжение\', \'flavor\': \'Воровство требует деликатности — от начала кражи и до самого конца.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449628&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'55e17b68-6d18-416c-b681-c1e74b4f07bd\', \'multiverseId\': 449628}, \'multiverseid\': 449628}, {\'name\': \'浪客手套\', \'text\': \'每当佩带此武具的生物对任一牌手造成战斗伤害时，你可以抓一张牌。\\n佩带{2}（{2}：装备在目标由你操控的生物上。佩带的时机视同法术。）\', \'type\': \'神器 ～武具\', \'flavor\': \'盗窃需要从始至终都心细。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449909&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ed0f8057-135a-4c8a-a91e-a04635fb6c3c\', \'multiverseId\': 449909}, \'multiverseid\': 449909}, {\'name\': \'浪客手套\', \'text\': \'每當佩帶此武具的生物對任一玩家造成戰鬥傷害時，你可以抽一張牌。\\n佩帶{2}（{2}：裝備在目標由你操控的生物上。佩帶的時機視同巫術。）\', \'type\': \'神器 ～武具\', \'flavor\': \'盜竊需要從始至終都心細。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450190&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'260fcc3d-929f-4e35-a19b-5d8f95a3393f\', \'multiverseId\': 450190}, \'multiverseid\': 450190}]', '[{\'name\': \'Serras Wächterin\', \'text\': \'Fliegend\\nWachsamkeit (Diese Kreatur wird beim Angreifen nicht getappt.)\\nAndere Kreaturen, die du kontrollierst, haben Wachsamkeit.\', \'type\': \'Kreatur — Engel\', \'flavor\': \'Sie wacht über die Stadt, so wie Serra über alles wacht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450265&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'46a657c0-ddae-4d2f-ac43-ee93890cec64\', \'multiverseId\': 450265}, \'multiverseid\': 450265}, {\'name\': \'Guardiana de Serra\', \'text\': \'Vuela.\\nVigilancia. (Esta criatura no se gira al atacar.)\\nLas otras criaturas que controlas tienen la habilidad de vigilancia.\', \'type\': \'Criatura — Ángel\', \'flavor\': \'Custodia la ciudad de la misma forma que Serra lo custodia todo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450299&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a5d18faa-47e3-455f-9531-2e75bdb8fb9f\', \'multiverseId\': 450299}, \'multiverseid\': 450299}, {\'name\': \'Vigile de Serra\', \'text\': "Vol\\nVigilance (Attaquer avec cette créature ne la fait pas s\'engager.)\\nLes autres créatures que vous contrôlez ont la vigilance.", \'type\': \'Créature : ange\', \'flavor\': \'Elle protège la ville, Serra protège tout.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450333&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'72cdfac2-df27-4ae1-83cd-5ba8bde6ff11\', \'multiverseId\': 450333}, \'multiverseid\': 450333}, {\'name\': \'Guardiana di Serra\', \'text\': \'Volare\\nCautela (Questa creatura attacca senza TAPpare.)\\nLe altre creature che controlli hanno cautela.\', \'type\': \'Creatura — Angelo\', \'flavor\': \'Vigila sulla città proprio come Serra vigila su ogni cosa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450367&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5067c9a9-461f-4b1d-87ae-a943b99850dd\', \'multiverseId\': 450367}, \'multiverseid\': 450367}, {\'name\': \'セラの守護者\', \'text\': \'飛行\\n警戒（このクリーチャーは攻撃してもタップしない。）\\nあなたがコントロールしている他のクリーチャーは警戒を持つ。\', \'type\': \'クリーチャー — 天使\', \'flavor\': \'セラがすべてを見渡すのと同様に、彼女は街全体を見張っている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450401&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d8402b99-e776-416b-a8f9-0186f9727b89\', \'multiverseId\': 450401}, \'multiverseid\': 450401}, {\'name\': \'세라의 수호자\', \'text\': \'비행\\n경계 (이 생물은 공격하면서 탭되지 않는다.)\\n당신이 조종하는 다른 생물들은 경계를 가진다.\', \'type\': \'생물 — 천사\', \'flavor\': \'그녀는 세라가 만물을 보호하는 것처럼 도시를 보호한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450435&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'61a2c728-6a2c-4d93-911a-cc9bec8c4939\', \'multiverseId\': 450435}, \'multiverseid\': 450435}, {\'name\': \'Guardiã de Serra\', \'text\': \'Voar\\nVigilância (Esta criatura não é virada para atacar.)\\nAs outras criaturas que você controla têm vigilância.\', \'type\': \'Criatura — Anjo\', \'flavor\': \'Ela vela pela cidade assim como Serra vela por todos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450469&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'005c9a54-bd20-4e45-b872-aa84af8824f1\', \'multiverseId\': 450469}, \'multiverseid\': 450469}, {\'name\': \'Стражница Серры\', \'text\': \'Полет\\nБдительность (Атакуя, это существо не поворачивается.)\\nДругие существа под вашим контролем имеют Бдительность.\', \'type\': \'Существо — Ангел\', \'flavor\': \'Она охраняет город, как Серра охраняет все сущее.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450503&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8cdec82e-d023-4275-8233-078e29a65829\', \'multiverseId\': 450503}, \'multiverseid\': 450503}, {\'name\': \'撒拉守护使\', \'text\': \'飞行\\n警戒（此生物攻击时不需横置。）\\n由你操控的其他生物具有警戒异能。\', \'type\': \'生物 ～天使\', \'flavor\': \'她像撒拉守护众生一般保卫全城。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450537&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e9117ea9-5a34-4bbb-9769-98b92ea368fc\', \'multiverseId\': 450537}, \'multiverseid\': 450537}, {\'name\': \'撒拉守護使\', \'text\': \'飛行\\n警戒（此生物攻擊時不需橫置。）\\n由你操控的其他生物具有警戒異能。\', \'type\': \'生物 ～天使\', \'flavor\': \'她像撒拉守護眾生一般保衛全城。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450571&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'60ca68dc-f90a-448f-bc28-d06f43501e96\', \'multiverseId\': 450571}, \'multiverseid\': 450571}]', '[{\'name\': \'Shivan-Drache\', \'text\': \'Fliegend (Diese Kreatur kann außer von fliegenden Kreaturen und Kreaturen mit Reichweite nicht geblockt werden.)\\n{R}: Der Shivan-Drache erhält +1/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Drache\', \'flavor\': \'Er ist der uneingeschränkte Herrscher über die Berge von Shiv.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450281&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5950f960-0d36-4526-93c8-77035e5d5f96\', \'multiverseId\': 450281}, \'multiverseid\': 450281}, {\'name\': \'Dragón shivano\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar o alcance.)\\n{R}: El Dragón shivano obtiene +1/+0 hasta el final del turno.\', \'type\': \'Criatura — Dragón\', \'flavor\': \'Es el señor indisputable de las montañas de Shiv.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450315&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'28870a77-bc7f-43e5-8a70-1062188c35e1\', \'multiverseId\': 450315}, \'multiverseid\': 450315}, {\'name\': \'Dragon shivân\', \'text\': "Vol (Cette créature ne peut pas être bloquée excepté par des créatures avec le vol ou la portée.)\\n{R} : Le Dragon shivân gagne +1/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : dragon\', \'flavor\': "C\'est le maître incontesté des montagnes de Shiv.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450349&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'075c4bb4-5140-44ed-9093-c1700d72e735\', \'multiverseId\': 450349}, \'multiverseid\': 450349}, {\'name\': \'Drago di Shivan\', \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare o raggiungere.)\\n{R}: Il Drago di Shivan prende +1/+0 fino alla fine del turno.\', \'type\': \'Creatura — Drago\', \'flavor\': \'Il Signore incontrastato delle montagne di Shiv.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450383&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c28d0560-64fd-4560-b89a-8809388d65d4\', \'multiverseId\': 450383}, \'multiverseid\': 450383}, {\'name\': \'シヴ山のドラゴン\', \'text\': \'飛行（このクリーチャーは飛行や到達を持たないクリーチャーによってはブロックされない。）\\n{R}：ターン終了時まで、シヴ山のドラゴンは＋１/＋０の修整を受ける。\', \'type\': \'クリーチャー — ドラゴン\', \'flavor\': \'まぎれもなくシヴの山々の主である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450417&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'39437320-a1d1-4be5-93c9-c20b7fdaaa61\', \'multiverseId\': 450417}, \'multiverseid\': 450417}, {\'name\': \'시브의 용\', \'text\': \'비행 (이 생물은 비행이나 대공을 가진 생물에게만 방어될 수 있다.)\\n{R}: 시브의 용은 턴종료까지 +1/+0을 받는다.\', \'type\': \'생물 — 용\', \'flavor\': \'누구도 부인하지 않는 시브 산맥의 주인.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450451&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1e0f71b2-fed6-4bb8-b004-373facaccf28\', \'multiverseId\': 450451}, \'multiverseid\': 450451}, {\'name\': \'Dragão de Shiva\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com voar ou alcance.)\\n{R}: Dragão de Shiva recebe +1/+0 até o final do turno.\', \'type\': \'Criatura — Dragão\', \'flavor\': \'O senhor inquestionável das montanhas de Shiv.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450485&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ade17824-60a0-4e8c-8d80-aa834a622d86\', \'multiverseId\': 450485}, \'multiverseid\': 450485}, {\'name\': \'Шиванский Дракон\', \'text\': \'Полет (Это существо может быть заблокировано только существами с Полетом или Захватом.)\\n{R}: Шиванский Дракон получает +1/+0 до конца хода.\', \'type\': \'Существо — Дракон\', \'flavor\': \'Неоспоримый хозяин Шиванских гор.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450519&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'70a7ef72-df85-4dd8-b0f9-773620345f2e\', \'multiverseId\': 450519}, \'multiverseid\': 450519}, {\'name\': \'西瓦巨龙\', \'text\': \'飞行 （此生物只能被具飞行或延势异能的生物阻挡。）\\n{R}：西瓦巨龙得+1/+0直到回合结束。\', \'type\': \'生物 ～龙\', \'flavor\': \'西瓦山脉无庸置疑的主人。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450553&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1d3c0611-c0af-49fd-b372-775248fbade0\', \'multiverseId\': 450553}, \'multiverseid\': 450553}, {\'name\': \'西瓦巨龍\', \'text\': \'飛行（此生物只能被具飛行或延勢異能的生物阻擋。）\\n{R}：西瓦巨龍得+1/+0直到回合結束。\', \'type\': \'生物 ～龍\', \'flavor\': \'西瓦山脈無庸置疑的主人。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450587&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4b58859a-2b0e-43b6-90d7-0a710ca24dac\', \'multiverseId\': 450587}, \'multiverseid\': 450587}]', '[{\'name\': \'Sich verziehen\', \'text\': \'Bringe eine bleibende Karte deiner Wahl, die kein Land ist, auf die Hand ihres Besitzers zurück.\', \'type\': \'Spontanzauber\', \'flavor\': \'Festhalten ist zwecklos, wenn es nichts gibt, an dem du dich festhalten kannst.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447467&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b20d7da3-de73-4d63-8df9-7c1f2c53e45b\', \'multiverseId\': 447467}, \'multiverseid\': 447467}, {\'name\': \'Dispersar\', \'text\': \'Regresa el permanente objetivo que no sea tierra a la mano de su propietario.\', \'type\': \'Instantáneo\', \'flavor\': \'No tiene sentido aferrarse cuando no tienes nada con lo que aferrarte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447748&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'455591b6-2aaf-4edc-96e0-4d7becae4875\', \'multiverseId\': 447748}, \'multiverseid\': 447748}, {\'name\': \'Dispersion\', \'text\': \'Renvoyez le permanent non-terrain ciblé dans la main de son propriétaire.\', \'type\': \'Éphémère\', \'flavor\': "Se retenir devient futile quand vous n\'avez plus rien pour vous retenir.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448029&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'121422cd-23f3-4934-9b28-f702db0e5f6e\', \'multiverseId\': 448029}, \'multiverseid\': 448029}, {\'name\': \'Disperdere\', \'text\': \'Fai tornare un permanente non terra bersaglio in mano al suo proprietario.\', \'type\': \'Istantaneo\', \'flavor\': \'È inutile resistere quando non hai nulla a cui aggrapparti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448310&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e50a16f3-a0e3-4de3-b2a4-790cd2fa8508\', \'multiverseId\': 448310}, \'multiverseid\': 448310}, {\'name\': \'分散\', \'text\': \'土地でないパーマネント１つを対象とし、それをオーナーの手札に戻す。\', \'type\': \'インスタント\', \'flavor\': \'留まるための手段がないのに、留まろうとしても無駄なことだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448591&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'407e0404-a594-4bae-ae0e-7f69bd464be2\', \'multiverseId\': 448591}, \'multiverseid\': 448591}, {\'name\': \'분산\', \'text\': \'대지가 아닌 지속물을 목표로 정한다. 그 지속물을 소유자의 손으로 되돌린다.\', \'type\': \'순간마법\', \'flavor\': \'의지할 것이 없는데 버티는 것은 의미가 없다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448872&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6d328c3d-bbf9-4586-87e7-8aadd1710fa1\', \'multiverseId\': 448872}, \'multiverseid\': 448872}, {\'name\': \'Dispersar\', \'text\': \'Devolva a permanente alvo que não seja um terreno para a mão de seu dono.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'É inútil resistir quando você não tem nada com que resistir.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449153&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2d967ac4-f89e-4143-af9c-e362fbe366e1\', \'multiverseId\': 449153}, \'multiverseid\': 449153}, {\'name\': \'Рассеивание\', \'text\': \'Верните целевой не являющийся землей перманент в руку его владельца.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Нет смысла держаться, если держаться тебе нечем.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449434&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b79dc90a-483c-49dc-b3c0-4c34ea39f9c8\', \'multiverseId\': 449434}, \'multiverseid\': 449434}, {\'name\': \'驱散\', \'text\': \'将目标非地永久物移回其拥有者手上。\', \'type\': \'瞬间\', \'flavor\': \'当你没有坚持下去的目标时，坚持是没有意义的。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449715&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3d00cfa7-8b60-4234-9e64-0f10d3267c3a\', \'multiverseId\': 449715}, \'multiverseid\': 449715}, {\'name\': \'驅散\', \'text\': \'將目標非地永久物移回其擁有者手上。\', \'type\': \'瞬間\', \'flavor\': \'當你沒有堅持下去的目標時，堅持是沒有意義的。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449996&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e24a6380-3066-4f70-87c3-61f0f37ab9c1\', \'multiverseId\': 449996}, \'multiverseid\': 449996}]', '[{\'name\': \'Sicherer Stoß\', \'text\': \'Eine Kreatur deiner Wahl erhält +3/+0 und Erstschlag bis zum Ende des Zuges. (Sie fügt Kampfschaden vor Kreaturen ohne Erstschlag zu.)\', \'type\': \'Spontanzauber\', \'flavor\': \'So manche tollkühne Seele sprang dem Tod von der Schippe, weil sie erst handelte und sich später fürchtete.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447578&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'923f9bbf-ba0a-418d-940a-994af0faf91c\', \'multiverseId\': 447578}, \'multiverseid\': 447578}, {\'name\': \'Arremetida segura\', \'text\': \'La criatura objetivo obtiene +3/+0 y gana la habilidad de dañar primero hasta el final del turno. (Hace daño de combate antes que las criaturas sin la habilidad de dañar primero.)\', \'type\': \'Instantáneo\', \'flavor\': \'A veces, para sobrevivir al fracaso inminente, se necesita un alma inocente que actúe primero y se asuste después.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447859&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d8e96b6f-cb0a-438c-a9be-5ec7bdfa3fbb\', \'multiverseId\': 447859}, \'multiverseid\': 447859}, {\'name\': \'Frappe assurée\', \'text\': "La créature ciblée gagne +3/+0 et acquiert l\'initiative jusqu\'à la fin du tour. (Elle inflige des blessures de combat avant les créatures sans l\'initiative.)", \'type\': \'Éphémère\', \'flavor\': "Pour survivre à une mort imminente, il faut parfois qu\'une âme téméraire agisse avant de succomber à ses peurs.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448140&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3884afbd-2f9a-47f0-b458-fa3083731530\', \'multiverseId\': 448140}, \'multiverseid\': 448140}, {\'name\': \'Colpo Sicuro\', \'text\': \'Una creatura bersaglio prende +3/+0 e ha attacco improvviso fino alla fine del turno. (Infligge danno da combattimento prima delle creature senza attacco improvviso.)\', \'type\': \'Istantaneo\', \'flavor\': "Per sopravvivere alla tragedia imminente, a volte serve un\'anima avventata, che prima agisca e poi si spaventi.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448421&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'83152c39-c3ed-4bac-b512-e926345cbc54\', \'multiverseId\': 448421}, \'multiverseid\': 448421}, {\'name\': \'確実な一撃\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋３/＋０の修整を受け、先制攻撃を得る。（これは先制攻撃を持たないクリーチャーよりも先に戦闘ダメージを与える。）\', \'type\': \'インスタント\', \'flavor\': \'死を目前にすると、恐れるより先に無謀な行動をする者がいる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448702&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ef8bf7f2-dc63-41b3-81b4-722567089275\', \'multiverseId\': 448702}, \'multiverseid\': 448702}, {\'name\': \'확실한 일격\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 +3/+0을 받고 선제공격을 얻는다. (그 생물은 선제공격이 없는 생물보다 먼저 전투피해를 입힌다.)\', \'type\': \'순간마법\', \'flavor\': \'임박한 파멸에서 살아남으려면 때로는 가장 먼저 행동하고 나중에 두려워하는 무모한 자가 필요하다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448983&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'942d84fd-f94c-40ee-a3e9-b98bcc2200da\', \'multiverseId\': 448983}, \'multiverseid\': 448983}, {\'name\': \'Golpe Certeiro\', \'text\': \'A criatura alvo recebe +3/+0 e ganha iniciativa até o final do turno. (Ela causa dano de combate antes das criaturas sem iniciativa.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Às vezes, para sobreviver a um fim iminente, é necessário ter uma alma temerária que aja primeiro e tema depois.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449264&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'22a3ff7a-7d70-488a-a14d-48a6e0acaae4\', \'multiverseId\': 449264}, \'multiverseid\': 449264}, {\'name\': \'Верный Удар\', \'text\': \'Целевое существо получает +3/+0 и Первый удар до конца хода. (Оно наносит боевые повреждения раньше существ без Первого удара.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Чтобы спастись от верной гибели, иногда нужен безрассудный боец, который сначала будет действовать, а уже потом — бояться.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449545&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d86210ab-34b5-403d-986e-00940a1c8aad\', \'multiverseId\': 449545}, \'multiverseid\': 449545}, {\'name\': \'必中一击\', \'text\': \'直到回合结束，目标生物得+3/+0且获得先攻异能。（它会比不具先攻异能的生物提前造成战斗伤害。）\', \'type\': \'瞬间\', \'flavor\': \'在末日来临之时，想要生存，有时需要鲁莽之士的义无反顾。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449826&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'690d1227-0ac9-42e7-8bd1-5e60ac67c6e0\', \'multiverseId\': 449826}, \'multiverseid\': 449826}, {\'name\': \'必中一擊\', \'text\': \'直到回合結束，目標生物得+3/+0且獲得先攻異能。（它會比不具先攻異能的生物提前造成戰鬥傷害。）\', \'type\': \'瞬間\', \'flavor\': \'在末日來臨之時，想要生存，有時需要魯莽之士的義無反顧。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450107&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4a43317f-1397-4298-981f-67012d87ba84\', \'multiverseId\': 450107}, \'multiverseid\': 450107}]', "[{'name': 'Siegelschwert von Valeron', 'text': 'Die ausgerüstete Kreatur erhält +2/+0, hat Wachsamkeit und ist zusätzlich zu ihren anderen Typen ein Ritter.\\nImmer wenn die ausgerüstete Kreatur angreift, erzeuge einen angreifenden 2/2 weißen Ritter-Kreaturenspielstein mit Wachsamkeit.\\nAusrüsten {3}', 'type': 'Artefakt — Ausrüstung', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447662&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'aac4936b-9d37-40e5-9474-b8271f041c5d', 'multiverseId': 447662}, 'multiverseid': 447662}, {'name': 'Espada con sellos de Valeron', 'text': 'La criatura equipada obtiene +2/+0, tiene la habilidad de vigilancia y es un Caballero además de sus otros tipos.\\nSiempre que la criatura equipada ataque, crea una ficha de criatura Caballero blanca 2/2 con la habilidad de vigilancia y atacando.\\nEquipar {3}.', 'type': 'Artefacto — Equipo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447943&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'f0bf612a-d18e-46ea-8c4d-c704496a290c', 'multiverseId': 447943}, 'multiverseid': 447943}, {'name': 'Épée sigillée de Valéron', 'text': 'La créature équipée gagne +2/+0, a la vigilance et est un chevalier en plus de ses autres types.\\nÀ chaque fois que la créature équipée attaque, créez un jeton de créature 2/2 blanche Chevalier avec la vigilance, attaquant.\\nÉquipement {3}', 'type': 'Artefact : équipement', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448224&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c6131759-6aa8-46c5-a9f8-0b3f94539ec3', 'multiverseId': 448224}, 'multiverseid': 448224}, {'name': 'Spada dei Sigilli di Valeron', 'text': 'La creatura equipaggiata prende +2/+0, ha cautela ed è un Cavaliere in aggiunta ai suoi altri tipi.\\nOgniqualvolta la creatura equipaggiata attacca, crea una pedina creatura Cavaliere 2/2 bianca con cautela e attaccante.\\nEquipaggiare {3}', 'type': 'Artefatto — Equipaggiamento', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448505&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'bbb48bef-50d5-409f-b2b0-a4e336afd234', 'multiverseId': 448505}, 'multiverseid': 448505}, {'name': 'ヴァレロンの有印剣', 'text': '装備しているクリーチャーは＋２/＋０の修整を受け、警戒を持ち、それの他のタイプに加えて騎士でもある。\\n装備しているクリーチャーが攻撃するたび、警戒を持つ白の２/２の騎士・クリーチャー・トークンを１体攻撃している状態で生成する。\\n装備{3}', 'type': 'アーティファクト — 装備品', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448786&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '79252fe8-a92f-4c09-a147-ff378a3776b7', 'multiverseId': 448786}, 'multiverseid': 448786}, {'name': '발레론의 인장박힌 검', 'text': '장착된 생물은 +2/+0을 받고 경계를 가지며, 자신의 다른 유형에 더불어 기사다.\\n장착된 생물이 공격할 때마다, 경계를 가지고 공격 중인 2/2 백색 기사 생물 토큰 한 개를 만든다.\\n장착 {3}', 'type': '마법물체 — 장비', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449067&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'daaa1dd5-9cd8-4404-bec0-30bf4d336741', 'multiverseId': 449067}, 'multiverseid': 449067}, {'name': 'Espada Insigne de Valeron', 'text': 'A criatura equipada recebe +2/+0, tem vigilância e é um Cavaleiro além de seus outros tipos.\\nToda vez que a criatura equipada atacar, crie uma ficha de criatura branca 2/2 do tipo Cavaleiro com vigilância atacando.\\nEquipar {3}', 'type': 'Artefato — Equipamento', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449348&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9ce6777a-f2e3-4178-bcfe-0ca8804343d9', 'multiverseId': 449348}, 'multiverseid': 449348}, {'name': 'Медаленосный Валеронский Меч', 'text': 'Снаряженное существо получает +2/+0, имеет Бдительность и является Рыцарем в дополнение к своим другим типам.\\nКаждый раз, когда снаряженное существо атакует, создайте атакующей одну фишку существа 2/2 белый Рыцарь с Бдительностью.\\nСнарядить {3}', 'type': 'Артефакт — Снаряжение', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449629&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'cbe3cbef-c6de-4fb7-aba6-105481aba0d7', 'multiverseId': 449629}, 'multiverseid': 449629}, {'name': '威烈隆饰印剑', 'text': '佩带此武具的生物得+2/+0，具有警戒异能，且额外具有骑士此类别。\\n每当佩带此武具的生物攻击时，派出一个2/2白色，具警戒异能的骑士衍生生物，且正进行攻击。\\n佩带{3}', 'type': '神器 ～武具', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449910&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '69c2efe0-8c0e-4d3a-a507-55171d1e4ca4', 'multiverseId': 449910}, 'multiverseid': 449910}, {'name': '威烈隆飾印劍', 'text': '佩帶此武具的生物得+2/+0，具有警戒異能，且額外具有騎士此類別。\\n每當佩帶此武具的生物攻擊時，派出一個2/2白色，具警戒異能的騎士衍生生物，且正進行攻擊。\\n佩帶{3}', 'type': '神器 ～武具', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450191&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '47923658-f2c7-4bd3-af51-3409dd36f972', 'multiverseId': 450191}, 'multiverseid': 450191}]", '[{\'name\': \'Silberschnabelgreif\', \'text\': \'Fliegend (Diese Kreatur kann außer von fliegenden Kreaturen und Kreaturen mit Reichweite nicht geblockt werden.)\', \'type\': \'Kreatur — Greif\', \'flavor\': \'Vor einhundert Jahren entwischte ein zahmes Greifenpärchen. Nun ist der Himmel erfüllt vom Gesang ihrer Nachfahren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450266&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3648382c-e5c9-4255-b1d3-3fba48391252\', \'multiverseId\': 450266}, \'multiverseid\': 450266}, {\'name\': \'Grifo picoargénteo\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar o alcance.)\', \'type\': \'Criatura — Grifo\', \'flavor\': \'Una pareja de grifos domesticados escaparon de su cautividad hace un siglo. Ahora los cielos resuenan con los cantos de sus descendientes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450300&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e4c82857-d8e6-44a1-afe8-5b089687973e\', \'multiverseId\': 450300}, \'multiverseid\': 450300}, {\'name\': "Griffon au bec d\'argent", \'text\': \'Vol (Cette créature ne peut pas être bloquée excepté par des créatures avec le vol ou la portée.)\', \'type\': \'Créature : griffon\', \'flavor\': "Un couple de griffons domestiqués s\'est échappé voici un siècle. Les cieux sont désormais emplis des chants de leurs descendants.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450334&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0f22bbe7-bf86-43c6-917f-0f97a6e8a9b5\', \'multiverseId\': 450334}, \'multiverseid\': 450334}, {\'name\': "Grifone dal Becco d\'Argento", \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare o raggiungere.)\', \'type\': \'Creatura — Grifone\', \'flavor\': \'Una coppia di grifoni addomesticati fuggì dalla cattività un secolo fa. Ora nei cieli risuonano i canti dei loro discendenti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450368&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9b24695b-9d1b-424c-842c-8f3da51ca479\', \'multiverseId\': 450368}, \'multiverseid\': 450368}, {\'name\': \'銀嘴のグリフィン\', \'text\': \'飛行（このクリーチャーは飛行や到達を持たないクリーチャーによってはブロックされない。）\', \'type\': \'クリーチャー — グリフィン\', \'flavor\': \'飼いグリフィンのつがいが、一世紀ほど前に逃げ出した。今や空はその子孫の歌にあふれている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450402&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fd305e4d-2cfb-49cf-9cbf-e696307b5ba7\', \'multiverseId\': 450402}, \'multiverseid\': 450402}, {\'name\': \'은부리 그리핀\', \'text\': \'비행 (이 생물은 비행이나 대공을 가진 생물에게만 방어될 수 있다.)\', \'type\': \'생물 — 그리핀\', \'flavor\': \'백년 전 길들인 그리핀 한 쌍이 탈출했다. 이제 하늘은 그들의 후손이 부르는 노래로 가득하다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450436&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d10a0280-bf97-4f2f-9f54-57a325900b83\', \'multiverseId\': 450436}, \'multiverseid\': 450436}, {\'name\': \'Grifo Bico-de-prata\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com voar ou alcance.)\', \'type\': \'Criatura — Grifo\', \'flavor\': \'Um casal de grifos domesticados fugiu do cativeiro há um século. Agora, os céus estão repletos das canções de seus descendentes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450470&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6f45b5a1-5cbd-4358-aa4d-729ac0acc08f\', \'multiverseId\': 450470}, \'multiverseid\': 450470}, {\'name\': \'Среброклювый Грифон\', \'text\': \'Полет (Это существо может быть заблокировано только существами с Полетом или Захватом.)\', \'type\': \'Существо — Грифон\', \'flavor\': \'Век назад пара одомашненных грифонов сбежала от своего хозяина. Теперь небеса наполнены песнями их потомков.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450504&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'41323732-efe2-42e9-ae44-a22285db5e9e\', \'multiverseId\': 450504}, \'multiverseid\': 450504}, {\'name\': \'银嘴狮鹫\', \'text\': \'飞行（此生物只能被具飞行或延势异能的生物阻挡。）\', \'type\': \'生物 ～狮鹫\', \'flavor\': \'百年前，一对驯养狮鹫逃出囚笼。如今其后裔的歌声响彻云际。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450538&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a567e8ff-825c-48e7-a869-ebe7ae97accb\', \'multiverseId\': 450538}, \'multiverseid\': 450538}, {\'name\': \'銀嘴獅鷲\', \'text\': \'飛行（此生物只能被具飛行或延勢異能的生物阻擋。）\', \'type\': \'生物 ～獅鷲\', \'flavor\': \'百年前，一對馴養獅鷲逃出囚籠。如今其後裔的歌聲響徹雲際。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450572&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'349e7da1-d662-49d9-85e3-492a0f9e93b1\', \'multiverseId\': 450572}, \'multiverseid\': 450572}]', '[{\'name\': \'Skalla-Wolf\', \'text\': \'Wenn der Skalla-Wolf ins Spiel kommt, schaue dir die obersten fünf Karten deiner Bibliothek an. Du kannst davon eine grüne Karte offen vorzeigen und auf deine Hand nehmen. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.\', \'type\': \'Kreatur — Wolf, Geist\', \'flavor\': \'„Diese Essenz war einst der Begleiter einer Freundin."\\n—Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450284&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1fa90489-b639-4800-86a5-9dad6b84f6fd\', \'multiverseId\': 450284}, \'multiverseid\': 450284}, {\'name\': \'Lobo de Skalla\', \'text\': \'Cuando el Lobo de Skalla entre al campo de batalla, mira las cinco primeras cartas de tu biblioteca. Puedes mostrar una carta verde que se encuentre entre ellas y ponerla en tu mano. Pon el resto en el fondo de tu biblioteca en un orden aleatorio.\', \'type\': \'Criatura — Espíritu lobo\', \'flavor\': \'"Este espectro era el familiar de una amiga".\\n—Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450318&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'932ad018-1ab3-42b9-8187-df7c76d71040\', \'multiverseId\': 450318}, \'multiverseid\': 450318}, {\'name\': \'Loup de Skalla\', \'text\': \'Quand le Loup de Skalla arrive sur le champ de bataille, regardez les cinq cartes du dessus de votre bibliothèque. Vous pouvez révéler une carte verte parmi elles et la mettre dans votre main. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.\', \'type\': \'Créature : loup et esprit\', \'flavor\': "« Cette empreinte était autrefois le familier d\'une amie. »\\n—Vivien Reid", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450352&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ed228432-9952-4780-a005-f0576240b2a4\', \'multiverseId\': 450352}, \'multiverseid\': 450352}, {\'name\': \'Lupo di Skalla\', \'text\': \'Quando il Lupo di Skalla entra nel campo di battaglia, guarda le prime cinque carte del tuo grimorio. Puoi rivelare una carta verde scelta tra esse e aggiungerla alla tua mano. Metti le altre in fondo al tuo grimorio in ordine casuale.\', \'type\': \'Creatura — Spirito Lupo\', \'flavor\': \'"Questo spirito era il famiglio di un\\\'amica."\\n—Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450386&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8bddd92e-2004-4243-814d-ca87b567f93c\', \'multiverseId\': 450386}, \'multiverseid\': 450386}, {\'name\': \'スカラ狼\', \'text\': \'スカラ狼が戦場に出たとき、あなたのライブラリーの一番上からカードを５枚見る。あなたはその中から緑のカード１枚を公開してあなたの手札に加えてもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'クリーチャー — 狼・スピリット\', \'flavor\': \'「この影は友人の使い魔だったのよ。」\\n――ビビアン・リード\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450420&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8775dedb-1e69-445e-a01c-22f16993dcff\', \'multiverseId\': 450420}, \'multiverseid\': 450420}, {\'name\': \'스칼라 늑대\', \'text\': \'스칼라 늑대가 전장에 들어올 때, 당신의 서고 맨 위 카드 다섯 장을 본다. 당신은 그중에서 녹색 카드 한 장을 공개하고 당신의 손으로 가져갈 수 있다. 나머지 카드들은 무작위 순서로 당신의 서고 맨 밑에 놓는다.\', \'type\': \'생물 — 늑대 신령\', \'flavor\': \'"이 발자국은 친구의 것이로군."\\n—비비안 레이드\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450454&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'fa1ad1b8-a867-4ae6-b0a3-a77633da7118\', \'multiverseId\': 450454}, \'multiverseid\': 450454}, {\'name\': \'Lobo de Skalla\', \'text\': \'Quando Lobo de Skalla entrar no campo de batalha, olhe os cinco cards do topo de seu grimório. Você pode revelar um card verde dentre eles e colocá-lo em sua mão. Coloque o restante no fundo de seu grimório em ordem aleatória.\', \'type\': \'Criatura — Lobo Espírito\', \'flavor\': \'"Este espírito era o familiar de uma amiga."\\n— Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450488&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2f267429-40eb-4fcb-95bf-0efe55cafb42\', \'multiverseId\': 450488}, \'multiverseid\': 450488}, {\'name\': \'Волк из Скаллы\', \'text\': \'Когда Волк из Скаллы выходит на поле битвы, посмотрите пять верхних карт вашей библиотеки. Вы можете показать находящуюся среди них зеленую карту и положить ее в вашу руку. Положите остальные карты в низ вашей библиотеки в случайном порядке.\', \'type\': \'Существо — Волк Дух\', \'flavor\': \'«Этот отпечаток был спутником моего друга».\\n— Вивьен Рейд\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450522&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0887f034-ca0d-4561-ba8f-94812d79c0d4\', \'multiverseId\': 450522}, \'multiverseid\': 450522}, {\'name\': \'斯凯拉狼\', \'text\': \'当斯凯拉狼进战场时，检视你牌库顶的五张牌。你可以展示其中的一张绿色牌，并将它置于你手上。将其余的牌以随机顺序置于你的牌库底。\', \'type\': \'生物 ～狼／精怪\', \'flavor\': \'「这印记来自一位朋友的佣兽。」\\n～薇薇安瑞德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450556&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'989ca516-4147-4c55-af63-f02ebcc28da2\', \'multiverseId\': 450556}, \'multiverseid\': 450556}, {\'name\': \'斯凱拉狼\', \'text\': \'當斯凱拉狼進戰場時，檢視你牌庫頂的五張牌。你可以展示其中的一張綠色牌，並將它置於你手上。將其餘的牌以隨機順序置於你的牌庫底。\', \'type\': \'生物 ～狼／精靈\', \'flavor\': \'「這印記來自一位朋友的傭獸。」\\n～薇薇安瑞德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450590&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4aee3953-b326-45e7-9700-a97b3c76fc3e\', \'multiverseId\': 450590}, \'multiverseid\': 450590}]', '[{\'name\': \'Skelettierter Bogenschütze\', \'text\': \'Wenn der Skelettierte Bogenschütze ins Spiel kommt, fügt er einem Ziel deiner Wahl 1 Schadenspunkt zu.\', \'type\': \'Kreatur — Skelett, Bogenschütze\', \'flavor\': \'„Wenn es ums Töten mit höchster Präzision geht, ist eine Seele nur hinderlich."\\n—Isareth die Erweckerin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447535&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a528d4d8-a1dd-4dd2-bf96-bbf1c34ca018\', \'multiverseId\': 447535}, \'multiverseid\': 447535}, {\'name\': \'Esqueleto arquero\', \'text\': \'Cuando el Esqueleto arquero entre al campo de batalla, hace 1 punto de daño a cualquier objetivo.\', \'type\': \'Criatura — Esqueleto arquero\', \'flavor\': \'"Cuando se trata de matar con precisión, tener alma es más bien una molestia".\\n—Isareth, la Resucitadora\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447816&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ca763a57-a1d8-4fae-84ed-ac09407a56fa\', \'multiverseId\': 447816}, \'multiverseid\': 447816}, {\'name\': \'Archer squelette\', \'text\': "Quand l\'Archer squelette arrive sur le champ de bataille, il inflige 1 blessure à n\'importe quelle cible.", \'type\': \'Créature : squelette et archer\', \'flavor\': "« Quand il faut tuer avec précision, avoir une âme est un obstacle. »\\n—Isareth l\'éveilleuse", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448097&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b891e2ed-b340-4a4f-ae10-9dd83c7ee70d\', \'multiverseId\': 448097}, \'multiverseid\': 448097}, {\'name\': \'Arciere Scheletrico\', \'text\': "Quando l\'Arciere Scheletrico entra nel campo di battaglia, infligge 1 danno a un qualsiasi bersaglio.", \'type\': \'Creatura — Arciere Scheletro\', \'flavor\': \'"Quando si tratta di uccidere con precisione, l\\\'anima è un mero intralcio."\\n—Isareth, la Risvegliatrice\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448378&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bf608443-69ae-46ce-b20a-29b3f5ffc9ff\', \'multiverseId\': 448378}, \'multiverseid\': 448378}, {\'name\': \'骸骨射手\', \'text\': \'骸骨射手が戦場に出たとき、クリーチャー１体かプレインズウォーカー１体かプレイヤー１人を対象とする。これはそれに１点のダメージを与える。\', \'type\': \'クリーチャー — スケルトン・射手\', \'flavor\': \'「精確な殺しとなれば、魂など邪魔でしかないわ。」\\n――呼び覚ます者イザレス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448659&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e47252a5-fe02-42a0-98ad-d6dfd6cfdd40\', \'multiverseId\': 448659}, \'multiverseid\': 448659}, {\'name\': \'해골 궁수\', \'text\': \'해골 궁수가 전장에 들어올 때, 원하는 목표를 정한다. 해골 궁수는 그 목표에게 피해 1점을 입힌다.\', \'type\': \'생물 — 해골 궁수\', \'flavor\': \'"정확하게 죽여야 할 때엔, 영혼은 방해만 될 뿐이지."\\n—일깨우는 자 이자레스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448940&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'fac75c9b-f876-4269-a3a1-c8998dbb2172\', \'multiverseId\': 448940}, \'multiverseid\': 448940}, {\'name\': \'Arqueiro Esquelético\', \'text\': \'Quando Arqueiro Esquelético entra no campo de batalha, ele causa 1 ponto de dano a qualquer alvo.\', \'type\': \'Criatura — Esqueleto Arqueiro\', \'flavor\': \'"Quando se trata de matar com precisão, a alma não é senão um estorvo."\\n— Isareth, a Despertadora\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449221&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9af92315-6153-4605-bbd6-94f6368b0a8d\', \'multiverseId\': 449221}, \'multiverseid\': 449221}, {\'name\': \'Скелет-Лучник\', \'text\': \'Когда Скелет-Лучник выходит на поле битвы, он наносит 1 повреждение любой цели.\', \'type\': \'Существо — Скелет Лучник\', \'flavor\': \'«Когда мы говорим об убийствах со смертельной точностью, душа только мешает».\\n— Изарет Пробудительница\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449502&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8c43874b-b19d-4759-9272-eebb35fa0a36\', \'multiverseId\': 449502}, \'multiverseid\': 449502}, {\'name\': \'骷髅妖箭手\', \'text\': \'当骷髅妖箭手进战场时，它对任意一个目标造成1点伤害。\', \'type\': \'生物 ～骷髅妖／弓箭手\', \'flavor\': \'「需要精准击杀时，灵魂只会成为障碍。」\\n～唤尸依萨蕾\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449783&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5a00820a-a064-4590-bff0-3e7eee7e1c68\', \'multiverseId\': 449783}, \'multiverseid\': 449783}, {\'name\': \'骷髏妖箭手\', \'text\': \'當骷髏妖箭手進戰場時，它對任意一個目標造成1點傷害。\', \'type\': \'生物 ～骷髏妖／弓箭手\', \'flavor\': \'「需要精準擊殺時，靈魂只會成為障礙。」\\n～喚屍依薩蕾\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450064&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ca0dde0d-e83b-40f6-b5b1-953ac224abc1\', \'multiverseId\': 450064}, \'multiverseid\': 450064}]', '[{\'name\': \'Sonnenläuterin\', \'text\': \'Wenn die Sonnenläuterin ins Spiel kommt, bestimme eines —\\n• Entferne alle Marken von einer Kreatur deiner Wahl. Es können keine Marken auf sie gelegt werden, solange die Sonnenläuterin im Spiel ist.\\n• Ein Gegner deiner Wahl verliert alle Marken. Der Spieler kann keine Marken erhalten, solange die Sonnenläuterin im Spiel ist.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447456&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'add55f8d-90c2-4fa2-bbcf-c2a01cf57b8e\', \'multiverseId\': 447456}, \'multiverseid\': 447456}, {\'name\': \'Purificadora solar\', \'text\': \'Cuando la Purificadora solar entre al campo de batalla, elige uno:\\n• Remueve todos los contadores de la criatura objetivo. No pueden ponerse contadores sobre ella mientras la Purificadora solar permanezca en el campo de batalla.\\n• El oponente objetivo pierde todos los contadores. Ese jugador no puede recibir contadores mientras la Purificadora solar permanezca en el campo de batalla.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447737&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0d47a391-a1bc-4546-af81-75d6bf568d76\', \'multiverseId\': 447737}, \'multiverseid\': 447737}, {\'name\': \'Purificatrice solaire\', \'text\': "Quand la Purificatrice solaire arrive sur le champ de bataille, choisissez l\'un —\\n• Retirez tous les marqueurs de la créature ciblée. Elle ne peut pas avoir de marqueurs sur elle tant que la Purificatrice solaire reste sur le champ de bataille.\\n• L\'adversaire ciblé perd tous ses marqueurs. Ce joueur ne peut pas gagner de marqueurs tant que la Purificatrice solaire reste sur le champ de bataille.", \'type\': \'Créature : humain et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448018&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6a485b11-0414-4f19-99dd-2147438b6cf1\', \'multiverseId\': 448018}, \'multiverseid\': 448018}, {\'name\': \'Purificatrice Solare\', \'text\': \'Quando la Purificatrice Solare entra nel campo di battaglia, scegli uno —\\n• Rimuovi tutti i segnalini da una creatura bersaglio. Non può ottenere segnalini fintanto che la Purificatrice Solare rimane sul campo di battaglia.\\n• Un avversario bersaglio perde tutti i segnalini. Quel giocatore non può ottenere segnalini fintanto che la Purificatrice Solare rimane sul campo di battaglia.\', \'type\': \'Creatura — Chierico Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448299&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1bb6769e-1dcf-451d-bdb0-091acfeb9a3c\', \'multiverseId\': 448299}, \'multiverseid\': 448299}, {\'name\': \'陽光浄化者\', \'text\': \'陽光浄化者が戦場に出たとき、以下から１つを選ぶ。\\n• クリーチャー１体を対象とする。それの上からカウンターをすべて取り除く。陽光浄化者が戦場に残り続けているかぎり、それの上にカウンターを置くことはできない。\\n• 対戦相手１人を対象とする。そのプレイヤーはカウンターをすべて失う。陽光浄化者が戦場に残り続けているかぎり、そのプレイヤーはカウンターを得ることができない。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448580&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'38bef1dd-4b62-43c0-b902-0af643e24705\', \'multiverseId\': 448580}, \'multiverseid\': 448580}, {\'name\': \'태양 정화자\', \'text\': \'태양 정화자가 전장에 들어올 때, 하나를 선택한다 —\\n• 생물을 목표로 정한다. 그 생물에 놓인 카운터를 모두 제거한다. 태양 정화자가 전장에 남아 있는 한 그 생물에 카운터가 놓일 수 없다.\\n• 상대를 목표로 정한다. 그 플레이어는 가진 카운터를 모두 잃는다. 태양 정화자가 전장에 남아 있는 한 그 플레이어는 카운터를 얻을 수 없다.\', \'type\': \'생물 — 인간 성직자\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448861&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a5f86eae-9603-497e-996e-570780a2a6dd\', \'multiverseId\': 448861}, \'multiverseid\': 448861}, {\'name\': \'Purificadora Solar\', \'text\': \'Quando Purificadora Solar entrar no campo de batalha, escolha um —\\n• Remova todos os marcadores da criatura alvo. Ela não poderá receber marcadores enquanto Purificadora Solar permanecer no campo de batalha.\\n• O oponente alvo perde todos os marcadores. Aquele jogador não poderá receber marcadores enquanto Purificadora Solar permanecer no campo de batalha.\', \'type\': \'Criatura — Humano Clérigo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449142&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c8e58412-e493-4af2-b891-b3afaf2c3a23\', \'multiverseId\': 449142}, \'multiverseid\': 449142}, {\'name\': \'Солнечная Очистительница\', \'text\': \'Когда Солнечная Очистительница выходит на поле битвы, выберите одно —\\n• Удалите все жетоны с целевого существа. На него нельзя положить жетоны, пока Солнечная Очистительница остается на поле битвы.\\n• Целевой оппонент теряет все жетоны. Тот игрок не может получить жетоны, пока Солнечная Очистительница остается на поле битвы.\', \'type\': \'Существо — Человек Священник\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449423&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ae2f7bcf-b34b-4143-9915-25140e301753\', \'multiverseId\': 449423}, \'multiverseid\': 449423}, {\'name\': \'承阳净化僧\', \'text\': \'当承阳净化僧进战场时，选择一项～\\n•移去目标生物上的所有指示物。于承阳净化僧仍在战场上的时段内，该生物上不能放置指示物。\\n•目标对手失去所有指示物。于承阳净化僧仍在战场上的时段内，该牌手不能得到指示物。\', \'type\': \'生物 ～人类／僧侣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449704&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8a662e8a-a131-48eb-a7e3-52db4b9f4f0a\', \'multiverseId\': 449704}, \'multiverseid\': 449704}, {\'name\': \'承陽淨化僧\', \'text\': \'當承陽淨化僧進戰場時，選擇一項～\\n•移去目標生物上的所有指示物。於承陽淨化僧仍在戰場上的時段內，該生物上不能放置指示物。\\n•目標對手失去所有指示物。於承陽淨化僧仍在戰場上的時段內，該玩家不能得到指示物。\', \'type\': \'生物 ～人類／僧侶\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449985&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b7059cb7-8299-4f84-83d4-de921136f1e8\', \'multiverseId\': 449985}, \'multiverseid\': 449985}]', '[{\'name\': \'Spiegelbild\', \'text\': \'Du kannst das Spiegelbild als Kopie einer beliebigen Kreatur, die du kontrollierst, ins Spiel kommen lassen.\', \'type\': \'Kreatur — Gestaltwandler\', \'flavor\': \'Das Leben eines Gestaltwandlers ist ständigem Wandel unterworfen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447478&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0ab91bbd-5547-4827-a69d-9f239302c78b\', \'multiverseId\': 447478}, \'multiverseid\': 447478}, {\'name\': \'Imagen reflejada\', \'text\': \'Puedes hacer que la Imagen reflejada entre al campo de batalla como una copia de cualquier criatura que controlas.\', \'type\': \'Criatura — Metamorfo\', \'flavor\': \'La vida de un metamorfo es un cambio continuo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447759&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'695ae229-0f04-4a82-9f73-048c59b32acd\', \'multiverseId\': 447759}, \'multiverseid\': 447759}, {\'name\': \'Image miroir\', \'text\': "Vous pouvez faire que l\'Image miroir arrive sur le champ de bataille comme une copie de n\'importe quelle créature que vous contrôlez.", \'type\': \'Créature : changeforme\', \'flavor\': "La vie d\'un changeforme est une transformation perpétuelle.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448040&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d749f29a-823e-450a-9ff7-8391f7959267\', \'multiverseId\': 448040}, \'multiverseid\': 448040}, {\'name\': \'Immagine Riflessa\', \'text\': "Puoi far entrare l\'Immagine Riflessa nel campo di battaglia come una copia di qualsiasi creatura che controlli.", \'type\': \'Creatura — Polimorfo\', \'flavor\': \'La vita di un polimorfo è in continuo cambiamento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448321&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ecfc0263-93cd-4566-abcc-6fab4f5b48f2\', \'multiverseId\': 448321}, \'multiverseid\': 448321}, {\'name\': \'鏡像\', \'text\': \'あなたは鏡像を、あなたがコントロールしているクリーチャー１体のコピーとして戦場に出してもよい。\', \'type\': \'クリーチャー — 多相の戦士\', \'flavor\': \'多相の戦士の人生は目まぐるしく変わる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448602&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'764a1da3-1d48-45fe-b23b-5daa4f21d7d7\', \'multiverseId\': 448602}, \'multiverseid\': 448602}, {\'name\': \'거울상\', \'text\': \'당신은 거울상이 당신이 조종하는 아무 생물의 복사본으로 전장에 들어오도록 할 수 있다.\', \'type\': \'생물 — 변신괴물\', \'flavor\': \'변신괴물의 일생은 끝없는 변화이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448883&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0494004e-3374-4e79-940f-618a2487e2b5\', \'multiverseId\': 448883}, \'multiverseid\': 448883}, {\'name\': \'Imagem Espelhada\', \'text\': \'Você pode fazer com que Imagem Espelhada entre no campo de batalha como cópia de qualquer criatura que você controle.\', \'type\': \'Criatura — Metamorfo\', \'flavor\': \'A vida de um metamorfo é de mudança constante.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449164&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bf8f4f23-7f87-4600-b019-992c0c8e51ac\', \'multiverseId\': 449164}, \'multiverseid\': 449164}, {\'name\': \'Зеркальный Образ\', \'text\': \'Вы можете заставить Зеркальный Образ выйти на поле битвы в качестве копии любого существа под вашим контролем.\', \'type\': \'Существо — Имитатор\', \'flavor\': \'Жизнь имитатора — сплошные перемены.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449445&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2532a9db-7f08-459d-893d-f77ac21b5e69\', \'multiverseId\': 449445}, \'multiverseid\': 449445}, {\'name\': \'镜身影\', \'text\': \'你可以使镜身影当成任一由你操控之生物的复制品来进入战场。\', \'type\': \'生物 ～变形兽\', \'flavor\': \'变形兽的生活也在一直变化。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449726&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cc987bcb-2bda-4d6e-88f2-0c2c517adb6c\', \'multiverseId\': 449726}, \'multiverseid\': 449726}, {\'name\': \'鏡身影\', \'text\': \'你可以使鏡身影當成任一由你操控之生物的複製品來進入戰場。\', \'type\': \'生物 ～變形獸\', \'flavor\': \'變形獸的生活也在一直變化。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450007&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4aee19eb-f71a-4a1b-a2e3-6f9287357a5c\', \'multiverseId\': 450007}, \'multiverseid\': 450007}]', '[{\'name\': \'Sprühender Blitz\', \'text\': \'Der Sprühende Blitz fügt einem Spieler deiner Wahl 3 Schadenspunkte und jeder Kreatur, die er kontrolliert, 1 Schadenspunkt zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'Als die Legionen der Kabbalisten nach Shiv vordrangen, lernten sie auf die schmerzhafte Art, nicht zu dicht zusammenzustehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450294&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'51684745-420e-47cd-9ab6-60b898f16cb2\', \'multiverseId\': 450294}, \'multiverseid\': 450294}, {\'name\': \'Rayo propagado\', \'text\': \'El Rayo propagado hace 3 puntos de daño al jugador objetivo y 1 punto de daño a cada criatura que controla ese jugador.\', \'type\': \'Instantáneo\', \'flavor\': \'A medida que las legiones de la Cábala avanzaron por Shiv, aprendieron a no ponerse tan cerca unos de otros.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450328&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'775f5c5d-3c3f-42b0-a26a-d3d7003bcf0c\', \'multiverseId\': 450328}, \'multiverseid\': 450328}, {\'name\': \'Foudre irradiante\', \'text\': \'La Foudre irradiante inflige 3 blessures au joueur ciblé et 1 blessure à chaque créature que ce joueur contrôle.\', \'type\': \'Éphémère\', \'flavor\': "Tandis que les légions de la Coterie s\'enfonçaient dans Shiv, les soldats apprirent à s\'écarter les uns des autres.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450362&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e3fbf605-9a11-41cc-999b-d5eb70675adc\', \'multiverseId\': 450362}, \'multiverseid\': 450362}, {\'name\': \'Fulmine a Dispersione\', \'text\': \'Il Fulmine a Dispersione infligge 3 danni a un giocatore bersaglio e 1 danno a ogni creatura controllata da quel giocatore.\', \'type\': \'Istantaneo\', \'flavor\': \'Addentrandosi nella regione di Shiv, i legionari della Cabala impararono a non marciare troppo compatti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450396&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'20e591ad-952f-44e6-8fe7-8c69be5f85e9\', \'multiverseId\': 450396}, \'multiverseid\': 450396}, {\'name\': \'放射稲妻\', \'text\': \'プレイヤー１人を対象とする。放射稲妻はそのプレイヤーに３点と、そのプレイヤーがコントロールしている各クリーチャーにそれぞれ１点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'シヴに入り込んだ陰謀団の軍団は、互いに近寄り過ぎるとまずいことを知った。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450430&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0f983433-8334-4e68-8d64-0c65394e415c\', \'multiverseId\': 450430}, \'multiverseid\': 450430}, {\'name\': \'빛나는 번개\', \'text\': \'플레이어를 목표로 정한다. 빛나는 번개는 그 플레이어에게 피해 3점을 입히고 그 플레이어가 조종하는 각 생물에게 피해 1점을 입힌다.\', \'type\': \'순간마법\', \'flavor\': \'도당의 군단이 시브까지 밀어닥쳤을 때, 그들은 서로 너무 가깝게 서 있어서는 안 된다는 것을 깨닫게 되었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450464&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c1f3b59e-c561-4423-83da-1bef7121f522\', \'multiverseId\': 450464}, \'multiverseid\': 450464}, {\'name\': \'Relâmpago Irradiante\', \'text\': \'Relâmpago Irradiante causa 3 pontos de dano ao jogador alvo e 1 ponto de dano a cada criatura que aquele jogador controla.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Conforme as legiões da Cabala avançavam em Shiv, aprendiam a não usar formações tão compactas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450498&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'11ca0bde-5e49-41a4-83b1-a2c37ebd7364\', \'multiverseId\': 450498}, \'multiverseid\': 450498}, {\'name\': \'Лучистая Молния\', \'text\': \'Лучистая Молния наносит 3 повреждения целевому игроку и 1 повреждение каждому существу под контролем того игрока.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Когда легионы Кабала вторглись в Шив, солдаты быстро научились не стоять слишком близко друг к другу.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450532&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'909d8d5c-6aaf-4f9f-97df-c7450a3be5fe\', \'multiverseId\': 450532}, \'multiverseid\': 450532}, {\'name\': \'放射闪电\', \'text\': \'放射闪电对目标牌手造成3点伤害，且对每个由该牌手操控的生物各造成1点伤害。\', \'type\': \'瞬间\', \'flavor\': \'柯帮的万马千军一踏足西瓦，就学会了彼此不能靠太近。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450566&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'82b832ee-48a7-46d7-83e2-d2d0c9d672f7\', \'multiverseId\': 450566}, \'multiverseid\': 450566}, {\'name\': \'放射閃電\', \'text\': \'放射閃電對目標玩家造成3點傷害，且對每個由該玩家操控的生物各造成1點傷害。\', \'type\': \'瞬間\', \'flavor\': \'柯幫的萬馬千軍一踏足西瓦，就學會了彼此不能靠太近。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450600&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5e67b561-fa10-4e2c-ab8a-0fc42fd5ca25\', \'multiverseId\': 450600}, \'multiverseid\': 450600}]', '[{\'name\': \'Stachelkamm-Seeschlange\', \'text\': \'{5}{U}{U}: Die Stachelkamm-Seeschlange kann in diesem Zug nicht geblockt werden.\', \'type\': \'Kreatur — Schlange\', \'flavor\': \'„Holt die Leine ein. Nein, wartet! Schmeißt sie zurück!"\\n—Gertrude, Tiefseefischerin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447473&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4b126ae6-9266-45ba-bce8-b832db5a75ab\', \'multiverseId\': 447473}, \'multiverseid\': 447473}, {\'name\': \'Serpiente marina con espinas\', \'text\': \'{5}{U}{U}: La Serpiente marina con espinas no puede ser bloqueada este turno.\', \'type\': \'Criatura — Serpiente\', \'flavor\': \'"Enrolla el sedal. No, ¡espera! ¡Tíralo!".\\n—Gertrude, pescadora de mar abierto\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447754&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6646068d-f7ff-4256-9bba-a47dfac3072c\', \'multiverseId\': 447754}, \'multiverseid\': 447754}, {\'name\': \'Serpent de mer à jabots\', \'text\': \'{5}{U}{U} : Le Serpent de mer à jabots ne peut pas être bloqué ce tour-ci.\', \'type\': \'Créature : grand serpent\', \'flavor\': "« Remontez la prise. Non, attendez ! Remettez-la à l\'eau ! »\\n—Gertrude, pêcheuse en haute mer", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448035&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0a1b74cc-3a8b-484c-a12f-41c06cba3c4b\', \'multiverseId\': 448035}, \'multiverseid\': 448035}, {\'name\': \'Serpente Marino Frangiato\', \'text\': \'{5}{U}{U}: Il Serpente Marino Frangiato non può essere bloccato in questo turno.\', \'type\': \'Creatura — Serpe\', \'flavor\': \'"Tiratelo su. Anzi no, contrordine: ributtatelo in mare!"\\n—Gertrude, pescatrice d\\\'altura\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448316&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ee5f7951-35af-4a55-955f-f8833722e596\', \'multiverseId\': 448316}, \'multiverseid\': 448316}, {\'name\': \'大襞海蛇\', \'text\': \'{5}{U}{U}：このターン、大襞海蛇はブロックされない。\', \'type\': \'クリーチャー — 海蛇\', \'flavor\': \'「引け。いや、待て！それを戻せ！」\\n――深海の釣り人、ガートルード\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448597&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'28f347ce-6fce-4adc-be5f-9362683f133d\', \'multiverseId\': 448597}, \'multiverseid\': 448597}, {\'name\': \'목지느러미 바다 이무기\', \'text\': \'{5}{U}{U}: 목지느러미 바다 이무기는 이 턴에 방어될 수 없다.\', \'type\': \'생물 — 이무기\', \'flavor\': \'"줄을 감아. 아냐, 잠깐! 다시 풀어!"\\n—심해 낙시꾼, 게트루드\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448878&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'511c4bf4-b2f5-4d8e-91af-8737d24d8654\', \'multiverseId\': 448878}, \'multiverseid\': 448878}, {\'name\': \'Serpente do Mar Franjada\', \'text\': \'{5}{U}{U}: Serpente do Mar Franjada não pode ser bloqueada neste turno.\', \'type\': \'Criatura — Serpente\', \'flavor\': \'"Puuuxa! Ei! Não! Espera aí! Sooooolta!"\\n— Gertrude, pescadora de alto-mar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449159&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0776ca7d-52e0-49ff-b25b-b80eb6422f90\', \'multiverseId\': 449159}, \'multiverseid\': 449159}, {\'name\': \'Плащеносный Морской Змей\', \'text\': \'{5}{U}{U}: Плащеносный Морской Змей не может быть заблокирован в этом ходу.\', \'type\': \'Существо — Змей\', \'flavor\': \'«Вытягивай его... Нет, стой-стой-стой! Бросай назад!»\\n— Гертруда, глубоководная рыбачка\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449440&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'61939513-b070-4fcd-98e9-760e64bd6086\', \'multiverseId\': 449440}, \'multiverseid\': 449440}, {\'name\': \'刃鳍巨海蛇\', \'text\': \'{5}{U}{U}：刃鳍巨海蛇本回合不能被阻挡。\', \'type\': \'生物 ～巨蛇\', \'flavor\': \'「钓上来。不对，等等！抛回去！」\\n～深海钓客格楚德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449721&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a454e325-3b59-43f7-b5c7-f2d9167018e2\', \'multiverseId\': 449721}, \'multiverseid\': 449721}, {\'name\': \'刃鰭巨海蛇\', \'text\': \'{5}{U}{U}：刃鰭巨海蛇本回合不能被阻擋。\', \'type\': \'生物 ～巨蛇\', \'flavor\': \'「釣上來。不對，等等！拋回去！」\\n～深海釣客格楚德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450002&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e79b8c30-5b32-4c38-bfea-045a45bbd7d7\', \'multiverseId\': 450002}, \'multiverseid\': 450002}]', "[{'name': 'Steinbruch', 'text': 'Der Steinbruch kommt getappt ins Spiel.\\n{T}: Erzeuge {R} oder {W}.', 'type': 'Land', 'flavor': 'Das Grundgestein hat viele Gaben zu geben.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447674&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2742eec0-7d90-4a0d-952f-a5e643c44c69', 'multiverseId': 447674}, 'multiverseid': 447674}, {'name': 'Pedrera', 'text': 'La Pedrera entra al campo de batalla girada.\\n{T}: Agrega {R} o {W}.', 'type': 'Tierra', 'flavor': 'Esta roca tiene mucho que aportar.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447955&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '84aff585-dba6-4e09-b3a5-b222f94f71bf', 'multiverseId': 447955}, 'multiverseid': 447955}, {'name': 'Carrière de pierre', 'text': 'La Carrière de pierre arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {R} ou {W}.', 'type': 'Terrain', 'flavor': 'La roche a beaucoup à offrir.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448236&type=card', 'language': 'French', 'identifiers': {'scryfallId': '92bdfef6-7e9f-4692-90da-2539a79b7a14', 'multiverseId': 448236}, 'multiverseid': 448236}, {'name': 'Cava di Pietra', 'text': 'La Cava di Pietra entra nel campo di battaglia TAPpata.\\n{T}: Aggiungi {R} o {W}.', 'type': 'Terra', 'flavor': 'La roccia ha molto da offrire.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448517&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'f2fb702e-e47f-40af-9edf-cb83e630ae17', 'multiverseId': 448517}, 'multiverseid': 448517}, {'name': '採石場', 'text': '採石場はタップ状態で戦場に出る。\\n{T}：{R}か{W}を加える。', 'type': '土地', 'flavor': '床岩にはたくさんの恵みがある。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448798&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'e06e3e9f-c973-469a-8432-7455d0da1080', 'multiverseId': 448798}, 'multiverseid': 448798}, {'name': '채석장', 'text': '채석장은 탭된 채로 전장에 들어온다.\\n{T}: {R} 또는 {W}를 추가한다.', 'type': '대지', 'flavor': '암반은 아낌없이 선물을 내어 준다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449079&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'c80eebaf-b680-4e7d-92de-b2e33db6e3f1', 'multiverseId': 449079}, 'multiverseid': 449079}, {'name': 'Pedreira', 'text': 'Pedreira entra no campo de batalha virada.\\n{T}: Adicione {R} ou {W}.', 'type': 'Terreno', 'flavor': 'As rochas matrizes têm muitas dádivas a oferecer.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449360&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fe256f82-8e01-4364-9ce7-71b65ea995ca', 'multiverseId': 449360}, 'multiverseid': 449360}, {'name': 'Каменоломня', 'text': 'Каменоломня выходит на поле битвы повернутой.\\n{T}: добавьте {R} или {W}.', 'type': 'Земля', 'flavor': 'У камня много даров.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449641&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '0d48a02a-de6b-4d7f-855a-ace54f2a9b54', 'multiverseId': 449641}, 'multiverseid': 449641}, {'name': '采石场', 'text': '采石场须横置进战场。\\n{T}：加{R}或{W}。', 'type': '地', 'flavor': '基岩中藏有很多宝贝。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449922&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f18df9ac-48ce-49f2-a5f5-fe9ab74f503e', 'multiverseId': 449922}, 'multiverseid': 449922}, {'name': '採石場', 'text': '採石場須橫置進戰場。\\n{T}：加{R}或{W}。', 'type': '地', 'flavor': '基岩中藏有很多寶貝。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450203&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '7b0d5152-4b35-42c4-9f5f-edd0881fb27b', 'multiverseId': 450203}, 'multiverseid': 450203}]", '[{\'name\': \'Sternengekrönter Hirsch\', \'text\': \'Immer wenn der Sternengekrönte Hirsch angreift, tappe eine Kreatur deiner Wahl, die der verteidigende Spieler kontrolliert.\', \'type\': \'Kreatur — Hirsch\', \'flavor\': \'Er ist so weiß wie Sternenlicht auf Schnee und er erscheint nur am Vorabend der Wintersonnenwende.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447455&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0aee60f2-8a9d-47fd-b7f6-1f2c830efe56\', \'multiverseId\': 447455}, \'multiverseid\': 447455}, {\'name\': \'Ciervo de cornamenta astral\', \'text\': \'Siempre que el Ciervo de cornamenta astral ataque, gira la criatura objetivo que controla el jugador defensor.\', \'type\': \'Criatura — Alce\', \'flavor\': \'Es tan blanco como el brillo de las estrellas sobre la nieve y solo aparece durante la víspera del solsticio de invierno.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447736&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6a90cc87-56bb-40bc-b8db-9740b8c2b61f\', \'multiverseId\': 447736}, \'multiverseid\': 447736}, {\'name\': "Cerf à couronne d\'étoiles", \'text\': "À chaque fois que le Cerf à couronne d\'étoiles attaque, engagez une créature ciblée que le joueur défenseur contrôle.", \'type\': \'Créature : élan\', \'flavor\': "Aussi blanc que la lumière des étoiles sur la neige, il n\'apparaît que le soir du solstice d\'hiver.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448017&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f1d3f7a9-e18f-4d22-b469-2f7f156a5139\', \'multiverseId\': 448017}, \'multiverseid\': 448017}, {\'name\': \'Cervo della Corona Stellare\', \'text\': \'Ogniqualvolta il Cervo della Corona Stellare attacca, TAPpa una creatura bersaglio controllata dal giocatore in difesa.\', \'type\': \'Creatura — Alce\', \'flavor\': "Bianco come il chiarore delle stelle sulla neve, appare solo alla vigilia del solstizio d\'inverno.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448298&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b2f6a1aa-9a43-4a69-a866-9cba707792fa\', \'multiverseId\': 448298}, \'multiverseid\': 448298}, {\'name\': \'星冠の雄鹿\', \'text\': \'星冠の雄鹿が攻撃するたび、防御プレイヤーがコントロールしているクリーチャー１体を対象とし、それをタップする。\', \'type\': \'クリーチャー — 大鹿\', \'flavor\': \'雪を照らす星の光のように白く、冬至前夜にのみ姿を現す。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448579&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0738cb5e-14c9-4609-ad8c-8e5817aa9672\', \'multiverseId\': 448579}, \'multiverseid\': 448579}, {\'name\': \'별 왕관을 쓴 숫사슴\', \'text\': \'별 왕관을 쓴 숫사슴이 공격할 때마다, 수비플레이어가 조종하는 생물을 목표로 정한다. 그 생물을 탭한다.\', \'type\': \'생물 — 엘크\', \'flavor\': \'그것은 눈 위를 비추는 별빛처럼 희고, 동지 전날 밤에만 나타난다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448860&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f064f7c5-b7aa-42f7-97de-018756c55159\', \'multiverseId\': 448860}, \'multiverseid\': 448860}, {\'name\': \'Cervo Estelocórneo\', \'text\': \'Toda vez que Cervo Estelocórneo atacar, vire a criatura alvo que o jogador defensor controla.\', \'type\': \'Criatura — Alce\', \'flavor\': \'Branco como a luz das estrelas sobre a neve, ele só aparece na noite do solstício de inverno.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449141&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'be6f560f-b588-40c3-9866-740239826ed1\', \'multiverseId\': 449141}, \'multiverseid\': 449141}, {\'name\': \'Олень Звездной Короны\', \'text\': \'Каждый раз, когда Олень Звездной Короны атакует, поверните целевое существо под контролем защищающегося игрока.\', \'type\': \'Существо — Вапити\', \'flavor\': \'Белый, как звездный свет на снегу, он появляется лишь в канун зимнего солнцестояния.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449422&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ee487f38-2025-4fb9-9249-c148b5a514bf\', \'multiverseId\': 449422}, \'multiverseid\': 449422}, {\'name\': \'星冠麋鹿\', \'text\': \'每当星冠麋鹿攻击时，横置目标由防御牌手操控的生物。\', \'type\': \'生物 ～麋鹿\', \'flavor\': \'此鹿洁白如雪上星光，唯冬至前夜方现世间。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449703&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'aaaf4ed3-b7f0-4caf-9f99-93d6598bfd74\', \'multiverseId\': 449703}, \'multiverseid\': 449703}, {\'name\': \'星冠麋鹿\', \'text\': \'每當星冠麋鹿攻擊時，橫置目標由防禦玩家操控的生物。\', \'type\': \'生物 ～麋鹿\', \'flavor\': \'此鹿潔白如雪上星光，唯冬至前夜方現世間。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449984&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'234200bf-7543-45ea-8c32-8ec80ca63ba9\', \'multiverseId\': 449984}, \'multiverseid\': 449984}]', '[{\'name\': \'Stille Weite\', \'text\': \'Die Stille Weite kommt getappt ins Spiel.\\n{T}: Erzeuge {G} oder {W}.\', \'type\': \'Land\', \'flavor\': \'Fernab des Chaos von Ghirapur liegt eine pulsierende Welt, in der Äther die Natur durchströmt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447677&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'da2800b0-8f08-4fb5-8b5d-4e4692ce76c0\', \'multiverseId\': 447677}, \'multiverseid\': 447677}, {\'name\': \'Extensión tranquila\', \'text\': \'La Extensión tranquila entra al campo de batalla girada.\\n{T}: Agrega {G} o {W}.\', \'type\': \'Tierra\', \'flavor\': \'Más allá del caos de Ghirapur existe un mundo vivo donde el éter fluye por la naturaleza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447958&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'aa0554b1-414d-43c6-a523-47676d3732f5\', \'multiverseId\': 447958}, \'multiverseid\': 447958}, {\'name\': \'Immensité tranquille\', \'text\': "L\'Immensité tranquille arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {G} ou {W}.", \'type\': \'Terrain\', \'flavor\': "Au-delà du chaos de Ghirapur, se trouve un monde vivant où l\'Éther circule dans la nature.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448239&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5ccf989c-4b07-4ca5-95f1-824f93362064\', \'multiverseId\': 448239}, \'multiverseid\': 448239}, {\'name\': \'Distesa Tranquilla\', \'text\': \'La Distesa Tranquilla entra nel campo di battaglia TAPpata.\\n{T}: Aggiungi {G} o {W}.\', \'type\': \'Terra\', \'flavor\': "Oltre il caos di Ghirapur si estende un mondo lussureggiante dove l\'etere scorre tra la vegetazione.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448520&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'31f47aac-ff9d-432a-a857-66a89cd9cd1d\', \'multiverseId\': 448520}, \'multiverseid\': 448520}, {\'name\': \'平穏なる広野\', \'text\': \'平穏なる広野はタップ状態で戦場に出る。\\n{T}：{G}か{W}を加える。\', \'type\': \'土地\', \'flavor\': \'ギラプールの混沌の背後には、自然の中に霊気が循環する鮮烈な世界が広がっている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=448801&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6a2f6b1c-41dc-4a73-903f-c366c7817a93\', \'multiverseId\': 448801}, \'multiverseid\': 448801}, {\'name\': \'평온한 광야\', \'text\': \'평온한 광야는 탭된 채로 전장에 들어온다.\\n{T}: {G} 또는 {W}를 추가한다.\', \'type\': \'대지\', \'flavor\': \'기라푸르의 혼돈 너머에는 에테르가 자연을 통해 흐르는 생기 넘치는 세상이 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449082&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5271e2cc-52be-4f8e-9928-f64efaed13e9\', \'multiverseId\': 449082}, \'multiverseid\': 449082}, {\'name\': \'Vastidão Tranquila\', \'text\': \'Vastidão Tranquila entra no campo de batalha virada.\\n{T}: Adicione {G} ou {W}.\', \'type\': \'Terreno\', \'flavor\': \'Para além do caos de Ghirapur há um mundo vibrante onde o éter flui pela natureza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449363&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b9abb5d2-f745-40cc-9889-65cbbf43b7d4\', \'multiverseId\': 449363}, \'multiverseid\': 449363}, {\'name\': \'Безмятежная Долина\', \'text\': \'Безмятежная Долина выходит на поле битвы повернутой.\\n{T}: добавьте {G} или {W}.\', \'type\': \'Земля\', \'flavor\': \'За границами шумного Гирапура раскинулся яркий, живой мир природы, пронизанный потоками эфира.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449644&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cf4f7840-ea55-4ac0-ac00-15b64a3c0763\', \'multiverseId\': 449644}, \'multiverseid\': 449644}, {\'name\': \'静谧旷野\', \'text\': \'静谧旷野须横置进战场。\\n{T}：加{G}或{W}。\', \'type\': \'地\', \'flavor\': \'在混乱不堪的吉拉波之外，是一片生机盎然的世界，那里的乙太在自然中川流不息。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=449925&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'22fc945a-dd78-4b8b-932f-e7558b73c66b\', \'multiverseId\': 449925}, \'multiverseid\': 449925}, {\'name\': \'靜謐曠野\', \'text\': \'靜謐曠野須橫置進戰場。\\n{T}：加{G}或{W}。\', \'type\': \'地\', \'flavor\': \'在混亂不堪的吉拉波之外，是一片生機盎然的世界，那裡的乙太在自然中川流不息。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=450206&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c6b94109-0b73-490a-91c7-3a2bddf3b0b8\', \'multiverseId\': 450206}, \'multiverseid\': 450206}]', "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447687&type=card', 'language': 'German', 'identifiers': {'scryfallId': '7b89ea22-c46b-451e-a6d7-f6a08159e955', 'multiverseId': 447687}, 'multiverseid': 447687}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'im