printings: ['10E', '2ED', '2X2', '2XM', '30A', '3ED', '40K', '4BB', '4ED', '5ED', '6ED', '7ED', '8ED', '9ED', 'A25', 'AER', 'AFC', 'AFR', 'AKH', 'AKR', 'ALA', 'ANA', 'ANB', 'ARC', 'ARN', 'ATH', 'AVR', 'BBD', 'BFZ', 'BLB', 'BRB', 'BRC', 'BRO', 'BTD', 'C13', 'C14', 'C15', 'C16', 'C17', 'C18', 'C19', 'C20', 'C21', 'CC2', 'CED', 'CEI', 'CHK', 'CLB', 'CLU', 'CM2', 'CMA', 'CMD', 'CMM', 'CMR', 'CN2', 'CNS', 'CON', 'CST', 'DBL', 'DD1', 'DD2', 'DDC', 'DDD', 'DDE', 'DDF', 'DDG', 'DDH', 'DDI', 'DDJ', 'DDK', 'DDL', 'DDM', 'DDN', 'DDO', 'DDP', 'DDQ', 'DDR', 'DDS', 'DDT', 'DDU', 'DGM', 'DKM', 'DMR', 'DMU', 'DOM', 'DPA', 'DTK', 'DVD', 'E01', 'E02', 'ELD', 'EMA', 'EVG', 'EXO', 'EXP', 'F01', 'F02', 'F03', 'F04', 'F05', 'FBB', 'FNM', 'FRF', 'G00', 'G01', 'G02', 'G03', 'G04', 'G09', 'G10', 'G17', 'GK1', 'GK2', 'GN2', 'GN3', 'GNT', 'GRN', 'GS1', 'GTC', 'GVL', 'H09', 'HA5', 'HBG', 'HOP', 'HOU', 'ICE', 'IKO', 'IMA', 'INV', 'ISD', 'ITP', 'J14', 'J15', 'J21', 'J22', 'JMP', 'JVC', 'KHM', 'KLD', 'KLR', 'KTK', 'LCC', 'LCI', 'LEA', 'LEB', 'LEG', 'LRW', 'LTC', 'LTR', 'M10', 'M11', 'M12', 'M13', 'M14', 'M15', 'M19', 'M20', 'M21', 'MBS', 'MD1', 'ME1', 'ME2', 'ME3', 'ME4', 'MH1', 'MH2', 'MH3', 'MID', 'MIR', 'MKC', 'MKM', 'MM2', 'MM3', 'MMQ', 'MOC', 'MOM', 'MP2', 'MPR', 'MPS', 'MRD', 'NCC', 'NEC', 'NEO', 'NPH', 'OCM1', 'ODY', 'OLEP', 'OLGC', 'ONE', 'ONS', 'ORI', 'OTC', 'OTJ', 'OTP', 'P02', 'P05', 'P07', 'P09', 'P10', 'P23', 'P30M', 'PAL00', 'PAL01', 'PAL02', 'PAL03', 'PAL04', 'PAL05', 'PAL06', 'PAL99', 'PALP', 'PANA', 'PARL', 'PC2', 'PCA', 'PD2', 'PD3', 'PDCI', 'PDGM', 'PDOM', 'PELP', 'PF19', 'PF20', 'PF24', 'PGPX', 'PGRU', 'PHUK', 'PIP', 'PJAS', 'PJJT', 'PJSE', 'PL24', 'PLGM', 'PLST', 'PMEI', 'PMPS', 'PMPS06', 'PMPS07', 'PMPS08', 'PMPS09', 'PMPS10', 'PMPS11', 'POR', 'PPP1', 'PRM', 'PRW2', 'PRWK', 'PS11', 'PSAL', 'PSS2', 'PSS3', 'PSS4', 'PSTH', 'PSUS', 'PTC', 'PTK', 'PUMA', 'PW23', 'PZ1', 'PZ2', 'RAV', 'REN', 'REX', 'RIX', 'RNA', 'ROE', 'RQS', 'RTR', 'S00', 'S99', 'SCD', 'SHM', 'SIR', 'SLC', 'SLD', 'SLP', 'SNC', 'SOI', 'SOM', 'SS1', 'STA', 'STH', 'STX', 'SUM', 'TD0', 'TD2', 'THB', 'THS', 'TMP', 'TPR', 'TSB', 'TSP', 'UGL', 'UMA', 'UND', 'UNF', 'UNH', 'USG', 'UST', 'V09', 'V10', 'V13', 'V14', 'VIS', 'VMA', 'VOC', 'VOW', 'W17', 'WAR', 'WC00', 'WC01', 'WC02', 'WC03', 'WC04', 'WC97', 'WC98', 'WC99', 'WHO', 'WOC', 'WOE', 'WOT', 'WWK', 'XANA', 'XLN', 'ZEN', 'ZNC', 'ZNE', 'ZNR']
original_text: ['Add {B}{B}{B} to your mana pool.', 'All Sliver creatures get +1/+1.', 'All Sliver creatures have "{2}: This creature gets +0/+1 until end of turn."', 'All Sliver creatures have "{2}: This creature gets +1/+0 until end of turn."', 'All Sliver creatures have flying.', 'All Sliver creatures have trample.', 'All Slivers have "Pay 2 life: Return this permanent to its owner\'s hand."', 'All Slivers have "{2}, Sacrifice this permanent: Draw a card."', 'All Slivers have "{2}, Sacrifice this permanent: This permanent deals 2 damage to target creature or player."', 'All Slivers have "{2}, Sacrifice this permanent: You gain 4 life."', 'All Slivers have "{2}: Regenerate this permanent."', "All Slivers have shroud. (They can't be the targets of spells or abilities.)", 'All creatures lose all abilities and have base power and toughness 1/1.', 'All damage that would be dealt this turn to target creature you control by a source of your choice is dealt to another target creature instead.', 'Any player may play creature cards with converted mana cost 3 or less without paying their mana cost and as though they had flash.', "As Volrath's Laboratory enters the battlefield, choose a color and a creature type.\\n{5}, {T}: Put a 2/2 creature token of the chosen color and type onto the battlefield.", 'As an additional cost to cast Harrow, sacrifice a land.\\nSearch your library for up to two basic land cards and put them onto the battlefield. Then shuffle your library.', "At the beginning of each player's upkeep, that player chooses target player who controls more creatures than he or she does and is his or her opponent. The first player may reveal cards from the top of his or her library until he or she reveals a creature card. If he or she does, that player puts that card onto the battlefield and all other cards revealed this way into his or her graveyard.", 'At the beginning of each upkeep, put a 1/1 green Saproling creature token onto the battlefield.', 'At the beginning of your end step, you may reveal your hand and put all land cards from it onto the battlefield. If you do, discard your hand.', 'At the beginning of your upkeep, Jinxed Idol deals 2 damage to you.\\nSacrifice a creature: Target opponent gains control of Jinxed Idol.', 'At the beginning of your upkeep, if there are no Reflection tokens on the battlefield, put a 2/2 white Reflection creature token onto the battlefield.\\n{0}: Destroy target Reflection.', 'At the beginning of your upkeep, tap Carnophage unless you pay 1 life.', "At the beginning of your upkeep, you may put a treasure counter on Legacy's Allure.\\nSacrifice Legacy's Allure: Gain control of target creature with power less than or equal to the number of treasure counters on Legacy's Allure.", 'B', 'Buyback {2} (You may pay an additional {2} as you cast this spell. If you do, put this card into your hand as it resolves.)\\nReturn the top creature card of your graveyard to the battlefield. That creature gains haste until end of turn. Exile it at the beginning of the next end step.', "Buyback {3} (You may pay an additional {3} as you cast this spell. If you do, put this card into your hand as it resolves.)\\nEvincar's Justice deals 2 damage to each creature and each player.", 'Buyback {3} (You may pay an additional {3} as you cast this spell. If you do, put this card into your hand as it resolves.)\\nFanning the Flames deals X damage to target creature or player.', 'Buyback {3} (You may pay an additional {3} as you cast this spell. If you do, put this card into your hand as it resolves.)\\nPrevent the next 3 damage that would be dealt to target creature this turn.', "Buyback {3} (You may pay an additional {3} as you cast this spell. If you do, put this card into your hand as it resolves.)\\nReturn target permanent to its owner's hand.", 'Buyback {3} (You may pay an additional {3} as you cast this spell. If you do, put this card into your hand as it resolves.)\\nTarget creature gets +3/+0 until end of turn.', "Buyback {3} (You may pay an additional {3} as you cast this spell. If you do, put this card into your hand as it resolves.)\\nTarget land becomes a 2/2 creature that's still a land.", 'Buyback {4} (You may pay an additional {4} as you cast this spell. If you do, put this card into your hand as it resolves.)\\nPut a 1/1 black Rat creature token onto the battlefield.', 'Buyback {4} (You may pay an additional {4} as you cast this spell. If you do, put this card into your hand as it resolves.)\\nSearing Touch deals 1 damage to target creature or player.', 'Buyback {4} (You may pay an additional {4} as you cast this spell. If you do, put this card into your hand as it resolves.)\\nTarget creature gets +2/+2 until end of turn.', 'Buyback {5} (You may pay an additional {5} as you cast this spell. If you do, put this card into your hand as it resolves.)\\nDraw a card.', 'Buyback—\\nDiscard two cards. (You may discard two cards in addition to any other costs as you cast this spell. If you do, put this card into your hand as it resolves.)\\nCounter target spell.', 'Buyback—\\nSacrifice a land. (You may sacrifice a land in addition to any other costs as you cast this spell. If you do, put this card into your hand as it resolves.)\\nPut a 1/1 white Pegasus creature token with flying onto the battlefield.', 'Caldera Lake enters the battlefield tapped.\\n{T}: Add {1} to your mana pool.\\n{T}: Add {U} or {R} to your mana pool. Caldera Lake deals 1 damage to you.', 'Cast Necrologia only during your end step.\\nAs an additional cost to cast Necrologia, pay X life.\\nDraw X cards.', 'Choose two target creatures controlled by the same player. Exile one of those creatures and put two +1/+1 counters on the other.', 'Counter target spell unless its controller pays {3}.', 'Counter target spell with converted mana cost X.', 'Counter target spell.', 'Counter target spell.\\nDraw a card.', "Craven Giant can't block.", 'Creatures you control get +3/+3 and gain trample until end of turn.', "Crovax the Cursed enters the battlefield with four +1/+1 counters on it.\\nAt the beginning of your upkeep, you may sacrifice a creature. If you do, put a +1/+1 counter on Crovax. If you don't, remove a +1/+1 counter from Crovax.\\n{B}: Crovax gains flying until end of turn.", 'Defender\\nWall of Diffusion can block creatures with shadow as though Wall of Diffusion had shadow.', 'Defender\\nWhen Wall of Blossoms enters the battlefield, draw a card.', 'Defender\\nWhenever Wall of Essence is dealt combat damage, you gain that much life.', 'Defender\\nWhenever Wall of Souls is dealt combat damage, it deals that much damage to target opponent.', "Destroy all creatures target player controls. For each creature that died this way, put two 1/1 red Goblin creature tokens onto the battlefield under that player's control.", "Destroy all creatures that aren't enchanted. They can't be regenerated.", 'Destroy all enchantments.', 'Destroy target artifact or enchantment.', 'Destroy target artifact, creature, or land. Aftershock deals 3 damage to you.', 'Destroy target artifact.', 'Destroy target blocked creature.', "Destroy target nonblack creature. It can't be regenerated.", 'Destroy target tapped creature.', 'Discard a card: Regenerate Patchwork Gnomes.', 'Discard a card: Thalakos Drifters gains shadow until end of turn. (It can block or be blocked by only creatures with shadow.)', 'Discard a creature card: Vampire Hounds gets +2/+2 until end of turn.', 'Distribute two +1/+1 counters among one or two target creatures.', 'Draw four cards. You skip your next turn.', 'Draw three cards, then discard a card.', "Dream Prowler can't be blocked as long as it's attacking alone.", 'Each creature gets +1/+1 for each other creature on the battlefield that shares at least one creature type with it. (For example, if two Goblin Warriors and a Goblin Shaman are on the battlefield, each gets +2/+2.)', 'Each player chooses from among the permanents he or she controls an artifact, a creature, an enchantment, and a land, then sacrifices the rest.', 'Each player exiles all creature cards from his or her graveyard, then sacrifices all creatures he or she controls, then puts all cards he or she exiled this way onto the battlefield.', "Enchant creature\\nEnchanted creature can't attack or block, and its activated abilities can't be activated. That creature's controller may sacrifice a permanent for that player to ignore this effect until end of turn.\\n{1}{U}: Return Volrath's Curse to its owner's hand.", "Enchant creature\\nEnchanted creature can't attack or block.", "Enchant creature\\nEnchanted creature doesn't untap during its controller's untap step.\\n{W}: Return Shackles to its owner's hand.", "Enchant creature\\nEnchanted creature gets +1/+3.\\n{W}: Return Conviction to its owner's hand.", "Enchant creature\\nEnchanted creature gets +2/+2 and can't block.", "Enchant creature\\nEnchanted creature gets +3/+3.\\nWhen enchanted creature becomes the target of a spell or ability, destroy that creature. It can't be regenerated.", "Enchant creature\\nEnchanted creature gets -1/-1 and has fear. (It can't be blocked except by artifact creatures and/or black creatures.)", 'Enchant creature\\nPrevent all combat damage that would be dealt to and dealt by enchanted creature.', 'Enchant creature\\nWhenever enchanted creature deals damage to an opponent, you may draw a card.', 'Enchant creature\\n{R}: Enchanted creature gets +1/-1 until end of turn.', 'Exchange control of target artifact or creature and another target permanent that shares one of those types with it.', "Fear (This creature can't be blocked except by artifact creatures and/or black creatures.)\\nWhen Commander Greven il-Vec enters the battlefield, sacrifice a creature.", 'First strike', 'First strike, forestwalk, vigilance', 'First strike, protection from black and from red', 'First strike\\nAt the beginning of your upkeep, if your opponents control no creatures, Kezzerdrix deals 4 damage to you.', 'First strike\\nWhenever Renegade Warlord attacks, each other attacking creature gets +1/+0 until end of turn.', 'First strike\\n{R}: Sandstone Warrior gets +1/+0 until end of turn.', 'Flame Wave deals 4 damage to target player and each creature he or she controls.', 'Flying', 'Flying, first strike', "Flying\\nAs Dracoplasm enters the battlefield, sacrifice any number of creatures. Dracoplasm's power becomes the total power of those creatures and its toughness becomes their total toughness.\\n{R}: Dracoplasm gets +1/+0 until end of turn.", "Flying\\nDiscard a card: Return Ephemeron to its owner's hand.", 'Flying\\nDiscard a creature card: Skyshroud Vampire gets +2/+2 until end of turn.', "Flying\\nExalted Dragon can't attack unless you sacrifice a land. (This cost is paid as attackers are declared.)", "Flying\\nPay 2 life: Return Selenia, Dark Angel to its owner's hand.", "Flying\\nRevenant's power and toughness are each equal to the number of creature cards in your graveyard.", 'Flying\\nSacrifice Shard Phoenix: Shard Phoenix deals 2 damage to each creature without flying.\\n{R}{R}{R}: Return Shard Phoenix from your graveyard to your hand. Activate this ability only during your upkeep.', 'Flying\\nThopter Squadron enters the battlefield with three +1/+1 counters on it.\\n{1}, Remove a +1/+1 counter from Thopter Squadron: Put a 1/1 colorless Thopter artifact creature token with flying onto the battlefield. Activate this ability only any time you could cast a sorcery.\\n{1}, Sacrifice another Thopter: Put a +1/+1 counter on Thopter Squadron. Activate this ability only any time you could cast a sorcery.', "Flying\\nWhen Avenging Angel dies, you may put it on top of its owner's library.", 'Flying\\nWhen Rathi Dragon enters the battlefield, sacrifice it unless you sacrifice two Mountains.', 'Flying\\nWhenever Angelic Protector becomes the target of a spell or ability, Angelic Protector gets +0/+3 until end of turn.', 'Flying\\n{0}: The next 1 damage that would be dealt to Spirit en-Kor this turn is dealt to target creature you control instead.', 'Flying\\n{1}{B}: Regenerate Screeching Harpy.', 'Flying\\n{B}: Dungeon Shade gets +1/+1 until end of turn.', 'Flying\\n{R}: Flowstone Wyvern gets +2/-2 until end of turn.', "Flying\\n{T}, Tap two untapped creatures you control: Return target permanent to its owner's hand.", 'Flying\\n{T}: Mawcor deals 1 damage to target creature or player.', 'Flying\\n{T}: Target creature gains flying until end of turn.', 'Flying\\n{U}: Change the target of target spell or ability that targets only Silver Wyvern. The new target must be a creature.', "Flying\\n{U}: Put Wayward Soul on top of its owner's library.", 'G', "Hammerhead Shark can't attack unless defending player controls an Island.", 'Heartwood Dryad can block creatures with shadow as though Heartwood Dryad had shadow.', "If Mox Diamond would enter the battlefield, you may discard a land card instead. If you do, put Mox Diamond onto the battlefield. If you don't, put it into its owner's graveyard.\\n{T}: Add one mana of any color to your mana pool.", 'Kindle deals X damage to target creature or player, where X is 2 plus the number of cards named Kindle in all graveyards.', 'Krakilin enters the battlefield with X +1/+1 counters on it.\\n{1}{G}: Regenerate Krakilin.', 'Lightning Blast deals 4 damage to target creature or player.', "Magmasaur enters the battlefield with five +1/+1 counters on it.\\nAt the beginning of your upkeep, you may remove a +1/+1 counter from Magmasaur. If you don't, sacrifice Magmasaur and it deals damage equal to the number of +1/+1 counters on it to each creature without flying and each player.", 'Mindless Automaton enters the battlefield with two +1/+1 counters on it.\\n{1}, Discard a card: Put a +1/+1 counter on Mindless Automaton.\\nRemove two +1/+1 counters from Mindless Automaton: Draw a card.', "Mogg Conscripts can't attack unless you've cast a creature spell this turn.", "Mogg Flunkies can't attack or block alone.", "Mountainwalk (This creature can't be blocked as long as defending player controls a Mountain.)", 'Needle Storm deals 4 damage to each creature with flying.', 'Pine Barrens enters the battlefield tapped.\\n{T}: Add {1} to your mana pool.\\n{T}: Add {B} or {G} to your mana pool. Pine Barrens deals 1 damage to you.', 'Prevent the next 1 damage that would be dealt to target creature or player this turn.\\nDraw a card.', 'Protection from black\\nShadow (This creature can block or be blocked by only creatures with shadow.)', 'Protection from red\\nShadow (This creature can block or be blocked by only creatures with shadow.)', 'Put target creature card from a graveyard onto the battlefield under your control. You lose life equal to its converted mana cost.', "Put target creature on top of its owner's library.", 'R', 'Rather than pay the mana cost for a spell, its controller may discard a card that shares a color with that spell.', 'Reach (This creature can block creatures with flying.)', 'Reach (This creature can block creatures with flying.)\\n{W}: Mounted Archers can block an additional creature this turn.', 'Return two target creature cards from your graveyard to your hand.', 'Reveal the top four cards of your library. Put all land cards revealed this way into your hand and the rest into your graveyard.', 'Rolling Thunder deals X damage divided as you choose among any number of target creatures and/or players.', 'Sacrifice Bottle Gnomes: You gain 3 life.', 'Sacrifice Mogg Fanatic: Mogg Fanatic deals 1 damage to target creature or player.', 'Sacrifice Skyshaper: Creatures you control gain flying until end of turn.', "Sacrifice a creature, Return Recurring Nightmare to its owner's hand: Return target creature card from your graveyard to the battlefield. Activate this ability only any time you could cast a sorcery.", 'Sacrifice a creature: Goblin Bombardment deals 1 damage to target creature or player.', 'Salt Flats enters the battlefield tapped.\\n{T}: Add {1} to your mana pool.\\n{T}: Add {W} or {B} to your mana pool. Salt Flats deals 1 damage to you.', 'Scabland enters the battlefield tapped.\\n{T}: Add {1} to your mana pool.\\n{T}: Add {R} or {W} to your mana pool. Scabland deals 1 damage to you.', "Sea Monster can't attack unless defending player controls an Island.", 'Search your library for a basic land card and put that card onto the battlefield tapped. Then shuffle your library.', 'Search your library for three cards and reveal them. Target opponent chooses one. Put that card into your hand and the rest into your graveyard. Then shuffle your library.', 'Shadow (This creature can block or be blocked by only creatures with shadow.)', "Shadow (This creature can block or be blocked by only creatures with shadow.)\\nDauthi Horror can't be blocked by white creatures.", 'Shadow (This creature can block or be blocked by only creatures with shadow.)\\nDauthi Slayer attacks each turn if able.', "Shadow (This creature can block or be blocked by only creatures with shadow.)\\nDauthi Warlord's power is equal to the number of creatures with shadow on the battlefield.", "Shadow (This creature can block or be blocked by only creatures with shadow.)\\nDiscard a card: Return Thalakos Scout to its owner's hand.", "Shadow (This creature can block or be blocked by only creatures with shadow.)\\nSoltari Lancer has first strike as long as it's attacking.", 'Shadow (This creature can block or be blocked by only creatures with shadow.)\\nWhen Thalakos Seer leaves the battlefield, draw a card.', 'Shadow (This creature can block or be blocked by only creatures with shadow.)\\nWhenever Soltari Champion attacks, other creatures you control get +1/+1 until end of turn.', 'Shadow (This creature can block or be blocked by only creatures with shadow.)\\nWhenever Soltari Trooper attacks, it gets +1/+1 until end of turn.', 'Shadow (This creature can block or be blocked by only creatures with shadow.)\\n{0}: The next time Soltari Guerrillas would deal combat damage to an opponent this turn, it deals that damage to target creature instead.', 'Shadow (This creature can block or be blocked by only creatures with shadow.)\\n{B}{B}, Sacrifice Dauthi Jackal: Destroy target blocking creature.', 'Shadowstorm deals 2 damage to each creature with shadow.', 'Skip your draw step.\\nWhenever you play a card, draw a card.\\nYour maximum hand size is two. (You discard down to your maximum hand size as your turn ends.)', 'Skyshroud Forest enters the battlefield tapped.\\n{T}: Add {1} to your mana pool.\\n{T}: Add {G} or {U} to your mana pool. Skyshroud Forest deals 1 damage to you.', 'Spike Breeder enters the battlefield with three +1/+1 counters on it.\\n{2}, Remove a +1/+1 counter from Spike Breeder: Put a +1/+1 counter on target creature.\\n{2}, Remove a +1/+1 counter from Spike Breeder: Put a 1/1 green Spike creature token onto the battlefield.', 'Spike Colony enters the battlefield with four +1/+1 counters on it.\\n{2}, Remove a +1/+1 counter from Spike Colony: Put a +1/+1 counter on target creature.', 'Spike Feeder enters the battlefield with two +1/+1 counters on it.\\n{2}, Remove a +1/+1 counter from Spike Feeder: Put a +1/+1 counter on target creature.\\nRemove a +1/+1 counter from Spike Feeder: You gain 2 life.', 'Spike Hatcher enters the battlefield with six +1/+1 counters on it.\\n{2}, Remove a +1/+1 counter from Spike Hatcher: Put a +1/+1 counter on target creature.\\n{1}, Remove a +1/+1 counter from Spike Hatcher: Regenerate Spike Hatcher.', 'Spitting Hydra enters the battlefield with four +1/+1 counters on it.\\n{1}{R}, Remove a +1/+1 counter from Spitting Hydra: Spitting Hydra deals 1 damage to target creature.', 'Tap an untapped creature you control: Telethopter gains flying until end of turn.', 'Tap target creature. It deals damage equal to its power to another target creature.', 'Target blocking creature gets +4/+4 until end of turn.\\nDraw a card.', "Target creature can't block this turn.\\nDraw a card.", 'Target creature deals damage to itself equal to its power.', 'Target creature gains shadow until end of turn. (It can block or be blocked by only creatures with shadow.)\\nDraw a card.', 'Target creature gets +3/+3 and gains flying until end of turn.', 'Target creature loses shadow until end of turn.\\nDraw a card.', 'Target opponent reveals his or her hand. You choose a card from it. That player discards that card.', 'Target player discards three cards.', 'Target player sacrifices a creature.', 'Target player takes an extra turn after this one.', 'Trample', 'Trample\\n{1}{G}: Regenerate Carnassid.', 'Trample\\n{R}: Flowstone Mauler gets +1/-1 until end of turn.', 'U', "Untap target creature you don't control. That creature blocks this turn if able.\\nDraw a card.", 'Vigilance', 'W', 'When Anarchist enters the battlefield, you may return target sorcery card from your graveyard to your hand.', 'When Gravedigger enters the battlefield, you may return target creature card from your graveyard to your hand.', 'When Sarcomancy enters the battlefield, put a 2/2 black Zombie creature token onto the battlefield.\\nAt the beginning of your upkeep, if there are no Zombies on the battlefield, Sarcomancy deals 1 damage to you.', 'When Scrivener enters the battlefield, you may return target instant card from your graveyard to your hand.', 'When Serpent Warrior enters the battlefield, you lose 3 life.', 'When Staunch Defenders enters the battlefield, you gain 4 life.', 'When you control a creature with toughness 2 or less, sacrifice Endangered Armodon.', 'When you play another land, sacrifice City of Traitors.\\n{T}: Add {2} to your mana pool.', 'Whenever Charging Paladin attacks, it gets +0/+3 until end of turn.', 'Whenever Crashing Boars attacks, defending player chooses an untapped creature he or she controls. That creature blocks Crashing Boars this turn if able.', 'Whenever Lowland Basilisk deals damage to a creature, destroy that creature at end of combat.', 'Whenever Mogg Maniac is dealt damage, it deals that much damage to target opponent.', 'Whenever a Sliver becomes blocked, that Sliver gets +1/+1 until end of turn for each creature blocking it.', "Whenever a creature enters the battlefield, that creature's controller may have it deal damage equal to its power to target creature or player of his or her choice.", "Whenever a creature is dealt damage, destroy it. It can't be regenerated.", 'Whenever a nontoken creature is put into your graveyard from the battlefield, put a 1/1 white Spirit creature token with flying onto the battlefield.', 'Whenever a player casts a spell, Spellshock deals 2 damage to that player.', 'You may choose not to untap Coffin Queen during your untap step.\\n{2}{B}, {T}: Put target creature card from a graveyard onto the battlefield under your control. When Coffin Queen becomes untapped or you lose control of Coffin Queen, exile that creature.', 'You may tap or untap target artifact, creature, or land.\\nDraw a card.', '{0}: The next 1 damage that would be dealt to Nomads en-Kor this turn is dealt to target creature you control instead.', '{0}: The next 1 damage that would be dealt to Shaman en-Kor this turn is dealt to target creature you control instead.\\n{1}{W}: The next time a source of your choice would deal damage to target creature this turn, that damage is dealt to Shaman en-Kor instead.', '{0}: The next 1 damage that would be dealt to Warrior en-Kor this turn is dealt to target creature you control instead.', "{1}, {T}: Return target creature to its owner's hand unless its controller pays {1}.", "{1}{B}, Sacrifice Thrull Surgeon: Look at target player's hand and choose a card from it. That player discards that card. Activate this ability only any time you could cast a sorcery.", '{1}{G}: Regenerate Skyshroud Troll.', '{1}{G}: Rootwalla gets +2/+2 until end of turn. Activate this ability only once each turn.', '{2}, Discard a card at random: Ogre Shaman deals 2 damage to target creature or player.', '{2}: Put a 1/1 colorless Sliver creature token onto the battlefield.', '{2}{W}: Creatures you control get +1/+1 until end of turn.', "{3}, {T}: Name a card. Reveal a card at random from your hand. If it's the named card, Cursed Scroll deals 2 damage to target creature or player.", '{3}, {T}: Target player puts the top two cards of his or her library into his or her graveyard. If both cards share a color, repeat this process.', '{5}, {T}: Draw two cards, then discard a card.', '{B}: Destroy target artifact, creature, or land you control.', '{G}, Discard a creature card: Search your library for a creature card, reveal that card, and put it into your hand. Then shuffle your library.', '{G}, {T}: Reveal cards from the top of your library until you reveal a basic land card. Put that card into your hand and all other cards revealed this way into your graveyard.', "{R}: Target creature can't be regenerated this turn.", '{T}, Discard a card at random: Mage il-Vec deals 1 damage to target creature or player.', '{T}, Sacrifice Lotus Petal: Add one mana of any color to your mana pool.', '{T}, Sacrifice a Forest: Heartwood Giant deals 2 damage to target player.', '{T}, Sacrifice a creature: Destroy target nonblack creature.', '{T}: Add {1} to your mana pool.\\n{1}{B}, {T}: Put target creature card from your graveyard on top of your library.', "{T}: Add {1} to your mana pool.\\n{6}: Stalking Stones becomes a 3/3 Elemental artifact creature that's still a land.", '{T}: Add {1} to your mana pool.\\n{T}, Sacrifice Wasteland: Destroy target nonbasic land.', "{T}: Add {1} to your mana pool.\\n{T}: Add {B} or {R} to your mana pool. Cinder Marsh doesn't untap during your next untap step.", "{T}: Add {1} to your mana pool.\\n{T}: Add {G} or {W} to your mana pool. Vec Townships doesn't untap during your next untap step.", "{T}: Add {1} to your mana pool.\\n{T}: Add {R} or {G} to your mana pool. Mogg Hollows doesn't untap during your next untap step.", "{T}: Add {1} to your mana pool.\\n{T}: Add {U} or {B} to your mana pool. Rootwater Depths doesn't untap during your next untap step.", "{T}: Add {1} to your mana pool.\\n{T}: Add {W} or {U} to your mana pool. Thalakos Lowlands doesn't untap during your next untap step.", '{T}: Add {1} to your mana pool.\\n{T}: Untap target attacking creature with shadow. Prevent all combat damage that would be dealt to and dealt by that creature this turn.', '{T}: Add {G} to your mana pool.\\n{1}: Add {R} or {W} to your mana pool.', "{T}: Destroy target artifact or creature. That permanent's controller gains control of Starke of Rath.", '{T}: Draw a card, then discard a card.', '{T}: Name a creature card. Reveal the top four cards of your library and put all of them with that name into your hand. Put the rest into your graveyard.', '{T}: Prevent the next 3 damage that would be dealt to target creature or player this turn.', '{T}: Rootwater Hunter deals 1 damage to target creature or player.', '{T}: Until end of turn, target creature has base power 1 or base toughness 1.', '{U}: Killer Whale gains flying until end of turn.', '{W}, {T}: Tap target creature.']
