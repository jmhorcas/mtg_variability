layout: ['normal']
names: []
mana_cost: ['{1}{W}{U}', '{2}{G}{G}', '{2}{G}{U}{R}', '{2}{U}{B}{R}', '{3}', '{3}{U}{U}', '{3}{W}{U}{B}', '{5}{W}{B}{G}', '{5}{W}{W}']
