subtypes: ['Ally', 'Aura', 'Centaur', 'Eldrazi', 'Elf', 'Human', 'Rogue', 'Satyr', 'Shaman', 'Shapeshifter', 'Sliver', 'Soldier', 'Spirit', 'Wizard']
