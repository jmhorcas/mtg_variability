name: ['Ajani Goldmane', 'Arcbound Ravager', 'Avatar of Woe', 'Emrakul, the Aeons Torn', 'Eternal Dragon', 'Liliana of the Veil', "Mirari's Wake", 'Noble Hierarch', 'Snapcaster Mage', 'Treva, the Renewer']
