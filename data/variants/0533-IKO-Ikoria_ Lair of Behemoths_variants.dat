: '83fd8d12-8960-423b-938a-7988c5b4b0c4', 'multiverseId': 482670}, 'multiverseid': 482670}, {'name': '平原', 'type': '基本地 ～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482685&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '442a1924-61af-4a72-a2a7-04205523062f', 'multiverseId': 482685}, 'multiverseid': 482685}]", "[{'name': 'Ebene', 'type': 'Standardland — Ebene', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482551&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'dee8bcd2-a445-4b60-92d4-4dadb08f92d7', 'multiverseId': 482551}, 'multiverseid': 482551}, {'name': 'Llanura', 'type': 'Tierra básica — Llanura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482566&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'f3d8c60b-10a2-46b5-80ed-bb62afb7267b', 'multiverseId': 482566}, 'multiverseid': 482566}, {'name': 'Plaine', 'type': 'Terrain de base : plaine', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482581&type=card', 'language': 'French', 'identifiers': {'scryfallId': '62fb29d0-a1a7-4f78-99f5-979024f7f645', 'multiverseId': 482581}, 'multiverseid': 482581}, {'name': 'Pianura', 'type': 'Terra Base — Pianura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482596&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '88efff33-ac05-4c5b-a9bd-b71c2fb95d28', 'multiverseId': 482596}, 'multiverseid': 482596}, {'name': '平地', 'type': '基本土地 — 平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482611&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '21c55dad-9c85-478c-b4ef-ddb2fa621837', 'multiverseId': 482611}, 'multiverseid': 482611}, {'name': '들', 'type': '기본 대지 — 들', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handler