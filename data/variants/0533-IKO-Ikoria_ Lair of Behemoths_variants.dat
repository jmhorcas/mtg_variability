aditional', 'identifiers': {'scryfallId': '9741d97f-aef9-4170-96ce-a54870857454', 'multiverseId': 482693}, 'multiverseid': 482693}]", "[{'name': 'Sylphidendrache', 'text': 'Fliegend, Eile\\nImmer wenn du einen Nichtkreatur-Zauberspruch wirkst, lege eine +1/+1-Marke auf den Sylphidendrachen.', 'type': 'Kreatur — Feenwesen, Drache', 'flavor': 'Dorat, Haustier der Zukunft', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482395&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd27adbdb-a79b-475a-ab5d-18f5e38c5315', 'multiverseId': 482395}, 'multiverseid': 482395}, {'name': 'Dragonhada', 'text': 'Vuela, prisa.\\nSiempre que lances un hechizo que no sea de criatura, pon un contador +1/+1 sobre el Dragonhada.', 'type': 'Criatura — Dragón hada', 'flavor': 'Dorat, la Mascota Perfecta', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482409&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '1383a543-c6fe-4cfb-9605-e4ac95a63655', 'multiverseId': 482409}, 'multiverseid': 482409}, {'name': 'Dragon farfadet', 'text': 'Vol, célérité\\nÀ chaque fois que vous lancez un sort non-créature, mettez un marqueur +1/+1 sur le Dragon farfadet.', 'type': 'Créature : peuple fée et dragon', 'flavor': 'Dorat, le compagnon idéal', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482423&type=card', 'language': 'French', 'identifiers': {'scryfallId': '31aba974-35b4-4cf2-9143-c2a4d96cc8a2', 'multiverseId': 482423}, 'multiverseid': 482423}, {'name': 'Drago Spiritello', 'text': 'Volare, rapidità\\nOgniqualvolta lanci una magia non creatura, metti un segnalino +1/+1 sul Drago Spiritello.', 'type': 'Creatura — Drago Spiritello', 'flavor': 'Dorat, il Compagno Perfetto', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482437&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'f4d44907-830e-4126-8fcc-d197bcc9eaa3', 'multiverseId': 482437}, 'multiverseid': 482437}, {'name': 'スプライトのドラゴン', 'text': '飛行、速攻\\nあなたがクリーチャーでない呪文を唱えるたび、スプライトのドラゴンの上に＋１/＋１カウンターを１個置く。', 'type': 'クリーチャー — フェアリー・ドラゴン', 'flavor': '理（り）想（そう）のペット、ドラット', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482451&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'cf289595-8229-48f0-afdf-27821750050f', 'multiverseId': 482451}, 'multiverseid': 482451}, {'name': '요정 용', 'text': '비행, 신속\\n당신이 생물이 아닌 주문을 발동할 때마다, 요정 용에 +1/+1 카운터 한 개를 올려놓는다.', 'type': '생물 — 페어리 용', 'flavor': '완벽한 애완동물, 도랏트', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482465&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '6c216d89-ee3b-419c-942f-de660321ed49', 'multiverseId': 482465}, 'multiverseid': 482465}, {'name': 'Dragão Sílfide', 'text': 'Voar, ímpeto\\nToda vez que você conjurar uma mágica que não seja de criatura, coloque um marcador +1/+1 em Dragão Sílfide.', 'type': 'Criatura — Fada Dragão', 'flavor': 'Dorat, a Mascote Perfeita', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482479&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9c7e08a6-f763-4e70-aa33-f472ba553b03', 'multiverseId': 482479}, 'multiverseid': 482479}, {'name': 'Дракон-Пикси', 'text': 'Полет, Ускорение\\nКаждый раз, когда вы разыгрываете не являющееся существом заклинание, положите один жетон +1/+1 на Дракона-Пикси.', 'type': 'Существо — Фея Дракон', 'flavor': 'Дорат, Идеальный Питомец', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482493&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'eeec2b12-2d3f-4f69-8f43-dadae4e01ad0', 'multiverseId': 482493}, 'multiverseid': 482493}, {'name': '仙翼翔龙', 'text': '飞行，敏捷\\n每当你施放非生物咒语时，在仙翼翔龙上放置一个+1/+1指示物。', 'type': '生物 ～仙灵／龙', 'flavor': '完美宠物杜勒兽', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482507&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '3e6a1e24-17b2-4bb4-a832-a05b0deebf7e', 'multiverseId': 482507}, 'multiverseid': 482507}, {'name': '仙翼翔龍', 'text': '飛行，敏捷\\n每當你施放非生物咒語時，在仙翼翔龍上放置一個+1/+1指示物。', 'type': '生物 ～仙靈／龍', 'flavor': '完美寵物杜勒獸', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482521&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '7280b13e-c87e-45f2-94dc-cc644cdd20b3', 'multiverseId': 482521}, 'multiverseid': 482521}]", '[{\'name\': \'Sylphidendrache\', \'text\': \'Fliegend, Eile\\nImmer wenn du einen Nichtkreatur-Zauberspruch wirkst, lege eine +1/+1-Marke auf den Sylphidendrachen.\', \'type\': \'Kreatur — Feenwesen, Drache\', \'flavor\': \'Groß wie eine Fee, wütend wie ein Höllendrache.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479990&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'62180c06-4eb3-480c-bd07-83988296e740\', \'multiverseId\': 479990}, \'multiverseid\': 479990}, {\'name\': \'Dragonhada\', \'text\': \'Vuela, prisa.\\nSiempre que lances un hechizo que no sea de criatura, pon un contador +1/+1 sobre el Dragonhada.\', \'type\': \'Criatura — Dragón hada\', \'flavor\': \'Con el tamaño de un duendecillo y la rabia de un engendro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480249&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8394138c-b521-412e-a7da-bd3f24285890\', \'multiverseId\': 480249}, \'multiverseid\': 480249}, {\'name\': \'Dragon farfadet\', \'text\': \'Vol, célérité\\nÀ chaque fois que vous lancez un sort non-créature, mettez un marqueur +1/+1 sur le Dragon farfadet.\', \'type\': \'Créature : peuple fée et dragon\', \'flavor\': "La taille d\'une pixie, mais la rage d\'un escouflenfer.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480508&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'742bd31d-f23c-479c-a768-ab573aa0bc2f\', \'multiverseId\': 480508}, \'multiverseid\': 480508}, {\'name\': \'Drago Spiritello\', \'text\': \'Volare, rapidità\\nOgniqualvolta lanci una magia non creatura, metti un segnalino +1/+1 sul Drago Spiritello.\', \'type\': \'Creatura — Drago Spiritello\', \'flavor\': \'Le dimensioni di una fatina, la furia di un nibbio infernale.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480767&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b8fcc4d6-9cc1-44ac-b6d8-ae4d5e658cd9\', \'multiverseId\': 480767}, \'multiverseid\': 480767}, {\'name\': \'スプライトのドラゴン\', \'text\': \'飛行、速攻\\nあなたがクリーチャーでない呪文を唱えるたび、スプライトのドラゴンの上に＋１/＋１カウンターを１個置く。\', \'type\': \'クリーチャー — フェアリー・ドラゴン\', \'flavor\': \'ピクシー並みの体、ヘルカイト並みの怒り。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481026&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9e63eca8-3f9f-426d-9e6b-36f74ecd5fa0\', \'multiverseId\': 481026}, \'multiverseid\': 481026}, {\'name\': \'요정 용\', \'text\': \'비행, 신속\\n당신이 생물이 아닌 주문을 발동할 때마다, 요정 용에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 페어리 용\', \'flavor\': \'픽시의 크기, 지옥룡의 분노.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481285&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5def3aca-7d5c-4e36-92d8-d580ac53b54b\', \'multiverseId\': 481285}, \'multiverseid\': 481285}, {\'name\': \'Dragão Sílfide\', \'text\': \'Voar, ímpeto\\nToda vez que você conjurar uma mágica que não seja de criatura, coloque um marcador +1/+1 em Dragão Sílfide.\', \'type\': \'Criatura — Fada Dragão\', \'flavor\': \'O tamanho de uma sílfide e a fúria de um avérneo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481544&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ffb3fff6-1c7d-45ab-ad81-4a262480be9a\', \'multiverseId\': 481544}, \'multiverseid\': 481544}, {\'name\': \'Дракон-Пикси\', \'text\': \'Полет, Ускорение\\nКаждый раз, когда вы разыгрываете не являющееся существом заклинание, положите один жетон +1/+1 на Дракона-Пикси.\', \'type\': \'Существо — Фея Дракон\', \'flavor\': \'Размером с фею, но с яростью огненного змея.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481803&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'176d25fa-1ec3-48f1-b447-8e99dcedda2d\', \'multiverseId\': 481803}, \'multiverseid\': 481803}, {\'name\': \'仙翼翔龙\', \'text\': \'飞行，敏捷\\n每当你施放非生物咒语时，在仙翼翔龙上放置一个+1/+1指示物。\', \'type\': \'生物 ～仙灵／龙\', \'flavor\': \'身形娇小若碧仙，怒火无情似巨龙。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482062&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8f2cfb65-ac16-48b1-b4ab-035663298ae0\', \'multiverseId\': 482062}, \'multiverseid\': 482062}, {\'name\': \'仙翼翔龍\', \'text\': \'飛行，敏捷\\n每當你施放非生物咒語時，在仙翼翔龍上放置一個+1/+1指示物。\', \'type\': \'生物 ～仙靈／龍\', \'flavor\': \'身形嬌小若碧仙，怒火無情似巨龍。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482321&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'133fadc7-4bd7-42b7-8bee-fbca81b997d0\', \'multiverseId\': 482321}, \'multiverseid\': 482321}]', '[{\'name\': \'Tapferer Retter\', \'text\': \'Immer wenn du zum ersten Mal in einem Zug eine andere Karte umwandelst, erzeuge einen 1/1 weißen Mensch-Soldat-Kreaturenspielstein.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'In der schwebenden Himmelstadt gibt es zwei Regeln: Lass deine Kameraden nie zurück und beuge dich nicht zu weit über das Geländer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479815&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4409850f-4bc1-417c-9d93-26f7340fd40a\', \'multiverseId\': 479815}, \'multiverseid\': 479815}, {\'name\': \'Rescatador valiente\', \'text\': \'Siempre que actives una habilidad de ciclo de otra carta por primera vez cada turno, crea una ficha de criatura Soldado Humano blanca 1/1.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'La ciudad flotante de Puertoaéreo tiene dos reglas: no dejes detrás a tus compañeros y no estropees las barandillas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480074&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f34aa18d-d809-43a6-b006-266b9b5e5e4f\', \'multiverseId\': 480074}, \'multiverseid\': 480074}, {\'name\': \'Sauveteur valeureux\', \'text\': \'À chaque fois que vous recyclez une autre carte pour la première fois à chaque tour, créez un jeton de créature 1/1 blanche Humain et Soldat.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)\', \'type\': \'Créature : humain et soldat\', \'flavor\': \'Il existe deux règles dans la ville volante de Vogueciel : ne pas abandonner son équipage, et ne pas saboter les rambardes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480333&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'71cdb2e3-132f-4fc2-aad7-d9bc3139599a\', \'multiverseId\': 480333}, \'multiverseid\': 480333}, {\'name\': \'Soccorritore Impavido\', \'text\': "Ogniqualvolta cicli un\'altra carta per la prima volta in ogni turno, crea una pedina creatura Soldato Umano 1/1 bianca.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)", \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'La città fluttuante Solcanembi ha due regole: non abbandonare i membri della ciurma e non toccare le barriere di sicurezza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480592&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9696ff45-0acc-4673-be19-9e81a3c15f50\', \'multiverseId\': 480592}, \'multiverseid\': 480592}, {\'name\': \'雄々しい救出者\', \'text\': \'各ターン内で初めてあなたが他のカードをサイクリングするたび、白の１/１の人間・兵士・クリーチャー・トークンを１体生成する。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'浮遊都市スカイセイルには二つの掟がある。船員を置き去りにしないことと、柵を粗末にしないことだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480851&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0c354519-f8d5-4107-9aee-2925f1d7fac3\', \'multiverseId\': 480851}, \'multiverseid\': 480851}, {\'name\': \'용맹한 구조자\', \'text\': \'당신이 매 턴 처음으로 다른 카드를 순환할 때마다, 1/1 백색 인간 병사 생물 토큰 한 개를 만든다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'생물 — 인간 병사\', \'flavor\': \'부유 도시 창공돛에는 두 가지 규칙이 있다: 선원을 버리고 가지 않을 것, 그리고 가드레일로 장난치지 말 것.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481110&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f5cafebf-701b-4b5d-9efd-5aa0a68752dc\', \'multiverseId\': 481110}, \'multiverseid\': 481110}, {\'name\': \'Socorrista Valente\', \'text\': \'Toda vez que você reciclar outro card pela primeira vez a cada turno, crie uma ficha de criatura branca 1/1 do tipo Humano Soldado.\\nReciclar {2} ({2}, descarte este card: Compre um card.)\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': \'A cidade flutuante de Vela Celeste tem duas regras: não deixe seus companheiros de tripulação para trás e não se meta com a amurada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481369&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1c412d1f-90f1-4d4e-8bd5-a41c5e40b48b\', \'multiverseId\': 481369}, \'multiverseid\': 481369}, {\'name\': \'Доблестный Спаситель\', \'text\': \'Каждый раз, когда вы совершаете Цикл другой карты в первый раз в каждом ходу, создайте одну фишку существа 1/1 белый Человек Солдат.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'В летающем городе Небесный Парус есть два правила: не бросать товарищей по команде и не трогать без нужды перила.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481628&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'33d1d585-7173-4bdb-9b46-9562fa2ae750\', \'multiverseId\': 481628}, \'multiverseid\': 481628}, {\'name\': \'英勇救援兵\', \'text\': \'每当你每回合首度循环另一张牌时，派出一个1/1白色人类／士兵衍生生物。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'生物 ～人类／士兵\', \'flavor\': \'翔空城有两条规矩：不抛弃同伴，不乱动护栏。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481887&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1a11616c-3cd5-480f-9f31-64403407c34c\', \'multiverseId\': 481887}, \'multiverseid\': 481887}, {\'name\': \'英勇救援兵\', \'text\': \'每當你每回合首度循環另一張牌時，派出一個1/1白色人類／士兵衍生生物。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'生物 ～人類／士兵\', \'flavor\': \'翔空城有兩條規矩：不拋棄同伴，不亂動護欄。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482146&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e1edf5b9-0172-498b-b538-4ace0fd506f8\', \'multiverseId\': 482146}, \'multiverseid\': 482146}]', '[{\'name\': \'Tatzenspur-Krater\', \'text\': \'Verzaubert ein Land\\nDas verzauberte Land hat „{T}: Eine Kreatur deiner Wahl erhält Eile und verursacht Trampelschaden bis zum Ende des Zuges."\\nUmwandlung {1} ({1}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479897&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ace29af3-56c5-4be8-9c2e-81eab60fa6ee\', \'multiverseId\': 479897}, \'multiverseid\': 479897}, {\'name\': \'Cráter de pisotón\', \'text\': \'Encantar tierra.\\nLa tierra encantada tiene "{T}: La criatura objetivo gana las habilidades de arrollar y prisa hasta el final del turno".\\nCiclo {1}. ({1}, descartar esta carta: Roba una carta.)\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480156&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5e07b655-c7bc-48a5-85d9-5c1bea65e8c6\', \'multiverseId\': 480156}, \'multiverseid\': 480156}, {\'name\': "Cratère de l\'Empreinte", \'text\': "Enchanter : terrain\\nLe terrain enchanté a « {T} : La créature ciblée acquiert le piétinement et la célérité jusqu\'à la fin du tour. »\\nRecyclage {1} ({1}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480415&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'937ad22f-4107-480d-8ea6-3c6ef06ce245\', \'multiverseId\': 480415}, \'multiverseid\': 480415}, {\'name\': \'Cratere di Grandepasso\', \'text\': \'Incanta terra\\nLa terra incantata ha "{T}: Una creatura bersaglio ha travolgere e rapidità fino alla fine del turno".\\nCiclo {1} ({1}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480674&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c4f204e7-d0f8-478a-90c2-2e3f18856f4c\', \'multiverseId\': 480674}, \'multiverseid\': 480674}, {\'name\': \'踏み穴のクレーター\', \'text\': \'エンチャント（土地）\\nエンチャントしている土地は「{T}：クリーチャー１体を対象とする。ターン終了時まで、それはトランプルと速攻を得る。」を持つ。\\nサイクリング{1}（{1}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480933&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ad61f453-9710-4a32-85fd-fc1cff6d80a0\', \'multiverseId\': 480933}, \'multiverseid\': 480933}, {\'name\': \'발자국 분화구\', \'text\': \'대지에 부여\\n부여된 대지는 "{T}: 생물을 목표로 정한다. 그 생물은 턴종료까지 돌진 및 신속을 얻는다."를 가진다.\\n순환 {1} ({1}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'부여마법 — 마법진\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481192&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'40dd2373-ca8a-42c2-beca-f0beba7c8f64\', \'multiverseId\': 481192}, \'multiverseid\': 481192}, {\'name\': \'Cratera da Pegada\', \'text\': \'Encantar terreno\\nO terreno encantado tem "{T}: A criatura alvo ganha atropelar e ímpeto até o final do turno."\\nReciclar {1} ({1}, descarte este card: Compre um card.)\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481451&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'691ee824-3227-4d75-81e2-1d94be7aa9c1\', \'multiverseId\': 481451}, \'multiverseid\': 481451}, {\'name\': \'Следовой Кратер\', \'text\': \'Зачаровать землю\\nЗачарованная земля имеет способность «{T}: целевое существо получает Пробивной удар и Ускорение до конца хода».\\nЦикл {1} ({1}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481710&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1095a10c-7f5a-461c-9ee7-5420d68fede2\', \'multiverseId\': 481710}, \'multiverseid\': 481710}, {\'name\': \'足印成坑\', \'text\': \'结附于地\\n所结附的地具有「{T}：目标生物获得践踏与敏捷异能直到回合结束。」\\n循环{1}（{1}，弃掉此牌：抓一张牌。）\', \'type\': \'结界 ～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481969&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'885210ad-2604-41f8-a6fe-037b9218fcda\', \'multiverseId\': 481969}, \'multiverseid\': 481969}, {\'name\': \'足印成坑\', \'text\': \'結附於地\\n所結附的地具有「{T}：目標生物獲得踐踏與敏捷異能直到回合結束。」\\n循環{1}（{1}，棄掉此牌：抽一張牌。）\', \'type\': \'結界 ～靈氣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482228&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9abce7b9-e337-418a-bbdf-fe2bdecc1619\', \'multiverseId\': 482228}, \'multiverseid\': 482228}]', '[{\'name\': \'Titanenhorst\', \'text\': \'Schaue dir zu Beginn deines Versorgungssegments die oberste Karte deiner Bibliothek an. Du kannst sie auf deinen Friedhof legen.\\nSchicke eine Karte aus deinem Friedhof ins Exil: Erzeuge {C}. Verwende dieses Mana nur, um einen farbigen Zauberspruch zu wirken, der kein {X} in seinen Manakosten hat.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479991&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9a91464e-83c5-4a9d-bad8-54bcacab3679\', \'multiverseId\': 479991}, \'multiverseid\': 479991}, {\'name\': \'Nido de titanes\', \'text\': \'Al comienzo de tu mantenimiento, mira la primera carta de tu biblioteca. Puedes poner esa carta en tu cementerio.\\nExiliar una carta de tu cementerio: Agrega {C}. Usa este maná solo para lanzar un hechizo de color sin {X} en su coste de maná.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480250&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'29323ab6-4b15-441a-ba85-acb6a4d71cce\', \'multiverseId\': 480250}, \'multiverseid\': 480250}, {\'name\': \'Nid de titans\', \'text\': \'Au début de votre entretien, regardez la carte du dessus de votre bibliothèque. Vous pouvez mettre cette carte dans votre cimetière.\\nExilez une carte de votre cimetière : Ajoutez {C}. Ne dépensez ce mana que pour lancer un sort de couleur sans {X} dans son coût de mana.\', \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480509&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b2c69214-004f-4e36-8f65-bec4ca41e534\', \'multiverseId\': 480509}, \'multiverseid\': 480509}, {\'name\': \'Nido dei Titani\', \'text\': "All\'inizio del tuo mantenimento, guarda la prima carta del tuo grimorio. Puoi metterla nel tuo cimitero.\\nEsilia una carta dal tuo cimitero: Aggiungi {C}. Spendi questo mana solo per lanciare una magia colorata senza {X} nel suo costo di mana.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480768&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d68569cf-93fd-486e-b177-d4a08ee95a8a\', \'multiverseId\': 480768}, \'multiverseid\': 480768}, {\'name\': \'巨獣の巣\', \'text\': \'あなたのアップキープの開始時に、あなたのライブラリーの一番上のカードを見る。あなたはそのカードをあなたの墓地に置いてもよい。\\nあなたの墓地からカード１枚を追放する：{C}を加える。このマナは、マナ・コストに{X}を含まない有色の呪文を唱えるためにのみ使用できる。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481027&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a1c37694-d545-4e2e-8928-c5fd4f3ec28e\', \'multiverseId\': 481027}, \'multiverseid\': 481027}, {\'name\': \'거신의 둥지\', \'text\': \'당신의 유지단 시작에, 당신의 서고 맨 위 카드를 본다. 당신은 그 카드를 당신의 무덤에 넣을 수 있다.\\n당신의 무덤에서 카드 한 장을 추방한다: {C}를 추가한다. 이 마나는 마나 비용에 {X}가 없는 유색 주문을 발동하는 데에만 사용할 수 있다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481286&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9e6d9fad-ea6a-4bfb-89b6-99d15108b97d\', \'multiverseId\': 481286}, \'multiverseid\': 481286}, {\'name\': \'Ninho do Titã\', \'text\': \'No início de sua manutenção, olhe o card do topo de seu grimório. Você pode colocar aquele card em seu cemitério.\\nExile um card de seu cemitério: Adicione {C}. Gaste esse mana somente para conjurar uma mágica colorida sem {X} no custo de mana.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481545&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a53d30c3-187d-43d3-a40b-93432ea075ab\', \'multiverseId\': 481545}, \'multiverseid\': 481545}, {\'name\': \'Гнездовье Титанов\', \'text\': \'В начале вашего шага поддержки посмотрите верхнюю карту вашей библиотеки. Вы можете положить ту карту на ваше кладбище.\\nИзгоните карту из вашего кладбища: добавьте {C}. Тратьте эту ману только на разыгрывание цветного заклинания без {X} в его мана-стоимости.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481804&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6c0909b3-c1ea-48e7-a600-36540441352e\', \'multiverseId\': 481804}, \'multiverseid\': 481804}, {\'name\': \'巨物巢穴\', \'text\': \'在你的维持开始时，检视你的牌库顶牌。你可以将该牌置入你的坟墓场。\\n从你的坟墓场放逐一张牌：加{C}。此法术力只能用来施放法术力费用中不包含{X}的有色咒语。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482063&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e93d5d6d-33c0-4511-9d46-a16a371f8a9a\', \'multiverseId\': 482063}, \'multiverseid\': 482063}, {\'name\': \'巨物巢穴\', \'text\': \'在你的維持開始時，檢視你的牌庫頂牌。你可以將該牌置入你的墳墓場。\\n從你的墳墓場放逐一張牌：加{C}。此魔法力只能用來施放魔法力費用中不包含{X}的有色咒語。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482322&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0755da23-3935-41ae-bda3-3cb1b403e164\', \'multiverseId\': 482322}, \'multiverseid\': 482322}]', "[{'name': 'Titanosaurus Rex', 'text': 'Verursacht Trampelschaden\\nUmwandlung {1}{G} ({1}{G}, wirf diese Karte ab: Ziehe eine Karte.)\\nWenn du den Titanosaurus Rex umwandelst, lege eine Trampelschaden-Marke auf eine Kreatur deiner Wahl, die du kontrollierst.', 'type': 'Kreatur — Dinosaurier, Bestie', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479953&type=card', 'language': 'German', 'identifiers': {'scryfallId': '98eaf1da-8f2b-47c3-a73c-f005acd6494f', 'multiverseId': 479953}, 'multiverseid': 479953}, {'name': 'Titanorrex', 'text': 'Arrolla.\\nCiclo {1}{G}. ({1}{G}, descartar esta carta: Roba una carta.)\\nCuando actives la habilidad de ciclo del Titanorrex, pon un contador de arrollar sobre la criatura objetivo que controlas.', 'type': 'Criatura — Bestia dinosaurio', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480212&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '04d4159b-effc-41da-8113-91f722bf44e6', 'multiverseId': 480212}, 'multiverseid': 480212}, {'name': 'Titanoth rex', 'text': 'Piétinement\\nRecyclage {1}{G} ({1}{G}, défaussez-vous de cette carte : Piochez une carte.)\\nQuand vous recyclez le Titanoth rex, mettez un marqueur « piétinement » sur une créature ciblée que vous contrôlez.', 'type': 'Créature : dinosaure et bête', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480471&type=card', 'language': 'French', 'identifiers': {'scryfallId': '6cc1fe93-a798-457b-863f-2f57de470814', 'multiverseId': 480471}, 'multiverseid': 480471}, {'name': 'Titanos Rex', 'text': 'Travolgere\\nCiclo {1}{G} ({1}{G}, Scarta questa carta: Pesca una carta.)\\nQuando cicli il Titanos Rex, metti un segnalino travolgere su una creatura bersaglio che controlli.', 'type': 'Creatura — Bestia Dinosauro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480730&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '11045b0d-7c64-4243-89b0-3a4a2f2cbbb4', 'multiverseId': 480730}, 'multiverseid': 480730}, {'name': 'タイタノス・レックス', 'text': 'トランプル\\nサイクリング{1}{G}（{1}{G}, このカードを捨てる：カードを１枚引く。）\\nあなたがタイタノス・レックスをサイクリングしたとき、あなたがコントロールしているクリーチャー１体を対象とし、それの上にトランプル・カウンターを１個置く。', 'type': 'クリーチャー — 恐竜・ビースト', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480989&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '5b8da884-8e58-4e2f-99e7-1f777cba5d55', 'multiverseId': 480989}, 'multiverseid': 480989}, {'name': '티타노스 렉스', 'text': '돌진\\n순환 {1}{G} ({1}{G}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\\n당신이 티타노스 렉스를 순환할 때, 당신이 조종하는 생물을 목표로 정한다. 그 생물에 돌진 카운터를 올려놓는다.', 'type': '생물 — 공룡 야수', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481248&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'd0a5f1cc-298a-4e68-b7e3-d679c6b18afc', 'multiverseId': 481248}, 'multiverseid': 481248}, {'name': 'Titanote Rex', 'text': 'Atropelar\\nReciclar {1}{G} ({1}{G}, descarte este card: Compre um card.)\\nQuando reciclar Titanote Rex, coloque um marcador de atropelar na criatura alvo que você controla.', 'type': 'Criatura — Dinossauro Besta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481507&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c9cb2378-efdb-4692-9a2c-64df0f667f5a', 'multiverseId': 481507}, 'multiverseid': 481507}, {'name': 'Титанот Рекс', 'text': 'Пробивной удар\\nЦикл {1}{G} ({1}{G}, сбросьте эту карту: возьмите карту.)\\nКогда вы совершаете Цикл Титанота Рекса, положите один жетон Пробивного удара на целевое существо под вашим контролем.', 'type': 'Существо — Динозавр Зверь', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481766&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'faf4d108-4b23-4ac1-a68f-9fb7884c523c', 'multiverseId': 481766}, 'multiverseid': 481766}, {'name': '霸巨龙', 'text': '践踏\\n循环{1}{G}（{1}{G}，弃掉此牌：抓一张牌。）\\n当你循环霸巨龙时，在目标由你操控的生物上放置一个践踏指示物。', 'type': '生物 ～恐龙／野兽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482025&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '0523d217-77c2-41ea-93c0-ae37de6fd4a1', 'multiverseId': 482025}, 'multiverseid': 482025}, {'name': '霸巨龍', 'text': '踐踏\\n循環{1}{G}（{1}{G}，棄掉此牌：抽一張牌。）\\n當你循環霸巨龍時，在目標由你操控的生物上放置一個踐踏指示物。', 'type': '生物 ～恐龍／野獸', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482284&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '3bbb51cc-7896-4719-96ce-e3e5cc0c94d4', 'multiverseId': 482284}, 'multiverseid': 482284}]", "[{'name': 'Titanosaurus Rex', 'text': 'Verursacht Trampelschaden\\nUmwandlung {1}{G}\\nWenn du den Titanosaurus Rex umwandelst, lege eine Trampelschaden-Marke auf eine Kreatur deiner Wahl, die du kontrollierst.', 'type': 'Kreatur — Dinosaurier, Bestie', 'flavor': 'Godzilla, urtümlicher Champion', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482390&type=card', 'language': 'German', 'identifiers': {'scryfallId': '7bae32c2-107f-4ec6-bf74-90e87a481815', 'multiverseId': 482390}, 'multiverseid': 482390}, {'name': 'Titanorrex', 'text': 'Arrolla.\\nCiclo {1}{G}.\\nCuando actives la habilidad de ciclo del Titanorrex, pon un contador de arrollar sobre la criatura objetivo que controlas.', 'type': 'Criatura — Bestia dinosaurio', 'flavor': 'Godzilla, campeón primigenio', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482404&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '16146274-a1b9-4ae0-ae75-09f7daed9fed', 'multiverseId': 482404}, 'multiverseid': 482404}, {'name': 'Titanoth rex', 'text': 'Piétinement\\nRecyclage {1}{G}\\nQuand vous recyclez le Titanoth rex, mettez un marqueur « piétinement » sur une créature ciblée que vous contrôlez.', 'type': 'Créature : dinosaure et bête', 'flavor': 'Godzilla, champion primitif', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482418&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b5ca01c8-a741-488f-b29f-09ffe2c95656', 'multiverseId': 482418}, 'multiverseid': 482418}, {'name': 'Titanos Rex', 'text': 'Travolgere\\nCiclo {1}{G}\\nQuando cicli il Titanos Rex, metti un segnalino travolgere su una creatura bersaglio che controlli.', 'type': 'Creatura — Bestia Dinosauro', 'flavor': 'Godzilla, Campione Primordiale', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482432&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '8c3b4c37-6713-4227-adae-586b79932aac', 'multiverseId': 482432}, 'multiverseid': 482432}, {'name': 'タイタノス・レックス', 'text': 'トランプル\\nサイクリング{1}{G}\\nあなたがタイタノス・レックスをサイクリングしたとき、あなたがコントロールしているクリーチャー１体を対象とし、それの上にトランプル・カウンターを１個置く。', 'type': 'クリーチャー — 恐竜・ビースト', 'flavor': '原（げん）始（し）の王（おう）者（じゃ）、ゴジラ', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482446&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '471f6243-fff8-4763-a021-d625e91b49d4', 'multiverseId': 482446}, 'multiverseid': 482446}, {'name': '티타노스 렉스', 'text': '돌진\\n순환 {1}{G}\\n당신이 티타노스 렉스를 순환할 때, 당신이 조종하는 생물을 목표로 정한다. 그 생물에 돌진 카운터를 올려놓는다.', 'type': '생물 — 공룡 야수', 'flavor': '태초의 승리자, 고질라', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482460&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'c379304c-45db-4c1f-9738-7396328d678c', 'multiverseId': 482460}, 'multiverseid': 482460}, {'name': 'Titanote Rex', 'text': 'Atropelar\\nReciclar {1}{G}\\nQuando reciclar Titanote Rex, coloque um marcador de atropelar na criatura alvo que você controla.', 'type': 'Criatura — Dinossauro Besta', 'flavor': 'Godzilla, Campeão Primordial', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482474&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8d81137f-a23b-4738-acbe-0220f0952677', 'multiverseId': 482474}, 'multiverseid': 482474}, {'name': 'Титанот Рекс', 'text': 'Пробивной удар\\nЦикл {1}{G}\\nКогда вы совершаете Цикл Титанота Рекса, положите один жетон Пробивного удара на целевое существо под вашим контролем.', 'type': 'Существо — Динозавр Зверь', 'flavor': 'Годзилла, Первобытный Воитель', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482488&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '983608d1-f2ad-4818-b1d0-0416fe0352d4', 'multiverseId': 482488}, 'multiverseid': 482488}, {'name': '霸巨龙', 'text': '践踏\\n循环{1}{G}\\n当你循环霸巨龙时，在目标由你操控的生物上放置一个践踏指示物。', 'type': '生物 ～恐龙／野兽', 'flavor': '太古斗兽哥斯拉', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482502&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '0b6c41b5-797e-4435-bbff-32b68f1e072f', 'multiverseId': 482502}, 'multiverseid': 482502}, {'name': '霸巨龍', 'text': '踐踏\\n循環{1}{G}\\n當你循環霸巨龍時，在目標由你操控的生物上放置一個踐踏指示物。', 'type': '生物 ～恐龍／野獸', 'flavor': '太古鬥獸哥吉拉', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482516&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '569f7396-98c1-4899-9beb-d02a31b3ae4f', 'multiverseId': 482516}, 'multiverseid': 482516}]", '[{\'name\': \'Tobsüchtiger Raptor\', \'type\': \'Kreatur — Dinosaurier\', \'flavor\': \'„Auch wenn den Weg durch Raugrin Alarmkristalle säumen, scheinen sich einige Monster anzupassen. Wir hatten Raptoren, die Angriffe auf Versorgungskarawanen vortäuschten, während andere versuchten, durch den Lavavorhang zu schlüpfen."\\n—Dol, Lavagrund-Quartiermeister\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479899&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1d0dcf7e-bbc8-4874-8851-61552e639a0a\', \'multiverseId\': 479899}, \'multiverseid\': 479899}, {\'name\': \'Ráptor enloquecido\', \'type\': \'Criatura — Dinosaurio\', \'flavor\': \'"Aunque la carretera de Raugrin está flanqueada por cristales de alarma, algunos monstruos parecen estar adaptándose. Hubo ráptores que fingieron ataques a caravanas de provisiones, mientras que otros trataban de cruzar a hurtadillas la cortina de lava".\\n—Dol, intendente de Bordelava\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480158&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'81af65c4-a032-42c9-8ebe-93100a7d3d18\', \'multiverseId\': 480158}, \'multiverseid\': 480158}, {\'name\': \'Raptor hystérique\', \'type\': \'Créature : dinosaure\', \'flavor\': "« La route qui traverse Raugrin a beau être jonchée de cristaux d\'avertissement, certains monstres semblent s\'adapter. Des raptors ont simulé des attaques sur des caravanes de provisions pendant que d\'autres ont essayé de traverser le rideau de lave. »\\n—Dol, quartier-maître de Bourg-sur-Lave", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480417&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1134cb51-0e59-4022-9c1a-99f5f3a06263\', \'multiverseId\': 480417}, \'multiverseid\': 480417}, {\'name\': \'Raptor Frenetico\', \'type\': \'Creatura — Dinosauro\', \'flavor\': \'"La strada che attraversa Raugrin è costellata di cristalli d\\\'allarme, ma vari mostri sembrano essersi adattati. Alcuni raptor hanno simulato attacchi a carovane di provviste, mentre altri tentavano di oltrepassare la barriera di lava."\\n—Dol, quartiermastro di Lavariva\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480676&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'135a4b9b-799f-48f5-8fb8-274adceaa68f\', \'multiverseId\': 480676}, \'multiverseid\': 480676}, {\'name\': \'激情の猛竜\', \'type\': \'クリーチャー — 恐竜\', \'flavor\': \'「ラウグリンを抜ける道には警報水晶が並んでいるが、一部の怪物はこれに順応しているようだ。一部の猛竜が補給隊に攻撃するふりをしている間に、他の猛竜が溶岩幕をくぐり抜けようとしたという報告がある。」\\n――ラバブリンクの補給士官、ダール\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480935&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'85191dc4-d8be-4f03-8a43-3a6da62b8418\', \'multiverseId\': 480935}, \'multiverseid\': 480935}, {\'name\': \'광분한 랩터\', \'type\': \'생물 — 공룡\', \'flavor\': \'"라우그린까지 연결되어 있는 길에는 경보 수정들이 줄지어 서 있지만, 몇몇 괴수들이 적응하고 있는 것처럼 보인다. 보급 상단을 공격하는 것처럼 가장하면서, 다른 녀석들이 용암 장막 사이로 숨어들려고 한 랩터들이 있었지."\\n—용암가장자리 병참 장교, 달\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481194&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'06ea8411-872f-4f05-a294-abf552c33992\', \'multiverseId\': 481194}, \'multiverseid\': 481194}, {\'name\': \'Raptor Frenético\', \'type\': \'Criatura — Dinossauro\', \'flavor\': \'"Embora a estrada que atravessa Raugrin esteja repleta de cristais de alarme, alguns monstros parecem estar se adaptando. Já vimos raptores fingindo atacar caravanas de provisões enquanto outros tentam se esgueirar pela cortina de lava."\\n— Dol, intendente de Beiralava\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481453&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4c7156db-8c9b-4d04-b062-06dcefdd15c4\', \'multiverseId\': 481453}, \'multiverseid\': 481453}, {\'name\': \'Разъяренный Раптор\', \'type\': \'Существо — Динозавр\', \'flavor\': \'«По обочине дороги через Раугрин стоят кристаллы, предупреждающие об опасности, но некоторые чудовища, кажется, начинают приспосабливаться. Рассказывают о рапторах, которые делают вид, будто нападают на караваны с провизией, пока другие пытаются пробраться через лавовую завесу».\\n— Дол, интендант из Лавобрега\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481712&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9cc959f3-f5dd-42da-95d7-7d57e01e8c72\', \'multiverseId\': 481712}, \'multiverseid\': 481712}, {\'name\': \'狂乱迅猛龙\', \'type\': \'生物 ～恐龙\', \'flavor\': \'「虽然洛格凌道路两侧都设有预警水晶，但有些怪兽似乎已找出适应之法。之前就有过一批迅猛龙佯攻粮车，掩护另一批怪兽穿越熔岩屏障的事情。」\\n～熔缘城军需官达尔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481971&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5f4c63dd-d9cc-4be5-8dc2-25a7bf7844b2\', \'multiverseId\': 481971}, \'multiverseid\': 481971}, {\'name\': \'狂亂迅猛龍\', \'type\': \'生物 ～恐龍\', \'flavor\': \'「雖然洛格凌道路兩側都設有預警水晶，但有些怪獸似乎已找出適應之法。之前就有過一批迅猛龍佯攻糧車，掩護另一批怪獸穿越熔岩屏障的事情。」\\n～熔緣城軍需官達爾\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482230&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8c4a1054-2dc5-4339-9c49-42326f48a019\', \'multiverseId\': 482230}, \'multiverseid\': 482230}]', '[{\'name\': \'Totes Gewicht\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur erhält -2/-2.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Du bist nicht meine Beute, Kleiner. Ich bin hinter dem her, was durch dein Geschrei angelockt wird."\\n—Kelsien der Verseuchte\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479862&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bde5d416-78d1-4dcd-9af7-33a70717169a\', \'multiverseId\': 479862}, \'multiverseid\': 479862}, {\'name\': \'Peso muerto\', \'text\': \'Encantar criatura.\\nLa criatura encantada obtiene -2/-2.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"Tú no eres mi presa, pequeño. Mi objetivo es cualquier cosa que venga a investigar tus gritos".\\n—Kelsien, la Plaga\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480121&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2ac5f3a8-ed8a-4567-8f7b-f068de8ad4c9\', \'multiverseId\': 480121}, \'multiverseid\': 480121}, {\'name\': \'Poids mort\', \'text\': \'Enchanter : créature\\nLa créature enchantée gagne -2/-2.\', \'type\': \'Enchantement : aura\', \'flavor\': "« Tu n\'es pas ma proie, mon petit. Je m\'intéresse à ce que tes cris vont attirer. »\\n—Kelsien, la Peste", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480380&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'26eff5a9-df3e-4b6a-bf74-2a4177b6a1cf\', \'multiverseId\': 480380}, \'multiverseid\': 480380}, {\'name\': \'Peso Morto\', \'text\': \'Incanta creatura\\nLa creatura incantata prende -2/-2.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Non sei tu la mia preda, piccolo. Sono a caccia di qualsiasi cosa venga attirata dai tuoi lamenti."\\n—Kelsien, la Piaga\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480639&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c71802e8-6e82-427d-8b10-d78f86ca13d7\', \'multiverseId\': 480639}, \'multiverseid\': 480639}, {\'name\': \'死の重み\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントしているクリーチャーは－２/－２の修整を受ける。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「おちびさん、お前は俺の獲物じゃない。俺が狙っているのはお前の鳴き声を聞いてやってくる奴だ。」\\n――疫病をもたらす者、ケルシン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480898&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'20bb4919-2b2e-45ad-b7c7-83ff0853e64b\', \'multiverseId\': 480898}, \'multiverseid\': 480898}, {\'name\': \'사악한 족쇄\', \'text\': \'생물에게 부여\\n부여된 생물은 -2/-2를 받는다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'"넌 내 사냥감이 아니다, 작은 녀석아. 난 네 울음소리를 듣고 살펴보러 오는 녀석을 노리는 거야."\\n—역병, 켈시엔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481157&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'601fdd49-f95b-4410-b341-de933b8b7b6e\', \'multiverseId\': 481157}, \'multiverseid\': 481157}, {\'name\': \'Peso Morto\', \'text\': \'Encantar criatura\\nA criatura encantada recebe -2/-2.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Meu problema não é contigo, pequeno. Eu estou atrás é do que quer que venha investigar os seus gritos."\\n— Kelsien, a Peste\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481416&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ed29ca89-952e-4a64-8407-fc324c8fbd52\', \'multiverseId\': 481416}, \'multiverseid\': 481416}, {\'name\': \'Мертвый Груз\', \'text\': \'Зачаровать существо\\nЗачарованное существо получает -2/-2.\', \'type\': \'Чары — Аура\', \'flavor\': \'«Ты мне не нужен, малыш. Я охочусь на того, кто придет посмотреть, кто тут так жалобно кричит».\\n— Келсиен, Моровая Погибель\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481675&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fb2eb7de-4318-43f6-bc4b-813047d22bc5\', \'multiverseId\': 481675}, \'multiverseid\': 481675}, {\'name\': \'重负\', \'text\': \'结附于生物\\n所结附的生物得-2/-2。\', \'type\': \'结界 ～灵气\', \'flavor\': \'「你不是我的猎物，小家伙。我要抓的是闻声赶来的那东西。」\\n～疫病凯鑫\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481934&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6b294d9d-104e-463f-97ca-b0597661e022\', \'multiverseId\': 481934}, \'multiverseid\': 481934}, {\'name\': \'重負\', \'text\': \'結附於生物\\n所結附的生物得-2/-2。\', \'type\': \'結界 ～靈氣\', \'flavor\': \'「你不是我的獵物，小傢伙。我要逮的是聞聲趕來的那東西。」\\n～疫病凱鑫\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482193&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d6e78520-20a5-499c-974e-54c3537bc04c\', \'multiverseId\': 482193}, \'multiverseid\': 482193}]', '[{\'name\': \'Traumschweif-Reiher\', \'text\': \'Mutation {3}{U} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\nFliegend\\nImmer wenn diese Kreatur mutiert, ziehe eine Karte.\', \'type\': \'Kreatur — Elementarwesen, Vogel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479826&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ec4813fe-7a2f-4466-b537-f3642f43bac0\', \'multiverseId\': 479826}, \'multiverseid\': 479826}, {\'name\': \'Garza colamística\', \'text\': \'Mutación {3}{U}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\nVuela.\\nSiempre que esta criatura mute, roba una carta.\', \'type\': \'Criatura — Ave elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480085&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6f7d844f-1012-4870-b7e1-875e72e0efce\', \'multiverseId\': 480085}, \'multiverseid\': 480085}, {\'name\': \'Héron à queue de rêve\', \'text\': "Mutation {3}{U} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\nVol\\nÀ chaque fois que cette créature subit une mutation, piochez une carte.", \'type\': \'Créature : élémental et oiseau\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480344&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6762230c-2b2a-4906-b4ae-6d21a40ac2df\', \'multiverseId\': 480344}, \'multiverseid\': 480344}, {\'name\': \'Airone dalla Coda Onirica\', \'text\': \'Mutazione {3}{U} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\nVolare\\nOgniqualvolta questa creatura muta, pesca una carta.\', \'type\': \'Creatura — Uccello Elementale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480603&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f15ab1dd-2a1f-44e2-ba78-7de19d47135a\', \'multiverseId\': 480603}, \'multiverseid\': 480603}, {\'name\': \'夢尾の鷺\', \'text\': \'変容{3}{U}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\n飛行\\nこのクリーチャーが変容するたび、カードを１枚引く。\', \'type\': \'クリーチャー — エレメンタル・鳥\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480862&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f17a85dc-70a6-4c6c-8b49-610de2133ede\', \'multiverseId\': 480862}, \'multiverseid\': 480862}, {\'name\': \'꿈꼬리 왜가리\', \'text\': \'돌연변이화 {3}{U} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n비행\\n이 생물이 돌연변이화할 때마다, 카드 한 장을 뽑는다.\', \'type\': \'생물 — 정령 조류\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481121&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'43ad9b7a-c08b-4ee5-becb-4a07c543d096\', \'multiverseId\': 481121}, \'multiverseid\': 481121}, {\'name\': \'Garça-de-cauda-onírica\', \'text\': \'Mutação {3}{U} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\nVoar\\nToda vez que esta criatura sofrer mutação, compre um card.\', \'type\': \'Criatura — Elemental Ave\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481380&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ce831c17-463d-447d-bf62-5fdb85019d10\', \'multiverseId\': 481380}, \'multiverseid\': 481380}, {\'name\': \'Снохвостая Цапля\', \'text\': \'Мутация {3}{U} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\nПолет\\nКаждый раз, когда это существо мутирует, возьмите карту.\', \'type\': \'Существо — Элементаль Птица\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481639&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9cf7363f-2604-4aef-a72d-d51a73e8e5b2\', \'multiverseId\': 481639}, \'multiverseid\': 481639}, {\'name\': \'梦翎苍鹭\', \'text\': \'合变{3}{U}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n飞行\\n每当此生物合变时，抓一张牌。\', \'type\': \'生物 ～元素／鸟\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481898&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4a192b79-548a-4ec0-9120-a90a01db96c0\', \'multiverseId\': 481898}, \'multiverseid\': 481898}, {\'name\': \'夢翎蒼鷺\', \'text\': \'合變{3}{U}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n飛行\\n每當此生物合變時，抽一張牌。\', \'type\': \'生物 ～元素／鳥\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482157&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e7475975-20bc-499a-add1-6115f9fb422b\', \'multiverseId\': 482157}, \'multiverseid\': 482157}]', '[{\'name\': \'Tristes Gewässer\', \'text\': \'Das Triste Gewässer kommt getappt ins Spiel.\\nWenn das Triste Gewässer ins Spiel kommt, erhältst du 1 Lebenspunkt dazu.\\n{T}: Erzeuge {U} oder {B}.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480025&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d210bcd3-f682-492f-b618-e82c76544f4d\', \'multiverseId\': 480025}, \'multiverseid\': 480025}, {\'name\': \'Laguna lúgubre\', \'text\': \'La Laguna lúgubre entra al campo de batalla girada.\\nCuando la Laguna lúgubre entre al campo de batalla, ganas 1 vida.\\n{T}: Agrega {U} o {B}.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480284&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'25d4a635-cbb3-436c-ba5e-1bcf149eaec1\', \'multiverseId\': 480284}, \'multiverseid\': 480284}, {\'name\': \'Marigot lugubre\', \'text\': \'Le Marigot lugubre arrive sur le champ de bataille engagé.\\nQuand le Marigot lugubre arrive sur le champ de bataille, vous gagnez 1 point de vie.\\n{T} : Ajoutez {U} ou {B}.\', \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480543&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'32b25994-f75a-4226-852b-96a29e8e7cd5\', \'multiverseId\': 480543}, \'multiverseid\': 480543}, {\'name\': \'Acquitrino Tetro\', \'text\': "L\'Acquitrino Tetro entra nel campo di battaglia TAPpato.\\nQuando l\'Acquitrino Tetro entra nel campo di battaglia, guadagni 1 punto vita.\\n{T}: Aggiungi {U} o {B}.", \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480802&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'04fac332-9f65-40cc-8ce0-c9a0a007ceee\', \'multiverseId\': 480802}, \'multiverseid\': 480802}, {\'name\': \'陰鬱な僻地\', \'text\': \'陰鬱な僻地はタップ状態で戦場に出る。\\n陰鬱な僻地が戦場に出たとき、あなたは１点のライフを得る。\\n{T}：{U}か{B}を加える。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481061&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'926335ec-2943-45a7-896f-d4c9892e1008\', \'multiverseId\': 481061}, \'multiverseid\': 481061}, {\'name\': \'음침한 소류\', \'text\': \'음침한 소류는 탭된 채로 전장에 들어온다.\\n음침한 소류가 전장에 들어올 때, 당신은 생명 1점을 얻는다.\\n{T}: {U} 또는 {B}를 추가한다.\', \'type\': \'대지\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481320&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a39250f0-359c-4af9-9e12-3df935e9804d\', \'multiverseId\': 481320}, \'multiverseid\': 481320}, {\'name\': \'Remanso Funesto\', \'text\': \'Remanso Funesto entra no campo de batalha virado.\\nQuando Remanso Funesto entra no campo de batalha, você ganha 1 ponto de vida.\\n{T}: Adicione {U} ou {B}.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481579&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c16ad86d-d354-44be-82a7-181ffe061f8f\', \'multiverseId\': 481579}, \'multiverseid\': 481579}, {\'name\': \'Мрачная Заводь\', \'text\': \'Мрачная Заводь выходит на поле битвы повернутой.\\nКогда Мрачная Заводь выходит на поле битвы, вы получаете 1 жизнь.\\n{T}: добавьте {U} или {B}.\', \'type\': \'Земля\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481838&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bc888e5f-ddcb-4381-94f9-64ffc8a1210b\', \'multiverseId\': 481838}, \'multiverseid\': 481838}, {\'name\': \'阴沉死水\', \'text\': \'阴沉死水须横置进战场。\\n当阴沉死水进战场时，你获得1点生命。\\n{T}：加{U}或{B}。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482097&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1abdea92-8aeb-4789-9099-cb2f0f491841\', \'multiverseId\': 482097}, \'multiverseid\': 482097}, {\'name\': \'陰沉死水\', \'text\': \'陰沉死水須橫置進戰場。\\n當陰沉死水進戰場時，你獲得1點生命。\\n{T}：加{U}或{B}。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482356&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d0f7ce59-96aa-4aee-9e7b-a6b2faa511f5\', \'multiverseId\': 482356}, \'multiverseid\': 482356}]', '[{\'name\': \'Trompetender Gnarr\', \'text\': \'Mutation {3}{G/U}{G/U} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\nImmer wenn diese Kreatur mutiert, erzeuge einen 3/3 grünen Bestie-Kreaturenspielstein.\', \'type\': \'Kreatur — Bestie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479992&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e0efca40-9db6-4339-b41e-a14263bd412d\', \'multiverseId\': 479992}, \'multiverseid\': 479992}, {\'name\': \'Gnarr berreante\', \'text\': \'Mutación {3}{G/U}{G/U}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\nSiempre que esta criatura mute, crea una ficha de criatura Bestia verde 3/3.\', \'type\': \'Criatura — Bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480251&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b7368afc-72d7-4ae9-9402-6033256f6285\', \'multiverseId\': 480251}, \'multiverseid\': 480251}, {\'name\': \'Gnarr barrissant\', \'text\': "Mutation {3}{G/U}{G/U} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\nÀ chaque fois que cette créature subit une mutation, créez un jeton de créature 3/3 verte Bête.", \'type\': \'Créature : bête\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480510&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'82efe8ed-a230-426f-b4be-7a5888dbc9a7\', \'multiverseId\': 480510}, \'multiverseid\': 480510}, {\'name\': \'Gnarr Muggente\', \'text\': \'Mutazione {3}{G/U}{G/U} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\nOgniqualvolta questa creatura muta, crea una pedina creatura Bestia 3/3 verde.\', \'type\': \'Creatura — Bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480769&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ccc83a3b-59b2-4ca0-8f65-1ab4f1d6bd7d\', \'multiverseId\': 480769}, \'multiverseid\': 480769}, {\'name\': \'嘶くナール\', \'text\': \'変容{3}{G/U}{G/U}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\nこのクリーチャーが変容するたび、緑の３/３のビースト・クリーチャー・トークンを１体生成する。\', \'type\': \'クリーチャー — ビースト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481028&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fb856fb8-b22f-4827-a5de-818c220f1a15\', \'multiverseId\': 481028}, \'multiverseid\': 481028}, {\'name\': \'울부짖는 나르\', \'text\': \'돌연변이화 {3}{G/U} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n이 생물이 돌연변이화할 때마다, 3/3 녹색 야수 생물 토큰 한 개를 만든다.\', \'type\': \'생물 — 야수\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481287&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'04f6e9d6-a438-46b2-9b98-f79304dfb7c8\', \'multiverseId\': 481287}, \'multiverseid\': 481287}, {\'name\': \'Gnarr Berrador\', \'text\': \'Mutação {3}{G/U}{G/U} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\nToda vez que esta criatura sofrer mutação, crie uma ficha de criatura verde 3/3 do tipo Besta.\', \'type\': \'Criatura — Besta\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481546&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'132cfab0-f7bf-4eef-b136-af14c8f2febd\', \'multiverseId\': 481546}, \'multiverseid\': 481546}, {\'name\': \'Трубящий Гнарр\', \'text\': \'Мутация {3}{G/U}{G/U} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\nКаждый раз, когда это существо мутирует, создайте одну фишку существа 3/3 зеленый Зверь.\', \'type\': \'Существо — Зверь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481805&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'24ddd634-ac68-48e0-b134-309ce1255f48\', \'multiverseId\': 481805}, \'multiverseid\': 481805}, {\'name\': \'长吼嚎龙\', \'text\': \'合变{3}{G/U}{G/U}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n每当此生物合变时，派出一个3/3绿色野兽衍生生物。\', \'type\': \'生物 ～野兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482064&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8a1f3075-f083-44c3-a813-ae348147f536\', \'multiverseId\': 482064}, \'multiverseid\': 482064}, {\'name\': \'長吼嚎龍\', \'text\': \'合變{3}{G/U}{G/U}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n每當此生物合變時，派出一個3/3綠色野獸衍生生物。\', \'type\': \'生物 ～野獸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482323&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'afce2e83-ffc5-46c4-aa7c-d8c582e93ed7\', \'multiverseId\': 482323}, \'multiverseid\': 482323}]', '[{\'name\': \'Umori der Sammler\', \'text\': \'Gefährte — Alle Nichtland-Karten in deinem Startdeck haben einen Kartentyp gemeinsam. (Falls du diese Karte als deinen Gefährten erwählt hast, kannst du sie einmal von außerhalb der Partie wirken.)\\nSowie Umori der Sammler ins Spiel kommt, bestimme einen Kartentyp.\\nZaubersprüche des bestimmten Typs, die du wirkst, kosten beim Wirken {1} weniger.\', \'type\': \'Legendäre Kreatur — Schlammwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480010&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bfbf8bc6-3dc1-4503-9556-c2f3c398eeff\', \'multiverseId\': 480010}, \'multiverseid\': 480010}, {\'name\': \'Umori, Coleccionista\', \'text\': \'Compañero — Cada carta que no sea tierra en tu mazo inicial comparte un tipo de carta. (Si esta carta es el compañero que eliges, puedes lanzarla una vez desde fuera del juego.)\\nEn cuanto Umori, Coleccionista entre al campo de batalla, elige un tipo de carta.\\nTe cuesta {1} menos lanzar hechizos del tipo elegido.\', \'type\': \'Criatura legendaria — Cieno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480269&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6e1ca6c2-4cc8-400a-a2a0-c2c87dd9aff7\', \'multiverseId\': 480269}, \'multiverseid\': 480269}, {\'name\': \'Umori, le collecteur\', \'text\': "Compagnon — Chaque carte non-terrain dans votre deck de départ partage un type de carte. (Si cette carte est le compagnon de votre choix, vous pouvez la lancer une fois depuis l\'extérieur de la partie.)\\nAu moment où Umori, le collecteur arrive sur le champ de bataille, choisissez un type de carte.\\nLes sorts du type choisi que vous lancez coûtent {1} de moins à lancer.", \'type\': \'Créature légendaire : limon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480528&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4ccf9351-b246-4246-8121-da6c59428ab7\', \'multiverseId\': 480528}, \'multiverseid\': 480528}, {\'name\': \'Umorye, il Collezionista\', \'text\': \'Compagno — Ogni carta non terra nel tuo mazzo iniziale condivide un tipo di carta. (Se questa carta è il compagno che hai scelto, puoi lanciarla una volta dal di fuori della partita.)\\nMentre Umorye, il Collezionista entra nel campo di battaglia, scegli un tipo di carta.\\nLe magie che lanci del tipo scelto costano {1} in meno per essere lanciate.\', \'type\': \'Creatura Leggendaria — Melma\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480787&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'77277596-aa54-4971-8ca0-28c87aebb5d1\', \'multiverseId\': 480787}, \'multiverseid\': 480787}, {\'name\': \'集めるもの、ウモーリ\', \'text\': \'相棒 ― あなたの開始時のデッキに入っていて土地でない各カードが、すべて共通のカード・タイプを持っていること。（このカードがあなたの選んだ相棒であるなら、あなたは１回のみゲームの外部からこれを唱えてもよい。）\\n集めるもの、ウモーリが戦場に出るに際し、カード・タイプ１つを選ぶ。\\nあなたがその選ばれたタイプの呪文を唱えるためのコストは{1}少なくなる。\', \'type\': \'伝説のクリーチャー — ウーズ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481046&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f16bae65-81ce-410a-b6d0-08a545da3594\', \'multiverseId\': 481046}, \'multiverseid\': 481046}, {\'name\': \'수집가, 우모리\', \'text\': \'단짝 — 당신의 시작 덱에 들어 있는 대지가 아닌 각 카드는 서로 카드 유형을 공유한다. (이 카드가 당신이 선택한 단짝이라면, 당신은 이 카드를 게임 밖에서 한 번 발동할 수 있다.)\\n수집가, 우모리가 전장에 들어오면서, 카드 유형 한 가지를 선택한다.\\n당신이 발동하는 선택된 유형의 주문은 발동하는 데 {1}이 덜 든다.\', \'type\': \'전설적 생물 — 점액괴물\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481305&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'043058c7-2f85-4e5a-8367-d2553cd21508\', \'multiverseId\': 481305}, \'multiverseid\': 481305}, {\'name\': \'Umori, o Coletor\', \'text\': \'Companheiro — Cada card em seu deck inicial que não seja um terreno compartilha um tipo de card. (Se este card for o companheiro que escolheu, você poderá conjurá-lo uma vez de fora do jogo.)\\nConforme Umori, o Coletor, entrar no campo de batalha, escolha um tipo de card.\\nAs mágicas que você conjura do tipo escolhido custam {1} a menos para serem conjuradas.\', \'type\': \'Criatura Lendária — Lodo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481564&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8232edf5-fd69-4772-8553-f8a2b1c13235\', \'multiverseId\': 481564}, \'multiverseid\': 481564}, {\'name\': \'Умори, Собиратель\', \'text\': \'Компаньон — У всех не являющихся землями карт в вашей начальной колоде есть одинаковый тип карты. (Если эта карта является вашим избранным Компаньоном, то вы можете один раз разыграть ее из-за пределов игры.)\\nПри выходе Умори, Собирателя на поле битвы выберите тип карты.\\nРазыгрываемые вами заклинания выбранного типа стоят на {1} меньше.\', \'type\': \'Легендарное Существо — Тина\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481823&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bfb191ee-aa61-4fe2-aa8a-571d7b79df91\', \'multiverseId\': 481823}, \'multiverseid\': 481823}, {\'name\': \'集晶流浆乌墨理\', \'text\': \'行侣～你起始套牌中各非地牌之间均具有共通的牌张类别。（如果你选择这张牌作为你的行侣，则你可以从游戏外施放它，但仅限一次。）\\n于集晶流浆乌墨理进战场时，选择一种牌张类别。\\n你施放的该类别咒语减少{1}来施放。\', \'type\': \'传奇生物 ～流浆\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482082&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'293e4f20-57b0-4265-8b0f-04c6434b6eab\', \'multiverseId\': 482082}, \'multiverseid\': 482082}, {\'name\': \'集晶流漿烏墨理\', \'text\': \'行侶～你起始套牌中各非地牌之間均具有共通的牌張類別。（如果你選擇這張牌作為你的行侶，則你可以從遊戲外施放它，但僅限一次。）\\n於集晶流漿烏墨理進戰場時，選擇一種牌張類別。\\n你施放的該類別咒語減少{1}來施放。\', \'type\': \'傳奇生物 ～流漿\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482341&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4602626d-f232-47c2-af88-bb769b6fab3a\', \'multiverseId\': 482341}, \'multiverseid\': 482341}]', '[{\'name\': \'Unberechenbarer Zyklon\', \'text\': \'Falls eine Umwandlung-Fähigkeit einer anderen Nichtland-Karte bewirken würde, dass du eine Karte ziehst, schicke stattdessen Karten oben von deiner Bibliothek ins Exil, bis du eine Karte ins Exil schickst, die einen Kartentyp mit der umgewandelten Karte gemeinsam hat. Du kannst die Karte wirken, ohne ihre Manakosten zu bezahlen. Lege dann alle Karten, die auf diese Weise ins Exil geschickt und nicht gewirkt wurden, in zufälliger Reihenfolge unter deine Bibliothek.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479918&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'48ed4d85-4307-4728-b3da-957087712ec5\', \'multiverseId\': 479918}, \'multiverseid\': 479918}, {\'name\': \'Ciclón impredecible\', \'text\': \'Si una habilidad de ciclo de otra carta que no sea tierra te haría robar una carta, en vez de eso, exilia cartas de la parte superior de tu biblioteca hasta que exilies una carta que comparta un tipo de carta con la carta con la habilidad de ciclo. Puedes lanzar esa carta sin pagar su coste de maná. Luego, pon las cartas exiliadas que no fueron lanzadas de esta manera en el fondo de tu biblioteca en un orden aleatorio.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480177&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9823991e-40e4-4bf7-9470-a78154e21601\', \'multiverseId\': 480177}, \'multiverseid\': 480177}, {\'name\': \'Cyclone imprévisible\', \'text\': "Si la capacité de recyclage d\'une autre carte non-terrain devait vous faire piocher une carte, à la place, exilez les cartes du dessus de votre bibliothèque jusqu\'à ce que vous exiliez une carte qui partage un type de carte avec la carte recyclée. Vous pouvez lancer cette carte sans payer son coût de mana. Mettez ensuite les cartes exilées qui n\'ont pas été lancées de cette manière au-dessous de votre bibliothèque, dans un ordre aléatoire.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480436&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3946fac7-eabd-4a4d-8a36-8137144785ad\', \'multiverseId\': 480436}, \'multiverseid\': 480436}, {\'name\': \'Ciclone Imprevedibile\', \'text\': "Se un\'abilità ciclo di un\'altra carta non terra sta per farti pescare una carta, esilia invece carte dalla cima del tuo grimorio finché non esili una carta che condivide un tipo di carta con la carta ciclata. Puoi lanciare quella carta senza pagare il suo costo di mana. Poi metti in fondo al tuo grimorio in ordine casuale le carte esiliate che non sono state lanciate in questo modo.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480695&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c517c930-7d88-4420-819d-51b4a564b561\', \'multiverseId\': 480695}, \'multiverseid\': 480695}, {\'name\': \'予測不能な竜巻\', \'text\': \'他の、土地でないカードのサイクリング能力によってあなたがカードを１枚引くなら、代わりに、そのサイクリングしたカードと共通のカード・タイプを持つカードが追放されるまで、あなたのライブラリーの一番上からカードを１枚ずつ追放する。あなたはそのカードをそのマナ・コストを支払うことなく唱えてもよい。その後、これにより追放して唱えなかったカードをあなたのライブラリーの一番下に無作為の順番で置く。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480954&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1c709c1a-524e-4dfb-97d2-63e281964af1\', \'multiverseId\': 480954}, \'multiverseid\': 480954}, {\'name\': \'예측할 수 없는 회오리\', \'text\': \'대지가 아닌 다른 카드의 순환 능력으로 당신이 카드를 뽑으려고 하면, 대신 순환된 카드와 카드 유형을 공유하는 카드가 추방될 때까지 당신의 서고 맨 위 카드를 추방한다. 당신은 마나 비용을 지불하지 않고 그 카드를 발동할 수 있다. 그 후 이렇게 추방되고 발동되지 않은 카드들을 당신의 서고 맨 밑에 무작위로 넣는다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481213&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'240a79f3-b9a9-492c-9d3f-3e5833248c8e\', \'multiverseId\': 481213}, \'multiverseid\': 481213}, {\'name\': \'Ciclone Imprevisível\', \'text\': \'Se uma habilidade reciclar de outro card que não seja um terreno fizer com que você compre um card, em vez disso, exile cards do topo de seu grimório até exilar um card que compartilhe um tipo com o card reciclado. Você pode conjurar aquele card sem pagar seu custo de mana. Depois, coloque os cards exilados que não foram conjurados desta forma no fundo de seu grimório em ordem aleatória.\\nReciclar {2} ({2}, descarte este card: Compre um card.)\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481472&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'250659cd-0d34-4983-909f-dce0a2fb5113\', \'multiverseId\': 481472}, \'multiverseid\': 481472}, {\'name\': \'Непредсказуемый Циклон\', \'text\': \'Если способность Цикла другой не являющейся землей карты должна заставить вас взять карту, вместо этого изгоняйте карты с верха вашей библиотеки до тех пор, пока вы не изгоните карту, у которой есть такой же тип карты, как у той, для которой совершен Цикл. Вы можете разыграть ту карту без уплаты ее мана-стоимости. Затем положите изгнанные карты, не разыгранные таким образом, в низ вашей библиотеки в случайном порядке.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481731&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8cc73ffd-ff5c-47a0-8638-af7fe7cc8e0c\', \'multiverseId\': 481731}, \'multiverseid\': 481731}, {\'name\': \'难测气旋\', \'text\': \'如果另一张非地牌之任一循环异能将令你抓一张牌，则改为从你的牌库顶开始放逐牌，直到放逐一张与所循环者具共通牌张类别的牌为止。你可以施放该牌，且不需支付其法术力费用。然后将所有以此法放逐且未施放的牌以随机顺序置于你的牌库底。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481990&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'512e2389-4bc9-45c9-84f8-2347b2c9c3fc\', \'multiverseId\': 481990}, \'multiverseid\': 481990}, {\'name\': \'難測氣旋\', \'text\': \'如果另一張非地牌之任一循環異能將令你抽一張牌，則改為從你的牌庫頂開始放逐牌，直到放逐一張與所循環者具共通牌張類別的牌為止。你可以施放該牌，且不需支付其魔法力費用。然後將所有以此法放逐且未施放的牌以隨機順序置於你的牌庫底。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482249&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'72787a21-0323-47f2-827a-d6e5bc42e472\', \'multiverseId\': 482249}, \'multiverseid\': 482249}]', '[{\'name\': \'Unbändiger Wolfsbär\', \'text\': \'Immer wenn der Unbändige Wolfsbär angreift, kannst du bis zum Ende des Zuges die Basis-Stärke und -Widerstandskraft eines Menschen deiner Wahl, den du kontrollierst, zur Stärke und Widerstandskraft des Unbändigen Wolfsbären ändern.\', \'type\': \'Kreatur — Wolf, Bär\', \'flavor\': \'Manchmal ist *Eludha* eine heilige Harmonie der Seelen. Manchmal greift der Bynder etwas Fell und hält sich daran fest.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479930&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8f555253-76eb-4ded-8136-6b60f78482f2\', \'multiverseId\': 479930}, \'multiverseid\': 479930}, {\'name\': \'Loboso vehemente\', \'text\': \'Siempre que el Loboso vehemente ataque, puedes cambiar la fuerza y la resistencia base del Humano objetivo que controlas por la fuerza y la resistencia del Loboso vehemente hasta el final del turno.\', \'type\': \'Criatura — Lobo oso\', \'flavor\': \'Algunas veces, la *eludha* es una armonía sagrada de almas. Otras, el vinculador se agarra muy fuerte al pelaje.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480189&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a4fed330-9a93-4c02-b4ec-f77f62065c01\', \'multiverseId\': 480189}, \'multiverseid\': 480189}, {\'name\': \'Lupours exubérant\', \'text\': "À chaque fois que le Lupours exubérant attaque, vous pouvez remplacer la force et l\'endurance de base d\'un humain ciblé que vous contrôlez par la force et l\'endurance du Lupours exubérant jusqu\'à la fin du tour.", \'type\': \'Créature : loup et ours\', \'flavor\': "Parfois, l\'*éludha* est une harmonie sacrée entre deux âmes. Mais parfois, le brideur se contente d\'attraper un peu de fourrure et de s\'y accrocher fermement.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480448&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d9d26e93-f867-4d12-b842-9dd06ef1f82e\', \'multiverseId\': 480448}, \'multiverseid\': 480448}, {\'name\': \'Luporso Esuberante\', \'text\': \'Ogniqualvolta il Luporso Esuberante attacca, puoi cambiare la forza e la costituzione base di un Umano bersaglio che controlli nella forza e costituzione del Luporso Esuberante fino alla fine del turno.\', \'type\': \'Creatura — Orso Lupo\', \'flavor\': "A volte, l\'*eludha* è una sacra armonia di anime. Altre volte, il vincolatore afferra una pelliccia e si regge forte.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480707&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'46c7eac5-1d82-45db-966c-33f5fdadbe16\', \'multiverseId\': 480707}, \'multiverseid\': 480707}, {\'name\': \'溌剌とした狼熊\', \'text\': \'溌剌とした狼熊が攻撃するたび、あなたがコントロールしている人間１体を対象とする。あなたは「ターン終了時まで、それの基本のパワーとタフネスを、溌剌とした狼熊のパワーとタフネスに変更する。」を選んでもよい。\', \'type\': \'クリーチャー — 狼・熊\', \'flavor\': \'*エルーダ*とは、ときに魂の聖なる調和である。眷者とは、ときに毛皮にしがみつく者である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480966&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5cfdac01-f0c1-4d7e-8b78-21f5810516d7\', \'multiverseId\': 480966}, \'multiverseid\': 480966}, {\'name\': \'활기 넘치는 늑대곰\', \'text\': \'활기 넘치는 늑대곰이 공격할 때마다, 당신이 조종하는 인간을 목표로 정한다. 당신은 턴종료까지 그 인간의 기본 공격력 및 방어력을 활기 넘치는 늑대곰의 공격력 및 방어력으로 변경할 수 있다.\', \'type\': \'생물 — 늑대 곰\', \'flavor\': \'때로는 *엘루다*가 영혼들의 신성한 조화를 의미한다. 때로는 유대자가 털가죽을 붙잡고 놓치지 않게 꼭 쥐어야 한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481225&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'78b4de7d-abb6-4eed-9e0e-8e2acc9f4a31\', \'multiverseId\': 481225}, \'multiverseid\': 481225}, {\'name\': \'Loburso Exuberante\', \'text\': \'Toda vez que Loburso Exuberante ataca, você pode permutar o poder e a resistência básicos do Humano alvo que você controla com os de Loburso Exuberante até o final do turno.\', \'type\': \'Criatura — Lobo Urso\', \'flavor\': \'Às vezes, a *eludha* é uma harmonia sagrada entre almas. Às vezes, o vinculador só se agarra firme no pelo e vai.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481484&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fdc7f9e6-b5b8-4248-9b75-f34640a552ed\', \'multiverseId\': 481484}, \'multiverseid\': 481484}, {\'name\': \'Неудержимый Медведеволк\', \'text\': \'Каждый раз, когда Неудержимый Медведеволк атакует, вы можете обменять значения базовой силы и выносливости целевого Человека под вашим контролем на силу и выносливость Неудержимого Медведеволка до конца хода.\', \'type\': \'Существо — Волк Медведь\', \'flavor\': \'Иногда *элудха* — это священная гармония душ. А иногда узомант просто хватается за шкуру и старается не свалиться.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481743&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8fb40586-2bb1-473a-9713-a6dd61c855f7\', \'multiverseId\': 481743}, \'multiverseid\': 481743}, {\'name\': \'亢奋狼熊\', \'text\': \'每当亢奋狼熊攻击时，你可以将目标由你操控之人类生物的基础力量与防御力更改为亢奋狼熊的力量与防御力直到回合结束。\', \'type\': \'生物 ～狼／熊\', \'flavor\': \'有些时候，*灵绊*是靠心灵之间神圣共鸣来维系。而有些时候，则是靠持绊人抓紧坐稳来维持。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482002&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'908f2cef-390d-4f3f-8f3e-25127d826014\', \'multiverseId\': 482002}, \'multiverseid\': 482002}, {\'name\': \'亢奮狼熊\', \'text\': \'每當亢奮狼熊攻擊時，你可以將目標由你操控之人類生物的基礎力量與防禦力更改為亢奮狼熊的力量與防禦力直到回合結束。\', \'type\': \'生物 ～狼／熊\', \'flavor\': \'有些時候，*靈絆*是靠心靈之間神聖共鳴來維繫。而有些時候，則是靠持絆人抓緊坐穩來維持。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482261&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e2fa9065-2d54-406f-a0cc-5f36509172ab\', \'multiverseId\': 482261}, \'multiverseid\': 482261}]', '[{\'name\': \'Unersättlicher Blutfresser\', \'text\': \'Mutation {2}{B} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\nTodesberührung\\nImmer wenn diese Kreatur mutiert, verliert jeder Gegner X Lebenspunkte und du erhältst X Lebenspunkte dazu, wobei X gleich der Anzahl an Mutationen dieser Kreatur ist.\', \'type\': \'Kreatur — Nachtmahr\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479872&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6df1b039-271e-4019-a6e6-59337699249d\', \'multiverseId\': 479872}, \'multiverseid\': 479872}, {\'name\': \'Hematófago insaciable\', \'text\': \'Mutación {2}{B}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\nToque mortal.\\nSiempre que esta criatura mute, cada oponente pierde X vidas y tú ganas X vidas, donde X es la cantidad de veces que esta criatura ha mutado.\', \'type\': \'Criatura — Pesadilla\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480131&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1907a745-4576-44b3-b0c5-03383c75777e\', \'multiverseId\': 480131}, \'multiverseid\': 480131}, {\'name\': \'Hémophage insatiable\', \'text\': "Mutation {2}{B} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\nContact mortel\\nÀ chaque fois que cette créature subit une mutation, chaque adversaire perd X points de vie et vous gagnez X points de vie, X étant le nombre de mutations subies par cette créature.", \'type\': \'Créature : cauchemar\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480390&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'78260fa2-9f15-4c7a-8337-2a2de77dc4a0\', \'multiverseId\': 480390}, \'multiverseid\': 480390}, {\'name\': \'Emofago Insaziabile\', \'text\': \'Mutazione {2}{B} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\nTocco letale\\nOgniqualvolta questa creatura muta, ogni avversario perde X punti vita e tu guadagni X punti vita, dove X è il numero di volte che questa creatura è mutata.\', \'type\': \'Creatura — Incubo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480649&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d6bb7997-0d14-4a56-90a0-b60260669917\', \'multiverseId\': 480649}, \'multiverseid\': 480649}, {\'name\': \'強欲な血喰い\', \'text\': \'変容{2}{B}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\n接死\\nこのクリーチャーが変容するたび、各対戦相手はそれぞれＸ点のライフを失い、あなたはＸ点のライフを得る。Ｘはこのクリーチャーが変容した総回数に等しい。\', \'type\': \'クリーチャー — ナイトメア\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480908&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'388362ef-bb47-4fc6-ba1d-ac6af2a95263\', \'multiverseId\': 480908}, \'multiverseid\': 480908}, {\'name\': \'탐욕스러운 식혈귀\', \'text\': \'돌연변이화 {2}{B} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n치명타\\n이 생물이 돌연변이화할 때마다, 각 상대는 생명 X점을 잃고 당신은 생명 X점을 얻는다. X는 이 생물이 돌연변이화한 수이다.\', \'type\': \'생물 — 나이트메어\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481167&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5ed0ae84-7bd4-4a88-a894-f3e9c82bb821\', \'multiverseId\': 481167}, \'multiverseid\': 481167}, {\'name\': \'Hemófago Insaciável\', \'text\': \'Mutação {2}{B} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\nToque mortífero\\nToda vez que esta criatura sofre mutação, cada oponente perde X pontos de vida e você ganha X pontos de vida, sendo X o número de mutações desta criatura.\', \'type\': \'Criatura — Pesadelo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481426&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ae094690-e434-4501-9372-03fb3ef2345b\', \'multiverseId\': 481426}, \'multiverseid\': 481426}, {\'name\': \'Ненасытный Гемофаг\', \'text\': \'Мутация {2}{B} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\nСмертельное касание\\nКаждый раз, когда это существо мутирует, каждый оппонент теряет X жизней, а вы получаете X жизней, где X — число мутаций этого существа.\', \'type\': \'Существо — Кошмар\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481685&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c8bc0e56-efbf-401b-9c05-7489b60eb002\', \'multiverseId\': 481685}, \'multiverseid\': 481685}, {\'name\': \'无魇喋血怪\', \'text\': \'合变{2}{B}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n死触\\n每当此生物合变时，每位对手各失去X点生命，且你获得X点生命，X为此生物已合变的次数。\', \'type\': \'生物 ～梦魇\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481944&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b39d1e78-a1f0-439c-b44a-a0e01439518f\', \'multiverseId\': 481944}, \'multiverseid\': 481944}, {\'name\': \'無魘喋血怪\', \'text\': \'合變{2}{B}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n死觸\\n每當此生物合變時，每位對手各失去X點生命，且你獲得X點生命，X為此生物已合變的次數。\', \'type\': \'生物 ～夢魘\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482203&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'174d4a3a-1555-4991-80ac-eb1d65547cf0\', \'multiverseId\': 482203}, \'multiverseid\': 482203}]', '[{\'name\': \'Unerwartete Unterstützung\', \'text\': \'Eine Kreatur deiner Wahl erhält +2/+0 und Unzerstörbarkeit bis zum Ende des Zuges. (Schaden und Effekte, die „zerstören", zerstören sie nicht.)\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ich weiß ja zu schätzen, dass du mich nicht in den ätzenden Sumpf hast fallen lassen. Aber kannst du mich jetzt herunterlassen?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479882&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5f33d131-77aa-4fbb-8626-b89ddee571d5\', \'multiverseId\': 479882}, \'multiverseid\': 479882}, {\'name\': \'Ayuda insólita\', \'text\': \'La criatura objetivo obtiene +2/+0 y gana la habilidad de indestructible hasta el final del turno. (El daño y los efectos que dicen "destruir" no la destruyen.)\', \'type\': \'Instantáneo\', \'flavor\': \'"Agradezco que no me hayas dejado caer y morir en las ciénagas ácidas. Pero ¿podrías soltarme?".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480141&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bbe9d835-3edc-4e74-8e06-a5accdc78694\', \'multiverseId\': 480141}, \'multiverseid\': 480141}, {\'name\': \'Aide improbable\', \'text\': "La créature ciblée gagne +2/+0 et acquiert l\'indestructible jusqu\'à la fin du tour. (Les blessures et les effets qui disent « détruisez » ne la détruisent pas.)", \'type\': \'Éphémère\', \'flavor\': "« Merci de m\'avoir sauvée d\'une chute dans les marécages acides. Maintenant, je peux descendre ? »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480400&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e1c1a3be-6e77-4a4d-ae73-8a5558dd758c\', \'multiverseId\': 480400}, \'multiverseid\': 480400}, {\'name\': \'Aiuto Inatteso\', \'text\': \'Una creatura bersaglio prende +2/+0 e ha indistruttibile fino alla fine del turno. (Il danno e gli effetti che dicono "distruggi" non la distruggono.)\', \'type\': \'Istantaneo\', \'flavor\': \'"Apprezzo che tu non mi abbia lasciato cadere nelle paludi acide. Ora, però, potresti mettermi giù?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480659&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2d4c1398-61ac-40b3-aedb-c0fd432668b0\', \'multiverseId\': 480659}, \'multiverseid\': 480659}, {\'name\': \'予期せぬ助力\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋２/＋０の修整を受け破壊不能を得る。（ダメージや「破壊」と書かれた効果では、それは破壊されない。）\', \'type\': \'インスタント\', \'flavor\': \'「毒の沼に落ちて死ぬところを助けてくれてありがとう。でも、そろそろ降ろしてくれる？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480918&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cbbc9842-3b2e-4c8e-8613-7fb7f1ee0af7\', \'multiverseId\': 480918}, \'multiverseid\': 480918}, {\'name\': \'있을 법하지 않은 지원\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 +2/+0을 받고 무적을 얻는다. (피해와 "파괴"라고 명시된 효과로 파괴되지 않는다.)\', \'type\': \'순간마법\', \'flavor\': \'"저 산성 늪지에 빠져서 죽지 않게 해 준 건 고마워. 이제 좀 내려 줄 수 있겠니?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481177&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5a27dc33-5db3-4e3c-bddb-76efdd3b69f0\', \'multiverseId\': 481177}, \'multiverseid\': 481177}, {\'name\': \'Ajuda Improvável\', \'text\': \'A criatura alvo recebe +2/+0 e ganha indestrutível até o final do turno. (O dano e os efeitos que dizem "destrua" não a destroem.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Agradeço por você não ter me deixado cair para morrer nos brejos ácidos. Agora, você pode me colocar no chão?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481436&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'caadc3da-e9fc-4643-8325-5788acfad08e\', \'multiverseId\': 481436}, \'multiverseid\': 481436}, {\'name\': \'Неожиданная Помощь\', \'text\': \'Целевое существо получает +2/+0 и Неразрушимость до конца хода. (Повреждения и эффекты с указанием «уничтожьте» не уничтожают его.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Благодарю, что не дал мне упасть в смертоносное кислотное болото. А теперь не мог бы ты меня опустить?»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481695&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0f3cc2d4-6df9-449f-9650-3e0a4e8f14ef\', \'multiverseId\': 481695}, \'multiverseid\': 481695}, {\'name\': \'意外援助\', \'text\': \'直到回合结束，目标生物得+2/+0且获得不灭异能。（伤害与注明「消灭」的效应不会将它消灭。）\', \'type\': \'瞬间\', \'flavor\': \'「非常感谢你救了我，没让我落入酸沼丧命。那现在能把我放下来了吗？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481954&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ffff9a29-22a5-4968-af92-b28773f49654\', \'multiverseId\': 481954}, \'multiverseid\': 481954}, {\'name\': \'意外援助\', \'text\': \'直到回合結束，目標生物得+2/+0且獲得不滅異能。（傷害與註明「消滅」的效應不會將它消滅。）\', \'type\': \'瞬間\', \'flavor\': \'「非常感謝你救了我，沒讓我落入酸沼喪命。那現在能把我放下來了嗎？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482213&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'22c9b623-019b-449f-af90-f03bf94e61f2\', \'multiverseId\': 482213}, \'multiverseid\': 482213}]', "[{'name': 'Unheilvolle See', 'text': 'Immer wenn du eine Karte ziehst, lege eine Vorahnungsmarke auf die Unheilvolle See.\\nEntferne acht Vorahnungsmarken von der Unheilvollen See: Erzeuge einen 8/8 blauen Krake-Kreaturenspielstein.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)', 'type': 'Verzauberung', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479840&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2a7b577b-f837-4eea-8961-43ba6dc908dd', 'multiverseId': 479840}, 'multiverseid': 479840}, {'name': 'Mares de mal agüero', 'text': 'Siempre que robes una carta, pon un contador de augurio sobre los Mares de mal agüero.\\nRemover ocho contadores de augurio de los Mares de mal agüero: Crea una ficha de criatura Kraken azul 8/8.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)', 'type': 'Encantamiento', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480099&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ca5bcad7-c9c5-417e-8511-7b2bb394f0c0', 'multiverseId': 480099}, 'multiverseid': 480099}, {'name': 'Mers comminatoires', 'text': 'À chaque fois que vous piochez une carte, mettez un marqueur « présage » sur les Mers comminatoires.\\nRetirez huit marqueurs « présage » des Mers comminatoires : Créez un jeton de créature 8/8 bleue Kraken.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)', 'type': 'Enchantement', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480358&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c7994b6b-8012-4a2f-89f9-153336589ccd', 'multiverseId': 480358}, 'multiverseid': 480358}, {'name': 'Mari Minacciosi', 'text': 'Ogniqualvolta peschi una carta, metti un segnalino premonizione sui Mari Minacciosi.\\nRimuovi otto segnalini premonizione dai Mari Minacciosi: Crea una pedina creatura Kraken 8/8 blu.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)', 'type': 'Incantesimo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480617&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '5b42c9e0-8804-4f25-9aff-2bdfe2acb0f2', 'multiverseId': 480617}, 'multiverseid': 480617}, {'name': '不吉な海', 'text': 'あなたがカードを１枚引くたび、不吉な海の上に予兆カウンターを１個置く。\\n不吉な海の上から予兆カウンターを８個取り除く：青の８/８のクラーケン・クリーチャー・トークンを１体生成する。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）', 'type': 'エンチャント', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480876&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'aea2eed3-14ce-42f4-a2c2-aead5a255eff', 'multiverseId': 480876}, 'multiverseid': 480876}, {'name': '불길한 바다', 'text': '당신이 카드를 뽑을 때마다, 불길한 바다에 징조 카운터 한 개를 올려놓는다.\\n불길한 바다에서 징조 카운터 여덟 개를 제거한다: 8/8 청색 크라켄 생물 토큰 한 개를 만든다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)', 'type': '부여마법', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481135&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'e53e47fd-403f-4853-ac4c-e161e207c535', 'multiverseId': 481135}, 'multiverseid': 481135}, {'name': 'Mares Ameaçadores', 'text': 'Toda vez que você comprar um card, coloque um marcador de agouro em Mares Ameaçadores.\\nRemova oito marcadores de agouro de Mares Ameaçadores: Crie uma ficha de criatura azul 8/8 do tipo Kraken.\\nReciclar {2} ({2}, descarte este card: Compre um card.)', 'type': 'Encantamento', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481394&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '127ac49b-92e5-4631-b7e2-6af52c37c043', 'multiverseId': 481394}, 'multiverseid': 481394}, {'name': 'Тревожные Моря', 'text': 'Каждый раз, когда вы берете карту, положите один жетон предзнаменования на Тревожные Моря.\\nУдалите восемь жетонов предзнаменования с Тревожных Морей: создайте одну фишку существа 8/8 синий Кракен.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)', 'type': 'Чары', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481653&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'efe46862-9571-4b68-bd67-a947ca831789', 'multiverseId': 481653}, 'multiverseid': 481653}, {'name': '恶兆海疆', 'text': '每当你抓一张牌时，在恶兆海疆上放置一个预兆指示物。\\n从恶兆海疆上移去八个预兆指示物：派出一个8/8蓝色巨海兽衍生生物。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）', 'type': '结界', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481912&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '3dca0e66-8fb1-4286-95e5-dacbf70bf8c8', 'multiverseId': 481912}, 'multiverseid': 481912}, {'name': '惡兆海疆', 'text': '每當你抽一張牌時，在惡兆海疆上放置一個預兆指示物。\\n從惡兆海疆上移去八個預兆指示物：派出一個8/8藍色巨海獸衍生生物。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）', 'type': '結界', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482171&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'fb64cd0a-725e-49f3-adbd-ec29805000c9', 'multiverseId': 482171}, 'multiverseid': 482171}]", '[{\'name\': \'Unzertrennliche Verbindung\', \'text\': \'Bringe eine Kreaturenkarte deiner Wahl aus deinem Friedhof mit einer Lebensverknüpfung-Marke auf ihr ins Spiel zurück.\', \'type\': \'Hexerei\', \'flavor\': \'Ab jetzt und bis die Kristalle aufhören zu glühen.\\n—Eid aus Ketria mit der Bedeutung „für immer"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479880&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7b86d9f8-22d5-4efa-afa4-a4a601fd1e63\', \'multiverseId\': 479880}, \'multiverseid\': 479880}, {\'name\': \'Vínculo inquebrantable\', \'text\': \'Regresa la carta de criatura objetivo de tu cementerio al campo de batalla con un contador de vínculo vital sobre ella.\', \'type\': \'Conjuro\', \'flavor\': \'"Desde ahora hasta que los cristales dejen de brillar".\\n—Juramento de Ketria que significa "para siempre"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480139&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f9fb2228-101e-443c-8800-c6da03fd85af\', \'multiverseId\': 480139}, \'multiverseid\': 480139}, {\'name\': \'Lien indestructible\', \'text\': \'Renvoyez sur le champ de bataille une carte de créature ciblée depuis votre cimetière avec un marqueur « lien de vie » sur elle.\', \'type\': \'Rituel\', \'flavor\': "Jusqu\'à ce que la lueur du cristal s\'estompe\\n—Serment de Ketria signifiant « pour toujours »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480398&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'eb049951-964a-4e37-b2a8-49a6781fe31f\', \'multiverseId\': 480398}, \'multiverseid\': 480398}, {\'name\': \'Vincolo Indissolubile\', \'text\': \'Rimetti sul campo di battaglia una carta creatura bersaglio dal tuo cimitero con un segnalino legame vitale.\', \'type\': \'Stregoneria\', \'flavor\': \'Da adesso finché i cristalli smetteranno di brillare\\n—Giuramento di Ketria che significa "per sempre"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480657&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eadcbbdc-895f-4379-9168-959437bd954b\', \'multiverseId\': 480657}, \'multiverseid\': 480657}, {\'name\': \'不断の絆\', \'text\': \'あなたの墓地からクリーチャー・カード１枚を対象とし、それを絆魂カウンターが１個置かれた状態で戦場に戻す。\', \'type\': \'ソーサリー\', \'flavor\': \'水晶の輝きが消えるまで\\n――ケトリアの誓いの言い回しで「永遠に」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480916&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a91b6c7c-fdeb-4933-8fc7-129ec436bb3c\', \'multiverseId\': 480916}, \'multiverseid\': 480916}, {\'name\': \'깨뜨릴 수 없는 유대\', \'text\': \'당신의 무덤에 있는 생물 카드를 목표로 정한다. 그 카드에 생명연결 카운터를 올려놓고 전장으로 되돌린다.\', \'type\': \'집중마법\', \'flavor\': \'지금부터 수정들의 빛이 꺼질 때까지\\n—"영원"을 의미하는 케트리아의 서약\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481175&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9f18d526-fae9-4267-bfb8-9c9ac8f845be\', \'multiverseId\': 481175}, \'multiverseid\': 481175}, {\'name\': \'Vínculo Inquebrável\', \'text\': \'Devolva o card de criatura alvo de seu cemitério para o campo de batalha com um marcador de vínculo com a vida.\', \'type\': \'Feitiço\', \'flavor\': \'Até que os cristais deixem de brilhar.\\n— Expressão comum em juramentos em Ketria; significa "para sempre"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481434&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f36163c4-b3b3-41c7-aaed-a9e48cd064af\', \'multiverseId\': 481434}, \'multiverseid\': 481434}, {\'name\': \'Нерушимые Узы\', \'text\': \'Верните целевую карту существа из вашего кладбища на поле битвы с одним жетоном Цепи жизни на ней.\', \'type\': \'Волшебство\', \'flavor\': \'Отныне и до тех пор, пока не перестанут мерцать кристаллы.\\n— кетрийская клятва, которая означает «навсегда»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481693&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'26f5c592-f5a7-42c8-8328-58383a24d26c\', \'multiverseId\': 481693}, \'multiverseid\': 481693}, {\'name\': \'难破羁绊\', \'text\': \'将目标生物牌从你的坟墓场移回战场，且上面有一个系命指示物。\', \'type\': \'法术\', \'flavor\': \'从今开始，晶熄方休\\n～克崔亚誓言，意指「永远」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481952&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'75e0a9f3-8365-4987-aaa2-2a1817a3e418\', \'multiverseId\': 481952}, \'multiverseid\': 481952}, {\'name\': \'難破羈絆\', \'text\': \'將目標生物牌從你的墳墓場移回戰場，且上面有一個繫命指示物。\', \'type\': \'巫術\', \'flavor\': \'從今開始，晶熄方休\\n～克崔亞誓言，意指「永遠」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482211&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f2005ce9-0cd9-46fa-83b6-b71632e4256c\', \'multiverseId\': 482211}, \'multiverseid\': 482211}]', '[{\'name\': \'Urzeitliche Empathie\', \'text\': \'Zu Beginn deines Versorgungssegments ziehst du eine Karte, falls du eine Kreatur mit der höchsten Stärke unter den Kreaturen im Spiel kontrollierst. Lege sonst eine +1/+1-Marke auf eine Kreatur, die du kontrollierst.\', \'type\': \'Verzauberung\', \'flavor\': \'„Von diesem Tag an werden wir der Welt gemeinsam gegenübertreten, und uns gegenseitig aufbauen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479979&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d55d5e3d-75c5-460b-a3eb-52b1645ecb3d\', \'multiverseId\': 479979}, \'multiverseid\': 479979}, {\'name\': \'Empatía primigenia\', \'text\': \'Al comienzo de tu mantenimiento, roba una carta si controlas una criatura con la mayor fuerza entre las criaturas en el campo de batalla. De lo contrario, pon un contador +1/+1 sobre una criatura que controlas.\', \'type\': \'Encantamiento\', \'flavor\': \'"A partir de este día, nos enfrentamos juntos a este mundo, animándonos el uno al otro".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480238&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c00c4c98-c306-4166-8ef7-3cad935f9503\', \'multiverseId\': 480238}, \'multiverseid\': 480238}, {\'name\': \'Empathie primordiale\', \'text\': \'Au début de votre entretien, piochez une carte si vous contrôlez une créature qui a la force la plus élevée parmi les créatures sur le champ de bataille. Sinon, mettez un marqueur +1/+1 sur une créature que vous contrôlez.\', \'type\': \'Enchantement\', \'flavor\': "« À compter d\'aujourd\'hui, nous affronterons le monde ensemble, et nous serons solidaires. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480497&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2a89d13e-4998-4060-b447-ba85fb04f3b4\', \'multiverseId\': 480497}, \'multiverseid\': 480497}, {\'name\': \'Empatia Primordiale\', \'text\': "All\'inizio del tuo mantenimento, pesca una carta se controlli una creatura con la forza maggiore tra le creature sul campo di battaglia. Altrimenti, metti un segnalino +1/+1 su una creatura che controlli.", \'type\': \'Incantesimo\', \'flavor\': \'"Da oggi in poi, affronteremo questo mondo insieme, sollevandoci a vicenda."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480756&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a28d6206-c8a9-40ee-b4b6-e3a67bef4236\', \'multiverseId\': 480756}, \'multiverseid\': 480756}, {\'name\': \'原初の共感\', \'text\': \'あなたのアップキープの開始時に、あなたが戦場にあるクリーチャーの中で最大のパワーを持つクリーチャーをコントロールしているなら、カードを１枚引く。そうでないなら、あなたがコントロールしているクリーチャー１体の上に＋１/＋１カウンターを１個置く。\', \'type\': \'エンチャント\', \'flavor\': \'「今日この日から、私たちは共にこの世界に立ち向かう。お互いを高め合って。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481015&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6c782ce5-bed4-4614-8c44-644500b61baf\', \'multiverseId\': 481015}, \'multiverseid\': 481015}, {\'name\': \'태초의 공감\', \'text\': \'당신의 유지단 시작에, 당신이 전장에 있는 생물들 중 공격력이 제일 높은 생물을 조종한다면 카드 한 장을 뽑는다. 그렇지 않다면, 당신이 조종하는 생물 한 개에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'부여마법\', \'flavor\': \'"오늘부터, 우리는 함께 이 세계에 맞서며, 서로를 북돋는다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481274&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'aec33f3f-3e47-4b62-bad6-0a9661a0f38a\', \'multiverseId\': 481274}, \'multiverseid\': 481274}, {\'name\': \'Empatia Primal\', \'text\': \'No início de sua manutenção, compre um card se você controlar uma criatura com maior poder dentre as criaturas no campo de batalha. Caso contrário, coloque um marcador +1/+1 numa criatura que você controla.\', \'type\': \'Encantamento\', \'flavor\': \'"De hoje em diante, enfrentaremos esse mundo juntos, nos apoiando um ao outro."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481533&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'59fb5514-6b89-4f8b-b8d0-98bd3e40911f\', \'multiverseId\': 481533}, \'multiverseid\': 481533}, {\'name\': \'Первобытные Сопереживания\', \'text\': \'В начале вашего шага поддержки возьмите карту, если вы контролируете существо с наибольшей силой среди существ на поле битвы. В противном случае положите один жетон +1/+1 на существо под вашим контролем.\', \'type\': \'Чары\', \'flavor\': \'«С этого дня мы будем сражаться с этим миром вместе, поднимая друг друга».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481792&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'21fa860e-d452-4cca-906d-006f32080f82\', \'multiverseId\': 481792}, \'multiverseid\': 481792}, {\'name\': \'原初共感\', \'text\': \'在你的维持开始时，如果你操控力量为战场上生物中最大值的生物，则抓一张牌。若否，则在一个由你操控的生物上放置一个+1/+1指示物。\', \'type\': \'结界\', \'flavor\': \'「从今天开始，我们将共同面对这个世界，相互提升彼此。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482051&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3cd3b466-fdb0-4e3e-b1eb-d87ed0773252\', \'multiverseId\': 482051}, \'multiverseid\': 482051}, {\'name\': \'原初共感\', \'text\': \'在你的維持開始時，如果你操控力量為戰場上生物中最大值的生物，則抽一張牌。若否，則在一個由你操控的生物上放置一個+1/+1指示物。\', \'type\': \'結界\', \'flavor\': \'「從今天開始，我們將共同面對這個世界，相互提升彼此。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482310&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7e7a0fb7-4f7b-4949-8207-0557277a2df6\', \'multiverseId\': 482310}, \'multiverseid\': 482310}]', '[{\'name\': \'Vadrok, Apex des Donners\', \'text\': \'Mutation {1}{W/U}{R}{R} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\nFliegend, Erstschlag\\nImmer wenn diese Kreatur mutiert, kannst du eine Nichtkreatur-Karte deiner Wahl mit umgewandelten Manakosten von 3 oder weniger aus deinem Friedhof wirken, ohne ihre Manakosten zu bezahlen.\', \'type\': \'Legendäre Kreatur — Elementarwesen, Dinosaurier, Katze\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479993&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d0e0b136-5559-417f-b8c7-5788d71b6bd6\', \'multiverseId\': 479993}, \'multiverseid\': 479993}, {\'name\': \'Vadrok, Alfa del Trueno\', \'text\': \'Mutación {1}{W/U}{R}{R}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\nVuela, daña primero.\\nSiempre que esta criatura mute, puedes lanzar desde tu cementerio una carta que no sea de criatura objetivo con coste de maná convertido de 3 o menos sin pagar su coste de maná.\', \'type\': \'Criatura legendaria — Elemental dinosaurio felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480252&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8f79b0ec-08b3-4d05-a2dc-95fec055d9f8\', \'multiverseId\': 480252}, \'multiverseid\': 480252}, {\'name\': \'Vadrok, Zénith du tonnerre\', \'text\': "Mutation {1}{W/U}{R}{R} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\nVol, initiative\\nÀ chaque fois que cette créature subit une mutation, vous pouvez lancer une carte non-créature ciblée avec un coût converti de mana inférieur ou égal à 3 depuis votre cimetière sans payer son coût de mana.", \'type\': \'Créature légendaire : élémental et dinosaure et chat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480511&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'520604da-32d6-4564-8e51-6cbc827749ad\', \'multiverseId\': 480511}, \'multiverseid\': 480511}, {\'name\': \'Vadrok, Alfa del Tuono\', \'text\': \'Mutazione {1}{W/U}{R}{R} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\nVolare, attacco improvviso\\nOgniqualvolta questa creatura muta, puoi lanciare una carta non creatura bersaglio con costo di mana convertito pari o inferiore a 3 dal tuo cimitero senza pagare il suo costo di mana.\', \'type\': \'Creatura Leggendaria — Felino Dinosauro Elementale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480770&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'39fa8641-eaf2-4a49-81d0-418c9a66e966\', \'multiverseId\': 480770}, \'multiverseid\': 480770}, {\'name\': \'雷の頂点、ヴァドロック\', \'text\': \'変容{1}{W/U}{R}{R}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\n飛行、先制攻撃\\nこのクリーチャーが変容するたび、あなたの墓地から点数で見たマナ・コストが３以下でクリーチャーでないカード１枚を対象とする。あなたはそれをそのマナ・コストを支払うことなく唱えてもよい。\', \'type\': \'伝説のクリーチャー — エレメンタル・恐竜・猫\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481029&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d8876563-2613-405f-aa77-0c52420ca948\', \'multiverseId\': 481029}, \'multiverseid\': 481029}, {\'name\': \'천둥의 정점, 바드로크\', \'text\': \'돌연변이화 {1}{W/U}{R}{R} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n비행, 선제공격\\n이 생물이 돌연변이화할 때마다, 당신의 무덤에 있는 전환마나비용이 3 이하인 생물이 아닌 카드를 목표로 정한다. 당신은 마나 비용을 지불하지 않고 그 카드를 발동할 수 있다.\', \'type\': \'전설적 생물 — 정령 공룡 고양이\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481288&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0f1c1d64-ca2a-4d97-b3bf-43f37861bd07\', \'multiverseId\': 481288}, \'multiverseid\': 481288}, {\'name\': \'Vadrok, Ápice do Trovão\', \'text\': \'Mutação {1}{W/U}{R}{R} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\nVoar, iniciativa\\nToda vez que esta criatura sofre mutação, você pode conjurar o card alvo com custo de mana convertido igual ou inferior a 3 que não seja de criatura do seu cemitério sem pagar seu custo de mana.\', \'type\': \'Criatura Lendária — Elemental Dinossauro Felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481547&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1f908ac1-bd57-4280-913a-13a3f3f7d4d6\', \'multiverseId\': 481547}, \'multiverseid\': 481547}, {\'name\': \'Вадрок, Венец Грома\', \'text\': \'Мутация {1}{W/U}{R}{R} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\nПолет, Первый удар\\nКаждый раз, когда это существо мутирует, вы можете разыграть из вашего кладбища целевую не являющуюся существом карту с конвертированной мана-стоимостью не более 3 без уплаты ее мана-стоимости.\', \'type\': \'Легендарное Существо — Элементаль Динозавр Кошка\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481806&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8a62b9ec-819e-4f7f-8d12-4c2e45a076fd\', \'multiverseId\': 481806}, \'multiverseid\': 481806}, {\'name\': \'雷鸣霸龙瓦卓克\', \'text\': \'合变{1}{W/U}{R}{R}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n飞行，先攻\\n每当此生物合变时，你可以从你的坟墓场中施放目标总法术力费用等于或小于3的非生物牌，且不需支付其法术力费用。\', \'type\': \'传奇生物 ～元素／恐龙／猫\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482065&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8205b0d0-f5fe-4cbb-9be7-e16f6f771c8e\', \'multiverseId\': 482065}, \'multiverseid\': 482065}, {\'name\': \'雷鳴霸龍瓦卓克\', \'text\': \'合變{1}{W/U}{R}{R}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n飛行，先攻\\n每當此生物合變時，你可以從你的墳墓場中施放目標總魔法力費用等於或小於3的非生物牌，且不需支付其魔法力費用。\', \'type\': \'傳奇生物 ～元素／恐龍／貓\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482324&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6a6ee954-4103-40e5-a450-261685254c13\', \'multiverseId\': 482324}, \'multiverseid\': 482324}]', '[{\'name\': \'Verblüffende Verwandlung\', \'text\': \'Bis zum Ende des Zuges wird eine Kreatur deiner Wahl zu einer blauen Schlange mit Basis-Stärke und -Widerstandskraft 4/4.\\nUmwandlung {1} ({1}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Spontanzauber\', \'flavor\': \'Erstaunlicherweise ging das Fressen ohne weitere Unterbrechung weiter.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479847&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ed1c0bf0-71ff-41ca-99e5-be609283a90a\', \'multiverseId\': 479847}, \'multiverseid\': 479847}, {\'name\': \'Desarrollo extraordinario\', \'text\': \'Hasta el final del turno, la criatura objetivo se convierte en una Serpiente azul con fuerza y resistencia base de 4/4.\\nCiclo {1}. ({1}, descartar esta carta: Roba una carta.)\', \'type\': \'Instantáneo\', \'flavor\': \'Increíblemente, la cena prosiguió sin más interrupciones.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480106&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2e99f22a-db34-41e5-8c8b-5de3afb0da77\', \'multiverseId\': 480106}, \'multiverseid\': 480106}, {\'name\': \'Développement surprenant\', \'text\': "Jusqu\'à la fin du tour, une créature ciblée devient un grand serpent bleu avec une force et une endurance de base de 4/4.\\nRecyclage {1} ({1}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Éphémère\', \'flavor\': "Étonnamment, le repas s\'est poursuivi sans interruption.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480365&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fa9ec7b1-979f-46c3-ad83-87fcef793137\', \'multiverseId\': 480365}, \'multiverseid\': 480365}, {\'name\': \'Sviluppo Sconcertante\', \'text\': \'Fino alla fine del turno, una creatura bersaglio diventa una Serpe blu con forza e costituzione base 4/4.\\nCiclo {1} ({1}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Istantaneo\', \'flavor\': \'Sorprendentemente, la cena proseguì senza ulteriori interruzioni.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480624&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'df7e0935-9d24-408e-b04a-e3c83b213017\', \'multiverseId\': 480624}, \'multiverseid\': 480624}, {\'name\': \'驚くべき発育\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは基本のパワーとタフネスが４/４の青の海蛇になる。\\nサイクリング{1}（{1}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'インスタント\', \'flavor\': \'意外にも、夕食にはそれ以上の邪魔は入らなかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480883&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d87c2dba-2a05-458f-b5ff-7dbc1aee22a2\', \'multiverseId\': 480883}, \'multiverseid\': 480883}, {\'name\': \'깜짝 놀랄 발전\', \'text\': \'생물을 목표로 정한다. 턴종료까지, 그 생물은 기본 공격력과 방어력이 4/4인 청색 이무기 생물이 된다.\\n순환 {1} ({1}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'순간마법\', \'flavor\': \'놀랍게도, 저녁식사는 방해받지 않은 채로 계속되었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481142&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5cbe3dde-4968-4dd1-9b05-2a7608be74a1\', \'multiverseId\': 481142}, \'multiverseid\': 481142}, {\'name\': \'Desenvolvimento Surpreendente\', \'text\': \'Até o final do turno, a criatura alvo torna-se uma Serpente azul com poder e resistência básicos 4/4.\\nReciclar {1} ({1}, descarte este card: Compre um card.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Surpreendentemente, o jantar continuou sem mais interrupções.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481401&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b51305e5-a08f-4fbc-b0a2-b699e45fc5d8\', \'multiverseId\': 481401}, \'multiverseid\': 481401}, {\'name\': \'Поразительное Происшествие\', \'text\': \'До конца хода целевое существо становится синим Змеем с базовыми силой и выносливостью 4/4.\\nЦикл {1} ({1}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Любопытно, что обед продолжился без каких-либо заминок.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481660&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'88c6eff0-3f61-4d30-a3bc-7317c81fadd4\', \'multiverseId\': 481660}, \'multiverseid\': 481660}, {\'name\': \'惊人成长\', \'text\': \'直到回合结束，目标生物成为基础力量与防御力为4/4的蓝色巨蛇。\\n循环{1}（{1}，弃掉此牌：抓一张牌。）\', \'type\': \'瞬间\', \'flavor\': \'值得一提的是，此后晚餐便再无波折，平安结束。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481919&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f32b6a49-1dc7-485e-996d-f72177157e96\', \'multiverseId\': 481919}, \'multiverseid\': 481919}, {\'name\': \'驚人成長\', \'text\': \'直到回合結束，目標生物成為基礎力量與防禦力為4/4的藍色巨蛇。\\n循環{1}（{1}，棄掉此牌：抽一張牌。）\', \'type\': \'瞬間\', \'flavor\': \'值得一提的是，此後晚餐便再無波折，平安結束。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482178&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d222c62e-d2fd-4a2a-b478-2392898a9ca3\', \'multiverseId\': 482178}, \'multiverseid\': 482178}]', '[{\'name\': \'Verbotene Freundschaft\', \'text\': \'Erzeuge einen 1/1 roten Dinosaurier-Kreaturenspielstein mit Eile und einen 1/1 weißen Mensch-Soldat-Kreaturenspielstein.\', \'type\': \'Hexerei\', \'flavor\': \'Die beiden blickten sich ohne Furcht an. „Ich verstehe", murmelte der Soldat. „Wir beide kämpfen hier draußen nur ums Überleben, nicht wahr?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479898&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'40ddb9a7-1ff5-45d8-896e-ad0b3c27d120\', \'multiverseId\': 479898}, \'multiverseid\': 479898}, {\'name\': \'Amistad prohibida\', \'text\': \'Crea una ficha de criatura Dinosaurio roja 1/1 con la habilidad de prisa y una ficha de criatura Soldado Humano blanca 1/1.\', \'type\': \'Conjuro\', \'flavor\': \'Se miraron el uno al otro y ninguno huyó. "Ya veo", murmuró el soldado. "Los dos luchamos por sobrevivir, nada más, ¿verdad?".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480157&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'be08fa04-b74a-451e-94b9-26f61a2fc5c5\', \'multiverseId\': 480157}, \'multiverseid\': 480157}, {\'name\': \'Amitié interdite\', \'text\': \'Créez un jeton de créature 1/1 rouge Dinosaure avec la célérité et un jeton de créature 1/1 blanche Humain et Soldat.\', \'type\': \'Rituel\', \'flavor\': "Ils se regardèrent, mais aucun ne prit la fuite. « Je vois, » murmura le soldat. « Nous essayons tous les deux de survivre, tout simplement, n\'est-ce pas ? »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480416&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e6012985-ac17-4ea7-9bb0-e91ab76a39b6\', \'multiverseId\': 480416}, \'multiverseid\': 480416}, {\'name\': \'Amicizia Proibita\', \'text\': \'Crea una pedina creatura Dinosauro 1/1 rossa con rapidità e una pedina creatura Soldato Umano 1/1 bianca.\', \'type\': \'Stregoneria\', \'flavor\': \'I due si guardarono e nessuno di loro fuggì. "Capisco", mormorò il soldato. "Entrambi stiamo solo lottando per sopravvivere qua fuori, giusto?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480675&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eda660a1-dcf2-4d4a-ad01-d7fe5c9436d0\', \'multiverseId\': 480675}, \'multiverseid\': 480675}, {\'name\': \'禁じられた友情\', \'text\': \'速攻を持つ赤の１/１の恐竜・クリーチャー・トークンを１体と、白の１/１の人間・兵士・クリーチャー・トークンを１体生成する。\', \'type\': \'ソーサリー\', \'flavor\': \'どちらも互いを見て、逃げることはしなかった。「そうか。」と兵士はつぶやいた。「俺たちはただここで生き残るために戦っているだけなんだよな。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480934&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e0ab21f5-6f19-4bb0-b68f-c8b0211682b5\', \'multiverseId\': 480934}, \'multiverseid\': 480934}, {\'name\': \'금지된 우정\', \'text\': \'신속을 가진 1/1 적색 공룡 생물 토큰 한 개 및 1/1 백색 인간 병사 생물 토큰 한 개를 만든다.\', \'type\': \'집중마법\', \'flavor\': \'둘은 서로를 바라보았고, 어느 쪽도 도망가지 않았다. "알겠어," 병사가 중얼거렸다. "우리 둘 다 여기서 살아남으려고 싸우고 있는 거지, 안 그래?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481193&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'16c46338-5db6-4d1c-be9f-735d6a69db22\', \'multiverseId\': 481193}, \'multiverseid\': 481193}, {\'name\': \'Amizade Proibida\', \'text\': \'Crie uma ficha de criatura vermelha 1/1 do tipo Dinossauro com ímpeto e uma ficha de criatura branca 1/1 do tipo Humano Soldado.\', \'type\': \'Feitiço\', \'flavor\': \'Os dois se entreolharam e nenhum deles fugiu. "Entendo", murmurou o soldado. "Estamos ambos só lutando para sobreviver por aqui, não é?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481452&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5130e0af-e6a5-41c9-bd1c-53a2fbef5e44\', \'multiverseId\': 481452}, \'multiverseid\': 481452}, {\'name\': \'Запретная Дружба\', \'text\': \'Создайте одну фишку существа 1/1 красный Динозавр с Ускорением и одну фишку существа 1/1 белый Человек Солдат.\', \'type\': \'Волшебство\', \'flavor\': \'Двое посмотрели друг на друга, но ни один не побежал. «Понимаю, — проговорил солдат. — Мы оба лишь сражаемся за выживание, не так ли?»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481711&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'153aad13-8d70-4821-925f-79d7d2352479\', \'multiverseId\': 481711}, \'multiverseid\': 481711}, {\'name\': \'禁忌友谊\', \'text\': \'派出一个1/1红色，具敏捷异能的恐龙衍生生物和一个1/1白色人类／士兵衍生生物。\', \'type\': \'法术\', \'flavor\': \'双方目光交汇，谁都没有向后退却。「我懂，」士兵低声道。「我们彼此拼命，不就是为了在这里求得生存吗？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481970&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1661f5cf-bc52-4af8-97f6-f91f53708d1e\', \'multiverseId\': 481970}, \'multiverseid\': 481970}, {\'name\': \'禁忌友誼\', \'text\': \'派出一個1/1紅色，具敏捷異能的恐龍衍生生物和一個1/1白色人類／士兵衍生生物。\', \'type\': \'巫術\', \'flavor\': \'雙方目光交匯，誰都沒有向後退卻。「我懂，」士兵低聲道。「我們彼此拚命，不就是為了在這裡求得生存嗎？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482229&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'dd6164d7-402b-4874-8042-c0449f8f0d98\', \'multiverseId\': 482229}, \'multiverseid\': 482229}]', '[{\'name\': \'Verheißungsvoller Starrix\', \'text\': \'Mutation {5}{G} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\nImmer wenn diese Kreatur mutiert, schicke so lange die oberste Karte deiner Bibliothek ins Exil, bis du X bleibende Karten ins Exil geschickt hast, wobei X gleich der Anzahl an Mutationen dieser Kreatur ist. Bringe die bleibenden Karten ins Spiel.\', \'type\': \'Kreatur — Hirsch, Bestie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479923&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'355d4ac2-c523-4bb7-827d-53d7e51a5c22\', \'multiverseId\': 479923}, \'multiverseid\': 479923}, {\'name\': \'Starrix propicio\', \'text\': \'Mutación {5}{G}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\nSiempre que esta criatura mute, exilia cartas de la parte superior de tu biblioteca hasta que exilies X cartas de permanente, donde X es la cantidad de veces que esta criatura ha mutado. Pon esas cartas de permanente en el campo de batalla.\', \'type\': \'Criatura — Bestia alce\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480182&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'25ca1c6c-3dc2-470e-bbc9-dcf9a43747fb\', \'multiverseId\': 480182}, \'multiverseid\': 480182}, {\'name\': \'Starrix prospère\', \'text\': "Mutation {5}{G} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\nÀ chaque fois que cette créature subit une mutation, exilez les cartes du dessus de votre bibliothèque jusqu\'à ce que vous exiliez X cartes de permanent, X étant le nombre de mutations subies par cette créature. Mettez ces cartes de permanent sur le champ de bataille.", \'type\': \'Créature : élan et bête\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480441&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a1f6bbab-0ac9-459c-b216-9a6e1ee17127\', \'multiverseId\': 480441}, \'multiverseid\': 480441}, {\'name\': \'Starrix del Buon Auspicio\', \'text\': \'Mutazione {5}{G} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\nOgniqualvolta questa creatura muta, esilia carte dalla cima del tuo grimorio finché non esili X carte permanente, dove X è il numero di volte che questa creatura è mutata. Metti quelle carte permanente sul campo di battaglia.\', \'type\': \'Creatura — Bestia Alce\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480700&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ce167567-2cd4-4697-a0d8-23359f63af7c\', \'multiverseId\': 480700}, \'multiverseid\': 480700}, {\'name\': \'恵みのスターリックス\', \'text\': \'変容{5}{G}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\nこのクリーチャーが変容するたび、パーマネント・カードがＸ枚追放されるまで、あなたのライブラリーの一番上からカードを１枚ずつ追放する。Ｘはこのクリーチャーが変容した総回数に等しい。それらのパーマネント・カードを戦場に出す。\', \'type\': \'クリーチャー — 大鹿・ビースト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480959&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'82bdd344-b986-4295-af88-f9b7643fb8fc\', \'multiverseId\': 480959}, \'multiverseid\': 480959}, {\'name\': \'상서로운 스타릭스\', \'text\': \'돌연변이화 {5}{G} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n이 생물이 돌연변이화할 때마다, 지속물 카드를 X장 추방할 때까지 당신의 서고 맨 위 카드를 추방한다. X는 이 생물이 돌연변이화한 수이다. 그 지속물 카드들을 전장에 놓는다.\', \'type\': \'생물 — 엘크 야수\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481218&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'edbbdbe5-e669-4dfd-83a8-453263cb7581\', \'multiverseId\': 481218}, \'multiverseid\': 481218}, {\'name\': \'Starrix Auspiciosa\', \'text\': \'Mutação {5}{G} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\nToda vez que esta criatura sofrer mutação, exile cards do topo de seu grimório até exilar X cards de permanente, sendo X o número de mutações desta criatura. Coloque aqueles cards de permanente no campo de batalha.\', \'type\': \'Criatura — Alce Besta\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481477&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'043eeed3-209d-451f-bafe-0a271e25e217\', \'multiverseId\': 481477}, \'multiverseid\': 481477}, {\'name\': \'Приносящий Удачу Старрикс\', \'text\': \'Мутация {5}{G} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\nКаждый раз, когда это существо мутирует, изгоняйте карты с верха вашей библиотеки, пока вы не изгоните X карт перманентов, где X — число мутаций этого существа. Положите те карты перманентов на поле битвы.\', \'type\': \'Существо — Вапити Зверь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481736&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3ff06887-6b1b-449c-868c-f15a2e0e1cdc\', \'multiverseId\': 481736}, \'multiverseid\': 481736}, {\'name\': \'祥兆枭鹿\', \'text\': \'合变{5}{G}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n每当此生物合变时，从你的牌库顶开始放逐牌，直到放逐X张永久物牌为止，X为此生物已合变的次数。将这些永久物牌放进战场。\', \'type\': \'生物 ～麋鹿／野兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481995&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2ce18c4a-ec42-40cf-b3b9-8506c081b91d\', \'multiverseId\': 481995}, \'multiverseid\': 481995}, {\'name\': \'祥兆梟鹿\', \'text\': \'合變{5}{G}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n每當此生物合變時，從你的牌庫頂開始放逐牌，直到放逐X張永久物牌為止，X為此生物已合變的次數。將這些永久物牌放進戰場。\', \'type\': \'生物 ～麋鹿／野獸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482254&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'73d98e37-6552-4727-80e0-327ab5de352d\', \'multiverseId\': 482254}, \'multiverseid\': 482254}]', "[{'name': 'Verlassene Ödnis', 'text': 'Die Verlassene Ödnis kommt getappt ins Spiel.\\nWenn die Verlassene Ödnis ins Spiel kommt, erhältst du 1 Lebenspunkt dazu.\\n{T}: Erzeuge {W} oder {B}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480033&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f889f697-a64f-4787-83d5-77a557a4a42a', 'multiverseId': 480033}, 'multiverseid': 480033}, {'name': 'Yermos desérticos', 'text': 'Los Yermos desérticos entran al campo de batalla girados.\\nCuando los Yermos desérticos entren al campo de batalla, ganas 1 vida.\\n{T}: Agrega {W} o {B}.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480292&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '898b288a-f14b-4734-99cd-59d2fa848669', 'multiverseId': 480292}, 'multiverseid': 480292}, {'name': 'Landes érodées', 'text': 'Les Landes érodées arrivent sur le champ de bataille engagées.\\nQuand les Landes érodées arrivent sur le champ de bataille, vous gagnez 1 point de vie.\\n{T} : Ajoutez {W} ou {B}.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480551&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a9912746-9697-4055-9837-92aa4fe42832', 'multiverseId': 480551}, 'multiverseid': 480551}, {'name': 'Distese Desolate', 'text': 'Le Distese Desolate entrano nel campo di battaglia TAPpate.\\nQuando le Distese Desolate entrano nel campo di battaglia, guadagni 1 punto vita.\\n{T}: Aggiungi {W} o {B}.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480810&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'bd50135b-9a82-4cb7-9ed4-a3544af706cb', 'multiverseId': 480810}, 'multiverseid': 480810}, {'name': '磨かれたやせ地', 'text': '磨かれたやせ地はタップ状態で戦場に出る。\\n磨かれたやせ地が戦場に出たとき、あなたは１点のライフを得る。\\n{T}：{W}か{B}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481069&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '872eb492-9cfa-4b13-8e0b-34eaf1225164', 'multiverseId': 481069}, 'multiverseid': 481069}, {'name': '척박한 황무지', 'text': '척박한 황무지는 탭된 채로 전장에 들어온다.\\n척박한 황무지가 전장에 들어올 때, 당신은 생명 1점을 얻는다.\\n{T}: {W} 또는 {B}를 추가한다.', 'type': '대지', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481328&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '1d4478f7-27ed-4242-956b-ef82ae312fff', 'multiverseId': 481328}, 'multiverseid': 481328}, {'name': 'Desertos Calcinados', 'text': 'Desertos Calcinados entra no campo de batalha virado.\\nQuando Desertos Calcinados entra no campo de batalha, você ganha 1 ponto de vida.\\n{T}: Adicione {W} ou {B}.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481587&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e44e2f95-1477-4f49-8a2c-966ace390cb4', 'multiverseId': 481587}, 'multiverseid': 481587}, {'name': 'Выжженные Пустоши', 'text': 'Выжженные Пустоши выходят на поле битвы повернутыми.\\nКогда Выжженные Пустоши выходят на поле битвы, вы получаете 1 жизнь.\\n{T}: добавьте {W} или {B}.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481846&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'ddc418fb-4878-4a0b-8215-f54d31668fd6', 'multiverseId': 481846}, 'multiverseid': 481846}, {'name': '侵蚀荒漠', 'text': '侵蚀荒漠须横置进战场。\\n当侵蚀荒漠进战场时，你获得1点生命。\\n{T}：加{W}或{B}。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482105&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'e0e4b2dd-4fa7-4a44-80c3-d5cbd3e7baa4', 'multiverseId': 482105}, 'multiverseid': 482105}, {'name': '侵蝕荒漠', 'text': '侵蝕荒漠須橫置進戰場。\\n當侵蝕荒漠進戰場時，你獲得1點生命。\\n{T}：加{W}或{B}。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482364&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'a81510c4-ea7d-489f-98c9-ae0d3d4f248f', 'multiverseId': 482364}, 'multiverseid': 482364}]", '[{\'name\': \'Vernichtendes Ultimatum\', \'text\': \'Zerstöre alle bleibenden Karten, die deine Gegner kontrollieren und die keine Länder sind.\', \'type\': \'Hexerei\', \'flavor\': \'„Streckt diese Abscheulichkeiten nieder. Lasst ihre Namen und ihre Überreste verrotten."\\n—General Kudro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479983&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2362b613-fb7d-4f8f-9bce-cf8e1d503eff\', \'multiverseId\': 479983}, \'multiverseid\': 479983}, {\'name\': \'Ultimátum ruinoso\', \'text\': \'Destruye todos los permanentes que no sean tierra que controlan tus oponentes.\', \'type\': \'Conjuro\', \'flavor\': \'"Acaben con esas abominaciones. Que sus nombres se pudran junto a sus restos".\\n—El general Kudro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480242&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'147b77a9-8f3e-4c39-b439-a0ff1ab11d9c\', \'multiverseId\': 480242}, \'multiverseid\': 480242}, {\'name\': \'Ultimatum désastreux\', \'text\': \'Détruisez tous les permanents non-terrain que vos adversaires contrôlent.\', \'type\': \'Rituel\', \'flavor\': \'« Abattez ces abominations. Que leurs noms pourrissent avec leurs carcasses. »\\n—Général Koudro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480501&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'392495ee-5a86-4c8a-9536-86c420d2cae0\', \'multiverseId\': 480501}, \'multiverseid\': 480501}, {\'name\': \'Ultimatum Rovinoso\', \'text\': \'Distruggi tutti i permanenti non terra controllati dai tuoi avversari.\', \'type\': \'Stregoneria\', \'flavor\': \'"Annientate quegli abomini. Che i loro nomi marciscano insieme ai loro resti."\\n—Generale Kudro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480760&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'903a95a8-d683-4ac2-804f-7803adc90844\', \'multiverseId\': 480760}, \'multiverseid\': 480760}, {\'name\': \'破滅の根本原理\', \'text\': \'対戦相手がコントロールしていて土地でないパーマネントをすべて破壊する。\', \'type\': \'ソーサリー\', \'flavor\': \'「この忌々しいやつらを打ち倒せ。やつらの名を屍と共に腐らせてやれ。」\\n――クードロ将軍\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481019&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f90bd829-9605-4c79-bceb-d668fb3b6931\', \'multiverseId\': 481019}, \'multiverseid\': 481019}, {\'name\': \'파괴적인 최후통첩\', \'text\': \'당신의 상대들이 조종하는 모든 대지가 아닌 지속물을 파괴한다.\', \'type\': \'집중마법\', \'flavor\': \'"그 흉물들을 쓰러뜨려라. 그것들의 이름이 자기들의 시체와 함께 썩어 없어지게 해라."\\n—쿠드로 장군\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481278&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'af3b8152-506d-4ba9-895a-a90e7bd8deab\', \'multiverseId\': 481278}, \'multiverseid\': 481278}, {\'name\': \'Ultimato Ruinoso\', \'text\': \'Destrua todas as permanentes que seus oponentes controlam que não sejam terrenos.\', \'type\': \'Feitiço\', \'flavor\': \'"Derrubem aquelas abominações. Que os nomes delas apodreçam junto com seus restos mortais."\\n— General Kudro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481537&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5f73a466-64d5-4985-88e3-539dc1e26cf0\', \'multiverseId\': 481537}, \'multiverseid\': 481537}, {\'name\': \'Разрушительный Ультиматум\', \'text\': \'Уничтожьте все не являющиеся землями перманенты под контролем ваших оппонентов.\', \'type\': \'Волшебство\', \'flavor\': \'«Уничтожить этих мерзких тварей. Пусть их имена гниют вместе с их останками».\\n— генерал Кудро\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481796&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7760fdc3-bba1-426e-ab00-c1dd0d5e9379\', \'multiverseId\': 481796}, \'multiverseid\': 481796}, {\'name\': \'毁坏通牒\', \'text\': \'消灭所有由对手操控的非地永久物。\', \'type\': \'法术\', \'flavor\': \'「打倒那些憎恨怪兽。让它们的名字连同尸首一起腐烂。」\\n～寇卓将军\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482055&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2eab0fe2-5c21-4584-bbdf-1bdcc966c6d7\', \'multiverseId\': 482055}, \'multiverseid\': 482055}, {\'name\': \'毀壞通牒\', \'text\': \'消滅所有由對手操控的非地永久物。\', \'type\': \'巫術\', \'flavor\': \'「打倒那些憎恨怪獸。讓牠們的名字連同屍首一起腐爛。」\\n～寇卓將軍\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482314&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b7620053-f595-4773-bb7e-d6f47db85c80\', \'multiverseId\': 482314}, \'multiverseid\': 482314}]', '[{\'name\': \'Verwelken\', \'text\': \'Zerstöre ein Artefakt oder eine Verzauberung deiner Wahl.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Spontanzauber\', \'flavor\': \'Nichts kehrt aus den Nachtmahrnestern von Indatha unversehrt zurück.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479955&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'abb1582f-1395-49e2-b59d-609962249d05\', \'multiverseId\': 479955}, \'multiverseid\': 479955}, {\'name\': \'Marchitarse\', \'text\': \'Destruye el artefacto o encantamiento objetivo.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Instantáneo\', \'flavor\': \'Nada vuelve ileso de los nidos de las pesadillas de Indatha.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480214&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'43bcf9b0-65e1-415e-ab71-d3723cfb17bb\', \'multiverseId\': 480214}, \'multiverseid\': 480214}, {\'name\': \'Flétrissure\', \'text\': "Détruisez l\'artefact ciblé ou l\'enchantement ciblé.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Éphémère\', \'flavor\': "Rien ne revient indemne des nids cauchemardesques d\'Indatha.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480473&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'edc3b74e-7b2f-4b63-b045-c968a22887c8\', \'multiverseId\': 480473}, \'multiverseid\': 480473}, {\'name\': \'Appassire\', \'text\': \'Distruggi un artefatto o un incantesimo bersaglio.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Istantaneo\', \'flavor\': \'Niente ritorna incolume dai nidi degli incubi di Indatha.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480732&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'303e4f44-4c00-4b08-aa66-e4929d3d1bf0\', \'multiverseId\': 480732}, \'multiverseid\': 480732}, {\'name\': \'萎れ\', \'text\': \'アーティファクト１つかエンチャント１つを対象とし、それを破壊する。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'インスタント\', \'flavor\': \'インダサのナイトメアの巣から無傷で戻る者はいない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480991&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b32a0f91-6db6-406e-a81c-ccba5dff9b7e\', \'multiverseId\': 480991}, \'multiverseid\': 480991}, {\'name\': \'시듦\', \'text\': \'마법물체 또는 부여마법을 목표로 정한다. 그 목표를 파괴한다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'순간마법\', \'flavor\': \'인다타의 나이트메어 둥지로부터 탈 없이 돌아오는 것은 아무 것도 없다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481250&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b60bfc96-007c-4375-8469-ba0f4cce5f35\', \'multiverseId\': 481250}, \'multiverseid\': 481250}, {\'name\': \'Esmorecer\', \'text\': \'Destrua o artefato ou encantamento alvo.\\nReciclar {2} ({2}, descarte este card: Compre um card.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Nada volta ileso dos ninhos de pesadelos de Indatha.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481509&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'76cbc29a-f00a-45f5-86e0-e42f2b56ecab\', \'multiverseId\': 481509}, \'multiverseid\': 481509}, {\'name\': \'Захирение\', \'text\': \'Уничтожьте целевой артефакт или чары.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Никто не возвращается из кошмарных гнезд Индаты нетронутым.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481768&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5c2cdc86-7f18-40f2-b9db-f6b80b8fef64\', \'multiverseId\': 481768}, \'multiverseid\': 481768}, {\'name\': \'枝叶凋零\', \'text\': \'消灭目标神器或结界。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'瞬间\', \'flavor\': \'没有东西能从因达沙梦魇巢穴中全身而退。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482027&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2001e693-e740-47f5-aa98-8f0196d01f44\', \'multiverseId\': 482027}, \'multiverseid\': 482027}, {\'name\': \'枝葉凋零\', \'text\': \'消滅目標神器或結界。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'瞬間\', \'flavor\': \'沒有東西能從因達沙夢魘巢穴中全身而退。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482286&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c959c152-541a-40c9-8074-cf1c6c89ad6c\', \'multiverseId\': 482286}, \'multiverseid\': 482286}]', "[{'name': 'Vivien, Fürsprecherin der Monster', 'text': 'Du kannst dir zu jedem Zeitpunkt die oberste Karte deiner Bibliothek anschauen.\\nDu kannst Kreaturenzauber oben von deiner Bibliothek wirken.\\n+1: Erzeuge einen 3/3 grünen Bestie-Kreaturenspielstein. Lege eine Wachsamkeit-, Reichweite- oder Trampelschaden-Marke auf ihn (du entscheidest).\\n−2: Wenn du in diesem Zug deinen nächsten Kreaturenzauber wirkst, durchsuche deine Bibliothek nach einer Kreaturenkarte mit niedrigeren umgewandelten Manakosten, bringe sie ins Spiel und mische dann deine Bibliothek.', 'type': 'Legendärer Planeswalker — Vivien', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479954&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a78b954a-f45d-40b0-a8e2-5741cfab1e9d', 'multiverseId': 479954}, 'multiverseid': 479954}, {'name': 'Vivien, defensora de los monstruos', 'text': 'Puedes mirar la primera carta de tu biblioteca en cualquier momento.\\nPuedes lanzar hechizos de criatura desde la parte superior de tu biblioteca.\\n+1: Crea una ficha de criatura Bestia verde 3/3. Pon sobre ella el contador que elijas: de vigilancia, de alcance o de arrollar.\\n-2: Cuando lances tu próximo hechizo de criatura este turno, busca en tu biblioteca una carta de criatura con coste de maná convertido menor, ponla en el campo de batalla y luego baraja tu biblioteca.', 'type': 'Planeswalker legendario — Vivien', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480213&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'a98a38fb-76d9-4e51-bbbc-02a1c168f8ec', 'multiverseId': 480213}, 'multiverseid': 480213}, {'name': 'Vivien, partisane des monstres', 'text': 'Vous pouvez regarder la carte du dessus de votre bibliothèque à tout moment.\\nVous pouvez lancer les sorts de créature du dessus de votre bibliothèque.\\n+1: Créez un jeton de créature 3/3 verte Bête. Mettez, selon votre choix, un marqueur « vigilance », un marqueur « portée » ou un marqueur « piétinement » sur lui.\\n-2: Quand vous lancez votre prochain sort de créature ce tour-ci, cherchez dans votre bibliothèque une carte de créature avec un coût converti de mana inférieur, mettez-la sur le champ de bataille, et mélangez ensuite votre bibliothèque.', 'type': 'Planeswalker légendaire : Vivien', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480472&type=card', 'language': 'French', 'identifiers': {'scryfallId': '17e3f0df-0327-4719-8269-4a3ce73a924d', 'multiverseId': 480472}, 'multiverseid': 480472}, {'name': 'Vivien, Fautrice dei Mostri', 'text': 'Puoi guardare la prima carta del tuo grimorio in qualsiasi momento.\\nPuoi lanciare magie creatura dalla cima del tuo grimorio.\\n+1: Crea una pedina creatura Bestia 3/3 verde. Metti un segnalino cautela, un segnalino raggiungere o un segnalino travolgere a tua scelta su di essa.\\n-2: Quando lanci la tua prossima magia creatura in questo turno, passa in rassegna il tuo grimorio per una carta creatura con costo di mana convertito inferiore, mettila sul campo di battaglia, poi rimescola il tuo grimorio.', 'type': 'Planeswalker Leggendario — Vivien', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480731&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '24460f0f-dd52-4163-9b26-258ac44c61d9', 'multiverseId': 480731}, 'multiverseid': 480731}, {'name': '怪物の代言者、ビビアン', 'text': 'あなたはいつでもあなたのライブラリーの一番上のカードを見てよい。\\nあなたはあなたのライブラリーの一番上からクリーチャー・呪文を唱えてもよい。\\n+1：緑の３/３のビースト・クリーチャー・トークンを１体生成する。警戒カウンター１個か到達カウンター１個かトランプル・カウンター１個のうちあなたが選んだ１つをそれの上に置く。\\n-2：このターン、あなたが次にクリーチャー・呪文を唱えたとき、あなたのライブラリーから点数で見たマナ・コストがそれよりも小さいクリーチャー・カード１枚を探し、戦場に出し、その後あなたのライブラリーを切り直す。', 'type': '伝説のプレインズウォーカー — ビビアン', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480990&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '51b86f4d-de6f-4fce-8dce-ee192ef17c95', 'multiverseId': 480990}, 'multiverseid': 480990}, {'name': '괴수들의 대변인, 비비안', 'text': '당신은 당신의 서고 맨 위 카드를 언제든지 볼 수 있다.\\n당신은 당신의 서고 맨 위에서 생물 주문들을 발동할 수 있다.\\n+1: 3/3 녹색 야수 생물 토큰 한 개를 만든다. 그 생물에 경계 카운터, 대공 카운터, 또는 돌진 카운터 중 당신이 선택한 카운터를 올려놓는다.\\n−2: 당신이 이번 턴에 다음 생물 주문을 발동할 때, 당신의 서고에서 그보다 전환마나비용이 낮은 생물 카드 한 장을 찾아, 그 카드를 전장에 놓은 후, 당신의 서고를 섞는다.', 'type': '전설적 플레인즈워커 — 비비안', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481249&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'bcc2aa76-0033-4464-913a-89345bb3f2fb', 'multiverseId': 481249}, 'multiverseid': 481249}, {'name': 'Vivien, Protetora dos Monstros', 'text': 'Você pode olhar o card do topo de seu grimório a qualquer momento.\\nVocê pode conjurar mágicas de criatura do topo de seu grimório.\\n+1: Crie uma ficha de criatura verde 3/3 do tipo Besta. Coloque nela um marcador de vigilância, um marcador de alcance ou um marcador de atropelar, à sua escolha.\\n−2: Quando conjurar sua próxima mágica de criatura neste turno, procure em seu grimório um card de criatura com custo de mana convertido inferior ao dela, coloque-o no campo de batalha e depois embaralhe o seu grimório.', 'type': 'Planeswalker Lendário — Vivien', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481508&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5f2355d9-3b7e-44f9-82a4-174a4f8d6e5c', 'multiverseId': 481508}, 'multiverseid': 481508}, {'name': 'Вивьен, Защитница Монстров', 'text': 'Вы в любой момент можете посмотреть верхнюю карту вашей библиотеки.\\nВы можете разыгрывать заклинания существ с верха вашей библиотеки.\\n+1: создайте одну фишку существа 3/3 зеленый Зверь. Положите на нее один жетон Бдительности, один жетон Захвата или один жетон Пробивного удара по вашему выбору.\\n−2: когда вы разыгрываете ваше следующее заклинание существа в этом ходу, найдите в вашей библиотеке карту существа с меньшей конвертированной мана-стоимостью, положите ее на поле битвы, затем перетасуйте вашу библиотеку.', 'type': 'Легендарный Planeswalker — Вивьен', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481767&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'f55fadf2-df4b-4da5-b226-31041532f5c0', 'multiverseId': 481767}, 'multiverseid': 481767}, {'name': '护兽薇薇安', 'text': '你可以随时检视你的牌库顶牌。\\n你可以从你的牌库顶施放生物咒语。\\n+1：派出一个3/3绿色野兽衍生生物。在其上依你的选择放置一个警戒指示物、一个延势指示物或一个践踏指示物。\\n−2：本回合中，当你施放你的下一个生物咒语时，从你的牌库中搜寻一张生物牌，且其总法术力费用须小于该咒语，将之放进战场，然后将你的牌库洗牌。', 'type': '传奇鹏洛客 ～薇薇安', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482026&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'db3b1d57-4edf-4ff7-8261-5bf6413e46d7', 'multiverseId': 482026}, 'multiverseid': 482026}, {'name': '護獸薇薇安', 'text': '你可以隨時檢視你的牌庫頂牌。\\n你可以從你的牌庫頂施放生物咒語。\\n+1：派出一個3/3綠色野獸衍生生物。在其上依你的選擇放置一個警戒指示物、一個延勢指示物或一個踐踏指示物。\\n−2：本回合中，當你施放你的下一個生物咒語時，從你的牌庫中搜尋一張生物牌，且其總魔法力費用須小於該咒語，將之放進戰場，然後將你的牌庫洗牌。', 'type': '傳奇鵬洛客 ～薇薇安', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482285&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '5a4cf9b4-c009-4dea-9fa3-1cb126902a90', 'multiverseId': 482285}, 'multiverseid': 482285}]", '[{\'name\': \'Vollstrecker des Generals\', \'text\': \'Legendäre Menschen, die du kontrollierst, haben Unzerstörbarkeit.\\n{2}{W}{B}: Schicke eine Karte deiner Wahl aus einem Friedhof ins Exil. Falls es eine Kreaturenkarte war, erzeuge einen 1/1 weißen Mensch-Soldat-Kreaturenspielstein.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'Hartnäckiger als die Mauern von Drannith.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479967&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6cc2f5dc-332e-462d-b4ee-0c4b6114ab72\', \'multiverseId\': 479967}, \'multiverseid\': 479967}, {\'name\': \'Ejecutor del general\', \'text\': \'Los Humanos legendarios que controlas tienen la habilidad de indestructible.\\n{2}{W}{B}: Exilia la carta objetivo de un cementerio. Si era una carta de criatura, crea una ficha de criatura Soldado Humano blanca 1/1.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'Más testarudo que los muros de Drannith.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480226&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b4ef9107-2043-458e-87b0-dac6d7c845fa\', \'multiverseId\': 480226}, \'multiverseid\': 480226}, {\'name\': \'Argousin du général\', \'text\': "Les humains légendaires que vous contrôlez ont l\'indestructible.\\n{2}{W}{B} : Exilez une carte ciblée depuis un cimetière. Si c\'était une carte de créature, créez un jeton de créature 1/1 blanche Humain et Soldat.", \'type\': \'Créature : humain et soldat\', \'flavor\': \'Il est plus tenace que les murs de Drannith.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480485&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9207dba1-525b-403c-ba35-d4cc344eae74\', \'multiverseId\': 480485}, \'multiverseid\': 480485}, {\'name\': \'Esecutore del Generale\', \'text\': \'Gli Umani leggendari che controlli hanno indistruttibile.\\n{2}{W}{B}: Esilia una carta bersaglio da un cimitero. Se era una carta creatura, crea una pedina creatura Soldato Umano 1/1 bianca.\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'Più irremovibile delle mura di Drannith.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480744&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0f32169b-0786-4780-8f80-411cc31324a7\', \'multiverseId\': 480744}, \'multiverseid\': 480744}, {\'name\': \'将軍の執行官\', \'text\': \'あなたがコントロールしている伝説の人間は破壊不能を持つ。\\n{2}{W}{B}：墓地からカード１枚を対象とし、それを追放する。それがクリーチャー・カードであったなら、白の１/１の人間・兵士・クリーチャー・トークンを１体生成する。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'ドラニスの壁よりも固い。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481003&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8c36f605-5112-41e6-9067-2bb94df3d159\', \'multiverseId\': 481003}, \'multiverseid\': 481003}, {\'name\': \'장군의 집행자\', \'text\': \'당신이 조종하는 전설적 인간들은 무적을 가진다.\\n{2}{W}{B}: 무덤에 있는 카드를 목표로 정한다. 그 카드를 추방한다. 그 카드가 생물 카드였다면, 1/1 백색 인간 병사 생물 토큰 한 개를 만든다.\', \'type\': \'생물 — 인간 병사\', \'flavor\': \'드라니스의 방벽보다 더 완고하다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481262&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3330ee3b-46ab-4bd4-b406-7b5e918c2826\', \'multiverseId\': 481262}, \'multiverseid\': 481262}, {\'name\': \'Impositor do General\', \'text\': \'Os Humanos lendários que você controla têm indestrutível.\\n{2}{W}{B}: Exile o card alvo de um cemitério. Se for um card de criatura, crie uma ficha de criatura branca 1/1 do tipo Humano Soldado.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': \'Mais obstinado que as muralhas de Drannith.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481521&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bb50adec-bd2a-4e23-a20c-f51de3e2bf64\', \'multiverseId\': 481521}, \'multiverseid\': 481521}, {\'name\': \'Блюститель Генерала\', \'text\': \'Легендарные перманенты с подтипом Человек под вашим контролем имеют Неразрушимость.\\n{2}{W}{B}: изгоните целевую карту из кладбища. Если это была карта существа, создайте одну фишку существа 1/1 белый Человек Солдат.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'Он неподатливее, чем стены Драннита.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481780&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'18b61448-7eaf-4b15-a851-01df2adc5ab1\', \'multiverseId\': 481780}, \'multiverseid\': 481780}, {\'name\': \'将军的执法者\', \'text\': \'由你操控的传奇人类具有不灭异能。\\n{2}{W}{B}：将目标牌从坟墓场放逐。如果它是生物牌，则派出一个1/1白色人类／士兵衍生生物。\', \'type\': \'生物 ～人类／士兵\', \'flavor\': \'比卓尼斯的高墙更硬实。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482039&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bba3474e-05d5-4b69-8a13-2713903ca481\', \'multiverseId\': 482039}, \'multiverseid\': 482039}, {\'name\': \'將軍的執法者\', \'text\': \'由你操控的傳奇人類具有不滅異能。\\n{2}{W}{B}：將目標牌從墳墓場放逐。如果它是生物牌，則派出一個1/1白色人類／士兵衍生生物。\', \'type\': \'生物 ～人類／士兵\', \'flavor\': \'比卓尼斯的高牆更硬實。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482298&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2b335446-1ed9-4c89-afa0-3293ad8d98a1\', \'multiverseId\': 482298}, \'multiverseid\': 482298}]', "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482562&type=card', 'language': 'German', 'identifiers': {'scryfallId': '1f5ceb48-4238-45ee-8f35-dc5bc230de7a', 'multiverseId': 482562}, 'multiverseid': 482562}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482577&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4e2cac68-ffc7-4c4c-a9fe-4909ba727168', 'multiverseId': 482577}, 'multiverseid': 482577}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482592&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a2313114-6487-4136-9265-7425948376da', 'multiverseId': 482592}, 'multiverseid': 482592}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482607&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '6fe99960-340f-4975-9c65-e601bc038f5b', 'multiverseId': 482607}, 'multiverseid': 482607}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482622&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '525af1c9-2d4c-4502-ad09-52d8f1141d35', 'multiverseId': 482622}, 'multiverseid': 482622}, {'name': '숲', 'type': '기본 대지 — 숲', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482637&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '324e64eb-bbe2-4d7e-919d-4f12064bc5b1', 'multiverseId': 482637}, 'multiverseid': 482637}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482652&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7fd88e6b-37b6-4aee-ae70-f6338a54c594', 'multiverseId': 482652}, 'multiverseid': 482652}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482667&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '3211a518-f4e5-4b52-bac1-23992745b38e', 'multiverseId': 482667}, 'multiverseid': 482667}, {'name': '树林', 'type': '基本地 ～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482682&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'cae79eb2-26a3-4c82-8ee5-62712923b033', 'multiverseId': 482682}, 'multiverseid': 482682}, {'name': '樹林', 'type': '基本地 ～樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482697&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '78d292d3-905c-4678-bacd-2fc25fab7678', 'multiverseId': 482697}, 'multiverseid': 482697}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482563&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'adc4d428-15b8-4b90-8315-29d69acc8d60', 'multiverseId': 482563}, 'multiverseid': 482563}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482578&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'a829a28c-448d-4d55-9a82-547f4a63986f', 'multiverseId': 482578}, 'multiverseid': 482578}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482593&type=card', 'language': 'French', 'identifiers': {'scryfallId': '46e3a036-a2c4-45d4-8fe9-6deab86b4d1a', 'multiverseId': 482593}, 'multiverseid': 482593}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482608&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'fd1fd5b2-39e6-42a3-b111-9c8faa5e0324', 'multiverseId': 482608}, 'multiverseid': 482608}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482623&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f521ef4a-f98c-4755-aa9e-169eb8c5936e', 'multiverseId': 482623}, 'multiverseid': 482623}, {'name': '숲', 'type': '기본 대지 — 숲', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482638&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '919e4e46-d42f-48bb-9ceb-e23c36d3ed88', 'multiverseId': 482638}, 'multiverseid': 482638}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482653&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ffcd0e83-a210-4008-9356-a010a11c5cf4', 'multiverseId': 482653}, 'multiverseid': 482653}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482668&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '06192b80-e62a-4d07-9938-35cf9849edc5', 'multiverseId': 482668}, 'multiverseid': 482668}, {'name': '树林', 'type': '基本地 ～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482683&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'dd4b6b11-d432-4327-afcf-c9096fc6684b', 'multiverseId': 482683}, 'multiverseid': 482683}, {'name': '樹林', 'type': '基本地 ～樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482698&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'a4641a20-feff-49a1-af59-6685bd472d93', 'multiverseId': 482698}, 'multiverseid': 482698}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482564&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b99e4cd3-e725-4180-b43e-f0e1de984873', 'multiverseId': 482564}, 'multiverseid': 482564}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482579&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '07c4f465-af23-4a6d-ba94-70c0942860be', 'multiverseId': 482579}, 'multiverseid': 482579}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482594&type=card', 'language': 'French', 'identifiers': {'scryfallId': '73d545c8-044e-44a1-a69a-16c0822ec1dc', 'multiverseId': 482594}, 'multiverseid': 482594}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482609&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c7b8fd56-d777-402f-83f1-b0ced7563637', 'multiverseId': 482609}, 'multiverseid': 482609}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482624&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '915e4077-93d5-4b9f-bf3e-68aaa8d13d9c', 'multiverseId': 482624}, 'multiverseid': 482624}, {'name': '숲', 'type': '기본 대지 — 숲', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482639&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '426f0ae0-349e-4d0e-affc-ff6b173ae6bd', 'multiverseId': 482639}, 'multiverseid': 482639}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482654&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b4c13553-b618-4291-9c26-4c567d896554', 'multiverseId': 482654}, 'multiverseid': 482654}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482669&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'c38d4bcb-1ca9-4099-94b8-eb8c13264c31', 'multiverseId': 482669}, 'multiverseid': 482669}, {'name': '树林', 'type': '基本地 ～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482684&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '767b79b1-2564-4c06-b4e8-8c900b6cb75e', 'multiverseId': 482684}, 'multiverseid': 482684}, {'name': '樹林', 'type': '基本地 ～樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482699&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'c6a0359e-49e4-4210-80e1-058e53d19afa', 'multiverseId': 482699}, 'multiverseid': 482699}]", '[{\'name\': \'Wilder Tigorilla\', \'text\': \'Der Wilde Tigorilla kommt mit einer Trampelschaden- oder einer Bedrohlich-Marke ins Spiel (du entscheidest). (Eine Kreatur mit Bedrohlichkeit kann nicht geblockt werden, außer von zwei oder mehr Kreaturen.)\', \'type\': \'Kreatur — Katze, Menschenaffe\', \'flavor\': \'Aus einer bestimmten Perspektive ist es eine inspirierende Geschichte über die Überwindung von Hindernissen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479894&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c617a2fb-bb37-47ce-97a2-e482810f2198\', \'multiverseId\': 479894}, \'multiverseid\': 479894}, {\'name\': \'Tigrerila feroz\', \'text\': \'El Tigrerila feroz entra al campo de batalla con lo que elijas sobre él: un contador de arrollar o un contador de amenaza. (Una criatura con la habilidad de amenaza no puede ser bloqueada excepto por dos o más criaturas.)\', \'type\': \'Criatura — Simio felino\', \'flavor\': \'Desde cierta perspectiva, es una historia inspiradora sobre la superación de obstáculos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480153&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'46747b88-8b5b-4675-ba92-11165e404fe3\', \'multiverseId\': 480153}, \'multiverseid\': 480153}, {\'name\': \'Tigrorille féroce\', \'text\': \'Le Tigrorille féroce arrive sur le champ de bataille avec, selon votre choix, un marqueur « piétinement » ou un marqueur « menace » sur lui. (Une créature avec la menace ne peut pas être bloquée excepté par deux créatures ou plus.)\', \'type\': \'Créature : chat et grand singe\', \'flavor\': "D\'une certaine façon, cette histoire est un beau message d\'inspiration pour surmonter les obstacles.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480412&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a68e01c3-d35b-4076-bc3e-d217bf43335a\', \'multiverseId\': 480412}, \'multiverseid\': 480412}, {\'name\': \'Tigrorilla Feroce\', \'text\': \'Il Tigrorilla Feroce entra nel campo di battaglia con un segnalino travolgere o un segnalino minacciare a tua scelta. (Una creatura con minacciare non può essere bloccata tranne che da due o più creature.)\', \'type\': \'Creatura — Scimpanzé Felino\', \'flavor\': \'In un certo senso, la sua è una storia ispiratrice che insegna a superare qualsiasi ostacolo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480671&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a48f9e4f-a7f9-421e-87b3-ec458ae72a6d\', \'multiverseId\': 480671}, \'multiverseid\': 480671}, {\'name\': \'獰猛なゴリトラ\', \'text\': \'獰猛なゴリトラは、トランプル・カウンター１個か威迫カウンター１個のうちあなたが選んだ１つが置かれた状態で戦場に出る。（威迫を持つクリーチャーは、２体以上のクリーチャーによってしかブロックされない。）\', \'type\': \'クリーチャー — 猫・類人猿\', \'flavor\': \'見方を変えれば、これは障壁を乗り越える感動の物語だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480930&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dd8d9760-5e74-46ec-b573-a76217931286\', \'multiverseId\': 480930}, \'multiverseid\': 480930}, {\'name\': \'흉포한 호릴라\', \'text\': \'흉포한 호릴라는 돌진 카운터 또는 호전적 카운터 중 당신이 선택한 카운터를 가지고 전장에 들어온다. (호전적이 있는 생물은 두 개 이상의 생물로만 방어할 수 있다.)\', \'type\': \'생물 — 고양이 유인원\', \'flavor\': \'특정한 관점에서 보면, 그건 장애물을 극복하는 인상적인 이야기이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481189&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c9b66c8f-39f4-4155-bf8f-82d031633de7\', \'multiverseId\': 481189}, \'multiverseid\': 481189}, {\'name\': \'Tigrorila Feroz\', \'text\': \'Tigrorila Feroz entra no campo de batalha com um marcador de atropelar ou um marcador de ameaçar, à sua escolha. (Uma criatura com ameaçar só pode ser bloqueada por duas ou mais criaturas.)\', \'type\': \'Criatura — Felino Símio\', \'flavor\': \'De certo ponto de vista, é uma inspiradora história de superação.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481448&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'39482de6-f051-469f-a466-e46d392e957a\', \'multiverseId\': 481448}, \'multiverseid\': 481448}, {\'name\': \'Яростная Тигорилла\', \'text\': \'Яростная Тигорилла выходит на поле битвы с одним жетоном Пробивного удара или одним жетоном Угрозы на ней по вашему выбору. (Существо с Угрозой не может быть заблокировано менее чем двумя существами.)\', \'type\': \'Существо — Кошка Обезьяна\', \'flavor\': \'С определенной точки зрения, это вдохновляющая история о преодолении препятствий.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481707&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'da33ac19-8e24-492d-94c6-8fbe73852a93\', \'multiverseId\': 481707}, \'multiverseid\': 481707}, {\'name\': \'凶猛虎猿\', \'text\': \'凶猛虎猿进战场时上面依你的选择有一个践踏指示物或一个威慑指示物。（具威慑异能的生物只能被两个或更多生物阻挡。）\', \'type\': \'生物 ～猫／猿猴\', \'flavor\': \'从某种角度来说，这是一个不畏艰辛克服万难的励志故事。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481966&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'22a5b17c-491f-4f44-8e0c-1c677eca0f16\', \'multiverseId\': 481966}, \'multiverseid\': 481966}, {\'name\': \'兇猛虎猿\', \'text\': \'兇猛虎猿進戰場時上面依你的選擇有一個踐踏指示物或一個威懾指示物。（具威懾異能的生物只能被兩個或更多生物阻擋。）\', \'type\': \'生物 ～貓／猿猴\', \'flavor\': \'從某種角度來說，這是一個不畏艱辛克服萬難的勵志故事。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482225&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'67e2ce91-bddc-4208-960a-60fd1df6e518\', \'multiverseId\': 482225}, \'multiverseid\': 482225}]', "[{'name': 'Wildes Hochland', 'text': 'Das Wilde Hochland kommt getappt ins Spiel.\\nWenn das Wilde Hochland ins Spiel kommt, erhältst du 1 Lebenspunkt dazu.\\n{T}: Erzeuge {R} oder {G}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480031&type=card', 'language': 'German', 'identifiers': {'scryfallId': '660047f8-93eb-4406-b1c3-f2e5f3c2c1db', 'multiverseId': 480031}, 'multiverseid': 480031}, {'name': 'Tierras altas escabrosas', 'text': 'Las Tierras altas escabrosas entran al campo de batalla giradas.\\nCuando las Tierras altas escabrosas entren al campo de batalla, ganas 1 vida.\\n{T}: Agrega {R} o {G}.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480290&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '7e6ec69d-15d4-422a-91b9-ed69e96cc3c8', 'multiverseId': 480290}, 'multiverseid': 480290}, {'name': 'Hautes terres rocailleuses', 'text': 'Les Hautes terres rocailleuses arrivent sur le champ de bataille engagées.\\nQuand les Hautes terres rocailleuses arrivent sur le champ de bataille, vous gagnez 1 point de vie.\\n{T} : Ajoutez {R} ou {G}.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480549&type=card', 'language': 'French', 'identifiers': {'scryfallId': '7b3606a8-ba0d-4dd9-b9ac-96a807db8241', 'multiverseId': 480549}, 'multiverseid': 480549}, {'name': 'Altopiani Accidentati', 'text': 'Gli Altopiani Accidentati entrano nel campo di battaglia TAPpati.\\nQuando gli Altopiani Accidentati entrano nel campo di battaglia, guadagni 1 punto vita.\\n{T}: Aggiungi {R} o {G}.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480808&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ee5efa58-0798-404e-bf94-285f99377486', 'multiverseId': 480808}, 'multiverseid': 480808}, {'name': '岩だらけの高地', 'text': '岩だらけの高地はタップ状態で戦場に出る。\\n岩だらけの高地が戦場に出たとき、あなたは１点のライフを得る。\\n{T}：{R}か{G}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481067&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'd7612cda-ad36-496a-87e1-9c280103795c', 'multiverseId': 481067}, 'multiverseid': 481067}, {'name': '바위투성이 고산지대', 'text': '바위투성이 고산지대는 탭된 채로 전장에 들어온다.\\n바위투성이 고산지대가 전장에 들어올 때, 당신은 생명 1점을 얻는다.\\n{T}: {R} 또는 {G}를 추가한다.', 'type': '대지', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481326&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '58cccc8c-8a85-41ac-93bc-bf2e60afc803', 'multiverseId': 481326}, 'multiverseid': 481326}, {'name': 'Planalto Acidentado', 'text': 'Planalto Acidentado entra no campo de batalha virado.\\nQuando Planalto Acidentado entra no campo de batalha, você ganha 1 ponto de vida.\\n{T}: Adicione {R} ou {G}.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481585&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3f7e67c1-d84a-4939-bc07-d979ea068558', 'multiverseId': 481585}, 'multiverseid': 481585}, {'name': 'Непроходимые Горы', 'text': 'Непроходимые Горы выходят на поле битвы повернутыми.\\nКогда Непроходимые Горы выходят на поле битвы, вы получаете 1 жизнь.\\n{T}: добавьте {R} или {G}.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481844&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '9e15d3a7-ef04-479b-b821-8f85b82f33a8', 'multiverseId': 481844}, 'multiverseid': 481844}, {'name': '崎岖高地', 'text': '崎岖高地须横置进战场。\\n当崎岖高地进战场时，你获得1点生命。\\n{T}：加{R}或{G}。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482103&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b4638d19-ef98-411a-9b0f-1efc59403963', 'multiverseId': 482103}, 'multiverseid': 482103}, {'name': '崎嶇高地', 'text': '崎嶇高地須橫置進戰場。\\n當崎嶇高地進戰場時，你獲得1點生命。\\n{T}：加{R}或{G}。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482362&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '1f1da322-4b51-4b57-aad2-8d5463fea648', 'multiverseId': 482362}, 'multiverseid': 482362}]", '[{\'name\': \'Wille des All-Jagenden\', \'text\': \'Eine Kreatur deiner Wahl erhält +2/+2 bis zum Ende des Zuges. Falls sie gerade blockt, lege stattdessen zwei +1/+1-Marken auf sie.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Spontanzauber\', \'flavor\': \'„Es ist Snapdax. Es wäre einfacher, eine Mauer mit einer Scheibe Brot zu durchbrechen."\\n—Krek, Hauptmann der Tagwache\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479817&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0602ae83-e6fe-473e-ab18-a11440bc21c8\', \'multiverseId\': 479817}, \'multiverseid\': 479817}, {\'name\': \'Voluntad del Cazador Supremo\', \'text\': \'La criatura objetivo obtiene +2/+2 hasta el final del turno. Si está bloqueando, en vez de eso, pon dos contadores +1/+1 sobre ella.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Instantáneo\', \'flavor\': \'"Es Snapdax. Tendrías más posibilidades de derribar un muro con una rebanada de pan".\\n—Krek, capitán de la brigada diurna\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480076&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ab4742c0-c819-445e-ab63-f2c1f59e4ded\', \'multiverseId\': 480076}, \'multiverseid\': 480076}, {\'name\': \'Volonté du Giboyeur\', \'text\': "La créature ciblée gagne +2/+2 jusqu\'à la fin du tour. Si elle bloque, à la place mettez deux marqueurs +1/+1 sur elle.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Éphémère\', \'flavor\': "« C\'est Snapdax. Vous auriez plus de chances de casser un mur avec une tranche de pain. »\\n—Krek, capitaine de l\'escouade diurne", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480335&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'73a296ef-3801-4685-b19a-8e2edac57817\', \'multiverseId\': 480335}, \'multiverseid\': 480335}, {\'name\': "Volontà dell\'Onnipredatore", \'text\': \'Una creatura bersaglio prende +2/+2 fino alla fine del turno. Se sta bloccando, invece metti due segnalini +1/+1 su di essa.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Istantaneo\', \'flavor\': \'"È Snapdax. Avresti più probabilità di far breccia in un muro con una fetta di pane."\\n—Krek, capitano dello squadrone diurno\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480594&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'635fb38c-d169-4a95-a777-28e85dab2284\', \'multiverseId\': 480594}, \'multiverseid\': 480594}, {\'name\': \'全てを狩るものの意志\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋２/＋２の修整を受ける。それがブロックしているなら、代わりに、それの上に＋１/＋１カウンターを２個置く。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'インスタント\', \'flavor\': \'「スナップダックスだ。パン一切れで壁を破れる好機だ。」\\n――日勤隊長、クレク\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480853&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9845fe46-7243-4d1f-9741-1e5a2c1e88a4\', \'multiverseId\': 480853}, \'multiverseid\': 480853}, {\'name\': \'지고의 사냥꾼의 의지\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 +2/+2를 받는다. 그 생물이 방어 중이라면, 대신 그 생물에 +1/+1 카운터 두 개를 올려놓는다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'순간마법\', \'flavor\': \'"저건 스냅댁스야. 계란으로 바위를 깨뜨리는 게 훨씬 확률이 높을걸."\\n—낮 부대 대장, 크레크\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481112&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f8cbf76d-8c79-48b0-a57a-5144758b7a5a\', \'multiverseId\': 481112}, \'multiverseid\': 481112}, {\'name\': \'Vontade do Onicaçador\', \'text\': \'A criatura alvo recebe +2/+2 até o final do turno. Se ela estiver bloqueando, em vez disso, coloque dois marcadores +1/+1 nela.\\nReciclar {2} ({2}, descarte este card: Compre um card.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"É Snapdax. Você teria mais chance de derrubar uma muralha com uma fatia de pão."\\n— Krek, capitão do esquadrão diurno\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481371&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8a591fd0-ff9f-4bb8-b336-dd652b189e4d\', \'multiverseId\': 481371}, \'multiverseid\': 481371}, {\'name\': \'Воля Всеохотника\', \'text\': \'Целевое существо получает +2/+2 до конца хода. Если оно блокирует, вместо этого положите на него два жетона +1/+1.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Это же Снапдакс. Ты скорее пробьешь стену краюшкой хлеба».\\n— Крек, капитан дневного отряда\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481630&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0352ecea-8ba8-4b4f-82ef-c2785ff67da1\', \'multiverseId\': 481630}, \'multiverseid\': 481630}, {\'name\': \'万猎虎意志\', \'text\': \'目标生物得+2/+2直到回合结束。如果它正进行阻挡，则改为在其上放置两个+1/+1指示物。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'瞬间\', \'flavor\': \'「那可是斯达兹。比起战胜它，也许你用面包砸穿墙壁会比较容易。」\\n～昼班队长柯列克\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481889&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7abb37d1-c414-4d25-bff6-9ea05bf4c6a3\', \'multiverseId\': 481889}, \'multiverseid\': 481889}, {\'name\': \'萬獵虎意志\', \'text\': \'目標生物得+2/+2直到回合結束。如果它正進行阻擋，則改為在其上放置兩個+1/+1指示物。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'瞬間\', \'flavor\': \'「那可是斯達茲。比起戰勝牠，也許你用麵包砸穿牆壁會比較容易。」\\n～晝班隊長柯列克\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482148&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0f5bf880-6736-4ca3-ad8e-95c7ad3180d2\', \'multiverseId\': 482148}, \'multiverseid\': 482148}]', "[{'name': 'Windgepeitschte Felswand', 'text': 'Die Windgepeitschte Felswand kommt getappt ins Spiel.\\nWenn die Windgepeitschte Felswand ins Spiel kommt, erhältst du 1 Lebenspunkt dazu.\\n{T}: Erzeuge {R} oder {W}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480037&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a2da976b-f5e3-40d5-b07c-92a398215fca', 'multiverseId': 480037}, 'multiverseid': 480037}, {'name': 'Risco cicatriz del viento', 'text': 'El Risco cicatriz del viento entra al campo de batalla girado.\\nCuando el Risco cicatriz del viento entre al campo de batalla, ganas 1 vida.\\n{T}: Agrega {R} o {W}.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480296&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '364802c9-8f7a-489e-8df0-451743eeb03e', 'multiverseId': 480296}, 'multiverseid': 480296}, {'name': 'Cordillère marquée par les vents', 'text': 'La Cordillère marquée par les vents arrive sur le champ de bataille engagée.\\nQuand la Cordillère marquée par les vents arrive sur le champ de bataille, vous gagnez 1 point de vie.\\n{T} : Ajoutez {R} ou {W}.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480555&type=card', 'language': 'French', 'identifiers': {'scryfallId': '3293930a-8d2f-4ce1-97f6-bfaa5ed0b6de', 'multiverseId': 480555}, 'multiverseid': 480555}, {'name': 'Dirupo Eroso dai Venti', 'text': 'Il Dirupo Eroso dai Venti entra nel campo di battaglia TAPpato.\\nQuando il Dirupo Eroso dai Venti entra nel campo di battaglia, guadagni 1 punto vita.\\n{T}: Aggiungi {R} o {W}.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480814&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'f5643851-694e-40d4-8170-79652888c8ae', 'multiverseId': 480814}, 'multiverseid': 480814}, {'name': '風に削られた岩山', 'text': '風に削られた岩山はタップ状態で戦場に出る。\\n風に削られた岩山が戦場に出たとき、あなたは１点のライフを得る。\\n{T}：{R}か{W}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481073&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '31af640f-32db-4562-a4a9-81e76429a9c7', 'multiverseId': 481073}, 'multiverseid': 481073}, {'name': '풍화된 암석지대', 'text': '풍화된 암석지대는 탭된 채로 전장에 들어온다.\\n풍화된 암석지대가 전장에 들어올 때, 당신은 생명 1점을 얻는다.\\n{T}: {R} 또는 {W}를 추가한다.', 'type': '대지', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481332&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'c8e98ee7-57b4-431b-a5c0-bb5a44f226a7', 'multiverseId': 481332}, 'multiverseid': 481332}, {'name': 'Penhasco Marcado pelo Vento', 'text': 'Penhasco Marcado pelo Vento entra no campo de batalha virado.\\nQuando Penhasco Marcado pelo Vento entra no campo de batalha, você ganha 1 ponto de vida.\\n{T}: Adicione {R} ou {W}.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481591&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd1eb1178-591a-4249-9dcc-4dfe88f43431', 'multiverseId': 481591}, 'multiverseid': 481591}, {'name': 'Обветренный Утес', 'text': 'Обветренный Утес выходит на поле битвы повернутым.\\nКогда Обветренный Утес выходит на поле битвы, вы получаете 1 жизнь.\\n{T}: добавьте {R} или {W}.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481850&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'f1f49a91-6458-4fc7-9ffb-50bac76b785e', 'multiverseId': 481850}, 'multiverseid': 481850}, {'name': '风蚀峭壁', 'text': '风蚀峭壁须横置进战场。\\n当风蚀峭壁进战场时，你获得1点生命。\\n{T}：加{R}或{W}。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482109&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b6bea85d-0ef4-4dd3-b9fe-fa07bef8d186', 'multiverseId': 482109}, 'multiverseid': 482109}, {'name': '風蝕峭壁', 'text': '風蝕峭壁須橫置進戰場。\\n當風蝕峭壁進戰場時，你獲得1點生命。\\n{T}：加{R}或{W}。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482368&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'dbe09e45-5c67-4659-a713-859ff29a8609', 'multiverseId': 482368}, 'multiverseid': 482368}]", "[{'name': 'Windstoß', 'text': 'Dieser Zauberspruch kostet beim Wirken {2} weniger, falls du eine fliegende Kreatur kontrollierst.\\nBringe eine bleibende Karte deiner Wahl, die kein Land ist und die du nicht kontrollierst, auf die Hand ihres Besitzers zurück.\\nZiehe eine Karte.', 'type': 'Hexerei', 'flavor': 'Die Stärke von Himmelstadt war gleichzeitig auch ihr Schwachpunkt.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479833&type=card', 'language': 'German', 'identifiers': {'scryfallId': '732f8515-47e8-4393-ab94-e9dce37089e2', 'multiverseId': 479833}, 'multiverseid': 479833}, {'name': 'Ráfaga de viento', 'text': 'Te cuesta {2} menos lanzar este hechizo si controlas una criatura con la habilidad de volar.\\nRegresa el permanente objetivo que no sea tierra que no controlas a la mano de su propietario.\\nRoba una carta.', 'type': 'Conjuro', 'flavor': 'La fuerza de Puertoaéreo también es su vulnerabilidad.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480092&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '3f3ec574-f356-471b-b21d-444fc5ae3d7e', 'multiverseId': 480092}, 'multiverseid': 480092}, {'name': 'Rafale de vent', 'text': 'Ce sort coûte {2} de moins à lancer si vous contrôlez une créature avec le vol.\\nRenvoyez un permanent non-terrain ciblé que vous ne contrôlez pas dans la main de son propriétaire.\\nPiochez une carte.', 'type': 'Rituel', 'flavor': 'La force de Vogueciel était aussi sa faiblesse.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480351&type=card', 'language': 'French', 'identifiers': {'scryfallId': '34b10d85-6d8e-4210-9401-350a58a290f9', 'multiverseId': 480351}, 'multiverseid': 480351}, {'name': 'Raffica di Vento', 'text': 'Questa magia costa {2} in meno per essere lanciata se controlli una creatura con volare.\\nFai tornare un permanente non terra bersaglio che non controlli in mano al suo proprietario.\\nPesca una carta.', 'type': 'Stregoneria', 'flavor': 'Il punto di forza della Solcanembi era anche la sua debolezza.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480610&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3788bdc7-4e14-4faf-8b08-ad9f8a80b61e', 'multiverseId': 480610}, 'multiverseid': 480610}, {'name': '疾風', 'text': 'あなたが飛行を持つクリーチャーをコントロールしているなら、この呪文を唱えるためのコストは{2}少なくなる。\\nあなたがコントロールしておらず土地でもないパーマネント１つを対象とし、それをオーナーの手札に戻す。\\nカードを１枚引く。', 'type': 'ソーサリー', 'flavor': 'スカイセイルの強みは弱みでもある。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480869&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '0203742c-d1f6-49af-a73d-d455e17db9df', 'multiverseId': 480869}, 'multiverseid': 480869}, {'name': '한 줄기 돌풍', 'text': '당신이 비행을 가진 생물을 조종한다면 이 주문은 발동하는 데 {2}가 덜 든다.\\n당신이 조종하지 않는 대지가 아닌 지속물을 목표로 정한다. 그 목표를 소유자의 손으로 되돌린다.\\n카드 한 장을 뽑는다.', 'type': '집중마법', 'flavor': '창공돛의 힘은 또한 창공돛의 약점이기도 하다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481128&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '1219a1e0-e081-4cf0-bd9c-c009a5c48062', 'multiverseId': 481128}, 'multiverseid': 481128}, {'name': 'Lufada de Vento', 'text': 'Esta mágica custa {2} a menos para ser conjurada se você controla uma criatura com voar.\\nDevolva a permanente alvo que você não controla que não seja um terreno para a mão de seu dono.\\nCompre um card.', 'type': 'Feitiço', 'flavor': 'O ponto de força da Vela Celeste era também seu ponto vulnerável.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481387&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '805af0c3-1ea9-4558-b083-4f25f2e3fe27', 'multiverseId': 481387}, 'multiverseid': 481387}, {'name': 'Порыв Ветра', 'text': 'Разыгрывание этого заклинания стоит на {2} меньше, если вы контролируете существо с Полетом.\\nВерните целевой не являющийся землей перманент, который не находится под вашим контролем, в руку его владельца.\\nВозьмите карту.', 'type': 'Волшебство', 'flavor': 'В силе Небесного Паруса одновременно и его слабость.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481646&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'a3d0fa62-ca82-40d2-bfca-995f14f244d9', 'multiverseId': 481646}, 'multiverseid': 481646}, {'name': '劲风吹袭', 'text': '如果你操控具飞行异能的生物，则此咒语减少{2}来施放。\\n将目标不由你操控的非地永久物移回其拥有者手上。\\n抓一张牌。', 'type': '法术', 'flavor': '翔空城的优势也恰好是其弱点。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481905&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '60f1cb57-7354-4d20-a0f2-8a4938e021a7', 'multiverseId': 481905}, 'multiverseid': 481905}, {'name': '勁風吹襲', 'text': '如果你操控具飛行異能的生物，則此咒語減少{2}來施放。\\n將目標不由你操控的非地永久物移回其擁有者手上。\\n抽一張牌。', 'type': '巫術', 'flavor': '翔空城的優勢也恰好是其弱點。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482164&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'bb756a58-9a97-4916-92d5-0ba0cf824670', 'multiverseId': 482164}, 'multiverseid': 482164}]", '[{\'name\': \'Winota, Einerin der Kräfte\', \'text\': \'Immer wenn eine Nicht-Mensch-Kreatur, die du kontrollierst, angreift, schaue dir die obersten sechs Karten deiner Bibliothek an. Du kannst davon eine Mensch-Kreaturenkarte getappt und angreifend ins Spiel bringen. Sie erhält Unzerstörbarkeit bis zum Ende des Zuges. Lege den Rest der Karten in zufälliger Reihenfolge unter deine Bibliothek.\', \'type\': \'Legendäre Kreatur — Mensch, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479995&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'05e17dc4-307d-453b-8d67-65448daa995e\', \'multiverseId\': 479995}, \'multiverseid\': 479995}, {\'name\': \'Winota, la Unidora de Fuerzas\', \'text\': \'Siempre que una criatura que no sea Humano que controlas ataque, mira las seis primeras cartas de tu biblioteca. Puedes poner en el campo de batalla girada y atacando una carta de criatura Humano que se encuentre entre ellas. Gana la habilidad de indestructible hasta el final del turno. Pon el resto de las cartas en el fondo de tu biblioteca en un orden aleatorio.\', \'type\': \'Criatura legendaria — Guerrero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480254&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'273edc36-4e85-4250-9bfb-ecb675677d92\', \'multiverseId\': 480254}, \'multiverseid\': 480254}, {\'name\': \'Winota, unisseuse de forces\', \'text\': "À chaque fois qu\'une créature non-Humain que vous contrôlez attaque, regardez les six cartes du dessus de votre bibliothèque. Vous pouvez mettre sur le champ de bataille, engagée et attaquante, une carte de créature Humain parmi elles. Elle acquiert l\'indestructible jusqu\'à la fin du tour. Mettez le reste des cartes au-dessous de votre bibliothèque dans un ordre aléatoire.", \'type\': \'Créature légendaire : humain et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480513&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b569d29f-ebdd-450a-800d-8b9496b76632\', \'multiverseId\': 480513}, \'multiverseid\': 480513}, {\'name\': \'Winota, Radunatrice di Forze\', \'text\': \'Ogniqualvolta una creatura non Umano che controlli attacca, guarda le prime sei carte del tuo grimorio. Puoi mettere una carta creatura Umano scelta tra esse sul campo di battaglia TAPpata e attaccante. Ha indistruttibile fino alla fine del turno. Metti le altre carte in fondo al tuo grimorio in ordine casuale.\', \'type\': \'Creatura Leggendaria — Guerriero Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480772&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4808a72e-b521-4a8b-add5-d5c82142761a\', \'multiverseId\': 480772}, \'multiverseid\': 480772}, {\'name\': \'軍団のまとめ役、ウィノータ\', \'text\': \'あなたがコントロールしていて人間でないクリーチャーが１体攻撃するたび、あなたのライブラリーの一番上からカードを６枚見る。あなたはその中から人間・クリーチャー・カード１枚をタップ状態で攻撃している状態で戦場に出してもよい。ターン終了時まで、それは破壊不能を得る。残りのカードをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'伝説のクリーチャー — 人間・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481031&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c09d89f8-921f-4501-8fb7-a17c548a87c3\', \'multiverseId\': 481031}, \'multiverseid\': 481031}, {\'name\': \'세력 규합자, 위노타\', \'text\': \'당신이 조종하는 인간이 아닌 생물이 공격할 때마다, 당신의 서고 맨 위 카드 여섯 장을 본다. 당신은 그중에서 인간 생물 카드 한 장을 탭되어 공격 중인 상태로 전장에 놓을 수 있다. 그 생물은 턴종료까지 무적을 얻는다. 나머지 카드들은 무작위 순서로 당신의 서고 맨 밑에 놓는다.\', \'type\': \'전설적 생물 — 인간 전사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481290&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4dec01f2-9a53-48a4-b2e7-5be4c7bde872\', \'multiverseId\': 481290}, \'multiverseid\': 481290}, {\'name\': \'Winota, Agregadora de Forças\', \'text\': \'Toda vez que uma criatura que você controla que não seja um Humano atacar, olhe os seis cards do topo de seu grimório. Você pode colocar um card de criatura do tipo Humano dentre eles no campo de batalha virado e atacando. Ele ganha indestrutível até o final do turno. Coloque o restante dos cards no fundo de seu grimório em ordem aleatória.\', \'type\': \'Criatura Lendária — Humano Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481549&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'13b35f85-8edc-4e44-8a17-10438b813042\', \'multiverseId\': 481549}, \'multiverseid\': 481549}, {\'name\': \'Винота, Объединившая Силы\', \'text\': \'Каждый раз, когда не являющееся Человеком существо под вашим контролем атакует, посмотрите шесть верхних карт вашей библиотеки. Вы можете положить на поле битвы находящуюся среди них карту существа-Человека повернутой и атакующей. Она получает Неразрушимость до конца хода. Положите остальные карты в низ вашей библиотеки в случайном порядке.\', \'type\': \'Легендарное Существо — Человек Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481808&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'749fbb8e-d7aa-401b-af40-2abae66770b9\', \'multiverseId\': 481808}, \'multiverseid\': 481808}, {\'name\': \'聚力领袖薇诺塔\', \'text\': \'每当一个由你操控的非人类生物攻击时，检视你牌库顶的六张牌。你可以将其中一张人类生物牌放进战场，其为横置且正进行攻击。它获得不灭异能直到回合结束。将其余的牌以随机顺序置于你的牌库底。\', \'type\': \'传奇生物 ～人类／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482067&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8e75e8b7-a1d3-4013-a598-d28eb97371a5\', \'multiverseId\': 482067}, \'multiverseid\': 482067}, {\'name\': \'聚力領袖薇諾塔\', \'text\': \'每當一個由你操控的非人類生物攻擊時，檢視你牌庫頂的六張牌。你可以將其中一張人類生物牌放進戰場，其為橫置且正進行攻擊。它獲得不滅異能直到回合結束。將其餘的牌以隨機順序置於你的牌庫底。\', \'type\': \'傳奇生物 ～人類／戰士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482326&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f6d879c8-065d-4986-ab6d-f79bc84fe6af\', \'multiverseId\': 482326}, \'multiverseid\': 482326}]', '[{\'name\': \'Wirbelwind der Gedanken\', \'text\': \'Immer wenn du einen Nichtkreatur-Zauberspruch wirkst, ziehe eine Karte.\', \'type\': \'Verzauberung\', \'flavor\': \'Während Narset versuchte zu meditieren, schwirrten winzige Drachen um sie herum und beschworen Gedanken an alte Clans.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479994&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b0648dcd-239e-4341-97ac-00882411003a\', \'multiverseId\': 479994}, \'multiverseid\': 479994}, {\'name\': \'Torbellino de pensamientos\', \'text\': \'Siempre que lances un hechizo que no sea de criatura, roba una carta.\', \'type\': \'Encantamiento\', \'flavor\': \'Mientras Narset trataba de meditar, pequeñas crías de dragón revoloteaban a su alrededor, haciendo brotar ideas de clanes antiguos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480253&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bb394778-835f-4d2e-8aca-ff7581e1898b\', \'multiverseId\': 480253}, \'multiverseid\': 480253}, {\'name\': \'Tourbillon de pensée\', \'text\': \'À chaque fois que vous lancez un sort non-créature, piochez une carte.\', \'type\': \'Enchantement\', \'flavor\': "Narset avait du mal à méditer. De petits dragons volaient autour d\'elle, évoquant des clans anciens.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480512&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'af9ae3f7-321f-45b6-b77c-40b3c7818de5\', \'multiverseId\': 480512}, \'multiverseid\': 480512}, {\'name\': \'Vortice di Pensiero\', \'text\': \'Ogniqualvolta lanci una magia non creatura, pesca una carta.\', \'type\': \'Incantesimo\', \'flavor\': \'Mentre Narset si sforzava di meditare, piccoli draghi disegnavano spirali intorno a lei, evocando pensieri di clan antichi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480771&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5dcea3ec-ae2b-4132-9880-f289c9c29c3a\', \'multiverseId\': 480771}, \'multiverseid\': 480771}, {\'name\': \'思考の旋風\', \'text\': \'あなたがクリーチャーでない呪文を唱えるたび、カードを１枚引く。\', \'type\': \'エンチャント\', \'flavor\': \'ナーセットが葛藤の中で瞑想していると、小さなドラゴンが彼女を取り巻いて古代の氏族の思考を思い起こさせた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481030&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4e22d603-1891-46e7-b55d-674002fe3c2d\', \'multiverseId\': 481030}, \'multiverseid\': 481030}, {\'name\': \'생각의 소용돌이\', \'text\': \'당신이 생물이 아닌 주문을 발동할 때마다, 카드 한 장을 뽑는다.\', \'type\': \'부여마법\', \'flavor\': \'나르셋이 명상을 하려 애쓰자, 작은 새끼 용들이 그녀의 주위를 맴돌며, 고대 부족들에 대한 생각들을 떠오르게 했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481289&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b9a4ddc6-310f-46ac-b117-0ce172dbe7c4\', \'multiverseId\': 481289}, \'multiverseid\': 481289}, {\'name\': \'Redemoinho de Pensamentos\', \'text\': \'Toda vez que você conjurar uma mágica que não seja de criatura, compre um card.\', \'type\': \'Encantamento\', \'flavor\': \'Enquanto Narset lutava para meditar, dragõezinhos espiralavam em torno dela, conjurando pensamentos de clãs ancestrais.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481548&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f2e3e3bb-a7b4-4c0e-bc69-12166f15f32b\', \'multiverseId\': 481548}, \'multiverseid\': 481548}, {\'name\': \'Вихрь Мыслей\', \'text\': \'Каждый раз, когда вы разыгрываете не являющееся существом заклинание, возьмите карту.\', \'type\': \'Чары\', \'flavor\': \'Нарсет пыталась медитировать, но крохотные дракончики кружили вокруг нее, навевая мысли о древних кланах.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481807&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cdc791bd-f4fa-45b7-9354-ee5f4640b11e\', \'multiverseId\': 481807}, \'multiverseid\': 481807}, {\'name\': \'思绪旋风\', \'text\': \'每当你施放非生物咒语时，抓一张牌。\', \'type\': \'结界\', \'flavor\': \'娜尔施努力进入冥想之时，看到幼龙绕其身旁飞舞，思绪不禁飘到了远古部族时代。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482066&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e365b51f-c4cb-4232-b1af-2b21bd80e0ab\', \'multiverseId\': 482066}, \'multiverseid\': 482066}, {\'name\': \'思緒旋風\', \'text\': \'每當你施放非生物咒語時，抽一張牌。\', \'type\': \'結界\', \'flavor\': \'娜爾施努力進入冥想之時，看到幼龍繞其身旁飛舞，思緒不禁飄到了遠古部族時代。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482325&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'96ef2018-b30d-4fa9-b8df-e4b94a83c11c\', \'multiverseId\': 482325}, \'multiverseid\': 482325}]', '[{\'name\': \'Wolkendränger\', \'text\': \'Mutation {3}{R} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\nReichweite\\nImmer wenn diese Kreatur mutiert, kannst du eine Karte abwerfen. Falls du dies tust, ziehe eine Karte.\', \'type\': \'Kreatur — Dinosaurier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479891&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2986d953-99b7-4cce-8a25-1240f8807833\', \'multiverseId\': 479891}, \'multiverseid\': 479891}, {\'name\': \'Rascanubes\', \'text\': \'Mutación {3}{R}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\nAlcance.\\nSiempre que esta criatura mute, puedes descartar una carta. Si lo haces, roba una carta.\', \'type\': \'Criatura — Dinosaurio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480150&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'04808550-5758-4433-8bcf-fe401f11f8fe\', \'multiverseId\': 480150}, \'multiverseid\': 480150}, {\'name\': \'Perce-nuages\', \'text\': "Mutation {3}{R} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\nPortée\\nÀ chaque fois que cette créature subit une mutation, vous pouvez vous défausser d\'une carte. Si vous faites ainsi, piochez une carte.", \'type\': \'Créature : dinosaure\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480409&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c20f0a65-a487-4bb8-a697-c204fb973f63\', \'multiverseId\': 480409}, \'multiverseid\': 480409}, {\'name\': \'Trafigginubi\', \'text\': \'Mutazione {3}{R} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\nRaggiungere\\nOgniqualvolta questa creatura muta, puoi scartare una carta. Se lo fai, pesca una carta.\', \'type\': \'Creatura — Dinosauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480668&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'601b129b-c09a-464f-b343-0bcb136aa9dc\', \'multiverseId\': 480668}, \'multiverseid\': 480668}, {\'name\': \'雲貫き\', \'text\': \'変容{3}{R}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\n到達\\nこのクリーチャーが変容するたび、あなたはカード１枚を捨ててもよい。そうしたなら、カードを１枚引く。\', \'type\': \'クリーチャー — 恐竜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480927&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d1115dd5-a4ba-4c7e-ba12-81c0e7b30852\', \'multiverseId\': 480927}, \'multiverseid\': 480927}, {\'name\': \'구름관통꾼\', \'text\': \'돌연변이화 {3}{R} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n대공\\n이 생물이 돌연변이화할 때마다, 당신은 카드 한 장을 버릴 수 있다. 그렇게 한다면, 카드 한 장을 뽑는다.\', \'type\': \'생물 — 공룡\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481186&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0913cbc4-1060-474f-9ff5-67f1bcc0052c\', \'multiverseId\': 481186}, \'multiverseid\': 481186}, {\'name\': \'Furanuvem\', \'text\': \'Mutação {3}{R} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\nAlcance\\nToda vez que esta criatura sofre mutação, você pode descartar um card. Se fizer isso, compre um card.\', \'type\': \'Criatura — Dinossauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481445&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ad405e88-783f-41e4-9ec2-8f2894ec1b8a\', \'multiverseId\': 481445}, \'multiverseid\': 481445}, {\'name\': \'Пронзатель Облаков\', \'text\': \'Мутация {3}{R} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\nЗахват\\nКаждый раз, когда это существо мутирует, вы можете сбросить карту. Если вы это делаете, возьмите карту.\', \'type\': \'Существо — Динозавр\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481704&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b7cb7a60-c622-455f-87b8-1878550264bb\', \'multiverseId\': 481704}, \'multiverseid\': 481704}, {\'name\': \'穿云庞龙\', \'text\': \'合变{3}{R}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n延势\\n每当此生物合变时，你可以弃一张牌。若你如此作，则抓一张牌。\', \'type\': \'生物 ～恐龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481963&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d20a0c49-6c48-4252-bfbb-aac59d296854\', \'multiverseId\': 481963}, \'multiverseid\': 481963}, {\'name\': \'穿雲龐龍\', \'text\': \'合變{3}{R}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n延勢\\n每當此生物合變時，你可以棄一張牌。若你如此作，則抽一張牌。\', \'type\': \'生物 ～恐龍\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482222&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c1133748-d4dd-4584-9c07-fe108835d909\', \'multiverseId\': 482222}, \'multiverseid\': 482222}]', '[{\'name\': \'Wuchtvoller Polterer\', \'text\': \'Immer wenn der Wuchtvolle Polterer angreift und falls er nicht Erstschlag hat, lege eine Erstschlag-Marke auf ihn.\\nImmer wenn der Wuchtvolle Polterer angreift und falls er Erstschlag hat, erhält er Doppelschlag bis zum Ende des Zuges.\', \'type\': \'Kreatur — Dinosaurier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479905&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8e2ba766-0e53-4648-b822-610f9284859d\', \'multiverseId\': 479905}, \'multiverseid\': 479905}, {\'name\': \'Retumbador impetuoso\', \'text\': \'Siempre que el Retumbador impetuoso ataque, si no tiene la habilidad de dañar primero, pon un contador de dañar primero sobre él.\\nSiempre que el Retumbador impetuoso ataque, si tiene la habilidad de dañar primero, gana la habilidad de dañar dos veces hasta el final del turno.\', \'type\': \'Criatura — Dinosaurio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480164&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0248a82e-b21f-4c20-9c43-6c371a720d2c\', \'multiverseId\': 480164}, \'multiverseid\': 480164}, {\'name\': \'Grondeur fougueux\', \'text\': "À chaque fois que le Grondeur fougueux attaque, s\'il n\'a pas l\'initiative, mettez un marqueur « initiative » sur lui.\\nÀ chaque fois que le Grondeur fougueux attaque, s\'il a l\'initiative, il acquiert la double initiative jusqu\'à la fin du tour.", \'type\': \'Créature : dinosaure\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480423&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0494f792-a594-417d-a47c-4df2bc17d197\', \'multiverseId\': 480423}, \'multiverseid\': 480423}, {\'name\': \'Fracassatore alla Carica\', \'text\': \'Ogniqualvolta il Fracassatore alla Carica attacca, se non ha attacco improvviso, metti un segnalino attacco improvviso su di esso.\\nOgniqualvolta il Fracassatore alla Carica attacca, se ha attacco improvviso, guadagna doppio attacco fino alla fine del turno.\', \'type\': \'Creatura — Dinosauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480682&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'927702c6-7054-465b-b8c3-99f865c934e5\', \'multiverseId\': 480682}, \'multiverseid\': 480682}, {\'name\': \'勢い付く地鳴らし\', \'text\': \'勢い付く地鳴らしが攻撃するたび、これが先制攻撃を持っていない場合、これの上に先制攻撃カウンターを１個置く。\\n勢い付く地鳴らしが攻撃するたび、これが先制攻撃を持っている場合、ターン終了時まで、これは二段攻撃を得る。\', \'type\': \'クリーチャー — 恐竜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480941&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d278d309-ad9f-49eb-ba8f-aba0f9dcfd53\', \'multiverseId\': 480941}, \'multiverseid\': 480941}, {\'name\': \'속도를 내는 난동꾼\', \'text\': \'속도를 내는 난동꾼이 공격할 때마다, 속도를 내는 난동꾼이 선제공격을 가지고 있지 않다면, 속도를 내는 난동꾼에 선제공격 카운터를 올려놓는다.\\n속도를 내는 난동꾼이 공격할 때마다, 속도를 내는 난동꾼이 선제공격을 가지고 있다면, 속도를 내는 난동꾼은 턴종료까지 이단공격을 얻는다.\', \'type\': \'생물 — 공룡\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481200&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0ee364b0-f0d4-4af6-a549-3d8bcaad7578\', \'multiverseId\': 481200}, \'multiverseid\': 481200}, {\'name\': \'Troante Desenfreado\', \'text\': \'Toda vez que Troante Desenfreado atacar, se ele não tiver iniciativa, coloque um marcador de iniciativa nele.\\nToda vez que Troante Desenfreado ataca, se ele tiver iniciativa, ele ganha golpe duplo até o final do turno.\', \'type\': \'Criatura — Dinossauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481459&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f741d8f1-42af-4995-b45c-20e8993ef755\', \'multiverseId\': 481459}, \'multiverseid\': 481459}, {\'name\': \'Разогнавшийся Громила\', \'text\': \'Каждый раз, когда Разогнавшийся Громила атакует, если у него нет Первого удара, положите на него один жетон Первого удара.\\nКаждый раз, когда Разогнавшийся Громила атакует, если у него есть Первый удар, то он получает Двойной удар до конца хода.\', \'type\': \'Существо — Динозавр\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481718&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5acaeae7-dff4-422a-9476-111e61d5fc88\', \'multiverseId\': 481718}, \'multiverseid\': 481718}, {\'name\': \'猛冲撼地龙\', \'text\': \'每当猛冲撼地龙攻击时，若它不具有先攻异能，则在其上放置一个先攻指示物。\\n每当猛冲撼地龙攻击时，若它具有先攻异能，则它获得连击异能直到回合结束。\', \'type\': \'生物 ～恐龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481977&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e9d1bf57-c958-473d-9720-1108e5421d3d\', \'multiverseId\': 481977}, \'multiverseid\': 481977}, {\'name\': \'猛衝撼地龍\', \'text\': \'每當猛衝撼地龍攻擊時，若它不具有先攻異能，則在其上放置一個先攻指示物。\\n每當猛衝撼地龍攻擊時，若它具有先攻異能，則它獲得連擊異能直到回合結束。\', \'type\': \'生物 ～恐龍\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482236&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'014c4863-0b11-4bbc-9efd-f125f83dee48\', \'multiverseId\': 482236}, \'multiverseid\': 482236}]', '[{\'name\': \'Wühlender Moloch\', \'text\': \'Wenn der Wühlende Moloch ins Spiel kommt, schicke eine Karte deiner Wahl mit einer Umwandlung-Fähigkeit aus deinem Friedhof ins Exil. Du kannst sie bis zum Ende deines nächsten Zuges spielen.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Kreatur — Eidechse\', \'flavor\': \'Ihre Ernährungsgewohnheiten lassen sie mit Mägen voller zermalmter Edelsteine zurück.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479912&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f043d898-a5b4-4dec-b812-bc7034b6278e\', \'multiverseId\': 479912}, \'multiverseid\': 479912}, {\'name\': \'Moloc hocicador\', \'text\': \'Cuando el Moloc hocicador entre al campo de batalla, exilia la carta objetivo con una habilidad de ciclo de tu cementerio. Hasta el final de tu próximo turno, puedes jugar esa carta.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Criatura — Lagarto\', \'flavor\': \'Sus hábitos alimenticios hacen que sus mollejas estén llenas de gemas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480171&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'75bc0e10-8404-4062-8e23-5ebad9ef2cc1\', \'multiverseId\': 480171}, \'multiverseid\': 480171}, {\'name\': \'Diable cornu éradicateur\', \'text\': "Quand le Diable cornu éradicateur arrive sur le champ de bataille, exilez une carte ciblée avec une capacité de recyclage depuis votre cimetière. Jusqu\'à la fin de votre prochain tour, vous pouvez jouer cette carte.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Créature : lézard\', \'flavor\': \'Leurs habitudes alimentaires laissent leur gésier rempli de gemmes avalées.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480430&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bff2e86e-f4bc-42f8-ab2b-56c2d02d4728\', \'multiverseId\': 480430}, \'multiverseid\': 480430}, {\'name\': \'Moloc Abbarbicato\', \'text\': "Quando il Moloc Abbarbicato entra nel campo di battaglia, esilia una carta bersaglio con un\'abilità ciclo dal tuo cimitero. Fino alla fine del tuo prossimo turno, puoi giocare quella carta.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)", \'type\': \'Creatura — Lucertola\', \'flavor\': \'Le loro abitudini alimentari fanno sì che abbiano sempre lo stomaco pieno di gemme lucidate.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480689&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6ad668a6-a6d3-443a-bd6f-866cb52d68a0\', \'multiverseId\': 480689}, \'multiverseid\': 480689}, {\'name\': \'発根のモロク\', \'text\': \'発根のモロクが戦場に出たとき、あなたの墓地からサイクリング能力を持つカード１枚を対象とし、それを追放する。次のあなたのターンの終了時まで、あなたはそのカードをプレイしてもよい。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'クリーチャー — トカゲ\', \'flavor\': \'モロクは崩れた宝石が詰まった砂嚢を残しておく。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480948&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0f816a69-f73c-440f-9f37-4214603be130\', \'multiverseId\': 480948}, \'multiverseid\': 480948}, {\'name\': \'파헤치는 가시도마뱀\', \'text\': \'파헤치는 가시도마뱀이 전장에 들어올 때, 당신의 무덤에 있는 순환 능력을 가진 카드를 목표로 정한다. 그 카드를 추방한다. 당신의 다음 턴 턴종료까지, 당신은 그 카드를 플레이할 수 있다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'생물 — 도마뱀\', \'flavor\': \'그것들의 모래주머니는 식습관 때문에 보석으로 가득 차 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481207&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a8074e03-4975-41a5-8e6a-9eead22960af\', \'multiverseId\': 481207}, \'multiverseid\': 481207}, {\'name\': \'Moloch Escavador\', \'text\': \'Quando Moloch Escavador entrar no campo de batalha, exile o card alvo com uma habilidade reciclar do seu cemitério. Até o final do seu próximo turno, você pode jogar aquele card.\\nReciclar {2} ({2}, descarte este card: Compre um card.)\', \'type\': \'Criatura — Lagarto\', \'flavor\': \'Seus hábitos alimentares os deixam com a moela cheia de gemas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481466&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4996576e-b628-40ae-b1e6-f42facccf69a\', \'multiverseId\': 481466}, \'multiverseid\': 481466}, {\'name\': \'Роющий Землю Молох\', \'text\': \'Когда Роющий Землю Молох выходит на поле битвы, изгоните целевую карту со способностью Цикла из вашего кладбища. Вы можете разыграть ту карту до конца вашего следующего хода.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Существо — Ящер\', \'flavor\': \'Из-за их пищевых привычек желудки у них бывают набиты отшлифованными самоцветами.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481725&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1a11ef03-fa22-46d9-9d46-204765d02dfa\', \'multiverseId\': 481725}, \'multiverseid\': 481725}, {\'name\': \'掘根棘蜥\', \'text\': \'当掘根棘蜥进战场时，将目标具任一循环异能的牌从你的坟墓场放逐。直到你下一个回合的回合结束，你可以使用该牌。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'生物 ～蜥蜴\', \'flavor\': \'它们的饮食习惯让其胃囊中满是磨得闪闪发光的宝石。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481984&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b3bd60e1-0577-4ea6-9a28-ca6461ce4248\', \'multiverseId\': 481984}, \'multiverseid\': 481984}, {\'name\': \'掘根棘蜥\', \'text\': \'當掘根棘蜥進戰場時，將目標具任一循環異能的牌從你的墳墓場放逐。直到你下一個回合的回合結束，你可以使用該牌。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'生物 ～蜥蜴\', \'flavor\': \'牠們的飲食習慣讓其胃囊中滿是磨得閃閃發光的寶石。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482243&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'53be48f9-058b-4477-b623-da4b998654e9\', \'multiverseId\': 482243}, \'multiverseid\': 482243}]', "[{'name': 'Yidaro, das wandernde Monster', 'text': 'Verursacht Trampelschaden, Eile\\nUmwandlung {1}{R}\\nWenn du Yidaro, das wandernde Monster, umwandelst, mische es aus deinem Friedhof in deine Bibliothek. Falls du in dieser Partie vier Mal oder öfter eine Karte namens Yidaro, das wandernde Monster, umgewandelt hast, bringe sie stattdessen aus deinem Friedhof ins Spiel. (Ziehe erst danach eine Karte.)', 'type': 'Legendäre Kreatur — Dinosaurier, Schildkröte', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479920&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e2f5ad90-42a2-4236-a8b0-350250968494', 'multiverseId': 479920}, 'multiverseid': 479920}, {'name': 'Yidaro, el Monstruo Errante', 'text': 'Arrolla, prisa.\\nCiclo {1}{R}.\\nCuando actives la habilidad de ciclo de Yidaro, el Monstruo Errante, barájalo en tu biblioteca desde tu cementerio. Si has activado una habilidad de ciclo de una carta llamada Yidaro, el Monstruo Errante cuatro o más veces este juego, en vez de eso, ponlo en el campo de batalla desde tu cementerio. (Haz esto antes de robar.)', 'type': 'Criatura legendaria — Tortuga dinosaurio', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480179&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '9512d5f3-ce37-4122-b671-6df63e54f038', 'multiverseId': 480179}, 'multiverseid': 480179}, {'name': 'Yidaro, monstre errant', 'text': 'Piétinement, célérité\\nRecyclage {1}{R}\\nQuand vous recyclez Yidaro, monstre errant, mélangez-le dans votre bibliothèque depuis votre cimetière. Si vous avez recyclé une carte appelée Yidaro, monstre errant au moins quatre fois pendant cette partie, mettez-la sur le champ de bataille depuis votre cimetière à la place. (Faites ceci avant de piocher.)', 'type': 'Créature légendaire : dinosaure et tortue terrestre', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480438&type=card', 'language': 'French', 'identifiers': {'scryfallId': '0a5537be-05d3-4270-ade3-638d0ab17c46', 'multiverseId': 480438}, 'multiverseid': 480438}, {'name': 'Yidaro, Mostro Errante', 'text': 'Travolgere, rapidità\\nCiclo {1}{R}\\nQuando cicli Yidaro, Mostro Errante, rimescolalo nel tuo grimorio dal tuo cimitero. Se hai ciclato una carta chiamata Yidaro, Mostro Errante quattro o più volte in questa partita, mettila invece sul campo di battaglia dal tuo cimitero. (Devi farlo prima di pescare.)', 'type': 'Creatura Leggendaria — Tartaruga Dinosauro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480697&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '74e29689-fe47-4c58-beea-a573d3bcce3e', 'multiverseId': 480697}, 'multiverseid': 480697}, {'name': 'さまよう怪物、イダーロ', 'text': 'トランプル、速攻\\nサイクリング{1}{R}\\nあなたがさまよう怪物、イダーロをサイクリングしたとき、これをあなたの墓地からライブラリーに加えて切り直す。あなたがこのゲームで「さまよう怪物、イダーロ」という名前のカードを４回以上サイクリングしていたなら、代わりに、これをあなたの墓地から戦場に出す。（これはあなたがカードを引く前に行う。）', 'type': '伝説のクリーチャー — 恐竜・海亀', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480956&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'cd6ab2e8-1ff7-4d50-b3ad-639beb378e0a', 'multiverseId': 480956}, 'multiverseid': 480956}, {'name': '떠도는 괴수, 이다로', 'text': '돌진, 신속\\n순환 {1}{R}\\n당신이 떠도는 괴수, 이다로를 순환할 때, 떠도는 괴수, 이다로를 당신의 무덤에서 당신의 서고로 섞어 넣는다. 당신이 이번 게임에 이름이 떠도는 괴수, 이다로인 카드를 네 번 이상 순환했다면, 대신 떠도는 괴수, 이다로를 당신의 무덤에서 전장에 놓는다. (카드를 뽑기 전에 이 행동을 한다.)', 'type': '전설적 생물 — 공룡 거북이', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481215&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '7d539185-ea10-49ea-b829-876214c12654', 'multiverseId': 481215}, 'multiverseid': 481215}, {'name': 'Yidaro, Monstro Errante', 'text': 'Atropelar, ímpeto\\nReciclar {1}{R}\\nQuando reciclar Yidaro, Monstro Errante, embaralhe-o em seu grimório do seu cemitério. Se você reciclou um card com o nome Yidaro, Monstro Errante, quatro ou mais vezes neste jogo, em vez disso, coloque-o no campo de batalha do seu cemitério. (Faça isso antes de comprar.)', 'type': 'Criatura Lendária — Dinossauro Tartaruga', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481474&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'dbff58f6-e457-4142-8492-16530031112f', 'multiverseId': 481474}, 'multiverseid': 481474}, {'name': 'Идаро, Бродячее Чудовище', 'text': 'Пробивной удар, Ускорение\\nЦикл {1}{R}\\nКогда вы совершаете Цикл Идаро, Бродячего Чудовища, втасуйте его из вашего кладбища в вашу библиотеку. Если вы совершили Цикл карты с именем Идаро, Бродячее Чудовище не менее четырех раз в этой партии, вместо этого положите его из вашего кладбища на поле битвы. (Сделайте это до того, как возьмете карту.)', 'type': 'Легендарное Существо — Динозавр Черепаха', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481733&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'c2074b6d-8a35-4237-8224-1f40eeb15d50', 'multiverseId': 481733}, 'multiverseid': 481733}, {'name': '游荡怪兽依达罗', 'text': '践踏，敏捷\\n循环{1}{R}\\n当你循环游荡怪兽依达罗时，将它从你的坟墓场洗入你的牌库。若本盘游戏中你已将名称为游荡怪兽依达罗的牌循环过四次或更多，则改为将它从你的坟墓场放进战场。（先如此作后再抓牌。）', 'type': '传奇生物 ～恐龙／龟', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481992&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f8023eba-a1a4-4594-8cab-0e901ee9123f', 'multiverseId': 481992}, 'multiverseid': 481992}, {'name': '遊蕩怪獸依達羅', 'text': '踐踏，敏捷\\n循環{1}{R}\\n當你循環遊蕩怪獸依達羅時，將它從你的墳墓場洗入你的牌庫。若本盤遊戲中你已將名稱為遊蕩怪獸依達羅的牌循環過四次或更多，則改為將它從你的墳墓場放進戰場。（先如此作後再抽牌。）', 'type': '傳奇生物 ～恐龍／龜', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482251&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '63c6e50d-fba0-4468-8956-0319f39998fa', 'multiverseId': 482251}, 'multiverseid': 482251}]", "[{'name': 'Yidaro, das wandernde Monster', 'text': 'Verursacht Trampelschaden, Eile\\nUmwandlung {1}{R}\\nWenn du Yidaro, das wandernde Monster, umwandelst, mische es aus deinem Friedhof in deine Bibliothek. Falls du in dieser Partie vier Mal oder öfter eine Karte namens Yidaro, das wandernde Monster, umgewandelt hast, bringe sie stattdessen aus deinem Friedhof ins Spiel.', 'type': 'Legendäre Kreatur — Dinosaurier, Schildkröte', 'flavor': 'Godzilla, unausweichlicher Untergang', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482388&type=card', 'language': 'German', 'identifiers': {'scryfallId': '6f54d1dd-d252-4dc0-a0a2-e3585500cfee', 'multiverseId': 482388}, 'multiverseid': 482388}, {'name': 'Yidaro, el Monstruo Errante', 'text': 'Arrolla, prisa.\\nCiclo {1}{R}.\\nCuando actives la habilidad de ciclo de Yidaro, el Monstruo Errante, barájalo en tu biblioteca desde tu cementerio. Si has activado una habilidad de ciclo de una carta llamada Yidaro, el Monstruo Errante cuatro o más veces este juego, en vez de eso, ponlo en el campo de batalla desde tu cementerio.', 'type': 'Criatura legendaria — Tortuga dinosaurio', 'flavor': 'Godzilla, perdición inevitable', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482402&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '2d46c8fc-4ac1-4a04-a0e0-a6913202a22b', 'multiverseId': 482402}, 'multiverseid': 482402}, {'name': 'Yidaro, monstre errant', 'text': 'Piétinement, célérité\\nRecyclage {1}{R}\\nQuand vous recyclez Yidaro, monstre errant, mélangez-le dans votre bibliothèque depuis votre cimetière. Si vous avez recyclé une carte appelée Yidaro, monstre errant au moins quatre fois pendant cette partie, mettez-la sur le champ de bataille depuis votre cimetière à la place.', 'type': 'Créature légendaire : dinosaure et tortue terrestre', 'flavor': 'Godzilla, apocalypse inéluctable', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482416&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'cc760847-3424-4818-9765-e8445b438d01', 'multiverseId': 482416}, 'multiverseid': 482416}, {'name': 'Yidaro, Mostro Errante', 'text': 'Travolgere, rapidità\\nCiclo {1}{R}\\nQuando cicli Yidaro, Mostro Errante, rimescolalo nel tuo grimorio dal tuo cimitero. Se hai ciclato una carta chiamata Yidaro, Mostro Errante quattro o più volte in questa partita, mettila invece sul campo di battaglia dal tuo cimitero.', 'type': 'Creatura Leggendaria — Tartaruga Dinosauro', 'flavor': 'Godzilla, Destino Inevitabile', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482430&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '4f7595a2-a56c-4a8c-81bf-e1c7dfb4d273', 'multiverseId': 482430}, 'multiverseid': 482430}, {'name': 'さまよう怪物、イダーロ', 'text': 'トランプル、速攻\\nサイクリング{1}{R}\\nあなたがさまよう怪物、イダーロをサイクリングしたとき、これをあなたの墓地からあなたのライブラリーに加えて切り直す。あなたがこのゲームで「さまよう怪物、イダーロ」という名前のカードを４回以上サイクリングしていたなら、代わりに、これをあなたの墓地から戦場に出す。', 'type': '伝説のクリーチャー — 恐竜・海亀', 'flavor': '逃（のが）れ得（え）ぬ災（さい）厄（やく）、ゴジラ', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482444&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '0eaf33e2-02fc-4357-95b1-9ec4e3406a9c', 'multiverseId': 482444}, 'multiverseid': 482444}, {'name': '떠도는 괴수, 이다로', 'text': '돌진, 신속\\n순환 {1}{R}\\n당신이 떠도는 괴수, 이다로를 순환할 때, 떠도는 괴수, 이다로를 당신의 무덤에서 당신의 서고로 섞어 넣는다. 당신이 이번 게임에 이름이 떠도는 괴수, 이다로인 카드를 네 번 이상 순환했다면, 대신 떠도는 괴수, 이다로를 당신의 무덤에서 전장에 놓는다.', 'type': '전설적 생물 — 공룡 거북이', 'flavor': '피할 수 없는 파멸, 고질라', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482458&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '40abd0c5-9cc7-47b1-8917-c2c892ce8f49', 'multiverseId': 482458}, 'multiverseid': 482458}, {'name': 'Yidaro, Monstro Errante', 'text': 'Atropelar, ímpeto\\nReciclar {1}{R}\\nQuando reciclar Yidaro, Monstro Errante, embaralhe-o em seu grimório do seu cemitério. Se você reciclou um card com o nome Yidaro, Monstro Errante, quatro ou mais vezes neste jogo, em vez disso, coloque-o no campo de batalha do seu cemitério.', 'type': 'Criatura Lendária — Dinossauro Tartaruga', 'flavor': 'Godzilla, Inevitável Perdição', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482472&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'aa10b113-0cc7-44b5-85bc-71c962326f4b', 'multiverseId': 482472}, 'multiverseid': 482472}, {'name': 'Идаро, Бродячее Чудовище', 'text': 'Пробивной удар, Ускорение\\nЦикл {1}{R}\\nКогда вы совершаете Цикл Идаро, Бродячего Чудовища, втасуйте его из вашего кладбища в вашу библиотеку. Если вы совершили Цикл карты с именем Идаро, Бродячее Чудовище не менее четырех раз в этой партии, вместо этого положите его из вашего кладбища на поле битвы.', 'type': 'Легендарное Существо — Динозавр Черепаха', 'flavor': 'Годзилла, Неумолимая Гибель', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482486&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '23a13929-795d-47d8-a6fb-982c2a5a4e00', 'multiverseId': 482486}, 'multiverseid': 482486}, {'name': '游荡怪兽依达罗', 'text': '践踏，敏捷\\n循环{1}{R}\\n当你循环游荡怪兽依达罗时，将它从你的坟墓场洗入你的牌库。若本盘游戏中你已将名称为游荡怪兽依达罗的牌循环过四次或更多，则改为将它从你的坟墓场放进战场。', 'type': '传奇生物 ～恐龙／龟', 'flavor': '命定灾厄哥斯拉', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482500&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'bd471fd1-cd61-4ecf-a6ec-edd6f85fdc20', 'multiverseId': 482500}, 'multiverseid': 482500}, {'name': '遊蕩怪獸依達羅', 'text': '踐踏，敏捷\\n循環{1}{R}\\n當你循環遊蕩怪獸依達羅時，將它從你的墳墓場洗入你的牌庫。若本盤遊戲中你已將名稱為遊蕩怪獸依達羅的牌循環過四次或更多，則改為將它從你的墳墓場放進戰場。', 'type': '傳奇生物 ～恐龍／龜', 'flavor': '命定災厄哥吉拉', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482514&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'aebc9545-fc48-40cc-8ca6-21fbed4abeae', 'multiverseId': 482514}, 'multiverseid': 482514}]", '[{\'name\': \'Yorion der Himmelsnomade\', \'text\': \'Gefährte — Dein Startdeck enthält mindestens zwanzig Karten mehr als die minimale Deckgröße. (Falls du diese Karte als deinen Gefährten erwählt hast, kannst du sie einmal von außerhalb der Partie wirken.)\\nFliegend\\nWenn Yorion ins Spiel kommt, schicke eine beliebige Anzahl an anderen bleibenden Karten, die keine Länder sind und die du besitzt und kontrollierst, ins Exil. Bringe sie zu Beginn des nächsten Endsegments ins Spiel zurück.\', \'type\': \'Legendäre Kreatur — Vogel, Schlange\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480011&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'27d894c4-dd86-4117-92ff-eeedffc91601\', \'multiverseId\': 480011}, \'multiverseid\': 480011}, {\'name\': \'Yorion, Nómada del Cielo\', \'text\': \'Compañero — Tu mazo inicial contiene al menos veinte cartas más que el tamaño mínimo de mazo. (Si esta carta es el compañero que eliges, puedes lanzarla una vez desde fuera del juego.)\\nVuela.\\nCuando Yorion entre al campo de batalla, exilia cualquier cantidad de otros permanentes que no sean tierra de los que eres propietario y controlas. Regresa esas cartas al campo de batalla al comienzo del próximo paso final.\', \'type\': \'Criatura legendaria — Serpiente ave\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480270&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9a0beca3-523a-4c52-bd51-c30d082f3f3a\', \'multiverseId\': 480270}, \'multiverseid\': 480270}, {\'name\': \'Yorion, nomade céleste\', \'text\': "Compagnon — Votre deck de départ contient au moins vingt cartes de plus que la taille de deck minimale. (Si cette carte est le compagnon de votre choix, vous pouvez la lancer une fois depuis l\'extérieur de la partie.)\\nVol\\nQuand Yorion arrive sur le champ de bataille, exilez n\'importe quel nombre d\'autres permanents non-terrain que vous possédez et que vous contrôlez. Renvoyez ces cartes sur le champ de bataille au début de la prochaine étape de fin.", \'type\': \'Créature légendaire : oiseau et grand serpent\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480529&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f0fb271f-b86e-438d-9c6b-970dd885fffb\', \'multiverseId\': 480529}, \'multiverseid\': 480529}, {\'name\': \'Yorion, Nomade dei Cieli\', \'text\': "Compagno — Il tuo mazzo iniziale contiene almeno venti carte in più della dimensione minima del mazzo. (Se questa carta è il compagno che hai scelto, puoi lanciarla una volta dal di fuori della partita.)\\nVolare\\nQuando Yorion entra nel campo di battaglia, esilia un qualsiasi numero di altri permanenti non terra che possiedi e controlli. Rimetti quelle carte sul campo di battaglia all\'inizio della prossima sottofase finale.", \'type\': \'Creatura Leggendaria — Serpe Uccello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480788&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'917a2a87-e7ad-4015-8b54-9963cdd92e17\', \'multiverseId\': 480788}, \'multiverseid\': 480788}, {\'name\': \'空を放浪するもの、ヨーリオン\', \'text\': \'相棒 ― あなたの開始時のデッキに、カードが、デッキの最小サイズよりも少なくとも20枚多く入っていること。（このカードがあなたの選んだ相棒であるなら、あなたは１回のみゲームの外部からこれを唱えてもよい。）\\n飛行\\n空を放浪するもの、ヨーリオンが戦場に出たとき、他の、あなたがオーナーであってあなたがコントロールしていて土地でない、望む数のパーマネントを追放する。次の終了ステップの開始時に、それらのカードを戦場に戻す。\', \'type\': \'伝説のクリーチャー — 鳥・海蛇\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481047&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3e61f3fe-ad5d-473e-914c-e2748de701ec\', \'multiverseId\': 481047}, \'multiverseid\': 481047}, {\'name\': \'창공 유목민, 요리온\', \'text\': \'단짝 — 당신의 시작 덱은 최소 덱 크기보다 최소한 20장이 더 많다. (이 카드가 당신이 선택한 단짝이라면, 당신은 이 카드를 게임 밖에서 한 번 발동할 수 있다.)\\n비행\\n요리온이 전장에 들어올 때, 당신이 소유하고 조종하는 다른 대지가 아닌 지속물들을 원하는 수만큼 추방한다. 다음 종료단 시작에 그 카드들을 전장으로 되돌린다.\', \'type\': \'전설적 생물 — 조류 이무기\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481306&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d96f588d-d5c0-44be-af50-03267cd302b1\', \'multiverseId\': 481306}, \'multiverseid\': 481306}, {\'name\': \'Yorion, Nômade Celeste\', \'text\': \'Companheiro — Seu deck inicial contém ao menos vinte cards além do tamanho mínimo do deck. (Se este card for o companheiro que escolheu, você poderá conjurá-lo uma vez de fora do jogo.)\\nVoar\\nQuando Yorion entra no campo de batalha, exile qualquer número de outras permanentes que não sejam terrenos que você possui e controla. Devolva aqueles cards ao campo de batalha no início da próxima etapa final.\', \'type\': \'Criatura Lendária — Ave Serpente\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481565&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c842c8a8-0e29-4cc6-bd59-9d085680b124\', \'multiverseId\': 481565}, \'multiverseid\': 481565}, {\'name\': \'Йорион, Небесный Скиталец\', \'text\': \'Компаньон — Размер вашей начальной колоды как минимум на двадцать карт превышает минимальный. (Если эта карта является вашим избранным Компаньоном, то вы можете один раз разыграть ее из-за пределов игры.)\\nПолет\\nКогда Йорион выходит на поле битвы, изгоните любое количество других принадлежащих вам не являющихся землями перманентов под вашим контролем. Верните те карты на поле битвы в начале следующего заключительного шага.\', \'type\': \'Легендарное Существо — Птица Змей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481824&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3b51586c-c355-4e53-b71f-08a176371292\', \'multiverseId\': 481824}, \'multiverseid\': 481824}, {\'name\': \'游空牧鸟约力昂\', \'text\': \'行侣～你起始套牌中包含之牌张数量须比套牌数量下限多至少二十张。（如果你选择这张牌作为你的行侣，则你可以从游戏外施放它，但仅限一次。）\\n飞行\\n当约力昂进战场时，放逐任意数量由你拥有且操控的其他非地永久物。在下一个结束步骤开始时，将这些牌移回战场。\', \'type\': \'传奇生物 ～鸟／巨蛇\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482083&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cada880a-be15-4fa0-9e36-1a8cca3fe98c\', \'multiverseId\': 482083}, \'multiverseid\': 482083}, {\'name\': \'遊空牧鳥約力昂\', \'text\': \'行侶～你起始套牌中包含之牌張數量須比套牌數量下限多至少二十張。（如果你選擇這張牌作為你的行侶，則你可以從遊戲外施放它，但僅限一次。）\\n飛行\\n當約力昂進戰場時，放逐任意數量由你擁有且操控的其他非地永久物。在下一個結束步驟開始時，將這些牌移回戰場。\', \'type\': \'傳奇生物 ～鳥／巨蛇\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482342&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'27c8ab04-40ce-4206-b0dc-2eca1ba35e93\', \'multiverseId\': 482342}, \'multiverseid\': 482342}]', "[{'name': 'Zackenskorpion', 'text': 'Wenn der Zackenskorpion stirbt, fügt er jedem Gegner 2 Schadenspunkte zu und du erhältst 2 Lebenspunkte dazu.', 'type': 'Kreatur — Skorpion', 'flavor': 'Jedes Skorpiongift ist einzigartig und vereitelt die Pläne der Heiler in den Zufluchtsorten, ein Gegengift zu entwickeln.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479878&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0a577fc8-7d52-4b62-847e-d7516136a7d1', 'multiverseId': 479878}, 'multiverseid': 479878}, {'name': 'Escorpión dentellado', 'text': 'Cuando el Escorpión dentellado muera, hace 2 puntos de daño a cada oponente y tú ganas 2 vidas.', 'type': 'Criatura — Escorpión', 'flavor': 'El veneno de cada escorpión es único, lo que impide que los sanadores de los santuarios consigan un antídoto.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480137&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'fbf5983a-711c-44d8-948a-359df5c06b5c', 'multiverseId': 480137}, 'multiverseid': 480137}, {'name': 'Scorpion barbelé', 'text': 'Quand le Scorpion barbelé meurt, il inflige 2 blessures à chaque adversaire et vous gagnez 2 points de vie.', 'type': 'Créature : scorpion', 'flavor': 'Le venin de chaque scorpion est unique, ce qui empêche les guérisseurs du sanctuaire de trouver un antidote.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480396&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2a89ae28-bc1e-4bd0-8354-636692e5d50a', 'multiverseId': 480396}, 'multiverseid': 480396}, {'name': 'Scorpione Dentellato', 'text': 'Quando lo Scorpione Dentellato muore, infligge 2 danni a ogni avversario e tu guadagni 2 punti vita.', 'type': 'Creatura — Scorpione', 'flavor': 'Il veleno di ogni scorpione è unico, rendendo vani i tentativi dei guaritori del santuario di sviluppare un antidoto.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480655&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c6e882b9-9187-41c2-b37c-c3ccc73ba151', 'multiverseId': 480655}, 'multiverseid': 480655}, {'name': '鋸刃蠍', 'text': '鋸刃蠍が死亡したとき、これは各対戦相手にそれぞれ２点のダメージを与え、あなたは２点のライフを得る。', 'type': 'クリーチャー — 蠍', 'flavor': '蠍の持つ毒がそれぞれ異なるために、聖域の癒し手は解毒剤を作れずにいる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480914&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '717bcd7d-c903-4819-b8d8-7dcdebf7347c', 'multiverseId': 480914}, 'multiverseid': 480914}, {'name': '톱니 전갈', 'text': '톱니 전갈이 죽을 때, 톱니 전갈은 각 상대에게 피해 2점을 입히고 당신은 생명 2점을 얻는다.', 'type': '생물 — 전갈', 'flavor': '전갈의 독은 각각이 독특해서, 해독제를 개발하려는 성소 치유사들의 시도를 좌절시킨다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481173&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '76a5f6fa-ed67-4c69-b1cb-02647b77d6c7', 'multiverseId': 481173}, 'multiverseid': 481173}, {'name': 'Escorpião Serrilhado', 'text': 'Quando Escorpião Serrilhado morre, ele causa 2 pontos de dano a cada oponente e você ganha 2 pontos de vida.', 'type': 'Criatura — Escorpião', 'flavor': 'O veneno de cada escorpião é único, frustrando os esforços dos curandeiros dos santuários para desenvolver um antídoto.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481432&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '35b0f6fc-10f6-4619-a5bf-dcb9c1e02055', 'multiverseId': 481432}, 'multiverseid': 481432}, {'name': 'Зазубренный Скорпион', 'text': 'Когда Зазубренный Скорпион умирает, он наносит по 2 повреждения каждому оппоненту, а вы получаете 2 жизни.', 'type': 'Существо — Скорпион', 'flavor': 'У каждого скорпиона свой уникальный яд, так что целители из убежища не могут найти для него противоядие.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481691&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '973526e0-b054-4111-81c3-298e87ec434d', 'multiverseId': 481691}, 'multiverseid': 481691}, {'name': '锯尾蝎', 'text': '当锯尾蝎死去时，它向每位对手各造成2点伤害，且你获得2点生命。', 'type': '生物 ～蝎子', 'flavor': '每只蝎子的毒液都与众不同，令庇护地治疗师的解药研究停滞不前。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481950&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '335b7bc8-9d73-4bb2-8160-b2e224583bf3', 'multiverseId': 481950}, 'multiverseid': 481950}, {'name': '鋸尾蠍', 'text': '當鋸尾蠍死去時，它向每位對手各造成2點傷害，且你獲得2點生命。', 'type': '生物 ～蠍子', 'flavor': '每隻蠍子的毒液都與眾不同，令庇護地治療師的解藥研究停滯不前。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482209&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '3eb10a35-afec-4937-80cd-721ccae1978e', 'multiverseId': 482209}, 'multiverseid': 482209}]", '[{\'name\': \'Zaghafte Verbindung\', \'text\': \'Dieser Zauberspruch kostet beim Wirken {3} weniger, falls du eine Kreatur mit Bedrohlichkeit kontrollierst.\\nÜbernimm bis zum Ende des Zuges die Kontrolle über eine Kreatur deiner Wahl. Enttappe die Kreatur. Sie erhält Eile bis zum Ende des Zuges.\', \'type\': \'Hexerei\', \'flavor\': \'Lukka erhielt den Befehl, die Bedrohung zu töten. Er entschied, sie sich zum Freund zu machen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479917&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'34dea48b-422f-41f3-9581-d7d41d4c1fa4\', \'multiverseId\': 479917}, \'multiverseid\': 479917}, {\'name\': \'Conexión tentativa\', \'text\': \'Te cuesta {3} menos lanzar este hechizo si controlas una criatura con la habilidad de amenaza.\\nGana el control de la criatura objetivo hasta el final del turno. Endereza esa criatura. Gana la habilidad de prisa hasta el final del turno.\', \'type\': \'Conjuro\', \'flavor\': \'A Lukka le ordenaron acabar con una amenaza. Él prefirió hacer un amigo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480176&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'30a09fc6-449f-4b5c-9264-6e3cc6af41ca\', \'multiverseId\': 480176}, \'multiverseid\': 480176}, {\'name\': \'Connexion hésitante\', \'text\': "Ce sort coûte {3} de moins à lancer si vous contrôlez une créature avec la menace.\\nAcquérez le contrôle de la créature ciblée jusqu\'à la fin du tour. Dégagez cette créature. Elle acquiert la célérité jusqu\'à la fin du tour.", \'type\': \'Rituel\', \'flavor\': "Lukka reçut l\'ordre d\'éliminer une menace. Il préféra se faire un ami.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480435&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'72934b34-d762-48bc-a111-349515a1cf90\', \'multiverseId\': 480435}, \'multiverseid\': 480435}, {\'name\': \'Tentativo di Avvicinamento\', \'text\': \'Questa magia costa {3} in meno per essere lanciata se controlli una creatura con minacciare.\\nPrendi il controllo di una creatura bersaglio fino alla fine del turno. STAPpa quella creatura. Ha rapidità fino alla fine del turno.\', \'type\': \'Stregoneria\', \'flavor\': \'A Lukka venne ordinato di uccidere una minaccia. Scelse invece di farsi un amico.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480694&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1e00ed3b-079d-4c4e-ab60-3a23823306f6\', \'multiverseId\': 480694}, \'multiverseid\': 480694}, {\'name\': \'一時的な連帯\', \'text\': \'あなたが威迫を持つクリーチャーをコントロールしているなら、この呪文を唱えるためのコストは{3}少なくなる。\\nクリーチャー１体を対象とする。ターン終了時まで、それのコントロールを得る。そのクリーチャーをアンタップする。ターン終了時まで、それは速攻を得る。\', \'type\': \'ソーサリー\', \'flavor\': \'ルーカは脅威の始末を命じられたが、友達を作ることを選んだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480953&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ceae4d18-5306-4569-8bfe-643d5f810607\', \'multiverseId\': 480953}, \'multiverseid\': 480953}, {\'name\': \'잠정적인 관계\', \'text\': \'당신이 호전적을 가진 생물을 조종한다면 이 주문은 발동하는 데 {3}이 덜 든다.\\n생물을 목표로 정한다. 턴종료까지 그 생물의 조종권을 얻는다. 그 생물은 언탭되고 턴종료까지 신속을 얻는다.\', \'type\': \'집중마법\', \'flavor\': \'루카는 위협을 죽이라고 명령받았다. 그는 친구를 만들기로 했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481212&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'73edef2b-831e-4dc6-ac83-2e8b22e9c45b\', \'multiverseId\': 481212}, \'multiverseid\': 481212}, {\'name\': \'Conexão Hesitante\', \'text\': \'Esta mágica custa {3} a menos para ser conjurada se você controla uma criatura com ameaçar.\\nGanhe o controle da criatura alvo até o final do turno. Desvire aquela criatura. Ela ganha ímpeto até o final do turno.\', \'type\': \'Feitiço\', \'flavor\': \'Lukka recebeu ordens para eliminar uma ameaça. Ele escolheu fazer um amigo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481471&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'88478b8e-1a04-463f-871d-2c86b86e8f06\', \'multiverseId\': 481471}, \'multiverseid\': 481471}, {\'name\': \'Неуверенная Связь\', \'text\': \'Разыгрывание этого заклинания стоит на {3} меньше, если вы контролируете существо с Угрозой.\\nПолучите контроль над целевым существом до конца хода. Разверните то существо. Оно получает Ускорение до конца хода.\', \'type\': \'Волшебство\', \'flavor\': \'Лукке приказали убить врага. Он выбрал завести друга.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481730&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'93927462-e65b-46df-8a87-ea1b55486d4a\', \'multiverseId\': 481730}, \'multiverseid\': 481730}, {\'name\': \'暂时性联系\', \'text\': \'如果你操控具威慑异能的生物，则此咒语减少{3}来施放。\\n获得目标生物的操控权直到回合结束。重置该生物。它获得敏捷异能直到回合结束。\', \'type\': \'法术\', \'flavor\': \'卢卡受命猎杀威胁。他选择结交朋友。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481989&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7ae1e755-2cab-43be-96a8-b0c9f0bcee7c\', \'multiverseId\': 481989}, \'multiverseid\': 481989}, {\'name\': \'暫時性聯繫\', \'text\': \'如果你操控具威懾異能的生物，則此咒語減少{3}來施放。\\n獲得目標生物的操控權直到回合結束。重置該生物。它獲得敏捷異能直到回合結束。\', \'type\': \'巫術\', \'flavor\': \'盧卡受命獵殺威脅。他選擇結交朋友。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482248&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'98afabde-dea5-4253-9c68-df5a5895d1c6\', \'multiverseId\': 482248}, \'multiverseid\': 482248}]', "[{'name': 'Zagoth-Kristall', 'text': '{T}: Erzeuge {B}, {G} oder {U}.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)', 'type': 'Artefakt', 'flavor': 'Aus dem fruchtbaren Schlamm von Zagoth wächst alles — Tiere, Pflanzen und Kristalle von rauer Schönheit.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480021&type=card', 'language': 'German', 'identifiers': {'scryfallId': '7c60d184-1a4d-454f-9ad6-18b58625b392', 'multiverseId': 480021}, 'multiverseid': 480021}, {'name': 'Cristal de Zagoth', 'text': '{T}: Agrega {B}, {G} o {U}.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)', 'type': 'Artefacto', 'flavor': 'Del fértil barro de Zagoth, los animales, las plantas y los cristales crecen con una belleza irregular.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480280&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e6d9c05c-dd33-4571-983b-6c8c1e50db27', 'multiverseId': 480280}, 'multiverseid': 480280}, {'name': 'Cristal de Zagoth', 'text': '{T} : Ajoutez {B}, {G} ou {U}.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)', 'type': 'Artefact', 'flavor': 'Toute la beauté rustique de Zagoth, animale, végétale ou cristalline, est née de sa boue fertile.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480539&type=card', 'language': 'French', 'identifiers': {'scryfallId': '6a66bbfe-8daf-40b0-9840-1ef2b30c9b66', 'multiverseId': 480539}, 'multiverseid': 480539}, {'name': 'Cristallo di Zagoth', 'text': '{T}: Aggiungi {B}, {G} o {U}.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)', 'type': 'Artefatto', 'flavor': 'Dal fertile marciume di Zagoth, tutto nel regno animale, vegetale e cristallino cresce con aspra bellezza.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480798&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'f14b967c-a46e-4f97-a2e6-31f283dbf598', 'multiverseId': 480798}, 'multiverseid': 480798}, {'name': 'ゼイゴスの水晶', 'text': '{T}：{B}か{G}か{U}を加える。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）', 'type': 'アーティファクト', 'flavor': 'ゼイゴスの肥沃な土壌は、すべてのものに頑強な美を育てる。動物にも、植物にも、水晶にも。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481057&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'bb4ac72e-8eb9-47b2-b21c-6aa55372dd44', 'multiverseId': 481057}, 'multiverseid': 481057}, {'name': '자고스 수정', 'text': '{T}: {B}, {G}, 또는 {U}를 추가한다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)', 'type': '마법물체', 'flavor': '자고스의 비옥한 늪지 속에서는, 모든 것이—동물, 식물, 그리고 수정마저도—투박한 아름다움을 띠며 자라난다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481316&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'cf491661-1d8b-4c93-a5f5-6aa7477625ec', 'multiverseId': 481316}, 'multiverseid': 481316}, {'name': 'Cristal de Zagoth', 'text': '{T}: Adicione {B}, {G} ou {U}.\\nReciclar {2} ({2}, descarte este card: Compre um card.)', 'type': 'Artefato', 'flavor': 'Tudo que nasce da lama fértil de Zagoth, seja de natureza animal, vegetal ou cristalina, apresenta uma beleza de traços escarpados.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481575&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '18e520ab-3c2a-4358-8f13-513891f6a173', 'multiverseId': 481575}, 'multiverseid': 481575}, {'name': 'Кристалл Загота', 'text': '{T}: добавьте {B}, {G} или {U}.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)', 'type': 'Артефакт', 'flavor': 'В плодородной грязи Загота всё — животные, растения и кристаллы — растёт, набираясь грубой красоты.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481834&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '06c523d5-caa1-466f-a8b1-3af0118b5053', 'multiverseId': 481834}, 'multiverseid': 481834}, {'name': '札苟斯水晶', 'text': '{T}：加{B}，{G}或{U}。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）', 'type': '神器', 'flavor': '札苟斯有着肥沃泥地，令此间万物～动物、植物甚至水晶～都孕育出粗犷美感。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482093&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'eb580a4f-d5e8-4c12-a70b-d2389dfcc1eb', 'multiverseId': 482093}, 'multiverseid': 482093}, {'name': '札苟斯水晶', 'text': '{T}：加{B}，{G}或{U}。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）', 'type': '神器', 'flavor': '札苟斯有著肥沃泥地，令此間萬物～動物、植物甚至水晶～都孕育出粗獷美感。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482352&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '0f1f77eb-9765-48af-bf20-77da28426ff2', 'multiverseId': 482352}, 'multiverseid': 482352}]", '[{\'name\': \'Zagoth-Mamba\', \'text\': \'Immer wenn diese Kreatur mutiert, erhält eine Kreatur deiner Wahl, die ein Gegner kontrolliert, -2/-2 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Nachtmahr, Ophis\', \'flavor\': \'„Es ist nur eine Schlange. Eine vieläugige Schlange mit Gift, das dein Blut in Rauch verwandelt, aber trotzdem nur eine Schlange."\\n—Kinnan, Bynder-Naturtalent\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479885&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1f7cbd3d-a01b-439d-89e6-c1972dd8e981\', \'multiverseId\': 479885}, \'multiverseid\': 479885}, {\'name\': \'Mamba de Zagoth\', \'text\': \'Siempre que esta criatura mute, la criatura objetivo que controla un oponente obtiene -2/-2 hasta el final del turno.\', \'type\': \'Criatura — Víbora pesadilla\', \'flavor\': \'"Solo es una serpiente. Una serpiente con muchos ojos y un veneno que convierte tu sangre en humo. Pero, aun así, solo una serpiente".\\n—Kinnan, el Vinculador Prodigioso\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480144&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'03b91bf8-1dd3-4134-ae3a-d3ab29c4ba90\', \'multiverseId\': 480144}, \'multiverseid\': 480144}, {\'name\': \'Mamba de Zagoth\', \'text\': "À chaque fois que cette créature subit une mutation, une créature ciblée qu\'un adversaire contrôle gagne -2/-2 jusqu\'à la fin du tour.", \'type\': \'Créature : cauchemar et serpent\', \'flavor\': "« Ce n\'est qu\'un serpent. Un serpent aux yeux démultipliés et dont le venin peut vaporiser le sang, certes, mais un serpent. »\\n—Kinnan, prodige brideur", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480403&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5c5dfff0-5294-4136-a0a3-22a2360e3450\', \'multiverseId\': 480403}, \'multiverseid\': 480403}, {\'name\': \'Mamba di Zagoth\', \'text\': \'Ogniqualvolta questa creatura muta, una creatura bersaglio controllata da un avversario prende -2/-2 fino alla fine del turno.\', \'type\': \'Creatura — Serpente Incubo\', \'flavor\': \'"È solo un serpente. Un serpente con molti occhi e un veleno che trasforma il sangue in fumo, ma resta sempre un serpente."\\n—Kinnan, vincolatore prodigio\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480662&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'06bfa387-414b-4699-9dc9-039627bdac8a\', \'multiverseId\': 480662}, \'multiverseid\': 480662}, {\'name\': \'ゼイゴスのマンバ\', \'text\': \'このクリーチャーが変容するたび、対戦相手がコントロールしているクリーチャー１体を対象とする。ターン終了時まで、それは－２/－２の修整を受ける。\', \'type\': \'クリーチャー — ナイトメア・蛇\', \'flavor\': \'「これはただの蛇だ。目がたくさんあって、血を煙に変える毒を持っているが、ただの蛇には違いない。」\\n――眷者の神童、キナン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480921&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'78dc30f9-a56c-423a-a3d7-56c3867f53a7\', \'multiverseId\': 480921}, \'multiverseid\': 480921}, {\'name\': \'자고스 맘바\', \'text\': \'이 생물이 돌연변이화할 때마다, 상대가 조종하는 생물을 목표로 정한다. 그 생물은 턴종료까지 -2/-2를 받는다.\', \'type\': \'생물 — 나이트메어 뱀\', \'flavor\': \'"그냥 뱀일 뿐이야. 네 피를 연기로 만들어 버릴 독을 가진, 눈이 여러 개 달린 뱀이지만, 그냥 뱀이라고."\\n—천재 유대자, 키난\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481180&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'eb192338-6f53-489c-ba6d-2c35aa69fdf8\', \'multiverseId\': 481180}, \'multiverseid\': 481180}, {\'name\': \'Mamba de Zagoth\', \'text\': \'Toda vez que esta criatura sofre mutação, a criatura alvo que um oponente controla recebe -2/-2 até o final do turno.\', \'type\': \'Criatura — Pesadelo Cobra\', \'flavor\': \'"É só uma cobra. Uma cobra com um monte de olhos e uma peçonha que evapora o sangue, mas ainda assim... é só uma cobra."\\n— Kinnan, vinculador prodígio\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481439&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b26cddb1-c9e3-42e1-b132-96515ecf7b02\', \'multiverseId\': 481439}, \'multiverseid\': 481439}, {\'name\': \'Заготская Мамба\', \'text\': \'Каждый раз, когда это существо мутирует, целевое существо под контролем оппонента получает -2/-2 до конца хода.\', \'type\': \'Существо — Кошмар Змея\', \'flavor\': \'«Это просто змея. Многоглазая змея с ядом, превращающим в дым твою кровь, но все равно это просто змея».\\n— Киннан, одаренный узомант\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481698&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3728d33f-b0c8-44c6-b783-ddd3bad06783\', \'multiverseId\': 481698}, \'multiverseid\': 481698}, {\'name\': \'札苟斯树蛇\', \'text\': \'每当此生物合变时，目标由对手操控的生物得-2/-2直到回合结束。\', \'type\': \'生物 ～梦魇／蛇\', \'flavor\': \'「那只不过是一条蛇。虽然它长了很多眼睛，还有剧毒能将你的血液化烟散去，但它毕竟只是一条蛇。」\\n～持绊逸才季宁\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481957&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d4ca1152-eafb-4e95-92b3-00d00cd7d2e4\', \'multiverseId\': 481957}, \'multiverseid\': 481957}, {\'name\': \'札苟斯樹蛇\', \'text\': \'每當此生物合變時，目標由對手操控的生物得-2/-2直到回合結束。\', \'type\': \'生物 ～夢魘／蛇\', \'flavor\': \'「那只不過是一條蛇。雖然牠長了很多眼睛，還有劇毒能將你的血液化煙散去，但牠畢竟只是一條蛇。」\\n～持絆逸才季寧\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482216&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a086efa1-40f6-4f40-9141-1fdf25d5c7d4\', \'multiverseId\': 482216}, \'multiverseid\': 482216}]', '[{\'name\': \'Zagoth-Triom\', \'text\': \'({T}: Erzeuge {B}, {G} oder {U}.)\\nDas Zagoth-Triom kommt getappt ins Spiel.\\nUmwandlung {3} ({3}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Land — Sumpf, Wald, Insel\', \'flavor\': \'Jäger in den urzeitlichen Feuchtgebieten lesen die Wogen und wissen, wann es Zeit ist zu jagen und wann zu fliehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480038&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8d1d3717-738a-49f1-99e2-20e2b2f1f7a6\', \'multiverseId\': 480038}, \'multiverseid\': 480038}, {\'name\': \'Trioma de Zagoth\', \'text\': \'({T}: Agrega {B}, {G} o {U}.)\\nEl Trioma de Zagoth entra al campo de batalla girado.\\nCiclo {3}. ({3}, descartar esta carta: Roba una carta.)\', \'type\': \'Tierra — Pantano bosque isla\', \'flavor\': \'Los cazadores de los humedales primigenios aprenden a leer las ondas del agua para saber cuándo perseguir y cuándo huir.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480297&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'aa9c7cfe-3757-4ab1-8a83-3b6c92fb603f\', \'multiverseId\': 480297}, \'multiverseid\': 480297}, {\'name\': \'Triome de Zagoth\', \'text\': \'({T} : Ajoutez {B}, {G} ou {U}.)\\nLe Triome de Zagoth arrive sur le champ de bataille engagé.\\nRecyclage {3} ({3}, défaussez-vous de cette carte : Piochez une carte.)\', \'type\': \'Terrain : marais et forêt et île\', \'flavor\': "Les chasseurs des marais primaires apprennent à interpréter les ondulations de l\'eau pour savoir quand il faut traquer et quand il faut fuir.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480556&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5f8767fb-138b-47aa-b238-53dfdc690b96\', \'multiverseId\': 480556}, \'multiverseid\': 480556}, {\'name\': \'Trioma di Zagoth\', \'text\': \'({T}: Aggiungi {B}, {G} o {U}.)\\nIl Trioma di Zagoth entra nel campo di battaglia TAPpato.\\nCiclo {3} ({3}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Terra — Palude Foresta Isola\', \'flavor\': "I cacciatori degli acquitrini primordiali apprendono a interpretare le increspature dell\'acqua per capire quando inseguire e quando fuggire.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480815&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8e33f220-fa33-46ac-9633-a6b6bd4ae366\', \'multiverseId\': 480815}, \'multiverseid\': 480815}, {\'name\': \'ゼイゴスのトライオーム\', \'text\': \'（{T}：{B}か{G}か{U}を加える。）\\nゼイゴスのトライオームはタップ状態で戦場に出る。\\nサイクリング{3}（{3}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'土地 — 沼・森・島\', \'flavor\': \'原生湿地の狩人は、さざ波を巧みに読み、追うべきか逃げるべきか判断できるようになる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481074&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eb543082-8275-417b-9cfb-a5d863b7ee9d\', \'multiverseId\': 481074}, \'multiverseid\': 481074}, {\'name\': \'자고스 삼생물군계\', \'text\': \'({T}: {B}, {G}, 또는 {U}를 추가한다.)\\n자고스 삼생물군계는 탭된 채로 전장에 들어온다.\\n순환 {3} ({3}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'대지 — 늪 숲 섬\', \'flavor\': \'원시 습지대의 사냥꾼들은 언제 쫓아가고 언제 도망쳐야 할 지를 알려 주는 잔물결을 읽는 데 아주 능숙해진다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481333&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e9bd291f-005f-4c1b-ab59-8b06cef02254\', \'multiverseId\': 481333}, \'multiverseid\': 481333}, {\'name\': \'Trioma de Zagoth\', \'text\': \'({T}: Adicione {B}, {G} ou {U}.)\\nTrioma de Zagoth entra no campo de batalha virado.\\nReciclar {3} ({3}, descarte este card: Compre um card.)\', \'type\': \'Terreno — Pântano Floresta Ilha\', \'flavor\': \'Os caçadores dos pantanais primevos aprendem a interpretar as ondulações da água para saber quando perseguir e quando fugir.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481592&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d7a4da97-ace5-48df-94b7-4568f3f62350\', \'multiverseId\': 481592}, \'multiverseid\': 481592}, {\'name\': \'Триом Загот\', \'text\': \'({T}: добавьте {B}, {G} или {U}.)\\nТриом Загот выходит на поле битвы повернутым.\\nЦикл {3} ({3}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Земля — Болото Лес Остров\', \'flavor\': \'Охотники в этих первобытных низинах быстро учатся читать рябь на воде, подсказывающую, когда преследовать, а когда бежать.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481851&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'07156cce-d039-4f40-9222-a2228e23c1fa\', \'multiverseId\': 481851}, \'multiverseid\': 481851}, {\'name\': \'札苟斯群系\', \'text\': \'（{T}：加{B}，{G}或{U}。）\\n札苟斯群系须横置进战场。\\n循环{3}（{3}，弃掉此牌：抓一张牌。）\', \'type\': \'地 ～沼泽／树林／海岛\', \'flavor\': \'活跃于这片原始湿地的猎人们早已熟练掌握解读水面波纹，并以此判断何时该追击，何时该撤退。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482110&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9538d7dd-0431-4d66-937d-54482963a451\', \'multiverseId\': 482110}, \'multiverseid\': 482110}, {\'name\': \'札苟斯群系\', \'text\': \'（{T}：加{B}，{G}或{U}。）\\n札苟斯群系須橫置進戰場。\\n循環{3}（{3}，棄掉此牌：抽一張牌。）\', \'type\': \'地 ～沼澤／樹林／海島\', \'flavor\': \'活躍於這片原始濕地的獵人們早已熟練掌握解讀水面波紋，並以此判斷何時該追擊，何時該撤退。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482369&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'61ad7ce1-d208-4746-b2c4-37df55ac71c1\', \'multiverseId\': 482369}, \'multiverseid\': 482369}]', '[{\'name\': \'Zauberstarker Vielfraß\', \'text\': \'Der Zauberstarke Vielfraß hat Doppelschlag, solange sich drei oder mehr Spontanzauber- und/oder Hexereikarten in deinem Friedhof befinden.\', \'type\': \'Kreatur — Vielfraß\', \'flavor\': \'„Das Monster, vor dem ich mich am meisten fürchte, ist nicht das größte."\\n—Taelya, Lavagrund-Feuermagierin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479916&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2fd46b8b-91d4-4200-a374-0c57d9a1cda5\', \'multiverseId\': 479916}, \'multiverseid\': 479916}, {\'name\': \'Glotón devorahechizos\', \'text\': \'El Glotón devorahechizos tiene la habilidad de dañar dos veces mientras haya tres o más cartas de instantáneo y/o de conjuro en tu cementerio.\', \'type\': \'Criatura — Glotón\', \'flavor\': \'"El monstruo que me da más miedo no es el más grande".\\n—Taelya, piromaga de Bordelava\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480175&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7bdb51cf-49f9-414f-816a-43ef2c8fddce\', \'multiverseId\': 480175}, \'multiverseid\': 480175}, {\'name\': \'Glouton mangesort\', \'text\': "Le Glouton mangesort a la double initiative tant qu\'il y a au moins trois cartes d\'éphémère et/ou de rituel dans votre cimetière.", \'type\': \'Créature : glouton\', \'flavor\': "« Ce n\'est pas le plus gros monstre qui m\'effraie le plus. »\\n—Tælya, pyromage de Bourg-sur-Lave", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480434&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ae40ddcb-ce09-42e0-b0e2-09106ba27eff\', \'multiverseId\': 480434}, \'multiverseid\': 480434}, {\'name\': \'Ghiottone Ingoiamagie\', \'text\': \'Il Ghiottone Ingoiamagie ha doppio attacco fintanto che ci sono tre o più carte istantaneo e/o stregoneria nel tuo cimitero.\', \'type\': \'Creatura — Ghiottone\', \'flavor\': \'"Il mostro che mi spaventa di più non è il più grosso."\\n—Taelya, piromaga di Lavariva\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480693&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'70b019b6-e5d7-46b4-8a50-d2ddb74285a9\', \'multiverseId\': 480693}, \'multiverseid\': 480693}, {\'name\': \'呪文喰いクズリ\', \'text\': \'あなたの墓地にインスタントやソーサリーであるカードが３枚以上あるかぎり、呪文喰いクズリは二段攻撃を持つ。\', \'type\': \'クリーチャー — クズリ\', \'flavor\': \'「私にとって一番怖い怪物は、一番大きい怪物じゃない。」\\n――ラバブリンクの炎魔道士、テルヤ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480952&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'80994ea8-7888-4d0b-bbbd-a11e9d57d9d1\', \'multiverseId\': 480952}, \'multiverseid\': 480952}, {\'name\': \'주문포식자 울버린\', \'text\': \'주문포식자 울버린은 당신의 무덤에 순간마법 및/또는 집중마법 카드가 세 장 이상 있는 한 이단공격을 가진다.\', \'type\': \'생물 — 울버린\', \'flavor\': \'"가장 큰 괴수라고 날 가장 무섭게 하는 건 아니야."\\n—용암가장자리 화염마도사, 타엘야\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481211&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a45daaa5-bfca-4fb9-ae69-ffe04cb58871\', \'multiverseId\': 481211}, \'multiverseid\': 481211}, {\'name\': \'Carcaju Magífago\', \'text\': \'Carcaju Magífago tem golpe duplo enquanto houver três ou mais cards de mágica instantânea e/ou feitiço em seu cemitério.\', \'type\': \'Criatura — Carcaju\', \'flavor\': \'"O monstro que mais me assusta não é o maior."\\n— Taelya, piromaga de Beiralava\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481470&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3e94913e-fcc5-418a-8c31-6db8b62739c9\', \'multiverseId\': 481470}, \'multiverseid\': 481470}, {\'name\': \'Пожирающая Заклинания Росомаха\', \'text\': \'Пожирающая Заклинания Росомаха имеет Двойной удар, пока на вашем кладбище есть не менее трех карт мгновенных заклинаний и/или волшебства.\', \'type\': \'Существо — Росомаха\', \'flavor\': \'«Чудовище, которого я больше всего боюсь, вовсе не самое большое».\\n— Тэлия, пиромаг из Лавобрега\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481729&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'86404ac0-344f-4b45-a693-dbcf9b0c18b4\', \'multiverseId\': 481729}, \'multiverseid\': 481729}, {\'name\': \'噬咒狼獾\', \'text\': \'只要你坟墓场中有三张或更多的瞬间和／或法术牌，噬咒狼獾便具有连击异能。\', \'type\': \'生物 ～狼獾\', \'flavor\': \'「最令我害怕的怪兽，并非体型最大者。」\\n～熔缘城烈焰法师泰勒娅\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481988&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'68a0a001-9d0e-4c16-b9d0-cde9d9232085\', \'multiverseId\': 481988}, \'multiverseid\': 481988}, {\'name\': \'噬咒狼獾\', \'text\': \'只要你墳墓場中有三張或更多的瞬間和／或巫術牌，噬咒狼獾便具有連擊異能。\', \'type\': \'生物 ～狼獾\', \'flavor\': \'「最令我害怕的怪獸，並非體型最大者。」\\n～熔緣城烈焰法師泰勒婭\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482247&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bcb0d5b0-1065-484d-8084-1353352a136e\', \'multiverseId\': 482247}, \'multiverseid\': 482247}]', '[{\'name\': \'Zenit des Leuchtfeuers\', \'text\': \'Der Zenit des Leuchtfeuers fügt einem Ziel deiner Wahl X Schadenspunkte zu und du erhältst X Lebenspunkte dazu, wobei X gleich der Anzahl an Karten mit einer Umwandlung-Fähigkeit in deinem Friedhof ist.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ich fordere die Welt heraus, unsere Verteidigung zu testen. Holt Pterons und Luftkatzen. Holt Vadrok!"\\n—Janae, Architektin der Kupferjacken\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479996&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ebdafa99-8fea-4e77-9581-51b5207b4a53\', \'multiverseId\': 479996}, \'multiverseid\': 479996}, {\'name\': \'Resplandor del cénit\', \'text\': \'El Resplandor del cénit hace X puntos de daño a cualquier objetivo y tú ganas X vidas, donde X es la cantidad de cartas con una habilidad de ciclo en tu cementerio.\', \'type\': \'Instantáneo\', \'flavor\': \'"Desafío al mundo a que ponga a prueba nuestras defensas ahora. Que envíe pterones y aerofelinos. ¡Que envíe a Vadrok!".\\n—Janae, arquitecta de las Capas de Cobre\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480255&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7072db6f-70f4-4e97-b027-81e2ef166bb7\', \'multiverseId\': 480255}, \'multiverseid\': 480255}, {\'name\': \'Flamboiement du zénith\', \'text\': "Le Flamboiement du zénith inflige X blessures à n\'importe quelle cible et vous gagnez X points de vie, X étant le nombre de cartes avec une capacité de recyclage dans votre cimetière.", \'type\': \'Éphémère\', \'flavor\': "« Je défie ce monde d\'affronter nos défenses. Envoyez vos ptérons et vos félins célestes. Envoyez Vadrok ! »\\n—Janæ, architecte des Capes de cuivre", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480514&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e3986146-3276-46af-a060-77d907d8f392\', \'multiverseId\': 480514}, \'multiverseid\': 480514}, {\'name\': \'Bagliore dello Zenit\', \'text\': "Il Bagliore dello Zenit infligge X danni a un qualsiasi bersaglio e tu guadagni X punti vita, dove X è il numero di carte con un\'abilità ciclo nel tuo cimitero.", \'type\': \'Istantaneo\', \'flavor\': \'"Sfido questo mondo a mettere alla prova le nostre difese ora. Che vengano pure pteron e aerofelini. Che venga Vadrok!"\\n—Janae, architetta delle Giubbe Ramate\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480773&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fb45bc59-e34b-46d1-b14c-9950670f3a7e\', \'multiverseId\': 480773}, \'multiverseid\': 480773}, {\'name\': \'天頂の閃光\', \'text\': \'クリーチャー１体かプレインズウォーカー１体かプレイヤー１人を対象とする。天頂の閃光はそれにＸ点のダメージを与え、あなたはＸ点のライフを得る。Ｘはあなたの墓地にありサイクリング能力を持つカードの枚数に等しい。\', \'type\': \'インスタント\', \'flavor\': \'「我々の防衛を試すために、今からこの世界を挑発する。翼竜と空猫を寄越しなさい。ヴァドロックを寄越しなさい！」\\n――銅纏いの立案者、ジャネイ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481032&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2ae6c1ec-9186-421a-a0a8-702cda26db10\', \'multiverseId\': 481032}, \'multiverseid\': 481032}, {\'name\': \'천공의 불꽃\', \'text\': \'원하는 목표를 정한다. 천공의 불꽃은 그 목표에게 피해 X점을 입히고 당신은 생명 X점을 얻는다. X는 당신의 무덤에 있는 순환 능력을 가진 카드들의 수이다.\', \'type\': \'순간마법\', \'flavor\': \'"나는 우리의 방어 체계를 시험하기 위해 이 세상에 맞서려 한다. 프테론들과 창공고양이들을 보내라. 바드로크를 보내라!"\\n—구리 코트 건축가, 자네이\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481291&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8ab1ce71-2ca0-47d2-874d-5a2db57cb025\', \'multiverseId\': 481291}, \'multiverseid\': 481291}, {\'name\': \'Erupção do Zênite\', \'text\': \'Erupção do Zênite causa X pontos de dano a qualquer alvo e você ganha X pontos de vida, sendo X o número de cards com uma habilidade reciclar em seu cemitério.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Eu desafio este mundo a testar as nossas defesas agora. Que venham pterons e aerofelinos. Que venha Vadrok!"\\n— Janae, arquiteta dos Gibões de Cobre\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481550&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e3f73b73-0760-41f4-8125-46030bd34d24\', \'multiverseId\': 481550}, \'multiverseid\': 481550}, {\'name\': \'Вспышка Зенита\', \'text\': \'Вспышка Зенита наносит X повреждений любой цели, а вы получаете X жизней, где X — количество карт со способностью Цикла на вашем кладбище.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Мир, я бросаю тебе вызов! Испытай нашу оборону. Брось на нас птеронов и небесных котов. Брось на нас Вадрока!»\\n— Джанея, архитектор Медных Кителей\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481809&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a4e61035-2aa9-4db4-bd97-2f74eb904518\', \'multiverseId\': 481809}, \'multiverseid\': 481809}, {\'name\': \'晶顶闪光\', \'text\': \'晶顶闪光对任意一个目标造成X点伤害，且你获得X点生命，X为你坟墓场中具任一循环异能之牌的数量。\', \'type\': \'瞬间\', \'flavor\': \'「我倒想看看这个世界如何突破我们的防线。翼兽翔狮尽管出阵；叫瓦卓克放马过来！」\\n～紫铜军军械师佳奈\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482068&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f22784c6-74c1-430b-b84b-9cc5793a986f\', \'multiverseId\': 482068}, \'multiverseid\': 482068}, {\'name\': \'晶頂閃光\', \'text\': \'晶頂閃光對任意一個目標造成X點傷害，且你獲得X點生命，X為你墳墓場中具任一循環異能之牌的數量。\', \'type\': \'瞬間\', \'flavor\': \'「我倒想看看這個世界如何突破我們的防線。翼獸翔獅儘管出陣；叫瓦卓克放馬過來！」\\n～紫銅軍軍械師佳奈\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482327&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7cc1662a-2071-4085-9618-06edfdcb617f\', \'multiverseId\': 482327}, \'multiverseid\': 482327}]', '[{\'name\': \'Zerfetzte Segel\', \'text\': \'Bestimme eines —\\n• Zerstöre ein Artefakt deiner Wahl.\\n• Die Zerfetzten Segel fügen einer fliegenden Kreatur deiner Wahl 4 Schadenspunkte zu.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479915&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a4bc2e6f-26fd-4a72-a2d7-8e6aad3227e0\', \'multiverseId\': 479915}, \'multiverseid\': 479915}, {\'name\': \'Velas hechas jirones\', \'text\': \'Elige uno:\\n• Destruye el artefacto objetivo.\\n• Velas hechas jirones hace 4 puntos de daño a la criatura objetivo con la habilidad de volar.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480174&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'be84fbae-5279-40aa-9c58-f46201563b3c\', \'multiverseId\': 480174}, \'multiverseid\': 480174}, {\'name\': \'Voiles en lambeaux\', \'text\': "Choisissez l\'un —\\n• Détruisez l\'artefact ciblé.\\n• Les Voiles en lambeaux infligent 4 blessures à la créature avec le vol ciblée.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480433&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2308057b-d066-4129-ac42-60aebf18e56f\', \'multiverseId\': 480433}, \'multiverseid\': 480433}, {\'name\': \'Vele Squarciate\', \'text\': \'Scegli uno —\\n• Distruggi un artefatto bersaglio.\\n• Le Vele Squarciate infliggono 4 danni a una creatura bersaglio con volare.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480692&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9413ccda-57f8-40a8-85cc-3f99781b079b\', \'multiverseId\': 480692}, \'multiverseid\': 480692}, {\'name\': \'切り裂かれた帆\', \'text\': \'以下から１つを選ぶ。\\n• アーティファクト１つを対象とし、それを破壊する。\\n• 飛行を持つクリーチャー１体を対象とする。切り裂かれた帆はそれに４点のダメージを与える。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480951&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cc2529f3-965b-425f-a229-34c1a9abcf90\', \'multiverseId\': 480951}, \'multiverseid\': 480951}, {\'name\': \'찢겨진 돛\', \'text\': \'하나를 선택한다 —\\n• 마법물체를 목표로 정한다. 그 마법물체를 파괴한다.\\n• 비행을 가진 생물을 목표로 정한다. 찢겨진 돛은 그 생물에게 피해 4점을 입힌다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481210&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'856968e7-959a-45b1-ad83-6e6cfb2459f5\', \'multiverseId\': 481210}, \'multiverseid\': 481210}, {\'name\': \'Velas Despedaçadas\', \'text\': \'Escolha um —\\n• Destrua o artefato alvo.\\n• Velas Despedaçadas causa 4 pontos de dano à criatura alvo com voar.\\nReciclar {2} ({2}, descarte este card: Compre um card.)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481469&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fd4e0dfe-b55d-4c70-bb28-f3d350c07dd7\', \'multiverseId\': 481469}, \'multiverseid\': 481469}, {\'name\': \'Изорванные Паруса\', \'text\': \'Выберите одно —\\n• Уничтожьте целевой артефакт.\\n• Изорванные Паруса наносят 4 повреждения целевому существу с Полетом.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481728&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9cdb0857-d165-4b25-9582-b37b82b91f89\', \'multiverseId\': 481728}, \'multiverseid\': 481728}, {\'name\': \'翔帆损毁\', \'text\': \'选择一项～\\n•消灭目标神器。\\n•翔帆损毁对目标具飞行异能的生物造成4点伤害。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481987&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'393bddfc-69ce-472d-bee3-549fd2711664\', \'multiverseId\': 481987}, \'multiverseid\': 481987}, {\'name\': \'翔帆損毀\', \'text\': \'選擇一項～\\n•消滅目標神器。\\n•翔帆損毀對目標具飛行異能的生物造成4點傷害。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482246&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a89df06c-374a-44c3-82aa-6f24d772debc\', \'multiverseId\': 482246}, \'multiverseid\': 482246}]', "[{'name': 'Zerstörer des Zufluchtsorts', 'text': 'Erstschlag\\nUmwandlung {2}{R} ({2}{R}, wirf diese Karte ab: Ziehe eine Karte.)\\nWenn du den Zerstörer des Zufluchtsorts umwandelst, lege eine Erstschlag-Marke auf eine Kreatur deiner Wahl, die du kontrollierst.', 'type': 'Kreatur — Nashorn, Bestie', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479914&type=card', 'language': 'German', 'identifiers': {'scryfallId': '973afbd8-dce1-485e-9edc-171876afdae7', 'multiverseId': 479914}, 'multiverseid': 479914}, {'name': 'Devastasantuarios', 'text': 'Daña primero.\\nCiclo {2}{R}. ({2}{R}, descartar esta carta: Roba una carta.)\\nCuando actives la habilidad de ciclo del Devastasantuarios, pon un contador de dañar primero sobre la criatura objetivo que controlas.', 'type': 'Criatura — Bestia rinoceronte', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480173&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '51e4f8e3-87c9-4eba-a9db-ed8e1d6b1756', 'multiverseId': 480173}, 'multiverseid': 480173}, {'name': 'Fracasseur de sanctuaire', 'text': 'Initiative\\nRecyclage {2}{R} ({2}{R}, défaussez-vous de cette carte : Piochez une carte.)\\nQuand vous recyclez le Fracasseur de sanctuaire, mettez un marqueur « initiative » sur une créature ciblée que vous contrôlez.', 'type': 'Créature : rhinocéros et bête', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480432&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b6926a23-f20c-4597-b7a2-e9a07949cc2b', 'multiverseId': 480432}, 'multiverseid': 480432}, {'name': 'Devastatore del Santuario', 'text': 'Attacco improvviso\\nCiclo {2}{R} ({2}{R}, Scarta questa carta: Pesca una carta.)\\nQuando cicli il Devastatore del Santuario, metti un segnalino attacco improvviso su una creatura bersaglio che controlli.', 'type': 'Creatura — Bestia Rinoceronte', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480691&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'd63a5d9d-e4b8-4506-948c-e5013e260ff0', 'multiverseId': 480691}, 'multiverseid': 480691}, {'name': '聖域潰し', 'text': '先制攻撃\\nサイクリング {2}{R} （{2}{R}, このカードを捨てる：カードを１枚引く。）\\nあなたが聖域潰しをサイクリングしたとき、あなたがコントロールしているクリーチャー１体を対象とし、それの上に先制攻撃カウンターを１個置く。', 'type': 'クリーチャー — サイ・ビースト', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480950&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '82c6bf76-4f38-4d99-849d-1c02c73e9854', 'multiverseId': 480950}, 'multiverseid': 480950}, {'name': '성소 파괴자', 'text': '선제공격\\n순환 {2}{R} ({2}{R}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\\n당신이 성소 파괴자를 순환할 때, 당신이 조종하는 생물을 목표로 정한다. 그 생물에 선제공격 카운터를 올려놓는다.', 'type': '생물 — 코뿔소 야수', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481209&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'e32b42de-070f-48e3-b891-b1505a146901', 'multiverseId': 481209}, 'multiverseid': 481209}, {'name': 'Arrebentador do Santuário', 'text': 'Iniciativa\\nReciclar {2}{R} ({2}{R}, descarte este card: Compre um card.)\\nQuando reciclar Arrebentador do Santuário, coloque um marcador de iniciativa na criatura alvo que você controla.', 'type': 'Criatura — Rinoceronte Besta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481468&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd4937621-ca99-42fa-9274-0cf0c1781898', 'multiverseId': 481468}, 'multiverseid': 481468}, {'name': 'Сокрушитель Убежища', 'text': 'Первый удар\\nЦикл {2}{R} ({2}{R}, сбросьте эту карту: возьмите карту.)\\nКогда вы совершаете Цикл Сокрушителя Убежища, положите один жетон Первого удара на целевое существо под вашим контролем.', 'type': 'Существо — Носорог Зверь', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481727&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'c062dbca-c363-4140-a95a-7b76dd785e35', 'multiverseId': 481727}, 'multiverseid': 481727}, {'name': '庇护地破坏兽', 'text': '先攻\\n循环{2}{R}（{2}{R}，弃掉此牌：抓一张牌。）\\n当你循环庇护地破坏兽时，在目标由你操控的生物上放置一个先攻指示物。', 'type': '生物 ～犀牛／野兽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481986&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '593ef530-d50c-4b1f-bccd-046a00f643c3', 'multiverseId': 481986}, 'multiverseid': 481986}, {'name': '庇護地破壞獸', 'text': '先攻\\n循環{2}{R}（{2}{R}，棄掉此牌：抽一張牌。）\\n當你循環庇護地破壞獸時，在目標由你操控的生物上放置一個先攻指示物。', 'type': '生物 ～犀牛／野獸', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482245&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '2642038e-aa81-4d71-8f53-7d1b7c6b0725', 'multiverseId': 482245}, 'multiverseid': 482245}]", "[{'name': 'Zilortha, Inkarnation der Stärke', 'text': 'Verursacht Trampelschaden\\nOb Schaden für Kreaturen, die du kontrollierst, tödlich ist, wird anhand ihrer Stärke anstatt ihrer Widerstandskraft ermittelt.', 'type': 'Legendäre Kreatur — Dinosaurier', 'flavor': 'Godzilla, König der Monster', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482525&type=card', 'language': 'German', 'identifiers': {'scryfallId': '727d9724-bf72-4046-96a7-2b95a16d0888', 'multiverseId': 482525}, 'multiverseid': 482525}, {'name': 'Zilortha, fuerza encarnada', 'text': 'Arrolla.\\nEl daño letal hecho a las criaturas que controles se determina por su fuerza, en vez de su resistencia.', 'type': 'Criatura legendaria — Dinosaurio', 'flavor': 'Godzilla, rey de los monstruos', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482526&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e0564599-5f00-4ab9-972d-151ee4d7279a', 'multiverseId': 482526}, 'multiverseid': 482526}, {'name': 'Zilortha, force incarnée', 'text': 'Piétinement\\nLes blessures mortelles infligées aux créatures que vous contrôlez sont déterminées par leur force à la place de leur endurance.', 'type': 'Créature légendaire : dinosaure', 'flavor': 'Godzilla, roi des monstres', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482527&type=card', 'language': 'French', 'identifiers': {'scryfallId': '3fbf8cb9-eb35-42ba-a221-8caa3f7f241a', 'multiverseId': 482527}, 'multiverseid': 482527}, {'name': 'Zilortha, Incarnazione della Forza', 'text': 'Travolgere\\nIl danno letale inflitto alle creature che controlli è determinato dalla loro forza invece che dalla loro costituzione.', 'type': 'Creatura Leggendaria — Dinosauro', 'flavor': 'Godzilla, Re dei Mostri', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482528&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'fc3c7712-c1fc-4ed3-9692-5d801d36cff5', 'multiverseId': 482528}, 'multiverseid': 482528}, {'name': '力の具現、ジローサ', 'text': 'トランプル\\nあなたがコントロールしているクリーチャーが致死ダメージを受けたかどうかは、それのタフネスではなくパワーで計算する。', 'type': '伝説のクリーチャー — 恐竜', 'flavor': '怪（かい）獣（じゅう）王（おう）、ゴジラ', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482529&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '4caef4f5-05b4-4d42-9805-2c1f6b1a3631', 'multiverseId': 482529}, 'multiverseid': 482529}, {'name': '힘의 현신, 질로르사', 'text': '돌진\\n당신이 조종하는 생물이 입는 치명적인 피해는 그 생물의 방어력이 아닌 공격력에 의해 결정된다.', 'type': '전설적 생물 — 공룡', 'flavor': '괴수들의 왕, 고질라', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482530&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '8cbcec5d-52dd-45d2-ada6-4b22e3e49d61', 'multiverseId': 482530}, 'multiverseid': 482530}, {'name': 'Zilortha, Força Encarnada', 'text': 'Atropelar\\nO dano letal causado às criaturas que você controla é determinado por seu poder, e não pela sua resistência.', 'type': 'Criatura Lendária — Dinossauro', 'flavor': 'Godzilla, Rei dos Monstros', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482531&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1d899465-6591-4fed-a678-38803acc9065', 'multiverseId': 482531}, 'multiverseid': 482531}, {'name': 'Зилорта, Воплощение Силы', 'text': 'Пробивной удар\\nСмертельные повреждения, наносимые существам под вашим контролем, определяются их силой, а не выносливостью.', 'type': 'Легендарное Существо — Динозавр', 'flavor': 'Годзилла, Король Монстров', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482532&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '93227f2b-1003-4a6d-a003-172a4c9a4174', 'multiverseId': 482532}, 'multiverseid': 482532}, {'name': '雄威化身兹罗塔', 'text': '践踏\\n对由你操控的生物而言，利用其力量来决定是否受到致命伤害，而不是防御力。', 'type': '传奇生物 ～恐龙', 'flavor': '怪兽之王哥斯拉', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482533&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '8450f3a4-0822-4e42-a0a6-0c79b1bb3233', 'multiverseId': 482533}, 'multiverseid': 482533}, {'name': '雄威化身茲羅塔', 'text': '踐踏\\n對由你操控的生物而言，利用其力量來決定是否受到致命傷害，而不是防禦力。', 'type': '傳奇生物 ～恐龍', 'flavor': '怪獸之王哥吉拉', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482534&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'd28fb91c-f320-4590-8b36-348a66bb0436', 'multiverseId': 482534}, 'multiverseid': 482534}]", '[{\'name\': \'Zirda, Glut der Sonne\', \'text\': \'Gefährte — Jede bleibende Karte in deinem Startdeck hat eine aktivierte Fähigkeit. (Falls du diese Karte als deinen Gefährten erwählt hast, kannst du sie einmal von außerhalb der Partie wirken.)\\nFähigkeiten, die du aktivierst und die keine Manafähigkeiten sind, kosten beim Aktivieren {2} weniger. Dieser Effekt kann die Menge Mana in jenen Kosten nicht unter ein Mana reduzieren.\\n{1}, {T}: Eine Kreatur deiner Wahl kann in diesem Zug nicht blocken.\', \'type\': \'Legendäre Kreatur — Elementarwesen, Fuchs\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480012&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bc16d0d5-fd1c-4f49-a45f-042b7b1615d4\', \'multiverseId\': 480012}, \'multiverseid\': 480012}, {\'name\': \'Zirda, Resplandor del Amanecer\', \'text\': \'Compañero — Cada carta de permanente en tu mazo inicial tiene una habilidad activada. (Si esta carta es el compañero que eliges, puedes lanzarla una vez desde fuera del juego.)\\nTe cuesta {2} menos activar las habilidades que no sean habilidades de maná. Este efecto no puede reducir esos costes a menos de un maná.\\n{1}, {T}: La criatura objetivo no puede bloquear este turno.\', \'type\': \'Criatura legendaria — Zorro elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480271&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'30bee34d-e508-449d-882f-3a8cbaff74ca\', \'multiverseId\': 480271}, \'multiverseid\': 480271}, {\'name\': "Zirda, éveilleur de l\'aube", \'text\': "Compagnon — Chaque carte de permanent dans votre deck de départ a une capacité activée. (Si cette carte est le compagnon de votre choix, vous pouvez la lancer une fois depuis l\'extérieur de la partie.)\\nLes capacités que vous activez qui ne sont pas des capacités de mana coûtent {2} de moins à activer. Cet effet ne peut pas réduire le mana de ce coût à moins de un mana.\\n{1}, {T} : La créature ciblée ne peut pas bloquer ce tour-ci.", \'type\': \'Créature légendaire : élémental et renard\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480530&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1d8565f4-9bbe-4cea-a6b3-bd6396e04c34\', \'multiverseId\': 480530}, \'multiverseid\': 480530}, {\'name\': \'Zirda, il Destaurora\', \'text\': "Compagno — Ogni carta permanente nel tuo mazzo iniziale ha un\'abilità attivata. (Se questa carta è il compagno che hai scelto, puoi lanciarla una volta dal di fuori della partita.)\\nLe abilità che attivi e che non sono abilità di mana costano {2} in meno per essere attivate. Questo effetto non può ridurre il mana in quel costo a meno di un mana.\\n{1}, {T}: Una creatura bersaglio non può bloccare in questo turno.", \'type\': \'Creatura Leggendaria — Volpe Elementale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480789&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'28d0ffb7-cdc3-41ac-855a-b1705206ed74\', \'multiverseId\': 480789}, \'multiverseid\': 480789}, {\'name\': \'黎明起こし、ザーダ\', \'text\': \'相棒 ― あなたの開始時のデッキに入っている各パーマネント・カードが、それぞれ起動型能力を持っていること。（このカードがあなたの選んだ相棒であるなら、あなたは１回のみゲームの外部からこれを唱えてもよい。）\\nあなたがマナ能力でない能力を起動するためのコストは{2}少なくなる。この効果は、そのコストに含まれるマナの点数を１点未満に減らせない。\\n{1}, {T}：クリーチャー１体を対象とする。このターン、それではブロックできない。\', \'type\': \'伝説のクリーチャー — エレメンタル・狐\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481048&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'782f12b7-4fb2-4e48-a137-35a19d26b11b\', \'multiverseId\': 481048}, \'multiverseid\': 481048}, {\'name\': \'새벽을 깨우는 자, 지르다\', \'text\': \'단짝 — 당신의 시작 덱에 들어 있는 각 지속물 카드에는 활성화 능력이 있다. (이 카드가 당신이 선택한 단짝이라면, 당신은 이 카드를 게임 밖에서 한 번 발동할 수 있다.)\\n당신이 활성화하는 마나 능력이 아닌 능력은 활성화하는 데 {2}가 덜 든다. 이 효과는 해당 비용의 마나 양을 마나 한 개 미만으로 줄일 수 없다.\\n{1}, {T}: 생물을 목표로 정한다. 그 생물은 이 턴에 방어할 수 없다.\', \'type\': \'전설적 생물 — 정령 여우\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481307&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1b2636e8-9f8f-4d0a-ab6f-5699fbcbe238\', \'multiverseId\': 481307}, \'multiverseid\': 481307}, {\'name\': \'Zirda, o Brilho da Aurora\', \'text\': \'Companheiro — Cada card de permanente em seu deck inicial tem uma habilidade ativada. (Se este card for o companheiro que escolheu, você poderá conjurá-lo uma vez de fora do jogo.)\\nAs habilidades que você ativa que não sejam habilidades de mana custam {2} a menos para serem ativadas. Este efeito não pode reduzir o custo a menos de um mana.\\n{1}, {T}: A criatura alvo não pode bloquear neste turno.\', \'type\': \'Criatura Lendária — Elemental Raposa\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481566&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'70cff9cc-7ef8-45af-9f8a-c40adda76712\', \'multiverseId\': 481566}, \'multiverseid\': 481566}, {\'name\': \'Зерда, Пылающая на Рассвете\', \'text\': \'Компаньон — У каждой карты перманента в вашей начальной колоде есть активируемая способность. (Если эта карта является вашим избранным Компаньоном, то вы можете один раз разыграть ее из-за пределов игры.)\\nАктивация активируемых вами способностей, которые не являются мана-способностями, стоит на {2} меньше. Этот эффект не может снизить ману в стоимости активации до значения меньше одного.\\n{1}, {T}: целевое существо не может блокировать в этом ходу.\', \'type\': \'Легендарное Существо — Элементаль Лиса\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481825&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7292cfb6-e0d0-4760-b296-f7be820714d2\', \'multiverseId\': 481825}, \'multiverseid\': 481825}, {\'name\': \'熠晓灵狐泽尔达\', \'text\': \'行侣～你起始套牌中各永久物牌均具有起动式异能。（如果你选择这张牌作为你的行侣，则你可以从游戏外施放它，但仅限一次。）\\n你起动之不属于法术力异能的异能减少{2}来起动。此效应无法将该费用中的法术力减少到少于一点法术力。\\n{1}，{T}：目标生物本回合不能进行阻挡。\', \'type\': \'传奇生物 ～元素／狐\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482084&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'34fef117-9068-40cd-9109-79b3505d070b\', \'multiverseId\': 482084}, \'multiverseid\': 482084}, {\'name\': \'熠曉靈狐澤爾達\', \'text\': \'行侶～你起始套牌中各永久物牌均具有起動式異能。（如果你選擇這張牌作為你的行侶，則你可以從遊戲外施放它，但僅限一次。）\\n你起動之不屬於魔法力異能的異能減少{2}來起動。此效應無法將該費用中的魔法力減少到少於一點魔法力。\\n{1}，{T}：目標生物本回合不能進行阻擋。\', \'type\': \'傳奇生物 ～元素／狐\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482343&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a91d6293-26a9-4c83-a077-3acfadc2c531\', \'multiverseId\': 482343}, \'multiverseid\': 482343}]', '[{\'name\': \'Zusammen kämpfen\', \'text\': \'Bestimme eines oder beides —\\n• Eine Mensch-Kreatur deiner Wahl, die du kontrollierst, erhält +1/+1 und Unzerstörbarkeit bis zum Ende des Zuges.\\n• Eine Nicht-Mensch-Kreatur deiner Wahl, die du kontrollierst, erhält +1/+1 und Unzerstörbarkeit bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479791&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b62403a0-0f84-438c-a592-a172a1350ab8\', \'multiverseId\': 479791}, \'multiverseid\': 479791}, {\'name\': \'Luchar como uno\', \'text\': \'Elige uno o ambos:\\n• La criatura objetivo Humano que controlas obtiene +1/+1 y gana la habilidad de indestructible hasta el final del turno.\\n• La criatura objetivo que no sea Humano que controlas obtiene +1/+1 y gana la habilidad de indestructible hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480050&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'acc139af-f834-4ac2-9b1f-8f03d85e1ffd\', \'multiverseId\': 480050}, \'multiverseid\': 480050}, {\'name\': "Ne faire qu\'un au combat", \'text\': "Choisissez l\'un ou les deux —\\n• La créature Humain ciblée que vous contrôlez gagne +1/+1 et acquiert l\'indestructible jusqu\'à la fin du tour.\\n• La créature non-Humain ciblée que vous contrôlez gagne +1/+1 et acquiert l\'indestructible jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480309&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'18b113bb-c2b2-458f-80fa-0e6d92ff3432\', \'multiverseId\': 480309}, \'multiverseid\': 480309}, {\'name\': \'Combattere Uniti\', \'text\': \'Scegli uno o entrambi —\\n• Una creatura Umano bersaglio che controlli prende +1/+1 e ha indistruttibile fino alla fine del turno.\\n• Una creatura non Umano bersaglio che controlli prende +1/+1 e ha indistruttibile fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480568&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e6e96275-a44a-4207-9199-f826a41a07c8\', \'multiverseId\': 480568}, \'multiverseid\': 480568}, {\'name\': \'一心同体\', \'text\': \'以下から１つまたは両方を選ぶ。\\n• あなたがコントロールしている人間・クリーチャー１体を対象とする。ターン終了時まで、それは＋１/＋１の修整を受け破壊不能を得る。\\n• あなたがコントロールしていて人間でないクリーチャー１体を対象とする。ターン終了時まで、それは＋１/＋１の修整を受け破壊不能を得る。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480827&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0ccb9d23-970f-4c13-98c0-8c3e46b5ef0b\', \'multiverseId\': 480827}, \'multiverseid\': 480827}, {\'name\': \'하나된 싸움\', \'text\': \'하나 혹은 둘 다를 선택한다 —\\n• 당신이 조종하는 인간 생물을 목표로 정한다. 그 생물은 턴종료까지 +1/+1을 받고 무적을 얻는다.\\n• 당신이 조종하는 인간이 아닌 생물을 목표로 정한다. 그 생물은 턴종료까지 +1/+1을 받고 무적을 얻는다.\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481086&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'262edd1a-3c72-41ae-ab45-014a40899ba5\', \'multiverseId\': 481086}, \'multiverseid\': 481086}, {\'name\': \'Lutar como Um\', \'text\': \'Escolha um ou ambos —\\n• A criatura alvo do tipo Humano que você controla recebe +1/+1 e ganha indestrutível até o final do turno.\\n• A criatura alvo que você controla que não seja um Humano recebe +1/+1 e ganha indestrutível até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481345&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e8289e9b-a81c-4a92-ba08-25c4bb048315\', \'multiverseId\': 481345}, \'multiverseid\': 481345}, {\'name\': \'Бок о Бок\', \'text\': \'Выберите одно или оба —\\n• Целевое существо-Человек под вашим контролем получает +1/+1 и Неразрушимость до конца хода.\\n• Целевое не являющееся Человеком существо под вашим контролем получает +1/+1 и Неразрушимость до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481604&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fb3046f4-8c69-4547-9cc6-07cefd1a4ace\', \'multiverseId\': 481604}, \'multiverseid\': 481604}, {\'name\': \'羁绊合一\', \'text\': \'选择一项或都选～\\n•直到回合结束，目标由你操控的人类生物得+1/+1且获得不灭异能。\\n•直到回合结束，目标由你操控的非人类生物得+1/+1且获得不灭异能。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481863&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d196eb0a-e06c-4b8f-a817-42f926d71c4a\', \'multiverseId\': 481863}, \'multiverseid\': 481863}, {\'name\': \'羈絆合一\', \'text\': \'選擇一項或都選～\\n•直到回合結束，目標由你操控的人類生物得+1/+1且獲得不滅異能。\\n•直到回合結束，目標由你操控的非人類生物得+1/+1且獲得不滅異能。\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482122&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8f750392-0c7e-4155-81be-ffc826ac0b38\', \'multiverseId\': 482122}, \'multiverseid\': 482122}]', '[{\'name\': \'Ägis-Schildkröte\', \'type\': \'Kreatur — Schildkröte\', \'flavor\': \'„Die Ausdauer der alten Schildkröten in einem so rauen Land ist ein überzeugendes Argument für Geduld, Ruhe und Gelassenheit."\\n—Gavi die Nesthüterin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479818&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f497fc24-c976-4b61-adb5-cb124a02f48b\', \'multiverseId\': 479818}, \'multiverseid\': 479818}, {\'name\': \'Tortuga protegida\', \'type\': \'Criatura — Tortuga\', \'flavor\': \'"La resistencia de las antiguas tortugas en una tierra tan dura dice mucho a favor de la paciencia, la tranquilidad y la serenidad".\\n—Gavi, guardiana del nido\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480077&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e120c055-31b4-49cc-b89a-743a9cef2da1\', \'multiverseId\': 480077}, \'multiverseid\': 480077}, {\'name\': "Tortue de l\'égide", \'type\': \'Créature : tortue terrestre\', \'flavor\': "« La longévité des tortues ancestrales dans une terre si rude est un gage du pouvoir qu\'ont la patience, la tranquillité et le calme. »\\n—Gavi, garde du nid", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480336&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e29eb088-4113-44ff-986a-078926916bb0\', \'multiverseId\': 480336}, \'multiverseid\': 480336}, {\'name\': "Tartaruga dell\'Egida", \'type\': \'Creatura — Tartaruga\', \'flavor\': \'"La resistenza delle tartarughe antiche in una terra così inospitale dimostra l\\\'importanza di essere pazienti, tranquilli e composti."\\n—Gavi, guardiana del nido\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480595&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'79cc006e-f77b-4eca-8c75-90025afd1cfa\', \'multiverseId\': 480595}, \'multiverseid\': 480595}, {\'name\': \'神盾の海亀\', \'type\': \'クリーチャー — 海亀\', \'flavor\': \'「これほど厳しい土地に住む古代の亀の耐性は、我慢強く落ち着きがあり、そして冷静であることを示しているわ。」\\n――巣守り、ガヴィ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480854&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'664c042d-6cdd-4e6d-a736-943a3e639b9d\', \'multiverseId\': 480854}, \'multiverseid\': 480854}, {\'name\': \'방패 거북이\', \'type\': \'생물 — 거북이\', \'flavor\': \'"가혹한 땅에서 서식하는 고대 거북이들의 끈기는 인내와 평온, 그리고 평정에 대한 강력한 사례가 되어 주지."\\n—둥지 관리인, 가비\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481113&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'70b1e1c3-fc64-461c-b2bd-4e0eb1c86fc9\', \'multiverseId\': 481113}, \'multiverseid\': 481113}, {\'name\': \'Tartaruga da Égide\', \'type\': \'Criatura — Tartaruga\', \'flavor\': \'"A persistência das tartarugas ancestrais em uma terra tão inóspita é um argumento convincente a favor da paciência, da tranquilidade e da compostura."\\n— Gavi, guardiã do ninho\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481372&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'05d42cb7-c0ee-40ea-89c9-68aae5077216\', \'multiverseId\': 481372}, \'multiverseid\': 481372}, {\'name\': \'Защищенная Черепаха\', \'type\': \'Существо — Черепаха\', \'flavor\': \'«То, что древние черепахи смогли выжить в этом суровом краю, показывает, как важны терпение, спокойствие и самообладание».\\n— Гави, охранница гнезда\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481631&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'feb16fa4-9689-4bc9-b50f-68b202a87f26\', \'multiverseId\': 481631}, \'multiverseid\': 481631}, {\'name\': \'卫护龟\', \'type\': \'生物 ～龟\', \'flavor\': \'「在这片残酷之地中，古代的龟类仍能存活至今，正说明耐心、冷静、沉着有何等重要。」\\n～巢穴护卫盖薇\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481890&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2b874244-db05-4cc7-93cc-9ba70ac90669\', \'multiverseId\': 481890}, \'multiverseid\': 481890}, {\'name\': \'衛護龜\', \'type\': \'生物 ～龜\', \'flavor\': \'「在這片殘酷之地中，古代的龜類仍能存活至今，正說明耐心、冷靜、沉著有何等重要。」\\n～巢穴護衛蓋薇\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482149&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c6b9b780-c555-4165-9175-7da1c4d2977b\', \'multiverseId\': 482149}, \'multiverseid\': 482149}]', '[{\'name\': \'Überraschender Biss\', \'text\': \'Lege eine +1/+1-Marke und eine Lebensverknüpfung-Marke auf eine Kreatur deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Mit den häufigen Mutationen scheinen sich die Beziehungen zwischen Raubtier und Beute in jedem Moment zu ändern. Ein Ort nach meinem Geschmack."\\n—Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479881&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'89920adb-e2f0-444f-b2c2-eae498ad5b89\', \'multiverseId\': 479881}, \'multiverseid\': 479881}, {\'name\': \'Colmillos inesperados\', \'text\': \'Pon un contador +1/+1 y un contador de vínculo vital sobre la criatura objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Debido a las frecuentes mutaciones, las relaciones entre depredador y presa parecen cambiar continuamente. Este sitio ya me gusta".\\n—Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480140&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b664e568-9d2d-45b2-b57e-216ea9994b70\', \'multiverseId\': 480140}, \'multiverseid\': 480140}, {\'name\': \'Crocs inattendus\', \'text\': \'Mettez un marqueur +1/+1 et un marqueur « lien de vie » sur la créature ciblée.\', \'type\': \'Éphémère\', \'flavor\': \'« À cause des mutations fréquentes, les relations entre proies et prédateurs semblent changer continuellement. Je commence à me plaire ici. »\\n—Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480399&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fab683d6-986a-4431-8075-c51f3341d33b\', \'multiverseId\': 480399}, \'multiverseid\': 480399}, {\'name\': \'Zanne Inaspettate\', \'text\': \'Metti un segnalino +1/+1 e un segnalino legame vitale su una creatura bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"A causa delle frequenti mutazioni, i rapporti tra prede e predatori sembrano cambiare a ogni istante. Questo posto già mi piace."\\n—Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480658&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e201af8e-f627-48b5-a32f-5e95c681e658\', \'multiverseId\': 480658}, \'multiverseid\': 480658}, {\'name\': \'予想外の牙\', \'text\': \'クリーチャー１体を対象とし、それの上に＋１/＋１カウンター１個と絆魂カウンター１個を置く。\', \'type\': \'インスタント\', \'flavor\': \'「頻繁な変容によって、捕食者と獲物の関係が絶えず変わり続けているみたい。もうここが気に入ったわ。」\\n――ビビアン・リード\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480917&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'335e9bdb-7422-405a-9a28-f6660fa5fffc\', \'multiverseId\': 480917}, \'multiverseid\': 480917}, {\'name\': \'예상하지 못한 송곳니\', \'text\': \'생물을 목표로 정한다. 그 생물에 +1/+1 카운터 한 개와 생명연결 카운터를 올려놓는다.\', \'type\': \'순간마법\', \'flavor\': \'"돌연변이가 활발히 일어나면서, 포식자와 피식자와의 관계가 매 순간마다 변하는 것처럼 보여. 벌써 이 곳이 마음에 드네."\\n—비비안 레이드\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481176&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'260d5279-ec49-4237-8663-b655deb33abf\', \'multiverseId\': 481176}, \'multiverseid\': 481176}, {\'name\': \'Presas Inesperadas\', \'text\': \'Coloque um marcador +1/+1 e um marcador de vínculo com a vida na criatura alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Com as frequentes mutações, as relações presa-predador parecem mudar a todo instante. Já gostei daqui."\\n— Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481435&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cc9c156f-50bf-4066-80f4-8acd42af8cac\', \'multiverseId\': 481435}, \'multiverseid\': 481435}, {\'name\': \'Нежданные Клыки\', \'text\': \'Положите один жетон +1/+1 и один жетон Цепи жизни на целевое существо.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«С таким количеством мутаций взаимоотношения хищника и жертвы меняются каждый миг. Мне уже здесь нравится».\\n— Вивьен Рейд\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481694&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8047bf36-3af8-4daf-ba50-5d0cf8568025\', \'multiverseId\': 481694}, \'multiverseid\': 481694}, {\'name\': \'突生长牙\', \'text\': \'在目标生物上放置一个+1/+1指示物和一个系命指示物。\', \'type\': \'瞬间\', \'flavor\': \'「由于生物变异频繁，猎者和猎物之间的关系似乎每时每刻都在变化。我已经喜欢上这里了。」\\n～薇薇安瑞德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481953&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5388c9ee-760f-4d6a-b7a9-5d66ff9035d8\', \'multiverseId\': 481953}, \'multiverseid\': 481953}, {\'name\': \'突生長牙\', \'text\': \'在目標生物上放置一個+1/+1指示物和一個繫命指示物。\', \'type\': \'瞬間\', \'flavor\': \'「由於生物變異頻繁，獵者和獵物之間的關係似乎每時每刻都在變化。我已經喜歡上這裡了。」\\n～薇薇安瑞德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482212&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'06b46270-3c52-44dd-85fc-3db31b0cbf2a\', \'multiverseId\': 482212}, \'multiverseid\': 482212}]', "[{'name': '不思議な卵 (モスラの巨大な繭)', 'text': 'このクリーチャーが変容するたび、これの上に＋１/＋１カウンターを１個置く。', 'type': 'クリーチャー — 卵', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'f333b41d-e42c-4b12-be08-742eefb4e401'}, 'multiverseid': None}]", "[{'name': '哀歌コウモリ (暗黒破壊獣、バトラ)', 'text': '変容{4}{B}{B}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\n瞬速\\n飛行\\nこのクリーチャーが変容するたび、対戦相手がコントロールしている、クリーチャー１体かプレインズウォーカー１体を対象とし、それを破壊する。', 'type': 'クリーチャー — コウモリ', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'fdb53dbd-b35f-414a-9f99-d340ef9398dc'}, 'multiverseid': None}]", "[{'name': '結晶の巨人 (決戦兵器、メカゴジラ)', 'text': 'あなたのターンの戦闘の開始時に、飛行、先制攻撃、接死、呪禁、絆魂、威迫、到達、トランプル、警戒、＋１/＋１の中から、結晶の巨人の上に置かれていないカウンター１種類を無作為に選ぶ。結晶の巨人の上に、その種類のカウンターを１個置く。', 'type': 'アーティファクト・クリーチャー — 巨人', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'b0c2de2f-bb56-4713-861a-34523b331e26'}, 'multiverseid': None}]"]
