: {'scryfallId': '29b83a3f-31b3-4fc4-97a0-1a92100866a1', 'multiverseId': 482605}, 'multiverseid': 482605}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482620&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '2bd4436f-18ad-47a6-99c6-74ba0b1ea1af', 'multiverseId': 482620}, 'multiverseid': 482620}, {'name': '산', 'type': '기본 대지 — 산', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482635&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '88bdb7f5-8ccd-4dca-ad9c-91b72621da31', 'multiverseId': 482635}, 'multiverseid': 482635}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482650&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c2c2896d-2081-4ad0-a490-2341981c04b2', 'multiverseId': 482650}, 'multiverseid': 482650}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482665&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '991816f5-dab1-4929-985e-10d1c6a9b91e', 'multiverseId': 482665}, 'multiverseid': 482665}, {'name': '山脉', 'type': '基本地 ～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482680&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '61db597a-73fe-451d-a87b-8c010ddf61e5', 'multiverseId': 482680}, 'multiverseid': 482680}, {'name': '山脈', 'type': '基本地 ～山脈', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482695&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'e9ade444-c7c3-4d11-a881-8b7b5b212fd1', 'multiverseId': 482695}, 'multiverseid': 482695}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482561&type=card', 'language': 'German', 'identifiers': {'scryfallId': '319399a8-1db4-43df-bfc8-a18f8451fe46', 'multiverseId': 482561}, 'multiverseid': 482561}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482576&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'dd2bb24a-3a93-492a-a3ee-034781dac13a', 'multiverseId': 482576}, 'multiverseid': 482576}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482591&type=card', 'language': 'French', 'identifiers': {'scryfallId': '388ca92c-ac09-4a8e-a16c-76e9d257235d', 'multiverseId': 482591}, 'multiverseid': 482591}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482606&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '47ed8b9a-ba69-4084-87e7-29d5dd992505', 'multiverseId': 482606}, 'multiverseid': 482606}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482621&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '546d3a0a-b529-4c24-bd85-7b43be75b68c', 'multiverseId': 482621}, 'multiverseid': 482621}, {'name': '산', 'type': '기본 대지 — 산', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482636&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '4d43b799-37f4-4f58-a46d-be039e2c910f', 'multiverseId': 482636}, 'multiverseid': 482636}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482651&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'bd6e22ec-0652-48f0-bfb7-e208cb8fa967', 'multiverseId': 482651}, 'multiverseid': 482651}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482666&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'ee5fb31e-26ba-4f6f-829a-70ed56cc36fa', 'multiverseId': 482666}, 'multiverseid': 482666}, {'name': '山脉', 'type': '基本地 ～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482681&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '2a9eea8e-4427-4846-a57c-af26b70db17a', 'multiverseId': 482681}, 'multiverseid': 482681}, {'name': '山脈', 'type': '基本地 ～山脈', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482696&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '155d9251-a386-4cd5-84b6-6be4a539868a', 'multiverseId': 482696}, 'multiverseid': 482696}]", '[{\'name\': \'Gedeihender Fuchs\', \'text\': \'Immer wenn du eine andere Karte umwandelst, lege eine +1/+1-Marke auf den Gedeihenden Fuchs.\\nUmwandlung {1} ({1}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Kreatur — Fuchs\', \'flavor\': \'„Tag 1: Diese Fuchswelpen haben mich in ihr Herz geschlossen."\\n„Tag 4: Groß. So groß. Benötige zusätzlichen Schutz."\\n—Jonald der Naturkundler, Forschungsnotizen\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479792&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'101f2528-a890-463a-895d-c614745fd84a\', \'multiverseId\': 479792}, \'multiverseid\': 479792}, {\'name\': \'Zorro de la prosperidad\', \'text\': \'Siempre que actives una habilidad de ciclo de otra carta, pon un contador +1/+1 sobre el Zorro de la prosperidad.\\nCiclo {1}. ({1}, descartar esta carta: Roba una carta.)\', \'type\': \'Criatura — Zorro\', \'flavor\': \'"Día 1: Estos cachorros de zorro me tienen mucho cariño.\\nDía 4: Grandes. Muy grandes. Necesito más seguridad".\\n—Jonald, naturalista de campo, notas de investigación\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480051&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'095e7296-2b8a-4f54-b013-d9341364d5aa\', \'multiverseId\': 480051}, \'multiverseid\': 480051}, {\'name\': \'Renard prospère\', \'text\': \'À chaque fois que vous recyclez une autre carte, mettez un marqueur +1/+1 sur le Renard prospère.\\nRecyclage {1} ({1}, défaussez-vous de cette carte : Piochez une carte.)\', \'type\': \'Créature : renard\', \'flavor\': "« Jour 1 : Ces renardeaux m\'apprécient beaucoup.\\n« Jour 4 : Ils sont gros. Ils sont énormes. J\'ai besoin de plus de protection. »\\n—Notes de recherche de Jonald, naturaliste de la mission", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480310&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'47917291-dd0c-42b8-872a-04b0fbff5f71\', \'multiverseId\': 480310}, \'multiverseid\': 480310}, {\'name\': \'Volpe Fiorente\', \'text\': "Ogniqualvolta cicli un\'altra carta, metti un segnalino +1/+1 sulla Volpe Fiorente.\\nCiclo {1} ({1}, Scarta questa carta: Pesca una carta.)", \'type\': \'Creatura — Volpe\', \'flavor\': \'"Giorno 1: Questi volpacchiotti si sono affezionati a me.\\n"Giorno 4: Enormi. Sono giganti. Serve più sicurezza."\\n—Jonald, naturalista in missione, note di ricerca\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480569&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'73c02e7d-a05a-4532-91c0-7c9594d1805e\', \'multiverseId\': 480569}, \'multiverseid\': 480569}, {\'name\': \'繁栄の狐\', \'text\': \'あなたが他のカードをサイクリングするたび、繁栄の狐の上に＋１/＋１カウンターを１個置く。\\nサイクリング{1}（{1}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'クリーチャー — 狐\', \'flavor\': \'「一日目、子狐たちはかなり私に懐いている。」\\n「四日目、大きい。大きすぎる。警備を増やさなければ。」\\n――踏査自然主義者、ジョナルドの研究記録\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480828&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d10d7f44-871b-4d9e-b000-1d693b72fde2\', \'multiverseId\': 480828}, \'multiverseid\': 480828}, {\'name\': \'융성하는 여우\', \'text\': \'당신이 다른 카드를 순환할 때마다, 융성하는 여우에 +1/+1 카운터 한 개를 올려놓는다.\\n순환 {1} ({1}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'생물 — 여우\', \'flavor\': \'"1일째: 이 새끼여우들은 나를 정말로 잘 따른다."\\n"4일째: 크다. 너무 크다. 추가적인 보안 조치가 필요하다."\\n—파견 자연주의자, 조날드, 연구 노트\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481087&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'022a72ce-0011-4a81-885e-b397ab3bd7d6\', \'multiverseId\': 481087}, \'multiverseid\': 481087}, {\'name\': \'Raposa Florescente\', \'text\': \'Toda vez que você reciclar outro card, coloque um marcador +1/+1 em Raposa Florescente.\\nReciclar {1} ({1}, descarte este card: Compre um card.)\', \'type\': \'Criatura — Raposa\', \'flavor\': \'"1.º dia: Esses filhotinhos de raposa gostaram mesmo de mim.\\n"4.º dia: Grandes. Enormes. Preciso de segurança adicional."\\n— Jonald, naturalista da missão, anotações de pesquisa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481346&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'84c0ebc0-21fd-4eda-a84f-458076dfb983\', \'multiverseId\': 481346}, \'multiverseid\': 481346}, {\'name\': \'Матерая Лисица\', \'text\': \'Каждый раз, когда вы совершаете Цикл другой карты, положите один жетон +1/+1 на Матерую Лисицу.\\nЦикл {1} ({1}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Существо — Лиса\', \'flavor\': \'«День 1. Эти лисята здорово ко мне привязались.\\nДень 4. Они большие. Очень большие. Нужно принять меры безопасности».\\n— дневник наблюдений Джональда, натуралиста экспедиции\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481605&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c53a1bd6-08d4-41c8-a5c1-ff2363449809\', \'multiverseId\': 481605}, \'multiverseid\': 481605}, {\'name\': \'待哺幼狐\', \'text\': \'每当你循环另一张牌时，在待哺幼狐上放置一个+1/+1指示物。\\n循环{1}（{1}，弃掉此牌：抓一张牌。）\', \'type\': \'生物 ～狐\', \'flavor\': \'「第1天：这些狐狸幼崽真的喜欢上我了。\\n「第4天：真大。真的太大了。要严加看守。」\\n～实地博物学家贾纳德的研究纪录\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481864&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'909e0e93-01ba-47ad-b6c5-04833bd5edf0\', \'multiverseId\': 481864}, \'multiverseid\': 481864}, {\'name\': \'待哺幼狐\', \'text\': \'每當你循環另一張牌時，在待哺幼狐上放置一個+1/+1指示物。\\n循環{1}（{1}，棄掉此牌：抽一張牌。）\', \'type\': \'生物 ～狐\', \'flavor\': \'「第1天：這些狐狸幼崽真的喜歡上我了。\\n「第4天：真大。真的太大了。要嚴加看守。」\\n～實地博物學家賈納德的研究紀錄\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482123&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'408594fd-8c3f-4e60-94b8-2b91bf1203ce\', \'multiverseId\': 482123}, \'multiverseid\': 482123}]', '[{\'name\': \'Gedächtnisverlust\', \'text\': \'Ein Gegner deiner Wahl zeigt die Karten auf seiner Hand offen vor. Bestimme eine Nichtland-Karte im Friedhof oder auf der Hand jenes Spielers und schicke sie ins Exil.\\nUmwandlung {1} ({1}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Hexerei\', \'flavor\': \'„Die Jugend verflüchtigt sich in Hälften. Ich erinnere mich an halbe Namen, halbe Jahre und an die Hälfte meiner selbst."\\n—Ogaro, wandernder Weiser\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479874&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9b7253d5-b407-49ee-a8c2-b57ffda11d09\', \'multiverseId\': 479874}, \'multiverseid\': 479874}, {\'name\': \'Fuga de recuerdos\', \'text\': \'El oponente objetivo muestra su mano. Elige una carta que no sea tierra del cementerio o la mano de ese jugador y exíliala.\\nCiclo {1}. ({1}, descartar esta carta: Roba una carta.)\', \'type\': \'Conjuro\', \'flavor\': \'"Por mitades perdemos la juventud. Recuerdo la mitad de los nombres, la mitad de los años y la mitad de mí mismo".\\n—Ogaro, sabio errante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480133&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'69fabbb7-5793-4994-b4e2-5b5e253561c5\', \'multiverseId\': 480133}, \'multiverseid\': 480133}, {\'name\': \'Fuite de mémoire\', \'text\': "L\'adversaire ciblé révèle sa main. Vous choisissez une carte non-terrain dans le cimetière ou la main de ce joueur et vous l\'exilez.\\nRecyclage {1} ({1}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Rituel\', \'flavor\': \'« La jeunesse nous quitte par moitiés. Je ne me souviens que de la moitié des noms, de la moitié des années, de la moitié de moi-même. »\\n—Ogaro, sage errant\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480392&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7c444b42-4fa3-42e5-b652-dd4d77e9f5b1\', \'multiverseId\': 480392}, \'multiverseid\': 480392}, {\'name\': \'Perdita di Memoria\', \'text\': \'Un avversario bersaglio rivela la sua mano. Scegli una carta non terra dal cimitero o dalla mano di quel giocatore ed esiliala.\\nCiclo {1} ({1}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Stregoneria\', \'flavor\': \'"Di volta in volta, la giovinezza si dilegua per metà. Ricordo metà dei nomi, metà degli anni, metà di me stesso."\\n—Ogaro, saggio errante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480651&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'959c0685-796a-4278-a79b-ab8c904f4ced\', \'multiverseId\': 480651}, \'multiverseid\': 480651}, {\'name\': \'記憶漏出\', \'text\': \'対戦相手１人を対象とする。そのプレイヤーは自分の手札を公開する。あなたはそのプレイヤーの墓地か手札から土地でないカード１枚を選び、追放する。\\nサイクリング{1}（{1}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'ソーサリー\', \'flavor\': \'「青春の半分が去った。覚えているのは、名前の半分、年月の半分、自分の半分だけだ。」\\n――放浪する賢者、オガロ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480910&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'534a36b4-6d5f-4f85-ad21-af88c7d28425\', \'multiverseId\': 480910}, \'multiverseid\': 480910}, {\'name\': \'기억 유실\', \'text\': \'상대를 목표로 정한다. 그 플레이어는 자신의 손을 공개한다. 당신은 그 플레이어의 무덤 또는 손에서 대지가 아닌 카드 한 장을 선택해 추방한다.\\n순환 {1} ({1}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'집중마법\', \'flavor\': \'"젊음이 떠나면 모든 것이 절반이 된다. 나는 내가 만났던 자들의 이름 절반을, 내가 살아온 해의 절반을, 나 자신의 절반을 기억한다."\\n—방랑 현자, 오가로\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481169&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'27e58723-96eb-4507-a8bc-6f1f83e85cb3\', \'multiverseId\': 481169}, \'multiverseid\': 481169}, {\'name\': \'Vazamento de Lembranças\', \'text\': \'O oponente alvo revela a própria mão. Você escolhe um card que não seja terreno do cemitério ou da mão daquele jogador e o exila.\\nReciclar {1} ({1}, descarte este card: Compre um card.)\', \'type\': \'Feitiço\', \'flavor\': \'"A juventude se esvai pelas metades. Eu lembro de nomes pela metade, de anos pela metade, de mim pela metade."\\n— Ogaro, o sábio andarilho\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481428&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fead02ea-0d41-4cf9-9b50-a9fdc86c2252\', \'multiverseId\': 481428}, \'multiverseid\': 481428}, {\'name\': \'Утечка Памяти\', \'text\': \'Целевой оппонент показывает свою руку. Вы выбираете не являющуюся землей карту из кладбища или руки того игрока и изгоняете ее.\\nЦикл {1} ({1}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Волшебство\', \'flavor\': \'«Юность уходит половинами. Я помню половину имен, половину лет, половину себя».\\n— Огаро, странствующий мудрец\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481687&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'34849599-6098-4e98-a576-f5b696d8de00\', \'multiverseId\': 481687}, \'multiverseid\': 481687}, {\'name\': \'记忆泄露\', \'text\': \'目标对手展示其手牌。你从该牌手的坟墓场或手牌选择一张非地牌并将该牌放逐。\\n循环{1}（{1}，弃掉此牌：抓一张牌。）\', \'type\': \'法术\', \'flavor\': \'「青春好年华，半数已流逝。回忆仅余半数的名字，半数的时光和半数的自我。」\\n～云游智者欧家洛\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481946&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c6e3f5a7-24a9-4a4b-8b4b-4da71f105534\', \'multiverseId\': 481946}, \'multiverseid\': 481946}, {\'name\': \'記憶洩露\', \'text\': \'目標對手展示其手牌。你從該玩家的墳墓場或手牌選擇一張非地牌並將該牌放逐。\\n循環{1}（{1}，棄掉此牌：抽一張牌。）\', \'type\': \'巫術\', \'flavor\': \'「青春好年華，半數已流逝。回憶僅餘半數的名字，半數的時光和半數的自我。」\\n～雲遊智者歐家洛\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482205&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4a236576-b083-4698-97f1-043f2fcbcafd\', \'multiverseId\': 482205}, \'multiverseid\': 482205}]', '[{\'name\': \'Gefräßiger Riesenhai\', \'text\': \'Aufblitzen\\nWenn der Gefräßige Riesenhai ins Spiel kommt, neutralisiere einen Artefakt- oder Kreaturenzauber deiner Wahl.\', \'type\': \'Kreatur — Hai\', \'flavor\': \'Es gibt kein Boot, das groß genug wäre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479849&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'44717e81-146b-4f0e-aa01-bd5b0cf44565\', \'multiverseId\': 479849}, \'multiverseid\': 479849}, {\'name\': \'Gran tiburón voraz\', \'text\': \'Destello.\\nCuando el Gran tiburón voraz entre al campo de batalla, contrarresta el hechizo de artefacto o criatura objetivo.\', \'type\': \'Criatura — Tiburón\', \'flavor\': \'Ningún barco es suficientemente grande.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480108&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5ea48026-9f5b-47bb-9b88-8beee153f3f2\', \'multiverseId\': 480108}, \'multiverseid\': 480108}, {\'name\': \'Grand requin vorace\', \'text\': "Flash\\nQuand le Grand requin vorace arrive sur le champ de bataille, contrecarrez le sort d\'artefact ou de créature ciblé.", \'type\': \'Créature : requin\', \'flavor\': "Il n\'existe aucun bateau assez gros.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480367&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b7cb784a-b589-4cc9-b9d0-066a35abbfaf\', \'multiverseId\': 480367}, \'multiverseid\': 480367}, {\'name\': \'Gransqualo Vorace\', \'text\': \'Lampo\\nQuando il Gransqualo Vorace entra nel campo di battaglia, neutralizza una magia artefatto o creatura bersaglio.\', \'type\': \'Creatura — Squalo\', \'flavor\': \'Non esiste una barca abbastanza grossa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480626&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e7a099b1-b3de-464e-b2e3-5be7fcf8dfc1\', \'multiverseId\': 480626}, \'multiverseid\': 480626}, {\'name\': \'大食の巨大鮫\', \'text\': \'瞬速\\n大食の巨大鮫が戦場に出たとき、アーティファクト・呪文１つかクリーチャー・呪文１つを対象とし、それを打ち消す。\', \'type\': \'クリーチャー — サメ\', \'flavor\': \'どれほど大きなボートでも充分ではない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480885&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6103ead8-3d72-4b04-9222-2346d39855ae\', \'multiverseId\': 480885}, \'multiverseid\': 480885}, {\'name\': \'탐욕스러운 거대상어\', \'text\': \'섬광\\n탐욕스러운 거대상어가 전장에 들어올 때, 마법물체 또는 생물 주문을 목표로 정한다. 그 주문을 무효화한다.\', \'type\': \'생물 — 상어\', \'flavor\': \'충분히 큰 배는 없다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481144&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'dadac8e0-caa3-495d-ad6b-bd0a58db30b7\', \'multiverseId\': 481144}, \'multiverseid\': 481144}, {\'name\': \'Megatubarão Voraz\', \'text\': \'Lampejo\\nQuando Megatubarão Voraz entrar no campo de batalha, anule a mágica de artefato ou criatura alvo.\', \'type\': \'Criatura — Tubarão\', \'flavor\': \'Nenhum barco é grande o suficiente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481403&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6c139b84-99fb-4557-915b-71ea4454779c\', \'multiverseId\': 481403}, \'multiverseid\': 481403}, {\'name\': \'Прожорливый Мегалодон\', \'text\': \'Миг\\nКогда Прожорливый Мегалодон выходит на поле битвы, отмените целевое заклинание артефакта или существа.\', \'type\': \'Существо — Акула\', \'flavor\': \'Для него нет кораблей не по зубам.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481662&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'13cc97f5-0b11-4abc-8cc2-82dc69b6640e\', \'multiverseId\': 481662}, \'multiverseid\': 481662}, {\'name\': \'贪餮硕鲨\', \'text\': \'闪现\\n当贪餮硕鲨进战场时，反击目标神器或生物咒语。\', \'type\': \'生物 ～鲨鱼\', \'flavor\': \'没有船大到它吃不下。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481921&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3cc60454-ca6e-4fad-bc93-9c404d07486e\', \'multiverseId\': 481921}, \'multiverseid\': 481921}, {\'name\': \'貪餮碩鯊\', \'text\': \'閃現\\n當貪餮碩鯊進戰場時，反擊目標神器或生物咒語。\', \'type\': \'生物 ～鯊魚\', \'flavor\': \'沒有船大到牠吃不下。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482180&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ae6f9672-3ddc-4c54-b177-618cb1775ff4\', \'multiverseId\': 482180}, \'multiverseid\': 482180}]', '[{\'name\': \'Gefängnissphäre\', \'text\': \'Aufblitzen\\nVerzaubert eine Kreatur\\nWenn die Gefängnissphäre ins Spiel kommt, tappe die verzauberte Kreatur.\\nDie verzauberte Kreatur enttappt nicht während des Enttappsegments ihres Beherrschers.\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479823&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d780bdcd-f656-44e4-bbbe-809865dacd08\', \'multiverseId\': 479823}, \'multiverseid\': 479823}, {\'name\': \'Esfera de captura\', \'text\': \'Destello.\\nEncantar criatura.\\nCuando la Esfera de captura entre al campo de batalla, gira la criatura encantada.\\nLa criatura encantada no se endereza durante el paso de enderezar de su controlador.\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480082&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'19b94eb2-bebc-4b49-8947-96675004751a\', \'multiverseId\': 480082}, \'multiverseid\': 480082}, {\'name\': \'Sphère de capture\', \'text\': "Flash\\nEnchanter : créature\\nQuand la Sphère de capture arrive sur le champ de bataille, engagez la créature enchantée.\\nLa créature enchantée ne se dégage pas pendant l\'étape de dégagement de son contrôleur.", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480341&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'59b1467a-844b-433c-a2a6-bedfe3c7aadf\', \'multiverseId\': 480341}, \'multiverseid\': 480341}, {\'name\': \'Sfera di Cattura\', \'text\': \'Lampo\\nIncanta creatura\\nQuando la Sfera di Cattura entra nel campo di battaglia, TAPpa la creatura incantata.\\nLa creatura incantata non STAPpa durante lo STAP del suo controllore.\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480600&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c3ee35bd-3d2b-4a19-b16f-77e1bde22ae8\', \'multiverseId\': 480600}, \'multiverseid\': 480600}, {\'name\': \'捕獲球\', \'text\': \'瞬速\\nエンチャント（クリーチャー）\\n捕獲球が戦場に出たとき、エンチャントしているクリーチャーをタップする。\\nエンチャントしているクリーチャーは、それのコントローラーのアンタップ・ステップにアンタップしない。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480859&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3cc51e91-ab65-47c4-b588-eb0e020850c7\', \'multiverseId\': 480859}, \'multiverseid\': 480859}, {\'name\': \'포획 구체\', \'text\': \'섬광\\n생물에게 부여\\n포획 구체가 전장에 들어올 때, 부여된 생물을 탭한다.\\n부여된 생물은 조종자의 언탭단에 언탭되지 않는다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481118&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'efff2a48-ebb5-4a39-92d2-7f9982cd8eb0\', \'multiverseId\': 481118}, \'multiverseid\': 481118}, {\'name\': \'Esfera de Captura\', \'text\': \'Lampejo\\nEncantar criatura\\nQuando Esfera de Captura entrar no campo de batalha, vire a criatura encantada.\\nA criatura encantada não é desvirada durante a etapa de desvirar de seu controlador.\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481377&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f42b45cd-945a-40db-bd50-0b620d50dc48\', \'multiverseId\': 481377}, \'multiverseid\': 481377}, {\'name\': \'Ловчая Сфера\', \'text\': \'Миг\\nЗачаровать существо\\nКогда Ловчая Сфера выходит на поле битвы, поверните зачарованное существо.\\nЗачарованное существо не разворачивается во время шага разворота контролирующего его игрока.\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481636&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fb677dc5-35de-498e-9da7-f216d07344fa\', \'multiverseId\': 481636}, \'multiverseid\': 481636}, {\'name\': \'拘捕法球\', \'text\': \'闪现\\n结附于生物\\n当拘捕法球进战场时，横置所结附的生物。\\n所结附的生物于其操控者的重置步骤中不能重置。\', \'type\': \'结界 ～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481895&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2ba9d1cc-e757-464b-8f58-0695cd5c6d6b\', \'multiverseId\': 481895}, \'multiverseid\': 481895}, {\'name\': \'拘捕法球\', \'text\': \'閃現\\n結附於生物\\n當拘捕法球進戰場時，橫置所結附的生物。\\n所結附的生物於其操控者的重置步驟中不能重置。\', \'type\': \'結界 ～靈氣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482154&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'650f007b-44df-4d52-8a68-bc8f37ce9d0e\', \'multiverseId\': 482154}, \'multiverseid\': 482154}]', '[{\'name\': \'Gegenseitige Zerstörung\', \'text\': \'Dieser Zauberspruch hat Aufblitzen, solange du eine bleibende Karte mit Aufblitzen kontrollierst.\\nOpfere eine Kreatur als zusätzliche Kosten, um diesen Zauberspruch zu wirken.\\nZerstöre eine Kreatur deiner Wahl.\', \'type\': \'Hexerei\', \'flavor\': \'Jäger und Gejagter starben beide und dachten, sie hätten den anderen überlistet.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479875&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2ebaca09-fa01-413f-8b59-de766b345a5c\', \'multiverseId\': 479875}, \'multiverseid\': 479875}, {\'name\': \'Destrucción mutua\', \'text\': \'Este hechizo tiene la habilidad de destello mientras controles un permanente con la habilidad de destello.\\nComo coste adicional para lanzar este hechizo, sacrifica una criatura.\\nDestruye la criatura objetivo.\', \'type\': \'Conjuro\', \'flavor\': \'Cazador y presa, ambos murieron creyendo que habían engañado al otro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480134&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e72b9c8c-8c66-488b-ad8c-090186460630\', \'multiverseId\': 480134}, \'multiverseid\': 480134}, {\'name\': \'Destruction mutuelle\', \'text\': \'Ce sort a le flash tant que vous contrôlez un permanent avec le flash.\\nEn tant que coût supplémentaire pour lancer ce sort, sacrifiez une créature.\\nDétruisez la créature ciblée.\', \'type\': \'Rituel\', \'flavor\': "Le chasseur et le chassé sont tous les deux morts en se croyant plus malin que l\'autre.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480393&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7b6d243e-b7ca-4763-9704-021f33bfdd20\', \'multiverseId\': 480393}, \'multiverseid\': 480393}, {\'name\': \'Distruzione Reciproca\', \'text\': \'Questa magia ha lampo fintanto che controlli un permanente con lampo.\\nCome costo addizionale per lanciare questa magia, sacrifica una creatura.\\nDistruggi una creatura bersaglio.\', \'type\': \'Stregoneria\', \'flavor\': "Cacciatore e cacciato morirono entrambi convinti di aver fregato l\'altro.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480652&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2d59f145-2e17-40c9-8195-5729438b3008\', \'multiverseId\': 480652}, \'multiverseid\': 480652}, {\'name\': \'相互破壊\', \'text\': \'あなたが瞬速を持つパーマネントをコントロールしているかぎり、この呪文は瞬速を持つ。\\nこの呪文を唱えるための追加コストとして、クリーチャー１体を生け贄に捧げる。\\nクリーチャー１体を対象とし、それを破壊する。\', \'type\': \'ソーサリー\', \'flavor\': \'狩人と標的は互いに互いを出し抜いたと信じて死んだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480911&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'06c4ff3d-f62f-45f0-88cd-d45af97f66bd\', \'multiverseId\': 480911}, \'multiverseid\': 480911}, {\'name\': \'상호 파괴\', \'text\': \'이 주문은 당신이 섬광을 가진 지속물을 조종하는 한 섬광을 가진다.\\n이 주문을 발동하기 위한 추가비용으로, 생물 한 개를 희생한다.\\n생물을 목표로 정한다. 그 생물을 파괴한다.\', \'type\': \'집중마법\', \'flavor\': \'사냥꾼과 사냥감은 둘 다 자신이 상대를 압도했다고 생각하며 죽었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481170&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'959317fd-3499-49e1-b5e8-ff00f9df1f24\', \'multiverseId\': 481170}, \'multiverseid\': 481170}, {\'name\': \'Destruição Mútua\', \'text\': \'Esta mágica terá lampejo enquanto você controlar uma permanente com lampejo.\\nComo custo adicional para conjurar esta mágica, sacrifique uma criatura.\\nDestrua a criatura alvo.\', \'type\': \'Feitiço\', \'flavor\': \'Caça e caçadora morreram, ambos pensando que haviam superado o outro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481429&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'152789ec-571c-4f3b-aaea-f32913233e22\', \'multiverseId\': 481429}, \'multiverseid\': 481429}, {\'name\': \'Взаимное Уничтожение\', \'text\': \'Это заклинание имеет Миг, пока вы контролируете перманент с Мигом.\\nВ качестве дополнительной стоимости разыгрывания этого заклинания пожертвуйте существо.\\nУничтожьте целевое существо.\', \'type\': \'Волшебство\', \'flavor\': \'Охотник и добыча умерли одновременно, и каждый думал, что обхитрил противника.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481688&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6e82a5be-c6a2-43d5-acf6-ffcae941dd09\', \'multiverseId\': 481688}, \'multiverseid\': 481688}, {\'name\': \'同归于尽\', \'text\': \'只要你操控具闪现异能的永久物，此咒语便具有闪现异能。\\n牺牲一个生物，以作为施放此咒语的额外费用。\\n消灭目标生物。\', \'type\': \'法术\', \'flavor\': \'猎人与猎物同归于尽，都以为自己已智取对手。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481947&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c43d79e2-7c3a-4c9b-a7f0-8da97fc897fa\', \'multiverseId\': 481947}, \'multiverseid\': 481947}, {\'name\': \'同歸於盡\', \'text\': \'只要你操控具閃現異能的永久物，此咒語便具有閃現異能。\\n犧牲一個生物，以作為施放此咒語的額外費用。\\n消滅目標生物。\', \'type\': \'巫術\', \'flavor\': \'獵人與獵物同歸於盡，都以為自己已智取對手。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482206&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c59302df-9f82-4605-883a-5dd52322ca52\', \'multiverseId\': 482206}, \'multiverseid\': 482206}]', '[{\'name\': \'Geheimnisvoller Drakkis\', \'text\': \'Mutation {U/R}{U/R} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\nImmer wenn diese Kreatur mutiert, bringe eine Spontanzauber- oder Hexereikarte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Kreatur — Eidechse, Bestie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479973&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'44ac65b3-87c1-4092-b258-aa9a037a2394\', \'multiverseId\': 479973}, \'multiverseid\': 479973}, {\'name\': \'Drakkis del saber\', \'text\': \'Mutación {U/R}{U/R}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\nSiempre que esta criatura mute, regresa la carta de instantáneo o de conjuro objetivo de tu cementerio a tu mano.\', \'type\': \'Criatura — Bestia lagarto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480232&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4c1796fb-23e7-4f84-8290-a94e4c77c7b2\', \'multiverseId\': 480232}, \'multiverseid\': 480232}, {\'name\': \'Drakkis de sapience\', \'text\': "Mutation {U/R}{U/R} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\nÀ chaque fois que cette créature subit une mutation, renvoyez une carte d\'éphémère ou de rituel ciblée depuis votre cimetière dans votre main.", \'type\': \'Créature : lézard et bête\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480491&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4e75af76-d3b2-4cdf-97d5-5f7642da6b17\', \'multiverseId\': 480491}, \'multiverseid\': 480491}, {\'name\': \'Drakkis della Sapienza\', \'text\': \'Mutazione {U/R}{U/R} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\nOgniqualvolta questa creatura muta, riprendi in mano una carta istantaneo o stregoneria bersaglio dal tuo cimitero.\', \'type\': \'Creatura — Bestia Lucertola\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480750&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b7799543-2f69-4287-bf60-64654636886b\', \'multiverseId\': 480750}, \'multiverseid\': 480750}, {\'name\': \'伝承のドラッキス\', \'text\': \'変容{U/R}{U/R}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\nこのクリーチャーが変容するたび、あなたの墓地からインスタントかソーサリーであるカード１枚を対象とし、それをあなたの手札に戻す。\', \'type\': \'クリーチャー — トカゲ・ビースト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481009&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bf742ee0-f5e3-423d-a6c3-f3c8195e936b\', \'multiverseId\': 481009}, \'multiverseid\': 481009}, {\'name\': \'설화 드라키스\', \'text\': \'돌연변이화 {U/R}{U/R} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n이 생물이 돌연변이화할 때마다, 당신의 무덤에 있는 순간마법 또는 집중마법 카드를 목표로 정한다. 그 카드를 당신의 손으로 되돌린다.\', \'type\': \'생물 — 도마뱀 야수\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481268&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a17c2d6d-938e-4e97-878f-eeb90160ddd6\', \'multiverseId\': 481268}, \'multiverseid\': 481268}, {\'name\': \'Drakkis do Saber\', \'text\': \'Mutação {U/R}{U/R} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\nToda vez que esta criatura sofrer mutação, devolva o card de mágica instantânea ou feitiço alvo de seu cemitério para sua mão.\', \'type\': \'Criatura — Lagarto Besta\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481527&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'761f8e31-c2b2-49c5-b4fb-ebf4f72e858a\', \'multiverseId\': 481527}, \'multiverseid\': 481527}, {\'name\': \'Знающий Драккис\', \'text\': \'Мутация {U/R}{U/R} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\nКаждый раз, когда это существо мутирует, верните целевую карту мгновенного заклинания или волшебства из вашего кладбища в вашу руку.\', \'type\': \'Существо — Ящер Зверь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481786&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b13064ae-62fe-4056-95a6-e83315402b76\', \'multiverseId\': 481786}, \'multiverseid\': 481786}, {\'name\': \'识返蜥身兽\', \'text\': \'合变{U/R}{U/R}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n每当此生物合变时，将目标瞬间或法术牌从你的坟墓场移回你手上。\', \'type\': \'生物 ～蜥蜴／野兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482045&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5a529d0a-209b-4ebf-9352-1afe8a5cfc1d\', \'multiverseId\': 482045}, \'multiverseid\': 482045}, {\'name\': \'識返蜥身獸\', \'text\': \'合變{U/R}{U/R}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n每當此生物合變時，將目標瞬間或巫術牌從你的墳墓場移回你手上。\', \'type\': \'生物 ～蜥蜴／野獸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482304&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e5d57073-842f-42bb-9bf3-8d22594127d3\', \'multiverseId\': 482304}, \'multiverseid\': 482304}]', '[{\'name\': \'Gejagter Nachtmahr\', \'text\': \'Bedrohlich\\nWenn der Gejagte Nachtmahr ins Spiel kommt, legt ein Gegner deiner Wahl eine Todesberührung-Marke auf eine Kreatur, die er kontrolliert.\', \'type\': \'Kreatur — Nachtmahr\', \'flavor\': \'„Die furchterregendsten Monster inspirieren die epischsten Geschichten. Die epischsten Geschichten inspirieren die furchterregendsten Jäger."\\n—Rielle die Allwissende\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479871&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8a7b697b-208a-4516-a536-dbe5a0baf49c\', \'multiverseId\': 479871}, \'multiverseid\': 479871}, {\'name\': \'Pesadilla perseguida\', \'text\': \'Amenaza.\\nCuando la Pesadilla perseguida entre al campo de batalla, el oponente objetivo pone un contador de toque mortal sobre una criatura que controla.\', \'type\': \'Criatura — Pesadilla\', \'flavor\': \'"Los monstruos más crueles inspiran las mejores historias. Las mejores historias inspiran a los cazadores más crueles".\\n—Rielle, la Versada\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480130&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f25d3a53-50ad-493d-81af-f3e7f71cdb7d\', \'multiverseId\': 480130}, \'multiverseid\': 480130}, {\'name\': \'Cauchemar au rabais\', \'text\': "Menace\\nQuand le Cauchemar au rabais arrive sur le champ de bataille, l\'adversaire ciblé met un marqueur « contact mortel » sur une créature qu\'il contrôle.", \'type\': \'Créature : cauchemar\', \'flavor\': "« Les monstres les plus cruels inspirent les plus grandes histoires. Les plus grandes histoires inspirent les chasseurs les plus cruels. »\\n—Rielle, l\'éternisciente", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480389&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'717d4e34-0e0c-4d26-99cb-a5ab87fe6e13\', \'multiverseId\': 480389}, \'multiverseid\': 480389}, {\'name\': \'Incubo Braccato\', \'text\': "Minacciare\\nQuando l\'Incubo Braccato entra nel campo di battaglia, un avversario bersaglio mette un segnalino tocco letale su una creatura che controlla.", \'type\': \'Creatura — Incubo\', \'flavor\': \'"I mostri più crudeli ispirano i racconti più avvincenti. I racconti più avvincenti ispirano i cacciatori più crudeli."\\n—Rielle, l\\\'Onnisapiente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480648&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b46cab8a-10cb-4d56-8097-9eb204104eb6\', \'multiverseId\': 480648}, \'multiverseid\': 480648}, {\'name\': \'狩り立てられた悪夢\', \'text\': \'威迫\\n狩り立てられた悪夢が戦場に出たとき、対戦相手１人を対象とする。そのプレイヤーは、自分のコントロールしているクリーチャー１体の上に接死カウンターを１個置く。\', \'type\': \'クリーチャー — ナイトメア\', \'flavor\': \'「最悪の怪物が最高の物語を生む。最高の物語が最悪の狩人を生む。」\\n――常智のリエール\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480907&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d2f42e14-cb25-40a6-a8b4-4ff6f3ba3092\', \'multiverseId\': 480907}, \'multiverseid\': 480907}, {\'name\': \'사냥당하는 나이트메어\', \'text\': \'호전적\\n사냥당하는 나이트메어가 전장에 들어올 때, 상대를 목표로 정한다. 그 플레이어는 자신이 조종하는 생물 한 개에 치명타 카운터를 올려놓는다.\', \'type\': \'생물 — 나이트메어\', \'flavor\': \'"가장 잔인한 괴수들이 가장 엄청난 이야기들을 만들어낸다. 가장 엄청난 이야기들은 가장 잔인한 사냥꾼들을 만들어내고."\\n—지고의 현인, 리엘\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481166&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0a52c65e-36b3-4cfd-b94f-7c4fd95efa46\', \'multiverseId\': 481166}, \'multiverseid\': 481166}, {\'name\': \'Pesadelo Caçado\', \'text\': \'Ameaçar\\nQuando Pesadelo Caçado entra no campo de batalha, o oponente alvo coloca um marcador de toque mortífero em uma criatura que ele controla.\', \'type\': \'Criatura — Pesadelo\', \'flavor\': \'"Os monstros mais cruéis inspiram as maiores histórias. E as maiores histórias inspiram os caçadores mais cruéis."\\n— Rielle, a Onissapiente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481425&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dd3d745e-f691-43e2-a631-fc6dae445c33\', \'multiverseId\': 481425}, \'multiverseid\': 481425}, {\'name\': \'Загнанный Кошмар\', \'text\': \'Угроза\\nКогда Загнанный Кошмар выходит на поле битвы, целевой оппонент кладет один жетон Смертельного касания на существо под своим контролем.\', \'type\': \'Существо — Кошмар\', \'flavor\': \'«Самые жестокие монстры порождают самые захватывающие истории. Самые захватывающие истории порождают самых жестоких охотников».\\n— Риэлль, Вечномудрая\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481684&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0b4d42af-87ed-4e7c-b5ef-5b8d3987727c\', \'multiverseId\': 481684}, \'multiverseid\': 481684}, {\'name\': \'遭缉梦魇\', \'text\': \'威慑\\n当遭缉梦魇进战场时，目标对手在一个由其操控的生物上放置一个死触指示物。\', \'type\': \'生物 ～梦魇\', \'flavor\': \'「最凶残的怪兽留下最精彩的故事，最精彩的故事鼓舞最凶残的猎人。」\\n～全知利艾尔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481943&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6a7ce650-d005-492c-b892-b38c253edba0\', \'multiverseId\': 481943}, \'multiverseid\': 481943}, {\'name\': \'遭緝夢魘\', \'text\': \'威懾\\n當遭緝夢魘進戰場時，目標對手在一個由其操控的生物上放置一個死觸指示物。\', \'type\': \'生物 ～夢魘\', \'flavor\': \'「最凶殘的怪獸留下最精彩的故事，最精彩的故事鼓舞最凶殘的獵人。」\\n～全知利艾爾\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482202&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7aaa36f0-a192-4037-895c-a92eb62ec914\', \'multiverseId\': 482202}, \'multiverseid\': 482202}]', '[{\'name\': \'General Kudro von Drannith\', \'text\': \'Andere Menschen, die du kontrollierst, erhalten +1/+1.\\nImmer wenn General Kudro von Drannith oder ein anderer Mensch unter deiner Kontrolle ins Spiel kommt, schicke eine Karte deiner Wahl aus dem Friedhof eines Gegners ins Exil.\\n{2}, opfere zwei Menschen: Zerstöre eine Kreatur deiner Wahl mit Stärke 4 oder mehr.\', \'type\': \'Legendäre Kreatur — Mensch, Soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479966&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'478645dc-4d84-4e9e-9535-c6ef28b52897\', \'multiverseId\': 479966}, \'multiverseid\': 479966}, {\'name\': \'General Kudro de Drannith\', \'text\': \'Los otros Humanos que controlas obtienen +1/+1.\\nSiempre que el General Kudro de Drannith u otro Humano entre al campo de batalla bajo tu control, exilia la carta objetivo del cementerio de un oponente.\\n{2}, sacrificar dos Humanos: Destruye la criatura objetivo con fuerza de 4 o más.\', \'type\': \'Criatura legendaria — Soldado humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480225&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ed78d5de-b52d-44a4-a5d8-3df20184097c\', \'multiverseId\': 480225}, \'multiverseid\': 480225}, {\'name\': \'Général Koudro de Drannith\', \'text\': "Les autres humains que vous contrôlez gagnent +1/+1.\\nÀ chaque fois que le Général Koudro de Drannith ou un autre humain arrive sur le champ de bataille sous votre contrôle, exilez une carte ciblée depuis le cimetière d\'un adversaire.\\n{2}, sacrifiez deux humains : Détruisez une créature ciblée de force supérieure ou égale à 4.", \'type\': \'Créature légendaire : humain et soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480484&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'762a603f-348c-46ea-ad45-7c9fbc93135f\', \'multiverseId\': 480484}, \'multiverseid\': 480484}, {\'name\': \'Generale Kudro di Drannith\', \'text\': \'Gli altri Umani che controlli prendono +1/+1.\\nOgniqualvolta il Generale Kudro di Drannith o un altro Umano entrano nel campo di battaglia sotto il tuo controllo, esilia una carta bersaglio dal cimitero di un avversario.\\n{2}, Sacrifica due Umani: Distruggi una creatura bersaglio con forza pari o superiore a 4.\', \'type\': \'Creatura Leggendaria — Soldato Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480743&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9d529da9-6aec-4298-9599-948c02fa8fa1\', \'multiverseId\': 480743}, \'multiverseid\': 480743}, {\'name\': \'ドラニスのクードロ将軍\', \'text\': \'他の、あなたがコントロールしている人間は＋１/＋１の修整を受ける。\\nドラニスのクードロ将軍や他の人間が１体あなたのコントロール下で戦場に出るたび、対戦相手の墓地からカード１枚を対象とし、それを追放する。\\n{2}, 人間２体を生け贄に捧げる：パワーが４以上のクリーチャー１体を対象とし、それを破壊する。\', \'type\': \'伝説のクリーチャー — 人間・兵士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481002&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f780d5dc-75d2-4d4b-9992-e77f9e3e00b1\', \'multiverseId\': 481002}, \'multiverseid\': 481002}, {\'name\': \'드라니스의 장군 쿠드로\', \'text\': \'당신이 조종하는 다른 인간들은 +1/+1을 받는다.\\n드라니스의 장군 쿠드로 또는 다른 인간이 당신의 조종하에 전장에 들어올 때마다, 상대의 무덤에 있는 카드를 목표로 정한다. 그 카드를 추방한다.\\n{2}, 인간 두 개를 희생한다: 공격력이 4 이상인 생물을 목표로 정한다. 그 생물을 파괴한다.\', \'type\': \'전설적 생물 — 인간 병사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481261&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'adc2744b-05d5-483b-afdf-48579a644011\', \'multiverseId\': 481261}, \'multiverseid\': 481261}, {\'name\': \'General Kudro de Drannith\', \'text\': \'Os outros Humanos que você controla recebem +1/+1.\\nToda vez que General Kudro de Drannith ou outro Humano entrar no campo de batalha sob seu controle, exile o card alvo do cemitério de um oponente.\\n{2}, sacrifique dois Humanos: Destrua a criatura alvo com poder igual ou superior a 4.\', \'type\': \'Criatura Lendária — Humano Soldado\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481520&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b4e2731c-55e5-4cf3-a907-d93f24546405\', \'multiverseId\': 481520}, \'multiverseid\': 481520}, {\'name\': \'Генерал Кудро из Драннита\', \'text\': \'Другие перманенты с подтипом Человек под вашим контролем получают +1/+1.\\nКаждый раз, когда Генерал Кудро из Драннита или другой Человек выходит на поле битвы под вашим контролем, изгоните целевую карту из кладбища оппонента.\\n{2}, пожертвуйте два перманента с подтипом Человек: уничтожьте целевое существо с силой 4 или больше.\', \'type\': \'Легендарное Существо — Человек Солдат\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481779&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c2d5a7e3-1db2-4e9d-a5ad-1374006d2fc2\', \'multiverseId\': 481779}, \'multiverseid\': 481779}, {\'name\': \'卓尼斯的寇卓将军\', \'text\': \'由你操控的其他人类得+1/+1。\\n每当卓尼斯的寇卓将军或另一个人类在你的操控下进战场时，将目标牌从任一对手的坟墓场放逐。\\n{2}，牺牲两个人类：消灭目标力量等于或大于4的生物。\', \'type\': \'传奇生物 ～人类／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482038&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'98e951a0-0464-4b1e-b5bc-a2c306e9718a\', \'multiverseId\': 482038}, \'multiverseid\': 482038}, {\'name\': \'卓尼斯的寇卓將軍\', \'text\': \'由你操控的其他人類得+1/+1。\\n每當卓尼斯的寇卓將軍或另一個人類在你的操控下進戰場時，將目標牌從任一對手的墳墓場放逐。\\n{2}，犧牲兩個人類：消滅目標力量等於或大於4的生物。\', \'type\': \'傳奇生物 ～人類／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482297&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'80d47203-fbab-45da-8084-ab55bf9586e7\', \'multiverseId\': 482297}, \'multiverseid\': 482297}]', '[{\'name\': \'Genesis-Ultimatum\', \'text\': \'Schaue dir die obersten fünf Karten deiner Bibliothek an. Bringe davon eine beliebige Anzahl an bleibenden Karten ins Spiel und nimm den Rest auf deine Hand. Schicke das Genesis-Ultimatum ins Exil.\', \'type\': \'Hexerei\', \'flavor\': \'Kein menschliches Auge hat je die Geburt eines Apex-Monsters gesehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479968&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3b0926fb-4128-4617-9568-9dae95745c5d\', \'multiverseId\': 479968}, \'multiverseid\': 479968}, {\'name\': \'Ultimátum de génesis\', \'text\': \'Mira las cinco primeras cartas de tu biblioteca. Pon en el campo de batalla cualquier cantidad de cartas de permanente de entre ellas y el resto en tu mano. Exilia el Ultimátum de génesis.\', \'type\': \'Conjuro\', \'flavor\': \'Ningún humano ha contemplado el nacimiento de un monstruo alfa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480227&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6b038c2d-0b35-4f89-9639-9978257db5b3\', \'multiverseId\': 480227}, \'multiverseid\': 480227}, {\'name\': \'Ultimatum de genèse\', \'text\': "Regardez les cinq cartes du dessus de votre bibliothèque. Mettez n\'importe quel nombre de cartes de permanent parmi elles sur le champ de bataille, et le reste dans votre main. Exilez l\'Ultimatum de genèse.", \'type\': \'Rituel\', \'flavor\': "Aucun humain n\'a jamais assisté à la naissance d\'un monstre du zénith.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480486&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a7661398-8b21-4b21-a0e1-fef460fb2ff1\', \'multiverseId\': 480486}, \'multiverseid\': 480486}, {\'name\': \'Ultimatum della Genesi\', \'text\': "Guarda le prime cinque carte del tuo grimorio. Metti sul campo di battaglia un qualsiasi numero di carte permanente scelte tra esse e aggiungi le altre alla tua mano. Esilia l\'Ultimatum della Genesi.", \'type\': \'Stregoneria\', \'flavor\': \'Nessun occhio umano ha mai assistito alla nascita di un mostro alfa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480745&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fefce989-6158-4f73-ad84-e91460c42a5f\', \'multiverseId\': 480745}, \'multiverseid\': 480745}, {\'name\': \'発生の根本原理\', \'text\': \'あなたのライブラリーの一番上からカードを５枚見る。その中から望む枚数のパーマネント・カードを戦場に出し、残りをあなたの手札に加える。発生の根本原理を追放する。\', \'type\': \'ソーサリー\', \'flavor\': \'頂点の怪物の誕生を目撃した人間はいない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481004&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'77d80fbd-51cd-4614-a7ae-88248adcda78\', \'multiverseId\': 481004}, \'multiverseid\': 481004}, {\'name\': \'기원의 최후통첩\', \'text\': \'당신의 서고 맨 위 카드 다섯 장을 본다. 그 중 지속물 카드를 원하는 수만큼 전장에 놓고 나머지는 당신의 손으로 가져간다. 기원의 최후통첩을 추방한다.\', \'type\': \'집중마법\', \'flavor\': \'괴수의 정점이 탄생하는 것을 목격한 인간은 없다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481263&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c2d9beec-e0ad-4ac4-b84d-adc9b2283a5f\', \'multiverseId\': 481263}, \'multiverseid\': 481263}, {\'name\': \'Ultimato da Gênese\', \'text\': \'Olhe os cinco cards do topo de seu grimório. Coloque qualquer número de cards de permanente dentre eles no campo de batalha e o restante em sua mão. Exile Ultimato da Gênese.\', \'type\': \'Feitiço\', \'flavor\': \'Olhos humanos jamais testemunharam o nascimento de um monstro do ápice.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481522&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f50b1ec1-71de-45e8-8200-b203545cba54\', \'multiverseId\': 481522}, \'multiverseid\': 481522}, {\'name\': \'Ультиматум Порождения\', \'text\': \'Посмотрите пять верхних карт вашей библиотеки. Положите любое количество находящихся среди них карт перманентов на поле битвы, а остальные — в вашу руку. Изгоните Ультиматум Порождения.\', \'type\': \'Волшебство\', \'flavor\': \'Никто из людей никогда не видел, как рождается чудовище, становящееся венцом своего триома.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481781&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'056f039c-1be4-434b-b7fd-90da205700e1\', \'multiverseId\': 481781}, \'multiverseid\': 481781}, {\'name\': \'创生通牒\', \'text\': \'检视你牌库顶的五张牌。将其中任意数量的永久物牌放进战场，其余则置于你手上。放逐创生通牒。\', \'type\': \'法术\', \'flavor\': \'未有人类亲眼见证霸兽诞生。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482040&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'46743639-ec97-463e-bd5c-4773c4b38d6f\', \'multiverseId\': 482040}, \'multiverseid\': 482040}, {\'name\': \'創生通牒\', \'text\': \'檢視你牌庫頂的五張牌。將其中任意數量的永久物牌放進戰場，其餘則置於你手上。放逐創生通牒。\', \'type\': \'巫術\', \'flavor\': \'未有人類親眼見證霸獸誕生。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482299&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ed5555bc-a101-418b-8569-e66636a6bd72\', \'multiverseId\': 482299}, \'multiverseid\': 482299}]', '[{\'name\': \'Gesang der Schöpfung\', \'text\': \'Du darfst in jedem deiner Züge ein zusätzliches Land spielen.\\nImmer wenn du einen Zauberspruch wirkst, ziehe zwei Karten.\\nZu Beginn deines Endsegments wirfst du alle Karten aus deiner Hand ab.\', \'type\': \'Verzauberung\', \'flavor\': \'Sie weinte, nicht aus tiefem Verständnis, sondern aus friedvoller Dankbarkeit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479989&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4b001c9b-5f88-4280-a59e-96575151112c\', \'multiverseId\': 479989}, \'multiverseid\': 479989}, {\'name\': \'Canción de la creación\', \'text\': \'Puedes jugar una tierra adicional en cada uno de tus turnos.\\nSiempre que lances un hechizo, roba dos cartas.\\nAl comienzo de tu paso final, descarta tu mano.\', \'type\': \'Encantamiento\', \'flavor\': \'Lloró, no por lograr un entendimiento perfecto, sino por una gratitud serena.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480248&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8d2994ea-4bf4-4fbe-9143-72131c2202af\', \'multiverseId\': 480248}, \'multiverseid\': 480248}, {\'name\': \'Chant de la Création\', \'text\': \'Vous pouvez jouer un terrain supplémentaire pendant chacun de vos tours.\\nÀ chaque fois que vous lancez un sort, piochez deux cartes.\\nAu début de votre étape de fin, défaussez-vous de votre main.\', \'type\': \'Enchantement\', \'flavor\': "Elle se mit à pleurer, non pas parce qu\'elle comprenait parfaitement, mais simplement pour exprimer sa gratitude.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480507&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'07ea541a-6e56-4f37-bca0-0f65bed9eed8\', \'multiverseId\': 480507}, \'multiverseid\': 480507}, {\'name\': \'Canto della Creazione\', \'text\': "Puoi giocare una terra addizionale in ognuno dei tuoi turni.\\nOgniqualvolta lanci una magia, pesca due carte.\\nAll\'inizio della tua sottofase finale, scarta la tua mano.", \'type\': \'Incantesimo\', \'flavor\': \'Piangeva, non per la comprensione perfetta, ma per serena gratitudine.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480766&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ef33249e-9633-4d58-b0a5-1b0665610c35\', \'multiverseId\': 480766}, \'multiverseid\': 480766}, {\'name\': \'創造の歌\', \'text\': \'あなたの各ターンに、あなたは追加の土地を１つプレイしてもよい。\\nあなたが呪文を唱えるたび、カードを２枚引く。\\nあなたの終了ステップの開始時に、あなたの手札を捨てる。\', \'type\': \'エンチャント\', \'flavor\': \'彼女は涙を流していた。完全に理解した訳ではなかったが、穏やかな感謝の心が湧き上がったのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481025&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'92100405-c733-45ff-a95b-73f1253c0388\', \'multiverseId\': 481025}, \'multiverseid\': 481025}, {\'name\': \'창조의 노래\', \'text\': \'당신은 당신의 각 턴에 대지 한 개를 추가로 플레이할 수 있다.\\n당신이 주문을 발동할 때마다, 카드 두 장을 뽑는다.\\n당신의 종료단 시작에, 당신의 손을 버린다.\', \'type\': \'부여마법\', \'flavor\': \'그녀는 완벽한 이해가 아니라, 평온한 감사로 눈물을 흘렸다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481284&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'eeff48a9-4502-41fb-8f56-2d47652c9411\', \'multiverseId\': 481284}, \'multiverseid\': 481284}, {\'name\': \'Canção da Criação\', \'text\': \'Você pode jogar um terreno adicional em cada um de seus turnos.\\nToda vez que você conjurar uma mágica, compre dois cards.\\nNo início da sua etapa final, descarte a sua mão.\', \'type\': \'Encantamento\', \'flavor\': \'E ela chorou, não por um entendimento perfeito, mas por uma serena gratidão.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481543&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5680b00b-8831-42b3-9b54-f1bea78b5ee1\', \'multiverseId\': 481543}, \'multiverseid\': 481543}, {\'name\': \'Песнь Творения\', \'text\': \'Вы можете разыгрывать одну дополнительную землю в каждом из ваших ходов.\\nКаждый раз, когда вы разыгрываете заклинание, возьмите две карты.\\nВ начале вашего заключительного шага сбросьте вашу руку.\', \'type\': \'Чары\', \'flavor\': \'Она заплакала — не от безупречного понимания, но от умиротворяющей благодарности.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481802&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3abd2d9b-a209-44da-b33b-0f047c5f428f\', \'multiverseId\': 481802}, \'multiverseid\': 481802}, {\'name\': \'创生颂曲\', \'text\': \'你在自己的每个回合中可以额外使用一个地。\\n每当你施放咒语时，抓两张牌。\\n在你的结束步骤开始时，弃掉你的手牌。\', \'type\': \'结界\', \'flavor\': \'她虽然并未完全领悟颂歌真谛，却也折服于曲调间的祥和之景，不禁热泪盈眶。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482061&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0f5f6c46-b8ba-4653-93cf-f637b01d07f2\', \'multiverseId\': 482061}, \'multiverseid\': 482061}, {\'name\': \'創生頌曲\', \'text\': \'你在自己的每個回合中可以額外使用一個地。\\n每當你施放咒語時，抽兩張牌。\\n在你的結束步驟開始時，棄掉你的手牌。\', \'type\': \'結界\', \'flavor\': \'她雖然並未完全領悟頌歌真諦，卻也折服於曲調間的祥和之景，不禁熱淚盈眶。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482320&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'da49cad7-5c2b-464e-8f87-41754f51928b\', \'multiverseId\': 482320}, \'multiverseid\': 482320}]', '[{\'name\': \'Geschärfte Reflexe\', \'text\': \'Eine Kreatur deiner Wahl erhält +1/+0 bis zum Ende des Zuges. Lege eine Erstschlag-Marke auf sie.\', \'type\': \'Spontanzauber\', \'flavor\': \'Einige Kristalle glühen bei der Anwesenheit von Monstern und bilden so ein praktisches Warnsystem. Einige Monster haben gelernt, schneller als das Licht zu rennen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479902&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d7e98893-edf9-4f91-9563-be6d038ec946\', \'multiverseId\': 479902}, \'multiverseid\': 479902}, {\'name\': \'Reflejos agudizados\', \'text\': \'La criatura objetivo obtiene +1/+0 hasta el final del turno. Pon un contador de dañar primero sobre ella.\', \'type\': \'Instantáneo\', \'flavor\': \'Algunos cristales brillan ante la presencia de monstruos, formando un práctico sistema de advertencia. Pero algunos monstruos han aprendido a ser más rápidos que la luz.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480161&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'07911d7f-49a9-497d-9445-64b4987b672b\', \'multiverseId\': 480161}, \'multiverseid\': 480161}, {\'name\': \'Réflexes augmentés\', \'text\': "La créature ciblée gagne +1/+0 jusqu\'à la fin du tour. Mettez un marqueur « initiative » sur elle.", \'type\': \'Éphémère\', \'flavor\': "Certains cristaux brillent en présence de monstres, ce qui permet de mettre en place un système d\'alarme efficace. Mais certains monstres ont appris à aller plus vite que la lumière.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480420&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a302f204-2ee2-4d61-ba90-325c8a627e5b\', \'multiverseId\': 480420}, \'multiverseid\': 480420}, {\'name\': \'Riflessi Potenziati\', \'text\': \'Una creatura bersaglio prende +1/+0 fino alla fine del turno. Metti un segnalino attacco improvviso su di essa.\', \'type\': \'Istantaneo\', \'flavor\': \'Alcuni cristalli si illuminano in presenza di mostri, creando un pratico sistema di allerta. Qualche mostro ha imparato a correre più veloce della luce.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480679&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ab1db573-52bf-4177-9eac-de6b5ab30039\', \'multiverseId\': 480679}, \'multiverseid\': 480679}, {\'name\': \'反射神経の亢進\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋１/＋０の修整を受ける。それの上に先制攻撃カウンターを１個置く。\', \'type\': \'インスタント\', \'flavor\': \'水晶の中には怪物の存在で光るものがあり、便利な警報として使える。ただし、その光よりも速く迫ることを覚えた怪物もいる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480938&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'db586ccc-af32-4de0-9d61-af8235aac08a\', \'multiverseId\': 480938}, \'multiverseid\': 480938}, {\'name\': \'고조된 반사신경\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 +1/+0을 받는다. 그 생물에 선제공격 카운터를 올려놓는다.\', \'type\': \'순간마법\', \'flavor\': \'몇몇 수정은 괴수가 나타나면 빛을 발해, 간편한 경보 체계를 형성해 준다. 몇몇 괴수들은 그 빛보다 빨리 뛰어드는 법을 배웠다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481197&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f10179aa-5c9c-49fe-83cd-5160d30bd5f5\', \'multiverseId\': 481197}, \'multiverseid\': 481197}, {\'name\': \'Reflexos Aguçados\', \'text\': \'A criatura alvo recebe +1/+0 até o final do turno. Coloque um marcador de iniciativa nela.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Alguns cristais brilham na presença de monstros, formando um conveniente sistema de alerta. Alguns monstros aprenderam a chegar antes da luz.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481456&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'13ec4570-c623-4964-8f24-c5757f5abf1d\', \'multiverseId\': 481456}, \'multiverseid\': 481456}, {\'name\': \'Обостренные Рефлексы\', \'text\': \'Целевое существо получает +1/+0 до конца хода. Положите на него один жетон Первого удара.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Некоторые кристаллы мерцают, когда рядом чудовища, став удобным средством предупреждения. Некоторые чудовища научились обгонять свет.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481715&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2e9bbe69-de4c-4d80-85c3-ae9c92bfbb5e\', \'multiverseId\': 481715}, \'multiverseid\': 481715}, {\'name\': \'迅敏反应\', \'text\': \'目标生物得+1/+0直到回合结束。在其上放置一个先攻指示物。\', \'type\': \'瞬间\', \'flavor\': \'有些水晶会在怪兽出现时发出光芒，从而形成有效的预警系统。而有些怪兽则已学会跑得比光更快。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481974&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'58d67358-e8b3-40a3-8e9d-70427a851a79\', \'multiverseId\': 481974}, \'multiverseid\': 481974}, {\'name\': \'迅敏反應\', \'text\': \'目標生物得+1/+0直到回合結束。在其上放置一個先攻指示物。\', \'type\': \'瞬間\', \'flavor\': \'有些水晶會在怪獸出現時發出光芒，從而形成有效的預警系統。而有些怪獸則已學會跑得比光更快。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482233&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ccaa02bc-56a7-4a62-a5be-cb925730add7\', \'multiverseId\': 482233}, \'multiverseid\': 482233}]', '[{\'name\': \'Gier nach Blut\', \'text\': \'Eine Kreatur deiner Wahl, die du kontrollierst, kämpft gegen eine Kreatur deiner Wahl, die du nicht kontrollierst. (Jede der Kreaturen fügt der anderen Schadenspunkte in Höhe ihrer Stärke zu.)\\nUmwandlung {1} ({1}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Hexerei\', \'flavor\': \'Lukkas Gefährtenschaft bot nicht nur Freundschaft, sondern auch die mächtigste Waffe in seinem Arsenal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479901&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'adce5084-6528-495c-b336-39508d105c9d\', \'multiverseId\': 479901}, \'multiverseid\': 479901}, {\'name\': \'A por sangre\', \'text\': \'La criatura objetivo que controlas lucha contra la criatura objetivo que no controlas. (Cada una hace un daño igual a su fuerza a la otra.)\\nCiclo {1}. ({1}, descartar esta carta: Roba una carta.)\', \'type\': \'Conjuro\', \'flavor\': \'El vínculo de Lukka no solo le proporcionó amistad, sino también el arma más poderosa de su arsenal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480160&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f49a4587-cfc0-44ba-a287-916c0acc82e7\', \'multiverseId\': 480160}, \'multiverseid\': 480160}, {\'name\': \'Choix du sang\', \'text\': "Une créature ciblée que vous contrôlez se bat contre une créature ciblée que vous ne contrôlez pas. (Chacune inflige un nombre de blessures égal à sa force à l\'autre.)\\nRecyclage {1} ({1}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Rituel\', \'flavor\': "Le lien de Lukka lui apportait à la fois un ami et l\'arme la plus puissante de son arsenal.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480419&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'86e3102c-707c-4617-930b-73e66c5b0c69\', \'multiverseId\': 480419}, \'multiverseid\': 480419}, {\'name\': \'Bramare il Sangue\', \'text\': "Una creatura bersaglio che controlli lotta con una creatura bersaglio che non controlli. (Ogni creatura infligge all\'altra danno pari alla propria forza.)\\nCiclo {1} ({1}, Scarta questa carta: Pesca una carta.)", \'type\': \'Stregoneria\', \'flavor\': "Il vincolo di Lukka gli garantiva non solo amicizia, ma anche l\'arma più potente nel suo arsenale.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480678&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'efb45ee7-2bd5-4220-a94e-bca74b8f0fec\', \'multiverseId\': 480678}, \'multiverseid\': 480678}, {\'name\': \'血の希求\', \'text\': \'あなたがコントロールしているクリーチャー１体とあなたがコントロールしていないクリーチャー１体を対象とする。その前者はその後者と格闘を行う。（それぞれはもう一方に自身のパワーに等しい点数のダメージを与える。）\\nサイクリング{1}（{1}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'ソーサリー\', \'flavor\': \'ルーカの絆は友情だけでなく、最強の武器をももたらした。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480937&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'72a1e3b2-8d32-4ceb-8e40-db5fef836045\', \'multiverseId\': 480937}, \'multiverseid\': 480937}, {\'name\': \'피 노리기\', \'text\': \'당신이 조종하는 생물과 당신이 조종하지 않는 생물을 목표로 정한다. 그 두 생물은 서로 싸운다. (각 생물은 서로에게 각자의 공격력만큼의 피해를 입힌다.)\\n순환 {1} ({1}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'집중마법\', \'flavor\': \'루카의 유대는 우정뿐만이 아니라 그가 사용할 수 있는 가장 강력한 무기를 제공한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481196&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'04d6c670-7cde-4549-a49c-5b367f446c80\', \'multiverseId\': 481196}, \'multiverseid\': 481196}, {\'name\': \'Dar o Sangue\', \'text\': \'A criatura alvo que você controla luta com a criatura alvo que você não controla. (Cada uma causa dano igual ao seu poder à outra.)\\nReciclar {1} ({1}, descarte este card: Compre um card.)\', \'type\': \'Feitiço\', \'flavor\': \'O vínculo de Lukka não lhe deu somente amizade, mas também a arma mais poderosa em seu arsenal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481455&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c0d033c2-2b96-457b-852e-c9281c8311dd\', \'multiverseId\': 481455}, \'multiverseid\': 481455}, {\'name\': \'Жажда Крови\', \'text\': \'Целевое существо под вашим контролем дерется с целевым существом не под вашим контролем. (Они наносят друг другу повреждения, равные своей силе.)\\nЦикл {1} ({1}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Волшебство\', \'flavor\': \'Узы принесли Лукке не только дружбу, но и самое могущественное оружие в его арсенале.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481714&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'38170638-a215-43d3-8e1e-1b130237e167\', \'multiverseId\': 481714}, \'multiverseid\': 481714}, {\'name\': \'直扑活物\', \'text\': \'目标由你操控的生物与目标不由你操控的生物互斗。（它们各向对方造成等同于本身力量的伤害。）\\n循环{1}（{1}，弃掉此牌：抓一张牌。）\', \'type\': \'法术\', \'flavor\': \'卢卡的羁绊不仅让他与野兽结下深厚友谊，还让他手中多了一把强大武器。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481973&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'928167d9-f3dc-498b-a93b-5cd4ac8729ec\', \'multiverseId\': 481973}, \'multiverseid\': 481973}, {\'name\': \'直撲活物\', \'text\': \'目標由你操控的生物與目標不由你操控的生物互鬥。（它們各向對方造成等同於本身力量的傷害。）\\n循環{1}（{1}，棄掉此牌：抽一張牌。）\', \'type\': \'巫術\', \'flavor\': \'盧卡的羈絆不僅讓他與野獸結下深厚友誼，還讓他手中多了一把強大武器。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482232&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a1b54462-f377-463d-ba76-14d6b87ed0c5\', \'multiverseId\': 482232}, \'multiverseid\': 482232}]', '[{\'name\': \'Glimmerqualle\', \'text\': \'Fliegend\\n{1}{U}: Enttappe die Glimmerqualle\', \'type\': \'Kreatur — Elementarwesen, Qualle\', \'flavor\': \'„Ihre Pfade sind kein Zufall, aber sie fließen nicht mit dem Wind. Könnten sie Strömungen der kristallinen Energie folgen?"\\n—Naireh, Ketria-Elementalist\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479832&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'71e4d306-60a9-460c-a772-a2c02ff3789e\', \'multiverseId\': 479832}, \'multiverseid\': 479832}, {\'name\': \'Campabrilla\', \'text\': \'Vuela.\\n{1}{U}: Endereza la Campabrilla.\', \'type\': \'Criatura — Medusa elemental\', \'flavor\': \'"Sus caminos no son aleatorios, pero no flotan con el viento. ¿Podrían estar siguiendo las corrientes de la energía cristalina?".\\n—Naireh, elementalista de Ketria\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480091&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'023b96f6-b892-43cf-b7f2-5fbee56954cb\', \'multiverseId\': 480091}, \'multiverseid\': 480091}, {\'name\': \'Ombrelle luisante\', \'text\': "Vol\\n{1}{U} : Dégagez l\'Ombrelle luisante.", \'type\': \'Créature : élémental et méduse\', \'flavor\': "« Elles ne volent pas au hasard, mais elles ne suivent pas le vent. Peut-être sont-elles attirées par les pics d\'énergie cristalline ? »\\n—Naireh, élémentaliste de Ketria", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480350&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'37bc4284-4f5a-45ea-a759-3696b978346d\', \'multiverseId\': 480350}, \'multiverseid\': 480350}, {\'name\': \'Campana Scintillante\', \'text\': \'Volare\\n{1}{U}: STAPpa la Campana Scintillante.\', \'type\': \'Creatura — Medusa Elementale\', \'flavor\': \'"I loro spostamenti non sono casuali, ma non fluttuano in base al vento. Forse seguono gli impulsi dell\\\'energia cristallina?"\\n—Naireh, elementalista di Ketria\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480609&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a4789fa6-74ae-44a9-a8ac-2251236d2bc2\', \'multiverseId\': 480609}, \'multiverseid\': 480609}, {\'name\': \'微光クラゲ\', \'text\': \'飛行\\n{1}{U}：微光クラゲをアンタップする。\', \'type\': \'クリーチャー — エレメンタル・クラゲ\', \'flavor\': \'「彼らの進む方向はでたらめじゃないわ。でも、風に乗っているわけでもない。水晶エネルギーの波動に従っているのかしら？」\\n――ケトリアの精霊術士、ネイレ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480868&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0ceba5a3-9655-4c7c-ac2e-f489c22a82a8\', \'multiverseId\': 480868}, \'multiverseid\': 480868}, {\'name\': \'반짝종\', \'text\': \'비행\\n{1}{U}: 반짝종을 언탭한다.\', \'type\': \'생물 — 정령 해파리\', \'flavor\': \'"그것들의 경로는 무질서하지 않지만, 바람에 떠다니는 것도 아니야. 수정의 에너지가 솟구치는 것을 따라가고 있는 것일까?"\\n—케트리아 정령술사, 나이레\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481127&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'45d46626-5683-4859-a69c-4fd69e565d36\', \'multiverseId\': 481127}, \'multiverseid\': 481127}, {\'name\': \'Sino-de-luz\', \'text\': \'Voar\\n{1}{U}: Desvire Sino-de-luz.\', \'type\': \'Criatura — Elemental Água-viva\', \'flavor\': \'"Suas trajetórias não são aleatórias, mas não flutuam ao vento. Poderiam estar seguindo surtos de energia cristalina?"\\n— Naireh, elementalista de Ketria\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481386&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4b67398c-0d3d-40ec-a2d5-33e536fc0ced\', \'multiverseId\': 481386}, \'multiverseid\': 481386}, {\'name\': \'Переливчатый Колокол\', \'text\': \'Полет\\n{1}{U}: разверните Переливчатый Колокол.\', \'type\': \'Существо — Элементаль Медуза\', \'flavor\': \'«Они передвигаются не хаотично, но и не плывут по ветру. Быть может, они следуют за выплесками кристалльной энергии?»\\n— Найре, элементалист из Кетрии\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481645&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4a24e102-3318-4705-b822-115bfe1e73ba\', \'multiverseId\': 481645}, \'multiverseid\': 481645}, {\'name\': \'烁体浮蜇\', \'text\': \'飞行\\n{1}{U}：重置烁体浮蜇。\', \'type\': \'生物 ～元素／水母\', \'flavor\': \'「它们的行进路线并非毫无规律，但却也不是随风飘行。也许是跟着水晶能量的起伏而动？」\\n～克崔亚元素师奈拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481904&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cce15088-c4e0-4ac8-9a28-3f9b7e22152b\', \'multiverseId\': 481904}, \'multiverseid\': 481904}, {\'name\': \'爍體浮蜇\', \'text\': \'飛行\\n{1}{U}：重置爍體浮蜇。\', \'type\': \'生物 ～元素／水母\', \'flavor\': \'「牠們的行進路線並非毫無規律，但卻也不是隨風飄行。也許是跟著水晶能量的起伏而動？」\\n～克崔亞元素師奈拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482163&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'758c33c7-1a2a-4233-a57a-4e94b8a4f0bb\', \'multiverseId\': 482163}, \'multiverseid\': 482163}]', '[{\'name\': \'Glimmstein-Einsiedlerspinne\', \'text\': \'Mutation {3}{G} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\nReichweite\\nImmer wenn diese Kreatur mutiert, lege zwei +1/+1-Marken auf sie.\', \'type\': \'Kreatur — Spinne\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479935&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ed2e123f-bd0a-4ad7-9e4c-a76bcf3714f6\', \'multiverseId\': 479935}, \'multiverseid\': 479935}, {\'name\': \'Reclusa de las rocas irradialuz\', \'text\': \'Mutación {3}{G}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\nAlcance.\\nSiempre que esta criatura mute, pon dos contadores +1/+1 sobre ella.\', \'type\': \'Criatura — Araña\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480194&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'71ac4eb9-0ec3-458f-bd65-5c97bed46363\', \'multiverseId\': 480194}, \'multiverseid\': 480194}, {\'name\': \'Recluse des nitescenthes\', \'text\': "Mutation {3}{G} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\nPortée\\nÀ chaque fois que cette créature subit une mutation, mettez deux marqueurs +1/+1 sur elle.", \'type\': \'Créature : araignée\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480453&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d8479d64-e5f1-47ac-adcb-004c81e58de8\', \'multiverseId\': 480453}, \'multiverseid\': 480453}, {\'name\': \'Eremita della Splendipietra\', \'text\': \'Mutazione {3}{G} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\nRaggiungere\\nOgniqualvolta questa creatura muta, metti due segnalini +1/+1 su di essa.\', \'type\': \'Creatura — Ragno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480712&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9abe69de-d1e1-4aee-8fc5-03d1fc675f1e\', \'multiverseId\': 480712}, \'multiverseid\': 480712}, {\'name\': \'輝き石のイトグモ\', \'text\': \'変容{3}{G}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\n到達\\nこのクリーチャーが変容するたび、これの上に＋１/＋１カウンターを２個置く。\', \'type\': \'クリーチャー — 蜘蛛\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480971&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c304073a-a406-4d31-bbd3-aa2936dbfa5e\', \'multiverseId\': 480971}, \'multiverseid\': 480971}, {\'name\': \'발광석 은둔거미\', \'text\': \'돌연변이화 {3}{G} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n대공\\n이 생물이 돌연변이화할 때마다, 이 생물에 +1/+1 카운터 두 개를 올려놓는다.\', \'type\': \'생물 — 거미\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481230&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5fa92270-611f-4ba5-b824-37e5a769979f\', \'multiverseId\': 481230}, \'multiverseid\': 481230}, {\'name\': \'Aranha-violino do Luminólito\', \'text\': \'{3}{G} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\nAlcance\\nToda vez que esta criatura sofrer mutação, coloque dois marcadores +1/+1 nela.\', \'type\': \'Criatura — Aranha\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481489&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'87d1ff79-9fcd-4948-9bf3-02f317a7de5f\', \'multiverseId\': 481489}, \'multiverseid\': 481489}, {\'name\': \'Отшельник Светокамня\', \'text\': \'Мутация {3}{G} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\nЗахват\\nКаждый раз, когда это существо мутирует, положите на него два жетона +1/+1.\', \'type\': \'Существо — Паук\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481748&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f84f4b26-98f4-46e6-ac34-8aab182a075c\', \'multiverseId\': 481748}, \'multiverseid\': 481748}, {\'name\': \'光石隐士\', \'text\': \'合变{3}{G}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n延势\\n每当此生物合变时，在其上放置两个+1/+1指示物。\', \'type\': \'生物 ～蜘蛛\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482007&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'080cbef0-3d77-46d7-8739-10bc5dd40265\', \'multiverseId\': 482007}, \'multiverseid\': 482007}, {\'name\': \'光石隱士\', \'text\': \'合變{3}{G}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n延勢\\n每當此生物合變時，在其上放置兩個+1/+1指示物。\', \'type\': \'生物 ～蜘蛛\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482266&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'de700fda-a26f-4fdf-8690-034c9329bdc7\', \'multiverseId\': 482266}, \'multiverseid\': 482266}]', '[{\'name\': \'Glühender Pfeilhagel\', \'text\': \'Der Glühende Pfeilhagel fügt allen Kreaturen, die deine Gegner kontrollieren, je 1 Schadenspunkt zu.\', \'type\': \'Hexerei\', \'flavor\': \'„Frag mich nicht, was zu tun ist, wenn du danebenschießt. Es sind Stachelsceadas. Schieß einfach nicht daneben."\\n—Orthion, Lavagrund-Hauptmann\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479886&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4c20925f-1bad-423d-aa3b-e4a60b653c93\', \'multiverseId\': 479886}, \'multiverseid\': 479886}, {\'name\': \'Descarga ardiente\', \'text\': \'La Descarga ardiente hace 1 punto de daño a cada criatura que controlan tus oponentes.\', \'type\': \'Conjuro\', \'flavor\': \'"No me preguntes qué hacer si no aciertas. Son dracoguijones. Acierta".\\n—Orthion, capitán de Bordelava\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480145&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9a4c6d8b-512e-4758-b38e-8da20758c025\', \'multiverseId\': 480145}, \'multiverseid\': 480145}, {\'name\': \'Volée brûlante\', \'text\': \'La Volée brûlante inflige 1 blessure à chaque créature que vos adversaires contrôlent.\', \'type\': \'Rituel\', \'flavor\': \'« Ne me demandez pas ce qui arrive si vous manquez la cible. Ce sont des drakôndards. Ne manquez surtout pas la cible. »\\n—Orthion, capitaine de Bourg-sur-Lave\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480404&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f75a98df-6484-4e19-8bd0-428d5656bf48\', \'multiverseId\': 480404}, \'multiverseid\': 480404}, {\'name\': \'Raffica Rovente\', \'text\': \'La Raffica Rovente infligge 1 danno a ogni creatura controllata dai tuoi avversari.\', \'type\': \'Stregoneria\', \'flavor\': \'"Non chiedermi cosa fare se manchi il bersaglio. Sono draghetti pungenti... Non mancarli."\\n—Orthion, capitano di Lavariva\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480663&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e68d5bf5-985a-47c7-9a58-0a445d66632a\', \'multiverseId\': 480663}, \'multiverseid\': 480663}, {\'name\': \'猛火の斉射\', \'text\': \'猛火の斉射は対戦相手がコントロールしている各クリーチャーにそれぞれ１点のダメージを与える。\', \'type\': \'ソーサリー\', \'flavor\': \'「外したらどうしようなどと考えるな。あいつらは棘ドレイクだ。絶対に外すな。」\\n――ラバブリンクの隊長、オーシオン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480922&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9fafb920-6010-4fe2-aef7-fbdb11dc8f3e\', \'multiverseId\': 480922}, \'multiverseid\': 480922}, {\'name\': \'불화살 일제사격\', \'text\': \'불화살 일제사격은 당신의 상대들이 조종하는 각 생물에게 피해 1점을 입힌다.\', \'type\': \'집중마법\', \'flavor\': \'"명중하지 못했을 때 뭘 해야 하는지 묻지 마라. 저것들은 쏘는 드레이크야. 명중시켜라."\\n—용암가장자리 대장, 오르티온\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481181&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a7d4cf3b-e74b-4e57-8add-33010e6e93c1\', \'multiverseId\': 481181}, \'multiverseid\': 481181}, {\'name\': \'Salva Incandescente\', \'text\': \'Salva Incandescente causa 1 ponto de dano a cada criatura que seus oponentes controlam.\', \'type\': \'Feitiço\', \'flavor\': \'"Não me pergunte o que fazer se você errar. São dracoferrões. Não erre."\\n— Orthion, capitão de Beiralava\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481440&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e9f4ae9a-b6ec-4b5f-9dc9-413233070573\', \'multiverseId\': 481440}, \'multiverseid\': 481440}, {\'name\': \'Пылающий Залп\', \'text\': \'Пылающий Залп наносит 1 повреждение каждому существу под контролем ваших оппонентов.\', \'type\': \'Волшебство\', \'flavor\': \'«Не спрашивай меня, что делать, если промахнешься. Это жалящие дрейки. Не надо промахиваться».\\n— Ортион, капитан Лавобрега\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481699&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'96fcae25-0358-4a3a-b072-f02d08b6dd73\', \'multiverseId\': 481699}, \'multiverseid\': 481699}, {\'name\': \'烈焰齐射\', \'text\': \'烈焰齐射向由对手操控的每个生物各造成1点伤害。\', \'type\': \'法术\', \'flavor\': \'「别问我没打中该怎么办。那可是刺针龙兽。给我中。」\\n～熔缘城队长欧席因\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481958&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d7ffccee-b65a-4157-973c-eb6c0aa76583\', \'multiverseId\': 481958}, \'multiverseid\': 481958}, {\'name\': \'烈焰齊射\', \'text\': \'烈焰齊射向由對手操控的每個生物各造成1點傷害。\', \'type\': \'巫術\', \'flavor\': \'「別問我沒打中該怎麼辦。那可是刺針龍獸。給我中。」\\n～熔緣城隊長歐席因\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482217&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d4fd9ea1-975a-413b-bf34-2005b56a2a87\', \'multiverseId\': 482217}, \'multiverseid\': 482217}]', '[{\'name\': \'Grenzfeldwebel\', \'text\': \'Immer wenn der Grenzfeldwebel angreift, erhalten andere Menschen, die du kontrollierst, +1/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'„Los, Soldat! Ich möchte vor dem Mittag noch einen Pelz an meiner Wand!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479806&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'61ba5a48-2bba-43cb-9ff1-9ea19b1fe2d1\', \'multiverseId\': 479806}, \'multiverseid\': 479806}, {\'name\': \'Sargento del perímetro\', \'text\': \'Siempre que el Sargento del perímetro ataque, los otros Humanos que controlas obtienen +1/+0 hasta el final del turno.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'"¡Adelante, soldado! ¡Quiero una piel en la pared antes del almuerzo!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480065&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'174d3c31-bcca-406b-9db0-4ac42dbcda72\', \'multiverseId\': 480065}, \'multiverseid\': 480065}, {\'name\': \'Sergent du périmètre\', \'text\': "À chaque fois que le Sergent du périmètre attaque, les autres humains que vous contrôlez gagnent +1/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : humain et soldat\', \'flavor\': \'« En avant, soldat ! Je veux voir une peau de bête sur mon mur avant le déjeuner ! »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480324&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'909115b9-183b-4885-b1fe-0ca10fb6957b\', \'multiverseId\': 480324}, \'multiverseid\': 480324}, {\'name\': \'Sergente del Perimetro\', \'text\': \'Ogniqualvolta il Sergente del Perimetro attacca, gli altri Umani che controlli prendono +1/+0 fino alla fine del turno.\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'"Datti da fare, soldato! Voglio una pelliccia sulla mia parete prima di pranzo!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480583&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cae7e2bf-c15c-4f82-b139-c0cca2e08894\', \'multiverseId\': 480583}, \'multiverseid\': 480583}, {\'name\': \'防衛線の兵長\', \'text\': \'防衛線の兵長が攻撃するたび、ターン終了時まで、他の、あなたがコントロールしている人間は＋１/＋０の修整を受ける。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'「お前ら、加勢しろ！昼食までに壁に飾る毛皮が欲しいんだ！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480842&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'787de520-dfb5-4fba-be68-0a4522b35a23\', \'multiverseId\': 480842}, \'multiverseid\': 480842}, {\'name\': \'경계 지역 부사관\', \'text\': \'경계 지역 부사관이 공격할 때마다, 당신이 조종하는 다른 인간들은 턴종료까지 +1/+0을 받는다.\', \'type\': \'생물 — 인간 병사\', \'flavor\': \'"뛰어들어라, 병사여! 점심 전에 모피를 벽에 걸어야겠어!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481101&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'56ff4403-3c63-4465-8e2f-b725f7370f47\', \'multiverseId\': 481101}, \'multiverseid\': 481101}, {\'name\': \'Sargento do Perímetro\', \'text\': \'Toda vez que Sargento do Perímetro ataca, os outros Humanos que você controla recebem +1/+0 até o final do turno.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': \'"Vai lá, soldado! Eu quero um pelego na minha parede antes da hora do almoço!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481360&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f6908df3-eb8f-4756-8dfa-47b20405315d\', \'multiverseId\': 481360}, \'multiverseid\': 481360}, {\'name\': \'Сержант Переднего Края\', \'text\': \'Каждый раз, когда Сержант Переднего Края атакует, другие перманенты с подтипом Человек под вашим контролем получают +1/+0 до конца хода.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'«Живо сюда, боец! Я хочу повесить шкуру этой твари у себя на стене еще до обеда!»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481619&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'73894c3d-64ec-406d-9a69-c0037ddd0236\', \'multiverseId\': 481619}, \'multiverseid\': 481619}, {\'name\': \'守备士官\', \'text\': \'每当守备士官攻击时，由你操控的其他人类得+1/+0直到回合结束。\', \'type\': \'生物 ～人类／士兵\', \'flavor\': \'「士兵，给我上！我要在午饭前给我家的墙上添块皮！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481878&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8fdc8d12-f753-4e45-9dc2-4500d5af9b8d\', \'multiverseId\': 481878}, \'multiverseid\': 481878}, {\'name\': \'守備士官\', \'text\': \'每當守備士官攻擊時，由你操控的其他人類得+1/+0直到回合結束。\', \'type\': \'生物 ～人類／士兵\', \'flavor\': \'「士兵，給我上！我要在午飯前給我家的牆上添塊皮！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482137&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4445d05a-57f1-42b5-b28b-a07518d807e3\', \'multiverseId\': 482137}, \'multiverseid\': 482137}]', '[{\'name\': \'Großer Sandwurm\', \'text\': \'Der Große Sandwurm kann von Kreaturen mit Stärke 2 oder weniger nicht geblockt werden.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Kreatur — Wurm\', \'flavor\': \'Auf Ikoria schlafen Sandwürmer nie lange. In einigen Regionen ist „keine Aktivität" das größte Anzeichen von Gefahr.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479936&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'aef8710c-a72f-4325-a929-c6788f35eba0\', \'multiverseId\': 479936}, \'multiverseid\': 479936}, {\'name\': \'Gran sierpe de arena\', \'text\': \'La Gran sierpe de arena no puede ser bloqueada por criaturas con fuerza de 2 o menos.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Criatura — Sierpe\', \'flavor\': \'En Ikoria, las sierpes de arena nunca yacen dormidas demasiado tiempo. En algunas regiones, la falta de actividad es el mayor signo de peligro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480195&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7343a7d9-59bc-4435-828b-04ad8f3115bc\', \'multiverseId\': 480195}, \'multiverseid\': 480195}, {\'name\': \'Grande guivre des sables\', \'text\': \'La Grande guivre des sables ne peut pas être bloquée par les créatures de force inférieure ou égale à 2.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)\', \'type\': \'Créature : guivre\', \'flavor\': \'Sur Ikoria, les guivres des sables ne sommeillent jamais longtemps. Dans certaines régions, « aucune activité » est synonyme de grand danger.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480454&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a76b99cb-030f-439c-aa2e-303f3f9e8b91\', \'multiverseId\': 480454}, \'multiverseid\': 480454}, {\'name\': \'Wurm Sabbioso Maggiore\', \'text\': \'Il Wurm Sabbioso Maggiore non può essere bloccato da creature con forza pari o inferiore a 2.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Creatura — Wurm\', \'flavor\': "Su Ikoria, i wurm sabbiosi non restano mai in letargo troppo a lungo. In alcune regioni, l\'assenza di attività è il più grande segnale di pericolo.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480713&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9447292e-5ff0-4c1b-954e-e692fbe2075c\', \'multiverseId\': 480713}, \'multiverseid\': 480713}, {\'name\': \'大いなるサンドワーム\', \'text\': \'大いなるサンドワームは、パワーが２以下のクリーチャーによってはブロックされない。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'クリーチャー — ワーム\', \'flavor\': \'イコリアのサンドワームが長く休眠することはない。場所によっては、活動が見られないことが最大の危険の徴候である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480972&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b1d03b1b-4aab-4785-9fcf-3dffe052d47f\', \'multiverseId\': 480972}, \'multiverseid\': 480972}, {\'name\': \'대형 모래웜\', \'text\': \'대형 모래웜은 공격력이 2 이하인 생물에게 방어될 수 없다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'생물 — 웜\', \'flavor\': \'이코리아에서, 모래웜들은 절대로 오랫동안 가만히 있는 법이 없다. 일부 지역에서는 "아무런 활동 없음"이 위험을 알리는 가장 큰 징조이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481231&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1ed9cedd-7a62-4a63-a7b0-052a576e7d96\', \'multiverseId\': 481231}, \'multiverseid\': 481231}, {\'name\': \'Grão-vorme-da-areia\', \'text\': \'Grão-vorme-da-areia não pode ser bloqueado por criaturas com poder igual ou inferior a 2.\\nReciclar {2} ({2}, descarte este card: Compre um card.)\', \'type\': \'Criatura — Vorme\', \'flavor\': \'Em Ikoria os vormes-da-areia jamais dormem por muito tempo. Em algumas regiões, uma "inatividade" é o maior sinal de perigo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481490&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b8045564-05cf-456e-851e-62629cdbc3bf\', \'multiverseId\': 481490}, \'multiverseid\': 481490}, {\'name\': \'Гигантский Песчаный Вурм\', \'text\': \'Гигантский Песчаный Вурм не может быть заблокирован существами с силой 2 или меньше.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Существо — Вурм\', \'flavor\': \'На Икории песчаные вурмы никогда не дремлют слишком долго. В некоторых краях «отсутствие активности» — верный признак опасности.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481749&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'55936eb6-4ba2-4cee-81d2-25fc743be150\', \'multiverseId\': 481749}, \'multiverseid\': 481749}, {\'name\': \'高大沙丘亚龙\', \'text\': \'高大沙丘亚龙不能被力量等于或小于2的生物阻挡。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'生物 ～亚龙\', \'flavor\': \'依克黎的沙丘亚龙不会长时静止不动。因此在部分地区，「没在活动」才是最大的危险讯号。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482008&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'81f11fdd-f0f6-447e-a274-125d2d5046a0\', \'multiverseId\': 482008}, \'multiverseid\': 482008}, {\'name\': \'高大沙丘亞龍\', \'text\': \'高大沙丘亞龍不能被力量等於或小於2的生物阻擋。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'生物 ～亞龍\', \'flavor\': \'依克黎的沙丘亞龍不會長時靜止不動。因此在部分地區，「沒在活動」才是最大的危險訊號。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482267&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e5e9f6ae-f2da-443a-8285-4bf407bf3e5a\', \'multiverseId\': 482267}, \'multiverseid\': 482267}]', '[{\'name\': \'Gruseltänzer\', \'text\': \'Der Gruseltänzer kommt mit zwei verschiedenen der folgenden Marken ins Spiel, nämlich Bedrohlich, Todesberührung oder Lebensverknüpfung (du entscheidest).\', \'type\': \'Kreatur — Nachtmahr\', \'flavor\': \'Die meisten Monster sind gruseliger, solange sie ungesehen durch die Dunkelheit schleichen. Die meisten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479869&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9114ecf3-e00f-4630-a05d-547d8d6daf0f\', \'multiverseId\': 479869}, \'multiverseid\': 479869}, {\'name\': \'Danzarina del averno\', \'text\': \'La Danzarina del averno entra al campo de batalla con dos contadores sobre ella que elijas de entre los de amenaza, toque mortal y vínculo vital.\', \'type\': \'Criatura — Pesadilla\', \'flavor\': \'La mayoría de los monstruos dan más miedo cuando se deslizan por la noche sin ser vistos. La mayoría.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480128&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5885c933-dc1b-4a1c-8280-ae414be35079\', \'multiverseId\': 480128}, \'multiverseid\': 480128}, {\'name\': \'Danseur sinistre\', \'text\': \'Le Danseur sinistre arrive sur le champ de bataille avec, selon votre choix, deux marqueurs différents sur lui parmi « menace », « contact mortel » et « lien de vie ».\', \'type\': \'Créature : cauchemar\', \'flavor\': \'La plupart des monstres sont plus effrayants quand ils se faufilent discrètement dans le noir. Enfin, en règle générale.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480387&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9bc51b5c-b995-439e-bba1-412231050769\', \'multiverseId\': 480387}, \'multiverseid\': 480387}, {\'name\': \'Danzatore Lugubre\', \'text\': \'Il Danzatore Lugubre entra nel campo di battaglia con due segnalini diversi a tua scelta tra minacciare, tocco letale e legame vitale.\', \'type\': \'Creatura — Incubo\', \'flavor\': "La maggior parte dei mostri sono più spaventosi quando brulicano invisibili nell\'oscurità. La maggior parte.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480646&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'81c54a3d-e906-4a6d-9d96-32a09ba250ef\', \'multiverseId\': 480646}, \'multiverseid\': 480646}, {\'name\': \'不気味舞い\', \'text\': \'不気味舞いは、威迫か接死か絆魂のうちあなたが選んだ異なるカウンター２個が置かれた状態で戦場に出る。\', \'type\': \'クリーチャー — ナイトメア\', \'flavor\': \'大抵の生き物は、暗闇に紛れて走っている方が恐ろしいものだ。大抵は。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480905&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c03522e4-6c7f-4c65-a6ba-319714952323\', \'multiverseId\': 480905}, \'multiverseid\': 480905}, {\'name\': \'음침한 무용수\', \'text\': \'음침한 무용수는 호전적, 치명타 및 생명연결 중에서 당신이 선택한 서로 다른 카운터 두 개를 가지고 전장에 들어온다.\', \'type\': \'생물 — 나이트메어\', \'flavor\': \'대부분의 괴수들은 어둠 속에서 보이지 않는 채로 돌아다닐 때 더 무섭다. 대부분은 말이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481164&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'450ef406-f109-4221-9893-ac6753084eb9\', \'multiverseId\': 481164}, \'multiverseid\': 481164}, {\'name\': \'Dançarino Soturno\', \'text\': \'Dançarino Soturno entra no campo de batalha com dois marcadores diferentes à sua escolha entre ameaçar, toque mortífero e vínculo com a vida.\', \'type\': \'Criatura — Pesadelo\', \'flavor\': \'A maioria dos monstros é mais ameaçadora quando corre invisível pela escuridão. A maioria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481423&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ecda4f85-b137-4d29-8920-7cd8c6fc647f\', \'multiverseId\': 481423}, \'multiverseid\': 481423}, {\'name\': \'Зловещий Плясун\', \'text\': \'Зловещий Плясун выходит на поле битвы с двумя различными жетонами на нем по вашему выбору из Угрозы, Смертельного касания и Цепи жизни.\', \'type\': \'Существо — Кошмар\', \'flavor\': \'Большинство монстров страшнее всего, когда они незримо рыскают в темноте. Большинство.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481682&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ecf5d36c-dfa9-44b1-9fb9-970fb6702bda\', \'multiverseId\': 481682}, \'multiverseid\': 481682}, {\'name\': \'冷酷旋魇\', \'text\': \'冷酷旋魇进战场时上面依你的选择有威慑、死触和系命三种指示物其中之二。\', \'type\': \'生物 ～梦魇\', \'flavor\': \'对于大多数怪兽来说，是它们藏身黑暗窸窣移动时才最令人畏惧。至少大多数是这样。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481941&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a7c4bfcb-1d57-4f64-a98b-7dbb5fb3dab0\', \'multiverseId\': 481941}, \'multiverseid\': 481941}, {\'name\': \'冷酷旋魘\', \'text\': \'冷酷旋魘進戰場時上面依你的選擇有威懾、死觸和繫命三種指示物其中之二。\', \'type\': \'生物 ～夢魘\', \'flavor\': \'對於大多數怪獸來說，是牠們藏身黑暗窸窣移動時才最令人畏懼。至少大多數是這樣。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482200&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'05a94416-00d9-429b-b17d-8084a737fcdb\', \'multiverseId\': 482200}, \'multiverseid\': 482200}]', '[{\'name\': \'Gyruda, Verdammnis der Tiefen\', \'text\': \'Gefährte — Dein Startdeck enthält nur Karten mit geraden umgewandelten Manakosten. (Falls du diese Karte als deinen Gefährten erwählt hast, kannst du sie einmal von außerhalb der Partie wirken.)\\nWenn Gyruda ins Spiel kommt, legt jeder Spieler die obersten vier Karten seiner Bibliothek auf seinen Friedhof. Bringe davon eine Kreaturenkarte mit geraden umgewandelten Manakosten unter deiner Kontrolle ins Spiel.\', \'type\': \'Legendäre Kreatur — Dämon, Krake\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480000&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'afb8341a-35f6-4dfd-99dc-2da177c67273\', \'multiverseId\': 480000}, \'multiverseid\': 480000}, {\'name\': \'Gyruda, la Fatalidad de las Profundidades\', \'text\': \'Compañero — Tu mazo inicial contiene solo cartas con costes de maná convertido pares. (Si esta carta es el compañero que eliges, puedes lanzarla una vez desde fuera del juego.)\\nCuando Gyruda entre al campo de batalla, cada jugador pone las cuatro primeras cartas de su biblioteca en su cementerio. Pon una carta de criatura con un coste de maná convertido par de entre esas cartas en el campo de batalla bajo tu control.\', \'type\': \'Criatura legendaria — Kraken demonio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480259&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b0a76bdd-60ab-45f8-a05f-5505fea9a209\', \'multiverseId\': 480259}, \'multiverseid\': 480259}, {\'name\': \'Gyruda, calamité des profondeurs\', \'text\': "Compagnon — Votre deck de départ ne contient que des cartes avec un coût converti de mana pair. (Si cette carte est le compagnon de votre choix, vous pouvez la lancer une fois depuis l\'extérieur de la partie.)\\nQuand Gyruda arrive sur le champ de bataille, chaque joueur met les quatre cartes du dessus de sa bibliothèque dans son cimetière. Mettez sur le champ de bataille, sous votre contrôle, une carte de créature avec un coût converti de mana pair parmi ces cartes.", \'type\': \'Créature légendaire : démon et kraken\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480518&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'56e12d92-da4b-435d-82a6-79df84a115af\', \'multiverseId\': 480518}, \'multiverseid\': 480518}, {\'name\': \'Gyruda, Rovina degli Abissi\', \'text\': \'Compagno — Il tuo mazzo iniziale contiene solo carte con costi di mana convertiti pari. (Se questa carta è il compagno che hai scelto, puoi lanciarla una volta dal di fuori della partita.)\\nQuando Gyruda entra nel campo di battaglia, ogni giocatore mette nel proprio cimitero le prime quattro carte del proprio grimorio. Metti sul campo di battaglia sotto il tuo controllo una carta creatura con costo di mana convertito pari scelta tra quelle carte.\', \'type\': \'Creatura Leggendaria — Kraken Demone\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480777&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'da6865e3-b9d2-4102-a695-11237ae50950\', \'multiverseId\': 480777}, \'multiverseid\': 480777}, {\'name\': \'深海の破滅、ジャイルーダ\', \'text\': \'相棒 ― あなたの開始時のデッキに、点数で見たマナ・コストが偶数のカードのみが入っていること。（このカードがあなたの選んだ相棒であるなら、あなたは１回のみゲームの外部からこれを唱えてもよい。）\\n深海の破滅、ジャイルーダが戦場に出たとき、各プレイヤーはそれぞれ、自分のライブラリーの一番上からカードを４枚自分の墓地に置く。それらのカードの中から、点数で見たマナ・コストが偶数のクリーチャー・カード１枚をあなたのコントロール下で戦場に出す。\', \'type\': \'伝説のクリーチャー — デーモン・クラーケン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481036&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a3465426-02a6-4e67-b0e4-0a15813a76cf\', \'multiverseId\': 481036}, \'multiverseid\': 481036}, {\'name\': \'심해의 파멸, 자이루다\', \'text\': \'단짝 — 당신의 시작 덱에는 전환마나비용이 짝수인 카드들만 들어 있다. (이 카드가 당신이 선택한 단짝이라면, 당신은 이 카드를 게임 밖에서 한 번 발동할 수 있다.)\\n자이루다가 전장에 들어올 때, 각 플레이어는 자신의 서고 맨 위 카드 네 장을 자신의 무덤에 넣는다. 그 카드들 중 전환마나비용이 짝수인 생물 카드 한 장을 당신의 조종하에 전장에 놓는다.\', \'type\': \'전설적 생물 — 악마 크라켄\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481295&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'78414b23-383c-48e5-9568-d0084743e372\', \'multiverseId\': 481295}, \'multiverseid\': 481295}, {\'name\': \'Gyruda, Ruína das Profundezas\', \'text\': \'Companheiro — Seu deck inicial contém apenas cards com custos de mana convertido pares. (Se este card for o companheiro que escolheu, você poderá conjurá-lo uma vez de fora do jogo.)\\nQuando Gyruda entra no campo de batalha, cada jogador coloca os quatro cards do topo do próprio grimório no próprio cemitério. Coloque um card de criatura com custo de mana convertido par dentre eles no campo de batalha sob seu controle.\', \'type\': \'Criatura Lendária — Demônio Kraken\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481554&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'41ed62ef-706b-4375-8c74-be45e195d0d9\', \'multiverseId\': 481554}, \'multiverseid\': 481554}, {\'name\': \'Джайруда, Погибель из Бездны\', \'text\': \'Компаньон — Ваша начальная колода содержит только карты с четной конвертированной мана-стоимостью. (Если эта карта является вашим избранным Компаньоном, то вы можете один раз разыграть ее из-за пределов игры.)\\nКогда Джайруда выходит на поле битвы, каждый игрок кладет четыре верхние карты своей библиотеки на свое кладбище. Положите находящуюся среди них карту существа с четной конвертированной мана-стоимостью на поле битвы под вашим контролем.\', \'type\': \'Легендарное Существо — Демон Кракен\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481813&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'253115c9-fcca-41e8-98db-4d728579326d\', \'multiverseId\': 481813}, \'multiverseid\': 481813}, {\'name\': \'深渊灾祸翟鲁达\', \'text\': \'行侣～你起始套牌中仅包含总法术力费用为偶数的牌。（如果你选择这张牌作为你的行侣，则你可以从游戏外施放它，但仅限一次。）\\n当翟鲁达进战场时，每位牌手各将其牌库顶的四张牌置入其坟墓场。你将这些牌其中一张总法术力费用为偶数的生物牌在你的操控下放进战场。\', \'type\': \'传奇生物 ～恶魔／巨海兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482072&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0a997949-0e24-461e-b03d-0a637bb5130c\', \'multiverseId\': 482072}, \'multiverseid\': 482072}, {\'name\': \'深淵災禍翟魯達\', \'text\': \'行侶～你起始套牌中僅包含總魔法力費用為偶數的牌。（如果你選擇這張牌作為你的行侶，則你可以從遊戲外施放它，但僅限一次。）\\n當翟魯達進戰場時，每位玩家各將其牌庫頂的四張牌置入其墳墓場。你將這些牌其中一張總魔法力費用為偶數的生物牌在你的操控下放進戰場。\', \'type\': \'傳奇生物 ～惡魔／巨海獸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482331&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'14121b40-6623-43a5-a9d9-bf45612fce86\', \'multiverseId\': 482331}, \'multiverseid\': 482331}]', "[{'name': 'Gyruda, Verdammnis der Tiefen', 'text': 'Gefährte — Dein Startdeck enthält nur Karten mit geraden umgewandelten Manakosten.\\nWenn Gyruda ins Spiel kommt, legt jeder Spieler die obersten vier Karten seiner Bibliothek auf seinen Friedhof. Bringe davon eine Kreaturenkarte mit geraden umgewandelten Manakosten unter deiner Kontrolle ins Spiel.', 'type': 'Legendäre Kreatur — Dämon, Krake', 'flavor': 'Gigan, kybernetische Schreckensklaue', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482397&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'ea84f19c-e9a4-463c-9a82-bddac1da6a12', 'multiverseId': 482397}, 'multiverseid': 482397}, {'name': 'Gyruda, la Fatalidad de las Profundidades', 'text': 'Compañero — Tu mazo inicial contiene solo cartas con costes de maná convertido pares.\\nCuando Gyruda entre al campo de batalla, cada jugador pone las cuatro primeras cartas de su biblioteca en su cementerio. Pon una carta de criatura con un coste de maná convertido par de entre esas cartas en el campo de batalla bajo tu control.', 'type': 'Criatura legendaria — Kraken demonio', 'flavor': 'Gigan, cibergarras terroríficas', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482411&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ba757a36-3ad1-4d76-8554-5743cecc5be1', 'multiverseId': 482411}, 'multiverseid': 482411}, {'name': 'Gyruda, calamité des profondeurs', 'text': 'Compagnon — Votre deck de départ ne contient que des cartes avec un coût converti de mana pair.\\nQuand Gyruda arrive sur le champ de bataille, chaque joueur met les quatre cartes du dessus de sa bibliothèque dans son cimetière. Mettez sur le champ de bataille, sous votre contrôle, une carte de créature avec un coût converti de mana pair parmi ces cartes.', 'type': 'Créature légendaire : démon et kraken', 'flavor': 'Gigan, terreur aux griffes cybernétiques', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482425&type=card', 'language': 'French', 'identifiers': {'scryfallId': '9f8e26fd-95df-4f18-808f-1226f24e2aec', 'multiverseId': 482425}, 'multiverseid': 482425}, {'name': 'Gyruda, Rovina degli Abissi', 'text': 'Compagno — Il tuo mazzo iniziale contiene solo carte con costi di mana convertiti pari.\\nQuando Gyruda entra nel campo di battaglia, ogni giocatore mette nel proprio cimitero le prime quattro carte del proprio grimorio. Metti sul campo di battaglia sotto il tuo controllo una carta creatura con costo di mana convertito pari scelta tra quelle carte.', 'type': 'Creatura Leggendaria — Kraken Demone', 'flavor': 'Gigan, Terrore del Cyberartiglio', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482439&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '8247dac2-989f-4ea9-838e-526f87ce47a8', 'multiverseId': 482439}, 'multiverseid': 482439}, {'name': '深海の破滅、ジャイルーダ', 'text': '相棒 ― あなたの開始時のデッキに、点数で見たマナ・コストが偶数のカードのみが入っていること。\\n深海の破滅、ジャイルーダが戦場に出たとき、各プレイヤーはそれぞれ、自分のライブラリーの一番上からカードを４枚自分の墓地に置く。それらのカードの中から、点数で見たマナ・コストが偶数のクリーチャー・カード１枚をあなたのコントロール下で戦場に出す。', 'type': '伝説のクリーチャー — デーモン・クラーケン', 'flavor': '鎌（かま）爪（づめ）の未（み）来（らい）怪（かい）獣（じゅう）、ガイガン', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482453&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '700e4068-4f2c-469a-ac18-acf54d1de6ca', 'multiverseId': 482453}, 'multiverseid': 482453}, {'name': '심해의 파멸, 자이루다', 'text': '단짝 — 당신의 시작 덱에는 전환마나비용이 짝수인 카드들만 들어 있다.\\n자이루다가 전장에 들어올 때, 각 플레이어는 자신의 서고 맨 위 카드 네 장을 자신의 무덤에 넣는다. 그 카드들 중 전환마나비용이 짝수인 생물 카드 한 장을 당신의 조종하에 전장에 놓는다.', 'type': '전설적 생물 — 악마 크라켄', 'flavor': '사이버클로의 공포, 가이강', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482467&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '5e4bca6b-5b83-4054-8f92-563e2dce488a', 'multiverseId': 482467}, 'multiverseid': 482467}, {'name': 'Gyruda, Ruína das Profundezas', 'text': 'Companheiro — Seu deck inicial contém apenas cards com custos de mana convertido pares.\\nQuando Gyruda entra no campo de batalha, cada jogador coloca os quatro cards do topo do próprio grimório no próprio cemitério. Coloque um card de criatura com custo de mana convertido par dentre eles no campo de batalha sob seu controle.', 'type': 'Criatura Lendária — Demônio Kraken', 'flavor': 'Gigan, Terror da Cibergarra', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482481&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9f836b28-d6eb-4dcd-85ac-5f5a2a8a2fff', 'multiverseId': 482481}, 'multiverseid': 482481}, {'name': 'Джайруда, Погибель из Бездны', 'text': 'Компаньон — Ваша начальная колода содержит только карты с четной конвертированной мана-стоимостью.\\nКогда Джайруда выходит на поле битвы, каждый игрок кладет четыре верхние карты своей библиотеки на свое кладбище. Положите находящуюся среди них карту существа с четной конвертированной мана-стоимостью на поле битвы под вашим контролем.', 'type': 'Легендарное Существо — Демон Кракен', 'flavor': 'Гайган, Кошмарный Киберкоготь', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482495&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'a3b18577-918b-4061-b8ee-5f9c7921be56', 'multiverseId': 482495}, 'multiverseid': 482495}, {'name': '深渊灾祸翟鲁达', 'text': '行侣～你起始套牌中仅包含总法术力费用为偶数的牌。\\n当翟鲁达进战场时，每位牌手各将其牌库顶的四张牌置入其坟墓场。你将这些牌其中一张总法术力费用为偶数的生物牌在你的操控下放进战场。', 'type': '传奇生物 ～恶魔／巨海兽', 'flavor': '生化惧爪盖刚', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482509&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'fbe23dcb-cdd9-408a-b7b2-554398a6a497', 'multiverseId': 482509}, 'multiverseid': 482509}, {'name': '深淵災禍翟魯達', 'text': '行侶～你起始套牌中僅包含總魔法力費用為偶數的牌。\\n當翟魯達進戰場時，每位玩家各將其牌庫頂的四張牌置入其墳墓場。你將這些牌其中一張總魔法力費用為偶數的生物牌在你的操控下放進戰場。', 'type': '傳奇生物 ～惡魔／巨海獸', 'flavor': '生化懼爪蓋剛', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482523&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '0a6529e5-b230-4a65-bd32-de0398a44a5f', 'multiverseId': 482523}, 'multiverseid': 482523}]", '[{\'name\': \'Göttlicher Pfeil\', \'text\': \'Der Göttliche Pfeil fügt einer angreifenden oder blockenden Kreatur deiner Wahl 4 Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'Außerhalb der Mauern von Drannith, wo Kollateralschaden keine Rolle spielt, dürfen die Kupferjacken auch wirksamere Methoden anwenden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479788&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6a5369a3-1c20-4e27-9e26-05bc6acb8b46\', \'multiverseId\': 479788}, \'multiverseid\': 479788}, {\'name\': \'Flecha divina\', \'text\': \'La Flecha divina hace 4 puntos de daño a la criatura atacante o bloqueadora objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'Fuera de los muros de Drannith, donde a nadie preocupan los daños colaterales, las Capas de Cobre tienen libertad para emplear métodos más contundentes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480047&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e8f02708-37dc-42aa-83e7-ea9f39473bb8\', \'multiverseId\': 480047}, \'multiverseid\': 480047}, {\'name\': \'Flèche divine\', \'text\': \'La Flèche divine inflige 4 blessures à une créature attaquante ou bloqueuse ciblée.\', \'type\': \'Éphémère\', \'flavor\': "À l\'extérieur des murailles de Drannith, là où les dommages collatéraux importent peu, les Capes de cuivre sont libres d\'appliquer des méthodes plus radicales.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480306&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e5db90bf-c7c9-4145-b35f-92378daf57f9\', \'multiverseId\': 480306}, \'multiverseid\': 480306}, {\'name\': \'Freccia Divina\', \'text\': \'La Freccia Divina infligge 4 danni a una creatura attaccante o bloccante bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'Fuori dalle mura di Drannith, dove i danni collaterali non sono un problema, le Giubbe Ramate sono libere di usare metodi più potenti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480565&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f77ecb3b-fb88-42d5-81f8-990864fe1e70\', \'multiverseId\': 480565}, \'multiverseid\': 480565}, {\'name\': \'神聖なる矢\', \'text\': \'攻撃クリーチャー１体かブロック・クリーチャー１体を対象とする。神聖なる矢はそれに４点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'ドラニスの壁の外では巻き添えの心配がないので、銅纏いも強力な手段が使える。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480824&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d1fcfd38-bd66-4f30-9fda-1c4c9c8b16bf\', \'multiverseId\': 480824}, \'multiverseid\': 480824}, {\'name\': \'신성한 화살\', \'text\': \'공격 중이거나 방어 중인 생물을 목표로 정한다. 신성한 화살은 그 생물에게 피해 4점을 입힌다.\', \'type\': \'순간마법\', \'flavor\': \'드라니스의 벽 밖에서는 부수적인 손상을 신경쓰지 않아도 되기에, 구리 코트들이 더 강력한 수단들을 자유롭게 사용할 수 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481083&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4c680534-701c-497c-b7da-a48235c9a3f2\', \'multiverseId\': 481083}, \'multiverseid\': 481083}, {\'name\': \'Flecha Divina\', \'text\': \'Flecha Divina causa 4 pontos de dano à criatura alvo atacante ou bloqueadora.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Fora das muralhas de Drannith, onde os danos colaterais não são um problema, os Gibões de Cobre estão livres para usar métodos mais potentes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481342&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'37370a1a-cef3-4a39-9d2e-12f93a6f2e37\', \'multiverseId\': 481342}, \'multiverseid\': 481342}, {\'name\': \'Божественная Стрела\', \'text\': \'Божественная Стрела наносит 4 повреждения целевому атакующему или блокирующему существу.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'За стенами Драннита, где о сопутствующем уроне беспокоиться не приходится, Медные Кители могут пользоваться самыми мощными методами.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481601&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'149b53b8-a382-4dae-9ef8-385f8922bc49\', \'multiverseId\': 481601}, \'multiverseid\': 481601}, {\'name\': \'神箭穿心\', \'text\': \'神箭穿心对目标进行攻击或阻挡的生物造成4点伤害。\', \'type\': \'瞬间\', \'flavor\': \'在卓尼斯的高墙之外不用担心误伤无辜，紫铜军可以自由运用更加有效的制敌手段。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481860&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d0e73134-9948-401f-9b19-37fd0dcb98ec\', \'multiverseId\': 481860}, \'multiverseid\': 481860}, {\'name\': \'神箭穿心\', \'text\': \'神箭穿心對目標進行攻擊或阻擋的生物造成4點傷害。\', \'type\': \'瞬間\', \'flavor\': \'在卓尼斯的高牆之外不用擔心誤傷無辜，紫銅軍可以自由運用更加有效的制敵手段。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482119&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'cb38997b-c16a-4d1b-9cde-e76df3cb406d\', \'multiverseId\': 482119}, \'multiverseid\': 482119}]', "[{'name': 'Haifun', 'text': 'Immer wenn du einen Nichtkreatur-Zauberspruch wirkst, erzeuge einen X/X blauen Hai-Kreaturenspielstein mit Flugfähigkeit, wobei X gleich den umgewandelten Manakosten jenes Zauberspruchs ist.\\nUmwandlung {X}{1}{U} ({X}{1}{U}, wirf diese Karte ab: Ziehe eine Karte.)\\nWenn du den Haifun umwandelst, erzeuge einen X/X blauen Hai-Kreaturenspielstein mit Flugfähigkeit.', 'type': 'Verzauberung', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479846&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b9f3a3fa-6fc7-4d17-bd69-4c14425e902a', 'multiverseId': 479846}, 'multiverseid': 479846}, {'name': 'Tifón de tiburones', 'text': 'Siempre que lances un hechizo que no sea de criatura, crea una ficha de criatura Tiburón azul X/X con la habilidad de volar, donde X es el coste de maná convertido de ese hechizo.\\nCiclo {X}{1}{U}. ({X}{1}{U}, descartar esta carta: Roba una carta.)\\nCuando actives la habilidad de ciclo del Tifón de tiburones, crea una ficha de criatura Tiburón azul X/X con la habilidad de volar.', 'type': 'Encantamiento', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480105&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'b951e5ab-7e21-4a10-9143-39dccb6b64f1', 'multiverseId': 480105}, 'multiverseid': 480105}, {'name': 'Typhon de requins', 'text': 'À chaque fois que vous lancez un sort non-créature, créez un jeton de créature X/X bleue Requin avec le vol, X étant le coût converti de mana de ce sort.\\nRecyclage {X}{1}{U} ({X}{1}{U}, défaussez-vous de cette carte : Piochez une carte.)\\nQuand vous recyclez le Typhon de requins, créez un jeton de créature X/X bleue Requin avec le vol.', 'type': 'Enchantement', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480364&type=card', 'language': 'French', 'identifiers': {'scryfallId': '8765b8b3-6b93-4b83-89aa-42779ad438bd', 'multiverseId': 480364}, 'multiverseid': 480364}, {'name': 'Tifone di Squali', 'text': 'Ogniqualvolta lanci una magia non creatura, crea una pedina creatura Squalo X/X blu con volare, dove X è il costo di mana convertito di quella magia.\\nCiclo {X}{1}{U} ({X}{1}{U}, Scarta questa carta: Pesca una carta.)\\nQuando cicli il Tifone di Squali, crea una pedina creatura Squalo X/ X blu con volare.', 'type': 'Incantesimo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480623&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '803c1e58-fbb6-49ab-bf79-2c20acb6de7d', 'multiverseId': 480623}, 'multiverseid': 480623}, {'name': 'サメ台風', 'text': 'あなたがクリーチャーでない呪文を唱えるたび、飛行を持つ青のＸ/Ｘのサメ・クリーチャー・トークンを１体生成する。Ｘはその呪文の点数で見たマナ・コストに等しい。\\nサイクリング {X}{1}{U}（{X}{1}{U}, このカードを捨てる：カードを１枚引く。）\\nあなたがサメ台風をサイクリングしたとき、飛行を持つ青のＸ/Ｘのサメ・クリーチャー・トークンを１体生成する。', 'type': 'エンチャント', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480882&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '7093db24-9c96-4479-bfc8-87077f28f525', 'multiverseId': 480882}, 'multiverseid': 480882}, {'name': '상어 태풍', 'text': '당신이 생물이 아닌 주문을 발동할 때마다, 비행을 가진 X/X 청색 상어 생물 토큰 한 개를 만든다. X는 그 주문의 전환마나비용이다.\\n순환 {X}{1}{U} ({X}{1}{U}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\\n당신이 상어 태풍을 순환할 때, 비행을 가진 X/X 청색 상어 생물 토큰 한 개를 만든다.', 'type': '부여마법', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481141&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '695da1dd-672f-4763-a659-e40dc0734947', 'multiverseId': 481141}, 'multiverseid': 481141}, {'name': 'Tufão de Tubarões', 'text': 'Toda vez que você conjurar uma mágica que não seja de criatura, crie uma ficha de criatura azul X/X do tipo Tubarão com voar, sendo X o custo de mana convertido daquela mágica.\\nReciclar {X}{1}{U} ({X}{1}{U}, descarte este card: Compre um card.)\\nQuando reciclar Tufão de Tubarões, crie uma ficha de criatura azul X/X do tipo Tubarão com voar.', 'type': 'Encantamento', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481400&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a446f88d-8121-4165-9ed8-2b19f5427578', 'multiverseId': 481400}, 'multiverseid': 481400}, {'name': 'Акулий Тайфун', 'text': 'Каждый раз, когда вы разыгрываете не являющееся существом заклинание, создайте одну фишку существа X/X синяя Акула с Полетом, где X — конвертированная мана-стоимость того заклинания.\\nЦикл {X}{1}{U} ({X}{1}{U}, сбросьте эту карту: возьмите карту.)\\nКогда вы совершаете Цикл Акульего Тайфуна, создайте одну фишку существа X/X синяя Акула с Полетом.', 'type': 'Чары', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481659&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '8c10114f-0e66-47d6-b0a8-87bc44df60bf', 'multiverseId': 481659}, 'multiverseid': 481659}, {'name': '聚鲨台风', 'text': '每当你施放非生物咒语时，派出一个X/X蓝色，具飞行异能的鲨鱼衍生生物，X为该咒语的总法术力费用。\\n循环{X}{1}{U}（{X}{1}{U}，弃掉此牌：抓一张牌。）\\n当你循环聚鲨台风时，派出一个X/X蓝色，具飞行异能的鲨鱼衍生生物。', 'type': '结界', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481918&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9a3e2a9f-3b2e-42c0-8bea-4ac74b00b2e3', 'multiverseId': 481918}, 'multiverseid': 481918}, {'name': '聚鯊颱風', 'text': '每當你施放非生物咒語時，派出一個X/X藍色，具飛行異能的鯊魚衍生生物，X為該咒語的總魔法力費用。\\n循環{X}{1}{U}（{X}{1}{U}，棄掉此牌：抽一張牌。）\\n當你循環聚鯊颱風時，派出一個X/X藍色，具飛行異能的鯊魚衍生生物。', 'type': '結界', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482177&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'd76b74a6-11e4-444f-989d-8146c920274c', 'multiverseId': 482177}, 'multiverseid': 482177}]", '[{\'name\': \'Handwerker des Bösen\', \'text\': \'Der Handwerker des Bösen erhält +1/+1 für jede Kreaturenkarte in deinem Friedhof.\\n{X}{B/G}, {T}, opfere eine andere Kreatur: Durchsuche deine Bibliothek nach einer Kreaturenkarte mit umgewandelten Manakosten von X oder weniger, bringe sie ins Spiel und mische dann deine Bibliothek. Aktiviere diese Fähigkeit nur zu einem Zeitpunkt, zu dem du auch eine Hexerei wirken könntest.\', \'type\': \'Kreatur — Nachtmahr\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479999&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'60ec100d-1a8b-43a8-a814-a8c6ba6f9c18\', \'multiverseId\': 479999}, \'multiverseid\': 479999}, {\'name\': \'Elaborademonios\', \'text\': \'La Elaborademonios obtiene +1/+1 por cada carta de criatura en tu cementerio.\\n{X}{B/G}, {T}, sacrificar otra criatura: Busca en tu biblioteca una carta de criatura con coste de maná convertido de X o menos, ponla en el campo de batalla y luego baraja tu biblioteca. Activa esta habilidad solo cuando puedas lanzar un conjuro.\', \'type\': \'Criatura — Pesadilla\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480258&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6deabaec-7bd8-47ae-a4f8-250ab7220520\', \'multiverseId\': 480258}, \'multiverseid\': 480258}, {\'name\': \'Artisan fielleux\', \'text\': "L\'Artisan fielleux gagne +1/+1 pour chaque carte de créature dans votre cimetière.\\n{X}{B/G}, {T}, sacrifiez une autre créature : Cherchez dans votre bibliothèque une carte de créature avec un coût converti de mana inférieur ou égal à X, mettez-la sur le champ de bataille, et mélangez ensuite votre bibliothèque. N\'activez cette capacité que lorsque vous pourriez lancer un rituel.", \'type\': \'Créature : cauchemar\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480517&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c345b46a-71fa-4c13-8f6b-a9383d8ad149\', \'multiverseId\': 480517}, \'multiverseid\': 480517}, {\'name\': \'Artigiano Immondo\', \'text\': "L\'Artigiano Immondo prende +1/+1 per ogni carta creatura nel tuo cimitero.\\n{X}{B/G}, {T}, Sacrifica un\'altra creatura: Passa in rassegna il tuo grimorio per una carta creatura con costo di mana convertito pari o inferiore a X, mettila sul campo di battaglia, poi rimescola il tuo grimorio. Attiva questa abilità solo quando potresti lanciare una stregoneria.", \'type\': \'Creatura — Incubo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480776&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'73c93209-8fff-4435-85eb-f649105c6345\', \'multiverseId\': 480776}, \'multiverseid\': 480776}, {\'name\': \'悪魔の職工\', \'text\': \'悪魔の職工は、あなたの墓地にあるクリーチャー・カード１枚につき＋１/＋１の修整を受ける。\\n{X}{B/G}, {T}, 他のクリーチャー１体を生け贄に捧げる：あなたのライブラリーから、点数で見たマナ・コストがＸ以下のクリーチャー・カード１枚を探し、戦場に出し、その後あなたのライブラリーを切り直す。この能力は、あなたがソーサリーを唱えられるときにのみ起動できる。\', \'type\': \'クリーチャー — ナイトメア\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481035&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'22da8574-1795-4aa8-ba41-50742b30be55\', \'multiverseId\': 481035}, \'multiverseid\': 481035}, {\'name\': \'마귀 장인\', \'text\': \'마귀 장인은 당신의 무덤에 있는 각 생물 카드마다 +1/+1을 받는다.\\n{X}{B/G}, {T}, 다른 생물 한 개를 희생한다: 당신의 서고에서 전환마나비용이 X 이하인 생물 카드 한 장을 찾아, 그 카드를 전장에 놓은 후, 당신의 서고를 섞는다. 당신이 집중마법을 발동할 수 있는 시기에만 이 능력을 활성화할 수 있다.\', \'type\': \'생물 — 나이트메어\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481294&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'688e248f-1d69-4e53-b3c6-6f039a9c4b08\', \'multiverseId\': 481294}, \'multiverseid\': 481294}, {\'name\': \'Artesão Demoníaco\', \'text\': \'Artesão Demoníaco recebe +1/+1 para cada card de criatura em seu cemitério.\\n{X}{B/G}, {T}, sacrifique outra criatura: Procure em seu grimório um card de criatura com custo de mana convertido igual ou inferior a X, coloque-o no campo de batalha e depois embaralhe seu grimório. Ative esta habilidade somente nos momentos em que poderia conjurar um feitiço.\', \'type\': \'Criatura — Pesadelo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481553&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5c29c6ca-b0ec-4c0c-95b4-1954c60ac479\', \'multiverseId\': 481553}, \'multiverseid\': 481553}, {\'name\': \'Нечестивый Мастеровой\', \'text\': \'Нечестивый Мастеровой получает +1/+1 за каждую карту существа на вашем кладбище.\\n{X}{B/G}, {T}, пожертвуйте другое существо: найдите в вашей библиотеке карту существа с конвертированной мана-стоимостью Х или меньше, положите ее на поле битвы, затем перетасуйте вашу библиотеку. Активируйте эту способность только при возможности разыгрывать волшебство.\', \'type\': \'Существо — Кошмар\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481812&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c8a1a5da-abb7-4f39-8112-aec0774e1db0\', \'multiverseId\': 481812}, \'multiverseid\': 481812}, {\'name\': \'塑生邪魔\', \'text\': \'你坟墓场中每有一张生物牌，塑生邪魔便得+1/+1。\\n{X}{B/G}，{T}，牺牲另一个生物：从你的牌库中搜寻一张总法术力费用等于或小于X的生物牌，将之放进战场，然后将你的牌库洗牌。只可以于你能施放法术的时机下起动此异能。\', \'type\': \'生物 ～梦魇\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482071&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1e05ee0a-8730-472b-b346-ac1d004a0207\', \'multiverseId\': 482071}, \'multiverseid\': 482071}, {\'name\': \'塑生邪魔\', \'text\': \'你墳墓場中每有一張生物牌，塑生邪魔便得+1/+1。\\n{X}{B/G}，{T}，犧牲另一個生物：從你的牌庫中搜尋一張總魔法力費用等於或小於X的生物牌，將之放進戰場，然後將你的牌庫洗牌。只可以於你能施放巫術的時機下起動此異能。\', \'type\': \'生物 ～夢魘\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482330&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e7660eb5-d705-4132-bda5-931a320bc817\', \'multiverseId\': 482330}, \'multiverseid\': 482330}]', "[{'name': 'Helixwald-Gleithörnchen', 'text': 'Das Helixwald-Gleithörnchen kommt mit einer Fliegend- oder einer Erstschlag-Marke ins Spiel (du entscheidest).', 'type': 'Kreatur — Nachtmahr, Eichhörnchen', 'flavor': 'Es könnte sich auch von Nüssen ernähren, aber es bevorzugt dein Gesicht.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479794&type=card', 'language': 'German', 'identifiers': {'scryfallId': '66acd76e-174c-4e3e-9b96-fa61bd25ade8', 'multiverseId': 479794}, 'multiverseid': 479794}, {'name': 'Planeadora de hélicas', 'text': 'La Planeadora de hélicas entra al campo de batalla con lo que elijas sobre ella: un contador de volar o un contador de dañar primero.', 'type': 'Criatura — Ardilla pesadilla', 'flavor': 'Podría sobrevivir a base de semillas, pero su alimento favorito es tu cara.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480053&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4ccacfda-e8e5-4ef6-a3f8-0422304f7ee5', 'multiverseId': 480053}, 'multiverseid': 480053}, {'name': 'Planeur de spiracacia', 'text': 'Le Planeur de spiracacia arrive sur le champ de bataille avec, selon votre choix, un marqueur « vol » ou un marqueur « initiative » sur lui.', 'type': 'Créature : cauchemar et écureuil', 'flavor': 'Il peut survivre en se nourrissant de graines, mais il préfèrerait vous dévorer le visage.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480312&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ee90d987-2f83-4b19-bbed-5e9ab5bcba5d', 'multiverseId': 480312}, 'multiverseid': 480312}, {'name': 'Planatore di Fitoelice', 'text': 'Il Planatore di Fitoelice entra nel campo di battaglia con un segnalino volare o un segnalino attacco improvviso a tua scelta.', 'type': 'Creatura — Scoiattolo Incubo', 'flavor': 'Potrebbe nutrirsi di semi, ma il suo cibo preferito è la tua faccia.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480571&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '75895ae7-886b-4523-95e1-9a42befb6b9f', 'multiverseId': 480571}, 'multiverseid': 480571}, {'name': 'らせん樹の滑空獣', 'text': 'らせん樹の滑空獣は、飛行カウンター１個か先制攻撃カウンター１個のうちあなたが選んだ１つが置かれた状態で戦場に出る。', 'type': 'クリーチャー — ナイトメア・リス', 'flavor': '種を食べて生きることもできるが、食べ物としては種よりも顔を好む。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480830&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '2524c358-66fa-45c9-891d-641dbbfeaa33', 'multiverseId': 480830}, 'multiverseid': 480830}, {'name': '헬리카 활강자', 'text': '헬리카 활강자는 비행 카운터 또는 선제공격 카운터 중 당신이 선택한 카운터를 가지고 전장에 들어온다.', 'type': '생물 — 나이트메어 다람쥐', 'flavor': '씨앗을 먹고 살 수도 있지만, 선호하는 음식은 당신의 얼굴이다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481089&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'c02f9bb3-f0e6-4eeb-81b7-21ae2c1446d6', 'multiverseId': 481089}, 'multiverseid': 481089}, {'name': 'Planador de Heliqueiras', 'text': 'Planador de Heliqueiras entra no campo de batalha com um marcador de voar ou um marcador de iniciativa, à sua escolha.', 'type': 'Criatura — Pesadelo Esquilo', 'flavor': 'Ele poderia se alimentar de sementes, mas prefere o seu rosto.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481348&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '41d68a7c-28fd-4322-b837-59cf69586bd7', 'multiverseId': 481348}, 'multiverseid': 481348}, {'name': 'Летяга Спираледрева', 'text': 'Летяга Спираледрева выходит на поле битвы с одним жетоном Полета или одним жетоном Первого удара на ней по вашему выбору.', 'type': 'Существо — Кошмар Белка', 'flavor': 'Она прокормится и семенами, но ее излюбленное лакомство — ваше лицо.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481607&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'af96c116-669d-43a3-a636-d9d376179b4f', 'multiverseId': 481607}, 'multiverseid': 481607}, {'name': '曲枝飞鼠', 'text': '曲枝飞鼠进战场时上面依你的选择有一个飞行指示物或一个先攻指示物。', 'type': '生物 ～梦魇／松鼠', 'flavor': '虽然它靠种子也能维生，但它喜欢吃你的脸。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481866&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c20bd234-e9b6-45c6-bc87-3ee5a1467e47', 'multiverseId': 481866}, 'multiverseid': 481866}, {'name': '曲枝飛鼠', 'text': '曲枝飛鼠進戰場時上面依你的選擇有一個飛行指示物或一個先攻指示物。', 'type': '生物 ～夢魘／松鼠', 'flavor': '雖然牠靠種子也能維生，但牠喜歡吃你的臉。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482125&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '00df4f25-b86e-4a8d-ac4c-9c949bc9ca42', 'multiverseId': 482125}, 'multiverseid': 482125}]", '[{\'name\': \'Hemmende Schlinge\', \'text\': \'Kreaturen, die deine Gegner kontrollieren, erhalten -2/-0 bis zum Ende des Zuges.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ich will, dass es mir in die Augen schaut und erkennt, wer es bezwungen hat."\\n—Kelsien der Verseuchte\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479834&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7ed89739-7086-4546-926e-adfb659a0e62\', \'multiverseId\': 479834}, \'multiverseid\': 479834}, {\'name\': \'Trampa obstructora\', \'text\': \'Las criaturas que controlan tus oponentes obtienen -2/-0 hasta el final del turno.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Instantáneo\', \'flavor\': \'"Quiero que me mire a los ojos y vea la cara del hombre que acabó con él".\\n—Kelsien, la Plaga\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480093&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'48279b58-1561-4dbc-81f3-e3f30afb12cb\', \'multiverseId\': 480093}, \'multiverseid\': 480093}, {\'name\': \'Collet entravant\', \'text\': "Les créatures que vos adversaires contrôlent gagnent -2/-0 jusqu\'à la fin du tour.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Éphémère\', \'flavor\': "« Je veux qu\'il me regarde droit dans les yeux et qu\'il voie le visage de celui qui va l\'abattre. »\\n—Kelsien, la Peste", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480352&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'94f89c32-fcf9-48e0-a418-21162f195b0a\', \'multiverseId\': 480352}, \'multiverseid\': 480352}, {\'name\': \'Trappola Immobilizzante\', \'text\': \'Le creature controllate dai tuoi avversari prendono -2/-0 fino alla fine del turno.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Istantaneo\', \'flavor\': \'"Voglio che mi guardi negli occhi e conosca il volto dell\\\'uomo che l\\\'ha ucciso."\\n—Kelsien, la Piaga\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480611&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'119914e5-2d7a-4928-9920-38d6eac79336\', \'multiverseId\': 480611}, \'multiverseid\': 480611}, {\'name\': \'妨害する罠\', \'text\': \'ターン終了時まで、対戦相手がコントロールしているクリーチャーは－２/－０の修整を受ける。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'インスタント\', \'flavor\': \'「その目でしっかり俺を見て、自分を倒した男の顔を知って欲しいんだ。」\\n――疫病をもたらす者、ケルシン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480870&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d6df56d5-2f3c-4366-99c4-67539de73a70\', \'multiverseId\': 480870}, \'multiverseid\': 480870}, {\'name\': \'방해하는 덫\', \'text\': \'당신의 상대들이 조종하는 생물들은 턴종료까지 -2/-0을 받는다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'순간마법\', \'flavor\': \'"난 그게 내 눈을 쳐다보면서 자기를 쓰러뜨린 사람의 얼굴을 기억하길 바래."\\n—역병, 켈시엔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481129&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6e7c5423-9806-4ef9-9950-152c5f8dc389\', \'multiverseId\': 481129}, \'multiverseid\': 481129}, {\'name\': \'Armadilha Retentora\', \'text\': \'As criaturas que seus oponentes controlam recebem -2/-0 até o final do turno.\\nReciclar {2} ({2}, descarte este card: Compre um card.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Quero que ele me olhe nos olhos e conheça o rosto do homem que o abateu."\\n— Kelsien, a Peste\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481388&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7f73ea0b-94ce-4501-889e-55644a4041bf\', \'multiverseId\': 481388}, \'multiverseid\': 481388}, {\'name\': \'Подавляющие Силки\', \'text\': \'Существа под контролем ваших оппонентов получают -2/-0 до конца хода.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Я хочу, чтобы он посмотрел мне в глаза и увидел лицо того, кто убил его».\\n— Келсиен, Моровая Погибель\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481647&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'19000905-633f-44f1-965e-2249bb19556d\', \'multiverseId\': 481647}, \'multiverseid\': 481647}, {\'name\': \'束缚陷阱\', \'text\': \'由对手操控的生物得-2/-0直到回合结束。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'瞬间\', \'flavor\': \'「我要让它看着我的眼睛，把打倒它的人类面容瞧个仔细。」\\n～疫病凯鑫\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481906&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b93afc8a-d55e-42f4-88ae-ae04b3aeae43\', \'multiverseId\': 481906}, \'multiverseid\': 481906}, {\'name\': \'束縛陷阱\', \'text\': \'由對手操控的生物得-2/-0直到回合結束。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'瞬間\', \'flavor\': \'「我要讓牠看著我的眼睛，把打倒牠的人類面容瞧個仔細。」\\n～疫病凱鑫\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482165&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b9102079-e456-4044-bbb6-3a3d8b00e62e\', \'multiverseId\': 482165}, \'multiverseid\': 482165}]', '[{\'name\': \'Herzloser Akt\', \'text\': \'Bestimme eines —\\n• Zerstöre eine Kreatur deiner Wahl, auf der keine Marke liegt.\\n• Entferne bis zu drei Marken von einer Kreatur deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Entweder wir oder sie."\\n—General Kudro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479870&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'93689035-570e-4f3c-8c66-963a1b798f58\', \'multiverseId\': 479870}, \'multiverseid\': 479870}, {\'name\': \'Acto desalmado\', \'text\': \'Elige uno:\\n• Destruye la criatura objetivo que no tenga contadores sobre ella.\\n• Remueve hasta tres contadores de la criatura objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Son ellos o nosotros".\\n—El general Kudro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480129&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3eade870-c518-49b7-bd0b-e803c07f7619\', \'multiverseId\': 480129}, \'multiverseid\': 480129}, {\'name\': \'Acte cruel\', \'text\': "Choisissez l\'un —\\n• Détruisez une créature ciblée sans marqueur sur elle.\\n• Retirez jusqu\'à trois marqueurs d\'une créature ciblée.", \'type\': \'Éphémère\', \'flavor\': "« C\'est eux ou nous. »\\n—Général Koudro", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480388&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f1c43693-3cdb-4e51-abd6-2116de2e0b9a\', \'multiverseId\': 480388}, \'multiverseid\': 480388}, {\'name\': \'Atto Spietato\', \'text\': \'Scegli uno —\\n• Distruggi una creatura bersaglio senza segnalini.\\n• Rimuovi fino a tre segnalini da una creatura bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"O loro, o noi."\\n—Generale Kudro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480647&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c7b1a5f6-338f-460e-803a-c898e38e82c6\', \'multiverseId\': 480647}, \'multiverseid\': 480647}, {\'name\': \'無情な行動\', \'text\': \'以下から１つを選ぶ。\\n• カウンターが置かれていないクリーチャー１体を対象とし、それを破壊する。\\n• クリーチャー１体を対象とし、それの上からカウンター最大３個を取り除く。\', \'type\': \'インスタント\', \'flavor\': \'「やるかやられるかだ。」\\n――クードロ将軍\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480906&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e81e0ccf-9ed3-423f-afd4-1f828d7af68c\', \'multiverseId\': 480906}, \'multiverseid\': 480906}, {\'name\': \'비정한 행동\', \'text\': \'하나를 선택한다 —\\n• 카운터가 놓여 있지 않은 생물을 목표로 정한다. 그 생물을 파괴한다.\\n• 생물을 목표로 정한다. 그 생물에 놓인 카운터를 최대 세 개까지 제거한다.\', \'type\': \'순간마법\', \'flavor\': \'"죽이지 않으면 죽을 뿐이다."\\n—쿠드로 장군\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481165&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0dbe00d0-66e3-433f-b260-a3a489ee6152\', \'multiverseId\': 481165}, \'multiverseid\': 481165}, {\'name\': \'Ato Cruel\', \'text\': \'Escolha um —\\n• Destrua a criatura alvo sem marcadores.\\n• Remova até três marcadores da criatura alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"São eles ou nós."\\n— General Kudro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481424&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d10d4055-6bb4-4c8d-bb89-2cb7c20f992a\', \'multiverseId\': 481424}, \'multiverseid\': 481424}, {\'name\': \'Бессердечное Деяние\', \'text\': \'Выберите одно —\\n• Уничтожьте целевое существо, на котором нет жетонов.\\n• Удалите не более трех жетонов с целевого существа.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Либо они, либо мы».\\n— генерал Кудро\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481683&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1a1f4a80-5d59-42d5-af3e-9f056a9d03ac\', \'multiverseId\': 481683}, \'multiverseid\': 481683}, {\'name\': \'无情手段\', \'text\': \'选择一项～\\n•消灭目标其上没有指示物的生物。\\n•从目标生物上移去至多三个指示物。\', \'type\': \'瞬间\', \'flavor\': \'「不是它们死，就是我们亡。」\\n～寇卓将军\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481942&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8313fa2d-1b25-4616-ac3e-dc7868b44d39\', \'multiverseId\': 481942}, \'multiverseid\': 481942}, {\'name\': \'無情手段\', \'text\': \'選擇一項～\\n•消滅目標其上沒有指示物的生物。\\n•從目標生物上移去至多三個指示物。\', \'type\': \'瞬間\', \'flavor\': \'「不是牠們死，就是我們亡。」\\n～寇卓將軍\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482201&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'eddd37c4-08c7-442e-af36-e0b893348b8d\', \'multiverseId\': 482201}, \'multiverseid\': 482201}]', '[{\'name\': \'Honigmammut\', \'text\': \'Wenn das Honigmammut ins Spiel kommt, erhältst du 4 Lebenspunkte dazu.\', \'type\': \'Kreatur — Elefant\', \'flavor\': \'„Und ich dachte, *ich* wäre eine Naschkatze."\\n—Gannet, Himmelstadt-Zoologe\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479937&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'56bade93-dccc-439f-98a9-d18f9c946beb\', \'multiverseId\': 479937}, \'multiverseid\': 479937}, {\'name\': \'Mamut de la miel\', \'text\': \'Cuando el Mamut de la miel entre al campo de batalla, ganas 4 vidas.\', \'type\': \'Criatura — Elefante\', \'flavor\': \'"Y yo que creía que *a mí* me gustaba el dulce".\\n—Gánet, zoólogo de Puertoaéreo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480196&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8a4ffbed-529f-4eae-b38d-6b09373c8779\', \'multiverseId\': 480196}, \'multiverseid\': 480196}, {\'name\': \'Mammouth à miel\', \'text\': \'Quand le Mammouth à miel arrive sur le champ de bataille, vous gagnez 4 points de vie.\', \'type\': \'Créature : éléphant\', \'flavor\': "« Moi qui pensais que *j\'étais* gourmand. »\\n—Gannet, zoologue de Vogueciel", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480455&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a68256a2-1ba7-42b0-a8ea-f13da7326ef6\', \'multiverseId\': 480455}, \'multiverseid\': 480455}, {\'name\': \'Mammut del Miele\', \'text\': \'Quando il Mammut del Miele entra nel campo di battaglia, guadagni 4 punti vita.\', \'type\': \'Creatura — Elefante\', \'flavor\': \'"E io che pensavo di avere una *grande* passione per i dolci..."\\n—Gannet, zoologo della Solcanembi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480714&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'78a38c6d-5df1-4f2b-bb19-39f246bf1f31\', \'multiverseId\': 480714}, \'multiverseid\': 480714}, {\'name\': \'蜂蜜マンモス\', \'text\': \'蜂蜜マンモスが戦場に出たとき、あなたは４点のライフを得る。\', \'type\': \'クリーチャー — 象\', \'flavor\': \'「僕もかなりの甘党だと思っていたんだけどね。」**\\n――スカイセイルの動物学者、ガネット\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480973&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'651a6280-fe4c-454c-9e4c-4e89fe40d8cf\', \'multiverseId\': 480973}, \'multiverseid\': 480973}, {\'name\': \'꿀 맘모스\', \'text\': \'꿀 맘모스가 전장에 들어올 때, 당신은 생명 4점을 얻는다.\', \'type\': \'생물 — 코끼리\', \'flavor\': \'"난 *내가* 충치가 심하다고 생각했지."\\n—창공돛 동물학자, 가넷\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481232&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'655b1015-db64-4c1f-ac25-b866f6705912\', \'multiverseId\': 481232}, \'multiverseid\': 481232}, {\'name\': \'Mamute do Mel\', \'text\': \'Quando Mamute do Mel entra no campo de batalha, você ganha 4 pontos de vida.\', \'type\': \'Criatura — Elefante\', \'flavor\': \'"E eu achando que *eu* era o guloso de doces."\\n— Gannet, zoólogo da Vela Celeste\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481491&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e75f7f19-be50-4fe0-9888-f7ffab7eded4\', \'multiverseId\': 481491}, \'multiverseid\': 481491}, {\'name\': \'Медовый Мамонт\', \'text\': \'Когда Медовый Мамонт выходит на поле битвы, вы получаете 4 жизни.\', \'type\': \'Существо — Слон\', \'flavor\': \'«А я-то думал, что это *я* сладкоежка».\\n— Ганнет, зоолог Небесного Паруса\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481750&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b5fdd7bd-618a-4fbc-833f-cf45d4b72c9d\', \'multiverseId\': 481750}, \'multiverseid\': 481750}, {\'name\': \'饮蜜长毛象\', \'text\': \'当饮蜜长毛象进战场时，你获得4点生命。\', \'type\': \'生物 ～象\', \'flavor\': \'「我还以为*我*甜食已经吃得够多了。」\\n～翔空城动物学家加涅特\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482009&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5ce06ed6-7569-4c99-b0cb-d10255758a9d\', \'multiverseId\': 482009}, \'multiverseid\': 482009}, {\'name\': \'飲蜜長毛象\', \'text\': \'當飲蜜長毛象進戰場時，你獲得4點生命。\', \'type\': \'生物 ～象\', \'flavor\': \'「我還以為*我*甜食已經吃得夠多了。」\\n～翔空城動物學家加涅特\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482268&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9b5e2879-72e8-4b3f-93b4-5f6321f09951\', \'multiverseId\': 482268}, \'multiverseid\': 482268}]', '[{\'name\': \'Horntrutz-Mentor\', \'text\': \'Wenn der Horntrutz-Mentor ins Spiel kommt, lege eine Trampelschaden-Marke auf eine Nicht-Mensch-Kreatur deiner Wahl, die du kontrollierst.\\n{2}{G}, {T}: Lege auf jede Kreatur, die du kontrollierst und die Trampelschaden verursacht, eine +1/+1-Marke.\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': \'„Wir haben die gleiche nuancierte Meinung über Jäger und Soldaten: Schlag sie nieder."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479938&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'73d826dc-1b35-4415-b3a3-8ee416aa1cb0\', \'multiverseId\': 479938}, \'multiverseid\': 479938}, {\'name\': \'Mentor de cuernazos\', \'text\': \'Cuando el Mentor de cuernazos entre al campo de batalla, pon un contador de arrollar sobre la criatura objetivo que no sea Humano que controlas.\\n{2}{G}, {T}: Pon un contador +1/+1 sobre cada criatura que controlas con la habilidad de arrollar.\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': \'"Compartimos la misma opinión bien meditada sobre los cazadores y los matones soldados: hay que destrozarlos".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480197&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f0d39023-7263-4118-ae6b-db41e1ec1339\', \'multiverseId\': 480197}, \'multiverseid\': 480197}, {\'name\': \'Mentor tapecorne\', \'text\': \'Quand le Mentor tapecorne arrive sur le champ de bataille, mettez un marqueur « piétinement » sur une créature non-Humain ciblée que vous contrôlez.\\n{2}{G}, {T} : Mettez un marqueur +1/+1 sur chaque créature avec le piétinement que vous contrôlez.\', \'type\': \'Créature : humain et guerrier\', \'flavor\': "« Nous avons le même avis nuancé sur la question des chasseurs et des brutes de l\'armée : il faut tous les écraser. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480456&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8c199086-14c4-4b29-968a-75e86d0991d5\', \'multiverseId\': 480456}, \'multiverseid\': 480456}, {\'name\': \'Mentore del Corno Dirompente\', \'text\': \'Quando il Mentore del Corno Dirompente entra nel campo di battaglia, metti un segnalino travolgere su una creatura non Umano bersaglio che controlli.\\n{2}{G}, {T}: Metti un segnalino +1/+1 su ogni creatura con travolgere che controlli.\', \'type\': \'Creatura — Guerriero Umano\', \'flavor\': \'"Condividiamo la stessa articolata opinione su cacciatori e sgherri dei militari: farli a pezzi."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480715&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5d2598c8-6831-4eb0-be94-54f5364a8fea\', \'multiverseId\': 480715}, \'multiverseid\': 480715}, {\'name\': \'角突きの導師\', \'text\': \'角突きの導師が戦場に出たとき、あなたがコントロールしていて人間でないクリーチャー１体を対象とし、それの上にトランプル・カウンターを１個置く。\\n{2}{G}, {T}：あなたがコントロールしていてトランプルを持つ各クリーチャーの上に＋１/＋１カウンターをそれぞれ１個置く。\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': \'「我々も、狩人や粗暴な軍人と同じような思想を共有している。相手を打ちのめす、ということだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480974&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f0c8ab4f-b9a9-4450-9400-67a4d2c6c9f6\', \'multiverseId\': 480974}, \'multiverseid\': 480974}, {\'name\': \'뿔돌진 스승\', \'text\': \'뿔돌진 스승이 전장에 들어올 때, 당신이 조종하는 인간이 아닌 생물을 목표로 정한다. 그 생물에 돌진 카운터를 올려놓는다.\\n{2}{G}, {T}: 당신이 조종하는 돌진을 가진 각 생물에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 인간 전사\', \'flavor\': \'"우리는 사냥꾼들과 군부대 멍청이들에 대해 비슷한 의미인 의견을 공유하지. 그것들을 때려눕힌다는 것 말이야."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481233&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'867218a1-3f21-4c90-af7d-30fcfc08c0fd\', \'multiverseId\': 481233}, \'multiverseid\': 481233}, {\'name\': \'Mentor da Chifradaria\', \'text\': \'Quando Mentor da Chifradaria entrar no campo de batalha, coloque um marcador de atropelar na criatura alvo que você controla que não seja um Humano.\\n{2}{G}, {T}: Coloque um marcador +1/+1 em cada criatura com atropelar que você controla.\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': \'"Temos a mesma opinião extremamente ponderada dos caçadores e dos militares: senta a pua."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481492&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c69b654a-3840-4766-b190-2f821fa6c003\', \'multiverseId\': 481492}, \'multiverseid\': 481492}, {\'name\': \'Наставник Таранного Рога\', \'text\': \'Когда Наставник Таранного Рога выходит на поле битвы, положите один жетон Пробивного удара на целевое не являющееся Человеком существо под вашим контролем.\\n{2}{G}, {T}: положите один жетон +1/+1 на каждое существо с Пробивным ударом под вашим контролем.\', \'type\': \'Существо — Человек Воин\', \'flavor\': \'«Мы разделяем мнение относительно охотников и армейских дуболомов в мельчайших подробностях: давить гадов».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481751&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1d084f6b-8946-4a9d-9b03-d5e42b4585c4\', \'multiverseId\': 481751}, \'multiverseid\': 481751}, {\'name\': \'突角明师\', \'text\': \'当突角明师进战场时，在目标由你操控的非人类生物上放置一个践踏指示物。\\n{2}{G}，{T}：在每个由你操控且具践踏异能的生物上各放置一个+1/+1指示物。\', \'type\': \'生物 ～人类／战士\', \'flavor\': \'「我们对猎人和大兵的看法基本一致：砸他们就对了。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482010&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3e3bec33-530c-4a1b-a520-aead9e36e391\', \'multiverseId\': 482010}, \'multiverseid\': 482010}, {\'name\': \'突角明師\', \'text\': \'當突角明師進戰場時，在目標由你操控的非人類生物上放置一個踐踏指示物。\\n{2}{G}，{T}：在每個由你操控且具踐踏異能的生物上各放置一個+1/+1指示物。\', \'type\': \'生物 ～人類／戰士\', \'flavor\': \'「我們對獵人和大兵的看法基本一致：砸他們就對了。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482269&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'dd4aae09-2a29-4311-9210-7b993f97e5f8\', \'multiverseId\': 482269}, \'multiverseid\': 482269}]', "[{'name': 'Höhlen des Blutvergießens', 'text': 'Die Höhlen des Blutvergießens kommen getappt ins Spiel.\\nWenn die Höhlen des Blutvergießens ins Spiel kommen, erhältst du 1 Lebenspunkt dazu.\\n{T}: Erzeuge {B} oder {R}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480022&type=card', 'language': 'German', 'identifiers': {'scryfallId': '082600d2-7374-41ed-bd73-d2003f7aaaf2', 'multiverseId': 480022}, 'multiverseid': 480022}, {'name': 'Cuevas maculasangrientas', 'text': 'Las Cuevas maculasangrientas entran al campo de batalla giradas.\\nCuando las Cuevas maculasangrientas entren al campo de batalla, ganas 1 vida.\\n{T}: Agrega {B} o {R}.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480281&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd7dee8cf-f150-4491-8c68-cf0c7e4bf712', 'multiverseId': 480281}, 'multiverseid': 480281}, {'name': 'Cavernes du Sacrifice', 'text': 'Les Cavernes du Sacrifice arrivent sur le champ de bataille engagées.\\nQuand les Cavernes du Sacrifice arrivent sur le champ de bataille, vous gagnez 1 point de vie.\\n{T} : Ajoutez {B} ou {R}.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480540&type=card', 'language': 'French', 'identifiers': {'scryfallId': '58a03190-78c6-4b2a-8cb8-21d474c05dfc', 'multiverseId': 480540}, 'multiverseid': 480540}, {'name': 'Caverne del Sangue Versato', 'text': 'Le Caverne del Sangue Versato entrano nel campo di battaglia TAPpate.\\nQuando le Caverne del Sangue Versato entrano nel campo di battaglia, guadagni 1 punto vita.\\n{T}: Aggiungi {B} o {R}.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480799&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '12b37da2-3fc4-4029-8c8b-666062621814', 'multiverseId': 480799}, 'multiverseid': 480799}, {'name': '血溜まりの洞窟', 'text': '血溜まりの洞窟はタップ状態で戦場に出る。\\n血溜まりの洞窟が戦場に出たとき、あなたは１点のライフを得る。\\n{T}：{B}か{R}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481058&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'a2484784-7d17-4d46-a701-d163ab8fcc90', 'multiverseId': 481058}, 'multiverseid': 481058}, {'name': '핏자국 동굴', 'text': '핏자국 동굴은 탭된 채로 전장에 들어온다.\\n핏자국 동굴이 전장에 들어올 때, 당신은 생명 1점을 얻는다.\\n{T}: {B} 또는 {R}를 추가한다.', 'type': '대지', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481317&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '0d2b0d7d-54db-4340-bd1c-7f42dfc2efe0', 'multiverseId': 481317}, 'multiverseid': 481317}, {'name': 'Cavernas Sanguinárias', 'text': 'Cavernas Sanguinárias entra no campo de batalha virado.\\nQuando Cavernas Sanguinárias entra no campo de batalha, você ganha 1 ponto de vida.\\n{T}: Adicione {B} ou {R}.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481576&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'db7933b6-22ea-4964-83e7-10275213c37b', 'multiverseId': 481576}, 'multiverseid': 481576}, {'name': 'Пещеры Пролитой Крови', 'text': 'Пещеры Пролитой Крови выходят на поле битвы повернутыми.\\nКогда Пещеры Пролитой Крови выходят на поле битвы, вы получаете 1 жизнь.\\n{T}: добавьте {B} или {R}.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481835&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'd6c15d76-bf67-4294-801c-1a6cf6fb6bfb', 'multiverseId': 481835}, 'multiverseid': 481835}, {'name': '染血洞窟', 'text': '染血洞窟须横置进战场。\\n当染血洞窟进战场时，你获得1点生命。\\n{T}：加{B}或{R}。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482094&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'fb800abf-fbbe-46b8-92ab-89b02f695efe', 'multiverseId': 482094}, 'multiverseid': 482094}, {'name': '染血洞窟', 'text': '染血洞窟須橫置進戰場。\\n當染血洞窟進戰場時，你獲得1點生命。\\n{T}：加{B}或{R}。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482353&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'c7eadaf5-649a-401e-a9fa-b2c7e75dc7d7', 'multiverseId': 482353}, 'multiverseid': 482353}]", '[{\'name\': \'Höhlenflüsterer\', \'text\': \'Mutation {3}{B} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\nBedrohlich (Diese Kreatur kann nicht geblockt werden, außer von zwei oder mehr Kreaturen.)\\nImmer wenn diese Kreatur mutiert, wirft jeder Gegner eine Karte ab.\', \'type\': \'Kreatur — Nachtmahr\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479858&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e7af6bb9-6c9a-4640-8bdb-aa6b6ab52b40\', \'multiverseId\': 479858}, \'multiverseid\': 479858}, {\'name\': \'Susurrante de caverna\', \'text\': \'Mutación {3}{B}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\nAmenaza. (Esta criatura no puede ser bloqueada excepto por dos o más criaturas.)\\nSiempre que esta criatura mute, cada oponente descarta una carta.\', \'type\': \'Criatura — Pesadilla\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480117&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a00d3092-afb1-44e8-b818-4436203d5dac\', \'multiverseId\': 480117}, \'multiverseid\': 480117}, {\'name\': \'Chuchoteur des cavernes\', \'text\': "Mutation {3}{B} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\nMenace (Cette créature ne peut pas être bloquée excepté par deux créatures ou plus.)\\nÀ chaque fois que cette créature subit une mutation, chaque adversaire se défausse d\'une carte.", \'type\': \'Créature : cauchemar\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480376&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'386c286a-ce8e-4280-ae4d-e318086ba4ca\', \'multiverseId\': 480376}, \'multiverseid\': 480376}, {\'name\': \'Sussurratore delle Caverne\', \'text\': \'Mutazione {3}{B} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\nMinacciare (Questa creatura non può essere bloccata tranne che da due o più creature.)\\nOgniqualvolta questa creatura muta, ogni avversario scarta una carta.\', \'type\': \'Creatura — Incubo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480635&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b84f6b5a-fe1c-48ed-97b7-6fc68eb0cf9b\', \'multiverseId\': 480635}, \'multiverseid\': 480635}, {\'name\': \'洞窟で囁くもの\', \'text\': \'変容{3}{B}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\n威迫（このクリーチャーは２体以上のクリーチャーによってしかブロックされない。）\\nこのクリーチャーが変容するたび、各対戦相手はそれぞれカード１枚を捨てる。\', \'type\': \'クリーチャー — ナイトメア\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480894&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'aefd49c7-3552-4569-9cde-966d4639ab25\', \'multiverseId\': 480894}, \'multiverseid\': 480894}, {\'name\': \'동굴 속삭임꾼\', \'text\': \'돌연변이화 {3}{B} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n호전적 (이 생물은 두 개 이상의 생물에만 방어될 수 있다.)\\n이 생물이 돌연변이화할 때마다, 각 상대는 카드 한 장을 버린다.\', \'type\': \'생물 — 나이트메어\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481153&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a5df7fa2-9d29-42d8-a544-631f57d0c0c0\', \'multiverseId\': 481153}, \'multiverseid\': 481153}, {\'name\': \'Sussurrador das Cavernas\', \'text\': \'Mutação {3}{B} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\nAmeaçar (Esta criatura só pode ser bloqueada por duas ou mais criaturas.)\\nToda vez que esta criatura sofre mutação, cada oponente descarta um card.\', \'type\': \'Criatura — Pesadelo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481412&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dac2dd96-bf46-4d3d-a034-b128f7618a1d\', \'multiverseId\': 481412}, \'multiverseid\': 481412}, {\'name\': \'Пещерный Шептун\', \'text\': \'Мутация {3}{B} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\nУгроза (Это существо не может быть заблокировано менее чем двумя существами.)\\nКаждый раз, когда это существо мутирует, каждый оппонент сбрасывает карту.\', \'type\': \'Существо — Кошмар\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481671&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'da5453ad-88c5-43b1-9b09-e8eddb821b57\', \'multiverseId\': 481671}, \'multiverseid\': 481671}, {\'name\': \'洞窟低语怪\', \'text\': \'合变{3}{B}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n威慑（此生物只能被两个或更多生物阻挡。）\\n每当此生物合变时，每位对手各弃一张牌。\', \'type\': \'生物 ～梦魇\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481930&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4b196493-a098-4763-ba8b-b4d1e4d568ea\', \'multiverseId\': 481930}, \'multiverseid\': 481930}, {\'name\': \'洞窟低語怪\', \'text\': \'合變{3}{B}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n威懾（此生物只能被兩個或更多生物阻擋。）\\n每當此生物合變時，每位對手各棄一張牌。\', \'type\': \'生物 ～夢魘\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482189&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ccbfb868-a36f-49c1-884d-07d0d1401fae\', \'multiverseId\': 482189}, \'multiverseid\': 482189}]', '[{\'name\': \'Illuna, Apex der Wünsche\', \'text\': \'Mutation {3}{R/G}{U}{U} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\nFliegend, verursacht Trampelschaden\\nImmer wenn diese Kreatur mutiert, schicke so lange die oberste Karte deiner Bibliothek ins Exil, bis du eine bleibende Karte aufdeckst, die kein Land ist. Bringe sie ins Spiel oder nimm sie auf deine Hand.\', \'type\': \'Legendäre Kreatur — Bestie, Elementarwesen, Dinosaurier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479969&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'90171ddf-2609-4213-9a14-c58335ed93bf\', \'multiverseId\': 479969}, \'multiverseid\': 479969}, {\'name\': \'Illuna, Alfa de los Deseos\', \'text\': \'Mutación {3}{R/G}{U}{U}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\nVuela, arrolla.\\nSiempre que esta criatura mute, exilia cartas de la parte superior de tu biblioteca hasta que exilies una carta de permanente que no sea tierra. Pon esa carta en el campo de batalla o en tu mano.\', \'type\': \'Criatura legendaria — Bestia elemental dinosaurio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480228&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b959e785-3a39-451d-908a-b378ee41ffe3\', \'multiverseId\': 480228}, \'multiverseid\': 480228}, {\'name\': \'Illuna, Zénith des souhaits\', \'text\': "Mutation {3}{R/G}{U}{U} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\nVol, piétinement\\nÀ chaque fois que cette créature subit une mutation, exilez les cartes du dessus de votre bibliothèque jusqu\'à ce que vous exiliez une carte de permanent non-terrain. Mettez cette carte sur le champ de bataille ou dans votre main.", \'type\': \'Créature légendaire : bête et élémental et dinosaure\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480487&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4a59ebf5-aea5-4b57-a694-e98c52b00d54\', \'multiverseId\': 480487}, \'multiverseid\': 480487}, {\'name\': \'Illuna, Alfa dei Desideri\', \'text\': \'Mutazione {3}{R/G}{U}{U} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\nVolare, travolgere\\nOgniqualvolta questa creatura muta, esilia carte dalla cima del tuo grimorio finché non esili una carta permanente non terra. Metti quella carta sul campo di battaglia o aggiungila alla tua mano.\', \'type\': \'Creatura Leggendaria — Dinosauro Elementale Bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480746&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9e5fcd63-ce45-4c20-938e-c27a7476add5\', \'multiverseId\': 480746}, \'multiverseid\': 480746}, {\'name\': \'願いの頂点、イルーナ\', \'text\': \'変容{3}{R/G}{U}{U}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\n飛行、トランプル\\nこのクリーチャーが変容するたび、土地でないパーマネント・カードが追放されるまで、あなたのライブラリーの一番上からカードを１枚ずつ追放する。そのカードを戦場に出すか、あなたの手札に加える。\', \'type\': \'伝説のクリーチャー — ビースト・エレメンタル・恐竜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481005&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1da979f9-e2f9-4edf-94f4-17195cfec3ba\', \'multiverseId\': 481005}, \'multiverseid\': 481005}, {\'name\': \'소원의 정점, 일루나\', \'text\': \'돌연변이화 {3}{R/G}{U}{U} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n비행, 돌진\\n이 생물이 돌연변이화할 때마다, 대지가 아닌 지속물 카드가 추방될 때까지 당신의 서고 맨 위 카드를 추방한다. 그 카드를 전장에 놓거나 당신의 손에 넣는다.\', \'type\': \'전설적 생물 — 야수 정령 공룡\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481264&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'11f640f0-8767-4e02-b464-77fcb711e591\', \'multiverseId\': 481264}, \'multiverseid\': 481264}, {\'name\': \'Illuna, Ápice dos Desejos\', \'text\': \'Mutação {3}{R/G}{U}{U} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\nVoar, atropelar\\nToda vez que esta criatura sofrer mutação, exile cards do topo de seu grimório até exilar um card de permanente que não seja um terreno. Coloque aquele card no campo de batalha ou em sua mão.\', \'type\': \'Criatura Lendária — Besta Elemental Dinossauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481523&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0675ce05-c20e-45a3-8d2f-74bed0ef9003\', \'multiverseId\': 481523}, \'multiverseid\': 481523}, {\'name\': \'Иллуна, Венец Желаний\', \'text\': \'Мутация {3}{R/G}{U}{U} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\nПолет, Пробивной удар\\nКаждый раз, когда это существо мутирует, изгоняйте карты с верха вашей библиотеки, пока вы не изгоните карту не являющегося землей перманента. Положите ту карту на поле битвы или в вашу руку.\', \'type\': \'Легендарное Существо — Зверь Элементаль Динозавр\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481782&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c904ba21-bacc-43cc-b875-401dc77c74bd\', \'multiverseId\': 481782}, \'multiverseid\': 481782}, {\'name\': \'控念霸兽依卢那\', \'text\': \'合变{3}{R/G}{U}{U}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n飞行，践踏\\n每当此生物合变时，从你的牌库顶开始放逐牌，直到放逐一张非地永久物牌为止。将该牌放进战场或置于你手上。\', \'type\': \'传奇生物 ～野兽／元素／恐龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482041&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'88a39e8a-0be7-482f-a392-0fd37a69d7b8\', \'multiverseId\': 482041}, \'multiverseid\': 482041}, {\'name\': \'控念霸獸依盧那\', \'text\': \'合變{3}{R/G}{U}{U}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n飛行，踐踏\\n每當此生物合變時，從你的牌庫頂開始放逐牌，直到放逐一張非地永久物牌為止。將該牌放進戰場或置於你手上。\', \'type\': \'傳奇生物 ～野獸／元素／恐龍\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482300&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d31234bd-1f5b-4c16-bcf6-60bfc6641c0b\', \'multiverseId\': 482300}, \'multiverseid\': 482300}]', '[{\'name\': \'Illuna, Apex der Wünsche\', \'text\': \'Mutation {3}{R/G}{U}{U}\\nFliegend, verursacht Trampelschaden\\nImmer wenn diese Kreatur mutiert, schicke so lange die oberste Karte deiner Bibliothek ins Exil, bis du eine bleibende Karte aufdeckst, die kein Land ist. Bringe sie ins Spiel oder nimm sie auf deine Hand.\', \'type\': \'Legendäre Kreatur — Bestie, Elementarwesen, Dinosaurier\', \'flavor\': \'Ghidorah, König des Kosmos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482392&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'347b5e33-7bb1-4679-9dd6-76792069d1da\', \'multiverseId\': 482392}, \'multiverseid\': 482392}, {\'name\': \'Illuna, Alfa de los Deseos\', \'text\': \'Mutación {3}{R/G}{U}{U}.\\nVuela, arrolla.\\nSiempre que esta criatura mute, exilia cartas de la parte superior de tu biblioteca hasta que exilies una carta de permanente que no sea tierra. Pon esa carta en el campo de batalla o en tu mano.\', \'type\': \'Criatura legendaria — Bestia elemental dinosaurio\', \'flavor\': \'Ghidorah, rey del cosmos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482406&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'41b171d3-fa72-4a26-99e3-bc1fd05520d8\', \'multiverseId\': 482406}, \'multiverseid\': 482406}, {\'name\': \'Illuna, Zénith des souhaits\', \'text\': "Mutation {3}{R/G}{U}{U}\\nVol, piétinement\\nÀ chaque fois que cette créature subit une mutation, exilez les cartes du dessus de votre bibliothèque jusqu\'à ce que vous exiliez une carte de permanent non-terrain. Mettez cette carte sur le champ de bataille ou dans votre main.", \'type\': \'Créature légendaire : bête et élémental et dinosaure\', \'flavor\': \'Ghidorah, roi du cosmos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482420&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'70260f29-a4f5-4deb-ac01-83d5be02241b\', \'multiverseId\': 482420}, \'multiverseid\': 482420}, {\'name\': \'Illuna, Alfa dei Desideri\', \'text\': \'Mutazione {3}{R/G}{U}{U}\\nVolare, travolgere\\nOgniqualvolta questa creatura muta, esilia carte dalla cima del tuo grimorio finché non esili una carta permanente non terra. Metti quella carta sul campo di battaglia o aggiungila alla tua mano.\', \'type\': \'Creatura Leggendaria — Dinosauro Elementale Bestia\', \'flavor\': \'Ghidorah, Re del Cosmo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482434&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'189a5c0a-de18-4dca-8ec9-ea13726fff28\', \'multiverseId\': 482434}, \'multiverseid\': 482434}, {\'name\': \'願いの頂点、イルーナ\', \'text\': \'変容{3}{R/G}{U}{U}\\n飛行、トランプル\\nこのクリーチャーが変容するたび、土地でないパーマネント・カードが追放されるまで、あなたのライブラリーの一番上からカードを１枚ずつ追放する。そのカードを戦場に出すか、あなたの手札に加える。\', \'type\': \'伝説のクリーチャー — ビースト・エレメンタル・恐竜\', \'flavor\': \'宇（う）宙（ちゅう）の帝（てい）王（おう）、キングギドラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482448&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f67a8104-b0f2-4f33-bf8d-4f8e322601be\', \'multiverseId\': 482448}, \'multiverseid\': 482448}, {\'name\': \'소원의 정점, 일루나\', \'text\': \'돌연변이화 {3}{R/G}{U}{U}\\n비행, 돌진\\n이 생물이 돌연변이화할 때마다, 대지가 아닌 지속물 카드가 추방될 때까지 당신의 서고 맨 위 카드를 추방한다. 그 카드를 전장에 놓거나 당신의 손에 넣는다.\', \'type\': \'전설적 생물 — 야수 정령 공룡\', \'flavor\': \'우주의 왕, 기도라\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482462&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'63239589-7664-4ecf-a2a6-e8b3dfc67979\', \'multiverseId\': 482462}, \'multiverseid\': 482462}, {\'name\': \'Illuna, Ápice dos Desejos\', \'text\': \'Mutação {3}{R/G}{U}{U}\\nVoar, atropelar\\nToda vez que esta criatura sofrer mutação, exile cards do topo de seu grimório até exilar um card de permanente que não seja um terreno. Coloque aquele card no campo de batalha ou em sua mão.\', \'type\': \'Criatura Lendária — Besta Elemental Dinossauro\', \'flavor\': \'Ghidorah, Rei do Cosmo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482476&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d54f1b2f-1c51-4472-b49c-3ff2659bd9b9\', \'multiverseId\': 482476}, \'multiverseid\': 482476}, {\'name\': \'Иллуна, Венец Желаний\', \'text\': \'Мутация {3}{R/G}{U}{U}\\nПолет, Пробивной удар\\nКаждый раз, когда это существо мутирует, изгоняйте карты с верха вашей библиотеки, пока вы не изгоните карту не являющегося землей перманента. Положите ту карту на поле битвы или в вашу руку.\', \'type\': \'Легендарное Существо — Зверь Элементаль Динозавр\', \'flavor\': \'Гидора, Король Космоса\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482490&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fe443950-590c-4df2-bf04-7256e2cf22ae\', \'multiverseId\': 482490}, \'multiverseid\': 482490}, {\'name\': \'控念霸兽依卢那\', \'text\': \'合变{3}{R/G}{U}{U}\\n飞行，践踏\\n每当此生物合变时，从你的牌库顶开始放逐牌，直到放逐一张非地永久物牌为止。将该牌放进战场或置于你手上。\', \'type\': \'传奇生物 ～野兽／元素／恐龙\', \'flavor\': \'宇宙王者基多拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482504&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2cd1c278-475d-418d-a47b-2008240f904e\', \'multiverseId\': 482504}, \'multiverseid\': 482504}, {\'name\': \'控念霸獸依盧那\', \'text\': \'合變{3}{R/G}{U}{U}\\n飛行，踐踏\\n每當此生物合變時，從你的牌庫頂開始放逐牌，直到放逐一張非地永久物牌為止。將該牌放進戰場或置於你手上。\', \'type\': \'傳奇生物 ～野獸／元素／恐龍\', \'flavor\': \'宇宙王者基多拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482518&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c133c9d5-ca77-4240-b805-cc6263492c87\', \'multiverseId\': 482518}, \'multiverseid\': 482518}]', '[{\'name\': \'Im Ganzen verschlingen\', \'text\': \'Tappe als zusätzliche Kosten, um diesen Zauberspruch zu wirken, eine ungetappte Kreatur, die du kontrollierst.\\nSchicke eine getappte Kreatur deiner Wahl ins Exil. Lege eine +1/+1-Marke auf die Kreatur, die getappt wurde, um die zusätzlichen Kosten für diesen Zauberspruch zu bezahlen.\', \'type\': \'Hexerei\', \'flavor\': \'„Ein Wilderer weniger auf der Welt."\\n—Winota, Herzbynderin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479814&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c643093f-0efd-4cdf-9be9-0a838853767a\', \'multiverseId\': 479814}, \'multiverseid\': 479814}, {\'name\': \'De un bocado\', \'text\': \'Como coste adicional para lanzar este hechizo, gira una criatura enderezada que controlas.\\nExilia la criatura girada objetivo. Pon un contador +1/+1 sobre la criatura girada para pagar el coste adicional de este hechizo.\', \'type\': \'Conjuro\', \'flavor\': \'"El mundo es un lugar mejor con un cazador furtivo menos en él".\\n—Winota, vinculacorazones\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480073&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3accaf48-0c88-4a12-aa80-9c9bdf8d8ba9\', \'multiverseId\': 480073}, \'multiverseid\': 480073}, {\'name\': \'Avaler tout entier\', \'text\': \'En tant que coût supplémentaire pour lancer ce sort, engagez une créature dégagée que vous contrôlez.\\nExilez la créature engagée ciblée. Mettez un marqueur +1/+1 sur la créature engagée pour payer le coût supplémentaire de ce sort.\', \'type\': \'Rituel\', \'flavor\': \'« Le monde se porte mieux avec un braconnier de moins. »\\n—Winota, bridecœur\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480332&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6ee3d72e-b3bc-409e-81e6-8909de2e9ac7\', \'multiverseId\': 480332}, \'multiverseid\': 480332}, {\'name\': \'Inghiottire\', \'text\': \'Come costo addizionale per lanciare questa magia, TAPpa una creatura STAPpata che controlli.\\nEsilia una creatura TAPpata bersaglio. Metti un segnalino +1/+1 sulla creatura TAPpata per pagare il costo addizionale di questa magia.\', \'type\': \'Stregoneria\', \'flavor\': \'"Il mondo è un posto migliore con un cacciatore di frodo in meno."\\n—Winota, vincolacuore\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480591&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ab05d8f7-a762-43b6-8e4f-64190fc11250\', \'multiverseId\': 480591}, \'multiverseid\': 480591}, {\'name\': \'丸呑み\', \'text\': \'この呪文を唱えるための追加コストとして、あなたがコントロールしていてアンタップ状態のクリーチャー１体をタップする。\\nタップ状態のクリーチャー１体を対象とし、それを追放する。この呪文の追加コストを支払うためにタップしたクリーチャーの上に＋１/＋１カウンターを１個置く。\', \'type\': \'ソーサリー\', \'flavor\': \'「密猟者が一人減るたびに、世界はより良くなる。」\\n――心眷者、ウィノータ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480850&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a11cffb7-af59-4c7d-bd65-3ff1a3627bc5\', \'multiverseId\': 480850}, \'multiverseid\': 480850}, {\'name\': \'통째로 삼키기\', \'text\': \'이 주문을 발동하기 위한 추가비용으로, 당신이 조종하는 언탭된 생물 한 개를 탭한다.\\n탭된 생물을 목표로 정한다. 그 생물을 추방한다. 이 주문의 추가비용을 지불하기 위해 탭된 생물에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'집중마법\', \'flavor\': \'"밀렵꾼이 하나 줄어들면 세상은 그만큼 더 나아지지."\\n—감정유대자, 위노타\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481109&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'74c3c764-f283-4b1b-ae24-a96a6ec13769\', \'multiverseId\': 481109}, \'multiverseid\': 481109}, {\'name\': \'Engolir Inteiro\', \'text\': \'Como custo adicional para conjurar esta mágica, vire uma criatura desvirada que você controla.\\nExile a criatura virada alvo. Coloque um marcador +1/+1 na criatura virada para pagar o custo adicional desta mágica.\', \'type\': \'Feitiço\', \'flavor\': \'"O mundo fica melhor com um caçador a menos."\\n— Winota, vinculadora de almas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481368&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2645e57f-1db5-4a78-aa45-27624da048a1\', \'multiverseId\': 481368}, \'multiverseid\': 481368}, {\'name\': \'Проглотить Целиком\', \'text\': \'В качестве дополнительной стоимости разыгрывания этого заклинания поверните неповернутое существо под вашим контролем.\\nИзгоните целевое повернутое существо. Положите один жетон +1/+1 на существо, повернутое для оплаты дополнительной стоимости этого заклинания.\', \'type\': \'Волшебство\', \'flavor\': \'«Одним браконьером меньше — мир станет только лучше».\\n— Винота, узомантка сердца\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481627&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e249f71d-5e23-4410-a82a-8d77e061ffc2\', \'multiverseId\': 481627}, \'multiverseid\': 481627}, {\'name\': \'生体活吞\', \'text\': \'横置一个由你操控且未横置的生物，以作为施放此咒语的额外费用。\\n放逐目标已横置的生物。在横置用以支付此咒语之额外费用的生物上放置一个+1/+1指示物。\', \'type\': \'法术\', \'flavor\': \'「少了一个偷猎者，世界变得更美好。」\\n～情念持绊人薇诺塔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481886&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cfab42b1-8cb1-4c3e-8e63-c3bea540308c\', \'multiverseId\': 481886}, \'multiverseid\': 481886}, {\'name\': \'生體活吞\', \'text\': \'橫置一個由你操控且未橫置的生物，以作為施放此咒語的額外費用。\\n放逐目標已橫置的生物。在橫置用以支付此咒語之額外費用的生物上放置一個+1/+1指示物。\', \'type\': \'巫術\', \'flavor\': \'「少了一個偷獵者，世界變得更美好。」\\n～情念持絆人薇諾塔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482145&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c36e97d1-6877-4e04-8076-1e3e3708816d\', \'multiverseId\': 482145}, \'multiverseid\': 482145}]', '[{\'name\': \'Immerfeder-Phoenix\', \'text\': \'Mutation {3}{R} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\nFliegend\\nImmer wenn diese Kreatur mutiert, erzeuge einen roten Artefaktspielstein namens Feder mit „{1}, opfere die Feder: Bringe eine Phoenix-Karte deiner Wahl aus deinem Friedhof getappt ins Spiel zurück."\', \'type\': \'Kreatur — Phoenix\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479893&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e7f22d63-97fd-41fa-a2fc-a979b4f26a4d\', \'multiverseId\': 479893}, \'multiverseid\': 479893}, {\'name\': \'Fénix plumaeterna\', \'text\': \'Mutación {3}{R}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\nVuela.\\nSiempre que esta criatura mute, crea una ficha de artefacto roja llamada Pluma con "{1}, sacrificar la Pluma: Regresa la carta de Fénix objetivo de tu cementerio al campo de batalla girada".\', \'type\': \'Criatura — Fénix\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480152&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'41df2196-dc61-4be4-bbd5-b0d282734c46\', \'multiverseId\': 480152}, \'multiverseid\': 480152}, {\'name\': \'Phénix aux plumes perpétuelles\', \'text\': "Mutation {3}{R} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\nVol\\nÀ chaque fois que cette créature subit une mutation, créez un jeton d\'artefact rouge appelé Plume avec « {1}, sacrifiez la Plume : Renvoyez sur le champ de bataille, engagée, une carte de phénix ciblée depuis votre cimetière. »", \'type\': \'Créature : phénix\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480411&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4bacdc8b-0314-4263-950b-b3d5a4214786\', \'multiverseId\': 480411}, \'multiverseid\': 480411}, {\'name\': \'Fenice della Piuma Eterna\', \'text\': \'Mutazione {3}{R} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\nVolare\\nOgniqualvolta questa creatura muta, crea una pedina artefatto rossa chiamata Piuma con "{1}, Sacrifica la Piuma: Rimetti sul campo di battaglia TAPpata una carta Fenice bersaglio dal tuo cimitero."\', \'type\': \'Creatura — Fenice\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480670&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0394e758-42ea-4328-b08c-a81c1916be1e\', \'multiverseId\': 480670}, \'multiverseid\': 480670}, {\'name\': \'永遠羽のフェニックス\', \'text\': \'変容{3}{R}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\n飛行\\nこのクリーチャーが変容するたび、「羽根」という名前で「{1}, 羽根を生け贄に捧げる：あなたの墓地からフェニックス・カード１枚を対象とし、それをタップ状態で戦場に戻す。」を持つ赤のアーティファクト・トークンを１つ生成する。\', \'type\': \'クリーチャー — フェニックス\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480929&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'352535cb-05eb-4b09-86c7-4d10ba44b362\', \'multiverseId\': 480929}, \'multiverseid\': 480929}, {\'name\': \'영원깃털 불사조\', \'text\': \'돌연변이화 {3}{R} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n비행\\n이 생물이 돌연변이화할 때마다, 이름이 깃털이며 "{1}, 깃털을 희생한다: 당신의 무덤에 있는 불사조 카드를 목표로 정한다. 그 카드를 탭된 채로 전장으로 되돌린다."를 가진 적색 마법물체 토큰 한 개를 만든다.\', \'type\': \'생물 — 불사조\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481188&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'faa1cd24-5d37-455a-9413-34ab9d277b04\', \'multiverseId\': 481188}, \'multiverseid\': 481188}, {\'name\': \'Fênix Plumeterna\', \'text\': \'Mutação {3}{R} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\nVoar\\nToda vez que esta criatura sofrer mutação, crie uma ficha de artefato vermelho com o nome Pluma com "{1}, sacrifique Pluma: Devolva o card de Fênix alvo de seu cemitério para o campo de batalha virado."\', \'type\': \'Criatura — Fênix\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481447&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d5266318-76f9-4d29-bc5a-068cfb9ee1e4\', \'multiverseId\': 481447}, \'multiverseid\': 481447}, {\'name\': \'Феникс Вечного Пера\', \'text\': \'Мутация {3}{R} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\nПолет\\nКаждый раз, когда это существо мутирует, создайте одну фишку красного артефакта с именем Перо и способностью «{1}, пожертвуйте Перо: верните целевую карту Феникса из вашего кладбища на поле битвы повернутой».\', \'type\': \'Существо — Феникс\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481706&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e938134f-5457-47ac-8fb3-5ec64da7d417\', \'multiverseId\': 481706}, \'multiverseid\': 481706}, {\'name\': \'恒羽凤凰\', \'text\': \'合变{3}{R}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n飞行\\n每当此生物合变时，派出一个名称为翎羽的红色衍生神器，此神器具有「{1}，牺牲翎羽：将目标凤凰牌从你的坟墓场横置移回战场。」\', \'type\': \'生物 ～凤凰\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481965&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'14812ac8-e314-4646-be2e-8e2ce1e87d56\', \'multiverseId\': 481965}, \'multiverseid\': 481965}, {\'name\': \'恆羽鳳凰\', \'text\': \'合變{3}{R}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n飛行\\n每當此生物合變時，派出一個名稱為翎羽的紅色衍生神器，此神器具有「{1}，犧牲翎羽：將目標鳳凰牌從你的墳墓場橫置移回戰場。」\', \'type\': \'生物 ～鳳凰\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482224&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3de37e8b-1b75-40c1-a2d3-ca022fe9f4a7\', \'multiverseId\': 482224}, \'multiverseid\': 482224}]', '[{\'name\': \'Immerfeder-Phoenix\', \'text\': \'Mutation {3}{R}\\nFliegend\\nImmer wenn diese Kreatur mutiert, erzeuge einen roten Artefaktspielstein namens Feder mit „{1}, opfere die Feder: Bringe eine Phoenix-Karte deiner Wahl aus deinem Friedhof getappt ins Spiel zurück."\', \'type\': \'Kreatur — Phoenix\', \'flavor\': \'Destoroyah, perfekte Lebensform\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482387&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'57388044-1875-42b9-8b3e-9c8edcf2f8e7\', \'multiverseId\': 482387}, \'multiverseid\': 482387}, {\'name\': \'Fénix plumaeterna\', \'text\': \'Mutación {3}{R}.\\nVuela.\\nSiempre que esta criatura mute, crea una ficha de artefacto roja llamada Pluma con "{1}, sacrificar la Pluma: Regresa la carta de Fénix objetivo de tu cementerio al campo de batalla girada".\', \'type\': \'Criatura — Fénix\', \'flavor\': \'Destoroyah, ser perfecto\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482401&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a3d5ac41-fb5e-4d43-98e8-838a3060f9eb\', \'multiverseId\': 482401}, \'multiverseid\': 482401}, {\'name\': \'Phénix aux plumes perpétuelles\', \'text\': "Mutation {3}{R}\\nVol\\nÀ chaque fois que cette créature subit une mutation, créez un jeton d\'artefact rouge appelé Plume avec « {1}, sacrifiez la Plume : Renvoyez sur le champ de bataille, engagée, une carte de phénix ciblée depuis votre cimetière. »", \'type\': \'Créature : phénix\', \'flavor\': \'Destoroyah, forme de vie parfaite\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482415&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d0966017-1a3d-4022-b17f-863a3193ddfc\', \'multiverseId\': 482415}, \'multiverseid\': 482415}, {\'name\': \'Fenice della Piuma Eterna\', \'text\': \'Mutazione {3}{R}\\nVolare\\nOgniqualvolta questa creatura muta, crea una pedina artefatto rossa chiamata Piuma con "{1}, Sacrifica la Piuma: Rimetti sul campo di battaglia TAPpata una carta Fenice bersaglio dal tuo cimitero."\', \'type\': \'Creatura — Fenice\', \'flavor\': \'Destoroyah, Forma di Vita Perfetta\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482429&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'63765383-25f5-47cf-a5ac-4de2c1651b23\', \'multiverseId\': 482429}, \'multiverseid\': 482429}, {\'name\': \'永遠羽のフェニックス\', \'text\': \'変容{3}{R}\\n飛行\\nこのクリーチャーが変容するたび、「羽根」という名前で「{1}, 羽根を生け贄に捧げる：あなたの墓地からフェニックス・カード１枚を対象とし、それをタップ状態で戦場に戻す。」を持つ赤のアーティファクト・トークンを１つ生成する。\', \'type\': \'クリーチャー — フェニックス\', \'flavor\': \'完（かん）全（ぜん）生（せい）命（めい）体（たい）、デストロイア\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482443&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a7cc4e23-bc6d-4418-b340-b7b3278be5e9\', \'multiverseId\': 482443}, \'multiverseid\': 482443}, {\'name\': \'영원깃털 불사조\', \'text\': \'돌연변이화 {3}{R}\\n비행\\n이 생물이 돌연변이화할 때마다, 이름이 깃털이며 "{1}, 깃털을 희생한다: 당신의 무덤에 있는 불사조 카드를 목표로 정한다. 그 카드를 탭된 채로 전장으로 되돌린다."를 가진 적색 마법물체 토큰 한 개를 만든다.\', \'type\': \'생물 — 불사조\', \'flavor\': \'완벽한 생명체, 디스트로이아\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482457&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5648fe72-d9e4-4c79-8e46-a83ab85688a9\', \'multiverseId\': 482457}, \'multiverseid\': 482457}, {\'name\': \'Fênix Plumeterna\', \'text\': \'Mutação {3}{R}\\nVoar\\nToda vez que esta criatura sofrer mutação, crie uma ficha de artefato vermelho com o nome Pluma com "{1}, sacrifique Pluma: Devolva o card de Fênix alvo de seu cemitério para o campo de batalha virado."\', \'type\': \'Criatura — Fênix\', \'flavor\': \'Destoroyah, Forma de Vida Perfeita\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482471&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a74d1766-9469-4b22-97d0-9ade798785e5\', \'multiverseId\': 482471}, \'multiverseid\': 482471}, {\'name\': \'Феникс Вечного Пера\', \'text\': \'Мутация {3}{R}\\nПолет\\nКаждый раз, когда это существо мутирует, создайте одну фишку красного артефакта с именем Перо и способностью «{1}, пожертвуйте Перо: верните целевую карту Феникса из вашего кладбища на поле битвы повернутой».\', \'type\': \'Существо — Феникс\', \'flavor\': \'Разрушитель, Идеальное Существо\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482485&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b845f316-801c-4e0b-982f-f54b8f57a152\', \'multiverseId\': 482485}, \'multiverseid\': 482485}, {\'name\': \'恒羽凤凰\', \'text\': \'合变{3}{R}\\n飞行\\n每当此生物合变时，派出一个名称为翎羽的红色衍生神器，此神器具有「{1}，牺牲翎羽：将目标凤凰牌从你的坟墓场横置移回战场。」\', \'type\': \'生物 ～凤凰\', \'flavor\': \'完全生命体戴斯特洛伊亚\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482499&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e3f77fda-d382-4083-8adc-a5b09519d331\', \'multiverseId\': 482499}, \'multiverseid\': 482499}, {\'name\': \'恆羽鳳凰\', \'text\': \'合變{3}{R}\\n飛行\\n每當此生物合變時，派出一個名稱為翎羽的紅色衍生神器，此神器具有「{1}，犧牲翎羽：將目標鳳凰牌從你的墳墓場橫置移回戰場。」\', \'type\': \'生物 ～鳳凰\', \'flavor\': \'完全生命體戴斯特洛伊亞\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482513&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b1bdb072-ca8a-4d3b-be75-9d27d93df566\', \'multiverseId\': 482513}, \'multiverseid\': 482513}]', '[{\'name\': \'Imposanter Vantasaurus\', \'text\': \'Wachsamkeit\\nUmwandlung {1} ({1}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Kreatur — Dinosaurier\', \'flavor\': \'Die Küste von Raugrin kann sehr schön sein, solange man den Vulkansauriern, den Meeressauriern und den umherstreifenden Strandsauriern aus dem Weg geht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479796&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c872409e-26a2-4c6b-b682-4d55349c2269\', \'multiverseId\': 479796}, \'multiverseid\': 479796}, {\'name\': \'Altosaurio imponente\', \'text\': \'Vigilancia.\\nCiclo {1}. ({1}, descartar esta carta: Roba una carta.)\', \'type\': \'Criatura — Dinosaurio\', \'flavor\': \'La costa de Raugrin puede ser muy hermosa, siempre que evites los dinosaurios volcánicos, los dinosaurios marinos y los dinosaurios que rondan por la playa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480055&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'30611d73-5e5a-455a-b821-1aa70c9d56a5\', \'multiverseId\': 480055}, \'multiverseid\': 480055}, {\'name\': \'Miradosaure imposant\', \'text\': \'Vigilance\\nRecyclage {1} ({1}, défaussez-vous de cette carte : Piochez une carte.)\', \'type\': \'Créature : dinosaure\', \'flavor\': "La côte de Raugrin peut être très belle tant qu\'on évite les dinosaures volcaniques, les dinosaures des mers, et les dinosaures des sables.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480314&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6edab391-c043-4a27-a35f-7e4e40b9d052\', \'multiverseId\': 480314}, \'multiverseid\': 480314}, {\'name\': \'Superiosauro Imponente\', \'text\': \'Cautela\\nCiclo {1} ({1}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Creatura — Dinosauro\', \'flavor\': \'La costa di Raugrin può essere incantevole, basta evitare i dinosauri vulcanici, quelli marini e quelli che vagano sulla spiaggia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480573&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'44cbd108-8e7d-4abe-9529-f5be7810887b\', \'multiverseId\': 480573}, \'multiverseid\': 480573}, {\'name\': \'威圧するヴァンタサウルス\', \'text\': \'警戒\\nサイクリング{1}（{1}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'クリーチャー — 恐竜\', \'flavor\': \'ラウグリンの海岸線は非常に美しい。火山の恐竜や、海の恐竜、そして辺りをうろつく海岸の恐竜を避けることさえできれば。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480832&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6b4e1322-093a-4b46-921e-1c871d5c536a\', \'multiverseId\': 480832}, \'multiverseid\': 480832}, {\'name\': \'위압적인 반타사우루스\', \'text\': \'경계\\n순환 {1} ({1}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'생물 — 공룡\', \'flavor\': \'라우그린의 해안선은 아주 아름답다. 화산 공룡, 바다 공룡, 그리고 돌아다니는 해안 공룡들을 피해 다닐 수만 있다면 말이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481091&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3b0422ee-dadb-4f81-87db-076769c448b4\', \'multiverseId\': 481091}, \'multiverseid\': 481091}, {\'name\': \'Vantassauro Imponente\', \'text\': \'Vigilância\\nReciclar {1} ({1}, descarte este card: Compre um card.)\', \'type\': \'Criatura — Dinossauro\', \'flavor\': \'O litoral de Raugrin pode ser lindo, desde que você evite os dinossauros vulcânicos, os dinossauros marinhos e os dinossauros que vagam pelas praias.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481350&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b3dd8de5-561a-4556-8d0c-1e0378599146\', \'multiverseId\': 481350}, \'multiverseid\': 481350}, {\'name\': \'Внушительный Вышезавр\', \'text\': \'Бдительность\\nЦикл {1} ({1}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Существо — Динозавр\', \'flavor\': \'Побережье Раугрина — очень красивое место, если не попадаться вулканическим динозаврам, морским динозаврам и динозаврам, бродящим по берегу.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481609&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6f39bd8d-268f-4d60-9d2b-aa3e9c36066c\', \'multiverseId\': 481609}, \'multiverseid\': 481609}, {\'name\': \'庄严高颈龙\', \'text\': \'警戒\\n循环{1}（{1}，弃掉此牌：抓一张牌。）\', \'type\': \'生物 ～恐龙\', \'flavor\': \'洛格凌的沿岸风光堪称绝景，只是你要小心躲开火山恐龙、栖海恐龙和四处游荡的海滩恐龙。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481868&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'290eb9d1-6462-4dac-a11d-c3566c6bb9a4\', \'multiverseId\': 481868}, \'multiverseid\': 481868}, {\'name\': \'莊嚴高頸龍\', \'text\': \'警戒\\n循環{1}（{1}，棄掉此牌：抽一張牌。）\', \'type\': \'生物 ～恐龍\', \'flavor\': \'洛格凌的沿岸風光堪稱絕景，只是你要小心躲開火山恐龍、棲海恐龍和四處遊蕩的海灘恐龍。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482127&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7329e4c5-46f3-4b43-bd32-731bd4d43b21\', \'multiverseId\': 482127}, \'multiverseid\': 482127}]', '[{\'name\': \'Indatha-Kristall\', \'text\': \'{T}: Erzeuge {W}, {B} oder {G}.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Artefakt\', \'flavor\': \'Kristalle schmiegen sich an die Wurzeln von Indathas Helixbäumen, als ob sie von ihrer Umarmung genährt würden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480014&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'62d5ece2-9482-43de-aa11-d11184bba864\', \'multiverseId\': 480014}, \'multiverseid\': 480014}, {\'name\': \'Cristal de Indatha\', \'text\': \'{T}: Agrega {W}, {B} o {G}.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Artefacto\', \'flavor\': \'Los cristales anidan en las raíces de los hélicas de Indatha, como si su abrazo los nutriera.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480273&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dc12be50-ac46-4e0d-a837-cb87260caeed\', \'multiverseId\': 480273}, \'multiverseid\': 480273}, {\'name\': "Cristal d\'Indatha", \'text\': \'{T} : Ajoutez {W}, {B} ou {G}.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)\', \'type\': \'Artefact\', \'flavor\': "Les cristaux se nichent dans les racines des spiracacias d\'Indatha comme s\'ils se nourrissaient de leur étreinte.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480532&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'46ab5373-88ac-4e5f-a272-a69bfa7f6731\', \'multiverseId\': 480532}, \'multiverseid\': 480532}, {\'name\': \'Cristallo di Indatha\', \'text\': \'{T}: Aggiungi {W}, {B} o {G}.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Artefatto\', \'flavor\': \'I cristalli si annidano tra le radici di fitoelice di Indatha come se fossero alimentati dal loro abbraccio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480791&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'db946695-7c6f-414b-9c2f-54c6abe4fb19\', \'multiverseId\': 480791}, \'multiverseid\': 480791}, {\'name\': \'インダサの水晶\', \'text\': \'{T}：{W}か{B}か{G}を加える。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'アーティファクト\', \'flavor\': \'水晶はインダサのらせん樹の根に抱かれている。まるでその抱擁に育まれているかのようだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481050&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'472a0d13-eb4d-4ad4-aa79-f2f0cc5e438a\', \'multiverseId\': 481050}, \'multiverseid\': 481050}, {\'name\': \'인다타 수정\', \'text\': \'{T}: {W}, {B}, 또는 {G}를 추가한다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'마법물체\', \'flavor\': \'수정들은 인다타의 헬리카 나무들의 뿌리 속에서 마치 뿌리가 수정을 보듬고 안은 것처럼 자리를 잡고 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481309&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e2e3c637-0ba3-488e-a62c-19284972d38f\', \'multiverseId\': 481309}, \'multiverseid\': 481309}, {\'name\': \'Cristal de Indatha\', \'text\': \'{T}: Adicione {W}, {B} ou {G}.\\nReciclar {2} ({2}, descarte este card: Compre um card.)\', \'type\': \'Artefato\', \'flavor\': \'Os cristais se aninham nas raízes das heliqueiras de Indatha, como se fossem nutridos por seu abraço.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481568&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fe692eee-b992-4a28-8996-73e0f68749cd\', \'multiverseId\': 481568}, \'multiverseid\': 481568}, {\'name\': \'Кристалл Индаты\', \'text\': \'{T}: добавьте {W}, {B} или {G}.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Артефакт\', \'flavor\': \'Кристаллы растут среди корней спираледеревьев, словно вскармливаемые их объятьями.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481827&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'094ffbb0-7f70-42da-906c-e65362f17b51\', \'multiverseId\': 481827}, \'multiverseid\': 481827}, {\'name\': \'因达沙水晶\', \'text\': \'{T}：加{W}，{B}或{G}。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'神器\', \'flavor\': \'因达沙的水晶受曲枝树根系环绕，仿佛受其呵护而不断成长。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482086&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'74ae42ef-980c-4e79-a56c-bb850c52d20e\', \'multiverseId\': 482086}, \'multiverseid\': 482086}, {\'name\': \'因達沙水晶\', \'text\': \'{T}：加{W}，{B}或{G}。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'神器\', \'flavor\': \'因達沙的水晶受曲枝樹根系環繞，彷彿受其呵護而不斷成長。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482345&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8c8ad4ed-ca98-4b6d-b930-dab36faf82c8\', \'multiverseId\': 482345}, \'multiverseid\': 482345}]', '[{\'name\': \'Indatha-Triom\', \'text\': \'({T}: Erzeuge {W}, {B} oder {G}.)\\nDas Indatha-Triom kommt getappt ins Spiel.\\nUmwandlung {3} ({3}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Land — Ebene, Sumpf, Wald\', \'flavor\': \'„Diese Tiefebenen wurden vor tausenden Jahren vom Behemoth Indath geschaffen — seine letzten Fußabdrücke, bevor er im Meer verschwand."\\n—*Geschichten vom Ozolith*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480027&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'06562d4c-ed07-4f93-964f-000f4051291f\', \'multiverseId\': 480027}, \'multiverseid\': 480027}, {\'name\': \'Trioma de Indatha\', \'text\': \'({T}: Agrega {W}, {B} o {G}.)\\nEl Trioma de Indatha entra al campo de batalla girado.\\nCiclo {3}. ({3}, descartar esta carta: Roba una carta.)\', \'type\': \'Tierra — Llanura pantano bosque\', \'flavor\': \'"Estos pantanos los formó hace miles de años el behemot Indath, y fueron sus últimos pasos antes de desvanecerse en el mar".\\n—*Cuentos del Ozolito*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480286&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d0e4568b-1977-4679-be6b-1aed8727e1f3\', \'multiverseId\': 480286}, \'multiverseid\': 480286}, {\'name\': "Triome d\'Indatha", \'text\': "({T} : Ajoutez {W}, {B} ou {G}.)\\nLe Triome d\'Indatha arrive sur le champ de bataille engagé.\\nRecyclage {3} ({3}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Terrain : plaine et marais et forêt\', \'flavor\': "« Ces basses terres furent formées il y a des millénaires par le béhémoth Indath : il s\'agissait de ses derniers pas avant de disparaître dans l\'océan. »\\n—*Contes de l\'Ozolithe*", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480545&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'63fd4371-4e63-476f-b051-4db8f678a99a\', \'multiverseId\': 480545}, \'multiverseid\': 480545}, {\'name\': \'Trioma di Indatha\', \'text\': \'({T}: Aggiungi {W}, {B} o {G}.)\\nIl Trioma di Indatha entra nel campo di battaglia TAPpato.\\nCiclo {3} ({3}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Terra — Pianura Palude Foresta\', \'flavor\': \'"Questi bassopiani vennero formati migliaia di anni fa dal behemoth Indath, quando mosse i suoi ultimi passi prima di svanire nel mare."\\n—*Racconti dell\\\'Ozolito*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480804&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5a655c90-c8cf-46af-9684-d4177ffbd6f6\', \'multiverseId\': 480804}, \'multiverseid\': 480804}, {\'name\': \'インダサのトライオーム\', \'text\': \'（{T}：{W}か{B}か{G}を加える。）\\nインダサのトライオームはタップ状態で戦場に出る。\\nサイクリング{3}（{3}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'土地 — 平地・沼・森\', \'flavor\': \'「この低地は何千年も前にインダス巨獣が作り出した。それが海へ消える前に残した、最後の足跡なのだ。」\\n――*オゾリスの物語*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481063&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b301e00c-86c8-4bc9-ae7c-a298eb360808\', \'multiverseId\': 481063}, \'multiverseid\': 481063}, {\'name\': \'인다타 삼생물군계\', \'text\': \'({T}: {W}, {B}, 또는 {G}를 추가한다.)\\n인다타 삼생물군계는 탭된 채로 전장에 들어온다.\\n순환 {3} ({3}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'대지 — 들 늪 숲\', \'flavor\': \'"이 저지대는 수천 년 전 거대괴수 인다스가 바다로 사라지기 전에 마지막으로 남긴 발자국으로 형성되었다."\\n—*오조리스 이야기*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481322&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'26e61c28-b2dc-4c68-9805-1a6e6b536603\', \'multiverseId\': 481322}, \'multiverseid\': 481322}, {\'name\': \'Trioma de Indatha\', \'text\': \'({T}: Adicione {W}, {B} ou {G}.)\\nTrioma de Indatha entra no campo de batalha virado.\\nReciclar {3} ({3}, descarte este card: Compre um card.)\', \'type\': \'Terreno — Planície Pântano Floresta\', \'flavor\': \'"Essas baixadas foram formadas há milhares de anos pelo colossal Indath, foram seus últimos passos antes de desaparecer no mar."\\n— *Contos do Ozólito*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481581&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c1a9b1fe-4939-446c-8c38-61bedc6e934b\', \'multiverseId\': 481581}, \'multiverseid\': 481581}, {\'name\': \'Триом Индата\', \'text\': \'({T}: добавьте {W}, {B} или {G}.)\\nТриом Индата выходит на поле битвы повернутым.\\nЦикл {3} ({3}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Земля — Равнина Болото Лес\', \'flavor\': \'«Тысячи лет назад эти низины появились из следов исполинского Индата — его последних шагов, прежде чем он навсегда скрылся в море».\\n— *«Истории Озолита»*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481840&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ade29163-1122-4d10-b46e-468068b6d694\', \'multiverseId\': 481840}, \'multiverseid\': 481840}, {\'name\': \'因达沙群系\', \'text\': \'（{T}：加{W}，{B}或{G}。）\\n因达沙群系须横置进战场。\\n循环{3}（{3}，弃掉此牌：抓一张牌。）\', \'type\': \'地 ～平原／沼泽／树林\', \'flavor\': \'「传说数千年前巨兽因达煞曾行经此处～而它在海中消失前最终留下的足印便演变为这片低洼之地。」\\n～*《欧佐晶岩传说》*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482099&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'206ada71-1ea1-4405-9256-397a1b0ecb59\', \'multiverseId\': 482099}, \'multiverseid\': 482099}, {\'name\': \'因達沙群系\', \'text\': \'（{T}：加{W}，{B}或{G}。）\\n因達沙群系須橫置進戰場。\\n循環{3}（{3}，棄掉此牌：抽一張牌。）\', \'type\': \'地 ～平原／沼澤／樹林\', \'flavor\': \'「傳說數千年前巨獸因達煞曾行經此處～而牠在海中消失前最終留下的足印便演變為這片低窪之地。」\\n～*《歐佐晶岩傳說》*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482358&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1d84cbbc-9ae7-484f-9247-96fc86907cc5\', \'multiverseId\': 482358}, \'multiverseid\': 482358}]', "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482553&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'ad79ad7c-202c-4e8d-bc85-e50f73fdc2ff', 'multiverseId': 482553}, 'multiverseid': 482553}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482568&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c7a02990-89ad-4a76-9ad2-fcf541ff7d3c', 'multiverseId': 482568}, 'multiverseid': 482568}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482583&type=card', 'language': 'French', 'identifiers': {'scryfallId': '3b80b7d9-a242-4e49-ba24-02ac117b4c28', 'multiverseId': 482583}, 'multiverseid': 482583}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482598&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'd58c0a70-25fa-4d67-b65d-bb8758345bfc', 'multiverseId': 482598}, 'multiverseid': 482598}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482613&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'cd9cd59c-3caa-4ea7-89e2-9a3327dd77a7', 'multiverseId': 482613}, 'multiverseid': 482613}, {'name': '섬', 'type': '기본 대지 — 섬', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482628&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '0c0202d0-53bd-41f7-95b2-5c961079d1ce', 'multiverseId': 482628}, 'multiverseid': 482628}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482643&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1ac5bc89-29f8-4e20-a6d5-d766bdbcb3e4', 'multiverseId': 482643}, 'multiverseid': 482643}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482658&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '9b46a275-ad7c-4e73-abfa-f5ae3c4df554', 'multiverseId': 482658}, 'multiverseid': 482658}, {'name': '海岛', 'type': '基本地 ～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482673&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '8d8a23b7-e3cd-4230-89de-84b1092b430a', 'multiverseId': 482673}, 'multiverseid': 482673}, {'name': '海島', 'type': '基本地 ～海島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482688&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'cedd130c-3c63-4bd4-b15b-12a62924cdd5', 'multiverseId': 482688}, 'multiverseid': 482688}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482554&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'cc0abebf-dabb-4f5d-8db9-ad7e0557fe77', 'multiverseId': 482554}, 'multiverseid': 482554}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482569&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '6f895a5c-3351-4041-b719-db96652bfc5c', 'multiverseId': 482569}, 'multiverseid': 482569}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482584&type=card', 'language': 'French', 'identifiers': {'scryfallId': '406fb7e0-361c-4c1b-8c5f-ca77cdb17df6', 'multiverseId': 482584}, 'multiverseid': 482584}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482599&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'e2a04828-3642-422b-82e1-6fd15eac323c', 'multiverseId': 482599}, 'multiverseid': 482599}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482614&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '1072556d-e360-48a0-8fec-84a0efdb229a', 'multiverseId': 482614}, 'multiverseid': 482614}, {'name': '섬', 'type': '기본 대지 — 섬', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482629&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'c935a833-5f3b-4086-ba08-b8d91146db6c', 'multiverseId': 482629}, 'multiverseid': 482629}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482644&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5b513945-d9ba-401a-b7b2-42e698128a9b', 'multiverseId': 482644}, 'multiverseid': 482644}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482659&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'e92b8635-8465-418c-bb98-3af6613647fe', 'multiverseId': 482659}, 'multiverseid': 482659}, {'name': '海岛', 'type': '基本地 ～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482674&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '112a6851-6f0a-40e7-9583-70343b11d900', 'multiverseId': 482674}, 'multiverseid': 482674}, {'name': '海島', 'type': '基本地 ～海島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482689&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '143b8b2e-2ac3-44a6-a395-5255b0f3dede', 'multiverseId': 482689}, 'multiverseid': 482689}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482555&type=card', 'language': 'German', 'identifiers': {'scryfallId': '291a755c-7f0d-4709-818c-0e5309698e94', 'multiverseId': 482555}, 'multiverseid': 482555}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482570&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '043c07b8-cb02-4a1a-a27f-e6db2dd58ba2', 'multiverseId': 482570}, 'multiverseid': 482570}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482585&type=card', 'language': 'French', 'identifiers': {'scryfallId': '99467b4f-eb80-4b4b-b925-62e399c2ec2f', 'multiverseId': 482585}, 'multiverseid': 482585}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482600&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3d8a8d18-003f-4429-bd27-046d481f08b6', 'multiverseId': 482600}, 'multiverseid': 482600}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482615&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'b58d78b9-f131-44ec-8a2e-5c616cb77b1a', 'multiverseId': 482615}, 'multiverseid': 482615}, {'name': '섬', 'type': '기본 대지 — 섬', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482630&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '7b0224f7-bab2-468f-a08e-2efac5104758', 'multiverseId': 482630}, 'multiverseid': 482630}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482645&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '555b1883-e7d6-4b0b-b70c-5bc5110ddad0', 'multiverseId': 482645}, 'multiverseid': 482645}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482660&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '1308f809-85e3-4125-a96a-e8d2a66418d5', 'multiverseId': 482660}, 'multiverseid': 482660}, {'name': '海岛', 'type': '基本地 ～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482675&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '16b69688-7f19-401f-b50f-19c63db40536', 'multiverseId': 482675}, 'multiverseid': 482675}, {'name': '海島', 'type': '基本地 ～海島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482690&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '87614682-4341-4708-8471-d8cbc6a9d053', 'multiverseId': 482690}, 'multiverseid': 482690}]", '[{\'name\': \'Inspirierendes Ultimatum\', \'text\': \'Ein Spieler deiner Wahl erhält 5 Lebenspunkte dazu, das Inspirierende Ultimatum fügt einem Ziel deiner Wahl 5 Schadenspunkte zu und dann ziehst du fünf Karten.\', \'type\': \'Hexerei\', \'flavor\': \'„Innerer Frieden ist wunderbar und es lohnt sich, danach zu streben. Der äußere Frieden ist viel weniger wichtig."\\n—Taelya, Lavagrund-Feuermagierin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479970&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ff33c632-e5fa-4f5a-be9e-4da1fd85556d\', \'multiverseId\': 479970}, \'multiverseid\': 479970}, {\'name\': \'Ultimátum inspirado\', \'text\': \'El jugador objetivo gana 5 vidas, el Ultimátum inspirado hace 5 puntos de daño a cualquier objetivo y luego robas cinco cartas.\', \'type\': \'Conjuro\', \'flavor\': \'"La paz interior es maravillosa y merece la pena esforzarse por ella. La paz exterior es mucho menos importante".\\n—Taelya, piromaga de Bordelava\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480229&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ba489858-bcd0-47df-94b3-b2ac9ba54ebb\', \'multiverseId\': 480229}, \'multiverseid\': 480229}, {\'name\': \'Ultimatum inspiré\', \'text\': "Le joueur ciblé gagne 5 points de vie, l\'Ultimatum inspiré inflige 5 blessures à n\'importe quelle cible, puis vous piochez cinq cartes.", \'type\': \'Rituel\', \'flavor\': \'La paix intérieure est une chose merveilleuse à laquelle il faut aspirer. La paix extérieure est beaucoup moins importante. »\\n—Tælya, pyromage de Bourg-sur-Lave\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480488&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a88ff1e2-a042-41a8-ad73-cd448d0634c5\', \'multiverseId\': 480488}, \'multiverseid\': 480488}, {\'name\': \'Ultimatum Ispirato\', \'text\': "Un giocatore bersaglio guadagna 5 punti vita, l\'Ultimatum Ispirato infligge 5 danni a un qualsiasi bersaglio, poi peschi cinque carte.", \'type\': \'Stregoneria\', \'flavor\': \'"La pace interiore è meravigliosa e degna di essere perseguita. La pace esteriore è molto meno importante."\\n—Taelya, piromaga di Lavariva\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480747&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'babb39a8-6764-4a19-b075-5c441cc55b63\', \'multiverseId\': 480747}, \'multiverseid\': 480747}, {\'name\': \'見事な根本原理\', \'text\': \'プレイヤー１人と、クリーチャー１体かプレインズウォーカー１体かプレイヤー１人を対象とする。その前者のプレイヤーは５点のライフを得る。見事な根本原理はその後者に５点のダメージを与える。その後、あなたはカードを５枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'「内なる平和はすばらしい。追求するだけの価値がある。それに比べれば外部の平和など取るに足りない。」\\n――ラバブリンクの炎魔道士、テルヤ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481006&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4f544226-cbbc-45e6-b20e-9eb1be07ca9f\', \'multiverseId\': 481006}, \'multiverseid\': 481006}, {\'name\': \'고무적인 최후통첩\', \'text\': \'플레이어를 목표로 정하고 원하는 목표를 정한다. 첫 번째 목표는 생명 5점을 얻고, 고무적인 최후통첩은 두 번째 목표에게 피해 5점을 입힌 후, 당신은 카드 다섯 장을 뽑는다.\', \'type\': \'집중마법\', \'flavor\': \'"내면의 평화는 멋지고, 추구할 가치가 있지. 외면의 평화는 훨씬 덜 중요하고 말이야."\\n—용암가장자리 화염마도사, 타엘야\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481265&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'42a9f5af-287d-4dc2-82fa-32ba22fb1dd9\', \'multiverseId\': 481265}, \'multiverseid\': 481265}, {\'name\': \'Ultimato Inspirado\', \'text\': \'O jogador alvo ganha 5 pontos de vida, Ultimato Inspirado causa 5 pontos de dano a qualquer alvo e depois você compra cinco cards.\', \'type\': \'Feitiço\', \'flavor\': \'"A paz interior é maravilhosa, e vale a pena lutar por ela. A paz exterior é muito menos importante."\\n— Taelya, piromaga de Beiralava\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481524&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'af263fab-e57f-4d0f-bb2b-dc2cc22c1a7b\', \'multiverseId\': 481524}, \'multiverseid\': 481524}, {\'name\': \'Вдохновенный Ультиматум\', \'text\': \'Целевой игрок получает 5 жизней, Вдохновенный Ультиматум наносит 5 повреждений любой цели, затем вы берете пять карт.\', \'type\': \'Волшебство\', \'flavor\': \'«Внутренний покой — это чудесно, и к нему стоит стремиться. Внешний покой далеко не так важен».\\n— Тэлия, пиромаг из Лавобрега\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481783&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'716da095-85f0-48d5-8008-e0a2d9e454f4\', \'multiverseId\': 481783}, \'multiverseid\': 481783}, {\'name\': \'启迪通牒\', \'text\': \'目标牌手获得5点生命，启迪通牒对任意一个目标造成5点伤害，然后你抓五张牌。\', \'type\': \'法术\', \'flavor\': \'「内在的平静是理想状态，值得努力追求。外在的平静就没有那么重要。」\\n～熔缘城烈焰法师泰勒娅\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482042&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'15e0763d-fe06-42fa-bb03-45f111474076\', \'multiverseId\': 482042}, \'multiverseid\': 482042}, {\'name\': \'啟迪通牒\', \'text\': \'目標玩家獲得5點生命，啟迪通牒對任意一個目標造成5點傷害，然後你抽五張牌。\', \'type\': \'巫術\', \'flavor\': \'「內在的平靜是理想狀態，值得努力追求。外在的平靜就沒有那麼重要。」\\n～熔緣城烈焰法師泰勒婭\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482301&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ee501d5c-725c-4c2f-8c0a-002e3e79b574\', \'multiverseId\': 482301}, \'multiverseid\': 482301}]', '[{\'name\': \'Jagdanführer-Liger\', \'text\': \'Mutation {2}{W} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\nImmer wenn diese Kreatur mutiert, erhalten andere Kreaturen, die du kontrollierst, bis zum Ende des Zuges +X/+X, wobei X gleich der Anzahl an Mutationen dieser Kreatur ist.\', \'type\': \'Kreatur — Katze\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479795&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dea9c0a0-4fe7-4be6-a34f-db39e6e343a1\', \'multiverseId\': 479795}, \'multiverseid\': 479795}, {\'name\': \'Ligre maestro de la caza\', \'text\': \'Mutación {2}{W}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\nSiempre que esta criatura mute, las otras criaturas que controlas obtienen +X/+X hasta el final del turno, donde X es la cantidad de veces que esta criatura ha mutado.\', \'type\': \'Criatura — Felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480054&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'17dfdcbd-1201-48dc-9dd2-6fa3fca8064c\', \'multiverseId\': 480054}, \'multiverseid\': 480054}, {\'name\': \'Ligre maître-chasseur\', \'text\': "Mutation {2}{W} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\nÀ chaque fois que cette créature subit une mutation, les autres créatures que vous contrôlez gagnent +X/+X jusqu\'à la fin du tour, X étant le nombre de mutations subies par cette créature.", \'type\': \'Créature : chat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480313&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e3ab3fbe-88e8-4c97-a396-90d6fcd4ccc6\', \'multiverseId\': 480313}, \'multiverseid\': 480313}, {\'name\': \'Ligre Capocaccia\', \'text\': \'Mutazione {2}{W} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\nOgniqualvolta questa creatura muta, le altre creature che controlli prendono +X/+X fino alla fine del turno, dove X è il numero di volte che questa creatura è mutata.\', \'type\': \'Creatura — Felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480572&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ba3701b3-b3d6-4304-a769-ebd1d68f470f\', \'multiverseId\': 480572}, \'multiverseid\': 480572}, {\'name\': \'猟匠ライガー\', \'text\': \'変容{2}{W}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\nこのクリーチャーが変容するたび、ターン終了時まで、他の、あなたがコントロールしているクリーチャーは＋Ｘ/＋Ｘの修整を受ける。Ｘはこのクリーチャーが変容した回数に等しい。\', \'type\': \'クリーチャー — 猫\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480831&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'83786b2f-5964-441b-b3d4-bd06ebae7964\', \'multiverseId\': 480831}, \'multiverseid\': 480831}, {\'name\': \'사냥지휘관 라이거\', \'text\': \'돌연변이화 {2}{W} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n이 생물이 돌연변이화할 때마다, 당신이 조종하는 다른 생물들은 턴종료까지 +X/+X를 받는다. X는 이 생물이 돌연변이화한 수이다.\', \'type\': \'생물 — 고양이\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481090&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8811dc9e-72ca-428b-96c5-d218fa45a7dd\', \'multiverseId\': 481090}, \'multiverseid\': 481090}, {\'name\': \'Ligre Mestre de Caça\', \'text\': \'Mutação {2}{W} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\nToda vez que esta criatura sofre mutação, as outras criaturas que você controla recebem +X/+X até o final do turno, sendo X o número de mutações desta criatura.\', \'type\': \'Criatura — Felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481349&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'413ac105-2e26-4869-9467-4fbcbaa77f6a\', \'multiverseId\': 481349}, \'multiverseid\': 481349}, {\'name\': \'Ловчий Лигр\', \'text\': \'Мутация {2}{W} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\nКаждый раз, когда это существо мутирует, другие существа под вашим контролем получают +X/+X до конца хода, где Х — число мутаций этого существа.\', \'type\': \'Существо — Кошка\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481608&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'39039698-0a6c-4875-aba0-37f52ce117e5\', \'multiverseId\': 481608}, \'multiverseid\': 481608}, {\'name\': \'善猎狮虎\', \'text\': \'合变{2}{W}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n每当此生物合变时，由你操控的其他生物得+X/+X直到回合结束，X为此生物已合变的次数。\', \'type\': \'生物 ～猫\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481867&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fbbd95d6-c66f-47d3-a42b-e740aad1b4ed\', \'multiverseId\': 481867}, \'multiverseid\': 481867}, {\'name\': \'善獵獅虎\', \'text\': \'合變{2}{W}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n每當此生物合變時，由你操控的其他生物得+X/+X直到回合結束，X為此生物已合變的次數。\', \'type\': \'生物 ～貓\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482126&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'168b2714-86ed-406e-8ac5-d3ab31ab6edd\', \'multiverseId\': 482126}, \'multiverseid\': 482126}]', '[{\'name\': \'Jagdanführer-Liger\', \'text\': \'Mutation {2}{W}\\nImmer wenn diese Kreatur mutiert, erhalten andere Kreaturen, die du kontrollierst, bis zum Ende des Zuges +X/+X, wobei X gleich der Anzahl an Mutationen dieser Kreatur ist.\', \'type\': \'Kreatur — Katze\', \'flavor\': \'King Caesar, uralter Wächter\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482384&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0013fe35-d1a2-4adb-8765-5d99c4df5952\', \'multiverseId\': 482384}, \'multiverseid\': 482384}, {\'name\': \'Ligre maestro de la caza\', \'text\': \'Mutación {2}{W}.\\nSiempre que esta criatura mute, las otras criaturas que controlas obtienen +X/+X hasta el final del turno, donde X es la cantidad de veces que esta criatura ha mutado.\', \'type\': \'Criatura — Felino\', \'flavor\': \'King Caesar, guardián antiguo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482398&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1b6a0496-db56-45f7-b82d-6382706b26f8\', \'multiverseId\': 482398}, \'multiverseid\': 482398}, {\'name\': \'Ligre maître-chasseur\', \'text\': "Mutation {2}{W}\\nÀ chaque fois que cette créature subit une mutation, les autres créatures que vous contrôlez gagnent +X/+X jusqu\'à la fin du tour, X étant le nombre de mutations subies par cette créature.", \'type\': \'Créature : chat\', \'flavor\': \'King César, gardien ancestral\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482412&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'21d1a4fb-42a8-427e-a5a3-9c7376c4996f\', \'multiverseId\': 482412}, \'multiverseid\': 482412}, {\'name\': \'Ligre Capocaccia\', \'text\': \'Mutazione {2}{W}\\nOgniqualvolta questa creatura muta, le altre creature che controlli prendono +X/+X fino alla fine del turno, dove X è il numero di volte che questa creatura è mutata.\', \'type\': \'Creatura — Felino\', \'flavor\': \'King Caesar, Antico Guardiano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482426&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ad8d1dbd-47d4-46e5-b396-4da2d78996a7\', \'multiverseId\': 482426}, \'multiverseid\': 482426}, {\'name\': \'猟匠ライガー\', \'text\': \'変容{2}{W}\\nこのクリーチャーが変容するたび、ターン終了時まで、他の、あなたがコントロールしているクリーチャーは＋Ｘ/＋Ｘの修整を受ける。Ｘはこのクリーチャーが変容した総回数に等しい。\', \'type\': \'クリーチャー — 猫\', \'flavor\': \'古（こ）代（だい）の守（しゅ）護（ご）神（しん）、キングシーサー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482440&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'19f6537d-eb30-4a9a-8b26-f60b86fd7308\', \'multiverseId\': 482440}, \'multiverseid\': 482440}, {\'name\': \'사냥지휘관 라이거\', \'text\': \'돌연변이화 {2}{W}\\n이 생물이 돌연변이화할 때마다, 당신이 조종하는 다른 생물들은 턴종료까지 +X/+X를 받는다. X는 이 생물이 돌연변이화한 수이다.\', \'type\': \'생물 — 고양이\', \'flavor\': \'고대의 수호자, 킹 카이사르\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482454&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'25aac50c-64ae-4516-bca0-cdc9c902f820\', \'multiverseId\': 482454}, \'multiverseid\': 482454}, {\'name\': \'Ligre Mestre de Caça\', \'text\': \'Mutação {2}{W}\\nToda vez que esta criatura sofre mutação, as outras criaturas que você controla recebem +X/+X até o final do turno, sendo X o número de mutações desta criatura.\', \'type\': \'Criatura — Felino\', \'flavor\': \'King Caesar, Guardião Antigo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482468&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d43f54a3-d4e0-482e-8a07-d41cde85ee67\', \'multiverseId\': 482468}, \'multiverseid\': 482468}, {\'name\': \'Ловчий Лигр\', \'text\': \'Мутация {2}{W}\\nКаждый раз, когда это существо мутирует, другие существа под вашим контролем получают +X/+X до конца хода, где Х — число мутаций этого существа.\', \'type\': \'Существо — Кошка\', \'flavor\': \'Кинг Сизар, Древний Страж\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482482&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9699e3d7-23ba-45ed-ac98-5a14184c626b\', \'multiverseId\': 482482}, \'multiverseid\': 482482}, {\'name\': \'善猎狮虎\', \'text\': \'合变{2}{W}\\n每当此生物合变时，由你操控的其他生物得+X/+X直到回合结束，X为此生物已合变的次数。\', \'type\': \'生物 ～猫\', \'flavor\': \'远古守护神西萨王\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482496&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'708d86e4-52b9-4ef7-a73a-34dde550bedb\', \'multiverseId\': 482496}, \'multiverseid\': 482496}, {\'name\': \'善獵獅虎\', \'text\': \'合變{2}{W}\\n每當此生物合變時，由你操控的其他生物得+X/+X直到回合結束，X為此生物已合變的次數。\', \'type\': \'生物 ～貓\', \'flavor\': \'遠古守護神西薩王\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482510&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2c19e413-7971-468b-b644-09478b0f5c3d\', \'multiverseId\': 482510}, \'multiverseid\': 482510}]', '[{\'name\': \'Jauchzende Himmelsbynderin\', \'text\': \'Fliegend\\nFliegende Kreaturen, die du kontrollierst, haben „Zaubersprüche, die deine Gegner wirken und die diese Kreatur als Ziel haben, kosten beim Wirken {2} mehr."\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'Sie wurde geboren und konnte nicht laufen. *Eludha* verhalf ihr zum Fliegen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480002&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bd525a75-91cb-4d04-b77b-ab89733e0e66\', \'multiverseId\': 480002}, \'multiverseid\': 480002}, {\'name\': \'Vinculacielos exultante\', \'text\': \'Vuela.\\nLas criaturas que controlas con la habilidad de volar tienen "A tus oponentes les cuesta {2} más lanzar hechizos que hagan objetivo a esta criatura".\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'Jamás pudo andar. Pero gracias a la *eludha*, fue capaz de volar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480261&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5e6a1b77-5801-4b5f-ad41-4f8d93f7c3fe\', \'multiverseId\': 480261}, \'multiverseid\': 480261}, {\'name\': \'Brideciel allègre\', \'text\': \'Vol\\nLes créatures avec le vol que vous contrôlez ont « Les sorts que vos adversaires lancent qui ciblent cette créature coûtent {2} de plus à lancer. »\', \'type\': \'Créature : humain et sorcier\', \'flavor\': "Elle est née sans espoir de marcher un jour. Grâce à l\'*éludha*, elle peut voler.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480520&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d4e50117-4be0-4516-b0b8-21c5d4462f4a\', \'multiverseId\': 480520}, \'multiverseid\': 480520}, {\'name\': \'Vincolacieli Esultante\', \'text\': \'Volare\\nLe creature con volare che controlli hanno "Le magie che i tuoi avversari lanciano e che bersagliano questa creatura costano {2} in più per essere lanciate".\', \'type\': \'Creatura — Mago Umano\', \'flavor\': "È nata incapace di camminare. Grazie all\'*eludha*, è stata capace di volare.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480779&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0e74462e-c7e1-46ac-9daa-ab002882c473\', \'multiverseId\': 480779}, \'multiverseid\': 480779}, {\'name\': \'歓喜する空眷者\', \'text\': \'飛行\\nあなたがコントロールしていて飛行を持つクリーチャーは「対戦相手がこのクリーチャーを対象として唱える呪文のコストは{2}多くなる。」を持つ。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'彼女は生まれつき歩けなかったが、*エルーダ*を通じて飛べるようになった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481038&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5907867a-8509-4fa7-b009-693441b0a162\', \'multiverseId\': 481038}, \'multiverseid\': 481038}, {\'name\': \'기쁨에 찬 창공유대자\', \'text\': \'비행\\n당신이 조종하는 비행을 가진 생물들은 "당신의 상대들이 이 생물을 목표로 발동하는 주문들은 발동하는 데 {2}가 더 든다."를 가진다.\', \'type\': \'생물 — 인간 마법사\', \'flavor\': \'그녀는 태어날 때부터 걸을 수 없었다. *엘루다*를 통해, 그녀는 날 수 있었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481297&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'82ce416c-90d9-4819-9f93-1e04623ea603\', \'multiverseId\': 481297}, \'multiverseid\': 481297}, {\'name\': \'Vinculadora dos Céus Jubilante\', \'text\': \'Voar\\nAs criaturas que você controla com voar têm "As mágicas que seus oponentes conjuram tendo como alvo esta criatura custam {2} a mais para serem conjuradas."\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'Ela nasceu incapaz de andar. Por meio da *eludha*, ela foi capaz de voar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481556&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'434e2a49-a7bf-4b23-8caf-e6b77f9afb81\', \'multiverseId\': 481556}, \'multiverseid\': 481556}, {\'name\': \'Ликующая Узомантка Небес\', \'text\': \'Полет\\nСущества с Полетом под вашим контролем имеют способность «Разыгрывание вашими оппонентами заклинаний, целью которых является это существо, стоит на {2} больше».\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'С рождения она не могла ходить. С *элудхой* она полетела.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481815&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'907ddb56-59e5-4549-b609-7e2ed88e43ca\', \'multiverseId\': 481815}, \'multiverseid\': 481815}, {\'name\': \'欢腾翔绊人\', \'text\': \'飞行\\n由你操控且具飞行异能的生物具有「对手施放且以此生物为目标的咒语增加{2}来施放。」\', \'type\': \'生物 ～人类／法术师\', \'flavor\': \'她生来便不能行走大地。但拜*灵绊*所赐，她能够翱翔天空。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482074&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'54ac323e-970c-4208-aff0-7c306c410806\', \'multiverseId\': 482074}, \'multiverseid\': 482074}, {\'name\': \'歡騰翔絆人\', \'text\': \'飛行\\n由你操控且具飛行異能的生物具有「對手施放且以此生物為目標的咒語增加{2}來施放。」\', \'type\': \'生物 ～人類／魔法師\', \'flavor\': \'她生來便不能行走大地。但拜*靈絆*所賜，她能夠翱翔天空。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482333&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'758e286f-1ecb-4a9d-a021-4dbc07a8d2b4\', \'multiverseId\': 482333}, \'multiverseid\': 482333}]', '[{\'name\': \'Jegantha der Urquell\', \'text\': \'Gefährte — Keine Karte in deinem Startdeck hat dasselbe Manasymbol mehr als einmal in ihren Manakosten. (Falls du diese Karte als deinen Gefährten erwählt hast, kannst du sie einmal von außerhalb der Partie wirken.)\\n{T}: Erzeuge {W}{U}{B}{R}{G}. Dieses Mana kann nicht verwendet werden, um generische Manakosten zu bezahlen.\', \'type\': \'Legendäre Kreatur — Elementarwesen, Hirsch\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480001&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d4ce06ec-9278-486d-b0c2-972dfc238ad0\', \'multiverseId\': 480001}, \'multiverseid\': 480001}, {\'name\': \'Jegantha, Fuente de Maná\', \'text\': \'Compañero — Ninguna carta en tu mazo inicial tiene más de un mismo símbolo de maná en su coste de maná. (Si esta carta es el compañero que eliges, puedes lanzarla una vez desde fuera del juego.)\\n{T}: Agrega {W}{U}{B}{R}{G}. Este maná no se puede usar para pagar costes de maná genérico.\', \'type\': \'Criatura legendaria — Alce elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480260&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'576ed01a-5453-4799-b8b3-ca9414aacb31\', \'multiverseId\': 480260}, \'multiverseid\': 480260}, {\'name\': \'Jegantha, la Source\', \'text\': "Compagnon — Aucune carte de votre deck de départ n\'a plus d\'un même symbole de mana dans son coût de mana. (Si cette carte est le compagnon de votre choix, vous pouvez la lancer une fois depuis l\'extérieur de la partie.)\\n{T} : Ajoutez {W}{U}{B}{R}{G}. Ce mana ne peut pas être utilisé pour payer des coûts de mana génériques.", \'type\': \'Créature légendaire : élémental et élan\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480519&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0130ecc8-572f-4e22-842f-a3974d2fcd0f\', \'multiverseId\': 480519}, \'multiverseid\': 480519}, {\'name\': \'Jegantha, la Sorgente\', \'text\': \'Compagno — Nessuna carta nel tuo mazzo iniziale ha più di un simbolo di mana uguale nel suo costo di mana. (Se questa carta è il compagno che hai scelto, puoi lanciarla una volta dal di fuori della partita.)\\n{T}: Aggiungi {W}{U}{B}{R}{G}. Questo mana non può essere speso per pagare costi di mana generico.\', \'type\': \'Creatura Leggendaria — Alce Elementale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480778&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'43a56a17-8705-4cf4-86b9-5d74fc87292a\', \'multiverseId\': 480778}, \'multiverseid\': 480778}, {\'name\': \'湧き出る源、ジェガンサ\', \'text\': \'相棒 ― あなたの開始時のデッキに、マナ・コストに同じマナ・シンボルを２つ以上含むカードが入っていないこと。（このカードがあなたの選んだ相棒であるなら、あなたは１回のみゲームの外部からこれを唱えてもよい。）\\n{T}：{W}{U}{B}{R}{G}を加える。このマナは、不特定マナのコストを支払うために使用することはできない。\', \'type\': \'伝説のクリーチャー — エレメンタル・大鹿\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481037&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4e7c8bf4-5e73-41d4-bc73-55c8723b067a\', \'multiverseId\': 481037}, \'multiverseid\': 481037}, {\'name\': \'원천, 제간타\', \'text\': \'단짝 — 당신의 시작 덱에 들어 있는 카드들에는 마나 비용에 같은 마나 기호가 두 번 나타나지 않는다. (이 카드가 당신이 선택한 단짝이라면, 당신은 이 카드를 게임 밖에서 한 번 발동할 수 있다.)\\n{T}: {W}{U}{B}{R}{G}를 추가한다. 이 마나는 일반 마나를 지불하기 위해 사용할 수 없다.\', \'type\': \'전설적 생물 — 정령 엘크\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481296&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4ede3fd9-f353-4428-8865-06e2559837fc\', \'multiverseId\': 481296}, \'multiverseid\': 481296}, {\'name\': \'Jegantha, a Fonte\', \'text\': \'Companheiro — Nenhum card em seu deck inicial tem mais de um de cada símbolo de mana no custo de mana. (Se este card for o companheiro que escolheu, você poderá conjurá-lo uma vez de fora do jogo.)\\n{T}: Adicione {W}{U}{B}{R}{G}. Este mana não pode ser gasto para pagar custos de mana genéricos.\', \'type\': \'Criatura Lendária — Elemental Alce\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481555&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c8d13a40-70ae-424e-8eae-2007c5d4c77b\', \'multiverseId\': 481555}, \'multiverseid\': 481555}, {\'name\': \'Джеганта, Источник\', \'text\': \'Компаньон — Ни у одной карты в вашей начальной колоде нет в мана-стоимости двух или более одинаковых символов маны. (Если эта карта является вашим избранным Компаньоном, то вы можете один раз разыграть ее из-за пределов игры.)\\n{T}: добавьте {W}{U}{B}{R}{G}. Эту ману нельзя тратить на оплату стоимости в немаркированной мане.\', \'type\': \'Легендарное Существо — Элементаль Вапити\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481814&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b887df2d-dcbf-41e5-8196-edfbc37a4147\', \'multiverseId\': 481814}, \'multiverseid\': 481814}, {\'name\': \'丰饶泉源杰甘沙\', \'text\': \'行侣～你起始套牌中各牌之法术力费用内相同的法术力符号数量不得多于一个。（如果你选择这张牌作为你的行侣，则你可以从游戏外施放它，但仅限一次。）\\n{T}：加{W}{U}{B}{R}{G}。此法术力不能用于支付一般法术力费用。\', \'type\': \'传奇生物 ～元素／麋鹿\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482073&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'39fdc2aa-6f2a-4c48-b641-d811d72e861b\', \'multiverseId\': 482073}, \'multiverseid\': 482073}, {\'name\': \'豐饒泉源傑甘沙\', \'text\': \'行侶～你起始套牌中各牌之魔法力費用內相同的魔法力符號數量不得多於一個。（如果你選擇這張牌作為你的行侶，則你可以從遊戲外施放它，但僅限一次。）\\n{T}：加{W}{U}{B}{R}{G}。此魔法力不能用於支付一般魔法力費用。\', \'type\': \'傳奇生物 ～元素／麋鹿\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482332&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c778688e-d0de-41e2-80e3-172e04a1d955\', \'multiverseId\': 482332}, \'multiverseid\': 482332}]', '[{\'name\': \'Jungtierhüter\', \'text\': \'Mutation {2}{W}{W} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\nLebensverknüpfung\\nImmer wenn diese Kreatur mutiert, erzeuge zwei 1/1 weiße Katze-Kreaturenspielsteine mit Lebensverknüpfung.\', \'type\': \'Kreatur — Katze\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479786&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'aaa3767b-43a2-4e52-a330-a177a17ff450\', \'multiverseId\': 479786}, \'multiverseid\': 479786}, {\'name\': \'Protegecachorros\', \'text\': \'Mutación {2}{W}{W}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\nVínculo vital.\\nSiempre que esta criatura mute, crea dos fichas de criatura Felino blancas 1/1 con la habilidad de vínculo vital.\', \'type\': \'Criatura — Felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480045&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'af527c1b-4a91-4f3b-ac7e-c0868dd62e38\', \'multiverseId\': 480045}, \'multiverseid\': 480045}, {\'name\': \'Nourrice\', \'text\': "Mutation {2}{W}{W} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\nLien de vie\\nÀ chaque fois que cette créature subit une mutation, créez deux jetons de créature 1/1 blanche Chat avec le lien de vie.", \'type\': \'Créature : chat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480304&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'69651d0a-dd12-4c38-a0dd-6951bc812b4c\', \'multiverseId\': 480304}, \'multiverseid\': 480304}, {\'name\': \'Custode dei Cuccioli\', \'text\': \'Mutazione {2}{W}{W} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\nLegame vitale\\nOgniqualvolta questa creatura muta, crea due pedine creatura Felino 1/1 bianche con legame vitale.\', \'type\': \'Creatura — Felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480563&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8d05f65e-70d0-4453-965e-585ae3150cbb\', \'multiverseId\': 480563}, \'multiverseid\': 480563}, {\'name\': \'幼獣守り\', \'text\': \'変容{2}{W}{W}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\n絆魂\\nこのクリーチャーが変容するたび、絆魂を持つ白の１/１の猫・クリーチャー・トークンを２体生成する。\', \'type\': \'クリーチャー — 猫\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480822&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8d5c1ae7-cd1f-4a96-b024-890f068822bb\', \'multiverseId\': 480822}, \'multiverseid\': 480822}, {\'name\': \'새끼보호자\', \'text\': \'돌연변이화 {2}{W}{W} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n생명연결\\n이 생물이 돌연변이화할 때마다, 생명연결을 가진 1/1 백색 고양이 생물 토큰 두 개를 만든다.\', \'type\': \'생물 — 고양이\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481081&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'991911c1-01f1-4e04-bb1a-ed2b767aef81\', \'multiverseId\': 481081}, \'multiverseid\': 481081}, {\'name\': \'Guarda-filhotes\', \'text\': \'Mutação {2}{W}{W} (Se você conjurar esta mágica pelo seu custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\nVínculo com a vida\\nToda vez que esta criatura sofrer mutação, crie duas fichas de criatura branca 1/1 do tipo Felino com vínculo com a vida.\', \'type\': \'Criatura — Felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481340&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'45098657-bf70-4701-a15e-112c0de1927a\', \'multiverseId\': 481340}, \'multiverseid\': 481340}, {\'name\': \'Защитница Выводка\', \'text\': \'Мутация {2}{W}{W} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\nЦепь жизни\\nКаждый раз, когда это существо мутирует, создайте две фишки существа 1/1 белая Кошка с Цепью жизни.\', \'type\': \'Существо — Кошка\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481599&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'16342afd-8fd9-4ec0-947a-2d734049ee92\', \'multiverseId\': 481599}, \'multiverseid\': 481599}, {\'name\': \'护崽慈狮\', \'text\': \'合变{2}{W}{W}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n系命\\n每当此生物合变时，派出两个1/1白色，具系命异能的猫衍生生物。\', \'type\': \'生物 ～猫\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481858&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b9637aea-8045-4668-bb38-5aa0be352405\', \'multiverseId\': 481858}, \'multiverseid\': 481858}, {\'name\': \'護崽慈獅\', \'text\': \'合變{2}{W}{W}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n繫命\\n每當此生物合變時，派出兩個1/1白色，具繫命異能的貓衍生生物。\', \'type\': \'生物 ～貓\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482117&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'abd6ab86-228c-420b-a9a3-136b356c55c7\', \'multiverseId\': 482117}, \'multiverseid\': 482117}]', '[{\'name\': \'Kaheera, Behüter der Verlassenen\', \'text\': \'Gefährte — Jede Kreaturenkarte in deinem Startdeck ist eine Katze-, Elementarwesen-, Nachtmahr-, Dinosaurier- oder Bestie-Karte. (Falls du diese Karte als deinen Gefährten erwählt hast, kannst du sie einmal von außerhalb der Partie wirken.)\\nWachsamkeit\\nJede andere Kreatur, die du kontrollierst, die eine Katze, ein Elementarwesen, ein Nachtmahr, ein Dinosaurier oder eine Bestie ist, erhält +1/+1 und hat Wachsamkeit.\', \'type\': \'Legendäre Kreatur — Katze, Bestie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480003&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'57a761a3-535e-4eb6-9c44-402513ed63c2\', \'multiverseId\': 480003}, \'multiverseid\': 480003}, {\'name\': \'Kaheera, Custodiahuérfanos\', \'text\': \'Compañero — Cada carta de criatura en tu mazo inicial es una carta de Felino, Elemental, Pesadilla, Dinosaurio o Bestia. (Si esta carta es el compañero que eliges, puedes lanzarla una vez desde fuera del juego.)\\nVigilancia.\\nCada otra criatura que controlas que sea Felino, Elemental, Pesadilla, Dinosaurio o Bestia obtiene +1/+1 y tiene la habilidad de vigilancia.\', \'type\': \'Criatura legendaria — Bestia felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480262&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c5e67e69-2e91-4d18-a970-a1b3555608dc\', \'multiverseId\': 480262}, \'multiverseid\': 480262}, {\'name\': \'Kaheera, le Tuteur\', \'text\': "Compagnon — Chaque carte de créature de votre deck de départ est une carte de chat, d\'élémental, de cauchemar, de dinosaure ou de bête. (Si cette carte est le compagnon de votre choix, vous pouvez la lancer une fois depuis l\'extérieur de la partie.)\\nVigilance\\nChaque autre créature que vous contrôlez qui est un chat, un élémental, un cauchemar, un dinosaure ou une bête gagne +1/+1 et a la vigilance.", \'type\': \'Créature légendaire : chat et bête\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480521&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7783e92f-91be-43a5-8eb8-1974ed79e4ae\', \'multiverseId\': 480521}, \'multiverseid\': 480521}, {\'name\': \'Kaheera, la Guardaorfani\', \'text\': \'Compagno — Ogni carta creatura nel tuo mazzo iniziale è una carta Felino, Elementale, Incubo, Dinosauro o Bestia. (Se questa carta è il compagno che hai scelto, puoi lanciarla una volta dal di fuori della partita.)\\nCautela\\nOgni altra creatura che controlli che è Felino, Elementale, Incubo, Dinosauro o Bestia prende +1/+1 e ha cautela.\', \'type\': \'Creatura Leggendaria — Bestia Felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480780&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e92a315c-c6ae-4f40-86d4-8432c2c363cb\', \'multiverseId\': 480780}, \'multiverseid\': 480780}, {\'name\': \'孤児護り、カヒーラ\', \'text\': \'相棒 ― あなたの開始時のデッキに入っている各クリーチャー・カードが、それぞれ猫かエレメンタルやナイトメアや恐竜やビーストであるカードであること。（このカードがあなたの選んだ相棒であるなら、あなたは１回のみゲームの外部からこれを唱えてもよい。）\\n警戒\\n他の、あなたがコントロールしていて猫やエレメンタルやナイトメアや恐竜やビーストである各クリーチャーは、それぞれ＋１/＋１の修整を受け警戒を持つ。\', \'type\': \'伝説のクリーチャー — 猫・ビースト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481039&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0a7f60f5-7c38-4262-b415-4854da4c151d\', \'multiverseId\': 481039}, \'multiverseid\': 481039}, {\'name\': \'고아수호자, 카히라\', \'text\': \'단짝 — 당신의 시작 덱에 들어 있는 각 생물 카드는 고양이, 정령, 나이트메어, 공룡, 또는 야수 카드이다. (이 카드가 당신이 선택한 단짝이라면, 당신은 이 카드를 게임 밖에서 한 번 발동할 수 있다.)\\n경계\\n당신이 조종하는 다른 생물들 중 고양이, 정령, 나이트메어, 공룡, 또는 야수인 생물들은 +1/+1을 받고 경계를 가진다.\', \'type\': \'전설적 생물 — 고양이 야수\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481298&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0dfb0804-a072-468f-b3e3-2d64ff53f465\', \'multiverseId\': 481298}, \'multiverseid\': 481298}, {\'name\': \'Kaheera, a Guardiã dos Órfãos\', \'text\': \'Companheiro — Cada card de criatura em seu deck inicial é um card de Felino, Elemental, Pesadelo, Dinossauro ou Besta. (Se este card for o companheiro que escolheu, você poderá conjurá-lo uma vez de fora do jogo.)\\nVigilância\\nCada outra criatura que você controla que seja um Felino, Elemental, Pesadelo, Dinossauro ou Besta recebe +1/+1 e tem vigilância.\', \'type\': \'Criatura Lendária — Felino Besta\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481557&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'03c29a59-19a9-4654-907b-84565adeb77b\', \'multiverseId\': 481557}, \'multiverseid\': 481557}, {\'name\': \'Кахира, Попечительница\', \'text\': \'Компаньон — Каждая карта существа в вашей начальной колоде является картой Кошки, Элементаля, Кошмара, Динозавра или Зверя. (Если эта карта является вашим избранным Компаньоном, то вы можете один раз разыграть ее из-за пределов игры.)\\nБдительность\\nКаждое другое существо под вашим контролем, которое является Кошкой, Элементалем, Кошмаром, Динозавром или Зверем, получает +1/+1 и имеет Бдительность.\', \'type\': \'Легендарное Существо — Кошка Зверь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481816&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ef264379-c223-4c5e-83ab-9a9ecaee4312\', \'multiverseId\': 481816}, \'multiverseid\': 481816}, {\'name\': \'孤兽守卫卡席拉\', \'text\': \'行侣～你起始套牌中各生物牌均为猫、元素、梦魇、恐龙或野兽牌。（如果你选择这张牌作为你的行侣，则你可以从游戏外施放它，但仅限一次。）\\n警戒\\n由你操控且为猫、元素、梦魇、恐龙或野兽的其他生物得+1/+1且具有警戒异能。\', \'type\': \'传奇生物 ～猫／野兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482075&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'391fbe06-d5c7-473f-ad7b-746faa2493b5\', \'multiverseId\': 482075}, \'multiverseid\': 482075}, {\'name\': \'孤獸守衛卡席拉\', \'text\': \'行侶～你起始套牌中各生物牌均為貓、元素、夢魘、恐龍或野獸牌。（如果你選擇這張牌作為你的行侶，則你可以從遊戲外施放它，但僅限一次。）\\n警戒\\n由你操控且為貓、元素、夢魘、恐龍或野獸的其他生物得+1/+1且具有警戒異能。\', \'type\': \'傳奇生物 ～貓／野獸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482334&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ecfce367-6204-41dc-bd6d-f20437ab649e\', \'multiverseId\': 482334}, \'multiverseid\': 482334}]', '[{\'name\': \'Kanalisierte Macht\', \'text\': \'Wirf als zusätzliche Kosten, um diesen Zauberspruch zu wirken, X Karten ab.\\nEin Spieler deiner Wahl zieht X Karten. Die Kanalisierte Macht fügt bis zu einer Kreatur oder einem Planeswalker deiner Wahl X Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'Nur wenige Monster wagten den Kampf mit Narset, nachdem sie ihre Macht gespürt hatten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479959&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cb851f97-2d74-44eb-bf56-511b4b26c641\', \'multiverseId\': 479959}, \'multiverseid\': 479959}, {\'name\': \'Fuerza canalizada\', \'text\': \'Como coste adicional para lanzar este hechizo, descarta X cartas.\\nEl jugador objetivo roba X cartas. La Fuerza canalizada hace X puntos de daño a hasta una criatura o planeswalker objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'Pocos monstruos desafiaban a Narset tras percibir su poder.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480218&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5500d558-7010-4b61-9de1-f1402c3d66db\', \'multiverseId\': 480218}, \'multiverseid\': 480218}, {\'name\': \'Force canalisée\', \'text\': "En tant que coût supplémentaire pour lancer ce sort, défaussez-vous de X cartes.\\nLe joueur ciblé pioche X cartes. La Force canalisée inflige X blessures à jusqu\'à une cible, créature ou planeswalker.", \'type\': \'Éphémère\', \'flavor\': "Après avoir senti sa puissance, peu de monstres tentèrent d\'affronter Narset.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480477&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3221e092-f6da-4510-9f8b-0d203fa51084\', \'multiverseId\': 480477}, \'multiverseid\': 480477}, {\'name\': \'Forza Incanalata\', \'text\': \'Come costo addizionale per lanciare questa magia, scarta X carte.\\nUn giocatore bersaglio pesca X carte. La Forza Incanalata infligge X danni a fino a una creatura o un planeswalker bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'Pochi mostri osavano sfidare Narset dopo averne percepito il potere.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480736&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5290d09b-e624-4571-81fe-624d0c849b37\', \'multiverseId\': 480736}, \'multiverseid\': 480736}, {\'name\': \'交感の力\', \'text\': \'この呪文を唱えるための追加コストとして、カードＸ枚を捨てる。\\nプレイヤー１人と、クリーチャーやプレインズウォーカー合わせて最大１体を対象とする。その前者のプレイヤーはカードをＸ枚引く。交感の力はその後者にＸ点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'その力を感じ取ってからは、ナーセットに挑もうとする怪物はほとんどいなかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480995&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c3d3cd1d-3032-4c11-aaa1-ec83f314af4c\', \'multiverseId\': 480995}, \'multiverseid\': 480995}, {\'name\': \'전달되는 힘\', \'text\': \'이 주문을 발동하기 위한 추가비용으로, 카드 X장을 버린다.\\n플레이어를 목표로 정한다. 그 플레이어는 카드 X장을 뽑는다. 생물 또는 플레인즈워커를 최대 한 개까지 목표로 정한다. 전달되는 힘은 그 목표에게 피해 X점을 입힌다.\', \'type\': \'순간마법\', \'flavor\': \'몇몇 괴수들은 나르셋의 힘을 감지한 뒤에 그녀에게 도전했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481254&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0744ca65-0750-41f9-9c54-8f0065f63cac\', \'multiverseId\': 481254}, \'multiverseid\': 481254}, {\'name\': \'Força Canalizada\', \'text\': \'Como custo adicional para conjurar esta mágica, descarte X cards.\\nO jogador alvo compra X cards. Força Canalizada causa X pontos de dano a até uma criatura ou planeswalker alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Poucos monstros desafiaram Narset depois de sentir o poder dela.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481513&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'38cbfe99-7a0c-4c60-a732-98cd16936785\', \'multiverseId\': 481513}, \'multiverseid\': 481513}, {\'name\': \'Направленная Сила\', \'text\': "В качестве дополнительной стоимости разыгрывания этого заклинания сбросьте X карт.\\nЦелевой игрок берет X карт. Направленная Сила наносит X повреждений не более чем одному целевому существу или planeswalker\'у.", \'type\': \'Мгновенное заклинание\', \'flavor\': \'Не многие чудовища осмеливались бросить вызов Нарсет, почувствовав ее силу.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481772&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3359974e-4bd0-4775-951f-c7f4f4441e59\', \'multiverseId\': 481772}, \'multiverseid\': 481772}, {\'name\': \'通贯魔力\', \'text\': \'弃X张牌，以作为施放此咒语的额外费用。\\n目标牌手抓X张牌。通贯魔力对至多一个目标生物或鹏洛客造成X点伤害。\', \'type\': \'瞬间\', \'flavor\': \'在怪兽感知娜尔施的力量后，胆敢挑战者所剩无几。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482031&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'067c6ad4-1a47-4951-876a-9c4a66dd6d8c\', \'multiverseId\': 482031}, \'multiverseid\': 482031}, {\'name\': \'通貫魔力\', \'text\': \'棄X張牌，以作為施放此咒語的額外費用。\\n目標玩家抽X張牌。通貫魔力對至多一個目標生物或鵬洛客造成X點傷害。\', \'type\': \'瞬間\', \'flavor\': \'在怪獸感知娜爾施的力量後，膽敢挑戰者所剩無幾。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482290&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9b5e60ae-ecb3-4a9e-8d81-27dc67284f5e\', \'multiverseId\': 482290}, \'multiverseid\': 482290}]', '[{\'name\': \'Kaulquappensymbiont\', \'text\': \'Jeder Kreaturenzauber, den du wirkst, kostet beim Wirken {1} weniger, falls er Mutation hat.\\nImmer wenn du einen Kreaturenzauber wirkst und falls er Mutation hat, ziehe eine Karte und wirf dann eine Karte ab.\', \'type\': \'Kreatur — Frosch\', \'flavor\': \'Babygodzilla, geborenes Verhängnis\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482386&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4a4bb575-543d-4bcb-b78b-8fe264c5fc6b\', \'multiverseId\': 482386}, \'multiverseid\': 482386}, {\'name\': \'Renacuajo simbiótico\', \'text\': \'Te cuesta {1} menos lanzar cada hechizo de criatura si tiene la habilidad de mutación.\\nSiempre que lances un hechizo de criatura, si tiene la habilidad de mutación, roba una carta y descarta una carta.\', \'type\': \'Criatura — Rana\', \'flavor\': \'Babygodzilla, ruina renacida\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482400&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c6680e39-d3fc-47e5-8b80-24a8d1aedd45\', \'multiverseId\': 482400}, \'multiverseid\': 482400}, {\'name\': \'Symbiote têtard\', \'text\': "Chaque sort de créature que vous lancez coûte {1} de moins à lancer s\'il a la mutation.\\nÀ chaque fois que vous lancez un sort de créature, s\'il a la mutation, piochez une carte, puis défaussez-vous d\'une carte.", \'type\': \'Créature : grenouille\', \'flavor\': \'Babygodzilla, destruction renaissante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482414&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'712e5072-558d-4b0c-a1b9-bd416ed7b6d8\', \'multiverseId\': 482414}, \'multiverseid\': 482414}, {\'name\': \'Simbionte Girino\', \'text\': \'Ogni magia creatura che lanci costa {1} in meno per essere lanciata se ha mutazione.\\nOgniqualvolta lanci una magia creatura, se ha mutazione, pesca una carta, poi scarta una carta.\', \'type\': \'Creatura — Rana\', \'flavor\': \'Babygodzilla, Rovina Rinata\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482428&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c74cf5ec-e1a7-4f17-8901-83a80d7d9a27\', \'multiverseId\': 482428}, \'multiverseid\': 482428}, {\'name\': \'両生共生体\', \'text\': \'あなたがクリーチャー・呪文を唱えるためのコストは、それが変容を持っているなら、{1}少なくなる。\\nあなたがクリーチャー・呪文を唱えるたび、それが変容を持っている場合、カードを１枚引き、その後カード１枚を捨てる。\', \'type\': \'クリーチャー — カエル\', \'flavor\': \'新（あら）たなる災（さい）厄（やく）、ベビーゴジラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482442&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b21ecbb0-39d4-4139-8bad-42b047a15c3d\', \'multiverseId\': 482442}, \'multiverseid\': 482442}, {\'name\': \'양서류 공생자\', \'text\': \'당신이 발동하는 각 생물 주문은 그 주문이 돌연변이화를 가지고 있다면 발동하는 데 {1}이 덜 든다.\\n당신이 생물 주문을 발동할 때마다, 그 주문이 돌연변이화를 가지고 있다면, 카드 한 장을 뽑은 후, 카드 한 장을 버린다.\', \'type\': \'생물 — 개구리\', \'flavor\': \'폐허에서 재탄생한 괴수, 베이비고질라\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482456&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'aa2bc57d-319f-4a83-ac0e-a861af9e9ccb\', \'multiverseId\': 482456}, \'multiverseid\': 482456}, {\'name\': \'Simbionte Girino\', \'text\': \'Cada mágica de criatura que você conjura custa {1} a menos para ser conjurada se tiver mutação.\\nToda vez que você conjurar uma mágica de criatura, se ela tiver mutação, compre um card e depois descarte um card.\', \'type\': \'Criatura — Sapo\', \'flavor\': \'Babygodzilla, Ruína Renascida\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482470&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'31e0daa9-b12a-4b2e-85bc-cf45a932b48f\', \'multiverseId\': 482470}, \'multiverseid\': 482470}, {\'name\': \'Симбионт-Головастик\', \'text\': \'Каждое разыгрываемое вами заклинание существа стоит на {1} меньше, если у него есть Мутация.\\nКаждый раз, когда вы разыгрываете заклинание существа, если у него есть Мутация, возьмите карту, затем сбросьте карту.\', \'type\': \'Существо — Лягушка\', \'flavor\': \'Малыш Годзилла, Юный Крушитель\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482484&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'541946cc-9ea4-4e1d-9bb2-f8263a648938\', \'multiverseId\': 482484}, \'multiverseid\': 482484}, {\'name\': \'蝌蚪共生体\', \'text\': \'如果你施放的生物咒语具有合变异能，则它减少{1}来施放。\\n每当你施放生物咒语时，若它具有合变异能，则抓一张牌，然后弃一张牌。\', \'type\': \'生物 ～蛙\', \'flavor\': \'遗迹新生小哥斯拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482498&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'293b4c2f-490c-4558-91a1-5ae8aec687ab\', \'multiverseId\': 482498}, \'multiverseid\': 482498}, {\'name\': \'蝌蚪共生體\', \'text\': \'如果你施放的生物咒語具有合變異能，則它減少{1}來施放。\\n每當你施放生物咒語時，若它具有合變異能，則抽一張牌，然後棄一張牌。\', \'type\': \'生物 ～蛙\', \'flavor\': \'遺跡新生小哥吉拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482512&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'df9a5211-65a6-48b5-baf0-e7340f24c20e\', \'multiverseId\': 482512}, \'multiverseid\': 482512}]', '[{\'name\': \'Kaulquappensymbiont\', \'text\': \'Jeder Kreaturenzauber, den du wirkst, kostet beim Wirken {1} weniger, falls er Mutation hat.\\nImmer wenn du einen Kreaturenzauber wirkst und falls er Mutation hat, ziehe eine Karte und wirf dann eine Karte ab.\', \'type\': \'Kreatur — Frosch\', \'flavor\': \'Er wusste schon immer, dass er dazu bestimmt war, mehr als nur ein Frosch zu sein.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479842&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d8f1530d-ea5f-442d-8d95-7b5ff69e5ec2\', \'multiverseId\': 479842}, \'multiverseid\': 479842}, {\'name\': \'Renacuajo simbiótico\', \'text\': \'Te cuesta {1} menos lanzar cada hechizo de criatura si tiene la habilidad de mutación.\\nSiempre que lances un hechizo de criatura, si tiene la habilidad de mutación, roba una carta y descarta una carta.\', \'type\': \'Criatura — Rana\', \'flavor\': \'Siempre supo que su destino era ser algo más que una rana.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480101&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'afdb589f-0c15-4d7f-9982-c28c86e9f91d\', \'multiverseId\': 480101}, \'multiverseid\': 480101}, {\'name\': \'Symbiote têtard\', \'text\': "Chaque sort de créature que vous lancez coûte {1} de moins à lancer s\'il a la mutation.\\nÀ chaque fois que vous lancez un sort de créature, s\'il a la mutation, piochez une carte, puis défaussez-vous d\'une carte.", \'type\': \'Créature : grenouille\', \'flavor\': "Il savait qu\'il deviendrait plus qu\'une simple grenouille.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480360&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'27f6b591-9835-4b79-bcc0-5d86a998e394\', \'multiverseId\': 480360}, \'multiverseid\': 480360}, {\'name\': \'Simbionte Girino\', \'text\': \'Ogni magia creatura che lanci costa {1} in meno per essere lanciata se ha mutazione.\\nOgniqualvolta lanci una magia creatura, se ha mutazione, pesca una carta, poi scarta una carta.\', \'type\': \'Creatura — Rana\', \'flavor\': \'Ha sempre saputo di essere destinato a diventare molto più che una rana.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480619&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4911d8f1-b6a0-467d-98fd-5affc4778caf\', \'multiverseId\': 480619}, \'multiverseid\': 480619}, {\'name\': \'両生共生体\', \'text\': \'あなたがクリーチャー・呪文を唱えるためのコストは、それが変容を持っているなら、{1}少なくなる。\\nあなたがクリーチャー・呪文を唱えるたび、それが変容を持っている場合、カードを１枚引き、その後カード１枚を捨てる。\', \'type\': \'クリーチャー — カエル\', \'flavor\': \'それは自分がカエル以上のものになることを常に知っていた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480878&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4ad152aa-5669-491b-a96a-815aba645351\', \'multiverseId\': 480878}, \'multiverseid\': 480878}, {\'name\': \'양서류 공생자\', \'text\': \'당신이 발동하는 각 생물 주문은 그 주문이 돌연변이화를 가지고 있다면 발동하는 데 {1}이 덜 든다.\\n당신이 생물 주문을 발동할 때마다, 그 주문이 돌연변이화를 가지고 있다면, 카드 한 장을 뽑은 후, 카드 한 장을 버린다.\', \'type\': \'생물 — 개구리\', \'flavor\': \'그것은 항상 자신이 단순한 개구리 그 이상이 될 운명이라는 것을 알고 있었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481137&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f5aedd73-87be-4b46-a565-9dc316d0649d\', \'multiverseId\': 481137}, \'multiverseid\': 481137}, {\'name\': \'Simbionte Girino\', \'text\': \'Cada mágica de criatura que você conjura custa {1} a menos para ser conjurada se tiver mutação.\\nToda vez que você conjurar uma mágica de criatura, se ela tiver mutação, compre um card e depois descarte um card.\', \'type\': \'Criatura — Sapo\', \'flavor\': \'Eu sempre soube que o destino dele era ser mais que um sapo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481396&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ee4c5073-3d74-43b7-872c-74a84471ba5f\', \'multiverseId\': 481396}, \'multiverseid\': 481396}, {\'name\': \'Симбионт-Головастик\', \'text\': \'Каждое разыгрываемое вами заклинание существа стоит на {1} меньше, если у него есть Мутация.\\nКаждый раз, когда вы разыгрываете заклинание существа, если у него есть Мутация, возьмите карту, затем сбросьте карту.\', \'type\': \'Существо — Лягушка\', \'flavor\': \'Он всегда знал, что ему суждено стать не просто лягушкой.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481655&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'12a67ca8-3dfc-4e5a-8ef7-dc2868ce152a\', \'multiverseId\': 481655}, \'multiverseid\': 481655}, {\'name\': \'蝌蚪共生体\', \'text\': \'如果你施放的生物咒语具有合变异能，则它减少{1}来施放。\\n每当你施放生物咒语时，若它具有合变异能，则抓一张牌，然后弃一张牌。\', \'type\': \'生物 ～蛙\', \'flavor\': \'它早就知道自己命中不会只是一只蛙。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481914&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8ded3137-6a42-4e0f-a85b-c0cc30d868c9\', \'multiverseId\': 481914}, \'multiverseid\': 481914}, {\'name\': \'蝌蚪共生體\', \'text\': \'如果你施放的生物咒語具有合變異能，則它減少{1}來施放。\\n每當你施放生物咒語時，若它具有合變異能，則抽一張牌，然後棄一張牌。\', \'type\': \'生物 ～蛙\', \'flavor\': \'牠早就知道自己命中不會只是一隻蛙。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482173&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1b727680-20b2-4ac1-b87e-83742246c095\', \'multiverseId\': 482173}, \'multiverseid\': 482173}]', '[{\'name\': \'Keruga, Weiser der Größe\', \'text\': \'Gefährte — Dein Startdeck enthält nur Länderkarten und Karten mit umgewandelten Manakosten von 3 oder mehr. (Falls du diese Karte als deinen Gefährten erwählt hast, kannst du sie einmal von außerhalb der Partie wirken.)\\nWenn Keruga, Weiser der Größe, ins Spiel kommt, ziehe für jede andere bleibende Karte mit umgewandelten Manakosten von 3 oder mehr, die du kontrollierst, eine Karte.\', \'type\': \'Legendäre Kreatur — Dinosaurier, Flusspferd\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480004&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'22a20232-de6c-4179-bf63-5ffa85fbea52\', \'multiverseId\': 480004}, \'multiverseid\': 480004}, {\'name\': \'Keruga, Macrosapiente\', \'text\': \'Compañero — Tu mazo inicial contiene solo cartas con coste de maná convertido de 3 o más y cartas de tierra. (Si esta carta es el compañero que eliges, puedes lanzarla una vez desde fuera del juego.)\\nCuando Keruga, Macrosapiente entre al campo de batalla, roba una carta por cada otro permanente que controlas con coste de maná convertido de 3 o más.\', \'type\': \'Criatura legendaria — Hipopótamo dinosaurio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480263&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d77b8151-e571-4527-98ed-3afae051d799\', \'multiverseId\': 480263}, \'multiverseid\': 480263}, {\'name\': \'Keruga, le Macrosophe\', \'text\': "Compagnon — Votre deck de départ ne contient que des cartes avec un coût converti de mana supérieur ou égal à 3 et des cartes de terrain. (Si cette carte est le compagnon de votre choix, vous pouvez la lancer une fois depuis l\'extérieur de la partie.)\\nQuand Keruga, le Macrosophe arrive sur le champ de bataille, piochez une carte pour chaque autre permanent que vous contrôlez avec un coût converti de mana supérieur ou égal à 3.", \'type\': \'Créature légendaire : dinosaure et hippopotame\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480522&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a59ba453-8589-4a85-a124-b55014e18f17\', \'multiverseId\': 480522}, \'multiverseid\': 480522}, {\'name\': \'Keruga, il Macrosavio\', \'text\': \'Compagno — Il tuo mazzo iniziale contiene solo carte con costo di mana convertito pari o superiore a 3 e carte terra. (Se questa carta è il compagno che hai scelto, puoi lanciarla una volta dal di fuori della partita.)\\nQuando Keruga, il Macrosavio entra nel campo di battaglia, pesca una carta per ogni altro permanente che controlli con costo di mana convertito pari o superiore a 3.\', \'type\': \'Creatura Leggendaria — Ippopotamo Dinosauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480781&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'31666222-8d88-49d5-a209-8cca137c7939\', \'multiverseId\': 480781}, \'multiverseid\': 480781}, {\'name\': \'巨智、ケルーガ\', \'text\': \'相棒 ― あなたの開始時のデッキに、点数で見たマナ・コストが３以上のカードと土地・カードのみが入っていること。（このカードがあなたの選んだ相棒であるなら、あなたは１回のみゲームの外部からこれを唱えてもよい。）\\n巨智、ケルーガが戦場に出たとき、あなたは、他の、あなたがコントロールしていて点数で見たマナ・コストが３以上のパーマネント１つにつきカードを１枚引く。\', \'type\': \'伝説のクリーチャー — 恐竜・カバ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481040&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'57dbfc18-75c5-46a6-9482-74242d283849\', \'multiverseId\': 481040}, \'multiverseid\': 481040}, {\'name\': \'거대현자, 케루가\', \'text\': \'단짝 — 당신의 시작 덱에는 전환마나비용이 3 이상인 카드 및 대지 카드만 들어 있다. (이 카드가 당신이 선택한 단짝이라면, 당신은 이 카드를 게임 밖에서 한 번 발동할 수 있다.)\\n거대현자, 케루가가 전장에 들어올 때, 당신이 조종하는 전환마나비용이 3 이상인 다른 각 지속물마다 카드 한 장을 뽑는다.\', \'type\': \'전설적 생물 — 공룡 하마\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481299&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'360802b1-bb96-4bc1-abec-34f7ba81d16d\', \'multiverseId\': 481299}, \'multiverseid\': 481299}, {\'name\': \'Keruga, o Macrossábio\', \'text\': \'Companheiro — Seu card inicial contém apenas cards com custo de mana convertido igual ou superior a 3 e cards de terreno. (Se este card for o companheiro que escolheu, você poderá conjurá-lo uma vez de fora do jogo.)\\nQuando Keruga, o Macrossábio, entrar no campo de batalha, compre um card para cada outra permanente que você controla com custo de mana convertido igual ou superior a 3.\', \'type\': \'Criatura Lendária — Dinossauro Hipopótamo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481558&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a495bb10-ba36-44b9-88e5-9774a93d127f\', \'multiverseId\': 481558}, \'multiverseid\': 481558}, {\'name\': \'Керуга, Мудрец-Исполин\', \'text\': \'Компаньон — Ваша начальная колода содержит только карты с конвертированной мана-стоимостью не менее 3 и карты земель. (Если эта карта является вашим избранным Компаньоном, то вы можете один раз разыграть ее из-за пределов игры.)\\nКогда Керуга, Мудрец-Исполин выходит на поле битвы, возьмите одну карту за каждый другой перманент под вашим контролем с конвертированной мана-стоимостью не менее 3.\', \'type\': \'Легендарное Существо — Динозавр Бегемот\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481817&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2dbb588a-b3c0-4765-8a0b-fa436c854db7\', \'multiverseId\': 481817}, \'multiverseid\': 481817}, {\'name\': \'庞巨智者刻卢佳\', \'text\': \'行侣～你起始套牌中仅包含地牌和总法术力费用等于或大于3的牌。（如果你选择这张牌作为你的行侣，则你可以从游戏外施放它，但仅限一次。）\\n当庞巨智者刻卢佳进战场时，你每操控一个总法术力费用等于或大于3的其他永久物，便抓一张牌。\', \'type\': \'传奇生物 ～恐龙／河马\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482076&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f6231c4c-62a2-4f42-abbe-6cda00eaab5f\', \'multiverseId\': 482076}, \'multiverseid\': 482076}, {\'name\': \'龐巨智者刻盧佳\', \'text\': \'行侶～你起始套牌中僅包含地牌和總魔法力費用等於或大於3的牌。（如果你選擇這張牌作為你的行侶，則你可以從遊戲外施放它，但僅限一次。）\\n當龐巨智者刻盧佳進戰場時，你每操控一個總魔法力費用等於或大於3的其他永久物，便抽一張牌。\', \'type\': \'傳奇生物 ～恐龍／河馬\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482335&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2b510b8f-4bde-429c-8e87-cc2d9778504d\', \'multiverseId\': 482335}, \'multiverseid\': 482335}]', '[{\'name\': \'Ketria-Kristall\', \'text\': \'{T}: Erzeuge {G}, {U} oder {R}.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Artefakt\', \'flavor\': \'Die Dunkelheit der Nacht fällt nie wirklich auf Ketria, wo unzählige Kristalle das Land in ihren Glanz tauchen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480015&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dce96bfa-d8b1-4ffc-aa8f-5567510e23b6\', \'multiverseId\': 480015}, \'multiverseid\': 480015}, {\'name\': \'Cristal de Ketria\', \'text\': \'{T}: Agrega {G}, {U} o {R}.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Artefacto\', \'flavor\': \'La oscuridad de la noche nunca cae del todo sobre Ketria, ya que los abundantes cristales inundan la tierra con su brillo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480274&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7209682b-926e-49f1-b8d9-d715b604d726\', \'multiverseId\': 480274}, \'multiverseid\': 480274}, {\'name\': \'Cristal de Ketria\', \'text\': \'{T} : Ajoutez {G}, {U} ou {R}.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)\', \'type\': \'Artefact\', \'flavor\': "La nuit n\'est jamais vraiment totale sur Ketria, car de nombreux cristaux baignent les terres de leur lueur.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480533&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'59811a02-6ae2-474c-a7ec-075d975cd942\', \'multiverseId\': 480533}, \'multiverseid\': 480533}, {\'name\': \'Cristallo di Ketria\', \'text\': \'{T}: Aggiungi {G}, {U} o {R}.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Artefatto\', \'flavor\': "L\'oscurità della notte non scende mai davvero su Ketria, dove l\'abbondanza di cristalli inonda la terra con il suo bagliore.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480792&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b47c5a6f-bdf8-466a-9e3c-9f308dc4435a\', \'multiverseId\': 480792}, \'multiverseid\': 480792}, {\'name\': \'ケトリアの水晶\', \'text\': \'{T}：{G}か{U}か{R}を加える。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'アーティファクト\', \'flavor\': \'夜の闇がケトリアを完全に覆うことはない。あふれんばかりの水晶がその地を光で満たしているからだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481051&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'96e70be1-ed59-4058-be18-889a46344a4a\', \'multiverseId\': 481051}, \'multiverseid\': 481051}, {\'name\': \'케트리아 수정\', \'text\': \'{T}: {G}, {U}, 또는 {R}를 추가한다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'마법물체\', \'flavor\': \'케트리아에서는 수많은 수정들이 대지를 빛으로 물들이기에, 진정한 밤은 찾아오지 않는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481310&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5d556cd1-af4e-4184-84af-6d9828580ee5\', \'multiverseId\': 481310}, \'multiverseid\': 481310}, {\'name\': \'Cristal de Ketria\', \'text\': \'{T}: Adicione {G}, {U} ou {R}.\\nReciclar {2} ({2}, descarte este card: Compre um card.)\', \'type\': \'Artefato\', \'flavor\': \'O breu da noite jamais chega realmente em Ketria, onde os cristais, abundantes, banham a terra com sua luz.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481569&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2c122fd1-75df-4f6d-b0fb-d37324c85c88\', \'multiverseId\': 481569}, \'multiverseid\': 481569}, {\'name\': \'Кристалл Кетрии\', \'text\': \'{T}: добавьте {G}, {U} или {R}.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Артефакт\', \'flavor\': \'В Кетрии никогда не бывает по-настоящему темных ночей: повсеместно встречающиеся кристаллы освещают этот край своим мерцанием.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481828&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7b15656a-1561-4813-893a-eefc106dbdec\', \'multiverseId\': 481828}, \'multiverseid\': 481828}, {\'name\': \'克崔亚水晶\', \'text\': \'{T}：加{G}，{U}或{R}。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'神器\', \'flavor\': \'克崔亚的水晶遍布各处，以璀璨光芒照耀大地，令夜幕从未真正降临此处。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482087&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fbd8ba5f-b634-4381-8e51-c8074b63ea6e\', \'multiverseId\': 482087}, \'multiverseid\': 482087}, {\'name\': \'克崔亞水晶\', \'text\': \'{T}：加{G}，{U}或{R}。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'神器\', \'flavor\': \'克崔亞的水晶遍佈各處，以璀璨光芒照耀大地，令夜幕從未真正降臨此處。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482346&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0534f2ae-599c-49ba-b66b-9c69f8b4bf19\', \'multiverseId\': 482346}, \'multiverseid\': 482346}]', '[{\'name\': \'Ketria-Triom\', \'text\': \'({T}: Erzeuge {G}, {U} oder {R}.)\\nDas Ketria-Triom kommt getappt ins Spiel.\\nUmwandlung {3} ({3}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Land — Wald, Insel, Gebirge\', \'flavor\': \'Nirgendwo auf Ikoria sind Monster ein so integraler Bestandteil der Landschaft wie in Ketria, wo selbst die Flüsse auferstehen und brüllen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480029&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'811ef14f-4293-4c9d-ab51-8b3e8d5bd193\', \'multiverseId\': 480029}, \'multiverseid\': 480029}, {\'name\': \'Trioma de Ketria\', \'text\': \'({T}: Agrega {G}, {U} o {R}.)\\nEl Trioma de Ketria entra al campo de batalla girado.\\nCiclo {3}. ({3}, descartar esta carta: Roba una carta.)\', \'type\': \'Tierra — Bosque isla montaña\', \'flavor\': \'En ningún lugar de Ikoria los monstruos forman parte integral del paisaje como en Ketria, donde hasta el propio río se alza y ruge.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480288&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'61f00568-aa72-43b7-b3e1-06fd163a5121\', \'multiverseId\': 480288}, \'multiverseid\': 480288}, {\'name\': \'Triome de Ketria\', \'text\': \'({T} : Ajoutez {G}, {U} ou {R}.)\\nLe Triome de Ketria arrive sur le champ de bataille engagé.\\nRecyclage {3} ({3}, défaussez-vous de cette carte : Piochez une carte.)\', \'type\': \'Terrain : forêt et île et montagne\', \'flavor\': "Sur Ikoria, les monstres font partie intégrante du paysage. C\'est d\'autant plus vrai à Ketria, où la rivière elle-même se dresse pour rugir.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480547&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b254ddbc-507c-4d86-ad00-7cd4d7327ccd\', \'multiverseId\': 480547}, \'multiverseid\': 480547}, {\'name\': \'Trioma di Ketria\', \'text\': \'({T}: Aggiungi {G}, {U} o {R}.)\\nIl Trioma di Ketria entra nel campo di battaglia TAPpato.\\nCiclo {3} ({3}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Terra — Foresta Isola Montagna\', \'flavor\': \'In nessun altro luogo su Ikoria i mostri sono più integrati nel paesaggio che a Ketria, dove il fiume stesso si alza e ruggisce.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480806&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eebc503b-0b5d-487c-9a63-5ee337988d5f\', \'multiverseId\': 480806}, \'multiverseid\': 480806}, {\'name\': \'ケトリアのトライオーム\', \'text\': \'（{T}：{G}か{U}か{R}を加える。）\\nケトリアのトライオームはタップ状態で戦場に出る。\\nサイクリング{3}（{3}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'土地 — 森・島・山\', \'flavor\': \'イコリアには、ケトリアほど景観に怪物の存在が不可欠な場所はない。川までもが立ち上がり咆哮を上げている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481065&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ecbdf29c-ce87-46a6-a81d-7b9cd91bce29\', \'multiverseId\': 481065}, \'multiverseid\': 481065}, {\'name\': \'케트리아 삼생물군계\', \'text\': \'({T}: {G}, {U}, 또는 {R}를 추가한다.)\\n케트리아 삼생물군계는 탭된 채로 전장에 들어온다.\\n순환 {3} ({3}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'대지 — 숲 섬 산\', \'flavor\': \'이코리아의 어느 곳도 강 자체가 솟구쳐올라 포효하는 케트리아만큼 괴수들이 그 지형에 필수불가결한 곳은 없다\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481324&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e90b2d98-496a-4df0-b68e-e756c441fa68\', \'multiverseId\': 481324}, \'multiverseid\': 481324}, {\'name\': \'Trioma de Ketria\', \'text\': \'({T}: Adicione {G}, {U} ou {R}.)\\nTrioma de Ketria entra no campo de batalha virado.\\nReciclar {3} ({3}, descarte este card: Compre um card.)\', \'type\': \'Terreno — Floresta Ilha Montanha\', \'flavor\': \'Em nenhum outro lugar de Ikoria os monstros se integram mais à paisagem que em Ketria, onde o próprio rio se ergue e ruge.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481583&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bedfc3f5-effc-4662-b53d-c71a80748a11\', \'multiverseId\': 481583}, \'multiverseid\': 481583}, {\'name\': \'Триом Кетрия\', \'text\': \'({T}: добавьте {G}, {U} или {R}.)\\nТриом Кетрия выходит на поле битвы повернутым.\\nЦикл {3} ({3}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Земля — Лес Остров Гора\', \'flavor\': \'Нигде на Икории чудовища так гармонично не вписываются в пейзаж, как в Кетрии. Здесь сама река может зареветь, встав на дыбы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481842&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a9f9cf62-8f9f-47fc-aacd-f35abe56f05c\', \'multiverseId\': 481842}, \'multiverseid\': 481842}, {\'name\': \'克崔亚群系\', \'text\': \'（{T}：加{G}，{U}或{R}。）\\n克崔亚群系须横置进战场。\\n循环{3}（{3}，弃掉此牌：抓一张牌。）\', \'type\': \'地 ～树林／海岛／山脉\', \'flavor\': \'要论怪兽与地形结合的紧密程度，恐怕整个依克黎没有哪里能比克崔亚更高：此处的河流甚至都会自行起身咆哮。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482101&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bebb8703-6ab5-4a36-bb3d-bb90c6def96c\', \'multiverseId\': 482101}, \'multiverseid\': 482101}, {\'name\': \'克崔亞群系\', \'text\': \'（{T}：加{G}，{U}或{R}。）\\n克崔亞群系須橫置進戰場。\\n循環{3}（{3}，棄掉此牌：抽一張牌。）\', \'type\': \'地 ～樹林／海島／山脈\', \'flavor\': \'要論怪獸與地形結合的緊密程度，恐怕整個依克黎沒有哪裡能比克崔亞更高：此處的河流甚至都會自行起身咆哮。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482360&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d82b2efd-d011-4991-acaa-f5ec86281cd6\', \'multiverseId\': 482360}, \'multiverseid\': 482360}]', '[{\'name\': \'Kinnan, Bynder-Naturtalent\', \'text\': \'Immer wenn du eine bleibende Karte, die kein Land ist, für Mana tappst, erzeuge ein Mana eines beliebigen Typs, das die bleibende Karte erzeugt hat.\\n{5}{G}{U}: Schaue dir die obersten fünf Karten deiner Bibliothek an. Du kannst davon eine Nicht-Mensch-Kreaturenkarte ins Spiel bringen. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.\', \'type\': \'Legendäre Kreatur — Mensch, Druide\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479971&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6fe265f7-a0f0-4d9f-8ac9-3464c575065a\', \'multiverseId\': 479971}, \'multiverseid\': 479971}, {\'name\': \'Kinnan, el Vinculador Prodigioso\', \'text\': \'Siempre que gires un permanente que no sea tierra para obtener maná, agrega un maná de cualquier tipo que produjo ese permanente.\\n{5}{G}{U}: Mira las cinco primeras cartas de tu biblioteca. Puedes poner en el campo de batalla una carta de criatura que no sea Humano que se encuentre entre ellas. Pon el resto en el fondo de tu biblioteca en un orden aleatorio.\', \'type\': \'Criatura legendaria — Druida humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480230&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'401719da-48c6-4c56-80d1-0881cb4ccb2a\', \'multiverseId\': 480230}, \'multiverseid\': 480230}, {\'name\': \'Kinnan, prodige brideur\', \'text\': "À chaque fois que vous engagez un permanent non-terrain pour du mana, ajoutez un mana de n\'importe quel type que ce permanent a produit.\\n{5}{G}{U} : Regardez les cinq cartes du dessus de votre bibliothèque. Vous pouvez mettre sur le champ de bataille une carte de créature non-Humain parmi elles. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.", \'type\': \'Créature légendaire : humain et druide\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480489&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'20656cdc-bae4-4afc-87b2-502ea3803281\', \'multiverseId\': 480489}, \'multiverseid\': 480489}, {\'name\': \'Kinnan, Vincolatore Prodigio\', \'text\': \'Ogniqualvolta TAPpi un permanente non terra per attingere mana, aggiungi un mana di qualsiasi tipo prodotto da quel permanente.\\n{5}{G}{U}: Guarda le prime cinque carte del tuo grimorio. Puoi mettere sul campo di battaglia una carta creatura non Umano scelta tra esse. Metti le altre in fondo al tuo grimorio in ordine casuale.\', \'type\': \'Creatura Leggendaria — Druido Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480748&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e543541c-aad6-4edb-ab22-eb2cad5a0d6d\', \'multiverseId\': 480748}, \'multiverseid\': 480748}, {\'name\': \'眷者の神童、キナン\', \'text\': \'あなたがマナを引き出す目的で土地でないパーマネントを１つタップするたび、そのパーマネントが生み出したマナのタイプのうち望むタイプ１つのマナ１点を加える。\\n{5}{G}{U}：あなたのライブラリーの一番上からカードを５枚見る。あなたはその中から人間でないクリーチャー・カード１枚を戦場に出してもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'伝説のクリーチャー — 人間・ドルイド\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481007&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'893428c8-3813-44b4-a679-fbe5c4fd75b6\', \'multiverseId\': 481007}, \'multiverseid\': 481007}, {\'name\': \'천재 유대자, 키난\', \'text\': \'당신이 마나를 생산하기 위해 대지가 아닌 지속물을 탭할 때마다, 그 지속물이 생산한 마나 유형 중 하나를 골라 그 마나 한 개를 추가한다.\\n{5}{G}{U}: 당신의 서고 맨 위 카드 다섯 장을 본다. 당신은 그중에서 인간이 아닌 생물 카드 한 장을 전장에 놓을 수 있다. 나머지 카드들은 무작위 순서로 당신의 서고 맨 밑에 놓는다.\', \'type\': \'전설적 생물 — 인간 드루이드\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481266&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'44a6ea22-6ba3-4282-8f40-b7fcde3278e7\', \'multiverseId\': 481266}, \'multiverseid\': 481266}, {\'name\': \'Kinnan, Vinculador Prodígio\', \'text\': \'Toda vez que você virar uma permanente que não seja um terreno para gerar mana, adicione um mana de qualquer tipo que aquela permanente tenha gerado.\\n{5}{G}{U}: Olhe os cinco cards do topo de seu grimório. Você pode colocar um card de criatura que não seja um Humano dentre eles no campo de batalha. Coloque o restante no fundo de seu grimório em ordem aleatória.\', \'type\': \'Criatura Lendária — Humano Druida\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481525&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0c6403fa-918f-4bc5-8f32-3e374ef3bba7\', \'multiverseId\': 481525}, \'multiverseid\': 481525}, {\'name\': \'Киннан, Одаренный Узомант\', \'text\': \'Каждый раз, когда вы поворачиваете не являющийся землей перманент для получения маны, добавьте одну ману любого типа, произведенного тем перманентом.\\n{5}{G}{U}: посмотрите пять верхних карт вашей библиотеки. Вы можете положить на поле битвы находящуюся среди них карту не являющегося Человеком существа. Положите остальные карты в низ вашей библиотеки в случайном порядке.\', \'type\': \'Легендарное Существо — Человек Друид\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481784&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f7398010-1729-4db2-bacd-2cb597b9f4ea\', \'multiverseId\': 481784}, \'multiverseid\': 481784}, {\'name\': \'持绊逸才季宁\', \'text\': \'每当你横置一个非地永久物以产生法术力时，加一点该永久物已产生的类别之法术力。\\n{5}{G}{U}：检视你牌库顶的五张牌。你可以将其中一张非人类的生物牌放进战场。将其余的牌以随机顺序置于你的牌库底。\', \'type\': \'传奇生物 ～人类／德鲁伊\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482043&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a88aa19c-7e2e-4a07-bdfa-2eaf84e97be4\', \'multiverseId\': 482043}, \'multiverseid\': 482043}, {\'name\': \'持絆逸才季寧\', \'text\': \'每當你橫置一個非地永久物以產生魔法力時，加一點該永久物已產生的類別之魔法力。\\n{5}{G}{U}：檢視你牌庫頂的五張牌。你可以將其中一張非人類的生物牌放進戰場。將其餘的牌以隨機順序置於你的牌庫底。\', \'type\': \'傳奇生物 ～人類／德魯伊\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482302&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'769a867e-e6ce-4e34-a5af-6862dc2279a9\', \'multiverseId\': 482302}, \'multiverseid\': 482302}]', '[{\'name\': \'Klagelied-Fledermaus\', \'text\': \'Mutation {4}{B}{B} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\nAufblitzen\\nFliegend\\nImmer wenn diese Kreatur mutiert, zerstöre eine Kreatur oder einen Planeswalker deiner Wahl, die bzw. den ein Gegner kontrolliert.\', \'type\': \'Kreatur — Fledermaus\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479863&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'25fec2de-392d-4622-9149-9aefc0728f79\', \'multiverseId\': 479863}, \'multiverseid\': 479863}, {\'name\': \'Murciélago fúnebre\', \'text\': \'Mutación {4}{B}{B}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\nDestello.\\nVuela.\\nSiempre que esta criatura mute, destruye la criatura o planeswalker objetivo que controla un oponente.\', \'type\': \'Criatura — Murciélago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480122&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b7dee063-9a82-43b5-853a-102d0e2f5759\', \'multiverseId\': 480122}, \'multiverseid\': 480122}, {\'name\': \'Chauve-souris funèbre\', \'text\': "Mutation {4}{B}{B} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\nFlash\\nVol\\nÀ chaque fois que cette créature subit une mutation, détruisez une créature ciblée ou un planeswalker ciblé qu\'un adversaire contrôle.", \'type\': \'Créature : chauve-souris\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480381&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f8d486f6-c3f4-4993-89c6-54573ef35e8b\', \'multiverseId\': 480381}, \'multiverseid\': 480381}, {\'name\': \'Pipistrello del Lamento Funebre\', \'text\': \'Mutazione {4}{B}{B} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\nLampo\\nVolare\\nOgniqualvolta questa creatura muta, distruggi una creatura o un planeswalker bersaglio controllati da un avversario.\', \'type\': \'Creatura — Pipistrello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480640&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5dc09fdb-e18b-4fb4-8908-2fb26f7d5bba\', \'multiverseId\': 480640}, \'multiverseid\': 480640}, {\'name\': \'哀歌コウモリ\', \'text\': \'変容{4}{B}{B}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\n瞬速\\n飛行\\nこのクリーチャーが変容するたび、対戦相手がコントロールしている、クリーチャー１体かプレインズウォーカー１体を対象とし、それを破壊する。\', \'type\': \'クリーチャー — コウモリ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480899&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b3ad9f61-88b2-47ee-8abc-8fba9b83343f\', \'multiverseId\': 480899}, \'multiverseid\': 480899}, {\'name\': \'장송곡 박쥐\', \'text\': \'돌연변이화 {4}{B}{B} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n섬광\\n비행\\n이 생물이 돌연변이화할 때마다, 상대가 조종하는 생물 또는 플레인즈워커를 목표로 정한다. 그 목표를 파괴한다.\', \'type\': \'생물 — 박쥐\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481158&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7a893c39-9d23-4cad-9b9e-43cb5a757081\', \'multiverseId\': 481158}, \'multiverseid\': 481158}, {\'name\': \'Morcego do Lamento Fúnebre\', \'text\': \'Mutação {4}{B}{B} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\nLampejo\\nVoar\\nToda vez que esta criatura sofrer mutação, destrua a criatura ou o planeswalker alvo que um oponente controla.\', \'type\': \'Criatura — Morcego\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481417&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7fd3918d-e917-43c0-8b3b-16b65f3a7dc8\', \'multiverseId\': 481417}, \'multiverseid\': 481417}, {\'name\': \'Нетопырь-Плакальщик\', \'text\': "Мутация {4}{B}{B} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\nМиг\\nПолет\\nКаждый раз, когда это существо мутирует, уничтожьте целевое существо или planeswalker\'а под контролем оппонента.", \'type\': \'Существо — Летучая_мышь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481676&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3e61b01d-c548-48df-bb49-6deef1826d72\', \'multiverseId\': 481676}, \'multiverseid\': 481676}, {\'name\': \'悼挽蝙蝠\', \'text\': \'合变{4}{B}{B}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n闪现\\n飞行\\n每当此生物合变时，消灭目标由对手操控的生物或鹏洛客。\', \'type\': \'生物 ～蝙蝠\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481935&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a7a2200d-875f-4dd8-80f1-6d7885fe0a03\', \'multiverseId\': 481935}, \'multiverseid\': 481935}, {\'name\': \'悼輓蝙蝠\', \'text\': \'合變{4}{B}{B}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n閃現\\n飛行\\n每當此生物合變時，消滅目標由對手操控的生物或鵬洛客。\', \'type\': \'生物 ～蝙蝠\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482194&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'accc25ac-dd80-4af0-b861-f93b48982bdf\', \'multiverseId\': 482194}, \'multiverseid\': 482194}]', "[{'name': 'Klingenbann', 'text': 'Schicke eine Kreatur deiner Wahl mit Stärke 4 oder mehr ins Exil.', 'type': 'Spontanzauber', 'flavor': 'Die Wanderin beschreitet viele Wege. Ihre Klinge nur einen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479783&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0e89dbf8-d4e3-43cd-997d-9785149ad139', 'multiverseId': 479783}, 'multiverseid': 479783}, {'name': 'Destierro afilado', 'text': 'Exilia la criatura objetivo con fuerza de 4 o más.', 'type': 'Instantáneo', 'flavor': 'La Errante recorre muchos caminos. Su espada, solo uno.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480042&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c0c4e7d6-0feb-44a8-87b6-666f10d2fc6a', 'multiverseId': 480042}, 'multiverseid': 480042}, {'name': 'Bannir par la lame', 'text': 'Exilez une créature ciblée avec une force supérieure ou égale à 4.', 'type': 'Éphémère', 'flavor': 'La Vagabonde suit bien des chemins. Mais sa lame sait où elle va.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480301&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c2fe3334-90a2-4a27-a9d2-bfc00ce980b1', 'multiverseId': 480301}, 'multiverseid': 480301}, {'name': 'Bandire con la Lama', 'text': 'Esilia una creatura bersaglio con forza pari o superiore a 4.', 'type': 'Istantaneo', 'flavor': 'La Viandante ha viaggiato in molte direzioni. La sua lama solo in una.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480560&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '7cdc8651-d1e0-46c4-afbe-772026c8e6ec', 'multiverseId': 480560}, 'multiverseid': 480560}, {'name': '刃による払拭', 'text': 'パワーが４以上のクリーチャー１体を対象とし、それを追放する。', 'type': 'インスタント', 'flavor': '放浪者は多くの道を歩く。彼女の刃が進む道はただ一つ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480819&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '04163769-6cd9-4fc5-b61c-0b83818c7d43', 'multiverseId': 480819}, 'multiverseid': 480819}, {'name': '칼날 소멸', 'text': '공격력이 4 이상인 생물을 목표로 정한다. 그 생물을 추방한다.', 'type': '순간마법', 'flavor': '방랑자는 수많은 길을 걷는다. 그녀의 검은 단 하나의 길을 따른다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481078&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '42f7fa6f-954d-4d82-9d5f-9bef48c98441', 'multiverseId': 481078}, 'multiverseid': 481078}, {'name': 'Banimento a Lâmina', 'text': 'Exile a criatura alvo com poder igual ou superior a 4.', 'type': 'Mágica Instantânea', 'flavor': 'A Errante percorre muitas trilhas. Sua lâmina apenas uma.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481337&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '6d502ad8-3bdc-44c8-9f4f-f12d92466eaf', 'multiverseId': 481337}, 'multiverseid': 481337}, {'name': 'Изгнание Клинком', 'text': 'Изгоните целевое существо с силой 4 или больше.', 'type': 'Мгновенное заклинание', 'flavor': 'Странница путешествует по бесчисленному множеству дорог. Ее клинок — лишь по одной.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481596&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '7503b514-3190-468e-ba01-ed045b9f6714', 'multiverseId': 481596}, 'multiverseid': 481596}, {'name': '剑光封喉', 'text': '放逐目标力量等于或大于4的生物。', 'type': '瞬间', 'flavor': '飘萍走过无数道路，而她的利刃只走一条。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481855&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'fd4bf53f-0079-4f6a-b3b0-f4d59fe630b3', 'multiverseId': 481855}, 'multiverseid': 481855}, {'name': '劍光封喉', 'text': '放逐目標力量等於或大於4的生物。', 'type': '瞬間', 'flavor': '飄萍走過無數道路，而她的利刃只走一條。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482114&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'db898624-30a6-4b9e-b427-589459426567', 'multiverseId': 482114}, 'multiverseid': 482114}]", '[{\'name\': \'Knochengrund-Lauerer\', \'text\': \'Mutation {2}{B/G}{B/G} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\nImmer wenn diese Kreatur mutiert, bringe eine bleibende Karte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Kreatur — Nachtmahr, Bestie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479957&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5dc37fe0-ad74-4282-8ccd-f67f7437df8c\', \'multiverseId\': 479957}, \'multiverseid\': 479957}, {\'name\': \'Acechador del osario\', \'text\': \'Mutación {2}{B/G}{B/G}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\nSiempre que esta criatura mute, regresa la carta de permanente objetivo de tu cementerio a tu mano.\', \'type\': \'Criatura — Bestia pesadilla\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480216&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b4afdde0-1180-4b34-b6f4-dcbbe1b7f751\', \'multiverseId\': 480216}, \'multiverseid\': 480216}, {\'name\': "Guetteur de l\'ossuaire", \'text\': "Mutation {2}{B/G}{B/G} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\nÀ chaque fois que cette créature subit une mutation, renvoyez une carte de permanent ciblée depuis votre cimetière dans votre main.", \'type\': \'Créature : cauchemar et bête\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480475&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dae64a96-5ac1-4404-b655-4306a1f0d827\', \'multiverseId\': 480475}, \'multiverseid\': 480475}, {\'name\': "Predatore dell\'Ossario", \'text\': \'Mutazione {2}{B/G}{B/G} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\nOgniqualvolta questa creatura muta, riprendi in mano una carta permanente bersaglio dal tuo cimitero.\', \'type\': \'Creatura — Bestia Incubo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480734&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9cd845cf-a613-46df-8618-4edb25f7983e\', \'multiverseId\': 480734}, \'multiverseid\': 480734}, {\'name\': \'骨塚潜み\', \'text\': \'変容{2}{B/G}{B/G}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\nこのクリーチャーが変容するたび、あなたの墓地からパーマネント・カード１枚を対象とし、それをあなたの手札に戻す。\', \'type\': \'クリーチャー — ナイトメア・ビースト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480993&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'57576074-432e-45ae-8ee3-d0731a98f6d5\', \'multiverseId\': 480993}, \'multiverseid\': 480993}, {\'name\': \'납골지 잠복꾼\', \'text\': \'돌연변이화 {2}{B/G}{B/G} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n이 생물이 돌연변이화할 때마다, 당신의 무덤에 있는 지속물 카드를 목표로 정한다. 그 카드를 당신의 손으로 되돌린다.\', \'type\': \'생물 — 나이트메어 야수\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481252&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7054d59b-6ce6-439b-9b16-901a7612bd1c\', \'multiverseId\': 481252}, \'multiverseid\': 481252}, {\'name\': \'Espreitador do Ossário\', \'text\': \'Mutação {2}{B/G}{B/G} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\nToda vez que esta criatura sofrer mutação, devolva o card de permanente alvo de seu cemitério para sua mão.\', \'type\': \'Criatura — Pesadelo Besta\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481511&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'32a01141-d5db-43d6-999d-842d8af69174\', \'multiverseId\': 481511}, \'multiverseid\': 481511}, {\'name\': \'Охотник с Могильника\', \'text\': \'Мутация {2}{B/G}{B/G} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\nКаждый раз, когда это существо мутирует, верните целевую карту перманента из вашего кладбища в вашу руку.\', \'type\': \'Существо — Кошмар Зверь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481770&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'334d1944-a56a-42df-b58c-5185f9e09092\', \'multiverseId\': 481770}, \'multiverseid\': 481770}, {\'name\': \'聚骨场蛰兽\', \'text\': \'合变{2}{B/G}{B/G}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n每当此生物合变时，将目标永久物牌从你的坟墓场移回你手上。\', \'type\': \'生物 ～梦魇／野兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482029&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b06ab684-9743-4fb8-b613-2a0bc8f683c1\', \'multiverseId\': 482029}, \'multiverseid\': 482029}, {\'name\': \'聚骨場蟄獸\', \'text\': \'合變{2}{B/G}{B/G}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n每當此生物合變時，將目標永久物牌從你的墳墓場移回你手上。\', \'type\': \'生物 ～夢魘／野獸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482288&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bec858a3-152f-42cd-a03f-6501000fb316\', \'multiverseId\': 482288}, \'multiverseid\': 482288}]', '[{\'name\': \'Kogla der Affentitan\', \'text\': \'Wenn Kogla der Affentitan ins Spiel kommt, kämpft er gegen bis zu eine Kreatur deiner Wahl, die du nicht kontrollierst.\\nImmer wenn Kogla angreift, zerstöre ein Artefakt oder eine Verzauberung deiner Wahl, die der verteidigende Spieler kontrolliert.\\n{1}{G}: Bringe einen Menschen deiner Wahl, den du kontrollierst, auf die Hand seines Besitzers zurück. Kogla erhält Unzerstörbarkeit bis zum Ende des Zuges.\', \'type\': \'Legendäre Kreatur — Menschenaffe\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479941&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7e45798b-8927-4166-9b4d-f7bf40e3bd3f\', \'multiverseId\': 479941}, \'multiverseid\': 479941}, {\'name\': \'Kogla, el Simio Titánico\', \'text\': \'Cuando Kogla, el Simio Titánico entre al campo de batalla, lucha contra hasta una criatura objetivo que no controlas.\\nSiempre que Kogla ataque, destruye el artefacto o encantamiento objetivo que controla el jugador defensor.\\n{1}{G}: Regresa el Humano objetivo que controlas a la mano de su propietario. Kogla gana la habilidad de indestructible hasta el final del turno.\', \'type\': \'Criatura legendaria — Simio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480200&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'976b0d60-218d-402e-9ff8-ace311c16043\', \'multiverseId\': 480200}, \'multiverseid\': 480200}, {\'name\': \'Kogla, le singe titan\', \'text\': "Quand Kogla, le singe titan arrive sur le champ de bataille, il se bat contre jusqu\'à une créature ciblée que vous ne contrôlez pas.\\nÀ chaque fois que Kogla attaque, détruisez un artefact ciblé ou un enchantement ciblé que le joueur défenseur contrôle.\\n{1}{G} : Renvoyez un humain ciblé que vous contrôlez dans la main de son propriétaire. Kogla acquiert l\'indestructible jusqu\'à la fin du tour.", \'type\': \'Créature légendaire : grand singe\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480459&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'aa754702-9607-49c2-9a45-05d1ae8c9c40\', \'multiverseId\': 480459}, \'multiverseid\': 480459}, {\'name\': \'Kogla, il Gorilla Titanico\', \'text\': \'Quando Kogla, il Gorilla Titanico entra nel campo di battaglia, lotta con fino a una creatura bersaglio che non controlli.\\nOgniqualvolta Kogla attacca, distruggi un artefatto o un incantesimo bersaglio controllati dal giocatore in difesa.\\n{1}{G}: Fai tornare un Umano bersaglio che controlli in mano al suo proprietario. Kogla ha indistruttibile fino alla fine del turno.\', \'type\': \'Creatura Leggendaria — Scimpanzé\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480718&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2c902711-d947-4cc9-9ae3-f359d8a9734a\', \'multiverseId\': 480718}, \'multiverseid\': 480718}, {\'name\': \'巨大猿、コグラ\', \'text\': \'巨大猿、コグラが戦場に出たとき、あなたがコントロールしていないクリーチャー最大１体を対象とする。これはそれと格闘を行う。\\n巨大猿、コグラが攻撃するたび、防御プレイヤーがコントロールしている、アーティファクト１つかエンチャント１つを対象とし、それを破壊する。\\n{1}{G}：あなたがコントロールしている人間１体を対象とし、それをオーナーの手札に戻す。ターン終了時まで、巨大猿、コグラは破壊不能を得る。\', \'type\': \'伝説のクリーチャー — 類人猿\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480977&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fc19aa59-9f94-4fcd-8106-e61ba3c75aa0\', \'multiverseId\': 480977}, \'multiverseid\': 480977}, {\'name\': \'거대 유인원, 코글라\', \'text\': \'거대 유인원, 코글라가 전장에 들어올 때, 당신이 조종하지 않는 생물을 최대 한 개까지 목표로 정한다. 거대 유인원, 코글라는 그 생물과 싸운다.\\n코글라가 공격할 때마다, 수비플레이어가 조종하는 마법물체 또는 부여마법을 목표로 정한다. 그 목표를 파괴한다.\\n{1}{G}: 당신이 조종하는 인간을 목표로 정한다. 그 인간을 소유자의 손으로 되돌린다. 코글라는 턴종료까지 무적을 얻는다.\', \'type\': \'전설적 생물 — 유인원\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481236&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1661121e-77a8-4512-a3a5-a8061720b113\', \'multiverseId\': 481236}, \'multiverseid\': 481236}, {\'name\': \'Kogla, o Símio Titânico\', \'text\': \'Quando Kogla, o Símio Titânico, entra no campo de batalha, ele luta com até uma criatura alvo que você não controla.\\nToda vez que Kogla atacar, destrua o artefato ou encantamento alvo que o jogador defensor controla.\\n{1}{G}: Devolva o Humano alvo que você controla para a mão de seu dono. Kogla ganha indestrutível até o final do turno.\', \'type\': \'Criatura Lendária — Símio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481495&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4a4bbf73-c917-4be3-a856-9ecc63512026\', \'multiverseId\': 481495}, \'multiverseid\': 481495}, {\'name\': \'Когла, Исполинская Обезьяна\', \'text\': \'Когда Когла, Исполинская Обезьяна выходит на поле битвы, она дерется не более чем с одним целевым существом не под вашим контролем.\\nКаждый раз, когда Когла атакует, уничтожьте целевой артефакт или чары под контролем защищающегося игрока.\\n{1}{G}: верните целевого Человека под вашим контролем в руку его владельца. Когла получает Неразрушимость до конца хода.\', \'type\': \'Легендарное Существо — Обезьяна\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481754&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7c743f65-1b36-4d1a-b3d7-55e10c46e90a\', \'multiverseId\': 481754}, \'multiverseid\': 481754}, {\'name\': \'庞巨猿猴寇格拉\', \'text\': \'当庞巨猿猴寇格拉进战场时，它与至多一个目标不由你操控的生物互斗。\\n每当寇格拉攻击时，消灭目标由防御牌手操控的神器或结界。\\n{1}{G}：将目标由你操控的人类移回其拥有者手上。寇格拉获得不灭异能直到回合结束。\', \'type\': \'传奇生物 ～猿猴\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482013&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'88042d42-7e1b-4646-8e82-8c769eae42b6\', \'multiverseId\': 482013}, \'multiverseid\': 482013}, {\'name\': \'龐巨猿猴寇格拉\', \'text\': \'當龐巨猿猴寇格拉進戰場時，它與至多一個目標不由你操控的生物互鬥。\\n每當寇格拉攻擊時，消滅目標由防禦玩家操控的神器或結界。\\n{1}{G}：將目標由你操控的人類移回其擁有者手上。寇格拉獲得不滅異能直到回合結束。\', \'type\': \'傳奇生物 ～猿猴\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482272&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9adce156-f7f8-4952-b042-6064651dda23\', \'multiverseId\': 482272}, \'multiverseid\': 482272}]', '[{\'name\': \'Kolossifizierung\', \'text\': \'Verzaubert eine Kreatur\\nWenn die Kolossifizierung ins Spiel kommt, tappe die verzauberte Kreatur.\\nDie verzauberte Kreatur erhält +20/+20.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Es stellte sich heraus, dass der Fall des zerstampften Außenpostens und der Fall des vermissten Kätzchens zusammenhängen."**\\n—Endris, Drannithischer Magistrat\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479927&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3cc482c0-d5b1-41ae-ab98-735e6f13fc16\', \'multiverseId\': 479927}, \'multiverseid\': 479927}, {\'name\': \'Colosificación\', \'text\': \'Encantar criatura.\\nCuando la Colosificación entre al campo de batalla, gira la criatura encantada.\\nLa criatura encantada obtiene +20/+20.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"Resulta que el caso del destacamento aplastado y el del gatito desaparecido *estaban* relacionados".\\n—Endris, magistrada de Drannith\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480186&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ebf64e4d-bfd9-44ff-9135-6865a91bd4e5\', \'multiverseId\': 480186}, \'multiverseid\': 480186}, {\'name\': \'Colossification\', \'text\': \'Enchanter : créature\\nQuand la Colossification arrive sur le champ de bataille, engagez la créature enchantée.\\nLa créature enchantée gagne +20/+20.\', \'type\': \'Enchantement : aura\', \'flavor\': "« En fin de compte, l\'affaire de l\'avant-poste écrasé et celle du chaton perdu *étaient* liées. »\\n—Endris, magistrat de Drannith", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480445&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'63a66888-ec89-457e-b8e5-82b8e642cb9c\', \'multiverseId\': 480445}, \'multiverseid\': 480445}, {\'name\': \'Colossificazione\', \'text\': \'Incanta creatura\\nQuando la Colossificazione entra nel campo di battaglia, TAPpa la creatura incantata.\\nLa creatura incantata prende +20/+20.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"A quanto pare, il caso dell\\\'avamposto demolito e quello del gattino scomparso *erano* collegati."\\n—Endris, magistrato di Drannith\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480704&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9fc95e16-9f05-4bb9-9f5a-a227697fe65b\', \'multiverseId\': 480704}, \'multiverseid\': 480704}, {\'name\': \'著大化\', \'text\': \'エンチャント（クリーチャー）\\n著大化が戦場に出たとき、エンチャントしているクリーチャーをタップする。\\nエンチャントしているクリーチャーは＋20/＋20の修整を受ける。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「どうやら、前哨地平坦化事件と、子猫失踪事件は、実際に関連していたようですね。」**\\n――ドラニスの判事、エンドリス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480963&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'977d84e8-f793-4184-855f-c1240efb11b4\', \'multiverseId\': 480963}, \'multiverseid\': 480963}, {\'name\': \'거상화\', \'text\': \'생물에게 부여\\n거상화가 전장에 들어올 때, 부여된 생물을 탭한다.\\n부여된 생물은 +20/+20을 받는다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'"이제 보니 초소가 납작해진 것과 고양이가 사라진 것이 *연관되어* 있었군."\\n—드라니스 판사, 엔드리스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481222&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'fcacbbde-76cc-4c19-8eeb-75d899625cda\', \'multiverseId\': 481222}, \'multiverseid\': 481222}, {\'name\': \'Colossificação\', \'text\': \'Encantar criatura\\nQuando Colossificação entrar no campo de batalha, vire a criatura encantada.\\nA criatura encantada recebe +20/+20.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"No fim das contas, o caso do posto avançado esmagado e o caso do gatinho desaparecido *estavam* relacionados."\\n— Endris, magistrada de Drannith\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481481&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7fcfedd1-8fd6-4942-97ab-6a28b67751af\', \'multiverseId\': 481481}, \'multiverseid\': 481481}, {\'name\': \'Колоссификация\', \'text\': \'Зачаровать существо\\nКогда Колоссификация выходит на поле битвы, поверните зачарованное существо.\\nЗачарованное существо получает +20/+20.\', \'type\': \'Чары — Аура\', \'flavor\': \'«Выходит, что случай с растоптанной сторожкой и случай с пропавшим котенком *все же были* связаны».\\n— Эндрис, драннитский магистрат\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481740&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'53c0b9ba-7690-44eb-8010-aae005cc6379\', \'multiverseId\': 481740}, \'multiverseid\': 481740}, {\'name\': \'庞硕化\', \'text\': \'结附于生物\\n当庞硕化进战场时，横置所结附的生物。\\n所结附的生物得+20/+20。\', \'type\': \'结界 ～灵气\', \'flavor\': \'「事实证明，哨站被踏平事件与小猫失踪事件之间*确实*有联系。」\\n～卓尼斯官员恩姬丝\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481999&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d9ca574a-23a5-4110-9eb3-c278d22a2213\', \'multiverseId\': 481999}, \'multiverseid\': 481999}, {\'name\': \'龐碩化\', \'text\': \'結附於生物\\n當龐碩化進戰場時，橫置所結附的生物。\\n所結附的生物得+20/+20。\', \'type\': \'結界 ～靈氣\', \'flavor\': \'「事實證明，哨站被踏平事件與小貓失蹤事件之間*確實*有關聯。」\\n～卓尼斯官員恩姬絲\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482258&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'02998f5f-a761-4f29-a31f-2066c65a4544\', \'multiverseId\': 482258}, \'multiverseid\': 482258}]', "[{'name': 'Komischer Vogel', 'text': 'Fliegend\\nUmwandlung {2}{U} ({2}{U}, wirf diese Karte ab: Ziehe eine Karte.)\\nWenn du den Komischen Vogel umwandelst, lege eine Fliegend-Marke auf eine Kreatur deiner Wahl, die du kontrollierst.', 'type': 'Kreatur — Vogel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479821&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e7ef3984-4f38-46ce-a1a2-f03b849ccf69', 'multiverseId': 479821}, 'multiverseid': 479821}, {'name': 'Rareza aviaria', 'text': 'Vuela.\\nCiclo {2}{U}. ({2}{U}, descartar esta carta: Roba una carta.)\\nCuando actives la habilidad de ciclo de la Rareza aviaria, pon un contador de volar sobre la criatura objetivo que controlas.', 'type': 'Criatura — Ave', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480080&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4525d392-8c4d-4a7f-b7cb-86ac59dfe36a', 'multiverseId': 480080}, 'multiverseid': 480080}, {'name': 'Bizarrerie aviaire', 'text': 'Vol\\nRecyclage {2}{U} ({2}{U}, défaussez-vous de cette carte : Piochez une carte.)\\nQuand vous recyclez la Bizarrerie aviaire, mettez un marqueur « vol » sur une créature ciblée que vous contrôlez.', 'type': 'Créature : oiseau', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480339&type=card', 'language': 'French', 'identifiers': {'scryfallId': '47c1bed4-5344-4a89-9f47-a1fb3ebcb639', 'multiverseId': 480339}, 'multiverseid': 480339}, {'name': 'Bizzarria Aviaria', 'text': 'Volare\\nCiclo {2}{U} ({2}{U}, Scarta questa carta: Pesca una carta.)\\nQuando cicli la Bizzarria Aviaria, metti un segnalino volare su una creatura bersaglio che controlli.', 'type': 'Creatura — Uccello', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480598&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b50eb0e4-f06f-4fbb-bb6d-fc6a69ad49be', 'multiverseId': 480598}, 'multiverseid': 480598}, {'name': '奇異鳥', 'text': '飛行\\nサイクリング{2}{U}（{2}{U}, このカードを捨てる：カードを１枚引く。）\\nあなたが奇異鳥をサイクリングしたとき、あなたがコントロールしているクリーチャー１体を対象とし、それの上に飛行カウンターを１個置く。', 'type': 'クリーチャー — 鳥', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480857&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f174644a-bac2-4912-8484-65955f3e9b52', 'multiverseId': 480857}, 'multiverseid': 480857}, {'name': '특이한 새', 'text': '비행\\n순환 {2}{U} ({2}{U}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\\n당신이 특이한 새를 순환할 때, 당신이 조종하는 생물을 목표로 정한다. 그 생물에 비행 카운터를 올려놓는다.', 'type': '생물 — 조류', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481116&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '1d0c1592-b9c5-45b0-adc8-0984aca0dabc', 'multiverseId': 481116}, 'multiverseid': 481116}, {'name': 'Aberração Aviana', 'text': 'Voar\\nReciclar {2}{U} ({2}{U}, descarte este card: Compre um card.)\\nQuando reciclar Aberração Aviana, coloque um marcador de voar na criatura alvo que você controla.', 'type': 'Criatura — Ave', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481375&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3b6de1f8-6359-4554-b8f0-0011b7ffcbda', 'multiverseId': 481375}, 'multiverseid': 481375}, {'name': 'Пернатая Диковина', 'text': 'Полет\\nЦикл {2}{U} ({2}{U}, сбросьте эту карту: возьмите карту.)\\nКогда вы совершаете Цикл Пернатой Диковины, положите один жетон Полета на целевое существо под вашим контролем.', 'type': 'Существо — Птица', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481634&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '50a0faab-9d4c-4628-a223-68216ac7be6d', 'multiverseId': 481634}, 'multiverseid': 481634}, {'name': '怪鸟兽', 'text': '飞行\\n循环{2}{U}（{2}{U}，弃掉此牌：抓一张牌。）\\n当你循环怪鸟兽时，在目标由你操控的生物上放置一个飞行指示物。', 'type': '生物 ～鸟', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481893&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '4369a92c-c8cf-4f7c-855b-072dae3c00dd', 'multiverseId': 481893}, 'multiverseid': 481893}, {'name': '怪鳥獸', 'text': '飛行\\n循環{2}{U}（{2}{U}，棄掉此牌：抽一張牌。）\\n當你循環怪鳥獸時，在目標由你操控的生物上放置一個飛行指示物。', 'type': '生物 ～鳥', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482152&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'd05028b8-32bb-4055-9838-7d5de9c7d836', 'multiverseId': 482152}, 'multiverseid': 482152}]", '[{\'name\': \'Kommando der Nachtwache\', \'text\': \'Wenn das Kommando der Nachtwache ins Spiel kommt und falls du in diesem Zug angegriffen hast, erzeuge einen 1/1 weißen Mensch-Soldat-Kreaturenspielstein.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'„Der große Kerl hört sich hungrig an. Schicken wir ihn ohne sein Abendessen ins Bett."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479877&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c4ec55ed-877a-42e3-a5f7-1d61c5e9e64a\', \'multiverseId\': 479877}, \'multiverseid\': 479877}, {\'name\': \'Comando de la brigada nocturna\', \'text\': \'Cuando el Comando de la brigada nocturna entre al campo de batalla, si atacaste este turno, crea una ficha de criatura Soldado Humano blanca 1/1.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'"El grandote parece hambriento. Mandémoslo a la cama sin cenar".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480136&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'756b4c60-db07-4d30-a48b-a1e929ecb2a5\', \'multiverseId\': 480136}, \'multiverseid\': 480136}, {\'name\': "Commando de l\'escouade nocturne", \'text\': "Quand le Commando de l\'escouade nocturne arrive sur le champ de bataille, si vous avez attaqué ce tour-ci, créez un jeton de créature 1/1 blanche Humain et Soldat.", \'type\': \'Créature : humain et soldat\', \'flavor\': "« La grosse bête a l\'air d\'avoir faim. Envoyons-la au lit sans manger. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480395&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'43c676af-41b4-4129-b775-a777e936d56f\', \'multiverseId\': 480395}, \'multiverseid\': 480395}, {\'name\': \'Commando dello Squadrone Notturno\', \'text\': \'Quando il Commando dello Squadrone Notturno entra nel campo di battaglia, se hai attaccato in questo turno, crea una pedina creatura Soldato Umano 1/1 bianca.\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'"Il ragazzone sembra affamato. Mandiamolo a letto senza cena."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480654&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'79c93a6a-a34c-49b5-bfa6-4a11ffb213cd\', \'multiverseId\': 480654}, \'multiverseid\': 480654}, {\'name\': \'夜勤隊の猛士\', \'text\': \'夜勤隊の猛士が戦場に出たとき、このターンにあなたが攻撃していた場合、白の１/１の人間・兵士・クリーチャー・トークンを１体生成する。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'「この大きいやつは腹が減ってるみたいね。夕食抜きで寝かしてやりましょう。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480913&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'72608678-c584-41a3-8a5b-32b81e746a42\', \'multiverseId\': 480913}, \'multiverseid\': 480913}, {\'name\': \'밤 부대 특공대\', \'text\': \'밤 부대 특공대가 전장에 들어올 때, 당신이 이번 턴에 공격했다면, 1/1 백색 인간 병사 생물 토큰 한 개를 만든다.\', \'type\': \'생물 — 인간 병사\', \'flavor\': \'"덩치 큰 녀석이 배고파하는 것 같군. 저녁은 먹이지 말고 재워 주자고."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481172&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'996dfb1e-8dc5-490f-b296-1e8cfc5e2cc9\', \'multiverseId\': 481172}, \'multiverseid\': 481172}, {\'name\': \'Comando do Esquadrão Noturno\', \'text\': \'Quando Comando do Esquadrão Noturno entrar no campo de batalha, se você atacou neste turno, crie uma ficha de criatura branca 1/1 do tipo Humano Soldado.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': \'"O grandão parece estar com fome. Vamos botá-lo para dormir sem jantar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481431&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ed0687e6-164e-4fa1-a09f-04b14f391da8\', \'multiverseId\': 481431}, \'multiverseid\': 481431}, {\'name\': \'Коммандос Ночного Отряда\', \'text\': \'Когда Коммандос Ночного Отряда выходит на поле битвы, если вы атаковали в этом ходу, создайте одну фишку существа 1/1 белый Человек Солдат.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'«Здоровяк, похоже, голоден. Отправим его в кровать без ужина».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481690&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'301543bf-e7df-47c1-b2af-1abcd5db8e82\', \'multiverseId\': 481690}, \'multiverseid\': 481690}, {\'name\': \'夜班队突击兵\', \'text\': \'当夜班队突击兵进战场时，若你本回合中攻击过，则派出一个1/1白色人类／士兵衍生生物。\', \'type\': \'生物 ～人类／士兵\', \'flavor\': \'「听这大家伙的吼声，它好像是饿了。让我们帮它节省一顿晚饭，早点送它睡觉去吧。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481949&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0ccdc232-94e7-4eef-8d6a-22d3840a42f2\', \'multiverseId\': 481949}, \'multiverseid\': 481949}, {\'name\': \'夜班隊突擊兵\', \'text\': \'當夜班隊突擊兵進戰場時，若你本回合中攻擊過，則派出一個1/1白色人類／士兵衍生生物。\', \'type\': \'生物 ～人類／士兵\', \'flavor\': \'「聽這大傢伙的吼聲，牠好像是餓了。讓我們幫牠節省一頓晚飯，早點送牠睡覺去吧。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482208&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'71f9175e-9001-404f-af8b-a58942096d31\', \'multiverseId\': 482208}, \'multiverseid\': 482208}]', '[{\'name\': \'Koordinierter Ansturm\', \'text\': \'Kreaturen, die du kontrollierst, erhalten +2/+1 bis zum Ende des Zuges.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Spontanzauber\', \'flavor\': \'„Hier draußen wären wir nichts ohne unser Training."\\n—Ethuk, Magier der Kupferjacken\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479785&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a20c94de-8ffe-4ab6-a950-cfed3a2b24e5\', \'multiverseId\': 479785}, \'multiverseid\': 479785}, {\'name\': \'Ataque coordinado\', \'text\': \'Las criaturas que controlas obtienen +2/+1 hasta el final del turno.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Instantáneo\', \'flavor\': \'"Aquí dependemos totalmente de nuestro entrenamiento".\\n—Ethuk, mago de las Capas de Cobre\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480044&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ab4f6e38-a07d-44d5-978e-401311d6107e\', \'multiverseId\': 480044}, \'multiverseid\': 480044}, {\'name\': \'Charge coordonnée\', \'text\': "Les créatures que vous contrôlez gagnent +2/+1 jusqu\'à la fin du tour.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Éphémère\', \'flavor\': "« Notre armure, c\'est notre entraînement. »\\n—Ethuk, mage des Capes de cuivre", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480303&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cc69966d-1b5d-4263-a568-e8533912b734\', \'multiverseId\': 480303}, \'multiverseid\': 480303}, {\'name\': \'Carica Coordinata\', \'text\': \'Le creature che controlli prendono +2/+1 fino alla fine del turno.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Istantaneo\', \'flavor\': \'"Qui fuori conta solo il nostro addestramento."\\n—Ethuk, mago delle Giubbe Ramate\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480562&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fc30fe68-1dcc-45e4-98f5-5060a6a75c59\', \'multiverseId\': 480562}, \'multiverseid\': 480562}, {\'name\': \'揃った突撃\', \'text\': \'ターン終了時まで、あなたがコントロールしているクリーチャーは＋２/＋１の修整を受ける。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'インスタント\', \'flavor\': \'「ここではこれまでの訓練がすべてだ。」\\n――銅纏いの魔道士、エスク\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480821&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'63198061-61d6-40c9-b2ae-5fd29f93a5e5\', \'multiverseId\': 480821}, \'multiverseid\': 480821}, {\'name\': \'연합 돌격\', \'text\': \'당신이 조종하는 생물들은 턴종료까지 +2/+1을 받는다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'순간마법\', \'flavor\': \'"여기선 오직 훈련한 대로만 해야 해."\\n—구리 코트 마도사, 이투크\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481080&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5dc56cde-51dd-454a-a531-c5d78c988a26\', \'multiverseId\': 481080}, \'multiverseid\': 481080}, {\'name\': \'Carga Coordenada\', \'text\': \'As criaturas que você controla recebem +2/+1 até o final do turno.\\nReciclar {2} ({2}, descarte este card: Compre um card.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Aqui fora somos o que nosso treinamento nos fez e nada mais."\\n— Ethuk, mago Gibão de Cobre\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481339&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b3826b2e-692f-4301-bc20-418f0f763ceb\', \'multiverseId\': 481339}, \'multiverseid\': 481339}, {\'name\': \'Скоординированная Атака\', \'text\': \'Существа под вашим контролем получают +2/+1 до конца хода.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Здесь, в этих краях, мы — это наша подготовка».\\n— Этук, маг Медных Кителей\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481598&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7163657a-a762-48eb-bf90-85a0d94937db\', \'multiverseId\': 481598}, \'multiverseid\': 481598}, {\'name\': \'协同冲锋\', \'text\': \'由你操控的生物得+2/+1直到回合结束。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'瞬间\', \'flavor\': \'「行军在外，唯有训练成果靠得住。」\\n～紫铜军法师埃撒克\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481857&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'764ded18-f150-4225-9164-a0b54b4393f0\', \'multiverseId\': 481857}, \'multiverseid\': 481857}, {\'name\': \'協同衝鋒\', \'text\': \'由你操控的生物得+2/+1直到回合結束。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'瞬間\', \'flavor\': \'「行軍在外，唯有訓練成果靠得住。」\\n～紫銅軍法師埃撒克\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482116&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ad6dc00b-e9b0-491e-9c2e-bd112353ee25\', \'multiverseId\': 482116}, \'multiverseid\': 482116}]', "[{'name': 'Kragenschreck-Mentorin', 'text': 'Wenn die Kragenschreck-Mentorin ins Spiel kommt, lege eine Bedrohlich-Marke auf eine Nicht-Mensch-Kreatur deiner Wahl, die du kontrollierst. (Sie kann nicht geblockt werden, außer von zwei oder mehr Kreaturen.)\\n{2}{R}, {T}: Lege auf jede Kreatur mit Bedrohlichkeit, die du kontrollierst, eine +1/+1- Marke.', 'type': 'Kreatur — Mensch, Krieger', 'flavor': 'Das Glück begünstigt die Unbarmherzigen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479900&type=card', 'language': 'German', 'identifiers': {'scryfallId': '9aa3f96f-8ba6-45d1-ae6d-25ab237cf4d2', 'multiverseId': 479900}, 'multiverseid': 479900}, {'name': 'Mentora de creaespantos', 'text': 'Cuando la Mentora de creaespantos entre al campo de batalla, pon un contador de amenaza sobre la criatura objetivo que no sea Humano que controlas. (No puede ser bloqueada excepto por dos o más criaturas.)\\n{2}{R}, {T}: Pon un contador +1/+1 sobre cada criatura que controlas con la habilidad de amenaza.', 'type': 'Criatura — Guerrero humano', 'flavor': 'La suerte favorece a los feroces.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480159&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4dc5d9b9-1aca-4317-9dbb-db95275a70f1', 'multiverseId': 480159}, 'multiverseid': 480159}, {'name': 'Mentor épouvanteuse', 'text': 'Quand la Mentor épouvanteuse arrive sur le champ de bataille, mettez un marqueur « menace » sur une créature non-Humain ciblée que vous contrôlez. (Elle ne peut pas être bloquée excepté par deux créatures ou plus.)\\n{2}{R}, {T} : Mettez un marqueur +1/+1 sur chaque créature avec la menace que vous contrôlez.', 'type': 'Créature : humain et guerrier', 'flavor': 'La chance sourit aux plus féroces.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480418&type=card', 'language': 'French', 'identifiers': {'scryfallId': '58e7caf0-e6bd-406f-b9b0-2ef507201a3d', 'multiverseId': 480418}, 'multiverseid': 480418}, {'name': 'Mentore dal Collarino Spaventoso', 'text': 'Quando la Mentore dal Collarino Spaventoso entra nel campo di battaglia, metti un segnalino minacciare su una creatura non Umano bersaglio che controlli. (Non può essere bloccata tranne che da due o più creature.)\\n{2}{R}, {T}: Metti un segnalino +1/+1 su ogni creatura con minacciare che controlli.', 'type': 'Creatura — Guerriero Umano', 'flavor': 'La fortuna aiuta i feroci.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480677&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '836e4894-9aba-4709-ac8a-be206edf7b44', 'multiverseId': 480677}, 'multiverseid': 480677}, {'name': '襟脅しの導師', 'text': '襟脅しの導師が戦場に出たとき、あなたがコントロールしていて人間でないクリーチャー１体を対象とし、それの上に威迫カウンターを１個置く。（それは２体以上のクリーチャーによってしかブロックされない。）\\n{2}{R}, {T}：あなたがコントロールしていて威迫を持つ各クリーチャーの上に＋１/＋１カウンターをそれぞれ１個置く。', 'type': 'クリーチャー — 人間・戦士', 'flavor': '幸運は獰猛な者に味方する。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480936&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'eba4c9bf-4a88-4bca-a73e-567f93ae1a47', 'multiverseId': 480936}, 'multiverseid': 480936}, {'name': '주름공포 스승', 'text': '주름공포 스승이 전장에 들어올 때, 당신이 조종하는 인간이 아닌 생물을 목표로 정한다. 그 생물에 호전적 카운터를 올려놓는다. (그 생물은 두 개 이상의 생물에만 방어될 수 있다.)\\n{2}{R}, {T}: 당신이 조종하는 호전적을 가진 각 생물에 +1/+1 카운터 한 개를 올려놓는다.', 'type': '생물 — 인간 전사', 'flavor': '행운은 흉포한 자들의 편이다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481195&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'e36a209c-1e47-4aec-a93a-81d290c1d725', 'multiverseId': 481195}, 'multiverseid': 481195}, {'name': 'Mentora da Gola do Pavor', 'text': 'Quando Mentora da Gola do Pavor entrar no campo de batalha, coloque um marcador de ameaçar na criatura alvo que você controla que não seja um Humano. (Ela só pode ser bloqueada por duas ou mais criaturas.)\\n{2}{R}, {T}: Coloque um marcador +1/+1 em cada criatura que você controla com ameaçar.', 'type': 'Criatura — Humano Guerreiro', 'flavor': 'A sorte favorece os ferozes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481454&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0214ef8f-3b0c-446b-8306-ba5065926af4', 'multiverseId': 481454}, 'multiverseid': 481454}, {'name': 'Наставница Гребня Страха', 'text': 'Когда Наставница Гребня Страха выходит на поле битвы, положите один жетон Угрозы на целевое не являющееся Человеком существо под вашим контролем. (Оно не может быть заблокировано менее чем двумя существами.)\\n{2}{R}, {T}: положите один жетон +1/+1 на каждое существо с Угрозой под вашим контролем.', 'type': 'Существо — Человек Воин', 'flavor': 'Фортуна любит свирепых.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481713&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'c0801e6a-e9b2-4c65-a716-c58b448d178a', 'multiverseId': 481713}, 'multiverseid': 481713}, {'name': '威棱明师', 'text': '当威棱明师进战场时，在目标由你操控的非人类生物上放置一个威慑指示物。（它只能被两个或更多生物阻挡。）\\n{2}{R}，{T}：在每个由你操控且具威慑异能的生物上各放置一个+1/+1指示物。', 'type': '生物 ～人类／战士', 'flavor': '命运眷顾猛者。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481972&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '83597578-066f-49aa-bf8e-f363298f8f04', 'multiverseId': 481972}, 'multiverseid': 481972}, {'name': '威稜明師', 'text': '當威稜明師進戰場時，在目標由你操控的非人類生物上放置一個威懾指示物。（它只能被兩個或更多生物阻擋。）\\n{2}{R}，{T}：在每個由你操控且具威懾異能的生物上各放置一個+1/+1指示物。', 'type': '生物 ～人類／戰士', 'flavor': '命運眷顧猛者。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482231&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '3d64e871-e768-4d70-9326-df0dfb4551c6', 'multiverseId': 482231}, 'multiverseid': 482231}]", '[{\'name\': \'Kristalliner Riese\', \'text\': \'Zu Beginn des Kampfes in deinem Zug bestimmst du per Zufall eine der folgenden Sorten von Marken, die der Kristalline Riese noch nicht auf sich liegen hat, nämlich Fliegend, Erstschlag, Todesberührung, Fluchsicher, Lebensverknüpfung, Bedrohlich, Reichweite, Trampelschaden, Wachsamkeit oder +1/+1. Lege eine Marke der bestimmten Sorte auf den Kristallinen Riesen.\', \'type\': \'Artefaktkreatur — Riese\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480013&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b0aea9b6-aee5-42ee-b144-887f93eb6b2b\', \'multiverseId\': 480013}, \'multiverseid\': 480013}, {\'name\': \'Gigante de cristal\', \'text\': \'Al comienzo del combate en tu turno, elige un tipo de contador al azar que el Gigante de cristal no tenga sobre él de entre volar, dañar primero, toque mortal, antimaleficio, vínculo vital, amenaza, alcance, arrollar, vigilancia y +1/+1. Pon un contador de ese tipo sobre el Gigante de cristal.\', \'type\': \'Criatura artefacto — Gigante\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480272&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b3ce8061-4128-4645-a67a-580f256083b8\', \'multiverseId\': 480272}, \'multiverseid\': 480272}, {\'name\': \'Géant cristallin\', \'text\': "Au début du combat pendant votre tour, choisissez au hasard une sorte de marqueur que le Géant cristallin n\'a pas sur lui parmi « vol », « initiative », « contact mortel », « défense talismanique », « lien de vie », « menace », « portée », « piétinement », « vigilance », et +1/+1. Mettez un marqueur de cette sorte sur le Géant cristallin.", \'type\': \'Créature-artefact : géant\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480531&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8d616e85-2a21-48bb-aa7c-32cd336cfe48\', \'multiverseId\': 480531}, \'multiverseid\': 480531}, {\'name\': \'Gigante Cristallino\', \'text\': "All\'inizio del combattimento nel tuo turno, scegli un tipo di segnalino a caso che il Gigante Cristallino non possiede tra volare, attacco improvviso, tocco letale, anti-malocchio, legame vitale, minacciare, raggiungere, travolgere, cautela e +1/+1. Metti un segnalino di quel tipo sul Gigante Cristallino.", \'type\': \'Creatura Artefatto — Gigante\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480790&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'172af778-12d3-481c-a003-4bf0ecb79920\', \'multiverseId\': 480790}, \'multiverseid\': 480790}, {\'name\': \'結晶の巨人\', \'text\': \'あなたのターンの戦闘の開始時に、飛行、先制攻撃、接死、呪禁、絆魂、威迫、到達、トランプル、警戒、＋１/＋１の中から、結晶の巨人の上に置かれていないカウンター１種類を無作為に選ぶ。結晶の巨人の上に、その種類のカウンターを１個置く。\', \'type\': \'アーティファクト・クリーチャー — 巨人\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481049&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'283c0214-38e6-48e6-a3f5-823aefab1d6d\', \'multiverseId\': 481049}, \'multiverseid\': 481049}, {\'name\': \'수정 거인\', \'text\': \'당신의 턴 전투 시작에, 비행, 선제공격, 치명타, 방호, 생명연결, 호전적, 대공, 돌진, 경계, +1/+1 카운터 중 수정 거인에 놓여져 있지 않은 카운터 한 종류를 무작위로 선택한다. 선택된 종류의 카운터 한 개를 수정 거인에 올려놓는다.\', \'type\': \'마법물체 생물 — 거인\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481308&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5b1a5678-1f1c-4be9-b511-34121ad487fa\', \'multiverseId\': 481308}, \'multiverseid\': 481308}, {\'name\': \'Gigante Cristalino\', \'text\': \'No início do combate no seu turno, escolha aleatoriamente um tipo de marcador que Gigante Cristalino não tenha entre voar, iniciativa, toque mortífero, resistência a magia, vínculo com a vida, ameaçar, alcance, atropelar, vigilância e +1/+1. Coloque um marcador daquele tipo em Gigante Cristalino.\', \'type\': \'Criatura Artefato — Gigante\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481567&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a31a9a20-b762-4e62-89f9-3cd28fa60b5c\', \'multiverseId\': 481567}, \'multiverseid\': 481567}, {\'name\': \'Кристальный Гигант\', \'text\': \'В начале боя во время вашего хода выберите случайным образом тип жетона, которого нет на Кристальном Гиганте, из следующих: Бдительность, Захват, Первый удар, Полет, Порчеустойчивость, Пробивной удар, Смертельное касание, Угроза, Цепь жизни и +1/+1. Положите один жетон такого типа на Кристального Гиганта.\', \'type\': \'Артефакт Существо — Гигант\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481826&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'92294aa1-6e31-45e4-80fa-30bc1c39e0a3\', \'multiverseId\': 481826}, \'multiverseid\': 481826}, {\'name\': \'晶澈巨人\', \'text\': \'在你回合的战斗开始时，从飞行、先攻、死触、辟邪、系命、威慑、延势、践踏、警戒和+1/+1等十种指示物内晶澈巨人上面尚不具有者中随机选择一种。在晶澈巨人上放置一个该种指示物。\', \'type\': \'神器生物 ～巨人\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482085&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'49fe17fa-90d3-4d32-9b5e-a51cc72bf5dc\', \'multiverseId\': 482085}, \'multiverseid\': 482085}, {\'name\': \'晶澈巨人\', \'text\': \'在你回合的戰鬥開始時，從飛行、先攻、死觸、辟邪、繫命、威懾、延勢、踐踏、警戒和+1/+1等十種指示物內晶澈巨人上面尚不具有者中隨機選擇一種。在晶澈巨人上放置一個該種指示物。\', \'type\': \'神器生物 ～巨人\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482344&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7da47715-a6b9-49ee-84c6-2185d7aa05b3\', \'multiverseId\': 482344}, \'multiverseid\': 482344}]', "[{'name': 'Kristallkrabbe', 'text': 'Aufblitzen', 'type': 'Kreatur — Krabbe', 'flavor': 'Sie liebt es, mit ihrer Umgebung zu verschmelzen, Beute zu überraschen und am Strand umherzukrabbeln.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479825&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c13dd2af-277b-4ab5-b70f-bbe9d9b7b3ec', 'multiverseId': 479825}, 'multiverseid': 479825}, {'name': 'Cristáceo', 'text': 'Destello.', 'type': 'Criatura — Cangrejo', 'flavor': 'Le encanta mezclarse con su entorno, emboscar a sus presas y dar largas carreras por la playa.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480084&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4d221ed5-2e25-43c2-a286-817d6fe05849', 'multiverseId': 480084}, 'multiverseid': 480084}, {'name': 'Cristacé', 'text': 'Flash', 'type': 'Créature : crabe', 'flavor': 'Il aime se fondre dans son milieu, piéger ses proies, et marcher sur la plage.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480343&type=card', 'language': 'French', 'identifiers': {'scryfallId': '6d88ddce-7874-4d93-89ea-cbb8a09c8b48', 'multiverseId': 480343}, 'multiverseid': 480343}, {'name': 'Cristallaceo', 'text': 'Lampo', 'type': 'Creatura — Granchio', 'flavor': 'Adora mimetizzarsi nel suo ambiente, tendere agguati alle prede e fare lunghe passeggiate laterali sulla spiaggia.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480602&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'af078f22-96df-4d4f-9494-90b5d8da8572', 'multiverseId': 480602}, 'multiverseid': 480602}, {'name': '晶殻ガニ', 'text': '瞬速', 'type': 'クリーチャー — カニ', 'flavor': '周囲に溶け込み、獲物を待ち伏せ、浜辺を駆け回ることを好む。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480861&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'cb52ea02-c73d-425d-97fc-ee0181296e57', 'multiverseId': 480861}, 'multiverseid': 480861}, {'name': '수정게', 'text': '섬광', 'type': '생물 — 게', 'flavor': '그것은 환경에 숨어들어 먹잇감을 덮치는 것을, 그리고 해변에서 종종걸음을 걷는 것을 좋아한다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481120&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'f7d50571-73f4-4b66-bcbd-9c6c92c0ee46', 'multiverseId': 481120}, 'multiverseid': 481120}, {'name': 'Cristáceo', 'text': 'Lampejo', 'type': 'Criatura — Caranguejo', 'flavor': 'Ele adora se mesclar ao ambiente, emboscar presas e sair para caranguejar na praia.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481379&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9de829f6-c6da-4d08-856d-d9ab012d7c11', 'multiverseId': 481379}, 'multiverseid': 481379}, {'name': 'Кристакраб', 'text': 'Миг', 'type': 'Существо — Краб', 'flavor': 'Он любит сливаться с окружением, нападать из засады и совершать долгие прогулки по берегу.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481638&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '22b58aa2-e04d-4ea3-9721-e2a66352735b', 'multiverseId': 481638}, 'multiverseid': 481638}, {'name': '庞巨晶蟹', 'text': '闪现', 'type': '生物 ～蟹', 'flavor': '它喜欢融入环境，突袭猎物，疾步沙滩。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481897&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '850b3b3f-0766-456c-8836-0cb8c013be3e', 'multiverseId': 481897}, 'multiverseid': 481897}, {'name': '龐巨晶蟹', 'text': '閃現', 'type': '生物 ～蟹', 'flavor': '牠喜歡融入環境，突襲獵物，疾步沙灘。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482156&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '9a566bf3-f8d1-47d2-9a68-7fd3bde0b96e', 'multiverseId': 482156}, 'multiverseid': 482156}]", '[{\'name\': \'Kristallreißer\', \'text\': \'Mutation {1}{G}{G} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\nReichweite, verursacht Trampelschaden\\nImmer wenn diese Kreatur mutiert, zerstöre ein Artefakt oder eine Verzauberung deiner Wahl, das bzw. die ein Gegner kontrolliert.\', \'type\': \'Kreatur — Bestie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479934&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b64b9c62-c384-4c7c-8ef8-99521f92f0f8\', \'multiverseId\': 479934}, \'multiverseid\': 479934}, {\'name\': \'Destruyegemas\', \'text\': \'Mutación {1}{G}{G}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\nAlcance, arrolla.\\nSiempre que esta criatura mute, destruye el artefacto o encantamiento objetivo que controla un oponente.\', \'type\': \'Criatura — Bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480193&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fe5fa51b-4591-4e9b-b580-5a5f7847da81\', \'multiverseId\': 480193}, \'multiverseid\': 480193}, {\'name\': \'Terrasseur de gemmes\', \'text\': "Mutation {1}{G}{G} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\nPortée, piétinement\\nÀ chaque fois que cette créature subit une mutation, détruisez l\'artefact ou l\'enchantement ciblé qu\'un adversaire contrôle.", \'type\': \'Créature : bête\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480452&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8952c767-1315-4634-b4b4-7a0533ec4018\', \'multiverseId\': 480452}, \'multiverseid\': 480452}, {\'name\': \'Spezzagemme\', \'text\': \'Mutazione {1}{G}{G} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\nRaggiungere, travolgere\\nOgniqualvolta questa creatura muta, distruggi un artefatto o un incantesimo bersaglio controllato da un avversario.\', \'type\': \'Creatura — Bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480711&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'52331162-63be-42b6-b280-b23f37f34d0a\', \'multiverseId\': 480711}, \'multiverseid\': 480711}, {\'name\': \'水晶壊し\', \'text\': \'変容{1}{G}{G}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\n到達、トランプル\\nこのクリーチャーが変容するたび、対戦相手がコントロールしている、アーティファクト１つかエンチャント１つを対象とし、それを破壊する。\', \'type\': \'クリーチャー — ビースト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480970&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'49baff35-a7c2-4154-9de1-d06e2728cbf9\', \'multiverseId\': 480970}, \'multiverseid\': 480970}, {\'name\': \'보석파괴자\', \'text\': \'돌연변이화 {1}{G}{G} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n대공, 돌진\\n이 생물이 돌연변이화할 때마다, 상대가 조종하는 마법물체 또는 부여마법을 목표로 정한다. 그 목표를 파괴한다.\', \'type\': \'생물 — 야수\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481229&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8e99573f-1a5b-4281-a4fb-7746e04a31cf\', \'multiverseId\': 481229}, \'multiverseid\': 481229}, {\'name\': \'Destruidor de Gemas\', \'text\': \'Mutação {1}{G}{G} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\nAlcance, atropelar\\nToda vez que esta criatura sofrer mutação, destrua o artefato ou encantamento alvo que um oponente controla.\', \'type\': \'Criatura — Besta\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481488&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d817600d-4f98-4077-ac51-0b8667565d96\', \'multiverseId\': 481488}, \'multiverseid\': 481488}, {\'name\': \'Истребитель Самоцветов\', \'text\': \'Мутация {1}{G}{G} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\nЗахват, Пробивной удар\\nКаждый раз, когда это существо мутирует, уничтожьте целевой артефакт или чары под контролем оппонента.\', \'type\': \'Существо — Зверь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481747&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'750fa88d-0ed6-423c-87b4-949384d979d2\', \'multiverseId\': 481747}, \'multiverseid\': 481747}, {\'name\': \'碎晶狂兽\', \'text\': \'合变{1}{G}{G}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n延势，践踏\\n每当此生物合变时，消灭目标由对手操控的神器或结界。\', \'type\': \'生物 ～野兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482006&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f85d453e-b4de-4ec4-a36e-83620c95e01d\', \'multiverseId\': 482006}, \'multiverseid\': 482006}, {\'name\': \'碎晶狂獸\', \'text\': \'合變{1}{G}{G}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n延勢，踐踏\\n每當此生物合變時，消滅目標由對手操控的神器或結界。\', \'type\': \'生物 ～野獸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482265&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'71726d4a-4127-4e59-b1f0-0421f6b86e37\', \'multiverseId\': 482265}, \'multiverseid\': 482265}]', '[{\'name\': \'Kristallreißer\', \'text\': \'Mutation {1}{G}{G}\\nReichweite, verursacht Trampelschaden\\nImmer wenn diese Kreatur mutiert, zerstöre ein Artefakt oder eine Verzauberung deiner Wahl, das bzw. die ein Gegner kontrolliert.\', \'type\': \'Kreatur — Bestie\', \'flavor\': \'Anguirus, gepanzerter Killer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482389&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ec6b205d-3167-474c-9765-351795676926\', \'multiverseId\': 482389}, \'multiverseid\': 482389}, {\'name\': \'Destruyegemas\', \'text\': \'Mutación {1}{G}{G}.\\nAlcance, arrolla.\\nSiempre que esta criatura mute, destruye el artefacto o encantamiento objetivo que controla un oponente.\', \'type\': \'Criatura — Bestia\', \'flavor\': \'Anguirus, asesino de armadura\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482403&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2e832f89-2490-4416-aa38-16e6734f18f1\', \'multiverseId\': 482403}, \'multiverseid\': 482403}, {\'name\': \'Terrasseur de gemmes\', \'text\': "Mutation {1}{G}{G}\\nPortée, piétinement\\nÀ chaque fois que cette créature subit une mutation, détruisez l\'artefact ou l\'enchantement ciblé qu\'un adversaire contrôle.", \'type\': \'Créature : bête\', \'flavor\': \'Anguirus, tueur cuirassé\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482417&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6794b7d9-715d-4f51-8b20-c80b813baecb\', \'multiverseId\': 482417}, \'multiverseid\': 482417}, {\'name\': \'Spezzagemme\', \'text\': \'Mutazione {1}{G}{G}\\nRaggiungere, travolgere\\nOgniqualvolta questa creatura muta, distruggi un artefatto o un incantesimo bersaglio controllato da un avversario.\', \'type\': \'Creatura — Bestia\', \'flavor\': \'Angilas, Assassino Corazzato\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482431&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'47473fe3-c3a6-4b3a-bd03-d622cef86fa1\', \'multiverseId\': 482431}, \'multiverseid\': 482431}, {\'name\': \'水晶壊し\', \'text\': \'変容{1}{G}{G}\\n到達、トランプル\\nこのクリーチャーが変容するたび、対戦相手がコントロールしている、アーティファクト１つかエンチャント１つを対象とし、それを破壊する。\', \'type\': \'クリーチャー — ビースト\', \'flavor\': \'装（そう）甲（こう）暴（ぼう）龍（りゅう）、アンギラス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482445&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'16f794f0-012d-48ae-a764-61d30054a212\', \'multiverseId\': 482445}, \'multiverseid\': 482445}, {\'name\': \'보석파괴자\', \'text\': \'돌연변이화 {1}{G}{G}\\n대공, 돌진\\n이 생물이 돌연변이화할 때마다, 상대가 조종하는 마법물체 또는 부여마법을 목표로 정한다. 그 목표를 파괴한다.\', \'type\': \'생물 — 야수\', \'flavor\': \'장갑을 두른 살해자, 안기라스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482459&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8c7f48f3-1e8d-4e1c-afba-6c99b74e6cfe\', \'multiverseId\': 482459}, \'multiverseid\': 482459}, {\'name\': \'Destruidor de Gemas\', \'text\': \'Mutação {1}{G}{G}\\nAlcance, atropelar\\nToda vez que esta criatura sofrer mutação, destrua o artefato ou encantamento alvo que um oponente controla.\', \'type\': \'Criatura — Besta\', \'flavor\': \'Anguirus, Matador Blindado\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482473&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b3d3443b-8448-43de-9ebe-0bbc4fadbedb\', \'multiverseId\': 482473}, \'multiverseid\': 482473}, {\'name\': \'Истребитель Самоцветов\', \'text\': \'Мутация {1}{G}{G}\\nЗахват, Пробивной удар\\nКаждый раз, когда это существо мутирует, уничтожьте целевой артефакт или чары под контролем оппонента.\', \'type\': \'Существо — Зверь\', \'flavor\': \'Ангирус, Бронированный Убийца\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482487&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0a79f234-e229-4ad2-bc02-add2ab54297c\', \'multiverseId\': 482487}, \'multiverseid\': 482487}, {\'name\': \'碎晶狂兽\', \'text\': \'合变{1}{G}{G}\\n延势，践踏\\n每当此生物合变时，消灭目标由对手操控的神器或结界。\', \'type\': \'生物 ～野兽\', \'flavor\': \'披甲杀兽安吉拉斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482501&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6fdd22ec-dc41-49d9-825e-c7eec2a8efff\', \'multiverseId\': 482501}, \'multiverseid\': 482501}, {\'name\': \'碎晶狂獸\', \'text\': \'合變{1}{G}{G}\\n延勢，踐踏\\n每當此生物合變時，消滅目標由對手操控的神器或結界。\', \'type\': \'生物 ～野獸\', \'flavor\': \'披甲殺獸安基拉斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482515&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9ff474be-2b39-45f8-8211-5d01bdbc93e4\', \'multiverseId\': 482515}, \'multiverseid\': 482515}]', '[{\'name\': \'Labyrinth-Raptor\', \'text\': \'Bedrohlich\\nImmer wenn eine Kreatur mit Bedrohlichkeit, die du kontrollierst, geblockt wird, opfert der verteidigende Spieler eine Kreatur, die sie blockt.\\n{B}{R}: Kreaturen mit Bedrohlichkeit, die du kontrollierst, erhalten +1/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Nachtmahr, Dinosaurier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479972&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'54d796be-91fd-4e6c-a1ff-8e893afeae79\', \'multiverseId\': 479972}, \'multiverseid\': 479972}, {\'name\': \'Ráptor del laberinto\', \'text\': \'Amenaza.\\nSiempre que una criatura que controlas con la habilidad de amenaza sea bloqueada, el jugador defensor sacrifica una criatura que la bloquea.\\n{B}{R}: Las criaturas que controlas con la habilidad de amenaza obtienen +1/+0 hasta el final del turno.\', \'type\': \'Criatura — Dinosaurio pesadilla\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480231&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2fe68175-1228-4192-8ff1-27902819c5a4\', \'multiverseId\': 480231}, \'multiverseid\': 480231}, {\'name\': \'Raptor du labyrinthe\', \'text\': "Menace\\nÀ chaque fois qu\'une créature avec la menace que vous contrôlez devient bloquée, le joueur défenseur sacrifie une créature qui la bloque.\\n{B}{R} : Les créatures avec la menace que vous contrôlez gagnent +1/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : cauchemar et dinosaure\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480490&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'58e1b563-c092-4f22-b7eb-8af5a5dcefc8\', \'multiverseId\': 480490}, \'multiverseid\': 480490}, {\'name\': \'Raptor del Labirinto\', \'text\': \'Minacciare\\nOgniqualvolta una creatura con minacciare che controlli viene bloccata, il giocatore in difesa sacrifica una creatura che la sta bloccando.\\n{B}{R}: Le creature con minacciare che controlli prendono +1/+0 fino alla fine del turno.\', \'type\': \'Creatura — Dinosauro Incubo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480749&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'758f7fc0-1213-41b3-99e0-14b83565d22e\', \'multiverseId\': 480749}, \'multiverseid\': 480749}, {\'name\': \'迷宮の猛竜\', \'text\': \'威迫\\nあなたがコントロールしていて威迫を持つクリーチャーが１体ブロックされた状態になるたび、防御プレイヤーはそれをブロックしているクリーチャー１体を生け贄に捧げる。\\n{B}{R}：ターン終了時まで、あなたがコントロールしていて威迫を持つクリーチャーは＋１/＋０の修整を受ける。\', \'type\': \'クリーチャー — ナイトメア・恐竜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481008&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f63aa09b-4088-4032-974a-d211afa20b01\', \'multiverseId\': 481008}, \'multiverseid\': 481008}, {\'name\': \'미궁 랩터\', \'text\': \'호전적\\n당신이 조종하는 호전적을 가진 생물이 방어될 때마다, 수비플레이어는 그 생물을 방어 중인 생물 한 개를 희생한다.\\n{B}{R}: 당신이 조종하는 호전적을 가진 생물들은 턴종료까지 +1/+0을 받는다.\', \'type\': \'생물 — 나이트메어 공룡\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481267&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d5aef8f7-fa4a-4f81-bd11-fed203fd3d22\', \'multiverseId\': 481267}, \'multiverseid\': 481267}, {\'name\': \'Raptor do Labirinto\', \'text\': \'Ameaçar\\nToda vez que uma criatura que você controla com ameaçar se torna bloqueada, o jogador defensor sacrifica uma criatura que a esteja bloqueando.\\n{B}{R}: As criaturas que você controla com ameaçar recebem +1/+0 até o final do turno.\', \'type\': \'Criatura — Pesadelo Dinossauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481526&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d001fea7-d73a-456c-a30d-169c5b9f1aba\', \'multiverseId\': 481526}, \'multiverseid\': 481526}, {\'name\': \'Раптор Лабиринта\', \'text\': \'Угроза\\nКаждый раз, когда существо с Угрозой под вашим контролем становится заблокированным, защищающийся игрок жертвует одно блокирующее его существо.\\n{B}{R}: существа с Угрозой под вашим контролем получают +1/+0 до конца хода.\', \'type\': \'Существо — Кошмар Динозавр\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481785&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f4b2d7f8-9d79-4ef1-b154-18ff465bbadc\', \'multiverseId\': 481785}, \'multiverseid\': 481785}, {\'name\': \'迷宫迅猛龙\', \'text\': \'威慑\\n每当一个由你操控且具威慑异能的生物被阻挡时，防御牌手牺牲一个阻挡它的生物。\\n{B}{R}：由你操控且具威慑异能的生物得+1/+0直到回合结束。\', \'type\': \'生物 ～梦魇／恐龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482044&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'93c5bf04-415a-46a1-a600-ed828aef8889\', \'multiverseId\': 482044}, \'multiverseid\': 482044}, {\'name\': \'迷宮迅猛龍\', \'text\': \'威懾\\n每當一個由你操控且具威懾異能的生物被阻擋時，防禦玩家犧牲一個阻擋它的生物。\\n{B}{R}：由你操控且具威懾異能的生物得+1/+0直到回合結束。\', \'type\': \'生物 ～夢魘／恐龍\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482303&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7a8e3087-620d-4aca-bfff-439903856783\', \'multiverseId\': 482303}, \'multiverseid\': 482303}]', '[{\'name\': \'Lauernde Präzisionsschützin\', \'text\': \'Aufblitzen\\nWenn die Lauernde Präzisionsschützin ins Spiel kommt, zerstöre eine Kreatur deiner Wahl, der in diesem Zug bereits Schaden zugefügt wurde.\', \'type\': \'Kreatur — Mensch, Assassine\', \'flavor\': \'„Kein Gebrüll ist so mächtig, dass es nicht zum Schweigen gebracht werden kann."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479873&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c6d20b21-012e-4b30-99a7-f9f26b271ff9\', \'multiverseId\': 479873}, \'multiverseid\': 479873}, {\'name\': \'Acechadora certera\', \'text\': \'Destello.\\nCuando la Acechadora certera entre al campo de batalla, destruye la criatura objetivo que haya recibido daño este turno.\', \'type\': \'Criatura — Asesino humano\', \'flavor\': \'"No hay rugido tan poderoso que no se pueda silenciar".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480132&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b1eb94de-9c78-44bc-9859-d23da04c3c4c\', \'multiverseId\': 480132}, \'multiverseid\': 480132}, {\'name\': "Tireuse d\'élite en maraude", \'text\': "Flash\\nQuand la Tireuse d\'élite en maraude arrive sur le champ de bataille, détruisez une créature ciblée qui a subi des blessures ce tour-ci.", \'type\': \'Créature : humain et assassin\', \'flavor\': \'« Même les cris les plus puissants peuvent être réduits au silence. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480391&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a14e3572-dc59-4753-9737-dfd7a24c561f\', \'multiverseId\': 480391}, \'multiverseid\': 480391}, {\'name\': \'Cecchina in Agguato\', \'text\': \'Lampo\\nQuando la Cecchina in Agguato entra nel campo di battaglia, distruggi una creatura bersaglio a cui è stato inflitto danno in questo turno.\', \'type\': \'Creatura — Assassino Umano\', \'flavor\': \'"Non esiste ruggito così potente da non poter essere messo a tacere."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480650&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'77b6ccef-de89-4ba1-9820-c1605460d52f\', \'multiverseId\': 480650}, \'multiverseid\': 480650}, {\'name\': \'隠れ潜む名射手\', \'text\': \'瞬速\\n隠れ潜む名射手が戦場に出たとき、このターンにダメージを受けたクリーチャー１体を対象とし、それを破壊する。\', \'type\': \'クリーチャー — 人間・暗殺者\', \'flavor\': \'「どんなに力強くとも、静められない咆哮はない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480909&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'55cc7fcc-4bdf-43d9-922a-1ade97cf0613\', \'multiverseId\': 480909}, \'multiverseid\': 480909}, {\'name\': \'몸을 숨긴 사격의 명수\', \'text\': \'섬광\\n몸을 숨긴 사격의 명수가 전장에 들어올 때, 이번 턴에 피해를 입은 생물을 목표로 정한다. 그 생물을 파괴한다.\', \'type\': \'생물 — 인간 암살자\', \'flavor\': \'"너무 강대해서 조용하게 만들 수 없는 포효 따윈 없다고."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481168&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8db911d3-49df-4e61-b016-d1d716c0465b\', \'multiverseId\': 481168}, \'multiverseid\': 481168}, {\'name\': \'Espreitadora Certeira\', \'text\': \'Lampejo\\nQuando Espreitadora Certeira entrar no campo de batalha, destrua a criatura alvo que sofreu dano neste turno.\', \'type\': \'Criatura — Humano Assassino\', \'flavor\': \'"Não há rugido tão poderoso que não possa ser calado."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481427&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9ce18acd-2b1d-4316-91f0-2d435a9a70cb\', \'multiverseId\': 481427}, \'multiverseid\': 481427}, {\'name\': \'Притаившийся Снайпер\', \'text\': \'Миг\\nКогда Притаившийся Снайпер выходит на поле битвы, уничтожьте целевое существо, которому в этом ходу были нанесены повреждения.\', \'type\': \'Существо — Человек Убийца\', \'flavor\': \'«Не бывает рева такого мощного, чтобы его нельзя было заглушить».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481686&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cbe992c6-bd8d-4f27-beec-9386031b8b59\', \'multiverseId\': 481686}, \'multiverseid\': 481686}, {\'name\': \'伏击神射手\', \'text\': \'闪现\\n当伏击神射手进战场时，消灭目标本回合中受过伤害的生物。\', \'type\': \'生物 ～人类／杀手\', \'flavor\': \'「无论咆哮有多宏伟，都能令其噤声。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481945&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4c651f04-fcc3-4aa1-a676-c8f2acd52dd1\', \'multiverseId\': 481945}, \'multiverseid\': 481945}, {\'name\': \'伏擊神射手\', \'text\': \'閃現\\n當伏擊神射手進戰場時，消滅目標本回合中受過傷害的生物。\', \'type\': \'生物 ～人類／殺手\', \'flavor\': \'「無論咆哮有多宏偉，都能令其噤聲。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482204&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'63bd80c4-eedf-491e-889c-c5de9c3bb845\', \'multiverseId\': 482204}, \'multiverseid\': 482204}]', '[{\'name\': \'Lavagrund-Glücksritterin\', \'text\': \'Sowie die Lavagrund-Glücksritterin ins Spiel kommt, bestimme gerade oder ungerade. (Null zählt als gerade.)\\nDie Lavagrund-Glücksritterin hat Schutz vor allen umgewandelten Manakosten des bestimmten Merkmals.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'„Mache hier draußen einen falschen Schritt, und du bist tot. Ich mache nur richtige Schritte."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479798&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'36b2683f-8e56-4f1a-ad24-cd6ac890937d\', \'multiverseId\': 479798}, \'multiverseid\': 479798}, {\'name\': \'Aventurera de Bordelava\', \'text\': \'En cuanto la Aventurera de Bordelava entre al campo de batalla, elige par o impar. (Cero es par.)\\nLa Aventurera de Bordelava tiene protección contra cada coste de maná convertido del valor elegido.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'"Si das un mal paso, estás muerto. Todos mis pasos son buenos".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480057&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'699e000f-65c0-413f-8971-61b5019749c9\', \'multiverseId\': 480057}, \'multiverseid\': 480057}, {\'name\': \'Aventurière de Bourg-sur-Lave\', \'text\': "Quand l\'Aventurière de Bourg-sur-Lave arrive sur le champ de bataille, choisissez pair ou impair. (Zéro est pair.)\\nL\'Aventurière de Bourg-sur-Lave a la protection contre chaque coût converti de mana de la valeur choisie.", \'type\': \'Créature : humain et soldat\', \'flavor\': \'« Un pas de travers, et la mort est assurée. Heureusement, je marche toujours droit. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480316&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'66567a6f-ab2a-4a95-930e-1fa2774cac9a\', \'multiverseId\': 480316}, \'multiverseid\': 480316}, {\'name\': \'Avventuriera di Lavariva\', \'text\': "Mentre l\'Avventuriera di Lavariva entra nel campo di battaglia, scegli pari o dispari. (0 è pari.)\\nL\'Avventuriera di Lavariva ha protezione dai costi di mana convertiti scelti.", \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'"Se fai un passo falso qua fuori, sei morto. Io faccio solo passi giusti."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480575&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fb221730-60b7-4ebd-a79b-ca5fcf0cf20c\', \'multiverseId\': 480575}, \'multiverseid\': 480575}, {\'name\': \'ラバブリンクの冒険者\', \'text\': \'ラバブリンクの冒険者が戦場に出るに際し、奇数か偶数を選ぶ。（０は偶数である。）\\nラバブリンクの冒険者は、プロテクション（点数で見たマナ・コストがその選ばれた値である）を得る。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'「ここでは一歩でも間違えれば死だ。私は正しい道のみを選ぶ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480834&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4ac0b252-5b50-4ec8-8b7a-5bd819c78063\', \'multiverseId\': 480834}, \'multiverseid\': 480834}, {\'name\': \'용암가장자리 탐험가\', \'text\': \'용암가장자리 탐험가가 전장에 들어오면서, 홀수 또는 짝수를 선택한다. (0은 짝수로 취급한다.)\\n용암가장자리 탐험가는 선택된 값을 가진 각 전환마나비용으로부터 보호를 가진다.\', \'type\': \'생물 — 인간 병사\', \'flavor\': \'"여기선 한 발자국만 잘못 디뎌도 죽은 목숨이야. 난 항상 올바른 곳만 디디지."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481093&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'60c9c89d-7bee-414e-ae6a-703449f357b4\', \'multiverseId\': 481093}, \'multiverseid\': 481093}, {\'name\': \'Aventureira de Beiralava\', \'text\': \'Conforme Aventureira de Beiralava entrar no campo de batalha, escolha par ou ímpar. (Zero é par.)\\nAventureira de Beiralava tem proteção contra cada custo de mana convertido do valor escolhido.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': \'"Um passo em falso aqui e você já era. Os meus são sempre firmes."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481352&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8ae16269-13e5-48a0-b206-2eb1be890e6d\', \'multiverseId\': 481352}, \'multiverseid\': 481352}, {\'name\': \'Авантюристка из Лавобрега\', \'text\': \'При выходе Авантюристки из Лавобрега на поле битвы выберите чет или нечет. (Ноль является четным числом.)\\nАвантюристка из Лавобрега имеет Защиту от каждой конвертированной мана-стоимости, соответствующей выбранному значению.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'«Один неверный шаг здесь — и тебе конец. Я делаю только верные шаги».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481611&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5f903f06-55ee-4749-8357-9d52ff9628cb\', \'multiverseId\': 481611}, \'multiverseid\': 481611}, {\'name\': \'熔缘城冒险家\', \'text\': \'于熔缘城冒险家进战场时，选择奇数或偶数。（零是偶数。）\\n熔缘城冒险家具有「保护～反该种数值的总法术力费用」。\', \'type\': \'生物 ～人类／士兵\', \'flavor\': \'「在这里走错一步就会送命。而我一步也不会错。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481870&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'13d89ba8-f18e-4c1d-b69f-a4c526689e95\', \'multiverseId\': 481870}, \'multiverseid\': 481870}, {\'name\': \'熔緣城冒險家\', \'text\': \'於熔緣城冒險家進戰場時，選擇奇數或偶數。（零是偶數。）\\n熔緣城冒險家具有「保護～反該種數值的總魔法力費用」。\', \'type\': \'生物 ～人類／士兵\', \'flavor\': \'「在這裡走錯一步就會送命。而我一步也不會錯。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482129&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'33b5a3a5-2204-47f9-bef9-eed58c0e8ff9\', \'multiverseId\': 482129}, \'multiverseid\': 482129}]', '[{\'name\': \'Lavaschlange\', \'text\': \'Eile\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Kreatur — Elementarwesen, Schlange\', \'flavor\': \'Der brodelnde Graben, der Lavagrund umgibt, ist für die meisten ein Abschreckungsmittel. Für sie ist es ein entspannendes Bad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479903&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f517baa4-6c1b-4093-849d-f64022546988\', \'multiverseId\': 479903}, \'multiverseid\': 479903}, {\'name\': \'Serpiente de lava\', \'text\': \'Prisa.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Criatura — Serpiente elemental\', \'flavor\': \'El foso hirviente de Bordelava disuade a la mayoría, pero para algunos es un baño relajante.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480162&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5389297f-d618-4952-9890-dfa11d346368\', \'multiverseId\': 480162}, \'multiverseid\': 480162}, {\'name\': \'Serpent de lave\', \'text\': \'Célérité\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)\', \'type\': \'Créature : élémental et grand serpent\', \'flavor\': "Les douves bouillantes de Bourg-sur-Lave repoussent la plupart des créatures, mais l\'une d\'elles y voit un bassin relaxant.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480421&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'138c056c-15e1-4bd1-bc10-d3dde0329658\', \'multiverseId\': 480421}, \'multiverseid\': 480421}, {\'name\': \'Serpe della Lava\', \'text\': \'Rapidità\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Creatura — Serpe Elementale\', \'flavor\': \'Per chiunque altro, il fossato bollente di Lavariva è un deterrente. Per lui, è un bagno rilassante.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480680&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'33b423a0-0caa-4642-92fd-927d39ca5073\', \'multiverseId\': 480680}, \'multiverseid\': 480680}, {\'name\': \'溶岩の海蛇\', \'text\': \'速攻\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'クリーチャー — エレメンタル・海蛇\', \'flavor\': \'ラバブリンクの煮えたぎる堀は、多くにとっては脅威だが、あるものにとっては気持ちの良い風呂である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480939&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5916ae46-4759-4b70-b584-fd85af8e0402\', \'multiverseId\': 480939}, \'multiverseid\': 480939}, {\'name\': \'용암 이무기\', \'text\': \'신속\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'생물 — 정령 이무기\', \'flavor\': \'용암가장자리의 끓어오르는 해자는 대부분이 피하려 하는 것이지만, 한 놈에게만은 편안한 목욕터이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481198&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'68ddd1ee-c06d-4412-8b0d-65b78b0fb0ad\', \'multiverseId\': 481198}, \'multiverseid\': 481198}, {\'name\': \'Serpente da Lava\', \'text\': \'Ímpeto\\nReciclar {2} ({2}, descarte este card: Compre um card.)\', \'type\': \'Criatura — Elemental Serpente\', \'flavor\': \'Para a maioria, o fosso fervente de Beiralava é um empecilho, mas para um deles é um banho relaxante.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481457&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ea12f411-8d57-44d3-be66-d3a04c8d6a45\', \'multiverseId\': 481457}, \'multiverseid\': 481457}, {\'name\': \'Лавовый Змей\', \'text\': \'Ускорение\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Существо — Элементаль Змей\', \'flavor\': \'Для большинства кипящий ров Лавобрега — неодолимое препятствие, но для него — расслабляющая ванна.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481716&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5bb66d75-8fd8-41a9-b5c8-9ddb1b646155\', \'multiverseId\': 481716}, \'multiverseid\': 481716}, {\'name\': \'熔岩巨蛇\', \'text\': \'敏捷\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'生物 ～元素／巨蛇\', \'flavor\': \'熔缘城滚热的护城河是许多生物难以逾越的天堑，对其他生物而言却是难得的放松场地。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481975&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'20982da3-029e-4b54-86aa-8cca51fedbba\', \'multiverseId\': 481975}, \'multiverseid\': 481975}, {\'name\': \'熔岩巨蛇\', \'text\': \'敏捷\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'生物 ～元素／巨蛇\', \'flavor\': \'熔緣城滾熱的護城河是許多生物難以逾越的天塹，對其他生物而言卻是難得的放鬆場地。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482234&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'506ea015-e0b6-465e-a4c1-b2978c05c13e\', \'multiverseId\': 482234}, \'multiverseid\': 482234}]', '[{\'name\': \'Leichen aufwühlen\', \'text\': \'Lege die obersten drei Karten deiner Bibliothek auf deinen Friedhof. Dann kannst du eine Kreaturenkarte aus deinem Friedhof auf deine Hand zurückbringen.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Wie wir uns gefunden haben? Da war ich also und erkundete einen Berg aus Monsterleichen …"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479860&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ac6d7cee-5ff6-4f83-902a-00d605b6f426\', \'multiverseId\': 479860}, \'multiverseid\': 479860}, {\'name\': \'Agitación cadavérica\', \'text\': \'Pon las tres primeras cartas de tu biblioteca en tu cementerio, luego puedes regresar una carta de criatura de tu cementerio a tu mano.\', \'type\': \'Instantáneo\', \'flavor\': \'"¿Que cómo nos conocimos? Ahí estaba yo, explorando una pila de cadáveres de monstruos...".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480119&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1598ec2b-3014-4cd2-8d69-047b99505107\', \'multiverseId\': 480119}, \'multiverseid\': 480119}, {\'name\': \'Barratement cadavérique\', \'text\': \'Mettez les trois cartes du dessus de votre bibliothèque dans votre cimetière, puis vous pouvez renvoyer une carte de créature depuis votre cimetière dans votre main.\', \'type\': \'Éphémère\', \'flavor\': "« Comment nous nous sommes rencontrés ? Eh bien, j\'explorais tranquillement un tas de cadavres de monstres... »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480378&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fe28764d-a093-48c0-b6fe-a63233e00088\', \'multiverseId\': 480378}, \'multiverseid\': 480378}, {\'name\': \'Estrazione di Cadaveri\', \'text\': \'Metti nel tuo cimitero le prime tre carte del tuo grimorio, poi puoi riprendere in mano una carta creatura dal tuo cimitero.\', \'type\': \'Istantaneo\', \'flavor\': \'"Come ci siamo trovati? Beh, ero lì che esploravo un cumulo di cadaveri di mostri..."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480637&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'53e3b065-4817-4a45-9e8d-1d54685a3bcd\', \'multiverseId\': 480637}, \'multiverseid\': 480637}, {\'name\': \'屍体の攪拌\', \'text\': \'あなたのライブラリーの一番上からカードを３枚あなたの墓地に置く。その後、あなたはあなたの墓地からクリーチャー・カード１枚をあなたの手札に戻してもよい。\', \'type\': \'インスタント\', \'flavor\': \'「どうやってお互いを見つけたかって？ある日怪物の死体の山を探検していたら……」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480896&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'198b2083-46a6-44db-94c6-83f6b0893a73\', \'multiverseId\': 480896}, \'multiverseid\': 480896}, {\'name\': \'시체 휘젓기\', \'text\': \'당신의 서고 맨 위 카드 세 장을 당신의 무덤에 넣는다. 그 후 당신의 무덤에서 생물 카드 한 장을 당신의 손으로 되돌릴 수 있다.\', \'type\': \'순간마법\', \'flavor\': \'"우리가 어떻게 서로를 찾았냐고? 그러니까, 내가 괴수들의 시체가 쌓여 있는 산을 뒤지고 있었는데 . . ."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481155&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d7efa108-2592-498c-9a42-1349ce4e28b7\', \'multiverseId\': 481155}, \'multiverseid\': 481155}, {\'name\': \'Reviravolta de Cadáveres\', \'text\': \'Coloque os três cards do topo do seu grimório no seu cemitério. Depois, você pode devolver um card de criatura de seu cemitério para a sua mão.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Como nos encontramos? Então... eu estava por aí, explorando uma colina de cadáveres de monstros quando..."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481414&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'956e911e-fc10-42a3-b0a2-c57e54ba75f9\', \'multiverseId\': 481414}, \'multiverseid\': 481414}, {\'name\': \'Пробуждение Трупа\', \'text\': \'Положите три верхние карты вашей библиотеки на ваше кладбище, затем вы можете вернуть карту существа из вашего кладбища в вашу руку.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Как мы нашли друг друга? В общем, копаюсь я как-то раз в горе чудовищных трупов...»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481673&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'64587fac-f7d1-4be1-b105-5e12dabe9797\', \'multiverseId\': 481673}, \'multiverseid\': 481673}, {\'name\': \'尸体翻搅\', \'text\': \'将你牌库顶的三张牌置入你的坟墓场，然后你可以将一张生物牌从你的坟墓场移回你手上。\', \'type\': \'瞬间\', \'flavor\': \'「我们是怎样相遇的？我当时，应该是在一堆怪兽尸体中翻找. . .」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481932&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c5cb6eec-ec34-4a0a-ac3a-e351e152e03f\', \'multiverseId\': 481932}, \'multiverseid\': 481932}, {\'name\': \'屍體翻攪\', \'text\': \'將你牌庫頂的三張牌置入你的墳墓場，然後你可以將一張生物牌從你的墳墓場移回你手上。\', \'type\': \'瞬間\', \'flavor\': \'「我們是怎樣相遇的？我當時，應該是在一堆怪獸屍體中翻找. . .」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482191&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8dd2d3ac-3faa-44fc-a1fa-2dcf81163274\', \'multiverseId\': 482191}, \'multiverseid\': 482191}]', '[{\'name\': \'Leichte Beute\', \'text\': \'Zerstöre eine Kreatur deiner Wahl mit umgewandelten Manakosten von 2 oder weniger.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Spontanzauber\', \'flavor\': \'Die Definition von „mundgerecht" hängt davon ab, wen man fragt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479866&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'020efad8-cbc6-43b1-bd3b-cb1958735201\', \'multiverseId\': 479866}, \'multiverseid\': 479866}, {\'name\': \'Presa fácil\', \'text\': \'Destruye la criatura objetivo con coste de maná convertido de 2 o menos.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Instantáneo\', \'flavor\': \'La definición de "bocadito" depende de a quién le preguntes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480125&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5379dfa9-ee7c-4d00-adf2-460b2f1b7191\', \'multiverseId\': 480125}, \'multiverseid\': 480125}, {\'name\': \'Proie facile\', \'text\': \'Détruisez une créature ciblée dont le coût converti de mana est inférieur ou égal à 2.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)\', \'type\': \'Éphémère\', \'flavor\': "L\'idée de « petite bouchée » n\'est pas la même selon l\'individu.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480384&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5b6c2c71-534e-473e-aaac-43656e6970be\', \'multiverseId\': 480384}, \'multiverseid\': 480384}, {\'name\': \'Preda Facile\', \'text\': \'Distruggi una creatura bersaglio con costo di mana convertito pari o inferiore a 2.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Istantaneo\', \'flavor\': \'La definizione di "delizioso bocconcino" dipende dal punto di vista.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480643&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f1a889a3-0df6-47cf-b7e6-904e52651daa\', \'multiverseId\': 480643}, \'multiverseid\': 480643}, {\'name\': \'恰好の餌食\', \'text\': \'点数で見たマナ・コストが２以下のクリーチャー１体を対象とし、それを破壊する。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'インスタント\', \'flavor\': \'「一口大」の定義は、尋ねる相手によって異なる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480902&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ca1c2601-23ab-4870-9af5-ca0869e74752\', \'multiverseId\': 480902}, \'multiverseid\': 480902}, {\'name\': \'손쉬운 먹이\', \'text\': \'전환마나비용이 2 이하인 생물을 목표로 정한다. 그 생물을 파괴한다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'순간마법\', \'flavor\': \'"한 입 거리"에 대한 정의는 누구에게 묻느냐에 따라 다르다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481161&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b0f9aab6-d1cb-4642-a5b7-1ec43a003cae\', \'multiverseId\': 481161}, \'multiverseid\': 481161}, {\'name\': \'Presa Fácil\', \'text\': \'Destrua a criatura alvo com custo de mana convertido igual ou inferior a 2.\\nReciclar {2} ({2}, descarte este card: Compre um card.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'A definição de "porção pequena" depende de a quem você pergunta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481420&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5dee1c50-e7cb-4549-9cad-f0d4e0178dae\', \'multiverseId\': 481420}, \'multiverseid\': 481420}, {\'name\': \'Легкая Добыча\', \'text\': \'Уничтожьте целевое существо с конвертированной мана-стоимостью 2 или меньше.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Определение «на один укус» зависит от того, кого спрашивать.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481679&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2c268f2f-3f2b-44cb-8a9a-c4ef720c9d2a\', \'multiverseId\': 481679}, \'multiverseid\': 481679}, {\'name\': \'手到擒来\', \'text\': \'消灭目标总法术力费用等于或小于2的生物。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'瞬间\', \'flavor\': \'「易入口美馔」的大小取决于你问谁。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481938&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'61f76b8f-d9b7-4bfa-9700-9ff74393a864\', \'multiverseId\': 481938}, \'multiverseid\': 481938}, {\'name\': \'手到擒來\', \'text\': \'消滅目標總魔法力費用等於或小於2的生物。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'瞬間\', \'flavor\': \'「易入口美饌」的大小取決於你問誰。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482197&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c0d9ec8b-ec74-4184-af85-098e92cccc2b\', \'multiverseId\': 482197}, \'multiverseid\': 482197}]', '[{\'name\': \'Leuchtende Brutmotte\', \'text\': \'Fliegend\\nImmer wenn eine nichtfliegende Kreatur, die du kontrollierst, stirbt, bringe sie mit einer Fliegend-Marke unter der Kontrolle ihres Besitzers ins Spiel zurück.\', \'type\': \'Kreatur — Insekt\', \'flavor\': \'Mothra die Überschallkönigin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482385&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cbb3f96a-6b6a-4601-ae13-eb4351b36b2b\', \'multiverseId\': 482385}, \'multiverseid\': 482385}, {\'name\': \'Polilla incubadora luminosa\', \'text\': \'Vuela.\\nSiempre que una criatura que controlas sin la habilidad de volar muera, regrésala al campo de batalla bajo el control de su propietario con un contador de volar sobre ella.\', \'type\': \'Criatura — Insecto\', \'flavor\': \'Mothra, reina supersónica\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482399&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4585f5d2-8997-45a5-a414-09824451c9d6\', \'multiverseId\': 482399}, \'multiverseid\': 482399}, {\'name\': \'Phalène pondeuse lumineuse\', \'text\': "Vol\\nÀ chaque fois qu\'une créature sans le vol que vous contrôlez meurt, renvoyez-la sur le champ de bataille sous le contrôle de son propriétaire avec un marqueur « vol » sur elle.", \'type\': \'Créature : insecte\', \'flavor\': \'Mothra, reine supersonique\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482413&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3206c561-b3e6-47af-82f7-e71c43548a5f\', \'multiverseId\': 482413}, \'multiverseid\': 482413}, {\'name\': \'Falena della Covata Luminosa\', \'text\': \'Volare\\nOgniqualvolta una creatura senza volare che controlli muore, rimettila sul campo di battaglia sotto il controllo del suo proprietario con un segnalino volare.\', \'type\': \'Creatura — Insetto\', \'flavor\': \'Mothra, Regina Supersonica\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482427&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1db5f9b5-ae43-446f-8e91-96ac84aa6172\', \'multiverseId\': 482427}, \'multiverseid\': 482427}, {\'name\': \'光明の繁殖蛾\', \'text\': \'飛行\\nあなたがコントロールしていて飛行を持たないクリーチャーが１体死亡するたび、それをオーナーのコントロール下で飛行カウンターが１個置かれた状態で戦場に戻す。\', \'type\': \'クリーチャー — 昆虫\', \'flavor\': \'超（ちょう）音（おん）速（そく）女（じょ）王（おう）、モスラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482441&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'21b34d9e-862c-4edb-b671-dd61ef423f9a\', \'multiverseId\': 482441}, \'multiverseid\': 482441}, {\'name\': \'빛나는 무리나방\', \'text\': \'비행\\n당신이 조종하는 비행이 없는 생물이 죽을 때마다, 그 카드에 비행 카운터를 올려놓고 소유자의 조종하에 전장으로 되돌린다.\', \'type\': \'생물 — 곤충\', \'flavor\': \'초음속 여왕, 모스라\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482455&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d3a2ccf2-3f73-4c0b-a4af-2e6c0c916d5d\', \'multiverseId\': 482455}, \'multiverseid\': 482455}, {\'name\': \'Mariposa-parideira Luminosa\', \'text\': \'Voar\\nToda vez que uma criatura que você controla sem voar morrer, devolva-a ao campo de batalha sob o controle de seu dono com um marcador de voar.\', \'type\': \'Criatura — Inseto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482469&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d1e2dca9-95de-437d-81ab-abd00ef926f5\', \'multiverseId\': 482469}, \'multiverseid\': 482469}, {\'name\': \'Сияющий Мотылек Роя\', \'text\': \'Полет\\nКаждый раз, когда существо без Полета под вашим контролем умирает, верните его на поле битвы под контролем его владельца с одним жетоном Полета на нем.\', \'type\': \'Существо — Насекомое\', \'flavor\': \'Мотра, Сверхзвуковая Царица\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482483&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c3ca3a65-f6aa-44ee-9875-fb3ceadf8089\', \'multiverseId\': 482483}, \'multiverseid\': 482483}, {\'name\': \'灿光巢蛾\', \'text\': \'飞行\\n每当一个由你操控且不具飞行异能的生物死去时，将它在其拥有者的操控下移回战场，且上面有一个飞行指示物。\', \'type\': \'生物 ～昆虫\', \'flavor\': \'超音速女王摩斯拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482497&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3a201456-7e75-48cd-8b0a-e6913339873f\', \'multiverseId\': 482497}, \'multiverseid\': 482497}, {\'name\': \'燦光巢蛾\', \'text\': \'飛行\\n每當一個由你操控且不具飛行異能的生物死去時，將它在其擁有者的操控下移回戰場，且上面有一個飛行指示物。\', \'type\': \'生物 ～昆蟲\', \'flavor\': \'超音速女王摩斯拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482511&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e6a789e2-0daf-4f2a-a7ee-ea982d59c420\', \'multiverseId\': 482511}, \'multiverseid\': 482511}]', '[{\'name\': \'Leuchtende Brutmotte\', \'text\': \'Fliegend\\nImmer wenn eine nichtfliegende Kreatur, die du kontrollierst, stirbt, bringe sie mit einer Fliegend-Marke unter der Kontrolle ihres Besitzers ins Spiel zurück.\', \'type\': \'Kreatur — Insekt\', \'flavor\': \'Sie segelt durch die Strömungen des Mondlichts, um den Verlorenen Hoffnung zu geben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479800&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'72da69a5-10d2-4980-8d1f-24bbaed46719\', \'multiverseId\': 479800}, \'multiverseid\': 479800}, {\'name\': \'Polilla incubadora luminosa\', \'text\': \'Vuela.\\nSiempre que una criatura que controlas sin la habilidad de volar muera, regrésala al campo de batalla bajo el control de su propietario con un contador de volar sobre ella.\', \'type\': \'Criatura — Insecto\', \'flavor\': \'Planea entre los rayos de luna para llevar esperanza a los desamparados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480059&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8cffdbe7-e42f-4910-8bc4-1ed4394039df\', \'multiverseId\': 480059}, \'multiverseid\': 480059}, {\'name\': \'Phalène pondeuse lumineuse\', \'text\': "Vol\\nÀ chaque fois qu\'une créature sans le vol que vous contrôlez meurt, renvoyez-la sur le champ de bataille sous le contrôle de son propriétaire avec un marqueur « vol » sur elle.", \'type\': \'Créature : insecte\', \'flavor\': \'Elle plane sur les courants du clair de lune et redonne espoir aux délaissés.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480318&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fd5f8d5f-057c-4f72-b67d-dbc5ce0f8e09\', \'multiverseId\': 480318}, \'multiverseid\': 480318}, {\'name\': \'Falena della Covata Luminosa\', \'text\': \'Volare\\nOgniqualvolta una creatura senza volare che controlli muore, rimettila sul campo di battaglia sotto il controllo del suo proprietario con un segnalino volare.\', \'type\': \'Creatura — Insetto\', \'flavor\': \'Si libra tra le correnti dei raggi lunari per donare speranza ai derelitti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480577&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5ddd6f89-03ed-400e-8b85-4527dfcecbfa\', \'multiverseId\': 480577}, \'multiverseid\': 480577}, {\'name\': \'光明の繁殖蛾\', \'text\': \'飛行\\nあなたがコントロールしていて飛行を持たないクリーチャーが１体死亡するたび、それをオーナーのコントロール下で飛行カウンターが１個置かれた状態で戦場に戻す。\', \'type\': \'クリーチャー — 昆虫\', \'flavor\': \'それは月光の中を舞い上がり、見捨てられた者たちに希望を与える。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480836&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a44460d5-fc4d-45a7-80a1-100ff7df6452\', \'multiverseId\': 480836}, \'multiverseid\': 480836}, {\'name\': \'빛나는 무리나방\', \'text\': \'비행\\n당신이 조종하는 비행이 없는 생물이 죽을 때마다, 그 생물에 비행 카운터를 올려놓고 소유자의 조종하에 전장으로 되돌린다.\', \'type\': \'생물 — 곤충\', \'flavor\': \'쏟아져 내리는 달빛을 거스르며 솟구치는 모습이 버림받은 자들에게 희망을 준다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481095&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'155f63ad-c5ad-4e1a-a15e-d76e8260d8de\', \'multiverseId\': 481095}, \'multiverseid\': 481095}, {\'name\': \'Mariposa-parideira Luminosa\', \'text\': \'Voar\\nToda vez que uma criatura que você controla sem voar morrer, devolva-a ao campo de batalha sob o controle de seu dono com um marcador de voar.\', \'type\': \'Criatura — Inseto\', \'flavor\': \'Ela voa por correntes de luar para dar esperança aos abandonados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481354&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b244e93c-a8fc-4835-ba8e-14cd1e0340ad\', \'multiverseId\': 481354}, \'multiverseid\': 481354}, {\'name\': \'Сияющий Мотылек Роя\', \'text\': \'Полет\\nКаждый раз, когда существо без Полета под вашим контролем умирает, верните его на поле битвы под контролем его владельца с одним жетоном Полета на нем.\', \'type\': \'Существо — Насекомое\', \'flavor\': \'Он парит в потоках лунного света, чтобы дать надежду тем, кто брошен.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481613&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c16b9f42-d3a2-4b48-bf00-75fbd0e4d1d6\', \'multiverseId\': 481613}, \'multiverseid\': 481613}, {\'name\': \'灿光巢蛾\', \'text\': \'飞行\\n每当一个由你操控且不具飞行异能的生物死去时，将它在其拥有者的操控下移回战场，且上面有一个飞行指示物。\', \'type\': \'生物 ～昆虫\', \'flavor\': \'它翱翔于月光之间，为遭弃者带来希望。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481872&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'39d58fe8-7c05-4d4d-8f48-8d98b731f6a1\', \'multiverseId\': 481872}, \'multiverseid\': 481872}, {\'name\': \'燦光巢蛾\', \'text\': \'飛行\\n每當一個由你操控且不具飛行異能的生物死去時，將它在其擁有者的操控下移回戰場，且上面有一個飛行指示物。\', \'type\': \'生物 ～昆蟲\', \'flavor\': \'牠翱翔於月光之間，為遭棄者帶來希望。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482131&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'52a8337f-9b56-471b-b84d-c83470583337\', \'multiverseId\': 482131}, \'multiverseid\': 482131}]', '[{\'name\': \'Licht der Hoffnung\', \'text\': \'Bestimme eines —\\n• Du erhältst 4 Lebenspunkte dazu.\\n• Zerstöre eine Verzauberung deiner Wahl.\\n• Lege eine +1/+1-Marke auf eine Kreatur deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479799&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'84520f2a-b638-4e2f-8443-e8f2b566a61d\', \'multiverseId\': 479799}, \'multiverseid\': 479799}, {\'name\': \'Luz de la esperanza\', \'text\': \'Elige uno:\\n• Ganas 4 vidas.\\n• Destruye el encantamiento objetivo.\\n• Pon un contador +1/+1 sobre la criatura objetivo.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480058&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'71ef822d-992b-4f28-a471-fab383ffafee\', \'multiverseId\': 480058}, \'multiverseid\': 480058}, {\'name\': "Lueur d\'espoir", \'text\': "Choisissez l\'un —\\n• Vous gagnez 4 points de vie.\\n• Détruisez l\'enchantement ciblé.\\n• Mettez un marqueur +1/+1 sur la créature ciblée.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480317&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5d7d314f-2766-4c3e-ad08-797a93f67f82\', \'multiverseId\': 480317}, \'multiverseid\': 480317}, {\'name\': \'Luce di Speranza\', \'text\': \'Scegli uno —\\n• Guadagni 4 punti vita.\\n• Distruggi un incantesimo bersaglio.\\n• Metti un segnalino +1/+1 su una creatura bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480576&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b155cd49-6bc3-4e6a-9370-e6b83a5c14b1\', \'multiverseId\': 480576}, \'multiverseid\': 480576}, {\'name\': \'希望の光\', \'text\': \'以下から１つを選ぶ。\\n• あなたは４点のライフを得る。\\n• エンチャント１つを対象とし、それを破壊する。\\n• クリーチャー１体を対象とし、それの上に＋１/＋１カウンターを１個置く。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480835&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b6dcdfc4-1a7e-499b-8400-b567ffe5f5ca\', \'multiverseId\': 480835}, \'multiverseid\': 480835}, {\'name\': \'희망의 빛\', \'text\': \'하나를 선택한다 —\\n• 당신은 생명 4점을 얻는다.\\n• 부여마법을 목표로 정한다. 그 부여마법을 파괴한다.\\n• 생물을 목표로 정한다. 그 생물에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481094&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5c47ba69-05e5-4e9a-b6d5-0760fea4c574\', \'multiverseId\': 481094}, \'multiverseid\': 481094}, {\'name\': \'Luz da Esperança\', \'text\': \'Escolha um —\\n• Você ganha 4 pontos de vida.\\n• Destrua o encantamento alvo.\\n• Coloque um marcador +1/+1 na criatura alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481353&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'435894d2-551b-4a95-ba5a-6c3a046ac3f7\', \'multiverseId\': 481353}, \'multiverseid\': 481353}, {\'name\': \'Свет Надежды\', \'text\': \'Выберите одно —\\n• Вы получаете 4 жизни.\\n• Уничтожьте целевые чары.\\n• Положите один жетон +1/+1 на целевое существо.\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481612&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b142bb0a-bae9-4d10-adcb-14172ce5b031\', \'multiverseId\': 481612}, \'multiverseid\': 481612}, {\'name\': \'希望明光\', \'text\': \'选择一项～\\n•你获得4点生命。\\n•消灭目标结界。\\n•在目标生物上放置一个+1/+1指示物。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481871&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b407d79e-0ec0-4ce1-851b-91443f407f37\', \'multiverseId\': 481871}, \'multiverseid\': 481871}, {\'name\': \'希望明光\', \'text\': \'選擇一項～\\n•你獲得4點生命。\\n•消滅目標結界。\\n•在目標生物上放置一個+1/+1指示物。\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482130&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b10bc3b0-6656-48f4-a360-a81e322303d9\', \'multiverseId\': 482130}, \'multiverseid\': 482130}]', '[{\'name\': \'Listige Nachtbynderin\', \'text\': \'Aufblitzen\\nZaubersprüche mit Aufblitzen, die du wirkst, kosten beim Wirken {1} weniger und können nicht neutralisiert werden.\', \'type\': \'Kreatur — Mensch, Räuber\', \'flavor\': \'„Wir sind der Schatten des jeweils anderen, flüchtig und doch immer präsent."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479998&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c94c9f78-14d8-4244-9d7f-162fe3fb3608\', \'multiverseId\': 479998}, \'multiverseid\': 479998}, {\'name\': \'Vinculanoches astuta\', \'text\': \'Destello.\\nTe cuesta {1} menos lanzar hechizos con la habilidad de destello y no pueden ser contrarrestados.\', \'type\': \'Criatura — Bribón humano\', \'flavor\': \'"Somos la sombra el uno del otro, fugaces pero siempre presentes".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480257&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'846de8ee-aca6-4c65-ae60-40f18ade501c\', \'multiverseId\': 480257}, \'multiverseid\': 480257}, {\'name\': \'Bridenuit rusée\', \'text\': \'Flash\\nLes sorts avec le flash que vous lancez coûtent {1} de moins à lancer et ne peuvent pas être contrecarrés.\', \'type\': \'Créature : humain et gredin\', \'flavor\': "« Nous sommes chacun l\'ombre de l\'autre. Presque invisible, mais toujours là. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480516&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'12d29676-5a9f-44b6-bcf9-e96b601b1daa\', \'multiverseId\': 480516}, \'multiverseid\': 480516}, {\'name\': \'Vincolatenebre Astuta\', \'text\': \'Lampo\\nLe magie con lampo che lanci costano {1} in meno per essere lanciate e non possono essere neutralizzate.\', \'type\': \'Creatura — Farabutto Umano\', \'flavor\': \'"Siamo uno l\\\'ombra dell\\\'altro, sfuggente eppure sempre presente."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480775&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'77440f26-97be-4e92-a49d-782561bd455b\', \'multiverseId\': 480775}, \'multiverseid\': 480775}, {\'name\': \'狡賢い夜眷者\', \'text\': \'瞬速\\nあなたが瞬速を持つ呪文を唱えるためのコストは{1}少なくなり、その呪文は打ち消されない。\', \'type\': \'クリーチャー — 人間・ならず者\', \'flavor\': \'「私たちは互いの影。一瞬だが常に存在する。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481034&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'caaa1b8f-c507-4678-ba4e-8d144880067e\', \'multiverseId\': 481034}, \'multiverseid\': 481034}, {\'name\': \'교활한 어둠유대자\', \'text\': \'섬광\\n당신이 발동하는 섬광을 가진 주문들은 발동하는 데 {1}이 덜 들고 무효화될 수 없다.\', \'type\': \'생물 — 인간 도적\', \'flavor\': \'"우리는 서로의 그림자다. 덧없지만 항상 존재하지."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481293&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ec52a899-9aac-4629-8110-15d801317b63\', \'multiverseId\': 481293}, \'multiverseid\': 481293}, {\'name\': \'Vinculadora da Noite Sagaz\', \'text\': \'Lampejo\\nAs mágicas com lampejo que você conjura custam {1} a menos para conjurar e não podem ser anuladas.\', \'type\': \'Criatura — Humano Ladino\', \'flavor\': \'"Somos a sombra um do outro, fugazes, mas sempre presentes."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481552&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ec55e10e-e69c-401b-8e92-673d73fa0e52\', \'multiverseId\': 481552}, \'multiverseid\': 481552}, {\'name\': \'Коварная Узомантка Ночи\', \'text\': \'Миг\\nРазыгрываемые вами заклинания с Мигом стоят на {1} меньше и не могут быть отменены.\', \'type\': \'Существо — Человек Бродяга\', \'flavor\': \'«Мы — тени друг друга, ускользающие, но всегда остающиеся рядом».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481811&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4cbe9133-c695-424d-ac01-105c8d681744\', \'multiverseId\': 481811}, \'multiverseid\': 481811}, {\'name\': \'狡诈隐绊人\', \'text\': \'闪现\\n你施放之具闪现异能的咒语减少{1}来施放，且不能被反击。\', \'type\': \'生物 ～人类／浪客\', \'flavor\': \'「我们彼此成影，虽踪迹不定却永远随行。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482070&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b900452e-7f15-4f1a-a530-725930c7a271\', \'multiverseId\': 482070}, \'multiverseid\': 482070}, {\'name\': \'狡詐隱絆人\', \'text\': \'閃現\\n你施放之具閃現異能的咒語減少{1}來施放，且不能被反擊。\', \'type\': \'生物 ～人類／浪客\', \'flavor\': \'「我們彼此成影，雖蹤跡不定卻永遠隨行。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482329&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'798e5291-230a-4703-a5ec-82783702a856\', \'multiverseId\': 482329}, \'multiverseid\': 482329}]', '[{\'name\': \'Luftkatzenherrscher\', \'text\': \'Fliegend\\nDer Luftkatzenherrscher erhält +1/+1 für jede andere fliegende Kreatur, die du kontrollierst.\\n{2}{W}{U}: Erzeuge einen 1/1 weißen Katze-Vogel-Kreaturenspielstein mit Flugfähigkeit.\', \'type\': \'Kreatur — Elementarwesen, Katze\', \'flavor\': \'Sein Kopfgeld ist so alt wie Himmelstadt, aber niemand hat je versucht, es zu kassieren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479986&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dbdf9ab1-2874-4b18-bd25-5dbf8616118a\', \'multiverseId\': 479986}, \'multiverseid\': 479986}, {\'name\': \'Aerofelino soberano\', \'text\': \'Vuela.\\nEl Aerofelino soberano obtiene +1/+1 por cada otra criatura que controlas con la habilidad de volar.\\n{2}{W}{U}: Crea una ficha de criatura Felino Ave blanca 1/1 con la habilidad de volar.\', \'type\': \'Criatura — Felino elemental\', \'flavor\': \'La recompensa por su cabeza es tan antigua como Puertoaéreo, pero nadie ha intentado conseguirla nunca.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480245&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'548d3e1d-94dd-4c15-b4f0-d359a1719b25\', \'multiverseId\': 480245}, \'multiverseid\': 480245}, {\'name\': \'Souverain des félins célestes\', \'text\': \'Vol\\nLe Souverain des félins célestes gagne +1/+1 pour chaque autre créature avec le vol que vous contrôlez.\\n{2}{W}{U} : Créez un jeton de créature 1/1 blanche Chat et Oiseau avec le vol.\', \'type\': \'Créature : élémental et chat\', \'flavor\': "La prime sur sa tête est aussi ancienne que Vogueciel, mais personne n\'a jamais essayé de la récolter.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480504&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4099ed74-81a7-492c-bb97-22c25fc11796\', \'multiverseId\': 480504}, \'multiverseid\': 480504}, {\'name\': \'Sovrano degli Aerofelini\', \'text\': \'Volare\\nIl Sovrano degli Aerofelini prende +1/+1 per ogni altra creatura con volare che controlli.\\n{2}{W}{U}: Crea una pedina creatura Uccello Felino 1/1 bianca con volare.\', \'type\': \'Creatura — Felino Elementale\', \'flavor\': \'La taglia sulla sua testa è vecchia quanto la Solcanembi, ma nessuno ha mai tentato di riscuoterla.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480763&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8849bb21-878d-4547-ab83-f6bb5eebe535\', \'multiverseId\': 480763}, \'multiverseid\': 480763}, {\'name\': \'空猫の君主\', \'text\': \'飛行\\n空猫の君主は、他の、あなたがコントロールしていて飛行を持つクリーチャー１体につき＋１/＋１の修整を受ける。\\n{2}{W}{U}：飛行を持つ白の１/１の猫・鳥・クリーチャー・トークンを１体生成する。\', \'type\': \'クリーチャー — エレメンタル・猫\', \'flavor\': \'スカイセイルそのものと同じくらい古くからの賞金首だが、その報奨を手にしようと試みた者すらいない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481022&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d4f7c89d-a23d-4a3b-afe6-de196e1a58fb\', \'multiverseId\': 481022}, \'multiverseid\': 481022}, {\'name\': \'창공고양이 군주\', \'text\': \'비행\\n창공고양이 군주는 당신이 조종하는 비행을 가진 다른 각 생물마다 +1/+1을 받는다.\\n{2}{W}{U}: 비행을 가진 1/1 백색 고양이 조류 생물 토큰 한 개를 만든다.\', \'type\': \'생물 — 정령 고양이\', \'flavor\': \'그것의 머리에 걸려 있는 현상금은 창공돛만큼이나 오래되었지만, 그 현상금을 얻어간 자는 아무도 없었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481281&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'48422e40-25c4-41cb-9e7e-e5435d1788eb\', \'multiverseId\': 481281}, \'multiverseid\': 481281}, {\'name\': \'Soberano Aerofelino\', \'text\': \'Voar\\nSoberano Aerofelino recebe +1/+1 para cada outra criatura que você controla com voar.\\n{2}{W}{U}: Crie uma ficha de criatura branca 1/1 do tipo Felino Ave com voar.\', \'type\': \'Criatura — Elemental Felino\', \'flavor\': \'A recompensa pela cabeça dele é tão antiga quanto a própria Vela Celeste, mas ninguém jamais tentou recebê-la.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481540&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1c01836c-f85e-4609-a090-21c52ac860ca\', \'multiverseId\': 481540}, \'multiverseid\': 481540}, {\'name\': \'Владетельный Небесный Кот\', \'text\': \'Полет\\nВладетельный Небесный Кот получает +1/+1 за каждое другое существо с Полетом под вашим контролем.\\n{2}{W}{U}: создайте одну фишку существа 1/1 белая Кошка Птица с Полетом.\', \'type\': \'Существо — Элементаль Кошка\', \'flavor\': \'Награда за его голову стара, как сам Небесный Парус, но пока что никто не попытался получить ее.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481799&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'05f6b2e2-866c-4fee-9027-1842615c9f1d\', \'multiverseId\': 481799}, \'multiverseid\': 481799}, {\'name\': \'翔狮君王\', \'text\': \'飞行\\n你每操控一个具飞行异能的其他生物，翔狮君王便得+1/+1。\\n{2}{W}{U}：派出一个1/1白色，具飞行异能的猫／鸟衍生生物。\', \'type\': \'生物 ～元素／猫\', \'flavor\': \'翔空城从建立的第一天起就悬赏要拿下它的脑袋，但至今仍无人敢试。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482058&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a034d5fb-a36c-40a1-878e-e310f6848422\', \'multiverseId\': 482058}, \'multiverseid\': 482058}, {\'name\': \'翔獅君王\', \'text\': \'飛行\\n你每操控一個具飛行異能的其他生物，翔獅君王便得+1/+1。\\n{2}{W}{U}：派出一個1/1白色，具飛行異能的貓／鳥衍生生物。\', \'type\': \'生物 ～元素／貓\', \'flavor\': \'翔空城從建立的第一天起就懸賞要拿下牠的腦袋，但至今仍無人敢試。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482317&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4157c594-c045-42c9-b962-2db8a47d2176\', \'multiverseId\': 482317}, \'multiverseid\': 482317}]', '[{\'name\': \'Lukka, Verstoßener der Kupferjacken\', \'text\': \'+1: Schicke die obersten drei Karten deiner Bibliothek ins Exil. Kreaturenkarten, die auf diese Weise ins Exil geschickt wurden, erhalten: „Du kannst diese Karte aus dem Exil wirken, solange du einen Lukka-Planeswalker kontrollierst."\\n−2: Schicke eine Kreatur deiner Wahl, die du kontrollierst, ins Exil und decke dann Karten oben von deiner Bibliothek auf, bis du eine Kreaturenkarte mit höheren umgewandelten Manakosten aufdeckst. Bringe sie ins Spiel und lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.\\n−7: Jede Kreatur, die du kontrollierst, fügt jedem Gegner Schadenspunkte in Höhe ihrer Stärke zu.\', \'type\': \'Legendärer Planeswalker — Lukka\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479904&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3f721feb-85af-46c9-9fbd-f733e234cdab\', \'multiverseId\': 479904}, \'multiverseid\': 479904}, {\'name\': \'Lukka, paria de las Capas de Cobre\', \'text\': \'+1: Exilia las tres primeras cartas de tu biblioteca. Las cartas de criatura exiliadas de esta manera ganan "Puedes lanzar esta carta desde el exilio mientras controles un planeswalker Lukka".\\n−2: Exilia la criatura objetivo que controlas, luego muestra cartas de la parte superior de tu biblioteca hasta que muestres una carta de criatura con un coste de maná convertido más alto. Pon esa carta en el campo de batalla y el resto en el fondo de tu biblioteca en un orden aleatorio.\\n−7: Cada criatura que controlas hace una cantidad de daño igual a su fuerza a cada oponente.\', \'type\': \'Planeswalker legendario — Lukka\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480163&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'29a3329a-d18b-428a-aae5-71374f730b1d\', \'multiverseId\': 480163}, \'multiverseid\': 480163}, {\'name\': \'Lukka, proscrit des Capes de cuivre\', \'text\': "+1: Exilez les trois cartes du dessus de votre bibliothèque. Les cartes de créature exilées de cette manière acquièrent « Vous pouvez lancer cette carte depuis l\'exil tant que vous contrôlez un planeswalker Lukka. »\\n-2: Exilez une créature ciblée que vous contrôlez, puis révélez les cartes du dessus de votre bibliothèque jusqu\'à ce que vous révéliez une carte de créature avec un coût converti de mana supérieur. Mettez cette carte sur le champ de bataille et le reste au-dessous de votre bibliothèque dans un ordre aléatoire.\\n-7: Chaque créature que vous contrôlez inflige un nombre de blessures égal à sa force à chaque adversaire.", \'type\': \'Planeswalker légendaire : Lukka\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480422&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5cce9227-968e-4365-b17f-2f09d2218064\', \'multiverseId\': 480422}, \'multiverseid\': 480422}, {\'name\': \'Lukka, Reietto delle Giubbe Ramate\', \'text\': \'+1: Esilia le prime tre carte del tuo grimorio. Le carte creatura esiliate in questo modo hanno "Puoi lanciare questa carta dall\\\'esilio fintanto che controlli un planeswalker Lukka".\\n-2: Esilia una creatura bersaglio che controlli, poi rivela carte dalla cima del tuo grimorio finché non riveli una carta creatura con costo di mana convertito maggiore. Metti quella carta sul campo di battaglia e le altre in fondo al tuo grimorio in ordine casuale.\\n-7: Ogni creatura che controlli infligge danno pari alla sua forza a ogni avversario.\', \'type\': \'Planeswalker Leggendario — Lukka\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480681&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2a8cb7c9-c2fc-4a60-afbb-22a45a2766ba\', \'multiverseId\': 480681}, \'multiverseid\': 480681}, {\'name\': \'銅纏いののけ者、ルーカ\', \'text\': \'+1：あなたのライブラリーの一番上からカードを３枚追放する。これにより追放されたクリーチャー・カードは「あなたがルーカ・プレインズウォーカーをコントロールしているかぎり、あなたは追放領域からこのカードを唱えてもよい。」を得る。\\n-2：あなたがコントロールしているクリーチャー１体を対象とし、それを追放する。その後、点数で見たマナ・コストがそれよりも大きいクリーチャー・カードが公開されるまで、あなたのライブラリーの一番上からカードを１枚ずつ公開する。そのカードを戦場に出し、残りをあなたのライブラリーの一番下に無作為の順番で置く。\\n-7：あなたがコントロールしている各クリーチャーは各対戦相手に、それぞれ自身のパワーに等しい点数のダメージを与える。\', \'type\': \'伝説のプレインズウォーカー — ルーカ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480940&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'49492852-6cd0-4116-972b-d02eb034883b\', \'multiverseId\': 480940}, \'multiverseid\': 480940}, {\'name\': \'구리 코트 추방자, 루카\', \'text\': \'+1: 당신의 서고 맨 위 카드 세 장을 추방한다. 이런 식으로 추방된 생물 카드들은 "당신이 루카 플레인즈워커를 조종하는 한 당신은 이 카드를 추방 영역에서 발동할 수 있다."를 가진다.\\n−2: 당신이 조종하는 생물을 목표로 정한다. 그 생물을 추방한 후, 당신이 더 높은 전환마나비용을 가진 생물 카드를 공개할 때까지 당신의 서고 맨 위 카드를 공개한다. 그 카드를 전장에 놓고 나머지 카드들은 당신의 서고 맨 밑에 무작위로 놓는다.\\n−7: 당신이 조종하는 각 생물은 각 상대에게 자신의 공격력만큼 피해를 입힌다.\', \'type\': \'전설적 플레인즈워커 — 루카\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481199&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d4e915eb-53c4-4b94-a23a-fc6b4491a4c1\', \'multiverseId\': 481199}, \'multiverseid\': 481199}, {\'name\': \'Lukka, Pária Gibão de Cobre\', \'text\': \'+1: Exile os três cards do topo de seu grimório. Os cards de criatura exilados dessa forma ganham "Você pode conjurar este card do exílio enquanto controlar um planeswalker Lukka.".\\n−2: Exile a criatura alvo que você controla, depois revele cards do topo de seu grimório até revelar um card de criatura com custo de mana convertido mais alto. Coloque aquele card no campo de batalha e o restante no fundo de seu grimório em ordem aleatória.\\n−7: Cada criatura que você controla causa dano igual ao próprio poder a cada oponente.\', \'type\': \'Planeswalker Lendário — Lukka\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481458&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d8d63cd7-8da6-45d0-b50f-07eb4fc69e18\', \'multiverseId\': 481458}, \'multiverseid\': 481458}, {\'name\': \'Лукка, Изгой Медных Кителей\', \'text\': "+1: изгоните три верхние карты вашей библиотеки. Изгнанные таким образом карты существ получают способность «Вы можете разыграть эту карту из изгнания, пока вы контролируете planeswalker\'а Лукку».\\n−2: изгоните целевое существо под вашим контролем, затем показывайте карты с верха вашей библиотеки до тех пор, пока вы не покажете карту существа с более высокой конвертированной мана-стоимостью. Положите ту карту на поле битвы, а остальные — в низ вашей библиотеки в случайном порядке.\\n−7: каждое существо под вашим контролем наносит повреждения, равные своей силе, каждому оппоненту.", \'type\': \'Легендарный Planeswalker — Лукка\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481717&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'47ba1802-ca0f-4ece-a6c8-32d42bfe63d5\', \'multiverseId\': 481717}, \'multiverseid\': 481717}, {\'name\': \'紫铜军黜人卢卡\', \'text\': \'+1：放逐你牌库顶的三张牌。以此法放逐的生物牌获得「只要你操控卢卡鹏洛客，你便可以从放逐区施放此牌。」\\n−2：放逐目标由你操控的生物，然后从你的牌库顶开始展示牌，直到展示出一张总法术力费用大于该生物的生物牌为止。将该牌放进战场，并将其余的牌以随机顺序置于你的牌库底。\\n−7：每个由你操控的生物各向每位对手造成等同于自身力量的伤害。\', \'type\': \'传奇鹏洛客 ～卢卡\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481976&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fe80ad13-f787-446b-aeee-1095efba89e4\', \'multiverseId\': 481976}, \'multiverseid\': 481976}, {\'name\': \'紫銅軍黜人盧卡\', \'text\': \'+1：放逐你牌庫頂的三張牌。以此法放逐的生物牌獲得「只要你操控盧卡鵬洛客，你便可以從放逐區施放此牌。」\\n−2：放逐目標由你操控的生物，然後從你的牌庫頂開始展示牌，直到展示出一張總魔法力費用大於該生物的生物牌為止。將該牌放進戰場，並將其餘的牌以隨機順序置於你的牌庫底。\\n−7：每個由你操控的生物各向每位對手造成等同於自身力量的傷害。\', \'type\': \'傳奇鵬洛客 ～盧卡\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482235&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'72e59d42-a402-4e03-bd12-533c9fdaea77\', \'multiverseId\': 482235}, \'multiverseid\': 482235}]', '[{\'name\': \'Lurrus aus der Traumhöhle\', \'text\': \'Gefährte — Jede bleibende Karte in deinem Startdeck hat umgewandelte Manakosten von 2 oder weniger. (Falls du diese Karte als deinen Gefährten erwählt hast, kannst du sie einmal von außerhalb der Partie wirken.)\\nLebensverknüpfung\\nWährend jedes deiner Züge kannst du einen Bleibende-Karte-Zauberspruch mit umgewandelten Manakosten von 2 oder weniger aus deinem Friedhof wirken.\', \'type\': \'Legendäre Kreatur — Katze, Nachtmahr\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480005&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6f9e8c41-cacf-4ba7-a16d-2e24f879821b\', \'multiverseId\': 480005}, \'multiverseid\': 480005}, {\'name\': \'Lurrus del Nido de Ensueño\', \'text\': \'Compañero — Cada carta de permanente en tu mazo inicial tiene un coste de maná convertido de 2 o menos. (Si esta carta es el compañero que eliges, puedes lanzarla una vez desde fuera del juego.)\\nVínculo vital.\\nDurante cada uno de tus turnos, puedes lanzar un hechizo de permanente con coste de maná convertido de 2 o menos desde tu cementerio.\', \'type\': \'Criatura legendaria — Pesadilla felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480264&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'36f1cdba-1596-49f9-84ab-02e8abf4cebe\', \'multiverseId\': 480264}, \'multiverseid\': 480264}, {\'name\': \'Lurrus de la Tanière des rêves\', \'text\': "Compagnon — Chaque carte de permanent de votre deck de départ a un coût converti de mana inférieur ou égal à 2. (Si cette carte est le compagnon de votre choix, vous pouvez la lancer une fois depuis l\'extérieur de la partie.)\\nLien de vie\\nPendant chacun de vos tours, vous pouvez lancer un sort de permanent avec un coût converti de mana inférieur ou égal à 2 depuis votre cimetière.", \'type\': \'Créature légendaire : chat et cauchemar\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480523&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'11f32b9b-b3a2-45d7-b36f-7f03b6bc9b3f\', \'multiverseId\': 480523}, \'multiverseid\': 480523}, {\'name\': \'Lurrus della Tana Onirica\', \'text\': \'Compagno — Ogni carta permanente nel tuo mazzo iniziale ha un costo di mana convertito pari o inferiore a 2. (Se questa carta è il compagno che hai scelto, puoi lanciarla una volta dal di fuori della partita.)\\nLegame vitale\\nDurante ogni tuo turno, puoi lanciare una magia permanente con costo di mana convertito pari o inferiore a 2 dal tuo cimitero.\', \'type\': \'Creatura Leggendaria — Incubo Felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480782&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d6c9a553-02d6-475f-bbfc-8f10e27ef6ab\', \'multiverseId\': 480782}, \'multiverseid\': 480782}, {\'name\': \'夢の巣のルールス\', \'text\': \'相棒 ― あなたの開始時のデッキに入っている各パーマネント・カードが、それぞれ点数で見たマナ・コストが２以下であること。（このカードがあなたの選んだ相棒であるなら、あなたは１回のみゲームの外部からこれを唱えてもよい。）\\n絆魂\\nあなたの各ターンの間、あなたはあなたの墓地から点数で見たマナ・コストが２以下のパーマネント・呪文を１つ唱えてもよい。\', \'type\': \'伝説のクリーチャー — 猫・ナイトメア\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481041&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'be705aa1-d60f-47d6-9364-adc3b0d25346\', \'multiverseId\': 481041}, \'multiverseid\': 481041}, {\'name\': \'꿈 소굴의 루러스\', \'text\': \'단짝— 당신의 시작 덱에 들어 있는 각 지속물 카드는 전환마나비용이 2 이하이다. (이 카드가 당신이 선택한 단짝이라면, 당신은 이 카드를 게임 밖에서 한 번 발동할 수 있다.)\\n생명연결\\n당신의 각 턴 동안, 당신은 당신의 무덤에서 전환마나비용이 2 이하인 지속물 주문을 한 개 발동할 수 있다.\', \'type\': \'전설적 생물 — 고양이 나이트메어\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481300&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ab6b0480-783d-4235-83b1-315647b899db\', \'multiverseId\': 481300}, \'multiverseid\': 481300}, {\'name\': \'Lurrus da Toca Onírica\', \'text\': \'Companheiro — Cada card de permanente em seu deck inicial tem custo de mana convertido igual ou inferior a 2. (Se este card for o companheiro que escolheu, você poderá conjurá-lo uma vez de fora do jogo.)\\nVínculo com a vida\\nDurante cada um de seus turnos, você pode conjurar uma mágica de permanente com custo de mana convertido igual ou inferior a 2 do seu cemitério.\', \'type\': \'Criatura Lendária — Felino Pesadelo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481559&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dfb199c8-c5fa-49ac-8190-158a78caf82a\', \'multiverseId\': 481559}, \'multiverseid\': 481559}, {\'name\': \'Луррус из Логова Грез\', \'text\': \'Компаньон — Конвертированная мана-стоимость каждой карты перманента в вашей начальной колоде не превышает 2. (Если эта карта является вашим избранным Компаньоном, то вы можете один раз разыграть ее из-за пределов игры.)\\nЦепь жизни\\nВо время каждого из ваших ходов вы можете разыграть одно заклинание перманента с конвертированной мана-стоимостью не более 2 из вашего кладбища.\', \'type\': \'Легендарное Существо — Кошка Кошмар\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481818&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'02f5835a-341e-44e1-8014-9914d10bc7a0\', \'multiverseId\': 481818}, \'multiverseid\': 481818}, {\'name\': \'梦巢猫魇路拉斯\', \'text\': \'行侣～你起始套牌中各永久物牌的总法术力费用均为2或更少。（如果你选择这张牌作为你的行侣，则你可以从游戏外施放它，但仅限一次。）\\n系命\\n于你的每个回合中，你可以从你的坟墓场中施放一个总法术力费用等于或小于2的永久物咒语。\', \'type\': \'传奇生物 ～猫／梦魇\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482077&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e6821506-b6c0-44cc-b672-a797e787fa62\', \'multiverseId\': 482077}, \'multiverseid\': 482077}, {\'name\': \'夢巢貓魘路拉斯\', \'text\': \'行侶～你起始套牌中各永久物牌的總魔法力費用均為2或更少。（如果你選擇這張牌作為你的行侶，則你可以從遊戲外施放它，但僅限一次。）\\n繫命\\n於你的每個回合中，你可以從你的墳墓場中施放一個總魔法力費用等於或小於2的永久物咒語。\', \'type\': \'傳奇生物 ～貓／夢魘\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482336&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'320f0ce4-19bf-4167-a2e9-d26d7f65eec1\', \'multiverseId\': 482336}, \'multiverseid\': 482336}]', '[{\'name\': \'Lutri der Zauberbalger\', \'text\': \'Gefährte — Alle Nichtland-Karten in deinem Startdeck haben unterschiedliche Namen. (Falls du diese Karte als deinen Gefährten erwählt hast, kannst du sie einmal von außerhalb der Partie wirken.)\\nAufblitzen\\nWenn Lutri der Zauberbalger ins Spiel kommt und falls du ihn gewirkt hast, kopiere einen Spontanzauber oder eine Hexerei deiner Wahl, den bzw. die du kontrollierst. Du kannst neue Ziele für die Kopie bestimmen.\', \'type\': \'Legendäre Kreatur — Elementarwesen, Otter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480006&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'22b04c6d-b161-4fd1-8f46-5b95b8f3739f\', \'multiverseId\': 480006}, \'multiverseid\': 480006}, {\'name\': \'Lutri, Buscahechizos\', \'text\': \'Compañero — Cada carta que no sea tierra en tu mazo inicial tiene un nombre diferente. (Si esta carta es el compañero que eliges, puedes lanzarla una vez desde fuera del juego.)\\nDestello.\\nCuando Lutri, Buscahechizos entre al campo de batalla, si lo lanzaste, copia el hechizo de instantáneo o de conjuro objetivo que controlas. Puedes elegir nuevos objetivos para la copia.\', \'type\': \'Criatura legendaria — Nutria elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480265&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ff34df23-4ecb-471e-851b-f4086788eecd\', \'multiverseId\': 480265}, \'multiverseid\': 480265}, {\'name\': \'Lutri, le chasse-sorts\', \'text\': "Compagnon — Chaque carte non-terrain dans votre deck de départ a un nom différent. (Si cette carte est le compagnon de votre choix, vous pouvez la lancer une fois depuis l\'extérieur de la partie.)\\nFlash\\nQuand Lutri, le chasse-sorts arrive sur le champ de bataille, si vous l\'avez lancé, copiez un sort d\'éphémère ou de rituel ciblé que vous contrôlez. Vous pouvez choisir de nouvelles cibles pour cette copie.", \'type\': \'Créature légendaire : élémental et loutre\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480524&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'10ecaae2-837a-43c0-b2eb-5a11b6864368\', \'multiverseId\': 480524}, \'multiverseid\': 480524}, {\'name\': \'Lutri, il Rincorrimagie\', \'text\': "Compagno — Ogni carta non terra nel tuo mazzo iniziale ha un nome diverso. (Se questa carta è il compagno che hai scelto, puoi lanciarla una volta dal di fuori della partita.)\\nLampo\\nQuando Lutri, il Rincorrimagie entra nel campo di battaglia, se l\'hai lanciato, copia una magia istantaneo o stregoneria bersaglio che controlli. Puoi scegliere nuovi bersagli per la copia.", \'type\': \'Creatura Leggendaria — Lontra Elementale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480783&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'552a9705-c295-4f11-88f1-fee538a28d6a\', \'multiverseId\': 480783}, \'multiverseid\': 480783}, {\'name\': \'呪文追い、ルーツリー\', \'text\': \'相棒 ― あなたの開始時のデッキに入っている土地でない各カードが、それぞれ異なる名前を持っていること。（このカードがあなたの選んだ相棒であるなら、あなたは１回のみゲームの外部からこれを唱えてもよい。）\\n瞬速\\n呪文追い、ルーツリーが戦場に出たとき、あなたがこれを唱えていた場合、あなたがコントロールしていてインスタントかソーサリーである呪文１つを対象とし、それをコピーする。あなたはそのコピーの新しい対象を選んでもよい。\', \'type\': \'伝説のクリーチャー — エレメンタル・カワウソ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481042&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e965c04c-0e05-4f83-9683-dd8f63861e0d\', \'multiverseId\': 481042}, \'multiverseid\': 481042}, {\'name\': \'주문추적자, 루트리\', \'text\': \'단짝 — 당신의 시작 덱에 들어 있는 대지가 아닌 각 카드는 서로 이름이 다르다. (이 카드가 당신이 선택한 단짝이라면, 당신은 이 카드를 게임 밖에서 한 번 발동할 수 있다.)\\n섬광\\n주문추적자, 루트리가 전장에 들어올 때, 당신이 루트리를 발동했다면, 당신이 조종하는 순간마법 또는 집중마법 주문을 목표로 정한다. 그 주문을 복사한다. 당신은 그 복사본의 목표를 새로 정할 수 있다.\', \'type\': \'전설적 생물 — 정령 수달\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481301&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4905a026-8e03-489c-a9b3-098ef88861df\', \'multiverseId\': 481301}, \'multiverseid\': 481301}, {\'name\': \'Lutri, o Catamágicas\', \'text\': \'Companheiro — Cada card em seu deck inicial que não seja um terreno tem um nome diferente. (Se este card for o companheiro que escolheu, você poderá conjurá-lo uma vez de fora do jogo.)\\nLampejo\\nQuando Lutri, o Catamágicas, entrar no campo de batalha, se você o tiver conjurado, copie a mágica instantânea ou o feitiço alvo que você controla. Você pode escolher novos alvos para a cópia.\', \'type\': \'Criatura Lendária — Elemental Lontra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481560&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6cab8d81-a5b9-4f78-9788-5fec88ce7274\', \'multiverseId\': 481560}, \'multiverseid\': 481560}, {\'name\': \'Лутри, Ловчая Заклинаний\', \'text\': \'Компаньон — У всех не являющихся землями карт в вашей начальной колоде различные имена. (Если эта карта является вашим избранным Компаньоном, то вы можете один раз разыграть ее из-за пределов игры.)\\nМиг\\nКогда Лутри, Ловчая Заклинаний выходит на поле битвы, если вы разыграли ее, то скопируйте целевое мгновенное заклинание или заклинание волшебства под вашим контролем. Вы можете выбрать новые цели для той копии.\', \'type\': \'Легендарное Существо — Элементаль Выдра\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481819&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a4e156f6-fdf9-4203-b48d-fab5f4fa5d75\', \'multiverseId\': 481819}, \'multiverseid\': 481819}, {\'name\': \'逐咒獭灵拉翠\', \'text\': \'行侣～你起始套牌中各非地牌的名称均不相同。（如果你选择这张牌作为你的行侣，则你可以从游戏外施放它，但仅限一次。）\\n闪现\\n当逐咒獭灵拉翠进战场时，若它是由你施放，则复制目标由你操控的瞬间或法术咒语。你可以为该复制品选择新的目标。\', \'type\': \'传奇生物 ～元素／水獭\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482078&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b957fbbf-7c4e-4557-b6f6-c539e777e7fa\', \'multiverseId\': 482078}, \'multiverseid\': 482078}, {\'name\': \'逐咒獺靈拉翠\', \'text\': \'行侶～你起始套牌中各非地牌的名稱均不相同。（如果你選擇這張牌作為你的行侶，則你可以從遊戲外施放它，但僅限一次。）\\n閃現\\n當逐咒獺靈拉翠進戰場時，若它是由你施放，則複製目標由你操控的瞬間或巫術咒語。你可以為該複製品選擇新的目標。\', \'type\': \'傳奇生物 ～元素／水獺\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482337&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f411a94d-9aca-4bc9-8e65-c6ca3f364697\', \'multiverseId\': 482337}, \'multiverseid\': 482337}]', '[{\'name\': \'Majestätisches Goldhorn\', \'text\': \'Mutation {3}{W} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\nWachsamkeit\\nImmer wenn diese Kreatur mutiert, erhältst du 4 Lebenspunkte dazu.\', \'type\': \'Kreatur — Einhorn\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479801&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'55bf90d8-4066-4459-9902-a1a3f44a126f\', \'multiverseId\': 479801}, \'multiverseid\': 479801}, {\'name\': \'Auricornio majestuoso\', \'text\': \'Mutación {3}{W}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\nVigilancia.\\nSiempre que esta criatura mute, ganas 4 vidas.\', \'type\': \'Criatura — Unicornio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480060&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9cc33107-b63e-41e4-9c12-bd97d6cc5d16\', \'multiverseId\': 480060}, \'multiverseid\': 480060}, {\'name\': \'Auricorne majestueux\', \'text\': "Mutation {3}{W} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\nVigilance\\nÀ chaque fois que cette créature subit une mutation, vous gagnez 4 points de vie.", \'type\': \'Créature : licorne\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480319&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b997b956-bd0e-411c-bfd7-0c2954322428\', \'multiverseId\': 480319}, \'multiverseid\': 480319}, {\'name\': \'Auricorno Maestoso\', \'text\': \'Mutazione {3}{W} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\nCautela\\nOgniqualvolta questa creatura muta, guadagni 4 punti vita.\', \'type\': \'Creatura — Unicorno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480578&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1f2a918e-5792-44e4-ad70-f88fadd95dc7\', \'multiverseId\': 480578}, \'multiverseid\': 480578}, {\'name\': \'壮麗な金角獣\', \'text\': \'変容{3}{W}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\n警戒\\nこのクリーチャーが変容するたび、あなたは４点のライフを得る。\', \'type\': \'クリーチャー — ユニコーン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480837&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'74f03c1f-bb04-4fb5-bada-9056ee67a3b1\', \'multiverseId\': 480837}, \'multiverseid\': 480837}, {\'name\': \'위풍당당한 황금유니콘\', \'text\': \'돌연변이화 {3}{W} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n경계\\n이 생물이 돌연변이화할 때마다, 당신은 생명 4점을 얻는다.\', \'type\': \'생물 — 유니콘\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481096&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a323e500-1d22-4136-82c8-4a64416af3bf\', \'multiverseId\': 481096}, \'multiverseid\': 481096}, {\'name\': \'Auricórnio Majestoso\', \'text\': \'Mutação {3}{W} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\nVigilância\\nToda vez que esta criatura sofre mutação, você ganha 4 pontos de vida.\', \'type\': \'Criatura — Unicórnio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481355&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'49b143ab-95c7-4989-923b-1623085c7764\', \'multiverseId\': 481355}, \'multiverseid\': 481355}, {\'name\': \'Величественный Золоторог\', \'text\': \'Мутация {3}{W} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\nБдительность\\nКаждый раз, когда это существо мутирует, вы получаете 4 жизни.\', \'type\': \'Существо — Единорог\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481614&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a097be9c-9041-4c22-84fd-e39f107f8c0f\', \'multiverseId\': 481614}, \'multiverseid\': 481614}, {\'name\': \'威仪金角兽\', \'text\': \'合变{3}{W}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n警戒\\n每当此生物合变时，你获得4点生命。\', \'type\': \'生物 ～独角兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481873&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'eb60d079-fcd1-4077-b917-9d4c9abebf13\', \'multiverseId\': 481873}, \'multiverseid\': 481873}, {\'name\': \'威儀金角獸\', \'text\': \'合變{3}{W}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n警戒\\n每當此生物合變時，你獲得4點生命。\', \'type\': \'生物 ～獨角獸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482132&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d71f65f0-1da0-4a80-bab5-958807685dde\', \'multiverseId\': 482132}, \'multiverseid\': 482132}]', '[{\'name\': \'Marschall der Tagwache\', \'text\': \'Wenn der Marschall der Tagwache ins Spiel kommt, erzeuge einen 1/1 weißen Mensch-Soldat-Kreaturenspielstein.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'„Die Nacht ermutigt viele Monster, aber die mächtigsten greifen am helllichten Tag an."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479787&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'60634cf4-7cc6-4ebd-aadc-f76ed6816212\', \'multiverseId\': 479787}, \'multiverseid\': 479787}, {\'name\': \'Mariscal de la brigada diurna\', \'text\': \'Cuando la Mariscal de la brigada diurna entre al campo de batalla, crea una ficha de criatura Soldado Humano blanca 1/1.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'"La noche anima a salir a muchos monstruos, pero los más poderosos atacan a plena luz del día".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480046&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3aa2ed64-bd52-42ef-8e5a-4115a75f4318\', \'multiverseId\': 480046}, \'multiverseid\': 480046}, {\'name\': "Maréchale de l\'escouade diurne", \'text\': "Quand la Maréchale de l\'escouade diurne arrive sur le champ de bataille, créez un jeton de créature 1/1 blanche Humain et Soldat.", \'type\': \'Créature : humain et soldat\', \'flavor\': \'« Beaucoup de monstres profitent de la nuit, mais les plus puissants attaquent en plein jour. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480305&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1e1b8510-4c66-477a-b0b7-caba6faa5347\', \'multiverseId\': 480305}, \'multiverseid\': 480305}, {\'name\': \'Marescialla dello Squadrone Diurno\', \'text\': \'Quando la Marescialla dello Squadrone Diurno entra nel campo di battaglia, crea una pedina creatura Soldato Umano 1/1 bianca.\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'"La notte rende molti mostri audaci, ma i più potenti attaccano in pieno giorno."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480564&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1e5ebd86-73eb-43fd-a601-e2959dd12965\', \'multiverseId\': 480564}, \'multiverseid\': 480564}, {\'name\': \'日勤隊の指揮官\', \'text\': \'日勤隊の指揮官が戦場に出たとき、白の１/１の人間・兵士・クリーチャー・トークンを１体生成する。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'「夜は多くの怪物に力を与える。しかし最も強いものは白昼堂々やってくるだろう。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480823&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d744635e-58c9-40a2-a369-cade1ddd13dc\', \'multiverseId\': 480823}, \'multiverseid\': 480823}, {\'name\': \'낮 부대 집행관\', \'text\': \'낮 부대 집행관이 전장에 들어올 때, 1/1 백색 인간 병사 생물 토큰 한 개를 만든다.\', \'type\': \'생물 — 인간 병사\', \'flavor\': \'"밤은 수많은 괴수들을 대담하게 만들지만, 가장 강력한 놈들은 밝은 대낮에 공격해 온다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481082&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ec4c80e1-47d5-4b37-858f-6179475383be\', \'multiverseId\': 481082}, \'multiverseid\': 481082}, {\'name\': \'Marechal do Esquadrão Diurno\', \'text\': \'Quando Marechal do Esquadrão Diurno entrar no campo de batalha, crie uma ficha de criatura branca 1/1 do tipo Humano Soldado.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': \'"A noite dá coragem a muitos monstros, mas os mais fortes atacam à luz do dia."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481341&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'de400752-d2b0-4b16-8413-94dcd3b481bb\', \'multiverseId\': 481341}, \'multiverseid\': 481341}, {\'name\': \'Начальница Дневного Отряда\', \'text\': \'Когда Начальница Дневного Отряда выходит на поле битвы, создайте одну фишку существа 1/1 белый Человек Солдат.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'«Многие чудовища ночью становятся смелее, но самые могучие нападают при свете дня».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481600&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9c0ba3b0-81f4-4ad3-bbb1-16503934e0df\', \'multiverseId\': 481600}, \'multiverseid\': 481600}, {\'name\': \'昼班队元帅\', \'text\': \'当昼班队元帅进战场时，派出一个1/1白色人类／士兵衍生生物。\', \'type\': \'生物 ～人类／士兵\', \'flavor\': \'「虽然不少怪兽会借夜幕壮胆，但最强大者敢在光天化日下来袭。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481859&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c3ba1fde-7c80-46fd-8511-a5e2562c28cc\', \'multiverseId\': 481859}, \'multiverseid\': 481859}, {\'name\': \'晝班隊元帥\', \'text\': \'當晝班隊元帥進戰場時，派出一個1/1白色人類／士兵衍生生物。\', \'type\': \'生物 ～人類／士兵\', \'flavor\': \'「雖然不少怪獸會借夜幕壯膽，但最強大者敢在光天化日下來襲。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482118&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ee9e7b8e-e6bd-4742-8b81-34eeec0a9eaa\', \'multiverseId\': 482118}, \'multiverseid\': 482118}]', '[{\'name\': \'Massenaussterben\', \'text\': \'Bestimme gerade oder ungerade. Schicke alle Kreaturen, deren umgewandelte Manakosten dem bestimmten Merkmal entsprechen, ins Exil. (Null zählt als gerade.)\', \'type\': \'Hexerei\', \'flavor\': \'„Die Natur ist gnadenloser als jeder Jäger, den ich je kannte."\\n—Zai, Hauptmann der Nachtwache\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479867&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0b27b584-d81b-43cd-a334-655469ec27d9\', \'multiverseId\': 479867}, \'multiverseid\': 479867}, {\'name\': \'Acontecimiento de extinción\', \'text\': \'Elige par o impar. Exilia cada criatura con coste de maná convertido del valor elegido. (Cero es par.)\', \'type\': \'Conjuro\', \'flavor\': \'"La naturaleza es más despiadada que cualquier cazador que haya conocido".\\n—Zai, capitán de la brigada nocturna\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480126&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'76ea0476-1707-42a1-9714-17e86fce72a8\', \'multiverseId\': 480126}, \'multiverseid\': 480126}, {\'name\': "Événement d\'extinction", \'text\': \'Choisissez pair ou impair. Exilez chaque créature ayant un coût converti de mana de la valeur choisie. (Zéro est pair.)\', \'type\': \'Rituel\', \'flavor\': "« La nature est moins clémente que tous les chasseurs que j\'ai pu connaître. »\\n—Zaï, capitaine de l\'escouade nocturne", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480385&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'33efcb2d-ff50-4ff2-9f4e-ab9816fd05a3\', \'multiverseId\': 480385}, \'multiverseid\': 480385}, {\'name\': \'Evento di Estinzione\', \'text\': \'Scegli pari o dispari. Esilia ogni creatura con il costo di mana convertito scelto. (0 è pari.)\', \'type\': \'Stregoneria\', \'flavor\': \'"La natura è più spietata di qualsiasi cacciatore che abbia mai conosciuto."\\n—Zai, capitano dello squadrone notturno\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480644&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d966ecc8-a8f9-4877-8ee8-5746e5c2b86f\', \'multiverseId\': 480644}, \'multiverseid\': 480644}, {\'name\': \'絶滅の契機\', \'text\': \'奇数か偶数を選ぶ。点数で見たマナ・コストがその選ばれた値である各クリーチャーをそれぞれ追放する。（０は偶数である。）\', \'type\': \'ソーサリー\', \'flavor\': \'「自然は私の知るどんな狩人よりも無慈悲だ。」\\n――夜勤隊長、ザイ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480903&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c7f7d3dd-f348-4359-ad5c-9eeb0f35edee\', \'multiverseId\': 480903}, \'multiverseid\': 480903}, {\'name\': \'멸종 사건\', \'text\': \'홀수 또는 짝수를 선택한다. 선택한 값과 같은 전환마나비용을 가진 각 생물을 추방한다. (0은 짝수로 취급한다.)\', \'type\': \'집중마법\', \'flavor\': \'"자연이야말로 내가 알고 있는 그 어떤 사냥꾼보다도 가차없지."\\n—밤 부대 대장, 자이\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481162&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'aaa87154-2f30-4b47-9236-8d8bb1267a84\', \'multiverseId\': 481162}, \'multiverseid\': 481162}, {\'name\': \'Evento de Extinção\', \'text\': \'Escolha par ou ímpar. Exile cada criatura com custo de mana convertido do valor escolhido. (Zero é par.)\', \'type\': \'Feitiço\', \'flavor\': \'"A natureza é mais impiedosa do que qualquer caçador que eu conheça."\\n— Zai, capitão do esquadrão noturno\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481421&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1674d831-452e-4709-818e-2542f9d8497a\', \'multiverseId\': 481421}, \'multiverseid\': 481421}, {\'name\': \'Вымирание\', \'text\': \'Выберите чет или нечет. Изгоните каждое существо с конвертированной мана-стоимостью, соответствующей выбранному значению. (Ноль является четным числом.)\', \'type\': \'Волшебство\', \'flavor\': \'«Природа безжалостнее любого охотника, которого я знаю».\\n— Зей, капитан ночного отряда\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481680&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'99526e18-5700-4578-a4e5-0b92e83a3401\', \'multiverseId\': 481680}, \'multiverseid\': 481680}, {\'name\': \'生灵绝灭\', \'text\': \'选择奇数或偶数。放逐所有总法术力费用是该种数值的生物。（零是偶数。）\', \'type\': \'法术\', \'flavor\': \'「大自然比我认识的所有猎人都要无情。」\\n～夜班队长泽耶\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481939&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d8cb4f8b-4b30-4351-9f86-44adda95e0d7\', \'multiverseId\': 481939}, \'multiverseid\': 481939}, {\'name\': \'生靈絕滅\', \'text\': \'選擇奇數或偶數。放逐所有總魔法力費用是該種數值的生物。（零是偶數。）\', \'type\': \'巫術\', \'flavor\': \'「大自然比我認識的所有獵人都要無情。」\\n～夜班隊長澤耶\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482198&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3a4af829-0aa1-482c-b2d3-3ead13bcdf97\', \'multiverseId\': 482198}, \'multiverseid\': 482198}]', '[{\'name\': \'Meeresflitzer-Oktopus\', \'text\': \'Mutation {1}{U} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\nAufblitzen\\nImmer wenn diese Kreatur einem Spieler Kampfschaden zufügt, ziehe eine Karte.\', \'type\': \'Kreatur — Oktopus\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479845&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'060c6f7a-fd0a-491b-927a-7ff17ea14e7d\', \'multiverseId\': 479845}, \'multiverseid\': 479845}, {\'name\': \'Pulpo corremares\', \'text\': \'Mutación {1}{U}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\nDestello.\\nSiempre que esta criatura haga daño de combate a un jugador, roba una carta.\', \'type\': \'Criatura — Pulpo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480104&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'56504aef-321f-4157-889d-529e644695d4\', \'multiverseId\': 480104}, \'multiverseid\': 480104}, {\'name\': \'Pieuvre fonceuse des mers\', \'text\': "Mutation {1}{U} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\nFlash\\nÀ chaque fois que cette créature inflige des blessures de combat à un joueur, piochez une carte.", \'type\': \'Créature : pieuvre\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480363&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d63bea9f-f877-45b4-ac1d-6a1541465500\', \'multiverseId\': 480363}, \'multiverseid\': 480363}, {\'name\': \'Piovra Balzaonde\', \'text\': \'Mutazione {1}{U} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\nLampo\\nOgniqualvolta questa creatura infligge danno da combattimento a un giocatore, pesca una carta.\', \'type\': \'Creatura — Piovra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480622&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'98f3df6d-99a5-4f79-ab38-3930530c69bd\', \'multiverseId\': 480622}, \'multiverseid\': 480622}, {\'name\': \'海駆けダコ\', \'text\': \'変容{1}{U}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\n瞬速\\nこのクリーチャーがプレイヤー１人に戦闘ダメージを与えるたび、カードを１枚引く。\', \'type\': \'クリーチャー — タコ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480881&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c4ea93c7-332b-4abc-856f-8101dfcb2da0\', \'multiverseId\': 480881}, \'multiverseid\': 480881}, {\'name\': \'바다를 질주하는 문어\', \'text\': \'돌연변이화 {1}{U} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n섬광\\n이 생물이 플레이어에게 전투피해를 입힐 때마다, 카드 한 장을 뽑는다.\', \'type\': \'생물 — 문어\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481140&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'20dbeac2-be02-40ab-954e-514c041ccade\', \'multiverseId\': 481140}, \'multiverseid\': 481140}, {\'name\': \'Polvo Flecha-do-mar\', \'text\': \'Mutação {1}{U} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\nLampejo\\nToda vez que esta criatura causar dano de combate a um jogador, compre um card.\', \'type\': \'Criatura — Polvo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481399&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0b196f10-1439-4d36-9a04-3a1b5e359834\', \'multiverseId\': 481399}, \'multiverseid\': 481399}, {\'name\': \'Стремительный Спрут\', \'text\': \'Мутация {1}{U} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\nМиг\\nКаждый раз, когда это существо наносит боевые повреждения игроку, возьмите карту.\', \'type\': \'Существо — Спрут\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481658&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bab51a0a-5a72-4d8c-87fb-fcc2b5baa001\', \'multiverseId\': 481658}, \'multiverseid\': 481658}, {\'name\': \'迅浪章鱼\', \'text\': \'合变{1}{U}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n闪现\\n每当此生物对任一牌手造成战斗伤害时，抓一张牌。\', \'type\': \'生物 ～章鱼\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481917&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'55a0b20d-aa22-4589-96ee-8b0a9f59a3a5\', \'multiverseId\': 481917}, \'multiverseid\': 481917}, {\'name\': \'迅浪章魚\', \'text\': \'合變{1}{U}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n閃現\\n每當此生物對任一玩家造成戰鬥傷害時，抽一張牌。\', \'type\': \'生物 ～章魚\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482176&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f7befbfa-7ee8-4b9a-ab13-280727ac23f0\', \'multiverseId\': 482176}, \'multiverseid\': 482176}]', '[{\'name\': \'Migrationspfad\', \'text\': \'Durchsuche deine Bibliothek nach bis zu zwei Standardland-Karten, bringe sie getappt ins Spiel und mische dann deine Bibliothek.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479943&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'aecb6117-a95c-45c1-a447-58843e5d925c\', \'multiverseId\': 479943}, \'multiverseid\': 479943}, {\'name\': \'Camino migratorio\', \'text\': \'Busca en tu biblioteca hasta dos cartas de tierra básica, ponlas en el campo de batalla giradas y luego baraja tu biblioteca.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480202&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7b00966c-cdbb-4072-bfdb-365a2a795722\', \'multiverseId\': 480202}, \'multiverseid\': 480202}, {\'name\': \'Voie migratoire\', \'text\': "Cherchez dans votre bibliothèque jusqu\'à deux cartes de terrain de base, mettez-les sur le champ de bataille engagées et mélangez ensuite votre bibliothèque.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480461&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2ba0fa1c-9ba8-4935-aa41-bdf795bae002\', \'multiverseId\': 480461}, \'multiverseid\': 480461}, {\'name\': \'Percorso Migratorio\', \'text\': \'Passa in rassegna il tuo grimorio per trovare fino a due carte terra base, mettile sul campo di battaglia TAPpate, poi rimescola il tuo grimorio.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480720&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1ad7d684-0121-45fb-a294-15aef52eb6b2\', \'multiverseId\': 480720}, \'multiverseid\': 480720}, {\'name\': \'移動経路\', \'text\': \'あなたのライブラリーから基本土地・カード最大２枚を探し、タップ状態で戦場に出し、その後あなたのライブラリーを切り直す。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480979&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8f024f2b-9dd3-4bf5-9ac2-a2c374c29dc0\', \'multiverseId\': 480979}, \'multiverseid\': 480979}, {\'name\': \'이주 경로\', \'text\': \'당신의 서고에서 기본 대지 카드를 최대 두 장까지 찾아, 탭된 채로 전장에 놓은 후, 당신의 서고를 섞는다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481238&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b97c0057-402d-406f-a76e-60b406aee9bf\', \'multiverseId\': 481238}, \'multiverseid\': 481238}, {\'name\': \'Trilha de Migração\', \'text\': \'Procure até dois cards de terreno básico em seu grimório, coloque-os no campo de batalha virados e, depois, embaralhe seu grimório.\\nReciclar {2} ({2}, descarte este card: Compre um card.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481497&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0c215e3a-6693-4f33-855c-7346e773d3ae\', \'multiverseId\': 481497}, \'multiverseid\': 481497}, {\'name\': \'Путь Миграции\', \'text\': \'Найдите в вашей библиотеке не более двух карт базовых земель, положите их на поле битвы повернутыми, затем перетасуйте вашу библиотеку.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481756&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5ccbdd34-04e8-4d24-9e7a-98d8fa99dd25\', \'multiverseId\': 481756}, \'multiverseid\': 481756}, {\'name\': \'迁徙路径\', \'text\': \'从你的牌库中搜寻至多两张基本地牌，将它们横置放进战场，然后将你的牌库洗牌。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482015&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4661adcb-5502-4bb0-94f0-a7f40b4d4ca1\', \'multiverseId\': 482015}, \'multiverseid\': 482015}, {\'name\': \'遷徙路徑\', \'text\': \'從你的牌庫中搜尋至多兩張基本地牌，將它們橫置放進戰場，然後將你的牌庫洗牌。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482274&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'546dc7d0-314a-474d-8aad-09bd0a9f815a\', \'multiverseId\': 482274}, \'multiverseid\': 482274}]', '[{\'name\': \'Monstergeschoss\', \'text\': \'{2}, opfere eine Kreatur: Das Monstergeschoss fügt einem Ziel deiner Wahl 2 Schadenspunkte zu.\', \'type\': \'Verzauberung\', \'flavor\': \'Rache ist ein Pfad, der letztendlich allein beschritten wird.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479919&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'52b56eb1-b602-455c-a74d-b3fd336868af\', \'multiverseId\': 479919}, \'multiverseid\': 479919}, {\'name\': \'Monstruos como armas\', \'text\': \'{2}, sacrificar una criatura: Monstruos como armas hace 2 puntos de daño a cualquier objetivo.\', \'type\': \'Encantamiento\', \'flavor\': \'La venganza es un camino que solo se puede recorrer en solitario.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480178&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3702d50f-3f1b-488a-b367-06b9a90c859b\', \'multiverseId\': 480178}, \'multiverseid\': 480178}, {\'name\': \'Arsenaliser les monstres\', \'text\': "{2}, sacrifiez une créature : Arsenaliser les monstres inflige 2 blessures à n\'importe quelle cible.", \'type\': \'Enchantement\', \'flavor\': \'La vengeance est un chemin qui se parcourt toujours seul.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480437&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ecaf30d9-7b69-469b-849e-01c45dddadb4\', \'multiverseId\': 480437}, \'multiverseid\': 480437}, {\'name\': \'Armarsi di Mostri\', \'text\': \'{2}, Sacrifica una creatura: Armarsi di Mostri infligge 2 danni a un qualsiasi bersaglio.\', \'type\': \'Incantesimo\', \'flavor\': \'La vendetta è un cammino inevitabilmente percorso da soli.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480696&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'44c32537-a287-4b08-9ceb-158fc70a286d\', \'multiverseId\': 480696}, \'multiverseid\': 480696}, {\'name\': \'怪物の兵器化\', \'text\': \'{2}, クリーチャー１体を生け贄に捧げる：クリーチャー１体かプレインズウォーカー１体かプレイヤー１人を対象とする。怪物の兵器化はそれに２点のダメージを与える。\', \'type\': \'エンチャント\', \'flavor\': \'復讐とは、一人で歩むしかない道だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480955&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'85457d0b-7db8-411d-8352-370069b416c6\', \'multiverseId\': 480955}, \'multiverseid\': 480955}, {\'name\': \'괴수 무기화\', \'text\': \'{2}, 생물 한 개를 희생한다: 원하는 목표를 정한다. 괴수 무기화는 그 목표에게 피해 2점을 입힌다.\', \'type\': \'부여마법\', \'flavor\': \'복수는 필연적으로 혼자 걷게 되는 길이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481214&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'37643c27-d771-4641-adb8-742f2d77f07a\', \'multiverseId\': 481214}, \'multiverseid\': 481214}, {\'name\': \'Militarizar os Monstros\', \'text\': \'{2}, sacrifique uma criatura: Militarizar os Monstros causa 2 pontos de dano a qualquer alvo.\', \'type\': \'Encantamento\', \'flavor\': \'A vingança é uma trilha inevitavelmente solitária.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481473&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e3fa3223-f602-42d6-a102-70e84746b3ec\', \'multiverseId\': 481473}, \'multiverseid\': 481473}, {\'name\': \'Вербовка Чудовищ\', \'text\': \'{2}, пожертвуйте существо: Вербовка Чудовищ наносит 2 повреждения любой цели.\', \'type\': \'Чары\', \'flavor\': \'Месть — это путь, на котором ты неизбежно оказываешься один.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481732&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b501efd6-a34b-4a44-9a86-6b102212da99\', \'multiverseId\': 481732}, \'multiverseid\': 481732}, {\'name\': \'以兽为兵\', \'text\': \'{2}，牺牲一个生物：以兽为兵对任意一个目标造成2点伤害。\', \'type\': \'结界\', \'flavor\': \'复仇这条道路必将独自前行。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481991&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ebe11693-f9bb-4c95-b569-f14fb45e46cf\', \'multiverseId\': 481991}, \'multiverseid\': 481991}, {\'name\': \'以獸為兵\', \'text\': \'{2}，犧牲一個生物：以獸為兵對任意一個目標造成2點傷害。\', \'type\': \'結界\', \'flavor\': \'復仇這條道路必將獨自前行。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482250&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b6302466-c0fb-4198-bb2a-f22ede221a2f\', \'multiverseId\': 482250}, \'multiverseid\': 482250}]', '[{\'name\': \'Monströser Schritt\', \'text\': \'Eine Kreatur deiner Wahl erhält +7/+7 bis zum Ende des Zuges. Bis zu eine andere Kreatur deiner Wahl blockt sie in diesem Zug, falls möglich.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Hexerei\', \'flavor\': \'Ein Schritt kann den Unterschied zwischen Leben und Tod bedeuten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479945&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'86cf30ed-7da8-4648-bde3-09b671756525\', \'multiverseId\': 479945}, \'multiverseid\': 479945}, {\'name\': \'Paso monstruoso\', \'text\': \'La criatura objetivo obtiene +7/+7 hasta el final del turno. Hasta una otra criatura objetivo la bloquea este turno si puede.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Conjuro\', \'flavor\': \'Lo mejor es quitar la vida paso a paso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480204&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5490bf8a-60d2-4890-9e72-cbfac477bd7b\', \'multiverseId\': 480204}, \'multiverseid\': 480204}, {\'name\': \'Pas monstrueux\', \'text\': "La créature ciblée gagne +7/+7 jusqu\'à la fin du tour. Jusqu\'à une autre créature ciblée la bloque ce tour-ci si possible.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Rituel\', \'flavor\': \'Dans la vie, mieux vaut avancer pas à pas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480463&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bdc2ffae-d09a-4e67-975e-d4d23a460a7d\', \'multiverseId\': 480463}, \'multiverseid\': 480463}, {\'name\': \'Passo Mostruoso\', \'text\': "Una creatura bersaglio prende +7/+7 fino alla fine del turno. Fino a un\'altra creatura bersaglio la blocca in questo turno, se può farlo.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)", \'type\': \'Stregoneria\', \'flavor\': \'Meglio prendere la vita un passo alla volta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480722&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ce5dbe04-8e15-4edf-88bf-6e30e751b37b\', \'multiverseId\': 480722}, \'multiverseid\': 480722}, {\'name\': \'巨怪な一歩\', \'text\': \'クリーチャー１体と他のクリーチャー最大１体を対象とする。ターン終了時まで、その前者は＋７/＋７の修整を受ける。このターン、その後者は可能ならその前者をブロックする。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'ソーサリー\', \'flavor\': \'人生は、一歩ずつ着実に。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480981&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cbc27b87-67c1-4262-82f9-c0e5003574a0\', \'multiverseId\': 480981}, \'multiverseid\': 480981}, {\'name\': \'무시무시한 발걸음\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 +7/+7을 받는다. 다른 생물을 최대 한 개까지 목표로 정한다. 그 생물은 이번 턴에 가능하면 첫 번째 목표를 방어한다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'집중마법\', \'flavor\': \'생명은 한 번에 한 단계씩 취하는 것이 최선이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481240&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'10207a2f-d904-429d-8cc2-92141af9ef4c\', \'multiverseId\': 481240}, \'multiverseid\': 481240}, {\'name\': \'Passo Monstruoso\', \'text\': \'A criatura alvo recebe +7/+7 até o final do turno. Até uma outra criatura alvo a bloqueia neste turno se estiver apta.\\nReciclar {2} ({2}, descarte este card: Compre um card.)\', \'type\': \'Feitiço\', \'flavor\': \'É melhor viver a vida um passo de cada vez.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481499&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4c9260a9-6b81-40c4-b177-e78f0e559a73\', \'multiverseId\': 481499}, \'multiverseid\': 481499}, {\'name\': \'Чудовищная Поступь\', \'text\': \'Целевое существо получает +7/+7 до конца хода. Не более одного другого целевого существа блокирует его в этом ходу, если может.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Волшебство\', \'flavor\': \'Жизнь лучше всего забирать шаг за шагом.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481758&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'98f3ff74-2420-4042-a06d-ee6cee3a6f39\', \'multiverseId\': 481758}, \'multiverseid\': 481758}, {\'name\': \'巨兽踏步\', \'text\': \'目标生物得+7/+7直到回合结束。至多另一个目标生物本回合若能阻挡它，则须阻挡之。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'法术\', \'flavor\': \'生活最好一步一步地过。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482017&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3bc32af7-3cb8-4d2b-b1eb-f9d27b9043ac\', \'multiverseId\': 482017}, \'multiverseid\': 482017}, {\'name\': \'巨獸踏步\', \'text\': \'目標生物得+7/+7直到回合結束。至多另一個目標生物本回合若能阻擋它，則須阻擋之。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'巫術\', \'flavor\': \'生活最好一步一步地過。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482276&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6b129c85-67ed-4532-83a4-27b52f982b9c\', \'multiverseId\': 482276}, \'multiverseid\': 482276}]', '[{\'name\': \'Moosfell-Goriak\', \'text\': \'Wachsamkeit\', \'type\': \'Kreatur — Bestie\', \'flavor\': \'„Goriaks sind so starrsinnig und widerstandsfähig, wie ich es von großen Pflanzenfressern in einem Sumpfgebiet erwarten würde. Aber ich hätte nie gedacht, dass sie so schöne Stimmen haben!"\\n—Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479946&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3e7c1fac-a510-46f0-b1ff-cf2f7c139b83\', \'multiverseId\': 479946}, \'multiverseid\': 479946}, {\'name\': \'Goriak musgoabrigo\', \'text\': \'Vigilancia.\', \'type\': \'Criatura — Bestia\', \'flavor\': \'"Los goriaks son tan testarudos y resistentes como esperaba de unos grandes herbívoros en un hábitat pantanoso. ¡Pero nunca hubiera imaginado que tuvieran voces tan hermosas!".\\n—Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480205&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dbf3df93-6b37-4c0b-917a-e56338282d98\', \'multiverseId\': 480205}, \'multiverseid\': 480205}, {\'name\': \'Goriak à fourrure de mousse\', \'text\': \'Vigilance\', \'type\': \'Créature : bête\', \'flavor\': "« Un goriak est têtu et robuste, comme on peut l\'espérer de la part d\'un grand herbivore vivant dans des marais. Mais je n\'aurais jamais imaginé qu\'ils avaient un si beau cri ! »\\n—Vivien Reid", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480464&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ef1f74de-0711-4896-b0d7-ae7a0f633601\', \'multiverseId\': 480464}, \'multiverseid\': 480464}, {\'name\': \'Goriak del Mantomuschiato\', \'text\': \'Cautela\', \'type\': \'Creatura — Bestia\', \'flavor\': \'"I goriak sono robusti e testardi come ci si può aspettare da grandi erbivori in un habitat acquitrinoso, ma non avrei mai immaginato che avessero una voce così meravigliosa!"\\n—Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480723&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d71c6291-9eb2-4a7e-9115-600732a3d61a\', \'multiverseId\': 480723}, \'multiverseid\': 480723}, {\'name\': \'苔毛のゴリアク\', \'text\': \'警戒\', \'type\': \'クリーチャー — ビースト\', \'flavor\': \'「ゴリアクは、湿地帯の大型草食獣と聞いて予想する通りの頑固でたくましい生き物ね。予想外なのは、この美しい声だわ！」\\n――ビビアン・リード\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480982&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fb813b97-f445-43e4-a6e4-79830eafca1d\', \'multiverseId\': 480982}, \'multiverseid\': 480982}, {\'name\': \'이끼로 뒤덮인 고리악\', \'text\': \'경계\', \'type\': \'생물 — 야수\', \'flavor\': \'"고리악들은 습지 서식지에 있는 대형 초식동물들이 다들 그렇듯이 고집세고 강인해. 하지만 저것들이 이렇게 아름다운 울음소리를 가지고 있으리라는 생각은 못 했군!"\\n—비비안 레이드\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481241&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e7a9ea97-d43f-40f7-911c-f213212924fd\', \'multiverseId\': 481241}, \'multiverseid\': 481241}, {\'name\': \'Goriaque-de-musgomanto\', \'text\': \'Vigilância\', \'type\': \'Criatura — Besta\', \'flavor\': \'"Os goriaques são teimosos e durões, como seria de se esperar de um herbívoro de grande porte num pantanal. Mas eu não esperava que eles tivessem uma voz tão linda!"\\n— Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481500&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b9bbcbfb-df67-4570-853f-4b121d49cf46\', \'multiverseId\': 481500}, \'multiverseid\': 481500}, {\'name\': \'Мохошкурый Гориак\', \'text\': \'Бдительность\', \'type\': \'Существо — Зверь\', \'flavor\': \'«Гориаки упрямые и выносливые, как и следовало ожидать от большого живущего в низинах травоядного. Но чего я точно не ожидала, так это настолько мелодичных голосов!»\\n— Вивьен Рейд\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481759&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d600f48a-ffdc-4c71-af4e-e0e4c3b21c94\', \'multiverseId\': 481759}, \'multiverseid\': 481759}, {\'name\': \'苔皮猿牦\', \'text\': \'警戒\', \'type\': \'生物 ～野兽\', \'flavor\': \'「跟我预料的一样，猿牦这种栖息于湿地的大型草食动物果然既倔强又莽撞。但我没想到它们的吼声那么好听！」\\n～薇薇安瑞德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482018&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0277fdd0-d9a1-4ddd-90ad-3bcfdcedbd26\', \'multiverseId\': 482018}, \'multiverseid\': 482018}, {\'name\': \'苔皮猿犛\', \'text\': \'警戒\', \'type\': \'生物 ～野獸\', \'flavor\': \'「跟我預料的一樣，猿犛這種棲息於濕地的大型草食動物果然既倔強又莽撞。但我沒想到牠們的吼聲那麼好聽！」\\n～薇薇安瑞德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482277&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'aa4ed393-1e37-4a6a-b1a8-a697870d8abf\', \'multiverseId\': 482277}, \'multiverseid\': 482277}]', '[{\'name\': \'Mysteriöses Ei\', \'text\': \'Immer wenn diese Kreatur mutiert, lege eine +1/+1-Marke auf sie.\', \'type\': \'Kreatur — Ei\', \'flavor\': \'„Gute Verpflegung, falls du es findest, aber du solltest es essen, bevor du zurückkehrst. Die Wachen werden dich damit nicht durch das Tor lassen."\\n—Dennae, Savai-Jägerin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479782&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dcf56cb7-d2ee-4812-a3da-d6e45a24877d\', \'multiverseId\': 479782}, \'multiverseid\': 479782}, {\'name\': \'Huevo misterioso\', \'text\': \'Siempre que esta criatura mute, pon un contador +1/+1 sobre ella.\', \'type\': \'Criatura — Huevo\', \'flavor\': \'"Es un buen alimento si lo encuentras, pero cómelo antes de regresar al santuario. Los guardias no te dejarán cruzar las puertas con él".\\n—Dennae, cazadora de Savái\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480041&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cad095b6-f9a3-4381-babb-97ce388d9822\', \'multiverseId\': 480041}, \'multiverseid\': 480041}, {\'name\': \'Œuf mystérieux\', \'text\': \'À chaque fois que cette créature subit une mutation, mettez un marqueur +1/+1 sur elle.\', \'type\': \'Créature : œuf\', \'flavor\': \'« Belle trouvaille si vous tombez dessus, mais mangez-le avant de rentrer au sanctuaire. Les gardes ne vous laisseront pas passer les portes avec. »\\n—Dennæ, chasseuse de Savaï\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480300&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'312514b0-1dec-47d8-a8e7-821a1d5f5428\', \'multiverseId\': 480300}, \'multiverseid\': 480300}, {\'name\': \'Uovo Misterioso\', \'text\': \'Ogniqualvolta questa creatura muta, metti un segnalino +1/+1 su di essa.\', \'type\': \'Creatura — Uovo\', \'flavor\': \'"Un ottimo nutrimento, se riesci a trovarlo, ma mangialo prima di tornare al santuario. Le guardie non te lo lasceranno portare oltre i cancelli."\\n—Dennae, cacciatrice di Savai\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480559&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2e67ab39-ab23-4f96-b724-19889779bcec\', \'multiverseId\': 480559}, \'multiverseid\': 480559}, {\'name\': \'不思議な卵\', \'text\': \'このクリーチャーが変容するたび、これの上に＋１/＋１カウンターを１個置く。\', \'type\': \'クリーチャー — 卵\', \'flavor\': \'「見つかればいい食料になるけれど、聖域に戻る前に食べてしまいなさい。衛兵に止められて門の先へは持っていけないから。」\\n――サヴァイの狩人、デナイ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480818&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cc64ae92-f898-43d5-8b03-ae38c91429c4\', \'multiverseId\': 480818}, \'multiverseid\': 480818}, {\'name\': \'불가사의한 알\', \'text\': \'이 생물이 돌연변이화할 때마다, 이 생물에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 알\', \'flavor\': \'"찾을 수만 있다면 좋은 식량이 되지만, 성소로 돌아가기 전에 먹어야 해. 경비병들이 그걸 가지고 관문을 통과하게 해 주지 않거든."\\n—사바이 사냥꾼, 데네이\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481077&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'537c0b38-b75d-441b-90f1-a4f73075c331\', \'multiverseId\': 481077}, \'multiverseid\': 481077}, {\'name\': \'Ovo Misterioso\', \'text\': \'Toda vez que esta criatura sofrer mutação, coloque um marcador +1/+1 nela.\', \'type\': \'Criatura — Ovo\', \'flavor\': \'"Um bom achado, mas coma antes de voltar para o santuário. Os guardas não vão deixar você passar do portão com isso."\\n— Dennae, caçadora da Savai\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481336&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3fe311ea-e3aa-484a-aad3-e3003ee331da\', \'multiverseId\': 481336}, \'multiverseid\': 481336}, {\'name\': \'Загадочное Яйцо\', \'text\': \'Каждый раз, когда это существо мутирует, положите на него один жетон +1/+1.\', \'type\': \'Существо — Яйцо\', \'flavor\': \'«Если найдешь, бери — штука вкусная. Только съешь до того, как вернешься в убежище. В ворота тебя с ним не пустят».\\n— Денна, савайская охотница\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481595&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'067c62b0-554d-4408-ba0a-2ce5a58c2f50\', \'multiverseId\': 481595}, \'multiverseid\': 481595}, {\'name\': \'玄奇蛋\', \'text\': \'每当此生物合变时，在其上放置一个+1/+1指示物。\', \'type\': \'生物 ～蛋\', \'flavor\': \'「如果你有幸找得到的话，它真是上好的美味，但千万记得要在返回庇护地前吃掉。守卫禁止携带这类东西进门。」\\n～撒维耶猎人笛奈\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481854&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5996579c-de8c-4b5f-900c-403e7f1aaa67\', \'multiverseId\': 481854}, \'multiverseid\': 481854}, {\'name\': \'玄奇蛋\', \'text\': \'每當此生物合變時，在其上放置一個+1/+1指示物。\', \'type\': \'生物 ～蛋\', \'flavor\': \'「如果你有幸找得到的話，它真是上好的美味，但千萬記得要在返回庇護地前吃掉。守衛禁止攜帶這類東西進門。」\\n～撒維耶獵人笛奈\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482113&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'91d4ab2b-efa1-42a9-a0ea-6116f8212ebe\', \'multiverseId\': 482113}, \'multiverseid\': 482113}]', '[{\'name\': \'Mystische Bändigung\', \'text\': \'Aufblitzen\\nVerzaubert eine Kreatur\\nDie verzauberte Kreatur erhält -2/-0 und verliert alle Fähigkeiten. (Mutationen mit der Kreatur geben ihr keine neuen Fähigkeiten. Sie kann jedoch auf andere Weise Fähigkeiten erhalten.)\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479836&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b7bddfe7-627d-4a15-bc16-29f00d681ab6\', \'multiverseId\': 479836}, \'multiverseid\': 479836}, {\'name\': \'Sometimiento místico\', \'text\': \'Destello.\\nEncantar criatura.\\nLa criatura encantada obtiene -2/-0 y pierde todas sus habilidades. (Mutar a la criatura no le proporcionará nuevas habilidades. Puede ganar habilidades de otras formas.)\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480095&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7fe1269e-4556-4f78-b476-eb354a725d94\', \'multiverseId\': 480095}, \'multiverseid\': 480095}, {\'name\': \'Subjugation mystique\', \'text\': "Flash\\nEnchanter : créature\\nLa créature enchantée gagne -2/-0 et perd toutes ses capacités. (Subir une mutation ne donnera pas de nouvelles capacités à la créature. Elle peut acquérir des capacités par d\'autres manières.)", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480354&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0c5198e2-5cae-4ae8-9e6c-8373b9347b5d\', \'multiverseId\': 480354}, \'multiverseid\': 480354}, {\'name\': \'Sottomissione Mistica\', \'text\': \'Lampo\\nIncanta creatura\\nLa creatura incantata prende -2/-0 e perde tutte le abilità. (Se la creatura muta, non ottiene nuove abilità. Può guadagnare abilità in altri modi.)\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480613&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'603981d0-acc6-4e00-b68f-8fd553d77273\', \'multiverseId\': 480613}, \'multiverseid\': 480613}, {\'name\': \'神秘の制圧\', \'text\': \'瞬速\\nエンチャント（クリーチャー）\\nエンチャントしているクリーチャーは、－２/－０の修整を受け能力 すべてを失う。（そのクリーチャーが変容しても、それには新しい能力が与えられない。それが他の方法で能力を得ることはできる。）\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480872&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'94e7ba6e-8859-44a3-838f-c79d7bee895d\', \'multiverseId\': 480872}, \'multiverseid\': 480872}, {\'name\': \'신비한 진압\', \'text\': \'섬광\\n생물에게 부여\\n부여된 생물은 -2/-0을 받고 모든 능력을 잃는다. (그 생물을 돌연변이화시켜도 새로운 능력이 주어지지 않는다. 다른 방법으로는 능력들을 얻을 수 있다.)\', \'type\': \'부여마법 — 마법진\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481131&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2cafdddc-fe5e-43ad-af82-1c4ffe3a0d41\', \'multiverseId\': 481131}, \'multiverseid\': 481131}, {\'name\': \'Submissão Mística\', \'text\': \'Lampejo\\nEncantar criatura\\nA criatura encantada recebe -2/-0 e perde todas as habilidades. (As mutações que a criatura sofra não concedem novas habilidades. Ela pode ganhar habilidades de outras formas.)\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481390&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7bca618e-dc3d-4b03-a906-562d8b565f39\', \'multiverseId\': 481390}, \'multiverseid\': 481390}, {\'name\': \'Мистическое Подчинение\', \'text\': \'Миг\\nЗачаровать существо\\nЗачарованное существо получает -2/-0 и теряет все способности. (Мутация в то зачарованное существо не добавит ему новые способности. Оно может получить способности иными способами.)\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481649&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7ddf9946-9a74-4901-a48b-610be654ddb9\', \'multiverseId\': 481649}, \'multiverseid\': 481649}, {\'name\': \'神秘破坏\', \'text\': \'闪现\\n结附于生物\\n所结附的生物得-2/-0且失去所有异能。（合变无法让此生物获得新异能。它可以藉由其他方式获得异能。）\', \'type\': \'结界 ～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481908&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cfb785ff-a661-4c24-b6e2-9628aa6759cd\', \'multiverseId\': 481908}, \'multiverseid\': 481908}, {\'name\': \'神秘破壞\', \'text\': \'閃現\\n結附於生物\\n所結附的生物得-2/-0且失去所有異能。（合無法讓此生物獲得新異能。它可以藉由其他方式獲得異能。）\', \'type\': \'結界 ～靈氣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482167&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'77838125-0825-4ac1-b047-266fdd4e62b4\', \'multiverseId\': 482167}, \'multiverseid\': 482167}]', '[{\'name\': \'Mythos von Brokkos\', \'text\': \'Falls {U}{B} ausgegeben wurde, um diesen Zauberspruch zu wirken, durchsuche deine Bibliothek nach einer Karte, lege sie auf deinen Friedhof und mische dann deine Bibliothek.\\nBringe bis zu zwei bleibende Karten aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Hexerei\', \'flavor\': \'„Die unerwartetste Waffe, die ein Monster benutzen kann, ist seine Freundlichkeit."\\n—*Geschichten vom Ozolith*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479947&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'57aafb31-621f-4386-be71-078f46fda8b7\', \'multiverseId\': 479947}, \'multiverseid\': 479947}, {\'name\': \'Mito de Brokkos\', \'text\': \'Si se usó {U}{B} para lanzar este hechizo, busca en tu biblioteca una carta, ponla en tu cementerio y luego baraja tu biblioteca.\\nRegresa hasta dos cartas de permanente de tu cementerio a tu mano.\', \'type\': \'Conjuro\', \'flavor\': \'"El arma más inesperada que puede blandir un monstruo es su amabilidad".\\n—*Cuentos del Ozolito*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480206&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ce03a2be-1e89-4e7a-8af3-5ad120740b94\', \'multiverseId\': 480206}, \'multiverseid\': 480206}, {\'name\': \'Mythe de Brokkos\', \'text\': "Si {U}{B} ont été dépensés pour lancer ce sort, cherchez une carte dans votre bibliothèque, mettez cette carte dans votre cimetière, et mélangez ensuite votre bibliothèque.\\nRenvoyez jusqu\'à deux cartes de permanent depuis votre cimetière dans votre main.", \'type\': \'Rituel\', \'flavor\': "« La bonté est une arme puissante que les monstres utilisent rarement. »\\n—*Contes de l\'Ozolithe*", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480465&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'49c69ef3-d845-4366-922e-5a76214a0d3f\', \'multiverseId\': 480465}, \'multiverseid\': 480465}, {\'name\': \'Mito di Broykos\', \'text\': \'Se è stato speso {U}{B} per lanciare questa magia, passa in rassegna il tuo grimorio per una carta, metti quella carta nel tuo cimitero, poi rimescola il tuo grimorio.\\nRiprendi in mano fino a due carte permanente dal tuo cimitero.\', \'type\': \'Stregoneria\', \'flavor\': \'"L\\\'arma più inaspettata che un mostro può brandire è la gentilezza."\\n—*Racconti dell\\\'Ozolito*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480724&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1bd8540f-21ff-425c-9816-2172f23b20b4\', \'multiverseId\': 480724}, \'multiverseid\': 480724}, {\'name\': \'ブロコスの神話\', \'text\': \'この呪文を唱えるために{U}{B}が支払われていたなら、あなたのライブラリーからカード１枚を探し、あなたの墓地に置き、その後あなたのライブラリーを切り直す。\\nあなたの墓地からパーマネント・カード最大２枚をあなたの手札に戻す。\', \'type\': \'ソーサリー\', \'flavor\': \'「怪物が持ち得る最も予想外の武器。それは優しさである。」\\n――*オゾリスの物語*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480983&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ab832bae-2b48-4cab-9161-96975dcaa62c\', \'multiverseId\': 480983}, \'multiverseid\': 480983}, {\'name\': \'브로코스의 신화\', \'text\': \'이 주문을 발동하는 데 {U}{B}가 지불되었다면, 당신의 서고에서 카드 한 장을 찾아, 그 카드를 당신의 무덤에 넣은 후, 당신의 서고를 섞는다.\\n당신의 무덤에 있는 지속물 카드를 최대 두 장까지 당신의 손으로 되돌린다.\', \'type\': \'집중마법\', \'flavor\': \'"괴수가 휘두를 수 있는 가장 의외의 무기는 친절함이다."\\n—*오조리스 이야기*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481242&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4de5cce8-04f2-4c14-94af-61489dadf43e\', \'multiverseId\': 481242}, \'multiverseid\': 481242}, {\'name\': \'Mito de Brokkos\', \'text\': \'Se {U}{B} tiverem sido gastos para conjurar esta mágica, procure um card em seu grimório, coloque aquele card em seu cemitério e depois embaralhe o seu grimório.\\nDevolva até dois cards de permanente de seu cemitério para sua mão.\', \'type\': \'Feitiço\', \'flavor\': \'"A arma mais inesperada que um monstro pode usar é a bondade."\\n— *Contos do Ozólito*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481501&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b670f97e-a187-4446-b09a-d441e6923d0c\', \'multiverseId\': 481501}, \'multiverseid\': 481501}, {\'name\': \'Сказание о Броккосе\', \'text\': \'Если на разыгрывание этого заклинания были потрачены {U}{B}, найдите в вашей библиотеке карту, положите ту карту на ваше кладбище, затем перетасуйте вашу библиотеку.\\nВерните не более двух карт перманентов из вашего кладбища в вашу руку.\', \'type\': \'Волшебство\', \'flavor\': \'«Самое неожиданное оружие, которое может быть у чудовища, — это доброта».\\n— *«Истории Озолита»*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481760&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5a76499d-cc55-43a7-8d69-81291a0dabaa\', \'multiverseId\': 481760}, \'multiverseid\': 481760}, {\'name\': \'布洛寇传说\', \'text\': \'如果施放此咒语时支付过{U}{B}，则从你的牌库中搜寻一张牌，将该牌置入你的坟墓场，然后将你的牌库洗牌。\\n将至多两张永久物牌从你的坟墓场移回你手上。\', \'type\': \'法术\', \'flavor\': \'「怪兽运用的武器中最出人意表者便是善意。」\\n～*《欧佐晶岩传说》*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482019&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4fbde94a-b5f6-4db5-887a-3f1e3f7ea7ec\', \'multiverseId\': 482019}, \'multiverseid\': 482019}, {\'name\': \'布洛寇傳說\', \'text\': \'如果施放此咒語時支付過{U}{B}，則從你的牌庫中搜尋一張牌，將該牌置入你的墳墓場，然後將你的牌庫洗牌。\\n將至多兩張永久物牌從你的墳墓場移回你手上。\', \'type\': \'巫術\', \'flavor\': \'「怪獸運用的武器中最出人意表者便是善意。」\\n～*《歐佐晶岩傳說》*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482278&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c75a083c-1f73-4785-931f-5d508dae180a\', \'multiverseId\': 482278}, \'multiverseid\': 482278}]', '[{\'name\': \'Mythos von Illuna\', \'text\': \'Erzeuge einen Spielstein, der eine Kopie einer bleibenden Karte deiner Wahl ist. Falls {R}{G} ausgegeben wurde, um diesen Zauberspruch zu wirken, erzeuge stattdessen einen Spielstein, der eine Kopie der bleibenden Karte ist, außer dass sie „Wenn diese bleibende Karte ins Spiel kommt und falls sie eine Kreatur ist, kämpft sie gegen bis zu eine Kreatur deiner Wahl, die du nicht kontrollierst" hat.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479837&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b042346f-c0ba-429d-9f20-135579021350\', \'multiverseId\': 479837}, \'multiverseid\': 479837}, {\'name\': \'Mito de Illuna\', \'text\': \'Crea una ficha que es una copia del permanente objetivo. Si se usó {R}{G} para lanzar este hechizo, en vez de eso, crea una ficha que es una copia de ese permanente excepto que la ficha tiene "Cuando este permanente entre al campo de batalla, si es una criatura, lucha contra hasta una criatura objetivo que no controlas".\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480096&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b1589dec-cf74-4178-ac00-b83c7b54e9e1\', \'multiverseId\': 480096}, \'multiverseid\': 480096}, {\'name\': "Mythe d\'Illuna", \'text\': "Créez un jeton qui est une copie du permanent ciblé. Si {R}{G} ont été dépensés pour lancer ce sort, à la place créez un jeton qui est une copie de ce permanent, excepté que le jeton a « Quand ce permanent arrive sur le champ de bataille, si c\'est une créature, il se bat contre jusqu\'à une créature ciblée que vous ne contrôlez pas ».", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480355&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'42784702-4271-4aa7-9700-37f2fcd49557\', \'multiverseId\': 480355}, \'multiverseid\': 480355}, {\'name\': \'Mito di Illuna\', \'text\': \'Crea una pedina che è una copia di un permanente bersaglio. Se è stato speso {R}{G} per lanciare questa magia, crea invece una pedina che è una copia di quel pemanente, tranne che ha "Quando questo permanente entra nel campo di battaglia, se è una creatura, lotta con fino a una creatura bersaglio che non controlli".\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480614&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ea439aa7-948b-4124-ab60-02395ee25fab\', \'multiverseId\': 480614}, \'multiverseid\': 480614}, {\'name\': \'イルーナの神話\', \'text\': \'パーマネント１つを対象とし、それのコピーであるトークンを１つ生成する。この呪文を唱えるために{R}{G}が支払われていたなら、代わりに、「このパーマネントが戦場に出たとき、これがクリーチャーである場合、あなたがコントロールしていないクリーチャー最大１体を対象とする。これはそれと格闘を行う。」を持つことを除きそのパーマネントのコピーであるトークンを１つ生成する。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480873&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'791453fd-3e75-4b87-91f0-233d661b279f\', \'multiverseId\': 480873}, \'multiverseid\': 480873}, {\'name\': \'일루나의 신화\', \'text\': \'지속물을 목표로 정한다. 그 지속물의 복사본인 토큰 한 개를 만든다. 이 주문을 발동하는 데 {R}{G}가 지불되었다면, 대신 그 지속물의 복사본이며 "이 지속물이 전장에 들어올 때, 이 지속물이 생물이라면, 당신이 조종하지 않는 생물을 최대 한 개까지 목표로 정한다. 이 생물은 그 생물과 싸운다."를 가진 토큰을 만든다.\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481132&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'885a1439-bc2c-48aa-8369-79586ce6d740\', \'multiverseId\': 481132}, \'multiverseid\': 481132}, {\'name\': \'Mito de Illuna\', \'text\': \'Crie uma ficha que seja uma cópia da permanente alvo. Se {R}{G} tiverem sido gastos para conjurar essa mágica, em vez disso, crie uma ficha que seja uma cópia daquela permanente, com a exceção de ter "Quando esta permanente entra no campo de batalha, se ela for uma criatura, ela luta com até uma criatura alvo que você não controla".\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481391&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cf637c71-bd7d-4c79-8794-dcd318b41fb0\', \'multiverseId\': 481391}, \'multiverseid\': 481391}, {\'name\': \'Сказание об Иллуне\', \'text\': \'Создайте одну фишку, являющуюся копией целевого перманента. Если на разыгрывание этого заклинания были потрачены {R}{G}, вместо этого создайте одну фишку, являющуюся копией того перманента, но при этом у фишки есть способность «Когда этот перманент выходит на поле битвы, если это существо, то оно дерется с не более чем одним целевым существом не под вашим контролем».\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481650&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c1a80c53-5c31-402b-8b9e-4de67a5d5d4b\', \'multiverseId\': 481650}, \'multiverseid\': 481650}, {\'name\': \'依卢那传说\', \'text\': \'派出一个衍生物，此衍生物为目标永久物之复制品。如果施放此咒语时支付过{R}{G}，则改为派出一个为该永久物之复制品的衍生物，但该衍生物具有「当此永久物进战场时，若它是生物，则它与至多一个目标不由你操控的生物互斗。」\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481909&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5cfd097c-4f85-4468-bc80-b871dcca44c1\', \'multiverseId\': 481909}, \'multiverseid\': 481909}, {\'name\': \'依盧那傳說\', \'text\': \'派出一個衍生物，此衍生物為目標永久物之複製品。如果施放此咒語時支付過{R}{G}，則改為派出一個為該永久物之複製品的衍生物，但該衍生物具有「當此永久物進戰場時，若它是生物，則它與至多一個目標不由你操控的生物互鬥。」\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482168&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'db1b8217-8ebb-4955-bf9d-bd08ac654c82\', \'multiverseId\': 482168}, \'multiverseid\': 482168}]', '[{\'name\': \'Mythos von Nethroi\', \'text\': \'Zerstöre eine bleibende Karte deiner Wahl, die kein Land ist, falls es eine Kreatur ist oder falls {G}{W} ausgegeben wurde, um diesen Zauberspruch zu wirken.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Und dann wurde der Schatten lebendig und verschlang den Körper, den Geist und die Seele des Mannes vollständig."\\n—*Geschichten vom Ozolith*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479876&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4a6c6ca9-e1d1-4d72-8e0b-a45a9f542470\', \'multiverseId\': 479876}, \'multiverseid\': 479876}, {\'name\': \'Mito de Nethroi\', \'text\': \'Destruye el permanente objetivo que no sea tierra si es una criatura o si se usó {G}{W} para lanzar este hechizo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Y la sombra cobró vida y devoró al hombre por completo: cuerpo, mente y alma".\\n—*Cuentos del Ozolito*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480135&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0c2f5f82-a395-442a-865c-727678e48aff\', \'multiverseId\': 480135}, \'multiverseid\': 480135}, {\'name\': \'Mythe de Nethroï\', \'text\': "Détruisez le permanent non-terrain ciblé si c\'est une créature ou si {G}{W} ont été dépensés pour lancer ce sort.", \'type\': \'Éphémère\', \'flavor\': "« Puis l\'ombre finit par prendre vie et par dévorer cette personne tout entière : son esprit, son âme et sa chair. »\\n—*Contes de l\'Ozolithe*", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480394&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2e35fea5-08e5-44a6-97cd-2afa009480e1\', \'multiverseId\': 480394}, \'multiverseid\': 480394}, {\'name\': \'Mito di Nethroi\', \'text\': \'Distruggi un permanente non terra bersaglio se è una creatura o se è stato speso {G}{W} per lanciare questa magia.\', \'type\': \'Istantaneo\', \'flavor\': \'"E poi l\\\'ombra prese vita e divorò completamente l\\\'uomo: il suo corpo, la sua mente e la sua anima."\\n—*Racconti dell\\\'Ozolito*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480653&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'832b1723-31c3-4963-a123-0f33067e67f3\', \'multiverseId\': 480653}, \'multiverseid\': 480653}, {\'name\': \'ネスロイの神話\', \'text\': \'土地でないパーマネント１つを対象とする。それがクリーチャーであるか、この呪文を唱えるために{G}{W}が支払われていたなら、それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'「そうして影は形を成し、男一人を食い尽くした。体も、心も、魂も。」\\n――*オゾリスの物語*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480912&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'86bd73a0-72d2-4075-a7bf-387d4c9dcb5f\', \'multiverseId\': 480912}, \'multiverseid\': 480912}, {\'name\': \'네스로이의 신화\', \'text\': \'대지가 아닌 지속물을 목표로 정한다. 그 지속물이 생물이거나 이 주문을 발동하는 데 {G}{W}가 지불되었다면 그 지속물을 파괴한다.\', \'type\': \'순간마법\', \'flavor\': \'"그런 뒤 그림자는 살아있는 형체가 되어, 남자를 통째로 집어삼켰다—육신, 정신, 그리고 영혼을."\\n—*오조리스 이야기*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481171&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5a0d60e9-6cc0-499e-bac0-1402e1625ecd\', \'multiverseId\': 481171}, \'multiverseid\': 481171}, {\'name\': \'Mito de Nethroi\', \'text\': \'Destrua a permanente alvo que não seja um terreno se ela for uma criatura ou se {G}{W} tiverem sido gastos para conjurar esta mágica.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"E então a sombra ganhou vida, e a sombra devorou o homem por inteiro, corpo, mente e alma."\\n— *Contos do Ozólito*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481430&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e3a5204a-2ef6-4bba-8713-65898a8e4498\', \'multiverseId\': 481430}, \'multiverseid\': 481430}, {\'name\': \'Сказание о Нетрое\', \'text\': \'Уничтожьте целевой не являющийся землей перманент, если он является существом или если на разыгрывание этого заклинания были потрачены {G}{W}.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«И тогда тень обрела форму и поглотила человека целиком: тело, разум и душу».\\n— *«Истории Озолита»*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481689&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9de801c6-f855-4918-a928-025aeb6dc5ec\', \'multiverseId\': 481689}, \'multiverseid\': 481689}, {\'name\': \'涅司罗传说\', \'text\': \'选择目标非地永久物。如果它是生物或如果施放此咒语时支付过{G}{W}，则消灭之。\', \'type\': \'瞬间\', \'flavor\': \'「然后这片阴影开始自己行动起来，随即将那人全数吞下～身体、心灵、灵魂一样不剩。」\\n～*《欧佐晶岩传说》*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481948&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4de9ab41-fc1f-499c-b863-f47c24fc7653\', \'multiverseId\': 481948}, \'multiverseid\': 481948}, {\'name\': \'涅司羅傳說\', \'text\': \'選擇目標非地永久物。如果它是生物或如果施放此咒語時支付過{G}{W}，則消滅之。\', \'type\': \'瞬間\', \'flavor\': \'「然後這片陰影開始自己行動起來，隨即將那人全數吞下～身體、心靈、靈魂一樣不剩。」\\n～*《歐佐晶岩傳說》*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482207&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2cea4fae-d80e-444b-af35-76c25746d7c0\', \'multiverseId\': 482207}, \'multiverseid\': 482207}]', '[{\'name\': \'Mythos von Snapdax\', \'text\': \'Jeder Spieler bestimmt ein Artefakt, eine Kreatur, eine Verzauberung und einen Planeswalker unter den bleibenden Karten, die keine Länder sind und die er kontrolliert, und opfert dann den Rest. Falls {B}{R} ausgegeben wurde, um diesen Zauberspruch zu wirken, bestimmst stattdessen du für jeden Spieler die bleibenden Karten.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479803&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'caf6bb65-e18c-4c65-a4b1-904945c0e61e\', \'multiverseId\': 479803}, \'multiverseid\': 479803}, {\'name\': \'Mito de Snapdax\', \'text\': \'Cada jugador elige un artefacto, una criatura, un encantamiento y un planeswalker de entre los permanentes que no sean tierra que controla, luego sacrifica el resto. Si se usó {B}{R} para lanzar este hechizo, en vez de eso, tú eliges los permanentes para cada jugador.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480062&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'711311bd-11d6-46ae-89a9-5c7f325f3dcd\', \'multiverseId\': 480062}, \'multiverseid\': 480062}, {\'name\': \'Mythe de Snapdax\', \'text\': "Chaque joueur choisit un artefact, une créature, un enchantement et un planeswalker parmi les permanents non-terrains qu\'il contrôle, puis il sacrifie le reste. Si {B}{R} ont été dépensés pour lancer ce sort, vous choisissez les permanents pour chaque joueur à la place.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480321&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'689e88ab-1ada-4bbc-91c9-f04956a997c5\', \'multiverseId\': 480321}, \'multiverseid\': 480321}, {\'name\': \'Mito di Snapdax\', \'text\': \'Ogni giocatore sceglie un artefatto, una creatura, un incantesimo e un planeswalker tra i permanenti non terra che controlla, poi sacrifica gli altri. Se è stato speso {B}{R} per lanciare questa magia, invece scegli tu i permanenti per ogni giocatore.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480580&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3d4be527-27c5-4e1c-9bf1-3c54ed41ee50\', \'multiverseId\': 480580}, \'multiverseid\': 480580}, {\'name\': \'スナップダックスの神話\', \'text\': \'各プレイヤーはそれぞれ、自分がコントロールしていて土地でないパーマネントの中からアーティファクト１つとクリーチャー１体とエンチャント１つとプレインズウォーカー１体を選び、その後残りを生け贄に捧げる。この呪文を唱えるために{B}{R}が支払われていたなら、代わりに、あなたが各プレイヤーのそれらのパーマネントを選ぶ。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480839&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'37c1c3a4-ef25-45b4-a013-589eede226e4\', \'multiverseId\': 480839}, \'multiverseid\': 480839}, {\'name\': \'스냅댁스의 신화\', \'text\': \'각 플레이어는 자신이 조종하는 대지가 아닌 지속물 중에서 마법물체, 생물, 부여마법, 플레인즈워커를 하나씩 선택한 후, 나머지를 희생한다. 이 주문을 발동하기 위해 {B}{R}가 지불되었다면, 당신이 각 플레이어의 지속물들을 대신 선택한다.\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481098&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8ec13012-7c81-463e-807d-c6b709f6c39e\', \'multiverseId\': 481098}, \'multiverseid\': 481098}, {\'name\': \'Mito de Snapdax\', \'text\': \'Cada jogador escolhe um artefato, uma criatura, um encantamento e um planeswalker dentre as permanentes que ele controla que não sejam terrenos e depois sacrifica o restante. Se {B}{R} tiverem sido gastos para conjurar esta mágica, em vez disso, você escolhe as permanentes para cada jogador.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481357&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b5cd858f-8070-4f90-aa2e-05fdee5794b4\', \'multiverseId\': 481357}, \'multiverseid\': 481357}, {\'name\': \'Сказание о Снапдаксе\', \'text\': "Каждый игрок выбирает из не являющихся землями перманентов под своим контролем артефакт, существо, чары и planeswalker\'а, затем жертвует остальные. Если на разыгрывание этого заклинания были потрачены {B}{R}, то вместо этого вы выбираете перманенты для каждого игрока.", \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481616&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3d8bbbec-874a-4603-9339-63950c2bb926\', \'multiverseId\': 481616}, \'multiverseid\': 481616}, {\'name\': \'斯达兹传说\', \'text\': \'每位牌手各从由其操控的非地永久物中选择一个神器、一个生物、一个结界和一个鹏洛客，然后牺牲其余的非地永久物。如果施放此咒语时支付过{B}{R}，则改为由你来为每位牌手选择永久物。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481875&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8d8abca3-2901-481b-b198-802fa6ec0246\', \'multiverseId\': 481875}, \'multiverseid\': 481875}, {\'name\': \'斯達茲傳說\', \'text\': \'每位玩家各從由其操控的非地永久物中選擇一個神器、一個生物、一個結界和一個鵬洛客，然後犧牲其餘的非地永久物。如果施放此咒語時支付過{B}{R}，則改為由你來為每位玩家選擇永久物。\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482134&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'daf963dd-d075-4f51-b131-4b7b505f189b\', \'multiverseId\': 482134}, \'multiverseid\': 482134}]', '[{\'name\': \'Mythos von Vadrok\', \'text\': \'Der Mythos von Vadrok fügt 5 Schadenspunkte zu, deren Aufteilung auf eine beliebige Anzahl an Kreaturen und/oder Planeswalkern deiner Wahl du bestimmst. Falls {W}{U} ausgegeben wurde, um diesen Zauberspruch zu wirken, können jene bleibenden Karten bis zu deinem nächsten Zug nicht angreifen oder blocken und ihre aktivierten Fähigkeiten können nicht aktiviert werden.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479906&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'80451d37-5426-4a5e-ba44-7add277b1a77\', \'multiverseId\': 479906}, \'multiverseid\': 479906}, {\'name\': \'Mito de Vadrok\', \'text\': \'El Mito de Vadrok hace 5 puntos de daño divididos como elijas entre cualquier cantidad de criaturas y/o planeswalkers objetivo. Si se usó {W}{U} para lanzar este hechizo, hasta tu próximo turno, esos permanentes no pueden atacar ni bloquear y sus habilidades activadas no pueden activarse.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480165&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0211668a-0ac4-4dac-8f72-21b853ead65d\', \'multiverseId\': 480165}, \'multiverseid\': 480165}, {\'name\': \'Mythe de Vadrok\', \'text\': "Le Mythe de Vadrok inflige 5 blessures réparties comme vous le désirez entre n\'importe quel nombre de cibles, créatures et/ou planeswalkers. Si {W}{U} ont été dépensés pour lancer ce sort, jusqu\'à votre prochain tour, ces permanents ne peuvent ni attaquer ni bloquer et leurs capacités activées ne peuvent pas être activées.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480424&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d2888ed1-e434-4325-926f-1d090e02359c\', \'multiverseId\': 480424}, \'multiverseid\': 480424}, {\'name\': \'Mito di Vadrok\', \'text\': \'Il Mito di Vadrok infligge 5 danni divisi a tua scelta tra un qualsiasi numero di creature e/o planeswalker bersaglio. Se è stato speso {W}{U} per lanciare questa magia, fino al tuo prossimo turno quei permanenti non possono attaccare o bloccare e le loro abilità attivate non possono essere attivate.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480683&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a27afb36-f1c3-464c-b283-6ad97ad76257\', \'multiverseId\': 480683}, \'multiverseid\': 480683}, {\'name\': \'ヴァドロックの神話\', \'text\': \'望む数の、クリーチャーやプレインズウォーカーを対象とする。ヴァドロックの神話はそれらに５点のダメージをあなたの望むように分割して与える。この呪文を唱えるために{W}{U}が支払われていたなら、あなたの次のターンまで、それらのパーマネントでは攻撃もブロックもできず、それらの起動型能力は起動できない。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480942&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2fe96042-5cf8-49a3-826b-249295ba7acd\', \'multiverseId\': 480942}, \'multiverseid\': 480942}, {\'name\': \'바드로크의 신화\', \'text\': \'생물 및/또는 플레인즈워커를 원하는 수만큼 목표로 정한다. 바드로크의 신화는 그 목표들에게 피해 5점을 당신이 나눈 대로 입힌다. 이 주문을 발동하는 데 {W}{U}가 지불되었다면, 당신의 다음 턴까지, 그 목표들은 공격하거나 방어할 수 없으며 그 목표들의 활성화능력은 활성화될 수 없다.\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481201&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'daa4b49a-8733-458b-bb97-f128bd76a3b8\', \'multiverseId\': 481201}, \'multiverseid\': 481201}, {\'name\': \'Mito de Vadrok\', \'text\': \'Mito de Vadrok causa 5 pontos de dano distribuídos à sua escolha entre qualquer número de criaturas e/ou planeswalkers alvo. Se {W}{U} foram gastos para conjurar esta mágica, até seu próximo turno aquelas permanentes não podem atacar nem bloquear e suas habilidades ativadas não podem ser ativadas.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481460&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1aeac4c0-8fe1-418f-9ae8-5113ad47784a\', \'multiverseId\': 481460}, \'multiverseid\': 481460}, {\'name\': \'Сказание о Вадроке\', \'text\': "Сказание о Вадроке наносит 5 повреждений, разделенных по вашему выбору между любым количеством целевых существ и/или planeswalker\'ов. Если на разыгрывание этого заклинания были потрачены {W}{U}, то до вашего следующего хода те перманенты не могут атаковать или блокировать, и их активируемые способности не могут быть активированы.", \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481719&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'74607d54-7d98-4eab-9cdc-536716456ee1\', \'multiverseId\': 481719}, \'multiverseid\': 481719}, {\'name\': \'瓦卓克传说\', \'text\': \'瓦卓克传说对任意数量的目标生物和／或鹏洛客造成共5点伤害，你可以任意分配。如果施放此咒语时支付过{W}{U}，则直到你的下一个回合，这些永久物不能进行攻击或阻挡，其起动式异能也不能起动。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481978&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'42a60d9a-fd21-4627-9db9-ab2b24fa1922\', \'multiverseId\': 481978}, \'multiverseid\': 481978}, {\'name\': \'瓦卓克傳說\', \'text\': \'瓦卓克傳說對任意數量的目標生物和／或鵬洛客造成共5點傷害，你可以任意分配。如果施放此咒語時支付過{W}{U}，則直到你的下一個回合，這些永久物不能進行攻擊或阻擋，其起動式異能也不能起動。\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482237&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c33aa503-d49b-4527-ab78-e264b89f8dd0\', \'multiverseId\': 482237}, \'multiverseid\': 482237}]', '[{\'name\': \'Mächtiger Buschköter\', \'text\': \'Verursacht Trampelschaden\\n{3}{G}: Der Mächtige Buschköter erhält +3/+3 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Buschköter\', \'flavor\': \'Hat über den Buschköter gelacht.\\n—Redensart der Jäger; steht für\\n„unerwartet gestorben"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479922&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5e9f743b-2fd4-4f85-9f6e-0a15dd319a63\', \'multiverseId\': 479922}, \'multiverseid\': 479922}, {\'name\': \'Yerbamala poderosa\', \'text\': \'Arrolla.\\n{3}{G}: La Yerbamala poderosa obtiene +3/+3 hasta el final del turno.\', \'type\': \'Criatura — Yerbamala\', \'flavor\': \'Se rio de la yerbamala.\\n—Expresión de los cazadores que significa\\n"morir inesperadamente"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480181&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fd0bbdd1-012b-486a-8d51-c51fae45717d\', \'multiverseId\': 480181}, \'multiverseid\': 480181}, {\'name\': \'Bosquérisson tout-puissant\', \'text\': "Piétinement\\n{3}{G} : Le Bosquérisson tout-puissant gagne +3/+3 jusqu\'à la fin du tour.", \'type\': \'Créature : bosquérisson\', \'flavor\': "S\'être ri du bosquérisson\\n—Expression de chasseur signifiant\\n« être mort de façon inattendue »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480440&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4e839f89-f15f-4d61-aa34-6c37c4ca630f\', \'multiverseId\': 480440}, \'multiverseid\': 480440}, {\'name\': \'Burlarbusto Onnipotente\', \'text\': \'Travolgere\\n{3}{G}: Il Burlarbusto Onnipotente prende +3/+3 fino alla fine del turno.\', \'type\': \'Creatura — Burlarbusto\', \'flavor\': \'Ha riso del burlarbusto\\n—Espressione dei cacciatori che significa\\n"è morto inaspettatamente"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480699&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4dab97a9-29df-473b-bea1-e2c3b763291c\', \'multiverseId\': 480699}, \'multiverseid\': 480699}, {\'name\': \'万能のブラッシュワグ\', \'text\': \'トランプル\\n{3}{G}：ターン終了時まで、万能のブラッシュワグは＋３/＋３の修整を受ける。\', \'type\': \'クリーチャー — ブラッシュワグ\', \'flavor\': \'ブラッシュワグをあざ笑った\\n――狩人の言い回しで\\n「思いがけず死んだ」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480958&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2d2c0115-b065-4176-8394-5facd530466f\', \'multiverseId\': 480958}, \'multiverseid\': 480958}, {\'name\': \'전능한 브러시와그\', \'text\': \'돌진\\n{3}{G}: 전능한 브러시와그는 턴종료까지 +3/+3을 받는다.\', \'type\': \'생물 — 브러시와그\', \'flavor\': \'브러시와그 앞에서 웃었다\\n—"예상치 못하고 죽었다"라는 의미를 가진\\n사냥꾼들의 표현\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481217&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'29ff3440-1469-4042-8353-fe0ba37c768b\', \'multiverseId\': 481217}, \'multiverseid\': 481217}, {\'name\': \'Tojo Todo-poderoso\', \'text\': \'Atropelar\\n{3}{G}: Tojo Todo-poderoso recebe +3/+3 até o final do turno.\', \'type\': \'Criatura — Tojo\', \'flavor\': \'Riu do tojo.\\n— Expressão dos caçadores que significa\\n"morreu inesperadamente"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481476&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1f9e803e-293f-47c6-a525-0714f176ed06\', \'multiverseId\': 481476}, \'multiverseid\': 481476}, {\'name\': \'Всемогущий Брушвагг\', \'text\': \'Пробивной удар\\n{3}{G}: Всемогущий Брушвагг получает +3/+3 до конца хода.\', \'type\': \'Существо — Брушвагг\', \'flavor\': \'Посмеялся над брушваггом\\n— выражение охотников, означающее\\n«неожиданно умер»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481735&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ae24ad63-a92a-4dc8-8b5c-c3c95d441e61\', \'multiverseId\': 481735}, \'multiverseid\': 481735}, {\'name\': \'威能丛枝兽\', \'text\': \'践踏\\n{3}{G}：威能丛枝兽得+3/+3直到回合结束。\', \'type\': \'生物 ～丛枝兽\', \'flavor\': \'嘲笑丛枝兽\\n～猎人用语，意指\\n「意外死亡」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481994&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3af0775a-f77e-43a3-95dc-74b653e2a29e\', \'multiverseId\': 481994}, \'multiverseid\': 481994}, {\'name\': \'威能叢枝獸\', \'text\': \'踐踏\\n{3}{G}：威能叢枝獸得+3/+3直到回合結束。\', \'type\': \'生物 ～叢枝獸\', \'flavor\': \'嘲笑叢枝獸\\n～獵人用語，意指\\n「意外死亡」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482253&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'efd89407-2bad-4e83-9cd2-3e2e56d2ea55\', \'multiverseId\': 482253}, \'multiverseid\': 482253}]', '[{\'name\': \'Mähnenserval\', \'text\': \'Wachsamkeit\', \'type\': \'Kreatur — Katze\', \'flavor\': \'„Durchsuche die Ruinen von Orn nicht bei Tag. Nethrois Augen werden dich sofort erblicken. Und geh auch nicht bei Nacht. Du bist sonst das Abendmahl der Servale. Besser du gehst nie."\\n—Rasai, Indatha-Jägerin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479802&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'05245c0c-75ea-463a-b8c9-c02626d3a87f\', \'multiverseId\': 479802}, \'multiverseid\': 479802}, {\'name\': \'Serval crinado\', \'text\': \'Vigilancia.\', \'type\': \'Criatura — Felino\', \'flavor\': \'"No explores las ruinas de Orn a la luz del día. Los múltiples ojos de Nethroi te detectarán al instante. Y tampoco vayas de noche. Servirás de cena a los servales. Lo mejor será que no vayas".\\n—Rasai, cazadora de Indatha\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480061&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5a3faa03-f671-409c-b2c5-872c0418d914\', \'multiverseId\': 480061}, \'multiverseid\': 480061}, {\'name\': \'Serval à crinière\', \'text\': \'Vigilance\', \'type\': \'Créature : chat\', \'flavor\': "« Ne fouillez pas les ruines d\'Orn en plein jour. Les yeux innombrables de Nethroï vous repéreront immédiatement. N\'y allez pas non plus la nuit. Vous servirez de dîner aux servals. En fait, n\'y allez pas. »\\n—Rasaï, chasseuse d\'Indatha", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480320&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'90eab209-8b5c-4230-8af4-4c7a0b2b8610\', \'multiverseId\': 480320}, \'multiverseid\': 480320}, {\'name\': \'Servalo dalla Criniera\', \'text\': \'Cautela\', \'type\': \'Creatura — Felino\', \'flavor\': \'"Non esplorare le rovine di Orn durante il giorno. I molti occhi di Nethroi ti scorgeranno all\\\'istante. Non visitarle neppure di notte. Sarai la cena dei servali. Meglio non andarci e basta."\\n—Rasai, cacciatrice di Indatha\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480579&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c999223f-2b19-4426-92ae-c8fc4a82b383\', \'multiverseId\': 480579}, \'multiverseid\': 480579}, {\'name\': \'たてがみサーバル\', \'text\': \'警戒\', \'type\': \'クリーチャー — 猫\', \'flavor\': \'「日中にオーンの廃墟を探索しないことね。ネスロイの無数の目にすぐ見つかってしまうわ。夜に行っても駄目。サーバルの夕食になってしまうから。行かないのが一番でしょうね。」\\n――インダサの狩人、ラサーイ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480838&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d5a10934-ff5a-47e5-826a-c021474087ca\', \'multiverseId\': 480838}, \'multiverseid\': 480838}, {\'name\': \'갈기난 살쾡이\', \'text\': \'경계\', \'type\': \'생물 — 고양이\', \'flavor\': \'"낮 동안에는 오른의 폐허를 수색하지 마라. 네스로이의 수많은 눈이 널 그 즉시 찾을 것이다. 밤에도 그 곳에 가지 마라. 살쾡이들의 저녁거리가 될 뿐이다. 그냥 어쨌든 가지 마라."\\n—인다타 사냥꾼, 라사이\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481097&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b845a936-bffe-45e8-8507-9b8e27415957\', \'multiverseId\': 481097}, \'multiverseid\': 481097}, {\'name\': \'Serval-de-crina\', \'text\': \'Vigilância\', \'type\': \'Criatura — Felino\', \'flavor\': \'"Não vasculhe as ruínas de Orn durante o dia. Os muitos olhos de Nethroi verão você imediatamente. Mas também não vá à noite. Os servais vão jantar você. Talvez seja melhor nem ir."\\n— Rasai, caçadora de Indatha\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481356&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f48a11da-a6a5-42f3-a735-ca04b40cbcb2\', \'multiverseId\': 481356}, \'multiverseid\': 481356}, {\'name\': \'Гривистый Сервал\', \'text\': \'Бдительность\', \'type\': \'Существо — Кошка\', \'flavor\': \'«Не стоит шастать в руинах Орна днем. Тебя тут же заметят многочисленные глаза Нетроя. Ночью тоже не ходи. Попадешь на обед сервалам. Наверное, лучше вообще туда не лезть».\\n— Расай, индатская охотница\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481615&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'16269026-87ef-4a91-a472-de601d8705e8\', \'multiverseId\': 481615}, \'multiverseid\': 481615}, {\'name\': \'鬃毛薮猫\', \'text\': \'警戒\', \'type\': \'生物 ～猫\', \'flavor\': \'「不要在白天去探索奥恩遗址。涅司罗有很多眼睛会立刻盯上你。晚上也不要去。那边有薮猫游荡，小心变成它们的晚餐。也许干脆就不去比较好。」\\n～因达沙猎人拉塞\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481874&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'18125233-a148-41c1-9ed0-38eadc89cd13\', \'multiverseId\': 481874}, \'multiverseid\': 481874}, {\'name\': \'鬃毛藪貓\', \'text\': \'警戒\', \'type\': \'生物 ～貓\', \'flavor\': \'「不要在白天去探索奧恩遺址。涅司羅有很多眼睛會立刻盯上你。晚上也不要去。那邊有藪貓遊蕩，小心變成牠們的晚餐。也許乾脆就不去比較好。」\\n～因達沙獵人拉塞\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482133&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8666f5be-de27-438a-b337-a02a02685df2\', \'multiverseId\': 482133}, \'multiverseid\': 482133}]', '[{\'name\': \'Narset des alten Weges\', \'text\': \'+1: Du erhältst 2 Lebenspunkte dazu. Erzeuge {U}, {R} oder {W}. Verwende dieses Mana nur, um einen Nichtkreatur-Zauberspruch zu wirken.\\n−2: Ziehe eine Karte, dann kannst du eine Karte abwerfen. Wenn du auf diese Weise eine Nichtland-Karte abwirfst, fügt Narset des alten Weges einer Kreatur oder einem Planeswalker deiner Wahl Schadenspunkte in Höhe der umgewandelten Manakosten jener Karte zu.\\n−6: Du erhältst ein Emblem mit „Immer wenn du einen Nichtkreatur-Zauberspruch wirkst, fügt dieses Emblem einem Ziel deiner Wahl 2 Schadenspunkte zu."\', \'type\': \'Legendärer Planeswalker — Narset\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479974&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e428658e-3069-45c6-b85b-830a381b02be\', \'multiverseId\': 479974}, \'multiverseid\': 479974}, {\'name\': \'Narset de los métodos antiguos\', \'text\': \'+1: Ganas 2 vidas. Agrega {U}, {R} o {W}. Usa este maná solo para lanzar un hechizo que no sea de criatura.\\n−2: Roba una carta, luego puedes descartar una carta. Cuando descartes una carta que no sea tierra de esta manera, Narset de los métodos antiguos hace una cantidad de daño igual al coste de maná convertido de esa carta a la criatura o planeswalker objetivo.\\n−6: Obtienes un emblema con "Siempre que lances un hechizo que no sea de criatura, este emblema hace 2 puntos de daño a cualquier objetivo".\', \'type\': \'Planeswalker legendario — Narset\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480233&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'891eb742-4eef-4f3c-b0ce-d2d3791f95b2\', \'multiverseId\': 480233}, \'multiverseid\': 480233}, {\'name\': \'Narset des traditions\', \'text\': "+1: Vous gagnez 2 points de vie. Ajoutez {U}, {R} ou {W}. Ne dépensez ce mana que pour lancer un sort non-créature.\\n-2: Piochez une carte, puis défaussez-vous d\'une carte. Quand vous vous défaussez d\'une carte non-terrain de cette manière, Narset des traditions inflige un nombre de blessures égal au coût converti de mana de cette carte à une cible, créature ou planeswalker.\\n-6: Vous gagnez un emblème avec « À chaque fois que vous lancez un sort non-créature, cet emblème inflige 2 blessures à n\'importe quelle cible. »", \'type\': \'Planeswalker légendaire : Narset\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480492&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ad4df5cd-47e8-4262-9c87-b0ad91e84dad\', \'multiverseId\': 480492}, \'multiverseid\': 480492}, {\'name\': \'Narset della Tradizione Antica\', \'text\': \'+1: Guadagni 2 punti vita. Aggiungi {U}, {R} o {W}. Spendi questo mana solo per lanciare una magia non creatura.\\n-2: Pesca una carta, poi puoi scartare una carta. Quando scarti una carta non terra in questo modo, Narset della Tradizione Antica infligge a una creatura o a un planeswalker bersaglio danno pari al costo di mana convertito di quella carta.\\n-6: Ottieni un emblema con "Ogniqualvolta lanci una magia non creatura, questo emblema infligge 2 danni a un qualsiasi bersaglio".\', \'type\': \'Planeswalker Leggendario — Narset\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480751&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'691854d6-231f-40ac-95c5-3d417c25f189\', \'multiverseId\': 480751}, \'multiverseid\': 480751}, {\'name\': \'古き道のナーセット\', \'text\': \'+1：あなたは２点のライフを得る。{U}か{R}か{W}を加える。このマナは、クリーチャーでない呪文を唱えるためにのみ使用できる。\\n-2：カードを１枚引く。その後、あなたはカード１枚を捨ててもよい。あなたがこれにより土地でないカードを１枚捨てたとき、クリーチャー１体かプレインズウォーカー１体を対象とする。古き道のナーセットはそれに、その捨てたカードの点数で見たマナ・コストに等しい点数のダメージを与える。\\n-6：あなたは「あなたがクリーチャーでない呪文を唱えるたび、クリーチャー１体かプレインズウォーカー１体かプレイヤー１人を対象とする。この紋章はそれに２点のダメージを与える。」を持つ紋章を得る。\', \'type\': \'伝説のプレインズウォーカー — ナーセット\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481010&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'36c8722b-77c5-4ddf-a2e0-bcef69adec8c\', \'multiverseId\': 481010}, \'multiverseid\': 481010}, {\'name\': \'고대의 도를 따르는 나르셋\', \'text\': \'+1: 당신은 생명 2점을 얻는다. {U}, {R}, 또는 {W}를 추가한다. 이 마나는 생물이 아닌 주문을 발동하는 데에만 사용할 수 있다.\\n−2: 카드 한 장을 뽑는다. 그 후, 당신은 카드 한 장을 버릴 수 있다. 당신이 이런 식으로 대지가 아닌 카드를 버릴 때, 생물 또는 플레인즈워커를 목표로 정한다. 고대의 도를 따르는 나르셋은 그 목표에게 그 카드의 전환마나비용만큼 피해를 입힌다.\\n−6: 당신은 "당신이 생물이 아닌 주문을 발동할 때마다, 원하는 목표를 정한다. 이 휘장은 그 목표에게 피해 2점을 입힌다."를 가진 휘장을 얻는다.\', \'type\': \'전설적 플레인즈워커 — 나르셋\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481269&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ca4a7a65-b76e-4896-aac3-4933c83c5be0\', \'multiverseId\': 481269}, \'multiverseid\': 481269}, {\'name\': \'Narset do Caminho Antigo\', \'text\': \'+1: Você ganha 2 pontos de vida. Adicione {U}, {R} ou {W}. Gaste este mana somente para conjurar mágicas que não sejam de criatura.\\n−2: Compre um card. Em seguida, você pode descartar um card. Quando você descarta um card que não seja um terreno dessa forma, Narset do Caminho Antigo causa uma quantidade de dano igual ao custo de mana convertido do card à criatura ou ao planeswalker alvo.\\n−6: Você recebe um emblema com "Toda vez que você conjura uma mágica que não seja de criatura, este emblema causa 2 pontos de dano a qualquer alvo.".\', \'type\': \'Planeswalker Lendário — Narset\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481528&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cfef96ac-92b0-483d-ba19-5c9ec80c85bc\', \'multiverseId\': 481528}, \'multiverseid\': 481528}, {\'name\': \'Нарсет Древнего Пути\', \'text\': "+1: вы получаете 2 жизни. Добавьте {U}, {R} или {W}. Тратьте эту ману только на разыгрывание не являющегося существом заклинания.\\n−2: возьмите карту, затем вы можете сбросить карту. Когда вы сбрасываете таким образом карту, не являющуюся землей, Нарсет Древнего Пути наносит целевому существу или planeswalker\'у повреждения, равные конвертированной мана-стоимости той карты.\\n−6: вы получаете эмблему со способностью «Каждый раз, когда вы разыгрываете не являющееся существом заклинание, эта эмблема наносит 2 повреждения любой цели».", \'type\': \'Легендарный Planeswalker — Нарсет\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481787&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3d155ddc-c6b3-4248-bac3-7b9d865fb46b\', \'multiverseId\': 481787}, \'multiverseid\': 481787}, {\'name\': \'古道娜尔施\', \'text\': \'+1：你获得2点生命。加{U}，{R}或{W}。此法术力只能用来施放非生物咒语。\\n−2：抓一张牌，然后你可以弃一张牌。当你以此法弃掉一张非地牌时，古道娜尔施对目标生物或鹏洛客造成伤害，其数量等同于该牌的总法术力费用。\\n−6：你获得具有「每当你施放非生物咒语时，此徽记对任意一个目标造成2点伤害」的徽记。\', \'type\': \'传奇鹏洛客 ～娜尔施\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482046&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9ccdd4e9-1ac0-45b9-89d7-c3905e0e5bee\', \'multiverseId\': 482046}, \'multiverseid\': 482046}, {\'name\': \'古道娜爾施\', \'text\': \'+1：你獲得2點生命。加{U}，{R}或{W}。此魔法力只能用來施放非生物咒語。\\n−2：抽一張牌，然後你可以棄一張牌。當你以此法棄掉一張非地牌時，古道娜爾施對目標生物或鵬洛客造成傷害，其數量等同於該牌的總魔法力費用。\\n−6：你獲得具有「每當你施放非生物咒語時，此徽記對任意一個目標造成2點傷害」的徽記。\', \'type\': \'傳奇鵬洛客 ～娜爾施\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482305&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'63be39b2-1481-4e28-8090-9cec494d80ac\', \'multiverseId\': 482305}, \'multiverseid\': 482305}]', '[{\'name\': \'Nekropanther\', \'text\': \'Mutation {2}{W/B}{W/B} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\nImmer wenn diese Kreatur mutiert, bringe eine Kreaturenkarte deiner Wahl mit umgewandelten Manakosten von 3 oder weniger aus deinem Friedhof ins Spiel zurück.\', \'type\': \'Kreatur — Katze, Nachtmahr\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479975&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f239bb38-5d31-4070-8ab5-3c3287f3b86f\', \'multiverseId\': 479975}, \'multiverseid\': 479975}, {\'name\': \'Necropantera\', \'text\': \'Mutación {2}{W/B}{W/B}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\nSiempre que esta criatura mute, regresa la carta de criatura objetivo con coste de maná convertido de 3 o menos de tu cementerio al campo de batalla.\', \'type\': \'Criatura — Pesadilla felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480234&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f88874ba-d205-4f81-aadb-e07283af4cca\', \'multiverseId\': 480234}, \'multiverseid\': 480234}, {\'name\': \'Nécropanthère\', \'text\': "Mutation {2}{W/B}{W/B} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\nÀ chaque fois que cette créature subit une mutation, renvoyez sur le champ de bataille depuis votre cimetière une carte de créature ciblée avec un coût converti de mana inférieur ou égal à 3.", \'type\': \'Créature : chat et cauchemar\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480493&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8e3d4e65-bafe-478b-949d-41d4682d6d29\', \'multiverseId\': 480493}, \'multiverseid\': 480493}, {\'name\': \'Necropantera\', \'text\': \'Mutazione {2}{W/B}{W/B} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\nOgniqualvolta questa creatura muta, rimetti sul campo di battaglia una carta creatura bersaglio con costo di mana convertito pari o inferiore a 3 dal tuo cimitero.\', \'type\': \'Creatura — Incubo Felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480752&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c1de06fa-d209-4748-94a8-e4630322c67f\', \'multiverseId\': 480752}, \'multiverseid\': 480752}, {\'name\': \'屍豹\', \'text\': \'変容{2}{W/B}{W/B}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\nこのクリーチャーが変容するたび、あなたの墓地から点数で見たマナ・コストが３以下のクリーチャー・カード１枚を対象とし、それを戦場に戻す。\', \'type\': \'クリーチャー — 猫・ナイトメア\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481011&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3d44f09e-de45-4273-becb-3122e19df211\', \'multiverseId\': 481011}, \'multiverseid\': 481011}, {\'name\': \'사령표범\', \'text\': \'돌연변이화 {2}{W/B}{W/B} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n이 생물이 돌연변이화할 때마다, 당신의 무덤에 있는 전환마나비용이 3 이하인 생물 카드를 목표로 정한다. 그 카드를 전장으로 되돌린다.\', \'type\': \'생물 — 고양이 나이트메어\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481270&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e3344ed9-eb37-482d-800c-56780235deea\', \'multiverseId\': 481270}, \'multiverseid\': 481270}, {\'name\': \'Necropantera\', \'text\': \'Mutação {2}{W/B}{W/B} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\nToda vez que esta criatura sofrer mutação, devolva de seu cemitério para o campo de batalha o card de criatura alvo com custo de mana convertido igual ou inferior a 3.\', \'type\': \'Criatura — Felino Pesadelo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481529&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'15d3f14f-74a5-4e41-b1b2-70bb60412612\', \'multiverseId\': 481529}, \'multiverseid\': 481529}, {\'name\': \'Некропантера\', \'text\': \'Мутация {2}{W/B}{W/B} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\nКаждый раз, когда это существо мутирует, верните целевую карту существа с конвертированной мана-стоимостью не более 3 из вашего кладбища на поле битвы.\', \'type\': \'Существо — Кошка Кошмар\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481788&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a85578ad-c1fa-49a4-82eb-da0c50970f37\', \'multiverseId\': 481788}, \'multiverseid\': 481788}, {\'name\': \'死冥猎豹\', \'text\': \'合变{2}{W/B}{W/B}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n每当此生物合变时，将目标总法术力费用等于或小于3的生物牌从你的坟墓场移回战场。\', \'type\': \'生物 ～猫／梦魇\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482047&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8e9c575f-11d2-4920-9231-325638fbdb6e\', \'multiverseId\': 482047}, \'multiverseid\': 482047}, {\'name\': \'死冥獵豹\', \'text\': \'合變{2}{W/B}{W/B}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n每當此生物合變時，將目標總魔法力費用等於或小於3的生物牌從你的墳墓場移回戰場。\', \'type\': \'生物 ～貓／夢魘\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482306&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'48c55f03-bf1a-4990-8e09-aabbf1ae4f9c\', \'multiverseId\': 482306}, \'multiverseid\': 482306}]', '[{\'name\': \'Nethroi, Apex des Todes\', \'text\': \'Mutation {4}{G/W}{B}{B} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\nTodesberührung, Lebensverknüpfung\\nImmer wenn diese Kreatur mutiert, bringe eine beliebige Anzahl an Kreaturenkarten deiner Wahl mit einer Gesamtstärke von 10 oder weniger aus deinem Friedhof ins Spiel zurück.\', \'type\': \'Legendäre Kreatur — Katze, Nachtmahr, Bestie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479976&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'26949c43-2f54-4b1a-93ee-87697813b026\', \'multiverseId\': 479976}, \'multiverseid\': 479976}, {\'name\': \'Nethroi, Alfa de la Muerte\', \'text\': \'Mutación {4}{G/W}{B}{B}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\nToque mortal, vínculo vital.\\nSiempre que esta criatura mute, regresa cualquier cantidad de cartas de criatura objetivo con fuerza total de 10 o menos de tu cementerio al campo de batalla.\', \'type\': \'Criatura legendaria — Felino pesadilla bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480235&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c08e0eb0-4c84-48fe-bda9-6fd827de1cd5\', \'multiverseId\': 480235}, \'multiverseid\': 480235}, {\'name\': \'Nethroï, Zénith de la mort\', \'text\': "Mutation {4}{G/W}{B}{B} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\nContact mortel, lien de vie\\nÀ chaque fois que cette créature subit une mutation, renvoyez sur le champ de bataille depuis votre cimetière n\'importe quel nombre de créatures de force totale inférieure ou égale à 10.", \'type\': \'Créature légendaire : chat et cauchemar et bête\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480494&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d05f4331-5fb4-4653-951f-1d933cf4af54\', \'multiverseId\': 480494}, \'multiverseid\': 480494}, {\'name\': \'Nethroi, Alfa della Morte\', \'text\': \'Mutazione {4}{G/W}{B}{B} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\nTocco letale, legame vitale\\nOgniqualvolta questa creatura muta, rimetti sul campo di battaglia un qualsiasi numero di carte creatura bersaglio con forza totale pari o inferiore a 10 dal tuo cimitero.\', \'type\': \'Creatura Leggendaria — Bestia Incubo Felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480753&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ef11b30f-8b5e-47bc-b748-5678518654b5\', \'multiverseId\': 480753}, \'multiverseid\': 480753}, {\'name\': \'死の頂点、ネスロイ\', \'text\': \'変容{4}{G/W}{B}{B}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\n接死、絆魂\\nこのクリーチャーが変容するたび、あなたの墓地から望む数のクリーチャー・カードをパワーの合計が10以下になるように対象とし、それらを戦場に戻す。\', \'type\': \'伝説のクリーチャー — 猫・ナイトメア・ビースト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481012&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'49fbc912-827d-4dcd-b3d3-a2dcec41b10d\', \'multiverseId\': 481012}, \'multiverseid\': 481012}, {\'name\': \'죽음의 정점, 네스로이\', \'text\': \'돌연변이화 {4}{G/W}{B}{B} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n치명타, 생명연결\\n이 생물이 돌연변이화할 때마다, 당신의 무덤에 있는 생물 카드들을 총 공격력이 10 이하가 되도록 원하는 수만큼 목표로 정한다. 그 카드들을 전장으로 되돌린다.\', \'type\': \'전설적 생물 — 고양이 나이트메어 야수\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481271&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'fbdb8b6b-1c2e-4c15-9caa-87087610583b\', \'multiverseId\': 481271}, \'multiverseid\': 481271}, {\'name\': \'Nethroi, Ápice da Morte\', \'text\': \'Mutação {4}{G/W}{B}{B} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\nToque mortífero, vínculo com a vida\\nToda vez que esta criatura sofrer mutação, devolva qualquer número de cards de criatura alvo com total de poder igual ou inferior a 10 de seu cemitério para o campo de batalha.\', \'type\': \'Criatura Lendária — Felino Pesadelo Besta\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481530&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'30c868e8-aef6-4d92-b32d-96a67f7d3d38\', \'multiverseId\': 481530}, \'multiverseid\': 481530}, {\'name\': \'Нетрой, Венец Смерти\', \'text\': \'Мутация {4}{G/W}{B}{B} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\nСмертельное касание, Цепь жизни\\nКаждый раз, когда это существо мутирует, верните любое количество целевых карт существ с суммарной силой не более 10 из вашего кладбища на поле битвы.\', \'type\': \'Легендарное Существо — Кошка Кошмар Зверь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481789&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2e520531-7afa-4cc7-b7b8-3988c755774f\', \'multiverseId\': 481789}, \'multiverseid\': 481789}, {\'name\': \'夺命霸狮涅司罗\', \'text\': \'合变{4}{G/W}{B}{B}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n死触，系命\\n每当此生物合变时，将任意数量的目标生物牌从你的坟墓场移回战场，且这些牌的力量总和须等于或小于10。\', \'type\': \'传奇生物 ～猫／梦魇／野兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482048&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'403644d8-589c-4fce-8ded-3232db714471\', \'multiverseId\': 482048}, \'multiverseid\': 482048}, {\'name\': \'奪命霸獅涅司羅\', \'text\': \'合變{4}{G/W}{B}{B}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n死觸，繫命\\n每當此生物合變時，將任意數量的目標生物牌從你的墳墓場移回戰場，且這些牌的力量總和須等於或小於10。\', \'type\': \'傳奇生物 ～貓／夢魘／野獸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482307&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'52d79cd6-91f8-4df1-aa54-98bc606afcad\', \'multiverseId\': 482307}, \'multiverseid\': 482307}]', '[{\'name\': \'Nethroi, Apex des Todes\', \'text\': \'Mutation {4}{G/W}{B}{B}\\nTodesberührung, Lebensverknüpfung\\nImmer wenn diese Kreatur mutiert, bringe eine beliebige Anzahl an Kreaturenkarten deiner Wahl mit einer Gesamtstärke von 10 oder weniger aus deinem Friedhof ins Spiel zurück.\', \'type\': \'Legendäre Kreatur — Katze, Nachtmahr, Bestie\', \'flavor\': \'Biollante, Pflanzen-Bestien-Hybride\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482393&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b8545413-59b2-46ba-a883-0f78472b54c3\', \'multiverseId\': 482393}, \'multiverseid\': 482393}, {\'name\': \'Nethroi, Alfa de la Muerte\', \'text\': \'Mutación {4}{G/W}{B}{B}.\\nToque mortal, vínculo vital.\\nSiempre que esta criatura mute, regresa cualquier cantidad de cartas de criatura objetivo con fuerza total de 10 o menos de tu cementerio al campo de batalla.\', \'type\': \'Criatura legendaria — Felino pesadilla bestia\', \'flavor\': \'Biollante, forma de planta bestia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482407&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'aeb36993-3c57-4efe-8e5d-5451e7296394\', \'multiverseId\': 482407}, \'multiverseid\': 482407}, {\'name\': \'Nethroï, Zénith de la mort\', \'text\': "Mutation {4}{G/W}{B}{B}\\nContact mortel, lien de vie\\nÀ chaque fois que cette créature subit une mutation, renvoyez sur le champ de bataille depuis votre cimetière n\'importe quel nombre de créatures de force totale inférieure ou égale à 10.", \'type\': \'Créature légendaire : chat et cauchemar et bête\', \'flavor\': \'Biollante, forme végétale monstrueuse\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482421&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'71a1b6f4-4967-4bc8-88f2-e0c04731219c\', \'multiverseId\': 482421}, \'multiverseid\': 482421}, {\'name\': \'Nethroi, Alfa della Morte\', \'text\': \'Mutazione {4}{G/W}{B}{B}\\nTocco letale, legame vitale\\nOgniqualvolta questa creatura muta, rimetti sul campo di battaglia un qualsiasi numero di carte creatura bersaglio con forza totale pari o inferiore a 10 dal tuo cimitero.\', \'type\': \'Creatura Leggendaria — Bestia Incubo Felino\', \'flavor\': \'Biollante, Bestia Piantiforme\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482435&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'035c5b0c-9f78-4130-8262-1edd07de96ae\', \'multiverseId\': 482435}, \'multiverseid\': 482435}, {\'name\': \'死の頂点、ネスロイ\', \'text\': \'変容{4}{G/W}{B}{B}\\n接死、絆魂\\nこのクリーチャーが変容するたび、あなたの墓地から望む数のクリーチャー・カードをパワーの合計が10以下になるように対象とし、それらを戦場に戻す。\', \'type\': \'伝説のクリーチャー — 猫・ナイトメア・ビースト\', \'flavor\': \'植（しょく）獣（じゅう）形（けい）態（たい）、ビオランテ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482449&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'002d1bfe-d248-4ba5-aa93-8eca888894db\', \'multiverseId\': 482449}, \'multiverseid\': 482449}, {\'name\': \'죽음의 정점, 네스로이\', \'text\': \'돌연변이화 {4}{G/W}{B}{B}\\n치명타, 생명연결\\n이 생물이 돌연변이화할 때마다, 당신의 무덤에 있는 생물 카드들을 총 공격력이 10 이하가 되도록 원하는 수만큼 목표로 정한다. 그 카드들을 전장으로 되돌린다.\', \'type\': \'전설적 생물 — 고양이 나이트메어 야수\', \'flavor\': \'식물 야수 형상, 비오란테\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482463&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'07ad1348-2d3d-43cc-95b5-e56810f6631f\', \'multiverseId\': 482463}, \'multiverseid\': 482463}, {\'name\': \'Nethroi, Ápice da Morte\', \'text\': \'Mutação {4}{G/W}{B}{B}\\nToque mortífero, vínculo com a vida\\nToda vez que esta criatura sofrer mutação, devolva qualquer número de cards de criatura alvo com total de poder igual ou inferior a 10 de seu cemitério para o campo de batalha.\', \'type\': \'Criatura Lendária — Felino Pesadelo Besta\', \'flavor\': \'Biollante, Forma da Planta Fera\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482477&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'31ff6dac-1620-4382-8b51-243e6f3be38f\', \'multiverseId\': 482477}, \'multiverseid\': 482477}, {\'name\': \'Нетрой, Венец Смерти\', \'text\': \'Мутация {4}{G/W}{B}{B}\\nСмертельное касание, Цепь жизни\\nКаждый раз, когда это существо мутирует, верните любое количество целевых карт существ с суммарной силой не более 10 из вашего кладбища на поле битвы.\', \'type\': \'Легендарное Существо — Кошка Кошмар Зверь\', \'flavor\': \'Биолланте, Растительное Чудовище\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482491&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fc4a8e29-f0b1-4ef4-abd9-eba852550c06\', \'multiverseId\': 482491}, \'multiverseid\': 482491}, {\'name\': \'夺命霸狮涅司罗\', \'text\': \'合变{4}{G/W}{B}{B}\\n死触，系命\\n每当此生物合变时，将任意数量的目标生物牌从你的坟墓场移回战场，且这些牌的力量总和须等于或小于10。\', \'type\': \'传奇生物 ～猫／梦魇／野兽\', \'flavor\': \'植兽形态碧奥兰蒂\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482505&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b919ea1e-7a79-4bb1-a659-354afc64a44c\', \'multiverseId\': 482505}, \'multiverseid\': 482505}, {\'name\': \'奪命霸獅涅司羅\', \'text\': \'合變{4}{G/W}{B}{B}\\n死觸，繫命\\n每當此生物合變時，將任意數量的目標生物牌從你的墳墓場移回戰場，且這些牌的力量總和須等於或小於10。\', \'type\': \'傳奇生物 ～貓／夢魘／野獸\', \'flavor\': \'植獸形態碧奧蘭蒂\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482519&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2a183601-b882-40a7-8639-b842a997cced\', \'multiverseId\': 482519}, \'multiverseid\': 482519}]', "[{'name': 'Neutralisieren', 'text': 'Neutralisiere einen Zauberspruch deiner Wahl.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)', 'type': 'Spontanzauber', 'flavor': 'Auf Ikoria kann reaktive Magie den Unterschied zwischen kaum angekratzt und richtig tot machen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479838&type=card', 'language': 'German', 'identifiers': {'scryfallId': '299111bd-2f82-4304-afc3-2ae4cc368a37', 'multiverseId': 479838}, 'multiverseid': 479838}, {'name': 'Neutralizar', 'text': 'Contrarresta el hechizo objetivo.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)', 'type': 'Instantáneo', 'flavor': 'En Ikoria, la magia reactiva puede marcar la diferencia entre un pequeño rasguño y una muerte segura.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480097&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '642ccd24-9103-40db-98e9-908d2cb89b62', 'multiverseId': 480097}, 'multiverseid': 480097}, {'name': 'Neutralisation', 'text': 'Contrecarrez le sort ciblé.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)', 'type': 'Éphémère', 'flavor': 'Sur Ikoria, la magie réactive peut faire toute la différence entre une égratignure et une blessure très mortelle.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480356&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'fcd7581b-0555-4bdb-9de4-fe9d53819cd2', 'multiverseId': 480356}, 'multiverseid': 480356}, {'name': 'Neutralizzare', 'text': 'Neutralizza una magia bersaglio.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)', 'type': 'Istantaneo', 'flavor': 'Su Ikoria, la magia reattiva può fare la differenza tra appena sfiorato e morto stecchito.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480615&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '8884dbbe-17d0-4a73-bfd9-29f3f4f33204', 'multiverseId': 480615}, 'multiverseid': 480615}, {'name': '中和', 'text': '呪文１つを対象とし、それを打ち消す。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）', 'type': 'インスタント', 'flavor': 'イコリアでは、瞬発的な魔法がかすり傷と死の分かれ目になる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480874&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '649cf62c-8173-4a21-b01e-72e7f12b13cb', 'multiverseId': 480874}, 'multiverseid': 480874}, {'name': '무력화', 'text': '주문을 목표로 정한다. 그 주문을 무효화한다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)', 'type': '순간마법', 'flavor': '이코리아에서, 대응 마법은 살갗만 스친 것과 정말로 죽는 것의 차이를 만들어낼 수 있다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481133&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'ff270ee9-501f-4877-ad52-bf36a6e29a7c', 'multiverseId': 481133}, 'multiverseid': 481133}, {'name': 'Neutralizar', 'text': 'Anule a mágica alvo.\\nReciclar {2} ({2}, descarte este card: Compre um card.)', 'type': 'Mágica Instantânea', 'flavor': 'Em Ikoria, a magia reativa pode fazer a diferença entre ser pego de raspão e ser pego em cheio.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481392&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '72d0c4c6-029e-4d46-8bf8-4936f7e9a978', 'multiverseId': 481392}, 'multiverseid': 481392}, {'name': 'Обезвредить', 'text': 'Отмените целевое заклинание.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)', 'type': 'Мгновенное заклинание', 'flavor': 'На Икории от защитной магии зачастую зависит разница между легкой царапиной и мучительной смертью.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481651&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '88e58806-4107-4e86-920b-baece92fb869', 'multiverseId': 481651}, 'multiverseid': 481651}, {'name': '解除威胁', 'text': '反击目标咒语。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）', 'type': '瞬间', 'flavor': '以魔法快速回应状况的效率，在依克黎结果会是轻微擦伤或一命呜呼的区别。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481910&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '17262989-ad48-49ec-b045-701f96a47a3c', 'multiverseId': 481910}, 'multiverseid': 481910}, {'name': '解除威脅', 'text': '反擊目標咒語。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）', 'type': '瞬間', 'flavor': '以魔法快速回應狀況的效率，在依克黎結果會是輕微擦傷或一命嗚呼的區別。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482169&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '6a154a38-6e97-4d43-b7ff-e4496a7ff7e9', 'multiverseId': 482169}, 'multiverseid': 482169}]", '[{\'name\': \'Nobler Leosaurus\', \'text\': \'Mutation {1}{R/W}{R/W} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\nImmer wenn diese Kreatur mutiert, erhalten andere Kreaturen, die du kontrollierst, +2/+1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Dinosaurier, Katze\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479981&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'33831010-0417-46af-bdae-442f686ad3b2\', \'multiverseId\': 479981}, \'multiverseid\': 479981}, {\'name\': \'Leosaurio majestuoso\', \'text\': \'Mutación {1}{R/W}{R/W}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\nSiempre que esta criatura mute, las otras criaturas que controlas obtienen +2/+1 hasta el final del turno.\', \'type\': \'Criatura — Felino dinosaurio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480240&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'27715e20-8b7a-4ed5-be32-05bafc0829ea\', \'multiverseId\': 480240}, \'multiverseid\': 480240}, {\'name\': \'Léosaure royal\', \'text\': "Mutation {1}{R/W}{R/W} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\nÀ chaque fois que cette créature subit une mutation, les autres créatures que vous contrôlez gagnent +2/+1 jusqu\'à la fin du tour.", \'type\': \'Créature : dinosaure et chat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480499&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1e25f76d-8e70-4c2d-8f45-18e679034785\', \'multiverseId\': 480499}, \'multiverseid\': 480499}, {\'name\': \'Leosauro Regale\', \'text\': \'Mutazione {1}{R/W}{R/W} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\nOgniqualvolta questa creatura muta, le altre creature che controlli prendono +2/+1 fino alla fine del turno.\', \'type\': \'Creatura — Felino Dinosauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480758&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8f32c5df-3899-429a-8e2f-276a794da854\', \'multiverseId\': 480758}, \'multiverseid\': 480758}, {\'name\': \'威厳あるレオサウルス\', \'text\': \'変容{1}{R/W}{R/W}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\nこのクリーチャーが変容するたび、ターン終了時まで、他の、あなたがコントロールしているクリーチャーは＋２/＋１の修整を受ける。\', \'type\': \'クリーチャー — 恐竜・猫\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481017&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c40d1a90-6712-40ec-b618-612a7c75b224\', \'multiverseId\': 481017}, \'multiverseid\': 481017}, {\'name\': \'근엄한 레오사우루스\', \'text\': \'돌연변이화 {1}{R/W}{R/W} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n이 생물이 돌연변이화할 때마다, 당신이 조종하는 다른 생물들은 턴종료까지 +2/+1을 받는다.\', \'type\': \'생물 — 공룡 고양이\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481276&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3d55cb5f-4aac-4d88-8795-b830c0bf7ad0\', \'multiverseId\': 481276}, \'multiverseid\': 481276}, {\'name\': \'Leossauro Régio\', \'text\': \'Mutação {1}{R/W}{R/W} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\nToda vez que esta criatura sofre mutação, as outras criaturas que você controla recebem +2/+1 até o final do turno.\', \'type\': \'Criatura — Dinossauro Felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481535&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5055fd44-f08b-49f2-bbf4-cede87405359\', \'multiverseId\': 481535}, \'multiverseid\': 481535}, {\'name\': \'Царственный Леозавр\', \'text\': \'Мутация {1}{R/W}{R/W} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\nКаждый раз, когда это существо мутирует, другие существа под вашим контролем получают +2/+1 до конца хода.\', \'type\': \'Существо — Динозавр Кошка\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481794&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f0b8edd5-016f-4ed4-9cb9-84ecb9666a9c\', \'multiverseId\': 481794}, \'multiverseid\': 481794}, {\'name\': \'威严狮龙\', \'text\': \'合变{1}{R/W}{R/W}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n每当此生物合变时，由你操控的其他生物得+2/+1直到回合结束。\', \'type\': \'生物 ～恐龙／猫\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482053&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0a5d52bb-cab0-4c73-b6a0-2b1ffc99c2a4\', \'multiverseId\': 482053}, \'multiverseid\': 482053}, {\'name\': \'威嚴獅龍\', \'text\': \'合變{1}{R/W}{R/W}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n每當此生物合變時，由你操控的其他生物得+2/+1直到回合結束。\', \'type\': \'生物 ～恐龍／貓\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482312&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4a68c35d-5918-45bb-a000-fb644d274c12\', \'multiverseId\': 482312}, \'multiverseid\': 482312}]', '[{\'name\': \'Nomadisierendes Großhorn\', \'text\': \'Mutation {2}{G} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\nImmer wenn diese Kreatur mutiert, durchsuche deine Bibliothek nach einer Standardland-Karte, bringe sie getappt ins Spiel und mische dann deine Bibliothek.\', \'type\': \'Kreatur — Bestie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479944&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'58da3993-2bb0-49b3-807a-6bc7ffb715d1\', \'multiverseId\': 479944}, \'multiverseid\': 479944}, {\'name\': \'Grancuerno migratorio\', \'text\': \'Mutación {2}{G}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\nSiempre que esta criatura mute, busca en tu biblioteca una carta de tierra básica, ponla en el campo de batalla girada y luego baraja tu biblioteca.\', \'type\': \'Criatura — Bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480203&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d93d9123-2d67-4b62-b9d0-57231fa7f254\', \'multiverseId\': 480203}, \'multiverseid\': 480203}, {\'name\': \'Grandcorne migrateur\', \'text\': "Mutation {2}{G} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\nÀ chaque fois que cette créature subit une mutation, cherchez dans votre bibliothèque une carte de terrain de base, mettez-la sur le champ de bataille engagée et mélangez ensuite votre bibliothèque.", \'type\': \'Créature : bête\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480462&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'96ba494f-2f9e-4b82-a7c9-72ba4addcd85\', \'multiverseId\': 480462}, \'multiverseid\': 480462}, {\'name\': \'Corno Possente Migratorio\', \'text\': \'Mutazione {2}{G} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\nOgniqualvolta questa creatura muta, passa in rassegna il tuo grimorio per una carta terra base, mettila sul campo di battaglia TAPpata, poi rimescola il tuo grimorio.\', \'type\': \'Creatura — Bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480721&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c00bb982-bbcc-4292-a226-0678cdbe0b81\', \'multiverseId\': 480721}, \'multiverseid\': 480721}, {\'name\': \'渡る大角\', \'text\': \'変容{2}{G}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\nこのクリーチャーが変容するたび、あなたのライブラリーから基本土地・カード１枚を探し、タップ状態で戦場に出し、その後あなたのライブラリーを切り直す。\', \'type\': \'クリーチャー — ビースト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480980&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7590535e-cceb-43b2-bcb8-a20f0dc00dc9\', \'multiverseId\': 480980}, \'multiverseid\': 480980}, {\'name\': \'이주하는 거대뿔\', \'text\': \'돌연변이화 {2}{G} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n이 생물이 돌연변이화할 때마다, 당신의 서고에서 기본 대지 카드 한 장을 찾아, 탭된 채로 전장에 놓은 후, 당신의 서고를 섞는다.\', \'type\': \'생물 — 야수\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481239&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'24a89448-f52b-4929-b358-53fbced5393e\', \'multiverseId\': 481239}, \'multiverseid\': 481239}, {\'name\': \'Megacórneo Migratório\', \'text\': \'Mutação {2}{G} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\nToda vez que esta criatura sofrer mutação, procure um card de terreno básico em seu grimório, coloque-o no campo de batalha virado e depois embaralhe seu grimório.\', \'type\': \'Criatura — Besta\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481498&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'aa90662b-c88b-4084-ba59-fedf2814e47e\', \'multiverseId\': 481498}, \'multiverseid\': 481498}, {\'name\': \'Кочующий Большерог\', \'text\': \'Мутация {2}{G} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\nКаждый раз, когда это существо мутирует, найдите в вашей библиотеке карту базовой земли, положите ее на поле битвы повернутой, затем перетасуйте вашу библиотеку.\', \'type\': \'Существо — Зверь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481757&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6bf81a31-6f87-40bf-9049-40cd318b33b4\', \'multiverseId\': 481757}, \'multiverseid\': 481757}, {\'name\': \'迁徙巨角兽\', \'text\': \'合变{2}{G}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n每当此生物合变时，从你的牌库中搜寻一张基本地牌，将之横置放进战场，然后将你的牌库洗牌。\', \'type\': \'生物 ～野兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482016&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4baf74e7-2b73-4cee-88d1-7e1d1e81c799\', \'multiverseId\': 482016}, \'multiverseid\': 482016}, {\'name\': \'遷徙巨角獸\', \'text\': \'合變{2}{G}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n每當此生物合變時，從你的牌庫中搜尋一張基本地牌，將之橫置放進戰場，然後將你的牌庫洗牌。\', \'type\': \'生物 ～野獸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482275&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6331c349-f254-48c6-90de-31b219561db0\', \'multiverseId\': 482275}, \'multiverseid\': 482275}]', '[{\'name\': \'Oase des Todes\', \'text\': \'Immer wenn eine Nichtspielsteinkreatur, die du kontrollierst, stirbt, lege die obersten zwei Karten deiner Bibliothek auf deinen Friedhof. Bringe dann eine Kreaturenkarte mit niedrigeren umgewandelten Manakosten als die der Kreatur, die gestorben ist, aus deinem Friedhof auf deine Hand zurück.\\n{1}, opfere die Oase des Todes: Du erhältst Lebenspunkte in Höhe der höchsten umgewandelten Manakosten unter den Kreaturen, die du kontrollierst, dazu.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479961&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b0f791a2-7afd-4c35-9a18-4ed20200f42f\', \'multiverseId\': 479961}, \'multiverseid\': 479961}, {\'name\': \'Oasis de la muerte\', \'text\': \'Siempre que una criatura que no sea ficha que controlas muera, pon las dos primeras cartas de tu biblioteca en tu cementerio. Luego regresa una carta de criatura con coste de maná convertido menor que el de la criatura que murió de tu cementerio a tu mano.\\n{1}, sacrificar el Oasis de la muerte: Ganas una cantidad de vidas igual al mayor coste de maná convertido de entre las criaturas que controlas.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480220&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ff5f285d-30ad-41ad-8f6e-efc23ecdd103\', \'multiverseId\': 480220}, \'multiverseid\': 480220}, {\'name\': \'Oasis de la mort\', \'text\': "À chaque fois qu\'une créature non-jeton que vous contrôlez meurt, mettez les deux cartes du dessus de votre bibliothèque dans votre cimetière. Puis renvoyez dans votre main, depuis votre cimetière, une carte de créature avec un coût converti de mana inférieur à celui de la créature qui est morte.\\n{1}, sacrifiez l\'Oasis de la mort : Vous gagnez un nombre de points de vie égal au coût converti de mana le plus élevé parmi les créatures que vous contrôlez.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480479&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e5bd2e51-0bf2-47bf-b164-92500934c69d\', \'multiverseId\': 480479}, \'multiverseid\': 480479}, {\'name\': \'Oasi della Morte\', \'text\': "Ogniqualvolta una creatura non pedina che controlli muore, metti nel tuo cimitero le prime due carte del tuo grimorio. Poi riprendi in mano dal tuo cimitero una carta creatura con costo di mana convertito inferiore a quello della creatura che è morta.\\n{1}, Sacrifica l\'Oasi della Morte: Guadagni punti vita pari al costo di mana convertito maggiore tra le creature che controlli.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480738&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'75e99971-75a2-400d-98c4-3e83462f031a\', \'multiverseId\': 480738}, \'multiverseid\': 480738}, {\'name\': \'死のオアシス\', \'text\': \'あなたがコントロールしていてトークンでないクリーチャーが１体死亡するたび、あなたのライブラリーの一番上からカードを２枚あなたの墓地に置く。その後、あなたの墓地から点数で見たマナ・コストがその死亡したクリーチャーよりも小さいクリーチャー・カード１枚をあなたの手札に戻す。\\n{1}, 死のオアシスを生け贄に捧げる：あなたは、あなたがコントロールしているクリーチャーの中の点数で見たマナ・コストの最大値に等しい点数のライフを得る。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480997&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'db0349da-8f0c-4bee-80ab-7daa72039950\', \'multiverseId\': 480997}, \'multiverseid\': 480997}, {\'name\': \'죽음의 오아시스\', \'text\': \'당신이 조종하는 토큰이 아닌 생물이 죽을 때마다, 당신의 서고 맨 위 카드 두 장을 당신의 무덤에 넣는다. 그 후 죽은 생물보다 낮은 전환마나비용을 가진 생물 카드 한 장을 당신의 무덤에서 당신의 손으로 되돌린다.\\n{1}, 죽음의 오아시스를 희생한다: 당신은 당신이 조종하는 생물들 중에서 가장 큰 전환마나비용만큼 생명점을 얻는다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481256&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6b6e9076-031d-4a07-9052-096dae2fc546\', \'multiverseId\': 481256}, \'multiverseid\': 481256}, {\'name\': \'Oásis da Morte\', \'text\': \'Toda vez que uma criatura que você controla que não seja uma ficha morrer, coloque os dois cards do topo de seu grimório em seu cemitério. Em seguida, devolva de seu cemitério para sua mão um card de criatura com custo de mana convertido inferior ao da criatura que morreu.\\n{1}, sacrifique Oásis da Morte: Você ganha uma quantidade de pontos de vida igual ao maior custo de mana convertido entre os das criaturas que você controla.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481515&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5851958a-5304-4333-a7b1-70732e597cac\', \'multiverseId\': 481515}, \'multiverseid\': 481515}, {\'name\': \'Оазис Смерти\', \'text\': \'Каждый раз, когда не являющееся фишкой существо под вашим контролем умирает, положите две верхние карты вашей библиотеки на ваше кладбище. Затем верните карту существа с конвертированной мана-стоимостью меньше, чем у умершего существа, из вашего кладбища в вашу руку.\\n{1}, пожертвуйте Оазис Смерти: вы получаете количество жизней, равное наибольшему значению конвертированной мана-стоимости среди существ под вашим контролем.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481774&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dc686e9f-894d-44eb-800a-e0095b5312d4\', \'multiverseId\': 481774}, \'multiverseid\': 481774}, {\'name\': \'死亡绿洲\', \'text\': \'每当一个由你操控且非衍生物的生物死去时，将你牌库顶的两张牌置入你的坟墓场。然后将一张总法术力费用小于死去者的生物牌从你的坟墓场移回你手上。\\n{1}，牺牲死亡绿洲：你获得若干生命，其数量等同于由你操控之生物中总法术力费用最大者的数值。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482033&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c5f31d64-0af5-4f95-ad10-dba59388d662\', \'multiverseId\': 482033}, \'multiverseid\': 482033}, {\'name\': \'死亡綠洲\', \'text\': \'每當一個由你操控且非衍生物的生物死去時，將你牌庫頂的兩張牌置入你的墳墓場。然後將一張總魔法力費用小於死去者的生物牌從你的墳墓場移回你手上。\\n{1}，犧牲死亡綠洲：你獲得若干生命，其數量等同於由你操控之生物中總魔法力費用最大者的數值。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482292&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d1f1f84f-da68-4baf-8241-0e9dcf2dbdcd\', \'multiverseId\': 482292}, \'multiverseid\': 482292}]', '[{\'name\': \'Obosh der Beutestecher\', \'text\': \'Gefährte — Dein Startdeck enthält nur Länderkarten und Karten mit ungeraden umgewandelten Manakosten. (Falls du diese Karte als deinen Gefährten erwählt hast, kannst du sie einmal von außerhalb der Partie wirken.)\\nFalls eine Quelle mit ungeraden umgewandelten Manakosten, die du kontrollierst, einer bleibenden Karte oder einem Spieler Schaden zufügen würde, fügt sie der bleibenden Karte oder dem Spieler stattdessen doppelt so viele Schadenspunkte zu.\', \'type\': \'Legendäre Kreatur — Teufelsbraten, Schrecken\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480007&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'76695294-86cc-4fcb-9718-97b454667976\', \'multiverseId\': 480007}, \'multiverseid\': 480007}, {\'name\': \'Obosh, Perforapresas\', \'text\': \'Compañero — Tu mazo inicial contiene solo cartas con costes de maná convertido impares y cartas de tierra. (Si esta carta es el compañero que eliges, puedes lanzarla una vez desde fuera del juego.)\\nSi una fuente que controlas con coste de maná convertido impar fuera a hacer daño a un permanente o jugador, en vez de eso, hace el doble de ese daño a ese permanente o jugador.\', \'type\': \'Criatura legendaria — Horror infernal\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480266&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0f0e2f9c-bb67-4a68-8e77-0b4af2ec819b\', \'multiverseId\': 480266}, \'multiverseid\': 480266}, {\'name\': \'Obosh, le Perce-proie\', \'text\': "Compagnon — Votre deck de départ ne contient que des cartes avec un coût converti de mana impair et des cartes de terrain. (Si cette carte est le compagnon de votre choix, vous pouvez la lancer une fois depuis l\'extérieur de la partie.)\\nSi une source avec un coût converti de mana impair que vous contrôlez devait infliger des blessures à un permanent ou à un joueur, elle inflige le double de ces blessures à ce permanent ou ce joueur à la place.", \'type\': \'Créature légendaire : monstruosité et horreur\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480525&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ec8ce71e-8012-4374-84d0-70ee25a09f99\', \'multiverseId\': 480525}, \'multiverseid\': 480525}, {\'name\': \'Obosh, il Trafiggiprede\', \'text\': \'Compagno — Il tuo mazzo iniziale contiene solo carte con costi di mana convertiti dispari e carte terra. (Se questa carta è il compagno che hai scelto, puoi lanciarla una volta dal di fuori della partita.)\\nSe una fonte che controlli con costo di mana convertito dispari sta per infliggere danno a un permanente o a un giocatore, infligge invece il doppio di quel danno a quel permanente o a quel giocatore.\', \'type\': \'Creatura Leggendaria — Orrore Infernale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480784&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4a84b358-164c-461d-8660-62b657c7c61f\', \'multiverseId\': 480784}, \'multiverseid\': 480784}, {\'name\': \'獲物貫き、オボシュ\', \'text\': \'相棒 ― あなたの開始時のデッキに、点数で見たマナ・コストが奇数のカードと土地・カードのみが入っていること。（このカードがあなたの選んだ相棒であるなら、あなたは１回のみゲームの外部からこれを唱えてもよい。）\\nあなたがコントロールしていて点数で見たマナ・コストが奇数である発生源がパーマネントやプレイヤーにダメージを与えるなら、代わりに、それはそのパーマネントかプレイヤーにその点数の２倍のダメージを与える。\', \'type\': \'伝説のクリーチャー — ヘリオン・ホラー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481043&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7b3ea035-11a5-449f-9cde-0255eb285ccb\', \'multiverseId\': 481043}, \'multiverseid\': 481043}, {\'name\': \'먹이관통자, 오보쉬\', \'text\': \'단짝 — 당신의 시작 덱에는 전환마나비용이 홀수인 카드 및 대지 카드들만 들어 있다. (이 카드가 당신이 선택한 단짝이라면, 당신은 이 카드를 게임 밖에서 한 번 발동할 수 있다.)\\n당신이 조종하는 전환마나비용이 홀수인 원천이 지속물 또는 플레이어에게 피해를 입히려 한다면, 대신에 그 원천은 그 피해를 두 배로 입힌다.\', \'type\': \'전설적 생물 — 헬리온 괴수\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481302&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ee336a1a-8fd3-4a6f-a5bc-2296395a3f60\', \'multiverseId\': 481302}, \'multiverseid\': 481302}, {\'name\': \'Obosh, o Furapresa\', \'text\': \'Companheiro — Seu deck inicial contém apenas cards com custos de mana convertido ímpares e cards de terreno. (Se este card for o companheiro que escolheu, você poderá conjurá-lo uma vez de fora do jogo.)\\nSe uma fonte que você controla com custo de mana convertido ímpar for causar dano a uma permanente ou a um jogador, em vez disso, ela causará o dobro daquele dano àquela permanente ou àquele jogador.\', \'type\': \'Criatura Lendária — Avernal Horror\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481561&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'974cd103-7806-4b0e-b638-eff5181374cf\', \'multiverseId\': 481561}, \'multiverseid\': 481561}, {\'name\': \'Обош, Пронзатель Дичи\', \'text\': \'Компаньон — Ваша начальная колода содержит только карты с нечетной конвертированной мана-стоимостью и карты земель. (Если эта карта является вашим избранным Компаньоном, то вы можете один раз разыграть ее из-за пределов игры.)\\nЕсли источник под вашим контролем с нечетной конвертированной мана-стоимостью должен нанести повреждения перманенту или игроку, вместо этого он наносит те повреждения тому перманенту или игроку в двойном размере.\', \'type\': \'Легендарное Существо — Геллион Ужас\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481820&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'65ce3a7a-18f7-44c4-97c3-9415c205aadc\', \'multiverseId\': 481820}, \'multiverseid\': 481820}, {\'name\': \'戕害狱兽奥巴什\', \'text\': \'行侣～你起始套牌中仅包含地牌和总法术力费用为奇数的牌。（如果你选择这张牌作为你的行侣，则你可以从游戏外施放它，但仅限一次。）\\n如果某个由你操控且总法术力费用为奇数的来源将对任一永久物或牌手造成伤害，则改为它对该永久物或牌手造成两倍的伤害。\', \'type\': \'传奇生物 ～地狱兽／惊惧兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482079&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'402e0896-b2cb-4a7a-b96d-8e4f860fd653\', \'multiverseId\': 482079}, \'multiverseid\': 482079}, {\'name\': \'戕害獄獸奧巴什\', \'text\': \'行侶～你起始套牌中僅包含地牌和總魔法力費用為奇數的牌。（如果你選擇這張牌作為你的行侶，則你可以從遊戲外施放它，但僅限一次。）\\n如果某個由你操控且總魔法力費用為奇數的來源將對任一永久物或玩家造成傷害，則改為它對該永久物或玩家造成兩倍的傷害。\', \'type\': \'傳奇生物 ～地獄獸／驚懼獸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482338&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3afe4eb1-7ddf-4601-9765-4f09d7a948cc\', \'multiverseId\': 482338}, \'multiverseid\': 482338}]', '[{\'name\': \'Offizier des Kontrollpunkts\', \'text\': \'{1}{W}, {T}: Tappe eine Kreatur deiner Wahl.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'Nach Lukkas schockierendem Verrat erließ General Kudro strenge Sicherheitsmaßnahmen an jedem Eingang nach Drannith.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479784&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7dd69534-ee46-4d42-8769-1e12d6b66043\', \'multiverseId\': 479784}, \'multiverseid\': 479784}, {\'name\': \'Oficial del puesto de control\', \'text\': \'{1}{W}, {T}: Gira la criatura objetivo.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'Tras lo que él consideró una espantosa traición por parte de Lukka, el general Kudro impuso estrictas medidas de seguridad en todas las entradas a Drannith.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480043&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8e27d84c-020f-4eea-b0dc-9fb36ff6b2c9\', \'multiverseId\': 480043}, \'multiverseid\': 480043}, {\'name\': \'Officier du poste de contrôle\', \'text\': \'{1}{W}, {T} : Engagez la créature ciblée.\', \'type\': \'Créature : humain et soldat\', \'flavor\': "Le Général Koudro mit en place des mesures de sécurité strictes à chaque entrée de Drannith après ce qu\'il considérait comme une trahison choquante de la part de Lukka.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480302&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7c70fc6a-eda2-4bbd-8064-5ea2c5c87f26\', \'multiverseId\': 480302}, \'multiverseid\': 480302}, {\'name\': \'Ufficiale del Posto di Controllo\', \'text\': \'{1}{W}, {T}: TAPpa una creatura bersaglio.\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'Dopo quello che considerò uno sconcertante tradimento da parte di Lukka, il Generale Kudro stabilì rigide misure di sicurezza per tutti i punti di accesso a Drannith.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480561&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'149f5451-10a8-4b43-9c4a-ced41fd32703\', \'multiverseId\': 480561}, \'multiverseid\': 480561}, {\'name\': \'検問官\', \'text\': \'{1}{W}, {T}：クリーチャー１体を対象とし、それをタップする。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'クードロ将軍は、ルーカが突然裏切ったと見たあの日以来、ドラニスの入り口すべてに厳戒体制を敷くようになった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480820&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f61e76ce-cd3e-4662-94c3-dfe144e77edf\', \'multiverseId\': 480820}, \'multiverseid\': 480820}, {\'name\': \'검문소 장교\', \'text\': \'{1}{W}, {T}: 생물을 목표로 정한다. 그 생물을 탭한다.\', \'type\': \'생물 — 인간 병사\', \'flavor\': \'루카의 충격적인 배신을 목격하고 난 뒤, 쿠드로 장군은 드라니스로 진입하는 모든 지점에 엄격한 보안 조치를 시행했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481079&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9ff12c1d-0788-4b4d-bee3-54dbc93f7c7f\', \'multiverseId\': 481079}, \'multiverseid\': 481079}, {\'name\': \'Oficial do Posto de Controle\', \'text\': \'{1}{W}, {T}: Vire a criatura alvo.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': \'Depois do que viu como uma traição absurda de Lukka, o General Kudro instituiu medidas de segurança rigorosas em todas as entradas de Drannith.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481338&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ffcb14fb-665f-4258-902b-0f635468b98c\', \'multiverseId\': 481338}, \'multiverseid\': 481338}, {\'name\': \'Офицер Заставы\', \'text\': \'{1}{W}, {T}: поверните целевое существо.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'Став свидетелем тому, что он воспринял как предательство Лукки, потрясенный до глубины души генерал Кудро велел поставить бдительных стражников у каждого прохода в Драннит.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481597&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f82e5ddb-2893-4e68-a350-309eeaff1dc7\', \'multiverseId\': 481597}, \'multiverseid\': 481597}, {\'name\': \'关卡长官\', \'text\': \'{1}{W}，{T}：横置目标生物。\', \'type\': \'生物 ～人类／士兵\', \'flavor\': \'寇卓将军把卢卡所为视作可憎叛行，于是他下令在通往卓尼斯的各处入口严加防范。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481856&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2e4dfa23-1f87-40da-b569-ab0c0a695b79\', \'multiverseId\': 481856}, \'multiverseid\': 481856}, {\'name\': \'關卡長官\', \'text\': \'{1}{W}，{T}：橫置目標生物。\', \'type\': \'生物 ～人類／士兵\', \'flavor\': \'寇卓將軍把盧卡所為視作可憎叛行，於是他下令在通往卓尼斯的各處入口嚴加防範。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482115&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'06463b46-2f33-4e8b-be8a-1c59097150c5\', \'multiverseId\': 482115}, \'multiverseid\': 482115}]', '[{\'name\': \'Parzellenbestie\', \'text\': \'Mutation {G}{U} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\n{1}, {T}: Schaue dir die oberste Karte deiner Bibliothek an. Falls es eine Länderkarte ist, kannst du sie ins Spiel bringen. Falls du die Karte nicht ins Spiel bringst, nimm sie auf deine Hand.\', \'type\': \'Kreatur — Elementarwesen, Bestie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479978&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a33d0270-b20c-4a4e-a8ba-cf467e983df2\', \'multiverseId\': 479978}, \'multiverseid\': 479978}, {\'name\': \'Ñurcela\', \'text\': \'Mutación {G}{U}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\n{1}, {T}: Mira la primera carta de tu biblioteca. Si es una carta de tierra, puedes ponerla en el campo de batalla. Si no pones la carta en el campo de batalla, ponla en tu mano.\', \'type\': \'Criatura — Bestia elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480237&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f4271cbb-dba7-412c-9c1c-b0e772ff4161\', \'multiverseId\': 480237}, \'multiverseid\': 480237}, {\'name\': \'Bubale de parcelle\', \'text\': "Mutation {G}{U} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\n{1}, {T} : Regardez la carte du dessus de votre bibliothèque. Si c\'est une carte de terrain, vous pouvez la mettre sur le champ de bataille. Si vous ne mettez pas la carte sur le champ de bataille, mettez-la dans votre main.", \'type\': \'Créature : élémental et bête\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480496&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ba92e206-22f2-4084-a61a-5c1339a0a60e\', \'multiverseId\': 480496}, \'multiverseid\': 480496}, {\'name\': \'Bestia Procacciaterre\', \'text\': \'Mutazione {G}{U} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\n{1}, {T}: Guarda la prima carta del tuo grimorio. Se è una carta terra, puoi metterla sul campo di battaglia. Se non la metti, aggiungila alla tua mano.\', \'type\': \'Creatura — Bestia Elementale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480755&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1d37c869-433e-4657-923d-f530b16fb41b\', \'multiverseId\': 480755}, \'multiverseid\': 480755}, {\'name\': \'領獣\', \'text\': \'変容{G}{U}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\n{1}, {T}：あなたのライブラリーの一番上のカードを見る。それが土地・カードであるなら、あなたはそれを戦場に出してもよい。そのカードを戦場に出さないなら、それをあなたの手札に加える。\', \'type\': \'クリーチャー — エレメンタル・ビースト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481014&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bca6df42-3a8c-4cc3-8e9b-9e09bc668379\', \'multiverseId\': 481014}, \'multiverseid\': 481014}, {\'name\': \'구획야수\', \'text\': \'돌연변이화 {G}{U} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n{1}, {T}: 당신의 서고 맨 위 카드를 본다. 그 카드가 대지 카드라면, 당신은 그 카드를 전장에 놓을 수 있다. 당신이 그 카드를 전장에 놓지 않으면, 당신의 손에 넣는다.\', \'type\': \'생물 — 정령 야수\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481273&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e822a125-a9a4-4d01-aa3e-c682b8c76a77\', \'multiverseId\': 481273}, \'multiverseid\': 481273}, {\'name\': \'Gnu Caça-terra\', \'text\': \'Mutação {G}{U} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\n{1}, {T}: Olhe o card do topo de seu grimório. Se for um card de terreno, você poderá colocá-lo no campo de batalha. Se não colocar o card no campo de batalha, coloque-o em sua mão.\', \'type\': \'Criatura — Elemental Besta\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481532&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e89cbeb7-a1b6-49ea-a49c-0726eb6f6cfa\', \'multiverseId\': 481532}, \'multiverseid\': 481532}, {\'name\': \'Антилопа Наделов\', \'text\': \'Мутация {G}{U} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\n{1}, {T}: посмотрите верхнюю карту вашей библиотеки. Если это карта земли, вы можете положить ее на поле битвы. Если вы не кладете ту карту на поле битвы, положите ее в вашу руку.\', \'type\': \'Существо — Элементаль Зверь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481791&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'095197a7-fda9-4b41-95f8-a0abb3769d2c\', \'multiverseId\': 481791}, \'multiverseid\': 481791}, {\'name\': \'开路牛羚\', \'text\': \'合变{G}{U}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n{1}，{T}：检视你的牌库顶牌。如果它是地牌，则你可以将之放进战场。如果你未将该牌放进战场，则将它置于你手上。\', \'type\': \'生物 ～元素／野兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482050&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'74864086-b38b-4818-8504-f8d351b5556c\', \'multiverseId\': 482050}, \'multiverseid\': 482050}, {\'name\': \'開路牛羚\', \'text\': \'合變{G}{U}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n{1}，{T}：檢視你的牌庫頂牌。如果它是地牌，則你可以將之放進戰場。如果你未將該牌放進戰場，則將它置於你手上。\', \'type\': \'生物 ～元素／野獸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482309&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c20568df-3c4f-41e8-82fa-5d1f45719801\', \'multiverseId\': 482309}, \'multiverseid\': 482309}]', '[{\'name\': \'Patagiatiger\', \'text\': \'Fliegend\\nWenn der Patagiatiger ins Spiel kommt, erhält ein Mensch deiner Wahl, den du kontrollierst, +2/+2 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Katze\', \'flavor\': \'Lukka blickte von der Brüstung und sah nicht ein Monster zum Jagen, sondern eine wilde Schönheit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479805&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ff530f80-135e-410a-8835-ce99ed6c89dc\', \'multiverseId\': 479805}, \'multiverseid\': 479805}, {\'name\': \'Tigre membranoso\', \'text\': \'Vuela.\\nCuando el Tigre membranoso entre al campo de batalla, el Humano objetivo que controlas obtiene +2/+2 hasta el final del turno.\', \'type\': \'Criatura — Felino\', \'flavor\': \'Lukka miró desde el parapeto y no vio un monstruo con el que acabar, sino algo bello y fiero a la vez.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480064&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'528f902b-a5de-4128-8b5f-89bb2922ce7f\', \'multiverseId\': 480064}, \'multiverseid\': 480064}, {\'name\': \'Tigre à patagia\', \'text\': "Vol\\nQuand le Tigre à patagia arrive sur le champ de bataille, un humain ciblé que vous contrôlez gagne +2/+2 jusqu\'à la fin du tour.", \'type\': \'Créature : chat\', \'flavor\': \'Quand Lukka regarda depuis la muraille, il vit non pas un monstre à éliminer, mais une beauté féroce.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480323&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b1a4577c-6ef3-406f-b926-070cd9288bc4\', \'multiverseId\': 480323}, \'multiverseid\': 480323}, {\'name\': \'Tigre dei Patagi\', \'text\': \'Volare\\nQuando la Tigre dei Patagi entra nel campo di battaglia, un Umano bersaglio che controlli prende +2/+2 fino alla fine del turno.\', \'type\': \'Creatura — Felino\', \'flavor\': \'Lukka guardò oltre il parapetto e ciò che vide non fu un mostro da abbattere, ma una bellezza selvaggia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480582&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8f979693-0bfa-419f-bebd-47444661a0fa\', \'multiverseId\': 480582}, \'multiverseid\': 480582}, {\'name\': \'翼膜の虎\', \'text\': \'飛行\\n翼膜の虎が戦場に出たとき、あなたがコントロールしている人間１体を対象とする。ターン終了時まで、それは＋２/＋２の修整を受ける。\', \'type\': \'クリーチャー — 猫\', \'flavor\': \'ルーカは胸壁で見張りについていた。その目に映ったのは、退治するべき怪物ではなく、獰猛な美だった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480841&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7f99694b-9bf8-40e0-8ca4-eacb5dce6de4\', \'multiverseId\': 480841}, \'multiverseid\': 480841}, {\'name\': \'비막 호랑이\', \'text\': \'비행\\n비막 호랑이가 전장에 들어올 때, 당신이 조종하는 인간을 목표로 정한다. 그 인간은 턴종료까지 +2/+2를 받는다.\', \'type\': \'생물 — 고양이\', \'flavor\': \'난간 바깥을 바라본 루카는 쓰러뜨려야 할 괴수가 아니라 흉포한 아름다움을 목격했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481100&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e31aa7da-b2b6-48ec-8e1b-8d5b1f0cc29e\', \'multiverseId\': 481100}, \'multiverseid\': 481100}, {\'name\': \'Tigre-de-patágio\', \'text\': \'Voar\\nQuando Tigre-de-patágio entra no campo de batalha, o Humano alvo que você controla recebe +2/+2 até o final do turno.\', \'type\': \'Criatura — Felino\', \'flavor\': \'Lukka olhou do parapeito e viu não um monstro a abater, mas um tipo feroz de beleza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481359&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b54a6356-c1d6-4f37-9fd3-e7c6268b0e61\', \'multiverseId\': 481359}, \'multiverseid\': 481359}, {\'name\': \'Тигр-Крылан\', \'text\': \'Полет\\nКогда Тигр-Крылан выходит на поле битвы, целевой Человек под вашим контролем получает +2/+2 до конца хода.\', \'type\': \'Существо — Кошка\', \'flavor\': \'Лукка выглянул за парапет и увидел не чудовище, которое нужно уничтожить, а свирепую красоту.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481618&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d982176b-0d02-463a-9aec-0e9918fe3da0\', \'multiverseId\': 481618}, \'multiverseid\': 481618}, {\'name\': \'翼翅飞虎\', \'text\': \'飞行\\n当翼翅飞虎进战场时，目标由你操控的人类得+2/+2直到回合结束。\', \'type\': \'生物 ～猫\', \'flavor\': \'卢卡望向护墙之外，所见者并非要制服的怪兽，而是迷人的野性之美。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481877&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9f5d211c-7f22-412c-929d-0b41bae0f76e\', \'multiverseId\': 481877}, \'multiverseid\': 481877}, {\'name\': \'翼翅飛虎\', \'text\': \'飛行\\n當翼翅飛虎進戰場時，目標由你操控的人類得+2/+2直到回合結束。\', \'type\': \'生物 ～貓\', \'flavor\': \'盧卡望向護牆之外，所見者並非要制服的怪獸，而是迷人的野性之美。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482136&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c3deeac3-4f11-4287-a194-abc7ad5d2a76\', \'multiverseId\': 482136}, \'multiverseid\': 482136}]', '[{\'name\': \'Pazifismus\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur kann nicht angreifen oder blocken.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Wenn doch nur alle so fügsam wären. Dann könnte ich mich entspannt zurücklehnen. Ich wollte schon immer einmal Plätzchen backen."\\n—Ethuk, Magier der Kupferjacken\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479804&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f946ad00-a975-46db-b3a0-b3020b30d2bd\', \'multiverseId\': 479804}, \'multiverseid\': 479804}, {\'name\': \'Pacifismo\', \'text\': \'Encantar criatura.\\nLa criatura encantada no puede atacar ni bloquear.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"Si todos fueran tan dóciles... Podría ganarme la vida con algo tranquilo. Siempre he querido preparar galletas".\\n—Ethuk, mago de las Capas de Cobre\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480063&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'55d753da-4963-424e-a0e2-17571d987fb5\', \'multiverseId\': 480063}, \'multiverseid\': 480063}, {\'name\': \'Pacifisme\', \'text\': \'Enchanter : créature\\nLa créature enchantée ne peut ni attaquer ni bloquer.\', \'type\': \'Enchantement : aura\', \'flavor\': "« J\'aimerais bien qu\'elles soient toutes aussi dociles. Je pourrais me reconvertir. En fait, j\'ai toujours voulu faire des biscuits. »\\n—Ethuk, mage des Capes de cuivre", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480322&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'62e12925-d89e-4523-a4ef-6b79b576afe4\', \'multiverseId\': 480322}, \'multiverseid\': 480322}, {\'name\': \'Pacifismo\', \'text\': \'Incanta creatura\\nLa creatura incantata non può attaccare o bloccare.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Se solo fossero tutti così docili... potrei dedicarmi a un\\\'attività rilassante per vivere. Ho sempre voluto sfornare biscotti."\\n—Ethuk, mago delle Giubbe Ramate\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480581&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b9fa24f2-5442-477c-be3e-366fa7f706d8\', \'multiverseId\': 480581}, \'multiverseid\': 480581}, {\'name\': \'平和な心\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントしているクリーチャーでは攻撃もブロックもできない。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「皆がこれほど従順であってくれれば、のんびりと暮らせるのに。ずっとスコーンを焼いてみたいと思ってたんだ。」\\n――銅纏いの魔道士、エスク\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480840&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c79d8511-20d1-49ef-9c89-d6ceeaf86cd2\', \'multiverseId\': 480840}, \'multiverseid\': 480840}, {\'name\': \'평화주의\', \'text\': \'생물에게 부여\\n부여된 생물은 공격하거나 방어할 수 없다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'"저것들이 다 이렇게 온순하게 행동하면 얼마나 좋겠어. 그럼 좀 더 마음이 놓이는 일로 생계를 꾸릴 수도 있겠지. 난 항상 과자를 굽고 싶었거든."\\n—구리 코트 마도사, 이투크\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481099&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'bbe8309e-6403-4728-922a-8316adc12b09\', \'multiverseId\': 481099}, \'multiverseid\': 481099}, {\'name\': \'Pacifismo\', \'text\': \'Encantar criatura\\nA criatura encantada não pode atacar nem bloquear.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Se todos eles fossem dóceis assim... Eu poderia fazer alguma coisa mais relaxante da vida. Eu sempre quis fazer biscoitos."\\n— Ethuk, mago Gibão de Cobre\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481358&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7ede32f0-9b03-4a0a-b3f8-56d68ae618fc\', \'multiverseId\': 481358}, \'multiverseid\': 481358}, {\'name\': \'Пацифизм\', \'text\': \'Зачаровать существо\\nЗачарованное существо не может атаковать или блокировать.\', \'type\': \'Чары — Аура\', \'flavor\': \'«Вот если бы они все были такими смирными! Я бы мог зарабатывать на жизнь чем-нибудь спокойным... Мне всегда хотелось печь булочки».\\n— Этук, маг Медных Кителей\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481617&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c97c6df1-d06c-466b-91a3-f6b5cb92499c\', \'multiverseId\': 481617}, \'multiverseid\': 481617}, {\'name\': \'和平主义\', \'text\': \'结附于生物\\n所结附的生物不能进行攻击或阻挡。\', \'type\': \'结界 ～灵气\', \'flavor\': \'「要是它们一直都这样温顺就好了。这样我就可以去做一些更轻松的工作。比如说烤烤饼干。」\\n～紫铜军法师埃撒克\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481876&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9009af8c-810b-4e65-8d42-454a6ac7c783\', \'multiverseId\': 481876}, \'multiverseid\': 481876}, {\'name\': \'和平主義\', \'text\': \'結附於生物\\n所結附的生物不能進行攻擊或阻擋。\', \'type\': \'結界 ～靈氣\', \'flavor\': \'「要是牠們一直都這樣溫順就好了。這樣我就可以去做一些更輕鬆的工作。比如說烤烤餅乾。」\\n～紫銅軍法師埃撒克\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482135&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'aa0cf0dc-8703-4c0e-abf9-d75bdfada8f1\', \'multiverseId\': 482135}, \'multiverseid\': 482135}]', '[{\'name\': \'Phasendelfin\', \'text\': \'Immer wenn der Phasendelfin angreift, kann eine andere angreifende Kreatur deiner Wahl in diesem Zug nicht geblockt werden.\', \'type\': \'Kreatur — Elementarwesen, Wal\', \'flavor\': \'„Du musstest noch nie einer Kreatur, die dich nach Lust und Laune zerquetschen könnte, mit deinem Leben vertrauen — du weißt nicht, was du vermisst."\\n—Eagan, Seebynder\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479841&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a4bccb87-677b-4b95-b0ee-b6a34b7d2249\', \'multiverseId\': 479841}, \'multiverseid\': 479841}, {\'name\': \'Delfín de fase\', \'text\': \'Siempre que el Delfín de fase ataque, otra criatura atacante objetivo no puede ser bloqueada este turno.\', \'type\': \'Criatura — Ballena elemental\', \'flavor\': \'"Nunca has tenido que confiar tu vida a una criatura inhumana que podría aplastarte a su antojo y, sinceramente, lo siento por ti".\\n—Eagan, vinculamares\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480100&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c4ac114a-d736-4f91-b5ee-e23f435bcf8c\', \'multiverseId\': 480100}, \'multiverseid\': 480100}, {\'name\': \'Dauphin en phase\', \'text\': \'À chaque fois que le Dauphin en phase attaque, une autre créature attaquante ciblée ne peut pas être bloquée ce tour-ci.\', \'type\': \'Créature : élémental et baleine\', \'flavor\': "« Vous n\'avez jamais eu à dépendre d\'une créature inhumaine capable de vous écraser à sa guise pour respirer, et cela me désole. »\\n—Éagane, bridemer", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480359&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7cd6f832-c20c-47bb-bfc2-416fbd802980\', \'multiverseId\': 480359}, \'multiverseid\': 480359}, {\'name\': \'Delfino della Fase\', \'text\': "Ogniqualvolta il Delfino della Fase attacca, un\'altra creatura attaccante bersaglio non può essere bloccata in questo turno.", \'type\': \'Creatura — Balena Elementale\', \'flavor\': \'"Non avete mai dovuto affidare il vostro respiro a una creatura non umana che potrebbe distruggervi in qualsiasi momento, e mi dispiace molto per voi."\\n—Eagan, vincolamari\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480618&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'237b6aad-3080-45a0-b305-c0dc04af3c27\', \'multiverseId\': 480618}, \'multiverseid\': 480618}, {\'name\': \'潜界イルカ\', \'text\': \'潜界イルカが攻撃するたび、他の攻撃クリーチャー１体を対象とする。このターン、それはブロックされない。\', \'type\': \'クリーチャー — エレメンタル・鯨\', \'flavor\': \'「気まぐれであなたを潰してしまうような心ない生き物に命を委ねるべきじゃなかったのよ。本当に残念だわ。」\\n――海眷者、イーガン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480877&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'09957d34-eb5a-48e0-bf5b-40f14f0c2c94\', \'multiverseId\': 480877}, \'multiverseid\': 480877}, {\'name\': \'위상 돌고래\', \'text\': \'위상 돌고래가 공격할 때마다, 공격 중인 다른 생물을 목표로 정한다. 그 생물은 이번 턴에 방어될 수 없다.\', \'type\': \'생물 — 정령 고래\', \'flavor\': \'"자네는 원하기만 하면 자넬 짓눌러버릴 수 있는 비인간적인 생물에게 호흡을 맡겨야 할 일이 없었지, 참 안됐군."\\n—바다유대자, 이간\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481136&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'82c5af9c-649c-4ec6-b4fb-a882ae9b9c0c\', \'multiverseId\': 481136}, \'multiverseid\': 481136}, {\'name\': \'Golfinho Defasador\', \'text\': \'Toda vez que Golfinho Defasador ataca, outra criatura atacante alvo não pode ser bloqueada neste turno.\', \'type\': \'Criatura — Elemental Baleia\', \'flavor\': \'"Você nunca precisou confiar o seu fôlego a uma criatura inumana capaz de esmagar você num instante, e eu realmente lamento por você."\\n— Eagan, vinculadora dos mares\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481395&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8052487f-9d30-479d-b674-0d91bdcf2496\', \'multiverseId\': 481395}, \'multiverseid\': 481395}, {\'name\': \'Мерцающий Дельфин\', \'text\': \'Каждый раз, когда Мерцающий Дельфин атакует, другое целевое атакующее существо не может быть заблокировано в этом ходу.\', \'type\': \'Существо — Элементаль Кит\', \'flavor\': \'«Не стоит доверять дыхание нечеловеческому существу, которое может сокрушить тебя, не моргнув глазом. Мне тебя жаль».\\n— Эган, узомантка моря\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481654&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4ed3c16c-e0af-4c71-b190-2ddf74f5420f\', \'multiverseId\': 481654}, \'multiverseid\': 481654}, {\'name\': \'腾跃海豚\', \'text\': \'每当腾跃海豚攻击时，另一个目标进行攻击的生物本回合不能被阻挡。\', \'type\': \'生物 ～元素／鲸鱼\', \'flavor\': \'「你从来没试过将自己的呼吸托付给能够轻易撞碎你的非人生物，我真为你感到惋惜。」\\n～海栖持绊人易晶\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481913&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0e5f3b17-156e-4aa7-9c10-31e3211cbc33\', \'multiverseId\': 481913}, \'multiverseid\': 481913}, {\'name\': \'騰躍海豚\', \'text\': \'每當騰躍海豚攻擊時，另一個目標進行攻擊的生物本回合不能被阻擋。\', \'type\': \'生物 ～元素／鯨魚\', \'flavor\': \'「你從來沒試過將自己的呼吸託付給能夠輕易撞碎你的非人生物，我真為你感到惋惜。」\\n～海棲持絆人易晶\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482172&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'10c58fcb-a21a-4377-9098-25d7c45caf65\', \'multiverseId\': 482172}, \'multiverseid\': 482172}]', '[{\'name\': \'Plötzliche Spinnendrüsen\', \'text\': \'Eine Kreatur deiner Wahl erhält +1/+3 bis zum Ende des Zuges. Lege eine Reichweite-Marke auf sie. Enttappe sie.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Mich erfreut immer wieder, was auf Ikoria als natürlich gilt."\\n—Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479950&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a2920203-2d6b-47f9-a736-72d72a66c365\', \'multiverseId\': 479950}, \'multiverseid\': 479950}, {\'name\': \'Hiladores súbitos\', \'text\': \'La criatura objetivo obtiene +1/+3 hasta el final del turno. Pon un contador de alcance sobre ella. Enderézala.\', \'type\': \'Instantáneo\', \'flavor\': \'"Sigue deleitándome lo que en Ikoria se considera natural".\\n—Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480209&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'29ec70d1-c0dc-4f14-872c-6a32cd3e1086\', \'multiverseId\': 480209}, \'multiverseid\': 480209}, {\'name\': \'Filières soudaines\', \'text\': "La créature ciblée gagne +1/+3 jusqu\'à la fin du tour. Mettez un marqueur « portée » sur elle. Dégagez-la.", \'type\': \'Éphémère\', \'flavor\': "« La vie sauvage d\'Ikoria ne cesse pas de me fasciner. »\\n—Vivien Reid", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480468&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'df39e013-ec8f-4224-a977-ee9c5a5b94d0\', \'multiverseId\': 480468}, \'multiverseid\': 480468}, {\'name\': \'Filiere Improvvise\', \'text\': \'Una creatura bersaglio prende +1/+3 fino alla fine del turno. Metti un segnalino raggiungere su di essa. STAPpala.\', \'type\': \'Istantaneo\', \'flavor\': \'"Tutto ciò che è naturale su Ikoria non smette di incantarmi."\\n—Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480727&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c208f4e8-02ac-4c82-bae4-f7207ce8e2d3\', \'multiverseId\': 480727}, \'multiverseid\': 480727}, {\'name\': \'突然の吐糸\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋１/＋３の修整を受ける。それの上に到達カウンターを１個置く。それをアンタップする。\', \'type\': \'インスタント\', \'flavor\': \'「イコリアの常識はまだまだ私を楽しませてくれるわ。」\\n――ビビアン・リード\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480986&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0ab9110e-1fb2-4990-9035-c0ab4a355940\', \'multiverseId\': 480986}, \'multiverseid\': 480986}, {\'name\': \'갑작스러운 방적돌기\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 +1/+3을 받는다. 그 생물에 대공 카운터를 올려놓는다. 그 생물을 언탭한다.\', \'type\': \'순간마법\', \'flavor\': \'"이코리아에서는 자연스럽게 받아들여지는 것들이 계속해서 나를 즐겁게 해 주는군."\\n—비비안 레이드\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481245&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'54171401-658d-4f79-bb22-46dc36213610\', \'multiverseId\': 481245}, \'multiverseid\': 481245}, {\'name\': \'Fieiras Repentinas\', \'text\': \'A criatura alvo recebe +1/+3 até o final do turno. Coloque um marcador de alcance nela. Desvire-a.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"As coisas que são naturais em Ikoria continuam a me encantar."\\n— Vivien Reid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481504&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b6952658-ebff-4769-92b9-f590dd80764c\', \'multiverseId\': 481504}, \'multiverseid\': 481504}, {\'name\': \'Внезапная Паутина\', \'text\': \'Целевое существо получает +1/+3 до конца хода. Положите на него один жетон Захвата. Разверните его.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«То, что на Икории считается естественным, не перестает меня удивлять».\\n— Вивьен Рейд\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481763&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4404874d-adc8-4de5-8c4b-79d2a67bf24b\', \'multiverseId\': 481763}, \'multiverseid\': 481763}, {\'name\': \'纺丝突袭\', \'text\': \'目标生物得+1/+3直到回合结束。在其上放置一个延势指示物。将之重置。\', \'type\': \'瞬间\', \'flavor\': \'「依克黎一切自然现象都不断令我欣喜。」\\n～薇薇安瑞德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482022&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'708f27c5-9aa0-425f-ab96-196755862572\', \'multiverseId\': 482022}, \'multiverseid\': 482022}, {\'name\': \'紡絲突襲\', \'text\': \'目標生物得+1/+3直到回合結束。在其上放置一個延勢指示物。將之重置。\', \'type\': \'瞬間\', \'flavor\': \'「依克黎一切自然現象都不斷令我欣喜。」\\n～薇薇安瑞德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482281&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'30d5baae-2b67-4e5d-8a9b-6be96948c826\', \'multiverseId\': 482281}, \'multiverseid\': 482281}]', '[{\'name\': \'Polternder Bergsturz\', \'text\': \'Der Polternde Bergsturz fügt einer Kreatur deiner Wahl so viele Schadenspunkte zu, wie du Länder kontrollierst.\', \'type\': \'Hexerei\', \'flavor\': \'„Wenn Monster laufen, weiß die Erde, wo sie hingehört, und macht Platz."\\n—Rielle die Allwissende\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479913&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'211d0ab2-4a93-4172-bb74-b6c913278389\', \'multiverseId\': 479913}, \'multiverseid\': 479913}, {\'name\': \'Desprendimiento estentóreo\', \'text\': \'El Desprendimiento estentóreo hace una cantidad de daño a la criatura objetivo igual a la cantidad de tierras que controlas.\', \'type\': \'Conjuro\', \'flavor\': \'"Cuando los monstruos caminan, la tierra sabe cuál es su sitio y cede".\\n—Rielle, la Versada\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480172&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3a8d72cc-67e6-45a5-9eab-03b53b953d0b\', \'multiverseId\': 480172}, \'multiverseid\': 480172}, {\'name\': \'Glissement de roches grondant\', \'text\': \'Le Glissement de roches grondant inflige à une créature ciblée un nombre de blessures égal au nombre de terrains que vous contrôlez.\', \'type\': \'Rituel\', \'flavor\': "« Quand les monstres marchent, la terre cède et se fait petite. »\\n—Rielle, l\'éternisciente", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480431&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7d1f2261-9fe8-48f0-9a7d-fe75e30e6426\', \'multiverseId\': 480431}, \'multiverseid\': 480431}, {\'name\': \'Frana Roboante\', \'text\': \'La Frana Roboante infligge a una creatura bersaglio danno pari al numero di terre che controlli.\', \'type\': \'Stregoneria\', \'flavor\': \'"Quando i mostri camminano, la terra riconosce il proprio posto e soccombe."\\n—Rielle, l\\\'Onnisapiente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480690&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dee5aad8-2638-4233-ab0a-08f1d211d5de\', \'multiverseId\': 480690}, \'multiverseid\': 480690}, {\'name\': \'轟く岩滑り\', \'text\': \'クリーチャー１体を対象とする。轟く岩滑りはそれに、あなたがコントロールしている土地の総数に等しい点数のダメージを与える。\', \'type\': \'ソーサリー\', \'flavor\': \'「怪物が歩くとき、大地はその場所を知りそれに従う。」\\n――常智のリエール\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480949&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4c686c44-6a01-4148-b444-0b676a174a88\', \'multiverseId\': 480949}, \'multiverseid\': 480949}, {\'name\': \'우르릉대는 산사태\', \'text\': \'생물을 목표로 정한다. 우르릉대는 산사태는 그 생물에게 당신이 조종하는 대지의 수만큼 피해를 입힌다.\', \'type\': \'집중마법\', \'flavor\': \'"괴수들이 걸음을 옮기면, 대지가 그 분수를 알고 길을 비킨다."\\n—지고의 현인, 리엘\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481208&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'bcb4024b-1802-4b29-8056-9c77f4d0a520\', \'multiverseId\': 481208}, \'multiverseid\': 481208}, {\'name\': \'Deslizamento Ribombante\', \'text\': \'Deslizamento Ribombante causa à criatura alvo uma quantidade de dano igual ao número de terrenos que você controla.\', \'type\': \'Feitiço\', \'flavor\': \'"Quando os monstros passam, a terra sabe o que é melhor para ela e cede."\\n— Rielle, a Onissapiente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481467&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4ba6b810-1015-406d-b1e0-27d66fc6ac7a\', \'multiverseId\': 481467}, \'multiverseid\': 481467}, {\'name\': \'Громыхающий Обвал\', \'text\': \'Громыхающий Обвал наносит целевому существу повреждения, равные количеству земель под вашим контролем.\', \'type\': \'Волшебство\', \'flavor\': \'«Когда чудовища идут вперед, земля знает свое место и уступает».\\n— Риэлль, Вечномудрая\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481726&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6ec3e28a-f5b9-483f-82f2-b45eadb782bf\', \'multiverseId\': 481726}, \'multiverseid\': 481726}, {\'name\': \'隆响石流\', \'text\': \'隆响石流对目标生物造成伤害，其数量等同于由你操控的地之数量。\', \'type\': \'法术\', \'flavor\': \'「怪兽迈步之时，大地应声崩裂。」\\n～全知利艾尔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481985&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'13f5c634-d4e6-4bea-9fe6-ce963b3a4355\', \'multiverseId\': 481985}, \'multiverseid\': 481985}, {\'name\': \'隆響石流\', \'text\': \'隆響石流對目標生物造成傷害，其數量等同於由你操控的地之數量。\', \'type\': \'巫術\', \'flavor\': \'「怪獸邁步之時，大地應聲崩裂。」\\n～全知利艾爾\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482244&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'606d2a06-d7d6-45e6-a681-2dd479ce78fd\', \'multiverseId\': 482244}, \'multiverseid\': 482244}]', "[{'name': 'Prächtige Hirschkuh', 'text': 'Lebensverknüpfung\\nUmwandlung {1}{W} ({1}{W}, wirf diese Karte ab: Ziehe eine Karte.)\\nWenn du die Prächtige Hirschkuh umwandelst, lege eine Lebensverknüpfung-Marke auf eine Kreatur deiner Wahl, die du kontrollierst.', 'type': 'Kreatur — Hirsch, Einhorn', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479811&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a2e0a410-b4a9-4ac9-bd33-5602344447c1', 'multiverseId': 479811}, 'multiverseid': 479811}, {'name': 'Corcel radiante', 'text': 'Vínculo vital.\\nCiclo {1}{W}. ({1}{W}, descartar esta carta: Roba una carta.)\\nCuando actives la habilidad de ciclo del Corcel radiante, pon un contador de vínculo vital sobre la criatura objetivo que controlas.', 'type': 'Criatura — Unicornio alce', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480070&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '15a47388-5b85-498e-83b5-6376cc9c1214', 'multiverseId': 480070}, 'multiverseid': 480070}, {'name': 'Jument de splendeur', 'text': 'Lien de vie\\nRecyclage {1}{W} ({1}{W}, défaussez-vous de cette carte : Piochez une carte.)\\nQuand vous recyclez la Jument de splendeur, mettez un marqueur « lien de vie » sur une créature ciblée que vous contrôlez.', 'type': 'Créature : élan et licorne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480329&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e113f8dd-964d-4e54-b1fd-98e86836933f', 'multiverseId': 480329}, 'multiverseid': 480329}, {'name': 'Destriero Splendente', 'text': 'Legame vitale\\nCiclo {1}{W} ({1}{W}, Scarta questa carta: Pesca una carta.)\\nQuando cicli il Destriero Splendente, metti un segnalino legame vitale su una creatura bersaglio che controlli.', 'type': 'Creatura — Unicorno Alce', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480588&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '272b1dab-3e48-4f43-ba87-59ac7f47733f', 'multiverseId': 480588}, 'multiverseid': 480588}, {'name': '壮麗牝馬', 'text': '絆魂\\nサイクリング{1}{W}（{1}{W}, このカードを捨てる：カードを１枚引く。）\\nあなたが壮麗牝馬をサイクリングしたとき、あなたがコントロールしているクリーチャー１体を対象とし、それの上に絆魂カウンターを１個置く。', 'type': 'クリーチャー — 大鹿・ユニコーン', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480847&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '86363db0-d119-4c1a-9c56-c6d7badb25f1', 'multiverseId': 480847}, 'multiverseid': 480847}, {'name': '화려한 말', 'text': '생명연결\\n순환 {1}{W} ({1}{W}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\\n당신이 화려한 말을 순환할 때, 당신이 조종하는 생물을 목표로 정한다. 그 생물에 생명연결 카운터를 올려놓는다.', 'type': '생물 — 엘크 유니콘', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481106&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'f22075be-2526-4047-b254-ee01db241aba', 'multiverseId': 481106}, 'multiverseid': 481106}, {'name': 'Cerva do Esplendor', 'text': 'Vínculo com a vida\\nReciclar {1}{W} ({1}{W}, descarte este card: Compre um card.)\\nQuando reciclar Cerva do Esplendor, coloque um marcador de vínculo com a vida na criatura alvo que você controla.', 'type': 'Criatura — Alce Unicórnio', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481365&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '33519236-3ddd-44fb-a5cf-7e183a1b9b54', 'multiverseId': 481365}, 'multiverseid': 481365}, {'name': 'Кобылица Величия', 'text': 'Цепь жизни\\nЦикл {1}{W} ({1}{W}, сбросьте эту карту: возьмите карту.)\\nКогда вы совершаете Цикл Кобылицы Величия, положите один жетон Цепи жизни на целевое существо под вашим контролем.', 'type': 'Существо — Вапити Единорог', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481624&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'ef9d14a7-128a-4b8c-b508-29f1b5ce3533', 'multiverseId': 481624}, 'multiverseid': 481624}, {'name': '光彩牝兽', 'text': '系命\\n循环{1}{W}（{1}{W}，弃掉此牌：抓一张牌。）\\n当你循环光彩牝兽时，在目标由你操控的生物上放置一个系命指示物。', 'type': '生物 ～麋鹿／独角兽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481883&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '97851314-6a6c-4982-9e3f-441ae4855ce3', 'multiverseId': 481883}, 'multiverseid': 481883}, {'name': '光彩牝獸', 'text': '繫命\\n循環{1}{W}（{1}{W}，棄掉此牌：抽一張牌。）\\n當你循環光彩牝獸時，在目標由你操控的生物上放置一個繫命指示物。', 'type': '生物 ～麋鹿／獨角獸', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482142&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '752e992e-b449-4f67-8ab8-a28b517cb05b', 'multiverseId': 482142}, 'multiverseid': 482142}]", '[{\'name\': \'Pyroceratops\', \'text\': \'Verursacht Trampelschaden\\nImmer wenn du einen Nichtkreatur-Zauberspruch wirkst, lege eine +1/+1-Marke auf den Pyroceratops.\', \'type\': \'Kreatur — Elementarwesen, Dinosaurier\', \'flavor\': \'„Ich dachte immer, Zauberer sollten Eulen oder einäugige Katzen als Vertraute haben, aber flammende Dinosaurier funktionieren ebenfalls."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479909&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c0fb1675-e5eb-47b8-b35e-fafce574bc2b\', \'multiverseId\': 479909}, \'multiverseid\': 479909}, {\'name\': \'Piroceratops\', \'text\': \'Arrolla.\\nSiempre que lances un hechizo que no sea de criatura, pon un contador +1/+1 sobre el Piroceratops.\', \'type\': \'Criatura — Dinosaurio elemental\', \'flavor\': \'"Siempre había creído que los hechiceros debían tener gatos o búhos de un solo ojo como familiares, pero los dinosaurios que echan fuego también valen".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480168&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c8db3009-0a6c-4284-a339-e6894bd99965\', \'multiverseId\': 480168}, \'multiverseid\': 480168}, {\'name\': \'Pyrocératops\', \'text\': \'Piétinement\\nÀ chaque fois que vous lancez un sort non-créature, mettez un marqueur +1/+1 sur le Pyrocératops.\', \'type\': \'Créature : élémental et dinosaure\', \'flavor\': "« J\'ai toujours cru qu\'un sorcier devait avoir des chats ou des hiboux borgnes comme familiers, mais les dinosaures enflammés font aussi l\'affaire. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480427&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'15569191-634d-4d62-91b1-6157be01669f\', \'multiverseId\': 480427}, \'multiverseid\': 480427}, {\'name\': \'Piroceratopo\', \'text\': \'Travolgere\\nOgniqualvolta lanci una magia non creatura, metti un segnalino +1/+1 sul Piroceratopo.\', \'type\': \'Creatura — Dinosauro Elementale\', \'flavor\': \'"Ho sempre pensato che i maghi dovessero avere gufi o gatti con un occhio solo come famigli, ma anche i dinosauri fiammeggianti possono andare."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480686&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'184b90f6-e421-488e-85ca-e86415bf3e19\', \'multiverseId\': 480686}, \'multiverseid\': 480686}, {\'name\': \'パイロケラトプス\', \'text\': \'トランプル\\nあなたがクリーチャーでない呪文を唱えるたび、パイロケラトプスの上に＋１/＋１カウンターを１個置く。\', \'type\': \'クリーチャー — エレメンタル・恐竜\', \'flavor\': \'「魔術師の使い魔はフクロウか一つ目の猫だとずっと思っていたが、燃える恐竜も悪くないな。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480945&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a1b7227f-44bd-47a5-b372-b3feb49cf385\', \'multiverseId\': 480945}, \'multiverseid\': 480945}, {\'name\': \'화염케라톱스\', \'text\': \'돌진\\n당신이 생물이 아닌 주문을 발동할 때마다, 화염케라톱스에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 정령 공룡\', \'flavor\': \'"난 마법사들이 하수인으로 고양이나 외눈 올빼미를 데리고 다닐 거라고 생각했어. 하지만 불붙은 공룡도 되긴 하지."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481204&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e853a7bf-1a2e-475c-8fa5-b63b0907ac64\', \'multiverseId\': 481204}, \'multiverseid\': 481204}, {\'name\': \'Pirocerátopo\', \'text\': \'Atropelar\\nToda vez que você conjurar uma mágica que não seja de criatura, coloque um marcador +1/+1 em Pirocerátopo.\', \'type\': \'Criatura — Elemental Dinossauro\', \'flavor\': \'"Eu sempre achei que os familiares dos magos fossem corujas ou gatos caolhos, essas coisas... mas um dinossauro flamejante também funciona."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481463&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7f17f5fd-bd0f-4a0b-9e5d-fecf66cc3cc2\', \'multiverseId\': 481463}, \'multiverseid\': 481463}, {\'name\': \'Пироцератопс\', \'text\': \'Пробивной удар\\nКаждый раз, когда вы разыгрываете не являющееся существом заклинание, положите один жетон +1/+1 на Пироцератопса.\', \'type\': \'Существо — Элементаль Динозавр\', \'flavor\': \'«Мне всегда казалось, что питомцы волшебников — это кошки или одноглазые совы, но пылающие динозавры — тоже ничего».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481722&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5b19dbb1-244a-463c-b5da-fde6e4c9cf30\', \'multiverseId\': 481722}, \'multiverseid\': 481722}, {\'name\': \'焰身角龙\', \'text\': \'践踏\\n每当你施放非生物咒语时，在焰身角龙上放置一个+1/+1指示物。\', \'type\': \'生物 ～元素／恐龙\', \'flavor\': \'「我总觉得法师应该养猫或独眼枭这类的佣兽才是，不过浑身冒火的恐龙也挺堪用。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481981&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'99c039a0-eec2-4c54-ae88-1994efe2ecc3\', \'multiverseId\': 481981}, \'multiverseid\': 481981}, {\'name\': \'焰身角龍\', \'text\': \'踐踏\\n每當你施放非生物咒語時，在焰身角龍上放置一個+1/+1指示物。\', \'type\': \'生物 ～元素／恐龍\', \'flavor\': \'「我總覺得法師應該養貓或獨眼梟這類的傭獸才是，不過渾身冒火的恐龍也挺堪用。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482240&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9d366c45-445c-4a7c-aa8b-d0d6301b4c18\', \'multiverseId\': 482240}, \'multiverseid\': 482240}]', '[{\'name\': \'Quarzwald-Schmetterer\', \'text\': \'Verursacht Trampelschaden\\nImmer wenn eine oder mehrere Kreaturen, die Trampelschaden verursachen und die du kontrollierst, einem Spieler Kampfschaden zufügen, erzeuge einen X/X grünen Dinosaurier-Bestie-Kreaturenspielstein, der Trampelschaden verursacht, wobei X gleich der Menge an Schadenspunkten ist, welche die Kreaturen dem Spieler zugefügt haben.\', \'type\': \'Kreatur — Dinosaurier, Bestie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479980&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c297ccd9-6adb-4c5a-96d9-f948b12798c9\', \'multiverseId\': 479980}, \'multiverseid\': 479980}, {\'name\': \'Embestidor de Bosquecuarzo\', \'text\': \'Arrolla.\\nSiempre que una o más criaturas que controlas con la habilidad de arrollar hagan daño de combate a un jugador, crea una ficha de criatura Bestia Dinosaurio verde X/X con la habilidad de arrollar, donde X es la cantidad de daño que esas criaturas han hecho a ese jugador.\', \'type\': \'Criatura — Bestia dinosaurio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480239&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'17e0618a-7578-49a0-9036-0af5116a2666\', \'multiverseId\': 480239}, \'multiverseid\': 480239}, {\'name\': \'Écraseur de Quartzbois\', \'text\': "Piétinement\\nÀ chaque fois qu\'au moins une créature avec le piétinement que vous contrôlez inflige des blessures de combat à un joueur, créez un jeton de créature X/X verte Dinosaure et Bête avec le piétinement, X étant le nombre de blessures que ces créatures ont infligé à ce joueur.", \'type\': \'Créature : dinosaure et bête\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480498&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bd819bbc-da27-4d56-ab60-3bdbf12c9e75\', \'multiverseId\': 480498}, \'multiverseid\': 480498}, {\'name\': \'Distruttore di Quarzobosco\', \'text\': \'Travolgere\\nOgniqualvolta una o più creature con travolgere che controlli infliggono danno da combattimento a un giocatore, crea una pedina creatura Bestia Dinosauro X/X verde con travolgere, dove X è pari al danno inflitto da quelle creature a quel giocatore.\', \'type\': \'Creatura — Bestia Dinosauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480757&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'03710497-6c3b-4060-a878-7d0541f30e10\', \'multiverseId\': 480757}, \'multiverseid\': 480757}, {\'name\': \'クオーツウッドの壊し屋\', \'text\': \'トランプル\\nあなたがコントロールしていてトランプルを持つクリーチャー１体以上がプレイヤー１人に戦闘ダメージを与えるたび、トランプルを持つ緑のＸ/Ｘの恐竜・ビースト・クリーチャー・トークンを１体生成する。Ｘはそれらのクリーチャーがそのプレイヤーに与えたダメージの総数に等しい。\', \'type\': \'クリーチャー — 恐竜・ビースト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481016&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'10578ce8-78a6-4346-8e4f-ad9740818772\', \'multiverseId\': 481016}, \'multiverseid\': 481016}, {\'name\': \'석영숲 파괴자\', \'text\': \'돌진\\n당신이 조종하는 돌진을 가진 생물 한 개 이상이 플레이어에게 전투피해를 입힐 때마다, 돌진을 가진 X/X 녹색 공룡 야수 생물 토큰 한 개를 만든다. X는 그 생물들이 플레이어에게 입힌 피해의 양이다.\', \'type\': \'생물 — 공룡 야수\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481275&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'af988288-6d0a-4084-b0aa-86e638594318\', \'multiverseId\': 481275}, \'multiverseid\': 481275}, {\'name\': \'Abalroador da Mata de Quartzo\', \'text\': \'Atropelar\\nToda vez que uma ou mais criaturas que você controla com atropelar causarem dano de combate a um jogador, crie uma ficha de criatura verde X/X do tipo Dinossauro Besta com atropelar, sendo X a quantidade de dano que aquelas criaturas causaram àquele jogador.\', \'type\': \'Criatura — Dinossauro Besta\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481534&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3deed896-188e-4d18-bae2-d85b6059367b\', \'multiverseId\': 481534}, \'multiverseid\': 481534}, {\'name\': \'Крушитель из Кварцевого Леса\', \'text\': \'Пробивной удар\\nКаждый раз, когда одно или несколько существ с Пробивным ударом под вашим контролем наносят боевые повреждения игроку, создайте одну фишку существа X/X зеленый Динозавр Зверь с Пробивным ударом, где X — количество повреждений, нанесенных теми существами тому игроку.\', \'type\': \'Существо — Динозавр Зверь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481793&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4451fde7-cbd4-42f0-ad58-58aa884cb5bd\', \'multiverseId\': 481793}, \'multiverseid\': 481793}, {\'name\': \'石英林粉碎兽\', \'text\': \'践踏\\n每当一个或数个由你操控且具践踏异能的生物对任一牌手造成战斗伤害时，派出一个X/X绿色，具践踏异能的恐龙／野兽衍生生物，X为前述生物对该牌手造成伤害的数值。\', \'type\': \'生物 ～恐龙／野兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482052&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'89f2dc5d-49eb-43e1-9855-cc891d82d011\', \'multiverseId\': 482052}, \'multiverseid\': 482052}, {\'name\': \'石英林粉碎獸\', \'text\': \'踐踏\\n每當一個或數個由你操控且具踐踏異能的生物對任一玩家造成戰鬥傷害時，派出一個X/X綠色，具踐踏異能的恐龍／野獸衍生生物，X為前述生物對該玩家造成傷害的數值。\', \'type\': \'生物 ～恐龍／野獸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482311&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'694a8087-1981-4978-954c-2caee0347520\', \'multiverseId\': 482311}, \'multiverseid\': 482311}]', '[{\'name\': \'Rache des Sprösslings\', \'text\': \'Zu Beginn des Kampfes in deinem Zug schickst du eine rote, weiße oder schwarze Kreaturenkarte deiner Wahl aus deinem Friedhof ins Exil. Erzeuge einen Spielstein, der eine Kopie jener Karte ist, außer dass er 1/1 ist. Er erhält Eile bis zu deinem nächsten Zug.\', \'type\': \'Verzauberung\', \'flavor\': \'Alles, was sie im Lager der Jäger fanden, waren kleine Pfotenabdrücke und viel Blut.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479977&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8a21798b-fa81-4228-b60c-53855c84e8a2\', \'multiverseId\': 479977}, \'multiverseid\': 479977}, {\'name\': \'Venganza de la cría\', \'text\': \'Al comienzo del combate en tu turno, exilia la carta de criatura roja, blanca o negra objetivo de tu cementerio. Crea una ficha que es una copia de esa carta, excepto que es 1/1. Gana la habilidad de prisa hasta tu próximo turno.\', \'type\': \'Encantamiento\', \'flavor\': \'Todo lo que encontraron en el campamento del cazador fueron unas huellas de garras diminutas y un montón de sangre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480236&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4360b9a2-7b7d-48c2-953a-022af53a6f09\', \'multiverseId\': 480236}, \'multiverseid\': 480236}, {\'name\': \'Revanche de la progéniture\', \'text\': "Au début du combat pendant votre tour, exilez une carte de créature rouge, blanche ou noire ciblée depuis votre cimetière. Créez un jeton qui est une copie de cette carte, excepté qu\'elle est 1/1. Elle acquiert la célérité jusqu\'à votre prochain tour.", \'type\': \'Enchantement\', \'flavor\': "Dans le camp du chasseur, nous n\'avons retrouvé que de toutes petites empreintes et beaucoup de sang.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480495&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a89c9611-7b5d-4538-9a37-3b98fc51da97\', \'multiverseId\': 480495}, \'multiverseid\': 480495}, {\'name\': \'Vendetta della Progenie\', \'text\': "All\'inizio del combattimento nel tuo turno, esilia una carta creatura rossa, bianca o nera bersaglio dal tuo cimitero. Crea una pedina che è una copia di quella carta, tranne che è 1/1. Ha rapidità fino al tuo prossimo turno.", \'type\': \'Incantesimo\', \'flavor\': "Nell\'accampamento dei cacciatori non trovarono altro che minuscole impronte di zampe e molto sangue.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480754&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c07f0e4b-370d-4592-bc6f-3da35bc4fad9\', \'multiverseId\': 480754}, \'multiverseid\': 480754}, {\'name\': \'幼獣の復讐\', \'text\': \'あなたのターンの戦闘の開始時に、あなたの墓地から赤か白か黒のクリーチャー・カード１枚を対象とし、それを追放する。１/１であることを除きそのカードのコピーであるトークンを１体生成する。あなたの次のターンまで、それは速攻を得る。\', \'type\': \'エンチャント\', \'flavor\': \'狩人の野営地で見つかったものは、小さな足跡と大量の血だけだった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481013&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'db2140e2-0783-47d6-9fd2-1b46dbc74d79\', \'multiverseId\': 481013}, \'multiverseid\': 481013}, {\'name\': \'자식의 복수\', \'text\': \'당신의 턴 전투 시작에, 당신의 무덤에 있는 적색, 백색, 또는 흑색 생물 카드를 목표로 정한다. 그 카드를 추방한다. 그 카드의 복사본이지만 1/1인 토큰 한 개를 만든다. 그 생물은 당신의 다음 턴까지 신속을 얻는다.\', \'type\': \'부여마법\', \'flavor\': \'사냥꾼들의 야영지에서 찾아낸 것은 작은 발자국들과 엄청난 양의 피였다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481272&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'eac125b8-884f-4541-93f5-759926ce590f\', \'multiverseId\': 481272}, \'multiverseid\': 481272}, {\'name\': \'Vingança da Cria\', \'text\': \'No início do combate no seu turno, exile o card de criatura alvo vermelho, branco ou preto de seu cemitério. Crie uma ficha que seja uma cópia daquele card, com a exceção de ser 1/1. Ela ganha ímpeto até seu próximo turno.\', \'type\': \'Encantamento\', \'flavor\': \'Tudo que acharam no acampamento do caçador foram marcas de patinhas e muito sangue.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481531&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b3792b0c-2ca0-478b-b1de-d977b26a7eec\', \'multiverseId\': 481531}, \'multiverseid\': 481531}, {\'name\': \'Месть Отпрыска\', \'text\': \'В начале боя во время вашего хода изгоните целевую красную, белую или черную карту существа из вашего кладбища. Создайте одну фишку, являющуюся копией той карты, но при этом являющуюся 1/1. Она получает Ускорение до вашего следующего хода.\', \'type\': \'Чары\', \'flavor\': \'Все, что они нашли в лагере охотников, — отпечатки маленьких лап и много крови.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481790&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e0168552-f6e3-4bf6-9f29-11100e0980de\', \'multiverseId\': 481790}, \'multiverseid\': 481790}, {\'name\': \'幼子复仇\', \'text\': \'在你回合的战斗开始时，将目标红色，白色或黑色生物牌从你的坟墓场放逐。派出一个衍生物，该衍生物为该牌的复制品，但它是1/1。它获得敏捷异能直到你的下一个回合。\', \'type\': \'结界\', \'flavor\': \'他们在猎人营地中找到的，就只有小型爪印和大量鲜血。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482049&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'aacc2abc-cb0e-4382-9275-f1f67c2c1f7d\', \'multiverseId\': 482049}, \'multiverseid\': 482049}, {\'name\': \'幼子復仇\', \'text\': \'在你回合的戰鬥開始時，將目標紅色，白色或黑色生物牌從你的墳墓場放逐。派出一個衍生物，該衍生物為該牌的複製品，但它是1/1。它獲得敏捷異能直到你的下一個回合。\', \'type\': \'結界\', \'flavor\': \'他們在獵人營地中找到的，就只有小型爪印和大量鮮血。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482308&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'eb466acd-3f14-46ef-8dc7-a789fb474c6e\', \'multiverseId\': 482308}, \'multiverseid\': 482308}]', "[{'name': 'Raugrin-Kristall', 'text': '{T}: Erzeuge {U}, {R} oder {W}.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)', 'type': 'Artefakt', 'flavor': 'Die Vegetation in Raugrin ist spärlich, doch das lässt die hoch aufragenden Kristallstrukturen nur heller erstrahlen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480017&type=card', 'language': 'German', 'identifiers': {'scryfallId': '13d9dadc-8240-44a4-9faa-feef67cd04f3', 'multiverseId': 480017}, 'multiverseid': 480017}, {'name': 'Cristal de Raugrin', 'text': '{T}: Agrega {U}, {R} o {W}.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)', 'type': 'Artefacto', 'flavor': 'La vegetación de Raugrin es insulsa, pero eso solo hace que las inmensas estructuras de cristal resplandezcan con más brillo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480276&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '1a90a0bc-db48-4a07-9174-28951d61a887', 'multiverseId': 480276}, 'multiverseid': 480276}, {'name': 'Cristal de Raugrin', 'text': '{T} : Ajoutez {U}, {R} ou {W}.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)', 'type': 'Artefact', 'flavor': 'La végétation de Raugrin est pauvre, mais cela fait briller les structures cristallines encore plus fort.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480535&type=card', 'language': 'French', 'identifiers': {'scryfallId': '96649f0d-1509-404c-898e-54b948be35be', 'multiverseId': 480535}, 'multiverseid': 480535}, {'name': 'Cristallo di Raugrin', 'text': '{T}: Aggiungi {U}, {R} o {W}.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)', 'type': 'Artefatto', 'flavor': 'La vegetazione di Raugrin è brulla, ma questo rende le torreggianti strutture di cristallo ancora più luminose.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480794&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '1864121e-4487-4d15-b70e-b8b6357720c7', 'multiverseId': 480794}, 'multiverseid': 480794}, {'name': 'ラウグリンの水晶', 'text': '{T}：{U}か{R}か{W}を加える。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）', 'type': 'アーティファクト', 'flavor': 'ラウグリンの草木の色は暗く、そびえ立つ水晶の輝きを一層際立たせている。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481053&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '10d8f1fa-c646-4e89-90b7-b0bddaaa3e42', 'multiverseId': 481053}, 'multiverseid': 481053}, {'name': '라우그린 수정', 'text': '{T}: {U}, {R}, 또는 {W}를 추가한다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)', 'type': '마법물체', 'flavor': '라우그린의 초목은 무미건조하지만, 그것은 우뚝 솟은 수정 구조물들이 더욱 빛나게 해 줄 뿐이다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481312&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'fd132765-6d89-453c-91af-d032328bc08c', 'multiverseId': 481312}, 'multiverseid': 481312}, {'name': 'Cristal de Raugrin', 'text': '{T}: Adicione {U}, {R} ou {W}.\\nReciclar {2} ({2}, descarte este card: Compre um card.)', 'type': 'Artefato', 'flavor': 'A vegetação de Raugrim é monótona, mas isso apenas ressalta o brilho de suas enormes estruturas de cristal.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481571&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5ebb9e7a-934c-498e-a621-30e324bab84c', 'multiverseId': 481571}, 'multiverseid': 481571}, {'name': 'Кристалл Раугрина', 'text': '{T}: добавьте {U}, {R} или {W}.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)', 'type': 'Артефакт', 'flavor': 'В Раугрине скудная растительность, но от этого лишь ярче сверкают возвышающиеся кристальные формирования.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481830&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '8b10e72f-db9c-4dfa-a60a-c29febe108a3', 'multiverseId': 481830}, 'multiverseid': 481830}, {'name': '洛格凌水晶', 'text': '{T}：加{U}，{R}或{W}。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）', 'type': '神器', 'flavor': '洛格凌的植被晦暗无彩，衬得高耸入云的晶体更显光耀明亮。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482089&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '6ca95a71-6285-4f23-ad16-bdf7d297c133', 'multiverseId': 482089}, 'multiverseid': 482089}, {'name': '洛格凌水晶', 'text': '{T}：加{U}，{R}或{W}。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）', 'type': '神器', 'flavor': '洛格凌的植被晦暗無彩，襯得高聳入雲的晶體更顯光耀明亮。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482348&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '4d2bf56e-bb27-4db6-964a-5d4bdc14ac87', 'multiverseId': 482348}, 'multiverseid': 482348}]", '[{\'name\': \'Raugrin-Triom\', \'text\': \'({T}: Erzeuge {U}, {R} oder {W}.)\\nDas Raugrin-Triom kommt getappt ins Spiel.\\nUmwandlung {3} ({3}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Land — Insel, Gebirge, Ebene\', \'flavor\': \'Raugrin trifft auf das Meer mit geöffnetem Kiefer, seine Küste gespickt mit Zähnen aus Kristallen und Granit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480030&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'258979bb-b768-43e4-8f3d-19674a440fb9\', \'multiverseId\': 480030}, \'multiverseid\': 480030}, {\'name\': \'Trioma de Raugrin\', \'text\': \'({T}: Agrega {U}, {R} o {W}.)\\nEl Trioma de Raugrin entra al campo de batalla girado.\\nCiclo {3}. ({3}, descartar esta carta: Roba una carta.)\', \'type\': \'Tierra — Isla montaña llanura\', \'flavor\': \'Raugrin recibe al mar con las fauces abiertas, una costa salpicada por dientes de cristal y granito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480289&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7f3e05e0-b46e-4436-80f9-aa3773763e22\', \'multiverseId\': 480289}, \'multiverseid\': 480289}, {\'name\': \'Triome de Raugrin\', \'text\': \'({T} : Ajoutez {U}, {R} ou {W}.)\\nLe Triome de Raugrin arrive sur le champ de bataille engagé.\\nRecyclage {3} ({3}, défaussez-vous de cette carte : Piochez une carte.)\', \'type\': \'Terrain : île et montagne et plaine\', \'flavor\': "Raugrin rejoint l\'océan, la gueule grande ouverte. Sa côte est jonchée de crocs de cristal et de granite.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480548&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9e5f58bb-26e8-41b9-8d5f-2359272a00a3\', \'multiverseId\': 480548}, \'multiverseid\': 480548}, {\'name\': \'Trioma di Raugrin\', \'text\': \'({T}: Aggiungi {U}, {R} o {W}.)\\nIl Trioma di Raugrin entra nel campo di battaglia TAPpato.\\nCiclo {3} ({3}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Terra — Isola Montagna Pianura\', \'flavor\': \'Raugrin accoglie il mare con le fauci spalancate della sua costa irta di denti di cristallo e granito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480807&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8270370f-a8bf-4507-9b0c-b44741fff415\', \'multiverseId\': 480807}, \'multiverseid\': 480807}, {\'name\': \'ラウグリンのトライオーム\', \'text\': \'（{T}：{U}か{R}か{W}を加える。）\\nラウグリンのトライオームはタップ状態で戦場に出る。\\nサイクリング{3}（{3}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'土地 — 島・山・平地\', \'flavor\': \'ラウグリンは海に面して大きく口を開き、海岸線には水晶と花崗岩の鋭い歯が並んでいる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481066&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d35b85ae-750f-4469-b6ef-5e9d96513539\', \'multiverseId\': 481066}, \'multiverseid\': 481066}, {\'name\': \'라우그린 삼생물군계\', \'text\': \'({T}: {U}, {R}, 또는 {W}를 추가한다.)\\n라우그린 삼생물군계는 탭된 채로 전장에 들어온다.\\n순환 {3} ({3}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'대지 — 섬 산 들\', \'flavor\': \'라우그린은 수정과 화강암들이 삐죽삐죽한 이빨처럼 나 있는 해안선으로 만들어진 아가리를 쩍 벌리고 바다를 맞이한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481325&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'18728139-925f-44a5-954a-3bcb9d680f54\', \'multiverseId\': 481325}, \'multiverseid\': 481325}, {\'name\': \'Trioma de Raugrin\', \'text\': \'({T}: Adicione {U}, {R} ou {W}.)\\nTrioma de Raugrin entra no campo de batalha virado.\\nReciclar {3} ({3}, descarte este card: Compre um card.)\', \'type\': \'Terreno — Ilha Montanha Planície\', \'flavor\': \'Raugrin encontra o mar com os dentes à mostra, na costa repleta de presas de cristal e granito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481584&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8f7144fb-da47-431b-8260-0b59150f1db3\', \'multiverseId\': 481584}, \'multiverseid\': 481584}, {\'name\': \'Триом Раугрин\', \'text\': \'({T}: добавьте {U}, {R} или {W}.)\\nТриом Раугрин выходит на поле битвы повернутым.\\nЦикл {3} ({3}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Земля — Остров Гора Равнина\', \'flavor\': \'Раугрин встречает море, широко раскрыв пасть. Его берега топорщатся зубами из кристаллов и гранита.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481843&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'844ba1ac-deea-455f-b349-56f732047f4f\', \'multiverseId\': 481843}, \'multiverseid\': 481843}, {\'name\': \'洛格凌群系\', \'text\': \'（{T}：加{U}，{R}或{W}。）\\n洛格凌群系须横置进战场。\\n循环{3}（{3}，弃掉此牌：抓一张牌。）\', \'type\': \'地 ～海岛／山脉／平原\', \'flavor\': \'洛格凌张开巨口迎接海洋，水晶岩石仿佛尖牙耸立岸边。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482102&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f1d0c09e-f77f-44d3-b5f5-5039f303ab4a\', \'multiverseId\': 482102}, \'multiverseid\': 482102}, {\'name\': \'洛格凌群系\', \'text\': \'（{T}：加{U}，{R}或{W}。）\\n洛格凌群系須橫置進戰場。\\n循環{3}（{3}，棄掉此牌：抽一張牌。）\', \'type\': \'地 ～海島／山脈／平原\', \'flavor\': \'洛格凌張開巨口迎接海洋，水晶岩石彷彿尖牙聳立岸邊。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482361&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'091b3e6b-6aa8-4820-bcf1-6e4d1e754f5f\', \'multiverseId\': 482361}, \'multiverseid\': 482361}]', '[{\'name\': \'Reißende Klauen\', \'text\': \'Eine Kreatur deiner Wahl erhält Doppelschlag bis zum Ende des Zuges.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Spontanzauber\', \'flavor\': \'„Wie viele Klauen ein Monster hat? Genau eine mehr, als du erwartet hättest."\\n—Alux, Himmelstadt-Verteidiger\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479910&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d3cea42f-ea25-4d52-9f0c-0cbf76985dd6\', \'multiverseId\': 479910}, \'multiverseid\': 479910}, {\'name\': \'Zarpas desgarradoras\', \'text\': \'La criatura objetivo gana la habilidad de dañar dos veces hasta el final del turno.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Instantáneo\', \'flavor\': \'"¿Cuántas garras tiene un monstruo? Exactamente una más de las que has tenido en cuenta".\\n—Álux, defensor de Puertoaéreo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480169&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'79ae5ea6-a334-4ff0-a088-ac4f788bd44d\', \'multiverseId\': 480169}, \'multiverseid\': 480169}, {\'name\': \'Griffes ratissantes\', \'text\': "La créature ciblée acquiert la double initiative jusqu\'à la fin du tour.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Éphémère\', \'flavor\': \'« Combien de griffes un monstre possède-t-il ? Exactement une de plus que vous ne le pensiez. »\\n—Alux, défenseur de Vogueciel\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480428&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8a885960-e4cb-4bd3-8505-3c191c64b14d\', \'multiverseId\': 480428}, \'multiverseid\': 480428}, {\'name\': \'Artigli Laceranti\', \'text\': \'Una creatura bersaglio ha doppio attacco fino alla fine del turno.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Istantaneo\', \'flavor\': \'"Quanti artigli ha un mostro? Esattamente uno in più di quanti ne avevi messi in conto."\\n—Alux, difensore della Solcanembi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480687&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'620dba14-19fa-4ef0-ba86-f308e6653410\', \'multiverseId\': 480687}, \'multiverseid\': 480687}, {\'name\': \'ひっかく鉤爪\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは二段攻撃を得る。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'インスタント\', \'flavor\': \'「怪物には鉤爪が何本あるのかって？対処できた数よりもちょうど１本多いのさ。」\\n――スカイセイルの防衛者、アルックス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480946&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9bd08f58-3080-4309-bbd2-addf672c8ff3\', \'multiverseId\': 480946}, \'multiverseid\': 480946}, {\'name\': \'갈퀴질하는 발톱\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 이단공격을 얻는다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'순간마법\', \'flavor\': \'"괴수가 발톱을 몇 개나 가지고 있냐고? 네가 센 것보다 정확하게 한 개 더 많이 가지고 있지."\\n—창공돛 수비병, 알룩스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481205&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'176888cb-5374-4bf9-b47b-e7f3b666027d\', \'multiverseId\': 481205}, \'multiverseid\': 481205}, {\'name\': \'Garras de Ancinho\', \'text\': \'A criatura alvo ganha golpe duplo até o final do turno.\\nReciclar {2} ({2}, descarte este card: Compre um card.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Quantas garras um monstro tem? Exatamente uma a mais do que você esperava."\\n— Alux, defensor da Vela Celeste\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481464&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'df7bb875-8185-4874-a517-8269a8762e15\', \'multiverseId\': 481464}, \'multiverseid\': 481464}, {\'name\': \'Раздирающие Когти\', \'text\': \'Целевое существо получает Двойной удар до конца хода.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Сколько когтей бывает у чудовища? Ровно на один коготь больше, чем ты рассчитываешь».\\n— Алукс, защитник Небесного Паруса\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481723&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'58581917-4eec-4aab-b3cb-d5150fe5857a\', \'multiverseId\': 481723}, \'multiverseid\': 481723}, {\'name\': \'利爪掠击\', \'text\': \'目标生物获得连击异能直到回合结束。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'瞬间\', \'flavor\': \'「怪兽会有几只爪？总比你想的多一只。」\\n～翔空城护卫亚卢斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481982&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1cb8e9bb-5e00-4365-8f0d-cf498cbf78b3\', \'multiverseId\': 481982}, \'multiverseid\': 481982}, {\'name\': \'利爪掠擊\', \'text\': \'目標生物獲得連擊異能直到回合結束。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'瞬間\', \'flavor\': \'「怪獸會有幾隻爪？總比你想的多一隻。」\\n～翔空城護衛亞盧斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482241&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ebfa5874-2860-48cf-a66c-63e2fcc99ec2\', \'multiverseId\': 482241}, \'multiverseid\': 482241}]', '[{\'name\': \'Reptilische Spiegelung\', \'text\': \'Immer wenn du eine Karte umwandelst, kannst du die Reptilische Spiegelung bis zum Ende des Zuges zusätzlich zu ihren anderen Typen zu einer 5/4 Dinosaurier-Kreatur werden lassen, die Eile hat und Trampelschaden verursacht.\', \'type\': \'Verzauberung\', \'flavor\': \'Die Gefahr lauert oft in der Anziehungskraft von Kristallsplittern.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479911&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'652bc87c-3798-4858-b3fa-934cd18ac27f\', \'multiverseId\': 479911}, \'multiverseid\': 479911}, {\'name\': \'Reflejo reptiliano\', \'text\': \'Siempre que actives una habilidad de ciclo de una carta, puedes hacer que el Reflejo reptiliano se convierta en una criatura Dinosaurio 5/4 con las habilidades de arrollar y prisa además de sus otros tipos hasta el final del turno.\', \'type\': \'Encantamiento\', \'flavor\': \'A menudo, el peligro acecha en la fascinación que provocan los fragmentos de cristal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480170&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f88ffff7-2a8d-43c4-a698-411a25a09122\', \'multiverseId\': 480170}, \'multiverseid\': 480170}, {\'name\': \'Reflet reptilien\', \'text\': "À chaque fois que vous recyclez une carte, vous pouvez faire que le Reflet reptilien devienne une créature 5/4 Dinosaure avec le piétinement et la célérité en plus de ses autres types jusqu\'à la fin du tour.", \'type\': \'Enchantement\', \'flavor\': \'La beauté des éclats de cristaux cache souvent de nombreux dangers.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480429&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'814556d3-3a90-4e58-a1f7-5e6f6566ecee\', \'multiverseId\': 480429}, \'multiverseid\': 480429}, {\'name\': \'Riflesso Rettile\', \'text\': \'Ogniqualvolta cicli una carta, puoi far diventare il Riflesso Rettile una creatura Dinosauro 5/4 con travolgere e rapidità in aggiunta ai suoi altri tipi fino alla fine del turno.\', \'type\': \'Incantesimo\', \'flavor\': \'Spesso il pericolo si nasconde nel fascino dei frammenti di cristallo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480688&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1a15b04c-195b-4c9b-9efc-4f4cfa15f9b1\', \'multiverseId\': 480688}, \'multiverseid\': 480688}, {\'name\': \'爬虫類の反射\', \'text\': \'あなたがカードをサイクリングするたび、あなたは「ターン終了時まで、爬虫類の反射はこれの他のタイプに加えてトランプルと速攻を持つ５/４の恐竜・クリーチャーになる。」を選んでもよい。\', \'type\': \'エンチャント\', \'flavor\': \'水晶の破片には、しばしば危険が潜んでいる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480947&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'657bb254-1ceb-4966-8ec3-e3909429fa26\', \'multiverseId\': 480947}, \'multiverseid\': 480947}, {\'name\': \'파충류의 반사상\', \'text\': \'당신이 카드를 순환할 때마다, 당신은 파충류의 반사상이 턴종료까지 자신의 원래 유형에 더불어 돌진 및 신속을 가진 5/4 공룡 생물이 되게 할 수 있다.\', \'type\': \'부여마법\', \'flavor\': \'수정 조각의 유혹 속에는 종종 위험이 도사리고 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481206&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a50b8dca-fc7d-4fde-b276-96e68de27c0a\', \'multiverseId\': 481206}, \'multiverseid\': 481206}, {\'name\': \'Reflexo Reptiliano\', \'text\': \'Toda vez que recicla um card, você pode fazer com que Reflexo Reptiliano se torne uma criatura 5/4 do tipo Dinossauro com atropelar e ímpeto além de seus outros tipos até o final do turno.\', \'type\': \'Encantamento\', \'flavor\': \'Muitas vezes o perigo espreita no fascínio dos fragmentos cristalinos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481465&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2d3abb38-f71a-4db2-b48e-f67f03b97b79\', \'multiverseId\': 481465}, \'multiverseid\': 481465}, {\'name\': \'Отражение Ящера\', \'text\': \'Каждый раз, когда вы совершаете Цикл карты, вы можете заставить Отражение Ящера стать существом 5/4 Динозавр с Пробивным ударом и Ускорением в дополнение к своим другим типам до конца хода.\', \'type\': \'Чары\', \'flavor\': \'Опасность зачастую скрывается среди манящих кристальных скоплений.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481724&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9270c91b-9808-4448-9bfb-1f4ce0cfe05d\', \'multiverseId\': 481724}, \'multiverseid\': 481724}, {\'name\': \'爬虫映影\', \'text\': \'每当你循环一张牌时，你可以令爬虫映影成为5/4，具践踏与敏捷异能的恐龙生物直到回合结束，且仍具有其原本类别。\', \'type\': \'结界\', \'flavor\': \'危险往往就藏在水晶碎片的诱惑之中。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481983&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2236c0dc-73ab-4385-bf1e-7de6a992f675\', \'multiverseId\': 481983}, \'multiverseid\': 481983}, {\'name\': \'爬蟲映影\', \'text\': \'每當你循環一張牌時，你可以令爬蟲映影成為5/4，具踐踏與敏捷異能的恐龍生物直到回合結束，且仍具有其原本類別。\', \'type\': \'結界\', \'flavor\': \'危險往往就藏在水晶碎片的誘惑之中。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482242&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9f573944-71f4-47c5-9959-3aa4608c541a\', \'multiverseId\': 482242}, \'multiverseid\': 482242}]', '[{\'name\': \'Rielle die Allwissende\', \'text\': \'Rielle die Allwissende erhält +1/+0 für jede Spontanzauber- und Hexerei-Karte in deinem Friedhof.\\nImmer wenn du zum ersten Mal in einem Zug eine oder mehrere Karten abwirfst, ziehst du entsprechend viele Karten.\', \'type\': \'Legendäre Kreatur — Mensch, Zauberer\', \'flavor\': \'„Allwissend zu sein bedeutet, sich zu erinnern, welche Dinge man vergessen muss."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479982&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5bdb4cae-7598-480c-b817-d8a30acecb82\', \'multiverseId\': 479982}, \'multiverseid\': 479982}, {\'name\': \'Rielle, la Versada\', \'text\': \'Rielle, la Versada obtiene +1/+0 por cada carta de instantáneo y de conjuro en tu cementerio.\\nSiempre que descartes una o más cartas por primera vez cada turno, roba esa misma cantidad de cartas.\', \'type\': \'Criatura legendaria — Hechicero humano\', \'flavor\': \'"Saberlo todo es cuestión de recordar qué cosas es vital olvidar".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480241&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'650c7605-39f8-4060-87a7-425a453a35db\', \'multiverseId\': 480241}, \'multiverseid\': 480241}, {\'name\': "Rielle, l\'éternisciente", \'text\': "Rielle, l\'éternisciente gagne +1/+0 pour chaque carte d\'éphémère et de rituel dans votre cimetière.\\nÀ chaque fois que vous vous défaussez d\'au moins une carte pour la première fois à chaque tour, piochez autant de cartes.", \'type\': \'Créature légendaire : humain et sorcier\', \'flavor\': "« La connaissance ultime consiste à se souvenir des choses qu\'il faut absolument oublier. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480500&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9edc2ec4-f027-452e-9747-a74e0075e45a\', \'multiverseId\': 480500}, \'multiverseid\': 480500}, {\'name\': "Rielle, l\'Onnisapiente", \'text\': "Rielle, l\'Onnisapiente prende +1/+0 per ogni carta istantaneo o stregoneria nel tuo cimitero.\\nOgniqualvolta scarti una o più carte per la prima volta in ogni turno, pesca altrettante carte.", \'type\': \'Creatura Leggendaria — Mago Umano\', \'flavor\': \'"Essere onniscienti significa ricordare che cosa è essenziale dimenticare."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480759&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e34b3db6-88a4-447e-b8b9-5ca2397700cf\', \'multiverseId\': 480759}, \'multiverseid\': 480759}, {\'name\': \'常智のリエール\', \'text\': \'常智のリエールは、あなたの墓地にありインスタントやソーサリーであるカード１枚につき＋１/＋０の修整を受ける。\\n各ターン内で初めてあなたがカードを１枚以上捨てるたび、その枚数に等しい枚数のカードを引く。\', \'type\': \'伝説のクリーチャー — 人間・ウィザード\', \'flavor\': \'「すべてを知るというのは、何を忘れるべきかを覚えておくということだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481018&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f30f0aec-1544-4520-80ef-fbc4d5fe8273\', \'multiverseId\': 481018}, \'multiverseid\': 481018}, {\'name\': \'지고의 현인, 리엘\', \'text\': \'지고의 현인, 리엘은 당신의 무덤에 있는 각 순간마법 및 집중마법 카드마다 +1/+0을 받는다.\\n당신이 매 턴 처음으로 카드를 한 장 이상 버릴 때마다, 그만큼 카드를 뽑는다.\', \'type\': \'전설적 생물 — 인간 마법사\', \'flavor\': \'"모든 것을 아는 자가 되는 일은 어떤 것들을 잊는 것이 중요한지를 기억하는 것에 달려 있다네."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481277&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'bb909c3a-5e44-417e-b6fa-2bce354671fd\', \'multiverseId\': 481277}, \'multiverseid\': 481277}, {\'name\': \'Rielle, a Onissapiente\', \'text\': \'Rielle, a Onissapiente, recebe +1/+0 para cada card de mágica instantânea e feitiço em seu cemitério.\\nToda vez que você descartar um ou mais cards pela primeira vez a cada turno, compre aquela quantidade de cards.\', \'type\': \'Criatura Lendária — Humano Mago\', \'flavor\': \'"Saber tudo é uma questão de lembrar o que é crucial esquecer."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481536&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bde40794-a8e3-47b3-99a7-71578420b257\', \'multiverseId\': 481536}, \'multiverseid\': 481536}, {\'name\': \'Риэлль, Вечномудрая\', \'text\': \'Риэлль, Вечномудрая получает +1/+0 за каждую карту мгновенного заклинания и волшебства на вашем кладбище.\\nКаждый раз, когда вы сбрасываете одну или несколько карт в первый раз в каждом ходу, возьмите такое же количество карт.\', \'type\': \'Легендарное Существо — Человек Чародей\', \'flavor\': \'«Быть всезнающей — это значит помнить, какие вещи необходимо во что бы то ни стало забыть».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481795&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a6efba75-5b9f-4ef3-80b0-34b65244ddae\', \'multiverseId\': 481795}, \'multiverseid\': 481795}, {\'name\': \'全知利艾尔\', \'text\': \'你坟墓场中每有一张瞬间与法术牌，全知利艾尔便得+1/+0。\\n每当你每回合首度弃掉一张或数张牌时，抓等量的牌。\', \'type\': \'传奇生物 ～人类／法术师\', \'flavor\': \'「全知就是要记住必须忘却哪些事情。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482054&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'91f9e278-cb7d-4d74-a65f-0b4035b72415\', \'multiverseId\': 482054}, \'multiverseid\': 482054}, {\'name\': \'全知利艾爾\', \'text\': \'你墳墓場中每有一張瞬間與巫術牌，全知利艾爾便得+1/+0。\\n每當你每回合首度棄掉一張或數張牌時，抽等量的牌。\', \'type\': \'傳奇生物 ～人類／魔法師\', \'flavor\': \'「全知就是要記住必須忘卻哪些事情。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482313&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bfd15972-2ef9-4c86-b415-d7f697ea1272\', \'multiverseId\': 482313}, \'multiverseid\': 482313}]', '[{\'name\': \'Robuster Spulkäfer\', \'text\': \'{4}{B}: Bringe den Robusten Spulkäfer aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Kreatur — Insekt\', \'flavor\': \'„Ich habe gesehen, wie sie Lava, Getrampel und das Verdauungssystem eines Molochs überlebt haben. Sie rollen sich einfach wieder auseinander und leben weiter!"\\n—Gannet, Himmelstadt-Zoologe\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479864&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bb55118d-e38a-43b9-8212-e4c4eb47412e\', \'multiverseId\': 479864}, \'multiverseid\': 479864}, {\'name\': \'Bichobola resistente\', \'text\': \'{4}{B}: Regresa el Bichobola resistente de tu cementerio a tu mano.\', \'type\': \'Criatura — Insecto\', \'flavor\': \'"Los he visto sobrevivir a la lava, a los pisotones y al sistema digestivo de un moloc. ¡Simplemente, ruedan y siguen con sus vidas!".\\n—Gánet, zoólogo de Puertoaéreo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480123&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'13e8c558-4d61-446b-9e27-e5aa1b37271a\', \'multiverseId\': 480123}, \'multiverseid\': 480123}, {\'name\': \'Sphérapode durable\', \'text\': \'{4}{B} : Renvoyez le Sphérapode durable depuis votre cimetière dans votre main.\', \'type\': \'Créature : insecte\', \'flavor\': "« Je les ai vus survivre à la lave, aux piétinements et à l\'estomac d\'un Diable cornu. Ils en ressortent et continuent comme si de rien n\'était ! »\\n—Gannet, zoologue de Vogueciel", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480382&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'365a699c-0a11-4f80-b76f-298631347343\', \'multiverseId\': 480382}, \'multiverseid\': 480382}, {\'name\': \'Appallottero Resistente\', \'text\': "{4}{B}: Riprendi in mano l\'Appallottero Resistente dal tuo cimitero.", \'type\': \'Creatura — Insetto\', \'flavor\': \'"Li ho visti sopravvivere alla lava, a zampe che li calpestavano e al sistema digerente di un moloc. Si srotolano come se niente fosse e vanno avanti con la loro vita!"\\n—Gannet, zoologo della Solcanembi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480641&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'41b94dfd-9431-4a2d-af4b-4fde87270fda\', \'multiverseId\': 480641}, \'multiverseid\': 480641}, {\'name\': \'頑丈なダンゴムシ\', \'text\': \'{4}{B}：あなたの墓地から頑丈なダンゴムシをあなたの手札に戻す。\', \'type\': \'クリーチャー — 昆虫\', \'flavor\': \'「こいつらはたとえ溶岩の中でも、踏みつけられても、モロクの胃に入っても生き残るんだ。ただ転がり出てきて前向きに生きていくのさ！」\\n――スカイセイルの動物学者、ガネット\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480900&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'62e2a628-fec6-4c0e-90c0-34fdcdca2f85\', \'multiverseId\': 480900}, \'multiverseid\': 480900}, {\'name\': \'튼튼한 고리벌레\', \'text\': \'{4}{B}: 튼튼한 고리벌레를 당신의 무덤에서 당신의 손으로 되돌린다.\', \'type\': \'생물 — 곤충\', \'flavor\': \'"난 그것들이 용암에서도, 짓이겨져도, 몰로크의 뱃속에서도 살아남는 걸 봤어. 그냥 굴러나와서는 자기 할 일을 하더라고!"\\n—창공돛 동물학자, 가넷\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481159&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d13051fb-4ead-4e98-8b62-84b3649600a3\', \'multiverseId\': 481159}, \'multiverseid\': 481159}, {\'name\': \'Inseto-bola Resistente\', \'text\': \'{4}{B}: Devolva Inseto-bola Resistente de seu cemitério para sua mão.\', \'type\': \'Criatura — Inseto\', \'flavor\': \'"Eu já os vi sobreviverem à lava, a atropelamentos e ao aparelho digestório de um moloch. Eles só saem rolando e seguem em frente!"\\n— Gannet, zoólogo da Vela Celeste\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481418&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a396b7b5-a7b4-4f8d-9a7c-f05e19bb35fd\', \'multiverseId\': 481418}, \'multiverseid\': 481418}, {\'name\': \'Прочная Спираленожка\', \'text\': \'{4}{B}: верните Прочную Спираленожку из вашего кладбища в вашу руку.\', \'type\': \'Существо — Насекомое\', \'flavor\': \'«Я видел, как они выдерживали лаву, поступь чудовищ и пищеварительную систему молоха. Они просто выкатываются, разворачиваются и живут себе дальше!»\\n— Ганнет, зоолог Небесного Паруса\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481677&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d086c493-7f70-44d9-8706-7cee8eb6d06f\', \'multiverseId\': 481677}, \'multiverseid\': 481677}, {\'name\': \'硬壳蜷曲虫\', \'text\': \'{4}{B}：将硬壳蜷曲虫从你的坟墓场移回你手上。\', \'type\': \'生物 ～昆虫\', \'flavor\': \'「我曾见过它们活过熔岩、踩踏甚至是棘蜥的肠胃。它们就这么滚出来，安然无恙地活下去！」\\n～翔空城动物学家加涅特\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481936&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'28478f32-444c-4303-b28e-12934f21158a\', \'multiverseId\': 481936}, \'multiverseid\': 481936}, {\'name\': \'硬殼蜷曲蟲\', \'text\': \'{4}{B}：將硬殼蜷曲蟲從你的墳墓場移回你手上。\', \'type\': \'生物 ～昆蟲\', \'flavor\': \'「我曾見過牠們活過熔岩、踩踏，甚至是棘蜥的腸胃。牠們就這麼滾出來，安然無恙地活下去！」\\n～翔空城動物學家加涅特\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482195&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0690c412-ff94-43ce-9e9b-95e5a2097489\', \'multiverseId\': 482195}, \'multiverseid\': 482195}]', '[{\'name\': \'Ruf des Todbrüters\', \'text\': \'Bringe bis zu zwei Kreaturenkarten deiner Wahl mit umgewandelten Manakosten von insgesamt 3 oder weniger aus deinem Friedhof ins Spiel zurück. Lege eine Todesberührung-Marke auf eine davon. Lege dann eine Bedrohlich-Marke auf eine davon.\', \'type\': \'Hexerei\', \'flavor\': \'Die Lebenden fürchten das Flüstern Nethrois. Die Toten folgen ihm.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479857&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7beb5247-9cff-4179-9b51-40d40b48839e\', \'multiverseId\': 479857}, \'multiverseid\': 479857}, {\'name\': \'Llamada del Habitante de la Muerte\', \'text\': \'Regresa hasta dos cartas de criatura objetivo con un coste de maná convertido total de 3 o menos de tu cementerio al campo de batalla. Pon un contador de toque mortal sobre cualquiera de ellas. Luego pon un contador de amenaza sobre cualquiera de ellas.\', \'type\': \'Conjuro\', \'flavor\': \'Los vivos temen los susurros de Nethroi. Los muertos los obedecen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480116&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c047c2c0-5845-4898-bf29-0bb3be239f82\', \'multiverseId\': 480116}, \'multiverseid\': 480116}, {\'name\': \'Appel du Thanatophile\', \'text\': "Renvoyez sur le champ de bataille depuis votre cimetière jusqu\'à deux cartes de créature ciblées avec un coût converti de mana total inférieur ou égal à 3. Mettez un marqueur « contact mortel » sur l\'une d\'entre elles. Puis mettez un marqueur « menace » sur l\'une d\'entre elles.", \'type\': \'Rituel\', \'flavor\': \'Les mortels sont terrifiés par les murmures de Nethroï. Les morts, eux, répondent à son appel.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480375&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7665365e-b3eb-4670-8f82-343e61493ef1\', \'multiverseId\': 480375}, \'multiverseid\': 480375}, {\'name\': \'Richiamo del Dimoramorte\', \'text\': \'Rimetti sul campo di battaglia fino a due carte creatura bersaglio con costo di mana convertito totale pari o inferiore a 3 dal tuo cimitero. Metti un segnalino tocco letale su una di esse. Poi metti un segnalino minacciare su una di esse.\', \'type\': \'Stregoneria\', \'flavor\': \'I vivi temono i sussurri di Nethroi. I morti li eseguono.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480634&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'529cf84a-0d8f-47e9-8e9f-94107b0c8945\', \'multiverseId\': 480634}, \'multiverseid\': 480634}, {\'name\': \'死住まいの呼び声\', \'text\': \'あなたの墓地からクリーチャー・カード最大２枚を点数で見たマナ・コストの合計が３以下になるように対象とし、それらを戦場に戻す。それらのうち１つの上に接死カウンターを１個置く。その後それらのうち１つの上に威迫カウンターを１個置く。\', \'type\': \'ソーサリー\', \'flavor\': \'生者はネスロイの囁きを恐れる。死者は耳を澄まして聞く。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480893&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'808bca42-e492-4c5b-8205-ee63e21644a2\', \'multiverseId\': 480893}, \'multiverseid\': 480893}, {\'name\': \'죽음 거주자의 부름\', \'text\': \'당신의 무덤에서 총 전환마나비용이 3 이하가 되도록 생물 카드를 최대 두 장까지 목표로 정한다. 그 카드들을 전장으로 되돌린다. 그중 한 생물에 치명타 카운터를 올려놓는다. 그 후, 그중 한 생물에 호전적 카운터를 올려놓는다.\', \'type\': \'집중마법\', \'flavor\': \'산 자들은 네스로이의 속삭임을 두려워한다. 죽은 자들은 그 소리에 주의를 기울인다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481152&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f3fbe1d4-1999-48f8-91ab-e177e6757722\', \'multiverseId\': 481152}, \'multiverseid\': 481152}, {\'name\': \'Chamado do Mortívago\', \'text\': \'Devolva até dois cards de criatura alvo com custo de mana convertido total igual ou inferior a 3 de seu cemitério para o campo de batalha. Coloque um marcador de toque mortífero em um deles. Em seguida, coloque um marcador de ameaçar em um deles.\', \'type\': \'Feitiço\', \'flavor\': \'Os vivos temem os sussurros de Nethroi. Os mortos os escutam.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481411&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d3e71175-427d-4401-8eaa-749ab3b85198\', \'multiverseId\': 481411}, \'multiverseid\': 481411}, {\'name\': \'Зов Обитателя Смерти\', \'text\': \'Верните из вашего кладбища на поле битвы не более двух целевых карт существ с суммарной конвертированной мана-стоимостью не более 3. Положите на любое из них один жетон Смертельного касания. Затем положите на любое из них один жетон Угрозы.\', \'type\': \'Волшебство\', \'flavor\': \'Живые страшатся шепота Нетроя. Мертвые повинуются ему.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481670&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8750a61f-a908-4e48-bbe2-e0340e2f8262\', \'multiverseId\': 481670}, \'multiverseid\': 481670}, {\'name\': \'夺命狮召唤\', \'text\': \'将至多两张目标生物牌从你的坟墓场移回战场，且这些牌总法术力费用的总和须等于或小于3。在这些生物之一上放置一个死触指示物。然后在这些生物之一上放置一个威慑指示物。\', \'type\': \'法术\', \'flavor\': \'生者畏惧涅司罗的低语，而死者则从其召唤。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481929&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'270239b5-b802-4696-b2b1-7ce18626a57d\', \'multiverseId\': 481929}, \'multiverseid\': 481929}, {\'name\': \'奪命獅召喚\', \'text\': \'將至多兩張目標生物牌從你的墳墓場移回戰場，且這些牌總魔法力費用的總和須等於或小於3。在這些生物之一上放置一個死觸指示物。然後在這些生物之一上放置一個威懾指示物。\', \'type\': \'巫術\', \'flavor\': \'生者畏懼涅司羅的低語，而死者則從其召喚。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482188&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ffdcce37-355f-4b83-974a-dbf0c06badb8\', \'multiverseId\': 482188}, \'multiverseid\': 482188}]', "[{'name': 'Rufer der Leere', 'text': 'Todesberührung\\nUmwandlung {2}{B} ({2}{B}, wirf diese Karte ab: Ziehe eine Karte.)\\nWenn du den Rufer der Leere umwandelst, lege eine Todesberührung-Marke auf eine Kreatur deiner Wahl, die du kontrollierst.', 'type': 'Kreatur — Nachtmahr, Schrecken', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479883&type=card', 'language': 'German', 'identifiers': {'scryfallId': '31ac56d0-e76c-4f1b-8ed0-b233a2d632b7', 'multiverseId': 479883}, 'multiverseid': 479883}, {'name': 'Llamavacíos', 'text': 'Toque mortal.\\nCiclo {2}{B}. ({2}{B}, descartar esta carta: Roba una carta.)\\nCuando actives la habilidad de ciclo del Llamavacíos, pon un contador de toque mortal sobre la criatura objetivo que controlas.', 'type': 'Criatura — Horror pesadilla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480142&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '453eec14-83b8-4985-b58e-f5e2b9878d44', 'multiverseId': 480142}, 'multiverseid': 480142}, {'name': 'Mandeur du vide', 'text': 'Contact mortel\\nRecyclage {2}{B} ({2}{B}, défaussez-vous de cette carte : Piochez une carte.)\\nQuand vous recyclez le Mandeur du vide, mettez un marqueur « contact mortel » sur une créature ciblée que vous contrôlez.', 'type': 'Créature : cauchemar et horreur', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480401&type=card', 'language': 'French', 'identifiers': {'scryfallId': '4800f771-c612-42a2-8050-07624388c8f3', 'multiverseId': 480401}, 'multiverseid': 480401}, {'name': 'Convocatore del Vuoto', 'text': 'Tocco letale\\nCiclo {2}{B} ({2}{B}, Scarta questa carta: Pesca una carta.)\\nQuando cicli il Convocatore del Vuoto, metti un segnalino tocco letale su una creatura bersaglio che controlli.', 'type': 'Creatura — Orrore Incubo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480660&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '229296e7-422f-493c-ae00-b1f45cadfa1a', 'multiverseId': 480660}, 'multiverseid': 480660}, {'name': '虚空を招くもの', 'text': '接死\\nサイクリング{2}{B}（{2}{B}, このカードを捨てる：カードを１枚引く。）\\nあなたが虚空を招くものをサイクリングしたとき、あなたがコントロールしているクリーチャー１体を対象とし、それの上に接死カウンターを１個置く。', 'type': 'クリーチャー — ナイトメア・ホラー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480919&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '8ccbe555-005a-43fb-9096-cbb408545319', 'multiverseId': 480919}, 'multiverseid': 480919}, {'name': '공허 유혹자', 'text': '치명타\\n순환 {2}{B} ({2}{B}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\\n당신이 공허 유혹자를 순환할 때, 당신이 조종하는 생물을 목표로 정한다. 그 생물에 치명타 카운터를 올려놓는다.', 'type': '생물 — 나이트메어 괴수', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481178&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'a7933ae5-3fab-4613-a12f-72f1a1b16a66', 'multiverseId': 481178}, 'multiverseid': 481178}, {'name': 'Invocador do Vazio', 'text': 'Toque mortífero\\nReciclar {2}{B} ({2}{B}, descarte este card: Compre um card.)\\nQuando reciclar Invocador do Vazio, coloque um marcador de toque mortífero na criatura alvo que você controla.', 'type': 'Criatura — Pesadelo Horror', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481437&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3878deac-1f30-464e-8060-d170a820ca61', 'multiverseId': 481437}, 'multiverseid': 481437}, {'name': 'Призыватель Пустоты', 'text': 'Смертельное касание\\nЦикл {2}{B} ({2}{B}, сбросьте эту карту: возьмите карту.)\\nКогда вы совершаете Цикл Призывателя Пустоты, положите один жетон Смертельного касания на целевое существо под вашим контролем.', 'type': 'Существо — Кошмар Ужас', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481696&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'fd178779-f489-4add-b385-4de171e453e8', 'multiverseId': 481696}, 'multiverseid': 481696}, {'name': '虚空召兽', 'text': '死触\\n循环{2}{B}（{2}{B}，弃掉此牌：抓一张牌。）\\n当你循环虚空召兽时，在目标由你操控的生物上放置一个死触指示物。', 'type': '生物 ～梦魇／惊惧兽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481955&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '22e9d967-7105-4e40-afea-a8a08afed23c', 'multiverseId': 481955}, 'multiverseid': 481955}, {'name': '虛空召獸', 'text': '死觸\\n循環{2}{B}（{2}{B}，棄掉此牌：抽一張牌。）\\n當你循環虛空召獸時，在目標由你操控的生物上放置一個死觸指示物。', 'type': '生物 ～夢魘／驚懼獸', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482214&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '46858ba0-3cfd-47c4-8224-a1c5677e5408', 'multiverseId': 482214}, 'multiverseid': 482214}]", '[{\'name\': \'Rückkehr für Rache\', \'text\': \'Bringe eine Kreaturenkarte deiner Wahl aus deinem Friedhof ins Spiel zurück. Wenn du dies tust, kämpft sie gegen bis zu eine Kreatur deiner Wahl, die du nicht kontrollierst. (Jede der Kreaturen fügt der anderen Schadenspunkte in Höhe ihrer Stärke zu.)\', \'type\': \'Spontanzauber\', \'flavor\': \'„Wie kannst du sicher sein, dass du sein Herz durchbohrt hast? Weißt du überhaupt, wo sein Herz ist?"\\n—Trundan, Indatha-Wilderer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479956&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c70ec9a9-5654-4884-9e5f-2629d690ecbf\', \'multiverseId\': 479956}, \'multiverseid\': 479956}, {\'name\': \'Volver a por más\', \'text\': \'Regresa la carta de criatura objetivo de tu cementerio al campo de batalla. Cuando lo hagas, esa criatura lucha contra hasta una criatura objetivo que no controlas. (Cada una hace un daño igual a su fuerza a la otra.)\', \'type\': \'Instantáneo\', \'flavor\': \'"¿Cómo puedes saber seguro que atravesaste su corazón? ¿Acaso sabes dónde tiene el corazón?".\\n—Trundan, cazador furtivo de Indatha\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480215&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'870e6247-a288-49cb-a84c-5b0d6972a2f2\', \'multiverseId\': 480215}, \'multiverseid\': 480215}, {\'name\': \'En redemander\', \'text\': "Renvoyez sur le champ de bataille une carte de créature ciblée depuis votre cimetière. Quand vous faites ainsi, elle se bat contre jusqu\'à une créature ciblée que vous ne contrôlez pas. (Chacune inflige un nombre de blessures égal à sa force à l\'autre.)", \'type\': \'Éphémère\', \'flavor\': "« Comment savez-vous que vous lui avez transpercé le cœur ? Vous ne savez même pas où il se trouve ! »\\n—Trundan, braconnier d\'Indatha", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480474&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'83a4d43b-a5e9-4df2-b1eb-6b72847464ab\', \'multiverseId\': 480474}, \'multiverseid\': 480474}, {\'name\': \'Ritorno Vendicativo\', \'text\': "Rimetti sul campo di battaglia una carta creatura bersaglio dal tuo cimitero. Quando lo fai, lotta con fino a una creatura bersaglio che non controlli. (Ogni creatura infligge all\'altra danno pari alla propria forza.)", \'type\': \'Istantaneo\', \'flavor\': \'"Come puoi essere certo di avergli trafitto il cuore? Hai la minima idea di dove sia il cuore?"\\n—Trundan, cacciatore di frodo di Indatha\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480733&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'938d2fbc-a6cf-49f1-8d55-422e7771788e\', \'multiverseId\': 480733}, \'multiverseid\': 480733}, {\'name\': \'再来\', \'text\': \'あなたの墓地からクリーチャー・カード１枚を対象とし、それを戦場に戻す。そうしたとき、あなたがコントロールしていないクリーチャー最大１体を対象とする。その前者のクリーチャーはその後者のクリーチャーと格闘を行う。（それぞれはもう一方に自身のパワーに等しい点数のダメージを与える。）\', \'type\': \'インスタント\', \'flavor\': \'「なぜ心臓を貫いたと言い切れる？そもそも心臓がどこにあるか分かっているのか？」\\n――インダサの密猟者、トゥルンダン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480992&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7d264754-6846-4f36-896d-abf42e32d7d3\', \'multiverseId\': 480992}, \'multiverseid\': 480992}, {\'name\': \'더 강해진 귀환\', \'text\': \'당신의 무덤에 있는 생물 카드를 목표로 정한다. 그 카드를 전장으로 되돌린다. 그렇게 할 때, 당신이 조종하지 않는 생물을 최대 한 개까지 목표로 정한다. 되돌려진 생물은 그 목표와 싸운다. (각 생물은 서로에게 각자의 공격력만큼 피해를 입힌다.)\', \'type\': \'순간마법\', \'flavor\': \'"심장을 꿰뚫었다는 걸 어떻게 그렇게 확신할 수 있지? 심장이 어디 있는지는 알기나 해?"\\n—인다타 밀렵꾼, 트룬단\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481251&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'184607e5-2225-4f72-9cf1-37cc0d0f8f63\', \'multiverseId\': 481251}, \'multiverseid\': 481251}, {\'name\': \'Retrucar\', \'text\': \'Devolva o card de criatura alvo de seu cemitério para o campo de batalha. Quando você faz isso, ela luta contra até uma criatura alvo que você não controla. (Cada uma causa dano igual ao seu poder à outra.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Como você pode ter certeza de que perfurou o coração dele? E você lá sabe onde o coração dele fica?"\\n— Trundan, caçador de Indatha\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481510&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'aa31ced3-6001-4820-94ea-8e75a26bb633\', \'multiverseId\': 481510}, \'multiverseid\': 481510}, {\'name\': \'Возвращение за Добавкой\', \'text\': \'Верните целевую карту существа из вашего кладбища на поле битвы. Когда вы это делаете, оно дерется не более чем с одним целевым существом не под вашим контролем. (Они наносят друг другу повреждения, равные своей силе.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Откуда ты знаешь, что пробил ему сердце? Ты хоть знаешь, где у него сердце?»\\n— Трундан, индатский браконьер\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481769&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8d7fa7ed-eaab-42b2-989d-480ec0be48bb\', \'multiverseId\': 481769}, \'multiverseid\': 481769}, {\'name\': \'返身再战\', \'text\': \'将目标生物牌从你的坟墓场移回战场。当你如此作时，它与至多一个目标不由你操控的生物互斗。（它们各向对方造成等同于本身力量的伤害。）\', \'type\': \'瞬间\', \'flavor\': \'「你怎么确定已经刺穿了它的心脏？你知道它的心脏在哪里吗？」\\n～因达沙偷猎者川丁\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482028&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d433547a-803d-4a62-a9d8-d6fed726e86e\', \'multiverseId\': 482028}, \'multiverseid\': 482028}, {\'name\': \'返身再戰\', \'text\': \'將目標生物牌從你的墳墓場移回戰場。當你如此作時，它與至多一個目標不由你操控的生物互鬥。（它們各向對方造成等同於本身力量的傷害。）\', \'type\': \'瞬間\', \'flavor\': \'「你怎麼確定已經刺穿了牠的心臟？你知道牠的心臟在哪裡嗎？」\\n～因達沙偷獵者川丁\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482287&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e0958a48-a340-462c-ae8e-a362a2aec5f3\', \'multiverseId\': 482287}, \'multiverseid\': 482287}]', '[{\'name\': \'Savai-Donnermähne\', \'text\': \'Immer wenn du eine Karte umwandelst, kannst du {2} bezahlen. Wenn du dies tust, fügt die Savai-Donnermähne einer Kreatur deiner Wahl 2 Schadenspunkte zu und du erhältst 2 Lebenspunkte dazu.\', \'type\': \'Kreatur — Elementarwesen, Katze\', \'flavor\': \'Ein krachendes Gebrüll ist das letzte, was viele Jäger hören.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479984&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ada1d1a2-6a7e-48f6-aba4-af4a81775501\', \'multiverseId\': 479984}, \'multiverseid\': 479984}, {\'name\': \'Melenatrueno de Savái\', \'text\': \'Siempre que actives una habilidad de ciclo de una carta, puedes pagar {2}. Cuando lo hagas, el Melenatrueno de Savái hace 2 puntos de daño a la criatura objetivo y tú ganas 2 vidas.\', \'type\': \'Criatura — Felino elemental\', \'flavor\': \'Su rugido crepitante es el último sonido que escuchan muchos cazadores.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480243&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'16c7766c-8571-45b4-a90b-e59ae4395cf1\', \'multiverseId\': 480243}, \'multiverseid\': 480243}, {\'name\': \'Crinière de foudre de Savaï\', \'text\': \'À chaque fois que vous recyclez une carte, vous pouvez payer {2}. Quand vous faites ainsi, la Crinière de foudre de Savaï inflige 2 blessures à la créature ciblée et vous gagnez 2 points de vie.\', \'type\': \'Créature : élémental et chat\', \'flavor\': \'Ce rugissement crépitant est généralement la dernière chose entendue par de nombreux chasseurs.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480502&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0f3054a6-34ee-47bc-9856-9852e0bf493e\', \'multiverseId\': 480502}, \'multiverseid\': 480502}, {\'name\': \'Fulmicriniera di Savai\', \'text\': \'Ogniqualvolta cicli una carta, puoi pagare {2}. Quando lo fai, il Fulmicriniera di Savai infligge 2 danni a una creatura bersaglio e tu guadagni 2 punti vita.\', \'type\': \'Creatura — Felino Elementale\', \'flavor\': "L\'ultimo suono che sentono molti cacciatori è un ruggito crepitante.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480761&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'01a0d0f1-d6f6-4aa2-b2f2-0c59bc57d23c\', \'multiverseId\': 480761}, \'multiverseid\': 480761}, {\'name\': \'サヴァイの雷たてがみ\', \'text\': \'あなたがカードをサイクリングするたび、あなたは{2}を支払ってもよい。そうしたとき、クリーチャー１体を対象とする。サヴァイの雷たてがみはそれに２点のダメージを与え、あなたは２点のライフを得る。\', \'type\': \'クリーチャー — エレメンタル・猫\', \'flavor\': \'雷のような咆哮は、多くの狩人が聞く最後の音だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481020&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cc98371f-eda2-4c0a-b584-af7d3ac59021\', \'multiverseId\': 481020}, \'multiverseid\': 481020}, {\'name\': \'사바이 천둥갈기\', \'text\': \'당신이 카드를 순환할 때마다, 당신은 {2}를 지불할 수 있다. 그렇게 할 때, 생물을 목표로 정한다. 사바이 천둥갈기는 그 생물에게 피해 2점을 입히고 당신은 생명 2점을 얻는다.\', \'type\': \'생물 — 정령 고양이\', \'flavor\': \'수많은 사냥꾼들이 그들의 마지막 순간에 빠직거리는 포효를 듣는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481279&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d2533273-b04d-47df-b1b7-f0e95de21421\', \'multiverseId\': 481279}, \'multiverseid\': 481279}, {\'name\': \'Juba-de-trovão de Savai\', \'text\': \'Toda vez que você recicla um card, você pode pagar {2}. Quando você faz isso, Juba-de-trovão de Savai causa 2 pontos de dano à criatura alvo e você ganha 2 pontos de vida.\', \'type\': \'Criatura — Elemental Felino\', \'flavor\': \'Um rugido estrilado é o último som que muitos caçadores ouvem.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481538&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'64cb3432-5779-421a-9498-700d36301f66\', \'multiverseId\': 481538}, \'multiverseid\': 481538}, {\'name\': \'Савайский Громогрив\', \'text\': \'Каждый раз, когда вы совершаете Цикл карты, вы можете заплатить {2}. Когда вы это делаете, Савайский Громогрив наносит 2 повреждения целевому существу, а вы получаете 2 жизни.\', \'type\': \'Существо — Элементаль Кошка\', \'flavor\': \'Его трескучий рев — последнее, что многие охотники слышат в жизни.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481797&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'32914e4f-2f56-4f5b-819e-7712913ade66\', \'multiverseId\': 481797}, \'multiverseid\': 481797}, {\'name\': \'撒维耶雷鬃狮\', \'text\': \'每当你循环一张牌时，你可以支付{2}。当你如此作时，撒维耶雷鬃狮对目标生物造成2点伤害，且你获得2点生命。\', \'type\': \'生物 ～元素／猫\', \'flavor\': \'一道雷鸣嘶吼，是许多猎人听到的最后声音。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482056&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'244d98e3-3cc4-493e-9d2e-3a2d94216de7\', \'multiverseId\': 482056}, \'multiverseid\': 482056}, {\'name\': \'撒維耶雷鬃獅\', \'text\': \'每當你循環一張牌時，你可以支付{2}。當你如此作時，撒維耶雷鬃獅對目標生物造成2點傷害，且你獲得2點生命。\', \'type\': \'生物 ～元素／貓\', \'flavor\': \'一道雷鳴嘶吼，是許多獵人聽到的最後聲音。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482315&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c45989cf-d9ea-4484-8b9b-da7eaba5548d\', \'multiverseId\': 482315}, \'multiverseid\': 482315}]', '[{\'name\': \'Savai-Kristall\', \'text\': \'{T}: Erzeuge {R}, {W} oder {B}.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Artefakt\', \'flavor\': \'Dieselben Kristalle, deren Wurzeln tief genug reichen, um die Katakomben von Savai zu durchbohren, reichen auch hoch genug, um das Wetter zu beeinflussen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480018&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'703446ee-e7eb-442d-9ff8-a863a36cd9f3\', \'multiverseId\': 480018}, \'multiverseid\': 480018}, {\'name\': \'Cristal de Savái\', \'text\': \'{T}: Agrega {R}, {W} o {B}.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Artefacto\', \'flavor\': \'Los mismos cristales que se hunden con tal profundidad que atraviesan las catacumbas de Savái también se alzan tanto como para cambiar su clima.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480277&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'322abc06-d077-46bc-9519-a88923e0a997\', \'multiverseId\': 480277}, \'multiverseid\': 480277}, {\'name\': \'Cristal de Savaï\', \'text\': \'{T} : Ajoutez {R}, {W} ou {B}.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)\', \'type\': \'Artefact\', \'flavor\': "Ces cristaux s\'enfoncent suffisamment en profondeur pour percer les catacombes de Savaï, mais ils montent également suffisamment haut pour influencer son climat.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480536&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7a900100-d6e8-4a48-bf8e-7434cb7f3494\', \'multiverseId\': 480536}, \'multiverseid\': 480536}, {\'name\': \'Cristallo di Savai\', \'text\': \'{T}: Aggiungi {R}, {W} o {B}.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Artefatto\', \'flavor\': \'Gli stessi cristalli che si radicano così in profondità da penetrare nelle catacombe di Savai si estendono anche così in alto da cambiarne il clima.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480795&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8106ef3f-e37a-4e53-a9ad-006422f343d2\', \'multiverseId\': 480795}, \'multiverseid\': 480795}, {\'name\': \'サヴァイの水晶\', \'text\': \'{T}：{R}か{W}か{B}を加える。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'アーティファクト\', \'flavor\': \'サヴァイの地下墓地にも届くほど深く根差す同じ水晶が、空高く伸び上がり天候にも影響している。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481054&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4779f2e9-86ff-42b5-8260-90e8f11f3317\', \'multiverseId\': 481054}, \'multiverseid\': 481054}, {\'name\': \'사바이 수정\', \'text\': \'{T}: {R}, {W}, 또는 {B}를 추가한다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'마법물체\', \'flavor\': \'사바이의 지하묘지를 뚫고 들어갈 정도로 깊이 박혀 있는 수정들은 마찬가지로 날씨를 바꿀 정도로 하늘 높이 솟아 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481313&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'37387fe8-cf86-49d2-85cb-4d7f644d7288\', \'multiverseId\': 481313}, \'multiverseid\': 481313}, {\'name\': \'Cristal de Savai\', \'text\': \'{T}: Adicione {R}, {W} ou {B}.\\nReciclar {2} ({2}, descarte este card: Compre um card.)\', \'type\': \'Artefato\', \'flavor\': \'Os mesmos cristais cujas raízes profundas tocam as catacumbas de Savai também são capazes de alterar o clima com sua altura.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481572&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'08450011-5500-4ff4-b1e4-3b9d5e473708\', \'multiverseId\': 481572}, \'multiverseid\': 481572}, {\'name\': \'Кристалл Савая\', \'text\': \'{T}: добавьте {R}, {W} или {B}.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Артефакт\', \'flavor\': \'Те же кристаллы, что укореняются так глубоко, что проникают в катакомбы Савая, возносятся так высоко, что влияют на погоду.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481831&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'26ce21e9-b122-4827-8c19-0b82ab085cf9\', \'multiverseId\': 481831}, \'multiverseid\': 481831}, {\'name\': \'撒维耶水晶\', \'text\': \'{T}：加{R}，{W}或{B}。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'神器\', \'flavor\': \'撒维耶的水晶深可进地穿透陵墓，高可入云改变天气。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482090&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'45e3e922-d64f-4662-acc7-19d803a54498\', \'multiverseId\': 482090}, \'multiverseid\': 482090}, {\'name\': \'撒維耶水晶\', \'text\': \'{T}：加{R}，{W}或{B}。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'神器\', \'flavor\': \'撒維耶的水晶深可進地穿透陵墓，高可入雲改變天氣。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482349&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3ed48571-1f00-4f58-9418-08c0c363f183\', \'multiverseId\': 482349}, \'multiverseid\': 482349}]', '[{\'name\': \'Savai-Säbelzahntiger\', \'type\': \'Kreatur — Katze\', \'flavor\': \'Die riesigen Tiger von Savai jagen gerne bei Tag, wenn das warnende Glühen der Kristalle von der Morgendämmerung überstrahlt wird.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479808&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3d78f8b4-f798-4370-8bde-def7a5af3483\', \'multiverseId\': 479808}, \'multiverseid\': 479808}, {\'name\': \'Dientes de sable de Savái\', \'type\': \'Criatura — Felino\', \'flavor\': \'Los tigres gigantes de Savái prefieren cazar al alba, cuando la luz del amanecer oculta el brillo de advertencia de los cristales.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480067&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ddf75d69-fc57-43ef-8a6f-76abecd2dbac\', \'multiverseId\': 480067}, \'multiverseid\': 480067}, {\'name\': \'Smilodon de Savaï\', \'type\': \'Créature : chat\', \'flavor\': "Les tigres géants de Savaï préfèrent chasser au petit matin, quand la lueur des cristaux est masquée par la lumière de l\'aube.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480326&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7b2eeb9c-5544-4e90-944b-155a1c66306c\', \'multiverseId\': 480326}, \'multiverseid\': 480326}, {\'name\': \'Denti a Sciabola di Savai\', \'type\': \'Creatura — Felino\', \'flavor\': "Le tigri giganti di Savai preferiscono cacciare all\'alba, quando il bagliore di allerta dei cristalli è mascherato dalla luce dell\'aurora.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480585&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0dfaa390-601a-44af-9065-78be5d898d01\', \'multiverseId\': 480585}, \'multiverseid\': 480585}, {\'name\': \'サヴァイの剣歯虎\', \'type\': \'クリーチャー — 猫\', \'flavor\': \'サヴァイの巨大な虎は明け方の狩りを好む。警告する水晶の輝きが夜明けの光に紛れる時間帯だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480844&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a15bfcec-8aca-4034-a38a-e3f17d8a4e3a\', \'multiverseId\': 480844}, \'multiverseid\': 480844}, {\'name\': \'사바이 검치호\', \'type\': \'생물 — 고양이\', \'flavor\': \'사바이의 거대한 호랑이들은 수정들의 경고하는 빛이 햇살에 가려지는 새벽녘에 사냥하는 것을 선호한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481103&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e232b141-82c5-4899-9804-74fdbe1caace\', \'multiverseId\': 481103}, \'multiverseid\': 481103}, {\'name\': \'Dente-de-sabre de Savai\', \'type\': \'Criatura — Felino\', \'flavor\': \'Os tigres gigantes de Savai preferem caçar na alvorada, quando o brilho de advertência dos cristais se confundem com a luz da aurora.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481362&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b8bd26a3-27bb-43b7-9aef-e649f0a9addf\', \'multiverseId\': 481362}, \'multiverseid\': 481362}, {\'name\': \'Савайский Саблезуб\', \'type\': \'Существо — Кошка\', \'flavor\': \'Гигантские тигры Савая предпочитают охотиться на рассвете, когда тревожного мерцания кристаллов не видно из-за встающего солнца.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481621&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a4361aa2-2975-4104-8b86-71d39f9f919c\', \'multiverseId\': 481621}, \'multiverseid\': 481621}, {\'name\': \'撒维耶剑齿虎\', \'type\': \'生物 ～猫\', \'flavor\': \'撒维耶巨虎偏好在破晓时分行猎，全因此时黎明曙光会盖过光晶的警示辉光。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481880&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8e57be7b-36c3-4e22-a8fa-acf382b14989\', \'multiverseId\': 481880}, \'multiverseid\': 481880}, {\'name\': \'撒維耶劍齒虎\', \'type\': \'生物 ～貓\', \'flavor\': \'撒維耶巨虎偏好在破曉時分行獵，全因此時黎明曙光會蓋過光晶的警示輝光。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482139&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d21bab48-ca18-4495-a3b9-2192aba971f4\', \'multiverseId\': 482139}, \'multiverseid\': 482139}]', "[{'name': 'Savai-Triom', 'text': '({T}: Erzeuge {R}, {W} oder {B}.)\\nDas Savai-Triom kommt getappt ins Spiel.\\nUmwandlung {3} ({3}, wirf diese Karte ab: Ziehe eine Karte.)', 'type': 'Land — Gebirge, Ebene, Sumpf', 'flavor': 'Breite Prärien speisen den Zufluchtsort der Menschen von Drannith und verbergen ein Netz von Höhlen, in denen Riesenkatzen hausen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480032&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a3342896-3301-4308-9b51-56e1f58c6f25', 'multiverseId': 480032}, 'multiverseid': 480032}, {'name': 'Trioma de Savái', 'text': '({T}: Agrega {R}, {W} o {B}.)\\nEl Trioma de Savái entra al campo de batalla girado.\\nCiclo {3}. ({3}, descartar esta carta: Roba una carta.)', 'type': 'Tierra — Montaña llanura pantano', 'flavor': 'Las amplias praderas alimentan el santuario humano de Drannith y ocultan una red de cavernas que sirven de guarida a felinos gigantes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480291&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '937bf864-411c-42da-a185-fdef893a0192', 'multiverseId': 480291}, 'multiverseid': 480291}, {'name': 'Triome de Savaï', 'text': '({T} : Ajoutez {R}, {W} ou {B}.)\\nLe Triome de Savaï arrive sur le champ de bataille engagé.\\nRecyclage {3} ({3}, défaussez-vous de cette carte : Piochez une carte.)', 'type': 'Terrain : montagne et plaine et marais', 'flavor': 'Les grandes prairies nourrissent le sanctuaire humain de Drannith et dissimulent un réseau de cavernes dans lesquelles des félins géants établissent leur tanière.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480550&type=card', 'language': 'French', 'identifiers': {'scryfallId': '5e722cea-8321-4fc8-82a5-3623c90a5eaf', 'multiverseId': 480550}, 'multiverseid': 480550}, {'name': 'Trioma di Savai', 'text': '({T}: Aggiungi {R}, {W} o {B}.)\\nIl Trioma di Savai entra nel campo di battaglia TAPpato.\\nCiclo {3} ({3}, Scarta questa carta: Pesca una carta.)', 'type': 'Terra — Montagna Pianura Palude', 'flavor': 'Vaste praterie alimentano il santuario umano di Drannith e nascondono una rete di caverne che giganteschi felini usano come tane.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480809&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '93fb566e-1577-4791-8468-f1e8c4cd9b6e', 'multiverseId': 480809}, 'multiverseid': 480809}, {'name': 'サヴァイのトライオーム', 'text': '（{T}：{R}か{W}か{B}を加える。）\\nサヴァイのトライオームはタップ状態で戦場に出る。\\nサイクリング{3}（{3}, このカードを捨てる：カードを１枚引く。）', 'type': '土地 — 山・平地・沼', 'flavor': '広大な草原は、ドラニスの人間の聖域を養い、巨大な猫類の巣穴となっている繋がった洞窟群を隠している。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481068&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '22b490c8-27a6-4633-9193-551bd38ad3be', 'multiverseId': 481068}, 'multiverseid': 481068}, {'name': '사바이 삼생물군계', 'text': '({T}: {R}, {W}, 또는 {B}를 추가한다.)\\n사바이 삼생물군계는 탭된 채로 전장에 들어온다.\\n순환 {3} ({3}, 이 카드를 버린다: 카드 한 장을 뽑는다.)', 'type': '대지 — 산 들 늪', 'flavor': '드넓은 초원이 드라니스의 인간 성소에 식량을 공급하며, 또한 괴수 고양이들이 둥지를 틀고 있는 얼기설기 얽힌 동굴들을 숨겨 준다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481327&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '203a35a3-0aa3-4e42-b5ae-2f30fc04e126', 'multiverseId': 481327}, 'multiverseid': 481327}, {'name': 'Trioma de Savai', 'text': '({T}: Adicione {R}, {W} ou {B}.)\\nTrioma de Savai entra no campo de batalha virado.\\nReciclar {3} ({3}, descarte este card: Compre um card.)', 'type': 'Terreno — Montanha Planície Pântano', 'flavor': 'As amplas pradarias alimentam o santuário humano de Drannith, bem como ocultam uma rede de cavernas que abrigam covis de felinos gigantescos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481586&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5256a44c-8c70-44fc-96e8-373739c5e26d', 'multiverseId': 481586}, 'multiverseid': 481586}, {'name': 'Триом Савай', 'text': '({T}: добавьте {R}, {W} или {B}.)\\nТриом Савай выходит на поле битвы повернутым.\\nЦикл {3} ({3}, сбросьте эту карту: возьмите карту.)', 'type': 'Земля — Гора Равнина Болото', 'flavor': 'Просторные степи питают человеческое убежище Драннит и скрывают под собой сеть пещер, в которых устраивают логово гигантские кошки.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481845&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '9302eb6a-9f70-4032-804e-669f0c9d2271', 'multiverseId': 481845}, 'multiverseid': 481845}, {'name': '撒维耶群系', 'text': '（{T}：加{R}，{W}或{B}。）\\n撒维耶群系须横置进战场。\\n循环{3}（{3}，弃掉此牌：抓一张牌。）', 'type': '地 ～山脉／平原／沼泽', 'flavor': '此地的广袤沃原让人类庇护地卓尼斯得以安养生息，岩壁上的丰富洞脉也让巨狮能在这里筑穴建巢。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482104&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'd6985e55-d654-4f0e-9f15-15f06f75bb1d', 'multiverseId': 482104}, 'multiverseid': 482104}, {'name': '撒維耶群系', 'text': '（{T}：加{R}，{W}或{B}。）\\n撒維耶群系須橫置進戰場。\\n循環{3}（{3}，棄掉此牌：抽一張牌。）', 'type': '地 ～山脈／平原／沼澤', 'flavor': '此地的廣袤沃原讓人類庇護地卓尼斯得以安養生息，岩壁上的豐富洞脈也讓巨獅能在這裡築穴建巢。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482363&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '26da4def-574a-4a2d-a158-24467cd53e8e', 'multiverseId': 482363}, 'multiverseid': 482363}]", '[{\'name\': \'Scharfsicht-Mentorin\', \'text\': \'Wenn die Scharfsicht-Mentorin ins Spiel kommt, lege eine Wachsamkeit-Marke auf eine Nicht-Mensch-Kreatur deiner Wahl, die du kontrollierst.\\n{1}{W}, {T}: Lege auf jede Kreatur mit Wachsamkeit, die du kontrollierst, eine +1/+1-Marke.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': \'Durch *Eludha* erhalten Bynder die mächtigen Fähigkeiten ihrer auserwählten Gefährten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479797&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d90aaa9c-0fd4-455e-bcdd-3eec4413e846\', \'multiverseId\': 479797}, \'multiverseid\': 479797}, {\'name\': \'Mentora de visión perspicaz\', \'text\': \'Cuando la Mentora de visión perspicaz entre al campo de batalla, pon un contador de vigilancia sobre la criatura objetivo que no sea Humano que controlas.\\n{1}{W}, {T}: Pon un contador +1/+1 sobre cada criatura que controlas con la habilidad de vigilancia.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': \'Mediante la *eludha*, los vinculadores comparten las poderosas habilidades de los compañeros que han elegido.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480056&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a6a0b6b1-cbc1-44f6-9de0-5bcb04fa95f2\', \'multiverseId\': 480056}, \'multiverseid\': 480056}, {\'name\': \'Mentor vifœil\', \'text\': \'Quand la Mentor vifœil arrive sur le champ de bataille, mettez un marqueur « vigilance » sur une créature non-Humain ciblée que vous contrôlez.\\n{1}{W}, {T} : Mettez un marqueur +1/+1 sur chaque créature avec la vigilance que vous contrôlez.\', \'type\': \'Créature : humain et clerc\', \'flavor\': "Grâce à l\'*éludha*, les brideurs partagent les puissantes capacités des compagnons qu\'ils ont choisis.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480315&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cc269874-63e0-4939-aaac-1b4e4bf7ebf6\', \'multiverseId\': 480315}, \'multiverseid\': 480315}, {\'name\': \'Mentore della Vista Acuta\', \'text\': \'Quando la Mentore della Vista Acuta entra nel campo di battaglia, metti un segnalino cautela su una creatura non Umano bersaglio che controlli.\\n{1}{W}, {T}: Metti un segnalino +1/+1 su ogni creatura con cautela che controlli.\', \'type\': \'Creatura — Chierico Umano\', \'flavor\': "Attraverso l\'*eludha*, i vincolatori condividono le potenti abilità dei compagni che scelgono.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480574&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'23171f03-62eb-450a-a6ce-4bcf047780c7\', \'multiverseId\': 480574}, \'multiverseid\': 480574}, {\'name\': \'慧眼の導師\', \'text\': \'慧眼の導師が戦場に出たとき、あなたがコントロールしていて人間でないクリーチャー１体を対象とし、それの上に警戒カウンターを１個置く。\\n{1}{W}, {T}：あなたがコントロールしていて警戒を持つ各クリーチャーの上に＋１/＋１カウンターをそれぞれ１個置く。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': \'*エルーダ*を通して、眷者は自らが選んだ相棒とその強い能力を共有する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480833&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'131b0cd7-03bd-4fb0-9556-5b5164a2ad5b\', \'multiverseId\': 480833}, \'multiverseid\': 480833}, {\'name\': \'예리한 눈을 가진 스승\', \'text\': \'예리한 눈을 가진 스승이 전장에 들어올 때, 당신이 조종하는 인간이 아닌 생물을 목표로 정한다. 그 생물에 경계 카운터를 올려놓는다.\\n{1}{W}, {T}: 당신이 조종하는 경계를 가진 각 생물에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 인간 성직자\', \'flavor\': \'*엘루다*를 통해, 유대자들은 자신이 선택한 단짝과 강력한 능력들을 공유한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481092&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4e3f29f2-89e0-48be-b38d-cc7c3dac71a3\', \'multiverseId\': 481092}, \'multiverseid\': 481092}, {\'name\': \'Mentora de Vista Aguçada\', \'text\': \'Quando mentora de Vista Aguçada entrar no campo de batalha, coloque um marcador de vigilância na criatura alvo que você controla que não seja um Humano.\\n{1}{W}, {T}: Coloque um marcador +1/+1 em cada criatura que você controla com vigilância.\', \'type\': \'Criatura — Humano Clérigo\', \'flavor\': \'Por meio da *eludha* os vinculadores partilham das habilidades poderosas dos companheiros escolhidos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481351&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bc0f0751-7eea-489e-a20a-2ff9c578123c\', \'multiverseId\': 481351}, \'multiverseid\': 481351}, {\'name\': \'Наставница Зорких Глаз\', \'text\': \'Когда Наставница Зорких Глаз выходит на поле битвы, положите один жетон Бдительности на целевое не являющееся Человеком существо под вашим контролем.\\n{1}{W}, {T}: положите один жетон +1/+1 на каждое существо с Бдительностью под вашим контролем.\', \'type\': \'Существо — Человек Священник\', \'flavor\': \'Через *элудху* узоманты получают могущественные способности своих избранных компаньонов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481610&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e7378f27-16c0-451a-acb4-9224425ca7b1\', \'multiverseId\': 481610}, \'multiverseid\': 481610}, {\'name\': \'锐目导师\', \'text\': \'当锐目导师进战场时，在目标由你操控的非人类生物上放置一个警戒指示物。\\n{1}{W}，{T}：在每个由你操控且具警戒异能的生物上各放置一个+1/+1指示物。\', \'type\': \'生物 ～人类／僧侣\', \'flavor\': \'持绊人可以通过*灵绊*与他们的灵兽同伴共享强大的能力。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481869&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d747bf87-89fe-4c47-8dad-e4f74f8341b6\', \'multiverseId\': 481869}, \'multiverseid\': 481869}, {\'name\': \'銳目導師\', \'text\': \'當銳目導師進戰場時，在目標由你操控的非人類生物上放置一個警戒指示物。\\n{1}{W}，{T}：在每個由你操控且具警戒異能的生物上各放置一個+1/+1指示物。\', \'type\': \'生物 ～人類／僧侶\', \'flavor\': \'持絆人可以藉由*靈絆*與他們的靈獸同伴共享強大的能力。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482128&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6a356fc6-dc58-4019-a1d5-8e6f5baa8467\', \'multiverseId\': 482128}, \'multiverseid\': 482128}]', '[{\'name\': \'Schauriges Ultimatum\', \'text\': \'Bringe eine beliebige Anzahl an bleibenden Karten mit unterschiedlichen Namen aus deinem Friedhof ins Spiel zurück.\', \'type\': \'Hexerei\', \'flavor\': \'„Der Boden unter unseren Füßen erinnert sich an jede Kränkung gegen diese Welt. Jede davon wird gerächt werden."\\n—Gavi die Nesthüterin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479963&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fa58fe51-a01b-40f9-87ba-15f65ddb30f2\', \'multiverseId\': 479963}, \'multiverseid\': 479963}, {\'name\': \'Ultimátum espeluznante\', \'text\': \'Regresa cualquier cantidad de cartas de permanente con nombres distintos de tu cementerio al campo de batalla.\', \'type\': \'Conjuro\', \'flavor\': \'"La tierra que se halla bajo nuestros pies es la prueba de todas las ofensas contra el mundo, que se vengará en el momento que considere oportuno".\\n—Gavi, guardiana del nido\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480222&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a492b02d-c058-4e0b-b3f4-d25d5f1a859b\', \'multiverseId\': 480222}, \'multiverseid\': 480222}, {\'name\': \'Ultimatum inquiétant\', \'text\': "Renvoyez sur le champ de bataille n\'importe quel nombre de cartes de permanent avec des noms différents depuis votre cimetière.", \'type\': \'Rituel\', \'flavor\': \'« La terre que nous foulons se souvient de tout le mal qui a été fait à ce monde, et elle le vengera en temps voulu. »\\n—Gavi, garde du nid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480481&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3ea7086c-6fa7-470e-a356-ae623e23c89b\', \'multiverseId\': 480481}, \'multiverseid\': 480481}, {\'name\': \'Ultimatum Inquietante\', \'text\': \'Rimetti sul campo di battaglia un qualsiasi numero di carte permanente con nomi diversi dal tuo cimitero.\', \'type\': \'Stregoneria\', \'flavor\': \'"La terra sotto i nostri piedi è una testimonianza di ogni affronto contro il mondo, che verrà vendicato quando esso lo vorrà."\\n—Gavi, guardiana del nido\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480740&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'32ae7db1-fd89-4562-8705-5d6f3b03c15d\', \'multiverseId\': 480740}, \'multiverseid\': 480740}, {\'name\': \'奇妙な根本原理\', \'text\': \'あなたの墓地から名前の異なる、望む枚数のパーマネント・カードを戦場に戻す。\', \'type\': \'ソーサリー\', \'flavor\': \'「私たちの足元の大地には世界に対する侮辱がすべて記録されている。世界が選んだ時に復讐するためにね。」\\n――巣守り、ガヴィ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480999&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'985eb946-80f0-48a4-a0a5-fe9c0c2079c6\', \'multiverseId\': 480999}, \'multiverseid\': 480999}, {\'name\': \'으스스한 최후통첩\', \'text\': \'당신의 무덤에 있는 서로 이름이 다른 지속물 카드들을 원하는 수만큼 전장으로 되돌린다.\', \'type\': \'집중마법\', \'flavor\': \'"우리 발 밑에 있는 대지는 이 세계에 대한 모욕들을 모두 기록해 두었다가 자신이 원하는 시점에 복수한다."\\n—둥지 관리인, 가비\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481258&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8d437939-9761-426d-9cde-03e77e76291c\', \'multiverseId\': 481258}, \'multiverseid\': 481258}, {\'name\': \'Ultimato Soturno\', \'text\': \'Devolva qualquer número de cards de permanente com nomes diferentes de seu cemitério para o campo de batalha.\', \'type\': \'Feitiço\', \'flavor\': \'"A terra sob nossos pés é um registro de cada minúscula ofensa contra o mundo, a ser vingada quando ele assim escolher."\\n— Gavi, guardiã do ninho\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481517&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'78fcb2ec-e0b4-4b33-8447-86bda53049a5\', \'multiverseId\': 481517}, \'multiverseid\': 481517}, {\'name\': \'Жуткий Ультиматум\', \'text\': \'Верните любое количество карт перманентов с различными именами из вашего кладбища на поле битвы.\', \'type\': \'Волшебство\', \'flavor\': \'«Земля под нашими ногами хранит память о каждом проступке против этого мира, и отомстит за каждый из них, когда придет время».\\n— Гави, охранница гнезда\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481776&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'24f60d7b-344c-4b3a-835e-06de06312356\', \'multiverseId\': 481776}, \'multiverseid\': 481776}, {\'name\': \'神秘通牒\', \'text\': \'将任意数量名称各不相同的永久物牌从你的坟墓场移回战场。\', \'type\': \'法术\', \'flavor\': \'「我们每次对世界的轻蔑，都由脚下的大地记录在案，等待合适的时机来复仇。」\\n～巢穴护卫盖薇\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482035&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a097fe7a-0435-4fbb-8166-605b78f43319\', \'multiverseId\': 482035}, \'multiverseid\': 482035}, {\'name\': \'神秘通牒\', \'text\': \'將任意數量名稱各不相同的永久物牌從你的墳墓場移回戰場。\', \'type\': \'巫術\', \'flavor\': \'「我們每次對世界的輕蔑，都由腳下的大地記錄在案，等待合適的時機來復仇。」\\n～巢穴護衛蓋薇\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482294&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'dea69ba3-a064-41e9-bc51-96637b52523f\', \'multiverseId\': 482294}, \'multiverseid\': 482294}]', '[{\'name\': \'Schlingentaktiker\', \'text\': \'Immer wenn du eine Karte umwandelst, tappe eine Kreatur deiner Wahl, die ein Gegner kontrolliert.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'„Unsere Salven haben nicht das Ziel zu töten. Wenn die Getroffenen zu Boden stürzen, sind sie eh erledigt."\\n—Alux, Himmelstadt-Verteidiger\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479809&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'18d5c9dc-69b9-4e1e-8f8e-0d529de37f6f\', \'multiverseId\': 479809}, \'multiverseid\': 479809}, {\'name\': \'Estratega trampero\', \'text\': \'Siempre que actives una habilidad de ciclo de una carta, gira la criatura objetivo que controla un oponente.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'"Nuestras descargas no pretenden matar. Los enredamos y el suelo hace el resto".\\n—Álux, defensor de Puertoaéreo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480068&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f4a7550b-0a33-4468-b67f-3f91e0123c4a\', \'multiverseId\': 480068}, \'multiverseid\': 480068}, {\'name\': \'Tacticien aux collets\', \'text\': "À chaque fois que vous recyclez une carte, engagez une créature ciblée qu\'un adversaire contrôle.", \'type\': \'Créature : humain et soldat\', \'flavor\': "« Nous ne cherchons pas à les tuer. Nous les paralysons, et le sol s\'occupe du reste. »\\n—Alux, défenseur de Vogueciel", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480327&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'018cbbb3-e235-4acb-b921-c886c12d9f9f\', \'multiverseId\': 480327}, \'multiverseid\': 480327}, {\'name\': \'Stratega delle Trappole\', \'text\': \'Ogniqualvolta cicli una carta, TAPpa una creatura bersaglio controllata da un avversario.\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'"Le nostre raffiche non mirano a uccidere. Basta ostacolarli e il terreno farà il resto."\\n—Alux, difensore della Solcanembi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480586&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'42d7f5e0-35cd-4c2f-8c9f-0371fcba341b\', \'multiverseId\': 480586}, \'multiverseid\': 480586}, {\'name\': \'罠の戦術家\', \'text\': \'あなたがカードをサイクリングするたび、対戦相手がコントロールしているクリーチャー１体を対象とし、それをタップする。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'「我々は射撃で殺そうとはしていない。弱らせれば後は地上の奴らが片付けてくれる。」\\n――スカイセイルの防衛者、アルックス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480845&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3f403dde-aaff-4811-a4f5-7e2eb926555f\', \'multiverseId\': 480845}, \'multiverseid\': 480845}, {\'name\': \'덫 책략가\', \'text\': \'당신이 카드를 순환할 때마다, 상대가 조종하는 생물을 목표로 정한다. 그 생물을 탭한다.\', \'type\': \'생물 — 인간 병사\', \'flavor\': \'"우리는 죽이려고 사격을 하는 게 아냐. 상처만 입히면 나머지는 땅바닥이 처리해 주지."\\n—창공돛 수비병, 알룩스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481104&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5446a098-6e4a-41ae-aa16-f2ac6011e51b\', \'multiverseId\': 481104}, \'multiverseid\': 481104}, {\'name\': \'Tático das Armadilhas\', \'text\': \'Toda vez que você reciclar um card, vire a criatura alvo que um oponente controla.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': \'"Nossas saraivadas não são para matar. Enfraqueça-os o suficiente e o chão fará o resto."\\n— Alux, defensor da Vela Celeste\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481363&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'db71ce88-1432-456e-8f0c-4eb0db0adc16\', \'multiverseId\': 481363}, \'multiverseid\': 481363}, {\'name\': \'Тактик Силков\', \'text\': \'Каждый раз, когда вы совершаете Цикл карты, поверните целевое существо под контролем оппонента.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'«Наши залпы и не должны убивать. Запутать их — а остальное сделает земля».\\n— Алукс, защитник Небесного Паруса\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481622&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d6c21b2e-9b5f-48b5-9684-119a1b32a527\', \'multiverseId\': 481622}, \'multiverseid\': 481622}, {\'name\': \'诱捕策士\', \'text\': \'每当你循环一张牌时，横置目标由对手操控的生物。\', \'type\': \'生物 ～人类／士兵\', \'flavor\': \'「我们的攻击并非瞄准要害。只要能够将对方击伤，大地会帮我们处理后续。」\\n～翔空城护卫亚卢斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481881&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f639d296-6bea-4eef-a1bc-343073512872\', \'multiverseId\': 481881}, \'multiverseid\': 481881}, {\'name\': \'誘捕策士\', \'text\': \'每當你循環一張牌時，橫置目標由對手操控的生物。\', \'type\': \'生物 ～人類／士兵\', \'flavor\': \'「我們的攻擊並非瞄準要害。只要能夠將對方擊傷，大地會幫我們處理後續。」\\n～翔空城護衛亞盧斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482140&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b0ee283a-5d03-4472-bd1a-14993e32e0bf\', \'multiverseId\': 482140}, \'multiverseid\': 482140}]', '[{\'name\': \'Schnappzahn-Falle\', \'text\': \'Aufblitzen\\n{4}, {T}, opfere die Schnappzahn-Falle: Sie fügt einem Ziel deiner Wahl 3 Schadenspunkte zu.\', \'type\': \'Artefakt\', \'flavor\': \'„Hör auf, zu versuchen, den Pelz zu durchstechen. Triff es dort, wo es am verwundbarsten ist: Knöchel, Sohle, Achillessehne."\\n—Meisterjäger Chevill\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480020&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f83e52c3-4384-4bab-8cf4-6243d680aa3e\', \'multiverseId\': 480020}, \'multiverseid\': 480020}, {\'name\': \'Trampa de resortes\', \'text\': \'Destello.\\n{4}, {T}, sacrificar la Trampa de resortes: Hace 3 puntos de daño a cualquier objetivo.\', \'type\': \'Artefacto\', \'flavor\': \'"Deja de intentar atravesar su piel. Dale donde es más blando: el tobillo, la planta de la pata o el talón".\\n—Chevill, maestro cazador\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480279&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ae1ad7d3-0dcf-4aeb-9b4f-1e185bca83f5\', \'multiverseId\': 480279}, \'multiverseid\': 480279}, {\'name\': \'Piège à mâchoires\', \'text\': "Flash\\n{4}, {T}, sacrifiez le Piège à mâchoires : Il inflige 3 blessures à n\'importe quelle cible.", \'type\': \'Artefact\', \'flavor\': "« Inutile d\'essayer de percer la peau. Frappe aux points les plus faibles : cheville, talon, jarret. »\\n—Maître chasseur Chévill", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480538&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d2c7f97c-2e93-4950-b5fb-05c73e0bba72\', \'multiverseId\': 480538}, \'multiverseid\': 480538}, {\'name\': \'Trappola della Fauce a Scatto\', \'text\': \'Lampo\\n{4}, {T}, Sacrifica la Trappola della Fauce a Scatto: Infligge 3 danni a un qualsiasi bersaglio.\', \'type\': \'Artefatto\', \'flavor\': \'"Smetti di cercare di perforare la pelle. Colpisci dov\\\'è più morbido: caviglia, pianta della zampa, tendine del garretto."\\n—Maestro di caccia Chevill\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480797&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e132aafc-2b58-4f84-ab34-12bbe2f38748\', \'multiverseId\': 480797}, \'multiverseid\': 480797}, {\'name\': \'トラバサミ\', \'text\': \'瞬速\\n{4}, {T}, トラバサミを生け贄に捧げる：クリーチャー１体かプレインズウォーカー１体かプレイヤー１人を対象とする。これはそれに３点のダメージを与える。\', \'type\': \'アーティファクト\', \'flavor\': \'「厚い皮を貫こうとするな。一番柔らかいところを突くんだ。足首とか、足の裏とか、太腿裏とか。」\\n――練達の狩人、チェビル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481056&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'43977bc0-9fbd-4f33-b5ce-ea2ac8ac116b\', \'multiverseId\': 481056}, \'multiverseid\': 481056}, {\'name\': \'스프링턱 덫\', \'text\': \'섬광\\n{4}, {T}, 스프링턱 덫을 희생한다: 원하는 목표를 정한다. 스프링턱 덫은 그 목표에게 피해 3점을 입힌다.\', \'type\': \'마법물체\', \'flavor\': \'"가죽을 꿰뚫으려고 시도하는 건 그만둬. 가장 부드러운 부위를 공격해. 발목, 발뒤꿈치, 오금줄 같은 데 말야."\\n—사냥의 대가 체빌\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481315&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a272f021-a0a9-4edd-be3a-cd8f4a22060c\', \'multiverseId\': 481315}, \'multiverseid\': 481315}, {\'name\': \'Armadilha Molandíbula\', \'text\': \'Lampejo\\n{4}, {T}, sacrifique Armadilha Molandíbula: Ela causa 3 pontos de dano a qualquer alvo.\', \'type\': \'Artefato\', \'flavor\': \'"Pare de tentar perfurar o couro. Acerte onde ele é mais macio: no calcanhar, na sola, nos tendões."\\n— Mestre Caçador Chevill\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481574&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5b3e0475-43e6-4795-9c4b-34b20e19c33a\', \'multiverseId\': 481574}, \'multiverseid\': 481574}, {\'name\': \'Капкан\', \'text\': \'Миг\\n{4}, {T}, пожертвуйте Капкан: он наносит 3 повреждения любой цели.\', \'type\': \'Артефакт\', \'flavor\': \'«Хватит пытаться пробить ему шкуру. Надо бить в слабые места — лодыжки, ступни, сухожилия».\\n— мастер-охотник Чевилл\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481833&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0b7aefc8-9120-49c6-97d1-a6847bba0c10\', \'multiverseId\': 481833}, \'multiverseid\': 481833}, {\'name\': \'弹爪陷阱\', \'text\': \'闪现\\n{4}，{T}，牺牲弹爪陷阱：它对任意一个目标造成3点伤害。\', \'type\': \'神器\', \'flavor\': \'「别奢想这能刺穿硬皮。要指望脆弱的地方：例如脚踝、脚底或脚筋。」\\n～狩猎大师车维尔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482092&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b71ce5d9-87f1-4053-8b89-274225f92f6e\', \'multiverseId\': 482092}, \'multiverseid\': 482092}, {\'name\': \'彈爪陷阱\', \'text\': \'閃現\\n{4}，{T}，犧牲彈爪陷阱：它對任意一個目標造成3點傷害。\', \'type\': \'神器\', \'flavor\': \'「別奢想這能刺穿硬皮。要指望脆弱的地方：例如腳踝、腳底或腳筋。」\\n～狩獵大師車維爾\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482351&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1332b514-f7f0-44a1-9ea2-05e3311d6334\', \'multiverseId\': 482351}, \'multiverseid\': 482351}]', '[{\'name\': \'Schädelprophetin\', \'text\': \'{T}: Erzeuge {B} oder {G}.\\n{T}: Lege die obersten zwei Karten deiner Bibliothek auf deinen Friedhof.\', \'type\': \'Kreatur — Mensch, Druide\', \'flavor\': \'„Ich studiere Knochen, weil ihnen die Wahrheit innewohnt. Der kleinste Knochen eines Monsters besitzt mehr Weisheit als der Klumpen Fleisch in deinem Schädel."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479985&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'47a34548-12d3-4862-b75f-5c3d4acab011\', \'multiverseId\': 479985}, \'multiverseid\': 479985}, {\'name\': \'Profeta de las calaveras\', \'text\': \'{T}: Agrega {B} o {G}.\\n{T}: Pon las dos primeras cartas de tu biblioteca en tu cementerio.\', \'type\': \'Criatura — Druida humano\', \'flavor\': \'"Estudio los huesos, porque ahí mora la verdad. En los nudillos de un monstruo hay más saber que en toda la carne húmeda de tu cabeza".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480244&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5f8283f3-727e-441e-8c36-a2b26c7535e9\', \'multiverseId\': 480244}, \'multiverseid\': 480244}, {\'name\': \'Prophétesse des crânes\', \'text\': \'{T} : Ajoutez {B} ou {G}.\\n{T} : Mettez les deux cartes du dessus de votre bibliothèque dans votre cimetière.\', \'type\': \'Créature : humain et druide\', \'flavor\': "« J\'étudie les ossements parce qu\'ils renferment la vérité. Il y a plus à apprendre d\'une phalange de monstre que de la viande contenue dans votre crâne. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480503&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'02438e02-3ea3-407e-a554-a590afe3cb3f\', \'multiverseId\': 480503}, \'multiverseid\': 480503}, {\'name\': \'Profeta dei Teschi\', \'text\': \'{T}: Aggiungi {B} o {G}.\\n{T}: Metti nel tuo cimitero le prime due carte del tuo grimorio.\', \'type\': \'Creatura — Druido Umano\', \'flavor\': \'"Studio le ossa perché è lì che dimora la verità. C\\\'è più saggezza nella falange di un mostro che in tutta quella carne molliccia nella tua testa."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480762&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e4b35a8b-0de6-4fd6-82ba-7958699affbe\', \'multiverseId\': 480762}, \'multiverseid\': 480762}, {\'name\': \'髑髏の予言者\', \'text\': \'{T}：{B}か{G}を加える。\\n{T}：あなたのライブラリーの一番上からカードを２枚あなたの墓地に置く。\', \'type\': \'クリーチャー — 人間・ドルイド\', \'flavor\': \'「わしが骨を研究するのは、そこに真実が宿っているからだ。怪物の指の骨一本でも、お前の頭に詰まってる肉塊全部より賢いぞ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481021&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0b42a663-a7cb-4dda-b6ef-b97ffb27e16a\', \'multiverseId\': 481021}, \'multiverseid\': 481021}, {\'name\': \'해골 선지자\', \'text\': \'{T}: {B} 또는 {G}를 추가한다.\\n{T}: 당신의 서고 맨 위 카드 두 장을 당신의 무덤에 넣는다.\', \'type\': \'생물 — 인간 드루이드\', \'flavor\': \'"내가 뼈들을 연구하는 이유는 거기에 진실이 도사리고 있기 때문이지. 괴수의 손가락 마디뼈 한 개가 네 머리 속에 들어 있는 축축한 고기 덩어리 전체보다 더 현명하다고."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481280&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'cb3cb706-b41a-474e-9aa6-90bc5dc767f7\', \'multiverseId\': 481280}, \'multiverseid\': 481280}, {\'name\': \'Profetisa do Crânio\', \'text\': \'{T}: Adicione {B} ou {G}.\\n{T}: Coloque os dois cards do topo de seu grimório em seu cemitério.\', \'type\': \'Criatura — Humano Druida\', \'flavor\': \'"Eu estudo os ossos porque neles mora a verdade. O nó dos dedos de um monstro é mais sábio do que essa carne ensopada na sua cabeça."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481539&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'66cbf6a8-2b57-4329-9eaf-607eebdf95b3\', \'multiverseId\': 481539}, \'multiverseid\': 481539}, {\'name\': \'Прорицательница Черепов\', \'text\': \'{T}: добавьте {B} или {G}.\\n{T}: положите две верхние карты вашей библиотеки на ваше кладбище.\', \'type\': \'Существо — Человек Друид\', \'flavor\': \'«Я изучаю кости, потому что в них скрывается истина. Одна костяшка чудовища мудрее, чем весь студень в твоей голове».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481798&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f7636853-0df3-4cf0-ae8b-18811d2a831c\', \'multiverseId\': 481798}, \'multiverseid\': 481798}, {\'name\': \'占颅先知\', \'text\': \'{T}：加{B}或{G}。\\n{T}：将你牌库顶的两张牌置入你的坟墓场。\', \'type\': \'生物 ～人类／德鲁伊\', \'flavor\': \'「我研究兽骨，是因为真相留藏其中。怪兽的指节骨都比你脑壳中那团浆糊更有用。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482057&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cd7fd916-cf2d-48f2-bb09-11582630629d\', \'multiverseId\': 482057}, \'multiverseid\': 482057}, {\'name\': \'占顱先知\', \'text\': \'{T}：加{B}或{G}。\\n{T}：將你牌庫頂的兩張牌置入你的墳墓場。\', \'type\': \'生物 ～人類／德魯伊\', \'flavor\': \'「我研究獸骨，是因為真相留藏其中。怪獸的指節骨都比你腦殼中那團漿糊更有用。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482316&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b29eec5a-6ceb-4ff9-916f-26e3832fe94b\', \'multiverseId\': 482316}, \'multiverseid\': 482316}]', '[{\'name\': \'Seelenverwandtschaft\', \'text\': \'Dieser Zauberspruch kostet beim Wirken {2} weniger, falls du eine Mensch-Kreatur und eine Nicht-Mensch-Kreatur kontrollierst.\\nZiehe zwei Karten.\', \'type\': \'Hexerei\', \'flavor\': \'„*Eludha* bedeutet totale Kommunikation und totales Verständnis. Die verbale menschliche Sprache hört sich dagegen wie verstümmeltes Grunzen an."\\n—Winota, Herzbynderin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479839&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'eb4ac3bc-3607-418f-8f54-180ad2b7a3d6\', \'multiverseId\': 479839}, \'multiverseid\': 479839}, {\'name\': \'De una mente\', \'text\': \'Te cuesta {2} menos lanzar este hechizo si controlas una criatura Humano y una criatura que no sea Humano.\\nRoba dos cartas.\', \'type\': \'Conjuro\', \'flavor\': \'"La *eludha* es la comunicación total, la comprensión absoluta. Hace que la forma habitual de comunicarse de los humanos parezcan gruñidos ininteligibles".\\n—Winota, vinculacorazones\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480098&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'52bc45eb-9988-429d-b85f-526db839371c\', \'multiverseId\': 480098}, \'multiverseid\': 480098}, {\'name\': "Unité d\'esprit", \'text\': \'Ce sort coûte {2} de moins à lancer si vous contrôlez une créature Humain et une créature non-Humain.\\nPiochez deux cartes.\', \'type\': \'Rituel\', \'flavor\': "« L\'*éludha* est une forme de communication et de compréhension totale. En comparaison, le langage humain s\'apparente à des grognements. »\\n—Winota, bridecœur", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480357&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1e623079-a59e-40af-8cca-cd125d6b1e6a\', \'multiverseId\': 480357}, \'multiverseid\': 480357}, {\'name\': \'Una Sola Mente\', \'text\': \'Questa magia costa {2} in meno per essere lanciata se controlli una creatura Umano e una creatura non Umano.\\nPesca due carte.\', \'type\': \'Stregoneria\', \'flavor\': \'"L\\\'*eludha* è comunicazione e comprensione totale. Fa sembrare le parole degli umani grugniti contorti."\\n—Winota, vincolacuore\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480616&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fec25b32-f2db-4040-a7b9-020224b876de\', \'multiverseId\': 480616}, \'multiverseid\': 480616}, {\'name\': \'心を一つに\', \'text\': \'あなたが人間・クリーチャーと人間でないクリーチャーをコントロールしているなら、この呪文を唱えるためのコストは{2}少なくなる。\\nカードを２枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'「*エルーダ*は完全な意志疎通であり、完全な理解よ。普通の人間の会話が意味不明な鳴き声だと感じるぐらいに。」\\n――心眷者、ウィノータ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480875&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7cf68d95-9821-46e2-89b0-97530ae134fb\', \'multiverseId\': 480875}, \'multiverseid\': 480875}, {\'name\': \'한 마음\', \'text\': \'당신이 인간 생물 및 인간이 아닌 생물을 조종한다면 이 주문은 발동하는 데 {2}가 덜 든다.\\n카드 두 장을 뽑는다.\', \'type\': \'집중마법\', \'flavor\': \'"*엘루다*는 완전한 의사소통이자, 완전한 이해야. 평범한 인간의 언어 따위는 알아듣기 힘든 툴툴거리는 소리처럼 들리게 되지."\\n—감정유대자, 위노타\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481134&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'14f0612e-6608-42f6-a6db-3fad8605e51b\', \'multiverseId\': 481134}, \'multiverseid\': 481134}, {\'name\': \'Mentes em Uníssono\', \'text\': \'Esta mágica custa {2} a menos para ser conjurada se você controla uma criatura do tipo Humano e uma criatura que não seja um Humano.\\nCompre dois cards.\', \'type\': \'Feitiço\', \'flavor\': \'"A *eludha* é comunicação total, entendimento total. Em comparação, a fala humana não passa de um grunhido incompreensível."\\n— Winota, vinculadora de almas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481393&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'587f967b-ca34-40cb-8c68-8874666fff2f\', \'multiverseId\': 481393}, \'multiverseid\': 481393}, {\'name\': \'Единение Разумов\', \'text\': \'Разыгрывание этого заклинания стоит на {2} меньше, если вы контролируете существо-Человека и не являющееся Человеком существо.\\nВозьмите две карты.\', \'type\': \'Волшебство\', \'flavor\': \'«*Элудха* — это безграничное общение, безграничное понимание. Обычная человеческая речь по сравнению с этим — бессвязное мычание».\\n— Винота, узомантка сердца\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481652&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'88b9076d-8916-4a08-8507-d5817b90120b\', \'multiverseId\': 481652}, \'multiverseid\': 481652}, {\'name\': \'异念归一\', \'text\': \'如果你同时操控人类生物和非人类生物，则此咒语减少{2}来施放。\\n抓两张牌。\', \'type\': \'法术\', \'flavor\': \'「*灵绊*能让两者之间毫无保留地彼此沟通，相互理解。与此相比，人类之间的普通语言交流感觉就像是胡言乱语。」\\n～情念持绊人薇诺塔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481911&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f267fefb-e598-4319-ab92-8294ec3e43d6\', \'multiverseId\': 481911}, \'multiverseid\': 481911}, {\'name\': \'異念歸一\', \'text\': \'如果你同時操控人類生物和非人類生物，則此咒語減少{2}來施放。\\n抽兩張牌。\', \'type\': \'巫術\', \'flavor\': \'「*靈絆*能讓兩者之間毫無保留地彼此溝通，相互理解。與此相比，人類之間的普通語言交流感覺就像是胡言亂語。」\\n～情念持絆人薇諾塔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482170&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e0a0cc20-6e8b-4b52-8149-2a35db63d252\', \'multiverseId\': 482170}, \'multiverseid\': 482170}]', '[{\'name\': \'Segen des Wunscherfüllers\', \'text\': \'Ziehe vier Karten.\\nUmwandlung {1} ({1}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Hexerei\', \'flavor\': \'„Es gibt kein Naturgesetz, das Illuna nicht gebrochen hat. Das lässt einen fragen, was wirklich möglich ist, nicht wahr?"\\n—Rielle die Allwissende\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479822&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'88e8470c-8800-4373-92e1-9003dd1498e1\', \'multiverseId\': 479822}, \'multiverseid\': 479822}, {\'name\': \'Bendición del Otorgadeseos\', \'text\': \'Roba cuatro cartas.\\nCiclo {1}. ({1}, descartar esta carta: Roba una carta.)\', \'type\': \'Conjuro\', \'flavor\': \'"No hay ninguna ley de la naturaleza que Illuna no haya quebrantado. Hace que uno se pregunte qué es realmente posible, ¿no?".\\n—Rielle, la Versada\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480081&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a8fbbaf9-1ad1-4ffc-b2e5-c5bebee2da62\', \'multiverseId\': 480081}, \'multiverseid\': 480081}, {\'name\': "Faveur de l\'accordeur de souhaits", \'text\': \'Piochez quatre cartes.\\nRecyclage {1} ({1}, défaussez-vous de cette carte : Piochez une carte.)\', \'type\': \'Rituel\', \'flavor\': "« Aucune loi de la nature ne peut résister à la force d\'Illuna. Cela remet en question tant de choses, n\'est-ce pas ? »\\n—Rielle, l\'éternisciente", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480340&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ea3d18cf-be46-4f71-a6a0-c631f92ad85f\', \'multiverseId\': 480340}, \'multiverseid\': 480340}, {\'name\': \'Favore del Donadesideri\', \'text\': \'Pesca quattro carte.\\nCiclo {1} ({1}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Stregoneria\', \'flavor\': \'"Non esiste alcuna legge della natura che non abbia visto infrangere da Illuna. Fa riflettere su cosa sia davvero possibile, vero?"\\n—Rielle, l\\\'Onnisapiente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480599&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'69a72ce2-a9a5-4515-9007-e8d66ea78b12\', \'multiverseId\': 480599}, \'multiverseid\': 480599}, {\'name\': \'願い与えの加護\', \'text\': \'カードを４枚引く。\\nサイクリング{1}（{1}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'ソーサリー\', \'flavor\': \'「イルーナが破らなかった自然の法則など見たことがない。実際どこまで可能なのか不思議に思わないかい？」\\n――常智のリエール\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480858&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'683b727c-303c-4599-a9ed-16056b01e444\', \'multiverseId\': 480858}, \'multiverseid\': 480858}, {\'name\': \'소원을 들어주는 자의 축복\', \'text\': \'카드 네 장을 뽑는다.\\n순환 {1} ({1}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'집중마법\', \'flavor\': \'"일루나가 깨지 못한 자연의 법칙은 없다네. 진정으로 가능한 것이 무엇인지가 궁금해지지, 그렇지 않은가?"\\n—지고의 현인, 리엘\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481117&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b1231b99-939a-451e-9408-828af36034c8\', \'multiverseId\': 481117}, \'multiverseid\': 481117}, {\'name\': \'Dádiva da Realizadora de Desejos\', \'text\': \'Compre quatro cards.\\nReciclar {1} ({1}, descarte este card: Compre um card.)\', \'type\': \'Feitiço\', \'flavor\': \'"Não há lei da natureza que eu não tenha visto Illuna violar. Faz você se perguntar o que é possível, não?"\\n— Rielle, a Onissapiente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481376&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'07450747-df70-4472-99a8-0e024aab8655\', \'multiverseId\': 481376}, \'multiverseid\': 481376}, {\'name\': \'Дар Исполнителя Желаний\', \'text\': \'Возьмите четыре карты.\\nЦикл {1} ({1}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Волшебство\', \'flavor\': \'«На моих глазах Иллуна нарушал все мыслимые законы природы. Заставляет задуматься, что на самом деле возможно, а что нет, не так ли?»\\n— Риэлль, Вечномудрая\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481635&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5be6b5c1-95a3-49fe-8272-a0c93c880de2\', \'multiverseId\': 481635}, \'multiverseid\': 481635}, {\'name\': \'控念兽恩泽\', \'text\': \'抓四张牌。\\n循环{1}（{1}，弃掉此牌：抓一张牌。）\', \'type\': \'法术\', \'flavor\': \'「我亲眼见到依卢那一一打破世间诸多必然法则。你难道不好奇何事才算作『或然』吗？」\\n～全知利艾尔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481894&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fcab9206-1d05-4aee-87ee-4976a85e5b7a\', \'multiverseId\': 481894}, \'multiverseid\': 481894}, {\'name\': \'控念獸恩澤\', \'text\': \'抽四張牌。\\n循環{1}（{1}，棄掉此牌：抽一張牌。）\', \'type\': \'巫術\', \'flavor\': \'「我親眼見到依盧那一一打破世間諸多必然法則。你難道不好奇何事才算作『或然』嗎？」\\n～全知利艾爾\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482153&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3a237c92-3c1e-4128-9605-7d1e406cd84a\', \'multiverseId\': 482153}, \'multiverseid\': 482153}]', '[{\'name\': \'Sich entfaltende Wildnis\', \'text\': \'{T}, opfere die Sich entfaltende Wildnis: Durchsuche deine Bibliothek nach einer Standardland-Karte, bringe sie getappt ins Spiel und mische dann deine Bibliothek.\', \'type\': \'Land\', \'flavor\': \'„Es ist nicht schwer zu begreifen, dass dieses Land nicht uns gehört."\\n—Gavi die Nesthüterin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480026&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e972bd48-256c-4c9f-8617-20cce751b818\', \'multiverseId\': 480026}, \'multiverseid\': 480026}, {\'name\': \'Terrenos expansivos\', \'text\': \'{T}, sacrificar los Terrenos expansivos: Busca en tu biblioteca una carta de tierra básica, ponla en el campo de batalla girada y luego baraja tu biblioteca.\', \'type\': \'Tierra\', \'flavor\': \'"No es difícil entender que esta tierra no nos pertenece".\\n—Gavi, guardiana del nido\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480285&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b07b8309-9bba-48a0-99f6-33ec38ffb386\', \'multiverseId\': 480285}, \'multiverseid\': 480285}, {\'name\': \'Étendues sauvages en évolution\', \'text\': \'{T}, sacrifiez les Étendues sauvages en évolution : Cherchez dans votre bibliothèque une carte de terrain de base, mettez-la sur le champ de bataille engagée et mélangez ensuite votre bibliothèque.\', \'type\': \'Terrain\', \'flavor\': \'« Il est facile de comprendre que ce monde ne nous appartient pas. »\\n—Gavi, garde du nid\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480544&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'36d2c775-2295-42aa-bc55-8931d303aa02\', \'multiverseId\': 480544}, \'multiverseid\': 480544}, {\'name\': \'Terre Selvagge in Evoluzione\', \'text\': \'{T}, Sacrifica le Terre Selvagge in Evoluzione: Passa in rassegna il tuo grimorio per una carta terra base, mettila sul campo di battaglia TAPpata, poi rimescola il tuo grimorio.\', \'type\': \'Terra\', \'flavor\': \'"Non è difficile comprendere che questa terra non ci appartiene."\\n—Gavi, guardiana del nido\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480803&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'37545542-9b12-46db-b52e-1a019daac1ed\', \'multiverseId\': 480803}, \'multiverseid\': 480803}, {\'name\': \'進化する未開地\', \'text\': \'{T}, 進化する未開地を生け贄に捧げる：あなたのライブラリーから基本土地・カード１枚を探し、タップ状態で戦場に出し、その後あなたのライブラリーを切り直す。\', \'type\': \'土地\', \'flavor\': \'「この土地が私たちに属していないことくらい簡単に分かるわ。」\\n――巣守り、ガヴィ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481062&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e7e36645-a457-4aea-bb68-ff17eef08242\', \'multiverseId\': 481062}, \'multiverseid\': 481062}, {\'name\': \'진화하는 야생지\', \'text\': \'{T}, 진화하는 야생지를 희생한다: 당신의 서고에서 기본 대지 카드 한 장을 찾아, 탭된 채로 전장에 놓은 후, 당신의 서고를 섞는다.\', \'type\': \'대지\', \'flavor\': \'"이 땅이 우리 것이 아니라는 건 그리 어렵지 않게 알아차릴 수 있지."\\n—둥지 관리인, 가비\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481321&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ddfcc7b7-0f44-4c1f-a848-e50ce0656969\', \'multiverseId\': 481321}, \'multiverseid\': 481321}, {\'name\': \'Terras em Desenvolvimento\', \'text\': \'{T}, sacrifique Terras em Desenvolvimento: Procure um card de terreno básico em seu grimório, coloque-o no campo de batalha virado e depois embaralhe seu grimório.\', \'type\': \'Terreno\', \'flavor\': \'"Não é tão difícil entender que esta terra não nos pertence."\\n— Gavi, guardiã do ninho\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481580&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b6bcfcf3-27a2-4adc-bd5f-0c2ff8d514b3\', \'multiverseId\': 481580}, \'multiverseid\': 481580}, {\'name\': \'Перерождающиеся Дебри\', \'text\': \'{T}, пожертвуйте Перерождающиеся Дебри: найдите в вашей библиотеке карту базовой земли, положите ее на поле битвы повернутой, затем перетасуйте вашу библиотеку.\', \'type\': \'Земля\', \'flavor\': \'«Понять, что эта земля принадлежит не нам, совсем не сложно».\\n— Гави, охранница гнезда\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481839&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'40c6483f-81e9-4119-97a8-b015e76d46fa\', \'multiverseId\': 481839}, \'multiverseid\': 481839}, {\'name\': \'成形野地\', \'text\': \'{T}，牺牲成形野地：从你的牌库中搜寻一张基本地牌，将之横置放进战场，然后将你的牌库洗牌。\', \'type\': \'地\', \'flavor\': \'「不难看出这片大地并未属于我们。」\\n～巢穴护卫盖薇\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482098&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f5536f4a-1071-48a3-9850-93e3ae65d9be\', \'multiverseId\': 482098}, \'multiverseid\': 482098}, {\'name\': \'成形野地\', \'text\': \'{T}，犧牲成形野地：從你的牌庫中搜尋一張基本地牌，將之橫置放進戰場，然後將你的牌庫洗牌。\', \'type\': \'地\', \'flavor\': \'「不難看出這片大地並未屬於我們。」\\n～巢穴護衛蓋薇\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482357&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0a556173-301b-4022-abbd-67e3f5986097\', \'multiverseId\': 482357}, \'multiverseid\': 482357}]', '[{\'name\': \'Sicher behüten\', \'text\': \'Neutralisiere einen Zauberspruch deiner Wahl, der eine bleibende Karte, die du kontrollierst, als Ziel hat.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Die Kupferjacken glauben, sie verstünden etwas von Pflicht und Loyalität, aber sie können nicht die Tiefe meiner Verbindung ergründen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479835&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0f6fffa0-9853-4369-8fda-d8a0c29b8225\', \'multiverseId\': 479835}, \'multiverseid\': 479835}, {\'name\': \'Proteger\', \'text\': \'Contrarresta el hechizo objetivo que hace objetivo a un permanente que controlas.\\nRoba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'"Las Capas de Cobre creen que entienden el deber y la lealtad, pero ni siquiera pueden hacerse a la idea de la profundidad de mi vínculo".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480094&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'64e8c224-f035-4f3d-9ba3-c199b952c4b0\', \'multiverseId\': 480094}, \'multiverseid\': 480094}, {\'name\': \'Protéger\', \'text\': \'Contrecarrez le sort ciblé qui cible un permanent que vous contrôlez.\\nPiochez une carte.\', \'type\': \'Éphémère\', \'flavor\': \'« Les Capes de cuivre pensent savoir ce que sont le devoir et la loyauté, mais ils ne peuvent pas imaginer à quel point mon lien est profond. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480353&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2b3180ed-0432-4929-be81-7d0e144d9f71\', \'multiverseId\': 480353}, \'multiverseid\': 480353}, {\'name\': \'Tenere al Sicuro\', \'text\': \'Neutralizza una magia bersaglio che bersaglia un permanente che controlli.\\nPesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'"Le Giubbe Ramate credono di comprendere il senso del dovere e la lealtà, ma non riescono neppure a immaginare la profondità del mio vincolo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480612&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'09b1f28a-1e0b-4771-8272-edb82d115038\', \'multiverseId\': 480612}, \'multiverseid\': 480612}, {\'name\': \'安全維持\', \'text\': \'あなたがコントロールしているパーマネントを対象としている呪文１つを対象とし、それを打ち消す。\\nカードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': \'「銅纏いどもは使命と忠誠を解ったつもりでいるけれど、私の絆の深さを測ることはできないわ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480871&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'34682aac-c262-4f70-9cf5-964271c5e8cc\', \'multiverseId\': 480871}, \'multiverseid\': 480871}, {\'name\': \'안전 제일\', \'text\': \'당신이 조종하는 지속물을 목표로 정한 주문을 목표로 정한다. 그 주문을 무효화한다.\\n카드 한 장을 뽑는다.\', \'type\': \'순간마법\', \'flavor\': \'"구리 코트 녀석들은 자기들이 의무와 충성을 이해한다고 생각하지만, 내 유대의 깊이는 헤아릴 수조차 없을걸."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481130&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f8716f61-7420-4fac-a60f-1c242e989868\', \'multiverseId\': 481130}, \'multiverseid\': 481130}, {\'name\': \'Manter a Salvo\', \'text\': \'Anule a mágica alvo que tenha como alvo uma permanente que você controla.\\nCompre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Os Gibões de Cobre acham que entendem de dever e lealdade, mas eles não conseguem sequer imaginar a profundidade de meu vínculo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481389&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f0dd6a59-69d8-4784-bbeb-d8aaca4e9048\', \'multiverseId\': 481389}, \'multiverseid\': 481389}, {\'name\': \'Под Защитой\', \'text\': \'Отмените целевое заклинание, целью которого является перманент под вашим контролем.\\nВозьмите карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Медные Кители думают, будто знают, что такое долг и верность, но они не способны даже представить, насколько глубоки мои узы».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481648&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'087eca4d-f250-4863-b6e5-3835fa14f056\', \'multiverseId\': 481648}, \'multiverseid\': 481648}, {\'name\': \'庇护屏障\', \'text\': \'反击目标咒语，且该咒语须以由你操控的永久物为目标。\\n抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'「紫铜军以为他们了解何谓责任与忠诚，但他们根本无法理解羁绊的深度。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481907&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'64c9ac89-9506-4d6f-9728-1419f101d7d3\', \'multiverseId\': 481907}, \'multiverseid\': 481907}, {\'name\': \'庇護屏障\', \'text\': \'反擊目標咒語，且該咒語須以由你操控的永久物為目標。\\n抽一張牌。\', \'type\': \'瞬間\', \'flavor\': \'「紫銅軍以為他們瞭解何謂責任與忠誠，但他們根本無法理解羈絆的深度。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482166&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bc1f9c46-4879-40e2-a60a-cd3320e2b777\', \'multiverseId\': 482166}, \'multiverseid\': 482166}]', '[{\'name\': \'Snapdax, Apex der Jagd\', \'text\': \'Mutation {2}{B/R}{W}{W} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\nDoppelschlag\\nImmer wenn diese Kreatur mutiert, fügt sie einer Kreatur oder einem Planeswalker deiner Wahl, die bzw. den ein Gegner kontrolliert, 4 Schadenspunkte zu und du erhältst 4 Lebenspunkte dazu.\', \'type\': \'Legendäre Kreatur — Dinosaurier, Katze, Nachtmahr\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479988&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'82e2ce7d-1884-4b92-9fe1-f30844c41eaf\', \'multiverseId\': 479988}, \'multiverseid\': 479988}, {\'name\': \'Snapdax, Alfa de la Caza\', \'text\': \'Mutación {2}{B/R}{W}{W}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\nDaña dos veces.\\nSiempre que esta criatura mute, hace 4 puntos de daño a la criatura o planeswalker objetivo que controla un oponente y tú ganas 4 vidas.\', \'type\': \'Criatura legendaria — Dinosaurio felino pesadilla\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480247&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2567112c-3a3c-4cd1-ab77-747742a78d11\', \'multiverseId\': 480247}, \'multiverseid\': 480247}, {\'name\': \'Snapdax, Zénith de la chasse\', \'text\': "Mutation {2}{B/R}{W}{W} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\nDouble initiative\\nÀ chaque fois que cette créature subit une mutation, elle inflige 4 blessures à une cible, créature ou planeswalker, qu\'un adversaire contrôle et vous gagnez 4 points de vie.", \'type\': \'Créature légendaire : dinosaure et chat et cauchemar\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480506&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bb3ec180-1b01-4251-91b0-1005f648c92f\', \'multiverseId\': 480506}, \'multiverseid\': 480506}, {\'name\': \'Snapdax, Alfa della Caccia\', \'text\': \'Mutazione {2}{B/R}{W}{W} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\nDoppio attacco\\nOgniqualvolta questa creatura muta, infligge 4 danni a una creatura o a un planeswalker bersaglio controllati da un avversario e tu guadagni 4 punti vita.\', \'type\': \'Creatura Leggendaria — Incubo Felino Dinosauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480765&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'30cd2a4f-b4c9-4338-9bd5-94d02dad9834\', \'multiverseId\': 480765}, \'multiverseid\': 480765}, {\'name\': \'猟の頂点、スナップダックス\', \'text\': \'変容{2}{B/R}{W}{W}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\n二段攻撃\\nこのクリーチャーが変容するたび、対戦相手がコントロールしている、クリーチャー１体かプレインズウォーカー１体を対象とする。これはそれに４点のダメージを与え、あなたは４点のライフを得る。\', \'type\': \'伝説のクリーチャー — 恐竜・猫・ナイトメア\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481024&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6c49b5cd-2346-4f44-ae4f-0a729c9ccc51\', \'multiverseId\': 481024}, \'multiverseid\': 481024}, {\'name\': \'사냥의 정점, 스냅댁스\', \'text\': \'돌연변이화 {2}{B/R}{W}{W} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n이단공격\\n이 생물이 돌연변이화할 때마다, 상대가 조종하는 생물 또는 플레인즈워커를 목표로 정한다. 이 생물은 그 목표에게 피해 4점을 입히고 당신은 생명 4점을 얻는다.\', \'type\': \'전설적 생물 — 공룡 고양이 나이트메어\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481283&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2acbc2f7-8857-453c-ae00-585b9a3d8232\', \'multiverseId\': 481283}, \'multiverseid\': 481283}, {\'name\': \'Snapdax, Ápice da Caça\', \'text\': \'Mutação {2}{B/R}{W}{W} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\nGolpe duplo\\nToda vez que esta criatura sofre mutação, ela causa 4 pontos de dano à criatura ou ao planeswalker alvo que um oponente controla e você ganha 4 pontos de vida.\', \'type\': \'Criatura Lendária — Dinossauro Felino Pesadelo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481542&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'25e14c35-a1f9-477d-bff8-3fc7db7e2f21\', \'multiverseId\': 481542}, \'multiverseid\': 481542}, {\'name\': \'Снапдакс, Венец Охоты\', \'text\': "Мутация {2}{B/R}{W}{W} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\nДвойной удар\\nКаждый раз, когда это существо мутирует, оно наносит 4 повреждения целевому существу или planeswalker\'у под контролем оппонента, а вы получаете 4 жизни.", \'type\': \'Легендарное Существо — Динозавр Кошка Кошмар\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481801&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b99584ad-67d8-4996-ac8a-7cdfef627da5\', \'multiverseId\': 481801}, \'multiverseid\': 481801}, {\'name\': \'万猎霸虎斯达兹\', \'text\': \'合变{2}{B/R}{W}{W}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n连击\\n每当此生物合变时，它向目标由对手操控的生物或鹏洛客造成4点伤害，且你获得4点生命。\', \'type\': \'传奇生物 ～恐龙／猫／梦魇\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482060&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ba3f725e-6c14-4a42-af5a-2a4f6c2fad1c\', \'multiverseId\': 482060}, \'multiverseid\': 482060}, {\'name\': \'萬獵霸虎斯達茲\', \'text\': \'合變{2}{B/R}{W}{W}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n連擊\\n每當此生物合變時，它向目標由對手操控的生物或鵬洛客造成4點傷害，且你獲得4點生命。\', \'type\': \'傳奇生物 ～恐龍／貓／夢魘\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482319&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7ea65011-233b-44d1-95ec-305abfda8f34\', \'multiverseId\': 482319}, \'multiverseid\': 482319}]', '[{\'name\': \'Snapdax, Apex der Jagd\', \'text\': \'Mutation {2}{B/R}{W}{W}\\nDoppelschlag\\nImmer wenn diese Kreatur mutiert, fügt sie einer Kreatur oder einem Planeswalker deiner Wahl, die bzw. den ein Gegner kontrolliert, 4 Schadenspunkte zu und du erhältst 4 Lebenspunkte dazu.\', \'type\': \'Legendäre Kreatur — Dinosaurier, Katze, Nachtmahr\', \'flavor\': \'King Caesar, erwachter Titan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482394&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f6c2d49a-2fa3-4c9c-a789-4cccd1d897eb\', \'multiverseId\': 482394}, \'multiverseid\': 482394}, {\'name\': \'Snapdax, Alfa de la Caza\', \'text\': \'Mutación {2}{B/R}{W}{W}.\\nDaña dos veces.\\nSiempre que esta criatura mute, hace 4 puntos de daño a la criatura o planeswalker objetivo que controla un oponente y tú ganas 4 vidas.\', \'type\': \'Criatura legendaria — Dinosaurio felino pesadilla\', \'flavor\': \'King Caesar, titán resurgido\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482408&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'04c17a46-08f2-4455-9b11-51c5a5f22cf0\', \'multiverseId\': 482408}, \'multiverseid\': 482408}, {\'name\': \'Snapdax, Zénith de la chasse\', \'text\': "Mutation {2}{B/R}{W}{W}\\nDouble initiative\\nÀ chaque fois que cette créature subit une mutation, elle inflige 4 blessures à une cible, créature ou planeswalker, qu\'un adversaire contrôle et vous gagnez 4 points de vie.", \'type\': \'Créature légendaire : dinosaure et chat et cauchemar\', \'flavor\': \'King César, titan éveillé\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482422&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'04e4aafe-04a1-4596-ae7e-6d520ae1a938\', \'multiverseId\': 482422}, \'multiverseid\': 482422}, {\'name\': \'Snapdax, Alfa della Caccia\', \'text\': \'Mutazione {2}{B/R}{W}{W}\\nDoppio attacco\\nOgniqualvolta questa creatura muta, infligge 4 danni a una creatura o a un planeswalker bersaglio controllati da un avversario e tu guadagni 4 punti vita.\', \'type\': \'Creatura Leggendaria — Incubo Felino Dinosauro\', \'flavor\': \'King Caesar, Titano Risvegliato\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482436&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8f737b3a-d2eb-4727-90bc-34baf0056a03\', \'multiverseId\': 482436}, \'multiverseid\': 482436}, {\'name\': \'猟の頂点、スナップダックス\', \'text\': \'変容{2}{B/R}{W}{W}\\n二段攻撃\\nこのクリーチャーが変容するたび、対戦相手がコントロールしている、クリーチャー１体かプレインズウォーカー１体を対象とする。これはそれに４点のダメージを与え、あなたは４点のライフを得る。\', \'type\': \'伝説のクリーチャー — 恐竜・猫・ナイトメア\', \'flavor\': \'伝説怪獣、キングシーサー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482450&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'50cc85bb-b580-4530-aaac-48fbe4ff241c\', \'multiverseId\': 482450}, \'multiverseid\': 482450}, {\'name\': \'사냥의 정점, 스냅댁스\', \'text\': \'돌연변이화 {2}{B/R}{W}{W}\\n이단공격\\n이 생물이 돌연변이화할 때마다, 상대가 조종하는 생물 또는 플레인즈워커를 목표로 정한다. 이 생물은 그 목표에게 피해 4점을 입히고 당신은 생명 4점을 얻는다.\', \'type\': \'전설적 생물 — 공룡 고양이 나이트메어\', \'flavor\': \'깨어난 거신, 킹 카이사르\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482464&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5463cd1a-d9ee-4223-b668-30e42f7df07a\', \'multiverseId\': 482464}, \'multiverseid\': 482464}, {\'name\': \'Snapdax, Ápice da Caça\', \'text\': \'Mutação {2}{B/R}{W}{W}\\nGolpe duplo\\nToda vez que esta criatura sofre mutação, ela causa 4 pontos de dano à criatura ou ao planeswalker alvo que um oponente controla e você ganha 4 pontos de vida.\', \'type\': \'Criatura Lendária — Dinossauro Felino Pesadelo\', \'flavor\': \'King Caesar, Titã Desperto\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482478&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0fa77962-faab-4e8a-819c-087682d2e741\', \'multiverseId\': 482478}, \'multiverseid\': 482478}, {\'name\': \'Снапдакс, Венец Охоты\', \'text\': "Мутация {2}{B/R}{W}{W}\\nДвойной удар\\nКаждый раз, когда это существо мутирует, оно наносит 4 повреждения целевому существу или planeswalker\'у под контролем оппонента, а вы получаете 4 жизни.", \'type\': \'Легендарное Существо — Динозавр Кошка Кошмар\', \'flavor\': \'Кинг Сизар, Пробудившийся Титан\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482492&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5817f822-4265-4407-a328-d5e43a2bfb11\', \'multiverseId\': 482492}, \'multiverseid\': 482492}, {\'name\': \'万猎霸虎斯达兹\', \'text\': \'合变{2}{B/R}{W}{W}\\n连击\\n每当此生物合变时，它向目标由对手操控的生物或鹏洛客造成4点伤害，且你获得4点生命。\', \'type\': \'传奇生物 ～恐龙／猫／梦魇\', \'flavor\': \'觉醒巨兽西萨王\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482506&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1f37b653-3363-48dd-858c-0be6790da9e4\', \'multiverseId\': 482506}, \'multiverseid\': 482506}, {\'name\': \'萬獵霸虎斯達茲\', \'text\': \'合變{2}{B/R}{W}{W}\\n連擊\\n每當此生物合變時，它向目標由對手操控的生物或鵬洛客造成4點傷害，且你獲得4點生命。\', \'type\': \'傳奇生物 ～恐龍／貓／夢魘\', \'flavor\': \'覺醒巨獸西薩王\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482520&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1efe9948-9a0c-4880-a05a-96dc14055cf8\', \'multiverseId\': 482520}, \'multiverseid\': 482520}]', '[{\'name\': \'Spontaner Flug\', \'text\': \'Eine Kreatur deiner Wahl erhält +2/+2 bis zum Ende des Zuges. Lege eine Fliegend-Marke auf sie.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Erstaunlich! Dabei wollte ich ihr nur das Apportieren beibringen!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479812&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8e9425b5-54d1-4ecb-babd-99005f296a75\', \'multiverseId\': 479812}, \'multiverseid\': 479812}, {\'name\': \'Vuelo espontáneo\', \'text\': \'La criatura objetivo obtiene +2/+2 hasta el final del turno. Pon un contador de volar sobre ella.\', \'type\': \'Instantáneo\', \'flavor\': \'"¡Increíble! ¡Y yo que solo intentaba enseñarle a sentarse!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480071&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3158335d-25c4-4cdd-94c4-3a29718a585e\', \'multiverseId\': 480071}, \'multiverseid\': 480071}, {\'name\': \'Vol spontané\', \'text\': "La créature ciblée gagne +2/+2 jusqu\'à la fin du tour. Mettez un marqueur « vol » sur elle.", \'type\': \'Éphémère\', \'flavor\': "« Incroyable ! Et dire que je voulais seulement lui apprendre à s\'assoir ! »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480330&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f8f48fba-5808-4dc2-85d3-68ed94e6d931\', \'multiverseId\': 480330}, \'multiverseid\': 480330}, {\'name\': \'Volo Spontaneo\', \'text\': \'Una creatura bersaglio prende +2/+2 fino alla fine del turno. Metti un segnalino volare su di essa.\', \'type\': \'Istantaneo\', \'flavor\': \'"Incredibile! E stavo solo cercando di insegnarle a sedersi!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480589&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4118a0cf-0b35-4be6-a1f9-6923d1f57d2c\', \'multiverseId\': 480589}, \'multiverseid\': 480589}, {\'name\': \'突発的飛行\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋２/＋２の修整を受ける。それの上に飛行カウンターを１個置く。\', \'type\': \'インスタント\', \'flavor\': \'「すごいわ！おすわりを教えようとしていただけなのに！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480848&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'19c4fca5-304f-42b1-9347-d5451a10f122\', \'multiverseId\': 480848}, \'multiverseid\': 480848}, {\'name\': \'즉흥적인 비행\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 +2/+2를 받는다. 그 생물에 비행 카운터를 올려놓는다.\', \'type\': \'순간마법\', \'flavor\': \'"놀라워! 난 그냥 앉히려고만 했을 뿐인데!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481107&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3e316ffc-e62f-4757-aeb2-d6a337ed1648\', \'multiverseId\': 481107}, \'multiverseid\': 481107}, {\'name\': \'Voo Espontâneo\', \'text\': \'A criatura alvo recebe +2/+2 até o final do turno. Coloque um marcador de voar nela.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Incrível! E eu só queria que ela aprendesse a sentar!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481366&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7b89af3a-0789-46c5-b8ea-f3a37294e9c6\', \'multiverseId\': 481366}, \'multiverseid\': 481366}, {\'name\': \'Спонтанный Полет\', \'text\': \'Целевое существо получает +2/+2 до конца хода. Положите на него один жетон Полета.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Невероятно! А я всего-то пыталась научить ее команде "сидеть"!»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481625&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1f05a6c7-ae0e-4eb8-aa81-e0dd841b4dd3\', \'multiverseId\': 481625}, \'multiverseid\': 481625}, {\'name\': \'自生羽翼\', \'text\': \'目标生物得+2/+2直到回合结束。在其上放置一个飞行指示物。\', \'type\': \'瞬间\', \'flavor\': \'「太惊人了！我还只是想要教会她坐下！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481884&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'35347d26-f2f0-4dae-8e08-72d5a4174061\', \'multiverseId\': 481884}, \'multiverseid\': 481884}, {\'name\': \'自生羽翼\', \'text\': \'目標生物得+2/+2直到回合結束。在其上放置一個飛行指示物。\', \'type\': \'瞬間\', \'flavor\': \'「太驚人了！我還只是想要教會她坐下！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482143&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'39e99464-fbc8-4249-bbb1-c0badb7d5dd3\', \'multiverseId\': 482143}, \'multiverseid\': 482143}]', '[{\'name\': \'Springender Küstenhai\', \'text\': \'Mutation {3}{U} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\nAufblitzen\\nImmer wenn diese Kreatur mutiert, kannst du eine Kreatur deiner Wahl, die ein Gegner kontrolliert, auf die Hand ihres Besitzers zurückbringen.\', \'type\': \'Kreatur — Hai, Bestie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479843&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bd0a8533-a8ff-4a0c-b6ee-0bf801d14101\', \'multiverseId\': 479843}, \'multiverseid\': 479843}, {\'name\': \'Tiburón costero saltador\', \'text\': \'Mutación {3}{U}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\nDestello.\\nSiempre que esta criatura mute, puedes regresar la criatura objetivo que controla un oponente a la mano de su propietario.\', \'type\': \'Criatura — Bestia tiburón\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480102&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fe57ffc1-3740-4746-a0af-113cbd9237bb\', \'multiverseId\': 480102}, \'multiverseid\': 480102}, {\'name\': \'Requin-côtier bondissant\', \'text\': "Mutation {3}{U} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\nFlash\\nÀ chaque fois que cette créature subit une mutation, vous pouvez renvoyer une créature ciblée qu\'un adversaire contrôle dans la main de son propriétaire.", \'type\': \'Créature : requin et bête\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480361&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'22002869-0c2f-4e5a-a12e-39cbfba55b61\', \'multiverseId\': 480361}, \'multiverseid\': 480361}, {\'name\': \'Geosqualo Scattante\', \'text\': \'Mutazione {3}{U} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\nLampo\\nOgniqualvolta questa creatura muta, puoi far tornare una creatura bersaglio controllata da un avversario in mano al suo proprietario.\', \'type\': \'Creatura — Bestia Squalo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480620&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'757386e5-dd10-4203-8a5b-8745b6f2862f\', \'multiverseId\': 480620}, \'multiverseid\': 480620}, {\'name\': \'飛びかかる岸鮫\', \'text\': \'変容{3}{U}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\n瞬速\\nこのクリーチャーが変容するたび、対戦相手がコントロールしているクリーチャー１体を対象とする。あなたはそれをオーナーの手札に戻してもよい。\', \'type\': \'クリーチャー — サメ・ビースト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480879&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'201c98a2-1b78-4dff-b617-8a6ebf023a2b\', \'multiverseId\': 480879}, \'multiverseid\': 480879}, {\'name\': \'달려드는 해안상어\', \'text\': \'돌연변이화 {3}{U} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n섬광\\n이 생물이 돌연변이화할 때마다, 상대가 조종하는 생물을 목표로 정한다. 당신은 그 생물을 소유자의 손으로 되돌릴 수 있다.\', \'type\': \'생물 — 상어 야수\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481138&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d6429718-36a3-4117-ae49-5fcac66a9028\', \'multiverseId\': 481138}, \'multiverseid\': 481138}, {\'name\': \'Tubarão-da-costa Saltador\', \'text\': \'Mutação {3}{U} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\nLampejo\\nToda vez que esta criatura sofre mutação, você pode devolver a criatura alvo que um oponente controla para a mão de seu dono.\', \'type\': \'Criatura — Tubarão Besta\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481397&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5cb750d2-8f28-4c56-9eb9-607250fe507d\', \'multiverseId\': 481397}, \'multiverseid\': 481397}, {\'name\': \'Прыткая Береговая Акула\', \'text\': \'Мутация {3}{U} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\nМиг\\nКаждый раз, когда это существо мутирует, вы можете вернуть целевое существо под контролем оппонента в руку его владельца.\', \'type\': \'Существо — Акула Зверь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481656&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'99b38742-a8cd-4e5a-9650-8a0f01c4487a\', \'multiverseId\': 481656}, \'multiverseid\': 481656}, {\'name\': \'扑击岸鲨\', \'text\': \'合变{3}{U}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n闪现\\n每当此生物合变时，你可以将目标由对手操控的生物移回其拥有者手上。\', \'type\': \'生物 ～鲨鱼／野兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481915&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e8b35cd0-d0a4-4117-a8f5-9299026b27f5\', \'multiverseId\': 481915}, \'multiverseid\': 481915}, {\'name\': \'撲擊岸鯊\', \'text\': \'合變{3}{U}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n閃現\\n每當此生物合變時，你可以將目標由對手操控的生物移回其擁有者手上。\', \'type\': \'生物 ～鯊魚／野獸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482174&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'220d9184-f5a4-4a6f-a59f-4c482122be18\', \'multiverseId\': 482174}, \'multiverseid\': 482174}]', '[{\'name\': \'Stachelpapagei\', \'text\': \'Mutation {2}{R} (Falls du diesen Zauberspruch für seine Mutationskosten wirkst, lege ihn auf oder unter eine Nicht-Mensch-Kreatur deiner Wahl, die du besitzt. Sie mutieren zur oben liegenden Kreatur, die zusätzlich alle Fähigkeiten der darunter liegenden hat.)\\n{T}: Diese Kreatur fügt einem Ziel deiner Wahl X Schadenspunkte zu, wobei X gleich der Anzahl an Mutationen dieser Kreatur ist.\', \'type\': \'Kreatur — Vogel, Bestie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479907&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b0236154-eb82-456b-b53e-d27e57ae8758\', \'multiverseId\': 479907}, \'multiverseid\': 479907}, {\'name\': \'Loroespín\', \'text\': \'Mutación {2}{R}. (Si lanzas este hechizo pagando su coste de mutación, ponlo sobre o bajo la criatura objetivo que no sea Humano de la cual eres propietario. Estas mutan en la criatura de la parte superior más todas las habilidades de debajo.)\\n{T}: Esta criatura hace X puntos de daño a cualquier objetivo, donde X es la cantidad de veces que esta criatura ha mutado.\', \'type\': \'Criatura — Bestia ave\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480166&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fc943f0c-3dfb-45e8-ae9e-2596f69a32ce\', \'multiverseId\': 480166}, \'multiverseid\': 480166}, {\'name\': \'Psittacérisson\', \'text\': "Mutation {2}{R} (Si vous lancez ce sort pour son coût de mutation, mettez-le au-dessus ou au-dessous d\'une créature non-Humain ciblée que vous possédez. La créature mutante est la créature du dessus, avec toutes les capacités des cartes au-dessous.)\\n{T} : Cette créature inflige X blessures à n\'importe quelle cible, X étant le nombre de mutations subies par cette créature.", \'type\': \'Créature : oiseau et bête\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480425&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'944d3eef-8874-4cb0-b284-63efac5e0ee6\', \'multiverseId\': 480425}, \'multiverseid\': 480425}, {\'name\': \'Istrigallo\', \'text\': \'Mutazione {2}{R} (Se lanci questa magia per il suo costo di mutazione, mettila sopra o sotto una creatura non Umano bersaglio che possiedi. Muta nella creatura sopra, con anche le abilità di quelle sotto.)\\n{T}: Questa creatura infligge X danni a un qualsiasi bersaglio, dove X è il numero di volte che questa creatura è mutata.\', \'type\': \'Creatura — Bestia Uccello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480684&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8a9184e8-270c-443d-b8a5-db077f7b295b\', \'multiverseId\': 480684}, \'multiverseid\': 480684}, {\'name\': \'ヤマオウム\', \'text\': \'変容{2}{R}（あなたがこの呪文をこれの変容コストで唱えるなら、あなたがオーナーであり人間でないクリーチャー１体を対象とし、これをそれの上か下に置く。これらは、一番上のクリーチャーに、その下にある能力すべてを加えたものに変容する。）\\n{T}：クリーチャー１体かプレインズウォーカー１体かプレイヤー１人を対象とする。このクリーチャーはそれにＸ点のダメージを与える。Ｘはこのクリーチャーが変容した総回数に等しい。\', \'type\': \'クリーチャー — 鳥・ビースト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480943&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'91aea8c6-99af-4557-bf80-735c82dd4339\', \'multiverseId\': 480943}, \'multiverseid\': 480943}, {\'name\': \'앵무도치\', \'text\': \'돌연변이화 {2}{R} (당신이 돌연변이화 비용을 지불해 이 주문을 발동한다면, 당신이 소유한 인간이 아닌 생물을 목표로 정한다. 이 카드를 그 생물의 위 또는 아래에 놓는다. 그 생물은 맨 위에 있는 생물이 그 아래에 놓인 카드들의 모든 능력을 가진 생물로 돌연변이화한다.)\\n{T}: 원하는 목표를 정한다. 이 생물은 그 목표에게 피해 X점을 입힌다. X는 이 생물이 돌연변이화한 수이다.\', \'type\': \'생물 — 조류 야수\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481202&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ea67ae42-4ff4-430a-93fe-e1c797fcfc63\', \'multiverseId\': 481202}, \'multiverseid\': 481202}, {\'name\': \'Papagaio-espinho\', \'text\': \'Mutação {2}{R} (Se você conjurar esta mágica pelo custo de mutação, coloque-a sobre ou sob a criatura alvo que você possui que não seja um Humano. Elas sofrem uma mutação que resulta na criatura de cima com todas as habilidades das criaturas de baixo.)\\n{T}: Esta criatura causa X pontos de dano a qualquer alvo, sendo X o número de mutações desta criatura.\', \'type\': \'Criatura — Ave Besta\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481461&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4dacc00e-b590-48f5-b5c5-c8d49a8974fd\', \'multiverseId\': 481461}, \'multiverseid\': 481461}, {\'name\': \'Попугобраз\', \'text\': \'Мутация {2}{R} (Если вы разыграли это заклинание за его стоимость Мутации, положите его сверху или снизу целевого принадлежащего вам существа, не являющегося Человеком. Они мутируют в существо сверху, которому добавляются все способности снизу.)\\n{T}: это существо наносит X повреждений любой цели, где X — число мутаций этого существа.\', \'type\': \'Существо — Птица Зверь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481720&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'aced5b51-8cf3-492b-a06b-72072df37ae6\', \'multiverseId\': 481720}, \'multiverseid\': 481720}, {\'name\': \'箭羽鹦鹉\', \'text\': \'合变{2}{R}（如果你支付此咒语的合变费用来施放之，则将它放置在目标由你拥有之非人类生物的顶上或底下。它们合变作顶上的生物，外加具有底下所有异能。）\\n{T}：此生物对任意一个目标造成X点伤害，X为此生物已合变的次数。\', \'type\': \'生物 ～鸟／野兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481979&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'09f65327-a351-4a20-b05e-96489a869ec5\', \'multiverseId\': 481979}, \'multiverseid\': 481979}, {\'name\': \'箭羽鸚鵡\', \'text\': \'合變{2}{R}（如果你支付此咒語的合變費用來施放之，則將它放置在目標由你擁有之非人類生物的頂上或底下。它們合變作頂上的生物，外加具有底下所有異能。）\\n{T}：此生物對任意一個目標造成X點傷害，X為此生物已合變的次數。\', \'type\': \'生物 ～鳥／野獸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482238&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'18ec56e1-9049-4161-9247-25e96ab85ab5\', \'multiverseId\': 482238}, \'multiverseid\': 482238}]', '[{\'name\': \'Stachliges Krallenäffchen\', \'text\': \'Erstschlag\\nImmer wenn du eine Karte umwandelst, erhält das Stachlige Krallenäffchen +2/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Affe\', \'flavor\': \'„Es ist entweder verängstigt oder extrem wütend auf uns, definitiv eines von beiden."\\n—Jonald der Naturkundler\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=479908&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'497e49c4-652a-48a6-ba77-4069fa03c4ff\', \'multiverseId\': 479908}, \'multiverseid\': 479908}, {\'name\': \'Tití espinoso\', \'text\': \'Daña primero.\\nSiempre que actives una habilidad de ciclo de una carta, el Tití espinoso obtiene +2/+0 hasta el final del turno.\', \'type\': \'Criatura — Primate\', \'flavor\': \'"O está asustado o enfadadísimo con nosotros, pero, sin duda, una de las dos cosas".\\n—Jonald, naturalista de campo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480167&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0a882bd6-31ed-42c7-bdac-ab3fe8be90d2\', \'multiverseId\': 480167}, \'multiverseid\': 480167}, {\'name\': \'Marmouset piquant\', \'text\': "Initiative\\nÀ chaque fois que vous recyclez une carte, le Marmouset piquant gagne +2/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : singe\', \'flavor\': \'« Il est terrifié, ou alors il nous hait, je ne vois que ça. »\\n—Jonald, naturaliste de la mission\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480426&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b1377bad-a885-41bb-a2d6-975252ef20c6\', \'multiverseId\': 480426}, \'multiverseid\': 480426}, {\'name\': \'Marmosetta Pungente\', \'text\': \'Attacco improvviso\\nOgniqualvolta cicli una carta, la Marmosetta Pungente prende +2/+0 fino alla fine del turno.\', \'type\': \'Creatura — Scimmia\', \'flavor\': \'"Delle due l\\\'una, o è terrorizzata o estremamente furiosa con noi."\\n—Jonald, naturalista in missione\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480685&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'30c51af4-2e75-4de3-b700-f073c079bd69\', \'multiverseId\': 480685}, \'multiverseid\': 480685}, {\'name\': \'トゲマーモセット\', \'text\': \'先制攻撃\\nあなたがカードをサイクリングするたび、ターン終了時まで、トゲマーモセットは＋２/＋０の修整を受ける。\', \'type\': \'クリーチャー — 猿\', \'flavor\': \'「これは恐れているか、激昂しているか、確実にそのどちらかだ。」\\n――踏査自然主義者、ジョナルド\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480944&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'82ff134f-f11f-4030-8ed1-8b828271bd72\', \'multiverseId\': 480944}, \'multiverseid\': 480944}, {\'name\': \'가시돋친 마모셋\', \'text\': \'선제공격\\n당신이 카드를 순환할 때마다, 가시돋친 마모셋은 턴종료까지 +2/+0을 받는다.\', \'type\': \'생물 — 원숭이\', \'flavor\': \'"저건 우리한테 겁을 먹었던지 아주 화가 났던지 둘 중에 하나야. 그 외에는 없어."\\n—파견 자연술사, 조날드\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481203&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'87df704d-4d3c-4ccc-a434-e561ac0a4f30\', \'multiverseId\': 481203}, \'multiverseid\': 481203}, {\'name\': \'Sagui Espinhoso\', \'text\': \'Iniciativa\\nToda vez que você recicla um card, Sagui Espinhoso recebe +2/+0 até o final do turno.\', \'type\': \'Criatura — Macaco\', \'flavor\': \'"Ou ele está aterrorizado, ou extremamente furioso conosco. Um dos dois, sem dúvida."\\n— Jonald, naturalista da missão\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481462&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'71389c2e-b95d-4afe-83d7-88664b3a914a\', \'multiverseId\': 481462}, \'multiverseid\': 481462}, {\'name\': \'Колючая Мармозетка\', \'text\': \'Первый удар\\nКаждый раз, когда вы совершаете Цикл карты, Колючая Мармозетка получает +2/+0 до конца хода.\', \'type\': \'Существо — Мартышка\', \'flavor\': \'«Она либо ужасно напугана, либо ужасно на нас злится. Одно из двух, определенно».\\n— Джональд, натуралист экспедиции\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481721&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2cd4d518-4e45-4b1a-9571-c0d03aa23514\', \'multiverseId\': 481721}, \'multiverseid\': 481721}, {\'name\': \'带刺狨猴\', \'text\': \'先攻\\n每当你循环一张牌时，带刺狨猴得+2/+0直到回合结束。\', \'type\': \'生物 ～猴\', \'flavor\': \'「它要么是被吓坏了，要么是非常生我们的气，没有第三种可能。」\\n～实地博物学家贾纳德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481980&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3ef2e0d6-de19-4327-9602-3332ebbd8999\', \'multiverseId\': 481980}, \'multiverseid\': 481980}, {\'name\': \'帶刺狨猴\', \'text\': \'先攻\\n每當你循環一張牌時，帶刺狨猴得+2/+0直到回合結束。\', \'type\': \'生物 ～猴\', \'flavor\': \'「牠要麼是被嚇壞了，要麼是非常生我們的氣，沒有第三種可能。」\\n～實地博物學家賈納德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482239&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'cad3f4c8-795d-4629-8b63-a48d86c310a6\', \'multiverseId\': 482239}, \'multiverseid\': 482239}]', '[{\'name\': \'Stimmgewaltiger Jaulbynder\', \'text\': \'Bedrohlich\\nKreaturen mit Bedrohlichkeit, die du kontrollierst, können nicht geblockt werden, außer von jeweils drei oder mehr Kreaturen.\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': \'Der Ruf der Wildnis ist selten ein Solo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480009&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3f238f8c-10aa-40db-8511-78288d0fbfa3\', \'multiverseId\': 480009}, \'multiverseid\': 480009}, {\'name\': \'Vinculaaullidos sonoro\', \'text\': \'Amenaza.\\nCada criatura que controlas con la habilidad de amenaza no puede ser bloqueada excepto por tres o más criaturas.\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': \'La llamada de lo salvaje raramente se hace en solitario.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480268&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1020b5e5-5103-4a08-baf6-210485d19e44\', \'multiverseId\': 480268}, \'multiverseid\': 480268}, {\'name\': \'Bridecri sonore\', \'text\': \'Menace\\nChaque créature avec la menace que vous contrôlez ne peut pas être bloquée excepté par trois créatures ou plus.\', \'type\': \'Créature : humain et guerrier\', \'flavor\': "L\'appel de la nature se fait rarement d\'une seule voix.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480527&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b3afe84c-cee6-4aa1-91e9-8438cb02de28\', \'multiverseId\': 480527}, \'multiverseid\': 480527}, {\'name\': \'Vincolaululato Sonoro\', \'text\': \'Minacciare\\nOgni creatura con minacciare che controlli non può essere bloccata tranne che da tre o più creature.\', \'type\': \'Creatura — Guerriero Umano\', \'flavor\': \'Raramente il richiamo delle terre selvagge è un assolo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480786&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cb08d6c1-b31e-4ee9-9434-e6bc36288994\', \'multiverseId\': 480786}, \'multiverseid\': 480786}, {\'name\': \'堂々たる咆哮眷者\', \'text\': \'威迫\\nあなたがコントロールしていて威迫を持つ各クリーチャーはそれぞれ、３体以上のクリーチャーによってしかブロックされない。\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': \'野生の呼び声が単独であることはまれである。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481045&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1399b0f2-cc01-4b68-808f-89dd7b349474\', \'multiverseId\': 481045}, \'multiverseid\': 481045}, {\'name\': \'청아한 포효유대자\', \'text\': \'호전적\\n당신이 조종하는 호전적을 가진 생물들은 세 개 이상의 생물로만 방어될 수 있다.\', \'type\': \'생물 — 인간 전사\', \'flavor\': \'야생의 울음소리가 혼자인 경우는 극히 드물다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481304&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a95a2945-afee-4649-9cf4-98eb9868120e\', \'multiverseId\': 481304}, \'multiverseid\': 481304}, {\'name\': \'Vinculador dos Uivos Ruidoso\', \'text\': \'Ameaçar\\nCada criatura com ameaçar que você controla não pode ser bloqueada, exceto por três ou mais criaturas.\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': \'O chamado da natureza raramente é solitário.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481563&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c9ee5002-327d-42bf-b19a-745afa5496ff\', \'multiverseId\': 481563}, \'multiverseid\': 481563}, {\'name\': \'Звучный Узомант Рева\', \'text\': \'Угроза\\nКаждое существо с Угрозой под вашим контролем не может быть заблокировано менее чем тремя существами.\', \'type\': \'Существо — Человек Воин\', \'flavor\': \'Зов диких земель редко звучит в одиночку.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481822&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8d7cadcc-9a35-4ed9-b7ad-bd4fb57ce357\', \'multiverseId\': 481822}, \'multiverseid\': 481822}, {\'name\': \'彻耳音绊人\', \'text\': \'威慑\\n每个由你操控且具威慑异能的生物均只能被三个或更多生物阻挡。\', \'type\': \'生物 ～人类／战士\', \'flavor\': \'荒野呼唤极少不获应和。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482081&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4bda2e0c-549e-402f-8cf0-643625248f10\', \'multiverseId\': 482081}, \'multiverseid\': 482081}, {\'name\': \'徹耳音絆人\', \'text\': \'威懾\\n每個由你操控且具威懾異能的生物均只能被三個或更多生物阻擋。\', \'type\': \'生物 ～人類／戰士\', \'flavor\': \'荒野呼喚極少不獲應和。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482340&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a9870d42-54b9-48d0-ad35-c0ddc5e3b0e6\', \'multiverseId\': 482340}, \'multiverseid\': 482340}]', '[{\'name\': \'Stolzer Wildbynder\', \'text\': \'Verursacht Trampelschaden\\nKreaturen, die du kontrollierst und die Trampelschaden verursachen, haben „Du kannst diese Kreatur ihren Kampfschaden zuweisen lassen, als ob sie nicht geblockt worden wäre."\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': \'„Jetzt bist du noch klein, ja, aber eines Tages werden deine Schritte die Berge erzittern lassen."\\n—Gustin, Wildbynder\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480008&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'31195a4a-2946-4b30-bff2-c61c31bfdd3f\', \'multiverseId\': 480008}, \'multiverseid\': 480008}, {\'name\': \'Vinculafieras orgulloso\', \'text\': \'Arrolla.\\nLas criaturas que controlas con la habilidad de arrollar tienen "Puedes hacer que esta criatura haga su daño de combate como si no hubiera sido bloqueada".\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': \'"Ahora eres pequeña, claro, pero algún día tus pisadas harán temblar las montañas".\\n—Gustin, vinculafieras\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480267&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'475f7cb7-1508-40d1-8dbb-05c7aed8885b\', \'multiverseId\': 480267}, \'multiverseid\': 480267}, {\'name\': \'Fier bridecroissance\', \'text\': "Piétinement\\nLes créatures avec le piétinement que vous contrôlez ont « Vous pouvez faire que cette créature attribue ses blessures de combat comme si elle n\'était pas bloquée. »", \'type\': \'Créature : humain et guerrier\', \'flavor\': \'« Oui, tu es encore petit, mais un jour, tes pas feront trembler les montagnes. »\\n—Gustin, bridecroissance\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480526&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'388dbe9c-ab0a-421a-bcdd-40ff0279e085\', \'multiverseId\': 480526}, \'multiverseid\': 480526}, {\'name\': \'Vincolaferocia Fiero\', \'text\': \'Travolgere\\nLe creature con travolgere che controlli hanno "Puoi far assegnare a questa creatura il suo danno da combattimento come se non fosse bloccata".\', \'type\': \'Creatura — Guerriero Umano\', \'flavor\': \'"Ora sei piccolo, è vero, ma un giorno i tuoi passi faranno tremare le montagne."\\n—Gustin, vincolaferocia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480785&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f212b4e3-0c39-4555-b3d6-a65f7fe20162\', \'multiverseId\': 480785}, \'multiverseid\': 480785}, {\'name\': \'貫禄ある野生眷者\', \'text\': \'トランプル\\nあなたがコントロールしていてトランプルを持つクリーチャーは「あなたはこのクリーチャーの戦闘ダメージを、これがブロックされなかったかのように割り振ってもよい。」を持つ。\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': \'「確かに今の君は小さい。しかしいずれは君の一歩が山々を震わせることになるぞ。」\\n――野生眷者、ガスティン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481044&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'102f0325-33d1-43e3-89e1-0fc6b902fe51\', \'multiverseId\': 481044}, \'multiverseid\': 481044}, {\'name\': \'긍지있는 야생유대자\', \'text\': \'돌진\\n당신이 조종하는 돌진을 가진 생물들은 "당신은 이 생물의 전투피해를 이 생물이 방어되지 않은 것처럼 배정할 수 있다."를 가진다.\', \'type\': \'생물 — 인간 전사\', \'flavor\': \'"그래, 넌 지금은 작지만, 언젠가는 네 발소리가 산맥을 흔들리게 할 거야."\\n—야생유대자, 거스틴\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481303&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'984383ca-7c8c-4003-b01d-df4906afe76f\', \'multiverseId\': 481303}, \'multiverseid\': 481303}, {\'name\': \'Vinculador das Selvas Orgulhoso\', \'text\': \'Atropelar\\nAs criaturas que você controla com atropelar têm "Você pode fazer com que esta criatura atribua seu dano de combate como se não tivesse sido bloqueada.".\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': \'"Hoje você é pequeno, com certeza, mas um dia seus passos farão as montanhas tremerem."\\n— Gustin, vinculador das selvas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481562&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2e44977e-105b-492d-a6cd-4d1727504810\', \'multiverseId\': 481562}, \'multiverseid\': 481562}, {\'name\': \'Гордый Узомант Свирепости\', \'text\': \'Пробивной удар\\nСущества с Пробивным ударом под вашим контролем имеют способность «Вы можете заставить это существо распределить его боевые повреждения, как если бы оно не было заблокировано».\', \'type\': \'Существо — Человек Воин\', \'flavor\': \'«Сейчас ты невелик, это правда. Но однажды от твоей поступи будут дрожать горы».\\n— Гастин, узомант свирепости\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481821&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'27debe50-33e1-45a5-a7dd-aef42acbfdca\', \'multiverseId\': 481821}, \'multiverseid\': 481821}, {\'name\': \'心傲蛮绊人\', \'text\': \'践踏\\n由你操控且具践踏异能的生物具有「你可以让此生物如同未受阻挡地分配战斗伤害。」\', \'type\': \'生物 ～人类／战士\', \'flavor\': \'「你现在还小，但总有一天你的脚步将震撼高山。」\\n～蛮野持绊人古斯丁\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482080&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ccb5d2b8-b20b-421f-9947-6b2a363cd664\', \'multiverseId\': 482080}, \'multiverseid\': 482080}, {\'name\': \'心傲蠻絆人\', \'text\': \'踐踏\\n由你操控且具踐踏異能的生物具有「你可以讓此生物如同未受阻擋地分配戰鬥傷害。」\', \'type\': \'生物 ～人類／戰士\', \'flavor\': \'「你現在還小，但總有一天你的腳步將震撼高山。」\\n～蠻野持絆人古斯丁\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482339&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8e2ddef8-2147-4aa9-9caf-0fc446a35c51\', \'multiverseId\': 482339}, \'multiverseid\': 482339}]', "[{'name': 'Sturzbachklippen', 'text': 'Die Sturzbachklippen kommen getappt ins Spiel.\\nWenn die Sturzbachklippen ins Spiel kommen, erhältst du 1 Lebenspunkt dazu.\\n{T}: Erzeuge {U} oder {R}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480034&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'db0c5021-679d-4ac9-b834-c9c97d5b24b9', 'multiverseId': 480034}, 'multiverseid': 480034}, {'name': 'Acantilados aguasraudas', 'text': 'Los Acantilados aguasraudas entran al campo de batalla girados.\\nCuando los Acantilados aguasraudas entren al campo de batalla, ganas 1 vida.\\n{T}: Agrega {U} o {R}.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480293&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '225017ca-a252-4e9f-b436-63d6197d3843', 'multiverseId': 480293}, 'multiverseid': 480293}, {'name': 'Falaises des eaux vives', 'text': 'Les Falaises des eaux vives arrivent sur le champ de bataille engagées.\\nQuand les Falaises des eaux vives arrivent sur le champ de bataille, vous gagnez 1 point de vie.\\n{T} : Ajoutez {U} ou {R}.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480552&type=card', 'language': 'French', 'identifiers': {'scryfallId': '4cc331e5-9953-41ef-a2d3-fe11168b9ded', 'multiverseId': 480552}, 'multiverseid': 480552}, {'name': 'Rupi di Rapidacque', 'text': 'Le Rupi di Rapidacque entrano nel campo di battaglia TAPpate.\\nQuando le Rupi di Rapidacque entrano nel campo di battaglia, guadagni 1 punto vita.\\n{T}: Aggiungi {U} o {R}.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=480811&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '21993fe0-1785-46e8-beb1-5231a73d1e39', 'multiverseId': 480811}, 'multiverseid': 480811}, {'name': '急流の崖', 'text': '急流の崖はタップ状態で戦場に出る。\\n急流の崖が戦場に出たとき、あなたは１点のライフを得る。\\n{T}：{U}か{R}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481070&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ea57af5c-63ea-4fb0-bb7b-7ca6c0889077', 'multiverseId': 481070}, 'multiverseid': 481070}, {'name': '빠른물 벼랑', 'text': '빠른물 벼랑은 탭된 채로 전장에 들어온다.\\n빠른물 벼랑이 전장에 들어올 때, 당신은 생명 1점을 얻는다.\\n{T}: {U} 또는 {R}를 추가한다.', 'type': '대지', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481329&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '93fec68b-7fad-4ebd-8b10-7eecca068891', 'multiverseId': 481329}, 'multiverseid': 481329}, {'name': 'Cordilheiras das Cascatas', 'text': 'Cordilheiras das Cascatas entra no campo de batalha virado.\\nQuando Cordilheiras das Cascatas entra no campo de batalha, você ganha 1 ponto de vida.\\n{T}: Adicione {U} ou {R}.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481588&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'adb6c7ab-5263-4cad-857e-e600b350dd8b', 'multiverseId': 481588}, 'multiverseid': 481588}, {'name': 'Скальные Стремнины', 'text': 'Скальные Стремнины выходят на поле битвы повернутыми.\\nКогда Скальные Стремнины выходят на поле битвы, вы получаете 1 жизнь.\\n{T}: добавьте {U} или {R}.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=481847&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '36d1d5b5-84f0-4d58-b8bb-e2f32d06c538', 'multiverseId': 481847}, 'multiverseid': 481847}, {'name': '急流山崖', 'text': '急流山崖须横置进战场。\\n当急流山崖进战场时，你获得1点生命。\\n{T}：加{U}或{R}。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482106&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '6a018eda-f7f5-4ed6-86cc-a1371d348983', 'multiverseId': 482106}, 'multiverseid': 482106}, {'name': '急流山崖', 'text': '急流山崖須橫置進戰場。\\n當急流山崖進戰場時，你獲得1點生命。\\n{T}：加{U}或{R}。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482365&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '05053b0c-23f4-4fd6-8f21-08a6d7d24d37', 'multiverseId': 482365}, 'multiverseid': 482365}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482556&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a550eb7f-e7bc-4706-b26b-a9e924be1f0e', 'multiverseId': 482556}, 'multiverseid': 482556}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482571&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '688108de-c5cd-4dd7-85e7-96e462dc62c7', 'multiverseId': 482571}, 'multiverseid': 482571}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=482586&type=card', 'language': 'French', 'identifiers': {'scryfallId': '61a83ac2-f9ac-49c3-b4c3-a3044208ae2c', 'multiverseId': 482586}, 'multiverseid'