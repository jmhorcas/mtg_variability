type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263117&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '645aacdf-6f10-4f94-89c6-d71792ce3dc0', 'multiverseId': 263117}, 'multiverseid': 263117}, {'name': '沼澤', 'type': '基本地～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263366&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'd75605f2-67dd-452e-bd1f-d46fd3d7e664', 'multiverseId': 263366}, 'multiverseid': 263366}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263865&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd89068dd-7948-4383-9a02-7d41ef862785', 'multiverseId': 263865}, 'multiverseid': 263865}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265110&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '34a5846e-b2cf-4668-8a05-13ee92c375f3', 'multiverseId': 265110}, 'multiverseid': 265110}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263616&type=card', 'language': 'French', 'identifiers': {'scryfallId': '9f3aabc7-303e-41df-9bb7-bc5b62cdb845', 'multiverseId': 263616}, 'multiverseid': 263616}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264114&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3c455bf9-6b4d-4497-8735-6a5af47f2878', 'multiverseId': 264114}, 'multiverseid': 264114}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264363&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'b7b92682-55bb-4129-a36f-b29a36ddf9c2', 'multiverseId': 264363}, 'multiverseid': 264363}, {'name': '늪', 'type': '기본 대지 — 늪', 'flavor': None, 'language': 'Korean', 'identifiers': {'scryfallId': 'a07b77c1-47ff-44f4-8054-dcd4a34c2a4a'}, 'multiverseid': None}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264612&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '56e26d3c-e22f-4b09-bdd6-007831bdb6f0', 'multiverseId': 264612}, 'multiverseid': 264612}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264861&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'b56efba6-6dc2-4372-accb-42dbfd5c62e8', 'multiverseId': 264861}, 'multiverseid': 264861}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263118&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '3f19f9ca-9a6d-4c7a-b132-11b0e10965c7', 'multiverseId': 263118}, 'multiverseid': 263118}, {'name': '沼澤', 'type': '基本地～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263367&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'c7dfc267-dc7a-41ad-a421-e64bcfd5c9b8', 'multiverseId': 263367}, 'multiverseid': 263367}]", '[{\'name\': \'Tafelberg-Zauberin\', \'text\': \'Immer wenn du einen Verzauberungs-Zauberspruch wirkst, kannst du eine Karte ziehen.\', \'type\': \'Kreatur — Mensch, Druide\', \'flavor\': \'„Schulmeister versuchen, die Welt zu verstehen, so wie sie ist. Ich möchte die Welt in das formen, was sie sein sollte."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263649&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d2b1401a-e6f8-4468-8589-3ec6e69295de\', \'multiverseId\': 263649}, \'multiverseid\': 263649}, {\'name\': \'Encantadora de la meseta\', \'text\': \'Siempre que lances un hechizo de encantamiento, puedes robar una carta.\', \'type\': \'Criatura — Druida humano\', \'flavor\': \'"Los eruditos buscan entender cómo funciona el mundo. Yo deseo forjar un mundo que funcione como debería."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264894&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c1aa0d0b-33c8-4752-b281-580cc5d5f383\', \'multiverseId\': 264894}, \'multiverseid\': 264894}, {\'name\': \'Enchanteresse de la Mesa\', \'text\': "À chaque fois que vous lancez un sort d\'enchantement, vous pouvez piocher une carte.", \'type\': \'Créature : humain et druide\', \'flavor\': "« Les érudits cherchent à comprendre comment fonctionne le monde. Je préfère façonner le monde pour faire de lui ce qu\'il devrait être. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263400&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0d51b688-afd3-45d6-a38e-f297f012f990\', \'multiverseId\': 263400}, \'multiverseid\': 263400}, {\'name\': \'Incantatrice della Mesa\', \'text\': \'Ogniqualvolta lanci una magia incantesimo, puoi pescare una carta.\', \'type\': \'Creatura — Druido Umano\', \'flavor\': \'"Gli studiosi cercano di capire come è il mondo. Io voglio modellare il mondo in ciò che dovrebbe essere."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263898&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ef755498-84be-498b-8b56-a5fdefee5d03\', \'multiverseId\': 263898}, \'multiverseid\': 263898}, {\'name\': \'メサの女魔術師\', \'text\': \'あなたがエンチャント呪文を１つ唱えるたび、あなたはカードを１枚引いてもよい。\', \'type\': \'クリーチャー — 人間・ドルイド\', \'flavor\': \'「学者は世界の何たるかを理解しようと模索するわ。 私が望むのは、世界をあるべき姿に変えることよ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264147&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9cfa65ba-8b8a-45fb-8275-28190693b63b\', \'multiverseId\': 264147}, \'multiverseid\': 264147}, {\'name\': \'메사 여주술사\', \'text\': \'당신이 부여마법 주문을 발동할 때마다, 당신은 카드 한 장을 뽑을 수 있다.\', \'type\': \'생물 — 인간 드루이드\', \'flavor\': \'"학자는 세상의 섭리를 이해하려고 하지. 난 순리에 따라 그 섭리를 바꾸려고 한다."\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'52ab778f-c3df-4268-b818-e92a4224f631\'}, \'multiverseid\': None}, {\'name\': \'Encantadora de Meseta\', \'text\': \'Toda vez que conjura uma mágica de encantamento, você pode comprar um card.\', \'type\': \'Criatura — Humano Druida\', \'flavor\': \'"Os estudiosos tentam compreender o que o mundo é. Eu desejo moldar o mundo naquilo que ele deveria ser."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264396&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'78942eef-f9c8-4022-a364-9cdf9afaca20\', \'multiverseId\': 264396}, \'multiverseid\': 264396}, {\'name\': \'Горная Чародейка\', \'text\': \'Каждый раз когда вы разыгрываете заклинание чар, вы можете взять карту.\', \'type\': \'Существо — Человек Друид\', \'flavor\': \'«Ученые стремятся понять мир таким, какой он есть. Я же желаю сделать мир таким, каким он должен быть».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264645&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5c521aa2-3ab8-451f-b0b5-bdc9eed0fad6\', \'multiverseId\': 264645}, \'multiverseid\': 264645}, {\'name\': \'台地咒术师\', \'text\': \'每当你施放结界咒语时，你可以抓一张牌。\', \'type\': \'生物～人类／德鲁伊\', \'flavor\': \'「学者设法去理解世界的样貌。 我则想把世界变成我心中该有的样子。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262902&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bcc7efa3-4f89-45a9-9110-e02e1217ef2a\', \'multiverseId\': 262902}, \'multiverseid\': 262902}, {\'name\': \'台地咒術師\', \'text\': \'每當你施放結界咒語時，你可以抽一張牌。\', \'type\': \'生物～人類／德魯伊\', \'flavor\': \'「學者設法去理解世界的樣貌。 我則想把世界變成我心中該有的樣子。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263151&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ef913bd0-a94a-4f86-91a0-b4eb6fa3d544\', \'multiverseId\': 263151}, \'multiverseid\': 263151}]', "[{'name': 'Tag der Abrechnung', 'text': 'Zerstöre alle Kreaturen.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263636&type=card', 'language': 'German', 'identifiers': {'scryfallId': '135da739-94ee-46aa-8894-1dbf0b9db420', 'multiverseId': 263636}, 'multiverseid': 263636}, {'name': 'Día del juicio final', 'text': 'Destruye todas las criaturas.', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264881&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '9db6846f-d91c-45c1-a217-ffd387fe0b50', 'multiverseId': 264881}, 'multiverseid': 264881}, {'name': 'Jour de condamnation', 'text': 'Détruisez toutes les créatures.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263387&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'aea07f16-56b9-4683-8a32-5f8b8eeb0b00', 'multiverseId': 263387}, 'multiverseid': 263387}, {'name': 'Giorno del Castigo', 'text': 'Distruggi tutte le creature.', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263885&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'aab5ec7f-cc28-4d49-94ea-dd975bf70e0a', 'multiverseId': 263885}, 'multiverseid': 263885}, {'name': '審判の日', 'text': 'すべてのクリーチャーを破壊する。', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264134&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '473e590f-2333-4c0f-b2a9-47e21abb58e9', 'multiverseId': 264134}, 'multiverseid': 264134}, {'name': '심판의 날', 'text': '모든 생물을 파괴한다.', 'type': '집중마법', 'flavor': None, 'language': 'Korean', 'identifiers': {'scryfallId': '373293b9-09bd-4268-9225-2b347a66c3bb'}, 'multiverseid': None}, {'name': 'Dia do Julgamento', 'text': 'Destrua todas as criaturas.', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264383&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'babcc8ab-777f-474f-b142-1bf5d9abfb9a', 'multiverseId': 264383}, 'multiverseid': 264383}, {'name': 'Судный День', 'text': 'Уничтожьте все существа.', 'type': 'Волшебство', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264632&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '47a2ea15-471a-4abd-a2f5-6c5496adbcff', 'multiverseId': 264632}, 'multiverseid': 264632}, {'name': '审判末日', 'text': '消灭所有生物。', 'type': '法术', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262889&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '1b98fac5-3be0-4958-a24f-038a97da133b', 'multiverseId': 262889}, 'multiverseid': 262889}, {'name': '審判末日', 'text': '消滅所有生物。', 'type': '巫術', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263138&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'b2465b88-de2c-4277-954c-b80c9284468b', 'multiverseId': 263138}, 'multiverseid': 263138}]", '[{\'name\': \'Tektonische Spalte\', \'text\': \'Zerstöre ein Land deiner Wahl. Nichtfliegende Kreaturen können in diesem Zug nicht blocken.\', \'type\': \'Hexerei\', \'flavor\': \'„Du wirst vor mir niederknien, und wenn ich dafür die Erde unter deinen Füßen wegreißen muss." —Ash Kronor, Keldonischer Kriegsfürst\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263781&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'91470186-bdd2-4f12-a331-2930cb78417a\', \'multiverseId\': 263781}, \'multiverseid\': 263781}, {\'name\': \'Falla tectónica\', \'text\': \'Destruye la tierra objetivo. Las criaturas sin la habilidad de volar no pueden bloquear este turno.\', \'type\': \'Conjuro\', \'flavor\': \'"¡Te arrodillarás ante mí, incluso si tengo que partir la tierra bajo tus pies!" —Ash Krónor, señor guerrero de Keldon\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265026&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'aea02473-75df-4c42-a4f5-5a8ebcbcafc7\', \'multiverseId\': 265026}, \'multiverseid\': 265026}, {\'name\': \'Faille tectonique\', \'text\': \'Détruisez le terrain ciblé. Les créatures sans le vol ne peuvent pas bloquer ce tour-ci.\', \'type\': \'Rituel\', \'flavor\': "« Tu t\'agenouilleras devant moi, même si je dois pour cela fendre la terre sous tes pieds ! » —Ash Kronor, seigneur de guerre kelde", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263532&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7c4ed324-0a1e-4942-86b8-31bceaf154f8\', \'multiverseId\': 263532}, \'multiverseid\': 263532}, {\'name\': \'Fossa Tettonica\', \'text\': \'Distruggi una terra bersaglio. Le creature senza volare non possono bloccare in questo turno.\', \'type\': \'Stregoneria\', \'flavor\': \'"Ti inginocchierai davanti a me, a costo di spaccarti la terra sotto i piedi!" —Ash Kronor, signore della guerra Keldon\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264030&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d3eaf3da-e015-4352-906e-12c88c6572c5\', \'multiverseId\': 264030}, \'multiverseid\': 264030}, {\'name\': \'地盤の裂け目\', \'text\': \'土地１つを対象とし、それを破壊する。 このターン、飛行を持たないクリーチャーではブロックできない。\', \'type\': \'ソーサリー\', \'flavor\': \'「俺がお前の足元の大地を割らざるを得なかったとしても、お前は俺の前にひざまずく事になるのだ！」 ――ケルドの大将軍、アシュ・クロノー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264279&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'60242613-ca4f-48ec-97ca-4855e4e7d63e\', \'multiverseId\': 264279}, \'multiverseid\': 264279}, {\'name\': \'지면 균열\', \'text\': \'대지 한 개를 목표로 정해서 파괴한다. 비행 능력이 없는 생물은 이 턴에 방어할 수 없다.\', \'type\': \'집중마법\', \'flavor\': \'"네 발밑의 땅을 갈라지게 해서라도 널 내 앞에 무릎 꿇게 하겠다!"—켈드의 패왕 애쉬 크로노르\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3843d7ab-3717-40a6-834e-fd1c8f6c5058\'}, \'multiverseid\': None}, {\'name\': \'Fenda Tectônica\', \'text\': \'Destrua o terreno alvo. As criaturas sem voar não podem bloquear neste turno.\', \'type\': \'Feitiço\', \'flavor\': \'"Você se ajoelhará aos meus pés, mesmo que para isso eu tenha de partir ao meio a terra em que você pisa!" — Ash Kronor, comandante keldoniano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264528&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e293f03d-06fd-4085-9c35-56b8f6a6ff95\', \'multiverseId\': 264528}, \'multiverseid\': 264528}, {\'name\': \'Тектонический Разлом\', \'text\': \'Уничтожьте целевую землю. Существа без Полета не могут блокировать в этом ходу.\', \'type\': \'Волшебство\', \'flavor\': \'«Ты преклонишь предо мной колена, даже если для этого мне потребуется расколоть землю у тебя под ногами!» — Аш Кронор, келдонский военачальник\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264777&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d479020a-fb18-45c4-8c92-955764e045ff\', \'multiverseId\': 264777}, \'multiverseid\': 264777}, {\'name\': \'地壳迸裂\', \'text\': \'消灭目标地。 不具飞行异能的生物本回合不能进行阻挡。\', \'type\': \'法术\', \'flavor\': \'「就算我得把你脚下的土地挖掉，也要让你向我屈膝！」 ～凯尔顿军头艾许孔诺\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263034&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5a70a64d-1502-4b15-a984-95ae206930a0\', \'multiverseId\': 263034}, \'multiverseid\': 263034}, {\'name\': \'地殼迸裂\', \'text\': \'消滅目標地。 不具飛行異能的生物本回合不能進行阻擋。\', \'type\': \'巫術\', \'flavor\': \'「就算我得把你腳下的土地挖掉，也要讓你向我屈膝！」 ～凱爾頓軍頭艾許孔諾\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263283&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'cf2363fa-eae1-483b-95f8-7a551bb43691\', \'multiverseId\': 263283}, \'multiverseid\': 263283}]', '[{\'name\': \'Teuflischer Lehrmeister\', \'text\': \'Durchsuche deine Bibliothek nach einer Karte und nimm diese Karte auf deine Hand. Mische danach deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': \'Die Weisen haben immer ein Ohr für die Einflüsterungen der Macht offen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263716&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'88be227e-8fc3-45b0-a8b7-43ad64734920\', \'multiverseId\': 263716}, \'multiverseid\': 263716}, {\'name\': \'Tutor diabólico\', \'text\': \'Busca una carta de tu biblioteca y pon esa carta en tu mano. Luego baraja tu biblioteca.\', \'type\': \'Conjuro\', \'flavor\': \'Los sabios mantienen siempre un oído abierto a los susurros del poder.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264961&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2a53a116-c0e5-47f6-8847-cf3e85e3cb4a\', \'multiverseId\': 264961}, \'multiverseid\': 264961}, {\'name\': \'Précepteur démoniaque\', \'text\': \'Cherchez une carte dans votre bibliothèque et mettez cette carte dans votre main. Mélangez ensuite votre bibliothèque.\', \'type\': \'Rituel\', \'flavor\': "Les sages tendent toujours l\'oreille aux chuchotements du pouvoir.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263467&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2675e765-52e9-41c6-a164-82b416072d8b\', \'multiverseId\': 263467}, \'multiverseid\': 263467}, {\'name\': \'Tutore Diabolico\', \'text\': \'Passa in rassegna il tuo grimorio per una carta e aggiungila alla tua mano. Poi rimescola il tuo grimorio.\', \'type\': \'Stregoneria\', \'flavor\': \'I saggi tengono sempre un orecchio aperto ai sussurri del potere.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263965&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d03c3a17-2f59-4b68-b163-5fb105017eb2\', \'multiverseId\': 263965}, \'multiverseid\': 263965}, {\'name\': \'魔性の教示者\', \'text\': \'あなたのライブラリーからカードを１枚探し、そのカードをあなたの手札に加える。 その後あなたのライブラリーを切り直す。\', \'type\': \'ソーサリー\', \'flavor\': \'賢き者は、常に力の囁きに耳を傾ける。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264214&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'934845a9-2bd8-4195-8c92-216c4b96cd5d\', \'multiverseId\': 264214}, \'multiverseid\': 264214}, {\'name\': \'극악한 자의 가르침\', \'text\': \'당신의 서고에서 원하는 카드 한 장을 찾아 당신의 손으로 가져간다. 그리고 나서 당신의 서고를 섞는다.\', \'type\': \'집중마법\', \'flavor\': \'현명한 자들은 언제나 힘의 속삭임에 귀를 기울인다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7f87534e-0c90-441c-ae82-1b6a76ea3b64\'}, \'multiverseid\': None}, {\'name\': \'Tutor Diabólico\', \'text\': \'Procure um card em seu grimório e coloque aquele card em sua mão. Depois, embaralhe seu grimório.\', \'type\': \'Feitiço\', \'flavor\': \'Os sábios estão sempre atentos aos sussurros do poder.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264463&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a6494692-cb6b-4ec4-8b2c-736f638375f6\', \'multiverseId\': 264463}, \'multiverseid\': 264463}, {\'name\': \'Дьявольский Наставник\', \'text\': \'Найдите в вашей библиотеке карту и положите ту карту в вашу руку. Затем перетасуйте вашу библиотеку.\', \'type\': \'Волшебство\', \'flavor\': \'Мудрые всегда прислушиваются к шепоту власти.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264712&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ffc01b70-cab5-4878-8111-e260201415ae\', \'multiverseId\': 264712}, \'multiverseid\': 264712}, {\'name\': \'恶魔导师\', \'text\': \'从你的牌库中搜寻一张牌并置于你手上。 然后将你的牌库洗牌。\', \'type\': \'法术\', \'flavor\': \'智者总不忘留神倾听力量的细语。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262969&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'23f140ae-422d-4128-b96d-5fb8970b3f25\', \'multiverseId\': 262969}, \'multiverseid\': 262969}, {\'name\': \'惡魔導師\', \'text\': \'從你的牌庫中搜尋一張牌並置於你手上。 然後將你的牌庫洗牌。\', \'type\': \'巫術\', \'flavor\': \'智者總不忘留神傾聽力量的細語。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263218&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'15851504-4adf-4fa3-a0c1-acfe5b31f11c\', \'multiverseId\': 263218}, \'multiverseid\': 263218}]', '[{\'name\': \'Thran-Golem\', \'text\': \'Solange der Thran-Golem verzaubert ist, erhält er +2/+2, Flugfähigkeit sowie Erstschlag und verursacht Trampelschaden.\', \'type\': \'Artefaktkreatur — Golem\', \'flavor\': \'Die Golems der alten Thran-Zivilisation zapfen immer noch Energiequellen an — ganz zur Überraschung der Tüftler der aktuellen Generation.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263844&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'336d3901-7838-4c0b-ac55-4192130f49fc\', \'multiverseId\': 263844}, \'multiverseid\': 263844}, {\'name\': \'Gólem thran\', \'text\': \'Mientras el Gólem thran esté encantado, obtiene +2/+2 y tiene las habilidades de volar, dañar primero y arrollar.\', \'type\': \'Criatura artefacto — Gólem\', \'flavor\': \'Los gólems de los antiguos Thran todavía obtienen poder de maneras que confunden a los artífices de hoy.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265089&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'357548a6-5a0a-4402-a0f2-aa75d61fc08b\', \'multiverseId\': 265089}, \'multiverseid\': 265089}, {\'name\': \'Golem thran\', \'text\': "Tant que le Golem thran est enchanté, il gagne +2/+2 et il a le vol, l\'initiative et le piétinement.", \'type\': \'Créature-artefact : golem\', \'flavor\': "Les golems de la Thran antique puisent toujours l\'énergie d\'une manière qui échappe aux artificiers d\'aujourd\'hui.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263595&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ed77d2c7-f394-4c15-8276-b16692546e86\', \'multiverseId\': 263595}, \'multiverseid\': 263595}, {\'name\': \'Golem Thran\', \'text\': \'Fintanto che il Golem Thran è incantato, prende +2/+2 e ha volare, attacco improvviso e travolgere.\', \'type\': \'Creatura Artefatto — Golem\', \'flavor\': \'I golem degli antichi Thran attingono ancora potere in modi che sconcertano gli artefici dei giorni nostri.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264093&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5e0e77f2-162e-4d59-b30b-6c96c7ba5840\', \'multiverseId\': 264093}, \'multiverseid\': 264093}, {\'name\': \'スランのゴーレム\', \'text\': \'スランのゴーレムがエンチャントされているかぎり、それは＋２/＋２の修整を受けるとともに飛行と先制攻撃とトランプルを持つ。\', \'type\': \'アーティファクト・クリーチャー — ゴーレム\', \'flavor\': \'古代スランのゴーレムは、現在の工匠が理解できない仕組みで力を得ている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264342&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'32947baf-216e-4e17-b24b-9d7841369501\', \'multiverseId\': 264342}, \'multiverseid\': 264342}, {\'name\': \'트란 골렘\', \'text\': \'트란 골렘에게 마법진이 부여되어 있는 동안, 트란 골렘은 +2/+2를 받고, 비행과 선제공격과 돌진 능력을 가진다.\', \'type\': \'마법물체 생물 — 골렘\', \'flavor\': \'고대 트란 문명의 골렘들은 오늘날의 기능공들조차 이해할 수 없는 방법으로 힘을 끌어낸다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d8136cc3-9432-493c-8331-82eacfec8e3e\'}, \'multiverseid\': None}, {\'name\': \'Golem Thran\', \'text\': \'Enquanto Golem Thran estiver encantado, ele receberá +2/+2 e terá voar, iniciativa e atropelar.\', \'type\': \'Criatura Artefato — Golem\', \'flavor\': \'Os golens da antiga Thran ainda extraem poder de modos que deixam perplexos os artesãos de hoje.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264591&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2a6f628d-6ee4-4d93-aab0-3ebd17a44e36\', \'multiverseId\': 264591}, \'multiverseid\': 264591}, {\'name\': \'Транский Голем\', \'text\': \'Пока Транский Голем зачарован, он получает +2/+2 и имеет Полет, Первый удар и Пробивной удар.\', \'type\': \'Артефактное Существо — Голем\', \'flavor\': \'Големы древних транов до сих пор набирают силу, озадачивая современных мастеров.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264840&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'50e032b3-355b-4255-a82f-8a37ff685d02\', \'multiverseId\': 264840}, \'multiverseid\': 264840}, {\'name\': \'索蓝魔像\', \'text\': \'只要索蓝魔像被结附，它便得+2/+2并具有飞行、先攻和践踏异能。\', \'type\': \'神器生物～魔像\', \'flavor\': \'古老索蓝帝国的魔像是用什么方法得以不断获取能量至今，仍是当代神器师未解之谜。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263097&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9fee36a7-8ecf-4f24-bd89-ba6a5bdce625\', \'multiverseId\': 263097}, \'multiverseid\': 263097}, {\'name\': \'索藍魔像\', \'text\': \'只要索藍魔像被結附，它便得+2/+2並具有飛行、先攻和踐踏異能。\', \'type\': \'神器生物～魔像\', \'flavor\': \'古老索藍帝國的魔像是用什麼方法得以不斷獲取能量至今，仍是當代神器師未解之謎。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263346&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ecb27ec8-b512-47c0-ac04-eebc40ab425f\', \'multiverseId\': 263346}, \'multiverseid\': 263346}]', '[{\'name\': \'Thron der Kaiserreiche\', \'text\': \'{1}, {T}: Bringe einen 1/1 weißen Soldat-Kreaturenspielstein ins Spiel. Bringe stattdessen fünf dieser Spielsteine ins Spiel, falls du Artefakte namens Krone der Kaiserreiche und Zepter der Kaiserreiche kontrollierst.\', \'type\': \'Artefakt\', \'flavor\': \'„Mit diesem Thron eint Ihr Eure Nation." —Gravur des Throns\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263845&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d3b040f8-8d18-4b4a-8038-2a0de2dbe9cf\', \'multiverseId\': 263845}, \'multiverseid\': 263845}, {\'name\': \'Trono de los imperios\', \'text\': \'{1}, {T}: Pon en el campo de batalla una ficha de criatura Soldado blanca 1/1. En vez de eso, pon en el campo de batalla cinco de esas fichas si controlas artefactos llamados Corona de los imperios y Cetro de los imperios.\', \'type\': \'Artefacto\', \'flavor\': \'"Con este trono, une tu nación." —Inscripción en el trono\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265090&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'74dfc5dc-6e86-4aa7-970f-3ec780199059\', \'multiverseId\': 265090}, \'multiverseid\': 265090}, {\'name\': "Trône d\'empires", \'text\': "{1}, {T} : Mettez sur le champ de bataille un jeton de créature 1/1 blanche Soldat. Mettez sur le champ de bataille cinq de ces jetons à la place si vous contrôlez des artefacts appelés Couronne d\'empires et Sceptre d\'empires.", \'type\': \'Artefact\', \'flavor\': \'« Avec ce trône, unis ta nation. » —Inscription du trône\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263596&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5b685064-961e-408d-89b8-b02c19570654\', \'multiverseId\': 263596}, \'multiverseid\': 263596}, {\'name\': \'Trono degli Imperi\', \'text\': \'{1}, {T}: Metti sul campo di battaglia una pedina creatura Soldato 1/1 bianca. Metti invece sul campo di battaglia cinque di quelle pedine se controlli degli artefatti chiamati Corona degli Imperi e Scettro degli Imperi.\', \'type\': \'Artefatto\', \'flavor\': \'"Con questo trono, unisci la tua nazione." —Iscrizione sul trono\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264094&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d54bf4b2-ff6c-4c8e-a3a6-f4f47f973429\', \'multiverseId\': 264094}, \'multiverseid\': 264094}, {\'name\': \'帝国の玉座\', \'text\': \'{1}, {T}：白の１/１の兵士・クリーチャー・トークンを１体戦場に出す。 あなたが「帝国の王冠」という名前のアーティファクトと「帝国の王笏」と言う名前のアーティファクトをコントロールしている場合、代わりにそのトークンを５体出す。\', \'type\': \'アーティファクト\', \'flavor\': \'「この玉座あらば、お前の国家は統一さる。」 ――玉座の銘文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264343&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4a00b934-f53f-43a7-923e-9e82226fac9b\', \'multiverseId\': 264343}, \'multiverseid\': 264343}, {\'name\': \'제국의 왕좌\', \'text\': \', : 1/1 백색 병사 생물 토큰 한 개를 전장에 놓는다. 당신이 제국의 왕관이라 명명된 마법물체와 제국의 왕홀이라 명명된 마법물체를 조종한다면, 그 대신에 그런 토큰 다섯 개를 전장에 놓는다.\', \'type\': \'마법물체\', \'flavor\': \'"이 왕좌를 가지고 국가를 통일할지어다."—왕좌조문\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e7020b90-5094-403a-9c18-a1c099ed066c\'}, \'multiverseid\': None}, {\'name\': \'Trono dos Impérios\', \'text\': \'{1}, {T}: Coloque no campo de batalha uma ficha de criatura branca 1/1 do tipo Soldado. Se você controlar artefatos com os nomes Coroa dos Impérios e Cetro dos Impérios, em vez disso, coloque no campo de batalha cinco dessas fichas.\', \'type\': \'Artefato\', \'flavor\': \'"Com este trono, una a sua nação." — Inscrição do trono\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264592&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a09ee44b-9bda-45da-bd7f-643d76d374c9\', \'multiverseId\': 264592}, \'multiverseid\': 264592}, {\'name\': \'Престол Империй\', \'text\': \'{1}, {T}: положите на поле битвы одну фишку существа 1/1 белый Солдат. Положите на поле битвы пять таких фишек вместо этого, если вы контролируете артефакты с именами Корона Империй и Скипетр Империй.\', \'type\': \'Артефакт\', \'flavor\': \'«Этим престолом объедини свою нацию». — надпись на престоле\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264841&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'28d7a260-8b9c-4d69-80a8-1347ed5227ee\', \'multiverseId\': 264841}, \'multiverseid\': 264841}, {\'name\': \'帝国王座\', \'text\': \'{1}，{T}：将一个1/1白色士兵衍生生物放进战场。 如果你操控名称为帝国冠冕以及帝国权杖的神器，则改为将五个上述的衍生物放进战场。\', \'type\': \'神器\', \'flavor\': \'「此座许你一统大业。」 ～王座铭文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263098&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'636882f0-ad83-49b3-b549-bfcf66c012ae\', \'multiverseId\': 263098}, \'multiverseid\': 263098}, {\'name\': \'帝國王座\', \'text\': \'{1}，{T}：將一個1/1白色士兵衍生生物放進戰場。 如果你操控名稱為帝國冠冕以及帝國權杖的神器，則改為將五個上述的衍生物放進戰場。\', \'type\': \'神器\', \'flavor\': \'「此座許你一統大業。」 ～王座銘文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263347&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'33e9e2ba-90af-42a8-9ab1-e60d8bc3fcce\', \'multiverseId\': 263347}, \'multiverseid\': 263347}]', '[{\'name\': \'Titanisches Wachstum\', \'text\': \'Eine Kreatur deiner Wahl erhält +4/+4 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'Der Welpe blickte über die Baumspitzen und entdeckte den Mann, der ihn gestern noch getreten hatte. Plötzlich hatte er nicht nur Hunger, sondern auch Spaß daran.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263822&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'374e39a2-383e-467a-be5b-ac2c70cb79c8\', \'multiverseId\': 263822}, \'multiverseid\': 263822}, {\'name\': \'Crecimiento titánico\', \'text\': \'La criatura objetivo obtiene +4/+4 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'El cachorro miró sobre los árboles, y encontró al hombre que lo había pateado ayer. De pronto, su hambre se tornó en alegría.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265067&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1b12be4c-2807-4c9b-b22d-0281ecb7c599\', \'multiverseId\': 265067}, \'multiverseid\': 265067}, {\'name\': \'Croissance titanesque\', \'text\': "La créature ciblée gagne +4/+4 jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': "Le regard du chiot s\'abattit sur l\'homme qui l\'avait frappé la veille. Soudain, sa faim se mua en pur sentiment de délice.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263573&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5f26fba0-3f62-4e2c-8245-3667c5379b01\', \'multiverseId\': 263573}, \'multiverseid\': 263573}, {\'name\': \'Crescita Titanica\', \'text\': \'Una creatura bersaglio prende +4/+4 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': "La cucciola guardò sopra la cima degli alberi, fissando l\'uomo che solo ieri l\'aveva presa a calci. Improvvisamente, nella sua fame si instillò il più puro diletto.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264071&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'43040746-aa8e-4c25-a4d2-912d3fa30abc\', \'multiverseId\': 264071}, \'multiverseid\': 264071}, {\'name\': \'剛力化\', \'text\': \'クリーチャー１体を対象とする。それはターン終了時まで＋４/＋４の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'子犬は樹上越しに見下ろした。そこにいたのは、昨日自分を蹴飛ばした男だった。 突然、純粋な喜びが子犬の飢えに火をつけた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264320&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'47a21906-a750-4f8a-bb8a-b3c6e145da73\', \'multiverseId\': 264320}, \'multiverseid\': 264320}, {\'name\': \'폭풍성장\', \'text\': \'생물 한 개를 목표로 정한다. 그 생물은 턴종료까지 +4/+4를 받는다.\', \'type\': \'순간마법\', \'flavor\': \'새끼 이리는 우둠지 너머로 어제 그녀를 걷어찬 인간을 발견했다. 그러자 사악한 웃음이 이리의 얼굴에 번졌다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6caddcd6-a378-4e1b-980b-040ef6c8833b\'}, \'multiverseid\': None}, {\'name\': \'Crescimento Titânico\', \'text\': \'A criatura alvo recebe +4/+4 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'O cachorrinho olhou por cima das copas das árvores, observando aquele homem que ontem mesmo havia lhe dado um chute. De repente, sua fome encheu-se de pura satisfação.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264569&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'35641725-f6ff-4e71-99ce-ad91831a3062\', \'multiverseId\': 264569}, \'multiverseid\': 264569}, {\'name\': \'Титанический Рост\', \'text\': \'Целевое существо получает +4/+4 до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Волчонок посмотрел вниз через верхушки деревьев на человека, который только вчера дал ему пинка. Внезапно к его голоду примешалось ощущение чистого восторга.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264818&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a990cdf8-6a0e-43cd-a906-6479b6d9a304\', \'multiverseId\': 264818}, \'multiverseid\': 264818}, {\'name\': \'巨力成长\', \'text\': \'目标生物得+4/+4直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'幼兽向树顶张望，看到昨天踢她一脚的那个人。 突然间，纯粹喜悦鼓舞了她的饥饿感。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263075&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'07a55ad6-3dcd-4551-90e6-e5483127dfd0\', \'multiverseId\': 263075}, \'multiverseid\': 263075}, {\'name\': \'巨力成長\', \'text\': \'目標生物得+4/+4直到回合結束。\', \'type\': \'瞬間\', \'flavor\': \'幼獸向樹頂張望，看到昨天踢她一腳的那個人。 突然間，純粹喜悅鼓舞了她的飢餓感。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263324&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f192e926-f8a3-433f-95a3-7ac771880656\', \'multiverseId\': 263324}, \'multiverseid\': 263324}]', '[{\'name\': \'Todeszeichen\', \'text\': \'Zerstöre eine grüne oder weiße Kreatur deiner Wahl.\', \'type\': \'Hexerei\', \'flavor\': \'„Der Anblick ihres Tods soll auf ihren starren Augen eingraviert bleiben." —Zul Ashur, Lichfürst\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263714&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'79e4aaca-b3c5-4c1e-a049-3d048efe627a\', \'multiverseId\': 263714}, \'multiverseid\': 263714}, {\'name\': \'Marca mortal\', \'text\': \'Destruye la criatura objetivo verde o blanca.\', \'type\': \'Conjuro\', \'flavor\': \'"Que la visión final de su perdición quede grabada en sus ojos sin párpado." —Zul Ashur, señor liche\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264959&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'749e276a-5cd7-4371-a8be-4b9d73a28adb\', \'multiverseId\': 264959}, \'multiverseid\': 264959}, {\'name\': \'Mortemarque\', \'text\': \'Détruisez la créature verte ou blanche ciblée.\', \'type\': \'Rituel\', \'flavor\': "« Que l\'ultime vision du destin final soit gravée sur leurs yeux écarquillés. » —Zul Ashur, seigneur liche", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263465&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5e496187-0b85-4293-ab8c-ee9fcc5bb664\', \'multiverseId\': 263465}, \'multiverseid\': 263465}, {\'name\': \'Marchiare a Morte\', \'text\': \'Distruggi una creatura verde o bianca bersaglio.\', \'type\': \'Stregoneria\', \'flavor\': \'"Che la visione finale del destino sia impressa nei loro occhi impassibili." —Zul Ashur, signore dei lich\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263963&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'478a4482-6ce7-4c15-ab5f-08478d6cac0e\', \'multiverseId\': 263963}, \'multiverseid\': 263963}, {\'name\': \'死の印\', \'text\': \'緑か白のクリーチャー１体を対象とし、それを破壊する。\', \'type\': \'ソーサリー\', \'flavor\': \'「その瞬きせぬ目の上に、最後の破滅の像を刻むがよい」 ――死者の王、ザル・アシュール\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264212&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'042f5a3a-1c1f-4c32-9cee-a7e1d41bf00f\', \'multiverseId\': 264212}, \'multiverseid\': 264212}, {\'name\': \'Mancha da Morte\', \'text\': \'Destrua a criatura alvo verde ou branca.\', \'type\': \'Feitiço\', \'flavor\': \'"Que a visão final da perdição seja gravada em seus olhos eternamente abertos." — Zul Ashur, senhor lich\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264461&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'468c78fe-9f86-44e5-80c9-562ca57a73e5\', \'multiverseId\': 264461}, \'multiverseid\': 264461}, {\'name\': \'Метка Смерти\', \'text\': \'Уничтожьте целевое зеленое или белое существо.\', \'type\': \'Волшебство\', \'flavor\': \'«Пусть последнее видение погибели навсегда запечатлеется в их немигающих глазах». — Зул Ашур, лорд-лич\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264710&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'620b2eae-1ade-4465-9e73-96c8a96db800\', \'multiverseId\': 264710}, \'multiverseid\': 264710}, {\'name\': \'死印\', \'text\': \'消灭目标绿色或白色生物。\', \'type\': \'法术\', \'flavor\': \'「让末日的最终景象刻划在他们睁大的双眼上。」 ～巫妖领主祝亚许\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262967&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2410b024-d053-4c32-a1aa-8ee964c01887\', \'multiverseId\': 262967}, \'multiverseid\': 262967}, {\'name\': \'死印\', \'text\': \'消滅目標綠色或白色生物。\', \'type\': \'巫術\', \'flavor\': \'「讓末日的最終景象刻劃在他們睜大的雙眼上。」 ～巫妖領主祝亞許\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263216&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'67c5a3ce-9f15-47cd-8408-1b48d87e6619\', \'multiverseId\': 263216}, \'multiverseid\': 263216}]', '[{\'name\': \'Tohuwabohu\', \'text\': \'Bestimme für jede bleibende Karte außer Ländern zufällig einen Spieler. Dann übernimmt jeder Spieler die Kontrolle über alle bleibenden Karten, für die er bestimmt wurde. Enttappe diese bleibenden Karten.\', \'type\': \'Hexerei\', \'flavor\': \'Manchmal muss einfach etwas Chaos sein.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263777&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0af60c9b-124c-4f72-8890-0b67f260362b\', \'multiverseId\': 263777}, \'multiverseid\': 263777}, {\'name\': \'Confusiverso\', \'text\': \'Por cada permanente que no sea tierra, elige un jugador al azar. Luego cada jugador gana el control de cada permanente para el cual fue elegido. Endereza esos permanentes.\', \'type\': \'Conjuro\', \'flavor\': \'A veces el orden es algo caótico.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265022&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cb9c3bbd-056d-4154-971f-8171d57b235d\', \'multiverseId\': 265022}, \'multiverseid\': 265022}, {\'name\': \'Mêlunivers\', \'text\': \'Pour chaque permanent non-terrain, choisissez un joueur au hasard. Puis chaque joueur acquiert le contrôle de chaque permanent pour lequel il a été choisi. Dégagez ces permanents.\', \'type\': \'Rituel\', \'flavor\': "Parfois, l\'ordre du jour est au chaos.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263528&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ca516dab-6126-48d3-a489-88dbe98e0de1\', \'multiverseId\': 263528}, \'multiverseid\': 263528}, {\'name\': \'Mischiauniverso\', \'text\': \'Per ogni permanente non terra, scegli un giocatore a caso. Poi ogni giocatore prende il controllo di ogni permanente per cui è stato scelto. STAPpa quei permanenti.\', \'type\': \'Stregoneria\', \'flavor\': "A volte un po\' di caos è all\'ordine del giorno.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264026&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'77c3e644-45a4-4338-9583-15f13f8b65ea\', \'multiverseId\': 264026}, \'multiverseid\': 264026}, {\'name\': \'世界混ぜ\', \'text\': \'土地でないパーマネント１つにつき、プレイヤーを無作為に１人選ぶ。 その後、各プレイヤーは自分が選ばれた各パーマネントのコントロールを得る。 それらのパーマネントをアンタップする。\', \'type\': \'ソーサリー\', \'flavor\': \'ちょっとした混沌こそ秩序であることもある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264275&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'699a697b-efb3-4224-a106-ac98483cae2c\', \'multiverseId\': 264275}, \'multiverseid\': 264275}, {\'name\': \'뒤죽박죽세상\', \'text\': \'대지가 아닌 각 지속물마다 플레이어 한 명씩을 무작위로 선택한다. 그리고 나서 각 플레이어는 자신이 선택된 각 지속물의 조종권을 얻는다. 그 지속물들을 언탭한다.\', \'type\': \'집중마법\', \'flavor\': \'때떄로 질서에는 작은 혼돈이 필요하다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'511e9dea-ed4a-4196-8087-9a28fc6bde41\'}, \'multiverseid\': None}, {\'name\': \'Tumultoverso\', \'text\': \'Para cada permanente que não seja terreno, escolha um jogador aleatoriamente. Depois, cada jogador ganha o controle de cada permanente para a qual foi escolhido. Desvire aquelas permanentes.\', \'type\': \'Feitiço\', \'flavor\': \'Algumas vezes, um pequeno caos é ordem.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264524&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7c53168f-23ce-4e12-8733-5a061c807ffe\', \'multiverseId\': 264524}, \'multiverseid\': 264524}, {\'name\': \'Кутерьма\', \'text\': \'Для каждого не являющегося землей перманента выберите случайного игрока. Затем каждый игрок получает контроль над каждым перманентом, для которого он был выбран. Разверните те перманенты.\', \'type\': \'Волшебство\', \'flavor\': \'Иногда небольшой хаос вполне логичен.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264773&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3db13884-f084-4a11-9d71-8f0d67eb7d8e\', \'multiverseId\': 264773}, \'multiverseid\': 264773}, {\'name\': \'搅乱世界\', \'text\': \'对每个非地永久物而言，分别为其随机选择一位牌手。 然后每位牌手分别获得以此法选择的永久物之操控权。 重置这些永久物。\', \'type\': \'法术\', \'flavor\': \'有时一点混乱也算是有序。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263030&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'945c3ec8-3261-4a84-a9da-bb56bbc75c14\', \'multiverseId\': 263030}, \'multiverseid\': 263030}, {\'name\': \'攪亂世界\', \'text\': \'對每個非地永久物而言，分別為其隨機選擇一位玩家。 然後每位玩家分別獲得以此法選擇的永久物之操控權。 重置這些永久物。\', \'type\': \'巫術\', \'flavor\': \'有時一點混亂也算是有序。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263279&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d4bbd5cf-02d9-4408-a7cf-7513d3b4d4d0\', \'multiverseId\': 263279}, \'multiverseid\': 263279}]', "[{'name': 'Totengräber', 'text': 'Wenn der Totengräber ins Spiel kommt, kannst du eine Kreaturenkarte deiner Wahl aus deinem Friedhof auf deine Hand zurückholen.', 'type': 'Kreatur — Zombie', 'flavor': 'Sein grausiger Gesang treibt die Toten in ihr neues Leben.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263723&type=card', 'language': 'German', 'identifiers': {'scryfallId': '9e091440-2853-43f4-a0e9-e6ae0f5bf879', 'multiverseId': 263723}, 'multiverseid': 263723}, {'name': 'Sepulturero', 'text': 'Cuando el Sepulturero entre al campo de batalla, puedes regresar la carta de criatura objetivo de tu cementerio a tu mano.', 'type': 'Criatura — Zombie', 'flavor': 'Su canto sombrío guía a los muertos a su nueva vida.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264968&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '071132d1-1aae-4d5b-9490-e82c257d3579', 'multiverseId': 264968}, 'multiverseid': 264968}, {'name': 'Fossoyeur', 'text': 'Quand le Fossoyeur arrive sur le champ de bataille, vous pouvez renvoyer une carte de créature ciblée depuis votre cimetière dans votre main.', 'type': 'Créature : zombie', 'flavor': 'Son chant sinistre appelle les morts à leur nouvelle vie.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263474&type=card', 'language': 'French', 'identifiers': {'scryfallId': '070ecd57-3e74-4f79-b98f-a7585f900caf', 'multiverseId': 263474}, 'multiverseid': 263474}, {'name': 'Scavatombe', 'text': 'Quando lo Scavatombe entra nel campo di battaglia, puoi riprendere in mano una carta creatura bersaglio dal tuo cimitero.', 'type': 'Creatura — Zombie', 'flavor': 'Il suo macabro canto introduce i morti alla loro nuova vita.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263972&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '019b14cb-3906-4447-804f-10672856cca7', 'multiverseId': 263972}, 'multiverseid': 263972}, {'name': 'グレイブディガー', 'text': 'グレイブディガーが戦場に出たとき、あなたの墓地にあるクリーチャー・カード１枚を対象とする。あなたはそれをあなたの手札に戻してもよい。', 'type': 'クリーチャー — ゾンビ', 'flavor': '奴の不気味な詠唱は、死者の新たな生命を導く。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264221&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'b3daf16e-81a1-4c83-aa46-540c55da4e04', 'multiverseId': 264221}, 'multiverseid': 264221}, {'name': '시체 도둑', 'text': '시체 도둑이 전장에 들어올 때, 당신의 무덤에 있는 생물 카드 한 장을 목표로 정한다. 당신은 그 카드를 당신의 손으로 되돌릴 수 있다.', 'type': '생물 — 좀비', 'flavor': '그의 음침한 의식은 죽은 자에게 또 다른 삶을 부여한다.', 'language': 'Korean', 'identifiers': {'scryfallId': 'd311dcf6-2d51-4f9c-99e1-6f4f6084551a'}, 'multiverseid': None}, {'name': 'Coveiro', 'text': 'Quando Coveiro entra no campo de batalha, você pode devolver o card de criatura alvo de seu cemitério para a sua mão.', 'type': 'Criatura — Zumbi', 'flavor': 'Seu canto sinistro convida os mortos para sua nova vida.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264470&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f10dfbd8-27f1-4b29-922c-a5483422ace6', 'multiverseId': 264470}, 'multiverseid': 264470}, {'name': 'Могильщик', 'text': 'Когда Могильщик выходит на поле битвы, вы можете вернуть целевую карту существа из вашего кладбища в вашу руку.', 'type': 'Существо — Зомби', 'flavor': 'Исполняя свой мрачный ритуал, он провожает мертвых в новую жизнь.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264719&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '71322ca1-7916-4a48-9ee5-e69b45a912d7', 'multiverseId': 264719}, 'multiverseid': 264719}, {'name': '掘墓怪', 'text': '当掘墓怪进战场时，你可以将目标生物牌从你的坟墓场移回你手上。', 'type': '生物～灵俑', 'flavor': '他残酷的吟诵引导亡者进入新生。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262976&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9bc63b13-ddf4-4dde-a2fc-afe8b8313b14', 'multiverseId': 262976}, 'multiverseid': 262976}, {'name': '掘墓怪', 'text': '當掘墓怪進戰場時，你可以將目標生物牌從你的墳墓場移回你手上。', 'type': '生物～殭屍', 'flavor': '他殘酷的吟誦引導亡者進入新生。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263225&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'dacb916c-310b-4122-96a2-f395b8b84a4e', 'multiverseId': 263225}, 'multiverseid': 263225}]", '[{\'name\': \'Traumbild\', \'text\': \'Du kannst das Traumbild als Kopie einer beliebigen Kreatur im Spiel ins Spiel kommen lassen, außer dass es zusätzlich zu seinen anderen Typen auch eine Illusion ist und „Wenn diese Kreatur das Ziel eines Zauberspruchs oder einer Fähigkeit wird, opfere sie" hat.\', \'type\': \'Kreatur — Illusion\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263696&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'33cf1c49-da7e-4548-86af-7203abcba193\', \'multiverseId\': 263696}, \'multiverseid\': 263696}, {\'name\': \'Imagen fantasmal\', \'text\': \'Puedes hacer que la Imagen fantasmal entre al campo de batalla como una copia de cualquier criatura en el campo de batalla, excepto que es una Ilusión además de sus otros tipos y gana "Cuando esta criatura sea objetivo de un hechizo o habilidad, sacrifícala".\', \'type\': \'Criatura — Ilusión\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264941&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d8f9a8a7-2699-4092-af7e-f47d4a0b5520\', \'multiverseId\': 264941}, \'multiverseid\': 264941}, {\'name\': \'Image phantasmatique\', \'text\': "Vous pouvez faire que l\'Image phantasmatique arrive sur le champ de bataille comme une copie de n\'importe quelle créature sur le champ de bataille, excepté que c\'est une illusion en plus de ses autres types et qu\'elle acquiert « Quand cette créature devient la cible d\'un sort ou d\'une capacité, sacrifiez-la. »", \'type\': \'Créature : illusion\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263447&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0b246012-752e-4bb4-9673-eca648c783e4\', \'multiverseId\': 263447}, \'multiverseid\': 263447}, {\'name\': \'Immagine Fantasma\', \'text\': \'Puoi far entrare l\\\'Immagine Fantasma nel campo di battaglia come una copia di qualsiasi creatura sul campo di battaglia, tranne che è un\\\'Illusione in aggiunta ai suoi altri tipi e ha "Quando questa creatura diventa bersaglio di una magia o abilità, sacrificala".\', \'type\': \'Creatura — Illusione\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263945&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e6d526b3-9b2f-48e2-98c0-34af5186d9f5\', \'multiverseId\': 263945}, \'multiverseid\': 263945}, {\'name\': \'幻影の像\', \'text\': \'あなたは幻影の像を、それが他のタイプに加えてイリュージョンであり、「このクリーチャーが呪文や能力の対象になったとき、それを生け贄に捧げる。」を得ることを除き、戦場に出ているいずれかのクリーチャーのコピーとして出してもよい。\', \'type\': \'クリーチャー — イリュージョン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264194&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c0d67b3e-edb6-4b95-8bad-6bf405034e8c\', \'multiverseId\': 264194}, \'multiverseid\': 264194}, {\'name\': \'허깨비상\', \'text\': \'당신은 전장에 있는 원하는 생물의 복사본으로서 허깨비상을 전장으로 들어오게 할 수 있다. 복사본으로 들어오든 말든, 허깨비상은 자체의 다른 유형에 더불어 환영이기도 하고, "이 생물이 주문이나 능력의 목표로 정해질 때, 이 생물을 희생한다"라는 능력을 얻는다.\', \'type\': \'생물 — 환영\', \'flavor\': None, \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a35896ba-f2eb-437c-b1db-4d74f2d41381\'}, \'multiverseid\': None}, {\'name\': \'Imagem Fantasmal\', \'text\': \'Você pode fazer com que Imagem Fantasmal entre no campo de batalha como uma cópia de qualquer criatura no campo de batalha, contudo ela ainda será uma Ilusão além de seus outros tipos e ganhará "Quando esta criatura se tornar alvo de uma mágica ou habilidade, sacrifique-a."\', \'type\': \'Criatura — Ilusão\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264443&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'949a123e-192e-4c14-a372-7ba4c12caee0\', \'multiverseId\': 264443}, \'multiverseid\': 264443}, {\'name\': \'Призрачный Образ\', \'text\': \'Вы можете заставить Призрачный Образ выйти на поле битвы в качестве копии любого существа на поле битвы, но при этом он является Иллюзией в дополнение к своим другим типам и получает способность «Когда это существо становится целью заклинания или способности, пожертвуйте его».\', \'type\': \'Существо — Иллюзия\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264692&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dcac379b-67e5-45ce-b2cc-69a2795ef607\', \'multiverseId\': 264692}, \'multiverseid\': 264692}, {\'name\': \'幻象身影\', \'text\': \'你可以使幻象身影当成战场上任一生物的复制品来进入战场，但它额外具有虚影此类别，且具有「当此生物成为咒语或异能的目标时，将它牺牲。」\', \'type\': \'生物～虚影\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262949&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'893b4280-a9a1-4307-8ae0-7fc2e4092663\', \'multiverseId\': 262949}, \'multiverseid\': 262949}, {\'name\': \'幻象身影\', \'text\': \'你可以使幻象身影當成戰場上任一生物的複製品來進入戰場，但它額外具有虛影此類別，且具有「當此生物成為咒語或異能的目標時，將它犧牲。」\', \'type\': \'生物～虛影\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263198&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'daeb899b-3b0d-41b7-8c4e-309a5b88f466\', \'multiverseId\': 263198}, \'multiverseid\': 263198}]', '[{\'name\': \'Traumbär\', \'text\': \'Wenn der Traumbär das Ziel eines Zauberspruchs oder einer Fähigkeit wird, opfere ihn.\', \'type\': \'Kreatur — Bär, Illusion\', \'flavor\': \'„Du weißt, dass es ihn nicht gibt, aber wenn seine Krallen dich zerfleischen, hilft dir dein Wissen nicht." —Pol Jamaar, Illusionist\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263694&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f0f71bbf-076a-400b-a4d7-8f8b7193bf61\', \'multiverseId\': 263694}, \'multiverseid\': 263694}, {\'name\': \'Oso fantasmal\', \'text\': \'Cuando el Oso fantasmal sea objetivo de un hechizo o habilidad, sacrifícalo.\', \'type\': \'Criatura — Ilusión oso\', \'flavor\': \'"Sabes que no es real pero, cuando sus garras te alcanzan, lo que sepas no importa demasiado." —Pol Jamaar, ilusionista\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264939&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4d5de2fe-4355-417c-ba7d-e08f01444ce8\', \'multiverseId\': 264939}, \'multiverseid\': 264939}, {\'name\': \'Ours phantasmatique\', \'text\': "Quand l\'Ours phantasmatique devient la cible d\'un sort ou d\'une capacité, sacrifiez-le.", \'type\': \'Créature : ours et illusion\', \'flavor\': "« Vous savez qu\'il n\'est qu\'illusion, mais quand ses griffes vous lacèrent, cela n\'a aucune importance. » —Pol Jamaar, illusionniste", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263445&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0e1aa805-0950-4401-8604-75510f120cba\', \'multiverseId\': 263445}, \'multiverseid\': 263445}, {\'name\': \'Orso Fantasma\', \'text\': "Quando l\'Orso Fantasma diventa bersaglio di una magia o abilità, sacrificalo.", \'type\': \'Creatura — Illusione Orso\', \'flavor\': \'"Sai che è falso, ma quando i suoi artigli ti raggiungono, non importa molto cosa sai o non sai." —Pol Jamaar, illusionista\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263943&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8c889407-f643-4ba2-8412-b80c8434b839\', \'multiverseId\': 263943}, \'multiverseid\': 263943}, {\'name\': \'幻影の熊\', \'text\': \'幻影の熊が呪文や能力の対象になったとき、それを生け贄に捧げる。\', \'type\': \'クリーチャー — 熊・イリュージョン\', \'flavor\': \'「偽りだとわかっていようが、その爪がお前にかかったら、お前の考えなど役には立たないぞ。」 ――幻術士、ポル・ジャマール\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264192&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2424a592-8982-4f39-a120-889bf131c7b5\', \'multiverseId\': 264192}, \'multiverseid\': 264192}, {\'name\': \'허깨비 곰\', \'text\': \'허깨비 곰이 주문이나 능력의 목표로 정해질 때, 허깨비 곰을 희생한다.\', \'type\': \'생물 — 곰 환영\', \'flavor\': \'"그게 가짜라는 건 알 터지만, 막상 그 녀석이 발톱을 뻗쳐 오면 알아봤자 소용없음을 알 게 될 걸세."—환영술사 폴 자마르\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c38a378b-b1fd-4226-84c3-005b3051dfee\'}, \'multiverseid\': None}, {\'name\': \'Urso Fantasmal\', \'text\': \'Quando Urso Fantasmal se tornar alvo de uma mágica ou habilidade, sacrifique-o.\', \'type\': \'Criatura — Urso Ilusão\', \'flavor\': \'"Você sabe que ele não é real, mas quando suas garras o alcançam, já não importa o que você sabe." — Pol Jamaar, Ilusionista\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264441&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'72ed1180-95f2-4550-9805-9ca56b0edb60\', \'multiverseId\': 264441}, \'multiverseid\': 264441}, {\'name\': \'Призрачный Медведь\', \'text\': \'Когда Призрачный Медведь становится целью заклинания или способности, пожертвуйте его.\', \'type\': \'Существо — Медведь Иллюзия\', \'flavor\': \'«Вы знаете, что он ненастоящий, но это не будет иметь никакого значения, когда его когти вопьются в ваше тело». — Пол Джамаар, иллюзионист\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264690&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'49dc20f3-abb0-4d2d-a1b4-13d1be3192f1\', \'multiverseId\': 264690}, \'multiverseid\': 264690}, {\'name\': \'幻象熊\', \'text\': \'当幻象熊成为咒语或异能的目标时，将它牺牲。\', \'type\': \'生物～熊／虚影\', \'flavor\': \'「你明知这不是真的，但当它向你挥爪，你知道些什么可一点也不重要。」 ～幻影师波贾玛\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262947&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'764bab80-8274-440f-bc19-86965181ab99\', \'multiverseId\': 262947}, \'multiverseid\': 262947}, {\'name\': \'幻象熊\', \'text\': \'當幻象熊成為咒語或異能的目標時，將它犧牲。\', \'type\': \'生物～熊／虛影\', \'flavor\': \'「你明知這不是真的，但當它向你揮爪，你知道些什麼可一點也不重要。」 ～幻影師波賈瑪\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263196&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4d5bcecb-8804-42c6-ac72-dc3fa43faa47\', \'multiverseId\': 263196}, \'multiverseid\': 263196}]', '[{\'name\': \'Traumdrache\', \'text\': \'Fliegend\\nWenn der Traumdrache das Ziel eines Zauberspruchs oder einer Fähigkeit wird, opfere ihn.\', \'type\': \'Kreatur — Drache, Illusion\', \'flavor\': \'Seinen Hunger und Zorn macht es nicht geringer, dass er aus Lügen und Nebel besteht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263695&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'68ecc68f-05fe-46b4-9dd5-b012a60a50db\', \'multiverseId\': 263695}, \'multiverseid\': 263695}, {\'name\': \'Dragón fantasmal\', \'text\': \'Vuela.\\nCuando el Dragón fantasmal sea objetivo de un hechizo o habilidad, sacrifícalo.\', \'type\': \'Criatura — Ilusión dragón\', \'flavor\': \'Su hambre y su ira no son menores por estar hecho de mentiras y niebla.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264940&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'26d6bc04-def4-46c7-a266-ae32e32b42e4\', \'multiverseId\': 264940}, \'multiverseid\': 264940}, {\'name\': \'Dragon phantasmatique\', \'text\': "Vol\\nQuand le Dragon phantasmatique devient la cible d\'un sort ou d\'une capacité, sacrifiez-le.", \'type\': \'Créature : dragon et illusion\', \'flavor\': \'Bien que forgées de mensonges et de brume, sa faim et sa colère sont bien réelles.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263446&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9d6b7f5d-3aac-4806-bf58-5cd738c8b83d\', \'multiverseId\': 263446}, \'multiverseid\': 263446}, {\'name\': \'Drago Fantasma\', \'text\': \'Volare\\nQuando il Drago Fantasma diventa bersaglio di una magia o abilità, sacrificalo.\', \'type\': \'Creatura — Illusione Drago\', \'flavor\': \'Anche se plasmato da nebbia e bugie, la sua fame e la sua collera non sono certo trascurabili.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263944&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'aa47e202-573c-4126-9e3b-b23417fb019c\', \'multiverseId\': 263944}, \'multiverseid\': 263944}, {\'name\': \'幻影のドラゴン\', \'text\': \'飛行\\n幻影のドラゴンが呪文や能力の対象になったとき、それを生け贄に捧げる。\', \'type\': \'クリーチャー — ドラゴン・イリュージョン\', \'flavor\': \'嘘と霧から生み出されたものにも関わらず、その飢えと怒りは力を持つ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264193&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4f89d55a-4778-413c-bd40-cf8d47e67a60\', \'multiverseId\': 264193}, \'multiverseid\': 264193}, {\'name\': \'허깨비 용\', \'text\': \'비행허깨비 용이 주문이나 능력의 목표로 정해질 때, 허깨비 용을 희생한다.\', \'type\': \'생물 — 용 환영\', \'flavor\': \'거짓말과 안개로 만들어졌다고 해서 허기와 분노가 덜한 건 아니다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'501daf6c-0ca9-49d9-9275-7727b697ed5c\'}, \'multiverseid\': None}, {\'name\': \'Dragão Fantasmal\', \'text\': \'Voar\\nQuando Dragão Fantasmal se tornar alvo de uma mágica ou habilidade, sacrifique-o.\', \'type\': \'Criatura — Dragão Ilusão\', \'flavor\': \'Sua fome e sua ira não são aplacadas pelo fato de ser feito de mentiras e brumas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264442&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6e34584d-2e7c-452d-96f0-a224950b955b\', \'multiverseId\': 264442}, \'multiverseid\': 264442}, {\'name\': \'Призрачный Дракон\', \'text\': \'Полет\\nКогда Призрачный Дракон становится целью заклинания или способности, пожертвуйте его.\', \'type\': \'Существо — Дракон Иллюзия\', \'flavor\': \'Его голод и ярость ничуть не слабее от того, что они сделаны из обманов и тумана.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264691&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'97945fc0-4ca8-461c-ab3e-a778994f06d1\', \'multiverseId\': 264691}, \'multiverseid\': 264691}, {\'name\': \'幻象巨龙\', \'text\': \'飞行\\n当幻象巨龙成为咒语或异能的目标时，将它牺牲。\', \'type\': \'生物～龙／虚影\', \'flavor\': \'虽以谎言与雾气打造，其饥饿与愤怒可一点不少。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262948&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3e575f2a-4cc5-4eeb-a100-e36ad3e940cd\', \'multiverseId\': 262948}, \'multiverseid\': 262948}, {\'name\': \'幻象巨龍\', \'text\': \'飛行\\n當幻象巨龍成為咒語或異能的目標時，將它犧牲。\', \'type\': \'生物～龍／虛影\', \'flavor\': \'雖以謊言與霧氣打造，其飢餓與憤怒可一點不少。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263197&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'39cf1878-bdc4-4127-b8c5-81a4348f04fd\', \'multiverseId\': 263197}, \'multiverseid\': 263197}]', '[{\'name\': \'Treibender Totengeist\', \'text\': \'Fliegend\\n{B}: Der Treibende Totengeist erhält +1/+1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Schatten\', \'flavor\': \'Er spukt bei Vollmond durch die Marschen und sammelt Schatten, während er an ihnen vorbeigleitet.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263720&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0dc93de1-fd39-4dd2-b03f-e7847a1ba401\', \'multiverseId\': 263720}, \'multiverseid\': 263720}, {\'name\': \'Sombra sin rumbo\', \'text\': \'Vuela.\\n{B}: La Sombra sin rumbo obtiene +1/+1 hasta el final del turno.\', \'type\': \'Criatura — Sombra\', \'flavor\': \'Acecha las ciénagas a la luz de la luna llena, recolectando sombras mientras flota entre ellas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264965&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'41242c2d-b957-482a-805e-27b34846d10c\', \'multiverseId\': 264965}, \'multiverseid\': 264965}, {\'name\': \'Ombre à la dérive\', \'text\': "Vol\\n{B} : L\'Ombre à la dérive gagne +1/+1 jusqu\'à la fin du tour.", \'type\': \'Créature : ombre\', \'flavor\': \'Elle rôde dans les maremmes à la lueur de la pleine lune, flottant parmi les ombres, les rassemblant dans son sillage.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263471&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f9ff017e-bf63-46ce-9923-2e20cd59cf59\', \'multiverseId\': 263471}, \'multiverseid\': 263471}, {\'name\': \'Ombra Vagante\', \'text\': "Volare\\n{B}: L\'Ombra Vagante prende +1/+1 fino alla fine del turno.", \'type\': \'Creatura — Ombra\', \'flavor\': \'Percorre le paludi alla luce della luna piena, radunando ombre mentre fluttua tra loro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263969&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'85c6988c-09e6-4f7c-98aa-bbef597b09a2\', \'multiverseId\': 263969}, \'multiverseid\': 263969}, {\'name\': \'漂う影\', \'text\': \'飛行\\n{B}：漂う影はターン終了時まで＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — シェイド\', \'flavor\': \'それは満月の明かりの下の沼地をうろつき、その中に浮かび上がる影を集める。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264218&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a902f029-6a74-4d94-83da-7a713f352a7e\', \'multiverseId\': 264218}, \'multiverseid\': 264218}, {\'name\': \'떠다니는 그림자\', \'text\': \'비행: 떠다니는 그림자는 턴종료까지 +1/+1을 받는다.\', \'type\': \'생물 — 그림자\', \'flavor\': \'보름달이 뜨면, 그것은 늪지대 위를 떠다니며 그림자들을 흡수한다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a0159d60-5e8e-45c5-9798-abc582466d88\'}, \'multiverseid\': None}, {\'name\': \'Sombra Flutuante\', \'text\': \'Voar\\n{B}: Sombra Flutuante recebe +1/+1 até o final do turno.\', \'type\': \'Criatura — Sombra\', \'flavor\': \'Ela aproxima-se sorrateiramente dos pântanos sob a luz da lua cheia e recolhe sombras enquanto flutua entre elas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264467&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5e20a4ee-77df-422d-919b-2cf711521564\', \'multiverseId\': 264467}, \'multiverseid\': 264467}, {\'name\': \'Дрейфующая Тень\', \'text\': \'Полет\\n{B}: Дрейфующая Тень получает +1/+1 до конца хода.\', \'type\': \'Существо — Тень\', \'flavor\': \'При свете полной луны она скользит по трясинам, собирая болотные тени.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264716&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e77140c4-c4cc-4a9b-a5fe-7e393e20e6f5\', \'multiverseId\': 264716}, \'multiverseid\': 264716}, {\'name\': \'漂游阴魂\', \'text\': \'飞行\\n{B}：漂游阴魂得+1/+1直到回合结束。\', \'type\': \'生物～阴魂\', \'flavor\': \'它藉着满月的光芒在沼地潜行，在阴影之间移动并聚集成型。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262973&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'64e7e315-e1f7-4bf9-a7a3-9ef064f1f0fc\', \'multiverseId\': 262973}, \'multiverseid\': 262973}, {\'name\': \'漂游陰魂\', \'text\': \'飛行\\n{B}：漂游陰魂得+1/+1直到回合結束。\', \'type\': \'生物～陰魂\', \'flavor\': \'它藉著滿月的光芒在沼地潛行，在陰影之間移動並聚集成型。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263222&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e0b8a9a9-895b-48c7-a2c3-b0e288d43d20\', \'multiverseId\': 263222}, \'multiverseid\': 263222}]', '[{\'name\': \'Trollhaut\', \'text\': \'Kreaturenverzauberung\\nDie verzauberte Kreatur erhält +2/+2 und „{1}{G}: Regeneriere diese Kreatur". (Das nächste Mal, dass diese Kreatur in diesem Zug zerstört würde, wird sie nicht zerstört. Tappe sie stattdessen, entferne allen Schaden von ihr und entferne sie aus dem Kampf.)\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263823&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b5aed680-1fed-412a-a2ac-2b66e51484e2\', \'multiverseId\': 263823}, \'multiverseid\': 263823}, {\'name\': \'Piel de trol\', \'text\': \'Encantar criatura.\\nLa criatura encantada obtiene +2/+2 y tiene "{1}{G}: Regenera esta criatura". (La próxima vez que la criatura fuera a ser destruida este turno, no lo es. En vez de eso, gírala, remueve todo el daño de ella y remuévela del combate.)\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265068&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bc8cc487-dfa8-4169-9fc6-82232bbfa6d9\', \'multiverseId\': 265068}, \'multiverseid\': 265068}, {\'name\': \'Peau de troll\', \'text\': "Enchanter : créature\\nLa créature enchantée gagne +2/+2 et a « {1}{G} : Régénérez cette créature ». (La prochaine fois que la créature devrait être détruite ce tour-ci, elle ne l\'est pas. À la place, engagez-la, retirez-lui toutes ses blessures et retirez-la du combat.)", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263574&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'22006c07-0df1-44f1-8028-ae12edcbf323\', \'multiverseId\': 263574}, \'multiverseid\': 263574}, {\'name\': \'Pelle di Troll\', \'text\': \'Incanta creatura\\nLa creatura incantata prende +2/+2 e ha "{1}{G}: Rigenera questa creatura". (La prossima volta che questa creatura sta per essere distrutta in questo turno, non viene distrutta. Invece TAPpala, rimuovi da essa tutto il danno e rimuovila dal combattimento.)\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264072&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4c6ede12-2711-45a0-9e44-ceabdd15f3ee\', \'multiverseId\': 264072}, \'multiverseid\': 264072}, {\'name\': \'トロール皮\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは、＋２/＋２の修整を受けるとともに「{1}{G}：このクリーチャーを再生する。」を持つ。 （このターン、次にそのクリーチャーが破壊される場合、破壊されない。 代わりに、それをタップし、それに与えられているダメージをすべて取り除き、それを戦闘から取り除く。）\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264321&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c1c2efc0-b603-4be5-8774-3ab368e1359e\', \'multiverseId\': 264321}, \'multiverseid\': 264321}, {\'name\': \'트롤가죽\', \'text\': \'생물에게 부여부여된 생물은 +2/+2를 받고 ": 이 생물을 재생한다"라는 능력을 가진다. (이 턴에 그 생물이 다음으로 파괴되려 하면, 그 생물은 파괴되지 않는다. 그 대신에 그 생물을 탭하고, 그 생물에서 모든 피해를 제거하고, 전투에서 그 생물을 제외 한다.)\', \'type\': \'부여마법 — 마법진\', \'flavor\': None, \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'63efff24-e070-4d11-9c1a-188651ecf317\'}, \'multiverseid\': None}, {\'name\': \'Couro de Trol\', \'text\': \'Encantar criatura\\nA criatura encantada recebe +2/+2 e tem "{1}{G}: Regenere esta criatura." (Na próxima vez em que a criatura seria destruída neste turno, ela não será. Em vez disso, vire-a, remova todo o dano dela e remova-a do combate.)\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264570&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f71dc1e1-e35a-4cf0-a47a-5b5aa2e905eb\', \'multiverseId\': 264570}, \'multiverseid\': 264570}, {\'name\': \'Шкура Тролля\', \'text\': \'Зачаровать существо\\nЗачарованное существо получает +2/+2 и имеет способность «{1}{G}: регенерируйте это существо». (В следующий раз при уничтожении того существа в этом ходу, оно не уничтожается. Вместо этого поверните его, снимите с него все повреждения и удалите его из боя.)\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264819&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7e250ebd-7968-4fff-851a-a365e50fd6be\', \'multiverseId\': 264819}, \'multiverseid\': 264819}, {\'name\': \'巨魔外皮\', \'text\': \'结附于生物\\n所结附的生物得+2/+2并具有「{1}{G}：重生此生物。」 （如果该生物下一次于本回合中将被消灭，则它不会被消灭， 而是改为将它横置，移除受过的所有伤害，并将它移出战斗。）\', \'type\': \'结界～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263076&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c48d58e0-2aab-43ff-9d57-496389e64f72\', \'multiverseId\': 263076}, \'multiverseid\': 263076}, {\'name\': \'巨魔外皮\', \'text\': \'結附於生物\\n所結附的生物得+2/+2並具有「{1}{G}：重生此生物。」 （如果該生物下一次於本回合中將被消滅，則它不會被消滅， 而是改為將它橫置，移除受過的所有傷害，並將它移出戰鬥。）\', \'type\': \'結界～靈氣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263325&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2a047d93-485d-4417-a9f4-447fecc35475\', \'multiverseId\': 263325}, \'multiverseid\': 263325}]', '[{\'name\': \'Umlenken\', \'text\': \'Du kannst neue Ziele für einen Zauberspruch deiner Wahl bestimmen.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Eigentlich ist es ganz einfach, aber da du ja noch nicht lange aufrecht gehst, kann das Erklären eine Weile dauern." —Jace Beleren zu Garruk Wildsprecher\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263698&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fbc1670b-0f58-462e-b7b7-03fe44c4476f\', \'multiverseId\': 263698}, \'multiverseid\': 263698}, {\'name\': \'Redireccionar\', \'text\': \'Puedes elegir nuevos objetivos para el hechizo objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"En realidad es muy simple, pero como hace poco que aprendiste a caminar erguido, puede que tarde un poco en explicártelo." —Jace Beleren, a Garruk Portavoz Salvaje\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264943&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b41d1565-092d-4df8-be12-22cb5f1ee91d\', \'multiverseId\': 264943}, \'multiverseid\': 264943}, {\'name\': \'Redirection\', \'text\': \'Vous pouvez choisir de nouvelles cibles pour le sort ciblé.\', \'type\': \'Éphémère\', \'flavor\': "« En fait, c\'est assez simple, mais comme vous venez seulement d\'apprendre à marcher sur deux pattes, il vous faudra peut-être un peu de temps avant de comprendre. » —Jace Beleren, à Garruk Languebestion", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263449&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d5e5e0e5-42a8-4a8d-9f80-024d57a46115\', \'multiverseId\': 263449}, \'multiverseid\': 263449}, {\'name\': \'Dirottare\', \'text\': \'Puoi scegliere nuovi bersagli per una magia bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"In realtà è abbastanza semplice, ma siccome è da poco che hai iniziato a camminare dritto, potrebbe volerci un po\\\' a spiegarlo." —Jace Beleren, a Garruk Lingua Selvaggia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263947&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c8de9e46-daf7-4f05-bd66-7b6f6df3aae0\', \'multiverseId\': 263947}, \'multiverseid\': 263947}, {\'name\': \'移し変え\', \'text\': \'呪文１つを対象とする。あなたはそれの新しい対象を選んでもよい。\', \'type\': \'インスタント\', \'flavor\': \'「実際、極めて単純なことだが、二本足で歩いて間もないお前には、少々説明に時間が掛かりそうだ。」 ――ジェイス・ベレレンから野生語りのガラクへ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264196&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'95ed0757-a9b8-4583-80be-82e91618c8c9\', \'multiverseId\': 264196}, \'multiverseid\': 264196}, {\'name\': \'전향\', \'text\': \'주문 한 개를 목표로 정한다. 당신은 그 주문의 목표를 새로 정할 수 있다.\', \'type\': \'순간마법\', \'flavor\': \'"원리는 꽤 간단하지만, 너같이 겨우 직립보행하기 시작한 자가 이해하기에는 조금 벅찰 수도 있겠군."—제이스 벨레렌이 개럭 와일드스피커에게\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'cf6581a0-42f0-4074-bbd1-6a3392d7747d\'}, \'multiverseid\': None}, {\'name\': \'Defletir\', \'text\': \'Você pode escolher novos alvos para a mágica alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Na verdade é bastante simples, mas como você acabou de aprender a caminhar ereto, pode levar algum tempo para explicar." — Jace Beleren, para Garruk Falabravo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264445&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9739c54a-feff-4e4a-ad7e-014f87bb575f\', \'multiverseId\': 264445}, \'multiverseid\': 264445}, {\'name\': \'Перенацеливание\', \'text\': \'Вы можете выбрать новые цели для целевого заклинания.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«На самом деле, все очень просто, но поскольку ты только вчера с пальмы слез, объяснять придется довольно долго». — Джейс Белерен, обращаясь к Гарруку Дикоречивому\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264694&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bd5fa4e6-457e-49b1-b855-17b224c214c8\', \'multiverseId\': 264694}, \'multiverseid\': 264694}, {\'name\': \'移转\', \'text\': \'你可以为目标咒语选择新的目标。\', \'type\': \'瞬间\', \'flavor\': \'「其实这很简单，但既然你直着走路还没多久，可能得花点时间来解释。」 ～杰斯贝连告诉召兽使贾路\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262951&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1d593edf-03ef-4c7b-bf0b-2fa74dcd40b7\', \'multiverseId\': 262951}, \'multiverseid\': 262951}, {\'name\': \'移轉\', \'text\': \'你可以為目標咒語選擇新的目標。\', \'type\': \'瞬間\', \'flavor\': \'「其實這很簡單，但既然你直著走路還沒多久，可能得花點時間來解釋。」 ～傑斯貝連告訴召獸使賈路\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263200&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e19a1620-cd21-4882-8032-ab4eb69695b6\', \'multiverseId\': 263200}, \'multiverseid\': 263200}]', '[{\'name\': \'Ungebundene Gedanken\', \'text\': \'Lege zu Beginn deines Versorgungssegments eine Sagenmarke auf die Ungebundenen Gedanken und ziehe dann für jede Sagenmarke auf den Ungebundenen Gedanken eine Karte.\', \'type\': \'Verzauberung\', \'flavor\': \'Die Realität schränkt ein, was Hände erschaffen können. Für Gedankengebilde gibt es keine Grenzen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263692&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fa8d2d0c-ffc2-49b9-9fca-62aea5f83c5f\', \'multiverseId\': 263692}, \'multiverseid\': 263692}, {\'name\': \'Mente liberada\', \'text\': \'Al comienzo de tu mantenimiento, pon un contador de sabiduría sobre Mente liberada, luego roba una carta por cada contador de sabiduría sobre Mente liberada.\', \'type\': \'Encantamiento\', \'flavor\': \'Las creaciones de la mano están confinadas a la realidad. Las creaciones de la mente no tienen esos límites.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264937&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bf28e17d-5ad4-4f9f-ae00-7333929d462b\', \'multiverseId\': 264937}, \'multiverseid\': 264937}, {\'name\': \'Esprit libéré\', \'text\': "Au début de votre entretien, mettez un marqueur « sapience » sur l\'Esprit libéré, puis piochez une carte pour chaque marqueur « sapience » sur l\'Esprit libéré.", \'type\': \'Enchantement\', \'flavor\': "Les créations de la main sont confinées par la réalité. Les créations de l\'esprit ne connaissent pas de telles limites.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263443&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cc094556-43b3-4060-bb3b-c4adfa8e9df2\', \'multiverseId\': 263443}, \'multiverseid\': 263443}, {\'name\': \'Mente Sconfinata\', \'text\': "All\'inizio del tuo mantenimento, metti un segnalino sapere sulla Mente Sconfinata, poi pesca una carta per ogni segnalino sapere sulla Mente Sconfinata.", \'type\': \'Incantesimo\', \'flavor\': \'Le creazioni della mano sono limitate dalla realtà. Le creazioni della mente non conoscono tali limiti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263941&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'44b3cec3-e9f3-400c-a285-f85493c7262b\', \'multiverseId\': 263941}, \'multiverseid\': 263941}, {\'name\': \'解放された精神\', \'text\': \'あなたのアップキープの開始時に、開放された精神の上に伝承カウンターを１個置き、その後、解放された精神の上に置かれている伝承カウンター１個につき、カードを１枚引く。\', \'type\': \'エンチャント\', \'flavor\': \'手によって作られた物は現実に制約される。 精神によって作られた物にはそんな限界は無い。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264190&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'db3a6193-e4d8-4d55-b0e9-497759ee70e4\', \'multiverseId\': 264190}, \'multiverseid\': 264190}, {\'name\': \'정신 해방\', \'text\': \'당신의 유지단 시작에, 정신 해방에 구전 카운터 한 개를 올려놓고 나서, 정신 해방에 있는 구전 카운터 한 개당 카드 한 장씩을 뽑는다.\', \'type\': \'부여마법\', \'flavor\': \'손의 피조물은 현실의 제약을 받는다. 정신의 피조물은 그런 제약을 모른다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ca4d6471-53e2-415c-a83a-c44205b08c0e\'}, \'multiverseid\': None}, {\'name\': \'Liberação da Mente\', \'text\': \'No início de sua manutenção, coloque um marcador de sabedoria sobre Liberação da Mente, depois compre um card para cada marcador de sabedoria sobre Liberação da Mente.\', \'type\': \'Encantamento\', \'flavor\': \'As criações manuais estão confinadas à realidade. As criações mentais não conhecem esses limites.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264439&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7d1db5cd-468b-48c8-9a42-cefc6ba5e092\', \'multiverseId\': 264439}, \'multiverseid\': 264439}, {\'name\': \'Раскрепощенный Разум\', \'text\': \'В начале вашего шага поддержки положите один жетон знаний на Раскрепощенный Разум, затем возьмите одну карту за каждый жетон знаний на Раскрепощенном Разуме.\', \'type\': \'Чары\', \'flavor\': \'Творения рук ограничиваются рамками реальности. Творения разума не знают таких границ.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264688&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3ce83def-95d0-41d3-9fb0-a75d9da996a1\', \'multiverseId\': 264688}, \'multiverseid\': 264688}, {\'name\': \'心灵奔逸\', \'text\': \'在你的维持开始时，在心灵奔逸上放置一个学问指示物，然后心灵奔逸上每有一个学问指示物，便抓一张牌。\', \'type\': \'结界\', \'flavor\': \'双手的创作受限于现实。 心灵的创作则没有极限。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262945&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5cc347da-c7ee-4a10-a433-c26258828d6a\', \'multiverseId\': 262945}, \'multiverseid\': 262945}, {\'name\': \'心靈奔逸\', \'text\': \'在你的維持開始時，在心靈奔逸上放置一個學問指示物，然後心靈奔逸上每有一個學問指示物，便抽一張牌。\', \'type\': \'結界\', \'flavor\': \'雙手的創作受限於現實。 心靈的創作則沒有極限。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263194&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a83fb2cc-3e71-40be-9aa2-2e52a7ee3e7a\', \'multiverseId\': 263194}, \'multiverseid\': 263194}]', '[{\'name\': \'Uralte Hydra\', \'text\': \'Die Uralte Hydra kommt mit X +1/+1-Marken ins Spiel.\\nVerdoppele zu Beginn deines Versorgungssegments die Anzahl der +1/+1-Marken auf der Uralten Hydra.\\nDie Uralte Hydra verursacht Trampelschaden, solange zehn oder mehr +1/+1-Marken auf ihr liegen.\', \'type\': \'Kreatur — Hydra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263813&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d23d1814-5f57-475a-b1ee-61e70eb88700\', \'multiverseId\': 263813}, \'multiverseid\': 263813}, {\'name\': \'Hidra primordial\', \'text\': \'La Hidra primordial entra al campo de batalla con X contadores +1/+1 sobre ella.\\nAl comienzo de tu mantenimiento, duplica la cantidad de contadores +1/+1 sobre la Hidra primordial.\\nLa Hidra primordial tiene la habilidad de arrollar mientras tenga diez o más contadores +1/+1 sobre ella.\', \'type\': \'Criatura — Hidra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265058&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'75b9126f-7311-4264-9c88-a83ae0ade8ff\', \'multiverseId\': 265058}, \'multiverseid\': 265058}, {\'name\': \'Hydre primordiale\', \'text\': "L\'Hydre primordiale arrive sur le champ de bataille avec X marqueurs +1/+1 sur elle.\\nAu début de votre entretien, doublez le nombre de marqueurs +1/+1 sur l\'Hydre primordiale.\\nL\'Hydre primordiale a le piétinement tant qu\'elle a au moins dix marqueurs +1/+1 sur elle.", \'type\': \'Créature : hydre\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263564&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8d5f5c17-a3ad-4e4f-b2ef-cc05cc791db0\', \'multiverseId\': 263564}, \'multiverseid\': 263564}, {\'name\': \'Idra Primordiale\', \'text\': "L\'Idra Primordiale entra nel campo di battaglia con X segnalini +1/+1.\\nAll\'inizio del tuo mantenimento, raddoppia il numero di segnalini +1/+1 sull\'Idra Primordiale.\\nL\'Idra Primordiale ha travolgere fintanto che ha dieci o più segnalini +1/+1.", \'type\': \'Creatura — Idra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264062&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d7215089-45c6-4d46-8242-9dc6c288f8e0\', \'multiverseId\': 264062}, \'multiverseid\': 264062}, {\'name\': \'始源のハイドラ\', \'text\': \'始源のハイドラは、＋１/＋１カウンターがＸ個置かれた状態で戦場に出る。\\nあなたのアップキープの開始時に、始源のハイドラの上に置かれている＋１/＋１カウンターの数を２倍にする。\\n始原のハイドラは、それの上に10個以上の＋１/＋１カウンターが置かれているかぎりトランプルを持つ。\', \'type\': \'クリーチャー — ハイドラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264311&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eaa7d810-f71e-4e7c-9da3-f4c3442b649d\', \'multiverseId\': 264311}, \'multiverseid\': 264311}, {\'name\': \'태고의 히드라\', \'text\': \'태고의 히드라는 +1/+1 카운터 X 개를 가진채로 전장에 들어온다.당신의 유지단 시작에, 태고의 히드라가 가진 +1/+1 카운터의 수를 두 배로 늘린다.태고의 히드라가 열 개 이상의 +1/+1 카운터를 가지고 있는 동안, 태고의 히드라는 돌진 능력을 가진다.\', \'type\': \'생물 — 히드라\', \'flavor\': None, \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'85ee487b-a197-4f4e-8dfb-6d06e50d73d1\'}, \'multiverseid\': None}, {\'name\': \'Hidra Primordial\', \'text\': \'Hidra Primordial entra no campo de batalha com X marcadores +1/+1 sobre ela.\\nNo início de sua manutenção, duplique a quantidade de marcadores +1/+1 sobre Hidra Primordial.\\nHidra Primordial tem atropelar enquanto tiver dez ou mais marcadores +1/+1 sobre ela.\', \'type\': \'Criatura — Hidra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264560&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3f5ed75a-df1b-4138-adff-dcda3e0bc0d6\', \'multiverseId\': 264560}, \'multiverseid\': 264560}, {\'name\': \'Первородная Гидра\', \'text\': \'Первородная Гидра выходит на поле битвы с Х жетонами +1/+1 на ней.\\nВ начале вашего шага поддержки удвойте количество жетонов +1/+1 на Первородной Гидре.\\nПервородная Гидра имеет Пробивной удар, пока на ней есть не менее десяти жетонов +1/+1.\', \'type\': \'Существо — Гидра\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264809&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'21453914-1b99-42ed-bbcf-317cc99aa2f0\', \'multiverseId\': 264809}, \'multiverseid\': 264809}, {\'name\': \'原初多头龙\', \'text\': \'原初多头龙进战场时上面有X个+1/+1指示物。\\n在你的维持开始时，将原初多头龙上的+1/+1指示物数量加倍。\\n只要原初多头龙上有10个或更多+1/+1指示物，它便具有践踏异能。\', \'type\': \'生物～多头龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263066&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'52968de9-6c7e-40d0-b372-f56614780384\', \'multiverseId\': 263066}, \'multiverseid\': 263066}, {\'name\': \'原初多頭龍\', \'text\': \'原初多頭龍進戰場時上面有X個+1/+1指示物。\\n在你的維持開始時，將原初多頭龍上的+1/+1指示物數量加倍。\\n只要原初多頭龍上有10個或更多+1/+1指示物，它便具有踐踏異能。\', \'type\': \'生物～多頭龍\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263315&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'24eb1d9c-b3ee-4e82-85f3-60edb922192e\', \'multiverseId\': 263315}, \'multiverseid\': 263315}]', '[{\'name\': \'Urtümlicher Titan\', \'text\': \'Verursacht Trampelschaden\\nImmer wenn der Urtümliche Titan ins Spiel kommt oder angreift, kannst du deine Bibliothek nach bis zu zwei Ländern durchsuchen, sie getappt ins Spiel bringen und dann deine Bibliothek mischen.\', \'type\': \'Kreatur — Riese\', \'flavor\': \'Wenn die Natur ruft, solltest du rennen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263812&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'99ac5761-1b40-49a8-b466-1753928ca9c7\', \'multiverseId\': 263812}, \'multiverseid\': 263812}, {\'name\': \'Titán primigenio\', \'text\': \'Arrolla.\\nSiempre que el Titán primigenio entre al campo de batalla o ataque, puedes buscar en tu biblioteca hasta dos cartas de tierra, ponerlas en el campo de batalla giradas y luego barajar tu biblioteca.\', \'type\': \'Criatura — Gigante\', \'flavor\': \'Cuando la naturaleza llama, corre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265057&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'44d7aafd-2c66-461e-b262-05e8a4a233f8\', \'multiverseId\': 265057}, \'multiverseid\': 265057}, {\'name\': \'Titan primitif\', \'text\': "Piétinement\\nÀ chaque fois que le Titan primitif arrive sur le champ de bataille ou qu\'il attaque, vous pouvez chercher dans votre bibliothèque jusqu\'à deux cartes de terrain, les mettre sur le champ de bataille engagées et mélanger votre bibliothèque.", \'type\': \'Créature : géant\', \'flavor\': "Quand vous entendrez l\'appel de la nature, courez.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263563&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6cd8a4c1-5c04-4229-bab9-1b89ff92c635\', \'multiverseId\': 263563}, \'multiverseid\': 263563}, {\'name\': \'Titano Primitivo\', \'text\': \'Travolgere\\nOgniqualvolta il Titano Primitivo entra nel campo di battaglia o attacca, puoi passare in rassegna il tuo grimorio per trovare fino a due carte terra, metterle sul campo di battaglia TAPpate, poi rimescolare il tuo grimorio.\', \'type\': \'Creatura — Gigante\', \'flavor\': \'Quando la natura chiama, scappa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264061&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9553f64a-8d24-44bd-8057-06167f618d82\', \'multiverseId\': 264061}, \'multiverseid\': 264061}, {\'name\': \'原始のタイタン\', \'text\': \'トランプル\\n原始のタイタンが戦場に出るか攻撃するたび、あなたはあなたのライブラリーから土地カードを最大２枚まで探してもよい。そうしたなら、それらを戦場にタップ状態で出し、その後あなたのライブラリーを切り直す。\', \'type\': \'クリーチャー — 巨人\', \'flavor\': \'自然の呼び声が聞こえたら、逃げろ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264310&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5ad135bf-cce8-4a1b-9627-c2241866dce6\', \'multiverseId\': 264310}, \'multiverseid\': 264310}, {\'name\': \'태초의 거신\', \'text\': \'돌진태초의 거신이 전장에 들어올 때나 공격할 때마다, 당신은 최고 두 장까지의 대지 카드를 당신의 서고에서 찾아 탭된 채로 전장에 놓을 수 있다. 그렇게 한다면, 당신의 서고를 섞는다.\', \'type\': \'생물 — 거인\', \'flavor\': \'자연이 부르면, 뛰어라.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9b500da5-3a42-411a-8c12-df3f1d53dd4b\'}, \'multiverseid\': None}, {\'name\': \'Titã Primordial\', \'text\': \'Atropelar\\nToda vez que Titã Primordial entra no campo de batalha ou ataca, você pode procurar até dois cards de terreno em seu grimório, colocá-los no campo de batalha virados e depois embaralhar seu grimório.\', \'type\': \'Criatura — Gigante\', \'flavor\': \'Quando a natureza chamar, corra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264559&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'99dadce0-865e-44a8-9dae-d3e41dae9bce\', \'multiverseId\': 264559}, \'multiverseid\': 264559}, {\'name\': \'Первобытный Титан\', \'text\': \'Пробивной удар\\nКаждый раз когда Первобытный Титан выходит на поле битвы или атакует, вы можете найти в вашей библиотеке не более двух карт земель, положить их на поле битвы повернутыми, затем перетасовать вашу библиотеку.\', \'type\': \'Существо — Гигант\', \'flavor\': \'Когда вы слышите зов природы, спасайтесь бегством.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264808&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a827299f-bfb2-462e-9baa-87a588d40bf5\', \'multiverseId\': 264808}, \'multiverseid\': 264808}, {\'name\': \'太古泰坦\', \'text\': \'践踏\\n每当太古泰坦进战场或攻击时，你可以从你的牌库中搜寻至多两张地牌，将它们横置进战场，然后将你的牌库洗牌。\', \'type\': \'生物～巨人\', \'flavor\': \'当大自然呼叫时，跑。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263065&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5bcefee3-090f-452b-a53c-4291ae6e1d9b\', \'multiverseId\': 263065}, \'multiverseid\': 263065}, {\'name\': \'太古泰坦\', \'text\': \'踐踏\\n每當太古泰坦進戰場或攻擊時，你可以從你的牌庫中搜尋至多兩張地牌，將它們橫置進戰場，然後將你的牌庫洗牌。\', \'type\': \'生物～巨人\', \'flavor\': \'當大自然呼叫時，跑。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263314&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d068ea36-376d-468e-b7c8-7934c5593388\', \'multiverseId\': 263314}, \'multiverseid\': 263314}]', "[{'name': 'Verbrennen', 'text': 'Verbrennen kann nicht von Zaubersprüchen oder Fähigkeiten neutralisiert werden.\\nVerbrennen fügt einer weißen oder blauen Kreatur deiner Wahl 5 Schadenspunkte zu. Dieser Schaden kann nicht verhindert werden.', 'type': 'Spontanzauber', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263752&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'dc974048-9d6c-4797-8909-9beeec434968', 'multiverseId': 263752}, 'multiverseid': 263752}, {'name': 'Encender', 'text': 'Encender no puede ser contrarrestado por hechizos o habilidades.\\nEncender hace 5 puntos de daño a la criatura blanca o azul objetivo. El daño no puede ser prevenido.', 'type': 'Instantáneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264997&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'cb21c360-8e3c-4085-af05-4754d8fe2535', 'multiverseId': 264997}, 'multiverseid': 264997}, {'name': 'Combustion', 'text': 'La Combustion ne peut pas être contrecarrée par des sorts ou des capacités.\\nLa Combustion inflige 5 blessures à une créature blanche ou bleue ciblée. Ces blessures ne peuvent pas être prévenues.', 'type': 'Éphémère', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263503&type=card', 'language': 'French', 'identifiers': {'scryfallId': '4cfd7431-ad36-431c-925a-462811f7a34c', 'multiverseId': 263503}, 'multiverseid': 263503}, {'name': 'Bruciare', 'text': 'Bruciare non può essere neutralizzato da magie o abilità.\\nBruciare infligge 5 danni a una creatura bianca o blu bersaglio. Il danno non può essere prevenuto.', 'type': 'Istantaneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264001&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '5be6995d-fced-4746-b131-f19bd751c5ac', 'multiverseId': 264001}, 'multiverseid': 264001}, {'name': '焼却', 'text': '焼却は呪文や能力によって打ち消されない。\\n白か青のクリーチャー１体を対象とする。焼却はそれに５点のダメージを与える。 このダメージは軽減できない。', 'type': 'インスタント', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264250&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '193d79e9-e4f5-4f14-ae58-ffecbd91a8bf', 'multiverseId': 264250}, 'multiverseid': 264250}, {'name': '연소', 'text': '연소는 주문이나 능력에 의해 무효화될 수 없다.백색이나 청색 생물 한 개를 목표로 정한다. 연소는 그 생물에게 피해 5점을 입힌다. 그 피해는 방지될 수 없다.', 'type': '순간마법', 'flavor': None, 'language': 'Korean', 'identifiers': {'scryfallId': '685c9060-61ce-4cec-9a0c-e7994bad0015'}, 'multiverseid': None}, {'name': 'Combustar', 'text': 'Combustar não pode ser anulado por mágicas nem habilidades.\\nCombustar causa 5 pontos de dano à criatura alvo branca ou azul. O dano não pode ser prevenido.', 'type': 'Mágica Instantânea', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264499&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9054127a-f8d8-480e-883a-2cdbf50f5c57', 'multiverseId': 264499}, 'multiverseid': 264499}, {'name': 'Воспламенение', 'text': 'Воспламенение не может быть отменено заклинаниями или способностями.\\nВоспламенение наносит 5 повреждений целевому белому или синему существу. Эти повреждения не могут быть предотвращены.', 'type': 'Мгновенное заклинание', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264748&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '047c1ecf-2088-4f02-8ee6-eb02fca06c55', 'multiverseId': 264748}, 'multiverseid': 264748}, {'name': '烧燃', 'text': '烧燃不能被咒语或异能反击。\\n烧燃对由目标白色或蓝色生物造成5点伤害。 此伤害不能被防止。', 'type': '瞬间', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263005&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '662be1b0-478d-4dd2-bd63-df0b7734833f', 'multiverseId': 263005}, 'multiverseid': 263005}, {'name': '燒燃', 'text': '燒燃不能被咒語或異能反擊。\\n燒燃對由目標白色或藍色生物造成5點傷害。 此傷害不能被防止。', 'type': '瞬間', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263254&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'b7255469-1d7f-41d5-b074-df91ea3691a0', 'multiverseId': 263254}, 'multiverseid': 263254}]", '[{\'name\': \'Verdoppelungsgesang\', \'text\': \'Für jede Kreatur, die du kontrollierst, kannst du deine Bibliothek nach einer Kreaturenkarte mit dem gleichen Namen wie diese Kreatur durchsuchen. Bringe diese Karten ins Spiel und mische dann deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': \'Was ist erschreckender als ein Exemplar jeder Bestie des Waldes?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263794&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'787f4fb0-0d07-4297-b900-bd9c85967ba4\', \'multiverseId\': 263794}, \'multiverseid\': 263794}, {\'name\': \'Canto duplicador\', \'text\': \'Por cada criatura que controles, puedes buscar en tu biblioteca una carta de criatura con el mismo nombre que esa criatura. Pon esas cartas en el campo de batalla, luego baraja tu biblioteca.\', \'type\': \'Conjuro\', \'flavor\': \'¿Qué es más temible que una de cada bestia del bosque?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265039&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7e0ee895-0ad6-46e7-b5a8-8a654ba90bac\', \'multiverseId\': 265039}, \'multiverseid\': 265039}, {\'name\': \'Chant de dédoublement\', \'text\': \'Pour chaque créature que vous contrôlez, vous pouvez chercher dans votre bibliothèque une carte de créature ayant le même nom que cette créature. Mettez ces cartes sur le champ de bataille et mélangez ensuite votre bibliothèque.\', \'type\': \'Rituel\', \'flavor\': "Qu\'y a-t-il de plus effrayant qu\'un représentant de chaque bête de la forêt ?", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263545&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ad749f92-9c85-457c-a6e7-e8c9daf364aa\', \'multiverseId\': 263545}, \'multiverseid\': 263545}, {\'name\': \'Canto Raddoppiante\', \'text\': \'Per ogni creatura che controlli, puoi passare in rassegna il tuo grimorio per una carta creatura con lo stesso nome di quella creatura. Metti quelle carte sul campo di battaglia, poi rimescola il tuo grimorio.\', \'type\': \'Stregoneria\', \'flavor\': "Cos\'è più spaventoso di un esemplare di ogni bestia nella foresta?", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264043&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'34ca60b8-ea94-433e-bad1-ac8207821833\', \'multiverseId\': 264043}, \'multiverseid\': 264043}, {\'name\': \'二重の詠唱\', \'text\': \'あなたがコントロールするクリーチャー１体につき、あなたはあなたのライブラリーからそのクリーチャーと同じ名前を持つカードを１枚探してもよい。 それらのカードを戦場に出し、その後あなたのライブラリーを切り直す。\', \'type\': \'ソーサリー\', \'flavor\': \'森のあらゆる獣一頭ずつよりも恐ろしいものは何か？\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264292&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'283ddb89-4a0b-45b1-9ed5-ba7269adb0cf\', \'multiverseId\': 264292}, \'multiverseid\': 264292}, {\'name\': \'분신주술\', \'text\': \'당신이 조종하는 각 생물에 대해, 당신은 그 생물과 동일한 명칭을 가진 생물 카드 한 장씩을 당신의 서고에서 찾아올 수 있다. 그 카드들을 전장에 놓고 나서, 당신의 서고를 섞는다.\', \'type\': \'집중마법\', \'flavor\': \'숲속에 사는 짐승들이 한 마리씩 모두 모인 것보다 더 무서운 건?\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e04b7a68-5271-4b05-98d2-62f2fa6806ed\'}, \'multiverseid\': None}, {\'name\': \'Cântico Duplicador\', \'text\': \'Para cada criatura que controla, você pode procurar no seu grimório um card de criatura com o mesmo nome daquela criatura. Coloque aqueles cards no campo de batalha e depois embaralhe seu grimório.\', \'type\': \'Feitiço\', \'flavor\': \'O que pode ser mais assustador do que um exemplar de cada fera da floresta?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264541&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'31c149cf-cf75-426f-b3d3-0633e657d102\', \'multiverseId\': 264541}, \'multiverseid\': 264541}, {\'name\': \'Распев Удвоения\', \'text\': \'Для каждого существа под вашим контролем вы можете найти в вашей библиотеке карту существа с тем же именем, что и у того существа. Положите те карты на поле битвы, затем перетасуйте вашу библиотеку.\', \'type\': \'Волшебство\', \'flavor\': \'Что может быть страшнее, чем собрать в лесу по одному зверю каждой масти?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264790&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'390dabad-ddaf-43aa-92a6-db663903f1d9\', \'multiverseId\': 264790}, \'multiverseid\': 264790}, {\'name\': \'倍产吟颂\', \'text\': \'对每个由你操控的生物而言，你可以从你的牌库中搜寻一张与该生物同名的生物牌。 将这些牌放进战场，然后将你的牌库洗牌。\', \'type\': \'法术\', \'flavor\': \'有什么比树林的每种野兽都出现一只更可怕？\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263047&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8aed1699-588e-43b5-91de-977c711ed33e\', \'multiverseId\': 263047}, \'multiverseid\': 263047}, {\'name\': \'倍產吟頌\', \'text\': \'對每個由你操控的生物而言，你可以從你的牌庫中搜尋一張與該生物同名的生物牌。 將這些牌放進戰場，然後將你的牌庫洗牌。\', \'type\': \'巫術\', \'flavor\': \'有什麼比樹林的每種野獸都出現一隻更可怕？\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263296&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3b719ba7-6100-4c80-bc19-c79836745261\', \'multiverseId\': 263296}, \'multiverseid\': 263296}]', '[{\'name\': \'Verfroschen\', \'text\': \'Eine Kreatur deiner Wahl verliert alle Fähigkeiten und wird bis zum Ende des Zuges zu einem 1/1 blauen Frosch.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Quaaak."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263702&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'97195e60-e8a3-4de6-a770-90d5990800ec\', \'multiverseId\': 263702}, \'multiverseid\': 263702}, {\'name\': \'Convertir en rana\', \'text\': \'La criatura objetivo pierde todas sus habilidades y se convierte en una Rana azul 1/1 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"Croac."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264947&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f239819f-902d-407a-8647-4fd8a673ae05\', \'multiverseId\': 264947}, \'multiverseid\': 264947}, {\'name\': \'Transformation en grenouille\', \'text\': "La créature ciblée perd toutes ses capacités et devient une grenouille 1/1 bleue jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': \'« Coâ. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263453&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4df209b2-1258-4a7b-974c-18fa31f9782a\', \'multiverseId\': 263453}, \'multiverseid\': 263453}, {\'name\': \'Tramutare in Rana\', \'text\': \'Una creatura bersaglio perde tutte le abilità e diventa una Rana 1/1 blu fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Cra cra."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263951&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dfae06d8-3833-45db-8e63-0698f53071f7\', \'multiverseId\': 263951}, \'multiverseid\': 263951}, {\'name\': \'蛙変化\', \'text\': \'クリーチャー１体を対象とする。それはターン終了時まで、すべての能力を失うとともに青の１/１のカエルになる。\', \'type\': \'インスタント\', \'flavor\': \'「ゲコッ」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264200&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c04f0b53-499c-48d9-89a5-34b255497a8b\', \'multiverseId\': 264200}, \'multiverseid\': 264200}, {\'name\': \'개구리로 변신\', \'text\': \'생물 한 개를 목표로 정한다. 그 생물은 턴종료까지 모든 능력을 잃고 1/1 청색 개구리 생물로 변한다.\', \'type\': \'순간마법\', \'flavor\': \'"개굴."\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'704b5a31-34dc-48e2-aa10-6bc03afd6e7d\'}, \'multiverseid\': None}, {\'name\': \'Transformar em Sapo\', \'text\': \'A criatura alvo perde todas as habilidades e torna-se uma criatura azul 1/1 do tipo Sapo até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Ueberte".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264449&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2a0b701b-e976-4fc0-b863-9f834f71a3d3\', \'multiverseId\': 264449}, \'multiverseid\': 264449}, {\'name\': \'Превращение в Лягушку\', \'text\': \'Целевое существо теряет все способности и становится 1/1 синей Лягушкой до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Ква!»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264698&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b29ef4cc-4ee6-48ba-961d-c67787b76a36\', \'multiverseId\': 264698}, \'multiverseid\': 264698}, {\'name\': \'化蛙术\', \'text\': \'直到回合结束，目标生物失去所有异能，并成为1/1蓝色蛙。\', \'type\': \'瞬间\', \'flavor\': \'「呱呱。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262955&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cba6b902-839a-46a9-b9e7-08602fbdf525\', \'multiverseId\': 262955}, \'multiverseid\': 262955}, {\'name\': \'化蛙術\', \'text\': \'直到回合結束，目標生物失去所有異能，並成為1/1藍色蛙。\', \'type\': \'瞬間\', \'flavor\': \'「呱呱。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263204&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c04deba4-ebe4-4da4-bde2-371180a778ec\', \'multiverseId\': 263204}, \'multiverseid\': 263204}]', '[{\'name\': \'Vergessenheitsring\', \'text\': \'Wenn der Vergessenheitsring ins Spiel kommt, schicke eine andere bleibende Karte deiner Wahl ins Exil, die kein Land ist.\\nWenn der Vergessenheitsring das Spiel verlässt, bringe die ins Exil geschickte Karte unter der Kontrolle ihres Besitzers ins Spiel zurück.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263651&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ccad1e17-bafe-45f5-a1a4-3ef823cb52fc\', \'multiverseId\': 263651}, \'multiverseid\': 263651}, {\'name\': \'Anillo del olvido\', \'text\': \'Cuando el Anillo del olvido entre al campo de batalla, exilia otro permanente objetivo que no sea tierra.\\nCuando el Anillo del olvido deje el campo de batalla, regresa la carta exiliada al campo de batalla bajo el control de su propietario.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264896&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8c981d45-1421-467d-9c2f-4dff6b5f540a\', \'multiverseId\': 264896}, \'multiverseid\': 264896}, {\'name\': "Cercle de l\'oubli", \'text\': "Quand le Cercle de l\'oubli arrive sur le champ de bataille, exilez un autre permanent non-terrain ciblé.\\nQuand le Cercle de l\'oubli quitte le champ de bataille, renvoyez, sous le contrôle de son propriétaire, la carte exilée sur le champ de bataille.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263402&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4fdfd300-b59a-42d1-8bd8-db43d7d07cef\', \'multiverseId\': 263402}, \'multiverseid\': 263402}, {\'name\': "Anello dell\'Oblio", \'text\': "Quando l\'Anello dell\'Oblio entra nel campo di battaglia, esilia un altro permanente non terra bersaglio.\\nQuando l\'Anello dell\'Oblio lascia il campo di battaglia, rimetti la carta esiliata sul campo di battaglia sotto il controllo del suo proprietario.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263900&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d4a45bab-9aa4-481f-b5f9-1dcc04030934\', \'multiverseId\': 263900}, \'multiverseid\': 263900}, {\'name\': \'忘却の輪\', \'text\': \'忘却の輪が戦場に出たとき、他の土地でないパーマネント１つを対象とし、それを追放する。\\n忘却の輪が戦場を離れたとき、その追放されたカードをオーナーのコントロール下で戦場に戻す。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264149&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5e43bd62-4fd6-4640-8d13-6a5dcd1722be\', \'multiverseId\': 264149}, \'multiverseid\': 264149}, {\'name\': \'망각륜\', \'text\': \'망각륜이 전장에 들어올 때, 대지가 아닌 다른 지속물 한 개를 목표로 정해서 추방한다.망각륜이 전장을 떠날 때, 그 추방된 카드를 소유자의 조종하에 전장으로 되돌린다.\', \'type\': \'부여마법\', \'flavor\': None, \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'df373f8e-4ac3-4ec3-b3e0-3bf769dd45f3\'}, \'multiverseid\': None}, {\'name\': \'Anel do Esquecimento\', \'text\': \'Quando Anel do Esquecimento entrar no campo de batalha, exile outra permanente alvo que não seja um terreno.\\nQuando Anel do Esquecimento deixar o campo de batalha, devolva o card exilado ao campo de batalha sob o controle de seu dono.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264398&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cbc0d4a5-41f3-460c-836a-01acfb6b2307\', \'multiverseId\': 264398}, \'multiverseid\': 264398}, {\'name\': \'Кольцо Забвения\', \'text\': \'Когда Кольцо Забвения выходит на поле битвы, изгоните другой целевой перманент, не являющийся землей.\\nКогда Кольцо Забвения покидает поле битвы, верните ту изгнанную карту на поле битвы под контролем ее владельца.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264647&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0c0d869e-405f-402b-a574-cdf6f71c92c8\', \'multiverseId\': 264647}, \'multiverseid\': 264647}, {\'name\': \'遗忘轮\', \'text\': \'当遗忘轮进战场时，放逐另一个目标非地永久物。\\n当遗忘轮离开战场时，将所放逐的牌在其拥有者的操控下移回战场。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262904&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0601c2f9-d609-4cc5-b404-579ad35f96ad\', \'multiverseId\': 262904}, \'multiverseid\': 262904}, {\'name\': \'遺忘輪\', \'text\': \'當遺忘輪進戰場時，放逐另一個目標非地永久物。\\n當遺忘輪離開戰場時，將所放逐的牌在其擁有者的操控下移回戰場。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263153&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d66749ab-7da2-4bfc-a660-b19113f3f45b\', \'multiverseId\': 263153}, \'multiverseid\': 263153}]', "[{'name': 'Verrosteter Wachposten', 'text': 'Der Verrostete Wachposten kommt getappt ins Spiel.', 'type': 'Artefaktkreatur — Golem', 'flavor': 'Er muss erst einen Moment nachdenken, wie er dich am besten überwältigt.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263839&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f3faacc1-459c-4733-8def-be2c3d79e352', 'multiverseId': 263839}, 'multiverseid': 263839}, {'name': 'Centinela oxidado', 'text': 'El Centinela oxidado entra al campo de batalla girado.', 'type': 'Criatura artefacto — Gólem', 'flavor': 'Se toma un momento para pensar la mejor manera de romperte la cara.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265084&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '044d6001-5f7a-433f-bc0b-15581c617689', 'multiverseId': 265084}, 'multiverseid': 265084}, {'name': 'Sentinelle rouillée', 'text': 'La Sentinelle rouillée arrive sur le champ de bataille engagée.', 'type': 'Créature-artefact : golem', 'flavor': 'Il lui faut un instant de délibération pour déterminer le meilleur moyen de vous casser la figure.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263590&type=card', 'language': 'French', 'identifiers': {'scryfallId': '19a2a010-5dd5-4182-b94e-50f99fa00a60', 'multiverseId': 263590}, 'multiverseid': 263590}, {'name': 'Sentinella Arrugginita', 'text': 'La Sentinella Arrugginita entra nel campo di battaglia TAPpata.', 'type': 'Creatura Artefatto — Golem', 'flavor': 'Deve riflettere per un attimo sul modo migliore di spaccarti la faccia.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264088&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '05f30b30-c2f4-4064-ba9d-a203c87c7e70', 'multiverseId': 264088}, 'multiverseid': 264088}, {'name': '錆びた歩哨', 'text': '錆びた歩哨はタップ状態で戦場に出る。', 'type': 'アーティファクト・クリーチャー — ゴーレム', 'flavor': '最善の術をもって当たるには、少々の熟慮が必要だ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264337&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '728e122d-c468-4ad4-995d-0edd28e85afd', 'multiverseId': 264337}, 'multiverseid': 264337}, {'name': '녹슨 보초골렘', 'text': '녹슨 보초골렘은 탭된 채로 전장에 들어온다.', 'type': '마법물체 생물 — 골렘', 'flavor': '저 녀석은 네 얼굴을 박살낼 최선책을 찾기 위해 잠깐 멈칫거린 것뿐이다.', 'language': 'Korean', 'identifiers': {'scryfallId': 'a0bd39af-c102-4e26-943b-1ab0e1a15288'}, 'multiverseid': None}, {'name': 'Sentinela Enferrujado', 'text': 'Sentinela Enferrujado entra no campo de batalha virado.', 'type': 'Criatura Artefato — Golem', 'flavor': 'Ele precisa pensar um pouco sobre o melhor modo de quebrar a sua cara.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264586&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '6f981edc-be51-46c3-b037-8f5305f95fa3', 'multiverseId': 264586}, 'multiverseid': 264586}, {'name': 'Ржавый Часовой', 'text': 'Ржавый Часовой выходит на поле битвы повернутым.', 'type': 'Артефактное Существо — Голем', 'flavor': 'Ему нужно минуточку подумать, как лучше разбить вам лицо.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264835&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '34fae59c-9f41-43c0-baae-9a66b6e74f96', 'multiverseId': 264835}, 'multiverseid': 264835}, {'name': '生锈哨兵', 'text': '生锈哨兵须横置进战场。', 'type': '神器生物～魔像', 'flavor': '它必须花点时间挑选把你脸打碎的最好方法。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263092&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'd49574c8-e2b3-4e68-b4a7-31c58e3a4177', 'multiverseId': 263092}, 'multiverseid': 263092}, {'name': '生銹哨兵', 'text': '生銹哨兵須橫置進戰場。', 'type': '神器生物～魔像', 'flavor': '它必須花點時間挑選把你臉打碎的最好方法。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263341&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '9b5660e6-a0cc-4f32-bc25-68e3a8fdc66b', 'multiverseId': 263341}, 'multiverseid': 263341}]", '[{\'name\': \'Verräterische Tat\', \'text\': \'Übernimm die Kontrolle über eine Kreatur deiner Wahl bis zum Ende des Zuges. Enttappe diese Kreatur. Sie erhält Eile bis zum Ende des Zuges. (Sie kann in diesem Zug angreifen und {T}.)\', \'type\': \'Hexerei\', \'flavor\': \'„Zorn wallt in jedem Herzen und versucht, aus seinem Gefängnis der Vernunft auszubrechen." —Sarkhan Vol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263745&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'680e7221-9462-43ef-b5ca-364ccdcbe77e\', \'multiverseId\': 263745}, \'multiverseid\': 263745}, {\'name\': \'Acto de traición\', \'text\': \'Gana el control de la criatura objetivo hasta el final del turno. Endereza esa criatura. Gana la habilidad de prisa hasta el final del turno. (Puede atacar y {T} este turno.)\', \'type\': \'Conjuro\', \'flavor\': \'"La furia existe en todos los corazones, amenazando con traicionar su prisión racional." —Sarkhan Vol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264990&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7d5a6906-432e-488b-b818-a37398a1bded\', \'multiverseId\': 264990}, \'multiverseid\': 264990}, {\'name\': \'Acte de trahison\', \'text\': "Acquérez le contrôle de la créature ciblée jusqu\'à la fin du tour. Dégagez cette créature. Elle acquiert la célérité jusqu\'à la fin du tour. (Elle peut attaquer et {T} ce tour-ci.)", \'type\': \'Rituel\', \'flavor\': \'« La rage bout dans chaque cœur, menaçant à chaque instant de trahir sa prison rationnelle. » —Sarkhan Vol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263496&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cf3805d4-6c00-4221-8ca2-46e70cced311\', \'multiverseId\': 263496}, \'multiverseid\': 263496}, {\'name\': \'Atto di Tradimento\', \'text\': \'Prendi il controllo di una creatura bersaglio fino alla fine del turno. STAPpa quella creatura. Ha rapidità fino alla fine del turno. (Può attaccare e {T} in questo turno.)\', \'type\': \'Stregoneria\', \'flavor\': \'"L\\\'ira scorre in ogni cuore, desiderando tradire la sua prigione razionale." —Sarkhan Vol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263994&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3b182822-e2ae-4715-ad3e-0ec2b846b8a9\', \'multiverseId\': 263994}, \'multiverseid\': 263994}, {\'name\': \'反逆の行動\', \'text\': \'クリーチャー１体を対象とし、ターン終了時までそれのコントロールを得る。 そのクリーチャーをアンタップする。 それはターン終了時まで速攻を得る。 （このターン、それは攻撃したり{T}したりできる。）\', \'type\': \'ソーサリー\', \'flavor\': \'「怒りは誰の心の中にもあり、道理の檻を抜けることを求め続けている。」 ――サルカン・ヴォル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264243&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a951dc49-064f-4cf8-b7ac-58c908f2b3fb\', \'multiverseId\': 264243}, \'multiverseid\': 264243}, {\'name\': \'반역 행위\', \'text\': \'생물 한 개를 목표로 정한다. 당신은 턴종료까지 그 생물의 조종권을 얻는다. 그 생물을 언탭한다. 그 생물은 턴종료까지 신속 능력을 얻는다. (그 생물은 이 턴에 공격할 수도 있고 할 수도 있다.)\', \'type\': \'집중마법\', \'flavor\': \'"누구의 마음 속에나 분노가 존재하지. 이성이라는 감옥을 벗어나고 싶어하는 분노 말이야."—사르칸 볼\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'236995e8-0436-4e48-b12e-22fc3136bcd3\'}, \'multiverseid\': None}, {\'name\': \'Ato de Traição\', \'text\': \'Ganhe o controle da criatura alvo até o final do turno. Desvire aquela criatura. Ela ganha ímpeto até o final do turno. (Ela pode atacar e {T} neste turno.)\', \'type\': \'Feitiço\', \'flavor\': \'"O ódio mora em cada coração, ansioso para trair sua prisão racional." — Sarkhan Vol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264492&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'30d3cfe3-d1c1-4eaf-b589-03017d0d19b0\', \'multiverseId\': 264492}, \'multiverseid\': 264492}, {\'name\': \'Акт Измены\', \'text\': \'Получите контроль над целевым существом до конца хода. Разверните то существо. Оно получает Ускорение до конца хода. (Оно может атаковать и {T} в этом ходу.)\', \'type\': \'Волшебство\', \'flavor\': \'«Ярость стучит в каждом сердце и жаждет предать свой рациональный застенок». — Сархан Воль\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264741&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f035e4ca-e62c-42cb-8425-22e0d9a697d7\', \'multiverseId\': 264741}, \'multiverseid\': 264741}, {\'name\': \'叛行\', \'text\': \'获得目标生物的操控权直到回合结束。 重置该生物。 它获得敏捷异能直到回合结束。 （它此回合便能攻击与{T}。）\', \'type\': \'法术\', \'flavor\': \'「怒火在每颗心中奔流，嚷叫着要叛离这天生囚笼。」 ～萨坎沃\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262998&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5ba0e612-d2a6-46d8-b2c8-f85724c5d459\', \'multiverseId\': 262998}, \'multiverseid\': 262998}, {\'name\': \'叛行\', \'text\': \'獲得目標生物的操控權直到回合結束。 重置該生物。 它獲得敏捷異能直到回合結束。 （它此回合便能攻擊與{T}。）\', \'type\': \'巫術\', \'flavor\': \'「怒火在每顆心中奔流，嚷叫著要叛離這天生囚籠。」 ～薩坎沃\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263247&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b3ac2e0d-fa2c-43d3-aad0-161dee5b1e26\', \'multiverseId\': 263247}, \'multiverseid\': 263247}]', '[{\'name\': \'Verschlingender Schwarm\', \'text\': \'Fliegend\\nOpfere eine Kreatur: Der Verschlingende Schwarm erhält +1/+1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Insekt\', \'flavor\': \'Das ohrenbetäubende Sirren von zehntausend Flügeln kündigt ihre Ankunft an. Das Schweigen der Toten ist das Zeichen zum Aufbruch.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263715&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'92183907-7958-48a6-b716-b07851c562a3\', \'multiverseId\': 263715}, \'multiverseid\': 263715}, {\'name\': \'Enjambre devorador\', \'text\': \'Vuela.\\nSacrificar una criatura: El Enjambre devorador obtiene +1/+1 hasta el final del turno.\', \'type\': \'Criatura — Insecto\', \'flavor\': \'Su llegada es anunciada por el ensordecedor ruido de diez mil alas. Su partida está marcada por el silencio de los muertos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264960&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dafb8008-931c-41a2-aed3-032fdad0ff93\', \'multiverseId\': 264960}, \'multiverseid\': 264960}, {\'name\': \'Essaim dévorant\', \'text\': "Vol\\nSacrifiez une créature : L\'Essaim dévorant gagne +1/+1 jusqu\'à la fin du tour.", \'type\': \'Créature : insecte\', \'flavor\': \'Leur arrivée est annoncée par le bruissement assourdissant de dix mille ailes. Leur départ est marqué par le silence des morts.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263466&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3dfb34a6-0720-4648-94b9-5210ae8c8935\', \'multiverseId\': 263466}, \'multiverseid\': 263466}, {\'name\': \'Sciame Divoratore\', \'text\': \'Volare\\nSacrifica una creatura: Lo Sciame Divoratore prende +1/+1 fino alla fine del turno.\', \'type\': \'Creatura — Insetto\', \'flavor\': "Il loro arrivo è annunciato dall\'assordante ronzio di diecimila ali. La loro partenza è segnata dal silenzio dei morti.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263964&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'26d78ed8-2c45-43a8-8ab7-9220f8c2efc7\', \'multiverseId\': 263964}, \'multiverseid\': 263964}, {\'name\': \'貪る大群\', \'text\': \'飛行\\nクリーチャーを１体生け贄に捧げる：貪る大群は、ターン終了時まで＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — 昆虫\', \'flavor\': \'それが来る前には、耳をつんざくばかりの一万もの羽音が訪れる。 それが去った後には、死の静寂が残される。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264213&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f985268d-3640-4645-a17e-65fc3c2d2f55\', \'multiverseId\': 264213}, \'multiverseid\': 264213}, {\'name\': \'걸신들린 벌레떼\', \'text\': \'비행생물 한 개를 희생한다: 걸신들린 벌레뗴는 턴종료까지 +1/+1을 받는다.\', \'type\': \'생물 — 곤충\', \'flavor\': \'수만 개의 날개들이 윙윙거리는 소리가 들리면 그들이 온 것이다. 죽은 듯 고요해지면, 그들이 떠난 것이다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2c8930c7-842c-4f62-a2f3-6caa2fa1660d\'}, \'multiverseid\': None}, {\'name\': \'Enxame Devorador\', \'text\': \'Voar\\nSacrifique uma criatura: Enxame Devorador recebe +1/+1 até o final do turno.\', \'type\': \'Criatura — Inseto\', \'flavor\': \'Sua chegada foi anunciada pelo zumbido ensurdecedor de dez mil asas. Sua partida foi marcada pelo silêncio dos mortos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264462&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b44a7027-2abb-4c59-b67f-decb69800801\', \'multiverseId\': 264462}, \'multiverseid\': 264462}, {\'name\': \'Всепожирающий Рой\', \'text\': \'Полет\\nПожертвуйте существо: Всепожирающий Рой получает +1/+1 до конца хода.\', \'type\': \'Существо — Насекомое\', \'flavor\': \'Их пришествие возвещается оглушающим гудением десятков тысяч крыльев. Их уход сопровождается тишиной мертвых.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264711&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dfaa6a86-9d4d-4845-901d-bcad217407d2\', \'multiverseId\': 264711}, \'multiverseid\': 264711}, {\'name\': \'吞噬虫群\', \'text\': \'飞行\\n牺牲一个生物：吞噬虫群得+1/+1直到回合结束。\', \'type\': \'生物～昆虫\', \'flavor\': \'他们来时伴着千万翅翼的轰音。 他们去时留下亡者的寂静。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262968&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1329f14f-fcbb-4673-acdc-2e5f92f72d37\', \'multiverseId\': 262968}, \'multiverseid\': 262968}, {\'name\': \'吞噬蟲群\', \'text\': \'飛行\\n犧牲一個生物：吞噬蟲群得+1/+1直到回合結束。\', \'type\': \'生物～昆蟲\', \'flavor\': \'牠們來時伴著千萬翅翼的轟音。 牠們去時留下亡者的寂靜。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263217&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ff3e8c1f-51c8-4233-b829-ef3cac7fb1e0\', \'multiverseId\': 263217}, \'multiverseid\': 263217}]', '[{\'name\': \'Verschüttete Ruinen\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}.\\n{2}, {T}, opfere die Verschütteten Ruinen: Bringe eine Artefaktkarte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Land\', \'flavor\': \'Die Geschichte hat ihre Schätze tief vergraben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263848&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'00de4a00-d31d-443f-ab5f-b8b376d3c92c\', \'multiverseId\': 263848}, \'multiverseid\': 263848}, {\'name\': \'Ruina enterrada\', \'text\': \'{T}: Agrega {1} a tu reserva de maná.\\n{2}, {T}, sacrificar la Ruina enterrada: Regresa la carta de artefacto objetivo de tu cementerio a tu mano.\', \'type\': \'Tierra\', \'flavor\': \'La historia ha enterrado sus tesoros profundamente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265093&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3f04bc4c-2069-48d1-95a2-b0b6296b07fe\', \'multiverseId\': 265093}, \'multiverseid\': 265093}, {\'name\': \'Ruine ensevelie\', \'text\': "{T} : Ajoutez {1} à votre réserve., {T}, sacrifiez la Ruine ensevelie : Renvoyez une carte d\'artefact ciblée depuis votre cimetière dans votre main.", \'type\': \'Terrain\', \'flavor\': "L\'histoire a profondément enfoui ses trésors.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263599&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'570f64e6-1668-4921-ab46-2897f806726b\', \'multiverseId\': 263599}, \'multiverseid\': 263599}, {\'name\': \'Rovine Sepolte\', \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana.\\n{2}, {T}, Sacrifica le Rovine Sepolte: Riprendi in mano una carta artefatto bersaglio dal tuo cimitero.\', \'type\': \'Terra\', \'flavor\': \'La storia ha sepolto in profondità i suoi tesori.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264097&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9b967b71-9109-4628-ab41-fe1905eca632\', \'multiverseId\': 264097}, \'multiverseid\': 264097}, {\'name\': \'埋没した廃墟\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。\\n{2}, {T}, 埋没した廃墟を生け贄に捧げる：あなたの墓地にあるアーティファクト・カード１枚を対象とし、それをあなたの手札に戻す。\', \'type\': \'土地\', \'flavor\': \'歴史は自身の価値を深く埋める。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264346&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8a4776c1-be36-4a62-ba6b-ad7b2c79d9e4\', \'multiverseId\': 264346}, \'multiverseid\': 264346}, {\'name\': \'매몰된 폐허\', \'text\': \'{T}: {1}를 당신의 마나풀에 담는다.\\n{2}, {T}, 매몰된 폐허를 희생한다: 당신의 무덤에 있는 마법물체 카드 한 장을 목표로 정해 당신의 손으로 되돌린다.\', \'type\': \'대지\', \'flavor\': \'보물은 역사 속에 깊숙히 파묻힌다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1640c024-4bc1-4cf2-9219-8eaba584562c\'}, \'multiverseid\': None}, {\'name\': \'Ruína Enterrada\', \'text\': \'{T}: Adicione {1} à sua reserva de mana.\\n{2}, {T}, Sacrifique Ruína Enterrada: Devolva o card de artefato alvo de seu cemitério para sua mão.\', \'type\': \'Terreno\', \'flavor\': \'A história enterrou bem fundo seus tesouros.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264595&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5ac33a82-2bec-4d54-87b5-91465ea78458\', \'multiverseId\': 264595}, \'multiverseid\': 264595}, {\'name\': \'Погребенная Руина\', \'text\': \'{T}: добавьте {1} в ваше хранилище маны.\\n{2}, {T}, пожертвуйте Погребенную Руину: верните целевую карту артефакта из вашего кладбища в вашу руку.\', \'type\': \'Земля\', \'flavor\': \'История глубоко схоронила свои сокровища.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264844&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5c1075ff-2ae0-4ea5-b7b1-2555487d68ea\', \'multiverseId\': 264844}, \'multiverseid\': 264844}, {\'name\': \'深埋遗迹\', \'text\': \'{T}：加{1}到你的法术力池中。\\n{2}，{T}，牺牲深埋遗迹：将目标神器牌从你的坟墓场移回你手上。\', \'type\': \'地\', \'flavor\': \'历史深埋其宝藏。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263101&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a89474f6-2700-4d8c-8aa6-d9ab5a710ae7\', \'multiverseId\': 263101}, \'multiverseid\': 263101}, {\'name\': \'深埋遺跡\', \'text\': \'{T}：加{1}到你的魔法力池中。\\n{2}，{T}，犧牲深埋遺跡：將目標神器牌從你的墳墓場移回你手上。\', \'type\': \'地\', \'flavor\': \'歷史深埋其寶藏。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263350&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'adf2be90-18b8-415e-9109-6c7f7ff7433e\', \'multiverseId\': 263350}, \'multiverseid\': 263350}]', '[{\'name\': \'Versprechen des Wächters\', \'text\': \'Weiße Kreaturen, die du kontrollierst, erhalten +2/+2 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'Ein Dutzend, das gemeinsam kämpft, ist soviel wert wie tausend, die für sich kämpfen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263646&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'066ebe4d-95d8-4a63-9df4-f464954b93b9\', \'multiverseId\': 263646}, \'multiverseid\': 263646}, {\'name\': \'Promesa de los guardianes\', \'text\': \'Las criaturas blancas que controlas obtienen +2/+2 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'Una docena peleando por los suyos vale lo que un millar peleando por ellos mismos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264891&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'22bf551a-db9e-4bac-b613-8338a8519504\', \'multiverseId\': 264891}, \'multiverseid\': 264891}, {\'name\': \'Promesse des gardiens\', \'text\': "Les créatures blanches que vous contrôlez gagnent +2/+2 jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': "Une dizaine d\'hommes combattant côte à côte vaut largement mille hommes combattant chacun pour soi.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263397&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b9d8401c-660a-4db4-ba26-93efe95ea396\', \'multiverseId\': 263397}, \'multiverseid\': 263397}, {\'name\': \'Promessa dei Guardiani\', \'text\': \'Le creature bianche che controlli prendono +2/+2 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': "Una dozzina di soldati che combattono l\'uno per l\'altro vale come mille che combattono solo per se stessi.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263895&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'04ce4fbe-9a13-45f8-a7f5-20dfeddc3b1f\', \'multiverseId\': 263895}, \'multiverseid\': 263895}, {\'name\': \'護衛の誓約\', \'text\': \'あなたがコントロールする白のクリーチャーは、ターン終了時まで＋２/＋２の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'互いのために戦う十人は、己のためのみに戦う千人と同じ価値がある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264144&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2d967857-e3df-4aec-8e5f-6de5fe974a27\', \'multiverseId\': 264144}, \'multiverseid\': 264144}, {\'name\': \'수호자들의 다짐\', \'text\': \'당신이 조종하는 모든 백색 생물은 턴종료까지 +2/+2를 받는다.\', \'type\': \'순간마법\', \'flavor\': \'서로를 위해 싸우는 열 명은 자신만을 위해 싸우는 천 명과 맞먹는다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'75f14337-c973-4b4a-8c0d-59040f1838c5\'}, \'multiverseid\': None}, {\'name\': \'Promessa dos Guardiões\', \'text\': \'As criaturas brancas que você controla recebem +2/+2 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Uma dúzia lutando uns pelos outros equivale a mil lutando por si mesmos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264393&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'56f2fac5-4172-4fae-98e3-9256f72d0b61\', \'multiverseId\': 264393}, \'multiverseid\': 264393}, {\'name\': \'Обет Хранителей\', \'text\': \'Белые существа под вашим контролем получают +2/+2 до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Десяток воинов, сражающихся друг за друга, стоит тысячи, сражающихся сами за себя.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264642&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b2af8e6e-2f18-41ca-b826-d59d3b6faaa8\', \'multiverseId\': 264642}, \'multiverseid\': 264642}, {\'name\': \'守护誓言\', \'text\': \'由你操控的白色生物得+2/+2直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'同心协力打个十几回，要比单独作战几千次更加有用。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262899&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f9215465-9315-474d-883f-e584125d6a9c\', \'multiverseId\': 262899}, \'multiverseid\': 262899}, {\'name\': \'守護誓言\', \'text\': \'由你操控的白色生物得+2/+2直到回合結束。\', \'type\': \'瞬間\', \'flavor\': \'同心協力打個十幾回，要比單獨作戰幾千次更加有用。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263148&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ecad8934-dab5-4cc8-9f3d-016f0b1fadb9\', \'multiverseId\': 263148}, \'multiverseid\': 263148}]', '[{\'name\': \'Verstandeskontrolle\', \'text\': \'Kreaturenverzauberung\\nDu kontrollierst die verzauberte Kreatur.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Jeder primitive Verstand hat ein Motiv. Es ist einfach zu finden und leicht auszunutzen." —Noyan Dar, Ruhezauberer aus Tazeem\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263691&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'007b1fcd-de71-4c84-baa6-bde619f5d9f6\', \'multiverseId\': 263691}, \'multiverseid\': 263691}, {\'name\': \'Control mental\', \'text\': \'Encantar criatura.\\nTú controlas la criatura encantada.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"Toda mente primitiva tiene un motivo. Fácil de encontrar, y fácilmente aprovechable." —Noyan Dar, mago arrullador de Tazeem\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264936&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'901ec798-e400-456b-b2e5-f4fe0c8a222e\', \'multiverseId\': 264936}, \'multiverseid\': 264936}, {\'name\': \'Contrôle mental\', \'text\': \'Enchanter : créature\\nVous contrôlez la créature enchantée.\', \'type\': \'Enchantement : aura\', \'flavor\': \'« Tout esprit primitif a une motivation. Facile à trouver, et éminemment exploitable. » —Noyan Dar, ataraxmage de Tazeem\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263442&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f098eedb-c800-4818-b1d4-ce847143ec8d\', \'multiverseId\': 263442}, \'multiverseid\': 263442}, {\'name\': \'Controllo Mentale\', \'text\': \'Incanta creatura\\nControlli la creatura incantata.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Ogni mente primitiva ha una ragione. Facile da trovare e notevolmente sfruttabile." —Noyan Dar, mitigatore di Tazeem\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263940&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c4082453-31e0-43c0-b5da-49516b778cd1\', \'multiverseId\': 263940}, \'multiverseid\': 263940}, {\'name\': \'精神の制御\', \'text\': \'エンチャント（クリーチャー）\\nあなたはエンチャントされているクリーチャーをコントロールする。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「どんな原初の精神にも動機がある。 見つけるのは容易いし、利用も簡単だ。」 ――タジームの凪魔道士、ノヤン・ダール\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264189&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d65999a0-9fd6-4c1d-97e6-32d9e6e5aa35\', \'multiverseId\': 264189}, \'multiverseid\': 264189}, {\'name\': \'정신 제어\', \'text\': \'생물에게 부여당신이 부여된 생물을 조종한다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'"모든 정신에는 원초적으로 동기 인자라는 게 존재해. 찾기도 쉽고, 이용해먹기도 용이하지."—타짐의 정심술사 노얀 다르\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'fdc29064-f9f6-44fd-a743-1a2f103535de\'}, \'multiverseid\': None}, {\'name\': \'Controle da Mente\', \'text\': \'Encantar criatura\\nVocê controla a criatura encantada.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Toda mente primitiva possui uma motivação. Fácil de encontrar e altamente explorável." — Noyan Dar, Mago Anulador de Tazeem\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264438&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cb8793b2-4971-4fc5-8a9b-99571519ef31\', \'multiverseId\': 264438}, \'multiverseid\': 264438}, {\'name\': \'Контроль Разума\', \'text\': \'Зачаровать существо\\nВы контролируете зачарованное существо.\', \'type\': \'Чары — Аура\', \'flavor\': \'«У любого примитивного разума есть свои побуждения. Их можно легко найти и прекрасно использовать в собственных целях». — Нойен Дар, маг-баюн из Тазима\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264687&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c5d32cff-f769-43fc-a735-2c36fde39e0d\', \'multiverseId\': 264687}, \'multiverseid\': 264687}, {\'name\': \'心灵操控\', \'text\': \'结附于生物\\n你操控所结附的生物。\', \'type\': \'结界～灵气\', \'flavor\': \'「每个原始心灵都具有动机。 容易找到，也特别好利用。」 ～塔晋息法师诺言达\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262944&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6b633896-e887-41a4-a39e-c984472ff5aa\', \'multiverseId\': 262944}, \'multiverseid\': 262944}, {\'name\': \'心靈操控\', \'text\': \'結附於生物\\n你操控所結附的生物。\', \'type\': \'結界～靈氣\', \'flavor\': \'「每個原始心靈都具有動機。 容易找到，也特別好利用。」 ～塔晉息法師諾言達\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263193&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'54e233c4-841d-461b-bce0-9f1864837cc6\', \'multiverseId\': 263193}, \'multiverseid\': 263193}]', '[{\'name\': \'Versunkene Katakomben\', \'text\': \'Die Versunkenen Katakomben kommen getappt ins Spiel, falls du nicht eine Insel oder einen Sumpf kontrollierst.\\n{T}: Erhöhe deinen Manavorrat um {U} oder {B}.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263850&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3040a181-5c0b-4516-b3e2-7dc1e132c10d\', \'multiverseId\': 263850}, \'multiverseid\': 263850}, {\'name\': \'Catacumba inundada\', \'text\': \'La Catacumba inundada entra al campo de batalla girada a menos que controles una isla o un pantano.\\n{T}: Agrega {U} o {B} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265095&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ecb7aa91-4e84-416b-8e82-1517be98a55b\', \'multiverseId\': 265095}, \'multiverseid\': 265095}, {\'name\': \'Catacombes noyées\', \'text\': \'Les Catacombes noyées arrivent sur le champ de bataille engagées à moins que vous ne contrôliez une île ou un marais.\\n{T} : Ajoutez {U} ou {B} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263601&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'919e5198-bc71-4e79-92a9-8cef8592ce2e\', \'multiverseId\': 263601}, \'multiverseid\': 263601}, {\'name\': \'Catacombe Allagate\', \'text\': "Le Catacombe Allagate entrano nel campo di battaglia TAPpate a meno che tu non controlli un\'Isola o una Palude.\\n{T}: Aggiungi {U} o {B} alla tua riserva di mana.", \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264099&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9f4ea005-8f90-44ad-89c0-4ab77ced441c\', \'multiverseId\': 264099}, \'multiverseid\': 264099}, {\'name\': \'水没した地下墓地\', \'text\': \'水没した地下墓地は、あなたが島か沼をコントロールしていないかぎり、タップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{U}か{B}を加える。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264348&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'762be4c8-5e15-423a-87fe-44f45515ad3b\', \'multiverseId\': 264348}, \'multiverseid\': 264348}, {\'name\': \'수몰된 묘지\', \'text\': \'수몰된 묘지는 당신이 섬이나 늪을 조종하지 않으면 탭된 채로 전장에 들어온다.: 나 를 당신의 마나풀에 담는다.\', \'type\': \'대지\', \'flavor\': None, \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5cca209b-998b-4df1-ae3e-fb1ce849f2ff\'}, \'multiverseid\': None}, {\'name\': \'Catacumba Submersa\', \'text\': \'Catacumba Submersa entra no campo de batalha virado a menos que você controle uma Ilha ou um Pântano.\\n{T}: Adicione {U} ou {B} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264597&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c6736fe9-85ef-4b58-a78c-e466177f0cf5\', \'multiverseId\': 264597}, \'multiverseid\': 264597}, {\'name\': \'Затопленная Катакомба\', \'text\': \'Затопленная Катакомба выходит на поле битвы повернутой, если только под вашим контролем нет Острова или Болота.\\n{T}: добавьте {U} или {B} в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264846&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bab89e97-a4d1-4458-9385-8ab49c31c230\', \'multiverseId\': 264846}, \'multiverseid\': 264846}, {\'name\': \'水没墓穴\', \'text\': \'除非你操控海岛或沼泽，否则水没墓穴须横置进战场。\\n{T}：加{U}或{B}到你的法术力池中。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263103&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'09424134-5493-420a-8358-1842ec2dc637\', \'multiverseId\': 263103}, \'multiverseid\': 263103}, {\'name\': \'水沒墓穴\', \'text\': \'除非你操控海島或沼澤，否則水沒墓穴須橫置進戰場。\\n{T}：加{U}或{B}到你的魔法力池中。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263352&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'20c0f3f0-7b7c-49ca-b32a-73578def4c68\', \'multiverseId\': 263352}, \'multiverseid\': 263352}]', "[{'name': 'Verwurzelter Felsen', 'text': 'Der Verwurzelte Felsen kommt getappt ins Spiel, falls du nicht ein Gebirge oder einen Wald kontrollierst.\\n{T}: Erhöhe deinen Manavorrat um {R} oder {G}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263852&type=card', 'language': 'German', 'identifiers': {'scryfallId': '68afa0ff-bc78-45ad-876e-06c3478713e2', 'multiverseId': 263852}, 'multiverseid': 263852}, {'name': 'Risco enraizado', 'text': 'El Risco enraizado entra al campo de batalla girado a menos que controles una montaña o un bosque.\\n{T}: Agrega {R} o {G} a tu reserva de maná.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265097&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '7697aeb8-61db-4e59-98fe-d0691458c5c6', 'multiverseId': 265097}, 'multiverseid': 265097}, {'name': 'Mont enraciné', 'text': 'Le Mont enraciné arrive sur le champ de bataille engagé à moins que vous ne contrôliez une montagne ou une forêt.\\n{T} : Ajoutez {R} ou {G} à votre réserve.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263603&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b650af33-2012-47a0-9ef4-11d38cc0f07c', 'multiverseId': 263603}, 'multiverseid': 263603}, {'name': 'Dirupo delle Radici', 'text': 'Il Dirupo delle Radici entra nel campo di battaglia TAPpato a meno che tu non controlli una Montagna o una Foresta.\\n{T}: Aggiungi {R} o {G} alla tua riserva di mana.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264101&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3060a83c-2c4a-4755-968d-1cdff54da165', 'multiverseId': 264101}, 'multiverseid': 264101}, {'name': '根縛りの岩山', 'text': '根縛りの岩山は、あなたが山か森をコントロールしていないかぎり、タップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{R}か{G}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264350&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '0c08ac02-5ffa-4aa7-8158-ac05b5ac5f5d', 'multiverseId': 264350}, 'multiverseid': 264350}, {'name': '나무뿌리 바위산', 'text': '나무뿌리 바위산은 당신이 산이나 숲을 조종하지 않으면 탭된 채로 전장에 들어온다.: 나 를 당신의 마나풀에 담는다.', 'type': '대지', 'flavor': None, 'language': 'Korean', 'identifiers': {'scryfallId': '4a5e9d7e-628e-43ce-97df-ed454ee95701'}, 'multiverseid': None}, {'name': 'Penhasco do Raizame', 'text': 'Penhasco do Raizame entra no campo de batalha virado a menos que você controle uma Montanha ou uma Floresta.\\n{T}: Adicione {R} ou {G} à sua reserva de mana.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264599&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '030d5763-401b-4c7d-9bac-3f3332dc19b8', 'multiverseId': 264599}, 'multiverseid': 264599}, {'name': 'Обвитая Корнями Скала', 'text': 'Обвитая Корнями Скала выходит на поле битвы повернутой, если только под вашим контролем нет Горы или Леса.\\n{T}: добавьте {R} или {G} в ваше хранилище маны.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264848&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'd83f0272-30ae-4f86-829a-63b832b122ef', 'multiverseId': 264848}, 'multiverseid': 264848}, {'name': '盘根峭壁', 'text': '除非你操控山脉或树林，否则盘根峭壁须横置进战场。\\n{T}：加{R}或{G}到你的法术力池中。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263105&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '46194187-e652-4727-9df0-f3a35ecbdbad', 'multiverseId': 263105}, 'multiverseid': 263105}, {'name': '盤根峭壁', 'text': '除非你操控山脈或樹林，否則盤根峭壁須橫置進戰場。\\n{T}：加{R}或{G}到你的魔法力池中。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263354&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '1bafc3cd-0937-43ea-8fb4-f73ab15f04b3', 'multiverseId': 263354}, 'multiverseid': 263354}]", '[{\'name\': \'Vulkandrache\', \'text\': \'Fliegend\\nEile (Diese Kreatur kann angreifen und {T}, sobald sie unter deine Kontrolle kommt.)\', \'type\': \'Kreatur — Drache\', \'flavor\': \'Manchmal erzeugt ein Vulkanausbruch in Shiv mehr und gefährlicheres als nur einen Strom aus geschmolzenem Stein.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263782&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'11ee5fe6-3835-4ce1-9011-0deae752fec5\', \'multiverseId\': 263782}, \'multiverseid\': 263782}, {\'name\': \'Dragón volcánico\', \'text\': \'Vuela.\\nPrisa. (Esta criatura puede atacar y {T} tan pronto como entre bajo tu control.)\', \'type\': \'Criatura — Dragón\', \'flavor\': \'A veces una erupción en Shiv produce cosas más peligrosas que un río de roca fundida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265027&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'19d1cfba-78f2-4c53-b8d3-b48d60456e09\', \'multiverseId\': 265027}, \'multiverseid\': 265027}, {\'name\': \'Dragon des volcans\', \'text\': \'Vol\\nCélérité (Cette créature peut attaquer et {T} dès le tour où elle arrive sous votre contrôle.)\', \'type\': \'Créature : dragon\', \'flavor\': "Parfois, sur Shiv, une éruption produit quelque chose de plus dangereux qu\'un simple torrent de roche en fusion.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263533&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a94a91cf-200a-4832-baac-4156f8c10bd0\', \'multiverseId\': 263533}, \'multiverseid\': 263533}, {\'name\': \'Drago Vulcanico\', \'text\': \'Volare\\nRapidità (Questa creatura può attaccare e {T} non appena entra sotto il tuo controllo.)\', \'type\': \'Creatura — Drago\', \'flavor\': "Talvolta un\'eruzione in Shiv produce qualcosa di più pericoloso di un semplice fiume di roccia fusa.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264031&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7be93132-650b-4657-ba51-a63101e47acb\', \'multiverseId\': 264031}, \'multiverseid\': 264031}, {\'name\': \'火山のドラゴン\', \'text\': \'飛行速攻\\n （このクリーチャーは、あなたのコントロール下になってすぐに攻撃したり{T}したりできる。）\', \'type\': \'クリーチャー — ドラゴン\', \'flavor\': \'シヴ山での噴火は、流れる溶岩よりもさらに危険なものを生み出すことがある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264280&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9f09ee23-f67b-42f9-a2a3-eff1ad90a793\', \'multiverseId\': 264280}, \'multiverseid\': 264280}, {\'name\': \'화산룡\', \'text\': \'비행신속 (이 생물은 당신의 조종하에 들어오자마자 공격할 수도 있고 할 수도 있다.)\', \'type\': \'생물 — 용\', \'flavor\': \'때떄로 시브의 화산들은 용암보다 더 무서운 것을 배출하기도 한다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9e5c508e-22a4-451c-9630-09cd524ff484\'}, \'multiverseid\': None}, {\'name\': \'Dragão Vulcânico\', \'text\': \'Voar\\nÍmpeto (Esta criatura pode atacar e {T} assim que entra sob seu controle.)\', \'type\': \'Criatura — Dragão\', \'flavor\': \'Algumas vezes, uma erupção em Shiv pode gerar algo mais perigoso do que um mero rio de pedras derretidas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264529&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'00c4d014-cf9c-4104-b6a6-cf6a2d1e14a1\', \'multiverseId\': 264529}, \'multiverseid\': 264529}, {\'name\': \'Вулканический Дракон\', \'text\': \'Полет\\nУскорение (Это существо может атаковать и {T}, как только оно попадает под ваш контроль.)\', \'type\': \'Существо — Дракон\', \'flavor\': \'Иногда извержение в Шиванских горах производит на свет нечто более опасное, чем обычную реку расплавленной лавы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264778&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'22a0b0d5-38c9-48e4-ab99-ec17fb7f38f3\', \'multiverseId\': 264778}, \'multiverseid\': 264778}, {\'name\': \'火山龙\', \'text\': \'飞行\\n敏捷 （此生物受你操控时便能攻击与{T}。）\', \'type\': \'生物～龙\', \'flavor\': \'西瓦的火山爆发所造成的危险，有时不仅是熔岩奔流而已。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263035&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cef0b6e3-e3d8-41be-9db7-d1090f2c141f\', \'multiverseId\': 263035}, \'multiverseid\': 263035}, {\'name\': \'火山龍\', \'text\': \'飛行\\n敏捷 （此生物受你操控時便能攻擊與{T}。）\', \'type\': \'生物～龍\', \'flavor\': \'西瓦的火山爆發所造成的危險，有時不僅是熔岩奔流而已。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263284&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9b4933ec-dce5-44d3-92bc-1e4b585c7c43\', \'multiverseId\': 263284}, \'multiverseid\': 263284}]', "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263870&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f350caf3-15db-4e2b-9e53-367932a5370f', 'multiverseId': 263870}, 'multiverseid': 263870}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265115&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '0aac915d-c253-480e-a0ae-d722445aa8ae', 'multiverseId': 265115}, 'multiverseid': 265115}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263621&type=card', 'language': 'French', 'identifiers': {'scryfallId': '5001719d-6972-4e84-b9ff-09008658648c', 'multiverseId': 263621}, 'multiverseid': 263621}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264119&type=card', 'language': 'Italian', 'identifiers': {'scryf