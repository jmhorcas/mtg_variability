dentifiers': {'scryfallId': '8417a227-686a-430b-be6a-56c2d07f5e97', 'multiverseId': 265114}, 'multiverseid': 265114}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263620&type=card', 'language': 'French', 'identifiers': {'scryfallId': '9df79c23-5f8f-41c4-a222-26ae9b45fea2', 'multiverseId': 263620}, 'multiverseid': 263620}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264118&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '7b8a8350-932f-4128-8e90-d65440547b9b', 'multiverseId': 264118}, 'multiverseid': 264118}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264367&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'd5b383d9-d57b-4d1f-9e3e-53e93acef12d', 'multiverseId': 264367}, 'multiverseid': 264367}, {'name': '산', 'type': '기본 대지 — 산', 'flavor': None, 'language': 'Korean', 'identifiers': {'scryfallId': '8fabdff1-b624-4e85-b305-d45029c44f32'}, 'multiverseid': None}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264616&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '149e119b-36ed-43a6-ad37-dbb92892be58', 'multiverseId': 264616}, 'multiverseid': 264616}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264865&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '38103ba1-4697-408a-bde1-5c6b9a71ef4f', 'multiverseId': 264865}, 'multiverseid': 264865}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263122&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '8d81f174-de37-415a-9932-2709f0ce3194', 'multiverseId': 263122}, 'multiverseid': 263122}, {'name': '山脈', 'type': '基本地～山脈', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263371&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '4732dc33-63d3-4668-a8bb-35b4667fd13a', 'multiverseId': 263371}, 'multiverseid': 263371}]", '[{\'name\': \'Gedankenzersetzung\', \'text\': \'Ein Spieler deiner Wahl wirft zwei Karten aus seiner Hand ab.\', \'type\': \'Hexerei\', \'flavor\': \'Nicht jeder Gedanke ist gleich gut.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263725&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4e34bfa6-3e07-46d8-8817-6c463b5cdf56\', \'multiverseId\': 263725}, \'multiverseid\': 263725}, {\'name\': \'Podredumbre mental\', \'text\': \'El jugador objetivo descarta dos cartas.\', \'type\': \'Conjuro\', \'flavor\': \'No todos los pensamientos son buenos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264970&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'736a093d-56fd-433e-bd66-19cf11568304\', \'multiverseId\': 264970}, \'multiverseid\': 264970}, {\'name\': \'Pourrissement cérébral\', \'text\': \'Le joueur ciblé se défausse de deux cartes.\', \'type\': \'Rituel\', \'flavor\': "Toute pensée n\'est pas forcément bonne.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263476&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'95ea4add-8c10-4a96-8295-a9a48fbd8ed3\', \'multiverseId\': 263476}, \'multiverseid\': 263476}, {\'name\': \'Cancrena della Mente\', \'text\': \'Un giocatore bersaglio scarta due carte.\', \'type\': \'Stregoneria\', \'flavor\': \'Non tutti i pensieri sono buoni.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263974&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'47b58191-c649-429f-8d65-9f6dd75d70d7\', \'multiverseId\': 263974}, \'multiverseid\': 263974}, {\'name\': \'精神腐敗\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーはカードを２枚捨てる。\', \'type\': \'ソーサリー\', \'flavor\': \'全ての思考が良い物とは限らない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264223&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b5c6749d-9043-4e98-bb90-dab3b8bd0a5e\', \'multiverseId\': 264223}, \'multiverseid\': 264223}, {\'name\': \'정신 부패\', \'text\': \'플레이어 한 명을 목표로 정한다. 그 플레이어는 카드 두 장을 버린다.\', \'type\': \'집중마법\', \'flavor\': \'생각이라 해서 다 좋은 건 아니다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'80f50877-1d4b-4b56-a2b2-651ad97117b8\'}, \'multiverseid\': None}, {\'name\': \'Estiolar a Mente\', \'text\': \'O jogador alvo descarta dois cards.\', \'type\': \'Feitiço\', \'flavor\': \'Nem todos os pensamentos são bons.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264472&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'25f56673-655a-4f6f-adcc-0b15136011e3\', \'multiverseId\': 264472}, \'multiverseid\': 264472}, {\'name\': \'Гниение Разума\', \'text\': \'Целевой игрок сбрасывает две карты.\', \'type\': \'Волшебство\', \'flavor\': \'Не каждая мысль — хорошая.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264721&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'30cae931-b7fb-4fbe-b8d7-4b21012e8c56\', \'multiverseId\': 264721}, \'multiverseid\': 264721}, {\'name\': \'心之衰\', \'text\': \'目标牌手弃两张牌。\', \'type\': \'法术\', \'flavor\': \'思想不全都是好的。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262978&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'36e8e69f-4fd2-4786-8e9c-b0a46f198d08\', \'multiverseId\': 262978}, \'multiverseid\': 262978}, {\'name\': \'心之衰\', \'text\': \'目標玩家棄兩張牌。\', \'type\': \'巫術\', \'flavor\': \'思想不全都是好的。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263227&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a1f0ef3b-e90c-4215-9061-fbf7e25e3979\', \'multiverseId\': 263227}, \'multiverseid\': 263227}]', '[{\'name\': \'Geistermantel\', \'text\': \'Kreaturenverzauberung\\nDie verzauberte Kreatur erhält +1/+1 und Schutz vor Kreaturen. (Sie kann von keinen Kreaturen geblockt oder als Ziel bestimmt werden und von ihnen keinen Schaden zugefügt bekommen.)\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Diese Hülle aus unantastbarer Reinheit schützt so gut wie jede geschmiedete.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263659&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2678f5d1-7511-46f5-94d3-6f54a7fade0e\', \'multiverseId\': 263659}, \'multiverseid\': 263659}, {\'name\': \'Manto espiritual\', \'text\': \'Encantar criatura.\\nLa criatura encantada obtiene +1/+1 y tiene protección contra criaturas. (No puede ser bloqueada, hecha objetivo o recibir daño de criaturas.)\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'El escudo de pureza intachable es tan fuerte como algo forjado en el yunque.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264904&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'342d1f99-a9a5-4ef5-b23e-eddfdad84f0a\', \'multiverseId\': 264904}, \'multiverseid\': 264904}, {\'name\': "Manteau d\'esprits", \'text\': \'Enchanter : créature\\nLa créature enchantée gagne +1/+1 et a la protection contre les créatures. (Elle ne peut pas être bloquée, ciblée ou subir de blessures de créatures.)\', \'type\': \'Enchantement : aura\', \'flavor\': "Un bouclier de pureté incorruptible est aussi fort qu\'un bouclier forgé sur l\'enclume.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263410&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'265bc5d1-bdd5-4bb9-ada0-ec666847a5f4\', \'multiverseId\': 263410}, \'multiverseid\': 263410}, {\'name\': \'Manto Spirituale\', \'text\': \'Incanta creatura\\nLa creatura incantata prende +1/+1 e ha protezione dalle creature. (Non può essere bloccata, bersagliata e non le può essere inflitto danno dalle creature.)\', \'type\': \'Incantesimo — Aura\', \'flavor\': "Lo scudo di indiscutibile purezza è forte quanto uno scudo lavorato sull\'incudine.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263908&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e80f1523-e89b-43ff-9baa-01de5de18452\', \'multiverseId\': 263908}, \'multiverseid\': 263908}, {\'name\': \'霊魂のマントル\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは＋１/＋１の修整を受けるとともにプロテクション（クリーチャー）を持つ。 （それはクリーチャーによって、ブロックされず、対象にならず、ダメージを与えられない。）\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'非の打ち所の無い純潔さの盾は、金床の上で鍛えられたものと同じぐらいに強い。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264157&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2dac79bd-9f2e-4ff8-b570-ac599f690307\', \'multiverseId\': 264157}, \'multiverseid\': 264157}, {\'name\': \'기백의 외투막\', \'text\': \'생물에게 부여부여된 생물은 +1/+1을 받고 생물로부터 보호 능력을 가진다. (생물로부터 보호를 가진 생물은 생물에 의해 방어당할 수도 없고, 목표로 정해질 수도 없으며, 피해를 입을 수도 없다.)\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'완선한 순수성의 방패는 모루에서 단련된 것에도 뒤지지 않는다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9b1eddc1-5d75-45e5-9927-e3cf1394fdc3\'}, \'multiverseid\': None}, {\'name\': \'Manto Espiritual\', \'text\': \'Encantar criatura\\nA criatura encantada recebe +1/+1 e tem proteção contra criaturas. (Ela não pode ser bloqueada, ser alvo nem sofrer dano de criaturas.)\', \'type\': \'Encantamento — Aura\', \'flavor\': \'O escudo de pureza irrepreensível é tão forte quanto qualquer outro forjado na bigorna.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264406&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5363b199-b618-4237-97dd-e5a0db67c25a\', \'multiverseId\': 264406}, \'multiverseid\': 264406}, {\'name\': \'Мантия Духа\', \'text\': \'Зачаровать существо\\nЗачарованное существо получает +1/+1 и имеет Защиту от существ. (Существа не могут блокировать его, делать его своей целью и наносить ему повреждения.)\', \'type\': \'Чары — Аура\', \'flavor\': \'Безупречная чистота — такой же прочный щит, как и выкованный на наковальне.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264655&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c4638c1c-1e4f-4d41-be78-9e7b92e6fc9e\', \'multiverseId\': 264655}, \'multiverseid\': 264655}, {\'name\': \'精魂披风\', \'text\': \'结附于生物\\n所结附的生物得+1/+1且具有反生物保护。 （它不能被任何生物所阻挡，指定为目标，或是造成伤害。）\', \'type\': \'结界～灵气\', \'flavor\': \'纯真无瑕之护盾就像铁砧锻造出来的一样坚强。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262912&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e2ff5171-9b27-4137-89db-9919152f31f5\', \'multiverseId\': 262912}, \'multiverseid\': 262912}, {\'name\': \'精魂披風\', \'text\': \'結附於生物\\n所結附的生物得+1/+1且具有反生物保護。 （它不能被任何生物所阻擋，指定為目標，或是造成傷害。）\', \'type\': \'結界～靈氣\', \'flavor\': \'純真無瑕之護盾就像鐵砧鍛造出來的一樣堅強。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263161&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a48f3710-8f44-4ba9-b12b-72bca14f0bce\', \'multiverseId\': 263161}, \'multiverseid\': 263161}]', '[{\'name\': \'Geistesverbrauch\', \'text\': \'Verwende nur schwarzes Mana für X.\\nGeistesverbrauch fügt einer Kreatur oder einem Spieler deiner Wahl X Schadenspunkte zu, und du erhältst X Lebenspunkte dazu.\', \'type\': \'Hexerei\', \'flavor\': \'„Deine Kleriker prahlen mit der Stärke deines Geistes, doch du brichst ja schon zusammen, wenn ich nur das kleinste Stückchen davon wegnehme." —Sorin Markov\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263712&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dc106049-acd7-4d05-a0c5-59f8784e7faa\', \'multiverseId\': 263712}, \'multiverseid\': 263712}, {\'name\': \'Consumir el espíritu\', \'text\': \'Usa sólo maná negro para pagar X.\\nConsumir el espíritu hace X puntos de daño a la criatura o jugador objetivo y ganas X vidas.\', \'type\': \'Conjuro\', \'flavor\': \'"Tus clérigos se jactan de la fuerza del espíritu, pero te quito el trozo más pequeño de él y te desarmas como una muñeca de trapo." —Sorin Markov\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264957&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'740bf37a-7918-4240-a8c7-642ff5c26600\', \'multiverseId\': 264957}, \'multiverseid\': 264957}, {\'name\': "Absorption de l\'esprit", \'text\': "Ne dépensez que du mana noir pour X.\\nL\'Absorption de l\'esprit inflige X blessures à une cible, créature ou joueur, et vous gagnez X points de vie.", \'type\': \'Rituel\', \'flavor\': "« Vous, les clercs, vous proclamez sans cesse votre force d\'esprit et pourtant, dès que j\'en prends une partie infime, vous vous écroulez comme une poupée de chiffon. » —Sorin Markov", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263463&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7d86a460-c520-4e3a-8d37-a8e44807c00d\', \'multiverseId\': 263463}, \'multiverseid\': 263463}, {\'name\': \'Spirito Struggente\', \'text\': \'Spendi solo mana nero per X.\\nLo Spirito Struggente infligge X danni a una creatura o a un giocatore bersaglio e tu guadagni X punti vita.\', \'type\': \'Stregoneria\', \'flavor\': \'"Voi chierici vi vantate della vostra forza di spirito, eppure strappo via il più minuscolo dei frammenti e ti accasci come una bambola di pezza." —Sorin Markov\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263961&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f45274b7-1d8e-414a-ab69-00d217d2ab6b\', \'multiverseId\': 263961}, \'multiverseid\': 263961}, {\'name\': \'魂の消耗\', \'text\': \'Ｘは黒マナでしか支払えない。\\nクリーチャー１体かプレイヤー１人を対象とする。魂の消耗はそれにＸ点のダメージを与え、あなたはＸ点のライフを得る。\', \'type\': \'ソーサリー\', \'flavor\': \'「お前達の僧は魂の強さを自慢するのだろうが、私がほんの欠片でも取り去れば、お前などぼろ人形のように崩れ落ちるのだ。」 ――ソリン・マルコフ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264210&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eba994bf-0d7d-448e-aa99-733d065bea12\', \'multiverseId\': 264210}, \'multiverseid\': 264210}, {\'name\': \'영혼 섭취\', \'text\': \'X에는 흑색 마나만을 사용한다.생물 한 개나 플레이어 한 명을 목표로 정한다. 영혼 섭취는 그 목표에게 피해 X점을 입히고, 당신은 생명 X점을 얻는다.\', \'type\': \'집중마법\', \'flavor\': \'"너희 성직자들은 정신력이 뛰어나다고들 하던데, 내가 조금 앗아갔다고 헝겊 인형마냥 쪼그라들어서야 되겠나."—소린 마르코프\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0677e2d8-08a4-453a-b147-76e8229bfca7\'}, \'multiverseid\': None}, {\'name\': \'Consumir o Espírito\', \'text\': \'Use somente mana preto para pagar X.\\nConsumir o Espírito causa X pontos de dano à criatura ou ao jogador alvo e você ganha X pontos de vida.\', \'type\': \'Feitiço\', \'flavor\': \'"Seus clérigos sempre enalteceram sua força de espírito, entretanto, basta eu remover um minúsculo fragmento para você desabar como uma boneca de pano." — Sorin Markov\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264459&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1e0bcf83-dc06-40b0-8cbe-64d126ac0f8b\', \'multiverseId\': 264459}, \'multiverseid\': 264459}, {\'name\': \'Истребление Духа\', \'text\': \'Расходуйте на X только черную ману.\\nИстребление Духа наносит Х повреждений целевому существу или игроку, а вы получаете Х жизней.\', \'type\': \'Волшебство\', \'flavor\': \'«Вы, священники, похваляетесь своей силой духа, но стоит мне отнять самую малость, как вы обмякаете, словно тряпичные куклы». — Сорин Марков\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264708&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'708cbd25-3378-4a8d-aa79-278b147873d8\', \'multiverseId\': 264708}, \'multiverseid\': 264708}, {\'name\': \'吞噬灵魂\', \'text\': \'只能以黑色法术力支付X。\\n吞噬灵魂对目标生物或牌手造成X点伤害，且你获得X点生命。\', \'type\': \'法术\', \'flavor\': \'「你们僧侣总爱吹嘘自己的灵魂力量，结果我才拿走这么一点点，马上就崩溃得不成人形。」 ～索霖马可夫\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262965&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'08ee1428-7565-484f-ae69-1a3404201f91\', \'multiverseId\': 262965}, \'multiverseid\': 262965}, {\'name\': \'吞噬靈魂\', \'text\': \'只能以黑色魔法力支付X。\\n吞噬靈魂對目標生物或玩家造成X點傷害，且你獲得X點生命。\', \'type\': \'巫術\', \'flavor\': \'「你們僧侶總愛吹噓自己的靈魂力量，結果我才拿走這麼一點點，馬上就崩潰得不成人形。」 ～索霖馬可夫\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263214&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8a7ec9da-0f0a-4cb9-99c8-300e3eda7b7f\', \'multiverseId\': 263214}, \'multiverseid\': 263214}]', '[{\'name\': \'Genähter Ghul\', \'text\': \'Verursacht Trampelschaden\\nSchicke eine beliebige Anzahl an Kreaturenkarten aus deinem Friedhof ins Exil, sowie der Genähte Ghul ins Spiel kommt.\\nDie Stärke des Genähten Ghuls ist gleich der Summe der Stärke der so ins Exil geschickten Karten, und seine Widerstandskraft ist gleich der Summe der Widerstandskraft dieser Karten.\', \'type\': \'Kreatur — Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263736&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f9832dd8-b398-4411-af74-7154da19c80d\', \'multiverseId\': 263736}, \'multiverseid\': 263736}, {\'name\': \'Necrófago suturado\', \'text\': \'Arrolla.\\nEn cuanto el Necrófago suturado entre al campo de batalla, exilia cualquier cantidad de cartas de criatura de tu cementerio.\\nLa fuerza del Necrófago suturado es igual a la fuerza total de las cartas exiliadas y su resistencia es igual a su resistencia total.\', \'type\': \'Criatura — Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264981&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5762bf7e-fee2-4dcf-bc48-3a3f19e9942b\', \'multiverseId\': 264981}, \'multiverseid\': 264981}, {\'name\': \'Goule suturée\', \'text\': "Piétinement\\nAu moment où la Goule suturée arrive sur le champ de bataille, exilez n\'importe quel nombre de cartes de créature de votre cimetière.\\nLa force de la Goule suturée est égale au total des forces des cartes exilées et son endurance au total de leurs endurances.", \'type\': \'Créature : zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263487&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d9aa4af9-58e1-4749-a5e2-aebf4f28a670\', \'multiverseId\': 263487}, \'multiverseid\': 263487}, {\'name\': \'Ghoul Ricucito\', \'text\': \'Travolgere\\nMentre il Ghoul Ricucito entra nel campo di battaglia, esilia un qualsiasi numero di carte creatura dal tuo cimitero.\\nLa forza del Ghoul Ricucito è pari alla forza totale delle carte esiliate e la sua costituzione è pari alla loro costituzione totale.\', \'type\': \'Creatura — Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263985&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7c438c32-8cb5-4733-bd2e-cb06dca40b17\', \'multiverseId\': 263985}, \'multiverseid\': 263985}, {\'name\': \'縫合グール\', \'text\': \'トランプル\\n縫合グールが戦場に出るに際し、あなたの墓地にあるクリーチャー・カードを望む枚数追放する。\\n縫合グールのパワーはそれらの追放したカードのパワーの合計に等しく、タフネスはそれらのタフネスの合計に等しい。\', \'type\': \'クリーチャー — ゾンビ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264234&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9d6090fd-9ca0-4e55-b359-88088308108a\', \'multiverseId\': 264234}, \'multiverseid\': 264234}, {\'name\': \'봉합 악귀\', \'text\': \'돌진봉합 악귀가 전장에 들어올 시에, 당신의 무덤에서 원하는 만큼의 생물 카드를 추방한다.봉합 악귀의 공격력은 이렇게 추방된 카드들의 총 공격력과 똑같고, 봉합악귀의 방어력은 이렇게 추방된 카드들의 총 방어력과 똑같다.\', \'type\': \'생물 — 좀비\', \'flavor\': None, \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ec4bb01e-219a-4f9b-8e81-0d0b8dcd005f\'}, \'multiverseid\': None}, {\'name\': \'Carniçal Suturado\', \'text\': \'Atropelar\\nConforme Carniçal Suturado entra no campo de batalha, exile um número qualquer de cards de criatura de seu cemitério.\\nO poder de Carniçal Suturado é igual à soma do poder dos cards exilados e sua resistência é igual à soma da resistência deles.\', \'type\': \'Criatura — Zumbi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264483&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9eec9c3c-defe-4e5e-b48e-675f1147c33a\', \'multiverseId\': 264483}, \'multiverseid\': 264483}, {\'name\': \'Упырь Зашитых Ран\', \'text\': \'Пробивной удар\\nПри выходе Упыря Зашитых Ран на поле битвы, изгоните любое количество карт существ из вашего кладбища.\\nСила Упыря Зашитых Ран равна сумме значений силы изгнанных карт, а его выносливость равна сумме значений их выносливости.\', \'type\': \'Существо — Зомби\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264732&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b2f0441b-8405-4ae6-9b2e-37a580a1ef96\', \'multiverseId\': 264732}, \'multiverseid\': 264732}, {\'name\': \'缝组食尸鬼\', \'text\': \'践踏\\n于缝组食尸鬼进战场时，从你的坟墓场放逐任意数量的生物牌。\\n缝组食尸鬼的力量等同于以此法放逐之牌力量的总和，且其防御力等同于以此法放逐之牌防御力的总和。\', \'type\': \'生物～灵俑\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262989&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8ed83ce4-cdaf-41b1-8238-cb5350de69c0\', \'multiverseId\': 262989}, \'multiverseid\': 262989}, {\'name\': \'縫組食屍鬼\', \'text\': \'踐踏\\n於縫組食屍鬼進戰場時，從你的墳墓場放逐任意數量的生物牌。\\n縫組食屍鬼的力量等同於以此法放逐之牌力量的總和，且其防禦力等同於以此法放逐之牌防禦力的總和。\', \'type\': \'生物～殭屍\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263238&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8630d829-cd2d-4a3c-a135-294bbb1996d2\', \'multiverseId\': 263238}, \'multiverseid\': 263238}]', '[{\'name\': \'Gepanzertes Schlachtross\', \'type\': \'Kreatur — Pferd\', \'flavor\': \'„Wenn wir vom Nordrand uns ein Pferd suchen, dann tut es nicht ein gewöhnlicher Klepper. Es muss so stark sein wie unsere Tugend und uns aus eigenem Antrieb folgen." —Sarlena, Paladin des Nordrands\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263631&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c45cceee-da89-4f21-aeb0-0500abe43d52\', \'multiverseId\': 263631}, \'multiverseid\': 263631}, {\'name\': \'Caballo de guerra acorazado\', \'type\': \'Criatura — Caballo\', \'flavor\': \'"Cuando los del Límite Norte pedimos una montura, un burro cualquiera no sirve. Debe ser fuerte como nuestra virtud, y debe unírsenos voluntariamente." —Sarlena, paladín del Límite Norte\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264876&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'13bbdfbf-b99c-4c95-bd07-5efd8ec92ed9\', \'multiverseId\': 264876}, \'multiverseid\': 264876}, {\'name\': \'Destrier cuirassé\', \'type\': \'Créature : cheval\', \'flavor\': "« Quand le peuple de l\'Orée Septentrionale choisit une monture, un canasson de paysan ne suffit pas. Le cheval doit être aussi fort que notre vertu et il doit nous rejoindre de son plein gré. » —Sarlena, paladin de l\'Orée Septentrionale", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263382&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2686167c-0d87-404b-980e-806509fead50\', \'multiverseId\': 263382}, \'multiverseid\': 263382}, {\'name\': \'Destriero Corazzato\', \'type\': \'Creatura — Cavallo\', \'flavor\': \'"Quando noi del Margine Nord rivendichiamo una cavalcatura, non sarà certo un ronzino da contadino. Deve essere forte come la nostra virtù e deve unirsi a noi per sua volontà." —Sarlena, paladina del Margine Nord\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263880&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f3f29129-1c94-41ec-98da-4fe8af7b148b\', \'multiverseId\': 263880}, \'multiverseid\': 263880}, {\'name\': \'鎧の軍馬\', \'type\': \'クリーチャー — 馬\', \'flavor\': \'「我ら北境団が乗馬を求めるとき、農夫の馬では役に立たないわ。 我々の武勇ほど強く、己の意思で来るものでなければだめよ。」 ――北境団の聖騎士、サルレナ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264129&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2b2d6a46-b6c1-4e62-947c-eb82bdc8e8f8\', \'multiverseId\': 264129}, \'multiverseid\': 264129}, {\'name\': \'장갑전투마\', \'type\': \'생물 — 말\', \'flavor\': \'"우리 북변기사단의 군마는 아무 말이나 되는 게 아닙니다. 우리의 미덕만큼이나 강인한 힘, 그리고 스스로의 운명을 개척할 의지를 갖추고 있어야 합니다."—북변기사단의 성기사 사를리나\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'125fed07-58ed-4da6-92ca-be52cc9dcb19\'}, \'multiverseid\': None}, {\'name\': \'Cavalo de Guerra Blindado\', \'type\': \'Criatura — Cavalo\', \'flavor\': \'"Quando nós da Fronteira Norte exigimos um cavalo, não pode ser qualquer pangaré. Ele precisa ser tão forte quanto a nossa virtude, e deve unir-se a nós de livre e espontânea vontade." — Sarlena, paladina da Fronteira Norte\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264378&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ae98695d-61a8-45d1-b5e2-93950202173b\', \'multiverseId\': 264378}, \'multiverseid\': 264378}, {\'name\': \'Боевой Конь в Доспехах\', \'type\': \'Существо — Лошадь\', \'flavor\': \'«Когда мы, из ордена Северной Окраины, выбираем коня, обычная крестьянская лошадь не годится. Он должен быть крепким, как наша добродетель, и служить нам по собственной воле». — Сарлена, паладин ордена Северной Окраины\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264627&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4f287814-4d32-4403-bc5f-d9895b39bd12\', \'multiverseId\': 264627}, \'multiverseid\': 264627}, {\'name\': \'装甲战马\', \'type\': \'生物～马\', \'flavor\': \'「我们北境精兵要挑的座骑，可不是随便一匹农耕老马就能胜任的。 他必须坚强如我们的美德，还得出于自愿加入。」 ～北境神圣武士莎雷娜\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262884&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'54b37a4a-aee7-4ff4-b732-b5987b2e8f42\', \'multiverseId\': 262884}, \'multiverseid\': 262884}, {\'name\': \'裝甲戰馬\', \'type\': \'生物～馬\', \'flavor\': \'「我們北境精兵要挑的座騎，可不是隨便一匹農耕老馬就能勝任的。 牠必須堅強如我們的美德，還得出於自願加入。」 ～北境神聖武士莎雷娜\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263133&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'cc27f70d-0fd6-49cf-9167-a8544585ab9f\', \'multiverseId\': 263133}, \'multiverseid\': 263133}]', '[{\'name\': \'Gequälte Seele\', \'text\': \'Die Gequälte Seele kann nicht blocken und ist unblockbar.\', \'type\': \'Kreatur — Geist\', \'flavor\': \'Diejenigen, die in ihrem Leben am bittersten über die Welt klagten, sind verflucht, nach dem Tod durch die Zwischenwelt zu geistern.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263738&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bb4a6639-6b92-404b-b191-ee389d1a9e52\', \'multiverseId\': 263738}, \'multiverseid\': 263738}, {\'name\': \'Alma atormentada\', \'text\': \'El Alma atormentada no puede bloquear y es imbloqueable.\', \'type\': \'Criatura — Espíritu\', \'flavor\': \'Quienes en vida estaban consumidos por la amargura y la ira son condenados a vagar por los reinos del submundo tras su muerte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264983&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6018c82e-bce2-4fb7-8da1-03886d7be5b6\', \'multiverseId\': 264983}, \'multiverseid\': 264983}, {\'name\': \'Âme tourmentée\', \'text\': "L\'Âme tourmentée ne peut pas bloquer et elle est imblocable.", \'type\': \'Créature : esprit\', \'flavor\': \'Les plus amèrement furieux envers le monde quand ils étaient en vie sont condamnés à hanter les royaumes souterrains dans la mort.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263489&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'07c76afa-da84-49a2-8c3f-3c0300d9a6ac\', \'multiverseId\': 263489}, \'multiverseid\': 263489}, {\'name\': \'Anima Tormentata\', \'text\': "L\'Anima Tormentata non può bloccare e non può essere bloccata.", \'type\': \'Creatura — Spirito\', \'flavor\': \'Coloro che hanno inveito con più astio contro il mondo in vita sono condannati a vagare negli inferi da morti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263987&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2be4178a-245e-4fb7-8cfc-ab50005a62ff\', \'multiverseId\': 263987}, \'multiverseid\': 263987}, {\'name\': \'苛まれし魂\', \'text\': \'苛まれし魂ではブロックできず、それはブロックされない。\', \'type\': \'クリーチャー — スピリット\', \'flavor\': \'世界に対して命がけで最も辛辣に怒りをぶつけた者は、冥界を死してさまよう呪いを受ける。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264236&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7dd48f3e-5cba-4be2-ab04-63c8d1ce5299\', \'multiverseId\': 264236}, \'multiverseid\': 264236}, {\'name\': \'괴로운 영혼\', \'text\': \'괴로운 영혼은 방어할 수도 없고 방어당하지도 않는다.\', \'type\': \'생물 — 신령\', \'flavor\': \'이승에서 세상을 원망했던 자들은 저승을 끝없이 떠돌아야 하는 저주에 걸린다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3c0a3bf8-6c07-46c6-bc7a-c098fc59def3\'}, \'multiverseid\': None}, {\'name\': \'Alma Atormentada\', \'text\': \'Alma Atormentada não pode bloquear e não pode ser bloqueada.\', \'type\': \'Criatura — Espírito\', \'flavor\': \'Aqueles que mais atormentaram o mundo com sua ira durante a vida estão condenados a vagar pelos reinos baixos na sua morte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264485&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'27a60561-3450-40b0-b049-ac35a911f303\', \'multiverseId\': 264485}, \'multiverseid\': 264485}, {\'name\': \'Страдающая Душа\', \'text\': \'Страдающая Душа не может блокировать и не может быть заблокирована.\', \'type\': \'Существо — Дух\', \'flavor\': \'Тот, кто при жизни сильнее всех кипел злобой к миру, после смерти обречен скитаться по царству небытия.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264734&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'430067b5-96ee-4d2a-a827-e89e25d78284\', \'multiverseId\': 264734}, \'multiverseid\': 264734}, {\'name\': \'受虐灵魂\', \'text\': \'受虐灵魂不能进行阻挡，也不能被阻挡。\', \'type\': \'生物～精怪\', \'flavor\': \'生时愤恨这世界的人，受诅要在死后游荡阴间。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262991&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4f2d47f1-32ec-4420-bb2b-3dddc9244a37\', \'multiverseId\': 262991}, \'multiverseid\': 262991}, {\'name\': \'受虐靈魂\', \'text\': \'受虐靈魂不能進行阻擋，也不能被阻擋。\', \'type\': \'生物～精靈\', \'flavor\': \'生時憤恨這世界的人，受詛要在死後遊蕩陰間。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263240&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fd15c4ef-2372-472d-a9c9-2f8b496812f3\', \'multiverseId\': 263240}, \'multiverseid\': 263240}]', '[{\'name\': \'Gescheckter Keiler\', \'text\': \'Opfere den Gescheckten Keiler: Du erhältst 4 Lebenspunkte dazu.\', \'type\': \'Kreatur — Wildschwein\', \'flavor\': \'„Sagt den Köchen, sie sollen die Feuer anfachen. Heute abend schlemmen wir." —Tolar Wolfsbruder, Krosanischer Spurensucher\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263791&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cc2fb6ee-bd95-4361-9a3b-dbf398d61c7a\', \'multiverseId\': 263791}, \'multiverseid\': 263791}, {\'name\': \'Jabalí moteado\', \'text\': \'Sacrificar el Jabalí moteado: Gana 4 vidas.\', \'type\': \'Criatura — Jabalí\', \'flavor\': \'"Que los cocineros preparen los fuegos. ¡Hoy nos damos un festín!" —Tolar de los Lobos, rastreador krosano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265036&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b1aa1793-e0c6-4b0e-82c1-ffc83456f0e5\', \'multiverseId\': 265036}, \'multiverseid\': 265036}, {\'name\': \'Sanglier moucheté\', \'text\': \'Sacrifiez le Sanglier moucheté : vous gagnez 4 points de vie.\', \'type\': \'Créature : sanglier\', \'flavor\': \'« Dites aux cuisiniers de préparer les feux. Ce soir, nous festoierons ! » —Tolar Frèreduloup, pisteur krosian\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263542&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c43ffc72-ceaa-454d-ad55-c24abdc88462\', \'multiverseId\': 263542}, \'multiverseid\': 263542}, {\'name\': \'Cinghiale Pezzato\', \'text\': \'Sacrifica il Cinghiale Pezzato: Guadagni 4 punti vita.\', \'type\': \'Creatura — Cinghiale\', \'flavor\': \'"Dite ai cuochi di preparare i falò. Stanotte si banchetta!" —Tolar Fratellolupo, battipista di Krosa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264040&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7a11ba5e-07cc-4aca-bb65-16fa6abe6cd6\', \'multiverseId\': 264040}, \'multiverseid\': 264040}, {\'name\': \'斑の猪\', \'text\': \'斑の猪を生け贄に捧げる：あなたは４点のライフを得る。\', \'type\': \'クリーチャー — 猪\', \'flavor\': \'「料理番に火をつけとけって伝えな。 今夜はご馳走だぞ！」 ――クローサの足跡追い、狼兄弟のトラール\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264289&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'514c5e51-4f01-41e7-8414-e161c792dea1\', \'multiverseId\': 264289}, \'multiverseid\': 264289}, {\'name\': \'얼룩멧돼지\', \'text\': \'얼룩멧돼지를 희생한다: 당신은 생명 4점을 얻는다.\', \'type\': \'생물 — 멧돼지\', \'flavor\': \'"조리사들에게 불을 지피라고 해라. 오늘 밤은 잔치다!"—크로사의 수렵꾼 톨라르 울프브라더\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b6f243f8-b4d5-4432-8a5c-faf9a48354e1\'}, \'multiverseid\': None}, {\'name\': \'Javali Malhado\', \'text\': \'Sacrifique Javali Malhado: Você ganha 4 pontos de vida.\', \'type\': \'Criatura — Javali\', \'flavor\': \'"Diga aos cozinheiros para preparar o fogo. Teremos um banquete esta noite!" — Tolar Lupusfrater, rastreador krosano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264538&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8576a9a9-4bdd-4450-8692-0432132cd42f\', \'multiverseId\': 264538}, \'multiverseid\': 264538}, {\'name\': \'Пятнистый Вепрь\', \'text\': \'Пожертвуйте Пятнистого Вепря: вы получаете 4 жизни.\', \'type\': \'Существо — Вепрь\', \'flavor\': \'«Скажи поварам, чтобы разжигали костры. Сегодня вечером мы будем пировать!» — Толар Волчий Брат, кросанский охотник\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264787&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8d9e8890-c144-44b7-874f-ebc91411b82e\', \'multiverseId\': 264787}, \'multiverseid\': 264787}, {\'name\': \'斑野猪\', \'text\': \'牺牲斑野猪：你获得4点生命。\', \'type\': \'生物～野猪\', \'flavor\': \'「叫伙夫准备生火。 今晚我们有大餐！」 ～克洛萨追猎人狼伴托勒\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263044&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'afef23e2-a735-4f39-a968-5a4c7cf4ce0e\', \'multiverseId\': 263044}, \'multiverseid\': 263044}, {\'name\': \'斑野豬\', \'text\': \'犧牲斑野豬：你獲得4點生命。\', \'type\': \'生物～野豬\', \'flavor\': \'「叫伙伕準備生火。 今晚我們有大餐！」 ～克洛薩追獵人狼伴托勒\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263293&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'dbef5973-d640-4a03-86ab-e4d1cfd413fe\', \'multiverseId\': 263293}, \'multiverseid\': 263293}]', '[{\'name\': \'Gideon Jura\', \'text\': \'+2: Während des nächsten Zuges eines Gegners deiner Wahl greifen alle Kreaturen, die dieser Spieler kontrolliert, Gideon Jura an, falls möglich.\\n-2: Zerstöre eine getappte Kreatur deiner Wahl.\\n0: Bis zum Ende des Zuges wird Gideon Jura eine 6/6 (Mensch, Soldat)-Kreatur, die immer noch ein Planeswalker ist. Verhindere allen Schaden, der ihm in diesem Zug zugefügt würde.\', \'type\': \'Planeswalker — Gideon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263640&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'09be17eb-61d8-41b5-841b-40304806d7e0\', \'multiverseId\': 263640}, \'multiverseid\': 263640}, {\'name\': \'Gideon Jura\', \'text\': \'+2: Durante el próximo turno del oponente objetivo, las criaturas que controla ese jugador atacan a Gideon Jura si pueden.\\n-2: Destruye la criatura objetivo girada.\\n0: Hasta el final del turno, Gideon Jura es una criatura Soldado Humano 6/6 que sigue siendo un planeswalker. Prevén todo el daño que se le fuera a hacer a él este turno.\', \'type\': \'Planeswalker — Gideon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264885&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'639310ec-2c2f-424d-86bd-21f044f0be4f\', \'multiverseId\': 264885}, \'multiverseid\': 264885}, {\'name\': \'Gideon Jura\', \'text\': "+2 : Pendant le prochain tour de l\'adversaire ciblé, les créatures que ce joueur contrôle attaquent Gideon Jura si possible.\\n-2 : Détruisez la créature engagée ciblée.\\n0 : Jusqu\'à la fin du tour, Gideon Jura devient une créature 6/6 Humain et Soldat qui est toujours un planeswalker. Prévenez toutes les blessures qui devraient lui être infligées ce tour-ci.", \'type\': \'Planeswalker : Gideon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263391&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ec4838d6-1b64-4b3d-ad3d-6c581b1c738b\', \'multiverseId\': 263391}, \'multiverseid\': 263391}, {\'name\': \'Gideon Jura\', \'text\': \'+2: Durante il prossimo turno di un avversario bersaglio, le creature controllate da quel giocatore attaccano Gideon Jura se possono farlo.\\n-2: Distruggi una creatura TAPpata bersaglio.\\n0: Fino alla fine del turno, Gideon Jura diventa una creatura Soldato Umano 6/6 che è ancora un planeswalker. Previeni tutto il danno che gli verrebbe inflitto in questo turno.\', \'type\': \'Planeswalker — Gideon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263889&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cff87c50-c987-4206-8428-c6958a20d1b8\', \'multiverseId\': 263889}, \'multiverseid\': 263889}, {\'name\': \'ギデオン・ジュラ\', \'text\': \'+2: 対戦相手１人を対象とする。そのプレイヤーの次のターン中、そのプレイヤーがコントロールするクリーチャーは可能ならギデオン・ジュラを攻撃する。\\n-2: タップ状態のクリーチャー１体を対象とし、それを破壊する。\\n0: ターン終了時まで、ギデオン・ジュラは６/６の人間・兵士・クリーチャーになる。それはプレインズウォーカーでもある。 このターン、彼に与えられるすべてのダメージを軽減する。\', \'type\': \'プレインズウォーカー — ギデオン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264138&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fb8d416f-c343-4038-bdb2-af23e7953a07\', \'multiverseId\': 264138}, \'multiverseid\': 264138}, {\'name\': \'기디온 주라\', \'text\': \'+2: 상대 한 명을 목표로 정한다. 그 상대가 조종하는 모든 생물은 그 상대의 다음 턴 중에 가능하면 기디온 주라를 공격해야 한다.-2: 탭된 생물 한 개를 목표로 정해서 파괴한다.0: 기디온 주라는 턴종료까지 여전히 플레인즈워커인 6/6 인간 병사 생물로 변한다. 이 턴에 기디온 주라에게 입혀지려 하는 모든 피해를 방지한다.\', \'type\': \'플레인즈워커 — 기디온\', \'flavor\': None, \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'be9f9901-8784-4f46-a6f3-368645925779\'}, \'multiverseid\': None}, {\'name\': \'Gideon Jura\', \'text\': \'+2: Durante o próximo turno do oponente alvo, as criaturas que aquele jogador controla atacam Gideon Jura se estiverem aptas.\\n-2: Destrua a criatura alvo virada.\\n0: Até o final do turno, Gideon Jura torna-se uma criatura 6/6 do tipo Humano Soldado que ainda é um planeswalker. Previna todo o dano que seria causado a ele neste turno.\', \'type\': \'Planeswalker — Gideon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264387&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8e1772b5-9f2f-4b2f-a742-9127e03cee15\', \'multiverseId\': 264387}, \'multiverseid\': 264387}, {\'name\': \'Гидеон Джура\', \'text\': \'+2: во время следующего хода целевого оппонента существа под контролем того игрока атакуют Гидеона Джуру, если могут.\\n-2: уничтожьте целевое повернутое существо.\\n0: до конца хода Гидеон Джура становится существом 6/6 Человек Солдат, которое остается planeswalker-ом. Предотвратите все повреждения, которые должны быть нанесены ему в этом ходу.\', \'type\': \'Planeswalker — Гидеон\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264636&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bb5fa3f6-2096-4880-8dff-d0a45b877670\', \'multiverseId\': 264636}, \'multiverseid\': 264636}, {\'name\': \'基定尤拉\', \'text\': \'+2：于目标对手的下个回合中，由该牌手所操控的生物若能攻击基定尤拉，则必须攻击之。\\n-2：消灭目标已横置的生物。\\n0：直到回合结束，基定尤拉成为6/6的人类／士兵生物，且仍然是鹏洛客。 防止本回合中将对他造成的所有伤害。\', \'type\': \'鹏洛客～基定\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262893&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'33f5ab20-3c18-4c04-a0d1-a80b2123f17b\', \'multiverseId\': 262893}, \'multiverseid\': 262893}, {\'name\': \'基定尤拉\', \'text\': \'+2：於目標對手的下個回合中，由該玩家所操控的生物若能攻擊基定尤拉，則必須攻擊之。\\n-2：消滅目標已橫置的生物。\\n0：直到回合結束，基定尤拉成為6/6的人類／士兵生物，且仍然是鵬洛客。 防止本回合中將對他造成的所有傷害。\', \'type\': \'鵬洛客～基定\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263142&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'059ce688-afe1-442f-9c81-5485199dbab4\', \'multiverseId\': 263142}, \'multiverseid\': 263142}]', '[{\'name\': \'Gideons Ordnungshüter\', \'text\': \'{W}, {T}: Tappe eine Kreatur deiner Wahl.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'„Die Grundlage einer gesetzestreuen Gesellschaft ist sofortige Abschreckung."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263642&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fe8b192e-c41a-4c27-8dd2-a093a9fa282c\', \'multiverseId\': 263642}, \'multiverseid\': 263642}, {\'name\': \'Protector de la ley de Gideon\', \'text\': \'{W}, {T}: Gira la criatura objetivo.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'"La disuasión eficaz es esencial para una sociedad con leyes."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264887&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f215da50-69ed-4cf9-8bbf-136fa2a09b5c\', \'multiverseId\': 264887}, \'multiverseid\': 264887}, {\'name\': \'Gardeloi de Gideon\', \'text\': \'{W}, {T} : Engagez la créature ciblée.\', \'type\': \'Créature : humain et soldat\', \'flavor\': "« L\'essence d\'une société respectueuse des lois est une prompte dissuasion. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263393&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'68dd4efd-fef5-43c4-bdb1-2d1437299748\', \'multiverseId\': 263393}, \'multiverseid\': 263393}, {\'name\': \'Disciplinato di Gideon\', \'text\': \'{W}, {T}: TAPpa una creatura bersaglio.\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'"L\\\'essenza di una società rispettosa delle leggi è una rapida dissuasione."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263891&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'53fbbe27-a2bd-4006-aa90-932cfbbff4f9\', \'multiverseId\': 263891}, \'multiverseid\': 263891}, {\'name\': \'ギデオンの法の番人\', \'text\': \'{W}, {T}：クリーチャー１体を対象とし、それをタップする。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'「善良なる社会の本質は、素早い抑止力だ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264140&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4922c129-27ac-472a-b04a-aff09233e656\', \'multiverseId\': 264140}, \'multiverseid\': 264140}, {\'name\': \'기디온의 집행자\', \'text\': \'{W}, {T}: 생물 한 개를 목표로 정해서 탭한다.\', \'type\': \'생물 — 인간 병사\', \'flavor\': \'"법치 사회의 핵심은 신속한 진압입니다."\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'960b1d21-75ba-4151-bc36-928fcbff62f1\'}, \'multiverseid\': None}, {\'name\': \'Guardião da Lei de Gideon\', \'text\': \'{W}, {T}: Vire a criatura alvo.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': \'"A essência de uma sociedade que obedece à lei está na intimidação veloz."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264389&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'790c3b9e-10ac-4bdd-99e8-fed01a4501c3\', \'multiverseId\': 264389}, \'multiverseid\': 264389}, {\'name\': \'Законохранитель Гидеона\', \'text\': \'{W}, {T}: поверните целевое существо.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'«Суть законопослушного общества заключается в своевременном сдерживании».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264638&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d3173a04-eced-4d86-b8c3-566ebc73cfb0\', \'multiverseId\': 264638}, \'multiverseid\': 264638}, {\'name\': \'基定维安兵\', \'text\': \'{W}，{T}：横置目标生物。\', \'type\': \'生物～人类／士兵\', \'flavor\': \'「法治社会的精髓就是迅速吓阻。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262895&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3604f579-bd57-4d41-acdd-e4e86836cb88\', \'multiverseId\': 262895}, \'multiverseid\': 262895}, {\'name\': \'基定維安兵\', \'text\': \'{W}，{T}：橫置目標生物。\', \'type\': \'生物～人類／士兵\', \'flavor\': \'「法治社會的精髓就是迅速嚇阻。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263144&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'57607207-95ac-4eb2-9d99-8816ff4af538\', \'multiverseId\': 263144}, \'multiverseid\': 263144}]', '[{\'name\': \'Gideons Rächer\', \'text\': \'Immer wenn eine Kreatur, die ein Gegner kontrolliert, getappt wird, lege eine +1/+1-Marke auf Gideons Rächer.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'„Die Guten sitzen nicht herum und warten darauf, dass die Bösen handeln. Sie bereiten die Verteidigung vor. Sie bereiten die Bestrafung vor."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263641&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f9d8d921-e9e8-408e-b3ea-7b5c87cb5140\', \'multiverseId\': 263641}, \'multiverseid\': 263641}, {\'name\': \'Vengador de Gideon\', \'text\': \'Siempre que una criatura que controle un oponente sea girada, pon un contador +1/+1 sobre el Vengador de Gideon.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'"Los buenos no se sientan a esperar que el mal actúe. Se preparan para defender. Se preparan para castigar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264886&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a3b6eae5-871f-4db4-85d2-c1fb62cdaeac\', \'multiverseId\': 264886}, \'multiverseid\': 264886}, {\'name\': \'Vengeur de Gideon\', \'text\': "À chaque fois qu\'une créature qu\'un adversaire contrôle devient engagée, mettez un marqueur +1/+1 sur le Vengeur de Gideon.", \'type\': \'Créature : humain et soldat\', \'flavor\': "« Les forces du bien n\'attendent pas que le mal agisse. Elles se préparent à défendre. Elles se préparent à punir. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263392&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0708f3cf-6de0-4f75-965d-1d02ec3e64c0\', \'multiverseId\': 263392}, \'multiverseid\': 263392}, {\'name\': \'Vendicatore di Gideon\', \'text\': \'Ogniqualvolta una creatura controllata da un avversario viene TAPpata, metti un segnalino +1/+1 sul Vendicatore di Gideon.\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'"I buoni non stanno seduti ad aspettare che il male agisca. Si preparano a difendersi. Si preparano a punire."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263890&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ef28de35-5220-435c-a948-04b06ba0c37f\', \'multiverseId\': 263890}, \'multiverseid\': 263890}, {\'name\': \'ギデオンの報復者\', \'text\': \'いずれかの対戦相手がコントロールするクリーチャーが１体タップ状態になるたび、ギデオンの報復者の上に＋１/＋１カウンターを１個置く。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'「善なる者は邪悪の行いを見過ごしはしない。 立ち向かう準備をするのだ。 罰する準備をするのだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264139&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'079afd17-8611-4f24-b0c5-d0f10df67996\', \'multiverseId\': 264139}, \'multiverseid\': 264139}, {\'name\': \'기디온의 응징자\', \'text\': \'상대가 조종하는 생물이 탭될 때마다, 기디온의 응징자에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 인간 병사\', \'flavor\': \'"선한 자라고 가만히 앉아 악한 자가 움직이기만을 기다리는 건 아닙니다. 방어할 태세를 갖추고, 응징할 준비를 합니다."\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c07cbef0-cc8c-40e4-9653-c6b1b843c10f\'}, \'multiverseid\': None}, {\'name\': \'Vingador de Gideon\', \'text\': \'Toda vez que uma criatura que um oponente controla for virada, coloque um marcador +1/+1 sobre Vingador de Gideon.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': \'"Os bons não ficam sentados esperando o mal agir. Eles se preparam para defender. Eles se preparam para punir."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264388&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1b85550b-1a23-4bdd-bad5-9345e444c7f2\', \'multiverseId\': 264388}, \'multiverseid\': 264388}, {\'name\': \'Мститель Гидеона\', \'text\': \'Каждый раз когда существо под контролем оппонента поворачивается, положите один жетон +1/+1 на Мстителя Гидеона.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'«Добрые люди не сидят сложа руки, выжидая, когда злые начнут творить зло. Они готовятся защищать. Они готовятся карать».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264637&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ab3305a2-ac6c-4139-8ed6-0acfc194e85c\', \'multiverseId\': 264637}, \'multiverseid\': 264637}, {\'name\': \'基定复仇者\', \'text\': \'每当由对手操控的一个生物成为横置时，在基定复仇者上放置一个+1/+1指示物。\', \'type\': \'生物～人类／士兵\', \'flavor\': \'「好人不会坐待坏人作乱。 他们随时准备抵抗。 他们随时准备惩恶。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262894&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5f2efca6-daf4-43b3-bd87-8e83dd231c9b\', \'multiverseId\': 262894}, \'multiverseid\': 262894}, {\'name\': \'基定復仇者\', \'text\': \'每當由對手操控的一個生物成為橫置時，在基定復仇者上放置一個+1/+1指示物。\', \'type\': \'生物～人類／士兵\', \'flavor\': \'「好人不會坐待壞人作亂。 他們隨時準備抵抗。 他們隨時準備懲惡。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263143&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c054223a-7afc-40ae-9a49-382fb6084684\', \'multiverseId\': 263143}, \'multiverseid\': 263143}]', '[{\'name\': \'Gletscherfestung\', \'text\': \'Die Gletscherfestung kommt getappt ins Spiel, falls du nicht eine Ebene oder eine Insel kontrollierst.\\n{T}: Erhöhe deinen Manavorrat um {W} oder {U}.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263851&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e9d5c260-5597-42b4-b271-ccc69986382c\', \'multiverseId\': 263851}, \'multiverseid\': 263851}, {\'name\': \'Fortaleza glacial\', \'text\': \'La Fortaleza glacial entra al campo de batalla girada a menos que controles una llanura o una isla.\\n{T}: Agrega {W} o {U} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265096&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'52e96967-8014-4739-b8fd-7d055b7ffa93\', \'multiverseId\': 265096}, \'multiverseid\': 265096}, {\'name\': \'Forteresse glaciaire\', \'text\': \'La Forteresse glaciaire arrive sur le champ de bataille engagée à moins que vous ne contrôliez une plaine ou une île.\\n{T} : Ajoutez {W} ou {U} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263602&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'73ec70b4-3806-4dac-8bef-c421e1261014\', \'multiverseId\': 263602}, \'multiverseid\': 263602}, {\'name\': \'Fortezza Glaciale\', \'text\': "La Fortezza Glaciale entra nel campo di battaglia TAPpata a meno che tu non controlli una Pianura o un\'Isola.\\n{T}: Aggiungi {W} o {U} alla tua riserva di mana.", \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264100&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6e08a092-7cfb-4cc5-99c1-64c9311d2365\', \'multiverseId\': 264100}, \'multiverseid\': 264100}, {\'name\': \'氷河の城砦\', \'text\': \'氷河の城砦は、あなたが平地か島をコントロールしていないかぎり、タップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{W}か{U}を加える。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264349&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b46daf94-191e-4d24-9ab1-e5c20dd0e51d\', \'multiverseId\': 264349}, \'multiverseid\': 264349}, {\'name\': \'만년빙 요새\', \'text\': \'만년빙 요새는 당신이 들이나 섬을 조종하지 않으면 탭된 채로 전장에 들어온다.: 나 를 당신의 마나풀에 담는다.\', \'type\': \'대지\', \'flavor\': None, \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'38bb892c-2f83-405c-8e9a-7222865b50cd\'}, \'multiverseid\': None}, {\'name\': \'Fortaleza Glacial\', \'text\': \'Fortaleza Glacial entra no campo de batalha virado a menos que você controle uma Planície ou uma Ilha.\\n{T}: Adicione {W} ou {U} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264598&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f41cd9df-a5b5-4231-a01b-56b95d7b795e\', \'multiverseId\': 264598}, \'multiverseid\': 264598}, {\'name\': \'Ледяная Крепость\', \'text\': \'Ледяная Крепость выходит на поле битвы повернутой, если только под вашим контролем нет Равнины или Острова.\\n{T}: добавьте {W} или {U} в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264847&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2b6b3b53-b351-44de-b925-4a479d1b8e5b\', \'multiverseId\': 264847}, \'multiverseid\': 264847}, {\'name\': \'冰河要塞\', \'text\': \'除非你操控平原或海岛，否则冰河要塞须横置进战场。\\n{T}：加{W}或{U}到你的法术力池中。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263104&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c9cc5f9f-2bdf-4c19-86ad-3754fe9c37fa\', \'multiverseId\': 263104}, \'multiverseid\': 263104}, {\'name\': \'冰河要塞\', \'text\': \'除非你操控平原或海島，否則冰河要塞須橫置進戰場。\\n{T}：加{W}或{U}到你的魔法力池中。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263353&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'72d22bbc-9d85-4b73-a550-aa1fa76f58d3\', \'multiverseId\': 263353}, \'multiverseid\': 263353}]', '[{\'name\': \'Glockenturm-Sphinx\', \'text\': \'Fliegend\\nImmer wenn eine Quelle der Glockenturm-Sphinx Schadenspunkte zufügt, legt der Beherrscher dieser Quelle entsprechend viele Karten oben von seiner Bibliothek auf seinen Friedhof.\', \'type\': \'Kreatur — Sphinx\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263670&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ba99f7b0-43e8-4024-9785-4b78d3a4303a\', \'multiverseId\': 263670}, \'multiverseid\': 263670}, {\'name\': \'Esfinge del campanario\', \'text\': \'Vuela.\\nSiempre que una fuente haga daño a la Esfinge del campanario, el controlador de esa fuente pone esa misma cantidad de cartas de la parte superior de su biblioteca en su cementerio.\', \'type\': \'Criatura — Esfinge\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264915&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3b790394-d168-47d4-b00b-596e0beefb34\', \'multiverseId\': 264915}, \'multiverseid\': 264915}, {\'name\': \'Sphinx de beffroi\', \'text\': "Vol\\nÀ chaque fois qu\'une source inflige des blessures au Sphinx de beffroi, le contrôleur de cette source met autant de cartes du dessus de sa bibliothèque dans son cimetière.", \'type\': \'Créature : sphinx\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263421&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2973554a-fb84-40d3-801e-6dffdcc299cf\', \'multiverseId\': 263421}, \'multiverseid\': 263421}, {\'name\': \'Sfinge del Campanile\', \'text\': \'Volare\\nOgniqualvolta una fonte infligge danno alla Sfinge del Campanile, il controllore di quella fonte mette nel suo cimitero altrettante carte dalla cima del suo grimorio.\', \'type\': \'Creatura — Sfinge\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263919&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d71a285d-31f0-4d83-bc49-dd3df1346a11\', \'multiverseId\': 263919}, \'multiverseid\': 263919}, {\'name\': \'鐘塔のスフィンクス\', \'text\': \'飛行\\nいずれかの発生源が鐘塔のスフィンクスにダメージを与えるたび、その発生源のコントローラーはその点数に等しい枚数のカードを自分のライブラリーの一番上から自分の墓地に置く。\', \'type\': \'クリーチャー — スフィンクス\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264168&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f9fd6c4c-1fd2-482d-ab3e-8a573c734e5a\', \'multiverseId\': 264168}, \'multiverseid\': 264168}, {\'name\': \'종탑 스핑크스\', \'text\': \'비행어떤 원천이 종탑 스핑크스에게 피해를 입힐 때마다, 그 원천의 조종자는 자신의 서고 맨 위에서 그 피해만큼의 카드를 자신의 무덤에 넣는다.\', \'type\': \'생물 — 스핑크스\', \'flavor\': None, \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'280d8b54-ef9d-47ad-993f-fef075529938\'}, \'multiverseid\': None}, {\'name\': \'Esfinge do Campanário\', \'text\': \'Voar\\nToda vez que uma fonte causa dano a Esfinge do Campanário, o controlador daquela fonte coloca uma quantidade equivalente de cards do topo do grimório dele no próprio cemitério.\', \'type\': \'Criatura — Esfinge\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264417&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'38dc422f-7b5d-4fc0-b257-92aedb9930b0\', \'multiverseId\': 264417}, \'multiverseid\': 264417}, {\'name\': \'Сфинкс Колокольни\', \'text\': \'Полет\\nКаждый раз когда источник наносит повреждения Сфинксу Колокольни, игрок, контролирующий тот источник, кладет столько же карт с верха своей библиотеки на свое кладбище.\', \'type\': \'Существо — Сфинкс\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264666&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8d132cc7-a976-4491-b289-891984f18e7b\', \'multiverseId\': 264666}, \'multiverseid\': 264666}, {\'name\': \'钟塔史芬斯\', \'text\': \'飞行\\n每当任一来源对钟塔史芬斯造成伤害时，该来源的操控者将其牌库顶上等量的牌置入其坟墓场。\', \'type\': \'生物～史芬斯\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262923&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'522db5e3-e09b-4e5d-83df-6a2fa20acc0b\', \'multiverseId\': 262923}, \'multiverseid\': 262923}, {\'name\': \'鐘塔史芬斯\', \'text\': \'飛行\\n每當任一來源對鐘塔史芬斯造成傷害時，該來源的操控者將其牌庫頂上等量的牌置入其墳墓場。\', \'type\': \'生物～史芬斯\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263172&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8691f44c-60ab-45d7-bfed-1de7049f08e6\', \'multiverseId\': 263172}, \'multiverseid\': 263172}]', '[{\'name\': \'Goblin-Brandstifter\', \'text\': \'Wenn der Goblin-Brandstifter stirbt, kannst du ihn einer Kreatur oder einem Spieler deiner Wahl 1 Schadenspunkt zufügen lassen.\', \'type\': \'Kreatur — Goblin, Schamane\', \'flavor\': \'Mit großer Macht kommt auch das große Risiko, getötet zu werden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263760&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f28bcfbb-4b24-4e11-a741-9fcdcb99a95b\', \'multiverseId\': 263760}, \'multiverseid\': 263760}, {\'name\': \'Calcinador trasgo\', \'text\': \'Cuando el Calcinador trasgo muera, puedes hacer que le haga 1 punto de daño a la criatura o jugador objetivo.\', \'type\': \'Criatura — Chamán trasgo\', \'flavor\': \'Un gran poder conlleva un gran riesgo de hacer que te maten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265005&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5c25961b-755e-4a41-b9fb-a00242fc8c0d\', \'multiverseId\': 265005}, \'multiverseid\': 265005}, {\'name\': \'Incendiaire gobelin\', \'text\': "Quand l\'Incendiaire gobelin meurt, vous pouvez faire qu\'il inflige 1 blessure à une cible, créature ou joueur.", \'type\': \'Créature : gobelin et shamane\', \'flavor\': \'Quiconque a un grand pouvoir court le risque de se faire tuer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263511&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'33471495-d374-4cec-90a1-22d5e344d595\', \'multiverseId\': 263511}, \'multiverseid\': 263511}, {\'name\': \'Goblin Inceneritore\', \'text\': \'Quando il Goblin Inceneritore muore, puoi fargli infliggere 1 danno a una creatura o a un giocatore bersaglio.\', \'type\': \'Creatura — Sciamano Goblin\', \'flavor\': \'Da un grande potere derivano grandi rischi di rimanere uccisi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264009&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e5873cf2-bf48-49f9-ba39-9fc18fb3caa7\', \'multiverseId\': 264009}, \'multiverseid\': 264009}, {\'name\': \'ゴブリンの付け火屋\', \'text\': \'ゴブリンの付け火屋が死亡したとき、クリーチャー１体かプレイヤー１人を対象とする。あなたは「ゴブリンの付け火屋はそれに１点のダメージを与える。」を選んでもよい。\', \'type\': \'クリーチャー — ゴブリン・シャーマン\', \'flavor\': \'大きな力は、自分をも殺してしまうほどの大きな危険を伴う。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264258&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c776128c-080a-41d5-b127-f9991f677c8f\', \'multiverseId\': 264258}, \'multiverseid\': 264258}, {\'name\': \'고블린 방화범\', \'text\': \'고블린 방화범이 죽을 때, 생물 한 개나 플레이어 한 명을 목표로 정한다. 당신은 고블린 방화범으로 하여금 그 목표에게 피해 1점을 입히게 할 수 있다.\', \'type\': \'생물 — 고블린 주술사\', \'flavor\': \'큰 힘에는 죽음이라는 큰 위험이 따른다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'299cd96a-3ac1-4f9a-bc75-a1bc68f23b23\'}, \'multiverseid\': None}, {\'name\': \'Pirômano Goblin\', \'text\': \'Quando Pirômano Goblin morrer, você poderá fazer com que ele cause 1 ponto de dano à criatura ou ao jogador alvo.\', \'type\': \'Criatura — Goblin Xamã\', \'flavor\': \'Um poder grandioso também traz consigo um grande risco de morte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264507&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'823f582b-9367-4eaa-a017-a946271833bb\', \'multiverseId\': 264507}, \'multiverseid\': 264507}, {\'name\': \'Гоблин-Воспламенитель\', \'text\': \'Когда Гоблин-Воспламенитель умирает, вы можете заставить его нанести 1 повреждение целевому существу или игроку.\', \'type\': \'Существо — Гоблин Шаман\', \'flavor\': \'Чем больше власть, тем больше риск быть убитым.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264756&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1a0c15ee-42c8-4232-b381-0fb6844be2ca\', \'multiverseId\': 264756}, \'multiverseid\': 264756}, {\'name\': \'纵火鬼怪\', \'text\': \'当纵火鬼怪死去时，你可以让它对目标生物或牌手造成1点伤害。\', \'type\': \'生物～鬼怪／祭师\', \'flavor\': \'能力越强，丧命的危险越大。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263013&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1a9b3b72-2ef7-4074-879c-143e1589093a\', \'multiverseId\': 263013}, \'multiverseid\': 263013}, {\'name\': \'縱火鬼怪\', \'text\': \'當縱火鬼怪死去時，你可以讓它對目標生物或玩家造成1點傷害。\', \'type\': \'生物～鬼怪／祭師\', \'flavor\': \'能力越強，喪命的危險越大。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263262&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4305b0bf-ec0a-4786-828f-4d3f4a406547\', \'multiverseId\': 263262}, \'multiverseid\': 263262}]', '[{\'name\': \'Goblin-Häuptling\', \'text\': \'Eile (Diese Kreatur kann angreifen und {T}, sobald sie unter deine Kontrolle kommt.)\\nAndere Goblin-Kreaturen, die du kontrollierst, erhalten +1/+1 und Eile.\', \'type\': \'Kreatur — Goblin\', \'flavor\': \'„Jetzt kommt das \\\'Monster, Monster\\\'-Lied!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263762&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d31b62e5-15dc-49d8-b7d5-7f6205f5dd3c\', \'multiverseId\': 263762}, \'multiverseid\': 263762}, {\'name\': \'Cacique trasgo\', \'text\': \'Prisa. (Esta criatura puede atacar y {T} tan pronto como entre bajo tu control.)\\nLas otras criaturas Trasgo que controlas obtienen +1/+1 y tienen la habilidad de prisa.\', \'type\': \'Criatura — Trasgo\', \'flavor\': \'"¡Es hora de la canción \\\'Pum, pum\\\'!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265007&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'74f71e9e-8dcd-4926-9984-a65857b38d59\', \'multiverseId\': 265007}, \'multiverseid\': 265007}, {\'name\': \'Chef de clan gobelin\', \'text\': \'Célérité (Cette créature peut attaquer et {T} dès le tour où elle arrive sous votre contrôle.)\\nLes autres créatures Gobelin que vous contrôlez gagnent +1/+1 et ont la célérité.\', \'type\': \'Créature : gobelin\', \'flavor\': "« C\'est l\'heure du \'Crac, boum, hue\' ! »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263513&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7c48bb48-f05a-4428-b50d-b5a2b801e19a\', \'multiverseId\': 263513}, \'multiverseid\': 263513}, {\'name\': \'Capitano Goblin\', \'text\': \'Rapidità (Questa creatura può attaccare e {T} non appena entra sotto il tuo controllo.)\\nLe altre creature Goblin che controlli prendono +1/+1 e hanno rapidità.\', \'type\': \'Creatura — Goblin\', \'flavor\': \'"È ora della canzone \\\'Spacco tutto\\\'!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264011&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c0fbbd28-3a9f-48d6-8d63-071eaf4235e3\', \'multiverseId\': 264011}, \'multiverseid\': 264011}, {\'name\': \'ゴブリンの酋長\', \'text\': \'速攻 （このクリーチャーは、あなたのコントロール下になってすぐに攻撃したり{T}したりできる。）\\nあなたがコントロールする他のゴブリン・クリーチャーは、＋１/＋１の修整を受けるとともに速攻を持つ。\', \'type\': \'クリーチャー — ゴブリン\', \'flavor\': \'「『ドカバキ』の歌を歌おうぞ！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264260&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7e11e6c2-e992-4c23-af53-9c6e0b96e6c0\', \'multiverseId\': 264260}, \'multiverseid\': 264260}, {\'name\': \'고블린 추장\', \'text\': \'신속 (이 생물은 당신의 조종하에 들어오자마자 공격할 수도 있고 할 수도 있다.)당신이 조종하는 다른 고블린 생물들은 +1/+1을 받고, 신속 능력을 가진다.\', \'type\': \'생물 — 고블린\', \'flavor\': \'"부셔라, 부셔\\\' 노래를 울려라!"\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2b4bee63-c268-4c44-95c2-32bb94e09cc0\'}, \'multiverseid\': None}, {\'name\': \'Chefe Goblin\', \'text\': \'Ímpeto (Esta criatura pode atacar e {T} assim que entra sob seu controle.)\\nAs outras criaturas do tipo Goblin que você controla recebem +1/+1 e têm ímpeto.\', \'type\': \'Criatura — Goblin\', \'flavor\': \'"É hora da canção \\\'Bate, bate\\\'!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264509&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6bcce640-d96e-4731-bab6-91ccaae01963\', \'multiverseId\': 264509}, \'multiverseid\': 264509}, {\'name\': \'Гоблинский Предводитель\', \'text\': \'Ускорение (Это существо может атаковать и {T}, как только оно попадает под ваш контроль.)\\nДругие существа-Гоблины под вашим контролем получают +1/+1 и имеют Ускорение.\', \'type\': \'Существо — Гоблин\', \'flavor\': \'«А теперь споем песню "Эх, ломанем!"»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264758&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'de247a1c-1641-4924-849b-63d45b6a4c4a\', \'multiverseId\': 264758}, \'multiverseid\': 264758}, {\'name\': \'鬼怪酋长\', \'text\': \'敏捷 （此生物受你操控时便能攻击与{T}。）\\n由你操控的其他鬼怪生物得+1/+1并具有敏捷异能。\', \'type\': \'生物～鬼怪\', \'flavor\': \'「一起来唱『砸砸』歌！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263015&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ea3761ea-4e70-4d4e-b016-7f2e0717c77c\', \'multiverseId\': 263015}, \'multiverseid\': 263015}, {\'name\': \'鬼怪酋長\', \'text\': \'敏捷 （此生物受你操控時便能攻擊與{T}。）\\n由你操控的其他鬼怪生物得+1/+1並具有敏捷異能。\', \'type\': \'生物～鬼怪\', \'flavor\': \'「一起來唱『砸砸』歌！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263264&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'729838b7-ae25-403c-8881-327ee8fa7738\', \'multiverseId\': 263264}, \'multiverseid\': 263264}]', '[{\'name\': \'Goblin-Knallerwerfer\', \'text\': \'{T}: Wirf eine Münze. Falls du den Münzwurf gewinnst, fügt der Goblin-Knallerwerfer einer Kreatur oder einem Spieler deiner Wahl 2 Schadenspunkte zu. Falls du den Münzwurf verlierst, fügt der Goblin-Knallerwerfer sich selbst 2 Schadenspunkte zu.\', \'type\': \'Kreatur — Goblin, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263761&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2e0053d6-22c8-4e60-85fc-058021cc1ecb\', \'multiverseId\': 263761}, \'multiverseid\': 263761}, {\'name\': \'Trasgos tirabombas\', \'text\': \'{T}: Lanza una moneda a cara o cruz. Si ganas el lanzamiento, los Trasgos tirabombas hacen 2 puntos de daño a la criatura o jugador objetivo. Si pierdes el lanzamiento, los Trasgos tirabombas se hacen 2 puntos de daño a sí mismos.\', \'type\': \'Criatura — Guerrero trasgo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265006&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a68f3343-8a03-4554-b08b-63cb1e3c2fdb\', \'multiverseId\': 265006}, \'multiverseid\': 265006}, {\'name\': \'Lance-boum gobelins\', \'text\': "{T} : Jouez à pile ou face. Si vous gagnez, les Lance-boum gobelins infligent 2 blessures à une cible, créature ou joueur. Si vous perdez, les Lance-boum gobelins s\'infligent 2 blessures.", \'type\': \'Créature : gobelin et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263512&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b0cbda8e-71f1-42a1-b8ae-ba76903654ad\', \'multiverseId\': 263512}, \'multiverseid\': 263512}, {\'name\': \'Goblin Lanciascoppi\', \'text\': \'{T}: Lancia una moneta. Se vinci il lancio, i Goblin Lanciascoppi infliggono 2 danni a una creatura o a un giocatore bersaglio. Se perdi il lancio, i Goblin Lanciascoppi infliggono 2 danni a se stessi.\', \'type\': \'Creatura — Guerriero Goblin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264010&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0e492028-37f8-4587-a15f-c9e8d6a3ca2a\', \'multiverseId\': 264010}, \'multiverseid\': 264010}, {\'name\': \'ゴブリンの爆発投げ\', \'text\': \'{T}：クリーチャー１体かプレイヤー１人を対象とする。コイン投げをする。 あなたがそのコイン投げに勝った場合、ゴブリンの爆発投げはそれに２点のダメージを与える。 あなたがそのコイン投げに負けた場合、ゴブリンの爆発投げは自身に２点のダメージを与える。\', \'type\': \'クリーチャー — ゴブリン・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264259&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'403897cd-d2b6-43e3-b74a-a4df9fcfecdc\', \'multiverseId\': 264259}, \'multiverseid\': 264259}, {\'name\': \'고블린 폭투병\', \'text\': \'{T}: 생물 한 개나 플레이어 한 명을 목표로 정하고 나서, 동전을 던진다. 당신이 동전던지기에 이긴다면, 고블린 폭투병은 그 목표에게 피해 2점을 입힌다. 당신이 동전던지기에 진다면, 고블린 폭투병은 자체에게 피해 2점을 입힌다.\', \'type\': \'생물 — 고블린 전사\', \'flavor\': None, \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7720ade3-48af-4a9b-868c-8896fd913f24\'}, \'multiverseid\': None}, {\'name\': \'Goblins Lançadores de Estrondo\', \'text\': \'{T}: Lance uma moeda. Se você vencer, Goblins Lançadores de Estrondo causará 2 pontos de dano à criatura ou ao jogador alvo. Se você perder, Goblins Lançadores de Estrondo causará 2 pontos de dano a ele mesmo.\', \'type\': \'Criatura — Goblin Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264508&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'24f0c55a-bf04-40ec-a6b0-88a88dc31125\', \'multiverseId\': 264508}, \'multiverseid\': 264508}, {\'name\': \'Гоблины-Метатели Взрывчатки\', \'text\': \'{T}: подбросьте монету. Если вы выигрываете бросок, Гоблины-Метатели Взрывчатки наносят 2 повреждения целевому существу или игроку. Если вы проигрываете бросок, Гоблины-Метатели Взрывчатки наносят 2 повреждения самим себе.\', \'type\': \'Существо — Гоблин Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264757&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9e021c5d-9d14-474e-81df-3f332244ce57\', \'multiverseId\': 264757}, \'multiverseid\': 264757}, {\'name\': \'鬼怪掷弹兵\', \'text\': \'{T}：掷一枚硬币。 如果你赢得此掷，鬼怪掷弹兵对目标生物或牌手造成2点伤害。 如果你输掉此掷，鬼怪掷弹兵对本身造成2点伤害。\', \'type\': \'生物～鬼怪／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263014&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d698cba0-1303-4761-b5f6-6dfa6cb69174\', \'multiverseId\': 263014}, \'multiverseid\': 263014}, {\'name\': \'鬼怪擲彈兵\', \'text\': \'{T}：擲一枚硬幣。 如果你贏得此擲，鬼怪擲彈兵對目標生物或玩家造成2點傷害。 如果你輸掉此擲，鬼怪擲彈兵對本身造成2點傷害。\', \'type\': \'生物～鬼怪／戰士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263263&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'917ef512-4ab9-4ed6-a917-957023343983\', \'multiverseId\': 263263}, \'multiverseid\': 263263}]', '[{\'name\': \'Goblin-Kriegsbemalung\', \'text\': \'Kreaturenverzauberung\\nDie verzauberte Kreatur erhält +2/+2 und Eile. (Sie kann unabhängig davon, wann sie unter die Kontrolle ihres Beherrschers gekommen ist, angreifen und {T}.)\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Das Geheimnis unserer Kriegsbemalungsfarbe sind Chilischoten und Stinkekäfer. Jede Menge Stinkekäfer." —Skab, Goblingeheimnisträger\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263767&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6bd5a70b-e289-4465-9426-100aef9c1505\', \'multiverseId\': 263767}, \'multiverseid\': 263767}, {\'name\': \'Pintura de guerra trasga\', \'text\': \'Encantar criatura.\\nLa criatura encantada obtiene +2/+2 y tiene la habilidad de prisa. (Puede atacar y {T} sin importar cuándo entró bajo el control de su controlador.)\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"El secreto de nuestra pintura de guerra es pimientos picantes y bichos apestosos. Muchos bichos apestosos." —Skab, guardasecretos trasgo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265012&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'805e4d69-b0bc-42d9-a43f-2087167d5c64\', \'multiverseId\': 265012}, \'multiverseid\': 265012}, {\'name\': \'Peinture de guerre gobeline\', \'text\': \'Enchanter : créature\\nLa créature enchantée gagne +2/+2 et a la célérité. (Elle peut attaquer et {T} quel que soit le moment où elle est arrivée sous le contrôle de son contrôleur.)\', \'type\': \'Enchantement : aura\', \'flavor\': "« Le secret de notre peinture de guerre, c\'est de mélanger des piments et des dardeurs. Beaucoup de dardeurs. » —Skab, gardien des secrets gobelins", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263518&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'14ae6837-a97c-4238-99f9-a1012fbf7f30\', \'multiverseId\': 263518}, \'multiverseid\': 263518}, {\'name\': \'Pittura di Guerra dei Goblin\', \'text\': \'Incanta creatura\\nLa creatura incantata prende +2/+2 e ha rapidità. (Può attaccare e {T} indipendentemente da quando è entrata sotto il controllo del suo controllore.)\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Il segreto della nostra pittura di guerra sono i peperoncini e le cimici. Un sacco di cimici." —Skab, goblin dei segreti\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264016&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2782cfce-8cd7-4645-8361-5004fcf2f200\', \'multiverseId\': 264016}, \'multiverseid\': 264016}, {\'name\': \'ゴブリンの戦化粧\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは、＋２/＋２の修整を受けるとともに速攻を持つ。 （それがいつあなたのコントロール下になったかに関係なく、それは攻撃したり{T}したりできる。）\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「俺らの戦化粧の秘密は、唐辛子と臭虫だ。 臭虫は山盛りな。」 ――ゴブリンの秘密守り、スカッブ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264265&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'974dbda6-69dd-4a38-877a-3c9c16d2501c\', \'multiverseId\': 264265}, \'multiverseid\': 264265}, {\'name\': \'고블린 출진 물감\', \'text\': \'생물에게 부여부여된 생물은 +2/+2를 받고, 신속 능력을 가진다. (신속을 가진 생물은 조종자의 조종하에 들어오자마자 공격할 수도 있고 할 수도 있다.)\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'"우리 출진 물감의 비결은 매운 고추가루와 구린 벌레야. 구린 벌레를 듬뿍 넣지."—고블린 비밀지기 스캡\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'36c4b411-107b-48c1-b6f8-a4926194ec66\'}, \'multiverseid\': None}, {\'name\': \'Pintura de Guerra Goblin\', \'text\': \'Encantar criatura\\nA criatura encantada recebe +2/+2 e tem ímpeto. (Ela pode atacar e {T} independentemente de quando entrou sob o controle de seu controlador.)\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"O segredo de nossa pintura de guerra é pimenta e percevejos. Muitos percevejos." — Skab, guardião de segredos goblin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264514&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fed4506a-bfc1-4ca6-9748-feb2902730fe\', \'multiverseId\': 264514}, \'multiverseid\': 264514}, {\'name\': \'Боевая Раскраска Гоблинов\', \'text\': \'Зачаровать существо\\nЗачарованное существо получает +2/+2 и имеет Ускорение. (Оно может атаковать и {T} не зависимо от того, когда оно попало под контроль контролирующего его игрока.)\', \'type\': \'Чары — Аура\', \'flavor\': \'«Секрет нашей боевой краски — жгучий перец и вонючие клопы. Много-много вонючих клопов». — Скаб, гоблинский хранитель тайн\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264763&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'14bdac53-2ec0-4c52-8062-d84576fd69b1\', \'multiverseId\': 264763}, \'multiverseid\': 264763}, {\'name\': \'鬼怪战绘\', \'text\': \'结附于生物\\n所结附的生物得+2/+2并具有敏捷异能。 （它不论是何时受其操控者所操控，都能攻击与{T}。）\', \'type\': \'结界～灵气\', \'flavor\': \'「我们战绘的秘方就是辣胡椒与臭虫。 很多臭虫。」 ～秘方鬼怪撕喀\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263020&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e6e71674-aaa4-463e-88e2-3f46dfb0f030\', \'multiverseId\': 263020}, \'multiverseid\': 263020}, {\'name\': \'鬼怪戰繪\', \'text\': \'結附於生物\\n所結附的生物得+2/+2並具有敏捷異能。 （它不論是何時受其操控者所操控，都能攻擊與{T}。）\', \'type\': \'結界～靈氣\', \'flavor\': \'「我們戰繪的秘方就是辣胡椒與臭蟲。 很多臭蟲。」 ～秘方鬼怪撕喀\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263269&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'020339d8-183d-4036-9a5d-066f3e0682fe\', \'multiverseId\': 263269}, \'multiverseid\': 263269}]', '[{\'name\': \'Goblin-Lanzenträger\', \'type\': \'Kreatur — Goblin, Krieger\', \'flavor\': \'Sobald sie das spitze Ende gefunden haben, werden sie zum Wachdienst befördert.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263765&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'114fd53e-a47e-4379-8f40-0d44e0ae92aa\', \'multiverseId\': 263765}, \'multiverseid\': 263765}, {\'name\': \'Lancero trasgo\', \'type\': \'Criatura — Guerrero trasgo\', \'flavor\': \'Cuando descubrió qué extremo del objeto era el puntiagudo, fue ascendido al servicio de guardia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265010&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4c76fbad-057c-4cd8-a6ef-7f95e8791c73\', \'multiverseId\': 265010}, \'multiverseid\': 265010}, {\'name\': \'Piquier gobelin\', \'type\': \'Créature : gobelin et guerrier\', \'flavor\': "Une fois qu\'il eut découvert de quel côté ça coupait, il fut promu garde.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263516&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7b22b464-aa22-4edf-9304-e5ceb4e8e745\', \'multiverseId\': 263516}, \'multiverseid\': 263516}, {\'name\': \'Picchiere Goblin\', \'type\': \'Creatura — Guerriero Goblin\', \'flavor\': \'Quando riuscì a capire quale delle due estremità era appuntita, venne promosso ai servizi di guardia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264014&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'470e3f1c-57b7-4ef0-9367-fb638d0ab975\', \'multiverseId\': 264014}, \'multiverseid\': 264014}, {\'name\': \'ゴブリンの長槍使い\', \'type\': \'クリーチャー — ゴブリン・戦士\', \'flavor\': \'棒のどっちが尖っているか理解ができたことで、彼は警備役に昇格した。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264263&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'61b5fbd8-2f85-45b0-94b3-7023ca43cc85\', \'multiverseId\': 264263}, \'multiverseid\': 264263}, {\'name\': \'고블린 창병\', \'type\': \'생물 — 고블린 전사\', \'flavor\': \'물건의 어느 쪽이 뾰족한지 알게 된 그는, 그 공로를 인정받아 초소근무병으로 승진되었다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a24e85a3-9e84-42e4-9088-6089010829ec\'}, \'multiverseid\': None}, {\'name\': \'Goblin Piqueiro\', \'type\': \'Criatura — Goblin Guerreiro\', \'flavor\': \'Assim que ele aprendeu qual das pontas era afiada, foi promovido à função de guarda.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264512&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3edbaa63-c90c-4c36-8b29-51b1627d1415\', \'multiverseId\': 264512}, \'multiverseid\': 264512}, {\'name\': \'Гоблин-Копейщик\', \'type\': \'Существо — Гоблин Воин\', \'flavor\': \'Когда он запомнил, где у копья острый конец, ему доверили нести караульную службу.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264761&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'55fa7052-eecc-48a1-b91f-65abb84d7206\', \'multiverseId\': 264761}, \'multiverseid\': 264761}, {\'name\': \'鬼怪长矛兵\', \'type\': \'生物～鬼怪／战士\', \'flavor\': \'当他搞清楚这东西哪一头是尖端时，便晋升为守卫。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263018&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ef2edd0c-4e6a-4d47-baad-b878218dbd25\', \'multiverseId\': 263018}, \'multiverseid\': 263018}, {\'name\': \'鬼怪長矛兵\', \'type\': \'生物～鬼怪／戰士\', \'flavor\': \'當他搞清楚這東西哪一頭是尖端時，便晉升為守衛。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263267&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d9f61549-2b19-4b0e-b8c6-b3d9c2c624fd\', \'multiverseId\': 263267}, \'multiverseid\': 263267}]', '[{\'name\': \'Goblin-Tunnelgräber\', \'text\': \'{T}: Eine Kreatur deiner Wahl mit Stärke 2 oder weniger ist in diesem Zug unblockbar.\', \'type\': \'Kreatur — Goblin, Räuber\', \'flavor\': \'„Der beste Weg über einen Berg ist mitten hindurch."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263766&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4499a1f7-fc99-4807-b6cb-c3b5e3945b92\', \'multiverseId\': 263766}, \'multiverseid\': 263766}, {\'name\': \'Trasgo excavador de túneles\', \'text\': \'{T}: La criatura objetivo con fuerza de 2 o menos es imbloqueable este turno.\', \'type\': \'Criatura — Bribón trasgo\', \'flavor\': \'"La mejor manera de cruzar la montaña es a través."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265011&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9e6380cb-eda9-4218-bb19-b55ec24a5633\', \'multiverseId\': 265011}, \'multiverseid\': 265011}, {\'name\': \'Tunnelier gobelin\', \'text\': \'{T} : La créature ciblée de force inférieure ou égale à 2 est imblocable ce tour-ci.\', \'type\': \'Créature : gobelin et gredin\', \'flavor\': "« Le chemin le plus court, c\'est de passer à travers la montagne. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263517&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0bf0e43e-f456-4c11-bf93-7471f7358007\', \'multiverseId\': 263517}, \'multiverseid\': 263517}, {\'name\': \'Scavatore Goblin\', \'text\': \'{T}: Una creatura bersaglio con forza pari o inferiore a 2 non può essere bloccata in questo turno.\', \'type\': \'Creatura — Farabutto Goblin\', \'flavor\': \'"La strada migliore per superare la montagna è attraversarla."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264015&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ffd68942-798b-4af1-a8d6-07a21a36704c\', \'multiverseId\': 264015}, \'multiverseid\': 264015}, {\'name\': \'ゴブリンのトンネル掘り\', \'text\': \'{T}：パワーが２以下のクリーチャー１体を対象とする。このターン、それはブロックされない。\', \'type\': \'クリーチャー — ゴブリン・ならず者\', \'flavor\': \'「山を越えるにゃ、抜けてくのが一番さ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264264&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'561aaa62-d599-4f1c-8cf6-f0e59d4a15fe\', \'multiverseId\': 264264}, \'multiverseid\': 264264}, {\'name\': \'고블린 터널공\', \'text\': \'{T}: 2 이하의 공격력을 가진 생물 한 개를 목표로 정한다. 그 생물은 이 턴에 방어당하지 않는다.\', \'type\': \'고블린 도적\', \'flavor\': \'"산을 넘는 가장 좋은 방법은 당연히 뚫고 가는 거지."\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'aafa4943-ec86-4381-b8a2-6438418ab75e\'}, \'multiverseid\': None}, {\'name\': \'Cavador de Túneis Goblin\', \'text\': \'{T}: A criatura alvo com poder menor ou igual a 2 não pode ser bloqueada neste turno.\', \'type\': \'Criatura — Goblin Ladino\', \'flavor\': \'"O melhor meio de atravessar uma montanha é passando através dela."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264513&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f151e88a-f207-4c14-b4a8-c6af6611fdd6\', \'multiverseId\': 264513}, \'multiverseid\': 264513}, {\'name\': \'Гоблин-Проходчик\', \'text\': \'{T}: целевое существо с силой 2 или меньше не может быть заблокировано в этом ходу.\', \'type\': \'Существо — Гоблин Бродяга\', \'flavor\': \'«Лучший путь через гору — насквозь».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264762&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'363a1010-bd83-44e5-b018-48c7d901a481\', \'multiverseId\': 264762}, \'multiverseid\': 264762}, {\'name\': \'穿隧鬼怪\', \'text\': \'{T}：目标力量等于或小于2的生物本回合不能被阻挡。\', \'type\': \'生物～鬼怪／浪客\', \'flavor\': \'「穿越山脉的最好方法就是钻过去。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263019&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5ceb8a0b-e9db-4a5d-8a16-36424f0fd04e\', \'multiverseId\': 263019}, \'multiverseid\': 263019}, {\'name\': \'穿隧鬼怪\', \'text\': \'{T}：目標力量等於或小於2的生物本回合不能被阻擋。\', \'type\': \'生物～鬼怪／浪客\', \'flavor\': \'「穿越山脈的最好方法就是鑽過去。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263268&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d18dd3f8-61dc-4a1c-bfdf-7e17b6ff4132\', \'multiverseId\': 263268}, \'multiverseid\': 263268}]', "[{'name': 'Goblingranate', 'text': 'Opfere einen Goblin als zusätzliche Kosten, um die Goblingranate zu wirken.\\nDie Goblingranate fügt einer Kreatur oder einem Spieler deiner Wahl 5 Schadenspunkte zu.', 'type': 'Hexerei', 'flavor': 'Unterschätze niemals die aerodynamischen Eigenschaften eines ganz normalen Goblins.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263764&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a0ab8d41-598e-42a8-87ba-6c8e8ed65ea4', 'multiverseId': 263764}, 'multiverseid': 263764}, {'name': 'Granada trasgo', 'text': 'Como coste adicional para lanzar la Granada trasgo, sacrifica un Trasgo.\\nLa Granada trasgo hace 5 puntos de daño a la criatura o jugador objetivo.', 'type': 'Conjuro', 'flavor': 'No subestimes las cualidades aerodinámicas de un trasgo común.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265009&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '3ae6579d-d613-426c-b550-56597a67b24f', 'multiverseId': 265009}, 'multiverseid': 265009}, {'name': 'Grenade gobeline', 'text': 'En tant que coût supplémentaire pour lancer la Grenade gobeline, sacrifiez un gobelin.\\nLa Grenade gobeline inflige 5 blessures à une cible, créature ou joueur.', 'type': 'Rituel', 'flavor': 'Ne sous-estimez pas les qualités aérodynamiques du gobelin de base.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263515&type=card', 'language': 'French', 'identifiers': {'scryfallId': '4d476b2e-2e8d-4e0b-9623-646aa830e553', 'multiverseId': 263515}, 'multiverseid': 263515}, {'name': 'Granata Goblin', 'text': 'Come costo addizionale per lanciare la Granata Goblin, sacrifica un Goblin.\\nLa Granata Goblin infligge 5 danni a una creatura o a un giocatore bersaglio.', 'type': 'Stregoneria', 'flavor': 'Non sottovalutare le qualità aerodinamiche del goblin comune.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264013&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'e60efd5a-0d3e-4a20-9306-2d3f6a1f7409', 'multiverseId': 264013}, 'multiverseid': 264013}, {'name': 'ゴブリンの手投げ弾', 'text': 'ゴブリンの手投げ弾を唱えるための追加コストとして、ゴブリンを１体生け贄に捧げる。\\nクリーチャー１体かプレイヤー１人を対象とする。ゴブリンの手投げ弾はそれに５点のダメージを与える。', 'type': 'ソーサリー', 'flavor': '一般的なゴブリンの空力性能を馬鹿にするもんじゃない。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264262&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'a66e3df5-f797-4d3b-854c-db9bc3cebdf2', 'multiverseId': 264262}, 'multiverseid': 264262}, {'name': '고블린식 수류탄', 'text': '고블린식 수류탄을 발동하기 위한 추가비용으로써 고블린 지속물 한 개를 희생한다.생물 한 개나 플레이어 한 명을 목표로 정한다. 고블린식 수류탄은 그 목표에게 피해 5점을 입힌다.', 'type': '집중마법', 'flavor': '일반 고블린의 공기역학적 소질을 얕보지 말라.', 'language': 'Korean', 'identifiers': {'scryfallId': '8de81403-7cd7-46f0-aa2d-8648cf5946ff'}, 'multiverseid': None}, {'name': 'Granada Goblin', 'text': 'Como custo adicional para conjurar Granada Goblin, sacrifique um Goblin.\\nGranada Goblin causa 5 pontos de dano à criatura ou ao jogador alvo.', 'type': 'Feitiço', 'flavor': 'Não subestime as qualidades aerodinâmicas do goblin comum.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264511&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '96d45a69-f0c1-4218-aa99-e2aba5145c3a', 'multiverseId': 264511}, 'multiverseid': 264511}, {'name': 'Гоблинская Граната', 'text': 'В качестве дополнительной стоимости разыгрывания Гоблинской Гранаты пожертвуйте Гоблина.\\nГоблинская Граната наносит 5 повреждений целевому существу или игроку.', 'type': 'Волшебство', 'flavor': 'Не стоит недооценивать аэродинамические качества простого гоблина.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264760&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'da93a7cb-9aeb-48d9-9a16-4340fc95d066', 'multiverseId': 264760}, 'multiverseid': 264760}, {'name': '鬼怪手榴弹', 'text': '牺牲一个鬼怪，以作为施放鬼怪手榴弹的额外费用。\\n鬼怪手榴弹对目标生物或牌手造成5点伤害。', 'type': '法术', 'flavor': '别小看了一般鬼怪的空气动力学品质。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263017&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '927a06dd-2c27-44ec-927f-e189111e38ee', 'multiverseId': 263017}, 'multiverseid': 263017}, {'name': '鬼怪手榴彈', 'text': '犧牲一個鬼怪，以作為施放鬼怪手榴彈的額外費用。\\n鬼怪手榴彈對目標生物或玩家造成5點傷害。', 'type': '巫術', 'flavor': '別小看了一般鬼怪的空氣動力學品質。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263266&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'c11002c0-e0e4-4afc-97b6-66a157fddce4', 'multiverseId': 263266}, 'multiverseid': 263266}]", '[{\'name\': \'Grabes-Titan\', \'text\': \'Todesberührung\\nImmer wenn der Grabes-Titan ins Spiel kommt oder angreift, bringe zwei 2/2 schwarze Zombie-Kreaturenspielsteine ins Spiel.\', \'type\': \'Kreatur — Riese\', \'flavor\': \'Tod in Form und Funktion.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263722&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a8343082-3365-4d85-bf17-d9e4bfda092e\', \'multiverseId\': 263722}, \'multiverseid\': 263722}, {\'name\': \'Titán de la tumba\', \'text\': \'Toque mortal.\\nSiempre que el Titán de la tumba entre al campo de batalla o ataque, pon en el campo de batalla dos fichas de criatura Zombie negras 2/2.\', \'type\': \'Criatura — Gigante\', \'flavor\': \'La muerte en forma y función.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264967&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'518b7e18-2179-4d29-bd84-e0795c128be9\', \'multiverseId\': 264967}, \'multiverseid\': 264967}, {\'name\': \'Titan des tombes\', \'text\': "Contact mortel\\nÀ chaque fois que le Titan des tombes arrive sur le champ de bataille ou qu\'il attaque, mettez sur le champ de bataille deux jetons de créature 2/2 noire Zombie.", \'type\': \'Créature : géant\', \'flavor\': \'La mort par forme et par fonction.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263473&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f990b790-b660-49ea-a602-7faab992077b\', \'multiverseId\': 263473}, \'multiverseid\': 263473}, {\'name\': \'Titano Sepolcrale\', \'text\': \'Tocco letale\\nOgniqualvolta il Titano Sepolcrale entra nel campo di battaglia o attacca, metti sul campo di battaglia due pedine creatura Zombie 2/2 nere.\', \'type\': \'Creatura — Gigante\', \'flavor\': \'Morte di nome e di fatto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263971&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'53a278ae-8946-4509-898d-65c81fa55a11\', \'multiverseId\': 263971}, \'multiverseid\': 263971}, {\'name\': \'墓所のタイタン\', \'text\': \'接死\\n墓所のタイタンが戦場に出るか攻撃するたび、黒の２/２のゾンビ・クリーチャー・トークンを２体戦場に出す。\', \'type\': \'クリーチャー — 巨人\', \'flavor\': \'姿と機能を有した死。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264220&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a34ff3b8-e36a-4cda-82e9-6f3ad26d6d1a\', \'multiverseId\': 264220}, \'multiverseid\': 264220}, {\'name\': \'무덤 거신\', \'text\': \'치명타무덤 거신이 전장에 들어올 때나 공격할 때마다, 2/2 흑색 좀비 생물 토큰 두 개를 전장에 놓는다.\', \'type\': \'생물 — 거인\', \'flavor\': \'형태나 기능이나 죽음 그 자체.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'23133d44-e496-4c03-a4f9-15bad532e984\'}, \'multiverseid\': None}, {\'name\': \'Titã do Túmulo\', \'text\': \'Toque mortífero\\nToda vez que Titã do Túmulo entrar no campo de batalha ou atacar, coloque no campo de batalha duas fichas de criatura pretas 2/2 do tipo Zumbi.\', \'type\': \'Criatura — Gigante\', \'flavor\': \'Morte em forma e função.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264469&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'703e4e0a-ad33-4b54-8e5e-b88e6472d589\', \'multiverseId\': 264469}, \'multiverseid\': 264469}, {\'name\': \'Могильный Титан\', \'text\': \'Смертельное касание\\nКаждый раз когда Могильный Титан выходит на поле битвы или атакует, положите на поле битвы две фишки существа 2/2 черный Зомби.\', \'type\': \'Существо — Гигант\', \'flavor\': \'Это смерть и по облику, и по назначению.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264718&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4fb793f7-4f3c-4f0f-97b9-99dd0230b5b1\', \'multiverseId\': 264718}, \'multiverseid\': 264718}, {\'name\': \'墓地泰坦\', \'text\': \'死触\\n每当墓地泰坦进战场或攻击时，将两个2/2黑色灵俑衍生生物放进战场。\', \'type\': \'生物～巨人\', \'flavor\': \'死亡的可运作实体。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262975&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fd6326c1-c921-40f9-b09a-194fa0d10297\', \'multiverseId\': 262975}, \'multiverseid\': 262975}, {\'name\': \'墓地泰坦\', \'text\': \'死觸\\n每當墓地泰坦進戰場或攻擊時，將兩個2/2黑色殭屍衍生生物放進戰場。\', \'type\': \'生物～巨人\', \'flavor\': \'死亡的可運作實體。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263224&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7560008f-d1b0-4e25-9497-424fd8c756ff\', \'multiverseId\': 263224}, \'multiverseid\': 263224}]', '[{\'name\': \'Greifen-Wachposten\', \'text\': \'Fliegend\\nWachsamkeit (Diese Kreatur wird beim Angreifen nicht getappt.)\', \'type\': \'Kreatur — Greif\', \'flavor\': \'Sobald ein Greifenwächter ein Gebiet für sich beansprucht hat, kann ihn nur der Tod von seinem Posten entfernen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263645&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'83868541-8dd8-4e44-9de0-3d45fbfde622\', \'multiverseId\': 263645}, \'multiverseid\': 263645}, {\'name\': \'Grifo centinela\', \'text\': \'Vuela.\\nVigilancia. (Esta criatura no se gira al atacar.)\', \'type\': \'Criatura — Grifo\', \'flavor\': \'Una vez que un grifo centinela adopta un territorio como propio, sólo la muerte puede obligarlo a dejar su puesto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264890&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6e5f886a-aeb8-47ba-ae33-5c1ffa4163ea\', \'multiverseId\': 264890}, \'multiverseid\': 264890}, {\'name\': \'Sentinelle griffon\', \'text\': "Vol\\nVigilance (Attaquer avec cette créature ne la fait pas s\'engager.)", \'type\': \'Créature : griffon\', \'flavor\': "Une fois qu\'une sentinelle griffon s\'approprie un territoire, seule la mort peut la forcer à abandonner son poste.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263396&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fde81ab9-5468-4d58-84ca-35aa75d9ac87\', \'multiverseId\': 263396}, \'multiverseid\': 263396}, {\'name\': \'Grifone Sentinella\', \'text\': \'Volare\\nCautela (Questa creatura attacca senza TAPpare.)\', \'type\': \'Creatura — Grifone\', \'flavor\': \'Dopo che un grifone sentinella ha fatto proprio un territorio, solo la morte può costringerlo ad abbandonare la sua postazione.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263894&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'65a42d4b-6418-45ba-a69a-13e51432536b\', \'multiverseId\': 263894}, \'multiverseid\': 263894}, {\'name\': \'グリフィンの歩哨\', \'text\': \'飛行警戒\\n （このクリーチャーは攻撃してもタップしない。）\', \'type\': \'クリーチャー — グリフィン\', \'flavor\': \'一度持ち場に着いたグリフィンの歩哨をそこから引き離すことができるのは死だけだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264143&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e5743287-8ba7-419d-b36f-546ecd63bf7c\', \'multiverseId\': 264143}, \'multiverseid\': 264143}, {\'name\': \'그리핀 보초\', \'text\': \'비행경계 (이 생물은 공격하면서 탭되지 않는다.)\', \'type\': \'생물 — 그리핀\', \'flavor\': \'그리핀 보초가 한 구역을 자신의 것으로 취하면, 그는 죽지 않는 한 그곳을 버리지 않는다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1e9c3f0c-ab60-4fff-8719-94440be1f444\'}, \'multiverseid\': None}, {\'name\': \'Grifo Sentinela\', \'text\': \'Voar\\nVigilância (Atacar não faz com que esta criatura seja virada.)\', \'type\': \'Criatura — Grifo\', \'flavor\': \'Quando um grifo sentinela adota um território como seu, somente a morte pode forçá-lo a trair seu posto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264392&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'06314416-8954-4c6e-b64a-cda56fff16c5\', \'multiverseId\': 264392}, \'multiverseid\': 264392}, {\'name\': \'Грифон-Часовой\', \'text\': \'Полет\\nБдительность (Атакуя, это существо не поворачивается.)\', \'type\': \'Существо — Грифон\', \'flavor\': \'Если уж грифон взял под свое крыло территорию, только смерть может заставить его покинуть свой пост.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264641&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ee0a95fa-2c18-4a15-88d1-019548efe5c4\', \'multiverseId\': 264641}, \'multiverseid\': 264641}, {\'name\': \'哨兵狮鹫\', \'text\': \'飞行\\n警戒 （此生物攻击时不需横置。）\', \'type\': \'生物～狮鹫\', \'flavor\': \'一旦哨兵狮鹫认定了自己的领域，便至死都不会离开岗位。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262898&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1444b456-ac87-4752-a899-f8b9b843cc77\', \'multiverseId\': 262898}, \'multiverseid\': 262898}, {\'name\': \'哨兵獅鷲\', \'text\': \'飛行\\n警戒 （此生物攻擊時不需橫置。）\', \'type\': \'生物～獅鷲\', \'flavor\': \'一旦哨兵獅鷲認定了自己的領域，便至死都不會離開崗位。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263147&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4cfa40b8-91d6-4544-90d5-6dbf474923d6\', \'multiverseId\': 263147}, \'multiverseid\': 263147}]', "[{'name': 'Greifenreiter', 'text': 'Solange du eine Greif-Kreatur kontrollierst, erhält der Greifenreiter +3/+3 und Flugfähigkeit.', 'type': 'Kreatur — Mensch, Ritter', 'flavor': 'Nachdem sie Seite an Seite mit den Greifenreitern gekämpft hatten, fingen auch die älteren Ritter von Thune an, Reittiere zu bewundern, die Feinde in Stücke zerreißen konnten.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263644&type=card', 'language': 'German', 'identifiers': {'scryfallId': '6fc55684-cd11-4123-9aa7-75dff9cf9cec', 'multiverseId': 263644}, 'multiverseid': 263644}, {'name': 'Jinete de grifo', 'text': 'Mientras controles una criatura Grifo, el Jinete de grifo obtiene +3/+3 y tiene la habilidad de volar.', 'type': 'Criatura — Caballero humano', 'flavor': 'Después de luchar junto a los jinetes de grifos, los veteranos caballeros de Thune aprendieron a admirar a una montura que puede reducir un enemigo a jirones en segundos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264889&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '620e2033-19f8-413a-8673-38fb5fe7af7b', 'multiverseId': 264889}, 'multiverseid': 264889}, {'name': 'Monteuse de griffon', 'text': 'Tant que vous contrôlez une créature Griffon, la Monteuse de griffon gagne +3/+3 et a le vol.', 'type': 'Créature : humain et chevalier', 'flavor': 'Après avoir combattu aux côtés des monteurs de griffon, les chevaliers de Thiune les plus âgés apprirent à admirer une monture capable de déchiqueter un ennemi en quelques secondes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263395&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'cdf538c7-202b-4153-8704-859643cd4392', 'multiverseId': 263395}, 'multiverseid': 263395}, {'name': 'Cavalcagrifoni', 'text': 'Fintanto che controlli una creatura Grifone, la Cavalcagrifoni prende +3/+3 e ha volare.', 'type': 'Creatura — Cavaliere Umano', 'flavor': 'Dopo aver combattuto al fianco dei cavalcagrifoni, gli anziani cavalieri di Thune impararono ad ammirare una cavalcatura che può fare a pezzi un nemico in pochi secondi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263893&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ab8c72e4-0e2b-4dac-b982-671fe4d10454', 'multiverseId': 263893}, 'multiverseid': 263893}, {'name': 'グリフィンの乗り手', 'text': 'あなたがグリフィン・クリーチャーをコントロールしているかぎり、グリフィンの乗り手は＋３/＋３の修整を受けるとともに飛行を持つ。', 'type': 'クリーチャー — 人間・騎士', 'flavor': 'グリフィンの乗り手とともに戦ってから、年上のテューンの騎士は、敵を一瞬でずたずたに引き裂く乗り物の素晴らしさを知った。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264142&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '01844c2b-5664-43b7-976f-a8b45b23ce65', 'multiverseId': 264142}, 'multiverseid': 264142}, {'name': '그리핀 기수', 'text': '당신이 그리핀 생물을 조종하는 동안, 그리핀 기수는 +3/+3을 받고 비행 능력을 가진다.', 'type': '생물 — 인간 기사', 'flavor': '쑨의 고참 기사들은 그리핀 기수들과 함께 싸워본 후에야 상대를 조각낼 수 있는 탈것의 가치를 인정했다.', 'language': 'Korean', 'identifiers': {'scryfallId': 'c037a768-87b5-4caa-844f-75685370456e'}, 'multiverseid': None}, {'name': 'Ginete de Grifo', 'text': 'Enquanto você controlar uma criatura do tipo Grifo, Ginete de Grifo receberá +3/+3 e terá voar.', 'type': 'Criatura — Humano Cavaleiro', 'flavor': 'Após lutar ao lado dos ginetes de grifo, os cavaleiros mais antigos de Thune aprenderam a apreciar montar um animal capaz de estraçalhar um inimigo em segundos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264391&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9b57496c-d410-4bf3-8526-6bb6a3bca460', 'multiverseId': 264391}, 'multiverseid': 264391}, {'name': 'Наездник Грифонов', 'text': 'Пока вы контролируете существо-Грифона, Наездник Грифонов получает +3/+3 и имеет Полет.', 'type': 'Существо — Человек Рыцарь', 'flavor': 'Сражаясь плечом к плечу с наездниками грифонов, умудренные опытом рыцари Туна научились восхищаться ездовыми бестиями, способными в считаные секунды разорвать врага на клочки.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264640&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '8e1c0ea2-9b7c-4136-b630-bef584b83a56', 'multiverseId': 264640}, 'multiverseid': 264640}, {'name': '狮鹫骑兵', 'text': '只要你操控狮鹫生物，狮鹫骑兵便得+3/+3并具有飞行异能。', 'type': '生物～人类／骑士', 'flavor': '年长的图恩骑士与狮鹫骑兵并肩作战之后，对这些有能耐在几秒内撕碎敌手的座骑更添敬意。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262897&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'd8dc373e-be7b-4ba3-8a8d-9ee9bab154a9', 'multiverseId': 262897}, 'multiverseid': 262897}, {'name': '獅鷲騎兵', 'text': '只要你操控獅鷲生物，獅鷲騎兵便得+3/+3並具有飛行異能。', 'type': '生物～人類／騎士', 'flavor': '年長的圖恩騎士與獅鷲騎兵並肩作戰之後，對這些有能耐在幾秒內撕碎敵手的座騎更添敬意。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263146&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '6e881eb2-bda8-4834-bf57-e46db3e5da63', 'multiverseId': 263146}, 'multiverseid': 263146}]", '[{\'name\': \'Grimmiger Magmamagier\', \'text\': \'{R}, {T}, schicke zwei Karten aus deinem Friedhof ins Exil: Der Grimmige Magmamagier fügt einer Kreatur oder einem Spieler deiner Wahl 2 Schadenspunkte zu.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'„Nur Narren graben nach Wasser, nach Leichen oder nach Gold. Die wahren Schätze der Erde liegen weit tiefer."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263769&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ca04d5d6-0fa7-4fb0-b39d-8856cc940070\', \'multiverseId\': 263769}, \'multiverseid\': 263769}, {\'name\': \'Lavamante siniestro\', \'text\': \'{R}, {T}, exiliar dos cartas de tu cementerio: El Lavamante siniestro hace 2 puntos de daño a la criatura o jugador objetivo.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'"Los tontos cavan en busca de agua, cadáveres u oro. El tesoro verdadero de la tierra está a mayor profundidad".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265014&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c4208815-6801-4acc-ae1e-1c97cec8a5a9\', \'multiverseId\': 265014}, \'multiverseid\': 265014}, {\'name\': \'Sinistre lavamancien\', \'text\': \'{R}, {T}, exilez deux cartes de votre cimetière : Le Sinistre lavamancien inflige 2 blessures à une cible, créature ou joueur.\', \'type\': \'Créature : humain et sorcier\', \'flavor\': "« Les fous creusent pour l\'eau, les cadavres ou l\'or. La vraie richesse de la Terre est plus profonde. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263520&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c046c930-7d4c-45b8-94fe-62c7b396cce9\', \'multiverseId\': 263520}, \'multiverseid\': 263520}, {\'name\': \'Lavamante Spietato\', \'text\': \'{R}, {T}, Esilia due carte dal tuo cimitero: Il Lavamante Spietato infligge 2 danni a una creatura o a un giocatore bersaglio.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': \'"Gli stolti scavano alla ricerca di acqua, corpi e oro. Il vero tesoro della terra è molto più in profondità."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264018&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a527cedb-b385-4c66-884e-c3d0c53eddd0\', \'multiverseId\': 264018}, \'multiverseid\': 264018}, {\'name\': \'渋面の溶岩使い\', \'text\': \'{R}, {T}, あなたの墓地にあるカードを２枚追放する：クリーチャー１体かプレイヤー１人を対象とする。渋面の溶岩使いはそれに２点のダメージを与える。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'「バカ者どもは水や死体や金を求めて土を掘る。 だが大地の真の宝は、もっと深いところにあるのだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264267&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c0214746-6062-41c5-a359-2a64678f05ef\', \'multiverseId\': 264267}, \'multiverseid\': 264267}, {\'name\': \'죽음의 용암술사\', \'text\': \', , 당신의 무덤에서 카드 두 장을 추방한다: 생물 한 개나 플레이어 한 명을 목표로 정한다. 죽음의 용암술사는 그 목표에게 피해 2점을 입힌다.\', \'type\': \'생물 — 인간 마법사\', \'flavor\': \'"사람들은 어리석게도 물이나 시체, 황금을 찾으려고 땅을 파더군. 땅의 진정한 보물은 더 깊은 곳에 있거늘."\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'328d5271-1169-4c4f-8f9b-76393cb21f75\'}, \'multiverseid\': None}, {\'name\': \'Lavamante Implacável\', \'text\': \'{R}, {T}, Exile dois cards de seu cemitério: Lavamante Implacável causa 2 pontos de dano à criatura ou ao jogador alvo.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'"Os tolos escavam em busca de água, cadáveres ou ouro. A verdadeira riqueza da terra está muito abaixo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264516&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b924f594-7324-49c3-b9bb-ddc5679cd250\', \'multiverseId\': 264516}, \'multiverseid\': 264516}, {\'name\': \'Мрачный Лавомант\', \'text\': \'{R}, {T}, изгоните две карты из вашего кладбища: Мрачный Лавомант наносит 2 повреждения целевому существу или игроку.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'«Глупцы копают в поисках воды, трупов или золота. Истинное сокровище земли залегает гораздо глубже».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264765&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a8c50810-0dba-4186-9b8a-3dc549e47be1\', \'multiverseId\': 264765}, \'multiverseid\': 264765}, {\'name\': \'狰狞熔岩术士\', \'text\': \'{R}，{T}，从你坟墓场中放逐两张牌：狰狞熔岩术士对目标生物或牌手造成2点伤害。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'「愚人挖地找水，尸体，或是金子。 大地的真正宝藏要埋得更深。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263022&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'da765fec-fcb5-49b1-946b-cf82166023c3\', \'multiverseId\': 263022}, \'multiverseid\': 263022}, {\'name\': \'猙獰熔岩術士\', \'text\': \'{R}，{T}，從你墳墓場中放逐兩張牌：猙獰熔岩術士對目標生物或玩家造成2點傷害。\', \'type\': \'生物～人類／魔法師\', \'flavor\': \'「愚人挖地找水，屍體，或是金子。 大地的真正寶藏要埋得更深。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263271&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1bd900fe-d098-4690-9ed7-b2d280b92fba\', \'multiverseId\': 263271}, \'multiverseid\': 263271}]', '[{\'name\': \'Großer Abschaffer\', \'text\': \'Während deines Zuges können deine Gegner keine Zaubersprüche wirken oder Fähigkeiten von Artefakten, Kreaturen oder Verzauberungen aktivieren.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': \'„Dein Aberglauben und dein Gemurmel halten meiner Rechtschaffenheit nicht stand."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263643&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d2652d85-70b3-4e15-a26e-8129f7b3bf5f\', \'multiverseId\': 263643}, \'multiverseid\': 263643}, {\'name\': \'Gran abolidor\', \'text\': \'Durante tu turno, tus oponentes no pueden lanzar hechizos o activar habilidades de artefactos, criaturas o encantamientos.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': \'"Tus supersticiones y balbuceos no servirán de nada frente a mi rectitud."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264888&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'024a3be2-a1d2-4255-83e9-f19bfe295d3e\', \'multiverseId\': 264888}, \'multiverseid\': 264888}, {\'name\': \'Grand abolisseur\', \'text\': \'Pendant votre tour, vos adversaires ne peuvent pas lancer de sorts ou activer les capacités des artefacts, des créatures ou des enchantements.\', \'type\': \'Créature : humain et clerc\', \'flavor\': \'« Vos superstitions et vos grommellements sont impuissants face à ma droiture. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263394&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bbbe1efe-fa1f-4e56-8a4c-2b62d5fd3024\', \'multiverseId\': 263394}, \'multiverseid\': 263394}, {\'name\': \'Grande Abolitore\', \'text\': \'Durante il tuo turno, i tuoi avversari non possono lanciare magie o attivare abilità di artefatti, creature o incantesimi.\', \'type\': \'Creatura — Chierico Umano\', \'flavor\': \'"Le tue superstizioni e le tue ciance sono sciocchezze inutili di fronte alla mia rettitudine."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263892&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'92d23b79-5c8c-43df-a0fe-8d2ea034363a\', \'multiverseId\': 263892}, \'multiverseid\': 263892}, {\'name\': \'堂々たる撤廃者\', \'text\': \'あなたのターン中、あなたの対戦相手は呪文を唱えることもアーティファクトやクリーチャーやエンチャントの能力を起動することもできない。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': \'「お前の迷信や戯言は、私の正義の前には無用の屑だ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264141&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4e8c88df-70d6-4906-a242-fc36b2d66f85\', \'multiverseId\': 264141}, \'multiverseid\': 264141}, {\'name\': \'대척결사\', \'text\': \'당신의 턴 중에, 모든 상대는 주문을 발동할 수도 없고, 마법물체나 생물이나 부여마법의 능력을 활성화할 수도 없다.\', \'type\': \'생물 — 인간 성직자\', \'flavor\': \'"네놈들의 미신과 중얼거림은 내 정의 앞에서 무용지물이다."\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3eb8eb47-4796-458b-97d8-ae359fd5cc2f\'}, \'multiverseid\': None}, {\'name\': \'Abolidor-Mor\', \'text\': \'Durante o seu turno, seus oponentes não podem conjurar mágicas nem ativar habilidades de artefatos, criaturas ou encantamentos.\', \'type\': \'Criatura — Humano Clérigo\', \'flavor\': \'"Suas superstições e murmúrios são insignificantes diante de minha integridade."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264390&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0f129b54-a863-4473-b371-767e416e05cd\', \'multiverseId\': 264390}, \'multiverseid\': 264390}, {\'name\': \'Великий Упразднитель\', \'text\': \'Во время вашего хода ваши оппоненты не могут разыгрывать заклинания или активировать способности артефактов, существ или чар.\', \'type\': \'Существо — Человек Священник\', \'flavor\': \'«Ваше суеверное бормотание — пустое сотрясание воздуха перед лицом моей справедливости».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264639&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cd6cd2f8-3704-4c45-9513-4ad67c75f05e\', \'multiverseId\': 264639}, \'multiverseid\': 264639}, {\'name\': \'止咒高僧\', \'text\': \'在你的回合中，所有对手都不能施放咒语或起动神器、生物、或结界的异能。\', \'type\': \'生物～人类／僧侣\', \'flavor\': \'「在我正气当前，你那些迷信与呓语都是无用长物。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262896&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cd62e0d3-9598-475a-ae29-22710e813f13\', \'multiverseId\': 262896}, \'multiverseid\': 262896}, {\'name\': \'止咒高僧\', \'text\': \'在你的回合中，所有對手都不能施放咒語或起動神器、生物、或結界的異能。\', \'type\': \'生物～人類／僧侶\', \'flavor\': \'「在我正氣當前，你那些迷信與囈語都是無用長物。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263145&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a40789d7-21e7-4d23-a904-db5dddc64051\', \'multiverseId\': 263145}, \'multiverseid\': 263145}]', '[{\'name\': \'Grässliche Fratze\', \'text\': \'Kreaturen, die du kontrollierst, haben bis zum Ende des Zuges Einschüchtern. (Jede dieser Kreaturen kann außer von Artefaktkreaturen und/oder Kreaturen, mit denen sie eine Farbe gemeinsam hat, nicht geblockt werden.)\', \'type\': \'Hexerei\', \'flavor\': \'„Zu sehen, wie du vor mir kauerst, ist eine Belohnung für sich."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263724&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0d01d4f9-5533-4a61-807b-89948b166f26\', \'multiverseId\': 263724}, \'multiverseid\': 263724}, {\'name\': \'Máscara espantosa\', \'text\': \'Las criaturas que controlas ganan la habilidad de intimidar hasta el final del turno. (Esas criaturas no pueden ser bloqueadas excepto por criaturas artefacto y/o criaturas que compartan un color con ellas.)\', \'type\': \'Conjuro\', \'flavor\': \'"Verte huir de mí es su propia recompensa."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264969&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'689b7172-4b40-4a97-8eaa-59eafef9ad3e\', \'multiverseId\': 264969}, \'multiverseid\': 264969}, {\'name\': \'Visage hideux\', \'text\': "Les créatures que vous contrôlez acquièrent l\'intimidation jusqu\'à la fin du tour. (Chacune de ces créatures ne peut pas être bloquée excepté par des créatures-artefacts et/ou des créatures qui partagent une couleur avec elle.)", \'type\': \'Rituel\', \'flavor\': "« Te voir te recroqueviller d\'horreur devant moi est une juste récompense. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263475&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'44426d46-8e6f-4e39-a50d-3a1115e2c1ce\', \'multiverseId\': 263475}, \'multiverseid\': 263475}, {\'name\': \'Viso Ripugnante\', \'text\': \'Le creature che controlli hanno intimidire fino alla fine del turno. (Ciascuna di quelle creature non può essere bloccata tranne che da creature artefatto e/o creature che condividono con essa un colore.)\', \'type\': \'Stregoneria\', \'flavor\': \'"Vederti rannicchiare di fronte a me è di per sé una ricompensa."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263973&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'91c5adf0-0e33-4e4f-a0b6-9a87ed1b9f5d\', \'multiverseId\': 263973}, \'multiverseid\': 263973}, {\'name\': \'忌まわしい容貌\', \'text\': \'あなたがコントロールするクリーチャーは、ターン終了時まで威嚇を得る。 （それらの各クリーチャーはアーティファクト・クリーチャーかそれと共通の色を持つクリーチャー以外によってはブロックされない。）\', \'type\': \'ソーサリー\', \'flavor\': \'「怯えた顔は、それ自身が私への褒美だ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264222&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'08062e2e-8eeb-4be9-aaeb-56d0fdbf662e\', \'multiverseId\': 264222}, \'multiverseid\': 264222}, {\'name\': \'추악한 면상\', \'text\': \'당신이 조종하는 모든 생물은 턴종료까지 위협 능력을 얻는다. (위협을 가진 생물은 마법물체 생물 및 또는 자체와 색을 공유하는 생물에게만 방어당할 수 있다.)\', \'type\': \'집중마법\', \'flavor\': \'"네놈이 내 앞에서 벌벌 기는 꼴을 보는 것 자체가 보람있는 일이지."\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a7da22b3-b9bd-48c5-aa2e-5a7e87240c1e\'}, \'multiverseid\': None}, {\'name\': \'Face Horrenda\', \'text\': \'As criaturas que você controla ganham intimidar até o final do turno. (Cada uma dessas criaturas só pode ser bloqueada por criaturas artefato e/ou criaturas que compartilhem uma cor com ela.)\', \'type\': \'Feitiço\', \'flavor\': \'"Ver você tremer de medo diante de mim é a recompensa."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264471&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c411b303-a2f4-4be4-86e5-49aa112458cb\', \'multiverseId\': 264471}, \'multiverseid\': 264471}, {\'name\': \'Жуткий Лик\', \'text\': \'Существа под вашим контролем получают Устрашение до конца хода. (Каждое из тех существ может быть заблокировано только артефактными существами и (или) существами, у которых есть такой же цвет, как у него.)\', \'type\': \'Волшебство\', \'flavor\': \'«Смотреть, как вы сжимаетесь от страха предо мной, само по себе является наградой».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264720&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fc487376-e4ac-43bf-aab4-14e46f37c86a\', \'multiverseId\': 264720}, \'multiverseid\': 264720}, {\'name\': \'骇人恶容\', \'text\': \'由你操控的生物获得威吓异能直到回合结束。 （这些生物只能被神器和／或与它有共通颜色的生物阻挡。）\', \'type\': \'法术\', \'flavor\': \'「见到你在我面前畏缩奔逃，就已值回票价。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262977&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6478bb02-7d48-4872-a826-4e9d15399925\', \'multiverseId\': 262977}, \'multiverseid\': 262977}, {\'name\': \'駭人惡容\', \'text\': \'由你操控的生物獲得威嚇異能直到回合結束。 （這些生物只能被神器和／或與它有共通顏色的生物阻擋。）\', \'type\': \'巫術\', \'flavor\': \'「見到你在我面前畏縮奔逃，就已值回票價。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263226&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'60def23c-82e9-4cc9-9e02-a9b7d206f394\', \'multiverseId\': 263226}, \'multiverseid\': 263226}]', '[{\'name\': \'Größerer Basilisk\', \'text\': \'Todesberührung (Eine beliebige Menge Schadenspunkte, die er einer Kreatur zufügt, sind ausreichend, um sie zu zerstören.)\', \'type\': \'Kreatur — Basilisk\', \'flavor\': \'Ob Knochen oder Stein: Einem hungrigen Basilisken schmeckt beides.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263803&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ec67c0fb-b99d-47b0-9cb5-d110f47f6bc4\', \'multiverseId\': 263803}, \'multiverseid\': 263803}, {\'name\': \'Basilisco superior\', \'text\': \'Toque mortal. (Cualquier cantidad de daño que esto haga a una criatura es suficiente para destruirla.)\', \'type\': \'Criatura — Basilisco\', \'flavor\': \'Hueso, piedra... saben igual para un basilisco hambriento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265048&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5ed6138e-fb3a-4826-92c6-5c3b24e3727f\', \'multiverseId\': 265048}, \'multiverseid\': 265048}, {\'name\': \'Grand basilic\', \'text\': "Contact mortel (Le nombre de blessures que cette créature inflige à une créature, quel qu\'il soit, est suffisant pour la détruire.)", \'type\': \'Créature : basilic\', \'flavor\': \'Os, pierre . . . pour un basilic affamé, tout a le même goût.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263554&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ff03fcfa-54aa-41d5-8ed9-58e0a4680b75\', \'multiverseId\': 263554}, \'multiverseid\': 263554}, {\'name\': \'Basilisco Maggiore\', \'text\': \'Tocco letale (Qualsiasi danno che questa creatura infligge a una creatura è sufficiente a distruggerla.)\', \'type\': \'Creatura — Basilisco\', \'flavor\': \'Ossa, sasso. . . hanno lo stesso sapore per un basilisco affamato.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264052&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6f9141ff-63cc-456a-834d-1af82bffca71\', \'multiverseId\': 264052}, \'multiverseid\': 264052}, {\'name\': \'大いなるバジリスク\', \'text\': \'接死 （これが何らかのダメージをクリーチャーに与えた場合、それだけで破壊される。）\', \'type\': \'クリーチャー — バジリスク\', \'flavor\': \'骨と石……飢えたバジリスクにとっては、どちらの味も似たようなもの。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264301&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'82a83a19-dcf0-4b99-bfa8-6cab78658a9b\', \'multiverseId\': 264301}, \'multiverseid\': 264301}, {\'name\': \'대형 바실리스크\', \'text\': \'치명타 (이 생물에게 피해를 입은 생물은 얼마의 피해를 입든 파괴된다.)\', \'type\': \'생물 — 바실리스크\', \'flavor\': \'뼈든 돌이든 굶주린 바실리스크에게는 똑같은 맛이다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'359dbc5d-0a0f-4b11-a2a4-1b646871661b\'}, \'multiverseid\': None}, {\'name\': \'Basilisco Maior\', \'text\': \'Toque mortífero (Qualquer quantidade de dano que esta criatura cause a uma criatura é suficiente para destruí-la.)\', \'type\': \'Criatura — Basilisco\', \'flavor\': \'Osso, pedra... para um basilisco faminto, o gosto é o mesmo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264550&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b30d4a86-ecc9-4b7e-a3c2-14dc95921dd2\', \'multiverseId\': 264550}, \'multiverseid\': 264550}, {\'name\': \'Большой Василиск\', \'text\': \'Смертельное касание (Любое количество повреждений, которое этот объект наносит существу, достаточно, чтобы его уничтожить.)\', \'type\': \'Существо — Василиск\', \'flavor\': \'Кости, камни... голодному василиску все равно, что жевать.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264799&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'303c2842-bed3-4465-b28d-34fd2946af35\', \'multiverseId\': 264799}, \'multiverseid\': 264799}, {\'name\': \'高大蜥怪\', \'text\': \'死触 （它对生物造成的任何数量伤害都足以消灭后者。）\', \'type\': \'生物～蜥怪\', \'flavor\': \'白骨，石头...对肚饿的蜥怪来说，味道都一样。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263056&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a89fcabe-44d0-4d48-a602-a46f31903bec\', \'multiverseId\': 263056}, \'multiverseid\': 263056}, {\'name\': \'高大蜥怪\', \'text\': \'死觸 （它對生物造成的任何數量傷害都足以消滅後者。）\', \'type\': \'生物～蜥怪\', \'flavor\': \'白骨，石頭...對肚餓的蜥怪來說，味道都一樣。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263305&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1e356d08-f84e-45a7-bcbd-f5430670df71\', \'multiverseId\': 263305}, \'multiverseid\': 263305}]', '[{\'name\': \'Göttliche Gunst\', \'text\': \'Kreaturenverzauberung\\nWenn die Göttliche Gunst ins Spiel kommt, erhältst du 3 Lebenspunkte dazu.\\nDie verzauberte Kreatur erhält +1/+3.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Mit einem Arsenal aus Licht kann selbst ein Junker sein Volk anführen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263638&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d61ee67d-ea43-4bb1-b48c-69e02def8803\', \'multiverseId\': 263638}, \'multiverseid\': 263638}, {\'name\': \'Favor divino\', \'text\': \'Encantar criatura.\\nCuando el Favor divino entre al campo de batalla, ganas 3 vidas.\\nLa criatura encantada obtiene +1/+3.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'Armado con la luz, hasta el escudero podría defender a su gente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264883&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'761e3153-d2cc-46d1-8b04-06cb4cdb16db\', \'multiverseId\': 264883}, \'multiverseid\': 264883}, {\'name\': \'Faveur divine\', \'text\': \'Enchanter : créature\\nQuand la Faveur divine arrive sur le champ de bataille, vous gagnez 3 points de vie.\\nLa créature enchantée gagne +1/+3.\', \'type\': \'Enchantement : aura\', \'flavor\': "Avec l\'armurerie de la lumière, même une écuyère peut devenir la championne de son peuple.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263389&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9064e5d2-eebe-4239-8a64-177e028236de\', \'multiverseId\': 263389}, \'multiverseid\': 263389}, {\'name\': \'Benevolenza Divina\', \'text\': \'Incanta creatura\\nQuando la Benevolenza Divina entra nel campo di battaglia, guadagni 3 punti vita.\\nLa creatura incantata prende +1/+3.\', \'type\': \'Incantesimo — Aura\', \'flavor\': "Con un\'armeria di luce, perfino la scudiera può difendere il suo popolo.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263887&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a62571a1-af82-4730-8675-38fd6e3e2957\', \'multiverseId\': 263887}, \'multiverseid\': 263887}, {\'name\': \'神聖なる好意\', \'text\': \'エンチャント（クリーチャー）\\n神聖なる好意が戦場に出たとき、あなたは３点のライフを得る。\\nエンチャントされているクリーチャーは＋１/＋３の修整を受ける。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'光の武装をまとえば、従者ですら勇者となる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264136&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1806c612-e2dc-46b3-b882-48cdc6b085fd\', \'multiverseId\': 264136}, \'multiverseid\': 264136}, {\'name\': \'신의 은혜\', \'text\': \'생물에게 부여신의 은혜가 전장에 들어올 때, 당신은 생명 3점을 얻는다.부여된 생물은 +1/+3을 받는다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'빛의 무기고가 있다면, 일개 종자도 그의 일족을 대표할 수 있다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'cd545161-94ee-47ab-9067-11b023987985\'}, \'multiverseid\': None}, {\'name\': \'Proteção Divina\', \'text\': \'Encantar criatura\\nQuando Proteção Divina entra no campo de batalha, você ganha 3 pontos de vida.\\nA criatura encantada recebe +1/+3.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'Com um arsenal de luz, até mesmo a escudeira pode defender seu povo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264385&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5f6ca409-1e58-4b3b-b35d-01e7ee469e24\', \'multiverseId\': 264385}, \'multiverseid\': 264385}, {\'name\': \'Божественное Покровительство\', \'text\': \'Зачаровать существо\\nКогда Божественное Покровительство выходит на поле битвы, вы получаете 3 жизни.\\nЗачарованное существо получает +1/+3.\', \'type\': \'Чары — Аура\', \'flavor\': \'Вооруженный светом, даже оруженосец способен защитить свой народ.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264634&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b7325bd8-637c-4760-9286-5658252a1785\', \'multiverseId\': 264634}, \'multiverseid\': 264634}, {\'name\': \'上天眷顾\', \'text\': \'结附于生物\\n当上天眷顾进战场时，你获得3点生命。\\n所结附的生物得+1/+3。\', \'type\': \'结界～灵气\', \'flavor\': \'有明光作武装，就连个扈从都能成为同袍之光。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262891&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c6a89218-b048-4bd5-b322-8894a301570e\', \'multiverseId\': 262891}, \'multiverseid\': 262891}, {\'name\': \'上天眷顧\', \'text\': \'結附於生物\\n當上天眷顧進戰場時，你獲得3點生命。\\n所結附的生物得+1/+3。\', \'type\': \'結界～靈氣\', \'flavor\': \'有明光作武裝，就連個扈從都能成為同袍之光。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263140&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'615c7c3c-34b3-4d32-9653-dacdb9e69a8b\', \'multiverseId\': 263140}, \'multiverseid\': 263140}]', '[{\'name\': \'Hafenschlange\', \'text\': \'Inseltarnung (Diese Kreatur ist unblockbar, solange der verteidigende Spieler eine Insel kontrolliert.)\\nDie Hafenschlange kann nicht angreifen, falls nicht fünf oder mehr Inseln im Spiel sind.\', \'type\': \'Kreatur — Schlange\', \'flavor\': \'Wie die meisten riesigen Monster, die von Dorfbewohnern als Götter angebetet werden, sind sie launische Herrscher.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263680&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6ad34445-3964-4af5-b89f-fc89d9fe23f2\', \'multiverseId\': 263680}, \'multiverseid\': 263680}, {\'name\': \'Serpiente de puerto\', \'text\': \'Cruza islas. (Esta criatura es imbloqueable mientras el jugador defensor controle una isla.)\\nLa Serpiente de puerto no puede atacar a menos que haya cinco o más islas en el campo de batalla.\', \'type\': \'Criatura — Serpiente\', \'flavor\': \'Al igual que la mayoría de los monstruos gigantes que los aldeanos adoran como dioses, ha demostrado ser un amo inestable.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264925&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b8e28367-5dcb-4c84-8c0a-1cead6f714e7\', \'multiverseId\': 264925}, \'multiverseid\': 264925}, {\'name\': \'Serpent portuaire\', \'text\': "Traversée des îles (Cette créature est imblocable tant que le joueur défenseur contrôle au moins une île.)\\nLe Serpent portuaire ne peut pas attaquer à moins qu\'il n\'y ait au moins cinq îles sur le champ de bataille.", \'type\': \'Créature : serpent\', \'flavor\': "Comme la plupart des monstres géants vénérés comme des dieux par les villageois, c\'est un maître capricieux.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263431&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b6a117cc-2ff6-42ca-a548-ada80cdd6832\', \'multiverseId\': 263431}, \'multiverseid\': 263431}, {\'name\': \'Serpe del Porto\', \'text\': "Passa-Isole (Questa creatura non può essere bloccata fintanto che il giocatore in difesa controlla un\'Isola.)\\nLa Serpe del Porto non può attaccare a meno che non ci siano cinque o più Isole sul campo di battaglia.", \'type\': \'Creatura — Serpe\', \'flavor\': \'Come molti mostri giganteschi che gli abitanti del villaggio venerano come divinità, si dimostra un padrone volubile.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263929&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'530d4c81-a18c-4c30-82d3-6346c5d1c0b4\', \'multiverseId\': 263929}, \'multiverseid\': 263929}, {\'name\': \'湾口の海蛇\', \'text\': \'島渡り （このクリーチャーは防御プレイヤーが島をコントロールしているかぎりブロックされない。）\\n湾口の海蛇は、戦場に島が５つ以上あるのでないかぎり攻撃できない。\', \'type\': \'クリーチャー — 海蛇\', \'flavor\': \'村人が神として崇める巨大な怪物の多くと同様に、それは気まぐれな主である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264178&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'294546c2-4790-44be-b1ae-56285742f689\', \'multiverseId\': 264178}, \'multiverseid\': 264178}, {\'name\': \'항구 이무기\', \'text\': \'섬잠입 (이 생물은 수비플레이어가 섬을 조종하는 동안은 방어당하지 않는다.)항구 이무기는 전장에 다섯 개 이상의 섬이 없으면 공격할 수 없다.\', \'type\': \'생물 — 이무기\', \'flavor\': \'마을 사람들이 신으로 모시는 거대괴수들이 늘 그렇듯, 그것은 제멋대로 행동한다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c947f0a7-2c5b-4331-9c6e-dfb9ed2873c9\'}, \'multiverseid\': None}, {\'name\': \'Serpente do Porto\', \'text\': \'Travessia de ilha (Esta criatura não poderá ser bloqueada enquanto o jogador defensor controlar uma Ilha.)\\nSerpente do Porto não pode atacar a menos que haja cinco ou mais Ilhas no campo de batalha.\', \'type\': \'Criatura — Serpente\', \'flavor\': \'Assim como a maioria dos monstros venerados pelos aldeões, ele é um mestre muito volúvel.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264427&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f679ad2b-4d5c-4975-95d0-191a29e6c9a0\', \'multiverseId\': 264427}, \'multiverseid\': 264427}, {\'name\': \'Змей Гавани\', \'text\': \'Знание Островов (Это существо не может быть заблокировано, пока защищающийся игрок контролирует Остров.)\\nЗмей Гавани не может атаковать, если на поле битвы нет пяти или более Островов.\', \'type\': \'Существо — Змей\', \'flavor\': \'Как и большинство гигантских чудовищ, которым поклоняются поселяне, он является весьма своенравным богом.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264676&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'afa40fc5-da50-4893-ab7a-389d44a312cf\', \'multiverseId\': 264676}, \'multiverseid\': 264676}, {\'name\': \'港湾巨蛇\', \'text\': \'海岛行者 （只要防御牌手操控海岛，此生物就不能被阻挡）\\n除非战场上有五个或更多海岛，否则港湾巨蛇不能攻击。\', \'type\': \'生物～巨蛇\', \'flavor\': \'他是个喜怒无常的主子，就如同大多数被村民如神景仰的巨大怪兽一样。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262933&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'476ab59d-cf7e-42c6-aa66-ec513a39de0a\', \'multiverseId\': 262933}, \'multiverseid\': 262933}, {\'name\': \'港灣巨蛇\', \'text\': \'海島行者 （只要防禦玩家操控海島，此生物就不能被阻擋）\\n除非戰場上有五個或更多海島，否則港灣巨蛇不能攻擊。\', \'type\': \'生物～巨蛇\', \'flavor\': \'牠是個喜怒無常的主子，就如同大多數被村民如神景仰的巨大怪獸一樣。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263182&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9d8b8478-c4ff-44aa-9ba9-ca2400c0dbca\', \'multiverseId\': 263182}, \'multiverseid\': 263182}]', '[{\'name\': \'Hautwandler\', \'text\': \'{G}: Bestimme eines — Bis zum Ende des Zuges wird der Hautwandler zu einem 4/4 Nashorn und verursacht Trampelschaden; oder bis zum Ende des Zuges wird der Hautwandler zu einem 2/2 Vogel und erhält Flugfähigkeit; oder bis zum Ende des Zuges wird der Hautwandler eine 0/8 Pflanze. Aktiviere diese Fähigkeit nur einmal pro Zug.\', \'type\': \'Kreatur — Mensch, Schamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263819&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0cf1dd55-f1fc-4683-8000-0b637c2a700c\', \'multiverseId\': 263819}, \'multiverseid\': 263819}, {\'name\': \'Cambiapieles\', \'text\': \'{G}: Elige uno: Hasta el final del turno el Cambiapieles es un Rinoceronte 4/4 y gana la habilidad de arrollar; o hasta el final del turno el Cambiapieles es un Ave 2/2 y gana la habilidad de volar; o hasta el final del turno el Cambiapieles es una Planta 0/8. Activa esta habilidad sólo una vez cada turno.\', \'type\': \'Criatura — Chamán humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265064&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bdd42126-fc1e-4814-ac9d-62caecec6841\', \'multiverseId\': 265064}, \'multiverseid\': 265064}, {\'name\': \'Changepeau\', \'text\': "{G} : Choisissez l\'un — Jusqu\'à la fin du tour, le Changepeau devient un rhinocéros 4/4 et il acquiert le piétinement ; ou jusqu\'à la fin du tour, le Changepeau devient un oiseau 2/2 et il acquiert le vol ; ou jusqu\'à la fin du tour, le Changepeau devient une plante 0/8. N\'activez cette capacité qu\'une seule fois par tour.", \'type\': \'Créature : humain et shamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263570&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'82d061b7-f2cb-4a7c-92af-8d7e12fc8000\', \'multiverseId\': 263570}, \'multiverseid\': 263570}, {\'name\': \'Pellemorfo\', \'text\': \'{G}: Scegli uno — Fino alla fine del turno, il Pellemorfo diventa un Rinoceronte 4/4 e ha travolgere; oppure fino alla fine del turno, il Pellemorfo diventa un Uccello 2/2 e ha volare; oppure fino alla fine del turno, il Pellemorfo diventa una Pianta 0/8. Attiva questa abilità solo una volta per turno.\', \'type\': \'Creatura — Sciamano Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264068&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'aa05210d-c92e-481c-9778-820765e89c5b\', \'multiverseId\': 264068}, \'multiverseid\': 264068}, {\'name\': \'肌変わり\', \'text\': \'{G}：以下の３つから１つを選ぶ。「ターン終了時まで、肌変わりは４/４のサイになるとともにトランプルを得る。」「ターン終了時まで、肌変わりは２/２の鳥になるとともに飛行を得る。」「ターン終了時まで、肌変わりは０/８の植物になる。」 この能力は、毎ターン１回のみ起動できる。\', \'type\': \'クリーチャー — 人間・シャーマン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264317&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4c287990-573a-4c9b-a406-9db7ba6876cd\', \'multiverseId\': 264317}, \'multiverseid\': 264317}, {\'name\': \'둔갑술사\', \'text\': \'{G}: 하나를 선택한다 — 턴종료까지, 둔갑술사는 4/4 코뿔소 생물로 변하고 돌진 능력을 얻는다; 아니면 턴종료까지, 둔갑술사는 2/2 조류 생물로 변하고 비행 능력을 얻는다; 아니면 턴종료까지, 둔갑술사는 0/8 식물 생물로 변한다. 각 턴에 한 번씩만 이 능력을 활성화한다.\', \'type\': \'생물 — 인간 주술사\', \'flavor\': None, \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e26f4ea9-a836-4916-9fc3-2f53e931ff3c\'}, \'multiverseid\': None}, {\'name\': \'Dermomorfo\', \'text\': \'{G}: Escolha um — Até o final do turno, Dermomorfo torna-se uma criatura 4/4 do tipo Rinoceronte e ganha atropelar; ou até o final do turno, Dermomorfo torna-se uma criatura 2/2 do tipo Ave e ganha voar; ou até o final do turno, Dermomorfo torna-se uma criatura 0/8 do tipo Planta. Ative esta habilidade apenas uma vez a cada turno.\', \'type\': \'Criatura — Humano Xamã\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264566&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fc1a932f-1868-4f86-817c-b2d698eb6ed1\', \'multiverseId\': 264566}, \'multiverseid\': 264566}, {\'name\': \'Перевертень\', \'text\': \'{G}: выберите одно — До конца хода Перевертень становится Носорогом 4/4 и получает Пробивной удар; или до конца хода Перевертень становится Птицей 2/2 и получает Полет; или до конца хода Перевертень становится Растением 0/8. Активируйте эту способность только один раз за ход.\', \'type\': \'Существо — Человек Шаман\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264815&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'781d5217-b865-4ed0-9663-9e329bac3388\', \'multiverseId\': 264815}, \'multiverseid\': 264815}, {\'name\': \'变貌师\', \'text\': \'{G}：选择一项～直到回合结束，变貌师成为4/4犀牛且获得践踏异能；或直到回合结束，变貌师成为2/2鸟且获得飞行异能；或直到回合结束，变貌师成为0/8植物。 此异能每回合中只能起动一次。\', \'type\': \'生物～人类／祭师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263072&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3513c85a-3288-438e-9401-cc7619289135\', \'multiverseId\': 263072}, \'multiverseid\': 263072}, {\'name\': \'變貌師\', \'text\': \'{G}：選擇一項～直到回合結束，變貌師成為4/4犀牛且獲得踐踏異能；或直到回合結束，變貌師成為2/2鳥且獲得飛行異能；或直到回合結束，變貌師成為0/8植物。 此異能每回合中只能起動一次。\', \'type\': \'生物～人類／祭師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263321&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d46f3dce-50f2-4090-8e84-b5193d93c15f\', \'multiverseId\': 263321}, \'multiverseid\': 263321}]', '[{\'name\': \'Heiliger Wolf\', \'text\': \'Fluchsicher (Diese Kreatur kann nicht das Ziel von Zaubersprüchen oder Fähigkeiten sein, die deine Gegner kontrollieren.)\', \'type\': \'Kreatur — Wolf\', \'flavor\': \'„Ich spannte meinen Bogen, und der Wolf starrte mich an. Sein Blick fesselte mich, und ich konnte die Sehne nicht loslassen." —Aref der Jäger\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263818&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ce1285e2-f605-4a97-a3ed-d072c51c72d5\', \'multiverseId\': 263818}, \'multiverseid\': 263818}, {\'name\': \'Lobo sagrado\', \'text\': \'Antimaleficio. (Esta criatura no puede ser objetivo de hechizos o habilidades que controlen tus oponentes.)\', \'type\': \'Criatura — Lobo\', \'flavor\': \'"Levanté mi arco, y el lobo me miró fijamente. Bajo su mirada, no podía soltar la cuerda." —Áref el Cazador\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265063&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d4bbe267-311e-44fe-a143-84ca4cd11a16\', \'multiverseId\': 265063}, \'multiverseid\': 265063}, {\'name\': \'Loup sacré\', \'text\': \'Défense talismanique (Cette créature ne peut pas être la cible de sorts ou de capacités que vos adversaires contrôlent.)\', \'type\': \'Créature : loup\', \'flavor\': "« J\'ai pointé mon arc et le loup m\'a fixé. Soudain, mon doigt a refusé de lâcher la corde. » —Aref, le chasseur", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263569&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'eb2a09c7-6c97-47ca-9982-8885113e7768\', \'multiverseId\': 263569}, \'multiverseid\': 263569}, {\'name\': \'Lupo Sacro\', \'text\': \'Anti-malocchio (Questa creatura non può essere bersaglio di magie o abilità controllate dai tuoi avversari.)\', \'type\': \'Creatura — Lupo\', \'flavor\': \'"Ho alzato l\\\'arco e il lupo mi ha fissato. Sotto il suo sguardo, le mie dita non avrebbero mollato la corda." —Aref il Cacciatore\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264067&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dfc2ca05-9e33-4b92-999d-3b75f54df582\', \'multiverseId\': 264067}, \'multiverseid\': 264067}, {\'name\': \'聖なる狼\', \'text\': \'呪禁 （このクリーチャーは、あなたの対戦相手がコントロールする呪文や能力の対象にならない。）\', \'type\': \'クリーチャー — 狼\', \'flavor\': \'「弓を構えたら、その狼が俺をにらみ付けたんだ。 それを見たら、指が弦を離せなくなっちまって。」 ――狩人アレフ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264316&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'42a1930c-d5a5-4325-b9c9-fa291d20d800\', \'multiverseId\': 264316}, \'multiverseid\': 264316}, {\'name\': \'성스러운 늑대\', \'text\': \'방호 (이 생물은 상대가 조종하는 주문이나 능력의 목표로 정해질 수 없다.)\', \'type\': \'생물 — 늑대\', \'flavor\': \'"내가 활을 들자, 그 늑대가 날 뻔히 바라보더군. 눈이 마주치가, 내 손가락이 시위에서 떠나질 않더라고."—사냥꾼 아레프\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'43b6bded-2250-45e5-9a71-eea4772fc776\'}, \'multiverseid\': None}, {\'name\': \'Lobo Sagrado\', \'text\': \'Resistência à magia (Esta criatura alvo não pode ser alvo de mágicas nem de habilidades que seus oponentes controlam.)\', \'type\': \'Criatura — Lobo\', \'flavor\': \'"Eu alcei meu arco e o lobo me fitou. Sob seu olhar, meu dedo não poderia liberar a corda." — Aref, o Caçador\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264565&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b91527c4-0d76-4d17-868b-1303cb76f92d\', \'multiverseId\': 264565}, \'multiverseid\': 264565}, {\'name\': \'Священный Волк\', \'text\': \'Порчеустойчивость (Это существо не может быть целью заклинаний или способностей под контролем ваших оппонентов.)\', \'type\': \'Существо — Волк\', \'flavor\': \'«Я поднял лук, как вдруг волк уставился на меня. Под его долгим и пристальным взглядом палец мой не смог отпустить тетиву». — Ареф Охотник\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264814&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'38ec9e8d-611e-4d6c-855c-e57f61f33110\', \'multiverseId\': 264814}, \'multiverseid\': 264814}, {\'name\': \'圣狼\', \'text\': \'辟邪 （此生物不能成为由对手所操控之咒语或异能的目标。）\', \'type\': \'生物～狼\', \'flavor\': \'「我举起弓，那狼便盯着我瞧。 给他这样看着，我的手指竟没办法松开弓弦。」 ～猎户阿烈\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263071&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f9f2df02-6c1f-4a8b-9eac-de81325822bf\', \'multiverseId\': 263071}, \'multiverseid\': 263071}, {\'name\': \'聖狼\', \'text\': \'辟邪 （此生物不能成為由對手所操控之咒語或異能的目標。）\', \'type\': \'生物～狼\', \'flavor\': \'「我舉起弓，那狼便盯著我瞧。 給牠這樣看著，我的手指竟沒辦法鬆開弓弦。」 ～獵戶阿烈\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263320&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ed46fccd-3c81-45c6-9dd6-ba8eafcf4874\', \'multiverseId\': 263320}, \'multiverseid\': 263320}]', '[{\'name\': \'Herr des Irrealen\', \'text\': \'Illusion-Kreaturen, die du kontrollierst, erhalten +1/+1 und sind fluchsicher. (Sie können nicht das Ziel von Zaubersprüchen oder Fähigkeiten sein, die deine Gegner kontrollieren.)\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'„Der Traum endet erst, wenn ich das sage."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263686&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5419d689-fc91-4456-85f1-0ca1bd1ac34c\', \'multiverseId\': 263686}, \'multiverseid\': 263686}, {\'name\': \'Señor de lo irreal\', \'text\': \'Las criaturas Ilusión que controlas obtienen +1/+1 y tienen antimaleficio. (No pueden ser objetivo de hechizos o habilidades que controlen tus oponentes.)\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'"El sueño no termina hasta que yo lo digo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264931&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e4b55f8d-0c06-4d3e-9800-048b0b8810e7\', \'multiverseId\': 264931}, \'multiverseid\': 264931}, {\'name\': "Seigneur de l\'irréel", \'text\': \'Les créatures Illusion que vous contrôlez gagnent +1/+1 et ont la défense talismanique. (Elles ne peuvent pas être les cibles de sorts ou de capacités que vos adversaires contrôlent.)\', \'type\': \'Créature : humain et sorcier\', \'flavor\': \'« Le rêve cessera quand je le déciderai. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263437&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2115e1c8-0d37-454a-8206-224aae5118ba\', \'multiverseId\': 263437}, \'multiverseid\': 263437}, {\'name\': "Signore dell\'Irreale", \'text\': \'Le creature Illusione che controlli prendono +1/+1 e hanno anti-malocchio. (Non possono essere bersaglio di magie o abilità controllate dai tuoi avversari.)\', \'type\': \'Creatura — Mago Umano\', \'flavor\': \'"Il sogno non finisce finché non lo dico io."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263935&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1e877716-5431-4b22-97c9-64cc3dc04790\', \'multiverseId\': 263935}, \'multiverseid\': 263935}, {\'name\': \'非実在の王\', \'text\': \'あなたがコントロールするイリュージョン・クリーチャーは、＋１/＋１の修整を受けるとともに呪禁を持つ。 （それらはあなたの対戦相手がコントロールする呪文や能力の対象にならない。）\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'「私が終わったというまで、夢は終わらない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264184&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'807dfa33-8f23-4bb1-91d1-8eff683e9a3b\', \'multiverseId\': 264184}, \'multiverseid\': 264184}, {\'name\': \'비현실세계의 지배자\', \'text\': \'당신이 조종하는 모든 환영 생물은 +1/+1을 받고, 방호 능력을 가진다. (당신이 조종하는 모든 환영 생물은 상대가 조종하는 주문이나 능력의 목표로 정해질 수 없다.)\', \'type\': \'생물 — 인간 마법사\', \'flavor\': \'"꿈은 내가 명하지 않으면 끝나지 않는다."\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'42e752e9-028a-4aa6-9097-b50ce2f23e5e\'}, \'multiverseid\': None}, {\'name\': \'Senhor do Irreal\', \'text\': \'As criaturas do tipo Ilusão que você controla recebem +1/+1 e têm resistência à magia. (Elas não podem ser alvo de mágicas nem de habilidades que seus oponentes controlam.)\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'"O sonho só termina quando eu disser que terminou."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264433&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ee0dd1e8-d005-4410-a8fa-90cd9c20b49d\', \'multiverseId\': 264433}, \'multiverseid\': 264433}, {\'name\': \'Повелитель Нереальности\', \'text\': \'Существа-Иллюзии под вашим контролем получают +1/+1 и имеют Порчеустойчивость. (Они не могут быть целями заклинаний или способностей под контролем ваших оппонентов.)\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'«Пока я не скажу, сон не закончится».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264682&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e4bffae1-2b9e-453c-a468-1d0020557fe7\', \'multiverseId\': 264682}, \'multiverseid\': 264682}, {\'name\': \'虚境之王\', \'text\': \'由你操控的虚影生物得+1/+1并具有辟邪异能。 （它们不能成为由对手所操控之咒语或异能的目标。）\', \'type\': \'生物～人类／法术师\', \'flavor\': \'「梦要等我说结束，才算真的结束。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262939&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fc6056f7-a79c-4248-a0d7-e6dcce0f4025\', \'multiverseId\': 262939}, \'multiverseid\': 262939}, {\'name\': \'虛境之王\', \'text\': \'由你操控的虛影生物得+1/+1並具有辟邪異能。 （它們不能成為由對手所操控之咒語或異能的目標。）\', \'type\': \'生物～人類／魔法師\', \'flavor\': \'「夢要等我說結束，才算真的結束。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263188&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ec75e7a2-1dde-4392-b49f-3fab385d8be6\', \'multiverseId\': 263188}, \'multiverseid\': 263188}]', '[{\'name\': \'Himmelswindersceada\', \'text\': \'Fliegend\\nDer Himmelswindersceada kann nur fliegende Kreaturen blocken.\', \'type\': \'Kreatur — Sceada\', \'flavor\': \'Er ist so leicht und fragil, dass er auch dort gleiten kann, wo die Luft am dünnsten ist.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263699&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f0d25360-cef0-4af9-90ca-cc1a41c3ec8a\', \'multiverseId\': 263699}, \'multiverseid\': 263699}, {\'name\': \'Draco curvicielo\', \'text\': \'Vuela.\\nEl Draco curvicielo puede bloquear sólo criaturas con la habilidad de volar.\', \'type\': \'Criatura — Draco\', \'flavor\': \'Es tan liviano y frágil que puede deslizarse en el aire más fino.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264944&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'eeb9b503-0a03-4cef-ab44-67607755b227\', \'multiverseId\': 264944}, \'multiverseid\': 264944}, {\'name\': \'Drakôn porteciel\', \'text\': \'Vol\\nLe Drakôn porteciel ne peut bloquer que les créatures avec le vol.\', \'type\': \'Créature : drakôn\', \'flavor\': "Il est si léger et si fragile qu\'il peut planer là où l\'air est le plus raréfié.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263450&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0b821cd8-ae6f-4003-a389-c10b232b9c88\', \'multiverseId\': 263450}, \'multiverseid\': 263450}, {\'name\': \'Draghetto Serpeggiante\', \'text\': \'Volare\\nIl Draghetto Serpeggiante può bloccare solo creature con volare.\', \'type\': \'Creatura — Draghetto\', \'flavor\': "È così leggero e delicato che può planare dove l\'aria è più rarefatta.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263948&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'23ad49fd-cd94-4c16-bb03-69576da67ca9\', \'multiverseId\': 263948}, \'multiverseid\': 263948}, {\'name\': \'空回りのドレイク\', \'text\': \'飛行\\n空回りのドレイクは飛行を持つクリーチャーのみをブロックできる。\', \'type\': \'クリーチャー — ドレイク\', \'flavor\': \'それはあまりにも軽くかつ華奢なため、大気の最も薄い場所でしか飛べない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264197&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6be84ba8-fac8-439c-ba99-6fe395d4d0de\', \'multiverseId\': 264197}, \'multiverseid\': 264197}, {\'name\': \'하늘감개 새끼용\', \'text\': \'비행하늘감개 새끼용은 비행 능력을 가진 생물만 방어할 수 있다.\', \'type\': \'생물 — 새끼용\', \'flavor\': \'그것은 공기가 제일 희박한 곳에서도 활공할 수 있을 만큼 가볍고 섬세하다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'15b80c1e-0898-4dbe-a563-a103b69ca850\'}, \'multiverseid\': None}, {\'name\': \'Dragonete das Espirais Celestes\', \'text\': \'Voar\\nDragonete das Espirais Celestes só pode bloquear criaturas com voar.\', \'type\': \'Criatura — Dragonete\', \'flavor\': \'Tão leve e frágil que pode planar até onde o ar é mais rarefeito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264446&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6f5a9c15-8583-4f58-8eb1-8ac2ed78ccba\', \'multiverseId\': 264446}, \'multiverseid\': 264446}, {\'name\': \'Вьющийся в Небе Дрейк\', \'text\': \'Полет\\nВьющийся в Небе Дрейк может блокировать только существа с Полетом.\', \'type\': \'Существо — Дрейк\', \'flavor\': \'Он настолько легкий и хрупкий, что способен планировать даже в самом разреженном воздухе.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264695&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'31625d8d-c549-4258-b0ea-a833615e158f\', \'multiverseId\': 264695}, \'multiverseid\': 264695}, {\'name\': \'掠空龙兽\', \'text\': \'飞行\\n掠空龙兽只能阻挡具飞行异能的生物。\', \'type\': \'生物～龙兽\', \'flavor\': \'他既轻又脆弱，就连在空气最稀薄的地方都能滑翔。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262952&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'305d8c9f-22b7-41d0-abed-70d3467a1f42\', \'multiverseId\': 262952}, \'multiverseid\': 262952}, {\'name\': \'掠空龍獸\', \'text\': \'飛行\\n掠空龍獸只能阻擋具飛行異能的生物。\', \'type\': \'生物～龍獸\', \'flavor\': \'牠既輕又脆弱，就連在空氣最稀薄的地方都能滑翔。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263201&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e644abff-bbdf-4e31-a41c-ffc164fe5652\', \'multiverseId\': 263201}, \'multiverseid\': 263201}]', '[{\'name\': \'Himmlische Säuberung\', \'text\': \'Schicke eine schwarze oder rote bleibende Karte deiner Wahl ins Exil.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Eine Welt ohne das Böse? Langweilig. Ich brauche jeden Tag üble Unholde, die ich zerschmettern und verbannen kann." —Sarlena, Paladin des Nordrands\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263635&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'104beee2-8774-45c5-a732-c460e8ed2bc2\', \'multiverseId\': 263635}, \'multiverseid\': 263635}, {\'name\': \'Purga celestial\', \'text\': \'Exilia el permanente negro o rojo objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"¿Un mundo sin maldad? Aburrido. Yo prefiero tener demonios que abatir y desterrar." —Sarlena, paladín del Límite Norte\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264880&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'880b9589-92a3-4ece-b6c4-3a5151309402\', \'multiverseId\': 264880}, \'multiverseid\': 264880}, {\'name\': \'Épuration céleste\', \'text\': \'Exilez le permanent noir ou rouge ciblé.\', \'type\': \'Éphémère\', \'flavor\': "« Un monde sans le mal ? Quel ennui ! Je préfère encore bannir de viles créatures en les tapant à longueur de journée. » —Sarlena, paladin de l\'Orée Septentrionale", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263386&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'33dad87c-a0f3-43fc-8375-999b447027ca\', \'multiverseId\': 263386}, \'multiverseid\': 263386}, {\'name\': \'Epurazione Celeste\', \'text\': \'Esilia un permanente nero o rosso bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Un mondo senza male? Che noia! Dammi demoni ignobili da castigare e bandire ogni giorno." —Sarlena, paladina del Margine Nord\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263884&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'29960325-8973-4784-8c59-69d9441bcb41\', \'multiverseId\': 263884}, \'multiverseid\': 263884}, {\'name\': \'天界の粛清\', \'text\': \'黒か赤のパーマネント１つを対象とし、それを追放する。\', \'type\': \'インスタント\', \'flavor\': \'「悪の無い世界？ 退屈ね。 退治すべき下劣な悪魔ならいつでも歓迎よ。」 ――北境の聖騎士、サルレナ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264133&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'283cf4b6-dfe9-4fc0-aebb-4256471c3fac\', \'multiverseId\': 264133}, \'multiverseid\': 264133}, {\'name\': \'천상의 숙청\', \'text\': \'흑색이나 적색 지속물 한 개를 목표로 정해서 추방한다.\', \'type\': \'순간마법\', \'flavor\': \'"악이 없는 세상이요? 따분하잖아요. 때려 없앨 악의 무리가 있는 게 훨씬 재밌습니다."—북변기사단의 성기사 사를리나\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'30778a1b-e2a7-4769-8932-9d37494fad58\'}, \'multiverseid\': None}, {\'name\': \'Expurgo Celestial\', \'text\': \'Exile a permanente alvo preta ou vermelha.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Um mundo sem o mal? Que chatice. Prefiro demônios perversos para esmurrar e exterminar." — Sarlena, paladina da Fronteira Norte\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264382&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'44529682-d47f-47d1-897a-d469ce52626b\', \'multiverseId\': 264382}, \'multiverseid\': 264382}, {\'name\': \'Небесное Очищение\', \'text\': \'Изгоните целевой черный или красный перманент.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Мир без зла? Какая скука! Я всегда рада крушить и изгонять злодеев». — Сарлена, паладин ордена Северной Окраины\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264631&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5f653cf1-06fd-4127-add5-5e1e43d26169\', \'multiverseId\': 264631}, \'multiverseid\': 264631}, {\'name\': \'天界涤净\', \'text\': \'放逐目标黑色或红色永久物。\', \'type\': \'瞬间\', \'flavor\': \'「没有邪恶的世界？ 无聊至极。 我每天都要拿恶鬼练剑。」 ～北境神圣武士莎雷娜\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262888&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f09684dd-8653-4725-8ef5-6f7c4a6d45af\', \'multiverseId\': 262888}, \'multiverseid\': 262888}, {\'name\': \'天界滌淨\', \'text\': \'放逐目標黑色或紅色永久物。\', \'type\': \'瞬間\', \'flavor\': \'「沒有邪惡的世界？ 無聊至極。 我每天都要拿惡鬼練劍。」 ～北境神聖武士莎雷娜\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263137&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e77add19-1305-423b-b8a3-518fb01fa9df\', \'multiverseId\': 263137}, \'multiverseid\': 263137}]', '[{\'name\': \'Hypnotisierende Meerfrau\', \'text\': \'{U}, {T}: Ein Spieler deiner Wahl legt die obersten zwei Karten seiner Bibliothek in seinen Friedhof.\', \'type\': \'Kreatur — Meervolk, Zauberer\', \'flavor\': \'„Ich würde mich doch dran erinnern, wenn ich ein Wesen gesehen hätte, das halb Frau und halb Fisch ist und drei glühende Augen hat." —Drugo, Stadtwache\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263690&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'036a2f74-eb20-4d6e-8779-84985bf8a800\', \'multiverseId\': 263690}, \'multiverseid\': 263690}, {\'name\': \'Tritón hipnótico\', \'text\': \'{U}, {T}: El jugador objetivo pone las dos primeras cartas de su biblioteca en su cementerio .\', \'type\': \'Criatura — Hechicero tritón\', \'flavor\': \'"¿No crees que si hubiera visto a una mujer mitad pez con tres ojos brillantes lo recordaría?" —Drugo, guardia de ciudad\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264935&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'678ca2ec-b999-4956-8554-047dce5cff44\', \'multiverseId\': 264935}, \'multiverseid\': 264935}, {\'name\': \'Mesmériste ondine\', \'text\': \'{U}, {T} : Le joueur ciblé met les deux cartes du dessus de sa bibliothèque dans son cimetière.\', \'type\': \'Créature : ondin et sorcier\', \'flavor\': "« Vous ne croyez pas que si j\'avais vu une femme à demi poisson avec trois yeux brillants, je m\'en souviendrais ? » —Drugo, garde de ville", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263441&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7c36eec8-fd6b-40ad-9db3-e172e60ad011\', \'multiverseId\': 263441}, \'multiverseid\': 263441}, {\'name\': \'Tritona Mesmerista\', \'text\': \'{U}, {T}: Un giocatore bersaglio mette nel suo cimitero le prime due carte del suo grimorio.\', \'type\': \'Creatura — Mago Tritone\', \'flavor\': \'"Non pensi che se avessi visto una mezza-donna, mezzo-pesce con tre occhi luccicanti, me ne sarei ricordato?" —Drugo, guardia cittadina\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263939&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4128ea93-7a76-46ef-96c3-0ccb0cdc08c9\', \'multiverseId\': 263939}, \'multiverseid\': 263939}, {\'name\': \'マーフォークの催眠術師\', \'text\': \'{U}, {T}：プレイヤー１人を対象とする。そのプレイヤーは、自分のライブラリーの一番上から２枚のカードを自分の墓地に置く。\', \'type\': \'クリーチャー — マーフォーク・ウィザード\', \'flavor\': \'「半分女で半分魚の光る三つ目のやつを見たら、覚えてない訳がないだろう？」 ――街の衛兵、ドルーゴ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264188&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'453e010c-c7f7-42d9-b899-5df1c1fe3f97\', \'multiverseId\': 264188}, \'multiverseid\': 264188}, {\'name\': \'인어 최면술사\', \'text\': \'{U}, {T}: 플레이어 한 명을 목표로 정한다. 그 플레이어는 자신의 서고 맨 위의 카드 두 장을 자신의 무덤에 넣는다.\', \'type\': \'생물 — 인어 마법사\', \'flavor\': \'"내가 빛나는 눈이 세 개 달린 반인반어의 여자를 봤다면, 기억하고 있어야 정상 아니겠어?"—마을 경비병 드루고\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3d943d3d-6b13-45cc-ae53-7764ea859a45\'}, \'multiverseid\': None}, {\'name\': \'Mesmerista Tritão\', \'text\': \'{U}, {T}: O jogador alvo coloca os dois cards do topo do grimório dele em seu próprio cemitério.\', \'type\': \'Criatura — Tritão Mago\', \'flavor\': \'"Você não acha que se eu tivesse visto um ser metade mulher, metade peixe com três olhos brilhantes eu me lembraria?" — Drugo, vigia da cidade\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264437&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'66091ab4-3077-4f8f-90e5-fa5cdc32cebf\', \'multiverseId\': 264437}, \'multiverseid\': 264437}, {\'name\': \'Мерфолк-Месмерист\', \'text\': \'{U}, {T}: целевой игрок кладет две верхние карты из своей библиотеки на свое кладбище.\', \'type\': \'Существо — Мерфолк Чародей\', \'flavor\': \'«Неужели вы думаете, что если бы я увидел полуженщину-полурыбу с тремя горящими глазами, то я бы не запомнил?» — Друго, городской стражник\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264686&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5b1473ca-8906-411e-b0a0-6284db75157f\', \'multiverseId\': 264686}, \'multiverseid\': 264686}, {\'name\': \'催眠人鱼\', \'text\': \'{U}，{T}：目标牌手将他牌库顶的两张牌置入其坟墓场。\', \'type\': \'生物～人鱼／法术师\', \'flavor\': \'「你以为如果我见到个半是女人半是鱼、还有三只发亮眼睛的人，居然还可能会忘记吗？」 ～镇守卫筑革\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262943&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a9ab6483-f187-49e6-83f3-ad4f00da0083\', \'multiverseId\': 262943}, \'multiverseid\': 262943}, {\'name\': \'催眠人魚\', \'text\': \'{U}，{T}：目標玩家將他牌庫頂的兩張牌置入其墳墓場。\', \'type\': \'生物～人魚／魔法師\', \'flavor\': \'「你以為如果我見到個半是女人半是魚、還有三隻發亮眼睛的人，居然還可能會忘記嗎？」 ～鎮守衛筑革\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263192&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'972bd976-b5ef-41cc-8cf0-c23ad3282a4e\', \'multiverseId\': 263192}, \'multiverseid\': 263192}]', '[{\'name\': \'In Betracht ziehen\', \'text\': \'Schaue dir die obersten drei Karten deiner Bibliothek an und lege sie in beliebiger Reihenfolge zurück. Du kannst danach deine Bibliothek mischen.\\nZiehe eine Karte.\', \'type\': \'Hexerei\', \'flavor\': \'Wer sich heute vorbereitet, gewinnt morgen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263697&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e29f2f38-a779-406d-a949-1e2e04c0534c\', \'multiverseId\': 263697}, \'multiverseid\': 263697}, {\'name\': \'Reflexionar\', \'text\': \'Mira las primeras tres cartas de tu biblioteca, luego regrésalas en cualquier orden. Puedes barajar tu biblioteca.\\nRoba una carta.\', \'type\': \'Conjuro\', \'flavor\': \'El mañana pertenece a aquellos que se preparan para él hoy.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264942&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'45e64ba9-5a74-4368-9b37-554fbcc75bb8\', \'multiverseId\': 264942}, \'multiverseid\': 264942}, {\'name\': \'Contemplation\', \'text\': "Regardez les trois cartes du dessus de votre bibliothèque, puis remettez-les dessus dans l\'ordre de votre choix. Vous pouvez mélanger votre bibliothèque.\\nPiochez une carte.", \'type\': \'Rituel\', \'flavor\': "L\'avenir appartient à ceux qui s\'y préparent la veille.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263448&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d6262b51-862f-454c-94e8-d215e131f532\', \'multiverseId\': 263448}, \'multiverseid\': 263448}, {\'name\': \'Ponderare\', \'text\': \'Guarda le prime tre carte del tuo grimorio, poi rimettile a posto in qualsiasi ordine. Puoi rimescolare il tuo grimorio.\\nPesca una carta.\', \'type\': \'Stregoneria\', \'flavor\': \'Il domani appartiene a quelli che oggi si preparano per esso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263946&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6f0619ab-f8c9-4aa6-a11c-bf6023504dfb\', \'multiverseId\': 263946}, \'multiverseid\': 263946}, {\'name\': \'思案\', \'text\': \'あなたのライブラリーの一番上から３枚のカードを見る。その後、それらを望む順番で戻す。 あなたはあなたのライブラリーを切り直してもよい。\\nカードを１枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'明日という日は、今日それを迎える準備をしている者のためにある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264195&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d1a43cf7-7aa2-41be-8bca-4a54460b2fa9\', \'multiverseId\': 264195}, \'multiverseid\': 264195}, {\'name\': \'숙고\', \'text\': \'당신의 서고 맨 위의 카드 세 장을 보고 나서, 그 카드들을 원하는 순서로 되돌려 놓는다. 당신은 당신의 서고를 섞을 수 있다.카드 한 장을 뽑는다.\', \'type\': \'집중마법\', \'flavor\': \'내일은 오늘 준비하는 자들의 것이다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b95ed4c5-9577-43a9-8b54-7c540656ba4d\'}, \'multiverseid\': None}, {\'name\': \'Ponderar\', \'text\': \'Olhe os três cards do topo do seu grimório e depois coloque-os de volta em qualquer ordem. Você pode embaralhar seu grimório.\\nCompre um card.\', \'type\': \'Feitiço\', \'flavor\': \'O amanhã pertence àqueles que se preparam para ele hoje.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264444&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'90a0e231-ab26-4ba7-b28c-55e066c85e8d\', \'multiverseId\': 264444}, \'multiverseid\': 264444}, {\'name\': \'Размышления\', \'text\': \'Посмотрите три верхние карты вашей библиотеки, затем положите их обратно в любом порядке. Вы можете перетасовать вашу библиотеку.\\nВозьмите карту.\', \'type\': \'Волшебство\', \'flavor\': \'Завтра принадлежит тем, кто готовится к нему сегодня.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264693&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0cca2a31-3dbf-4f27-9aa5-75ddc21d16d1\', \'multiverseId\': 264693}, \'multiverseid\': 264693}, {\'name\': \'沉思\', \'text\': \'检视你牌库顶的三张牌，然后将它们以任意顺序放回。 你可以将你的牌库洗牌。\\n抓一张牌。\', \'type\': \'法术\', \'flavor\': \'明日属于今天就为它作好准备的人。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262950&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'98d9a4ce-0a41-4276-a92e-91314a5146a7\', \'multiverseId\': 262950}, \'multiverseid\': 262950}, {\'name\': \'沉思\', \'text\': \'檢視你牌庫頂的三張牌，然後將它們以任意順序放回。 你可以將你的牌庫洗牌。\\n抽一張牌。\', \'type\': \'巫術\', \'flavor\': \'明日屬於今天就為它作好準備的人。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263199&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e493c9c1-f5ab-4276-a654-7350b5258cc5\', \'multiverseId\': 263199}, \'multiverseid\': 263199}]', '[{\'name\': \'Inferno-Titan\', \'text\': \'{R}: Der Inferno-Titan erhält +1/+0 bis zum Ende des Zuges.\\nImmer wenn der Inferno-Titan ins Spiel kommt oder angreift, fügt er 3 Schadenspunkte zu, deren Aufteilung auf ein, zwei oder drei Ziele deiner Wahl, die Kreaturen und/oder Spieler sein können, du bestimmst.\', \'type\': \'Kreatur — Riese\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263771&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'edf3f5f2-d1df-4f8c-bac4-067e85e3c7c7\', \'multiverseId\': 263771}, \'multiverseid\': 263771}, {\'name\': \'Titán infernal\', \'text\': \'{R}: El Titán infernal obtiene +1/+0 hasta el final del turno.\\nSiempre que el Titán infernal entre al campo de batalla o ataque, hace 3 puntos de daño divididos como elijas entre una, dos o tres criaturas y/o jugadores objetivo.\', \'type\': \'Criatura — Gigante\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265016&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'24e74044-6449-48ce-bb11-241966502990\', \'multiverseId\': 265016}, \'multiverseid\': 265016}, {\'name\': \'Titan de la fournaise\', \'text\': "{R} : Le Titan de la fournaise gagne +1/+0 jusqu\'à la fin du tour.\\nÀ chaque fois que le Titan de la fournaise arrive sur le champ de bataille ou qu\'il attaque, il inflige 3 blessures réparties comme vous le désirez entre une, deux ou trois cibles, créatures et/ou joueurs.", \'type\': \'Créature : géant\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263522&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'83c88e9f-f483-45f7-a9bd-292aea481383\', \'multiverseId\': 263522}, \'multiverseid\': 263522}, {\'name\': "Titano dell\'Inferno", \'text\': "{R}: Il Titano dell\'Inferno prende +1/+0 fino alla fine del turno.\\nOgniqualvolta il Titano dell\'Inferno entra nel campo di battaglia o attacca, infligge 3 danni suddivisi a tua scelta tra una, due o tre creature e/o giocatori bersaglio.", \'type\': \'Creatura — Gigante\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264020&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3cf7c89d-ccb4-4f5c-a62e-af4e68145f73\', \'multiverseId\': 264020}, \'multiverseid\': 264020}, {\'name\': \'業火のタイタン\', \'text\': \'{R}：業火のタイタンはターン終了時まで＋１/＋０の修整を受ける。\\n業火のタイタンが戦場に出るか攻撃するたび、クリーチャーやプレイヤーを、１つまたは望む組み合わせで２つか３つ対象とする。業火のタイタンはそれらに、３点のダメージをあなたの好きなように分割して与える。\', \'type\': \'クリーチャー — 巨人\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264269&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6855a3ed-10fd-4c39-9d05-08f04231d83d\', \'multiverseId\': 264269}, \'multiverseid\': 264269}, {\'name\': \'불바다 거신\', \'text\': \'{R}: 불바다 거신은 턴종료까지 +1/+0을 받는다.\\n불바다 거신이 전장에 들어올 때나 공격할 때마다, 생물 및 또는 플레이어를 대상으로 목표를 최고 세 개까지 정하고 나서, 목표들 사이에 3점의 피해를 어떻게 배분할지 정한다. 불바다 거신은 각 목표에게 정해진 대로 피해를 입힌다.\', \'type\': \'생물 — 거인\', \'flavor\': None, \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4177524b-b905-4821-b41c-6935154ef64f\'}, \'multiverseid\': None}, {\'name\': \'Titã do Inferno\', \'text\': \'{R}: Titã do Inferno recebe +1/+0 até o final do turno.\\nToda vez que Titã do Inferno entra no campo de batalha ou ataca, ele causa 3 pontos de dano divididos como você escolher entre uma, duas ou três criaturas e/ou jogadores alvo.\', \'type\': \'Criatura — Gigante\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264518&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'63482eb0-a786-41ec-8741-d34ed0103ea2\', \'multiverseId\': 264518}, \'multiverseid\': 264518}, {\'name\': \'Титан Преисподней\', \'text\': \'{R}: Титан Преисподней получает +1/+0 до конца хода.\\nКаждый раз когда Титан Преисподней выходит на поле битвы или атакует, он наносит 3 повреждения, разделенные по вашему выбору между одним, двумя или тремя целевыми существами и (или) игроками.\', \'type\': \'Существо — Гигант\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264767&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'78680208-0852-405b-a722-47cf9345019e\', \'multiverseId\': 264767}, \'multiverseid\': 264767}, {\'name\': \'炼狱泰坦\', \'text\': \'{R}：炼狱泰坦得+1/+0直到回合结束。\\n每当炼狱泰坦进战场或攻击时，它对一个，两个，或三个目标生物和／或牌手造成共3点伤害，你可以任意分配。\', \'type\': \'生物～巨人\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263024&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c394201e-f639-4b8f-8481-1d76dbd74902\', \'multiverseId\': 263024}, \'multiverseid\': 263024}, {\'name\': \'煉獄泰坦\', \'text\': \'{R}：煉獄泰坦得+1/+0直到回合結束。\\n每當煉獄泰坦進戰場或攻擊時，它對一個，兩個，或三個目標生物和／或玩家造成共3點傷害，你可以任意分配。\', \'type\': \'生物～巨人\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263273&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bc20b036-f686-403a-9294-ac43958ebad0\', \'multiverseId\': 263273}, \'multiverseid\': 263273}]', "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263858&type=card', 'language': 'German', 'identifiers': {'scryfallId': '38c84e74-0371-45d0-916c-79edcf47aa7b', 'multiverseId': 263858}, 'multiverseid': 263858}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265103&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'f66d9354-fbd0-4c6c-8eaa-410e7c5b6743', 'multiverseId': 265103}, 'multiverseid': 265103}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263609&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'eb5e85f9-1844-490e-9f1f-bd5a54fab42b', 'multiverseId': 263609}, 'multiverseid': 263609}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264107&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '4ed3060a-9798-4b30-9310-e56bba1ab529', 'multiverseId': 264107}, 'multiverseid': 264107}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264356&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ddf3331d-1664-4035-9662-777ea2130b92', 'multiverseId': 264356}, 'multiverseid': 264356}, {'name': '섬', 'type': '기본 대지 — 섬', 'flavor': None, 'language': 'Korean', 'identifiers': {'scryfallId': 'd45d13b9-6013-4161-841a-e939d653b2c1'}, 'multiverseid': None}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264605&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '13ed1220-ec4e-4ffd-bc3f-632406280f51', 'multiverseId': 264605}, 'multiverseid': 264605}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264854&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'c7e3c4a2-9fbb-4d18-b82c-886b45e8025a', 'multiverseId': 264854}, 'multiverseid': 264854}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263111&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '2ebeb810-f711-49f7-b0a6-f9d27513a492', 'multiverseId': 263111}, 'multiverseid': 263111}, {'name': '海島', 'type': '基本地～海島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263360&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '06f23f8b-7dd6-459a-912f-3bb8947c6d0c', 'multiverseId': 263360}, 'multiverseid': 263360}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263859&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a62a982d-2a37-4c13-9c96-6d63e7ef7602', 'multiverseId': 263859}, 'multiverseid': 263859}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265104&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '23090e50-f5cb-4182-9264-03f8098f1de9', 'multiverseId': 265104}, 'multiverseid': 265104}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263610&type=card', 'language': 'French', 'identifiers': {'scryfallId': '00c2a8fc-c1f9-4e1c-92f8-a83aa920ed25', 'multiverseId': 263610}, 'multiverseid': 263610}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264108&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '0abdac7f-41cc-406a-9129-5956e396f271', 'multiverseId': 264108}, 'multiverseid': 264108}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264357&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '84adf980-8eb9-4ab0-ae49-eaffc6b4e6cd', 'multiverseId': 264357}, 'multiverseid': 264357}, {'name': '섬', 'type': '기본 대지 — 섬', 'flavor': None, 'language': 'Korean', 'identifiers': {'scryfallId': 'bbb741e9-654d-4882-8d83-5fcf318d36df'}, 'multiverseid': None}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264606&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ca67e274-3ece-4cdc-bbd2-bcd9bf920102', 'multiverseId': 264