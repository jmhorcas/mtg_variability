language': 'Spanish', 'identifiers': {'scryfallId': 'd5831ed0-7a85-45dc-b829-19ef8db86baf', 'multiverseId': 265118}, 'multiverseid': 265118}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263624&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'edfa3f8d-0075-4432-b0c3-1f0e8b18e0c5', 'multiverseId': 263624}, 'multiverseid': 263624}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264122&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3d071ff1-f969-454f-b4f8-b6d4c7c5c58f', 'multiverseId': 264122}, 'multiverseid': 264122}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264371&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '7fbde072-3a3b-4992-ad36-2a2338333cf8', 'multiverseId': 264371}, 'multiverseid': 264371}, {'name': '숲', 'type': '기본 대지 — 숲', 'flavor': None, 'language': 'Korean', 'identifiers': {'scryfallId': '5303ce23-2a91-4c7a-b45b-cac0fcda85dc'}, 'multiverseid': None}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264620&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'aa790196-0ade-43c0-ab15-76d46f244e4e', 'multiverseId': 264620}, 'multiverseid': 264620}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264869&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '0f360dec-b7f4-467c-b6f4-cd16f2a9cacb', 'multiverseId': 264869}, 'multiverseid': 264869}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263126&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '951fcd0a-5f7c-4d91-9ad9-49f06af682f5', 'multiverseId': 263126}, 'multiverseid': 263126}, {'name': '樹林', 'type': '基本地～樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263375&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'cda7e747-e69d-49ea-b893-523a5e32b14a', 'multiverseId': 263375}, 'multiverseid': 263375}]", '[{\'name\': \'Wandergreif\', \'text\': \'Fliegend\\nErstschlag (Diese Kreatur fügt Kampfschaden vor Kreaturen ohne Erstschlag zu.)\', \'type\': \'Kreatur — Greif\', \'flavor\': \'Ein Greif hat nicht nur Adlerschwingen und Löwenklauen. Er hat auch das tapferste Herz.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263653&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7b4541eb-7785-4bb5-b8b4-9d81b9b226c6\', \'multiverseId\': 263653}, \'multiverseid\': 263653}, {\'name\': \'Grifo peregrino\', \'text\': \'Vuela.\\nDaña primero. (Esta criatura hace daño de combate antes que las criaturas sin la habilidad de dañar primero.)\', \'type\': \'Criatura — Grifo\', \'flavor\': \'Un grifo no es sólo las alas de un águila y las garras de un león. Es también el corazón más fiero.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264898&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b4d7ce0f-6147-4119-84da-d1f2a127b4ba\', \'multiverseId\': 264898}, \'multiverseid\': 264898}, {\'name\': \'Griffon pèlerin\', \'text\': "Vol\\nInitiative (Cette créature inflige des blessures de combat avant les créatures sans l\'initiative.)", \'type\': \'Créature : griffon\', \'flavor\': "Un griffon, ce n\'est pas uniquement des ailes d\'aigle et des griffes de lion. C\'est aussi un cœur des plus redoutables.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263404&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'76872069-a79e-4a71-887c-bfc3b4e20940\', \'multiverseId\': 263404}, \'multiverseid\': 263404}, {\'name\': \'Grifone Pellegrino\', \'text\': \'Volare\\nAttacco improvviso (Questa creatura infligge danno da combattimento prima delle creature senza attacco improvviso.)\', \'type\': \'Creatura — Grifone\', \'flavor\': "Un grifone non è solo ali di un\'aquila e artigli di un leone. È anche il più fiero dei cuori.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263902&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fdeaa13a-0646-441b-90ae-61d44a811c80\', \'multiverseId\': 263902}, \'multiverseid\': 263902}, {\'name\': \'流浪のグリフィン\', \'text\': \'飛行\\n先制攻撃 （このクリーチャーは先制攻撃を持たないクリーチャーよりも先に戦闘ダメージを与える。）\', \'type\': \'クリーチャー — グリフィン\', \'flavor\': \'グリフィンには、単に鷲の翼と獅子の爪があるだけではない。 最も獰猛な心があるのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264151&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0ee1f7ed-2598-4e6c-b4ee-fbdc5b13145f\', \'multiverseId\': 264151}, \'multiverseid\': 264151}, {\'name\': \'송골매 그리핀\', \'text\': \'비행선제공격 (이 생물은 선제공격이 없는 생물보다 먼저 전투피해를 입힌다.)\', \'type\': \'생물 — 그리핀\', \'flavor\': \'그리핀은 단순히 독수리의 날개와 사자의 발톱을 모아놓은 게 아니다. 용맹한 기상 역시 갖추고 있다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'cd38be17-cbe6-45a7-bb2a-2cd6ef0c3e4b\'}, \'multiverseid\': None}, {\'name\': \'Grifo Peregrino\', \'text\': \'Voar\\nIniciativa (Esta criatura causa dano de combate antes das criaturas sem iniciativa.)\', \'type\': \'Criatura — Grifo\', \'flavor\': \'Um grifo não tem apenas asas de águia e patas de leão. Ele também tem o mais tenaz dos corações.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264400&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'90473c4d-34a8-4bf7-900c-08aacd0966bd\', \'multiverseId\': 264400}, \'multiverseid\': 264400}, {\'name\': \'Грифон-Сапсан\', \'text\': \'Полет\\nПервый удар (Это существо наносит боевые повреждения раньше существ без Первого удара.)\', \'type\': \'Существо — Грифон\', \'flavor\': \'Грифон — это не только крылья орла и когти льва. Это еще и свирепейшее из сердец.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264649&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'48c92275-121c-4a02-b684-f0a424bca0b2\', \'multiverseId\': 264649}, \'multiverseid\': 264649}, {\'name\': \'游隼狮鹫\', \'text\': \'飞行\\n先攻 （此生物会比不具先攻异能的生物提前造成战斗伤害。）\', \'type\': \'生物～狮鹫\', \'flavor\': \'狮鹫不只拥有老鹰翅翼与狮子利爪。 他还拥有最强悍的胆识。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262906&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d356c37f-bc14-40e7-ad2b-3dbdf5d5a3c9\', \'multiverseId\': 262906}, \'multiverseid\': 262906}, {\'name\': \'遊隼獅鷲\', \'text\': \'飛行\\n先攻 （此生物會比不具先攻異能的生物提前造成戰鬥傷害。）\', \'type\': \'生物～獅鷲\', \'flavor\': \'獅鷲不只擁有老鷹翅翼與獅子利爪。 牠還擁有最強悍的膽識。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263155&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'236d90a5-9510-46c5-ad6a-8f089ce7c980\', \'multiverseId\': 263155}, \'multiverseid\': 263155}]', '[{\'name\': \'Weissagung\', \'text\': \'Ziehe zwei Karten.\', \'type\': \'Hexerei\', \'flavor\': \'„Der Schlüssel zu diesem Rätsel steckt in dir." —Doriel, Mentor der Mistralinsel\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263674&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'93668f2e-0967-46d3-9641-c714e491a163\', \'multiverseId\': 263674}, \'multiverseid\': 263674}, {\'name\': \'Adivinación\', \'text\': \'Roba dos cartas.\', \'type\': \'Conjuro\', \'flavor\': \'"La llave para desentrañar este misterio está dentro tuyo." —Doriel, mentor de la Isla Mistral\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264919&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1a03ed95-8dd3-40e7-87cd-734b2a9d2d35\', \'multiverseId\': 264919}, \'multiverseid\': 264919}, {\'name\': \'Divination\', \'text\': \'Piochez deux cartes.\', \'type\': \'Rituel\', \'flavor\': "« La clé qui te permettra de résoudre ce mystère est en toi. » —Doriel, mentor de l\'Île de Mistral", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263425&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5af48356-9c9a-4d24-8a54-bbc5ec47e91e\', \'multiverseId\': 263425}, \'multiverseid\': 263425}, {\'name\': \'Divinazione\', \'text\': \'Pesca due carte.\', \'type\': \'Stregoneria\', \'flavor\': \'"La chiave per risolvere questo enigma è dentro di te." —Doriel, mentore di Isola del Mistral\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263923&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4407d76a-59ce-4cf3-8993-33466d4da032\', \'multiverseId\': 263923}, \'multiverseid\': 263923}, {\'name\': \'予言\', \'text\': \'カードを２枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'「この謎を解く鍵はお前の中にある。」 ――北風島の導師、ドリエル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264172&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4a7408db-70d2-4d11-8159-ecbd1daf28c2\', \'multiverseId\': 264172}, \'multiverseid\': 264172}, {\'name\': \'점\', \'text\': \'카드 두 장을 뽑는다.\', \'type\': \'집중마법\', \'flavor\': \'"이 수수께끼를 풀 열쇠는 자네 안에 있다네."—미스트랄 섬의 멘토 도리엘\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'52d11755-b0f7-4d9b-a7a0-418ff2b1732b\'}, \'multiverseid\': None}, {\'name\': \'Divinação\', \'text\': \'Compre dois cards.\', \'type\': \'Feitiço\', \'flavor\': \'"A chave para desvendar esse mistério está dentro de você." —Doriel, mentor da Ilha Mistral\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264421&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2fc1c689-728d-4fa8-bd2a-e2125a7e3e86\', \'multiverseId\': 264421}, \'multiverseid\': 264421}, {\'name\': \'Прорицание\', \'text\': \'Возьмите две карты.\', \'type\': \'Волшебство\', \'flavor\': \'«Ключ к этой загадке — в тебе». — Дориел, наставник с Острова Мистраль\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264670&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c0cc1310-bdb7-4ba2-82b8-c7392541b88e\', \'multiverseId\': 264670}, \'multiverseid\': 264670}, {\'name\': \'卜卦\', \'text\': \'抓两张牌。\', \'type\': \'法术\', \'flavor\': \'「解开谜题的关键就在你心中。」 ～西北风屿导师多瑞尔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262927&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'28a39cb3-7380-4e0a-b9c7-d35bbc3b8823\', \'multiverseId\': 262927}, \'multiverseid\': 262927}, {\'name\': \'卜卦\', \'text\': \'抽兩張牌。\', \'type\': \'巫術\', \'flavor\': \'「解開謎題的關鍵就在你心中。」 ～西北風嶼導師多瑞爾\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263176&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'feddf5d7-ebbe-4525-b8aa-9d6a990d986b\', \'multiverseId\': 263176}, \'multiverseid\': 263176}]', '[{\'name\': \'Weltenerschlager\', \'text\': \'Immer wenn die ausgerüstete Kreatur einem Spieler Kampfschaden zufügt, zerstöre alle bleibenden Karten außer dem Weltenerschlager.\\nAusrüsten {5} ({5}: Lege diese Karte an eine Kreatur deiner Wahl an, die du kontrollierst. Spiele Ausrüsten wie eine Hexerei.)\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': \'„Falls du danach suchst, musst du die Krater durchsuchen." —Fodrus, Meisterschmied\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263846&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'53801e9f-6855-44da-a780-f4ac5686fbcd\', \'multiverseId\': 263846}, \'multiverseid\': 263846}, {\'name\': \'Destruyemundos\', \'text\': \'Siempre que la criatura equipada haga daño de combate a un jugador, destruye todos los permanentes que no sean el Destruyemundos.\\nEquipar {5}. ({5}: Anexa este equipo a la criatura objetivo que controles. Juega la habilidad de equipar como un conjuro.)\', \'type\': \'Artefacto — Equipo\', \'flavor\': \'"Si eso es lo que buscas, intenta en los cráteres." —Fodrus, maestro herrero\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265091&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'895c3c28-6f2e-49a6-a7b0-915b1450c8ce\', \'multiverseId\': 265091}, \'multiverseid\': 265091}, {\'name\': \'Pourfendeur de monde\', \'text\': "À chaque fois que la créature équipée inflige des blessures de combat à un joueur, détruisez tous les permanents autres que le Pourfendeur de monde.\\nÉquipement {5} ({5} : Attachez à la créature ciblée que vous contrôlez. N\'attachez l\'équipement que lorsque vous pourriez jouer un rituel.)", \'type\': \'Artefact : équipement\', \'flavor\': "« Si c\'est ce que tu cherches, essaie les cratères. » —Fodrus, maître-forgeron", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263597&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'499565fc-55ed-493c-a9c2-4bd91cd42bb7\', \'multiverseId\': 263597}, \'multiverseid\': 263597}, {\'name\': \'Spaccamondo\', \'text\': \'Ogniqualvolta la creatura equipaggiata infligge danno da combattimento a un giocatore, distruggi tutti i permanenti diversi dallo Spaccamondo.\\nEquipaggiare {5} ({5}: Assegna a una creatura bersaglio che controlli. Equipaggia solo quando potresti lanciare una stregoneria.)\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': \'"Se è questo che cerchi, prova a guardare nei crateri." —Fodrus, mastro fabbro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264095&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fe96a6ca-eb25-44e5-8717-b015d4cdb385\', \'multiverseId\': 264095}, \'multiverseid\': 264095}, {\'name\': \'世界薙ぎの剣\', \'text\': \'装備しているクリーチャーがいずれかのプレイヤーに戦闘ダメージを与えるたび、世界薙ぎの剣以外のすべてのパーマネントを破壊する。\\n装備 {5} ({5}：あなたがコントロールするクリーチャー１体を対象とし、これをつける。 装備はソーサリーとしてのみ行う。）\', \'type\': \'アーティファクト — 装備品\', \'flavor\': \'「お前の探してるのがこれだって言うなら、噴火口でも覗くんだな。」 ――熟達の鍛冶屋、フォドラス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264344&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'974b20b4-e163-4265-999c-2e4dcd2549ad\', \'multiverseId\': 264344}, \'multiverseid\': 264344}, {\'name\': \'천하멸절검\', \'text\': \'장착된 생물이 플레이어에게 전투피해를 입힐 때마다, 천하멸절검 이외의 모든 지속물을 파괴한다.장착 (: 당신이 조종하는 생물 한 개를 목표로 정해서 부착한다. 당신이 집중마법을 발동할 수 있는 시기에만 이 능력을 활성화한다.)\', \'type\': \'마법물체 — 장비\', \'flavor\': \'"자네가 찾는 게 저거라면, 크레이터를 뒤져 보게나."—숙련 대장장이 포드러스\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9b0cdf73-3884-4934-979c-a8b25fed1de5\'}, \'multiverseid\': None}, {\'name\': \'Finda-Mundo\', \'text\': \'Toda vez que a criatura equipada causar dano de combate a um jogador, destrua todas as permanentes que não forem Finda-Mundo.\\nEquipar {5} ({5}: Anexe à criatura alvo que você controla. Equipe somente quando puder jogar um feitiço.)\', \'type\': \'Artefato — Equipamento\', \'flavor\': \'"Se é isso que você busca, experimente procurar nas crateras." — Fodrus, ferreiro mestre\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264593&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5a501921-d464-460c-9849-b5cb47707c2c\', \'multiverseId\': 264593}, \'multiverseid\': 264593}, {\'name\': \'Мироубийца\', \'text\': \'Каждый раз когда снаряженное существо наносит боевые повреждения игроку, уничтожьте все перманенты, кроме Мироубийцы.\\nСнарядить {5} ({5}: прикрепите к целевому существу под вашим контролем. Снаряжайте только как волшебство.)\', \'type\': \'Артефакт — Снаряжение\', \'flavor\': \'«Если это то, что вы ищете, попробуйте заглянуть в жерла». — Фодрус, искусный кузнец\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264842&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d125f6f7-9287-4907-9f46-de410861291e\', \'multiverseId\': 264842}, \'multiverseid\': 264842}, {\'name\': \'灭世剑\', \'text\': \'每当佩带此武具的生物对任一牌手造成战斗伤害时，将灭世剑之外的所有永久物消灭。\\n佩带{5} （{5}：装备在目标由你操控的生物上； 佩带的时机视同法术。）\', \'type\': \'神器～武具\', \'flavor\': \'「如果那就是你想要的，去火山找找看。」 ～金工大师福卓斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263099&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f45b6ad0-8a87-4bdb-a593-63892f934771\', \'multiverseId\': 263099}, \'multiverseid\': 263099}, {\'name\': \'滅世劍\', \'text\': \'每當佩帶此武具的生物對任一玩家造成戰鬥傷害時，將滅世劍之外的所有永久物消滅。\\n佩帶{5} （{5}：裝備在目標由你操控的生物上； 佩帶的時機視同巫術。）\', \'type\': \'神器～武具\', \'flavor\': \'「如果那就是你想要的，去火山找找看。」 ～金工大師福卓斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263348&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'62d0d29c-cdbc-4df2-a809-6a3f97608174\', \'multiverseId\': 263348}, \'multiverseid\': 263348}]', '[{\'name\': \'Wieder aufstehendes Skelett\', \'text\': \'{1}{B}: Bringe das Wieder aufstehende Skelett aus deinem Friedhof getappt ins Spiel zurück.\', \'type\': \'Kreatur — Skelett, Krieger\', \'flavor\': \'„Manchmal kommen sie mit einem falschen Schenkelknochen oder einem schiefen Kiefer wieder, aber sie tauchen immer wieder auf." —Zul Ashur, Lichfürst\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263728&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0f1841d3-9bb9-41c9-8071-768872ea3019\', \'multiverseId\': 263728}, \'multiverseid\': 263728}, {\'name\': \'Esqueleto reconstruyéndose\', \'text\': \'{1}{B}: Regresa el Esqueleto reconstruyéndose de tu cementerio al campo de batalla girado.\', \'type\': \'Criatura — Guerrero esqueleto\', \'flavor\': \'"Puede que aparezcan con un hueso mal puesto o sin la mandíbula, pero siempre aparecen." —Zul Ashur, señor liche\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264973&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4db36942-9bf3-408e-a2b8-b7b9faf6922c\', \'multiverseId\': 264973}, \'multiverseid\': 264973}, {\'name\': \'Squelette réassemblable\', \'text\': \'{1}{B} : Renvoyez sur le champ de bataille, engagé, le Squelette réassemblable depuis votre cimetière.\', \'type\': \'Créature : squelette et guerrier\', \'flavor\': \'« Ils ne viennent pas toujours avec le bon tibia ou la bonne mâchoire, mais ils viennent toujours. » —Zul Ashur, seigneur liche\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263479&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1fe47a2f-0f42-4886-88e9-1f90ed554222\', \'multiverseId\': 263479}, \'multiverseid\': 263479}, {\'name\': \'Scheletro Riassemblato\', \'text\': \'{1}{B}: Rimetti sul campo di battaglia lo Scheletro Riassemblato TAPpato dal tuo cimitero.\', \'type\': \'Creatura — Guerriero Scheletro\', \'flavor\': \'"Possono farsi vivi con il femore o la mandibola sbagliati, ma si fanno sempre vivi." —Zul Ashur, signore dei lich\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263977&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a75819ec-bc4e-4183-80e2-421828cf193d\', \'multiverseId\': 263977}, \'multiverseid\': 263977}, {\'name\': \'組み直しの骸骨\', \'text\': \'{1}{B}：あなたの墓地にある組み直しの骸骨をタップ状態で戦場に戻す。\', \'type\': \'クリーチャー — スケルトン・戦士\', \'flavor\': \'「脚や顎の骨が違っていることもあるが、必ずこの場に現れる。」 ――死者の王、ザル・アシュール\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264226&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'aa536ac3-33cc-4b73-b2ca-fc097949273a\', \'multiverseId\': 264226}, \'multiverseid\': 264226}, {\'name\': \'재조립 해골\', \'text\': \'{1}{B}: 당신의 무덤에서 재조립 해골을 탭된 채로 전장으로 되돌린다.\', \'type\': \'생물 — 해골 전사\', \'flavor\': \'"가끔 남의 대퇴골이나 턱뼈를 달고 나타나서 그렇지, 언제나 나타나기는 나타나더군."—리치 군주 줄 아슈르\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8bee3228-9ae0-4311-9f3f-a5ff8c842c0b\'}, \'multiverseid\': None}, {\'name\': \'Esqueleto Remontado\', \'text\': \'{1}{B}: Devolva Esqueleto Remontado de seu cemitério ao campo de batalha virado.\', \'type\': \'Criatura — Esqueleto Guerreiro\', \'flavor\': \'"Eles podem aparecer com o fêmur ou a mandíbula errados, mas eles sempre aparecem." — Zul Ashur, senhor lich\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264475&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'91def2ce-a66e-460e-8ee0-f0c5adcd6a97\', \'multiverseId\': 264475}, \'multiverseid\': 264475}, {\'name\': \'Пересобирающийся Скелет\', \'text\': \'{1}{B}: верните Пересобирающийся Скелет из вашего кладбища на поле битвы повернутым.\', \'type\': \'Существо — Скелет Воин\', \'flavor\': \'«Они могут прийти с неправильной берцовой костью или челюстью, но они всегда приходят». — Зул Ашур, лорд-лич\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264724&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6d73a152-487e-4798-bd3d-fa72ca3a162e\', \'multiverseId\': 264724}, \'multiverseid\': 264724}, {\'name\': \'重组骷髅妖\', \'text\': \'{1}{B}：将重组骷髅妖从你的坟墓场横置进战场。\', \'type\': \'生物～骷髅妖／战士\', \'flavor\': \'「他们现身时可能装错了大腿骨或颔骨，但他们总是会现身。」 ～巫妖领主祝亚许\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262981&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b79364a5-8e50-462d-829d-c6c6d48b5d17\', \'multiverseId\': 262981}, \'multiverseid\': 262981}, {\'name\': \'重組骷髏妖\', \'text\': \'{1}{B}：將重組骷髏妖從你的墳墓場橫置進戰場。\', \'type\': \'生物～骷髏妖／戰士\', \'flavor\': \'「他們現身時可能裝錯了大腿骨或頷骨，但他們總是會現身。」 ～巫妖領主祝亞許\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263230&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a70e8474-4a20-4ecf-b2b0-98bdf6073f80\', \'multiverseId\': 263230}, \'multiverseid\': 263230}]', "[{'name': 'Wucherndes Wachstum', 'text': 'Durchsuche deine Bibliothek nach einer Standardland-Karte und bringe diese Karte getappt ins Spiel. Mische danach deine Bibliothek.', 'type': 'Hexerei', 'flavor': 'Die Natur lässt die Lösungen für ihre Probleme einfach sprießen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263814&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f916199a-7a52-4bbb-9f17-3cbfe8e45825', 'multiverseId': 263814}, 'multiverseid': 263814}, {'name': 'Crecimiento exuberante', 'text': 'Busca en tu biblioteca una carta de tierra básica y pon en el campo de batalla esa carta girada. Luego baraja tu biblioteca.', 'type': 'Conjuro', 'flavor': 'La naturaleza cultiva soluciones para sus problemas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265059&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ee1e5794-b139-4c32-8507-c9d2be1b01c3', 'multiverseId': 265059}, 'multiverseid': 265059}, {'name': 'Croissance luxuriante', 'text': 'Cherchez dans votre bibliothèque une carte de terrain de base et mettez cette carte sur le champ de bataille engagée. Mélangez ensuite votre bibliothèque.', 'type': 'Rituel', 'flavor': 'La nature fait pousser les solutions de ses problèmes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263565&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'bacc3964-72eb-4312-af16-789bcbb70039', 'multiverseId': 263565}, 'multiverseid': 263565}, {'name': 'Crescita Inarrestabile', 'text': 'Passa in rassegna il tuo grimorio per una carta terra base e mettila sul campo di battaglia TAPpata. Poi rimescola il tuo grimorio.', 'type': 'Stregoneria', 'flavor': 'La natura genera soluzioni ai propri problemi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264063&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '084edbec-5fae-4b2e-8c08-fbfe08122899', 'multiverseId': 264063}, 'multiverseid': 264063}, {'name': '不屈の自然', 'text': 'あなたのライブラリーから基本土地カードを１枚探し、そのカードをタップ状態で戦場に出す。 その後あなたのライブラリーを切り直す。', 'type': 'ソーサリー', 'flavor': '自然は問題の解決法を自ら育て上げる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264312&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '471a0b07-ed7c-4592-bfc9-581eb3ba7675', 'multiverseId': 264312}, 'multiverseid': 264312}, {'name': '무성한 덤불', 'text': '당신의 서고에서 기본 대지 카드 한 장을 찾아 탭된 채로 전장에 놓는다. 그리고 나서 당신의 서고를 섞는다.', 'type': '집중마법', 'flavor': '자연은 모든 문제를 성장으로 해결한다.', 'language': 'Korean', 'identifiers': {'scryfallId': '208068e1-1c31-4839-8ebe-5899bec20af9'}, 'multiverseid': None}, {'name': 'Crescimento Exuberante', 'text': 'Procure em seu grimório por um card de terreno básico e coloque-o virado no campo de batalha. Depois, embaralhe seu grimório.', 'type': 'Feitiço', 'flavor': 'A natureza cultiva as soluções aos seus próprios problemas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264561&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'aaeac342-f465-45a4-b988-928dcb9eea87', 'multiverseId': 264561}, 'multiverseid': 264561}, {'name': 'Буйный Рост', 'text': 'Найдите в вашей библиотеке карту базовой земли и положите ту карту на поле битвы повернутой. Затем перетасуйте вашу библиотеку.', 'type': 'Волшебство', 'flavor': 'Решения проблем природы вырастают сами.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264810&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '594ee4a4-c047-4550-ad9a-fbe17ab8d1ce', 'multiverseId': 264810}, 'multiverseid': 264810}, {'name': '徒长', 'text': '从你的牌库中搜寻一张基本地牌，并将之横置进战场。 然后将你的牌库洗牌。', 'type': '法术', 'flavor': '大自然为其问题栽培答案。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263067&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '1a558c99-2c11-45fc-a804-333fb32b953c', 'multiverseId': 263067}, 'multiverseid': 263067}, {'name': '徒長', 'text': '從你的牌庫中搜尋一張基本地牌，並將之橫置進戰場。 然後將你的牌庫洗牌。', 'type': '巫術', 'flavor': '大自然為其問題栽培答案。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263316&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '74f91e65-1035-4ba4-b44f-5f1fe164bb7f', 'multiverseId': 263316}, 'multiverseid': 263316}]", '[{\'name\': \'Wurmzahn\', \'text\': \'Immer wenn ein Spieler einen grünen Zauberspruch wirkt, kannst du 1 Lebenspunkt dazuerhalten.\', \'type\': \'Artefakt\', \'flavor\': \'Jevna Nor hatte den Zahn angeschleppt, um mit seinem Sieg über den Wurm zu prahlen. Zum Glück merkten die Kneipengäste nicht, dass es nur einer der Milchzähne war.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263847&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'da5d5dff-d6b6-4fbe-b976-816fc871c470\', \'multiverseId\': 263847}, \'multiverseid\': 263847}, {\'name\': \'Diente de sierpe\', \'text\': \'Siempre que un jugador lance un hechizo verde, puedes ganar 1 vida.\', \'type\': \'Artefacto\', \'flavor\': \'Jevna Nor lo mostraba siempre, pavoneándose de su triunfo sobre la sierpe. Por suerte, los asiduos de la taberna no sabían que era un diente de leche.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265092&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'85c4662b-6d4f-4009-811d-887f7950ad5f\', \'multiverseId\': 265092}, \'multiverseid\': 265092}, {\'name\': \'Dent de la guivre\', \'text\': "À chaque fois qu\'un joueur lance un sort vert, vous pouvez gagner 1 point de vie.", \'type\': \'Artefact\', \'flavor\': "Jevna Nor la montra à tous, se vantant de son triomphe sur la guivre. Heureusement, les clients réguliers de la taverne ne remarquèrent pas que ce n\'était qu\'une dent de lait.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263598&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'efd757ff-7894-4981-8331-11388485fb98\', \'multiverseId\': 263598}, \'multiverseid\': 263598}, {\'name\': \'Dente del Wurm\', \'text\': \'Ogniqualvolta un giocatore lancia una magia verde, puoi guadagnare 1 punto vita.\', \'type\': \'Artefatto\', \'flavor\': \'Jevna Nor lo mostrava in giro, vantandosi della sua vittoria sul wurm. Per fortuna, gli avventori della taverna non notarono che era solo un dente da latte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264096&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'213a3fdb-3f18-42ed-94f0-c99d9dc6a769\', \'multiverseId\': 264096}, \'multiverseid\': 264096}, {\'name\': \'ワームの歯\', \'text\': \'いずれかのプレイヤーが緑の呪文を１つ唱えるたび、あなたは１点のライフを得てもよい。\', \'type\': \'アーティファクト\', \'flavor\': \'ジェブナ・ノールは、ワームとの死闘の自慢話のために、苦労してそれを持ち運んでいる。 幸いなことに、酒場の常連はそれが乳歯だとは知らなかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264345&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'74f5914a-8a07-46d5-b518-674f26a7324d\', \'multiverseId\': 264345}, \'multiverseid\': 264345}, {\'name\': \'웜의 이빨\', \'text\': \'어느 플레이어가 녹색 주문을 발동할 때마다, 당신은 생명 1점을 얻을 수 있다.\', \'type\': \'마법물체\', \'flavor\': \'제브나 노르는 그것을 끌고 다니며 웜을 제압한 것에 대해 자랑스럽게 떠벌렸다. 다행히도 술집 단골들은 그것이 고작 아기 웜의 이빨이라는 걸 눈치채지 못했다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'15b109a5-fd9e-4aae-8639-5728b115b5a6\'}, \'multiverseid\': None}, {\'name\': \'Dente de Vorme\', \'text\': \'Toda vez que um jogador conjura uma mágica verde, você pode ganhar 1 ponto de vida.\', \'type\': \'Artefato\', \'flavor\': \'Jevna Nor carregava-o por todos os lugares, gabando-se de seu triunfo contra o vorme. Por sorte, os frequentadores da taverna não notaram que se tratava apenas de um dente de leite.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264594&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a13f16e4-ec6c-4df5-8376-d8ff4e878098\', \'multiverseId\': 264594}, \'multiverseid\': 264594}, {\'name\': \'Клык Вурма\', \'text\': \'Каждый раз когда игрок разыгрывает зеленое заклинание, вы можете получить 1 жизнь.\', \'type\': \'Артефакт\', \'flavor\': \'Джевна Нор повсюду таскал его, похваляясь своей победой над вурмом. К счастью, завсегдатаи таверны не замечали, что это был всего лишь зуб детеныша.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264843&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ef8e2325-e905-41bb-9526-a9811b402efa\', \'multiverseId\': 264843}, \'multiverseid\': 264843}, {\'name\': \'亚龙巨牙\', \'text\': \'每当牌手施放任何绿色咒语时，你可以获得1点生命。\', \'type\': \'神器\', \'flavor\': \'杰纳诺尔走到哪都搬着它，夸耀自己打倒了亚龙。 幸运地，酒馆常客并没注意到那只是颗乳牙。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263100&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'38c58f8b-5c0c-41b3-af18-4c29df5b5556\', \'multiverseId\': 263100}, \'multiverseid\': 263100}, {\'name\': \'亞龍巨牙\', \'text\': \'每當玩家施放任何綠色咒語時，你可以獲得1點生命。\', \'type\': \'神器\', \'flavor\': \'傑納諾爾走到哪都搬著它，誇耀自己打倒了亞龍。 幸運地，酒館常客並沒注意到那只是顆乳牙。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263349&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'db22d44a-2cd6-4340-afc1-e2441921809a\', \'multiverseId\': 263349}, \'multiverseid\': 263349}]', '[{\'name\': \'Wutgeborener Höllendrache\', \'text\': \'Blutdurst 6 (Wurde einem Gegner in diesem Zug Schaden zugefügt, kommt diese Kreatur mit sechs +1/+1-Marken ins Spiel.)\\nFliegend\', \'type\': \'Kreatur — Drache\', \'flavor\': \'„Vorsicht. Nur ein Tropfen Blut hier bedeutet für uns alle den Tod." —Kalek, Bergführer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263759&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8d584017-8a50-4336-8eab-e15e6ce6cf51\', \'multiverseId\': 263759}, \'multiverseid\': 263759}, {\'name\': \'Engendro nacido de la furia\', \'text\': \'Sed de sangre 6. (Si un oponente recibió daño este turno, esta criatura entra en juego con seis contadores +1/+1 sobre ella.)\\nVuela.\', \'type\': \'Criatura — Dragón\', \'flavor\': \'"Cuidado. Dejar caer una gota de sangre aquí podría significar nuestra muerte." —Kalek, guía de montaña\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265004&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e52771f9-8c20-444a-b61e-85f0d181c125\', \'multiverseId\': 265004}, \'multiverseid\': 265004}, {\'name\': \'Escouflenfer né de la furie\', \'text\': \'Soif de sang 6 (Si un adversaire a subi des blessures ce tour-ci, cette créature arrive sur le champ de bataille avec, sur elle, six marqueurs +1/+1.)\\nVol\', \'type\': \'Créature : dragon\', \'flavor\': \'« Attention. Ici, la moindre goutte de sang pourrait sceller notre destin. » —Kalek, guide de montagne\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263510&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f642e532-e500-4864-bef2-07168bf32630\', \'multiverseId\': 263510}, \'multiverseid\': 263510}, {\'name\': \'Nibbio Infernale Furioso\', \'text\': \'Sete di sangue 6 (Se a un avversario è stato inflitto danno in questo turno, questa creatura entra nel campo di battaglia con sei segnalini +1/+1.)\\nVolare\', \'type\': \'Creatura — Drago\', \'flavor\': \'"Attento. Una goccia di sangue qui significa la morte per tutti." —Kalek, guida di montagna\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264008&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e1635a4d-0566-457e-9f4a-618927a25358\', \'multiverseId\': 264008}, \'multiverseid\': 264008}, {\'name\': \'憤怒生まれのヘルカイト\', \'text\': \'狂喜６ （このターン、いずれかの対戦相手にダメージが与えられている場合、このクリーチャーは＋１/＋１カウンターが６個置かれた状態で戦場に出る）飛行\', \'type\': \'クリーチャー — ドラゴン\', \'flavor\': \'「注意しな。 ここで一滴血を落としたら、俺らみんな死んじまうんだからな。」 ――山の先達、カレク\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264257&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'755e5924-ae55-40a2-b900-83bdc1f37753\', \'multiverseId\': 264257}, \'multiverseid\': 264257}, {\'name\': \'열혈 화룡\', \'text\': \'피굶주림 6 (어느 한 상대라도 이 턴에 피해를 입었다면, 이 생물은 +1/+1 카운터 여섯 개를 가진 채로 전장에 들어온다.)비행\', \'type\': \'생물 — 용\', \'flavor\': \'"조심하세요. 여기서 피 한 방울이라도 흘리면 우린 다 죽습니다."—산악 안내원 캘렉\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'bd303a00-5e43-46da-bd8b-1699322f41ae\'}, \'multiverseid\': None}, {\'name\': \'Dragão Avérneo Enfurecido\', \'text\': \'Sede de sangue 6 (Se um oponente tiver sofrido dano neste turno, esta criatura entrará no campo de batalha com seis marcadores +1/+1 sobre ela.)\\nVoar\', \'type\': \'Criatura — Dragão\', \'flavor\': \'"Cuidado. Uma gota de sangue aqui significa a morte de todos nós." — Kalek, guia da montanha\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264506&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8bfddda7-ab24-4919-87ec-c22bfb90344d\', \'multiverseId\': 264506}, \'multiverseid\': 264506}, {\'name\': \'Рожденный Яростью Змей\', \'text\': \'Кровожадность 6 (Если оппоненту в этом ходу были нанесены повреждения, это существо выходит на поле битвы с шестью жетонами +1/+1 на нем.)\\nПолет\', \'type\': \'Существо — Дракон\', \'flavor\': \'«Осторожно! Капля крови, пролитая здесь, означает смерть для всех нас». — Калек, горный проводник\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264755&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bcfb4062-882a-4dfc-9e69-1058c87b50a3\', \'multiverseId\': 264755}, \'multiverseid\': 264755}, {\'name\': \'盈怒残虐者\', \'text\': \'嗜血6 （如果对手本回合曾受过伤害，此生物进场时上面有六个+1/+1指示物。）\\n飞行\', \'type\': \'生物～龙\', \'flavor\': \'「小心。 在这里流一滴血会把大家都害死。」 ～登山向导卡列\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263012&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0109737b-1bcb-48c5-a04e-b2f1f23055ce\', \'multiverseId\': 263012}, \'multiverseid\': 263012}, {\'name\': \'盈怒殘虐者\', \'text\': \'嗜血6 （如果對手本回合曾受過傷害，此生物進場時上面有六個+1/+1指示物。）\\n飛行\', \'type\': \'生物～龍\', \'flavor\': \'「小心。 在這裡流一滴血會把大家都害死。」 ～登山嚮導卡列\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263261&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'807c3d67-01ca-403b-9087-f704a77fceb0\', \'multiverseId\': 263261}, \'multiverseid\': 263261}]', '[{\'name\': \'Zeitumkehr\', \'text\': \'Jeder Spieler mischt die Karten auf seiner Hand und in seinen Friedhof in seine Bibliothek und zieht dann sieben Karten. Schicke die Zeitumkehr ins Exil.\', \'type\': \'Hexerei\', \'flavor\': \'„Jeder Trampel kann ein Königreich erobern. Doch man braucht echte Macht, um die Zeit zu kontrollieren." —Shai Fusan, Erzmagier\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263701&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'47bccf95-3ea7-4c0b-9dda-ba8b713b04e2\', \'multiverseId\': 263701}, \'multiverseid\': 263701}, {\'name\': \'Revertir el tiempo\', \'text\': \'Cada jugador baraja su mano y cementerio en su biblioteca, luego roba siete cartas. Exilia Revertir el tiempo.\', \'type\': \'Conjuro\', \'flavor\': \'"Cualquier simplón puede conquistar un reino. Hace falta verdadero poder para conquistar el tiempo." —Shai Fusan, archimaga\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264946&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'622aaf9c-273f-4d3a-a4ac-897b71e18596\', \'multiverseId\': 264946}, \'multiverseid\': 264946}, {\'name\': \'Inversion temporelle\', \'text\': "Chaque joueur mélange sa main et son cimetière avec sa bibliothèque et pioche ensuite sept cartes. Exilez l\'Inversion temporelle.", \'type\': \'Rituel\', \'flavor\': "« N\'importe quel rustre peut conquérir un royaume. Mais il faut avoir un véritable pouvoir pour conquérir le temps. » —Shai Fusan, archimage", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263452&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'db7e1c53-9cd0-4880-a1ba-a34e334126cf\', \'multiverseId\': 263452}, \'multiverseid\': 263452}, {\'name\': \'Inversione Temporale\', \'text\': "Ogni giocatore rimescola la propria mano e il proprio cimitero nel proprio grimorio, poi pesca sette carte. Esilia l\'Inversione Temporale.", \'type\': \'Stregoneria\', \'flavor\': \'"Qualsiasi gonzo può conquistare un regno. Ma ci vuole vero potere per conquistare il tempo." —Shai Fusan, arcimaga\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263950&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b48f4974-2e21-4865-a503-72fb5b63c163\', \'multiverseId\': 263950}, \'multiverseid\': 263950}, {\'name\': \'時の逆転\', \'text\': \'各プレイヤーは、自分の手札と墓地を自分のライブラリーに加えて切り直し、その後カードを７枚引く。 時の逆転を追放する。\', \'type\': \'ソーサリー\', \'flavor\': \'「どんな間抜けでも王国を征服することはできる。 時間を征服するには真の力が必要だ。」 ――大魔導師シャイ・フサン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264199&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0691f801-0621-48a9-954e-3f355bdffa10\', \'multiverseId\': 264199}, \'multiverseid\': 264199}, {\'name\': \'시간 역전\', \'text\': \'각 플레이어는 각자의 손과 무덤을 각자의 서고에 섞어 넣고 나서, 카드 일곱 장씩을 뽑는다. 시간 역전을 추방한다.\', \'type\': \'집중마법\', \'flavor\': \'"멍청이라도 왕국을 정복할 수는 있지. 시간을 정복하는 자야 말로 진정한 힘을 가진 자다."—대마법사 샤이 후산\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1203c509-db12-4cf8-af10-3f57e70a8e84\'}, \'multiverseid\': None}, {\'name\': \'Reversão Temporal\', \'text\': \'Cada jogador embaralha a própria mão e cemitério em seu próprio grimório e depois compra sete cards. Exile Reversão Temporal.\', \'type\': \'Feitiço\', \'flavor\': \'"Qualquer tonto conquista um reino. Mas para conquistar o tempo, é necessário um poder verdadeiro." — Shai Fusan, arquimago\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264448&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9cfe646d-25c0-4afd-a7da-51de07e736ab\', \'multiverseId\': 264448}, \'multiverseid\': 264448}, {\'name\': \'Поворот Времени\', \'text\': \'Каждый игрок втасовывает свои руку и кладбище в свою библиотеку, затем берет семь карт. Изгоните Поворот Времени.\', \'type\': \'Волшебство\', \'flavor\': \'«Любой болван может завоевать королевство. А вот чтобы покорить время, требуется настоящая сила». — Шай Фусан, архимаг\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264697&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'52590656-c842-4379-a620-1cdf0c611f14\', \'multiverseId\': 264697}, \'multiverseid\': 264697}, {\'name\': \'时间逆转\', \'text\': \'每位牌手将其手牌与坟墓场洗入其牌库，然后各抓七张牌。 放逐时间逆转。\', \'type\': \'法术\', \'flavor\': \'「再蠢的人都能征服个王国。 而要有真正的力量才能征服时间。」 ～大法师赛福桑\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262954&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f675f6fa-2e2b-461b-964c-f8af9bc67889\', \'multiverseId\': 262954}, \'multiverseid\': 262954}, {\'name\': \'時間逆轉\', \'text\': \'每位玩家將其手牌與墳墓場洗入其牌庫，然後各抽七張牌。 放逐時間逆轉。\', \'type\': \'巫術\', \'flavor\': \'「再蠢的人都能征服個王國。 而要有真正的力量才能征服時間。」 ～大法師賽福桑\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263203&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'630553b0-a369-4ec7-a36d-d0ffb5eafa65\', \'multiverseId\': 263203}, \'multiverseid\': 263203}]', '[{\'name\': \'Zepter der Kaiserreiche\', \'text\': \'{T}: Das Zepter der Kaiserreiche fügt einem Spieler deiner Wahl 1 Schadenspunkt zu. Es fügt diesem Spieler stattdessen 3 Schadenspunkte zu, falls du Artefakte namens Krone der Kaiserreiche und Thron der Kaiserreiche kontrollierst.\', \'type\': \'Artefakt\', \'flavor\': \'„Mit diesem Zepter zerschmettert Ihr Eure Feinde." —Gravur des Zepters\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263840&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'35c904a3-5a83-4aeb-8028-28500dc23518\', \'multiverseId\': 263840}, \'multiverseid\': 263840}, {\'name\': \'Cetro de los imperios\', \'text\': \'{T}: El Cetro de los imperios hace 1 punto de daño al jugador objetivo. En vez de eso, le hace 3 puntos de daño a ese jugador si controlas artefactos llamados Corona de los imperios y Trono de los imperios.\', \'type\': \'Artefacto\', \'flavor\': \'"Con este cetro, derrota a tus enemigos." —Inscripción en el cetro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265085&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'735898d0-4f63-4e13-b9c2-1c27929a9aa7\', \'multiverseId\': 265085}, \'multiverseid\': 265085}, {\'name\': "Sceptre d\'empires", \'text\': "{T} : Le Sceptre d\'empires inflige 1 blessure au joueur ciblé. Il inflige 3 blessures à ce joueur à la place si vous contrôlez des artefacts appelés Couronne d\'empires et Trône d\'empires.", \'type\': \'Artefact\', \'flavor\': \'« Avec ce sceptre, écrase tes ennemis. » —Inscription du sceptre\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263591&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'39d632b2-b1e9-40d4-b188-8030cf8bae80\', \'multiverseId\': 263591}, \'multiverseid\': 263591}, {\'name\': \'Scettro degli Imperi\', \'text\': \'{T}: Lo Scettro degli Imperi infligge 1 danno a un giocatore bersaglio. Infligge invece 3 danni a quel giocatore se controlli degli artefatti chiamati Corona degli Imperi e Trono degli Imperi.\', \'type\': \'Artefatto\', \'flavor\': \'"Con questo scettro, punisci i tuoi nemici." —Iscrizione sullo scettro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264089&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'13142911-4858-43ca-9fd2-9cee534b6abf\', \'multiverseId\': 264089}, \'multiverseid\': 264089}, {\'name\': \'帝国の王笏\', \'text\': \'{T}：プレイヤー１人を対象とする。帝国の王笏はそのプレイヤーに１点のダメージを与える。 あなたが「帝国の王冠」という名前のアーティファクトと「帝国の玉座」という名前のアーティファクトをコントロールしている場合、代わりにそれはそのプレイヤーに３点のダメージを与える。\', \'type\': \'アーティファクト\', \'flavor\': \'「この王笏あらば、お前の敵は撃退さる。」 ――王笏の銘文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264338&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d6016fa7-b770-414a-9fe4-69c92b7b0d86\', \'multiverseId\': 264338}, \'multiverseid\': 264338}, {\'name\': \'제국의 왕홀\', \'text\': \'{T}: 플레이어 한 명을 목표로 정한다. 제국의 왕홀은 그 플레이어에게 피해 1점을 입힌다. 당신이 제국의 왕관이라 명명된 마법물체와 제국의 왕좌라 명명된 마법물체를 조종한다면, 제국의 왕홀은 그 대신에 그 플레이어에게 피해 3점을 입힌다.\', \'type\': \'마법물체\', \'flavor\': \'"이 왕홀을 가지고 적들을 섬멸할지어다."—왕홀조문\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'18b5a37d-c9d8-435b-8250-607870278c1a\'}, \'multiverseid\': None}, {\'name\': \'Cetro dos Impérios\', \'text\': \'{T}: Cetro dos Impérios causa 1 ponto de dano ao jogador alvo. Se você controlar artefatos com os nomes Coroa dos Impérios e Trono dos Impérios, em vez disso, ele causará 3 pontos de dano àquele jogador.\', \'type\': \'Artefato\', \'flavor\': \'"Com este cetro, golpeie seus inimigos." — Inscrição do cetro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264587&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4cde44da-18de-4502-8fd0-b199ab6dac86\', \'multiverseId\': 264587}, \'multiverseid\': 264587}, {\'name\': \'Скипетр Империй\', \'text\': \'{T}: Скипетр Империй наносит 1 повреждение целевому игроку. Вместо этого, он наносит 3 повреждения тому игроку, если вы контролируете артефакты с именами Корона Империй и Престол Империй.\', \'type\': \'Артефакт\', \'flavor\': \'«Этим скипетром сокруши своих врагов». — надпись на скипетре\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264836&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'142780ae-3147-46ff-aff3-00d242d95b78\', \'multiverseId\': 264836}, \'multiverseid\': 264836}, {\'name\': \'帝国权杖\', \'text\': \'{T}：帝国权杖对目标牌手造成1点伤害。 如果你操控名称为帝国冠冕以及帝国王座的神器，则改为它对该牌手造成3点伤害。\', \'type\': \'神器\', \'flavor\': \'「此杖助你扫荡仇敌。」 ～权杖铭文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263093&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'71775dbc-716a-4fb4-93ae-ed8b2010102a\', \'multiverseId\': 263093}, \'multiverseid\': 263093}, {\'name\': \'帝國權杖\', \'text\': \'{T}：帝國權杖對目標玩家造成1點傷害。 如果你操控名稱為帝國冠冕以及帝國王座的神器，則改為它對該玩家造成3點傷害。\', \'type\': \'神器\', \'flavor\': \'「此杖助你掃蕩仇敵。」 ～權杖銘文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263342&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c98ae7eb-6284-483e-8e91-1fd60eb1f901\', \'multiverseId\': 263342}, \'multiverseid\': 263342}]', '[{\'name\': \'Zerfallender Koloss\', \'text\': \'Verursacht Trampelschaden (Falls diese Kreatur ihren Blockern genug Schaden zuweisen würde, um sie zu zerstören, kannst du sie den Rest des Schadens dem verteidigenden Spieler oder Planeswalker zuweisen lassen.)\\nWenn der Zerfallende Koloss angreift, opfere ihn am Ende des Kampfes.\', \'type\': \'Artefaktkreatur — Golem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263828&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'55ffd8db-5e66-43c0-b067-187b0e083c9f\', \'multiverseId\': 263828}, \'multiverseid\': 263828}, {\'name\': \'Coloso desmoronándose\', \'text\': \'Arrolla. (Si esta criatura fuera a asignar suficiente daño a sus bloqueadores como para destruirlos, puedes hacer que le asigne el resto del daño al jugador o planeswalker defensor.)\\nCuando el Coloso desmoronándose ataque, sacrifícalo al final del combate.\', \'type\': \'Criatura artefacto — Gólem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265073&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'069526a8-6e86-4848-8e59-6cfff04e1eb1\', \'multiverseId\': 265073}, \'multiverseid\': 265073}, {\'name\': \'Colosse croulant\', \'text\': "Piétinement (Si cette créature attribue suffisamment de blessures de combat à ses bloqueurs pour les détruire, vous pouvez faire qu\'elle attribue le reste de ses blessures au joueur ou au planeswalker défenseur.)\\nQuand le Colosse croulant attaque, sacrifiez-le à la fin du combat.", \'type\': \'Créature-artefact : golem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263579&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9d09d3cd-e947-485c-aa3e-edc55d1527ab\', \'multiverseId\': 263579}, \'multiverseid\': 263579}, {\'name\': \'Colosso Sgretolato\', \'text\': \'Travolgere (Se questa creatura sta per assegnare alle sue creature bloccanti danno sufficiente a distruggerle, puoi farle assegnare il resto del suo danno al giocatore in difesa o a un planeswalker.)\\nQuando il Colosso Sgretolato attacca, sacrificalo alla fine del combattimento.\', \'type\': \'Creatura Artefatto — Golem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264077&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5836a501-6269-4cd6-9d3d-93e0657a9f71\', \'multiverseId\': 264077}, \'multiverseid\': 264077}, {\'name\': \'崩れゆく巨像\', \'text\': \'トランプル （このクリーチャーが、自身をブロックしているすべてのクリーチャーを破壊するのに十分なダメージを割り振る場合、あなたはそれの残りのダメージを防御プレイヤーかプレインズウォーカーに割り振ってもよい。）\\n崩れゆく巨像が攻撃したとき、戦闘終了時にそれを生け贄に捧げる。\', \'type\': \'アーティファクト・クリーチャー — ゴーレム\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264326&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'662fca67-5872-4006-8194-19bdd3c9a5ce\', \'multiverseId\': 264326}, \'multiverseid\': 264326}, {\'name\': \'부스러지는 거상\', \'text\': \'돌진 (이 생물이 자체의 모든 방어자를 파괴할 만큼의 피해를 배정한다면, 당신은 수비플레이어나 수비플레인즈워커에게 이 생물의 나머지 피해를 배정할 수 있다.)부스러지는 거상이 공격할 때, 부스러지는 거상을 전투종료단 시작에 희생한다.\', \'type\': \'마법물체 생물 — 골렘\', \'flavor\': None, \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ec1dca79-d3ad-4a01-90e2-0edba82540ef\'}, \'multiverseid\': None}, {\'name\': \'Colosso Desmoronado\', \'text\': \'Atropelar (Se esta criatura fosse atribuir dano suficiente para destruir seus bloqueadores, você pode fazer com que ela atribua o resto de seu dano ao planeswalker ou jogador defensor.)\\nQuando Colosso Desmoronado atacar, sacrifique-o no final do combate.\', \'type\': \'Criatura Artefato — Golem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264575&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f02b5bc5-86a6-4281-ae83-7eeab1148c91\', \'multiverseId\': 264575}, \'multiverseid\': 264575}, {\'name\': \'Распадающийся Колосс\', \'text\': \'Пробивной удар (Если это существо распределяет достаточно повреждений, чтобы уничтожить блокирующие его существа, вы можете заставить его распределить оставшиеся повреждения защищающемуся игроку или planeswalker-у.)\\nКогда Распадающийся Колосс атакует, пожертвуйте его в конце боя.\', \'type\': \'Артефактное Существо — Голем\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264824&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6348e35a-a29b-4f72-9fe0-ad86d68dfd48\', \'multiverseId\': 264824}, \'multiverseid\': 264824}, {\'name\': \'崩毁巨像\', \'text\': \'践踏 （如果此生物将分配的伤害足以消灭所有阻挡它的生物，你可以将它所剩余数量的伤害分配给防御牌手或鹏洛客。）\\n当崩毁巨像攻击，在战斗结束时将它牺牲。\', \'type\': \'神器生物～魔像\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263081&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a45eae5c-8c0b-4972-9152-5b0f80123de3\', \'multiverseId\': 263081}, \'multiverseid\': 263081}, {\'name\': \'崩毀巨像\', \'text\': \'踐踏 （如果此生物將分配的傷害足以消滅所有阻擋它的生物，你可以將它所剩餘數量的傷害分配給防禦玩家或鵬洛客。）\\n當崩毀巨像攻擊，在戰鬥結束時將它犧牲。\', \'type\': \'神器生物～魔像\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263330&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'76bcbe57-7502-47b2-b88d-2db042be28c6\', \'multiverseId\': 263330}, \'multiverseid\': 263330}]', '[{\'name\': \'Zertrampelndes Nashorn\', \'text\': \'Verursacht Trampelschaden (Falls diese Kreatur ihren Blockern genug Schaden zuweisen würde, um sie zu zerstören, kannst du sie den Rest des Schadens dem verteidigenden Spieler oder Planeswalker zuweisen lassen.)\', \'type\': \'Kreatur — Nashorn\', \'flavor\': \'Willst du schnell aus dem Dschungel heraus, reize ein Nashorn und folge seiner Spur.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263820&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'94e639aa-8afb-49c5-b156-25ecbae8cbbb\', \'multiverseId\': 263820}, \'multiverseid\': 263820}, {\'name\': \'Rinoceronte en estampida\', \'text\': \'Arrolla. (Si esta criatura fuera a asignar suficiente daño a sus bloqueadores como para destruirlos, puedes hacer que le asigne el resto del daño al jugador o planeswalker defensor.)\', \'type\': \'Criatura — Rinoceronte\', \'flavor\': \'La manera más rápida de atravesar la jungla es molestar a un rinoceronte y correr tras él.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265065&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'03b62861-61f3-4fc3-bf15-b7332c989be3\', \'multiverseId\': 265065}, \'multiverseid\': 265065}, {\'name\': \'Ruée de rhinocéros\', \'text\': "Piétinement (Si cette créature attribue suffisamment de blessures de combat à ses bloqueurs pour les détruire, vous pouvez faire qu\'elle attribue le reste de ses blessures au joueur ou au planeswalker défenseur.)", \'type\': \'Créature : rhinocéros\', \'flavor\': \'Le moyen le plus rapide de traverser la jungle est de faire peur à un rhinocéros et de courir dans son sillage.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263571&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7f564802-7649-454e-81b3-623ae2e7e874\', \'multiverseId\': 263571}, \'multiverseid\': 263571}, {\'name\': \'Rinoceronte in Fuga\', \'text\': \'Travolgere (Se questa creatura sta per assegnare alle sue creature bloccanti danno sufficiente a distruggerle, puoi farle assegnare il resto del suo danno al giocatore in difesa o a un planeswalker.)\', \'type\': \'Creatura — Rinoceronte\', \'flavor\': \'Il modo più rapido per attraversare la giungla è di agitare un rinoceronte e correre nella sua scia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264069&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a755d17b-c0fb-4d0b-8da4-89639e256f9b\', \'multiverseId\': 264069}, \'multiverseid\': 264069}, {\'name\': \'暴走するサイ\', \'text\': \'トランプル （このクリーチャーが、自身をブロックしているすべてのクリーチャーを破壊するのに十分なダメージを割り振る場合、あなたはそれの残りのダメージを防御プレイヤーかプレインズウォーカーに割り振ってもよい。）\', \'type\': \'クリーチャー — サイ\', \'flavor\': \'ジャングルを抜ける一番手っ取り早い方法は、サイを煽ってその踏み跡を走ることだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264318&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'737f4b14-ee8d-4980-afb3-b9d6be6fa56a\', \'multiverseId\': 264318}, \'multiverseid\': 264318}, {\'name\': \'달려드는 코뿔소\', \'text\': \'돌진 (이 생물이 자체의 모든 방어자를 파괴할 만큼의 피해를 배정한다면, 당신은 수비플레이어나 수비플레인즈워커에게 이 생물의 나머지 피해를 배정할 수 있다.)\', \'type\': \'생물 — 코뿔소\', \'flavor\': \'정글을 돌파하는 가장 빠른 방법은 코뿔소를 자극해 날뛰게 만들고 나서 그 뒤를 따라가는 것이다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5abbc6a6-2ebc-4241-a9c4-c55db664b4cf\'}, \'multiverseid\': None}, {\'name\': \'Rinoceronte Desembestado\', \'text\': \'Atropelar (Se esta criatura fosse atribuir dano suficiente para destruir seus bloqueadores, você pode fazer com que ela atribua o resto de seu dano ao planeswalker ou jogador defensor.)\', \'type\': \'Criatura — Rinoceronte\', \'flavor\': \'O modo mais rápido de atravessar a selva é agitar um rinoceronte e correr atrás do seu rastro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264567&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2a7d4f35-d944-49d9-9d00-5fbc1c41346d\', \'multiverseId\': 264567}, \'multiverseid\': 264567}, {\'name\': \'Мчащийся Носорог\', \'text\': \'Пробивной удар (Если это существо распределяет достаточно повреждений, чтобы уничтожить блокирующие его существа, вы можете заставить его распределить оставшиеся повреждения защищающемуся игроку или planeswalker-у.)\', \'type\': \'Существо — Носорог\', \'flavor\': \'Самый быстрый способ пробраться через джунгли: всполошить носорога и бежать вслед за ним.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264816&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f6a4acc1-af8f-4d67-959f-e9e66576fe87\', \'multiverseId\': 264816}, \'multiverseid\': 264816}, {\'name\': \'狂奔犀牛\', \'text\': \'践踏 （如果此生物将分配的伤害足以消灭所有阻挡它的生物，你可以将它所剩余数量的伤害分配给防御牌手或鹏洛客。）\', \'type\': \'生物～犀牛\', \'flavor\': \'穿越丛林的最快方法，是刺激一头犀牛并随其行迹奔跑。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263073&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'883eaa4c-00d5-47b3-9f91-9c0af8fbda52\', \'multiverseId\': 263073}, \'multiverseid\': 263073}, {\'name\': \'狂奔犀牛\', \'text\': \'踐踏 （如果此生物將分配的傷害足以消滅所有阻擋它的生物，你可以將它所剩餘數量的傷害分配給防禦玩家或鵬洛客。）\', \'type\': \'生物～犀牛\', \'flavor\': \'穿越叢林的最快方法，是刺激一頭犀牛並隨其行跡奔跑。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263322&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7f8d4a2d-9c55-4772-99e7-309c37499edc\', \'multiverseId\': 263322}, \'multiverseid\': 263322}]', '[{\'name\': \'Zombie-Goliath\', \'type\': \'Kreatur — Zombie, Riese\', \'flavor\': \'„Das Entfernen von nutzlosen Hirnzellen ist mehrfach nützlich: deine Beweglichkeit ist erhöht, deine Feinde ekeln sich, und du schaffst sogar manchmal noch Platz für Passagiere." —Zul Ashur, Lichfürst\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263743&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bbef3eef-2b32-4b85-9401-5200863a515f\', \'multiverseId\': 263743}, \'multiverseid\': 263743}, {\'name\': \'Goliat zombie\', \'type\': \'Criatura — Gigante zombie\', \'flavor\': \'"Remover el estorbo del tejido cerebral no usado otorga varias ventajas: un pequeño aumento de la movilidad, una respuesta de repulsión y horror del enemigo y, en el caso de los especímenes más grandes, espacio para pasajeros." —Zul Ashur, señor liche\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264988&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c7d56999-96d1-4ea4-b398-1d7ca179b42c\', \'multiverseId\': 264988}, \'multiverseid\': 264988}, {\'name\': \'Goliath zombie\', \'type\': \'Créature : zombie et géant\', \'flavor\': "« Retirer le tissu cérébral inutile présente plusieurs avantages : une petite augmentation de rapidité, une réaction de révulsion et d\'horreur chez l\'ennemi et, dans le cas de spécimens de grande taille, un espace pour des passagers. » —Zul Ashur, seigneur liche", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263494&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bcc0e69a-4827-43bb-9a98-9e0f3eafe688\', \'multiverseId\': 263494}, \'multiverseid\': 263494}, {\'name\': \'Golia Zombie\', \'type\': \'Creatura — Gigante Zombie\', \'flavor\': \'"Rimuovere l\\\'ingombro di tessuto cerebrale inutile fornisce parecchi vantaggi: un leggero miglioramento nella mobilità, una reazione di repulsione e orrore da parte del nemico e, nel caso di grossi esemplari, spazio per dei passeggeri." —Zul Ashur, signore dei lich\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263992&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'652780cb-fce0-4110-8f71-773c1e9287ee\', \'multiverseId\': 263992}, \'multiverseid\': 263992}, {\'name\': \'ゾンビの大巨人\', \'type\': \'クリーチャー — ゾンビ・巨人\', \'flavor\': \'「役立たずの脳の邪魔な部分を取り除くことは、いくつかの点において有益だ。機動性の向上、敵からの恐怖と嫌悪反応、そしてこと大型の種族においては、人員運搬用の空間にもなる。」 ――死者の王、ザル・アシュール\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264241&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ac8f0484-ab57-4ee4-bfd8-3dd1e9b31be4\', \'multiverseId\': 264241}, \'multiverseid\': 264241}, {\'name\': \'좀비 골리앗\', \'type\': \'생물 — 좀비 거인\', \'flavor\': \'"쓸데없는 뇌 조직을 제거하면 장점이 여러 가지 생기지: 기동력 소폭 향상, 적군의 혐오와 공포 유발, 그리고 덩치가 큰 표본의 경우에는 탑승 공간 확보."—리치 군주 줄 아슈르\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5e2281dd-e15e-4c70-ab36-c1b3215066c4\'}, \'multiverseid\': None}, {\'name\': \'Golias Zumbi\', \'type\': \'Criatura — Zumbi Gigante\', \'flavor\': \'"A remoção do estorvo do tecido cerebral inútil oferece diversas vantagens: uma leve melhoria da mobilidade, uma resposta de repulsa e horror por parte do inimigo, e, no caso de espécimes grandes, espaço para passageiros." — Zul Ashur, senhor lich\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264490&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3c4c787f-6568-4376-b7ac-69176271b0e5\', \'multiverseId\': 264490}, \'multiverseid\': 264490}, {\'name\': \'Зомби-Голиаф\', \'type\': \'Существо — Зомби Гигант\', \'flavor\': \'«Удаление громоздкого и абсолютно бесполезного мозга дает несколько преимуществ: некоторое увеличение подвижности, отвращение и ужас со стороны врагов и, в случае крупных особей, место для перевозки пассажиров». — Зул Ашур, лорд-лич\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264739&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9045a940-4a1e-4a5b-9418-6c85ae38cd88\', \'multiverseId\': 264739}, \'multiverseid\': 264739}, {\'name\': \'巨硕灵俑\', \'type\': \'生物～灵俑／巨人\', \'flavor\': \'「把无用又占空间的脑部组织拿掉，能带来些好处：移动力略增，让敌人感到嫌恶与恐惧，并且若是大型样本，还能搭载乘员。」 ～巫妖领主祝亚许\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262996&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8f1eed08-d6d7-474e-b761-b6081fa1a056\', \'multiverseId\': 262996}, \'multiverseid\': 262996}, {\'name\': \'巨碩殭屍\', \'type\': \'生物～殭屍／巨人\', \'flavor\': \'「把無用又佔空間的腦部組織拿掉，能帶來些好處：移動力略增，讓敵人感到嫌惡與恐懼，並且若是大型樣本，還能搭載乘員。」 ～巫妖領主祝亞許\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263245&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'730190ae-1caa-4176-b59c-f7ebd33f7a2d\', \'multiverseId\': 263245}, \'multiverseid\': 263245}]', '[{\'name\': \'Zombiebefall\', \'text\': \'Wirf zwei Karten aus deiner Hand ab: Bringe einen 2/2 schwarzen Zombie-Kreaturenspielstein ins Spiel.\', \'type\': \'Verzauberung\', \'flavor\': \'Die Scheiterhaufen der Nomaden sind eher praktischer Natur als unbedingt zeremoniell.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263744&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'510b3a3c-74b0-4f4a-a190-28637eaa7229\', \'multiverseId\': 263744}, \'multiverseid\': 263744}, {\'name\': \'Infestación de zombies\', \'text\': \'Descartar dos cartas: Pon en el campo de batalla una ficha de criatura Zombie negra 2/2.\', \'type\': \'Encantamiento\', \'flavor\': \'Las piras funerarias de los nómadas son más prácticas que ceremoniales.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264989&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1d314402-96d6-42de-b858-d58ca2e8ca24\', \'multiverseId\': 264989}, \'multiverseid\': 264989}, {\'name\': \'Infestation de zombies\', \'text\': \'Défaussez-vous de deux cartes : Mettez sur le champ de bataille un jeton de créature 2/2 noire Zombie.\', \'type\': \'Enchantement\', \'flavor\': "C\'est pour des raisons pratiques, et non religieuses, que les nomades brûlent leurs morts.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263495&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b2aabac2-0353-4af7-a517-975033f55bbb\', \'multiverseId\': 263495}, \'multiverseid\': 263495}, {\'name\': \'Infestazione di Zombie\', \'text\': \'Scarta due carte: Metti sul campo di battaglia una pedina creatura Zombie 2/2 nera.\', \'type\': \'Incantesimo\', \'flavor\': \'Le pire funebri dei nomadi sono più per praticità che per cerimonia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263993&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c166e71e-ace7-4ea3-a188-ba917b662f69\', \'multiverseId\': 263993}, \'multiverseid\': 263993}, {\'name\': \'ゾンビの横行\', \'text\': \'カードを２枚捨てる：黒の２/２のゾンビ・クリーチャー・トークンを１体戦場に出す。\', \'type\': \'エンチャント\', \'flavor\': \'遊牧の民の火葬用の積み薪は、儀式用というよりもむしろ実用的なものなのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264242&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'66bfc20b-baa5-4b0f-a8e1-41e1d741248d\', \'multiverseId\': 264242}, \'multiverseid\': 264242}, {\'name\': \'좀비 만연\', \'text\': \'카드 두 장을 버린다: 2/2 흑색 좀비 생물 토큰 한 개를 전장에 놓는다.\', \'type\': \'부여마법\', \'flavor\': \'유목민들이 시체를 화장하는 건, 의식이라기보다는 사전 방지에 가깝다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7df81a51-326c-4d5c-9674-4c3c4b764348\'}, \'multiverseid\': None}, {\'name\': \'Infestação de Zumbis\', \'text\': \'Descarte dois cards: Coloque no campo de batalha uma ficha de criatura preta 2/2 do tipo Zumbi.\', \'type\': \'Encantamento\', \'flavor\': \'As piras funerárias dos nômades são mais funcionais do que cerimoniais.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264491&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c87be8a9-b25e-4894-a22f-f0d6f5c0de7b\', \'multiverseId\': 264491}, \'multiverseid\': 264491}, {\'name\': \'Нашествие Зомби\', \'text\': \'Сбросьте две карты: положите на поле битвы одну фишку существа 2/2 черный Зомби.\', \'type\': \'Чары\', \'flavor\': \'Погребальные костры кочевников играют скорее практическую роль, нежели церемониальную.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264740&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c637beb3-7d82-4cf2-a6ab-dbaf2b76b12c\', \'multiverseId\': 264740}, \'multiverseid\': 264740}, {\'name\': \'灵俑侵扰\', \'text\': \'弃两张牌：将一个2/2黑色灵俑衍生生物放进战场。\', \'type\': \'结界\', \'flavor\': \'游牧人的火葬注重实用价值，而非仪式性。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=262997&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6bd1fc50-5a79-4a58-a422-42fa0d61481d\', \'multiverseId\': 262997}, \'multiverseid\': 262997}, {\'name\': \'殭屍侵擾\', \'text\': \'棄兩張牌：將一個2/2黑色殭屍衍生生物放進戰場。\', \'type\': \'結界\', \'flavor\': \'遊牧人的火葬注重實用價值，而非儀式性。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263246&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d2716705-3078-4e20-8b7e-26e6036c2b28\', \'multiverseId\': 263246}, \'multiverseid\': 263246}]', '[{\'name\': \'Ältester des Dunkelhags\', \'text\': \'Fluchsicher (Diese Kreatur kann nicht das Ziel von Zaubersprüchen oder Fähigkeiten sein, die deine Gegner kontrollieren.)\\nStärke und Widerstandskraft des Ältesten des Dunkelhags sind gleich der Anzahl der Wälder, die du kontrollierst.\', \'type\': \'Kreatur — Baumhirte\', \'flavor\': \'Alle Bäume des Waldes sind seine Armee, und jedes Blatt sein Schild.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263795&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'759fc3c2-4df7-41f3-ae42-fdb36f674b31\', \'multiverseId\': 263795}, \'multiverseid\': 263795}, {\'name\': \'Anciano de Arboleda Parda\', \'text\': \'Antimaleficio. (Esta criatura no puede ser objetivo de hechizos o habilidades que controlen tus oponentes.)\\nTanto la fuerza como la resistencia del Anciano de Arboleda Parda son iguales al número de bosques que controlas.\', \'type\': \'Criatura — Pueblo-arbóreo\', \'flavor\': \'Todos los árboles del bosque son su ejército, y cada hoja su escudo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265040&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e0999eb2-24f3-4a8c-b0b1-fef3fb2d2e43\', \'multiverseId\': 265040}, \'multiverseid\': 265040}, {\'name\': \'Doyen de Brunbosquet\', \'text\': "Défense talismanique (Cette créature ne peut pas être la cible de sorts ou de capacités que vos adversaires contrôlent.)\\nLa force et l\'endurance du Doyen de Brunbosquet sont chacune égales au nombre de forêts que vous contrôlez.", \'type\': \'Créature : sylvin\', \'flavor\': \'Tous les arbres de la forêt représentent son armée, et chaque feuille, son bouclier.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263546&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b3be5390-8faa-4bcf-93e6-a5d7b67da1be\', \'multiverseId\': 263546}, \'multiverseid\': 263546}, {\'name\': \'Anziano di Selva Tetra\', \'text\': "Anti-malocchio (Questa creatura non può essere bersaglio di magie o abilità controllate dai tuoi avversari.)\\nLa forza e la costituzione dell\'Anziano di Selva Tetra sono pari al numero di Foreste che controlli.", \'type\': \'Creatura — Silvantropo\', \'flavor\': \'Tutti gli alberi della foresta formano il suo esercito e ogni foglia è il suo scudo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264044&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9a72f476-270e-4e5a-9ae2-2d961b3d5598\', \'multiverseId\': 264044}, \'multiverseid\': 264044}, {\'name\': \'ダングローブの長老\', \'text\': \'呪禁 （このクリーチャーは、あなたの対戦相手がコントロールする呪文や能力の対象にならない。）\\nダングローブの長老のパワーとタフネスは、それぞれあなたがコントロールする森の総数に等しい。\', \'type\': \'クリーチャー — ツリーフォーク\', \'flavor\': \'この森の樹はすべて彼の軍団、葉はすべて彼の盾。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264293&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3a522ad6-f557-48a3-acf7-cb4b803ab631\', \'multiverseId\': 264293}, \'multiverseid\': 264293}, {\'name\': \'던그로브 고목\', \'text\': \'방호 (이 생물은 상대가 조종하는 주문이나 능력의 목표로 정해질 수 없다.)던그로브 고목의 공격력과 방어력은 각각 당신이 조종하는 숲의 수와 똑같다.\', \'type\': \'생물 — 인목\', \'flavor\': \'숲속의 모든 나무는 그의 무기고, 모든 잎사귀는 그의 방패다.\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e0040ecd-d52c-45fc-8ccc-24d9c830739d\'}, \'multiverseid\': None}, {\'name\': \'Ancião Bosque Pardo\', \'text\': \'Resistência à magia (Esta criatura alvo não pode ser alvo de mágicas nem de habilidades que seus oponentes controlam.)\\nO poder e a resistência de Ancião Bosque Pardo são ambos iguais ao número de florestas que você controla.\', \'type\': \'Criatura — Ent\', \'flavor\': \'As árvores da floresta são seu exército, e cada folha seu escudo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264542&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c796dce5-2e0c-4cc8-b071-7dab17a3c2dc\', \'multiverseId\': 264542}, \'multiverseid\': 264542}, {\'name\': \'Старейшина Племени Дангровов\', \'text\': \'Порчеустойчивость (Это существо не может быть целью заклинаний или способностей под контролем ваших оппонентов.)\\nСила и выносливость Старейшины Племени Дангровов равны количеству Лесов под вашим контролем.\', \'type\': \'Существо — Лесовик\', \'flavor\': \'Все деревья в лесу — его воины, и каждый лист — его щит.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264791&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bfdf0827-5e36-4e4b-93e4-268bab0297ce\', \'multiverseId\': 264791}, \'multiverseid\': 264791}, {\'name\': \'丘丛长老\', \'text\': \'辟邪 （此生物不能成为由对手所操控之咒语或异能的目标。）\\n丘丛长老之力量与防御力各等同于由你操控的树林之数量。\', \'type\': \'生物～树妖\', \'flavor\': \'树林的每株树都是其部队，每片叶都是其盾牌。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263048&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d3dfdca3-d18d-43e9-81e3-81863fe0863a\', \'multiverseId\': 263048}, \'multiverseid\': 263048}, {\'name\': \'丘叢長老\', \'text\': \'辟邪 （此生物不能成為由對手所操控之咒語或異能的目標。）\\n丘叢長老之力量與防禦力各等同於由你操控的樹林之數量。\', \'type\': \'生物～樹妖\', \'flavor\': \'樹林的每株樹都是其部隊，每片葉都是其盾牌。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263297&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2077ad2d-8a5c-46ef-a1b3-ed9be32b7f9f\', \'multiverseId\': 263297}, \'multiverseid\': 263297}]', '[{\'name\': \'Ätzender Schleim\', \'text\': \'Todesberührung (Eine beliebige Menge Schadenspunkte, die er einer Kreatur zufügt, sind ausreichend, um sie zu zerstören.)\\nWenn der Ätzende Schleim ins Spiel kommt, zerstöre ein Artefakt, eine Verzauberung oder ein Land deiner Wahl.\', \'type\': \'Kreatur — Schlammwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263785&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'adc7099b-6516-4e0a-9c16-c9ea12f70c67\', \'multiverseId\': 263785}, \'multiverseid\': 263785}, {\'name\': \'Fango ácido\', \'text\': \'Toque mortal. (Cualquier cantidad de daño que esto haga a una criatura es suficiente para destruirla.)\\nCuando el Fango ácido entre al campo de batalla, destruye el artefacto, encantamiento o tierra objetivo.\', \'type\': \'Criatura — Cieno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265030&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9b0fce53-248a-45e1-b393-247a5c4abce8\', \'multiverseId\': 265030}, \'multiverseid\': 265030}, {\'name\': \'Boue acide\', \'text\': "Contact mortel (Le nombre de blessures que cette créature inflige à une créature, quel qu\'il soit, est suffisant pour la détruire.)\\nQuand la Boue acide arrive sur le champ de bataille, détruisez l\'artefact, l\'enchantement ou le terrain ciblé.", \'type\': \'Créature : limon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263536&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1240c9d2-56e4-4c8b-8b00-b7ea5b62e88f\', \'multiverseId\': 263536}, \'multiverseid\': 263536}, {\'name\': \'Melma Acida\', \'text\': \'Tocco letale (Qualsiasi danno che questa creatura infligge a una creatura è sufficiente a distruggerla.)\\nQuando la Melma Acida entra nel campo di battaglia, distruggi un artefatto, un incantesimo o una terra bersaglio.\', \'type\': \'Creatura — Melma\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264034&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c2008e19-5c1a-4008-8a65-9e15393d0296\', \'multiverseId\': 264034}, \'multiverseid\': 264034}, {\'name\': \'酸のスライム\', \'text\': \'接死 （これが何らかのダメージをクリーチャーに与えた場合、それだけで破壊される。）\\n酸のスライムが戦場に出たとき、アーティファクト１つかエンチャント１つか土地１つを対象とし、それを破壊する。\', \'type\': \'クリーチャー — ウーズ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264283&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dab3a462-bb06-4e1a-b4db-378b5179029d\', \'multiverseId\': 264283}, \'multiverseid\': 264283}, {\'name\': \'산성 슬라임\', \'text\': \'치명타 (이 생물에게 피해를 입은 생물은 얼마의 피해를 입든 파괴된다.)산성 슬라임이 전장에 들어올 때, 마법물체 한 개나 부여마법 한 개나 대지 한 개를 목표로 정해서 파괴한다.\', \'type\': \'생물 — 점액괴물\', \'flavor\': None, \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2ac83aff-c579-48d7-a435-5c212b26e0fe\'}, \'multiverseid\': None}, {\'name\': \'Limo Ácido\', \'text\': \'Toque mortífero (Qualquer quantidade de dano que esta criatura cause a uma criatura é suficiente para destruí-la.)\\nQuando Limo Ácido entrar no campo de batalha, destrua o artefato, encantamento ou terreno alvo.\', \'type\': \'Criatura — Lodo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264532&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e0d58a6e-4f91-4ecb-895d-29c3acbb919e\', \'multiverseId\': 264532}, \'multiverseid\': 264532}, {\'name\': \'Кислотная Слизь\', \'text\': \'Смертельное касание (Любое количество повреждений, которое этот объект наносит существу, достаточно, чтобы его уничтожить.)\\nКогда Кислотная Слизь выходит на поле битвы, уничтожьте целевой артефакт, чары или землю.\', \'type\': \'Существо — Тина\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264781&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b9448dc3-ab46-45ca-b624-ed93fecc8534\', \'multiverseId\': 264781}, \'multiverseid\': 264781}, {\'name\': \'酸液黏菌\', \'text\': \'死触 （它对生物造成的任何数量伤害都足以消灭后者。）\\n当酸液黏菌进战场时，消灭目标神器，结界，或地。\', \'type\': \'生物～流浆\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263038&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dc9a4457-40c5-445b-bae7-7b032152bed6\', \'multiverseId\': 263038}, \'multiverseid\': 263038}, {\'name\': \'酸液黏菌\', \'text\': \'死觸 （它對生物造成的任何數量傷害都足以消滅後者。）\\n當酸液黏菌進戰場時，消滅目標神器，結界，或地。\', \'type\': \'生物～流漿\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263287&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7e4511d6-3321-4bf7-bf03-efb77902771b\', \'multiverseId\': 263287}, \'multiverseid\': 263287}]', '[{\'name\': \'Überrennen\', \'text\': \'Bis zum Ende des Zuges erhalten Kreaturen, die du kontrollierst, +3/+3 und verursachen Trampelschaden. (Falls eine Kreatur, die du kontrollierst, ihren Blockern genug Schaden zuweisen würde, um sie zu zerstören, kannst du sie den Rest des Schadens dem verteidigenden Spieler oder Planeswalker zuweisen lassen.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263810&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e91b12e2-f101-48fd-9125-8e378ad26976\', \'multiverseId\': 263810}, \'multiverseid\': 263810}, {\'name\': \'Sobrepasar\', \'text\': \'Las criaturas que controlas obtienen +3/+3 y ganan la habilidad de arrollar hasta el final del turno. (Si una criatura que controles fuera a asignar suficiente daño a sus bloqueadores como para destruirlos, puedes hacer que le asigne el resto del daño al jugador o planeswalker defensor.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=265055&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9dbc4417-5bd0-4ac6-b70f-6e26fb0118cf\', \'multiverseId\': 265055}, \'multiverseid\': 265055}, {\'name\': \'Envahissement\', \'text\': "Les créatures que vous contrôlez gagnent +3/+3 et acquièrent le piétinement jusqu\'à la fin du tour. (Si une créature que vous contrôlez attribue suffisamment de blessures de combat à ses bloqueurs pour les détruire, vous pouvez faire qu\'elle attribue le reste de ses blessures au joueur ou au planeswalker défenseur.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263561&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d26a636c-43d9-48eb-81d3-917bbb9c24e1\', \'multiverseId\': 263561}, \'multiverseid\': 263561}, {\'name\': \'Sopraffare\', \'text\': \'Le creature che controlli prendono +3/+3 e hanno travolgere fino alla fine del turno. (Se una creatura che controlli sta per assegnare alle sue creature bloccanti danno sufficiente a distruggerle, puoi farle assegnare il resto del suo danno al giocatore in difesa o a un planeswalker.)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264059&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3846aa43-a181-4ae0-aea8-d1139f5e49ae\', \'multiverseId\': 264059}, \'multiverseid\': 264059}, {\'name\': \'踏み荒らし\', \'text\': \'あなたがコントロールするクリーチャーは、ターン終了時まで＋３/＋３の修整を受けるとともにトランプルを得る。 （あなたがコントロールするクリーチャーが、自身をブロックしているすべてのクリーチャーを破壊するのに十分なダメージを割り振る場合、あなたはそれの残りのダメージを防御プレイヤーやプレインズウォーカーに割り振ってもよい。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264308&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4b160c2e-bf1c-445c-8428-d154865408a3\', \'multiverseId\': 264308}, \'multiverseid\': 264308}, {\'name\': \'폭주\', \'text\': \'당신이 조종하는 모든 생물은 턴종료까지 +3/+3을 받고, 돌진 능력을 얻는다. (당신이 조종하는 생물이 자체의 모든 방어자를 파괴할 만큼의 피해를 배정한다면, 당신은 수비플레이어나 수비플레인즈워커에게 그 생물의 나머지 피해를 배정할 수 있다.)\', \'type\': \'집중마법\', \'flavor\': None, \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2feac384-13c9-4b87-b54d-1f7170f03ac7\'}, \'multiverseid\': None}, {\'name\': \'Ultrapassar\', \'text\': \'As criaturas que você controla recebem +3/+3 e ganham atropelar até o final do turno. (Se uma criatura que você controla fosse atribuir dano suficiente para destruir seus bloqueadores, você pode fazer com que ela atribua o resto de seu dano ao planeswalker ou jogador defensor.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264557&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'006ca9c7-0445-4001-b9d0-19e71595c501\', \'multiverseId\': 264557}, \'multiverseid\': 264557}, {\'name\': \'Набег\', \'text\': \'Существа под вашим контролем получают +3/+3 и Пробивной удар до конца хода. (Если существо под вашим контролем распределяет достаточно повреждений, чтобы уничтожить блокирующие его существа, вы можете заставить его распределить оставшиеся повреждения защищающемуся игроку или planeswalker-у.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=264806&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'991f5f66-3293-4577-a574-c4888413629f\', \'multiverseId\': 264806}, \'multiverseid\': 264806}, {\'name\': \'横行\', \'text\': \'由你操控的生物得+3/+3并获得践踏异能直到回合结束。 （如果由你操控的某生物将分配的伤害足以消灭所有阻挡它的生物，你可以将它所剩余数量的伤害分配给防御牌手或鹏洛客。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263063&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'24ce7701-4f6d-45f1-a383-f916acf2bb3d\', \'multiverseId\': 263063}, \'multiverseid\': 263063}, {\'name\': \'橫行\', \'text\': \'由你操控的生物得+3/+3並獲得踐踏異能直到回合結束。 （如果由你操控的某生物將分配的傷害足以消滅所有阻擋它的生物，你可以將它所剩餘數量的傷害分配給防禦玩家或鵬洛客。）\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=263312&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f3e65ac0-12c6-420f-b496-798bef82ffae\', \'multiverseId\': 263312}, \'multiverseid\': 263312}]']
