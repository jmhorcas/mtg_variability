, 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'd8ceafc4-6fa8-46f0-90de-30f04939271a'}, 'multiverseid': None}, {'name': 'Bouclier rhystique', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '31821db7-17e9-4cb1-9c07-1b9ba353f4fb'}, 'multiverseid': None}, {'name': 'Scudo Ristico', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'd55530ba-6451-45fd-8262-955d9aa54a66'}, 'multiverseid': None}, {'name': 'リスティックの盾', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'b51f9b3e-4e17-4d78-841f-89e33b6bc432'}, 'multiverseid': None}, {'name': 'Escudo Rístico', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fa22f886-9f61-4752-926c-1a0bef67ed63'}, 'multiverseid': None}]", "[{'name': 'Rhystischer Schutzkreis', 'text': '{1}: Jeder Spieler kann 1 bezahlen. Falls keiner dies tut, verhindere den Schaden, wenn Dir eine Quelle, die Du bestimmst, in diesem Zug das nächste Mal Schaden zufügt.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '6eee077a-f96f-45c5-b51e-acb9c846d6fb'}, 'multiverseid': None}, {'name': 'Circulo Rístico', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'b268ced9-c46a-4900-bc0a-f905ccad6226'}, 'multiverseid': None}, {'name': 'Cercle rhystique', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '955b06fa-6d31-4bbf-8ffd-87ebe5903d64'}, 'multiverseid': None}, {'name': 'Circolo Ristico', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '54dc30f0-cc39-4185-ad5a-220ff001672f'}, 'multiverseid': None}, {'name': 'リスティックの円', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '95c352e4-5884-48f9-9d7e-6800a4e6db19'}, 'multiverseid': None}, {'name': 'Círculo Rístico', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0ccba6e7-91ed-4eb4-8c56-8cc4f2085ba9'}, 'multiverseid': None}]", "[{'name': 'Rhystisches Studium', 'text': 'Immer wenn ein Gegner einen Zauberspruch spielt, kannst Du eine Karte ziehen, falls dieser Spieler nicht 1 bezahlt.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '72216696-7cd1-4a11-be22-94086b474dc0'}, 'multiverseid': None}, {'name': 'Estudio Rístico', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '688af2b9-9751-49c7-b882-d7fb0c17bb6d'}, 'multiverseid': None}, {'name': 'Etude rhystique', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '574a460f-28bb-402c-b82f-484d7b276d8f'}, 'multiverseid': None}, {'name': 'Studio Ristico', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'af354a24-d7a4-42c5-a0c2-3e5d9bc3c438'}, 'multiverseid': None}, {'name': 'リスティックの研究', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'eb4acd6a-7899-4042-b495-66defc9bb3c0'}, 'multiverseid': None}, {'name': 'Estudo Rístico', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8af28998-b210-4486-8d8d-34ceb09d109f'}, 'multiverseid': None}]", '[{\'name\': \'Rückkehr der Elefanten\', \'text\': \'Jeder Spieler bringt einen grünen Elefanten-Spielstein ins Spiel. Diese Kreaturen haben "Stärke und Widerstandskraft dieser Kreatur sind gleich der Anzahl der Kreaturenkarten im Friedhof ihres Beherrschers."\', \'type\': \'Hexerei\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'02f4eb5b-89a8-4de0-8d4f-a60cd9743d36\'}, \'multiverseid\': None}, {\'name\': \'Renacimiento de Elefantes\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b1d58fdd-5b43-4ae2-b911-6804d018f6c8\'}, \'multiverseid\': None}, {\'name\': "Regain d\'éléphants", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'01092a66-ace3-47bf-b9db-6af2dd9940c3\'}, \'multiverseid\': None}, {\'name\': "Rinascita dell\'Elefante", \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ec38cc1d-60db-4b3a-a815-81ea9d6c7255\'}, \'multiverseid\': None}, {\'name\': \'象の復活\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'274fb1aa-2017-4e34-b82d-65458b467f7d\'}, \'multiverseid\': None}, {\'name\': \'Ressurgência dos Elefantes\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7740e098-f6f9-4aaf-8f74-f54d2444616e\'}, \'multiverseid\': None}]', "[{'name': 'Rückzug', 'text': 'Bringe eine Kreatur Deiner Wahl auf die Hand ihres Besitzers zurück. Bringe dann eine weitere Kreatur Deiner Wahl auf die Hand ihres Besitzers zurück, wenn deren Beherrscher nicht 1 bezahlt.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '56b7cab3-585c-4ea8-9950-21444e4211b8'}, 'multiverseid': None}, {'name': 'Retirada', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '572c0e9f-dcd0-424a-b264-e952b5b428da'}, 'multiverseid': None}, {'name': 'Repli', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'c50fb0b8-005a-4855-b7d5-076c2c473fd7'}, 'multiverseid': None}, {'name': 'Ritirata', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'aa3a196e-aff3-4d4d-9aa8-67d5a5ba61e3'}, 'multiverseid': None}, {'name': '引き揚げ', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '829df12e-f17e-4429-b5ac-146004f9be2b'}, 'multiverseid': None}, {'name': 'Retirar', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9dcd98aa-4403-45af-8835-ffbd806ddba3'}, 'multiverseid': None}]", "[{'name': 'Samitische Zuflucht', 'text': '{2}: Verhindere den nächsten 1 Schadenspunkt, der einer Kreatur Deiner Wahl in diesem Zug zugefügt wurde.\\nJeder Spieler kann diese Fähigkeit spielen.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '19538793-f3ef-4480-9391-b046c8163d18'}, 'multiverseid': None}, {'name': 'Santuario Samita',