 None, 'language': 'German', 'identifiers': {'scryfallId': '1aef1e40-1d26-4727-ab93-9781879d4141'}, 'multiverseid': None}, {'name': 'Minotauro de Zerapa', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '11d8dae2-f964-4a4d-b534-7f3575d18f48'}, 'multiverseid': None}, {'name': 'Minotaure zérapian', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '078b83d3-770a-4885-b370-0a1fd148f5cb'}, 'multiverseid': None}, {'name': 'Minotauro di Zerapa', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'ee60ee10-d8b5-4901-94d3-7247c80a29f2'}, 'multiverseid': None}, {'name': 'ゼラパのミノタウルス', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '185772d7-2dc3-4a5b-847e-584558a9d370'}, 'multiverseid': None}, {'name': 'Minotauro de Zerapa', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e8e9bebc-a4c3-4308-9dae-a14abcc5dba9'}, 'multiverseid': None}]", "[{'name': 'Zerfurchendes Schlachtroß', 'text': 'Opfere ein Land: Das Zerfurchende Schlachtroß erhält +0/+3bis zum Ende des Zuges', 'type': 'Kreatur — Rebell', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'a434cebe-5c6c-44e4-9dce-fe9b16bdd6b1'}, 'multiverseid': None}, {'name': 'Corcel Zanjador', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '92ed2e59-47c2-4873-84e8-15f8726b62b8'}, 'multiverseid': None}, {'name': 'Coursier sapeur', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '0fd217cf-5f9b-4a9d-9c2b-9ee9c2bab658'}, 'multiverseid': None}, {'name': 'Destriero di Trincea', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '6f480209-ab7e-4801-94de-c401e6640e99'}, 'multiverseid': None}, {'name': '塹壕馬', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'ae1e041e-a206-44e8-bf00-ad9cefe598ea'}, 'multiverseid': None}, {'name': 'Corcel de Trincheira', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1722497a-2019-4365-83f3-535db503798f'}, 'multiverseid': None}]", "[{'name': 'Zertrommler', 'text': 'Jedesmal, wenn der Zertrommler geblockt wird, opfert der verteidigende Spieler ein Land.', 'type': 'Kreatur — Bestie', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '2fba9bc0-1602-41c3-81c9-303abd0313ca'}, 'multiverseid': None}, {'name': 'Bestia Trilladora', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '2277c4a6-bebb-4643-b917-dc4d5722bf64'}, 'multiverseid': None}, {'name': 'Bête batteuse', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '5fd2775a-dfbb-4893-9764-6ceb1aef051a'}, 'multiverseid': None}, {'name': 'Bestia Mietitrice', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '20aaab73-f0e2-4cb0-bf8a-6c8f26c03035'}, 'multiverseid': None}, {'name': '尾長獣', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '8ee16223-ebad-42c5-946a-17ca7cdfedda'}, 'multiverseid': None}, {'name': 'Besta Destruidora', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f234dc96-9204-4d6d-9e77-5b6d60d044b6'}, 'multiverseid': None}]", "[{'name': 'Zitadelle des Schmerzes', 'text': 'Am Ende des Zuges jedes Spielers fügt die Zitadelle des Schmerzes diesem Spieler X Schadenspunkte zu, wobei X gleich der Anzahl an ungetappten Ländern ist, die dieser Spieler kontrolliert.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '5ef2a19e-3b2c-4378-8ac9-9f5c398f420b'}, 'multiverseid': None}, {'name': 'Ciudadela del Dolor', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '8bde85e9-13e9-47c0-bd9e-70d2e0ffce36'}, 'multiverseid': None}, {'name': 'Citadelle de la douleur', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '17a044be-6a55-4dbd-a19c-9d937101ad30'}, 'multiverseid': None}, {'name': 'Cittadella del Dolore', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '7135c3ae-32