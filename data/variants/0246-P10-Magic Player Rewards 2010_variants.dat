name: ['Bituminous Blast', 'Burst Lightning', 'Cancel', 'Celestial Purge', 'Comet Storm', 'Harrow', 'Infest', 'Lightning Bolt', 'Sign in Blood', 'Sun Titan', 'Volcanic Fallout', 'Wurmcoil Engine']
