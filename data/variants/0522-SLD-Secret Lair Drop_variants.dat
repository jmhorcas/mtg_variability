56c5fbf564', 'f360db77-eb35-577a-aec9-eac9263155ad', 'f36c5de3-7e73-5d11-88a6-63b3b2ff7271', 'f3ea40cd-c702-560d-a7a6-6dbe3a5b7751', 'f4761df1-1fc4-58ef-b9a5-a859453820de', 'f4d4bb37-348c-5ef4-be48-c7a5943a7ea1', 'f5016e90-917e-5a9a-9740-60e4775e811b', 'f64a9383-4056-5cb9-8e4e-ec4978c1701c', 'f70df975-a65f-522a-a02e-f986a9c8cdfc', 'f7d14913-c5f4-5140-87f4-3ec6f4445421', 'f7df56ba-1197-5f9c-919a-ae113a2cf30f', 'f8543a17-e314-56c7-95d5-27b02a77b568', 'f8aea3de-9ff7-5367-b45c-f538b99a25bf', 'f916309d-fabb-549a-a216-d5b788439fc9', 'f93fa4d1-068d-5126-bbba-3863884b39c4', 'f9e17610-a7f2-5943-bd29-626453de5ae8', 'fa191134-bef3-54f1-87c3-2fb2afc48345', 'fa340683-e523-511d-8c98-ea498d69da0c', 'fa7d7182-1ed5-5a63-b185-0c207ba8ca18', 'fa9161bb-b485-5b98-a476-9ba010fac3d3', 'fb3bdc21-d1c3-5fa2-8ea6-3ff48b11a5bc', 'fb6d7f6f-e157-5693-b494-308c443bc6e4', 'fc3601c3-aa97-5d3e-8ba3-4e0878194c6d', 'fdde36e4-3e6b-50a6-911a-2693534ba1ad', 'fe3a390b-ca06-5b2c-af57-b9f1c7eb2862', 'ff23e0e7-2c80-56c9-8573-370c4f14155e', 'ff3ed33a-3cb5-5f12-89c9-7d69b5c07de9', 'ff52648a-1ed8-59ed-a803-5af75f4fa303']
watermark: ['cutiemark', 'phyrexian', 'wotc']
border: []
