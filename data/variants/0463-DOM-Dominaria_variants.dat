d': 445023}, 'multiverseid': 445023}, {'name': 'Равнина', 'type': 'Базовая Земля — Равнина', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445292&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '0fd023ed-37a0-49bc-88d0-b15b6827a2f5', 'multiverseId': 445292}, 'multiverseid': 445292}, {'name': '平原', 'type': '基本地 ～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445561&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'd8c63e01-7743-461f-8c95-d90a71283769', 'multiverseId': 445561}, 'multiverseid': 445561}, {'name': '平原', 'type': '基本地 ～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445830&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '08763b8e-31ae-4288-ae5a-a95d1dddfbb1', 'multiverseId': 445830}, 'multiverseid': 445830}]", "[{'name': 'Ebene', 'type': 'Standardland — Ebene', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443410&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5575aa3c-3062-4518-8b24-0a2ccc41bd1d', 'multiverseId': 443410}, 'multiverseid': 443410}, {'name': 'Llanura', 'type': 'Tierra básica — Llanura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443679&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '6afbc81a-3bbc-42d4-b025-4ed325ff2882', 'multiverseId': 443679}, 'multiverseid': 443679}, {'name': 'Plaine', 'type': 'Terrain de base : plaine', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443948&type=card', 'language': 'French', 'identifiers': {'scryfallId': '1dc01ef8-25d4-4e15-a8b4-078619552b43', 'multiverseId': 443948}, 'multiverseid': 443948}, {'name': 'Pianura', 'type': 'Terra Base — Pianura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444217&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'be082b7c-3964-48c5-9d03-78515cc13cc9', 'multiverseId': 444217}, 'multiverseid': 444217}, {'name': '平地', 'type': '基本土地 — 平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444486&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'd010f3eb-c37c-44f2-83c6-ddce03f9b62a', 'multiverseId': 444486}, 'multiverseid': 444486}, {'name': '들', 'type': '기본 대지 — 들', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444755&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '152635fe-dd32-4786-b1c9-b34a5953588a', 'multiverseId': 444755}, 'multiverseid': 444755}, {'name': 'Planície', 'type': 'Terreno Básico — Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445024&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fff3594f-450c-457e-bc95-4907ed9f1199', 'multiverseId': 445024}, 'multiverseid': 445024}, {'name': 'Равнина', 'type': 'Базовая Земля — Равнина', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445293&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '7e5a6236-1883-46aa-b48c-3e1d4805d540', 'multiverseId': 445293}, 'multiverseid': 445293}, {'name': '平原', 'type': '基本地 ～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445562&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '961d0593-2712-419e-81c5-0215bec8af72', 'multiverseId': 445562}, 'multiverseid': 445562}, {'name': '平原', 'type': '基本地 ～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445831&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '6cd44873-f02e-4440-be2b-fc3497ce3ead', 'multiverseId': 445831}, 'multiverseid': 445831}]", '[{\'name\': \'Eiskalter Manipulator\', \'text\': \'{1}, {T}: Tappe ein Artefakt, eine Kreatur oder ein Land deiner Wahl.\', \'type\': \'Artefakt\', \'flavor\': \'Eis und Wasser sind zwei Zustände desselben Elements, Arglist und Bosheit zwei Ausdrucksformen desselben Übels.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443376&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9724c9ab-5af5-45b7-a213-6836970111df\', \'multiverseId\': 443376}, \'multiverseid\': 443376}, {\'name\': \'Manipulador gélido\', \'text\': \'{1}, {T}: Gira el artefacto, criatura o tierra objetivo.\', \'type\': \'Artefacto\', \'flavor\': \'El hielo puede derretirse, pero la maldad no.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443645&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9b71c4a8-c81c-4703-bcff-0b506d96f9f7\', \'multiverseId\': 443645}, \'multiverseid\': 443645}, {\'name\': \'Manipulateur glacial\', \'text\': "{1}, {T} : Engagez l\'artefact ciblé, la créature ciblée ou le terrain ciblé.", \'type\': \'Artefact\', \'flavor\': \'La glace peut fondre, mais pas la malfaisance.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443914&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1398f2d0-ff8e-400f-886a-becb0ab76711\', \'multiverseId\': 443914}, \'multiverseid\': 443914}, {\'name\': \'Manipolatore Glaciale\', \'text\': \'{1}, {T}: TAPpa un artefatto, una creatura o una terra bersaglio.\', \'type\': \'Artefatto\', \'flavor\': \'Il ghiaccio potrà sciogliersi, la malignità mai.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444183&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5b1833b5-93cc-41fc-a191-268bc85a2ec8\', \'multiverseId\': 444183}, \'multiverseid\': 444183}, {\'name\': \'氷の干渉器\', \'text\': \'{1}, {T}：アーティファクト１つかクリーチャー１体か土地１つを対象とし、それをタップする。\', \'type\': \'アーティファクト\', \'flavor\': \'氷は解けても恨みが解けることはない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444452&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'04849ced-2b27-4046-85a8-8399bed36be1\', \'multiverseId\': 444452}, \'multiverseid\': 444452}, {\'name\': \'얼어붙은 조종기계\', \'text\': \'{1}, {T}: 마법물체나 생물 또는 대지를 목표로 정한다. 그 목표를 탭한다.\', \'type\': \'마법물체\', \'flavor\': \'얼음은 녹을 수 있지만, 악의는 결코 그렇지 않다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444721&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3e4fd197-6838-47ee-81f9-70065ac193a0\', \'multiverseId\': 444721}, \'multiverseid\': 444721}, {\'name\': \'Manipulador Gélido\', \'text\': \'{1}, {T}: Vire o artefato, a criatura ou o terreno alvo.\', \'type\': \'Artefato\', \'flavor\': \'O gelo pode derreter. A malícia, jamais.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444990&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c1be38f5-7c38-4217-a0ae-d395d19bd20c\', \'multiverseId\': 444990}, \'multiverseid\': 444990}, {\'name\': \'Ледяной Манипулятор\', \'text\': \'{1}, {T}: поверните целевой артефакт, существо или землю.\', \'type\': \'Артефакт\', \'flavor\': \'Лед может растаять, злоба же остается навсегда.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445259&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'90579cb8-6e4d-4caf-ab2b-44a3246a3f12\', \'multiverseId\': 445259}, \'multiverseid\': 445259}, {\'name\': \'寒冰操弄器\', \'text\': \'{1}，{T}：横置目标神器，生物或地。\', \'type\': \'神器\', \'flavor\': \'冰会化，但恶难消。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445528&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3436d69d-86f6-4630-a886-4938a22bb146\', \'multiverseId\': 445528}, \'multiverseid\': 445528}, {\'name\': \'寒冰操弄器\', \'text\': \'{1}，{T}：橫置目標神器，生物或地。\', \'type\': \'神器\', \'flavor\': \'冰會化，但惡難消。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445797&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f9632147-7a55-4a4c-a3ec-de3a3916ad8b\', \'multiverseId\': 445797}, \'multiverseid\': 445797}]', '[{\'name\': \'Elfheim-Druidin\', \'text\': \'{T}: Erzeuge {G}.\\n{T}: Erzeuge {G}{G}. Verwende dieses Mana nur, um Zaubersprüche samt Bonuskosten zu wirken.\', \'type\': \'Kreatur — Elf, Druide\', \'flavor\': \'Die Verbindung zwischen den Llanowarelfen und ihren Kavu gleicht einer Symbiose.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443316&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4d2b2122-4aa9-4bd8-a36f-c645b4c06e9b\', \'multiverseId\': 443316}, \'multiverseid\': 443316}, {\'name\': \'Druida del elfhogar\', \'text\': \'{T}: Agrega {G}.\\n{T}: Agrega {G}{G}. Usa este maná solo para lanzar hechizos estimulados.\', \'type\': \'Criatura — Druida elfo\', \'flavor\': \'El vínculo entre los elfos de Llanowar y sus kavu los beneficia a ambos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443585&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'90fce907-70fe-4009-9e89-919314fc1417\', \'multiverseId\': 443585}, \'multiverseid\': 443585}, {\'name\': \'Druidesse terrelfe\', \'text\': \'{T} : Ajoutez {G}.\\n{T} : Ajoutez {G}{G}. Ne dépensez ce mana que pour lancer des sorts kickés.\', \'type\': \'Créature : elfe et druide\', \'flavor\': "L\'elfe de Llanowar et son kavru sont tous deux renforcés par le lien qui les unit.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443854&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d4a97515-8e64-4ab3-804d-c819a1f45104\', \'multiverseId\': 443854}, \'multiverseid\': 443854}, {\'name\': \'Druida del Regno Elfico\', \'text\': \'{T}: Aggiungi {G}.\\n{T}: Aggiungi {G}{G}. Spendi questo mana solo per lanciare magie potenziate.\', \'type\': \'Creatura — Druido Elfo\', \'flavor\': \'Il legame tra gli elfi di Llanowar e i loro kavu fortifica entrambi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444123&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ca0a1e66-a84b-493c-ad71-d08fed1e67cb\', \'multiverseId\': 444123}, \'multiverseid\': 444123}, {\'name\': \'エルフェイムのドルイド\', \'text\': \'{T}：{G}を加える。\\n{T}：{G}{G}を加える。このマナは、キッカーされている呪文を唱えるためにのみ使用できる。\', \'type\': \'クリーチャー — エルフ・ドルイド\', \'flavor\': \'ラノワールのエルフとカヴーの結びつきは両方に力を与える。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444392&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f9d121e8-383f-4ed8-bc31-d421d47e74d4\', \'multiverseId\': 444392}, \'multiverseid\': 444392}, {\'name\': \'엘프헤임 드루이드\', \'text\': \'{T}: {G}를 추가한다.\\n{T}: {G}{G}를 추가한다. 이 마나는 키커 비용을 지불할 주문을 발동하는 데에만 사용할 수 있다.\', \'type\': \'생물 — 엘프 드루이드\', \'flavor\': \'라노워 엘프와 카부의 결속은 서로에게 힘이 되어 준다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444661&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f911eab3-8c7b-40c4-8263-be6987e54c01\', \'multiverseId\': 444661}, \'multiverseid\': 444661}, {\'name\': \'Druida de Elfilar\', \'text\': \'{T}: Adicione {G}.\\n{T}: Adicione {G}{G}. Gaste este mana somente para conjurar mágicas reforçadas.\', \'type\': \'Criatura — Elfo Druida\', \'flavor\': \'O vínculo entre os elfos de Llanowar e seus kavus fortalece ambos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444930&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'edd3b947-645c-4f43-a7b6-833502b3c60b\', \'multiverseId\': 444930}, \'multiverseid\': 444930}, {\'name\': \'Эльфхеймский Друид\', \'text\': \'{T}: добавьте {G}.\\n{T}: добавьте {G}{G}. Тратьте эту ману только на разыгрывание получивших Усилитель заклинаний.\', \'type\': \'Существо — Эльф Друид\', \'flavor\': \'Союз каву и эльфов Лановара делает сильнее и тех, и других.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445199&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cef8079e-a693-4331-8cee-c95e6512a5d0\', \'multiverseId\': 445199}, \'multiverseid\': 445199}, {\'name\': \'妖精乡德鲁伊\', \'text\': \'{T}：加{G}。\\n{T}：加{G}{G}。此法术力只能用来施放已增幅的咒语。\', \'type\': \'生物 ～妖精／德鲁伊\', \'flavor\': \'罗堰的妖精与其卡甫间的羁绊让双方变得更强。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445468&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5688d697-9639-4233-9a6a-76842a4e9d04\', \'multiverseId\': 445468}, \'multiverseid\': 445468}, {\'name\': \'妖精鄉德魯伊\', \'text\': \'{T}：加{G}。\\n{T}：加{G}{G}。此魔法力只能用來施放已增幅的咒語。\', \'type\': \'生物 ～妖精／德魯伊\', \'flavor\': \'羅堰的妖精與其卡甫間的羈絆讓雙方變得更強。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445737&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d8020d71-8aaf-4fa7-a058-006e4225ba0d\', \'multiverseId\': 445737}, \'multiverseid\': 445737}]', '[{\'name\': \'Entreißen\', \'text\': \'Ein Spieler deiner Wahl zeigt die Karten auf seiner Hand offen vor. Du bestimmst davon eine Artefakt- oder Kreaturenkarte. Der Spieler wirft die bestimmte Karte ab.\', \'type\': \'Hexerei\', \'flavor\': \'Flimmerfeen sammeln Dinge von ungewöhnlichem Wert: Münzen gefallener Reiche, Milchzähne und Erinnerungen an unausgesprochene Namen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443244&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a0c6b7e5-59c4-4955-a700-54961a1a1451\', \'multiverseId\': 443244}, \'multiverseid\': 443244}, {\'name\': \'Hurtar\', \'text\': \'El jugador objetivo muestra su mano. Tú eliges de ahí una carta de artefacto o de criatura. Ese jugador descarta esa carta.\', \'type\': \'Conjuro\', \'flavor\': \'Los duendes manoslargas suelen coleccionar objetos inesperadamente valiosos; por ejemplo, monedas de imperios caídos, dientes de leche o los recuerdos de seres queridos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443513&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'44a6f409-9e37-47c5-8904-990f89e67861\', \'multiverseId\': 443513}, \'multiverseid\': 443513}, {\'name\': \'Dépouiller\', \'text\': "Le joueur ciblé révèle sa main. Vous y choisissez une carte d\'artefact ou de créature. Ce joueur se défausse de cette carte.", \'type\': \'Rituel\', \'flavor\': "Les preste-follets collectent des choses étrangement précieuses : pièces de monnaie d\'empires déchus, dents de lait et souvenirs de noms chéris.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443782&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e7e1040f-6dc2-4f32-ad2d-7b54416eeb8b\', \'multiverseId\': 443782}, \'multiverseid\': 443782}, {\'name\': \'Sottrarre\', \'text\': \'Un giocatore bersaglio rivela la sua mano. Scegli una carta artefatto o creatura da quella mano. Quel giocatore scarta quella carta.\', \'type\': \'Stregoneria\', \'flavor\': \'Gli spiritelli guizzanti raccolgono oggetti di insolito valore: monete di imperi caduti, denti da latte e ricordi di nomi preziosi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444051&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d367bac9-2298-4ca7-bfd9-6102ebbce189\', \'multiverseId\': 444051}, \'multiverseid\': 444051}, {\'name\': \'抜去\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーは自分の手札を公開する。あなたはその中からアーティファクトかクリーチャーであるカード１枚を選ぶ。そのプレイヤーはそのカードを捨てる。\', \'type\': \'ソーサリー\', \'flavor\': \'瞬動スプライトは特に価値のあるものを集める。失われた帝国のコイン、赤ん坊の歯、大切な名前の思い出などだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444320&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'07ad1288-e5f9-4f79-af1b-97d7dbb522b6\', \'multiverseId\': 444320}, \'multiverseid\': 444320}, {\'name\': \'박탈\', \'text\': \'플레이어를 목표로 정한다. 그 플레이어는 자신의 손을 공개한다. 당신은 그중 마법물체나 생물 카드 한 장을 선택한다. 그 플레이어는 그 카드를 버린다.\', \'type\': \'집중마법\', \'flavor\': \'펄럭요정들은 특별하고 진귀한, 예를 들면 몰락한 제국의 주화, 갓난아이의 치아, 그리고 보물 같은 이름의 기억 같은 것들을 모은다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444589&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f165feca-4650-4141-8828-2b122b3760da\', \'multiverseId\': 444589}, \'multiverseid\': 444589}, {\'name\': \'Alienar\', \'text\': \'O jogador alvo revela a própria mão. Você escolhe um card de artefato ou criatura dela. Aquele jogador descarta aquele card.\', \'type\': \'Feitiço\', \'flavor\': \'As sílfides dardejantes colecionam coisas de valor bem pouco usuais: moedas de impérios caídos, dentes de bebês e lembranças de nomes queridos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444858&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bb034eab-136e-411f-87c4-1872f7e38512\', \'multiverseId\': 444858}, \'multiverseid\': 444858}, {\'name\': \'Изъятие\', \'text\': \'Целевой игрок показывает свою руку. Вы выбираете из нее карту артефакта или существа. Тот игрок сбрасывает ту карту.\', \'type\': \'Волшебство\', \'flavor\': \'Быстрокрылые феи собирают необычные сокровища: монеты исчезнувших империй, детские зубы и воспоминания о дорогих сердцу именах.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445127&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1ed87715-2ca4-40ac-8129-51241c4b874a\', \'multiverseId\': 445127}, \'multiverseid\': 445127}, {\'name\': \'褫夺\', \'text\': \'目标牌手展示其手牌。你选择其中一张神器或生物牌。该牌手弃掉该牌。\', \'type\': \'法术\', \'flavor\': \'迅舞仙子收集格外珍贵的东西：堕落王朝的钱币，乳齿，以及对珍贵名字的记忆。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445396&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b192dabe-95d8-4481-bbae-96030b5f1737\', \'multiverseId\': 445396}, \'multiverseid\': 445396}, {\'name\': \'褫奪\', \'text\': \'目標玩家展示其手牌。你選擇其中一張神器或生物牌。該玩家棄掉該牌。\', \'type\': \'巫術\', \'flavor\': \'迅舞仙子收集格外珍貴的東西：墮落王朝的錢幣，乳齒，以及對珍貴名字的記憶。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445665&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4b9c0fe6-18a9-4105-a3b4-3ed8dc1c3e5f\', \'multiverseId\': 445665}, \'multiverseid\': 445665}]', '[{\'name\': \'Erwachen des Waldes\', \'text\': \'Bis zu deinem nächsten Zug werden alle Länder, die du kontrollierst, zu 2/2 Elementarwesen-Kreaturen mit Reichweite, Unzerstörbarkeit und Eile. Sie sind auch immer noch Länder.\', \'type\': \'Hexerei\', \'flavor\': \'„Yavimaya ist nicht immer wach, aber stets wachsam. Du wirst den Unterschied erkennen." —Karn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443340&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a7fa5727-e6bd-477b-9bd8-b844d02de6bd\', \'multiverseId\': 443340}, \'multiverseid\': 443340}, {\'name\': \'Despertar silvano\', \'text\': \'Hasta tu próximo turno, todas las tierras que controlas se convierten en criaturas Elemental 2/2 con las habilidades de alcance, indestructible y prisa. Siguen siendo tierras.\', \'type\': \'Conjuro\', \'flavor\': \'"Yavimaya está consciente, pero no siempre despierto. Entenderás la diferencia cuando lo veas". —Karn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443609&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f9fad5ea-5d40-4f60-b34f-e37fc4c9a446\', \'multiverseId\': 443609}, \'multiverseid\': 443609}, {\'name\': \'Éveil sylvestre\', \'text\': "Jusqu\'à votre prochain tour, tous les terrains que vous contrôlez deviennent des créatures 2/2 Élémental avec la portée, l\'indestructible et la célérité. Ce sont toujours des terrains.", \'type\': \'Rituel\', \'flavor\': \'« La Yavimaya est consciente, mais pas toujours éveillée. Vous comprendrez la différence lorsque vous la verrez. » —Karn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443878&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2821f05d-bd88-43fc-85e2-4ba38a481c85\', \'multiverseId\': 443878}, \'multiverseid\': 443878}, {\'name\': \'Risveglio Silvano\', \'text\': \'Fino al tuo prossimo turno, tutte le terre che controlli diventano creature Elementale 2/2 con raggiungere, indistruttibile e rapidità. Sono ancora terre.\', \'type\': \'Stregoneria\', \'flavor\': \'"Yavimaya è consapevole, ma non sempre desta. Quando la vedrai, capirai la differenza." —Karn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444147&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fce98e5c-ee1e-45c4-bb69-4d2613b825b5\', \'multiverseId\': 444147}, \'multiverseid\': 444147}, {\'name\': \'森の目覚め\', \'text\': \'あなたの次のターンまで、あなたがコントロールしている土地はすべて到達と破壊不能と速攻を持つ２/２のエレメンタル・クリーチャーになる。それらは土地でもある。\', \'type\': \'ソーサリー\', \'flavor\': \'「ヤヴィマヤは気付いているが、いつでも目覚めているわけではない。目覚めているときを自分で見れば違いがわかるだろう。」 ――カーン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444416&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8a49b495-b154-4587-83b2-44263be673cf\', \'multiverseId\': 444416}, \'multiverseid\': 444416}, {\'name\': \'숲의 각성\', \'text\': \'당신의 다음 턴까지, 당신이 조종하는 모든 대지는 대공, 무적, 신속을 가진 2/2 정령 생물이 된다. 그 대지들은 생물이 된 이후에도 여전히 대지이다.\', \'type\': \'집중마법\', \'flavor\': \'"야미마야는 알고 있지만, 언제나 깨어 있는 것은 아니다. 직접 눈으로 보면 그 차이를 알게 될 것이다." —카른\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444685&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'50a5d7fc-f734-4245-b1d4-25ac8da8516a\', \'multiverseId\': 444685}, \'multiverseid\': 444685}, {\'name\': \'Despertar Silvestre\', \'text\': \'Até seu próximo turno, todos os terrenos que você controla se tornam criaturas 2/2 do tipo Elemental com alcance, indestrutível e ímpeto. Elas ainda são terrenos.\', \'type\': \'Feitiço\', \'flavor\': \'"Yavimaya está consciente, mas nem sempre está desperta. Você saberá a diferença quando vir." — Karn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444954&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'60f6c42f-5577-407d-b672-f08a490d2214\', \'multiverseId\': 444954}, \'multiverseid\': 444954}, {\'name\': \'Лесное Пробуждение\', \'text\': \'До вашего следующего хода все земли под вашим контролем становятся существами 2/2 Элементаль с Захватом, Неразрушимостью и Ускорением. При этом они остаются землями.\', \'type\': \'Волшебство\', \'flavor\': \'«Явимайя бдит, но она не всегда бодрствует. Ты поймешь, в чем разница, когда увидишь». — Карн\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445223&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8ac75100-9d24-4ff2-a9a5-8eceb45be9d0\', \'multiverseId\': 445223}, \'multiverseid\': 445223}, {\'name\': \'森林觉醒\', \'text\': \'直到你的下一个回合，所有由你操控的地成为2/2，具延势、不灭与敏捷异能的元素生物。它们仍然是地。\', \'type\': \'法术\', \'flavor\': \'「亚维马雅已有意识，但时醒时眠。等你见到了，就会明白其中的差别。」 ～卡恩\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445492&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'70dd47df-0e0b-498c-aded-b5112f95c7c9\', \'multiverseId\': 445492}, \'multiverseid\': 445492}, {\'name\': \'森林覺醒\', \'text\': \'直到你的下一個回合，所有由你操控的地成為2/2，具延勢、不滅與敏捷異能的元素生物。它們仍然是地。\', \'type\': \'巫術\', \'flavor\': \'「亞維馬雅已有意識，但時醒時眠。等你見到了，就會明白其中的差別。」 ～卡恩\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445761&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a483f7b6-d5aa-457a-8e09-5738753e314f\', \'multiverseId\': 445761}, \'multiverseid\': 445761}]', '[{\'name\': \'Evra, Zeugin von Halcyon\', \'text\': \'Lebensverknüpfung\\n{4}: Tausche deinen Lebenspunktestand mit der Stärke von Evra, Zeugin von Halcyon.\', \'type\': \'Legendäre Kreatur — Avatar\', \'flavor\': \'„Das Licht des Nullmonds nahm Gestalt an — ein wahrgewordenes Trugbild, in seiner Erscheinung unvergleichlich." —Untergang der Thran\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443173&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'55e448ec-34c8-40b4-bead-3d6de7c85294\', \'multiverseId\': 443173}, \'multiverseid\': 443173}, {\'name\': \'Evra, testigo de Halcyon\', \'text\': \'Vínculo vital.\\n{4}: Intercambia tu total de vidas con la fuerza de Evra, testigo de Halcyon.\', \'type\': \'Criatura legendaria — Avatar\', \'flavor\': \'"La luz de la Luna de Nulificación cobró forma; era un espejismo hecho realidad, solo en su grandeza, aislado en un mundo que una vez fue suyo". —Caída de los thran\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443442&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'425c5f37-063b-43fd-b666-7ade3c3c7179\', \'multiverseId\': 443442}, \'multiverseid\': 443442}, {\'name\': "Evra, témoin d\'Alcyon", \'text\': "Lien de vie\\n{4} : Échangez votre total de points de vie contre la force d\'Evra, témoin d\'Alcyon.", \'type\': \'Créature légendaire : avatar\', \'flavor\': "« La lumière de la Lune stérile prit forme : un mirage devenu réel, seul dans la majesté, isolé dans un monde qui avait autrefois été le sien. » —Chute de l\'empire thran", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443711&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'547e67ea-6127-4da8-ace9-ad89ab643d0c\', \'multiverseId\': 443711}, \'multiverseid\': 443711}, {\'name\': \'Evrya, Testimone di Alcione\', \'text\': \'Legame vitale\\n{4}: Scambia i tuoi punti vita con la forza di Evrya, Testimone di Alcione.\', \'type\': \'Creatura Leggendaria — Avatar\', \'flavor\': \'"La luce della Luna Nulla prese forma: un miraggio divenuto realtà, solo nella sua magnificenza, isolato in un mondo che un tempo era stato suo." —Caduta dei Thran\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443980&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ba56b2af-61f8-4973-9de8-c250d61989fd\', \'multiverseId\': 443980}, \'multiverseid\': 443980}, {\'name\': \'ハルシオンの目撃者、エヴラ\', \'text\': \'絆魂\\n{4}：あなたのライフ総量とハルシオンの目撃者、エヴラのパワーを交換する。\', \'type\': \'伝説のクリーチャー — アバター\', \'flavor\': \'「虚月の光が形になった。幻を現実に、ただ独り気高く、かつて自身のものであった世界に閉じ込められていた。」 ――スランの崩落\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444249&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'299dc564-3fae-4d4d-8d5b-1ce0928239ed\', \'multiverseId\': 444249}, \'multiverseid\': 444249}, {\'name\': \'할시온의 목격자, 에브라\', \'text\': \'생명연결\\n{4}: 당신의 생명 총점을 할시온의 목격자, 에브라의 공격력과 교환한다.\', \'type\': \'전설적 생물 — 화신\', \'flavor\': \'"공허한 달에서 나온 빛이 형상을 이루었다—한때 그 자체로 완전했던 세계 속에 격리되어 장엄하게 홀로 남겨져 있던, 실체화된 신기루였다." —트란의 몰락\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444518&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e58f274a-867e-46c7-8599-cdf6e207a8c9\', \'multiverseId\': 444518}, \'multiverseid\': 444518}, {\'name\': \'Evra, Testemunha de Alcíone\', \'text\': \'Vínculo com a vida\\n{4}: Permute seu total de pontos de vida com o poder de Evra, Testemunha de Alcíone.\', \'type\': \'Criatura Lendária — Avatar\', \'flavor\': \'"A luz da Lua Nula tomou forma, uma miragem feita real, de grandiosidade sem par, isolada em um mundo que já foi o seu." — Queda dos Thran\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444787&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ef450572-1f81-40f8-a4d4-565dc8674343\', \'multiverseId\': 444787}, \'multiverseid\': 444787}, {\'name\': \'Эвра, Свидетельница Хальциона\', \'text\': \'Цепь жизни\\n{4}: обменяйтесь количеством ваших жизней с силой Эвры, Свидетельницы Хальциона.\', \'type\': \'Легендарное Существо — Аватара\', \'flavor\': \'«Свет Пустой Луны обрел форму — мираж стал реальностью, одинокой в своем величии, запертой в мире, когда-то принадлежавшем ей самой». — «Падение Транов»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445056&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'63ea0170-6833-42c5-ad66-cd3434648e29\', \'multiverseId\': 445056}, \'multiverseid\': 445056}, {\'name\': \'宁城见证人艾芙拉\', \'text\': \'系命\\n{4}：将你的总生命与宁城见证人艾芙拉的力量交换。\', \'type\': \'传奇生物 ～圣者\', \'flavor\': \'「虚无之月的光芒具现成形～海市蜃楼幻化成真，在曾存世界中卓然独立。」 ～《索蓝覆亡录》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445325&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ae8b30c8-b45e-4578-92c8-1585f4daa3af\', \'multiverseId\': 445325}, \'multiverseid\': 445325}, {\'name\': \'寧城見證人艾芙拉\', \'text\': \'繫命\\n{4}：將你的總生命與寧城見證人艾芙拉的力量交換。\', \'type\': \'傳奇生物 ～聖者\', \'flavor\': \'「虛無之月的光芒具現成形～海市蜃樓幻化成真，在曾存世界中卓然獨立。」 ～《索藍覆亡錄》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445594&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a21e62c0-09db-4695-8abd-33dced395d39\', \'multiverseId\': 445594}, \'multiverseid\': 445594}]', '[{\'name\': \'Felsenburg der Kabbalisten\', \'text\': \'{T}: Erzeuge {C}.\\n{3}, {T}: Erzeuge {B} für jedes Sumpf-Standardland, das du kontrollierst.\', \'type\': \'Land\', \'flavor\': \'Die Felsenburg ist Belzenloks Machtsitz und dient den Kabbalsiten als Versammlungsort, von dem aus sie ihren dunklen Einfluss über die Grenzen von Urborg hinaus verbreiten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443395&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b8b5ef04-d7bd-418f-8fb7-7aa1d72680f4\', \'multiverseId\': 443395}, \'multiverseid\': 443395}, {\'name\': \'Fortaleza de la Cábala\', \'text\': \'{T}: Agrega {C}.\\n{3}, {T}: Agrega {B} por cada Pantano básico que controlas.\', \'type\': \'Tierra\', \'flavor\': \'La Fortaleza, bastión del poder de Belzenlok, es el lugar de reunión de la Cábala mientras su oscura influencia se extiende desde Urborg.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443664&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d9fd68d8-bed1-4504-8065-b8e65682771d\', \'multiverseId\': 443664}, \'multiverseid\': 443664}, {\'name\': \'Forteresse de la Coterie\', \'text\': \'{T} : Ajoutez {C}.\\n{3}, {T} : Ajoutez {B} pour chaque marais de base que vous contrôlez.\', \'type\': \'Terrain\', \'flavor\': "Siège de la puissance de Belzenlok, la forteresse sert de lieu de rassemblement à la Coterie, tandis que sa sombre influence s\'étend depuis Urborg.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443933&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'30a0cf08-c87e-4a31-b70f-4e6ad098ed26\', \'multiverseId\': 443933}, \'multiverseid\': 443933}, {\'name\': \'Fortezza della Cabala\', \'text\': \'{T}: Aggiungi {C}.\\n{3}, {T}: Aggiungi {B} per ogni Palude base che controlli.\', \'type\': \'Terra\', \'flavor\': \'Sede del potere di Belzenlok, la Fortezza rappresenta il luogo di ritrovo della Cabala mentre la sua influenza oscura si diffonde oltre i confini di Urborg.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444202&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'efb33501-0e96-48d2-ab72-651a2eaf23e7\', \'multiverseId\': 444202}, \'multiverseid\': 444202}, {\'name\': \'陰謀団の要塞\', \'text\': \'{T}：{C}を加える。\\n{3}, {T}：あなたがコントロールしている基本沼１つにつき{B}を加える。\', \'type\': \'土地\', \'flavor\': \'ベルゼンロックの権力中枢であるこの要塞は、陰謀団がアーボーグから広がった闇の影響力を集約する場所でもある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444471&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c2641e80-e047-4da6-9eff-3af0a636b43d\', \'multiverseId\': 444471}, \'multiverseid\': 444471}, {\'name\': \'도당의 성채\', \'text\': \'{T}: {C}를 추가한다.\\n{3}, {T}: 당신이 조종하는 기본 늪 한 개당 {B}를 추가한다.\', \'type\': \'대지\', \'flavor\': \'벨젠로크의 힘의 기반인 이 성채는, 도당의 어두운 영향력이 우르보그에서 퍼져나가면서 그들의 회합 장소 역할을 하고 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444740&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'eebc545a-ac02-4601-8ae4-37056b20a2db\', \'multiverseId\': 444740}, \'multiverseid\': 444740}, {\'name\': \'Fortaleza da Cabala\', \'text\': \'{T}: Adicione {C}.\\n{3}, {T}: Adicione {B} para cada Pântano básico que você controla.\', \'type\': \'Terreno\', \'flavor\': \'Sede do poder de Belzenlok, a Fortaleza serve como ponto de reunião para a Cabala enquanto sua influência sombria se dissemina a partir de Urborg.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445009&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3da2d1b1-bdcb-45d4-a92b-7e155aa48fa1\', \'multiverseId\': 445009}, \'multiverseid\': 445009}, {\'name\': \'Твердыня Кабала\', \'text\': \'{T}: добавьте {C}.\\n{3}, {T}: добавьте {B} за каждое базовое Болото под вашим контролем.\', \'type\': \'Земля\', \'flavor\': \'Твердыня, престол власти Бельзенлока, служит местом собраний Кабала, откуда его темное влияние распространяется за пределы Урборга.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445278&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'11747bcf-c119-44ee-89f6-6c03f46b372c\', \'multiverseId\': 445278}, \'multiverseid\': 445278}, {\'name\': \'柯帮城塞\', \'text\': \'{T}：加{C}。\\n{3}，{T}：你每操控一个基本沼泽，便加{B}。\', \'type\': \'地\', \'flavor\': \'天罗城塞乃是贝赞洛的力量中枢，于柯帮不断在乌尔博格散布其黑暗影响之时充当其教众的集结地。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445547&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d2369d6f-193b-44ee-8d3f-9662f2950299\', \'multiverseId\': 445547}, \'multiverseid\': 445547}, {\'name\': \'柯幫城塞\', \'text\': \'{T}：加{C}。\\n{3}，{T}：你每操控一個基本沼澤，便加{B}。\', \'type\': \'地\', \'flavor\': \'天羅城乃是貝贊洛的力量中樞，於柯幫不斷在烏爾博格散佈其黑暗影響之時充當其教眾的集結地。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445816&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'01be11fa-dc70-4ee5-a852-9186c9424ea3\', \'multiverseId\': 445816}, \'multiverseid\': 445816}]', '[{\'name\': \'Felskuppenzuflucht\', \'text\': \'Die Felskuppenzuflucht kommt getappt ins Spiel, es sei denn, du kontrollierst ein Gebirge oder eine Ebene.\\n{T}: Erzeuge {R} oder {W}.\', \'type\': \'Land\', \'flavor\': \'Sanft fällt das Licht auf den Tempel von Epityr und lässt die in Stein gemeißelten Flügel der Engelsretterin schimmern.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443396&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ade70bce-655c-4638-9300-ad3b93eaf094\', \'multiverseId\': 443396}, \'multiverseid\': 443396}, {\'name\': \'Refugio en la cima\', \'text\': \'El Refugio en la cima entra al campo de batalla girado a menos que controles una Montaña o una Llanura.\\n{T}: Agrega {R} o {W}.\', \'type\': \'Tierra\', \'flavor\': \'La luz del sol cae inmaculada sobre el templo de Épityr, solo suavizada por las sombras recordadas de las alas de los salvadores angelicales.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443665&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2eea56b1-ddb6-49f3-8912-e67800720c08\', \'multiverseId\': 443665}, \'multiverseid\': 443665}, {\'name\': \'Rectorat du haut des falaises\', \'text\': \'Le Rectorat du haut des falaises arrive sur le champ de bataille engagé à moins que vous ne contrôliez une montagne ou une plaine.\\n{T} : Ajoutez {R} ou {W}.\', \'type\': \'Terrain\', \'flavor\': "La lumière cristalline du soleil inonde le temple d\'Epityr, adoucie par l\'ombre indélébile des ailes angéliques salvatrices.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443934&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c51337af-a749-458c-ae2f-58bd4d9b8e7c\', \'multiverseId\': 443934}, \'multiverseid\': 443934}, {\'name\': \'Rifugio in Cima al Dirupo\', \'text\': \'Il Rifugio in Cima al Dirupo entra nel campo di battaglia TAPpato a meno che tu non controlli una Montagna o una Pianura.\\n{T}: Aggiungi {R} o {W}.\', \'type\': \'Terra\', \'flavor\': \'I raggi del sole splendono immacolati sul tempio di Epityr, soffusi dal ricordo delle ombre proiettate dalle ali di angeli salvifici.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444203&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1aeef361-bcdc-42e9-8646-4a372ad7ed02\', \'multiverseId\': 444203}, \'multiverseid\': 444203}, {\'name\': \'断崖の避難所\', \'text\': \'断崖の避難所は、あなたが山か平地をコントロールしていないかぎり、タップ状態で戦場に出る。\\n{T}：{R}か{W}を加える。\', \'type\': \'土地\', \'flavor\': \'エピティアの寺院を照らす純粋な陽光は、救世天使の翼が作る影の記憶で弱まっている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444472&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'10aa76d1-57cd-4e10-bb17-e7ad3eaa181c\', \'multiverseId\': 444472}, \'multiverseid\': 444472}, {\'name\': \'절벽 위의 은거처\', \'text\': \'절벽 위의 은거처는 당신이 산이나 들을 조종하지 않으면 탭된 채로 전장에 들어온다.\\n{T}: {R} 또는 {W}를 추가한다.\', \'type\': \'대지\', \'flavor\': \'청명한 햇빛이 에피티르의 사원을 비추고, 천사같은 구원자의 날개가 드리운 기억 속 그림자가 이곳을 부드럽게 한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444741&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'edc5ce45-99b9-44e5-bf52-cf904d6ad26f\', \'multiverseId\': 444741}, \'multiverseid\': 444741}, {\'name\': \'Retiro da Falésia\', \'text\': \'Retiro da Falésia entra no campo de batalha virado, a menos que você controle uma Montanha ou uma Planície.\\n{T}: Adicione {R} ou {W}.\', \'type\': \'Terreno\', \'flavor\': \'A luz do sol incide límpida no templo em Epityr, suavizada pelas sombras que lembram as asas das salvadoras angélicas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445010&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3ed1aedf-4cd0-4da1-8e75-2519757dc193\', \'multiverseId\': 445010}, \'multiverseid\': 445010}, {\'name\': \'Убежище на Утесе\', \'text\': \'Убежище на Утесе выходит на поле битвы повернутым, если под вашим контролем нет Горы или Равнины.\\n{T}: добавьте {R} или {W}.\', \'type\': \'Земля\', \'flavor\': \'Чистый, нетронутый солнечный свет падает на храм в Эпитире. Он помнит тени крыльев ангельских спасителей — и становится мягче.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445279&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'390fce8a-a0ab-4512-92b2-7033c3a7cbb4\', \'multiverseId\': 445279}, \'multiverseid\': 445279}, {\'name\': \'崖顶修行所\', \'text\': \'除非你操控山脉或平原，否则崖顶修行所须横置进战场。\\n{T}：加{R}或{W}。\', \'type\': \'地\', \'flavor\': \'纯洁阳光洒落艾比提殿堂，穿过为人追忆的救世天使双翼而更加柔和。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445548&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bae142b9-ed81-406b-bb58-f6b9938563bd\', \'multiverseId\': 445548}, \'multiverseid\': 445548}, {\'name\': \'崖頂修行所\', \'text\': \'除非你操控山脈或平原，否則崖頂修行所須橫置進戰場。\\n{T}：加{R}或{W}。\', \'type\': \'地\', \'flavor\': \'純潔陽光灑落艾比提殿堂，穿過為人追憶的救世天使雙翼而更加柔和。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445817&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a392b1b8-0184-4c04-9cb7-0fc77398c20b\', \'multiverseId\': 445817}, \'multiverseid\': 445817}]', '[{\'name\': \'Feuerelementar\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'„Papier ist nur für die Theorie nützlich. Lass es brennen, um die Praxis zu meistern." —Jaya Ballard\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443277&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cd1ed32a-c638-489c-b254-ed7758940412\', \'multiverseId\': 443277}, \'multiverseid\': 443277}, {\'name\': \'Elemental de fuego\', \'type\': \'Criatura — Elemental\', \'flavor\': \'"La mejor forma de aprender de un libro sobre piromancia es quemándolo". —Jaya Ballard\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443546&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'547d64a3-c820-4d35-929c-7675e64841bb\', \'multiverseId\': 443546}, \'multiverseid\': 443546}, {\'name\': \'Élémental de feu\', \'type\': \'Créature : élémental\', \'flavor\': "« Le meilleur moyen de tirer les enseignements d\'un livre de pyromancie est de le brûler. » —Jaya Ballard", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443815&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d2cff634-8581-4bda-8ce7-55ef96e7b6d8\', \'multiverseId\': 443815}, \'multiverseid\': 443815}, {\'name\': \'Elementale del Fuoco\', \'type\': \'Creatura — Elementale\', \'flavor\': \'"Il modo migliore per imparare da un libro di piromanzia è bruciarlo." —Jaya Ballard\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444084&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'65e23d23-7f05-42fb-ad53-8e228b2f91cd\', \'multiverseId\': 444084}, \'multiverseid\': 444084}, {\'name\': \'炎の精霊\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'「紅蓮術を本で学びたいなら、それを燃やしてみるのが一番だね。」 ――ヤヤ・バラード\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444353&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ea27f06d-2408-489d-97e8-a9b1a952db8e\', \'multiverseId\': 444353}, \'multiverseid\': 444353}, {\'name\': \'불의 정령\', \'type\': \'생물 — 정령\', \'flavor\': \'"화염술을 책으로 배우는 가장 좋은 방법은 그 책을 태워버리는 것이다." —자야 발라드\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444622&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'fd4f7200-3333-4af0-8186-c5de2dcb8693\', \'multiverseId\': 444622}, \'multiverseid\': 444622}, {\'name\': \'Elemental do Fogo\', \'type\': \'Criatura — Elemental\', \'flavor\': \'"A melhor forma de aprender com um livro de piromancia é queimá-lo." — Jaya Ballard\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444891&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'76ebb59c-91c9-4f9a-88ca-5de2ef9d8d3b\', \'multiverseId\': 444891}, \'multiverseid\': 444891}, {\'name\': \'Огненный Элементаль\', \'type\': \'Существо — Элементаль\', \'flavor\': \'«Лучший способ научиться чему-то из трактата по пиромантии — сжечь его». — Джайя Баллард\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445160&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b3002ba2-1c89-4490-aa95-4cff08e0b645\', \'multiverseId\': 445160}, \'multiverseid\': 445160}, {\'name\': \'火元素\', \'type\': \'生物 ～元素\', \'flavor\': \'「从书本中学习烈焰术的最佳方法就是把书烧了。」 ～雅亚巴拉德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445429&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3ce1856b-781e-4380-b9ee-9e8ef6f7259d\', \'multiverseId\': 445429}, \'multiverseid\': 445429}, {\'name\': \'火元素\', \'type\': \'生物 ～元素\', \'flavor\': \'「從書本中學習烈焰術的最佳方法就是把書燒了。」 ～雅亞巴拉德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445698&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1924008e-d37b-4341-8f87-d86200ff7234\', \'multiverseId\': 445698}, \'multiverseid\': 445698}]', '[{\'name\': \'Feuerfaust-Adept\', \'text\': \'Wenn der Feuerfaust-Adept ins Spiel kommt, fügt er einer Kreatur deiner Wahl, die ein Gegner kontrolliert, X Schadenspunkte zu, wobei X gleich der Anzahl an Zauberern ist, die du kontrollierst.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'Der vielseitige „Feurige Panzerhandschuh" gehört zu den ersten Zaubersprüchen, die junge Ghitu-Magier erlernen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443278&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7d314e02-62f7-418d-80f3-39da60b5e234\', \'multiverseId\': 443278}, \'multiverseid\': 443278}, {\'name\': \'Adepto puño de fuego\', \'text\': \'Cuando el Adepto puño de fuego entre al campo de batalla, hace X puntos de daño a la criatura objetivo que controla un oponente, donde X es la cantidad de Hechiceros que controlas.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'El versátil hechizo "guantelete de fuego" es de los primeros que aprenden los jóvenes magos ghitu.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443547&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'211a5bf4-5a17-4348-8c44-583faa0546e6\', \'multiverseId\': 443547}, \'multiverseid\': 443547}, {\'name\': \'Expert Poingdefeu\', \'text\': "Quand l\'Expert Poingdefeu arrive sur le champ de bataille, il inflige X blessures à une créature ciblée qu\'un adversaire contrôle, X étant le nombre de sorciers que vous contrôlez.", \'type\': \'Créature : humain et sorcier\', \'flavor\': "Le « gant enflammé » polyvalent est l\'un des premiers sorts qu\'apprennent les jeunes mages guitûks.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443816&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'72177c26-3933-49eb-b2f2-c1f86a42a423\', \'multiverseId\': 443816}, \'multiverseid\': 443816}, {\'name\': \'Pugno Infuocato Esperto\', \'text\': \'Quando il Pugno Infuocato Esperto entra nel campo di battaglia, infligge X danni a una creatura bersaglio controllata da un avversario, dove X è il numero di Maghi che controlli.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': \'Il versatile "guanto di fuoco" è una delle prime magie che imparano i giovani maghi Ghitu.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444085&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a029c295-b571-4464-96e6-bab286a48855\', \'multiverseId\': 444085}, \'multiverseid\': 444085}, {\'name\': \'火拳の達人\', \'text\': \'火拳の達人が戦場に出たとき、対戦相手がコントロールしているクリーチャー１体を対象とする。火拳の達人はそれにＸ点のダメージを与える。Ｘはあなたがコントロールしているウィザードの総数に等しい。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'融通の利く「焦熱の篭手」は、若いギトゥの魔道士が最初に学ぶ呪文だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444354&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7edfe572-9e27-4d83-ad68-bb08b046eefe\', \'multiverseId\': 444354}, \'multiverseid\': 444354}, {\'name\': \'불주먹 숙련자\', \'text\': \'불주먹 숙련자가 전장에 들어올 때, 상대가 조종하는 생물을 목표로 정한다. 불주먹 숙련자는 그 생물에게 피해 X점을 입힌다. X는 당신이 조종하는 마법사의 수이다.\', \'type\': \'생물 — 인간 마법사\', \'flavor\': \'용도가 다양한 "불의 건틀렛"은 젊은 기투 마법사들이 초반에 배우는 주문들 중 하나이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444623&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a4cfcd18-e27c-48f0-b27a-68412b90ed8b\', \'multiverseId\': 444623}, \'multiverseid\': 444623}, {\'name\': \'Adepto Punho de Fogo\', \'text\': \'Quando Adepto Punho de Fogo entra no campo de batalha, ele causa X pontos de dano à criatura alvo que um oponente controla, sendo X o número de Magos que você controla.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'A versátil "manopla flamejante" está entre as primeiras mágicas que os jovens magos Ghitu aprendem.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444892&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'104801cb-5507-4eb5-b271-99e2beb79b57\', \'multiverseId\': 444892}, \'multiverseid\': 444892}, {\'name\': \'Адепт Огненного Кулака\', \'text\': \'Когда Адепт Огненного Кулака выходит на поле битвы, он наносит X повреждений целевому существу под контролем оппонента, где X — количество Чародеев под вашим контролем.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'У заклинания «огненная перчатка» много применений, и юные маги Гиту изучают его одним из первых.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445161&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'92358c6a-4bc8-4657-bfe3-bec80b6454e3\', \'multiverseId\': 445161}, \'multiverseid\': 445161}, {\'name\': \'烈掌专家\', \'text\': \'当烈掌专家进战场时，它向目标由对手操控的生物造成X点伤害，X为由你操控的法术师数量。\', \'type\': \'生物 ～人类／法术师\', \'flavor\': \'万用的「火热掌」是年轻基图法师最早学到的咒语之一。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445430&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'65d1adf7-7c7b-4609-9015-c839db020715\', \'multiverseId\': 445430}, \'multiverseid\': 445430}, {\'name\': \'烈掌專家\', \'text\': \'當烈掌專家進戰場時，它向目標由對手操控的生物造成X點傷害，X為由你操控的魔法師數量。\', \'type\': \'生物 ～人類／魔法師\', \'flavor\': \'萬用的「火熱掌」是年輕基圖法師最早學到的咒語之一。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445699&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d559b95b-b602-4dd7-9315-6d83b563d752\', \'multiverseId\': 445699}, \'multiverseid\': 445699}]', '[{\'name\': \'Feuerklang und Sonnenstimme\', \'text\': \'Rote Spontanzauber und Hexereien, die du kontrollierst, haben Lebensverknüpfung.\\nImmer wenn dich ein weißer Spontanzauber oder eine weiße Hexerei Lebenspunkte dazuerhalten lässt, fügen Feuerklang und Sonnenstimme einer Kreatur oder einem Spieler deiner Wahl 3 Schadenspunkte zu.\', \'type\': \'Legendäre Kreatur — Minotaurus, Kleriker\', \'flavor\': \'Hurloons Gipfel schweigen nie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445959&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fb7e5353-2b7b-419d-9333-16648ff7a38f\', \'multiverseId\': 445959}, \'multiverseid\': 445959}, {\'name\': \'Cantallama y Clamasol\', \'text\': \'Los hechizos de instantáneo y de conjuro rojos que controlas tienen la habilidad de vínculo vital.\\nSiempre que un hechizo de instantáneo o de conjuro blanco haga que ganes vidas, Cantallama y Clamasol hacen 3 puntos de daño a la criatura o jugador objetivo.\', \'type\': \'Criatura legendaria — Clérigo minotauro\', \'flavor\': \'Las cimas de Hurloon nunca están en silencio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445960&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9c7c20e6-90dc-4b95-9f7b-c9de0e5c679e\', \'multiverseId\': 445960}, \'multiverseid\': 445960}, {\'name\': \'Chantefeu et Languesoleil\', \'text\': "Les sorts d\'éphémère et de rituel rouges que vous contrôlez ont le lien de vie.\\nÀ chaque fois qu\'un sort d\'éphémère ou de rituel blanc vous fait gagner des points de vie, Chantefeu et Languesoleil infligent 3 blessures à une cible, créature ou joueur.", \'type\': \'Créature légendaire : minotaure et clerc\', \'flavor\': "Les cîmes de l\'Hurloon ne sont jamais silencieuses.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445961&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'03cd6082-5298-4b34-a106-05ef8fb1e693\', \'multiverseId\': 445961}, \'multiverseid\': 445961}, {\'name\': \'Canto di Fuoco e Oratrice del Sole\', \'text\': \'Le magie istantaneo e stregoneria rosse che controlli hanno legame vitale.\\nOgniqualvolta una magia istantaneo o stregoneria bianca ti fa guadagnare punti vita, Canto di Fuoco e Oratrice del Sole infliggono 3 danni a una creatura o a un giocatore bersaglio.\', \'type\': \'Creatura Leggendaria — Chierico Minotauro\', \'flavor\': \'Sui picchi di Hurloon non cala mai il silenzio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445962&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e523e630-823a-4249-ac4c-1969ee3cc397\', \'multiverseId\': 445962}, \'multiverseid\': 445962}, {\'name\': \'ファイアソングとサンスピーカー\', \'text\': \'あなたがコントロールしていて赤でありインスタントかソーサリーである呪文は絆魂を持つ。\\n白でありインスタントかソーサリーである呪文によりあなたがライフを得るたび、クリーチャー１体かプレイヤー１人を対象とする。ファイアソングとサンスピーカーはそれに３点のダメージを与える。\', \'type\': \'伝説のクリーチャー — ミノタウルス・クレリック\', \'flavor\': \'ハールーンの峰々が静まることはない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445963&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'121f3dc5-7898-4533-89ff-bb22c3119548\', \'multiverseId\': 445963}, \'multiverseid\': 445963}, {\'name\': \'파이어송과 선스피커\', \'text\': \'당신이 조종하는 적색 순간마법 및 집중마법 주문은 생명연결을 가진다.\\n백색 순간마법 또는 집중마법 주문이 당신에게 생명점을 얻게 할 때마다, 생물이나 플레이어를 목표로 정한다. 파이어송과 선스피커는 그 목표에게 피해 3점을 입힌다.\', \'type\': \'전설적 생물 — 미노타우로스 성직자\', \'flavor\': \'허룬의 봉우리는 결코 침묵하지 않는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445964&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5fa6255f-5ea5-4100-aca8-8da1ef2c4034\', \'multiverseId\': 445964}, \'multiverseid\': 445964}, {\'name\': \'Canção do Fogo e Voz Solar\', \'text\': \'As mágicas instantâneas e os feitiços vermelhos que você controla têm vínculo com a vida.\\nToda vez que uma mágica instantânea ou feitiço branco fizerem com que você ganhe pontos de vida, Canção do Fogo e Voz Solar causará 3 pontos de dano à criatura alvo ou ao jogador alvo.\', \'type\': \'Criatura Lendária — Minotauro Clérigo\', \'flavor\': \'Os picos de Hurloon nunca se calam.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445965&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f31918bd-1673-4f85-9fcd-488ad5de1a5d\', \'multiverseId\': 445965}, \'multiverseid\': 445965}, {\'name\': \'Песнь Огня и Голос Солнца\', \'text\': \'Красные мгновенные заклинания и заклинания волшебства под вашим контролем имеют Цепь жизни.\\nКаждый раз, когда белое мгновенное заклинание или заклинание волшебства заставляет вас получить жизни, Песнь Огня и Голос Солнца наносит 3 повреждения целевому существу или игроку.\', \'type\': \'Легендарное Существо — Минотавр Священник\', \'flavor\': \'Пики Хурлуна никогда не замолкают.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445966&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'806ea7db-0682-4d67-ad10-5776062bc4f5\', \'multiverseId\': 445966}, \'multiverseid\': 445966}, {\'name\': \'咏火与颂日\', \'text\': \'由你操控的红色瞬间与法术咒语具有系命异能。\\n每当一个白色瞬间或法术咒语让你获得生命时，咏火与颂日对目标生物或牌手造成3点伤害。\', \'type\': \'传奇生物 ～牛头怪／僧侣\', \'flavor\': \'夏浓山峰从无静寂之时。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445967&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c9b20f3e-c06f-4583-8dfb-a2da0d7f94ff\', \'multiverseId\': 445967}, \'multiverseid\': 445967}, {\'name\': \'詠火與頌日\', \'text\': \'由你操控的紅色瞬間和巫術咒語具有繫命異能。\\n每當一個白色瞬間或巫術咒語讓你獲得生命時，詠火與頌日對目標生物或玩家造成3點傷害。\', \'type\': \'傳奇生物 ～牛頭怪／僧侶\', \'flavor\': \'夏濃山峰從無靜寂之時。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445968&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'85d5b399-a6e8-4794-a354-68b27595559a\', \'multiverseId\': 445968}, \'multiverseid\': 445968}]', '[{\'name\': \'Feurige Intervention\', \'text\': \'Bestimme eines —\\n• Die Feurige Intervention fügt einer Kreatur deiner Wahl 5 Schadenspunkte zu.\\n• Zerstöre ein Artefakt deiner Wahl.\', \'type\': \'Hexerei\', \'flavor\': \'Etwas zu verbrennen, ist ganz einfach. Das richtige Ziel zu treffen, ist da schon schwerer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443275&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dea01774-6ac1-40a7-b712-6d44ddc9cfd6\', \'multiverseId\': 443275}, \'multiverseid\': 443275}, {\'name\': \'Intervención ardorosa\', \'text\': \'Elige uno:\\n• La Intervención ardorosa hace 5 puntos de daño a la criatura objetivo.\\n• Destruye el artefacto objetivo.\', \'type\': \'Conjuro\', \'flavor\': \'Quemar algo es fácil, lo difícil es elegir el objetivo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443544&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'765f9fd1-6dc6-4191-a114-0c37412149d9\', \'multiverseId\': 443544}, \'multiverseid\': 443544}, {\'name\': \'Intervention ardente\', \'text\': "Choisissez l\'un —\\n• L\'Intervention ardente inflige 5 blessures à une créature ciblée.\\n• Détruisez l\'artefact ciblé.", \'type\': \'Rituel\', \'flavor\': "Brûler quelque chose n\'est pas difficile. Choisir une cible l\'est beaucoup plus.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443813&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'28b0aa7d-189c-4415-b06b-593fb0afe05f\', \'multiverseId\': 443813}, \'multiverseid\': 443813}, {\'name\': \'Intervento Fiammante\', \'text\': "Scegli uno —\\n• L\'Intervento Fiammante infligge 5 danni a una creatura bersaglio.\\n• Distruggi un artefatto bersaglio.", \'type\': \'Stregoneria\', \'flavor\': \'Bruciare qualcosa è facile. Scegliere un bersaglio può essere molto più difficile.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444082&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0fa4209f-212c-4180-9d33-67c71d0b0330\', \'multiverseId\': 444082}, \'multiverseid\': 444082}, {\'name\': \'焦熱の介入\', \'text\': \'以下から１つを選ぶ。\\n• クリーチャー１体を対象とする。焦熱の介入はそれに５点のダメージを与える。\\n• アーティファクト１つを対象とし、それを破壊する。\', \'type\': \'ソーサリー\', \'flavor\': \'燃やすこと自体は簡単だ。対象を選ぶことの方が難しい場合もある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444351&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'12b42546-fa5a-49d7-81e6-f74850d03ff9\', \'multiverseId\': 444351}, \'multiverseid\': 444351}, {\'name\': \'불같은 개입\', \'text\': \'하나를 선택한다 —\\n• 생물을 목표로 정한다. 불같은 개입은 그 생물에게 피해 5점을 입힌다.\\n• 마법물체를 목표로 정한다. 그 마법물체를 파괴한다.\', \'type\': \'집중마법\', \'flavor\': \'뭔가를 태우는 것은 쉽다. 그러나 대상을 정하는 것은 좀 더 어려울 수 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444620&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ad505d4a-8e09-4456-b1c5-ccad8280851c\', \'multiverseId\': 444620}, \'multiverseid\': 444620}, {\'name\': \'Intervenção Flamejante\', \'text\': \'Escolha um —\\n• Intervenção Flamejante causa 5 pontos de dano à criatura alvo.\\n• Destrua o artefato alvo.\', \'type\': \'Feitiço\', \'flavor\': \'Queimar alguma coisa é fácil. Escolher um alvo pode ser mais difícil.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444889&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'33acf335-04d6-4cba-b4ff-bedaf59d125e\', \'multiverseId\': 444889}, \'multiverseid\': 444889}, {\'name\': \'Пылкое Вмешательство\', \'text\': \'Выберите одно —\\n• Пылкое Вмешательство наносит 5 повреждений целевому существу.\\n• Уничтожьте целевой артефакт.\', \'type\': \'Волшебство\', \'flavor\': \'Сжечь что-то очень просто. Выбрать цель — куда сложнее.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445158&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fbe88c6e-6b35-4c09-bd24-fb59aa72b7b4\', \'multiverseId\': 445158}, \'multiverseid\': 445158}, {\'name\': \'火热干预\', \'text\': \'选择一项～\\n•火热干预对目标生物造成5点伤害。\\n•消灭目标神器。\', \'type\': \'法术\', \'flavor\': \'烧东西不难；烧得准才难。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445427&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'46aab92e-a1c3-4870-a8a0-971c975463e1\', \'multiverseId\': 445427}, \'multiverseid\': 445427}, {\'name\': \'火熱干預\', \'text\': \'選擇一項～\\n•火熱干預對目標生物造成5點傷害。\\n•消滅目標神器。\', \'type\': \'巫術\', \'flavor\': \'燒東西不難；燒得準才難。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445696&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2bed29f2-dac1-4438-89b1-2e3083670872\', \'multiverseId\': 445696}, \'multiverseid\': 445696}]', '[{\'name\': \'Freyalises Lied\', \'text\': \'(Je eine Sagenmarke beim Ins-Spiel-Kommen und nach deinem Ziehsegment. Opfern nach III.)\\nI, II — Bis zu deinem nächsten Zug erhalten Kreaturen, die du kontrollierst „{T}: Erzeuge ein Mana einer beliebigen Farbe."\\nIII — Lege auf jede Kreatur, die du kontrollierst, eine +1/+1-Marke. Die Kreaturen erhalten Wachsamkeit, Unzerstörbarkeit und verursachen Trampelschaden bis zum Ende des Zuges.\', \'type\': \'Verzauberung — Sage\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443336&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1596f858-eba6-44e8-840c-fcb98a768579\', \'multiverseId\': 443336}, \'multiverseid\': 443336}, {\'name\': \'Canción de Freyalise\', \'text\': \'(En cuanto esta Saga entre y después de tu paso de robar, agrega un contador de sabiduría. Sacrifícala después de III.)\\nI, II — Hasta tu próximo turno, las criaturas que controlas ganan "{T}: Agrega un maná de cualquier color".\\nIII — Pon un contador +1/+1 sobre cada criatura que controlas. Esas criaturas ganan las habilidades de vigilancia, arrollar e indestructible hasta el final del turno.\', \'type\': \'Encantamiento — Saga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443605&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'701f242e-123f-4450-9601-4692a259e807\', \'multiverseId\': 443605}, \'multiverseid\': 443605}, {\'name\': \'Chant de Freyalise\', \'text\': "(Au moment où cette saga arrive sur le champ de bataille et après votre étape de pioche, ajoutez un marqueur « sapience ». Sacrifiez après III.)\\nI, II — Jusqu\'à votre prochain tour, les créatures que vous contrôlez gagnent « {T} : Ajoutez un mana de la couleur de votre choix ».\\nIII — Mettez un marqueur +1/+1 sur chaque créature que vous contrôlez. Ces créatures acquièrent la vigilance, le piétinement et l\'indestructible jusqu\'à la fin du tour.", \'type\': \'Enchantement : saga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443874&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'255ca8be-6ae5-45f1-99ca-a14687873065\', \'multiverseId\': 443874}, \'multiverseid\': 443874}, {\'name\': \'Canto di Freyalise\', \'text\': \'(Mentre questa Saga entra e dopo la tua sottofase di acquisizione, aggiungi un segnalino sapere. Sacrifica dopo III.)\\nI, II — Fino al tuo prossimo turno, le creature che controlli hanno "{T}: Aggiungi un mana di un qualsiasi colore".\\nIII — Metti un segnalino +1/+1 su ogni creatura che controlli. Quelle creature hanno cautela, travolgere e indistruttibile fino alla fine del turno.\', \'type\': \'Incantesimo — Saga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444143&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'aef53b41-9b1f-4b3b-a649-33af9d124e21\', \'multiverseId\': 444143}, \'multiverseid\': 444143}, {\'name\': \'フレイアリーズの歌\', \'text\': \'（この英雄譚が出た際とあなたのドロー・ステップの後に、伝承カウンターを１個加える。IIIの後に、生け贄に捧げる。）\\nI, II ― あなたの次のターンまで、あなたがコントロールしているクリーチャーは「{T}：好きな色１色のマナ１点を加える。」を持つ。\\nIII ― あなたがコントロールしている各クリーチャーの上に＋１/＋１カウンターをそれぞれ１個置く。ターン終了時まで、それらのクリーチャーは警戒とトランプルと破壊不能を得る。\', \'type\': \'エンチャント — 英雄譚\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444412&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9aac8795-285b-4b9b-acab-d631dbd51dbf\', \'multiverseId\': 444412}, \'multiverseid\': 444412}, {\'name\': \'프레얄리스의 노래\', \'text\': \'(이 서사시가 들어오면서 그리고 당신의 뽑기단 후에, 전승 카운터 한 개를 추가한다. III 이후에 희생한다.)\\nI, II — 당신의 다음 턴까지, 당신이 조종하는 생물들은 "{T}: 원하는 색의 마나 한 개를 추가한다."를 가진다.\\nIII — 당신이 조종하는 각 생물에 +1/+1 카운터 한 개를 올려놓는다. 그 생물들은 턴종료까지 경계, 돌진, 무적을 얻는다.\', \'type\': \'부여마법 — 서사시\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444681&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a6812d90-1f86-44f7-832d-ba61c97f5ae3\', \'multiverseId\': 444681}, \'multiverseid\': 444681}, {\'name\': \'Canção de Freyalise\', \'text\': \'(Conforme esta Saga entra e após sua etapa de compra, adicione um marcador de conhecimento. Sacrifique-a após III.)\\nI, II — Até seu próximo turno, as criaturas que você controla ganham "{T}: Adicione um mana de qualquer cor."\\nIII — Coloque um marcador +1/+1 em cada criatura que você controla. Aquelas criaturas ganham vigilância, atropelar e indestrutível até o final do turno.\', \'type\': \'Encantamento — Saga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444950&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'68bb1f86-3b94-46dc-8b3f-3f42cd1d1058\', \'multiverseId\': 444950}, \'multiverseid\': 444950}, {\'name\': \'Песнь о Фреализ\', \'text\': \'(При выходе этой Саги и после вашего шага взятия карты добавьте один жетон знаний. Пожертвуйте после III.)\\nI, II — До вашего следующего хода существа под вашим контролем получают способность «{T}: добавьте одну ману любого цвета».\\nIII — Положите один жетон +1/+1 на каждое существо под вашим контролем. Те существа получают Бдительность, Пробивной удар и Неразрушимость до конца хода.\', \'type\': \'Чары — Сага\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445219&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3afbb1bd-8495-4558-8fcb-75e63fea7a03\', \'multiverseId\': 445219}, \'multiverseid\': 445219}, {\'name\': \'妃雅丽兹颂歌\', \'text\': \'（于此传纪进战场时及于你抓牌步骤后，加一个学问指示物。到III后牺牲之。）\\nI, II — 直到你的下一个回合，由你操控的生物获得「{T}：加一点任意颜色的法术力。」\\nIII — 在每个由你操控的生物上各放置一个+1/+1指示物。这些生物获得警戒、践踏与不灭异能直到回合结束。\', \'type\': \'结界 ～传纪\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445488&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c901aaed-2a47-4d23-bbd8-dad0112f4c8b\', \'multiverseId\': 445488}, \'multiverseid\': 445488}, {\'name\': \'妃雅麗茲頌歌\', \'text\': \'（於此傳紀進戰場時及於你抽牌步驟後，加一個學問指示物。到III後犧牲之。）\\nI, II — 直到你的下一個回合，由你操控的生物獲得「{T}：加一點任意顏色的魔法力。」\\nIII — 在每個由你操控的生物上各放置一個+1/+1指示物。這些生物獲得警戒、踐踏與不滅異能直到回合結束。\', \'type\': \'結界 ～傳紀\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445757&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'490ef98a-8b31-4561-9b19-6f079186853a\', \'multiverseId\': 445757}, \'multiverseid\': 445757}]', '[{\'name\': \'Froststarre\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur hat Basis-Stärke und -Widerstandskraft 0/4, hat Verteidiger, verliert alle anderen Fähigkeiten und ist zusätzlich zu ihren anderen Farben und Typen eine blaue Mauer.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Kryomagier studieren die Eiszeit nicht nur, sie wenden das Gelernte auch praktisch an.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443207&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'90f0f4db-914e-482c-a183-fc6a9258d1e3\', \'multiverseId\': 443207}, \'multiverseid\': 443207}, {\'name\': \'Congelación total\', \'text\': \'Encantar criatura.\\nLa criatura encantada tiene una fuerza y resistencia base de 0/4, tiene la habilidad de defensor, pierde todas las demás habilidades y es un Muro azul además de sus otros colores y tipos.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'Para los criomantes, estudiar la Era Glacial no es un mero ejercicio académico.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443476&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e869244d-0ed0-4b3b-9948-8eb6ee47dcd5\', \'multiverseId\': 443476}, \'multiverseid\': 443476}, {\'name\': \'Congélation\', \'text\': \'Enchanter : créature\\nLa créature enchantée a une force et une endurance de base de 0/4, a le défenseur, perd toutes ses autres capacités, et est un mur bleu en plus de ses autres couleurs et de ses autres types.\', \'type\': \'Enchantement : aura\', \'flavor\': "Pour les cryomanciens, étudier l\'Ère glaciaire n\'est pas un simple exercice académique.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443745&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ad962757-a7af-46ed-a35e-a0aa95353ff6\', \'multiverseId\': 443745}, \'multiverseid\': 443745}, {\'name\': \'Gelo Profondo\', \'text\': \'Incanta creatura\\nLa creatura incantata ha forza e costituzione base 0/4, ha difensore, perde tutte le altre abilità ed è un Muro blu in aggiunta ai suoi altri tipi e colori.\', \'type\': \'Incantesimo — Aura\', \'flavor\': "Per i criomanti, lo studio dell\'Era Glaciale non è un puro esercizio accademico.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444014&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e7b132e7-4bdb-499b-8931-981820c95c0e\', \'multiverseId\': 444014}, \'multiverseid\': 444014}, {\'name\': \'氷結\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは、基本のパワーとタフネスが０/４になり、防衛を得るとともに他の能力をすべて失い、それの他の色やタイプに加えて青の壁でもある。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'冷術師にとって氷河期の研究は、単なる学問上の問題ではない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444283&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d94f5488-4e26-44a2-a9de-5a0b1d5dfad0\', \'multiverseId\': 444283}, \'multiverseid\': 444283}, {\'name\': \'급속 냉동\', \'text\': \'생물에게 부여\\n부여된 생물은 기본 공격력과 방어력이 0/4가 되고, 수비태세를 가지고 다른 모든 능력을 잃으며, 다른 색과 유형에 더해 청색 벽이다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'빙결술사에게 있어, 아이스 에이지를 연구하는 것은 단순한 아카데미의 활동이 아니다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444552&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0d3e7da9-de36-4838-87fa-9b47f2cfd5c1\', \'multiverseId\': 444552}, \'multiverseid\': 444552}, {\'name\': \'Congelamento Profundo\', \'text\': \'Encantar criatura\\nA criatura encantada tem poder e resistência básicos 0/4, tem defensor, perde todas as habilidades e é uma Barreira azul além de suas outras cores e tipos.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'Para os criomantes, estudar a Era Glacial não é apenas exercício acadêmico.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444821&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6d04509f-d5ef-4719-833e-4b0720271821\', \'multiverseId\': 444821}, \'multiverseid\': 444821}, {\'name\': \'Глубокая Заморозка\', \'text\': \'Зачаровать существо\\nЗачарованное существо имеет базовую силу и выносливость 0/4, имеет способность Защитника, теряет все остальные способности и является синей Стеной в дополнение к своим другим цветам и типам.\', \'type\': \'Чары — Аура\', \'flavor\': \'Для криомантов изучение ледникового периода — это не просто академические изыскания.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445090&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f404214e-ea36-428c-86f4-b10355fbeea5\', \'multiverseId\': 445090}, \'multiverseid\': 445090}, {\'name\': \'急冻深寒\', \'text\': \'结附于生物\\n所结附的生物之基础力量与防御力为0/4，具守军异能，失去所有其他异能，且额外具有蓝色此颜色与墙此类别。\', \'type\': \'结界 ～灵气\', \'flavor\': \'对凛寒术士而言，研究冰雪时代不仅仅是做学问而已。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445359&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'73c4e9f7-9d6e-4d7c-8a10-3c3d886402b3\', \'multiverseId\': 445359}, \'multiverseid\': 445359}, {\'name\': \'急凍深寒\', \'text\': \'結附於生物\\n所結附的生物之基礎力量與防禦力為0/4，具守軍異能，失去所有其他異能，且額外具有藍色此顏色與牆此類別。\', \'type\': \'結界 ～靈氣\', \'flavor\': \'對凜寒術士而言，研究冰雪時代不僅僅是做學問而已。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445628&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a1efcbe8-9095-4377-af9c-224c083cd66f\', \'multiverseId\': 445628}, \'multiverseid\': 445628}]', '[{\'name\': \'Furchteinflößender Schatten\', \'text\': \'{B}: Der Furchteinflößende Schatten erhält +1/+1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Schatten\', \'flavor\': \'„Der Wald, der einst die Vess-Ländereien umgab, wurde zum Kaligo-Morast, einem weitläufigen Sumpf, in dem sich unaussprechliche Schrecken herumtrieben." —„Der Untergang des Hauses Vess"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443245&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8c58a343-be7e-497f-baae-e804a553eaf7\', \'multiverseId\': 443245}, \'multiverseid\': 443245}, {\'name\': \'Sombra aterradora\', \'text\': \'{B}: La Sombra aterradora obtiene +1/+1 hasta el final del turno.\', \'type\': \'Criatura — Sombra\', \'flavor\': \'"El bosque que rodeaba a la hacienda de los Vess se convirtió en la ciénaga de Cáligo, un pantano inmenso habitado por horrores demasiado terribles para ser nombrados". —"La caída de la casa Vess"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443514&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'deabe2db-ce55-4975-bf77-7eb33418d242\', \'multiverseId\': 443514}, \'multiverseid\': 443514}, {\'name\': "Ombre d\'effroi", \'text\': "{B} : L\'Ombre d\'effroi gagne +1/+1 jusqu\'à la fin du tour.", \'type\': \'Créature : ombre\', \'flavor\': "« La forêt qui entourait le domaine des Vess devint le marais de Caligo, une immense tourbière peuplée d\'horreurs innommables. » —« La chute de la Maison Vess »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443783&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c289444d-754f-4b37-9dd7-04c6b42adbc4\', \'multiverseId\': 443783}, \'multiverseid\': 443783}, {\'name\': \'Ombra Terrificante\', \'text\': "{B}: L\'Ombra Terrificante prende +1/+1 fino alla fine del turno.", \'type\': \'Creatura — Ombra\', \'flavor\': \'"La foresta che circondava la tenuta dei Vess si trasformò nel Pantano di Caligo, un immenso acquitrino infestato da orrori troppo terribili per poterli nominare." —"La Caduta della Casa dei Vess"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444052&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'36fa1474-17b4-4d9e-a0a5-1537824e9cb6\', \'multiverseId\': 444052}, \'multiverseid\': 444052}, {\'name\': \'戦慄の影\', \'text\': \'{B}：ターン終了時まで、戦慄の影は＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — シェイド\', \'flavor\': \'「ヴェス家の屋敷を取り巻いていた森はカリゴ沼になった。広大な泥沼で、名を口に出すことのできない恐ろしいものがさまよっている。」 ――「ヴェス家の没落」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444321&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f4d7845b-0f4b-4ab9-b414-121a867cfb7c\', \'multiverseId\': 444321}, \'multiverseid\': 444321}, {\'name\': \'섬뜩한 그림자\', \'text\': \'{B}: 섬뜩한 그림자는 턴종료까지 +1/+1을 받는다.\', \'type\': \'생물 — 그림자\', \'flavor\': \'"베스 영지를 둘러싼 숲은 이름을 말하기조차 두려운 공포의 존재들이 도사리는 곳, 칼리고 저습지가 되었다." —"베스 가문의 몰락"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444590&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'cfa3ec2a-3719-435b-a654-f275f7d60b99\', \'multiverseId\': 444590}, \'multiverseid\': 444590}, {\'name\': \'Sombra Aterrorizante\', \'text\': \'{B}: Sombra Aterrorizante recebe +1/+1 até o final do turno.\', \'type\': \'Criatura — Sombra\', \'flavor\': \'"A floresta em torno da propriedade dos Vess tornou-se o Brejo de Caligo, um vasto pântano onde espreitam horrores inomináveis." — "A Queda da Casa de Vess"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444859&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2902f185-44d8-48df-bc41-dd8176fb3d38\', \'multiverseId\': 444859}, \'multiverseid\': 444859}, {\'name\': \'Жуткая Тень\', \'text\': \'{B}: Жуткая Тень получает +1/+1 до конца хода.\', \'type\': \'Существо — Тень\', \'flavor\': \'«Леса, окружавшие имение Вессов, превратились в трясину Калиго — бескрайнее болото, где обитали немыслимые ужасы». — «Падение дома Весс»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445128&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d1f7be5a-96b1-4db1-b63a-45a5bb3d9086\', \'multiverseId\': 445128}, \'multiverseid\': 445128}, {\'name\': \'恐惧阴魂\', \'text\': \'{B}：恐惧阴魂得+1/+1直到回合结束。\', \'type\': \'生物 ～阴魂\', \'flavor\': \'「维斯庄园周围的森林化成了卡利戈泥淖，在这一大片泽地中潜伏着人们不敢提及的惊惧兽。」 ～「维斯家族衰亡记」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445397&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'274680ea-a896-440a-80ff-82151a287dd4\', \'multiverseId\': 445397}, \'multiverseid\': 445397}, {\'name\': \'恐懼陰魂\', \'text\': \'{B}：恐懼陰魂得+1/+1直到回合結束。\', \'type\': \'生物 ～陰魂\', \'flavor\': \'「維斯莊園周圍的森林化成了卡利戈泥淖，在這一大片澤地中潛伏著人們不敢提及的驚懼獸。」 ～「維斯家族衰亡記」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445666&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2383ed33-ea77-4ca3-b10e-ba38cbb9f860\', \'multiverseId\': 445666}, \'multiverseid\': 445666}]', '[{\'name\': \'Furchtlose Leibwächterin\', \'text\': \'Sowie die Furchtlose Leibwächterin ins Spiel kommt, bestimme eine andere Kreatur, die du kontrollierst.\\nOpfere die Furchtlose Leibwächterin: Die bestimmte Kreatur erhält Unzerstörbarkeit bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': \'Benalische Adelstitel werden vererbt, doch die Ergebenheit der Untertanen ist mühsam erarbeitet.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443171&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7a6fb8ce-ebed-40b8-8298-d7db58d3423a\', \'multiverseId\': 443171}, \'multiverseid\': 443171}, {\'name\': \'Guardaespaldas intrépida\', \'text\': \'En cuanto la Guardaespaldas intrépida entre al campo de batalla, elige otra criatura que controlas.\\nSacrificar la Guardaespaldas intrépida: La criatura elegida gana la habilidad de indestructible hasta el final del turno.\', \'type\': \'Criatura — Caballero humano\', \'flavor\': \'Los títulos aristocráticos de Benalia se heredan, pero la lealtad de sus súbditos se gana.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443440&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7b9fd26f-99a4-4255-bc3b-50c84a18eaf1\', \'multiverseId\': 443440}, \'multiverseid\': 443440}, {\'name\': \'Garde du corps intrépide\', \'text\': "Au moment où la Garde du corps intrépide arrive sur le champ de bataille, choisissez une autre créature que vous contrôlez.\\nSacrifiez la Garde du corps intrépide : La créature choisie acquiert l\'indestructible jusqu\'à la fin du tour.", \'type\': \'Créature : humain et chevalier\', \'flavor\': "L\'aristocratie bénaliane est héréditaire, mais la loyauté de ses sujets doit se mériter.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443709&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b51646de-c48e-457a-be10-1f487cd8623f\', \'multiverseId\': 443709}, \'multiverseid\': 443709}, {\'name\': \'Guardia del Corpo Intrepida\', \'text\': "Mentre la Guardia del Corpo Intrepida entra nel campo di battaglia, scegli un\'altra creatura che controlli.\\nSacrifica la Guardia del Corpo Intrepida: La creatura scelta ha indistruttibile fino alla fine del turno.", \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': \'Gli aristocratici di Benalia ereditano i loro titoli, ma si guadagnano la lealtà dei loro sudditi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443978&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e782c8a8-95d6-45c8-b7af-7e80be29b132\', \'multiverseId\': 443978}, \'multiverseid\': 443978}, {\'name\': \'不屈の護衛\', \'text\': \'不屈の護衛が戦場に出るに際し、あなたがコントロールしている他のクリーチャー１体を選ぶ。\\n不屈の護衛を生け贄に捧げる：ターン終了時まで、その選ばれたクリーチャーは破壊不能を得る。\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': \'ベナリアの貴族は世襲制だが、家臣の忠誠心は自身で獲得するものだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444247&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d03caa8f-ccd9-40e6-87b0-0114db0e3996\', \'multiverseId\': 444247}, \'multiverseid\': 444247}, {\'name\': \'불굴의 경호원\', \'text\': \'불굴의 경호원이 전장에 들어오면서, 당신이 조종하는 다른 생물 한 개를 선택한다.\\n불굴의 경호원을 희생한다: 선택된 생물은 턴종료까지 무적을 얻는다.\', \'type\': \'생물 — 인간 기사\', \'flavor\': \'베날리아의 귀족 신분은 대물림되지만, 백성들의 충성은 직접 얻어야 한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444516&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3ae3ff90-1447-4317-a212-b027ddbd2104\', \'multiverseId\': 444516}, \'multiverseid\': 444516}, {\'name\': \'Guarda-costas Destemida\', \'text\': \'Conforme Guarda-costas Destemida entrar no campo de batalha, escolha outra criatura que você controla.\\nSacrifique Guarda-costas Destemida: a criatura escolhida ganha indestrutível até o final do turno.\', \'type\': \'Criatura — Humano Cavaleiro\', \'flavor\': \'A aristocracia de Benália é hereditária, mas a lealdade de seus súditos é conquistada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444785&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4d09f46f-46df-4d82-8a3b-0ea5b895e156\', \'multiverseId\': 444785}, \'multiverseid\': 444785}, {\'name\': \'Отважная Телохранительница\', \'text\': \'При выходе Отважной Телохранительницы на поле битвы выберите другое существо под вашим контролем.\\nПожертвуйте Отважную Телохранительницу: выбранное существо получает Неразрушимость до конца хода.\', \'type\': \'Существо — Человек Рыцарь\', \'flavor\': \'Титулы беналийских аристократов передаются по наследству, но верность своих подданных каждый наследник должен заслужить самостоятельно.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445054&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8187ae26-a55a-4459-afe1-cb139bf812a0\', \'multiverseId\': 445054}, \'multiverseid\': 445054}, {\'name\': \'不屈护卫\', \'text\': \'于不屈护卫进战场时，选择另一个由你操控的生物。\\n牺牲不屈护卫：该生物获得不灭异能直到回合结束。\', \'type\': \'生物 ～人类／骑士\', \'flavor\': \'宾纳里亚贵族的身份由世袭而来，但臣民的忠诚全靠本事赢取。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445323&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'069e3ad8-7226-4bbe-b59a-d0749d3ef0f3\', \'multiverseId\': 445323}, \'multiverseid\': 445323}, {\'name\': \'不屈護衛\', \'text\': \'當不屈護衛進戰場時，選擇另一個由你操控的生物。\\n犧牲不屈護衛：該生物獲得不滅異能直到回合結束。\', \'type\': \'生物 ～人類／騎士\', \'flavor\': \'賓納里亞貴族的身份由世襲而來，但臣民的忠誠全靠本事贏取。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445592&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bce5be15-816b-4ecd-9fb7-e742d2811ded\', \'multiverseId\': 445592}, \'multiverseid\': 445592}]', '[{\'name\': \'Gabe des Wachstums\', \'text\': \'Bonus {2} (Du kannst zusätzlich {2} bezahlen, sowie du diesen Zauberspruch wirkst.)\\nEnttappe eine Kreatur deiner Wahl. Sie erhält +2/+2 bis zum Ende des Zuges. Falls die Bonuskosten dieses Zauberspruchs bezahlt wurden, erhält die Kreatur stattdessen +4/+4 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443320&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a3c320eb-f355-4681-afd2-5e718d6c1e4c\', \'multiverseId\': 443320}, \'multiverseid\': 443320}, {\'name\': \'Don del crecimiento\', \'text\': \'Estímulo {2}. (Puedes pagar {2} adicionales al lanzar este hechizo.)\\nEndereza la criatura objetivo. Obtiene +2/+2 hasta el final del turno. Si este hechizo fue estimulado, en vez de eso, esa criatura obtiene +4/+4 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443589&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d94d99c7-8c75-483a-8dc0-cc97daa90790\', \'multiverseId\': 443589}, \'multiverseid\': 443589}, {\'name\': \'Don de croissance\', \'text\': "Kick {2} (Vous pouvez payer {2} supplémentaires au moment où vous lancez ce sort.)\\nDégagez la créature ciblée. Elle gagne +2/+2 jusqu\'à la fin du tour. Si ce sort a été kické, cette créature gagne +4/+4 jusqu\'à la fin du tour à la place.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443858&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e61c73c6-d62f-4068-8b6e-cc9d0816a057\', \'multiverseId\': 443858}, \'multiverseid\': 443858}, {\'name\': \'Dono della Crescita\', \'text\': \'Potenziamento {2} (Puoi pagare {2} addizionale mentre lanci questa magia.)\\nSTAPpa una creatura bersaglio. Prende +2/+2 fino alla fine del turno. Se questa magia è stata potenziata, quella creatura prende invece +4/+4 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444127&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e8f10167-5d4a-47ba-bee1-ce3ba6f2dd87\', \'multiverseId\': 444127}, \'multiverseid\': 444127}, {\'name\': \'成長の資質\', \'text\': \'キッカー{2}（あなたはこの呪文を唱えるに際し、追加で{2}を支払ってもよい。）\\nクリーチャー１体を対象とし、それをアンタップする。ターン終了時まで、それは＋２/＋２の修整を受ける。この呪文がキッカーされていたなら、代わりに、ターン終了時まで、そのクリーチャーは＋４/＋４の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444396&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8aef44af-7e79-47be-b6f7-c123c4d83e08\', \'multiverseId\': 444396}, \'multiverseid\': 444396}, {\'name\': \'성장의 선물\', \'text\': \'키커 {2} (당신은 이 주문을 발동하면서 추가로 {2}를 지불할 수 있다.)\\n생물을 목표로 정한다. 그 생물을 언탭한다. 그 생물은 턴종료까지 +2/+2를 받는다. 이 주문의 키커 비용이 지불되었다면, 그 생물은 대신 턴종료까지 +4/+4를 받는다.\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444665&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'185923fa-11ab-4389-987e-7101fccddadc\', \'multiverseId\': 444665}, \'multiverseid\': 444665}, {\'name\': \'Dádiva do Crescimento\', \'text\': \'Reforçar {2} (Você pode pagar um custo adicional de {2} ao conjurar esta mágica.)\\nDesvire a criatura alvo. Ela recebe +2/+2 até o final do turno. Se esta mágica foi reforçada, em vez disso, aquela criatura recebe +4/+4 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444934&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3878acde-8d17-4b82-a18a-5235d96b07a9\', \'multiverseId\': 444934}, \'multiverseid\': 444934}, {\'name\': \'Дар Роста\', \'text\': \'Усилитель {2} (При разыгрывании этого заклинания вы можете дополнительно заплатить {2}.)\\nРазверните целевое существо. Оно получает +2/+2 до конца хода. Если это заклинание получило Усилитель, то существо вместо этого получает +4/+4 до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445203&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4b4fcbe9-1449-4bb6-bdce-b1a59d91be60\', \'multiverseId\': 445203}, \'multiverseid\': 445203}, {\'name\': \'成长赋礼\', \'text\': \'增幅{2}（你施放此咒语时可以额外支付{2}。）\\n重置目标生物。它得+2/+2直到回合结束。如果此咒语已增幅，则改为该生物得+4/+4直到回合结束。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445472&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'40112138-e422-49d1-84bf-4acb0a03a30c\', \'multiverseId\': 445472}, \'multiverseid\': 445472}, {\'name\': \'成長賦禮\', \'text\': \'增幅{2}（你施放此咒語時可以額外支付{2}。）\\n重置目標生物。它得+2/+2直到回合結束。如果此咒語已增幅，則改為該生物得+4/+4直到回合結束。\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445741&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'300386b3-727f-4a6a-8b4d-77c331384691\', \'multiverseId\': 445741}, \'multiverseid\': 445741}]', "[{'name': 'Gaeas Beschützer', 'text': 'Gaeas Beschützer muss geblockt werden, falls möglich.', 'type': 'Kreatur — Elementarwesen, Krieger', 'flavor': 'Gaea transmutierte bereits vor langer Zeit die gefallenen Phyrexianer zu Elementarwesen, doch Yavimayas andere Bewohner beäugen sie immer noch mit Argwohn.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443319&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a5f61cee-b9d9-4c53-9647-eb588249f47c', 'multiverseId': 443319}, 'multiverseid': 443319}, {'name': 'Protector de Gaia', 'text': 'El Protector de Gaia debe ser bloqueado si se puede.', 'type': 'Criatura — Guerrero elemental', 'flavor': 'Hace mucho, Gaia transformó a los pirexianos caídos en elementales, pero el resto de habitantes de Yavimaya aún desconfía de ellos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443588&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '10a26488-74ea-4762-8486-572059b31285', 'multiverseId': 443588}, 'multiverseid': 443588}, {'name': 'Protecteur de Gaia', 'text': 'Le Protecteur de Gaia doit être bloqué si possible.', 'type': 'Créature : élémental et guerrier', 'flavor': 'Les Phyrexians morts furent transformés en élémentaux par Gaia il y a bien longtemps, mais les autres habitants de la Yavimaya les regardent toujours avec inquiétude.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443857&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'f834484e-4747-4216-8045-f7e9bc06c19d', 'multiverseId': 443857}, 'multiverseid': 443857}, {'name': 'Protettore di Gea', 'text': 'Il Protettore di Gea deve essere bloccato, se possibile.', 'type': 'Creatura — Guerriero Elementale', 'flavor': 'Gea tramutò i Phyrexian caduti in elementali molto tempo fa, ma gli altri abitanti di Yavimaya li guardano ancora con inquietudine.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444126&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '429a0e1f-06d0-42ca-8a23-93f4aed88cfb', 'multiverseId': 444126}, 'multiverseid': 444126}, {'name': 'ガイアの守護者', 'text': 'ガイアの守護者は、可能ならブロックされなければならない。', 'type': 'クリーチャー — エレメンタル・戦士', 'flavor': '堕ちたファイレクシア人は遥か昔にガイアが精霊に変えたが、ヤヴィマヤの住民は今でも不安を抱いている。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444395&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'dd586cc4-6bd6-457b-afd1-defed4f41fde', 'multiverseId': 444395}, 'multiverseid': 444395}, {'name': '가이아의 수호자', 'text': '가이아의 수호자는 가능하면 방어되어야 한다.', 'type': '생물 — 정령 전사', 'flavor': '오래 전, 몰락한 피렉시아인들은 가이아에 의해 정령으로 변하였으나, 야비마야에서 살아가는 다른 자들은 아직도 그들에 대한 불안함을 거두지 못하고 있다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444664&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '18409d3a-5ae7-4e0a-a2aa-ba9c0a1bc19a', 'multiverseId': 444664}, 'multiverseid': 444664}, {'name': 'Protetor de Gaia', 'text': 'Protetor de Gaia deve ser bloqueado se possível.', 'type': 'Criatura — Elemental Guerreiro', 'flavor': 'Os phyrexianos que tombaram há muito foram transformados em elementais por Gaia, mas os demais habitantes de Yavimaya ainda os olham com apreensão.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444933&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0916abb6-59d7-4ac5-99ff-b4160616cb2d', 'multiverseId': 444933}, 'multiverseid': 444933}, {'name': 'Защитник Геи', 'text': 'Защитник Геи должен быть заблокирован, если это возможно.', 'type': 'Существо — Элементаль Воин', 'flavor': 'Павших фирексийцев Гея давно обратила в элементалей, но другие обитатели Явимайи все равно относятся к ним с недоверием.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445202&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '91cfa343-d286-4d31-aac1-fc294daa992c', 'multiverseId': 445202}, 'multiverseid': 445202}, {'name': '盖亚守护者', 'text': '若能阻挡盖亚守护者，则必须阻挡之。', 'type': '生物 ～元素／战士', 'flavor': '盖亚很早就已将非瑞克西亚死躯转化为可利用的元素，但亚维马雅的其他居民仍无法安心接纳。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445471&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '840196b8-1650-4f90-85a6-5aaa03d5dcc7', 'multiverseId': 445471}, 'multiverseid': 445471}, {'name': '蓋亞守護者', 'text': '若能阻擋蓋亞守護者，則必須阻擋之。', 'type': '生物 ～元素／戰士', 'flavor': '蓋亞很早就已將非瑞克西亞死軀轉化為可利用的元素，但亞維馬雅的其他居民仍無法安心接納。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445740&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'a6a514ee-b6ff-49a8-8050-4299c01ac3fe', 'multiverseId': 445740}, 'multiverseid': 445740}]", '[{\'name\': \'Gaeas Segen\', \'text\': \'Ein Spieler deiner Wahl mischt bis zu drei Karten deiner Wahl aus seinem Friedhof in seine Bibliothek.\\nZiehe eine Karte.\\nWenn Gaeas Segen aus deiner Bibliothek auf deinen Friedhof gelegt wird, mische deinen Friedhof in deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443318&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ee1b27cc-b32f-42af-b24e-383b1a419d2b\', \'multiverseId\': 443318}, \'multiverseid\': 443318}, {\'name\': \'Bendición de Gaia\', \'text\': \'El jugador objetivo baraja hasta tres cartas objetivo de su cementerio en su biblioteca.\\nRoba una carta.\\nCuando la Bendición de Gaia vaya a tu cementerio desde tu biblioteca, baraja tu cementerio en tu biblioteca.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443587&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'27740f07-a3c6-4aaf-be90-1e3ed8c0a37e\', \'multiverseId\': 443587}, \'multiverseid\': 443587}, {\'name\': \'Bénédiction selon Gaia\', \'text\': "Le joueur ciblé mélange jusqu\'à trois cartes ciblées dans son cimetière dans sa bibliothèque.\\nPiochez une carte.\\nQuand la Bénédiction selon Gaia est mise dans votre cimetière depuis votre bibliothèque, mélangez votre cimetière dans votre bibliothèque.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443856&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c6e6b356-f1de-4260-a13b-a2394a8a2c06\', \'multiverseId\': 443856}, \'multiverseid\': 443856}, {\'name\': \'Benedizione di Gea\', \'text\': \'Un giocatore bersaglio rimescola nel suo grimorio fino a tre carte bersaglio dal suo cimitero.\\nPesca una carta.\\nQuando la Benedizione di Gea viene messa nel tuo cimitero dal tuo grimorio, rimescola il tuo cimitero nel tuo grimorio.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444125&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f22a4879-9da8-49a8-879c-7aabf7de55c0\', \'multiverseId\': 444125}, \'multiverseid\': 444125}, {\'name\': \'ガイアの祝福\', \'text\': \'プレイヤー１人と、そのプレイヤーの墓地からカード最大３枚を対象とする。そのプレイヤーは、それらのカードを自分のライブラリーに加えて切り直す。\\nカードを１枚引く。\\nガイアの祝福があなたのライブラリーからあなたの墓地に置かれたとき、あなたの墓地をあなたのライブラリーに加えて切り直す。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444394&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'da3d64ac-d9fa-46cc-bd5f-18704876019a\', \'multiverseId\': 444394}, \'multiverseid\': 444394}, {\'name\': \'가이아의 축복\', \'text\': \'플레이어와 그 플레이어의 무덤에 있는 카드를 최대 세 장까지 목표로 정한다. 그 플레이어는 그 카드들을 자신의 서고에 섞어 넣는다.\\n카드 한 장을 뽑는다.\\n가이아의 축복이 당신의 서고에서 당신의 무덤에 놓일 때, 당신의 무덤을 당신의 서고에 섞어 넣는다.\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444663&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'02ddecca-d7bc-49e8-b068-7f894f98b673\', \'multiverseId\': 444663}, \'multiverseid\': 444663}, {\'name\': \'Bênção de Gaia\', \'text\': \'O jogador alvo embaralha até três cards alvo do próprio cemitério no próprio grimório.\\nCompre um card.\\nQuando Bênção de Gaia for colocada no seu cemitério vinda de seu grimório, embaralhe seu cemitério no seu grimório.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444932&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ed88b1d8-0650-4be3-8cb8-35ca441e78f2\', \'multiverseId\': 444932}, \'multiverseid\': 444932}, {\'name\': \'Благословение Геи\', \'text\': \'Целевой игрок втасовывает не более трех целевых карт из своего кладбища в свою библиотеку.\\nВозьмите карту.\\nКогда Благословение Геи попадает на ваше кладбище из вашей библиотеки, втасуйте ваше кладбище в вашу библиотеку.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445201&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b14e03cb-6c34-443c-8875-1bb8353c0f3c\', \'multiverseId\': 445201}, \'multiverseid\': 445201}, {\'name\': \'盖亚的祝福\', \'text\': \'目标牌手将至多三张目标牌从其坟墓场洗入其牌库。\\n抓一张牌。\\n当盖亚的祝福从你的牌库置入你的坟墓场时，将你的坟墓场洗入你的牌库。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445470&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9a8ba241-8ee6-4f32-b979-2aebcf111d16\', \'multiverseId\': 445470}, \'multiverseid\': 445470}, {\'name\': \'蓋亞的祝福\', \'text\': \'目標玩家將至多三張目標牌從其墳墓場洗入其牌庫。\\n抽一張牌。\\n當蓋亞的祝福從你的牌庫置入你的墳墓場時，將你的墳墓場洗入你的牌庫。\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445739&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'32016fb4-e0d2-48d4-91e8-997b2a1c6834\', \'multiverseId\': 445739}, \'multiverseid\': 445739}]', '[{\'name\': \'Garna die Blutflamme\', \'text\': \'Aufblitzen\\nWenn Garna die Blutflamme ins Spiel kommt, bringe alle Kreaturenkarten aus deinem Friedhof auf deine Hand zurück, die in diesem Zug von irgendwoher dorthin gelegt wurden.\\nAndere Kreaturen, die du kontrollierst, haben Eile.\', \'type\': \'Legendäre Kreatur — Mensch, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443351&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'aa83291d-d0a8-4bd6-8f6c-d301814dd3f9\', \'multiverseId\': 443351}, \'multiverseid\': 443351}, {\'name\': \'Garna, la Llama de Sangre\', \'text\': \'Destello.\\nCuando Garna, la Llama de Sangre entre al campo de batalla, regresa a tu mano todas las cartas de criatura en tu cementerio que hayan ido allí desde cualquier lugar este turno.\\nLas otras criaturas que controlas tienen la habilidad de prisa.\', \'type\': \'Criatura legendaria — Guerrero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443620&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1eb21280-113a-423e-a0b4-baae96d22712\', \'multiverseId\': 443620}, \'multiverseid\': 443620}, {\'name\': \'Garna, la Flamme de sang\', \'text\': "Flash\\nQuand Garna, la Flamme de sang arrive sur le champ de bataille, renvoyez dans votre main toutes les cartes de créature de votre cimetière qui y ont été mises d\'où qu\'elles viennent ce tour-ci.\\nLes autres créatures que vous contrôlez ont la célérité.", \'type\': \'Créature légendaire : humain et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443889&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6cb50a91-8dc3-450e-9b1e-c893ef423f64\', \'multiverseId\': 443889}, \'multiverseid\': 443889}, {\'name\': \'Garna, dal Sangue di Fiamma\', \'text\': \'Lampo\\nQuando Garna, dal Sangue di Fiamma entra nel campo di battaglia, riprendi in mano tutte le carte creatura che sono state messe nel tuo cimitero da qualsiasi zona in questo turno.\\nLe altre creature che controlli hanno rapidità.\', \'type\': \'Creatura Leggendaria — Guerriero Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444158&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f287ffdc-510e-49c1-b068-0d2c584d0a50\', \'multiverseId\': 444158}, \'multiverseid\': 444158}, {\'name\': \'血の炎、ガルナ\', \'text\': \'瞬速\\n血の炎、ガルナが戦場に出たとき、このターンにいずれかの領域からあなたの墓地に置かれたクリーチャー・カードをすべてあなたの手札に戻す。\\nあなたがコントロールしている他のクリーチャーは速攻を持つ。\', \'type\': \'伝説のクリーチャー — 人間・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444427&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0d814e97-4ef2-449b-8102-df566da1a04a\', \'multiverseId\': 444427}, \'multiverseid\': 444427}, {\'name\': \'피불길, 가르나\', \'text\': \'섬광\\n피불길, 가르나가 전장에 들어올 때, 이번 턴에 어디에서든 당신의 무덤에 들어간 모든 생물 카드를 당신의 손으로 되돌린다.\\n당신이 조종하는 다른 생물들은 신속을 가진다.\', \'type\': \'전설적 생물 — 인간 전사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444696&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1104932d-28aa-4a93-8faf-d491409fba1e\', \'multiverseId\': 444696}, \'multiverseid\': 444696}, {\'name\': \'Garna, a Chama Sanguínea\', \'text\': \'Lampejo\\nQuando Garna, a Chama Sanguínea, entrar no campo de batalha, devolva para sua mão todos os cards de criatura em seu cemitério que tenham sido colocados lá de qualquer lugar neste turno.\\nAs outras criaturas que você controla têm ímpeto.\', \'type\': \'Criatura Lendária — Humano Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444965&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d266e26b-df72-4dae-89d3-5030b13f50eb\', \'multiverseId\': 444965}, \'multiverseid\': 444965}, {\'name\': \'Гарна, Пламя Крови\', \'text\': \'Миг\\nКогда Гарна, Пламя Крови выходит на поле битвы, верните в вашу руку все карты существ на вашем кладбище, которые попали туда откуда угодно в этом ходу.\\nДругие существа под вашим контролем имеют Ускорение.\', \'type\': \'Легендарное Существо — Человек Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445234&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f33b486b-3c3a-4d9a-93ef-6de5f3eeb6a5\', \'multiverseId\': 445234}, \'multiverseid\': 445234}, {\'name\': \'炎脉加娜\', \'text\': \'闪现\\n当炎脉加娜进战场时，将所有于本回合中从任何区域置入你坟墓场的生物牌移回你手上。\\n由你操控的其他生物具有敏捷异能。\', \'type\': \'传奇生物 ～人类／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445503&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'35a0a73e-5c8e-477e-a518-185bf7722b79\', \'multiverseId\': 445503}, \'multiverseid\': 445503}, {\'name\': \'炎脈加娜\', \'text\': \'閃現\\n當炎脈加娜進戰場時，將所有於本回合中從任何區域置入你墳墓場的生物牌移回你手上。\\n由你操控的其他生物具有敏捷異能。\', \'type\': \'傳奇生物 ～人類／戰士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445772&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0ebbdefe-196b-42ef-816d-17de1beb5fb3\', \'multiverseId\': 445772}, \'multiverseid\': 445772}]', "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443419&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'fd650b1f-2c89-41fb-b0ed-fa3482d81c85', 'multiverseId': 443419}, 'multiverseid': 443419}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443688&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '7d0886b2-74b2-40e9-a903-c35bcd4b9999', 'multiverseId': 443688}, 'multiverseid': 443688}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443957&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e29ab9f6-027e-464b-8489-1ac26be1696c', 'multiverseId': 443957}, 'multiverseid': 443957}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444226&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '2df28415-100e-4891-8584-9bdfda65b246', 'multiverseId': 444226}, 'multiverseid': 444226}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444495&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '8333f4d4-541c-4d2c-84f7-eff4eb3aa0e5', 'multiverseId': 444495}, 'multiverseid': 444495}, {'name': '산', 'type': '기본 대지 — 산', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444764&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '23b1a64b-bbcf-4adc-812e-59c8bcfefe02', 'multiverseId': 444764}, 'multiverseid': 444764}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445033&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '31732db8-f668-4701-a74b-537ce747dc6a', 'multiverseId': 445033}, 'multiverseid': 445033}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445302&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '3d33e791-1cc3-4120-a841-471280c6b45c', 'multiverseId': 445302}, 'multiverseid': 445302}, {'name': '山脉', 'type': '基本地 ～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445571&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'e26ba836-84e6-4d17-9840-ec74d90370e8', 'multiverseId': 445571}, 'multiverseid': 445571}, {'name': '山脈', 'type': '基本地 ～山脈', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445840&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '0e2deada-fa88-4428-a4d4-9607c837d956', 'multiverseId': 445840}, 'multiverseid': 445840}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443420&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2f6f0054-cd87-4188-9b55-93d45d55c0f4', 'multiverseId': 443420}, 'multiverseid': 443420}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443689&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5bae8770-aaa1-44c5-bee8-42d86b187c7d', 'multiverseId': 443689}, 'multiverseid': 443689}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443958&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2b6c83fa-b3ce-4ba9-843d-06c334a06806', 'multiverseId': 443958}, 'multiverseid': 443958}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444227&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '7a79513a-f94c-4ef6-96ac-073d5dafd3bb', 'multiverseId': 444227}, 'multiverseid': 444227}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444496&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'eb4ce755-22b8-4391-8def-8d5f2a865009', 'multiverseId': 444496}, 'multiverseid': 444496}, {'name': '산', 'type': '기본 대지 — 산', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444765&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '9f89bacd-b162-4a2