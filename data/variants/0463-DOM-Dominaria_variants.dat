m/Handlers/Image.ashx?multiverseid=445838&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '3a2ba90a-8d4c-497a-8af9-4ffec9ae45d5', 'multiverseId': 445838}, 'multiverseid': 445838}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443418&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f63030c0-abbb-4219-851f-331fdf2d8edc', 'multiverseId': 443418}, 'multiverseid': 443418}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443687&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'f83c9ee3-cd2c-4292-93f6-b13d27cf04af', 'multiverseId': 443687}, 'multiverseid': 443687}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443956&type=card', 'language': 'French', 'identifiers': {'scryfallId': '0bf3886c-bc2a-485a-9bad-bfc341a1ab51', 'multiverseId': 443956}, 'multiverseid': 443956}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444225&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '39418871-33fe-4c57-a258-6324410dc42d', 'multiverseId': 444225}, 'multiverseid': 444225}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444494&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'e555a570-6710-4b8f-9fcb-7d57525b61b7', 'multiverseId': 444494}, 'multiverseid': 444494}, {'name': '늪', 'type': '기본 대지 — 늪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444763&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '548eb478-a619-42b3-af14-1cc5ea3a2afa', 'multiverseId': 444763}, 'multiverseid': 444763}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445032&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c9addc8c-4f1d-4652-9c88-cde09b842e3d', 'multiverseId': 445032}, 'multiverseid': 445032}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445301&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '54aeb7b8-b5cc-4d17-88f3-c62fde7d2c84', 'multiverseId': 445301}, 'multiverseid': 445301}, {'name': '沼泽', 'type': '基本地 ～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445570&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '1b1cf748-0987-44df-85c5-9ea0b61dbe54', 'multiverseId': 445570}, 'multiverseid': 445570}, {'name': '沼澤', 'type': '基本地 ～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445839&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '87a1b809-6dc5-4cd6-b965-de541485e4f4', 'multiverseId': 445839}, 'multiverseid': 445839}]", '[{\'name\': \'Tafelberg-Einhorn\', \'text\': \'Lebensverknüpfung\', \'type\': \'Kreatur — Einhorn\', \'flavor\': \'Die Einhörner von Sursi sind die Manifestation von Serras Freude und Hingabe. Sie springen freudig umher und bieten jedem ihren Segen an, der ihnen begegnet.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443184&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3ffffc6f-4a09-427b-8ddb-dfc577a70fe6\', \'multiverseId\': 443184}, \'multiverseid\': 443184}, {\'name\': \'Unicornio de la meseta\', \'text\': \'Vínculo vital.\', \'type\': \'Criatura — Unicornio\', \'flavor\': \'Los unicornios de Sursi son una manifestación del júbilo y la compasión de Serra. Brincan y retozan como niños y ofrecen su bendición a todo aquel que se encuentran.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443453&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'35a1b380-d681-4af7-9f3c-dc2d4837066b\', \'multiverseId\': 443453}, \'multiverseid\': 443453}, {\'name\': \'Licorne de mesa\', \'text\': \'Lien de vie\', \'type\': \'Créature : licorne\', \'flavor\': "Les licornes de Sursi sont une manifestation de la joie et de la compassion de Serra. Elles s\'ébattent et dansent comme des enfants, offrant leur bénédiction à tout ceux qu\'elles croisent.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443722&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'658573c3-888b-471a-a731-5ec08a650c95\', \'multiverseId\': 443722}, \'multiverseid\': 443722}, {\'name\': \'Unicorno della Mesa\', \'text\': \'Legame vitale\', \'type\': \'Creatura — Unicorno\', \'flavor\': \'Gli unicorni di Sursi sono una manifestazione della gioia e della compassione di Serra. Saltano e danzano come bambini, offrendo benedizioni a chiunque incontrino.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443991&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'592669d6-3e8e-4123-b184-e696e40f6073\', \'multiverseId\': 443991}, \'multiverseid\': 443991}, {\'name\': \'メサ・ユニコーン\', \'text\': \'絆魂\', \'type\': \'クリーチャー — ユニコーン\', \'flavor\': \'サーシのユニコーンはセラの喜びと慈悲を体現している。子供のように浮かれて踊り、出会う人々すべてに祝福を与える。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444260&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c8d446e4-4718-495f-8283-55fd575333f4\', \'multiverseId\': 444260}, \'multiverseid\': 444260}, {\'name\': \'메사 유니콘\', \'text\': \'생명연결\', \'type\': \'생물 — 유니콘\', \'flavor\': \'수르시의 유니콘들은 세라의 기쁨과 연민이 실체화된 존재이다. 이들은 어린이처럼 즐겁게 뛰놀고 춤을 추며, 마주하는 모든 이들을 축복한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444529&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'13f15002-8dc4-45a3-ac1d-cf3a386156b8\', \'multiverseId\': 444529}, \'multiverseid\': 444529}, {\'name\': \'Unicórnio da Meseta\', \'text\': \'Vínculo com a vida\', \'type\': \'Criatura — Unicórnio\', \'flavor\': \'Os unicórnios de Sursi são uma manifestação da alegria e da compaixão de Serra. Eles brincam e dançam como crianças, ofertando bênçãos a quem quer que encontrem.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444798&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c670e474-f67f-4114-9a9a-4b04d5059a3b\', \'multiverseId\': 444798}, \'multiverseid\': 444798}, {\'name\': \'Единорог Плоскогорья\', \'text\': \'Цепь жизни\', \'type\': \'Существо — Единорог\', \'flavor\': \'В единорогах Сурси воплотились радость и сопереживание Серры. Они резвятся и пляшут, словно дети, и одаряют своими благословениями всякого, кто им повстречается.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445067&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4588b407-16e4-4996-b530-28d589a32a58\', \'multiverseId\': 445067}, \'multiverseid\': 445067}, {\'name\': \'台地独角兽\', \'text\': \'系命\', \'type\': \'生物 ～独角兽\', \'flavor\': \'苏西独角兽是撒拉喜乐与怜悯的具现。它们像孩童般嬉闹跳舞，为遇到的所有人献上祝福。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445336&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'02137562-48c7-4c83-b1c1-6e53e1e6ad99\', \'multiverseId\': 445336}, \'multiverseid\': 445336}, {\'name\': \'台地獨角獸\', \'text\': \'繫命\', \'type\': \'生物 ～獨角獸\', \'flavor\': \'蘇西獨角獸是撒拉喜樂與憐憫的具現。牠們像孩童般嬉鬧跳舞，為遇到的所有人獻上祝福。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445605&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5a234a45-ec48-42d8-91f8-7ee7eafef3ab\', \'multiverseId\': 445605}, \'multiverseid\': 445605}]', '[{\'name\': \'Tatyova, Benthische Druidin\', \'text\': \'Immer wenn ein Land unter deiner Kontrolle ins Spiel kommt, erhältst du 1 Lebenspunkt dazu und ziehst eine Karte.\', \'type\': \'Legendäre Kreatur — Meervolk, Druide\', \'flavor\': \'„Yavimaya ist ein Wesen, bestehend aus raschelnden Blättern, tiefen Wurzeln und tierischen Lauten, und ich bin Teil davon."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443363&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6ad3448c-a6b0-4842-b6a8-8441337f090c\', \'multiverseId\': 443363}, \'multiverseid\': 443363}, {\'name\': \'Tatyova, druida bentónica\', \'text\': \'Siempre que una tierra entre al campo de batalla bajo tu control, ganas 1 vida y robas una carta.\', \'type\': \'Criatura legendaria — Druida tritón\', \'flavor\': \'"Yavimaya es un solo ser: una extensión vasta de hojas ondulantes, una capa profunda de raíces y el murmullo continuo de los animales. Y parte de ese ser soy yo".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443632&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'669fabb7-026b-4ca5-878e-0a7b197f9a58\', \'multiverseId\': 443632}, \'multiverseid\': 443632}, {\'name\': \'Tatyova, druidesse benthique\', \'text\': "À chaque fois qu\'un terrain arrive sur le champ de bataille sous votre contrôle, vous gagnez 1 point de vie et vous piochez une carte.", \'type\': \'Créature légendaire : ondin et druide\', \'flavor\': "« La Yavimaya est un être, une immensité de feuilles ondulantes, une infinité de racines et un concert d\'animaux, dont je fais partie. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443901&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dd24b702-5d2c-427f-ab97-8368481737d6\', \'multiverseId\': 443901}, \'multiverseid\': 443901}, {\'name\': \'Tatyova, Druida delle Profondità\', \'text\': \'Ogniqualvolta una terra entra nel campo di battaglia sotto il tuo controllo, guadagni 1 punto vita e peschi una carta.\', \'type\': \'Creatura Leggendaria — Druido Tritone\', \'flavor\': \'"Yavimaya è un solo essere: un\\\'unica vastità di foglie frementi, un\\\'unica profondità di radici e un unico brusio di animali, di cui io sono una parte."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444170&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'889e0e8c-286d-4110-b4b3-3c2e7986a824\', \'multiverseId\': 444170}, \'multiverseid\': 444170}, {\'name\': \'水底のドルイド、タトヨヴァ\', \'text\': \'土地が１つあなたのコントロール下で戦場に出るたび、あなたは１点のライフを得てカードを１枚引く。\', \'type\': \'伝説のクリーチャー — マーフォーク・ドルイド\', \'flavor\': \'「ヤヴィマヤの全体が一つの存在なのよ。葉が落ちる広大な場も一つ、根が張る深い土も一つ、動物の鳴き声も一つ。私もその一部だわ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444439&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c859bc6a-3823-404b-a401-4c3705d4370a\', \'multiverseId\': 444439}, \'multiverseid\': 444439}, {\'name\': \'해저의 드루이드, 타티오바\', \'text\': \'대지가 당신의 조종하에 전장에 들어올 때마다, 당신은 생명 1점을 얻고 카드 한 장을 뽑는다.\', \'type\': \'전설적 생물 — 인어 드루이드\', \'flavor\': \'"야비마야는 하나의 존재—퍼져가는 잎사귀 같은 하나의 광활함, 뿌리와 같은 하나의 깊음, 동물들이 내뱉는 하나의 재잘거림이다. 그리고 나도 그 일부이다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444708&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b780d10f-0428-4673-8e8d-398716fce013\', \'multiverseId\': 444708}, \'multiverseid\': 444708}, {\'name\': \'Tatyova, Druida Bêntica\', \'text\': \'Toda vez que um terreno entra no campo de batalha sob seu controle, você ganha 1 ponto de vida e compra um card.\', \'type\': \'Criatura Lendária — Tritão Druida\', \'flavor\': \'"Yavimaya é um único ser — uma única vastidão de folhas farfalhantes, uma única profundeza de raízes e uma única algazarra de animais — do qual eu sou uma parte."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444977&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'184a2772-f611-4d24-b65a-d43f91523ca1\', \'multiverseId\': 444977}, \'multiverseid\': 444977}, {\'name\': \'Татиова, Глубоководный Друид\', \'text\': \'Каждый раз, когда земля выходит на поле битвы под вашим контролем, вы получаете 1 жизнь и берете карту.\', \'type\': \'Легендарное Существо — Мерфолк Друид\', \'flavor\': \'«Явимайя — это единое существо. Единое бескрайнее море дрожащих листьев, единое переплетение уходящих вглубь корней, единый хор звериных голосов, и я — его часть».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445246&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bad71987-8d6a-4488-94b7-40b618f99de6\', \'multiverseId\': 445246}, \'multiverseid\': 445246}, {\'name\': \'深洋德鲁伊塔托娃\', \'text\': \'每当一个地在你的操控下进战场时，你获得1点生命且抓一张牌。\', \'type\': \'传奇生物 ～人鱼／德鲁伊\', \'flavor\': \'「亚维马雅本身即是一个活体～一片无际叶脉波澜，一组纵深树木繁根，一群喧嚣动物嘶吼～而我也是其中之一。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445515&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6c500605-edf1-46ec-bc9b-77db261fb21c\', \'multiverseId\': 445515}, \'multiverseid\': 445515}, {\'name\': \'深洋德魯伊塔托娃\', \'text\': \'每當一個地在你的操控下進戰場時，你獲得1點生命且抽一張牌。\', \'type\': \'傳奇生物 ～人魚／德魯伊\', \'flavor\': \'「亞維馬雅本身即是一個活體～一片無際葉脈波瀾，一組縱深樹木繁根，一群喧囂動物嘶吼～而我也是其中之一。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445784&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'49125950-24db-4247-8396-85f16e2ab965\', \'multiverseId\': 445784}, \'multiverseid\': 445784}]', '[{\'name\': \'Teferi der Zeitformer\', \'text\': \'+2: Enttappe bis zu ein Artefakt oder eine Kreatur deiner Wahl.\\n—3: Du erhältst 2 Lebenspunkte dazu und ziehst zwei Karten.\\n—9: Du erhältst nach diesem Zug einen zusätzlichen Zug.\', \'type\': \'Legendärer Planeswalker — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445858&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fc926eb4-8d1d-4a73-9479-505e6a470c49\', \'multiverseId\': 445858}, \'multiverseid\': 445858}, {\'name\': \'Teferi, el Tuercetiempo\', \'text\': \'+2: Endereza hasta un artefacto o criatura objetivo.\\n−3: Ganas 2 vidas y robas dos cartas.\\n−9: Juega un turno adicional después de este.\', \'type\': \'Planeswalker legendario — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445868&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d83092fd-ea84-4f89-b7e7-3d7343208550\', \'multiverseId\': 445868}, \'multiverseid\': 445868}, {\'name\': \'Téfeiri, plieur de temps\', \'text\': "+2 : Dégagez jusqu\'à un artefact ciblé ou jusqu\'à une créature ciblée.\\n-3 : Vous gagnez 2 points de vie et vous piochez deux cartes.\\n-9 : Jouez un tour supplémentaire après celui-ci.", \'type\': \'Planeswalker légendaire : Téfeiri\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445878&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b524bdce-b339-42b2-84bd-a2e8000c8679\', \'multiverseId\': 445878}, \'multiverseid\': 445878}, {\'name\': \'Teferi, Distorsore Temporale\', \'text\': \'+2: STAPpa fino a un artefatto o a una creatura bersaglio.\\n-3: Guadagni 2 punti vita e peschi due carte.\\n-9: Gioca un turno extra dopo questo.\', \'type\': \'Planeswalker Leggendario — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445888&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7f29d7d5-6da1-484f-bef9-4e08c3cee865\', \'multiverseId\': 445888}, \'multiverseid\': 445888}, {\'name\': \'時を曲げる者、テフェリー\', \'text\': \'+2：アーティファクトやクリーチャーあわせて最大１つを対象とし、それをアンタップする。\\n-3：あなたは２点のライフを得て、カードを２枚引く。\\n-9：このターンに続いて追加の１ターンを行う。\', \'type\': \'伝説のプレインズウォーカー — テフェリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445898&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3aaee069-bd92-4afa-b2b6-bccb6aa61381\', \'multiverseId\': 445898}, \'multiverseid\': 445898}, {\'name\': \'시간조종자, 테페리\', \'text\': \'+2: 마법물체나 생물을 최대 한 개까지 목표로 정한다. 그 목표를 언탭한다.\\n-3: 당신은 생명 2점을 얻고 카드 두 장을 뽑는다.\\n-9: 이번 턴 후에 추가로 턴을 얻는다.\', \'type\': \'전설적 플레인즈워커 — 테페리\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445908&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'518ab00c-5db5-4fe0-adba-614cbff6b15a\', \'multiverseId\': 445908}, \'multiverseid\': 445908}, {\'name\': \'Teferi, Subjugador do Tempo\', \'text\': \'+2: Desvire até um artefato ou criatura alvo.\\n−3: Você ganha 2 pontos de vida e compra dois cards.\\n−9: Jogue um turno extra depois deste.\', \'type\': \'Planeswalker Lendário — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445918&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'65af4385-ed2e-4bf9-ae61-6004a33db2ae\', \'multiverseId\': 445918}, \'multiverseid\': 445918}, {\'name\': \'Тефери, Сотрясатель Времен\', \'text\': \'+2: разверните не более одного целевого артефакта или существа.\\n−3: вы получаете 2 жизни и берете две карты.\\n−9: сделайте дополнительный ход вслед за этим.\', \'type\': \'Легендарный Planeswalker — Тефери\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445928&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8122a654-a721-4599-b3bc-80c5a2a5078c\', \'multiverseId\': 445928}, \'multiverseid\': 445928}, {\'name\': \'曲时大师泰菲力\', \'text\': \'+2：重置至多一个目标神器或生物。\\n−3：你获得2点生命且抓两张牌。\\n−9：于本回合后进行额外的一个回合。\', \'type\': \'传奇鹏洛客 ～泰菲力\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445938&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4484d58c-76b6-4141-8a38-2a08aba67a2e\', \'multiverseId\': 445938}, \'multiverseid\': 445938}, {\'name\': \'曲時大師泰菲力\', \'text\': \'+2：重置至多一個目標神器或生物。\\n−3：你獲得2點生命且抽兩張牌。\\n−9：於本回合後進行額外的一個回合。\', \'type\': \'傳奇鵬洛客 ～泰菲力\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445948&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ad7ad913-81fe-4823-8d6a-041dd0368ffb\', \'multiverseId\': 445948}, \'multiverseid\': 445948}]', '[{\'name\': \'Teferi, Held Dominarias\', \'text\': \'+1: Ziehe eine Karte. Enttappe zu Beginn des nächsten Endsegments zwei Länder.\\n−3: Lege eine bleibende Karte deiner Wahl, die kein Land ist, als dritte Karte von oben in die Bibliothek ihres Besitzers.\\n−8: Du erhältst ein Emblem mit „Immer wenn du eine Karte ziehst, schicke eine bleibende Karte deiner Wahl, die ein Gegner kontrolliert, ins Exil."\', \'type\': \'Legendärer Planeswalker — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443364&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fc739eb9-eb7f-42bf-85a7-02538730de8c\', \'multiverseId\': 443364}, \'multiverseid\': 443364}, {\'name\': \'Teferi, héroe de Dominaria\', \'text\': \'+1: Roba una carta. Al comienzo del próximo paso final, endereza dos tierras.\\n−3: Pon el permanente objetivo que no sea tierra en la biblioteca de su propietario en tercer lugar desde la parte superior.\\n−8: Obtienes un emblema con "Siempre que robes una carta, exilia el permanente objetivo que controla un oponente".\', \'type\': \'Planeswalker legendario — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443633&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'04aa1a27-683a-47e6-ac36-d7e8bc339fb0\', \'multiverseId\': 443633}, \'multiverseid\': 443633}, {\'name\': \'Téfeiri, héros de Dominaria\', \'text\': "+1 : Piochez une carte. Au début de la prochaine étape de fin, dégagez deux terrains.\\n-3 : Mettez un permanent non-terrain ciblé dans la bibliothèque de son propriétaire en troisième position à partir du dessus.\\n-8 : Vous gagnez un emblème avec « À chaque fois que vous piochez une carte, exilez le permanent ciblé qu\'un adversaire contrôle. »", \'type\': \'Planeswalker légendaire : Téfeiri\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443902&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8b79031b-af7e-4d20-b525-2d23adc6606a\', \'multiverseId\': 443902}, \'multiverseid\': 443902}, {\'name\': \'Teferi, Eroe di Dominaria\', \'text\': \'+1: Pesca una carta. All\\\'inizio della prossima sottofase finale, STAPpa due terre.\\n-3: Metti un permanente non terra bersaglio nel grimorio del suo proprietario come terza carta.\\n-8: Ottieni un emblema con "Ogniqualvolta peschi una carta, esilia un permanente bersaglio controllato da un avversario".\', \'type\': \'Planeswalker Leggendario — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444171&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f2f5a17e-523d-47d2-9026-b06b60b64208\', \'multiverseId\': 444171}, \'multiverseid\': 444171}, {\'name\': \'ドミナリアの英雄、テフェリー\', \'text\': \'+1：カードを１枚引く。次の終了ステップの開始時に、土地２つをアンタップする。\\n-3：土地でないパーマネント１つを対象とし、それをオーナーのライブラリーの一番上から３枚目に置く。\\n-8：あなたは「あなたがカードを１枚引くたび、対戦相手がコントロールしているパーマネント１つを対象とし、それを追放する。」を持つ紋章を得る。\', \'type\': \'伝説のプレインズウォーカー — テフェリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444440&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6bf250f9-e404-4bd7-8b3d-f6e2ad269df3\', \'multiverseId\': 444440}, \'multiverseid\': 444440}, {\'name\': \'도미나리아의 영웅, 테페리\', \'text\': \'+1: 카드 한 장을 뽑는다. 다음 종료단 시작에, 대지 두 개를 언탭한다.\\n−3: 대지가 아닌 지속물을 목표로 정한다. 그 지속물을 소유자의 서고 맨 위에서 세 번째에 넣는다.\\n−8: 당신은 "당신이 카드를 뽑을 때마다, 상대가 조종하는 지속물을 목표로 정한다. 그 지속물을 추방한다."를 가진 휘장을 얻는다.\', \'type\': \'전설적 플레인즈워커 — 테페리\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444709&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'46a22455-7aa9-4b3f-b474-d6966da938b5\', \'multiverseId\': 444709}, \'multiverseid\': 444709}, {\'name\': \'Teferi, Herói de Dominária\', \'text\': \'+1: Compre um card. No início da próxima etapa final, desvire dois terrenos.\\n−3: Coloque a permanente alvo que não seja um terreno no grimório do seu dono na terceira posição do topo.\\n−8: Você recebe um emblema com "Toda vez que você comprar um card, exile a permanente alvo que um oponente controla.".\', \'type\': \'Planeswalker Lendário — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444978&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f51ed089-22ab-4dc0-b77d-940171506912\', \'multiverseId\': 444978}, \'multiverseid\': 444978}, {\'name\': \'Тефери, Герой Доминарии\', \'text\': \'+1: возьмите карту. В начале следующего заключительного шага разверните две земли.\\n−3: положите целевой не являющийся землей перманент в библиотеку его владельца третьим сверху.\\n—8: вы получаете эмблему со способностью «Каждый раз, когда вы берете карту, изгоните целевой перманент под контролем оппонента».\', \'type\': \'Легендарный Planeswalker — Тефери\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445247&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7dce9390-bdfa-41fc-8fe2-ed652d88e9f1\', \'multiverseId\': 445247}, \'multiverseid\': 445247}, {\'name\': \'多明纳里亚英雄泰菲力\', \'text\': \'+1：抓一张牌。在下一个结束步骤开始时，重置两个地。\\n−3：将目标非地永久物置于其拥有者的牌库顶数来第三张的位置。\\n−8：你获得具有「每当你抓一张牌时，放逐目标由对手操控的永久物」的徽记。\', \'type\': \'传奇鹏洛客 ～泰菲力\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445516&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'41a74fac-acce-4920-9e13-72fbd207a77f\', \'multiverseId\': 445516}, \'multiverseid\': 445516}, {\'name\': \'多明納里亞英雄泰菲力\', \'text\': \'+1：抽一張牌。在下一個結束步驟開始時，重置兩個地。\\n−3：將目標非地永久物置於其擁有者的牌庫頂數來第三張的位置。\\n-8：你獲得具有「每當你抽一張牌時，放逐目標由對手操控的永久物」的徽記。\', \'type\': \'傳奇鵬洛客 ～泰菲力\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445785&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2bf63a80-523c-40a9-a065-f1f257e24230\', \'multiverseId\': 445785}, \'multiverseid\': 445785}]', '[{\'name\': \'Teferis Eid\', \'text\': \'Wenn Teferis Eid ins Spiel kommt, schicke eine andere bleibende Karte deiner Wahl, die du kontrollierst, ins Exil. Bringe sie zu Beginn des nächsten Endsegments unter der Kontrolle ihres Besitzers ins Spiel zurück.\\nDu kannst zweimal pro Zug Loyalitätsfähigkeiten von Planeswalkern, die du kontrollierst, aktivieren, anstatt nur einmal.\', \'type\': \'Legendäre Verzauberung\', \'flavor\': \'„Für die Verlorenen und Vergessenen werde ich Wache halten."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443357&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ee5644fd-b9d0-47fe-82ce-cf3d33354cec\', \'multiverseId\': 443357}, \'multiverseid\': 443357}, {\'name\': \'Juramento de Teferi\', \'text\': \'Cuando el Juramento de Teferi entre al campo de batalla, exilia otro permanente objetivo que controlas. Regrésalo al campo de batalla bajo el control de su propietario al comienzo del próximo paso final.\\nPuedes activar las habilidades de lealtad de los planeswalkers que controlas dos veces por turno, en vez de una sola vez por turno.\', \'type\': \'Encantamiento legendario\', \'flavor\': \'"Por los perdidos y los olvidados, mantendré la guardia".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443626&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1cd5f491-d5f5-4829-91b3-77a56384ef3a\', \'multiverseId\': 443626}, \'multiverseid\': 443626}, {\'name\': \'Serment de Téfeiri\', \'text\': "Quand le Serment de Téfeiri arrive sur le champ de bataille, exilez un autre permanent ciblé que vous contrôlez. Renvoyez-le sur le champ de bataille sous le contrôle de son propriétaire au début de la prochaine étape de fin.\\nVous pouvez activer les capacités de loyauté des planeswalkers que vous contrôlez deux fois par tour à la place d\'une fois.", \'type\': \'Enchantement légendaire\', \'flavor\': \'« Pour ce qui a été perdu et oublié, je me ferai sentinelle. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443895&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6f75802f-1f79-47e2-81a0-70424c552862\', \'multiverseId\': 443895}, \'multiverseid\': 443895}, {\'name\': \'Giuramento di Teferi\', \'text\': "Quando il Giuramento di Teferi entra nel campo di battaglia, esilia un altro permanente bersaglio che controlli. Rimettilo sul campo di battaglia sotto il controllo del suo proprietario all\'inizio della prossima sottofase finale.\\nPuoi attivare le abilità di fedeltà dei planeswalker che controlli due volte per turno invece che solo una.", \'type\': \'Incantesimo Leggendario\', \'flavor\': \'"Per i perduti e i dimenticati, sarò un guardiano."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444164&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5555bbe6-c5be-4b01-af33-451ad127e015\', \'multiverseId\': 444164}, \'multiverseid\': 444164}, {\'name\': \'テフェリーの誓い\', \'text\': \'テフェリーの誓いが戦場に出たとき、あなたがコントロールしている他のパーマネント１つを対象とし、それを追放する。次の終了ステップの開始時に、それをオーナーのコントロール下で戦場に戻す。\\n各ターン、あなたは、あなたがコントロールしているプレインズウォーカーの忠誠度能力を、１回のみではなく２回起動してもよい。\', \'type\': \'伝説のエンチャント\', \'flavor\': \'「失われ忘れられた者たちのため、私はゲートウォッチとなる。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444433&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'18d15d1d-a905-4ddf-a1ab-32fb945c50f6\', \'multiverseId\': 444433}, \'multiverseid\': 444433}, {\'name\': \'테페리의 맹세\', \'text\': \'테페리의 맹세가 전장에 들어올 때, 당신이 조종하는 다른 지속물을 목표로 정한다. 그 지속물을 추방한다. 다음 종료단 시작에 그 지속물을 소유자의 조종하에 전장으로 되돌린다.\\n당신은 당신이 조종하는 플레인즈워커의 충성 능력을 한 턴에 한 번이 아닌 두 번씩 활성화할 수 있다.\', \'type\': \'전설적 부여마법\', \'flavor\': \'"길 잃고 잊혀진 자들을 위해, 계속 수호하겠네."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444702&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a8ac4360-eb33-4e96-ae9d-e516ce1a339a\', \'multiverseId\': 444702}, \'multiverseid\': 444702}, {\'name\': \'Juramento de Teferi\', \'text\': \'Quando Juramento de Teferi entrar no campo de batalha, exile outra permanente alvo que você controla. Devolva-a ao campo de batalha sob o controle de seu dono no início da próxima etapa final.\\nVocê pode ativar as habilidades de lealdade dos planeswalkers que você controla duas vezes por turno em vez de uma.\', \'type\': \'Encantamento Lendário\', \'flavor\': \'"Pelos perdidos e esquecidos, eu serei uma sentinela."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444971&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'64332740-1ef9-4bdd-bb30-d6e7d362da7a\', \'multiverseId\': 444971}, \'multiverseid\': 444971}, {\'name\': \'Клятва Тефери\', \'text\': \'Когда Клятва Тефери выходит на поле битвы, изгоните другой целевой перманент под вашим контролем. Верните его на поле битвы под контролем его владельца в начале следующего заключительного шага.\\nВы можете активировать способности верности planeswalker-ов под вашим контролем дважды в каждом ходу, а не один раз.\', \'type\': \'Легендарные Чары\', \'flavor\': \'«Ради забытых и потерянных — я буду нести стражу».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445240&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'777c5ae3-89ee-4378-8430-522a60b154bf\', \'multiverseId\': 445240}, \'multiverseid\': 445240}, {\'name\': \'泰菲力的誓约\', \'text\': \'当泰菲力的誓约进战场时，放逐另一个目标由你操控的永久物。在下一个结束步骤开始时，将它在其拥有者的操控下移回战场。\\n你每回合可以起动由你操控之鹏洛客的忠诚异能两次，而不是只能起动一次。\', \'type\': \'传奇结界\', \'flavor\': \'「为了失去的与遗忘的，我将挚诚守护。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445509&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'184acc1e-e927-4946-90f6-a8b76f178bf6\', \'multiverseId\': 445509}, \'multiverseid\': 445509}, {\'name\': \'泰菲力的誓約\', \'text\': \'當泰菲力的誓約進戰場時，放逐另一個目標由你操控的永久物。在下一個結束步驟開始時，將它在其擁有者的操控下返回戰場。\\n你每回合可以起動由你操控之鵬洛客的忠誠異能兩次，而不是只能起動一次。\', \'type\': \'傳奇結界\', \'flavor\': \'「為了失去的與遺忘的，我將摯誠守護。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445778&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'04828f4e-b5ae-462d-ad59-290e9483aeed\', \'multiverseId\': 445778}, \'multiverseid\': 445778}]', '[{\'name\': \'Teferis Wachposten\', \'text\': \'Solange du einen Teferi-Planeswalker kontrollierst, erhält Teferis Wachposten +4/+0.\', \'type\': \'Artefaktkreatur — Golem\', \'flavor\': \'„Vor langer Zeit habe ich eine Armee aus Statuen verzaubert, damit sie Zhalfir bewachen. Meine Heimat ist nicht mehr, aber ihre Beschützer stehen noch immer Wache." —Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445861&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e97bd35f-3f90-45a5-ac70-b1efb93becc7\', \'multiverseId\': 445861}, \'multiverseid\': 445861}, {\'name\': \'Centinela de Teferi\', \'text\': \'Mientras controles un planeswalker Teferi, el Centinela de Teferi obtiene +4/+0.\', \'type\': \'Criatura artefacto — Gólem\', \'flavor\': \'"Hace tiempo, encanté un ejército de estatuas para que custodiaran Zhalfir. Ahora mi patria ya no existe, pero sus protectores siguen ahí". —Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445871&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'93d53ed4-1ea2-4bc8-ad41-93ab7c751a0a\', \'multiverseId\': 445871}, \'multiverseid\': 445871}, {\'name\': \'Sentinelle de Téfeiri\', \'text\': \'Tant que vous contrôlez un planeswalker Téfeiri, la Sentinelle de Téfeiri gagne +4/+0.\', \'type\': \'Créature-artefact : golem\', \'flavor\': "« Il y a bien longtemps, j\'ai enchanté une armée de statues pour garder Zhalfir. Mon pays n\'existe plus, mais ses protecteurs sont toujours là. » —Téfeiri", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445881&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3b523e78-efc8-43ad-a6f7-cd2d7a10aad3\', \'multiverseId\': 445881}, \'multiverseid\': 445881}, {\'name\': \'Sentinella di Teferi\', \'text\': \'Fintanto che controlli un planeswalker Teferi, la Sentinella di Teferi prende +4/+0.\', \'type\': \'Creatura Artefatto — Golem\', \'flavor\': \'"Molto tempo fa, incantai un esercito di statue perché proteggessero Zhalfir. Della mia patria non c\\\'è più traccia, ma i suoi difensori resistono." —Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445891&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fde140b6-5172-4bec-a007-9972cd55373c\', \'multiverseId\': 445891}, \'multiverseid\': 445891}, {\'name\': \'テフェリーの歩哨\', \'text\': \'あなたがテフェリー・プレインズウォーカーをコントロールしているかぎり、テフェリーの歩哨は＋４/＋０の修整を受ける。\', \'type\': \'アーティファクト・クリーチャー — ゴーレム\', \'flavor\': \'「遠い昔、私はザルファーを守るため、多数の兵士の像に魔法をかけた。私の故郷は失われてしまったが、守る者たちは残っている。」 ――テフェリー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445901&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'25c378b9-7634-47b7-8cd9-dcd383dce17d\', \'multiverseId\': 445901}, \'multiverseid\': 445901}, {\'name\': \'테페리의 보초병\', \'text\': \'당신이 테페리 플레인즈워커를 조종하는 한, 테페리의 보초병은 +4/+0을 받는다.\', \'type\': \'마법물체 생물 — 골렘\', \'flavor\': \'"오래 전, 나는 잘피르를 수호하기 위해 석상으로 만든 군대에 마법을 걸었지. 내 고향은 사라졌지만, 그 수호자들만은 남아 있네." —테페리\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445911&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d3ad56d6-cf94-4ad3-872a-ac499da7930a\', \'multiverseId\': 445911}, \'multiverseid\': 445911}, {\'name\': \'Sentinela de Teferi\', \'text\': \'Enquanto você controlar um planeswalker Teferi, Sentinela de Teferi receberá +4/+0.\', \'type\': \'Criatura Artefato — Golem\', \'flavor\': \'"Há muito tempo, eu encantei um exército de estátuas para proteger Zhalfir. Minha terra se foi, mas suas protetoras permanecem." — Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445921&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'178b647b-3fa5-464e-8e95-5d78a6a1002d\', \'multiverseId\': 445921}, \'multiverseid\': 445921}, {\'name\': \'Стражник Тефери\', \'text\': \'Пока вы контролируете planeswalker-а Тефери, Стражник Тефери получает +4/+0.\', \'type\': \'Артефакт Существо — Голем\', \'flavor\': \'«В незапамятные времена я зачаровал армию статуй, призванную охранять Жалфир. Моей родины давно нет, но ее защитники остались». — Тефери\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445931&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'63e27106-68fd-41d5-8333-69e1c6be8363\', \'multiverseId\': 445931}, \'multiverseid\': 445931}, {\'name\': \'泰菲力的哨卫\', \'text\': \'只要你操控泰菲力鹏洛客，泰菲力的哨卫便得+4/+0。\', \'type\': \'神器生物 ～魔像\', \'flavor\': \'「很久以前，我向一队雕像施法让它们守卫赛费尔。而今家乡已逝，但其卫士仍在。」 ～泰菲力\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445941&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7008d5b4-9dda-4694-a749-3b5630421f97\', \'multiverseId\': 445941}, \'multiverseid\': 445941}, {\'name\': \'泰菲力的哨衛\', \'text\': \'只要你操控泰菲力鵬洛客，泰菲力的哨衛便得+4/+0。\', \'type\': \'神器生物 ～魔像\', \'flavor\': \'「很久以前，我向一隊雕像施法讓它們守衛賽費爾。而今家鄉已逝，但其衛士仍在。」 ～泰菲力\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445951&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e41e3cff-78f2-405c-b783-200f15a06258\', \'multiverseId\': 445951}, \'multiverseid\': 445951}]', "[{'name': 'Temporale Machenschaften', 'text': 'Bringe eine Kreatur deiner Wahl auf die Hand ihres Besitzers zurück. Falls du ein Artefakt kontrollierst, ziehe eine Karte.', 'type': 'Hexerei', 'flavor': 'Der Kabbalisten-Soldat blinzelte und stellte daraufhin fest, dass der Tag zur Nacht geworden war. Sein Gesicht war voller Schirmflieger und der alte Mann längst fort.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445859&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b4abab5a-24b7-43c1-a364-4d74c1f96a74', 'multiverseId': 445859}, 'multiverseid': 445859}, {'name': 'Maquinaciones temporales', 'text': 'Regresa la criatura objetivo a la mano de su propietario. Si controlas un artefacto, roba una carta.', 'type': 'Conjuro', 'flavor': 'El soldado de la Cábala parpadeó y vio que el día se había vuelto noche, que tenía el rostro lleno de semillas de diente de león y que el anciano había desaparecido.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445869&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'caaf76e2-8e06-4881-9dce-68a934afa6d2', 'multiverseId': 445869}, 'multiverseid': 445869}, {'name': 'Machinations temporelles', 'text': 'Renvoyez une créature ciblée dans la main de son propriétaire. Si vous contrôlez un artefact, piochez une carte.', 'type': 'Rituel', 'flavor': 'Le soldat de la Coterie cligna des yeux. Le jour avait soudain cédé la place à la nuit. Son visage était plein de duvet de chardon et le vieil homme avait disparu.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445879&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2261ea21-d935-4485-8077-d7049f920a68', 'multiverseId': 445879}, 'multiverseid': 445879}, {'name': 'Macchinazioni Temporali', 'text': 'Fai tornare una creatura bersaglio in mano al suo proprietario. Se controlli un artefatto, pesca una carta.', 'type': 'Stregoneria', 'flavor': 'Il soldato della Cabala batté le palpebre e scoprì che il giorno si era tramutato in notte, il suo volto era ricoperto di semi di soffione e il vecchio era svanito nel nulla.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445889&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b41f9347-ef7a-43e0-955b-80e64ae05960', 'multiverseId': 445889}, 'multiverseid': 445889}, {'name': '経時的策謀', 'text': 'クリーチャー１体を対象とし、それをオーナーの手札に戻す。あなたがアーティファクトをコントロールしているなら、カードを１枚引く。', 'type': 'ソーサリー', 'flavor': '陰謀団の兵士が瞬きをすると、昼だったはずが夜になっていた。顔はアザミの種まみれで、あの年老いた男の姿はどこにもなかった。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445899&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '320f5635-af6e-4574-96c6-612c40461405', 'multiverseId': 445899}, 'multiverseid': 445899}, {'name': '시간의 술책', 'text': '생물을 목표로 정한다. 그 생물을 소유자의 손으로 되돌린다. 당신이 마법물체를 조종한다면, 카드 한 장을 뽑는다.', 'type': '집중마법', 'flavor': '도당의 병사가 눈을 깜빡이자 낮이 밤으로 바뀌어 있었고, 얼굴에는 엉겅퀴 씨가 가득했으며, 노인은 어디에도 찾아볼 수 없었다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445909&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '24a58ffa-edfb-430e-8097-5aa44022f416', 'multiverseId': 445909}, 'multiverseid': 445909}, {'name': 'Maquinações Temporais', 'text': 'Devolva a criatura alvo para a mão de seu dono. Se você controlar um artefato, compre um card.', 'type': 'Feitiço', 'flavor': 'O soldado da Cabala piscou e descobriu que o dia se tornara noite, que seu rosto estava cheio de sementes de cardo e não se via mais o velho em lugar nenhum.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445919&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '94bfdae0-d1cd-443d-a7ae-cea5c9bcf1d3', 'multiverseId': 445919}, 'multiverseid': 445919}, {'name': 'Манипуляции со Временем', 'text': 'Верните целевое существо в руку его владельца. Если под вашим контролем есть артефакт, возьмите карту.', 'type': 'Волшебство', 'flavor': 'Солдат кабалов моргнул и обнаружил, что день превратился в ночь, в щетине у него запутались репьи, а старика нигде не видно.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445929&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'ca9da873-04b1-483a-95d4-f58b888b9f1b', 'multiverseId': 445929}, 'multiverseid': 445929}, {'name': '时间计谋', 'text': '将目标生物移回其拥有者手上。如果你操控神器，则抓一张牌。', 'type': '法术', 'flavor': '柯帮士兵一眨眼，竟发现白昼已化黑夜，自己满脸都是蓟花籽，而老人已不见踪影。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445939&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'ab204fc6-8f54-49a0-870f-b18f71191e6d', 'multiverseId': 445939}, 'multiverseid': 445939}, {'name': '時間計謀', 'text': '將目標生物移回其擁有者手上。如果你操控神器，則抽一張牌。', 'type': '巫術', 'flavor': '柯幫士兵一眨眼，竟發現白晝已化黑夜，自己滿臉都是薊花籽，而老人已不見蹤影。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445949&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'a4a0b595-eeb3-4adf-a4b2-bc2104914494', 'multiverseId': 445949}, 'multiverseid': 445949}]", '[{\'name\': \'Teshar, Apostel der Ahnfrau\', \'text\': \'Fliegend\\nImmer wenn du einen historischen Zauberspruch wirkst, bringe eine Kreaturenkarte deiner Wahl mit umgewandelten Manakosten von 3 oder weniger aus deinem Friedhof ins Spiel zurück. (Legenden, Artefakte und Sagen sind historisch.)\', \'type\': \'Legendäre Kreatur — Vogel, Kleriker\', \'flavor\': \'„Die Ahnfrau hat uns nicht ohne Grund gerettet."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443193&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'de1ed28e-aea3-426c-b0ff-c26c54dbeb76\', \'multiverseId\': 443193}, \'multiverseid\': 443193}, {\'name\': \'Teshar, apóstol de la Antepasada\', \'text\': \'Vuela.\\nSiempre que lances un hechizo histórico, regresa la carta de criatura objetivo con coste de maná convertido de 3 o menos de tu cementerio al campo de batalla. (Los artefactos, las Sagas y las cartas legendarias son cartas históricas.)\', \'type\': \'Criatura legendaria — Clérigo ave\', \'flavor\': \'"La Antepasada nos salvó con un propósito".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443462&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3de7078a-8bfe-4a19-a86f-32286f321389\', \'multiverseId\': 443462}, \'multiverseid\': 443462}, {\'name\': "Teshar, apôtre de l\'Ancêtre", \'text\': \'Vol\\nÀ chaque fois que vous lancez un sort historique, renvoyez sur le champ de bataille depuis votre cimetière une carte de créature ciblée avec un coût converti de mana inférieur ou égal à 3. (Les artefacts, les légendaires et les sagas sont historiques.)\', \'type\': \'Créature légendaire : oiseau et clerc\', \'flavor\': "« L\'Ancêtre nous a sauvés pour une raison. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443731&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'77071665-2b06-450a-911b-6606452e15e5\', \'multiverseId\': 443731}, \'multiverseid\': 443731}, {\'name\': "Teshar, Apostolo dell\'Antenata", \'text\': \'Volare\\nOgniqualvolta lanci una magia storica, rimetti sul campo di battaglia una carta creatura bersaglio con costo di mana convertito pari o inferiore a 3 dal tuo cimitero. (Artefatti, carte leggendarie e Saghe sono carte storiche.)\', \'type\': \'Creatura Leggendaria — Chierico Uccello\', \'flavor\': \'"L\\\'Antenata ci salvò per uno scopo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444000&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'23991d1f-4957-4e31-b17d-635e097fb818\', \'multiverseId\': 444000}, \'multiverseid\': 444000}, {\'name\': \'祖神の使徒、テシャール\', \'text\': \'飛行\\nあなたが歴史的な呪文を唱えるたび、あなたの墓地から点数で見たマナ・コストが３以下のクリーチャー・カード１枚を対象とし、それを戦場に戻す。（歴史的とは、アーティファクトと伝説と英雄譚のことである。）\', \'type\': \'伝説のクリーチャー — 鳥・クレリック\', \'flavor\': \'「祖神様が我らをお救いくださるのには理由がある。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444269&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f6ff22c0-ff0b-410b-8cf4-a0d3be7092d4\', \'multiverseId\': 444269}, \'multiverseid\': 444269}, {\'name\': \'선조의 사도, 테샤르\', \'text\': \'비행\\n당신이 역사적 주문을 발동할 때마다, 당신의 무덤에 있는 전환마나비용이 3 이하인 생물 카드를 목표로 정한다. 그 카드를 전장으로 되돌린다. (마법물체와 전설적, 서사시가 역사적이다.)\', \'type\': \'전설적 생물 — 조류 성직자\', \'flavor\': \'"선조가 우리를 구원한 데는 이유가 있다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444538&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'098e89ad-33f2-4dc2-8ceb-c6ea625ccd7a\', \'multiverseId\': 444538}, \'multiverseid\': 444538}, {\'name\': \'Teshar, Apóstolo da Ancestral\', \'text\': \'Voar\\nToda vez que você conjurar uma mágica histórica, devolva o card de criatura alvo com custo de mana convertido igual ou inferior a 3 de seu cemitério para o campo de batalha. (Os artefatos, os cards lendários e as Sagas são cards históricos.)\', \'type\': \'Criatura Lendária — Ave Clérigo\', \'flavor\': \'"A Ancestral nos salvou com um propósito."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444807&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1154d7f6-9174-4a77-8968-79618710a193\', \'multiverseId\': 444807}, \'multiverseid\': 444807}, {\'name\': \'Тешар, Апостол Прародительницы\', \'text\': \'Полет\\nКаждый раз, когда вы разыгрываете историческое заклинание, верните целевую карту существа с конвертированной мана-стоимостью не более 3 из вашего кладбища на поле битвы. (Артефакты, легендарные карты и Саги являются историческими.)\', \'type\': \'Легендарное Существо — Птица Священник\', \'flavor\': \'«Прародительница спасла нас не просто так».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445076&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fac16ab1-261e-4126-bb62-122bdc1d561a\', \'multiverseId\': 445076}, \'multiverseid\': 445076}, {\'name\': \'圣祖灵门徒铁夏\', \'text\': \'飞行\\n每当你施放史迹咒语时，将目标总法术力费用等于或小于3的生物牌从你的坟墓场移回战场。（神器、传奇和传纪是史迹。）\', \'type\': \'传奇生物 ～鸟／僧侣\', \'flavor\': \'「圣祖灵救吾人性命必有其用意。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445345&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'98a286e7-0a17-4d4b-b279-a207779633d9\', \'multiverseId\': 445345}, \'multiverseid\': 445345}, {\'name\': \'聖祖靈門徒鐵夏\', \'text\': \'飛行\\n每當你施放史跡咒語時，將目標總魔法力費用等於或小於3的生物牌從你的墳墓場移回戰場。（神器、傳奇和傳紀是史跡。）\', \'type\': \'傳奇生物 ～鳥／僧侶\', \'flavor\': \'「聖祖靈救吾人性命必有其用意。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445614&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9f88bc94-5fdb-4143-bc98-c751dc1d50a5\', \'multiverseId\': 445614}, \'multiverseid\': 445614}]', '[{\'name\': \'Tetsuko Umezawa, die Flüchtige\', \'text\': \'Kreaturen mit Stärke oder Widerstandskraft 1 oder weniger, die du kontrollierst, können nicht geblockt werden.\', \'type\': \'Legendäre Kreatur — Mensch, Räuber\', \'flavor\': \'„Mein Vorfahr Toshiro pflegte zu sagen: ‚Das Leben ist eine Abfolge von Entscheidungen zwischen schlechten Optionen.\\\' Ich treffe die besten schlechten Entscheidungen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443226&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'13abc923-9885-4f1c-9205-b858773cf655\', \'multiverseId\': 443226}, \'multiverseid\': 443226}, {\'name\': \'Tetsuko Umezawa, fugitiva\', \'text\': \'Las criaturas que controlas con fuerza o resistencia de 1 o menos no pueden ser bloqueadas.\', \'type\': \'Criatura legendaria — Bribón humano\', \'flavor\': \'"Mi antepasado Toshiro solía decir que la vida es una serie de elecciones entre lo malo y lo peor. Yo soy una maestra en el arte de tomar las peores decisiones".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443495&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6297c357-b2f8-4375-b435-efa53952a3cd\', \'multiverseId\': 443495}, \'multiverseid\': 443495}, {\'name\': \'Tetsuko Umezawa, fugitive\', \'text\': "Les créatures que vous contrôlez de force ou d\'endurance inférieure ou égale à 1 ne peuvent pas être bloquées.", \'type\': \'Créature légendaire : humain et gredin\', \'flavor\': \'« Toshiro, mon ancêtre, disait : "La vie est une série de choix allant du mauvais au pire." Je suis passée maîtresse dans l\\\'art de faire de grands mauvais choix. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443764&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3a1990aa-ad7d-4421-a55b-1f65e5a61bc5\', \'multiverseId\': 443764}, \'multiverseid\': 443764}, {\'name\': \'Tetsuko Umezawa, Fuggitiva\', \'text\': \'Le creature che controlli con forza o costituzione pari o inferiore a 1 non possono essere bloccate.\', \'type\': \'Creatura Leggendaria — Farabutto Umano\', \'flavor\': \'"Il mio antenato Toshiro diceva sempre: \\\'La vita è una serie di scelte tra ciò che è sbagliato e ciò che è peggio\\\'. Io sono una maestra nel compiere ottime scelte sbagliate."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444033&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'522a9b2a-11f4-4b2e-aab7-582c0409f64c\', \'multiverseId\': 444033}, \'multiverseid\': 444033}, {\'name\': \'逃亡者、梅澤哲子\', \'text\': \'あなたがコントロールしていてパワーかタフネスが１以下であるクリーチャーはブロックされない。\', \'type\': \'伝説のクリーチャー — 人間・ならず者\', \'flavor\': \'「ご先祖様の梅澤俊郎は『人生はひどい事と更にひどい事の選択の繰り返し』と言っていたそうね。私は最高の『ひどい事』を選択する名人なのよ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444302&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3cef9732-adb4-45e5-9504-7e2e98bc93af\', \'multiverseId\': 444302}, \'multiverseid\': 444302}, {\'name\': \'수배범, 우메자와 테츠코\', \'text\': \'당신이 조종하는 공격력 또는 방어력이 1 이하인 생물은 방어될 수 없다.\', \'type\': \'전설적 생물 — 인간 도적\', \'flavor\': \'"내 선조이신 토시로께서는 \\\'삶이란 나쁜 것과 더 나쁜 것 중에 하나를 고르는 선택의 연속이다.\\\'라고 하셨지. 나는 나쁜 쪽을 고르는 데 일가견이 있고."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444571&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'04127879-e7bd-47c9-827b-0b406954550e\', \'multiverseId\': 444571}, \'multiverseid\': 444571}, {\'name\': \'Tetsuko Umezawa, Fugitiva\', \'text\': \'As criaturas que você controla com poder ou resistência igual ou inferior a 1 não podem ser bloqueadas.\', \'type\': \'Criatura Lendária — Humano Ladino\', \'flavor\': \'"Meu ancestral Toshiro costumava dizer que \\\'A vida é uma série de escolhas entre o ruim e o pior.\\\' Eu sou mestra em fazer ótimas escolhas ruins."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444840&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'37d992fb-2344-4b78-a6b2-e3b65f3445c8\', \'multiverseId\': 444840}, \'multiverseid\': 444840}, {\'name\': \'Тэцуко Умезава, Беглянка\', \'text\': \'Существа под вашим контролем с силой или выносливостью 1 или меньше не могут быть заблокированы.\', \'type\': \'Легендарное Существо — Человек Бродяга\', \'flavor\': \'«Мой предок Тосиро часто говорил: "Жизнь — это постоянный выбор между плохим и еще худшим". У меня отлично получается выбирать самое лучшее плохое».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445109&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0c8af2d3-c597-4536-a4c0-5a0cfbe90130\', \'multiverseId\': 445109}, \'multiverseid\': 445109}, {\'name\': \'浪人梅泽哲子\', \'text\': \'由你操控且力量或防御力等于或小于1的生物不能被阻挡。\', \'type\': \'传奇生物 ～人类／浪客\', \'flavor\': \'「俊郎先祖曾说，『生命是一连串的选择，每次都只有糟与更糟可选。』我最擅长选『糟』。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445378&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'36a3562d-670f-4b80-8a5d-5a54934674c7\', \'multiverseId\': 445378}, \'multiverseid\': 445378}, {\'name\': \'浪人梅澤哲子\', \'text\': \'由你操控且力量或防禦力等於或小於1的生物不能被阻擋。\', \'type\': \'傳奇生物 ～人類／浪客\', \'flavor\': \'「俊郎先祖曾說，『生命是一連串的選擇，每次都只有糟與更糟可選。』我最擅長選『糟』。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445647&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7cdc4e26-a399-445b-9ef8-764a7759fdf2\', \'multiverseId\': 445647}, \'multiverseid\': 445647}]', '[{\'name\': \'Thallid-Allesfresser\', \'text\': \'{1}, opfere eine andere Kreatur: Der Thallid-Allesfresser erhält +2/+2 bis zum Ende des Zuges. Falls auf diese Weise ein Saproling geopfert wurde, erhältst du 2 Lebenspunkte dazu.\', \'type\': \'Kreatur — Pilzwesen\', \'flavor\': \'Thelon von Havenwood erschuf Thallide einst als Nahrungsquelle in Zeiten der Dunkelheit. Thallide taten dasselbe mit Saprolingen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443263&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b6eb6085-0ee0-4985-bc03-90225155ee06\', \'multiverseId\': 443263}, \'multiverseid\': 443263}, {\'name\': \'Tálido omnívoro\', \'text\': \'{1}, sacrificar otra criatura: El Tálido omnívoro obtiene +2/+2 hasta el final del turno. Si un Saprolín fue sacrificado de esta manera, ganas 2 vidas.\', \'type\': \'Criatura — Hongo\', \'flavor\': \'Thélon de Havenwood creó a los tálidos como fuente de sustento en épocas oscuras. Los tálidos hicieron lo mismo con los saprolines.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443532&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3526b761-1ed4-4c3f-9beb-666fe695b35e\', \'multiverseId\': 443532}, \'multiverseid\': 443532}, {\'name\': \'Thallidé omnivore\', \'text\': "{1}, sacrifiez une autre créature : Le Thallidé omnivore gagne +2/+2 jusqu\'à la fin du tour. Si un Saprobionte a été sacrifié de cette manière, vous gagnez 2 points de vie.", \'type\': \'Créature : fongus\', \'flavor\': \'Thélon de Havrebois créa les thallidés comme nourriture pour survivre aux ténèbres. Les thallidés firent de même avec les saprobiontes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443801&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'087cfd1b-74a5-41f2-9412-7c29965dbbc4\', \'multiverseId\': 443801}, \'multiverseid\': 443801}, {\'name\': \'Thallid Onnivoro\', \'text\': "{1}, Sacrifica un\'altra creatura: Il Thallid Onnivoro prende +2/+2 fino alla fine del turno. Se un Saprolingio è stato sacrificato in questo modo, guadagni 2 punti vita.", \'type\': \'Creatura — Fungus\', \'flavor\': \'Thelon di Havenwood creò i thallid come fonte di sostentamento in tempi oscuri. I thallid fecero lo stesso con i saprolingi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444070&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c13a2b2b-59ce-4ef9-a442-5c36a7ee165a\', \'multiverseId\': 444070}, \'multiverseid\': 444070}, {\'name\': \'雑食のサリッド\', \'text\': \'{1}, 他のクリーチャーを１体生け贄に捧げる：ターン終了時まで、雑食のサリッドは＋２/＋２の修整を受ける。これにより苗木を生け贄に捧げたなら、あなたは２点のライフを得る。\', \'type\': \'クリーチャー — ファンガス\', \'flavor\': \'暗黒の時代に、ヘイヴンウッドのセロンがサリッドを作り出し食糧にした。サリッドも苗木を同様にした。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444339&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'699e32a1-bab3-48c8-bfa5-2c507dafeb8a\', \'multiverseId\': 444339}, \'multiverseid\': 444339}, {\'name\': \'잡식성 탈리드\', \'text\': \'{1}, 다른 생물 한 개를 희생한다: 잡식성 탈리드는 턴종료까지 +2/+2를 받는다. 묘목이 이런 식으로 희생되었다면, 당신은 생명 2점을 얻는다.\', \'type\': \'생물 — 진균\', \'flavor\': \'안식의 숲의 텔론은 힘든 시기에 식량으로 쓰기 위해 탈리드를 만들었다. 탈리드도 같은 이유로 묘목을 만들었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444608&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8f2d59f1-9fb3-434f-9c41-6c0f496a7921\', \'multiverseId\': 444608}, \'multiverseid\': 444608}, {\'name\': \'Talídia Onívora\', \'text\': \'{1}, sacrifique outra criatura: Talídia Onívora recebe +2/+2 até o final do turno. Se uma Saprófita foi sacrificada dessa forma, você ganha 2 pontos de vida.\', \'type\': \'Criatura — Fungo\', \'flavor\': \'Thelon de Havenwood criou as talídias como fonte de alimento em tempos sombrios. As talídias fizeram o mesmo com as saprófitas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444877&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9cdfcbda-993a-4706-8bf2-99631e37f088\', \'multiverseId\': 444877}, \'multiverseid\': 444877}, {\'name\': \'Всеядный Таллид\', \'text\': \'{1}, пожертвуйте другое существо: Всеядный Таллид получает +2/+2 до конца хода. Если таким образом был пожертвован Сапролинг, вы получаете 2 жизни.\', \'type\': \'Существо — Плесень\', \'flavor\': \'Телон из Хейвенвуда создал таллидов, чтобы не страдать от голода в тяжелые времена. Таллиды сделали то же самое с сапролингами.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445146&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4d3d5e88-984b-421a-a2f6-938746fa0dfb\', \'multiverseId\': 445146}, \'multiverseid\': 445146}, {\'name\': \'杂食散绿菌\', \'text\': \'{1}，牺牲另一个生物：杂食散绿菌得+2/+2直到回合结束。如果以此法牺牲的是腐生物，则你获得2点生命。\', \'type\': \'生物 ～真菌\', \'flavor\': \'在黑暗的年代，海温森的瑟隆曾培育散绿菌作为粮食。散绿菌对腐生物做了同样的事。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445415&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6b1abbd4-0ac7-4b55-9e6f-757bcb8bbbad\', \'multiverseId\': 445415}, \'multiverseid\': 445415}, {\'name\': \'雜食散綠菌\', \'text\': \'{1}，犧牲另一個生物：雜食散綠菌得+2/+2直到回合結束。如果以此法犧牲的是腐生物，則你獲得2點生命。\', \'type\': \'生物 ～真菌\', \'flavor\': \'在黑暗的年代，海溫森的瑟隆曾培育散綠菌作為糧食。散綠菌對腐生物做了同樣的事。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445684&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'04002e73-bd36-414a-904c-27ebef0ecd91\', \'multiverseId\': 445684}, \'multiverseid\': 445684}]', '[{\'name\': \'Thallid-Wahrsager\', \'text\': \'{2}, opfere eine Kreatur: Ziehe eine Karte.\', \'type\': \'Kreatur — Pilzwesen\', \'flavor\': \'Einige der Thallide, die in die Sümpfe Urborgs geflohen waren, begannen damit, die blutigen Rituale der Kabbalisten auf eigene Weise nachzuahmen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443264&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a5cf2231-c913-40b6-83f7-049a51efae0b\', \'multiverseId\': 443264}, \'multiverseid\': 443264}, {\'name\': \'Augur tálido\', \'text\': \'{2}, sacrificar una criatura: Roba una carta.\', \'type\': \'Criatura — Hongo\', \'flavor\': \'Algunos de los tálidos que escaparon a los pantanos de Urborg comenzaron a emular los rituales sangrientos de la Cábala a su peculiar manera.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443533&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'670bd45d-bde4-408b-b445-f2aca2db72c8\', \'multiverseId\': 443533}, \'multiverseid\': 443533}, {\'name\': \'Aruspice thallidé\', \'text\': \'{2}, sacrifiez une créature : Piochez une carte.\', \'type\': \'Créature : fongus\', \'flavor\': "Certains des thallidés qui s\'étaient échappés dans les marais d\'Urborg se mirent à imiter à leur façon les rituels sanglants de la Coterie.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443802&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e9fa1c04-2ae9-47f3-af1d-3ba3f8051ad8\', \'multiverseId\': 443802}, \'multiverseid\': 443802}, {\'name\': \'Thallid Indovino\', \'text\': \'{2}, Sacrifica una creatura: Pesca una carta.\', \'type\': \'Creatura — Fungus\', \'flavor\': \'Alcuni dei thallid fuggiti nelle paludi di Urborg iniziarono a emulare i sanguinosi rituali della Cabala in un modo tutto loro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444071&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1a669d16-b291-4561-92d6-b0c870cb1ff0\', \'multiverseId\': 444071}, \'multiverseid\': 444071}, {\'name\': \'サリッドの予言者\', \'text\': \'{2}, クリーチャー１体を生け贄に捧げる：カードを１枚引く。\', \'type\': \'クリーチャー — ファンガス\', \'flavor\': \'脱走してアーボーグの湿原に逃れたサリッドの中に、陰謀団の血染めの儀式を奇妙な自己流で真似し始めたものがいた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444340&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8bc3d89b-d168-491a-b4fb-7f402d08b884\', \'multiverseId\': 444340}, \'multiverseid\': 444340}, {\'name\': \'탈리드 점쟁이\', \'text\': \'{2}, 생물 한 개를 희생한다: 카드 한 장을 뽑는다.\', \'type\': \'생물 — 진균\', \'flavor\': \'우르보그의 땅으로 도망친 탈리드 중 일부는, 도당의 피비린내 나는 의식을 자신들만의 방식으로 모방하기 시작했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444609&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'aaef0b50-fbf2-4f8a-892f-d05c0c2fbe8b\', \'multiverseId\': 444609}, \'multiverseid\': 444609}, {\'name\': \'Adivinha Talídia\', \'text\': \'{2}, sacrifique uma criatura: Compre um card.\', \'type\': \'Criatura — Fungo\', \'flavor\': \'Algumas das talídias que fugiram para os charcos de Urborg começaram a emular os rituais sanguinolentos da Cabala de seu próprio jeito peculiar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444878&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'007f6170-e4c7-444e-bd67-4e08b383b339\', \'multiverseId\': 444878}, \'multiverseid\': 444878}, {\'name\': \'Таллид-Предсказатель\', \'text\': \'{2}, пожертвуйте существо: возьмите карту.\', \'type\': \'Существо — Плесень\', \'flavor\': \'Некоторые из укрывшихся среди болот Урборга таллидов стали подражать кровавым обрядам кабалов — перекладывая их на свой необычный манер.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445147&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'09a3553c-6381-487f-95f3-b10c45cb3ef9\', \'multiverseId\': 445147}, \'multiverseid\': 445147}, {\'name\': \'预言散绿菌\', \'text\': \'{2}，牺牲一个生物：抓一张牌。\', \'type\': \'生物 ～真菌\', \'flavor\': \'某些逃往乌尔博格沼地的散绿菌开始以其独特方法效仿柯帮的染血仪式。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445416&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'49f67165-697d-4b31-ba4d-261fa979eaf4\', \'multiverseId\': 445416}, \'multiverseid\': 445416}, {\'name\': \'預言散綠菌\', \'text\': \'{2}，犧牲一個生物：抽一張牌。\', \'type\': \'生物 ～真菌\', \'flavor\': \'某些逃往烏爾博格沼地的散綠菌開始以其獨特方法效仿柯幫的染血儀式。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445685&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'28c162af-8421-4769-b319-568729c04d59\', \'multiverseId\': 445685}, \'multiverseid\': 445685}]', '[{\'name\': \'Thran-Zeitportal\', \'text\': \'{4}, {T}: Du kannst eine historische bleibende Karte aus deiner Hand ins Spiel bringen. (Legenden, Artefakte und Sagen sind historisch.)\', \'type\': \'Legendäres Artefakt\', \'flavor\': \'Das Portal führt nicht in sondern aus der Vergangenheit. Jene, die es durchschreiten, erblicken eine unvorstellbare Zukunft.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443390&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'264148bd-9e38-4d5a-b75b-44b3b3fe47b7\', \'multiverseId\': 443390}, \'multiverseid\': 443390}, {\'name\': \'Portal temporal thran\', \'text\': \'{4}, {T}: Puedes poner en el campo de batalla una carta de permanente histórica de tu mano. (Los artefactos, las Sagas y las cartas legendarias son cartas históricas.)\', \'type\': \'Artefacto legendario\', \'flavor\': \'El portal no se abre al pasado, sino desde el pasado. Quienes lo atraviesen descubrirán un futuro inimaginable.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443659&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5cf6dc51-7695-4de9-ba76-a6834369b547\', \'multiverseId\': 443659}, \'multiverseid\': 443659}, {\'name\': \'Portail temporel thran\', \'text\': \'{4}, {T} : Vous pouvez mettre sur le champ de bataille une carte de permanent historique de votre main. (Les artefacts, les légendaires et les sagas sont historiques.)\', \'type\': \'Artefact légendaire\', \'flavor\': "Ce n\'est pas vers, mais depuis le passé, que le portail s\'ouvre. Ceux qui le traversent découvrent un futur dépassant l\'imagination.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443928&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'79fccab3-cc42-4961-80cf-c6391037f8c5\', \'multiverseId\': 443928}, \'multiverseid\': 443928}, {\'name\': \'Portale Temporale Thran\', \'text\': \'{4}, {T}: Puoi mettere sul campo di battaglia una carta permanente storica dalla tua mano. (Artefatti, carte leggendarie e Saghe sono carte storiche.)\', \'type\': \'Artefatto Leggendario\', \'flavor\': \'Il portale non consente di viaggiare *verso* il passato, ma *da* esso. Chiunque lo attraversi scopre un futuro inimmaginabile.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444197&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e6ff4785-6a66-419e-9483-58d9c751beb3\', \'multiverseId\': 444197}, \'multiverseid\': 444197}, {\'name\': \'スランの経時門\', \'text\': \'{4}, {T}：あなたは、あなたの手札から歴史的なパーマネント・カード１枚を戦場に出してもよい。（歴史的とは、アーティファクトと伝説と英雄譚のことである。）\', \'type\': \'伝説のアーティファクト\', \'flavor\': \'このポータルは過去に向けてではなく過去から開く。ここに足を踏み入れた者は想像できないような未来を発見する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444466&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f28f8d79-694d-447c-9159-c1d86fc1d817\', \'multiverseId\': 444466}, \'multiverseid\': 444466}, {\'name\': \'트란 시간 관문\', \'text\': \'{4}, {T}: 당신은 당신의 손에서 역사적 지속물 카드 한 장을 전장에 놓을 수 있다. (마법물체와 전설적, 서사시가 역사적이다.)\', \'type\': \'전설적 마법물체\', \'flavor\': \'이 관문은 과거로 가는 길이 아니라 과거에서 오는 길이다. 관문을 지나는 자는 상상할 수 없는 미래를 마주하게 된다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444735&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'09d1c182-a794-4030-8abd-24c7a576ecb4\', \'multiverseId\': 444735}, \'multiverseid\': 444735}, {\'name\': \'Portal Temporal dos Thran\', \'text\': \'{4}, {T}: Você pode colocar no campo de batalha um card de permanente histórica de sua mão. (Os artefatos, os cards lendários e as Sagas são cards históricos.)\', \'type\': \'Artefato Lendário\', \'flavor\': \'O portal não se abre para o passado, mas a partir dele. Os que o atravessam descobrem um futuro inimaginável.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445004&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'aba2cbce-0f86-4df8-8ff7-178af490b5f2\', \'multiverseId\': 445004}, \'multiverseid\': 445004}, {\'name\': \'Транские Врата Времени\', \'text\': \'{4}, {T}: вы можете положить карту исторического перманента из вашей руки на поле битвы. (Артефакты, легендарные карты и Саги являются историческими.)\', \'type\': \'Легендарный Артефакт\', \'flavor\': \'Портал открывается не в прошлое, а из него. Те, кто пройдет через него, откроют невероятное будущее.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445273&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'589dd670-b639-4339-b984-6812ee495bed\', \'multiverseId\': 445273}, \'multiverseid\': 445273}, {\'name\': \'索蓝时间闸门\', \'text\': \'{4}，{T}：你可以将一张史迹永久物牌从你手上放进战场。（神器、传奇和传纪是史迹。）\', \'type\': \'传奇神器\', \'flavor\': \'通道不通往过去，而是来自过去。穿门而出者，会发现一个超乎想象的未来。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445542&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a592a6fd-1965-4b45-8481-bee8699e5568\', \'multiverseId\': 445542}, \'multiverseid\': 445542}, {\'name\': \'索藍時間閘門\', \'text\': \'{4}，{T}：你可以將一張史跡永久物牌從你手上放進戰場。（神器、傳奇和傳紀是史跡。）\', \'type\': \'傳奇神器\', \'flavor\': \'通道不通往過去，而是來自過去。穿門而出者，會發現一個超乎想像的未來。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445811&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e8c00037-e383-422e-b5bb-20e2b5185d5f\', \'multiverseId\': 445811}, \'multiverseid\': 445811}]', '[{\'name\': \'Tiana, Schiffstechnikerin\', \'text\': \'Fliegend, Erstschlag\\nImmer wenn eine Aura oder Ausrüstung, die du kontrollierst, aus dem Spiel auf einen Friedhof gelegt wird, kannst du ihre Karte zu Beginn des nächsten Endsegments auf die Hand ihres Besitzers zurückbringen.\', \'type\': \'Legendäre Kreatur — Engel, Handwerker\', \'flavor\': \'„Nichts ist zu kaputt, um es zu reparieren."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443365&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'aacd0573-81e6-4a86-9878-52ef741ff687\', \'multiverseId\': 443365}, \'multiverseid\': 443365}, {\'name\': \'Tiana, ingeniera del barco\', \'text\': \'Vuela, daña primero.\\nSiempre que un Aura o un Equipo que controlas vaya a un cementerio desde el campo de batalla, puedes regresar esa carta a la mano de su propietario al comienzo del próximo paso final.\', \'type\': \'Criatura legendaria — Artífice ángel\', \'flavor\': \'"Nada está tan roto que no pueda arreglarse".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443634&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ef76e9c2-4702-4503-bc73-f0ca1bd48a01\', \'multiverseId\': 443634}, \'multiverseid\': 443634}, {\'name\': \'Tiana, pourvoyeuse de navire\', \'text\': "Vol, initiative\\nÀ chaque fois qu\'une aura ou qu\'un équipement que vous contrôlez est mis dans un cimetière depuis le champ de bataille, vous pouvez renvoyer cette carte dans la main de son propriétaire au début de la prochaine étape de fin.", \'type\': \'Créature légendaire : ange et artificier\', \'flavor\': "« Rien n\'est trop endommagé pour pouvoir être réparé. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443903&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f83b65b8-188f-4689-8b4a-5a32b295e3ac\', \'multiverseId\': 443903}, \'multiverseid\': 443903}, {\'name\': \'Tiana, Motorista di Bordo\', \'text\': "Volare, attacco improvviso\\nOgniqualvolta un\'Aura o un Equipaggiamento che controlli vengono messi in un cimitero dal campo di battaglia, puoi far tornare quella carta in mano al suo proprietario all\'inizio della prossima sottofase finale.", \'type\': \'Creatura Leggendaria — Artefice Angelo\', \'flavor\': \'"Niente è irreparabile."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444172&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'109de752-3fc2-455a-8a48-c59d585edf92\', \'multiverseId\': 444172}, \'multiverseid\': 444172}, {\'name\': \'艦の整備士、ティアナ\', \'text\': \'飛行、先制攻撃\\nあなたがコントロールしているオーラか装備品が１つ戦場から墓地に置かれるたび、次の終了ステップの開始時に、あなたはそのカードをオーナーの手札に戻してもよい。\', \'type\': \'伝説のクリーチャー — 天使・工匠\', \'flavor\': \'「修復できないほど壊れるなんて物ないわ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444441&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4624fa5f-59ca-4727-8fee-659eb17fdbb0\', \'multiverseId\': 444441}, \'multiverseid\': 444441}, {\'name\': \'배의 관리인, 티아나\', \'text\': \'비행, 선제공격\\n당신이 조종하는 마법진 또는 장비가 전장에서 무덤으로 들어갈 때마다, 당신은 다음 종료단 시작에 그 카드를 소유자의 손으로 되돌릴 수 있다.\', \'type\': \'전설적 생물 — 천사 기능공\', \'flavor\': \'"세상에 고치지 못할 만큼 망가진 물건이란 없지."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444710&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5177685a-11fc-4f85-8612-21e77af42ed9\', \'multiverseId\': 444710}, \'multiverseid\': 444710}, {\'name\': \'Tiana, Encarregada do Navio\', \'text\': \'Voar, iniciativa\\nToda vez que uma Aura ou um Equipamento que você controla for colocado em um cemitério vindo do campo de batalha, você poderá devolver aquele card para a mão de seu dono no início da próxima etapa final.\', \'type\': \'Criatura Lendária — Anjo Artesão\', \'flavor\': \'"Nada está quebrado demais que não se possa consertar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444979&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'98235861-5301-4710-9cc4-00b86a9f6389\', \'multiverseId\': 444979}, \'multiverseid\': 444979}, {\'name\': \'Тиана, Корабельный Механик\', \'text\': \'Полет, Первый удар\\nКаждый раз, когда Аура или Снаряжение под вашим контролем попадает на кладбище с поля битвы, вы можете вернуть ту карту в руку ее владельца в начале следующего заключительного шага.\', \'type\': \'Легендарное Существо — Ангел Механик\', \'flavor\': \'«Нет ничего настолько сломанного, чтобы это нельзя было починить».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445248&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'30762414-b44e-4aa8-83a0-009240fbc0c1\', \'multiverseId\': 445248}, \'multiverseid\': 445248}, {\'name\': \'飞船护持师蒂娅娜\', \'text\': \'飞行，先攻\\n每当一个由你操控的灵气或武具从战场进入坟墓场，在下一个结束步骤开始时，你可以将该牌移回其拥有者手上。\', \'type\': \'传奇生物 ～天使／神器师\', \'flavor\': \'「没有坏到不能修的东西。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445517&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'73fad3dc-4de2-4002-ac3b-48d692c1e162\', \'multiverseId\': 445517}, \'multiverseid\': 445517}, {\'name\': \'飛船護持師蒂婭娜\', \'text\': \'飛行，先攻\\n每當一個由你操控的靈氣或武具從戰場進入墳墓場，在下一個結束步驟開始時，你可以將該牌移回其擁有者手上。\', \'type\': \'傳奇生物 ～天使／神器師\', \'flavor\': \'「沒有壞到不能修的東西。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445786&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6d7606fe-3b8c-42a5-8355-1230d937e11b\', \'multiverseId\': 445786}, \'multiverseid\': 445786}]', '[{\'name\': \'Tobender Zyklop\', \'text\': \'Der Tobende Zyklop erhält -2/-0, solange ihn zwei oder mehr Kreaturen blocken.\', \'type\': \'Kreatur — Zyklop\', \'flavor\': \'Die Keldonen nutzen geschickt aus, dass dem Zyklopen die Tiefenwahrnehmung fehlt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443296&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e458fc93-0f91-4a82-8581-6677d14653b1\', \'multiverseId\': 443296}, \'multiverseid\': 443296}, {\'name\': \'Cíclope enfurecido\', \'text\': \'El Cíclope enfurecido obtiene -2/-0 mientras dos o más criaturas lo bloqueen.\', \'type\': \'Criatura — Cíclope\', \'flavor\': \'Los guerreros keldon aprovechan la incapacidad del cíclope para ocuparse de más de una cosa a la vez.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443565&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5ffe2462-b3b3-4e21-9364-55b071d9e685\', \'multiverseId\': 443565}, \'multiverseid\': 443565}, {\'name\': \'Cyclope déchaîné\', \'text\': "Le Cyclope déchaîné gagne -2/-0 tant qu\'au moins deux créatures le bloquent.", \'type\': \'Créature : cyclope\', \'flavor\': "Les guerriers keldes profitent de l\'incapacité des cyclopes à se concentrer sur plus d\'une chose à la fois.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443834&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1f3d7ea1-e762-46a5-805a-c9dd73676b11\', \'multiverseId\': 443834}, \'multiverseid\': 443834}, {\'name\': \'Ciclope Scatenato\', \'text\': \'Il Ciclope Scatenato prende -2/-0 fintanto che è bloccato da due o più creature.\', \'type\': \'Creatura — Ciclope\', \'flavor\': "I guerrieri di Keld sfruttano a proprio vantaggio l\'incapacità dei ciclopi di concentrarsi su più di una cosa alla volta.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444103&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'82487722-32ec-4e0a-9dde-e25ff4916127\', \'multiverseId\': 444103}, \'multiverseid\': 444103}, {\'name\': \'暴れ回るサイクロプス\', \'text\': \'クリーチャーが２体以上で暴れ回るサイクロプスをブロックしているかぎり、これは－２/－０の修整を受ける。\', \'type\': \'クリーチャー — サイクロプス\', \'flavor\': \'ケルドの戦士たちは、サイクロプスが同時に二つ以上のものに注意を向けられない点を利用する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444372&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5d7d38c1-5f07-4e6d-9897-7de0ca73920c\', \'multiverseId\': 444372}, \'multiverseid\': 444372}, {\'name\': \'돌진하는 키클롭스\', \'text\': \'두 개 이상의 생물이 돌진하는 키클롭스를 방어하는 한 돌진하는 키클롭스는 -2/-0을 받는다.\', \'type\': \'생물 — 키클롭스\', \'flavor\': \'켈드의 전사들은 키클롭스가 한 번에 하나의 대상에만 집중할 수 있다는 점을 잘 활용하여 싸운다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444641&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1cd0bd67-c0bc-4a9c-b857-f05ae10db2f2\', \'multiverseId\': 444641}, \'multiverseid\': 444641}, {\'name\': \'Ciclope Enfurecido\', \'text\': \'Ciclope Enfurecido recebe -2/-0 enquanto duas ou mais criaturas o estiverem bloqueando.\', \'type\': \'Criatura — Ciclope\', \'flavor\': \'Os guerreiros keldonianos se aproveitam da incapacidade do ciclope de se concentrar em mais de uma coisa de cada vez.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444910&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f8ceb945-0d3f-4c09-bcbb-106ae8ac5699\', \'multiverseId\': 444910}, \'multiverseid\': 444910}, {\'name\': \'Неистовый Циклоп\', \'text\': \'Неистовый Циклоп получает -2/-0, пока его блокируют два или более существа.\', \'type\': \'Существо — Циклоп\', \'flavor\': \'Келдонские воины хорошо знают, что циклоп не может сосредоточиться на двух врагах одновременно.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445179&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0c304c0b-335a-4f26-b957-979b5a14a45f\', \'multiverseId\': 445179}, \'multiverseid\': 445179}, {\'name\': \'莽闯独眼巨人\', \'text\': \'只要莽闯独眼巨人被两个或更多生物阻挡，它便得-2/-0。\', \'type\': \'生物 ～独眼巨人\', \'flavor\': \'凯尔顿的战士会利用独眼巨人无法一眼尽观全局的弱点。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445448&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'02bc2794-8ca9-484b-a299-f7ebe4569373\', \'multiverseId\': 445448}, \'multiverseid\': 445448}, {\'name\': \'莽闖獨眼巨人\', \'text\': \'只要莽闖獨眼巨人被兩個或更多生物阻擋，它便得-2/-0。\', \'type\': \'生物 ～獨眼巨人\', \'flavor\': \'凱爾頓的戰士會利用獨眼巨人無法一眼盡觀全局的弱點。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445717&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c8017c40-95fe-45bd-ae17-baea9ec18318\', \'multiverseId\': 445717}, \'multiverseid\': 445717}]', '[{\'name\': \'Todesblüten-Thallid\', \'text\': \'Wenn der Todesblüten-Thallid stirbt, erzeuge einen 1/1 grünen Saproling-Kreaturenspielstein.\', \'type\': \'Kreatur — Pilzwesen\', \'flavor\': \'„Mutter Natur ist nicht immer sanft und gütig, aber ein Leben nährt das nächste." —Marwyn von Llanowar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443241&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'60299c34-444e-4261-a41b-89e5a2135a1a\', \'multiverseId\': 443241}, \'multiverseid\': 443241}, {\'name\': \'Tálido brote lúgubre\', \'text\': \'Cuando el Tálido brote lúgubre muera, crea una ficha de criatura Saprolín verde 1/1.\', \'type\': \'Criatura — Hongo\', \'flavor\': \'"La naturaleza no siempre es amable ni gentil, pero toda vida engendra vida". —Marwyn de Llanowar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443510&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dfff3a8a-6f10-41cf-9530-6fd94353f37b\', \'multiverseId\': 443510}, \'multiverseid\': 443510}, {\'name\': \'Thallidé à fleurs de mort\', \'text\': \'Quand le Thallidé à fleurs de mort meurt, créez un jeton de créature 1/1 verte Saprobionte.\', \'type\': \'Créature : fongus\', \'flavor\': "« La nature n\'est pas toujours tendre et douce, mais toute vie engendre la vie. » —Marwyn de Llanowar", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443779&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dad1aa14-01f8-4264-ba8d-a6086185c0ac\', \'multiverseId\': 443779}, \'multiverseid\': 443779}, {\'name\': \'Thallid Germoglio di Morte\', \'text\': \'Quando il Thallid Germoglio di Morte muore, crea una pedina creatura Saprolingio 1/1 verde.\', \'type\': \'Creatura — Fungus\', \'flavor\': \'"Non sempre la natura è gentile o amabile, ma qualsiasi forma di vita genera altra vita." —Marwyn di Llanowar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444048&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ccdf0a59-ba67-4aef-af49-2c6658a0b733\', \'multiverseId\': 444048}, \'multiverseid\': 444048}, {\'name\': \'死花のサリッド\', \'text\': \'死花のサリッドが死亡したとき、緑の１/１の苗木・クリーチャー・トークンを１体生成する。\', \'type\': \'クリーチャー — ファンガス\', \'flavor\': \'「自然はいつでも優しく親切というわけではないわ。それでも、命は新たな命をもうけるのよ。」 ――ラノワールのマーウィン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444317&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'27b3ec07-a58c-438b-bcd6-69153e1b420b\', \'multiverseId\': 444317}, \'multiverseid\': 444317}, {\'name\': \'죽음을 꽃피우는 탈리드\', \'text\': \'죽음을 꽃피우는 탈리드가 죽을 때, 1/1 녹색 묘목 생물 토큰 한 개를 만든다.\', \'type\': \'생물 — 진균\', \'flavor\': \'"자연이 언제나 점잖고 친절한 것은 아니지만, 모든 생명은 자손을 갖기 마련이지." —라노워의 마르윈\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444586&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2c1079f8-6319-467f-8dd8-8217da71e1bd\', \'multiverseId\': 444586}, \'multiverseid\': 444586}, {\'name\': \'Talídia Necroflorescente\', \'text\': \'Quando Talídia Necroflorescente morrer, crie uma ficha de criatura verde 1/1 do tipo Saprófita.\', \'type\': \'Criatura — Fungo\', \'flavor\': \'"A natureza não é sempre suave, nem gentil, mas toda vida gera vida." — Marwyn de Llanowar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444855&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'93af0770-3d6f-4d83-b052-5fd4b8adb3e9\', \'multiverseId\': 444855}, \'multiverseid\': 444855}, {\'name\': \'Таллид-Смертоцвет\', \'text\': \'Когда Таллид-Смертоцвет умирает, создайте одну фишку существа 1/1 зеленый Сапролинг.\', \'type\': \'Существо — Плесень\', \'flavor\': \'«Природа не всегда нежна или добра, но всякая жизнь порождает жизнь». — Марвин из Лановара\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445124&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c0bc050b-737a-48e5-843b-44c5f588214f\', \'multiverseId\': 445124}, \'multiverseid\': 445124}, {\'name\': \'死华散绿菌\', \'text\': \'当死华散绿菌死去时，派出一个1/1绿色腐生物衍生生物。\', \'type\': \'生物 ～真菌\', \'flavor\': \'「大自然并不总是温和仁慈，但万物生生不息。」 ～罗堰的玛雯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445393&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'17cc75c1-e663-435b-a783-035fe3a08083\', \'multiverseId\': 445393}, \'multiverseid\': 445393}, {\'name\': \'死華散綠菌\', \'text\': \'當死華散綠菌死去時，派出一個1/1綠色腐生物衍生生物。\', \'type\': \'生物 ～真菌\', \'flavor\': \'「大自然並不總是溫和仁慈，但萬物生生不息。」 ～羅堰的瑪雯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445662&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fdef95dd-caa1-4ff4-9dcf-8cf3d48a3c09\', \'multiverseId\': 445662}, \'multiverseid\': 445662}]', '[{\'name\': \'Tolarianischer Gelehrter\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'Die Akademien von Tolaria bewahren die Tradition von Studium und Forschung, doch sie lehnen jene Art von Experimenten ab, welche die ursprüngliche Insel von Tolaria vernichtet hatten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443228&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c52e9049-5d9e-4e7c-a234-60d2aed31554\', \'multiverseId\': 443228}, \'multiverseid\': 443228}, {\'name\': \'Erudito tolariano\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'Las Academias Tolarianas entroncan con una tradición de estudio e investigación, mas desincentivan la clase de experimentos que acabaron con la isla original de Tolaria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443497&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3c91d876-0401-48a0-afaa-40049c0dbe5f\', \'multiverseId\': 443497}, \'multiverseid\': 443497}, {\'name\': \'Érudit tolarian\', \'type\': \'Créature : humain et sorcier\', \'flavor\': "Les Académies tolarianes perpétuent la tradition d\'étude et de recherche, tout en décourageant les expériences dans la lignée de celles qui avaient ravagé la première île de Tolaria.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443766&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c02ae400-b255-4929-bd50-ff201a541802\', \'multiverseId\': 443766}, \'multiverseid\': 443766}, {\'name\': \'Studioso di Tolaria\', \'type\': \'Creatura — Mago Umano\', \'flavor\': "Le Accademie di Tolaria prediligono una tradizione di studio e ricerca, scoraggiando i generi di esperimenti che devastarono l\'isola originaria di Tolaria.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444035&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ef435098-5aca-477d-bb33-eba10e904261\', \'multiverseId\': 444035}, \'multiverseid\': 444035}, {\'name\': \'トレイリアの学者\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'トレイリアのアカデミーでは学術研究の伝統を堅持しつつも、かつてトレイリア島を滅ぼしたような実験は自粛している。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444304&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b1c52a85-6fba-4067-9643-e42722b5327f\', \'multiverseId\': 444304}, \'multiverseid\': 444304}, {\'name\': \'톨라리아 학자\', \'type\': \'생물 — 인간 마법사\', \'flavor\': \'톨라리아 아카데미는 학업과 연구의 전통을 받아들이지만, 과거 톨라리아의 섬을 황폐하게 만든 실험들은 금지하고 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444573&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5e2cdd25-dc22-4df0-84da-0aba8d11406f\', \'multiverseId\': 444573}, \'multiverseid\': 444573}, {\'name\': \'Escolástico Tolariano\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'As Academias Tolarianas abraçam uma tradição de estudo e pesquisa, enquanto desencorajam os tipos de experimentos que arruinaram a ilha original de Tolária.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444842&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c657035f-8c9c-4893-8c11-7717ec934977\', \'multiverseId\': 444842}, \'multiverseid\': 444842}, {\'name\': \'Толарианский Ученый\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'Толарианские Академии унаследовали традиции изысканий и исследований, но здесь не одобряются эксперименты, подобные тем, что когда-то привели к гибели острова Толария.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445111&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'96bd2047-3ce5-4afe-a09d-8e129a98b8bf\', \'multiverseId\': 445111}, \'multiverseid\': 445111}, {\'name\': \'陶拉里亚学者\', \'type\': \'生物 ～人类／法术师\', \'flavor\': \'陶拉里亚大学院主张以调查研究为常规，拒斥导致原陶拉里亚岛毁灭的那类实验。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445380&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'281e87f7-28d8-4366-af97-699e208fd96e\', \'multiverseId\': 445380}, \'multiverseid\': 445380}, {\'name\': \'陶拉里亞學者\', \'type\': \'生物 ～人類／魔法師\', \'flavor\': \'陶拉里亞大學院主張以調查研究為常規，拒斥導致原陶拉里亞島毀滅的那類實驗。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445649&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5b1fbfe2-2a57-4b70-897b-8b315c93e6cc\', \'multiverseId\': 445649}, \'multiverseid\': 445649}]', '[{\'name\': \'Torgaar, der fleischgewordene Hunger\', \'text\': \'Als zusätzliche Kosten, um diesen Zauberspruch zu wirken, kannst du eine beliebige Anzahl an Kreaturen opfern. Dieser Zauberspruch kostet beim Wirken für jede auf diese Weise geopferte Kreatur {2} weniger.\\nWenn Torgaar, der fleischgewordene Hunger, ins Spiel kommt, wird der Lebenspunktestand von bis zu einem Spieler deiner Wahl gleich der Hälfte seiner Startlebenspunktezahl, abgerundet.\', \'type\': \'Legendäre Kreatur — Avatar\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443265&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cb1c5172-5e07-4e2c-8d2d-21623f5ded48\', \'multiverseId\': 443265}, \'multiverseid\': 443265}, {\'name\': \'Torgaar, el Hambre Encarnada\', \'text\': \'Como coste adicional para lanzar este hechizo, puedes sacrificar cualquier cantidad de criaturas. Te cuesta {2} menos lanzar este hechizo por cada criatura sacrificada de esta manera.\\nCuando Torgaar, el Hambre Encarnada entre al campo de batalla, el total de vidas de hasta un jugador objetivo se convierte en la mitad de su total de vidas inicial, redondeando hacia abajo.\', \'type\': \'Criatura legendaria — Avatar\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443534&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d8ef62d5-80ee-4ff8-b470-a76449809e34\', \'multiverseId\': 443534}, \'multiverseid\': 443534}, {\'name\': \'Torgaar, famine incarnée\', \'text\': "En tant que coût supplémentaire pour lancer ce sort, vous pouvez sacrifier n\'importe quel nombre de créatures. Ce sort coûte {2} de moins à lancer pour chaque créature sacrifiée de cette manière.\\nQuand Torgaar, famine incarnée arrive sur le champ de bataille, ciblez jusqu\'à un joueur. Le total de points de vie de ce joueur devient la moitié de son total de points de vie de départ, arrondie à l\'unité inférieure.", \'type\': \'Créature légendaire : avatar\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443803&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'22938e8c-d4cc-4978-a448-379bbdf8108c\', \'multiverseId\': 443803}, \'multiverseid\': 443803}, {\'name\': \'Torgaar, Incarnazione della Carestia\', \'text\': \'Come costo addizionale per lanciare questa magia, puoi sacrificare un qualsiasi numero di creature. Questa magia costa {2} in meno per essere lanciata per ogni creatura sacrificata in questo modo.\\nQuando Torgaar, Incarnazione della Carestia entra nel campo di battaglia, scegli fino a un giocatore bersaglio. I suoi punti vita diventano metà dei suoi punti vita iniziali, arrotondati per difetto.\', \'type\': \'Creatura Leggendaria — Avatar\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444072&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d12bb0fb-353a-47dc-9d12-2c2c80d41156\', \'multiverseId\': 444072}, \'multiverseid\': 444072}, {\'name\': \'飢饉の具現、トルガール\', \'text\': \'この呪文を唱えるための追加コストとして、あなたは望む数のクリーチャーを生け贄に捧げてもよい。この呪文を唱えるためのコストは、これにより生け贄に捧げたクリーチャー１体につき{2}少なくなる。\\n飢饉の具現、トルガールが戦場に出たとき、プレイヤー最大１人を対象とする。そのプレイヤーのライフ総量は、そのプレイヤーの初期ライフ総量の端数を切り捨てた半分になる。\', \'type\': \'伝説のクリーチャー — アバター\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444341&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6ce31b07-f570-4f7e-8ad8-af7c791a32a0\', \'multiverseId\': 444341}, \'multiverseid\': 444341}, {\'name\': \'기아의 화신, 토르가르\', \'text\': \'이 주문을 발동하기 위한 추가비용으로, 당신은 생물을 원하는 만큼 희생할 수 있다. 이 주문은 이렇게 희생된 생물 한 개당 발동하는 데 {2}가 덜 든다.\\n기아의 화신, 토르가르가 전장에 들어올 때, 플레이어를 최대 한 명까지 목표로 정한다. 그 플레이어의 생명 총점은 게임 시작시의 생명 총점의 절반을 내림한 값이 된다.\', \'type\': \'전설적 생물 — 화신\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444610&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1b9f35c5-98cd-476b-abe4-09d73659fa32\', \'multiverseId\': 444610}, \'multiverseid\': 444610}, {\'name\': \'Torgaar, Penúria Incarnada\', \'text\': \'Como custo adicional para conjurar esta mágica, você pode sacrificar um número qualquer de criaturas. Esta mágica custa {2} a menos para ser conjurada para cada criatura sacrificada dessa forma.\\nQuando Torgaar, Penúria Incarnada, entra no campo de batalha, o total de pontos de vida de até um jogador alvo torna-se metade do total de pontos de vida inicial deste, arredondado para baixo.\', \'type\': \'Criatura Lendária — Avatar\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444879&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'241e6dea-edab-4fd5-9c34-a64473027d58\', \'multiverseId\': 444879}, \'multiverseid\': 444879}, {\'name\': \'Торгаар, Воплощение Голода\', \'text\': \'В качестве дополнительной стоимости разыгрывания этого заклинания вы можете пожертвовать любое количество существ. Разыгрывание этого заклинания стоит на {2} меньше за каждое существо, пожертвованное таким образом.\\nКогда Торгаар, Воплощение Голода выходит на поле битвы, количество жизней не более чем одного целевого игрока становится равным половине его начального количества жизней, округленной в меньшую сторону.\', \'type\': \'Легендарное Существо — Аватара\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445148&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c0ff4182-9c5e-4b71-b310-26eaa63d7058\', \'multiverseId\': 445148}, \'multiverseid\': 445148}, {\'name\': \'饥馑化身托迦尔\', \'text\': \'你可以牺牲任意数量的生物，以作为施放此咒语的额外费用。每以此法牺牲一个生物，此咒语便减少{2}来施放。\\n当饥馑化身托迦尔进战场时，至多一位目标牌手的总生命成为其起始总生命的一半，小数点后舍去。\', \'type\': \'传奇生物 ～圣者\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445417&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7a1cdb10-6aad-45ff-9248-4cd19e406f3a\', \'multiverseId\': 445417}, \'multiverseid\': 445417}, {\'name\': \'飢饉化身托迦爾\', \'text\': \'你可以犧牲任意數量的生物，以作為施放此咒語的額外費用。每以此法犧牲一個生物，此咒語便減少{2}來施放。\\n當飢饉化身托迦爾進戰場時，至多一位目標玩家的總生命成為其起始總生命的一半，小數點後捨去。\', \'type\': \'傳奇生物 ～聖者\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445686&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c6603ef3-09a1-45ae-aa7d-49d85899607d\', \'multiverseId\': 445686}, \'multiverseid\': 445686}]', '[{\'name\': \'Tragischer Dichter\', \'text\': \'{T}, opfere den Tragischen Dichter: Bringe eine Verzauberungskarte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Kreatur — Mensch\', \'flavor\': \'„In einer Welt, deren Wunden langsam heilen, schreibe ich — ich, deren Wunden niemals heilen werden. Meine Erinnerungen sollen mein Erbe sein: Wähle aus tausend Gedanken einen und bewahre meinen Namen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443194&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bd7d0447-e216-40a8-aab5-bffb76e0a893\', \'multiverseId\': 443194}, \'multiverseid\': 443194}, {\'name\': \'Poetisa trágica\', \'text\': \'{T}, sacrificar la Poetisa trágica: Regresa la carta de encantamiento objetivo de tu cementerio a tu mano.\', \'type\': \'Criatura — Humano\', \'flavor\': \'"Escribo desde un mundo que se cura, yo, que jamás me curaré. Que mi último don sea el del recuerdo: de entre mil pensamientos perdidos, elige uno y recuerda mi nombre".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443463&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'20252598-d111-48f1-9d35-7909f68cf255\', \'multiverseId\': 443463}, \'multiverseid\': 443463}, {\'name\': \'Poétesse tragique\', \'text\': "{T}, sacrifiez la Poétesse tragique : Renvoyez la carte d\'enchantement ciblée depuis votre cimetière dans votre main.", \'type\': \'Créature : humain\', \'flavor\': "« Dans un monde en voie de guérison, j\'écris, moi qui ne serai jamais guérie. Que mon dernier don soit un souvenir : parmi des milliers de pensées égarées, choisissez-en une, et souvenez-vous de mon nom. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443732&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9b6da286-604f-4325-92e0-f2084f1aaa6e\', \'multiverseId\': 443732}, \'multiverseid\': 443732}, {\'name\': \'Poetessa Tragica\', \'text\': \'{T}, Sacrifica la Poetessa Tragica: Riprendi in mano una carta incantesimo bersaglio dal tuo cimitero.\', \'type\': \'Creatura — Umano\', \'flavor\': \'"In un mondo che sta guarendo io scrivo... Io, che non potrò mai guarire. Possa il mio ultimo dono essere un ricordo: tra mille pensieri perduti, scegline uno e rimembra il mio nome."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444001&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c2c2f9b8-7355-4f7b-a5cd-3441861f7520\', \'multiverseId\': 444001}, \'multiverseid\': 444001}, {\'name\': \'もの悲しい詩人\', \'text\': \'{T}, もの悲しい詩人を生け贄に捧げる：あなたの墓地からエンチャント・カード１枚を対象とし、それをあなたの手札に戻す。\', \'type\': \'クリーチャー — 人間\', \'flavor\': \'「すべてを癒すこの世界に書き残そう。決して癒されることのない私が。最後の贈り物は思い出にしよう。失われた千の想いの中から。一つ選んで、私の名前を思い出して欲しい。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444270&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e7975ea5-2ea9-46a3-a57f-f50da0a98b5d\', \'multiverseId\': 444270}, \'multiverseid\': 444270}, {\'name\': \'비극적인 시인\', \'text\': \'{T}, 비극적인 시인을 희생한다: 당신의 무덤에 있는 부여마법 카드를 목표로 정한다. 그 카드를 당신의 손으로 되돌린다.\', \'type\': \'생물 — 인간\', \'flavor\': \'"내가 쓰는 치유의 세상에, 나 스스로는 결코 치유되지 못하리. 내 마지막 선물이 기억의 하나가 되기를. 잊혀진 수천의 생각 중에 하나를 택하고, 나의 이름을 기억해주기를."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444539&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c7dfc40d-d212-4d47-9c06-53b3a0cbba65\', \'multiverseId\': 444539}, \'multiverseid\': 444539}, {\'name\': \'Poetisa Trágica\', \'text\': \'{T}, sacrifique Poetisa Trágica: Devolva o card de encantamento alvo de seu cemitério para sua mão.\', \'type\': \'Criatura — Humano\', \'flavor\': \'"Em um mundo convalescente escrevo — eu, que jamais serei curada. Que minha última dádiva seja uma de memória: de mil pensamentos perdidos, escolha um e lembre-se de meu nome."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444808&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3e9a33a4-a7a9-4233-b5bb-57252cd77b34\', \'multiverseId\': 444808}, \'multiverseid\': 444808}, {\'name\': \'Поэтесса-Трагик\', \'text\': \'{T}, пожертвуйте Поэтессу-Трагика: верните целевую карту чар из вашего кладбища в вашу руку.\', \'type\': \'Существо — Человек\', \'flavor\': \'«В исцеляющемся мире я кладу слова на бумагу — я, та, кого не исцелить. Пусть мой последний дар станет даром воспоминаний: из тысячи забытых мыслей выбери одну — и вспомни мое имя».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445077&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e791697f-9ab8-4bde-b445-fb5df6c16287\', \'multiverseId\': 445077}, \'multiverseid\': 445077}, {\'name\': \'悲剧诗人\', \'text\': \'{T}，牺牲悲剧诗人：将目标结界牌从你的坟墓场移回你手上。\', \'type\': \'生物 ～人类\', \'flavor\': \'「在此世间愈合之时，我这无可疗愈的人留下绝笔～愿我这份最终赠礼能永铭心间：散尽万千思绪唯留其一，忘却百般记忆独记吾名。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445346&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2b91a537-cac5-4af4-ad27-4d5f6a1f607f\', \'multiverseId\': 445346}, \'multiverseid\': 445346}, {\'name\': \'悲劇詩人\', \'text\': \'{T}，犧牲悲劇詩人：將目標結界牌從你的墳墓場移回你手上。\', \'type\': \'生物 ～人類\', \'flavor\': \'「在此世間癒合之時，我這無可療愈的人留下絕筆～願我這份最終贈禮能永銘心間：散盡萬千思緒唯留其一，忘卻百般記憶獨記吾名。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445615&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8662cec7-1aaa-41d6-9f65-6079d5d52259\', \'multiverseId\': 445615}, \'multiverseid\': 445615}]', "[{'name': 'Traxos, Plage von Kroog', 'text': 'Verursacht Trampelschaden\\nTraxos, Plage von Kroog, kommt getappt ins Spiel und enttappt nicht während deines Enttappsegments.\\nImmer wenn du einen historischen Zauberspruch wirkst, enttappe Traxos. (Legenden, Artefakte und Sagen sind historisch.)', 'type': 'Legendäre Artefaktkreatur — Konstrukt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443391&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd29cbe40-dc99-4ce2-8296-ede6b6b97614', 'multiverseId': 443391}, 'multiverseid': 443391}, {'name': 'Traxos, azote de Kroog', 'text': 'Arrolla.\\nTraxos, azote de Kroog entra al campo de batalla girado y no se endereza durante tu paso de enderezar.\\nSiempre que lances un hechizo histórico, endereza a Traxos. (Los artefactos, las Sagas y las cartas legendarias son cartas históricas.)', 'type': 'Criatura artefacto legendaria — Constructo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443660&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '0b52d822-32f5-4680-9c6a-2b3658a2622c', 'multiverseId': 443660}, 'multiverseid': 443660}, {'name': 'Traxos, fléau de Kroog', 'text': 'Piétinement\\nTraxos, fléau de Kroog arrive sur le champ de bataille engagé et ne se dégage pas pendant votre étape de dégagement.\\nÀ chaque fois que vous lancez un sort historique, dégagez Traxos. (Les artefacts, les légendaires et les sagas sont historiques.)', 'type': 'Créature-artefact légendaire : construction', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443929&type=card', 'language': 'French', 'identifiers': {'scryfallId': '7253f847-6606-4d44-a6e9-61dc7af07451', 'multiverseId': 443929}, 'multiverseid': 443929}, {'name': 'Traxos, Flagello di Kroog', 'text': 'Travolgere\\nTraxos, Flagello di Kroog entra nel campo di battaglia TAPpato e non STAPpa durante il tuo STAP.\\nOgniqualvolta lanci una magia storica, STAPpa Traxos. (Artefatti, carte leggendarie e Saghe sono carte storiche.)', 'type': 'Creatura Artefatto Leggendaria — Costrutto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444198&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '6de87448-ef0a-4277-bbad-f0cb4df22ae1', 'multiverseId': 444198}, 'multiverseid': 444198}, {'name': 'クルーグの災い魔、トラクソス', 'text': 'トランプル\\nクルーグの災い魔、トラクソスはタップ状態で戦場に出て、あなたのアンタップ・ステップにアンタップしない。\\nあなたが歴史的な呪文を唱えるたび、クルーグの災い魔、トラクソスをアンタップする。（歴史的とは、アーティファクトと伝説と英雄譚のことである。）', 'type': '伝説のアーティファクト・クリーチャー — 構築物', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444467&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'dfa602e4-2a17-4d9a-84c8-f28a44900ac9', 'multiverseId': 444467}, 'multiverseid': 444467}, {'name': '크룩의 재앙, 트락소스', 'text': '돌진\\n크룩의 재앙, 트락소스는 탭된 채로 전장에 들어오고 당신의 언탭단에 언탭되지 않는다.\\n당신이 역사적 주문을 발동할 때마다 트락소스를 언탭한다. (마법물체와 전설적, 서사시가 역사적이다.)', 'type': '전설적 마법물체 생물 — 자동기계', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444736&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '7a95ea72-2429-4ff5-a2b1-e3289ec56cb1', 'multiverseId': 444736}, 'multiverseid': 444736}, {'name': 'Traxos, Flagelo de Kroog', 'text': 'Atropelar\\nTraxos, Flagelo de Kroog, entra no campo de batalha virado e não desvira durante sua etapa de desvirar.\\nToda vez que conjurar uma mágica histórica, desvire Traxos. (Os artefatos, os cards lendários e as Sagas são cards históricos.)', 'type': 'Criatura Artefato Lendária — Constructo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445005&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '54385d1a-9e65-466f-90c2-fb148022003c', 'multiverseId': 445005}, 'multiverseid': 445005}, {'name': 'Тракс, Бич Кроога', 'text': 'Пробивной удар\\nТракс, Бич Кроога выходит на поле битвы повернутым и не разворачивается во время вашего шага разворота.\\nКаждый раз, когда вы разыгрываете историческое заклинание, разверните Тракса. (Артефакты, легендарные карты и Саги являются историческими.)', 'type': 'Легендарный Артефакт Существо — Конструкция', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445274&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '4dabc886-43c2-4bd8-a073-62d1d099218c', 'multiverseId': 445274}, 'multiverseid': 445274}, {'name': '萼城劫运刹索斯', 'text': '践踏\\n萼城劫运刹索斯须横置进战场，且于你的重置步骤中不能重置。\\n每当你施放史迹咒语时，重置刹索斯。（神器、传奇和传纪是史迹。）', 'type': '传奇神器生物 ～组构体', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445543&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f9949847-c0c7-46e2-8d6f-39db04807e1c', 'multiverseId': 445543}, 'multiverseid': 445543}, {'name': '萼城劫運剎索斯', 'text': '踐踏\\n萼城劫運剎索斯須橫置進戰場，且於你的重置步驟中不能重置。\\n每當你施放史跡咒語時，重置剎索斯。（神器、傳奇和傳紀是史跡。）', 'type': '傳奇神器生物 ～組構體', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445812&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '0929d2db-262f-4de6-9751-b8be345bc648', 'multiverseId': 445812}, 'multiverseid': 445812}]", '[{\'name\': \'Turnierlanze\', \'text\': \'Die ausgerüstete Kreatur erhält +2/+0.\\nSolange es dein Zug ist, hat die ausgerüstete Kreatur Erstschlag.\\nAusrüsten {3} ({3}: Lege diese Karte an eine Kreatur deiner Wahl an, die du kontrollierst. Spiele Ausrüsten wie eine Hexerei.)\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443378&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2afc26cb-f5a6-4d0a-ae81-2ef59e16e417\', \'multiverseId\': 443378}, \'multiverseid\': 443378}, {\'name\': \'Lanza de justas\', \'text\': \'La criatura equipada obtiene +2/+0.\\nMientras sea tu turno, la criatura equipada tiene la habilidad de dañar primero.\\nEquipar {3}. ({3}: Anexa este Equipo a la criatura objetivo que controlas. Activa la habilidad de equipar como un conjuro.)\', \'type\': \'Artefacto — Equipo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443647&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8b724df3-083a-48d7-8c48-dd6c5c2574ad\', \'multiverseId\': 443647}, \'multiverseid\': 443647}, {\'name\': \'Lance de joute\', \'text\': "La créature équipée gagne +2/+0.\\nTant que c\'est votre tour, la créature équipée a l\'initiative.\\nÉquipement {3} ({3} : Attachez à la créature ciblée que vous contrôlez. N\'attachez l\'équipement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Artefact : équipement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443916&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b8ec7f56-c577-482b-9083-b123bcd2007a\', \'multiverseId\': 443916}, \'multiverseid\': 443916}, {\'name\': \'Lancia da Giostra\', \'text\': \'La creatura equipaggiata prende +2/+0.\\nFintanto che è il tuo turno, la creatura equipaggiata ha attacco improvviso.\\nEquipaggiare {3} ({3}: Assegna a una creatura bersaglio che controlli. Equipaggia solo quando potresti lanciare una stregoneria.)\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444185&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b0962c4c-62cc-4e4d-a551-9367832ba0b1\', \'multiverseId\': 444185}, \'multiverseid\': 444185}, {\'name\': \'馬上槍\', \'text\': \'装備しているクリーチャーは＋２/＋０の修整を受ける。\\nあなたのターンであるかぎり、装備しているクリーチャーは先制攻撃を持つ。\\n装備{3}（{3}：あなたがコントロールしているクリーチャー１体を対象とし、これをそれにつける。装備はソーサリーとしてのみ行う。）\', \'type\': \'アーティファクト — 装備品\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444454&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'acf739b8-c4a2-4996-ad2b-77aae633503d\', \'multiverseId\': 444454}, \'multiverseid\': 444454}, {\'name\': \'마상시합용 창\', \'text\': \'장착된 생물은 +2/+0을 받는다.\\n당신의 턴인 한, 장착된 생물은 선제공격을 가진다.\\n장착 {3} ({3}: 당신이 조종하는 생물을 목표로 정한다. 그 생물에 이 장비를 부착한다. 당신이 집중마법을 발동할 수 있는 시기에만 장착할 수 있다.)\', \'type\': \'마법물체 — 장비\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444723&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'eeac4600-9e04-4525-a3d4-2f4ea9af1e2c\', \'multiverseId\': 444723}, \'multiverseid\': 444723}, {\'name\': \'Lança de Justa\', \'text\': \'A criatura equipada recebe +2/+0.\\nEnquanto for o seu turno, a criatura equipada terá iniciativa.\\nEquipar {3} ({3}: Anexe-o à criatura alvo que você controla. Equipe somente como um feitiço.)\', \'type\': \'Artefato — Equipamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444992&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'85389a59-9e72-4dfa-a3be-f0adb5b6dc26\', \'multiverseId\': 444992}, \'multiverseid\': 444992}, {\'name\': \'Турнирное Копье\', \'text\': \'Снаряженное существо получает +2/+0.\\nПока длится ваш ход, снаряженное существо имеет Первый удар.\\nСнарядить {3} ({3}: прикрепите к целевому существу под вашим контролем. Снаряжайте только как волшебство.)\', \'type\': \'Артефакт — Снаряжение\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445261&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c749a90c-e16b-4882-a463-948a1938553a\', \'multiverseId\': 445261}, \'multiverseid\': 445261}, {\'name\': \'骑枪\', \'text\': \'佩带此武具的生物得+2/+0。\\n只要是在你的回合中，佩带此武具的生物便具有先攻异能。\\n佩带{3}（{3}：装备在目标由你操控的生物上。佩带的时机视同法术。）\', \'type\': \'神器 ～武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445530&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e162aebf-3c37-4d21-bd8c-74d8ee753a2d\', \'multiverseId\': 445530}, \'multiverseid\': 445530}, {\'name\': \'騎槍\', \'text\': \'佩帶此武具的生物得+2/+0。\\n只要是在你的回合中，佩帶此武具的生物便具有先攻異能。\\n佩帶{3}（{3}：裝備在目標由你操控的生物上。佩帶的時機視同巫術。）\', \'type\': \'神器 ～武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445799&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'69ac6fda-5963-4277-9c3c-9fb33cb37cbb\', \'multiverseId\': 445799}, \'multiverseid\': 445799}]', '[{\'name\': \'Unerschütterlicher Wille\', \'text\': \'Eine Kreatur deiner Wahl erhält +2/+2 und Unzerstörbarkeit bis zum Ende des Zuges. (Schaden und Effekte, die „zerstören", zerstören sie nicht.)\', \'type\': \'Spontanzauber\', \'flavor\': \'Es brauchte ein Jahr, um diesen Schild herzustellen, einen Monat, um ihn zu verzaubern und ein Jahrzehnt, um den Umgang damit zu meistern — und das alles für einen glorreichen Augenblick.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443159&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cd9007da-e9b4-4e39-892d-53c4655180c6\', \'multiverseId\': 443159}, \'multiverseid\': 443159}, {\'name\': \'Voluntad inflexible\', \'text\': \'La criatura objetivo obtiene +2/+2 y gana la habilidad de indestructible hasta el final del turno. (El daño y los efectos que dicen "destruir" no la destruyen.)\', \'type\': \'Instantáneo\', \'flavor\': \'Llevó un año fabricar el escudo, un mes encantarlo y una década aprender a usarlo; todo para un único momento glorioso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443428&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'df9c1202-9093-4724-bb1b-f8177972e539\', \'multiverseId\': 443428}, \'multiverseid\': 443428}, {\'name\': \'Volonté inflexible\', \'text\': "La créature ciblée gagne +2/+2 et acquiert l\'indestructible jusqu\'à la fin du tour. (Les blessures et les effets qui disent « détruisez » ne la détruisent pas.)", \'type\': \'Éphémère\', \'flavor\': "Il fallut un an pour façonner ce bouclier, un mois pour l\'enchanter et une décennie pour le maîtriser. Tout cela pour un seul moment de gloire.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443697&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d9ddfd12-785c-4768-a910-50e321eabccd\', \'multiverseId\': 443697}, \'multiverseid\': 443697}, {\'name\': \'Volontà Adamantina\', \'text\': \'Una creatura bersaglio prende +2/+2 e ha indistruttibile fino alla fine del turno. (Il danno e gli effetti che dicono "distruggi" non la distruggono.)\', \'type\': \'Istantaneo\', \'flavor\': \'Per forgiare lo scudo ci volle un anno, per incantarlo un mese, per padroneggiarlo alla perfezione un decennio: tutto per un unico momento di gloria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443966&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c2a8e1eb-233c-4599-b6b0-80d965b29d19\', \'multiverseId\': 443966}, \'multiverseid\': 443966}, {\'name\': \'不屈の意志\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋２/＋２の修整を受けるとともに破壊不能を得る。（ダメージや「破壊」と書かれた効果では、それは破壊されない。）\', \'type\': \'インスタント\', \'flavor\': \'この盾の製作に１年、魔法を掛けるのに１か月を費やした。使いこなせるまでには10年の歳月が必要だった。それはすべて、この一瞬のためである。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444235&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'83c1e0a6-40e1-4a70-9085-93a6b00b278b\', \'multiverseId\': 444235}, \'multiverseid\': 444235}, {\'name\': \'단호한 의지\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 +2/+2를 받고 무적을 얻는다. (피해와 "파괴"라고 명시된 효과로 파괴되지 않는다.)\', \'type\': \'순간마법\', \'flavor\': \'방패는 제작하는 데 1년이 걸리고, 마법을 부여하는 데 한 달이 걸리며, 숙달되는 데 10년이 걸린다—이 모든 것이 영광스러운 한 순간을 위해서이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444504&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e70d4b40-b2cb-4ca3-a790-c7aa0a52b52f\', \'multiverseId\': 444504}, \'multiverseid\': 444504}, {\'name\': \'Vontade Adamantina\', \'text\': \'A criatura alvo recebe +2/+2 e ganha indestrutível até o final do turno. (Dano e efeitos que dizem "destrua" não a destroem.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'O escudo levou um ano para ser feito, um mês para ser encantado, e uma década para ser dominado — tudo por um glorioso momento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444773&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'46fb45f8-6847-4607-9cac-d9f341f3d81f\', \'multiverseId\': 444773}, \'multiverseid\': 444773}, {\'name\': \'Непреклонная Воля\', \'text\': \'Целевое существо получает +2/+2 и Неразрушимость до конца хода. (Повреждения и эффекты с указанием «уничтожьте» не уничтожают его.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Год на то, чтобы выковать щит, месяц на то, чтобы наложить на него чары, и десятилетие на то, чтобы научиться мастерски владеть им, — все ради одного момента славы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445042&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f7620188-630e-45fe-b15a-3377c5b68761\', \'multiverseId\': 445042}, \'multiverseid\': 445042}, {\'name\': \'坚定意志\', \'text\': \'目标生物得+2/+2且获得不灭异能直到回合结束。（伤害与注明「消灭」的效应不会将它消灭。）\', \'type\': \'瞬间\', \'flavor\': \'这面盾牌耗经一年打造，历时一月施魔，苦练十年掌握～就为等一个荣光时刻。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445311&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'af3095ff-e85e-4c03-a15a-6a963491ae64\', \'multiverseId\': 445311}, \'multiverseid\': 445311}, {\'name\': \'堅定意志\', \'text\': \'目標生物得+2/+2且獲得不滅異能直到回合結束。（傷害與註明「消滅」的效應不會將它消滅。)\', \'type\': \'瞬間\', \'flavor\': \'這面盾牌耗經一年打造，歷時一月施魔，苦練十年掌握～就為等一個榮光時刻。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445580&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'158dd418-c53d-42bc-921b-f3e100c88cdc\', \'multiverseId\': 445580}, \'multiverseid\': 445580}]', "[{'name': 'Ungezähmter Kavu', 'text': 'Bonus {3} (Du kannst zusätzlich {3} bezahlen, sowie du diesen Zauberspruch wirkst.)\\nWachsamkeit, verursacht Trampelschaden\\nFalls die Bonuskosten des Ungezähmten Kavu bezahlt wurden, kommt er mit drei +1/+1-Marken ins Spiel.', 'type': 'Kreatur — Kavu', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443343&type=card', 'language': 'German', 'identifiers': {'scryfallId': '93062ff4-dfe5-495c-abdf-00fa62d5cf1a', 'multiverseId': 443343}, 'multiverseid': 443343}, {'name': 'Kavu silvestre', 'text': 'Estímulo {3}. (Puedes pagar {3} adicionales al lanzar este hechizo.)\\nVigilancia, arrolla.\\nSi el Kavu silvestre fue estimulado, entra al campo de batalla con tres contadores +1/+1 sobre él.', 'type': 'Criatura — Kavu', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443612&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '10c98858-7439-4d81-aa94-530af19c8da2', 'multiverseId': 443612}, 'multiverseid': 443612}, {'name': 'Kavru sauvage', 'text': 'Kick {3} (Vous pouvez payer {3} supplémentaires au moment où vous lancez ce sort.)\\nVigilance, piétinement\\nSi le Kavru sauvage a été kické, il arrive sur le champ de bataille avec trois marqueurs +1/+1 sur lui.', 'type': 'Créature : kavru', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443881&type=card', 'language': 'French', 'identifiers': {'scryfallId': '31febe09-2f04-40de-ace7-98b19db438fd', 'multiverseId': 443881}, 'multiverseid': 443881}, {'name': 'Kavu Indomabile', 'text': 'Potenziamento {3} (Puoi pagare {3} addizionale mentre lanci questa magia.)\\nCautela, travolgere\\nSe il Kavu Indomabile è stato potenziato, entra nel campo di battaglia con tre segnalini +1/+1.', 'type': 'Creatura — Kavu', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444150&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a4c02e78-aeb5-40ca-a65a-68d69b555bdf', 'multiverseId': 444150}, 'multiverseid': 444150}, {'name': '荒々しいカヴー', 'text': 'キッカー{3}（あなたはこの呪文を唱えるに際し、追加で{3}を支払ってもよい。）\\n警戒、トランプル\\n荒々しいカヴーがキッカーされていたなら、これは＋１/＋１カウンターが３個置かれた状態で戦場に出る。', 'type': 'クリーチャー — カヴー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444419&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'bb2a328f-49ec-48ab-8e9d-37ad2d0958c7', 'multiverseId': 444419}, 'multiverseid': 444419}, {'name': '길들여지지 않은 카부', 'text': '키커 {3} (당신은 이 주문을 발동하면서 추가로 {3}을 지불할 수 있다.)\\n경계, 돌진\\n길들여지지 않은 카부의 키커 비용이 지불되었다면, 길들여지지 않은 카부는 +1/+1 카운터 세 개를 가지고 전장에 들어온다.', 'type': '생물 — 카부', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444688&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '7344ab44-ff26-4257-b4cd-bbdc776b6de6', 'multiverseId': 444688}, 'multiverseid': 444688}, {'name': 'Kavu Indomado', 'text': 'Reforçar {3} (Você pode pagar um custo adicional de {3} ao conjurar esta mágica.)\\nVigilância, atropelar\\nSe Kavu Indomado foi reforçado, ele entra no campo de batalha com três marcadores +1/+1.', 'type': 'Criatura — Kavu', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444957&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c994cace-f991-4864-adac-ec20847fea07', 'multiverseId': 444957}, 'multiverseid': 444957}, {'name': 'Необузданный Каву', 'text': 'Усилитель {3} (При разыгрывании этого заклинания вы можете дополнительно заплатить {3}.)\\nБдительность, Пробивной удар\\nЕсли Необузданный Каву получил Усилитель, он выходит на поле битвы с тремя жетонами +1/+1 на нем.', 'type': 'Существо — Каву', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445226&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'a3e7c634-4849-45ac-b600-ce29570473fa', 'multiverseId': 445226}, 'multiverseid': 445226}, {'name': '野性卡甫', 'text': '增幅{3}（你施放此咒语时可以额外支付{3}。）\\n警戒，践踏\\n如果野性卡甫已增幅，则它进战场时上面有三个+1/+1指示物。', 'type': '生物 ～卡甫', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445495&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a6d70ede-a5d9-40ab-9a34-66866790f1f6', 'multiverseId': 445495}, 'multiverseid': 445495}, {'name': '野性卡甫', 'text': '增幅{3}（你施放此咒語時可以額外支付{3}。）\\n警戒，踐踏\\n如果野性卡甫已增幅，它進戰場時上面有三個+1/+1指示物。', 'type': '生物 ～卡甫', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445764&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '00c3738a-255f-4c63-b271-e3f86c5b50fa', 'multiverseId': 445764}, 'multiverseid': 445764}]", "[{'name': 'Unterbinden', 'text': 'Neutralisiere einen Zauberspruch deiner Wahl, es sei denn, sein Beherrscher bezahlt {X}. Falls der Zauberspruch auf diese Weise neutralisiert wird, schicke ihn ins Exil, anstatt ihn auf den Friedhof seines Besitzers zu legen.', 'type': 'Spontanzauber', 'flavor': 'Der Feuerzauber geriet ins Stocken und brach in sich zusammen. Seine Komponenten erreichten Teferi vollkommen verzerrt und ohne Wirkung.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443224&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c1b319af-5d37-4748-bd41-79371ab879d3', 'multiverseId': 443224}, 'multiverseid': 443224}, {'name': 'Sincopar', 'text': 'Contrarresta el hechizo objetivo a menos que su controlador pague {X}. Si ese hechizo es contrarrestado de esta manera, exílialo en vez de ponerlo en el cementerio de su propietario.', 'type': 'Instantáneo', 'flavor': 'El hechizo de fuego titiló y se deshizo. Sus fragmentos descompasados e insignificantes apenas rozaron a Teferi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443493&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'dcedc6e2-a6b0-4d20-b7f4-b61ad8be7e24', 'multiverseId': 443493}, 'multiverseid': 443493}, {'name': 'Syncope', 'text': 'Contrecarrez le sort ciblé à moins que son contrôleur ne paie {X}. Si ce sort est contrecarré de cette manière, exilez-le à la place de le mettre dans le cimetière de son propriétaire.', 'type': 'Éphémère', 'flavor': 'Le sort de feu crachota, puis éclata. Ses fragments atteignirent Téfeiri, dépourvus de rythme et de sens.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443762&type=card', 'language': 'French', 'identifiers': {'scryfallId': '0cd1d64b-4226-4b64-8238-9fe8b9e091cf', 'multiverseId': 443762}, 'multiverseid': 443762}, {'name': 'Sincopare', 'text': 'Neutralizza una magia bersaglio a meno che il suo controllore non paghi {X}. Se quella magia è neutralizzata in questo modo, esiliala invece di metterla nel cimitero del suo proprietario.', 'type': 'Istantaneo', 'flavor': 'La magia di fuoco sussultò e si spezzò. I suoi frammenti raggiunsero Teferi con ritmo scomposto, ormai insignificanti.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444031&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '8b5381f5-c763-4b02-8846-d2c012b7fbaa', 'multiverseId': 444031}, 'multiverseid': 444031}, {'name': '中略', 'text': '呪文１つを対象とする。それのコントローラーが{X}を支払わないかぎり、それを打ち消す。これによりその呪文が打ち消されたなら、それをオーナーの墓地に置く代わりに追放する。', 'type': 'インスタント', 'flavor': '火の呪文は口ごもるように砕けた。その破片はテフェリーに達したが、韻律が失われて何の意味も残っていなかった。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444300&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '72af2c4f-ae4b-422b-a4d3-e085ab0f0009', 'multiverseId': 444300}, 'multiverseid': 444300}, {'name': '중략', 'text': '주문을 목표로 정한다. 그 주문의 조종자가 {X}를 지불하지 않으면 그 주문을 무효화한다. 그 주문이 이런 식으로 무효화되면, 그 주문을 소유자의 무덤에 넣는 대신 추방한다.', 'type': '순간마법', 'flavor': '화염 주문은 힘을 잃고 깨졌다. 그 파편은 맥 없고 허무하게 테페리에게 닿았다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444569&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'abd21681-6ab4-4d68-9ccf-45bac3e3e021', 'multiverseId': 444569}, 'multiverseid': 444569}, {'name': 'Sincopar', 'text': 'Anule a mágica alvo, a menos que seu controlador pague {X}. Se aquela mágica for anulada dessa maneira, exile-a em vez de colocá-la no cemitério de seu dono.', 'type': 'Mágica Instantânea', 'flavor': 'A mágica de fogo vacilou e partiu-se. Seus fragmentos chegaram a Teferi arrítmicos e insignificantes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444838&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd3ef83b8-be0a-42af-9acf-5d9c58ed20fe', 'multiverseId': 444838}, 'multiverseid': 444838}, {'name': 'Синкопа', 'text': 'Отмените целевое заклинание, если только контролирующий его игрок не заплатит {X}. Если то заклинание отменяется таким образом, изгоните его вместо того, чтобы положить его на кладбище его владельца.', 'type': 'Мгновенное заклинание', 'flavor': 'Огненное заклинание запнулось и рассыпалось. Его осколки долетели до Тефери, потеряв ритм и смысл.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445107&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'c4d3adc6-0695-4396-b7e2-1df120d47b73', 'multiverseId': 445107}, 'multiverseid': 445107}, {'name': '切分', 'text': '除非目标咒语的操控者支付{X}，否则反击之。如果以此法反击该咒语，则改为将它放逐，而非置入其拥有者的坟墓场。', 'type': '瞬间', 'flavor': '这焰咒变得断续破碎。其残片袭向泰菲力时已全失节奏，了无意义。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445376&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9e19ebfc-3700-446a-a6b6-69810953b9b1', 'multiverseId': 445376}, 'multiverseid': 445376}, {'name': '切分', 'text': '除非目標咒語的操控者支付{X}，否則反擊之。如果以此法反擊該咒語，則改為將它放逐，而非置入其擁有者的墳墓場。', 'type': '瞬間', 'flavor': '這焰咒變得斷續破碎。其殘片襲向泰菲力時已全失節奏，了無意義。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445645&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '7fdee032-9289-4076-a9e0-1d71a6224f24', 'multiverseId': 445645}, 'multiverseid': 445645}]", '[{\'name\': \'Untergang der Thran\', \'text\': \'(Je eine Sagenmarke beim Ins-Spiel-Kommen und nach deinem Ziehsegment. Opfern nach III.)\\nI — Zerstöre alle Länder.\\nII, III — Jeder Spieler bringt zwei Länderkarten aus seinem Friedhof ins Spiel zurück.\', \'type\': \'Verzauberung — Sage\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443175&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fdf9dcc7-9154-4101-8f6b-74c8110cea1f\', \'multiverseId\': 443175}, \'multiverseid\': 443175}, {\'name\': \'Caída de los thran\', \'text\': \'(En cuanto esta Saga entre y después de tu paso de robar, agrega un contador de sabiduría. Sacrifícala después de III.)\\nI — Destruye todas las tierras.\\nII, III — Cada jugador regresa dos cartas de tierra de su cementerio al campo de batalla.\', \'type\': \'Encantamiento — Saga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443444&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2230fb71-b415-469e-bb35-21b24c5222f0\', \'multiverseId\': 443444}, \'multiverseid\': 443444}, {\'name\': "Chute de l\'Empire Thran", \'text\': \'(Au moment où cette saga arrive sur le champ de bataille et après votre étape de pioche, ajoutez un marqueur « sapience ». Sacrifiez après III.)\\nI — Détruisez tous les terrains.\\nII, III — Chaque joueur renvoie sur le champ de bataille deux cartes de terrain depuis son cimetière.\', \'type\': \'Enchantement : saga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443713&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c8ccb47e-1309-4037-978a-01b2c5b6dfce\', \'multiverseId\': 443713}, \'multiverseid\': 443713}, {\'name\': \'Caduta dei Thran\', \'text\': \'(Mentre questa Saga entra e dopo la tua sottofase di acquisizione, aggiungi un segnalino sapere. Sacrifica dopo III.)\\nI — Distruggi tutte le terre.\\nII, III — Ogni giocatore rimette sul campo di battaglia due carte terra dal proprio cimitero.\', \'type\': \'Incantesimo — Saga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443982&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8df331b1-d67a-44e5-856b-ef645949d156\', \'multiverseId\': 443982}, \'multiverseid\': 443982}, {\'name\': \'スランの崩落\', \'text\': \'（この英雄譚が出た際とあなたのドロー・ステップの後に、伝承カウンターを１個加える。IIIの後に、生け贄に捧げる。）\\nI ― 土地をすべて破壊する。\\nII, III ― 各プレイヤーはそれぞれ、自分の墓地から土地・カード２枚を戦場に戻す。\', \'type\': \'エンチャント — 英雄譚\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444251&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ed52ade9-27e4-4af2-ad9c-ff12314a108e\', \'multiverseId\': 444251}, \'multiverseid\': 444251}, {\'name\': \'트란의 몰락\', \'text\': \'(이 서사시가 들어오면서 그리고 당신의 뽑기단 후에, 전승 카운터 한 개를 추가한다. III 이후에 희생한다.)\\nI — 모든 대지를 파괴한다.\\nII, III — 각 플레이어는 자신의 무덤에서 대지 카드 두 장을 전장으로 되돌린다.\', \'type\': \'부여마법 — 서사시\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444520&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0540bd95-b821-4f1b-b200-95dfe4894332\', \'multiverseId\': 444520}, \'multiverseid\': 444520}, {\'name\': \'Queda dos Thran\', \'text\': \'(Conforme esta Saga entra e após sua etapa de compra, adicione um marcador de conhecimento. Sacrifique-a após III.)\\nI — Destrua todos os terrenos.\\nII, III — Cada jogador devolve dois cards de terreno do próprio cemitério ao campo de batalha.\', \'type\': \'Encantamento — Saga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444789&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5615f4fc-e7e8-4a5a-badc-6c7082b50500\', \'multiverseId\': 444789}, \'multiverseid\': 444789}, {\'name\': \'Падение Транов\', \'text\': \'(При выходе этой Саги и после вашего шага взятия карты добавьте один жетон знаний. Пожертвуйте после III.)\\nI — Уничтожьте все земли.\\nII, III — Каждый игрок возвращает две карты земель из своего кладбища на поле битвы.\', \'type\': \'Чары — Сага\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445058&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c1183f98-6745-471b-bc72-c1f4d7bbb2a4\', \'multiverseId\': 445058}, \'multiverseid\': 445058}, {\'name\': \'索蓝覆亡录\', \'text\': \'（于此传纪进战场时及于你抓牌步骤后，加一个学问指示物。到III后牺牲之。）\\nI — 消灭所有地。\\nII, III — 每位牌手各将两张地牌从其坟墓场移回战场。\', \'type\': \'结界 ～传纪\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445327&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f6aeffab-db15-4564-91ed-9b383816b70b\', \'multiverseId\': 445327}, \'multiverseid\': 445327}, {\'name\': \'索藍覆亡錄\', \'text\': \'（於此傳紀進戰場時及於你抽牌步驟後，加一個學問指示物。到III後犧牲之。）\\nI — 消滅所有地。\\nII, III — 每位玩家各將兩張地牌從其墳墓場移回戰場。\', \'type\': \'結界 ～傳紀\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445596&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2019c6e5-ee81-48e1-b6da-5bdf2a95f75d\', \'multiverseId\': 445596}, \'multiverseid\': 445596}]', '[{\'name\': \'Uralte Feindseligkeit\', \'text\': \'Lege eine +1/+1-Marke auf eine Kreatur deiner Wahl, die du kontrollierst, falls sie legendär ist. Dann kämpft sie gegen eine Kreatur deiner Wahl, die ein Gegner kontrolliert. (Jede dieser Kreaturen fügt der anderen Schadenspunkte in Höhe ihrer Stärke zu.)\', \'type\': \'Spontanzauber\', \'flavor\': \'Multanis Verstand kämpfte um Klarheit, und purer Zorn sorgte dafür, dass sich sein Körper erneut aufbaute.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443311&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'751ba739-411a-49d4-a845-4fb92194d5ae\', \'multiverseId\': 443311}, \'multiverseid\': 443311}, {\'name\': \'Animosidad arcana\', \'text\': \'Pon un contador +1/+1 sobre la criatura objetivo que controlas si es legendaria. Luego, lucha contra la criatura objetivo que controla un oponente. (Cada una hace una cantidad de daño igual a su fuerza a la otra.)\', \'type\': \'Instantáneo\', \'flavor\': \'La mente de Multani luchó por regresar a la consciencia mientras la propia ira reconstruía su cuerpo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443580&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3a68f710-82b0-48e8-ac61-1cb50e4782e3\', \'multiverseId\': 443580}, \'multiverseid\': 443580}, {\'name\': \'Animus ancien\', \'text\': "Mettez un marqueur +1/+1 sur une créature ciblée que vous contrôlez si elle est légendaire. Elle se bat ensuite contre une créature ciblée qu\'un adversaire contrôle. (Chacune inflige un nombre de blessures égal à sa force à l\'autre.)", \'type\': \'Éphémère\', \'flavor\': "L\'esprit de Multani s\'accrocha à la conscience tandis que la rage reconstituait son corps.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443849&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e14cad1b-7666-455f-9ac4-a073ce1eee2c\', \'multiverseId\': 443849}, \'multiverseid\': 443849}, {\'name\': \'Astio Antico\', \'text\': "Metti un segnalino +1/+1 su una creatura bersaglio che controlli, se è leggendaria. Poi essa lotta con una creatura bersaglio controllata da un avversario. (Ogni creatura infligge all\'altra danno pari alla propria forza.)", \'type\': \'Istantaneo\', \'flavor\': \'La mente di Multani cercò disperatamente di rimanere cosciente mentre la rabbia stessa ricomponeva il suo corpo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444118&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'feedf170-27d4-4102-bfdf-54910e8409dd\', \'multiverseId\': 444118}, \'multiverseid\': 444118}, {\'name\': \'古えの憎しみ\', \'text\': \'あなたがコントロールしているクリーチャー１体と、対戦相手がコントロールしているクリーチャー１体を対象とする。その前者が伝説であるなら、それの上に＋１/＋１カウンターを１個置く。その前者はその後者と格闘を行う。（それぞれはもう一方に自身のパワーに等しい点数のダメージを与える。）\', \'type\': \'インスタント\', \'flavor\': \'ムルタニの精神が意識を取り戻そうとするうちに、怒りが体を形作った。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444387&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'336e0b7c-9928-4e65-bfe2-cb76e6912cda\', \'multiverseId\': 444387}, \'multiverseid\': 444387}, {\'name\': \'고대의 적의\', \'text\': \'당신이 조종하는 생물과 상대가 조종하는 생물을 목표로 정한다. 첫번째 목표가 전설적이라면 그 생물에 +1/+1 카운터 한 개를 올려놓는다. 그런 다음 그 생물은 두 번째 목표와 싸운다. (각 생물은 서로에게 각자의 공격력만큼 피해를 입힌다.)\', \'type\': \'순간마법\', \'flavor\': \'분노가 스스로 그의 육신을 재건하는 동안, 물타니는 의식을 강하게 부여잡았다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444656&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'99f23bf9-4474-49d6-8664-5d9dd88d2c3a\', \'multiverseId\': 444656}, \'multiverseid\': 444656}, {\'name\': \'Animus Ancestral\', \'text\': \'Coloque um marcador +1/+1 na criatura alvo que você controla se ela for lendária. Em seguida, ela luta contra a criatura alvo que um oponente controla. (Cada uma causa à outra uma quantidade de dano igual ao próprio poder.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'A mente de Multani lutou para manter-se consciente enquanto a fúria reconstruía seu corpo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444925&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1cbd11bc-8421-40d6-ba13-a745d9d9508c\', \'multiverseId\': 444925}, \'multiverseid\': 444925}, {\'name\': \'Древняя Вражда\', \'text\': \'Положите один жетон +1/+1 на целевое существо под вашим контролем, если оно легендарное. Затем оно дерется с целевым существом под контролем оппонента. (Они наносят друг другу повреждения, равные своей силе.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Разум Мултани отчаянно стремился обрести сознание, а в это время первобытная ярость восстанавливала его тело.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445194&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5a4733ce-3991-45db-bb59-893d74839d8e\', \'multiverseId\': 445194}, \'multiverseid\': 445194}, {\'name\': \'远古原心\', \'text\': \'选择目标由你操控的生物。如果它是传奇，则在它上面放置一个+1/+1指示物。然后它与目标由对手操控的生物互斗。（它们各向对方造成等同于本身力量的伤害。）\', \'type\': \'瞬间\', \'flavor\': \'穆塔尼恢复知觉，而愤怒重塑了他的身躯。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445463&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8d4cc640-f07a-4f75-95eb-cc2c3787119a\', \'multiverseId\': 445463}, \'multiverseid\': 445463}, {\'name\': \'遠古原心\', \'text\': \'選擇目標由你操控的生物。如果它是傳奇，則在它上面放置一個+1/+1指示物。然後它與目標由對手操控的生物互鬥。（它們各向對方造成等同於本身力量的傷害。）\', \'type\': \'瞬間\', \'flavor\': \'穆塔尼恢復知覺，而憤怒重塑了他的身軀。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445732&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b976cd02-fbda-4d3d-8e3e-d297bef98c94\', \'multiverseId\': 445732}, \'multiverseid\': 445732}]', '[{\'name\': \'Urgoros der Seelenlose\', \'text\': \'Fliegend\\nImmer wenn Urgoros der Seelenlose einem Spieler Kampfschaden zufügt, wirft der Spieler eine zufällig bestimmte Karte ab. Falls er das nicht kann, ziehst du eine Karte.\', \'type\': \'Legendäre Kreatur — Specter\', \'flavor\': \'Wenn das Phantom am Himmel ist, sind stille Schreie aus der Stadt Vhelnish zu vernehmen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443266&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7a88ece3-662b-4870-92b2-66f2a3f5cedf\', \'multiverseId\': 443266}, \'multiverseid\': 443266}, {\'name\': \'Urgoros, el Vacío\', \'text\': \'Vuela.\\nSiempre que Urgoros, el Vacío haga daño de combate a un jugador, ese jugador descarta una carta al azar. Si el jugador no puede, tú robas una carta.\', \'type\': \'Criatura legendaria — Espectro\', \'flavor\': \'Mientras el ente surca el cielo, la ciudad de Vhelnish grita en silencio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443535&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4d8c79a6-5ecb-4729-a285-bb7285f61864\', \'multiverseId\': 443535}, \'multiverseid\': 443535}, {\'name\': \'Urgoros, Lui-qui-est-vide\', \'text\': "Vol\\nÀ chaque fois qu\'Urgoros, Lui-qui-est-vide inflige des blessures de combat à un joueur, ce joueur se défausse d\'une carte au hasard. S\'il ne peut pas le faire, vous piochez une carte.", \'type\': \'Créature légendaire : spectre\', \'flavor\': \'Lorsque le fantôme survole Vhelnish, les habitants de la ville crient en silence.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443804&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ab308c2d-b49a-423a-baca-ddef40441656\', \'multiverseId\': 443804}, \'multiverseid\': 443804}, {\'name\': \'Urgoros, il Vuoto\', \'text\': \'Volare\\nOgniqualvolta Urgoros, il Vuoto infligge danno da combattimento a un giocatore, quel giocatore scarta una carta a caso. Se non può farlo, tu peschi una carta.\', \'type\': \'Creatura Leggendaria — Spettro\', \'flavor\': \'Mentre il fantasma la sorvola, la città di Vhelnish urla in silenzio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444073&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cb2ee8db-b1c3-41ac-a97b-59db9a7b6448\', \'multiverseId\': 444073}, \'multiverseid\': 444073}, {\'name\': \'虚ろな者、アゴロス\', \'text\': \'飛行\\n虚ろな者、アゴロスがプレイヤー１人に戦闘ダメージを与えるたび、そのプレイヤーはカード１枚を無作為に選んで捨てる。そのプレイヤーがそうできないなら、あなたはカードを１枚引く。\', \'type\': \'伝説のクリーチャー — スペクター\', \'flavor\': \'その幻影が空に舞うとき、ヴェールニシュの街は無言の悲鳴を上げる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444342&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'438a3211-21d6-463a-a1bf-72e812179d1d\', \'multiverseId\': 444342}, \'multiverseid\': 444342}, {\'name\': \'공허한 자, 우르고로스\', \'text\': \'비행\\n공허한 자, 우르고로스가 플레이어에게 전투피해를 입힐 때마다, 그 플레이어는 무작위로 카드 한 장을 버린다. 그 플레이어가 그렇게 하지 못한다면, 당신은 카드 한 장을 뽑는다.\', \'type\': \'전설적 생물 — 스펙터\', \'flavor\': \'유령들이 하늘을 날아다니자, 벨니쉬의 도시는 고요한 비명을 질렀다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444611&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c0995f43-a60e-4dee-a429-3851ea53e510\', \'multiverseId\': 444611}, \'multiverseid\': 444611}, {\'name\': \'Urgoros, o Vazio\', \'text\': \'Voar\\nToda vez que Urgoros, o Vazio, causa dano de combate a um jogador, aquele jogador descarta um card aleatoriamente. Se o jogador não puder, você compra um card.\', \'type\': \'Criatura Lendária — Espectro\', \'flavor\': \'A cidade de Vhelnish grita em silêncio enquanto o fantasma a sobrevoa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444880&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'120be1e5-5bd0-44a4-92dc-d52c93ba72e0\', \'multiverseId\': 444880}, \'multiverseid\': 444880}, {\'name\': \'Ургорос, Пустотелый\', \'text\': \'Полет\\nКаждый раз, когда Ургорос, Пустотелый наносит боевые повреждения игроку, тот игрок сбрасывает одну случайно выбранную карту. Если игрок не может этого сделать, вы берете карту.\', \'type\': \'Легендарное Существо — Призрак\', \'flavor\': \'Когда призрак пролетает в небесах, город Вельниш разражается безмолвным криком.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445149&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'de3cf6e2-46ae-4240-b7b2-aa569a024e59\', \'multiverseId\': 445149}, \'multiverseid\': 445149}, {\'name\': \'虚无幽灵乌格洛\', \'text\': \'飞行\\n每当虚无幽灵乌格洛对任一牌手造成战斗伤害时，该牌手随机弃一张牌。若该牌手无法如此作，则你抓一张牌。\', \'type\': \'传奇生物 ～幽灵\', \'flavor\': \'当幽灵飞过天空，维尼席全城无声尖叫。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445418&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9d141f8e-c39a-4124-8ec2-70cb661e2a73\', \'multiverseId\': 445418}, \'multiverseid\': 445418}, {\'name\': \'虛無幽靈烏格洛\', \'text\': \'飛行\\n每當虛無幽靈烏格洛對任一玩家造成戰鬥傷害時，該玩家隨機棄一張牌。若該玩家無法如此作，則你抽一張牌。\', \'type\': \'傳奇生物 ～幽靈\', \'flavor\': \'當幽靈飛過天空，維尼席全城無聲尖叫。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445687&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c63fc799-b03e-4119-a652-b9750c8bed76\', \'multiverseId\': 445687}, \'multiverseid\': 445687}]', '[{\'name\': \'Urzas Zauberbuch\', \'text\': \'{3}, {T}: Ziehe eine Karte. Wirf dann eine Karte ab, es sei denn, du schickst eine historische Karte aus deinem Friedhof ins Exil. (Legenden, Artefakte und Sagen sind historisch.)\', \'type\': \'Artefakt\', \'flavor\': \'„Auch nur einen Band dieser Reihe in seiner Gänze zu studieren, ist eine Lebensaufgabe." —Naru Meha, die Meisterzauberin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443392&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'db9188ae-6b1d-45ea-871c-8e75b680f999\', \'multiverseId\': 443392}, \'multiverseid\': 443392}, {\'name\': \'Tomo de Urza\', \'text\': \'{3}, {T}: Roba una carta. Luego, descarta una carta a menos que exilies una carta histórica de tu cementerio. (Los artefactos, las Sagas y las cartas legendarias son cartas históricas.)\', \'type\': \'Artefacto\', \'flavor\': \'"Comprender de verdad un solo volumen puede ser el trabajo de toda una vida". —Naru Meha, maga experta\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443661&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'54972593-4762-4780-a2b5-d2288fb6854e\', \'multiverseId\': 443661}, \'multiverseid\': 443661}, {\'name\': "Grimoire d\'Urza", \'text\': "{3}, {T} : Piochez une carte. Ensuite, défaussez-vous d\'une carte à moins que vous n\'exiliez une carte historique de votre cimetière. (Les artefacts, les légendaires et les sagas sont historiques.)", \'type\': \'Artefact\', \'flavor\': "« L\'assimilation profonde d\'un seul volume peut être le travail de toute une vie. » —Naru Meha, maître sorcier", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443930&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c46aa5f0-f3d9-4444-9024-5fffb0674583\', \'multiverseId\': 443930}, \'multiverseid\': 443930}, {\'name\': \'Tomo di Urza\', \'text\': \'{3}, {T}: Pesca una carta. Poi scarta una carta a meno che non esili una carta storica dal tuo cimitero. (Artefatti, carte leggendarie e Saghe sono carte storiche.)\', \'type\': \'Artefatto\', \'flavor\': \'"Comprendere a fondo anche solo un volume può richiedere una vita intera." —Naru Meha, maga insegnante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444199&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ec759daa-6da7-4d94-9a76-5d252b70fb41\', \'multiverseId\': 444199}, \'multiverseid\': 444199}, {\'name\': \'ウルザの秘本\', \'text\': \'{3}, {T}：カードを１枚引く。その後、あなたがあなたの墓地から歴史的なカード１枚を追放しないかぎり、カード１枚を捨てる。（歴史的とは、アーティファクトと伝説と英雄譚のことである。）\', \'type\': \'アーティファクト\', \'flavor\': \'「一巻のみでも完全に理解しようと思ったら一生かかるだろう。」 ――練達の魔術師、ナル・メハ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444468&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e4cd40c8-7905-40dd-91af-f62bcb6e8d80\', \'multiverseId\': 444468}, \'multiverseid\': 444468}, {\'name\': \'우르자의 책\', \'text\': \'{3}, {T}: 카드 한 장을 뽑는다. 그 후, 당신이 무덤에서 역사적 카드 한 장을 추방하지 않는다면 카드 한 장을 버린다. (마법물체와 전설적, 서사시가 역사적이다.)\', \'type\': \'마법물체\', \'flavor\': \'"단 한 권을 완벽하게 이해하는 것도 필생의 업적이 될 수 있다네." —대마법사, 나루 메하\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444737&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d975f3f6-b9c6-4399-b9ea-82175cafa499\', \'multiverseId\': 444737}, \'multiverseid\': 444737}, {\'name\': \'Tomo de Urza\', \'text\': \'{3}, {T}: Compre um card. Em seguida, descarte um card, a menos que você exile um card histórico de seu cemitério. (Os artefatos, os cards lendários e as Sagas são cards históricos.)\', \'type\': \'Artefato\', \'flavor\': \'"Compreender verdadeiramente até mesmo um volume pode ser o trabalho de uma vida." — Naru Meha, maga mestra\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445006&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f965abe0-214d-4665-9fda-3310c261e941\', \'multiverseId\': 445006}, \'multiverseid\': 445006}, {\'name\': \'Манускрипт Урзы\', \'text\': \'{3}, {T}: возьмите карту. Затем сбросьте карту, если только вы не изгоните историческую карту из вашего кладбища. (Артефакты, легендарные карты и Саги являются историческими.)\', \'type\': \'Артефакт\', \'flavor\': \'«На то, чтобы в полной мере понять хотя бы один том, можно положить всю жизнь». — Нару Меха, верховная волшебница\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445275&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'50826430-9867-4f72-b075-2f969ac79484\', \'multiverseId\': 445275}, \'multiverseid\': 445275}, {\'name\': \'克撒的巨著\', \'text\': \'{3}，{T}：抓一张牌。然后除非你从你的坟墓场放逐一张史迹牌，否则弃一张牌。（神器、传奇和传纪是史迹。）\', \'type\': \'神器\', \'flavor\': \'「哪怕只是想究研其中一卷，也得投入毕生精力。」 ～魔法大师娜鲁梅哈\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445544&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d13438e3-0c56-4578-b84f-f68139b73904\', \'multiverseId\': 445544}, \'multiverseid\': 445544}, {\'name\': \'克撒的巨著\', \'text\': \'{3}，{T}：抽一張牌。然後除非你從你的墳墓場放逐一張史跡牌，否則棄一張牌。（神器、傳奇和傳紀是史跡。）\', \'type\': \'神器\', \'flavor\': \'「哪怕只是想究研其中一卷，也得投入畢生精力。」 ～魔法大師娜魯梅哈里\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445813&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7b41bfb3-7ad6-4293-91e5-5d0e20e65842\', \'multiverseId\': 445813}, \'multiverseid\': 445813}]', '[{\'name\': \'Urzas vernichtender Strahl\', \'text\': \'(Legendäre Hexereien kannst du nur wirken, falls du eine legendäre Kreatur oder einen legendären Planeswalker kontrollierst.)\\nSchicke alle nichtlegendären bleibenden Karten, die keine Länder sind, ins Exil.\', \'type\': \'Legendäre Hexerei\', \'flavor\': \'Vor vielen Jahrhunderten stürzte die Rache eines einzelnen Mannes die Welt in eisige Dunkelheit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443196&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f5c3a5dc-ac3b-44b2-8976-78afcf8a962b\', \'multiverseId\': 443196}, \'multiverseid\': 443196}, {\'name\': \'Ráfaga destructora de Urza\', \'text\': \'(Solo puedes lanzar un conjuro legendario si controlas una criatura o planeswalker legendario.)\\nExilia todos los permanentes que no sean tierra y que no sean legendarios.\', \'type\': \'Conjuro legendario\', \'flavor\': \'Hace siglos, la venganza de un solo hombre sumió el mundo en el frío y la oscuridad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443465&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9ba47e9d-60b4-4ae8-8860-5458865127cc\', \'multiverseId\': 443465}, \'multiverseid\': 443465}, {\'name\': "Salve désastreuse d\'Urza", \'text\': \'(Vous ne pouvez lancer un rituel légendaire que si vous contrôlez une créature légendaire ou un planeswalker.)\\nExilez tous les permanents non-terrain qui ne sont pas légendaires.\', \'type\': \'Rituel légendaire\', \'flavor\': "Il y a des siècles, la vengeance d\'un homme plongea le monde dans la glace et les ténèbres.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443734&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c6d9eade-4ff4-4cea-b9f8-b53a9684e910\', \'multiverseId\': 443734}, \'multiverseid\': 443734}, {\'name\': \'Esplosione Devastante di Urza\', \'text\': \'(Puoi lanciare una stregoneria leggendaria solo se controlli una creatura o un planeswalker leggendari.)\\nEsilia tutti i permanenti non terra che non sono leggendari.\', \'type\': \'Stregoneria Leggendaria\', \'flavor\': \'Secoli fa, la vendetta di un solo uomo fece precipitare il mondo nelle tenebre e nel gelo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444003&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'31e32698-b3ee-4a84-841f-97bf8b6420d1\', \'multiverseId\': 444003}, \'multiverseid\': 444003}, {\'name\': \'ウルザの殲滅破\', \'text\': \'（伝説のソーサリーは、あなたが伝説のクリーチャーか伝説のプレインズウォーカーをコントロールしているときにのみ唱えられる。）\\n伝説でなく土地でもないパーマネントをすべて追放する。\', \'type\': \'伝説のソーサリー\', \'flavor\': \'数世紀前、ある男の復讐が世界を氷と闇の内に閉じ込めた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444272&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'24b765cb-c07f-4279-a2e0-a5f1813d8e66\', \'multiverseId\': 444272}, \'multiverseid\': 444272}, {\'name\': \'우르자의 파괴 광선\', \'text\': \'(당신이 전설적 생물이나 플레인즈워커를 조종할 때만 전설적 집중마법을 발동할 수 있다.)\\n전설적이 아닌 대지가 아닌 지속물을 모두 추방한다.\', \'type\': \'전설적 집중마법\', \'flavor\': \'수 세기 전, 한 남자의 복수가 세상을 추위와 어둠 속으로 몰아넣었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444541&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'284edc6e-ebb9-499d-8a9e-551386c1e601\', \'multiverseId\': 444541}, \'multiverseid\': 444541}, {\'name\': \'Explosão Ruinosa de Urza\', \'text\': \'(Você só pode conjurar um feitiço lendário se controlar uma criatura lendária ou um planeswalker lendário.)\\nExile todas as permanentes que não sejam terrenos nem lendárias.\', \'type\': \'Feitiço Lendário\', \'flavor\': \'Séculos atrás, a vingança de um homem mergulhou o mundo em gelo e trevas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444810&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3f247f32-498b-42af-a73d-18658f5de9b6\', \'multiverseId\': 444810}, \'multiverseid\': 444810}, {\'name\': \'Разрушительный Взрыв Урзы\', \'text\': \'(Вы можете разыграть легендарное волшебство, только если контролируете легендарное существо или planeswalker-а.)\\nИзгоните все не являющиеся землями перманенты, которые не являются легендарными.\', \'type\': \'Легендарное Волшебство\', \'flavor\': \'Много веков назад месть одного человека погрузила весь мир в морозную тьму.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445079&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2db37b32-b565-40dd-a606-b29e2d0eba03\', \'multiverseId\': 445079}, \'multiverseid\': 445079}, {\'name\': \'克撒的毁世震荡\', \'text\': \'（只能于你操控传奇生物或鹏洛客时施放传奇法术。）\\n放逐所有不是传奇的非地永久物。\', \'type\': \'传奇法术\', \'flavor\': \'数世纪前，一人复仇之举将整个世界拖入冰天雪地的黑暗深渊。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445348&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b7586bd5-f7c5-4afa-94fe-00553e8a423f\', \'multiverseId\': 445348}, \'multiverseid\': 445348}, {\'name\': \'克撒的毀世震盪\', \'text\': \'（只能於你操控傳奇生物或鵬洛客時施放傳奇巫術。）\\n放逐所有不是傳奇的非地永久物。\', \'type\': \'傳奇巫術\', \'flavor\': \'數世紀前，一人復仇之舉將整個世界拖入冰天雪地的黑暗深淵。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445617&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'088b0a57-c903-4540-91cc-1db20ad9591e\', \'multiverseId\': 445617}, \'multiverseid\': 445617}]', '[{\'name\': \'Urzeitlicher Wurm\', \'type\': \'Kreatur — Wurm\', \'flavor\': \'„Man hört ihn aus einer Meile Entfernung. Aber bei seiner Körperlänge könnte er sich auch bereits direkt hinter dir befinden." —Jenson Carthalion, Yavimaya-Flüchtling\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443334&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ad7421ba-ef5c-4dec-9ee1-2afb3588e483\', \'multiverseId\': 443334}, \'multiverseid\': 443334}, {\'name\': \'Sierpe primordial\', \'type\': \'Criatura — Sierpe\', \'flavor\': \'"El sonido de su cola arrastrándose se escucha a más de un kilómetro, pero, si lo oyes, ten en cuenta que sus mandíbulas podrían estar medio kilómetro más cerca". —Jenson Carthalion, exiliado de Yavimaya\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443603&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'917882f1-4470-4821-8919-541c76df63bb\', \'multiverseId\': 443603}, \'multiverseid\': 443603}, {\'name\': \'Guivre primordiale\', \'type\': \'Créature : guivre\', \'flavor\': "« Ses battements de queue s\'entendent à plus d\'un kilomètre à la ronde. N\'oubliez jamais que sa gueule est peut-être déjà deux fois plus près. » —Jenson Carthalion, exilé de la Yavimaya", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443872&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'54306395-5e3b-4342-9118-ce646a5a32c0\', \'multiverseId\': 443872}, \'multiverseid\': 443872}, {\'name\': \'Wurm Primordiale\', \'type\': \'Creatura — Wurm\', \'flavor\': \'"Puoi sentire la sua coda sferzare il terreno da un miglio di distanza. Ricorda che le sue fauci potrebbero già essere mezzo miglio più vicine." —Jenson Carthalion, esule di Yavimaya\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444141&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c27d18ff-c3cb-446f-850a-f8b19c131702\', \'multiverseId\': 444141}, \'multiverseid\': 444141}, {\'name\': \'始源のワーム\', \'type\': \'クリーチャー — ワーム\', \'flavor\': \'「１マイル先からでも尾が地を打つ音が聞こえるはずだ。そのときには、口は半マイル先まで来ているかも知れないがね。」 ――ヤヴィマヤを追われた者、ジェンソン・カルサリオン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444410&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ec512f35-d9da-4aa4-9583-bfe39a2a4c4c\', \'multiverseId\': 444410}, \'multiverseid\': 444410}, {\'name\': \'태고의 웜\', \'type\': \'생물 — 웜\', \'flavor\': \'"놈의 꼬리가 시끄럽게 내는 소리는 아주 먼 거리에서도 들을 수 있지. 놈의 아가리가 이미 훨씬 가까이 왔을지도 모른다는 걸 항상 명심해." —야비마야의 추방자, 젠슨 카르탈리온\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444679&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3e88198a-4e0f-4d27-8623-50583bbb69f7\', \'multiverseId\': 444679}, \'multiverseid\': 444679}, {\'name\': \'Vorme Primordial\', \'type\': \'Criatura — Vorme\', \'flavor\': \'"Dá para ouvir a cauda batendo a mais de um quilômetro e meio. Não se esqueça de que a mandíbula já pode estar a metade da distância." — Jenson Carthalion, exilado de Yavimaya\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444948&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4bc4df3e-9434-4cfc-8c61-37448ac43e86\', \'multiverseId\': 444948}, \'multiverseid\': 444948}, {\'name\': \'Первородный Вурм\', \'type\': \'Существо — Вурм\', \'flavor\': \'«То, как он молотит хвостом по земле, слышно за милю. Не забывай, что его пасть может быть уже на полмили ближе». — Йенсон Карталион, явимайский изгнанник\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445217&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3fc3e149-b35b-44bd-aabc-88a300e2d762\', \'multiverseId\': 445217}, \'multiverseid\': 445217}, {\'name\': \'原初亚龙\', \'type\': \'生物 ～亚龙\', \'flavor\': \'「一哩外就能听到它的尾巴甩击声。请记得，这时它的巨颚可能距你不到半哩。」 ～亚维马雅黜人严森卡萨隆\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445486&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'35c0a6b4-c9e2-4c58-b7f2-330412c2dd2f\', \'multiverseId\': 445486}, \'multiverseid\': 445486}, {\'name\': \'原初亞龍\', \'type\': \'生物 ～亞龍\', \'flavor\': \'「一哩外就能聽到牠的尾巴甩擊聲。請記得，這時牠的巨顎可能距你不到半哩。」 ～亞維馬雅黜人嚴森卡薩隆\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445755&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d40d861e-9a54-4105-a743-264f7b6501c4\', \'multiverseId\': 445755}, \'multiverseid\': 445755}]', '[{\'name\': \'Valduk, Hüter der Flamme\', \'text\': \'Erzeuge zu Beginn des Kampfes in deinem Zug für jede Aura und jede Ausrüstung, die an Valduk, Hüter der Flamme, angelegt ist, einen 3/1 roten Elementarwesen-Kreaturenspielstein, der Eile hat und Trampelschaden verursacht. Schicke die Spielsteine zu Beginn des nächsten Endsegments ins Exil.\', \'type\': \'Legendäre Kreatur — Mensch, Schamane\', \'flavor\': \'Wenn der Hammer fällt, erwacht die Flamme.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443305&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'77e5f309-09f0-426a-b610-44cc00485738\', \'multiverseId\': 443305}, \'multiverseid\': 443305}, {\'name\': \'Valduk, guardián de la Llama\', \'text\': \'Al comienzo del combate en tu turno, por cada Aura y Equipo anexados a Valduk, guardián de la Llama, crea una ficha de criatura Elemental roja 3/1 con las habilidades de arrollar y prisa. Exilia esas fichas al comienzo del próximo paso final.\', \'type\': \'Criatura legendaria — Chamán humano\', \'flavor\': \'Cuando el martillo golpea, la Llama se despierta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443574&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cace0413-0a3b-4f79-86f6-a1ef1c915811\', \'multiverseId\': 443574}, \'multiverseid\': 443574}, {\'name\': \'Valduk, gardien de la Flamme\', \'text\': \'Au début du combat pendant votre tour, pour chaque aura et chaque équipement attachés à Valduk, gardien de la Flamme, créez un jeton de créature 3/1 rouge Élémental avec le piétinement et la célérité. Exilez ces jetons au début de la prochaine étape de fin.\', \'type\': \'Créature légendaire : humain et shamane\', \'flavor\': "Le marteau frappe. La Flamme s\'éveille.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443843&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9a35672e-cc32-453e-91e1-fdbbfecb859c\', \'multiverseId\': 443843}, \'multiverseid\': 443843}, {\'name\': \'Valduk, Custode della Fiamma\', \'text\': "All\'inizio del combattimento nel tuo turno, per ogni Aura ed Equipaggiamento assegnati a Valduk, Custode della Fiamma, crea una pedina creatura Elementale 3/1 rossa con travolgere e rapidità. Esilia quelle pedine all\'inizio della prossima sottofase finale.", \'type\': \'Creatura Leggendaria — Sciamano Umano\', \'flavor\': \'Il martello colpisce, la Fiamma si risveglia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444112&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'76781420-761f-4ba1-a89f-6c72bb084b60\', \'multiverseId\': 444112}, \'multiverseid\': 444112}, {\'name\': \'炎の番人、ヴァルダーク\', \'text\': \'あなたのターンの戦闘の開始時に、炎の番人、ヴァルダークにつけられているオーラや装備品１つにつき、トランプルと速攻を持つ赤の３/１のエレメンタル・クリーチャー・トークンを１体生成する。次の終了ステップの開始時に、それらのトークンを追放する。\', \'type\': \'伝説のクリーチャー — 人間・シャーマン\', \'flavor\': \'鎚で打ち、炎で覚醒する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444381&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1e53dd6d-6797-4dd2-a631-1d935eb9d61e\', \'multiverseId\': 444381}, \'multiverseid\': 444381}, {\'name\': \'불길의 수호자, 발둑\', \'text\': \'당신의 턴 전투시작에, 불길의 수호자, 발둑에게 부착된 마법진과 장비 한 개당, 돌진과 신속을 가진 3/1 적색 정령 생물 토큰 한 개를 만든다 다음 종료단 시작에 그 토큰들을 추방한다.\', \'type\': \'전설적 생물 — 인간 주술사\', \'flavor\': \'망치가 부딪힌다. 불꽃이 일어난다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444650&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'efa7dfd8-3da6-4f09-9041-e66eb839f7b8\', \'multiverseId\': 444650}, \'multiverseid\': 444650}, {\'name\': \'Valduk, Guardião da Chama\', \'text\': \'No início do combate no seu turno, para cada Aura e Equipamento anexado a Valduk, Guardião da Chama, crie uma ficha de criatura vermelha 3/1 do tipo Elemental com atropelar e ímpeto. Exile aquelas fichas no início da próxima etapa final.\', \'type\': \'Criatura Lendária — Humano Xamã\', \'flavor\': \'Quando o martelo golpeia, a Chama desperta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444919&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a57d4f1c-11cb-4a10-a81c-0da86c5e53ee\', \'multiverseId\': 444919}, \'multiverseid\': 444919}, {\'name\': \'Вальдук, Хранитель Огня\', \'text\': \'В начале боя во время вашего хода создайте одну фишку существа 3/1 красный Элементаль с Пробивным ударом и Ускорением за каждую Ауру и Снаряжение, прикрепленные к Вальдуку, Хранителю Огня. Изгоните те фишки в начале следующего заключительного шага.\', \'type\': \'Легендарное Существо — Человек Шаман\', \'flavor\': \'Молот бьет. Огонь просыпается.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445188&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f06569ff-cfb7-4a5e-b4a9-714ce55b8275\', \'multiverseId\': 445188}, \'multiverseid\': 445188}, {\'name\': \'源火守卫瓦杜克\', \'text\': \'在你回合的战斗开始时，源火守卫瓦杜克上每结附一个灵气或每装备一个武具，便派出一个3/1红色，具践踏与敏捷异能的元素衍生生物。在下一结束步骤开始时，放逐这些衍生物。\', \'type\': \'传奇生物 ～人类／祭师\', \'flavor\': \'铁锤敲击。源火觉醒。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445457&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ed65837b-7aba-472a-b78a-c67dc2494f16\', \'multiverseId\': 445457}, \'multiverseid\': 445457}, {\'name\': \'源火守衛瓦杜克\', \'text\': \'在你回合的戰鬥開始時，源火守衛瓦杜克上每結附一個靈氣或每裝備一個武具，便派出一個3/1紅色，具踐踏與敏捷異能的元素衍生生物。在下一個結束步驟開始時，放逐這些衍生物。\', \'type\': \'傳奇生物 ～人類／祭師\', \'flavor\': \'鐵錘敲擊。源火覺醒。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445726&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5db8cd64-244f-49dd-80ee-b036a4d4dd31\', \'multiverseId\': 445726}, \'multiverseid\': 445726}]', '[{\'name\': \'Vergoldeter Lotus\', \'text\': \'{T}: Erzeuge drei Mana genau einer beliebigen Farbe.\', \'type\': \'Artefakt\', \'flavor\': \'„Die Perfektion des Lotus erinnert mich an meine Hoffnungen für diese Welt … und mein eigenes Versagen. Ich werde nicht ruhen, ehe ich Wiedergutmachung geleistet habe." —Karn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443372&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'32f0e9e2-2d11-46d9-94da-da31a31e11b6\', \'multiverseId\': 443372}, \'multiverseid\': 443372}, {\'name\': \'Loto de oropel\', \'text\': \'{T}: Agrega tres manás de un color cualquiera.\', \'type\': \'Artefacto\', \'flavor\': \'"La perfección del loto me recuerda a las esperanzas que tenía con este mundo... y a mis fracasos. No descansaré hasta que los haya enmendado". —Karn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443641&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'88623b33-386f-444a-8911-2a49ab86f31a\', \'multiverseId\': 443641}, \'multiverseid\': 443641}, {\'name\': \'Lotus doré\', \'text\': "{T} : Ajoutez trois manas d\'une seule couleur de votre choix.", \'type\': \'Artefact\', \'flavor\': "« La perfection du lotus me rappelle mes espoirs pour ce monde... et mes erreurs. Je ne connaîtrai le repos que lorsque j\'aurai racheté chacune d\'elles. » —Karn", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443910&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ac9a9b12-739a-48ec-b1b3-3991947686e4\', \'multiverseId\': 443910}, \'multiverseid\': 443910}, {\'name\': \'Loto Dorato\', \'text\': \'{T}: Aggiungi tre mana di un qualsiasi colore.\', \'type\': \'Artefatto\', \'flavor\': \'"La perfezione del loto mi ricorda le mie speranze per questo mondo... e i miei fallimenti. Non avrò pace finché non avrò espiato le mie colpe." —Karn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444179&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dcfa0e71-318d-4225-b770-e999c7b5029e\', \'multiverseId\': 444179}, \'multiverseid\': 444179}, {\'name\': \'金粉の水蓮\', \'text\': \'{T}：好きな色１色のマナ３点を加える。\', \'type\': \'アーティファクト\', \'flavor\': \'「この完成された睡蓮を見ると思い出す。私がこの世界に望んだことを。……そして私の失敗を。その償いが済むまで、私に安息はない。」 ――カーン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444448&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'103eed23-4b70-4e24-87a7-8ac444de634f\', \'multiverseId\': 444448}, \'multiverseid\': 444448}, {\'name\': \'금박 연꽃\', \'text\': \'{T}: 원하는 한 가지 색 마나 세 개를 추가한다.\', \'type\': \'마법물체\', \'flavor\': \'"연꽃의 완벽함을 보고 있으면 이 세계에 품은 나의 희망이... 그리고 내 실패가 생각난다. 그것들을 만회할 때까지 나는 쉬지 않을 것이다." —카른\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444717&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c8ceda4c-9b3d-4c3c-9069-7ca6c9d00142\', \'multiverseId\': 444717}, \'multiverseid\': 444717}, {\'name\': \'Lótus Engalanada\', \'text\': \'{T}: Adicione três manas de qualquer cor.\', \'type\': \'Artefato\', \'flavor\': \'"A perfeição do lótus lembra-me de minhas esperanças para o mundo... e de meus fracassos. Não descansarei até me redimir deles." — Karn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444986&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5be3380a-89d6-4cbd-8902-96886bb18d92\', \'multiverseId\': 444986}, \'multiverseid\': 444986}, {\'name\': \'Позолоченный Лотос\', \'text\': \'{T}: добавьте три маны любого одного цвета.\', \'type\': \'Артефакт\', \'flavor\': \'«Безупречность лотоса напоминает мне о надеждах, что я связывал с этим миром... и о моих неудачах. Я не остановлюсь, пока не искуплю содеянное». — Карн\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445255&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6ef6deb7-1420-48ea-8941-069da39b169f\', \'multiverseId\': 445255}, \'multiverseid\': 445255}, {\'name\': \'金箔莲花\', \'text\': \'{T}：加三点任意颜色的单色法术力。\', \'type\': \'神器\', \'flavor\': \'「这朵完美的莲花让我想起我对这个世界的希望. . . 以及我的失败过往。在我还没完成赎罪之前，我决不止歇。」 ～卡恩\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445524&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a0c8eefa-ff07-417a-bdb1-553bd30b79fd\', \'multiverseId\': 445524}, \'multiverseid\': 445524}, {\'name\': \'金箔蓮花\', \'text\': \'{T}：加三點任意顏色的單色魔法力。\', \'type\': \'神器\', \'flavor\': \'「這朵完美的蓮花讓我想起自己對這世界的希望. . . 以及我的失敗過往。在我還沒完成贖罪之前，我決不止歇。」 ～卡恩\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445793&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a175d3bc-b3aa-491a-b446-edf3e824404a\', \'multiverseId\': 445793}, \'multiverseid\': 445793}]', '[{\'name\': \'Verix Bladewing\', \'text\': \'Bonus {3} (Du kannst zusätzlich {3} bezahlen, sowie du diesen Zauberspruch wirkst.)\\nFliegend\\nWenn Verix Bladewing ins Spiel kommt und falls ihre Bonuskosten bezahlt wurden, erzeuge einen legendären 4/4 roten Drache-Kreaturenspielstein mit Flugfähigkeit namens Karox Bladewing.\', \'type\': \'Legendäre Kreatur — Drache\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443306&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'07a389cf-1586-40c3-ae73-6076171f4d51\', \'multiverseId\': 443306}, \'multiverseid\': 443306}, {\'name\': \'Vérix Alacortante\', \'text\': \'Estímulo {3}. (Puedes pagar {3} adicionales al lanzar este hechizo.)\\nVuela.\\nCuando Vérix Alacortante entre al campo de batalla, si fue estimulada, crea a Károx Alacortante, una ficha de criatura legendaria Dragón roja 4/4 con la habilidad de volar.\', \'type\': \'Criatura legendaria — Dragón\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443575&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2f67f9b2-d94f-42c3-9952-8c58b0a9bdac\', \'multiverseId\': 443575}, \'multiverseid\': 443575}, {\'name\': \'Verix Ailelame\', \'text\': "Kick {3} (Vous pouvez payer {3} supplémentaires au moment où vous lancez ce sort.)\\nVol\\nQuand Verix Ailelame arrive sur le champ de bataille, s\'il a été kické, créez Karox Ailelame, un jeton de créature légendaire 4/4 rouge Dragon avec le vol.", \'type\': \'Créature légendaire : dragon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443844&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'acda0ff5-d656-4cab-9d6d-419bcaac9b13\', \'multiverseId\': 443844}, \'multiverseid\': 443844}, {\'name\': \'Verix Alaspada\', \'text\': \'Potenziamento {3} (Puoi pagare {3} addizionale mentre lanci questa magia.)\\nVolare\\nQuando Verix Alaspada entra nel campo di battaglia, se è stata potenziata, crea Karox Alaspada, una pedina creatura leggendaria Drago 4/4 rossa con volare.\', \'type\': \'Creatura Leggendaria — Drago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444113&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5e429cd7-2bca-4797-bdb0-373356b79ad8\', \'multiverseId\': 444113}, \'multiverseid\': 444113}, {\'name\': \'刃の翼ヴェリックス\', \'text\': \'キッカー{3}（あなたはこの呪文を唱えるに際し、追加で{3}を支払ってもよい。）\\n飛行\\n刃の翼ヴェリックスが戦場に出たとき、これがキッカーされていた場合、「刃の翼カロックス」という名前で飛行を持つ赤の４/４の伝説のドラゴン・クリーチャー・トークンを１体生成する。\', \'type\': \'伝説のクリーチャー — ドラゴン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444382&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'37fb5fb2-2aba-41f8-aa46-fd400f21cc4a\', \'multiverseId\': 444382}, \'multiverseid\': 444382}, {\'name\': \'칼날날개 베릭스\', \'text\': \'키커 {3} (당신은 이 주문을 발동하면서 추가로 {3}을 지불할 수 있다.)\\n비행\\n칼날날개 베릭스가 전장에 들어올 때, 키커 비용이 지불되었다면, 비행을 가진 전설적 4/4 적색 용 생물 토큰인 칼날날개 카록스 한 개를 만든다.\', \'type\': \'전설적 생물 — 용\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444651&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'fa24b55c-ac05-46ac-8864-b1dc38c51e5a\', \'multiverseId\': 444651}, \'multiverseid\': 444651}, {\'name\': \'Verix Asas Laminadas\', \'text\': \'Reforçar {3} (Você pode pagar um custo adicional de {3} ao conjurar esta mágica.)\\nVoar\\nQuando Verix Asas Laminadas entrar no campo de batalha, se tiver sido reforçado, crie Karox Asas Laminadas, uma ficha de criatura vermelha lendária 4/4 do tipo Dragão com voar.\', \'type\': \'Criatura Lendária — Dragão\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444920&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1d6b00e0-b6d3-49c3-8ae7-99ef6f44a692\', \'multiverseId\': 444920}, \'multiverseid\': 444920}, {\'name\': \'Саблекрылая Верикс\', \'text\': \'Усилитель {3} (При разыгрывании этого заклинания вы можете дополнительно заплатить {3}.)\\nПолет\\nКогда Саблекрылая Верикс выходит на поле битвы, если она получила Усилитель, создайте Саблекрылого Карокса, фишку легендарного существа 4/4 красный Дракон с Полетом.\', \'type\': \'Легендарное Существо — Дракон\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445189&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b5c66067-cf15-4c25-b352-2194bdd06400\', \'multiverseId\': 445189}, \'multiverseid\': 445189}, {\'name\': \'锋翼维黎兹\', \'text\': \'增幅{3}（你施放此咒语时可以额外支付{3}。）\\n飞行\\n当锋翼维黎兹进战场时，若它已增幅，则派出传奇衍生生物锋翼卡洛兹，其为4/4红色，具飞行异能的龙。\', \'type\': \'传奇生物 ～龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445458&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'89188d7b-adbf-47ee-a87b-773d971d4f5c\', \'multiverseId\': 445458}, \'multiverseid\': 445458}, {\'name\': \'鋒翼維黎茲\', \'text\': \'增幅{3}（你施放此咒語時可以額外支付{3}。）\\n飛行\\n當鋒翼維黎茲進戰場時，若它已增幅，則派出傳奇衍生生物鋒翼卡洛茲，其為4/4紅色，具飛行異能的龍。\', \'type\': \'傳奇生物 ～龍\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445727&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8a3d5dc8-123d-4af8-9f66-8db04be1e8df\', \'multiverseId\': 445727}, \'multiverseid\': 445727}]', '[{\'name\': \'Versiegelung\', \'text\': \'Aufblitzen\\nWenn die Versiegelung ins Spiel kommt, schicke eine getappte Kreatur deiner Wahl, die ein Gegner kontrolliert, ins Exil, bis die Versiegelung das Spiel verlässt.\', \'type\': \'Verzauberung\', \'flavor\': \'Eine uralte Bedrohung, die vor langer Zeit unschädlich gemacht wurde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443188&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e5c07563-0ca1-40b1-b41c-5edc45f9586f\', \'multiverseId\': 443188}, \'multiverseid\': 443188}, {\'name\': \'Sellar\', \'text\': \'Destello.\\nCuando Sellar entre al campo de batalla, exilia la criatura girada objetivo que controla un oponente hasta que Sellar deje el campo de batalla.\', \'type\': \'Encantamiento\', \'flavor\': \'Una antigua némesis que fue subyugada hace mucho tiempo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443457&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'62ab6be1-3f1e-4875-ada0-47baa0369d30\', \'multiverseId\': 443457}, \'multiverseid\': 443457}, {\'name\': \'Sceller\', \'text\': "Flash\\nQuand Sceller arrive sur le champ de bataille, exilez une créature engagée ciblée qu\'un adversaire contrôle jusqu\'à ce que Sceller quitte le champ de bataille.", \'type\': \'Enchantement\', \'flavor\': \'Un ancien ennemi rendu inoffensif il y a longtemps.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443726&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ae19e8a8-6460-4bcd-a72d-23f8b20aaf0b\', \'multiverseId\': 443726}, \'multiverseid\': 443726}, {\'name\': \'Sigillare\', \'text\': \'Lampo\\nQuando Sigillare entra nel campo di battaglia, esilia una creatura TAPpata bersaglio controllata da un avversario finché Sigillare non lascia il campo di battaglia.\', \'type\': \'Incantesimo\', \'flavor\': "Un\'antica nemesi resa inoffensiva molto tempo fa.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443995&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f48b9b85-4a93-4abe-b923-e7fdebf70202\', \'multiverseId\': 443995}, \'multiverseid\': 443995}, {\'name\': \'封じ込め\', \'text\': \'瞬速\\n封じ込めが戦場に出たとき、対戦相手がコントロールしていてタップ状態のクリーチャー１体を対象とし、封じ込めが戦場を離れるまでそれを追放する。\', \'type\': \'エンチャント\', \'flavor\': \'古代の巨悪も無害な存在となって久しい。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444264&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e3b6310d-d4da-41de-be93-b5ecb336ab44\', \'multiverseId\': 444264}, \'multiverseid\': 444264}, {\'name\': \'떼어내기\', \'text\': \'섬광\\n떼어내기가 전장에 들어올 때, 상대가 조종하는 탭된 생물을 목표로 정한다. 떼어내기가 전장을 떠날 때까지 그 생물을 추방한다.\', \'type\': \'부여마법\', \'flavor\': \'오래 전에 그 힘을 잃은 고대의 천벌.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444533&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'57c5ced2-2e25-44db-a86e-e2fdb1157dee\', \'multiverseId\': 444533}, \'multiverseid\': 444533}, {\'name\': \'Selar\', \'text\': \'Lampejo\\nQuando Selar entrar no campo de batalha, exile a criatura virada alvo que um oponente controla até que Selar deixe o campo de batalha.\', \'type\': \'Encantamento\', \'flavor\': \'Uma nêmese ancestral, há muito tornada inofensiva.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444802&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6821c7b8-b6b6-4b43-a98a-eeea3b9f71c4\', \'multiverseId\': 444802}, \'multiverseid\': 444802}, {\'name\': \'Запечатать\', \'text\': \'Миг\\nКогда Запечатать выходит на поле битвы, изгоните целевое повернутое существо под контролем оппонента до тех пор, пока Запечатать не покинет поле битвы.\', \'type\': \'Чары\', \'flavor\': \'Древняя угроза, давным-давно сделанная безвредной.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445071&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'498aa5cb-eddb-480b-8dc1-c168dbf7e78e\', \'multiverseId\': 445071}, \'multiverseid\': 445071}, {\'name\': \'摘离\', \'text\': \'闪现\\n当摘离进战场时，放逐目标由对手操控且已横置的生物，直到摘离离开战场为止。\', \'type\': \'结界\', \'flavor\': \'曾为古时宿敌，但早已不再是威胁。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445340&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a1899ec9-a6cc-4223-88eb-8474f2c9f52a\', \'multiverseId\': 445340}, \'multiverseid\': 445340}, {\'name\': \'摘離\', \'text\': \'閃現\\n當摘離進戰場時，放逐目標由對手操控且已橫置的生物，直到摘離離開戰場為止。\', \'type\': \'結界\', \'flavor\': \'曾為古時宿敵，但早已不再是威脅。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445609&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'763837c4-cf1b-4bad-8482-d73bdf74572a\', \'multiverseId\': 445609}, \'multiverseid\': 445609}]', '[{\'name\': \'Verwegene Archäologin\', \'text\': \'Wenn die Verwegene Archäologin ins Spiel kommt, kannst du eine Artefaktkarte deiner Wahl aus deinem Friedhof auf deine Hand zurückbringen.\\nImmer wenn du einen historischen Zauberspruch wirkst, lege eine +1/+1-Marke auf die Verwegene Archäologin. (Legenden, Artefakte und Sagen sind historisch.)\', \'type\': \'Kreatur — Mensch, Handwerker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443170&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'29912a68-6088-40da-93a5-746b8f9b53cb\', \'multiverseId\': 443170}, \'multiverseid\': 443170}, {\'name\': \'Arqueóloga atrevida\', \'text\': \'Cuando la Arqueóloga atrevida entre al campo de batalla, puedes regresar la carta de artefacto objetivo de tu cementerio a tu mano.\\nSiempre que lances un hechizo histórico, pon un contador +1/+1 sobre la Arqueóloga atrevida. (Los artefactos, las Sagas y las cartas legendarias son cartas históricas.)\', \'type\': \'Criatura — Artífice humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443439&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'88688002-bbcc-4da8-a7ba-c0f39afa0e8c\', \'multiverseId\': 443439}, \'multiverseid\': 443439}, {\'name\': \'Archéologue audacieuse\', \'text\': "Quand l\'Archéologue audacieuse arrive sur le champ de bataille, vous pouvez renvoyer une carte d\'artefact ciblée depuis votre cimetière dans votre main.\\nÀ chaque fois que vous lancez un sort historique, mettez un marqueur +1/+1 sur l\'Archéologue audacieuse. (Les artefacts, les légendaires et les sagas sont historiques.)", \'type\': \'Créature : humain et artificier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443708&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e6ed9ca4-1616-4a38-8b90-e0dbaf183613\', \'multiverseId\': 443708}, \'multiverseid\': 443708}, {\'name\': \'Archeologa Audace\', \'text\': "Quando l\'Archeologa Audace entra nel campo di battaglia, puoi riprendere in mano una carta artefatto bersaglio dal tuo cimitero.\\nOgniqualvolta lanci una magia storica, metti un segnalino +1/+1 sull\'Archeologa Audace. (Artefatti, carte leggendarie e Saghe sono carte storiche.)", \'type\': \'Creatura — Artefice Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443977&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fad1cbfc-3dea-40e5-8245-cec48d1cab02\', \'multiverseId\': 443977}, \'multiverseid\': 443977}, {\'name\': \'勇敢な考古学者\', \'text\': \'勇敢な考古学者が戦場に出たとき、あなたの墓地からアーティファクト・カード１枚を対象とする。あなたはそれをあなたの手札に戻してもよい。\\nあなたが歴史的な呪文を唱えるたび、勇敢な考古学者の上に＋１/＋１カウンターを１個置く。（歴史的とは、アーティファクトと伝説と英雄譚のことである。）\', \'type\': \'クリーチャー — 人間・工匠\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444246&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'815e67e7-8190-4d06-aa68-71229150ec7d\', \'multiverseId\': 444246}, \'multiverseid\': 444246}, {\'name\': \'대담한 고고학자\', \'text\': \'대담한 고고학자가 전장에 들어올 때, 당신의 무덤에 있는 마법물체 카드를 목표로 정한다. 당신은 그 카드를 당신의 손으로 되돌릴 수 있다.\\n당신이 역사적 주문을 발동할 때마다, 대담한 고고학자에 +1/+1 카운터 한 개를 올려놓는다. (마법물체와 전설적, 서사시가 역사적이다.)\', \'type\': \'생물 — 인간 기능공\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444515&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'91d87040-da3b-457d-b51d-53549cfe50d1\', \'multiverseId\': 444515}, \'multiverseid\': 444515}, {\'name\': \'Arqueóloga Audaz\', \'text\': \'Quando Arqueóloga Audaz entra no campo de batalha, você pode devolver o card de artefato alvo de seu cemitério para sua mão.\\nToda vez que você conjurar uma mágica histórica, coloque um marcador +1/+1 em Arqueóloga Audaz. (Os artefatos, os cards lendários e as Sagas são cards históricos.)\', \'type\': \'Criatura — Humano Artesão\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444784&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'894eb464-dfc4-4cf0-8435-194737ef1fc5\', \'multiverseId\': 444784}, \'multiverseid\': 444784}, {\'name\': \'Бесстрашный Археолог\', \'text\': \'Когда Бесстрашный Археолог выходит на поле битвы, вы можете вернуть целевую карту артефакта из вашего кладбища в вашу руку.\\nКаждый раз, когда вы разыгрываете историческое заклинание, положите один жетон +1/+1 на Бесстрашного Археолога. (Артефакты, легендарные карты и Саги являются историческими.)\', \'type\': \'Существо — Человек Механик\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445053&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f7b5bbc8-3078-407a-8f24-0d24b43d71dd\', \'multiverseId\': 445053}, \'multiverseid\': 445053}, {\'name\': \'大胆的考古学家\', \'text\': \'当大胆的考古学家进战场时，你可以将目标神器牌从你的坟墓场移回你手上。\\n每当你施放史迹咒语时，在大胆的考古学家上放置一个+1/+1指示物。（神器、传奇和传纪是史迹。）\', \'type\': \'生物 ～人类／神器师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445322&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0c4a39ac-710d-4726-a584-560a836f401b\', \'multiverseId\': 445322}, \'multiverseid\': 445322}, {\'name\': \'大膽的考古學家\', \'text\': \'當大膽的考古學家進戰場時，你可以將目標神器牌從你的墳墓場移回你手上。\\n每當你施放史跡咒語時，在大膽的考古學家上放置一個+1/+1指示物。（神器、傳奇和傳紀是史跡。）\', \'type\': \'生物 ～人類／神器師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445591&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'801aa1e2-af97-4f67-a3d2-03f3954909b6\', \'multiverseId\': 445591}, \'multiverseid\': 445591}]', '[{\'name\': \'Verweilendes Phantom\', \'text\': \'Immer wenn du einen historischen Zauberspruch wirkst, kannst du {B} bezahlen. Falls du dies tust, bringe das Verweilende Phantom aus deinem Friedhof auf deine Hand zurück. (Legenden, Artefakte und Sagen sind historisch.)\', \'type\': \'Kreatur — Geist\', \'flavor\': \'„Wahre Macht ist unsterblich. Sie verweilt im Schatten und wartet darauf, dass jemand sie heraufbeschwört." —Die Wiedergeburt des Ältesten\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443256&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2cdffdfe-ee74-4feb-9c39-c18ceb14e930\', \'multiverseId\': 443256}, \'multiverseid\': 443256}, {\'name\': \'Espectro persistente\', \'text\': \'Siempre que lances un hechizo histórico, puedes pagar {B}. Si lo haces, regresa el Espectro persistente de tu cementerio a tu mano. (Los artefactos, las Sagas y las cartas legendarias son cartas históricas.)\', \'type\': \'Criatura — Espíritu\', \'flavor\': \'"El auténtico poder nunca muere; permanece despierto, esperando que alguien pronuncie su nombre". —El gran anciano renacido\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443525&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1d68d87c-928f-4361-b531-fa9938800056\', \'multiverseId\': 443525}, \'multiverseid\': 443525}, {\'name\': \'Fantôme persistant\', \'text\': \'À chaque fois que vous lancez un sort historique, vous pouvez payer {B}. Si vous faites ainsi, renvoyez le Fantôme persistant depuis votre cimetière dans votre main. (Les artefacts, les légendaires et les sagas sont historiques.)\', \'type\': \'Créature : esprit\', \'flavor\': "« Le vrai pouvoir ne meurt jamais ; dans un état de sommeil, il attend patiemment que son nom soit prononcé. » —La Renaissance de l\'aîné", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443794&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'713a5a0c-92cc-40a8-936c-bd5914697956\', \'multiverseId\': 443794}, \'multiverseid\': 443794}, {\'name\': \'Fantasma Indugiante\', \'text\': \'Ogniqualvolta lanci una magia storica, puoi pagare {B}. Se lo fai, riprendi in mano il Fantasma Indugiante dal tuo cimitero. (Artefatti, carte leggendarie e Saghe sono carte storiche.)\', \'type\': \'Creatura — Spirito\', \'flavor\': \'"Il vero potere non muore mai, ma giace vigile, in attesa che il suo nome venga pronunciato." —Rinascita dell\\\'Antico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444063&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'90314d3b-efa9-452d-8709-b2436843a47c\', \'multiverseId\': 444063}, \'multiverseid\': 444063}, {\'name\': \'遷延する幻影\', \'text\': \'あなたが歴史的な呪文を唱えるたび、あなたは{B}を支払ってもよい。そうしたなら、あなたの墓地から遷延する幻影をあなたの手札に戻す。（歴史的とは、アーティファクトと伝説と英雄譚のことである。）\', \'type\': \'クリーチャー — スピリット\', \'flavor\': \'「真なる力が死ぬことはない。目覚めたまま横たわり、その名を呼ばれる時を待っているのだ。」 ――最古再誕\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444332&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fca2e323-2f66-4a0f-99c1-42dda7d3af0d\', \'multiverseId\': 444332}, \'multiverseid\': 444332}, {\'name\': \'잔존하는 환상\', \'text\': \'당신이 역사적 주문을 발동할 때마다, 당신은 {B}를 지불할 수 있다. 그렇게 한다면, 잔존하는 환상을 당신의 무덤에서 당신의 손으로 되돌린다. (마법물체와 전설적, 서사시가 역사적이다.)\', \'type\': \'생물 — 신령\', \'flavor\': \'"진정한 힘은 결코 죽지 않는다. 단지 깬 채로 누워 그 이름이 불릴 때만을 기다리는 것이다." —가장 오래된 재탄생\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444601&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e491f33d-a599-486f-8946-abb8c073c5cc\', \'multiverseId\': 444601}, \'multiverseid\': 444601}, {\'name\': \'Fantasma Penado\', \'text\': \'Toda vez que conjura uma mágica histórica, você pode pagar {B}. Se fizer isso, devolva Fantasma Penado de seu cemitério para sua mão. (Os artefatos, os cards lendários e as Sagas são cards históricos.)\', \'type\': \'Criatura — Espírito\', \'flavor\': \'"O verdadeiro poder nunca dorme; em vez disso, jaz, desperto, esperando que seu nome seja dito." — O Ancião Renascido\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444870&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'48740a8c-416f-43bd-8896-5b04b1e4d23a\', \'multiverseId\': 444870}, \'multiverseid\': 444870}, {\'name\': \'Задержавшийся Призрак\', \'text\': \'Каждый раз, когда вы разыгрываете историческое заклинание, вы можете заплатить {B}. Если вы это делаете, верните Задержавшегося Призрака из вашего кладбища в вашу руку. (Артефакты, легендарные карты и Саги являются историческими.)\', \'type\': \'Существо — Дух\', \'flavor\': \'«Истинное могущество никогда не умирает. Оно лежит, внимая, и терпеливо ждет, когда назовут его имя». — «Перерождение Древнейшего»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445139&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ca0357b7-6e0a-41e2-9d7b-b20db2cdec99\', \'multiverseId\': 445139}, \'multiverseid\': 445139}, {\'name\': \'徘徊幻影\', \'text\': \'每当你施放史迹咒语时，你可以支付{B}。若你如此作，则将徘徊幻影从你的坟墓场移回你手上。（神器、传奇和传纪是史迹。）\', \'type\': \'生物 ～精怪\', \'flavor\': \'「真正力量永不消逝，而是静静潜伏，等候下一次索求。」 ～《恶源重生》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445408&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5a860870-3b14-411e-b947-28ec7c753a11\', \'multiverseId\': 445408}, \'multiverseid\': 445408}, {\'name\': \'徘徊幻影\', \'text\': \'每當你施放史跡咒語時，你可以支付{B}。若你如此作，則將徘徊幻影從你的墳墓場移回你手上。（神器、傳奇和傳紀是史跡。）\', \'type\': \'生物 ～精靈\', \'flavor\': \'「真正力量永不消逝，而是靜靜潛伏，等候下一次索求。」 ～《惡源重生》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445677&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9ba99500-b8b8-4336-8ae8-3c72f8bce7c8\', \'multiverseId\': 445677}, \'multiverseid\': 445677}]', '[{\'name\': \'Vodalischer Arkanist\', \'text\': \'{T}: Erzeuge {C}. Verwende dieses Mana nur, um einen Spontanzauber oder eine Hexerei zu wirken.\', \'type\': \'Kreatur — Meervolk, Zauberer\', \'flavor\': \'Das Vodalische Reich ist weitgehend isoliert. Die Gelehrtenkaste der Volshe bildet eine Ausnahme. Sie nutzt Wissen als Heilmittel gegen die Fremdenfeindlichkeit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443230&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4d9cd3b5-2bc4-4e7a-aae1-0da19ec8956a\', \'multiverseId\': 443230}, \'multiverseid\': 443230}, {\'name\': \'Arcanista vodaliano\', \'text\': \'{T}: Agrega {C}. Usa este maná solo para lanzar un hechizo de instantáneo o de conjuro.\', \'type\': \'Criatura — Hechicero tritón\', \'flavor\': \'El Imperio vodaliano tiende a ser poco tolerante. La académica casta Volshe constituye una excepción, ya que usan la educación como antídoto para la xenofobia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443499&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'055940dd-fdcc-489c-b126-6a5bfdd18e12\', \'multiverseId\': 443499}, \'multiverseid\': 443499}, {\'name\': \'Arcaniste vodalian\', \'text\': "{T} : Ajoutez {C}. Ne dépensez ce mana que pour lancer un sort d\'éphémère ou de rituel.", \'type\': \'Créature : ondin et sorcier\', \'flavor\': "L\'Empire vodalian fait généralement montre d\'un esprit étroit. La caste érudite Volshe constitue une exception, et s\'appuie sur l\'éducation pour contrer la xénophobie.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443768&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fb7ae352-e658-4a41-9ade-927f55c616dd\', \'multiverseId\': 443768}, \'multiverseid\': 443768}, {\'name\': \'Arcanista di Vodalia\', \'text\': \'{T}: Aggiungi {C}. Spendi questo mana solo per lanciare una magia istantaneo o stregoneria.\', \'type\': \'Creatura — Mago Tritone\', \'flavor\': "L\'Impero di Vodalia tende a essere di mentalità ristretta. L\'unica eccezione è la casta di studiosi Volshe, che usa l\'educazione come antidoto alla xenofobia.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444037&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3dbf2409-7856-4d08-9753-8a10e203ecf6\', \'multiverseId\': 444037}, \'multiverseid\': 444037}, {\'name\': \'ヴォーデイリアの秘儀術師\', \'text\': \'{T}：{C}を加える。このマナは、インスタントかソーサリーである呪文を唱えるためにのみ使用できる。\', \'type\': \'クリーチャー — マーフォーク・ウィザード\', \'flavor\': \'ヴォーデイリア帝国には孤立主義的な傾向がある。学問を重視するヴォルシェ・カーストは例外で、教育によって外国嫌いを防いでいる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444306&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c2005d2f-24d2-4f6d-af9f-8ca98a190c6a\', \'multiverseId\': 444306}, \'multiverseid\': 444306}, {\'name\': \'보달리아 비전술사\', \'text\': \'{T}: {C}를 추가한다. 이 마나는 순간마법 또는 집중마법 주문을 발동하는 데에만 사용할 수 있다.\', \'type\': \'생물 — 인어 마법사\', \'flavor\': \'보달리아 제국은 다소 배타적인 성향이 있다. 다만 학구적인 볼쉬 계층은 예외로, 이들은 교육을 통해 외부의 것들을 혐오하는 성향을 줄이고자 한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444575&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7136e605-b2ce-465f-9f3b-04090ad76904\', \'multiverseId\': 444575}, \'multiverseid\': 444575}, {\'name\': \'Arcanista Vodaliano\', \'text\': \'{T}: Adicione {C}. Gaste este mana apenas para conjurar uma mágica instantânea ou um feitiço.\', \'type\': \'Criatura — Tritão Mago\', \'flavor\': \'O Império Vodaliano tende a ser insular. A casta erudita dos Volshe é a exceção, usando a educação como antídoto para a xenofobia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444844&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2d628ebc-48e2-4bb0-bb4e-0b96104ee9ad\', \'multiverseId\': 444844}, \'multiverseid\': 444844}, {\'name\': \'Водалийский Арканист\', \'text\': \'{T}: добавьте {C}. Тратьте эту ману только на разыгрывание мгновенного заклинания или заклинания волшебства.\', \'type\': \'Существо — Мерфолк Чародей\', \'flavor\': \'Водалийская империя отличается закрытостью. Ученые из касты Вольше — редкое исключение. Образованность становится для них лекарством от ксенофобии.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445113&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4118a558-0bd6-4a19-a9fb-2f6acfc00a0e\', \'multiverseId\': 445113}, \'multiverseid\': 445113}, {\'name\': \'伏特里亚奥术师\', \'text\': \'{T}：加{C}。此法术力只能用来施放瞬间或法术咒语。\', \'type\': \'生物 ～人鱼／法术师\', \'flavor\': \'伏特里亚帝国通常行事保守。好学的伏尔施阶级则属例外，他们以教育解决排外心态。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445382&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5a4025b8-8ec1-4b36-af47-71325965486d\', \'multiverseId\': 445382}, \'multiverseid\': 445382}, {\'name\': \'伏特里亞奧術師\', \'text\': \'{T}：加{C}。此魔法力只能用來施放瞬間或巫術咒語。\', \'type\': \'生物 ～人魚／魔法師\', \'flavor\': \'伏特里亞帝國通常行事保守。好學的伏爾施階級則屬例外，他們以教育解決排外心態。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445651&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ad0e83c3-29a0-4eac-b279-28fc748e8c20\', \'multiverseId\': 445651}, \'multiverseid\': 445651}]', "[{'name': 'Vom Himmel holen', 'text': 'Vom Himmel holen fügt einer fliegenden Kreatur deiner Wahl 7 Schadenspunkte zu.', 'type': 'Spontanzauber', 'flavor': 'Llanowarelfen postieren sich in den dichten Baumkronen des Waldes und sind stets bereit, auch den Himmel von Eindringlingen zu befreien.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443333&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd6b16152-5adf-4f8a-8ef5-c60e367fe2ba', 'multiverseId': 443333}, 'multiverseid': 443333}, {'name': 'Perforar los cielos', 'text': 'Perforar los cielos hace 7 puntos de daño a la criatura objetivo con la habilidad de volar.', 'type': 'Instantáneo', 'flavor': 'Los elfos de Llanowar ocultan sus ballestas en las ramas más elevadas del bosque; así están listas para eliminar a cualquier intruso de los cielos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443602&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '3fcfa588-7efb-4407-babd-04b43e4bf275', 'multiverseId': 443602}, 'multiverseid': 443602}, {'name': 'Transpercer le ciel', 'text': 'Transpercer le ciel inflige 7 blessures à une créature avec le vol ciblée.', 'type': 'Éphémère', 'flavor': 'Les elfes de Llanowar dissimulent leurs balistes dans la canopée de la forêt, prêts à débarrasser le ciel de tout intrus.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443871&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b03f64e8-c010-4739-8edc-b7463e144983', 'multiverseId': 443871}, 'multiverseid': 443871}, {'name': 'Trafiggere il Cielo', 'text': 'Trafiggere il Cielo infligge 7 danni a una creatura bersaglio con volare.', 'type': 'Istantaneo', 'flavor': 'Gli elfi di Llanowar nascondono le loro baliste tra le fronde più alte della foresta, pronti a sgomberare i cieli da qualsiasi intruso.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444140&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '003a9c40-a01a-4881-b670-58d5253cf94a', 'multiverseId': 444140}, 'multiverseid': 444140}, {'name': '空を射抜く', 'text': '飛行を持つクリーチャー１体を対象とする。空を射抜くはそれに７点のダメージを与える。', 'type': 'インスタント', 'flavor': 'ラノワールのエルフは森の樹上にバリスタを隠しており、空からの侵入者を排除できる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444409&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9503aea1-4621-4d7b-a759-39068323a4a6', 'multiverseId': 444409}, 'multiverseid': 444409}, {'name': '하늘 꿰뚫기', 'text': '비행을 가진 생물을 목표로 정한다. 하늘 꿰뚫기는 그 생물에게 피해 7점을 입힌다.', 'type': '순간마법', 'flavor': '라노워 엘프들은 지붕처럼 숲을 덮은 위쪽의 나뭇가지들 사이에 노포를 숨겨, 하늘에서 다가오는 어떤 침략자든 제거할 준비를 갖춘다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444678&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '83af8357-e2e0-4e31-bd93-745054687645', 'multiverseId': 444678}, 'multiverseid': 444678}, {'name': 'Perfurar o Céu', 'text': 'Perfurar o Céu causa 7 pontos de dano à criatura alvo com voar.', 'type': 'Mágica Instantânea', 'flavor': 'Os elfos de Llanowar camuflam suas balistas no dossel superior da floresta, prontos para varrer dos céus qualquer intruso.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444947&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '230a9717-3e62-42c7-b388-3a29318937a8', 'multiverseId': 444947}, 'multiverseid': 444947}, {'name': 'Выстрел в Небо', 'text': 'Выстрел в Небо наносит 7 повреждений целевому существу с Полетом.', 'type': 'Мгновенное заклинание', 'flavor': 'Эльфы Лановара прячут свои баллисты в кронах деревьев, готовые сбить любого, кто появится в их небе.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445216&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'e3ed66cf-9338-48f9-a161-2a85e288e29a', 'multiverseId': 445216}, 'multiverseid': 445216}, {'name': '划破苍穹', 'text': '划破苍穹对目标具飞行异能的生物造成7点伤害。', 'type': '瞬间', 'flavor': '罗堰的妖精把弩炮藏在森林上层枝桠间，随时准备清除空中入侵者。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445485&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'd9d30338-321a-40ef-a566-eee0a2155241', 'multiverseId': 445485}, 'multiverseid': 445485}, {'name': '劃破蒼穹', 'text': '劃破蒼穹對目標具飛行異能的生物造成7點傷害。', 'type': '瞬間', 'flavor': '羅堰的妖精把弩炮藏在森林上層枝椏間，隨時準備清除空中入侵者。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445754&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '1bf0483c-4098-4f39-b2ef-c0b3a747d9e4', 'multiverseId': 445754}, 'multiverseid': 445754}]", '[{\'name\': \'Von Augenblick zu Augenblick\', \'text\': \'Bonus {1}{U} (Du kannst zusätzlich {1}{U} bezahlen, sowie du diesen Zauberspruch wirkst.)\\nBringe eine bleibende Karte deiner Wahl, die kein Land ist, auf die Hand ihres Besitzers zurück. Falls die Bonuskosten dieses Zauberspruchs bezahlt wurden, ziehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443203&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3589f19e-8585-458f-966a-50e9451b005c\', \'multiverseId\': 443203}, \'multiverseid\': 443203}, {\'name\': \'Abrir y cerrar de ojos\', \'text\': \'Estímulo {1}{U}. (Puedes pagar {1}{U} adicionales al lanzar este hechizo.)\\nRegresa el permanente objetivo que no sea tierra a la mano de su propietario. Si este hechizo fue estimulado, roba una carta.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443472&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6ccf76bc-40d5-4b8a-b64c-979a1a720652\', \'multiverseId\': 443472}, \'multiverseid\': 443472}, {\'name\': "Clin d\'œil", \'text\': \'Kick {1}{U} (Vous pouvez payer {1}{U} supplémentaires au moment où vous lancez ce sort.)\\nRenvoyez le permanent non-terrain ciblé dans la main de son propriétaire. Si ce sort a été kické, piochez une carte.\', \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443741&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5016096f-5ba2-47f9-820e-b18a9ca686ca\', \'multiverseId\': 443741}, \'multiverseid\': 443741}, {\'name\': "Batter d\'Occhio", \'text\': \'Potenziamento {1}{U} (Puoi pagare {1}{U} addizionale mentre lanci questa magia.)\\nFai tornare un permanente non terra bersaglio in mano al suo proprietario. Se questa magia è stata potenziata, pesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444010&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a215049b-9852-4e5d-a07e-ce5c1e678361\', \'multiverseId\': 444010}, \'multiverseid\': 444010}, {\'name\': \'一瞬\', \'text\': \'キッカー{1}{U}（あなたはこの呪文を唱えるに際し、追加で{1}{U}を支払ってもよい。）\\n土地でないパーマネント１つを対象とし、それをオーナーの手札に戻す。この呪文がキッカーされていたなら、カードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444279&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e6f91e16-24a1-4494-9452-715d317bb34b\', \'multiverseId\': 444279}, \'multiverseid\': 444279}, {\'name\': \'눈 깜빡이기\', \'text\': \'키커 {1}{U} (당신은 이 주문을 발동하면서 추가로 {1}{U}를 지불할 수 있다.)\\n대지가 아닌 지속물을 목표로 정한다. 그 지속물을 소유자의 손으로 되돌린다. 이 주문의 키커 비용이 지불되었다면, 카드 한 장을 뽑는다.\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444548&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'318652f7-072b-4807-b43e-91ba4aec954f\', \'multiverseId\': 444548}, \'multiverseid\': 444548}, {\'name\': \'Piscar de Olhos\', \'text\': \'Reforçar {1}{U} (Você pode pagar um custo adicional de {1}{U} ao conjurar esta mágica.)\\nDevolva a permanente alvo que não seja um terreno para a mão de seu dono. Se esta mágica foi reforçada, compre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444817&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4efba58e-d175-43e3-87b3-723dc44598c1\', \'multiverseId\': 444817}, \'multiverseid\': 444817}, {\'name\': \'Мгновение Ока\', \'text\': \'Усилитель {1}{U} (При разыгрывании этого заклинания вы можете дополнительно заплатить {1}{U}.)\\nВерните целевой не являющийся землей перманент в руку его владельца. Если это заклинание получило Усилитель, возьмите карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445086&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'eb618c1a-e7f3-4094-bf34-1e01dda55955\', \'multiverseId\': 445086}, \'multiverseid\': 445086}, {\'name\': \'眨眼即逝\', \'text\': \'增幅{1}{U}（你施放此咒语时可以额外支付{1}{U}。）\\n将目标非地永久物移回其拥有者手上。如果此咒语已增幅，则抓一张牌。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445355&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'737ea2a9-d78e-462c-ac67-f913a463f49c\', \'multiverseId\': 445355}, \'multiverseid\': 445355}, {\'name\': \'眨眼即逝\', \'text\': \'增幅{1}{U}（你施放此咒語時可以額外支付{1}{U}。）\\n將目標非地永久物移回其擁有者手上。如果此咒語已增幅，則抽一張牌。\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445624&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'38246898-3030-4618-9327-31742a276b80\', \'multiverseId\': 445624}, \'multiverseid\': 445624}]', '[{\'name\': \'Wachposten des Perlendreizacks\', \'text\': \'Aufblitzen\\nWenn der Wachposten des Perlendreizacks ins Spiel kommt, kannst du eine historische bleibende Karte deiner Wahl, die du kontrollierst, ins Exil schicken. Falls du dies tust, bringe die Karte zu Beginn des nächsten Endsegments unter der Kontrolle ihres Besitzers ins Spiel zurück. (Legenden, Artefakte und Sagen sind historisch.)\', \'type\': \'Kreatur — Meervolk, Soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443222&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a0a3cb31-5b7b-44b1-86ad-ca13d8d8fec4\', \'multiverseId\': 443222}, \'multiverseid\': 443222}, {\'name\': \'Centinela del Tridente Perlado\', \'text\': \'Destello.\\nCuando el Centinela del Tridente Perlado entre al campo de batalla, puedes exiliar el permanente histórico objetivo que controlas. Si lo haces, regresa esa carta al campo de batalla bajo el control de su propietario al comienzo del próximo paso final. (Los artefactos, las Sagas y las cartas legendarias son cartas históricas.)\', \'type\': \'Criatura — Soldado tritón\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443491&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'73c8fb76-1a30-4c5b-80b5-27b423212a87\', \'multiverseId\': 443491}, \'multiverseid\': 443491}, {\'name\': \'Sentinelle du Trident de perles\', \'text\': \'Flash\\nQuand la Sentinelle du Trident de perles arrive sur le champ de bataille, vous pouvez exiler un permanent historique ciblé que vous contrôlez. Si vous faites ainsi, renvoyez cette carte sur le champ de bataille sous le contrôle de son propriétaire au début de la prochaine étape de fin. (Les artefacts, les légendaires et les sagas sont historiques.)\', \'type\': \'Créature : ondin et soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443760&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c7e52415-f1ef-4deb-9edd-6efef5b8f3d5\', \'multiverseId\': 443760}, \'multiverseid\': 443760}, {\'name\': \'Sentinella del Tridente Perlaceo\', \'text\': "Lampo\\nQuando la Sentinella del Tridente Perlaceo entra nel campo di battaglia, puoi esiliare un permanente storico bersaglio che controlli. Se lo fai, rimetti quella carta sul campo di battaglia sotto il controllo del suo proprietario all\'inizio della prossima sottofase finale. (Artefatti, carte leggendarie e Saghe sono carte storiche.)", \'type\': \'Creatura — Soldato Tritone\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444029&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d29fa0b2-a8d8-4123-bf38-f9c883bb62a4\', \'multiverseId\': 444029}, \'multiverseid\': 444029}, {\'name\': \'真珠三叉矛の歩哨\', \'text\': \'瞬速\\n真珠三叉矛の歩哨が戦場に出たとき、あなたがコントロールしている歴史的なパーマネント１つを対象とする。あなたはそれを追放してもよい。そうしたなら、次の終了ステップの開始時に、そのカードをオーナーのコントロール下で戦場に戻す。（歴史的とは、アーティファクトと伝説と英雄譚のことである。）\', \'type\': \'クリーチャー — マーフォーク・兵士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444298&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d86a4a5d-2ea9-4e79-a5e5-8202f9aabe88\', \'multiverseId\': 444298}, \'multiverseid\': 444298}, {\'name\': \'진주 창의 보초병\', \'text\': \'섬광\\n진주 창의 보초병이 전장에 들어올 때, 당신이 조종하는 역사적 지속물을 목표로 정한다. 당신은 그 지속물을 추방할 수 있다. 그렇게 한다면, 다음 종료단 시작에 그 지속물을 소유자의 조종하에 전장으로 되돌린다. (마법물체와 전설적, 서사시가 역사적이다.)\', \'type\': \'생물 — 인어 병사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444567&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'76970297-01b7-4bf0-aa7b-3216de362b82\', \'multiverseId\': 444567}, \'multiverseid\': 444567}, {\'name\': \'Sentinela do Tridente Perolado\', \'text\': \'Lampejo\\nQuando Sentinela do Tridente Perolado entra no campo de batalha, você pode exilar a permanente histórica alvo que você controla. Se fizer isso, devolva aquele card ao campo de batalha sob o controle de seu dono no início da próxima etapa final. (Os artefatos, os cards lendários e as Sagas são cards históricos.)\', \'type\': \'Criatura — Tritão Soldado\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444836&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'86eb9c74-8a0a-412e-ab05-40f6ee6f935b\', \'multiverseId\': 444836}, \'multiverseid\': 444836}, {\'name\': \'Стражник Жемчужного Трезубца\', \'text\': \'Миг\\nКогда Стражник Жемчужного Трезубца выходит на поле битвы, вы можете изгнать целевой исторический перманент под вашим контролем. Если вы это делаете, верните ту карту на поле битвы под контролем ее владельца в начале следующего заключительного шага. (Артефакты, легендарные карты и Саги являются историческими.)\', \'type\': \'Существо — Мерфолк Солдат\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445105&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7d08e2c3-db28-4dba-8f7b-768fe6e3cf43\', \'multiverseId\': 445105}, \'multiverseid\': 445105}, {\'name\': \'珍珠三叉戟哨卫\', \'text\': \'闪现\\n当珍珠三叉戟哨卫进战场时，你可以放逐目标由你操控的史迹永久物。若你如此作，在下一个结束步骤开始时，将该牌在其拥有者的操控下移回战场。（神器、传奇和传纪是史迹。）\', \'type\': \'生物 ～人鱼／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445374&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4d1ef8d9-319c-40e8-be42-631099fa64d5\', \'multiverseId\': 445374}, \'multiverseid\': 445374}, {\'name\': \'珍珠三叉戟哨衛\', \'text\': \'閃現\\n當珍珠三叉戟哨衛進戰場時，你可以放逐目標由你操控的史跡永久物。若你如此作，在下一個結束步驟開始時，將該牌在其擁有者的下移回戰場。（神器、傳奇和傳紀是史跡。）\', \'type\': \'生物 ～人魚／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445643&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'82f4ebba-326a-4160-9541-3350875b61c9\', \'multiverseId\': 445643}, \'multiverseid\': 445643}]', "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443423&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b63df14b-e60a-45f4-bc49-186ac45e31ba', 'multiverseId': 443423}, 'multiverseid': 443423}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443692&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ba98edee-f0c6-47e0-9e38-aab379eb9554', 'multiverseId': 443692}, 'multiverseid': 443692}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443961&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'cb936e61-0548-470a-9bdd-3df544f69188', 'multiverseId': 443961}, 'multiverseid': 443961}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444230&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '1b862e82-aa13-4453-b8c6-a8555e451e9c', 'multiverseId': 444230}, 'multiverseid': 444230}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444499&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '1c922f4b-9b05-49b1-bf21-bd6a24d94d5e', 'multiverseId': 444499}, 'multiverseid': 444499}, {'name': '숲', 'type': '기본 대지 — 숲', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444768&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '965f0cc4-eaf7-4223-8df3-361db189fb67', 'multiverseId': 444768}, 'multiverseid': 444768}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445037&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '69c43fad-8088-4667-a7d1-4331e5a8c661', 'multiverseId': 445037}, 'multiverseid': 445037}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445306&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '125351ff-81ae-4fc3-ba01-d88387588252', 'multiverseId': 445306}, 'multiverseid': 445306}, {'name': '树林', 'type': '基本地 ～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445575&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'beb2aa50-0c47-48cf-989a-891f0cca513c', 'multiverseId': 445575}, 'multiverseid': 445575}, {'name': '樹林', 'type': '基本地 ～樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445844&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '6953f0e1-a15d-4bfa-b108-108b4ec11a2b', 'multiverseId': 445844}, 'multiverseid': 445844}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443424&type=card', 'language': 'German', 'identifiers': {'scryfallId': '81f0c644-27ad-4741-a4f8-ab412db000a0', 'multiverseId': 443424}, 'multiverseid': 443424}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443693&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'db687b3b-a2aa-4312-b9f4-581db0b051f2', 'multiverseId': 443693}, 'multiverseid': 443693}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443962&type=card', 'language': 'French', 'identifiers': {'scryfallId': '0cb0b195-8255-461f-ad0b-2099bc292a92', 'multiverseId': 443962}, 'multiverseid': 443962}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444231&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a6c7327c-4bb3-455a-b166-b103c36ceb4e', 'multiverseId': 444231}, 'multiverseid': 444231}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444500&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'b7cbf39f-643e-4444-ad0d-f4f35b92010e', 'multiverseId': 444500}, 'multiverseid': 444500}, {'name': '숲', 'type': '기본 대지 — 숲', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444769&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'dc2301b0-1455-4914-8b40-e9ba8dafbc50', 'multiverseId': 444769}, 'multiverseid': 444769}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445038&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'db10219c-17d2-4bbf-bc15-078a956ac020', 'multiverseId': 445038}, 'multiverseid': 445038}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445307&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'fbe9dc55-179c-4082-82e1-43d28ed1a93e', 'multiverseId': 445307}, 'multiverseid': 445307}, {'name': '树林', 'type': '基本地 ～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445576&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '33c0f80b-36ac-4114-b9a2-65ac078c0164', 'multiverseId': 445576}, 'multiverseid': 445576}, {'name': '樹林', 'type': '基本地 ～樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445845&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '27386843-6ca7-419c-bd10-0dd6a8da998f', 'multiverseId': 445845}, 'multiverseid': 445845}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443425&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2397142a-a359-4776-ab41-3417b341cea3', 'multiverseId': 443425}, 'multiverseid': 443425}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443694&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '27160b6f-98ee-47d0-922a-ee8988c1332b', 'multiverseId': 443694}, 'multiverseid': 443694}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443963&type=card', 'language': 'French', 'identifiers': {'scryfallId': '5dc3e246-7163-45b2-9185-958f4ef28a1b', 'multiverseId': 443963}, 'multiverseid': 443963}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444232&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3e16bc79-1140-45ff-b91d-15bff1c597e6', 'multiverseId': 444232}, 'multiverseid': 444232}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444501&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f6cb55d6-b64c-480b-b207-686f778decbf', 'multiverseId': 444501}, 'multiverseid': 444501}, {'name': '숲', 'type': '기본 대지 — 숲', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444770&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'b0adafb3-b348-48b7-9deb-59a1109bd668', 'multiverseId': 444770}, 'multiverseid': 444770}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445039&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '122a7e9b-ec90-43ff-a88e-4e1bff407cfe', 'multiverseId': 445039}, 'multiverseid': 445039}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445308&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '223d8e02-416a-4787-9e31-fa46180b4952', 'multiverseId': 445308}, 'multiverseid': 445308}, {'name': '树林', 'type': '基本地 ～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445577&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'bc7ddc4f-6416-4c07-a832-bb6301c43a1c', 'multiverseId': 445577}, 'multiverseid': 445577}, {'name': '樹林', 'type': '基本地 ～樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445846&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'ee0c14da-a1f2-4bce-b227-ee56a0dfd0b6', 'multiverseId': 445846}, 'multiverseid': 445846}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443426&type=card', 'language': 'German', 'identifiers': {'scryfallId': '94e3ed32-b696-43a2-8030-a1acd62e43aa', 'multiverseId': 443426}, 'multiverseid': 443426}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443695&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '3f3e473c-5412-42ef-9a52-57d39b280e14', 'multiverseId': 443695}, 'multiverseid': 443695}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443964&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ff81e06a-c1de-4309-b82a-73534edc687b', 'multiverseId': 443964}, 'multiverseid': 443964}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444233&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3314558a-ba7d-4aef-94ab-8597e95ac8aa', 'multiverseId': 444233}, 'multiverseid': 444233}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444502&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '37d9f4ab-a21d-4ee8-99e5-16ba4b643869', 'multiverseId': 444502}, 'multiverseid': 444502}, {'name': '숲', 'type': '기본 대지 — 숲', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444771&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '1b2b023f-56e2-404f-92c1-c87f73ab96d8', 'multiverseId': 444771}, 'multiverseid': 444771}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445040&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '40917f71-115a-4bf7-9f78-9880e001e836', 'multiverseId': 445040}, 'multiverseid': 445040}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445309&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'fc50685d-f5b7-40da-8d33-fb0e6344418c', 'multiverseId': 445309}, 'multiverseid': 445309}, {'name': '树林', 'type': '基本地 ～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445578&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '0c3758ab-060e-44ca-8982-37121cfc7818', 'multiverseId': 445578}, 'multiverseid': 445578}, {'name': '樹林', 'type': '基本地 ～樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445847&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '716fb31f-fac1-4fbf-84d1-3452637fe1f5', 'multiverseId': 445847}, 'multiverseid': 445847}]", '[{\'name\': \'Waldfriedhof\', \'text\': \'Der Waldfriedhof kommt getappt ins Spiel, es sei denn, du kontrollierst einen Sumpf oder einen Wald.\\n{T}: Erzeuge {B} oder {G}.\', \'type\': \'Land\', \'flavor\': \'„Der Körper des jungen Josu wurde nie gefunden … und auch seine Schwester, die Mörderin, bleibt verschollen." —„Der Untergang des Hauses Vess"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443405&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f3092bd3-dbda-4e60-91cd-4eb5c1729eb6\', \'multiverseId\': 443405}, \'multiverseid\': 443405}, {\'name\': \'Cementerio boscoso\', \'text\': \'El Cementerio boscoso entra al campo de batalla girado a menos que controles un Pantano o un Bosque.\\n{T}: Agrega {B} o {G}.\', \'type\': \'Tierra\', \'flavor\': \'"Nunca encontraron el cuerpo del joven Josu ni el de su hermana fratricida". —"La caída de la casa Vess"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443674&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e69cd96e-5550-4086-ac87-de6c9622c558\', \'multiverseId\': 443674}, \'multiverseid\': 443674}, {\'name\': \'Cimetière des sylves\', \'text\': \'Le Cimetière des sylves arrive sur le champ de bataille engagé à moins que vous ne contrôliez un marais ou une forêt.\\n{T} : Ajoutez {B} ou {G}.\', \'type\': \'Terrain\', \'flavor\': \'« Le corps du jeune Josu ne fut jamais retrouvé, et celui de sa meurtrière de sœur non plus. » —« La chute de la Maison Vess »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443943&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2498d67c-96c9-4070-9fcc-cd776a705115\', \'multiverseId\': 443943}, \'multiverseid\': 443943}, {\'name\': \'Cimitero Silvestre\', \'text\': \'Il Cimitero Silvestre entra nel campo di battaglia TAPpato a meno che tu non controlli una Palude o una Foresta.\\n{T}: Aggiungi {B} o {G}.\', \'type\': \'Terra\', \'flavor\': \'"Il corpo del giovane Josu non venne mai ritrovato, né quello della sorella omicida." —"La Caduta della Casa dei Vess"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444212&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ba2eab03-d7e5-4546-ac41-e1df8780da05\', \'multiverseId\': 444212}, \'multiverseid\': 444212}, {\'name\': \'森林の墓地\', \'text\': \'森林の墓地は、あなたが沼か森をコントロールしていないかぎり、タップ状態で戦場に出る。\\n{T}：{B}か{G}を加える。\', \'type\': \'土地\', \'flavor\': \'「結局、若きジョスの死体は見つからなかった。人殺しの妹もだ。」 ――「ヴェス家の没落」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444481&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5dd24a32-08eb-4570-bf63-2c0f1145ad81\', \'multiverseId\': 444481}, \'multiverseid\': 444481}, {\'name\': \'삼림 묘지\', \'text\': \'삼림 묘지는 당신이 늪이나 숲을 조종하지 않으면 탭된 채로 전장에 들어온다.\\n{T}: {B} 또는 {G}를 추가한다.\', \'type\': \'대지\', \'flavor\': \'"그들은 어린 조수의 시체도, 살인귀 누이의 시체도 찾지 못했다." —"베스 가문의 몰락"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444750&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2ae84c62-8782-4923-a678-ac34979c1c0d\', \'multiverseId\': 444750}, \'multiverseid\': 444750}, {\'name\': \'Cemitério da Floresta\', \'text\': \'Cemitério da Floresta entra no campo de batalha virado, a menos que você controle um Pântano ou uma Floresta.\\n{T}: Adicione {B} ou {G}.\', \'type\': \'Terreno\', \'flavor\': \'"Jamais se achou o corpo do jovem Josu, nem o de sua irmã homicida." — "A Queda da Casa de Vess"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445019&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4198704d-1aec-4aa4-bc4e-c2816e09854c\', \'multiverseId\': 445019}, \'multiverseid\': 445019}, {\'name\': \'Лесное Кладбище\', \'text\': \'Лесное Кладбище выходит на поле битвы повернутым, если под вашим контролем нет Болота или Леса.\\n{T}: добавьте {B} или {G}.\', \'type\': \'Земля\', \'flavor\': \'«Никто так и не нашел тел — ни юного Джозу, ни его душегубки-сестры». — «Падение дома Весс»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445288&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4858225e-a745-4fb1-ae0e-1e05feb90613\', \'multiverseId\': 445288}, \'multiverseid\': 445288}, {\'name\': \'林地墓园\', \'text\': \'除非你操控沼泽或树林，否则林地墓园须横置进战场。\\n{T}：加{B}或{G}。\', \'type\': \'地\', \'flavor\': \'「他们从未找到英年霍苏的遗体，也未曾发现那位害命妹妹的踪迹。」 ～「维斯家族衰亡记」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445557&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'16c34a60-d2c9-44ab-b586-0e3140801e50\', \'multiverseId\': 445557}, \'multiverseid\': 445557}, {\'name\': \'林地墓園\', \'text\': \'除非你操控沼澤或樹林，否則林地墓園須橫置進戰場。\\n{T}：加{B}或{G}。\', \'type\': \'地\', \'flavor\': \'「他們從未找到英年霍蘇的遺體，也未曾發現那位害命妹妹的蹤跡。」 ～「維斯家族衰亡記」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445826&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'16ed4778-0f43-4f5a-9177-bfa310d25e8e\', \'multiverseId\': 445826}, \'multiverseid\': 445826}]', '[{\'name\': \'Wandermagierin der Akademie\', \'text\': \'Dieser Zauberspruch kostet beim Wirken {1} weniger, falls du einen Zauberer kontrollierst.\\nWenn die Wandermagierin der Akademie ins Spiel kommt, bringe eine Kreatur deiner Wahl, die ein Gegner kontrolliert, auf die Hand ihres Besitzers zurück.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'„Wir können nicht kontrollieren, wer hierher kommt. Aber wir entscheiden, wann sie wieder gehen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443198&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'40d9a044-2b15-4999-8ebb-903430aa0058\', \'multiverseId\': 443198}, \'multiverseid\': 443198}, {\'name\': \'Maga graduada de la Academia\', \'text\': \'Te cuesta {1} menos lanzar este hechizo si controlas un Hechicero.\\nCuando la Maga graduada de la Academia entre al campo de batalla, regresa la criatura objetivo que controla un oponente a la mano de su propietario.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'"No elegimos quién viene aquí, pero sí cuánto tiempo se queda".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443467&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'99047c9d-1e82-4035-b154-dfd761c91152\', \'multiverseId\': 443467}, \'multiverseid\': 443467}, {\'name\': "Mage compagnon de l\'Académie", \'text\': "Ce sort coûte {1} de moins à lancer si vous contrôlez un sorcier.\\nQuand le Mage compagnon de l\'Académie arrive sur le champ de bataille, renvoyez une créature ciblée qu\'un adversaire contrôle dans la main de son propriétaire.", \'type\': \'Créature : humain et sorcier\', \'flavor\': "« Nous ne choisissons pas ceux qui viennent ici. Nous décidons du temps qu\'ils restent. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443736&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e5d3afa4-5647-41c7-b446-40fe860cba9c\', \'multiverseId\': 443736}, \'multiverseid\': 443736}, {\'name\': "Maga Veterana dell\'Accademia", \'text\': "Questa magia costa {1} in meno per essere lanciata se controlli un Mago.\\nQuando la Maga Veterana dell\'Accademia entra nel campo di battaglia, fai tornare una creatura bersaglio controllata da un avversario in mano al suo proprietario.", \'type\': \'Creatura — Mago Umano\', \'flavor\': \'"Non decidiamo chi viene qui, ma quanto resterà."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444005&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'66fce58d-9008-4ecb-9ebb-1102e965e6af\', \'multiverseId\': 444005}, \'multiverseid\': 444005}, {\'name\': \'アカデミーの修士魔道士\', \'text\': \'あなたがウィザードをコントロールしているなら、この呪文を唱えるためのコストは{1}少なくなる。\\nアカデミーの修士魔道士が戦場に出たとき、対戦相手がコントロールしているクリーチャー１体を対象とし、それをオーナーの手札に戻す。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'「誰が来るのか我々には選べない。我々はいつまで留まるかを選ぶのだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444274&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c347659a-c540-4b83-83d1-1d2943cc5140\', \'multiverseId\': 444274}, \'multiverseid\': 444274}, {\'name\': \'아카데미 수습마도사\', \'text\': \'당신이 마법사를 조종한다면 이 주문은 발동하는 데 {1}이 덜 든다.\\n아카데미 수습마도사가 전장에 들어올 때, 상대가 조종하는 생물을 목표로 정한다. 그 생물을 소유자의 손으로 되돌린다.\', \'type\': \'생물 — 인간 마법사\', \'flavor\': \'"우리는 누가 이곳에 올 수 있는지 정하지 않는다. 다만 그들이 얼마나 머물 수 있는지를 정한다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444543&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b74146d7-44ff-47ea-8c90-e1f82e6ebd54\', \'multiverseId\': 444543}, \'multiverseid\': 444543}, {\'name\': \'Maga Graduada da Academia\', \'text\': \'Esta mágica custa {1} a menos para ser conjurada se você controla um Mago.\\nQuando Maga Graduada da Academia entrar no campo de batalha, devolva a criatura alvo que um oponente controla para a mão de seu dono.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'"Não escolhemos quem vem. Escolhemos quanto tempo ficarão."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444812&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6f27e24b-061f-4e66-87b5-60eb0bfb39f5\', \'multiverseId\': 444812}, \'multiverseid\': 444812}, {\'name\': \'Маг-Подмастерье из Академии\', \'text\': \'Разыгрывание этого заклинания стоит на {1} меньше, если вы контролируете Чародея.\\nКогда Маг-Подмастерье из Академии выходит на поле битвы, верните целевое существо под контролем оппонента в руку его владельца.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'«Мы не властны над тем, кто сюда приходит. Но нам решать, сколько они пробудут здесь».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445081&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6a47fc72-c9ca-4a35-a317-786acf61d33a\', \'multiverseId\': 445081}, \'multiverseid\': 445081}, {\'name\': \'学院老练法师\', \'text\': \'如果你操控法术师，则此咒语减少{1}来施放。\\n当学院老练法师进战场时，将目标由对手操控的生物移回其拥有者手上。\', \'type\': \'生物 ～人类／法术师\', \'flavor\': \'「造访此地与否由人们决定。在此停留多久由我们决定。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445350&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fc2987c9-606f-418f-934e-5e89428e7eb5\', \'multiverseId\': 445350}, \'multiverseid\': 445350}, {\'name\': \'學院老練法師\', \'text\': \'如果你操控魔法師，則此咒語減少{1}來施放。\\n當學院老練法師進戰場時，將目標由對手操控的生物移回其擁有者手上。\', \'type\': \'生物 ～人類／魔法師\', \'flavor\': \'「造訪此地與否由人們決定。在此停留多久由我們決定。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445619&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ca55d629-8f02-4635-82ae-a3095133544a\', \'multiverseId\': 445619}, \'multiverseid\': 445619}]', '[{\'name\': \'Weiser von Lat-Nam\', \'text\': \'{T}, opfere ein Artefakt: Ziehe eine Karte.\', \'type\': \'Kreatur — Mensch, Handwerker\', \'flavor\': \'Obwohl die Brüder die Akademie von Lat-Nam in Schutt und Asche gelegt hatten, ist sie dennoch der Ursprung der Lehren vieler Magieschulen, sogar der ersten Tolarianischen Akademie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443221&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6294dc8a-d3a7-41e0-9134-732717132cad\', \'multiverseId\': 443221}, \'multiverseid\': 443221}, {\'name\': \'Sabio de Lat-Nam\', \'text\': \'{T}, sacrificar un artefacto: Roba una carta.\', \'type\': \'Criatura — Artífice humano\', \'flavor\': \'Aunque fue destruida por los hermanos, muchas escuelas de magia tienen sus orígenes en la Escuela de Lat-Nam, incluida la primera Academia Tolariana.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443490&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5a692a92-590f-43ef-b771-f17fe26f59ce\', \'multiverseId\': 443490}, \'multiverseid\': 443490}, {\'name\': \'Sage de Lat-Nam\', \'text\': \'{T}, sacrifiez un artefact : Piochez une carte.\', \'type\': \'Créature : humain et artificier\', \'flavor\': "De nombreuses écoles de magie, y compris la première Académie tolariane, trouvent leur origine au Collège de Lat-Nam, bien qu\'il fut dévasté par les frères.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443759&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6093408f-721a-4bbe-b39a-e2c724a87a3b\', \'multiverseId\': 443759}, \'multiverseid\': 443759}, {\'name\': \'Saggio di Lat-Nam\', \'text\': \'{T}, Sacrifica un artefatto: Pesca una carta.\', \'type\': \'Creatura — Artefice Umano\', \'flavor\': "Sebbene sia stato devastato dai fratelli, l\'Istituto di Lat-Nam ha dato origine a molte scuole di magia, inclusa la prima Accademia di Tolaria.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444028&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d4ab8bd7-0405-42d9-ad92-2a7df243ae59\', \'multiverseId\': 444028}, \'multiverseid\': 444028}, {\'name\': \'ラト＝ナムの賢人\', \'text\': \'{T}, アーティファクト１つを生け贄に捧げる：カードを１枚引く。\', \'type\': \'クリーチャー — 人間・工匠\', \'flavor\': \'兄弟による被害があったものの、魔法を教える学校の多くはその起源をラト＝ナム大学に遡ることができる。元々のトレイリアのアカデミーも例外ではない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444297&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d051e6c6-ba9f-4886-ba24-2d577759ffa5\', \'multiverseId\': 444297}, \'multiverseid\': 444297}, {\'name\': \'라트-남의 현자\', \'text\': \'{T}, 마법물체 한 개를 희생한다: 카드 한 장을 뽑는다.\', \'type\': \'생물 — 인간 기능공\', \'flavor\': \'형제들에게 버려지기는했지만, 톨라리안 아카데미를 포함한 여러 마법 학교들은 자신들의 기원을 찾으며 라트-남 대학에까지 이르렀다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444566&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'32050cf1-df2e-46a6-9914-d7b768d7e908\', \'multiverseId\': 444566}, \'multiverseid\': 444566}, {\'name\': \'Sábio de Lat-Nam\', \'text\': \'{T}, sacrifique um artefato: Compre um card.\', \'type\': \'Criatura — Humano Artesão\', \'flavor\': \'Embora ela tenha sido obliterada pelos irmãos, a origem de muitas escolas de magia remonta à Faculdade de Lat-Nam, incluindo a da primeira Academia Tolariana.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444835&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'791962b0-4e8a-4b78-a4be-104ac4684144\', \'multiverseId\': 444835}, \'multiverseid\': 444835}, {\'name\': \'Мудрец из Лат-Нама\', \'text\': \'{T}, пожертвуйте артефакт: возьмите карту.\', \'type\': \'Существо — Человек Механик\', \'flavor\': \'Лат-Намский колледж был стерт братьями с лица земли, но многие школы магии возводят к нему свое происхождение — в том числе и первая Толарианская академия.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445104&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f84d486e-e46b-4eea-bd87-8bb831e1f750\', \'multiverseId\': 445104}, \'multiverseid\': 445104}, {\'name\': \'拉特南智者\', \'text\': \'{T}，牺牲一个神器：抓一张牌。\', \'type\': \'生物 ～人类／神器师\', \'flavor\': \'拉特南学院虽然已被两兄弟夷为平地，但许多法术学派都将起源追溯到此地，包括第一所陶拉里亚大学院。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445373&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2c76554b-98f4-4a81-a492-b1db7859de2e\', \'multiverseId\': 445373}, \'multiverseid\': 445373}, {\'name\': \'拉特南智者\', \'text\': \'{T}，犧牲一個神器：抽一張牌。\', \'type\': \'生物 ～人類／神器師\', \'flavor\': \'拉特南學院雖然已被兩兄弟夷為平地，但許多魔法學派都將起源追溯到此地，包括第一所陶拉里亞大學院。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445642&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'45fb2d5a-bf29-4f93-877b-191bea1f7556\', \'multiverseId\': 445642}, \'multiverseid\': 445642}]', '[{\'name\': \'Weissagung\', \'text\': \'Ziehe zwei Karten.\', \'type\': \'Hexerei\', \'flavor\': \'„In der ersten Hälfte deiner Ausbildung studierst du die Gesetze der Magie. In der zweiten Hälfte lernst du, sie in deinem Sinne zu interpretieren." —Naru Meha, die Meisterzauberin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443209&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f07f761a-30ab-4096-925f-7fa45b7271f1\', \'multiverseId\': 443209}, \'multiverseid\': 443209}, {\'name\': \'Adivinación\', \'text\': \'Roba dos cartas.\', \'type\': \'Conjuro\', \'flavor\': \'"Dedicarás la mitad de tu tiempo de estudio a aprender las reglas de la magia y la otra mitad a descubrir cómo manipularlas". —Naru Meha, maga experta\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443478&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9a7f4696-7248-440a-b92c-f438d6d30d38\', \'multiverseId\': 443478}, \'multiverseid\': 443478}, {\'name\': \'Divination\', \'text\': \'Piochez deux cartes.\', \'type\': \'Rituel\', \'flavor\': "« La moitié de vos études consistera à apprendre les lois de la magie. L\'autre moitié consistera à les faire plier. » —Naru Meha, maître sorcier", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443747&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2241870c-066f-4f74-a8f0-6c77341390fc\', \'multiverseId\': 443747}, \'multiverseid\': 443747}, {\'name\': \'Divinazione\', \'text\': \'Pesca due carte.\', \'type\': \'Stregoneria\', \'flavor\': \'"Metà dei vostri studi consisterà nell\\\'apprendere le leggi della magia. L\\\'altra metà nel piegarle." —Naru Meha, maga insegnante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444016&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8ba5acea-193a-4249-a79a-660759bf1aa5\', \'multiverseId\': 444016}, \'multiverseid\': 444016}, {\'name\': \'予言\', \'text\': \'カードを２枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'「諸君の勉学の半分は魔法の法則を学ぶことに充てられる。残りの半分でそれを捻じ曲げることを学ぶ。」 ――練達の魔術師、ナル・メハ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444285&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d1ac992b-06eb-45de-b2c0-0c0caf5bd0d9\', \'multiverseId\': 444285}, \'multiverseid\': 444285}, {\'name\': \'점\', \'text\': \'카드 두 장을 뽑는다.\', \'type\': \'집중마법\', \'flavor\': \'"그대의 연구 중 절반은 마법의 법칙을 이해하는 것일세. 그리고 나머지 절반은 그것을 다루는 법을 배우는 것이지." —대마법사, 나루 메하\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444554&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'020d4404-e2ab-4681-aba1-d6a118cf6853\', \'multiverseId\': 444554}, \'multiverseid\': 444554}, {\'name\': \'Divinação\', \'text\': \'Compre dois cards.\', \'type\': \'Feitiço\', \'flavor\': \'"Metade de seus estudos será aprender as leis da magia. A outra metade será como dobrá-las." — Naru Meha, maga mestra\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444823&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dc5cab0a-4d70-4f0f-ae3d-ccc62ee81b02\', \'multiverseId\': 444823}, \'multiverseid\': 444823}, {\'name\': \'Прорицание\', \'text\': \'Возьмите две карты.\', \'type\': \'Волшебство\', \'flavor\': \'«Первая половина учебы — познание законов магии. Вторая половина — их нарушение». — Нару Меха, верховная волшебница\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445092&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6a558a70-d347-42ec-a4d5-df2811bba72b\', \'multiverseId\': 445092}, \'multiverseid\': 445092}, {\'name\': \'卜卦\', \'text\': \'抓两张牌。\', \'type\': \'法术\', \'flavor\': \'「你一半的时间会用来学习法术定律。另一半则会用来扭曲它们。」 ～魔法大师娜鲁梅哈\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445361&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5e1b1990-5a95-404b-86e8-8c69dcaf7ba5\', \'multiverseId\': 445361}, \'multiverseid\': 445361}, {\'name\': \'卜卦\', \'text\': \'抽兩張牌。\', \'type\': \'巫術\', \'flavor\': \'「你一半的時間會用來學習魔法定律。另一半則會用來扭曲它們。」 ～魔法大師娜魯梅哈\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445630&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'15b0f329-e087-4684-a99b-508e0c7589d1\', \'multiverseId\': 445630}, \'multiverseid\': 445630}]', '[{\'name\': \'Wetterlicht\', \'text\': \'Fliegend\\nImmer wenn die Wetterlicht einem Spieler Kampfschaden zufügt, schaue dir die obersten fünf Karten deiner Bibliothek an. Du kannst davon eine historische Karte offen vorzeigen und auf deine Hand nehmen. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek. (Legenden, Artefakte und Sagen sind historisch.)\\nBemannen 3\', \'type\': \'Legendäres Artefakt — Fahrzeug\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443394&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'377484b4-c725-412b-b728-75e495172f9e\', \'multiverseId\': 443394}, \'multiverseid\': 443394}, {\'name\': \'Vientoligero\', \'text\': \'Vuela.\\nSiempre que el Vientoligero haga daño de combate a un jugador, mira las cinco primeras cartas de tu biblioteca. Puedes mostrar una carta histórica que se encuentre entre ellas y ponerla en tu mano. Pon el resto en el fondo de tu biblioteca en un orden aleatorio. (Los artefactos, las Sagas y las cartas legendarias son cartas históricas.)\\nTripular 3.\', \'type\': \'Artefacto legendario — Vehículo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443663&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'56b2177a-dc81-4f9c-a10d-c4a484b3c022\', \'multiverseId\': 443663}, \'multiverseid\': 443663}, {\'name\': \'Aquilon\', \'text\': "Vol\\nÀ chaque fois que l\'Aquilon inflige des blessures de combat à un joueur, regardez les cinq cartes du dessus de votre bibliothèque. Vous pouvez révéler une carte historique parmi elles et la mettre dans votre main. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire. (Les artefacts, les légendaires et les sagas sont historiques.)\\nPilotage 3", \'type\': \'Artefact légendaire : véhicule\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443932&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ec5b73c0-a53d-4543-ad36-3d1dbab67695\', \'multiverseId\': 443932}, \'multiverseid\': 443932}, {\'name\': \'Cavalcavento\', \'text\': \'Volare\\nOgniqualvolta la Cavalcavento infligge danno da combattimento a un giocatore, guarda le prime cinque carte del tuo grimorio. Puoi rivelare una carta storica scelta tra esse e aggiungerla alla tua mano. Metti le altre in fondo al tuo grimorio in ordine casuale. (Artefatti, carte leggendarie e Saghe sono carte storiche.)\\nManovrare 3\', \'type\': \'Artefatto Leggendario — Veicolo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444201&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2c9c5e08-4a64-4364-bf14-9e440e442865\', \'multiverseId\': 444201}, \'multiverseid\': 444201}, {\'name\': \'ウェザーライト\', \'text\': \'飛行\\nウェザーライトがプレイヤー１人に戦闘ダメージを与えるたび、あなたのライブラリーの一番上からカードを５枚見る。あなたはその中から歴史的なカード１枚を公開してあなたの手札に加えてもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。（歴史的とは、アーティファクトと伝説と英雄譚のことである。）\\n搭乗３\', \'type\': \'伝説のアーティファクト — 機体\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444470&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'43d0006f-6d6c-4892-80a3-5e54b911ef5a\', \'multiverseId\': 444470}, \'multiverseid\': 444470}, {\'name\': \'웨더라이트\', \'text\': \'비행\\n웨더라이트가 플레이어에게 전투피해를 입힐 때마다, 당신의 서고 맨 위 카드 다섯 장을 본다. 당신은 그중에서 역사적 카드 한 장을 공개하고 당신의 손으로 가져갈 수 있다. 나머지 카드들은 무작위 순서로 당신의 서고 맨 밑에 놓는다. (마법물체와 전설적, 서사시가 역사적이다.)\\n탑승 3\', \'type\': \'전설적 마법물체 — 탑승물\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444739&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0ca10de2-49ff-4d11-9eff-bc245e93a05d\', \'multiverseId\': 444739}, \'multiverseid\': 444739}, {\'name\': \'Bons Ventos\', \'text\': \'Voar\\nToda vez que Bons Ventos causar dano de combate a um jogador, olhe os cinco cards do topo de seu grimório. Você pode revelar um card histórico dentre eles e colocá-lo em sua mão. Coloque o restante no fundo de seu grimório em ordem aleatória. (Os artefatos, os cards lendários e as Sagas são cards históricos.)\\nTripular 3\', \'type\': \'Artefato Lendário — Veículo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445008&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4097cd02-c964-45db-acd0-44d4cc175aab\', \'multiverseId\': 445008}, \'multiverseid\': 445008}, {\'name\': \'«Везерлайт»\', \'text\': \'Полет\\nКаждый раз, когда «Везерлайт» наносит боевые повреждения игроку, посмотрите пять верхних карт вашей библиотеки. Вы можете показать находящуюся среди них историческую карту и положить ее в вашу руку. Положите остальные карты в низ вашей библиотеки в случайном порядке. (Артефакты, легендарные карты и Саги являются историческими.)\\nЭкипаж 3\', \'type\': \'Легендарный Артефакт — Машина\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445277&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c4db4b89-3e39-4284-b3fa-570d31b69236\', \'multiverseId\': 445277}, \'multiverseid\': 445277}, {\'name\': \'晴空号\', \'text\': \'飞行\\n每当晴空号对任一牌手造成战斗伤害时，检视你牌库顶的五张牌。你可以展示其中的一张史迹牌，并将它置于你手上。将其余的牌以随机顺序置于你的牌库底。（神器、传奇和传纪是史迹。）\\n搭载3\', \'type\': \'传奇神器 ～载具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445546&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'41a71fbc-2296-47d3-9994-afc9e4482fb4\', \'multiverseId\': 445546}, \'multiverseid\': 445546}, {\'name\': \'晴空號\', \'text\': \'飛行\\n每當晴空號對任一玩家造成戰鬥傷害時，檢視你牌庫頂的五張牌。你可以展示其中的一張史跡牌，並將它置於你手上。將其餘的牌以隨機順序置於你的牌庫底。（神器、傳奇和傳紀是史跡。）\\n搭載3\', \'type\': \'傳奇神器 ～載具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445815&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e78b0b82-91bf-4f77-aa19-d0886b408a9a\', \'multiverseId\': 445815}, \'multiverseid\': 445815}]', '[{\'name\': \'Wilde Abscheulichkeit\', \'text\': \'Todesberührung\', \'type\': \'Kreatur — Thrull\', \'flavor\': \'„Urborg war einst wunderschön — malerische Vulkane, respektable Lich-Fürsten. Doch seit die Kabbalisten mit ihren Nachtmahren und ihren Thrulls aufgetaucht sind, ist alles vor die Würmer gegangen." —Herr Löffelschwund, Tratschtante der Schädelstadt\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443249&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1a8c9915-806e-4f7f-8697-57a27e67c0f5\', \'multiverseId\': 443249}, \'multiverseid\': 443249}, {\'name\': \'Abominación brutal\', \'text\': \'Toque mortal.\', \'type\': \'Criatura — Thrull\', \'flavor\': \'"En el pasado, Urborg era hermoso, con majestuosos volcanes y señores liche respetables; pero... desde que llegó la Cábala con sus pesadillas y sus thrulls, todo se echó a perder". —Señor Cucharaperdida, chafardero de Ciudad Calavera\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443518&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'47483a1d-3835-41ff-b792-502624aa12d0\', \'multiverseId\': 443518}, \'multiverseid\': 443518}, {\'name\': \'Abomination sauvage\', \'text\': \'Contact mortel\', \'type\': \'Créature : srâne\', \'flavor\': \'« Urborg était autrefois un bel endroit, avec ses volcans pittoresques et ses seigneurs liches respectables. Depuis que la Coterie est arrivée avec ses cauchemars et ses srânes, tout a pourri. » —Monsieur Pertelouche, commère de Crânebourg\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443787&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cf02d329-dd83-48d4-a724-2a4f51814f65\', \'multiverseId\': 443787}, \'multiverseid\': 443787}, {\'name\': \'Abominio Feroce\', \'text\': \'Tocco letale\', \'type\': \'Creatura — Thrull\', \'flavor\': \'"Un tempo Urborg era un luogo idilliaco: vulcani spettacolari, signori dei lich rispettabili... Da quando è arrivata la Cabala con i suoi incubi e thrull, è andato tutto in pasto ai vermi." —Signor Perdicucchiai, pettegolo di Borgo dei Teschi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444056&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b1bf2103-f5cd-4aa6-a295-5ac9abfcf23c\', \'multiverseId\': 444056}, \'multiverseid\': 444056}, {\'name\': \'残忍な異形\', \'text\': \'接死\', \'type\': \'クリーチャー — スラル\', \'flavor\': \'「昔のアーボーグはいい場所だった。美しい火山や立派な死者の王。陰謀団がナイトメアやスラルを連れてきてからというもの、みんな虫のとこに行っちまった。」 ――スカルタウンの噂好き、ミスター・ロストスプーンズ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444325&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6a40dd05-4b99-426f-b0e6-b8740d6b72fa\', \'multiverseId\': 444325}, \'multiverseid\': 444325}, {\'name\': \'치명적인 흉물\', \'text\': \'치명타\', \'type\': \'생물 — 스럴\', \'flavor\': \'"우르보그는 한때 아름다운 화산, 경외받는 리치 군주였다. 도당이 나이트메어와 스럴을 몰고 왔을 때, 모든 것은 한낱 벌레가 되고 말았다." —스컬타운의 소문꾼, 로스트스푼즈\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444594&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'14ef50b1-3910-4490-8420-049d9c78e925\', \'multiverseId\': 444594}, \'multiverseid\': 444594}, {\'name\': \'Abominação Selvagem\', \'text\': \'Toque mortífero\', \'type\': \'Criatura — Thrull\', \'flavor\': \'"Urborg costumava ser adorável — belos vulcões, senhores liches respeitáveis. Desde que a Cabala chegou com aqueles pesadelos e thrulls, ficou tudo jogado aos vermes." — Senhor Colheresperdidas, fofoqueiro de Craniópolis\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444863&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'84dc8da9-ec65-4036-8fd5-3dc66bd2e945\', \'multiverseId\': 444863}, \'multiverseid\': 444863}, {\'name\': \'Дикая Мерзость\', \'text\': \'Смертельное касание\', \'type\': \'Существо — Трулл\', \'flavor\': \'«Урборг когда-то был чудным местечком — красочные вулканы, владетельные лорды-личи. Но когда явился Кабал со своими кошмарами и труллами, все это пошло на прокорм червям». — Господин Поварешник, болтун из Черепограда\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445132&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3502816b-d6dc-45cf-92c2-d23e14d9e464\', \'multiverseId\': 445132}, \'multiverseid\': 445132}, {\'name\': \'野性憎恶兽\', \'text\': \'死触\', \'type\': \'生物 ～索尔兽\', \'flavor\': \'「乌尔博格曾经很美好～壮丽的火山，受人尊敬的巫妖领主。自从柯帮带来了他们的梦魇和索尔兽，这一切都喂了虫子。」 ～颅骨镇包打听失勺先生\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445401&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5470cd6b-9ec1-4960-97b2-561c59a51972\', \'multiverseId\': 445401}, \'multiverseid\': 445401}, {\'name\': \'野性憎恨獸\', \'text\': \'死觸\', \'type\': \'生物 ～索爾獸\', \'flavor\': \'「烏爾博格曾經很美好～壯麗的火山，受人尊敬的巫妖領主。自從柯幫帶來了他們的夢魘和索爾獸，這一切都餵了蟲子。」 ～顱骨鎮包打聽失勺先生\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445670&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9195c6d8-a955-453b-b832-09d649ea3849\', \'multiverseId\': 445670}, \'multiverseid\': 445670}]', "[{'name': 'Wilder Aufmarsch', 'text': 'Bonus {4} (Du kannst zusätzlich {4} bezahlen, sowie du diesen Zauberspruch wirkst.)\\nLege auf jede Kreatur, die du kontrollierst, eine +1/+1-Marke. Falls die Bonuskosten dieses Zauberspruchs bezahlt wurden, lege stattdessen zwei +1/+1-Marken auf jede Kreatur, die du kontrollierst.', 'type': 'Spontanzauber', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443345&type=card', 'language': 'German', 'identifiers': {'scryfallId': '294b5120-bada-44d3-acf9-cc2835e1319a', 'multiverseId': 443345}, 'multiverseid': 443345}, {'name': 'Embestida salvaje', 'text': 'Estímulo {4}. (Puedes pagar {4} adicionales al lanzar este hechizo.)\\nPon un contador +1/+1 sobre cada criatura que controlas. Si este hechizo fue estimulado, en vez de eso, pon dos contadores +1/+1 sobre cada criatura que controlas.', 'type': 'Instantáneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443614&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '190b2c50-efa9-4195-9c1c-a16c76667641', 'multiverseId': 443614}, 'multiverseid': 443614}, {'name': 'Carnage de la forêt', 'text': 'Kick {4} (Vous pouvez payer {4} supplémentaires au moment où vous lancez ce sort.)\\nMettez un marqueur +1/+1 sur chaque créature que vous contrôlez. Si ce sort a été kické, mettez deux marqueurs +1/+1 sur chaque créature que vous contrôlez à la place.', 'type': 'Éphémère', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443883&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ec2f1862-c8fe-4e2c-b917-5ce649640b5a', 'multiverseId': 443883}, 'multiverseid': 443883}, {'name': 'Assalto Selvaggio', 'text': 'Potenziamento {4} (Puoi pagare {4} addizionale mentre lanci questa magia.)\\nMetti un segnalino +1/+1 su ogni creatura che controlli. Se questa magia è stata potenziata, metti invece due segnalini +1/+1 su ogni creatura che controlli.', 'type': 'Istantaneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444152&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ef357946-0454-4f5b-a525-e8a7ed3a0fb8', 'multiverseId': 444152}, 'multiverseid': 444152}, {'name': '野生の猛攻', 'text': 'キッカー{4}（あなたはこの呪文を唱えるに際し、追加で{4}を支払ってもよい。）\\nあなたがコントロールしている各クリーチャーの上に＋１/＋１カウンターをそれぞれ１個置く。この呪文がキッカーされていたなら、代わりに、あなたがコントロールしている各クリーチャーの上に＋１/＋１カウンターをそれぞれ２個置く。', 'type': 'インスタント', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444421&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '3bb47168-dc61-4abb-bf39-039713f2e121', 'multiverseId': 444421}, 'multiverseid': 444421}, {'name': '사나운 공습', 'text': '키커 {4} (당신은 이 주문을 발동하면서 추가로 {4}를 지불할 수 있다.)\\n당신이 조종하는 각 생물에 +1/+1 카운터 한 개를 올려놓는다. 이 주문의 키커 비용이 지불되었다면, 대신 당신이 조종하는 각 생물에 +1/+1 카운터 두 개를 올려놓는다.', 'type': '순간마법', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444690&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '6f1900c6-260c-4a99-9da7-58bbc85df8e1', 'multiverseId': 444690}, 'multiverseid': 444690}, {'name': 'Investida Selvagem', 'text': 'Reforçar {4} (Você pode pagar um custo adicional de {4} ao conjurar esta mágica.)\\nColoque um marcador +1/+1 em cada criatura que você controla. Se esta mágica tiver sido reforçada, coloque, em vez disso, dois marcadores +1/+1 em cada criatura que você controla.', 'type': 'Mágica Instantânea', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444959&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0a913fbe-2ff5-4a06-98db-0ebd32c85fc9', 'multiverseId': 444959}, 'multiverseid': 444959}, {'name': 'Дикий Натиск', 'text': 'Усилитель {4} (При разыгрывании этого заклинания вы можете дополнительно заплатить {4}.)\\nПоложите один жетон +1/+1 на каждое существо под вашим контролем. Если это заклинание получило Усилитель, вместо этого положите два жетона +1/+1 на каждое существо под вашим контролем.', 'type': 'Мгновенное заклинание', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445228&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'eafa6f75-4da9-4d83-a9ec-d35579e31029', 'multiverseId': 445228}, 'multiverseid': 445228}, {'name': '荒野猛攻', 'text': '增幅{4}（你施放此咒语时可以额外支付{4}。）\\n在每个由你操控的生物上各放置一个+1/+1指示物。如果此咒语已增幅，则改为在每个由你操控的生物上各放置两个+1/+1指示物。', 'type': '瞬间', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445497&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '42abf417-00ed-4089-9a25-5b1a047f3358', 'multiverseId': 445497}, 'multiverseid': 445497}, {'name': '荒野猛攻', 'text': '增幅{4}（你施放此咒語時可以額外支付{4}）。\\n在每個由你操控的生物上各放置一個+1/+1指示物。如果此咒語已增幅，則改為在每個由你操控的生物上放置兩個+1/+1指示物。', 'type': '瞬間', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445766&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '11675788-ba8b-488e-bc85-66374f9a9fa5', 'multiverseId': 445766}, 'multiverseid': 445766}]", '[{\'name\': \'Windgrace-Tempeldiener\', \'text\': \'Fliegend\\nWenn der Windgrace-Tempeldiener ins Spiel kommt, lege die obersten drei Karten deiner Bibliothek auf deinen Friedhof und du erhältst 3 Lebenspunkte dazu.\', \'type\': \'Kreatur — Katze, Krieger\', \'flavor\': \'Die Tempeldiener des verschollenen Lord Windgrace kämpfen dafür, dass kein Urborg-Relikt den Kabbalisten in die Hände fällt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443269&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f44d0712-1df6-4778-be55-4682125ab7d3\', \'multiverseId\': 443269}, \'multiverseid\': 443269}, {\'name\': \'Acólito de Windgrace\', \'text\': \'Vuela.\\nCuando el Acólito de Windgrace entre al campo de batalla, pon las tres primeras cartas de tu biblioteca en tu cementerio y ganas 3 vidas.\', \'type\': \'Criatura — Guerrero felino\', \'flavor\': \'Los acólitos del desaparecido lord Windgrace luchan para que las reliquias de Urborg no caigan en las manos de la Cábala.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443538&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2817f899-3248-4f02-b362-d621863e2266\', \'multiverseId\': 443538}, \'multiverseid\': 443538}, {\'name\': \'Acolyte Vent des vertus\', \'text\': "Vol\\nQuand l\'Acolyte Vent des vertus arrive sur le champ de bataille, mettez les trois cartes du dessus de votre bibliothèque dans votre cimetière et vous gagnez 3 points de vie.", \'type\': \'Créature : chat et guerrier\', \'flavor\': "Les acolytes du regretté seigneur Vent des vertus combattent pour éviter que les reliques d\'Urborg ne tombent entre les mains de la Coterie.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443807&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'83298ee9-2b26-462c-8878-e51110836e38\', \'multiverseId\': 443807}, \'multiverseid\': 443807}, {\'name\': \'Accolito di Windgrace\', \'text\': "Volare\\nQuando l\'Accolito di Windgrace entra nel campo di battaglia, metti nel tuo cimitero le prime tre carte del tuo grimorio e guadagni 3 punti vita.", \'type\': \'Creatura — Guerriero Felino\', \'flavor\': \'Gli accoliti del compianto Lord Windgrace combattono per proteggere le reliquie di Urborg dalle grinfie della Cabala.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444076&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2c5a2889-4a6e-4344-b5a0-574cf6681e55\', \'multiverseId\': 444076}, \'multiverseid\': 444076}, {\'name\': \'ウィンドグレイスの見習い\', \'text\': \'飛行\\nウィンドグレイスの見習いが戦場に出たとき、あなたのライブラリーの一番上からカードを３枚あなたの墓地に置き、あなたは３点のライフを得る。\', \'type\': \'クリーチャー — 猫・戦士\', \'flavor\': \'ウィンドグレイス卿の失踪後も、見習いたちがアーボーグの秘宝を陰謀団の手に渡さぬよう戦い続けている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444345&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cad8aada-74dc-412d-adea-1a0f49ff41fa\', \'multiverseId\': 444345}, \'multiverseid\': 444345}, {\'name\': \'윈드그레이스 시종\', \'text\': \'비행\\n윈드그레이스 시종이 전장에 들어올 때, 당신의 서고 맨 위 카드 세 장을 당신의 무덤에 넣고 당신은 생명 3점을 얻는다.\', \'type\': \'생물 — 고양이 전사\', \'flavor\': \'윈드그레이스의 시종들은 우르보그의 유물이 도당의 손에 들어가지 못하도록 싸우고 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444614&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6d290171-3bc8-4f1d-bc07-ab16b6893519\', \'multiverseId\': 444614}, \'multiverseid\': 444614}, {\'name\': \'Acólito de Windgrace\', \'text\': \'Voar\\nQuando Acólito de Windgrace entrar no campo de batalha, coloque os três cards do topo de seu grimório em seu cemitério. Você ganha 3 pontos de vida.\', \'type\': \'Criatura — Felino Guerreiro\', \'flavor\': \'Acólitos do antigo Lorde Windgrace lutam para evitar que relíquias de Urborg caiam nas mãos da Cabala.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444883&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c0243a8d-9485-4d79-b96e-04da23443507\', \'multiverseId\': 444883}, \'multiverseid\': 444883}, {\'name\': \'Служитель Виндгрейса\', \'text\': \'Полет\\nКогда Служитель Виндгрейса выходит на поле битвы, положите три верхние карты вашей библиотеки на ваше кладбище, и вы получаете 3 жизни.\', \'type\': \'Существо — Кошка Воин\', \'flavor\': \'Служители пропавшего без вести лорда Виндгрейса сражаются, чтобы не дать Кабалу завладеть реликвиями Урборга.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445152&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'20301fe3-af34-4ee0-9bd9-d3adb915ea78\', \'multiverseId\': 445152}, \'multiverseid\': 445152}, {\'name\': \'风华侍僧\', \'text\': \'飞行\\n当风华侍僧进战场时，将你牌库顶的三张牌置入你的坟墓场且你获得3点生命。\', \'type\': \'生物 ～猫／战士\', \'flavor\': \'已故风华领主的侍僧们奋力抵抗，阻止柯帮染指乌尔博格遗宝。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445421&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b6a73fbd-d99d-4391-a7b6-5d169ef9b562\', \'multiverseId\': 445421}, \'multiverseid\': 445421}, {\'name\': \'風華侍僧\', \'text\': \'飛行\\n當風華侍僧進戰場時，將你牌庫頂的三張牌置入你的墳墓場且你獲得3點生命。\', \'type\': \'生物 ～貓／戰士\', \'flavor\': \'已故風華領主的侍僧們奮力抵抗，阻止柯幫染指烏爾博格遺寶。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445690&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ff2d884d-ad70-4bb0-83d1-1c6ed14116ae\', \'multiverseId\': 445690}, \'multiverseid\': 445690}]', '[{\'name\': \'Wisper, die Blutliturgistin\', \'text\': \'{T}, opfere zwei Kreaturen: Bringe eine Kreaturenkarte deiner Wahl aus deinem Friedhof ins Spiel zurück.\', \'type\': \'Legendäre Kreatur — Mensch, Kleriker\', \'flavor\': \'„Sieh nur, wie sie um die Klinge betteln! Der Dämonenfürst hat sie gut abgerichtet."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443268&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1475a778-29d7-4ace-9774-323203c43b4a\', \'multiverseId\': 443268}, \'multiverseid\': 443268}, {\'name\': \'Susurro, liturgista de la sangre\', \'text\': \'{T}, sacrificar dos criaturas: Regresa la carta de criatura objetivo de tu cementerio al campo de batalla.\', \'type\': \'Criatura legendaria — Clérigo humano\', \'flavor\': \'"¡Observa cómo me suplican que use la daga! El señor demonio los entrenó bien".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443537&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3f42097a-7c7f-4581-9647-f694c31a9345\', \'multiverseId\': 443537}, \'multiverseid\': 443537}, {\'name\': \'Murmure, liturgiste de sang\', \'text\': \'{T}, sacrifiez deux créatures : Renvoyez sur le champ de bataille une carte de créature ciblée depuis votre cimetière.\', \'type\': \'Créature légendaire : humain et clerc\', \'flavor\': \'« Regardez-les implorer le couteau ! Le Seigneur démon les a bien dressés. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443806&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6dfa5cc5-49c5-4c73-967f-2e204d050193\', \'multiverseId\': 443806}, \'multiverseid\': 443806}, {\'name\': \'Sussurro, Liturgista Sanguigna\', \'text\': \'{T}, Sacrifica due creature: Rimetti sul campo di battaglia una carta creatura bersaglio dal tuo cimitero.\', \'type\': \'Creatura Leggendaria — Chierico Umano\', \'flavor\': \'"Guarda come implorano il coltello! Il Signore dei Demoni li ha addestrati bene."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444075&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c5323d73-5d4b-44d3-86ac-980569faf381\', \'multiverseId\': 444075}, \'multiverseid\': 444075}, {\'name\': \'血の儀式司、ウィスパー\', \'text\': \'{T}, クリーチャー２体を生け贄に捧げる：あなたの墓地からクリーチャー・カード１枚を対象とし、それを戦場に戻す。\', \'type\': \'伝説のクリーチャー — 人間・クレリック\', \'flavor\': \'「この者どもがナイフをせがむ様を見よ。悪魔王様もよく躾けたものよ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444344&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9444a038-cc47-4bce-8880-f10d610cd088\', \'multiverseId\': 444344}, \'multiverseid\': 444344}, {\'name\': \'피의 예배학자, 위스퍼\', \'text\': \'{T}, 생물 두 개를 희생한다: 당신의 무덤에 있는 생물 카드를 목표로 정한다. 그 카드를 전장으로 되돌린다.\', \'type\': \'전설적 생물 — 인간 성직자\', \'flavor\': \'"칼을 달라고 애걸하는 저 모습을 봐라! 악마군주가 훈련을 아주 잘 시켰군."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444613&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f2ca9254-5038-45bf-8928-046d1e70a6e5\', \'multiverseId\': 444613}, \'multiverseid\': 444613}, {\'name\': \'Sussurro, Liturgista do Sangue\', \'text\': \'{T}, sacrifique duas criaturas: Devolva o card de criatura alvo de seu cemitério para o campo de batalha.\', \'type\': \'Criatura Lendária — Humano Clérigo\', \'flavor\': \'"Veja como eles imploram pela faca. O Senhor Demônio os treinou bem."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444882&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ca3b456e-ff53-49fd-b0aa-3481a3ceda2f\', \'multiverseId\': 444882}, \'multiverseid\': 444882}, {\'name\': \'Шепот, Литургист Крови\', \'text\': \'{T}, пожертвуйте два существа: верните целевую карту существа из вашего кладбища на поле битвы.\', \'type\': \'Легендарное Существо — Человек Священник\', \'flavor\': \'«Посмотри, как они тянутся к кинжалу! Демон-Владыка хорошо их выдрессировал».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445151&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'811e27ba-d44d-4088-85a1-2a069f956c2e\', \'multiverseId\': 445151}, \'multiverseid\': 445151}, {\'name\': \'鲜血仪礼师魏飒璞\', \'text\': \'{T}，牺牲两个生物：将目标生物牌从你的坟墓场移回战场。\', \'type\': \'传奇生物 ～人类／僧侣\', \'flavor\': \'「瞧瞧他们恳求挨刀的样子！恶魔领主把他们训练得很好。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445420&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'599f4dee-f87f-45d2-a95e-bbb305cb49d7\', \'multiverseId\': 445420}, \'multiverseid\': 445420}, {\'name\': \'鮮血儀禮師魏颯璞\', \'text\': \'{T}，犧牲兩個生物：將目標生物牌從你的墳墓場移回戰場。\', \'type\': \'傳奇生物 ～人類／僧侶\', \'flavor\': \'「瞧瞧他們懇求挨刀的樣子！惡魔領主把他們訓練得很好。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445689&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3f984fc7-4836-4625-91d7-6579a3521ad0\', \'multiverseId\': 445689}, \'multiverseid\': 445689}]', '[{\'name\': \'Wolkenleser-Sphinx\', \'text\': \'Fliegend\\nWenn die Wolkenleser-Sphinx ins Spiel kommt, wende Hellsicht 2 an. (Schaue dir die obersten zwei Karten deiner Bibliothek an. Du kannst eine beliebige Anzahl davon unter deine Bibliothek legen und den Rest in beliebiger Reihenfolge oben darauf.)\', \'type\': \'Kreatur — Sphinx\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443204&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cb5fea2e-b9fe-457e-b050-c727d8d483a0\', \'multiverseId\': 443204}, \'multiverseid\': 443204}, {\'name\': \'Esfinge descifranubes\', \'text\': \'Vuela.\\nCuando la Esfinge descifranubes entre al campo de batalla, adivina 2. (Mira las dos primeras cartas de tu biblioteca, luego pon cualquier cantidad de ellas en el fondo de tu biblioteca y el resto en la parte superior en cualquier orden.)\', \'type\': \'Criatura — Esfinge\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443473&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a4682895-107e-498b-89a9-aef913d4055b\', \'multiverseId\': 443473}, \'multiverseid\': 443473}, {\'name\': \'Sphinx déchiffre-nuage\', \'text\': "Vol\\nQuand le Sphinx déchiffre-nuage arrive sur le champ de bataille, regard 2. (Regardez les deux cartes du dessus de votre bibliothèque. Mettez n\'importe quel nombre d\'entre elles au-dessous de votre bibliothèque et le reste, au-dessus, dans n\'importe quel ordre.)", \'type\': \'Créature : sphinx\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443742&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'92582222-4a18-4e5d-9545-804895afbdb8\', \'multiverseId\': 443742}, \'multiverseid\': 443742}, {\'name\': \'Sfinge Nembomante\', \'text\': \'Volare\\nQuando la Sfinge Nembomante entra nel campo di battaglia, profetizza 2. (Guarda le prime due carte del tuo grimorio, poi mettine un qualsiasi numero in fondo al tuo grimorio e le altre in cima in qualsiasi ordine.)\', \'type\': \'Creatura — Sfinge\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444011&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'247dcc5f-aaf6-4857-b96b-e9594386d1eb\', \'multiverseId\': 444011}, \'multiverseid\': 444011}, {\'name\': \'雲読みスフィンクス\', \'text\': \'飛行\\n雲読みスフィンクスが戦場に出たとき、占術２を行う。（あなたのライブラリーの一番上からカードを２枚見て、そのうちの望む枚数を望む順番であなたのライブラリーの一番下に、残りを望む順番で一番上に置く。）\', \'type\': \'クリーチャー — スフィンクス\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444280&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'51f59d23-faf4-4740-ba84-723ae11ff1a3\', \'multiverseId\': 444280}, \'multiverseid\': 444280}, {\'name\': \'구름해독가 스핑크스\', \'text\': \'비행\\n구름해독가 스핑크스가 전장에 들어올 때, 점술 2를 한다. (당신의 서고 맨 위 카드 두 장을 본다. 당신은 그 카드들 중 원하는 만큼을 당신의 서고 맨 밑에 놓고 나머지를 당신의 서고 맨 위에 원하는 순서대로 놓을 수 있다.)\', \'type\': \'생물 — 스핑크스\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444549&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'58f5e8eb-8089-4ccd-bb2d-7f85ef75adac\', \'multiverseId\': 444549}, \'multiverseid\': 444549}, {\'name\': \'Esfinge Leitora de Nuvens\', \'text\': \'Voar\\nQuando Esfinge Leitora de Nuvens entrar no campo de batalha, use vidência 2. (Olhe os dois cards do topo do seu grimório. Depois, coloque qualquer número deles no fundo do seu grimório e o resto no topo em qualquer ordem.)\', \'type\': \'Criatura — Esfinge\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444818&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'507712f9-4991-47d9-9ea3-a05b8e944829\', \'multiverseId\': 444818}, \'multiverseid\': 444818}, {\'name\': \'Сфинкс, Чтец Облаков\', \'text\': \'Полет\\nКогда Сфинкс, Чтец Облаков выходит на поле битвы, предскажите 2. (Посмотрите две верхние карты вашей библиотеки, затем положите любое количество из них в низ вашей библиотеки, а остальные на верх вашей библиотеки в любом порядке.)\', \'type\': \'Существо — Сфинкс\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445087&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2160941b-8516-44af-9c4e-22461b5b4371\', \'multiverseId\': 445087}, \'multiverseid\': 445087}, {\'name\': \'识云史芬斯\', \'text\': \'飞行\\n当识云史芬斯进战场时，占卜2。（检视你牌库顶的两张牌，然后将其中任意数量的牌以任意顺序置于你牌库底，其余则以任意顺序置于你牌库顶。）\', \'type\': \'生物 ～史芬斯\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445356&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'391986b9-887d-4cbe-ac1b-268cd22dd2dd\', \'multiverseId\': 445356}, \'multiverseid\': 445356}, {\'name\': \'識雲史芬斯\', \'text\': \'飛行\\n當識雲史芬斯進戰場時，占卜2。（檢視你牌庫頂的兩張牌，然後將其中任意數量的牌以任意順序置於你牌庫底，其餘則以任意順序置於你牌庫頂。）\', \'type\': \'生物 ～史芬斯\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445625&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'532ffecd-4047-4feb-b8a5-55bc1c471e24\', \'multiverseId\': 445625}, \'multiverseid\': 445625}]', '[{\'name\': \'Wächter von Koilos\', \'text\': \'Wenn die Wächter von Koilos ins Spiel kommen, kannst du eine andere historische bleibende Karte deiner Wahl, die du kontrollierst, auf die Hand ihres Besitzers zurückbringen. (Legenden, Artefakte und Sagen sind historisch.)\', \'type\': \'Artefaktkreatur — Konstrukt\', \'flavor\': \'Archäologen lassen die Ausgrabungsstätten in Koilos von Automaten bewachen, deren Funktionsweise und Optik von früheren Funden inspiriert ist.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443373&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'27090093-53fd-490b-af02-2e36934d641a\', \'multiverseId\': 443373}, \'multiverseid\': 443373}, {\'name\': \'Guardianes de Koilos\', \'text\': \'Cuando los Guardianes de Koilos entren al campo de batalla, puedes regresar otro permanente histórico objetivo que controlas a la mano de su propietario. (Los artefactos, las Sagas y las cartas legendarias son cartas históricas.)\', \'type\': \'Criatura artefacto — Constructo\', \'flavor\': \'Los arqueólogos dependen de los autómatas, inspirados en sus descubrimientos anteriores en Koilos, para proteger las excavaciones.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443642&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d0db3d7e-c952-4c63-8e45-c063a1490f4c\', \'multiverseId\': 443642}, \'multiverseid\': 443642}, {\'name\': \'Vigiles de Koïlos\', \'text\': \'Quand les Vigiles de Koïlos arrivent sur le champ de bataille, vous pouvez renvoyer un autre permanent historique ciblé que vous contrôlez dans la main de son propriétaire. (Les artefacts, les légendaires et les sagas sont historiques.)\', \'type\': \'Créature-artefact : construction\', \'flavor\': "Les archéologues dépendent d\'automates inspirés de leurs précédentes découvertes à Koïlos pour garder le site de fouilles.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443911&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2bcff9a5-fe01-4197-b310-0568ab6925df\', \'multiverseId\': 443911}, \'multiverseid\': 443911}, {\'name\': \'Guardiani di Koilos\', \'text\': \'Quando i Guardiani di Koilos entrano nel campo di battaglia, puoi far tornare un altro permanente storico bersaglio che controlli in mano al suo proprietario. (Artefatti, carte leggendarie e Saghe sono carte storiche.)\', \'type\': \'Creatura Artefatto — Costrutto\', \'flavor\': \'Gli archeologi affidano la protezione degli scavi ad automi ispirati dalle loro precedenti scoperte a Koilos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444180&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'03d6c6b4-2677-494f-b78c-152295d877f5\', \'multiverseId\': 444180}, \'multiverseid\': 444180}, {\'name\': \'コイロスの守護者\', \'text\': \'コイロスの守護者が戦場に出たとき、あなたがコントロールしている他の歴史的なパーマネント１つを対象とする。あなたはそれをオーナーの手札に戻してもよい。（歴史的とは、アーティファクトと伝説と英雄譚のことである。）\', \'type\': \'アーティファクト・クリーチャー — 構築物\', \'flavor\': \'考古学者たちは発掘現場の護衛として、コイロスにおける発見を利用した自動機械を使っている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444449&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3e8a2253-137a-444d-abc2-bbf890960cfd\', \'multiverseId\': 444449}, \'multiverseid\': 444449}, {\'name\': \'코일로스의 수호자들\', \'text\': \'코일로스의 수호자들이 전장에 들어올 때, 당신이 조종하는 다른 역사적 지속물을 목표로 정한다. 당신은 그 지속물을 소유자의 손으로 되돌릴 수 있다. (마법물체와 전설적, 서사시가 역사적이다.)\', \'type\': \'마법물체 생물 — 자동기계\', \'flavor\': \'고고학자들은 코일로스에서 발견했던 물건들에서 영감을 받아 만든 자동장치들로 발굴지를 보호한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444718&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5b74f0e7-350a-4030-a586-917cf11303ce\', \'multiverseId\': 444718}, \'multiverseid\': 444718}, {\'name\': \'Guardiões de Koilos\', \'text\': \'Quando Guardiões de Koilos entra no campo de batalha, você pode devolver outra permanente histórica alvo que você controla para a mão de seu dono. (Os artefatos, os cards lendários e as Sagas são cards históricos.)\', \'type\': \'Criatura Artefato — Constructo\', \'flavor\': \'Os arqueólogos dependem de autômatos inspirados em suas prévias descobertas em Koilos para proteger as escavações.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444987&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7b4b95b0-2ff5-486c-ae4b-18d5697ed197\', \'multiverseId\': 444987}, \'multiverseid\': 444987}, {\'name\': \'Стражники Койлоса\', \'text\': \'Когда Стражники Койлоса выходят на поле битвы, вы можете вернуть другой целевой исторический перманент под вашим контролем в руку его владельца. (Артефакты, легендарные карты и Саги являются историческими.)\', \'type\': \'Артефакт Существо — Конструкция\', \'flavor\': \'Для охраны раскопок археологи используют автоматы, прообразом которых стали предыдущие находки в Койлосе.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445256&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ac9a9678-4498-4b01-ae75-77022f495c8b\', \'multiverseId\': 445256}, \'multiverseid\': 445256}, {\'name\': \'喀洛斯守护者\', \'text\': \'当喀洛斯守护者进战场时，你可以将另一个目标由你操控的史迹永久物移回其拥有者手上。（神器、传奇和传纪是史迹。）\', \'type\': \'神器生物 ～组构体\', \'flavor\': \'考古学家先前在喀洛斯的发现激发了他们的灵感，往后便都依靠由此造出的自动机械来保卫发掘现场。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445525&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b7837c5b-b5f8-44e2-8f4d-9199b81d8c46\', \'multiverseId\': 445525}, \'multiverseid\': 445525}, {\'name\': \'喀洛斯守護者\', \'text\': \'當喀洛斯守護者進戰場時，你可以將另一個目標由你操控的史跡永久物移回其擁有者手上。（神器、傳奇和傳紀是史跡。）\', \'type\': \'神器生物 ～組構體\', \'flavor\': \'考古學家先前在喀洛斯的發現激發了他們的靈感，往後便都依靠由此造出的自動機械來保衛發掘現場。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445794&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c4d03970-8c1e-49a9-86cf-898bae191821\', \'multiverseId\': 445794}, \'multiverseid\': 445794}]', '[{\'name\': \'Yargle, Gierschlund von Urborg\', \'type\': \'Legendäre Kreatur — Frosch, Geist\', \'flavor\': \'Als Belzenloks Leutnant Yar-Kul etwas zu ehrgeizig wurde, verwandelte ihn der Dämonenfürst in eine Made. Der Frosch, der diese Made fraß, wuchs und wuchs, bis ein unersättlicher Geist zu Tage trat.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443270&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cc5cdb42-0e51-4dd6-80a9-0b6b36b29dbc\', \'multiverseId\': 443270}, \'multiverseid\': 443270}, {\'name\': \'Yargle, insaciable de Urborg\', \'type\': \'Criatura legendaria — Espíritu rana\', \'flavor\': \'Cuando el teniente de Belzenlok, Yar-Kul, se volvió demasiado ambicioso, el señor demonio lo transformó en una larva. La rana que se comió la larva creció y creció hasta que reventó y un espíritu voraz emergió de su cuerpo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443539&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'95660b3a-c0ab-4a7b-83be-fb0da78a120c\', \'multiverseId\': 443539}, \'multiverseid\': 443539}, {\'name\': "Yargle, glouton d\'Urborg", \'type\': \'Créature légendaire : grenouille et esprit\', \'flavor\': "Quand Yar-Kul, le lieutenant de Belzenlok, se montra trop ambitieux, le Seigneur démon le transforma en larve. Celle-ci fut mangée par une grenouille, qui grossit encore et encore, jusqu\'à ce qu\'un esprit vorace ne fasse éclater son corps.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443808&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5acfda7d-d6f2-49c2-8934-7fa655b9bf6d\', \'multiverseId\': 443808}, \'multiverseid\': 443808}, {\'name\': \'Yargle, Ingordo di Urborg\', \'type\': \'Creatura Leggendaria — Spirito Rana\', \'flavor\': \'Quando Yar-Kul, tenente di Belzenlok, divenne troppo ambizioso, il Signore dei Demoni lo trasformò in una larva. La rana che la inghiottì crebbe a dismisura, finché dal suo corpo esplose uno spirito famelico.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444077&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'081a69d6-5057-446b-88ed-483dd712971e\', \'multiverseId\': 444077}, \'multiverseid\': 444077}, {\'name\': \'アーボーグの暴食、ヤーグル\', \'type\': \'伝説のクリーチャー — カエル・スピリット\', \'flavor\': \'ベルゼンロックの副官ヤー＝クールが大き過ぎる野心を抱くようになったので、悪魔王は彼を蛆に変えた。その蛆を食べた蛙はどんどん大きくなり続け、ついに体が爆発して貪欲な魂が抜け出すまで止まらなかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444346&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c4bc52fe-d94d-4ebb-969e-deeef303fe83\', \'multiverseId\': 444346}, \'multiverseid\': 444346}, {\'name\': \'우르보그의 대식가, 야르글\', \'type\': \'전설적 생물 — 개구리 신령\', \'flavor\': \'벨젠로크의 부관 야르-쿨의 야심이 지나치게 커지자, 악마군주는 그를 구더기로 만들어버렸다. 그 구더기를 먹은 개구리는 계속 성장했고, 나중에는 게걸스러운 영혼이 그 몸에서 튀어나왔다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444615&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2f91c483-1ead-4f35-b341-0495ca9f7a9d\', \'multiverseId\': 444615}, \'multiverseid\': 444615}, {\'name\': \'Yargle, Glutão de Urborg\', \'type\': \'Criatura Lendária — Sapo Espírito\', \'flavor\': \'Quando o tenente de Belzenlok, Yar-Kul, tornou-se ambicioso demais, o Senhor Demônio o transformou em uma larva. O sapo que comeu aquela larva cresceu e cresceu, até um espírito voraz irromper de seu corpo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444884&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b084c426-1051-4568-a0dd-d92b996b3050\', \'multiverseId\': 444884}, \'multiverseid\': 444884}, {\'name\': \'Яргуль, Обжора Урборга\', \'type\': \'Легендарное Существо — Лягушка Дух\', \'flavor\': \'Когда подручный Бельзенлока по имени Яр-Кул стал слишком честолюбивым, Демон-Владыка превратил его в червяка. Червяка съела лягушка и стала расти — расти до тех пор, пока из ее туши не вырвался прожорливый дух.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445153&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'06c97412-2c8e-4520-a588-191f51074c7b\', \'multiverseId\': 445153}, \'multiverseid\': 445153}, {\'name\': \'乌尔博格吞蛙雅骨尔\', \'type\': \'传奇生物 ～蛙／精怪\', \'flavor\': \'贝赞洛的副手雅库开始展露野心，恶魔领主便把他变成一条蛆虫。有只青蛙吞下了这条蛆虫后不断变大，最终贪食的精怪从其体内破膛而出。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445422&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ea2b7462-01ec-40d2-ab68-72b4bfb698fc\', \'multiverseId\': 445422}, \'multiverseid\': 445422}, {\'name\': \'烏爾博格吞蛙雅骨爾\', \'type\': \'傳奇生物 ～蛙／精靈\', \'flavor\': \'貝贊洛的副手雅庫開始展露野心，惡魔領主便把他變成一條蛆蟲。有隻青蛙吞下了這條蛆蟲後不斷變大，最終貪食的精靈從其體內破膛而出。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445691&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'521407fb-936d-440b-bac2-188ab89676af\', \'multiverseId\': 445691}, \'multiverseid\': 445691}]', '[{\'name\': \'Yavimaya-Sporenhirte\', \'text\': \'Wenn der Yavimaya-Sporenhirte ins Spiel kommt, erzeuge einen 1/1 grünen Saproling-Kreaturenspielstein.\', \'type\': \'Kreatur — Pilzwesen\', \'flavor\': \'„Sobald sich zu viele Thallide auf einem Haufen befinden, vollführen sie einen Hüpftanz und schwärmen dann in alle Richtungen aus." —Sarpadische Reiche, Band III\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443346&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c672b2e9-7a60-422b-80bc-d71ca814948d\', \'multiverseId\': 443346}, \'multiverseid\': 443346}, {\'name\': \'Sapropastor de Yavimaya\', \'text\': \'Cuando el Sapropastor de Yavimaya entre al campo de batalla, crea una ficha de criatura Saprolín verde 1/1.\', \'type\': \'Criatura — Hongo\', \'flavor\': \'"Cuando su comunidad se les queda pequeña, los tálidos ejecutan una especie de danza tradicional en la que dan saltos y después emigran en todas las direcciones". Imperios sarpadianos, Vol. III\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443615&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3494342b-30ee-43b7-89d1-98e8d5989b02\', \'multiverseId\': 443615}, \'multiverseid\': 443615}, {\'name\': \'Saproberger de la Yavimaya\', \'text\': \'Quand le Saproberger de la Yavimaya arrive sur le champ de bataille, créez un jeton de créature 1/1 verte Saprobionte.\', \'type\': \'Créature : fongus\', \'flavor\': \'« Quand leur communauté est saturée, les thallidés entament une danse traditionnelle, puis se dispersent dans toutes les directions. » —Les Empires sarpadiens, Vol. III\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443884&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4ee31b67-d700-4c18-9c0c-cdbed77a9274\', \'multiverseId\': 443884}, \'multiverseid\': 443884}, {\'name\': \'Fitopastore di Yavimaya\', \'text\': \'Quando il Fitopastore di Yavimaya entra nel campo di battaglia, crea una pedina creatura Saprolingio 1/1 verde.\', \'type\': \'Creatura — Fungus\', \'flavor\': \'"Quando la loro comunità si fa troppo affollata, i thallid iniziano una tradizionale danza ritmata, poi si disperdono in tutte le direzioni." —Imperi di Sarpadia, Vol. III\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444153&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ceb2818b-cf7f-46da-80fc-5ae98864768e\', \'multiverseId\': 444153}, \'multiverseid\': 444153}, {\'name\': \'ヤヴィマヤの苗飼い\', \'text\': \'ヤヴィマヤの苗飼いが戦場に出たとき、緑の１/１の苗木・クリーチャー・トークンを１体生成する。\', \'type\': \'クリーチャー — ファンガス\', \'flavor\': \'「サリッドの群落が大きく雑然となってくると、彼らは伝統的なダンスを踊り始めると四方八方に旅立っていく。」 ――サーペイディア諸帝国史、第三巻\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444422&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e1c3694a-23fb-45ec-a981-0ec9b3ddcbe5\', \'multiverseId\': 444422}, \'multiverseid\': 444422}, {\'name\': \'야비마야 묘목몰이\', \'text\': \'야비마야 묘목몰이가 전장에 들어올 때, 1/1 녹색 묘목 생물 토큰 한 개를 만든다.\', \'type\': \'생물 — 진균\', \'flavor\': \'"그들의 공동체가 어수선하게 변할 때, 탈리드는 전통적인 춤을 춘 다음, 모든 방향으로 흩어진다." —사르파디아 제국사, vol. III\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444691&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'fc3fbb9a-40d9-4c03-9b4a-8f31eb8137da\', \'multiverseId\': 444691}, \'multiverseid\': 444691}, {\'name\': \'Saprastor de Yavimaya\', \'text\': \'Quando Saprastor de Yavimaya entrar no campo de batalha, crie uma ficha de criatura verde 1/1 do tipo Saprófita.\', \'type\': \'Criatura — Fungo\', \'flavor\': \'"Quando a comunidade fica congestionada, as talídias começam uma dança tradicional sacolejante e se dispersam em todas as direções." — Impérios Sarpadianos, Vol. III\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444960&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1048d6a6-19d7-43c9-965d-b40d7aecc3c9\', \'multiverseId\': 444960}, \'multiverseid\': 444960}, {\'name\': \'Явимайский Грибопас\', \'text\': \'Когда Явимайский Грибопас выходит на поле битвы, создайте одну фишку существа 1/1 зеленый Сапролинг.\', \'type\': \'Существо — Плесень\', \'flavor\': \'«Когда в сообществе таллидов становится слишком тесно, они начинают традиционный качающийся танец, а потом расходятся в разных направлениях». — «Сарпадианские Империи, том III»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445229&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a9ff9a31-0021-4724-9427-394fb84a94c6\', \'multiverseId\': 445229}, \'multiverseid\': 445229}, {\'name\': \'亚维马雅牧腐菌\', \'text\': \'当亚维马雅牧腐菌进战场时，派出一个1/1绿色腐生物衍生生物。\', \'type\': \'生物 ～真菌\', \'flavor\': \'「一旦其群落变得拥挤，散绿菌便会依传统摇摆起舞，随后就四散远行。」 ～《撒尔帕汀帝国》，卷三\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445498&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b9ce0a2c-ef86-4907-b2e5-13050b8944e8\', \'multiverseId\': 445498}, \'multiverseid\': 445498}, {\'name\': \'亞維馬雅牧腐菌\', \'text\': \'當亞維馬雅牧腐菌進戰場時，派出一個1/1綠色腐生物衍生生物。\', \'type\': \'生物 ～真菌\', \'flavor\': \'「一旦其群落變得擁擠，散綠菌便會依傳統搖擺起舞，隨後就四散遠行。」 ～《撒爾帕汀帝國》，卷三\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445767&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'14b9bf3c-452d-4935-9145-0804ac2cf209\', \'multiverseId\': 445767}, \'multiverseid\': 445767}]', '[{\'name\': \'Yawgmoths abscheuliches Angebot\', \'text\': \'(Legendäre Hexereien kannst du nur wirken, falls du eine legendäre Kreatur oder einen legendären Planeswalker kontrollierst.)\\nBringe bis zu eine Kreaturen- oder Planeswalkerkarte deiner Wahl aus einem Friedhof unter deiner Kontrolle ins Spiel. Zerstöre bis zu eine Kreatur oder einen Planeswalker deiner Wahl. Schicke Yawgmoths abscheuliches Angebot ins Exil.\', \'type\': \'Legendäre Hexerei\', \'flavor\': \'Vor vielen Jahrhunderten bot ein verrückter Gott einen simplen Handel an.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443271&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'688d4b86-a6cf-4d1a-aa06-877d3cd6bd5e\', \'multiverseId\': 443271}, \'multiverseid\': 443271}, {\'name\': \'Ofrenda vil de Yawgmoth\', \'text\': \'(Solo puedes lanzar un conjuro legendario si controlas una criatura o planeswalker legendario.)\\nPon en el campo de batalla bajo tu control hasta una carta de criatura o planeswalker objetivo de un cementerio. Destruye hasta una criatura o planeswalker objetivo. Exilia la Ofrenda vil de Yawgmoth.\', \'type\': \'Conjuro legendario\', \'flavor\': \'Hace siglos, un dios loco ofreció un intercambio sencillo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443540&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f8685d30-c194-4f79-afd3-7a0afca46104\', \'multiverseId\': 443540}, \'multiverseid\': 443540}, {\'name\': \'Offrande abjecte de Yaugzebul\', \'text\': "(Vous ne pouvez lancer un rituel légendaire que si vous contrôlez une créature ou un planeswalker légendaire.)\\nMettez sur le champ de bataille, sous votre contrôle, jusqu\'à une carte de créature ou de planeswalker ciblée depuis un cimetière. Détruisez jusqu\'à une créature ciblée ou un planeswalker ciblé. Exilez l\'Offrande abjecte de Yaugzebul.", \'type\': \'Rituel légendaire\', \'flavor\': \'Il y a des siècles, un dieu fou offrit un simple échange.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443809&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'151c184b-a4a8-4dc7-9557-5353804f493e\', \'multiverseId\': 443809}, \'multiverseid\': 443809}, {\'name\': \'Offerta Ignobile di Yawgmoth\', \'text\': "(Puoi lanciare una stregoneria leggendaria solo se controlli una creatura o un planeswalker leggendari.)\\nMetti sul campo di battaglia sotto il tuo controllo fino a una carta creatura o planeswalker bersaglio da un cimitero. Distruggi fino a una creatura o a un planeswalker bersaglio. Esilia l\'Offerta Ignobile di Yawgmoth.", \'type\': \'Stregoneria Leggendaria\', \'flavor\': \'Secoli fa, un dio folle offrì un semplice scambio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444078&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f85148dd-0d64-4b24-802f-1593f4e0544c\', \'multiverseId\': 444078}, \'multiverseid\': 444078}, {\'name\': \'ヨーグモスの不義提案\', \'text\': \'（伝説のソーサリーは、あなたが伝説のクリーチャーか伝説のプレインズウォーカーをコントロールしているときにのみ唱えられる。）\\n墓地からクリーチャーかプレインズウォーカーであるカード最大１枚と、クリーチャーやプレインズウォーカー合わせて最大１体を対象とする。その前者をあなたのコントロール下で戦場に出す。その後者を破壊する。ヨーグモスの不義提案を追放する。\', \'type\': \'伝説のソーサリー\', \'flavor\': \'数世紀前、狂える神が単純な取引を提案した。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444347&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5b86628d-4502-4068-a1f3-c1be989add39\', \'multiverseId\': 444347}, \'multiverseid\': 444347}, {\'name\': \'야그모스의 비열한 제물\', \'text\': \'(당신이 전설적 생물이나 플레인즈워커를 조종할 때만 전설적 집중마법을 발동할 수 있다.)\\n무덤에 있는 생물 또는 플레인즈워커 카드를 최대 한 장까지 목표로 정한다. 그 카드를 당신의 조종하에 전장에 놓는다. 생물 또는 플레인즈워커를 최대 한 개까지 목표로 정한다. 그 목표를 파괴한다. 야그모스의 비열한 제물을 추방한다.\', \'type\': \'전설적 집중마법\', \'flavor\': \'수 세기 전, 미치광이 신이 단순한 거래 하나를 제안했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444616&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2981eb36-608e-4e74-a1ba-ede48540544b\', \'multiverseId\': 444616}, \'multiverseid\': 444616}, {\'name\': \'Oferenda Vil de Yawgmoth\', \'text\': \'(Você só pode conjurar um feitiço lendário se controlar uma criatura lendária ou um planeswalker lendário.)\\nColoque até um card de criatura ou planeswalker alvo de um cemitério no campo de batalha sob o seu controle. Destrua até uma criatura ou planeswalker alvo. Exile Oferenda Vil de Yawgmoth.\', \'type\': \'Feitiço Lendário\', \'flavor\': \'Há muitos séculos, um deus insano ofereceu uma troca simples.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444885&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'84a107e2-ba4d-4759-ab11-78ad90afd9c9\', \'multiverseId\': 444885}, \'multiverseid\': 444885}, {\'name\': \'Жестокое Предложение Ягмота\', \'text\': \'(Вы можете разыгрывать легендарное волшебство, только если контролируете легендарное существо или planeswalker-а.)\\nПоложите не более одной целевой карты существа или planeswalker-а из кладбища на поле битвы под вашим контролем. Уничтожьте не более одного целевого существа или planeswalker-а. Изгоните Жестокое Предложение Ягмота.\', \'type\': \'Легендарное Волшебство\', \'flavor\': \'Много веков назад безумный бог предложил простой обмен.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445154&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d5432e25-b99c-4df5-a405-e242ae7cedb5\', \'multiverseId\': 445154}, \'multiverseid\': 445154}, {\'name\': \'约格莫夫的邪恶献祭\', \'text\': \'（只能于你操控传奇生物或鹏洛客时施放传奇法术。）\\n将至多一张目标生物或鹏洛客牌在你的操控下从坟墓场放进战场。消灭至多一个目标生物或鹏洛客。放逐约格莫夫的邪恶献祭。\', \'type\': \'传奇法术\', \'flavor\': \'数世纪前，一位入魔神明发起了一笔简单交易。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445423&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8ce66ecd-573d-4d8d-9255-b4b5245ef587\', \'multiverseId\': 445423}, \'multiverseid\': 445423}, {\'name\': \'約格莫夫的邪惡獻祭\', \'text\': \'（只能於你操控傳奇生物或鵬洛客時施放傳奇巫術。）\\n將至多一張目標生物或鵬洛客牌在你的操控下從墳墓場放進戰場。消滅至多一個目標生物或鵬洛客。放逐約格莫夫的邪惡獻祭。\', \'type\': \'傳奇巫術\', \'flavor\': \'數世紀前，一位入魔神明發起了一筆簡單交易。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445692&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'04cde397-21f7-418d-aae7-1b52dc37863d\', \'multiverseId\': 445692}, \'multiverseid\': 445692}]', '[{\'name\': \'Zahid, Dschinn aus der Lampe\', \'text\': \'Du kannst {3}{U} bezahlen und ein ungetapptes Artefakt, das du kontrollierst, tappen, anstatt die Manakosten dieses Zauberspruchs zu bezahlen.\\nFliegend\', \'type\': \'Legendäre Kreatur — Dschinn\', \'flavor\': \'„Ich tue, was immer ich will, kleiner Sterblicher. Aber erzähl mir ruhig weiter von deinen Wünschen, sie amüsieren mich sehr."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443233&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'21733bb5-ee29-4848-9002-c9dc71bc6e66\', \'multiverseId\': 443233}, \'multiverseid\': 443233}, {\'name\': \'Zahid, djinn de la lámpara\', \'text\': \'Puedes pagar {3}{U} y girar un artefacto enderezado que controlas en vez de pagar el coste de maná de este hechizo.\\nVuela.\', \'type\': \'Criatura legendaria — Djinn\', \'flavor\': \'"Yo hago lo que quiero, insignificante mortal. Pero no dejes de hablarme de tus deseos: me divierten una barbaridad".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443502&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6a2d8be8-03f3-4abf-94ea-7d43c523a03d\', \'multiverseId\': 443502}, \'multiverseid\': 443502}, {\'name\': \'Zahid, djinn de la lampe\', \'text\': \'Vous pouvez payer {3}{U} et engager un artefact dégagé que vous contrôlez à la place de payer le coût de mana de ce sort.\\nVol\', \'type\': \'Créature légendaire : djinn\', \'flavor\': "« J\'agis à ma guise, pauvre mortel. Mais continue avec tes souhaits, ils m\'amusent au plus haut point. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443771&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b77bf1c5-8b26-481b-b570-cc229b7e28c3\', \'multiverseId\': 443771}, \'multiverseid\': 443771}, {\'name\': \'Zahid, Genio della Lampada\', \'text\': \'Puoi pagare {3}{U} e TAPpare un artefatto STAPpato che controlli invece di pagare il costo di mana di questa magia.\\nVolare\', \'type\': \'Creatura Leggendaria — Genio\', \'flavor\': \'"Io faccio quello che mi pare, piccolo mortale. Ma continua pure con i tuoi desideri, li trovo immensamente divertenti."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444040&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'605677ca-9ac4-4f33-9ce3-f2c67e9bacce\', \'multiverseId\': 444040}, \'multiverseid\': 444040}, {\'name\': \'ランプのジン、ザヒード\', \'text\': \'あなたは、この呪文のマナ・コストを支払うのではなく、{3}{U}を支払うとともにあなたがコントロールしていてアンタップ状態のアーティファクト１つをタップしてもよい。\\n飛行\', \'type\': \'伝説のクリーチャー — ジン\', \'flavor\': \'「わしは好きにやるのだ、小さき者よ。だが、お前の願いの話を続けるがよい。わしはそれが楽しみなのだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444309&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bdb8e437-4702-475c-92ae-1eeb4e53ecf3\', \'multiverseId\': 444309}, \'multiverseid\': 444309}, {\'name\': \'램프의 지니, 자히드\', \'text\': \'당신은 이 주문의 마나 비용을 지불하는 대신 {3}{U}를 지불하고 당신이 조종하는 언탭된 마법물체를 탭할 수 있다.\\n비행\', \'type\': \'전설적 생물 — 지니\', \'flavor\': \'"나는 내가 하고 싶은 것을 한다, 필멸자여. 그래도 네 소원을 한 번 말해 보아라—그것들을 듣는 것은 한없이 즐거운 일이니."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444578&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'995c35e1-3aea-499d-8f59-444cdf5ad9c5\', \'multiverseId\': 444578}, \'multiverseid\': 444578}, {\'name\': \'Zahid, Gênio da Lâmpada\', \'text\': \'Você pode pagar {3}{U} e virar um artefato desvirado sob seu controle em vez de pagar o custo de mana desta mágica.\\nVoar\', \'type\': \'Criatura Lendária — Gênio\', \'flavor\': \'"Eu faço o que quero, débil mortal. Mas prossiga, faça seus desejos, não imagina o quanto eles me divertem."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444847&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7f64200b-a7fb-4dde-8398-d7ef740f4dc3\', \'multiverseId\': 444847}, \'multiverseid\': 444847}, {\'name\': \'Захид, Джинн из Лампы\', \'text\': \'Вы можете заплатить {3}{U} и повернуть неповернутый артефакт под вашим контролем вместо оплаты мана-стоимости этого заклинания.\\nПолет\', \'type\': \'Легендарное Существо — Джинн\', \'flavor\': \'«Я поступаю так, как угодно мне, о смертный. Но давай, говори свои желания — они меня забавляют».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445116&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3bdf8a3a-b9af-408f-bcf0-735686a19b73\', \'multiverseId\': 445116}, \'multiverseid\': 445116}, {\'name\': \'灯里的巨灵札希德\', \'text\': \'你可以支付{3}{U}并横置一个由你操控且未横置的神器，而不支付此咒语的法术力费用。\\n飞行\', \'type\': \'传奇生物 ～巨灵\', \'flavor\': \'「我行事全随己愿，渺小的凡人。不过你的愿望但说无妨～这能让我开心一下。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445385&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'981bf93f-f508-42d0-be7a-f703912436bf\', \'multiverseId\': 445385}, \'multiverseid\': 445385}, {\'name\': \'燈裡的巨靈札希德\', \'text\': \'你可以支付{3}{U}並橫置一個由你操控且未橫置的神器，而不支付此咒語的魔法力費用。\\n飛行\', \'type\': \'傳奇生物 ～巨靈\', \'flavor\': \'「我行事全隨己願，渺小的凡人。不過你的願望但說無妨～這能讓我開心一下。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445654&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8e27ea84-33b0-4ebc-a905-91069aa46eb5\', \'multiverseId\': 445654}, \'multiverseid\': 445654}]', '[{\'name\': \'Zeitalter des Eises\', \'text\': \'(Je eine Sagenmarke beim Ins-Spiel-Kommen und nach deinem Ziehsegment. Opfern nach III.)\\nI, II — Tappe eine Kreatur deiner Wahl, die ein Gegner kontrolliert. Sie enttappt nicht während des Enttappsegments ihres Beherrschers, solange du das Zeitalter des Eises kontrollierst.\\nIII — Bringe alle getappten Kreaturen auf die Hand ihrer Besitzer zurück.\', \'type\': \'Verzauberung — Sage\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443227&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'38ef0e98-a444-4eee-91f5-173c3a99cb6d\', \'multiverseId\': 443227}, \'multiverseid\': 443227}, {\'name\': \'Tiempos Gélidos\', \'text\': \'(En cuanto esta Saga entre y después de tu paso de robar, agrega un contador de sabiduría. Sacrifícala después de III.)\\nI, II — Gira la criatura objetivo que controla un oponente. No se endereza durante el paso de enderezar de su controlador mientras controles los Tiempos Gélidos.\\nIII — Regresa todas las criaturas giradas a las manos de sus propietarios.\', \'type\': \'Encantamiento — Saga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443496&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'34724498-9cb4-45aa-9cab-009b26f7fdf6\', \'multiverseId\': 443496}, \'multiverseid\': 443496}, {\'name\': \'Temps des glaces\', \'text\': "(Au moment où cette saga arrive sur le champ de bataille et après votre étape de pioche, ajoutez un marqueur « sapience ». Sacrifiez après III.)\\nI, II — Engagez une créature ciblée qu\'un adversaire contrôle. Elle ne se dégage pas pendant l\'étape de dégagement de son contrôleur tant que vous contrôlez le Temps des glaces.\\nIII — Renvoyez toutes les créatures engagées dans les mains de leurs propriétaires.", \'type\': \'Enchantement : saga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443765&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ceb397f9-ee2d-4704-bea1-a3a9ab421d64\', \'multiverseId\': 443765}, \'multiverseid\': 443765}, {\'name\': \'Il Tempo dei Ghiacci\', \'text\': \'(Mentre questa Saga entra e dopo la tua sottofase di acquisizione, aggiungi un segnalino sapere. Sacrifica dopo III.)\\nI, II — TAPpa una creatura bersaglio controllata da un avversario. Non STAPpa durante lo STAP del suo controllore fintanto che controlli Il Tempo dei Ghiacci.\\nIII — Fai tornare tutte le creature TAPpate in mano ai rispettivi proprietari.\', \'type\': \'Incantesimo — Saga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444034&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f6d1b33d-a3d7-4e53-87ff-778ac912cf82\', \'multiverseId\': 444034}, \'multiverseid\': 444034}, {\'name\': \'氷河期\', \'text\': \'（この英雄譚が出た際とあなたのドロー・ステップの後に、伝承カウンターを１個加える。IIIの後に、生け贄に捧げる。）\\nI, II ― 対戦相手がコントロールしているクリーチャー１体を対象とし、それをタップする。あなたが氷河期をコントロールし続けているかぎり、そのクリーチャーはそれのコントローラーのアンタップ・ステップにアンタップしない。\\nIII ― タップ状態のクリーチャーをすべてオーナーの手札に戻す。\', \'type\': \'エンチャント — 英雄譚\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444303&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'13ab282a-d407-4a4a-afdd-7371eafa6c13\', \'multiverseId\': 444303}, \'multiverseid\': 444303}, {\'name\': \'얼음의 시대\', \'text\': \'(이 서사시가 들어오면서 그리고 당신의 뽑기단 후에, 전승 카운터 한 개를 추가한다. III 이후에 희생한다.)\\nI, II — 상대가 조종하는 생물을 목표로 정한다. 그 생물을 탭한다. 당신이 얼음의 시대를 조종하는 한 그 생물은 조종자의 언탭단에 언탭되지 않는다.\\nIII — 모든 탭된 생물을 소유자의 손으로 되돌린다.\', \'type\': \'부여마법 — 서사시\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444572&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d02ca03d-7108-4c30-9f54-ec7a237669b0\', \'multiverseId\': 444572}, \'multiverseid\': 444572}, {\'name\': \'Tempo de Gelo\', \'text\': \'(Conforme esta Saga entra e após sua etapa de compra, adicione um marcador de conhecimento. Sacrifique-a após III.)\\nI, II — Vire a criatura alvo que um oponente controla. Ela não será desvirada durante a etapa de desvirar de seu controlador enquanto você controlar Tempo de Gelo.\\nIII — Devolva todas as criaturas viradas para a mão de seus donos.\', \'type\': \'Encantamento — Saga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444841&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'19e91bd9-452d-4345-96c4-a77ffd7cdd31\', \'multiverseId\': 444841}, \'multiverseid\': 444841}, {\'name\': \'Эпоха Льда\', \'text\': \'(При выходе этой Саги и после вашего шага взятия карты добавьте один жетон знаний. Пожертвуйте после III.)\\nI, II — Поверните целевое существо под контролем оппонента. Оно не разворачивается во время шага разворота контролирующего его игрока, пока вы контролируете Эпоху Льда.\\nIII — Верните все повернутые существа в руки их владельцев.\', \'type\': \'Чары — Сага\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445110&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'565cfca1-1fd4-43fc-87c1-89d3314dc061\', \'multiverseId\': 445110}, \'multiverseid\': 445110}, {\'name\': \'冰雪时代纪\', \'text\': \'（于此传纪进战场时及于你抓牌步骤后，加一个学问指示物。到III后牺牲之。）\\nI, II — 横置目标由对手操控的生物。于你操控冰雪时代纪的时段内，该生物于其操控者的重置步骤中不能重置。\\nIII — 将所有已横置的生物移回其拥有者手上。\', \'type\': \'结界 ～传纪\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445379&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a958bcc2-2d47-4ed2-8638-488ff9523468\', \'multiverseId\': 445379}, \'multiverseid\': 445379}, {\'name\': \'冰雪時代紀\', \'text\': \'（於此傳紀進戰場時及於你抽牌步驟後，加一個學問指示物。到III後犧牲之。）\\nI, II — 橫置目標由對手操控的生物。於你操控冰雪時代紀的時段內，該生物於其操控者的重置步驟中不能重置。\\nIII — 將所有已橫置的生物移回其擁有者手上。\', \'type\': \'結界 ～傳紀\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445648&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7fdf1a1c-89b8-4002-831c-9b413624df64\', \'multiverseId\': 445648}, \'multiverseid\': 445648}]', '[{\'name\': \'Zhalfirinische Leere\', \'text\': \'Wenn die Zhalfirinische Leere ins Spiel kommt, wende Hellsicht 1 an. (Schaue dir die oberste Karte deiner Bibliothek an. Du kannst sie unter deine Bibliothek legen.)\\n{T}: Erzeuge {C}.\', \'type\': \'Land\', \'flavor\': \'„Der Wind flüstert ‚Komm nach Hause\\\', doch ich kann nicht." —Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443406&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d164c38e-8f43-4bc5-981a-b76ac1b81f85\', \'multiverseId\': 443406}, \'multiverseid\': 443406}, {\'name\': \'Vacío zhalfirino\', \'text\': \'Cuando el Vacío zhalfirino entre al campo de batalla, adivina 1. (Mira la primera carta de tu biblioteca. Puedes poner esa carta en el fondo de tu biblioteca.)\\n{T}: Agrega {C}.\', \'type\': \'Tierra\', \'flavor\': \'"El viento susurra: \\\'Vuelve a casa\\\'. Pero no puedo". —Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443675&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'662e912a-672e-452d-974a-7bfff71ee54b\', \'multiverseId\': 443675}, \'multiverseid\': 443675}, {\'name\': \'Vide zhalfirin\', \'text\': \'Quand le Vide zhalfirin arrive sur le champ de bataille, regard 1. (Regardez la carte du dessus de votre bibliothèque. Vous pouvez la mettre au-dessous de votre bibliothèque.)\\n{T} : Ajoutez {C}.\', \'type\': \'Terrain\', \'flavor\': \'« Le vent murmure "Rentre à la maison", mais je ne peux pas. » —Téfeiri\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443944&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'92a5fe92-c07f-48f6-a251-773242461e5c\', \'multiverseId\': 443944}, \'multiverseid\': 443944}, {\'name\': \'Vuoto di Zhalfir\', \'text\': \'Quando il Vuoto di Zhalfir entra nel campo di battaglia, profetizza 1. (Guarda la prima carta del tuo grimorio. Puoi mettere quella carta in fondo al tuo grimorio.)\\n{T}: Aggiungi {C}.\', \'type\': \'Terra\', \'flavor\': \'"Il vento sussurra \\\'Torna a casa\\\', ma non posso farlo." —Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444213&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f01433f7-a7e2-450b-ae4d-2f2a8a638c41\', \'multiverseId\': 444213}, \'multiverseid\': 444213}, {\'name\': \'ザルファーの虚空\', \'text\': \'ザルファーの虚空が戦場に出たとき、占術１を行う。（あなたのライブラリーの一番上のカードを見る。あなたはそのカードをあなたのライブラリーの一番下に置いてもよい。）\\n{T}：{C}を加える。\', \'type\': \'土地\', \'flavor\': \'「風は『故郷に帰ろう』とささやく。だが私には不可能だ。」 ――テフェリー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444482&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8d06aebc-4bc5-4bad-adac-4cad131af8a1\', \'multiverseId\': 444482}, \'multiverseid\': 444482}, {\'name\': \'잘피르의 공허\', \'text\': \'잘피르의 공허가 전장에 들어올 때, 점술 1을 한다. (당신의 서고 맨 위 카드 한 장을 본다. 당신은 그 카드를 당신의 서고 맨 밑에 놓을 수 있다.)\\n{T}: {C}를 추가한다.\', \'type\': \'대지\', \'flavor\': \'"바람은 \\\'집으로 오라\\\'고 속삭이지만, 나는 그리할 수 없다." —테페리\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444751&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d7c2c18f-ae1f-4121-984f-33ebded865fc\', \'multiverseId\': 444751}, \'multiverseid\': 444751}, {\'name\': \'Vazio Zhalfiriano\', \'text\': \'Quando Vazio Zhalfiriano entrar no campo de batalha, use vidência 1.\\n(Olhe o card do topo de seu grimório. Você pode colocar aquele card no fundo de seu grimório.)\\n{T}: Adicione {C}.\', \'type\': \'Terreno\', \'flavor\': \'"O vento sussurra: \\\'Volte para casa!\\\', mas não posso." — Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445020&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'18a04b6a-9f01-4559-bbb4-6fd5d6e56e30\', \'multiverseId\': 445020}, \'multiverseid\': 445020}, {\'name\': \'Жалфирская Пустота\', \'text\': \'Когда Жалфирская Пустота выходит на поле битвы, предскажите 1. (Посмотрите верхнюю карту вашей библиотеки. Вы можете положить ту карту в низ вашей библиотеки.)\\n{T}: добавьте {C}.\', \'type\': \'Земля\', \'flavor\': \'«"Возвращайся домой", — шепчет мне ветер, но я не могу». — Тефери\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445289&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5298b347-0ff9-4f7f-8d0c-752cb7d8c81f\', \'multiverseId\': 445289}, \'multiverseid\': 445289}, {\'name\': \'赛费尔虚境\', \'text\': \'当赛费尔虚境进战场时，占卜1。（检视你牌库顶的牌。你可以将该牌置于你的牌库底。）\\n{T}：加{C}。\', \'type\': \'地\', \'flavor\': \'「风低唤着『回来吧』，我却无家可回。」 ～泰菲力\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445558&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'35fa7cee-9e6c-4b5c-a59b-146bded704d7\', \'multiverseId\': 445558}, \'multiverseid\': 445558}, {\'name\': \'賽費爾虛境\', \'text\': \'當賽費爾虛境進戰場時，占卜1。（檢視你牌庫頂的牌。你可以將該牌置於你的牌庫底。）\\n{T}：加{C}。\', \'type\': \'地\', \'flavor\': \'「風低喚著『回來吧』，我卻無家可回。」 ～泰菲力\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445827&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d5f36bae-4082-4fa6-b67d-9013f3ed7e65\', \'multiverseId\': 445827}, \'multiverseid\': 445827}]', '[{\'name\': \'Zorn der Kriegsfürstin\', \'text\': \'Kreaturen, die du kontrollierst, erhalten Erstschlag bis zum Ende des Zuges.\\nZiehe eine Karte.\', \'type\': \'Hexerei\', \'flavor\': \'„Einst waren wir an eine winterliche Welt angepasst. Doch wir leben im Hier und Jetzt. Wir sind Keldonen!" —Oberste Kriegsfürstin Radha\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443308&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4ab230bb-5fb4-488e-b2aa-1cbe2d43e0d7\', \'multiverseId\': 443308}, \'multiverseid\': 443308}, {\'name\': \'Furia de la Señora Guerrera\', \'text\': \'Las criaturas que controlas ganan la habilidad de dañar primero hasta el final del turno.\\nRoba una carta.\', \'type\': \'Conjuro\', \'flavor\': \'"Las viejas costumbres eran para un mundo invernal. Hacemos lo que nos conviene ahora, no lo que convenía en el pasado. ¡Somos los keldon!". —Radha, Gran Señora Guerrera\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443577&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ff56fe43-e5b0-4198-bc16-153595b07e6f\', \'multiverseId\': 443577}, \'multiverseid\': 443577}, {\'name\': \'Fureur du seigneur de guerre\', \'text\': "Les créatures que vous contrôlez acquièrent l\'initiative jusqu\'à la fin du tour.\\nPiochez une carte.", \'type\': \'Rituel\', \'flavor\': "« Les anciennes traditions correspondent à un monde hivernal. Nous faisons ce qu\'il y a de mieux pour nous, pas pour le passé. Nous sommes des Keldes ! » —Grand seigneur de guerre Radha", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443846&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b204ee66-3a17-4f6e-9145-9e7dfd2ebf22\', \'multiverseId\': 443846}, \'multiverseid\': 443846}, {\'name\': \'Furia della Signora della Guerra\', \'text\': \'Le creature che controlli hanno attacco improvviso fino alla fine del turno.\\nPesca una carta.\', \'type\': \'Stregoneria\', \'flavor\': \'"Le antiche usanze si addicevano a un mondo avvolto nel gelo, ma ora dobbiamo agire come è meglio per noi, non per il passato. Siamo i signori di Keld!" —Radha, suprema signora della guerra\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444115&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c892ac5f-0485-4562-bec4-fba15f2415b7\', \'multiverseId\': 444115}, \'multiverseid\': 444115}, {\'name\': \'大将軍の憤怒\', \'text\': \'ターン終了時まで、あなたがコントロールしているクリーチャーは先制攻撃を得る。\\nカードを１枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'「古い因襲は冬の世界のものだ。過去ではなく我らに適したやり方を我らは選ぶ。我らはケルドなのだ！」 ――総将軍ラーダ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444384&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'70018d7b-322a-4d7c-a96d-37def2088f03\', \'multiverseId\': 444384}, \'multiverseid\': 444384}, {\'name\': \'전쟁군주의 분노\', \'text\': \'당신이 조종하는 생물들은 턴종료까지 선제공격을 얻는다.\\n카드 한 장을 뽑는다.\', \'type\': \'집중마법\', \'flavor\': \'"옛날의 방식들은 겨울의 세계를 위한 것이었다. 우리는 과거를 위해서가 아니라, 우리 스스로를 위해 가장 잘하는 일을 하는 것이다. 우리는 켈드인이다!" —위대한 전쟁군주 라다\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444653&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b97ad0d1-4f16-4aa1-9a57-3809b931fb41\', \'multiverseId\': 444653}, \'multiverseid\': 444653}, {\'name\': \'Fúria da Senhora da Guerra\', \'text\': \'As criaturas que você controla ganham iniciativa até o final do turno.\\nCompre um card.\', \'type\': \'Feitiço\', \'flavor\': \'"Os antigos costumes eram para um mundo invernal. Fazemos o que é melhor para nós, não para o passado. Somos keldonianos!" — Radha, Grã-senhora da Guerra\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444922&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2d3e1abc-c66d-4dda-afac-eb1ee38b803c\', \'multiverseId\': 444922}, \'multiverseid\': 444922}, {\'name\': \'Ярость Великого Вождя\', \'text\': \'Существа под вашим контролем получают Первый удар до конца хода.\\nВозьмите карту.\', \'type\': \'Волшебство\', \'flavor\': \'«Старые обычаи подходили для мира, где вечно длится зима. Мы делаем то, что лучше для нас, а не для прошлого. Мы — келдонцы!» — Великий вождь Радха\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445191&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'59fb3eb6-94b7-4d67-bcf9-d0981f44e9ce\', \'multiverseId\': 445191}, \'multiverseid\': 445191}, {\'name\': \'军阀怒火\', \'text\': \'由你操控的生物获得先攻异能直到回合结束。\\n抓一张牌。\', \'type\': \'法术\', \'flavor\': \'「旧作法只适合那个寒冬世界。我们要考虑的是自己的生活，而不是传承过往。我们是凯尔顿人！」 ～大军阀拉妲\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445460&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f50d902c-2231-4e95-898c-b40a5d1e56e1\', \'multiverseId\': 445460}, \'multiverseid\': 445460}, {\'name\': \'軍閥怒火\', \'text\': \'由你操控的生物獲得先攻異能直到回合結束。\\n抽一張牌。\', \'type\': \'巫術\', \'flavor\': \'「舊作法只適合那個寒冬世界。我們要考慮的是自己的生活，而不是傳承過往。我們是凱爾頓人！」 ～大軍閥拉妲\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445729&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'addde09c-3483-422d-92ac-7850b17df2c4\', \'multiverseId\': 445729}, \'multiverseid\': 445729}]', '[{\'name\': \'Zurückspulen\', \'text\': \'Neutralisiere einen Nichtkreatur-Zauberspruch deiner Wahl. Enttappe bis zu drei Länder.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ein Problem ist erst dann wirklich ein Problem, wenn dir die Mittel fehlen, es zu beheben." —Jhoira\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443229&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7fbc1826-5d83-4b88-b9bb-48f5a9e572a2\', \'multiverseId\': 443229}, \'multiverseid\': 443229}, {\'name\': \'Desarticular\', \'text\': \'Contrarresta el hechizo objetivo que no sea de criatura. Endereza hasta tres tierras.\', \'type\': \'Instantáneo\', \'flavor\': \'"Un problema solo es tal si no se dispone de las herramientas necesarias para corregirlo". —Jhoira\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443498&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c17d0c1a-4177-48cb-a6d1-7955818260a1\', \'multiverseId\': 443498}, \'multiverseid\': 443498}, {\'name\': \'Débobinage\', \'text\': "Contrecarrez le sort non-créature ciblé. Dégagez jusqu\'à trois terrains.", \'type\': \'Éphémère\', \'flavor\': "« Un problème n\'en est un que si l\'on ne dispose pas des outils nécessaires pour le résoudre. » —Djoïra", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443767&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d53db739-7263-4a6f-9957-700c73529b67\', \'multiverseId\': 443767}, \'multiverseid\': 443767}, {\'name\': \'Scomporre\', \'text\': \'Neutralizza una magia non creatura bersaglio. STAPpa fino a tre terre.\', \'type\': \'Istantaneo\', \'flavor\': \'"Un problema si può considerare tale solo in mancanza degli strumenti per risolverlo." —Jhoira\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444036&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ceb5eb65-24fe-4a0b-b98d-3a2d941c589c\', \'multiverseId\': 444036}, \'multiverseid\': 444036}, {\'name\': \'巻き戻し\', \'text\': \'クリーチャーでない呪文１つを対象とし、それを打ち消す。土地最大３つをアンタップする。\', \'type\': \'インスタント\', \'flavor\': \'「問題というのはね、それを訂正する道具を持っていないから問題なのよ。」 ――ジョイラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444305&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ab1a8ef7-abc9-4d4d-a168-9a0bea011fc9\', \'multiverseId\': 444305}, \'multiverseid\': 444305}, {\'name\': \'풀어내기\', \'text\': \'생물이 아닌 주문을 목표로 정한다. 그 주문을 무효화한다. 대지를 최대 세 개까지 언탭한다.\', \'type\': \'순간마법\', \'flavor\': \'"문제는 그것을 바로잡을 수단이 없을 때만 문제가 되는 거야." —조이라\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444574&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'301e5d0a-a5f7-4005-a740-ffb4cee1cb1a\', \'multiverseId\': 444574}, \'multiverseid\': 444574}, {\'name\': \'Desenrolar\', \'text\': \'Anule a mágica alvo que não seja de criatura. Desvire até três terrenos.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Um problema só é problema se você não tiver as ferramentas para resolvê-lo." — Jhoira\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444843&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'08f05522-0390-420a-b667-cb0b93c9cca9\', \'multiverseId\': 444843}, \'multiverseid\': 444843}, {\'name\': \'Свести на Нет\', \'text\': \'Отмените целевое заклинание, не являющееся заклинанием существа. Разверните не более трех земель.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Затруднение только тогда можно назвать затруднением, когда у тебя нет нужных инструментов, чтобы его устранить». — Джойра\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445112&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a148e8be-0bcb-4a79-a755-2737fc13ea53\', \'multiverseId\': 445112}, \'multiverseid\': 445112}, {\'name\': \'倒流\', \'text\': \'反击目标非生物咒语。重置至多三个地。\', \'type\': \'瞬间\', \'flavor\': \'「没有工具可解决的问题才真算是问题。」 ～尤依拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445381&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d3dc66b8-454f-4b3c-a4c7-311b384585d0\', \'multiverseId\': 445381}, \'multiverseid\': 445381}, {\'name\': \'倒流\', \'text\': \'反擊目標非生物咒語。重置至多三個地。\', \'type\': \'瞬間\', \'flavor\': \'「沒有工具可解決的問題才真算是問題。」 ～尤依菈\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445650&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ecc0d323-314e-46f1-ae22-070f0229fae1\', \'multiverseId\': 445650}, \'multiverseid\': 445650}]', '[{\'name\': \'Zweiköpfiger Riese\', \'text\': \'Immer wenn der Zweiköpfige Riese angreift, wirf zwei Münzen. Falls beide Münzen „Kopf" zeigen, erhält der Zweiköpfige Riese Doppelschlag bis zum Ende des Zuges. Falls beide Münzen „Zahl" zeigen, erhält der Zweiköpfige Riese Bedrohlichkeit bis zum Ende des Zuges.\', \'type\': \'Kreatur — Riese, Krieger\', \'flavor\': \'Niemand kommt an ihm vorbei, ohne Wegzoll zu bezahlen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443304&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d04861a4-afdb-4cd3-a682-6f496a1ad48b\', \'multiverseId\': 443304}, \'multiverseid\': 443304}, {\'name\': \'Gigante de dos cabezas\', \'text\': \'Siempre que el Gigante de dos cabezas ataque, lanza dos monedas a cara o cruz. Si en las dos monedas sale cara, el Gigante de dos cabezas gana la habilidad de dañar dos veces hasta el final del turno. Si en las dos monedas sale cruz, el Gigante de dos cabezas gana la habilidad de amenaza hasta el final del turno.\', \'type\': \'Criatura — Gigante guerrero\', \'flavor\': \'Vigila el paso en ambas direcciones, y todos deben pagar peaje.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443573&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'11bbe571-3146-4b68-a672-784ea7b19edf\', \'multiverseId\': 443573}, \'multiverseid\': 443573}, {\'name\': \'Géant bicéphale\', \'text\': "À chaque fois que le Géant bicéphale attaque, jouez deux fois à pile ou face. Si les deux pièces retombent sur face, le Géant bicéphale acquiert la double initiative jusqu\'à la fin du tour. Si les deux pièces retombent sur pile, le Géant bicéphale acquiert la menace jusqu\'à la fin du tour.", \'type\': \'Créature : géant et guerrier\', \'flavor\': \'Il surveille le col dans les deux sens, et tous doivent payer son prix.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443842&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d8983c65-636d-4b86-9bda-fc298547ed1f\', \'multiverseId\': 443842}, \'multiverseid\': 443842}, {\'name\': \'Gigante Bicefalo\', \'text\': \'Ogniqualvolta il Gigante Bicefalo attacca, lancia due monete. Se ottieni testa con entrambe le monete, il Gigante Bicefalo ha doppio attacco fino alla fine del turno. Se ottieni croce con entrambe le monete, il Gigante Bicefalo ha minacciare fino alla fine del turno.\', \'type\': \'Creatura — Guerriero Gigante\', \'flavor\': \'Controlla il passaggio in entrambe le direzioni e tutti devono pagare il suo dazio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444111&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'12d2b4ff-c869-413b-885b-ba66a1522852\', \'multiverseId\': 444111}, \'multiverseid\': 444111}, {\'name\': \'双頭巨人\', \'text\': \'双頭巨人が攻撃するたび、コインを２枚投げる。両方とも表が出たなら、ターン終了時まで、双頭巨人は二段攻撃を得る。両方とも裏が出たなら、ターン終了時まで、双頭巨人は威迫を得る。\', \'type\': \'クリーチャー — 巨人・戦士\', \'flavor\': \'巨人は道の両方向を見張っていて、必ず通行料を取る。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444380&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e6801f05-46f1-4bec-88da-828b01e285ae\', \'multiverseId\': 444380}, \'multiverseid\': 444380}, {\'name\': \'쌍두거인\', \'text\': \'쌍두거인이 공격할 때마다, 동전 두 개를 던진다. 동전 두 개가 모두 앞면이면, 쌍두거인은 턴종료까지 이단공격을 얻는다. 동전 두 개가 모두 뒷면이면, 쌍두거인은 턴종료까지 호전적을 얻는다.\', \'type\': \'생물 — 거인 전사\', \'flavor\': \'그는 길 양쪽을 모두 주시하고 있으며, 누구든지 지나가려면 통행료를 내야 한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444649&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'58bc9508-0da5-4d7a-b2e6-c9d3c0885a85\', \'multiverseId\': 444649}, \'multiverseid\': 444649}, {\'name\': \'Gigante de Duas Cabeças\', \'text\': \'Toda vez que Gigante de Duas Cabeças atacar, jogue duas moedas. Se ambas derem cara, Gigante de Duas Cabeças ganha golpe duplo até o final do turno. Se ambas derem coroa, Gigante de Duas Cabeças ganha ameaçar até o final do turno.\', \'type\': \'Criatura — Gigante Guerreiro\', \'flavor\': \'Ele vigia ambos os sentidos da passagem, e todos precisam pagar seu pedágio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444918&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fdc71477-be3a-402d-a80d-583b3a9efdca\', \'multiverseId\': 444918}, \'multiverseid\': 444918}, {\'name\': \'Двухголовый Гигант\', \'text\': \'Каждый раз, когда Двухголовый Гигант атакует, подбросьте две монеты. Если оба раза выпадает орел, Двухголовый Гигант получает Двойной удар до конца хода. Если оба раза выпадает решка, Двухголовый Гигант получает Угрозу до конца хода.\', \'type\': \'Существо — Гигант Воин\', \'flavor\': \'Он наблюдает за проходом в обоих направлениях, и всякий должен заплатить ему.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445187&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f86a8147-1f2b-4904-b9d3-3ea417658ba0\', \'multiverseId\': 445187}, \'multiverseid\': 445187}, {\'name\': \'双头巨人\', \'text\': \'每当双头巨人攻击时，掷两枚硬币。如果两枚硬币均是正面，则双头巨人获得连击异能直到回合结束。如果两枚硬币均是反面，则双头巨人获得威慑异能直到回合结束。\', \'type\': \'生物 ～巨人／战士\', \'flavor\': \'他一人看守关隘两边，来去都得留下过路费。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445456&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b39df2fd-fc76-4b46-a05c-01518b390ae8\', \'multiverseId\': 445456}, \'multiverseid\': 445456}, {\'name\': \'雙頭巨人\', \'text\': \'每當雙頭巨人攻擊時，擲兩枚硬幣。如果兩枚硬幣均是正面，則雙頭巨人獲得連擊異能直到回合結束。如果兩枚硬幣均是反面，則雙頭巨人獲得威懾異能直到回合結束。\', \'type\': \'生物 ～巨人／戰士\', \'flavor\': \'他一人看守關隘兩邊，來去都得留下過路費。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445725&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a2ec0202-0609-460d-bde2-598db3bb54bd\', \'multiverseId\': 445725}, \'multiverseid\': 445725}]', '[{\'name\': \'Übungskonstrukt\', \'text\': \'Wenn das Übungskonstrukt stirbt, lege eine +1/+1-Marke auf eine Kreatur deiner Wahl, die du kontrollierst.\', \'type\': \'Artefaktkreatur — Konstrukt\', \'flavor\': \'Diese Konstrukte waren ein Dankesgeschenk der Zauberer von Westtolaria an die Ritter von Neu-Benalia für deren Unterstützung während des Talas-Einfalls.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443389&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b542e084-ada5-460f-ad09-c3f2dd69f2e9\', \'multiverseId\': 443389}, \'multiverseid\': 443389}, {\'name\': \'Constructo de entrenamiento\', \'text\': \'Cuando el Constructo de entrenamiento muera, pon un contador +1/+1 sobre la criatura objetivo que controlas.\', \'type\': \'Criatura artefacto — Constructo\', \'flavor\': \'Los muñecos de entrenamiento fueron un regalo de los hechiceros de Tolaria Oeste a los caballeros de Nueva Benalia por su ayuda durante la incursión talas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443658&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d726209b-dab6-4df8-9ec0-11dd179caf50\', \'multiverseId\': 443658}, \'multiverseid\': 443658}, {\'name\': "Construction d\'entraînement", \'text\': "Quand la Construction d\'entraînement meurt, mettez un marqueur +1/+1 sur une créature ciblée que vous contrôlez.", \'type\': \'Créature-artefact : construction\', \'flavor\': "Les entraîneurs furent offerts par les sorciers de l\'Ouest de Tolaria aux chevaliers de la Nouvelle Bénalia, en gage de leur gratitude pour leur aide durant l\'Incursion talienne.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=443927&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ef1486d6-6fc5-4253-9bb6-53d3ba6d43d9\', \'multiverseId\': 443927}, \'multiverseid\': 443927}, {\'name\': \'Costrutto da Addestramento\', \'text\': \'Quando il Costrutto da Addestramento muore, metti un segnalino +1/+1 su una creatura bersaglio che controlli.\', \'type\': \'Creatura Artefatto — Costrutto\', \'flavor\': "Gli addestratori furono donati dai maghi di Tolaria Occidentale ai cavalieri di Nuova Benalia in segno di gratitudine per il loro aiuto durante l\'incursione di Talas.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444196&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f87e8c65-5dbc-4b69-a748-5dca44d19b97\', \'multiverseId\': 444196}, \'multiverseid\': 444196}, {\'name\': \'演習用模型\', \'text\': \'演習用模型が死亡したとき、あなたがコントロールしているクリーチャー１体を対象とし、それの上に＋１/＋１カウンターを１個置く。\', \'type\': \'アーティファクト・クリーチャー — 構築物\', \'flavor\': \'この訓練機械は、タラスの侵略の際に受けた支援に対する感謝の品として、トレイリア西部の魔術師から新ベナリアの騎士へ贈られたものだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444465&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'22395c9b-68d1-4d32-9741-10d12cd19e51\', \'multiverseId\': 444465}, \'multiverseid\': 444465}, {\'name\': \'연습상대 자동기계\', \'text\': \'연습상대 자동기계가 죽을 때, 당신이 조종하는 생물을 목표로 정한다. 그 생물에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'마법물체 생물 — 자동기계\', \'flavor\': \'이 훈련 기계들은 톨라리아 서관의 마법사들이 탈라스 침공 때 자신들을 도와준 신 베날리아의 기사들에게 선물한 것이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=444734&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e2b571db-3b2b-4dcd-aa9f-c1e8980cdc42\', \'multiverseId\': 444734}, \'multiverseid\': 444734}, {\'name\': \'Constructo de Treino\', \'text\': \'Quando Constructo de Treino morrer, coloque um marcador +1/+1 na criatura alvo que você controla.\', \'type\': \'Criatura Artefato — Constructo\', \'flavor\': \'Os treinadores foram um presente de agradecimento dos magos de Tolária Ocidental aos cavaleiros de Nova Benália pela ajuda durante a Incursão dos Talas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445003&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f3019f49-cf10-4a89-9c55-0a798311230e\', \'multiverseId\': 445003}, \'multiverseid\': 445003}, {\'name\': \'Тренировочная Конструкция\', \'text\': \'Когда Тренировочная Конструкция умирает, положите один жетон +1/+1 на целевое существо под вашим контролем.\', \'type\': \'Артефакт Существо — Конструкция\', \'flavor\': \'Тренировочные манекены стали благодарственным подарком от чародеев Западной Толарии рыцарям Новой Беналии за их помощь во время вторжения Таласов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445272&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'443e9caf-712a-41be-bad1-749d423f0f3f\', \'multiverseId\': 445272}, \'multiverseid\': 445272}, {\'name\': \'战训组构体\', \'text\': \'当战训组构体死去时，在目标由你操控的生物上放置一个+1/+1指示物。\', \'type\': \'神器生物 ～组构体\', \'flavor\': \'这批训练器械乃是陶拉里亚西境法术师送给新宾纳里亚骑士的谢礼，以报答他们在塔拉斯入侵期间的相助之恩。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445541&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'201fff04-26df-4ee0-86f6-fff585d84179\', \'multiverseId\': 445541}, \'multiverseid\': 445541}, {\'name\': \'戰訓組構體\', \'text\': \'當戰訓組構體死去時，在目標由你操控的生物上放置一個+1/+1指示物。\', \'type\': \'神器生物 ～組構體\', \'flavor\': \'這批訓練器械乃是陶拉里亞西境的魔法師送給新賓納里亞騎士的謝禮，以報答他們在塔拉斯入侵期間的相助之恩。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=445810&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c02023ed-460d-4f2e-9998-ae093f3ffc90\', \'multiverseId\': 445810}, \'multiverseid\': 445810}]']
