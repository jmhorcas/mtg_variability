, 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385114&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '090d03e5-cc46-41ee-879f-8810d2bb7914', 'multiverseId': 385114}, 'multiverseid': 385114}, {'name': '늪', 'type': '기본 대지 — 늪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385398&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '922e25b5-ae57-4672-9a0c-89da2e3d864c', 'multiverseId': 385398}, 'multiverseid': 385398}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385682&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f44a328d-2e44-40fb-9c67-a54434317727', 'multiverseId': 385682}, 'multiverseid': 385682}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385966&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '756c6017-b533-44b6-8c71-7cead3adfa71', 'multiverseId': 385966}, 'multiverseid': 385966}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383694&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '1df9b37a-51c9-4d9b-ad21-cd61c740e98f', 'multiverseId': 383694}, 'multiverseid': 383694}, {'name': '沼澤', 'type': '基本地～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383978&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '7910a828-6f70-462e-a10e-584349ae2845', 'multiverseId': 383978}, 'multiverseid': 383978}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384263&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2a26416f-05b1-43a8-a0e3-7