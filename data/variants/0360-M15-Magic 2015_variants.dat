lavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386157&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '8a6d4b9e-6724-4e25-b871-a7531ae8fa4a', 'multiverseId': 386157}, 'multiverseid': 386157}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384453&type=card', 'language': 'French', 'identifiers': {'scryfallId': '1b251f68-07da-4c87-a364-9be60af29694', 'multiverseId': 384453}, 'multiverseid': 384453}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384737&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '5b7b2247-993e-4bde-b9ec-c43b8080da45', 'multiverseId': 384737}, 'multiverseid': 384737}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385021&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '26e9eafa-2f90-40df-a6e1-97f8477bdc9a', 'multiverseId': 385021}, 'multiverseid': 385021}, {'name': '산', 'type': '기본 대지 — 산', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385305&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '81f62ea1-0f60-4079-b4c2-1262128d0db2', 'multiverseId': 385305}, 'multiverseid': 385305}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385589&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7804d0ef-d4dc-41dd-9e74-71c83ac89267', 'multiverseId': 385589}, 'multiverseid': 385589}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385873&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '3c2b0fcd-1e97-451a-9de9-b25c343e086c', 'multiverseId': 385873}, 'multiverseid': 385873}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383601&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '4cfe3789-43a7-42a1-8441-9827990adbbb', 'multiverseId': 383601}, 'multiverseid': 383601}, {'name': '山脈', 'type': '基本地～山脈', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383885&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '0bb93478-8b90-4c98-be3e-9d0daf011030', 'multiverseId': 383885}, 'multiverseid': 383885}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384170&type=card', 'language': 'German', 'identifiers': {'scryfallId': '19d0b0d0-19f6-481c-b078-ebea5500ce86', 'multiverseId': 384170}, 'multiverseid': 384170}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386158&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ddbbb137-dbad-4340-ad36-16679d42fb6c', 'multiverseId': 386158}, 'multiverseid': 386158}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384454&type=card', 'language': 'French', 'identifiers': {'scryfallId': '3843e689-1f0a-497c-ac3c-273af6aa30fd', 'multiverseId': 384454}, 'multiverseid': 384454}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384738&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '417eb5e2-ff73-41d9-8687-44fa75fbe87f', 'multiverseId': 384738}, 'multiverseid': 384738}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385022&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9b483eeb-19d1-4960-8b54-756ad2d0e475', 'multiverseId': 385022}, 'multiverseid': 385022}, {'name': '산', 'type': '기본 대지 — 산', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385306&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'a7a6578e-fe89-4d79-9991-9a20a86075c5', 'multiverseId': 385306}, 'multiverseid': 385306}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385590&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f7b67084-ca95-4bf3-9a91-3cacbe322a36', 'multiverseId': 385590}, 'multiverseid': 385590}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385874&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '33858d3d-dc07-4fa5-a8c3-6e2147d435e6', 'multiverseId': 385874}, 'multiverseid': 385874}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383602&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '1eac77c0-2de8-41f7-a172-4f672df58875', 'multiverseId': 383602}, 'multiverseid': 383602}, {'name': '山脈', 'type': '基本地～山脈', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383886&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '2b74d8b6-609e-4efb-926e-9180d34dbf86', 'multiverseId': 383886}, 'multiverseid': 383886}]", '[{\'name\': \'Gedankenformung\', \'text\': \'Ein Gegner deiner Wahl legt die obersten sieben Karten seiner Bibliothek auf seinen Friedhof.\', \'type\': \'Hexerei\', \'flavor\': \'„Dein Verstand war eine lustige Mischung aus Genie und Wahnsinn. Den Wahnsinn habe ich dir gelassen." —Jace Beleren\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384165&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'df9da2a6-5012-4f19-9b29-c9e12ccbce40\', \'multiverseId\': 384165}, \'multiverseid\': 384165}, {\'name\': \'Esculpir la mente\', \'text\': \'El oponente objetivo pone las siete primeras cartas de su biblioteca en su cementerio.\', \'type\': \'Conjuro\', \'flavor\': \'"Tu mente era una curiosa mezcla de locura y genialidad. Acabo de arrebatarte la genialidad." —Jace Beleren\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386153&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1de2c8f0-1498-44bf-a1f8-eb75af47375a\', \'multiverseId\': 386153}, \'multiverseid\': 386153}, {\'name\': \'Sculpture mentale\', \'text\': "L\'adversaire ciblé met les sept cartes du dessus de sa bibliothèque dans son cimetière.", \'type\': \'Rituel\', \'flavor\': \'« Ton esprit était un mélange curieux de folie et de génie. Je me suis contenté de prendre le génie. » —Jace Beleren\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384449&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a98f9d75-0880-4925-a884-024ee7dc10af\', \'multiverseId\': 384449}, \'multiverseid\': 384449}, {\'name\': \'Scolpire Menti\', \'text\': \'Un avversario bersaglio mette nel suo cimitero le prime sette carte del suo grimorio.\', \'type\': \'Stregoneria\', \'flavor\': \'"La tua mente era uno strano miscuglio di genio e follia. Ho semplicemente eliminato il genio." —Jace Beleren\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384733&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'60bfd1e3-6fa7-4ddb-b64e-d307bce0ca3f\', \'multiverseId\': 384733}, \'multiverseid\': 384733}, {\'name\': \'精神刻み\', \'text\': \'対戦相手１人を対象とする。そのプレイヤーは、自分のライブラリーの一番上から７枚のカードを自分の墓地に置く。\', \'type\': \'ソーサリー\', \'flavor\': \'「あなたの精神は、狂気と理性が興味深い混在を成していた。私はその理性を取り除いただけだ。」 ――ジェイス・ベレレン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385017&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'78838b6d-ac8c-466b-95c0-8b69df5c0b0e\', \'multiverseId\': 385017}, \'multiverseid\': 385017}, {\'name\': \'정신 조작\', \'text\': \'플레이어를 목표로 정한다. 그 플레이어는 자신의 서고 맨 위의 카드 일곱 장을 자신의 무덤에 넣는다.\', \'type\': \'집중마법\', \'flavor\': \'"네 머릿속은 광기와 천재성이 뒤섞여 있었고, 난 그중 천재성만 없애버렸지." —제이스 벨레렌\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385301&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'bba3a30c-069f-4f8f-9bd4-4f23f16ff9db\', \'multiverseId\': 385301}, \'multiverseid\': 385301}, {\'name\': \'Esculpir a Mente\', \'text\': \'O oponente alvo coloca os sete cards do topo do grimório dele no próprio cemitério.\', \'type\': \'Feitiço\', \'flavor\': \'"Sua mente era uma curiosa mistura de loucura e genialidade. Eu simplesmente retirei a genialidade." — Jace Beleren\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385585&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3fed8596-7bc8-4233-b74e-35879a2b67c0\', \'multiverseId\': 385585}, \'multiverseid\': 385585}, {\'name\': \'Лепка Сознания\', \'text\': \'Целевой оппонент кладет семь верхних карт своей библиотеки на свое кладбище.\', \'type\': \'Волшебство\', \'flavor\': \'«Ваш разум был любопытным сочетанием безумия и гениальности. Я стер только гениальность». — Джейс Белерен\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385869&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'de73a7e7-3557-49e2-8a45-f2244b0fa3f1\', \'multiverseId\': 385869}, \'multiverseid\': 385869}, {\'name\': \'心灵塑型\', \'text\': \'目标对手将其牌库顶的七张牌置入其坟墓场。\', \'type\': \'法术\', \'flavor\': \'「你的心灵是疯狂与天才的奇妙组合。我刚把天才的那部份拿走了。」 ～杰斯贝连\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383597&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a61db3cd-ed3d-4de1-8490-e9df7e2dabeb\', \'multiverseId\': 383597}, \'multiverseid\': 383597}, {\'name\': \'心靈塑型\', \'text\': \'目標對手將其牌庫頂的七張牌置入其墳墓場。\', \'type\': \'巫術\', \'flavor\': \'「你的心靈是瘋狂與天才的奇妙組合。我剛把天才的那部份拿走了。」 ～傑斯貝連\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383881&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'186f68f0-f9d2-4212-b743-94b3d3a3670f\', \'multiverseId\': 383881}, \'multiverseid\': 383881}]', '[{\'name\': \'Gedankenschändung\', \'text\': \'Einberufen (Deine Kreaturen können dir helfen, diesen Zauberspruch zu wirken. Jede Kreatur, die du tappst, während du diesen Zauberspruch wirkst, reduziert dessen Kosten um {1} oder um ein Mana der Farbe jener Kreatur.)\\nBenenne eine Karte, die kein Land ist. Durchsuche den Friedhof, die Hand und die Bibliothek eines Spielers deiner Wahl nach einer beliebigen Anzahl an Karten mit diesem Namen und schicke sie ins Exil. Dieser Spieler mischt dann seine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384254&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'760794c9-ca54-4b67-8503-5c0b681afd1c\', \'multiverseId\': 384254}, \'multiverseid\': 384254}, {\'name\': \'Corromper la mente\', \'text\': \'Convocar. (Tus criaturas pueden ayudar a lanzar este hechizo. Cada criatura que gires al lanzar este hechizo cuenta como un pago de {1} o de un maná del color de esa criatura.)\\nNombra una carta que no sea tierra. Busca en el cementerio, mano y biblioteca del jugador objetivo cualquier cantidad de cartas con ese nombre y exílialas. Luego ese jugador baraja su biblioteca.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386242&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2662dd2e-e023-4eb3-a638-23058b45b8cd\', \'multiverseId\': 386242}, \'multiverseid\': 386242}, {\'name\': \'Souillure spirituelle\', \'text\': "Convocation (Vos créatures peuvent aider à lancer ce sort. Chaque créature que vous engagez en lançant ce sort paie {1} ou un mana de la couleur de cette créature.)\\nNommez une carte non-terrain. Cherchez dans le cimetière, la main et la bibliothèque du joueur ciblé n\'importe quel nombre de cartes avec ce nom et exilez-les. Ce joueur mélange ensuite sa bibliothèque.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384538&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ff983c11-8924-4b7b-9de0-b6a95a19087b\', \'multiverseId\': 384538}, \'multiverseid\': 384538}, {\'name\': \'Contaminare la Mente\', \'text\': \'Convocazione (Le tue creature possono aiutarti a lanciare questa magia. Ogni creatura che TAPpi mentre lanci questa magia corrisponde al pagamento di {1} o di un mana del colore di quella creatura.)\\nNomina una carta non terra. Passa in rassegna il cimitero, la mano e il grimorio di un giocatore bersaglio per un qualsiasi numero di carte con quel nome ed esiliale. Poi quel giocatore rimescola il suo grimorio.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384822&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eb62f0a2-cffd-4736-97b6-6c15495eb010\', \'multiverseId\': 384822}, \'multiverseid\': 384822}, {\'name\': \'精神染み\', \'text\': \'召集（あなたのクリーチャーが、この呪文を唱える助けとなる。この呪文を唱える段階であなたがタップした各クリーチャーは、{1}かそのクリーチャーの色のマナ１点を支払う。）\\nプレイヤー１人を対象とする。土地でないカード名を１つ指定する。そのプレイヤーの墓地と手札とライブラリーから、その名前を持つカードを望む枚数探し、それらを追放する。その後、そのプレイヤーは自分のライブラリーを切り直す。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385106&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b53a91f8-7755-40a0-b207-a718c8d98638\', \'multiverseId\': 385106}, \'multiverseid\': 385106}, {\'name\': \'정신을 더럽히다\', \'text\': \'집합 (당신의 생물들은 이 주문을 발동하는 것을 도울 수 있다. 이 주문을 발동할 때 탭하는 생물 한 개당 이 주문의 비용은 {1} 또는 그 생물의 색인 마나 한 개만큼 줄어든다.)\\n대지가 아닌 카드 한 장을 호명한다. 플레이어를 목표로 정한다. 그 플레이어의 무덤, 손, 서고에서 그 이름의 카드를 원하는 만큼 찾아서 추방한다. 그러고 나서 그 플레이어는 자신의 서고를 섞는다.\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385390&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4753cd45-8e8b-43bb-bda7-1144b8571047\', \'multiverseId\': 385390}, \'multiverseid\': 385390}, {\'name\': \'Manchar a Mente\', \'text\': \'Convocar (Suas criaturas podem ajudar a conjurar esta mágica. Cada criatura que você vira ao conjurar esta mágica paga {1} ou um mana da cor daquela criatura.)\\nNomeie um card que não seja um terreno. Procure um número qualquer de cards com o mesmo nome daquele card no cemitério, na mão e no grimório do jogador alvo e exile-os. Depois, aquele jogador embaralha o próprio grimório.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385674&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'51bb891e-c0da-4e38-aa35-a2b263222ba1\', \'multiverseId\': 385674}, \'multiverseid\': 385674}, {\'name\': \'Помутнение Рассудка\', \'text\': \'Созыв (Ваши существа могут помочь разыграть это заклинание. Каждое существо, которое вы поворачиваете при разыгрывании этого заклинания, считается оплатой {1} или одной маны цвета того существа.)\\nНазовите карту, не являющуюся землей. Найдите на кладбище, в руке и в библиотеке целевого игрока любое количество карт с тем именем и изгоните их. Затем тот игрок тасует свою библиотеку.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385958&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'728e6185-bf1c-404b-a809-565eabf6b1ca\', \'multiverseId\': 385958}, \'multiverseid\': 385958}, {\'name\': \'玷污心智\', \'text\': \'召集（此咒语能用你的生物来协助施放。你于施放此咒语时每横置一个生物，就能为此咒语支付{1}或一点该生物颜色之法术力。）\\n说出一个非地牌的名称。从目标牌手的坟墓场，手牌及牌库中搜寻任意数量该名称的牌，并将它们放逐。然后该牌手将其牌库洗牌。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383686&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cf20ccb3-2f27-4dfa-97ee-e563c859e942\', \'multiverseId\': 383686}, \'multiverseid\': 383686}, {\'name\': \'玷污心智\', \'text\': \'召集（此咒語能用你的生物來協助施放。你於施放此咒語時每橫置一個生物，就能為此咒語支付{1}或一點該生物顏色之魔法力。）\\n說出一個非地牌的名稱。從目標玩家的墳墓場、手牌以及牌庫中搜尋任意數量該名稱的牌，並將它們放逐。然後該玩家將其牌庫洗牌。\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383970&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'08b15e56-be6d-4133-9daf-c4ff7c055531\', \'multiverseId\': 383970}, \'multiverseid\': 383970}]', '[{\'name\': \'Gedankenzersetzung\', \'text\': \'Ein Spieler deiner Wahl wirft zwei Karten ab.\', \'type\': \'Hexerei\', \'flavor\': \'„Es macht mich traurig, eine Quelle der Inspiration zu verlieren. Diese hier schien besonders vielversprechend." —Ashiok\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384164&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0149e4a9-e030-4c82-b4a1-02db3ae3ba02\', \'multiverseId\': 384164}, \'multiverseid\': 384164}, {\'name\': \'Podredumbre mental\', \'text\': \'El jugador objetivo descarta dos cartas.\', \'type\': \'Conjuro\', \'flavor\': \'"Me entristece perder una fuente de inspiración. Esta parecía especialmente prometedora". —Ashiok\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386152&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c671f68f-5ae7-402d-90ad-ff22e3242f22\', \'multiverseId\': 386152}, \'multiverseid\': 386152}, {\'name\': \'Pourrissement cérébral\', \'text\': \'Le joueur ciblé se défausse de deux cartes.\', \'type\': \'Rituel\', \'flavor\': "« Quelle tristesse de voir disparaître une source d\'inspiration. D\'autant que celle-ci paraissait très prometteuse. » —Ashiok", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384448&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'caf2dfa9-eb31-401a-85b5-f463a65ec0a0\', \'multiverseId\': 384448}, \'multiverseid\': 384448}, {\'name\': \'Cancrena della Mente\', \'text\': \'Un giocatore bersaglio scarta due carte.\', \'type\': \'Stregoneria\', \'flavor\': \'"Mi addolora perdere una fonte di ispirazione. Questa sembrava particolarmente promettente." —Ashiok\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384732&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bd5ac834-66af-495b-8600-3c599ca7d60c\', \'multiverseId\': 384732}, \'multiverseid\': 384732}, {\'name\': \'精神腐敗\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーはカードを２枚捨てる。\', \'type\': \'ソーサリー\', \'flavor\': \'「発想の源が失われるのは悲しいものがある。今回のは特に有望そうだったのだが。」 ――アショク\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385016&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f43c697d-6156-4f0f-9c99-3501983e6ecf\', \'multiverseId\': 385016}, \'multiverseid\': 385016}, {\'name\': \'정신 부패\', \'text\': \'플레이어를 목표로 정한다. 그 플레이어는 카드 두 장을 버린다.\', \'type\': \'집중마법\', \'flavor\': \'"영감의 원천을 잃는 일은 날 슬프게 한다. 이번 녀석은 특히 유망해 보였었다." —아시오크\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385300&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2c9c1290-783c-4a68-a4f1-e35a6eadcba4\', \'multiverseId\': 385300}, \'multiverseid\': 385300}, {\'name\': \'Estiolar a Mente\', \'text\': \'O jogador alvo descarta dois cards.\', \'type\': \'Feitiço\', \'flavor\': \'"Me entristece perder uma fonte de inspiração. Essa parecia especialmente promissora." — Ashiok\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385584&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ce34cf47-470a-4271-8a01-3edccd46c7a6\', \'multiverseId\': 385584}, \'multiverseid\': 385584}, {\'name\': \'Гниение Разума\', \'text\': \'Целевой игрок сбрасывает две карты.\', \'type\': \'Волшебство\', \'flavor\': \'«Жаль терять источник вдохновения. Этот выглядел особенно многообещающе». — Ашиок\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385868&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5f57124b-6a31-4044-a7bd-a28dbfb93a4f\', \'multiverseId\': 385868}, \'multiverseid\': 385868}, {\'name\': \'心之衰\', \'text\': \'目标牌手弃两张牌。\', \'type\': \'法术\', \'flavor\': \'「失去灵感的源泉，令我非常难过。尤其是这一个看上去大有可为。」 ～安梭苛\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383596&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1cd8b96e-c1de-4d0f-81bd-274300d95c20\', \'multiverseId\': 383596}, \'multiverseid\': 383596}, {\'name\': \'心之衰\', \'text\': \'目標玩家棄兩張牌。\', \'type\': \'巫術\', \'flavor\': \'「失去靈感的源泉，令我非常難過。尤其是這一個看上去大有可為。」 ～安梭苛\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383880&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'effe126d-fd3c-4d7a-8489-02457f7c5164\', \'multiverseId\': 383880}, \'multiverseid\': 383880}]', '[{\'name\': \'Geflüchteter Zauberer\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'„Recht und Gesetz gebührt ein angemessener Platz — als Fußnote in meinem Zauberbuch." —Siyani, geflüchtete Zauberin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384101&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c0e085fb-51e4-4323-8963-66cade2caeca\', \'multiverseId\': 384101}, \'multiverseid\': 384101}, {\'name\': \'Hechicero fugitivo\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'"La ley tiene su lugar: una nota al pie en mi libro de hechizos". —Siyani, maga fugitiva\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386089&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'454fca98-da2e-48d9-9242-98a42e2c20d4\', \'multiverseId\': 386089}, \'multiverseid\': 386089}, {\'name\': \'Sorcier fugitif\', \'type\': \'Créature : humain et sorcier\', \'flavor\': \'« La loi a sa place — en pied de page dans mon grimoire. » —Siyani, mage fugitive\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384385&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f6e93cc8-c903-483c-a2f7-aa3c1ea3dd86\', \'multiverseId\': 384385}, \'multiverseid\': 384385}, {\'name\': \'Mago Fuggitivo\', \'type\': \'Creatura — Mago Umano\', \'flavor\': \'"La legge ha il proprio posto... come annotazione nel mio libro delle magie." —Siyani, maga fuggitiva\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384669&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9ce9a233-2bf1-42b9-8dd2-556b2f8740a1\', \'multiverseId\': 384669}, \'multiverseid\': 384669}, {\'name\': \'脱走魔術師\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'法にも居場所がある。我が呪文書の脚注としてだがな。 ――脱走魔術師、シヤーニ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384953&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0e57bd6a-6e62-49d4-9a47-bc481b92c4ec\', \'multiverseId\': 384953}, \'multiverseid\': 384953}, {\'name\': \'도주 마법사\', \'type\': \'생물 — 인간 마법사\', \'flavor\': \'"그 법은 내 마법책에 각주로서 적혀있다." —도주 마법사 시야니\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385237&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6cd644be-e703-48ab-81b1-8a50d4123917\', \'multiverseId\': 385237}, \'multiverseid\': 385237}, {\'name\': \'Mago Fugitivo\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'"A lei tem seu lugar... como nota de rodapé no meu grimório." — Siyani, maga fugitiva\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385521&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f5d2b84a-d388-49c5-baba-eb794fef5491\', \'multiverseId\': 385521}, \'multiverseid\': 385521}, {\'name\': \'Чародей-Изгнанник\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'«У закона есть свое место. И это место — примечание в моей книге заклинаний». — Сияни, беглая волшебница\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385805&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a6c53d8c-1881-4851-bbb2-8e4dd1eb89e4\', \'multiverseId\': 385805}, \'multiverseid\': 385805}, {\'name\': \'漂泊法术师\', \'type\': \'生物～人类／法术师\', \'flavor\': \'「要说法律的地位，大概就是我咒语书的附注吧。」 ～漂泊法师西亚妮\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383533&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b394dc3f-6894-44b4-bdc2-3c63040b703b\', \'multiverseId\': 383533}, \'multiverseid\': 383533}, {\'name\': \'漂泊魔法師\', \'type\': \'生物～人類／魔法師\', \'flavor\': \'「要說法律的地位，大概就是我咒語書的附註吧。」 ～漂泊法師西亞妮\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383817&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ed7120b3-7fad-45de-a283-81abccdf2fff\', \'multiverseId\': 383817}, \'multiverseid\': 383817}]', '[{\'name\': \'Gefährliches Behältnis\', \'text\': \'{5}, {T}, schicke das Gefährliche Behältnis ins Exil: Schicke alle bleibenden Karten, die keine Länder sind, ins Exil.\', \'type\': \'Artefakt\', \'flavor\': \'Der Geisterdrache Ugin ordnete die Polyeder von Zendikar an, um Energieströme in Ley-Linien zu bündeln. Eine davon zu unterbrechen bedeutet, Vernichtung und Chaos zu entfesseln.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384194&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1128af6b-365b-4f2c-bc3a-49e2c454ef72\', \'multiverseId\': 384194}, \'multiverseid\': 384194}, {\'name\': \'Bóveda peligrosa\', \'text\': \'{5}, {T}, exiliar la Bóveda peligrosa: Exilia todos los permanentes que no sean tierra.\', \'type\': \'Artefacto\', \'flavor\': \'El dragón espíritu Ugin organizó los edros de Zendikar para canalizar líneas místicas de energía. Manipular uno de ellos es desatar la devastación y el caos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386182&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'58fae277-5952-470d-b165-7dfaf9f27bd1\', \'multiverseId\': 386182}, \'multiverseid\': 386182}, {\'name\': \'Caveau du péril\', \'text\': \'{5}, {T}, exilez le Caveau du péril : Exilez tous les permanents non-terrain.\', \'type\': \'Artefact\', \'flavor\': "Ugin le dragon-esprit orienta les hèdrons de Zendikar pour canaliser les lignes ley d\'énergie. En perturber un déclencherait dévastation et chaos.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384478&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'eb8b6376-02ad-40c1-88bd-43f26e464306\', \'multiverseId\': 384478}, \'multiverseid\': 384478}, {\'name\': \'Ricettacolo Pericoloso\', \'text\': \'{5}, {T}, Esilia il Ricettacolo Pericoloso: Esilia tutti i permanenti non terra.\', \'type\': \'Artefatto\', \'flavor\': \'Lo spirito drago Ugin dispose gli edri di Zendikar per incanalarne le leyline energetiche. Disturbarne uno significa scatenare devastazione e caos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384762&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d03e0f9e-d5ab-4c6a-b9df-192064fb4be1\', \'multiverseId\': 384762}, \'multiverseid\': 384762}, {\'name\': \'危険な櫃\', \'text\': \'{5}, {T}, 危険な櫃を追放する：すべての土地でないパーマネントを追放する。\', \'type\': \'アーティファクト\', \'flavor\': \'精霊ドラゴン、ウギンはエネルギーの力線を誘導させるためにゼンディカーの面晶体を編成した。それを乱すことは、破壊と混乱を解き放つことを意味する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385046&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'caccbb23-6b59-41d9-94c2-2ea51abf20f4\', \'multiverseId\': 385046}, \'multiverseid\': 385046}, {\'name\': \'위험한 저장고\', \'text\': \'{5}, {T}, 위험한 저장고를 추방한다: 모든 대지가 아닌 지속물을 추방한다.\', \'type\': \'마법물체\', \'flavor\': \'신령 용 우진은 힘의 수맥을 이끌기 위해 젠디카르의 헤드론들을 배열하였다. 하나라도 잘못되면 황폐화와 혼돈을 불러일으킬 것이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385330&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b5488c4a-0a40-40ab-876b-81de5d459bb7\', \'multiverseId\': 385330}, \'multiverseid\': 385330}, {\'name\': \'Câmara Perigosa\', \'text\': \'{5}, {T}, Exile Câmara Perigosa: Exile todas as permanentes que não sejam terrenos.\', \'type\': \'Artefato\', \'flavor\': \'O espírito dragão Ugin organizou os edros de Zendikar para direcionar a energia das linhas de força. Destruir um significa liberar devastação e caos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385614&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f4805185-1137-46c5-a24a-2d591327dbbe\', \'multiverseId\': 385614}, \'multiverseid\': 385614}, {\'name\': \'Опасное Хранилище\', \'text\': \'{5}, {T}, изгоните Опасное Хранилище: изгоните все не являющиеся землями перманенты.\', \'type\': \'Артефакт\', \'flavor\': \'Дракон-дух Уджин расположил эдры Зендикара так, чтобы они направляли потоки энергии. Если потревожить хотя бы один из них, разразится хаос разрушения.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385898&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'43793e74-505e-4357-89d9-9b7d2dccd8cb\', \'multiverseId\': 385898}, \'multiverseid\': 385898}, {\'name\': \'险恶贮窖\', \'text\': \'{5}，{T}，放逐险恶贮窖：放逐所有非地永久物。\', \'type\': \'神器\', \'flavor\': \'赞迪卡每一块晶石的位置都经过灵龙乌金的仔细调整，以引导地脉之中的能量流动。打乱其中一块就会引发灾难与混乱。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383626&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'869847a7-f8af-4737-b829-4a0632d2da39\', \'multiverseId\': 383626}, \'multiverseid\': 383626}, {\'name\': \'險惡儲窖\', \'text\': \'{5}，{T}，放逐險惡儲窖：放逐所有非地永久物。\', \'type\': \'神器\', \'flavor\': \'贊迪卡每一塊晶石的位置都經過靈龍烏金的仔細調整，以引導地脈之中的能量流動。打亂其中一塊就會引發災難與混亂。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383910&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d3c376f6-aa48-411f-8401-964dff9537bb\', \'multiverseId\': 383910}, \'multiverseid\': 383910}]', "[{'name': 'Gehorsam ohne Ende', 'text': 'Einberufen (Deine Kreaturen können dir helfen, diesen Zauberspruch zu wirken. Jede Kreatur, die du tappst, während du diesen Zauberspruch wirkst, reduziert dessen Kosten um {1} oder um ein Mana der Farbe jener Kreatur.)\\nBringe eine Kreaturenkarte deiner Wahl aus einem Friedhof unter deiner Kontrolle ins Spiel.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384083&type=card', 'language': 'German', 'identifiers': {'scryfallId': '6867f2a8-73c5-4c2c-9e2e-6de6caa37875', 'multiverseId': 384083}, 'multiverseid': 384083}, {'name': 'Obediencia eterna', 'text': 'Convocar. (Tus criaturas pueden ayudar a lanzar este hechizo. Cada criatura que gires al lanzar este hechizo cuenta como un pago de {1} o de un maná del color de esa criatura.)\\nPon en el campo de batalla bajo tu control la carta de criatura objetivo de un cementerio.', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386071&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'f1fe55eb-73c0-4456-a607-86d7eaf63f09', 'multiverseId': 386071}, 'multiverseid': 386071}, {'name': 'Obéissance perpétuelle', 'text': 'Convocation (Vos créatures peuvent aider à lancer ce sort. Chaque créature que vous engagez en lançant ce sort paie {1} ou un mana de la couleur de cette créature.)\\nMettez sur le champ de bataille, sous votre contrôle, une carte de créature ciblée depuis un cimetière.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384367&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'dbe014c9-fd02-41e0-904f-2bb84a5193e7', 'multiverseId': 384367}, 'multiverseid': 384367}, {'name': 'Obbedienza Eterna', 'text': 'Convocazione (Le tue creature possono aiutarti a lanciare questa magia. Ogni creatura che TAPpi mentre lanci questa magia corrisponde al pagamento di {1} o di un mana del colore di quella creatura.)\\nMetti sul campo di battaglia sotto il tuo controllo una carta creatura bersaglio da un cimitero.', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384651&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'd7041c60-fa62-49d0-a340-cd677160f062', 'multiverseId': 384651}, 'multiverseid': 384651}, {'name': '終わりなき従順', 'text': '召集（あなたのクリーチャーが、この呪文を唱える助けとなる。この呪文を唱える段階であなたがタップした各クリーチャーは、{1}かそのクリーチャーの色のマナ１点を支払う。）\\n墓地にあるクリーチャー・カード１枚を対象とし、それをあなたのコントロール下で戦場に出す。', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384935&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ecb9672e-9cac-4661-ab53-f35c9eadad52', 'multiverseId': 384935}, 'multiverseid': 384935}, {'name': '끝없는 복종', 'text': '집합 (당신의 생물들은 이 주문을 발동하는 것을 도울 수 있다. 이 주문을 발동할 때 탭하는 생물 한 개당 이 주문의 비용은 {1} 또는 그 생물의 색인 마나 한 개만큼 줄어든다.)\\n무덤에 있는 생물 카드를 목표로 정한다. 그 생물 카드를 당신의 조종하에 전장에 놓는다.', 'type': '집중마법', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385219&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'bdaeef37-d108-4f25-83a5-f9f3fa571a23', 'multiverseId': 385219}, 'multiverseid': 385219}, {'name': 'Obediência Sem Fim', 'text': 'Convocar (Suas criaturas podem ajudar a conjurar esta mágica. Cada criatura que você vira ao conjurar esta mágica paga {1} ou um mana da cor daquela criatura.)\\nColoque o card de criatura alvo de um cemitério no campo de batalha sob o seu controle.', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385503&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'bc311772-2b18-4849-9bbb-c33374b51c32', 'multiverseId': 385503}, 'multiverseid': 385503}, {'name': 'Бесконечное Повиновение', 'text': 'Созыв (Ваши существа могут помочь разыграть это заклинание. Каждое существо, которое вы поворачиваете при разыгрывании этого заклинания, считается оплатой {1} или одной маны цвета того существа.)\\nПоложите целевую карту существа из кладбища на поле битвы под вашим контролем.', 'type': 'Волшебство', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385787&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '6b2c1128-de31-4f71-9c9d-0795ebd31b2f', 'multiverseId': 385787}, 'multiverseid': 385787}, {'name': '无尽服从', 'text': '召集（此咒语能用你的生物来协助施放。你于施放此咒语时每横置一个生物，就能为此咒语支付{1}或一点该生物颜色之法术力。）\\n将目标生物牌在你的操控下从坟墓场放进战场。', 'type': '法术', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383515&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '52236351-f4f3-47dc-9cc4-bb9a942d80aa', 'multiverseId': 383515}, 'multiverseid': 383515}, {'name': '無盡服從', 'text': '召集（此咒語能用你的生物來協助施放。你於施放此咒語時每橫置一個生物，就能為此咒語支付{1}或一點該生物顏色之魔法力。）\\n將目標生物牌在你的操控下從墳墓場放進戰場。', 'type': '巫術', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383799&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '75aa876a-e812-49ad-ad8a-0aaa15359d6a', 'multiverseId': 383799}, 'multiverseid': 383799}]", '[{\'name\': \'Geisterbund\', \'text\': \'Immer wenn eine Nichtspielsteinkreatur unter deiner Kontrolle ins Spiel kommt, kannst du {W} bezahlen. Falls du dies tust, bringe einen 1/1 weißen Geist-Kreaturenspielstein mit Flugfähigkeit ins Spiel.\\n{1}{W}, opfere einen Geist: Eine Nicht-Geist-Kreatur deiner Wahl erhält Unzerstörbarkeit bis zum Ende des Zuges. (Schaden und Effekte, die „zerstören", zerstören sie nicht.)\', \'type\': \'Verzauberung\', \'flavor\': \'Nach einer Idee von Justin Gary\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384247&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4357a677-1a8f-466b-8acd-a61e7407c23b\', \'multiverseId\': 384247}, \'multiverseid\': 384247}, {\'name\': \'Vínculos espirituales\', \'text\': \'Siempre que una criatura que no sea ficha entre al campo de batalla bajo tu control, puedes pagar {W}. Si lo haces, pon en el campo de batalla una ficha de criatura Espíritu blanca 1/1 con la habilidad de volar.\\n{1}{W}, sacrificar un Espíritu: La criatura objetivo que no sea Espíritu gana la habilidad de indestructible hasta el final del turno. (El daño y los efectos que dicen "destruir" no la destruyen.)\', \'type\': \'Encantamiento\', \'flavor\': \'Diseñada por Justin Gary\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386235&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'734b2f51-f07b-49b4-a9e9-a466de7b1f17\', \'multiverseId\': 386235}, \'multiverseid\': 386235}, {\'name\': \'Liens spirituels\', \'text\': "À chaque fois qu\'une créature non-jeton arrive sur le champ de bataille sous votre contrôle, vous pouvez payer {W}. Si vous faites ainsi, mettez sur le champ de bataille un jeton de créature 1/1 blanche Esprit avec le vol.\\n{1}{W}, sacrifiez un esprit : La créature non-Esprit ciblée acquiert l\'indestructible jusqu\'à la fin du tour. (Les blessures et les effets qui disent « détruisez » ne la détruisent pas.)", \'type\': \'Enchantement\', \'flavor\': \'Conçue par Justin Gary\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384531&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'916e1261-dfdd-4ab3-9947-5071890708e0\', \'multiverseId\': 384531}, \'multiverseid\': 384531}, {\'name\': \'Vincoli dello Spirito\', \'text\': \'Ogniqualvolta una creatura non pedina entra nel campo di battaglia sotto il tuo controllo, puoi pagare {W}. Se lo fai, metti sul campo di battaglia una pedina creatura Spirito 1/1 bianca con volare.\\n{1}{W}, Sacrifica uno Spirito: Una creatura non Spirito bersaglio ha indistruttibile fino alla fine del turno. (Il danno e gli effetti che dicono "distruggi" non la distruggono.)\', \'type\': \'Incantesimo\', \'flavor\': \'Ideata da Justin Gary\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384815&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a1d5b5ac-5ae6-4eef-8086-26b8459a1512\', \'multiverseId\': 384815}, \'multiverseid\': 384815}, {\'name\': \'霊魂の絆\', \'text\': \'トークンでないクリーチャーが１体あなたのコントロール下で戦場に出るたび、あなたは{W}を支払ってもよい。そうしたなら、飛行を持つ白の１/１のスピリット・クリーチャー・トークンを１体戦場に出す。\\n{1}{W}, スピリットを１体生け贄に捧げる：スピリットでないクリーチャー１体を対象とする。それはターン終了時まで破壊不能を得る。（ダメージや「破壊する」と書かれた効果では、それは破壊されない。）\', \'type\': \'エンチャント\', \'flavor\': \'デザイン：Justin Gary\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385099&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'62ecbb47-d143-43a9-8e17-88821fed2941\', \'multiverseId\': 385099}, \'multiverseid\': 385099}, {\'name\': \'정신 결합\', \'text\': \'토큰이 아닌 생물이 당신의 조종하에 전장에 들어올 때마다, 당신은 {W}를 지불할 수 있다. 그렇게 한다면, 비행을 가진 1/1 백색 신령 생물 토큰 한 개를 전장에 놓는다.\\n{1}{W}, 신령 한 개를 희생한다: 신령이 아닌 생물을 목표로 정한다. 그 생물은 턴종료까지 무적을 얻는다. (피해와 "파괴"라고 명시된 효과로 파괴되지 않는다.)\', \'type\': \'부여마법\', \'flavor\': \'디자인: Justin Gary\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385383&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'bf6b8d8a-c2a6-4296-8c9a-645264d44d86\', \'multiverseId\': 385383}, \'multiverseid\': 385383}, {\'name\': \'Laços Espirituais\', \'text\': \'Toda vez que uma criatura que não seja ficha entra no campo de batalha sob seu controle, você pode pagar {W}. Se fizer isso, coloque no campo de batalha uma ficha de criatura branca 1/1 do tipo Espírito com voar.\\n{1}{W}, Sacrifique um Espírito: A criatura alvo que não seja Espírito ganha indestrutível até o final do turno. (O dano e os efeitos que dizem "destrua" não a destroem.)\', \'type\': \'Encantamento\', \'flavor\': \'Criado por Justin Gary\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385667&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5c4e7154-d38f-4046-a32e-c225f420be0e\', \'multiverseId\': 385667}, \'multiverseid\': 385667}, {\'name\': \'Духовные Узы\', \'text\': \'Каждый раз, когда не являющееся фишкой существо выходит на поле битвы под вашим контролем, вы можете заплатить {W}. Если вы это делаете, положите на поле битвы одну фишку существа 1/1 белый Дух с Полетом.\\n{1}{W}, пожертвуйте Духа: целевое не являющееся Духом существо получает Неразрушимость до конца хода. (Повреждения и эффекты с указанием «уничтожьте» не уничтожают его.)\', \'type\': \'Чары\', \'flavor\': \'Автор карты: Джастин Гэри\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385951&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'682f20cf-185c-486f-b4f8-2d63f1b272ca\', \'multiverseId\': 385951}, \'multiverseid\': 385951}, {\'name\': \'魂灵系绊\', \'text\': \'每当一个非衍生物的生物在你的操控下进战场时，你可以支付{W}。若你如此作，则将一个1/1白色，具飞行异能的精怪衍生生物放进战场。\\n{1}{W}，牺牲一个精怪：目标非精怪的生物获得不灭异能直到回合结束。（伤害与注明「消灭」的效应不会将它消灭。）\', \'type\': \'结界\', \'flavor\': \'设计者：Justin Gary\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383679&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'09508a7c-efee-4188-8065-adac37329877\', \'multiverseId\': 383679}, \'multiverseid\': 383679}, {\'name\': \'魂靈繫絆\', \'text\': \'每當一個非衍生物的生物在你的操控下進戰場時，你可以支付{W}。若你如此作，則將一個1/1白色，具飛行異能的精靈衍生生物放進戰場。\\n{1}{W}，犧牲一個精靈：目標非精靈的生物獲得不滅異能直到回合結束。（傷害與註明「消滅」的效應不會將它消滅。)\', \'type\': \'結界\', \'flavor\': \'設計者：Justin Gary\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383963&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5e35b711-4760-44d7-b406-0c44be4689c9\', \'multiverseId\': 383963}, \'multiverseid\': 383963}]', '[{\'name\': \'Gekennzeichnet durch Ehre\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur erhält +2/+2 und hat Wachsamkeit. (Sie wird beim Angreifen nicht getappt.)\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Auf dem Posten zu bleiben, ist Pflichterfüllung. Seine Stellung zu behaupten, ist Ehrensache.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384155&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9d4055ff-0a50-4965-9829-c93900af414c\', \'multiverseId\': 384155}, \'multiverseid\': 384155}, {\'name\': \'Marcado por el honor\', \'text\': \'Encantar criatura.\\nLa criatura encantada obtiene +2/+2 y tiene la habilidad de vigilancia. (Esta criatura no se gira al atacar.)\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'Mantente en tu puesto por deber. Mantente firme por honor.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386143&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'558d2c0d-dceb-407b-b598-97eabc7e7326\', \'multiverseId\': 386143}, \'multiverseid\': 386143}, {\'name\': "Marqué par l\'honneur", \'text\': "Enchanter : créature\\nLa créature enchantée gagne +2/+2 et a la vigilance. (Attaquer avec cette créature ne la fait pas s\'engager.)", \'type\': \'Enchantement : aura\', \'flavor\': "Défendez votre poste par devoir. Défendez votre position pour l\'honneur.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384439&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'378e4e49-ab79-441b-9b0f-72c1fd6fab87\', \'multiverseId\': 384439}, \'multiverseid\': 384439}, {\'name\': "Marchio dell\'Onore", \'text\': \'Incanta creatura\\nLa creatura incantata prende +2/+2 e ha cautela. (Attacca senza TAPpare.)\', \'type\': \'Incantesimo — Aura\', \'flavor\': "Resisti alla stanchezza per senso del dovere. Resisti al nemico per senso dell\'onore.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384723&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'94b10697-64d9-4c03-a2c1-94b973a7de32\', \'multiverseId\': 384723}, \'multiverseid\': 384723}, {\'name\': \'名誉の印\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは、＋２/＋２の修整を受けるとともに警戒を持つ。（それは攻撃してもタップしない。）\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'任務のために持ち場につけ。名誉のために持ちこたえろ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385007&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7976ae52-6699-4558-b923-2d8ca250122d\', \'multiverseId\': 385007}, \'multiverseid\': 385007}, {\'name\': \'명예의 표식\', \'text\': \'생물에게 부여\\n부여된 생물은 +2/+2를 받고 경계를 가진다. (그 생물은 공격하면서 탭되지 않는다.)\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'각자의 근무 지역을 떠나지 마라. 명예를 가지고 지켜라.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385291&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'349d0339-3a05-4100-9a51-b94ec69c64fe\', \'multiverseId\': 385291}, \'multiverseid\': 385291}, {\'name\': \'Marcado pela Honra\', \'text\': \'Encantar criatura\\nA criatura encantada recebe +2/+2 e tem vigilância. (Esta criatura não é virada para atacar.)\', \'type\': \'Encantamento — Aura\', \'flavor\': \'Mantenha-se no posto por dever. Mantenha-se firme pela honra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385575&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d66c6d7a-528c-4b5b-9f11-4615e1614740\', \'multiverseId\': 385575}, \'multiverseid\': 385575}, {\'name\': \'Отмеченный Честью\', \'text\': \'Зачаровать существо\\nЗачарованное существо получает +2/+2 и имеет Бдительность. (Атакуя, оно не поворачивается.)\', \'type\': \'Чары — Аура\', \'flavor\': \'Стой на своем посту во имя долга. Оставайся незыблем во имя чести.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385859&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6eca4483-de79-4eb2-b743-c16191ffd795\', \'multiverseId\': 385859}, \'multiverseid\': 385859}, {\'name\': \'荣誉标记\', \'text\': \'结附于生物\\n所结附的生物得+2/+2且具有警戒异能。（它攻击时不需横置。）\', \'type\': \'结界～灵气\', \'flavor\': \'因职责而守卫。为荣誉而守护。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383587&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e10f73c9-5479-4f93-a5f1-837073893f00\', \'multiverseId\': 383587}, \'multiverseid\': 383587}, {\'name\': \'榮譽標記\', \'text\': \'結附於生物\\n所結附的生物得+2/+2且具有警戒異能。（它攻擊時不需橫置。）\', \'type\': \'結界～靈氣\', \'flavor\': \'因職責而守衛。為榮譽而守護。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383871&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'32024dbd-326d-4ff8-b3c1-eb278a33e4d6\', \'multiverseId\': 383871}, \'multiverseid\': 383871}]', "[{'name': 'Generatordiener', 'text': '{T}, opfere den Generatordiener: Erhöhe deinen Manavorrat um {2}. Falls dieses Mana für einen Kreaturenzauber verwendet wird, erhält diese Kreatur Eile bis zum Ende des Zuges. (Diese Kreatur kann angreifen und {T}, sobald sie unter deine Kontrolle kommt.)', 'type': 'Kreatur — Elementarwesen', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384106&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f81530d1-466f-4010-bcaa-333b85cf2bec', 'multiverseId': 384106}, 'multiverseid': 384106}, {'name': 'Sirviente generador', 'text': '{T}, sacrificar el Sirviente generador: Agrega {2} a tu reserva de maná. Si ese maná se usa en un hechizo de criatura, esa criatura gana la habilidad de prisa hasta el final del turno. (Esa criatura puede atacar y {T} tan pronto como entra bajo tu control.)', 'type': 'Criatura — Elemental', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386094&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'f4e2ba9c-ed52-475d-984d-4266dbeb51d3', 'multiverseId': 386094}, 'multiverseid': 386094}, {'name': 'Servant du générateur', 'text': '{T}, sacrifiez le Servant du générateur : Ajoutez {2} à votre réserve. Si ce mana est dépensé pour un sort de créature, cette créature acquiert la célérité. (Cette créature peut attaquer et {T} dès le tour où elle arrive sous votre contrôle.)', 'type': 'Créature : élémental', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384390&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b1af3837-b846-42cd-b092-33c9e7494f1f', 'multiverseId': 384390}, 'multiverseid': 384390}, {'name': 'Servo Generatore', 'text': '{T}, Sacrifica il Servo Generatore: Aggiungi {2} alla tua riserva di mana. Se quel mana viene speso per una magia creatura, quella creatura ha rapidità fino alla fine del turno. (Quella creatura può attaccare e {T} non appena entra sotto il tuo controllo.)', 'type': 'Creatura — Elementale', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384674&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '26bfffaa-a253-411d-a586-fef6d95f4d98', 'multiverseId': 384674}, 'multiverseid': 384674}, {'name': '発生器の召使い', 'text': '{T}, 発生器の召使いを生け贄に捧げる：あなたのマナ・プールに{2}を加える。このマナがクリーチャー・呪文のために使用されたなら、そのクリーチャーはターン終了時まで速攻を得る。（そのクリーチャーは、あなたのコントロール下になってすぐに攻撃したり{T}したりできる。）', 'type': 'クリーチャー — エレメンタル', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384958&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9a5251f6-c412-49df-bc5d-3f0865cbc1f9', 'multiverseId': 384958}, 'multiverseid': 384958}, {'name': '발전기 하수인', 'text': '{T}, 발전기 하수인을 희생한다: {2}를 당신의 마나풀에 담는다. 그 마나가 생물 주문에 지불된다면, 그 생물은 턴종료까지 신속을 얻는다. (그 생물은 당신의 조종하에 들어오자마자 공격하거나 {T}할 수 있다.)', 'type': '생물 — 정령', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385242&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '0efae050-5181-460f-9a0b-46f75a242f49', 'multiverseId': 385242}, 'multiverseid': 385242}, {'name': 'Servo Gerador', 'text': '{T}, Sacrifique Servo Gerador: Adicione {2} à sua reserva de mana. Se esse mana for gasto em uma mágica de criatura, ela ganha ímpeto até o final do turno. (A criatura pode atacar e {T} assim que passa ao seu controle.)', 'type': 'Criatura — Elemental', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385526&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0efa2a9c-7542-4a28-8f92-cfe6d326456d', 'multiverseId': 385526}, 'multiverseid': 385526}, {'name': 'Слуга-Генератор', 'text': '{T}, пожертвуйте Слугу-Генератор: добавьте {2} в ваше хранилище маны. Если та мана тратится на заклинание существа, то существо получает Ускорение до конца хода. (Оно может атаковать и {T}, как только оно попадает под ваш контроль.)', 'type': 'Существо — Элементаль', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385810&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'fc2354a2-5ca3-47ca-8c24-164bc2a92cf5', 'multiverseId': 385810}, 'multiverseid': 385810}, {'name': '电机仆役', 'text': '{T}，牺牲电机仆役：加{2}到你的法术力池中。如果该法术力用以支付生物咒语，则该生物获得敏捷异能直到回合结束。（该生物受你操控时便能攻击与{T}。）', 'type': '生物～元素', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383538&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9ff28ebf-ec03-4017-9379-4738deeab205', 'multiverseId': 383538}, 'multiverseid': 383538}, {'name': '電機僕役', 'text': '{T}，犧牲電機僕役：加{2}到你的魔法力池中。如果該魔法力用以支付生物咒語，則該生物獲得敏捷異能直到回合結束。（該生物受你操控時便能攻擊與{T}。）', 'type': '生物～元素', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383822&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'f943c949-7458-404e-9418-f415d7275c4b', 'multiverseId': 383822}, 'multiverseid': 383822}]", '[{\'name\': \'Genesis-Hydra\', \'text\': \'Wenn du die Genesis-Hydra wirkst, decke die obersten X Karten deiner Bibliothek auf. Du kannst davon eine bleibende Karte mit umgewandelte Manakosten von X oder weniger, die kein Land ist, ins Spiel bringen. Mische dann den Rest in deine Bibliothek.\\nDie Genesis-Hydra kommt mit X +1/+1-Marken ins Spiel.\', \'type\': \'Kreatur — Pflanze, Hydra\', \'flavor\': \'Nach einer Idee von George Fan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384107&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'eee384d9-ee82-48e5-a5d7-9de21e06fa75\', \'multiverseId\': 384107}, \'multiverseid\': 384107}, {\'name\': \'Hidra del génesis\', \'text\': \'Cuando lances la Hidra del génesis, muestra las X primeras cartas de tu biblioteca. Puedes poner en el campo de batalla una carta de permanente que no sea tierra con coste de maná convertido de X o menos que se encuentre entre ellas. Luego baraja el resto en tu biblioteca.\\nLa Hidra del génesis entra al campo de batalla con X contadores +1/+1 sobre ella.\', \'type\': \'Criatura — Hidra planta\', \'flavor\': \'Diseñada por George Fan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386095&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'78927d44-898d-493a-a988-1621a1ef31d1\', \'multiverseId\': 386095}, \'multiverseid\': 386095}, {\'name\': \'Hydre de genèse\', \'text\': "Quand vous lancez l\'Hydre de genèse, révélez les X cartes du dessus de votre bibliothèque. Parmi elles, vous pouvez mettre sur le champ de bataille une carte de permanent non-terrain de coût converti de mana inférieur ou égal à X. Mélangez ensuite le reste dans votre bibliothèque.\\nL\'Hydre de genèse arrive sur le champ de bataille avec X marqueurs +1/+1 sur elle.", \'type\': \'Créature : plante et hydre\', \'flavor\': \'Conçue par George Fan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384391&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1e57ea26-f3fd-46cb-a69f-b7b14dfba0f5\', \'multiverseId\': 384391}, \'multiverseid\': 384391}, {\'name\': \'Idra della Genesi\', \'text\': "Quando lanci l\'Idra della Genesi, rivela le prime X carte del tuo grimorio. Puoi mettere sul campo di battaglia una carta permanente non terra con costo di mana convertito pari o inferiore a X scelta tra esse. Poi rimescola le altre nel tuo grimorio.\\nL\'Idra della Genesi entra nel campo di battaglia con X segnalini +1/+1.", \'type\': \'Creatura — Idra Pianta\', \'flavor\': \'Ideata da George Fan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384675&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0beb8037-7be2-4f10-a022-bebb2a0e290f\', \'multiverseId\': 384675}, \'multiverseid\': 384675}, {\'name\': \'起源のハイドラ\', \'text\': \'あなたが起源のハイドラを唱えたとき、あなたのライブラリーの一番上からＸ枚のカードを公開する。あなたはその中の点数で見たマナ・コストがＸ以下である土地でないパーマネント・カードを１枚戦場に出してもよい。その後、残りをあなたのライブラリーに加えて切り直す。\\n起源のハイドラは、＋１/＋１カウンターがＸ個置かれた状態で戦場に出る。\', \'type\': \'クリーチャー — 植物・ハイドラ\', \'flavor\': \'デザイン：George Fan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384959&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ad31c4f3-b8e2-4376-97fa-a6cb4f0e1abc\', \'multiverseId\': 384959}, \'multiverseid\': 384959}, {\'name\': \'창조 히드라\', \'text\': \'당신이 창조 히드라를 발동할 때, 당신의 서고 맨 위의 카드 X장을 공개한다. 당신은 그 카드 중에서 전환마나비용이 X 이하이며 대지가 아닌 지속물 카드 한 장을 전장에 놓을 수 있다. 그런 다음 나머지 카드들은 당신의 서고에 섞어 넣는다.\\n창조 히드라는 +1/+1 카운터 X개를 가진 채로 전장에 들어온다.\', \'type\': \'생물 — 식물 히드라\', \'flavor\': \'디자인: George Fan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385243&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f98d1930-11a6-4c3c-8f53-414bb285d330\', \'multiverseId\': 385243}, \'multiverseid\': 385243}, {\'name\': \'Hidra da Gênese\', \'text\': \'Quando você conjurar Hidra da Gênese, revele os X cards do topo do seu grimório. Você pode colocar um card de permanente que não seja terreno com custo de mana convertido menor ou igual a X dentre eles no campo de batalha. Depois, embaralhe o restante em seu grimório.\\nHidra da Gênese entra no campo de batalha com X marcadores +1/+1.\', \'type\': \'Criatura — Planta Hidra\', \'flavor\': \'Criado por George Fan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385527&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fc2fb9a6-ce1c-4638-b066-972dd4faa873\', \'multiverseId\': 385527}, \'multiverseid\': 385527}, {\'name\': \'Гидра Порождения\', \'text\': \'Когда вы разыгрываете Гидру Порождения, покажите X верхних карт вашей библиотеки. Вы можете положить на поле битвы находящуюся среди них карту не являющегося землей перманента с конвертированной мана-стоимостью не более X. Затем втасуйте остальные карты в вашу библиотеку.\\nГидра Порождения выходит на поле битвы с Х жетонами +1/+1 на ней.\', \'type\': \'Существо — Растение Гидра\', \'flavor\': \'Автор карты: Джордж Фэн\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385811&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'52f7c51f-78bc-4fa9-b773-8b682a02f0bc\', \'multiverseId\': 385811}, \'multiverseid\': 385811}, {\'name\': \'创生多头龙\', \'text\': \'当你施放创生多头龙时，展示你牌库顶的X张牌。你可以将其中一张总法术力费用等于或小于X的非地永久物牌放进战场。然后将其余的牌洗入你的牌库。\\n创生多头龙进战场时上面有X个+1/+1指示物。\', \'type\': \'生物～植物／多头龙\', \'flavor\': \'设计者：George Fan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383539&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'96641b64-908b-42f6-997b-2f7ca8c96b56\', \'multiverseId\': 383539}, \'multiverseid\': 383539}, {\'name\': \'創生多頭龍\', \'text\': \'當你施放創生多頭龍時，展示你牌庫頂的X張牌。你可以將其中一張總魔法力費用等於或小於X的非地永久物牌放進戰場。然後將其餘的牌洗入你的牌庫。\\n創生多頭龍進戰場時上面有X個+1/+1指示物。\', \'type\': \'生物～植物／多頭龍\', \'flavor\': \'設計者：George Fan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383823&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'689f3fdd-5701-4df1-99a5-a1b5f8f116af\', \'multiverseId\': 383823}, \'multiverseid\': 383823}]', '[{\'name\': \'Gesegneter Angriff\', \'text\': \'Kreaturen, die du kontrollierst, erhalten +2/+1 bis zum Ende des Zuges. Weiße Kreaturen, die du kontrollierst, erhalten außerdem bis zum Ende des Zuges Erstschlag. (Sie fügen Kampfschaden vor Kreaturen ohne Erstschlag zu.)\', \'type\': \'Spontanzauber\', \'flavor\': \'Du brauchst bloß deinen Speer zu erheben, um diesen Segen zu erhalten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384222&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4cfa7806-dce6-41cb-99c9-72277b7d856e\', \'multiverseId\': 384222}, \'multiverseid\': 384222}, {\'name\': \'Carga santificada\', \'text\': \'Las criaturas que controlas obtienen +2/+1 hasta el final del turno. Las criaturas blancas que controlas ganan además la habilidad de dañar primero hasta el final del turno. (Hacen daño de combate antes que las criaturas sin la habilidad de dañar primero.)\', \'type\': \'Instantáneo\', \'flavor\': \'Solo has de alzar tu lanza para recibir esta bendición.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386210&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'40dc6bc2-1811-481a-992a-6e2849bbf292\', \'multiverseId\': 386210}, \'multiverseid\': 386210}, {\'name\': \'Charge sanctifiée\', \'text\': "Les créatures que vous contrôlez gagnent +2/+1 jusqu\'à la fin du tour. Les créatures blanches que vous contrôlez acquièrent aussi l\'initiative jusqu\'à la fin du tour. (Elles infligent des blessures de combat avant les créatures sans l\'initiative.)", \'type\': \'Éphémère\', \'flavor\': \'Pour recevoir cette bénédiction, il suffit de lever sa lance.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384506&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6c84b1e2-04e9-4728-bfda-b373ffc81b86\', \'multiverseId\': 384506}, \'multiverseid\': 384506}, {\'name\': \'Carica Consacrata\', \'text\': \'Le creature che controlli prendono +2/+1 fino alla fine del turno. Le creature bianche che controlli hanno anche attacco improvviso fino alla fine del turno. (Infliggono danno da combattimento prima delle creature senza attacco improvviso.)\', \'type\': \'Istantaneo\', \'flavor\': \'Solleva la tua lancia e riceverai questa benedizione.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384790&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'65c270be-b011-40b8-8161-3919c79bc311\', \'multiverseId\': 384790}, \'multiverseid\': 384790}, {\'name\': \'清められた突撃\', \'text\': \'あなたがコントロールするクリーチャーは、ターン終了時まで＋２/＋１の修整を受ける。あなたがコントロールする白のクリーチャーは、さらにターン終了時まで先制攻撃を得る。（それらは先制攻撃を持たないクリーチャーよりも先に戦闘ダメージを与える。）\', \'type\': \'インスタント\', \'flavor\': \'この祝福を受けるには、槍を掲げるだけでよい。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385074&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b9f4d9c0-18d1-44df-b1f0-9d329b6178f9\', \'multiverseId\': 385074}, \'multiverseid\': 385074}, {\'name\': \'축복받은 돌격\', \'text\': \'당신이 조종하는 생물들은 턴종료까지 +2/+1을 받는다. 당신이 조종하는 백색 생물들은 턴종료까지 선제공격을 얻는다. (이 생물들은 선제공격이 없는 생물보다 먼저 전투피해를 입힌다.)\', \'type\': \'순간마법\', \'flavor\': \'창을 들기만 하면 이 축복을 받을 수 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385358&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e882544e-ce70-45bc-aa32-cbd63c73de9a\', \'multiverseId\': 385358}, \'multiverseid\': 385358}, {\'name\': \'Investida Santificada\', \'text\': \'As criaturas que você controla recebem +2/+1 até o final do turno. As criaturas brancas que você controla também ganham iniciativa até o final do turno. (Elas causam dano de combate antes das criaturas sem iniciativa.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Você só precisa erguer sua lança para receber esta bênção.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385642&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4ca0bee0-9990-46d2-83d7-06b8adc6f7fc\', \'multiverseId\': 385642}, \'multiverseid\': 385642}, {\'name\': \'Освященная Атака\', \'text\': \'Существа под вашим контролем получают +2/+1 до конца хода. Белые существа под вашим контролем также получают Первый удар до конца хода. (Они наносят боевые повреждения раньше существ без Первого удара.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Чтобы получить это благословение, нужно лишь поднять копье.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385926&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d6c6d07e-5d44-4d6c-bc74-069113ce6d62\', \'multiverseId\': 385926}, \'multiverseid\': 385926}, {\'name\': \'净圣冲锋\', \'text\': \'由你操控的生物得+2/+1直到回合结束。由你操控的白色生物再获得先攻异能直到回合结束。（它们会比不具先攻异能的生物提前造成战斗伤害。）\', \'type\': \'瞬间\', \'flavor\': \'端起长矛，便得祝福。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383654&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'857cc042-2664-45aa-a20d-5c2a249a3b80\', \'multiverseId\': 383654}, \'multiverseid\': 383654}, {\'name\': \'淨聖衝鋒\', \'text\': \'由你操控的生物得+2/+1直到回合結束。由你操控的白色生物再獲得先攻異能直到回合結束。（它們會比不具先攻異能的生物提前造成戰鬥傷害。）\', \'type\': \'瞬間\', \'flavor\': \'端起長矛，便得祝福。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383938&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fd60e5b4-5930-4295-995a-357eed99eec4\', \'multiverseId\': 383938}, \'multiverseid\': 383938}]', '[{\'name\': \'Gift-Remasuri\', \'text\': \'Remasuri-Kreaturen, die du kontrollierst, haben Todesberührung. (Eine beliebige Menge Schadenspunkte, die eine Kreatur mit Todesberührung einer Kreatur zufügt, sind ausreichend, um sie zu zerstören.)\', \'type\': \'Kreatur — Remasuri\', \'flavor\': \'„Wir führten unseren Angriff mit vergifteten Pfeilen. Die Remasuris, die daran nicht starben, begannen sich zu verändern." —Hastric, Thune-Späher\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384278&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'23c46dc3-aa65-4ba0-ab2e-92d942fa7f32\', \'multiverseId\': 384278}, \'multiverseid\': 384278}, {\'name\': \'Fragmentado venenoso\', \'text\': \'Las criaturas Fragmentado que controlas tienen la habilidad de toque mortal. (Cualquier cantidad de daño que una criatura con la habilidad de toque mortal haga a una criatura es suficiente para destruirla.)\', \'type\': \'Criatura — Fragmentado\', \'flavor\': \'"Atacamos con flechas untadas con veneno. Los fragmentados que no murieron comenzaron a cambiar". —Hastric, explorador de Thune\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386266&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'31210542-1c84-446e-a68b-c1460968b65d\', \'multiverseId\': 386266}, \'multiverseid\': 386266}, {\'name\': \'Slivoïde venimeux\', \'text\': "Les créatures Slivoïde que vous contrôlez ont le contact mortel. (Le nombre de blessures qu\'inflige une créature avec le contact mortel à une créature, quel qu\'il soit, est suffisant pour la détruire.)", \'type\': \'Créature : slivoïde\', \'flavor\': "« Nous les avons attaqués avec des flèches empoisonnées. Les slivoïdes qui n\'ont pas péri ont commencé à changer. » —Hastric, éclaireur thiunien", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384562&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'95aabae3-a16e-4b3d-a836-b7a09a0e1ce5\', \'multiverseId\': 384562}, \'multiverseid\': 384562}, {\'name\': \'Tramutante Venefico\', \'text\': \'Le creature Tramutante che controlli hanno tocco letale. (Qualsiasi danno che una creatura con tocco letale infligge a una creatura è sufficiente a distruggerla.)\', \'type\': \'Creatura — Tramutante\', \'flavor\': \'"Abbiamo attaccato con frecce avvelenate. I tramutanti sopravvissuti hanno cominciato a mutare." —Hastric, esploratore di Thune\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384846&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0fa0dc1c-0f43-4ee6-9faf-0863a8f67dfb\', \'multiverseId\': 384846}, \'multiverseid\': 384846}, {\'name\': \'毒牙スリヴァー\', \'text\': \'あなたがコントロールするスリヴァー・クリーチャーは接死を持つ。（接死を持つクリーチャーが何らかのダメージをクリーチャーに与えたら、それだけで破壊する。）\', \'type\': \'クリーチャー — スリヴァー\', \'flavor\': \'「我々は毒薬に浸した矢で攻撃した。死ななかったスリヴァーたちに変化が起こり始めた。」 ――テューンの斥候、ハストリック\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385130&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8ebf8519-d02b-4cc8-b662-2c3f4496795e\', \'multiverseId\': 385130}, \'multiverseid\': 385130}, {\'name\': \'맹독 슬리버\', \'text\': \'당신이 조종하는 슬리버 생물들은 치명타를 가진다. (치명타를 가진 생물에게 피해를 입은 생물은 입은 피해의 양에 상관없이 파괴된다.)\', \'type\': \'생물 — 슬리버\', \'flavor\': \'"우린 독화살로 슬리버들을 공격했다. 그러자 죽지 않은 놈들이 변하기 시작했다." —쑨의 정찰병 하스트릭\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385414&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9e0b1720-1b4d-4257-9e13-e22a58ee915d\', \'multiverseId\': 385414}, \'multiverseid\': 385414}, {\'name\': \'Fractius Peçonhento\', \'text\': \'As criaturas do tipo Fractius que você controla têm toque mortífero. (Qualquer quantidade de dano que uma criatura com toque mortífero cause a uma criatura é suficiente para destruí-la.)\', \'type\': \'Criatura — Fractius\', \'flavor\': \'"Nós atacamos com flechas envenenadas. Os fractius que não morreram começaram a mudar." — Hastric, batedor thuniano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385698&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f0f692ee-005d-43ff-a0c4-89b4d64accd2\', \'multiverseId\': 385698}, \'multiverseid\': 385698}, {\'name\': \'Ядоносная Щепка\', \'text\': \'Существа-Щепки под вашим контролем имеют Смертельное касание. (Любое количество повреждений, которое существо со Смертельным касанием наносит существу, достаточно, чтобы его уничтожить.)\', \'type\': \'Существо — Щепка\', \'flavor\': \'«Мы использовали стрелы с отравленными наконечниками. Оставшиеся в живых щепки начали изменяться». — Хастрик, тунский разведчик\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385982&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e4d537bb-4b97-4faf-9c01-4521fb494a90\', \'multiverseId\': 385982}, \'multiverseid\': 385982}, {\'name\': \'毒液裂片妖\', \'text\': \'由你操控的裂片妖生物具有死触异能。（具有死触异能的生物对生物造成的任何数量伤害都足以消灭后者。）\', \'type\': \'生物～裂片妖\', \'flavor\': \'「我们用淬毒的弓箭攻击，活下来的裂片妖开始发生变化。」 ～图恩斥候海司齐\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383710&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'294331b9-e491-4e34-bede-891ff283709b\', \'multiverseId\': 383710}, \'multiverseid\': 383710}, {\'name\': \'毒液裂片妖\', \'text\': \'由你操控的裂片妖生物具有死觸異能。（具有死觸異能的生物對生物造成的任何數量傷害都足以消滅後者。）\', \'type\': \'生物～裂片妖\', \'flavor\': \'「我們以淬毒的弓箭攻擊，活下來的裂片妖開始發生變化。」 ～圖恩斥候海司齊\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383994&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a8bb9a2a-ee76-438b-addd-94c278910e36\', \'multiverseId\': 383994}, \'multiverseid\': 383994}]', '[{\'name\': \'Gletscherschmetterer\', \'text\': \'Verursacht Trampelschaden (Falls diese Kreatur ihren Blockern genug Schaden zuweisen würde, um sie zu zerstören, kannst du sie den Rest des Schadens dem verteidigenden Spieler oder Planeswalker zuweisen lassen.)\\nDer Gletscherschmetterer kann nur angreifen, falls mindestens ein Gebirge im Spiel ist.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384108&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'37f1abad-08f9-4b9c-a594-b1bf85afd21a\', \'multiverseId\': 384108}, \'multiverseid\': 384108}, {\'name\': \'Aplastador glacial\', \'text\': \'Arrolla. (Si esta criatura fuera a asignar suficiente daño a sus bloqueadores como para destruirlos, puedes hacer que le asigne el resto del daño al jugador o planeswalker defensor.)\\nEl Aplastador glacial no puede atacar a menos que haya una montaña en el campo de batalla.\', \'type\': \'Criatura — Elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386096&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8c43f510-35e9-47b4-a611-48cde7844331\', \'multiverseId\': 386096}, \'multiverseid\': 386096}, {\'name\': \'Fracasseur glaciaire\', \'text\': "Piétinement (Si cette créature attribue suffisamment de blessures de combat à ses bloqueurs pour les détruire, vous pouvez faire qu\'elle attribue le reste de ses blessures au joueur ou au planeswalker défenseur.)\\nLe Fracasseur glaciaire ne peut pas attaquer à moins qu\'il n\'y ait au moins une montagne sur le champ de bataille.", \'type\': \'Créature : élémental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384392&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'372b7c20-cb60-4025-9f5a-e30044176a75\', \'multiverseId\': 384392}, \'multiverseid\': 384392}, {\'name\': \'Distruttore Glaciale\', \'text\': \'Travolgere (Se questa creatura sta per assegnare alle sue creature bloccanti danno sufficiente a distruggerle, puoi farle assegnare il resto del suo danno al giocatore in difesa o a un planeswalker.)\\nIl Distruttore Glaciale non può attaccare a meno che non ci sia una Montagna sul campo di battaglia.\', \'type\': \'Creatura — Elementale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384676&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d293cd85-d853-4be3-97a2-0b142c47bd15\', \'multiverseId\': 384676}, \'multiverseid\': 384676}, {\'name\': \'氷河の壊し屋\', \'text\': \'トランプル（このクリーチャーが、自身をブロックしているすべてのクリーチャーを破壊するのに十分なダメージを割り振ったなら、あなたはこれの残りのダメージを防御プレイヤーかプレインズウォーカーに割り振ってもよい。）\\n氷河の壊し屋は、戦場に山がないかぎり攻撃できない。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384960&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f2d4a61c-dd91-489e-8591-bfe8a7bbe50e\', \'multiverseId\': 384960}, \'multiverseid\': 384960}, {\'name\': \'빙하 파괴자\', \'text\': \'돌진 (이 생물이 자신을 방어하는 생물을 파괴하기에 충분한 피해를 배정했다면, 나머지 피해는 수비플레이어나 플레인즈워커에게 배정할 수 있다.)\\n빙하 파괴자는 전장에 산이 있어야만 공격할 수 있다.\', \'type\': \'생물 — 정령\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385244&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'11436f36-565d-4fda-acf4-6e8b0675c71d\', \'multiverseId\': 385244}, \'multiverseid\': 385244}, {\'name\': \'Esmagador Glacial\', \'text\': \'Atropelar (Se esta criatura for atribuir dano suficiente para destruir seus bloqueadores, você poderá fazer com que ela atribua o resto de seu dano ao planeswalker ou jogador defensor.)\\nEsmagador Glacial não pode atacar a menos que haja uma Montanha no campo de batalha.\', \'type\': \'Criatura — Elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385528&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c6310367-648c-4779-8a48-c48872cac451\', \'multiverseId\': 385528}, \'multiverseid\': 385528}, {\'name\': \'Ледниковый Крушитель\', \'text\': \'Пробивной удар (Если это существо распределяет достаточно повреждений, чтобы уничтожить блокирующие его существа, вы можете заставить его распределить оставшиеся повреждения защищающемуся игроку или planeswalker-у.)\\nЛедниковый Крушитель не может атаковать, если только на поле битвы нет Горы.\', \'type\': \'Существо — Элементаль\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385812&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'14a4a9a1-05f9-40af-adf0-e82ee4643a9b\', \'multiverseId\': 385812}, \'multiverseid\': 385812}, {\'name\': \'冰川粉碎灵\', \'text\': \'践踏（如果此生物将分配的伤害足以消灭所有阻挡它的生物，你可以将它所剩余数量的伤害分配给防御牌手或鹏洛客。）\\n除非战场上有山脉，否则冰川粉碎灵不能攻击。\', \'type\': \'生物～元素\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383540&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f161c7c9-2eb8-4df6-86e2-57b85cc29dfe\', \'multiverseId\': 383540}, \'multiverseid\': 383540}, {\'name\': \'冰川粉碎靈\', \'text\': \'踐踏（如果此生物將分配的傷害足以消滅所有阻擋它的生物，你可以將它所剩餘數量的傷害分配給防禦玩家或鵬洛客。）\\n除非戰場上有山脈，否則冰川粉碎靈不能攻擊。\', \'type\': \'生物～元素\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383824&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3b35e968-cf54-4a58-8b89-a1bbaaa835b5\', \'multiverseId\': 383824}, \'multiverseid\': 383824}]', '[{\'name\': \'Goblin-Bummspezialist\', \'text\': \'Bringe zu Beginn deines Versorgungssegments einen farblosen Artefaktspielstein namens Landmine ins Spiel mit „{R}, opfere dieses Artefakt: Dieses Artefakt fügt einer angreifenden nichtfliegenden Kreatur deiner Wahl 2 Schadenspunkte zu." Wirf danach eine Münze. Falls du den Münzwurf verlierst, fügt der Goblin-Bummspezialist sich selbst 2 Schadenspunkte zu.\', \'type\': \'Kreatur — Goblin, Krieger\', \'flavor\': \'Nach einer Idee von Stone Librande\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384109&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0ee0713f-c643-41a9-95ed-a06775c6c1f2\', \'multiverseId\': 384109}, \'multiverseid\': 384109}, {\'name\': \'Artillero trasgo\', \'text\': \'Al comienzo de tu mantenimiento, pon en el campo de batalla una ficha de artefacto incoloro llamada Mina terrestre con "{R}, sacrificar este artefacto: Este artefacto hace 2 puntos de daño a la criatura atacante objetivo sin la habilidad de volar". Después lanza una moneda a cara o cruz. Si pierdes el lanzamiento, el Artillero trasgo se hace 2 puntos de daño a sí mismo.\', \'type\': \'Criatura — Guerrero trasgo\', \'flavor\': \'Diseñada por Stone Librande\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386097&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'08711511-2f71-416a-9fb9-eed781a321c5\', \'multiverseId\': 386097}, \'multiverseid\': 386097}, {\'name\': \'Boumiste gobelin\', \'text\': "Au début de votre entretien, mettez sur le champ de bataille un jeton d\'artefact incolore appelé Mine terrestre avec « {R}, sacrifiez cet artefact : Cet artefact inflige 2 blessures à une créature attaquante sans le vol ciblée. » Jouez ensuite à pile ou face. Si vous perdez, le Boumiste gobelin s\'inflige 2 blessures.", \'type\': \'Créature : gobelin et guerrier\', \'flavor\': \'Conçue par Stone Librande\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384393&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'236db5d1-57fd-46db-9dd0-bbf542ba03cc\', \'multiverseId\': 384393}, \'multiverseid\': 384393}, {\'name\': \'Goblin Kaboom\', \'text\': \'All\\\'inizio del tuo mantenimento, metti sul campo di battaglia una pedina artefatto incolore chiamata Mina Terrestre con "{R}, Sacrifica questo artefatto: Questo artefatto infligge 2 danni a una creatura attaccante bersaglio senza volare". Poi lancia una moneta. Se perdi il lancio, il Goblin Kaboom infligge 2 danni a se stesso.\', \'type\': \'Creatura — Guerriero Goblin\', \'flavor\': \'Ideata da Stone Librande\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384677&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f3c2fd44-c036-4cad-af08-5ad2bf4230c2\', \'multiverseId\': 384677}, \'multiverseid\': 384677}, {\'name\': \'ゴブリンのドカーン物取扱者\', \'text\': \'あなたのアップキープの開始時に、「地雷」という名前の「{R}, このアーティファクトを生け贄に捧げる：飛行を持たない攻撃クリーチャー１体を対象とする。このアーティファクトはそれに２点のダメージを与える。」を持つ無色のアーティファクト・トークンを１つ戦場に出す。その後コイン投げをする。あなたがそのコイン投げに負けたなら、ゴブリンのドカーン物取扱者は自身に２点のダメージを与える。\', \'type\': \'クリーチャー — ゴブリン・戦士\', \'flavor\': \'デザイン：Stone Librande\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384961&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e91e85c6-a405-467f-816c-593ef74945f2\', \'multiverseId\': 384961}, \'multiverseid\': 384961}, {\'name\': \'고블린 쾅쾅이\', \'text\': \'당신의 유지단 시작에, 지상 지뢰라는 이름과 "{R}, 이 마법물체를 희생한다: 비행이 없는 공격생물을 목표로 정한다. 이 마법물체는 그 생물에게 피해 2점을 입힌다."를 가진 무색 마법물체 토큰 한 개를 전장에 놓는다. 그런 다음 동전 던지기를 한다. 동전 던지기에서 지면, 고블린 쾅쾅이는 자신에게 피해 2점을 입힌다.\', \'type\': \'생물 — 고블린 전사\', \'flavor\': \'디자인: Stone Librande\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385245&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7c118655-cd29-401b-b9b8-dc1a7102586d\', \'multiverseId\': 385245}, \'multiverseid\': 385245}, {\'name\': \'Goblin Cabumista\', \'text\': \'No início de sua manutenção, coloque no campo de batalha uma ficha de artefato incolor com o nome Mina Terrestre com "{R}, Sacrifique este artefato: Este artefato causa 2 pontos de dano à criatura alvo atacante sem voar." Depois, jogue uma moeda. Se você perder, Goblin Cabumista causará 2 pontos de dano a ele mesmo.\', \'type\': \'Criatura — Goblin Guerreiro\', \'flavor\': \'Criado por Stone Librande\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385529&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4ee268a4-a15d-4053-9a4b-af50a063ac73\', \'multiverseId\': 385529}, \'multiverseid\': 385529}, {\'name\': \'Гоблин-Бабашник\', \'text\': \'В начале вашего шага поддержки положите на поле битвы одну фишку бесцветного артефакта с именем Наземная Мина и способностью «{R}, пожертвуйте этот артефакт: этот артефакт наносит 2 повреждения целевому атакующему существу без Полета». Затем подбросьте монетку. Если вы проигрываете бросок, Гоблин-Бабашник наносит 2 повреждения сам себе.\', \'type\': \'Существо — Гоблин Воин\', \'flavor\': \'Автор карты: Стоун Либранде\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385813&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'09ec73b9-53f8-4044-9acb-0dcc95606e6a\', \'multiverseId\': 385813}, \'multiverseid\': 385813}, {\'name\': \'轰隆鬼怪\', \'text\': \'在你的维持开始时，将一个名称为地雷的无色衍生神器放进战场，且具有「{R}，牺牲此神器：此神器对目标进行攻击且不具飞行异能的生物造成2点伤害。」然后掷一枚硬币。如果你输掉此掷，轰隆鬼怪对本身造成2点伤害。\', \'type\': \'生物～鬼怪／战士\', \'flavor\': \'设计者：Stone Librande\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383541&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c20bee3a-aa2d-44d4-ad08-6230d8cd2a61\', \'multiverseId\': 383541}, \'multiverseid\': 383541}, {\'name\': \'轟隆鬼怪\', \'text\': \'在你的維持開始時，將一個名稱為地雷的無色衍生神器放進戰場，且具有「{R}，犧牲此神器：此神器對目標進行攻擊且不具飛行異能的生物造成2點傷害。」然後擲一枚硬幣。如果你輸掉此擲，轟隆鬼怪對本身造成2點傷害。\', \'type\': \'生物～鬼怪／戰士\', \'flavor\': \'設計者：Stone Librande\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383825&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6758c26c-6398-41b2-9791-c621fb89ace8\', \'multiverseId\': 383825}, \'multiverseid\': 383825}]', '[{\'name\': \'Goblin-Pöbeltreiber\', \'text\': \'Andere Goblin-Kreaturen, die du kontrollierst, greifen in jedem Zug an, falls möglich.\\nBringe zu Beginn des Kampfes in deinem Zug einen 1/1 roten Goblin-Kreaturenspielstein mit Eile ins Spiel.\\nImmer wenn der Goblin-Pöbeltreiber angreift, erhält er bis zum Ende des Zuges +1/+0 für jeden anderen angreifenden Goblin.\', \'type\': \'Kreatur — Goblin, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384110&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d4409d66-9924-4ff4-8356-e58a138b4d7f\', \'multiverseId\': 384110}, \'multiverseid\': 384110}, {\'name\': \'Agitador trasgo\', \'text\': \'Las otras criaturas Trasgo que controlas atacan cada turno si pueden.\\nAl comienzo del combate en tu turno, pon en el campo de batalla una ficha de criatura Trasgo roja 1/1 con la habilidad de prisa.\\nSiempre que el Agitador trasgo ataque, obtiene +1/+0 hasta el final del turno por cada uno de los otros Trasgos atacantes.\', \'type\': \'Criatura — Guerrero trasgo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386098&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e1358b7c-69b4-4d0e-8418-3dab0d39e9f1\', \'multiverseId\': 386098}, \'multiverseid\': 386098}, {\'name\': \'Maître plébéien gobelin\', \'text\': "Les autres créatures Gobelin que vous contrôlez attaquent à chaque tour si possible.\\nAu début du combat pendant votre tour, mettez sur le champ de bataille un jeton de créature 1/1 rouge Gobelin avec la célérité.\\nÀ chaque fois que le Maître plébéien gobelin attaque, il gagne +1/+0 jusqu\'à la fin du tour pour chaque autre gobelin attaquant.", \'type\': \'Créature : gobelin et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384394&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c68a103b-e5c3-4127-8227-84cbf0059b57\', \'multiverseId\': 384394}, \'multiverseid\': 384394}, {\'name\': \'Goblin Trascinatore di Folle\', \'text\': "Le altre creature Goblin che controlli attaccano ogni turno, se possono farlo.\\nAll\'inizio del combattimento nel tuo turno, metti sul campo di battaglia una pedina creatura Goblin 1/1 rossa con rapidità.\\nOgniqualvolta il Goblin Trascinatore di Folle attacca, prende +1/+0 fino alla fine del turno per ogni altro Goblin che attacca.", \'type\': \'Creatura — Guerriero Goblin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384678&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'df171dd1-d7de-45e1-bf5e-a57b0f6412df\', \'multiverseId\': 384678}, \'multiverseid\': 384678}, {\'name\': \'ゴブリンの熟練扇動者\', \'text\': \'あなたがコントロールする他のゴブリン・クリーチャーは、可能なら毎ターン攻撃する。\\nあなたのターンの戦闘の開始時に、速攻を持つ赤の１/１のゴブリン・クリーチャー・トークンを１体戦場に出す。\\nゴブリンの熟練扇動者が攻撃するたび、これはターン終了時まで、他の攻撃しているゴブリン１体につき＋１/＋０の修整を受ける。\', \'type\': \'クリーチャー — ゴブリン・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384962&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a10b64ee-5a26-4553-9f21-35448b1d0a28\', \'multiverseId\': 384962}, \'multiverseid\': 384962}, {\'name\': \'고블린 무리대장\', \'text\': \'당신이 조종하는 다른 고블린 생물들은 가능하면 매 턴마다 공격한다.\\n당신 턴의 전투 시작에, 신속을 가진 1/1 적색 고블린 생물 토큰 한 개를 전장에 놓는다.\\n고블린 무리대장이 공격할 때마다, 고블린 무리대장은 턴종료까지 공격하는 다른 고블린 한 개당 +1/+0을 받는다.\', \'type\': \'생물 — 고블린 전사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385246&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'549ac0c4-16ea-4df5-bb75-9e195ecf9d6e\', \'multiverseId\': 385246}, \'multiverseid\': 385246}, {\'name\': \'Goblin Líder da Plebe\', \'text\': \'As outras criaturas do tipo Goblin que você controla atacam a cada turno se estiverem aptas.\\nNo início do combate no seu turno, coloque no campo de batalha uma ficha de criatura vermelha 1/1 do tipo Goblin com ímpeto.\\nToda vez que Goblin Líder da Plebe ataca, ele recebe +1/+0 até o final do turno para cada outro Goblin atacante.\', \'type\': \'Criatura — Goblin Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385530&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4895fc57-1ee9-44c3-99e7-e2fc527f51ed\', \'multiverseId\': 385530}, \'multiverseid\': 385530}, {\'name\': \'Гоблин-Смутьян\', \'text\': \'Другие существа-Гоблины под вашим контролем атакуют в каждом ходу, если могут.\\nВ начале боя во время вашего хода положите на поле битвы одну фишку существа 1/1 красный Гоблин с Ускорением.\\nКаждый раз, когда Гоблин-Смутьян атакует, он получает +1/+0 до конца хода за каждого другого атакующего Гоблина.\', \'type\': \'Существо — Гоблин Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385814&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d995d6c0-aa4e-4ea6-913f-0d188b2b518e\', \'multiverseId\': 385814}, \'multiverseid\': 385814}, {\'name\': \'鬼怪闹事头\', \'text\': \'由你操控的其他鬼怪生物每回合若能攻击，则必须攻击。\\n在你回合的战斗开始时，将一个1/1红色，具敏捷异能的鬼怪衍生生物放进战场。\\n每当鬼怪闹事头攻击时，每有一个进行攻击的其他鬼怪，它便得+1/+0直到回合结束。\', \'type\': \'生物～鬼怪／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383542&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'67614ce3-35cc-4521-9a1b-61f82885108c\', \'multiverseId\': 383542}, \'multiverseid\': 383542}, {\'name\': \'鬼怪鬧事頭\', \'text\': \'由你操控的其他鬼怪生物每回合若能攻擊，則必須攻擊。\\n在你回合的戰鬥開始時，將一個1/1紅色，具敏捷異能的鬼怪衍生生物放進戰場。\\n每當鬼怪鬧事頭攻擊時，每有一個進行攻擊的其他鬼怪，它便得+1/+0直到回合結束。\', \'type\': \'生物～鬼怪／戰士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383826&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4d28126f-0143-4390-a323-ad4ff2069614\', \'multiverseId\': 383826}, \'multiverseid\': 383826}]', '[{\'name\': \'Goblin-Raureiter\', \'type\': \'Kreatur — Goblin, Ritter\', \'flavor\': \'Obwohl sein Reittier in alle Richtungen buckelte, schaffte es Gribble den Berg hinunter, und seine Brüder vom Grotag-Stamm jubelten. In diesem Moment war die Legende vom Skrill-Zähmer geboren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384111&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dd8bbb58-8d17-46ec-a995-2ffedd34536e\', \'multiverseId\': 384111}, \'multiverseid\': 384111}, {\'name\': \'Jinete audaz trasgo\', \'type\': \'Criatura — Caballero trasgo\', \'flavor\': \'A lomos de la enardecida criatura, Gribble bajó la ladera mientras sus compañeros grotag lo alentaban. En ese momento nació la leyenda del domador de skrill.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386099&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e4005411-44c2-423e-a716-bff1e6790c1f\', \'multiverseId\': 386099}, \'multiverseid\': 386099}, {\'name\': \'Dresseur gobelin\', \'type\': \'Créature : gobelin et chevalier\', \'flavor\': "À califourchon sur la créature qui ruait, Kloport dégringolait la montagne sous les acclamations de ses frères de la tribu Grotag. C\'est alors que naquit la légende du Dresseur de skrill.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384395&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5dd8300b-ee32-4d5f-943b-7aeae6977c30\', \'multiverseId\': 384395}, \'multiverseid\': 384395}, {\'name\': \'Goblin Domatore\', \'type\': \'Creatura — Cavaliere Goblin\', \'flavor\': "In sella a quella bestia saltellante, Gribble sfrecciò a tutta velocità nel dirupo della montagna, mentre i suoi fratelli Grotag lo acclamavano a gran voce. È stato in quell\'occasione che il mito del leggendario Domatore di Skrill ha avuto origine.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384679&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2a120c3b-ccf5-447c-8299-e90e5afb6611\', \'multiverseId\': 384679}, \'multiverseid\': 384679}, {\'name\': \'ゴブリンの荒くれ乗り\', \'type\': \'クリーチャー — ゴブリン・騎士\', \'flavor\': \'グロータグの仲間がはやし立てる中、グリブルは獣に置いた鞍にまたがり、山腹を駆け下りていった。伝説のスクリル使いの誕生の瞬間である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384963&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3f41ff1d-964c-4355-bb30-39b8657a9ca1\', \'multiverseId\': 384963}, \'multiverseid\': 384963}, {\'name\': \'어설픈 고블린 기수\', \'type\': \'생물 — 고블린 기사\', \'flavor\': \'그리블은 미친 듯이 저항하는 스크릴에 올라타 비탈길을 맹렬한 속도로 내려갔고, 그의 그로타그 형제들은 환호했다. 그렇게 전설은 시작되었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385247&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c14a658b-78a7-49f3-964b-8c1278e4715b\', \'multiverseId\': 385247}, \'multiverseid\': 385247}, {\'name\': \'Cavaleiro Valente Goblin\', \'type\': \'Criatura — Goblin Cavaleiro\', \'flavor\': \'Montado na arredia criatura, Gribble precipitou-se pela encosta da montanha enquanto seus colegas Grotag o encorajavam. Foi naquele momento que nasceu a lenda do Domador de Skrill.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385531&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6feff077-7d01-4e31-a24f-af1d0a72147e\', \'multiverseId\': 385531}, \'multiverseid\': 385531}, {\'name\': \'Гоблин-Берейтор\', \'type\': \'Существо — Гоблин Рыцарь\', \'flavor\': \'Сидя верхом на брыкающейся твари, Гриббл несся вниз по склону под дружное улюлюканье своих гротагских братьев. Так родилась легенда об Укротителе Скрилов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385815&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d3058dac-c1dc-459d-93f8-efa7b0f32a54\', \'multiverseId\': 385815}, \'multiverseid\': 385815}, {\'name\': \'鬼怪驯骑师\', \'type\': \'生物～鬼怪／骑士\', \'flavor\': \'革力伯跨坐在牲口上，沿着山坡冲下去，他的葛塔兄弟在一旁鼓噪着。嘶奇虫训练师的传说就此诞生。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383543&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2bfa183e-0be0-4f7b-b91f-cb4f42a6d89b\', \'multiverseId\': 383543}, \'multiverseid\': 383543}, {\'name\': \'鬼怪馴騎師\', \'type\': \'生物～鬼怪／騎士\', \'flavor\': \'革力伯跨坐在牲口上，沿著山坡衝下去，他的葛塔兄弟在一旁鼓譟著。嘶奇蟲訓練師的傳說就此誕生。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383827&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'25b683ca-394e-4e70-8f88-f058aa22b74a\', \'multiverseId\': 383827}, \'multiverseid\': 383827}]', "[{'name': 'Grausame Sadistin', 'text': '{B}, {T}, bezahle 1 Lebenspunkt: Lege eine +1/+1-Marke auf die Grausame Sadistin.\\n{2}{B}, {T}, entferne X +1/+1-Marken von der Grausamen Sadistin: Die Grausame Sadistin fügt einer Kreatur deiner Wahl X Schadenspunkte zu.', 'type': 'Kreatur — Mensch, Assassine', 'flavor': 'Antlitz der Unschuld. Hand des Todes. Nach einer Idee von Edmund McMillen', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384073&type=card', 'language': 'German', 'identifiers': {'scryfallId': '54b5a242-7cfd-4b61-b176-c8c057b6660b', 'multiverseId': 384073}, 'multiverseid': 384073}, {'name': 'Sádica cruel', 'text': '{B}, {T}, pagar 1 vida: Pon un contador +1/+1 sobre la Sádica cruel.\\n{2}{B}, {T}, remover X contadores +1/+1 de la Sádica cruel: La Sádica cruel hace X puntos de daño a la criatura objetivo.', 'type': 'Criatura — Asesino humano', 'flavor': 'Rostro inocente. Mano mortal. Diseñada por Edmund McMillen', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386061&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '827ad834-5a56-4590-ab4a-5861ffbf67f2', 'multiverseId': 386061}, 'multiverseid': 386061}, {'name': 'Cruelle sadique', 'text': '{B}, {T}, payez 1 point de vie : Mettez un marqueur +1/+1 sur la Cruelle sadique.\\n{2}{B}, {T}, retirez X marqueurs +1/+1 de la Cruelle sadique : La Cruelle sadique inflige X blessures à une créature ciblée.', 'type': 'Créature : humain et assassin', 'flavor': 'Un visage innocent. Une main meurtrière. Conçue par Edmund McMillen', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384357&type=card', 'language': 'French', 'identifiers': {'scryfallId': '9b1ad890-9f0c-4435-b1e8-1c6237a27539', 'multiverseId': 384357}, 'multiverseid': 384357}, {'name': 'Sadica Crudele', 'text': '{B}, {T}, Paga 1 punto vita: Metti un segnalino +1/+1 sulla Sadica Crudele.\\n{2}{B}, {T}, Rimuovi X segnalini +1/+1 dalla Sadica Crudele: La Sadica Crudele infligge X danni a una creatura bersaglio.', 'type': 'Creatura — Assassino Umano', 'flavor': 'Viso innocente, mano letale. Ideata da Edmund McMillen', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384641&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '603b2cbf-b6bf-4c7a-b444-0d1dc2d14d51', 'multiverseId': 384641}, 'multiverseid': 384641}, {'name': '残酷なサディスト', 'text': '{B}, {T}, ライフを１点支払う：残酷なサディストの上に＋１/＋１カウンターを１個置く。\\n{2}{B}, {T}, 残酷なサディストの上から＋１/＋１カウンターをＸ個取り除く：クリーチャー１体を対象とする。残酷なサディストはそれにＸ点のダメージを与える。', 'type': 'クリーチャー — 人間・暗殺者', 'flavor': '天使の顔。死神の手。 デザイン：Edmund McMillen', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384925&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '057ba292-e309-4c54-887c-ee294f03a943', 'multiverseId': 384925}, 'multiverseid': 384925}, {'name': '잔인한 가학증 환자', 'text': '{B}, {T}, 생명 1점을 지불한다: 잔인한 가학증 환자에 +1/+1 카운터 한 개를 올려놓는다.\\n{2}{B}, {T}, 잔인한 가학증 환자에서 +1/+1 카운터 X개를 제거한다: 생물을 목표로 정한다. 잔인한 가학증 환자는 그 목표에게 피해 X점을 입힌다.', 'type': '생물 — 인간 암살자', 'flavor': '순진해 보이는 얼굴. 죽음을 부르는 손. 디자인: Edmund McMillen', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385209&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '424f9b10-464b-478c-a0cd-9fdb11fad324', 'multiverseId': 385209}, 'multiverseid': 385209}, {'name': 'Sádico Cruel', 'text': '{B}, {T}, Pague 1 ponto de vida: Coloque um marcador +1/+1 em Sádico Cruel.\\n{2}{B}, {T}, Remova X marcadores +1/+1 de Sádico Cruel: Sádico Cruel causa X pontos de dano à criatura alvo.', 'type': 'Criatura — Humano Assassino', 'flavor': 'Face da inocência. Mão da morte. Criado por Edmund McMillen', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385493&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7977ff5c-ed39-464e-a418-9dc908ec25f4', 'multiverseId': 385493}, 'multiverseid': 385493}, {'name': 'Жестокая Садистка', 'text': '{B}, {T}, заплатите 1 жизнь: положите один жетон +1/+1 на Жестокую Садистку.\\n{2}{B}, {T}, удалите X жетонов +1/+1 с Жестокой Садистки: Жестокая Садистка наносит X повреждений целевому существу.', 'type': 'Существо — Человек Убийца', 'flavor': 'Невинное лицо. Рука, несущая смерть. Автор карты: Эдмунд Макмиллен', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385777&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'dca32d1d-ebb1-4873-b5b9-294a9d2f1fba', 'multiverseId': 385777}, 'multiverseid': 385777}, {'name': '残酷凌虐狂', 'text': '{B}，{T}，支付1点生命：在残酷凌虐狂上放置一个+1/+1指示物。\\n{2}{B}，{T}，从残酷凌虐狂上移去X个+1/+1指示物：残酷凌虐狂对目标生物造成X点伤害。', 'type': '生物～人类／杀手', 'flavor': '天真无邪的脸。挥舞死亡的手。 设计者：Edmund McMillen', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383505&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'bf0e7dc5-c953-4ab9-a94f-d88abffd7966', 'multiverseId': 383505}, 'multiverseid': 383505}, {'name': '殘酷凌虐狂', 'text': '{B}，{T}，支付1點生命：在殘酷凌虐狂上放置一個+1/+1指示物。\\n{2}{B}，{T}，從殘酷凌虐狂上移去X個+1/+1指示物：殘酷凌虐狂對目標生物造成X點傷害。', 'type': '生物～人類／殺手', 'flavor': '天真無邪的臉。揮舞死亡的手。 設計者：Edmund McMillen', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383789&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '58dc6873-8dd0-4bad-9ecc-ec6f5909a7dd', 'multiverseId': 383789}, 'multiverseid': 383789}]", '[{\'name\': \'Grenzland-Marodeurin\', \'text\': \'Immer wenn die Grenzland-Marodeurin angreift, erhält sie +2/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': \'Auch wenn sie zu Recht gefürchtet wird, gibt es kaum Geschichten über ihr Kampfgeschick, denn die wenigsten überleben ihre Überfälle.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384047&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'30e4e873-3e20-4b21-ad6b-0ee015e41773\', \'multiverseId\': 384047}, \'multiverseid\': 384047}, {\'name\': \'Merodeadora fronteriza\', \'text\': \'Siempre que la Merodeadora fronteriza ataque, obtiene +2/+0 hasta el final del turno.\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': \'Aunque es temida —y con razón—, no abundan las historias de sus hazañas en batalla, ya que pocos sobreviven a sus incursiones.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386035&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a41fe3cb-bf31-4c99-a66e-63c08e69919e\', \'multiverseId\': 386035}, \'multiverseid\': 386035}, {\'name\': \'Maraudeuse des frontières\', \'text\': "À chaque fois que la Maraudeuse des frontières attaque, elle gagne +2/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : humain et guerrier\', \'flavor\': "Elle inspire une crainte justifiée mais n\'apparaît guère dans les récits des bardes : ses raids laissent trop peu de témoins.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384331&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ed10a935-bb9d-426c-91e7-9c779b5dd639\', \'multiverseId\': 384331}, \'multiverseid\': 384331}, {\'name\': \'Predatrice delle Terre di Confine\', \'text\': \'Ogniqualvolta la Predatrice delle Terre di Confine attacca, prende +2/+0 fino alla fine del turno.\', \'type\': \'Creatura — Guerriero Umano\', \'flavor\': \'Per quanto sia giustamente temuta, i resoconti delle sue imprese in battaglia sono rari, poiché sono in pochi a sopravvivere alle sue razzie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384615&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0cf43005-6711-42c9-97fb-76314b3849b5\', \'multiverseId\': 384615}, \'multiverseid\': 384615}, {\'name\': \'国境地帯の匪賊\', \'text\': \'国境地帯の匪賊が攻撃するたび、これはターン終了時まで＋２/＋０の修整を受ける。\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': \'彼女は確かに恐れられているものの、実は戦いでの活躍を物語る逸話はあまり多くない。それは彼女の襲撃を生き延びることができた者がとても少ないからである。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384899&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bee191a6-1f60-4197-ba83-16fbef430962\', \'multiverseId\': 384899}, \'multiverseid\': 384899}, {\'name\': \'국경지대 약탈자\', \'text\': \'국경지대 약탈자가 공격할 때마다, 국경지대 약탈자는 턴종료까지 +2/+0을 받는다.\', \'type\': \'생물 — 인간 전사\', \'flavor\': \'그녀가 공포의 대상인 것은 당연하지만, 그녀의 손에서 살아남은 이들이 거의 없기에, 그녀의 전장 무용담은 비교적 적은 편이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385183&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7197053a-4a7a-42c7-a0b2-1041786ebf97\', \'multiverseId\': 385183}, \'multiverseid\': 385183}, {\'name\': \'Saqueador da Fronteira\', \'text\': \'Toda vez que Saqueador da Fronteira ataca, ele recebe +2/+0 até o final do turno.\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': \'Apesar dela ser justamente temida, há poucas histórias sobre seus feitos em batalha, pois poucos sobrevivem a seus assaltos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385467&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a11091ec-1a51-420d-bca5-a99a85974062\', \'multiverseId\': 385467}, \'multiverseid\': 385467}, {\'name\': \'Пограничная Грабительница\', \'text\': \'Каждый раз, когда Пограничная Грабительница атакует, она получает +2/+0 до конца хода.\', \'type\': \'Существо — Человек Воин\', \'flavor\': \'Ее имя вызывает заслуженный страх, но о ее деяниях в бою известно достаточно мало, потому что немногим удается пережить ее налет.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385751&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ed941950-1a3d-4475-9ac2-12e1424772f7\', \'multiverseId\': 385751}, \'multiverseid\': 385751}, {\'name\': \'边境劫掠者\', \'text\': \'每当边境劫掠者攻击时，它得+2/+0直到回合结束。\', \'type\': \'生物～人类／战士\', \'flavor\': \'虽然她确实令人畏惧，但其战斗事迹却鲜有流传，因为没人能活过她的突袭。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383479&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'49fededa-fd8d-480e-9c88-6f69b1aabe9a\', \'multiverseId\': 383479}, \'multiverseid\': 383479}, {\'name\': \'邊境劫掠者\', \'text\': \'每當邊境劫掠者攻擊時，它得+2/+0直到回合結束。\', \'type\': \'生物～人類／戰士\', \'flavor\': \'雖然她確實令人畏懼，但其戰鬥事跡卻鮮有流傳，因為沒人能活過她的突襲。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383763&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c5bc380f-977b-479f-9fb5-415250e22aeb\', \'multiverseId\': 383763}, \'multiverseid\': 383763}]', '[{\'name\': \'Gunst der Menge\', \'text\': \'Einberufen (Deine Kreaturen können dir helfen, diesen Zauberspruch zu wirken. Jede Kreatur, die du tappst, während du diesen Zauberspruch wirkst, reduziert dessen Kosten um {1} oder um ein Mana der Farbe jener Kreatur.)\\nEine Kreatur deiner Wahl erhält +1/+0 und Erstschlag bis zum Ende des Zuges. (Sie fügt Kampfschaden vor Kreaturen ohne Erstschlag zu.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384071&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'280c1a9d-33fd-4d13-8d00-cb5458355b6a\', \'multiverseId\': 384071}, \'multiverseid\': 384071}, {\'name\': \'Favor del público\', \'text\': \'Convocar. (Tus criaturas pueden ayudar a lanzar este hechizo. Cada criatura que gires al lanzar este hechizo cuenta como un pago de {1} o de un maná del color de esa criatura.)\\nLa criatura objetivo obtiene +1/+0 y gana la habilidad de dañar primero hasta el final del turno. (Hace daño de combate antes que las criaturas sin la habilidad de dañar primero.)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386059&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'24564c24-e9c4-4aba-aa9f-e1fd3e75007b\', \'multiverseId\': 386059}, \'multiverseid\': 386059}, {\'name\': \'Faveur de la foule\', \'text\': "Convocation (Vos créatures peuvent aider à lancer ce sort. Chaque créature que vous engagez en lançant ce sort paie {1} ou un mana de la couleur de cette créature.)\\nLa créature ciblée gagne +1/+0 et acquiert l\'initiative jusqu\'à la fin du tour. (Elle inflige des blessures de combat avant les créatures sans l\'initiative.)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384355&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'aaa61de0-34b6-40d4-9634-6fbfceb16958\', \'multiverseId\': 384355}, \'multiverseid\': 384355}, {\'name\': \'Favore della Folla\', \'text\': \'Convocazione (Le tue creature possono aiutarti a lanciare questa magia. Ogni creatura che TAPpi mentre lanci questa magia corrisponde al pagamento di {1} o di un mana del colore di quella creatura.)\\nUna creatura bersaglio prende +1/+0 e ha attacco improvviso fino alla fine del turno. (Infligge danno da combattimento prima delle creature senza attacco improvviso.)\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384639&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f1239bee-502d-458e-8e97-f5fa46c46ae1\', \'multiverseId\': 384639}, \'multiverseid\': 384639}, {\'name\': \'民衆の好意\', \'text\': \'召集（あなたのクリーチャーが、この呪文を唱える助けとなる。この呪文を唱える段階であなたがタップした各クリーチャーは、{1}かそのクリーチャーの色のマナ１点を支払う。）\\nクリーチャー１体を対象とする。それはターン終了時まで＋１/＋０の修整を受けるとともに先制攻撃を得る。（それは先制攻撃を持たないクリーチャーよりも先に戦闘ダメージを与える。）\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384923&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7387cfee-da72-4781-9412-efc080061967\', \'multiverseId\': 384923}, \'multiverseid\': 384923}, {\'name\': \'민중의 사랑\', \'text\': \'집합 (당신의 생물들은 이 주문을 발동하는 것을 도울 수 있다. 이 주문을 발동할 때 탭하는 생물 한 개당 이 주문의 비용은 {1} 또는 그 생물의 색인 마나 한 개만큼 줄어든다.)\\n생물을 목표로 정한다. 그 생물은 턴종료까지 +1/+0을 받고 선제공격을 얻는다. (이 생물은 선제공격이 없는 생물보다 먼저 전투피해를 입힌다.)\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385207&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6277fcd7-49aa-48cd-bf50-23465ef7a4aa\', \'multiverseId\': 385207}, \'multiverseid\': 385207}, {\'name\': \'Favoritismo do Público\', \'text\': \'Convocar (Suas criaturas podem ajudar a conjurar esta mágica. Cada criatura que você vira ao conjurar esta mágica paga {1} ou um mana da cor daquela criatura.)\\nA criatura alvo recebe +1/+0 e ganha iniciativa até o final do turno. (Ela causa dano de combate antes das criaturas sem iniciativa.)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385491&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f01508d8-0487-412c-a51e-7dfafc19e247\', \'multiverseId\': 385491}, \'multiverseid\': 385491}, {\'name\': \'Благосклонность Толпы\', \'text\': \'Созыв (Ваши существа могут помочь разыграть это заклинание. Каждое существо, которое вы поворачиваете при разыгрывании этого заклинания, считается оплатой {1} или одной маны цвета того существа.)\\nЦелевое существо получает +1/+0 и Первый удар до конца хода. (Оно наносит боевые повреждения раньше существ без Первого удара.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385775&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'58b750a4-a368-4f91-b0e9-a4111a21805b\', \'multiverseId\': 385775}, \'multiverseid\': 385775}, {\'name\': \'群众眷宠\', \'text\': \'召集（此咒语能用你的生物来协助施放。你于施放此咒语时每横置一个生物，就能为此咒语支付{1}或一点该生物颜色之法术力。）\\n直到回合结束，目标生物得+1/+0且获得先攻异能。（它会比不具先攻异能的生物提前造成战斗伤害。）\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383503&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'eefc857c-e0e9-4e69-899d-ace049133e0f\', \'multiverseId\': 383503}, \'multiverseid\': 383503}, {\'name\': \'群眾眷寵\', \'text\': \'召集（此咒語能用你的生物來協助施放。你於施放此咒語時每橫置一個生物，就能為此咒語支付{1}或一點該生物顏色之魔法力。）\\n直到回合結束，目標生物得+1/+0且獲得先攻異能。（它會比不具先攻異能的生物提前造成戰鬥傷害。）\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383787&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e6fa3dc0-72ee-4db7-a82d-f2a73284832d\', \'multiverseId\': 383787}, \'multiverseid\': 383787}]', '[{\'name\': \'Göttliche Gunst\', \'text\': \'Verzaubert eine Kreatur\\nWenn die Göttliche Gunst ins Spiel kommt, erhältst du 3 Lebenspunkte dazu.\\nDie verzauberte Kreatur erhält +1/+3.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Mit einem Arsenal aus Licht kann selbst ein Junker sein Volk anführen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384080&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7f45d914-f5fd-4197-b994-67158bcd704c\', \'multiverseId\': 384080}, \'multiverseid\': 384080}, {\'name\': \'Favor divino\', \'text\': \'Encantar criatura.\\nCuando el Favor divino entre al campo de batalla, ganas 3 vidas.\\nLa criatura encantada obtiene +1/+3.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'Armado con la luz, hasta el escudero podría defender a su gente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386068&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4d6f9ad3-1d6b-4172-811c-fb7ad695fece\', \'multiverseId\': 386068}, \'multiverseid\': 386068}, {\'name\': \'Faveur divine\', \'text\': \'Enchanter : créature\\nQuand la Faveur divine arrive sur le champ de bataille, vous gagnez 3 points de vie.\\nLa créature enchantée gagne +1/+3.\', \'type\': \'Enchantement : aura\', \'flavor\': "Avec l\'armurerie de la lumière, même une écuyère peut devenir la championne de son peuple.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384364&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3ec370fa-24c9-4c61-b64e-856bc09c34b2\', \'multiverseId\': 384364}, \'multiverseid\': 384364}, {\'name\': \'Benevolenza Divina\', \'text\': \'Incanta creatura\\nQuando la Benevolenza Divina entra nel campo di battaglia, guadagni 3 punti vita.\\nLa creatura incantata prende +1/+3.\', \'type\': \'Incantesimo — Aura\', \'flavor\': "Con un\'armeria di luce, perfino la scudiera può difendere il suo popolo.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384648&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'853defb8-87f4-4070-a83e-edc4b125c6c9\', \'multiverseId\': 384648}, \'multiverseid\': 384648}, {\'name\': \'神聖なる好意\', \'text\': \'エンチャント（クリーチャー）\\n神聖なる好意が戦場に出たとき、あなたは３点のライフを得る。\\nエンチャントされているクリーチャーは＋１/＋３の修整を受ける。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'光の武装をまとえば、従者ですら勇者となる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384932&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3fe42b84-34b4-456e-8a1e-5e9eddab83b6\', \'multiverseId\': 384932}, \'multiverseid\': 384932}, {\'name\': \'신의 은혜\', \'text\': \'생물에게 부여\\n신의 은혜가 전장에 들어올 때, 당신은 생명 3점을 얻는다.\\n부여된 생물은 +1/+3을 받는다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'빛으로 만든 갑옷을 입으면 일개 종자도 민중을 위해 싸우는 영웅이 될 수 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385216&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'978fd5bf-c506-4142-a42e-8063554ddffe\', \'multiverseId\': 385216}, \'multiverseid\': 385216}, {\'name\': \'Proteção Divina\', \'text\': \'Encantar criatura\\nQuando Proteção Divina entra no campo de batalha, você ganha 3 pontos de vida.\\nA criatura encantada recebe +1/+3.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'Com um arsenal de luz, até mesmo a escudeira pode defender seu povo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385500&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ff294532-e115-4f51-b22e-fd4bbbdbc25d\', \'multiverseId\': 385500}, \'multiverseid\': 385500}, {\'name\': \'Божественное Покровительство\', \'text\': \'Зачаровать существо\\nКогда Божественное Покровительство выходит на поле битвы, вы получаете 3 жизни.\\nЗачарованное существо получает +1/+3.\', \'type\': \'Чары — Аура\', \'flavor\': \'Вооруженный светом, даже оруженосец способен защитить свой народ.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385784&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f859c0ea-6117-461a-ad50-1e4c19034ab5\', \'multiverseId\': 385784}, \'multiverseid\': 385784}, {\'name\': \'上天眷顾\', \'text\': \'结附于生物\\n当上天眷顾进战场时，你获得3点生命。\\n所结附的生物得+1/+3。\', \'type\': \'结界～灵气\', \'flavor\': \'有明光作武装，就连个扈从都能成为同袍之光。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383512&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4577bdca-b154-4c0b-b0ef-f937ba0aff6e\', \'multiverseId\': 383512}, \'multiverseid\': 383512}, {\'name\': \'上天眷顧\', \'text\': \'結附於生物\\n當上天眷顧進戰場時，你獲得3點生命。\\n所結附的生物得+1/+3。\', \'type\': \'結界～靈氣\', \'flavor\': \'有明光作武裝，就連個扈從都能成為同袍之光。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383796&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0663c922-dd9d-44db-aad6-4e95ba565930\', \'multiverseId\': 383796}, \'multiverseid\': 383796}]', '[{\'name\': \'Göttliches Verdikt\', \'text\': \'Zerstöre eine angreifende oder blockende Kreatur deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Schuldig."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384015&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3afdc6ea-eeed-46d7-9b60-3f90e880f074\', \'multiverseId\': 384015}, \'multiverseid\': 384015}, {\'name\': \'Veredicto divino\', \'text\': \'Destruye la criatura atacante o bloqueadora objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Culpable."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386003&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'95937543-2451-4a38-a30a-7f67f3b4db8f\', \'multiverseId\': 386003}, \'multiverseid\': 386003}, {\'name\': \'Verdict divin\', \'text\': \'Détruisez la créature attaquante ou bloqueuse ciblée.\', \'type\': \'Éphémère\', \'flavor\': \'« Coupable. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384299&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2632f373-6018-4bee-b8d5-d21abaab0f4d\', \'multiverseId\': 384299}, \'multiverseid\': 384299}, {\'name\': \'Verdetto Divino\', \'text\': \'Distruggi una creatura attaccante o bloccante bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Colpevole."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384583&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bdc97127-014c-422c-9296-f328a859f088\', \'multiverseId\': 384583}, \'multiverseid\': 384583}, {\'name\': \'神聖なる評決\', \'text\': \'攻撃かブロックしているクリーチャー１体を対象とし、それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'「有罪。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384867&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'415731a6-2036-458a-b7a2-226e17b7ba64\', \'multiverseId\': 384867}, \'multiverseid\': 384867}, {\'name\': \'신의 판결\', \'text\': \'공격생물이나 방어생물을 목표로 정한다. 그 생물을 파괴한다.\', \'type\': \'순간마법\', \'flavor\': \'"유죄."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385151&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'33447329-055b-442f-bd65-db5d9a02929e\', \'multiverseId\': 385151}, \'multiverseid\': 385151}, {\'name\': \'Veredito Divino\', \'text\': \'Destrua a criatura atacante ou bloqueadora alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Culpado."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385435&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c368c63b-8230-434c-ab48-63a4ac67c449\', \'multiverseId\': 385435}, \'multiverseid\': 385435}, {\'name\': \'Божественный Приговор\', \'text\': \'Уничтожьте целевое атакующее или блокирующее существо.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Виновен».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385719&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b57ac617-1a19-4eed-a67f-f671eb4ccc4a\', \'multiverseId\': 385719}, \'multiverseid\': 385719}, {\'name\': \'明圣裁定\', \'text\': \'消灭目标进行攻击或阻挡的生物。\', \'type\': \'瞬间\', \'flavor\': \'「有罪。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383447&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'46985d6a-0d72-410e-9f04-1a4696836534\', \'multiverseId\': 383447}, \'multiverseid\': 383447}, {\'name\': \'明聖裁定\', \'text\': \'消滅目標進行攻擊或阻擋的生物。\', \'type\': \'瞬間\', \'flavor\': \'「有罪。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383731&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a60b6d1a-a389-45cb-87aa-2a97b62e62af\', \'multiverseId\': 383731}, \'multiverseid\': 383731}]', "[{'name': 'Hammerhand', 'text': 'Verzaubert eine Kreatur\\nWenn die Hammerhand ins Spiel kommt, kann eine Kreatur deiner Wahl in diesem Zug nicht blocken.\\nDie verzauberte Kreatur erhält +1/+1 und hat Eile. (Sie kann angreifen und {T}, egal wann sie unter deine Kontrolle gekommen ist.)', 'type': 'Verzauberung — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384114&type=card', 'language': 'German', 'identifiers': {'scryfallId': '8ea7fa2a-dad1-4f9d-951f-4bbf613c3c65', 'multiverseId': 384114}, 'multiverseid': 384114}, {'name': 'Mano de martillo', 'text': 'Encantar criatura.\\nCuando la Mano de martillo entre al campo de batalla, la criatura objetivo no puede bloquear este turno.\\nLa criatura encantada obtiene +1/+1 y tiene la habilidad de prisa. (Esta criatura puede atacar y {T} sin importar cuándo entró bajo tu control.)', 'type': 'Encantamiento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386102&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '99677e9b-995f-4209-9bd2-3f2fdfb3a7ad', 'multiverseId': 386102}, 'multiverseid': 386102}, {'name': 'Main à percussion', 'text': 'Enchanter : créature\\nQuand la Main à percussion arrive sur le champ de bataille, la créature ciblée ne peut pas bloquer ce tour-ci.\\nLa créature enchantée gagne +1/+1 et a la célérité. (Elle peut attaquer et {T} dès le tour où elle est arrivée sous votre contrôle.)', 'type': 'Enchantement : aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384398&type=card', 'language': 'French', 'identifiers': {'scryfallId': '9e1f3480-9ebf-4898-8729-8338c0bfd00e', 'multiverseId': 384398}, 'multiverseid': 384398}, {'name': 'Brachiomartello', 'text': 'Incanta creatura\\nQuando il Brachiomartello entra nel campo di battaglia, una creatura bersaglio non può bloccare in questo turno.\\nLa creatura incantata prende +1/+1 e ha rapidità. (Può attaccare e {T} non appena entra sotto il tuo controllo.)', 'type': 'Incantesimo — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384682&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '77f3072a-8f4a-4c43-b2e8-7bf0f04ee8f5', 'multiverseId': 384682}, 'multiverseid': 384682}, {'name': '槌手', 'text': 'エンチャント（クリーチャー）\\n槌手が戦場に出たとき、クリーチャー１体を対象とする。このターン、それではブロックできない。\\nエンチャントされているクリーチャーは、＋１/＋１の修整を受けるとともに速攻を持つ。（それがいつあなたのコントロール下になったかに関係なく、それは攻撃したり{T}したりできる。）', 'type': 'エンチャント — オーラ', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384966&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'cc884e3d-0469-425c-ba27-95cbe1604b55', 'multiverseId': 384966}, 'multiverseid': 384966}, {'name': '망치손', 'text': '생물에게 부여\\n망치손이 전장에 들어올 때, 생물을 목표로 정한다. 그 생물은 이 턴에 방어할 수 없다.\\n부여된 생물은 +1/+1을 받고 신속을 가진다. (부여된 생물은 당신의 조종하에 들어오자마자 공격하거나 {T}할 수 있다.)', 'type': '부여마법 — 마법진', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385250&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'fa53b341-a87f-44d4-9408-aa7fb4847d1d', 'multiverseId': 385250}, 'multiverseid': 385250}, {'name': 'Mão de Martelo', 'text': 'Encantar criatura\\nQuando Mão de Martelo entra no campo de batalha, a criatura alvo não pode bloquear neste turno.\\nA criatura encantada recebe +1/+1 e tem ímpeto. (Ela pode atacar e {T} independentemente de quando passou ao seu controle.)', 'type': 'Encantamento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385534&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'bf642849-b91d-4b85-a385-da6b4f3b804f', 'multiverseId': 385534}, 'multiverseid': 385534}, {'name': 'Стальной Кулак', 'text': 'Зачаровать существо\\nКогда Стальной Кулак выходит на поле битвы, целевое существо не может блокировать в этом ходу.\\nЗачарованное существо получает +1/+1 и имеет Ускорение. (Оно может атаковать и {T} вне зависимости от того, когда оно попало под ваш контроль.)', 'type': 'Чары — Аура', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385818&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'dc68d1f4-4b58-432b-8d60-6a2e95ab0616', 'multiverseId': 385818}, 'multiverseid': 385818}, {'name': '手力如锤', 'text': '结附于生物\\n当手力如锤进战场时，目标生物本回合不能进行阻挡。\\n所结附的生物得+1/+1且具有敏捷异能。（它不论是何时受你操控，都能攻击与{T}。）', 'type': '结界～灵气', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383546&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '19e0a8f6-5e7b-47a9-b97b-845a9b39aa3c', 'multiverseId': 383546}, 'multiverseid': 383546}, {'name': '手力如鎚', 'text': '結附於生物\\n當手力如鎚進戰場時，目標生物本回合不能進行阻擋。\\n所結附的生物得+1/+1並具有敏捷異能。（它不論是何時受你操控，都能攻擊與{T}。）', 'type': '結界～靈氣', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383830&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'b0abac75-3c1e-4b01-a6f9-f55528f511f1', 'multiverseId': 383830}, 'multiverseid': 383830}]", '[{\'name\': \'Heilige Rüstkammer\', \'text\': \'{2}: Eine Kreatur deiner Wahl erhält +1/+0 bis zum Ende des Zuges.\', \'type\': \'Artefakt\', \'flavor\': \'Komm her zum Beten. Geh fort, um in den Krieg zu ziehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384221&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6c7cb225-5422-4f71-8529-cff245b28819\', \'multiverseId\': 384221}, \'multiverseid\': 384221}, {\'name\': \'Armaduras sagradas\', \'text\': \'{2}: La criatura objetivo obtiene +1/+0 hasta el final del turno.\', \'type\': \'Artefacto\', \'flavor\': \'Se acude para la adoración. Se parte para la guerra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386209&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e83d52f8-3f1d-4fdc-b29e-23e4b2b3fd6a\', \'multiverseId\': 386209}, \'multiverseid\': 386209}, {\'name\': \'Armurerie sacrée\', \'text\': "{2} : La créature ciblée gagne +1/+0 jusqu\'à la fin du tour.", \'type\': \'Artefact\', \'flavor\': \'On y vient pour la prière. On en sort pour faire la guerre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384505&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a7ca3fb4-8d50-499e-a16f-e90a9b664468\', \'multiverseId\': 384505}, \'multiverseid\': 384505}, {\'name\': \'Armeria Sacra\', \'text\': \'{2}: Una creatura bersaglio prende +1/+0 fino alla fine del turno.\', \'type\': \'Artefatto\', \'flavor\': \'Giungi per una preghiera, parti per la guerra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384789&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'48feb529-20ec-4931-ab95-944bce23086c\', \'multiverseId\': 384789}, \'multiverseid\': 384789}, {\'name\': \'聖なる武器庫\', \'text\': \'{2}：クリーチャー１体を対象とする。それはターン終了時まで＋１/＋０の修整を受ける。\', \'type\': \'アーティファクト\', \'flavor\': \'崇拝のために来て、戦争のために去る。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385073&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5b24ea06-6703-42cd-8172-b8823dbf3206\', \'multiverseId\': 385073}, \'multiverseid\': 385073}, {\'name\': \'신성한 무기고\', \'text\': \'{2}: 생물을 목표로 정한다. 그 생물은 턴종료까지 +1/+0을 받는다.\', \'type\': \'마법물체\', \'flavor\': \'예배를 위해 오라. 전쟁을 위해 떠나라.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385357&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'89cb6daa-2d35-452c-8964-c231428d1b54\', \'multiverseId\': 385357}, \'multiverseid\': 385357}, {\'name\': \'Armaria Sagrada\', \'text\': \'{2}: A criatura alvo recebe +1/+0 até o final do turno.\', \'type\': \'Artefato\', \'flavor\': \'Chegue para adorar. Parta para a guerra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385641&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2d9b057d-da39-43bf-be58-35d7f884aebd\', \'multiverseId\': 385641}, \'multiverseid\': 385641}, {\'name\': \'Священный Арсенал\', \'text\': \'{2}: целевое существо получает +1/+0 до конца хода.\', \'type\': \'Артефакт\', \'flavor\': \'Приходи для поклонения. Уходи на войну.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385925&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6c764214-3a4e-4958-af41-3d4af2583c5e\', \'multiverseId\': 385925}, \'multiverseid\': 385925}, {\'name\': \'圣洁军械库\', \'text\': \'{2}：目标生物得+1/+0直到回合结束。\', \'type\': \'神器\', \'flavor\': \'因崇拜而来。为战事而去。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383653&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5b03b587-889d-4a1f-b1a1-a80ad2fc6a9e\', \'multiverseId\': 383653}, \'multiverseid\': 383653}, {\'name\': \'聖潔軍械庫\', \'text\': \'{2}：目標生物得+1/+0直到回合結束。\', \'type\': \'神器\', \'flavor\': \'因崇拜而來。為戰爭而去。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383937&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7d2e1bf5-d3c2-48ad-a0dc-48910ae66d00\', \'multiverseId\': 383937}, \'multiverseid\': 383937}]', '[{\'name\': \'Heiße Suppe\', \'text\': \'Die ausgerüstete Kreatur kann nicht geblockt werden.\\nImmer wenn der ausgerüsteten Kreatur Schaden zugefügt wird, zerstöre sie.\\nAusrüsten {3} ({3}: Lege diese Karte an eine Kreatur deiner Wahl an, die du kontrollierst. Spiele Ausrüsten wie eine Hexerei.)\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': \'„Vorsicht, heiß!" Nach einer Idee von James Ernest\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384121&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9781604c-43a4-489c-91d0-007ce7f57ed7\', \'multiverseId\': 384121}, \'multiverseid\': 384121}, {\'name\': \'Sopa caliente\', \'text\': \'La criatura equipada no puede ser bloqueada.\\nSiempre que la criatura equipada reciba daño, destrúyela.\\nEquipar {3}. ({3}: Anexa este equipo a la criatura objetivo que controlas. Activa la habilidad de equipar como un conjuro.)\', \'type\': \'Artefacto — Equipo\', \'flavor\': \'"¡Marchando!". Diseñada por James Ernest\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386109&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d3ec993c-5701-4840-91d1-baa635c00285\', \'multiverseId\': 386109}, \'multiverseid\': 386109}, {\'name\': \'Soupe bouillante\', \'text\': "La créature équipée ne peut pas être bloquée.\\nÀ chaque fois que la créature équipée subit des blessures, détruisez-la.\\nÉquipement {3} ({3} : Attachez à la créature ciblée que vous contrôlez. N\'attachez l\'équipement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Artefact : équipement\', \'flavor\': \'« Chaud devant ! » Conçue par James Ernest\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384405&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a4d2ddfa-8b68-47f8-b8d0-85b0bc33c200\', \'multiverseId\': 384405}, \'multiverseid\': 384405}, {\'name\': \'Zuppa Bollente\', \'text\': \'La creatura equipaggiata non può essere bloccata.\\nOgniqualvolta alla creatura equipaggiata viene inflitto danno, distruggila.\\nEquipaggiare {3} ({3}: Assegna a una creatura bersaglio che controlli. Equipaggia solo quando potresti lanciare una stregoneria.)\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': \'"Attenzione, scotta!" Ideata da James Ernest\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384689&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0a4f263c-c23f-4685-8d7b-4b074987713d\', \'multiverseId\': 384689}, \'multiverseid\': 384689}, {\'name\': \'熱いスープ\', \'text\': \'装備しているクリーチャーはブロックされない。\\n装備しているクリーチャーにダメージが与えられるたび、それを破壊する。\\n装備{3}（{3}：あなたがコントロールするクリーチャー１体を対象とし、これをつける。装備はソーサリーとしてのみ行う。）\', \'type\': \'アーティファクト — 装備品\', \'flavor\': \'「今から通るぞ！」 デザイン：James Ernest\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384973&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0fae12af-7d7f-46ee-a10c-44bcc3e743fe\', \'multiverseId\': 384973}, \'multiverseid\': 384973}, {\'name\': \'뜨거운 스프\', \'text\': \'장착된 생물은 방어될 수 없다.\\n장착된 생물이 피해를 입을 때마다, 그 생물을 파괴한다.\\n장착 {3} ({3}: 당신이 조종하는 생물을 목표로 정한다. 그 생물에 이 장비를 부착한다. 당신이 집중마법을 발동할 수 있는 시기에만 이 능력을 활성화할 수 있다.)\', \'type\': \'마법물체 — 장비\', \'flavor\': \'"지나갑니다!" 디자인: James Ernest\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385257&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'78268653-125c-4453-944c-52a81806dfe0\', \'multiverseId\': 385257}, \'multiverseid\': 385257}, {\'name\': \'Sopa Quente\', \'text\': \'A criatura equipada não pode ser bloqueada.\\nToda vez que a criatura equipada sofrer dano, destrua-a.\\nEquipar {3} ({3}: Anexe-o à criatura alvo que você controla. Equipe somente como um feitiço.)\', \'type\': \'Artefato — Equipamento\', \'flavor\': \'"Cuidado, está quente!" Criado por James Ernest\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385541&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d6624a41-4fb8-4148-8476-d9f298a14bc5\', \'multiverseId\': 385541}, \'multiverseid\': 385541}, {\'name\': \'Горячий Суп\', \'text\': \'Снаряженное существо не может быть заблокировано.\\nКаждый раз, когда снаряженному существу наносятся повреждения, уничтожьте его.\\nСнарядить {3} ({3}: прикрепите к целевому существу под вашим контролем. Снаряжайте только как волшебство.)\', \'type\': \'Артефакт — Снаряжение\', \'flavor\': \'«Посторонись!» Автор карты: Джеймс Эрнест\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385825&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1287f918-b641-48fa-90cc-b670083fbfa2\', \'multiverseId\': 385825}, \'multiverseid\': 385825}, {\'name\': \'滚汤\', \'text\': \'佩带此武具的生物不能被阻挡。\\n每当佩带此武具的生物受到伤害时，将它消灭。\\n佩带{3}（{3}：装备在目标由你操控的生物上。佩带的时机视同法术。）\', \'type\': \'神器～武具\', \'flavor\': \'「借过！」 设计者：James Ernest\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383553&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5b5b2351-b960-484d-82cc-919a453aec19\', \'multiverseId\': 383553}, \'multiverseid\': 383553}, {\'name\': \'滾湯\', \'text\': \'佩帶此武具的生物不能被阻擋。\\n每當佩帶此武具的生物受到傷害時，將它消滅。\\n佩帶{3}（{3}：裝備在目標由你操控的生物上。佩帶的時機視同巫術。）\', \'type\': \'神器～武具\', \'flavor\': \'「借過！」 設計者：James Ernest\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383837&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a5513e1b-6683-4d2d-bdeb-83e89b102dac\', \'multiverseId\': 383837}, \'multiverseid\': 383837}]', "[{'name': 'Hemmende Strahlen', 'text': 'Verzaubert eine Kreatur\\nDie verzauberte Kreatur kann nicht angreifen oder blocken, falls ihr Beherrscher nicht {3} bezahlt.\\nAktivierte Fähigkeiten der verzauberten Kreatur kosten beim Aktivieren {3} mehr.', 'type': 'Verzauberung — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384184&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e989537f-cea4-471c-8d38-6391ed5173f7', 'multiverseId': 384184}, 'multiverseid': 384184}, {'name': 'Rayos opresivos', 'text': 'Encantar criatura.\\nLa criatura encantada no puede atacar o bloquear a menos que su controlador pague {3}.\\nCuesta {3} más activar las habilidades activadas de la criatura encantada.', 'type': 'Encantamiento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386172&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'fd9de2fc-9ea5-47b2-acba-b52891b4492b', 'multiverseId': 386172}, 'multiverseid': 386172}, {'name': 'Rayons oppressants', 'text': 'Enchanter : créature\\nLa créature enchantée ne peut pas attaquer ou bloquer à moins que son contrôleur ne paie {3}.\\nLes capacités activées de la créature enchantée coûtent {3} de plus à activer.', 'type': 'Enchantement : aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384468&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c96f24b8-7792-48ff-9b53-e40a56fed3ff', 'multiverseId': 384468}, 'multiverseid': 384468}, {'name': 'Raggi Opprimenti', 'text': 'Incanta creatura\\nLa creatura incantata non può attaccare o bloccare a meno che il suo controllore non paghi {3}.\\nLe abilità attivate della creatura incantata costano {3} in più per essere attivate.', 'type': 'Incantesimo — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384752&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '4823cde5-12eb-455b-a384-1578b2d4730f', 'multiverseId': 384752}, 'multiverseid': 384752}, {'name': '抑圧的な光線', 'text': 'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは、それのコントローラーが{3}を支払わないかぎり、攻撃したりブロックしたりできない。\\nエンチャントされているクリーチャーの起動型能力は、それを起動するためのコストが{3}多くなる。', 'type': 'エンチャント — オーラ', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385036&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '4ee00dc5-2d5c-4369-8551-e4f13bcede44', 'multiverseId': 385036}, 'multiverseid': 385036}, {'name': '숨막히는 광선', 'text': '생물에게 부여\\n부여된 생물은 그 생물의 조종자가 {3}을 지불하지 않는 한 공격하거나 방어할 수 없다.\\n부여된 생물의 활성화 능력은 활성화하는 데 {3}이 더 든다.', 'type': '부여마법 — 마법진', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385320&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '3f917f32-eb02-468c-8fca-4d32bb238cd8', 'multiverseId': 385320}, 'multiverseid': 385320}, {'name': 'Raios Opressores', 'text': 'Encantar criatura\\nA criatura encantada não pode atacar ou bloquear a menos que seu controlador pague {3}.\\nAs habilidades ativadas da criatura encantada custam {3} a mais para serem ativadas.', 'type': 'Encantamento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385604&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '033632b8-49f0-473d-b6dd-2ecb40c97bcb', 'multiverseId': 385604}, 'multiverseid': 385604}, {'name': 'Лучи Подавления', 'text': 'Зачаровать существо\\nЗачарованное существо не может атаковать или блокировать, если только контролирующий его игрок не заплатит {3}.\\nАктивация активируемых способностей зачарованного существа стоит на {3} больше.', 'type': 'Чары — Аура', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385888&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '2656a503-25c0-4a54-bd5f-8122918b56b4', 'multiverseId': 385888}, 'multiverseid': 385888}, {'name': '压迫射线', 'text': '结附于生物\\n除非所结附之生物的操控者支付{3}，否则它不能进行攻击或阻挡。\\n所结附之生物的起动式异能增加{3}来起动。', 'type': '结界～灵气', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383616&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9e49bc74-dbb1-4e1c-b2ca-6fa574c9f7cf', 'multiverseId': 383616}, 'multiverseid': 383616}, {'name': '壓迫射線', 'text': '結附於生物\\n除非所結附之生物的操控者支付{3}，否則它不能進行攻擊或阻擋。\\n所結附之生物的起動式異能增加{3}來起動。', 'type': '結界～靈氣', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383900&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'a2619e35-be74-42c4-a801-423f9b863414', 'multiverseId': 383900}, 'multiverseid': 383900}]", '[{\'name\': \'Himmelsschwalbe\', \'text\': \'Fliegend (Diese Kreatur kann außer von fliegenden Kreaturen und Kreaturen mit Reichweite nicht geblockt werden.)\\nDie Himmelsschwalbe kann nur fliegende Kreaturen blocken.\', \'type\': \'Kreatur — Vogel\', \'flavor\': \'Seeleute glauben mittlerweile, dass sie Unglück bringen, denn sie lassen die falsche Hoffnung auf Land in der Nähe aufkommen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384289&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6962c7e0-b825-44b0-afe2-76c61e219c7a\', \'multiverseId\': 384289}, \'multiverseid\': 384289}, {\'name\': \'Golondrina del firmamento\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar o alcance.)\\nLa Golondrina del firmamento puede bloquear solo a criaturas con la habilidad de volar.\', \'type\': \'Criatura — Ave\', \'flavor\': \'Los marinos han llegado a considerarlas de mal agüero, porque dan falsas esperanzas de estar llegando a tierra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386277&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f64eb376-86e4-45be-bfbf-26187c3793f5\', \'multiverseId\': 386277}, \'multiverseid\': 386277}, {\'name\': \'Sterne des nues\', \'text\': \'Vol (Cette créature ne peut pas être bloquée excepté par des créatures avec le vol ou la portée.)\\nLa Sterne des nues ne peut bloquer que les créatures avec le vol.\', \'type\': \'Créature : oiseau\', \'flavor\': "Fausse annonciatrice de terre ferme, bon nombre de marins considèrent désormais qu\'elle porte malheur.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384573&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ea235276-ac8b-4f09-a494-d3c1ff3cb7a3\', \'multiverseId\': 384573}, \'multiverseid\': 384573}, {\'name\': \'Sterna del Cielo\', \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare o raggiungere.)\\nLa Sterna del Cielo può bloccare solo creature con volare.\', \'type\': \'Creatura — Uccello\', \'flavor\': \'I marinai credono che portino sventura, poiché instillano una falsa speranza di aver raggiunto la terra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384857&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ca6f56ce-8f1a-4590-b56d-b42f438eb521\', \'multiverseId\': 384857}, \'multiverseid\': 384857}, {\'name\': \'天空のアジサシ\', \'text\': \'飛行（このクリーチャーは飛行や到達を持たないクリーチャーによってブロックされない。）\\n天空のアジサシは飛行を持つクリーチャーのみをブロックできる。\', \'type\': \'クリーチャー — 鳥\', \'flavor\': \'陸地にたどりついたとぬか喜びさせるので、船員たちは彼らを不運の象徴として見なすようになった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385141&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5e48ff92-fcd7-4345-840a-a55c1b329af9\', \'multiverseId\': 385141}, \'multiverseid\': 385141}, {\'name\': \'창공의 제비갈매기\', \'text\': \'비행 (이 생물은 비행이나 대공을 가진 생물에게만 방어될 수 있다.)\\n창공의 제비갈매기는 비행을 가진 생물만 방어할 수 있다.\', \'type\': \'생물 — 조류\', \'flavor\': \'선원들은 이 새들이 땅에 대한 헛된 기대를 불러일으키기에 흉조로 여기게 되었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385425&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f5b08750-e635-422f-98d3-dbafc65aa9b1\', \'multiverseId\': 385425}, \'multiverseid\': 385425}, {\'name\': \'Carrago Celeste\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com voar ou alcance.)\\nCarrago Celeste só pode bloquear criaturas com voar.\', \'type\': \'Criatura — Ave\', \'flavor\': \'Os marinheiros passaram a vê-los como sinal de má sorte, pois traziam falsas esperanças de terra próxima.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385709&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a1fe375e-1ae1-45ec-b63c-c770149281a0\', \'multiverseId\': 385709}, \'multiverseid\': 385709}, {\'name\': \'Небесная Крачка\', \'text\': \'Полет (Это существо может быть заблокировано только существами с Полетом или Захватом.)\\nНебесная Крачка может блокировать только существа с Полетом.\', \'type\': \'Существо — Птица\', \'flavor\': \'Моряки считают, что они приносят неудачу, потому что заставляют думать, будто бы поблизости находится суша.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385993&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7ab3065c-b928-4c36-9dad-b4b10a74f98c\', \'multiverseId\': 385993}, \'multiverseid\': 385993}, {\'name\': \'苍穹飞燕\', \'text\': \'飞行（此生物只能被具飞行或延势异能的生物阻挡。）\\n苍穹飞燕只能阻挡具飞行异能的生物。\', \'type\': \'生物～鸟\', \'flavor\': \'水手们已将看到此鸟当作厄运之兆，全因它总让人误以为陆地已近。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383721&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'65d56989-a0c8-4dfb-9046-4b69c53b6c0d\', \'multiverseId\': 383721}, \'multiverseid\': 383721}, {\'name\': \'蒼穹飛燕\', \'text\': \'飛行（此生物只能被具飛行或延勢異能的生物阻擋。）\\n蒼穹飛燕只能阻擋具飛行異能的生物。\', \'type\': \'生物～鳥\', \'flavor\': \'水手們已將看到此鳥當作厄運之兆，全因牠總讓人誤以為陸地已近。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384005&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7a22bcf2-669e-4738-81a5-fdf529f909ec\', \'multiverseId\': 384005}, \'multiverseid\': 384005}]', '[{\'name\': \'Hitzestrahl\', \'text\': \'Der Hitzestrahl fügt einer Kreatur deiner Wahl X Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Das war eindeutig ein Schrei. Ich bin mir nur nicht sicher, ob auch ein Mund dazugehörte." —Sachir aus Akoums Expeditionsgildenhaus\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384116&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8dd0066d-3aa9-4c92-80ff-bd36d9382ea7\', \'multiverseId\': 384116}, \'multiverseid\': 384116}, {\'name\': \'Rayo de calor\', \'text\': \'El Rayo de calor hace X puntos de daño a la criatura objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Estoy seguro de que hubo un grito. Lo que no puedo asegurar es que hubiera una boca." —Sachir, Casa expedicionaria de Akoum\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386104&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bf094db2-a8f6-44bc-8927-0d67f1b797e5\', \'multiverseId\': 386104}, \'multiverseid\': 386104}, {\'name\': \'Rayon de chaleur\', \'text\': \'Le Rayon de chaleur inflige X blessures à une créature ciblée.\', \'type\': \'Éphémère\', \'flavor\': "« J\'ai clairement entendu un cri. Mais je ne suis pas sûr d\'avoir vu une bouche. » —Sachir, corps expéditionnaire d\'Akoum", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384400&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ce9d0d9e-3c85-4d2d-ab83-6e2cf9345a2e\', \'multiverseId\': 384400}, \'multiverseid\': 384400}, {\'name\': \'Raggio di Calore\', \'text\': \'Il Raggio di Calore infligge X danni a una creatura bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"C\\\'è sicuramente stato un urlo. Non sono sicura ci fosse anche una bocca." —Sachir, Casa di Spedizioni di Akoum\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384684&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3207ffa6-cb05-4ab1-befd-48db1c6093b4\', \'multiverseId\': 384684}, \'multiverseid\': 384684}, {\'name\': \'熱光線\', \'text\': \'クリーチャー１体を対象とする。熱光線はそれにＸ点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'「確かにあれは叫び声です。ただ、口があったかどうかはわかりませんね。」 ――アクーム探検協会のサチャー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384968&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3f1aef65-bd79-4024-810d-d4575c31f328\', \'multiverseId\': 384968}, \'multiverseid\': 384968}, {\'name\': \'고열 광선\', \'text\': \'생물을 목표로 정한다. 고열 광선은 그 생물에게 피해 X점을 입힌다.\', \'type\': \'순간마법\', \'flavor\': \'"분명히 비명이 들렸다. 그런데 입이 있었는지 확실치 않다." —아쿰 탐험단의 사치르\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385252&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'23d668c5-3e8c-4769-9215-c81555867661\', \'multiverseId\': 385252}, \'multiverseid\': 385252}, {\'name\': \'Raio de Calor\', \'text\': \'Raio de Calor causa X pontos de dano à criatura alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Com certeza houve um grito. Mas não sei se havia uma boca." — Sachir, Casa Expedicionária de Akoum\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385536&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9a4482fd-ba77-4da9-98a2-599652f997a5\', \'multiverseId\': 385536}, \'multiverseid\': 385536}, {\'name\': \'Луч Жара\', \'text\': \'Луч Жара наносит X повреждений целевому существу.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Крик точно был. Насчет рта не уверен». — Сачир из акумского экспедиционного дома\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385820&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'27490685-7920-4c44-8a24-484caff3d15c\', \'multiverseId\': 385820}, \'multiverseid\': 385820}, {\'name\': \'热射线\', \'text\': \'热射线对目标生物造成X点伤害。\', \'type\': \'瞬间\', \'flavor\': \'「先前确实听到尖叫声。但我不确定哪边是嘴。」 ～阿库姆探险队的莎琦儿\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383548&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'63e15e36-fb6c-480d-846d-66ade9e281c7\', \'multiverseId\': 383548}, \'multiverseid\': 383548}, {\'name\': \'熱射線\', \'text\': \'熱射線對目標生物造成X點傷害。\', \'type\': \'瞬間\', \'flavor\': \'「先前確實聽到尖叫聲。但我不確定哪邊是嘴。」 ～阿庫姆探險隊的莎琦兒\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383832&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e5645457-20a5-4d55-ae3c-c792c2eed879\', \'multiverseId\': 383832}, \'multiverseid\': 383832}]', '[{\'name\': \'Hornissenkönigin\', \'text\': \'Fliegend\\nTodesberührung (Eine beliebige Menge Schadenspunkte, die sie einer Kreatur zufügt, sind ausreichend, um diese zu zerstören.)\\nWenn die Hornissenkönigin ins Spiel kommt, bringe vier 1/1 grüne Insekt-Kreaturenspielsteine mit Flugfähigkeit und Todesberührung ins Spiel.\', \'type\': \'Kreatur — Insekt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384120&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1389d727-9d83-42bc-853f-2ba6729f1e84\', \'multiverseId\': 384120}, \'multiverseid\': 384120}, {\'name\': \'Avispa reina\', \'text\': \'Vuela.\\nToque mortal. (Cualquier cantidad de daño que esto haga a una criatura es suficiente para destruirla.)\\nCuando la Avispa reina entre al campo de batalla, pon en el campo de batalla cuatro fichas de criatura Insecto verdes 1/1 con las habilidades de volar y toque mortal.\', \'type\': \'Criatura — Insecto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386108&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a1f134fa-000b-49e1-9265-ae45c4b1b5db\', \'multiverseId\': 386108}, \'multiverseid\': 386108}, {\'name\': \'Reine des frelons\', \'text\': "Vol\\nContact mortel (Le nombre de blessures que cette créature inflige à une créature, quel qu\'il soit, est suffisant pour la détruire.)\\nQuand la Reine des frelons arrive sur le champ de bataille, mettez sur le champ de bataille quatre jetons de créature 1/1 verte Insecte avec le vol et le contact mortel.", \'type\': \'Créature : insecte\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384404&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ffda7fb8-4e07-4c7d-b15d-101ad67860b0\', \'multiverseId\': 384404}, \'multiverseid\': 384404}, {\'name\': \'Regina dei Calabroni\', \'text\': \'Volare\\nTocco letale (Qualsiasi danno che questa creatura infligge a una creatura è sufficiente a distruggerla.)\\nQuando la Regina dei Calabroni entra nel campo di battaglia, metti sul campo di battaglia quattro pedine creatura Insetto 1/1 verdi con volare e tocco letale.\', \'type\': \'Creatura — Insetto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384688&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'db068575-a2e6-417f-a1c1-bfd63c4a9c46\', \'multiverseId\': 384688}, \'multiverseid\': 384688}, {\'name\': \'女王スズメバチ\', \'text\': \'飛行\\n接死（これが何らかのダメージをクリーチャーに与えたら、それだけで破壊する。）\\n女王スズメバチが戦場に出たとき、飛行と接死を持つ緑の１/１の昆虫・クリーチャー・トークンを４体戦場に出す。\', \'type\': \'クリーチャー — 昆虫\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384972&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4a60817e-577f-441f-bcb6-1d56b677a05b\', \'multiverseId\': 384972}, \'multiverseid\': 384972}, {\'name\': \'여왕 말벌\', \'text\': \'비행\\n치명타 (이 생물에게 피해를 입은 생물은 피해의 양에 상관없이 파괴된다.)\\n여왕 말벌이 전장에 들어올 때, 비행과 치명타를 가진 1/1 녹색 곤충 생물 토큰 네 개를 전장에 놓는다.\', \'type\': \'생물 — 곤충\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385256&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'62f4ef4d-7f0e-41a5-8bf8-eaf00bd139a3\', \'multiverseId\': 385256}, \'multiverseid\': 385256}, {\'name\': \'Vespa Rainha\', \'text\': \'Voar\\nToque mortífero (Qualquer quantidade de dano que esta criatura cause a uma criatura é suficiente para destruí-la.)\\nQuando Vespa Rainha entrar no campo de batalha, coloque no campo de batalha quatro fichas de criatura verdes 1/1 do tipo Inseto com voar e toque mortífero.\', \'type\': \'Criatura — Inseto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385540&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e934002b-86f8-4a02-a178-c2d75d4dac8a\', \'multiverseId\': 385540}, \'multiverseid\': 385540}, {\'name\': \'Царица Шершней\', \'text\': \'Полет\\nСмертельное касание (Любое количество повреждений, которое этот объект наносит существу, достаточно, чтобы его уничтожить.)\\nКогда Царица Шершней выходит на поле битвы, положите на поле битвы четыре фишки существа 1/1 зеленое Насекомое с Полетом и Смертельным касанием.\', \'type\': \'Существо — Насекомое\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385824&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b7e31df8-cb3f-49a3-997c-cbc0bc65af5f\', \'multiverseId\': 385824}, \'multiverseid\': 385824}, {\'name\': \'蜂后\', \'text\': \'飞行\\n死触（它对生物造成的任何数量伤害都足以消灭后者。）\\n当蜂后进战场时，将四个1/1绿色，具飞行与死触异能的昆虫衍生生物放进战场。\', \'type\': \'生物～昆虫\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383552&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'59f691b6-6321-4b3f-a885-d48846a3c33f\', \'multiverseId\': 383552}, \'multiverseid\': 383552}, {\'name\': \'蜂后\', \'text\': \'飛行\\n死觸（它對生物造成的任何數量傷害都足以消滅後者。）\\n當蜂后進戰場時，將四個1/1綠色，具飛行與死觸異能的昆蟲衍生生物放進戰場。\', \'type\': \'生物～昆蟲\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383836&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'237595a5-1220-406a-a8c4-3c1962317d47\', \'multiverseId\': 383836}, \'multiverseid\': 383836}]', '[{\'name\': \'Hornissennest\', \'text\': \'Verteidiger (Diese Kreatur kann nicht angreifen.)\\nImmer wenn dem Hornissennest Schaden zugefügt wird, bringe entsprechend viele 1/1 grüne Insekt-Kreaturenspielsteine mit Flugfähigkeit und Todesberührung ins Spiel. (Eine beliebige Menge Schadenspunkte, die eine Kreatur mit Todesberührung einer Kreatur zufügt, sind ausreichend, um sie zu zerstören.)\', \'type\': \'Kreatur — Insekt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384119&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0b6f461b-e1db-45aa-9980-3f56a9e3d83a\', \'multiverseId\': 384119}, \'multiverseid\': 384119}, {\'name\': \'Avispero\', \'text\': \'Defensor. (Esta criatura no puede atacar.)\\nSiempre que el Avispero reciba daño, pon en el campo de batalla esa misma cantidad de fichas de criatura Insecto verdes 1/1 con las habilidades de volar y toque mortal. (Cualquier cantidad de daño que una criatura con la habilidad de toque mortal haga a una criatura es suficiente para destruirla.)\', \'type\': \'Criatura — Insecto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386107&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9de2dcc7-feb6-4ba9-bc2c-16b330d3c509\', \'multiverseId\': 386107}, \'multiverseid\': 386107}, {\'name\': \'Nid de frelons\', \'text\': "Défenseur (Cette créature ne peut pas attaquer.)\\nÀ chaque fois que le Nid de frelons subit des blessures, mettez sur le champ de bataille autant de jetons de créature 1/1 verte Insecte avec le vol et le contact mortel. (Le nombre de blessures qu\'inflige une créature avec le contact mortel à une créature, quel qu\'il soit, est suffisant pour la détruire.)", \'type\': \'Créature : insecte\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384403&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'76673e99-16f6-4c12-834d-2d44aab5022b\', \'multiverseId\': 384403}, \'multiverseid\': 384403}, {\'name\': \'Nido di Calabroni\', \'text\': \'Difensore (Questa creatura non può attaccare.)\\nOgniqualvolta viene inflitto danno al Nido di Calabroni, metti sul campo di battaglia altrettante pedine creatura Insetto 1/1 verdi con volare e tocco letale. (Qualsiasi danno che una creatura con tocco letale infligge a una creatura è sufficiente a distruggerla.)\', \'type\': \'Creatura — Insetto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384687&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b8ae77fb-f04c-4356-9fa1-7a6b0f96d785\', \'multiverseId\': 384687}, \'multiverseid\': 384687}, {\'name\': \'スズメバチの巣\', \'text\': \'防衛（このクリーチャーでは攻撃できない。）\\nスズメバチの巣にダメージが与えられるたび、その点数に等しい数の飛行と接死を持つ緑の１/１の昆虫・クリーチャー・トークンを戦場に出す。（接死を持つクリーチャーが何らかのダメージをクリーチャーに与えたら、それだけで破壊する。）\', \'type\': \'クリーチャー — 昆虫\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384971&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e0cee999-8e6d-4bbe-8900-b1044f896ecb\', \'multiverseId\': 384971}, \'multiverseid\': 384971}, {\'name\': \'말벌 둥지\', \'text\': \'수비태세 (이 생물은 공격할 수 없다.)\\n말벌 둥지가 피해를 입을 때마다, 그 피해만큼의 비행과 치명타를 가진 1/1 녹색 곤충 생물 토큰을 전장에 놓는다. (치명타를 가진 생물에게 피해를 입은 생물은 입은 피해의 양에 상관없이 파괴된다.)\', \'type\': \'생물 — 곤충\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385255&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6759bc34-ce35-402d-8ea0-a471185b1d5a\', \'multiverseId\': 385255}, \'multiverseid\': 385255}, {\'name\': \'Vespeiro\', \'text\': \'Defensor (Esta criatura não pode atacar.)\\nToda vez que Vespeiro sofrer dano, coloque no campo de batalha uma quantidade equivalente de fichas de criatura verdes 1/1 do tipo Inseto com voar e toque mortífero. (Qualquer quantidade de dano que uma criatura com toque mortífero cause a uma criatura é suficiente para destruí-la.)\', \'type\': \'Criatura — Inseto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385539&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'13bcea46-7a9d-4bce-808f-64ddf19bce7f\', \'multiverseId\': 385539}, \'multiverseid\': 385539}, {\'name\': \'Гнездо Шершней\', \'text\': \'Защитник (Это существо не может атаковать.)\\nКаждый раз, когда Гнезду Шершней наносятся повреждения, положите на поле битвы столько же фишек существа 1/1 зеленое Насекомое с Полетом и Смертельным касанием. (Любое количество повреждений, которое существо со Смертельным касанием наносит существу, достаточно, чтобы его уничтожить.)\', \'type\': \'Существо — Насекомое\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385823&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'161537d2-8126-45ee-9fae-aaaae5585c43\', \'multiverseId\': 385823}, \'multiverseid\': 385823}, {\'name\': \'黄蜂巢\', \'text\': \'守军（此生物不能攻击。）\\n每当黄蜂巢受到伤害时，将等量的1/1绿色，具飞行与死触异能的昆虫衍生生物放进战场。（具有死触异能的生物对生物造成的任何数量伤害都足以消灭后者。）\', \'type\': \'生物～昆虫\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383551&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'48f034d6-d9ef-40f3-9354-f770474dd864\', \'multiverseId\': 383551}, \'multiverseid\': 383551}, {\'name\': \'黃蜂巢\', \'text\': \'守軍（此生物不能攻擊。）\\n每當黃蜂巢受到傷害時，將等量的1/1綠色，具飛行與死觸異能的昆蟲衍生生物放進戰場。（具有死觸異能的生物對生物造成的任何數量傷害都足以消滅後者。）\', \'type\': \'生物～昆蟲\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383835&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4bc5f5bd-305f-4c24-ac4d-6b32c18e8289\', \'multiverseId\': 383835}, \'multiverseid\': 383835}]', "[{'name': 'Höhlen von Koilos', 'text': '{T}: Erhöhe deinen Manavorrat um {1}.\\n{T}: Erhöhe deinen Manavorrat um {W} oder {B}. Die Höhlen von Koilos fügen dir 1 Schadenspunkt zu.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384055&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a8200be2-e2fc-4ebf-a217-cdefb334ba72', 'multiverseId': 384055}, 'multiverseid': 384055}, {'name': 'Cuevas de Koilos', 'text': '{T}: Agrega {1} a tu reserva de maná.\\n{T}: Agrega {W} o {B} a tu reserva de maná. Las Cuevas de Koilos te hacen 1 punto de daño.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386043&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '18bd2c2c-3390-4d6b-abff-63a7cdfe6cb1', 'multiverseId': 386043}, 'multiverseid': 386043}, {'name': 'Cavernes de Koïlos', 'text': '{T} : Ajoutez {1} à votre réserve.\\n{T} : Ajoutez {W} ou {B} à votre réserve. Les Cavernes de Koïlos vous infligent 1 blessure.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384339&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e1e7a752-19aa-4e66-bbdb-3b99d44661b8', 'multiverseId': 384339}, 'multiverseid': 384339}, {'name': 'Caverne di Koilos', 'text': '{T}: Aggiungi {1} alla tua riserva di mana.\\n{T}: Aggiungi {W} o {B} alla tua riserva di mana. Le Caverne di Koilos ti infliggono 1 danno.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384623&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '9cca0017-3408-4505-8c46-0323c73a43eb', 'multiverseId': 384623}, 'multiverseid': 384623}, {'name': 'コイロスの洞窟', 'text': '{T}：あなたのマナ・プールに{1}を加える。\\n{T}：あなたのマナ・プールに{W}か{B}を加える。コイロスの洞窟はあなたに１点のダメージを与える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384907&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'df95e7bd-c7fc-4fd3-82da-f5bda63dd2e5', 'multiverseId': 384907}, 'multiverseid': 384907}, {'name': '코일로스의 동굴', 'text': '{T}: {1}을 당신의 마나풀에 담는다.\\n{T}: {W} 또는 {B}를 당신의 마나풀에 담는다. 코일로스의 동굴은 당신에게 피해 1점을 입힌다.', 'type': '대지', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385191&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '5d2cf2f9-39ac-44b7-865d-5c94765986aa', 'multiverseId': 385191}, 'multiverseid': 385191}, {'name': 'Cavernas de Koilos', 'text': '{T}: Adicione {1} à sua reserva de mana.\\n{T}: Adicione {W} ou {B} à sua reserva de mana. Cavernas de Koilos causa 1 ponto de dano a você.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385475&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a241e273-62a6-413b-81a2-9deba1797eaa', 'multiverseId': 385475}, 'multiverseid': 385475}, {'name': 'Пещеры Койлоса', 'text': '{T}: добавьте {1} в ваше хранилище маны.\\n{T}: добавьте {W} или {B} в ваше хранилище маны. Пещеры Койлоса наносят вам 1 повреждение.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385759&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'c12064e9-d0ea-4910-ba3e-54edb777fc15', 'multiverseId': 385759}, 'multiverseid': 385759}, {'name': '喀洛斯洞窟', 'text': '{T}：加{1}到你的法术力池中。\\n{T}：加{W}或{B}到你的法术力池中。喀洛斯洞窟对你造成1点伤害。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383487&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '5df552d7-6730-4a22-b33a-2e138805b5a4', 'multiverseId': 383487}, 'multiverseid': 383487}, {'name': '喀洛斯洞窟', 'text': '{T}：加{1}到你的魔法力池中。\\n{T}：加{W}或{B}到你的魔法力池中。喀洛斯洞窟對你造成1點傷害。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383771&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '5e96d12f-e61a-4368-b1fc-d5d2cb453efe', 'multiverseId': 383771}, 'multiverseid': 383771}]", '[{\'name\': \'Hüter des Jenseits\', \'text\': \'Wachsamkeit (Diese Kreatur wird beim Angreifen nicht getappt.)\\nDer Hüter des Jenseits erhält +2/+2, solange ein Gegner eine Karte besitzt, die im Exil ist.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'Er zieht Kraft aus einer gewaltigen Quelle, die nur wenige Sterbliche begreifen können. Nach einer Idee von Isaiah Cartwright\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384287&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'261674ac-0c40-44ac-8b90-6c147aa5d6e8\', \'multiverseId\': 384287}, \'multiverseid\': 384287}, {\'name\': \'Protector del más allá\', \'text\': \'Vigilancia. (Esta criatura no se gira al atacar.)\\nEl Protector del más allá obtiene +2/+2 mientras un oponente sea propietario de una carta en el exilio.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'Extrae fuerzas de una vasta fuente que pocos mortales pueden comprender. Diseñada por Isaiah Cartwright\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386275&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'61227f7c-35d5-4ee3-b2c9-d9ab25ae0b0f\', \'multiverseId\': 386275}, \'multiverseid\': 386275}, {\'name\': "Garde de l\'au-delà", \'text\': "Vigilance (Attaquer avec cette créature ne la fait pas s\'engager.)\\nLe Garde de l\'au-delà gagne +2/+2 tant qu\'un adversaire possède une carte en exil.", \'type\': \'Créature : humain et sorcier\', \'flavor\': "Il puise sa force d\'une source immense, inimaginable par le commun des mortels. Conçue par Isaiah Cartwright", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384571&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3e86ca36-3807-48de-b709-b10fa0feb184\', \'multiverseId\': 384571}, \'multiverseid\': 384571}, {\'name\': \'Guardiano del Trascendente\', \'text\': \'Cautela (Questa creatura attacca senza TAPpare.)\\nIl Guardiano del Trascendente prende +2/+2 fintanto che un avversario possiede una carta in esilio.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': \'Trae il suo potere da una vasta sorgente che pochi mortali possono concepire. Ideata da Isaiah Cartwright\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384855&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eecb72c2-a3b9-4331-ac0d-d3ccd496eb07\', \'multiverseId\': 384855}, \'multiverseid\': 384855}, {\'name\': \'彼方の管理人\', \'text\': \'警戒（このクリーチャーは攻撃してもタップしない。）\\n対戦相手がオーナーであるカードが追放領域にあるかぎり、彼方の管理人は＋２/＋２の修整を受ける。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'彼は少数の定命の者しか認識することができない広大な源から力を得ている。 デザイン：Isaiah Cartwright\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385139&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'62bbdd00-d422-4fe2-8366-d0eb7acf2d83\', \'multiverseId\': 385139}, \'multiverseid\': 385139}, {\'name\': \'저승의 관리인\', \'text\': \'경계 (이 생물은 공격하면서 탭되지 않는다.)\\n추방 영역에 상대의 소유인 카드가 있는 한 저승의 관리인은 +2/+2를 받는다.\', \'type\': \'생물 — 인간 마법사\', \'flavor\': \'그는 소수의 필멸자들만이 가늠할 수 있는 광대한 원천에서 힘을 얻는다. 디자인: Isaiah Cartwright\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385423&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e2ec3d56-3eab-4f8d-8628-0539ac3f2ef1\', \'multiverseId\': 385423}, \'multiverseid\': 385423}, {\'name\': \'Guardião do Além\', \'text\': \'Vigilância (Esta criatura não é virada para atacar.)\\nGuardião do Além receberá +2/+2 enquanto um oponente tiver um card exilado.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'Sua força vem de uma fonte vasta que poucos mortais podem sequer conceber. Criado por Isaiah Cartwright\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385707&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3bc0b793-3ba6-40b2-870c-61d1644cfb76\', \'multiverseId\': 385707}, \'multiverseid\': 385707}, {\'name\': \'Страж Запредельности\', \'text\': \'Бдительность (Атакуя, это существо не поворачивается.)\\nСтраж Запредельности получает +2/+2, пока оппонент является владельцем карты в изгнании.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'Он черпает силы из бездонного источника, о котором известно лишь немногим из смертных. Автор карты: Исайя Картрайт\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385991&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2bbbe0fe-992d-4e9b-824e-0b8a2f69d009\', \'multiverseId\': 385991}, \'multiverseid\': 385991}, {\'name\': \'他界护卫\', \'text\': \'警戒（此生物攻击时不需横置。）\\n只要放逐区中有对手拥有的牌，他界护卫便得+2/+2。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'他会从凡人难以参透的广阔来源中汲取力量。 设计者：Isaiah Cartwright\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383719&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c3dfc2be-3048-43e8-ae3f-d7b317edcd75\', \'multiverseId\': 383719}, \'multiverseid\': 383719}, {\'name\': \'他界護衛\', \'text\': \'警戒（此生物攻擊時不需橫置。）\\n只要放逐區中有對手擁有的牌，他界護衛便得+2/+2。\', \'type\': \'生物～人類／魔法師\', \'flavor\': \'他會從凡人難以參透的廣闊來源中汲取力量。 設計者：Isaiah Cartwright\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384003&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0ef9535a-3342-487e-966b-33862281635a\', \'multiverseId\': 384003}, \'multiverseid\': 384003}]', '[{\'name\': \'Illusorischer Engel\', \'text\': \'Fliegend\\nWirke den Illusorischen Engel nur, falls du in diesem Zug bereits mindestens einen anderen Zauberspruch gewirkt hast.\', \'type\': \'Kreatur — Engel, Illusion\', \'flavor\': \'„Benommen erwachte ich und schaute auf das Schlachtfeld, und ich hätte schwören können, dass meine Träume verheerenden Schaden unter den Feinden anrichteten." —Brief von einem Soldaten\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384126&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d72b05e6-1346-4c03-9c2e-fc96adb5453a\', \'multiverseId\': 384126}, \'multiverseid\': 384126}, {\'name\': \'Ángel ilusorio\', \'text\': \'Vuela.\\nLanza el Ángel ilusorio solo si lanzaste otro hechizo este turno.\', \'type\': \'Criatura — Ilusión ángel\', \'flavor\': \'"Aturdido, desperté y miré hacia el campo de batalla, donde habría jurado que mis sueños sembraban la devastación en el enemigo". —Carta de un soldado\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386114&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b769e974-efec-4e31-8538-a499301a9c13\', \'multiverseId\': 386114}, \'multiverseid\': 386114}, {\'name\': \'Ange illusoire\', \'text\': "Vol\\nNe lancez l\'Ange illusoire que si vous avez lancé un autre sort ce tour-ci.", \'type\': \'Créature : ange et illusion\', \'flavor\': "« Reprenant mes esprits sur le champ de bataille, je crus voir mes rêves tailler l\'ennemi en pièces. » —Lettre d\'un soldat", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384410&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'df345a91-6db1-4eb6-b0f8-e69f61faa24c\', \'multiverseId\': 384410}, \'multiverseid\': 384410}, {\'name\': \'Angelo Irreale\', \'text\': "Volare\\nLancia l\'Angelo Irreale solo se hai lanciato un\'altra magia in questo turno.", \'type\': \'Creatura — Illusione Angelo\', \'flavor\': \'"Mi svegliai preda della confusione e osservai il campo di battaglia, dove giurerei di aver visto i miei sogni decimare il nemico." —Lettera di un soldato\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384694&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d2e6410a-ec8b-431c-bbe5-6c53eddfabc1\', \'multiverseId\': 384694}, \'multiverseid\': 384694}, {\'name\': \'幻影の天使\', \'text\': \'飛行\\n幻影の天使は、あなたがこのターンに他の呪文を唱えていたときにのみ唱えられる。\', \'type\': \'クリーチャー — 天使・イリュージョン\', \'flavor\': \'「朦朧とする意識のなか、目が覚めて戦場を見ると、そこで私の夢が敵を蹴散らしている信じがたい光景が繰り広げられていた。」 ――ある兵士からの手紙\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384978&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'977803f4-8f4a-468b-8c2d-1139a951c27d\', \'multiverseId\': 384978}, \'multiverseid\': 384978}, {\'name\': \'희미한 천사\', \'text\': \'비행\\n당신이 이 턴에 다른 주문을 발동했을 때만 희미한 천사를 발동할 수 있다.\', \'type\': \'생물 — 천사 환영\', \'flavor\': \'"어리둥절한 상태로 깨어나 전장을 바라보니, 맹세하건대 내 꿈이 적을 초토화하고 있었다." —한 병사의 편지\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385262&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'cac57102-8fa8-42ba-ab21-244892f97931\', \'multiverseId\': 385262}, \'multiverseid\': 385262}, {\'name\': \'Anjo Ilusório\', \'text\': \'Voar\\nConjure Anjo Ilusório somente se tiver conjurado outra mágica neste turno.\', \'type\': \'Criatura — Anjo Ilusão\', \'flavor\': \'"Tonto, eu acordei e olhei para o campo de batalha, onde posso jurar que meus sonhos estavam destruindo os inimigos." — Carta de um soldado\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385546&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'965a6af3-8598-4c8d-baf4-26babbd0cee3\', \'multiverseId\': 385546}, \'multiverseid\': 385546}, {\'name\': \'Иллюзорный Ангел\', \'text\': \'Полет\\nРазыгрывайте Иллюзорного Ангела, только если в этом ходу вы уже разыграли другое заклинание.\', \'type\': \'Существо — Ангел Иллюзия\', \'flavor\': \'«Очнувшись, я поднялся и удивленно оглядел поле боя. Могу поклясться: врагов крушили создания из моих грез». — письмо солдата\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385830&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0d45ce45-4345-4a07-bdd3-3ae1ffdeb234\', \'multiverseId\': 385830}, \'multiverseid\': 385830}, {\'name\': \'虚幻天使\', \'text\': \'飞行\\n只能于你已施放过其他咒语的回合中施放虚幻天使。\', \'type\': \'生物～天使／虚影\', \'flavor\': \'「朦胧之中，我醒转过来，茫然地看着战场周遭的一切；我敢发誓是我的迷梦在对敌人大开杀戒。」 ～士兵的来信\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383558&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a0934ce7-3da4-482d-85f7-92575fba5a33\', \'multiverseId\': 383558}, \'multiverseid\': 383558}, {\'name\': \'虛幻天使\', \'text\': \'飛行\\n只能於你已施放過其他咒語的回合中施放虛幻天使。\', \'type\': \'生物～天使／虛影\', \'flavor\': \'「朦朧之中，我醒轉過來，茫然地看著戰場周遭的一切；我敢發誓是我的迷夢在對敵人大開殺戒。」 ～士兵的來信\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383842&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'74405298-b6e9-4c7c-93ed-d251a8d4bbd2\', \'multiverseId\': 383842}, \'multiverseid\': 383842}]', '[{\'name\': \'Impulsives Handeln\', \'text\': \'Schicke die obersten drei Karten deiner Bibliothek ins Exil. Bis zum Ende des Zuges kannst du Karten spielen, die auf diese Weise ins Exil geschickt wurden. (Falls du auf diese Weise einen Zauberspruch wirkst, bezahlst du immer noch seine Kosten. Du kannst auf diese Weise nur dann ein Land spielen, falls du in diesem Zug noch eines spielen darfst.)\', \'type\': \'Hexerei\', \'flavor\': \'„Du willst nicht wissen, was geschieht, wenn ich die Schutzbrille aufgesetzt habe."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384028&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4c12dd25-28a8-4792-8279-730eecc570c0\', \'multiverseId\': 384028}, \'multiverseid\': 384028}, {\'name\': \'Actuar por impulso\', \'text\': \'Exilia las tres primeras cartas de tu biblioteca. Hasta el final del turno, puedes jugar las cartas exiliadas de esta manera. (Si lanzas un hechizo de esta manera, sigues pagando sus costes. Puedes jugar una tierra de esta manera solo si te queda una jugada de tierra disponible.)\', \'type\': \'Conjuro\', \'flavor\': \'"No te conviene saber lo que ocurre una vez que me pongo las gafas".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386016&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'10e64de1-9dbf-487f-b233-040204ca06fd\', \'multiverseId\': 386016}, \'multiverseid\': 386016}, {\'name\': \'Agir par impulsion\', \'text\': "Exilez les trois cartes du dessus de votre bibliothèque. Jusqu\'à la fin du tour, vous pouvez jouer les cartes exilées de cette manière. (Si vous lancez un sort de cette manière, vous payez toujours ses coûts. Vous ne pouvez jouer un terrain de cette manière que s\'il vous reste une mise en jeu de terrain disponible.)", \'type\': \'Rituel\', \'flavor\': \'« Jetons un voile pudique sur ce qui se passe une fois mes lunettes chaussées. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384312&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'495cc10b-8871-4b59-8add-f689bdcc3a1d\', \'multiverseId\': 384312}, \'multiverseid\': 384312}, {\'name\': "Agire d\'Impulso", \'text\': \'Esilia le prime tre carte del tuo grimorio. Fino alla fine del turno, puoi giocare le carte esiliate in questo modo. (Se lanci una magia in questo modo, paghi comunque i suoi costi. Puoi giocare una terra in questo modo solo se potresti giocarne una normalmente.)\', \'type\': \'Stregoneria\', \'flavor\': \'"Non vuoi sapere cosa succede quando mi metto gli occhialoni."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384596&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'216aec74-480b-41b5-a49f-7d79c4e2b945\', \'multiverseId\': 384596}, \'multiverseid\': 384596}, {\'name\': \'衝動的な行動\', \'text\': \'あなたのライブラリーの一番上から３枚のカードを追放する。ターン終了時まで、あなたはこれにより追放されたカードをプレイしてもよい。（あなたがこれにより呪文を唱えるなら、その呪文のコストは支払う必要がある。これにより土地をプレイするには、あなたは土地プレイを残している必要がある。）\', \'type\': \'ソーサリー\', \'flavor\': \'「私がゴーグルをつけたら何が起こるかなんて、知らないほうが身のためだよ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384880&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'40b8d2ca-7a66-438e-b430-421befb097df\', \'multiverseId\': 384880}, \'multiverseid\': 384880}, {\'name\': \'충동적인 행동\', \'text\': \'당신의 서고 맨 위의 카드 세 장을 추방한다. 턴종료까지, 당신은 이렇게 추방된 카드들을 플레이할 수 있다. (당신이 이런 식으로 주문을 발동하면, 당신은 여전히 그 주문의 비용을 지불한다. 당신은 대지를 플레이할 수 있는 경우에만 이런 식으로 대지를 플레이할 수 있다.)\', \'type\': \'집중마법\', \'flavor\': \'"내가 고글을 착용하면 무슨 일이 벌어지는지 모르는 게 낫다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385164&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6992ea4b-c443-45e9-886e-85637e407969\', \'multiverseId\': 385164}, \'multiverseid\': 385164}, {\'name\': \'Agir por Impulso\', \'text\': \'Exile os três cards do topo de seu grimório. Até o final do turno, você pode jogar os cards exilados desta maneira. (Se você conjura uma mágica desta maneira, ainda paga seus custos. Você só pode jogar um terreno desta forma se ainda puder jogar um terreno.)\', \'type\': \'Feitiço\', \'flavor\': \'"Você não quer saber o que acontece depois que eu coloco os óculos de proteção."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385448&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'773ea706-03de-4611-9426-069f1dbfb258\', \'multiverseId\': 385448}, \'multiverseid\': 385448}, {\'name\': \'Импульсивные Действия\', \'text\': \'Изгоните три верхние карты вашей библиотеки. До конца хода вы можете разыграть изгнанные таким образом карты. (Если вы разыгрываете таким образом заклинание, вы должны оплатить его стоимости. Вы можете разыграть таким образом землю, только если у вас осталась возможность разыгрывания земли в этом ходу.)\', \'type\': \'Волшебство\', \'flavor\': \'«Лучше не заставляй меня надевать очки!»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385732&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'22dd13fa-39af-4e0c-9a91-fd4f3ce40be3\', \'multiverseId\': 385732}, \'multiverseid\': 385732}, {\'name\': \'逞性妄为\', \'text\': \'放逐你牌库顶的三张牌。直到回合结束，你可以使用以此法放逐的牌。（如果你以此法施放咒语，你依旧要支付其费用。你只能于你仍有可使用地数的时候，才能以此法使用地。）\', \'type\': \'法术\', \'flavor\': \'「你不会想知道我戴上防护镜之后会发生什么。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383460&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8dd674b2-9210-4060-9487-fd0d269bc115\', \'multiverseId\': 383460}, \'multiverseid\': 383460}, {\'name\': \'逞性妄為\', \'text\': \'放逐你牌庫頂的三張牌。直到回合結束，你可以使用以此法放逐的牌。（如果你以此法施放咒語，你依舊要支付其費用。你只能於你仍有可使用地數的時候，才能以此法使用地。）\', \'type\': \'巫術\', \'flavor\': \'「你不會想知道我戴上防護鏡之後會發生什麼。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383744&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8c7e7360-0ae7-4c19-ace1-b6e578d59e4b\', \'multiverseId\': 383744}, \'multiverseid\': 383744}]', '[{\'name\': \'In die Leere\', \'text\': \'Bringe bis zu zwei Kreaturen deiner Wahl auf die Hand ihrer Besitzer zurück.\', \'type\': \'Hexerei\', \'flavor\': \'„Die Katharer haben ihre Schwerter, die Inquisitoren ihre Äxte. Ich bevorzuge den ‚diplomatischen\\\' Ansatz." —Therhold, Erzmagier von Durnau\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384130&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'248a0dda-73d2-4fd5-8893-d8c6bb3f1e4a\', \'multiverseId\': 384130}, \'multiverseid\': 384130}, {\'name\': \'Empujar al vacío\', \'text\': \'Regresa hasta dos criaturas objetivo a las manos de sus propietarios.\', \'type\': \'Conjuro\', \'flavor\': \'"Los cátaros tienen espadas y los inquisidores hachas. Yo prefiero el enfoque \\\'diplomático\\\'". —Terhold, archimago de Drunau\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386118&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'40de657e-0fd2-4bdc-b4ad-64b78aabe97b\', \'multiverseId\': 386118}, \'multiverseid\': 386118}, {\'name\': \'Vers le néant\', \'text\': "Renvoyez jusqu\'à deux créatures ciblées dans les mains de leurs propriétaires.", \'type\': \'Rituel\', \'flavor\': "« Les cathares ont leur épée, les inquisiteurs leur hache. Je préfère quant à moi l\'approche… diplomatique. » —Terhold, archimage de Drunaü", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384414&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'149f4a16-5aa8-4738-b0be-1db98f3a36e4\', \'multiverseId\': 384414}, \'multiverseid\': 384414}, {\'name\': \'Nel Vuoto\', \'text\': \'Fai tornare fino a due creature bersaglio in mano ai rispettivi proprietari.\', \'type\': \'Stregoneria\', \'flavor\': \'"I catari brandiscono le spade, gli inquisitori impugnano le asce. Io preferisco un approccio più... diplomatico." —Terhold, arcimago di Drunau\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384698&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ddfd913f-6a65-4be9-8302-ddb09d5ced52\', \'multiverseId\': 384698}, \'multiverseid\': 384698}, {\'name\': \'虚空への突入\', \'text\': \'クリーチャーを最大２体まで対象とし、それらをオーナーの手札に戻す。\', \'type\': \'ソーサリー\', \'flavor\': \'「聖戦士には剣が、審問官には斧がある。だがわしは『外交的』な手段を望んでおる。」 ――ドルナウの大魔導師、ターホールド\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384982&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d33751a1-0c13-4a4e-9057-ed00c0566ec5\', \'multiverseId\': 384982}, \'multiverseid\': 384982}, {\'name\': \'심연 속으로\', \'text\': \'최대 두 개까지의 생물을 목표로 정한다. 그 생물들을 소유자의 손으로 되돌린다.\', \'type\': \'집중마법\', \'flavor\': \'"카타르들은 칼을, 이단심문관들은 도끼를 사용하지. 난 \\\'외교적인\\\' 접근 방식을 선호해." —드루나우의 대마법사 테르홀드\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385266&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'62f23888-65e6-4651-9915-36aa038c9ff8\', \'multiverseId\': 385266}, \'multiverseid\': 385266}, {\'name\': \'Ao Vácuo\', \'text\': \'Devolva até duas criaturas alvo para as mãos de seus donos.\', \'type\': \'Feitiço\', \'flavor\': \'"Os cátaros têm suas espadas; os inquisidores, seus machados. Eu prefiro a abordagem \\\'diplomática\\\'." — Terhold, arquimago de Drunau\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385550&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'759189fa-6e52-496a-a3f9-fa4e9a47d3e0\', \'multiverseId\': 385550}, \'multiverseid\': 385550}, {\'name\': \'Навстречу Пустоте\', \'text\': \'Верните не более двух целевых существ в руки их владельцев.\', \'type\': \'Волшебство\', \'flavor\': \'«Катары сражаются мечами, инквизиторы — топорами. Я же предпочитаю... дипломатический подход». — Терхольд, архимаг Друнау\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385834&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b8e2aa6e-e21a-4bc6-a270-720ffee4e9ab\', \'multiverseId\': 385834}, \'multiverseid\': 385834}, {\'name\': \'驱入虚空\', \'text\': \'将至多两个目标生物移回其拥有者手上。\', \'type\': \'法术\', \'flavor\': \'「护教军有剑，审判官有斧。我偏好『外交』手段。」 ～杜瑙大法师忒候\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383562&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ab2eb75b-b0ff-4b4c-a801-1d577e0a8ad0\', \'multiverseId\': 383562}, \'multiverseid\': 383562}, {\'name\': \'驅入虛空\', \'text\': \'將至多兩個目標生物移回擁有者手上。\', \'type\': \'巫術\', \'flavor\': \'「護教軍有劍，審判官有斧。我偏好『外交』手段。」 ～杜瑙大法師忒候\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383846&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'09d88e66-e97a-4d9b-9b97-eaae61e5a1c3\', \'multiverseId\': 383846}, \'multiverseid\': 383846}]', '[{\'name\': \'Inbild der ewigen Wildnis\', \'text\': \'Andere grüne Kreaturen, die du kontrollierst, erhalten +1/+1.\\n{G}, {T}: Eine andere grüne Kreatur deiner Wahl, die du kontrollierst, verursacht Trampelschaden bis zum Ende des Zuges. (Falls sie ihren Blockern genug Schaden zuweisen würde, um sie zu zerstören, kannst du sie den Rest des Schadens dem verteidigenden Spieler oder Planeswalker zuweisen lassen.)\', \'type\': \'Kreatur — Mensch, Druide\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384188&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'24a0a53f-f98e-410f-a84e-974c4847a377\', \'multiverseId\': 384188}, \'multiverseid\': 384188}, {\'name\': \'Ejemplar de los bosques eternos\', \'text\': \'Las otras criaturas verdes que controlas obtienen +1/+1.\\n{G}, {T}: Otra criatura objetivo verde que controlas gana la habilidad de arrollar hasta el final del turno. (Si fuera a asignar suficiente daño a sus bloqueadores como para destruirlos, puedes hacer que le asigne el resto del daño al jugador o planeswalker defensor.)\', \'type\': \'Criatura — Druida humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386176&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e84ce6c5-82e4-4d43-9950-931e9665540e\', \'multiverseId\': 386176}, \'multiverseid\': 386176}, {\'name\': \'Parangon de la nature éternelle\', \'text\': "Les autres créatures vertes que vous contrôlez gagnent +1/+1.\\n{G}, {T} : Une autre créature verte ciblée que vous contrôlez acquiert le piétinement jusqu\'à la fin du tour. (Si elle attribue suffisamment de blessures de combat à ses bloqueurs pour les détruire, vous pouvez faire qu\'elle attribue le reste de ses blessures au joueur ou au planeswalker défenseur.)", \'type\': \'Créature : humain et druide\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384472&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'16f69e3f-0615-4bfc-b48d-902d70355776\', \'multiverseId\': 384472}, \'multiverseid\': 384472}, {\'name\': \'Paradigma delle Terre Selvagge Eterne\', \'text\': "Le altre creature verdi che controlli prendono +1/+1.\\n{G}, {T}: Un\'altra creatura verde bersaglio che controlli ha travolgere fino alla fine del turno. (Se sta per assegnare alle sue creature bloccanti danno sufficiente a distruggerle, puoi farle assegnare il resto del suo danno al giocatore in difesa o a un planeswalker.)", \'type\': \'Creatura — Druido Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384756&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c6a3e3ce-0734-470b-a009-d6ae3f6b06f1\', \'multiverseId\': 384756}, \'multiverseid\': 384756}, {\'name\': \'永遠の荒野の模範\', \'text\': \'あなたがコントロールする他の緑のクリーチャーは＋１/＋１の修整を受ける。\\n{G}, {T}：あなたがコントロールする他の緑のクリーチャー１体を対象とする。それはターン終了時までトランプルを得る。（それが自身をブロックしているすべてのクリーチャーを破壊するのに十分なダメージを割り振ったなら、あなたはそれの残りのダメージを防御プレイヤーかプレインズウォーカーに割り振ってもよい。）\', \'type\': \'クリーチャー — 人間・ドルイド\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385040&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'53917cb7-cc21-4bc5-8efb-3a99906652e9\', \'multiverseId\': 385040}, \'multiverseid\': 385040}, {\'name\': \'영원한 야생의 귀감\', \'text\': \'당신이 조종하는 다른 녹색 생물들은 +1/+1을 받는다.\\n{G}, {T}: 당신이 조종하는 다른 녹색 생물을 목표로 정한다. 그 생물은 턴종료까지 돌진을 얻는다. (이 생물이 자신을 방어하는 생물을 파괴하기에 충분한 피해를 배정했다면, 나머지 피해는 수비플레이어나 플레인즈워커에게 배정할 수 있다.)\', \'type\': \'생물 — 인간 드루이드\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385324&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c8a33159-30b3-40dd-a925-a9c639d05dd7\', \'multiverseId\': 385324}, \'multiverseid\': 385324}, {\'name\': \'Paradigma das Selvas Eternas\', \'text\': \'As outras criaturas verdes que você controla recebem +1/+1.\\n{G}, {T}: Outra criatura alvo verde que você controla ganha atropelar até o final do turno. (Se ela for atribuir dano suficiente para destruir seus bloqueadores, você poderá fazer com que ela atribua o resto de seu dano ao planeswalker ou jogador defensor.)\', \'type\': \'Criatura — Humano Druida\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385608&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'685e4930-237a-4418-9d64-02958634255d\', \'multiverseId\': 385608}, \'multiverseid\': 385608}, {\'name\': \'Образец Вековечных Дебрей\', \'text\': \'Другие зеленые существа под вашим контролем получают +1/+1.\\n{G}, {T}: другое целевое зеленое существо под вашим контролем получает Пробивной удар до конца хода. (Если оно распределяет достаточно повреждений, чтобы уничтожить блокирующие его существа, вы можете заставить его распределить оставшиеся повреждения защищающемуся игроку или planeswalker-у.)\', \'type\': \'Существо — Человек Друид\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385892&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'378764b8-46a1-4e60-bfff-ba07801f6485\', \'multiverseId\': 385892}, \'multiverseid\': 385892}, {\'name\': \'永野守护者\', \'text\': \'由你操控的其他绿色生物得+1/+1。\\n{G}，{T}：另一个目标由你操控的绿色生物获得践踏异能直到回合结束。（如果它将分配的伤害足以消灭所有阻挡它的生物，你可以将它所剩余数量的伤害分配给防御牌手或鹏洛客。）\', \'type\': \'生物～人类／德鲁伊\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383620&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c6e792c7-a121-4687-8e77-c9e77416a2a1\', \'multiverseId\': 383620}, \'multiverseid\': 383620}, {\'name\': \'永野守護者\', \'text\': \'由你操控的其他綠色生物得+1/+1。\\n{G}，{T}：另一個目標由你操控的綠色生物獲得踐踏異能直到回合結束。（如果它將分配的傷害足以消滅所有阻擋它的生物，你可以將它所剩餘數量的傷害分配給防禦玩家或鵬洛客。）\', \'type\': \'生物～人類／德魯伊\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383904&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'911a8527-0fba-48d4-a858-1f5b18ef5567\', \'multiverseId\': 383904}, \'multiverseid\': 383904}]', '[{\'name\': \'Inbild der neuen Morgenröte\', \'text\': \'Andere weiße Kreaturen, die du kontrollierst, erhalten +1/+1.\\n{W}, {T}: Eine andere weiße Kreatur deiner Wahl, die du kontrollierst, erhält Wachsamkeit bis zum Ende des Zuges. (Sie wird beim Angreifen nicht getappt.)\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384191&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5edc909e-55e3-4492-ae7c-f75319da6ddd\', \'multiverseId\': 384191}, \'multiverseid\': 384191}, {\'name\': \'Ejemplar de nuevos amaneceres\', \'text\': \'Las otras criaturas blancas que controlas obtienen +1/+1.\\n{W}, {T}: Otra criatura objetivo blanca que controlas gana la habilidad de vigilancia hasta el final del turno. (Esta criatura no se gira al atacar.)\', \'type\': \'Criatura — Soldado humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386179&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b438024b-0d5d-44f4-9da0-a96de9f8bcf9\', \'multiverseId\': 386179}, \'multiverseid\': 386179}, {\'name\': \'Parangon des aubes nouvelles\', \'text\': "Les autres créatures blanches que vous contrôlez gagnent +1/+1.\\n{W}, {T} : Une autre créature blanche ciblée que vous contrôlez acquiert la vigilance jusqu\'à la fin du tour. (Attaquer avec cette créature ne la fait pas s\'engager.)", \'type\': \'Créature : humain et soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384475&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3c84a79b-33d5-4013-9e67-fb3cf82726e8\', \'multiverseId\': 384475}, \'multiverseid\': 384475}, {\'name\': \'Paradigma delle Nuove Albe\', \'text\': "Le altre creature bianche che controlli prendono +1/+1.\\n{W}, {T}: Un\'altra creatura bianca bersaglio che controlli ha cautela fino alla fine del turno. (Attacca senza TAPpare.)", \'type\': \'Creatura — Soldato Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384759&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eaa0384d-dd20-41f1-a656-d360ff9ec13a\', \'multiverseId\': 384759}, \'multiverseid\': 384759}, {\'name\': \'新たな夜明けの模範\', \'text\': \'あなたがコントロールする他の白のクリーチャーは＋１/＋１の修整を受ける。\\n{W}, {T}：あなたがコントロールする他の白のクリーチャー１体を対象とする。それはターン終了時まで警戒を得る。（それは攻撃してもタップしない。）\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385043&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d876dd5e-6ca5-47da-b9dd-b978a80f13d9\', \'multiverseId\': 385043}, \'multiverseid\': 385043}, {\'name\': \'새로운 여명의 귀감\', \'text\': \'당신이 조종하는 다른 백색 생물들은 +1/+1을 받는다.\\n{W}, {T}: 당신이 조종하는 다른 백색 생물을 목표로 정한다. 그 생물은 턴종료까지 경계를 얻는다. (그 생물은 공격하면서 탭되지 않는다.)\', \'type\': \'생물 — 인간 병사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385327&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f14b7537-f390-4a20-a7cb-a33047af1ddf\', \'multiverseId\': 385327}, \'multiverseid\': 385327}, {\'name\': \'Paradigma das Novas Auroras\', \'text\': \'As outras criaturas brancas que você controla recebem +1/+1.\\n{W}, {T}: Outra criatura alvo branca que você controla ganha vigilância até o final do turno. (Esta criatura não é virada para atacar.)\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385611&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2cccbb29-a338-4df6-8557-bb023fe550eb\', \'multiverseId\': 385611}, \'multiverseid\': 385611}, {\'name\': \'Образец Новой Зари\', \'text\': \'Другие белые существа под вашим контролем получают +1/+1.\\n{W}, {T}: другое целевое белое существо под вашим контролем получает Бдительность до конца хода. (Атакуя, оно не поворачивается.)\', \'type\': \'Существо — Человек Солдат\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385895&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7a41a53e-3b8a-45cd-9d74-6a3d485c39f2\', \'multiverseId\': 385895}, \'multiverseid\': 385895}, {\'name\': \'新黎明守护者\', \'text\': \'由你操控的其他白色生物得+1/+1。\\n{W}，{T}：另一个目标由你操控的白色生物获得警戒异能直到回合结束。（它攻击时不需横置。）\', \'type\': \'生物～人类／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383623&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'af7c7243-25aa-4981-9eeb-08600bf9aef6\', \'multiverseId\': 383623}, \'multiverseid\': 383623}, {\'name\': \'新黎明守護者\', \'text\': \'由你操控的其他白色生物得+1/+1。\\n{W}，{T}：另一個目標由你操控的白色生物獲得警戒異能直到回合結束。（它攻擊時不需橫置。）\', \'type\': \'生物～人類／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383907&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c9159841-652b-4369-95e1-6d0e25c10e96\', \'multiverseId\': 383907}, \'multiverseid\': 383907}]', '[{\'name\': \'Inbild der offenen Gräber\', \'text\': \'Andere schwarze Kreaturen, die du kontrollierst, erhalten +1/+1.\\n{2}{B}, {T}: Eine andere schwarze Kreatur deiner Wahl, die du kontrollierst, erhält Todesberührung bis zum Ende des Zuges. (Eine beliebige Menge Schadenspunkte, die sie einer Kreatur zufügt, sind ausreichend, um diese zu zerstören.)\', \'type\': \'Kreatur — Skelett, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384192&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f13cd6e3-6e61-4805-916e-b954e04ffe3c\', \'multiverseId\': 384192}, \'multiverseid\': 384192}, {\'name\': \'Ejemplar de las tumbas abiertas\', \'text\': \'Las otras criaturas negras que controlas obtienen +1/+1.\\n{2}{B}, {T}: Otra criatura objetivo negra que controlas gana la habilidad de toque mortal hasta el final del turno. (Cualquier cantidad de daño que haga a una criatura es suficiente para destruirla.)\', \'type\': \'Criatura — Guerrero esqueleto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386180&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e2a1aa78-6537-4a3d-a2c0-c373c7ec015d\', \'multiverseId\': 386180}, \'multiverseid\': 386180}, {\'name\': \'Parangon des tombeaux béants\', \'text\': "Les autres créatures noires que vous contrôlez gagnent +1/+1.\\n{2}{B}, {T} : Une autre créature noire ciblée que vous contrôlez acquiert le contact mortel jusqu\'à la fin du tour. (Le nombre de blessures qu\'elle inflige à une créature, quel qu\'il soit, est suffisant pour la détruire.)", \'type\': \'Créature : squelette et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384476&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b0db3539-70b7-415d-8e24-3aa219a01b9b\', \'multiverseId\': 384476}, \'multiverseid\': 384476}, {\'name\': \'Paradigma delle Tombe Aperte\', \'text\': "Le altre creature nere che controlli prendono +1/+1.\\n{2}{B}, {T}: Un\'altra creatura nera bersaglio che controlli ha tocco letale fino alla fine del turno. (Qualsiasi danno che infligge a una creatura è sufficiente a distruggerla.)", \'type\': \'Creatura — Guerriero Scheletro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384760&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e2b804c1-c17b-4ee0-b918-3577a06edaef\', \'multiverseId\': 384760}, \'multiverseid\': 384760}, {\'name\': \'墓穴の模範\', \'text\': \'あなたがコントロールする他の黒のクリーチャーは＋１/＋１の修整を受ける。\\n{2}{B}, {T}：あなたがコントロールする他の黒のクリーチャー１体を対象とする。それはターン終了時まで接死を得る。（これが何らかのダメージをクリーチャーに与えたら、それだけで破壊する。）\', \'type\': \'クリーチャー — スケルトン・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385044&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'526b398c-3581-410f-85a0-c70c3f686438\', \'multiverseId\': 385044}, \'multiverseid\': 385044}, {\'name\': \'열린 무덤의 귀감\', \'text\': \'당신이 조종하는 다른 흑색 생물들은 +1/+1을 받는다.\\n{2}{B}, {T}: 당신이 조종하는 다른 흑색 생물을 목표로 정한다. 그 생물은 턴종료까지 치명타를 얻는다. (이 생물에게 피해를 입은 생물은 입은 피해의 양에 상관없이 파괴된다.)\', \'type\': \'생물 — 해골 전사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385328&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3eb24f64-5c2c-4ad6-8b43-0c736e60e166\', \'multiverseId\': 385328}, \'multiverseid\': 385328}, {\'name\': \'Paradigma das Covas Abertas\', \'text\': \'As outras criaturas pretas que você controla recebem +1/+1.\\n{2}{B}, {T}: Outra criatura alvo preta que você controla ganha toque mortífero até o final do turno. (Qualquer quantidade de dano que ela cause a uma criatura é suficiente para destruí-la.)\', \'type\': \'Criatura — Esqueleto Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385612&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1a9f0711-0320-49b8-9b9b-9aad75c449a5\', \'multiverseId\': 385612}, \'multiverseid\': 385612}, {\'name\': \'Образец Разрытых Могил\', \'text\': \'Другие черные существа под вашим контролем получают +1/+1.\\n{2}{B}, {T}: другое целевое черное существо под вашим контролем получает Смертельное касание до конца хода. (Любое количество повреждений, которое оно наносит существу, достаточно, чтобы его уничтожить.)\', \'type\': \'Существо — Скелет Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385896&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'413f9aa8-746b-456c-ae2e-67946975e7b0\', \'multiverseId\': 385896}, \'multiverseid\': 385896}, {\'name\': \'敞坟守护者\', \'text\': \'由你操控的其他黑色生物得+1/+1。\\n{2}{B}，{T}：另一个目标由你操控的黑色生物获得死触异能直到回合结束。（它对生物造成的任何数量伤害都足以消灭后者。）\', \'type\': \'生物～骷髅妖／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383624&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bb0e6312-9e0f-4db1-97a3-b55c87921dbc\', \'multiverseId\': 383624}, \'multiverseid\': 383624}, {\'name\': \'敞墳守護者\', \'text\': \'由你操控的其他黑色生物得+1/+1。\\n{2}{B}，{T}：另一個目標由你操控的黑色生物獲得死觸異能直到回合結束。（它對生物造成的任何數量傷害都足以消滅後者。）\', \'type\': \'生物～骷髏妖／戰士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383908&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4118beea-1605-4129-8a1b-49729bf7c05c\', \'multiverseId\': 383908}, \'multiverseid\': 383908}]', '[{\'name\': \'Inbild des erbitterten Widerstandes\', \'text\': \'Andere rote Kreaturen, die du kontrollierst, erhalten +1/+1.\\n{R}, {T}: Eine andere rote Kreatur deiner Wahl, die du kontrollierst, erhält Eile bis zum Ende des Zuges. (Sie kann in diesem Zug angreifen und {T}.)\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384189&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f2d0aae6-5c23-4e62-abb8-72a511401e07\', \'multiverseId\': 384189}, \'multiverseid\': 384189}, {\'name\': \'Ejemplar de la rebelión indomable\', \'text\': \'Las otras criaturas rojas que controlas obtienen +1/+1.\\n{R}, {T}: Otra criatura objetivo roja que controlas gana la habilidad de prisa hasta el final del turno. (Puede atacar y {T} este turno.)\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386177&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9b2d2512-0656-4dd5-a742-8c54566d45c6\', \'multiverseId\': 386177}, \'multiverseid\': 386177}, {\'name\': \'Parangon de défiance féroce\', \'text\': "Les autres créatures rouges que vous contrôlez gagnent +1/+1.\\n{R}, {T} : Une autre créature rouge ciblée que vous contrôlez acquiert la célérité jusqu\'à la fin du tour. (Elle peut attaquer et {T} ce tour-ci.)", \'type\': \'Créature : humain et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384473&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'766433b3-4e5c-4f5d-85ea-755062ede1c0\', \'multiverseId\': 384473}, \'multiverseid\': 384473}, {\'name\': \'Paradigma dello Sprezzo Impetuoso\', \'text\': "Le altre creature rosse che controlli prendono +1/+1.\\n{R}, {T}: Un\'altra creatura rossa bersaglio che controlli ha rapidità fino alla fine del turno. (Può attaccare e {T} in questo turno.)", \'type\': \'Creatura — Guerriero Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384757&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5c8d418f-7ecb-4b4b-8994-93c2fc77d676\', \'multiverseId\': 384757}, \'multiverseid\': 384757}, {\'name\': \'激しい抵抗の模範\', \'text\': \'あなたがコントロールする他の赤のクリーチャーは＋１/＋１の修整を受ける。\\n{R}, {T}：あなたがコントロールする他の赤のクリーチャー１体を対象とする。それはターン終了時まで速攻を得る。（このターン、それは攻撃したり{T}したりできる。）\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385041&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ed36764c-1f44-4f87-bb43-8649c1a10427\', \'multiverseId\': 385041}, \'multiverseid\': 385041}, {\'name\': \'격렬한 반항의 귀감\', \'text\': \'당신이 조종하는 다른 적색 생물들은 +1/+1을 받는다.\\n{R}, {T}: 당신이 조종하는 다른 적색 생물을 목표로 정한다. 그 생물은 턴종료까지 신속을 얻는다. (이 턴에 이 생물은 공격하거나 {T}할 수 있다.)\', \'type\': \'생물 — 인간 전사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385325&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7dea7e47-e9ef-47ab-b58d-88fae3cd3d46\', \'multiverseId\': 385325}, \'multiverseid\': 385325}, {\'name\': \'Paradigma do Desafio Feroz\', \'text\': \'As outras criaturas vermelhas que você controla recebem +1/+1.\\n{R}, {T}: Outra criatura alvo vermelha que você controla ganha ímpeto até o final do turno. (Ela pode atacar e {T} neste turno.)\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385609&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'adc312da-a5c9-4853-8b2f-8b4eb28d45ce\', \'multiverseId\': 385609}, \'multiverseid\': 385609}, {\'name\': \'Образец Яростной Непокорности\', \'text\': \'Другие красные существа под вашим контролем получают +1/+1.\\n{R}, {T}: другое целевое красное существо под вашим контролем получает Ускорение до конца хода. (Оно может атаковать и {T} в этом ходу.)\', \'type\': \'Существо — Человек Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385893&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7d3b83f2-3343-4dde-a409-9c4213b0d27f\', \'multiverseId\': 385893}, \'multiverseid\': 385893}, {\'name\': \'众威守护者\', \'text\': \'由你操控的其他红色生物得+1/+1。\\n{R}，{T}：另一个目标由你操控的红色生物获得敏捷异能直到回合结束。（它此回合便能攻击与{T}。）\', \'type\': \'生物～人类／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383621&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'09a6e26b-fb14-4728-9839-3771094d1494\', \'multiverseId\': 383621}, \'multiverseid\': 383621}, {\'name\': \'眾威守護者\', \'text\': \'由你操控的其他紅色生物得+1/+1。\\n{R}，{T}：另一個目標由你操控的紅色生物獲得敏捷異能直到回合結束。（它此回合便能攻擊與{T}。）\', \'type\': \'生物～人類／戰士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383905&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'cbba9d56-f5ee-4137-b598-ea641bcc7a90\', \'multiverseId\': 383905}, \'multiverseid\': 383905}]', '[{\'name\': \'Inbild des heraufziehenden Nebels\', \'text\': \'Andere blaue Kreaturen, die du kontrollierst, erhalten +1/+1.\\n{U}, {T}: Eine andere blaue Kreatur deiner Wahl, die du kontrollierst, erhält Flugfähigkeit bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384190&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'44734b66-f34d-4592-bec7-6d6591278526\', \'multiverseId\': 384190}, \'multiverseid\': 384190}, {\'name\': \'Ejemplar de la niebla profunda\', \'text\': \'Las otras criaturas azules que controlas obtienen +1/+1.\\n{U}, {T}: Otra criatura objetivo azul que controlas gana la habilidad de volar hasta el final del turno.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386178&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'68eb36fd-8a22-483d-b50f-25f1e4ea6bd4\', \'multiverseId\': 386178}, \'multiverseid\': 386178}, {\'name\': \'Parangon des brumes coalescentes\', \'text\': "Les autres créatures bleues que vous contrôlez gagnent +1/+1.\\n{U}, {T} : Une autre créature bleue ciblée que vous contrôlez acquiert le vol jusqu\'à la fin du tour.", \'type\': \'Créature : humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384474&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'67ffb677-9885-496b-a63c-38c728eacc8e\', \'multiverseId\': 384474}, \'multiverseid\': 384474}, {\'name\': \'Paradigma delle Nebbie Incombenti\', \'text\': "Le altre creature blu che controlli prendono +1/+1.\\n{U}, {T}: Un\'altra creatura blu bersaglio che controlli ha volare fino alla fine del turno.", \'type\': \'Creatura — Mago Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384758&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6e95a61a-bf72-4d4b-935d-5de150bff76d\', \'multiverseId\': 384758}, \'multiverseid\': 384758}, {\'name\': \'立ちこめる霧の模範\', \'text\': \'あなたがコントロールする他の青のクリーチャーは＋１/＋１の修整を受ける。\\n{U}, {T}：あなたがコントロールする他の青のクリーチャー１体を対象とする。それはターン終了時まで飛行を得る。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385042&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5103cd0b-8a89-440e-a9b1-70ed717fc271\', \'multiverseId\': 385042}, \'multiverseid\': 385042}, {\'name\': \'몰려오는 안개의 귀감\', \'text\': \'당신이 조종하는 다른 청색 생물들은 +1/+1을 받는다.\\n{U}, {T}: 당신이 조종하는 다른 청색 생물을 목표로 정한다. 그 생물은 턴종료까지 비행을 얻는다.\', \'type\': \'생물 — 인간 마법사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385326&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'39fa34d4-be8d-4938-859d-b289600b14ed\', \'multiverseId\': 385326}, \'multiverseid\': 385326}, {\'name\': \'Paradigma das Névoas Crescentes\', \'text\': \'As outras criaturas azuis que você controla recebem +1/+1.\\n{U}, {T}: Outra criatura alvo azul que você controla ganha voar até o final do turno.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385610&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3933945a-3366-4acb-9d1f-f7f2b231c390\', \'multiverseId\': 385610}, \'multiverseid\': 385610}, {\'name\': \'Образец Сгустившегося Тумана\', \'text\': \'Другие синие существа под вашим контролем получают +1/+1.\\n{U}, {T}: другое целевое синее существо под вашим контролем получает Полет до конца хода.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385894&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b7bc8e24-ba8f-4847-aa1e-8267993fe37c\', \'multiverseId\': 385894}, \'multiverseid\': 385894}, {\'name\': \'幔雾守护者\', \'text\': \'由你操控的其他蓝色生物得+1/+1。\\n{U}，{T}：另一个目标由你操控的蓝色生物获得飞行异能直到回合结束。\', \'type\': \'生物～人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383622&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3820ee84-fd5f-4935-a1d5-262ca82f1360\', \'multiverseId\': 383622}, \'multiverseid\': 383622}, {\'name\': \'幔霧守護者\', \'text\': \'由你操控的其他藍色生物得+1/+1。\\n{U}，{T}：另一個目標由你操控的藍色生物獲得飛行異能直到回合結束。\', \'type\': \'生物～人類／魔法師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383906&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fe5d4767-c53b-458e-9ec1-33f14b5d78ad\', \'multiverseId\': 383906}, \'multiverseid\': 383906}]', '[{\'name\': \'Inferno-Faust\', \'text\': \'Verzaubert eine Kreatur, die du kontrollierst\\nDie verzauberte Kreatur erhält +2/+0.\\n{R}, opfere die Inferno-Faust: Die Inferno-Faust fügt einer Kreatur oder einem Spieler deiner Wahl 2 Schadenspunkte zu.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Ich war mir noch nie zu schade dafür, den ersten Schlag zu landen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384129&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8242b934-06f2-44a4-b63d-7940a02d444e\', \'multiverseId\': 384129}, \'multiverseid\': 384129}, {\'name\': \'Puño infernal\', \'text\': \'Encantar criatura que controlas.\\nLa criatura encantada obtiene +2/+0.\\n{R}, sacrificar el Puño infernal: El Puño infernal hace 2 puntos de daño a la criatura o jugador objetivo.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"Nunca he pensado que me rebajara por dar el primer puñetazo".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386117&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e1a003b9-e4d4-4b77-9f21-87b1a94e984d\', \'multiverseId\': 386117}, \'multiverseid\': 386117}, {\'name\': \'Poing infernal\', \'text\': \'Enchanter : une créature que vous contrôlez\\nLa créature enchantée gagne +2/+0.\\n{R}, sacrifiez le Poing infernal : Le Poing infernal inflige 2 blessures à une cible, créature ou joueur.\', \'type\': \'Enchantement : aura\', \'flavor\': "« Je n\'ai jamais hésité à frapper la première. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384413&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e34d7dc7-e87b-40d3-93c9-ba862e6bc8ff\', \'multiverseId\': 384413}, \'multiverseid\': 384413}, {\'name\': \'Pugno Infernale\', \'text\': \'Incanta creatura che controlli\\nLa creatura incantata prende +2/+0.\\n{R}, Sacrifica il Pugno Infernale: Il Pugno Infernale infligge 2 danni a una creatura o a un giocatore bersaglio.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Non ho mai esitato quando si è trattato di sferrare il primo pugno."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384697&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c4c2cfd3-e064-4e7e-be82-698d6d991d0b\', \'multiverseId\': 384697}, \'multiverseid\': 384697}, {\'name\': \'業火の拳\', \'text\': \'エンチャント（あなたがコントロールするクリーチャー）\\nエンチャントされているクリーチャーは＋２/＋０の修整を受ける。\\n{R}, 業火の拳を生け贄に捧げる：クリーチャー１体かプレイヤー１人を対象とする。業火の拳はそれに２点のダメージを与える。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「最初の一撃をお見舞いする以外、したことが無いな。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=384981&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fe3fef15-f246-4ccd-83e3-ee83fc943aab\', \'multiverseId\': 384981}, \'multiverseid\': 384981}, {\'name\': \'지옥불 주먹\', \'text\': \'자신이 조종하는 생물에게 부여\\n부여된 생물은 +2/+0을 받는다.\\n{R}, 지옥불 주먹을 희생한다: 생물이나 플레이어를 목표로 정한다. 지옥불 주먹은 그 목표에게 피해 2점을 입힌다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'"먼저 공격하는 게 중요해."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385265&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1cdcc6dd-7c77-40bd-8553-31d84687478d\', \'multiverseId\': 385265}, \'multiverseid\': 385265}, {\'name\': \'Punho Infernal\', \'text\': \'Encantar criatura que você controla\\nA criatura encantada recebe +2/+0.\\n{R}, Sacrifique Punho Infernal: Punho Infernal causa 2 pontos de dano à criatura ou ao jogador alvo.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Eu nunca consegui não dar o primeiro soco."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385549&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fa2520a9-875a-49b0-86b0-a64b02181538\', \'multiverseId\': 385549}, \'multiverseid\': 385549}, {\'name\': \'Кулак Пожара\', \'text\': \'Зачаровать существо под вашим контролем\\nЗачарованное существо получает +2/+0.\\n{R}, пожертвуйте Кулак Пожара: Кулак Пожара наносит 2 повреждения целевому существу или игроку.\', \'type\': \'Чары — Аура\', \'flavor\': \'«Я никогда не стеснялась ударить первой».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=385833&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2cdce7ea-343e-46d2-bc41-294571bf78ed\', \'multiverseId\': 385833}, \'multiverseid\': 385833}, {\'name\': \'炼狱冲拳\', \'text\': \'结附于由你操控的生物\\n所结附的生物得+2/+0。\\n{R}，牺牲炼狱冲拳：炼狱冲拳对目标生物或牌手造成2点伤害。\', \'type\': \'结界～灵气\', \'flavor\': \'「我可不在乎挥出第一拳。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383561&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1eecc10b-81b8-4024-97c0-bdee0eadac6d\', \'multiverseId\': 383561}, \'multiverseid\': 383561}, {\'name\': \'煉獄衝拳\', \'text\': \'結附於由你操控的生物\\n所結附的生物得+2/+0。\\n{R}，犧牲煉獄衝拳：煉獄衝拳對目標生物或玩家造成2點傷害。\', \'type\': \'結界～靈氣\', \'flavor\': \'「我可不在乎揮出第一拳。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=383845&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2ac99e6c-8617-4c12-b80f-c697a1f1aa4a\', \'multiverseId\': 383845}, \'multiverseid\': 383845}]', "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'im