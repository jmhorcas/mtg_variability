type: ['Artifact', 'Artifact Creature — Thopter', 'Creature — Elemental Beast', 'Creature — Elf Shaman', 'Creature — Elf Warrior', 'Creature — Goblin', 'Creature — Human Cleric', 'Creature — Human Monk', 'Creature — Human Shaman', 'Creature — Kithkin Knight', 'Creature — Specter', 'Creature — Zombie', 'Enchantment', 'Instant', 'Legendary Creature — Human Soldier', 'Sorcery']
supertypes: ['Legendary']
subtypes: ['Beast', 'Cleric', 'Elemental', 'Elf', 'Goblin', 'Human', 'Kithkin', 'Knight', 'Monk', 'Shaman', 'Soldier', 'Specter', 'Thopter', 'Warrior', 'Zombie']
rarity: ['Common', 'Rare', 'Uncommon']
text: ['At the beginning of your upkeep, you draw a card and you lose 1 life.', 'Choose a creature type. Draw a card for each permanent you control of that type.', 'Flying', 'Flying\\nWhenever Hypnotic Specter deals damage to an opponent, that player discards a card at random.', "If target player has exactly 10 life, Hidetsugu's Second Rite deals 10 damage to that player.", 'Indestructible (Effects that say "destroy" don\'t destroy this artifact.)\\nAt the beginning of your upkeep, you may put a charge counter on Darksteel Reactor.\\nWhen Darksteel Reactor has twenty or more charge counters on it, you win the game.', 'Knight creatures you control have double strike.', 'Lifelink (Damage dealt by this creature also causes you to gain that much life.)\\nAs long as you have 30 or more life, Serra Ascendant gets +5/+5 and has flying.', 'Other Elves you control get +1/+1.\\n{G}, {T}: Create a 1/1 green Elf Warrior creature token.', 'Reveal cards from the top of your library until you reveal a nonland card, then put all cards revealed this way into your hand.', 'Tendrils of Corruption deals X damage to target creature and you gain X life, where X is the number of Swamps you control.', 'When Burning-Tree Emissary enters the battlefield, add {R}{G}.', 'When Elvish Visionary enters the battlefield, draw a card.', 'When Goblin Matron enters the battlefield, you may search your library for a Goblin card, reveal that card, put it into your hand, then shuffle.', 'Whenever another creature enters the battlefield, you gain 1 life.', 'Whenever you cast an instant or sorcery spell, Kiln Fiend gets +3/+0 until end of turn.', '{1}{B}, {T}, Discard a card: Create a 2/2 black Zombie creature token.\\nTap three untapped Zombies you control: You draw a card and you lose 1 life.', '{G}, {T}, Discard a creature card: Search your library for a creature card, reveal it, put it into your hand, then shuffle.', '{T}: Add {C}.\\n{1}, {T}, Sacrifice Mind Stone: Draw a card.', '{T}: Search your library for a legendary card, reveal that card, put it into your hand, then shuffle.']
flavor: ['"From a tiny sprout, the greatest trees grow and flourish. May the seeds of your mind be equally fruitful."', '"One does not question the size or shape of the grains of sand in an hourglass. Nor do I question the temperament of the souls under my guidance."', '"The longer the journey, the more one learns."\\n—Isanke, Halimar seastalker', 'A drop of humanity for a sea of power.', 'A mother only a child could love.', 'Ambidexterity is common among kithkin. The thoughtweft links the minds of the left- and right-handed, giving each the knack of the other.', "Darkness doesn't always send its minions to do its dirty work.", 'Hidetsugu never relinquished a grudge. He let it burn within him, gathering ever greater intensity until the final moment of vengeance.', 'In a culture of beauty, the most beautiful are worshipped as gods.', 'It traps an explosion within its stony skin.', 'Its victims are known by their eyes: shattered vessels leaking broken dreams.', "Oona's song is like a twisted dinner chime. All the faeries return home, but it is Oona who feasts—on the stolen dreams and rumors they serve her.", 'Regardless of the century, plane, or species, developing artificers never fail to invent the ornithopter.', 'She wears the talismans of every creature she can evoke.', 'Those who regard the Gruul as savage simpletons underestimate the subtle power of their shamans.']
artist: ['Adam Rex', 'Adi Granov', 'Anthony Palumbo', 'Carl Critchlow', 'D. Alexander Gregory', 'Darek Zabrocki', 'Daren Bader', 'Franz Vohwinkel', 'Greg Staples', 'Izzy', 'Jeff Miracola', 'Jesper Ejsing', 'Kev Walker', 'Omar Rayyan', 'Randy Gallegos', 'Ray Lago', 'Scott M. Fischer', 'Steve Prescott', 'Vance Kovacs', 'Wayne Reynolds']
