type: ['Artifact', 'Artifact Creature — Cyborg Advisor', 'Artifact Creature — Phyrexian Horror', 'Land', 'Legendary Creature — Angel', 'Legendary Creature — Kithkin Advisor', 'Legendary Creature — Treefolk Shaman', 'Legendary Land', 'Sorcery']
