subtypes: ['Angel', 'Archer', 'Assassin', 'Aura', 'Avatar', 'Barbarian', 'Basilisk', 'Bear', 'Beast', 'Bird', 'Cat', 'Cleric', 'Cockatrice', 'Demon', 'Dinosaur', 'Djinn', 'Dragon', 'Druid', 'Dryad', 'Dwarf', 'Elemental', 'Elephant', 'Elf', 'Faerie', 'Forest', 'Fungus', 'Gargoyle', 'Giant', 'Goblin', 'Golem', 'Horse', 'Human', 'Hydra', 'Illusion', 'Imp', 'Incarnation', 'Island', 'Juggernaut', 'Knight', 'Merfolk', 'Minotaur', 'Mountain', 'Nightmare', 'Nymph', 'Ogre', 'Orc', 'Pegasus', 'Pirate', 'Plains', 'Plant', 'Rat', 'Serpent', 'Shade', 'Shapeshifter', 'Skeleton', 'Soldier', 'Specter', 'Spider', 'Spirit', 'Swamp', 'Treefolk', 'Troll', 'Unicorn', 'Vampire', 'Wall', 'Warrior', 'Wizard', 'Wolf', 'Wraith', 'Wurm', 'Zombie']
