type: ['Artifact', 'Artifact Creature — Homunculus', 'Artifact Creature — Phyrexian Imp', 'Creature — Human Rogue Artificer', 'Creature — Merfolk Rogue', 'Enchantment', 'Instant', 'Legendary Creature — Phyrexian Praetor', 'Sorcery']
