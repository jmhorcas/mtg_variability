type: ['Artifact', 'Artifact Creature — Bird', 'Basic Land — Forest', 'Basic Land — Island', 'Basic Land — Mountain', 'Basic Land — Plains', 'Basic Land — Swamp', 'Creature — Angel', 'Creature — Avatar', 'Creature — Basilisk', 'Creature — Beast', 'Creature — Bird', 'Creature — Demon', 'Creature — Dragon', 'Creature — Dwarf Soldier', 'Creature — Elemental', 'Creature — Fish', 'Creature — Giant', 'Creature — Goblin Shaman', 'Creature — Human Berserker', 'Creature — Human Cleric', 'Creature — Human Knight', 'Creature — Human Soldier', 'Creature — Human Wizard', 'Creature — Hydra', 'Creature — Insect', 'Creature — Kavu', 'Creature — Kor Knight Ally', 'Creature — Minotaur Warrior', 'Creature — Ogre Warrior', 'Creature — Phoenix', 'Creature — Shapeshifter', 'Creature — Sphinx', 'Creature — Vampire', 'Creature — Vampire Shaman', 'Creature — Zombie', 'Enchantment', 'Enchantment — Aura', 'Instant', 'Land', 'Legendary Artifact — Equipment', 'Legendary Creature — Human Soldier', 'Legendary Planeswalker — Bolas', 'Legendary Planeswalker — Chandra', 'Legendary Planeswalker — Gideon', 'Legendary Planeswalker — Nissa', 'Sorcery']
