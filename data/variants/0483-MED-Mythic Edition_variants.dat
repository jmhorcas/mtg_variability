type: ['Legendary Planeswalker — Ajani', 'Legendary Planeswalker — Bolas', 'Legendary Planeswalker — Dack', 'Legendary Planeswalker — Daretti', 'Legendary Planeswalker — Domri', 'Legendary Planeswalker — Elspeth', 'Legendary Planeswalker — Garruk', 'Legendary Planeswalker — Gideon', 'Legendary Planeswalker — Jace', 'Legendary Planeswalker — Jaya', 'Legendary Planeswalker — Karn', 'Legendary Planeswalker — Kaya', 'Legendary Planeswalker — Liliana', 'Legendary Planeswalker — Nahiri', 'Legendary Planeswalker — Ral', 'Legendary Planeswalker — Sarkhan', 'Legendary Planeswalker — Sorin', 'Legendary Planeswalker — Tamiyo', 'Legendary Planeswalker — Teferi', 'Legendary Planeswalker — Tezzeret', 'Legendary Planeswalker — Ugin', 'Legendary Planeswalker — Vraska']
