subtypes: ['Angel', 'Archer', 'Assassin', 'Aura', 'Avatar', 'Barbarian', 'Basilisk', 'Bat', 'Bear', 'Beast', 'Bird', 'Boar', 'Cat', 'Cleric', 'Cockatrice', 'Construct', 'Demon', 'Dinosaur', 'Djinn', 'Dragon', 'Druid', 'Dryad', 'Dwarf', 'Efreet', 'Elemental', 'Elephant', 'Elf', 'Faerie', 'Fish', 'Forest', 'Fungus', 'Giant', 'Goblin', 'Golem', 'Horror', 'Horse', 'Human', 'Illusion', 'Imp', 'Incarnation', 'Insect', 'Island', 'Jackal', 'Juggernaut', 'Kithkin', 'Knight', 'Leech', 'Leviathan', 'Manticore', 'Merfolk', 'Minion', 'Minotaur', 'Monk', 'Mountain', 'Nightmare', 'Nomad', 'Nymph', 'Ogre', 'Orc', 'Pegasus', 'Pirate', 'Plains', 'Plant', 'Rat', 'Rogue', 'Scorpion', 'Serpent', 'Shade', 'Shaman', 'Shapeshifter', 'Skeleton', 'Snake', 'Soldier', 'Specter', 'Spider', 'Spirit', 'Swamp', 'Thopter', 'Treefolk', 'Troll', 'Turtle', 'Unicorn', 'Vampire', 'Wall', 'Warrior', 'Wizard', 'Wolf', 'Wraith', 'Wurm', 'Zombie']
