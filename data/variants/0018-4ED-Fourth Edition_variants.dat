ge\': \'German\', \'identifiers\': {\'scryfallId\': \'94117d7b-566b-4e5e-a514-9b1add37ee4a\'}, \'multiverseid\': None}, {\'name\': \'Insidia mental\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'31559e4f-0a86-4c38-8fa2-d82888dc5ac1\'}, \'multiverseid\': None}, {\'name\': \'Tricherie mentale\', \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'75ef28e0-5868-4c54-bb1a-a21ad7b2d611\'}, \'multiverseid\': None}, {\'name\': \'Prestigiatore Psichico\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9349212b-8c7d-4d7e-8472-05a9e1e56d4f\'}, \'multiverseid\': None}, {\'name\': \'臨機応変\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'826be7da-3e5c-4737-b76b-c9bf5bc93530\'}, \'multiverseid\': None}, {\'name\': \'Ilusão Mental\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'15a59c7d-c088-4e41-8c8b-61ab215fc00f\'}, \'multiverseid\': None}]', "[{'name': 'Gestaltwandler', 'text': 'Stärke und Widerstandskraft des Gestaltwandlers ergeben zusammen immer 7. Du kannst sie festlegen, wenn der Gestaltwandler ins Spiel kommt, und dann immer wieder während Deiner Versorgungsphase.', 'type': 'Artefaktkreatur', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '2602ea14-64f3-4e8a-a3af-03018ca25af7'}, 'multiverseid': None}, {'name': 'Metamorfo', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '5a87f6a1-5e99-4773-a868-af82808e043f'}, 'multiverseid': None}, {'name': 'Changeforme', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'e2ba9392-7176-4d5a-bba7-d0df5608b1ea'}, 'multiverseid': None}, {'name': 'Polimorfo', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '6974aee0-ead6-4f1c-a13d-7c951ae6ad51'}, 'multiverseid': None}, {'name': '多相の戦士', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '8e0f4eb8-46f9-4fef-8aee-bd4