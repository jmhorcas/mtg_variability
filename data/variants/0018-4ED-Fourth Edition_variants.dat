empo', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '6c1ee7e3-c454-4687-a387-b7d548316389'}, 'multiverseid': None}, {'name': '時の精霊', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'b40c6771-1c6c-4392-bde8-1ce1042dc791'}, 'multiverseid': None}, {'name': 'Elemental do Tempo', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '4093f32c-09e1-46c8-9ab7-83d38458b343'}, 'multiverseid': None}]", "[{'name': 'Zersetzung', 'text': 'Die Zersetzung verursacht bei einem Spieler oder einer Kreatur Deiner Wahl X Schadenspunkte. Diese Kreatur kann in diesem Zug nicht regenerieren. Sollte sie in diesem Spielzug tödlichen Schaden erleiden, entferne sie ganz aus dem Spiel', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'e3ccd5e0-0658-4a77-918f-643e76d0712a'}, 'multiverseid': None}, {'name': 'Desintegrar', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '7d00c107-8a68-4483-8940-6c1abe575181'}, 'multiverseid': None}, {'name': 'Désintégration', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '39346f0e-b70e-42aa-a103-de3aff7f5c6f'}, 'multiverseid': None}, {'name': 'Disintegrazione', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '9fd75ae1-0cc3-430d-b05b-513f8533c086'}, 'multiverseid': None}, {'name': '分解', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'dd46a27e-833d-4fd8-be39-ebe5359e82b9'}, 'multiverseid': None}, {'name': 'Desintegrar', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'efe05e10-54fa-4c2a-9410-99f60fd2476c'}, 'multiverseid': None}]", "[{'name': 'Zersplittern', 'text': 'Zerstöre ein Artefakt.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '3fb4edfe-77cf-4d8c-a6b0-084b2f4b245b'}, 'multiverseid': None}, {'name': 'Romper', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '04251b1b-cf4c-4913-975b-8c8cb4a14602'}, 'multiverseid': None}, {'name': 'Fracasser', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'f3c60f59-2018-4196-905b-4fa89ab9b896'}, 'multiverseid': None}, {'name': 'Distruggi Artefatto', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '660096af-8b24-46be-9236-53a667dd450d'}, 'multiverseid': None}, {'name': '粉砕', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '575b3632-4691-40e3-91de-7469d1ac68d7'}, 'multiverseid': None}, {'name': 'Estilhaçar', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a25f21c9-0c53-4151-bde5-da0004897bc5'}, 'multiverseid': None}]", "[{'name': 'Zombiemeister', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '17e22c03-1d54-4ef5-8a50-046ee199fefb'}, 'multiverseid': None}, {'name': 'Señor de los Zombies', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '11d2d511-f0ac-440b-b728-3b73cfc41ecf'}, 'multiverseid': None}, {'name': 'Maître des zombies', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'dabd48ef-f351-4d7b-889d-3ad3aad4efe2'}, 'multiverseid': None}, {'name': 'Signore degli Zombi', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '21f9a727-9fc1-40b3-82c3-33c43419c814'}, 'multiverseid': None}, {'name': 'ゾンビ使い', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '985a4491-a6e7-4a1b-b587-ee4a5730a0a6'}, 'multiverseid': None}, {'name': 'Mestre Zumbi', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '6fb3df27-9103-48d8-b87b-98b409fd9447'}, 'multiverseid': None}]", "[{'name': 'Zorn Gottes', 'text': 'Begrabe alle Kreaturen im Spiel.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '3d828771-ba13-4b37-8633-f1c8a7066b65'}, 'multiverseid': None}, {'name': 'Ira de Dios', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '78b59806-8