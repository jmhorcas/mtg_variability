-59294fb4cbfa'}, 'multiverseid': None}, {'name': 'Descarga de maná', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '7b1ab6fc-e4f2-4244-a883-2c488c257e29'}, 'multiverseid': None}, {'name': 'Surtension', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '13449136-95bb-483b-b818-917ac44682f1'}, 'multiverseid': None}, {'name': 'Ondata di Potere', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '7d804f79-6562-4d8d-85f7-85e5d554cf80'}, 'multiverseid': None}, {'name': '魔力の奔流', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '52bb6bd8-bbcc-43b6-8047-9900216e8c43'}, 'multiverseid': None}, {'name': 'Surto de Poder', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '23908f7a-ea28-4ec7-a937-a27d80388d3c'}, 'multiverseid': None}]", "[{'name': 'Sturm-Ifrit', 'text': '{T}: Ziehe eine Karte aus dem Blatt des Gegners und nimm sie auf Deine Hand. Lege den Sturm-Ifrit danach auf dem Friedhof des Gegners ab. Dieser Besitzerwechsel ist permanent. Spiele diese Eigenschaft wie einen Unterbrechungszauber. Bevor Du eine Karte aus des Gegners Blatt ziehst, kann dieser diesen Effekt verhindern, indem er entweder 10 Lebenspunkte zahlt oder aufgibt. Geschieht dies, lege den Sturm-Ifrit auf Deinem Friedhof ab. Nimm diese Karte vor dem Spiel aus Deinem Stapel, wenn ohne Einsatz gespielt wird.', 'type': 'Beschwörung eines Ifrits', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'e474e7e9-86a4-451e-874c-e167b9bde934'}, 'multiverseid': None}, {'name': 'Efrit de la tormenta', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '85399c55-2de0-4d4c-a976-01531d0a89f5'}, 'multiverseid': None}, {'name': 'Efrit de la tourmente', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '7a201ddb-6322-4307-8f92-8e5f28efdc5e'}, 'multiverseid': None}, {'name': 'Efreet delle Tempeste', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '95c85c71-bca4-418f-898b-2c4e600a1792'}, 'multiverseid': None}, {'name': '嵐のイフリート', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'c69580b1-9287-42f8-9b2b-3b1c9367d877'}, 'multiverseid': None}]", "[{'name': 'Sturmramme', 'text': 'Hat Bündnisfähigkeit, wenn sie angreift.\\nVernichte am Ende des Kampfes alle Mauern, die dir Ramme geblockt haben.', 'type': 'Artefaktkreatur', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '284443d6-6c81-4b46-b1d5-7725ef2f1a5b'}, 'multiverseid': None}, {'name': 'Ariete', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '2bc4a0dc-17f1-474e-a711-64197781a9fd'}, 'multiverseid': None}, {'name': 'Bélier', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '7b99ec10-da55-4974-b906-b1ccb42d6652'}, 'multiverseid': None}, {'name': 'Ariete da Assedio', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'dea12317-1471-45c9-8c5f-c05cc8e97878'}, 'multiverseid': None}, {'name': '破城槌', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'ffc8702b-3590-423d-a2d0-85f2893ba0aa'}, 'multiverseid': None}, {'name': 'Aríete', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '766d4154-de81-4b7b-a1df-61665d20d55b'}, 'multiverseid': None}]", "[{'name': 'Suchender', 'text': 'Die verzauberte Kreatur kann nur von weißen und Artefaktkreaturen geblockt werden.', 'type': 'Verzaubere Kreatur', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'f5db6cfb-5a3d-48b9-9c84-38138e56e27d'}, 'multiverseid': None}, {'name': 'Espíritu', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'a4906e85-919e-42cc-8a6f-d111db544e9e'}, 'multiverseid': None}, {'name': 'Chercheur', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'd2f2be1f-6469-4a28-a24f-2783962d3f0f'}, 'multiverseid': None}, {'name': 'Cercatore', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '517b2aff-b26f-4d1e-870d-8779222866e2'}, 'multiverseid': None}, {'name': '求道者', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '3c82431e-41a1-4585-bbeb-25a278899e8a'}, 'multiverseid': None}, {'name': 'Explorador', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a517e04f-6118-4f17-8202-10715f851f0d'}, 'multiverseid': None}]", "[{'name': 'Suleimans Flasche', 'text': '1, opfere Suleimans Flasche: Wirf eine Münze. Während die Münze in der Luft ist, entscheidet sich Dein Gegner für kopf oder Zahl. Gewinnt er, fügt Dir Suleimans Flasche 5 Schadenspunkte zu. Gewinnst Du, dann kommt auf Deiner Seite sofort ein 5/5 Dschinn mit Flugfähigkeit ins Spiel. Stelle den Dschinn durch einen Spielstein dar und behandle ihn wie eine ganz normale Artefaktkreatur.', 'type': 'Artefakt', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '7fa0f851-c8c7-4eae-acbe-d012b1d28b6b'}, 'multiverseid': None}, {'name': 'Botella de Suleimán', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '16330e81-acd5-436d-9501-aa74f2bcdc16'}, 'multiverseid': None}, {'name': 'Bouteille de Salomon', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '0e6dbafc-9992-4d30-ae0c-75c095fd2f72'}, 'multiverseid': None}, {'name': 'Bottiglia di Solimano', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'c9e6da35-f76d-433e-a522-38486f46cd36'}, 'multiverseid': None}, {'name': 'スレイマンの壺', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'c20f7a89-b330-449d-a8da-ab10becb1b36'}, 'multiverseid': None}, {'name': 'Garrafa de Suleiman', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c306a26f-f470-4fe6-82a8-890c613910f0'}, 'multiverseid': None}]", "[{'name': 'Sumpf', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '53c63686-90b4-4093-bd4e-834cac44d8cc'}, 'multiverseid': None}, {'name': 'Pantano', 'flavor': None, 'language': 'Spanish',