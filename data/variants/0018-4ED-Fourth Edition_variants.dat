367ef6f5-3627-4feb-9529-684119934264'}, 'multiverseid': None}, {'name': 'Gigante de Pedra', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9540e4a8-2231-4aec-965b-bf1a2359ed16'}, 'multiverseid': None}]", "[{'name': 'Steinschlitten', 'text': 'Verursacht Trampelschaden.\\nKann nicht angreifen, wenn der Gegner keine Gebirge im Spiel hat. Wenn der Steinschlitten in der vorherigen Runde angegriffen hat, wird er in der Entap-Phase nicht enttappt.', 'type': 'Beschwörung von Steinschlitten', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'd783c7c5-8679-4555-a58f-5a8d03a583b7'}, 'multiverseid': None}, {'name': 'Trineo de roca trasgo', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '79e6db7d-5bb5-4ec9-a7dc-9d782ad6ecc1'}, 'multiverseid': None}, {'name': 'Luge des gobelins', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '91e32e86-cedd-4743-9d83-0ff41f8036d4'}, 'multiverseid': None}, {'name': 'Slitta da Roccia dei Goblin', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '4c1f0cbe-0a20-4931-b168-ae41261a8524'}, 'multiverseid': None}, {'name': 'ゴブリン岩ぞり隊', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '27c6aa68-0de6-4e08-bea3-354453e03a19'}, 'multiverseid': None}, {'name': 'Martelo de Pedra Goblin', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8255ed4e-370a-4dbc-a52d-c8f0af7448b6'}, 'multiverseid': None}]", "[{'name': 'Steppenbrand', 'text': 'Zerstöre die Ebenen im Spiel.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '3efd2e66-77af-4391-9105-753daa520120'}, 'multiverseid': None}, {'name': 'Tormenta ígnea', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'bb4b933c-d49e-4d4d-ac18-13856ce92d58'}, 'multiverseid': None}, {'name': 'Feu de brousse', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '7eebe911-ba60-48c7-85ab-44a3b