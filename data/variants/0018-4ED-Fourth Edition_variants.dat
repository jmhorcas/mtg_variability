: None}, {'name': 'Isla', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '572d8974-c2a2-4603-a5b9-558a8bfe2961'}, 'multiverseid': None}, {'name': 'Ile', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'f2792718-d8e0-4d06-a53f-0a5ae4be78d8'}, 'multiverseid': None}, {'name': 'Isola', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '68865c32-e881-4367-b532-b0ddca09e9db'}, 'multiverseid': None}, {'name': '島', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'c7c0fd99-e147-4273-bc89-f79a08a55571'}, 'multiverseid': None}, {'name': 'Ilha', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '43726daa-cac5-47bb-a0e1-94bca9c53cbd'}, 'multiverseid': None}]", "[{'name': 'Inselfisch Jasconius', 'text': 'Der Inselfisch enttappt nicht während Deiner Enttap-Phase.\\nDer Inselfisch kann nur angreifen, wenn der Gegner Inseln im Spiel hat. Wenn Du zu irgendeiner Zeit keine Inseln mehr im Spiel hast, geht Jasconius direkt auf den Friedhof.\\n{U}{U}{U}: Enttappe Inselfisch. Du kannst diese Eigenschaft nur während Deiner Versorgungsphase benutzen.', 'type': 'Beschwörung des Inselfischs', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'b67ccea9-d14c-4ee0-9392-3d501b258d04'}, 'multiverseid': None}, {'name': 'Pez isla Jasconius', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '5164ef80-ce59-4f10-8ae5-c521271599f7'}, 'multiverseid': None}, {'name': 'Ile-poisson Seyidna yûnûs', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '62e27d2c-b8bc-46c6-af49-1947591a375b'}, 'multiverseid': None}, {'name': 'Jasconius, il Pesce-Isola', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'b5f9b99c-d6ad-4f4b-ab2d-5f07a989442f'}, 'multiverseid': None}, {'name': '島魚ジャスコニアス', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '4304d90f-f425-4aac-9a58-9ef9d392420c'}, 'multiverseid': None}, {'name': '