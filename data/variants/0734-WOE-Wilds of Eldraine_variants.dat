lified', 'identifiers': {'scryfallId': '3fb29936-29c7-448c-bffb-da2a9650ae93', 'multiverseId': 631626}, 'multiverseid': 631626}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631642&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b59ef7ee-6819-49e2-820d-ba237b59f27a', 'multiverseId': 631642}, 'multiverseid': 631642}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631652&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '49142936-e1b8-42e5-87be-ad6b22cd3caa', 'multiverseId': 631652}, 'multiverseid': 631652}, {'name': 'Île', 'type': 'Terrain de base — île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631662&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e979a18e-fb7a-483b-a374-98dada781c14', 'multiverseId': 631662}, 'multiverseid': 631662}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631672&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '1a46180f-29e7-476c-982e-8b976591b832', 'multiverseId': 631672}, 'multiverseid': 631672}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631682&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '99ae94b8-088f-4101-a70f-bdbe15a7f8fb', 'multiverseId': 631682}, 'multiverseid': 631682}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631692&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f426c0d9-40f1-493e-81d7-3b0afe086003', 'multiverseId': 631692}, 'multiverseid': 631692}, {'name': '海岛', 'type': '基本地 — 海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631702&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '61302d2f-edfd-49b8-9b2d-9ba550f9ca9e', 'multiverseId': 631702}, 'multiverseid': 631702}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631643&type=card', 'language': 'German', 'identifiers': {'scryfallId': '114291db-1f0c-4571-b6fd-e0afe9ca8618', 'multiverseId': 631643}, 'multiverseid': 631643}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631653&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'bc4a766a-808d-4d34-812a-9b02c3f34a4c', 'multiverseId': 631653}, 'multiverseid': 631653}, {'name': 'Île', 'type': 'Terrain de base — île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631663&type=card', 'language': 'French', 'identifiers': {'scryfallId': '073dd573-0a24-445d-b62c-c0dd442979cf', 'multiverseId': 631663}, 'multiverseid': 631663}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631673&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ece1887a-e5ce-4142-b3f9-0fcdce484b54', 'multiverseId': 631673}, 'multiverseid': 631673}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631683&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ee6a6006-2fff-40be-a75f-897731c27870', 'multiverseId': 631683}, 'multiverseid': 631683}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631693&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '19f3eeac-ed8a-47f0-b258-b6556f92f45c', 'multiverseId': 631693}, 'multiverseid': 631693}, {'name': '海岛', 'type': '基本地 — 海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631703&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'bf98190b-3fa6-4729-9387-6f345d651ea6', 'multiverseId': 631703}, 'multiverseid': 631703}]", '[{\'name\': \'Intrepid Trufflesnout // Die Sau rauslassen\', \'text\': \'Immer wenn der Furchtlose Trüffelschnüffler alleine angreift, erzeuge einen Speise-Spielstein. (Er ist ein Artefakt mit „{2}, {T}, opfere dieses Artefakt: Du erhältst 3 Lebenspunkte dazu.")\', \'type\': \'Kreatur — Wildschwein\', \'flavor\': None, \'faceName\': \'Intrepid Trufflesnout\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632096&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c9932729-df14-438c-9e16-4dc6611d2702\', \'multiverseId\': 632096}, \'multiverseid\': 632096}, {\'name\': \'Intrepid Trufflesnout // Volverse un jabato\', \'text\': \'Siempre que el Hocicotrufa intrépido ataque solo, crea una ficha de Comida. (Es un artefacto con "{2}, {T}, sacrificar este artefacto: Ganas 3 vidas".)\', \'type\': \'Criatura — Jabalí\', \'flavor\': None, \'faceName\': \'Intrepid Trufflesnout\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632111&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'666e833f-409d-49a7-b476-7b04074fd414\', \'multiverseId\': 632111}, \'multiverseid\': 632111}, {\'name\': \'Intrepid Trufflesnout // Tour de cochon\', \'text\': "À chaque fois que le Cochon truffier intrépide attaque seul, créez un jeton Nourriture. (C\'est un artefact avec « {2}, {T}, sacrifiez cet artefact : Vous gagnez 3 points de vie. »)", \'type\': \'Créature — sanglier\', \'flavor\': None, \'faceName\': \'Intrepid Trufflesnout\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632126&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'42224278-4078-4044-beda-85e98c661baa\', \'multiverseId\': 632126}, \'multiverseid\': 632126}, {\'name\': \'Intrepid Trufflesnout // Inselvatichire\', \'text\': \'Ogniqualvolta il Fiutartufo Intrepido attacca da solo, crea una pedina Cibo. (È un artefatto con "{2}, {T}, Sacrifica questo artefatto: Guadagni 3 punti vita".)\', \'type\': \'Creatura — Cinghiale\', \'flavor\': None, \'faceName\': \'Intrepid Trufflesnout\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632141&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c425e343-a4d7-49cd-a77b-55ce8f353eba\', \'multiverseId\': 632141}, \'multiverseid\': 632141}, {\'name\': \'Intrepid Trufflesnout // 猪（ちょ）突（とつ）猛（もう）進（しん）\', \'text\': \'剛胆なトリュフ嗅ぎが単独で攻撃するたび、食物・トークン１つを生成する。（それは、「{2}, {T}, このアーティファクトを生け贄に捧げる：あなたは３点のライフを得る。」を持つアーティファクトである。）\', \'type\': \'クリーチャー — 猪\', \'flavor\': None, \'faceName\': \'Intrepid Trufflesnout\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632156&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9d379455-dd37-48cc-9faa-b386f91aab8b\', \'multiverseId\': 632156}, \'multiverseid\': 632156}, {\'name\': \'Intrepid Trufflesnout // Selvageria Suína\', \'text\': \'Toda vez que Fareja-trufas Intrépido atacar sozinho, crie uma ficha de Comida. (Ela é um artefato com "{2}, {T}, sacrifique este artefato: Você ganha 3 pontos de vida".)\', \'type\': \'Criatura — Javali\', \'flavor\': None, \'faceName\': \'Intrepid Trufflesnout\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632171&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d8fb2b32-64e3-431c-af3d-3e8d1487b59f\', \'multiverseId\': 632171}, \'multiverseid\': 632171}, {\'name\': \'Intrepid Trufflesnout // 撒野作乐\', \'text\': \'每当无畏掘菌猪单独攻击时，派出一个食品衍生物。（它是具有「{2}，{T}，牺牲此神器：你获得3点生命」的神器。）\', \'type\': \'生物 — 野猪\', \'flavor\': None, \'faceName\': \'Intrepid Trufflesnout\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632186&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fad07d2f-a777-4893-aaa8-3055c745b709\', \'multiverseId\': 632186}, \'multiverseid\': 632186}]', '[{\'name\': \'Irreführende Irrlichter\', \'text\': \'Der Besitzer einer Kreatur deiner Wahl legt sie auf oder unter seine Bibliothek.\', \'type\': \'Spontanzauber\', \'flavor\': \'Yarvis war sich fast sicher, dass er denselben Baum vor einer Stunde bereits gesehen hatte, aber andererseits sehen doch alle Bäume gleich aus … Er begrub seine Zweifel und folgte den freundlich funkelnden Lichtern tiefer in den Wald.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629823&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a0148b71-1481-4b5b-b016-651677c66f91\', \'multiverseId\': 629823}, \'multiverseid\': 629823}, {\'name\': \'Llamas desorientadoras\', \'text\': \'El propietario de la criatura objetivo la pone en la parte superior o en el fondo de su biblioteca.\', \'type\': \'Instantáneo\', \'flavor\': \'Yarvis estaba casi seguro de que había visto el mismo árbol hace una hora. Pero, claro, todos los árboles se parecían... Apartó sus dudas y siguió a las amables llamas titilantes al interior del bosque.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630084&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'52ea309a-1f38-403a-8f61-52b1754f1660\', \'multiverseId\': 630084}, \'multiverseid\': 630084}, {\'name\': \'Lueurs fallacieuses\', \'text\': "Le propriétaire d\'une créature ciblée la met au-dessus ou au-dessous de sa bibliothèque.", \'type\': \'Éphémère\', \'flavor\': "Yarvis était presque certain d\'avoir vu le même arbre une heure plus tôt, mais après tout, tous les arbres ne se ressemblent-ils pas ? Il oublia ses doutes et suivit les lumières scintillantes plus profondément dans la forêt.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630345&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'da2bde65-403e-4454-b1f2-ab369adbb9d2\', \'multiverseId\': 630345}, \'multiverseid\': 630345}, {\'name\': \'Briciole Fuorvianti\', \'text\': \'Il proprietario di una creatura bersaglio la mette in cima o in fondo al suo grimorio.\', \'type\': \'Istantaneo\', \'flavor\': "Yarvis era quasi sicuro di avere già visto lo stesso albero un\'ora prima, ma pensò che in fondo gli alberi erano tutti uguali. Si scrollò di dosso i dubbi e continuò a seguire le amichevoli briciole luccicanti, addentrandosi sempre di più nella foresta.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630606&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0a07078c-5b96-4e20-9a59-2e6d752c3bc4\', \'multiverseId\': 630606}, \'multiverseid\': 630606}, {\'name\': \'紛らわしい光塵\', \'text\': \'クリーチャー１体を対象とする。それのオーナーはそれを自分のライブラリーの一番上か一番下に置く。\', \'type\': \'インスタント\', \'flavor\': \'ヤーヴィスは一時間前に同じ木を見たような気がしていたが、結局のところ木なんてどれも似たようなものじゃないか。彼は考えるのを止め、親しげに煌めく光塵の後を追って森の奥深くへと入っていった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630867&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6ebf3c80-689b-4bef-82f2-5d3f10905f14\', \'multiverseId\': 630867}, \'multiverseid\': 630867}, {\'name\': \'Migalhas Desorientadoras\', \'text\': \'O dono da criatura alvo a coloca no topo ou no fundo do próprio grimório.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Yarvis tinha quase certeza de que vira a mesma árvore uma hora antes, mas até aí, as árvores não eram todas parecidas? Ele pôs as próprias dúvidas de lado e seguiu as amigáveis luzes piscantes rumo às profundezas da floresta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631128&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a4b067aa-c046-4b25-855b-b04d354b7e0d\', \'multiverseId\': 631128}, \'multiverseid\': 631128}, {\'name\': \'浮灵绕路\', \'text\': \'目标生物的拥有者将它置于其牌库顶或牌库底。\', \'type\': \'瞬间\', \'flavor\': \'雅维斯几乎确信自己一小时前就见过同一棵树，但话说回来，树不都长得差不多吗？于是他将自己的疑惑抛诸脑后，继续跟随看似友好的浮灵幽光踏入树林深处。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631389&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4e532c9d-4a0f-47c1-8265-767c1ab42d0a\', \'multiverseId\': 631389}, \'multiverseid\': 631389}]', '[{\'name\': \'Johann der Zauberlehrling\', \'text\': \'Du kannst dir zu jedem Zeitpunkt die oberste Karte deiner Bibliothek anschauen.\\nEinmal pro Zug kannst du einen Spontanzauber oder eine Hexerei oben von deiner Bibliothek wirken. (Du bezahlst immer noch ihre Kosten. Zeitpunkts-Einschränkungen gelten weiterhin.)\', \'type\': \'Legendäre Kreatur — Mensch, Zauberer\', \'flavor\': \'„Also. Zuerst besänftige ich die Elementare. Dann lösche ich das Feuer. Dann pumpe ich das Wasser aus dem Keller ab. Dann kümmere ich mich selbst um die Hausarbeit."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629969&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'afa52349-598f-48e2-8b1d-badd7cd1cc4f\', \'multiverseId\': 629969}, \'multiverseid\': 629969}, {\'name\': \'Johann, aprendiz de hechicero\', \'text\': \'Puedes mirar la primera carta de tu biblioteca en cualquier momento.\\nUna vez por turno, puedes lanzar un hechizo de instantáneo o de conjuro desde la parte superior de tu biblioteca. (Sigues pagando sus costes. Las reglas sobre cuándo lanzarlo se siguen aplicando.)\', \'type\': \'Criatura legendaria — Hechicero humano\', \'flavor\': \'"Bien. Primero calmaré a los elementales. Luego apagaré el fuego. Después sacaré el agua del sótano. Y, a continuación, haré mis tareas yo mismo".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630230&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7df7b34e-87ec-44b3-9c2a-f4f134fd92c0\', \'multiverseId\': 630230}, \'multiverseid\': 630230}, {\'name\': \'Johann, apprenti sorcier\', \'text\': "Vous pouvez regarder la carte du dessus de votre bibliothèque à tout moment.\\nUne fois par tour, vous pouvez lancer un sort d\'éphémère ou de rituel depuis le dessus de votre bibliothèque. (Vous payez toujours ses coûts. Les restrictions de temps s\'appliquent quand même.)", \'type\': \'Créature légendaire — humain et sorcier\', \'flavor\': "« Bien. Je vais commencer par calmer les élémentaux. Puis je vais éteindre le feu. Ensuite j\'écoperai l\'inondation de la cave. Et pour finir, je ferai le ménage moi-même. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630491&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'41431b31-0305-44fe-8cd9-a085f581c262\', \'multiverseId\': 630491}, \'multiverseid\': 630491}, {\'name\': \'Johann, Apprendista Stregone\', \'text\': \'Puoi guardare la prima carta del tuo grimorio in qualsiasi momento.\\nUna volta per turno, puoi lanciare una magia istantaneo o stregoneria dalla cima del tuo grimorio. (Paghi comunque i suoi costi. Le regole sulla tempistica si applicano comunque.)\', \'type\': \'Creatura Leggendaria — Mago Umano\', \'flavor\': \'"D\\\'accordo. Prima calmo gli elementali. Poi spengo il fuoco. Poi asciugo l\\\'allagamento in cantina. Poi faccio le faccende di casa da solo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630752&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a59bf9d8-8337-4b24-89dd-be4c3b8b104f\', \'multiverseId\': 630752}, \'multiverseid\': 630752}, {\'name\': \'見習い魔術師、ジョハン\', \'text\': \'あなたはいつでもあなたのライブラリーの一番上にあるカード１枚を見てよい。\\n毎ターン１回、あなたはあなたのライブラリーの一番上からインスタントやソーサリーである呪文１つを唱えてもよい。（そのコストは支払う必要がある。タイミングのルールも適用される。）\', \'type\': \'伝説のクリーチャー — 人間・ウィザード\', \'flavor\': \'「よし、まずはエレメンタルを鎮めよう。その後に、火を消す。そうしたら、地下室の水を抜いて、雑用は僕が自分でやる。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631013&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cf175579-c7e2-4d3e-a913-42e0fccdd55a\', \'multiverseId\': 631013}, \'multiverseid\': 631013}, {\'name\': \'Johann, Feiticeiro Aprendiz\', \'text\': \'Você pode olhar o card do topo de seu grimório a qualquer momento.\\nUma vez a cada turno, você pode conjurar uma mágica instantânea ou um feitiço do topo de seu grimório. (Você ainda paga seus custos. As regras de tempo ainda se aplicam.)\', \'type\': \'Criatura Lendária — Humano Mago\', \'flavor\': \'"Tudo bem. Primeiro, eu acalmo os elementais. Depois, eu apago o incêndio. Depois, eu dreno o porão. Daí faço o trabalho doméstico por conta própria."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631274&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'534e92f5-4bb3-418d-bc1d-364cc482b343\', \'multiverseId\': 631274}, \'multiverseid\': 631274}, {\'name\': \'魔法师学徒约翰\', \'text\': \'你可以随时检视你的牌库顶牌。\\n限每回合一次，你可以从你的牌库顶施放瞬间或法术咒语。（你依旧要支付其费用，且仍须遵守施放时机规则。）\', \'type\': \'传奇生物 — 人类／法术师\', \'flavor\': \'「好吧。我要先安抚元素。然后扑灭大火。然后抽干地库。最后再自己来收拾。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631535&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ee854e81-56a2-4e0d-b8bb-ef9fcc6a82e0\', \'multiverseId\': 631535}, \'multiverseid\': 631535}]', '[{\'name\': \'Johanns Notlösung\', \'text\': \'Feilschen (Du kannst ein Artefakt, eine Verzauberung oder einen Spielstein opfern, sowie du diesen Zauberspruch wirkst.)\\nDieser Zauberspruch kostet beim Wirken {2} weniger, falls um ihn gefeilscht wurde.\\nBringe eine bleibende Karte deiner Wahl, die kein Land ist, auf die Hand ihres Besitzers zurück. Ziehe eine Karte.\', \'type\': \'Hexerei\', \'flavor\': \'„Bleib doch … nur eine … Sekunde … da drin!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629820&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d81ddac7-7a22-46d3-92cc-00a562f2ee17\', \'multiverseId\': 629820}, \'multiverseid\': 629820}, {\'name\': \'Apaño de Johann\', \'text\': \'Negociar. (Puedes sacrificar un artefacto, encantamiento o ficha al lanzar este hechizo.)\\nTe cuesta {2} menos lanzar este hechizo si es negociado.\\nRegresa el permanente objetivo que no sea tierra a la mano de su propietario. Roba una carta.\', \'type\': \'Conjuro\', \'flavor\': \'"Quiero que... te quedes... ahí... ¡un momento!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630081&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6fc11eb7-e623-419e-978c-9b6e31f521de\', \'multiverseId\': 630081}, \'multiverseid\': 630081}, {\'name\': \'Bouchon de Johann\', \'text\': "Négociation (Vous pouvez sacrifier un artefact, un enchantement ou un jeton au moment où vous lancez ce sort.)\\nCe sort coûte {2} de moins à lancer s\'il est négocié.\\nRenvoyez un permanent non-terrain ciblé dans la main de son propriétaire. Piochez une carte.", \'type\': \'Rituel\', \'flavor\': \'« Reste... là-dedans... une petite... seconde ! »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630342&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2ede9b0c-4d57-4c35-8dd3-35895bac5773\', \'multiverseId\': 630342}, \'multiverseid\': 630342}, {\'name\': \'Tappabuchi di Johann\', \'text\': \'Negoziare (Puoi sacrificare un artefatto, un incantesimo o una pedina mentre lanci questa magia.)\\nQuesta magia costa {2} in meno per essere lanciata se è stata negoziata.\\nFai tornare un permanente non terra bersaglio in mano al suo proprietario. Pesca una carta.\', \'type\': \'Stregoneria\', \'flavor\': \'"Resta... fermo... almeno... un secondo!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630603&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'28d94495-2248-4d2e-810f-d9380bfdb926\', \'multiverseId\': 630603}, \'multiverseid\': 630603}, {\'name\': \'ジョハンの一時凌ぎ\', \'text\': \'協約（この呪文を唱えるに際し、アーティファクトやエンチャントやトークンのうち１つを生け贄に捧げてもよい。）\\nこれが協約されていたなら、この呪文を唱えるためのコストは{2}少なくなる。\\n土地でないパーマネント１つを対象とする。それをオーナーの手札に戻す。カード１枚を引く。\', \'type\': \'ソーサリー\', \'flavor\': \'「そこで……じっと……していろ……一秒でいいから！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630864&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a11802d3-9fea-49c8-90ca-fa4ba659d00b\', \'multiverseId\': 630864}, \'multiverseid\': 630864}, {\'name\': \'Gambiarra de Johann\', \'text\': \'Negociar (Você pode sacrificar um artefato, um encantamento ou uma ficha conforme conjura esta mágica.)\\nEsta mágica custa {2} a menos para conjurar se tiver sido negociada.\\nDevolva a permanente alvo não de terreno para a mão de seu dono. Compre um card.\', \'type\': \'Feitiço\', \'flavor\': \'"Só... fica assim... por um... segundo!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631125&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b6bcdb31-3045-4ffc-96c6-6dd8bf20ec15\', \'multiverseId\': 631125}, \'multiverseid\': 631125}, {\'name\': \'约翰的应急策\', \'text\': \'加码（你施放此咒语时可以牺牲一个神器，结界或衍生物。）\\n如果此咒语已加码，则它减少{2}来施放。\\n将目标非地永久物移回其拥有者手上。抓一张牌。\', \'type\': \'法术\', \'flavor\': \'「给我…在里面待住…一秒钟…就好！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631386&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'25936071-1a75-4024-a9cd-c83b72faa393\', \'multiverseId\': 631386}, \'multiverseid\': 631386}]', '[{\'name\': \'Jäger der Himmelsbestien\', \'text\': \'Reichweite\\nImmer wenn du einen Zauberspruch mit Manabetrag 5 oder mehr wirkst, erzeuge einen Speise-Spielstein. (Er ist ein Artefakt mit „{2}, {T}, opfere dieses Artefakt: Du erhältst 3 Lebenspunkte dazu.")\', \'type\': \'Kreatur — Riese, Bogenschütze\', \'flavor\': \'Wolkenfresser, Himmelspflüger, Bohnenrankenwürmer — er zieht Beute vor, die Riesenhunger stillen kann.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629947&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8bc09277-6201-462f-9001-37506d852c8e\', \'multiverseId\': 629947}, \'multiverseid\': 629947}, {\'name\': \'Rastreador de bestias celestes\', \'text\': \'Alcance.\\nSiempre que lances un hechizo con valor de maná de 5 o más, crea una ficha de Comida. (Es un artefacto con "{2}, {T}, sacrificar este artefacto: Ganas 3 vidas".)\', \'type\': \'Criatura — Arquero gigante\', \'flavor\': \'Comedores de nubes, brotes celestiales, sierpes del tallo de habichuelas... Prefiere las presas dignas del apetito de un gigante.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630208&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f3a7d0f2-7e1f-4786-8852-33d6234c5006\', \'multiverseId\': 630208}, \'multiverseid\': 630208}, {\'name\': \'Traqueur de bête céleste\', \'text\': "Portée\\nÀ chaque fois que vous lancez un sort avec une valeur de mana supérieure ou égale à 5, créez un jeton Nourriture. (C\'est un artefact avec « {2}, {T}, sacrifiez cet artefact : Vous gagnez 3 points de vie. »)", \'type\': \'Créature — géant et archer\', \'flavor\': "Dévoreurs de nuages, laboureurs du ciel, guivres de tige de haricot—il préfère les proies dignes de l\'appétit d\'un géant.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630469&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'df278e56-b29f-4706-a38c-5399edbbc390\', \'multiverseId\': 630469}, \'multiverseid\': 630469}, {\'name\': \'Cacciatore di Bestialate\', \'text\': \'Raggiungere\\nOgniqualvolta lanci una magia con valore di mana pari o superiore a 5, crea una pedina Cibo. (È un artefatto con "{2}, {T}, Sacrifica questo artefatto: Guadagni 3 punti vita".)\', \'type\': \'Creatura — Arciere Gigante\', \'flavor\': "Mangianubi, fendicielo, wurm delle piante di fagioli... predilige prede degne dell\'appetito di un gigante.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630730&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'045f25ae-0345-401c-8f43-8175063a9553\', \'multiverseId\': 630730}, \'multiverseid\': 630730}, {\'name\': \'空獣の追跡者\', \'text\': \'到達\\nあなたがマナ総量が５以上である呪文１つを唱えるたび、食物・トークン１つを生成する。（それは、「{2}, {T}, このアーティファクトを生け贄に捧げる：あなたは３点のライフを得る。」を持つアーティファクトである。）\', \'type\': \'クリーチャー — 巨人・射手\', \'flavor\': \'雲喰い、天空の耕し手、豆の木のワーム。巨人の食欲を満すだけの獲物を彼は好む。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630991&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'204eeba9-8c27-4b5e-baee-68c5f18ef03a\', \'multiverseId\': 630991}, \'multiverseid\': 630991}, {\'name\': \'Rastreador de Feras Celestes\', \'text\': \'Alcance\\nToda vez que você conjurar uma mágica com valor de mana igual ou superior a 5, crie uma ficha de Comida. (Ela é um artefato com "{2}, {T}, sacrifique este artefato: Você ganha 3 pontos de vida".)\', \'type\': \'Criatura — Gigante Arqueiro\', \'flavor\': \'Devoradores de nuvens, lavra-céus, vormes do pé-de-feijão... ele prefere presas dignas do apetite de um gigante.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631252&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e6efe313-5b40-44bc-9b61-7c3432d0c4d1\', \'multiverseId\': 631252}, \'multiverseid\': 631252}, {\'name\': \'空兽追迹人\', \'text\': \'延势\\n每当你施放法术力值等于或大于5的咒语时，派出一个食品衍生物。（它是具有「{2}，{T}，牺牲此神器：你获得3点生命」的神器。）\', \'type\': \'生物 — 巨人／弓箭手\', \'flavor\': \'吞云鸟、犁天兽、噬茎龙～他偏好符合巨人胃口的猎物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631513&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fbfb82ef-898a-4527-8b70-03043ec1469d\', \'multiverseId\': 631513}, \'multiverseid\': 631513}]', '[{\'name\': \'Kandierter Essapfel\', \'text\': \'Feilschen (Du kannst ein Artefakt, eine Verzauberung oder einen Spielstein opfern, sowie du diesen Zauberspruch wirkst.)\\nEine Kreatur deiner Wahl erhält -3/-3 bis zum Ende des Zuges. Falls um diesen Zauberspruch gefeilscht wurde, erhält die Kreatur stattdessen -5/-5 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Meinst du nicht ‚giftig\\\'? Es gibt doch gar keine toxischen — AAAHHH!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629845&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f0edd4e3-2b21-4a31-804a-a9e98e8290f2\', \'multiverseId\': 629845}, \'multiverseid\': 629845}, {\'name\': \'Mordisco caramelizado\', \'text\': \'Negociar. (Puedes sacrificar un artefacto, encantamiento o ficha al lanzar este hechizo.)\\nLa criatura objetivo obtiene -3/-3 hasta el final del turno. Si este hechizo fue negociado, en vez de eso, esa criatura obtiene -5/-5 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"¿No querrás decir \\\'envenenada\\\'? Las manzanas no pueden ser venenos... ¡AGH!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630106&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'88bd0aac-0c1f-4d10-b6ca-5e1a3128be11\', \'multiverseId\': 630106}, \'multiverseid\': 630106}, {\'name\': \'Pomme croqueuse\', \'text\': "Négociation (Vous pouvez sacrifier un artefact, un enchantement ou un jeton au moment où vous lancez ce sort.)\\nUne créature ciblée gagne -3/-3 jusqu\'à la fin du tour. Si ce sort a été négocié, cette créature gagne -5/-5 jusqu\'à la fin du tour à la place.", \'type\': \'Éphémère\', \'flavor\': "« Tu ne veux pas plutôt dire \'vénéneuse\' ? Une pomme venimeuse, ça n\'existe p... AAARGH ! »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630367&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'69fc709d-c2aa-4353-8636-c77a23f87096\', \'multiverseId\': 630367}, \'multiverseid\': 630367}, {\'name\': \'Omicidio Polposo\', \'text\': \'Negoziare (Puoi sacrificare un artefatto, un incantesimo o una pedina mentre lanci questa magia.)\\nUna creatura bersaglio prende -3/-3 fino alla fine del turno. Se questa magia è stata negoziata, quella creatura prende invece -5/-5 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Non intendevi forse dire \\\'tossico\\\'? Il cibo non può essere velen...AAARGH!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630628&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b051b838-ab44-4da0-bc02-8fb838331373\', \'multiverseId\': 630628}, \'multiverseid\': 630628}, {\'name\': \'がぶりんご飴\', \'text\': \'協約（この呪文を唱えるに際し、アーティファクトやエンチャントやトークンのうち１つを生け贄に捧げてもよい。）\\nクリーチャー１体を対象とする。ターン終了時まで、それは－３/－３の修整を受ける。この呪文が協約されていたなら、代わりに、ターン終了時まで、そのクリーチャーは－５/－５の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'「それを言うなら『毒入り』だろう？毒を持つりんごなんて……うわあああ！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630889&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'38ac9e4c-9c38-4b36-9816-70f927c49417\', \'multiverseId\': 630889}, \'multiverseid\': 630889}, {\'name\': \'Maçã do Horror\', \'text\': \'Negociar (Você pode sacrificar um artefato, um encantamento ou uma ficha conforme conjura esta mágica.)\\nA criatura alvo recebe -3/-3 até o final do turno. Se esta mágica foi negociada, em vez disso, aquela criatura recebe -5/-5 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Você não quer dizer \\\'envenenada\\\'? Não existe maçã peçonhe... AAAAAGGHH!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631150&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0e5c2a15-f570-43af-810f-64067d49839d\', \'multiverseId\': 631150}, \'multiverseid\': 631150}, {\'name\': \'糖果噬咬\', \'text\': \'加码（你施放此咒语时可以牺牲一个神器，结界或衍生物。）\\n目标生物得-3/-3直到回合结束。如果此咒语已加码，则改为该生物得-5/-5直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'「你是想说『有毒』吧？哪有什么恶毒的～啊呀！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631411&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'044635d7-0acd-47a4-b712-a931bfff5430\', \'multiverseId\': 631411}, \'multiverseid\': 631411}]', '[{\'name\': \'Kanzler der Sagen\', \'text\': \'Fliegend\\nImmer wenn du einen Abenteuer-Zauberspruch wirkst, kannst du ihn kopieren. Du kannst neue Ziele für die Kopie bestimmen.\', \'type\': \'Kreatur — Feenwesen, Berater\', \'flavor\': \'„… also, der Ritter stach auf den Troll ein, der Troll warf den Ritter von der Brücke und beide haben das Schwert vergessen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629807&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2b948d7a-3d64-435d-821b-51cd456d029e\', \'multiverseId\': 629807}, \'multiverseid\': 629807}, {\'name\': \'Canciller de los cuentos\', \'text\': \'Vuela.\\nSiempre que lances un hechizo de Aventura, puedes copiarlo. Puedes elegir nuevos objetivos para la copia.\', \'type\': \'Criatura — Consejero hada\', \'flavor\': \'"... así que el caballero apuñaló al trol, el trol lanzó al caballero por el puente y ambos se olvidaron de la espada".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630068&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a2489a1d-5b7d-4631-8447-ed5a24c0804e\', \'multiverseId\': 630068}, \'multiverseid\': 630068}, {\'name\': \'Chancelière des contes\', \'text\': "Vol\\nÀ chaque fois que vous lancez un sort d\'aventure, vous pouvez le copier. Vous pouvez choisir de nouvelles cibles pour cette copie.", \'type\': \'Créature — peuple fée et conseiller\', \'flavor\': "« ... et le chevalier frappa le troll, le troll poussa le chevalier du pont, et tous deux oublièrent l\'épée. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630329&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'21fcc7e3-19f4-4a3d-a94d-7abe37d73ce0\', \'multiverseId\': 630329}, \'multiverseid\': 630329}, {\'name\': \'Cancelliere dei Racconti\', \'text\': \'Volare\\nOgniqualvolta lanci una magia Avventura, puoi copiarla. Puoi scegliere nuovi bersagli per la copia.\', \'type\': \'Creatura — Consigliere Spiritello\', \'flavor\': \'"... quindi il cavaliere ha pugnalato il troll, il troll ha gettato il cavaliere giù dal ponte ed entrambi si sono dimenticati della spada."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630590&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b5d3afd4-61c3-40e1-b0bf-8c69fa030790\', \'multiverseId\': 630590}, \'multiverseid\': 630590}, {\'name\': \'伝承の大長\', \'text\': \'飛行\\nあなたが出来事・呪文１つを唱えるたび、その呪文をコピーしてもよい。そのコピーの新しい対象を選んでもよい。\', \'type\': \'クリーチャー — フェアリー・アドバイザー\', \'flavor\': \'「……それで騎士がトロールを刺して、そうしたらトロールが騎士を橋から放り出して、ふたりとも剣の事を忘れてしまったのよ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630851&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'297b2120-53e8-4e21-972e-41e291e24458\', \'multiverseId\': 630851}, \'multiverseid\': 630851}, {\'name\': \'Chanceler dos Contos\', \'text\': \'Voar\\nToda vez que você conjura uma mágica de Aventura, você pode copiá-la. Você pode escolher novos alvos para a cópia.\', \'type\': \'Criatura — Fada Conselheiro\', \'flavor\': \'"... então o cavaleiro esfaqueou o trol, daí o trol jogou o cavaleiro da ponte e os dois esqueceram da espada."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631112&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'831e6deb-8e29-48e9-b869-a97f86bfa2a8\', \'multiverseId\': 631112}, \'multiverseid\': 631112}, {\'name\': \'奇谭总领\', \'text\': \'飞行\\n每当你施放历险咒语时，你可以将它复制。你可以为该复制品选择新的目标。\', \'type\': \'生物 — 仙灵／参谋\', \'flavor\': \'「…最后，骑士刺中巨魔，巨魔将骑士打落桥下，大家都忘了宝剑的事情。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631373&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'247f3f0d-45ce-4720-af79-f4e2a5f04cdb\', \'multiverseId\': 631373}, \'multiverseid\': 631373}]', "[{'name': 'Kellan, the Fae-Blooded // Erb-Segen', 'text': 'Doppelschlag\\nAndere Kreaturen, die du kontrollierst, erhalten +1/+0 für jede Aura oder Ausrüstung, die an Kellan Feenblut angelegt ist.', 'type': 'Legendäre Kreatur — Mensch, Feenwesen', 'flavor': None, 'faceName': 'Kellan, the Fae-Blooded', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629992&type=card', 'language': 'German', 'identifiers': {'scryfallId': '34802492-f24a-4729-9b88-f7c9da272376', 'multiverseId': 629992}, 'multiverseid': 629992}, {'name': 'Kellan, the Fae-Blooded // Jugar con ventaja', 'text': 'Daña dos veces.\\nLas otras criaturas que controlas obtienen +1/+0 por cada Aura y Equipo anexados a Kellan, descendiente de hadas.', 'type': 'Criatura legendaria — Hada humano', 'flavor': None, 'faceName': 'Kellan, the Fae-Blooded', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630253&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'fc3162c8-c1f5-4042-82ae-481420c71642', 'multiverseId': 630253}, 'multiverseid': 630253}, {'name': 'Kellan, the Fae-Blooded // Faveur du droit de naissance', 'text': 'Double initiative\\nLes autres créatures que vous contrôlez gagnent +1/+0 pour chaque aura et chaque équipement attachés à Kellan, au sang de fae.', 'type': 'Créature légendaire — humain et peuple fée', 'flavor': None, 'faceName': 'Kellan, the Fae-Blooded', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630514&type=card', 'language': 'French', 'identifiers': {'scryfallId': '21d0f9b4-fbc4-45ad-8e80-f0c0d86fd066', 'multiverseId': 630514}, 'multiverseid': 630514}, {'name': 'Kellan, the Fae-Blooded // Diritto di Nascita', 'text': 'Doppio attacco\\nLe altre creature che controlli prendono +1/+0 per ogni Aura ed Equipaggiamento assegnati a Kellan dal Sangue Fatato.', 'type': 'Creatura Leggendaria — Spiritello Umano', 'flavor': None, 'faceName': 'Kellan, the Fae-Blooded', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630775&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'f1445b89-27b7-49de-845a-60f7c046d594', 'multiverseId': 630775}, 'multiverseid': 630775}, {'name': 'Kellan, the Fae-Blooded // 生（う）まれつきの加（か）護（ご）', 'text': '二段攻撃\\nあなたがコントロールしていてこれでないすべてのクリーチャーは、オーラや装備品のうちフェイの血筋のケランについている１つにつき＋１/＋０の修整を受ける。', 'type': '伝説のクリーチャー — 人間・フェアリー', 'flavor': None, 'faceName': 'Kellan, the Fae-Blooded', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631036&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9c3b0a4f-1c5c-45da-88f1-a5a9e25af44b', 'multiverseId': 631036}, 'multiverseid': 631036}, {'name': 'Kellan, the Fae-Blooded // Bênção de Nascença', 'text': 'Golpe duplo\\nAs outras criaturas que você controla recebem +1/+0 por cada Aura e Equipamento anexado a Kellan do Sangue Feérico.', 'type': 'Criatura Lendária — Humano Fada', 'flavor': None, 'faceName': 'Kellan, the Fae-Blooded', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631297&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1bc9df4c-b033-4e97-a76d-57e5630e54e4', 'multiverseId': 631297}, 'multiverseid': 631297}, {'name': 'Kellan, the Fae-Blooded // 初生恩泽', 'text': '连击\\n仙儿血脉凯澜上每贴附一个灵气和武具，由你操控的其他生物便得+1/+0。', 'type': '传奇生物 — 人类／仙灵', 'flavor': None, 'faceName': 'Kellan, the Fae-Blooded', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631558&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '13aae133-f2e5-42fd-986d-f20baa20406d', 'multiverseId': 631558}, 'multiverseid': 631558}]", '[{\'name\': \'Kellans Lichtklingen\', \'text\': \'Feilschen (Du kannst ein Artefakt, eine Verzauberung oder einen Spielstein opfern, sowie du diesen Zauberspruch wirkst.)\\nKellans Lichtklingen fügen einer angreifenden oder blockenden Kreatur deiner Wahl 3 Schadenspunkte zu. Falls um diesen Zauberspruch gefeilscht wurde, zerstöre stattdessen die Kreatur.\', \'type\': \'Spontanzauber\', \'flavor\': \'Kellan führte seinen Schlag mit purem Instinkt aus und seine beschworenen Klingen spalteten die eisigen Wächter, als wären sie aus Luft.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629780&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'74a5a2c9-5c6b-4456-8a6a-25671cc4f904\', \'multiverseId\': 629780}, \'multiverseid\': 629780}, {\'name\': \'Hojas de luz de Kellan\', \'text\': \'Negociar. (Puedes sacrificar un artefacto, encantamiento o ficha al lanzar este hechizo.)\\nLas Hojas de luz de Kellan hacen 3 puntos de daño a la criatura atacante o bloqueadora objetivo. Si este hechizo fue negociado, en vez de eso, destruye esa criatura.\', \'type\': \'Instantáneo\', \'flavor\': \'Kellan golpeó por puro instinto y sus hojas conjuradas atravesaron a los helados guardianes como si fueran de aire.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630041&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'039d4217-8f25-4ecc-9269-b8485a7e62ed\', \'multiverseId\': 630041}, \'multiverseid\': 630041}, {\'name\': \'Lames de lumière de Kellan\', \'text\': \'Négociation (Vous pouvez sacrifier un artefact, un enchantement ou un jeton au moment où vous lancez ce sort.)\\nLes Lames de lumière de Kellan infligent 3 blessures à une créature attaquante ou bloqueuse ciblée. Si ce sort a été négocié, détruisez cette créature à la place.\', \'type\': \'Éphémère\', \'flavor\': "Kellan se laissa guider par ses instincts, et ses lames conjurées tranchèrent les gardiens glacés comme s\'ils n\'étaient faits que d\'air.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630302&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'11849451-8c02-41ad-84cc-5d1f9bf72a44\', \'multiverseId\': 630302}, \'multiverseid\': 630302}, {\'name\': \'Lame di Luce di Kellan\', \'text\': \'Negoziare (Puoi sacrificare un artefatto, un incantesimo o una pedina mentre lanci questa magia.)\\nLe Lame di Luce di Kellan infliggono 3 danni a una creatura attaccante o bloccante bersaglio. Se questa magia è stata negoziata, distruggi invece quella creatura.\', \'type\': \'Istantaneo\', \'flavor\': \'Kellan colpì guidato dal puro istinto e le sue lame evocate fendettero i gelidi guardiani come se non fossero altro che aria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630563&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5455626f-8c25-457d-9fc1-0885acbb1aa4\', \'multiverseId\': 630563}, \'multiverseid\': 630563}, {\'name\': \'ケランの光刃\', \'text\': \'協約（この呪文を唱えるに際し、アーティファクトやエンチャントやトークンのうち１つを生け贄に捧げてもよい。）\\n攻撃クリーチャーやブロック・クリーチャーのうち１体を対象とする。ケランの光刃はそれに３点のダメージを与える。この呪文が協約されていたなら、代わりにそのクリーチャーを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'ケランは本能のまま斬りつけた。彼が創り出した刃は氷でできた護衛たちをまるで空気のように切り裂いていった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630824&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bee93498-d67b-4fcd-9784-5815ec11668b\', \'multiverseId\': 630824}, \'multiverseid\': 630824}, {\'name\': \'Lumilâminas de Kellan\', \'text\': \'Negociar (Você pode sacrificar um artefato, um encantamento ou uma ficha conforme conjura esta mágica.)\\nLumilâminas de Kellan causa 3 pontos de dano à criatura atacante ou bloqueadora alvo. Se esta mágica foi negociada, em vez disso, destrua aquela criatura.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Kellan atacou por puro instinto, e suas lâminas conjuradas trespassaram os guardiões gélidos como se fossem feitos de vento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631085&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ec89c307-eed5-4f20-bd77-f3991cf994de\', \'multiverseId\': 631085}, \'multiverseid\': 631085}, {\'name\': \'凯澜光刃斩\', \'text\': \'加码（你施放此咒语时可以牺牲一个神器，结界或衍生物。）\\n凯澜光刃斩对目标进行攻击或阻挡的生物造成3点伤害。如果此咒语已加码，则改为消灭该生物。\', \'type\': \'瞬间\', \'flavor\': \'凯澜就只是凭着本能甩手回击，未想这幻变刀刃却轻松撕裂寒冰守卫身躯，如若无物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631346&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'141c85be-2e74-470a-8704-31bd2511a884\', \'multiverseId\': 631346}, \'multiverseid\': 631346}]', '[{\'name\': \'Kesselfüllung\', \'text\': \'Zerstöre eine Kreatur deiner Wahl mit Manabetrag 3 oder weniger. Falls es dein Zug ist, erzeuge einen Speise-Spielstein. (Er ist ein Artefakt mit „{2}, {T}, opfere dieses Artefakt: Du erhältst 3 Lebenspunkte dazu.")\', \'type\': \'Spontanzauber\', \'flavor\': \'Kellan vernahm, wie Agatha aufheulte, als er sie stieß; er vernahm ihren Schrei, als sie in den Kessel fiel, aber über alles Weitere wollte er lieber nicht nachdenken.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629853&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'988bf1ca-5a5b-415a-9b74-208edfd2d174\', \'multiverseId\': 629853}, \'multiverseid\': 629853}, {\'name\': \'Meter en el caldero\', \'text\': \'Destruye la criatura objetivo con valor de maná de 3 o menos. Si es tu turno, crea una ficha de Comida. (Es un artefacto con "{2}, {T}, sacrificar este artefacto: Ganas 3 vidas".)\', \'type\': \'Instantáneo\', \'flavor\': \'Kellan escuchó a Agatha gritar cuando chocó contra ella y cuando cayó en el caldero, pero en ese momento no podía pensar en las consecuencias.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630114&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7f750026-3e64-49b6-a632-254f88dfac41\', \'multiverseId\': 630114}, \'multiverseid\': 630114}, {\'name\': \'Nourrir le chaudron\', \'text\': "Détruisez une créature ciblée avec une valeur de mana inférieure ou égale à 3. Si c\'est votre tour, créez un jeton Nourriture. (C\'est un artefact avec « {2}, {T}, sacrifiez cet artefact : Vous gagnez 3 points de vie. »)", \'type\': \'Éphémère\', \'flavor\': \'Agatha poussa un cri quand il la percuta, hurla quand elle tomba dans le chaudron, mais Kellan ne pouvait pas encore se permettre de songer aux implications de son geste.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630375&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'51b8d857-7c0b-4000-b7bb-3c34c1d995b5\', \'multiverseId\': 630375}, \'multiverseid\': 630375}, {\'name\': \'Nutrire il Calderone\', \'text\': \'Distruggi una creatura bersaglio con valore di mana pari o inferiore a 3. Se è il tuo turno, crea una pedina Cibo. (È un artefatto con "{2}, {T}, Sacrifica questo artefatto: Guadagni 3 punti vita".)\', \'type\': \'Istantaneo\', \'flavor\': \'Kellan udì Agata urlare quando le sbatté contro, la udì gridare quando cadde nel calderone, ma non aveva tempo di pensare alle implicazioni.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630636&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'99ad93c0-8e6d-44d9-9983-2e5dd495acda\', \'multiverseId\': 630636}, \'multiverseid\': 630636}, {\'name\': \'大釜への給餌\', \'text\': \'マナ総量が３以下であるクリーチャー１体を対象とする。それを破壊する。あなたのターンであるなら、食物・トークン１つを生成する。（それは、「{2}, {T}, このアーティファクトを生け贄に捧げる：あなたは３点のライフを得る。」を持つアーティファクトである。）\', \'type\': \'インスタント\', \'flavor\': \'ケランは叫ぶアガサに体当たりして、大釜の中に落ち行く彼女の悲鳴を聞いた。しかし、彼にはそれがどんな結果を引き起こすのかを考える余裕はなかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630897&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2b1acf87-03d8-4520-a2a5-f9dee668e49d\', \'multiverseId\': 630897}, \'multiverseid\': 630897}, {\'name\': \'Alimentar o Caldeirão\', \'text\': \'Destrua a criatura alvo com valor de mana igual ou inferior a 3. Se for o seu turno, crie uma ficha de Comida. (Ela é um artefato com "{2}, {T}, sacrifique este artefato: Você ganha 3 pontos de vida".)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Kellan ouviu Agatha uivar quando a abalroou, ouviu-a gritar quando ela caiu no caldeirão, mas ainda não podia se dar ao luxo de pensar no significado daquilo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631158&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3e475e4f-6583-43cc-9ccd-ba10f9cf4e7f\', \'multiverseId\': 631158}, \'multiverseid\': 631158}, {\'name\': \'跌入鼎镬\', \'text\': \'消灭目标法术力值等于或小于3的生物。如果是在你的回合中，则派出一个食品衍生物。（它是具有「{2}，{T}，牺牲此神器：你获得3点生命」的神器。）\', \'type\': \'瞬间\', \'flavor\': \'凯澜听到阿加莎怒吼时慌不择路迎头撞上，使得后者脚步趔趄跌入镬中，凶狠咆哮旋即变作痛苦哀嚎。此时凯澜还未意识到自己已完成一件壮举。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631419&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'40e4db7e-06b3-4f69-b8c1-94b28786d6f6\', \'multiverseId\': 631419}, \'multiverseid\': 631419}]', '[{\'name\': \'Kleinmacher-Hexe\', \'text\': \'Feilschen (Du kannst ein Artefakt, eine Verzauberung oder einen Spielstein opfern, sowie du diesen Zauberspruch wirkst.)\\nWenn die Kleinmacher-Hexe ins Spiel kommt und falls um sie gefeilscht wurde, erzeuge einen Verflucht-Rolle-Spielstein, angelegt an eine Kreatur deiner Wahl, die ein Gegner kontrolliert (Falls du bereits eine andere daran angelegte Rolle kontrollierst, lege die alte Rolle auf den Friedhof. Die verzauberte Kreatur ist 1/1.)\', \'type\': \'Kreatur — Mensch, Hexenmeister\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629808&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4773643f-0fb4-4f54-8d82-bf74eeeeb1bc\', \'multiverseId\': 629808}, \'multiverseid\': 629808}, {\'name\': \'Bruja de la disminución\', \'text\': \'Negociar. (Puedes sacrificar un artefacto, encantamiento o ficha al lanzar este hechizo.)\\nCuando la Bruja de la disminución entre al campo de batalla, si fue negociada, crea una ficha de Papel de Maldito anexada a la criatura objetivo que controla un oponente. (Si controlas otro Papel sobre ella, pon ese en el cementerio. La criatura encantada es 1/1.)\', \'type\': \'Criatura — Brujo humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630069&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b80f4674-0612-4689-82be-e3836c0c795d\', \'multiverseId\': 630069}, \'multiverseid\': 630069}, {\'name\': \'Envoûteuse réductrice\', \'text\': "Négociation (Vous pouvez sacrifier un artefact, un enchantement ou un jeton au moment où vous lancez ce sort.)\\nQuand l\'Envoûteuse réductrice arrive sur le champ de bataille, si elle a été négociée, créez un jeton de rôle Maudit attaché à une créature ciblée qu\'un adversaire contrôle. (Si vous contrôlez un autre rôle sur elle, mettez-le au cimetière. La créature enchantée est 1/1.)", \'type\': \'Créature — humain et psychagogue\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630330&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'59da6893-2b72-4277-ba19-30c7a1ef8282\', \'multiverseId\': 630330}, \'multiverseid\': 630330}, {\'name\': \'Strega Riduttrice\', \'text\': \'Negoziare (Puoi sacrificare un artefatto, un incantesimo o una pedina mentre lanci questa magia.)\\nQuando la Strega Riduttrice entra nel campo di battaglia, se è stata negoziata, crea una pedina Ruolo Maledetto assegnata a una creatura bersaglio controllata da un avversario. (Se controlli un altro Ruolo assegnato a quella creatura, metti quel Ruolo nel cimitero. La creatura incantata è 1/1.)\', \'type\': \'Creatura — Warlock Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630591&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'21a53be1-2d78-4761-a9ab-f297ccc1b311\', \'multiverseId\': 630591}, \'multiverseid\': 630591}, {\'name\': \'縮小術の魔女\', \'text\': \'協約（この呪文を唱えるに際し、アーティファクトやエンチャントやトークンのうち１つを生け贄に捧げてもよい。）\\n縮小術の魔女が戦場に出たとき、これが協約されていた場合、対戦相手がコントロールしているクリーチャー１体を対象とする。呪われし者・役割・トークン１つをそれについた状態で生成する。（あなたがコントロールしている役割がすでにそれについていたなら、その役割を墓地に置く。エンチャントしているクリーチャーは１/１である。）\', \'type\': \'クリーチャー — 人間・邪術師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630852&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2a1f3f31-15f0-491f-9731-8d9986c40af6\', \'multiverseId\': 630852}, \'multiverseid\': 630852}, {\'name\': \'Bruxa Encolhedora\', \'text\': \'Negociar (Você pode sacrificar um artefato, um encantamento ou uma ficha conforme conjura esta mágica.)\\nQuando Bruxa Encolhedora entrar no campo de batalha, se ela tiver sido negociada, crie uma ficha de Papel de Amaldiçoado anexada à criatura alvo que um oponente controla. (Se você controlar outro Papel nela, coloque aquele no cemitério. A criatura encantada é 1/1.)\', \'type\': \'Criatura — Humano Bruxo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631113&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'af7cb489-37e1-46c2-9c9c-3974a1a9638f\', \'multiverseId\': 631113}, \'multiverseid\': 631113}, {\'name\': \'缩形巫婆\', \'text\': \'加码（你施放此咒语时可以牺牲一个神器，结界或衍生物。）\\n当缩形巫婆进战场时，若它已加码，则派出一个倒楣鬼角色衍生物，并贴附在目标由对手操控的生物上。（如果其上已有另一个你操控的角色，则将已有之角色置入坟墓场。所结附的生物是1/1。）\', \'type\': \'生物 — 人类／邪术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631374&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'521678c2-bd64-44bc-bbdb-51a62adfb74d\', \'multiverseId\': 631374}, \'multiverseid\': 631374}]', '[{\'name\': \'Kommunikation mit der Natur\', \'text\': \'Schaue dir die obersten fünf Karten deiner Bibliothek an. Du kannst davon eine Kreaturenkarte offen vorzeigen und auf deine Hand nehmen. Lege den Rest in beliebiger Reihenfolge unter deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': \'Agatha freundete sich mit den Tieren der Wildnis an und unter ihrem Einfluss wurden sie kühner … und wilder. Manche Pflanzenfresser kamen sogar auf den Geschmack von Fleisch.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629928&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'61758c7a-be1d-4c78-9491-7dce2da9cb04\', \'multiverseId\': 629928}, \'multiverseid\': 629928}, {\'name\': \'En comunión con la naturaleza\', \'text\': \'Mira las cinco primeras cartas de tu biblioteca. Puedes mostrar una carta de criatura de entre ellas y ponerla en tu mano. Pon el resto en el fondo de tu biblioteca en cualquier orden.\', \'type\': \'Conjuro\', \'flavor\': \'Agatha entabló amistad con las bestias y, bajo su influencia, se volvieron más atrevidas... y más salvajes. A algunos herbívoros les empezó a gustar la carne.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630189&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c32c68fe-4761-4a99-83ef-500dcabefb63\', \'multiverseId\': 630189}, \'multiverseid\': 630189}, {\'name\': \'Communion avec la nature\', \'text\': "Regardez les cinq cartes du dessus de votre bibliothèque. Vous pouvez révéler une carte de créature parmi elles et la mettre dans votre main. Mettez le reste au-dessous de votre bibliothèque, dans l\'ordre de votre choix.", \'type\': \'Rituel\', \'flavor\': "Agatha devint l\'amie des bêtes des friches, et sous son influence, elles devinrent plus audacieuses... et plus sauvages. Certains herbivores commencèrent même à apprécier la viande.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630450&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'89096c31-29ae-4ad1-af9d-bab6c4b146b7\', \'multiverseId\': 630450}, \'multiverseid\': 630450}, {\'name\': \'Comunione con la Natura\', \'text\': \'Guarda le prime cinque carte del tuo grimorio. Puoi rivelare una carta creatura scelta tra esse e aggiungerla alla tua mano. Metti le altre in fondo al tuo grimorio in qualsiasi ordine.\', \'type\': \'Stregoneria\', \'flavor\': \'Agata era diventata amica delle bestie nelle terre selvagge, che sotto la sua influenza erano diventate più audaci... e più feroci. Alcuni erbivori avevano sviluppato un appetito per la carne.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630711&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1d15ec26-a316-4fd2-b5f9-975427ced596\', \'multiverseId\': 630711}, \'multiverseid\': 630711}, {\'name\': \'自然との融和\', \'text\': \'あなたのライブラリーの一番上にあるカード５枚を見る。「その中からクリーチャー・カード１枚を公開し、あなたの手札に加える。」を選んでもよい。残りをあなたのライブラリーの一番下に望む順番で置く。\', \'type\': \'ソーサリー\', \'flavor\': \'アガサは僻境の多くの獣を手懐け、彼女の影響によりその獣たちはより大胆に……そしてより獰猛になった。草食動物の中には肉の味を覚えたものもいた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630972&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'55bdb5a3-d08d-4f62-9b2c-a7af4db86ea8\', \'multiverseId\': 630972}, \'multiverseid\': 630972}, {\'name\': \'Comungar com a Natureza\', \'text\': \'Olhe os cinco cards do topo de seu grimório. Você pode revelar um card de criatura dentre eles e colocá-lo em sua mão. Coloque o restante no fundo de seu grimório em qualquer ordem.\', \'type\': \'Feitiço\', \'flavor\': \'Agatha fez amizade com as feras selvagens e, sob a influência dela, elas se tornaram mais ousadas... e ainda mais selvagens. Alguns herbívoros tomaram gosto pela carne.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631233&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'df60ddd5-35b0-4f6c-8bf5-818ab2814685\', \'multiverseId\': 631233}, \'multiverseid\': 631233}, {\'name\': \'林野商谈\', \'text\': \'检视你牌库顶的五张牌。你可以展示其中一张生物牌并置于你手上。将其余的牌以任意顺序置于你牌库底。\', \'type\': \'法术\', \'flavor\': \'阿加莎漫游幻野，广交野兽，而野兽也受其影响愈发凶狠、野性十足。甚至有些食草动物开始对血肉有了兴趣。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631494&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d784628e-4fc7-4c36-ae8e-d28085722ae4\', \'multiverseId\': 631494}, \'multiverseid\': 631494}]', '[{\'name\': \'Korvold und der Edle Dieb\', \'text\': \'(Je eine Sagenmarke beim Ins-Spiel-Kommen und nach deinem Ziehsegment. Opfern nach III.)\\nI, II — Erzeuge einen Schatz-Spielstein. (Er ist ein Artefakt mit „{T}, opfere dieses Artefakt: Erzeuge ein Mana einer beliebigen Farbe.")\\nIII — Schicke die obersten drei Karten der Bibliothek eines Gegners deiner Wahl ins Exil. Du kannst sie in diesem Zug spielen.\', \'type\': \'Verzauberung — Sage\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629901&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'79dfb42c-a354-4750-ad13-793dd25f0237\', \'multiverseId\': 629901}, \'multiverseid\': 629901}, {\'name\': \'Korvold y el ladrón noble\', \'text\': \'(En cuanto esta Saga entre y después de tu paso de robar, agrega un contador de sabiduría. Sacrifícala después de III.)\\nI, II — Crea una ficha de Tesoro. (Es un artefacto con "{T}, sacrificar este artefacto: Agrega un maná de cualquier color".)\\nIII — Exilia las tres primeras cartas de la biblioteca del oponente objetivo. Puedes jugar esas cartas este turno.\', \'type\': \'Encantamiento — Saga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630162&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9b348449-1e7f-4bda-9a26-8a79d4b47002\', \'multiverseId\': 630162}, \'multiverseid\': 630162}, {\'name\': \'Korvold et le noble voleur\', \'text\': "(Au moment où cette saga arrive sur le champ de bataille et après votre étape de pioche, ajoutez un marqueur « sapience ». Sacrifiez après III.)\\nI, II — Créez un jeton Trésor. (C\'est un artefact avec « {T}, sacrifiez cet artefact : Ajoutez un mana de la couleur de votre choix. »)\\nIII— Exilez les trois cartes du dessus de la bibliothèque d\'un adversaire ciblé. Vous pouvez jouer ces cartes ce tour-ci.", \'type\': \'Enchantement — saga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630423&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2c4b9217-aeeb-4335-97f5-bf703fa6ea9b\', \'multiverseId\': 630423}, \'multiverseid\': 630423}, {\'name\': \'Korvold e il Ladro Nobile\', \'text\': \'(Mentre questa Saga entra e dopo la tua acquisizione, aggiungi un segnalino sapere. Sacrifica dopo III.)\\nI, II — Crea una pedina Tesoro. (È un artefatto con "{T}, Sacrifica questo artefatto: Aggiungi un mana di un qualsiasi colore".)\\nIII — Esilia le prime tre carte del grimorio di un avversario bersaglio. Puoi giocare quelle carte in questo turno.\', \'type\': \'Incantesimo — Saga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630684&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7a005024-a071-48a9-8cd9-41db0e249281\', \'multiverseId\': 630684}, \'multiverseid\': 630684}, {\'name\': \'コルヴォルドと高貴なる盗賊\', \'text\': \'（この英雄譚が出た際とあなたのドロー・ステップの後に、伝承カウンター１個を加える。IIIの後に、生け贄に捧げる。）\\nI, II — 宝物・トークン１つを生成する。（それは、「{T}, このアーティファクトを生け贄に捧げる：好きな色１色のマナ１点を加える。」を持つアーティファクトである。）\\nIII — 対戦相手１人を対象とする。そのプレイヤーのライブラリーの一番上にあるカード３枚を追放する。このターン、あなたはそれらのカードをプレイしてもよい。\', \'type\': \'エンチャント — 英雄譚\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630945&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d34b5678-655b-4db0-b09f-7ca262fbb819\', \'multiverseId\': 630945}, \'multiverseid\': 630945}, {\'name\': \'Korvold e o Ladrão Nobre\', \'text\': \'(Conforme esta Saga entra e após sua etapa de compra, adicione um marcador de conhecimento. Sacrifique-a após III.)\\nI, II — Crie uma ficha de Tesouro. (Ela é um artefato com "{T}, sacrifique este artefato: Adicione um mana de qualquer cor".)\\nIII — Exile os três cards do topo do grimório do oponente alvo. Você pode jogar aqueles cards neste turno.\', \'type\': \'Encantamento — Saga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631206&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f579a667-d248-4220-bbfc-1af25a0cf7bd\', \'multiverseId\': 631206}, \'multiverseid\': 631206}, {\'name\': \'寇沃与侠盗\', \'text\': \'（于此传纪进战场时及于你抓牌步骤后，加一个学问指示物。到III后牺牲之。）\\nI, II — 派出一个珍宝衍生物。（它是具有「{T}，牺牲此神器：加一点任意颜色的法术力」的神器。）\\nIII — 放逐目标对手牌库顶的三张牌。本回合中，你可以使用这些牌。\', \'type\': \'结界 — 传纪\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631467&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0c6b8482-85ac-4ec5-94b8-1483a48ebedb\', \'multiverseId\': 631467}, \'multiverseid\': 631467}]', '[{\'name\': \'Kreisch-Croissant\', \'text\': \'Todesberührung\\nImmer wenn das Kreisch-Croissant einem Spieler Kampfschaden zufügt, erzeuge einen Speise-Spielstein. (Er ist ein Artefakt mit „{2}, {T}, opfere dieses Artefakt: Du erhältst 3 Lebenspunkte dazu.")\', \'type\': \'Kreatur — Schrecken\', \'flavor\': \'Zu viel Zucker ist ungesund.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629867&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c89b1a9b-6ad6-496a-86d6-6efc6f07b151\', \'multiverseId\': 629867}, \'multiverseid\': 629867}, {\'name\': \'Profiterror\', \'text\': \'Toque mortal.\\nSiempre que el Profiterror haga daño de combate a un jugador, crea una ficha de Comida. (Es un artefacto con "{2}, {T}, sacrificar este artefacto: Ganas 3 vidas".)\', \'type\': \'Criatura — Horror\', \'flavor\': \'El exceso de azúcar es malo para la salud.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630128&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1c651d06-25f0-454e-a67f-0e02b39207bf\', \'multiverseId\': 630128}, \'multiverseid\': 630128}, {\'name\': \'Choux à la crime\', \'text\': "Contact mortel\\nÀ chaque fois que le Choux à la crime inflige des blessures de combat à un joueur, créez un jeton Nourriture. (C\'est un artefact avec « {2}, {T}, sacrifiez cet artefact : Vous gagnez 3 points de vie. »)", \'type\': \'Créature — horreur\', \'flavor\': "Trop de sucre, c\'est mauvais pour la santé.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630389&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6a4e175e-57ad-4b6e-8bd6-b15015a67d2b\', \'multiverseId\': 630389}, \'multiverseid\': 630389}, {\'name\': \'Muoritozzo\', \'text\': \'Tocco letale\\nOgniqualvolta il Muoritozzo infligge danno da combattimento a un giocatore, crei una pedina Cibo. (È un artefatto con "{2}, {T}, Sacrifica questo artefatto: Guadagni 3 punti vita".)\', \'type\': \'Creatura — Orrore\', \'flavor\': \'Troppo zucchero fa male alla salute.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630650&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'18a3ae88-4c82-44d4-b51b-e346125bb550\', \'multiverseId\': 630650}, \'multiverseid\': 630650}, {\'name\': \'襲クリーム\', \'text\': \'接死\\n襲クリームがプレイヤー１人に戦闘ダメージを与えるたび、食物・トークン１つを生成する。（それは、「{2}, {T}, このアーティファクトを生け贄に捧げる：あなたは３点のライフを得る。」を持つアーティファクトである。）\', \'type\': \'クリーチャー — ホラー\', \'flavor\': \'糖分の摂り過ぎは身体に悪い。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630911&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b074e168-7a30-44ff-9b90-45c13a821f98\', \'multiverseId\': 630911}, \'multiverseid\': 630911}, {\'name\': \'Profiterror\', \'text\': \'Toque mortífero\\nToda vez que Profiterror causar dano de combate a um jogador, crie uma ficha de Comida. (Ela é um artefato com "{2}, {T}, sacrifique este artefato: Você ganha 3 pontos de vida".)\', \'type\': \'Criatura — Horror\', \'flavor\': \'Açúcar demais faz mal para os dentes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631172&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6a088c47-f6cf-4869-9600-a57b94830779\', \'multiverseId\': 631172}, \'multiverseid\': 631172}, {\'name\': \'泡芙蓬怪\', \'text\': \'死触\\n每当泡芙蓬怪对任一牌手造成战斗伤害时，派出一个食品衍生物。（它是具有「{2}，{T}，牺牲此神器：你获得3点生命」的神器。）\', \'type\': \'生物 — 惊惧兽\', \'flavor\': \'糖分太多有害健康。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631433&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b05b2464-02b9-4d4f-855d-a43903ebe360\', \'multiverseId\': 631433}, \'multiverseid\': 631433}]', '[{\'name\': \'Kristallgrotte\', \'text\': \'Wenn die Kristallgrotte ins Spiel kommt, wende Hellsicht 1 an.\\n{T}: Erzeuge {C}.\\n{1}, {T}: Erzeuge ein Mana einer beliebigen Farbe.\', \'type\': \'Land\', \'flavor\': \'Das wenige Licht, das durch den Frost in die Tiefe dringt, wird in zahllose Regenbogenscherben gebrochen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630016&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d05541ec-a958-41ea-b5cc-9727d1e02a3e\', \'multiverseId\': 630016}, \'multiverseid\': 630016}, {\'name\': \'Gruta de cristal\', \'text\': \'Cuando la Gruta de cristal entre al campo de batalla, adivina 1.\\n{T}: Agrega {C}.\\n{1}, {T}: Agrega un maná de cualquier color.\', \'type\': \'Tierra\', \'flavor\': \'La poca luz que se filtra entre la escarcha y el agua se refleja en un millón de fragmentos de arcoíris.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630277&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'281d7e38-9b55-4ac0-be80-85f36fc4833a\', \'multiverseId\': 630277}, \'multiverseid\': 630277}, {\'name\': \'Grotte de cristal\', \'text\': \'Quand la Grotte de cristal arrive sur le champ de bataille, regard 1.\\n{T} : Ajoutez {C}.\\n{1}, {T} : Ajoutez un mana de la couleur de votre choix.\', \'type\': \'Terrain\', \'flavor\': "Le peu de lumière qui traverse la glace et les flots se reflète en un million d\'éclats arc-en-ciel.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630538&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2cf61a8a-297e-4abf-af18-e4acb09576ba\', \'multiverseId\': 630538}, \'multiverseid\': 630538}, {\'name\': \'Grotta di Cristallo\', \'text\': \'Quando la Grotta di Cristallo entra nel campo di battaglia, profetizza 1.\\n{T}: Aggiungi {C}.\\n{1}, {T}: Aggiungi un mana di un qualsiasi colore.\', \'type\': \'Terra\', \'flavor\': \'La fioca luce che filtra attraverso il ghiaccio e le profondità viene riflessa in un milione di arcobaleni.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630799&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'15a042cc-2593-4e4f-91a4-606b8c31a029\', \'multiverseId\': 630799}, \'multiverseid\': 630799}, {\'name\': \'水晶の岩屋\', \'text\': \'水晶の岩屋が戦場に出たとき、占術１を行う。\\n{T}：{C}を加える。\\n{1}, {T}：好きな色１色のマナ１点を加える。\', \'type\': \'土地\', \'flavor\': \'霜の中から漏れて深淵に差す僅かな光は屈折し、数百万もの虹色の光の断片になる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631060&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4567e514-677c-42fd-a658-c808c5bc8a5b\', \'multiverseId\': 631060}, \'multiverseid\': 631060}, {\'name\': \'Gruta dos Cristais\', \'text\': \'Quando Gruta dos Cristais entrar no campo de batalha, use vidência 1.\\n{T}: Adicione {C}.\\n{1}, {T}: Adicione um mana de qualquer cor.\', \'type\': \'Terreno\', \'flavor\': \'A pouca luz que atravessa o frio e chega às profundezas é refratada em milhões de fragmentos de arco-íris.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631321&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ee66b93f-eac9-417d-9e3a-c210e6d16d9b\', \'multiverseId\': 631321}, \'multiverseid\': 631321}, {\'name\': \'水晶石室\', \'text\': \'当水晶石室进战场时，占卜1。\\n{T}：加{C}。\\n{1}，{T}：加一点任意颜色的法术力。\', \'type\': \'地\', \'flavor\': \'穿过冰霜深水的丝缕光线，经反复折射后，化作万千霓虹碎片散落渊底。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631582&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'667009c6-094b-4133-a180-2220394b526e\', \'multiverseId\': 631582}, \'multiverseid\': 631582}]', '[{\'name\': \'Königliche Behandlung\', \'text\': \'Eine Kreatur deiner Wahl, die du kontrollierst, erhält Fluchsicherheit bis zum Ende des Zuges. Erzeuge einen an sie angelegten Königlich-Rolle-Spielstein. (Falls du bereits eine andere daran angelegte Rolle kontrollierst, lege die alte Rolle auf den Friedhof. Die verzauberte Kreatur erhält +1/+1 und hat Abwehr {1}.)\', \'type\': \'Spontanzauber\', \'flavor\': \'„Zügelt eure Klingen, Gesinde."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629945&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'faf107f5-f7d0-497e-bb65-378b4b54a707\', \'multiverseId\': 629945}, \'multiverseid\': 629945}, {\'name\': \'Tratar como a la realeza\', \'text\': \'La criatura objetivo que controlas gana la habilidad de antimaleficio hasta el final del turno. Crea una ficha de Papel de Majestad anexada a esa criatura. (Si controlas otro Papel sobre ella, pon ese en el cementerio. La criatura encantada obtiene +1/+1 y tiene la habilidad de rebatir {1}.)\', \'type\': \'Instantáneo\', \'flavor\': \'"Guarden las armas, plebeyos".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630206&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7b596a54-7ccf-43c2-9f3c-1dc30e7cc37c\', \'multiverseId\': 630206}, \'multiverseid\': 630206}, {\'name\': \'Traitement royal\', \'text\': "Une créature ciblée que vous contrôlez acquiert la défense talismanique jusqu\'à la fin du tour. Créez un jeton de rôle Royal attaché à cette créature. (Si vous contrôlez un autre rôle sur elle, mettez-le au cimetière. La créature enchantée gagne +1/+1 et a parade {1}.)", \'type\': \'Éphémère\', \'flavor\': \'« Rangez vos armes, paysans. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630467&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'660c7fd0-a4c7-45b3-b02a-c4b190550a8e\', \'multiverseId\': 630467}, \'multiverseid\': 630467}, {\'name\': \'Trattamento Regale\', \'text\': \'Una creatura bersaglio che controlli ha anti-malocchio fino alla fine del turno. Crea una pedina Ruolo Regale assegnata a quella creatura. (Se controlli un altro Ruolo assegnato a quella creatura, metti quel Ruolo nel cimitero. La creatura incantata prende +1/+1 e ha egida {1}.)\', \'type\': \'Istantaneo\', \'flavor\': \'"Riponete le vostre lame, popolo mio."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630728&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d7ad677d-5041-49a9-a785-e5ca545d6768\', \'multiverseId\': 630728}, \'multiverseid\': 630728}, {\'name\': \'王のもてなし\', \'text\': \'あなたがコントロールしているクリーチャー１体を対象とする。ターン終了時まで、それは呪禁を得る。王族・役割・トークン１つをそれについた状態で生成する。（あなたがコントロールしている役割がすでにそれについていたなら、その役割を墓地に置く。エンチャントしているクリーチャーは＋１/＋１の修整を受け護法{1}を持つ。）\', \'type\': \'インスタント\', \'flavor\': \'「武器を下せ、愚民どもめ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630989&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'febd0b56-ab8f-4a10-8d2e-982c17e312e6\', \'multiverseId\': 630989}, \'multiverseid\': 630989}, {\'name\': \'Tratamento Régio\', \'text\': \'A criatura alvo que você controla recebe resistência a magia até o final do turno. Crie uma ficha de Papel de Real anexada àquela criatura. (Se você controlar outro Papel nela, coloque aquele no cemitério. A criatura encantada recebe +1/+1 e tem salvaguarda {1}.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Contenham suas lâminas, plebeus."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631250&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7cdcd7c0-1cf2-47bc-ae26-2fa9ff7cd4f2\', \'multiverseId\': 631250}, \'multiverseid\': 631250}, {\'name\': \'皇族礼遇\', \'text\': \'目标由你操控的生物获得辟邪异能直到回合结束。派出一个皇族角色衍生物并贴附在该生物上。（如果其上已有另一个你操控的角色，则将已有之角色置入坟墓场。所结附的生物得+1/+1且具有守护{1}。）\', \'type\': \'瞬间\', \'flavor\': \'「各位平民，刀下留情。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631511&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'958c5cbb-e017-4fa7-9710-5942b7f3c9fb\', \'multiverseId\': 631511}, \'multiverseid\': 631511}]', '[{\'name\': \'Königliches Hashorn\', \'text\': \'Stärke und Widerstandskraft des Königlichen Hashorns sind gleich der Anzahl an bleibenden Karten, die keine Länder sind und die du kontrollierst.\', \'type\': \'Kreatur — Kaninchen, Einhorn\', \'flavor\': \'„Es ist völlig friedfertig, solange du nicht versuchst, es zu streicheln, es einzupferchen, ihm seine Nahrung zu nehmen, es zu häuten, dich auf sein Gras zu setzen oder es zu Ehren der Feiertage der Menschen in farbenfrohe Gewänder zu hüllen."\\n—Sturwynn, Waldläufer der Grenzlande\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629787&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'326c8374-e4e2-4255-a6ac-0c88db90bbe3\', \'multiverseId\': 629787}, \'multiverseid\': 629787}, {\'name\': \'Conecornio majestuoso\', \'text\': \'Tanto la fuerza como la resistencia del Conecornio majestuoso son iguales a la cantidad de permanentes que no sean tierra que controlas.\', \'type\': \'Criatura — Unicornio conejo\', \'flavor\': \'"Es de lo más pacífico, siempre que no trates de acariciarlo, enjaularlo, tomar su comida, quitarle la piel, sentarte en su hierba o vestirlo con ropas coloridas para las festividades humanas".\\n—Sturwynn, arquero de las Tierras Fronterizas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630048&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b09a9b63-a57f-41b8-bb33-4a3df9ead6be\', \'multiverseId\': 630048}, \'multiverseid\': 630048}, {\'name\': \'Lapicorne royal\', \'text\': "La force et l\'endurance du Lapicorne royal sont chacune égales au nombre de permanents non-terrain que vous contrôlez.", \'type\': \'Créature — lapin et licorne\', \'flavor\': "« Il est totalement inoffensif tant que vous n\'essayez pas de le caresser, de le mettre en cage, de prendre sa nourriture ou sa peau, de s\'assoir sur son herbe ou de lui mettre des costumes festifs pour des fêtes humaines. »\\n—Sturwynn, ranger des terres frontalières", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630309&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e8c191de-48fc-4539-9bdc-1cff68671422\', \'multiverseId\': 630309}, \'multiverseid\': 630309}, {\'name\': \'Leprecorno Regale\', \'text\': \'La forza e la costituzione del Leprecorno Regale sono pari al numero di permanenti non terra che controlli.\', \'type\': \'Creatura — Coniglio Unicorno\', \'flavor\': \'"È assolutamente innocuo, finché non provi ad accarezzarlo, ingabbiarlo, prenderne il cibo o la pelliccia, sederti sulla sua erba o travestirlo per le feste degli umani."\\n—Sturwynn, ranger delle Lande Estreme\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630570&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8ffd5212-fd50-439b-ae88-d8eed88bb503\', \'multiverseId\': 630570}, \'multiverseid\': 630570}, {\'name\': \'威厳あるバニコーン\', \'text\': \'威厳あるバニコーンのパワーとタフネスは、それぞれあなたがコントロールしていて土地でないパーマネントの数に等しい。\', \'type\': \'クリーチャー — 兎・ユニコーン\', \'flavor\': \'「なでたり、檻に捕らえようとしたり、食物を奪ったり、毛皮を剝ごうとしたり、それが座る草の上に座ったり、人間の祭事にかこつけて色鮮やかな衣装を着せようとしたりしない限り、温厚な生物ですよ。」\\n――境界地のレインジャー、スターウィン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630831&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'43aad17a-8b14-4a26-8baa-02176ad67c12\', \'multiverseId\': 630831}, \'multiverseid\': 630831}, {\'name\': \'Coelhicórnio Régio\', \'text\': \'O poder e a resistência de Coelhicórnio Régio são iguais ao número de permanentes não de terreno que você controla.\', \'type\': \'Criatura — Coelho Unicórnio\', \'flavor\': \'"Ele é super tranquilo, é só não fazer carinho, não prender, não tirar sua comida, não arrancar sua pele, não sentar na sua grama nem vestir ele com roupinhas coloridas para as festas dos humanos."\\n— Sturwynn, Guardião das Terras Fronteiriças\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631092&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cc123cab-54a2-43e9-bc9e-c4eee6152cf1\', \'multiverseId\': 631092}, \'multiverseid\': 631092}, {\'name\': \'庄严独角兔\', \'text\': \'庄严独角兔的力量和防御力各等同于由你操控的非地永久物数量。\', \'type\': \'生物 — 兔／独角兽\', \'flavor\': \'「它性格很温顺啦，只要你不要去试着抚摸它、圈养它、抢它食物、剪它皮毛、坐它草坪，或是为了人类节日让它穿红戴绿就好。」\\n～边境地巡林客斯图温\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631353&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1c91f546-89bb-4070-bc5e-489aefd68cd6\', \'multiverseId\': 631353}, \'multiverseid\': 631353}]', '[{\'name\': \'Königliches Hashorn\', \'text\': \'Stärke und Widerstandskraft des Königlichen Hashorns sind gleich der Anzahl an bleibenden Karten, die keine Länder sind und die du kontrollierst.\', \'type\': \'Kreatur — Kaninchen, Einhorn\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631859&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'38dbddfc-23d5-417f-b52a-bf0507273169\', \'multiverseId\': 631859}, \'multiverseid\': 631859}, {\'name\': \'Lapicorne royal\', \'text\': "La force et l\'endurance du Lapicorne royal sont chacune égales au nombre de permanents non-terrain que vous contrôlez.", \'type\': \'Créature — lapin et licorne\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631906&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f0bb49e1-16d3-4263-9a23-5c40f37ee0b5\', \'multiverseId\': 631906}, \'multiverseid\': 631906}, {\'name\': \'威厳あるバニコーン\', \'text\': \'威厳あるバニコーンのパワーとタフネスは、それぞれあなたがコントロールしていて土地でないパーマネントの数に等しい。\', \'type\': \'クリーチャー — 兎・ユニコーン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631953&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'281571a3-1503-495a-8ea1-87e1cf8ba820\', \'multiverseId\': 631953}, \'multiverseid\': 631953}, {\'name\': \'庄严独角兔\', \'text\': \'庄严独角兔的力量和防御力各等同于由你操控的非地永久物数量。\', \'type\': \'生物 — 兔／独角兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632000&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fdfac992-62c9-481b-85b4-09580632d7ea\', \'multiverseId\': 632000}, \'multiverseid\': 632000}]', "[{'name': 'Laterne des Seelenführers', 'text': 'Wenn die Laterne des Seelenführers ins Spiel kommt, schicke eine Karte deiner Wahl aus einem Friedhof ins Exil.\\n{T}, opfere die Laterne des Seelenführers: Schicke die Friedhöfe aller Gegner ins Exil.\\n{1}, {T}, opfere die Laterne des Seelenführers: Ziehe eine Karte.', 'type': 'Artefakt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630013&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'dbe49576-92fe-4ed6-adff-47edf2545026', 'multiverseId': 630013}, 'multiverseid': 630013}, {'name': 'Farol guía de almas', 'text': 'Cuando el Farol guía de almas entre al campo de batalla, exilia la carta objetivo de un cementerio.\\n{T}, sacrificar el Farol guía de almas: Exilia el cementerio de cada oponente.\\n{1}, {T}, sacrificar el Farol guía de almas: Roba una carta.', 'type': 'Artefacto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630274&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '3706d9f9-686a-4ac0-96b2-0b0100808240', 'multiverseId': 630274}, 'multiverseid': 630274}, {'name': 'Lanterne guide-âmes', 'text': 'Quand la Lanterne guide-âmes arrive sur le champ de bataille, exilez une carte ciblée depuis un cimetière.\\n{T}, sacrifiez la Lanterne guide-âmes : Exilez le cimetière de chaque adversaire.\\n{1}, {T}, sacrifiez la Lanterne guide-âmes : Piochez une carte.', 'type': 'Artefact', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630535&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c8dd6051-af13-4ee3-b02f-e2db2c6f7d62', 'multiverseId': 630535}, 'multiverseid': 630535}, {'name': 'Lanterna Guidaspiriti', 'text': 'Quando la Lanterna Guidaspiriti entra nel campo di battaglia, esilia una carta bersaglio da un cimitero.\\n{T}, Sacrifica la Lanterna Guidaspiriti: Esilia il cimitero di ogni avversario.\\n{1}, {T}, Sacrifica la Lanterna Guidaspiriti: Pesca una carta.', 'type': 'Artefatto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630796&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '677c74d1-b7f3-488a-842a-3ff051517cde', 'multiverseId': 630796}, 'multiverseid': 630796}, {'name': '魂標ランタン', 'text': '魂標ランタンが戦場に出たとき、墓地にあるカード１枚を対象とする。それを追放する。\\n{T}, 魂標ランタンを生け贄に捧げる：すべての対戦相手の墓地を追放する。\\n{1}, {T}, 魂標ランタンを生け贄に捧げる：カード１枚を引く。', 'type': 'アーティファクト', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631057&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'df5a67ae-4652-41fc-96da-aca234069a77', 'multiverseId': 631057}, 'multiverseid': 631057}, {'name': 'Lanterna Guia-almas', 'text': 'Quando Lanterna Guia-almas entrar no campo de batalha, exile o card alvo de um cemitério.\\n{T}, sacrifique Lanterna Guia-almas: Exile o cemitério de cada oponente.\\n{1}, {T}, sacrifique Lanterna Guia-almas: Compre um card.', 'type': 'Artefato', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631318&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd3272f76-bfa8-499c-b019-d5acc417204e', 'multiverseId': 631318}, 'multiverseid': 631318}, {'name': '导灵明灯', 'text': '当导灵明灯进战场时，将目标牌从坟墓场放逐。\\n{T}，牺牲导灵明灯：放逐每位对手的坟墓场。\\n{1}，{T}，牺牲导灵明灯：抓一张牌。', 'type': '神器', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631579&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a58d3eeb-f664-4c50-b63f-3d234cda7a5b', 'multiverseId': 631579}, 'multiverseid': 631579}]", '[{\'name\': \'Lebendes Lesepult\', \'text\': \'{1}, opfere das Lebende Lesepult: Ziehe eine Karte. Erzeuge einen Magier-Rolle-Spielstein, angelegt an bis zu eine andere Kreatur deiner Wahl, die du kontrollierst. Aktiviere diese Fähigkeit wie eine Hexerei. (Falls du bereits eine andere daran angelegte Rolle kontrollierst, lege die alte Rolle auf den Friedhof. Die verzauberte Kreatur erhält +1/+1 und hat „Immer wenn diese Kreatur angreift, wende Hellsicht 1 an.")\', \'type\': \'Artefaktkreatur — Konstrukt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629821&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'240e4cfa-be3e-46f0-aa63-63b547386092\', \'multiverseId\': 629821}, \'multiverseid\': 629821}, {\'name\': \'Atril viviente\', \'text\': \'{1}, sacrificar el Atril viviente: Roba una carta. Crea una ficha de Papel de Mago anexada a hasta una otra criatura objetivo que controlas. Activa esto solo como un conjuro. (Si controlas otro Papel sobre ella, pon ese en el cementerio. La criatura encantada obtiene +1/+1 y tiene "Siempre que esta criatura ataque, adivina 1".)\', \'type\': \'Criatura artefacto — Constructo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630082&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'60ff707f-8109-4743-bd85-957e02016d12\', \'multiverseId\': 630082}, \'multiverseid\': 630082}, {\'name\': \'Lutrin vivant\', \'text\': "{1}, sacrifiez le Lutrin vivant : Piochez une carte. Créez un jeton de rôle Ensorceleur attaché à jusqu\'à une autre créature ciblée que vous contrôlez. N\'activez que lorsque vous pourriez lancer un rituel. (Si vous contrôlez un autre rôle sur elle, mettez-le au cimetière. La créature enchantée gagne +1/+1 et a « À chaque fois que cette créature attaque, regard 1. »)", \'type\': \'Créature-artefact — construction\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630343&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a0f851c1-e473-4665-8279-f989e286ff27\', \'multiverseId\': 630343}, \'multiverseid\': 630343}, {\'name\': \'Leggio Vivente\', \'text\': \'{1}, Sacrifica il Leggio Vivente: Pesca una carta. Crea una pedina Ruolo Stregone assegnata a fino a un\\\'altra creatura bersaglio che controlli. Attiva solo come una stregoneria. (Se controlli un altro Ruolo assegnato a quella creatura, metti quel Ruolo nel cimitero. La creatura incantata prende +1/+1 e ha "Ogniqualvolta questa creatura attacca, profetizza 1".)\', \'type\': \'Creatura Artefatto — Costrutto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630604&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a44e01cb-e394-4f23-af7f-c63f328d47d9\', \'multiverseId\': 630604}, \'multiverseid\': 630604}, {\'name\': \'生ける書見台\', \'text\': \'{1}, 生ける書見台を生け贄に捧げる：カード１枚を引く。あなたがコントロールしていてこれでないクリーチャー最大１体を対象とする。魔術師・役割・トークン１つをそれについた状態で生成する。起動はソーサリーとしてのみ行う。（あなたがコントロールしている役割がすでにそれについていたなら、その役割を墓地に置く。エンチャントしているクリーチャーは＋１/＋１の修整を受け「このクリーチャーが攻撃するたび、占術１を行う。」を持つ。）\', \'type\': \'アーティファクト・クリーチャー — 構築物\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630865&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3a929a4a-c216-4035-be2a-a5ae736396d7\', \'multiverseId\': 630865}, \'multiverseid\': 630865}, {\'name\': \'Púlpito Vivo\', \'text\': \'{1}, sacrifique Púlpito Vivo: Compre um card. Crie uma ficha de Papel de Feiticeiro anexada a até uma outra criatura alvo que você controla. Ative somente como um feitiço. (Se você controlar outro Papel nela, coloque aquele no cemitério. A criatura encantada recebe +1/+1 e tem "Toda vez que esta criatura atacar, use vidência 1".)\', \'type\': \'Criatura Artefato — Constructo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631126&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'44672640-0af4-4244-85e5-ed52c94033e2\', \'multiverseId\': 631126}, \'multiverseid\': 631126}, {\'name\': \'活体讲台\', \'text\': \'{1}，牺牲活体讲台：抓一张牌。派出一个术士角色衍生物，并贴附在至多另一个目标由你操控的生物上。只能于法术时机起动。（如果其上已有另一个你操控的角色，则将已有之角色置入坟墓场。所结附的生物得+1/+1且具有「每当此生物攻击时，占卜1。」）\', \'type\': \'神器生物 — 组构体\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631387&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'104c221b-fbf9-482f-9050-908ef3aa7417\', \'multiverseId\': 631387}, \'multiverseid\': 631387}]', '[{\'name\': \'Lebkuchen-Rohling\', \'text\': \'Eile\\n{1}: Der Lebkuchen-Rohling kann in diesem Zug außer von Kreaturen mit Eile nicht geblockt werden.\\n{2}, {T}, opfere den Lebkuchen-Rohling: Du erhältst 3 Lebenspunkte dazu.\', \'type\': \'Artefaktkreatur — Speise, Golem\', \'flavor\': \'Manchmal ist, „so schnell du kannst", einfach nicht schnell genug.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630008&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'91128bf5-6837-48c8-84bc-727a00fbae87\', \'multiverseId\': 630008}, \'multiverseid\': 630008}, {\'name\': \'Bruto de jengibre\', \'text\': \'Prisa.\\n{1}: El Bruto de jengibre no puede ser bloqueado este turno excepto por criaturas con la habilidad de prisa.\\n{2}, {T}, sacrificar el Bruto de jengibre: Ganas 3 vidas.\', \'type\': \'Criatura artefacto — Gólem comida\', \'flavor\': \'A veces, "lo más rápido que puedas" no es lo suficientemente rápido.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630269&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9fcc586b-e931-46d6-8c4d-bf36c480913f\', \'multiverseId\': 630269}, \'multiverseid\': 630269}, {\'name\': "Brute en pain d\'épices", \'text\': "Célérité\\n{1} : La Brute en pain d\'épices ne peut pas être bloquée ce tour-ci excepté par des créatures avec la célérité.\\n{2}, {T}, sacrifiez la Brute en pain d\'épices : Vous gagnez 3 points de vie.", \'type\': \'Créature-artefact — nourriture et golem\', \'flavor\': "Parfois, « le plus vite possible » n\'est pas assez rapide.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630530&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f1deb932-53dc-44b6-bcca-40a4245b3cf7\', \'multiverseId\': 630530}, \'multiverseid\': 630530}, {\'name\': \'Bruto di Pan di Zenzero\', \'text\': \'Rapidità\\n{1}: Il Bruto di Pan di Zenzero non può essere bloccato in questo turno tranne che da creature con rapidità.\\n{2}, {T}, Sacrifica il Bruto di Pan di Zenzero: Guadagni 3 punti vita.\', \'type\': \'Creatura Artefatto — Golem Cibo\', \'flavor\': \'A volte "più veloce che puoi" non è sufficiente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630791&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'33ff29d8-3329-4f98-9232-2e8f027a57ab\', \'multiverseId\': 630791}, \'multiverseid\': 630791}, {\'name\': \'ジンジャーブルート\', \'text\': \'速攻\\n{1}：このターン、ジンジャーブルートは、速攻を持つクリーチャーにしかブロックされない。\\n{2}, {T}, ジンジャーブルートを生け贄に捧げる：あなたは３点のライフを得る。\', \'type\': \'アーティファクト・クリーチャー — 食物・ゴーレム\', \'flavor\': \'時に、「全速力」が遅すぎることがある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631052&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f7a9213b-96aa-4697-a54f-c715205b09fe\', \'multiverseId\': 631052}, \'multiverseid\': 631052}, {\'name\': \'Gengibruto\', \'text\': \'Ímpeto\\n{1}: Gengibruto não pode ser bloqueado neste turno, exceto por criaturas com ímpeto.\\n{2}, {T}, sacrifique Gengibruto: Você ganha 3 pontos de vida.\', \'type\': \'Criatura Artefato — Comida Golem\', \'flavor\': \'Às vezes "o mais rápido possível" não é rápido o suficiente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631313&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'18c6cdcc-8f1a-4063-8f76-abf554bad40f\', \'multiverseId\': 631313}, \'multiverseid\': 631313}, {\'name\': \'姜饼怪人\', \'text\': \'敏捷\\n{1}：姜饼怪人本回合只能被具敏捷异能的生物阻挡。\\n{2}，{T}，牺牲姜饼怪人：你获得3点生命。\', \'type\': \'神器生物 — 食品／魔像\', \'flavor\': \'有时候，「有多快跑多快」还不够快。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631574&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'74a4aece-3a2a-468e-9438-4566dcabcd4d\', \'multiverseId\': 631574}, \'multiverseid\': 631574}]', '[{\'name\': \'Mal der Hexe\', \'text\': \'Du kannst eine Karte abwerfen. Falls du dies tust, ziehe zwei Karten.\\nErzeuge einen Böse-Rolle-Spielstein, angelegt an bis zu eine Kreatur deiner Wahl, die du kontrollierst. (Falls du bereits eine andere daran angelegte Rolle kontrollierst, lege die alte Rolle auf den Friedhof. Die verzauberte Kreatur erhält +1/+1. Wenn diese Aura auf einen Friedhof gelegt wird, verliert jeder Gegner 1 Lebenspunkt.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629920&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'03ecc171-f7aa-4b6a-bdc2-555e38a9e31e\', \'multiverseId\': 629920}, \'multiverseid\': 629920}, {\'name\': \'Marca de la bruja\', \'text\': \'Puedes descartar una carta. Si lo haces, roba dos cartas.\\nCrea una ficha de Papel de Malvado anexada a hasta una criatura objetivo que controlas. (Si controlas otro Papel sobre ella, pon ese en el cementerio. La criatura encantada obtiene +1/+1. Cuando esta Aura vaya a un cementerio, cada oponente pierde 1 vida.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630181&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dff5b2a1-b335-4f44-be30-4495898561dd\', \'multiverseId\': 630181}, \'multiverseid\': 630181}, {\'name\': "Marque de l\'envoûteuse", \'text\': "Vous pouvez vous défausser d\'une carte. Si vous faites ainsi, piochez deux cartes.\\nCréez un jeton de rôle Maléfique attaché à jusqu\'à une créature ciblée que vous contrôlez. (Si vous contrôlez un autre rôle sur elle, mettez-le au cimetière. La créature enchantée gagne +1/+1. Quand cette aura est mise dans un cimetière, chaque adversaire perd 1 point de vie.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630442&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'05638ce2-6a40-4dc0-b0aa-1ed528057e2d\', \'multiverseId\': 630442}, \'multiverseid\': 630442}, {\'name\': \'Marchio della Strega\', \'text\': "Puoi scartare una carta. Se lo fai, peschi due carte.\\nCrea una pedina Ruolo Perfido assegnata a fino a una creatura bersaglio che controlli. (Se controlli un altro Ruolo assegnato a quella creatura, metti quel Ruolo nel cimitero. La creatura incantata prende +1/+1. Quando quest\'Aura viene messa in un cimitero, ogni avversario perde 1 punto vita.)", \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630703&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6add79ee-2ca2-46ce-95ca-bc504ed39b73\', \'multiverseId\': 630703}, \'multiverseid\': 630703}, {\'name\': \'魔女の印\', \'text\': \'あなたがコントロールしているクリーチャー最大１体を対象とする。カード１枚を捨ててもよい。そうしたなら、カード２枚を引く。\\nひねくれ者・役割・トークン１つをそれについた状態で生成する。（あなたがコントロールしている役割がすでにそれについていたなら、その役割を墓地に置く。エンチャントしているクリーチャーは＋１/＋１の修整を受ける。このオーラが墓地に置かれたとき、各対戦相手はそれぞれ１点のライフを失う。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630964&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d21d4181-a993-45fc-92b4-d0ce1c42eb0c\', \'multiverseId\': 630964}, \'multiverseid\': 630964}, {\'name\': \'Marca da Bruxa\', \'text\': \'Você pode descartar um card. Se fizer isso, compre dois cards.\\nCrie uma ficha de Papel de Malvado anexada a até uma criatura alvo que você controla. (Se você controlar outro Papel nela, coloque aquele no cemitério. A criatura encantada recebe +1/+1. Quando esta Aura é colocada em um cemitério, cada oponente perde 1 ponto de vida.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631225&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5cba31bf-e3d8-4e04-954b-2019cf806d1a\', \'multiverseId\': 631225}, \'multiverseid\': 631225}, {\'name\': \'巫婆赋印\', \'text\': \'你可以弃一张牌。若你如此作，则抓两张牌。\\n派出一个恶人角色衍生物，并贴附在至多一个目标由你操控的生物上。（如果其上已有另一个你操控的角色，则将已有之角色置入坟墓场。所结附的生物得+1/+1。当此灵气进入坟墓场时，每位对手各失去1点生命。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631486&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3c792d04-f3f1-4b7a-a4a9-97244ce6e079\', \'multiverseId\': 631486}, \'multiverseid\': 631486}]', '[{\'name\': \'Maßgeschneiderter Kampfharnisch\', \'text\': \'Die ausgerüstete Kreatur erhält +2/+0.\\nFeier — Zu Beginn des Kampfes in deinem Zug und falls zwei oder mehr bleibende Karten, die keine Länder sind, in diesem Zug unter deiner Kontrolle ins Spiel gekommen sind, lege den Maßgeschneiderten Kampfharnisch an bis zu eine Kreatur deiner Wahl an, die du kontrollierst.\\nAusrüsten {2} ({2}: Lege diese Karte an eine Kreatur deiner Wahl an, die du kontrollierst. Spiele Ausrüsten wie eine Hexerei.)\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629884&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'54a9b016-acca-4d5d-9cb5-615b2496ab4b\', \'multiverseId\': 629884}, \'multiverseid\': 629884}, {\'name\': \'Atuendo de batalla a medida\', \'text\': \'La criatura equipada obtiene +2/+0.\\nCelebración — Al comienzo del combate en tu turno, si dos o más permanentes que no sean tierra entraron al campo de batalla bajo tu control este turno, anexa el Atuendo de batalla a medida a hasta una criatura objetivo que controlas.\\nEquipar {2}. ({2}: Anexa este Equipo a la criatura objetivo que controlas. Activa la habilidad de equipar como un conjuro.)\', \'type\': \'Artefacto — Equipo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630145&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0e045f14-bc57-4c11-bed9-3caa4417cf6d\', \'multiverseId\': 630145}, \'multiverseid\': 630145}, {\'name\': \'Habit de combat sur mesure\', \'text\': "La créature équipée gagne +2/+0.\\nCélébration — Au début du combat pendant votre tour, si au moins deux permanents non-terrain sont arrivés sur le champ de bataille sous votre contrôle ce tour-ci, attachez l\'Habit de combat sur mesure à jusqu\'à une créature ciblée que vous contrôlez.\\nÉquipement {2} ({2} : Attachez à une créature ciblée que vous contrôlez. N\'attachez l\'équipement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Artefact — équipement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630406&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'13fcbfd9-b497-460f-b330-5ea31f674379\', \'multiverseId\': 630406}, \'multiverseid\': 630406}, {\'name\': \'Vesti da Battaglia su Misura\', \'text\': "La creatura equipaggiata prende +2/+0.\\nCelebrazione — All\'inizio del combattimento nel tuo turno, se due o più permanenti non terra sono entrati nel campo di battaglia sotto il tuo controllo in questo turno, assegna le Vesti da Battaglia su Misura a fino a una creatura bersaglio che controlli.\\nEquipaggiare {2} ({2}: Assegna a una creatura bersaglio che controlli. Equipaggia solo come una stregoneria.)", \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630667&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'86c70f4a-3ad2-43fa-9484-af9cf92b1024\', \'multiverseId\': 630667}, \'multiverseid\': 630667}, {\'name\': \'特注の戦闘装束\', \'text\': \'装備しているクリーチャーは＋２/＋０の修整を受ける。\\n祝祭 — あなたのターンの戦闘の開始時に、このターンに土地でない２つ以上のパーマネントがあなたのコントロール下で戦場に出たことがある場合、あなたがコントロールしているクリーチャー最大１体を対象とする。特注の戦闘装束をそれにつける。\\n装備{2}（{2}：あなたがコントロールしているクリーチャー１体を対象とする。これをそれにつける。装備はソーサリーとしてのみ行う。）\', \'type\': \'アーティファクト — 装備品\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630928&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6496910b-7397-47ec-b877-517cf3566ae1\', \'multiverseId\': 630928}, \'multiverseid\': 630928}, {\'name\': \'Vestes de Batalha Sob Medida\', \'text\': \'A criatura equipada recebe +2/+0.\\nCelebração — No início do combate no seu turno, se duas ou mais permanentes não de terreno tiverem entrado no campo de batalha sob seu controle neste turno, anexe Vestes de Batalha Sob Medida a até uma criatura que você controla.\\nEquipar {2} ({2}: Anexe este equipamento à criatura alvo que você controla. Equipe somente como um feitiço.)\', \'type\': \'Artefato — Equipamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631189&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'74b0ff4c-c7cd-4f0b-8a31-0ff3dc215529\', \'multiverseId\': 631189}, \'multiverseid\': 631189}, {\'name\': \'订制战甲\', \'text\': \'佩带此武具的生物得+2/+0。\\n欢庆～在你回合的战斗开始时，若本回合中有两个或更多非地永久物在你的操控下进战场，则将订制战甲贴附在至多一个目标由你操控的生物上。\\n佩带{2}（{2}：贴附在目标由你操控的生物上。只能于法术时机佩带。）\', \'type\': \'神器 — 武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631450&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d1cb1f92-8eb4-44fd-8eb1-b0bb88b6f18c\', \'multiverseId\': 631450}, \'multiverseid\': 631450}]', '[{\'name\': \'Meervolk-Korallenschmiedin\', \'text\': \'{1}: Die Meervolk-Korallenschmiedin erhält +1/-1 bis zum Ende des Zuges.\\nWenn die Meervolk-Korallenschmiedin stirbt, wende Hellsicht 2 an.\', \'type\': \'Kreatur — Meervolk\', \'flavor\': \'„Schwerter aus Holz verfaulen. Äxte aus Stahl verrosten. Korallen hingegen wachsen nur noch weiter."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629822&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1c2b44ee-3213-477a-992c-1836a6a14edb\', \'multiverseId\': 629822}, \'multiverseid\': 629822}, {\'name\': \'Forjacorales tritón\', \'text\': \'{1}: La Forjacorales tritón obtiene +1/-1 hasta el final del turno.\\nCuando la Forjacorales tritón muera, adivina 2.\', \'type\': \'Criatura — Tritón\', \'flavor\': \'"Las espadas de madera se pudren. Las hachas de acero se oxidan. Pero el coral nunca deja de crecer".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630083&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'99dc674a-8b7a-4cd5-b89f-5e25292a4d89\', \'multiverseId\': 630083}, \'multiverseid\': 630083}, {\'name\': \'Forge-corail ondine\', \'text\': "{1} : La Forge-corail ondine gagne +1/-1 jusqu\'à la fin du tour.\\nQuand la Forge-corail ondine meurt, regard 2.", \'type\': \'Créature — ondin\', \'flavor\': "« Les épées de bois pourrissent. Les haches d\'acier rouillent. Mais le corail continue de pousser. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630344&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d57af91f-d080-47ea-b26f-8aa5975b62e6\', \'multiverseId\': 630344}, \'multiverseid\': 630344}, {\'name\': \'Tritona Plasmacorallo\', \'text\': \'{1}: La Tritona Plasmacorallo prende +1/-1 fino alla fine del turno.\\nQuando la Tritona Plasmacorallo muore, profetizza 2.\', \'type\': \'Creatura — Tritone\', \'flavor\': \'"Le spade di legno marciscono. Le asce di ferro arrugginiscono. Il corallo invece cresce."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630605&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cf58b44c-40a0-4078-aa2c-ac428e2be758\', \'multiverseId\': 630605}, \'multiverseid\': 630605}, {\'name\': \'マーフォークの珊瑚鍛冶\', \'text\': \'{1}：ターン終了時まで、マーフォークの珊瑚鍛冶は＋１/－１の修整を受ける。\\nマーフォークの珊瑚鍛冶が死亡したとき、占術２を行う。\', \'type\': \'クリーチャー — マーフォーク\', \'flavor\': \'「木の剣は朽ちる。鉄の斧は錆びる。でも、珊瑚は成長し続けるの。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630866&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'64b207e7-eacd-4d76-b873-e10ff5e56da9\', \'multiverseId\': 630866}, \'multiverseid\': 630866}, {\'name\': \'Coralista Tritã\', \'text\': \'{1}: Coralista Tritã recebe +1/-1 até o final do turno.\\nQuando Coralista Tritã morrer, use vidência 2.\', \'type\': \'Criatura — Tritão\', \'flavor\': \'"Espadas de madeira apodrecem. Machados de aço enferrujam. Mas o coral só cresce."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631127&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'75afcda0-c202-4d78-a4c9-646820c0336c\', \'multiverseId\': 631127}, \'multiverseid\': 631127}, {\'name\': \'人鱼珊瑚匠\', \'text\': \'{1}：人鱼珊瑚匠得+1/-1直到回合结束。\\n当人鱼珊瑚匠死去时，占卜2。\', \'type\': \'生物 — 人鱼\', \'flavor\': \'「木剑会朽。铁斧会锈。但珊瑚只会不断生长。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631388&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'99203326-f46e-471d-bdaf-8798373cf0b1\', \'multiverseId\': 631388}, \'multiverseid\': 631388}]', "[{'name': 'Minecart Daredevil // Wilde Fahrt', 'type': 'Kreatur — Zwerg, Ritter', 'flavor': 'In den Minen, durch die einst die Schläge der Spitzhacken schallten, hallen nun nur noch Juchzer unbesonnenen Nervenkitzels wider.', 'faceName': 'Minecart Daredevil', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629903&type=card', 'language': 'German', 'identifiers': {'scryfallId': '781330e5-44d8-440b-ba85-8844d1fd3670', 'multiverseId': 629903}, 'multiverseid': 629903}, {'name': 'Minecart Daredevil // Ir por los rieles', 'type': 'Criatura — Caballero enano', 'flavor': 'En las minas en las que antaño resonaban los golpes de los picos ahora se oyen ecos de gritos de júbilo insensato.', 'faceName': 'Minecart Daredevil', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630164&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e5d999be-965a-41bb-9763-9a4ddb3d3dee', 'multiverseId': 630164}, 'multiverseid': 630164}, {'name': 'Minecart Daredevil // Suivre les rails', 'type': 'Créature — nain et chevalier', 'flavor': 'Dans les mines où autrefois résonnaient les coups de pioche retentissaient à présent des cris de joie insouciante.', 'faceName': 'Minecart Daredevil', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630425&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'de34af12-ddd2-4e0c-b60a-6d5b14307b3e', 'multiverseId': 630425}, 'multiverseid': 630425}, {'name': 'Minecart Daredevil // Seguire le Rotaie', 'type': 'Creatura — Cavaliere Nano', 'flavor': 'Nelle miniere, in cui un tempo rimbombavano i colpi dei picconi, ora riecheggiano urla di gioia sconsiderata.', 'faceName': 'Minecart Daredevil', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630686&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '90b76086-c94e-4f0d-b03f-1abc0daffd11', 'multiverseId': 630686}, 'multiverseid': 630686}, {'name': 'Minecart Daredevil // 軌（き）条（じょう）を乗（の）りこなせ', 'type': 'クリーチャー — ドワーフ・騎士', 'flavor': 'かつてツルハシの叩く音が鳴り響いていた鉱山は、今では粗暴な笑い声がこだましていた。', 'faceName': 'Minecart Daredevil', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630947&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '22599904-1360-4929-88e2-45f2613ea4c5', 'multiverseId': 630947}, 'multiverseid': 630947}, {'name': 'Minecart Daredevil // Passeio nos Trilhos', 'type': 'Criatura — Anão Cavaleiro', 'flavor': 'Nas minas onde outrora soavam os golpes de picaretas, agora ecoam os brados de uma alegria incauta.', 'faceName': 'Minecart Daredevil', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631208&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '842fe0ae-d625-43d3-83bc-c80ad6428e87', 'multiverseId': 631208}, 'multiverseid': 631208}, {'name': 'Minecart Daredevil // 沿轨前行', 'type': '生物 — 矮人／骑士', 'flavor': '此处矿坑曾经铁镐叮当作响，如今空余冒险欢笑回荡。', 'faceName': 'Minecart Daredevil', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631469&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '67cee2e7-04df-422b-87d7-d906a25ff4ee', 'multiverseId': 631469}, 'multiverseid': 631469}]", '[{\'name\': \'Minztrosität\', \'text\': \'Wenn die Minztrosität stirbt, erzeuge einen Speise-Spielstein. (Er ist ein Artefakt mit „{2}, {T}, opfere dieses Artefakt: Du erhältst 3 Lebenspunkte dazu.")\', \'type\': \'Kreatur — Schrecken\', \'flavor\': \'Wenn die zuckrigen Scheußlichkeiten des Dorfes Süßholzen jemals jemandem gehorcht hatten, so waren diese Tage schon lange vorbei.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629862&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c4d73a0b-0d2f-449d-a23b-c959d486e062\', \'multiverseId\': 629862}, \'multiverseid\': 629862}, {\'name\': \'Bastimenta\', \'text\': \'Cuando la Bastimenta muera, crea una ficha de Comida. (Es un artefacto con "{2}, {T}, sacrificar este artefacto: Ganas 3 vidas".)\', \'type\': \'Criatura — Horror\', \'flavor\': \'Ya nadie recuerda si tiempo ha alguien controlaba las abominaciones azucaradas de Villadulces.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630123&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a918dd53-9845-4724-b54b-2f93783a8247\', \'multiverseId\': 630123}, \'multiverseid\': 630123}, {\'name\': \'Menthrosité\', \'text\': "Quand la Menthrosité meurt, créez un jeton Nourriture. (C\'est un artefact avec « {2}, {T}, sacrifiez cet artefact : Vous gagnez 3 points de vie. »)", \'type\': \'Créature — horreur\', \'flavor\': "Si les abominations sucrées du village de Dentcariée avaient été un jour sous le contrôle de quelqu\'un, ce n\'était vraiment plus le cas.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630384&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'767b8e0d-dc7f-4118-b74b-05cee2535560\', \'multiverseId\': 630384}, \'multiverseid\': 630384}, {\'name\': \'Bandito Candito\', \'text\': \'Quando il Bandito Candito muore, crea una pedina Cibo. (È un artefatto con "{2}, {T}, Sacrifica questo artefatto: Guadagni 3 punti vita".)\', \'type\': \'Creatura — Orrore\', \'flavor\': "Se c\'è mai stato un tempo in cui gli abomini del villaggio di Saccarosia erano sotto il controllo di qualcuno, quel tempo è ormai lontano.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630645&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4c9c90e4-4d3c-414e-9440-6edc23c6975e\', \'multiverseId\': 630645}, \'multiverseid\': 630645}, {\'name\': \'不気ミント\', \'text\': \'不気ミントが死亡したとき、食物・トークン１つを生成する。（それは、「{2}, {T}, このアーティファクトを生け贄に捧げる：あなたは３点のライフを得る。」を持つアーティファクトである。）\', \'type\': \'クリーチャー — ホラー\', \'flavor\': \'甘歯村の甘い化け物が何者かに仕えていたとしたら、それは遠い昔の話だろう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630906&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d7028787-64f7-4786-bb5b-898fafa529de\', \'multiverseId\': 630906}, \'multiverseid\': 630906}, {\'name\': \'Monstrulito\', \'text\': \'Quando Monstrulito morrer, crie uma ficha de Comida. (Ela é um artefato com "{2}, {T}, sacrifique este artefato: Você ganha 3 pontos de vida".)\', \'type\': \'Criatura — Horror\', \'flavor\': \'Se as abominações açucaradas da Docelândia já estiveram sob o controle de alguém, isso já foi há muito tempo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631167&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b5f1e774-2192-4ab1-a6e1-1e98657d73e8\', \'multiverseId\': 631167}, \'multiverseid\': 631167}, {\'name\': \'薄荷糖怪\', \'text\': \'当薄荷糖怪死去时，派出一个食品衍生物。（它是具有「{2}，{T}，牺牲此神器：你获得3点生命」的神器。）\', \'type\': \'生物 — 惊惧兽\', \'flavor\': \'就算甘饴村的糖怪以前曾是谁的手下，那时光也早已一去不复返。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631428&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cea432be-12b0-4d4c-9a31-c927304ccb74\', \'multiverseId\': 631428}, \'multiverseid\': 631428}]', '[{\'name\': \'Moment der Tapferkeit\', \'text\': \'Bestimme eines —\\n• Enttappe eine Kreatur deiner Wahl. Sie erhält +1/+0 und Unzerstörbarkeit bis zum Ende des Zuges.\\n• Zerstöre eine Kreatur deiner Wahl mit Stärke 4 oder mehr.\', \'type\': \'Spontanzauber\', \'flavor\': \'Durch die phyrexianische Invasion gehärtet, beraubten Wills Ritter die Nachtmahre dessen, was sie am meisten begehrten: Furcht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629782&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5c335b48-15fe-4e74-a464-33f87643e730\', \'multiverseId\': 629782}, \'multiverseid\': 629782}, {\'name\': \'Momento de valor\', \'text\': \'Elige uno:\\n• Endereza la criatura objetivo. Obtiene +1/+0 y gana la habilidad de indestructible hasta el final del turno.\\n• Destruye la criatura objetivo con fuerza de 4 o más.\', \'type\': \'Instantáneo\', \'flavor\': \'Curtidos por la invasión pirexiana, los caballeros de Will privaron a las pesadillas de lo que más ansiaban: el miedo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630043&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f01b9b82-5fa8-4bf2-9587-994d13f155b5\', \'multiverseId\': 630043}, \'multiverseid\': 630043}, {\'name\': \'Instant de courage\', \'text\': "Choisissez l\'un —\\n• Dégagez une créature ciblée. Elle gagne +1/+0 et acquiert l\'indestructible jusqu\'à la fin du tour.\\n• Détruisez une créature ciblée de force supérieure ou égale à 4.", \'type\': \'Éphémère\', \'flavor\': "Endurcis par l\'invasion phyrexiane, les chevaliers de Will privèrent les cauchemars de ce qu\'ils désiraient le plus : la peur.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630304&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3c0fccd6-4b2b-474e-8d2f-2f93ba4fcad5\', \'multiverseId\': 630304}, \'multiverseid\': 630304}, {\'name\': \'Momento Valoroso\', \'text\': \'Scegli uno —\\n• STAPpa una creatura bersaglio. Prende +1/+0 e ha indistruttibile fino alla fine del turno.\\n• Distruggi una creatura bersaglio con forza pari o superiore a 4.\', \'type\': \'Istantaneo\', \'flavor\': "Temprati dall\'invasione di Phyrexia, i cavalieri di Will privavano gli incubi di ciò che bramavano più di ogni cosa: la paura.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630565&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9163d5ec-9a89-4ac0-8b48-27b28c1c04ea\', \'multiverseId\': 630565}, \'multiverseid\': 630565}, {\'name\': \'武勇の時\', \'text\': \'以下から１つを選ぶ。\\n・クリーチャー１体を対象とする。それをアンタップする。ターン終了時まで、それは＋１/＋０の修整を受け破壊不能を得る。\\n・パワーが４以上であるクリーチャー１体を対象とする。それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'ファイレクシアの侵攻によって鍛えられたウィルの騎士は、夢魔が渇望する唯一のものを与えなかった――それは恐怖である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630826&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1d645d4e-3b8d-4bfb-9fd8-5181109b9a77\', \'multiverseId\': 630826}, \'multiverseid\': 630826}, {\'name\': \'Momento de Bravura\', \'text\': \'Escolha um —\\n• Desvire a criatura alvo. Ela recebe +1/+0 e ganha indestrutível até o final do turno.\\n• Destrua a criatura alvo com poder igual ou superior a 4.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Calejados da invasão phyrexiana, os cavaleiros de Will privavam os pesadelos do que eles mais cobiçavam: o medo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631087&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'12d0f6e0-4e9f-4d69-a2bd-2f7e172472fa\', \'multiverseId\': 631087}, \'multiverseid\': 631087}, {\'name\': \'勇气时刻\', \'text\': \'选择一项～\\n•重置目标生物。直到回合结束，它得+1/+0且获得不灭异能。\\n•消灭目标力量等于或大于4的生物。\', \'type\': \'瞬间\', \'flavor\': \'经历非瑞克西亚大侵攻之后，威尔手下的骑士就没让梦魇从他们身上汲取到任何渴求之物：恐惧。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631348&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'17dc09c8-5bed-43f3-bdda-1544c5f121ab\', \'multiverseId\': 631348}, \'multiverseid\': 631348}]', '[{\'name\': \'Monddonner-Kavallerie\', \'text\': \'Fliegend\\nWenn die Monddonner-Kavallerie ins Spiel kommt, erhalten Kreaturen, die du kontrollierst, bis zum Ende des Zuges Flugfähigkeit und +X/+X, wobei X gleich der Anzahl an Kreaturen ist, die du kontrollierst.\', \'type\': \'Kreatur — Geist, Ritter\', \'flavor\': \'Die Armeen des Hochkönigs Kenrith folgten ihm ins Jenseits und waren stets bereit, auf seinen Befehl hin loszustürmen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629783&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'89b547f6-c32c-4140-9e95-7a5f6837dfa7\', \'multiverseId\': 629783}, \'multiverseid\': 629783}, {\'name\': \'Caballería sacudelunas\', \'text\': \'Vuela.\\nCuando la Caballería sacudelunas entre al campo de batalla, las criaturas que controlas ganan la habilidad de volar y obtienen +X/+X hasta el final del turno, donde X es la cantidad de criaturas que controlas.\', \'type\': \'Criatura — Caballero espíritu\', \'flavor\': \'Los ejércitos del rey de reyes Kenrith lo siguieron ultratumba, dispuestos a cargar cuando se lo ordenase.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630044&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1d57d8c9-49c0-4c27-a466-d8a82d7b477c\', \'multiverseId\': 630044}, \'multiverseid\': 630044}, {\'name\': \'Cavalerie tremblelune\', \'text\': "Vol\\nQuand la Cavalerie tremblelune arrive sur le champ de bataille, les créatures que vous contrôlez acquièrent le vol et gagnent +X/+X jusqu\'à la fin du tour, X étant le nombre de créatures que vous contrôlez.", \'type\': \'Créature — esprit et chevalier\', \'flavor\': "Les armées du Haut Roi Kenrith le suivirent dans l\'au-delà, prêtes à attaquer à son ordre.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630305&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'89de1bc3-a800-4fc8-8861-9ece89907c32\', \'multiverseId\': 630305}, \'multiverseid\': 630305}, {\'name\': \'Cavalleria Turbaluna\', \'text\': \'Volare\\nQuando la Cavalleria Turbaluna entra nel campo di battaglia, le creature che controlli hanno volare e prendono +X/+X fino alla fine del turno, dove X è il numero di creature che controlli.\', \'type\': \'Creatura — Cavaliere Spirito\', \'flavor\': "Le schiere del Sommo Re Kenrith lo avevano seguito nell\'aldilà, pronte alla carica al suo comando.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630566&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'252344f4-d0ef-4f07-a8da-e200d307de8d\', \'multiverseId\': 630566}, \'multiverseid\': 630566}, {\'name\': \'月揺らしの騎兵隊\', \'text\': \'飛行\\n月揺らしの騎兵隊が戦場に出たとき、ターン終了時まで、あなたがコントロールしているすべてのクリーチャーは飛行を得、＋Ｘ/＋Ｘの修整を受ける。Ｘはあなたがコントロールしているクリーチャーの数に等しい。\', \'type\': \'クリーチャー — スピリット・騎士\', \'flavor\': \'覇王ケンリスの軍勢は死後も彼に仕え、彼の命令で突撃する覚悟を持っていた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630827&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b138b5dd-436e-454c-a07f-9da425b9ae1a\', \'multiverseId\': 630827}, \'multiverseid\': 630827}, {\'name\': \'Cavalaria Sacode-lua\', \'text\': \'Voar\\nQuando Cavalaria Sacode-lua entra no campo de batalha, as criaturas que você controla ganham voar e recebem +X/+X até o final do turno, sendo X o número de criaturas que você controla.\', \'type\': \'Criatura — Espírito Cavaleiro\', \'flavor\': \'Os exércitos do Alto Rei Kenrith o seguiram no pós-vida, prontos para atacar ao seu comando.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631088&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'54585945-fc6f-4c53-94f2-0660f7729728\', \'multiverseId\': 631088}, \'multiverseid\': 631088}, {\'name\': \'撼月骑兵\', \'text\': \'飞行\\n当撼月骑兵进战场时，直到回合结束，由你操控的生物获得飞行异能且得+X/+X，X为由你操控的生物数量。\', \'type\': \'生物 — 精怪／骑士\', \'flavor\': \'至高王肯理斯麾下部队追随他进入来生，随时准备听命冲锋。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631349&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3d78ed63-e56a-45b3-a172-009dc038db9e\', \'multiverseId\': 631349}, \'multiverseid\': 631349}]', '[{\'name\': \'Monddonner-Kavallerie\', \'text\': \'Fliegend\\nWenn die Monddonner-Kavallerie ins Spiel kommt, erhalten Kreaturen, die du kontrollierst, bis zum Ende des Zuges Flugfähigkeit und +X/+X, wobei X gleich der Anzahl an Kreaturen ist, die du kontrollierst.\', \'type\': \'Kreatur — Geist, Ritter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631858&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'80756f6f-d67f-4720-b3f3-2b8efb9c0aa9\', \'multiverseId\': 631858}, \'multiverseid\': 631858}, {\'name\': \'Cavalerie tremblelune\', \'text\': "Vol\\nQuand la Cavalerie tremblelune arrive sur le champ de bataille, les créatures que vous contrôlez acquièrent le vol et gagnent +X/+X jusqu\'à la fin du tour, X étant le nombre de créatures que vous contrôlez.", \'type\': \'Créature — esprit et chevalier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631905&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e8e4c831-c145-41e9-bebf-ae03e89d90d9\', \'multiverseId\': 631905}, \'multiverseid\': 631905}, {\'name\': \'月揺らしの騎兵隊\', \'text\': \'飛行\\n月揺らしの騎兵隊が戦場に出たとき、ターン終了時まで、あなたがコントロールしているすべてのクリーチャーは飛行を得、＋Ｘ/＋Ｘの修整を受ける。Ｘはあなたがコントロールしているクリーチャーの数に等しい。\', \'type\': \'クリーチャー — スピリット・騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631952&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cc73e699-2d03-401f-a599-4c64db7c7320\', \'multiverseId\': 631952}, \'multiverseid\': 631952}, {\'name\': \'撼月骑兵\', \'text\': \'飞行\\n当撼月骑兵进战场时，直到回合结束，由你操控的生物获得飞行异能且得+X/+X，X为由你操控的生物数量。\', \'type\': \'生物 — 精怪／骑士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631999&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dd97af2f-a415-405b-ab99-41897740b64b\', \'multiverseId\': 631999}, \'multiverseid\': 631999}]', '[{\'name\': \'Monströser Zorn\', \'text\': \'Eine Kreatur deiner Wahl erhält +2/+0 bis zum Ende des Zuges. Erzeuge einen an sie angelegten Monster-Rolle-Spielstein. (Falls du bereits eine andere daran angelegte Rolle kontrollierst, lege die alte Rolle auf den Friedhof. Die verzauberte Kreatur erhält +1/+1 und verursacht Trampelschaden.)\', \'type\': \'Spontanzauber\', \'flavor\': \'„Was hast du für große Prank—"\\n—Thomas der Holzfäller, letzte Worte\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629904&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f0b18585-3f21-41c6-9b6f-2510383ee9a7\', \'multiverseId\': 629904}, \'multiverseid\': 629904}, {\'name\': \'Furia monstruosa\', \'text\': \'La criatura objetivo obtiene +2/+0 hasta el final del turno. Crea una ficha de Papel de Monstruo anexada a ella. (Si controlas otro Papel sobre ella, pon ese en el cementerio. La criatura encantada obtiene +1/+1 y tiene la habilidad de arrollar.)\', \'type\': \'Instantáneo\', \'flavor\': \'"Anda, qué zarpas más grandes tie...".\\n—Últimas palabras de Thomas, el leñador\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630165&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7dbcd93a-797c-49da-9eea-3546ad5f3eaf\', \'multiverseId\': 630165}, \'multiverseid\': 630165}, {\'name\': \'Rage monstrueuse\', \'text\': "Une créature ciblée gagne +2/+0 jusqu\'à la fin du tour. Créez un jeton de rôle Monstre qui lui est attaché. (Si vous contrôlez un autre rôle sur elle, mettez-le au cimetière. La créature enchantée gagne +1/+1 et a le piétinement.)", \'type\': \'Éphémère\', \'flavor\': \'« Comme vous avez de grandes pattes— »\\n—Thomas le bucheron, derniers mots\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630426&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6c43e4b5-bca8-4858-949d-a035e128f9cf\', \'multiverseId\': 630426}, \'multiverseid\': 630426}, {\'name\': \'Furia Mostruosa\', \'text\': \'Una creatura bersaglio prende +2/+0 fino alla fine del turno. Crea una pedina Ruolo Mostro assegnata ad essa. (Se controlli un altro Ruolo assegnato a quella creatura, metti quel Ruolo nel cimitero. La creatura incantata prende +1/+1 e ha travolgere.)\', \'type\': \'Istantaneo\', \'flavor\': \'"Che zampe grandi..."\\n—Ultime parole di Thomas il taglialegna\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630687&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d2ba521c-005d-4bd9-b00e-b068a9b5f26d\', \'multiverseId\': 630687}, \'multiverseid\': 630687}, {\'name\': \'巨怪の怒り\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋２/＋０の修整を受ける。怪物・役割・トークン１つをそれについた状態で生成する。（あなたがコントロールしている役割がすでにそれについていたなら、その役割を墓地に置く。エンチャントしているクリーチャーは＋１/＋１の修整を受けトランプルを持つ。）\', \'type\': \'インスタント\', \'flavor\': \'「ちくしょう、こんなに掌がデカいなんて聞いてな……」\\n――木こりのトーマスの最後の言葉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630948&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f464d9b2-2c36-48f6-bb32-1b86c699c377\', \'multiverseId\': 630948}, \'multiverseid\': 630948}, {\'name\': \'Raiva Monstruosa\', \'text\': \'A criatura alvo recebe +2/+0 até o final do turno. Crie uma ficha de Papel de Monstro anexada a ela. (Se você controlar outro Papel nela, coloque aquele no cemitério. A criatura encantada recebe +1/+1 e tem atropelar.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Puuuxa! Que patas grandes v—"\\n— últimas palavras de Thomas, o mateiro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631209&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'78a4602a-a72c-4ec6-9811-f8dc5fe58593\', \'multiverseId\': 631209}, \'multiverseid\': 631209}, {\'name\': \'怪物狂怒\', \'text\': \'目标生物得+2/+0直到回合结束。派出一个怪物角色衍生物并贴附于其上。（如果其上已有另一个你操控的角色，则将已有之角色置入坟墓场。所结附的生物得+1/+1且具有践踏异能。）\', \'type\': \'瞬间\', \'flavor\': \'「天呐，爪子可真～」\\n～伐木工托马斯的遗言\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631470&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ecdf4efe-2826-41b4-9d47-2bd1a2c6ba6c\', \'multiverseId\': 631470}, \'multiverseid\': 631470}]', '[{\'name\': \'Moorkremsch\', \'text\': \'Fliegend\\nDie Moorkremsch hat Lebensverknüpfung, solange du ein anderes Feenwesen kontrollierst.\\n{2}{B}: Die Moorkremsch erhält +1/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Feenwesen\', \'flavor\': \'„Der Unterschied zwischen Unfug und Boshaftigkeit? Das Ausmaß."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629843&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dcee7e2a-7d7e-4e1a-b8fc-d876a1c66153\', \'multiverseId\': 629843}, \'multiverseid\': 629843}, {\'name\': \'Revoltosa tumularia\', \'text\': \'Vuela.\\nLa Revoltosa tumularia tiene la habilidad de vínculo vital mientras controles otra Hada.\\n{2}{B}: La Revoltosa tumularia obtiene +1/+0 hasta el final del turno.\', \'type\': \'Criatura — Hada\', \'flavor\': \'"¿La diferencia entre las travesuras y la malicia? Las cifras".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630104&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5ce2e7ec-9185-4edf-91ca-e66ce79372cc\', \'multiverseId\': 630104}, \'multiverseid\': 630104}, {\'name\': \'Vilaine des tumulus\', \'text\': "Vol\\nLa Vilaine des tumulus a le lien de vie tant que vous contrôlez un autre peuple fée.\\n{2}{B} : La Vilaine des tumulus gagne +1/+0 jusqu\'à la fin du tour.", \'type\': \'Créature — peuple fée\', \'flavor\': "« La différence entre l\'espièglerie et la malice ? Le nombre. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630365&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d0f33c89-5d50-45b6-a652-d2fb1c1705bb\', \'multiverseId\': 630365}, \'multiverseid\': 630365}, {\'name\': \'Impertinente dei Tumuli\', \'text\': "Volare\\nL\'Impertinente dei Tumuli ha legame vitale fintanto che controlli un altro Spiritello.\\n{2}{B}: L\'Impertinente dei Tumuli prende +1/+0 fino alla fine del turno.", \'type\': \'Creatura — Spiritello\', \'flavor\': \'"La differenza tra malizia e malvagità? I numeri."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630626&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c989d8c9-b793-4149-82f3-735de41997e9\', \'multiverseId\': 630626}, \'multiverseid\': 630626}, {\'name\': \'墳丘のいたずら好き\', \'text\': \'飛行\\nあなたがこれでないフェアリーをコントロールしているかぎり、墳丘のいたずら好きは絆魂を持つ。\\n{2}{B}：ターン終了時まで、墳丘のいたずら好きは＋１/＋０の修整を受ける。\', \'type\': \'クリーチャー — フェアリー\', \'flavor\': \'「悪戯と悪意の違いは何かって？量だよ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630887&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b146e94b-a24a-46ad-8423-e7eb5e892089\', \'multiverseId\': 630887}, \'multiverseid\': 630887}, {\'name\': \'Traquinas dos Túmulos\', \'text\': \'Voar\\nTraquinas dos Túmulos terá vínculo com a vida enquanto você controlar outra Fada.\\n{2}{B}: Traquinas dos Túmulos recebe +1/+0 até o final do turno.\', \'type\': \'Criatura — Fada\', \'flavor\': \'"A diferença entre travessura e maldade? A quantidade."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631148&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9c72e0d5-404e-4061-9154-4f0910fe3698\', \'multiverseId\': 631148}, \'multiverseid\': 631148}, {\'name\': \'土冢淘气灵\', \'text\': \'飞行\\n只要你操控另一个仙灵，土冢淘气灵便具有系命异能。\\n{2}{B}：土冢淘气灵得+1/+0直到回合结束。\', \'type\': \'生物 — 仙灵\', \'flavor\': \'「你要问作弄与作恶差在哪？程度。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631409&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c2419bfd-8158-40b2-b405-57d24f9de3a2\', \'multiverseId\': 631409}, \'multiverseid\': 631409}]', '[{\'name\': \'Mosswood Dreadknight // Schreckensgeflüster\', \'text\': \'Verursacht Trampelschaden\\nWenn der Moosforst-Schreckensritter stirbt, kannst du ihn bis zum Ende deines nächsten Zuges als Abenteuer aus deinem Friedhof wirken.\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': None, \'faceName\': \'Mosswood Dreadknight\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629993&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'18d10c05-e419-4d44-a41f-ab42f4950a61\', \'multiverseId\': 629993}, \'multiverseid\': 629993}, {\'name\': \'Mosswood Dreadknight // Susurros del pavor\', \'text\': \'Arrolla.\\nCuando el Caballero del pavor de Bosquemusgo muera, puedes lanzarlo desde tu cementerio como una Aventura hasta el final de tu próximo turno.\', \'type\': \'Criatura — Caballero humano\', \'flavor\': None, \'faceName\': \'Mosswood Dreadknight\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630254&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'30412394-e3b1-4574-b31b-88171d4eb83a\', \'multiverseId\': 630254}, \'multiverseid\': 630254}, {\'name\': \'Mosswood Dreadknight // Murmures effroyables\', \'text\': "Piétinement\\nQuand le Chevalier de l\'effroi du Bois moussu meurt, vous pouvez le lancer depuis votre cimetière comme une aventure jusqu\'à la fin de votre prochain tour.", \'type\': \'Créature — humain et chevalier\', \'flavor\': None, \'faceName\': \'Mosswood Dreadknight\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630515&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'45754f88-73f0-4d59-97b5-8b63f9eab67d\', \'multiverseId\': 630515}, \'multiverseid\': 630515}, {\'name\': \'Mosswood Dreadknight // Sussurro Terrificante\', \'text\': "Travolgere\\nQuando il Cavaliere Terrificante della Selva Muschiata muore, puoi lanciarlo dal tuo cimitero come un\'Avventura fino alla fine del tuo prossimo turno.", \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': None, \'faceName\': \'Mosswood Dreadknight\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630776&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'87345256-ff5e-4d5b-8fbb-747137f20431\', \'multiverseId\': 630776}, \'multiverseid\': 630776}, {\'name\': \'Mosswood Dreadknight // 戦（せん）慄（りつ）の囁（ささや）き\', \'text\': \'トランプル\\n苔森の戦慄騎士が死亡したとき、次のあなたのターンの終了時まで、あなたの墓地にあるこれを出来事として唱えてもよい。\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': None, \'faceName\': \'Mosswood Dreadknight\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631037&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'995e47ac-f30f-4ade-8f34-b45b9e6ecd0d\', \'multiverseId\': 631037}, \'multiverseid\': 631037}, {\'name\': \'Mosswood Dreadknight // Sussurros do Pavor\', \'text\': \'Atropelar\\nQuando Cavaleiro do Pavor de Bosquemusgo morre, você pode conjurá-lo de seu cemitério como uma Aventura até o final de seu próximo turno.\', \'type\': \'Criatura — Humano Cavaleiro\', \'flavor\': None, \'faceName\': \'Mosswood Dreadknight\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631298&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d2f5de00-341f-44cd-b50a-6b248e4ab901\', \'multiverseId\': 631298}, \'multiverseid\': 631298}, {\'name\': \'Mosswood Dreadknight // 恐惧低语\', \'text\': \'践踏\\n当藓木林恐惧骑士死去时，直到你下一个回合的回合结束，你可以从你的坟墓场中将它作为历险施放。\', \'type\': \'生物 — 人类／骑士\', \'flavor\': None, \'faceName\': \'Mosswood Dreadknight\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631559&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ce8eca88-269e-448a-95bf-494a88a006d8\', \'multiverseId\': 631559}, \'multiverseid\': 631559}]', '[{\'name\': \'Münzwurf\', \'text\': \'Der Münzwurf fügt einem Ziel deiner Wahl 1 Schadenspunkt zu. Du erzeugst einen Schatz-Spielstein. (Er ist ein Artefakt mit „{T}, opfere dieses Artefakt: Erzeuge ein Mana einer beliebigen Farbe.")\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Von hier aus soll ich den antiken Gong treffen, sie dann von der Rüstung dort abprallen lassen und Gunrudd an der Nase treffen? Ist das alles?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629890&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9ebb5f25-7088-4cbc-8b38-109b93881d8b\', \'multiverseId\': 629890}, \'multiverseid\': 629890}, {\'name\': \'Lanzar una moneda\', \'text\': \'Lanzar una moneda hace 1 punto de daño a cualquier objetivo. Creas una ficha de Tesoro. (Es un artefacto con "{T}, sacrificar este artefacto: Agrega un maná de cualquier color".)\\nRoba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'"¿Que golpee el gong antiguo desde aquí, rebote en la armadura y le dé a Gunrudd en la nariz? ¿Eso es todo?".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630151&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'477c7fa3-f8c4-46a6-afd8-90877ea94ba8\', \'multiverseId\': 630151}, \'multiverseid\': 630151}, {\'name\': \'Pile ou face\', \'text\': "Pile ou face inflige 1 blessure à n\'importe quelle cible. Vous créez un jeton Trésor. (C\'est un artefact avec « {T}, sacrifiez cet artefact : Ajoutez un mana de la couleur de votre choix. »)\\nPiochez une carte.", \'type\': \'Éphémère\', \'flavor\': "« D\'ici, toucher le gong antique, faire ricocher sur l\'armure et toucher Gunrudd en plein dans le nez ? C\'est vraiment tout ? »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630412&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'653cb2cd-23f7-40fa-9310-31cf8941a61a\', \'multiverseId\': 630412}, \'multiverseid\': 630412}, {\'name\': \'Lancio della Moneta\', \'text\': \'Il Lancio della Moneta infligge 1 danno a un qualsiasi bersaglio. Crea una pedina Tesoro. (È un artefatto con "{T}, Sacrifica questo artefatto: Aggiungi un mana di un qualsiasi colore".)\\nPesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'"Da qui dovrei colpire l\\\'antico gong, farla rimbalzare sull\\\'armatura e colpire Gunrudd sul naso? Tutto qui?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630673&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'888519e5-c4c9-4308-8211-1dd5f4cccdd9\', \'multiverseId\': 630673}, \'multiverseid\': 630673}, {\'name\': \'コイン弾き\', \'text\': \'１つを対象とする。コイン弾きはそれに１点のダメージを与える。宝物・トークン１つを生成する。（それは、「{T}, このアーティファクトを生け贄に捧げる：好きな色１色のマナ１点を加える。」を持つアーティファクトである。）\\nカード１枚を引く。\', \'type\': \'インスタント\', \'flavor\': \'「この位置からあの年季の入った銅鑼に当てて、鉄甲冑に一度ぶつけてからグンラッドの鼻に命中させるのか？それだけでいいの？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630934&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'31866ba3-1bc6-4817-b6dd-2aa7387dd871\', \'multiverseId\': 630934}, \'multiverseid\': 630934}, {\'name\': \'Jogar uma Moeda\', \'text\': \'Jogar uma Moeda causa 1 ponto de dano a qualquer alvo. Você cria uma ficha de Tesouro. (Ela é um artefato com "{T}, sacrifique este artefato: Adicione um mana de qualquer cor".)\\nCompre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Daqui é pra bater no gongo antigo, ricochetear naquela armadura e acertar Gunrudd no nariz? É só isso?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631195&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'79778b24-4bcf-4dc5-80d9-95fdf1f8c74f\', \'multiverseId\': 631195}, \'multiverseid\': 631195}, {\'name\': \'轻弹硬币\', \'text\': \'轻弹硬币对任意一个目标造成1点伤害。你派出一个珍宝衍生物。（它是具有「{T}，牺牲此神器：加一点任意颜色的法术力」的神器。）\\n抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'「你要我从这里出手，先打到古锣、弹到铠甲，最后打中老甘头的鼻子？就这么简单？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631456&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2b64dc36-0935-4319-9ace-a1372ac52edb\', \'multiverseId\': 631456}, \'multiverseid\': 631456}]', '[{\'name\': \'Nacht der süßen Rache\', \'text\': \'Wenn die Nacht der süßen Rache ins Spiel kommt, erzeuge einen Speise-Spielstein. (Er ist ein Artefakt mit „{2}, {T}, opfere dieses Artefakt: Du erhältst 3 Lebenspunkte dazu.")\\nSpeisen, die du kontrollierst, haben „{T}: Erzeuge {G}."\\n{5}{G}{G}, opfere die Nacht der süßen Rache: Kreaturen, die du kontrollierst, erhalten bis zum Ende des Zuges +X/+X, wobei X gleich der Anzahl an Speisen ist, die du kontrollierst. Aktiviere diese Fähigkeit wie eine Hexerei.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629940&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'963b0a72-6d48-4360-aa14-93daa583b3de\', \'multiverseId\': 629940}, \'multiverseid\': 629940}, {\'name\': \'Noche de la venganza de los dulces\', \'text\': \'Cuando la Noche de la venganza de los dulces entre al campo de batalla, crea una ficha de Comida. (Es un artefacto con "{2}, {T}, sacrificar este artefacto: Ganas 3 vidas".)\\nLas Comidas que controlas tienen "{T}: Agrega {G}".\\n{5}{G}{G}, sacrificar la Noche de la venganza de los dulces: Las criaturas que controlas obtienen +X/+X hasta el final del turno, donde X es la cantidad de Comidas que controlas. Activa esto solo como un conjuro.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630201&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'10edf0b8-ef78-4e75-9310-fbd6f138ca46\', \'multiverseId\': 630201}, \'multiverseid\': 630201}, {\'name\': \'Nuit de la vengeance des bonbons\', \'text\': "Quand la Nuit de la vengeance des bonbons arrive sur le champ de bataille, créez un jeton Nourriture. (C\'est un artefact avec « {2}, {T}, sacrifiez cet artefact : Vous gagnez 3 points de vie. »)\\nLes nourritures que vous contrôlez ont « {T} : Ajoutez {G}. »\\n{5}{G}{G}, sacrifiez la Nuit de la vengeance des bonbons : Les créatures que vous contrôlez gagnent +X/+X jusqu\'à la fin du tour, X étant le nombre de nourritures que vous contrôlez. N\'activez que lorsque vous pourriez lancer un rituel.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630462&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b476f44c-1802-4218-9ec6-7cf5946b2da1\', \'multiverseId\': 630462}, \'multiverseid\': 630462}, {\'name\': \'La Notte dei Dolci Viventi\', \'text\': \'Quando La Notte dei Dolci Viventi entra nel campo di battaglia, crea una pedina Cibo. (È un artefatto con "{2}, {T}, Sacrifica questo artefatto: Guadagni 3 punti vita".)\\nI Cibi che controlli hanno "{T}: Aggiungi {G}".\\n{5}{G}{G}, Sacrifica La Notte dei Dolci Viventi: Le creature che controlli prendono +X/+X fino alla fine del turno, dove X è il numero di Cibi che controlli. Attiva solo come una stregoneria.\', \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630723&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'482b5102-9f58-4987-a041-ee964b742224\', \'multiverseId\': 630723}, \'multiverseid\': 630723}, {\'name\': \'菓子の復讐の夜\', \'text\': \'菓子の復讐の夜が戦場に出たとき、食物・トークン１つを生成する。（それは、「{2}, {T}, このアーティファクトを生け贄に捧げる：あなたは３点のライフを得る。」を持つアーティファクトである。）\\nあなたがコントロールしているすべての食物は「{T}：{G}を加える。」を持つ。\\n{5}{G}{G}, 菓子の復讐の夜を生け贄に捧げる：ターン終了時まで、あなたがコントロールしているすべてのクリーチャーは＋Ｘ/＋Ｘの修整を受ける。Ｘは、あなたがコントロールしている食物の数に等しい。起動はソーサリーとしてのみ行う。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630984&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bd6ca765-967f-4d87-a3fc-df642800ae36\', \'multiverseId\': 630984}, \'multiverseid\': 630984}, {\'name\': \'Noite da Vingança dos Doces\', \'text\': \'Quando Noite da Vingança dos Doces entrar no campo de batalha, crie uma ficha de Comida. (Ela é um artefato com "{2}, {T}, sacrifique este artefato: Você ganha 3 pontos de vida".)\\nAs Comidas que você controla têm "{T}: Adicione {G}".\\n{5}{G}{G}, sacrifique Noite da Vingança dos Doces: As criaturas que você controla recebem +X/+X até o final do turno, sendo X o número de Comidas que você controla. Ative somente como um feitiço.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631245&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'aaba1db5-b590-49f1-ade6-ef32efe7ca9c\', \'multiverseId\': 631245}, \'multiverseid\': 631245}, {\'name\': \'糖果复仇夜\', \'text\': \'当糖果复仇夜进战场时，派出一个食品衍生物。（它是具有「{2}，{T}，牺牲此神器：你获得3点生命」的神器。）\\n由你操控的食品具有「{T}：加{G}。」\\n{5}{G}{G}，牺牲糖果复仇夜：由你操控的生物得+X/+X直到回合结束，X为由你操控的食品数量。只能于法术时机起动。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631506&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e5f745a9-b2b2-42ca-8c0d-ea5673ab213e\', \'multiverseId\': 631506}, \'multiverseid\': 631506}]', '[{\'name\': \'Nagendes Crescendo\', \'text\': \'Kreaturen, die du kontrollierst, erhalten +2/+0 bis zum Ende des Zuges. Immer wenn eine Nichtspielsteinkreatur, die du kontrollierst, in diesem Zug stirbt, erzeuge einen 1/1 schwarzen Ratte-Kreaturenspielstein mit „Diese Kreatur kann nicht blocken."\', \'type\': \'Spontanzauber\', \'flavor\': \'Totentanz\\\' Lied hatte keinen Text, aber die Ratten verstanden es dennoch. „Dieses Land gehört euch", besagte es. „Ihr verdient es, euch daran gütlich zu tun."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629893&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7ef76bb5-45f3-4ba5-9749-1620e74bb980\', \'multiverseId\': 629893}, \'multiverseid\': 629893}, {\'name\': \'Crescendo remordedor\', \'text\': \'Las criaturas que controlas obtienen +2/+0 hasta el final del turno. Siempre que una criatura que no sea ficha que controlas muera este turno, crea una ficha de criatura Rata negra 1/1 con "Esta criatura no puede bloquear".\', \'type\': \'Instantáneo\', \'flavor\': \'La canción de Totentanz no tenía letra, pero las ratas la entendían igualmente. Decía: "Esta tierra les pertenece y merecen darse un banquete".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630154&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'387f5742-7403-4b63-8802-e10f41b17c6a\', \'multiverseId\': 630154}, \'multiverseid\': 630154}, {\'name\': \'Crescendo rongeur\', \'text\': "Les créatures que vous contrôlez gagnent +2/+0 jusqu\'à la fin du tour. À chaque fois qu\'une créature non-jeton que vous contrôlez meurt ce tour-ci, créez un jeton de créature 1/1 noire Rat avec « Cette créature ne peut pas bloquer. »", \'type\': \'Éphémère\', \'flavor\': "La chanson de Totentanz n\'avait pas de paroles, mais les rats la comprenaient quand même. « Cette terre vous appartient, disait-elle. Vous méritez de festoyer. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630415&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5675608a-6423-4993-b438-33ba1b41d84c\', \'multiverseId\': 630415}, \'multiverseid\': 630415}, {\'name\': \'Crescendo Rosicante\', \'text\': \'Le creature che controlli prendono +2/+0 fino alla fine del turno. Ogniqualvolta una creatura non pedina che controlli muore in questo turno, crea una pedina creatura Ratto 1/1 nera con "Questa creatura non può bloccare".\', \'type\': \'Istantaneo\', \'flavor\': \'Il canto di Totentanz non aveva un testo, ma i ratti lo capivano comunque. "Questa terra è vostra", diceva. "Andate a banchettare."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630676&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9100222e-7238-44e3-bb6c-1fd53d71e0c4\', \'multiverseId\': 630676}, \'multiverseid\': 630676}, {\'name\': \'かじりつく大合唱\', \'text\': \'ターン終了時まで、あなたがコントロールしているすべてのクリーチャーは＋２/＋０の修整を受ける。このターン、あなたがコントロールしていてトークンでないクリーチャー１体が死亡するたび、「このクリーチャーではブロックできない。」を持つ黒の１/１のネズミ・クリーチャー・トークン１体を生成する。\', \'type\': \'インスタント\', \'flavor\': \'トーテンタンズの歌に歌詞はなかったが、ネズミには理解できた。「この土地はお前たちのものだ、ご馳走がお前たちを待っている。」そう歌っているのであった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630937&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4a2667cf-54cc-4d53-8984-ac8d7cb54b4e\', \'multiverseId\': 630937}, \'multiverseid\': 630937}, {\'name\': \'Crescendo Roedor\', \'text\': \'As criaturas que você controla recebem +2/+0 até o final do turno. Toda vez que uma criatura não ficha que você controla morrer neste turno, crie uma ficha de criatura Rato preta 1/1 com "Esta criatura não pode bloquear".\', \'type\': \'Mágica Instantânea\', \'flavor\': \'A canção de Totentanz não tinha letra, mas os ratos entendiam mesmo assim. Ela dizia "Essa terra pertence a vocês". "Vocês merecem o banquete."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631198&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8b3974f1-92bb-4e61-adfa-c4f48b722d04\', \'multiverseId\': 631198}, \'multiverseid\': 631198}, {\'name\': \'啮咬渐响\', \'text\': \'由你操控的生物得+2/+0直到回合结束。本回合中，每当一个由你操控且非衍生物的生物死去时，派出一个1/1黑色老鼠衍生生物，且具有「此生物不能进行阻挡。」\', \'type\': \'瞬间\', \'flavor\': \'托腾坦的歌曲中本没有词，但这并不妨碍老鼠理解其中含义。曲是这么唱的：「土地归你，食物归你。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631459&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f1375349-10f7-4616-9e3d-4374fda90daf\', \'multiverseId\': 631459}, \'multiverseid\': 631459}]', '[{\'name\': \'Neva, heimgesucht von Albträumen\', \'text\': \'Bedrohlich\\nWenn Neva, heimgesucht von Albträumen, ins Spiel kommt, bringe eine Kreaturen- oder Verzauberungskarte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\\nImmer wenn eine Verzauberung, die du kontrollierst, aus dem Spiel auf einen Friedhof gelegt wird, lege eine +1/+1-Marke auf Neva und wende dann Hellsicht 1 an.\', \'type\': \'Legendäre Kreatur — Mensch, Adliger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629971&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7a75a59b-939a-4d6c-9fe1-eb4a2a9cba3b\', \'multiverseId\': 629971}, \'multiverseid\': 629971}, {\'name\': \'Nieves, acechada por pesadillas\', \'text\': \'Amenaza.\\nCuando Nieves, acechada por pesadillas entre al campo de batalla, regresa la carta de criatura o encantamiento objetivo de tu cementerio a tu mano.\\nSiempre que un encantamiento que controlas vaya a un cementerio desde el campo de batalla, pon un contador +1/+1 sobre Nieves y luego adivina 1.\', \'type\': \'Criatura legendaria — Noble humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630232&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c6575dc5-9e8d-4c93-822b-22532f081d7e\', \'multiverseId\': 630232}, \'multiverseid\': 630232}, {\'name\': \'Néva, poursuivie par les cauchemars\', \'text\': "Menace\\nQuand Néva, poursuivie par les cauchemars arrive sur le champ de bataille, renvoyez une carte de créature ou d\'enchantement ciblée depuis votre cimetière dans votre main.\\nÀ chaque fois qu\'un enchantement que vous contrôlez est mis dans un cimetière depuis le champ de bataille, mettez un marqueur +1/+1 sur Néva, puis regard 1.", \'type\': \'Créature légendaire — humain et noble\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630493&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'106d0e7b-b0a3-4532-982b-0d3728ebba45\', \'multiverseId\': 630493}, \'multiverseid\': 630493}, {\'name\': \'Nives, Perseguitata dagli Incubi\', \'text\': \'Minacciare\\nQuando Nives, Perseguitata dagli Incubi entra nel campo di battaglia, riprendi in mano una carta creatura o incantesimo bersaglio dal tuo cimitero.\\nOgniqualvolta un incantesimo che controlli viene messo in un cimitero dal campo di battaglia, metti un segnalino +1/+1 su Nives, poi profetizza 1.\', \'type\': \'Creatura Leggendaria — Nobile Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630754&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'13280b0d-639a-4650-b8ab-eaeb643d31ac\', \'multiverseId\': 630754}, \'multiverseid\': 630754}, {\'name\': \'悪夢に追われる者、ネヴァ\', \'text\': \'威迫\\n悪夢に追われる者、ネヴァが戦場に出たとき、あなたの墓地にありクリーチャーやエンチャントであるカード１枚を対象とする。それをあなたの手札に戻す。\\nあなたがコントロールしているエンチャント１つが戦場から墓地に置かれるたび、悪夢に追われる者、ネヴァの上に＋１/＋１カウンター１個を置く。その後、占術１を行う。\', \'type\': \'伝説のクリーチャー — 人間・貴族\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631015&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'de38c8b5-ac11-4a1a-a269-535edd53fbb5\', \'multiverseId\': 631015}, \'multiverseid\': 631015}, {\'name\': \'Neva, Perseguida por Pesadelos\', \'text\': \'Ameaçar\\nQuando Neva, Perseguida por Pesadelos, entrar no campo de batalha, devolva o card de criatura ou encantamento alvo de seu cemitério para sua mão.\\nToda vez que um encantamento que você controla for colocado em um cemitério vindo do campo de batalha, coloque um marcador +1/+1 em Neva e depois use vidência 1.\', \'type\': \'Criatura Lendária — Humano Nobre\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631276&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0dcf178f-58af-4473-a0ca-5dc3baee4837\', \'multiverseId\': 631276}, \'multiverseid\': 631276}, {\'name\': \'梦魇缠身白涅娃\', \'text\': \'威慑\\n当梦魇缠身白涅娃进战场时，将目标生物或结界牌从你的坟墓场移回你手上。\\n每当一个由你操控的结界从战场进入坟墓场时，在白涅娃上放置一个+1/+1指示物，然后占卜1。\', \'type\': \'传奇生物 — 人类／贵族\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631537&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d9f04c48-f5f3-4a33-80ec-967d2b9670fa\', \'multiverseId\': 631537}, \'multiverseid\': 631537}]', '[{\'name\': \'Obyra, träumende Duellantin\', \'text\': \'Aufblitzen\\nFliegend\\nImmer wenn ein anderes Feenwesen unter deiner Kontrolle ins Spiel kommt, verliert jeder Gegner 1 Lebenspunkt.\', \'type\': \'Legendäre Kreatur — Feenwesen, Krieger\', \'flavor\': \'Obyra schlafwandelt durch die Wildnis auf der Jagd nach würdigen Kontrahenten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629972&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8bfdd8f4-9c0c-467d-acfb-f92ebd6c68e0\', \'multiverseId\': 629972}, \'multiverseid\': 629972}, {\'name\': \'Obyra, duelista soñadora\', \'text\': \'Destello.\\nVuela.\\nSiempre que otra Hada entre al campo de batalla bajo tu control, cada oponente pierde 1 vida.\', \'type\': \'Criatura legendaria — Guerrero hada\', \'flavor\': \'Obyra camina dormida por las tierras salvajes en busca de oponentes dignos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630233&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'36558443-735c-419b-b734-901b1255c0a9\', \'multiverseId\': 630233}, \'multiverseid\': 630233}, {\'name\': \'Obyra, duelliste rêvante\', \'text\': "Flash\\nVol\\nÀ chaque fois qu\'un autre peuple fée arrive sur le champ de bataille sous votre contrôle, chaque adversaire perd 1 point de vie.", \'type\': \'Créature légendaire — peuple fée et guerrier\', \'flavor\': "Obyra arpente les friches dans son sommeil, chassant des adversaires dignes d\'elle.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630494&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f69521e3-d405-410f-907a-1496dcd9ba0d\', \'multiverseId\': 630494}, \'multiverseid\': 630494}, {\'name\': \'Obyra, Duellante Sognatrice\', \'text\': \'Lampo\\nVolare\\nOgniqualvolta un altro Spiritello entra nel campo di battaglia sotto il tuo controllo, ogni avversario perde 1 punto vita.\', \'type\': \'Creatura Leggendaria — Guerriero Spiritello\', \'flavor\': \'Obyra vaga nel sonno tra le terre selvagge, a caccia di avversari degni.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630755&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f689b93f-6384-491e-bad5-232c09e262a5\', \'multiverseId\': 630755}, \'multiverseid\': 630755}, {\'name\': \'夢見る決闘者、オビラ\', \'text\': \'瞬速\\n飛行\\nこれでないフェアリー１体があなたのコントロール下で戦場に出るたび、各対戦相手はそれぞれ１点のライフを失う。\', \'type\': \'伝説のクリーチャー — フェアリー・戦士\', \'flavor\': \'オビラは僻境の中を夢遊状態で歩きながら、手合わせに相応しい相手を探し続けている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631016&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5fd0e027-a7c0-4f35-b3f8-3fee25508655\', \'multiverseId\': 631016}, \'multiverseid\': 631016}, {\'name\': \'Obyra, Duelista Sonhadora\', \'text\': \'Lampejo\\nVoar\\nToda vez que outra Fada entra no campo de batalha sob seu controle, cada oponente perde 1 ponto de vida.\', \'type\': \'Criatura Lendária — Fada Guerreiro\', \'flavor\': \'Obyra vaga sonâmbula pelas Terras Selvagens, em busca de oponentes dignos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631277&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c57c3105-3f06-4b3e-bc90-5dd8a2059187\', \'multiverseId\': 631277}, \'multiverseid\': 631277}, {\'name\': \'迷梦斗客欧拜拉\', \'text\': \'闪现\\n飞行\\n每当另一个仙灵在你的操控下进战场时，每位对手各失去1点生命。\', \'type\': \'传奇生物 — 仙灵／战士\', \'flavor\': \'欧拜拉在沉眠中漫游幻野，苦苦寻找值得一战的对手。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631538&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cbed41b7-8a88-45f3-b9be-ef415dc96ca1\', \'multiverseId\': 631538}, \'multiverseid\': 631538}]', '[{\'name\': \'Oger-Fiepsfürst\', \'text\': \'Bedrohlich\\nImmer wenn der Oger-Fiepsfürst ins Spiel kommt oder angreift, erzeuge zwei 1/1 schwarze Ratte-Kreaturenspielsteine mit „Diese Kreatur kann nicht blocken." Falls du dann fünf oder mehr Ratten kontrollierst, erhält jede Ratte, die du kontrollierst, +2/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Oger, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632052&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'18604387-2079-4bbb-b11f-2c9e553a92f4\', \'multiverseId\': 632052}, \'multiverseid\': 632052}, {\'name\': \'Seigneur des bruyants ogre\', \'text\': "Menace\\nÀ chaque fois que le Seigneur des bruyants ogre arrive sur le champ de bataille ou attaque, créez deux jetons de créature 1/1 noire Rat avec « Cette créature ne peut pas bloquer. » Puis, si vous contrôlez au moins cinq rats, chaque rat que vous contrôlez gagne +2/+0 jusqu\'à la fin du tour.", \'type\': \'Créature — ogre et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632057&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'866fad4d-c4ac-4f35-b45e-b102ed605774\', \'multiverseId\': 632057}, \'multiverseid\': 632057}, {\'name\': \'オーガの囀王\', \'text\': \'威迫\\nオーガの囀王が戦場に出るか攻撃するたび、「このクリーチャーではブロックできない。」を持つ黒の１/１のネズミ・クリーチャー・トークン２体を生成する。その後、あなたが５体以上のネズミをコントロールしているなら、ターン終了時まで、あなたがコントロールしているすべてのネズミは＋２/＋０の修整を受ける。\', \'type\': \'クリーチャー — オーガ・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632062&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'29d25f29-1a26-4905-afc6-52d7e329395c\', \'multiverseId\': 632062}, \'multiverseid\': 632062}, {\'name\': \'食人魔鼠王\', \'text\': \'威慑\\n每当食人魔鼠王进战场或攻击时，派出两个1/1黑色老鼠衍生生物，且具有「此生物不能进行阻挡。」然后若你操控五个或更多老鼠，则每个由你操控的老鼠各得+2/+0直到回合结束。\', \'type\': \'生物 — 食人魔／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632067&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f45cd4e2-76b1-4736-b061-547a61014d53\', \'multiverseId\': 632067}, \'multiverseid\': 632067}]', '[{\'name\': \'Oger-Fiepsfürst\', \'text\': \'Bedrohlich\\nImmer wenn der Oger-Fiepsfürst ins Spiel kommt oder angreift, erzeuge zwei 1/1 schwarze Ratte-Kreaturenspielsteine mit „Diese Kreatur kann nicht blocken." Falls du dann fünf oder mehr Ratten kontrollierst, erhält jede Ratte, die du kontrollierst, +2/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Oger, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632095&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a8530461-61d4-42f1-bc77-291961838d50\', \'multiverseId\': 632095}, \'multiverseid\': 632095}, {\'name\': \'Señor de las alimañas ogro\', \'text\': \'Amenaza.\\nSiempre que el Señor de las alimañas ogro entre al campo de batalla o ataque, crea dos fichas de criatura Rata negras 1/1 con "Esta criatura no puede bloquear". Luego, si controlas cinco o más Ratas, cada Rata que controlas obtiene +2/+0 hasta el final del turno.\', \'type\': \'Criatura — Guerrero ogro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632110&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f2a5984a-8212-45f8-8dab-b27a59b7fde4\', \'multiverseId\': 632110}, \'multiverseid\': 632110}, {\'name\': \'Seigneur des bruyants ogre\', \'text\': "Menace\\nÀ chaque fois que le Seigneur des bruyants ogre arrive sur le champ de bataille ou attaque, créez deux jetons de créature 1/1 noire Rat avec « Cette créature ne peut pas bloquer. » Puis, si vous contrôlez au moins cinq rats, chaque rat que vous contrôlez gagne +2/+0 jusqu\'à la fin du tour.", \'type\': \'Créature — ogre et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632125&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'80b836ad-cf58-4cde-adbe-5ff0405871e3\', \'multiverseId\': 632125}, \'multiverseid\': 632125}, {\'name\': \'Ogre Signore dei Rosicanti\', \'text\': \'Minacciare\\nOgniqualvolta l\\\'Ogre Signore dei Rosicanti entra nel campo di battaglia o attacca, crea due pedine creatura Ratto 1/1 nere con "Questa creatura non può bloccare". Poi, se controlli cinque o più Ratti, ogni Ratto che controlli prende +2/+0 fino alla fine del turno.\', \'type\': \'Creatura — Guerriero Ogre\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632140&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'60d0a546-2459-463c-8682-1f4f1e67f29c\', \'multiverseId\': 632140}, \'multiverseid\': 632140}, {\'name\': \'オーガの囀王\', \'text\': \'威迫\\nオーガの囀王が戦場に出るか攻撃するたび、「このクリーチャーではブロックできない。」を持つ黒の１/１のネズミ・クリーチャー・トークン２体を生成する。その後、あなたが５体以上のネズミをコントロールしているなら、ターン終了時まで、あなたがコントロールしているすべてのネズミは＋２/＋０の修整を受ける。\', \'type\': \'クリーチャー — オーガ・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632155&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1db3d729-71f7-4387-b492-5d13a9b09c57\', \'multiverseId\': 632155}, \'multiverseid\': 632155}, {\'name\': \'Ogro Senhor dos Chiadores\', \'text\': \'Ameaçar\\nToda vez que Ogro Senhor dos Chiadores entrar no campo de batalha ou atacar, crie duas fichas de criatura Rato preta 1/1 com "Esta criatura não pode bloquear". Depois, se você controlar cinco ou mais Ratos, cada Rato que você controla recebe +2/+0 até o final do turno.\', \'type\': \'Criatura — Ogro Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632170&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7b5a1e95-be97-470f-81cd-0870007003ad\', \'multiverseId\': 632170}, \'multiverseid\': 632170}, {\'name\': \'食人魔鼠王\', \'text\': \'威慑\\n每当食人魔鼠王进战场或攻击时，派出两个1/1黑色老鼠衍生生物，且具有「此生物不能进行阻挡。」然后若你操控五个或更多老鼠，则每个由你操控的老鼠各得+2/+0直到回合结束。\', \'type\': \'生物 — 食人魔／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632185&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c4c59e73-1e76-4022-b7f4-4596bbb7dfdf\', \'multiverseId\': 632185}, \'multiverseid\': 632185}]', "[{'name': 'Picklock Prankster // Feenbefreiung', 'text': 'Fliegend, Wachsamkeit', 'type': 'Kreatur — Feenwesen, Räuber', 'flavor': 'Unfug lässt sich nicht einsperren.', 'faceName': 'Picklock Prankster', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629826&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd14cb14e-02ee-449b-9388-085b9f77abc0', 'multiverseId': 629826}, 'multiverseid': 629826}, {'name': 'Picklock Prankster // Liberar al hada', 'text': 'Vuela, vigilancia.', 'type': 'Criatura — Bribón hada', 'flavor': 'Las travesuras no se pueden enjaular.', 'faceName': 'Picklock Prankster', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630087&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '8d5ab86e-5132-4109-8a30-fbeedad66e70', 'multiverseId': 630087}, 'multiverseid': 630087}, {'name': 'Picklock Prankster // Libérer la fae', 'text': 'Vol, vigilance', 'type': 'Créature — peuple fée et gredin', 'flavor': 'On ne peut pas mettre la malice en cage.', 'faceName': 'Picklock Prankster', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630348&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ed432e15-5553-40e6-b4c4-cd802129fdbb', 'multiverseId': 630348}, 'multiverseid': 630348}, {'name': 'Picklock Prankster // Liberare le Fate', 'text': 'Volare, cautela', 'type': 'Creatura — Farabutto Spiritello', 'flavor': 'La malizia non conosce sbarre.', 'faceName': 'Picklock Prankster', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630609&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '1edb40f5-5153-47f2-a7a6-b6ef417cae0b', 'multiverseId': 630609}, 'multiverseid': 630609}, {'name': 'Picklock Prankster // フェイの解（かい）放（ほう）', 'text': '飛行、警戒', 'type': 'クリーチャー — フェアリー・ならず者', 'flavor': 'いたずら小僧を檻に閉じ込めておくなど無理な話である。', 'faceName': 'Picklock Prankster', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630870&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'b9a888da-2f8b-4204-aebd-988d9cc4edb4', 'multiverseId': 630870}, 'multiverseid': 630870}, {'name': 'Picklock Prankster // Libertar as Fadinas', 'text': 'Voar, vigilância', 'type': 'Criatura — Fada Ladino', 'flavor': 'Não dá pra engaiolar a travessura.', 'faceName': 'Picklock Prankster', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631131&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fbb1b755-a145-48b1-8094-fbf8043bb352', 'multiverseId': 631131}, 'multiverseid': 631131}, {'name': 'Picklock Prankster // 解救仙儿', 'text': '飞行，警戒', 'type': '生物 — 仙灵／浪客', 'flavor': '作弄之心锁不进笼子里。', 'faceName': 'Picklock Prankster', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631392&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f06807d8-4991-4df7-aded-c472eb803243', 'multiverseId': 631392}, 'multiverseid': 631392}]", '[{\'name\': \'Picnic Ruiner // Geraubte Häppchen\', \'text\': \'Immer wenn der Picknickverderber angreift, während du eine Kreatur mit Stärke 4 oder mehr kontrollierst, erhält der Picknickverderber Doppelschlag bis zum Ende des Zuges.\', \'type\': \'Kreatur — Goblin, Räuber\', \'flavor\': None, \'faceName\': \'Picnic Ruiner\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629994&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1761f6f8-fb2b-4f54-8954-799e77c8e520\', \'multiverseId\': 629994}, \'multiverseid\': 629994}, {\'name\': \'Picnic Ruiner // Cositas robadas\', \'text\': \'Siempre que el Desmantelapícnics ataque mientras controlas una criatura con fuerza de 4 o más, el Desmantelapícnics gana la habilidad de dañar dos veces hasta el final del turno.\', \'type\': \'Criatura — Bribón trasgo\', \'flavor\': None, \'faceName\': \'Picnic Ruiner\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630255&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1b72735e-8865-4f4c-b762-673e3868a81a\', \'multiverseId\': 630255}, \'multiverseid\': 630255}, {\'name\': \'Picnic Ruiner // Sucreries mal acquises\', \'text\': "À chaque fois que le Destructeur de pique-nique attaque pendant que vous contrôlez une créature de force supérieure ou égale à 4, le Destructeur de pique-nique acquiert la double initiative jusqu\'à la fin du tour.", \'type\': \'Créature — gobelin et gredin\', \'flavor\': None, \'faceName\': \'Picnic Ruiner\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630516&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9208bb0f-072e-4f44-92c9-0b6f2fbfb9f7\', \'multiverseId\': 630516}, \'multiverseid\': 630516}, {\'name\': \'Picnic Ruiner // Prelibatezze Rubate\', \'text\': \'Ogniqualvolta il Guastapicnic attacca mentre controlli una creatura con forza pari o superiore a 4, il Guastapicnic ha doppio attacco fino alla fine del turno.\', \'type\': \'Creatura — Farabutto Goblin\', \'flavor\': None, \'faceName\': \'Picnic Ruiner\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630777&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'aca608d0-a042-48d7-be9a-9dab4dcdee25\', \'multiverseId\': 630777}, \'multiverseid\': 630777}, {\'name\': \'Picnic Ruiner // 盗（ぬす）まれたお菓（か）子（し）\', \'text\': \'あなたがパワーが４以上であるクリーチャーをコントロールしていてピクニック荒らしが攻撃するたび、ターン終了時まで、ピクニック荒らしは二段攻撃を得る。\', \'type\': \'クリーチャー — ゴブリン・ならず者\', \'flavor\': None, \'faceName\': \'Picnic Ruiner\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631038&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'725874e7-ac7b-4b3d-a29f-668491c78ddd\', \'multiverseId\': 631038}, \'multiverseid\': 631038}, {\'name\': \'Picnic Ruiner // Guloseimas Roubadas\', \'text\': \'Toda vez que Arruinador de Piqueniques ataca enquanto você controla uma criatura com poder igual ou superior a 4, Arruinador de Piqueniques ganha golpe duplo até o final do turno.\', \'type\': \'Criatura — Goblin Ladino\', \'flavor\': None, \'faceName\': \'Picnic Ruiner\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631299&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6c40c18b-06f4-47fa-8342-f43aed9ac4be\', \'multiverseId\': 631299}, \'multiverseid\': 631299}, {\'name\': \'Picnic Ruiner // 遭窃美食\', \'text\': \'每当野餐搅席客于你操控力量等于或大于4的生物时攻击，野餐搅席客获得连击异能直到回合结束。\', \'type\': \'生物 — 鬼怪／浪客\', \'flavor\': None, \'faceName\': \'Picnic Ruiner\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631560&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'da948985-1155-4c8d-a4c1-c142ee06fd62\', \'multiverseId\': 631560}, \'multiverseid\': 631560}]', '[{\'name\': \'Plätschernder Zaubermeister\', \'text\': \'Immer wenn du einen Spontanzauber oder eine Hexerei wirkst, erzeuge einen Magier-Rolle-Spielstein, angelegt an bis zu eine andere Kreatur deiner Wahl, die du kontrollierst. (Falls du bereits eine andere daran angelegte Rolle kontrollierst, lege die alte Rolle auf den Friedhof. Die verzauberte Kreatur erhält +1/+1 und hat „Immer wenn diese Kreatur angreift, wende Hellsicht 1 an.")\', \'type\': \'Kreatur — Elementarwesen, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629832&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0b20225b-8fc6-4e51-9178-b73f7c402f2e\', \'multiverseId\': 629832}, \'multiverseid\': 629832}, {\'name\': \'Mago normal y corriente\', \'text\': \'Siempre que lances un hechizo de instantáneo o de conjuro, crea una ficha de Papel de Mago anexada a hasta una otra criatura objetivo que controlas. (Si controlas otro Papel sobre ella, pon ese en el cementerio. La criatura encantada obtiene +1/+1 y tiene "Siempre que esta criatura ataque, adivina 1".)\', \'type\': \'Criatura — Hechicero elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630093&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7d3d846d-4ac0-4b21-a1bd-386ffd61bbf4\', \'multiverseId\': 630093}, \'multiverseid\': 630093}, {\'name\': \'Lanceur de sorts éclabousseur\', \'text\': "À chaque fois que vous lancez un sort d\'éphémère ou de rituel, créez un jeton de rôle Ensorceleur attaché à jusqu\'à une autre créature ciblée que vous contrôlez. (Si vous contrôlez un autre rôle sur elle, mettez-le au cimetière. La créature enchantée gagne +1/+1 et a « À chaque fois que cette créature attaque, regard 1. »)", \'type\': \'Créature — élémental et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630354&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b36398ac-f92e-4c4e-9573-11ccfac2574e\', \'multiverseId\': 630354}, \'multiverseid\': 630354}, {\'name\': \'Incantatore Schizzato\', \'text\': \'Ogniqualvolta lanci una magia istantaneo o stregoneria, crea una pedina Ruolo Stregone assegnata a fino a un\\\'altra creatura bersaglio che controlli. (Se controlli un altro Ruolo assegnato a quella creatura, metti quel Ruolo nel cimitero. La creatura incantata prende +1/+1 e ha "Ogniqualvolta questa creatura attacca, profetizza 1".)\', \'type\': \'Creatura — Mago Elementale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630615&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5861243a-c88e-400a-bcb3-09d4471f6b87\', \'multiverseId\': 630615}, \'multiverseid\': 630615}, {\'name\': \'水飛沫の呪文使い\', \'text\': \'あなたがインスタントやソーサリーである呪文１つを唱えるたび、あなたがコントロールしていてこれでないクリーチャー最大１体を対象とする。魔術師・役割・トークン１つをそれについた状態で生成する。（あなたがコントロールしている役割がすでにそれについていたなら、その役割を墓地に置く。エンチャントしているクリーチャーは＋１/＋１の修整を受け「このクリーチャーが攻撃するたび、占術１を行う。」を持つ。）\', \'type\': \'クリーチャー — エレメンタル・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630876&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d29af483-ea31-4b8e-982b-b2a6502fd15c\', \'multiverseId\': 630876}, \'multiverseid\': 630876}, {\'name\': \'Mago Respingante\', \'text\': \'Toda vez que você conjurar uma mágica instantânea ou um feitiço, crie uma ficha de Papel de Feiticeiro anexada a até uma outra criatura alvo que você controla. (Se você controlar outro Papel nela, coloque aquele no cemitério. A criatura encantada recebe +1/+1 e tem "Toda vez que esta criatura atacar, use vidência 1".)\', \'type\': \'Criatura — Elemental Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631137&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'11b73184-c4ab-462a-a503-68e4b6b8ba6c\', \'multiverseId\': 631137}, \'multiverseid\': 631137}, {\'name\': \'宣泄施咒灵\', \'text\': \'每当你施放瞬间或法术咒语时，派出一个术士角色衍生物，并贴附在至多另一个目标由你操控的生物上。（如果其上已有另一个你操控的角色，则将已有之角色置入坟墓场。所结附的生物得+1/+1且具有「每当此生物攻击时，占卜1。」）\', \'type\': \'生物 — 元素／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631398&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a9e6d615-b394-4b56-a21e-22e2db97d51d\', \'multiverseId\': 631398}, \'multiverseid\': 631398}]', "[{'name': 'Pollen-Shield Hare // Hasenzucht', 'text': 'Kreaturenspielsteine, die du kontrollierst, erhalten +1/+1.', 'type': 'Kreatur — Kaninchen', 'flavor': 'Er kann jede Gefahr abwenden, von Eulen über Jäger bis hin zu phyrexianischen Monstern.', 'faceName': 'Pollen-Shield Hare', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629995&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a3a0a4e3-b8cf-4a54-8a69-d4c4773d6d64', 'multiverseId': 629995}, 'multiverseid': 629995}, {'name': 'Pollen-Shield Hare // Crianza de liebres', 'text': 'Las fichas de criatura que controlas obtienen +1/+1.', 'type': 'Criatura — Conejo', 'flavor': 'Puede ahuyentar cualquier amenaza, desde un búho o un cazador a un monstruo pirexiano.', 'faceName': 'Pollen-Shield Hare', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630256&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'b1447bbf-4661-4550-95ba-65d30b3eefcd', 'multiverseId': 630256}, 'multiverseid': 630256}, {'name': 'Pollen-Shield Hare // Courir deux lièvres', 'text': 'Les jetons de créature que vous contrôlez gagnent +1/+1.', 'type': 'Créature — lapin', 'flavor': 'Il peut repousser tout ce qui le menace, des hiboux aux chasseurs, et même les monstres phyrexians.', 'faceName': 'Pollen-Shield Hare', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630517&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd553eb4d-4afe-45b9-be0d-e3a99cf81923', 'multiverseId': 630517}, 'multiverseid': 630517}, {'name': 'Pollen-Shield Hare // Allevare Leprotti', 'text': 'Le pedine creatura che controlli prendono +1/+1.', 'type': 'Creatura — Coniglio', 'flavor': 'È in grado di scacciare qualsiasi minaccia, sia essa gufo, cacciatore o mostro Phyrexiano.', 'faceName': 'Pollen-Shield Hare', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630778&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '960643cb-10f3-4ab5-9654-d18aa9139791', 'multiverseId': 630778}, 'multiverseid': 630778}, {'name': 'Pollen-Shield Hare // 兎（うさぎ）の子（こ）育（そだ）て', 'text': 'あなたがコントロールしているすべてのクリーチャー・トークンは＋１/＋１の修整を受ける。', 'type': 'クリーチャー — 兎', 'flavor': '梟や狩人、ファイレクシアの怪物でさえも追い返すことができる。', 'faceName': 'Pollen-Shield Hare', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631039&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'a5887fd1-f7fa-4edf-82e3-25361911317a', 'multiverseId': 631039}, 'multiverseid': 631039}, {'name': 'Pollen-Shield Hare // Criação de Lebres', 'text': 'As fichas de criatura que você controla recebem +1/+1.', 'type': 'Criatura — Coelho', 'flavor': 'Ela é capaz de expulsar qualquer ameaça, seja coruja, seja caçador, seja monstro phyrexiano.', 'faceName': 'Pollen-Shield Hare', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631300&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '345b53a9-ccee-40a7-9cd7-5894b9cde4e8', 'multiverseId': 631300}, 'multiverseid': 631300}, {'name': 'Pollen-Shield Hare // 抚育幼兔', 'text': '由你操控的衍生生物得+1/+1。', 'type': '生物 — 兔', 'flavor': '她能赶走任何威胁，从猫头鹰到猎人，甚至是非瑞克西亚怪物。', 'faceName': 'Pollen-Shield Hare', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631561&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '4ecce8ff-2060-4290-bb83-521e7a0984c7', 'multiverseId': 631561}, 'multiverseid': 631561}]", '[{\'name\': \'Prophetisches Prisma\', \'text\': \'Wenn das Prophetische Prisma ins Spiel kommt, ziehe eine Karte.\\n{1}, {T}: Erzeuge ein Mana einer beliebigen Farbe.\', \'type\': \'Artefakt\', \'flavor\': \'„Die meisten Träume offenbaren lediglich Bruchstücke dessen, was du sein könntest. Nur Albträume zeigen dir, wer du wirklich bist."\\n—Ashiok\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630011&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'eab15721-714c-45e2-91e5-fd920f868861\', \'multiverseId\': 630011}, \'multiverseid\': 630011}, {\'name\': \'Prisma profético\', \'text\': \'Cuando el Prisma profético entre al campo de batalla, roba una carta.\\n{1}, {T}: Agrega un maná de cualquier color.\', \'type\': \'Artefacto\', \'flavor\': \'"La mayoría de los sueños únicamente muestran fragmentos de lo que podrías ser. Solo las pesadillas te muestran quién eres en realidad".\\n—Ashiok\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630272&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cb2e03f0-9412-4811-adc5-21d46e058064\', \'multiverseId\': 630272}, \'multiverseid\': 630272}, {\'name\': \'Prisme prophétique\', \'text\': \'Quand le Prisme prophétique arrive sur le champ de bataille, piochez une carte.\\n{1}, {T} : Ajoutez un mana de la couleur de votre choix.\', \'type\': \'Artefact\', \'flavor\': \'« La plupart des rêves ne révèlent que des fragments de ce que vous pourriez être. Ce sont les cauchemars qui vous montrent qui vous êtes vraiment. »\\n—Ashiok\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630533&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'451f0a6c-9240-46f4-9f9a-9835c2fd4c30\', \'multiverseId\': 630533}, \'multiverseid\': 630533}, {\'name\': \'Prisma Profetico\', \'text\': \'Quando il Prisma Profetico entra nel campo di battaglia, pesca una carta.\\n{1}, {T}: Aggiungi un mana di un qualsiasi colore.\', \'type\': \'Artefatto\', \'flavor\': \'"Molti sogni non rivelano altro che frammenti di ciò che potresti essere. Solo gli incubi possono mostrarti la tua vera identità."\\n—Ashiok\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630794&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4a4eb91a-143f-4baa-9152-9299def62ceb\', \'multiverseId\': 630794}, \'multiverseid\': 630794}, {\'name\': \'予言のプリズム\', \'text\': \'予言のプリズムが戦場に出たとき、カード１枚を引く。\\n{1}, {T}：好きな色１色のマナ１点を加える。\', \'type\': \'アーティファクト\', \'flavor\': \'「大抵の夢は、自分がなれるものの一部しか明らかにしない。本当の自分を見せてくれるのは、悪夢だけである。」\\n――アショク\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631055&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9ed6b827-17be-42f1-a8e3-17c4da5b863f\', \'multiverseId\': 631055}, \'multiverseid\': 631055}, {\'name\': \'Prisma Profético\', \'text\': \'Quando Prisma Profético entrar no campo de batalha, compre um card.\\n{1}, {T}: Adicione um mana de qualquer cor.\', \'type\': \'Artefato\', \'flavor\': \'"A maioria dos sonhos só revela fragmentos do que você pode ser. Só os pesadelos podem lhe mostrar quem você realmente é."\\n— Ashiok\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631316&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8ef6b23c-a25b-42b6-a7e8-88dab3516f42\', \'multiverseId\': 631316}, \'multiverseid\': 631316}, {\'name\': \'预视棱镜\', \'text\': \'当预视棱镜进战场时，抓一张牌。\\n{1}，{T}：加一点任意颜色的法术力。\', \'type\': \'神器\', \'flavor\': \'「你虽能在大多数梦境中见得未来所成，但也只不过是只言片影。唯有噩梦方能展现你的真实全貌。」\\n～安梭苛\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631577&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4295e2c2-f325-4f29-ab76-c7413e4e1e57\', \'multiverseId\': 631577}, \'multiverseid\': 631577}]', '[{\'name\': \'Provianthändler\', \'text\': \'Wenn der Provianthändler ins Spiel kommt, erzeuge einen Speise-Spielstein. (Er ist ein Artefakt mit „{2}, {T}, opfere dieses Artefakt: Du erhältst 3 Lebenspunkte dazu.")\\nImmer wenn der Provianthändler angreift, kannst du eine Speise opfern. Falls du dies tust, erhalten angreifende Kreaturen +1/+1 und verursachen Trampelschaden bis zum Ende des Zuges.\', \'type\': \'Kreatur — Bestie, Gesinde\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632097&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'840f34a4-903b-47bc-ad9c-200ca3e80ec3\', \'multiverseId\': 632097}, \'multiverseid\': 632097}, {\'name\': \'Mercader de provisiones\', \'text\': \'Cuando el Mercader de provisiones entre al campo de batalla, crea una ficha de Comida. (Es un artefacto con "{2}, {T}, sacrificar este artefacto: Ganas 3 vidas".)\\nSiempre que el Mercader de provisiones ataque, puedes sacrificar una Comida. Si lo haces, las criaturas atacantes obtienen +1/+1 y ganan la habilidad de arrollar hasta el final del turno.\', \'type\': \'Criatura — Plebeyo bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632112&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ea9db3b9-0db3-46db-abb4-4594227198b4\', \'multiverseId\': 632112}, \'multiverseid\': 632112}, {\'name\': \'Marchand de provisions\', \'text\': "Quand le Marchand de provisions arrive sur le champ de bataille, créez un jeton Nourriture. (C\'est un artefact avec « {2}, {T}, sacrifiez cet artefact : Vous gagnez 3 points de vie. »)\\nÀ chaque fois que le Marchand de provisions attaque, vous pouvez sacrifier une nourriture. Si vous faites ainsi, les créatures attaquantes gagnent +1/+1 et acquièrent le piétinement jusqu\'à la fin du tour.", \'type\': \'Créature — bête et paysan\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632127&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b865ea04-4cb5-4e1b-9a2f-6f36d3c4744d\', \'multiverseId\': 632127}, \'multiverseid\': 632127}, {\'name\': \'Mercante di Provviste\', \'text\': \'Quando il Mercante di Provviste entra nel campo di battaglia, crea una pedina Cibo. (È un artefatto con "{2}, {T}, Sacrifica questo artefatto: Guadagni 3 punti vita".)\\nOgniqualvolta il Mercante di Provviste attacca, puoi sacrificare un Cibo. Se lo fai, le creature attaccanti prendono +1/+1 e hanno travolgere fino alla fine del turno.\', \'type\': \'Creatura — Popolano Bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632142&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6da83705-ab4d-4f73-bfe9-e21a3ee4479e\', \'multiverseId\': 632142}, \'multiverseid\': 632142}, {\'name\': \'食糧の商人\', \'text\': \'食糧の商人が戦場に出たとき、食物・トークン１つを生成する。（それは、「{2}, {T}, このアーティファクトを生け贄に捧げる：あなたは３点のライフを得る。」を持つアーティファクトである。）\\n食糧の商人が攻撃するたび、食物１つを生け贄に捧げてもよい。そうしたなら、ターン終了時まで、すべての攻撃クリーチャーは＋１/＋１の修整を受けトランプルを得る。\', \'type\': \'クリーチャー — ビースト・農民\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632157&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'80b21cd4-7116-4401-8b6e-63185acd635a\', \'multiverseId\': 632157}, \'multiverseid\': 632157}, {\'name\': \'Comerciante de Provisões\', \'text\': \'Quando Comerciante de Provisões entrar no campo de batalha, crie uma ficha de Comida. (Ela é um artefato com "{2}, {T}, sacrifique este artefato: Você ganha 3 pontos de vida".)\\nToda vez que Comerciante de Provisões ataca, você pode sacrificar uma Comida. Se fizer isso, as criaturas atacantes recebem +1/+1 e ganham atropelar até o final do turno.\', \'type\': \'Criatura — Besta Plebeu\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632172&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7e299a91-272a-46e3-8348-35b64b96171f\', \'multiverseId\': 632172}, \'multiverseid\': 632172}, {\'name\': \'美食摊贩\', \'text\': \'当美食摊贩进战场时，派出一个食品衍生物。（它是具有「{2}，{T}，牺牲此神器：你获得3点生命」的神器。）\\n每当美食摊贩攻击时，你可以牺牲一个食品。若你如此作，则直到回合结束，进行攻击的生物得+1/+1且获得践踏异能。\', \'type\': \'生物 — 野兽／平民\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632187&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6c519239-84ea-43f2-a5da-aecc9514d052\', \'multiverseId\': 632187}, \'multiverseid\': 632187}]', "[{'name': 'Questing Druid // Suche nach dem Tier', 'text': 'Immer wenn du einen Zauberspruch wirkst, der weiß, blau, schwarz oder rot ist, lege eine +1/+1-Marke auf den Suchenden Druiden.', 'type': 'Kreatur — Mensch, Druide', 'flavor': None, 'faceName': 'Questing Druid', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629996&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f95a7b96-61f1-4578-93cd-b0637fa7baf8', 'multiverseId': 629996}, 'multiverseid': 629996}, {'name': 'Questing Druid // Buscar a la bestia', 'text': 'Siempre que lances un hechizo blanco, azul, negro o rojo, pon un contador +1/+1 sobre el Druida rastreador.', 'type': 'Criatura — Druida humano', 'flavor': None, 'faceName': 'Questing Druid', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630257&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '3263b4b1-4751-4b79-8cc2-1812d7f21619', 'multiverseId': 630257}, 'multiverseid': 630257}, {'name': 'Questing Druid // En quête de la bête', 'text': 'À chaque fois que vous lancez un sort qui est blanc, bleu, noir ou rouge, mettez un marqueur +1/+1 sur le Druide en quête.', 'type': 'Créature — humain et druide', 'flavor': None, 'faceName': 'Questing Druid', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630518&type=card', 'language': 'French', 'identifiers': {'scryfallId': '1e200b7c-13ca-4c0f-86aa-6c329b17994a', 'multiverseId': 630518}, 'multiverseid': 630518}, {'name': 'Questing Druid // Cercare la Bestia', 'text': 'Ogniqualvolta lanci una magia bianca, blu, nera o rossa, metti un segnalino +1/+1 sul Druido dei Cimenti.', 'type': 'Creatura — Druido Umano', 'flavor': None, 'faceName': 'Questing Druid', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630779&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'f5c57ac5-83ba-42ba-827e-2c4a228b1044', 'multiverseId': 630779}, 'multiverseid': 630779}, {'name': 'Questing Druid // 獣（けもの）の探（たん）索（さく）', 'text': 'あなたが白や青や黒や赤である呪文１つを唱えるたび、探索するドルイドの上に＋１/＋１カウンター１個を置く。', 'type': 'クリーチャー — 人間・ドルイド', 'flavor': None, 'faceName': 'Questing Druid', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631040&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'dfcf25b0-a1a0-4e72-873c-136fd5aeb238', 'multiverseId': 631040}, 'multiverseid': 631040}, {'name': 'Questing Druid // Buscar a Fera', 'text': 'Toda vez que você conjurar uma mágica branca, azul, preta ou vermelha, coloque um marcador +1/+1 em Druida em Missão.', 'type': 'Criatura — Humano Druida', 'flavor': None, 'faceName': 'Questing Druid', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631301&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e9d6e458-e9b3-466b-91dc-b7b1968570a7', 'multiverseId': 631301}, 'multiverseid': 631301}, {'name': 'Questing Druid // 找寻野兽', 'text': '每当你施放白色，蓝色，黑色或红色咒语时，在追索德鲁伊上放置一个+1/+1指示物。', 'type': '生物 — 人类／德鲁伊', 'flavor': None, 'faceName': 'Questing Druid', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631562&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '2eeb72b0-33ff-4455-8248-8c9a64381568', 'multiverseId': 631562}, 'multiverseid': 631562}]", '[{\'name\': \'Rankels Streich\', \'text\': \'Bestimme eines oder mehrere —\\n• Jeder Spieler wirft zwei Karten ab.\\n• Jeder Spieler verliert 4 Lebenspunkte.\\n• Jeder Spieler opfert zwei Kreaturen.\', \'type\': \'Hexerei\', \'flavor\': \'Je lauter sie schreien, desto lauter lacht er.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629864&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e74139ee-5b19-4e3d-8402-9ef8e761921c\', \'multiverseId\': 629864}, \'multiverseid\': 629864}, {\'name\': \'Broma de Rankle\', \'text\': \'Elige uno o más:\\n• Cada jugador descarta dos cartas.\\n• Cada jugador pierde 4 vidas.\\n• Cada jugador sacrifica dos criaturas.\', \'type\': \'Conjuro\', \'flavor\': \'Cuanto más alto gritaban, con más ganas se reía.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630125&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a5cd069e-7247-47d7-bef2-2c0e301de04f\', \'multiverseId\': 630125}, \'multiverseid\': 630125}, {\'name\': \'Plaisanterie de Turlupin\', \'text\': "Choisissez l\'un ou plus —\\n• Chaque joueur se défausse de deux cartes.\\n• Chaque joueur perd 4 points de vie.\\n• Chaque joueur sacrifie deux créatures.", \'type\': \'Rituel\', \'flavor\': \'Plus ils hurlent, plus il rit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630386&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'129f1975-b478-4bd9-8eb7-34b020514e30\', \'multiverseId\': 630386}, \'multiverseid\': 630386}, {\'name\': \'Beffa di Rankle\', \'text\': \'Scegli uno o più —\\n• Ogni giocatore scarta due carte.\\n• Ogni giocatore perde 4 punti vita.\\n• Ogni giocatore sacrifica due creature.\', \'type\': \'Stregoneria\', \'flavor\': \'Più forti sono le loro urla, più sonore sono le sue risate.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630647&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dd5c17c6-a2de-4478-a8d5-3684f037909f\', \'multiverseId\': 630647}, \'multiverseid\': 630647}, {\'name\': \'ランクルのいたずら\', \'text\': \'以下から１つ以上を選ぶ。\\n・各プレイヤーはそれぞれカード２枚を捨てる。\\n・各プレイヤーはそれぞれ４点のライフを失う。\\n・各プレイヤーはそれぞれクリーチャー２体を生け贄に捧げる。\', \'type\': \'ソーサリー\', \'flavor\': \'悲鳴が大きいほど、彼は大笑いする。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630908&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7957e5af-c8dd-489c-93bd-52585620a0c1\', \'multiverseId\': 630908}, \'multiverseid\': 630908}, {\'name\': \'Traquinagem de Rankle\', \'text\': \'Escolha um ou mais —\\n• Cada jogador descarta dois cards.\\n• Cada jogador perde 4 pontos de vida.\\n• Cada jogador sacrifica duas criaturas.\', \'type\': \'Feitiço\', \'flavor\': \'Quanto mais alto eles gritam, mais ele ri.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631169&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6fdbbde8-509f-4a27-af8a-5faf36b232e7\', \'multiverseId\': 631169}, \'multiverseid\': 631169}, {\'name\': \'兰卡的恶戏\', \'text\': \'选择一项或多项～\\n•每位牌手各弃两张牌。\\n•每位牌手各失去4点生命。\\n•每位牌手各牺牲两个生物。\', \'type\': \'法术\', \'flavor\': \'受害者叫得越大声，他就笑得越开心。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631430&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2250b753-0263-4f2b-b182-47c985cdd85a\', \'multiverseId\': 631430}, \'multiverseid\': 631430}]', '[{\'name\': \'Rankels Streich\', \'text\': \'Bestimme eines oder mehrere —\\n• Jeder Spieler wirft zwei Karten ab.\\n• Jeder Spieler verliert 4 Lebenspunkte.\\n• Jeder Spieler opfert zwei Kreaturen.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631874&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'32ab9c4e-4ffa-40c9-90f3-3d1c84f1f1fa\', \'multiverseId\': 631874}, \'multiverseid\': 631874}, {\'name\': \'Plaisanterie de Turlupin\', \'text\': "Choisissez l\'un ou plus —\\n• Chaque joueur se défausse de deux cartes.\\n• Chaque joueur perd 4 points de vie.\\n• Chaque joueur sacrifie deux créatures.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631921&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d995b715-abce-4f55-91b8-a78bd34363cd\', \'multiverseId\': 631921}, \'multiverseid\': 631921}, {\'name\': \'ランクルのいたずら\', \'text\': \'以下から１つ以上を選ぶ。\\n・各プレイヤーはそれぞれカード２枚を捨てる。\\n・各プレイヤーはそれぞれ４点のライフを失う。\\n・各プレイヤーはそれぞれクリーチャー２体を生け贄に捧げる。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631968&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'776151e5-14d7-4e11-8c2e-393e034d362b\', \'multiverseId\': 631968}, \'multiverseid\': 631968}, {\'name\': \'兰卡的恶戏\', \'text\': \'选择一项或多项～\\n•每位牌手各弃两张牌。\\n•每位牌手各失去4点生命。\\n•每位牌手各牺牲两个生物。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632015&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8cc8ee6f-4154-4155-852b-95a0c539b2fd\', \'multiverseId\': 632015}, \'multiverseid\': 632015}]', '[{\'name\': \'Raserei der Hexenjäger\', \'text\': \'Dieser Zauberspruch kostet beim Wirken für jede Kreatur, die in diesem Zug angegriffen hat, {1} weniger.\\nDie Raserei der Hexenjäger fügt einer Kreatur deiner Wahl 5 Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'Die Hexenjäger umzingelten die gepanzerte Gestalt, angezogen vom verderbenden Gestank dunkler Magie. Kellan und Rubina ergriffen die Flucht und hörten in der Ferne wildes Geheul und zuschnappende Mäuler.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629921&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bba1dd52-84e8-4a6c-8a99-bbd57bedf34d\', \'multiverseId\': 629921}, \'multiverseid\': 629921}, {\'name\': \'Frenesí de los acechabrujas\', \'text\': \'Te cuesta {1} menos lanzar este hechizo por cada criatura que atacó este turno.\\nEl Frenesí de los acechabrujas hace 5 puntos de daño a la criatura objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'Atraídos por la pestilencia corruptora de la magia oscura, los acechabrujas rodearon a la figura con armadura. Kellan y Rubí huyeron ante el sonido de aullidos salvajes y mandíbulas batientes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630182&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6d56e720-46b3-40cd-8681-dc1f81e0fe54\', \'multiverseId\': 630182}, \'multiverseid\': 630182}, {\'name\': \'Frénésie du pisteur de sorcière\', \'text\': \'Ce sort coûte {1} de moins à lancer pour chaque créature qui a attaqué ce tour-ci.\\nLa Frénésie du pisteur de sorcière inflige 5 blessures à une créature ciblée.\', \'type\': \'Éphémère\', \'flavor\': "Les pisteurs de sorcière encerclèrent la silhouette en armure, attirés par la puanteur corruptrice de la magie noire. Kellan et Rubis s\'enfuirent lorsqu\'ils entendirent des hurlements sauvages et des claquements de mâchoires.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630443&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'04d578fe-707a-4c2c-b875-8c1b5f94b926\', \'multiverseId\': 630443}, \'multiverseid\': 630443}, {\'name\': \'Frenesia dei Braccastreghe\', \'text\': \'Questa magia costa {1} in meno per essere lanciata per ogni creatura che ha attaccato in questo turno.\\nLa Frenesia dei Braccastreghe infligge 5 danni a una creatura bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'I braccastreghe accerchiarono la figura in armatura, attirati dal fetore di corruzione e magia nera che emanava. Kellan e Rubinia fuggirono al suono di ululati selvaggi e schioccare di mascelle.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630704&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7207a726-376c-4a48-b935-d3d18414fcf6\', \'multiverseId\': 630704}, \'multiverseid\': 630704}, {\'name\': \'魔女跡追いの激情\', \'text\': \'この呪文を唱えるためのコストは、このターンに攻撃したクリーチャー１体につき{1}少なくなる。\\nクリーチャー１体を対象とする。魔女跡追いの激情はそれに５点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'暗黒の魔法の腐敗臭に誘われて魔女跡追いは武装した人物を取り囲んだ。野蛮な咆哮と嚙みつく顎の音を聞いたケランとルビーはその場から逃げた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630965&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2eb22733-2b96-4b93-922d-e53622f94211\', \'multiverseId\': 630965}, \'multiverseid\': 630965}, {\'name\': \'Frenesi do Farejador de Bruxa\', \'text\': \'Esta mágica custa {1} a menos para conjurar por cada criatura que tiver atacado neste turno.\\nFrenesi do Farejador de Bruxa causa 5 pontos de dano à criatura alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os farejadores de bruxa circundavam a figura em armadura, atraídos pelo miasma corruptor da magia sombria. Kellan e Rubi fugiram ao som de mordidas e uivos selvagens.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631226&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9b5559ad-f4ac-494b-8f0f-2eba7961c388\', \'multiverseId\': 631226}, \'multiverseid\': 631226}, {\'name\': \'猎巫狼狂乱\', \'text\': \'本回合中每有一个生物攻击过，此咒语便减少{1}来施放。\\n猎巫狼狂乱对目标生物造成5点伤害。\', \'type\': \'瞬间\', \'flavor\': \'猎巫狼群受黑暗魔法的腐化恶臭吸引，将披甲身影团团包围。随着蛮野嚎叫与断骨啮咬响声不断，凯澜和小红玉匆忙逃离这片危险之地。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631487&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0d4c6d47-f184-4a24-9b03-e62e414bd06b\', \'multiverseId\': 631487}, \'multiverseid\': 631487}]', '[{\'name\': \'Rastlose Bohnenranke\', \'text\': \'Die Rastlose Bohnenranke kommt getappt ins Spiel.\\n{T}: Erzeuge {G} oder {U}.\\n{3}{G}{U}: Die Rastlose Bohnenranke wird bis zum Ende des Zuges zu einer 5/5 grünen und blauen Pflanze-Kreatur, die Trampelschaden verursacht. Sie ist immer noch ein Land.\\nImmer wenn die Rastlose Bohnenranke angreift, hat bis zu eine andere Kreatur deiner Wahl Basis-Stärke und -Widerstandskraft 3/3 bis zum Ende des Zuges.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630023&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e5a18160-d0ab-4290-aa7f-27d2776072f2\', \'multiverseId\': 630023}, \'multiverseid\': 630023}, {\'name\': \'Tallo sin sosiego\', \'text\': \'El Tallo sin sosiego entra al campo de batalla girado.\\n{T}: Agrega {G} o {U}.\\n{3}{G}{U}: Hasta el final del turno, el Tallo sin sosiego se convierte en una criatura Planta verde y azul 5/5 con la habilidad de arrollar. Sigue siendo una tierra.\\nSiempre que el Tallo sin sosiego ataque, hasta una otra criatura objetivo tiene una fuerza y resistencia base de 3/3 hasta el final del turno.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630284&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'525d50a9-cead-4984-a331-09884846e757\', \'multiverseId\': 630284}, \'multiverseid\': 630284}, {\'name\': \'Tige de vigne tourmentée\', \'text\': "La Tige de vigne tourmentée arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {G} ou {U}.\\n{3}{G}{U} : Jusqu\'à la fin du tour, la Tige de vigne tourmentée devient une créature 5/5 verte et bleue Plante avec le piétinement. C\'est toujours un terrain.\\nÀ chaque fois que la Tige de vigne tourmentée attaque, jusqu\'à une autre créature ciblée a une force et une endurance de base de 3/3 jusqu\'à la fin du tour.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630545&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bdc0c0fb-3958-4122-ad87-8943af04d052\', \'multiverseId\': 630545}, \'multiverseid\': 630545}, {\'name\': \'Rampicante Irrequieto\', \'text\': "Il Rampicante Irrequieto entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {G} o {U}.\\n{3}{G}{U}: Fino alla fine del turno, il Rampicante Irrequieto diventa una creatura Pianta 5/5 verde e blu con travolgere. È ancora una terra.\\nOgniqualvolta il Rampicante Irrequieto attacca, fino a un\'altra creatura bersaglio ha forza e costituzione base 3/3 fino alla fine del turno.", \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630806&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'97962596-e6a2-4bef-83da-6cdba277f2be\', \'multiverseId\': 630806}, \'multiverseid\': 630806}, {\'name\': \'眠らずの蔓茎\', \'text\': \'眠らずの蔓茎はタップ状態で戦場に出る。\\n{T}：{G}か{U}を加える。\\n{3}{G}{U}：ターン終了時まで、眠らずの蔓茎はトランプルを持つ緑青の５/５の植物・クリーチャーになる。これは土地でもある。\\n眠らずの蔓茎が攻撃するたび、これでないクリーチャー最大１体を対象とする。ターン終了時まで、それの基本のパワーとタフネスは３/３になる。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631067&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'991fec68-a6db-4385-a317-fdd27c9f8440\', \'multiverseId\': 631067}, \'multiverseid\': 631067}, {\'name\': \'Vinhas Inquietas\', \'text\': \'Vinhas Inquietas entra no campo de batalha virada.\\n{T}: Adicione {G} ou {U}.\\n{3}{G}{U}: Até o final do turno, Vinhas Inquietas torna-se uma criatura Planta verde e azul 5/5 com atropelar. Ela ainda é um terreno.\\nToda vez que Vinhas Inquietas ataca, até uma outra criatura alvo tem poder e resistência básicos 3/3 até o final do turno.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631328&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cb0d20ce-5bea-4935-a5f1-e72b75903ef0\', \'multiverseId\': 631328}, \'multiverseid\': 631328}, {\'name\': \'不息蔓茎\', \'text\': \'不息蔓茎须横置进战场。\\n{T}：加{G}或{U}。\\n{3}{G}{U}：直到回合结束，不息蔓茎成为5/5，绿蓝双色，具践踏异能的植物生物。它仍然是地。\\n每当不息蔓茎攻击时，至多另一个目标生物的基础力量与防御力为3/3直到回合结束。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631589&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d67add37-7334-41ce-8ab7-ebe454c412d0\', \'multiverseId\': 631589}, \'multiverseid\': 631589}]', '[{\'name\': \'Rastlose Bohnenranke\', \'text\': \'Die Rastlose Bohnenranke kommt getappt ins Spiel.\\n{T}: Erzeuge {G} oder {U}.\\n{3}{G}{U}: Die Rastlose Bohnenranke wird bis zum Ende des Zuges zu einer 5/5 grünen und blauen Pflanze-Kreatur, die Trampelschaden verursacht. Sie ist immer noch ein Land.\\nImmer wenn die Rastlose Bohnenranke angreift, hat bis zu eine andere Kreatur deiner Wahl Basis-Stärke und -Widerstandskraft 3/3 bis zum Ende des Zuges.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631735&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3c170dea-45a2-44be-86cf-c6f7acc7e5e4\', \'multiverseId\': 631735}, \'multiverseid\': 631735}, {\'name\': \'Tallo sin sosiego\', \'text\': \'El Tallo sin sosiego entra al campo de batalla girado.\\n{T}: Agrega {G} o {U}.\\n{3}{G}{U}: Hasta el final del turno, el Tallo sin sosiego se convierte en una criatura Planta verde y azul 5/5 con la habilidad de arrollar. Sigue siendo una tierra.\\nSiempre que el Tallo sin sosiego ataque, hasta una otra criatura objetivo tiene una fuerza y resistencia base de 3/3 hasta el final del turno.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631744&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'211b3989-7fe6-4570-8e82-9627392ec58b\', \'multiverseId\': 631744}, \'multiverseid\': 631744}, {\'name\': \'Tige de vigne tourmentée\', \'text\': "La Tige de vigne tourmentée arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {G} ou {U}.\\n{3}{G}{U} : Jusqu\'à la fin du tour, la Tige de vigne tourmentée devient une créature 5/5 verte et bleue Plante avec le piétinement. C\'est toujours un terrain.\\nÀ chaque fois que la Tige de vigne tourmentée attaque, jusqu\'à une autre créature ciblée a une force et une endurance de base de 3/3 jusqu\'à la fin du tour.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631753&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'abac69a5-e3d6-474e-8850-f133539395f0\', \'multiverseId\': 631753}, \'multiverseid\': 631753}, {\'name\': \'Rampicante Irrequieto\', \'text\': "Il Rampicante Irrequieto entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {G} o {U}.\\n{3}{G}{U}: Fino alla fine del turno, il Rampicante Irrequieto diventa una creatura Pianta 5/5 verde e blu con travolgere. È ancora una terra.\\nOgniqualvolta il Rampicante Irrequieto attacca, fino a un\'altra creatura bersaglio ha forza e costituzione base 3/3 fino alla fine del turno.", \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631762&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ef7f5138-f5cc-4b71-aea4-aa68ebab159c\', \'multiverseId\': 631762}, \'multiverseid\': 631762}, {\'name\': \'眠らずの蔓茎\', \'text\': \'眠らずの蔓茎はタップ状態で戦場に出る。\\n{T}：{G}か{U}を加える。\\n{3}{G}{U}：ターン終了時まで、眠らずの蔓茎はトランプルを持つ緑青の５/５の植物・クリーチャーになる。これは土地でもある。\\n眠らずの蔓茎が攻撃するたび、これでないクリーチャー最大１体を対象とする。ターン終了時まで、それの基本のパワーとタフネスは３/３になる。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631771&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'afdcd57e-42dd-40e6-bdfa-08378946e72d\', \'multiverseId\': 631771}, \'multiverseid\': 631771}, {\'name\': \'Vinhas Inquietas\', \'text\': \'Vinhas Inquietas entra no campo de batalha virada.\\n{T}: Adicione {G} ou {U}.\\n{3}{G}{U}: Até o final do turno, Vinhas Inquietas torna-se uma criatura Planta verde e azul 5/5 com atropelar. Ela ainda é um terreno.\\nToda vez que Vinhas Inquietas ataca, até uma outra criatura alvo tem poder e resistência básicos 3/3 até o final do turno.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631780&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'514124eb-8ae1-4aae-8ee2-1ec0ae8910f0\', \'multiverseId\': 631780}, \'multiverseid\': 631780}, {\'name\': \'不息蔓茎\', \'text\': \'不息蔓茎须横置进战场。\\n{T}：加{G}或{U}。\\n{3}{G}{U}：直到回合结束，不息蔓茎成为5/5，绿蓝双色，具践踏异能的植物生物。它仍然是地。\\n每当不息蔓茎攻击时，至多另一个目标生物的基础力量与防御力为3/3直到回合结束。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631789&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9d4c1035-0de6-4d99-a86a-2e434c46c6e7\', \'multiverseId\': 631789}, \'multiverseid\': 631789}]', '[{\'name\': \'Rastlose Festung\', \'text\': \'Die Rastlose Festung kommt getappt ins Spiel.\\n{T}: Erzeuge {W} oder {B}.\\n{2}{W}{B}: Die Rastlose Festung wird bis zum Ende des Zuges zu einer 1/4 weißen und schwarzen Nachtmahr-Kreatur. Sie ist immer noch ein Land.\\nImmer wenn die Rastlose Festung angreift, verliert der verteidigende Spieler 2 Lebenspunkte und du erhältst 2 Lebenspunkte dazu.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630021&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'84170af8-bb46-4e25-8045-ab0850448f11\', \'multiverseId\': 630021}, \'multiverseid\': 630021}, {\'name\': \'Fortaleza sin sosiego\', \'text\': \'La Fortaleza sin sosiego entra al campo de batalla girada.\\n{T}: Agrega {W} o {B}.\\n{2}{W}{B}: La Fortaleza sin sosiego se convierte en una criatura Pesadilla blanca y negra 1/4 hasta el final del turno. Sigue siendo una tierra.\\nSiempre que la Fortaleza sin sosiego ataque, el jugador defensor pierde 2 vidas y tú ganas 2 vidas.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630282&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f0bc7259-02bc-4360-b152-a003950a39f8\', \'multiverseId\': 630282}, \'multiverseid\': 630282}, {\'name\': \'Forteresse tourmentée\', \'text\': "La Forteresse tourmentée arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {W} ou {B}.\\n{2}{W}{B} : La Forteresse tourmentée devient une créature 1/4 blanche et noire Cauchemar jusqu\'à la fin du tour. C\'est toujours un terrain.\\nÀ chaque fois que la Forteresse tourmentée attaque, le joueur défenseur perd 2 points de vie et vous gagnez 2 points de vie.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630543&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5582805b-b7e1-483d-80c0-aa359849f706\', \'multiverseId\': 630543}, \'multiverseid\': 630543}, {\'name\': \'Fortezza Irrequieta\', \'text\': \'La Fortezza Irrequieta entra nel campo di battaglia TAPpata.\\n{T}: Aggiungi {W} o {B}.\\n{2}{W}{B}: La Fortezza Irrequieta diventa una creatura Incubo 1/4 bianca e nera fino alla fine del turno. È ancora una terra.\\nOgniqualvolta la Fortezza Irrequieta attacca, il giocatore in difesa perde 2 punti vita e tu guadagni 2 punti vita.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630804&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'61b351d4-8816-4260-9d9a-571398df5e96\', \'multiverseId\': 630804}, \'multiverseid\': 630804}, {\'name\': \'眠らずの城塞\', \'text\': \'眠らずの城塞はタップ状態で戦場に出る。\\n{T}：{W}か{B}を加える。\\n{2}{W}{B}：ターン終了時まで、眠らずの城塞は白黒の１/４のナイトメア・クリーチャーになる。これは土地でもある。\\n眠らずの城塞が攻撃するたび、防御プレイヤーは２点のライフを失い、あなたは２点のライフを得る。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631065&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d4290826-abe1-41d6-b574-0a31bd694a5c\', \'multiverseId\': 631065}, \'multiverseid\': 631065}, {\'name\': \'Fortaleza Inquieta\', \'text\': \'Fortaleza Inquieta entra no campo de batalha virada.\\n{T}: Adicione {W} ou {B}.\\n{2}{W}{B}: Fortaleza Inquieta torna-se uma criatura Pesadelo branca e preta 1/4 até o final do turno. Ela ainda é um terreno.\\nToda vez que Fortaleza Inquieta ataca, o jogador defensor perde 2 pontos de vida e você ganha 2 pontos de vida.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631326&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e64566df-8d1c-4bb9-b11a-b85575f66d5a\', \'multiverseId\': 631326}, \'multiverseid\': 631326}, {\'name\': \'不息要塞\', \'text\': \'不息要塞须横置进战场。\\n{T}：加{W}或{B}。\\n{2}{W}{B}：不息要塞成为1/4，白黑双色的梦魇生物直到回合结束。它仍然是地。\\n每当不息要塞攻击时，防御牌手失去2点生命且你获得2点生命。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631587&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fc04e20e-30cf-41c2-ae9d-5de16ebcecc0\', \'multiverseId\': 631587}, \'multiverseid\': 631587}]', '[{\'name\': \'Rastlose Festung\', \'text\': \'Die Rastlose Festung kommt getappt ins Spiel.\\n{T}: Erzeuge {W} oder {B}.\\n{2}{W}{B}: Die Rastlose Festung wird bis zum Ende des Zuges zu einer 1/4 weißen und schwarzen Nachtmahr-Kreatur. Sie ist immer noch ein Land.\\nImmer wenn die Rastlose Festung angreift, verliert der verteidigende Spieler 2 Lebenspunkte und du erhältst 2 Lebenspunkte dazu.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631733&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e3406e54-09ac-4f3e-a907-adca9a18c1ca\', \'multiverseId\': 631733}, \'multiverseid\': 631733}, {\'name\': \'Fortaleza sin sosiego\', \'text\': \'La Fortaleza sin sosiego entra al campo de batalla girada.\\n{T}: Agrega {W} o {B}.\\n{2}{W}{B}: La Fortaleza sin sosiego se convierte en una criatura Pesadilla blanca y negra 1/4 hasta el final del turno. Sigue siendo una tierra.\\nSiempre que la Fortaleza sin sosiego ataque, el jugador defensor pierde 2 vidas y tú ganas 2 vidas.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631742&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'df74fca1-ebea-4c25-993c-1ae111622f70\', \'multiverseId\': 631742}, \'multiverseid\': 631742}, {\'name\': \'Forteresse tourmentée\', \'text\': "La Forteresse tourmentée arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {W} ou {B}.\\n{2}{W}{B} : La Forteresse tourmentée devient une créature 1/4 blanche et noire Cauchemar jusqu\'à la fin du tour. C\'est toujours un terrain.\\nÀ chaque fois que la Forteresse tourmentée attaque, le joueur défenseur perd 2 points de vie et vous gagnez 2 points de vie.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631751&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7a65a5c5-65e1-4b90-8346-27fc181ae355\', \'multiverseId\': 631751}, \'multiverseid\': 631751}, {\'name\': \'Fortezza Irrequieta\', \'text\': \'La Fortezza Irrequieta entra nel campo di battaglia TAPpata.\\n{T}: Aggiungi {W} o {B}.\\n{2}{W}{B}: La Fortezza Irrequieta diventa una creatura Incubo 1/4 bianca e nera fino alla fine del turno. È ancora una terra.\\nOgniqualvolta la Fortezza Irrequieta attacca, il giocatore in difesa perde 2 punti vita e tu guadagni 2 punti vita.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631760&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'32e77d08-f008-4932-ab81-a00d6da4cacc\', \'multiverseId\': 631760}, \'multiverseid\': 631760}, {\'name\': \'眠らずの城塞\', \'text\': \'眠らずの城塞はタップ状態で戦場に出る。\\n{T}：{W}か{B}を加える。\\n{2}{W}{B}：ターン終了時まで、眠らずの城塞は白黒の１/４のナイトメア・クリーチャーになる。これは土地でもある。\\n眠らずの城塞が攻撃するたび、防御プレイヤーは２点のライフを失い、あなたは２点のライフを得る。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631769&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eeaab1fb-8f84-4caf-ab4e-1e5cad184197\', \'multiverseId\': 631769}, \'multiverseid\': 631769}, {\'name\': \'Fortaleza Inquieta\', \'text\': \'Fortaleza Inquieta entra no campo de batalha virada.\\n{T}: Adicione {W} ou {B}.\\n{2}{W}{B}: Fortaleza Inquieta torna-se uma criatura Pesadelo branca e preta 1/4 até o final do turno. Ela ainda é um terreno.\\nToda vez que Fortaleza Inquieta ataca, o jogador defensor perde 2 pontos de vida e você ganha 2 pontos de vida.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631778&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'829fc76c-5fed-4361-8b18-b4496a0303ed\', \'multiverseId\': 631778}, \'multiverseid\': 631778}, {\'name\': \'不息要塞\', \'text\': \'不息要塞须横置进战场。\\n{T}：加{W}或{B}。\\n{2}{W}{B}：不息要塞成为1/4，白黑双色的梦魇生物直到回合结束。它仍然是地。\\n每当不息要塞攻击时，防御牌手失去2点生命且你获得2点生命。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631787&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'341a5145-666d-4d1e-9378-1b5029d23546\', \'multiverseId\': 631787}, \'multiverseid\': 631787}]', '[{\'name\': \'Rastloser Turm\', \'text\': \'Der Rastlose Turm kommt getappt ins Spiel.\\n{T}: Erzeuge {U} oder {R}.\\n{U}{R}: Der Rastlose Turm wird bis zum Ende des Zuges zu einer 2/1 blauen und roten Elementarwesen-Kreatur mit „Solange es dein Zug ist, hat diese Kreatur Erstschlag." Er ist immer noch ein Land.\\nImmer wenn der Rastlose Turm angreift, wende Hellsicht 1 an.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630022&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5097b4f8-f923-4d4b-880d-a589cc8ca16b\', \'multiverseId\': 630022}, \'multiverseid\': 630022}, {\'name\': \'Torre sin sosiego\', \'text\': \'La Torre sin sosiego entra al campo de batalla girada.\\n{T}: Agrega {U} o {R}.\\n{U}{R}: Hasta el final del turno, la Torre sin sosiego se convierte en una criatura Elemental azul y roja 2/1 con "Mientras sea tu turno, esta criatura tiene la habilidad de dañar primero". Sigue siendo una tierra.\\nSiempre que la Torre sin sosiego ataque, adivina 1.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630283&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b3cb99c4-72d4-45b2-94db-354205bf017f\', \'multiverseId\': 630283}, \'multiverseid\': 630283}, {\'name\': \'Tour tourmentée\', \'text\': "La Tour tourmentée arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {U} ou {R}.\\n{U}{R} : Jusqu\'à la fin du tour, la Tour tourmentée devient une créature 2/1 bleue et rouge Élémental avec « Tant que c\'est votre tour, cette créature a l\'initiative ». C\'est toujours un terrain.\\nÀ chaque fois que la Tour tourmentée attaque, regard 1.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630544&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6fb6da06-ec38-44ae-93b3-a7f7ce3615e5\', \'multiverseId\': 630544}, \'multiverseid\': 630544}, {\'name\': \'Guglia Irrequieta\', \'text\': \'La Guglia Irrequieta entra nel campo di battaglia TAPpata.\\n{T}: Aggiungi {U} o {R}.\\n{U}{R}: Fino alla fine del turno, la Guglia Irrequieta diventa una creatura Elementale 2/1 blu e rossa con "Fintanto che è il tuo turno, questa creatura ha attacco improvviso". È ancora una terra.\\nOgniqualvolta la Guglia Irrequieta attacca, profetizza 1.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630805&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d884c1af-812b-45ac-acb5-1bd338df7689\', \'multiverseId\': 630805}, \'multiverseid\': 630805}, {\'name\': \'眠らずの尖塔\', \'text\': \'眠らずの尖塔はタップ状態で戦場に出る。\\n{T}：{U}か{R}を加える。\\n{U}{R}：ターン終了時まで、眠らずの尖塔は「あなたのターンの間、このクリーチャーは先制攻撃を持つ。」を持つ青赤の２/１のエレメンタル・クリーチャーになる。これは土地でもある。\\n眠らずの尖塔が攻撃するたび、占術１を行う。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631066&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e8db32d2-1092-47df-b250-0e21e088bfe3\', \'multiverseId\': 631066}, \'multiverseid\': 631066}, {\'name\': \'Torre Inquieta\', \'text\': \'Torre Inquieta entra no campo de batalha virada.\\n{T}: Adicione {U} ou {R}.\\n{U}{R}: Até o final do turno, Torre Inquieta se torna uma criatura Elemental azul e vermelha 2/1 com "Enquanto for o seu turno, esta criatura terá iniciativa". Ela ainda é um terreno.\\nToda vez que Torre Inquieta atacar, use vidência 1.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631327&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'599e3cdc-2cb6-445d-9300-67aae4783660\', \'multiverseId\': 631327}, \'multiverseid\': 631327}, {\'name\': \'不息尖塔\', \'text\': \'不息尖塔须横置进战场。\\n{T}：加{U}或{R}。\\n{U}{R}：直到回合结束，不息尖塔成为2/1，蓝红双色的元素生物，且具有「只要是在你的回合中，此生物便具有先攻异能。」它仍然是地。\\n每当不息尖塔攻击时，占卜1。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631588&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'298114fb-196e-444a-a92c-9aeda9371517\', \'multiverseId\': 631588}, \'multiverseid\': 631588}]', '[{\'name\': \'Rastloser Turm\', \'text\': \'Der Rastlose Turm kommt getappt ins Spiel.\\n{T}: Erzeuge {U} oder {R}.\\n{U}{R}: Der Rastlose Turm wird bis zum Ende des Zuges zu einer 2/1 blauen und roten Elementarwesen-Kreatur mit „Solange es dein Zug ist, hat diese Kreatur Erstschlag." Er ist immer noch ein Land.\\nImmer wenn der Rastlose Turm angreift, wende Hellsicht 1 an.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631734&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8bfb070e-1d31-49cd-8ade-724aeaa755bc\', \'multiverseId\': 631734}, \'multiverseid\': 631734}, {\'name\': \'Torre sin sosiego\', \'text\': \'La Torre sin sosiego entra al campo de batalla girada.\\n{T}: Agrega {U} o {R}.\\n{U}{R}: Hasta el final del turno, la Torre sin sosiego se convierte en una criatura Elemental azul y roja 2/1 con "Mientras sea tu turno, esta criatura tiene la habilidad de dañar primero". Sigue siendo una tierra.\\nSiempre que la Torre sin sosiego ataque, adivina 1.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631743&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ecf1f2ef-5feb-4746-82fb-5160370b707c\', \'multiverseId\': 631743}, \'multiverseid\': 631743}, {\'name\': \'Tour tourmentée\', \'text\': "La Tour tourmentée arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {U} ou {R}.\\n{U}{R} : Jusqu\'à la fin du tour, la Tour tourmentée devient une créature 2/1 bleue et rouge Élémental avec « Tant que c\'est votre tour, cette créature a l\'initiative ». C\'est toujours un terrain.\\nÀ chaque fois que la Tour tourmentée attaque, regard 1.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631752&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'86948b7b-6943-46b4-a4df-dbf2e94ab06c\', \'multiverseId\': 631752}, \'multiverseid\': 631752}, {\'name\': \'Guglia Irrequieta\', \'text\': \'La Guglia Irrequieta entra nel campo di battaglia TAPpata.\\n{T}: Aggiungi {U} o {R}.\\n{U}{R}: Fino alla fine del turno, la Guglia Irrequieta diventa una creatura Elementale 2/1 blu e rossa con "Fintanto che è il tuo turno, questa creatura ha attacco improvviso". È ancora una terra.\\nOgniqualvolta la Guglia Irrequieta attacca, profetizza 1.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631761&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'81389af9-e6a5-4b28-82d8-1e2f1ab7497c\', \'multiverseId\': 631761}, \'multiverseid\': 631761}, {\'name\': \'眠らずの尖塔\', \'text\': \'眠らずの尖塔はタップ状態で戦場に出る。\\n{T}：{U}か{R}を加える。\\n{U}{R}：ターン終了時まで、眠らずの尖塔は「あなたのターンの間、このクリーチャーは先制攻撃を持つ。」を持つ青赤の２/１のエレメンタル・クリーチャーになる。これは土地でもある。\\n眠らずの尖塔が攻撃するたび、占術１を行う。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631770&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c4669155-6df6-4093-9ef6-65b8ba907d29\', \'multiverseId\': 631770}, \'multiverseid\': 631770}, {\'name\': \'Torre Inquieta\', \'text\': \'Torre Inquieta entra no campo de batalha virada.\\n{T}: Adicione {U} ou {R}.\\n{U}{R}: Até o final do turno, Torre Inquieta se torna uma criatura Elemental azul e vermelha 2/1 com "Enquanto for o seu turno, esta criatura terá iniciativa". Ela ainda é um terreno.\\nToda vez que Torre Inquieta atacar, use vidência 1.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631779&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d4176311-deaf-4e50-9812-26b9a4fd23a6\', \'multiverseId\': 631779}, \'multiverseid\': 631779}, {\'name\': \'不息尖塔\', \'text\': \'不息尖塔须横置进战场。\\n{T}：加{U}或{R}。\\n{U}{R}：直到回合结束，不息尖塔成为2/1，蓝红双色的元素生物，且具有「只要是在你的回合中，此生物便具有先攻异能。」它仍然是地。\\n每当不息尖塔攻击时，占卜1。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631788&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b73cc702-b00f-490c-9494-9fa63f4704be\', \'multiverseId\': 631788}, \'multiverseid\': 631788}]', '[{\'name\': \'Rastloses Biwak\', \'text\': \'Das Rastlose Biwak kommt getappt ins Spiel.\\n{T}: Erzeuge {R} oder {W}.\\n{1}{R}{W}: Das Rastlose Biwak wird bis zum Ende des Zuges zu einer 2/2 roten und weißen Ochse-Kreatur. Es ist immer noch ein Land.\\nImmer wenn das Rastlose Biwak angreift, lege eine +1/+1-Marke auf eine Kreatur deiner Wahl, die du kontrollierst.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630019&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a2737b88-1f90-4b0c-b59e-aeb7b2814a52\', \'multiverseId\': 630019}, \'multiverseid\': 630019}, {\'name\': \'Vivac sin sosiego\', \'text\': \'El Vivac sin sosiego entra al campo de batalla girado.\\n{T}: Agrega {R} o {W}.\\n{1}{R}{W}: El Vivac sin sosiego se convierte en una criatura Buey roja y blanca 2/2 hasta el final del turno. Sigue siendo una tierra.\\nSiempre que el Vivac sin sosiego ataque, pon un contador +1/+1 sobre la criatura objetivo que controlas.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630280&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b8ce3327-8fd0-40b7-8a70-69e7eb1e90de\', \'multiverseId\': 630280}, \'multiverseid\': 630280}, {\'name\': \'Bivouac tourmenté\', \'text\': "Le Bivouac tourmenté arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {R} ou {W}.\\n{1}{R}{W} : Le Bivouac tourmenté devient une créature 2/2 rouge et blanche Bovidé jusqu\'à la fin du tour. C\'est toujours un terrain.\\nÀ chaque fois que le Bivouac tourmenté attaque, mettez un marqueur +1/+1 sur une créature ciblée que vous contrôlez.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630541&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'52db8193-c957-4ffe-b15d-120eeae8f019\', \'multiverseId\': 630541}, \'multiverseid\': 630541}, {\'name\': \'Bivacco Irrequieto\', \'text\': \'Il Bivacco Irrequieto entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {R} o {W}.\\n{1}{R}{W}: Il Bivacco Irrequieto diventa una creatura Bue 2/2 rossa e bianca fino alla fine del turno. È ancora una terra.\\nOgniqualvolta il Bivacco Irrequieto attacca, metti un segnalino +1/+1 su una creatura bersaglio che controlli.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630802&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c7d3cc1c-f578-4447-8e21-c9516da475c1\', \'multiverseId\': 630802}, \'multiverseid\': 630802}, {\'name\': \'眠らずの露営\', \'text\': \'眠らずの露営はタップ状態で戦場に出る。\\n{T}：{R}か{W}を加える。\\n{1}{R}{W}：ターン終了時まで、眠らずの露営は赤白の２/２の雄牛・クリーチャーになる。これは土地でもある。\\n眠らずの露営が攻撃するたび、あなたがコントロールしているクリーチャー１体を対象とする。それの上に＋１/＋１カウンター１個を置く。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631063&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e0a376ca-4916-43fd-b8c8-30ea66ac0ed9\', \'multiverseId\': 631063}, \'multiverseid\': 631063}, {\'name\': \'Bivaque Inquieto\', \'text\': \'Bivaque Inquieto entra no campo de batalha virado.\\n{T}: Adicione {R} ou {W}.\\n{1}{R}{W}: Bivaque Inquieto torna-se uma criatura Boi vermelha e branca 2/2 até o final do turno. Ela ainda é um terreno.\\nToda vez que Bivaque Inquieto atacar, coloque um marcador +1/+1 na criatura alvo que você controla.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631324&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'22c5d611-36f8-411f-b24f-5a4099985e00\', \'multiverseId\': 631324}, \'multiverseid\': 631324}, {\'name\': \'不息营地\', \'text\': \'不息营地须横置进战场。\\n{T}：加{R}或{W}。\\n{1}{R}{W}：不息营地成为2/2，红白双色的牛生物直到回合结束。它仍然是地。\\n每当不息营地攻击时，在目标由你操控的生物上放置一个+1/+1指示物。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631585&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c53fdd28-867b-40ce-ba8a-04aa0e79c3db\', \'multiverseId\': 631585}, \'multiverseid\': 631585}]', '[{\'name\': \'Rastloses Biwak\', \'text\': \'Das Rastlose Biwak kommt getappt ins Spiel.\\n{T}: Erzeuge {R} oder {W}.\\n{1}{R}{W}: Das Rastlose Biwak wird bis zum Ende des Zuges zu einer 2/2 roten und weißen Ochse-Kreatur. Es ist immer noch ein Land.\\nImmer wenn das Rastlose Biwak angreift, lege eine +1/+1-Marke auf eine Kreatur deiner Wahl, die du kontrollierst.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631731&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c1d5740a-1b36-4eea-9b6c-3757655acaa8\', \'multiverseId\': 631731}, \'multiverseid\': 631731}, {\'name\': \'Vivac sin sosiego\', \'text\': \'El Vivac sin sosiego entra al campo de batalla girado.\\n{T}: Agrega {R} o {W}.\\n{1}{R}{W}: El Vivac sin sosiego se convierte en una criatura Buey roja y blanca 2/2 hasta el final del turno. Sigue siendo una tierra.\\nSiempre que el Vivac sin sosiego ataque, pon un contador +1/+1 sobre la criatura objetivo que controlas.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631740&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b0ca6f47-9b4f-425f-b60a-9e51811a13c5\', \'multiverseId\': 631740}, \'multiverseid\': 631740}, {\'name\': \'Bivouac tourmenté\', \'text\': "Le Bivouac tourmenté arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {R} ou {W}.\\n{1}{R}{W} : Le Bivouac tourmenté devient une créature 2/2 rouge et blanche Bovidé jusqu\'à la fin du tour. C\'est toujours un terrain.\\nÀ chaque fois que le Bivouac tourmenté attaque, mettez un marqueur +1/+1 sur une créature ciblée que vous contrôlez.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631749&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'44f2c5de-67b1-47d8-89d5-44cb9b7756e7\', \'multiverseId\': 631749}, \'multiverseid\': 631749}, {\'name\': \'Bivacco Irrequieto\', \'text\': \'Il Bivacco Irrequieto entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {R} o {W}.\\n{1}{R}{W}: Il Bivacco Irrequieto diventa una creatura Bue 2/2 rossa e bianca fino alla fine del turno. È ancora una terra.\\nOgniqualvolta il Bivacco Irrequieto attacca, metti un segnalino +1/+1 su una creatura bersaglio che controlli.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631758&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cf0282dc-ade9-4053-90d5-cf85583e1bab\', \'multiverseId\': 631758}, \'multiverseid\': 631758}, {\'name\': \'眠らずの露営\', \'text\': \'眠らずの露営はタップ状態で戦場に出る。\\n{T}：{R}か{W}を加える。\\n{1}{R}{W}：ターン終了時まで、眠らずの露営は赤白の２/２の雄牛・クリーチャーになる。これは土地でもある。\\n眠らずの露営が攻撃するたび、あなたがコントロールしているクリーチャー１体を対象とする。それの上に＋１/＋１カウンター１個を置く。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631767&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dce6f96a-59b0-49a4-b3ac-d8790890720d\', \'multiverseId\': 631767}, \'multiverseid\': 631767}, {\'name\': \'Bivaque Inquieto\', \'text\': \'Bivaque Inquieto entra no campo de batalha virado.\\n{T}: Adicione {R} ou {W}.\\n{1}{R}{W}: Bivaque Inquieto torna-se uma criatura Boi vermelha e branca 2/2 até o final do turno. Ela ainda é um terreno.\\nToda vez que Bivaque Inquieto atacar, coloque um marcador +1/+1 na criatura alvo que você controla.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631776&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'80a5c0ec-7ac5-423c-ab8d-18da349efeaf\', \'multiverseId\': 631776}, \'multiverseid\': 631776}, {\'name\': \'不息营地\', \'text\': \'不息营地须横置进战场。\\n{T}：加{R}或{W}。\\n{1}{R}{W}：不息营地成为2/2，红白双色的牛生物直到回合结束。它仍然是地。\\n每当不息营地攻击时，在目标由你操控的生物上放置一个+1/+1指示物。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631785&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2439788d-61a1-4a09-9354-6ac8a83ed573\', \'multiverseId\': 631785}, \'multiverseid\': 631785}]', '[{\'name\': \'Rastloses Häuschen\', \'text\': \'Das Rastlose Häuschen kommt getappt ins Spiel.\\n{T}: Erzeuge {B} oder {G}.\\n{2}{B}{G}: Das Rastlose Häuschen wird bis zum Ende des Zuges zu einer 4/4 schwarzen und grünen Schrecken-Kreatur. Es ist immer noch ein Land.\\nImmer wenn das Rastlose Häuschen angreift, erzeuge einen Speise-Spielstein und schicke bis zu eine Karte deiner Wahl aus einem Friedhof ins Exil.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630020&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d6372548-3392-4a9f-8a8f-9745cb95b993\', \'multiverseId\': 630020}, \'multiverseid\': 630020}, {\'name\': \'Cabaña sin sosiego\', \'text\': \'La Cabaña sin sosiego entra al campo de batalla girada.\\n{T}: Agrega {B} o {G}.\\n{2}{B}{G}: La Cabaña sin sosiego se convierte en una criatura Horror negra y verde 4/4 hasta el final del turno. Sigue siendo una tierra.\\nSiempre que la Cabaña sin sosiego ataque, crea una ficha de Comida y exilia hasta una carta objetivo de un cementerio.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630281&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7d162595-9173-45d5-a644-8bc4a9d7ff12\', \'multiverseId\': 630281}, \'multiverseid\': 630281}, {\'name\': \'Maisonnette tourmentée\', \'text\': "La Maisonnette tourmentée arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {B} ou {G}.\\n{2}{B}{G} : La Maisonnette tourmentée devient une créature 4/4 noire et verte Horreur jusqu\'à la fin du tour. C\'est toujours un terrain.\\nÀ chaque fois que la Maisonnette tourmentée attaque, créez un jeton Nourriture et exilez jusqu\'à une carte ciblée depuis un cimetière.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630542&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'773d4336-9331-4ee4-b260-f3cbb5895f23\', \'multiverseId\': 630542}, \'multiverseid\': 630542}, {\'name\': \'Capanna Irrequieta\', \'text\': \'La Capanna Irrequieta entra nel campo di battaglia TAPpata.\\n{T}: Aggiungi {B} o {G}.\\n{2}{B}{G}: La Capanna Irrequieta diventa una creatura Orrore 4/4 nera e verde fino alla fine del turno. È ancora una terra.\\nOgniqualvolta la Capanna Irrequieta attacca, crea una pedina Cibo ed esilia fino a una carta bersaglio da un cimitero.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630803&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'47b4237b-349f-4c9f-9f1b-5a4aaad72269\', \'multiverseId\': 630803}, \'multiverseid\': 630803}, {\'name\': \'眠らずの小屋\', \'text\': \'眠らずの小屋はタップ状態で戦場に出る。\\n{T}：{B}か{G}を加える。\\n{2}{B}{G}：ターン終了時まで、眠らずの小屋は黒緑の４/４のホラー・クリーチャーになる。これは土地でもある。\\n眠らずの小屋が攻撃するたび、墓地にあるカード最大１枚を対象とする。食物・トークン１つを生成し、その対象としたカードを追放する。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631064&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b241157f-f2ed-424c-bf02-b3b807476bd2\', \'multiverseId\': 631064}, \'multiverseid\': 631064}, {\'name\': \'Cabana Inquieta\', \'text\': \'Cabana Inquieta entra no campo de batalha virada.\\n{T}: Adicione {B} ou {G}.\\n{2}{B}{G}: Cabana Inquieta torna-se uma criatura Horror preta e verde 4/4 até o final do turno. Ela ainda é um terreno.\\nToda vez que Cabana Inquieta atacar, crie uma ficha de Comida e exile até um card alvo de um cemitério.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631325&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'76d966f6-91c7-4d1c-a25e-9c156a0da314\', \'multiverseId\': 631325}, \'multiverseid\': 631325}, {\'name\': \'不息小屋\', \'text\': \'不息小屋须横置进战场。\\n{T}：加{B}或{G}。\\n{2}{B}{G}：不息小屋成为4/4，黑绿双色的惊惧兽生物直到回合结束。它仍然是地。\\n每当不息小屋攻击时，派出一个食品衍生物，并将至多一张目标牌从坟墓场放逐。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631586&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'57829b40-bd04-465c-948e-1c42e5666cca\', \'multiverseId\': 631586}, \'multiverseid\': 631586}]', '[{\'name\': \'Rastloses Häuschen\', \'text\': \'Das Rastlose Häuschen kommt getappt ins Spiel.\\n{T}: Erzeuge {B} oder {G}.\\n{2}{B}{G}: Das Rastlose Häuschen wird bis zum Ende des Zuges zu einer 4/4 schwarzen und grünen Schrecken-Kreatur. Es ist immer noch ein Land.\\nImmer wenn das Rastlose Häuschen angreift, erzeuge einen Speise-Spielstein und schicke bis zu eine Karte deiner Wahl aus einem Friedhof ins Exil.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631732&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c97d69a8-c566-4ac8-ba52-e2fab563d0e9\', \'multiverseId\': 631732}, \'multiverseid\': 631732}, {\'name\': \'Cabaña sin sosiego\', \'text\': \'La Cabaña sin sosiego entra al campo de batalla girada.\\n{T}: Agrega {B} o {G}.\\n{2}{B}{G}: La Cabaña sin sosiego se convierte en una criatura Horror negra y verde 4/4 hasta el final del turno. Sigue siendo una tierra.\\nSiempre que la Cabaña sin sosiego ataque, crea una ficha de Comida y exilia hasta una carta objetivo de un cementerio.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631741&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'90e476b0-563a-4eab-8cb5-13a9dd5aa9f6\', \'multiverseId\': 631741}, \'multiverseid\': 631741}, {\'name\': \'Maisonnette tourmentée\', \'text\': "La Maisonnette tourmentée arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {B} ou {G}.\\n{2}{B}{G} : La Maisonnette tourmentée devient une créature 4/4 noire et verte Horreur jusqu\'à la fin du tour. C\'est toujours un terrain.\\nÀ chaque fois que la Maisonnette tourmentée attaque, créez un jeton Nourriture et exilez jusqu\'à une carte ciblée depuis un cimetière.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631750&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9b16cb20-4ec5-4334-a21b-76b210de9172\', \'multiverseId\': 631750}, \'multiverseid\': 631750}, {\'name\': \'Capanna Irrequieta\', \'text\': \'La Capanna Irrequieta entra nel campo di battaglia TAPpata.\\n{T}: Aggiungi {B} o {G}.\\n{2}{B}{G}: La Capanna Irrequieta diventa una creatura Orrore 4/4 nera e verde fino alla fine del turno. È ancora una terra.\\nOgniqualvolta la Capanna Irrequieta attacca, crea una pedina Cibo ed esilia fino a una carta bersaglio da un cimitero.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631759&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7095215b-141b-4ec2-a1df-fd1c4fc77780\', \'multiverseId\': 631759}, \'multiverseid\': 631759}, {\'name\': \'眠らずの小屋\', \'text\': \'眠らずの小屋はタップ状態で戦場に出る。\\n{T}：{B}か{G}を加える。\\n{2}{B}{G}：ターン終了時まで、眠らずの小屋は黒緑の４/４のホラー・クリーチャーになる。これは土地でもある。\\n眠らずの小屋が攻撃するたび、墓地にあるカード最大１枚を対象とする。食物・トークン１つを生成し、その対象としたカードを追放する。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631768&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'aa9d6b62-d886-46a3-a261-39139093050f\', \'multiverseId\': 631768}, \'multiverseid\': 631768}, {\'name\': \'Cabana Inquieta\', \'text\': \'Cabana Inquieta entra no campo de batalha virada.\\n{T}: Adicione {B} ou {G}.\\n{2}{B}{G}: Cabana Inquieta torna-se uma criatura Horror preta e verde 4/4 até o final do turno. Ela ainda é um terreno.\\nToda vez que Cabana Inquieta atacar, crie uma ficha de Comida e exile até um card alvo de um cemitério.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631777&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e51df9b0-06f6-4cdc-8de2-6b768bb0cbaa\', \'multiverseId\': 631777}, \'multiverseid\': 631777}, {\'name\': \'不息小屋\', \'text\': \'不息小屋须横置进战场。\\n{T}：加{B}或{G}。\\n{2}{B}{G}：不息小屋成为4/4，黑绿双色的惊惧兽生物直到回合结束。它仍然是地。\\n每当不息小屋攻击时，派出一个食品衍生物，并将至多一张目标牌从坟墓场放逐。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631786&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d7bdf30f-5ba6-40f9-a8fa-a4ae07440126\', \'multiverseId\': 631786}, \'multiverseid\': 631786}]', '[{\'name\': \'Ratcatcher Trainee // Schädlingsproblem\', \'text\': \'Solange es dein Zug ist, hat der Rattenfänger-Lehrling Erstschlag.\', \'type\': \'Kreatur — Mensch, Gesinde\', \'flavor\': \'„Wo kommen die nur immer wieder her?!"\', \'faceName\': \'Ratcatcher Trainee\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629906&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9d34ec42-51d2-4c1d-bc48-810e3b158bc4\', \'multiverseId\': 629906}, \'multiverseid\': 629906}, {\'name\': \'Ratcatcher Trainee // Plaga inesperada\', \'text\': \'Mientras sea tu turno, la Aprendiz de atraparratas tiene la habilidad de dañar primero.\', \'type\': \'Criatura — Plebeyo humano\', \'flavor\': \'"¡¿De dónde siguen saliendo?!".\', \'faceName\': \'Ratcatcher Trainee\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630167&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'36ad915f-71e0-4034-b068-38d4425b8931\', \'multiverseId\': 630167}, \'multiverseid\': 630167}, {\'name\': \'Ratcatcher Trainee // Problème de parasites\', \'text\': "Tant que c\'est votre tour, la Stagiaire chasseuse de rats a l\'initiative.", \'type\': \'Créature — humain et paysan\', \'flavor\': "« Mais d\'où sortent-ils tous comme ça ? »", \'faceName\': \'Ratcatcher Trainee\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630428&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dae52ab6-e77b-4101-ba7b-b7741b911fed\', \'multiverseId\': 630428}, \'multiverseid\': 630428}, {\'name\': \'Ratcatcher Trainee // Problema Pestifero\', \'text\': "Fintanto che è il tuo turno, l\'Apprendista Acchiapparatti ha attacco improvviso.", \'type\': \'Creatura — Popolano Umano\', \'flavor\': \'"Da dove continuano ad arrivare?!"\', \'faceName\': \'Ratcatcher Trainee\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630689&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8c264980-5a25-44f8-933c-f638f2ba0ff1\', \'multiverseId\': 630689}, \'multiverseid\': 630689}, {\'name\': \'Ratcatcher Trainee // 害（がい）獣（じゅう）被（ひ）害（がい）\', \'text\': \'あなたのターンの間、ネズミ捕りの見習いは先制攻撃を持つ。\', \'type\': \'クリーチャー — 人間・農民\', \'flavor\': \'「一体どこから湧いてくるんだ！？」\', \'faceName\': \'Ratcatcher Trainee\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630950&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'94c23cc4-e43c-43b7-8ef1-bd9c8aac56fc\', \'multiverseId\': 630950}, \'multiverseid\': 630950}, {\'name\': \'Ratcatcher Trainee // Problema com Pragas\', \'text\': \'Enquanto for o seu turno, Estagiária Caça-ratos terá iniciativa.\', \'type\': \'Criatura — Humano Plebeu\', \'flavor\': \'"De onde é que eles continuam vindo?"\', \'faceName\': \'Ratcatcher Trainee\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631211&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'04083266-fac5-4280-86d3-92059ff9622e\', \'multiverseId\': 631211}, \'multiverseid\': 631211}, {\'name\': \'Ratcatcher Trainee // 鼠害问题\', \'text\': \'只要是在你的回合中，捕鼠学员便具有先攻异能。\', \'type\': \'生物 — 人类／平民\', \'flavor\': \'「它们都是从哪不断冒出来的？！」\', \'faceName\': \'Ratcatcher Trainee\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631472&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ee8c3efb-3e0c-4737-971c-eb20fac28b91\', \'multiverseId\': 631472}, \'multiverseid\': 631472}]', '[{\'name\': \'Reichsversengender Höllendrache\', \'text\': \'Feilschen (Du kannst ein Artefakt, eine Verzauberung oder einen Spielstein opfern, sowie du diesen Zauberspruch wirkst.)\\nFliegend, Eile\\nWenn der Reichsversengende Höllendrache ins Spiel kommt und falls um ihn gefeilscht wurde, erzeuge vier Mana in einer beliebigen Kombination von Farben.\\n{1}{R}: Der Reichsversengende Höllendrache fügt einem Ziel deiner Wahl 1 Schadenspunkt zu.\', \'type\': \'Kreatur — Drache\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629907&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f6377c87-cd98-41ad-abba-1855f8cb15d4\', \'multiverseId\': 629907}, \'multiverseid\': 629907}, {\'name\': \'Engendro calcinador de reinos\', \'text\': \'Negociar. (Puedes sacrificar un artefacto, encantamiento o ficha al lanzar este hechizo.)\\nVuela, prisa.\\nCuando el Engendro calcinador de reinos entre al campo de batalla, si fue negociado, agrega cuatro manás de cualquier combinación de colores.\\n{1}{R}: El Engendro calcinador de reinos hace 1 punto de daño a cualquier objetivo.\', \'type\': \'Criatura — Dragón\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630168&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3d82e103-e04a-4e30-8628-dad27e68b3a0\', \'multiverseId\': 630168}, \'multiverseid\': 630168}, {\'name\': \'Escouflenfer brûleur de royaumes\', \'text\': "Négociation (Vous pouvez sacrifier un artefact, un enchantement ou un jeton au moment où vous lancez ce sort.)\\nVol, célérité\\nQuand l\'Escouflenfer brûleur de royaumes arrive sur le champ de bataille, s\'il a été négocié, ajoutez quatre manas de la combinaison de mana coloré de votre choix.\\n{1}{R} : L\'Escouflenfer brûleur de royaumes inflige 1 blessure à n\'importe quelle cible.", \'type\': \'Créature — dragon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630429&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8ea41fe7-d0d9-4678-a6b4-4615c3c600c3\', \'multiverseId\': 630429}, \'multiverseid\': 630429}, {\'name\': \'Nibbio Infernale Avvampareami\', \'text\': \'Negoziare (Puoi sacrificare un artefatto, un incantesimo o una pedina mentre lanci questa magia.)\\nVolare, rapidità\\nQuando il Nibbio Infernale Avvampareami entra nel campo di battaglia, se è stato negoziato, aggiungi quattro mana in qualsiasi combinazione di colori.\\n{1}{R}: Il Nibbio Infernale Avvampareami infligge 1 danno a un qualsiasi bersaglio.\', \'type\': \'Creatura — Drago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630690&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3b161dea-7ec9-4c0d-b6ba-e885ec0db60a\', \'multiverseId\': 630690}, \'multiverseid\': 630690}, {\'name\': \'王国焦がしのヘルカイト\', \'text\': \'協約（この呪文を唱えるに際し、アーティファクトやエンチャントやトークンのうち１つを生け贄に捧げてもよい。）\\n飛行、速攻\\n王国焦がしのヘルカイトが戦場に出たとき、これが協約されていた場合、望む色の組み合わせのマナ４点を加える。\\n{1}{R}：１つを対象とする。王国焦がしのヘルカイトはそれに１点のダメージを与える。\', \'type\': \'クリーチャー — ドラゴン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630951&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0623c52b-9fe7-4f3c-8b29-19418a94b819\', \'multiverseId\': 630951}, \'multiverseid\': 630951}, {\'name\': \'Dragão Avérneo Queima-reinos\', \'text\': \'Negociar (Você pode sacrificar um artefato, um encantamento ou uma ficha conforme conjura esta mágica.)\\nVoar, ímpeto\\nQuando Dragão Avérneo Queima-reinos entrar no campo de batalha, se ele tiver sido negociado, adicione quatro manas em qualquer combinação de cores.\\n{1}{R}: Dragão Avérneo Queima-reinos causa 1 ponto de dano a qualquer alvo.\', \'type\': \'Criatura — Dragão\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631212&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3a939e5c-568b-4eff-81ad-27a8980dc322\', \'multiverseId\': 631212}, \'multiverseid\': 631212}, {\'name\': \'炙境残虐者\', \'text\': \'加码（你施放此咒语时可以牺牲一个神器，结界或衍生物。）\\n飞行，敏捷\\n当炙境残虐者进战场时，若它已加码，则加四点法术力，其颜色组合由你选择。\\n{1}{R}：炙境残虐者对任意一个目标造成1点伤害。\', \'type\': \'生物 — 龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631473&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c5ab4272-e6d3-45f5-b22b-e5efe3c4cfa7\', \'multiverseId\': 631473}, \'multiverseid\': 631473}]', '[{\'name\': \'Reichsversengender Höllendrache\', \'text\': \'Feilschen\\nFliegend, Eile\\nWenn der Reichsversengende Höllendrache ins Spiel kommt und falls um ihn gefeilscht wurde, erzeuge vier Mana in einer beliebigen Kombination von Farben.\\n{1}{R}: Der Reichsversengende Höllendrache fügt einem Ziel deiner Wahl 1 Schadenspunkt zu.\', \'type\': \'Kreatur — Drache\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631883&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'93b081d8-c53a-4095-9e75-d34046b91d6a\', \'multiverseId\': 631883}, \'multiverseid\': 631883}, {\'name\': \'Escouflenfer brûleur de royaumes\', \'text\': "Négociation\\nVol, célérité\\nQuand l\'Escouflenfer brûleur de royaumes arrive sur le champ de bataille, s\'il a été négocié, ajoutez quatre manas de la combinaison de mana coloré de votre choix.\\n{1}{R} : L\'Escouflenfer brûleur de royaumes inflige 1 blessure à n\'importe quelle cible.", \'type\': \'Créature — dragon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631930&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'36184231-e6a7-4ac4-8638-a0f032139bc2\', \'multiverseId\': 631930}, \'multiverseid\': 631930}, {\'name\': \'王国焦がしのヘルカイト\', \'text\': \'協約\\n飛行、速攻\\n王国焦がしのヘルカイトが戦場に出たとき、これが協約されていた場合、望む色の組み合わせのマナ４点を加える。\\n{1}{R}：１つを対象とする。王国焦がしのヘルカイトはそれに１点のダメージを与える。\', \'type\': \'クリーチャー — ドラゴン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631977&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0d236eee-f9c3-48f7-b784-c59d0a2794d3\', \'multiverseId\': 631977}, \'multiverseid\': 631977}, {\'name\': \'炙境残虐者\', \'text\': \'加码\\n飞行，敏捷\\n当炙境残虐者进战场时，若它已加码，则加四点法术力，其颜色组合由你选择。\\n{1}{R}：炙境残虐者对任意一个目标造成1点伤害。\', \'type\': \'生物 — 龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632024&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8a8f8f58-9c33-4410-a35f-4a9c970e487d\', \'multiverseId\': 632024}, \'multiverseid\': 632024}]', '[{\'name\': \'Reise zum Feen-Hof\', \'text\': \'Ziehe drei Karten. Erzeuge einen 1/1 blauen Feenwesen-Kreaturenspielstein mit Flugfähigkeit und „Diese Kreatur kann nur fliegende Kreaturen blocken."\', \'type\': \'Hexerei\', \'flavor\': \'Kellan begab sich von seinem Dorf in eine seltsame Welt, in der Bäume juwelenartige Früchte trugen. Eine majestätische, unmenschliche Stimme hallte in seinen Ohren wider: „Sage mir, tapferer Held, bist du reinen Herzens?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629819&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ab40ef69-d708-41b5-8973-0bc8750af637\', \'multiverseId\': 629819}, \'multiverseid\': 629819}, {\'name\': \'Hacia la corte de las hadas\', \'text\': \'Roba tres cartas. Crea una ficha de criatura Hada azul 1/1 con la habilidad de volar y "Esta criatura solo puede bloquear criaturas con la habilidad de volar".\', \'type\': \'Conjuro\', \'flavor\': \'Kellan salió de su pueblo y se vio en un mundo extraño en el que de los árboles pendían frutas enjoyadas. Una voz majestuosa que no era humana resonó en sus oídos: "Dime, valiente héroe, ¿tienes un corazón honrado?".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630080&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9db9ab30-2366-403f-a8bd-803072ad8864\', \'multiverseId\': 630080}, \'multiverseid\': 630080}, {\'name\': \'À la cour des faes\', \'text\': \'Piochez trois cartes. Créez un jeton de créature 1/1 bleue Peuple fée avec le vol et « Cette créature ne peut bloquer que les créatures avec le vol. »\', \'type\': \'Rituel\', \'flavor\': \'Kellan quitta son village pour pénétrer dans un monde étrange où des fruits précieux poussaient sur les arbres. Une voix royale, inhumaine, résonna à ses oreilles : « Dis-moi, courageux héros, ton cœur est-il pur ? »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630341&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3cbcf81b-812e-4b58-a01e-9fc4460a2dff\', \'multiverseId\': 630341}, \'multiverseid\': 630341}, {\'name\': \'Nella Corte Fatata\', \'text\': \'Pesca tre carte. Crea una pedina creatura Spiritello 1/1 blu con volare e "Questa creatura può bloccare solo creature con volare".\', \'type\': \'Stregoneria\', \'flavor\': \'Kellan varcò i confini del suo villaggio per ritrovarsi in uno strano mondo, dove gli alberi davano frutto a gioielli. Una voce inumana e regale gli risuonò nelle orecchie: "Dimmi, intrepido eroe, è puro il tuo cuore?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630602&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fa89bc76-e221-473d-aac4-7cff2a88b3c5\', \'multiverseId\': 630602}, \'multiverseid\': 630602}, {\'name\': \'フェイの宮廷へ\', \'text\': \'カード３枚を引く。飛行と「このクリーチャーでは飛行を持つクリーチャーしかブロックできない。」を持つ青の１/１のフェアリー・クリーチャー・トークン１体を生成する。\', \'type\': \'ソーサリー\', \'flavor\': \'ケランは故郷の村を出て、宝石のような果物をつけた樹々が生い茂る不思議な世界に足を踏み入れた。人間のものとは思えない威厳にみちた声が彼の耳に響いた。「勇敢な英雄よ、そなたは正直な心の持ち主であるか？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630863&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c28ee8de-1ffe-43cb-ad92-e1086d253c94\', \'multiverseId\': 630863}, \'multiverseid\': 630863}, {\'name\': \'Para a Corte das Fadinas\', \'text\': \'Compre três cards. Crie uma ficha de criatura Fada azul 1/1 com voar e "Esta criatura só pode bloquear criaturas com voar".\', \'type\': \'Feitiço\', \'flavor\': \'Kellan saiu de sua vila e entrou num estranho mundo onde as árvores davam joias como frutos. Uma voz régia, inumana, soou em seus ouvidos: "Diz-me, bravo herói, tens um coração verdadeiro?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631124&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'691a15e7-9ccd-419e-8fd5-17e725c0163f\', \'multiverseId\': 631124}, \'multiverseid\': 631124}, {\'name\': \'亲探仙廷\', \'text\': \'抓三张牌。派出一个1/1蓝色仙灵衍生生物，且具有飞行与「此生物只能阻挡具飞行异能的生物。」\', \'type\': \'法术\', \'flavor\': \'凯澜刚走出村庄，正要踏入树上结满珍稀珠宝的奇异世界。此时，他耳畔响起一阵异族的庄严之声：「勇敢的英雄啊，告诉我，你是否真心闯荡？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631385&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'88e865e6-7c8b-4229-bcd5-e620a34a26a8\', \'multiverseId\': 631385}, \'multiverseid\': 631385}]', '[{\'name\': \'Retterin der Schlafenden\', \'text\': \'Wachsamkeit\\nImmer wenn eine Verzauberung, die du kontrollierst, aus dem Spiel auf einen Friedhof gelegt wird, lege eine +1/+1-Marke auf die Retterin der Schlafenden.\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': \'Selbst wenn sie im Schlummer verloren sind, träumen die Bürger von Ardenthal von einer unermüdlichen Beschützerin, die über ihre Heimat wacht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629790&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'844489ef-90bf-4640-8c54-c64116906aeb\', \'multiverseId\': 629790}, \'multiverseid\': 629790}, {\'name\': \'Salvadora de los durmientes\', \'text\': \'Vigilancia.\\nSiempre que un encantamiento que controlas vaya a un cementerio desde el campo de batalla, pon un contador +1/+1 sobre la Salvadora de los durmientes.\', \'type\': \'Criatura — Caballero humano\', \'flavor\': \'Aun perdidos en la somnolencia, los ciudadanos del Valle de Arden soñaban con una protectora incansable que vigilaba sus hogares.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630051&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7ace7042-11ff-4188-9d4c-c99950bf3e3d\', \'multiverseId\': 630051}, \'multiverseid\': 630051}, {\'name\': \'Sauveuse des endormis\', \'text\': "Vigilance\\nÀ chaque fois qu\'un enchantement que vous contrôlez est mis dans un cimetière depuis le champ de bataille, mettez un marqueur +1/+1 sur la Sauveuse des endormis.", \'type\': \'Créature — humain et chevalier\', \'flavor\': "Même perdus dans leur sommeil, les citoyens d\'Ardenval rêvent d\'un protecteur infatigable veillant sur leurs foyers.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630312&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d2d62448-c52f-41df-af98-3815fb127351\', \'multiverseId\': 630312}, \'multiverseid\': 630312}, {\'name\': \'Salvatrice dei Dormienti\', \'text\': \'Cautela\\nOgniqualvolta un incantesimo che controlli viene messo in un cimitero dal campo di battaglia, metti un segnalino +1/+1 sulla Salvatrice dei Dormienti.\', \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': \'Perduti nel loro sonno, i cittadini di Ardenvalle sognano una protettrice instancabile a veglia delle loro case.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630573&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'22f166a2-6216-45be-9d87-4b4b947a90a4\', \'multiverseId\': 630573}, \'multiverseid\': 630573}, {\'name\': \'眠りの救済者\', \'text\': \'警戒\\nあなたがコントロールしているエンチャント１つが戦場から墓地に置かれるたび、眠りの救済者の上に＋１/＋１カウンター１個を置く。\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': \'眠りの中でさえ、アーデンベイルの市民は休むことなく家々を守り続ける守護者の夢を見続けた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630834&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'54d9c279-dce7-4633-93c8-12186326e7d2\', \'multiverseId\': 630834}, \'multiverseid\': 630834}, {\'name\': \'Salvadora dos Dormentes\', \'text\': \'Vigilância\\nToda vez que um encantamento que você controla for colocado em um cemitério vindo do campo de batalha, coloque um marcador +1/+1 em Salvadora dos Dormentes.\', \'type\': \'Criatura — Humano Cavaleiro\', \'flavor\': \'Mesmo perdidos no sono, os cidadãos do Vale Arden sonham com uma protetora incansável de guarda, velando seus lares.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631095&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'64fc1f0e-fc4d-4aca-b2fe-786db36014e5\', \'multiverseId\': 631095}, \'multiverseid\': 631095}, {\'name\': \'迷睡者救星\', \'text\': \'警戒\\n每当一个由你操控的结界从战场进入坟墓场时，在迷睡者救星上放置一个+1/+1指示物。\', \'type\': \'生物 — 人类／骑士\', \'flavor\': \'纵使雅登瓦民众静眠不醒，他们仍会梦到一位保卫家园的不懈卫士。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631356&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'17f3d525-56f8-498e-aa90-079d898b6b9e\', \'multiverseId\': 631356}, \'multiverseid\': 631356}]', '[{\'name\': \'Ritter der Tauben\', \'text\': \'Immer wenn eine Verzauberung, die du kontrollierst, aus dem Spiel auf einen Friedhof gelegt wird, erzeuge einen 1/1 weißen Vogel-Kreaturenspielstein mit Flugfähigkeit.\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': \'So viele Vögel, und doch war die Luft ganz still und kein Gezwitscher war zu hören. Syr Damon fühlte, dass hier irgendetwas nicht stimmte, aber es war eine ferne Sorge, die ihm unwichtig erschien und bald vergessen war.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629781&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9ae11391-48e5-402c-8958-893958c6ef6d\', \'multiverseId\': 629781}, \'multiverseid\': 629781}, {\'name\': \'Caballero de las palomas\', \'text\': \'Siempre que un encantamiento que controlas vaya a un cementerio desde el campo de batalla, crea una ficha de criatura Ave blanca 1/1 con la habilidad de volar.\', \'type\': \'Criatura — Caballero humano\', \'flavor\': \'Tantas aves y, sin embargo, el aire estaba en calma y no se oía ningún canto. Parte de syr Damon sabía que algo no iba bien, pero fue una preocupación distante, insignificante y, en un instante, olvidada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630042&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'02956e01-86e2-4bfa-8aa2-5c899e758a71\', \'multiverseId\': 630042}, \'multiverseid\': 630042}, {\'name\': \'Chevalier des colombes\', \'text\': "À chaque fois qu\'un enchantement que vous contrôlez est mis dans un cimetière depuis le champ de bataille, créez un jeton de créature 1/1 blanche Oiseau avec le vol.", \'type\': \'Créature — humain et chevalier\', \'flavor\': "Il y avait tant d\'oiseaux, et cependant, on n\'entendait aucun chant et l\'air semblait immobile. Syr Damon sentait qu\'il se tramait quelque chose, mais ce n\'était qu\'une inquiétude lointaine sans importance qui fut vite oubliée.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630303&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b9bd69c7-c097-42d9-9710-ad1df9b5b00a\', \'multiverseId\': 630303}, \'multiverseid\': 630303}, {\'name\': \'Cavaliere delle Colombe\', \'text\': \'Ogniqualvolta un incantesimo che controlli viene messo in un cimitero dal campo di battaglia, crea una pedina creatura Uccello 1/1 bianca con volare.\', \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': "Gli uccelli affollavano il cielo, eppure l\'aria era immobile e scevra del loro canto. Parte di Syr Damon sapeva che qualcosa non andava, ma la preoccupazione era un pensiero lontano, di poco conto e presto dimenticato.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630564&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f70dcaac-d012-49ed-9e3b-1cc4810f1717\', \'multiverseId\': 630564}, \'multiverseid\': 630564}, {\'name\': \'鳩の騎士\', \'text\': \'あなたがコントロールしているエンチャント１つが戦場から墓地に置かれるたび、飛行を持つ白の１/１の鳥・クリーチャー・トークン１体を生成する。\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': \'空には多くの鳥が飛んでいたが静まり返っていて、さえずりのひとつも聞こえなかった。デイマン卿は異変を感じ取っていたものの、到底心配するほどのことでもない些細なことだ、とすぐに忘れてしまった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630825&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'487944d0-9175-45df-a33a-c2a95d9229a3\', \'multiverseId\': 630825}, \'multiverseid\': 630825}, {\'name\': \'Cavaleiro das Pombas\', \'text\': \'Toda vez que um encantamento que você controla for colocado em um cemitério vindo do campo de batalha, crie uma ficha de criatura Ave branca 1/1 com voar.\', \'type\': \'Criatura — Humano Cavaleiro\', \'flavor\': \'Tantas aves, mas ainda assim não havia nenhum canto no ar. Parte de Syr Damon sabia que havia algo de errado, mas era uma preocupação distante, que logo foi esquecida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631086&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f1c8da15-7e91-4adb-9c4f-521560cec254\', \'multiverseId\': 631086}, \'multiverseid\': 631086}, {\'name\': \'护鸽骑士\', \'text\': \'每当一个由你操控的结界从战场进入坟墓场时，派出一个1/1白色，具飞行异能的鸟衍生生物。\', \'type\': \'生物 — 人类／骑士\', \'flavor\': \'身边似有无数鸟影掠过，然而周遭始终静滞无声～尽管戴蒙爵士已觉事态有异，但这一无关忧虑很快便被抛诸脑后。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631347&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a3e692db-42b3-448e-82f4-0aa8973a17e5\', \'multiverseId\': 631347}, \'multiverseid\': 631347}]', '[{\'name\': \'Rotzahn-Ahnenforscher\', \'text\': \'Wenn der Rotzahn-Ahnenforscher ins Spiel kommt, erzeuge einen Königlich-Rolle-Spielstein, angelegt an eine andere Kreatur deiner Wahl, die du kontrollierst. (Falls du bereits eine andere daran angelegte Rolle kontrollierst, lege die alte Rolle auf den Friedhof. Die verzauberte Kreatur erhält +1/+1 und hat Abwehr {1}.)\', \'type\': \'Kreatur — Elf, Berater\', \'flavor\': \'Manche Stammbäume sind dorniger als andere.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629941&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'779a062c-b753-42db-928d-243fc00237aa\', \'multiverseId\': 629941}, \'multiverseid\': 629941}, {\'name\': \'Genealogista de Dienterrojo\', \'text\': \'Cuando el Genealogista de Dienterrojo entre al campo de batalla, crea una ficha de Papel de Majestad anexada a otra criatura objetivo que controlas. (Si controlas otro Papel sobre ella, pon ese en el cementerio. La criatura encantada obtiene +1/+1 y tiene la habilidad de rebatir {1}.)\', \'type\': \'Criatura — Consejero elfo\', \'flavor\': \'Algunos árboles genealógicos son más espinosos que otros.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630202&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'04947e86-72fd-4077-aac6-83b371b70ab5\', \'multiverseId\': 630202}, \'multiverseid\': 630202}, {\'name\': \'Généalogiste de Croc-rouge\', \'text\': \'Quand le Généalogiste de Croc-rouge arrive sur le champ de bataille, créez un jeton de rôle Royal attaché à une autre créature ciblée que vous contrôlez. (Si vous contrôlez un autre rôle sur elle, mettez-le au cimetière. La créature enchantée gagne +1/+1 et a parade {1}.)\', \'type\': \'Créature — elfe et conseiller\', \'flavor\': "Certains arbres généalogiques ont plus d\'épines que d\'autres.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630463&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ad922c44-e288-4b95-8e4f-82caa4778d95\', \'multiverseId\': 630463}, \'multiverseid\': 630463}, {\'name\': \'Genealogista di Zannarossa\', \'text\': "Quando il Genealogista di Zannarossa entra nel campo di battaglia, crea una pedina Ruolo Regale assegnata a un\'altra creatura bersaglio che controlli. (Se controlli un altro Ruolo assegnato a quella creatura, metti quel Ruolo nel cimitero. La creatura incantata prende +1/+1 e ha egida {1}.)", \'type\': \'Creatura — Consigliere Elfo\', \'flavor\': \'Alcuni alberi genealogici hanno più spine di altri.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630724&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'502d0479-8e59-44f3-95b5-777dac316957\', \'multiverseId\': 630724}, \'multiverseid\': 630724}, {\'name\': \'赤歯の系図学者\', \'text\': \'赤歯の系図学者が戦場に出たとき、あなたがコントロールしていてこれでないクリーチャー１体を対象とする。王族・役割・トークン１つをそれについた状態で生成する。（あなたがコントロールしている役割がすでにそれについていたなら、その役割を墓地に置く。エンチャントしているクリーチャーは＋１/＋１の修整を受け護法{1}を持つ。）\', \'type\': \'クリーチャー — エルフ・アドバイザー\', \'flavor\': \'他と比べて棘が多い系統樹もある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630985&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'15b1e3ae-f88b-435a-96f7-cc40fb0ec063\', \'multiverseId\': 630985}, \'multiverseid\': 630985}, {\'name\': \'Genealogista de Rubrodente\', \'text\': \'Quando Genealogista de Rubrodente entrar no campo de batalha, crie uma ficha de Papel de Real anexada a outra criatura alvo que você controla. (Se você controlar outro Papel nela, coloque aquele no cemitério. A criatura encantada recebe +1/+1 e tem salvaguarda {1}.)\', \'type\': \'Criatura — Elfo Conselheiro\', \'flavor\': \'Algumas árvores genealógicas são mais espinhosas que outras.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631246&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9d3bb3d4-a1e6-425b-88a2-3f47d3d18863\', \'multiverseId\': 631246}, \'multiverseid\': 631246}, {\'name\': \'赤牙砦编谱师\', \'text\': \'当赤牙砦编谱师进战场时，派出一个皇族角色衍生物，并贴附在另一个目标由你操控的生物上。（如果其上已有另一个你操控的角色，则将已有之角色置入坟墓场。所结附的生物得+1/+1且具有守护{1}。）\', \'type\': \'生物 — 妖精／参谋\', \'flavor\': \'有些族谱来得更棘手。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631507&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dfdf1749-bb9f-4dbb-898f-9b629efd90b4\', \'multiverseId\': 631507}, \'multiverseid\': 631507}]', '[{\'name\': \'Rotzahn-Vorhut\', \'text\': \'Verursacht Trampelschaden\\nImmer wenn eine Verzauberung unter deiner Kontrolle ins Spiel kommt, kannst du {2} bezahlen. Falls du dies tust, bringe die Rotzahn-Vorhut aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Kreatur — Elf, Krieger\', \'flavor\': \'„Tagsüber bin ich genauso tödlich."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629942&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0ab94859-7a90-4e32-a518-8cd3eee669c6\', \'multiverseId\': 629942}, \'multiverseid\': 629942}, {\'name\': \'Vanguardia de Dienterrojo\', \'text\': \'Arrolla.\\nSiempre que un encantamiento entre al campo de batalla bajo tu control, puedes pagar {2}. Si lo haces, regresa la Vanguardia de Dienterrojo de tu cementerio a tu mano.\', \'type\': \'Criatura — Guerrero elfo\', \'flavor\': \'"De día, soy igual de letal".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630203&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a2371370-0052-49e5-931b-257a8825783f\', \'multiverseId\': 630203}, \'multiverseid\': 630203}, {\'name\': \'Avant-garde de Croc-rouge\', \'text\': "Piétinement\\nÀ chaque fois qu\'un enchantement arrive sur le champ de bataille sous votre contrôle, vous pouvez payer {2}. Si vous faites ainsi, renvoyez l\'Avant-garde de Croc-rouge depuis votre cimetière dans votre main.", \'type\': \'Créature — elfe et guerrier\', \'flavor\': \'« Je suis tout aussi dangereux dans la journée. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630464&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'165e7915-df0f-498f-9156-dee729366700\', \'multiverseId\': 630464}, \'multiverseid\': 630464}, {\'name\': \'Avanguardia di Zannarossa\', \'text\': "Travolgere\\nOgniqualvolta un incantesimo entra nel campo di battaglia sotto il tuo controllo, puoi pagare {2}. Se lo fai, riprendi in mano l\'Avanguardia di Zannarossa dal tuo cimitero.", \'type\': \'Creatura — Guerriero Elfo\', \'flavor\': \'"Sono letale anche di giorno."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630725&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4e73e0f3-3dec-4eb3-ae6b-692416f915e9\', \'multiverseId\': 630725}, \'multiverseid\': 630725}, {\'name\': \'赤歯の先兵\', \'text\': \'トランプル\\nエンチャント１つがあなたのコントロール下で戦場に出るたび、{2}を支払ってもよい。そうしたなら、あなたの墓地にある赤歯の先兵をあなたの手札に戻す。\', \'type\': \'クリーチャー — エルフ・戦士\', \'flavor\': \'「私の狂暴さは昼夜ともに変わることはない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630986&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'076904b4-c462-47cf-869c-607851d00e83\', \'multiverseId\': 630986}, \'multiverseid\': 630986}, {\'name\': \'Vanguarda de Rubrodente\', \'text\': \'Atropelar\\nToda vez que um encantamento entra no campo de batalha sob seu controle, você pode pagar {2}. Se fizer isso, devolva Vanguarda de Rubrodente de seu cemitério para sua mão.\', \'type\': \'Criatura — Elfo Guerreiro\', \'flavor\': \'"Sou igualmente letal durante o dia."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631247&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b3334868-7d8f-4408-9314-77db7eb78028\', \'multiverseId\': 631247}, \'multiverseid\': 631247}, {\'name\': \'赤牙砦先锋\', \'text\': \'践踏\\n每当一个结界在你的操控下进战场时，你可以支付{2}。若你如此作，则将赤牙砦先锋从你的坟墓场移回你手上。\', \'type\': \'生物 — 妖精／战士\', \'flavor\': \'「我白天也一样致命。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631508&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d7313a6f-f151-46a7-b206-22bca3b5c051\', \'multiverseId\': 631508}, \'multiverseid\': 631508}]', '[{\'name\': \'Rowan, Kind des Krieges\', \'text\': \'Bedrohlich\\n{T}: Zaubersprüche, die du in diesem Zug wirkst und die rot und/oder schwarz sind, kosten beim Wirken {X} weniger, wobei X gleich der Anzahl an Lebenspunkten ist, die du in diesem Zug verloren hast. Aktiviere diese Fähigkeit wie eine Hexerei.\', \'type\': \'Legendäre Kreatur — Mensch, Zauberer\', \'flavor\': \'„Ich werde keinen weiteren Tag mit meinem Bruder am Verhandlungstisch verschwenden. Ich werde Eldraine selbst wiederaufbauen — wie früher, durch Stärke."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629973&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ee094065-3cd6-476e-8fd6-d2d93ae9f65a\', \'multiverseId\': 629973}, \'multiverseid\': 629973}, {\'name\': \'Rowan, hija de la guerra\', \'text\': \'Amenaza.\\n{T}: Te cuesta {X} menos lanzar hechizos que sean negros y/o rojos este turno, donde X es la cantidad de vidas que perdiste este turno. Activa esto solo como un conjuro.\', \'type\': \'Criatura legendaria — Hechicero humano\', \'flavor\': \'"Se acabaron los días agotadores en una mesa de negociaciones con mi hermano. Reconstruiré Eldraine yo misma a la vieja usanza: con poder".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630234&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'049859b2-6ee0-4e00-bb5f-64477349efbb\', \'multiverseId\': 630234}, \'multiverseid\': 630234}, {\'name\': \'Rowan, scion de la guerre\', \'text\': "Menace\\n{T} : Les sorts que vous lancez ce tour-ci qui sont noirs et/ou rouges coûtent {X} de moins à lancer, X étant le nombre de points de vie que vous avez perdus ce tour-ci. N\'activez que lorsque vous pourriez lancer un rituel.", \'type\': \'Créature légendaire — humain et sorcier\', \'flavor\': "« Finies les journées passées à dépérir autour d\'une table de négociation avec mon frère. Je vais reconstruire Eldraine moi-même... par la force, comme jadis. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630495&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'abd241e2-7c3f-44e4-9e0a-f537a97efbad\', \'multiverseId\': 630495}, \'multiverseid\': 630495}, {\'name\': \'Rowan, Erede della Guerra\', \'text\': \'Minacciare\\n{T}: Le magie che lanci in questo turno e che sono nere e/o rosse costano {X} in meno per essere lanciate, dove X è pari ai punti vita che hai perso in questo turno. Attiva solo come una stregoneria.\', \'type\': \'Creatura Leggendaria — Mago Umano\', \'flavor\': \'"Niente più giornate perse al tavolo dei negoziati con mio fratello. Ricostruirò Eldraine da sola, alla vecchia maniera: con il potere."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630756&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8cdfad45-92e4-4d5d-8277-233fc7ca814f\', \'multiverseId\': 630756}, \'multiverseid\': 630756}, {\'name\': \'戦争の世継ぎ、ローアン\', \'text\': \'威迫\\n{T}：このターン、あなたが黒や赤である呪文を唱えるためのコストは{X}少なくなる。Ｘは、このターンにあなたが失ったライフの合計に等しい。起動はソーサリーとしてのみ行う。\', \'type\': \'伝説のクリーチャー — 人間・ウィザード\', \'flavor\': \'「交渉の場でウィルと一緒に萎縮するのはもう終わり。エルドレインは私が立て直す。昔のように、力づくでね。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631017&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2e008bb5-12b9-4232-9688-b225e8c3e836\', \'multiverseId\': 631017}, \'multiverseid\': 631017}, {\'name\': \'Rowan, Herdeira da Guerra\', \'text\': \'Ameaçar\\n{T}: As mágicas que você conjura neste turno pretas e/ou vermelhas custam {X} a menos para conjurar, sendo X a quantidade de pontos de vida que você perdeu neste turno. Ative somente como um feitiço.\', \'type\': \'Criatura Lendária — Humano Mago\', \'flavor\': \'"Não vou passar mais um dia sequer definhando na mesa de negociações com meu irmão. Eu mesma vou reconstruir Eldraine. Do jeito antigo, com poder."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631278&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ed81d343-69b4-4fe6-8e89-10291c7935be\', \'multiverseId\': 631278}, \'multiverseid\': 631278}, {\'name\': \'尚武后裔萝婉\', \'text\': \'威慑\\n{T}：你本回合中施放的黑色和／或红色咒语减少{X}来施放，X为你本回合中失去过的生命数量。只能于法术时机起动。\', \'type\': \'传奇生物 — 人类／法术师\', \'flavor\': \'「我不会再在谈判桌前与我弟弟空耗时光。我要亲自重建艾卓～从旧法，凭武力。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631539&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5ce2eb7c-789f-432f-b074-6913c7105ab1\', \'multiverseId\': 631539}, \'multiverseid\': 631539}]', '[{\'name\': \'Rowan, Kind des Krieges\', \'text\': \'Bedrohlich\\n{T}: Zaubersprüche, die du in diesem Zug wirkst und die rot und/oder schwarz sind, kosten beim Wirken {X} weniger, wobei X gleich der Anzahl an Lebenspunkten ist, die du in diesem Zug verloren hast. Aktiviere diese Fähigkeit wie eine Hexerei.\', \'type\': \'Legendäre Kreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631728&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3e3398f7-9566-4a12-a3ec-c122119e27f9\', \'multiverseId\': 631728}, \'multiverseid\': 631728}, {\'name\': \'Rowan, hija de la guerra\', \'text\': \'Amenaza.\\n{T}: Te cuesta {X} menos lanzar hechizos que sean negros y/o rojos este turno, donde X es la cantidad de vidas que perdiste este turno. Activa esto solo como un conjuro.\', \'type\': \'Criatura legendaria — Hechicero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631737&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3da38021-cbba-43fa-80fb-ccceae6fde9c\', \'multiverseId\': 631737}, \'multiverseid\': 631737}, {\'name\': \'Rowan, scion de la guerre\', \'text\': "Menace\\n{T} : Les sorts que vous lancez ce tour-ci qui sont noirs et/ou rouges coûtent {X} de moins à lancer, X étant le nombre de points de vie que vous avez perdus ce tour-ci. N\'activez que lorsque vous pourriez lancer un rituel.", \'type\': \'Créature légendaire — humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631746&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'605b00d6-453e-4dd5-bc6c-ca0c0aabd29c\', \'multiverseId\': 631746}, \'multiverseid\': 631746}, {\'name\': \'Rowan, Erede della Guerra\', \'text\': \'Minacciare\\n{T}: Le magie che lanci in questo turno e che sono nere e/o rosse costano {X} in meno per essere lanciate, dove X è pari ai punti vita che hai perso in questo turno. Attiva solo come una stregoneria.\', \'type\': \'Creatura Leggendaria — Mago Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631755&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b49a0265-8d26-493a-a528-137856ef85b0\', \'multiverseId\': 631755}, \'multiverseid\': 631755}, {\'name\': \'戦争の世継ぎ、ローアン\', \'text\': \'威迫\\n{T}：このターン、あなたが黒や赤である呪文を唱えるためのコストは{X}少なくなる。Ｘは、このターンにあなたが失ったライフの合計に等しい。起動はソーサリーとしてのみ行う。\', \'type\': \'伝説のクリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631764&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d2d6cefc-9742-459c-a6cd-ed5a0fc6da18\', \'multiverseId\': 631764}, \'multiverseid\': 631764}, {\'name\': \'Rowan, Herdeira da Guerra\', \'text\': \'Ameaçar\\n{T}: As mágicas que você conjura neste turno pretas e/ou vermelhas custam {X} a menos para conjurar, sendo X a quantidade de pontos de vida que você perdeu neste turno. Ative somente como um feitiço.\', \'type\': \'Criatura Lendária — Humano Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631773&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'453f83f5-e303-4b8a-8cf9-b3add8b57fbe\', \'multiverseId\': 631773}, \'multiverseid\': 631773}, {\'name\': \'尚武后裔萝婉\', \'text\': \'威慑\\n{T}：你本回合中施放的黑色和／或红色咒语减少{X}来施放，X为你本回合中失去过的生命数量。只能于法术时机起动。\', \'type\': \'传奇生物 — 人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631782&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'00f9e82f-1505-4dbe-b6d4-bae16d6f8251\', \'multiverseId\': 631782}, \'multiverseid\': 631782}]', '[{\'name\': \'Rowans grimmige Suche\', \'text\': \'Feilschen (Du kannst ein Artefakt, eine Verzauberung oder einen Spielstein opfern, sowie du diesen Zauberspruch wirkst.)\\nFalls um diesen Zauberspruch gefeilscht wurde, schaue dir die obersten vier Karten deiner Bibliothek an, lege dann bis zu zwei davon in beliebiger Reihenfolge oben auf deine Bibliothek zurück und den Rest auf deinen Friedhof.\\nDu ziehst zwei Karten und verlierst 2 Lebenspunkte.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629866&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4d0c2de9-fa01-4628-bac0-8c3decd1c33e\', \'multiverseId\': 629866}, \'multiverseid\': 629866}, {\'name\': \'Búsqueda siniestra de Rowan\', \'text\': \'Negociar. (Puedes sacrificar un artefacto, encantamiento o ficha al lanzar este hechizo.)\\nSi este hechizo fue negociado, mira las cuatro primeras cartas de tu biblioteca. Luego, pon hasta dos de ellas en la parte superior de tu biblioteca en cualquier orden y pon el resto en tu cementerio.\\nRobas dos cartas y pierdes 2 vidas.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630127&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e0322160-3359-4cc8-b80f-a0ed6beacff0\', \'multiverseId\': 630127}, \'multiverseid\': 630127}, {\'name\': \'Sinistre recherche de Rowan\', \'text\': "Négociation (Vous pouvez sacrifier un artefact, un enchantement ou un jeton au moment où vous lancez ce sort.)\\nSi ce sort a été négocié, regardez les quatre cartes du dessus de votre bibliothèque, puis remettez jusqu\'à deux d\'entre elles au-dessus de votre bibliothèque dans l\'ordre de votre choix et le reste dans votre cimetière.\\nVous piochez deux cartes et vous perdez 2 points de vie.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630388&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c1f42944-e171-4a3e-8f21-2f4bb771c6ae\', \'multiverseId\': 630388}, \'multiverseid\': 630388}, {\'name\': \'La Tetra Ricerca di Rowan\', \'text\': \'Negoziare (Puoi sacrificare un artefatto, un incantesimo o una pedina mentre lanci questa magia.)\\nSe questa magia è stata negoziata, guarda le prime quattro carte del tuo grimorio, poi rimettine fino a due in cima al tuo grimorio in qualsiasi ordine e metti le altre nel tuo cimitero.\\nPeschi due carte e perdi 2 punti vita.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630649&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'566ef57f-f4b6-469a-ae21-5e30a4a0b7e4\', \'multiverseId\': 630649}, \'multiverseid\': 630649}, {\'name\': \'ローアンの陰惨な調査\', \'text\': \'協約（この呪文を唱えるに際し、アーティファクトやエンチャントやトークンのうち１つを生け贄に捧げてもよい。）\\nこの呪文が協約されていたなら、あなたのライブラリーの一番上にあるカード４枚を見る。その後、そのうち最大２枚をあなたのライブラリーの一番上に望む順番で戻し、残りをあなたの墓地に置く。\\nカード２枚を引き、２点のライフを失う。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630910&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ab6f48c4-7f1f-4876-8bc3-da1ed23973f9\', \'multiverseId\': 630910}, \'multiverseid\': 630910}, {\'name\': \'Busca Macabra de Rowan\', \'text\': \'Negociar (Você pode sacrificar um artefato, um encantamento ou uma ficha conforme conjura esta mágica.)\\nSe esta mágica tiver sido negociada, olhe os quatro cards do topo de seu grimório. Depois, coloque até dois deles no topo de seu grimório em qualquer ordem e o restante em seu cemitério.\\nVocê compra dois cards e perde 2 pontos de vida.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631171&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'92258dca-c84c-4340-b57c-aa1837e9ad83\', \'multiverseId\': 631171}, \'multiverseid\': 631171}, {\'name\': \'萝婉苦探\', \'text\': \'加码（你施放此咒语时可以牺牲一个神器，结界或衍生物。）\\n如果此咒语已加码，则检视你牌库顶的四张牌，然后将其中至多两张以任意顺序放回你牌库顶，其余则置入你的坟墓场。\\n你抓两张牌且失去2点生命。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631432&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dcd67e90-ad46-4111-91d6-d80556f6e489\', \'multiverseId\': 631432}, \'multiverseid\': 631432}]', '[{\'name\': \'Rubina, wagemutige Spurensucherin\', \'text\': \'Eile\\nImmer wenn Rubina, wagemutige Spurensucherin, angreift, während du eine Kreatur mit Stärke 4 oder mehr kontrollierst, erhält Rubina +2/+2 bis zum Ende des Zuges.\\n{T}: Erzeuge {R} oder {G}.\', \'type\': \'Legendäre Kreatur — Mensch, Späher\', \'flavor\': \'Weder die schärfsten Dornen noch die übelsten Bestien würden sie davon abhalten, ihren Bruder zu finden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629974&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c7c17975-a2c8-44dc-b830-752289b1c95f\', \'multiverseId\': 629974}, \'multiverseid\': 629974}, {\'name\': \'Rubí, rastreadora temeraria\', \'text\': \'Prisa.\\nSiempre que Rubí, rastreadora temeraria ataque mientras controlas una criatura con fuerza de 4 o más, Rubí obtiene +2/+2 hasta el final del turno.\\n{T}: Agrega {R} o {G}.\', \'type\': \'Criatura legendaria — Explorador humano\', \'flavor\': \'Ni las espinas más punzantes ni las bestias más repugnantes le impedirían encontrar a su hermano.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630235&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'10e9aa31-0c41-4bcd-89ef-96af3f7a522f\', \'multiverseId\': 630235}, \'multiverseid\': 630235}, {\'name\': \'Rubis, traqueuse audacieuse\', \'text\': "Célérité\\nÀ chaque fois que Rubis, traqueuse audacieuse attaque pendant que vous contrôlez une créature de force supérieure ou égale à 4, Rubis gagne +2/+2 jusqu\'à la fin du tour.\\n{T} : Ajoutez {R} ou {G}.", \'type\': \'Créature légendaire — humain et éclaireur\', \'flavor\': "Les épines les plus piquantes et les bêtes les plus viles ne l\'empêcheraient pas de retrouver son frère.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630496&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'94bb44f5-41e0-4156-a1de-47980b21086e\', \'multiverseId\': 630496}, \'multiverseid\': 630496}, {\'name\': \'Rubinia, Battipista Audace\', \'text\': \'Rapidità\\nOgniqualvolta Rubinia, Battipista Audace attacca mentre controlli una creatura con forza pari o superiore a 4, Rubinia prende +2/+2 fino alla fine del turno.\\n{T}: Aggiungi {R} o {G}.\', \'type\': \'Creatura Leggendaria — Esploratore Umano\', \'flavor\': \'Né le spine più acuminate né le bestie più feroci le avrebbero impedito di trovare suo fratello.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630757&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'51cf3b4d-b801-4ddc-9160-3cee44bfc3db\', \'multiverseId\': 630757}, \'multiverseid\': 630757}, {\'name\': \'勇敢な追跡者、ルビー\', \'text\': \'速攻\\nあなたがパワーが４以上であるクリーチャーをコントロールしていて勇敢な追跡者、ルビーが攻撃するたび、ターン終了時まで、勇敢な追跡者、ルビーは＋２/＋２の修整を受ける。\\n{T}：{R}か{G}を加える。\', \'type\': \'伝説のクリーチャー — 人間・スカウト\', \'flavor\': \'どんなに茨が鋭くても、どんな汚らわしい獣が襲ってきたとしても、彼女を止められるものは何もなかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631018&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'be15a4f8-f533-413d-94d2-eb226d65b15d\', \'multiverseId\': 631018}, \'multiverseid\': 631018}, {\'name\': \'Rubi, Rastreadora Ousada\', \'text\': \'Ímpeto\\nToda vez que Rubi, Rastreadora Ousada, ataca enquanto você controla uma criatura com poder igual ou superior a 4, Rubi recebe +2/+2 até o final do turno.\\n{T}: Adicione {R} ou {G}.\', \'type\': \'Criatura Lendária — Humano Batedor\', \'flavor\': \'Nem os espinhos mais afiados, nem as feras mais terríveis a impediriam de encontrar seu irmão.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631279&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f5288398-8296-4e59-9701-85ac21ae7743\', \'multiverseId\': 631279}, \'multiverseid\': 631279}, {\'name\': \'大胆追迹人小红玉\', \'text\': \'敏捷\\n每当大胆追迹人小红玉于你操控力量等于或大于4的生物时攻击，小红玉得+2/+2直到回合结束。\\n{T}：加{R}或{G}。\', \'type\': \'传奇生物 — 人类／斥候\', \'flavor\': \'无论荆棘有多锋利，野兽有多凶险，都挡不住她找寻哥哥的脚步。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631540&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ec01fe34-98a5-43bc-832e-f1c17deac12e\', \'multiverseId\': 631540}, \'multiverseid\': 631540}]', '[{\'name\': \'Rudel aus Wallstädt\', \'text\': \'Bedrohlich (Diese Kreatur kann nicht geblockt werden, außer von zwei oder mehr Kreaturen.)\\nWenn das Rudel aus Wallstädt ins Spiel kommt, erzeuge einen 1/1 schwarzen Ratte-Kreaturenspielstein mit „Diese Kreatur kann nicht blocken."\', \'type\': \'Kreatur — Hund\', \'flavor\': \'Der Bürgermeister ließ die Hunde los, um Baron Wusel aufzuspüren, aber es bedurfte nur weniger Knochen, um ihre Treue zu erkaufen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629888&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4f6d2919-f52e-40cc-b793-680173149c18\', \'multiverseId\': 629888}, \'multiverseid\': 629888}, {\'name\': \'Jauría de Extremuro\', \'text\': \'Amenaza. (Esta criatura no puede ser bloqueada excepto por dos o más criaturas.)\\nCuando la Jauría de Extremuro entre al campo de batalla, crea una ficha de criatura Rata negra 1/1 con "Esta criatura no puede bloquear".\', \'type\': \'Criatura — Perro\', \'flavor\': \'El alcalde envió perros para acabar con el señor Escurridizo, pero este compró su lealtad fácilmente con un puñado de huesos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630149&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4fb4222e-a6b9-48b4-b8bb-af34996dee27\', \'multiverseId\': 630149}, \'multiverseid\': 630149}, {\'name\': \'Meute de Bornemur\', \'text\': \'Menace (Cette créature ne peut pas être bloquée excepté par deux créatures ou plus.)\\nQuand la Meute de Bornemur arrive sur le champ de bataille, créez un jeton de créature 1/1 noire Rat avec « Cette créature ne peut pas bloquer. »\', \'type\': \'Créature — chien\', \'flavor\': \'Le maire envoya des chiens aux trousses de Seigneur Grouilleur, mais il suffit de quelques os pour acheter leur loyauté.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630410&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'59a776e4-ff1c-4984-8c27-eaebe3f1e386\', \'multiverseId\': 630410}, \'multiverseid\': 630410}, {\'name\': \'Branco di Estremuro\', \'text\': \'Minacciare (Questa creatura non può essere bloccata tranne che da due o più creature.)\\nQuando il Branco di Estremuro entra nel campo di battaglia, crea una pedina creatura Ratto 1/1 nera con "Questa creatura non può bloccare".\', \'type\': \'Creatura — Canide\', \'flavor\': \'Il sindaco inviò i segugi a stanare Lord Squittio, me la loro fedeltà fu facilmente comprata con una manciata di ossi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630671&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7f765991-a15d-4684-8a34-a2693e54ac0c\', \'multiverseId\': 630671}, \'multiverseid\': 630671}, {\'name\': \'エッジウォールの群れ\', \'text\': \'威迫（このクリーチャーは２体以上のクリーチャーにしかブロックされない。）\\nエッジウォールの群れが戦場に出たとき、「このクリーチャーではブロックできない。」を持つ黒の１/１のネズミ・クリーチャー・トークン１体を生成する。\', \'type\': \'クリーチャー — 犬\', \'flavor\': \'市長は駆け抜け侯をあぶり出すために数多くの犬を放ったが、その忠誠心はわずかな骨でいとも容易く買収されてしまった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630932&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'664320a0-44be-41ed-8c8c-3f6644839596\', \'multiverseId\': 630932}, \'multiverseid\': 630932}, {\'name\': \'Matilha de Beiramuro\', \'text\': \'Ameaçar (Esta criatura só pode ser bloqueada por duas ou mais criaturas.)\\nQuando Matilha de Beiramuro entrar no campo de batalha, crie uma ficha de criatura Rato preta 1/1 com "Esta criatura não pode bloquear".\', \'type\': \'Criatura — Cão\', \'flavor\': \'O prefeito enviou sabujos para acabar com o Lorde Esgueiro, mas a lealdade deles foi facilmente comprada com um punhado de ossos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631193&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d339da4e-64ef-4976-acc6-7a7f1d9c9702\', \'multiverseId\': 631193}, \'multiverseid\': 631193}, {\'name\': \'边墙镇犬群\', \'text\': \'威慑（此生物只能被两个或更多生物阻挡。）\\n当边墙镇犬群进战场时，派出一个1/1黑色老鼠衍生生物，且具有「此生物不能进行阻挡。」\', \'type\': \'生物 — 狗\', \'flavor\': \'镇长派出成群猎犬去除掉捷敏王，但后者只用一把骨头就俘获了它们的忠心。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631454&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f0db8742-c835-45f7-a874-6729d79c4e0a\', \'multiverseId\': 631454}, \'multiverseid\': 631454}]', '[{\'name\': \'Ruppige Drillinge\', \'text\': \'Verursacht Trampelschaden\\nWenn die Ruppigen Drillinge ins Spiel kommen und falls sie kein Spielstein sind, erzeuge zwei Spielsteine, die Kopien von ihnen sind.\\nWenn die Ruppigen Drillinge sterben, lege auf jede Kreatur namens Ruppige Drillinge, die du kontrollierst, so viele +1/+1-Marken, wie ihre Stärke beträgt.\', \'type\': \'Kreatur — Satyr, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629934&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7f42ea6c-6c54-4eb9-ac9e-a0d2ac54a4ec\', \'multiverseId\': 629934}, \'multiverseid\': 629934}, {\'name\': \'Trillizos ariscos\', \'text\': \'Arrolla.\\nCuando los Trillizos ariscos entren al campo de batalla, si no son una ficha, crea dos fichas que son copias de ellos.\\nCuando los Trillizos ariscos mueran, pon una cantidad de contadores +1/+1 igual a su fuerza sobre cada criatura que controlas llamada Trillizos ariscos.\', \'type\': \'Criatura — Guerrero sátiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630195&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'03e7566b-bc79-486b-9188-ee9f23d88b4d\', \'multiverseId\': 630195}, \'multiverseid\': 630195}, {\'name\': \'Triplés bourrus\', \'text\': "Piétinement\\nQuand les Triplés bourrus arrivent sur le champ de bataille, s\'ils ne sont pas un jeton, créez deux jetons qui en sont des copies.\\nQuand les Triplés bourrus meurent, mettez un nombre de marqueurs +1/+1 égal à leur force sur chaque créature que vous contrôlez appelée Triplés bourrus.", \'type\': \'Créature — satyre et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630456&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5ddf59a0-f82b-4516-bee9-6250a848e7c0\', \'multiverseId\': 630456}, \'multiverseid\': 630456}, {\'name\': \'Trio Esuberante\', \'text\': \'Travolgere\\nQuando il Trio Esuberante entra nel campo di battaglia, se non è una pedina, crea due pedine che sono sue copie.\\nQuando il Trio Esuberante muore, metti un numero di segnalini +1/+1 pari alla sua forza su ogni creatura che controlli chiamata Trio Esuberante.\', \'type\': \'Creatura — Guerriero Satiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630717&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'550e769d-95e6-43bc-8438-1a716c4d54fe\', \'multiverseId\': 630717}, \'multiverseid\': 630717}, {\'name\': \'荒々しい三つ子\', \'text\': \'トランプル\\n荒々しい三つ子が戦場に出たとき、これがトークンでない場合、これのコピーであるトークン２つを生成する。\\n荒々しい三つ子が死亡したとき、あなたがコントロールしていて「荒々しい三つ子」という名前の各クリーチャーの上にそれぞれ、これのパワーに等しい個数の＋１/＋１カウンターを置く。\', \'type\': \'クリーチャー — サテュロス・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630978&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3b9cddf9-926c-4cf0-ae46-f0cf3c49d366\', \'multiverseId\': 630978}, \'multiverseid\': 630978}, {\'name\': \'Trigêmeos Rudes\', \'text\': \'Atropelar\\nQuando Trigêmeos Rudes entrar no campo de batalha, se ele não for uma ficha, crie duas fichas que sejam cópias dele.\\nQuando Trigêmeos Rudes morrer, coloque em cada criatura que você controla com o nome Trigêmeos Rudes um número de marcadores +1/+1 igual ao poder dele.\', \'type\': \'Criatura — Sátiro Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631239&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'078bf2e9-ca5e-4cd0-9772-5896352442ab\', \'multiverseId\': 631239}, \'multiverseid\': 631239}, {\'name\': \'粗野三人众\', \'text\': \'践踏\\n当粗野三人众进战场时，若它不是衍生物，则派出两个为其复制品的衍生物。\\n当粗野三人众死去时，在每个由你操控且名称为粗野三人众的生物上各放置若干+1/+1指示物，其数量等同于死去者的力量。\', \'type\': \'生物 — 羊蹄人／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631500&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'66e8fe1d-9325-4b3d-865d-49b4b6f6c96a\', \'multiverseId\': 631500}, \'multiverseid\': 631500}]', '[{\'name\': \'Ruppige Drillinge\', \'text\': \'Verursacht Trampelschaden\\nWenn die Ruppigen Drillinge ins Spiel kommen und falls sie kein Spielstein sind, erzeuge zwei Spielsteine, die Kopien von ihnen sind.\\nWenn die Ruppigen Drillinge sterben, lege auf jede Kreatur namens Ruppige Drillinge, die du kontrollierst, so viele +1/+1-Marken, wie ihre Stärke beträgt.\', \'type\': \'Kreatur — Satyr, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631890&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e2aa2ad5-4c3f-49e5-a70a-25c1f3ad4e2e\', \'multiverseId\': 631890}, \'multiverseid\': 631890}, {\'name\': \'Triplés bourrus\', \'text\': "Piétinement\\nQuand les Triplés bourrus arrivent sur le champ de bataille, s\'ils ne sont pas un jeton, créez deux jetons qui en sont des copies.\\nQuand les Triplés bourrus meurent, mettez un nombre de marqueurs +1/+1 égal à leur force sur chaque créature que vous contrôlez appelée Triplés bourrus.", \'type\': \'Créature — satyre et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631937&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dd9c27b5-c71e-411c-9360-9531f62c3198\', \'multiverseId\': 631937}, \'multiverseid\': 631937}, {\'name\': \'荒々しい三つ子\', \'text\': \'トランプル\\n荒々しい三つ子が戦場に出たとき、これがトークンでない場合、これのコピーであるトークン２つを生成する。\\n荒々しい三つ子が死亡したとき、あなたがコントロールしていて「荒々しい三つ子」という名前の各クリーチャーの上にそれぞれ、これのパワーに等しい個数の＋１/＋１カウンターを置く。\', \'type\': \'クリーチャー — サテュロス・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631984&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'45a66142-9f89-43f0-86bf-07ea78869b8c\', \'multiverseId\': 631984}, \'multiverseid\': 631984}, {\'name\': \'粗野三人众\', \'text\': \'践踏\\n当粗野三人众进战场时，若它不是衍生物，则派出两个为其复制品的衍生物。\\n当粗野三人众死去时，在每个由你操控且名称为粗野三人众的生物上各放置若干+1/+1指示物，其数量等同于死去者的力量。\', \'type\': \'生物 — 羊蹄人／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632031&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'53c581fb-4cee-4c20-a4f7-0cdb8b88680c\', \'multiverseId\': 632031}, \'multiverseid\': 632031}]', '[{\'name\': \'Räudiger Rattenfänger\', \'text\': \'Immer wenn eine Ratte, die du kontrollierst, geblockt wird, erhält sie +2/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Gesinde\', \'flavor\': \'„Was sagst du da, Schnapper? Ja, du hast recht! Es war sehr unhöflich vom Wirt, dass er uns rausgeworfen hat!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629914&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'de44a6e4-2c3f-4b52-b88f-7d4a2ba2a439\', \'multiverseId\': 629914}, \'multiverseid\': 629914}, {\'name\': \'Ratero andrajoso\', \'text\': \'Siempre que una Rata que controlas sea bloqueada, obtiene +2/+0 hasta el final del turno.\', \'type\': \'Criatura — Plebeyo humano\', \'flavor\': \'"¿Qué dices, Mordisquitos? ¡Sí, tienes razón! ¡El posadero fue muy grosero al echarnos!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630175&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ef0a56e9-1d00-473a-a42b-ee0fd630a221\', \'multiverseId\': 630175}, \'multiverseid\': 630175}, {\'name\': \'Ratier en lambeaux\', \'text\': "À chaque fois qu\'un rat que vous contrôlez devient bloqué, il gagne +2/+0 jusqu\'à la fin du tour.", \'type\': \'Créature — humain et paysan\', \'flavor\': "« Qu\'est-ce que tu dis, Claquemâchoires ? Oui, tu as raison ! C\'était très grossier de la part du tavernier de nous mettre dehors ! »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630436&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4fa9fde3-6cd1-472e-8b85-377dff0bac9d\', \'multiverseId\': 630436}, \'multiverseid\': 630436}, {\'name\': \'Straccione della Topaia\', \'text\': \'Ogniqualvolta un Ratto che controlli viene bloccato, prende +2/+0 fino alla fine del turno.\', \'type\': \'Creatura — Popolano Umano\', \'flavor\': \'"Come dici, Mordicchio? Sì, hai ragione! Il locandiere è stato molto scortese a sbatterci fuori!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630697&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'30b529e0-5303-46cd-8538-7dd5d8a16806\', \'multiverseId\': 630697}, \'multiverseid\': 630697}, {\'name\': \'ぼろぼろのネズミ飼い\', \'text\': \'あなたがコントロールしているネズミ１体がブロックされた状態になるたび、ターン終了時まで、それは＋２/＋０の修整を受ける。\', \'type\': \'クリーチャー — 人間・農民\', \'flavor\': \'「なんじゃね、パチパチ？うむ、その通りじゃ！あの宿主め、ワシらを追い出すなんてひどい奴じゃった！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630958&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9b581578-c476-4be0-912c-eb46ece7be67\', \'multiverseId\': 630958}, \'multiverseid\': 630958}, {\'name\': \'Rateiro Esfarrapado\', \'text\': \'Toda vez que um Rato que você controla é bloqueado, ele recebe +2/+0 até o final do turno.\', \'type\': \'Criatura — Humano Plebeu\', \'flavor\': \'"O que você disse, Mordisco? É, tem razão! O estalajadeiro foi mesmo muito rude nos botando pra fora!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631219&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7fd4b8e7-57a9-4ee3-9e00-74244e77e8f2\', \'multiverseId\': 631219}, \'multiverseid\': 631219}, {\'name\': \'褴褛养鼠人\', \'text\': \'每当一个由你操控的老鼠被阻挡时，它得+2/+0直到回合结束。\', \'type\': \'生物 — 人类／平民\', \'flavor\': \'「怎么回事呀快脚？你说得对！旅店主把我们赶出来太无礼了！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631480&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'62aed542-9947-4442-b1e9-5cf017fdb9f0\', \'multiverseId\': 631480}, \'multiverseid\': 631480}]', '[{\'name\': \'Rückkehr aus der Wildnis\', \'text\': \'Bestimme zwei —\\n• Durchsuche deine Bibliothek nach einer Standardland-Karte, bringe sie getappt ins Spiel und mische danach.\\n• Erzeuge einen 1/1 weißen Mensch-Kreaturenspielstein.\\n• Erzeuge einen Speise-Spielstein. (Er ist ein Artefakt mit „{2}, {T}, opfere dieses Artefakt: Du erhältst 3 Lebenspunkte dazu.")\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629943&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bea20050-8aef-48ca-a41f-23ed168b99fb\', \'multiverseId\': 629943}, \'multiverseid\': 629943}, {\'name\': \'Regreso de las tierras salvajes\', \'text\': \'Elige dos:\\n• Busca en tu biblioteca una carta de tierra básica, ponla en el campo de batalla girada y luego baraja.\\n• Crea una ficha de criatura Humano blanca 1/1.\\n• Crea una ficha de Comida. (Es un artefacto con "{2}, {T}, sacrificar este artefacto: Ganas 3 vidas".)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630204&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'14d744e0-6b69-4ff2-b6ac-61303ab52cb4\', \'multiverseId\': 630204}, \'multiverseid\': 630204}, {\'name\': \'Retour des friches\', \'text\': "Choisissez deux —\\n• Cherchez dans votre bibliothèque une carte de terrain de base, mettez-la sur le champ de bataille engagée, puis mélangez.\\n• Créez un jeton de créature 1/1 blanche Humain.\\n• Créez un jeton Nourriture. (C\'est un artefact avec « {2}, {T}, sacrifiez cet artefact : Vous gagnez 3 points de vie. »)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630465&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ec9aed60-9db9-45b0-a627-222607f082f4\', \'multiverseId\': 630465}, \'multiverseid\': 630465}, {\'name\': \'Ritorno dalle Terre Selvagge\', \'text\': \'Scegli due —\\n• Passa in rassegna il tuo grimorio per una carta terra base, mettila sul campo di battaglia TAPpata, poi rimescola.\\n• Crea una pedina creatura Umano 1/1 bianca.\\n• Crea una pedina Cibo. (È un artefatto con "{2}, {T}, Sacrifica questo artefatto: Guadagni 3 punti vita".)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630726&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cc94e39a-7276-4ad3-b285-f3110897472a\', \'multiverseId\': 630726}, \'multiverseid\': 630726}, {\'name\': \'僻境からの帰還\', \'text\': \'以下から２つを選ぶ。\\n・あなたのライブラリーから基本土地・カード１枚を探し、タップ状態で戦場に出す。その後、ライブラリーを切り直す。\\n・白の１/１の人間・クリーチャー・トークン１体を生成する。\\n・食物・トークン１つを生成する。（それは、「{2}, {T}, このアーティファクトを生け贄に捧げる：あなたは３点のライフを得る。」を持つアーティファクトである。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630987&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'492552b6-1f2a-46af-9579-8fb860c9a789\', \'multiverseId\': 630987}, \'multiverseid\': 630987}, {\'name\': \'Voltar das Terras Selvagens\', \'text\': \'Escolha dois —\\n• Procure um card de terreno básico em seu grimório, coloque-o no campo de batalha virado e depois embaralhe.\\n• Crie uma ficha de criatura Humano branca 1/1.\\n• Crie uma ficha de Comida. (Ela é um artefato com "{2}, {T}, sacrifique este artefato: Você ganha 3 pontos de vida".)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631248&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bc37c9f7-80e9-48df-b4a0-e4e780f93c85\', \'multiverseId\': 631248}, \'multiverseid\': 631248}, {\'name\': \'幻野复还\', \'text\': \'选择两项～\\n•从你牌库中搜寻一张基本地牌，将之横置放进战场，然后洗牌。\\n•派出一个1/1白色人类衍生生物。\\n•派出一个食品衍生物。（它是具有「{2}，{T}，牺牲此神器：你获得3点生命」的神器。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631509&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d86622fc-1a25-45e1-941e-8a9302813322\', \'multiverseId\': 631509}, \'multiverseid\': 631509}]', '[{\'name\': \'Rüpelhafte Nachforschungen\', \'text\': \'Dieser Zauberspruch kostet beim Wirken für jede Kreatur, die in diesem Zug angegriffen hat, {1} weniger.\\nZiehe drei Karten.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Gestohlene Schätze kann man zurückholen, aber gestohlenes Wissen gehört für immer dir."\\n—Alela\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632088&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0c6967a7-3e1d-4f16-b980-b99a7e55803e\', \'multiverseId\': 632088}, \'multiverseid\': 632088}, {\'name\': \'Investigación agitada\', \'text\': \'Te cuesta {1} menos lanzar este hechizo por cada criatura que atacó este turno.\\nRoba tres cartas.\', \'type\': \'Instantáneo\', \'flavor\': \'"Los tesoros robados se pueden recuperar, pero el conocimiento robado es tuyo para siempre".\\n—Alila\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632103&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'95f1cbde-1241-445d-aeeb-43e850a09c0d\', \'multiverseId\': 632103}, \'multiverseid\': 632103}, {\'name\': \'Recherches chahuteuses\', \'text\': \'Ce sort coûte {1} de moins à lancer pour chaque créature qui a attaqué ce tour-ci.\\nPiochez trois cartes.\', \'type\': \'Éphémère\', \'flavor\': \'« Un trésor volé peut être repris, mais un savoir volé reste vôtre à jamais. »\\n—Alela\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632118&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'faf242f8-467e-4992-add3-568a3ae6f4f0\', \'multiverseId\': 632118}, \'multiverseid\': 632118}, {\'name\': \'Ricerca Turbolenta\', \'text\': \'Questa magia costa {1} in meno per essere lanciata per ogni creatura che ha attaccato in questo turno.\\nPesca tre carte.\', \'type\': \'Istantaneo\', \'flavor\': \'"I tesori rubati possono essere recuperati, ma la conoscenza rubata rimane tua per sempre."\\n—Alela\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632133&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b222cf18-a775-4f5a-82e7-592e5667b56b\', \'multiverseId\': 632133}, \'multiverseid\': 632133}, {\'name\': \'騒々しい物探し\', \'text\': \'この呪文を唱えるためのコストは、このターンに攻撃したクリーチャー１体につき{1}少なくなる。\\nカード３枚を引く。\', \'type\': \'インスタント\', \'flavor\': \'「盗んだ宝は取り返されるけど、盗んだ知識はずっと自分のものよ。」\\n——アリーラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632148&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0aa69a50-974f-4738-a561-df2e04fe8ba9\', \'multiverseId\': 632148}, \'multiverseid\': 632148}, {\'name\': \'Pesquisa Pandemônica\', \'text\': \'Esta mágica custa {1} a menos para ser conjurada por cada criatura que tiver atacado neste turno.\\nCompre três cards.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Tesouros roubados podem ser devolvidos, mas conhecimento roubado será seu para sempre."\\n— Alela\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632163&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'346b0734-680e-4aa3-84ec-1c46fb21831e\', \'multiverseId\': 632163}, \'multiverseid\': 632163}, {\'name\': \'嗡闹研究\', \'text\': \'每有一个本回合中攻击过的生物，此咒语便减少{1}来施放。\\n抓三张牌。\', \'type\': \'瞬间\', \'flavor\': \'「偷来的珍宝会被夺回去，但偷来的知识永远属于你。」\\n～阿莉莱\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632178&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'498ada77-bd98-4fef-b552-6d823a795c7d\', \'multiverseId\': 632178}, \'multiverseid\': 632178}]', '[{\'name\': \'Rüstkammer-Mäuse\', \'text\': \'Feier — Die Rüstkammer-Mäuse erhalten +0/+2, solange in diesem Zug zwei oder mehr bleibende Karten, die keine Länder sind, unter deiner Kontrolle ins Spiel gekommen sind.\', \'type\': \'Kreatur — Maus\', \'flavor\': \'Sie tragen dazu bei, dass die Schmieden der Zwerge immer quietschsauber sind.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629765&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c4dec36f-b7d9-4c52-ae4f-e2d63cf939ce\', \'multiverseId\': 629765}, \'multiverseid\': 629765}, {\'name\': \'Ratones del arsenal\', \'text\': \'Celebración — Los Ratones del arsenal obtienen +0/+2 mientras dos o más permanentes que no sean tierra entraran al campo de batalla bajo tu control este turno.\', \'type\': \'Criatura — Ratón\', \'flavor\': \'Ayudan a que las forjas de los enanos estén siempre impecables.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630026&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2555a210-8e19-4351-a4ad-bc8176e5f525\', \'multiverseId\': 630026}, \'multiverseid\': 630026}, {\'name\': "Souris de l\'armurerie", \'text\': "Célébration — Les Souris de l\'armurerie gagnent +0/+2 tant qu\'au moins deux permanents non-terrain sont arrivés sur le champ de bataille sous votre contrôle ce tour-ci.", \'type\': \'Créature — souris\', \'flavor\': "Elles assurent que les forges des nains soient toujours d\'une propreté impeccable.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630287&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bcfc3617-209f-480b-bad5-f0029bd72c8a\', \'multiverseId\': 630287}, \'multiverseid\': 630287}, {\'name\': "Topi dell\'Armeria", \'text\': "Celebrazione — I Topi dell\'Armeria prendono +0/+2 se due o più permanenti non terra sono entrati nel campo di battaglia sotto il tuo controllo in questo turno.", \'type\': \'Creatura — Topo\', \'flavor\': \'Si assicurano che gli ingranaggi delle forge naniche girino senza sosta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630548&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2db28514-4ba7-491c-85d8-0ad960710548\', \'multiverseId\': 630548}, \'multiverseid\': 630548}, {\'name\': \'武器庫のネズミ\', \'text\': \'祝祭 — このターンに土地でない２つ以上のパーマネントがあなたのコントロール下で戦場に出たことがあるなら、武器庫のネズミは＋０/＋２の修整を受ける。\', \'type\': \'クリーチャー — ハツカネズミ\', \'flavor\': \'彼らはドワーフの鍛冶場を常にきれいに保っているのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630809&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0c0922f6-8710-43d2-a0e1-51c1461f45f0\', \'multiverseId\': 630809}, \'multiverseid\': 630809}, {\'name\': \'Camundongos do Arsenal\', \'text\': \'Celebração — Camundongos do Arsenal recebe +0/+2 contanto que duas ou mais permanentes não de terreno tenham entrado no campo de batalha sob seu controle neste turno.\', \'type\': \'Criatura — Camundongo\', \'flavor\': \'Eles ajudam a garantir que as forjas dos anões estejam sempre limpíssimas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631070&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'80f8dba8-a832-4775-b5de-9ececfca86ee\', \'multiverseId\': 631070}, \'multiverseid\': 631070}, {\'name\': \'军械库鼠群\', \'text\': \'欢庆～只要本回合中有两个或更多非地永久物在你的操控下进战场，军械库鼠群便得+0/+2。\', \'type\': \'生物 — 家鼠\', \'flavor\': \'吱响声间，它们麻利搬运，确保矮人熔炉整洁如新。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631331&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b4c6328e-658c-49de-b580-0ba0f68cd6b6\', \'multiverseId\': 631331}, \'multiverseid\': 631331}]', '[{\'name\': \'Scalding Viper // Dampfreinigung\', \'text\': \'Immer wenn ein Gegner einen Zauberspruch mit Manabetrag 3 oder weniger wirkt, fügt die Sengende Viper jenem Spieler 1 Schadenspunkt zu.\', \'type\': \'Kreatur — Elementarwesen, Ophis\', \'flavor\': None, \'faceName\': \'Scalding Viper\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629997&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1eae26e4-dcf0-49e2-a7ff-962e7351ee8a\', \'multiverseId\': 629997}, \'multiverseid\': 629997}, {\'name\': \'Scalding Viper // Limpiar a vapor\', \'text\': \'Siempre que un oponente lance un hechizo con valor de maná de 3 o menos, la Víbora hirviente hace 1 punto de daño a ese jugador.\', \'type\': \'Criatura — Víbora elemental\', \'flavor\': None, \'faceName\': \'Scalding Viper\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630258&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3a2376f7-a8ba-4b12-8fb4-4a1fb3c870ff\', \'multiverseId\': 630258}, \'multiverseid\': 630258}, {\'name\': \'Scalding Viper // Nettoyage à la vapeur\', \'text\': "À chaque fois qu\'un adversaire lance un sort avec une valeur de mana inférieure ou égale à 3, la Vipère bouillante inflige 1 blessure à ce joueur.", \'type\': \'Créature — élémental et serpent\', \'flavor\': None, \'faceName\': \'Scalding Viper\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630519&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3c6f3e08-eaa1-42c9-90d5-d36550b2c92e\', \'multiverseId\': 630519}, \'multiverseid\': 630519}, {\'name\': \'Scalding Viper // Evaporare\', \'text\': \'Ogniqualvolta un avversario lancia una magia con valore di mana pari o inferiore a 3, la Vipera Rovente infligge 1 danno a quel giocatore.\', \'type\': \'Creatura — Serpente Elementale\', \'flavor\': None, \'faceName\': \'Scalding Viper\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630780&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'454e2c9a-0cd5-4644-b7bb-df7381b2f832\', \'multiverseId\': 630780}, \'multiverseid\': 630780}, {\'name\': \'Scalding Viper // 蒸（じょう）気（き）洗（せん）浄（じょう）\', \'text\': \'対戦相手１人がマナ総量が３以下である呪文１つを唱えるたび、煮えたぎるバイパーはそのプレイヤーに１点のダメージを与える。\', \'type\': \'クリーチャー — エレメンタル・蛇\', \'flavor\': None, \'faceName\': \'Scalding Viper\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631041&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c962ac4b-22fd-463d-92a8-6e6e44cabc01\', \'multiverseId\': 631041}, \'multiverseid\': 631041}, {\'name\': \'Scalding Viper // Limpeza a Vapor\', \'text\': \'Toda vez que um oponente conjura uma mágica com valor de mana igual ou inferior a 3, Víbora Escaldante causa 1 ponto de dano àquele jogador.\', \'type\': \'Criatura — Elemental Cobra\', \'flavor\': None, \'faceName\': \'Scalding Viper\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631302&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'030a3bb4-8ea0-47ae-98ff-156c15aa088d\', \'multiverseId\': 631302}, \'multiverseid\': 631302}, {\'name\': \'Scalding Viper // 蒸气清扫\', \'text\': \'每当任一对手施放法术力值等于或小于3的咒语时，灼烫毒蛇对该牌手造成1点伤害。\', \'type\': \'生物 — 元素／蛇\', \'flavor\': None, \'faceName\': \'Scalding Viper\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631563&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e90e39ab-9bdb-429a-9cc5-24c896d09b66\', \'multiverseId\': 631563}, \'multiverseid\': 631563}]', '[{\'name\': \'Schatzkammer der Sammlerin\', \'text\': \'{2}, {T}: Ziehe eine Karte und wirf dann eine Karte ab. Erzeuge einen Schatz-Spielstein. (Er ist ein Artefakt mit „{T}, opfere dieses Artefakt: Erzeuge ein Mana einer beliebigen Farbe.")\', \'type\': \'Artefakt\', \'flavor\': \'Beluna hat die Angewohnheit, Wertvolles aus der Welt unterhalb zu „retten", von unbezahlbaren Artefakten bis hin zu geschichtsträchtigen Gebäuden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630006&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'10ee15b9-1841-4a53-8093-ee6a29f1ca3c\', \'multiverseId\': 630006}, \'multiverseid\': 630006}, {\'name\': \'Cámara de coleccionista\', \'text\': \'{2}, {T}: Roba una carta y luego descarta una carta. Crea una ficha de Tesoro. (Es un artefacto con "{T}, sacrificar este artefacto: Agrega un maná de cualquier color".)\', \'type\': \'Artefacto\', \'flavor\': \'Beluna tiene la costumbre de "liberar" cosas valiosas del mundo de abajo, desde artefactos de valor incalculable a edificios históricos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630267&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e846c1ef-782f-4f24-8719-b8d0021d667a\', \'multiverseId\': 630267}, \'multiverseid\': 630267}, {\'name\': \'Salle forte de la collectionneuse\', \'text\': "{2}, {T} : Piochez une carte, puis défaussez-vous d\'une carte. Créez un jeton Trésor. (C\'est un artefact avec « {T}, sacrifiez cet artefact : Ajoutez un mana de la couleur de votre choix. »)", \'type\': \'Artefact\', \'flavor\': "Beluna a la fâcheuse habitude de « libérer » les objets de valeur du monde du dessous, qu\'ils soient des artefacts inestimables ou des bâtiments historiques.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630528&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4409413b-1c44-4e92-b1cc-33e4e86c7959\', \'multiverseId\': 630528}, \'multiverseid\': 630528}, {\'name\': \'Sala della Collezionista\', \'text\': \'{2}, {T}: Pesca una carta, poi scarta una carta. Crea una pedina Tesoro. (È un artefatto con "{T}, Sacrifica questo artefatto: Aggiungi un mana di un qualsiasi colore".)\', \'type\': \'Artefatto\', \'flavor\': \'Beluna è solita "liberare" oggetti preziosi del mondo di sotto, da artefatti inestimabili a edifici storici.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630789&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f085a3fb-30bf-44c8-b930-228ad1ba57da\', \'multiverseId\': 630789}, \'multiverseid\': 630789}, {\'name\': \'蒐集家の保管庫\', \'text\': \'{2}, {T}：カード１枚を引く。その後、カード１枚を捨てる。宝物・トークン１つを生成する。（それは、「{T}, このアーティファクトを生け贄に捧げる：好きな色１色のマナ１点を加える。」を持つアーティファクトである。）\', \'type\': \'アーティファクト\', \'flavor\': \'値のつかないような遺品から歴史的建造物まで、下界から貴重品を「解放」させるのがベルーナの癖だった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631050&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eae02ae4-7e22-4147-b485-b4ac22796c8f\', \'multiverseId\': 631050}, \'multiverseid\': 631050}, {\'name\': \'Cofre do Colecionador\', \'text\': \'{2}, {T}: Compre um card e depois descarte um card. Crie uma ficha de Tesouro. (Ela é um artefato com "{T}, sacrifique este artefato: Adicione um mana de qualquer cor".)\', \'type\': \'Artefato\', \'flavor\': \'Beluna tem o hábito de "resgatar" coisas de valor do mundo lá embaixo, de artefatos inestimáveis a construções históricas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631311&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8acb80ad-a528-4a1c-a751-ed31125a11d3\', \'multiverseId\': 631311}, \'multiverseid\': 631311}, {\'name\': \'收藏家宝窖\', \'text\': \'{2}，{T}：抓一张牌，然后弃一张牌。派出一个珍宝衍生物。（它是具有「{T}，牺牲此神器：加一点任意颜色的法术力」的神器。）\', \'type\': \'神器\', \'flavor\': \'贝伦娜有「解救」云下世界珍宝的习惯，小到无价奇械、大到历史建筑全都涉猎。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631572&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f19d445b-efdc-460e-99fb-3d2222976be1\', \'multiverseId\': 631572}, \'multiverseid\': 631572}]', "[{'name': 'Schlafgebundene Fee', 'text': 'Fliegend, Abwehr {2}\\nDie Schlafgebundene Fee kommt getappt mit drei Betäubungsmarken ins Spiel. (Falls sie enttappt würde, entferne stattdessen eine Betäubungsmarke von ihr.)\\n{1}{U}: Enttappe die Schlafgebundene Fee.', 'type': 'Kreatur — Feenwesen, Zauberer', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629828&type=card', 'language': 'German', 'identifiers': {'scryfallId': '86a5b3ef-3fa0-491f-8a7c-402f20d857bf', 'multiverseId': 629828}, 'multiverseid': 629828}, {'name': 'Hada somnomaldita', 'text': 'Vuela, rebatir {2}.\\nEl Hada somnomaldita entra al campo de batalla girada con tres contadores de aturdimiento sobre ella. (Si fuera a enderezarse, en vez de eso, remueve un contador de aturdimiento de ella.)\\n{1}{U}: Endereza el Hada somnomaldita.', 'type': 'Criatura — Hechicero hada', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630089&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '507e9506-c688-48d8-9fb6-9ef280c3d74e', 'multiverseId': 630089}, 'multiverseid': 630089}, {'name': 'Faerie victime de la malédiction du sommeil', 'text': 'Vol, parade {2}\\nLa Faerie victime de la malédiction du sommeil arrive sur le champ de bataille engagée avec trois marqueurs « étourdissement » sur elle. (Si elle devait devenir dégagée, retirez-lui un marqueur « étourdissement » à la place.)\\n{1}{U} : Dégagez la Faerie victime de la malédiction du sommeil.', 'type': 'Créature — peuple fée et sorcier', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630350&type=card', 'language': 'French', 'identifiers': {'scryfallId': '91f5def8-60ab-462b-8859-cbcbaf0d6a7b', 'multiverseId': 630350}, 'multiverseid': 630350}, {'name': 'Spiritello Maledetto dal Sonno', 'text': 'Volare, egida {2}\\nLo Spiritello Maledetto dal Sonno entra nel campo di battaglia TAPpato con tre segnalini stordimento. (Se sta per essere STAPpato, rimuovi invece un segnalino stordimento da esso.)\\n{1}{U}: STAPpa lo Spiritello Maledetto dal Sonno.', 'type': 'Creatura — Mago Spiritello', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630611&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '25f59f0a-b651-4fba-9d48-1e1a2445a3f1', 'multiverseId': 630611}, 'multiverseid': 630611}, {'name': '眠り呪いのフェアリー', 'text': '飛行、護法{2}\\n眠り呪いのフェアリーは、麻痺カウンター３個が置かれた状態かつタップ状態で戦場に出る。（これがアンタップ状態になるなら、代わりにこれの上から麻痺カウンター１個を取り除く。）\\n{1}{U}：眠り呪いのフェアリーをアンタップする。', 'type': 'クリーチャー — フェアリー・ウィザード', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630872&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '8377adb4-4af3-4e1e-b177-f0ee36602088', 'multiverseId': 630872}, 'multiverseid': 630872}, {'name': 'Fada Amaldiçoada com o Sono', 'text': 'Voar, salvaguarda {2}\\nFada Amaldiçoada com o Sono entra no campo de batalha virada com três marcadores de atordoamento. (Se ela se tornaria desvirada, em vez disso, remova um marcador de atordoamento dela.)\\n{1}{U}: Desvire Fada Amaldiçoada com o Sono.', 'type': 'Criatura — Fada Mago', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631133&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0368e820-9aba-44fa-bcdd-9f8409134161', 'multiverseId': 631133}, 'multiverseid': 631133}, {'name': '咒眠仙灵', 'text': '飞行，守护{2}\\n咒眠仙灵须横置进战场，且上面有三个晕眩指示物。（如果它将成为未横置，则改为从其上移去一个晕眩指示物。）\\n{1}{U}：重置咒眠仙灵。', 'type': '生物 — 仙灵／法术师', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631394&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'bfa2e60b-2cf2-4bba-ae07-264e80812911', 'multiverseId': 631394}, 'multiverseid': 631394}]", "[{'name': 'Schlafgebundene Fee', 'text': 'Fliegend, Abwehr {2}\\nDie Schlafgebundene Fee kommt getappt mit drei Betäubungsmarken ins Spiel.\\n{1}{U}: Enttappe die Schlafgebundene Fee.', 'type': 'Kreatur — Feenwesen, Zauberer', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631867&type=card', 'language': 'German', 'identifiers': {'scryfallId': '635c07d2-267b-4017-87dd-9642ae4c200e', 'multiverseId': 631867}, 'multiverseid': 631867}, {'name': 'Faerie victime de la malédiction du sommeil', 'text': 'Vol, parade {2}\\nLa Faerie victime de la malédiction du sommeil arrive sur le champ de bataille engagée avec trois marqueurs « étourdissement » sur elle.\\n{1}{U} : Dégagez la Faerie victime de la malédiction du sommeil.', 'type': 'Créature — peuple fée et sorcier', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631914&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c06bc01c-24eb-4ba5-b321-842b85822438', 'multiverseId': 631914}, 'multiverseid': 631914}, {'name': '眠り呪いのフェアリー', 'text': '飛行、護法{2}\\n眠り呪いのフェアリーは、麻痺カウンター３個が置かれた状態かつタップ状態で戦場に出る。\\n{1}{U}：眠り呪いのフェアリーをアンタップする。', 'type': 'クリーチャー — フェアリー・ウィザード', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631961&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '2fde7f39-c172-43c8-b745-eefe24b3054f', 'multiverseId': 631961}, 'multiverseid': 631961}, {'name': '咒眠仙灵', 'text': '飞行，守护{2}\\n咒眠仙灵须横置进战场，且上面有三个晕眩指示物。\\n{1}{U}：重置咒眠仙灵。', 'type': '生物 — 仙灵／法术师', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632008&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '95c10498-afdb-4a6b-991e-0755b4a5db47', 'multiverseId': 632008}, 'multiverseid': 632008}]", '[{\'name\': \'Schlingenmeister-Sylphide\', \'text\': \'Fliegend\\nWenn die Schlingenmeister-Sylphide ins Spiel kommt, kannst du {2} bezahlen. Wenn du dies tust, tappe eine Kreatur deiner Wahl, die ein Gegner kontrolliert, und lege eine Betäubungsmarke auf sie. (Falls eine bleibende Karte mit Betäubungsmarke enttappt würde, entferne stattdessen eine davon.)\', \'type\': \'Kreatur — Feenwesen, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629830&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a8fc7fda-33b3-4639-94fd-86ec0ee5a95f\', \'multiverseId\': 629830}, \'multiverseid\': 629830}, {\'name\': \'Hada experta en trampas\', \'text\': \'Vuela.\\nCuando el Hada experta en trampas entre al campo de batalla, puedes pagar {2}. Cuando lo hagas, gira la criatura objetivo que controla un oponente y pon un contador de aturdimiento sobre ella. (Si un permanente con un contador de aturdimiento fuera a enderezarse, en vez de eso, remueve uno de esos contadores de él.)\', \'type\': \'Criatura — Hechicero hada\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630091&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5977f801-97b3-44c3-bc5c-70b52f9171e0\', \'multiverseId\': 630091}, \'multiverseid\': 630091}, {\'name\': \'Farfadette maîtresse entraveuse\', \'text\': "Vol\\nQuand la Farfadette maîtresse entraveuse arrive sur le champ de bataille, vous pouvez payer {2}. Quand vous faites ainsi, engagez une créature ciblée qu\'un adversaire contrôle et mettez un marqueur « étourdissement » sur elle. (Si un permanent avec un marqueur « étourdissement » devait devenir dégagé, retirez-lui en un à la place.)", \'type\': \'Créature — peuple fée et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630352&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5672372b-8cdb-49cb-b34c-9d887594a530\', \'multiverseId\': 630352}, \'multiverseid\': 630352}, {\'name\': \'Folletta Maestra dei Calappi\', \'text\': \'Volare\\nQuando la Folletta Maestra dei Calappi entra nel campo di battaglia, puoi pagare {2}. Quando lo fai, TAPpa una creatura bersaglio controllata da un avversario e metti un segnalino stordimento su di essa. (Se un permanente con un segnalino stordimento sta per essere STAPpato, rimuovi invece un segnalino stordimento da esso.)\', \'type\': \'Creatura — Mago Spiritello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630613&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4874df6c-b653-473b-a120-e8af497b4f56\', \'multiverseId\': 630613}, \'multiverseid\': 630613}, {\'name\': \'罠名人のスプライト\', \'text\': \'飛行\\n罠名人のスプライトが戦場に出たとき、{2}を支払ってもよい。そうしたとき、対戦相手がコントロールしているクリーチャー１体を対象とする。それをタップし、それの上に麻痺カウンター１個を置く。（麻痺カウンターが置かれているパーマネントがアンタップ状態になるなら、代わりにそれの上から麻痺カウンター１個を取り除く。）\', \'type\': \'クリーチャー — フェアリー・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630874&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dd301088-5a39-45af-b409-e80e4b108988\', \'multiverseId\': 630874}, \'multiverseid\': 630874}, {\'name\': \'Sílfide Mestra das Amarras\', \'text\': \'Voar\\nQuando Sílfide Mestra das Amarras entra no campo de batalha, você pode pagar {2}. Quando fizer isso, vire a criatura alvo que um oponente controla e coloque um marcador de atordoamento nela. (Se uma permanente com um marcador de atordoamento se tornaria desvirada, em vez disso, remova um marcador de atordoamento dela.)\', \'type\': \'Criatura — Fada Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631135&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ff09474e-03c3-43a7-9a19-e367bda3ff75\', \'multiverseId\': 631135}, \'multiverseid\': 631135}, {\'name\': \'设陷仙子\', \'text\': \'飞行\\n当设陷仙子进战场时，你可以支付{2}。当你如此作时，横置目标由对手操控的生物并在其上放置一个晕眩指示物。（如果某个其上有晕眩指示物的永久物将成为未横置，则改为从其上移去一个晕眩指示物。）\', \'type\': \'生物 — 仙灵／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631396&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b588edbf-b4d3-4a80-b410-ba49934881d7\', \'multiverseId\': 631396}, \'multiverseid\': 631396}]', '[{\'name\': \'Schlummerfeier der Feen\', \'text\': \'Bringe alle Kreaturen auf die Hand ihrer Besitzer zurück. Du erzeugst für jeden Gegner, der eine auf diese Weise zurückgebrachte Kreatur kontrolliert hat, zwei 1/1 blaue Feenwesen-Kreaturenspielsteine mit Flugfähigkeit und „Diese Kreatur kann nur fliegende Kreaturen blocken."\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632050&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'895bd097-6604-420e-9356-ac082ef5efa9\', \'multiverseId\': 632050}, \'multiverseid\': 632050}, {\'name\': \'Soirée entre faeries\', \'text\': \'Renvoyez toutes les créatures dans les mains de leurs propriétaires. Pour chaque adversaire qui contrôlait une créature renvoyée de cette manière, vous créez deux jetons de créature 1/1 bleue Peuple fée avec le vol et « Cette créature ne peut bloquer que les créatures avec le vol. »\', \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632055&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'666c35a4-5684-4ba5-953f-e27b6fe220be\', \'multiverseId\': 632055}, \'multiverseid\': 632055}, {\'name\': \'フェアリーのまどろみパーティ\', \'text\': \'各クリーチャーをそれぞれオーナーの手札に戻す。あなたは、これにより戻されたクリーチャーをコントロールしていた対戦相手１人につき２体の、飛行と「このクリーチャーでは飛行を持つクリーチャーしかブロックできない。」を持つ青の１/１のフェアリー・クリーチャー・トークンを生成する。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632060&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6697b1ef-3f27-4271-b8e4-d35fe67e3d4a\', \'multiverseId\': 632060}, \'multiverseid\': 632060}, {\'name\': \'仙灵迷宴\', \'text\': \'将所有生物移回其拥有者手上。每有一位所操控之生物被此法移回的对手，你便派出两个1/1蓝色仙灵衍生生物，且具有飞行与「此生物只能阻挡具飞行异能的生物。」\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632065&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ed1364d5-f67e-420c-86b8-c208a8678cdd\', \'multiverseId\': 632065}, \'multiverseid\': 632065}]', '[{\'name\': \'Schlummerfeier der Feen\', \'text\': \'Bringe alle Kreaturen auf die Hand ihrer Besitzer zurück. Du erzeugst für jeden Gegner, der eine auf diese Weise zurückgebrachte Kreatur kontrolliert hat, zwei 1/1 blaue Feenwesen-Kreaturenspielsteine mit Flugfähigkeit und „Diese Kreatur kann nur fliegende Kreaturen blocken."\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632087&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7e8c0c8d-87c1-4a4f-b1d6-e9ff40d2ccf5\', \'multiverseId\': 632087}, \'multiverseid\': 632087}, {\'name\': \'Fiesta siestera de las hadas\', \'text\': \'Regresa todas las criaturas a las manos de sus propietarios. Por cada oponente que controlara una criatura regresada de esta manera, creas dos fichas de criatura Hada azules 1/1 con la habilidad de volar y "Esta criatura solo puede bloquear criaturas con la habilidad de volar".\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632102&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'657eab8f-85de-461d-97f6-0bee0a8ce242\', \'multiverseId\': 632102}, \'multiverseid\': 632102}, {\'name\': \'Soirée entre faeries\', \'text\': \'Renvoyez toutes les créatures dans les mains de leurs propriétaires. Pour chaque adversaire qui contrôlait une créature renvoyée de cette manière, vous créez deux jetons de créature 1/1 bleue Peuple fée avec le vol et « Cette créature ne peut bloquer que les créatures avec le vol. »\', \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632117&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9d14d5dd-2c19-41c9-8a05-7eafe48cfc36\', \'multiverseId\': 632117}, \'multiverseid\': 632117}, {\'name\': \'Festa Soporifera degli Spiritelli\', \'text\': \'Fai tornare tutte le creature in mano ai rispettivi proprietari. Per ogni avversario che controllava una creatura ripresa in mano in questo modo, crei due pedine creatura Spiritello 1/1 blu con volare e "Questa creatura può bloccare solo creature con volare".\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632132&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cae427b8-578a-4835-851e-1ddee663e2ed\', \'multiverseId\': 632132}, \'multiverseid\': 632132}, {\'name\': \'フェアリーのまどろみパーティ\', \'text\': \'各クリーチャーをそれぞれオーナーの手札に戻す。あなたは、これにより戻されたクリーチャーをコントロールしていた対戦相手１人につき２体の、飛行と「このクリーチャーでは飛行を持つクリーチャーしかブロックできない。」を持つ青の１/１のフェアリー・クリーチャー・トークンを生成する。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632147&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0bfdabf1-05d5-474d-b5b8-6e3729056d69\', \'multiverseId\': 632147}, \'multiverseid\': 632147}, {\'name\': \'Festa do Pijama das Fadas\', \'text\': \'Devolva todas as criaturas para as mãos de seus donos. Para cada oponente que controlava uma criatura devolvida dessa forma, crie duas fichas de criatura Fada azul 1/1 com voar e "Esta criatura pode bloquear apenas criaturas com voar".\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632162&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3159bfac-dd12-4d67-bb07-888515cabff2\', \'multiverseId\': 632162}, \'multiverseid\': 632162}, {\'name\': \'仙灵迷宴\', \'text\': \'将所有生物移回其拥有者手上。每有一位所操控之生物被此法移回的对手，你便派出两个1/1蓝色仙灵衍生生物，且具有飞行与「此生物只能阻挡具飞行异能的生物。」\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632177&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ddc4f3a4-8016-4e6a-99bb-c48d045fb9a8\', \'multiverseId\': 632177}, \'multiverseid\': 632177}]', '[{\'name\': \'Schlummernde Burgwache\', \'text\': \'Immer wenn eine Verzauberung unter deiner Kontrolle ins Spiel kommt, wende Hellsicht 1 an.\\n{2}{W}: Die Schlummernde Burgwache erhält bis zum Ende des Zuges +1/+1 für jede Verzauberung, die du kontrollierst.\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': \'Der Traum eines vereinten Reiches verlieh ihm selbst im Schlaf Kraft.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629791&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4104e4b4-db75-4790-bde0-ac23c022c15e\', \'multiverseId\': 629791}, \'multiverseid\': 629791}, {\'name\': \'Vigilante dormido\', \'text\': \'Siempre que un encantamiento entre al campo de batalla bajo tu control, adivina 1.\\n{2}{W}: El Vigilante dormido obtiene +1/+1 hasta el final del turno por cada encantamiento que controlas.\', \'type\': \'Criatura — Caballero humano\', \'flavor\': \'Los sueños de un reino unido le conferían fuerza incluso durmiendo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630052&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'997d944e-c628-46da-90fe-57cb7c7dc1ce\', \'multiverseId\': 630052}, \'multiverseid\': 630052}, {\'name\': \'Garde de forteresse somnolent\', \'text\': "À chaque fois qu\'un enchantement arrive sur le champ de bataille sous votre contrôle, regard 1.\\n{2}{W} : Le Garde de forteresse somnolent gagne +1/+1 jusqu\'à la fin du tour pour chaque enchantement que vous contrôlez.", \'type\': \'Créature — humain et chevalier\', \'flavor\': "Rêver d\'un royaume uni lui donnait des forces, même dans son sommeil.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630313&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8a65e071-1bef-49e6-af1c-18b2c2cc8a99\', \'multiverseId\': 630313}, \'multiverseid\': 630313}, {\'name\': \'Guardia della Fortezza Dormiente\', \'text\': \'Ogniqualvolta un incantesimo entra nel campo di battaglia sotto il tuo controllo, profetizza 1.\\n{2}{W}: La Guardia della Fortezza Dormiente prende +1/+1 fino alla fine del turno per ogni incantesimo che controlli.\', \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': \'Il sogno di un reame unito gli dava forza anche nel sonno.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630574&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ee651202-c9d1-49f8-bd52-a417d67f970f\', \'multiverseId\': 630574}, \'multiverseid\': 630574}, {\'name\': \'まどろむ砦番\', \'text\': \'エンチャント１つがあなたのコントロール下で戦場に出るたび、占術１を行う。\\n{2}{W}：ターン終了時まで、まどろむ砦番はあなたがコントロールしているエンチャント１つにつき＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': \'ひとつになった王国の夢が、眠りの中にあってもなお彼に力を与えた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630835&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'35ac05b7-1545-40f8-9838-c21d839c7274\', \'multiverseId\': 630835}, \'multiverseid\': 630835}, {\'name\': \'Guarda da Bastilha Dormente\', \'text\': \'Toda vez que um encantamento entrar no campo de batalha sob seu controle, use vidência 1.\\n{2}{W}: Guarda da Bastilha Dormente recebe +1/+1 até o final do turno por cada encantamento que você controla.\', \'type\': \'Criatura — Humano Cavaleiro\', \'flavor\': \'Sonhar com um reino unido lhe dava força mesmo dormindo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631096&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'23b389f8-9b7b-4942-8283-1a74901f688b\', \'multiverseId\': 631096}, \'multiverseid\': 631096}, {\'name\': \'静眠殿卫\', \'text\': \'每当一个结界在你的操控下进战场时，占卜1。\\n{2}{W}：你每操控一个结界，静眠殿卫便得+1/+1直到回合结束。\', \'type\': \'生物 — 人类／骑士\', \'flavor\': \'世境统一之梦令他在沉眠当中也心潮澎湃。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631357&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'af46afb0-0db0-44d9-8ea3-bb491bb67c98\', \'multiverseId\': 631357}, \'multiverseid\': 631357}]', '[{\'name\': \'Sharae der betäubenden Tiefen\', \'text\': \'Wenn Sharae der betäubenden Tiefen ins Spiel kommt, tappe eine Kreatur deiner Wahl, die ein Gegner kontrolliert, und lege eine Betäubungsmarke auf sie. (Falls eine bleibende Karte mit Betäubungsmarke enttappt würde, entferne stattdessen eine davon.)\\nImmer wenn du eine oder mehrere ungetappte Kreaturen, die deine Gegner kontrollieren, tappst, ziehe eine Karte. Diese Fähigkeit wird nur einmal pro Zug ausgelöst.\', \'type\': \'Legendäre Kreatur — Meervolk, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629975&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e7344194-fabe-479a-8272-2468a931f9bd\', \'multiverseId\': 629975}, \'multiverseid\': 629975}, {\'name\': \'Sharae de los abismos paralizantes\', \'text\': \'Cuando Sharae de los abismos paralizantes entre al campo de batalla, gira la criatura objetivo que controla un oponente y pon un contador de aturdimiento sobre ella. (Si un permanente con un contador de aturdimiento fuera a enderezarse, en vez de eso, remueve uno de esos contadores de él.)\\nSiempre que gires una o más criaturas enderezadas que controlan tus oponentes, roba una carta. Esta habilidad solo se dispara una vez por turno.\', \'type\': \'Criatura legendaria — Hechicero tritón\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630236&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0bcc60fe-c320-43db-bf4a-d481b83dce2e\', \'multiverseId\': 630236}, \'multiverseid\': 630236}, {\'name\': \'Sharae des profondeurs paralysantes\', \'text\': "Quand Sharae des profondeurs paralysantes arrive sur le champ de bataille, engagez une créature ciblée qu\'un adversaire contrôle et mettez un marqueur « étourdissement » sur elle. (Si un permanent avec un marqueur « étourdissement » devait devenir dégagé, retirez-lui en un à la place.)\\nÀ chaque fois que vous engagez au moins une créature dégagée que vos adversaires contrôlent, piochez une carte. Cette capacité ne se déclenche qu\'une seule fois par tour.", \'type\': \'Créature légendaire — ondin et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630497&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'88cbe2f2-1d83-48b2-8ba2-7335cecfc271\', \'multiverseId\': 630497}, \'multiverseid\': 630497}, {\'name\': \'Sharae delle Profondità Intorpidenti\', \'text\': \'Quando Sharae delle Profondità Intorpidenti entra nel campo di battaglia, TAPpa una creatura bersaglio controllata da un avversario e metti un segnalino stordimento su di essa. (Se un permanente con un segnalino stordimento sta per essere STAPpato, rimuovi invece un segnalino stordimento da esso.)\\nOgniqualvolta TAPpi una o più creature STAPpate controllate dai tuoi avversari, pesca una carta. Questa abilità si innesca solo una volta per turno.\', \'type\': \'Creatura Leggendaria — Mago Tritone\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630758&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7bd2e26c-206c-49a9-9ffa-bc5d89f67c68\', \'multiverseId\': 630758}, \'multiverseid\': 630758}, {\'name\': \'麻痺海溝のシャレー\', \'text\': \'麻痺海溝のシャレーが戦場に出たとき、対戦相手がコントロールしているクリーチャー１体を対象とする。それをタップし、それの上に麻痺カウンター１個を置く。（麻痺カウンターが置かれているパーマネントがアンタップ状態になるなら、代わりにそれの上から麻痺カウンター１個を取り除く。）\\n対戦相手がコントロールしていてアンタップ状態である１体以上のクリーチャーをあなたがタップするたび、カード１枚を引く。この能力は、毎ターン１回しか誘発しない。\', \'type\': \'伝説のクリーチャー — マーフォーク・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631019&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'78953635-e32d-4cea-a09b-f07ead6986c3\', \'multiverseId\': 631019}, \'multiverseid\': 631019}, {\'name\': \'Sharae das Profundezas Entorpecentes\', \'text\': \'Quando Sharae das Profundezas Entorpecentes entrar no campo de batalha, vire a criatura alvo que um oponente controla e coloque um marcador de atordoamento nela. (Se uma permanente com um marcador de atordoamento se tornaria desvirada, em vez disso, remova um marcador de atordoamento dela.)\\nToda vez que você virar uma ou mais criaturas desviradas que seus oponentes controlam, compre um card. Esta habilidade é desencadeada apenas uma vez a cada turno.\', \'type\': \'Criatura Lendária — Tritão Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631280&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'924682c8-d235-445d-a529-21a3e421e19f\', \'multiverseId\': 631280}, \'multiverseid\': 631280}, {\'name\': \'迷醉渊的莎蕾\', \'text\': \'当迷醉渊的莎蕾进战场时，横置目标由对手操控的生物并在其上放置一个晕眩指示物。（如果某个其上有晕眩指示物的永久物将成为未横置，则改为从其上移去一个晕眩指示物。）\\n每当你横置一个或数个由对手操控且未横置的生物时，抓一张牌。此异能每回合只会触发一次。\', \'type\': \'传奇生物 — 人鱼／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631541&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c2d3ac86-d9b1-4e5e-a8d6-4be2ced8d0a0\', \'multiverseId\': 631541}, \'multiverseid\': 631541}]', '[{\'name\': \'Shrouded Shepherd // Schattenspaltung\', \'text\': \'Wenn der Verhüllte Hirte ins Spiel kommt, erhält eine Kreatur deiner Wahl, die du kontrollierst, +2/+2 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Geist, Krieger\', \'flavor\': None, \'faceName\': \'Shrouded Shepherd\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629998&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'13d9d8ec-a713-417e-a38a-866a085d18e0\', \'multiverseId\': 629998}, \'multiverseid\': 629998}, {\'name\': \'Shrouded Shepherd // Sombras aceradas\', \'text\': \'Cuando el Pastor nebuloso entre al campo de batalla, la criatura objetivo que controlas obtiene +2/+2 hasta el final del turno.\', \'type\': \'Criatura — Guerrero espíritu\', \'flavor\': None, \'faceName\': \'Shrouded Shepherd\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630259&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'eca4624c-c6a2-49eb-aa0f-eb6c185a3859\', \'multiverseId\': 630259}, \'multiverseid\': 630259}, {\'name\': \'Shrouded Shepherd // Trancher les ombres\', \'text\': "Quand le Berger voilé arrive sur le champ de bataille, une créature ciblée que vous contrôlez gagne +2/+2 jusqu\'à la fin du tour.", \'type\': \'Créature — esprit et guerrier\', \'flavor\': None, \'faceName\': \'Shrouded Shepherd\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630520&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8573a589-9352-4d8a-a9bf-769b22f39c2e\', \'multiverseId\': 630520}, \'multiverseid\': 630520}, {\'name\': \'Shrouded Shepherd // Falciare le Ombre\', \'text\': \'Quando il Pastore Velato entra nel campo di battaglia, una creatura bersaglio che controlli prende +2/+2 fino alla fine del turno.\', \'type\': \'Creatura — Guerriero Spirito\', \'flavor\': None, \'faceName\': \'Shrouded Shepherd\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630781&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'12c2ecfa-47a4-4d0a-9c98-321d0f03f4da\', \'multiverseId\': 630781}, \'multiverseid\': 630781}, {\'name\': \'Shrouded Shepherd // 影（かげ）の切（せつ）断（だん）\', \'text\': \'覆われた羊飼いが戦場に出たとき、あなたがコントロールしているクリーチャー１体を対象とする。ターン終了時まで、それは＋２/＋２の修整を受ける。\', \'type\': \'クリーチャー — スピリット・戦士\', \'flavor\': None, \'faceName\': \'Shrouded Shepherd\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631042&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'740799c9-2126-46f1-af35-3ec4477741fc\', \'multiverseId\': 631042}, \'multiverseid\': 631042}, {\'name\': \'Shrouded Shepherd // Partir as Sombras\', \'text\': \'Quando Pastor Velado entra no campo de batalha, a criatura alvo que você controla recebe +2/+2 até o final do turno.\', \'type\': \'Criatura — Espírito Guerreiro\', \'flavor\': None, \'faceName\': \'Shrouded Shepherd\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631303&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2b96d909-0c67-406d-9ed9-b54b732fcb2b\', \'multiverseId\': 631303}, \'multiverseid\': 631303}, {\'name\': \'Shrouded Shepherd // 影丛辟路\', \'text\': \'当雾隐牧者进战场时，目标由你操控的生物得+2/+2直到回合结束。\', \'type\': \'生物 — 精怪／战士\', \'flavor\': None, \'faceName\': \'Shrouded Shepherd\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631564&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5cd68a91-ec38-4add-a35f-3f2ce4c37c21\', \'multiverseId\': 631564}, \'multiverseid\': 631564}]', '[{\'name\': \'Sich entfaltende Wildnis\', \'text\': \'{T}, opfere die Sich entfaltende Wildnis: Durchsuche deine Bibliothek nach einer Standardland-Karte, bringe sie getappt ins Spiel und mische danach.\', \'type\': \'Land\', \'flavor\': \'„Die Wildnis ist unberechenbar. Flüsse ändern ihren Lauf, Bäume krümmen sich, Felsen splittern und rollen davon. Aber auf eines kannst du zählen, Reisender — was sich am meisten ändert, bist du."\\n—Sturwynn, Waldläufer der Grenzlande\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630018&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4cb4583c-f033-4018-8fb9-2e79fcd00ebc\', \'multiverseId\': 630018}, \'multiverseid\': 630018}, {\'name\': \'Terrenos expansivos\', \'text\': \'{T}, sacrificar los Terrenos expansivos: Busca en tu biblioteca una carta de tierra básica, ponla en el campo de batalla girada y luego baraja.\', \'type\': \'Tierra\', \'flavor\': \'"Las tierras salvajes son impredecibles. Los ríos cambian de curso, los árboles se mueven y se doblan, y las piedras se dividen y escapan. Pero escúchame bien, viajero: lo que más cambiará serás tú".\\n—Sturwynn, arquero de las Tierras Fronterizas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630279&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6de92eb4-113c-447e-9167-12e15fee4cbb\', \'multiverseId\': 630279}, \'multiverseid\': 630279}, {\'name\': \'Étendues sauvages en évolution\', \'text\': \'{T}, sacrifiez les Étendues sauvages en évolution : Cherchez dans votre bibliothèque une carte de terrain de base, mettez-la sur le champ de bataille engagée, puis mélangez.\', \'type\': \'Terrain\', \'flavor\': "« Les friches sont imprévisibles. Les rivières changent de lit, les arbres bougent et se penchent, les rochers se brisent et s\'enfuient. Mais rappelle-toi ces paroles, voyageur. Ce qui va le plus changer dans les friches, c\'est toi. »\\n—Sturwynn, ranger des terres frontalières", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630540&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'115a3df2-21c0-4d02-992e-54b7c4b10a20\', \'multiverseId\': 630540}, \'multiverseid\': 630540}, {\'name\': \'Terre Selvagge in Evoluzione\', \'text\': \'{T}, Sacrifica le Terre Selvagge in Evoluzione: Passa in rassegna il tuo grimorio per una carta terra base, mettila sul campo di battaglia TAPpata, poi rimescola.\', \'type\': \'Terra\', \'flavor\': \'"Le terre selvagge sono imprevedibili. I fiumi cambiano il loro corso, gli alberi si agitano e si piegano, le rocce si rompono e franano. Ma sappi, caro viaggiatore, che la cosa che cambierà più di tutte sarai tu."\\n—Sturwynn, ranger delle Lande Estreme\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630801&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6c731e84-7da3-41ab-a1e4-6f3dfd235975\', \'multiverseId\': 630801}, \'multiverseid\': 630801}, {\'name\': \'進化する未開地\', \'text\': \'{T}, 進化する未開地を生け贄に捧げる：あなたのライブラリーから基本土地・カード１枚を探し、タップ状態で戦場に出す。その後、ライブラリーを切り直す。\', \'type\': \'土地\', \'flavor\': \'「僻境は常に変化し続けるものだ。川は流れを変え、木は歩いたり曲がったりし、岩は割れたり走り回ったりする。だがこれだけは忘れるな、旅人よ。お前自身こそが、ここで変わる最たるものなのだ。」\\n――境界地のレインジャー、スターウィン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631062&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'29df45fd-4b20-408d-bc75-f82d259f5e0e\', \'multiverseId\': 631062}, \'multiverseid\': 631062}, {\'name\': \'Terras em Desenvolvimento\', \'text\': \'{T}, sacrifique Terras em Desenvolvimento: Procure um card de terreno básico em seu grimório, coloque-o no campo de batalha virado e depois embaralhe.\', \'type\': \'Terreno\', \'flavor\': \'"As terras selvagens são imprevisíveis. Os rios mudam de curso, as árvores se agitam e se dobram, as rochas se partem e se deslocam. Mas escreve o que eu digo, viajante — o que mais vai mudar por lá é você."\\n— Sturwynn, Guardião das Terras Fronteiriças\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631323&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'88896e01-a9f5-41aa-b686-127618d03e8f\', \'multiverseId\': 631323}, \'multiverseid\': 631323}, {\'name\': \'成形野地\', \'text\': \'{T}，牺牲成形野地：从你牌库中搜寻一张基本地牌，将之横置放进战场，然后洗牌。\', \'type\': \'地\', \'flavor\': \'「诚然，幻野地势变幻多变：河流忽而改道，树木抽枝弯折，岩石开裂破碎。但旅人啊，请谨记我的话～在外会变的，主要是你自己。」\\n～边境地巡林客斯图温\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631584&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'039fbe43-4b0e-4699-a951-c359c3a4d5d6\', \'multiverseId\': 631584}, \'multiverseid\': 631584}]', '[{\'name\': \'Spellscorn Coven // Nimm das zurück\', \'text\': \'Fliegend\\nWenn der Zaubergroll-Zirkel ins Spiel kommt, wirft jeder Gegner eine Karte ab.\', \'type\': \'Kreatur — Feenwesen, Hexenmeister\', \'flavor\': None, \'faceName\': \'Spellscorn Coven\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629999&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4d64e552-db1e-4f9b-8ab9-4f55aeb9afad\', \'multiverseId\': 629999}, \'multiverseid\': 629999}, {\'name\': \'Spellscorn Coven // De vuelta\', \'text\': \'Vuela.\\nCuando el Aquelarre desdeñahechizos entre al campo de batalla, cada oponente descarta una carta.\', \'type\': \'Criatura — Brujo hada\', \'flavor\': None, \'faceName\': \'Spellscorn Coven\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630260&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9a1f4633-e78a-49f5-a717-005f53390235\', \'multiverseId\': 630260}, \'multiverseid\': 630260}, {\'name\': "Spellscorn Coven // Retour à l\'envoyeur", \'text\': "Vol\\nQuand la Congrégation méprise-sort arrive sur le champ de bataille, chaque adversaire se défausse d\'une carte.", \'type\': \'Créature — peuple fée et psychagogue\', \'flavor\': None, \'faceName\': \'Spellscorn Coven\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630521&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4c558a39-7fc1-4c4d-ac65-90c252ce90b5\', \'multiverseId\': 630521}, \'multiverseid\': 630521}, {\'name\': \'Spellscorn Coven // Rimangiatelo\', \'text\': \'Volare\\nQuando la Congrega Sdegnamagia entra nel campo di battaglia, ogni avversario scarta una carta.\', \'type\': \'Creatura — Warlock Spiritello\', \'flavor\': None, \'faceName\': \'Spellscorn Coven\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630782&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a36d6c36-3a4a-4645-8aeb-963606dd734e\', \'multiverseId\': 630782}, \'multiverseid\': 630782}, {\'name\': \'Spellscorn Coven // お返（かえ）し\', \'text\': \'飛行\\n呪文嘲りの集会が戦場に出たとき、各対戦相手はそれぞれカード１枚を捨てる。\', \'type\': \'クリーチャー — フェアリー・邪術師\', \'flavor\': None, \'faceName\': \'Spellscorn Coven\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631043&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'febb7333-0c9f-4f94-bc41-1db2daea8e8d\', \'multiverseId\': 631043}, \'multiverseid\': 631043}, {\'name\': \'Spellscorn Coven // Retomar\', \'text\': \'Voar\\nQuando Conventículo do Magiscárnio entra no campo de batalha, cada oponente descarta um card.\', \'type\': \'Criatura — Fada Bruxo\', \'flavor\': None, \'faceName\': \'Spellscorn Coven\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631304&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fb5c8f62-a51d-4656-b7e0-101bf9307cbc\', \'multiverseId\': 631304}, \'multiverseid\': 631304}, {\'name\': \'Spellscorn Coven // 收回重来\', \'text\': \'飞行\\n当克咒巫师群进战场时，每位对手各弃一张牌。\', \'type\': \'生物 — 仙灵／邪术师\', \'flavor\': None, \'faceName\': \'Spellscorn Coven\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631565&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2eebad06-3fca-41dd-96ea-c9e03c847cbb\', \'multiverseId\': 631565}, \'multiverseid\': 631565}]', '[{\'name\': \'Spießschleuderin\', \'text\': \'Reichweite\\nImmer wenn die Spießschleuderin eine Kreatur blockt oder von ihr geblockt wird, fügt die Spießschleuderin jener Kreatur 1 Schadenspunkt zu.\', \'type\': \'Kreatur — Zwerg, Ritter\', \'flavor\': \'Am Ende landen die Mahlzeiten der Zwerge immer irgendwie in einem Magen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629911&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fdc335b5-fcdd-4617-a2b8-6319577c5400\', \'multiverseId\': 629911}, \'multiverseid\': 629911}, {\'name\': \'Lanzadora de brochetas\', \'text\': \'Alcance.\\nSiempre que la Lanzadora de brochetas bloquee o sea bloqueada por una criatura, la Lanzadora de brochetas hace 1 punto de daño a esa criatura.\', \'type\': \'Criatura — Caballero enano\', \'flavor\': \'De un modo u otro, las comidas de los enanos acaban en el estómago de alguien.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630172&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'97c6b9f8-d2ba-4834-b19c-64568d075da4\', \'multiverseId\': 630172}, \'multiverseid\': 630172}, {\'name\': \'Frondeuse de brochettes\', \'text\': \'Portée\\nÀ chaque fois que la Frondeuse de brochettes bloque ou devient bloquée par une créature, la Frondeuse de brochettes inflige 1 blessure à cette créature.\', \'type\': \'Créature — nain et chevalier\', \'flavor\': "D\'une manière ou d\'une autre, les repas des nains finissent dans le ventre de quelqu\'un.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630433&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f0b31e7a-4b8a-4209-8554-34e2e2469386\', \'multiverseId\': 630433}, \'multiverseid\': 630433}, {\'name\': \'Scagliaspiedi\', \'text\': \'Raggiungere\\nOgniqualvolta la Scagliaspiedi blocca o viene bloccata da una creatura, la Scagliaspiedi infligge 1 danno a quella creatura.\', \'type\': \'Creatura — Cavaliere Nano\', \'flavor\': "In un modo o nell\'altro, i pasti nanici finiscono sempre nello stomaco di qualcuno.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630694&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a66791b1-4962-40c3-a2a6-feeba158785b\', \'multiverseId\': 630694}, \'multiverseid\': 630694}, {\'name\': \'串焼き投げ\', \'text\': \'到達\\n串焼き投げがクリーチャー１体をブロックするかクリーチャー１体にブロックされた状態になるたび、串焼き投げはそのクリーチャーに１点のダメージを与える。\', \'type\': \'クリーチャー — ドワーフ・騎士\', \'flavor\': \'どのみちドワーフの食事は誰かの胃袋に収まるものだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630955&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ecfa38b2-d951-465a-8855-0bb4eb667075\', \'multiverseId\': 630955}, \'multiverseid\': 630955}, {\'name\': \'Arremessadora de Espetos\', \'text\': \'Alcance\\nToda vez que Arremessadora de Espetos bloqueia ou é bloqueada por uma criatura, Arremessadora de Espetos causa 1 ponto de dano àquela criatura.\', \'type\': \'Criatura — Anão Cavaleiro\', \'flavor\': \'De um jeito ou de outro, as refeições dos anões sempre acabam no estômago de alguém.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631216&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b0f719c2-db4d-4d06-a871-00278185c1eb\', \'multiverseId\': 631216}, \'multiverseid\': 631216}, {\'name\': \'烤叉掷客\', \'text\': \'延势\\n每当烤叉掷客阻挡生物或被生物阻挡时，烤叉掷客对该生物造成1点伤害。\', \'type\': \'生物 — 矮人／骑士\', \'flavor\': \'不管怎样，矮人总有办法把食物塞进别人的肚子里。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631477&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0a3cb70c-1e2e-4f53-89fa-d123eb6a007b\', \'multiverseId\': 631477}, \'multiverseid\': 631477}]', '[{\'name\': \'Spinnenfutter\', \'text\': \'Zerstöre bis zu ein Artefakt, eine Verzauberung oder eine fliegende Kreatur deiner Wahl. Erzeuge einen Speise-Spielstein. (Er ist ein Artefakt mit „{2}, {T}, opfere dieses Artefakt: Du erhältst 3 Lebenspunkte dazu.")\', \'type\': \'Hexerei\', \'flavor\': \'Für die Riesenspinnen des Düstermoors gab es kaum einen Unterschied zwischen einer Fliege und einer Fee.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629948&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7595befd-3bcb-4049-b2fa-9cd3abbd29b1\', \'multiverseId\': 629948}, \'multiverseid\': 629948}, {\'name\': \'Comida de araña\', \'text\': \'Destruye hasta un artefacto, encantamiento o criatura con la habilidad de volar objetivo. Crea una ficha de Comida. (Es un artefacto con "{2}, {T}, sacrificar este artefacto: Ganas 3 vidas".)\', \'type\': \'Conjuro\', \'flavor\': \'Para las arañas gigantes de Túmulo Pardo, no hay apenas diferencia entre una mosca y un hada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630209&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fde8db57-4103-49d5-a334-63d984a3b6d0\', \'multiverseId\': 630209}, \'multiverseid\': 630209}, {\'name\': \'Chair pour araignée\', \'text\': "Détruisez jusqu\'à une cible, artefact, enchantement ou créature avec le vol. Créez un jeton Nourriture. (C\'est un artefact avec « {2}, {T}, sacrifiez cet artefact : Vous gagnez 3 points de vie. »)", \'type\': \'Rituel\', \'flavor\': \'Pour les araignées géantes de Tertrebrun, il y a peu de différences entre une mouche et une færie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630470&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e0d3278b-553a-47d2-ad46-1190b9e50b15\', \'multiverseId\': 630470}, \'multiverseid\': 630470}, {\'name\': \'Cibo per Ragni\', \'text\': \'Distruggi fino a un artefatto, un incantesimo o una creatura con volare bersaglio. Crea una pedina Cibo. (È un artefatto con "{2}, {T}, Sacrifica questo artefatto: Guadagni 3 punti vita".)\', \'type\': \'Stregoneria\', \'flavor\': "Per i ragni giganti di Tumulo Grigio, c\'è poca differenza tra mosca e spiritello.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630731&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c6d5f0ec-2786-4179-9bf3-3fe62475c2fc\', \'multiverseId\': 630731}, \'multiverseid\': 630731}, {\'name\': \'蜘蛛の食事\', \'text\': \'アーティファクトやエンチャントや、飛行を持つクリーチャーのうち最大１つを対象とする。それを破壊する。食物・トークン１つを生成する。（それは、「{2}, {T}, このアーティファクトを生け贄に捧げる：あなたは３点のライフを得る。」を持つアーティファクトである。）\', \'type\': \'ソーサリー\', \'flavor\': \'ダンバロウの巨大な蜘蛛にとって、蠅もフェアリーもほとんど変わらない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630992&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'260e5987-c161-4716-9388-95b06bb1e3c3\', \'multiverseId\': 630992}, \'multiverseid\': 630992}, {\'name\': \'Comida de Aranha\', \'text\': \'Destrua até um artefato, um encantamento ou uma criatura com voar alvo. Crie uma ficha de Comida. (Ela é um artefato com "{2}, {T}, sacrifique este artefato: Você ganha 3 pontos de vida".)\', \'type\': \'Feitiço\', \'flavor\': \'Para as aranhas gigantes de Tumbagris, é pequena a diferença entre moscas e fadas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631253&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4f21c68e-8f93-4a63-8940-2d46dca76a33\', \'multiverseId\': 631253}, \'multiverseid\': 631253}, {\'name\': \'蜘蛛猎物\', \'text\': \'消灭至多一个目标神器，结界或具飞行异能的生物。派出一个食品衍生物。（它是具有「{2}，{T}，牺牲此神器：你获得3点生命」的神器。）\', \'type\': \'法术\', \'flavor\': \'对黯沼野的巨型蜘蛛来说，苍蝇与仙灵并无太大差别。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631514&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a3ee34e5-cd3f-4e60-ad62-57303b051a67\', \'multiverseId\': 631514}, \'multiverseid\': 631514}]', '[{\'name\': \'Spottende Sylphide\', \'text\': \'Fliegend\\nSpontanzauber und Hexereien, die du wirkst, kosten beim Wirken {1} weniger.\', \'type\': \'Kreatur — Feenwesen, Räuber\', \'flavor\': \'„Sehr her, alle miteinander! Ich bin eine Hochfee! Schaut zu, wie ich wichtige Hochfeen-Dinge vollbringe!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629824&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c1355c26-14a9-457a-a999-9880fe0967c2\', \'multiverseId\': 629824}, \'multiverseid\': 629824}, {\'name\': \'Hada burlona\', \'text\': \'Vuela.\\nTe cuesta {1} menos lanzar hechizos de instantáneo o de conjuro.\', \'type\': \'Criatura — Bribón hada\', \'flavor\': \'"¡Que todos me miren! ¡Soy una gran hada! ¡Miren cómo hago cosas importantes de gran hada!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630085&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fc1b7356-b6b9-4777-bcb9-22168d7342a6\', \'multiverseId\': 630085}, \'multiverseid\': 630085}, {\'name\': \'Farfadette moqueuse\', \'text\': "Vol\\nLes sorts d\'éphémère et de rituel que vous lancez coûtent {1} de moins à lancer.", \'type\': \'Créature — peuple fée et gredin\', \'flavor\': \'« Regardez-moi ! Je suis un Haut Fæ ! Regardez moi faire des trucs importants de Haut Fæ ! »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630346&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c46ad591-d0d9-42c5-8e74-12f80c088651\', \'multiverseId\': 630346}, \'multiverseid\': 630346}, {\'name\': \'Folletta Beffarda\', \'text\': \'Volare\\nLe magie istantaneo e stregoneria che lanci costano {1} in meno per essere lanciate.\', \'type\': \'Creatura — Farabutto Spiritello\', \'flavor\': \'"Guardatemi! Sono un\\\'Alta Fata! Guardatemi mentre faccio le cose importanti delle Alte Fate!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630607&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ed70dae6-1a24-4eed-9a62-b765fc16d6ad\', \'multiverseId\': 630607}, \'multiverseid\': 630607}, {\'name\': \'嘲笑するスプライト\', \'text\': \'飛行\\nあなたがインスタントやソーサリーである呪文を唱えるためのコストは{1}少なくなる。\', \'type\': \'クリーチャー — フェアリー・ならず者\', \'flavor\': \'「ホラみんな、見て見て！ハイフェイだよ！今からハイフェイみたいに大事なことをしまーす！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630868&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'86978271-e52f-456d-8749-16df9209ee99\', \'multiverseId\': 630868}, \'multiverseid\': 630868}, {\'name\': \'Sílfide Zombeteira\', \'text\': \'Voar\\nAs mágicas instantâneas e os feitiços que você conjura custam {1} a menos para conjurar.\', \'type\': \'Criatura — Fada Ladino\', \'flavor\': \'"Olha pra mim, todo mundo! Eu sou uma Alta Fadina! Olha eu fazendo coisas importantes que as Altas Fadinas fazem!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631129&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6dd1b130-0155-4317-8e71-96a186b794d3\', \'multiverseId\': 631129}, \'multiverseid\': 631129}, {\'name\': \'嘲讽仙子\', \'text\': \'飞行\\n你施放的瞬间与法术咒语减少{1}来施放。\', \'type\': \'生物 — 仙灵／浪客\', \'flavor\': \'「大家来看呐！我是至高仙！看我作至高仙会作的事！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631390&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f2831bd7-5e88-4c9c-ab37-331fff96ce3b\', \'multiverseId\': 631390}, \'multiverseid\': 631390}]', '[{\'name\': \'Sprung aus dem Hinterhalt\', \'text\': \'Eine Kreatur deiner Wahl erhält +1/+3 und Reichweite bis zum Ende des Zuges. Enttappe sie.\', \'type\': \'Spontanzauber\', \'flavor\': \'Hexenjäger haben sehr starke Beine — damit sie dich besser anspringen können.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629939&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'07b2045a-9a6b-4e5d-8d02-c65612262f38\', \'multiverseId\': 629939}, \'multiverseid\': 629939}, {\'name\': \'Emboscada saltarina\', \'text\': \'La criatura objetivo obtiene +1/+3 y gana la habilidad de alcance hasta el final del turno. Enderézala.\', \'type\': \'Instantáneo\', \'flavor\': \'Los acechabrujas tienen unas patas muy potentes... para alcanzarte mejor.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630200&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b3ffab90-23eb-4069-bcfc-dd14a6ed8328\', \'multiverseId\': 630200}, \'multiverseid\': 630200}, {\'name\': \'Embuscade bondissante\', \'text\': "Une créature ciblée gagne +1/+3 et acquiert la portée jusqu\'à la fin du tour. Dégagez-la.", \'type\': \'Éphémère\', \'flavor\': \'Les pisteurs de sorcière ont des pattes très puissantes—pour mieux vous attraper.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630461&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'791acf8d-22a7-4f8b-bed8-a74d5fef58c8\', \'multiverseId\': 630461}, \'multiverseid\': 630461}, {\'name\': \'Imboscata Balzante\', \'text\': \'Una creatura bersaglio prende +1/+3 e ha raggiungere fino alla fine del turno. STAPpala.\', \'type\': \'Istantaneo\', \'flavor\': \'I braccastreghe hanno gambe poderose, per raggiungerti meglio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630722&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'277166e6-627f-49ac-b8ca-a106d99a688e\', \'multiverseId\': 630722}, \'multiverseid\': 630722}, {\'name\': \'跳び上がる奇襲\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋１/＋３の修整を受け到達を得る。それをアンタップする。\', \'type\': \'インスタント\', \'flavor\': \'獲物に到達できるよう、魔女跡追いはとても強靭な脚をしている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630983&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8f854799-ee50-47d9-998e-a610b6e06cea\', \'multiverseId\': 630983}, \'multiverseid\': 630983}, {\'name\': \'Emboscada num Salto\', \'text\': \'A criatura alvo recebe +1/+3 e ganha alcance até o final do turno. Desvire-a.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os farejadores de bruxa têm pernas muito potentes, para lhe alcançar melhor.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631244&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ce26d8d0-7aa4-4627-ad84-3ba985e5286a\', \'multiverseId\': 631244}, \'multiverseid\': 631244}, {\'name\': \'扑跃突袭\', \'text\': \'直到回合结束，目标生物得+1/+3且获得延势异能。将它重置。\', \'type\': \'瞬间\', \'flavor\': \'猎巫狼的四肢都无比强壮～这样便能更快地抓到你。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631505&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'49352f85-efc5-45c0-958a-58e38013628f\', \'multiverseId\': 631505}, \'multiverseid\': 631505}]', '[{\'name\': \'Spur aus Süßigkeiten\', \'text\': \'Wenn die Spur aus Süßigkeiten ins Spiel kommt, wende Hellsicht 2 an.\\n{2}, {T}, opfere die Spur aus Süßigkeiten: Du erhältst 3 Lebenspunkte dazu und ziehst eine Karte.\', \'type\': \'Artefakt — Speise, Hinweis\', \'flavor\': \'„Schau! Noch eins! Wen kümmert es schon, was Mutter sagt? Bis sie nach Hause kommt, sind wir längst zurück."\\n—Daniela, Jugendliche aus Wallstädt\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630005&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9f6d11ce-91c3-49dd-af5c-3f016c7f45e8\', \'multiverseId\': 630005}, \'multiverseid\': 630005}, {\'name\': \'Rastro de dulces\', \'text\': \'Cuando el Rastro de dulces entre al campo de batalla, adivina 2.\\n{2}, {T}, sacrificar el Rastro de dulces: Ganas 3 vidas y robas una carta.\', \'type\': \'Artefacto — Pista comida\', \'flavor\': \'"¡Mira! ¡Otro más! ¿Qué más da lo que dijo madre? Regresaremos a casa antes de que vuelva".\\n—Daniela, joven de Extremuro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630266&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fcd85f11-a750-4ed2-ba2e-650185cb7038\', \'multiverseId\': 630266}, \'multiverseid\': 630266}, {\'name\': \'Sentier sucré\', \'text\': \'Quand le Sentier sucré arrive sur le champ de bataille, regard 2.\\n{2}, {T}, sacrifiez le Sentier sucré : Vous gagnez 3 points de vie et vous piochez une carte.\', \'type\': \'Artefact — nourriture et indice\', \'flavor\': "« Regarde ! Encore un ! Peu importe ce que Mère a dit ! Nous serons rentrés avant qu\'elle ne revienne. »\\n—Daniela, enfant de Bornemur", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630527&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0679063e-5bc9-44eb-95fd-d2108f609607\', \'multiverseId\': 630527}, \'multiverseid\': 630527}, {\'name\': \'Scia di Dolciumi\', \'text\': \'Quando la Scia di Dolciumi entra nel campo di battaglia, profetizza 2.\\n{2}, {T}, Sacrifica la Scia di Dolciumi: Guadagni 3 punti vita e peschi una carta.\', \'type\': \'Artefatto — Indizio Cibo\', \'flavor\': \'"Guardate! Ce n\\\'è un altro! Chi se ne importa di cosa ha detto la mamma? Saremo a casa prima che sia tornata."\\n—Daniela, giovane di Estremuro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630788&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'679f4a63-b32b-443c-9711-0c86dd8ca943\', \'multiverseId\': 630788}, \'multiverseid\': 630788}, {\'name\': \'キャンディーの道標\', \'text\': \'キャンディーの道標が戦場に出たとき、占術２を行う。\\n{2}, {T}, キャンディーの道標を生け贄に捧げる：あなたは３点のライフを得、カード１枚を引く。\', \'type\': \'アーティファクト — 食物・手掛かり\', \'flavor\': \'「見て！またあったよ！ママの言いつけなんて知らないわ。ママが帰ってくる前に戻ればいいんでしょ？」\\n――エッジウォールの少女、ダニエラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631049&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'53959c8f-0af9-443a-af18-2cea40b3b76e\', \'multiverseId\': 631049}, \'multiverseid\': 631049}, {\'name\': \'Trilha de Doces\', \'text\': \'Quando Trilha de Doces entrar no campo de batalha, use vidência 2.\\n{2}, {T}, sacrifique Trilha de Doces: Você ganha 3 pontos de vida e compra um card.\', \'type\': \'Artefato — Comida Pista\', \'flavor\': \'"Olhe! Outro! Quem liga pro que a mamãe disse? A gente volta pra casa antes dela."\\n— Daniela, jovem de Beiramuro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631310&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'91108648-184c-465a-89fc-8c16a22d2fbf\', \'multiverseId\': 631310}, \'multiverseid\': 631310}, {\'name\': \'糖果小径\', \'text\': \'当糖果小径进战场时，占卜2。\\n{2}，{T}，牺牲糖果小径：你获得3点生命且抓一张牌。\', \'type\': \'神器 — 食品／线索\', \'flavor\': \'「看呐！又一颗！谁还把妈妈说过的话放心上？我们在她回来之前就到家。」\\n～边墙镇少女丹妮拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631571&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3c8cdf87-eaad-4a79-83e3-e352285760ef\', \'multiverseId\': 631571}, \'multiverseid\': 631571}]', '[{\'name\': \'Stachelklingen-Assassine\', \'text\': \'Aufblitzen\\nFliegend\\nWenn der Stachelklingen-Assassine ins Spiel kommt, zerstöre eine Kreatur deiner Wahl, die ein Gegner kontrolliert und der in diesem Zug Schaden zugefügt wurde.\', \'type\': \'Kreatur — Feenwesen, Assassine\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629871&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8ec9d8e4-972a-4b41-b033-c722a05613f9\', \'multiverseId\': 629871}, \'multiverseid\': 629871}, {\'name\': \'Asesina hojaguijón\', \'text\': \'Destello.\\nVuela.\\nCuando la Asesina hojaguijón entre al campo de batalla, destruye la criatura objetivo que controla un oponente y que haya recibido daño este turno.\', \'type\': \'Criatura — Asesino hada\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630132&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cbb82cd1-cd13-4fec-a8b4-937b883f6b59\', \'multiverseId\': 630132}, \'multiverseid\': 630132}, {\'name\': \'Assassin au lamedard\', \'text\': "Flash\\nVol\\nQuand l\'Assassin au lamedard arrive sur le champ de bataille, détruisez une créature ciblée qu\'un adversaire contrôle qui a subi des blessures ce tour-ci.", \'type\': \'Créature — peuple fée et assassin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630393&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'24d0ec93-85ae-43f0-8ee7-0b3dcb46be1c\', \'multiverseId\': 630393}, \'multiverseid\': 630393}, {\'name\': \'Assassino Pungilama\', \'text\': "Lampo\\nVolare\\nQuando l\'Assassino Pungilama entra nel campo di battaglia, distruggi una creatura bersaglio a cui è stato inflitto danno in questo turno controllata da un avversario.", \'type\': \'Creatura — Assassino Spiritello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630654&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cb51d533-8919-40a4-af2b-7040d7f4d3fe\', \'multiverseId\': 630654}, \'multiverseid\': 630654}, {\'name\': \'針刃の暗殺者\', \'text\': \'瞬速\\n飛行\\n針刃の暗殺者が戦場に出たとき、対戦相手がコントロールしていてこのターンにダメージを受けたクリーチャー１体を対象とする。それを破壊する。\', \'type\': \'クリーチャー — フェアリー・暗殺者\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630915&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'efdac85f-a111-4622-9a4d-5687bd2b60a0\', \'multiverseId\': 630915}, \'multiverseid\': 630915}, {\'name\': \'Assassino da Lâmina-ferrão\', \'text\': \'Lampejo\\nVoar\\nQuando Assassino da Lâmina-ferrão entrar no campo de batalha, destrua a criatura alvo que um oponente controla que sofreu dano neste turno.\', \'type\': \'Criatura — Fada Assassino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631176&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'68543132-d9e2-4a98-90e8-6becbcb1df73\', \'multiverseId\': 631176}, \'multiverseid\': 631176}, {\'name\': \'叮刃杀手\', \'text\': \'闪现\\n飞行\\n当叮刃杀手进战场时，消灭目标由对手操控的生物，且须为本回合中受过伤害者。\', \'type\': \'生物 — 仙灵／杀手\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631437&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'859c611b-0d03-42a6-8c7f-e61783926419\', \'multiverseId\': 631437}, \'multiverseid\': 631437}]', '[{\'name\': \'Steinspaltender Blitz\', \'text\': \'Feilschen (Du kannst ein Artefakt, eine Verzauberung oder einen Spielstein opfern, sowie du diesen Zauberspruch wirkst.)\\nDer Steinspaltende Blitz fügt einer Kreatur oder einem Planeswalker deiner Wahl X Schadenspunkte zu. Falls um diesen Zauberspruch gefeilscht wurde, fügt er jener bleibenden Karte stattdessen zweimal X Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629913&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9da77f7c-37e0-4eae-b1cd-4bc7619c6e9c\', \'multiverseId\': 629913}, \'multiverseid\': 629913}, {\'name\': \'Rayo partepiedras\', \'text\': \'Negociar. (Puedes sacrificar un artefacto, encantamiento o ficha al lanzar este hechizo.)\\nEl Rayo partepiedras hace X puntos de daño a la criatura o planeswalker objetivo. Si este hechizo fue negociado, en vez de eso, hace el doble de X puntos de daño a ese permanente.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630174&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d64ddaeb-8ffb-42db-9e15-b0b27c3d8473\', \'multiverseId\': 630174}, \'multiverseid\': 630174}, {\'name\': \'Éclair scinde-pierre\', \'text\': "Négociation (Vous pouvez sacrifier un artefact, un enchantement ou un jeton au moment où vous lancez ce sort.)\\nL\'Éclair scinde-pierre inflige X blessures à une cible, créature ou planeswalker. Si ce sort a été négocié, il inflige deux fois X blessures à ce permanent à la place.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630435&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ae4b5aa7-b802-4fc0-9cb9-2e4152fd4e6b\', \'multiverseId\': 630435}, \'multiverseid\': 630435}, {\'name\': \'Saetta Fendipietra\', \'text\': \'Negoziare (Puoi sacrificare un artefatto, un incantesimo o una pedina mentre lanci questa magia.)\\nLa Saetta Fendipietra infligge X danni a una creatura o a un planeswalker bersaglio. Se questa magia è stata negoziata, infligge invece danni pari al doppio di X a quel permanente.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630696&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b84ed3ae-e3a9-41e6-b775-72360a36cd08\', \'multiverseId\': 630696}, \'multiverseid\': 630696}, {\'name\': \'石断ちの稲妻\', \'text\': \'協約（この呪文を唱えるに際し、アーティファクトやエンチャントやトークンのうち１つを生け贄に捧げてもよい。）\\nクリーチャーやプレインズウォーカーのうち１体を対象とする。石断ちの稲妻はそれにＸ点のダメージを与える。この呪文が協約されていたなら、代わりに、これはそのパーマネントにＸの２倍の点数のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630957&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c3c2a48a-047e-48a2-8367-ba76aa1f78fb\', \'multiverseId\': 630957}, \'multiverseid\': 630957}, {\'name\': \'Virote Lasca-pedra\', \'text\': \'Negociar (Você pode sacrificar um artefato, um encantamento ou uma ficha conforme conjura esta mágica.)\\nVirote Lasca-pedra causa X pontos de dano à criatura ou ao planeswalker alvo. Se esta mágica foi negociada, ela causa, em vez disso, duas vezes X pontos de dano àquela permanente.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631218&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'850cec5b-9d80-4b21-8bf2-34cc4652e3e6\', \'multiverseId\': 631218}, \'multiverseid\': 631218}, {\'name\': \'裂石击\', \'text\': \'加码（你施放此咒语时可以牺牲一个神器，结界或衍生物。）\\n裂石击对目标生物或鹏洛客造成X点伤害。如果此咒语已加码，则改为它对该永久物造成两倍于X数量的伤害。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631479&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8059dde0-4d84-4596-a2e4-52795d75f8cc\', \'multiverseId\': 631479}, \'multiverseid\': 631479}]', '[{\'name\': \'Stormkeld Vanguard // Übärwältigen\', \'text\': \'Die Sturmquell-Vorhut kann von Kreaturen mit Stärke 2 oder weniger nicht geblockt werden.\', \'type\': \'Kreatur — Riese, Krieger\', \'flavor\': \'Er reitet wie Donner und schlägt ein wie der Blitz.\', \'faceName\': \'Stormkeld Vanguard\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629949&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b063f5df-6fdd-4f9e-aabe-4cb8aa79cf98\', \'multiverseId\': 629949}, \'multiverseid\': 629949}, {\'name\': \'Stormkeld Vanguard // ¿Quién osa?\', \'text\': \'La Vanguardia de Fuentetormentas no puede ser bloqueada por criaturas con fuerza de 2 o menos.\', \'type\': \'Criatura — Guerrero gigante\', \'flavor\': \'Veloz como el rayo y fuerte como el trueno.\', \'faceName\': \'Stormkeld Vanguard\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630210&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ce7d2d08-16a4-41bb-aa4e-d558a616e577\', \'multiverseId\': 630210}, \'multiverseid\': 630210}, {\'name\': \'Stormkeld Vanguard // Accabler\', \'text\': "L\'Avant-garde de Foudrekeld ne peut pas être bloquée par des créatures de force inférieure ou égale à 2.", \'type\': \'Créature — géant et guerrier\', \'flavor\': "Il chevauche tel le tonnerre et frappe comme l\'éclair.", \'faceName\': \'Stormkeld Vanguard\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630471&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'95bf499a-9cbf-4b3a-a445-74065120a704\', \'multiverseId\': 630471}, \'multiverseid\': 630471}, {\'name\': \'Stormkeld Vanguard // Tirare Giù\', \'text\': "L\'Avanguardia di Nimborgo non può essere bloccata da creature con forza pari o inferiore a 2.", \'type\': \'Creatura — Guerriero Gigante\', \'flavor\': \'Corre come il tuono e colpisce come il fulmine.\', \'faceName\': \'Stormkeld Vanguard\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630732&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5740842b-e7b8-49b0-a9c4-0911867c5cad\', \'multiverseId\': 630732}, \'multiverseid\': 630732}, {\'name\': \'Stormkeld Vanguard // 熊（くま）の踏（ふ）みつけ\', \'text\': \'ストームケルドの先兵は、パワーが２以下であるクリーチャーにはブロックされない。\', \'type\': \'クリーチャー — 巨人・戦士\', \'flavor\': \'稲妻のように駆け抜け、落雷のように叩く。\', \'faceName\': \'Stormkeld Vanguard\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630993&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0d5710c9-b9d8-4cd7-bcb6-a615fe88cd15\', \'multiverseId\': 630993}, \'multiverseid\': 630993}, {\'name\': \'Stormkeld Vanguard // Jogar o Peso\', \'text\': \'Vanguarda de Tempesburgo não pode ser bloqueada por criaturas com poder igual ou inferior a 2.\', \'type\': \'Criatura — Gigante Guerreiro\', \'flavor\': \'Ele cavalga como o trovão e golpeia como o relâmpago.\', \'faceName\': \'Stormkeld Vanguard\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631254&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f29101dd-0da6-4168-9d74-4745d174bd6c\', \'multiverseId\': 631254}, \'multiverseid\': 631254}, {\'name\': \'Stormkeld Vanguard // 熊力出击\', \'text\': \'暴风域先锋不能被力量等于或小于2的生物阻挡。\', \'type\': \'生物 — 巨人／战士\', \'flavor\': \'他驱熊如雷鸣，出击似闪电。\', \'faceName\': \'Stormkeld Vanguard\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631515&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'64a67d87-2c94-4175-8ad3-f15f4d4e47c4\', \'multiverseId\': 631515}, \'multiverseid\': 631515}]', '[{\'name\': \'Stotterzauber\', \'text\': \'Neutralisiere einen Zauberspruch deiner Wahl, es sei denn, sein Beherrscher bezahlt {2} plus zusätzlich {1} für jedes Feenwesen, das du kontrollierst.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Sterblicher, du lernst gerade mal laufen in einer Welt, in der ich bereits fliegen kann."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629831&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9281f00e-4ea8-489b-b1c6-2d857911dc66\', \'multiverseId\': 629831}, \'multiverseid\': 629831}, {\'name\': \'Tartamudear el hechizo\', \'text\': \'Contrarresta el hechizo objetivo a menos que su controlador pague {2} más {1} adicional por cada Hada que controlas.\', \'type\': \'Instantáneo\', \'flavor\': \'"Estás aprendiendo a caminar en un mundo en el que yo vuelo, mortal".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630092&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'41eb5b79-8ffe-49f1-918a-d934f0fdc8a9\', \'multiverseId\': 630092}, \'multiverseid\': 630092}, {\'name\': \'Crachotage de sort\', \'text\': \'Contrecarrez un sort ciblé à moins que son contrôleur ne paie {2} plus {1} supplémentaire pour chaque peuple fée que vous contrôlez.\', \'type\': \'Éphémère\', \'flavor\': \'« Tu commences à peine à marcher dans un monde où je vole, mortel. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630353&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0fce7a3d-32ae-405d-b374-a79be6b925ae\', \'multiverseId\': 630353}, \'multiverseid\': 630353}, {\'name\': \'Farfugliamagie\', \'text\': \'Neutralizza una magia bersaglio a meno che il suo controllore non paghi {2} più {1} addizionale per ogni Spiritello che controlli.\', \'type\': \'Istantaneo\', \'flavor\': \'"Tu a malapena cammini in un mondo dove io volo, mortale."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630614&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1f76429b-246c-44a7-901f-2692d03aa37c\', \'multiverseId\': 630614}, \'multiverseid\': 630614}, {\'name\': \'呪文どもり\', \'text\': \'呪文１つを対象とする。それのコントローラーが、{2}にあなたがコントロールしているフェアリー１体につき{1}を足して支払わないかぎり、それを打ち消す。\', \'type\': \'インスタント\', \'flavor\': \'「定命の者よ、貴様は我が自由に飛び回れる世界で、やっと歩くことを覚えたにすぎない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630875&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a1f6c018-6c00-4a29-8616-88bacc2c0388\', \'multiverseId\': 630875}, \'multiverseid\': 630875}, {\'name\': \'Gagueira Mágica\', \'text\': \'Anule a mágica alvo, a menos que seu controlador pague {2} mais {1} adicional por cada Fada que você controla.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Você ainda está aprendendo a andar, mas neste mundo eu voo, mortal."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631136&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e1b12014-7f43-4e3e-99f9-6026c2580fb8\', \'multiverseId\': 631136}, \'multiverseid\': 631136}, {\'name\': \'咒语缠结\', \'text\': \'除非目标咒语的操控者支付{2}，并为每个由你操控的各支付{1}，否则反击之。\', \'type\': \'瞬间\', \'flavor\': \'「凡人，在这个我能自如飞行的世界中，你才刚蹒跚学步而已。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631397&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9deb187d-11c5-473d-a024-4ae353b13f2e\', \'multiverseId\': 631397}, \'multiverseid\': 631397}]', '[{\'name\': \'Sturmquell-Herumtreiberin\', \'text\': \'Immer wenn du einen Zauberspruch mit Manabetrag 5 oder mehr wirkst, lege zwei +1/+1-Marken auf die Sturmquell-Herumtreiberin.\', \'type\': \'Kreatur — Mensch, Räuber\', \'flavor\': \'Für die Riesen war es nur ein kleines Juwel von Tausenden. Aber für Kylene war es eine Beute, die ihre Familie jahrelang ernähren würde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629833&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9295cdac-ead4-4c79-ac08-03f6a942e1cd\', \'multiverseId\': 629833}, \'multiverseid\': 629833}, {\'name\': \'Rondadora de Fuentetormentas\', \'text\': \'Siempre que lances un hechizo con valor de maná de 5 o más, pon dos contadores +1/+1 sobre la Rondadora de Fuentetormentas.\', \'type\': \'Criatura — Bribón humano\', \'flavor\': \'Para los gigantes, era tan solo una pequeña gema entre miles. Pero para Kylene, era un botín que daría de comer a su familia durante años.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630094&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'542f312c-c980-48b6-9c22-d1aca7f70a3f\', \'multiverseId\': 630094}, \'multiverseid\': 630094}, {\'name\': \'Rôdeuse de Foudrekeld\', \'text\': \'À chaque fois que vous lancez un sort avec une valeur de mana supérieure ou égale à 5, mettez deux marqueurs +1/+1 sur la Rôdeuse de Foudrekeld.\', \'type\': \'Créature — humain et gredin\', \'flavor\': "Pour les géants, c\'était une petite gemme parmi des milliers. Mais pour Kylène, c\'était un butin qui nourrirait sa famille pendant des années.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630355&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'68a995f2-3c35-41d7-8ace-35667cde670d\', \'multiverseId\': 630355}, \'multiverseid\': 630355}, {\'name\': \'Predatrice di Nimborgo\', \'text\': \'Ogniqualvolta lanci una magia con valore di mana pari o superiore a 5, metti due segnalini +1/+1 sulla Predatrice di Nimborgo.\', \'type\': \'Creatura — Farabutto Umano\', \'flavor\': \'Per i giganti, era una piccola gemma come tante. Ma per Kylene, era un bottino che avrebbe sfamato la sua famiglia per anni.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630616&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8b76398b-b015-4b43-89b3-40886ed1752a\', \'multiverseId\': 630616}, \'multiverseid\': 630616}, {\'name\': \'ストームケルドのこそ泥\', \'text\': \'あなたがマナ総量が５以上である呪文１つを唱えるたび、ストームケルドのこそ泥の上に＋１/＋１カウンター２個を置く。\', \'type\': \'クリーチャー — 人間・ならず者\', \'flavor\': \'巨人にとっては、幾千もの宝石の中の小さな一粒でしかなかった。しかしカイリーンにとっては、家族をこの先何年も養うことのできる財宝だった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630877&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cebb55f4-a9b4-4ef8-a6e3-e4e032449191\', \'multiverseId\': 630877}, \'multiverseid\': 630877}, {\'name\': \'Espreitadora de Tempesburgo\', \'text\': \'Toda vez que você conjurar uma mágica com valor de mana igual ou superior a 5, coloque dois marcadores +1/+1 em Espreitadora de Tempesburgo.\', \'type\': \'Criatura — Humano Ladino\', \'flavor\': \'Para os gigantes, era apenas uma pequena gema entre milhares. Mas, para Kylene, era um roubo que alimentaria sua família por anos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631138&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'550423f0-1afe-489a-8246-6f53d4339c68\', \'multiverseId\': 631138}, \'multiverseid\': 631138}, {\'name\': \'风暴域游掠者\', \'text\': \'每当你施放法术力值等于或大于5的咒语时，在风暴域游掠者上放置两个+1/+1指示物。\', \'type\': \'生物 — 人类／浪客\', \'flavor\': \'对巨人来说，这宝石不过是他们不计其数珍宝其中不起眼的一颗。但对奇莲来说，这就是一笔能够让她和家人多年间不愁吃穿的巨大财富。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631399&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a58ca4d5-fba0-4d34-afbf-21cd1482311f\', \'multiverseId\': 631399}, \'multiverseid\': 631399}]', '[{\'name\': \'Sturz in den Winter\', \'text\': \'Tappe bis zu eine Kreatur deiner Wahl. Hellsicht 1, ziehe dann eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'Als Hylda Loch Larent einfror, um ihren Palast zu bauen, tauchten einige Meervolk tief genug, um der Kälte zu entkommen. Andere hatten weniger Glück.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629784&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'32fe35d3-9bd4-427b-af7f-91859036b793\', \'multiverseId\': 629784}, \'multiverseid\': 629784}, {\'name\': \'Sumergir en el invierno\', \'text\': \'Gira hasta una criatura objetivo. Adivina 1, luego roba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'Cuando Hylda congeló el lago Larent para crear su palacio, algunos tritones se sumergieron a tanta profundidad que pudieron escapar del frío. Otros no tuvieron tanta suerte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630045&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'981a9306-ed4a-47ff-a5b1-324184d2ab79\', \'multiverseId\': 630045}, \'multiverseid\': 630045}, {\'name\': "Plonger dans l\'hiver", \'text\': "Engagez jusqu\'à une créature ciblée. Regard 1, puis piochez une carte.", \'type\': \'Éphémère\', \'flavor\': "Lorsque Hylda gela le Loch Larent pour créer son palais, certains ondins plongèrent au plus profond de l\'eau pour échapper au froid. D\'autres n\'eurent pas cette chance.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630306&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3e6b3d96-a290-4eb4-bc69-9fa8c084643a\', \'multiverseId\': 630306}, \'multiverseid\': 630306}, {\'name\': "Immergere nell\'Inverno", \'text\': \'TAPpa fino a una creatura bersaglio. Profetizza 1, poi pesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'Quando Hylda congelò Loch Larent per creare il suo palazzo, alcuni tritoni si immersero abbastanza in profondità da evitarne il gelo. Altri furono meno fortunati.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630567&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'69c06d42-f730-4d47-8f80-0587bf7dd1bf\', \'multiverseId\': 630567}, \'multiverseid\': 630567}, {\'name\': \'冬への没入\', \'text\': \'クリーチャー最大１体を対象とする。それをタップする。占術１を行う。その後、カード１枚を引く。\', \'type\': \'インスタント\', \'flavor\': \'王宮を築くためヒルダがローラン湖を凍結させたとき、一部のマーフォークは十分に深いところまで潜り氷漬けを免れた。中にはついてない者もいた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630828&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'321aa665-3605-475b-be1e-a40ad33f4c87\', \'multiverseId\': 630828}, \'multiverseid\': 630828}, {\'name\': \'Mergulhar no Inverno\', \'text\': \'Vire até uma criatura alvo. Use vidência 1 e depois compre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Quando Hylda congelou o Lago Larent para criar o próprio palácio, alguns tritões mergulharam até as profundezas para escapar do frio. Outros não tiveram tanta sorte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631089&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'57f15bfd-429c-414f-9afa-bcf7ca85c928\', \'multiverseId\': 631089}, \'multiverseid\': 631089}, {\'name\': \'封入寒冬\', \'text\': \'横置至多一个目标生物。占卜1，然后抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'当希尔妲冻结拉伦特湖筑造宫殿时，有些人鱼早早潜入湖底深处，躲过了这次严寒。但有些就没有那么走运。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631350&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0d7595f7-5886-407f-b005-9f5d5c67ec04\', \'multiverseId\': 631350}, \'multiverseid\': 631350}]', '[{\'name\': \'Störenfried auf dem Ball\', \'text\': \'Feier — Zu Beginn des Kampfes in deinem Zug und falls zwei oder mehr bleibende Karten, die keine Länder sind, in diesem Zug unter deiner Kontrolle ins Spiel gekommen sind, erhält eine Kreatur deiner Wahl, die du kontrollierst, +1/+0 und Bedrohlichkeit bis zum Ende des Zuges. (Sie kann nicht geblockt werden, außer von zwei oder mehr Kreaturen.)\', \'type\': \'Kreatur — Oger, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629882&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1013af34-bc4e-431d-861a-da00c3a81076\', \'multiverseId\': 629882}, \'multiverseid\': 629882}, {\'name\': \'Pendenciero del baile\', \'text\': \'Celebración — Al comienzo del combate en tu turno, si dos o más permanentes que no sean tierra entraron al campo de batalla bajo tu control este turno, la criatura objetivo que controlas obtiene +1/+0 y gana la habilidad de amenaza hasta el final del turno. (No puede ser bloqueada excepto por dos o más criaturas.)\', \'type\': \'Criatura — Guerrero ogro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630143&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e98a8eba-2a26-45ee-9553-ab946b7fae4f\', \'multiverseId\': 630143}, \'multiverseid\': 630143}, {\'name\': \'Belligérant du bal\', \'text\': "Célébration — Au début du combat pendant votre tour, si au moins deux permanents non-terrain sont arrivés sur le champ de bataille sous votre contrôle ce tour-ci, une créature ciblée que vous contrôlez gagne +1/+0 et acquiert la menace jusqu\'à la fin du tour. (Elle ne peut pas être bloquée excepté par deux créatures ou plus.)", \'type\': \'Créature — ogre et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630404&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f73c3ee6-278d-4feb-8706-aa786e244d5c\', \'multiverseId\': 630404}, \'multiverseid\': 630404}, {\'name\': \'Bellicoso del Ballo\', \'text\': "Celebrazione — All\'inizio del combattimento nel tuo turno, se due o più permanenti non terra sono entrati nel campo di battaglia sotto il tuo controllo in questo turno, una creatura bersaglio che controlli prende +1/+0 e ha minacciare fino alla fine del turno. (Non può essere bloccata tranne che da due o più creature.)", \'type\': \'Creatura — Guerriero Ogre\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630665&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'011541f1-be33-48a7-a4ee-f92aad8cfdd8\', \'multiverseId\': 630665}, \'multiverseid\': 630665}, {\'name\': \'晩餐会の好戦漢\', \'text\': \'祝祭 — あなたのターンの戦闘の開始時に、このターンに土地でない２つ以上のパーマネントがあなたのコントロール下で戦場に出たことがある場合、あなたがコントロールしているクリーチャー１体を対象とする。ターン終了時まで、それは＋１/＋０の修整を受け威迫を得る。（それは２体以上のクリーチャーにしかブロックされない。）\', \'type\': \'クリーチャー — オーガ・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630926&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'79e6dd22-8275-4689-ae37-c8dc2bd218bc\', \'multiverseId\': 630926}, \'multiverseid\': 630926}, {\'name\': \'Beligerante do Baile\', \'text\': \'Celebração — No início do combate no seu turno, se duas ou mais permanentes não de terreno tiverem entrado no campo de batalha sob seu controle neste turno, a criatura alvo que você controla recebe +1/+0 e ganha ameaçar até o final do turno. (Ela só pode ser bloqueada por duas ou mais criaturas.)\', \'type\': \'Criatura — Ogro Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631187&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e795864c-405d-40fc-9461-f032ffed3058\', \'multiverseId\': 631187}, \'multiverseid\': 631187}, {\'name\': \'舞会好斗客\', \'text\': \'欢庆～在你回合的战斗开始时，若本回合中有两个或更多非地永久物在你的操控下进战场，则直到回合结束，目标由你操控的生物得+1/+0且获得威慑异能。（它只能被两个或更多生物阻挡。）\', \'type\': \'生物 — 食人魔／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631448&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'33931244-5702-4ed2-89dd-a1db4406c99d\', \'multiverseId\': 631448}, \'multiverseid\': 631448}]', "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631597&type=card', 'language': 'German', 'identifiers': {'scryfallId': '79fa9f6e-d321-4afe-aa08-e6a7344e9064', 'multiverseId': 631597}, 'multiverseid': 631597}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631602&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '3df55245-efa4-4157-9efa-f629063d38c8', 'multiverseId': 631602}, 'multiverseid': 631602}, {'name': 'Marais', 'type': 'Terrain de base — marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631607&type=card', 'language': 'French', 'identifiers': {'scryfallId': '8f3060c1-b50f-45f8-8b32-aec6e8761474', 'multiverseId': 631607}, 'multiverseid': 631607}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631612&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '52975a90-97f1-4a66-bc34-095f1b9ff65a', 'multiverseId': 631612}, 'multiverseid': 631612}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631617&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '32abf5b9-fa77-4619-a619-e085bbf3dad6', 'multiverseId': 631617}, 'multiverseid': 631617}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631622&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c122d926-7026-43b6-bb49-df1e67fe2809', 'multiverseId': 631622}, 'multiverseid': 631622}, {'name': '沼泽', 'type': '基本地 — 沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631627&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9aefc706-8d65-4c99-bb39-1a1551f24cf3', 'multiverseId': 631627}, 'multiverseid': 631627}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631644&type=card', 'language': 'German', 'identifiers': {'scryfallId': '121d5da1-8bfb-4e26-b5ff-ec34ad44fb54', 'multiverseId': 631644}, 'multiverseid': 631644}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631654&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c47f5db4-afb5-40c4-89bc-69dc1d4bcb51', 'multiverseId': 631654}, 'multiverseid': 631654}, {'name': 'Marais', 'type': 'Terrain de base — marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631664&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b9833558-c801-49c8-9ecc-ec640e8e2eeb', 'multiverseId': 631664}, 'multiverseid': 631664}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631674&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '8da0c355-e359-488a-8b38-72fe66db6d87', 'multiverseId': 631674}, 'multiverseid': 631674}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631684&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ab7a453b-b001-49e8-aeaf-f94c60bb59e5', 'multiverseId': 631684}, 'multiverseid': 631684}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631694&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '35446b48-598a-4bdb-a21d-8e9a31216730', 'multiverseId': 631694}, 'multiverseid': 631694}, {'name': '沼泽', 'type': '基本地 — 沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631704&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '581dc63e-f0f1-4f73-b724-69bad75193fe', 'multiverseId': 631704}, 'multiverseid': 631704}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631645&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'bb438234-4758-497c-8ef3-e0f2cc2a48f6', 'multiverseId': 631645}, 'multiverseid': 631645}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631655&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e5e6984d-69b7-449e-98be-92f1e557066c', 'multiverseId': 631655}, 'multiverseid': 631655}, {'name': 'Marais', 'type': 'Terrain de base — marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631665&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ab6c2ad5-5c93-4bad-991b-e4ea73b6cb6a', 'multiverseId': 631665}, 'multiverseid': 631665}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631675&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b050943b-7775-4296-9934-9845ef528d0d', 'multiverseId': 631675}, 'multiverseid': 631675}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631685&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '86092116-e6e8-4655-8498-48d321c9d6a6', 'multiverseId': 631685}, 'multiverseid': 631685}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631695&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0dcab973-d082-436f-b058-f3a6aea786d2', 'multiverseId': 631695}, 'multiverseid': 631695}, {'name': '沼泽', 'type': '基本地 — 沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631705&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '7574d95d-3aa4-446d-ac2b-5ae13a6311f0', 'multiverseId': 631705}, 'multiverseid': 631705}]", '[{\'name\': \'Syr Armont, die Erlöserin\', \'text\': \'Wenn Syr Armont, die Erlöserin, ins Spiel kommt, erzeuge einen Monster-Rolle-Spielstein, angelegt an eine andere Kreatur deiner Wahl, die du kontrollierst. (Falls du bereits eine andere daran angelegte Rolle kontrollierst, lege die alte Rolle auf den Friedhof. Die verzauberte Kreatur erhält +1/+1 und verursacht Trampelschaden.)\\nVerzauberte Kreaturen, die du kontrollierst, erhalten +1/+1.\', \'type\': \'Legendäre Kreatur — Mensch, Ritter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629976&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0fecbb88-d987-4ee9-8576-315987342a89\', \'multiverseId\': 629976}, \'multiverseid\': 629976}, {\'name\': \'Syr Armont, la Redentora\', \'text\': \'Cuando Syr Armont, la Redentora entre al campo de batalla, crea una ficha de Papel de Monstruo anexada a otra criatura objetivo que controlas. (Si controlas otro Papel sobre ella, pon ese en el cementerio. La criatura encantada obtiene +1/+1 y tiene la habilidad de arrollar.)\\nLas criaturas encantadas que controlas obtienen +1/+1.\', \'type\': \'Criatura legendaria — Caballero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630237&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'71845ac2-e7d9-4eb7-a6db-26875c967239\', \'multiverseId\': 630237}, \'multiverseid\': 630237}, {\'name\': \'Syr Armont, la rédemptrice\', \'text\': \'Quand Syr Armont, la rédemptrice arrive sur le champ de bataille, créez un jeton de rôle Monstre attaché à une autre créature ciblée que vous contrôlez. (Si vous contrôlez un autre rôle sur elle, mettez-le au cimetière. La créature enchantée gagne +1/+1 et a le piétinement.)\\nLes créatures enchantées que vous contrôlez gagnent +1/+1.\', \'type\': \'Créature légendaire — humain et chevalier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630498&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5c342f3e-22f2-4c5a-bab0-1db0b81f36bf\', \'multiverseId\': 630498}, \'multiverseid\': 630498}, {\'name\': \'Syr Armont, la Redentrice\', \'text\': "Quando Syr Armont, la Redentrice entra nel campo di battaglia, crea una pedina Ruolo Mostro assegnata a un\'altra creatura bersaglio che controlli. (Se controlli un altro Ruolo assegnato a quella creatura, metti quel Ruolo nel cimitero. La creatura incantata prende +1/+1 e ha travolgere.)\\nLe creature incantate che controlli prendono +1/+1.", \'type\': \'Creatura Leggendaria — Cavaliere Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630759&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6d270167-6edb-4402-ae94-7c89a56d0155\', \'multiverseId\': 630759}, \'multiverseid\': 630759}, {\'name\': \'救世主、アーモント卿\', \'text\': \'救世主、アーモント卿が戦場に出たとき、あなたがコントロールしていてこれでないクリーチャー１体を対象とする。怪物・役割・トークン１つをそれについた状態で生成する。（あなたがコントロールしている役割がすでにそれについていたなら、その役割を墓地に置く。エンチャントしているクリーチャーは＋１/＋１の修整を受けトランプルを持つ。）\\nあなたがコントロールしていてオーラがついているすべてのクリーチャーは＋１/＋１の修整を受ける。\', \'type\': \'伝説のクリーチャー — 人間・騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631020&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a51522aa-d938-4120-b570-40c253154f63\', \'multiverseId\': 631020}, \'multiverseid\': 631020}, {\'name\': \'Syr Armont, a Redentora\', \'text\': \'Quando Syr Armont, a Redentora, entrar no campo de batalha, crie uma ficha de Papel de Monstro anexada a outra criatura alvo que você controla. (Se você controlar outro Papel nela, coloque aquele no cemitério. A criatura encantada recebe +1/+1 e tem atropelar.)\\nAs criaturas encantadas que você controla recebem +1/+1.\', \'type\': \'Criatura Lendária — Humano Cavaleiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631281&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'39a9f94d-3ef9-4860-aa84-e0ce69153cf8\', \'multiverseId\': 631281}, \'multiverseid\': 631281}, {\'name\': \'救赎者娅蒙爵士\', \'text\': \'当救赎者娅蒙爵士进战场时，派出一个怪物角色衍生物，并贴附在另一个目标由你操控的生物上。（如果其上已有另一个你操控的角色，则将已有之角色置入坟墓场。所结附的生物得+1/+1且具有践踏异能。）\\n由你操控且受有灵气的生物得+1/+1。\', \'type\': \'传奇生物 — 人类／骑士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631542&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bd78e237-0667-477c-8fa0-39873a9426f2\', \'multiverseId\': 631542}, \'multiverseid\': 631542}]', '[{\'name\': \'Syr Makrone, Beenderin des Mahls\', \'text\': \'Syr Makrone, Beenderin des Mahls, verursacht Trampelschaden und hat Fluchsicherheit und Eile, solange ein Gegner einen Planeswalker kontrolliert.\\nImmer wenn ein anderes Artefakt, das du kontrollierst, aus dem Spiel auf einen Friedhof gelegt wird, lege eine +1/+1-Marke auf Syr Makrone und wende Hellsicht 1 an.\\n{2}, {T}, opfere Syr Makrone: Du erhältst Lebenspunkte in Höhe ihrer Stärke dazu.\', \'type\': \'Legendäre Artefaktkreatur — Speise, Ritter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630014&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dedd2cb6-a993-455a-bda1-0991e3c615ce\', \'multiverseId\': 630014}, \'multiverseid\': 630014}, {\'name\': \'Syr Jengi, el Fin de los Banquetes\', \'text\': \'Syr Jengi, el Fin de los Banquetes tiene las habilidades de arrollar, antimaleficio y prisa mientras un oponente controle un planeswalker.\\nSiempre que otro artefacto que controlas vaya a un cementerio desde el campo de batalla, pon un contador +1/+1 sobre Syr Jengi y adivina 1.\\n{2}, {T}, sacrificar a Syr Jengi: Ganas una cantidad de vidas igual a su fuerza.\', \'type\': \'Criatura artefacto legendaria — Caballero comida\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630275&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'937ca9c2-7726-4eca-92bc-ed6cb5ab0f18\', \'multiverseId\': 630275}, \'multiverseid\': 630275}, {\'name\': \'Syr Gingembre, la fin du dessert\', \'text\': "Syr Gingembre, la fin du dessert a le piétinement, la défense talismanique et la célérité tant qu\'un adversaire contrôle un planeswalker.\\nÀ chaque fois qu\'un autre artefact que vous contrôlez est mis dans un cimetière depuis le champ de bataille, mettez un marqueur +1/+1 sur Syr Gingembre et regard 1.\\n{2}, {T}, sacrifiez Syr Gingembre : Vous gagnez un nombre de points de vie égal à sa force.", \'type\': \'Créature-artefact légendaire — nourriture et chevalier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630536&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'507f7b48-270d-4db2-b9e0-3dd98f272b07\', \'multiverseId\': 630536}, \'multiverseid\': 630536}, {\'name\': \'Syr Spezia, la Fine del Pasto\', \'text\': \'Syr Spezia, la Fine del Pasto ha travolgere, anti-malocchio e rapidità fintanto che un avversario controlla un planeswalker.\\nOgniqualvolta un altro artefatto che controlli viene messo in un cimitero dal campo di battaglia, metti un segnalino +1/+1 su Syr Spezia e profetizza 1.\\n{2}, {T}, Sacrifica Syr Spezia: Guadagni punti vita pari alla sua forza.\', \'type\': \'Creatura Artefatto Leggendaria — Cavaliere Cibo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630797&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5bb9c9a1-e23b-443d-9c6c-b1ba364eb4f5\', \'multiverseId\': 630797}, \'multiverseid\': 630797}, {\'name\': \'食事を終わらせるもの、ジンジャー卿\', \'text\': \'対戦相手がプレインズウォーカーをコントロールしているかぎり、食事を終わらせるもの、ジンジャー卿はトランプルと呪禁と速攻を持つ。\\nあなたがコントロールしていてこれでないアーティファクト１つが戦場から墓地に置かれるたび、食事を終わらせるもの、ジンジャー卿の上に＋１/＋１カウンター１個を置く。その後、占術１を行う。\\n{2}, {T}, 食事を終わらせるもの、ジンジャー卿を生け贄に捧げる：あなたはこれのパワーに等しい点数のライフを得る。\', \'type\': \'伝説のアーティファクト・クリーチャー — 食物・騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631058&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eca5ed1c-1a1d-4ce2-95cd-247a7eff0869\', \'multiverseId\': 631058}, \'multiverseid\': 631058}, {\'name\': \'Syr Gengibra, Finalizadora de Refeições\', \'text\': \'Syr Gengibra, Finalizadora de Refeições, terá atropelar, resistência a magia e ímpeto enquanto um oponente controlar um planeswalker.\\nToda vez que outro artefato que você controla for colocado em um cemitério vindo do campo de batalha, coloque um marcador +1/+1 em Syr Gengibra e use vidência 1.\\n{2}, {T}, sacrifique Syr Gengibra: Você ganha uma quantidade de pontos de vida igual ao poder dela.\', \'type\': \'Criatura Artefato Lendária — Comida Cavaleiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631319&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bcf9002f-4c24-4c5c-9dd1-11276b24610a\', \'multiverseId\': 631319}, \'multiverseid\': 631319}, {\'name\': \'封餐绝点姜饼爵士\', \'text\': \'只要任一对手操控鹏洛客，封餐绝点姜饼爵士便具有践踏、辟邪与敏捷异能。\\n每当另一个由你操控的神器从战场进入坟墓场时，在姜饼爵士上放置一个+1/+1指示物并占卜1。\\n{2}，{T}，牺牲姜饼爵士：你获得等同于其力量的生命。\', \'type\': \'传奇神器生物 — 食品／骑士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631580&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9795e5ce-dca7-4daf-af80-2c00f5a80104\', \'multiverseId\': 631580}, \'multiverseid\': 631580}]', '[{\'name\': \'Syr Makrone, Beenderin des Mahls\', \'text\': \'Syr Makrone, Beenderin des Mahls, verursacht Trampelschaden und hat Fluchsicherheit und Eile, solange ein Gegner einen Planeswalker kontrolliert.\\nImmer wenn ein anderes Artefakt, das du kontrollierst, aus dem Spiel auf einen Friedhof gelegt wird, lege eine +1/+1-Marke auf Syr Makrone und wende Hellsicht 1 an.\\n{2}, {T}, opfere Syr Makrone: Du erhältst Lebenspunkte in Höhe ihrer Stärke dazu.\', \'type\': \'Legendäre Artefaktkreatur — Speise, Ritter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631902&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'39987c40-f936-4513-880a-1117535a502b\', \'multiverseId\': 631902}, \'multiverseid\': 631902}, {\'name\': \'Syr Gingembre, la fin du dessert\', \'text\': "Syr Gingembre, la fin du dessert a le piétinement, la défense talismanique et la célérité tant qu\'un adversaire contrôle un planeswalker.\\nÀ chaque fois qu\'un autre artefact que vous contrôlez est mis dans un cimetière depuis le champ de bataille, mettez un marqueur +1/+1 sur Syr Gingembre et regard 1.\\n{2}, {T}, sacrifiez Syr Gingembre : Vous gagnez un nombre de points de vie égal à sa force.", \'type\': \'Créature-artefact légendaire — nourriture et chevalier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631949&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6d4aac08-6be2-484d-9b2b-a1c6440628be\', \'multiverseId\': 631949}, \'multiverseid\': 631949}, {\'name\': \'食事を終わらせるもの、ジンジャー卿\', \'text\': \'対戦相手がプレインズウォーカーをコントロールしているかぎり、食事を終わらせるもの、ジンジャー卿はトランプルと呪禁と速攻を持つ。\\nあなたがコントロールしていてこれでないアーティファクト１つが戦場から墓地に置かれるたび、食事を終わらせるもの、ジンジャー卿の上に＋１/＋１カウンター１個を置く。その後、占術１を行う。\\n{2}, {T}, 食事を終わらせるもの、ジンジャー卿を生け贄に捧げる：あなたはこれのパワーに等しい点数のライフを得る。\', \'type\': \'伝説のアーティファクト・クリーチャー — 食物・騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631996&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9064e087-d552-4e54-a75c-c98900af3fc6\', \'multiverseId\': 631996}, \'multiverseid\': 631996}, {\'name\': \'封餐绝点姜饼爵士\', \'text\': \'只要任一对手操控鹏洛客，封餐绝点姜饼爵士便具有践踏、辟邪与敏捷异能。\\n每当另一个由你操控的神器从战场进入坟墓场时，在姜饼爵士上放置一个+1/+1指示物并占卜1。\\n{2}，{T}，牺牲姜饼爵士：你获得等同于其力量的生命。\', \'type\': \'传奇神器生物 — 食品／骑士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632043&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'988faaf6-9fb7-4714-be0e-029b0d27562e\', \'multiverseId\': 632043}, \'multiverseid\': 632043}]', '[{\'name\': \'Talion der Großzügige\', \'text\': \'Fliegend\\nSowie Talion der Großzügige ins Spiel kommt, bestimme eine Zahl von 1 bis 10.\\nImmer wenn ein Gegner einen Zauberspruch mit Manabetrag, Stärke oder Widerstandskraft gleich der bestimmten Zahl wirkt, verliert jener Spieler 2 Lebenspunkte und du ziehst eine Karte.\', \'type\': \'Legendäre Kreatur — Feenwesen, Adliger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629977&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fdd2536c-98ab-4cd1-ac09-16971b69d31f\', \'multiverseId\': 629977}, \'multiverseid\': 629977}, {\'name\': \'Talion, regente amable\', \'text\': \'Vuela.\\nEn cuanto Talion, regente amable entre al campo de batalla, elige un número entre el 1 y el 10.\\nSiempre que un oponente lance un hechizo con valor de maná, fuerza o resistencia igual al número elegido, ese jugador pierde 2 vidas y tú robas una carta.\', \'type\': \'Criatura legendaria — Noble hada\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630238&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6294f824-f4ab-498f-add9-aa509c20a404\', \'multiverseId\': 630238}, \'multiverseid\': 630238}, {\'name\': \'Tarelion, seigneur bienveillant\', \'text\': "Vol\\nAu moment où Tarelion, seigneur bienveillant arrive sur le champ de bataille, choisissez un nombre entre 1 et 10.\\nÀ chaque fois qu\'un adversaire lance un sort avec une valeur de mana, une force ou une endurance égale au nombre choisi, ce joueur perd 2 points de vie et vous piochez une carte.", \'type\': \'Créature légendaire — peuple fée et noble\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630499&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bc4b4102-c8ee-421a-b39a-8d4cada1c3c6\', \'multiverseId\': 630499}, \'multiverseid\': 630499}, {\'name\': \'Talion, il Signore Benevolo\', \'text\': \'Volare\\nMentre Talion, il Signore Benevolo entra nel campo di battaglia, scegli un numero compreso tra 1 e 10.\\nOgniqualvolta un avversario lancia una magia con valore di mana, forza o costituzione pari al numero scelto, quel giocatore perde 2 punti vita e tu peschi una carta.\', \'type\': \'Creatura Leggendaria — Nobile Spiritello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630760&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4f7e7ac9-8d2e-4480-8a0f-92d8c5892c70\', \'multiverseId\': 630760}, \'multiverseid\': 630760}, {\'name\': \'慈愛の王、タリオン\', \'text\': \'飛行\\n慈愛の王、タリオンが戦場に出るに際し、１から10までの数１つを選ぶ。\\n対戦相手が、マナ総量かパワーかタフネスがその選ばれた数に等しい呪文１つを唱えるたび、そのプレイヤーは２点のライフを失い、あなたはカード１枚を引く。\', \'type\': \'伝説のクリーチャー — フェアリー・貴族\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631021&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'36f8527f-01f9-49e6-a59c-684b3635b8f4\', \'multiverseId\': 631021}, \'multiverseid\': 631021}, {\'name\': \'Talion, o Lorde Gentil\', \'text\': \'Voar\\nConforme Talion, o Lorde Gentil, entrar no campo de batalha, escolha um número entre 1 e 10.\\nToda vez que um oponente conjura uma mágica com valor de mana, poder ou resistência igual ao número escolhido, aquele jogador perde 2 pontos de vida e você compra um card.\', \'type\': \'Criatura Lendária — Fada Nobre\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631282&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'374d93e4-8006-48df-9fc6-83d0086fdfb9\', \'multiverseId\': 631282}, \'multiverseid\': 631282}, {\'name\': \'仁慈仙王塔莱恩\', \'text\': \'飞行\\n于仁慈仙王塔莱恩进战场时，选择一个1到10之间的数字。\\n每当任一对手施放法术力值，力量或防御力等同于该数字的咒语时，该牌手失去2点生命且你抓一张牌。\', \'type\': \'传奇生物 — 仙灵／贵族\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631543&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fd398c9c-da6e-4a3b-89da-98674b94a753\', \'multiverseId\': 631543}, \'multiverseid\': 631543}]', '[{\'name\': \'Talion der Großzügige\', \'text\': \'Fliegend\\nSowie Talion der Großzügige ins Spiel kommt, bestimme eine Zahl von 1 bis 10.\\nImmer wenn ein Gegner einen Zauberspruch mit Manabetrag, Stärke oder Widerstandskraft gleich der bestimmten Zahl wirkt, verliert jener Spieler 2 Lebenspunkte und du ziehst eine Karte.\', \'type\': \'Legendäre Kreatur — Feenwesen, Adliger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631729&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1ffeade5-7cd1-46d3-94f9-5964a848631e\', \'multiverseId\': 631729}, \'multiverseid\': 631729}, {\'name\': \'Talion, regente amable\', \'text\': \'Vuela.\\nEn cuanto Talion, regente amable entre al campo de batalla, elige un número entre el 1 y el 10.\\nSiempre que un oponente lance un hechizo con valor de maná, fuerza o resistencia igual al número elegido, ese jugador pierde 2 vidas y tú robas una carta.\', \'type\': \'Criatura legendaria — Noble hada\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631738&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e45f537a-dde2-4e8d-992d-06d774458b89\', \'multiverseId\': 631738}, \'multiverseid\': 631738}, {\'name\': \'Tarelion, seigneur bienveillant\', \'text\': "Vol\\nAu moment où Tarelion, seigneur bienveillant arrive sur le champ de bataille, choisissez un nombre entre 1 et 10.\\nÀ chaque fois qu\'un adversaire lance un sort avec une valeur de mana, une force ou une endurance égale au nombre choisi, ce joueur perd 2 points de vie et vous piochez une carte.", \'type\': \'Créature légendaire — peuple fée et noble\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631747&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0cb80f94-93d8-44be-8665-d3dce762a202\', \'multiverseId\': 631747}, \'multiverseid\': 631747}, {\'name\': \'Talion, il Signore Benevolo\', \'text\': \'Volare\\nMentre Talion, il Signore Benevolo entra nel campo di battaglia, scegli un numero compreso tra 1 e 10.\\nOgniqualvolta un avversario lancia una magia con valore di mana, forza o costituzione pari al numero scelto, quel giocatore perde 2 punti vita e tu peschi una carta.\', \'type\': \'Creatura Leggendaria — Nobile Spiritello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631756&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'aedfb7c4-43c6-4f8d-9935-9c7f19e1339f\', \'multiverseId\': 631756}, \'multiverseid\': 631756}, {\'name\': \'慈愛の王、タリオン\', \'text\': \'飛行\\n慈愛の王、タリオンが戦場に出るに際し、１から10までの数１つを選ぶ。\\n対戦相手が、マナ総量かパワーかタフネスがその選ばれた数に等しい呪文１つを唱えるたび、そのプレイヤーは２点のライフを失い、あなたはカード１枚を引く。\', \'type\': \'伝説のクリーチャー — フェアリー・貴族\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631765&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d32e190c-dcad-4e28-9ece-19c0a51c2046\', \'multiverseId\': 631765}, \'multiverseid\': 631765}, {\'name\': \'Talion, o Lorde Gentil\', \'text\': \'Voar\\nConforme Talion, o Lorde Gentil, entrar no campo de batalha, escolha um número entre 1 e 10.\\nToda vez que um oponente conjura uma mágica com valor de mana, poder ou resistência igual ao número escolhido, aquele jogador perde 2 pontos de vida e você compra um card.\', \'type\': \'Criatura Lendária — Fada Nobre\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631774&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'31d77b24-343a-44ad-b981-4c6d8e8a7812\', \'multiverseId\': 631774}, \'multiverseid\': 631774}, {\'name\': \'仁慈仙王塔莱恩\', \'text\': \'飞行\\n于仁慈仙王塔莱恩进战场时，选择一个1到10之间的数字。\\n每当任一对手施放法术力值，力量或防御力等同于该数字的咒语时，该牌手失去2点生命且你抓一张牌。\', \'type\': \'传奇生物 — 仙灵／贵族\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631783&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0dfd58fa-2b43-40d7-a167-60384624952a\', \'multiverseId\': 631783}, \'multiverseid\': 631783}]', '[{\'name\': \'Talions Bote\', \'text\': \'Fliegend\\nImmer wenn du mit einem oder mehreren Feenwesen angreifst, ziehe eine Karte und wirf dann eine Karte ab. Wenn du auf diese Weise eine Karte abwirfst, lege eine +1/+1-Marke auf ein Feenwesen deiner Wahl, das du kontrollierst.\', \'type\': \'Kreatur — Feenwesen, Adliger\', \'flavor\': \'„Unser großzügiger Herrscher spricht eine solche Einladung an seinen Hof nicht an jeden aus. Du solltest ihr nachkommen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629835&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0a475cc5-0718-4b28-9fab-bf656f0eb415\', \'multiverseId\': 629835}, \'multiverseid\': 629835}, {\'name\': \'Mensajero de Talion\', \'text\': \'Vuela.\\nSiempre que ataques con una o más Hadas, roba una carta y luego descarta una carta. Cuando descartes una carta de esta manera, pon un contador +1/+1 sobre el Hada objetivo que controlas.\', \'type\': \'Criatura — Noble hada\', \'flavor\': \'"Talion no manda invitaciones a su corte así como así. Te sugiero que la aceptes".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630096&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9caffcfe-f400-497d-a352-5b5b047c5924\', \'multiverseId\': 630096}, \'multiverseid\': 630096}, {\'name\': \'Messager de Tarelion\', \'text\': "Vol\\nÀ chaque fois que vous attaquez avec au moins un peuple fée, piochez une carte, puis défaussez-vous d\'une carte. Quand vous vous défaussez d\'une carte de cette manière, mettez un marqueur +1/+1 sur un peuple fée ciblé que vous contrôlez.", \'type\': \'Créature — peuple fée et noble\', \'flavor\': "« Le Seigneur bienveillant n\'envoie pas d\'invitations à sa cour à la légère. Je vous conseille de l\'accepter. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630357&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3c41d3cc-f810-4498-89cb-9ab3a53c20da\', \'multiverseId\': 630357}, \'multiverseid\': 630357}, {\'name\': \'Messaggero di Talion\', \'text\': \'Volare\\nOgniqualvolta attacchi con uno o più Spiritelli, pesca una carta, poi scarta una carta. Quando scarti una carta in questo modo, metti un segnalino +1/+1 su uno Spiritello bersaglio che controlli.\', \'type\': \'Creatura — Nobile Spiritello\', \'flavor\': \'"Il Signore Benevolo non elargisce inviti alla sua corte con leggerezza. Ti consiglio di accettare."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630618&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'75dea6bd-a7a7-4462-9a1b-9593ccb67fac\', \'multiverseId\': 630618}, \'multiverseid\': 630618}, {\'name\': \'タリオンの伝書使\', \'text\': \'飛行\\nあなたが１体以上のフェアリーで攻撃するたび、カード１枚を引く。その後、カード１枚を捨てる。あなたがこれによりカード１枚を捨てたとき、あなたがコントロールしているフェアリー１体を対象とする。それの上に＋１/＋１カウンター１個を置く。\', \'type\': \'クリーチャー — フェアリー・貴族\', \'flavor\': \'「我らの慈愛の王は気軽に宮廷へ招く御方ではない。招待を受けることを勧める。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630879&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a49d467d-791a-4435-8756-d66187593866\', \'multiverseId\': 630879}, \'multiverseid\': 630879}, {\'name\': \'Mensageiro de Talion\', \'text\': \'Voar\\nToda vez que você atacar com uma ou mais Fadas, compre um card e depois descarte um card. Quando você descartar um card dessa forma, coloque um marcador +1/+1 na Fada alvo que você controla.\', \'type\': \'Criatura — Fada Nobre\', \'flavor\': \'"O Senhor Gentil não convida ninguém para a corte à toa. Sugiro que você aceite."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631140&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'89f54fb9-d48a-4568-a00d-fcde09d29bc3\', \'multiverseId\': 631140}, \'multiverseid\': 631140}, {\'name\': \'塔莱恩的信使\', \'text\': \'飞行\\n每当你以一个或数个仙灵攻击时，抓一张牌，然后弃一张牌。当你以此法弃一张牌时，在目标由你操控的仙灵上放置一个+1/+1指示物。\', \'type\': \'生物 — 仙灵／贵族\', \'flavor\': \'「仁慈仙王从不轻易请人入廷。在此建议你乖乖从命。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631401&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'551f0154-f23f-443d-8428-f307dc0bc45b\', \'multiverseId\': 631401}, \'multiverseid\': 631401}]', '[{\'name\': \'Talions Bote\', \'text\': \'Fliegend\\nImmer wenn du mit einem oder mehreren Feenwesen angreifst, ziehe eine Karte und wirf dann eine Karte ab. Wenn du auf diese Weise eine Karte abwirfst, lege eine +1/+1-Marke auf ein Feenwesen deiner Wahl, das du kontrollierst.\', \'type\': \'Kreatur — Feenwesen, Adliger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631868&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b7d2e3ab-30f9-461e-abb7-7175b14e0b28\', \'multiverseId\': 631868}, \'multiverseid\': 631868}, {\'name\': \'Messager de Tarelion\', \'text\': "Vol\\nÀ chaque fois que vous attaquez avec au moins un peuple fée, piochez une carte, puis défaussez-vous d\'une carte. Quand vous vous défaussez d\'une carte de cette manière, mettez un marqueur +1/+1 sur un peuple fée ciblé que vous contrôlez.", \'type\': \'Créature — peuple fée et noble\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631915&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9effabb6-5ecc-4d9a-94f8-6ce2e2f3ff8a\', \'multiverseId\': 631915}, \'multiverseid\': 631915}, {\'name\': \'タリオンの伝書使\', \'text\': \'飛行\\nあなたが１体以上のフェアリーで攻撃するたび、カード１枚を引く。その後、カード１枚を捨てる。あなたがこれによりカード１枚を捨てたとき、あなたがコントロールしているフェアリー１体を対象とする。それの上に＋１/＋１カウンター１個を置く。\', \'type\': \'クリーチャー — フェアリー・貴族\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631962&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ebd99c86-7b6b-4ac0-92fb-e7577fe3cf92\', \'multiverseId\': 631962}, \'multiverseid\': 631962}, {\'name\': \'塔莱恩的信使\', \'text\': \'飞行\\n每当你以一个或数个仙灵攻击时，抓一张牌，然后弃一张牌。当你以此法弃一张牌时，在目标由你操控的仙灵上放置一个+1/+1指示物。\', \'type\': \'生物 — 仙灵／贵族\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632009&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4e35ba78-90ef-4348-b8d9-41b20bf3d171\', \'multiverseId\': 632009}, \'multiverseid\': 632009}]', '[{\'name\': \'Taschenspielerei\', \'text\': \'Schaue dir die obersten zwei Karten deiner Bibliothek an. Nimm eine davon auf deine Hand und lege die andere unter deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': \'Der Bauer sah verblüfft zu, wie sich der Groschen in Luft auflöste. Nur der Gans war klar, dass die Münze bei der Fee gelandet war.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=629829&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'173e7970-40a5-4112-b50c-faa037a4670f\', \'multiverseId\': 629829}, \'multiverseid\': 629829}, {\'name\': \'Juego de manos\', \'text\': \'Mira las dos primeras cartas de tu biblioteca. Pon una de ellas en tu mano y la otra en el fondo de tu biblioteca.\', \'type\': \'Conjuro\', \'flavor\': \'El granjero quedó asombrado cuando su moneda se desvaneció, pero el ganso sabía que se la había pasado al hada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630090&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8a18fff7-9bf0-4311-ba0a-3ed4e3f7dd29\', \'multiverseId\': 630090}, \'multiverseid\': 630090}, {\'name\': \'Passe-passe\', \'text\': "Regardez les deux cartes du dessus de votre bibliothèque. Mettez l\'une d\'elles dans votre main et l\'autre au-dessous de votre bibliothèque.", \'type\': \'Rituel\', \'flavor\': "Le fermier fut sidéré de voir le sou disparaître, mais l\'oie savait qu\'il l\'avait juste glissée discrètement à la færie.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630351&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7f0cc11e-ea5e-42e1-af3e-bb154ac08e2a\', \'multiverseId\': 630351}, \'multiverseid\': 630351}, {\'name\': \'Gioco di Prestigio\', \'text\': "Guarda le prime due carte del tuo grimorio. Aggiungi una di quelle carte alla tua mano e metti l\'altra in fondo al tuo grimorio.", \'type\': \'Stregoneria\', \'flavor\': "Il contadino rimase colpito quando la moneta svanì nel nulla, ma l\'oca sapeva che c\'era lo zampino dello spiritello.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630612&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'44a30287-fc99-4d84-87c2-792f1110618d\', \'multiverseId\': 630612}, \'multiverseid\': 630612}, {\'name\': \'手練\', \'text\': \'あなたのライブラリーの一番上にあるカード２枚を見る。そのうち１枚をあなたの手札に、もう１枚をあなたのライブラリーの一番下に置く。\', \'type\': \'ソーサリー\', \'flavor\': \'農夫は銅貨が消えたことに驚いたが、ガチョウはフェアリーにこっそり渡しただけだと知っていた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=630873&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6b7242ba-e186-4c73-a2ec-e3891bda8b4e\', \'multiverseId\': 630873}, \'multiverseid\': 630873}, {\'name\': \'Truque de Mãos\', \'text\': \'Olhe os dois cards do topo de seu grimório. Coloque um deles em sua mão e o outro no fundo de seu grimório.\', \'type\': \'Feitiço\', \'flavor\': \'O fazendeiro ficou impressionado ao ver a moeda sumir no ar, mas o ganso sabia que ele só a havia passado para a fada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631134&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b0fe229f-bc40-4ce7-bbad-cc3eb89910d3\', \'multiverseId\': 631134}, \'multiverseid\': 631134}, {\'name\': \'变戏法\', \'text\': \'检视你牌库顶的两张牌。将其中一张置于你手上，另一张则置于你牌库底。\', \'type\': \'法术\', \'flavor\': \'眼见金币就在跟前凭空消失，农夫看得目瞪口呆；但连身旁的白鹅都明白，对方不过是把金币递给了仙灵。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=631395&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'72cdca44-e376-4877-bba6-e427f34b4299\', \'multiverseId\': 631395}, \'multiverseid\': 631395}]', '[{\'name\': \'Taschenspielerei\', \'text\': \'Schaue dir die obersten zwei Karten deiner Bibliothek an. Nimm eine davon auf deine Hand und lege die andere unter deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632195&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9c033bdb-f227-4ca1-85b7-4b2ba9b71e28\', \'multiverseId\': 632195}, \'multiverseid\': 632195}, {\'name\': \'Juego de manos\', \'text\': \'Mira las dos primeras cartas de tu biblioteca. Pon una de ellas en tu mano y la otra en el fondo de tu biblioteca.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632200&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'83cb8e1e-e7b7-445d-a06b-cc0fd30c3d7e\', \'multiverseId\': 632200}, \'multiverseid\': 632200}, {\'name\': \'Passe-passe\', \'text\': "Regardez les deux cartes du dessus de votre bibliothèque. Mettez l\'une d\'elles dans votre main et l\'autre au-dessous de votre bibliothèque.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=632205&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'82042f1c-fb61-459b-93df-bf5e7be1610e\', \'multiverseId\': 632205}, \'multiverseid\': 632205}, {\'name\': \'Gioco di Prestigio\', \'text\': "Guarda le prime due carte del tuo grimorio. Aggiungi una di quelle carte alla tua mano e metti l\'altra in fondo al tuo grimorio.", \'type\': \'Stregoneria\', \'flavo