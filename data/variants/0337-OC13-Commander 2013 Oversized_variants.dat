name: ['Derevi, Empyrial Tactician', 'Gahiji, Honored One', "Jeleva, Nephalia's Scourge", 'Marath, Will of the Wild', 'Mayael the Anima', 'Nekusar, the Mindrazer', 'Oloro, Ageless Ascetic', 'Prossh, Skyraider of Kher', 'Roon of the Hidden Realm', 'Rubinia Soulsinger', "Sek'Kuar, Deathkeeper", 'Sharuum the Hegemon', 'Shattergang Brothers', 'Sydri, Galvanic Genius', 'Thraximundar']
multiverse_id: []
layout: ['normal']
names: []
mana_cost: ['{1}{B}{R}{G}', '{1}{U}{B}{R}', '{2}{B}{R}{G}', '{2}{G}{W}{U}', '{2}{R}{G}{W}', '{2}{U}{B}{R}', '{3}{B}{R}{G}', '{3}{W}{U}{B}', '{4}{U}{B}{R}', '{G}{W}{U}', '{R}{G}{W}', '{W}{U}{B}']
cmc: ['3.0', '4.0', '5.0', '6.0', '7.0']
