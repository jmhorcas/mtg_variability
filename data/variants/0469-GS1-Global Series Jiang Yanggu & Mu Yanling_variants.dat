foreign_names: ["[{'name': '九尾白狐', 'text': '当九尾白狐对任一牌手造成战斗伤害时，抓一张牌。', 'type': '生物 ～狐／精怪', 'flavor': '千年的等待，为得一朝与你相遇；又千年守望，只为得见你子孙后代繁衍生息。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447096&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '98fb9989-b223-409a-adae-668db532f1b6', 'multiverseId': 447096}, 'multiverseid': 447096}]", "[{'name': '兆火鹤', 'text': '飞行（此生物只能被具飞行或延势异能的生物阻挡。）\\n每当兆火鹤攻击时，它对目标由对手操控的生物造成1点伤害。', 'type': '生物 ～鸟／精怪', 'flavor': '当你看清它的时候，自己身上已经着火了。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447117&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a195d5cf-fa18-4726-b665-b8e70f41850e', 'multiverseId': 447117}, 'multiverseid': 447117}]", "[{'name': '凤鸣涤焰', 'text': '凤鸣涤焰对任意一个目标造成4点伤害。', 'type': '法术', 'flavor': '最妙的音符莫过于「噼啪」和「哔啵」。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447125&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a8838343-7ccd-4370-a7e0-3ed64d473966', 'multiverseId': 447125}, 'multiverseid': 447125}]", "[{'name': '地源牦牛', 'text': '当地源牦牛进战场时，由你操控的生物得+1/+1直到回合结束。', 'type': '生物 ～牛', 'flavor': '北方大山深处，它们静谧盘桓，似将大地之力驮负在身。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447097&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9bcad44b-cdb0-4567-ad81-7551080a8f25', 'multiverseId': 447097}, 'multiverseid': 447097}]", "[{'name': '坚鳞厚甲', 'text': '结附于生物\\n所结附的生物得+3/+3。', 'type': '结界 ～灵气', 'flavor': '鲮鲤甲片刀枪不入，水火不侵，这也成了它们终归灭绝的悲剧根源。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447120&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '3024adb8-c315-41a8-b1ab-f9cdf8cb8c04', 'multiverseId': 447120}, 'multiverseid': 447120}]", "[{'name': '好斗天性', 'text': '目标由你操控的生物对目标不由你操控的生物造成伤害，其数量等同于前者的力量。', 'type': '法术', 'flavor': '「那日，默武突而间警觉起来，似乎它也嗅到了我们即将面临的危险。」\\n～旸谷纪行', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447122&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '2e0acbf9-0a68-49b0-a385-b0607d6e25d7', 'multiverseId': 447122}, 'multiverseid': 447122}]", "[{'name': '姜旸谷', 'text': '+1：目标生物得+2/+2直到回合结束。\\n−1：如果你未操控名称为默武的生物，则派出一个传奇的3/3绿色，名称为默武的猎犬衍生生物。\\n−5：直到回合结束，目标生物获得践踏异能且得+X/+X，X为由你操控的地数量。', 'type': '传奇鹏洛客 ～旸谷', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447110&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '5489b4ef-0a97-4108-a6c7-1e461a357c72', 'multiverseId': 447110}, 'multiverseid': 447110}]", "[{'name': '寰宇麒麟', 'text': '飞行（此生物只能被具飞行或延势异能的生物阻挡。）\\n当寰宇麒麟攻击时，另一个目标由你操控的生物获得飞行异能直到回合结束。', 'type': '生物 ～麒麟', 'flavor': '踏星碎云，肆意遨游天界人间。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447094&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'af6c2872-63cc-493d-b6e0-c58ec9c0188f', 'multiverseId': 447094}, 'multiverseid': 447094}]", "[{'name': '山脉', 'type': '基本地 ～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447127&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9a33602e-d4c6-4a64-bd01-5b81454b683d', 'multiverseId': 447127}, 'multiverseid': 447127}]", "[{'name': '巨型蜘蛛', 'text': '延势（此生物能阻挡具飞行异能的生物。）', 'type': '生物 ～蜘蛛', 'flavor': '箭竹林看似云淡风轻，暗处却蕴藏着无限杀机。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447115&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f23e285e-bb4e-4739-8a2e-4b07e5e4c165', 'multiverseId': 447115}, 'multiverseid': 447115}]", "[{'name': '平原', 'type': '基本地 ～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447108&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9a739605-4cc8-4d6c-a7c5-e760905ff606', 'multiverseId': 447108}, 'multiverseid': 447108}]", "[{'name': '探灵寻踪', 'text': '从你的牌库中搜寻一张基本地牌和一张名称为姜旸谷的牌，展示这些牌，将它们置于你手上，然后将你的牌库洗牌。', 'type': '法术', 'flavor': '「当终于触碰到它的瞬间，惊觉不是我寻到了它，而是它一直在引领我。」', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447124&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'd7638d2c-4c38-4728-b8cb-1b1a332b52f9', 'multiverseId': 447124}, 'multiverseid': 447124}]", "[{'name': '撼地蛮兕', 'text': '践踏（此生物攻击时造成之过量战斗伤害能对防御牌手或鹏洛客造成之。）', 'type': '生物 ～野兽', 'flavor': '「不知是何原因，箭竹林中的兽群近来愈发躁动不安。」\\n～旸谷纪行', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447119&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '3306796e-f2e5-47c9-bbc9-cb7943ee8960', 'multiverseId': 447119}, 'multiverseid': 447119}]", "[{'name': '林场峡谷', 'text': '林场峡谷须横置进战场。\\n{T}：加{R}或{G}。', 'type': '地', 'flavor': '招摇之山，石林穿云，临于西海，多奇珍异兽。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447126&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a20b1d6e-d373-4b0a-b6f3-3a7c16f0ed1f', 'multiverseId': 447126}, 'multiverseid': 447126}]", "[{'name': '树林', 'type': '基本地 ～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447128&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'ba4342d5-319c-4457-8a15-217ccfd8b7e9', 'multiverseId': 447128}, 'multiverseid': 447128}]", "[{'name': '水韵漩咒', 'text': '将至多两个目标生物移回其拥有者手上。\\n从你的牌库和／或坟墓场中搜寻一张名称为沐燕灵的牌，展示该牌，并将它置于你手上。如果你以此法搜寻了你的牌库，则将它洗牌。', 'type': '法术', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447106&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '8c8fff60-466b-4071-b3fc-74b6bafa0553', 'multiverseId': 447106}, 'multiverseid': 447106}]", "[{'name': '沐燕灵', 'text': '+2：目标生物本回合不能被阻挡。\\n−3：抓两张牌。\\n−10：横置所有由对手操控的生物。你于本回合后进行额外的一个回合。', 'type': '传奇鹏洛客 ～燕灵', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447089&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '26f3c7d3-0a1a-4fa3-9987-8e2a6cdbca3b', 'multiverseId': 447089}, 'multiverseid': 447089}]", "[{'name': '海岛', 'type': '基本地 ～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447109&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '308d7381-a1ed-4bd7-a7b9-3f7863f63752', 'multiverseId': 447109}, 'multiverseid': 447109}]", "[{'name': '清源白鹿', 'text': '{3}{G}，{T}：你获得4点生命。只能于你操控旸谷鹏洛客时起动此异能。', 'type': '生物 ～麋鹿', 'flavor': '千年为苍鹿，再五百始为白鹿。多少人为了它华光韵动的回眸一瞥，迷失在蛮荒山林间。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447113&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '33eb05b0-4d54-4077-b35c-537c3bf8d4cc', 'multiverseId': 447113}, 'multiverseid': 447113}]", "[{'name': '溺于无形', 'text': '将目标生物移回其拥有者手上。', 'type': '瞬间', 'flavor': '「驭水之力源自我泪，驭风之行习自我燕。」', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447103&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f30f159a-efc2-459e-91b4-12ce7a1fd52d', 'multiverseId': 447103}, 'multiverseid': 447103}]", "[{'name': '烈焰吐息', 'text': '烈焰吐息对目标生物造成2点伤害。', 'type': '瞬间', 'flavor': '火，会引出更多火来。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447121&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f59aa226-0498-4f2d-bc48-ca8adb187194', 'multiverseId': 447121}, 'multiverseid': 447121}]", "[{'name': '煌焰鸣凤', 'text': '飞行\\n{2}{R}：由你操控的生物得+1/+0直到回合结束。', 'type': '生物 ～凤凰', 'flavor': '羽翼扑扇间，天火燎原。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447118&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c0a6c54f-f99c-411d-8de8-d8c891f88a4f', 'multiverseId': 447118}, 'multiverseid': 447118}]", "[{'name': '狂力傲相', 'text': '直到回合结束，目标生物得+4/+4且获得践踏异能。（它攻击时造成之过量战斗伤害能对防御牌手或鹏洛客造成之。）', 'type': '法术', 'flavor': '「迎战！」\\n～姜旸谷', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447123&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f60bfdba-4e67-45c2-8654-021fe1776f69', 'multiverseId': 447123}, 'multiverseid': 447123}]", "[{'name': '狞狰', 'type': '生物 ～猫／野兽', 'flavor': '日形于涧，夜隐于林。角灯如萤，声如石鸣。受伏于姜旸谷前，未有见者还。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447116&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'facbaee2-3a77-4e41-9775-092c52e8319a', 'multiverseId': 447116}, 'multiverseid': 447116}]", "[{'name': '紫晶蟹', 'text': '当紫晶蟹死去时，抓一张牌。', 'type': '生物 ～蟹', 'flavor': '其壳也珍，其味也美。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447091&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b88954c5-47af-4620-b5d1-8485af16ab8d', 'multiverseId': 447091}, 'multiverseid': 447091}]", "[{'name': '绝妙好计', 'text': '抓三张牌。', 'type': '法术', 'flavor': '天启示象，迷途明灯。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447105&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '364611b5-7069-49d8-827a-a5e9a6caa90f', 'multiverseId': 447105}, 'multiverseid': 447105}]", "[{'name': '肥遗彩雀', 'text': '飞行（此生物只能被具飞行或延势异能的生物阻挡。）', 'type': '生物 ～鸟', 'flavor': '这灵巧小雀寻常难见，只因它们正忙于戏耍林间蹒跚的鲮鲤，并且乐此不疲。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447090&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '7b2a69cb-4c9e-400c-b64f-6ecdddab8756', 'multiverseId': 447090}, 'multiverseid': 447090}]", "[{'name': '肥遗蛇', 'text': '延势（此生物能阻挡具飞行异能的生物。）', 'type': '生物 ～蛇', 'flavor': '两个身体，加倍的恶意。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447112&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '36672ac4-9dda-45d3-befd-0112d4014d14', 'multiverseId': 447112}, 'multiverseid': 447112}]", "[{'name': '苍穹飞燕', 'text': '飞行（此生物只能被具飞行或延势异能的生物阻挡。）\\n苍穹飞燕只能阻挡具飞行异能的生物。', 'type': '生物 ～鸟', 'flavor': '终其一生，唯有一次停歇，那便是归宿。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447093&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '1c9c7d79-30a6-46fc-8172-5eb54fc9833a', 'multiverseId': 447093}, 'multiverseid': 447093}]", "[{'name': '莽撞鲮鲤', 'text': '每当莽撞鲮鲤攻击时，它得+1/+1直到回合结束。', 'type': '生物 ～穿山甲', 'flavor': '「速度就是攻击力，当出手时就出手！」\\n～旸谷纪行', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447114&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '04faaeef-b2d8-4e3a-89fd-e1525b446194', 'multiverseId': 447114}, 'multiverseid': 447114}]", "[{'name': '蛮荒始龙', 'text': '飞行\\n每当一个或数个由你操控的生物攻击时，每有一个进行攻击的生物，你便获得1点生命。', 'type': '生物 ～龙', 'flavor': '相传应龙诞凤凰、麒麟，后衍毛羽众生，因而得始龙之名。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447100&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '46b756ee-2912-4749-838f-01b9ae3dcc42', 'multiverseId': 447100}, 'multiverseid': 447100}]", "[{'name': '蜿蜒河流', 'text': '蜿蜒河流须横置进战场。\\n{T}：加{W}或{U}。', 'type': '地', 'flavor': '云蒸雾绕梦泽深，苇伏风去天际远。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447107&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '835ef111-fda7-48f1-980c-b85fb916586a', 'multiverseId': 447107}, 'multiverseid': 447107}]", "[{'name': '覆甲旋龟', 'type': '生物 ～龟', 'flavor': '并不是所有大块头都有爆脾气。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447095&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '0f6e55bb-e143-4f9e-a974-e595bbb28308', 'multiverseId': 447095}, 'multiverseid': 447095}]", "[{'name': '豹纹狡', 'type': '生物 ～野兽', 'flavor': '此异兽纹若豹，音似犬，角如牛。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447111&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9b973336-bc1b-449d-ae03-782d7da39835', 'multiverseId': 447111}, 'multiverseid': 447111}]", "[{'name': '迷雾披风', 'text': '结附于生物\\n所结附的生物不能被阻挡。', 'type': '结界 ～灵气', 'flavor': '迷蒙萦绕处有玄机，混沌深邃处莫停留。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447101&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '0bafb41f-7de7-4fe4-aa69-55add55e9ef5', 'multiverseId': 447101}, 'multiverseid': 447101}]", "[{'name': '隐龙突现', 'text': '隐龙突现对目标进行攻击或阻挡的生物造成5点伤害。', 'type': '瞬间', 'flavor': '「山崩地裂中，始龙现身云端。」\\n～旸谷纪行', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447104&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '431b1bb1-c2c9-420f-afc1-8f9fff91e1a9', 'multiverseId': 447104}, 'multiverseid': 447104}]", "[{'name': '霓彩飞鱼', 'text': '只要霓彩飞鱼正进行攻击，它便具有飞行异能。（它只能被具飞行或延势异能的生物阻挡。）', 'type': '生物 ～鱼／蜥蜴', 'flavor': '雨后初晴，云梦大泽上那一抹虹不是别的，正是数不清的霓彩飞鱼的祭天舞蹈。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447092&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '2636e562-3167-4135-8f11-a27de6a90112', 'multiverseId': 447092}, 'multiverseid': 447092}]", "[{'name': '风暴云灵', 'text': '飞行（此生物只能被具飞行或延势异能的生物阻挡。）', 'type': '生物 ～精怪', 'flavor': '结水泽汪洋之灵，化雷霆电闪之怒；纵驰睥睨，莫有可挡者。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447099&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '01062485-6940-494d-83c8-529265b0e18c', 'multiverseId': 447099}, 'multiverseid': 447099}]", "[{'name': '食月天狗', 'text': '只要你操控燕灵鹏洛客，食月天狗便具有飞行异能。（它只能被具飞行或延势异能的生物阻挡。）', 'type': '生物 ～猎犬', 'flavor': '最矫捷的身影擅于追逐最圣洁的光辉。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447098&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '7a71c0cc-aea2-4849-a710-243996ae8c50', 'multiverseId': 447098}, 'multiverseid': 447098}]", "[{'name': '麒麟祝祷', 'text': '目标生物得+2/+2直到回合结束。', 'type': '瞬间', 'flavor': '「真有趣. . .这凡物身上竟似有股麒麟气息萦绕。」\\n～燕灵手札', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=447102&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '4b93236d-f9c9-4c3c-92f4-d3de63fb8e95', 'multiverseId': 447102}, 'multiverseid': 447102}]"]
printings: ['10E', '2ED', '2XM', '30A', '3ED', '40K', '4BB', '4ED', '5ED', '6ED', '7ED', '8ED', '9ED', 'AFR', 'AKH', 'AKR', 'ALA', 'ANA', 'ANB', 'ARC', 'ARN', 'ATH', 'AVR', 'BBD', 'BFZ', 'BLB', 'BRB', 'BRC', 'BRO', 'BTD', 'C13', 'C14', 'C15', 'C16', 'C17', 'C18', 'C19', 'CED', 'CEI', 'CHK', 'CLB', 'CLU', 'CM2', 'CMA', 'CMD', 'CMM', 'CMR', 'CST', 'DD1', 'DD2', 'DDC', 'DDD', 'DDE', 'DDF', 'DDG', 'DDH', 'DDI', 'DDJ', 'DDK', 'DDL', 'DDM', 'DDN', 'DDO', 'DDP', 'DDQ', 'DDR', 'DDS', 'DDT', 'DDU', 'DKM', 'DMR', 'DMU', 'DOM', 'DPA', 'DTK', 'DVD', 'E01', 'ELD', 'EVG', 'FBB', 'FRF', 'G17', 'GK1', 'GK2', 'GN2', 'GN3', 'GNT', 'GRN', 'GS1', 'GVL', 'H09', 'HBG', 'HOP', 'HOU', 'ICE', 'IKO', 'INV', 'ISD', 'ITP', 'J14', 'J22', 'JMP', 'JVC', 'KHC', 'KHM', 'KLD', 'KLR', 'KTK', 'LCI', 'LEA', 'LEB', 'LRW', 'LTR', 'M10', 'M11', 'M12', 'M13', 'M14', 'M15', 'M19', 'M20', 'M21', 'MBS', 'MD1', 'ME1', 'ME3', 'MH2', 'MH3', 'MID', 'MIR', 'MKM', 'MMQ', 'MOM', 'MRD', 'NEO', 'NPH', 'ODY', 'OGW', 'OLEP', 'ONE', 'ONS', 'ORI', 'OTJ', 'P02', 'P23', 'PAL00', 'PAL01', 'PAL02', 'PAL03', 'PAL04', 'PAL05', 'PAL06', 'PAL99', 'PALP', 'PANA', 'PARL', 'PC2', 'PCA', 'PD2', 'PDGM', 'PELP', 'PF19', 'PF20', 'PGPX', 'PGRU', 'PIP', 'PL24', 'PLST', 'PMPS', 'PMPS06', 'PMPS07', 'PMPS08', 'PMPS09', 'PMPS10', 'PMPS11', 'POR', 'PPP1', 'PRM', 'PRW2', 'PRWK', 'PS11', 'PSAL', 'PSS2', 'PSS3', 'PSS4', 'PTC', 'PTK', 'PZ2', 'RAV', 'REX', 'RIX', 'RNA', 'ROE', 'RQS', 'RTR', 'S99', 'SCD', 'SHM', 'SIR', 'SLD', 'SNC', 'SOI', 'SOM', 'STX', 'SUM', 'TD0', 'TD2', 'THB', 'THS', 'TMP', 'TPR', 'TSP', 'UGL', 'UND', 'UNF', 'UNH', 'USG', 'UST', 'VOW', 'WAR', 'WC00', 'WC01', 'WC02', 'WC03', 'WC04', 'WC97', 'WC98', 'WC99', 'WHO', 'WOE', 'XANA', 'XLN', 'ZEN', 'ZNR']
original_text: ["+1: Target creature gets +2/+2 until end of turn.\\n−1: If you don't control a creature named Mowu, create a legendary 3/3 green Hound creature token named Mowu.\\n−5: Until end of turn, target creature gains trample and gets +X/+X, where X is the number of lands you control.", "+2: Target creature can't be blocked this turn.\\n−3: Draw two cards.\\n−10: Tap all creatures your opponents control. You take an extra turn after this one.", "As long as you control a Yanling planeswalker, Moon-Eating Dog has flying. (It can't be blocked except by creatures with flying or reach.)", 'Breath of Fire deals 2 damage to target creature.', 'Cleansing Screech deals 4 damage to any target.', "Dragon's Presence deals 5 damage to target attacking or blocking creature.", 'Draw three cards.', "Enchant creature\\nEnchanted creature can't be blocked.", 'Enchant creature\\nEnchanted creature gets +3/+3.', "Flying (This creature can't be blocked except by creatures with flying or reach.)", "Flying (This creature can't be blocked except by creatures with flying or reach.)\\nWelkin Tern can block only creatures with flying.", "Flying (This creature can't be blocked except by creatures with flying or reach.)\\nWhenever Fire-Omen Crane attacks, it deals 1 damage to target creature an opponent controls.", "Flying (This creature can't be blocked except by creatures with flying or reach.)\\nWhenever Heavenly Qilin attacks, another target creature you control gains flying until end of turn.", 'Flying\\nWhenever one or more creatures you control attack, you gain 1 life for each attacking creature.', 'Flying\\n{2}{R}: Creatures you control get +1/+0 until end of turn.', 'G', 'Meandering River enters the battlefield tapped.\\n{T}: Add {W} or {U}.', 'R', 'Reach (This creature can block creatures with flying.)', "Return target creature to its owner's hand.", "Return up to two target creatures to their owner's hand.\\nSearch your library and/or graveyard for a card named Mu Yanling, reveal it, and put it into your hand. If you searched your library this way, shuffle it.", 'Search your library and graveyard for a basic land card and a card named Jiang Yanggu, reveal them, put them into your hand, then shuffle your library.', 'Target creature gets +2/+2 until end of turn.', 'Target creature gets +4/+4 and gains trample until end of turn. (It can deal excess combat damage to defending player or planeswalker while attacking.)', "Target creature you control deals damage equal to its power to target creature you don't control.", 'Timber Gorge enters the battlefield tapped.\\n{T}: Add {R} or {G}.', 'Trample (This creature can deal excess combat damage to defending player or planeswalker while attacking.)', 'U', "Vivid Flying Fish has flying as long as it's attacking. (It can't be blocked except by creatures with flying or reach.)", 'W', 'When Earth-Origin Yak enters the battlefield, creatures you control get +1/+1 until end of turn.', 'When Purple-Crystal Crab dies, draw a card.', 'Whenever Nine-Tail White Fox deals combat damage to a player, draw a card.', 'Whenever Reckless Pangolin attacks, it gets +1/+1 until end of turn.', '{3}{G}, {T}: You gain 4 life. Activate this ability only if you control a Yanggu planeswalker.']
