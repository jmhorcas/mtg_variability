subtypes: ['Advisor', 'Angel', 'Archer', 'Artificer', 'Aura', 'Beast', 'Cat', 'Cleric', 'Demon', 'Djinn', 'Dragon', 'Drake', 'Elder', 'Elephant', 'Elf', 'Faerie', 'Fish', 'Giant', 'Goblin', 'Horror', 'Horse', 'Human', 'Insect', 'Mine', 'Nightstalker', 'Ogre', 'Ooze', 'Phyrexian', 'Power-Plant', 'Rat', 'Rogue', 'Shapeshifter', 'Slug', 'Soldier', 'Sphinx', 'Spirit', 'Tower', "Urza's", 'Wall', 'Warrior', 'Wizard', 'Wombat', 'Yeti', 'Zombie']
