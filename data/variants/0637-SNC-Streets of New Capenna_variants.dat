multiverseid=559436&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '573cc73f-10d0-4304-b599-85835161f1d1', 'multiverseId': 559436}, 'multiverseid': 559436}, {'name': '平原', 'type': '基本地 ～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559446&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '98d76422-365a-4c21-a2d8-7e9cd920ae2a', 'multiverseId': 559446}, 'multiverseid': 559446}]", "[{'name': 'Ebene', 'type': 'Standardland — Ebene', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559465&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'cdfddc25-85e8-48c0-bc0b-3320a3610227', 'multiverseId': 559465}, 'multiverseid': 559465}, {'name': 'Llanura', 'type': 'Tierra básica — Llanura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559475&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4cbfb419-266d-4191-96c4-6ae6f215379f', 'multiverseId': 559475}, 'multiverseid': 559475}, {'name': 'Plaine', 'type': 'Terrain de base : plaine', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559485&type=card', 'language': 'French', 'identifiers': {'scryfallId': '0757031b-1c4d-4c31-ad7d-3d748ee2210b', 'multiverseId': 559485}, 'multiverseid': 559485}, {'name': 'Pianura', 'type': 'Terra Base — Pianura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559495&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3d7db615-e3a4-48f8-ad4f-676dbe592365', 'multiverseId': 559495}, 'multiverseid': 559495}, {'name': '平地', 'type': '基本土地 — 平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559505&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9e8c3f9e-a060-4065-989b-dc3249b67e7a', 'multiverseId': 559505}, 'multiverseid': 559505}, {'name': '들', 'type': '기본 대지 — 들', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559515&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '27929d26-80ed-4b2a-8c61-13ce238b06ae', 'multiverseId': 559515}, 'multiverseid': 559515}, {'name': 'Planície', 'type': 'Terreno Básico — Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559525&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5ede767d-e51f-41fb-a734-d88865bc2364', 'multiverseId': 559525}, 'multiverseid': 559525}, {'name': 'Равнина', 'type': 'Базовая Земля — Равнина', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559535&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '7d59e683-2f6e-40e3-9c98-0dedf0421f8d', 'multiverseId': 559535}, 'multiverseid': 559535}, {'name': '平原', 'type': '基本地 ～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559545&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '47de79d5-23dd-4d67-bf78-a8aeae116619', 'multiverseId': 559545}, 'multiverseid': 559545}, {'name': '平原', 'type': '基本地 ～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559555&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'a4c44b01-3eb0-48dc-a77f-e1b0c7edc732', 'multiverseId': 559555}, 'multiverseid': 559555}]", "[{'name': 'Ebene', 'type': 'Standardland — Ebene', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559466&type=card', 'language': 'German', 'identifiers': {'scryfallId': '8ba9d816-680e-4351-89fb-c99be92903dc', 'multiverseId': 559466}, 'multiverseid': 559466}, {'name': 'Plaine', 'type': 'Terrain de base : plaine', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559486&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'cef3a5db-8380-4fe8-aef0-6d0f55aa2d24', 'multiverseId': 559486}, 'multiverseid': 559486}, {'name': 'Pianura', 'type': 'Terra Base — Pianura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559496&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '63e7502c-ab7d-49a0-9562-f4779aed319d', 'multiverseId': 559496}, 'multiverseid': 559496}, {'name': '平地', 'type': '基本土地 — 平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559506&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '96f2ec7a-81af-49b6-8cdc-b04b1bb570a2', 'multiverseId': 559506}, 'multiverseid': 559506}, {'name': '들', 'type': '기본 대지 — 들', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559516&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '0f9c53f7-4fd4-4f83-86ab-5cb486a8ee81', 'multiverseId': 559516}, 'multiverseid': 559516}, {'name': '平原', 'type': '基本地 ～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559556&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '7f7b0bac-74b9-4b2e-aed2-490803a6f52b', 'multiverseId': 559556}, 'multiverseid': 559556}]", '[{\'name\': \'Echo-Inspektor\', \'text\': \'Fliegend\\nWenn der Echo-Inspektor ins Spiel kommt, intrigiert er. (Ziehe eine Karte und wirf dann eine Karte ab. Falls du eine Nichtland-Karte abgeworfen hast, lege eine +1/+1-Marke auf diese Kreatur.)\', \'type\': \'Kreatur — Vogel, Räuber\', \'flavor\': \'Das Treffen hatte schon vor Stunden stattgefunden, doch der Obscura-Agent konnte die Rückstände mühelos lesen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555502&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'278e4d17-4fd9-4e3b-aefb-f239f5f41a92\', \'multiverseId\': 555502}, \'multiverseid\': 555502}, {\'name\': \'Inspector de ecos\', \'text\': \'Vuela.\\nCuando el Inspector de ecos entre al campo de batalla, confabula. (Roba una carta, luego descarta una carta. Si descartaste una carta que no sea tierra, pon un contador +1/+1 sobre esta criatura.)\', \'type\': \'Criatura — Bribón ave\', \'flavor\': \'El encuentro sucedió horas atrás, pero los agentes de la Obscura interpretaron los rastros con facilidad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555763&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a539188a-2887-4132-9ec7-b9088665a4f8\', \'multiverseId\': 555763}, \'multiverseid\': 555763}, {\'name\': "Inspecteur d\'écho", \'text\': "Vol\\nQuand l\'Inspecteur d\'écho arrive sur le champ de bataille, il connive. (Piochez une carte, puis défaussez-vous d\'une carte. Si vous vous êtes défaussé d\'une carte non-terrain, mettez un marqueur +1/+1 sur cette créature.)", \'type\': \'Créature : oiseau et gredin\', \'flavor\': "Le rendez-vous remontait à plusieurs heures, mais l\'agent des Obscura en lut aisément les traces.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556024&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'772120b1-c17f-45db-97df-e2382370ad38\', \'multiverseId\': 556024}, \'multiverseid\': 556024}, {\'name\': \'Investigatore di Echi\', \'text\': "Volare\\nQuando l\'Investigatore di Echi entra nel campo di battaglia, complotta. (Pesca una carta, poi scarta una carta. Se hai scartato una carta non terra, metti un segnalino +1/+1 su questa creatura.)", \'type\': \'Creatura — Farabutto Uccello\', \'flavor\': "L\'incontro ha avuto luogo ore fa, ma l\'agente degli Obscura ne ha letto gli echi residui con facilità.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556285&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2aa41cf9-678a-49f0-bc70-ff05e221893f\', \'multiverseId\': 556285}, \'multiverseid\': 556285}, {\'name\': \'こだまの検察官\', \'text\': \'飛行\\nこだまの検察官が戦場に出たとき、これは謀議する。（カード１枚を引き、その後カード１枚を捨てる。あなたが土地でないカードを捨てたなら、このクリーチャーの上に＋１/＋１カウンター１個を置く。）\', \'type\': \'クリーチャー — 鳥・ならず者\', \'flavor\': \'会合が行われたのは何時間も前だが、常夜会一家の工作員はその残響を簡単に読み取った。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556546&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'951ff2e3-ddbe-4228-9434-d3cea8fc7faa\', \'multiverseId\': 556546}, \'multiverseid\': 556546}, {\'name\': \'메아리 검사관\', \'text\': \'비행\\n메아리 검사관이 전장에 들어올 때, 메아리 검사관은 묵인한다. (카드 한 장을 뽑은 후, 카드 한 장을 버린다. 당신이 대지가 아닌 카드를 버린다면, 이 생물에 +1/+1 카운터 한 개를 올려놓는다.)\', \'type\': \'생물 — 조류 도적\', \'flavor\': \'접선이 이뤄진 것은 몇 시간 전이었지만, 옵스큐라 요원은 어렵지 않게 잔류물을 파악했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556807&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'88433db3-a60a-4771-82ad-24e7104c5235\', \'multiverseId\': 556807}, \'multiverseid\': 556807}, {\'name\': \'Inspetor do Eco\', \'text\': \'Voar\\nQuando Inspetor do Eco entra no campo de batalha, ele acoberta. (Compre um card e depois descarte um card. Se você descartou um card não de terreno, coloque um marcador +1/+1 nesta criatura.)\', \'type\': \'Criatura — Ave Ladino\', \'flavor\': \'O encontro ocorrera horas antes, mas o agente dos Obscura decifrou os rastros com facilidade.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557068&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'13a4ee97-6cd3-4075-a3a9-03e9cacc17c1\', \'multiverseId\': 557068}, \'multiverseid\': 557068}, {\'name\': \'Инспектор Эха\', \'text\': \'Полет\\nКогда Инспектор Эха выходит на поле битвы, он сговаривается. (Возьмите карту, затем сбросьте карту. Если вы сбросили не являющуюся землей карту, положите один жетон +1/+1 на это существо.)\', \'type\': \'Существо — Птица Бродяга\', \'flavor\': \'Встреча состоялась несколько часов назад, но агент Обскуры с легкостью прочитал ее осадок.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557329&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8dd3114e-ccc0-4a20-bd45-45ebf16b6d19\', \'multiverseId\': 557329}, \'multiverseid\': 557329}, {\'name\': \'回响巡检员\', \'text\': \'飞行\\n当回响巡检员进战场时，令它筹谋。（抓一张牌，然后弃一张牌。如果你弃的牌不是地，则在此生物上放置一个+1/+1指示物。）\', \'type\': \'生物 ～鸟／浪客\', \'flavor\': \'密会落幕多时，但秘闻帮密探不费吹灰之力便判读出迹证。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557590&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b2e4d8d7-d295-4ed0-b5f8-d767975368ab\', \'multiverseId\': 557590}, \'multiverseid\': 557590}, {\'name\': \'迴響巡檢員\', \'text\': \'飛行\\n當迴響巡檢員進戰場時，令它籌謀。（抽一張牌，然後棄一張牌。如果你棄的牌不是地，則在此生物上放置一個+1/+1指示物。）\', \'type\': \'生物 ～鳥／浪客\', \'flavor\': \'密會落幕多時，但秘聞幫密探不費吹灰之力便判讀出跡證。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557851&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'21b47ea2-f0df-4bf3-8b1e-9446090e46c8\', \'multiverseId\': 557851}, \'multiverseid\': 557851}]', '[{\'name\': \'Einen Profi anheuern\', \'text\': \'Spieler können in diesem Zug keine Lebenspunkte dazuerhalten. Schaden kann in diesem Zug nicht verhindert werden. Einen Profi anheuern fügt einem Ziel deiner Wahl 3 Schadenspunkte zu. (Das Entfernen von Schildmarken verhindert diesen Schaden nicht.)\', \'type\': \'Spontanzauber\', \'flavor\': \'Die Parkhöhen stanken für die nächste Woche nach Schwefel und verbrannter Ölfarbe.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555565&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'75aded2a-c31d-4494-a573-2cc12b252c83\', \'multiverseId\': 555565}, \'multiverseid\': 555565}, {\'name\': \'Llamar a un profesional\', \'text\': \'Los jugadores no pueden ganar vidas este turno. El daño no puede ser prevenido este turno. Llamar a un profesional hace 3 puntos de daño a cualquier objetivo. (Los contadores de escudo no previenen este daño en cuanto se remueven.)\', \'type\': \'Instantáneo\', \'flavor\': \'Durante toda la semana siguiente, el Parque Alto apestó a óleo quemado y azufre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555826&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4717aa93-925f-4c4b-bbd4-412e6cf8226e\', \'multiverseId\': 555826}, \'multiverseid\': 555826}, {\'name\': \'Faire appel à un professionnel\', \'text\': "Les joueurs ne peuvent pas gagner de points de vie ce tour-ci. Les blessures ne peuvent pas être prévenues ce tour-ci. Faire appel à un professionnel inflige 3 blessures à n\'importe quelle cible. (Les marqueurs « bouclier » ne préviennent pas ces blessures au moment où ils sont retirés.)", \'type\': \'Éphémère\', \'flavor\': "Pendant une semaine, les Hauts-Parcs sentirent la peinture à l\'huile brûlée et le souffre.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556087&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'64ac45fa-85fe-4ab2-9f12-3a21d06822cb\', \'multiverseId\': 556087}, \'multiverseid\': 556087}, {\'name\': \'Affidarsi a un Professionista\', \'text\': \'I giocatori non possono guadagnare punti vita in questo turno. Il danno non può essere prevenuto in questo turno. Affidarsi a un Professionista infligge 3 danni a un qualsiasi bersaglio. (I segnalini scudo non potranno prevenire questo danno, ma verranno comunque rimossi.)\', \'type\': \'Istantaneo\', \'flavor\': "Per l\'intera settimana seguente, Vetta del Parco puzzò di vernice bruciata e zolfo.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556348&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'15a1fbdc-9404-46f1-97a8-cc3191aaf02e\', \'multiverseId\': 556348}, \'multiverseid\': 556348}, {\'name\': \'プロの招聘\', \'text\': \'このターン、プレイヤーはライフを得ることができない。このターン、ダメージは軽減できない。クリーチャーやプレインズウォーカーやプレイヤーのうち１つを対象とする。プロの招聘はそれに３点のダメージを与える。（盾カウンターを取り除くに際し、このダメージは軽減されない。）\', \'type\': \'インスタント\', \'flavor\': \'それからの一週間、高街は油絵の具と硫黄の焦げた匂いがした。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556609&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'858019d2-c25c-4752-8415-a6364c8eb47d\', \'multiverseId\': 556609}, \'multiverseid\': 556609}, {\'name\': \'전문가 부르기\', \'text\': \'플레이어들은 이 턴에 생명점을 얻을 수 없다. 이 턴에는 피해를 방지할 수 없다. 원하는 목표를 정한다. 전문가 부르기는 그 목표에게 피해 3점을 입힌다. (방패 카운터가 제거되어도 이 피해를 방지하지 않는다.)\', \'type\': \'순간마법\', \'flavor\': \'한 주 내내, 파크 하이츠에서는 유화용 물감이 탄 냄새와 유황 냄새가 자욱했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556870&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ff995d38-5f3a-4f0a-9096-a22cf8eea255\', \'multiverseId\': 556870}, \'multiverseid\': 556870}, {\'name\': \'Chamar um Profissional\', \'text\': \'Os jogadores não podem ganhar pontos de vida neste turno. Nenhum dano pode ser prevenido neste turno. Chamar um Profissional causa 3 pontos de dano a qualquer alvo. (Os marcadores de escudo não previnem esse dano conforme são removidos.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Por uma semana o Parque Alto cheirou a enxofre e tinta a óleo queimada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557131&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f9a211b2-3a1f-46b2-8c74-b773b9a196e3\', \'multiverseId\': 557131}, \'multiverseid\': 557131}, {\'name\': \'Позвать Профессионала\', \'text\': \'Игроки не могут получать жизни в этом ходу. Повреждения не могут быть предотвращены в этом ходу. Позвать Профессионала наносит 3 повреждения любой цели. (Удаление жетонов щита не предотвращает эти повреждения.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Всю следующую неделю в Парковых Высотах пахло жженой масляной краской и серой.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557392&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0f86ac65-4bda-45fe-bc63-21480c816c92\', \'multiverseId\': 557392}, \'multiverseid\': 557392}, {\'name\': \'找来行家\', \'text\': \'本回合中，牌手不能获得生命。本回合中，伤害不能被防止。找来行家对任意一个目标造成3点伤害。（此时仍要移去后盾指示物，但如此也无法防止伤害。）\', \'type\': \'瞬间\', \'flavor\': \'接下来的一周，高地园弥漫着烧焦的油漆和硫磺味。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557653&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a7879ab8-b8c5-4a80-92ae-c8a7b5dd9522\', \'multiverseId\': 557653}, \'multiverseid\': 557653}, {\'name\': \'找來行家\', \'text\': \'本回合中，玩家不能獲得生命。本回合中，傷害不能被防止。找來行家對任意一個目標造成3點傷害。（此時仍要移去後盾指示物，但如此也無法防止傷害。）\', \'type\': \'瞬間\', \'flavor\': \'接下來的一週，高地園瀰漫著燒焦的油漆和硫磺味。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557914&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'db17b017-1752-4e7b-9388-a41340707d16\', \'multiverseId\': 557914}, \'multiverseid\': 557914}]', '[{\'name\': \'Elegante Entourage\', \'text\': \'Allianz — Immer wenn eine andere Kreatur unter deiner Kontrolle ins Spiel kommt, erhält eine Kreatur deiner Wahl außer der Eleganten Entourage +1/+1 und verursacht Trampelschaden bis zum Ende des Zuges.\', \'type\': \'Kreatur — Elf, Druide\', \'flavor\': \'„Tut mir furchtbar leid, aber das ist eine private Feier, und deine Name steht nicht auf der Liste."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555605&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fc7a48b3-083b-4e7d-86c4-c4d00b255da8\', \'multiverseId\': 555605}, \'multiverseid\': 555605}, {\'name\': \'Séquito elegante\', \'text\': \'Asociación — Siempre que otra criatura entre al campo de batalla bajo tu control, la criatura objetivo que no sea el Séquito elegante obtiene +1/+1 y gana la habilidad de arrollar hasta el final del turno.\', \'type\': \'Criatura — Druida elfo\', \'flavor\': \'"Perdónenos, pero esta fiesta es privada y su nombre no está en la lista".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555866&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a23b8cad-0dad-4794-a5e3-58e2ea0f7203\', \'multiverseId\': 555866}, \'multiverseid\': 555866}, {\'name\': \'Entourage élégant\', \'text\': "Alliance — À chaque fois qu\'une autre créature arrive sur le champ de bataille sous votre contrôle, une créature ciblée autre que l\'Entourage élégant gagne +1/+1 et acquiert le piétinement jusqu\'à la fin du tour.", \'type\': \'Créature : elfe et druide\', \'flavor\': "« Je suis vraiment navrée, mais c\'est une soirée privée, et vous n\'êtes pas sur la liste. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556127&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6b2726b5-98b7-48e0-9c88-7ec69216078a\', \'multiverseId\': 556127}, \'multiverseid\': 556127}, {\'name\': \'Entourage Elegante\', \'text\': "Alleanza — Ogniqualvolta un\'altra creatura entra nel campo di battaglia sotto il tuo controllo, una creatura bersaglio diversa dall\'Entourage Elegante prende +1/+1 e ha travolgere fino alla fine del turno.", \'type\': \'Creatura — Druido Elfo\', \'flavor\': \'"Spiacenti, ma questa è una festa privata e il tuo nome non è nella lista."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556388&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7a53861e-3e1d-492c-88c8-91755d30422c\', \'multiverseId\': 556388}, \'multiverseid\': 556388}, {\'name\': \'洗練された随員\', \'text\': \'団結 ― これでないクリーチャー１体があなたのコントロール下で戦場に出るたび、これでないクリーチャー１体を対象とする。ターン終了時まで、それは＋１/＋１の修整を受けトランプルを得る。\', \'type\': \'クリーチャー — エルフ・ドルイド\', \'flavor\': \'「大変申し訳ございませんが、こちらはプライベート・パーティーでして、あなたのお名前は名簿にございません。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556649&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b332f97c-9d8c-4d3b-b24f-b053b4ed0591\', \'multiverseId\': 556649}, \'multiverseid\': 556649}, {\'name\': \'품격 있는 수행원\', \'text\': \'연대 — 다른 생물이 당신의 조종하에 전장에 들어올 때마다, 품격 있는 수행원이 아닌 생물을 목표로 정한다. 그 생물은 턴종료까지 +1/+1을 받고 돌진을 얻는다.\', \'type\': \'생물 — 엘프 드루이드\', \'flavor\': \'"정말 죄송하지만, 이건 사적인 파티이고 당신의 이름은 명단에 없습니다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556910&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'51a54cb1-4b46-4ffb-a01a-b30b399a4a30\', \'multiverseId\': 556910}, \'multiverseid\': 556910}, {\'name\': \'Séquito Elegante\', \'text\': \'Aliança — Toda vez que outra criatura entra no campo de batalha sob seu controle, a criatura alvo que não seja Séquito Elegante recebe +1/+1 e ganha atropelar até o final do turno.\', \'type\': \'Criatura — Elfo Druida\', \'flavor\': \'"Mil perdões, mas essa é uma festa particular e o seu nome não está na lista."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557171&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7a40d41a-fb24-4b24-a5c4-55f346b1a128\', \'multiverseId\': 557171}, \'multiverseid\': 557171}, {\'name\': \'Элегантная Свита\', \'text\': \'Альянс — Каждый раз, когда другое существо выходит на поле битвы под вашим контролем, целевое существо, отличное от Элегантной Свиты, получает +1/+1 и Пробивной удар до конца хода.\', \'type\': \'Существо — Эльф Друид\', \'flavor\': \'«Покорнейше просим прощения, но это частная вечеринка, и вашего имени нет в списке».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557432&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b71b0935-9cd5-4f20-881b-4877478fc2fe\', \'multiverseId\': 557432}, \'multiverseid\': 557432}, {\'name\': \'优雅随从\', \'text\': \'联手～每当另一个生物在你的操控下进战场时，直到回合结束，目标优雅随从以外的生物得+1/+1且获得践踏异能。\', \'type\': \'生物 ～妖精／德鲁伊\', \'flavor\': \'「非常抱歉，这是场私人派对，你不在受邀名单上。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557693&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ab58434c-b933-4549-a527-46691855bc82\', \'multiverseId\': 557693}, \'multiverseid\': 557693}, {\'name\': \'優雅隨從\', \'text\': \'聯手～每當另一個生物在你的操控下進戰場時，直到回合結束，目標優雅隨從以外的生物得+1/+1且獲得踐踏異能。\', \'type\': \'生物 ～妖精／德魯伊\', \'flavor\': \'「非常抱歉，這是場私人派對，你不在受邀名單上。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557954&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6ba62111-a125-4315-b814-96515fb4485e\', \'multiverseId\': 557954}, \'multiverseid\': 557954}]', '[{\'name\': \'Elspeth die Strahlende\', \'text\': \'+1: Bestimme bis zu eine Kreatur deiner Wahl. Lege eine +1/+1-Marke und eine Fliegend-, Erstschlag-, Lebensverknüpfung- oder Wachsamkeit-Marke auf sie (du entscheidest).\\n−3: Schaue dir die obersten sieben Karten deiner Bibliothek an. Du kannst davon eine bleibende Karte mit Manabetrag 3 oder weniger mit einer Schildmarke ins Spiel bringen. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.\\n−7: Erzeuge fünf 3/3 weiße Engel-Kreaturenspielsteine mit Flugfähigkeit.\', \'type\': \'Legendärer Planeswalker — Elspeth\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555473&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9236fec0-c9a6-4a62-b2c3-1ed46ee428b7\', \'multiverseId\': 555473}, \'multiverseid\': 555473}, {\'name\': \'Elspeth resplandeciente\', \'text\': \'+1: Elige hasta una criatura objetivo. Pon un contador +1/+1 y un contador de volar, dañar primero, vínculo vital o vigilancia sobre ella.\\n−3: Mira las siete primeras cartas de tu biblioteca. Puedes poner una carta de permanente con valor de maná de 3 o menos de entre ellas en el campo de batalla con un contador de escudo sobre ella. Pon el resto en el fondo de tu biblioteca en un orden aleatorio.\\n−7: Crea cinco fichas de criatura Ángel blancas 3/3 con la habilidad de volar.\', \'type\': \'Planeswalker legendario — Elspeth\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555734&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1e985322-153f-479d-9674-7e964e293ed1\', \'multiverseId\': 555734}, \'multiverseid\': 555734}, {\'name\': \'Elspeth resplendissante\', \'text\': "+1: Choisissez jusqu\'à une créature ciblée. Mettez un marqueur +1/+1 et un marqueur parmi « vol », « initiative », « lien de vie » ou « vigilance » sur elle.\\n-3: Regardez les sept cartes du dessus de votre bibliothèque. Parmi elles, vous pouvez mettre sur le champ de bataille une carte de permanent avec une valeur de mana inférieure ou égale à 3 avec un marqueur « bouclier » sur elle. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.\\n-7: Créez cinq jetons de créature 3/3 blanche Ange avec le vol.", \'type\': \'Planeswalker légendaire : Elspeth\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555995&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c189f26d-bba1-4aba-a97e-51607e3466e6\', \'multiverseId\': 555995}, \'multiverseid\': 555995}, {\'name\': \'Elspeth Splendente\', \'text\': \'+1: Scegli fino a una creatura bersaglio. Metti su di essa un segnalino +1/+1 e un segnalino tra volare, attacco improvviso, legame vitale o cautela.\\n−3: Guarda le prime sette carte del tuo grimorio. Puoi mettere sul campo di battaglia una carta permanente con valore di mana pari o inferiore a 3 scelta tra esse con un segnalino scudo. Metti le altre in fondo al tuo grimorio in ordine casuale.\\n−7: Crea cinque pedine creatura Angelo 3/3 bianche con volare.\', \'type\': \'Planeswalker Leggendario — Elspeth\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556256&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'40f61590-9441-4a42-ae25-0252bcba5b8d\', \'multiverseId\': 556256}, \'multiverseid\': 556256}, {\'name\': \'華やいだエルズペス\', \'text\': \'+1：クリーチャー最大１体を対象とする。それの上に＋１/＋１カウンター１個と、飛行や先制攻撃や絆魂や警戒のうち１種類のカウンター１個を置く。\\n-3：あなたのライブラリーの一番上にあるカード７枚を見る。それらの中からマナ総量が３以下であるパーマネント・カード１枚を、盾カウンター１個を置いた状態で戦場に出してもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。\\n-7：飛行を持つ白の３/３の天使・クリーチャー・トークン５体を生成する。\', \'type\': \'伝説のプレインズウォーカー — エルズペス\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556517&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'76a34824-9b6d-4887-b46c-c4726977e235\', \'multiverseId\': 556517}, \'multiverseid\': 556517}, {\'name\': \'눈부시게 빛나는 엘스페스\', \'text\': \'+1: 생물을 최대 한 개까지 목표로 정한다. 그 생물에 +1/+1 카운터 한 개 및 비행, 선제공격, 생명연결, 또는 경계 카운터 중 한 개를 올려놓는다.\\n−3: 당신의 서고 맨 위 카드 일곱 장을 본다. 당신은 그중에서 마나 값이 3 이하인 지속물 카드 한 장에 방패 카운터 한 개를 올려놓고 당신의 조종하에 전장에 놓을 수 있다. 나머지 카드들은 무작위 순서로 당신의 서고 맨 밑에 놓는다.\\n−7: 비행을 가진 3/3 백색 천사 생물 토큰 다섯 개를 만든다.\', \'type\': \'전설적 플레인즈워커 — 엘스페스\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556778&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'033538df-f8ad-4204-ba1f-9f9db0977739\', \'multiverseId\': 556778}, \'multiverseid\': 556778}, {\'name\': \'Elspeth Resplandecente\', \'text\': \'+1: Escolha até uma criatura alvo. Coloque nela um marcador +1/+1 e um marcador à sua escolha dentre voar, iniciativa, vínculo com a vida ou vigilância.\\n−3: Olhe os sete cards do topo de seu grimório. Você pode colocar um card de permanente com valor de mana igual ou inferior a 3 dentre eles no campo de batalha com um marcador de escudo. Coloque o restante no fundo de seu grimório em ordem aleatória.\\n−7: Crie cinco fichas de criatura Anjo branca 3/3 com voar.\', \'type\': \'Planeswalker Lendário — Elspeth\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557039&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ee38ec47-2654-4e57-b008-824989daee53\', \'multiverseId\': 557039}, \'multiverseid\': 557039}, {\'name\': \'Элспет Великолепная\', \'text\': \'+1: выберите не более одного целевого существа. Положите на него один жетон +1/+1 и один жетон, выбранный из Полета, Первого удара, Цепи жизни или Бдительности.\\n—3: посмотрите семь верхних карт вашей библиотеки. Вы можете положить на поле битвы находящуюся среди них карту перманента с мановой ценностью не более 3 с одним жетоном щита на ней. Положите остальные карты в низ вашей библиотеки в случайном порядке.\\n−7: создайте пять фишек существа 3/3 белый Ангел с Полетом.\', \'type\': \'Легендарный Planeswalker — Элспет\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557300&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b9c8268a-aad3-430a-901f-d08b62528c6e\', \'multiverseId\': 557300}, \'multiverseid\': 557300}, {\'name\': \'华辉艾紫培\', \'text\': \'+1：选择至多一个目标生物。在其上放置一个+1/+1指示物和一个飞行，先攻，系命或警戒指示物。\\n−3：检视你牌库顶的七张牌。你可以将其中一张法术力值等于或小于3的永久物牌放进战场，且上面有一个后盾指示物。将其余的牌以随机顺序置于你的牌库底。\\n−7：派出五个3/3白色，具飞行异能的天使衍生生物。\', \'type\': \'传奇鹏洛客 ～艾紫培\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557561&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4db6c501-ac4e-4212-b2f4-d14423b5dd80\', \'multiverseId\': 557561}, \'multiverseid\': 557561}, {\'name\': \'華輝艾紫培\', \'text\': \'+1：選擇至多一個目標生物。在其上放置一個+1/+1指示物和一個飛行，先攻，繫命或警戒指示物。\\n−3：檢視你牌庫頂的七張牌。你可以將其中一張魔法力值等於或小於3的永久物牌放進戰場，且上面有一個後盾指示物。將其餘的牌以隨機順序置於你的牌庫底。\\n−7：派出五個3/3白色，具飛行異能的天使衍生生物。\', \'type\': \'傳奇鵬洛客 ～艾紫培\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557822&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'89a7fe76-7157-438d-acfb-39928c931a84\', \'multiverseId\': 557822}, \'multiverseid\': 557822}]', '[{\'name\': \'Elspeth die Strahlende\', \'text\': \'+1: Bestimme bis zu eine Kreatur deiner Wahl. Lege eine +1/+1-Marke und eine Fliegend-, Erstschlag-, Lebensverknüpfung- oder Wachsamkeit-Marke auf sie (du entscheidest).\\n−3: Schaue dir die obersten sieben Karten deiner Bibliothek an. Du kannst davon eine bleibende Karte mit Manabetrag 3 oder weniger mit einer Schildmarke ins Spiel bringen. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.\\n−7: Erzeuge fünf 3/3 weiße Engel-Kreaturenspielsteine mit Flugfähigkeit.\', \'type\': \'Legendärer Planeswalker — Elspeth\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558076&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0f31305a-e0ae-4869-9933-015a490a3deb\', \'multiverseId\': 558076}, \'multiverseid\': 558076}, {\'name\': \'Elspeth resplandeciente\', \'text\': \'+1: Elige hasta una criatura objetivo. Pon un contador +1/+1 y un contador de volar, dañar primero, vínculo vital o vigilancia sobre ella.\\n−3: Mira las siete primeras cartas de tu biblioteca. Puedes poner una carta de permanente con valor de maná de 3 o menos de entre ellas en el campo de batalla con un contador de escudo sobre ella. Pon el resto en el fondo de tu biblioteca en un orden aleatorio.\\n−7: Crea cinco fichas de criatura Ángel blancas 3/3 con la habilidad de volar.\', \'type\': \'Planeswalker legendario — Elspeth\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558079&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'abf85167-4084-4952-8b25-17fd5e9da55d\', \'multiverseId\': 558079}, \'multiverseid\': 558079}, {\'name\': \'Elspeth resplendissante\', \'text\': "+1: Choisissez jusqu\'à une créature ciblée. Mettez un marqueur +1/+1 et un marqueur parmi « vol », « initiative », « lien de vie » ou « vigilance » sur elle.\\n-3: Regardez les sept cartes du dessus de votre bibliothèque. Parmi elles, vous pouvez mettre sur le champ de bataille une carte de permanent avec une valeur de mana inférieure ou égale à 3 avec un marqueur « bouclier » sur elle. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.\\n-7: Créez cinq jetons de créature 3/3 blanche Ange avec le vol.", \'type\': \'Planeswalker légendaire : Elspeth\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558082&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cf07055d-0c2e-4e67-869b-7d29c51272fb\', \'multiverseId\': 558082}, \'multiverseid\': 558082}, {\'name\': \'Elspeth Splendente\', \'text\': \'+1: Scegli fino a una creatura bersaglio. Metti su di essa un segnalino +1/+1 e un segnalino tra volare, attacco improvviso, legame vitale o cautela.\\n−3: Guarda le prime sette carte del tuo grimorio. Puoi mettere sul campo di battaglia una carta permanente con valore di mana pari o inferiore a 3 scelta tra esse con un segnalino scudo. Metti le altre in fondo al tuo grimorio in ordine casuale.\\n−7: Crea cinque pedine creatura Angelo 3/3 bianche con volare.\', \'type\': \'Planeswalker Leggendario — Elspeth\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558085&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5e9a2834-da71-492f-83fc-5a213cd61eb2\', \'multiverseId\': 558085}, \'multiverseid\': 558085}, {\'name\': \'華やいだエルズペス\', \'text\': \'+1：クリーチャー最大１体を対象とする。それの上に＋１/＋１カウンター１個と、飛行や先制攻撃や絆魂や警戒のうち１種類のカウンター１個を置く。\\n-3：あなたのライブラリーの一番上にあるカード７枚を見る。それらの中からマナ総量が３以下であるパーマネント・カード１枚を、盾カウンター１個を置いた状態で戦場に出してもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。\\n-7：飛行を持つ白の３/３の天使・クリーチャー・トークン５体を生成する。\', \'type\': \'伝説のプレインズウォーカー — エルズペス\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558088&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'31cee154-e5ef-4d45-adc0-415668722cb8\', \'multiverseId\': 558088}, \'multiverseid\': 558088}, {\'name\': \'눈부시게 빛나는 엘스페스\', \'text\': \'+1: 생물을 최대 한 개까지 목표로 정한다. 그 생물에 +1/+1 카운터 한 개 및 비행, 선제공격, 생명연결, 또는 경계 카운터 중 한 개를 올려놓는다.\\n−3: 당신의 서고 맨 위 카드 일곱 장을 본다. 당신은 그중에서 마나 값이 3 이하인 지속물 카드 한 장에 방패 카운터 한 개를 올려놓고 당신의 조종하에 전장에 놓을 수 있다. 나머지 카드들은 무작위 순서로 당신의 서고 맨 밑에 놓는다.\\n−7: 비행을 가진 3/3 백색 천사 생물 토큰 다섯 개를 만든다.\', \'type\': \'전설적 플레인즈워커 — 엘스페스\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558091&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a40c3c88-06f5-4225-91b5-fcf3a72cb615\', \'multiverseId\': 558091}, \'multiverseid\': 558091}, {\'name\': \'Elspeth Resplandecente\', \'text\': \'+1: Escolha até uma criatura alvo. Coloque nela um marcador +1/+1 e um marcador à sua escolha dentre voar, iniciativa, vínculo com a vida ou vigilância.\\n−3: Olhe os sete cards do topo de seu grimório. Você pode colocar um card de permanente com valor de mana igual ou inferior a 3 dentre eles no campo de batalha com um marcador de escudo. Coloque o restante no fundo de seu grimório em ordem aleatória.\\n−7: Crie cinco fichas de criatura Anjo branca 3/3 com voar.\', \'type\': \'Planeswalker Lendário — Elspeth\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558094&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4166ae80-ca33-4e72-8457-6eb65bc2bcae\', \'multiverseId\': 558094}, \'multiverseid\': 558094}, {\'name\': \'Элспет Великолепная\', \'text\': \'+1: выберите не более одного целевого существа. Положите на него один жетон +1/+1 и один жетон, выбранный из Полета, Первого удара, Цепи жизни или Бдительности.\\n—3: посмотрите семь верхних карт вашей библиотеки. Вы можете положить на поле битвы находящуюся среди них карту перманента с мановой ценностью не более 3 с одним жетоном щита на ней. Положите остальные карты в низ вашей библиотеки в случайном порядке.\\n−7: создайте пять фишек существа 3/3 белый Ангел с Полетом.\', \'type\': \'Легендарный Planeswalker — Элспет\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558097&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'955d9af3-b536-4cfc-aded-dff1f68e628a\', \'multiverseId\': 558097}, \'multiverseid\': 558097}, {\'name\': \'华辉艾紫培\', \'text\': \'+1：选择至多一个目标生物。在其上放置一个+1/+1指示物和一个飞行，先攻，系命或警戒指示物。\\n−3：检视你牌库顶的七张牌。你可以将其中一张法术力值等于或小于3的永久物牌放进战场，且上面有一个后盾指示物。将其余的牌以随机顺序置于你的牌库底。\\n−7：派出五个3/3白色，具飞行异能的天使衍生生物。\', \'type\': \'传奇鹏洛客 ～艾紫培\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558100&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c0ed48e0-f4a8-44dd-a13b-e4852a063ecb\', \'multiverseId\': 558100}, \'multiverseid\': 558100}, {\'name\': \'華輝艾紫培\', \'text\': \'+1：選擇至多一個目標生物。在其上放置一個+1/+1指示物和一個飛行，先攻，繫命或警戒指示物。\\n−3：檢視你牌庫頂的七張牌。你可以將其中一張魔法力值等於或小於3的永久物牌放進戰場，且上面有一個後盾指示物。將其餘的牌以隨機順序置於你的牌庫底。\\n−7：派出五個3/3白色，具飛行異能的天使衍生生物。\', \'type\': \'傳奇鵬洛客 ～艾紫培\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558103&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'771f877b-a344-48c8-8b8c-f07a5bda53ec\', \'multiverseId\': 558103}, \'multiverseid\': 558103}]', '[{\'name\': \'Elspeth die Strahlende\', \'text\': \'+1: Bestimme bis zu eine Kreatur deiner Wahl. Lege eine +1/+1-Marke und eine Fliegend-, Erstschlag-, Lebensverknüpfung- oder Wachsamkeit-Marke auf sie (du entscheidest).\\n−3: Schaue dir die obersten sieben Karten deiner Bibliothek an. Du kannst davon eine bleibende Karte mit Manabetrag 3 oder weniger mit einer Schildmarke ins Spiel bringen. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.\\n−7: Erzeuge fünf 3/3 weiße Engel-Kreaturenspielsteine mit Flugfähigkeit.\', \'type\': \'Legendärer Planeswalker — Elspeth\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558549&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'42b859c3-97b8-431c-91b9-e2e48a8b53c9\', \'multiverseId\': 558549}, \'multiverseid\': 558549}, {\'name\': \'Elspeth resplandeciente\', \'text\': \'+1: Elige hasta una criatura objetivo. Pon un contador +1/+1 y un contador de volar, dañar primero, vínculo vital o vigilancia sobre ella.\\n−3: Mira las siete primeras cartas de tu biblioteca. Puedes poner una carta de permanente con valor de maná de 3 o menos de entre ellas en el campo de batalla con un contador de escudo sobre ella. Pon el resto en el fondo de tu biblioteca en un orden aleatorio.\\n−7: Crea cinco fichas de criatura Ángel blancas 3/3 con la habilidad de volar.\', \'type\': \'Planeswalker legendario — Elspeth\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558558&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'09b382cf-33a5-434b-9415-99d39d202453\', \'multiverseId\': 558558}, \'multiverseid\': 558558}, {\'name\': \'Elspeth resplendissante\', \'text\': "+1: Choisissez jusqu\'à une créature ciblée. Mettez un marqueur +1/+1 et un marqueur parmi « vol », « initiative », « lien de vie » ou « vigilance » sur elle.\\n-3: Regardez les sept cartes du dessus de votre bibliothèque. Parmi elles, vous pouvez mettre sur le champ de bataille une carte de permanent avec une valeur de mana inférieure ou égale à 3 avec un marqueur « bouclier » sur elle. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.\\n-7: Créez cinq jetons de créature 3/3 blanche Ange avec le vol.", \'type\': \'Planeswalker légendaire : Elspeth\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558567&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f6a5d509-4d4e-48a6-82cd-ef0511ef3be0\', \'multiverseId\': 558567}, \'multiverseid\': 558567}, {\'name\': \'Elspeth Splendente\', \'text\': \'+1: Scegli fino a una creatura bersaglio. Metti su di essa un segnalino +1/+1 e un segnalino tra volare, attacco improvviso, legame vitale o cautela.\\n−3: Guarda le prime sette carte del tuo grimorio. Puoi mettere sul campo di battaglia una carta permanente con valore di mana pari o inferiore a 3 scelta tra esse con un segnalino scudo. Metti le altre in fondo al tuo grimorio in ordine casuale.\\n−7: Crea cinque pedine creatura Angelo 3/3 bianche con volare.\', \'type\': \'Planeswalker Leggendario — Elspeth\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558576&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'50013cfc-6b7c-4b9c-849f-1926ae81a805\', \'multiverseId\': 558576}, \'multiverseid\': 558576}, {\'name\': \'華やいだエルズペス\', \'text\': \'+1：クリーチャー最大１体を対象とする。それの上に＋１/＋１カウンター１個と、飛行や先制攻撃や絆魂や警戒のうち１種類のカウンター１個を置く。\\n-3：あなたのライブラリーの一番上にあるカード７枚を見る。それらの中からマナ総量が３以下であるパーマネント・カード１枚を、盾カウンター１個を置いた状態で戦場に出してもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。\\n-7：飛行を持つ白の３/３の天使・クリーチャー・トークン５体を生成する。\', \'type\': \'伝説のプレインズウォーカー — エルズペス\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558585&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1dcc17d0-2827-4263-8d54-d672e40737ec\', \'multiverseId\': 558585}, \'multiverseid\': 558585}, {\'name\': \'눈부시게 빛나는 엘스페스\', \'text\': \'+1: 생물을 최대 한 개까지 목표로 정한다. 그 생물에 +1/+1 카운터 한 개 및 비행, 선제공격, 생명연결, 또는 경계 카운터 중 한 개를 올려놓는다.\\n−3: 당신의 서고 맨 위 카드 일곱 장을 본다. 당신은 그중에서 마나 값이 3 이하인 지속물 카드 한 장에 방패 카운터 한 개를 올려놓고 당신의 조종하에 전장에 놓을 수 있다. 나머지 카드들은 무작위 순서로 당신의 서고 맨 밑에 놓는다.\\n−7: 비행을 가진 3/3 백색 천사 생물 토큰 다섯 개를 만든다.\', \'type\': \'전설적 플레인즈워커 — 엘스페스\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558594&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a563a073-b5e4-4888-bbad-0bfb5e4c86e2\', \'multiverseId\': 558594}, \'multiverseid\': 558594}, {\'name\': \'Elspeth Resplandecente\', \'text\': \'+1: Escolha até uma criatura alvo. Coloque nela um marcador +1/+1 e um marcador à sua escolha dentre voar, iniciativa, vínculo com a vida ou vigilância.\\n−3: Olhe os sete cards do topo de seu grimório. Você pode colocar um card de permanente com valor de mana igual ou inferior a 3 dentre eles no campo de batalha com um marcador de escudo. Coloque o restante no fundo de seu grimório em ordem aleatória.\\n−7: Crie cinco fichas de criatura Anjo branca 3/3 com voar.\', \'type\': \'Planeswalker Lendário — Elspeth\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558603&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3f89eea9-4ae2-4523-9be2-664f85cb9c5e\', \'multiverseId\': 558603}, \'multiverseid\': 558603}, {\'name\': \'Элспет Великолепная\', \'text\': \'+1: выберите не более одного целевого существа. Положите на него один жетон +1/+1 и один жетон, выбранный из Полета, Первого удара, Цепи жизни или Бдительности.\\n—3: посмотрите семь верхних карт вашей библиотеки. Вы можете положить на поле битвы находящуюся среди них карту перманента с мановой ценностью не более 3 с одним жетоном щита на ней. Положите остальные карты в низ вашей библиотеки в случайном порядке.\\n−7: создайте пять фишек существа 3/3 белый Ангел с Полетом.\', \'type\': \'Легендарный Planeswalker — Элспет\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558612&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4a7617c9-714f-403f-b427-e2d36ae955f5\', \'multiverseId\': 558612}, \'multiverseid\': 558612}, {\'name\': \'华辉艾紫培\', \'text\': \'+1：选择至多一个目标生物。在其上放置一个+1/+1指示物和一个飞行，先攻，系命或警戒指示物。\\n−3：检视你牌库顶的七张牌。你可以将其中一张法术力值等于或小于3的永久物牌放进战场，且上面有一个后盾指示物。将其余的牌以随机顺序置于你的牌库底。\\n−7：派出五个3/3白色，具飞行异能的天使衍生生物。\', \'type\': \'传奇鹏洛客 ～艾紫培\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558621&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'239bcf77-166e-420c-bb33-4c31d608d1fa\', \'multiverseId\': 558621}, \'multiverseid\': 558621}, {\'name\': \'華輝艾紫培\', \'text\': \'+1：選擇至多一個目標生物。在其上放置一個+1/+1指示物和一個飛行，先攻，繫命或警戒指示物。\\n−3：檢視你牌庫頂的七張牌。你可以將其中一張魔法力值等於或小於3的永久物牌放進戰場，且上面有一個後盾指示物。將其餘的牌以隨機順序置於你的牌庫底。\\n−7：派出五個3/3白色，具飛行異能的天使衍生生物。\', \'type\': \'傳奇鵬洛客 ～艾紫培\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558630&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4b4831c7-dc9b-4ffe-ae6d-d7e0aa6886b8\', \'multiverseId\': 558630}, \'multiverseid\': 558630}]', '[{\'name\': \'Endlose Umleitung\', \'text\': \'Der Besitzer eines Zauberspruchs, einer bleibenden Karte, die kein Land ist, oder einer Karte in einem Friedhof deiner Wahl legt ihn bzw. sie auf oder unter seine Bibliothek.\', \'type\': \'Spontanzauber\', \'flavor\': \'Nach der elften Baustellenumleitung keimte in der Taxifahrerin der Verdacht auf, dass sie in eine Falle getrieben wurde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555645&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'97152cab-0ef4-45c8-a53e-4ab1f12adb3f\', \'multiverseId\': 555645}, \'multiverseid\': 555645}, {\'name\': \'Desvío eterno\', \'text\': \'El propietario del hechizo, permanente que no sea tierra o carta en un cementerio objetivo pone esa carta en la parte superior o en el fondo de su biblioteca.\', \'type\': \'Instantáneo\', \'flavor\': \'Tras desviarse por la undécima valla de obra, la conductora del taxi empezó a sospechar que la estaban guiando hacia una trampa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555906&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c6b201ce-4ccc-4608-9675-43528742572f\', \'multiverseId\': 555906}, \'multiverseid\': 555906}, {\'name\': \'Déviation sans fin\', \'text\': "Le propriétaire d\'une cible, sort, permanent non-terrain ou carte dans un cimetière, la met au-dessus ou au-dessous de sa bibliothèque.", \'type\': \'Éphémère\', \'flavor\': "Après avoir emprunté sa onzième déviation pour travaux, la chauffeuse de taxi commença à soupçonner qu\'elle allait droit dans un piège.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556167&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'75bf51ad-f898-4e50-82d5-73406751c450\', \'multiverseId\': 556167}, \'multiverseid\': 556167}, {\'name\': \'Deviazione Eterna\', \'text\': \'Il proprietario di una magia, un permanente non terra o una carta bersaglio in un cimitero mette quel bersaglio in cima o in fondo al suo grimorio.\', \'type\': \'Istantaneo\', \'flavor\': "Dopo aver deviato intorno all\'undicesima barriera di costruzione, la tassista iniziò a sospettare di essere stata trascinata in una trappola.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556428&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0b5089e7-6802-4f73-bd11-1220f391d828\', \'multiverseId\': 556428}, \'multiverseid\': 556428}, {\'name\': \'終わりなき迂回\', \'text\': \'呪文や、土地でないパーマネントや、墓地にあるカードのうち１つを対象とする。それのオーナーはそれを自分のライブラリーの一番上か一番下に置く。\', \'type\': \'インスタント\', \'flavor\': \'十一ヶ所目の建設用バリケードを回り込んだ後、自分は罠に嵌められているのではないかとタクシーの運転手は疑い始めた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556689&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b1357e7f-46c3-4baf-85ae-b16e488a16fa\', \'multiverseId\': 556689}, \'multiverseid\': 556689}, {\'name\': \'끝없는 우회로\', \'text\': \'주문, 대지가 아닌 지속물, 또는 무덤에 있는 카드를 목표로 정한다. 그 목표의 소유자는 그 목표를 자신의 서고 맨 위 또는 맨 밑에 놓는다.\', \'type\': \'순간마법\', \'flavor\': \'열한 번째 공사 장벽을 우회한 뒤에, 택시 운전사는 자신이 함정으로 유인당하고 있다고 의심하기 시작했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556950&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'951ffc83-320b-4177-9895-58d7e025e7f1\', \'multiverseId\': 556950}, \'multiverseid\': 556950}, {\'name\': \'Desvio Interminável\', \'text\': \'O dono da mágica, do card em um cemitério ou da permanente não de terreno alvo o coloca no topo ou no fundo do próprio grimório.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Depois de desviar da décima primeira barreira, a taxista começou a suspeitar que estava sendo conduzida a uma armadilha.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557211&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7c23d63a-7a9b-4ebf-8749-619268e3a552\', \'multiverseId\': 557211}, \'multiverseid\': 557211}, {\'name\': \'Бесконечный Объезд\', \'text\': \'Владелец целевого заклинания, не являющегося землей перманента или карты на кладбище кладет его/ее на верх или в низ своей библиотеки.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Объезжая одиннадцатый строительный барьер, водительница такси начала подозревать, что ее ведут в ловушку.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557472&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ea00648d-4367-4b28-a58b-5229b303e5d2\', \'multiverseId\': 557472}, \'multiverseid\': 557472}, {\'name\': \'无尽迂回\', \'text\': \'选择目标咒语，非地永久物或坟墓场中的牌。其操控者将它置于其牌库顶或牌库底。\', \'type\': \'瞬间\', \'flavor\': \'绕过第十一道路障后，出租车司机开始怀疑自己是否被带进了陷阱。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557733&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2f7b22d5-d278-462c-a418-69645a674b79\', \'multiverseId\': 557733}, \'multiverseid\': 557733}, {\'name\': \'無盡迂迴\', \'text\': \'選擇目標咒語，非地永久物或墳墓場中的牌。其操控者將它置於其牌庫頂或牌庫底。\', \'type\': \'瞬間\', \'flavor\': \'繞過第十一道路障後，計程車司機開始懷疑自己是否被帶進了陷阱。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557994&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f302c3db-a6ab-4c51-80ac-cd8bb5c70210\', \'multiverseId\': 557994}, \'multiverseid\': 557994}]', '[{\'name\': \'Endlose Umleitung\', \'text\': \'Der Besitzer eines Zauberspruchs, einer bleibenden Karte, die kein Land ist, oder einer Karte in einem Friedhof deiner Wahl legt ihn bzw. sie auf oder unter seine Bibliothek.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558748&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'df3d2dd5-e31a-4b21-aade-d34b2269c5ae\', \'multiverseId\': 558748}, \'multiverseid\': 558748}, {\'name\': \'Desvío eterno\', \'text\': \'El propietario del hechizo, permanente que no sea tierra o carta en un cementerio objetivo pone esa carta en la parte superior o en el fondo de su biblioteca.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558793&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7228064e-ed63-4f69-b07e-60896760792e\', \'multiverseId\': 558793}, \'multiverseid\': 558793}, {\'name\': \'Déviation sans fin\', \'text\': "Le propriétaire d\'une cible, sort, permanent non-terrain ou carte dans un cimetière, la met au-dessus ou au-dessous de sa bibliothèque.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558838&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d45aa396-ee82-4032-9f6c-88ec35c0f023\', \'multiverseId\': 558838}, \'multiverseid\': 558838}, {\'name\': \'Deviazione Eterna\', \'text\': \'Il proprietario di una magia, un permanente non terra o una carta bersaglio in un cimitero mette quel bersaglio in cima o in fondo al suo grimorio.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558883&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8e12f73f-0a37-42ad-8f08-d3250b23b392\', \'multiverseId\': 558883}, \'multiverseid\': 558883}, {\'name\': \'終わりなき迂回\', \'text\': \'呪文や、土地でないパーマネントや、墓地にあるカードのうち１つを対象とする。それのオーナーはそれを自分のライブラリーの一番上か一番下に置く。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558928&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'19b119f4-ee59-4fe3-87d6-22152997e618\', \'multiverseId\': 558928}, \'multiverseid\': 558928}, {\'name\': \'끝없는 우회로\', \'text\': \'주문, 대지가 아닌 지속물, 또는 무덤에 있는 카드를 목표로 정한다. 그 목표의 소유자는 그 목표를 자신의 서고 맨 위 또는 맨 밑에 놓는다.\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558973&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'569943eb-47c5-469a-a11b-79fb2167b6ea\', \'multiverseId\': 558973}, \'multiverseid\': 558973}, {\'name\': \'Desvio Interminável\', \'text\': \'O dono da mágica, do card em um cemitério ou da permanente não de terreno alvo o coloca no topo ou no fundo do próprio grimório.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559018&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5b776e98-a439-41b7-9c8f-10fdc011029b\', \'multiverseId\': 559018}, \'multiverseid\': 559018}, {\'name\': \'Бесконечный Объезд\', \'text\': \'Владелец целевого заклинания, не являющегося землей перманента или карты на кладбище кладет его/ее на верх или в низ своей библиотеки.\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559063&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'db1e6b22-e03b-41aa-9858-7853b200df61\', \'multiverseId\': 559063}, \'multiverseid\': 559063}, {\'name\': \'无尽迂回\', \'text\': \'选择目标咒语，非地永久物或坟墓场中的牌。其操控者将它置于其牌库顶或牌库底。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559108&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'860b1ba7-044e-4219-ac45-882333fba0c9\', \'multiverseId\': 559108}, \'multiverseid\': 559108}, {\'name\': \'無盡迂迴\', \'text\': \'選擇目標咒語，非地永久物或墳墓場中的牌。其操控者將它置於其牌庫頂或牌庫底。\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559153&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f5e18d6d-063e-4e53-91e4-1dd39f2b9764\', \'multiverseId\': 559153}, \'multiverseid\': 559153}]', '[{\'name\': \'Engel des Leids\', \'text\': \'Fliegend\\nFalls dir Schaden zugefügt würde, verhinderst du den Schaden und millst doppelt so viele Karten.\', \'type\': \'Kreatur — Nachtmahr, Engel\', \'flavor\': \'„Wenn du dir Segnungen wünschst, Sterblicher, bitte deine dämonischen Meister. Wir haben genug gegeben."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555529&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fb81d4dd-af43-42aa-bf4a-ee06ca0a091d\', \'multiverseId\': 555529}, \'multiverseid\': 555529}, {\'name\': \'Ángel del sufrimiento\', \'text\': \'Vuela.\\nSi fueras a recibir daño, prevén ese daño y muele el doble de esa cantidad de cartas.\', \'type\': \'Criatura — Ángel pesadilla\', \'flavor\': \'"Si anhelas bendiciones, mortal, pídeselas a tus maestros demoníacos. Nosotros ya concedimos demasiadas a los de tu especie".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555790&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dbcb77fc-87e9-400a-8738-2a86267e5644\', \'multiverseId\': 555790}, \'multiverseid\': 555790}, {\'name\': \'Ange de la souffrance\', \'text\': \'Vol\\nSi des blessures devaient vous être infligées, prévenez ces blessures et meulez deux fois autant de cartes.\', \'type\': \'Créature : cauchemar et ange\', \'flavor\': \'« Si tu veux des bénédictions, mortel, demande à tes maîtres les démons. Nous avons assez donné à ton espèce. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556051&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e90948bd-fab8-4d07-9239-8ed4965b21c8\', \'multiverseId\': 556051}, \'multiverseid\': 556051}, {\'name\': \'Angelo della Sofferenza\', \'text\': \'Volare\\nSe ti sta per essere inflitto danno, previeni quel danno e macina il doppio di quelle carte.\', \'type\': \'Creatura — Angelo Incubo\', \'flavor\': \'"Se desideri benedizioni, mortale, rivolgiti ai tuoi padroni demoniaci. Abbiamo concesso fin troppo alla tua specie."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556312&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f4b8cb9b-9707-474d-94ce-e34c1f54447a\', \'multiverseId\': 556312}, \'multiverseid\': 556312}, {\'name\': \'受難の天使\', \'text\': \'飛行\\nあなたがダメージを受けるなら、そのダメージを軽減し、その値の２倍に等しい枚数のカードを切削する。\', \'type\': \'クリーチャー — ナイトメア・天使\', \'flavor\': \'「定命の者よ、祝福や不死を望むなら、あなたが仕える悪魔に頼みなさい。あなたのような類にはもう十分与えました。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556573&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f4a9bb4c-8265-4352-8c88-c53b651c2c3e\', \'multiverseId\': 556573}, \'multiverseid\': 556573}, {\'name\': \'괴로움의 천사\', \'text\': \'비행\\n당신에게 피해가 입혀지려 한다면, 그 피해를 방지하고 그 두 배만큼 카드를 민다.\', \'type\': \'생물 — 나이트메어 천사\', \'flavor\': \'"필멸자여, 축복을 원한다면 네 악마 주인에게 가서 요청하거라. 우리는 너희 족속들에게 충분히 베풀었다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556834&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ea89f1ae-d3bb-4735-8be1-a9eea9285ca5\', \'multiverseId\': 556834}, \'multiverseid\': 556834}, {\'name\': \'Anjo do Sofrimento\', \'text\': \'Voar\\nSe uma quantidade de dano seria causada a você, previna aquele dano e triture duas vezes aquela quantidade de cards.\', \'type\': \'Criatura — Pesadelo Anjo\', \'flavor\': \'"Se você quer bênçãos, mortal, peça aos seus mestres demoníacos. Já demos o suficiente à sua espécie."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557095&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1384d17d-2812-43e9-99aa-a7f103e82754\', \'multiverseId\': 557095}, \'multiverseid\': 557095}, {\'name\': \'Ангел Страдания\', \'text\': \'Полет\\nЕсли вам должны быть нанесены повреждения, предотвратите те повреждения и скрутите вдвое больше карт.\', \'type\': \'Существо — Кошмар Ангел\', \'flavor\': \'«Если тебе нужно благословение, смертный, проси у своих хозяев-демонов. Мы достаточно дали вашему роду».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557356&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'616661d1-b008-4f3b-a9ec-b209cc427d0c\', \'multiverseId\': 557356}, \'multiverseid\': 557356}, {\'name\': \'施难天使\', \'text\': \'飞行\\n如果你将受到伤害，则防止该伤害并磨两倍于该数量的牌。\', \'type\': \'生物 ～梦魇／天使\', \'flavor\': \'「凡人，要祈福就去找你的恶魔老板吧。吾辈已向你们施舍得够多了。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557617&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9b9d34ef-715c-4a8c-b922-6b37e1ff1bfc\', \'multiverseId\': 557617}, \'multiverseid\': 557617}, {\'name\': \'施難天使\', \'text\': \'飛行\\n如果你將受到傷害，則防止該傷害並磨兩倍於該數量的牌。\', \'type\': \'生物 ～夢魘／天使\', \'flavor\': \'「凡人，要祈福就去找你的惡魔老闆吧。吾輩已向你們施捨得夠多了。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557878&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'083dc19b-5952-4641-b35a-a75b8d8bc0bc\', \'multiverseId\': 557878}, \'multiverseid\': 557878}]', "[{'name': 'Engel des Leids', 'text': 'Fliegend\\nFalls dir Schaden zugefügt würde, verhinderst du den Schaden und millst doppelt so viele Karten.', 'type': 'Kreatur — Nachtmahr, Engel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558289&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f857b0e3-ecbc-4ff8-840a-466e6353fbc3', 'multiverseId': 558289}, 'multiverseid': 558289}, {'name': 'Ange de la souffrance', 'text': 'Vol\\nSi des blessures devaient vous être infligées, prévenez ces blessures et meulez deux fois autant de cartes.', 'type': 'Créature : cauchemar et ange', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558324&type=card', 'language': 'French', 'identifiers': {'scryfallId': '4ef0ad26-a7a3-4229-88c9-26e02b74d494', 'multiverseId': 558324}, 'multiverseid': 558324}, {'name': '受難の天使', 'text': '飛行\\nあなたがダメージを受けるなら、そのダメージを軽減し、その値の２倍に等しい枚数のカードを切削する。', 'type': 'クリーチャー — ナイトメア・天使', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558359&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '12a814c1-9f0b-4d95-8dc7-9ff82df2d723', 'multiverseId': 558359}, 'multiverseid': 558359}, {'name': '施难天使', 'text': '飞行\\n如果你将受到伤害，则防止该伤害并磨两倍于该数量的牌。', 'type': '生物 ～梦魇／天使', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558394&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f9d323ee-f957-4e5c-bf10-548be56a041e', 'multiverseId': 558394}, 'multiverseid': 558394}]", "[{'name': 'Engelsgleiche Beobachterin', 'text': 'Dieser Zauberspruch kostet beim Wirken für jeden Bürger, den du kontrollierst, {1} weniger.\\nFliegend', 'type': 'Kreatur — Engel, Berater', 'flavor': 'Still und erhaben wie die Statuen ihrer Art, die die Dächer der Parkhöhen zierten, blickt sie voller Kummer auf die Stadt unter ihr.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555463&type=card', 'language': 'German', 'identifiers': {'scryfallId': '1c457fd5-539a-40a3-9004-c5e152a409a7', 'multiverseId': 555463}, 'multiverseid': 555463}, {'name': 'Observadora angélica', 'text': 'Te cuesta {1} menos lanzar este hechizo por cada Ciudadano que controlas.\\nVuela.', 'type': 'Criatura — Consejero ángel', 'flavor': 'Inmóvil y solemne como las estatuas de su estirpe que decoraban las azoteas del Parque Alto, observaba con preocupación la ciudad a sus pies.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555724&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '84921233-c24e-47da-98b9-3a153e59e88c', 'multiverseId': 555724}, 'multiverseid': 555724}, {'name': 'Observatrice angélique', 'text': 'Ce sort coûte {1} de moins à lancer pour chaque citoyen que vous contrôlez.\\nVol', 'type': 'Créature : ange et conseiller', 'flavor': 'Immobile et solennelle, comme les statues de ses semblables décorant les toits des Hauts-Parcs, elle posait un regard triste sur la ville en dessous.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555985&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a86c0221-3e16-4463-999c-15070d6d210f', 'multiverseId': 555985}, 'multiverseid': 555985}, {'name': 'Osservatrice Angelica', 'text': 'Questa magia costa {1} in meno per essere lanciata per ogni Cittadino che controlli.\\nVolare', 'type': 'Creatura — Consigliere Angelo', 'flavor': 'Immobile e solenne come le statue raffiguranti i suoi simili che decoravano i tetti di Vetta del Parco, volse lo sguardo con dolore verso la città sottostante.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556246&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '92ba019d-c3fd-4db5-a740-15e677f92009', 'multiverseId': 556246}, 'multiverseid': 556246}, {'name': '天使の観察者', 'text': 'この呪文を唱えるためのコストは、あなたがコントロールしている市民１体につき{1}少なくなる。\\n飛行', 'type': 'クリーチャー — 天使・アドバイザー', 'flavor': '高街の屋上を飾る自身の彫像のように物静かで厳かな彼女は、眼下の都市を悲しげに眺めた。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556507&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'b0cf0cb0-bb5f-49f5-b327-b6c5846defc8', 'multiverseId': 556507}, 'multiverseid': 556507}, {'name': '천사 관찰관', 'text': '이 주문은 당신이 조종하는 시민 한 개당 발동하는 데 {1}이 덜 든다.\\n비행', 'type': '생물 — 천사 참모', 'flavor': '파크 하이츠의 옥상들을 장식하고 있는 동상들처럼 고요하고 엄숙한 그녀는, 슬픔에 잠긴 채로 아래에 있는 도시를 내려다보았다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556768&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '54512f9d-86f7-41fb-bad4-2e4c0d2ada25', 'multiverseId': 556768}, 'multiverseid': 556768}, {'name': 'Observadora Angelical', 'text': 'Esta mágica custa {1} a menos para ser conjurada para cada Cidadão que você controla.\\nVoar', 'type': 'Criatura — Anjo Conselheiro', 'flavor': 'Plácida e solene como as estátuas de seu povo que decoravam os terraços de Parque Alto, ela contemplava triste a cidade abaixo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557029&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f97768fd-5d65-4e2a-a2cb-66d061f352f0', 'multiverseId': 557029}, 'multiverseid': 557029}, {'name': 'Ангел-Наблюдатель', 'text': 'Разыгрывание этого заклинания стоит на {1} меньше за каждого Гражданина под вашим контролем.\\nПолет', 'type': 'Существо — Ангел Советник', 'flavor': 'Неподвижная и величественная, как статуи ее сородичей, украшающие крыши Парковых Высот, она печально смотрела на раскинувшийся внизу город.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557290&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '3895fa8a-5e79-4d55-8e72-1c011d1c161e', 'multiverseId': 557290}, 'multiverseid': 557290}, {'name': '静观天使', 'text': '你每操控一个市民，此咒语便减少{1}来施放。\\n飞行', 'type': '生物 ～天使／参谋', 'flavor': '她犹如高地园屋顶静肃的饰像，悲悯地俯视着城市。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557551&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'd582a9c8-d292-485d-8b7a-d50de3973ccc', 'multiverseId': 557551}, 'multiverseid': 557551}, {'name': '靜觀天使', 'text': '你每操控一個市民，此咒語便減少{1}來施放。\\n飛行', 'type': '生物 ～天使／參謀', 'flavor': '她猶如高地園屋頂靜肅的飾像，悲憫地俯視著城市。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557812&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '9b717f96-e37c-4a96-bf49-405c3fd2e113', 'multiverseId': 557812}, 'multiverseid': 557812}]", '[{\'name\': \'Entbehrlicher Lakai\', \'text\': \'{1}{U}, schicke den Entbehrlichen Lakaien aus deinem Friedhof ins Exil: Erzeuge einen 1/1 blauen Fisch-Kreaturenspielstein mit „Diese Kreatur kann nicht geblockt werden." Aktiviere diese Fähigkeit wie eine Hexerei.\', \'type\': \'Kreatur — Mensch, Bürger\', \'flavor\': \'„Altonio? Nein, tut mir leid. Hier arbeitet niemand, der so heißt."\\n—Raffine\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555505&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6b4cf13a-41d0-4a69-b179-cc3f35faedb9\', \'multiverseId\': 555505}, \'multiverseid\': 555505}, {\'name\': \'Lacayo prescindible\', \'text\': \'{1}{U}, exiliar el Lacayo prescindible de tu cementerio: Crea una ficha de criatura Pez azul 1/1 con "Esta criatura no puede ser bloqueada". Activa esto solo como un conjuro.\', \'type\': \'Criatura — Ciudadano humano\', \'flavor\': \'"¿Altonio? No, lo siento. Aquí no trabaja ningún Altonio".\\n—Raffine\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555766&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0f59f3eb-1d3d-4b13-994b-58949eaadd01\', \'multiverseId\': 555766}, \'multiverseid\': 555766}, {\'name\': \'Laquais sacrifiable\', \'text\': "{1}{U}, exilez le Laquais sacrifiable depuis votre cimetière : Créez un jeton de créature 1/1 bleue Poisson avec « Cette créature ne peut pas être bloquée. » N\'activez que lorsque vous pourriez lancer un rituel.", \'type\': \'Créature : humain et citoyen\', \'flavor\': \'« Altonio ? Non, désolée. Personne de ce nom ne travaille ici. »\\n—Raffine\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556027&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2c5c4cb1-172b-4155-8bff-bbc43aa1e000\', \'multiverseId\': 556027}, \'multiverseid\': 556027}, {\'name\': \'Tirapiedi Sacrificabile\', \'text\': \'{1}{U}, Esilia il Tirapiedi Sacrificabile dal tuo cimitero: Crea una pedina creatura Pesce 1/1 blu con "Questa creatura non può essere bloccata". Attiva solo come una stregoneria.\', \'type\': \'Creatura — Cittadino Umano\', \'flavor\': \'"Altonio? No, mi spiace. Qui non lavora nessuno con quel nome."\\n—Raffine\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556288&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'29cf3005-2a70-4384-a396-f2c31e55162b\', \'multiverseId\': 556288}, \'multiverseid\': 556288}, {\'name\': \'捨て石の従僕\', \'text\': \'{1}{U}, あなたの墓地にある捨て石の従僕を追放する：「このクリーチャーはブロックされない。」を持つ青の１/１の魚・クリーチャー・トークン１体を生成する。起動はソーサリーとしてのみ行う。\', \'type\': \'クリーチャー — 人間・市民\', \'flavor\': \'「アルトニオ？ごめんなさい、そんな名前の人物はここで働いていません。」\\n――ラフィーン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556549&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cd36d2da-22c0-41a3-bcfc-def03382b23e\', \'multiverseId\': 556549}, \'multiverseid\': 556549}, {\'name\': \'쓰고 버리는 하인\', \'text\': \'{1}{U}, 당신의 무덤에서 쓰고 버리는 하인을 추방한다: "이 생물은 방어될 수 없다."를 가진 1/1 청색 어류 생물 토큰 한 개를 만든다. 집중마법 시기에만 활성화할 수 있다.\', \'type\': \'생물 — 인간 시민\', \'flavor\': \'"알토니오라고? 아니, 미안하군. 여기서 일하는 사람 중에 그런 이름은 없어."\\n—라핀\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556810&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6e4c3819-2303-4cb0-82ce-498612acb542\', \'multiverseId\': 556810}, \'multiverseid\': 556810}, {\'name\': \'Lacaio Descartável\', \'text\': \'{1}{U}, exile Lacaio Descartável de seu cemitério: Crie uma ficha de criatura Peixe azul 1/1 com "Esta criatura não pode ser bloqueada". Ative somente como um feitiço.\', \'type\': \'Criatura — Humano Cidadão\', \'flavor\': \'"Altonio? Não. Sinto muito. Não tem ninguém com esse nome trabalhando aqui."\\n— Raffine\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557071&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ddf0712d-2059-4f85-ba15-7a94e8e3dbb5\', \'multiverseId\': 557071}, \'multiverseid\': 557071}, {\'name\': \'Малоценный Прислужник\', \'text\': \'{1}{U}, изгоните Малоценного Прислужника из вашего кладбища: создайте одну фишку существа 1/1 синяя Рыба со способностью «Это существо не может быть заблокировано». Активируйте только как волшебство.\', \'type\': \'Существо — Человек Гражданин\', \'flavor\': \'«Альтонио? Нет, сожалею, но никто с таким именем здесь не работает».\\n— Раффина\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557332&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5efc2c08-85b7-45f7-b55e-fd87e6d3a20b\', \'multiverseId\': 557332}, \'multiverseid\': 557332}, {\'name\': \'炮灰跟班\', \'text\': \'{1}{U}，从你的坟墓场放逐炮灰跟班：派出一个1/1蓝色的鱼衍生生物，且具有「此生物不能被阻挡。」只能于法术时机起动。\', \'type\': \'生物 ～人类／市民\', \'flavor\': \'「阿托尼奥？抱歉，我们这里没有这号人物。」\\n～拉斐茵\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557593&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'eaeb5da3-34a7-4f79-9497-2837bdfa9408\', \'multiverseId\': 557593}, \'multiverseid\': 557593}, {\'name\': \'炮灰跟班\', \'text\': \'{1}{U}，從你的墳墓場放逐炮灰跟班：派出一個1/1藍色的魚衍生生物，且具有「此生物不能被阻擋。」只能於巫術時機起動。\', \'type\': \'生物 ～人類／市民\', \'flavor\': \'「阿托尼奧？抱歉，我們這裡沒有這號人物。」\\n～拉斐茵\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557854&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'973e36d0-1933-4d34-b320-a780f8af1a78\', \'multiverseId\': 557854}, \'multiverseid\': 557854}]', '[{\'name\': \'Entvölkern\', \'text\': \'Jeder Spieler, der eine mehrfarbige Kreatur kontrolliert, zieht eine Karte. Zerstöre dann alle Kreaturen.\', \'type\': \'Hexerei\', \'flavor\': \'Keine Schreie waren zu hören. Kein Blut befleckte die Straßen. Von einem Augenblick auf den nächsten wurde es in der geschäftigen Metropole einfach still.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555472&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'63f2e016-9384-481f-b8e5-ca4344a0fef8\', \'multiverseId\': 555472}, \'multiverseid\': 555472}, {\'name\': \'Despoblar\', \'text\': \'Cada jugador que controla una criatura multicolor roba una carta. Luego, destruye todas las criaturas.\', \'type\': \'Conjuro\', \'flavor\': \'No se escuchó ningún grito ni la sangre inundó las calles. Simplemente, en un instante, la bulliciosa metrópolis se sumió en un silencio absoluto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555733&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1b904874-a817-4cb6-91dd-6f6177b59980\', \'multiverseId\': 555733}, \'multiverseid\': 555733}, {\'name\': \'Dépopulation\', \'text\': \'Chaque joueur qui contrôle une créature multicolore pioche une carte. Puis détruisez toutes les créatures.\', \'type\': \'Rituel\', \'flavor\': "Il n\'y eut aucun cri. Pas une goutte de sang dans les rues. En un instant, la métropole animée fut simplement réduite au silence.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555994&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'628a4a44-1b74-43a4-a5e5-a0f8e70bd0ed\', \'multiverseId\': 555994}, \'multiverseid\': 555994}, {\'name\': \'Spopolare\', \'text\': \'Ogni giocatore che controlla una creatura multicolore pesca una carta. Poi distruggi tutte le creature.\', \'type\': \'Stregoneria\', \'flavor\': \'Non risuonarono urla. Nessuna macchia di sangue per strada. In un istante, la vivace metropoli cadde in silenzio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556255&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'764d0fd1-eda8-42eb-a18f-761c054d9e88\', \'multiverseId\': 556255}, \'multiverseid\': 556255}, {\'name\': \'集団失踪\', \'text\': \'多色のクリーチャーをコントロールしている各プレイヤーはそれぞれカード１枚を引く。その後、すべてのクリーチャーを破壊する。\', \'type\': \'ソーサリー\', \'flavor\': \'悲鳴は上がらなかった。通りを染め上げる血もなかった。騒々しい大都市は忽然と、ただ静まり返ったのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556516&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2f3bb605-cfbc-4cb0-8463-d51fc84bf12b\', \'multiverseId\': 556516}, \'multiverseid\': 556516}, {\'name\': \'인구 줄이기\', \'text\': \'다색 생물을 조종하는 각 플레이어는 카드 한 장을 뽑는다. 그 후 모든 생물을 파괴한다.\', \'type\': \'집중마법\', \'flavor\': \'아무런 비명 소리도 울리지 않았다. 피 한 방울도 거리에 떨어지지 않았다. 순식간에, 번화한 대도시가 정적에 휩싸였다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556777&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1fe3ad27-c182-4a26-a835-341809581a1e\', \'multiverseId\': 556777}, \'multiverseid\': 556777}, {\'name\': \'Despovoar\', \'text\': \'Cada jogador que controla uma criatura multicolorida compra um card. Em seguida, destrua todas as criaturas.\', \'type\': \'Feitiço\', \'flavor\': \'Ninguém gritou. Nenhuma gota de sangue manchou as ruas. Num instante, a metrópole fervilhante simplesmente se calou.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557038&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a2cfe323-f586-4610-a4e2-a59b9d88453e\', \'multiverseId\': 557038}, \'multiverseid\': 557038}, {\'name\': \'Депопуляция\', \'text\': \'Каждый игрок, контролирующий многоцветное существо, берет карту. Затем уничтожьте все существа.\', \'type\': \'Волшебство\', \'flavor\': \'Никто не кричал. Кровь не текла по улицам. В одно мгновение шумный мегаполис просто погрузился в тишину.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557299&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f3fa95b7-1470-4791-9456-8e338b592782\', \'multiverseId\': 557299}, \'multiverseid\': 557299}, {\'name\': \'扫除人口\', \'text\': \'每位操控多色生物的牌手各抓一张牌。然后消灭所有生物。\', \'type\': \'法术\', \'flavor\': \'街上没有呼喊，也没留血迹。熙熙攘攘的大都市倏地安静下来。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557560&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7c0a060c-1978-4a3c-9285-dd32a9862a3e\', \'multiverseId\': 557560}, \'multiverseid\': 557560}, {\'name\': \'掃除人口\', \'text\': \'每位操控多色生物的玩家各抽一張牌。然後消滅所有生物。\', \'type\': \'巫術\', \'flavor\': \'街上沒有呼喊，也沒留血跡。熙熙攘攘的大都市倏地安靜下來。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557821&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f45725ea-29f4-4ef8-b216-919fa79f5f2d\', \'multiverseId\': 557821}, \'multiverseid\': 557821}]', "[{'name': 'Entvölkern', 'text': 'Jeder Spieler, der eine mehrfarbige Kreatur kontrolliert, zieht eine Karte. Zerstöre dann alle Kreaturen.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558279&type=card', 'language': 'German', 'identifiers': {'scryfallId': '385ff960-33cd-463b-8f4f-13ee0a4764a6', 'multiverseId': 558279}, 'multiverseid': 558279}, {'name': 'Dépopulation', 'text': 'Chaque joueur qui contrôle une créature multicolore pioche une carte. Puis détruisez toutes les créatures.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558314&type=card', 'language': 'French', 'identifiers': {'scryfallId': '93e4eea8-949f-49ca-bbdb-5479010cecf6', 'multiverseId': 558314}, 'multiverseid': 558314}, {'name': '集団失踪', 'text': '多色のクリーチャーをコントロールしている各プレイヤーはそれぞれカード１枚を引く。その後、すべてのクリーチャーを破壊する。', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558349&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'af984471-b188-4569-86c3-f5e6ddecbada', 'multiverseId': 558349}, 'multiverseid': 558349}, {'name': '扫除人口', 'text': '每位操控多色生物的牌手各抓一张牌。然后消灭所有生物。', 'type': '法术', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558384&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '08fd1eb3-1f48-4b9e-87c5-0dc6473e5973', 'multiverseId': 558384}, 'multiverseid': 558384}]", '[{\'name\': \'Erpresser-Schwergewicht\', \'text\': \'Bedrohlich\\nImmer wenn das Erpresser-Schwergewicht angreift, kann der verteidigende Spieler dich eine Karte ziehen lassen. Falls er dies tut, enttappe das Erpresser-Schwergewicht und entferne es aus dem Kampf.\', \'type\': \'Kreatur — Oger, Krieger\', \'flavor\': \'„Schau, wir bekommen beide, was wir wollen. Ich bekomme dein Halo. Du darfst deine Kniescheiben behalten."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555557&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c6b4d1e1-eb67-4139-8068-1ea679bd518a\', \'multiverseId\': 555557}, \'multiverseid\': 555557}, {\'name\': \'Matón amenazante\', \'text\': \'Amenaza.\\nSiempre que el Matón amenazante ataque, el jugador defensor puede hacer que robes una carta. Si lo hace, endereza el Matón amenazante y remuévelo del combate.\', \'type\': \'Criatura — Guerrero ogro\', \'flavor\': \'"Oye, ambos conseguimos lo que queremos. Yo me quedo con tu halo y tú te quedas con tus piernas".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555818&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a9bcc074-0541-471a-b670-4d076e2e0c58\', \'multiverseId\': 555818}, \'multiverseid\': 555818}, {\'name\': \'Lourdaud extorqueur\', \'text\': "Menace\\nÀ chaque fois que le Lourdaud extorqueur attaque, le joueur défenseur peut vous faire piocher une carte. S\'il fait ainsi, dégagez le Lourdaud extorqueur et retirez-le du combat.", \'type\': \'Créature : ogre et guerrier\', \'flavor\': "« Écoute, on a tous les deux ce qu\'on voulait. J\'ai ton halo. Et toi tu gardes tes rotules. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556079&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'30ca151e-501a-448d-84c2-2273a75d573b\', \'multiverseId\': 556079}, \'multiverseid\': 556079}, {\'name\': \'Energumeno Estorsore\', \'text\': "Minacciare\\nOgniqualvolta l\'Energumeno Estorsore attacca, il giocatore in difesa può farti pescare una carta. Se lo fa, STAPpa l\'Energumeno Estorsore e rimuovilo dal combattimento.", \'type\': \'Creatura — Guerriero Ogre\', \'flavor\': \'"Vedila così, entrambi otteniamo ciò che vogliamo. Io mi prendo il tuo Nimbo. E tu ti tieni le tue rotule."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556340&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e4966fc5-e1bf-4515-9f88-5e35873dc540\', \'multiverseId\': 556340}, \'multiverseid\': 556340}, {\'name\': \'強請る大入道\', \'text\': \'威迫\\n強請る大入道が攻撃するたび、防御プレイヤーは「あなたはカード１枚を引く。」を選んでもよい。そうしたなら、強請る大入道をアンタップし、戦闘から取り除く。\', \'type\': \'クリーチャー — オーガ・戦士\', \'flavor\': \'「見ろよ、二人とも欲しいものが手に入ったじゃねえか。俺はお前の光素。お前は膝の皿を失くさずに済んだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556601&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5da3d278-c3a9-45d8-b9d8-2d512016d189\', \'multiverseId\': 556601}, \'multiverseid\': 556601}, {\'name\': \'금품갈취자 건달\', \'text\': \'호전적\\n금품갈취자 건달이 공격할 때마다, 수비플레이어는 당신에게 카드 한 장을 뽑게 할 수 있다. 그렇게 한다면, 금품갈취자 건달을 언탭하고 전투에서 제외한다.\', \'type\': \'생물 — 오우거 전사\', \'flavor\': \'"자 봐, 우리 둘 모두 서로 원하는 걸 얻는 거야. 난 네 헤일로를 얻고, 넌 네 무릎을 멀쩡하게 유지하고."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556862&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'06f58248-3653-45a3-9bde-791c5cb3b020\', \'multiverseId\': 556862}, \'multiverseid\': 556862}, {\'name\': \'Vilão Chantagista\', \'text\': \'Ameaçar\\nToda vez que Vilão Chantagista ataca, o jogador defensor pode fazer com que você compre um card. Se ele fizer isso, desvire Vilão Chantagista e remova-o do combate.\', \'type\': \'Criatura — Ogro Guerreiro\', \'flavor\': \'"Olha, nós dois conseguimos o que queremos. Eu fico com seu halo. Você fica com seu joelho."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557123&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3b22f7cf-1a00-4cd6-b1a9-2e14caf9d456\', \'multiverseId\': 557123}, \'multiverseid\': 557123}, {\'name\': \'Тяжеловес-Вымогатель\', \'text\': \'Угроза\\nКаждый раз, когда Тяжеловес-Вымогатель атакует, защищающийся игрок может заставить вас взять карту. Если он это делает, разверните Тяжеловеса-Вымогателя и удалите его из боя.\', \'type\': \'Существо — Огр Воин\', \'flavor\': \'«Слушай, мы оба получим то, что хотим. Я заберу твое гало. А у тебя останутся непереломанными ноги».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557384&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c4e7d2bc-37f1-4a80-8187-e789e11cff3e\', \'multiverseId\': 557384}, \'multiverseid\': 557384}, {\'name\': \'搜探壮汉\', \'text\': \'威慑\\n每当搜探壮汉攻击时，防御牌手可以令你抓一张牌。若他如此作，则重置搜探壮汉并将其移出战斗。\', \'type\': \'生物 ～食人魔／战士\', \'flavor\': \'「你瞧，这样我们两边都高兴。我拿到你的金圆。你留住自己的膝盖。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557645&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'145a3abe-4591-47f2-bda0-742884bd6f54\', \'multiverseId\': 557645}, \'multiverseid\': 557645}, {\'name\': \'搜探壯漢\', \'text\': \'威懾\\n每當搜探壯漢攻擊時，防禦玩家可以令你抽一張牌。若他如此作，則重置搜探壯漢並將其移出戰鬥。\', \'type\': \'生物 ～食人魔／戰士\', \'flavor\': \'「你瞧，這樣我們兩邊都高興。我拿到你的金圓。你留住自己的膝蓋。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557906&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9d484bec-45aa-43c5-b3e7-5b99059225ec\', \'multiverseId\': 557906}, \'multiverseid\': 557906}]', '[{\'name\': \'Erpresser-Schwergewicht\', \'text\': \'Bedrohlich\\nImmer wenn das Erpresser-Schwergewicht angreift, kann der verteidigende Spieler dich eine Karte ziehen lassen. Falls er dies tut, enttappe das Erpresser-Schwergewicht und entferne es aus dem Kampf.\', \'type\': \'Kreatur — Oger, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558294&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9f7bd83a-18be-4793-bf8f-b90a1091314d\', \'multiverseId\': 558294}, \'multiverseid\': 558294}, {\'name\': \'Lourdaud extorqueur\', \'text\': "Menace\\nÀ chaque fois que le Lourdaud extorqueur attaque, le joueur défenseur peut vous faire piocher une carte. S\'il fait ainsi, dégagez le Lourdaud extorqueur et retirez-le du combat.", \'type\': \'Créature : ogre et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558329&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'65e8d38e-4d80-4e8f-ab43-af9e703c0f4d\', \'multiverseId\': 558329}, \'multiverseid\': 558329}, {\'name\': \'強請る大入道\', \'text\': \'威迫\\n強請る大入道が攻撃するたび、防御プレイヤーは「あなたはカード１枚を引く。」を選んでもよい。そうしたなら、強請る大入道をアンタップし、戦闘から取り除く。\', \'type\': \'クリーチャー — オーガ・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558364&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d0d6a965-f48e-4c98-85b2-30d0e4e0a667\', \'multiverseId\': 558364}, \'multiverseid\': 558364}, {\'name\': \'搜探壮汉\', \'text\': \'威慑\\n每当搜探壮汉攻击时，防御牌手可以令你抓一张牌。若他如此作，则重置搜探壮汉并将其移出战斗。\', \'type\': \'生物 ～食人魔／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558399&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'eac5c392-4e05-4fcb-8b98-cce6c7d2bb44\', \'multiverseId\': 558399}, \'multiverseid\': 558399}]', '[{\'name\': \'Errant die Straßenkünstlerin\', \'text\': \'Aufblitzen\\nVerteidiger, Eile\\n{1}{U}, {T}: Kopiere einen Zauberspruch deiner Wahl, den du kontrollierst und der nicht gewirkt wurde. Du kannst neue Ziele für die Kopie bestimmen.\', \'type\': \'Legendäre Kreatur — Mensch, Räuber\', \'flavor\': \'Nur wenige kennen ihr Gesicht, aber alle kennen ihre Werke.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555503&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'32d14abe-89ea-488c-a0f9-02161b6dff81\', \'multiverseId\': 555503}, \'multiverseid\': 555503}, {\'name\': \'Nómada, artista callejera\', \'text\': \'Destello.\\nDefensor, prisa.\\n{1}{U}, {T}: Copia el hechizo objetivo que controlas y que no fue lanzado. Puedes elegir nuevos objetivos para la copia.\', \'type\': \'Criatura legendaria — Bribón humano\', \'flavor\': \'Pocos conocen su rostro, pero todos conocen su arte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555764&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cfd84cf2-2fa2-4eae-a63b-daf44c840339\', \'multiverseId\': 555764}, \'multiverseid\': 555764}, {\'name\': \'Délinquant, artiste de rue\', \'text\': "Flash\\nDéfenseur, célérité\\n{1}{U}, {T} : Copiez un sort ciblé que vous contrôlez qui n\'a pas été lancé. Vous pouvez choisir de nouvelles cibles pour cette copie.", \'type\': \'Créature légendaire : humain et gredin\', \'flavor\': \'Peu connaissent son visage, mais tous connaissent son travail.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556025&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9bf331f1-c4cc-430d-a815-cbc3814edc93\', \'multiverseId\': 556025}, \'multiverseid\': 556025}, {\'name\': \'Errante, Artista di Strada\', \'text\': \'Lampo\\nDifensore, rapidità\\n{1}{U}, {T}: Copia una magia bersaglio che controlli che non è stata lanciata. Puoi scegliere nuovi bersagli per la copia.\', \'type\': \'Creatura Leggendaria — Farabutto Umano\', \'flavor\': \'Pochi conoscono il suo volto, ma tutti conoscono le sue opere.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556286&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0bd20ec9-3a4b-41ba-afc6-ccc8abd1658a\', \'multiverseId\': 556286}, \'multiverseid\': 556286}, {\'name\': \'路上芸術家、エラント\', \'text\': \'瞬速\\n防衛、速攻\\n{1}{U}, {T}：あなたがコントロールしていて唱えられていない呪文１つを対象とする。それをコピーする。あなたはそのコピーの新しい対象を選んでもよい。\', \'type\': \'伝説のクリーチャー — 人間・ならず者\', \'flavor\': \'彼女の顔を知る者は滅多にいないが、彼女の作品は誰もが知っている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556547&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'19531aea-b75d-4278-9d18-0296a8034f29\', \'multiverseId\': 556547}, \'multiverseid\': 556547}, {\'name\': \'길거리 예술가, 에란트\', \'text\': \'섬광\\n수비태세, 신속\\n{1}{U}, {T}: 당신이 조종하며 발동되지 않은 주문을 목표로 정한다. 그 주문을 복사한다. 당신은 그 복사본의 목표를 새로 정할 수 있다.\', \'type\': \'전설적 생물 — 인간 도적\', \'flavor\': \'그녀의 얼굴을 아는 사람은 적지만, 그녀가 한 일은 모두가 안다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556808&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c4b94aef-bc62-465f-ba69-bfd9ea69821a\', \'multiverseId\': 556808}, \'multiverseid\': 556808}, {\'name\': \'Vagante, Artista de Rua\', \'text\': \'Lampejo\\nDefensor, ímpeto\\n{1}{U}, {T}: Copie a mágica alvo que você controla que não tenha sido conjurada. Você pode escolher novos alvos para a cópia.\', \'type\': \'Criatura Lendária — Humano Ladino\', \'flavor\': \'Poucos conhecem o rosto dela, mas todos conhecem seu trabalho.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557069&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7bf2c1e8-28a9-4f15-8f15-65335bfc10fa\', \'multiverseId\': 557069}, \'multiverseid\': 557069}, {\'name\': \'Бродяга, Уличная Художница\', \'text\': \'Миг\\nЗащитник, Ускорение\\n{1}{U}, {T}: скопируйте целевое заклинание под вашим контролем, которое не было разыграно. Вы можете выбрать новые цели для той копии.\', \'type\': \'Легендарное Существо — Человек Бродяга\', \'flavor\': \'Мало кто знает ее в лицо, но все знают ее работы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557330&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6561be15-c0ec-4f95-93a8-ba7fbb6d19e9\', \'multiverseId\': 557330}, \'multiverseid\': 557330}, {\'name\': \'涂鸦家流芳\', \'text\': \'闪现\\n守军，敏捷\\n{1}{U}，{T}：复制目标由你操控且未经施放的咒语。你可以为该复制品选择新的目标。\', \'type\': \'传奇生物 ～人类／浪客\', \'flavor\': \'她的样貌鲜为人知，但作品无人不识。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557591&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'36949e7c-872d-4bab-aa8e-e4239b661dda\', \'multiverseId\': 557591}, \'multiverseid\': 557591}, {\'name\': \'塗鴉家流芳\', \'text\': \'閃現\\n守軍，敏捷\\n{1}{U}，{T}：複製目標由你操控且未經施放的咒語。你可以為該複製品選擇新的目標。\', \'type\': \'傳奇生物 ～人類／浪客\', \'flavor\': \'她的樣貌鮮為人知，但作品無人不識。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557852&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d8f9b3a2-355c-4de8-ad87-83a04a548912\', \'multiverseId\': 557852}, \'multiverseid\': 557852}]', '[{\'name\': \'Errant die Straßenkünstlerin\', \'text\': \'Aufblitzen\\nVerteidiger, Eile\\n{1}{U}, {T}: Kopiere einen Zauberspruch deiner Wahl, den du kontrollierst und der nicht gewirkt wurde. Du kannst neue Ziele für die Kopie bestimmen.\', \'type\': \'Legendäre Kreatur — Mensch, Räuber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558552&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f698176f-e1a7-4977-bba4-eebbbc968f93\', \'multiverseId\': 558552}, \'multiverseid\': 558552}, {\'name\': \'Nómada, artista callejera\', \'text\': \'Destello.\\nDefensor, prisa.\\n{1}{U}, {T}: Copia el hechizo objetivo que controlas y que no fue lanzado. Puedes elegir nuevos objetivos para la copia.\', \'type\': \'Criatura legendaria — Bribón humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558561&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'14ffbbb9-c6bf-40d1-bba9-4dc1267888f4\', \'multiverseId\': 558561}, \'multiverseid\': 558561}, {\'name\': \'Délinquant, artiste de rue\', \'text\': "Flash\\nDéfenseur, célérité\\n{1}{U}, {T} : Copiez un sort ciblé que vous contrôlez qui n\'a pas été lancé. Vous pouvez choisir de nouvelles cibles pour cette copie.", \'type\': \'Créature légendaire : humain et gredin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558570&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9e1cb359-4ff4-4899-9ad5-4aa22093e7b8\', \'multiverseId\': 558570}, \'multiverseid\': 558570}, {\'name\': \'Errante, Artista di Strada\', \'text\': \'Lampo\\nDifensore, rapidità\\n{1}{U}, {T}: Copia una magia bersaglio che controlli che non è stata lanciata. Puoi scegliere nuovi bersagli per la copia.\', \'type\': \'Creatura Leggendaria — Farabutto Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558579&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b8d84c43-a68a-4355-8bc5-bdea955c4bb7\', \'multiverseId\': 558579}, \'multiverseid\': 558579}, {\'name\': \'路上芸術家、エラント\', \'text\': \'瞬速\\n防衛、速攻\\n{1}{U}, {T}：あなたがコントロールしていて唱えられていない呪文１つを対象とする。それをコピーする。あなたはそのコピーの新しい対象を選んでもよい。\', \'type\': \'伝説のクリーチャー — 人間・ならず者\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558588&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3bbd6edb-4cf2-4e44-90a0-a66591a3393a\', \'multiverseId\': 558588}, \'multiverseid\': 558588}, {\'name\': \'길거리 예술가, 에란트\', \'text\': \'섬광\\n수비태세, 신속\\n{1}{U}, {T}: 당신이 조종하며 발동되지 않은 주문을 목표로 정한다. 그 주문을 복사한다. 당신은 그 복사본의 목표를 새로 정할 수 있다.\', \'type\': \'전설적 생물 — 인간 도적\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558597&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9e446c2d-3cfe-4d3c-a841-ae9937c0a3fe\', \'multiverseId\': 558597}, \'multiverseid\': 558597}, {\'name\': \'Vagante, Artista de Rua\', \'text\': \'Lampejo\\nDefensor, ímpeto\\n{1}{U}, {T}: Copie a mágica alvo que você controla que não tenha sido conjurada. Você pode escolher novos alvos para a cópia.\', \'type\': \'Criatura Lendária — Humano Ladino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558606&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'75563d6a-65a4-4206-895f-dfd9d453e746\', \'multiverseId\': 558606}, \'multiverseid\': 558606}, {\'name\': \'Бродяга, Уличная Художница\', \'text\': \'Миг\\nЗащитник, Ускорение\\n{1}{U}, {T}: скопируйте целевое заклинание под вашим контролем, которое не было разыграно. Вы можете выбрать новые цели для той копии.\', \'type\': \'Легендарное Существо — Человек Бродяга\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558615&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'470736c2-1d95-495d-b1ed-fd2835ffe8a9\', \'multiverseId\': 558615}, \'multiverseid\': 558615}, {\'name\': \'涂鸦家流芳\', \'text\': \'闪现\\n守军，敏捷\\n{1}{U}，{T}：复制目标由你操控且未经施放的咒语。你可以为该复制品选择新的目标。\', \'type\': \'传奇生物 ～人类／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558624&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f00d5ab6-c46b-45ef-906a-804435004ba2\', \'multiverseId\': 558624}, \'multiverseid\': 558624}, {\'name\': \'塗鴉家流芳\', \'text\': \'閃現\\n守軍，敏捷\\n{1}{U}，{T}：複製目標由你操控且未經施放的咒語。你可以為該複製品選擇新的目標。\', \'type\': \'傳奇生物 ～人類／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558633&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'171cf0ad-9098-4724-b44c-45e2ce509e98\', \'multiverseId\': 558633}, \'multiverseid\': 558633}]', '[{\'name\': \'Es krachen lassen\', \'text\': \'Bestimme eines —\\n• Es krachen lassen fügt einer Kreatur oder einem Planeswalker deiner Wahl 5 Schadenspunkte zu.\\n• Zerstöre ein Artefakt deiner Wahl.\', \'type\': \'Hexerei\', \'flavor\': \'„Heute Abend ist es zu ruhig. Geht Ärger machen."\\n—Ziatora\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555581&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c75e1e69-6ece-4449-8b5e-cfb63dbc6d08\', \'multiverseId\': 555581}, \'multiverseid\': 555581}, {\'name\': \'Armar jaleo\', \'text\': \'Elige uno:\\n• Armar jaleo hace 5 puntos de daño a la criatura o planeswalker objetivo.\\n• Destruye el artefacto objetivo.\', \'type\': \'Conjuro\', \'flavor\': \'"Esta noche hay demasiado silencio. Hagan algo al respecto".\\n—Ziatora\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555842&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dd54620f-151f-4e08-88b6-257760e91a67\', \'multiverseId\': 555842}, \'multiverseid\': 555842}, {\'name\': \'Ça va chauffer !\', \'text\': "Choisissez l\'un —\\n• Ça va chauffer inflige 5 blessures à une cible, créature ou planeswalker.\\n• Détruisez un artefact ciblé.", \'type\': \'Rituel\', \'flavor\': "« C\'est trop tranquille ce soir. Allez me mettre un peu d\'ambiance. »\\n—Ziatora", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556103&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3b206313-5db2-4b91-8905-26e92d49d02a\', \'multiverseId\': 556103}, \'multiverseid\': 556103}, {\'name\': \'Pronti alla Rissa\', \'text\': \'Scegli uno —\\n• Pronti alla Rissa infligge 5 danni a una creatura o a un planeswalker bersaglio.\\n• Distruggi un artefatto bersaglio.\', \'type\': \'Stregoneria\', \'flavor\': \'"C\\\'è troppa tranquillità stasera. Andate a creare problemi."\\n—Ziatora\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556364&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6785191b-3587-481c-85b2-e89994a00fc4\', \'multiverseId\': 556364}, \'multiverseid\': 556364}, {\'name\': \'喧嘩上等\', \'text\': \'以下から１つを選ぶ。\\n• クリーチャーやプレインズウォーカーのうち１体を対象とする。 喧嘩上等はそれに５点のダメージを与える。\\n• アーティファクト１つを対象とする。それを破壊する。\', \'type\': \'ソーサリー\', \'flavor\': \'「やけに静かな夜だね。暴れて来な。」\\n――ジアトラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556625&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f7e530eb-2221-450d-ab4f-03893ab2ac5e\', \'multiverseId\': 556625}, \'multiverseid\': 556625}, {\'name\': \'패싸움 준비 완료\', \'text\': \'하나를 선택한다 —\\n• 생물 또는 플레인즈워커를 목표로 정한다. 패싸움 준비 완료는 그 목표에게 피해 5점을 입힌다.\\n• 마법물체를 목표로 정한다. 그 마법물체를 파괴한다.\', \'type\': \'집중마법\', \'flavor\': \'"오늘 밤은 너무 조용하군. 말썽을 좀 일으켜 봐."\\n—지아토라\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556886&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f5552902-6b30-48fa-8027-f1bfc49c0076\', \'multiverseId\': 556886}, \'multiverseid\': 556886}, {\'name\': \'Prontos para a Briga\', \'text\': \'Escolha um —\\n• Prontos para a Briga causa 5 pontos de dano à criatura ou ao planeswalker alvo.\\n• Destrua o artefato alvo.\', \'type\': \'Feitiço\', \'flavor\': \'"Essa noite está muito quieta. Vão arrumar confusão."\\n— Ziatora\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557147&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'29b41bf1-a81c-4b9a-b796-14ffdb9774c9\', \'multiverseId\': 557147}, \'multiverseid\': 557147}, {\'name\': \'Готовы к Драке\', \'text\': "Выберите одно —\\n• Готовы к Драке наносит 5 повреждений целевому существу или planeswalker\'у.\\n• Уничтожьте целевой артефакт.", \'type\': \'Волшебство\', \'flavor\': \'«Сегодня что-то слишком тихо. Идите, побузите».\\n— Зиатора\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557408&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9b8a621c-5272-4e0f-a9b1-a940d0166d58\', \'multiverseId\': 557408}, \'multiverseid\': 557408}, {\'name\': \'准备出击\', \'text\': \'选择一项～\\n•准备出击对目标生物或鹏洛客造成5点伤害。\\n•消灭目标神器。\', \'type\': \'法术\', \'flavor\': \'「今晚太安静了。去惹点麻烦。」\\n～齐朵拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557669&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f16ab1b6-f2f5-429f-a251-4dc88620a784\', \'multiverseId\': 557669}, \'multiverseid\': 557669}, {\'name\': \'準備出擊\', \'text\': \'選擇一項～\\n•準備出擊對目標生物或鵬洛客造成5點傷害。\\n•消滅目標神器。\', \'type\': \'巫術\', \'flavor\': \'「今晚太安靜了。去惹點麻煩。」\\n～齊朵拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557930&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'48390153-2ae4-439b-9e89-24eadc817a53\', \'multiverseId\': 557930}, \'multiverseid\': 557930}]', '[{\'name\': \'Evelyn die Habgierige\', \'text\': \'Aufblitzen\\nImmer wenn Evelyn die Habgierige oder ein anderer Vampir unter deiner Kontrolle ins Spiel kommt, schicke die oberste Karte der Bibliothek jedes Spielers mit einer Sammlungsmarke ins Exil.\\nEinmal pro Zug kannst du eine Karte mit einer Sammlungsmarke aus dem Exil spielen, falls sie von einer Fähigkeit, die du kontrolliert hast, ins Exil geschickt wurde, und um sie zu wirken, kannst du Mana ausgeben, als wäre es Mana einer beliebigen Farbe.\', \'type\': \'Legendäre Kreatur — Vampir, Räuber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555646&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'640969cc-a623-4cfa-93d3-eb933a8a9f8a\', \'multiverseId\': 555646}, \'multiverseid\': 555646}, {\'name\': \'Evelyn, la Codiciosa\', \'text\': \'Destello.\\nSiempre que Evelyn, la Codiciosa u otro Vampiro entre al campo de batalla bajo tu control, exilia la primera carta de la biblioteca de cada jugador con un contador de colección sobre ella.\\nUna vez por turno, puedes jugar desde el exilio una carta con un contador de colección sobre ella si fue exiliada por una habilidad que controlabas y puedes usar maná como si fuera maná de cualquier color para lanzarla.\', \'type\': \'Criatura legendaria — Bribón vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555907&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2d609ceb-de9c-40d4-ad64-1fa4e4948733\', \'multiverseId\': 555907}, \'multiverseid\': 555907}, {\'name\': \'Evelyn, la cupide\', \'text\': "Flash\\nÀ chaque fois qu\'Evelyn, la cupide ou un autre vampire arrive sur le champ de bataille sous votre contrôle, exilez la carte du dessus de la bibliothèque de chaque joueur avec un marqueur « collection » sur elle.\\nUne fois par tour, vous pouvez jouer une carte depuis l\'exil avec un marqueur « collection » sur elle si elle a été exilée par une capacité que vous contrôliez, et vous pouvez dépenser du mana comme si c\'était du mana de n\'importe quelle couleur pour la lancer.", \'type\': \'Créature légendaire : vampire et gredin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556168&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d3833435-651c-47f3-bc5f-5c3077df3bf5\', \'multiverseId\': 556168}, \'multiverseid\': 556168}, {\'name\': "Evelyn, l\'Avida", \'text\': "Lampo\\nOgniqualvolta Evelyn, l\'Avida o un altro Vampiro entra nel campo di battaglia sotto il tuo controllo, esilia la prima carta del grimorio di ogni giocatore con un segnalino collezione su di essa.\\nUna volta per turno, puoi giocare una carta con un segnalino collezione dall\'esilio se è stata esiliata da un\'abilità che controllavi e puoi spendere mana come se fosse mana di qualsiasi colore per lanciarla.", \'type\': \'Creatura Leggendaria — Farabutto Vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556429&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bc6c3b00-4443-46e7-a6d1-7040f81abd55\', \'multiverseId\': 556429}, \'multiverseid\': 556429}, {\'name\': \'欲深き者、エヴリン\', \'text\': \'瞬速\\n欲深き者、エヴリンやこれでない吸血鬼１体があなたのコントロール下で戦場に出るたび、各プレイヤーのライブラリーの一番上にあるカード１枚を蒐集カウンター１個が置かれた状態で追放する。\\n毎ターン１回、あなたは、あなたがコントロールしていた能力によって追放されていて追放領域にあり蒐集カウンターが置かれているカード１枚をプレイしてもよく、あなたはそれを唱えるためにマナを望む色のマナであるかのように支払ってもよい。\', \'type\': \'伝説のクリーチャー — 吸血鬼・ならず者\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556690&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1152b520-811f-4f92-8e4a-b61385ae8e8f\', \'multiverseId\': 556690}, \'multiverseid\': 556690}, {\'name\': \'갈망하는 자, 에블린\', \'text\': \'섬광\\n갈망하는 자, 에블린 또는 다른 흡혈귀가 당신의 조종하에 전장에 들어올 때마다, 각 플레이어의 서고 맨 위 카드에 수집품 카운터 한 개를 올려놓고 추방한다.\\n한 턴에 한 번, 당신은 당신이 조종하는 능력으로 추방되었으며 수집품 카운터가 놓여 있는 카드 한 장을 플레이할 수 있고, 그 카드를 발동하기 위한 마나는 원하는 색의 마나인 것처럼 지불할 수 있다.\', \'type\': \'전설적 생물 — 흡혈귀 도적\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556951&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8899620f-6525-4972-a91d-6e2812924d79\', \'multiverseId\': 556951}, \'multiverseid\': 556951}, {\'name\': \'Evelyn, a Cobiçosa\', \'text\': \'Lampejo\\nToda vez que Evelyn, a Cobiçosa, ou qualquer outro Vampiro entrar no campo de batalha sob seu controle, exile o card do topo do grimório de cada jogador com um marcador de coleção.\\nUma vez a cada turno, você pode jogar um card com um marcador de coleção do exílio se ele tiver sido exilado por uma habilidade controlada por você, e pode gastar mana como se fosse de qualquer cor para conjurá-lo.\', \'type\': \'Criatura Lendária — Vampiro Ladino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557212&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d8a39d46-dcae-43fc-8ddb-0cc5b8186ac2\', \'multiverseId\': 557212}, \'multiverseid\': 557212}, {\'name\': \'Эвелин, Алчная\', \'text\': \'Миг\\nКаждый раз, когда Эвелин, Алчная или другой Вампир выходит на поле битвы под вашим контролем, изгоните верхнюю карту библиотеки каждого из игроков с жетоном коллекции на ней.\\nОдин раз в каждом ходу вы можете разыграть из изгнания карту с жетоном коллекции на ней, если она была изгнана способностью под вашим контролем, и вы можете тратить ману на ее разыгрывание, как будто это мана любого цвета.\', \'type\': \'Легендарное Существо — Вампир Бродяга\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557473&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'051febb4-de1e-4a39-9703-21e77a162209\', \'multiverseId\': 557473}, \'multiverseid\': 557473}, {\'name\': \'贪婪的艾弗琳\', \'text\': \'闪现\\n每当贪婪的艾弗琳或另一个吸血鬼在你的操控下进战场时，放逐每位牌手的牌库顶牌，且其上有一个收藏指示物。\\n限每回合一次，如果放逐区中某张其上有收藏指示物的牌是以由你操控的异能放逐，则你可以从放逐区中使用之，且你可以将法术力视同任意颜色的法术力来支付施放它的费用。\', \'type\': \'传奇生物 ～吸血鬼／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557734&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5327ae3f-05b8-45b0-a1c7-687f076ce69a\', \'multiverseId\': 557734}, \'multiverseid\': 557734}, {\'name\': \'貪婪的艾弗琳\', \'text\': \'閃現\\n每當貪婪的艾弗琳或另一個吸血鬼在你的操控下進戰場時，放逐每位玩家的牌庫頂牌，且其上有一個收藏指示物。\\n限每回合一次，如果放逐區中某張其上有收藏指示物的牌是以由你操控的異能放逐，則你可以從放逐區中使用之，且你可以將魔法力視同任意顏色的魔法力來支付施放它的費用。\', \'type\': \'傳奇生物 ～吸血鬼／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557995&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f2cc3abc-e70e-4513-8893-73d04eca9548\', \'multiverseId\': 557995}, \'multiverseid\': 557995}]', '[{\'name\': \'Evelyn die Habgierige\', \'text\': \'Aufblitzen\\nImmer wenn Evelyn die Habgierige oder ein anderer Vampir unter deiner Kontrolle ins Spiel kommt, schicke die oberste Karte der Bibliothek jedes Spielers mit einer Sammlungsmarke ins Exil.\\nEinmal pro Zug kannst du eine Karte mit einer Sammlungsmarke aus dem Exil spielen, falls sie von einer Fähigkeit, die du kontrolliert hast, ins Exil geschickt wurde, und um sie zu wirken, kannst du Mana ausgeben, als wäre es Mana einer beliebigen Farbe.\', \'type\': \'Legendäre Kreatur — Vampir, Räuber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558749&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b36e5a7f-9150-49f6-808f-ac27bd0eedd3\', \'multiverseId\': 558749}, \'multiverseid\': 558749}, {\'name\': \'Evelyn, la Codiciosa\', \'text\': \'Destello.\\nSiempre que Evelyn, la Codiciosa u otro Vampiro entre al campo de batalla bajo tu control, exilia la primera carta de la biblioteca de cada jugador con un contador de colección sobre ella.\\nUna vez por turno, puedes jugar desde el exilio una carta con un contador de colección sobre ella si fue exiliada por una habilidad que controlabas y puedes usar maná como si fuera maná de cualquier color para lanzarla.\', \'type\': \'Criatura legendaria — Bribón vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558794&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'59831b8c-e2df-4346-a7bd-09247a16f288\', \'multiverseId\': 558794}, \'multiverseid\': 558794}, {\'name\': \'Evelyn, la cupide\', \'text\': "Flash\\nÀ chaque fois qu\'Evelyn, la cupide ou un autre vampire arrive sur le champ de bataille sous votre contrôle, exilez la carte du dessus de la bibliothèque de chaque joueur avec un marqueur « collection » sur elle.\\nUne fois par tour, vous pouvez jouer une carte depuis l\'exil avec un marqueur « collection » sur elle si elle a été exilée par une capacité que vous contrôliez, et vous pouvez dépenser du mana comme si c\'était du mana de n\'importe quelle couleur pour la lancer.", \'type\': \'Créature légendaire : vampire et gredin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558839&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d9cc3e04-f01b-4bbb-9143-1e478c79bcf5\', \'multiverseId\': 558839}, \'multiverseid\': 558839}, {\'name\': "Evelyn, l\'Avida", \'text\': "Lampo\\nOgniqualvolta Evelyn, l\'Avida o un altro Vampiro entra nel campo di battaglia sotto il tuo controllo, esilia la prima carta del grimorio di ogni giocatore con un segnalino collezione su di essa.\\nUna volta per turno, puoi giocare una carta con un segnalino collezione dall\'esilio se è stata esiliata da un\'abilità che controllavi e puoi spendere mana come se fosse mana di qualsiasi colore per lanciarla.", \'type\': \'Creatura Leggendaria — Farabutto Vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558884&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6d6175e8-916d-492b-8921-cfcbe04b9c19\', \'multiverseId\': 558884}, \'multiverseid\': 558884}, {\'name\': \'欲深き者、エヴリン\', \'text\': \'瞬速\\n欲深き者、エヴリンやこれでない吸血鬼１体があなたのコントロール下で戦場に出るたび、各プレイヤーのライブラリーの一番上にあるカード１枚を蒐集カウンター１個が置かれた状態で追放する。\\n毎ターン１回、あなたは、あなたがコントロールしていた能力によって追放されていて追放領域にあり蒐集カウンターが置かれているカード１枚をプレイしてもよく、あなたはそれを唱えるためにマナを望む色のマナであるかのように支払ってもよい。\', \'type\': \'伝説のクリーチャー — 吸血鬼・ならず者\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558929&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5306be21-942c-41b4-8991-5a463c98879b\', \'multiverseId\': 558929}, \'multiverseid\': 558929}, {\'name\': \'갈망하는 자, 에블린\', \'text\': \'섬광\\n갈망하는 자, 에블린 또는 다른 흡혈귀가 당신의 조종하에 전장에 들어올 때마다, 각 플레이어의 서고 맨 위 카드에 수집품 카운터 한 개를 올려놓고 추방한다.\\n한 턴에 한 번, 당신은 당신이 조종하는 능력으로 추방되었으며 수집품 카운터가 놓여 있는 카드 한 장을 플레이할 수 있고, 그 카드를 발동하기 위한 마나는 원하는 색의 마나인 것처럼 지불할 수 있다.\', \'type\': \'전설적 생물 — 흡혈귀 도적\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558974&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e4aa8800-43f0-42ca-9704-0d2bf26c932b\', \'multiverseId\': 558974}, \'multiverseid\': 558974}, {\'name\': \'Evelyn, a Cobiçosa\', \'text\': \'Lampejo\\nToda vez que Evelyn, a Cobiçosa, ou qualquer outro Vampiro entrar no campo de batalha sob seu controle, exile o card do topo do grimório de cada jogador com um marcador de coleção.\\nUma vez a cada turno, você pode jogar um card com um marcador de coleção do exílio se ele tiver sido exilado por uma habilidade controlada por você, e pode gastar mana como se fosse de qualquer cor para conjurá-lo.\', \'type\': \'Criatura Lendária — Vampiro Ladino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559019&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9ff6c015-2c10-42b5-8982-3d1fc561fc87\', \'multiverseId\': 559019}, \'multiverseid\': 559019}, {\'name\': \'Эвелин, Алчная\', \'text\': \'Миг\\nКаждый раз, когда Эвелин, Алчная или другой Вампир выходит на поле битвы под вашим контролем, изгоните верхнюю карту библиотеки каждого из игроков с жетоном коллекции на ней.\\nОдин раз в каждом ходу вы можете разыграть из изгнания карту с жетоном коллекции на ней, если она была изгнана способностью под вашим контролем, и вы можете тратить ману на ее разыгрывание, как будто это мана любого цвета.\', \'type\': \'Легендарное Существо — Вампир Бродяга\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559064&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'293107e4-c76f-4b9b-b934-46a422756b46\', \'multiverseId\': 559064}, \'multiverseid\': 559064}, {\'name\': \'贪婪的艾弗琳\', \'text\': \'闪现\\n每当贪婪的艾弗琳或另一个吸血鬼在你的操控下进战场时，放逐每位牌手的牌库顶牌，且其上有一个收藏指示物。\\n限每回合一次，如果放逐区中某张其上有收藏指示物的牌是以由你操控的异能放逐，则你便可以从放逐区中使用之，且你可以将法术力视同任意颜色的法术力来支付施放它的费用。\', \'type\': \'传奇生物 ～吸血鬼／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559109&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b0295517-cd99-474a-bd0a-67bbf58244b0\', \'multiverseId\': 559109}, \'multiverseid\': 559109}, {\'name\': \'貪婪的艾弗琳\', \'text\': \'閃現\\n每當貪婪的艾弗琳或另一個吸血鬼在你的操控下進戰場時，放逐每位玩家的牌庫頂牌，且其上有一個收藏指示物。\\n限每回合一次，如果放逐區中某張其上有收藏指示物的牌是以由你操控的異能放逐，則你便可以從放逐區中使用之，且你可以將魔法力視同任意顏色的魔法力來支付施放它的費用。\', \'type\': \'傳奇生物 ～吸血鬼／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559154&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2f044092-8b63-4724-93d9-8f72948ed21e\', \'multiverseId\': 559154}, \'multiverseid\': 559154}]', "[{'name': 'Exfiltrationsspezialistin', 'text': 'Lebensverknüpfung\\nWenn die Exfiltrationsspezialistin ins Spiel kommt, bringe eine Kreaturenkarte deiner Wahl mit Manabetrag 2 oder weniger aus deinem Friedhof ins Spiel zurück. Die Kreatur kann nicht angreifen oder blocken, solange du die Exfiltrationsspezialistin kontrollierst.', 'type': 'Kreatur — Mensch, Räuber', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555474&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'ded9a94c-8a37-4d1e-b784-e9795a9f7a8a', 'multiverseId': 555474}, 'multiverseid': 555474}, {'name': 'Experta en rescates', 'text': 'Vínculo vital.\\nCuando la Experta en rescates entre al campo de batalla, regresa la carta de criatura objetivo con valor de maná de 2 o menos de tu cementerio al campo de batalla. Esa criatura no puede atacar ni bloquear mientras controles la Experta en rescates.', 'type': 'Criatura — Bribón humano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555735&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '8a197e37-25ce-46f4-b3c7-6b0de0390cc0', 'multiverseId': 555735}, 'multiverseid': 555735}, {'name': 'Spécialiste en extraction', 'text': 'Lien de vie\\nQuand la Spécialiste en extraction arrive sur le champ de bataille, renvoyez sur le champ de bataille une carte de créature ciblée avec une valeur de mana inférieure ou égale à 2 depuis votre cimetière. Cette créature ne peut ni attaquer ni bloquer tant que vous contrôlez la Spécialiste en extraction.', 'type': 'Créature : humain et gredin', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555996&type=card', 'language': 'French', 'identifiers': {'scryfallId': '5de3883b-0699-469e-86d3-e2f652743c92', 'multiverseId': 555996}, 'multiverseid': 555996}, {'name': 'Specialista di Estrazioni', 'text': 'Legame vitale\\nQuando la Specialista di Estrazioni entra nel campo di battaglia, rimetti sul campo di battaglia una carta creatura bersaglio con valore di mana pari o inferiore a 2 dal tuo cimitero. Quella creatura non può attaccare o bloccare fintanto che controlli la Specialista di Estrazioni.', 'type': 'Creatura — Farabutto Umano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556257&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '64c9c5cd-66f5-45f0-a8f3-0c7750faf625', 'multiverseId': 556257}, 'multiverseid': 556257}, {'name': '救出専門家', 'text': '絆魂\\n救出専門家が戦場に出たとき、あなたの墓地にありマナ総量が２以下であるクリーチャー・カード１枚を対象とする。それを戦場に戻す。あなたが救出専門家をコントロールし続けているかぎり、そのクリーチャーでは攻撃もブロックもできない。', 'type': 'クリーチャー — 人間・ならず者', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556518&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '4ebd0539-13d5-444a-80a9-15802c0453fa', 'multiverseId': 556518}, 'multiverseid': 556518}, {'name': '구출 전문가', 'text': '생명연결\\n구출 전문가가 전장에 들어올 때, 당신의 무덤에 있는 마나 값이 2 이하인 생물 카드를 목표로 정한다. 그 카드를 전장으로 되돌린다. 그 생물은 당신이 구출 전문가를 조종하는 한 공격 또는 방어할 수 없다.', 'type': '생물 — 인간 도적', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556779&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '195633f6-a4b0-4935-b52a-bbdecc4399b6', 'multiverseId': 556779}, 'multiverseid': 556779}, {'name': 'Especialista em Resgates', 'text': 'Vínculo com a vida\\nQuando Especialista em Resgates entrar no campo de batalha, devolva de seu cemitério para o campo de batalha o card de criatura alvo com valor de mana igual ou inferior a 2. Aquela criatura não poderá atacar nem bloquear enquanto você controlar Especialista em Resgates.', 'type': 'Criatura — Humano Ladino', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557040&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ca6e0621-ed34-4c0d-a01d-c0c6a3c82e93', 'multiverseId': 557040}, 'multiverseid': 557040}, {'name': 'Специалистка по Эвакуации', 'text': 'Цепь жизни\\nКогда Специалистка по Эвакуации выходит на поле битвы, верните целевую карту существа с мановой ценностью не более 2 из вашего кладбища на поле битвы. То существо не может атаковать или блокировать, пока вы контролируете Специалистку по Эвакуации.', 'type': 'Существо — Человек Бродяга', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557301&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '3bc93eaa-de1c-424e-92fb-1eb0586b23fd', 'multiverseId': 557301}, 'multiverseid': 557301}, {'name': '援救能手', 'text': '系命\\n当援救能手进战场时，将目标法术力值等于或小于2的生物牌从你的坟墓场移回战场。于你操控援救能手的时段内，该生物不能进行攻击或阻挡。', 'type': '生物 ～人类／浪客', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557562&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'd37c5b62-d7db-433a-9218-17d8ec59c95f', 'multiverseId': 557562}, 'multiverseid': 557562}, {'name': '援救能手', 'text': '繫命\\n當援救能手進戰場時，將目標魔法力值等於或小於2的生物牌從你的墳墓場移回戰場。於你操控援救能手的時段內，該生物不能進行攻擊或阻擋。', 'type': '生物 ～人類／浪客', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557823&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '2adcabda-5b1a-4476-b283-f459a0bcef1d', 'multiverseId': 557823}, 'multiverseid': 557823}]", "[{'name': 'Exfiltrationsspezialistin', 'text': 'Lebensverknüpfung\\nWenn die Exfiltrationsspezialistin ins Spiel kommt, bringe eine Kreaturenkarte deiner Wahl mit Manabetrag 2 oder weniger aus deinem Friedhof ins Spiel zurück. Die Kreatur kann nicht angreifen oder blocken, solange du die Exfiltrationsspezialistin kontrollierst.', 'type': 'Kreatur — Mensch, Räuber', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558280&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a225c2e4-96e9-4242-9d77-261699adf425', 'multiverseId': 558280}, 'multiverseid': 558280}, {'name': 'Spécialiste en extraction', 'text': 'Lien de vie\\nQuand la Spécialiste en extraction arrive sur le champ de bataille, renvoyez sur le champ de bataille une carte de créature ciblée avec une valeur de mana inférieure ou égale à 2 depuis votre cimetière. Cette créature ne peut ni attaquer ni bloquer tant que vous contrôlez la Spécialiste en extraction.', 'type': 'Créature : humain et gredin', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558315&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c59e7f40-6688-4d64-a21e-de2619358fd6', 'multiverseId': 558315}, 'multiverseid': 558315}, {'name': '救出専門家', 'text': '絆魂\\n救出専門家が戦場に出たとき、あなたの墓地にありマナ総量が２以下であるクリーチャー・カード１枚を対象とする。それを戦場に戻す。あなたが救出専門家をコントロールし続けているかぎり、そのクリーチャーでは攻撃もブロックもできない。', 'type': 'クリーチャー — 人間・ならず者', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558350&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'b70afd0b-f00b-495f-823a-a56756afc140', 'multiverseId': 558350}, 'multiverseid': 558350}, {'name': '援救能手', 'text': '系命\\n当援救能手进战场时，将目标法术力值等于或小于2的生物牌从你的坟墓场移回战场。于你操控援救能手的时段内，该生物不能进行攻击或阻挡。', 'type': '生物 ～人类／浪客', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558385&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '1f9d9af8-21e3-4273-9069-1017907fe49c', 'multiverseId': 558385}, 'multiverseid': 558385}]", '[{\'name\': \'Exotische Haustiere\', \'text\': \'Erzeuge zwei 1/1 blaue Fisch-Kreaturenspielsteine mit „Diese Kreatur kann nicht geblockt werden." Lege dann für jede Sorte von Marke unter den Kreaturen, die du kontrollierst, eine solche Marke auf einen jener Spielsteine.\', \'type\': \'Spontanzauber\', \'flavor\': \'Ermittler beobachteten, dass Altonios geliebte Fische nach seinem Verschwinden aufblühten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555647&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'28c2ae72-2fa3-48ab-bd4a-8120ef6e7d54\', \'multiverseId\': 555647}, \'multiverseid\': 555647}, {\'name\': \'Mascotas exóticas\', \'text\': \'Crea dos fichas de criatura Pez azules 1/1 con "Esta criatura no puede ser bloqueada". Luego, por cada tipo de contador entre las criaturas que controlas, pon un contador de ese tipo sobre cualquiera de esas fichas.\', \'type\': \'Instantáneo\', \'flavor\': \'Tras la desaparición de Altonio, los investigadores observaron que sus queridos peces estaban la mar de bien.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555908&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'55cef30c-c925-48db-8ef7-59784f6d25c7\', \'multiverseId\': 555908}, \'multiverseid\': 555908}, {\'name\': \'Animaux de compagnie exotiques\', \'text\': "Créez deux jetons de créature 1/1 bleue Poisson avec « Cette créature ne peut pas être bloquée. » Puis, pour chaque sorte de marqueur parmi les créatures que vous contrôlez, mettez un marqueur de cette sorte sur l\'un de ces jetons.", \'type\': \'Éphémère\', \'flavor\': "Les enquêteurs remarquèrent que les poissons adorés d\'Altonio se portaient très bien depuis sa disparition.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556169&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f8d697eb-fe87-40f0-9659-2921c9a5a505\', \'multiverseId\': 556169}, \'multiverseid\': 556169}, {\'name\': \'Animaletti Esotici\', \'text\': \'Crea due pedine creatura Pesce 1/1 blu con "Questa creatura non può essere bloccata". Poi, per ogni tipo di segnalino tra le creature che controlli, metti un segnalino di quel tipo su una di quelle pedine.\', \'type\': \'Istantaneo\', \'flavor\': \'Gli investigatori notarono che gli amati pesci di Altonio erano in ottima salute dopo la sua scomparsa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556430&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'00540061-e344-4668-96cc-9a215cbbd03b\', \'multiverseId\': 556430}, \'multiverseid\': 556430}, {\'name\': \'風変わりなペット\', \'text\': \'「このクリーチャーはブロックされない。」を持つ青の１/１の魚・クリーチャー・トークン２体を生成する。その後、あなたがコントロールしているすべてのクリーチャーの中のカウンター１種類につき、その種類のカウンター１個を、それらのいずれかのトークンの上にを置く。\', \'type\': \'インスタント\', \'flavor\': \'アルトニオ失踪後、彼の愛しの魚がすくすく成長していることを調査員は認めた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556691&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a545cdc2-9d59-469c-affe-43e49bf3e74e\', \'multiverseId\': 556691}, \'multiverseid\': 556691}, {\'name\': \'이국적인 애완동물\', \'text\': \'"이 생물은 방어될 수 없다."를 가진 1/1 청색 어류 생물 토큰 두 개를 만든다. 그 후 당신이 조종하는 생물들이 가지고 있는 각 종류의 카운터마다, 그 종류의 카운터 한 개를 두 토큰 중 한 개에 올려놓는다.\', \'type\': \'순간마법\', \'flavor\': \'수사관들은 알토니오가 사라진 뒤에 그가 애지중지하던 물고기들이 번성하고 있는 것을 관찰했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556952&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'64a0555f-bbfa-4021-a5ca-0c769bba0535\', \'multiverseId\': 556952}, \'multiverseid\': 556952}, {\'name\': \'Animais de Estimação Exóticos\', \'text\': \'Crie duas fichas de criatura Peixe azul 1/1 com "Esta criatura não pode ser bloqueada". Depois, para cada tipo de marcador nas criaturas que você controla, coloque um marcador daquele tipo em qualquer daquelas fichas.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os investigadores observaram que os queridos peixes de Altonio estavam indo muito bem depois do desaparecimento dele.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557213&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'24f4e809-c8d5-4a32-867d-55b83e2c1601\', \'multiverseId\': 557213}, \'multiverseid\': 557213}, {\'name\': \'Экзотические Питомцы\', \'text\': \'Создайте две фишки существа 1/1 синяя Рыба со способностью «Это существо не может быть заблокировано». Затем, за каждый тип жетона на существах под вашим контролем, положите один жетон того типа на любую из тех фишек.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Следователи заметили, что любимые рыбы Альтонио после его исчезновения словно расцвели.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557474&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c162a2de-53e3-4b35-87af-eb46f3f08cd2\', \'multiverseId\': 557474}, \'multiverseid\': 557474}, {\'name\': \'奇异宠物\', \'text\': \'派出两个1/1蓝色的鱼衍生生物，且具有「此生物不能被阻挡。」然后为由你操控的生物上每种指示物各进行以下流程～在前述衍生物之一上放置一个同类的指示物。\', \'type\': \'瞬间\', \'flavor\': \'调查员观察到，自从阿托尼奥失踪后，他珍爱的鱼变得格外活跃。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557735&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'717f2aed-6e43-440c-91a8-3b823bb07ebf\', \'multiverseId\': 557735}, \'multiverseid\': 557735}, {\'name\': \'奇異寵物\', \'text\': \'派出兩個1/1藍色的魚衍生生物，且具有「此生物不能被阻擋。」然後為由你操控的生物上每種指示物各進行以下流程～在前述衍生物之一上放置一個同類的指示物。\', \'type\': \'瞬間\', \'flavor\': \'調查員觀察到，自從阿托尼奧失蹤後，他珍愛的魚變得格外活躍。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557996&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b4bfd0f3-f45e-4b5f-9473-07e4196de17d\', \'multiverseId\': 557996}, \'multiverseid\': 557996}]', '[{\'name\': \'Fackelhauch\', \'text\': \'Dieser Zauberspruch kostet beim Wirken {2} weniger, falls er eine blaue bleibende Karte als Ziel hat.\\nDieser Zauberspruch kann nicht neutralisiert werden.\\nDer Fackelhauch fügt einer Kreatur oder einem Planeswalker deiner Wahl X Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Calamari fritti? Kommen sofort!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555589&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'664396d0-fcab-4974-a64f-ee802a178a3b\', \'multiverseId\': 555589}, \'multiverseid\': 555589}, {\'name\': \'Aliento de antorcha\', \'text\': \'Te cuesta {2} menos lanzar este hechizo si hace objetivo a un permanente azul.\\nEste hechizo no puede ser contrarrestado.\\nEl Aliento de antorcha hace X puntos de daño a la criatura o planeswalker objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"¡Una de calamares fritos!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555850&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'deab8f7b-423b-4849-a5ef-02a015db17af\', \'multiverseId\': 555850}, \'multiverseid\': 555850}, {\'name\': \'Souffle torchère\', \'text\': "Ce sort coûte {2} de moins à lancer s\'il cible un permanent bleu.\\nCe sort ne peut pas être contrecarré.\\nLe Souffle torchère inflige X blessures à une cible, créature ou planeswalker.", \'type\': \'Éphémère\', \'flavor\': \'« Poulpe grillé, chaud devant ! »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556111&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4badd904-d694-4ef8-8c24-04055fc1d752\', \'multiverseId\': 556111}, \'multiverseid\': 556111}, {\'name\': \'Soffio Fiammante\', \'text\': \'Questa magia costa {2} in meno per essere lanciata se bersaglia un permanente blu.\\nQuesta magia non può essere neutralizzata.\\nIl Soffio Fiammante infligge X danni a una creatura o a un planeswalker bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Calamaro fritto, in arrivo!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556372&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e0b32801-65a4-4a6e-ac8b-13dd029fb08d\', \'multiverseId\': 556372}, \'multiverseid\': 556372}, {\'name\': \'松明吹き\', \'text\': \'この呪文が青のパーマネントを対象としているなら、これを唱えるためのコストは{2}少なくなる。\\nこの呪文は打ち消されない。\\nクリーチャーやプレインズウォーカーのうち１体を対象とする。松明吹きはそれにＸ点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'「イカ揚げ、一丁上がり！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556633&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1780e77c-e120-47f1-aac0-29c59aa86657\', \'multiverseId\': 556633}, \'multiverseid\': 556633}, {\'name\': \'불길의 숨결\', \'text\': \'이 주문이 청색 지속물을 목표로 한다면 이 주문은 발동하는 데 {2}가 덜 든다.\\n이 주문은 무효화될 수 없다.\\n생물 또는 플레인즈워커를 목표로 정한다. 불길의 숨결은 그 목표에게 피해 X점을 입힌다.\', \'type\': \'순간마법\', \'flavor\': \'"오징어 구이 대령이요!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556894&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'936e194d-f69e-4129-98a4-ccef23611a8b\', \'multiverseId\': 556894}, \'multiverseid\': 556894}, {\'name\': \'Sopro de Tocha\', \'text\': \'Esta mágica custará {2} a menos para ser conjurada se tiver uma permanente azul como alvo.\\nEsta mágica não pode ser anulada.\\nSopro de Tocha causa X pontos de dano à criatura ou ao planeswalker alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Lula frita saindo!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557155&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'593b7717-1aec-490a-aca3-c606f41d57a2\', \'multiverseId\': 557155}, \'multiverseid\': 557155}, {\'name\': \'Факельное Дыхание\', \'text\': "Разыгрывание этого заклинания стоит на {2} меньше, если его целью является синий перманент.\\nЭто заклинание не может быть отменено.\\nФакельное Дыхание наносит X повреждений целевому существу или planeswalker\'у.", \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Жареный кальмар на подходе!»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557416&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'88f1c077-5613-4b41-9d10-679c0c5c8206\', \'multiverseId\': 557416}, \'multiverseid\': 557416}, {\'name\': \'焰炬吐息\', \'text\': \'如果此咒语以蓝色永久物为目标，则它减少{2}来施放。\\n此咒语不能被反击。\\n焰炬吐息对目标生物或鹏洛客造成X点伤害。\', \'type\': \'瞬间\', \'flavor\': \'「烤鱿鱼上菜！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557677&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8726fada-689a-44b7-82c0-89a10dddc45f\', \'multiverseId\': 557677}, \'multiverseid\': 557677}, {\'name\': \'焰炬吐息\', \'text\': \'如果此咒語以藍色永久物為目標，則它減少{2}來施放。\\n此咒語不能被反擊。\\n焰炬吐息對目標生物或鵬洛客造成X點傷害。\', \'type\': \'瞬間\', \'flavor\': \'「烤魷魚上菜！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557938&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5156962c-fc2e-4837-a011-c09be2bb34ab\', \'multiverseId\': 557938}, \'multiverseid\': 557938}]', '[{\'name\': \'Falco Spara, der Paktweber\', \'text\': \'Fliegend, verursacht Trampelschaden\\nFalco Spara, der Paktweber, kommt mit einer Schildmarke ins Spiel.\\nDu kannst dir zu jedem Zeitpunkt die oberste Karte deiner Bibliothek anschauen.\\nDu kannst Zaubersprüche oben von deiner Bibliothek wirken, indem du zusätzlich zu ihren anderen Kosten eine Marke von einer Kreatur, die du kontrollierst, entfernst.\', \'type\': \'Legendäre Kreatur — Vogel, Dämon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555648&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'afd33b56-3196-49ac-842b-f4b147ca7c77\', \'multiverseId\': 555648}, \'multiverseid\': 555648}, {\'name\': \'Falco Spara, el Tejepactos\', \'text\': \'Vuela, arrolla.\\nFalco Spara, el Tejepactos entra al campo de batalla con un contador de escudo sobre él.\\nPuedes mirar la primera carta de tu biblioteca en cualquier momento.\\nPuedes lanzar hechizos desde la parte superior de tu biblioteca removiendo un contador de una criatura que controlas además de pagar sus otros costes.\', \'type\': \'Criatura legendaria — Demonio ave\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555909&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9f37b157-cd64-4573-9201-39d59f21b3f2\', \'multiverseId\': 555909}, \'multiverseid\': 555909}, {\'name\': \'Falco Spara, tisseur de pacte\', \'text\': "Vol, piétinement\\nFalco Spara, tisseur de pacte arrive sur le champ de bataille avec un marqueur « bouclier » sur lui.\\nVous pouvez regarder la carte du dessus de votre bibliothèque à tout moment.\\nVous pouvez lancer des sorts depuis le dessus de votre bibliothèque en retirant un marqueur d\'une créature que vous contrôlez en plus de payer ses autres coûts.", \'type\': \'Créature légendaire : oiseau et démon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556170&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8644f53c-de97-4669-a11e-a0407301964a\', \'multiverseId\': 556170}, \'multiverseid\': 556170}, {\'name\': "Falco Sparo, Tessitore d\'Intese", \'text\': "Volare, travolgere\\nFalco Sparo, Tessitore d\'Intese entra nel campo di battaglia con un segnalino scudo.\\nPuoi guardare la prima carta del tuo grimorio in qualsiasi momento.\\nPuoi lanciare magie dalla cima del tuo grimorio rimuovendo un segnalino da una creatura che controlli oltre a pagare gli altri loro costi.", \'type\': \'Creatura Leggendaria — Demone Uccello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556431&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'de3cd2c1-2662-4635-9b54-48039e36be4e\', \'multiverseId\': 556431}, \'multiverseid\': 556431}, {\'name\': \'契約紡ぎ、ファルコ・スパーラ\', \'text\': \'飛行、トランプル\\n契約紡ぎ、ファルコ・スパーラは盾カウンター１個が置かれた状態で戦場に出る。\\nあなたはいつでもあなたのライブラリーの一番上にあるカード１枚を見てもよい。\\n他のコストの支払いに加えてあなたがコントロールしているクリーチャー１体の上からカウンター１個を取り除くことで、あなたはあなたのライブラリーの一番上から呪文１つを唱えてもよい。\', \'type\': \'伝説のクリーチャー — 鳥・デーモン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556692&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4181f38e-ce21-4d37-a882-e895db828eea\', \'multiverseId\': 556692}, \'multiverseid\': 556692}, {\'name\': \'계약을 엮는 자, 팔코 스파라\', \'text\': \'비행, 돌진\\n계약을 엮는 자, 팔코 스파라는 방패 카운터 한 개를 가지고 전장에 들어온다.\\n당신은 당신의 서고 맨 위 카드를 언제든지 볼 수 있다.\\n당신은 주문의 다른 비용을 지불하는 것에 더해 당신이 조종하는 생물에서 카운터 한 개를 제거하는 것으로 당신의 서고 맨 위에서 주문을 발동할 수 있다.\', \'type\': \'전설적 생물 — 조류 악마\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556953&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b0bb7043-86f2-4902-a959-f3e68bd3190b\', \'multiverseId\': 556953}, \'multiverseid\': 556953}, {\'name\': \'Falco Spara, Tecedor de Pactos\', \'text\': \'Voar, atropelar\\nFalco Spara, Tecedor de Pactos, entra no campo de batalha com um marcador de escudo.\\nVocê pode olhar o card do topo de seu grimório a qualquer momento.\\nVocê pode conjurar mágicas do topo de seu grimório removendo um marcador de uma criatura que você controla além de pagar seus outros custos.\', \'type\': \'Criatura Lendária — Ave Demônio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557214&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'84606d3c-26e7-4305-9053-3a1724c3d1b6\', \'multiverseId\': 557214}, \'multiverseid\': 557214}, {\'name\': \'Фалько Спара, Творец Договоров\', \'text\': \'Полет, Пробивной удар\\nФалько Спара, Творец Договоров выходит на поле битвы с одним жетоном щита на нем.\\nВы в любой момент можете посмотреть верхнюю карту вашей библиотеки.\\nВы можете разыгрывать заклинания с верха вашей библиотеки, удаляя жетон с существа под вашим контролем в дополнение к оплате других их стоимостей.\', \'type\': \'Легендарное Существо — Птица Демон\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557475&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'472547d7-927d-444f-8214-f80ca09c8e19\', \'multiverseId\': 557475}, \'multiverseid\': 557475}, {\'name\': \'织契魔冯柯斯帕拉\', \'text\': \'飞行，践踏\\n织契魔冯柯斯帕拉进战场时上面有一个后盾指示物。\\n你可以随时检视你的牌库顶牌。\\n你可以从你的牌库顶施放咒语，但在其他费用以外，还须从由你操控的生物上移去一个指示物。\', \'type\': \'传奇生物 ～鸟／恶魔\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557736&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1c714068-e4bb-486b-ac6b-4e2915ed1a17\', \'multiverseId\': 557736}, \'multiverseid\': 557736}, {\'name\': \'織契魔馮柯斯帕拉\', \'text\': \'飛行，踐踏\\n織契魔馮柯斯帕拉進戰場時上面有一個後盾指示物。\\n你可以隨時檢視你的牌庫頂牌。\\n你可以從你的牌庫頂施放咒語，但在其他費用以外，還須從由你操控的生物上移去一個指示物。\', \'type\': \'傳奇生物 ～鳥／惡魔\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557997&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f8a1d777-0615-40cf-8ec4-063dcae04a9e\', \'multiverseId\': 557997}, \'multiverseid\': 557997}]', '[{\'name\': \'Falco Spara, der Paktweber\', \'text\': \'Fliegend, verursacht Trampelschaden\\nFalco Spara, der Paktweber, kommt mit einer Schildmarke ins Spiel.\\nDu kannst dir zu jedem Zeitpunkt die oberste Karte deiner Bibliothek anschauen.\\nDu kannst Zaubersprüche oben von deiner Bibliothek wirken, indem du zusätzlich zu ihren anderen Kosten eine Marke von einer Kreatur, die du kontrollierst, entfernst.\', \'type\': \'Legendäre Kreatur — Vogel, Dämon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558750&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'376bd506-48e2-493d-aaee-ab1023b4d57c\', \'multiverseId\': 558750}, \'multiverseid\': 558750}, {\'name\': \'Falco Spara, el Tejepactos\', \'text\': \'Vuela, arrolla.\\nFalco Spara, el Tejepactos entra al campo de batalla con un contador de escudo sobre él.\\nPuedes mirar la primera carta de tu biblioteca en cualquier momento.\\nPuedes lanzar hechizos desde la parte superior de tu biblioteca removiendo un contador de una criatura que controlas además de pagar sus otros costes.\', \'type\': \'Criatura legendaria — Demonio ave\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558795&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'03d989e8-f0c7-492a-bc4b-938ccf6abaea\', \'multiverseId\': 558795}, \'multiverseid\': 558795}, {\'name\': \'Falco Spara, tisseur de pacte\', \'text\': "Vol, piétinement\\nFalco Spara, tisseur de pacte arrive sur le champ de bataille avec un marqueur « bouclier » sur lui.\\nVous pouvez regarder la carte du dessus de votre bibliothèque à tout moment.\\nVous pouvez lancer des sorts depuis le dessus de votre bibliothèque en retirant un marqueur d\'une créature que vous contrôlez en plus de payer ses autres coûts.", \'type\': \'Créature légendaire : oiseau et démon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558840&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a0678302-0cb5-4e5d-b665-382fee64f56e\', \'multiverseId\': 558840}, \'multiverseid\': 558840}, {\'name\': "Falco Sparo, Tessitore d\'Intese", \'text\': "Volare, travolgere\\nFalco Sparo, Tessitore d\'Intese entra nel campo di battaglia con un segnalino scudo.\\nPuoi guardare la prima carta del tuo grimorio in qualsiasi momento.\\nPuoi lanciare magie dalla cima del tuo grimorio rimuovendo un segnalino da una creatura che controlli oltre a pagare gli altri loro costi.", \'type\': \'Creatura Leggendaria — Demone Uccello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558885&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a7cda5a8-9084-429e-b7fe-c16f5e326e76\', \'multiverseId\': 558885}, \'multiverseid\': 558885}, {\'name\': \'契約紡ぎ、ファルコ・スパーラ\', \'text\': \'飛行、トランプル\\n契約紡ぎ、ファルコ・スパーラは盾カウンター１個が置かれた状態で戦場に出る。\\nあなたはいつでもあなたのライブラリーの一番上にあるカード１枚を見てもよい。\\n他のコストの支払いに加えてあなたがコントロールしているクリーチャー１体の上からカウンター１個を取り除くことで、あなたはあなたのライブラリーの一番上から呪文１つを唱えてもよい。\', \'type\': \'伝説のクリーチャー — 鳥・デーモン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558930&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4c6c25fb-a4f5-4bb3-9e50-4eb174e36aac\', \'multiverseId\': 558930}, \'multiverseid\': 558930}, {\'name\': \'계약을 엮는 자, 팔코 스파라\', \'text\': \'비행, 돌진\\n계약을 엮는 자, 팔코 스파라는 방패 카운터 한 개를 가지고 전장에 들어온다.\\n당신은 당신의 서고 맨 위 카드를 언제든지 볼 수 있다.\\n당신은 주문의 다른 비용을 지불하는 것에 더해 당신이 조종하는 생물에서 카운터 한 개를 제거하는 것으로 당신의 서고 맨 위에서 주문을 발동할 수 있다.\', \'type\': \'전설적 생물 — 조류 악마\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558975&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c7a10be6-c194-4c8f-891f-5e28a7fed65a\', \'multiverseId\': 558975}, \'multiverseid\': 558975}, {\'name\': \'Falco Spara, Tecedor de Pactos\', \'text\': \'Voar, atropelar\\nFalco Spara, Tecedor de Pactos, entra no campo de batalha com um marcador de escudo.\\nVocê pode olhar o card do topo de seu grimório a qualquer momento.\\nVocê pode conjurar mágicas do topo de seu grimório removendo um marcador de uma criatura que você controla além de pagar seus outros custos.\', \'type\': \'Criatura Lendária — Ave Demônio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559020&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4eb171e7-4b82-4b14-874f-a2e190129332\', \'multiverseId\': 559020}, \'multiverseid\': 559020}, {\'name\': \'Фалько Спара, Творец Договоров\', \'text\': \'Полет, Пробивной удар\\nФалько Спара, Творец Договоров выходит на поле битвы с одним жетоном щита на нем.\\nВы в любой момент можете посмотреть верхнюю карту вашей библиотеки.\\nВы можете разыгрывать заклинания с верха вашей библиотеки, удаляя жетон с существа под вашим контролем в дополнение к оплате других их стоимостей.\', \'type\': \'Легендарное Существо — Птица Демон\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559065&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'71e2c0c7-63eb-4727-b8e6-c292f0bc2f33\', \'multiverseId\': 559065}, \'multiverseid\': 559065}, {\'name\': \'织契魔冯柯斯帕拉\', \'text\': \'飞行，践踏\\n织契魔冯柯斯帕拉进战场时上面有一个后盾指示物。\\n你可以随时检视你的牌库顶牌。\\n你可以从你的牌库顶施放咒语，但在其他费用以外，还须从由你操控的生物上移去一个指示物。\', \'type\': \'传奇生物 ～鸟／恶魔\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559110&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'581d08ad-ce27-4e27-8a69-81dad4742a20\', \'multiverseId\': 559110}, \'multiverseid\': 559110}, {\'name\': \'織契魔馮柯斯帕拉\', \'text\': \'飛行，踐踏\\n織契魔馮柯斯帕拉進戰場時上面有一個後盾指示物。\\n你可以隨時檢視你的牌庫頂牌。\\n你可以從你的牌庫頂施放咒語，但在其他費用以外，還須從由你操控的生物上移去一個指示物。\', \'type\': \'傳奇生物 ～鳥／惡魔\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559155&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7afa13d1-c39a-45bd-b764-f297d19eb8b8\', \'multiverseId\': 559155}, \'multiverseid\': 559155}]', '[{\'name\': \'Feen-Vandale\', \'text\': \'Aufblitzen\\nFliegend\\nImmer wenn du deine zweite Karte innerhalb desselben Zuges ziehst, lege eine +1/+1-Marke auf den Feen-Vandalen.\', \'type\': \'Kreatur — Feenwesen, Räuber\', \'flavor\': \'„Schatzkammer-Wache, warst gierig fürwahr. Jetzt hast du dafür Halo im Haar!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555506&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b9d9b7e9-ef6a-4c61-bf44-87400d6eb661\', \'multiverseId\': 555506}, \'multiverseid\': 555506}, {\'name\': \'Vándalo hada\', \'text\': \'Destello.\\nVuela.\\nSiempre que robes tu segunda carta cada turno, pon un contador +1/+1 sobre el Vándalo hada.\', \'type\': \'Criatura — Bribón hada\', \'flavor\': \'"El avaricioso guardia de la cámara no quería compartir. Ahora tiene halo en el cabello, ¡a sufrir!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555767&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9aa245e6-b2fd-42a2-84b0-1fa5cc0d059f\', \'multiverseId\': 555767}, \'multiverseid\': 555767}, {\'name\': \'Vandale faerie\', \'text\': \'Flash\\nVol\\nÀ chaque fois que vous piochez votre deuxième carte à chaque tour, mettez un marqueur +1/+1 sur le Vandale faerie.\', \'type\': \'Créature : peuple fée et gredin\', \'flavor\': "« Vilain garde, tu t\'es montré avaricieux. Maintenant il y a du halo dans tes cheveux ! »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556028&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2a0b2156-b8f7-40ed-bdc1-87a6c3d2bb1c\', \'multiverseId\': 556028}, \'multiverseid\': 556028}, {\'name\': \'Spiritello Vandalo\', \'text\': \'Lampo\\nVolare\\nOgniqualvolta peschi la tua seconda carta in ogni turno, metti un segnalino +1/+1 sullo Spiritello Vandalo.\', \'type\': \'Creatura — Farabutto Spiritello\', \'flavor\': \'"L\\\'avida guardia del caveau non voleva condividere un sorso. Ora ha la testa piena di Nimbo e non può più provare rimorso!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556289&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bcb36e23-f10f-4893-bf87-e802302efa86\', \'multiverseId\': 556289}, \'multiverseid\': 556289}, {\'name\': \'フェアリーの荒らし屋\', \'text\': \'瞬速\\n飛行\\nあなたが各ターンのあなたの２枚目のカードを引くたび、フェアリーの荒らし屋の上に＋１/＋１カウンター１個を置く。\', \'type\': \'クリーチャー — フェアリー・ならず者\', \'flavor\': \'「がめつい金庫室の守衛の野郎、絶対にゆずらなかった。だから髪を光素まみれにしてやった！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556550&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e75081c1-5416-4ece-81d8-6783cf3796ee\', \'multiverseId\': 556550}, \'multiverseid\': 556550}, {\'name\': \'페어리 기물파괴자\', \'text\': \'섬광\\n비행\\n당신이 각 턴에 당신의 두 번째 카드를 뽑을 때마다, 페어리 기물파괴자에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 페어리 도적\', \'flavor\': \'"나눌 줄 모르다니, 욕심 많은 금고지기잖아. 머리카락에 헤일로 범벅인 꼴 좀 봐!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556811&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4ce8c0a6-c512-4e30-a41a-60de2a70dfbb\', \'multiverseId\': 556811}, \'multiverseid\': 556811}, {\'name\': \'Vândalo Fada\', \'text\': \'Lampejo\\nVoar\\nToda vez que você comprar seu segundo card a cada turno, coloque um marcador +1/+1 em Vândalo Fada.\', \'type\': \'Criatura — Fada Ladino\', \'flavor\': \'"Guarda ganancioso. Não quis compartilhar. Agora está com halo no cabelo, olha lá!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557072&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'836e730b-ad15-4a16-a201-fa21c1634856\', \'multiverseId\': 557072}, \'multiverseid\': 557072}, {\'name\': \'Фея-Вандал\', \'text\': \'Миг\\nПолет\\nКаждый раз, когда вы берете вашу вторую карту в каждом ходу, положите один жетон +1/+1 на Фею-Вандала.\', \'type\': \'Существо — Фея Бродяга\', \'flavor\': \'«Жадный охранник хранилища не хотел делиться! Теперь у тебя гало в волосах!»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557333&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f0d549fe-b5f5-4a91-9593-e33cf4be8cb2\', \'multiverseId\': 557333}, \'multiverseid\': 557333}, {\'name\': \'莽撞仙灵\', \'text\': \'闪现\\n飞行\\n每当你抓每回合中你的第二张牌时，在莽撞仙灵上放置一个+1/+1指示物。\', \'type\': \'生物 ～仙灵／浪客\', \'flavor\': \'「宝库守卫贪婪无度不肯分享。就让我来抹点金圆到你头上！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557594&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9c3fe651-dce4-41f9-b356-83b9397739d5\', \'multiverseId\': 557594}, \'multiverseid\': 557594}, {\'name\': \'莽撞仙靈\', \'text\': \'閃現\\n飛行\\n每當你抽每回合中你的第二張牌時，在莽撞仙靈上放置一個+1/+1指示物。\', \'type\': \'生物 ～仙靈／浪客\', \'flavor\': \'「寶庫守衛貪婪無度不肯分享。就讓我來抹點金圓到你頭上！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557855&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6b954fc4-3ace-4fbb-852a-322d0f8fb6f3\', \'multiverseId\': 557855}, \'multiverseid\': 557855}]', '[{\'name\': \'Feindliche Übernahme\', \'text\': \'Bis zu eine Kreatur deiner Wahl hat Basis-Stärke und -Widerstandskraft 1/1 bis zum Ende des Zuges. Bis zu eine andere Kreatur deiner Wahl hat Basis-Stärke und -Widerstandskraft 4/4 bis zum Ende des Zuges. Dann fügt die Feindliche Übernahme jeder Kreatur 3 Schadenspunkte zu.\', \'type\': \'Hexerei\', \'flavor\': \'Ob Nixilis lächelte. Seine letzte Eroberung lag über eintausend Jahre zurück.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555653&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bf732f1f-2f3f-49a8-9b23-80d8aa04cdf4\', \'multiverseId\': 555653}, \'multiverseid\': 555653}, {\'name\': \'Tomar el poder por la fuerza\', \'text\': \'Hasta una criatura objetivo tiene una fuerza y resistencia base de 1/1 hasta el final del turno. Hasta una otra criatura objetivo tiene una fuerza y resistencia base de 4/4 hasta el final del turno. Luego, Tomar el poder por la fuerza hace 3 puntos de daño a cada criatura.\', \'type\': \'Conjuro\', \'flavor\': \'Ob Nixilis sonrió. Habían transcurrido más de mil años desde su última conquista.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555914&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c4bafb27-14b3-4a9a-ae6d-103609db0d27\', \'multiverseId\': 555914}, \'multiverseid\': 555914}, {\'name\': \'Reprise hostile\', \'text\': "Jusqu\'à une créature ciblée a une force et une endurance de base de 1/1 jusqu\'à la fin du tour. Jusqu\'à une autre créature ciblée a une force et une endurance de base de 4/4 jusqu\'à la fin du tour. Puis la Reprise hostile inflige 3 blessures à chaque créature.", \'type\': \'Rituel\', \'flavor\': \'Ob Nixilis sourit. Sa dernière conquête remontait à plus de mille ans.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556175&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6b45b490-275c-4cf0-a7e4-06bdd5c5fba0\', \'multiverseId\': 556175}, \'multiverseid\': 556175}, {\'name\': \'Acquisizione Ostile\', \'text\': "Fino a una creatura bersaglio ha forza e costituzione base 1/1 fino alla fine del turno. Fino a un\'altra creatura bersaglio ha forza e costituzione base 4/4 fino alla fine del turno. Poi l\'Acquisizione Ostile infligge 3 danni a ogni creatura.", \'type\': \'Stregoneria\', \'flavor\': \'Ob Nixilis sorrise. Erano passati più di mille anni dalla sua ultima conquista.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556436&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a4a7336c-28be-476b-b44b-ba3233f40e53\', \'multiverseId\': 556436}, \'multiverseid\': 556436}, {\'name\': \'敵意ある乗っ取り\', \'text\': \'クリーチャー最大１体とそれでないクリーチャー最大１体を対象とする。ターン終了時まで、その前者の基本のパワーとタフネスは１/１である。ターン終了時まで、その後者の基本のパワーとタフネスは４/４である。その後、敵意ある乗っ取りは戦場にある各クリーチャーにそれぞれ３点のダメージを与える。\', \'type\': \'ソーサリー\', \'flavor\': \'オブ・ニクシリスの顔から笑みがこぼれた。最後の征服から千年以上の歳月が流れていた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556697&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dbbbd4c1-c37f-4764-b2bb-673e2cc2d3a8\', \'multiverseId\': 556697}, \'multiverseid\': 556697}, {\'name\': \'적대적 인수 합병\', \'text\': \'생물을 최대 한 개까지 목표로 정한다. 그 생물은 턴종료까지 기본 공격력과 방어력이 1/1이 된다. 다른 생물을 최대 한 개까지 목표로 정한다. 그 생물은 턴종료까지 기본 공격력과 방어력이 4/4가 된다. 그 후 적대적 인수 합병은 각 생물에게 피해 3점을 입힌다.\', \'type\': \'집중마법\', \'flavor\': \'오브 닉실리스는 미소 지었다. 그가 마지막으로 정복을 했던 것은 천 년도 전이었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556958&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'301b6ab4-1722-4ed7-8c9d-5646373b45a9\', \'multiverseId\': 556958}, \'multiverseid\': 556958}, {\'name\': \'Aquisição Hostil\', \'text\': \'Até uma criatura alvo tem poder e resistência básicos 1/1 até o final do turno. Até uma outra criatura alvo tem poder e resistência básicos 4/4 até o final do turno. Depois, Aquisição Hostil causa 3 pontos de dano a cada criatura no campo de batalha.\', \'type\': \'Feitiço\', \'flavor\': \'Ob Nixilis sorriu. Já fazia mais de mil anos desde sua última conquista.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557219&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'554b35e7-533b-43f4-b8a8-dccf1d17b0b1\', \'multiverseId\': 557219}, \'multiverseid\': 557219}, {\'name\': \'Враждебное Поглощение\', \'text\': \'Не более одного целевого существа имеет базовую силу и выносливость 1/1 до конца хода. Не более одного другого целевого существа имеет базовую силу и выносливость 4/4 до конца хода. Затем Враждебное Поглощение наносит 3 повреждения каждому существу.\', \'type\': \'Волшебство\', \'flavor\': \'Об-Никсилис улыбнулся. Прошло более тысячи лет с его последнего завоевания.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557480&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'362a61f7-aa98-4fa3-b3f0-bbd693a4f008\', \'multiverseId\': 557480}, \'multiverseid\': 557480}, {\'name\': \'敌意接管\', \'text\': \'至多一个目标生物的基础力量与防御力为1/1直到回合结束。至多另一个目标生物的基础力量与防御力为4/4直到回合结束。然后敌意接管对所有生物各造成3点伤害。\', \'type\': \'法术\', \'flavor\': \'欧尼希兹笑了。距离他上一次征服已经过了千年有余。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557741&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c567885f-4cd4-438c-a187-2de616a6b189\', \'multiverseId\': 557741}, \'multiverseid\': 557741}, {\'name\': \'敵意接管\', \'text\': \'至多一個目標生物的基礎力量與防禦力為1/1直到回合結束。至多另一個目標生物的基礎力量與防禦力為4/4直到回合結束。然後敵意接管對所有生物各造成3點傷害。\', \'type\': \'巫術\', \'flavor\': \'歐尼希茲笑了。距離他上一次征服已經過了千年有餘。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558002&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1c30aa05-56a8-4fd6-94a1-d23384936e3e\', \'multiverseId\': 558002}, \'multiverseid\': 558002}]', '[{\'name\': \'Feindliche Übernahme\', \'text\': \'Bis zu eine Kreatur deiner Wahl hat Basis-Stärke und -Widerstandskraft 1/1 bis zum Ende des Zuges. Bis zu eine andere Kreatur deiner Wahl hat Basis-Stärke und -Widerstandskraft 4/4 bis zum Ende des Zuges. Dann fügt die Feindliche Übernahme jeder Kreatur 3 Schadenspunkte zu.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558753&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5d8131fb-87d7-4eac-ad7b-c403b6332c65\', \'multiverseId\': 558753}, \'multiverseid\': 558753}, {\'name\': \'Tomar el poder por la fuerza\', \'text\': \'Hasta una criatura objetivo tiene una fuerza y resistencia base de 1/1 hasta el final del turno. Hasta una otra criatura objetivo tiene una fuerza y resistencia base de 4/4 hasta el final del turno. Luego, Tomar el poder por la fuerza hace 3 puntos de daño a cada criatura.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558798&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cc7670b3-33f2-48ce-81bf-a308db3e7025\', \'multiverseId\': 558798}, \'multiverseid\': 558798}, {\'name\': \'Reprise hostile\', \'text\': "Jusqu\'à une créature ciblée a une force et une endurance de base de 1/1 jusqu\'à la fin du tour. Jusqu\'à une autre créature ciblée a une force et une endurance de base de 4/4 jusqu\'à la fin du tour. Puis la Reprise hostile inflige 3 blessures à chaque créature.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558843&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a1362c8f-e279-42d0-9e73-b4f23660de6f\', \'multiverseId\': 558843}, \'multiverseid\': 558843}, {\'name\': \'Acquisizione Ostile\', \'text\': "Fino a una creatura bersaglio ha forza e costituzione base 1/1 fino alla fine del turno. Fino a un\'altra creatura bersaglio ha forza e costituzione base 4/4 fino alla fine del turno. Poi l\'Acquisizione Ostile infligge 3 danni a ogni creatura.", \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558888&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f5eae7e6-0489-44ac-b57f-5330f7c6f6bc\', \'multiverseId\': 558888}, \'multiverseid\': 558888}, {\'name\': \'敵意ある乗っ取り\', \'text\': \'クリーチャー最大１体とそれでないクリーチャー最大１体を対象とする。ターン終了時まで、その前者の基本のパワーとタフネスは１/１である。ターン終了時まで、その後者の基本のパワーとタフネスは４/４である。その後、敵意ある乗っ取りは戦場にある各クリーチャーにそれぞれ３点のダメージを与える。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558933&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f0587a91-215e-41ad-9964-45870809eed5\', \'multiverseId\': 558933}, \'multiverseid\': 558933}, {\'name\': \'적대적 인수 합병\', \'text\': \'생물을 최대 한 개까지 목표로 정한다. 그 생물은 턴종료까지 기본 공격력과 방어력이 1/1이 된다. 다른 생물을 최대 한 개까지 목표로 정한다. 그 생물은 턴종료까지 기본 공격력과 방어력이 4/4가 된다. 그 후 적대적 인수 합병은 각 생물에게 피해 3점을 입힌다.\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558978&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'94fe7635-754f-4174-92b1-e6ba0e896afb\', \'multiverseId\': 558978}, \'multiverseid\': 558978}, {\'name\': \'Aquisição Hostil\', \'text\': \'Até uma criatura alvo tem poder e resistência básicos 1/1 até o final do turno. Até uma outra criatura alvo tem poder e resistência básicos 4/4 até o final do turno. Depois, Aquisição Hostil causa 3 pontos de dano a cada criatura no campo de batalha.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559023&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f89d571c-eec9-4b4a-b4b2-ab8842d304ae\', \'multiverseId\': 559023}, \'multiverseid\': 559023}, {\'name\': \'Враждебное Поглощение\', \'text\': \'Не более одного целевого существа имеет базовую силу и выносливость 1/1 до конца хода. Не более одного другого целевого существа имеет базовую силу и выносливость 4/4 до конца хода. Затем Враждебное Поглощение наносит 3 повреждения каждому существу.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559068&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0edad0ca-aa1c-4bf6-b41c-65f6317f8b66\', \'multiverseId\': 559068}, \'multiverseid\': 559068}, {\'name\': \'敌意接管\', \'text\': \'至多一个目标生物的基础力量与防御力为1/1直到回合结束。至多另一个目标生物的基础力量与防御力为4/4直到回合结束。然后敌意接管对所有生物各造成3点伤害。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559113&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f8ed8f7e-bfb3-4277-900c-284f36305389\', \'multiverseId\': 559113}, \'multiverseid\': 559113}, {\'name\': \'敵意接管\', \'text\': \'至多一個目標生物的基礎力量與防禦力為1/1直到回合結束。至多另一個目標生物的基礎力量與防禦力為4/4直到回合結束。然後敵意接管對所有生物各造成3點傷害。\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559158&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'73c00775-08f9-4fde-a743-03f1a86b33e2\', \'multiverseId\': 559158}, \'multiverseid\': 559158}]', '[{\'name\': \'Feuerhammer-Brandstifter\', \'text\': \'{1}, {T}: Der Feuerhammer-Brandstifter fügt einem Ziel deiner Wahl X Schadenspunkte zu, wobei X gleich der Anzahl an bleibenden Karten ist, die du in diesem Zug geopfert hast.\', \'type\': \'Kreatur — Viashino, Schamane\', \'flavor\': \'Alles von beschädigten Möbeln bis hin zu störenden Leichen wird zu Brennstoff für Ziatoras immer brennende Schmelze.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555580&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a080acf7-592c-4270-8e19-742c04945a12\', \'multiverseId\': 555580}, \'multiverseid\': 555580}, {\'name\': \'Calcinador de la piromaza\', \'text\': \'{1}, {T}: El Calcinador de la piromaza hace X puntos de daño a cualquier objetivo, donde X es la cantidad de permanentes que sacrificaste este turno.\', \'type\': \'Criatura — Chamán viashino\', \'flavor\': \'Desde muebles con daños hasta cadáveres que hay que eliminar: todo sirve de combustible para la fundición que nunca se apaga de Ziatora.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555841&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ab96a543-9230-4457-a758-1ccd6593d5c5\', \'multiverseId\': 555841}, \'multiverseid\': 555841}, {\'name\': \'Incendiaire à la masse-bûcher\', \'text\': "{1}, {T} : L\'Incendiaire à la masse-bûcher inflige X blessures à n\'importe quelle cible, X étant le nombre de permanents que vous avez sacrifiés ce tour-ci.", \'type\': \'Créature : viashino et shamane\', \'flavor\': \'Des meubles abîmés aux cadavres gênants, tout peut servir de carburant à la fonderie de Ziatora en perpétuelle activité.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556102&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b48aaf28-d76a-49ab-9901-1436bf85082f\', \'multiverseId\': 556102}, \'multiverseid\': 556102}, {\'name\': \'Piromane del Maglio Infuocato\', \'text\': \'{1}, {T}: Il Piromane del Maglio Infuocato infligge X danni a un qualsiasi bersaglio, dove X è il numero di permanenti che hai sacrificato in questo turno.\', \'type\': \'Creatura — Sciamano Viashino\', \'flavor\': \'Tutto, dai mobili danneggiati ai cadaveri scomodi, diventa carburante per la fonderia sempre accesa di Ziatora.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556363&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'56894edc-b4cc-4364-a53c-298a3c735429\', \'multiverseId\': 556363}, \'multiverseid\': 556363}, {\'name\': \'大火槌の放火魔\', \'text\': \'{1}, {T}：クリーチャーやプレインズウォーカーやプレイヤーのうち１つを対象とする。大火槌の放火魔はそれにＸ点のダメージを与える。Ｘはこのターンにあなたが生け贄に捧げたパーマネントの数に等しい。\', \'type\': \'クリーチャー — ヴィーアシーノ・シャーマン\', \'flavor\': \'傷んだ家具から不都合な死体までなんでも、火の絶えないジアトラの鋳造所の燃料になる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556624&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b1eca12d-0cf1-430a-951a-01031f1fb242\', \'multiverseId\': 556624}, \'multiverseid\': 556624}, {\'name\': \'화염망치 방화범\', \'text\': \'{1}, {T}: 원하는 목표를 정한다. 화염망치 방화범은 그 목표에게 피해 X점을 입힌다. X는 당신이 이 턴에 희생한 지속물의 수다.\', \'type\': \'생물 — 비아시노 주술사\', \'flavor\': \'부서진 가구부터 곤란한 시체까지, 모든 것이 불이 꺼지는 법이 없는 지아토라의 주조소를 위한 연료가 된다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556885&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7f56c6cd-9cea-479a-be26-f79a240aa973\', \'multiverseId\': 556885}, \'multiverseid\': 556885}, {\'name\': \'Incendiário da Piromarreta\', \'text\': \'{1}, {T}: Incendiário da Piromarreta causa X pontos de dano a qualquer alvo, sendo X o número de permanentes que você sacrificou neste turno.\', \'type\': \'Criatura — Viashino Xamã\', \'flavor\': \'Tudo, de móveis danificados a cadáveres inconvenientes, vira combustível para a fundição sempre ardente de Ziatora.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557146&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0e6d5a3f-8c99-4754-ab84-4a046b0a056e\', \'multiverseId\': 557146}, \'multiverseid\': 557146}, {\'name\': \'Поджигатель Огненной Кувалды\', \'text\': \'{1}, {T}: Поджигатель Огненной Кувалды наносит X повреждений любой цели, где X — количество перманентов, которые вы уже пожертвовали в этом ходу.\', \'type\': \'Существо — Виашино Шаман\', \'flavor\': \'Все, от поломанной мебели до неудобных трупов, становится топливом для негасимых доменных печей Зиаторы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557407&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'134bb221-a5a4-4f3b-bbdb-74c6a7369248\', \'multiverseId\': 557407}, \'multiverseid\': 557407}, {\'name\': \'葬火锤纵燃师\', \'text\': \'{1}，{T}：葬火锤纵燃师对任意一个目标造成X点伤害，X为你本回合中已牺牲的永久物数量。\', \'type\': \'生物 ～凡尔西诺／祭师\', \'flavor\': \'从损坏的家具到不该出现的尸体，一切都会成为齐朵拉不熄锻炉之燃料。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557668&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'04facb75-8535-491d-9386-880180bfeb41\', \'multiverseId\': 557668}, \'multiverseid\': 557668}, {\'name\': \'葬火鎚縱燃師\', \'text\': \'{1}，{T}：葬火鎚縱燃師對任意一個目標造成X點傷害，X為你本回合中已犧牲的永久物數量。\', \'type\': \'生物 ～凡爾西諾／祭師\', \'flavor\': \'從損壞的傢俱到不該出現的屍體，一切都會成為齊朵拉不熄鍛爐之燃料。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557929&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bb5da210-4f66-458f-a92b-e3b55a107f6f\', \'multiverseId\': 557929}, \'multiverseid\': 557929}]', '[{\'name\': \'Fliegender Ausrufer\', \'text\': \'Fliegend, Lebensverknüpfung\\n{3}{W}: Du und ein Gegner deiner Wahl zieht je eine Karte.\', \'type\': \'Kreatur — Vogel, Bürger\', \'flavor\': \'„Sondermeldung! Fürst Xander tot aufgefunden! Verdächtiger auf freiem Fuß!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555493&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'65242e96-b4f2-47f6-a6bb-0c0e59deff1c\', \'multiverseId\': 555493}, \'multiverseid\': 555493}, {\'name\': \'Pregonero de los cielos\', \'text\': \'Vuela, vínculo vital.\\n{3}{W}: El oponente objetivo y tú roban una carta.\', \'type\': \'Criatura — Ciudadano ave\', \'flavor\': \'"¡Noticias de última hora! ¡Don Xander ha muerto! ¡El sospechoso anda suelto!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555754&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'141cad43-e25e-48ca-810d-1e89dc6478c3\', \'multiverseId\': 555754}, \'multiverseid\': 555754}, {\'name\': \'Crieur céleste\', \'text\': \'Vol, lien de vie\\n{3}{W} : Un adversaire ciblé et vous piochez chacun une carte.\', \'type\': \'Créature : oiseau et citoyen\', \'flavor\': \'« Dernières nouvelles ! Le seigneur Xander retrouvé mort ! Le suspect court toujours ! »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556015&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'90230ca7-e22c-4dea-ab3e-884dd3fa24a5\', \'multiverseId\': 556015}, \'multiverseid\': 556015}, {\'name\': \'Banditore Celeste\', \'text\': \'Volare, legame vitale\\n{3}{W}: Tu e un avversario bersaglio pescate una carta.\', \'type\': \'Creatura — Cittadino Uccello\', \'flavor\': \'"Ultime notizie! Trovato morto Lord Xander! Sospetto a piede libero!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556276&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3ba81287-c5f3-4fdd-b2b1-d3d727facc37\', \'multiverseId\': 556276}, \'multiverseid\': 556276}, {\'name\': \'空の叫び屋\', \'text\': \'飛行、絆魂\\n{3}{W}：対戦相手１人を対象とする。あなたとそのプレイヤーはそれぞれカード１枚を引く。\', \'type\': \'クリーチャー — 鳥・市民\', \'flavor\': \'「速報だ！ザンダー卿が遺体で見つかった！犯人は逃走中！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556537&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'64ce04ba-8d48-47e3-808f-10d83a52cc9a\', \'multiverseId\': 556537}, \'multiverseid\': 556537}, {\'name\': \'창공 외침꾼\', \'text\': \'비행, 생명연결\\n{3}{W}: 상대를 목표로 정한다. 당신 및 그 플레이어는 각각 카드 한 장을 뽑는다.\', \'type\': \'생물 — 조류 시민\', \'flavor\': \'"속보입니다! 잰더 경이 사망한 채로 발견됐습니다! 용의자는 아직 붙잡히지 않았습니다!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556798&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3364c53c-7884-4c0b-b390-939c5cf11984\', \'multiverseId\': 556798}, \'multiverseid\': 556798}, {\'name\': \'Bradador Celeste\', \'text\': \'Voar, vínculo com a vida\\n{3}{W}: Você e o oponente alvo compram, cada um, um card.\', \'type\': \'Criatura — Ave Cidadão\', \'flavor\': \'"Extra! Extra! Don Xander encontrado morto! Suspeito à solta!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557059&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d9639c78-4bde-403b-a9fc-13dbb286c077\', \'multiverseId\': 557059}, \'multiverseid\': 557059}, {\'name\': \'Небесный Глашатай\', \'text\': \'Полет, Цепь жизни\\n{3}{W}: вы и целевой оппонент берете по карте.\', \'type\': \'Существо — Птица Гражданин\', \'flavor\': \'«Срочные новости! Лорд Зандер найден мертвым! Подозреваемый на свободе!»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557320&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f91fc4e6-1e9d-4e8b-8b0a-e37b518c9eff\', \'multiverseId\': 557320}, \'multiverseid\': 557320}, {\'name\': \'报信艾文\', \'text\': \'飞行，系命\\n{3}{W}：你和目标对手各抓一张牌。\', \'type\': \'生物 ～鸟／市民\', \'flavor\': \'「号外！尚夺尔勋爵遇害！嫌犯在逃！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557581&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1354c466-cbf2-4a4d-b86a-11fe5b836983\', \'multiverseId\': 557581}, \'multiverseid\': 557581}, {\'name\': \'報信艾文\', \'text\': \'飛行，繫命\\n{3}{W}：你和目標對手各抽一張牌。\', \'type\': \'生物 ～鳥／市民\', \'flavor\': \'「號外！尚奪爾勳爵遇害！嫌犯在逃！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557842&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2058f3cb-0760-4809-92af-a451b38544ea\', \'multiverseId\': 557842}, \'multiverseid\': 557842}]', '[{\'name\': \'Flinker Dolch\', \'text\': \'Aufblitzen\\nWenn der Flinke Dolch ins Spiel kommt, lege ihn an eine Kreatur deiner Wahl an, die du kontrollierst. Die Kreatur erhält Erstschlag bis zum Ende des Zuges.\\nDie ausgerüstete Kreatur erhält +1/+1.\\nAusrüsten {1} ({1}: Lege diese Karte an eine Kreatur deiner Wahl an, die du kontrollierst. Spiele Ausrüsten wie eine Hexerei.)\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555705&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6a7c2fe3-dd4e-4ae4-b691-50d5ba7302e5\', \'multiverseId\': 555705}, \'multiverseid\': 555705}, {\'name\': \'Daga de empuñe rápido\', \'text\': \'Destello.\\nCuando la Daga de empuñe rápido entre al campo de batalla, anéxala a la criatura objetivo que controlas. Esa criatura gana la habilidad de dañar primero hasta el final del turno.\\nLa criatura equipada obtiene +1/+1.\\nEquipar {1}. ({1}: Anexa este Equipo a la criatura objetivo que controlas. Activa la habilidad de equipar como un conjuro.)\', \'type\': \'Artefacto — Equipo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555966&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9c526e79-b403-4e07-b4a9-42f8a340f4f5\', \'multiverseId\': 555966}, \'multiverseid\': 555966}, {\'name\': \'Dague à dégaine rapide\', \'text\': "Flash\\nQuand la Dague à dégaine rapide arrive sur le champ de bataille, attachez-la à une créature ciblée que vous contrôlez. Cette créature acquiert l\'initiative jusqu\'à la fin du tour.\\nLa créature équipée gagne +1/+1.\\nÉquipement {1} ({1} : Attachez à une créature ciblée que vous contrôlez. N\'attachez l\'équipement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Artefact : équipement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556227&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3796a356-5168-4060-9cc9-52145ca416c0\', \'multiverseId\': 556227}, \'multiverseid\': 556227}, {\'name\': \'Pugnale ad Estrazione Rapida\', \'text\': \'Lampo\\nQuando il Pugnale ad Estrazione Rapida entra nel campo di battaglia, assegnalo a una creatura bersaglio che controlli. Quella creatura ha attacco improvviso fino alla fine del turno.\\nLa creatura equipaggiata prende +1/+1.\\nEquipaggiare {1} ({1}: Assegna a una creatura bersaglio che controlli. Equipaggia solo come una stregoneria.)\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556488&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9ab4dbeb-6b95-48f0-ace4-27d3c39fd322\', \'multiverseId\': 556488}, \'multiverseid\': 556488}, {\'name\': \'早抜きの短剣\', \'text\': \'瞬速\\n早抜きの短剣が戦場に出たとき、あなたがコントロールしているクリーチャー１体を対象とする。これをそれにつける。ターン終了時まで、そのクリーチャーは先制攻撃を得る。\\n装備しているクリーチャーは＋１/＋１の修整を受ける。\\n装備{1}（{1}：あなたがコントロールしているクリーチャー１体を対象とする。これをそれにつける。装備はソーサリーとしてのみ行う。）\', \'type\': \'アーティファクト — 装備品\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556749&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a40d1361-9556-4aa9-802b-25886734abd5\', \'multiverseId\': 556749}, \'multiverseid\': 556749}, {\'name\': \'재빨리 뽑는 단도\', \'text\': \'섬광\\n재빨리 뽑는 단도가 전장에 들어올 때, 당신이 조종하는 생물을 목표로 정한다. 재빨리 뽑는 단도를 그 생물에 부착한다. 그 생물은 턴종료까지 선제공격을 얻는다.\\n장착된 생물은 +1/+1을 받는다.\\n장착 {1} ({1}: 당신이 조종하는 생물을 목표로 정한다. 그 생물에 이 장비를 부착한다. 집중마법 시기에만 장착할 수 있다.)\', \'type\': \'마법물체 — 장비\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557010&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2570f1a0-2a2c-4bae-b6fe-dc4a812c18b6\', \'multiverseId\': 557010}, \'multiverseid\': 557010}, {\'name\': \'Adaga de Saque Rápido\', \'text\': \'Lampejo\\nQuando Adaga de Saque Rápido entrar no campo de batalha, anexe-a à criatura alvo que você controla. Aquela criatura ganha iniciativa até o final do turno.\\nA criatura equipada recebe +1/+1.\\nEquipar {1} ({1}: Anexe este equipamento à criatura alvo que você controla. Equipe somente como um feitiço.)\', \'type\': \'Artefato — Equipamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557271&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1323df4b-d1a4-4085-9514-48df676a4766\', \'multiverseId\': 557271}, \'multiverseid\': 557271}, {\'name\': \'Быстрый Кинжал\', \'text\': \'Миг\\nКогда Быстрый Кинжал выходит на поле битвы, прикрепите его к целевому существу под вашим контролем. То существо получает Первый удар до конца хода.\\nСнаряженное существо получает +1/+1.\\nСнарядить {1} ({1}: прикрепите к целевому существу под вашим контролем. Снаряжайте только как волшебство.)\', \'type\': \'Артефакт — Снаряжение\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557532&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6fc60bfe-eb96-4fec-9e78-4b1ff6ff7990\', \'multiverseId\': 557532}, \'multiverseid\': 557532}, {\'name\': \'快手匕首\', \'text\': \'闪现\\n当快手匕首进战场时，将它贴附在目标由你操控的生物上。该生物获得先攻异能直到回合结束。\\n佩带此武具的生物得+1/+1。\\n佩带{1}（{1}：贴附在目标由你操控的生物上。只能于法术时机佩带。）\', \'type\': \'神器 ～武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557793&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'61542b0b-268f-43b2-99b2-129bd190ef7c\', \'multiverseId\': 557793}, \'multiverseid\': 557793}, {\'name\': \'快手匕首\', \'text\': \'閃現\\n當快手匕首進戰場時，將它貼附在目標由你操控的生物上。該生物獲得先攻異能直到回合結束。\\n佩帶此武具的生物得+1/+1。\\n佩帶{1}（{1}：貼附在目標由你操控的生物上。只能於巫術時機佩帶。）\', \'type\': \'神器 ～武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558054&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'29394b38-c1e0-485b-9fe1-e3ab2a49edef\', \'multiverseId\': 558054}, \'multiverseid\': 558054}]', '[{\'name\': \'Flucht aus der Stadt\', \'text\': \'Der Besitzer einer bleibenden Karte deiner Wahl, die kein Land ist, legt sie auf oder unter seine Bibliothek.\', \'type\': \'Spontanzauber\', \'flavor\': \'Besser eilends entschwinden als selig entschlafen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555520&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'92b7751f-069f-4519-bc14-5f3d39a007b5\', \'multiverseId\': 555520}, \'multiverseid\': 555520}, {\'name\': \'Huir de la ciudad\', \'text\': \'El propietario del permanente objetivo que no sea tierra lo pone en la parte superior o en el fondo de su biblioteca.\', \'type\': \'Instantáneo\', \'flavor\': \'Mejor tener un pie fuera de la ciudad que un pie en la tumba.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555781&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8140b041-cabe-4c5b-8dae-ace6c25e6ab1\', \'multiverseId\': 555781}, \'multiverseid\': 555781}, {\'name\': \'Quitter la ville\', \'text\': "Le propriétaire d\'un permanent non-terrain ciblé le met au-dessus ou au-dessous de sa bibliothèque.", \'type\': \'Éphémère\', \'flavor\': "Mieux vaut partir vite qu\'être trop vite parti.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556042&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d7df62df-160a-4ee1-8d7f-25a43a1196c7\', \'multiverseId\': 556042}, \'multiverseid\': 556042}, {\'name\': \'Fuggire dalla Città\', \'text\': \'Il proprietario di un permanente non terra bersaglio mette quel permanente in cima o in fondo al suo grimorio.\', \'type\': \'Istantaneo\', \'flavor\': \'Meglio lasciare la città che lasciarci la pelle.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556303&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f499616e-03c7-40c4-a60b-e23cea6d5ec2\', \'multiverseId\': 556303}, \'multiverseid\': 556303}, {\'name\': \'都落ち\', \'text\': \'土地でないパーマネント１つを対象とする。それのオーナーはそれを自分のライブラリーの一番上か一番下に置く。\', \'type\': \'インスタント\', \'flavor\': \'安らかに旅立つより、さっさと旅立つ方がましである。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556564&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'54134fc5-9127-428a-927e-3060d430d0d0\', \'multiverseId\': 556564}, \'multiverseid\': 556564}, {\'name\': \'마을 밖으로 도망치기\', \'text\': \'대지가 아닌 지속물을 목표로 정한다. 그 지속물의 소유자는 그 지속물을 자신의 서고 맨 위 또는 맨 밑에 놓는다.\', \'type\': \'순간마법\', \'flavor\': \'서둘러 떠나는 게 이승을 떠나는 것보다 낫다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556825&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'87a149e0-e46c-480a-a0e7-e15f7b1b8010\', \'multiverseId\': 556825}, \'multiverseid\': 556825}, {\'name\': \'Fuga da Cidade\', \'text\': \'O dono da permanente alvo não de terreno a coloca no topo ou no fundo do próprio grimório.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'É melhor partir apressadamente do que definitivamente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557086&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2c69289e-316d-475c-adbe-d858ae8c022e\', \'multiverseId\': 557086}, \'multiverseid\': 557086}, {\'name\': \'Побег из Города\', \'text\': \'Владелец целевого не являющегося землей перманента кладет его на верх или в низ своей библиотеки.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Лучше пропасть, не оставив весточки, чем числиться без вести пропавшим.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557347&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'105880d5-617a-4d9c-9a4f-40df0f238a77\', \'multiverseId\': 557347}, \'multiverseid\': 557347}, {\'name\': \'潜逃出城\', \'text\': \'目标非地永久物的拥有者将它置于其牌库顶或牌库底。\', \'type\': \'瞬间\', \'flavor\': \'宁愿仓皇逃命，也不要一命呜呼。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557608&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'feb773b6-e08e-4085-a7b1-5fcbc22f776a\', \'multiverseId\': 557608}, \'multiverseid\': 557608}, {\'name\': \'潛逃出城\', \'text\': \'目標非地永久物的擁有者將它置於其牌庫頂或牌庫底。\', \'type\': \'瞬間\', \'flavor\': \'寧願倉皇逃命，也不要一命嗚呼。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557869&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5aaa386e-5079-439c-8e90-0e8444112d59\', \'multiverseId\': 557869}, \'multiverseid\': 557869}]', '[{\'name\': \'Fluchtwagen\', \'text\': \'Eile\\nImmer wenn der Fluchtwagen angreift oder blockt, bringe bis zu eine Kreatur deiner Wahl, die ihn in diesem Zug bemannt hat, auf die Hand ihres Besitzers zurück.\\nBemannen 1\', \'type\': \'Artefakt — Fahrzeug\', \'flavor\': \'Für eine schnelle Abreise, ohne unnötig Aufmerksamkeit zu erregen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555699&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a537a6f3-9ccf-4c51-8138-5beede35588c\', \'multiverseId\': 555699}, \'multiverseid\': 555699}, {\'name\': \'Vehículo de huida\', \'text\': \'Prisa.\\nSiempre que el Vehículo de huida ataque o bloquee, regresa hasta una criatura objetivo que lo tripuló este turno a la mano de su propietario.\\nTripular 1.\', \'type\': \'Artefacto — Vehículo\', \'flavor\': \'Para aquellos que necesitan esfumarse sin llamar demasiado la atención.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555960&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1c528ee5-ac10-425f-be52-a03312a4e54f\', \'multiverseId\': 555960}, \'multiverseid\': 555960}, {\'name\': "Bolide d\'évasion", \'text\': "Célérité\\nÀ chaque fois que le Bolide d\'évasion attaque ou bloque, renvoyez jusqu\'à une créature ciblée qui l\'a piloté ce tour-ci dans la main de son propriétaire.\\nPilotage 1", \'type\': \'Artefact : véhicule\', \'flavor\': "Pour ceux qui doivent mettre les voiles en vitesse sans attirer l\'attention.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556221&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0a1bc3c8-4777-460f-a99c-f3e716588841\', \'multiverseId\': 556221}, \'multiverseid\': 556221}, {\'name\': \'Bolide da Fuga\', \'text\': "Rapidità\\nOgniqualvolta il Bolide da Fuga attacca o blocca, fai tornare fino a una creatura bersaglio che l\'ha manovrato in questo turno in mano al suo proprietario.\\nManovrare 1", \'type\': \'Artefatto — Veicolo\', \'flavor\': \'Per chi ha bisogno di partire in fretta senza attirare troppa attenzione.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556482&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'12d9b85f-e784-4bee-8a40-7ce0703edc5b\', \'multiverseId\': 556482}, \'multiverseid\': 556482}, {\'name\': \'逃走用の車\', \'text\': \'速攻\\n逃走用の車が攻撃するかブロックするたび、このターンにこれに搭乗したクリーチャー最大１体を対象とする。それをオーナーの手札に戻す。\\n搭乗１\', \'type\': \'アーティファクト — 機体\', \'flavor\': \'過度な注目を集めずに迅速な出発を果たしたい者向け。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556743&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c0fd82c4-f1f7-480a-be59-a0a6121870f7\', \'multiverseId\': 556743}, \'multiverseid\': 556743}, {\'name\': \'도주 차량\', \'text\': \'신속\\n도주 차량이 공격 또는 방어할 때마다, 이 턴에 도주 차량에 탑승한 생물을 최대 한 개까지 목표로 정한다. 그 생물을 소유자의 손으로 되돌린다.\\n탑승 1\', \'type\': \'마법물체 — 탑승물\', \'flavor\': \'불필요한 시선을 끌지 않고 빠르게 떠나야 하는 사람들을 위해.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557004&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'45191ada-b158-45b9-9df1-81eb5665ca44\', \'multiverseId\': 557004}, \'multiverseid\': 557004}, {\'name\': \'Carro de Fuga\', \'text\': \'Ímpeto\\nToda vez que Carro de Fuga atacar ou bloquear, devolva até uma criatura alvo que o tenha tripulado neste turno para a mão de seu dono.\\nTripular 1\', \'type\': \'Artefato — Veículo\', \'flavor\': \'Para quem precisa se retirar rapidamente sem chamar atenção.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557265&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b7f7d63f-db23-40f8-835d-5885f97a398f\', \'multiverseId\': 557265}, \'multiverseid\': 557265}, {\'name\': \'Авто для Побега\', \'text\': \'Ускорение\\nКаждый раз, когда Авто для Побега атакует или блокирует, верните не более одного целевого существа, которое входило в его экипаж в этом ходу, в руку его владельца.\\nЭкипаж 1\', \'type\': \'Артефакт — Машина\', \'flavor\': \'Для тех, кому нужно спешно уехать, не привлекая излишнего внимания.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557526&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6daf6568-5aad-4226-aed3-08b8d4de6b3c\', \'multiverseId\': 557526}, \'multiverseid\': 557526}, {\'name\': \'脱逃跑车\', \'text\': \'敏捷\\n每当脱逃跑车攻击或阻挡时，将至多一个目标本回合中搭载它的生物移回其拥有者手上。\\n搭载1\', \'type\': \'神器 ～载具\', \'flavor\': \'适合需要低调行事、迅速离开者。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557787&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1dac7ea5-423c-4e08-8a5e-71231f52bb36\', \'multiverseId\': 557787}, \'multiverseid\': 557787}, {\'name\': \'脫逃跑車\', \'text\': \'敏捷\\n每當脫逃跑車攻擊或阻擋時，將至多一個目標本回合中搭載它的生物移回其擁有者手上。\\n搭載1\', \'type\': \'神器 ～載具\', \'flavor\': \'適合需要低調行事、迅速離開者。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558048&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a5b50dd5-df1a-4f2e-8d9c-df28f0d4d2f8\', \'multiverseId\': 558048}, \'multiverseid\': 558048}]', '[{\'name\': \'Fluchtwagen\', \'text\': \'Eile\\nImmer wenn der Fluchtwagen angreift oder blockt, bringe bis zu eine Kreatur deiner Wahl, die ihn in diesem Zug bemannt hat, auf die Hand ihres Besitzers zurück.\\nBemannen 1\', \'type\': \'Artefakt — Fahrzeug\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558311&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'22cad1a6-c044-46f3-b81e-336e941fd6ee\', \'multiverseId\': 558311}, \'multiverseid\': 558311}, {\'name\': "Bolide d\'évasion", \'text\': "Célérité\\nÀ chaque fois que le Bolide d\'évasion attaque ou bloque, renvoyez jusqu\'à une créature ciblée qui l\'a piloté ce tour-ci dans la main de son propriétaire.\\nPilotage 1", \'type\': \'Artefact : véhicule\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558346&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'68bfaaaf-9c31-4118-be29-63c1279016eb\', \'multiverseId\': 558346}, \'multiverseid\': 558346}, {\'name\': \'逃走用の車\', \'text\': \'速攻\\n逃走用の車が攻撃するかブロックするたび、このターンにこれに搭乗したクリーチャー最大１体を対象とする。それをオーナーの手札に戻す。\\n搭乗１\', \'type\': \'アーティファクト — 機体\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558381&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3205741d-1aab-4443-9213-4dbb27445e9b\', \'multiverseId\': 558381}, \'multiverseid\': 558381}, {\'name\': \'脱逃跑车\', \'text\': \'敏捷\\n每当脱逃跑车攻击或阻挡时，将至多一个目标本回合中搭载它的生物移回其拥有者手上。\\n搭载1\', \'type\': \'神器 ～载具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558416&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c9b2aab7-d59f-4f37-b3c2-61e9697735b5\', \'multiverseId\': 558416}, \'multiverseid\': 558416}]', '[{\'name\': \'Freiberuflicher Muskelprotz\', \'text\': \'Immer wenn der Freiberufliche Muskelprotz angreift oder blockt, erhält er bis zum Ende des Zuges +X/+X, wobei X gleich der höchsten Stärke und/oder Widerstandskraft unter den anderen Kreaturen ist, die du kontrollierst.\', \'type\': \'Kreatur — Nashorn, Krieger\', \'flavor\': \'Er fragt nie nach dem Warum. Nur nach dem Wen, Wann und Wo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555609&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'18ff9ee5-a4e7-4a97-9375-308769d6e5a8\', \'multiverseId\': 555609}, \'multiverseid\': 555609}, {\'name\': \'Matón autónomo\', \'text\': \'Siempre que el Matón autónomo ataque o bloquee, obtiene +X/+X hasta el final del turno, donde X es la mayor fuerza y/o resistencia entre las otras criaturas que controlas.\', \'type\': \'Criatura — Guerrero rinoceronte\', \'flavor\': \'Nunca pregunta por qué, solo quién, cuándo y dónde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555870&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f1a33c8d-a3de-4221-91a9-f65bbacea031\', \'multiverseId\': 555870}, \'multiverseid\': 555870}, {\'name\': \'Gros bras indépendant\', \'text\': "À chaque fois que le Gros bras indépendant attaque ou bloque, il gagne +X/+X jusqu\'à la fin du tour, X étant la force et/ou l\'endurance la plus élevée parmi les autres créatures que vous contrôlez.", \'type\': \'Créature : rhinocéros et guerrier\', \'flavor\': \'Il ne demande jamais pourquoi. Juste qui, quand et où.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556131&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f7b60cc0-bed9-42f1-8365-d76de8fe48e7\', \'multiverseId\': 556131}, \'multiverseid\': 556131}, {\'name\': \'Scagnozzo Prezzolato\', \'text\': \'Ogniqualvolta lo Scagnozzo Prezzolato attacca o blocca, prende +X/+X fino alla fine del turno, dove X è la forza e/o la costituzione maggiore tra le altre creature che controlli.\', \'type\': \'Creatura — Guerriero Rinoceronte\', \'flavor\': \'Non chiede mai perché. Solo chi, quando e dove.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556392&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3cad84fe-c0b7-4058-b2ab-0de21c386995\', \'multiverseId\': 556392}, \'multiverseid\': 556392}, {\'name\': \'無所属の筋肉達磨\', \'text\': \'無所属の筋肉達磨が攻撃するかブロックするたび、ターン終了時まで、これは＋Ｘ/＋Ｘの修整を受ける。Ｘはあなたがコントロールしていてこれでないすべてのクリーチャーのパワーやタフネスの中の最大値に等しい。\', \'type\': \'クリーチャー — サイ・戦士\', \'flavor\': \'彼は理由を問わない。標的、時刻、場所だけである。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556653&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b831fa70-389a-47bb-a7ab-b9e7b38712d9\', \'multiverseId\': 556653}, \'multiverseid\': 556653}, {\'name\': \'프리랜서 용병\', \'text\': \'프리랜서 용병이 공격 또는 방어할 때마다, 프리랜서 용병은 턴종료까지 +X/+X를 받는다. X는 당신이 조종하는 다른 생물들이 가진 공격력 및/또는 방어력 중 가장 높은 수다.\', \'type\': \'생물 — 코뿔소 전사\', \'flavor\': \'그는 이유를 묻는 법이 없다. 그저 누구를, 언제, 어디서만 알면 된다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556914&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'66e61633-8cd8-4ddd-97ec-82cb462674f7\', \'multiverseId\': 556914}, \'multiverseid\': 556914}, {\'name\': \'Capanga Autônomo\', \'text\': \'Toda vez que Capanga Autônomo ataca ou bloqueia, ele recebe +X/+X até o final do turno, sendo X o maior poder e/ou resistência entre os das outras criaturas que você controla.\', \'type\': \'Criatura — Rinoceronte Guerreiro\', \'flavor\': \'Ele nunca pergunta por quê. Só pergunta quem, quando e onde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557175&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7685e67b-efe9-4d8f-bc06-44a1a31d07c8\', \'multiverseId\': 557175}, \'multiverseid\': 557175}, {\'name\': \'Боец по Найму\', \'text\': \'Каждый раз, когда Боец по Найму атакует или блокирует, он получает +X/+X до конца хода, где Х — наибольшее значение силы и/или выносливости среди других существ под вашим контролем.\', \'type\': \'Существо — Носорог Воин\', \'flavor\': \'Он никогда не спрашивает зачем. Только кого, когда и где.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557436&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c865857a-aa73-4d2d-83d1-567b456eb194\', \'multiverseId\': 557436}, \'multiverseid\': 557436}, {\'name\': \'包工打手\', \'text\': \'每当包工打手进行攻击或阻挡时，它得+X/+X直到回合结束，X为由你操控之其他生物中的最大力量和／或防御力。\', \'type\': \'生物 ～犀牛／战士\', \'flavor\': \'他从不问原因。只问目标，时间和地点。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557697&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1a9e5f78-f52a-4a73-b936-7b8d655867bb\', \'multiverseId\': 557697}, \'multiverseid\': 557697}, {\'name\': \'包工打手\', \'text\': \'每當包工打手進行攻擊或阻擋時，它得+X/+X直到回合結束，X為由你操控之其他生物中的最大力量和／或防禦力。\', \'type\': \'生物 ～犀牛／戰士\', \'flavor\': \'他從不問原因。只問目標，時間和地點。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557958&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5f36a951-53f1-4149-892f-291d886dcbd3\', \'multiverseId\': 557958}, \'multiverseid\': 557958}]', '[{\'name\': \'Friedhofs-Pfuscherei\', \'text\': \'Refugium 5 (Wenn diese Verzauberung ins Spiel kommt, schaue dir die obersten fünf Karten deiner Bibliothek an, schicke eine davon verdeckt ins Exil und lege dann den Rest in zufälliger Reihenfolge unter deine Bibliothek.)\\nZu Beginn deines Versorgungssegments kannst du drei Karten millen. Falls dann zwanzig oder mehr Karten in deinem Friedhof sind, kannst du die ins Exil geschickte Karte spielen, ohne ihre Manakosten zu bezahlen.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555531&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1b07b456-f3ca-4571-b03e-32a1ff1d32ce\', \'multiverseId\': 555531}, \'multiverseid\': 555531}, {\'name\': \'Profanar el cementerio\', \'text\': \'Esconder 5. (Cuando este encantamiento entre al campo de batalla, mira las cinco primeras cartas de tu biblioteca, exilia una boca abajo y luego pon el resto en el fondo en un orden aleatorio.)\\nAl comienzo de tu mantenimiento, puedes moler tres cartas. Luego, si hay veinte o más cartas en tu cementerio, puedes jugar la carta exiliada sin pagar su coste de maná.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555792&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'abd9ceac-9158-4060-99f2-b7abd0ba4533\', \'multiverseId\': 555792}, \'multiverseid\': 555792}, {\'name\': \'Altération de cimetière\', \'text\': "Cachette 5 (Quand cet enchantement arrive sur le champ de bataille, regardez les cinq cartes du dessus de votre bibliothèque, exilez-en une face cachée, puis mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.)\\nAu début de votre entretien, vous pouvez meuler trois cartes. Puis, s\'il y a au moins vingt cartes dans votre cimetière, vous pouvez jouer la carte exilée sans payer son coût de mana.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556053&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a3f1c59f-56ea-4203-99fb-06ddac3c956c\', \'multiverseId\': 556053}, \'multiverseid\': 556053}, {\'name\': \'Manomissione Tombale\', \'text\': "Nascondiglio 5 (Quando questo incantesimo entra nel campo di battaglia, guarda le prime cinque carte del tuo grimorio, esiliane una a faccia in giù, poi metti le altre in fondo in ordine casuale.)\\nAll\'inizio del tuo mantenimento, puoi macinare tre carte. Poi, se ci sono venti o più carte nel tuo cimitero, puoi giocare la carta esiliata senza pagare il suo costo di mana.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556314&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'38579255-6bd5-4f1f-abd3-bbd7bcd366e6\', \'multiverseId\': 556314}, \'multiverseid\': 556314}, {\'name\': \'墓所細工\', \'text\': \'秘匿５（このエンチャントが戦場に出たとき、あなたのライブラリーの一番上にあるカード５枚を見て、そのうち１枚を裏向きに追放し、その後残りを一番下に無作為の順番で置く。）\\nあなたのアップキープの開始時に、あなたはカード３枚を切削してもよい。その後、あなたの墓地に20枚以上のカードがあるなら、あなたはマナ・コストを支払うことなくその追放されているカード１枚をプレイしてもよい。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556575&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'96350d5c-4cfa-4ef2-9b32-ded72486c815\', \'multiverseId\': 556575}, \'multiverseid\': 556575}, {\'name\': \'묘지 변조\', \'text\': \'은닉 5 (이 부여마법이 전장에 들어올 때, 당신의 서고 맨 위 카드 다섯 장을 보고, 한 장을 뒷면 상태로 추방한 후, 나머지를 서고 맨 밑에 무작위 순서로 놓는다.)\\n당신의 유지단 시작에, 당신은 카드 세 장을 밀 수 있다. 그 후 당신의 무덤에 카드가 스무 장 이상 있다면, 당신은 추방된 카드의 마나 비용을 지불하지 않고 그 카드를 플레이할 수 있다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556836&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5c458547-ed2e-4920-aad8-4b7aeebf6493\', \'multiverseId\': 556836}, \'multiverseid\': 556836}, {\'name\': \'Manipulação no Cemitério\', \'text\': \'Refúgio 5 (Quando este encantamento entrar no campo de batalha, olhe os cinco cards do topo de seu grimório, exile um com a face voltada para baixo e depois coloque o restante no fundo em ordem aleatória.)\\nNo início de sua manutenção, você pode triturar três cards. Depois, se houver vinte ou mais cards em seu cemitério, você pode jogar o card exilado sem pagar seu custo de mana.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557097&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'58aa1529-187e-47cd-a01b-b8952e1909c2\', \'multiverseId\': 557097}, \'multiverseid\': 557097}, {\'name\': \'Махинации на Кладбище\', \'text\': \'Укрытие 5 (Когда эти чары выходят на поле битвы, посмотрите пять верхних карт вашей библиотеки, изгоните одну рубашкой вверх, затем положите остальные в низ библиотеки в случайном порядке.)\\nВ начале вашего шага поддержки вы можете скрутить три карты. Затем, если у вас на кладбище не менее двадцати карт, вы можете разыграть изгнанную карту без уплаты ее мана-стоимости.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557358&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2e1a9ef3-2daf-4f9c-b812-86b5647a9945\', \'multiverseId\': 557358}, \'multiverseid\': 557358}, {\'name\': \'擅挖墓地\', \'text\': \'掩蔽5（当此结界进战场时，检视你牌库顶的五张牌，将其中一张牌面朝下地放逐，然后将其余的牌以随机顺序置于牌库底。）\\n在你的维持开始时，你可以磨三张牌。然后如果你坟墓场中有二十张或更多牌，则你可以使用所放逐的牌，且不需支付其法术力费用。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557619&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'92de94ea-227c-4027-9ce9-3a3f002014c3\', \'multiverseId\': 557619}, \'multiverseid\': 557619}, {\'name\': \'擅挖墓地\', \'text\': \'掩蔽5（當此結界進戰場時，檢視你牌庫頂的五張牌，將其中一張牌面朝下地放逐，然後將其餘的牌以隨機順序置於牌庫底。）\\n在你的維持開始時，你可以磨三張牌。然後如果你墳墓場中有二十張或更多牌，則你可以使用所放逐的牌，且不需支付其魔法力費用。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557880&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'dd32e7c2-d544-41c9-936d-9c97e3bcdecd\', \'multiverseId\': 557880}, \'multiverseid\': 557880}]', '[{\'name\': \'Friedhofs-Pfuscherei\', \'text\': \'Refugium 5\\nZu Beginn deines Versorgungssegments kannst du drei Karten millen. Falls dann zwanzig oder mehr Karten in deinem Friedhof sind, kannst du die ins Exil geschickte Karte spielen, ohne ihre Manakosten zu bezahlen.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558291&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'969352b1-6d94-4771-b939-13f0f0a9590d\', \'multiverseId\': 558291}, \'multiverseid\': 558291}, {\'name\': \'Altération de cimetière\', \'text\': "Cachette 5\\nAu début de votre entretien, vous pouvez meuler trois cartes. Puis, s\'il y a au moins vingt cartes dans votre cimetière, vous pouvez jouer la carte exilée sans payer son coût de mana.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558326&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'527b20ce-5924-4472-b450-c654b7376209\', \'multiverseId\': 558326}, \'multiverseid\': 558326}, {\'name\': \'墓所細工\', \'text\': \'秘匿５\\nあなたのアップキープの開始時に、あなたはカード３枚を切削してもよい。その後、あなたの墓地に20枚以上のカードがあるなら、あなたはマナ・コストを支払うことなくその追放されているカード１枚をプレイしてもよい。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558361&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1e1fd0af-5f72-481d-ba47-0e7a8fa44ddb\', \'multiverseId\': 558361}, \'multiverseid\': 558361}, {\'name\': \'擅挖墓地\', \'text\': \'掩蔽5\\n在你的维持开始时，你可以磨三张牌。然后如果你坟墓场中有二十张或更多牌，则你可以使用所放逐的牌，且不需支付其法术力费用。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558396&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'93317155-b0d2-4945-896d-a9e83cc88185\', \'multiverseId\': 558396}, \'multiverseid\': 558396}]', '[{\'name\': \'Friedhofsdienst\', \'text\': \'Dieser Zauberspruch hat Aufblitzen, solange sich in deinem Friedhof Karten mit fünf oder mehr unterschiedlichen Manabeträgen befinden.\\nBringe eine Kreaturenkarte deiner Wahl aus deinem Friedhof ins Spiel zurück.\', \'type\': \'Hexerei\', \'flavor\': \'„Auf und ran, Kumpel. Wir haben noch viel Arbeit zu erledigen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555543&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fe4dbafe-5bc5-46eb-8609-4c1db474deb7\', \'multiverseId\': 555543}, \'multiverseid\': 555543}, {\'name\': \'Turno en el cementerio\', \'text\': \'Este hechizo tiene la habilidad de destello mientras haya cinco o más valores de maná entre las cartas de tu cementerio.\\nRegresa la carta de criatura objetivo de tu cementerio al campo de batalla.\', \'type\': \'Conjuro\', \'flavor\': \'"En marcha, compañero. Queda mucho trabajo por hacer".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555804&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a6339abc-b695-4336-bf88-a912fed597a6\', \'multiverseId\': 555804}, \'multiverseid\': 555804}, {\'name\': \'Quart de nuit\', \'text\': "Ce sort a le flash tant qu\'il y a au moins cinq valeurs de mana parmi les cartes de votre cimetière.\\nRenvoyez une carte de créature ciblée sur le champ de bataille depuis votre cimetière.", \'type\': \'Rituel\', \'flavor\': \'« On se réveille. On a encore du travail. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556065&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e6142869-5622-4d77-8563-68d282c3f968\', \'multiverseId\': 556065}, \'multiverseid\': 556065}, {\'name\': \'Morto al Lavoro\', \'text\': \'Questa magia ha lampo fintanto che ci sono cinque o più valori di mana tra le carte nel tuo cimitero.\\nRimetti sul campo di battaglia una carta creatura bersaglio dal tuo cimitero.\', \'type\': \'Stregoneria\', \'flavor\': \'"In piedi e datti da fare, amico. Abbiamo altro lavoro da sbrigare."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556326&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1b380015-4858-413e-a337-56a9d0aa34af\', \'multiverseId\': 556326}, \'multiverseid\': 556326}, {\'name\': \'墓所の変容\', \'text\': \'あなたの墓地にあるすべてのカードの中に５種類以上のマナ総量があるかぎり、この呪文は瞬速を持つ。\\nあなたの墓地にあるクリーチャー・カード１枚を対象とする。それを戦場に戻す。\', \'type\': \'ソーサリー\', \'flavor\': \'「さあさあ、とっとと起きて仕事にかかれよ。やることはたんまりあるんだからな。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556587&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9c49ada9-fee3-420d-95ff-28eb39fca553\', \'multiverseId\': 556587}, \'multiverseid\': 556587}, {\'name\': \'무덤 근무 교대\', \'text\': \'이 주문은 당신의 무덤에 있는 카드들의 마나 값이 다섯 종류 이상인 한 섬광을 가진다.\\n당신의 무덤에 있는 생물 카드를 목표로 정한다. 그 카드를 전장으로 되돌린다.\', \'type\': \'집중마법\', \'flavor\': \'"어이, 일어나라고. 할 일이 더 있어."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556848&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d149b136-efc6-494e-9946-22ef92b84bac\', \'multiverseId\': 556848}, \'multiverseid\': 556848}, {\'name\': \'Turno no Cemitério\', \'text\': \'Esta mágica terá lampejo enquanto houver cinco ou mais valores de mana diferentes entre os cards em seu cemitério.\\nDevolva o card de criatura alvo de seu cemitério para o campo de batalha.\', \'type\': \'Feitiço\', \'flavor\': \'"Vamos, colega. A gente tem mais trabalho a fazer."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557109&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'70ed5569-3c6c-42a7-8a1a-df0ee3f92d4d\', \'multiverseId\': 557109}, \'multiverseid\': 557109}, {\'name\': \'Кладбищенская Смена\', \'text\': \'У этого заклинания есть Миг, пока среди карт на вашем кладбище есть не менее пяти разных значений мановой ценности.\\nВерните целевую карту существа из вашего кладбища на поле битвы.\', \'type\': \'Волшебство\', \'flavor\': \'«Поднимайся и за дело, приятель. У нас полно работы».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557370&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e9d2192a-139a-4378-943a-52475f205438\', \'multiverseId\': 557370}, \'multiverseid\': 557370}, {\'name\': \'坟墓变幻\', \'text\': \'只要你坟墓场中牌的法术力值有五种或更多，此咒语便具有闪现异能。\\n将目标生物牌从你的坟墓场移回战场。\', \'type\': \'法术\', \'flavor\': \'「醒醒啦，兄弟。还有好多活等着我们呢。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557631&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'62e3065f-a18c-4c25-bd3e-c3763ed9dd1f\', \'multiverseId\': 557631}, \'multiverseid\': 557631}, {\'name\': \'墳墓變幻\', \'text\': \'只要你墳墓場中牌的魔法力值有五種或更多，此咒語便具有閃現異能。\\n將目標生物牌從你的墳墓場移回戰場。\', \'type\': \'巫術\', \'flavor\': \'「醒醒啦，兄弟。還有好多活等著我們呢。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557892&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0d815170-2f66-4ad4-9b89-bdb813e183cb\', \'multiverseId\': 557892}, \'multiverseid\': 557892}]', '[{\'name\': \'Für die Familie\', \'text\': \'Eine Kreatur deiner Wahl erhält +2/+2 bis zum Ende des Zuges. Falls du vier oder mehr Kreaturen kontrollierst, erhält die Kreatur stattdessen +4/+4 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'Die Cabaretti pflegen ein Bild von harmlosem Hedonismus und sind froh, wenn die anderen Familien ihre enorme Feuerkraft unterschätzen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555608&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8b4a5cb5-3b27-468d-b867-d62f84b935bd\', \'multiverseId\': 555608}, \'multiverseid\': 555608}, {\'name\': \'Por la familia\', \'text\': \'La criatura objetivo obtiene +2/+2 hasta el final del turno. Si controlas cuatro o más criaturas, en vez de eso, esa criatura obtiene +4/+4 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'Los Cabaretti transmiten una imagen de hedonismo inofensivo y celebran que las demás familias subestimen su increíble potencia de fuego.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555869&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6358a0a2-f647-4bc2-94cd-62cfc51a5bfe\', \'multiverseId\': 555869}, \'multiverseid\': 555869}, {\'name\': \'Pour la famille\', \'text\': "Une créature ciblée gagne +2/+2 jusqu\'à la fin du tour. Si vous contrôlez au moins quatre créatures, cette créature gagne +4/+4 jusqu\'à la fin du tour à la place.", \'type\': \'Éphémère\', \'flavor\': "Les Cabaretti cultivent une image d\'hédonistes inoffensifs, ravis que les autres familles sous-estiment leur redoutable puissance de feu.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556130&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f7168b73-6b86-4135-8b7d-fb19de8bf69d\', \'multiverseId\': 556130}, \'multiverseid\': 556130}, {\'name\': \'Per la Famiglia\', \'text\': \'Una creatura bersaglio prende +2/+2 fino alla fine del turno. Se controlli quattro o più creature, quella creatura prende invece +4/+4 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': "I Cabaretti coltivano un\'immagine di innocuo edonismo, felici che le altre famiglie sottovalutino la loro formidabile potenza di fuoco.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556391&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'59d8776e-20c7-47a3-aa10-6008afc03dfe\', \'multiverseId\': 556391}, \'multiverseid\': 556391}, {\'name\': \'一家のために\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋２/＋２の修整を受ける。あなたが４体以上のクリーチャーをコントロールしているなら、代わりに、ターン終了時まで、それは＋４/＋４の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'舞台座一家は無害な快楽主義のイメージが強く、他の一家が自分たちの恐るべき火力を見くびっていることを良しとしている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556652&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1964497f-b145-4514-b4cc-3d52a06fc89f\', \'multiverseId\': 556652}, \'multiverseid\': 556652}, {\'name\': \'패밀리를 위해\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 +2/+2를 받는다. 당신이 생물을 네 개 이상 조종한다면, 대신 그 생물은 턴종료까지 +4/+4를 받는다.\', \'type\': \'순간마법\', \'flavor\': \'카바레티는 무해한 쾌락주의의 이미지를 구축해 나갔고, 다른 패밀리들이 그들의 무시무시한 화력을 과소평가하는 것을 기뻐했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556913&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8a4318b4-689a-427a-9f0c-14e5855e8189\', \'multiverseId\': 556913}, \'multiverseid\': 556913}, {\'name\': \'Pela Família\', \'text\': \'A criatura alvo recebe +2/+2 até o final do turno. Se você controla quatro ou mais criaturas, em vez disso, aquela criatura recebe +4/+4 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os Cabaretti cultivam uma imagem de hedonismo inofensivo, levando propositalmente as outras famílias a subestimarem seu formidável poder de fogo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557174&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e47a7149-f741-4e53-94b9-e391dfdf2d91\', \'multiverseId\': 557174}, \'multiverseid\': 557174}, {\'name\': \'Ради Семьи\', \'text\': \'Целевое существо получает +2/+2 до конца хода. Если вы контролируете не менее четырех существ, вместо этого то существо получает +4/+4 до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Кабаретти насаждают образ безобидного гедонизма, с радостью позволяя другим семьям недооценивать их грозную огневую мощь.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557435&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'344b5c49-d403-452d-9f65-2c87a98fcef2\', \'multiverseId\': 557435}, \'multiverseid\': 557435}, {\'name\': \'为了家族\', \'text\': \'目标生物得+2/+2直到回合结束。如果你操控四个或更多生物，则改为该生物得+4/+4直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'乐舞会披着毫无威胁的贪欢客形象，甘心让其他四家低估自己威猛的火力。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557696&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c8a7619d-be83-4b8e-bf03-8c84eb3b1790\', \'multiverseId\': 557696}, \'multiverseid\': 557696}, {\'name\': \'為了家族\', \'text\': \'目標生物得+2/+2直到回合結束。如果你操控四個或更多生物，則改為該生物得+4/+4直到回合結束。\', \'type\': \'瞬間\', \'flavor\': \'樂舞會披著毫無威脅的貪歡客形象，甘心讓其他四家低估自己威猛的火力。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557957&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'51422fd4-858c-4963-adb5-8c22d62d885a\', \'multiverseId\': 557957}, \'multiverseid\': 557957}]', '[{\'name\': \'Fürst Xander, der Sammler\', \'text\': \'Wenn Fürst Xander, der Sammler, ins Spiel kommt, wirft ein Gegner deiner Wahl die Hälfte der Karten auf seiner Hand, abgerundet, ab.\\nImmer wenn Fürst Xander angreift, millt der verteidigende Spieler die Hälfte seiner Bibliothek, abgerundet.\\nWenn Fürst Xander stirbt, opfert ein Gegner deiner Wahl die Hälfte der bleibenden Karten, die keine Länder sind und die er kontrolliert, abgerundet.\', \'type\': \'Legendäre Kreatur — Vampir, Dämon, Adliger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555659&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cf8dc3b7-dad7-40b7-861d-04ce274f45e6\', \'multiverseId\': 555659}, \'multiverseid\': 555659}, {\'name\': \'Don Xander, el Coleccionista\', \'text\': \'Cuando Don Xander, el Coleccionista entre al campo de batalla, el oponente objetivo descarta la mitad de las cartas de su mano, redondeando hacia abajo.\\nSiempre que Don Xander ataque, el jugador defensor muele la mitad de su biblioteca, redondeando hacia abajo.\\nCuando Don Xander muera, el oponente objetivo sacrifica la mitad de los permanentes que no sean tierra que controla, redondeando hacia abajo.\', \'type\': \'Criatura legendaria — Noble demonio vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555920&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'554bb871-d67f-4802-8023-295845b129f6\', \'multiverseId\': 555920}, \'multiverseid\': 555920}, {\'name\': \'Seigneur Xander, le collectionneur\', \'text\': "Quand le Seigneur Xander, le collectionneur arrive sur le champ de bataille, un adversaire ciblé se défausse de la moitié des cartes de sa main, arrondie à l\'unité inférieure.\\nÀ chaque fois que le Seigneur Xander attaque, le joueur défenseur meule la moitié de sa bibliothèque, arrondie à l\'unité inférieure.\\nQuand le Seigneur Xander meurt, un adversaire ciblé sacrifie la moitié des permanents non-terrain qu\'il contrôle, arrondie à l\'unité inférieure.", \'type\': \'Créature légendaire : vampire et démon et noble\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556181&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'99ce63d2-ae75-4cd7-a057-9670bd869ba2\', \'multiverseId\': 556181}, \'multiverseid\': 556181}, {\'name\': \'Lord Xander, il Collezionista\', \'text\': \'Quando Lord Xander, il Collezionista entra nel campo di battaglia, un avversario bersaglio scarta metà delle carte nella sua mano, arrotondata per difetto.\\nOgniqualvolta Lord Xander attacca, il giocatore in difesa macina metà del suo grimorio, arrotondata per difetto.\\nQuando Lord Xander muore, un avversario bersaglio sacrifica metà dei permanenti non terra che controlla, arrotondata per difetto.\', \'type\': \'Creatura Leggendaria — Nobile Demone Vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556442&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'51828d4e-fbff-47ec-a451-5818324a4176\', \'multiverseId\': 556442}, \'multiverseid\': 556442}, {\'name\': \'蒐集家、ザンダー卿\', \'text\': \'蒐集家、ザンダー卿が戦場に出たとき、対戦相手１人を対象とする。そのプレイヤーは自分の手札にあるカードの枚数の端数を切り捨てた半分の枚数のカードを捨てる。\\n蒐集家、ザンダー卿が攻撃するたび、防御プレイヤーは自分のライブラリーにあるカードの枚数の端数を切り捨てた半分の枚数のカードを切削する。\\n蒐集家、ザンダー卿が死亡したとき、対戦相手１人を対象とする。そのプレイヤーは自分がコントロールしていて土地でないパーマネントの数の端数を切り捨てた半分の数の土地でないパーマネントを生け贄に捧げる。\', \'type\': \'伝説のクリーチャー — 吸血鬼・デーモン・貴族\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556703&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5988d21c-d5b3-49ed-b85d-ea7a96189b3d\', \'multiverseId\': 556703}, \'multiverseid\': 556703}, {\'name\': \'수집가, 잰더 경\', \'text\': \'수집가, 잰더 경이 전장에 들어올 때, 상대를 목표로 정한다. 그 상대는 자신의 손에 있는 카드의 절반을 내림해 버린다.\\n잰더 경이 공격할 때마다, 수비플레이어는 자신의 서고 절반을 내림해 민다.\\n잰더 경이 죽을 때, 상대를 목표로 정한다. 그 플레이어는 자신이 조종하며 대지가 아닌 지속물의 절반을 내림해 희생한다.\', \'type\': \'전설적 생물 — 흡혈귀 악마 귀족\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556964&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'445b2bb1-e791-4292-a213-ec7f9c08ef7b\', \'multiverseId\': 556964}, \'multiverseid\': 556964}, {\'name\': \'Don Xander, o Colecionador\', \'text\': \'Quando Don Xander, o Colecionador, entra no campo de batalha, o oponente alvo descarta metade dos cards da própria mão, arredondada para baixo.\\nToda vez que Don Xander ataca, o jogador defensor tritura metade do próprio grimório, arredondada para baixo.\\nQuando Don Xander morre, o oponente alvo sacrifica metade das permanentes não de terreno que ele controla, arredondada para baixo.\', \'type\': \'Criatura Lendária — Vampiro Demônio Nobre\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557225&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1580ffab-21d5-46f7-8217-54f0d54a63f0\', \'multiverseId\': 557225}, \'multiverseid\': 557225}, {\'name\': \'Лорд Зандер, Коллекционер\', \'text\': \'Когда Лорд Зандер, Коллекционер выходит на поле битвы, целевой оппонент сбрасывает половину карт из своей руки с округлением в меньшую сторону.\\nКаждый раз, когда Лорд Зандер атакует, защищающийся игрок скручивает половину своей библиотеки с округлением в меньшую сторону.\\nКогда Лорд Зандер умирает, целевой оппонент жертвует половину не являющихся землями перманентов под своим контролем с округлением в меньшую сторону.\', \'type\': \'Легендарное Существо — Вампир Демон Аристократ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557486&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5790ba91-7826-46b0-8c8c-e9af1c3f08da\', \'multiverseId\': 557486}, \'multiverseid\': 557486}, {\'name\': \'收集魔尚夺尔勋爵\', \'text\': \'当收集魔尚夺尔勋爵进战场时，目标对手弃一半数量的手牌，小数点后舍去。\\n每当尚夺尔勋爵攻击时，防御牌手磨其牌库一半数量的牌，小数点后舍去。\\n当尚夺尔勋爵死去时，目标对手牺牲一半数量由其操控的非地永久物，小数点后舍去。\', \'type\': \'传奇生物 ～吸血鬼／恶魔／贵族\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557747&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d6a79dae-f527-4067-9cc2-db7524769cbe\', \'multiverseId\': 557747}, \'multiverseid\': 557747}, {\'name\': \'收集魔尚奪爾勳爵\', \'text\': \'當收集魔尚奪爾勳爵進戰場時，目標對手棄一半數量的手牌，小數點後捨去。\\n每當尚奪爾勳爵攻擊時，防禦玩家磨其牌庫一半數量的牌，小數點後捨去。\\n當尚奪爾勳爵死去時，目標對手犧牲一半數量由其操控的非地永久物，小數點後捨去。\', \'type\': \'傳奇生物 ～吸血鬼／惡魔／貴族\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558008&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'99f8fa6e-3b87-430e-9503-2de573501452\', \'multiverseId\': 558008}, \'multiverseid\': 558008}]', '[{\'name\': \'Fürst Xander, der Sammler\', \'text\': \'Wenn Fürst Xander, der Sammler, ins Spiel kommt, wirft ein Gegner deiner Wahl die Hälfte der Karten auf seiner Hand, abgerundet, ab.\\nImmer wenn Fürst Xander angreift, millt der verteidigende Spieler die Hälfte seiner Bibliothek, abgerundet.\\nWenn Fürst Xander stirbt, opfert ein Gegner deiner Wahl die Hälfte der bleibenden Karten, die keine Länder sind und die er kontrolliert, abgerundet.\', \'type\': \'Legendäre Kreatur — Vampir, Dämon, Adliger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558758&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'251bdfdd-6e70-4aeb-887f-fc77362193ea\', \'multiverseId\': 558758}, \'multiverseid\': 558758}, {\'name\': \'Don Xander, el Coleccionista\', \'text\': \'Cuando Don Xander, el Coleccionista entre al campo de batalla, el oponente objetivo descarta la mitad de las cartas de su mano, redondeando hacia abajo.\\nSiempre que Don Xander ataque, el jugador defensor muele la mitad de su biblioteca, redondeando hacia abajo.\\nCuando Don Xander muera, el oponente objetivo sacrifica la mitad de los permanentes que no sean tierra que controla, redondeando hacia abajo.\', \'type\': \'Criatura legendaria — Noble demonio vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558803&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'594d5d67-94a9-483a-a7ce-6817c9cea73f\', \'multiverseId\': 558803}, \'multiverseid\': 558803}, {\'name\': \'Seigneur Xander, le collectionneur\', \'text\': "Quand le Seigneur Xander, le collectionneur arrive sur le champ de bataille, un adversaire ciblé se défausse de la moitié des cartes de sa main, arrondie à l\'unité inférieure.\\nÀ chaque fois que le Seigneur Xander attaque, le joueur défenseur meule la moitié de sa bibliothèque, arrondie à l\'unité inférieure.\\nQuand le Seigneur Xander meurt, un adversaire ciblé sacrifie la moitié des permanents non-terrain qu\'il contrôle, arrondie à l\'unité inférieure.", \'type\': \'Créature légendaire : vampire et démon et noble\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558848&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6829bf7f-e040-47a2-8531-a28692444605\', \'multiverseId\': 558848}, \'multiverseid\': 558848}, {\'name\': \'Lord Xander, il Collezionista\', \'text\': \'Quando Lord Xander, il Collezionista entra nel campo di battaglia, un avversario bersaglio scarta metà delle carte nella sua mano, arrotondata per difetto.\\nOgniqualvolta Lord Xander attacca, il giocatore in difesa macina metà del suo grimorio, arrotondata per difetto.\\nQuando Lord Xander muore, un avversario bersaglio sacrifica metà dei permanenti non terra che controlla, arrotondata per difetto.\', \'type\': \'Creatura Leggendaria — Nobile Demone Vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558893&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dc8461bd-9ad7-49c9-8ffe-2bcdb2db44d8\', \'multiverseId\': 558893}, \'multiverseid\': 558893}, {\'name\': \'蒐集家、ザンダー卿\', \'text\': \'蒐集家、ザンダー卿が戦場に出たとき、対戦相手１人を対象とする。そのプレイヤーは自分の手札にあるカードの枚数の端数を切り捨てた半分の枚数のカードを捨てる。\\n蒐集家、ザンダー卿が攻撃するたび、防御プレイヤーは自分のライブラリーにあるカードの枚数の端数を切り捨てた半分の枚数のカードを切削する。\\n蒐集家、ザンダー卿が死亡したとき、対戦相手１人を対象とする。そのプレイヤーは自分がコントロールしていて土地でないパーマネントの数の端数を切り捨てた半分の数の、土地でないパーマネントを生け贄に捧げる。\', \'type\': \'伝説のクリーチャー — 吸血鬼・デーモン・貴族\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558938&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a10f4ba9-de41-4751-af17-08a7886774c9\', \'multiverseId\': 558938}, \'multiverseid\': 558938}, {\'name\': \'수집가, 잰더 경\', \'text\': \'수집가, 잰더 경이 전장에 들어올 때, 상대를 목표로 정한다. 그 상대는 자신의 손에 있는 카드의 절반을 내림해 버린다.\\n잰더 경이 공격할 때마다, 수비플레이어는 자신의 서고 절반을 내림해 민다.\\n잰더 경이 죽을 때, 상대를 목표로 정한다. 그 플레이어는 자신이 조종하며 대지가 아닌 지속물의 절반을 내림해 희생한다.\', \'type\': \'전설적 생물 — 흡혈귀 악마 귀족\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558983&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8bba87b8-2650-43f8-8bcc-74727f918db1\', \'multiverseId\': 558983}, \'multiverseid\': 558983}, {\'name\': \'Don Xander, o Colecionador\', \'text\': \'Quando Don Xander, o Colecionador, entra no campo de batalha, o oponente alvo descarta metade dos cards da própria mão, arredondada para baixo.\\nToda vez que Don Xander ataca, o jogador defensor tritura metade do próprio grimório, arredondada para baixo.\\nQuando Don Xander morre, o oponente alvo sacrifica metade das permanentes não de terreno que ele controla, arredondada para baixo.\', \'type\': \'Criatura Lendária — Vampiro Demônio Nobre\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559028&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a2c7cd0e-a599-4c2c-8f60-8227cc753b37\', \'multiverseId\': 559028}, \'multiverseid\': 559028}, {\'name\': \'Лорд Зандер, Коллекционер\', \'text\': \'Когда Лорд Зандер, Коллекционер выходит на поле битвы, целевой оппонент сбрасывает половину карт из своей руки с округлением в меньшую сторону.\\nКаждый раз, когда Лорд Зандер атакует, защищающийся игрок скручивает половину своей библиотеки с округлением в меньшую сторону.\\nКогда Лорд Зандер умирает, целевой оппонент жертвует половину не являющихся землями перманентов под своим контролем с округлением в меньшую сторону.\', \'type\': \'Легендарное Существо — Вампир Демон Аристократ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559073&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9ffecc46-de85-439a-9d52-50c8db0e0e64\', \'multiverseId\': 559073}, \'multiverseid\': 559073}, {\'name\': \'收集魔尚夺尔勋爵\', \'text\': \'当收集魔尚夺尔勋爵进战场时，目标对手弃一半数量的手牌，小数点后舍去。\\n每当尚夺尔勋爵攻击时，防御牌手磨其牌库一半数量的牌，小数点后舍去。\\n当尚夺尔勋爵死去时，目标对手牺牲一半数量由其操控的非地永久物，小数点后舍去。\', \'type\': \'传奇生物 ～吸血鬼／恶魔／贵族\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559118&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e973e1e2-fbd0-4287-a621-f3223ffafc9c\', \'multiverseId\': 559118}, \'multiverseid\': 559118}, {\'name\': \'收集魔尚奪爾勳爵\', \'text\': \'當收集魔尚奪爾勳爵進戰場時，目標對手棄一半數量的手牌，小數點後捨去。\\n每當尚奪爾勳爵攻擊時，防禦玩家磨其牌庫一半數量的牌，小數點後捨去。\\n當尚奪爾勳爵死去時，目標對手犧牲一半數量由其操控的非地永久物，小數點後捨去。\', \'type\': \'傳奇生物 ～吸血鬼／惡魔／貴族\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559163&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0ab50fff-caec-44ae-998b-9c1f69bbc4d9\', \'multiverseId\': 559163}, \'multiverseid\': 559163}]', "[{'name': 'Gala-Begrüßer', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558109&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c5f7c23b-3091-4b13-9209-0d8d23301027', 'multiverseId': 558109}, 'multiverseid': 558109}]", '[{\'name\': \'Gala-Begrüßer\', \'text\': \'Allianz — Immer wenn eine andere Kreatur unter deiner Kontrolle ins Spiel kommt, bestimme eines, das in diesem Zug noch nicht bestimmt wurde —\\n• Lege eine +1/+1-Marke auf die Gala-Begrüßer.\\n• Erzeuge einen getappten Schatz-Spielstein.\\n• Du erhältst 2 Lebenspunkte dazu.\', \'type\': \'Kreatur — Elf, Druide\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555610&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'163056f2-7453-4eb2-88a3-0c76fb95a29a\', \'multiverseId\': 555610}, \'multiverseid\': 555610}, {\'name\': \'Saludadores de la gala\', \'text\': \'Asociación — Siempre que otra criatura entre al campo de batalla bajo tu control, elige uno que no haya sido elegido este turno:\\n• Pon un contador +1/+1 sobre los Saludadores de la gala.\\n• Crea una ficha de Tesoro girada.\\n• Ganas 2 vidas.\', \'type\': \'Criatura — Druida elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555871&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0363ea0f-13b4-473f-842a-f1f1a2100a10\', \'multiverseId\': 555871}, \'multiverseid\': 555871}, {\'name\': "Personnel d\'accueil du gala", \'text\': "Alliance — À chaque fois qu\'une autre créature arrive sur le champ de bataille sous votre contrôle, choisissez l\'un qui n\'a pas encore été choisi ce tour-ci —\\n• Mettez un marqueur +1/+1 sur le Personnel d\'accueil du gala.\\n• Créez un jeton Trésor engagé.\\n• Vous gagnez 2 points de vie.", \'type\': \'Créature : elfe et druide\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556132&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7bf112a8-aa5b-4028-a2e5-857ac518679e\', \'multiverseId\': 556132}, \'multiverseid\': 556132}, {\'name\': \'Comitato di Benvenuto al Galà\', \'text\': "Alleanza — Ogniqualvolta un\'altra creatura entra nel campo di battaglia sotto il tuo controllo, scegli uno che non è stato scelto in questo turno —\\n• Metti un segnalino +1/+1 sul Comitato di Benvenuto al Galà.\\n• Crea una pedina Tesoro TAPpata.\\n• Guadagni 2 punti vita.", \'type\': \'Creatura — Druido Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556393&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'635cca9a-b525-41b0-b94c-fdc01bae3160\', \'multiverseId\': 556393}, \'multiverseid\': 556393}, {\'name\': \'祝祭の出迎え\', \'text\': \'団結 ― これでないクリーチャー１体があなたのコントロール下で戦場に出るたび、以下からこのターンにまだ選ばれていない１つを選ぶ。\\n• 祝祭の出迎えの上に＋１/＋１カウンター１個を置く。\\n• 宝物・トークン１つをタップ状態で生成する。\\n• あなたは２点のライフを得る。\', \'type\': \'クリーチャー — エルフ・ドルイド\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556654&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0ba6241b-b431-4617-983a-4adb4e28e61c\', \'multiverseId\': 556654}, \'multiverseid\': 556654}, {\'name\': \'행사 손님맞이꾼\', \'text\': \'연대 — 다른 생물이 당신의 조종하에 전장에 들어올 때마다, 이 턴에 아직 선택되지 않은 하나를 선택한다 —\\n• 행사 손님맞이꾼에 +1/+1 카운터 한 개를 올려놓는다.\\n• 탭된 상태인 보물 토큰 한 개를 만든다.\\n• 당신은 생명 2점을 얻는다.\', \'type\': \'생물 — 엘프 드루이드\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556915&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6dd0ea30-2ffd-4cb2-b3e8-fbdcc8c7a28c\', \'multiverseId\': 556915}, \'multiverseid\': 556915}, {\'name\': \'Recepcionistas do Baile\', \'text\': \'Aliança — Toda vez que outra criatura entrar no campo de batalha sob seu controle, escolha um que não tenha sido escolhido neste turno —\\n• Coloque um marcador +1/+1 em Recepcionistas do Baile.\\n• Crie uma ficha de Tesouro virada.\\n• Você ganha 2 pontos de vida.\', \'type\': \'Criatura — Elfo Druida\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557176&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9c9033a5-78df-4169-984b-7f0437cf9937\', \'multiverseId\': 557176}, \'multiverseid\': 557176}, {\'name\': \'Встречающие на Торжестве\', \'text\': \'Альянс — Каждый раз, когда другое существо выходит на поле битвы под вашим контролем, выберите одно из того, что еще не было выбрано в этом ходу —\\n• Положите один жетон +1/+1 на Встречающих на Торжестве.\\n• Создайте одну повернутую фишку Клада.\\n• Вы получаете 2 жизни.\', \'type\': \'Существо — Эльф Друид\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557437&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'15e83332-4dba-4363-8af5-13b357cb147f\', \'multiverseId\': 557437}, \'multiverseid\': 557437}, {\'name\': \'晚会招待\', \'text\': \'联手～每当另一个生物在你的操控下进战场时，选择一项，且不得是本回合中此前选过的～\\n•在晚会招待上放置一个+1/+1指示物。\\n•派出一个已横置的珍宝衍生物。\\n•你获得2点生命。\', \'type\': \'生物 ～妖精／德鲁伊\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557698&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f19de4bb-3d09-4ee2-9fe2-5b5a10215c23\', \'multiverseId\': 557698}, \'multiverseid\': 557698}, {\'name\': \'晚會招待\', \'text\': \'聯手～每當另一個生物在你的操控下進戰場時，選擇一項，且不得是本回合中此前選過的～\\n•在晚會招待上放置一個+1/+1指示物。\\n•派出一個已橫置的珍寶衍生物。\\n•你獲得2點生命。\', \'type\': \'生物 ～妖精／德魯伊\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557959&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'355fb53f-1229-493e-866a-22a0b355a168\', \'multiverseId\': 557959}, \'multiverseid\': 557959}]', '[{\'name\': \'Gala-Begrüßer\', \'text\': \'Allianz — Immer wenn eine andere Kreatur unter deiner Kontrolle ins Spiel kommt, bestimme eines, das in diesem Zug noch nicht bestimmt wurde —\\n• Lege eine +1/+1-Marke auf die Gala-Begrüßer.\\n• Erzeuge einen getappten Schatz-Spielstein.\\n• Du erhältst 2 Lebenspunkte dazu.\', \'type\': \'Kreatur — Elf, Druide\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558304&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'625adc44-b5eb-49e6-9bd3-c5604bc77318\', \'multiverseId\': 558304}, \'multiverseid\': 558304}, {\'name\': "Personnel d\'accueil du gala", \'text\': "Alliance — À chaque fois qu\'une autre créature arrive sur le champ de bataille sous votre contrôle, choisissez l\'un qui n\'a pas encore été choisi ce tour-ci —\\n• Mettez un marqueur +1/+1 sur le Personnel d\'accueil du gala.\\n• Créez un jeton Trésor engagé.\\n• Vous gagnez 2 points de vie.", \'type\': \'Créature : elfe et druide\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558339&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5fd2c0de-ad1b-49ac-b7d5-1271ac1615bf\', \'multiverseId\': 558339}, \'multiverseid\': 558339}, {\'name\': \'祝祭の出迎え\', \'text\': \'団結 ― これでないクリーチャー１体があなたのコントロール下で戦場に出るたび、以下からこのターンにまだ選ばれていない１つを選ぶ。\\n• 祝祭の出迎えの上に＋１/＋１カウンター１個を置く。\\n• 宝物・トークン１つをタップ状態で生成する。\\n• あなたは２点のライフを得る。\', \'type\': \'クリーチャー — エルフ・ドルイド\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558374&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'be4e4e63-1098-409f-9d93-cecbf44f7493\', \'multiverseId\': 558374}, \'multiverseid\': 558374}, {\'name\': \'晚会招待\', \'text\': \'联手～每当另一个生物在你的操控下进战场时，选择一项，且不得是本回合中此前选过的～\\n•在晚会招待上放置一个+1/+1指示物。\\n•派出一个已横置的珍宝衍生物。\\n•你获得2点生命。\', \'type\': \'生物 ～妖精／德鲁伊\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558409&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f98c1725-aaea-47fe-afdf-0a3bd9dfd86f\', \'multiverseId\': 558409}, \'multiverseid\': 558409}]', '[{\'name\': \'Galerie der Gauner\', \'text\': \'Für jede Farbe bringst du bis zu eine Kreaturenkarte deiner Wahl dieser Farbe aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Hexerei\', \'flavor\': \'Zusammen hatten diese fünf jedes bekannte Verbrechen begangen und noch ein paar neue erfunden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555554&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3e70a51a-de3b-4721-8742-ab0149044868\', \'multiverseId\': 555554}, \'multiverseid\': 555554}, {\'name\': \'Galería de delincuentes\', \'text\': \'Por cada color, regresa hasta una carta de criatura objetivo de ese color de tu cementerio a tu mano.\', \'type\': \'Conjuro\', \'flavor\': \'Entre los cinco habían cometido todos los crímenes posibles e incluso habían inventado unos cuantos más.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555815&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7acdd688-1b2e-4a60-8345-c20ddd527a0e\', \'multiverseId\': 555815}, \'multiverseid\': 555815}, {\'name\': \'Collection de canailles\', \'text\': "Pour chaque couleur, renvoyez jusqu\'à une carte de créature ciblée de cette couleur depuis votre cimetière dans votre main.", \'type\': \'Rituel\', \'flavor\': \'À eux cinq, ils ont commis tous les crimes jamais répertoriés et en ont même inventé quelques-uns.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556076&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a7c41d08-f5ab-4ce9-bafb-6cfed44688bd\', \'multiverseId\': 556076}, \'multiverseid\': 556076}, {\'name\': \'Parata di Farabutti\', \'text\': \'Per ogni colore, riprendi in mano dal tuo cimitero fino a una carta creatura bersaglio di quel colore.\', \'type\': \'Stregoneria\', \'flavor\': \'Tra tutti e cinque, avevano commesso ogni crimine possibile e ne avevano persino inventati di nuovi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556337&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'79aa58a2-940f-468f-8f4f-ac5b0c01afd1\', \'multiverseId\': 556337}, \'multiverseid\': 556337}, {\'name\': \'悪党の展示場\', \'text\': \'各色につきそれぞれ、あなたの墓地にあるその色のクリーチャー・カード最大１枚を対象とする。それらをあなたの手札に戻す。\', \'type\': \'ソーサリー\', \'flavor\': \'彼ら五人で、本に書かれたすべての犯罪を犯し、いくつか新しいものも発明した。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556598&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7a0df8a4-7c41-45b4-8fd0-beaa88ce4388\', \'multiverseId\': 556598}, \'multiverseid\': 556598}, {\'name\': \'범죄자 사진 대장\', \'text\': \'각 색마다, 당신의 무덤에서 그 색을 가진 생물 카드를 최대 한 장까지 목표로 정한다. 그 카드들을 당신의 손으로 되돌린다.\', \'type\': \'집중마법\', \'flavor\': \'고작 다섯 명만으로, 그들은 장부에 기록된 모든 범죄를 저질렀고 새로운 범죄도 몇 가지 만들어냈다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556859&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'25ae8729-fe72-47db-9d2d-1cd1cc77f15d\', \'multiverseId\': 556859}, \'multiverseid\': 556859}, {\'name\': \'Galeria de Ladinos\', \'text\': \'Para cada cor, devolva de seu cemitério para sua mão até um card de criatura alvo daquela cor.\', \'type\': \'Feitiço\', \'flavor\': \'Os cinco somados já haviam cometido o código penal inteiro e ainda inventado crimes novos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557120&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5e881b22-8103-49a6-88bc-1ff6bd323c67\', \'multiverseId\': 557120}, \'multiverseid\': 557120}, {\'name\': \'Галерея Плутов\', \'text\': \'Для каждого цвета верните не более одной целевой карты существа того цвета из вашего кладбища в вашу руку.\', \'type\': \'Волшебство\', \'flavor\': \'Впятером они совершили все преступления, предусмотренные законом, и придумали несколько новых.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557381&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1a5a7e1a-677d-4aa9-b8ee-95464fef6aba\', \'multiverseId\': 557381}, \'multiverseid\': 557381}, {\'name\': \'浪客聚首\', \'text\': \'对每种颜色而言，将至多一张目标该颜色的生物牌从你的坟墓场移回你手上。\', \'type\': \'法术\', \'flavor\': \'他们五位犯过世上所有的罪行，甚至新发明了几条。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557642&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e555c5b2-5a20-4aa3-a511-61fe2215d6db\', \'multiverseId\': 557642}, \'multiverseid\': 557642}, {\'name\': \'浪客聚首\', \'text\': \'對每種顏色而言，將至多一張目標該顏色的生物牌從你的墳墓場移回你手上。\', \'type\': \'巫術\', \'flavor\': \'他們五位犯過世上所有的罪行，甚至新發明了幾條。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557903&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e157ba89-4050-4908-8ca5-cfcbbabf96a1\', \'multiverseId\': 557903}, \'multiverseid\': 557903}]', "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559361&type=card', 'language': 'German', 'identifiers': {'scryfallId': '99da2448-8ba9-4092-8a48-31f6a0f33276', 'multiverseId': 559361}, 'multiverseid': 559361}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559371&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'acdbc07f-e5f8-4641-90ab-1dc7dcb704be', 'multiverseId': 559371}, 'multiverseid': 559371}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559381&type=card', 'language': 'French', 'identifiers': {'scryfallId': '97857028-d0ea-4de7-a180-3f81d367198a', 'multiverseId': 559381}, 'multiverseid': 559381}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559391&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '60ec5a90-43aa-4129-bab6-98da769100d8', 'multiverseId': 559391}, 'multiverseid': 559391}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559401&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9d0f7a6d-c750-4fed-8859-87ec1405daf0', 'multiverseId': 559401}, 'multiverseid': 559401}, {'name': '산', 'type': '기본 대지 — 산', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559411&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '41c81a4b-d1a5-41b8-81ea-4dc4adb14044', 'multiverseId': 559411}, 'multiverseid': 559411}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559421&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9c53c85b-32bf-455b-8ace-d97eb7d8138d', 'multiverseId': 559421}, 'multiverseid': 559421}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559431&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '30fb18ab-748b-46ff-b82b-c243752a7c29', 'multiverseId': 559431}, 'multiverseid': 559431}, {'name': '山脉', 'type': '基本地 ～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559441&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '22ac9e21-00ae-41b1-9366-6a7e2ae746ab', 'multiverseId': 559441}, 'multiverseid': 559441}, {'name': '山脈', 'type': '基本地 ～山脈', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559451&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '0c9fbaae-7a0c-485a-8545-19bae8a2c137', 'multiverseId': 559451}, 'multiverseid': 559451}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559362&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e0119082-a099-4ab2-9b51-f03bd02e101a', 'multiverseId': 559362}, 'multiverseid': 559362}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559372&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'de321c3f-8143-4ae4-a124-8e25357f08c0', 'multiverseId': 559372}, 'multiverseid': 559372}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559382&type=card', 'language': 'French', 'identifiers': {'scryfallId': '9b08ec59-fcdf-4ad3-86be-851b