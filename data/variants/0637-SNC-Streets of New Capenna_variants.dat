ltiverseId': 559499}, 'multiverseid': 559499}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559509&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '4e1c5a93-56cf-4f29-a62c-fd75f0aa100c', 'multiverseId': 559509}, 'multiverseid': 559509}, {'name': '늪', 'type': '기본 대지 — 늪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559519&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'bf1f8e1e-f95c-4ce2-b7ab-cba8d3ba7e0d', 'multiverseId': 559519}, 'multiverseid': 559519}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559529&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '31abe1ee-2eb2-4de0-91ef-69ba796aa0fa', 'multiverseId': 559529}, 'multiverseid': 559529}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559539&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '4ce0d232-4bd5-4b27-9822-f7bdfcbef5ea', 'multiverseId': 559539}, 'multiverseid': 559539}, {'name': '沼泽', 'type': '基本地 ～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559549&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '528bcdf0-825b-448c-af9c-92fcb0f279e0', 'multiverseId': 559549}, 'multiverseid': 559549}, {'name': '沼澤', 'type': '基本地 ～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559559&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '98cfdb6b-6282-4572-8445-4149d01e8ad0', 'multiverseId': 559559}, 'multiverseid': 559559}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559470&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c344aced-5cd6-452e-850d-65318a7d706f', 'multiverseId': 559470}, 'multiverseid': 559470}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559480&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '1a8c57f3-a787-4a32-9c9c-fb6b0ecfa79a', 'multiverseId': 559480}, 'multiverseid': 559480}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559490&type=card', 'language': 'French', 'identifiers': {'scryfallId': '6b2a107d-dbae-415b-b4a0-90a45b54672e', 'multiverseId': 559490}, 'multiverseid': 559490}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559500&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '064b86f5-7907-4818-94a5-b3976ff5b40f', 'multiverseId': 559500}, 'multiverseid': 559500}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559510&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '3d27bf9b-98b8-4419-a4ac-c8e01f53fe36', 'multiverseId': 559510}, 'multiverseid': 559510}, {'name': '늪', 'type': '기본 대지 — 늪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559520&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'dc233dfc-d931-43ca-8423-26a6c2203575', 'multiverseId': 559520}, 'multiverseid': 559520}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559530&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0db0916d-5b45-4cde-8b92-ae8cc96b2ba4', 'multiverseId': 559530}, 'multiverseid': 559530}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559540&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '22467da7-7bbd-4e37-9f93-a9a59a523348', 'multiverseId': 559540}, 'multiverseid': 559540}, {'name': '沼泽', 'type': '基本地 ～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559550&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'dbd8c95f-84af-45c3-b762-8c68c1650b79', 'multiverseId': 559550}, 'multiverseid': 559550}, {'name': '沼澤', 'type': '基本地 ～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559560&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '7a1bb996-fc3c-4cdf-bb1a-e413f569c840', 'multiverseId': 559560}, 'multiverseid': 559560}]", '[{\'name\': \'Syndikat-Infiltrator\', \'text\': \'Fliegend\\nSolange sich in deinem Friedhof Karten mit fünf oder mehr unterschiedlichen Manabeträgen befinden, erhält der Syndikat-Infiltrator +2/+2.\', \'type\': \'Kreatur — Vampir, Zauberer\', \'flavor\': \'Die Gewölbedecken des Herrenhauses bieten perfekte Deckung für einen Hinterhalt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555688&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4003995a-54ed-4b00-a734-5ffac321b88d\', \'multiverseId\': 555688}, \'multiverseid\': 555688}, {\'name\': \'Infiltrado del sindicato\', \'text\': \'Vuela.\\nMientras haya cinco o más valores de maná entre las cartas de tu cementerio, el Infiltrado del sindicato obtiene +2/+2.\', \'type\': \'Criatura — Hechicero vampiro\', \'flavor\': \'Los techos abovedados de la mansión proporcionaron el refugio idóneo para una emboscada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555949&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'62c826d1-23ed-4112-837a-08800afc3631\', \'multiverseId\': 555949}, \'multiverseid\': 555949}, {\'name\': \'Infiltrateur de syndicat\', \'text\': "Vol\\nTant qu\'il y a au moins cinq valeurs de mana parmi les cartes de votre cimetière, l\'Infiltrateur de syndicat gagne +2/+2.", \'type\': \'Créature : vampire et sorcier\', \'flavor\': \'Les plafonds voûtés du manoir offraient une cachette parfaite pour une embuscade.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556210&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cc4aee41-9359-4e7c-8ec2-66e814e6d811\', \'multiverseId\': 556210}, \'multiverseid\': 556210}, {\'name\': \'Infiltrato del Sindacato\', \'text\': "Volare\\nFintanto che ci sono cinque o più valori di mana tra le carte nel tuo cimitero, l\'Infiltrato del Sindacato prende +2/+2.", \'type\': \'Creatura — Mago Vampiro\', \'flavor\': "I soffitti a volta della villa fornivano il riparo perfetto per un\'imboscata.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556471&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d09eefa3-de8f-4f59-8293-75e44677a23f\', \'multiverseId\': 556471}, \'multiverseid\': 556471}, {\'name\': \'組織の潜入者\', \'text\': \'飛行\\nあなたの墓地にあるすべてのカードの中に５種類以上のマナ総量があるかぎり、組織の潜入者は＋２/＋２の修整を受ける。\', \'type\': \'クリーチャー — 吸血鬼・ウィザード\', \'flavor\': \'邸宅のヴォールト天井は、待ち伏せにうってつけの隠れ場所を提供している。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556732&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'efdaf717-4f25-461c-b716-fdbdd960e09a\', \'multiverseId\': 556732}, \'multiverseid\': 556732}, {\'name\': \'비밀조직 침투자\', \'text\': \'비행\\n당신의 무덤에 있는 카드들의 마나 값이 다섯 종류 이상인 한, 비밀조직 침투자는 +2/+2를 받는다.\', \'type\': \'생물 — 흡혈귀 마법사\', \'flavor\': \'저택의 아치형 천장은 기습을 위한 완벽한 엄폐물이 되어 주었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556993&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f88f693a-8f85-47af-bc6a-0982987f259f\', \'multiverseId\': 556993}, \'multiverseid\': 556993}, {\'name\': \'Infiltrado do Sindicato\', \'text\': \'Voar\\nEnquanto houver cinco ou mais valores de mana diferentes entre os cards em seu cemitério, Infiltrado do Sindicato receberá +2/+2.\', \'type\': \'Criatura — Vampiro Mago\', \'flavor\': \'A abóbada da mansão oferecia uma oportunidade perfeita para uma emboscada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557254&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'81f434c4-2563-4390-9954-1e8505bb791a\', \'multiverseId\': 557254}, \'multiverseid\': 557254}, {\'name\': \'Лазутчик Синдиката\', \'text\': \'Полет\\nПока среди карт на вашем кладбище есть не менее пяти разных значений мановой ценности, Лазутчик Синдиката получает +2/+2.\', \'type\': \'Существо — Вампир Чародей\', \'flavor\': \'Сводчатые потолки особняка стали идеальным укрытием для засады.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557515&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2c353460-7533-4e3f-aa7f-738e6ab54336\', \'multiverseId\': 557515}, \'multiverseid\': 557515}, {\'name\': \'黑帮渗透者\', \'text\': \'飞行\\n只要你坟墓场中牌的法术力值有五种或更多，黑帮渗透者便得+2/+2。\', \'type\': \'生物 ～吸血鬼／法术师\', \'flavor\': \'豪宅拱顶为伏击提供了完美掩护。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557776&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b4f9277f-d97c-446b-aeac-0122e8dc3ab4\', \'multiverseId\': 557776}, \'multiverseid\': 557776}, {\'name\': \'黑幫滲透者\', \'text\': \'飛行\\n只要你墳墓場中牌的魔法力值有五種或更多，黑幫滲透者便得+2/+2。\', \'type\': \'生物 ～吸血鬼／魔法師\', \'flavor\': \'豪宅拱頂為伏擊提供了完美掩護。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558037&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'93160c08-2214-4419-a564-076db968b48e\', \'multiverseId\': 558037}, \'multiverseid\': 558037}]', '[{\'name\': \'Tand-Hehler\', \'text\': \'{T}: Erzeuge einen Schatz-Spielstein. (Er ist ein Artefakt mit „{T}, opfere dieses Artefakt: Erzeuge ein Mana einer beliebigen Farbe.")\', \'type\': \'Kreatur — Elf, Räuber\', \'flavor\': \'Straßenecken im Mezzio sind ein verlockender Basar mit Fantastischem, Unerlaubtem und Gefälschtem.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555611&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'45e09890-08c1-42da-bc5f-4dd3da1095a0\', \'multiverseId\': 555611}, \'multiverseid\': 555611}, {\'name\': \'Traficante de oropel\', \'text\': \'{T}: Crea una ficha de Tesoro. (Es un artefacto con "{T}, sacrificar este artefacto: Agrega un maná de cualquier color".)\', \'type\': \'Criatura — Bribón elfo\', \'flavor\': \'Las esquinas de las calles del Mezzio son un bazar repleto de tentaciones fantásticas, ilícitas y falsas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555872&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0b69a37e-155c-435a-ac18-e7a72a3f6b08\', \'multiverseId\': 555872}, \'multiverseid\': 555872}, {\'name\': \'Négoce-pacotille\', \'text\': "{T} : Créez un jeton Trésor. (C\'est un artefact avec « {T}, sacrifiez cet artefact : Ajoutez un mana de la couleur de votre choix. »)", \'type\': \'Créature : elfe et gredin\', \'flavor\': \'Au Mezzio, chaque coin de rue est un bazar attrayant mêlant articles fantastiques, illégaux et contrefaçons.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556133&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e091e317-f3c0-4cfa-b46a-e5f747e3c6b6\', \'multiverseId\': 556133}, \'multiverseid\': 556133}, {\'name\': \'Lustrivendolo\', \'text\': \'{T}: Crea una pedina Tesoro. (È un artefatto con "{T}, Sacrifica questo artefatto: Aggiungi un mana di un qualsiasi colore".)\', \'type\': \'Creatura — Farabutto Elfo\', \'flavor\': "Gli angoli delle strade di Mezzio sono un allettante bazar del fantastico, dell\'illecito e del falso.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556394&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0a72aef4-1c80-49af-8662-62776ec5279b\', \'multiverseId\': 556394}, \'multiverseid\': 556394}, {\'name\': \'煌き売り\', \'text\': \'{T}：宝物・トークン１つを生成する。（それは、「{T}, このアーティファクトを生け贄に捧げる：好きな色１色のマナ１点を加える。」を持つアーティファクトである。）\', \'type\': \'クリーチャー — エルフ・ならず者\', \'flavor\': \'メッツィオの街角は、異様な品や脱法品から偽物まで揃うバザールである。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556655&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'906fe8f8-fadb-45d7-8e3a-dc8587ffc5de\', \'multiverseId\': 556655}, \'multiverseid\': 556655}, {\'name\': \'반짝이장수\', \'text\': \'{T}: 보물 토큰 한 개를 만든다. (보물 토큰은 "{T}, 이 마법물체를 희생한다: 원하는 색의 마나 한 개를 추가한다."를 가진 마법물체이다.)\', \'type\': \'생물 — 엘프 도적\', \'flavor\': \'메지오의 거리 모퉁이는 환상적이고, 불법적이며, 가짜인 것들로 사람들을 감질나게 하는 상점가다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556916&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e69f00cb-8926-43f6-bb15-f270e0a92c36\', \'multiverseId\': 556916}, \'multiverseid\': 556916}, {\'name\': \'Brilheiro\', \'text\': \'{T}: Crie uma ficha de Tesouro. (Ela é um artefato com "{T}, sacrifique este artefato: Adicione um mana de qualquer cor".)\', \'type\': \'Criatura — Elfo Ladino\', \'flavor\': \'As esquinas do Mezzio são um bazar estonteante do fantástico, do ilícito e do falsificado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557177&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c7af562d-478a-46bb-ace0-8f06c26fe055\', \'multiverseId\': 557177}, \'multiverseid\': 557177}, {\'name\': \'Побрякушник\', \'text\': \'{T}: создайте одну фишку Клада. (Это артефакт со способностью «{T}, пожертвуйте этот артефакт: добавьте одну ману любого цвета».)\', \'type\': \'Существо — Эльф Бродяга\', \'flavor\': \'Углы улиц Меццио — это кружащий голову калейдоскоп сокровищ, беззакония и подделок.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557438&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d2df5533-5747-4f3c-ad8e-2bc514016d90\', \'multiverseId\': 557438}, \'multiverseid\': 557438}, {\'name\': \'金饰贩子\', \'text\': \'{T}：派出一个珍宝衍生物。（珍宝衍生物是具有「{T}，牺牲此神器：加一点任意颜色的法术力」的神器。）\', \'type\': \'生物 ～妖精／浪客\', \'flavor\': \'梅齐奥区的街头巷尾充斥着各色流动摊贩，售卖好货、黑货和假货。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557699&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'db34051c-48b6-448c-aa06-84af8b61cb92\', \'multiverseId\': 557699}, \'multiverseid\': 557699}, {\'name\': \'金飾販子\', \'text\': \'{T}：派出一個珍寶衍生物。（珍寶衍生物是具有「{T}，犧牲此神器：加一點任意顏色的魔法力」的神器。）\', \'type\': \'生物 ～妖精／浪客\', \'flavor\': \'梅齊奧區的街頭巷尾充斥著各色流動攤販，售賣好貨、黑貨和假貨。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557960&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'88c643b1-fa5f-4047-8b91-abef65439932\', \'multiverseId\': 557960}, \'multiverseid\': 557960}]', '[{\'name\': \'Tavernen-Hasardeurin\', \'text\': \'{T}, bezahle 3 Lebenspunkte: Wirf eine Münze. Falls du den Münzwurf gewinnst, erhältst du 6 Lebenspunkte dazu.\', \'type\': \'Kreatur — Mensch, Räuber\', \'flavor\': \'„Nur ein Dummkopf hört auf, nachdem er unglücklich verloren hat. Du bist doch kein Dummkopf, oder?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555558&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5a3d580a-9e02-43ae-a734-7d6208628702\', \'multiverseId\': 555558}, \'multiverseid\': 555558}, {\'name\': \'Estafadora de taberna\', \'text\': \'{T}, pagar 3 vidas: Lanza una moneda a cara o cruz. Si ganas el lanzamiento, ganas 6 vidas.\', \'type\': \'Criatura — Bribón humano\', \'flavor\': \'"Solo los bobos paran tras perder por mala suerte. Tú no eres de esos, ¿no?".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555819&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3794ea99-1e91-41c8-a19e-7dad81e8811a\', \'multiverseId\': 555819}, \'multiverseid\': 555819}, {\'name\': \'Filouteuse de taverne\', \'text\': \'{T}, payez 3 points de vie : Jouez à pile ou face. Si vous gagnez, vous gagnez 6 points de vie.\', \'type\': \'Créature : humain et gredin\', \'flavor\': "« Seuls les crétins s\'arrêtent après le premier revers de fortune. Tu n\'es pas un crétin, quand même ? »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556080&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'112a6bdf-5d1a-4f6e-971b-4ec81e130261\', \'multiverseId\': 556080}, \'multiverseid\': 556080}, {\'name\': \'Truffatrice da Taverna\', \'text\': \'{T}, Paga 3 punti vita: Lancia una moneta. Se vinci il lancio, guadagni 6 punti vita.\', \'type\': \'Creatura — Farabutto Umano\', \'flavor\': \'"Solo gli stupidi si fermano dopo una sconfitta sfortunata. Tu non sei così, vero?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556341&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fbc500d9-49c7-45eb-bdc4-b80209a33e8f\', \'multiverseId\': 556341}, \'multiverseid\': 556341}, {\'name\': \'酒場の詐取師\', \'text\': \'{T}, ３点のライフを支払う：コイン投げをする。あなたがそのコイン投げに勝ったなら、あなたは６点のライフを得る。\', \'type\': \'クリーチャー — 人間・ならず者\', \'flavor\': \'「たかが不運な負け一回で降りるのは間抜けだけ。あなたは違うでしょ？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556602&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3e75f65d-48c2-4b37-b40b-01f50f3dc7a5\', \'multiverseId\': 556602}, \'multiverseid\': 556602}, {\'name\': \'술집 사기꾼\', \'text\': \'{T}, 생명 3점을 지불한다: 동전을 던진다. 당신이 동전 던지기에서 이기면, 당신은 생명 6점을 얻는다.\', \'type\': \'생물 — 인간 도적\', \'flavor\': \'"운 나쁘게 한 번 졌다고 멈추는 건 호구나 하는 거지. 넌 호구가 아니잖아, 그렇지?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556863&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'890decdd-066b-407b-a281-633488b9e61f\', \'multiverseId\': 556863}, \'multiverseid\': 556863}, {\'name\': \'Vigarista da Taverna\', \'text\': \'{T}, pague 3 pontos de vida: Lance uma moeda. Se vencer, você ganha 6 pontos de vida.\', \'type\': \'Criatura — Humano Ladino\', \'flavor\': \'"Só os idiotas param depois de dar azar uma vez. Você não é idiota, é?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557124&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'18a5df3e-ac30-4889-8ced-233662428790\', \'multiverseId\': 557124}, \'multiverseid\': 557124}, {\'name\': \'Кабацкая Мошенница\', \'text\': \'{T}, заплатите 3 жизни: подбросьте монету. Если вы выигрываете бросок, вы получаете 6 жизней.\', \'type\': \'Существо — Человек Бродяга\', \'flavor\': \'«Только полный дурень останавливается после одного неудачного проигрыша. Ты же не дурень, верно?»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557385&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'995b0d35-d170-4f20-88da-cfae4fe6eace\', \'multiverseId\': 557385}, \'multiverseid\': 557385}, {\'name\': \'酒馆骗子\', \'text\': \'{T}，支付3点生命：掷一枚硬币。如果你赢得此掷，则你获得6点生命。\', \'type\': \'生物 ～人类／浪客\', \'flavor\': \'「不小心输一把就收手的人最傻。你不傻吧？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557646&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b225b3dc-1600-4c3d-be29-53451a1240a5\', \'multiverseId\': 557646}, \'multiverseid\': 557646}, {\'name\': \'酒館騙子\', \'text\': \'{T}，支付3點生命：擲一枚硬幣。如果你贏得此擲，則你獲得6點生命。\', \'type\': \'生物 ～人類／浪客\', \'flavor\': \'「不小心輸一把就收手的人最傻。你不傻吧？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557907&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c5ae92be-5a13-4942-a6ab-23da1368ab7f\', \'multiverseId\': 557907}, \'multiverseid\': 557907}]', '[{\'name\': \'Teuflischer Garderobier\', \'text\': \'Verursacht Trampelschaden, Eile\\nAllianz — Immer wenn eine andere Kreatur unter deiner Kontrolle ins Spiel kommt, verdopple die Stärke des Teuflischen Garderobiers bis zum Ende des Zuges.\', \'type\': \'Kreatur — Teufel, Krieger\', \'flavor\': \'Niemand hatte etwas dagegen, die Waffen am Eingang abzugeben, bis sie erfuhren, dass es beim Eingang keine Garderobe gab.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555567&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4863e53a-d9d3-407f-8ebf-16f036967db7\', \'multiverseId\': 555567}, \'multiverseid\': 555567}, {\'name\': \'Custodio diabólico\', \'text\': \'Arrolla, prisa.\\nAsociación — Siempre que otra criatura entre al campo de batalla bajo tu control, duplica la fuerza del Custodio diabólico hasta el final del turno.\', \'type\': \'Criatura — Guerrero diablo\', \'flavor\': \'A todos les parecía de lo más normal depositar sus armas en el guardaarmas, hasta que les dijeron que eso no existía.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555828&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'27b99a3b-0cb1-43ee-80d7-70fd6edf354a\', \'multiverseId\': 555828}, \'multiverseid\': 555828}, {\'name\': \'Diable valet\', \'text\': "Piétinement, célérité\\nAlliance — À chaque fois qu\'une autre créature arrive sur le champ de bataille sous votre contrôle, doublez la force du Diable valet jusqu\'à la fin du tour.", \'type\': \'Créature : diable et guerrier\', \'flavor\': "Personne ne s\'était opposé à laisser son arme à la consigne à l\'entrée, jusqu\'à ce qu\'on leur apprenne qu\'il n\'y avait pas de consigne à l\'entrée.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556089&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'30716744-7107-4a0c-bb96-8d71734c8136\', \'multiverseId\': 556089}, \'multiverseid\': 556089}, {\'name\': \'Guardarobiere Diabolico\', \'text\': "Travolgere, rapidità\\nAlleanza — Ogniqualvolta un\'altra creatura entra nel campo di battaglia sotto il tuo controllo, raddoppia la forza del Guardarobiere Diabolico fino alla fine del turno.", \'type\': \'Creatura — Guerriero Diavolo\', \'flavor\': "Nessuno ci ha pensato due volte a consegnare le proprie armi all\'entrata, finché non sono stati informati che non c\'era nessuna consegna delle armi all\'entrata.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556350&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8973cf51-4fc0-4ec8-88fe-178deb3a9982\', \'multiverseId\': 556350}, \'multiverseid\': 556350}, {\'name\': \'悪魔的な客室係\', \'text\': \'トランプル、速攻\\n団結 ― これでないクリーチャー１体があなたのコントロール下で戦場に出るたび、ターン終了時まで、悪魔的な客室係のパワーを２倍にする。\', \'type\': \'クリーチャー — デビル・戦士\', \'flavor\': \'玄関先で武器検査を行なわない旨を知らされるまで、玄関先で自分の武器を検査することを誰一人疑いもしなかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556611&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'04055eff-5c6d-4e4c-8ac5-a2ef77cb89fc\', \'multiverseId\': 556611}, \'multiverseid\': 556611}, {\'name\': \'악령 발렛 요원\', \'text\': \'돌진, 신속\\n연대 — 다른 생물이 당신의 조종하에 전장에 들어올 때마다, 턴종료까지 악령 발렛 요원의 공격력을 두 배로 만든다.\', \'type\': \'생물 — 악령 전사\', \'flavor\': \'아무도 입구에서 무기를 맡겨야 하는 것에 대해 의문을 가지지 않았다. 입구에서 무기를 맡기는 절차가 없다는 말을 듣기 전까지는 말이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556872&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'491e2ff9-d2f1-42ee-bd38-d2e62c3ab696\', \'multiverseId\': 556872}, \'multiverseid\': 556872}, {\'name\': \'Recepcionista Diabólico\', \'text\': \'Atropelar, ímpeto\\nAliança — Toda vez que outra criatura entrar no campo de batalha sob seu controle, dobre o poder de Recepcionista Diabólico até o final do turno.\', \'type\': \'Criatura — Diabo Guerreiro\', \'flavor\': \'Ninguém pensou duas vezes antes de deixar as armas na porta... até ser informado de que não era necessário deixar as armas na porta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557133&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fcee0f93-77b6-4988-b0f3-7a13c813cb13\', \'multiverseId\': 557133}, \'multiverseid\': 557133}, {\'name\': \'Дьявольский Камердинер\', \'text\': \'Пробивной удар, Ускорение\\nАльянс — Каждый раз, когда другое существо выходит на поле битвы под вашим контролем, удвойте силу Дьявольского Камердинера до конца хода.\', \'type\': \'Существо — Дьявол Воин\', \'flavor\': \'Каждый, не задумываясь, сдавал оружие на входе, пока им не сообщили, что оружие на входе не сдается.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557394&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5ebf145e-908b-40b5-bc87-a7b272a14feb\', \'multiverseId\': 557394}, \'multiverseid\': 557394}, {\'name\': \'魔鬼侍应\', \'text\': \'践踏，敏捷\\n联手～每当另一个生物在你的操控下进战场时，将魔鬼侍应的力量加倍直到回合结束。\', \'type\': \'生物 ～魔鬼／战士\', \'flavor\': \'所有人想都没想就在门口寄存了自己的武器；后来他们才知道进门不用寄存武器。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557655&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'81c0306c-c5d8-42c0-91ca-cf219fa526b8\', \'multiverseId\': 557655}, \'multiverseid\': 557655}, {\'name\': \'魔鬼侍應\', \'text\': \'踐踏，敏捷\\n聯手～每當另一個生物在你的操控下進戰場時，將魔鬼侍應的力量加倍直到回合結束。\', \'type\': \'生物 ～魔鬼／戰士\', \'flavor\': \'所有人想都沒想就在門口寄存了自己的武器；後來他們才知道進門不用寄存武器。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557916&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e883cc0f-4bdd-48cc-8273-5e9b3cc40aec\', \'multiverseId\': 557916}, \'multiverseid\': 557916}]', '[{\'name\': \'Teuflischer Garderobier\', \'text\': \'Verursacht Trampelschaden, Eile\\nAllianz — Immer wenn eine andere Kreatur unter deiner Kontrolle ins Spiel kommt, verdopple die Stärke des Teuflischen Garderobiers bis zum Ende des Zuges.\', \'type\': \'Kreatur — Teufel, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558296&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0ce8e5dc-4aee-405c-bfcf-ddb143825711\', \'multiverseId\': 558296}, \'multiverseid\': 558296}, {\'name\': \'Diable valet\', \'text\': "Piétinement, célérité\\nAlliance — À chaque fois qu\'une autre créature arrive sur le champ de bataille sous votre contrôle, doublez la force du Diable valet jusqu\'à la fin du tour.", \'type\': \'Créature : diable et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558331&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9461a384-6619-4684-a4d1-60cd2d7cf084\', \'multiverseId\': 558331}, \'multiverseid\': 558331}, {\'name\': \'悪魔的な客室係\', \'text\': \'トランプル、速攻\\n団結 ― これでないクリーチャー１体があなたのコントロール下で戦場に出るたび、ターン終了時まで、悪魔的な客室係のパワーを２倍にする。\', \'type\': \'クリーチャー — デビル・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558366&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'44459401-34ff-4db9-bb77-34020493988e\', \'multiverseId\': 558366}, \'multiverseid\': 558366}, {\'name\': \'魔鬼侍应\', \'text\': \'践踏，敏捷\\n联手～每当另一个生物在你的操控下进战场时，将魔鬼侍应的力量加倍直到回合结束。\', \'type\': \'生物 ～魔鬼／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558401&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3805ed54-d688-4ade-b9c2-ac11f600655d\', \'multiverseId\': 558401}, \'multiverseid\': 558401}]', '[{\'name\': \'Tod vortäuschen\', \'text\': \'Bis zum Ende des Zuges erhält eine Kreatur deiner Wahl +2/+0 und „Wenn diese Kreatur stirbt, bringe sie unter der Kontrolle ihres Besitzers getappt ins Spiel zurück und du erzeugst einen Schatz-Spielstein." (Er ist ein Artefakt mit „{T}, opfere dieses Artefakt: Erzeuge ein Mana einer beliebigen Farbe.")\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555541&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'557c7424-e9a2-4688-b92c-c199e8c65a1a\', \'multiverseId\': 555541}, \'multiverseid\': 555541}, {\'name\': \'Fingir tu propia muerte\', \'text\': \'Hasta el final del turno, la criatura objetivo obtiene +2/+0 y gana "Cuando esta criatura muera, regrésala al campo de batalla girada bajo el control de su propietario y tú creas una ficha de Tesoro". (Es un artefacto con "{T}, sacrificar este artefacto: Agrega un maná de cualquier color".)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555802&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2f37be57-1498-4fca-98d6-9f612391d3c0\', \'multiverseId\': 555802}, \'multiverseid\': 555802}, {\'name\': \'Simulez votre propre mort\', \'text\': "Jusqu\'à la fin du tour, une créature ciblée gagne +2/+0 et acquiert « Quand cette créature meurt, renvoyez-la sur le champ de bataille engagée sous le contrôle de son propriétaire et vous créez un jeton Trésor. » (C\'est un artefact avec « {T}, sacrifiez cet artefact : Ajoutez un mana de la couleur de votre choix. »)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556063&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'63659ed5-8902-4209-b2c2-df5fcf8fbc1d\', \'multiverseId\': 556063}, \'multiverseid\': 556063}, {\'name\': \'Inscenare la Morte\', \'text\': \'Fino alla fine del turno, una creatura bersaglio prende +2/+0 e ha "Quando questa creatura muore, rimettila sul campo di battaglia TAPpata sotto il controllo del suo proprietario e crea una pedina Tesoro". (È un artefatto con "{T}, Sacrifica questo artefatto: Aggiungi un mana di un qualsiasi colore".)\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556324&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b3996497-338c-40ac-9dc3-ffcba8a09f62\', \'multiverseId\': 556324}, \'multiverseid\': 556324}, {\'name\': \'死の偽装\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋２/＋０の修整を受け、「このクリーチャーが死亡したとき、これをオーナーのコントロール下でタップ状態で戦場に戻し、あなたは宝物・トークン１つを生成する。」を得る。（それは、「{T}, このアーティファクトを生け贄に捧げる：好きな色１色のマナ１点を加える。」を持つアーティファクトである。）\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556585&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'38a09c06-64b8-4983-9a56-89f7b94cab3c\', \'multiverseId\': 556585}, \'multiverseid\': 556585}, {\'name\': \'꾸며낸 죽음\', \'text\': \'생물을 목표로 정한다. 턴종료까지, 그 생물은 +2/+0을 받고 "이 생물이 죽을 때, 이 생물을 소유자의 조종하에 탭된 채로 전장으로 되돌리고 당신은 보물 토큰 한 개를 만든다."를 얻는다. (보물 토큰은 "{T}, 이 마법물체를 희생한다: 원하는 색의 마나 한 개를 추가한다."를 가진 마법물체이다.)\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556846&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c7f65428-efab-4c3c-9093-ffaf61f3b80e\', \'multiverseId\': 556846}, \'multiverseid\': 556846}, {\'name\': \'Fingir a Própria Morte\', \'text\': \'Até o final do turno, a criatura alvo recebe +2/+0 e ganha "Quando esta criatura morrer, devolva-a ao campo de batalha virada sob o controle de seu dono e você cria uma ficha de Tesouro". (Ela é um artefato com "{T}, sacrifique este artefato: Adicione um mana de qualquer cor".)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557107&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0ceeadd1-8a99-4a5e-8689-6802ccb32f84\', \'multiverseId\': 557107}, \'multiverseid\': 557107}, {\'name\': \'Инсценировка Смерти\', \'text\': \'До конца хода целевое существо получает +2/+0 и способность «Когда это существо умирает, верните его на поле битвы повернутым под контролем его владельца, и вы создаете одну фишку Клада». (Это артефакт со способностью «{T}, пожертвуйте этот артефакт: добавьте одну ману любого цвета».)\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557368&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'55807196-3cb5-4520-94d2-f3ce23713a7a\', \'multiverseId\': 557368}, \'multiverseid\': 557368}, {\'name\': \'自伪身故\', \'text\': \'直到回合结束，目标生物得+2/+0且获得「当此生物死去时，将它在其拥有者的操控下横置移回战场，且你派出一个珍宝衍生物。」（珍宝衍生物是具有「{T}，牺牲此神器：加一点任意颜色的法术力」的神器。）\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557629&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2cf41e23-079c-4d7c-add7-672220755667\', \'multiverseId\': 557629}, \'multiverseid\': 557629}, {\'name\': \'自偽身故\', \'text\': \'直到回合結束，目標生物得+2/+0且獲得「當此生物死去時，將它在其擁有者的操控下橫置移回戰場，且你派出一個珍寶衍生物。」（珍寶衍生物是具有「{T}，犧牲此神器：加一點任意顏色的魔法力」的神器。）\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557890&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'298da7b5-dc6f-4c6d-a76e-3fb73450719e\', \'multiverseId\': 557890}, \'multiverseid\': 557890}]', '[{\'name\': \'Todesschuss\', \'text\': \'Zerstöre eine angreifende Kreatur deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Im Meuchelmord-Geschäft überlebt niemand lange genug, um mehr als einen Fehler zu machen."\\n—Anhelo der Künstler\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555481&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'17971e8e-7106-49f3-ac81-32e391185932\', \'multiverseId\': 555481}, \'multiverseid\': 555481}, {\'name\': \'Disparo mortífero\', \'text\': \'Destruye la criatura atacante objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"En el negocio del asesinato, nadie sobrevive lo suficiente como para cometer más de un error".\\n—Angelo, el Pintor\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555742&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2bc252c0-331d-4bda-9be6-9b577f0d885f\', \'multiverseId\': 555742}, \'multiverseid\': 555742}, {\'name\': \'Tir mortel\', \'text\': \'Détruisez une créature attaquante ciblée.\', \'type\': \'Éphémère\', \'flavor\': "« Dans le métier d\'assassin, nul ne survit à sa première erreur. »\\n—Anhelo, le peintre", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556003&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'24c4a6d8-a68d-42b6-9297-10c4402e1aaf\', \'multiverseId\': 556003}, \'multiverseid\': 556003}, {\'name\': \'Scoccata Letale\', \'text\': \'Distruggi una creatura attaccante bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Nel campo degli omicidi, se commetti un errore non sopravvivi abbastanza a lungo da commetterne un altro."\\n—Anhelo, il Pittore\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556264&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'774b30d1-6e39-45b5-8cec-18452e51434d\', \'multiverseId\': 556264}, \'multiverseid\': 556264}, {\'name\': \'必殺の一射\', \'text\': \'攻撃クリーチャー１体を対象とする。それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'「暗殺稼業では、一つの過ちが命取りとなるのだ。」\\n――画家、アンヘロ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556525&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bbc74a40-ff09-4e5a-8118-ccc001db9918\', \'multiverseId\': 556525}, \'multiverseid\': 556525}, {\'name\': \'절명의 사격\', \'text\': \'공격 중인 생물을 목표로 정한다. 그 생물을 파괴한다.\', \'type\': \'순간마법\', \'flavor\': \'"암살업에서, 실수를 두 번 할 수 있을 정도로 오래 살아있는 놈은 없지."\\n—화가, 안헬로\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556786&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'393c5427-c1b2-497c-8f97-f627a53718c6\', \'multiverseId\': 556786}, \'multiverseid\': 556786}, {\'name\': \'Tiro Mortal\', \'text\': \'Destrua a criatura atacante alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"No ramo do assassínio, ninguém sobrevive para errar duas vezes."\\n— Anhelo, o Pintor\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557047&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'87a760a4-d903-4d5c-844a-317120f19e0f\', \'multiverseId\': 557047}, \'multiverseid\': 557047}, {\'name\': \'Смертельный Выстрел\', \'text\': \'Уничтожьте целевое атакующее существо.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Среди профессиональных убийц не найти тех, кто сумел бы выжить и повторить свою ошибку».\\n— Анхело, Художник\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557308&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a68eff31-9231-4e25-a2b9-c389b40b3411\', \'multiverseId\': 557308}, \'multiverseid\': 557308}, {\'name\': \'致命箭矢\', \'text\': \'消灭目标进行攻击的生物。\', \'type\': \'瞬间\', \'flavor\': \'「在刺客这行，一个失误就能赔掉性命。」\\n～华艺家安海洛\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557569&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'de02b9aa-0fef-45e1-a54b-b022cb1f0179\', \'multiverseId\': 557569}, \'multiverseid\': 557569}, {\'name\': \'致命箭矢\', \'text\': \'消滅目標進行攻擊的生物。\', \'type\': \'瞬間\', \'flavor\': \'「在刺客這行，一個失誤就能賠掉性命。」\\n～華藝家安海洛\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557830&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d635dad7-ee3e-4162-be69-27ea5cf861d8\', \'multiverseId\': 557830}, \'multiverseid\': 557830}]', '[{\'name\': \'Toluz, clevere Kondukteuse\', \'text\': \'Wenn Toluz, clevere Kondukteuse, ins Spiel kommt, intrigiert sie. (Ziehe eine Karte und wirf dann eine Karte ab. Falls du eine Nichtland-Karte abgeworfen hast, lege eine +1/+1-Marke auf diese Kreatur.)\\nImmer wenn du eine oder mehrere Karten abwirfst, schicke sie aus deinem Friedhof ins Exil.\\nWenn Toluz stirbt, bringe die von ihr ins Exil geschickten Karten auf die Hand ihrer Besitzer zurück.\', \'type\': \'Legendäre Kreatur — Mensch, Räuber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555690&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f488542e-c3c5-4560-ab1a-b821372a9bb2\', \'multiverseId\': 555690}, \'multiverseid\': 555690}, {\'name\': \'Toluz, revisora astuta\', \'text\': \'Cuando Toluz, revisora astuta entre al campo de batalla, confabula. (Roba una carta, luego descarta una carta. Si descartaste una carta que no sea tierra, pon un contador +1/+1 sobre esta criatura.)\\nSiempre que descartes una o más cartas, exílialas de tu cementerio.\\nCuando Toluz muera, pon las cartas exiliadas con ella en la mano de su propietario.\', \'type\': \'Criatura legendaria — Bribón humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555951&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b69a0d0e-b1dd-41aa-a545-7118ba5f1155\', \'multiverseId\': 555951}, \'multiverseid\': 555951}, {\'name\': \'Toluz, conductrice futée\', \'text\': "Quand Toluz, conductrice futée arrive sur le champ de bataille, elle connive. (Piochez une carte, puis défaussez-vous d\'une carte. Si vous vous êtes défaussé d\'une carte non-terrain, mettez un marqueur +1/+1 sur cette créature.)\\nÀ chaque fois que vous vous défaussez d\'au moins une carte, exilez-la depuis votre cimetière.\\nQuand Toluz meurt, mettez les cartes exilées par elle dans la main de leur propriétaire.", \'type\': \'Créature légendaire : humain et gredin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556212&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1599a528-4133-488b-905f-2f20bfb618de\', \'multiverseId\': 556212}, \'multiverseid\': 556212}, {\'name\': \'Toluz, Capotreno Scaltra\', \'text\': \'Quando Toluz, Capotreno Scaltra entra nel campo di battaglia, complotta. (Pesca una carta, poi scarta una carta. Se hai scartato una carta non terra, metti un segnalino +1/+1 su questa creatura.)\\nOgniqualvolta scarti una o più carte, esiliale dal tuo cimitero.\\nQuando Toluz muore, metti le carte esiliate con essa in mano ai rispettivi proprietari.\', \'type\': \'Creatura Leggendaria — Farabutto Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556473&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'87f7cd23-35d4-4428-8a7d-505d3ef90dff\', \'multiverseId\': 556473}, \'multiverseid\': 556473}, {\'name\': \'賢明な車掌、トルーズ\', \'text\': \'賢明な車掌、トルーズが戦場に出たとき、これは謀議する。（カード１枚を引き、その後カード１枚を捨てる。これによりあなたが土地でないカードを捨てたなら、このクリーチャーの上に＋１/＋１カウンター１個を置く。）\\nあなたが１枚以上のカードを捨てるたび、あなたの墓地にあるそれらを追放する。\\n賢明な車掌、トルーズが死亡したとき、これにより追放されている各カードをそれぞれオーナーの手札に加える。\', \'type\': \'伝説のクリーチャー — 人間・ならず者\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556734&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c04beb33-4f92-4a28-bbe5-b9eac5ffab4d\', \'multiverseId\': 556734}, \'multiverseid\': 556734}, {\'name\': \'영리한 지휘자, 톨루즈\', \'text\': \'영리한 지휘자, 톨루즈가 전장에 들어올 때, 톨루즈는 묵인한다. (카드 한 장을 뽑은 후, 카드 한 장을 버린다. 당신이 대지가 아닌 카드를 버린다면, 이 생물에 +1/+1 카운터 한 개를 올려놓는다.)\\n당신이 카드를 한 장 이상 버릴 때마다, 당신의 무덤에서 그 카드들을 추방한다.\\n톨루즈가 죽을 때, 톨루즈로 추방된 카드들을 소유자의 손에 넣는다.\', \'type\': \'전설적 생물 — 인간 도적\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556995&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7fe1c6c8-3947-4a77-b1a2-f4a6d85da97c\', \'multiverseId\': 556995}, \'multiverseid\': 556995}, {\'name\': \'Toluz, Maquinista Astuta\', \'text\': \'Quando Toluz, Maquinista Astuta, entra no campo de batalha, ela acoberta. (Compre um card e depois descarte um card. Se você descartou um card não de terreno, coloque um marcador +1/+1 nesta criatura.)\\nToda vez que você descartar um ou mais cards, exile-os de seu cemitério.\\nQuando Toluz morrer, coloque os cards exilados com ela nas mãos de seus donos.\', \'type\': \'Criatura Lendária — Humano Ladino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557256&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'342a6321-64a7-4b24-a615-42f352004e07\', \'multiverseId\': 557256}, \'multiverseid\': 557256}, {\'name\': \'Толуз, Хитроумная Вагоновожатая\', \'text\': \'Когда Толуз, Хитроумная Вагоновожатая выходит на поле битвы, она сговаривается. (Возьмите карту, затем сбросьте карту. Если вы сбросили не являющуюся землей карту, положите один жетон +1/+1 на это существо.)\\nКаждый раз, когда вы сбрасываете одну или несколько карт, изгоните их из вашего кладбища.\\nКогда Толуз умирает, положите изгнанные ею карты в руку их владельца.\', \'type\': \'Легендарное Существо — Человек Бродяга\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557517&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ae609b8d-ce4d-492e-9219-648b8f59d56b\', \'multiverseId\': 557517}, \'multiverseid\': 557517}, {\'name\': \'机敏行控涂璐丝\', \'text\': \'当机敏行控涂璐丝进战场时，令它筹谋。（抓一张牌，然后弃一张牌。如果你弃的牌不是地，则在此生物上放置一个+1/+1指示物。）\\n每当你弃一张或数张牌时，将它们从你的坟墓场放逐。\\n当涂璐丝死去时，将以它放逐的牌移回其拥有者手上。\', \'type\': \'传奇生物 ～人类／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557778&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'754f0665-a403-4a69-b2f0-644d98dc59b2\', \'multiverseId\': 557778}, \'multiverseid\': 557778}, {\'name\': \'機敏行控涂璐絲\', \'text\': \'當機敏行控涂璐絲進戰場時，令它籌謀。（抽一張牌，然後棄一張牌。如果你棄的牌不是地，則在此生物上放置一個+1/+1指示物。）\\n每當你棄一張或數張牌時，將它們從你的墳墓場放逐。\\n當涂璐絲死去時，將以它放逐的牌移回其擁有者手上。\', \'type\': \'傳奇生物 ～人類／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558039&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'75069020-6b82-473c-b371-cb07cc6f1ac5\', \'multiverseId\': 558039}, \'multiverseid\': 558039}]', '[{\'name\': \'Toluz, clevere Kondukteuse\', \'text\': \'Wenn Toluz, clevere Kondukteuse, ins Spiel kommt, intrigiert sie.\\nImmer wenn du eine oder mehrere Karten abwirfst, schicke sie aus deinem Friedhof ins Exil.\\nWenn Toluz stirbt, bringe die von ihr ins Exil geschickten Karten auf die Hand ihrer Besitzer zurück.\', \'type\': \'Legendäre Kreatur — Mensch, Räuber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558779&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'83ae6c94-2514-41b5-a028-d4117f548cfc\', \'multiverseId\': 558779}, \'multiverseid\': 558779}, {\'name\': \'Toluz, revisora astuta\', \'text\': \'Cuando Toluz, revisora astuta entre al campo de batalla, confabula.\\nSiempre que descartes una o más cartas, exílialas de tu cementerio.\\nCuando Toluz muera, pon las cartas exiliadas con ella en la mano de su propietario.\', \'type\': \'Criatura legendaria — Bribón humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558824&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'731be581-7f3d-46c1-bd89-a44f7cf97c9b\', \'multiverseId\': 558824}, \'multiverseid\': 558824}, {\'name\': \'Toluz, conductrice futée\', \'text\': "Quand Toluz, conductrice futée arrive sur le champ de bataille, elle connive.\\nÀ chaque fois que vous vous défaussez d\'au moins une carte, exilez-la depuis votre cimetière.\\nQuand Toluz meurt, mettez les cartes exilées par elle dans la main de leur propriétaire.", \'type\': \'Créature légendaire : humain et gredin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558869&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ac8a5686-77a0-4fe4-98f6-51b6af3c6425\', \'multiverseId\': 558869}, \'multiverseid\': 558869}, {\'name\': \'Toluz, Capotreno Scaltra\', \'text\': \'Quando Toluz, Capotreno Scaltra entra nel campo di battaglia, complotta.\\nOgniqualvolta scarti una o più carte, esiliale dal tuo cimitero.\\nQuando Toluz muore, metti le carte esiliate con essa in mano ai rispettivi proprietari.\', \'type\': \'Creatura Leggendaria — Farabutto Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558914&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'60637228-0507-4459-828c-17d75519c30a\', \'multiverseId\': 558914}, \'multiverseid\': 558914}, {\'name\': \'賢明な車掌、トルーズ\', \'text\': \'賢明な車掌、トルーズが戦場に出たとき、これは謀議する。\\nあなたが１枚以上のカードを捨てるたび、あなたの墓地にあるそれらを追放する。\\n賢明な車掌、トルーズが死亡したとき、これにより追放されている各カードをそれぞれオーナーの手札に加える。\', \'type\': \'伝説のクリーチャー — 人間・ならず者\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558959&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'097eb584-aefb-4461-a43e-91806dad3723\', \'multiverseId\': 558959}, \'multiverseid\': 558959}, {\'name\': \'영리한 지휘자, 톨루즈\', \'text\': \'영리한 지휘자, 톨루즈가 전장에 들어올 때, 톨루즈는 묵인한다.\\n당신이 카드를 한 장 이상 버릴 때마다, 당신의 무덤에서 그 카드들을 추방한다.\\n톨루즈가 죽을 때, 톨루즈로 추방된 카드들을 소유자의 손에 넣는다.\', \'type\': \'전설적 생물 — 인간 도적\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559004&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4dd38f32-d519-459a-a2be-0761e328be1d\', \'multiverseId\': 559004}, \'multiverseid\': 559004}, {\'name\': \'Toluz, Maquinista Astuta\', \'text\': \'Quando Toluz, Maquinista Astuta, entra no campo de batalha, ela acoberta.\\nToda vez que você descartar um ou mais cards, exile-os de seu cemitério.\\nQuando Toluz morrer, coloque os cards exilados com ela nas mãos de seus donos.\', \'type\': \'Criatura Lendária — Humano Ladino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559049&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f74fa7cb-52d8-4a5e-8eb8-f71767063036\', \'multiverseId\': 559049}, \'multiverseid\': 559049}, {\'name\': \'Толуз, Хитроумная Вагоновожатая\', \'text\': \'Когда Толуз, Хитроумная Вагоновожатая выходит на поле битвы, она сговаривается.\\nКаждый раз, когда вы сбрасываете одну или несколько карт, изгоните их из вашего кладбища.\\nКогда Толуз умирает, положите изгнанные ею карты в руку их владельца.\', \'type\': \'Легендарное Существо — Человек Бродяга\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559094&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f0c3dfdc-6a0b-4120-99f1-2a0a972489d5\', \'multiverseId\': 559094}, \'multiverseid\': 559094}, {\'name\': \'机敏行控涂璐丝\', \'text\': \'当机敏行控涂璐丝进战场时，令它筹谋。\\n每当你弃一张或数张牌时，将它们从你的坟墓场放逐。\\n当涂璐丝死去时，将以它放逐的牌移回其拥有者手上。\', \'type\': \'传奇生物 ～人类／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559139&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a1501a1e-0f9f-43e2-b72c-71e79dd706f2\', \'multiverseId\': 559139}, \'multiverseid\': 559139}, {\'name\': \'機敏行控涂璐絲\', \'text\': \'當機敏行控涂璐絲進戰場時，令它籌謀。\\n每當你棄一張或數張牌時，將它們從你的墳墓場放逐。\\n當涂璐絲死去時，將以它放逐的牌移回其擁有者手上。\', \'type\': \'傳奇生物 ～人類／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559184&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e2bef7e9-cd1b-440a-9920-988b2aa3760f\', \'multiverseId\': 559184}, \'multiverseid\': 559184}]', "[{'name': 'Topiari-Stampfer', 'text': 'Wachsamkeit\\nWenn der Topiari-Stampfer ins Spiel kommt, durchsuche deine Bibliothek nach einer Standardland-Karte, bringe sie getappt ins Spiel und mische danach.\\nDer Topiari-Stampfer kann nicht angreifen oder blocken, es sei denn, du kontrollierst sieben oder mehr Länder.', 'type': 'Kreatur — Pflanze, Dinosaurier', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555622&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f43f1a64-9cdf-4256-9222-99acf54158c9', 'multiverseId': 555622}, 'multiverseid': 555622}, {'name': 'Aplastador arbustivo', 'text': 'Vigilancia.\\nCuando el Aplastador arbustivo entre al campo de batalla, busca en tu biblioteca una carta de tierra básica, ponla en el campo de batalla girada y luego baraja.\\nEl Aplastador arbustivo no puede atacar ni bloquear a menos que controles siete o más tierras.', 'type': 'Criatura — Dinosaurio planta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555883&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4a67e136-6086-4d5b-a673-6c379b76b8e7', 'multiverseId': 555883}, 'multiverseid': 555883}, {'name': 'Piétineur topiaire', 'text': 'Vigilance\\nQuand le Piétineur topiaire arrive sur le champ de bataille, cherchez dans votre bibliothèque une carte de terrain de base, mettez-la sur le champ de bataille engagée, puis mélangez.\\nLe Piétineur topiaire ne peut ni attaquer ni bloquer à moins que vous ne contrôliez au moins sept terrains.', 'type': 'Créature : plante et dinosaure', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556144&type=card', 'language': 'French', 'identifiers': {'scryfallId': '538ac9b1-b839-40b3-ad7b-a3e83d8681a0', 'multiverseId': 556144}, 'multiverseid': 556144}, {'name': 'Calpestatore Topiario', 'text': 'Cautela\\nQuando il Calpestatore Topiario entra nel campo di battaglia, passa in rassegna il tuo grimorio per una carta terra base, mettila sul campo di battaglia TAPpata, poi rimescola.\\nIl Calpestatore Topiario non può attaccare o bloccare a meno che tu non controlli sette o più terre.', 'type': 'Creatura — Dinosauro Pianta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556405&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ed2314f8-fff0-4f95-a4aa-416cafb98bef', 'multiverseId': 556405}, 'multiverseid': 556405}, {'name': '装飾庭園を踏み歩くもの', 'text': '警戒\\n装飾庭園を踏み歩くものが戦場に出たとき、あなたのライブラリーから基本土地・カード１枚を探し、タップ状態で戦場に出し、その後ライブラリーを切り直す。\\nあなたが７つ以上の土地をコントロールしていないかぎり、装飾庭園を踏み歩くものでは攻撃もブロックもできない。', 'type': 'クリーチャー — 植物・恐竜', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556666&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'dcc77ebe-a539-457a-a790-402905c1ff4a', 'multiverseId': 556666}, 'multiverseid': 556666}, {'name': '장식 야수', 'text': '경계\\n장식 야수가 전장에 들어올 때, 당신의 서고에서 기본 대지 카드 한 장을 찾아, 탭된 상태로 전장에 놓은 후, 서고를 섞는다.\\n장식 야수는 당신이 대지를 일곱 개 이상 조종하지 않는 한 공격 또는 방어할 수 없다.', 'type': '생물 — 식물 공룡', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556927&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'f1be4304-5b0b-4d93-891c-16973aa527f4', 'multiverseId': 556927}, 'multiverseid': 556927}, {'name': 'Pisoteador de Topiaria', 'text': 'Vigilância\\nQuando Pisoteador de Topiaria entrar no campo de batalha, procure em seu grimório um card de terreno básico, coloque-o no campo de batalha virado e depois embaralhe.\\nPisoteador de Topiaria não pode atacar nem bloquear, a menos que você controle sete ou mais terrenos.', 'type': 'Criatura — Planta Dinossauro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557188&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fd458e61-1c69-4568-8b7e-e668b9b59bc6', 'multiverseId': 557188}, 'multiverseid': 557188}, {'name': 'Топиарный Тяжелоступ', 'text': 'Бдительность\\nКогда Топиарный Тяжелоступ выходит на поле битвы, найдите в вашей библиотеке карту базовой земли, положите ее на поле битвы повернутой, затем перетасуйте библиотеку.\\nТопиарный Тяжелоступ не может атаковать или блокировать, если вы контролируете менее семи земель.', 'type': 'Существо — Растение Динозавр', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557449&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '47bd6aed-947e-4166-9589-d4de2aaec9b7', 'multiverseId': 557449}, 'multiverseid': 557449}, {'name': '绿雕跺地兽', 'text': '警戒\\n当绿雕跺地兽进战场时，从你牌库中搜寻一张基本地牌，将之横置放进战场，然后洗牌。\\n除非你操控七个或更多地，否则绿雕跺地兽不能进行攻击或阻挡。', 'type': '生物 ～植物／恐龙', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557710&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '5dbab291-54d1-400e-a996-ef71eafdbe29', 'multiverseId': 557710}, 'multiverseid': 557710}, {'name': '綠雕跺地獸', 'text': '警戒\\n當綠雕跺地獸進戰場時，從你牌庫中搜尋一張基本地牌，將之橫置放進戰場，然後洗牌。\\n除非你操控七個或更多地，否則綠雕跺地獸不能進行攻擊或阻擋。', 'type': '生物 ～植物／恐龍', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557971&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '4cc2d984-d7e1-47c8-bc88-a9a6977dea48', 'multiverseId': 557971}, 'multiverseid': 557971}]", "[{'name': 'Topiari-Stampfer', 'text': 'Wachsamkeit\\nWenn der Topiari-Stampfer ins Spiel kommt, durchsuche deine Bibliothek nach einer Standardland-Karte, bringe sie getappt ins Spiel und mische danach.\\nDer Topiari-Stampfer kann nicht angreifen oder blocken, es sei denn, du kontrollierst sieben oder mehr Länder.', 'type': 'Kreatur — Pflanze, Dinosaurier', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558435&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b6c6fbc8-b97f-4e32-b612-144b62927f27', 'multiverseId': 558435}, 'multiverseid': 558435}, {'name': 'Aplastador arbustivo', 'text': 'Vigilancia.\\nCuando el Aplastador arbustivo entre al campo de batalla, busca en tu biblioteca una carta de tierra básica, ponla en el campo de batalla girada y luego baraja.\\nEl Aplastador arbustivo no puede atacar ni bloquear a menos que controles siete o más tierras.', 'type': 'Criatura — Dinosaurio planta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558446&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '16004551-d9c6-418e-aab7-7f75bffb3196', 'multiverseId': 558446}, 'multiverseid': 558446}, {'name': 'Piétineur topiaire', 'text': 'Vigilance\\nQuand le Piétineur topiaire arrive sur le champ de bataille, cherchez dans votre bibliothèque une carte de terrain de base, mettez-la sur le champ de bataille engagée, puis mélangez.\\nLe Piétineur topiaire ne peut ni attaquer ni bloquer à moins que vous ne contrôliez au moins sept terrains.', 'type': 'Créature : plante et dinosaure', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558457&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b4c18a1c-ae5a-4f14-81b1-671c941c74f5', 'multiverseId': 558457}, 'multiverseid': 558457}, {'name': 'Calpestatore Topiario', 'text': 'Cautela\\nQuando il Calpestatore Topiario entra nel campo di battaglia, passa in rassegna il tuo grimorio per una carta terra base, mettila sul campo di battaglia TAPpata, poi rimescola.\\nIl Calpestatore Topiario non può attaccare o bloccare a meno che tu non controlli sette o più terre.', 'type': 'Creatura — Dinosauro Pianta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558468&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '549b4745-ff24-4c4d-b821-a6f9f5f15e76', 'multiverseId': 558468}, 'multiverseid': 558468}, {'name': '装飾庭園を踏み歩くもの', 'text': '警戒\\n装飾庭園を踏み歩くものが戦場に出たとき、あなたのライブラリーから基本土地・カード１枚を探し、タップ状態で戦場に出し、その後ライブラリーを切り直す。\\nあなたが７つ以上の土地をコントロールしていないかぎり、装飾庭園を踏み歩くものでは攻撃もブロックもできない。', 'type': 'クリーチャー — 植物・恐竜', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558479&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'd0bca729-7ba5-45b8-b8f1-c195eaa881e4', 'multiverseId': 558479}, 'multiverseid': 558479}, {'name': '장식 야수', 'text': '경계\\n장식 야수가 전장에 들어올 때, 당신의 서고에서 기본 대지 카드 한 장을 찾아, 탭된 상태로 전장에 놓은 후, 서고를 섞는다.\\n장식 야수는 당신이 대지를 일곱 개 이상 조종하지 않는 한 공격 또는 방어할 수 없다.', 'type': '생물 — 식물 공룡', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558490&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '7236a3cf-46e4-4ebb-aa50-3edd68d5043d', 'multiverseId': 558490}, 'multiverseid': 558490}, {'name': 'Pisoteador de Topiaria', 'text': 'Vigilância\\nQuando Pisoteador de Topiaria entrar no campo de batalha, procure em seu grimório um card de terreno básico, coloque-o no campo de batalha virado e depois embaralhe.\\nPisoteador de Topiaria não pode atacar nem bloquear, a menos que você controle sete ou mais terrenos.', 'type': 'Criatura — Planta Dinossauro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558501&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3b909183-87cf-4758-9a40-23e9c4998cab', 'multiverseId': 558501}, 'multiverseid': 558501}, {'name': 'Топиарный Тяжелоступ', 'text': 'Бдительность\\nКогда Топиарный Тяжелоступ выходит на поле битвы, найдите в вашей библиотеке карту базовой земли, положите ее на поле битвы повернутой, затем перетасуйте библиотеку.\\nТопиарный Тяжелоступ не может атаковать или блокировать, если вы контролируете менее семи земель.', 'type': 'Существо — Растение Динозавр', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558512&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '5f793fa2-f51d-4459-9e85-6f3910b7b0b9', 'multiverseId': 558512}, 'multiverseid': 558512}, {'name': '绿雕跺地兽', 'text': '警戒\\n当绿雕跺地兽进战场时，从你牌库中搜寻一张基本地牌，将之横置放进战场，然后洗牌。\\n除非你操控七个或更多地，否则绿雕跺地兽不能进行攻击或阻挡。', 'type': '生物 ～植物／恐龙', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558523&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '2d6d4d10-06e6-4232-80db-ef4af177a4ac', 'multiverseId': 558523}, 'multiverseid': 558523}, {'name': '綠雕跺地獸', 'text': '警戒\\n當綠雕跺地獸進戰場時，從你牌庫中搜尋一張基本地牌，將之橫置放進戰場，然後洗牌。\\n除非你操控七個或更多地，否則綠雕跺地獸不能進行攻擊或阻擋。', 'type': '生物 ～植物／恐龍', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558534&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '6ef3422d-88a7-45e4-9644-a546a954b21a', 'multiverseId': 558534}, 'multiverseid': 558534}]", "[{'name': 'Treffen der Fünf', 'text': 'Schicke die obersten zehn Karten deiner Bibliothek ins Exil. Du kannst davon in diesem Zug dreifarbige Zaubersprüche wirken. Erzeuge {W}{W}{U}{U}{B}{B}{R}{R}{G}{G}. Gib dieses Mana nur aus, um dreifarbige Zaubersprüche zu wirken.', 'type': 'Hexerei', 'flavor': 'Jahrelang beherrschten die fünf Familien Neu-Capenna in fragilem Frieden, und die Stadt florierte.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555664&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5d3dca4b-b70b-4a42-bc58-48e76d99428c', 'multiverseId': 555664}, 'multiverseid': 555664}, {'name': 'Reunión de las cinco', 'text': 'Exilia las diez primeras cartas de tu biblioteca. Puedes lanzar hechizos de exactamente tres colores de entre ellas este turno. Agrega {W}{W}{U}{U}{B}{B}{R}{R}{G}{G}. Usa este maná solo para lanzar hechizos de exactamente tres colores.', 'type': 'Conjuro', 'flavor': 'Durante muchos años, las cinco familias gobernaron Nueva Capenna con una paz incierta, y la ciudad prosperó.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555925&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'b4ef4ec3-2293-4632-865b-25f962a15a72', 'multiverseId': 555925}, 'multiverseid': 555925}, {'name': 'Réunion des Cinq', 'text': 'Exilez les dix cartes du dessus de votre bibliothèque. Vous pouvez lancer les sorts avec exactement trois couleurs parmi elles ce tour-ci. Ajoutez {W}{W}{U}{U}{B}{B}{R}{R}{G}{G}. Ne dépensez ce mana que pour lancer des sorts avec exactement trois couleurs.', 'type': 'Rituel', 'flavor': 'Pendant des années, les cinq familles régnèrent sur la Nouvelle-Capenna dans une paix fragile, et la ville prospéra.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556186&type=card', 'language': 'French', 'identifiers': {'scryfallId': '347c8df6-ec21-4b0b-8cb6-e25f1a07bf64', 'multiverseId': 556186}, 'multiverseid': 556186}, {'name': 'Incontro dei Cinque', 'text': 'Esilia le prime dieci carte del tuo grimorio. Puoi lanciare magie che hanno esattamente tre colori scelte tra esse in questo turno. Aggiungi {W}{W}{U}{U}{B}{B}{R}{R}{G}{G}. Spendi questo mana solo per lanciare magie che hanno esattamente tre colori.', 'type': 'Stregoneria', 'flavor': 'Per anni, le cinque famiglie governarono Nuova Capenna in una pace precaria e la città prosperò.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556447&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '2bbfee19-681f-4bf3-8342-b47e21747953', 'multiverseId': 556447}, 'multiverseid': 556447}, {'name': '五者会談', 'text': 'あなたのライブラリーの一番上にあるカード10枚を追放する。このターン、それらの中からちょうど３色である任意の数の呪文を唱えてもよい。{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}を加える。このマナはちょうど３色である呪文を唱えるためにしか支払えない。', 'type': 'ソーサリー', 'flavor': '何年にもわたって五大一家はニューカペナを不安定な平和の中で支配し、都市は繁栄した。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556708&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'db9b6319-749e-4ba9-a76a-6fa943f7a22c', 'multiverseId': 556708}, 'multiverseid': 556708}, {'name': '다섯 명의 회합', 'text': '당신의 서고 맨 위 카드 열 장을 추방한다. 이 턴에 당신은 그중 정확히 색이 세 개 있는 주문들을 발동할 수 있다. {W}{W}{U}{U}{B}{B}{R}{R}{G}{G}를 추가한다. 이 마나는 정확히 색이 세 개 있는 주문들을 발동하는 데만 사용할 수 있다.', 'type': '집중마법', 'flavor': '여러 해 동안, 다섯 패밀리는 불안정한 평화 속에서 뉴 카펜나를 통치했고, 도시는 번창했다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556969&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '26e2884e-e9ff-4c4b-8e2a-cf336954d781', 'multiverseId': 556969}, 'multiverseid': 556969}, {'name': 'Reunião dos Cinco', 'text': 'Exile os dez cards do topo de seu grimório. Você pode conjurar mágicas com exatamente três cores dentre eles neste turno. Adicione {W}{W}{U}{U}{B}{B}{R}{R}{G}{G}. Gaste este mana somente para conjurar mágicas com exatamente três cores.', 'type': 'Feitiço', 'flavor': 'As cinco famílias governaram Nova Capenna numa paz tensa por anos, e a cidade prosperou.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557230&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3aa2d2c4-000d-4a90-a03d-385a38c225ef', 'multiverseId': 557230}, 'multiverseid': 557230}, {'name': 'Встреча Пятерых', 'text': 'Изгоните десять верхних карт вашей библиотеки. В этом ходу вы можете разыгрывать находящиеся среди них заклинания, у которых ровно три цвета. Добавьте {W}{W}{U}{U}{B}{B}{R}{R}{G}{G}. Тратьте эту ману только на разыгрывание заклинаний, у которых ровно три цвета.', 'type': 'Волшебство', 'flavor': 'Долгие годы пять семей правили Новой Капенной, поддерживая хрупкий мир, и город процветал.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557491&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'a919d329-0a52-43c6-aa91-f9cef1819071', 'multiverseId': 557491}, 'multiverseid': 557491}, {'name': '五霸会晤', 'text': '放逐你牌库顶的十张牌。本回合中，你可以从其中施放正好为三色的咒语。加{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}。此法术力只能用来施放正好为三色的咒语。', 'type': '法术', 'flavor': '多年来，五大家族统治着新卡佩纳，此城在脆弱的和平中繁荣发展。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557752&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c21be289-8878-455c-a89b-2c2ff814230a', 'multiverseId': 557752}, 'multiverseid': 557752}, {'name': '五霸會晤', 'text': '放逐你牌庫頂的十張牌。本回合中，你可以從其中施放正好為三色的咒語。加{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}。此魔法力只能用來施放正好為三色的咒語。', 'type': '巫術', 'flavor': '多年來，五大家族統治著新卡佩納，此城在脆弱的和平中繁榮發展。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558013&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'e7dc6c75-f904-4513-9e0e-0fbaa5209eae', 'multiverseId': 558013}, 'multiverseid': 558013}]", "[{'name': 'Treffen der Fünf', 'text': 'Schicke die obersten zehn Karten deiner Bibliothek ins Exil. Du kannst davon in diesem Zug dreifarbige Zaubersprüche wirken. Erzeuge {W}{W}{U}{U}{B}{B}{R}{R}{G}{G}. Gib dieses Mana nur aus, um dreifarbige Zaubersprüche zu wirken.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558309&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'dc8a9dc3-9182-4903-8591-9774c98a5bee', 'multiverseId': 558309}, 'multiverseid': 558309}, {'name': 'Réunion des Cinq', 'text': 'Exilez les dix cartes du dessus de votre bibliothèque. Vous pouvez lancer les sorts avec exactement trois couleurs parmi elles ce tour-ci. Ajoutez {W}{W}{U}{U}{B}{B}{R}{R}{G}{G}. Ne dépensez ce mana que pour lancer des sorts avec exactement trois couleurs.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558344&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b0e19b2d-6de9-409f-ac95-9b16fc147041', 'multiverseId': 558344}, 'multiverseid': 558344}, {'name': '五者会談', 'text': 'あなたのライブラリーの一番上にあるカード10枚を追放する。このターン、それらの中からちょうど３色である任意の数の呪文を唱えてもよい。{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}を加える。このマナはちょうど３色である呪文を唱えるためにしか支払えない。', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558379&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '0f7c037d-c3c4-4c52-95e8-36571e53a93b', 'multiverseId': 558379}, 'multiverseid': 558379}, {'name': '五霸会晤', 'text': '放逐你牌库顶的十张牌。本回合中，你可以从其中施放正好为三色的咒语。加{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}。此法术力只能用来施放正好为三色的咒语。', 'type': '法术', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558414&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9db190d1-c20e-489e-8a56-e78ac3bda47e', 'multiverseId': 558414}, 'multiverseid': 558414}]", '[{\'name\': \'Tödlicher Groll\', \'text\': \'Opfere eine bleibende Karte, die kein Land ist, als zusätzliche Kosten, um diesen Zauberspruch zu wirken.\\nJeder Gegner bestimmt eine bleibende Karte, die er kontrolliert und die einen Typ mit der geopferten bleibenden Karte gemeinsam hat, und opfert sie.\\nZiehe eine Karte.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555649&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'566fe343-aa83-42ec-b8a5-c20f0398dc7f\', \'multiverseId\': 555649}, \'multiverseid\': 555649}, {\'name\': \'Rencor letal\', \'text\': \'Como coste adicional para lanzar este hechizo, sacrifica un permanente que no sea tierra.\\nCada oponente elige un permanente que controla que comparta un tipo con el permanente sacrificado y lo sacrifica.\\nRoba una carta.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555910&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'26b08562-9267-4a75-9102-0534c3b5e79b\', \'multiverseId\': 555910}, \'multiverseid\': 555910}, {\'name\': \'Rancœur fatale\', \'text\': "En tant que coût supplémentaire pour lancer ce sort, sacrifiez un permanent non-terrain.\\nChaque adversaire choisit un permanent qu\'il contrôle qui partage un type avec le permanent sacrifié et le sacrifie.\\nPiochez une carte.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556171&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d034a153-9d37-4d2f-8871-ca72381c5bb4\', \'multiverseId\': 556171}, \'multiverseid\': 556171}, {\'name\': \'Rancore Fatale\', \'text\': \'Come costo addizionale per lanciare questa magia, sacrifica un permanente non terra.\\nOgni avversario sceglie un permanente che controlla che condivide un tipo con il permanente sacrificato e lo sacrifica.\\nPesca una carta.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556432&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6835a712-69f5-49b8-a280-56ee1a012495\', \'multiverseId\': 556432}, \'multiverseid\': 556432}, {\'name\': \'致命的遺恨\', \'text\': \'この呪文を唱えるための追加コストとして、土地でないパーマネント１つを生け贄に捧げる。\\n各対戦相手はそれぞれ、その生け贄に捧げられたパーマネントと共通のタイプを持ち自分がコントロールしているパーマネント１つを選び、それを生け贄に捧げる。\\nカード１枚を引く。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556693&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'abdeed1b-219e-4b79-b4b8-d779c98db68c\', \'multiverseId\': 556693}, \'multiverseid\': 556693}, {\'name\': \'치명적인 원한\', \'text\': \'이 주문을 발동하기 위한 추가비용으로, 대지가 아닌 지속물 한 개를 희생한다.\\n각 상대는 자신이 조종하며 희생된 지속물과 유형을 공유하는 지속물 한 개를 선택하고 그 지속물을 희생한다.\\n카드 한 장을 뽑는다.\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556954&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a177aeb2-1acc-4378-8037-9a6ba3c4f3f6\', \'multiverseId\': 556954}, \'multiverseid\': 556954}, {\'name\': \'Rancor Fatal\', \'text\': \'Como custo adicional para conjurar esta mágica, sacrifique uma permanente não de terreno.\\nCada oponente escolhe uma permanente que ele controla que compartilhe um tipo com a permanente sacrificada e a sacrifica.\\nCompre um card.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557215&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4f987711-4df8-4f27-9f07-1e53cfa53708\', \'multiverseId\': 557215}, \'multiverseid\': 557215}, {\'name\': \'Роковая Вражда\', \'text\': \'В качестве дополнительной стоимости разыгрывания этого заклинания пожертвуйте не являющийся землей перманент.\\nКаждый оппонент выбирает один перманент под своим контролем, у которого есть такой же тип, как у пожертвованного перманента, и жертвует его.\\nВозьмите карту.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557476&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'04a01751-9136-4b56-9748-c70ed161c50c\', \'multiverseId\': 557476}, \'multiverseid\': 557476}, {\'name\': \'致命怀恨\', \'text\': \'牺牲一个非地永久物，以作为施放此咒语的额外费用。\\n每位对手各选择一个由其操控的永久物，且其须与所牺牲永久物具有共通的牌张类别，并将它牺牲。\\n抓一张牌。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557737&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'45a73f15-c069-48aa-ab67-ab7cf8561f30\', \'multiverseId\': 557737}, \'multiverseid\': 557737}, {\'name\': \'致命懷恨\', \'text\': \'犧牲一個非地永久物，以作為施放此咒語的額外費用。\\n每位對手各選擇一個由其操控的永久物，且其須與所犧牲永久物具有共通的牌張類別，並將它犧牲。\\n抽一張牌。\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557998&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8ecba2b9-747d-42ef-aef1-baf33c9cf1fe\', \'multiverseId\': 557998}, \'multiverseid\': 557998}]', '[{\'name\': \'Umnieten\', \'text\': \'Dieser Zauberspruch kostet beim Wirken {3} weniger, falls er eine weiße Kreatur als Ziel hat.\\nEine Kreatur deiner Wahl erhält -4/-4 bis zum Ende des Zuges.\', \'type\': \'Hexerei\', \'flavor\': \'„Es ist rein geschäftlich. Du verstehst schon."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555561&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'85b17e99-52d2-4d35-b6b0-400667bd7376\', \'multiverseId\': 555561}, \'multiverseid\': 555561}, {\'name\': \'Descarga\', \'text\': \'Te cuesta {3} menos lanzar este hechizo si hace objetivo a una criatura blanca.\\nLa criatura objetivo obtiene -4/-4 hasta el final del turno.\', \'type\': \'Conjuro\', \'flavor\': \'"Son negocios, nada más. Sé que lo entiendes".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555822&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9b3ee4d2-ff2b-425d-97f3-5fd39cdedec8\', \'multiverseId\': 555822}, \'multiverseid\': 555822}, {\'name\': \'Dérouillage\', \'text\': "Ce sort coûte {3} de moins à lancer s\'il cible une créature blanche.\\nUne créature ciblée gagne -4/-4 jusqu\'à la fin du tour.", \'type\': \'Rituel\', \'flavor\': "« N\'y vois rien de personnel. Tu me comprends. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556083&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'eda273ee-1be2-447b-9b4f-3a6ff8435339\', \'multiverseId\': 556083}, \'multiverseid\': 556083}, {\'name\': \'Sberla\', \'text\': \'Questa magia costa {3} in meno per essere lanciata se bersaglia una creatura bianca.\\nUna creatura bersaglio prende -4/-4 fino alla fine del turno.\', \'type\': \'Stregoneria\', \'flavor\': \'"Sono solo affari. Lo capisci, vero?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556344&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'38483929-1362-4c8c-a715-ae71e3aa27c4\', \'multiverseId\': 556344}, \'multiverseid\': 556344}, {\'name\': \'鞭打\', \'text\': \'この呪文が白のクリーチャーを対象としているなら、これを唱えるためのコストは{3}少なくなる。\\nクリーチャー１体を対象とする。ターン終了時まで、それは－４/－４の修整を受ける。\', \'type\': \'ソーサリー\', \'flavor\': \'「仕事なのよ。わかってるでしょ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556605&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b948c737-12fb-41a0-ba0e-b79a6f51b1fb\', \'multiverseId\': 556605}, \'multiverseid\': 556605}, {\'name\': \'후려패기\', \'text\': \'이 주문이 백색 생물을 목표로 한다면 이 주문은 발동하는 데 {3}이 덜 든다.\\n생물을 목표로 정한다. 그 생물은 턴종료까지 -4/-4를 받는다.\', \'type\': \'집중마법\', \'flavor\': \'"그저 사업일 뿐이야. 너도 이해하잖아."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556866&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5fb2570c-003a-425e-bfee-a88137ae9cb5\', \'multiverseId\': 556866}, \'multiverseid\': 556866}, {\'name\': \'Fustigar\', \'text\': \'Esta mágica custará {3} a menos para ser conjurada se tiver uma criatura branca como alvo.\\nA criatura alvo recebe -4/-4 até o final do turno.\', \'type\': \'Feitiço\', \'flavor\': \'"Só negócios. Você entende, não é?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557127&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ba793263-d3f8-4c04-9a5b-568a4fdd20a0\', \'multiverseId\': 557127}, \'multiverseid\': 557127}, {\'name\': \'Звучный Удар\', \'text\': \'Разыгрывание этого заклинания стоит на {3} меньше, если его целью является белое существо.\\nЦелевое существо получает -4/-4 до конца хода.\', \'type\': \'Волшебство\', \'flavor\': \'«Пойми, это просто бизнес».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557388&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'98c4e311-a9b0-46ce-a82e-9cbcbecb177c\', \'multiverseId\': 557388}, \'multiverseid\': 557388}, {\'name\': \'背地重击\', \'text\': \'如果此咒语以白色生物为目标，则它减少{3}来施放。\\n目标生物得-4/-4直到回合结束。\', \'type\': \'法术\', \'flavor\': \'「公事公办而已。你懂的。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557649&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'65d9f641-6548-489f-b406-5c9cef0261d8\', \'multiverseId\': 557649}, \'multiverseid\': 557649}, {\'name\': \'背地重擊\', \'text\': \'如果此咒語以白色生物為目標，則它減少{3}來施放。\\n目標生物得-4/-4直到回合結束。\', \'type\': \'巫術\', \'flavor\': \'「公事公辦而已。你懂的。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557910&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'897cbee8-c9a8-4abf-9a8f-6a99e5901523\', \'multiverseId\': 557910}, \'multiverseid\': 557910}]', '[{\'name\': \'Umnieter-Amulett\', \'text\': \'Bestimme eines —\\n• Ein Gegner deiner Wahl opfert die Kreatur oder den Planeswalker mit dem höchsten Manabetrag unter den Kreaturen und Planeswalkern, die er kontrolliert.\\n• Schicke die obersten drei Karten deiner Bibliothek ins Exil. Du kannst die Karten bis zu deinem nächsten Endsegment spielen.\\n• Schicke den Friedhof eines Spielers deiner Wahl ins Exil.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555679&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'db2e47dc-a760-4f81-b487-f77d76459225\', \'multiverseId\': 555679}, \'multiverseid\': 555679}, {\'name\': \'Amuleto de los Remachadores\', \'text\': \'Elige uno:\\n• El oponente objetivo sacrifica una criatura o un planeswalker que controla con el valor de maná más alto entre las criaturas y planeswalkers que controla.\\n• Exilia las tres primeras cartas de tu biblioteca. Hasta tu próximo paso final, puedes jugar esas cartas.\\n• Exilia el cementerio del jugador objetivo.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555940&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5b5f6d8a-4053-4cd3-9227-fa3ce8b56e66\', \'multiverseId\': 555940}, \'multiverseid\': 555940}, {\'name\': \'Charme des Riveteurs\', \'text\': "Choisissez l\'un —\\n• Un adversaire ciblé sacrifie une créature ou un planeswalker qu\'il contrôle avec la valeur de mana la plus élevée parmi les créatures et les planeswalkers qu\'il contrôle.\\n• Exilez les trois cartes du dessus de votre bibliothèque. Jusqu\'à votre prochaine étape de fin, vous pouvez jouer ces cartes.\\n• Exilez le cimetière d\'un joueur ciblé.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556201&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bc6739a6-e0c3-4727-89aa-fb57a948fe54\', \'multiverseId\': 556201}, \'multiverseid\': 556201}, {\'name\': \'Talismano dei Rivettatori\', \'text\': \'Scegli uno —\\n• Un avversario bersaglio sacrifica una creatura o un planeswalker che controlla con il valore di mana maggiore tra le creature e i planeswalker che controlla.\\n• Esilia le prime tre carte del tuo grimorio. Fino alla tua prossima sottofase finale, puoi giocare quelle carte.\\n• Esilia il cimitero di un giocatore bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556462&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6aa1121c-1976-4e71-9c59-27d8e2573ffa\', \'multiverseId\': 556462}, \'multiverseid\': 556462}, {\'name\': \'土建組一家の魔除け\', \'text\': \'以下から１つを選ぶ。\\n• 対戦相手１人を対象とする。そのプレイヤーは、自分がコントロールしているすべてのクリーチャーやプレインズウォーカーの中で最大のマナ総量を持つクリーチャーやプレインズウォーカーのうち１体を生け贄に捧げる。\\n• あなたのライブラリーの一番上にあるカード３枚を追放する。次のあなたの終了ステップまで、あなたはそれらのカードをプレイしてもよい。\\n• プレイヤー１人を対象とする。そのプレイヤーの墓地を追放する。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556723&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'25da8f8a-a9df-419a-80d3-4607f714a3dd\', \'multiverseId\': 556723}, \'multiverseid\': 556723}, {\'name\': \'리베티어즈 부적\', \'text\': \'하나를 선택한다 —\\n• 상대를 목표로 정한다. 그 플레이어는 자신이 조종하는 생물 및 플레인즈워커 중 가장 높은 마나 값을 가진 생물 또는 플레인즈워커 한 개를 희생한다.\\n• 당신의 서고 맨 위 카드 세 장을 추방한다. 당신의 다음 종료단까지, 당신은 그 카드들을 플레이할 수 있다.\\n• 플레이어를 목표로 정한다. 그 플레이어의 무덤을 추방한다.\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556984&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b5016ac6-0655-43e8-b516-7856f0330343\', \'multiverseId\': 556984}, \'multiverseid\': 556984}, {\'name\': \'Amuleto dos Rebiteiros\', \'text\': \'Escolha um —\\n• O oponente alvo sacrifica uma criatura ou um planeswalker que ele controla com o maior valor de mana entre os das criaturas e dos planeswalkers que ele controla.\\n• Exile os três cards do topo de seu grimório. Até sua próxima etapa final, você pode jogar aqueles cards.\\n• Exile o cemitério do jogador alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557245&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dad7ec88-b2c6-4757-812f-5f01c5a45365\', \'multiverseId\': 557245}, \'multiverseid\': 557245}, {\'name\': \'Талисман Клепальщиков\', \'text\': "Выберите одно —\\n• Целевой оппонент жертвует существо или planeswalker\'а под своим контролем с наибольшей мановой ценностью среди существ и planeswalker\'ов под его контролем.\\n• Изгоните три верхние карты вашей библиотеки. До вашего следующего заключительного шага вы можете разыграть те карты.\\n• Изгоните кладбище целевого игрока.", \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557506&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d3ea9771-3767-4ebe-b78e-a0d32d363655\', \'multiverseId\': 557506}, \'multiverseid\': 557506}, {\'name\': \'勤工联护符\', \'text\': \'选择一项～\\n•目标对手牺牲一个由其操控的生物或鹏洛客，且须是由其操控的生物和鹏洛客中法术力值最大者。\\n•放逐你牌库顶的三张牌。直到你的下一个结束步骤，你可以使用这些牌。\\n•放逐目标牌手的坟墓场。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557767&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'19802331-dc52-4c0f-a067-5167bffcfdf6\', \'multiverseId\': 557767}, \'multiverseid\': 557767}, {\'name\': \'勤工聯護符\', \'text\': \'選擇一項～\\n•目標對手犧牲一個由其操控的生物或鵬洛客，且須是由其操控的生物和鵬洛客中魔法力值最大者。\\n•放逐你牌庫頂的三張牌。直到你的下一個結束步驟，你可以使用這些牌。\\n•放逐目標玩家的墳墓場。\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558028&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9610dce8-ca27-4953-a285-e037c8f42121\', \'multiverseId\': 558028}, \'multiverseid\': 558028}]', '[{\'name\': \'Umnieter-Amulett\', \'text\': \'Bestimme eines —\\n• Ein Gegner deiner Wahl opfert die Kreatur oder den Planeswalker mit dem höchsten Manabetrag unter den Kreaturen und Planeswalkern, die er kontrolliert.\\n• Schicke die obersten drei Karten deiner Bibliothek ins Exil. Du kannst die Karten bis zu deinem nächsten Endsegment spielen.\\n• Schicke den Friedhof eines Spielers deiner Wahl ins Exil.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558774&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6425752c-c9be-4295-ac83-5e34298b954a\', \'multiverseId\': 558774}, \'multiverseid\': 558774}, {\'name\': \'Amuleto de los Remachadores\', \'text\': \'Elige uno:\\n• El oponente objetivo sacrifica una criatura o un planeswalker que controla con el valor de maná más alto entre las criaturas y planeswalkers que controla.\\n• Exilia las tres primeras cartas de tu biblioteca. Hasta tu próximo paso final, puedes jugar esas cartas.\\n• Exilia el cementerio del jugador objetivo.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558819&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9183769a-fc9a-47eb-a881-b23f7f205bae\', \'multiverseId\': 558819}, \'multiverseid\': 558819}, {\'name\': \'Charme des Riveteurs\', \'text\': "Choisissez l\'un —\\n• Un adversaire ciblé sacrifie une créature ou un planeswalker qu\'il contrôle avec la valeur de mana la plus élevée parmi les créatures et les planeswalkers qu\'il contrôle.\\n• Exilez les trois cartes du dessus de votre bibliothèque. Jusqu\'à votre prochaine étape de fin, vous pouvez jouer ces cartes.\\n• Exilez le cimetière d\'un joueur ciblé.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558864&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'be475d8f-8d91-4f31-a6a6-32ccaa23b992\', \'multiverseId\': 558864}, \'multiverseid\': 558864}, {\'name\': \'Talismano dei Rivettatori\', \'text\': \'Scegli uno —\\n• Un avversario bersaglio sacrifica una creatura o un planeswalker che controlla con il valore di mana maggiore tra le creature e i planeswalker che controlla.\\n• Esilia le prime tre carte del tuo grimorio. Fino alla tua prossima sottofase finale, puoi giocare quelle carte.\\n• Esilia il cimitero di un giocatore bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558909&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'585f8c9a-b2f8-49bd-b5b8-45b08400d309\', \'multiverseId\': 558909}, \'multiverseid\': 558909}, {\'name\': \'土建組一家の魔除け\', \'text\': \'以下から１つを選ぶ。\\n• 対戦相手１人を対象とする。そのプレイヤーは、自分がコントロールしているすべてのクリーチャーやプレインズウォーカーの中で最大のマナ総量を持つクリーチャーやプレインズウォーカーのうち１体を生け贄に捧げる。\\n• あなたのライブラリーの一番上にあるカード３枚を追放する。次のあなたの終了ステップまで、あなたはそれらのカードをプレイしてもよい。\\n• プレイヤー１人を対象とする。そのプレイヤーの墓地を追放する。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558954&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'16c79c11-7d23-455e-92da-c82ef9e1b8e9\', \'multiverseId\': 558954}, \'multiverseid\': 558954}, {\'name\': \'리베티어즈 부적\', \'text\': \'하나를 선택한다 —\\n• 상대를 목표로 정한다. 그 플레이어는 자신이 조종하는 생물 및 플레인즈워커 중 가장 높은 마나 값을 가진 생물 또는 플레인즈워커 한 개를 희생한다.\\n• 당신의 서고 맨 위 카드 세 장을 추방한다. 당신의 다음 종료단까지, 당신은 그 카드들을 플레이할 수 있다.\\n• 플레이어를 목표로 정한다. 그 플레이어의 무덤을 추방한다.\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558999&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'83315874-ef8b-47e4-a1e6-cc7952ed7dc1\', \'multiverseId\': 558999}, \'multiverseid\': 558999}, {\'name\': \'Amuleto dos Rebiteiros\', \'text\': \'Escolha um —\\n• O oponente alvo sacrifica uma criatura ou um planeswalker que ele controla com o maior valor de mana entre os das criaturas e dos planeswalkers que ele controla.\\n• Exile os três cards do topo de seu grimório. Até sua próxima etapa final, você pode jogar aqueles cards.\\n• Exile o cemitério do jogador alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559044&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9240148a-d60e-4896-8860-749a3c34d93e\', \'multiverseId\': 559044}, \'multiverseid\': 559044}, {\'name\': \'Талисман Клепальщиков\', \'text\': "Выберите одно —\\n• Целевой оппонент жертвует существо или planeswalker\'а спод своим контролем снаибольшей мановой ценностью среди существ и planeswalker\'ов под его контролем.\\n• Изгоните три верхние карты вашей библиотеки. До вашего следующего заключительного шага вы можете разыграть те карты.\\n• Изгоните кладбище целевого игрока.", \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559089&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'110e40e0-3ce8-4447-9537-e54325a17286\', \'multiverseId\': 559089}, \'multiverseid\': 559089}, {\'name\': \'勤工联护符\', \'text\': \'选择一项～\\n•目标对手牺牲一个由其操控的生物或鹏洛客，且须是由其操控的生物和鹏洛客中法术力值最大者。\\n•放逐你牌库顶的三张牌。直到你的下一个结束步骤，你可以使用这些牌。\\n•放逐目标牌手的坟墓场。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559134&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c2d0c4c8-2396-43bf-bc71-a1bb72ce65fd\', \'multiverseId\': 559134}, \'multiverseid\': 559134}, {\'name\': \'勤工聯護符\', \'text\': \'選擇一項～\\n•目標對手犧牲一個由其操控的生物或鵬洛客，且須是由其操控的生物和鵬洛客中魔法力值最大者。\\n•放逐你牌庫頂的三張牌。直到你的下一個結束步驟，你可以使用這些牌。\\n•放逐目標玩家的墳墓場。\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559179&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fdaf7406-bfbd-4f28-adae-57dd2d3e077d\', \'multiverseId\': 559179}, \'multiverseid\': 559179}]', '[{\'name\': \'Umnieter-Eingeweihter\', \'text\': \'{1}{B/G}: Der Umnieter-Eingeweihte erhält Todesberührung bis zum Ende des Zuges.\', \'type\': \'Kreatur — Viashino, Bürger\', \'flavor\': \'Junge Viashinos schließen sich wegen Ziatoras Führung in Scharen den Umnietern an und wollen die Drachen entfesseln, die in ihnen stecken.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555582&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'81c1e469-3514-4e33-9582-27cfefd2e822\', \'multiverseId\': 555582}, \'multiverseid\': 555582}, {\'name\': \'Novato de los Remachadores\', \'text\': \'{1}{B/G}: El Novato de los Remachadores gana la habilidad de toque mortal hasta el final del turno.\', \'type\': \'Criatura — Ciudadano viashino\', \'flavor\': \'Ansiosos por desatar al dragón que llevan dentro, los viashino jóvenes acuden en manada a los Remachadores por el liderazgo de Ziatora.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555843&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'58de0774-a33d-41d9-be6c-668a42095888\', \'multiverseId\': 555843}, \'multiverseid\': 555843}, {\'name\': \'Adepte des Riveteurs\', \'text\': "{1}{B/G} : L\'Adepte des Riveteurs acquiert le contact mortel jusqu\'à la fin du tour.", \'type\': \'Créature : viashino et citoyen\', \'flavor\': \'Les jeunes viashinos affluent chez les Riveteurs pour être guidés par Ziatora, désireux de libérer le dragon en eux.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556104&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d86bce30-e7d9-4031-8c82-99ebcc04071b\', \'multiverseId\': 556104}, \'multiverseid\': 556104}, {\'name\': \'Iniziato dei Rivettatori\', \'text\': "{1}{B/G}: L\'Iniziato dei Rivettatori ha tocco letale fino alla fine del turno.", \'type\': \'Creatura — Cittadino Viashino\', \'flavor\': \'I giovani viashino accorrono tra le file dei Rivettatori per la leadership di Ziatora, desiderosi di scatenare i loro draghi interiori.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556365&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7cbcdf2b-57f8-426e-83a2-88ce68243103\', \'multiverseId\': 556365}, \'multiverseid\': 556365}, {\'name\': \'土建組一家の新入り\', \'text\': \'{1}{B/G}：ターン終了時まで、土建組一家の新入りは接死を得る。\', \'type\': \'クリーチャー — ヴィーアシーノ・市民\', \'flavor\': \'ジアトラの統率力を求めて若きヴィーアシーノたちが土建組一家に押しかけ、自分の内なるドラゴンを解放したがっている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556626&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'68bfe5c2-2a34-4692-ad79-dcf89e7363e4\', \'multiverseId\': 556626}, \'multiverseid\': 556626}, {\'name\': \'리베티어즈 입회자\', \'text\': \'{1}{B/G}: 리베티어즈 입회자는 턴종료까지 치명타를 얻는다.\', \'type\': \'생물 — 비아시노 시민\', \'flavor\': \'젊은 비아시노들은 자신의 내면에 있는 용을 해방하고자 지아토라의 지도력을 찾아 리베티어즈에 모여든다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556887&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4992b39a-9091-4da2-abaa-7cd7f8f7b96d\', \'multiverseId\': 556887}, \'multiverseid\': 556887}, {\'name\': \'Iniciado dos Rebiteiros\', \'text\': \'{1}{B/G}: Iniciado dos Rebiteiros ganha toque mortífero até o final do turno.\', \'type\': \'Criatura — Viashino Cidadão\', \'flavor\': \'Ansiosos para libertar seus dragões interiores, os viashinos jovens são atraídos pelos Rebiteiros graças à liderança de Ziatora.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557148&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'44356313-c8be-41e0-a049-0a3deee348a9\', \'multiverseId\': 557148}, \'multiverseid\': 557148}, {\'name\': \'Новичок Клепальщиков\', \'text\': \'{1}{B/G}: Новичок Клепальщиков получает Смертельное касание до конца хода.\', \'type\': \'Существо — Виашино Гражданин\', \'flavor\': \'Юные виашино приходят к Клепальщикам под крыло Зиаторы, стремясь пробудить своих внутренних драконов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557409&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b1a56cd1-32ab-41f7-953f-41c9bf3a6c47\', \'multiverseId\': 557409}, \'multiverseid\': 557409}, {\'name\': \'勤工联新手\', \'text\': \'{1}{B/G}：勤工联新手获得死触异能直到回合结束。\', \'type\': \'生物 ～凡尔西诺／市民\', \'flavor\': \'年轻的凡尔西诺蜂拥加入勤工联追随齐朵拉，渴望释放自己的龙性。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557670&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dcf44e12-1422-4968-a14c-dcbbf93bc9bb\', \'multiverseId\': 557670}, \'multiverseid\': 557670}, {\'name\': \'勤工聯新手\', \'text\': \'{1}{B/G}：勤工聯新手獲得死觸異能直到回合結束。\', \'type\': \'生物 ～凡爾西諾／市民\', \'flavor\': \'年輕的凡爾西諾蜂擁加入勤工聯追隨齊朵拉，渴望釋放自己的龍性。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557931&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f0fc09d5-d96e-4985-9f99-458eb872b9fd\', \'multiverseId\': 557931}, \'multiverseid\': 557931}]', '[{\'name\': \'Umnieter-Eintreiber\', \'text\': \'Wenn der Umnieter-Eintreiber stirbt, erzeuge einen Schatz-Spielstein. (Er ist ein Artefakt mit „{T}, opfere dieses Artefakt: Erzeuge ein Mana einer beliebigen Farbe.")\\nBlitz {2}{R} (Falls du diesen Zauberspruch für seine Blitz-Kosten wirkst, erhält er Eile und „Wenn diese Kreatur stirbt, ziehe eine Karte." Opfere diese Kreatur zu Beginn des nächsten Endsegments.)\', \'type\': \'Kreatur — Viashino, Räuber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555583&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4e3508b0-b371-4de4-9f55-7e16bc1a0c82\', \'multiverseId\': 555583}, \'multiverseid\': 555583}, {\'name\': \'Requisador de los Remachadores\', \'text\': \'Cuando el Requisador de los Remachadores muera, crea una ficha de Tesoro. (Es un artefacto con "{T}, sacrificar este artefacto: Agrega un maná de cualquier color".)\\nIrrupción {2}{R}. (Si lanzas este hechizo pagando su coste de irrupción, gana la habilidad de prisa y "Cuando esta criatura muera, roba una carta". Sacrifícala al comienzo del próximo paso final.)\', \'type\': \'Criatura — Bribón viashino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555844&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ba9a674a-0401-46e2-802a-48126136741c\', \'multiverseId\': 555844}, \'multiverseid\': 555844}, {\'name\': \'Réquisitionneur des Riveteurs\', \'text\': "Quand le Réquisitionneur des Riveteurs meurt, créez un jeton Trésor. (C\'est un artefact avec « {T}, sacrifiez cet artefact : Ajoutez un mana de la couleur de votre choix. »)\\nBlitz {2}{R} (Si vous lancez ce sort pour son coût de blitz, il acquiert la célérité et « Quand cette créature meurt, piochez une carte. » Sacrifiez-le au début de la prochaine étape de fin.)", \'type\': \'Créature : viashino et gredin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556105&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9b7c7860-2f9e-48ea-963b-59ea5bfb9dfa\', \'multiverseId\': 556105}, \'multiverseid\': 556105}, {\'name\': \'Requisitore dei Rivettatori\', \'text\': \'Quando il Requisitore dei Rivettatori muore, crea una pedina Tesoro. (È un artefatto con "{T}, Sacrifica questo artefatto: Aggiungi un mana di un qualsiasi colore".)\\nBlitz {2}{R} (Se lanci questa magia per il suo costo di blitz, ha rapidità e "Quando questa creatura muore, pesca una carta". Sacrificala all\\\'inizio della prossima sottofase finale.)\', \'type\': \'Creatura — Farabutto Viashino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556366&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'19755edb-2864-456d-acde-fe7f81f1247d\', \'multiverseId\': 556366}, \'multiverseid\': 556366}, {\'name\': \'土建組一家の調達者\', \'text\': \'土建組一家の調達者が死亡したとき、宝物・トークン１つを生成する。（それは、「{T}, このアーティファクトを生け贄に捧げる：好きな色１色のマナ１点を加える。」を持つアーティファクトである。）\\n奇襲{2}{R} （あなたがこの呪文を奇襲コストで唱えたなら、これは速攻と「このクリーチャーが死亡したとき、カード１枚を引く。」を得る。次の終了ステップの開始時に、これを生け贄に捧げる。）\', \'type\': \'クリーチャー — ヴィーアシーノ・ならず者\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556627&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'92987abe-eb4e-4e91-bdfe-96373bedb578\', \'multiverseId\': 556627}, \'multiverseid\': 556627}, {\'name\': \'리베티어즈 징발자\', \'text\': \'리베티어즈 징발자가 죽을 때, 보물 토큰 한 개를 만든다. (보물 토큰은 "{T}, 이 마법물체를 희생한다: 원하는 색의 마나 한 개를 추가한다."를 가진 마법물체이다.)\\n기습 {2}{R} (기습 비용을 지불해서 이 주문을 발동했다면, 이 생물은 신속 및 "이 생물이 죽을 때, 카드 한 장을 뽑는다."를 얻는다. 다음 종료단 시작에 이 생물을 희생한다.)\', \'type\': \'생물 — 비아시노 도적\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556888&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1775a45d-7347-4a7c-be81-fd4fd0798425\', \'multiverseId\': 556888}, \'multiverseid\': 556888}, {\'name\': \'Cobrador dos Rebiteiros\', \'text\': \'Quando Cobrador dos Rebiteiros morrer, crie uma ficha de Tesouro. (Ela é um artefato com "{T}, sacrifique este artefato: Adicione um mana de qualquer cor".)\\nBlitz {2}{R} (Se você conjura esta mágica por seu custo de blitz, ela ganha ímpeto e "Quando esta criatura morrer, compre um card". Sacrifique-a no início da próxima etapa final.)\', \'type\': \'Criatura — Viashino Ladino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557149&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3740b641-6566-418f-b2a6-e7f66ba53525\', \'multiverseId\': 557149}, \'multiverseid\': 557149}, {\'name\': \'Изыматель Клепальщиков\', \'text\': \'Когда Изыматель Клепальщиков умирает, создайте одну фишку Клада. (Это артефакт со способностью «{T}, пожертвуйте этот артефакт: добавьте одну ману любого цвета».)\\nБлиц {2}{R} (Если вы разыгрываете это заклинание за его стоимость Блица, оно получает Ускорение и способность «Когда это существо умирает, возьмите карту». Пожертвуйте его в начале следующего заключительного шага.)\', \'type\': \'Существо — Виашино Бродяга\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557410&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2715a279-af0a-4a7b-b1be-ef2676df94cf\', \'multiverseId\': 557410}, \'multiverseid\': 557410}, {\'name\': \'勤工联征用客\', \'text\': \'当勤工联征用客死去时，派出一个珍宝衍生物。（珍宝衍生物是具有「{T}，牺牲此神器：加一点任意颜色的法术力」的神器。）\\n急袭{2}{R}（如果你支付此咒语的急袭费用来施放之，则它获得敏捷与「当此生物死去时，抓一张牌。」在下一个结束步骤开始时，将它牺牲。）\', \'type\': \'生物 ～凡尔西诺／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557671&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f95182c8-1e18-4cd7-a6fa-0f3d5afecb76\', \'multiverseId\': 557671}, \'multiverseid\': 557671}, {\'name\': \'勤工聯徵用客\', \'text\': \'當勤工聯徵用客死去時，派出一個珍寶衍生物。（珍寶衍生物是具有「{T}，犧牲此神器：加一點任意顏色的魔法力」的神器。）\\n急襲{2}{R}（如果你支付此咒語的急襲費用來施放之，則它獲得敏捷與「當此生物死去時，抽一張牌。」在下一個結束步驟開始時，將它犧牲。）\', \'type\': \'生物 ～凡爾西諾／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557932&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ee6cbd43-139d-47ed-89b3-5da7279089e5\', \'multiverseId\': 557932}, \'multiverseid\': 557932}]', '[{\'name\': \'Unfreiwillige Anstellung\', \'text\': \'Übernimm bis zum Ende des Zuges die Kontrolle über eine Kreatur deiner Wahl. Enttappe sie. Sie erhält Eile bis zum Ende des Zuges. Erzeuge einen Schatz-Spielstein. (Er ist ein Artefakt mit „{T}, opfere dieses Artefakt: Erzeuge ein Mana einer beliebigen Farbe.")\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555572&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dc5f74ae-59bc-42e6-8cb2-ab184f4e3527\', \'multiverseId\': 555572}, \'multiverseid\': 555572}, {\'name\': \'Empleo forzoso\', \'text\': \'Gana el control de la criatura objetivo hasta el final del turno. Endereza esa criatura. Gana la habilidad de prisa hasta el final del turno. Crea una ficha de Tesoro. (Es un artefacto con "{T}, sacrificar este artefacto: Agrega un maná de cualquier color".)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555833&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a7fd1e3f-704c-4ea4-b78f-62e6ea19dee9\', \'multiverseId\': 555833}, \'multiverseid\': 555833}, {\'name\': \'Emploi involontaire\', \'text\': "Acquérez le contrôle d\'une créature ciblée jusqu\'à la fin du tour. Dégagez cette créature. Elle acquiert la célérité jusqu\'à la fin du tour. Créez un jeton Trésor. (C\'est un artefact avec « {T}, sacrifiez cet artefact : Ajoutez un mana de la couleur de votre choix. »)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556094&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6bb4e54e-063e-4a0f-a4b8-6b80955fe4fd\', \'multiverseId\': 556094}, \'multiverseid\': 556094}, {\'name\': \'Assunzione Involontaria\', \'text\': \'Prendi il controllo di una creatura bersaglio fino alla fine del turno. STAPpa quella creatura. Ha rapidità fino alla fine del turno. Crea una pedina Tesoro. (È un artefatto con "{T}, Sacrifica questo artefatto: Aggiungi un mana di un qualsiasi colore".)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556355&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3e85e8e2-aaf2-4899-b227-ee0f4cc052c9\', \'multiverseId\': 556355}, \'multiverseid\': 556355}, {\'name\': \'不本意な雇用\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それのコントロールを得る。そのクリーチャーをアンタップする。ターン終了時まで、それは速攻を得る。宝物・トークン１つを生成する。（それは、「{T}, このアーティファクトを生け贄に捧げる：好きな色１色のマナ１点を加える。」を持つアーティファクトである。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556616&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'21162ea0-e539-4655-8dab-554be9aab839\', \'multiverseId\': 556616}, \'multiverseid\': 556616}, {\'name\': \'원치 않은 취업\', \'text\': \'생물을 목표로 정한다. 턴종료까지 그 생물의 조종권을 얻는다. 그 생물은 언탭되고 턴종료까지 신속을 얻는다. 보물 토큰 한 개를 만든다. (보물 토큰은 "{T}, 이 마법물체를 희생한다: 원하는 색의 마나 한 개를 추가한다."를 가진 마법물체이다.)\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556877&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6669e694-1934-444a-886b-5f0948a0bf61\', \'multiverseId\': 556877}, \'multiverseid\': 556877}, {\'name\': \'Emprego Involuntário\', \'text\': \'Ganhe o controle da criatura alvo até o final do turno. Desvire aquela criatura. Ela ganha ímpeto até o final do turno. Crie uma ficha de Tesouro. (Ela é um artefato com "{T}, sacrifique este artefato: Adicione um mana de qualquer cor".)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557138&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9a78dd9a-f435-4d9e-bfa1-06ff51510939\', \'multiverseId\': 557138}, \'multiverseid\': 557138}, {\'name\': \'Недобровольная Занятость\', \'text\': \'Получите контроль над целевым существом до конца хода. Разверните то существо. Оно получает Ускорение до конца хода. Создайте одну фишку Клада. (Это артефакт со способностью «{T}, пожертвуйте этот артефакт: добавьте одну ману любого цвета».)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557399&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d399555d-8f1f-4fc0-bd51-598b41760a01\', \'multiverseId\': 557399}, \'multiverseid\': 557399}, {\'name\': \'被迫受雇\', \'text\': \'获得目标生物的操控权直到回合结束。重置该生物。它获得敏捷异能直到回合结束。派出一个珍宝衍生物。（珍宝衍生物是具有「{T}，牺牲此神器：加一点任意颜色的法术力」的神器。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557660&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a5008851-629a-48aa-85ca-0aa47dd1371b\', \'multiverseId\': 557660}, \'multiverseid\': 557660}, {\'name\': \'被迫受僱\', \'text\': \'獲得目標生物的操控權直到回合結束。重置該生物。它獲得敏捷異能直到回合結束。派出一個珍寶衍生物。（珍寶衍生物是具有「{T}，犧牲此神器：加一點任意顏色的魔法力」的神器。）\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557921&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5d3919c3-ea85-408c-bfe4-dfee35e9f79d\', \'multiverseId\': 557921}, \'multiverseid\': 557921}]', '[{\'name\': \'Unglücklicher Zeuge\', \'text\': \'Wenn der Unglückliche Zeuge stirbt, schicke die obersten zwei Karten deiner Bibliothek ins Exil. Bis zu deinem nächsten Endsegment kannst du eine der Karten spielen.\', \'type\': \'Kreatur — Mensch, Bürger\', \'flavor\': \'Die Wache übernahm eine Mitternachtsschicht, um sich eine Beförderung zu verdienen. Leider tat der Assassine dasselbe.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555590&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6f08d770-82ef-4dfb-b395-da40ccc582ca\', \'multiverseId\': 555590}, \'multiverseid\': 555590}, {\'name\': \'Testigo desafortunado\', \'text\': \'Cuando el Testigo desafortunado muera, exilia las dos primeras cartas de tu biblioteca. Hasta tu próximo paso final, puedes jugar una de esas cartas.\', \'type\': \'Criatura — Ciudadano humano\', \'flavor\': \'El guardia pidió un turno de noche para conseguir un ascenso. Por desgracia, el asesino hizo lo mismo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555851&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ed890156-3a1a-414d-9390-dc80cd075df1\', \'multiverseId\': 555851}, \'multiverseid\': 555851}, {\'name\': \'Témoin infortuné\', \'text\': "Quand le Témoin infortuné meurt, exilez les deux cartes du dessus de votre bibliothèque. Jusqu\'à votre prochaine étape de fin, vous pouvez jouer une de ces cartes.", \'type\': \'Créature : humain et citoyen\', \'flavor\': "Le garde travaillait de nuit pour recevoir une promotion. Malheureusement, l\'assassin aussi.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556112&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d52b2901-bd1c-48bf-ae03-70925024de28\', \'multiverseId\': 556112}, \'multiverseid\': 556112}, {\'name\': \'Testimone Sfortunato\', \'text\': \'Quando il Testimone Sfortunato muore, esilia le prime due carte del tuo grimorio. Fino alla tua prossima sottofase finale, puoi giocare una di quelle carte.\', \'type\': \'Creatura — Cittadino Umano\', \'flavor\': "La guardia accettò di lavorare nel turno di mezzanotte per ottenere una promozione. Sfortunatamente, lo stesso fece l\'assassino.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556373&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'36abf7a5-2e6a-499a-891e-d86166a74a71\', \'multiverseId\': 556373}, \'multiverseid\': 556373}, {\'name\': \'不運な目撃者\', \'text\': \'不運な目撃者が死亡したとき、あなたのライブラリーの一番上にあるカード２枚を追放する。次のあなたの終了ステップまで、あなたはそれらのカードのうち１枚をプレイしてもよい。\', \'type\': \'クリーチャー — 人間・市民\', \'flavor\': \'守衛は昇進を勝ち取るために深夜勤務をした。不幸なことに、それは暗殺者も同じだった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556634&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fe800c78-255d-4c0c-9522-b4c8ac0ffefa\', \'multiverseId\': 556634}, \'multiverseid\': 556634}, {\'name\': \'불운한 목격자\', \'text\': \'불운한 목격자가 죽을 때, 당신의 서고 맨 위 카드 두 장을 추방한다. 당신의 다음 종료단까지, 당신은 그 카드들 중 한 장을 플레이할 수 있다.\', \'type\': \'생물 — 인간 시민\', \'flavor\': \'경비병은 승진을 하기 위해 아간 근무를 선택했다. 불운하게도, 그건 암살자도 마찬가지였다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556895&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'fb89a19f-fcef-4ca9-af04-d4f0791c60de\', \'multiverseId\': 556895}, \'multiverseid\': 556895}, {\'name\': \'Testemunha Azarada\', \'text\': \'Quando Testemunha Azarada morrer, exile os dois cards do topo de seu grimório. Até sua próxima etapa final, você pode jogar um daqueles cards.\', \'type\': \'Criatura — Humano Cidadão\', \'flavor\': \'O guarda pegou o turno da madrugada para conseguir uma promoção. Infelizmente, o assassino fez o mesmo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557156&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'628eb7c1-4857-485a-9c85-d39a3a726aab\', \'multiverseId\': 557156}, \'multiverseid\': 557156}, {\'name\': \'Неудачливый Свидетель\', \'text\': \'Когда Неудачливый Свидетель умирает, изгоните две верхние карты вашей библиотеки. До вашего следующего заключительного шага вы можете разыграть одну из тех карт.\', \'type\': \'Существо — Человек Гражданин\', \'flavor\': \'Охранник согласился на полуночную смену, чтобы заслужить повышение. К сожалению, так же поступил и убийца.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557417&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d078c280-df8e-49e6-9706-4a146cf10f7f\', \'multiverseId\': 557417}, \'multiverseid\': 557417}, {\'name\': \'倒楣见证人\', \'text\': \'当倒楣见证人死去时，放逐你牌库顶的两张牌。直到你的下一个结束步骤，你可以使用其中的一张。\', \'type\': \'生物 ～人类／市民\', \'flavor\': \'警卫为了升职来上夜班。不幸的是，杀手也一样。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557678&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'be40d5bc-226e-4e5d-a06a-f267c2aa7437\', \'multiverseId\': 557678}, \'multiverseid\': 557678}, {\'name\': \'倒楣見證人\', \'text\': \'當倒楣見證人死去時，放逐你牌庫頂的兩張牌。直到你的下一個結束步驟，你可以使用其中的一張。\', \'type\': \'生物 ～人類／市民\', \'flavor\': \'警衛為了升職來上夜班。不幸的是，殺手也一樣。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557939&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9367f29e-4786-441c-99c1-190011ff0965\', \'multiverseId\': 557939}, \'multiverseid\': 557939}]', '[{\'name\': \'Unlizenzierter Leichenwagen\', \'text\': \'{T}: Schicke bis zu zwei Karten deiner Wahl aus genau einem Friedhof ins Exil.\\nStärke und Widerstandskraft des Unlizenzierten Leichenwagens sind gleich der Anzahl der von ihm ins Exil geschickten Karten.\\nBemannen 2\', \'type\': \'Artefakt — Fahrzeug\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555708&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5de3d75e-9e35-4597-8522-7ad715106e67\', \'multiverseId\': 555708}, \'multiverseid\': 555708}, {\'name\': \'Vehículo fúnebre sin licencia\', \'text\': \'{T}: Exilia hasta dos cartas objetivo de un mismo cementerio.\\nTanto la fuerza como la resistencia del Vehículo fúnebre sin licencia son iguales a la cantidad de cartas exiliadas con él.\\nTripular 2.\', \'type\': \'Artefacto — Vehículo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555969&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'203f716e-2c77-4ce6-99bb-f26781981424\', \'multiverseId\': 555969}, \'multiverseid\': 555969}, {\'name\': \'Corbillard illicite\', \'text\': "{T} : Exilez jusqu\'à deux cartes ciblées d\'un cimetière unique.\\nLa force et l\'endurance du Corbillard illicite sont chacune égales au nombre de cartes exilées par lui.\\nPilotage 2", \'type\': \'Artefact : véhicule\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556230&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d5808a1d-f26f-43f5-9211-aa992074a830\', \'multiverseId\': 556230}, \'multiverseid\': 556230}, {\'name\': \'Carro Funebre Abusivo\', \'text\': \'{T}: Esilia fino a due carte bersaglio da un unico cimitero.\\nLa forza e la costituzione del Carro Funebre Abusivo sono pari al numero di carte esiliate con esso.\\nManovrare 2\', \'type\': \'Artefatto — Veicolo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556491&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cf7c3c64-fab1-4a31-abe2-eab3371561a8\', \'multiverseId\': 556491}, \'multiverseid\': 556491}, {\'name\': \'未認可霊柩車\', \'text\': \'{T}：単一の墓地にあるカード最大２枚を対象とする。それらを追放する。\\n未認可霊柩車のパワーとタフネスはそれぞれ、これにより追放されているカードの枚数に等しい。\\n搭乗２\', \'type\': \'アーティファクト — 機体\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556752&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e5f77dc9-6617-4fcd-b1e9-1885dbb6de8e\', \'multiverseId\': 556752}, \'multiverseid\': 556752}, {\'name\': \'무면허 영구차\', \'text\': \'{T}: 한 무덤에 있는 카드를 최대 두 장까지 목표로 정한다. 그 카드들을 추방한다.\\n무면허 영구차의 공격력 및 방어력은 각각 무면허 영구차로 추방된 카드의 수와 같다.\\n탑승 2\', \'type\': \'마법물체 — 탑승물\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557013&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ad3f6fb1-8b2c-4c7b-a40f-c3071a15285b\', \'multiverseId\': 557013}, \'multiverseid\': 557013}, {\'name\': \'Rabecão Clandestino\', \'text\': \'{T}: Exile até dois cards alvo de um único cemitério.\\nO poder e a resistência de Rabecão Clandestino são ambos iguais ao número de cards exilados com ele.\\nTripular 2\', \'type\': \'Artefato — Veículo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557274&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'460d21d4-8854-4a8f-8ae7-d3a5ef3d7b3b\', \'multiverseId\': 557274}, \'multiverseid\': 557274}, {\'name\': \'Нелицензированный Катафалк\', \'text\': \'{T}: изгоните не более двух целевых карт из одного кладбища.\\nСила и выносливость Нелицензированного Катафалка равны количеству изгнанных им карт.\\nЭкипаж 2\', \'type\': \'Артефакт — Машина\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557535&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f0f0538f-35ba-4ba1-bc4f-921049798f07\', \'multiverseId\': 557535}, \'multiverseid\': 557535}, {\'name\': \'无牌灵车\', \'text\': \'{T}：将至多两张目标在同一坟墓场中的牌从该处放逐。\\n无牌灵车的力量和防御力各等同于以它放逐之牌的数量。\\n搭载2\', \'type\': \'神器 ～载具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557796&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8a211888-09c1-44c4-b846-102a0b1530dc\', \'multiverseId\': 557796}, \'multiverseid\': 557796}, {\'name\': \'無牌靈車\', \'text\': \'{T}：將至多兩張目標在同一墳墓場中的牌從該處放逐。\\n無牌靈車的力量和防禦力各等同於以它放逐之牌的數量。\\n搭載2\', \'type\': \'神器 ～載具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558057&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5c1a4708-7924-40b4-b6bb-8cc794b0bb0f\', \'multiverseId\': 558057}, \'multiverseid\': 558057}]', '[{\'name\': \'Unlizenzierter Leichenwagen\', \'text\': \'{T}: Schicke bis zu zwei Karten deiner Wahl aus genau einem Friedhof ins Exil.\\nStärke und Widerstandskraft des Unlizenzierten Leichenwagens sind gleich der Anzahl der von ihm ins Exil geschickten Karten.\\nBemannen 2\', \'type\': \'Artefakt — Fahrzeug\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558313&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'702ab070-c0d8-43ae-9c5f-be7484f9ec01\', \'multiverseId\': 558313}, \'multiverseid\': 558313}, {\'name\': \'Corbillard illicite\', \'text\': "{T} : Exilez jusqu\'à deux cartes ciblées d\'un cimetière unique.\\nLa force et l\'endurance du Corbillard illicite sont chacune égales au nombre de cartes exilées par lui.\\nPilotage 2", \'type\': \'Artefact : véhicule\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558348&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c57c805a-808f-4972-a54a-7f44781ccdc6\', \'multiverseId\': 558348}, \'multiverseid\': 558348}, {\'name\': \'未認可霊柩車\', \'text\': \'{T}：単一の墓地にあるカード最大２枚を対象とする。それらを追放する。\\n未認可霊柩車のパワーとタフネスはそれぞれ、これにより追放されているカードの枚数に等しい。\\n搭乗２\', \'type\': \'アーティファクト — 機体\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558383&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cb6dc122-b884-4df9-b7c7-71d6e848d2e7\', \'multiverseId\': 558383}, \'multiverseid\': 558383}, {\'name\': \'无牌灵车\', \'text\': \'{T}：将至多两张目标在同一坟墓场中的牌从该处放逐。\\n无牌灵车的力量和防御力各等同于以它放逐之牌的数量。\\n搭载2\', \'type\': \'神器 ～载具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558418&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'efbaa53c-4cf1-41de-8b2e-e6c7468abc51\', \'multiverseId\': 558418}, \'multiverseid\': 558418}]', '[{\'name\': \'Unverschämter Emporkömmling\', \'text\': \'Wachsamkeit\\nWenn der Unverschämte Emporkömmling stirbt, schaue dir die obersten fünf Karten deiner Bibliothek an. Du kannst davon eine Kreaturenkarte offen vorzeigen und auf deine Hand nehmen. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.\', \'type\': \'Kreatur — Elf, Schamane\', \'flavor\': \'„Glaub mir, du willst das mit mir aushandeln. Meine Geschäftspartner sind wesentlich weniger umgänglich."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555631&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8abf699b-ea75-45ec-9c84-0d4aa235386c\', \'multiverseId\': 555631}, \'multiverseid\': 555631}, {\'name\': \'Engreído desvergonzado\', \'text\': \'Vigilancia.\\nCuando el Engreído desvergonzado muera, mira las cinco primeras cartas de tu biblioteca. Puedes mostrar una carta de criatura de entre ellas y ponerla en tu mano. Pon el resto en el fondo de tu biblioteca en un orden aleatorio.\', \'type\': \'Criatura — Chamán elfo\', \'flavor\': \'"Créeme, te interesa hacer un trato conmigo. Mis socios no son tan simpáticos".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555892&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'53417de4-7980-48b0-b9ea-ac4573d79095\', \'multiverseId\': 555892}, \'multiverseid\': 555892}, {\'name\': \'Parvenu intrépide\', \'text\': \'Vigilance\\nQuand le Parvenu intrépide meurt, regardez les cinq cartes du dessus de votre bibliothèque. Vous pouvez révéler une carte de créature parmi elles et la mettre dans votre main. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.\', \'type\': \'Créature : elfe et shamane\', \'flavor\': \'« Crois-moi, mieux vaut avoir affaire à moi. Mes associés sont bien moins sympathiques »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556153&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2abf1f0b-9c22-491b-b373-7752b004c918\', \'multiverseId\': 556153}, \'multiverseid\': 556153}, {\'name\': \'Arrivista Sfacciato\', \'text\': "Cautela\\nQuando l\'Arrivista Sfacciato muore, guarda le prime cinque carte del tuo grimorio. Puoi rivelare una carta creatura scelta tra esse e aggiungerla alla tua mano. Metti le altre in fondo al tuo grimorio in ordine casuale.", \'type\': \'Creatura — Sciamano Elfo\', \'flavor\': \'"Fidati, ti conviene trattare con me. I miei soci sono molto meno simpatici."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556414&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'13d02d56-f6ec-4627-a34c-46b4513dc4b2\', \'multiverseId\': 556414}, \'multiverseid\': 556414}, {\'name\': \'厚顔な成り上がり\', \'text\': \'警戒\\n厚顔な成り上がりが死亡したとき、あなたのライブラリーの一番上にあるカード５枚を見る。あなたは「その中からクリーチャー・カード１枚を公開してあなたの手札に加える。」を選んでもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'クリーチャー — エルフ・シャーマン\', \'flavor\': \'「任せてくれ、お前は俺と取引がしたいはずだ。俺の仕事仲間は取っつきにくいからな。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556675&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4f7cc7f1-1476-44e9-937e-fa37b030843c\', \'multiverseId\': 556675}, \'multiverseid\': 556675}, {\'name\': \'뻔뻔한 신출내기\', \'text\': \'경계\\n뻔뻔한 신출내기가 죽을 때, 당신의 서고 맨 위 카드 다섯 장을 본다. 당신은 그중에서 생물 카드 한 장을 공개하고 당신의 손으로 가져갈 수 있다. 나머지 카드들은 무작위 순서로 당신의 서고 맨 밑에 놓는다.\', \'type\': \'생물 — 엘프 주술사\', \'flavor\': \'"장담하는데, 나랑 거래를 하는 게 좋을 거야. 내 일행은 훨씬 덜 유쾌하거든."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556936&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'fa0263a8-8374-45e4-b301-236b43de1388\', \'multiverseId\': 556936}, \'multiverseid\': 556936}, {\'name\': \'Novato Descarado\', \'text\': \'Vigilância\\nQuando Novato Descarado morrer, olhe os cinco cards do topo de seu grimório. Você pode revelar um card de criatura dentre eles e colocá-lo em sua mão. Coloque o restante no fundo de seu grimório em ordem aleatória.\', \'type\': \'Criatura — Elfo Xamã\', \'flavor\': \'"Vai por mim, você prefere resolver comigo. Os meus parceiros são muito menos agradáveis."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557197&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'33f0f209-0c7f-4a32-a0e7-ad889e0d5d28\', \'multiverseId\': 557197}, \'multiverseid\': 557197}, {\'name\': \'Дерзкий Выскочка\', \'text\': \'Бдительность\\nКогда Дерзкий Выскочка умирает, посмотрите пять верхних карт вашей библиотеки. Вы можете показать находящуюся среди них карту существа и положить ее в вашу руку. Положите остальные карты в низ вашей библиотеки в случайном порядке.\', \'type\': \'Существо — Эльф Шаман\', \'flavor\': \'«Поверь, тебе лучше иметь дело со мной. Мои коллеги гораздо менее любезны».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557458&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'321b3f79-9723-4d3a-8ad2-80e4cef3b74c\', \'multiverseId\': 557458}, \'multiverseid\': 557458}, {\'name\': \'厚颜高升者\', \'text\': \'警戒\\n当厚颜高升者死去时，检视你牌库顶的五张牌。你可以展示其中的一张生物牌，并将它置于你手上。将其余的牌以随机顺序置于你的牌库底。\', \'type\': \'生物 ～妖精／祭师\', \'flavor\': \'「相信我，你会宁愿对上我。我的同事们可没那么友善。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557719&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'49ba41b6-ff9e-4804-ab6d-e4ec4e132786\', \'multiverseId\': 557719}, \'multiverseid\': 557719}, {\'name\': \'厚顏高昇者\', \'text\': \'警戒\\n當厚顏高昇者死去時，檢視你牌庫頂的五張牌。你可以展示其中的一張生物牌，並將它置於你手上。將其餘的牌以隨機順序置於你的牌庫底。\', \'type\': \'生物 ～妖精／祭師\', \'flavor\': \'「相信我，你會寧願對上我。我的同事們可沒那麼友善。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557980&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bc7aaaeb-bea9-4d63-9baf-8c2b32c51c07\', \'multiverseId\': 557980}, \'multiverseid\': 557980}]', '[{\'name\': \'Unverschämter Emporkömmling\', \'text\': \'Wachsamkeit\\nWenn der Unverschämte Emporkömmling stirbt, schaue dir die obersten fünf Karten deiner Bibliothek an. Du kannst davon eine Kreaturenkarte offen vorzeigen und auf deine Hand nehmen. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.\', \'type\': \'Kreatur — Elf, Schamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558739&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'58f2b490-eec4-4103-9cfd-48e80659dacb\', \'multiverseId\': 558739}, \'multiverseid\': 558739}, {\'name\': \'Engreído desvergonzado\', \'text\': \'Vigilancia.\\nCuando el Engreído desvergonzado muera, mira las cinco primeras cartas de tu biblioteca. Puedes mostrar una carta de criatura de entre ellas y ponerla en tu mano. Pon el resto en el fondo de tu biblioteca en un orden aleatorio.\', \'type\': \'Criatura — Chamán elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558784&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4ac53933-42d2-4bdb-83f2-c9930607324a\', \'multiverseId\': 558784}, \'multiverseid\': 558784}, {\'name\': \'Parvenu intrépide\', \'text\': \'Vigilance\\nQuand le Parvenu intrépide meurt, regardez les cinq cartes du dessus de votre bibliothèque. Vous pouvez révéler une carte de créature parmi elles et la mettre dans votre main. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.\', \'type\': \'Créature : elfe et shamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558829&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'62ea2560-399a-47c4-90c2-6897388f12df\', \'multiverseId\': 558829}, \'multiverseid\': 558829}, {\'name\': \'Arrivista Sfacciato\', \'text\': "Cautela\\nQuando l\'Arrivista Sfacciato muore, guarda le prime cinque carte del tuo grimorio. Puoi rivelare una carta creatura scelta tra esse e aggiungerla alla tua mano. Metti le altre in fondo al tuo grimorio in ordine casuale.", \'type\': \'Creatura — Sciamano Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558874&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e235a74c-a74c-461b-9998-c15cda80e0b9\', \'multiverseId\': 558874}, \'multiverseid\': 558874}, {\'name\': \'厚顔な成り上がり\', \'text\': \'警戒\\n厚顔な成り上がりが死亡したとき、あなたのライブラリーの一番上にあるカード５枚を見る。あなたは「その中からクリーチャー・カード１枚を公開してあなたの手札に加える。」を選んでもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'クリーチャー — エルフ・シャーマン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558919&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'85ab7498-cc39-4622-8f27-eca90a78366e\', \'multiverseId\': 558919}, \'multiverseid\': 558919}, {\'name\': \'뻔뻔한 신출내기\', \'text\': \'경계\\n뻔뻔한 신출내기가 죽을 때, 당신의 서고 맨 위 카드 다섯 장을 본다. 당신은 그중에서 생물 카드 한 장을 공개하고 당신의 손으로 가져갈 수 있다. 나머지 카드들은 무작위 순서로 당신의 서고 맨 밑에 놓는다.\', \'type\': \'생물 — 엘프 주술사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558964&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'86bd2428-991f-4c08-8961-c6df08a5d7b5\', \'multiverseId\': 558964}, \'multiverseid\': 558964}, {\'name\': \'Novato Descarado\', \'text\': \'Vigilância\\nQuando Novato Descarado morrer, olhe os cinco cards do topo de seu grimório. Você pode revelar um card de criatura dentre eles e colocá-lo em sua mão. Coloque o restante no fundo de seu grimório em ordem aleatória.\', \'type\': \'Criatura — Elfo Xamã\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559009&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'be23393c-4b49-43ce-9465-f82bda671724\', \'multiverseId\': 559009}, \'multiverseid\': 559009}, {\'name\': \'Дерзкий Выскочка\', \'text\': \'Бдительность\\nКогда Дерзкий Выскочка умирает, посмотрите пять верхних карт вашей библиотеки. Вы можете показать находящуюся среди них карту существа и положить ее в вашу руку. Положите остальные карты в низ вашей библиотеки в случайном порядке.\', \'type\': \'Существо — Эльф Шаман\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559054&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'62e8f66d-6a8e-47d7-b282-588a65988009\', \'multiverseId\': 559054}, \'multiverseid\': 559054}, {\'name\': \'厚颜高升者\', \'text\': \'警戒\\n当厚颜高升者死去时，检视你牌库顶的五张牌。你可以展示其中的一张生物牌，并将它置于你手上。将其余的牌以随机顺序置于你的牌库底。\', \'type\': \'生物 ～妖精／祭师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559099&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c5d3d78b-98af-41de-9de7-059f2ed8a318\', \'multiverseId\': 559099}, \'multiverseid\': 559099}, {\'name\': \'厚顏高昇者\', \'text\': \'警戒\\n當厚顏高昇者死去時，檢視你牌庫頂的五張牌。你可以展示其中的一張生物牌，並將它置於你手上。將其餘的牌以隨機順序置於你的牌庫底。\', \'type\': \'生物 ～妖精／祭師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=559144&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5cc5a132-8414-412b-979e-5d3ae80fbcba\', \'multiverseId\': 559144}, \'multiverseid\': 559144}]', '[{\'name\': \'Urabrask, ketzerischer Prätor\', \'text\': \'Eile\\nZu Beginn deines Versorgungssegments schickst du die oberste Karte deiner Bibliothek ins Exil. Du kannst sie in diesem Zug spielen.\\nZu Beginn des Versorgungssegments jedes Gegners schickt er das nächste Mal, das er in diesem Zug eine Karte ziehen würde, stattdessen die oberste Karte seiner Bibliothek ins Exil. Er kann sie in diesem Zug spielen.\', \'type\': \'Legendäre Kreatur — Phyrexianer, Prätor\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555591&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ab22f235-91f3-4ba5-bf9b-94e00c03f091\', \'multiverseId\': 555591}, \'multiverseid\': 555591}, {\'name\': \'Úrabrask, magistrado herético\', \'text\': \'Prisa.\\nAl comienzo de tu mantenimiento, exilia la primera carta de tu biblioteca. Puedes jugar esa carta este turno.\\nAl comienzo del mantenimiento de cada oponente, la próxima vez que fuera a robar una carta este turno, en vez de eso, exilia la primera carta de su biblioteca. Puede jugar esa carta este turno.\', \'type\': \'Criatura legendaria — Magistrado pirexiano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555852&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0d7f2cae-60f6-4c63-bb3e-00a72fa580b9\', \'multiverseId\': 555852}, \'multiverseid\': 555852}, {\'name\': \'Urabrask, praetor hérétique\', \'text\': "Célérité\\nAu début de votre entretien, exilez la carte du dessus de votre bibliothèque. Vous pouvez la jouer ce tour-ci.\\nAu début de l\'entretien de chaque adversaire, la prochaine fois qu\'il devrait piocher une carte ce tour-ci, à la place il exile la carte du dessus de sa bibliothèque. Il peut la jouer ce tour-ci.", \'type\': \'Créature légendaire : phyrexian et praetor\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556113&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1ab3dbbe-8111-41aa-ae7d-15a19db05b78\', \'multiverseId\': 556113}, \'multiverseid\': 556113}, {\'name\': \'Urabrask, Pretore Eretico\', \'text\': "Rapidità\\nAll\'inizio del tuo mantenimento, esilia la prima carta del tuo grimorio. Puoi giocarla in questo turno.\\nAll\'inizio del mantenimento di ogni avversario, la prossima volta che sta per pescare una carta in questo turno, esilia invece la prima carta del suo grimorio. Può giocarla in questo turno.", \'type\': \'Creatura Leggendaria — Pretore Phyrexiano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556374&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ebea1638-5d69-4976-a4e6-02b0ce70ab4b\', \'multiverseId\': 556374}, \'multiverseid\': 556374}, {\'name\': \'異端の法務官、ウラブラスク\', \'text\': \'速攻\\nあなたのアップキープの開始時に、あなたのライブラリーの一番上にあるカード１枚を追放する。このターン、あなたはそれをプレイしてもよい。\\n各対戦相手のアップキープの開始時に、このターン、次にそのプレイヤーがカード１枚を引くなら、代わりにそのプレイヤーのライブラリーの一番上にあるカード１枚を追放する。このターン、そのプレイヤーはそれをプレイしてもよい。\', \'type\': \'伝説のクリーチャー — ファイレクシアン・法務官\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556635&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5dbf44b2-8331-4cc2-92e8-21754f8e56c4\', \'multiverseId\': 556635}, \'multiverseid\': 556635}, {\'name\': \'이단자 총독, 우라브라스크\', \'text\': \'신속\\n당신의 유지단 시작에, 당신의 서고 맨 위 카드를 추방한다. 당신은 이 턴에 그 카드를 플레이할 수 있다.\\n각 상대의 유지단 시작에, 그 플레이어가 이 턴에 카드를 뽑으려 하는 다음 시점에, 대신 그 플레이어는 자신의 서고 맨 위 카드를 추방한다. 그 플레이어는 이 턴에 그 카드를 플레이할 수 있다.\', \'type\': \'전설적 생물 — 피렉시아 총독\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556896&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c7bad2ed-5b38-4cbf-b2f8-e24b546d74fe\', \'multiverseId\': 556896}, \'multiverseid\': 556896}, {\'name\': \'Urabrask, Pretor Herege\', \'text\': \'Ímpeto\\nNo início de sua manutenção, exile o card do topo de seu grimório. Você pode jogá-lo neste turno.\\nNo início da manutenção de cada oponente, na próxima vez em que ele compraria um card neste turno, em vez disso, ele exila o card do topo do próprio grimório. Ele pode jogá-lo neste turno.\', \'type\': \'Criatura Lendária — Pretor Phyrexiano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557157&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0cd636f5-b347-483a-ac29-287adaa18385\', \'multiverseId\': 557157}, \'multiverseid\': 557157}, {\'name\': \'Урабраск, Претор-Еретик\', \'text\': \'Ускорение\\nВ начале вашего шага поддержки изгоните верхнюю карту вашей библиотеки. Вы можете разыграть ту карту в этом ходу.\\nВ начале шага поддержки каждого оппонента, в следующий раз, когда он должен будет взять карту в этом ходу, вместо этого он изгоняет верхнюю карту своей библиотеки. Он может разыграть ту карту в этом ходу.\', \'type\': \'Легендарное Существо — Фирексиец Претор\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557418&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c8e17e33-154c-4649-9a90-cdf19644f899\', \'multiverseId\': 557418}, \'multiverseid\': 557418}, {\'name\': \'异端魔判洼巴司\', \'text\': \'敏捷\\n在你的维持开始时，放逐你的牌库顶牌。本回合中，你可以使用该牌。\\n在每位对手的维持开始时，于本回合中，他下一次将抓一张牌时，改为他放逐其牌库顶牌。本回合中，他可以使用该牌。\', \'type\': \'传奇生物 ～非瑞人／魔判官\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557679&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9fb2f82b-4c32-4a17-8dc5-539d9f9ea3a5\', \'multiverseId\': 557679}, \'multiverseid\': 557679}, {\'name\': \'異端魔判窪巴司\', \'text\': \'敏捷\\n在你的維持開始時，放逐你的牌庫頂牌。本回合中，你可以使用該牌。\\n在每位對手的維持開始時，於本回合中，他下一次將抽一張牌時，改為他放逐其牌庫頂牌。本回合中，他可以使用該牌。\', \'type\': \'傳奇生物 ～非瑞人／魔判官\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557940&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9c2594b5-4a4d-4ce8-aa3c-bbc7613b1003\', \'multiverseId\': 557940}, \'multiverseid\': 557940}]', '[{\'name\': \'Urabrask, ketzerischer Prätor\', \'text\': \'Eile\\nZu Beginn deines Versorgungssegments schickst du die oberste Karte deiner Bibliothek ins Exil. Du kannst sie in diesem Zug spielen.\\nZu Beginn des Versorgungssegments jedes Gegners schickt er das nächste Mal, das er in diesem Zug eine Karte ziehen würde, stattdessen die oberste Karte seiner Bibliothek ins Exil. Er kann sie in diesem Zug spielen.\', \'type\': \'Legendäre Kreatur — Phyrexianer, Prätor\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558554&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7e8f84b9-4f0b-473b-8ee0-22f179fd7c49\', \'multiverseId\': 558554}, \'multiverseid\': 558554}, {\'name\': \'Úrabrask, magistrado herético\', \'text\': \'Prisa.\\nAl comienzo de tu mantenimiento, exilia la primera carta de tu biblioteca. Puedes jugar esa carta este turno.\\nAl comienzo del mantenimiento de cada oponente, la próxima vez que fuera a robar una carta este turno, en vez de eso, exilia la primera carta de su biblioteca. Puede jugar esa carta este turno.\', \'type\': \'Criatura legendaria — Magistrado pirexiano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558563&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'059976d2-483b-4a11-9199-05c96b68bae7\', \'multiverseId\': 558563}, \'multiverseid\': 558563}, {\'name\': \'Urabrask, praetor hérétique\', \'text\': "Célérité\\nAu début de votre entretien, exilez la carte du dessus de votre bibliothèque. Vous pouvez la jouer ce tour-ci.\\nAu début de l\'entretien de chaque adversaire, la prochaine fois qu\'il devrait piocher une carte ce tour-ci, à la place il exile la carte du dessus de sa bibliothèque. Il peut la jouer ce tour-ci.", \'type\': \'Créature légendaire : phyrexian et praetor\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558572&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fc8cb42e-0962-4a7e-87b2-d4b71e20bee3\', \'multiverseId\': 558572}, \'multiverseid\': 558572}, {\'name\': \'Urabrask, Pretore Eretico\', \'text\': "Rapidità\\nAll\'inizio del tuo mantenimento, esilia la prima carta del tuo grimorio. Puoi giocarla in questo turno.\\nAll\'inizio del mantenimento di ogni avversario, la prossima volta che sta per pescare una carta in questo turno, esilia invece la prima carta del suo grimorio. Può giocarla in questo turno.", \'type\': \'Creatura Leggendaria — Pretore Phyrexiano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558581&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a221e23b-e746-4206-95c3-7118aeb1c911\', \'multiverseId\': 558581}, \'multiverseid\': 558581}, {\'name\': \'異端の法務官、ウラブラスク\', \'text\': \'速攻\\nあなたのアップキープの開始時に、あなたのライブラリーの一番上にあるカード１枚を追放する。このターン、あなたはそれをプレイしてもよい。\\n各対戦相手のアップキープの開始時に、このターン、次にそのプレイヤーがカード１枚を引くなら、代わりにそのプレイヤーのライブラリーの一番上にあるカード１枚を追放する。このターン、そのプレイヤーはそれをプレイしてもよい。\', \'type\': \'伝説のクリーチャー — ファイレクシアン・法務官\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558590&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2a6c8b83-7e2c-45d8-bc8f-5b55f43dbe8f\', \'multiverseId\': 558590}, \'multiverseid\': 558590}, {\'name\': \'이단자 총독, 우라브라스크\', \'text\': \'신속\\n당신의 유지단 시작에, 당신의 서고 맨 위 카드를 추방한다. 당신은 이 턴에 그 카드를 플레이할 수 있다.\\n각 상대의 유지단 시작에, 그 플레이어가 이 턴에 카드를 뽑으려 하는 다음 시점에, 대신 그 플레이어는 자신의 서고 맨 위 카드를 추방한다. 그 플레이어는 이 턴에 그 카드를 플레이할 수 있다.\', \'type\': \'전설적 생물 — 피렉시아 총독\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558599&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1046cad3-4f8b-4b24-88b0-608f8c90f065\', \'multiverseId\': 558599}, \'multiverseid\': 558599}, {\'name\': \'Urabrask, Pretor Herege\', \'text\': \'Ímpeto\\nNo início de sua manutenção, exile o card do topo de seu grimório. Você pode jogá-lo neste turno.\\nNo início da manutenção de cada oponente, na próxima vez em que ele compraria um card neste turno, em vez disso, ele exila o card do topo do próprio grimório. Ele pode jogá-lo neste turno.\', \'type\': \'Criatura Lendária — Pretor Phyrexiano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558608&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5e054a23-09e1-458b-8a59-7f611339880e\', \'multiverseId\': 558608}, \'multiverseid\': 558608}, {\'name\': \'Урабраск, Претор-Еретик\', \'text\': \'Ускорение\\nВ начале вашего шага поддержки изгоните верхнюю карту вашей библиотеки. Вы можете разыграть ту карту в этом ходу.\\nВ начале шага поддержки каждого оппонента, в следующий раз, когда он должен будет взять карту в этом ходу, вместо этого он изгоняет верхнюю карту своей библиотеки. Он может разыграть ту карту в этом ходу.\', \'type\': \'Легендарное Существо — Фирексиец Претор\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558617&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b2632267-24b9-41e1-acc1-dfdf34b79179\', \'multiverseId\': 558617}, \'multiverseid\': 558617}, {\'name\': \'异端魔判洼巴司\', \'text\': \'敏捷\\n在你的维持开始时，放逐你的牌库顶牌。本回合中，你可以使用该牌。\\n在每位对手的维持开始时，于本回合中，他下一次将抓一张牌时，改为他放逐其牌库顶牌。本回合中，他可以使用该牌。\', \'type\': \'传奇生物 ～非瑞人／魔判官\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558626&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d263aab1-fab2-46cd-88d9-30e43539bcdc\', \'multiverseId\': 558626}, \'multiverseid\': 558626}, {\'name\': \'異端魔判窪巴司\', \'text\': \'敏捷\\n在你的維持開始時，放逐你的牌庫頂牌。本回合中，你可以使用該牌。\\n在每位對手的維持開始時，於本回合中，他下一次將抽一張牌時，改為他放逐其牌庫頂牌。本回合中，他可以使用該牌。\', \'type\': \'傳奇生物 ～非瑞人／魔判官\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558635&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d856489a-1f5b-4ff4-b412-b4cfbf187a5f\', \'multiverseId\': 558635}, \'multiverseid\': 558635}]', "[{'name': 'Vampir-Schreiberin', 'text': 'Fliegend\\nImmer wenn du während deines Zuges Lebenspunkte dazuerhältst, lege eine +1/+1-Marke auf die Vampir-Schreiberin.\\nImmer wenn du während deines Zuges Lebenspunkte verlierst, lege eine +1/+1-Marke auf die Vampir-Schreiberin.', 'type': 'Kreatur — Vampir, Hexenmeister', 'flavor': 'Niemand bleibt lange auf ihrer Liste.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555560&type=card', 'language': 'German', 'identifiers': {'scryfallId': '932527c1-0d0a-4975-a5ed-42a57c28ccca', 'multiverseId': 555560}, 'multiverseid': 555560}, {'name': 'Escribiente vampírica', 'text': 'Vuela.\\nSiempre que ganes vidas durante tu turno, pon un contador +1/+1 sobre la Escribiente vampírica.\\nSiempre que pierdas vidas durante tu turno, pon un contador +1/+1 sobre la Escribiente vampírica.', 'type': 'Criatura — Brujo vampiro', 'flavor': 'Nadie permanece en su lista mucho tiempo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555821&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'bafaf694-1805-472a-acd4-6c3456386416', 'multiverseId': 555821}, 'multiverseid': 555821}, {'name': 'Scribe vampire', 'text': 'Vol\\nÀ chaque fois que vous gagnez des points de vie pendant votre tour, mettez un marqueur +1/+1 sur la Scribe vampire.\\nÀ chaque fois que vous perdez des points de vie pendant votre tour, mettez un marqueur +1/+1 sur la Scribe vampire.', 'type': 'Créature : vampire et psychagogue', 'flavor': 'Personne ne reste longtemps sur sa liste.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556082&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b3c5028d-59c3-4ef9-801e-d072dc57fbed', 'multiverseId': 556082}, 'multiverseid': 556082}, {'name': 'Vampira Scrivana', 'text': 'Volare\\nOgniqualvolta guadagni punti vita durante il tuo turno, metti un segnalino +1/+1 sulla Vampira Scrivana.\\nOgniqualvolta perdi punti vita durante il tuo turno, metti un segnalino +1/+1 sulla Vampira Scrivana.', 'type': 'Creatura — Warlock Vampiro', 'flavor': 'Nessuno rimane sulla sua lista a lungo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556343&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c1faddc5-63c6-4e72-bfd0-5977c0ce92da', 'multiverseId': 556343}, 'multiverseid': 556343}, {'name': '吸血鬼の公証人', 'text': '飛行\\nあなたのターン中にあなたがライフを得るたび、吸血鬼の公証人の上に＋１/＋１カウンター１個を置く。\\nあなたのターン中にあなたがライフを失うたび、吸血鬼の公証人の上に＋１/＋１カウンター１個を置く。', 'type': 'クリーチャー — 吸血鬼・邪術師', 'flavor': '彼女の目録に長く残る名前はない。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556604&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '5feed945-93c1-4ce9-bea4-ec0a97609069', 'multiverseId': 556604}, 'multiverseid': 556604}, {'name': '흡혈귀 공증인', 'text': '비행\\n당신이 당신의 턴 동안 생명점을 얻을 때마다, 흡혈귀 공증인에 +1/+1 카운터 한 개를 올려놓는다.\\n당신이 당신의 턴 동안 생명점을 잃을 때마다, 흡혈귀 공증인에 +1/+1 카운터 한 개를 올려놓는다.', 'type': '생물 — 흡혈귀 흑마법사', 'flavor': '그녀의 명단에 오랫동안 남아 있는 자는 아무도 없다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556865&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '2695e09c-4233-461f-b312-c5b3285274e5', 'multiverseId': 556865}, 'multiverseid': 556865}, {'name': 'Escrivã Vampira', 'text': 'Voar\\nToda vez que você ganhar pontos de vida durante seu turno, coloque um marcador +1/+1 em Escrivã Vampira.\\nToda vez que você perder pontos de vida durante seu turno, coloque um marcador +1/+1 em Escrivã Vampira.', 'type': 'Criatura — Vampiro Bruxo', 'flavor': 'Ninguém fica na lista dela por muito tempo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557126&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f5f7bc62-0b9c-47fd-993e-9d825d5a45ba', 'multiverseId': 557126}, 'multiverseid': 557126}, {'name': 'Вампирша-Переписчица', 'text': 'Полет\\nКаждый раз, когда вы получаете жизнь(-и) во время вашего хода, положите один жетон +1/+1 на Вампиршу-Переписчицу.\\nКаждый раз, когда вы теряете жизнь(-и) во время вашего хода, положите один жетон +1/+1 на Вампиршу-Переписчицу.', 'type': 'Существо — Вампир Колдун', 'flavor': 'В ее списке никто надолго не задерживается.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557387&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '2dfa4b06-9bf4-44e6-ad7b-8671bf0d9b3b', 'multiverseId': 557387}, 'multiverseid': 557387}, {'name': '吸血书记员', 'text': '飞行\\n每当你于你的回合中获得生命时，在吸血书记员上放置一个+1/+1指示物。\\n每当你于你的回合中失去生命时，在吸血书记员上放置一个+1/+1指示物。', 'type': '生物 ～吸血鬼／邪术师', 'flavor': '名字在她的清单上待不久。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557648&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'fe8fbee1-7bc8-43f5-a823-a4ec02ec3f19', 'multiverseId': 557648}, 'multiverseid': 557648}, {'name': '吸血書記員', 'text': '飛行\\n每當你於你的回合中獲得生命時，在吸血書記員上放置一個+1/+1指示物。\\n每當你於你的回合中失去生命時，在吸血書記員上放置一個+1/+1指示物。', 'type': '生物 ～吸血鬼／邪術師', 'flavor': '名字在她的清單上待不久。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557909&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '27a64eb8-d4b1-4d22-9e1e-a4ad7add9dd4', 'multiverseId': 557909}, 'multiverseid': 557909}]", '[{\'name\': \'Verarzten\', \'text\': \'Bringe bis zu drei Kreaturenkarten deiner Wahl mit Gesamt-Manabetrag 3 oder weniger aus deinem Friedhof ins Spiel zurück.\', \'type\': \'Hexerei\', \'flavor\': \'„Sag mir nicht, wer dich geschickt hat oder für wen du arbeitest. Je weniger ich weiß, desto besser."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555485&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f59a9801-b36d-4986-b302-18bf13b5b1c0\', \'multiverseId\': 555485}, \'multiverseid\': 555485}, {\'name\': \'Tratar\', \'text\': \'Regresa hasta tres cartas de criatura objetivo con valor de maná total de 3 o menos de tu cementerio al campo de batalla.\', \'type\': \'Conjuro\', \'flavor\': \'"No me digas quién te envió ni para quién trabajas. Cuanto menos sepa, mejor".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555746&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'469745fe-8766-4aa9-be1b-e2b830f423e6\', \'multiverseId\': 555746}, \'multiverseid\': 555746}, {\'name\': \'Rafistolage\', \'text\': "Renvoyez sur le champ de bataille depuis votre cimetière jusqu\'à trois cartes de créature ciblées avec une valeur de mana totale inférieure ou égale à 3.", \'type\': \'Rituel\', \'flavor\': "« Ne me dites pas qui vous envoie ni pour qui vous travaillez. Moins j\'en sais, mieux je me porte. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556007&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a47f4c83-c350-4167-96ea-d0ad0d49b32c\', \'multiverseId\': 556007}, \'multiverseid\': 556007}, {\'name\': \'Ricucire\', \'text\': \'Rimetti sul campo di battaglia fino a tre carte creatura bersaglio con valore di mana totale pari o inferiore a 3 dal tuo cimitero.\', \'type\': \'Stregoneria\', \'flavor\': \'"Non dirmi chi ti ha mandato o per chi lavori. Meno dettagli conosco, meglio è."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556268&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f72f7806-d417-4ec7-b46e-70d094fe5680\', \'multiverseId\': 556268}, \'multiverseid\': 556268}, {\'name\': \'継ぎ当て\', \'text\': \'あなたの墓地にあるクリーチャー・カード最大３枚をマナ総量の合計が３以下になるように選んで対象とする。それらを戦場に戻す。\', \'type\': \'ソーサリー\', \'flavor\': \'「誰がよこしたとか、誰のもとで働いているとかは言わなくていい。知らなければ知らないほど、良い仕事ができるからな。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556529&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9420f181-4c6c-4677-8e86-9a6c9d7c4ca4\', \'multiverseId\': 556529}, \'multiverseid\': 556529}, {\'name\': \'임시 변통\', \'text\': \'당신의 무덤에서 마나 값의 총합이 3 이하가 되도록 생물 카드를 최대 세 장까지 목표로 정한다. 그 카드들을 전장으로 되돌린다.\', \'type\': \'집중마법\', \'flavor\': \'"누가 널 보냈는지도 누구를 위해 일하는지도 말해 줄 필요 없어. 더 적게 알 수록, 더 좋지."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556790&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9fd9a342-7a98-485e-b480-a9612cce1200\', \'multiverseId\': 556790}, \'multiverseid\': 556790}, {\'name\': \'Ajeitar\', \'text\': \'Devolva de seu cemitério para o campo de batalha até três cards de criatura alvo com valor de mana total igual ou inferior a 3.\', \'type\': \'Feitiço\', \'flavor\': \'"Não me diga quem te mandou nem quem te contratou. Quanto menos eu souber, melhor."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557051&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'581a09c4-8333-4f0f-9bd7-6d65bf1ca2ef\', \'multiverseId\': 557051}, \'multiverseid\': 557051}, {\'name\': \'Подлатать\', \'text\': \'Верните из вашего кладбища на поле битвы не более трех целевых карт существ с суммарной мановой ценностью не более 3.\', \'type\': \'Волшебство\', \'flavor\': \'«Не говори мне, кто тебя послал или на кого ты работаешь. Чем меньше я знаю, тем лучше».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557312&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b95248fc-6bc6-4668-9f14-ff95f4d8d1de\', \'multiverseId\': 557312}, \'multiverseid\': 557312}, {\'name\': \'妙手施救\', \'text\': \'将至多三张目标生物牌从你的坟墓场移回战场，且这些牌法术力值总和须等于或小于3。\', \'type\': \'法术\', \'flavor\': \'「别告诉我是谁派你来或替谁做事。我知道得越少越好。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557573&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'862c4756-81b6-4f33-9b98-ad6d7287efb8\', \'multiverseId\': 557573}, \'multiverseid\': 557573}, {\'name\': \'妙手施救\', \'text\': \'將至多三張目標生物牌從你的墳墓場移回戰場，且這些牌魔法力值總和須等於或小於3。\', \'type\': \'巫術\', \'flavor\': \'「別告訴我是誰派你來或替誰做事。我知道得越少越好。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557834&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fc5a7d04-c841-40d1-bd86-9f1095c00227\', \'multiverseId\': 557834}, \'multiverseid\': 557834}]', '[{\'name\': \'Verdorbener Genuss\', \'text\': \'Ziehe zwei Karten. Wirf dann eine Karte ab, es sei denn, in deinem Friedhof befinden sich Karten mit fünf oder mehr unterschiedlichen Manabeträgen.\', \'type\': \'Spontanzauber\', \'flavor\': \'Ihr Trinkspruch auf die Gesundheit ging fürchterlich schief.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555689&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5659ef5e-17ce-4da5-ad9b-312f57440c13\', \'multiverseId\': 555689}, \'multiverseid\': 555689}, {\'name\': \'Lujo envenenado\', \'text\': \'Roba dos cartas. Luego descarta una carta a menos que haya cinco o más valores de maná entre las cartas de tu cementerio.\', \'type\': \'Instantáneo\', \'flavor\': \'Su brindis por la buena salud fue un fracaso rotundo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555950&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7b57698d-0774-4892-b485-3eb418a14764\', \'multiverseId\': 555950}, \'multiverseid\': 555950}, {\'name\': \'Indulgence souillée\', \'text\': "Piochez deux cartes. Puis défaussez-vous d\'une carte à moins qu\'il y ait au moins cinq valeurs de mana parmi les cartes de votre cimetière.", \'type\': \'Éphémère\', \'flavor\': \'Le toast à leur santé tourna immédiatement au drame.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556211&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'12fa6584-f4a8-410c-a7ba-6726d6904337\', \'multiverseId\': 556211}, \'multiverseid\': 556211}, {\'name\': \'Indulgenza Contaminata\', \'text\': \'Pesca due carte. Poi scarta una carta a meno che non ci siano cinque o più valori di mana tra le carte nel tuo cimitero.\', \'type\': \'Istantaneo\', \'flavor\': \'Il loro brindisi alla buona salute andò immediatamente, orribilmente storto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556472&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'59c9176f-23a1-45d4-8f9f-32fec2701a61\', \'multiverseId\': 556472}, \'multiverseid\': 556472}, {\'name\': \'染みついた耽溺\', \'text\': \'カード２枚を引く。その後、あなたの墓地にあるすべてのカードの中に５種類以上のマナ総量があるのでないかぎり、カード１枚を捨てる。\', \'type\': \'インスタント\', \'flavor\': \'健康を祝した乾杯はたちまちひどい失敗に終わった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556733&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'72f58d87-734b-4577-8cf2-b26315b9d87e\', \'multiverseId\': 556733}, \'multiverseid\': 556733}, {\'name\': \'더럽혀진 탐닉\', \'text\': \'카드 두 장을 뽑는다. 그 후 당신의 무덤에 있는 카드들의 마나 값이 다섯 종류 이상이 아닌 한 카드 한 장을 버린다.\', \'type\': \'순간마법\', \'flavor\': \'건강을 위한 그들의 건배는 그 즉시, 끔찍하게 엇나갔다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556994&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6e16cdc9-a5d4-4c4b-9f2f-6f390e474010\', \'multiverseId\': 556994}, \'multiverseid\': 556994}, {\'name\': \'Indulgência Maculada\', \'text\': \'Compre dois cards. Depois descarte um card, a menos que haja cinco ou mais valores de mana diferentes entre os cards em seu cemitério.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'O brinde à saúde deu imediatamente muito, muito errado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557255&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3b4831ed-f41e-4737-b575-a4caa2e504e0\', \'multiverseId\': 557255}, \'multiverseid\': 557255}, {\'name\': \'Испорченный Каприз\', \'text\': \'Возьмите две карты. Затем сбросьте карту, если среди карт на вашем кладбище нет пяти или более разных значений мановой ценности.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Прозвучал тост за крепкое здоровье — и тут же все пошло совершенно наперекосяк.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557516&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8bd4cae4-04df-4402-89cc-b8a2847c872d\', \'multiverseId\': 557516}, \'multiverseid\': 557516}, {\'name\': \'染毒盛宴\', \'text\': \'抓两张牌。然后除非你坟墓场中牌的法术力值有五种或更多，否则弃一张牌。\', \'type\': \'瞬间\', \'flavor\': \'在他们为健康而干杯后，情况急转直下。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557777&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e88be4a8-4635-4892-99ed-c1eb9072dc78\', \'multiverseId\': 557777}, \'multiverseid\': 557777}, {\'name\': \'染毒盛宴\', \'text\': \'抽兩張牌。然後除非你墳墓場中牌的魔法力值有五種或更多，否則棄一張牌。\', \'type\': \'瞬間\', \'flavor\': \'在他們為健康而乾杯後，情況急轉直下。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558038&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b94f535c-8f7c-432c-b89a-cc39409c3019\', \'multiverseId\': 558038}, \'multiverseid\': 558038}]', '[{\'name\': \'Verdächtiges Bücherregal\', \'text\': \'Verteidiger\\n{3}, {T}: Eine Kreatur deiner Wahl kann in diesem Zug nicht geblockt werden.\', \'type\': \'Artefaktkreatur — Mauer\', \'flavor\': \'In der großen Bibliothek im Museum von Alt-Capenna sind eine Million Bände ausgestellt — und dahinter verbergen sich kilometerlange Gänge.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555707&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4efc5706-c5cb-4e6e-9488-1d2e0391ac8f\', \'multiverseId\': 555707}, \'multiverseid\': 555707}, {\'name\': \'Estantería sospechosa\', \'text\': \'Defensor.\\n{3}, {T}: La criatura objetivo no puede ser bloqueada este turno.\', \'type\': \'Criatura artefacto — Muro\', \'flavor\': \'La gran biblioteca del museo de la antigua Capenna dispone de un millón de volúmenes expuestos... y miles de pasadizos secretos tras ellos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555968&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'73b3c21e-8487-49f3-8a96-1817e2ac6c49\', \'multiverseId\': 555968}, \'multiverseid\': 555968}, {\'name\': \'Bibliothèque suspecte\', \'text\': \'Défenseur\\n{3}, {T} : Une créature ciblée ne peut pas être bloquée ce tour-ci.\', \'type\': \'Créature-artefact : mur\', \'flavor\': "La grande bibliothèque du Musée de la Vieille Capenna compte plus d\'un million d\'ouvrages dans ses étagères... et des kilomètres de passages secrets derrière elles.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556229&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1dc1db81-6909-4998-b4de-16dd76248a37\', \'multiverseId\': 556229}, \'multiverseid\': 556229}, {\'name\': \'Libreria Sospetta\', \'text\': \'Difensore\\n{3}, {T}: Una creatura bersaglio non può essere bloccata in questo turno.\', \'type\': \'Creatura Artefatto — Muro\', \'flavor\': \'La grande biblioteca nel Museo di Vecchia Capenna ha un milione di volumi in mostra... e chilometri di passaggi nascosti alle loro spalle.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556490&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'51ddce33-a4dc-404b-85a1-6af68422b0ae\', \'multiverseId\': 556490}, \'multiverseid\': 556490}, {\'name\': \'怪しげな書架\', \'text\': \'防衛\\n{3}, {T}：クリーチャー１体を対象とする。このターン、それはブロックされない。\', \'type\': \'アーティファクト・クリーチャー — 壁\', \'flavor\': \'旧カペナ博物館の大図書館は百万冊の蔵書を誇る。その裏には何マイルにも及ぶ通路が隠されている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556751&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'851f0e31-13d1-4fb5-84e7-9230810f7428\', \'multiverseId\': 556751}, \'multiverseid\': 556751}, {\'name\': \'수상한 책장\', \'text\': \'수비태세\\n{3}, {T}: 생물을 목표로 정한다. 그 생물은 이 턴에 방어될 수 없다.\', \'type\': \'마법물체 생물 — 벽\', \'flavor\': \'올드 카펜나의 박물관에 있는 거대한 도서관에는 수백만 권의 책이 전시되어 있으며, 그 뒤에는 수많은 통로들이 숨겨져 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557012&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'015e032b-40ea-43b0-a378-dd57feb95ab4\', \'multiverseId\': 557012}, \'multiverseid\': 557012}, {\'name\': \'Estante Suspeita\', \'text\': \'Defensor\\n{3}, {T}: A criatura alvo não pode ser bloqueada neste turno.\', \'type\': \'Criatura Artefato — Barreira\', \'flavor\': \'A grande biblioteca no Museu da Velha Capenna tem um milhão de volumes nas estantes... e quilômetros de passagens secretas atrás delas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557273&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'76bada76-9947-490d-aa2c-b94a3701eaa3\', \'multiverseId\': 557273}, \'multiverseid\': 557273}, {\'name\': \'Подозрительный Книжный Шкаф\', \'text\': \'Защитник\\n{3}, {T}: целевое существо не может быть заблокировано в этом ходу.\', \'type\': \'Артефакт Существо — Стена\', \'flavor\': \'На полках колоссальной библиотеки музея Старой Капенны выставлен миллион томов, а за ними скрываются многие мили потайных ходов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557534&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6f000732-1172-407c-a91f-ae46d53fe659\', \'multiverseId\': 557534}, \'multiverseid\': 557534}, {\'name\': \'可疑书架\', \'text\': \'守军\\n{3}，{T}：目标生物本回合不能被阻挡。\', \'type\': \'神器生物 ～墙\', \'flavor\': \'旧卡佩纳博物馆的大图书室陈列着上百万本书册～其背后还藏着绵延无数里的暗道。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557795&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ae49774b-992a-4e73-8061-b4cb6264392b\', \'multiverseId\': 557795}, \'multiverseid\': 557795}, {\'name\': \'可疑書架\', \'text\': \'守軍\\n{3}，{T}：目標生物本回合不能被阻擋。\', \'type\': \'神器生物 ～牆\', \'flavor\': \'舊卡佩納博物館的大圖書室陳列著上百萬本書冊～其背後還藏著綿延無數哩的暗道。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558056&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a7ba0be0-88a8-48db-b655-f7b97fe56478\', \'multiverseId\': 558056}, \'multiverseid\': 558056}]', '[{\'name\': \'Vergoldete Federn\', \'text\': \'Wenn die Vergoldeten Federn ins Spiel kommen, erzeuge einen Schatz-Spielstein. (Er ist ein Artefakt mit „{T}, opfere dieses Artefakt: Erzeuge ein Mana einer beliebigen Farbe.")\\nDie ausgerüstete Kreatur hat Flugfähigkeit.\\nAusrüsten {2} ({2}: Lege diese Karte an eine Kreatur deiner Wahl an, die du kontrollierst. Spiele Ausrüsten wie eine Hexerei.)\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555700&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e16dcd50-f023-4e9d-b458-f015a45b530b\', \'multiverseId\': 555700}, \'multiverseid\': 555700}, {\'name\': \'Alas áureas\', \'text\': \'Cuando las Alas áureas entren al campo de batalla, crea una ficha de Tesoro. (Es un artefacto con "{T}, sacrificar este artefacto: Agrega un maná de cualquier color".)\\nLa criatura equipada tiene la habilidad de volar.\\nEquipar {2}. ({2}: Anexa este Equipo a la criatura objetivo que controlas. Activa la habilidad de equipar como un conjuro.)\', \'type\': \'Artefacto — Equipo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555961&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a8b4e770-bfee-49f9-8908-8cbac7081b0d\', \'multiverseId\': 555961}, \'multiverseid\': 555961}, {\'name\': \'Ailerons dorés\', \'text\': "Quand les Ailerons dorés arrivent sur le champ de bataille, créez un jeton Trésor. (C\'est un artefact avec « {T}, sacrifiez cet artefact : Ajoutez un mana de la couleur de votre choix. »)\\nLa créature équipée a le vol.\\nÉquipement {2} ({2} : Attachez à une créature ciblée que vous contrôlez. N\'attachez l\'équipement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Artefact : équipement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556222&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2097e1c4-b0a2-4631-a2f5-203b56821c4f\', \'multiverseId\': 556222}, \'multiverseid\': 556222}, {\'name\': \'Remiganti Dorate\', \'text\': \'Quando le Remiganti Dorate entrano nel campo di battaglia, crea una pedina Tesoro. (È un artefatto con "{T}, Sacrifica questo artefatto: Aggiungi un mana di un qualsiasi colore".)\\nLa creatura equipaggiata ha volare.\\nEquipaggiare {2} ({2}: Assegna a una creatura bersaglio che controlli. Equipaggia solo come una stregoneria.)\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556483&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a5417d67-ba41-41f4-b945-2621f506fbd0\', \'multiverseId\': 556483}, \'multiverseid\': 556483}, {\'name\': \'金色の両翼\', \'text\': \'金色の両翼が戦場に出たとき、宝物・トークン１つを生成する。（それは、「{T}, このアーティファクトを生け贄に捧げる：好きな色１色のマナ１点を加える。」を持つアーティファクトである。）\\n装備しているクリーチャーは飛行を持つ。\\n装備{2}（{2}：あなたがコントロールしているクリーチャー１体を対象とする。これをそれにつける。装備はソーサリーとしてのみ行う。）\', \'type\': \'アーティファクト — 装備品\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556744&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f9bb8072-4924-4f9f-ac36-e5600a597c5e\', \'multiverseId\': 556744}, \'multiverseid\': 556744}, {\'name\': \'금박 날개\', \'text\': \'금박 날개가 전장에 들어올 때, 보물 토큰 한 개를 만든다. (보물 토큰은 "{T}, 이 마법물체를 희생한다: 원하는 색의 마나 한 개를 추가한다."를 가진 마법물체이다.)\\n장착된 생물은 비행을 가진다.\\n장착 {2} ({2}: 당신이 조종하는 생물을 목표로 정한다. 그 생물에 이 장비를 부착한다. 집중마법 시기에만 장착할 수 있다.)\', \'type\': \'마법물체 — 장비\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557005&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9f7db671-91c1-48b2-9b8d-9c1efcebd5bd\', \'multiverseId\': 557005}, \'multiverseid\': 557005}, {\'name\': \'Penas Douradas\', \'text\': \'Quando Penas Douradas entrar no campo de batalha, crie uma ficha de Tesouro. (Ela é um artefato com "{T}, sacrifique este artefato: Adicione um mana de qualquer cor".)\\nA criatura equipada tem voar.\\nEquipar {2} ({2}: Anexe este equipamento à criatura alvo que você controla. Equipe somente como um feitiço.)\', \'type\': \'Artefato — Equipamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557266&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f89f6215-707b-43ce-ac3d-7dd12c1a2234\', \'multiverseId\': 557266}, \'multiverseid\': 557266}, {\'name\': \'Позолоченные Крылья\', \'text\': \'Когда Позолоченные Крылья выходят на поле битвы, создайте одну фишку Клада. (Это артефакт со способностью «{T}, пожертвуйте этот артефакт: добавьте одну ману любого цвета».)\\nСнаряженное существо имеет Полет.\\nСнарядить {2} ({2}: прикрепите к целевому существу под вашим контролем. Снаряжайте только как волшебство.)\', \'type\': \'Артефакт — Снаряжение\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557527&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6e553418-b1e5-4656-8893-a7d3c2b8a743\', \'multiverseId\': 557527}, \'multiverseid\': 557527}, {\'name\': \'金箔翅翼\', \'text\': \'当金箔翅翼进战场时，派出一个珍宝衍生物。（珍宝衍生物是具有「{T}，牺牲此神器：加一点任意颜色的法术力」的神器。）\\n佩带此武具的生物具有飞行异能。\\n佩带{2}（{2}：贴附在目标由你操控的生物上。只能于法术时机佩带。）\', \'type\': \'神器 ～武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557788&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'be05cdc6-ef0e-4f32-8b61-d3c715ef1840\', \'multiverseId\': 557788}, \'multiverseid\': 557788}, {\'name\': \'金箔翅翼\', \'text\': \'當金箔翅翼進戰場時，派出一個珍寶衍生物。（珍寶衍生物是具有「{T}，犧牲此神器：加一點任意顏色的魔法力」的神器。）\\n佩帶此武具的生物具有飛行異能。\\n佩帶{2}（{2}：貼附在目標由你操控的生物上。只能於巫術時機佩帶。）\', \'type\': \'神器 ～武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558049&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'84fa4636-f956-422a-a685-5871533b2e2a\', \'multiverseId\': 558049}, \'multiverseid\': 558049}]', '[{\'name\': \'Versteck der Brokers\', \'text\': \'Wenn das Versteck der Brokers ins Spiel kommt, opfere es. Wenn du dies tust, durchsuche deine Bibliothek nach einer Wald-, Ebene- oder Insel-Standardlandkarte, bringe sie getappt ins Spiel und mische danach. Du erhältst 1 Lebenspunkt dazu.\', \'type\': \'Land\', \'flavor\': \'Sobald der Zeuge den Unterschlupf betreten hatte, verschwand er zuerst aus dem Blick und dann aus der Erinnerung.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555710&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2449bafe-4292-45ee-8fb1-93a2e5fc0279\', \'multiverseId\': 555710}, \'multiverseid\': 555710}, {\'name\': \'Escondrijo de los Mediadores\', \'text\': \'Cuando el Escondrijo de los Mediadores entre al campo de batalla, sacrifícalo. Cuando lo hagas, busca en tu biblioteca una carta de Bosque, Llanura o Isla básica y ponla en el campo de batalla girada. Luego baraja y ganas 1 vida.\', \'type\': \'Tierra\', \'flavor\': \'En cuanto el testigo entró, el refugio desapareció de la vista, y luego de la memoria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555971&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1d13f002-1e8c-4631-b75c-15104f7d35b9\', \'multiverseId\': 555971}, \'multiverseid\': 555971}, {\'name\': \'Planque des Courtiers\', \'text\': "Quand la Planque des Courtiers arrive sur le champ de bataille, sacrifiez-la. Quand vous faites ainsi, cherchez dans votre bibliothèque une carte de forêt, de plaine ou d\'île de base, mettez-la sur le champ de bataille engagée, puis mélangez et vous gagnez 1 point de vie.", \'type\': \'Terrain\', \'flavor\': "Une fois le témoin rentré, la planque disparut, puis sombra dans l\'oubli.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556232&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7136b7ea-655e-43ae-8580-0dc51bcc6809\', \'multiverseId\': 556232}, \'multiverseid\': 556232}, {\'name\': \'Covo degli Intermediari\', \'text\': \'Quando il Covo degli Intermediari entra nel campo di battaglia, sacrificalo. Quando lo fai, passa in rassegna il tuo grimorio per una carta Foresta, Pianura o Isola base, mettila sul campo di battaglia TAPpata, poi rimescola e guadagni 1 punto vita.\', \'type\': \'Terra\', \'flavor\': \'Una volta che il testimone fu dentro, il rifugio svanì prima alla vista, poi dalla memoria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556493&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6a80a710-bdfc-47f1-a40a-a51f081d96ce\', \'multiverseId\': 556493}, \'multiverseid\': 556493}, {\'name\': \'斡旋屋一家の潜伏先\', \'text\': \'斡旋屋一家の潜伏先が戦場に出たとき、これを生け贄に捧げる。そうしたとき、あなたのライブラリーから基本であり森や平地や島であるカード１枚を探し、タップ状態で戦場に出す。その後、ライブラリーを切り直し、あなたは１点のライフを得る。\', \'type\': \'土地\', \'flavor\': \'目撃者が中に入ると、その隠れ家はまず視界から消え、その後記憶からも消えた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556754&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'48b77b71-4f73-4003-a28e-c9bd74a7f3e0\', \'multiverseId\': 556754}, \'multiverseid\': 556754}, {\'name\': \'브로커즈 은신처\', \'text\': \'브로커즈 은신처가 전장에 들어올 때, 브로커즈 은신처를 희생한다. 그렇게 할 때, 당신의 서고에서 기본 숲, 들 또는 섬 카드 한 장을 찾아, 그 카드를 탭된 채로 전장에 놓은 후, 서고를 섞고 당신은 생명 1점을 얻는다.\', \'type\': \'대지\', \'flavor\': \'목격자가 안으로 들어가자, 은신처가 우선은 시야에서 사라졌고, 그 다음에는 기억에서 사라졌다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557015&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'cb1f1d04-019b-45fe-b8bb-114936872f33\', \'multiverseId\': 557015}, \'multiverseid\': 557015}, {\'name\': \'Esconderijo dos Mediadores\', \'text\': \'Quando Esconderijo dos Mediadores entrar no campo de batalha, sacrifique-o. Quando fizer isso, procure em seu grimório um card de Floresta, Planície ou Ilha básico, coloque-o no campo de batalha virado, depois embaralhe e você ganha 1 ponto de vida.\', \'type\': \'Terreno\', \'flavor\': \'Assim que a testemunha entrou, o refúgio sumiu, primeiro de vista e depois da memória.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557276&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'914d4b27-ee79-4c93-90d2-df4aadb86b60\', \'multiverseId\': 557276}, \'multiverseid\': 557276}, {\'name\': \'Укрытие Брокеров\', \'text\': \'Когда Укрытие Брокеров выходит на поле битвы, пожертвуйте его. Когда вы это делаете, найдите в вашей библиотеке карту базового Леса, Равнины или Острова, положите ее на поле битвы повернутой, затем перетасуйте библиотеку, и вы получаете 1 жизнь.\', \'type\': \'Земля\', \'flavor\': \'Как только свидетель оказался внутри, укрытие исчезло сначала из виду, а потом из памяти.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557537&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3104baa0-d2c8-4615-a9cd-5a72633b9e6a\', \'multiverseId\': 557537}, \'multiverseid\': 557537}, {\'name\': \'扶济社藏所\', \'text\': \'当扶济社藏所进战场时，将它牺牲。当你如此作时，从你牌库中搜寻一张基本的树林，平原或海岛牌，将之横置放进战场，然后洗牌且你获得1点生命。\', \'type\': \'地\', \'flavor\': \'目击证人进门后，藏身处先从视线中消失，再自记忆中抹除。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557798&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9d2d4a33-b65f-4742-a82d-d4d45cac3f1f\', \'multiverseId\': 557798}, \'multiverseid\': 557798}, {\'name\': \'扶濟社藏所\', \'text\': \'當扶濟社藏所進戰場時，將它犧牲。當你如此作時，從你牌庫中搜尋一張基本的樹林，平原或海島牌，將之橫置放進戰場，然後洗牌且你獲得1點生命。\', \'type\': \'地\', \'flavor\': \'目擊證人進門後，藏身處先從視線中消失，再自記憶中抹除。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558059&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'89c2a0b5-be35-438a-9537-5cd0ac2e9461\', \'multiverseId\': 558059}, \'multiverseid\': 558059}]', '[{\'name\': \'Versteck der Schmuggler\', \'text\': \'Länder, die du kontrollierst, haben „{T}: Erzeuge einen Schatz-Spielstein."\', \'type\': \'Artefakt\', \'flavor\': \'Labyrinthe aus Tunneln unter den Straßen der Caldaia bieten unternehmungslustigen Schmugglern jede Menge versteckte Wege.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555596&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b3f4ed46-7bbc-4909-8f76-037dbadeafa0\', \'multiverseId\': 555596}, \'multiverseid\': 555596}, {\'name\': \'Alijo de los traficantes\', \'text\': \'Las tierras que controlas tienen "{T}: Crea una ficha de Tesoro".\', \'type\': \'Artefacto\', \'flavor\': \'Los túneles laberínticos bajo las calles de Caldaia ofrecen una amplia variedad de rutas discretas a los contrabandistas emprendedores.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555857&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6b9697bb-2989-4cff-b065-490c938f1065\', \'multiverseId\': 555857}, \'multiverseid\': 555857}, {\'name\': "Stock des trafiquants d\'alcool", \'text\': \'Les terrains que vous contrôlez ont « {T} : Créez un jeton Trésor. »\', \'type\': \'Artefact\', \'flavor\': \'Les dédales de tunnels sous les rues du Caldaïa offrent tout un réseau de chemins discrets pour les contrebandiers entreprenants.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556118&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'94342665-530f-4231-a76c-cfa5a9acf297\', \'multiverseId\': 556118}, \'multiverseid\': 556118}, {\'name\': \'Scorte dei Contrabbandieri\', \'text\': \'Le terre che controlli hanno "{T}: Crea una pedina Tesoro".\', \'type\': \'Artefatto\', \'flavor\': "Le gallerie labirintiche sotto le strade di Caldaia offrono un\'ampia gamma di percorsi discreti per contrabbandieri intraprendenti.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556379&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b6f414e4-4502-46d3-87b7-5dfb6552bf0c\', \'multiverseId\': 556379}, \'multiverseid\': 556379}, {\'name\': \'密造酒屋の隠し財産\', \'text\': \'あなたがコントロールしているすべての土地は「{T}：宝物・トークン１つを生成する。」を持つ。\', \'type\': \'アーティファクト\', \'flavor\': \'カルダイヤの街路の下に張り巡らされたトンネルの迷宮は、野心的な密輸者に膨大な数の人目につかない通路を提供する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556640&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'316c53f8-710b-4284-ab15-b80042b423e8\', \'multiverseId\': 556640}, \'multiverseid\': 556640}, {\'name\': \'주류 밀매자의 은닉물\', \'text\': \'당신이 조종하는 대지들은 "{T}: 보물 토큰 한 개를 만든다."를 가진다.\', \'type\': \'마법물체\', \'flavor\': \'칼다이아의 거리 아래에 미로처럼 펼쳐져 있는 터널들은 진취적인 밀수업자들을 위한 다양한 비밀 통로를 제공한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556901&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e6d31ce9-1a76-49f8-8490-a5d2cf0f9d02\', \'multiverseId\': 556901}, \'multiverseid\': 556901}, {\'name\': \'Estoque do Contrabandista\', \'text\': \'Os terrenos que você controla têm "{T}: Crie uma ficha de Tesouro".\', \'type\': \'Artefato\', \'flavor\': \'Os labirintos de túneis sob as ruas de Caldaia oferecem uma vasta gama de caminhos discretos para contrabandistas empreendedores.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557162&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a977b1d1-1bdb-4d34-8371-72e1193d3558\', \'multiverseId\': 557162}, \'multiverseid\': 557162}, {\'name\': \'Тайник Бутлегеров\', \'text\': \'Земли под вашим контролем имеют способность «{T}: создайте одну фишку Клада».\', \'type\': \'Артефакт\', \'flavor\': \'Лабиринты туннелей под улицами Калдайи открывают множество незаметных путей для предприимчивых контрабандистов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557423&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d6e27fec-a739-41a4-97c7-28799dbb6e92\', \'multiverseId\': 557423}, \'multiverseid\': 557423}, {\'name\': \'私商匿窖\', \'text\': \'由你操控的地具有「{T}：派出一个珍宝衍生物。」\', \'type\': \'神器\', \'flavor\': \'柯达亚街道底下通路繁杂如迷宫，为事业心强旺的走私犯提供无数秘径。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557684&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cdd79419-bafe-4c0c-b3db-50616a2eadff\', \'multiverseId\': 557684}, \'multiverseid\': 557684}, {\'name\': \'私商匿窖\', \'text\': \'由你操控的地具有「{T}：派出一個珍寶衍生物。」\', \'type\': \'神器\', \'flavor\': \'柯達亞街道底下通路繁雜如迷宮，為事業心強旺的走私犯提供無數秘徑。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557945&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'04745315-7ecf-4f26-a3fc-d4a02ed10639\', \'multiverseId\': 557945}, \'multiverseid\': 557945}]', '[{\'name\': \'Versteck der Schmuggler\', \'text\': \'Länder, die du kontrollierst, haben „{T}: Erzeuge einen Schatz-Spielstein."\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558433&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b2f756ac-2d37-4968-97f7-fa0e5cb42055\', \'multiverseId\': 558433}, \'multiverseid\': 558433}, {\'name\': \'Alijo de los traficantes\', \'text\': \'Las tierras que controlas tienen "{T}: Crea una ficha de Tesoro".\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558444&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'65fd732a-98e0-479d-b421-2c92e0f480fb\', \'multiverseId\': 558444}, \'multiverseid\': 558444}, {\'name\': "Stock des trafiquants d\'alcool", \'text\': \'Les terrains que vous contrôlez ont « {T} : Créez un jeton Trésor. »\', \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558455&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2e1d6632-e4e9-4a8f-a7d9-77d9065a551a\', \'multiverseId\': 558455}, \'multiverseid\': 558455}, {\'name\': \'Scorte dei Contrabbandieri\', \'text\': \'Le terre che controlli hanno "{T}: Crea una pedina Tesoro".\', \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558466&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c8d0f971-adc8-4ef9-84b9-4ec5a162a16c\', \'multiverseId\': 558466}, \'multiverseid\': 558466}, {\'name\': \'密造酒屋の隠し財産\', \'text\': \'あなたがコントロールしているすべての土地は「{T}：宝物・トークン１つを生成する。」を持つ。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558477&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5751bdd5-4af6-435a-82a2-42e32b7cba76\', \'multiverseId\': 558477}, \'multiverseid\': 558477}, {\'name\': \'주류 밀매자의 은닉물\', \'text\': \'당신이 조종하는 대지들은 "{T}: 보물 토큰 한 개를 만든다."를 가진다.\', \'type\': \'마법물체\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558488&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'caeca487-6ef6-4cc5-b76a-4b01e58f66cd\', \'multiverseId\': 558488}, \'multiverseid\': 558488}, {\'name\': \'Estoque do Contrabandista\', \'text\': \'Os terrenos que você controla têm "{T}: Crie uma ficha de Tesouro".\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558499&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'eacb819d-3c55-4ef3-a7b0-a29a6c390b5a\', \'multiverseId\': 558499}, \'multiverseid\': 558499}, {\'name\': \'Тайник Бутлегеров\', \'text\': \'Земли под вашим контролем имеют способность «{T}: создайте одну фишку Клада».\', \'type\': \'Артефакт\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558510&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cd5523ba-14dd-4fa4-9f63-ce27ed9a7e6f\', \'multiverseId\': 558510}, \'multiverseid\': 558510}, {\'name\': \'私商匿窖\', \'text\': \'由你操控的地具有「{T}：派出一个珍宝衍生物。」\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558521&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'46b96200-797a-4d45-bbcf-0dd6b49473ce\', \'multiverseId\': 558521}, \'multiverseid\': 558521}, {\'name\': \'私商匿窖\', \'text\': \'由你操控的地具有「{T}：派出一個珍寶衍生物。」\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558532&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3f947cd5-dabb-4b01-aca0-efc1de3afc3e\', \'multiverseId\': 558532}, \'multiverseid\': 558532}]', '[{\'name\': \'Verächtlicher Hieb\', \'text\': \'Neutralisiere einen Zauberspruch deiner Wahl mit Manabetrag 4 oder mehr.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ich wusste schon vor einem Jahr, dass du genau diesen Zauberspruch an genau dieser Stelle zu genau dieser Zeit wirken würdest."\\n—Raffine\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555501&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e059b9e1-b045-4296-9806-3c39f755233c\', \'multiverseId\': 555501}, \'multiverseid\': 555501}, {\'name\': \'Golpe altanero\', \'text\': \'Contrarresta el hechizo objetivo con valor de maná de 4 o más.\', \'type\': \'Instantáneo\', \'flavor\': \'"Hace un año que sé que ibas a lanzar este hechizo, en este preciso lugar y en este preciso instante".\\n—Raffine\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555762&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b87f3c17-a22c-4963-b52f-520656090368\', \'multiverseId\': 555762}, \'multiverseid\': 555762}, {\'name\': \'Botte dédaigneuse\', \'text\': \'Contrecarrez un sort avec une valeur de mana supérieure ou égale à 4 ciblé.\', \'type\': \'Éphémère\', \'flavor\': \'« Voilà un an que je savais que tu lancerais ce sort précis, à cet endroit précis, à ce moment précis. »\\n—Raffine\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556023&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7193543c-73e2-494c-834d-cd9945eb54f3\', \'multiverseId\': 556023}, \'multiverseid\': 556023}, {\'name\': \'Fendente Sdegnoso\', \'text\': \'Neutralizza una magia bersaglio con valore di mana pari o superiore a 4.\', \'type\': \'Istantaneo\', \'flavor\': \'"Sapevo da un anno che avresti lanciato questa magia, in questo punto e in questo momento."\\n—Raffine\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556284&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'65a68c7c-aec7-413c-8279-27920c9a90dd\', \'multiverseId\': 556284}, \'multiverseid\': 556284}, {\'name\': \'軽蔑的な一撃\', \'text\': \'マナ総量が４以上である呪文１つを対象とする。それを打ち消す。\', \'type\': \'インスタント\', \'flavor\': \'「あなたがこの場所でこの時間にこの呪文を唱えることは、一年前からわかっていました。」\\n――ラフィーン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556545&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fe73e87e-a962-4289-89c3-191ba2d721e0\', \'multiverseId\': 556545}, \'multiverseid\': 556545}, {\'name\': \'경멸의 일격\', \'text\': \'마나 값이 4 이상인 주문을 목표로 정한다. 그 주문을 무효화한다.\', \'type\': \'순간마법\', \'flavor\': \'"네가 바로 이 주문을, 바로 이 장소에서, 바로 이 시점에 발동하리라는 것을 일 년 전부터 알고 있었지."\\n—라핀\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556806&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'cf6e8520-9520-4340-bfbf-824897a64e16\', \'multiverseId\': 556806}, \'multiverseid\': 556806}, {\'name\': \'Golpe Desdenhoso\', \'text\': \'Anule a mágica alvo com valor de mana igual ou superior a 4.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Já faz um ano que eu soube que você conjuraria essa mágica específica nesse exato local precisamente a essa hora."\\n— Raffine\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557067&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ff431c7d-41d9-4a14-b5c2-71da45657558\', \'multiverseId\': 557067}, \'multiverseid\': 557067}, {\'name\': \'Презрительный Удар\', \'text\': \'Отмените целевое заклинание с мановой ценностью 4 или больше.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Я уже год как знаю, что ты прочитаешь именно это заклинание именно в этом месте и именно в это время».\\n— Раффина\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557328&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cb6ebbd0-84b5-4318-9838-20f1828690ec\', \'multiverseId\': 557328}, \'multiverseid\': 557328}, {\'name\': \'倨傲击\', \'text\': \'反击目标法术力值等于或大于4的咒语。\', \'type\': \'瞬间\', \'flavor\': \'「时间、地点、咒语：你的所有作为与我一年前所料分毫不差。」\\n～拉斐茵\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557589&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b4856308-e9aa-43fe-b8b1-735eb521b923\', \'multiverseId\': 557589}, \'multiverseid\': 557589}, {\'name\': \'倨傲擊\', \'text\': \'反擊目標魔法力值等於或大於4的咒語。\', \'type\': \'瞬間\', \'flavor\': \'「時間、地點、咒語：你的所有作為與我一年前所料分毫不差。」\\n～拉斐茵\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557850&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'15127b5b-d118-4483-ac06-4de38140bdab\', \'multiverseId\': 557850}, \'multiverseid\': 557850}]', '[{\'name\': \'Virtuoser Illuminator\', \'text\': \'Doppelschlag\\nImmer wenn der Virtuose Illuminator das Ziel eines Zauberspruchs wird, den du kontrollierst, intrigiert er. (Ziehe eine Karte und wirf dann eine Karte ab. Falls du eine Nichtland-Karte abgeworfen hast, lege eine +1/+1-Marke auf diese Kreatur.)\', \'type\': \'Kreatur — Mensch, Räuber\', \'flavor\': \'Die schärfsten Klingen der Obscura sind den Verrätern in ihrer Mitte vorbehalten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555479&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c6dd0018-21e9-4bf7-a24a-4e9c077dce0e\', \'multiverseId\': 555479}, \'multiverseid\': 555479}, {\'name\': \'Virtuoso iluminador\', \'text\': \'Daña dos veces.\\nSiempre que el Virtuoso iluminador sea objetivo de un hechizo que controlas, confabula. (Roba una carta, luego descarta una carta. Si descartaste una carta que no sea tierra, pon un contador +1/+1 sobre esta criatura.)\', \'type\': \'Criatura — Bribón humano\', \'flavor\': \'La Obscura guarda sus hojas más afiladas para los traidores que se ocultan entre sus miembros.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555740&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8ec74c32-48b1-49c6-980e-895e2c0f2abc\', \'multiverseId\': 555740}, \'multiverseid\': 555740}, {\'name\': \'Virtuose illuminateur\', \'text\': "Double initiative\\nÀ chaque fois que le Virtuose illuminateur devient la cible d\'un sort que vous contrôlez, il connive. (Piochez une carte, puis défaussez-vous d\'une carte. Si vous vous êtes défaussé d\'une carte non-terrain, mettez un marqueur +1/+1 sur cette créature.)", \'type\': \'Créature : humain et gredin\', \'flavor\': \'Les Obscura réservent leurs lames les plus affûtées aux traîtres dans leurs rangs.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556001&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'71de2258-f5b4-4781-8511-805d48e48253\', \'multiverseId\': 556001}, \'multiverseid\': 556001}, {\'name\': \'Illuminatore Virtuoso\', \'text\': "Doppio attacco\\nOgniqualvolta l\'Illuminatore Virtuoso diventa bersaglio di una magia che controlli, complotta. (Pesca una carta, poi scarta una carta. Se hai scartato una carta non terra, metti un segnalino +1/+1 su questa creatura.)", \'type\': \'Creatura — Farabutto Umano\', \'flavor\': \'Gli Obscura riservano le loro lame più affilate ai traditori in mezzo a loro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556262&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8c5b00af-83b9-4c23-8f2f-cf133cf92a8c\', \'multiverseId\': 556262}, \'multiverseid\': 556262}, {\'name\': \'照光の巨匠\', \'text\': \'二段攻撃\\n照光の巨匠があなたがコントロールしている呪文の対象になるたび、これは謀議する。（カード１枚を引き、その後カード１枚を捨てる。あなたが土地でないカードを捨てたなら、このクリーチャーの上に＋１/＋１カウンター１個を置く。）\', \'type\': \'クリーチャー — 人間・ならず者\', \'flavor\': \'常夜会一家は、身内の裏切り者のために最も鋭利な刃をとっておく。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556523&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2305983e-898f-48a2-bcb8-18b79ba38920\', \'multiverseId\': 556523}, \'multiverseid\': 556523}, {\'name\': \'조명술 명인\', \'text\': \'이단공격\\n조명술 명인이 당신이 조종하는 주문의 목표가 될 때마다, 조명술 명인은 묵인한다. (카드 한 장을 뽑은 후, 카드 한 장을 버린다. 당신이 대지가 아닌 카드를 버린다면, 이 생물에 +1/+1 카운터 한 개를 올려놓는다.)\', \'type\': \'생물 — 인간 도적\', \'flavor\': \'옵스큐라는 그들 중에 있는 배신자들에게 사용하기 위해 가장 날카로운 칼을 남겨 둔다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556784&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b16bb306-6801-4517-a0d3-08408b761801\', \'multiverseId\': 556784}, \'multiverseid\': 556784}, {\'name\': \'Virtuoso Iluminador\', \'text\': \'Golpe duplo\\nToda vez que Virtuoso Iluminador se torna alvo de uma mágica que você controla, ele acoberta. (Compre um card e depois descarte um card. Se você descartou um card não de terreno, coloque um marcador +1/+1 nesta criatura.)\', \'type\': \'Criatura — Humano Ladino\', \'flavor\': \'Os Obscura guardam as lâminas mais afiadas para os traidores internos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557045&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e3c9cdcd-6d26-4eef-b180-19b4fdf3de19\', \'multiverseId\': 557045}, \'multiverseid\': 557045}, {\'name\': \'Виртуозный Осветитель\', \'text\': \'Двойной удар\\nКаждый раз, когда Виртуозный Осветитель становится целью заклинания под вашим контролем, он сговаривается. (Возьмите карту, затем сбросьте карту. Если вы сбросили не являющуюся землей карту, положите один жетон +1/+1 на это существо.)\', \'type\': \'Существо — Человек Бродяга\', \'flavor\': \'Самые острые клинки в Обскуре держат для предателей из своих рядов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557306&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6f5a0027-2d00-411b-bdaa-8e33ca5ae41d\', \'multiverseId\': 557306}, \'multiverseid\': 557306}, {\'name\': \'耀刃名手\', \'text\': \'连击\\n每当耀刃名手成为由你操控之咒语的目标时，令它筹谋。（抓一张牌，然后弃一张牌。如果你弃的牌不是地，则在此生物上放置一个+1/+1指示物。）\', \'type\': \'生物 ～人类／浪客\', \'flavor\': \'秘闻帮最快的刀专门伺候自家叛徒。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557567&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'db9aa513-99eb-4fc4-8300-9739e8d649b5\', \'multiverseId\': 557567}, \'multiverseid\': 557567}, {\'name\': \'耀刃名手\', \'text\': \'連擊\\n每當耀刃名手成為由你操控之咒語的目標時，令它籌謀。（抽一張牌，然後棄一張牌。如果你棄的牌不是地，則在此生物上放置一個+1/+1指示物。）\', \'type\': \'生物 ～人類／浪客\', \'flavor\': \'秘聞幫最快的刀專門伺候自家叛徒。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557828&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'953e2492-4239-47bc-816a-bf99d1658668\', \'multiverseId\': 557828}, \'multiverseid\': 557828}]', '[{\'name\': \'Vivien auf der Jagd\', \'text\': \'+2: Du kannst eine Kreatur opfern. Falls du dies tust, durchsuche deine Bibliothek nach einer Kreaturenkarte mit Manabetrag gleich 1 plus dem Manabetrag der geopferten Kreatur, bringe sie ins Spiel und mische danach.\\n+1: Du millst fünf Karten. Nimm dann eine beliebige Anzahl an Kreaturenkarten, die auf diese Weise gemillt wurden, auf deine Hand.\\n−1: Erzeuge einen 4/4 grünen Nashorn-Krieger-Kreaturenspielstein.\', \'type\': \'Legendärer Planeswalker — Vivien\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555624&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ad3b9393-fcd9-4f47-b172-14211fb619ea\', \'multiverseId\': 555624}, \'multiverseid\': 555624}, {\'name\': \'Vivien a la caza\', \'text\': \'+2: Puedes sacrificar una criatura. Si lo haces, busca en tu biblioteca una carta de criatura con valor de maná igual a 1 más el valor de maná de la criatura sacrificada, ponla en el campo de batalla y luego baraja.\\n+1: Muele cinco cartas, luego pon cualquier cantidad de cartas de criatura molidas de esta manera en tu mano.\\n−1: Crea una ficha de criatura Guerrero Rinoceronte verde 4/4.\', \'type\': \'Planeswalker legendario — Vivien\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555885&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d6c76990-9684-48b4-8f54-eb98850f9d82\', \'multiverseId\': 555885}, \'multiverseid\': 555885}, {\'name\': \'Vivien en chasse\', \'text\': "+2: Vous pouvez sacrifier une créature. Si vous faites ainsi, cherchez dans votre bibliothèque une carte de créature avec une valeur de mana égale à 1 plus la valeur de mana de la créature sacrifiée, mettez-la sur le champ de bataille, puis mélangez.\\n+1: Meulez cinq cartes, puis mettez n\'importe quel nombre de cartes de créature meulées de cette manière dans votre main.\\n-1: Créez un jeton de créature 4/4 verte Rhinocéros et Guerrier.", \'type\': \'Planeswalker légendaire : Vivien\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556146&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c3949928-e3f9-4d0d-adc0-512cdb33b56d\', \'multiverseId\': 556146}, \'multiverseid\': 556146}, {\'name\': \'Vivien a Caccia\', \'text\': \'+2: Puoi sacrificare una creatura. Se lo fai, passa in rassegna il tuo grimorio per una carta creatura con valore di mana pari a 1 più il valore di mana della creatura sacrificata, mettila sul campo di battaglia, poi rimescola.\\n+1: Macina cinque carte, poi aggiungi alla tua mano un qualsiasi numero di carte creatura macinate in questo modo.\\n−1: Crea una pedina creatura Guerriero Rinoceronte 4/4 verde.\', \'type\': \'Planeswalker Leggendario — Vivien\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556407&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dd05f8f8-2adf-4ce4-9678-f785c39b0f62\', \'multiverseId\': 556407}, \'multiverseid\': 556407}, {\'name\': \'狩りに出るビビアン\', \'text\': \'+2：あなたはクリーチャー１体を生け贄に捧げてもよい。そうしたなら、あなたのライブラリーから、そのクリーチャーよりマナ総量が１大きいクリーチャー・カード１枚を探し、戦場に出し、その後ライブラリーを切り直す。\\n+1：カード５枚を切削し、その後これにより切削した望む枚数のクリーチャー・カードをあなたの手札に加える。\\n−1：緑の４/４のサイ・戦士・クリーチャー・トークン１体を生成する。\', \'type\': \'伝説のプレインズウォーカー — ビビアン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556668&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e2a12e19-d2cd-4137-975d-5ca7ab2a7780\', \'multiverseId\': 556668}, \'multiverseid\': 556668}, {\'name\': \'사냥 중인 비비안\', \'text\': \'+2: 당신은 생물 한 개를 희생할 수 있다. 그렇게 한다면, 당신의 서고에서 마나 값이 희생한 생물의 마나 값에 1을 더한 것과 같은 생물 카드 한 장을 찾아, 전장에 놓은 후, 서고를 섞는다.\\n+1: 카드 다섯 장을 민 후, 이런 식으로 밀린 생물 카드들을 원하는 수만큼 당신의 손에 넣는다.\\n−1: 4/4 녹색 코뿔소 전사 생물 토큰 한 개를 만든다.\', \'type\': \'전설적 플레인즈워커 — 비비안\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556929&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e34813e1-80cb-4566-b4ec-d820a6ec9110\', \'multiverseId\': 556929}, \'multiverseid\': 556929}, {\'name\': \'Vivien à Caça\', \'text\': \'+2: Você pode sacrificar uma criatura. Se fizer isso, procure em seu grimório um card de criatura com valor de mana igual a 1 mais o valor de mana da criatura sacrificada, coloque-o no campo de batalha e depois embaralhe.\\n+1: Triture cinco cards e depois coloque qualquer número de cards de criatura triturados dessa forma em sua mão.\\n−1: Crie uma ficha de criatura Rinoceronte Guerreiro verde 4/4.\', \'type\': \'Planeswalker Lendário — Vivien\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557190&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1058ca51-c0d4-4e07-8925-e114159d6896\', \'multiverseId\': 557190}, \'multiverseid\': 557190}, {\'name\': \'Вивьен, Вышедшая на Охоту\', \'text\': \'+2: вы можете пожертвовать существо. Если вы это делаете, найдите в вашей библиотеке карту существа с мановой ценностью, равной 1 плюс мановая ценность пожертвованного существа, положите ее на поле битвы, затем перетасуйте библиотеку.\\n+1: скрутите пять карт, затем положите любое количество скрученных таким образом карт существ в вашу руку.\\n−1: создайте одну фишку существа 4/4 зеленый Носорог Воин.\', \'type\': \'Легендарный Planeswalker — Вивьен\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557451&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'79f3219d-aaad-46d5-9013-b1810f332fbd\', \'multiverseId\': 557451}, \'multiverseid\': 557451}, {\'name\': \'寻猎薇薇安\', \'text\': \'+2：你可以牺牲一个生物。若你如此作，则从你牌库中搜寻一张生物牌，且其法术力值须等同于所牺牲之生物的法术力值加1，将之放进战场，然后洗牌。\\n+1：磨五张牌，然后将任意数量以此法磨掉的生物牌置于你手上。\\n−1：派出一个4/4绿色犀牛／战士衍生生物。\', \'type\': \'传奇鹏洛客 ～薇薇安\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557712&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d844bf40-f703-42d2-a9b0-c97d2c16e21d\', \'multiverseId\': 557712}, \'multiverseid\': 557712}, {\'name\': \'尋獵薇薇安\', \'text\': \'+2：你可以犧牲一個生物。若你如此作，則從你牌庫中搜尋一張生物牌，且其魔法力值須等同於所犧牲之生物的魔法力值加1，將之放進戰場，然後洗牌。\\n+1：磨五張牌，然後將任意數量以此法磨掉的生物牌置於你手上。\\n−1：派出一個4/4綠色犀牛／戰士衍生生物。\', \'type\': \'傳奇鵬洛客 ～薇薇安\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557973&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4453df46-d8a0-4bea-b21b-da6abb3ffe17\', \'multiverseId\': 557973}, \'multiverseid\': 557973}]', '[{\'name\': \'Vivien auf der Jagd\', \'text\': \'+2: Du kannst eine Kreatur opfern. Falls du dies tust, durchsuche deine Bibliothek nach einer Kreaturenkarte mit Manabetrag gleich 1 plus dem Manabetrag der geopferten Kreatur, bringe sie ins Spiel und mische danach.\\n+1: Du millst fünf Karten. Nimm dann eine beliebige Anzahl an Kreaturenkarten, die auf diese Weise gemillt wurden, auf deine Hand.\\n−1: Erzeuge einen 4/4 grünen Nashorn-Krieger-Kreaturenspielstein.\', \'type\': \'Legendärer Planeswalker — Vivien\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558077&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'26c55f3f-de92-447c-aaeb-352607252e23\', \'multiverseId\': 558077}, \'multiverseid\': 558077}, {\'name\': \'Vivien a la caza\', \'text\': \'+2: Puedes sacrificar una criatura. Si lo haces, busca en tu biblioteca una carta de criatura con valor de maná igual a 1 más el valor de maná de la criatura sacrificada, ponla en el campo de batalla y luego baraja.\\n+1: Muele cinco cartas, luego pon cualquier cantidad de cartas de criatura molidas de esta manera en tu mano.\\n−1: Crea una ficha de criatura Guerrero Rinoceronte verde 4/4.\', \'type\': \'Planeswalker legendario — Vivien\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558080&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a34eef07-7718-4689-b088-329c16a55f90\', \'multiverseId\': 558080}, \'multiverseid\': 558080}, {\'name\': \'Vivien en chasse\', \'text\': "+2: Vous pouvez sacrifier une créature. Si vous faites ainsi, cherchez dans votre bibliothèque une carte de créature avec une valeur de mana égale à 1 plus la valeur de mana de la créature sacrifiée, mettez-la sur le champ de bataille, puis mélangez.\\n+1: Meulez cinq cartes, puis mettez n\'importe quel nombre de cartes de créature meulées de cette manière dans votre main.\\n-1: Créez un jeton de créature 4/4 verte Rhinocéros et Guerrier.", \'type\': \'Planeswalker légendaire : Vivien\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558083&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0325a56c-6c63-47c2-a82e-2b81034d6a9a\', \'multiverseId\': 558083}, \'multiverseid\': 558083}, {\'name\': \'Vivien a Caccia\', \'text\': \'+2: Puoi sacrificare una creatura. Se lo fai, passa in rassegna il tuo grimorio per una carta creatura con valore di mana pari a 1 più il valore di mana della creatura sacrificata, mettila sul campo di battaglia, poi rimescola.\\n+1: Macina cinque carte, poi aggiungi alla tua mano un qualsiasi numero di carte creatura macinate in questo modo.\\n−1: Crea una pedina creatura Guerriero Rinoceronte 4/4 verde.\', \'type\': \'Planeswalker Leggendario — Vivien\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558086&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'447c76da-975d-45e6-85eb-a1fc71ed1c1e\', \'multiverseId\': 558086}, \'multiverseid\': 558086}, {\'name\': \'狩りに出るビビアン\', \'text\': \'+2：あなたはクリーチャー１体を生け贄に捧げてもよい。そうしたなら、あなたのライブラリーから、そのクリーチャーよりマナ総量が１大きいクリーチャー・カード１枚を探し、戦場に出し、その後ライブラリーを切り直す。\\n+1：カード５枚を切削し、その後これにより切削した望む枚数のクリーチャー・カードをあなたの手札に加える。\\n−1：緑の４/４のサイ・戦士・クリーチャー・トークン１体を生成する。\', \'type\': \'伝説のプレインズウォーカー — ビビアン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558089&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'edb09c5a-480f-4739-a44e-b5a7ad5971be\', \'multiverseId\': 558089}, \'multiverseid\': 558089}, {\'name\': \'사냥 중인 비비안\', \'text\': \'+2: 당신은 생물 한 개를 희생할 수 있다. 그렇게 한다면, 당신의 서고에서 마나 값이 희생한 생물의 마나 값에 1을 더한 것과 같은 생물 카드 한 장을 찾아, 전장에 놓은 후, 서고를 섞는다.\\n+1: 카드 다섯 장을 민 후, 이런 식으로 밀린 생물 카드들을 원하는 수만큼 당신의 손에 넣는다.\\n−1: 4/4 녹색 코뿔소 전사 생물 토큰 한 개를 만든다.\', \'type\': \'전설적 플레인즈워커 — 비비안\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558092&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'150ebd6c-bdcc-48ac-9e6a-4778c211ac8a\', \'multiverseId\': 558092}, \'multiverseid\': 558092}, {\'name\': \'Vivien à Caça\', \'text\': \'+2: Você pode sacrificar uma criatura. Se fizer isso, procure em seu grimório um card de criatura com valor de mana igual a 1 mais o valor de mana da criatura sacrificada, coloque-o no campo de batalha e depois embaralhe.\\n+1: Triture cinco cards e depois coloque qualquer número de cards de criatura triturados dessa forma em sua mão.\\n−1: Crie uma ficha de criatura Rinoceronte Guerreiro verde 4/4.\', \'type\': \'Planeswalker Lendário — Vivien\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558095&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8132bcdb-15a0-419b-8f33-8451fc4a9ff3\', \'multiverseId\': 558095}, \'multiverseid\': 558095}, {\'name\': \'Вивьен, Вышедшая на Охоту\', \'text\': \'+2: вы можете пожертвовать существо. Если вы это делаете, найдите в вашей библиотеке карту существа с мановой ценностью, равной 1 плюс мановая ценность пожертвованного существа, положите ее на поле битвы, затем перетасуйте библиотеку.\\n+1: скрутите пять карт, затем положите любое количество скрученных таким образом карт существ в вашу руку.\\n−1: создайте одну фишку существа 4/4 зеленый Носорог Воин.\', \'type\': \'Легендарный Planeswalker — Вивьен\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558098&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0652e93b-e446-4d79-a89d-7121b8e0f976\', \'multiverseId\': 558098}, \'multiverseid\': 558098}, {\'name\': \'寻猎薇薇安\', \'text\': \'+2：你可以牺牲一个生物。若你如此作，则从你牌库中搜寻一张生物牌，且其法术力值须等同于所牺牲之生物的法术力值加1，将之放进战场，然后洗牌。\\n+1：磨五张牌，然后将任意数量以此法磨掉的生物牌置于你手上。\\n−1：派出一个4/4绿色犀牛／战士衍生生物。\', \'type\': \'传奇鹏洛客 ～薇薇安\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558101&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'76387c59-afe2-4dad-81d1-5dc5ab2657f1\', \'multiverseId\': 558101}, \'multiverseid\': 558101}, {\'name\': \'尋獵薇薇安\', \'text\': \'+2：你可以犧牲一個生物。若你如此作，則從你牌庫中搜尋一張生物牌，且其魔法力值須等同於所犧牲之生物的魔法力值加1，將之放進戰場，然後洗牌。\\n+1：磨五張牌，然後將任意數量以此法磨掉的生物牌置於你手上。\\n−1：派出一個4/4綠色犀牛／戰士衍生生物。\', \'type\': \'傳奇鵬洛客 ～薇薇安\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558104&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0641dd44-6388-4fdc-be7e-1cce04e99be5\', \'multiverseId\': 558104}, \'multiverseid\': 558104}]', '[{\'name\': \'Vivien auf der Jagd\', \'text\': \'+2: Du kannst eine Kreatur opfern. Falls du dies tust, durchsuche deine Bibliothek nach einer Kreaturenkarte mit Manabetrag gleich 1 plus dem Manabetrag der geopferten Kreatur, bringe sie ins Spiel und mische danach.\\n+1: Du millst fünf Karten. Nimm dann eine beliebige Anzahl an Kreaturenkarten, die auf diese Weise gemillt wurden, auf deine Hand.\\n−1: Erzeuge einen 4/4 grünen Nashorn-Krieger-Kreaturenspielstein.\', \'type\': \'Legendärer Planeswalker — Vivien\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558555&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'80b2a476-9a7a-4d44-afd7-73277af51b00\', \'multiverseId\': 558555}, \'multiverseid\': 558555}, {\'name\': \'Vivien a la caza\', \'text\': \'+2: Puedes sacrificar una criatura. Si lo haces, busca en tu biblioteca una carta de criatura con valor de maná igual a 1 más el valor de maná de la criatura sacrificada, ponla en el campo de batalla y luego baraja.\\n+1: Muele cinco cartas, luego pon cualquier cantidad de cartas de criatura molidas de esta manera en tu mano.\\n−1: Crea una ficha de criatura Guerrero Rinoceronte verde 4/4.\', \'type\': \'Planeswalker legendario — Vivien\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558564&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0bb2c6cf-a4c4-4ba2-8ae2-f391c922d090\', \'multiverseId\': 558564}, \'multiverseid\': 558564}, {\'name\': \'Vivien en chasse\', \'text\': "+2: Vous pouvez sacrifier une créature. Si vous faites ainsi, cherchez dans votre bibliothèque une carte de créature avec une valeur de mana égale à 1 plus la valeur de mana de la créature sacrifiée, mettez-la sur le champ de bataille, puis mélangez.\\n+1: Meulez cinq cartes, puis mettez n\'importe quel nombre de cartes de créature meulées de cette manière dans votre main.\\n-1: Créez un jeton de créature 4/4 verte Rhinocéros et Guerrier.", \'type\': \'Planeswalker légendaire : Vivien\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558573&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b0157370-10c9-43b3-acdf-62b717ae891c\', \'multiverseId\': 558573}, \'multiverseid\': 558573}, {\'name\': \'Vivien a Caccia\', \'text\': \'+2: Puoi sacrificare una creatura. Se lo fai, passa in rassegna il tuo grimorio per una carta creatura con valore di mana pari a 1 più il valore di mana della creatura sacrificata, mettila sul campo di battaglia, poi rimescola.\\n+1: Macina cinque carte, poi aggiungi alla tua mano un qualsiasi numero di carte creatura macinate in questo modo.\\n−1: Crea una pedina creatura Guerriero Rinoceronte 4/4 verde.\', \'type\': \'Planeswalker Leggendario — Vivien\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558582&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3a14dc61-9818-4d8d-8edc-f2cd68dca39f\', \'multiverseId\': 558582}, \'multiverseid\': 558582}, {\'name\': \'狩りに出るビビアン\', \'text\': \'+2：あなたはクリーチャー１体を生け贄に捧げてもよい。そうしたなら、あなたのライブラリーから、そのクリーチャーよりマナ総量が１大きいクリーチャー・カード１枚を探し、戦場に出し、その後ライブラリーを切り直す。\\n+1：カード５枚を切削し、その後これにより切削した望む枚数のクリーチャー・カードをあなたの手札に加える。\\n−1：緑の４/４のサイ・戦士・クリーチャー・トークン１体を生成する。\', \'type\': \'伝説のプレインズウォーカー — ビビアン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558591&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b7c64951-d566-4f3d-9f4d-51de873786db\', \'multiverseId\': 558591}, \'multiverseid\': 558591}, {\'name\': \'사냥 중인 비비안\', \'text\': \'+2: 당신은 생물 한 개를 희생할 수 있다. 그렇게 한다면, 당신의 서고에서 마나 값이 희생한 생물의 마나 값에 1을 더한 것과 같은 생물 카드 한 장을 찾아, 전장에 놓은 후, 서고를 섞는다.\\n+1: 카드 다섯 장을 민 후, 이런 식으로 밀린 생물 카드들을 원하는 수만큼 당신의 손에 넣는다.\\n−1: 4/4 녹색 코뿔소 전사 생물 토큰 한 개를 만든다.\', \'type\': \'전설적 플레인즈워커 — 비비안\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558600&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'75a97f06-3bc2-48ae-a723-33635cf3dd43\', \'multiverseId\': 558600}, \'multiverseid\': 558600}, {\'name\': \'Vivien à Caça\', \'text\': \'+2: Você pode sacrificar uma criatura. Se fizer isso, procure em seu grimório um card de criatura com valor de mana igual a 1 mais o valor de mana da criatura sacrificada, coloque-o no campo de batalha e depois embaralhe.\\n+1: Triture cinco cards e depois coloque qualquer número de cards de criatura triturados dessa forma em sua mão.\\n−1: Crie uma ficha de criatura Rinoceronte Guerreiro verde 4/4.\', \'type\': \'Planeswalker Lendário — Vivien\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558609&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a0062898-3a7d-4561-a04f-0f22bc2594e5\', \'multiverseId\': 558609}, \'multiverseid\': 558609}, {\'name\': \'Вивьен, Вышедшая на Охоту\', \'text\': \'+2: вы можете пожертвовать существо. Если вы это делаете, найдите в вашей библиотеке карту существа с мановой ценностью, равной 1 плюс мановая ценность пожертвованного существа, положите ее на поле битвы, затем перетасуйте библиотеку.\\n+1: скрутите пять карт, затем положите любое количество скрученных таким образом карт существ в вашу руку.\\n−1: создайте одну фишку существа 4/4 зеленый Носорог Воин.\', \'type\': \'Легендарный Planeswalker — Вивьен\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558618&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7e33f1f0-1642-4253-9e34-09d4efdc430c\', \'multiverseId\': 558618}, \'multiverseid\': 558618}, {\'name\': \'寻猎薇薇安\', \'text\': \'+2：你可以牺牲一个生物。若你如此作，则从你牌库中搜寻一张生物牌，且其法术力值须等同于所牺牲之生物的法术力值加1，将之放进战场，然后洗牌。\\n+1：磨五张牌，然后将任意数量以此法磨掉的生物牌置于你手上。\\n−1：派出一个4/4绿色犀牛／战士衍生生物。\', \'type\': \'传奇鹏洛客 ～薇薇安\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558627&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'aa67fb84-2a9a-4aeb-ab95-9d6dc8115e55\', \'multiverseId\': 558627}, \'multiverseid\': 558627}, {\'name\': \'尋獵薇薇安\', \'text\': \'+2：你可以犧牲一個生物。若你如此作，則從你牌庫中搜尋一張生物牌，且其魔法力值須等同於所犧牲之生物的魔法力值加1，將之放進戰場，然後洗牌。\\n+1：磨五張牌，然後將任意數量以此法磨掉的生物牌置於你手上。\\n−1：派出一個4/4綠色犀牛／戰士衍生生物。\', \'type\': \'傳奇鵬洛客 ～薇薇安\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558636&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5b21cee7-cb1e-47c6-8c0f-81fa13ca642f\', \'multiverseId\': 558636}, \'multiverseid\': 558636}]', '[{\'name\': \'Vorarbeiterin\', \'text\': \'Eile\\nDie Vorarbeiterin hat Unzerstörbarkeit, solange sie in diesem Zug ins Spiel gekommen ist.\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': \'Die Umnieter sind genauso gut darin, Gebäude zu errichten, wie darin, sie dem Erdboden gleichzumachen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555642&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'44b5ea9d-3666-4d87-b442-3f88f3cfdff2\', \'multiverseId\': 555642}, \'multiverseid\': 555642}, {\'name\': \'Capitana de la brigada\', \'text\': \'Prisa.\\nLa Capitana de la brigada tiene la habilidad de indestructible mientras haya entrado al campo de batalla este turno.\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': \'A los Remachadores se les da tan bien levantar edificios como derribarlos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=555903&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a5cb9f9c-95c4-4502-ae98-76ee88c3d0f2\', \'multiverseId\': 555903}, \'multiverseid\': 555903}, {\'name\': "Capitaine d\'équipe", \'text\': "Célérité\\nLa Capitaine d\'équipe a l\'indestructible pendant le tour où elle est arrivée sur le champ de bataille.", \'type\': \'Créature : humain et guerrier\', \'flavor\': \'Les Riveteurs sont aussi doués pour construire des édifices que pour les raser.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556164&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bde380e4-1b67-4562-be77-5e3fa215a147\', \'multiverseId\': 556164}, \'multiverseid\': 556164}, {\'name\': \'Capitana dei Manovali\', \'text\': \'Rapidità\\nLa Capitana dei Manovali ha indistruttibile se è entrata nel campo di battaglia in questo turno.\', \'type\': \'Creatura — Guerriero Umano\', \'flavor\': \'I Rivettatori sono bravi a costruire edifici tanto quanto a raderli al suolo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556425&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'65ab9eed-3d08-49b4-bf67-d221d4a01d19\', \'multiverseId\': 556425}, \'multiverseid\': 556425}, {\'name\': \'作業員の上長\', \'text\': \'速攻\\nこのターンにこれが戦場に出たのであるかぎり、作業員の上長は破壊不能を持つ。\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': \'土建組一家は建物の建設と同様にその破壊にも長けている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556686&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9887667f-7e17-487f-8448-713d77dc266f\', \'multiverseId\': 556686}, \'multiverseid\': 556686}, {\'name\': \'단원 대장\', \'text\': \'신속\\n단원 대장은 이 턴에 전장에 들어온 한 무적을 가진다.\', \'type\': \'생물 — 인간 전사\', \'flavor\': \'리베티어즈는 건물을 세워 올리는 것만큼이나 그것들을 무너뜨리는 데에도 일가견이 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=556947&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4f619d9c-fab4-49b4-b4a8-ec8572e49a97\', \'multiverseId\': 556947}, \'multiverseid\': 556947}, {\'name\': \'Capitã da Equipe\', \'text\': \'Ímpeto\\nCapitã da Equipe tem indestrutível contanto que tenha entrado no campo de batalha neste turno.\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': \'Os Rebiteiros são tão bons construtores quanto demolidores.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557208&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d75eb675-b840-4945-9db0-0be785900607\', \'multiverseId\': 557208}, \'multiverseid\': 557208}, {\'name\': \'Капитанша Бригады\', \'text\': \'Ускорение\\nКапитанша Бригады имеет Неразрушимость при условии, что она вышла на поле битвы в этом ходу.\', \'type\': \'Существо — Человек Воин\', \'flavor\': \'Возводить здания Клепальщики умеют ничуть не хуже, чем сносить их.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557469&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'90cd0eca-4f35-4828-8337-c6f970ec35f8\', \'multiverseId\': 557469}, \'multiverseid\': 557469}, {\'name\': \'工组队长\', \'text\': \'敏捷\\n只要工组队长是于本回合进战场，它便具有不灭异能。\', \'type\': \'生物 ～人类／战士\', \'flavor\': \'勤工联建楼的能力有多强，他们毁楼的本事就有多大。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557730&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ce2c492c-a79c-42ac-8e08-68e041983a45\', \'multiverseId\': 557730}, \'multiverseid\': 557730}, {\'name\': \'工組隊長\', \'text\': \'敏捷\\n只要工組隊長是於本回合進戰場，它便具有不滅異能。\', \'type\': \'生物 ～人類／戰士\', \'flavor\': \'勤工聯建樓的能力有多強，他們毀樓的本事就有多大。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=557991&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'06b97509-ff6d-475c-8883-7d39917e0a88\', \'multiverseId\': 557991}, \'multiverseid\': 557991}]', '[{\'name\': \'Vorarbeiterin\', \'text\': \'Eile\\nDie Vorarbeiterin hat Unzerstörbarkeit, solange sie in diesem Zug ins Spiel gekommen ist.\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558746&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d863d647-d1d5-4e9f-858e-ce779324624c\', \'multiverseId\': 558746}, \'multiverseid\': 558746}, {\'name\': \'Capitana de la brigada\', \'text\': \'Prisa.\\nLa Capitana de la brigada tiene la habilidad de indestructible mientras haya entrado al campo de batalla este turno.\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558791&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'76f628a6-2d33-4371-af62-a73fbfa7b256\', \'multiverseId\': 558791}, \'multiverseid\': 558791}, {\'name\': "Capitaine d\'équipe", \'text\': "Célérité\\nLa Capitaine d\'équipe a l\'indestructible pendant le tour où elle est arrivée sur le champ de bataille.", \'type\': \'Créature : humain et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=558836&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'edbea5ba-6c36-4e39-bd22-d74859fa4edc\', \'multiverseId\': 558836}, \'multiverseid\': 