rulings: ["[{'date': '2004-10-04', 'text': 'Due to errata, you no longer shuffle your library.'}, {'date': '2004-10-04', 'text': 'This is not a draw.'}]", "[{'date': '2013-04-15', 'text': 'An ability that triggers when something “attacks and isn’t blocked” triggers in the declare blockers step after blockers are declared if (1) that creature is attacking and (2) no creatures are declared to block it. It will trigger even if that creature was put onto the battlefield attacking rather than having been declared as an attacker in the declare attackers step.'}]", '[{\'date\': \'2021-06-18\', \'text\': "Returning the Forest you control to its owner\'s hand is the cost to activate the ability. Once you activate the ability, no one can try to do anything to the Forest to stop you from activating the ability."}, {\'date\': \'2021-06-18\', \'text\': "You can target any creature with Quirion Ranger\'s ability, not just a tapped creature."}, {\'date\': \'2021-06-18\', \'text\': "You may return any land you control with the subtype Forest. It doesn\'t have to be one named Forest."}]', "[{'date': '2022-12-08', 'text': 'Use the power of the creature from when it was last on the battlefield to determine how much life is gained.'}]"]
