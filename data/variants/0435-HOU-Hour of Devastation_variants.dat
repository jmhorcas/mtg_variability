subtypes: ['Angel', 'Archer', 'Aura', 'Beast', 'Bird', 'Bolas', 'Camel', 'Cat', 'Chimera', 'Cleric', 'Crocodile', 'Curse', 'Demon', 'Desert', 'Drake', 'Druid', 'Elemental', 'Equipment', 'Forest', 'God', 'Golem', 'Hellion', 'Hippo', 'Horror', 'Horse', 'Human', 'Hydra', 'Insect', 'Island', 'Jackal', 'Lizard', 'Manticore', 'Minotaur', 'Mountain', 'Naga', 'Nissa', 'Plains', 'Rat', 'Samut', 'Serpent', 'Snake', 'Sphinx', 'Spider', 'Swamp', 'Wall', 'Warrior', 'Wizard', 'Wurm', 'Zombie']
