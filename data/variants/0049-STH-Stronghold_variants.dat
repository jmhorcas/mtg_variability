a del imitador', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '49a5ce37-87c3-425e-8341-9c64b01e8c4e'}, 'multiverseid': None}, {'name': 'Masque mimétique', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'ac705a8e-e638-42cf-b07f-fd8e27f2cc9e'}, 'multiverseid': None}, {'name': 'Maschera del Polimorfo', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '59cbd9dd-d0e6-456f-aa4c-4b69537ef166'}, 'multiverseid': None}, {'name': '擬態の仮面', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '99e3729c-7d4d-4dd9-bc89-02f3ab94b62c'}, 'multiverseid': None}, {'name': 'Máscara do Mímico', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b338435f-0b8f-47f0-a7fd-516c408f968f'}, 'multiverseid': None}]", '[{\'name\': \'Mauer der Lebenskraft\', \'text\': \'Du erhältst für jeden Kampfschadenspunkt, der der Mauer der Lebenskraft zugefügt wird, 1 Lebenspunkt dazu.\', \'type\': \'Beschwörung einer Mauer\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ce85a200-8156-4b0f-ad24-4edf53c5b465\'}, \'multiverseid\': None}, {\'name\': \'Muro de esencia\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0c1a6cd7-9759-4865-b83f-6a303a4a797e\'}, \'multiverseid\': None}, {\'name\': "Mur d\'essence", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'eabe5951-c3f1-4000-a039-918aee4490c2\'}, \'multiverseid\': None}, {\'name\': \'Muro di Essenza\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b11f0e0c-7a8d-43ff-8762-14f05433311f\'}, \'multiverseid\': None}, {\'name\': \'精油の壁\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'abecf15b-e45c-48e0-b903-afcf8c35520b\'}, \'multiverseid\': None}, {\'name\': \'Barreira de Essência\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a0237d65-20fc