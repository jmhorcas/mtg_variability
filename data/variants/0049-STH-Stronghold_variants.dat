}, 'multiverseid': None}, {'name': 'Nómadas en-Kor', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '40d3aff2-c864-478c-beea-542c43c8c2aa'}, 'multiverseid': None}, {'name': 'Nomades en-Kor', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '27c1b33f-1ae4-4f0f-b9fc-f9c241c46361'}, 'multiverseid': None}, {'name': 'Nomadi en-Kor', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '20fabb72-7b08-4330-a4a3-0ccaf9cc53d3'}, 'multiverseid': None}, {'name': 'コーの遊牧民', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '17055780-65d6-4c90-aa53-c292da4e1638'}, 'multiverseid': None}, {'name': 'Nômades en-Kor', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '484ecee4-75a9-4e8c-be13-14c9f7ea4510'}, 'multiverseid': None}]", "[{'name': 'Provokation', 'text': 'Enttappe eine Kreatur, die Du nicht kontrollierst. Diese Kreatur blockt in diesem Zug, wenn möglich.\\nZiehe eine Karte.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'd8c27a44-95ba-45b7-9541-1f9e1acfd019'}, 'multiverseid': None}, {'name': 'Provocar', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '36c454f8-cbe4-4e10-93e9-e6b8d81f158e'}, 'multiverseid': None}, {'name': 'Provocation', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'aba01449-62d1-4fab-a994-5bc90e6ba955'}, 'multiverseid': None}, {'name': 'Provocazione', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '4fab0cc5-4306-490a-afe6-62b1a3a5ce0f'}, 'multiverseid': None}, {'name': '誘発', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'eed5ab8f-1f40-4bcf-af69-2794440c986b'}, 'multiverseid': None}, {'name': 'Provocar', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'dcd471ed-e0c4-4aaf-82f3-d502cd306dc1'}, 'multiverseid': None}]", "[{'name': 'Pulsierender Stein', 'text': 'Die Kosten jeder Kreaturenfähigkeit, die Aktivierungskosten erfordert, wird um 1 reduziert. Dies kann die Kosten einer Fähigkeit an beliebigen Mana nicht unter 1 reduzieren.', 'type': 'Artefakt', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '366f1197-6316-4306-af56-ba2aeac3e3c1'}, 'multiverseid': None}, {'name': 'Piedra de la voluntad', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '457c02c4-2056-45ca-ae73-829089941b20'}, 'multiverseid': None}, {'name': 'Pierrecoeur', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '218173e6-6a09-45a4-b46b-de259d5a7aa1'}, 'multiverseid': None}, {'name': 'Cuorpietra', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '2f7d283d-f694-43f6-a9ca-539d284f5029'}, 'multiverseid': None}, {'name': 'ハートストーン', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '67a59c8a-eea2-4edf-9968-69d06b81f629'}, 'multiverseid': None}, {'name': 'Pedra Coracão', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '330ab637-e961-4431-9b2b-dc7a4d14e316'}, 'multiverseid': None}]", "[{'name': 'Qual', 'text': 'Die verzauberte Kreatur erhält -3/-0.', 'type': 'Verzaubere Kreatur', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '57076f4a-7a67-4f1c-beee-47134fdeeda5'}, 'multiverseid': None}, {'name': 'Tormento', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'af7a40a9-565d-4e6e-bcc6-8cdd0a12010e'}, 'multiverseid': None}, {'name': 'Tourment', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '86d29312-a82d-4119-add5-03d62a3cdc59'}, 'multiverseid': None}, {'name': 'Tormento', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'a1e3d635-4c58-46ea-8f24-8f30de616630'}, 'multiverseid': None}, {'name': '責め苦', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'd68bce96-32d7-448a-9896-77f8382c8571'}, 'multiverseid': None}, {'name': 'Tormento', 'flavor': None, 'language': 'Po