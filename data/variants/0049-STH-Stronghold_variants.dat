g', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'fe81a56e-e8ac-49ad-bb24-6ffda6030290'}, 'multiverseid': None}, {'name': 'モグの横行', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'eb75fb86-79cb-42eb-a5d2-6bb41a0cb4b4'}, 'multiverseid': None}, {'name': 'Infestacão de Moggs', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3c6bbafb-7f50-4428-bce4-4ddcd13360f7'}, 'multiverseid': None}]", "[{'name': 'Mogg-Versager', 'text': 'Die Mogg-Versager können in einem Zug nicht angreifen oder blocken, wenn nicht mindestens eine andere Kreatur, die Du kontrollierst, ebenfalls angreift oder blockt.', 'type': 'Beschwörung von Goblins', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '8d3876a8-1b75-4230-9276-ba8a9c94f94d'}, 'multiverseid': None}, {'name': 'Lacayos mogg', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '0533ae6d-3802-4636-a259-1761fb1b20d3'}, 'multiverseid': None}, {'name': 'Moggs bas-de-plafond', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'cf91ec8b-ab95-4245-9457-cd0e5b472416'}, 'multiverseid': None}, {'name': 'Mogg Tirapiedi', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'a3da2eb8-555d-478a-9f26-25ce67a84e53'}, 'multiverseid': None}, {'name': 'モグの下働き', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'fecc520b-0aaf-4b16-9fc4-5b2bc16cb9d2'}, 'multiverseid': None}, {'name': 'Moggs Confusos', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'cf782189-3b02-46f7-bc1a-918ac3520cde'}, 'multiverseid': None}]", "[{'name': 'Mure', 'text': 'Mauern können angreifen, als ob sie keine Mauern wären.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '76dfc2d0-e6b5-4ef6-a255-673689aacc00'}, 'multiverseid': None}, {'name': 'Piedras animadas', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '82acd18d-6