one}]", '[{\'name\': \'Armbrust-Hinterhalt\', \'text\': \'Alle Kreaturen, die Du kontrollierst, können bis zum Ende des Zuges fliegende Kreaturen blocken.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9ff8b6ee-3d10-4f8b-adb5-182ef1afe8dc\'}, \'multiverseid\': None}, {\'name\': \'Emboscada con ballestas\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'35a64f0f-00de-48dc-b75f-997321c88350\'}, \'multiverseid\': None}, {\'name\': "Embuscade d\'arbalétriers", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dc15142e-97ff-432f-9055-d35258cd191f\'}, \'multiverseid\': None}, {\'name\': \'Balestre in Agguato\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8f6f9b31-2cd3-4ec7-9211-48558fc2760d\'}, \'multiverseid\': None}, {\'name\': \'弩弓の待ち伏せ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f9e38f7f-1d40-4dd1-a296-30d935e47c79\'}, \'multiverseid\': None}, {\'name\': \'Emboscada com Balista\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'97465fb9-8714-4c64-8cb4-46a5de0d0e35\'}, \'multiverseid\': None}]', "[{'name': 'Aufblühen', 'text': 'Immer wenn ein Gegner ein Land ausspielt, darfst Du eine Landkarte aus Deiner Hand direkt ins Spiel bringen.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '7deb6e45-ecf2-47f3-a2b7-8eb14f3f24ce'}, 'multiverseid': None}, {'name': 'Germinación', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '5133fc14-bdb6-4406-ab40-448b2685e709'}, 'multiverseid': None}, {'name': 'Bourgeonnement', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '5389044d-9faf-4088-9051-495e65fb2bd3'}, 'multiverseid': None}, {'name': 'Germogliare', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'c46b5bb0-3e65-4f52-ae62-1e40cb