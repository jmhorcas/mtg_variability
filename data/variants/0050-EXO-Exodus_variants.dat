uage': 'Italian', 'identifiers': {'scryfallId': 'bf323bd2-16ce-49d7-a375-ec6ba1a9b108'}, 'multiverseid': None}, {'name': '呪文ショック', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '4ffd2344-381d-48a7-80b8-58e7768bef91'}, 'multiverseid': None}, {'name': 'Choque de Mágica', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'bf3bbe1b-9c40-4028-ac31-7eed6fd8467c'}, 'multiverseid': None}]", "[{'name': 'Zerstörerische Paviane', 'text': 'Wenn die Zerstörerischen Paviane ins Spiel kommen, zerstöre ein Nicht-Standardland Deiner Wahl.', 'type': 'Beschwörung von Menschenaffen', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '608ab589-ea19-4c07-8a15-8fd1b1177160'}, 'multiverseid': None}, {'name': 'Mandriles voraces', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '4ca148da-adb7-448c-9b38-bfccd097f59a'}, 'multiverseid': None}, {'name': 'Babouins voraces', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'ea4ad266-807a-4878-af94-3dce2f799337'}, 'multiverseid': None}, {'name': 'Babbuini Famelici', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'abf07fbb-2dba-4c7a-820f-e1be707cfe16'}, 'multiverseid': None}, {'name': '貪欲なるヒヒ', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '3ff28d91-6b30-4264-94bc-cd9b095a33c0'}, 'multiverseid': None}, {'name': 'Babuínos Vorazes', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'eae02da8-a332-400c-a134-096027e33f37'}, 'multiverseid': None}]", "[{'name': 'Zwergtroll', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '5c691029-7cfa-4009-b05e-f0939eb863cb'}, 'multiverseid': None}, {'name': 'Troll pigmeo', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'f62a1174-bdd2-4dd2-966d-9ea8bf3632fa'}, 'multiverseid': None}, {'name': 'Troll pygmée', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '0a954045-d516-410