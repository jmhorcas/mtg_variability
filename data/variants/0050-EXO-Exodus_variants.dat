, 'multiverseid': None}, {'name': '回収', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'ff736f82-3e54-46c9-aa6d-7686c03fe1de'}, 'multiverseid': None}, {'name': 'Restituir', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ee465e24-b03f-4c5b-ba24-d7ffe4f92085'}, 'multiverseid': None}]", "[{'name': 'Neugier', 'text': 'Wenn die verzauberte Kreatur einem Gegner Schaden zufügt, kannst Du eine Karte ziehen.', 'type': 'Verzaubere Kreatur', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'e43eb630-da7e-4425-9842-4d314e47602a'}, 'multiverseid': None}, {'name': 'Curiosidad', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '90f3339b-ed9f-466a-b719-046b659b8802'}, 'multiverseid': None}, {'name': 'Curiosité', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '5ae94e8b-ca24-4820-9cad-d0ef941fed51'}, 'multiverseid': None}, {'name': 'Curiosità', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '8c31806b-0cdc-4e53-9208-b0f22616d8e5'}, 'multiverseid': None}, {'name': '好奇心', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'fc857255-b52a-4168-9ff1-25bbcde2850c'}, 'multiverseid': None}, {'name': 'Curiosidade', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7bfc607f-40a0-410e-916b-f7abe2d74643'}, 'multiverseid': None}]", '[{\'name\': \'Nullbrosche\', \'text\': \'2, {T}, wirf Deine Karten auf der Hand ab: Neutralisiere einen Nichtkreaturenzauber Deiner Wahl. Spiele diese Fähigkeit wie einen Unterbrechungszauber.\', \'type\': \'Artefakt\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4e9640c8-e427-425b-addd-697372bd8730\'}, \'multiverseid\': None}, {\'name\': \'Broche de nulificación\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5eb32f67-6bb5-4c9e-9434-ea964d1e93e6\'}, \'multiverseid\': None}, {\'name\': \'Broche de cassation\', 