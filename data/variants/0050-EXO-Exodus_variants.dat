 None}, {'name': 'Assassin Mogg', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '83de92c8-9a06-4010-b64e-d147eee6e044'}, 'multiverseid': None}, {'name': 'Assassino Mogg', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '225c7e48-3bf3-43a0-837b-258803ed0f2a'}, 'multiverseid': None}, {'name': 'モグの暗殺者', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '3a453105-6295-495d-aedd-92ea2d39c271'}, 'multiverseid': None}, {'name': 'Mogg Assassino', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2dd9d4cb-8a9e-4afc-928f-67f656ddafc5'}, 'multiverseid': None}]", "[{'name': 'Monsterhund', 'text': 'Der Monsterhund kann nur angreifen, wenn Du mehr Länder als der verteidigende Spieler kontrollierst.\\nDer Monsterhund kann nur blocken, wenn Du mehr Länder als der angreifende Spieler kontrollierst.', 'type': 'Beschwörung eines Hundes', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'c0791394-dbc6-46e6-8c50-c20ecb808f65'}, 'multiverseid': None}, {'name': 'Sabueso monstruoso', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'da3a8aa8-abc7-4b1b-985e-c3f5021b018f'}, 'multiverseid': None}, {'name': 'Chien monstrueux', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'd391393c-a278-4894-8e10-bb18dfa34e19'}, 'multiverseid': None}, {'name': 'Segugio Mostruoso', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '58c50bb7-103b-4508-9d81-6dda551b239d'}, 'multiverseid': None}, {'name': '巨怪なる猟犬', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'bfcae657-136c-468b-a63a-250ba3c96634'}, 'multiverseid': None}, {'name': 'Sabujo Monstruoso', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'db32cedd-ec41-4d71-9b34-9e59ac0782b2'}, 'multiverseid': None}]", "[{'name': 'Mordender Dauthi', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '328a7f82-0ea0-417a-acaf-