type: ['Artifact', 'Artifact Creature — Food Golem', 'Artifact Creature — Juggernaut', 'Artifact — Equipment', 'Creature — Angel', 'Creature — Crab', 'Creature — Crocodile', 'Creature — Dog', 'Creature — Dragon', 'Creature — Dragon Illusion', 'Creature — Drake', 'Creature — Elemental', 'Creature — Faerie', 'Creature — Faerie Dragon', 'Creature — Human Cleric', 'Creature — Human Knight', 'Creature — Human Nomad', 'Creature — Human Shaman', 'Creature — Minotaur', 'Creature — Minotaur Monger', 'Creature — Phoenix', 'Creature — Phyrexian Horror', 'Creature — Phyrexian Minion', 'Creature — Spirit Warrior', 'Creature — Wurm', 'Enchantment — Aura', 'Instant', 'Instant — Adventure', 'Land', 'Legendary Creature — Elf Warrior', 'Legendary Creature — Goblin Samurai', 'Legendary Creature — Human Samurai', 'Legendary Creature — Human Warlock', 'Legendary Creature — Phyrexian Vampire Noble', 'Legendary Enchantment Creature — Demigod', 'Sorcery']
