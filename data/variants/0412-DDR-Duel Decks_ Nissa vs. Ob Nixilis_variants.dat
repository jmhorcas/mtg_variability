type: ['Basic Land — Forest', 'Basic Land — Swamp', 'Creature — Cat', 'Creature — Demon', 'Creature — Elemental', 'Creature — Elf Archer', 'Creature — Elf Druid Warrior', 'Creature — Elf Scout', 'Creature — Elf Shaman', 'Creature — Elf Warrior', 'Creature — Horror', 'Creature — Human Cleric', 'Creature — Human Druid', 'Creature — Human Shaman', 'Creature — Hydra', 'Creature — Imp', 'Creature — Leech', 'Creature — Lizard', 'Creature — Phyrexian Horror', 'Creature — Scorpion', 'Creature — Treefolk Warrior', 'Creature — Vampire', 'Enchantment', 'Enchantment — Aura', 'Instant', 'Land', 'Land — Swamp', 'Legendary Planeswalker — Nissa', 'Legendary Planeswalker — Nixilis', 'Sorcery']
