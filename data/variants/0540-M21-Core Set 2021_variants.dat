shx?multiverseid=488538&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '64029b23-eef7-4f12-8938-a7c518450e36', 'multiverseId': 488538}, 'multiverseid': 488538}, {'name': '들', 'type': '기본 대지 — 들', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488553&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '29f8ccc3-61d3-43d9-ae20-70d479c71373', 'multiverseId': 488553}, 'multiverseid': 488553}, {'name': 'Planície', 'type': 'Terreno Básico — Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488568&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '206a9765-7d9b-4ece-87d6-cbc22149efc6', 'multiverseId': 488568}, 'multiverseid': 488568}, {'name': 'Равнина', 'type': 'Базовая Земля — Равнина', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488583&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '343e8a71-3a59-43bf-a4b8-f40f58c56f2f', 'multiverseId': 488583}, 'multiverseid': 488583}, {'name': '平原', 'type': '基本地 ～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488598&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '96cce9e1-b677-4d23-9a29-0439096459eb', 'multiverseId': 488598}, 'multiverseid': 488598}, {'name': '平原', 'type': '基本地 ～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488613&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '0503fe38-436a-4861-ae08-09abc585e9c7', 'multiverseId': 488613}, 'multiverseid': 488613}]", "[{'name': 'Ebene', 'type': 'Standardland — Ebene', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488851&type=card', 'language': 'German', 'identifiers': {'scryfallId': '6fb62c8e-8177-44ed-9d8f-8ffa6cf0fe6d', 'multiverseId': 488851}, 'multiverseid': 488851}, {'name': 'Llanura', 'type': 'Tierra básica — Llanura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488856&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '552580af-ef21-4b99-b214-aa4efa628cdb', 'multiverseId': 488856}, 'multiverseid': 488856}, {'name': 'Plaine', 'type': 'Terrain de base : plaine', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488861&type=card', 'language': 'French', 'identifiers': {'scryfallId': '42272127-fe92-49b5-828f-776d7b3c3f9f', 'multiverseId': 488861}, 'multiverseid': 488861}, {'name': 'Pianura', 'type': 'Terra Base — Pianura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488866&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '2b3accd5-8c63-4eb7-b819-087bf0fef4cd', 'multiverseId': 488866}, 'multiverseid': 488866}, {'name': '平地', 'type': '基本土地 — 平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488871&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '2d14923e-7b06-4b3c-aae9-a175490999e2', 'multiverseId': 488871}, 'multiverseid': 488871}, {'name': '들', 'type': '기본 대지 — 들', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488876&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'a9aacdc0-d8de-4c85-9e9f-8c7198755a44', 'multiverseId': 488876}, 'multiverseid': 488876}, {'name': 'Planície', 'type': 'Terreno Básico — Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488881&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3033891c-315a-4221-8b4f-bf15a6591107', 'multiverseId': 488881}, 'multiverseid': 488881}, {'name': 'Равнина', 'type': 'Базовая Земля — Равнина', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488886&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'd37c881a-2067-43e8-8779-2fa61e91c5f5', 'multiverseId': 488886}, 'multiverseid': 488886}, {'name': '平原', 'type': '基本地 ～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488891&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '24b8072a-18f7-48ef-b29e-4a33f9569efc', 'multiverseId': 488891}, 'multiverseid': 488891}, {'name': '平原', 'type': '基本地 ～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488896&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'dbdd83a4-8ec8-4628-90cf-275e1b6bd175', 'multiverseId': 488896}, 'multiverseid': 488896}]", '[{\'name\': \'Eingesperrter Zombie\', \'text\': \'{1}{B}, {T}: Jeder Gegner verliert 2 Lebenspunkte. Aktiviere diese Fähigkeit nur, falls in diesem Zug eine Kreatur gestorben ist.\', \'type\': \'Kreatur — Zombie\', \'flavor\': \'„Sechsmal lebenslang" erhält als Strafe eine völlig neue Bedeutung, wenn Nekromagie im Spiel ist.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485673&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f633466e-6f95-4ac0-abe2-021f8a492bf1\', \'multiverseId\': 485673}, \'multiverseid\': 485673}, {\'name\': \'Zombie encarcelado\', \'text\': \'{1}{B}, {T}: Cada oponente pierde 2 vidas. Activa esta habilidad solo si una criatura murió este turno.\', \'type\': \'Criatura — Zombie\', \'flavor\': \'"Seis cadenas perpetuas consecutivas" cobra un nuevo significado cuando hay nigromancia de por medio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485932&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f154d509-db1d-42f2-81bc-121fa3c80fce\', \'multiverseId\': 485932}, \'multiverseid\': 485932}, {\'name\': \'Zombie emprisonné\', \'text\': "{1}{B}, {T} : Chaque adversaire perd 2 points de vie. N\'activez cette capacité que si une créature est morte ce tour-ci.", \'type\': \'Créature : zombie\', \'flavor\': "« Six peines à perpétuité consécutives » prend un tout autre sens quand la nécromancie fait partie de l\'équation.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486191&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'90a8b396-dc56-4a90-a56d-e809c03cadfc\', \'multiverseId\': 486191}, \'multiverseid\': 486191}, {\'name\': \'Zombie Prigioniero\', \'text\': \'{1}{B}, {T}: Ogni avversario perde 2 punti vita. Attiva questa abilità solo se è morta una creatura in questo turno.\', \'type\': \'Creatura — Zombie\', \'flavor\': \'"Sei ergastoli consecutivi" assumono tutto un altro significato quando c\\\'è di mezzo la necromanzia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486450&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b7334736-54db-4ae2-b671-c0aa6de1d8b8\', \'multiverseId\': 486450}, \'multiverseid\': 486450}, {\'name\': \'檻の中のゾンビ\', \'text\': \'{1}{B}, {T}：各対戦相手はそれぞれ２点のライフを失う。この能力は、このターンにクリーチャーが死亡していたときにのみ起動できる。\', \'type\': \'クリーチャー — ゾンビ\', \'flavor\': \'「終身刑六回分の罪」は、屍術が絡むと意味が変わってくる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486709&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7a730ff9-806b-4a16-8137-26960959640c\', \'multiverseId\': 486709}, \'multiverseid\': 486709}, {\'name\': \'갇힌 좀비\', \'text\': \'{1}{B}, {T}: 각 상대는 생명 2점을 잃는다. 이번 턴에 생물이 죽었을 경우에만 이 능력을 활성화활 수 있다.\', \'type\': \'생물 — 좀비\', \'flavor\': \'"6연속 종신형"은 사령술이 연관되어 있으면 완전히 새로운 의미가 된다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486968&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'29d2a852-17f6-45ae-914e-7b23b7698a23\', \'multiverseId\': 486968}, \'multiverseid\': 486968}, {\'name\': \'Zumbi Encarcerado\', \'text\': \'{1}{B}, {T}: Cada oponente perde 2 pontos de vida. Ative esta habilidade somente se uma criatura tiver morrido neste turno.\', \'type\': \'Criatura — Zumbi\', \'flavor\': \'"Seis penas consecutivas de prisão perpétua" ganha um novo significado quando tem necromancia envolvida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487227&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bad99755-bf47-42ba-ba7f-af283028e7e4\', \'multiverseId\': 487227}, \'multiverseid\': 487227}, {\'name\': \'Заключенный Мертвяк\', \'text\': \'{1}{B}, {T}: каждый оппонент теряет 2 жизни. Активируйте эту способность, только если в этом ходу умерло существо.\', \'type\': \'Существо — Зомби\', \'flavor\': \'«Шесть пожизненных приговоров подряд» приобретает новый смысл, когда в дело вступает некромантия.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487486&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'317e73be-bb45-4d12-8b80-b66372bf3499\', \'multiverseId\': 487486}, \'multiverseid\': 487486}, {\'name\': \'困槛灵俑\', \'text\': \'{1}{B}，{T}：每位对手各失去2点生命。只能于有生物死去的回合中起动此异能。\', \'type\': \'生物 ～灵俑\', \'flavor\': \'当能够动用死灵术时，「六个连续终身监禁」就有了新的意义。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487745&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'69319c4b-6d6a-498e-8c56-b5ced15424c3\', \'multiverseId\': 487745}, \'multiverseid\': 487745}, {\'name\': \'困檻殭屍\', \'text\': \'{1}{B}，{T}：每位對手各失去2點生命。只能於有生物死去的回合中起動此異能。\', \'type\': \'生物 ～殭屍\', \'flavor\': \'當能夠動用死靈術時，「六個連續終身監禁」就有了新的意義。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488004&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f15c372e-1c70-42cd-ac0e-1ec8fb54c2c7\', \'multiverseId\': 488004}, \'multiverseid\': 488004}]', '[{\'name\': \'Einhaltgebietende Priesterin\', \'text\': \'Aufblitzen\\nFalls eine Nichtspielsteinkreatur ins Spiel kommen würde und sie nicht gewirkt wurde, schicke sie stattdessen ins Exil.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': \'Mancher Schutz bedarf einer gewissen Rafinesse.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485595&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1ca33753-736f-4bf0-a7c9-3f2154a1d5b9\', \'multiverseId\': 485595}, \'multiverseid\': 485595}, {\'name\': \'Sacerdotisa de la mesura\', \'text\': \'Destello.\\nSi una criatura que no sea ficha fuera a entrar al campo de batalla y no fue lanzada, en vez de eso, exíliala.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': \'Cierta clase de protección requiere algo de sutileza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485854&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cfa481d6-9071-496f-92d6-b0118ebabf5e\', \'multiverseId\': 485854}, \'multiverseid\': 485854}, {\'name\': \'Prêtresse du confinement\', \'text\': "Flash\\nSi une créature non-jeton devait arriver sur le champ de bataille et qu\'elle n\'a pas été lancée, exilez-la à la place.", \'type\': \'Créature : humain et clerc\', \'flavor\': \'Certaines protections nécessitent un brin de finesse.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486113&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b35784db-75b7-4931-ae1d-639fd92b5dd3\', \'multiverseId\': 486113}, \'multiverseid\': 486113}, {\'name\': \'Sacerdotessa del Contenimento\', \'text\': \'Lampo\\nSe una creatura non pedina sta per entrare nel campo di battaglia e non è stata lanciata, invece esiliala.\', \'type\': \'Creatura — Chierico Umano\', \'flavor\': \'Alcune protezioni richiedono una certa dose di tatto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486372&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'20dc76d7-e147-4d76-b315-afc81a955c02\', \'multiverseId\': 486372}, \'multiverseid\': 486372}, {\'name\': \'封じ込める僧侶\', \'text\': \'瞬速\\nトークンでないクリーチャーが、それが唱えられることなく戦場に出るなら、代わりにそれを追放する。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': \'防御によっては、多少技巧が必要となることもあります。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486631&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ff5542e1-ad70-4329-b694-0ea199665b12\', \'multiverseId\': 486631}, \'multiverseid\': 486631}, {\'name\': \'봉쇄하는 사제\', \'text\': \'섬광\\n토큰이 아닌 생물이 발동되지 않고 전장에 들어오려 하면, 대신 그 생물을 추방한다.\', \'type\': \'생물 — 인간 성직자\', \'flavor\': \'보호 방법 중 일부에는 수완도 약간 있어야 한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486890&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'25552e2f-9834-41f1-b5ba-9aa44d5e8494\', \'multiverseId\': 486890}, \'multiverseid\': 486890}, {\'name\': \'Sacerdotisa do Confinamento\', \'text\': \'Lampejo\\nSe uma criatura que não seja ficha entraria no campo de batalha sem ser conjurada, em vez disso, exile-a.\', \'type\': \'Criatura — Humano Clérigo\', \'flavor\': \'Algumas proteções exigem certa sofisticação.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487149&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d5245e63-e7b6-4e51-9a0a-82a0910911d8\', \'multiverseId\': 487149}, \'multiverseid\': 487149}, {\'name\': \'Сдерживающая Священница\', \'text\': \'Миг\\nЕсли не являющееся фишкой существо должно выйти на поле битвы и оно не было разыграно как заклинание, изгоните его вместо этого.\', \'type\': \'Существо — Человек Священник\', \'flavor\': \'Иногда для защиты требуется тонкая работа.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487408&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'843e5321-76fa-40eb-814a-d6a04b3af004\', \'multiverseId\': 487408}, \'multiverseid\': 487408}, {\'name\': \'围护僧侣\', \'text\': \'闪现\\n如果某非衍生物的生物将进战场，且未有牌手施放之，则改为将它放逐。\', \'type\': \'生物 ～人类／僧侣\', \'flavor\': \'有些保护需要无微不至。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487667&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1e640806-a578-4dea-bd47-fb66519cbcb8\', \'multiverseId\': 487667}, \'multiverseid\': 487667}, {\'name\': \'圍護僧侶\', \'text\': \'閃現\\n如果某非衍生物的生物將進戰場，且未有玩家施放之，則改為將它放逐。\', \'type\': \'生物 ～人類／僧侶\', \'flavor\': \'有些保護需要無微不至。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487926&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'48e0f650-f9ce-44d4-a989-50a4ef348ef7\', \'multiverseId\': 487926}, \'multiverseid\': 487926}]', '[{\'name\': \'Einhaltgebietende Priesterin\', \'text\': \'Aufblitzen\\nFalls eine Nichtspielsteinkreatur ins Spiel kommen würde und sie nicht gewirkt wurde, schicke sie stattdessen ins Exil.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': \'Mancher Schutz bedarf einer gewissen Rafinesse.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488401&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a0ac293c-a327-4f44-a072-3e0be6793b5e\', \'multiverseId\': 488401}, \'multiverseid\': 488401}, {\'name\': \'Sacerdotisa de la mesura\', \'text\': \'Destello\\nSi una criatura que no sea ficha fuera a entrar al campo de batalla y no fue lanzada, en vez de eso, exíliala.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': \'Cierta clase de protección requiere algo de sutileza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488407&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b45b2bb9-160e-4e8c-bd69-f632289990e8\', \'multiverseId\': 488407}, \'multiverseid\': 488407}, {\'name\': \'Prêtresse du confinement\', \'text\': "Flash\\nSi une créature non-jeton devait arriver sur le champ de bataille et qu\'elle n\'a pas été lancée, exilez-la à la place.", \'type\': \'Créature : humain et clerc\', \'flavor\': \'Certaines protections nécessitent un brin de finesse.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488413&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'42066258-12b5-43e1-8eb4-c9736db23d89\', \'multiverseId\': 488413}, \'multiverseid\': 488413}, {\'name\': \'Sacerdotessa del Contenimento\', \'text\': \'Lampo\\nSe una creatura non pedina sta per entrare nel campo di battaglia e non è stata lanciata, invece esiliala.\', \'type\': \'Creatura — Chierico Umano\', \'flavor\': \'Alcune protezioni richiedono una certa dose di tatto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488419&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ddfdf23d-1e4e-4d32-a042-df697cb60a97\', \'multiverseId\': 488419}, \'multiverseid\': 488419}, {\'name\': \'封じ込める僧侶\', \'text\': \'瞬速\\nトークンでないクリーチャーが、それが唱えられることなく戦場に出るなら、代わりにそれを追放する。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': \'防御によっては、多少技巧が必要となることもあります。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488425&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b98faf35-20fb-4db0-af42-375bdccc45e0\', \'multiverseId\': 488425}, \'multiverseid\': 488425}, {\'name\': \'봉쇄하는 사제\', \'text\': \'섬광\\n토큰이 아닌 생물이 발동되지 않고 전장에 들어오려 하면, 대신 그 생물을 추방한다.\', \'type\': \'생물 — 인간 성직자\', \'flavor\': \'보호 방법 중 일부에는 수완도 약간 있어야 한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488431&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'872690e5-12e1-4cdd-9095-58d364e674f5\', \'multiverseId\': 488431}, \'multiverseid\': 488431}, {\'name\': \'Sacerdotisa do Confinamento\', \'text\': \'Lampejo\\nSe uma criatura que não seja ficha entraria no campo de batalha sem ser conjurada, em vez disso, exile-a.\', \'type\': \'Criatura — Humano Clérigo\', \'flavor\': \'Algumas proteções exigem certa sofisticação.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488437&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'01a392ad-37ea-4962-a649-aee4a47211f2\', \'multiverseId\': 488437}, \'multiverseid\': 488437}, {\'name\': \'Сдерживающая Священница\', \'text\': \'Миг\\nЕсли не являющееся фишкой существо должно выйти на поле битвы и оно не было разыграно как заклинание, изгоните его вместо этого.\', \'type\': \'Существо — Человек Священник\', \'flavor\': \'Иногда для защиты требуется тонкая работа.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488443&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7495d7d4-32a1-4a48-a5c0-6ab235f04c9f\', \'multiverseId\': 488443}, \'multiverseid\': 488443}, {\'name\': \'围护僧侣\', \'text\': \'闪现\\n如果某非衍生物的生物将进战场，且未有牌手施放之，则改为将它放逐。\', \'type\': \'生物 ～人类／僧侣\', \'flavor\': \'有些保护需要无微不至。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488449&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a0345ec3-63f6-4225-9b90-8ef6a6ba3f63\', \'multiverseId\': 488449}, \'multiverseid\': 488449}, {\'name\': \'圍護僧侶\', \'text\': \'閃現\\n如果某非衍生物的生物將進戰場，且未有玩家施放之，則改為將它放逐。\', \'type\': \'生物 ～人類／僧侶\', \'flavor\': \'有些保護需要無微不至。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488455&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7090eac7-024f-4316-a9ac-d0cae4485447\', \'multiverseId\': 488455}, \'multiverseid\': 488455}]', '[{\'name\': \'Eliminieren\', \'text\': \'Zerstöre eine Kreatur oder einen Planeswalker deiner Wahl mit umgewandelten Manakosten von 3 oder weniger.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Grausamkeit? Pah. Das ist eine Notwendigkeit."\\n—Kaervek\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485679&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ed033af0-6e67-49bc-942d-8a57e28dcd95\', \'multiverseId\': 485679}, \'multiverseid\': 485679}, {\'name\': \'Eliminar\', \'text\': \'Destruye la criatura o planeswalker objetivo con coste de maná convertido de 3 o menos.\', \'type\': \'Instantáneo\', \'flavor\': \'"¿Crueldad? No. Esto es necesidad".\\n—Kaervek\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485938&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2eae1bd5-cbf4-4dce-bb0c-50be0b86554d\', \'multiverseId\': 485938}, \'multiverseid\': 485938}, {\'name\': \'Éliminer\', \'text\': \'Détruisez une cible, créature ou planeswalker, dont le coût converti de mana est inférieur ou égal à 3.\', \'type\': \'Éphémère\', \'flavor\': "« Cruel ? Non. C\'est nécessaire. »\\n—Kærvek", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486197&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b698a387-1cf3-4a68-9aac-1ca675539f35\', \'multiverseId\': 486197}, \'multiverseid\': 486197}, {\'name\': \'Liquidare\', \'text\': \'Distruggi una creatura o un planeswalker bersaglio con costo di mana convertito pari o inferiore a 3.\', \'type\': \'Istantaneo\', \'flavor\': \'"Crudeltà? No. Questa è necessità."\\n—Kaervek\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486456&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8ab9a000-8d6c-4042-b40d-2b5ef426fbf2\', \'multiverseId\': 486456}, \'multiverseid\': 486456}, {\'name\': \'取り除き\', \'text\': \'点数で見たマナ・コストが３以下の、クリーチャー１体かプレインズウォーカー１体を対象とし、それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'「残虐だと？そうではない。必要なのだ。」\\n――ケアヴェク\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486715&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0388239e-cdfb-4828-a8cb-c68896291e69\', \'multiverseId\': 486715}, \'multiverseid\': 486715}, {\'name\': \'제거\', \'text\': \'전환마나비용이 3 이하인 생물 또는 플레인즈워커를 목표로 정한다. 그 목표를 파괴한다.\', \'type\': \'순간마법\', \'flavor\': \'"잔인함? 아니. 이건 필요함이야."\\n—케어벡\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486974&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'79e8dfdd-0dd6-43d3-84c5-5ccb3912891b\', \'multiverseId\': 486974}, \'multiverseid\': 486974}, {\'name\': \'Sumir\', \'text\': \'Destrua a criatura ou o planeswalker alvo com custo de mana convertido igual ou inferior a 3.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Crueldade? Não. Necessidade."\\n— Kaervek\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487233&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8ff9094e-8d4b-4cd0-b66c-4a7255f91610\', \'multiverseId\': 487233}, \'multiverseid\': 487233}, {\'name\': \'Изничтожить\', \'text\': "Уничтожьте целевое существо или planeswalker\'а с конвертированной мана-стоимостью не более 3.", \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Жестокость? Отнюдь. Просто необходимость».\\n— Кайервек\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487492&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a4a7ea1f-6f40-4efc-b58f-0b4274b9e396\', \'multiverseId\': 487492}, \'multiverseid\': 487492}, {\'name\': \'涤除\', \'text\': \'消灭目标生物或鹏洛客，且其总法术力费用须等于或小于3。\', \'type\': \'瞬间\', \'flavor\': \'「残忍？错。这是必然。」\\n～凯雷威克\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487751&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f12bc88e-dc9f-435f-bb40-561de88088a1\', \'multiverseId\': 487751}, \'multiverseid\': 487751}, {\'name\': \'滌除\', \'text\': \'消滅目標生物或鵬洛客，且其總魔法力費用須等於或小於3。\', \'type\': \'瞬間\', \'flavor\': \'「殘忍？錯。這是必然。」\\n～凱雷威克\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488010&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'44ecf98c-92ac-420d-b94b-6894869a5901\', \'multiverseId\': 488010}, \'multiverseid\': 488010}]', '[{\'name\': \'Engelhafter Aufstieg\', \'text\': \'Schicke eine Kreatur oder einen Planeswalker deiner Wahl ins Exil. Ihr bzw. sein Beherrscher erzeugt einen 4/4 weißen Engel-Kreaturenspielstein mit Flugfähigkeit.\', \'type\': \'Spontanzauber\', \'flavor\': \'In ihrem Bataillon war sie als der Engel von Archental bekannt. Bis jetzt war das nur eine Metapher.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485585&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5485011b-4d75-4368-8ed4-50cc70b9b2f9\', \'multiverseId\': 485585}, \'multiverseid\': 485585}, {\'name\': \'Ascensión angelical\', \'text\': \'Exilia la criatura o planeswalker objetivo. Su controlador crea una ficha de criatura Ángel blanca 4/4 con la habilidad de volar.\', \'type\': \'Instantáneo\', \'flavor\': \'Su batallón la llamaba el Ángel de Arkvale. No era más que una metáfora... hasta ahora.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485844&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6d4eb844-0602-43e4-92a1-ee75dc55d38e\', \'multiverseId\': 485844}, \'multiverseid\': 485844}, {\'name\': \'Ascension angélique\', \'text\': \'Exilez la créature ciblée ou le planeswalker ciblé. Son contrôleur crée un jeton de créature 4/4 blanche Ange avec le vol.\', \'type\': \'Éphémère\', \'flavor\': "Dans son bataillon, on l\'appelait l\'ange de Valdarc. Jusqu\'à maintenant, ce n\'était qu\'une métaphore.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486103&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4df3a044-ef1a-4a72-9723-97517290c7b7\', \'multiverseId\': 486103}, \'multiverseid\': 486103}, {\'name\': \'Ascesa Angelica\', \'text\': \'Esilia una creatura o un planeswalker bersaglio. Il suo controllore crea una pedina creatura Angelo 4/4 bianca con volare.\', \'type\': \'Istantaneo\', \'flavor\': "Nel suo battaglione tutti la chiamavano l\'Angelo di Vallarca. Fino ad ora, era solo una metafora.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486362&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3c48f5d2-e772-4a7b-b6be-96ba3b2de40a\', \'multiverseId\': 486362}, \'multiverseid\': 486362}, {\'name\': \'天使への昇天\', \'text\': \'クリーチャー１体かプレインズウォーカー１体を対象とし、それを追放する。それのコントローラーは、飛行を持つ白の４/４の天使・クリーチャー・トークンを１体生成する。\', \'type\': \'インスタント\', \'flavor\': \'所属部隊では「アークベイルの天使」と呼ばれていたが、今まではそれは単なる比喩だった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486621&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'35600ba4-b502-45e1-ad71-c50b01bce472\', \'multiverseId\': 486621}, \'multiverseid\': 486621}, {\'name\': \'천사의 승천\', \'text\': \'생물이나 플레인즈워커를 목표로 정한다. 그 목표를 추방한다. 그 지속물의 조종자는 비행을 가진 4/4 백색 천사 생물 토큰 한 개를 만든다.\', \'type\': \'순간마법\', \'flavor\': \'그녀는 자신이 속한 부대에서 아크베일의 천사로 알려져 있었다. 지금까지는 그 말이 그냥 비유일 뿐이었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486880&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9f937465-42de-4e62-886c-1c72fceddc5b\', \'multiverseId\': 486880}, \'multiverseid\': 486880}, {\'name\': \'Ascensão Angelical\', \'text\': \'Exile a criatura ou o planeswalker alvo. Seu controlador cria uma ficha de criatura branca 4/4 do tipo Anjo com voar.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'No batalhão, ela era conhecida como o Anjo de Arcovale. E até agora era só uma metáfora.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487139&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dd7b3b1a-ef13-4846-8b49-86c1b4919820\', \'multiverseId\': 487139}, \'multiverseid\': 487139}, {\'name\': \'Ангельское Вознесение\', \'text\': "Изгоните целевое существо или planeswalker\'а. Контролирующий его игрок создает одну фишку существа 4/4 белый Ангел с Полетом.", \'type\': \'Мгновенное заклинание\', \'flavor\': \'Ее, ведущую свой батальон в бой, называли Ангелом Арквейла. До нынешнего дня это была лишь метафора.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487398&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9ecc9d1a-8977-42f8-9690-f30b0a0aa3cb\', \'multiverseId\': 487398}, \'multiverseid\': 487398}, {\'name\': \'飞升天界\', \'text\': \'放逐目标生物或鹏洛客。其操控者派出一个4/4白色，具飞行异能的天使衍生生物。\', \'type\': \'瞬间\', \'flavor\': \'她在军中享有「雅克谷天使」美誉。但此前都只不过是比喻而已。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487657&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'98a79fc3-bea3-4f29-acab-71ed8a4716f7\', \'multiverseId\': 487657}, \'multiverseid\': 487657}, {\'name\': \'飛昇天界\', \'text\': \'放逐目標生物或鵬洛客。其操控者派出一個4/4白色，具飛行異能的天使衍生生物。\', \'type\': \'瞬間\', \'flavor\': \'她在軍中享有「雅克谷天使」美譽。但此前都只不過是比喻而已。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487916&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e6277845-dc9a-4d73-b4a5-92905cce7c1e\', \'multiverseId\': 487916}, \'multiverseid\': 487916}]', '[{\'name\': \'Entfesselung der Feuermacht\', \'text\': \'Falls eine Quelle, die du kontrollierst, einer bleibenden Karte oder einem Spieler Schaden zufügen würde, fügt sie der bleibenden Karte oder dem Spieler stattdessen dreimal so viele Schadenspunkte zu.\', \'type\': \'Verzauberung\', \'flavor\': \'„Eines Tages wird das Feuer der Berge auflodern, unsere Ketten sprengen und das Zeitalter der Unterdrückung beenden."\\n—*Die Geschmolzene Prophezeiung*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485725&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fe9219f9-b7c0-469d-98e8-bf78982a7004\', \'multiverseId\': 485725}, \'multiverseid\': 485725}, {\'name\': \'Emancipación ardiente\', \'text\': \'Si una fuente que controlas fuera a hacer daño a un permanente o jugador, en vez de eso, hace el triple de ese daño a ese permanente o jugador.\', \'type\': \'Encantamiento\', \'flavor\': \'"Un día se alzará una montaña de fuego para calcinar nuestras cadenas y poner fin a esta época de opresión".\\n—*La profecía de los fundidos*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485984&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c95573a8-6964-4c68-be58-5e3c2d2c91e1\', \'multiverseId\': 485984}, \'multiverseid\': 485984}, {\'name\': \'Émancipation ardente\', \'text\': \'Si une source que vous contrôlez devait infliger des blessures à un permanent ou à un joueur, elle inflige à la place le triple de ces blessures à ce permanent ou à ce joueur.\', \'type\': \'Enchantement\', \'flavor\': "« Un jour, le feu de la montagne s\'élèvera, brûlera nos chaînes, et mettra un terme à cette ère d\'oppression. »\\n—*La prophétie en fusion*", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486243&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'39b90c75-f6e3-4869-8c34-474f0c8400c1\', \'multiverseId\': 486243}, \'multiverseid\': 486243}, {\'name\': \'Liberazione Ardente\', \'text\': \'Se una fonte che controlli sta per infliggere danno a un permanente o a un giocatore, infligge invece il triplo di quel danno a quel permanente o a quel giocatore.\', \'type\': \'Incantesimo\', \'flavor\': \'"Un giorno il fuoco della montagna insorgerà e brucerà le nostre catene, mettendo fine a quest\\\'epoca di oppressione."\\n—*La Profezia Ignea*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486502&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'898a27ce-8424-4e64-9810-99dbbcd90b0f\', \'multiverseId\': 486502}, \'multiverseid\': 486502}, {\'name\': \'焦熱の解放\', \'text\': \'あなたがコントロールしている発生源がパーマネントやプレイヤーにダメージを与えるなら、代わりに、それはそのパーマネントやプレイヤーにその点数の３倍のダメージを与える。\', \'type\': \'エンチャント\', \'flavor\': \'「いつか、山の火は盛り上がり我らの鎖を焼き切る。そうして抑圧の時代は終わる。」\\n――*溶鉄の予言*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486761&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e30a3558-dd61-4552-98fc-17cbd6dd69dc\', \'multiverseId\': 486761}, \'multiverseid\': 486761}, {\'name\': \'불타는 해방\', \'text\': \'당신이 조종하는 원천이 지속물 또는 플레이어에게 피해를 입히려 한다면, 대신 그 원천은 그 지속물 또는 플레이어에게 그 피해의 세 배를 입힌다.\', \'type\': \'부여마법\', \'flavor\': \'"언젠가는 산의 불길이 솟구쳐올라 우리의 사슬을 불태우고 이 억압의 시대를 끝낼 것이다."\\n—*녹아내린 예언*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487020&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3b85ec0e-cf4e-49bf-9ecb-24b790e8a5e8\', \'multiverseId\': 487020}, \'multiverseid\': 487020}, {\'name\': \'Emancipação Ígnea\', \'text\': \'Se uma fonte que você controla for causar dano a uma permanente ou a um jogador, em vez disso, ela causará o triplo daquele dano àquela permanente ou àquele jogador.\', \'type\': \'Encantamento\', \'flavor\': \'"Um dia o fogo da montanha se erguerá para queimar as nossas correntes e acabar com essa era de opressão."\\n— *A Profecia Derretida*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487279&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0c5b8aa0-e19f-4bf9-a160-c16601388248\', \'multiverseId\': 487279}, \'multiverseid\': 487279}, {\'name\': \'Огненное Освобождение\', \'text\': \'Если источник под вашим контролем должен нанести повреждения перманенту или игроку, вместо этого он наносит те повреждения тому перманенту или игроку в тройном размере.\', \'type\': \'Чары\', \'flavor\': \'«Однажды огонь из сердца горы поднимется, чтобы сжечь наши цепи и положить конец эпохе рабства».\\n— *«Расплавленное пророчество»*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487538&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'149e06e1-b41e-4a5f-b485-8d9d749fd9f4\', \'multiverseId\': 487538}, \'multiverseid\': 487538}, {\'name\': \'焰浪无拘\', \'text\': \'如果某个由你操控的来源将对任一永久物或牌手造成伤害，则改为它对该永久物或牌手造成三倍的伤害。\', \'type\': \'结界\', \'flavor\': \'「总有一天，山中烈焰将猛烈翻涌，焚尽我们周身镣铐，终结这一压迫时代。」\\n～*《熔铁预言》*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487797&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'535a2771-ff4b-4956-9c5e-8c93f0dcc6d9\', \'multiverseId\': 487797}, \'multiverseid\': 487797}, {\'name\': \'焰浪無拘\', \'text\': \'如果某個由你操控的來源將對任一永久物或玩家造成傷害，則改為它對該永久物或玩家造成三倍的傷害。\', \'type\': \'結界\', \'flavor\': \'「總有一天，山中烈焰將猛烈翻湧，焚盡我們周身鐐銬，終結這一壓迫時代。」\\n～*《熔鐵預言》*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488056&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4f3e0792-5916-4331-b742-1bb63fb912bd\', \'multiverseId\': 488056}, \'multiverseid\': 488056}]', '[{\'name\': \'Entité ailorage\', \'text\': "Ce sort coûte {2}{U} de moins à lancer si vous avez lancé un sort d\'éphémère ou de rituel ce tour-ci.\\nVol\\nProuesse\\nQuand l\'Entité ailorage arrive sur le champ de bataille, regard 2.", \'type\': \'Créature : élémental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488305&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3a8cbff7-e4d2-4744-b601-1e626ff87445\', \'multiverseId\': 488305}, \'multiverseid\': 488305}, {\'name\': \'嵐翼の精体\', \'text\': \'このターンにあなたがインスタントかソーサリーである呪文を唱えていたなら、この呪文を唱えるためのコストは{2}{U}少なくなる。\\n飛行\\n果敢\\n嵐翼の精体が戦場に出たとき、占術２を行う。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488357&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'962a8ea2-4135-4711-a394-374139e75470\', \'multiverseId\': 488357}, \'multiverseid\': 488357}]', "[{'name': 'Erblühender Sand', 'text': 'Der Erblühende Sand kommt getappt ins Spiel.\\nWenn der Erblühende Sand ins Spiel kommt, erhältst du 1 Lebenspunkt dazu.\\n{T}: Erzeuge {G} oder {W}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485826&type=card', 'language': 'German', 'identifiers': {'scryfallId': '26bfd512-80bc-4f24-800a-08eef318bf5c', 'multiverseId': 485826}, 'multiverseid': 485826}, {'name': 'Arenas florecientes', 'text': 'Las Arenas florecientes entran al campo de batalla giradas.\\nCuando las Arenas florecientes entren al campo de batalla, ganas 1 vida.\\n{T}: Agrega {G} o {W}.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486085&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'f30e6a7d-bff5-4258-b217-50b78bb86ced', 'multiverseId': 486085}, 'multiverseid': 486085}, {'name': 'Sables verdoyants', 'text': 'Les Sables verdoyants arrivent sur le champ de bataille engagés.\\nQuand les Sables verdoyants arrivent sur le champ de bataille, vous gagnez 1 point de vie.\\n{T} : Ajoutez {G} ou {W}.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486344&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd48972f0-f94d-479d-99fe-6ca9dee81634', 'multiverseId': 486344}, 'multiverseid': 486344}, {'name': 'Sabbie Verdeggianti', 'text': 'Le Sabbie Verdeggianti entrano nel campo di battaglia TAPpate.\\nQuando le Sabbie Verdeggianti entrano nel campo di battaglia, guadagni 1 punto vita.\\n{T}: Aggiungi {G} o {W}.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486603&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '4cbe44f1-ab61-4eff-a16b-c474f2d8d049', 'multiverseId': 486603}, 'multiverseid': 486603}, {'name': '花咲く砂地', 'text': '花咲く砂地はタップ状態で戦場に出る。\\n花咲く砂地が戦場に出たとき、あなたは１点のライフを得る。\\n{T}：{G}か{W}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486862&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '96b22c76-e000-4022-a4c4-f30c6e64f940', 'multiverseId': 486862}, 'multiverseid': 486862}, {'name': '꽃피는 사막', 'text': '꽃피는 사막은 탭된 채로 전장에 들어온다.\\n꽃피는 사막이 전장에 들어올 때, 당신은 생명 1점을 얻는다.\\n{T}: {G} 또는 {W}를 추가한다.', 'type': '대지', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487121&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '7320f00d-9a55-47f7-b738-21f25a8525c5', 'multiverseId': 487121}, 'multiverseid': 487121}, {'name': 'Areias Verdejantes', 'text': 'Areias Verdejantes entra no campo de batalha virado.\\nQuando Areias Verdejantes entra no campo de batalha, você ganha 1 ponto de vida.\\n{T}: Adicione {G} ou {W}.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487380&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '01cfb459-2329-4363-840b-279116eff10f', 'multiverseId': 487380}, 'multiverseid': 487380}, {'name': 'Цветущие Пески', 'text': 'Цветущие Пески выходят на поле битвы повернутыми.\\nКогда Цветущие Пески выходят на поле битвы, вы получаете 1 жизнь.\\n{T}: добавьте {G} или {W}.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487639&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '900187e0-92b4-4fcb-a7e3-0cb4fa611c92', 'multiverseId': 487639}, 'multiverseid': 487639}, {'name': '繁花沙洲', 'text': '繁花沙洲须横置进战场。\\n当繁花沙洲进战场时，你获得1点生命。\\n{T}：加{G}或{W}。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487898&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '8d1bfd67-42f5-4b42-9e3b-f8758e5ca521', 'multiverseId': 487898}, 'multiverseid': 487898}, {'name': '繁花沙洲', 'text': '繁花沙洲須橫置進戰場。\\n當繁花沙洲進戰場時，你獲得1點生命。\\n{T}：加{G}或{W}。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488157&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'e3bd4683-a567-4df2-953c-14f5184297c4', 'multiverseId': 488157}, 'multiverseid': 488157}]", "[{'name': 'Erhabenes Scheinbild', 'text': 'Wenn das Erhabene Scheinbild ins Spiel kommt, kannst du deine Bibliothek nach einer Standardland-Karte durchsuchen, sie getappt ins Spiel bringen und dann deine Bibliothek mischen.\\nWenn das Erhabene Scheinbild stirbt, kannst du eine Karte ziehen.', 'type': 'Artefaktkreatur — Golem', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485821&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c31a88f6-5830-4735-a0f4-14ff81a3d8e9', 'multiverseId': 485821}, 'multiverseid': 485821}, {'name': 'Simulacro solemne', 'text': 'Cuando el Simulacro solemne entre al campo de batalla, puedes buscar en tu biblioteca una carta de tierra básica, poner esa carta en el campo de batalla girada y luego barajar tu biblioteca.\\nCuando el Simulacro solemne muera, puedes robar una carta.', 'type': 'Criatura artefacto — Gólem', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486080&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4cbf94fe-ecf1-4813-ab00-ffd5aee177b1', 'multiverseId': 486080}, 'multiverseid': 486080}, {'name': 'Simulacre solennel', 'text': 'Quand le Simulacre solennel arrive sur le champ de bataille, vous pouvez chercher une carte de terrain de base dans votre bibliothèque, la mettre sur le champ de bataille engagée et mélanger ensuite votre bibliothèque.\\nQuand le Simulacre solennel meurt, vous pouvez piocher une carte.', 'type': 'Créature-artefact : golem', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486339&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd92459a3-f4b8-470c-ab72-686491d56f79', 'multiverseId': 486339}, 'multiverseid': 486339}, {'name': 'Simulacro Solenne', 'text': 'Quando il Simulacro Solenne entra nel campo di battaglia, puoi passare in rassegna il tuo grimorio per una carta terra base, metterla sul campo di battaglia TAPpata, poi rimescolare il tuo grimorio.\\nQuando il Simulacro Solenne muore, puoi pescare una carta.', 'type': 'Creatura Artefatto — Golem', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486598&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ff39eb32-f3cd-46de-b222-a1f85ff31609', 'multiverseId': 486598}, 'multiverseid': 486598}, {'name': '真面目な身代わり', 'text': '真面目な身代わりが戦場に出たとき、あなたは「あなたのライブラリーから基本土地・カード１枚を探し、タップ状態で戦場に出し、その後あなたのライブラリーを切り直す。」を選んでもよい。\\n真面目な身代わりが死亡したとき、あなたはカードを１枚引いてもよい。', 'type': 'アーティファクト・クリーチャー — ゴーレム', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486857&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '66310e29-d58b-4be9-999f-11b89f6ea307', 'multiverseId': 486857}, 'multiverseid': 486857}, {'name': '근엄한 인조인간', 'text': '근엄한 인조인간이 전장에 들어올 때, 당신은 당신의 서고에서 기본 대지 카드 한 장을 찾아 탭된 채로 전장에 놓을 수 있다. 그렇게 한다면, 당신의 서고를 섞는다.\\n근엄한 인조인간이 죽을 때, 당신은 카드 한 장을 뽑을 수 있다.', 'type': '마법물체 생물 — 골렘', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487116&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'a951c097-84d2-407e-91ea-bbf7736252c2', 'multiverseId': 487116}, 'multiverseid': 487116}, {'name': 'Simulacro Solene', 'text': 'Quando Simulacro Solene entra no campo de batalha, você pode procurar um card de terreno básico em seu grimório, colocá-lo no campo de batalha virado e depois embaralhar seu grimório.\\nQuando Simulacro Solene morre, você pode comprar um card.', 'type': 'Criatura Artefato — Golem', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487375&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8ef7b748-c644-4e08-8dde-3edf0fb71d5c', 'multiverseId': 487375}, 'multiverseid': 487375}, {'name': 'Величественный Симулякр', 'text': 'Когда Величественный Симулякр выходит на поле битвы, вы можете найти в вашей библиотеке карту базовой земли, положить ее на поле битвы повернутой, затем перетасовать вашу библиотеку.\\nКогда Величественный Симулякр умирает, вы можете взять карту.', 'type': 'Артефакт Существо — Голем', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487634&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '1ce5026a-035a-4bb9-bfe8-6e4a268a760f', 'multiverseId': 487634}, 'multiverseid': 487634}, {'name': '黯色幻影', 'text': '当黯色幻影进战场时，你可以从你的牌库中搜寻一张基本地牌，将该牌横置放进战场，然后将你的牌库洗牌。\\n当黯色幻影死去时，你可以抓一张牌。', 'type': '神器生物 ～魔像', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487893&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a6ee0fdd-5713-4ee2-a078-dd27ce7933e5', 'multiverseId': 487893}, 'multiverseid': 487893}, {'name': '黯色幻影', 'text': '當黯色幻影進戰場時，你可以從你的牌庫中搜尋一張基本地牌，將該牌橫置放進戰場，然後將你的牌庫洗牌。\\n當黯色幻影死去時，你可以抽一張牌。', 'type': '神器生物 ～魔像', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488152&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '354246a5-6521-470e-b9e3-e183b15cac98', 'multiverseId': 488152}, 'multiverseid': 488152}]", "[{'name': 'Erhabenes Scheinbild', 'text': 'Wenn das Erhabene Scheinbild ins Spiel kommt, kannst du deine Bibliothek nach einer Standardland-Karte durchsuchen, sie getappt ins Spiel bringen und dann deine Bibliothek mischen.\\nWenn das Erhabene Scheinbild stirbt, kannst du eine Karte ziehen.', 'type': 'Artefaktkreatur — Golem', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488406&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4204a788-48b2-464f-b3f6-4d8fbc203705', 'multiverseId': 488406}, 'multiverseid': 488406}, {'name': 'Simulacro solemne', 'text': 'Cuando el Simulacro solemne entre al campo de batalla, puedes buscar en tu biblioteca una carta de tierra básica, poner esa carta en el campo de batalla girada y luego barajar tu biblioteca.\\nCuando el Simulacro solemne muera, puedes robar una carta.', 'type': 'Criatura artefacto — Gólem', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488412&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c024c3d4-7dc4-4077-b8ba-d901cb4ad0db', 'multiverseId': 488412}, 'multiverseid': 488412}, {'name': 'Simulacre solennel', 'text': 'Quand le Simulacre solennel arrive sur le champ de bataille, vous pouvez chercher une carte de terrain de base dans votre bibliothèque, la mettre sur le champ de bataille engagée et mélanger ensuite votre bibliothèque.\\nQuand le Simulacre solennel meurt, vous pouvez piocher une carte.', 'type': 'Créature-artefact : golem', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488418&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b14ccd7e-3651-4248-9a4d-275c25d3493b', 'multiverseId': 488418}, 'multiverseid': 488418}, {'name': 'Simulacro Solenne', 'text': 'Quando il Simulacro Solenne entra nel campo di battaglia, puoi passare in rassegna il tuo grimorio per una carta terra base, metterla sul campo di battaglia TAPpata, poi rimescolare il tuo grimorio.\\nQuando il Simulacro Solenne muore, puoi pescare una carta.', 'type': 'Creatura Artefatto — Golem', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488424&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '05ff2458-aeac-4f2d-aa62-fd9e0280db92', 'multiverseId': 488424}, 'multiverseid': 488424}, {'name': '真面目な身代わり', 'text': '真面目な身代わりが戦場に出たとき、あなたは「あなたのライブラリーから基本土地・カード１枚を探し、タップ状態で戦場に出し、その後あなたのライブラリーを切り直す。」を選んでもよい。\\n真面目な身代わりが死亡したとき、あなたはカードを１枚引いてもよい。', 'type': 'アーティファクト・クリーチャー — ゴーレム', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488430&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '555c29b0-8681-46e1-b583-9130db9a8f58', 'multiverseId': 488430}, 'multiverseid': 488430}, {'name': '근엄한 인조인간', 'text': '근엄한 인조인간이 전장에 들어올 때, 당신은 당신의 서고에서 기본 대지 카드 한 장을 찾아 탭된 채로 전장에 놓을 수 있다. 그렇게 한다면, 당신의 서고를 섞는다.\\n근엄한 인조인간이 죽을 때, 당신은 카드 한 장을 뽑을 수 있다.', 'type': '마법물체 생물 — 골렘', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488436&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '05f4d756-83ec-4dea-9bd1-b7061e0e67fa', 'multiverseId': 488436}, 'multiverseid': 488436}, {'name': 'Simulacro Solene', 'text': 'Quando Simulacro Solene entra no campo de batalha, você pode procurar um card de terreno básico em seu grimório, colocá-lo no campo de batalha virado e depois embaralhar seu grimório.\\nQuando Simulacro Solene morre, você pode comprar um card.', 'type': 'Criatura Artefato — Golem', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488442&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1b9bb09d-6ea3-4499-8952-ebbde0a1ab4b', 'multiverseId': 488442}, 'multiverseid': 488442}, {'name': 'Величественный Симулякр', 'text': 'Когда Величественный Симулякр выходит на поле битвы, вы можете найти в вашей библиотеке карту базовой земли, положить ее на поле битвы повернутой, затем перетасовать вашу библиотеку.\\nКогда Величественный Симулякр умирает, вы можете взять карту.', 'type': 'Артефакт Существо — Голем', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488448&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'cf7683fc-2d9a-4551-b20c-ab96dd00794a', 'multiverseId': 488448}, 'multiverseid': 488448}, {'name': '黯色幻影', 'text': '当黯色幻影进战场时，你可以从你的牌库中搜寻一张基本地牌，将该牌横置放进战场，然后将你的牌库洗牌。\\n当黯色幻影死去时，你可以抓一张牌。', 'type': '神器生物 ～魔像', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488454&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'fda7beea-8ca7-4fae-8b77-ae5cfc10a047', 'multiverseId': 488454}, 'multiverseid': 488454}, {'name': '黯色幻影', 'text': '當黯色幻影進戰場時，你可以從你的牌庫中搜尋一張基本地牌，將該牌橫置放進戰場，然後將你的牌庫洗牌。\\n當黯色幻影死去時，你可以抽一張牌。', 'type': '神器生物 ～魔像', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488460&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'f3f905d7-b5f7-4eaa-917d-5a0f29ddb87b', 'multiverseId': 488460}, 'multiverseid': 488460}]", '[{\'name\': \'Erwecker der Wellen\', \'text\': \'Kreaturen, die deine Gegner kontrollieren, erhalten -1/-0.\\n{1}{U}, wirf den Erwecker der Wellen ab: Schaue dir die obersten zwei Karten deiner Bibliothek an. Nimm eine davon auf deine Hand und lege die andere auf deinen Friedhof.\', \'type\': \'Kreatur — Wal\', \'flavor\': \'Auf offener See kann man sich nicht verstecken.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485666&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5ef27f84-d66a-4cb2-91fa-450514821f16\', \'multiverseId\': 485666}, \'multiverseid\': 485666}, {\'name\': \'Despiertaolas\', \'text\': \'Las criaturas que controlan tus oponentes obtienen -1/-0.\\n{1}{U}, descartar la Despiertaolas: Mira las dos primeras cartas de tu biblioteca. Pon una de ellas en tu mano y la otra en tu cementerio.\', \'type\': \'Criatura — Ballena\', \'flavor\': \'En el mar abierto no hay donde esconderse.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485925&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bf42731d-3bb5-403a-a9aa-65bfcecf4e6e\', \'multiverseId\': 485925}, \'multiverseid\': 485925}, {\'name\': \'Éveilleur des vagues\', \'text\': "Les créatures que vos adversaires contrôlent gagnent -1/-0.\\n{1}{U}, défaussez-vous de l\'Éveilleur des vagues : Regardez les deux cartes du dessus de votre bibliothèque. Mettez l\'une d\'entre elles dans votre main et l\'autre dans votre cimetière.", \'type\': \'Créature : baleine\', \'flavor\': "En pleine mer, il n\'y a nulle part où se cacher.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486184&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6d8fd15e-8559-4e67-a020-f30f8f73c453\', \'multiverseId\': 486184}, \'multiverseid\': 486184}, {\'name\': \'Destaonde\', \'text\': "Le creature controllate dai tuoi avversari prendono -1/-0.\\n{1}{U}, Scarta il Destaonde: Guarda le prime due carte del tuo grimorio. Aggiungine una alla tua mano e metti l\'altra nel tuo cimitero.", \'type\': \'Creatura — Balena\', \'flavor\': "In mare aperto, non c\'è posto in cui nascondersi.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486443&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d2e84559-6302-4e23-abd0-4f8b3f33b265\', \'multiverseId\': 486443}, \'multiverseid\': 486443}, {\'name\': \'波起こし\', \'text\': \'対戦相手がコントロールしているクリーチャーは－１/－０の修整を受ける。\\n{1}{U}, 波起こしを捨てる：あなたのライブラリーの一番上からカードを２枚見る。そのうち１枚をあなたの手札に、もう１枚をあなたの墓地に置く。\', \'type\': \'クリーチャー — 鯨\', \'flavor\': \'大海原には隠れる場所などない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486702&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5ce8caec-751c-446e-a84d-21c774384f03\', \'multiverseId\': 486702}, \'multiverseid\': 486702}, {\'name\': \'파도를 깨우는 괴수\', \'text\': \'당신의 상대들이 조종하는 생물들은 -1/-0을 받는다.\\n{1}{U}, 파도를 깨우는 괴수를 버린다: 당신의 서고 맨 위 카드 두 장을 본다. 그중 한 장을 당신의 손으로 가져가고 다른 한 장은 당신의 무덤에 넣는다.\', \'type\': \'생물 — 고래\', \'flavor\': \'망망대해에서, 숨을 곳이라고는 없다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486961&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'36262b44-4c02-4790-9a9e-820530a02cd5\', \'multiverseId\': 486961}, \'multiverseid\': 486961}, {\'name\': \'Despertador de Ondas\', \'text\': \'As criaturas que seus oponentes controlam recebem -1/-0.\\n{1}{U}, descarte Despertador de Ondas: Olhe os dois cards do topo de seu grimório. Coloque um deles na sua mão e o outro em seu cemitério.\', \'type\': \'Criatura — Baleia\', \'flavor\': \'Em mar aberto não há onde se esconder.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487220&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'06adb2b4-e8c8-4854-96ac-ac7150279704\', \'multiverseId\': 487220}, \'multiverseid\': 487220}, {\'name\': \'Пробудитель Волн\', \'text\': \'Существа под контролем ваших оппонентов получают -1/-0.\\n{1}{U}, сбросьте Пробудителя Волн: посмотрите две верхние карты вашей библиотеки. Положите одну из них в вашу руку, а другую — на ваше кладбище.\', \'type\': \'Существо — Кит\', \'flavor\': \'В открытом море негде спрятаться.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487479&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'38b4d19a-ac71-4fd9-8dec-817da2898de9\', \'multiverseId\': 487479}, \'multiverseid\': 487479}, {\'name\': \'弄涛巨鲸\', \'text\': \'由对手操控的生物得-1/-0。\\n{1}{U}，弃掉弄涛巨鲸：检视你牌库顶的两张牌。将其中一张置于你手上，另一张则置入你的坟墓场。\', \'type\': \'生物 ～鲸鱼\', \'flavor\': \'在广阔的大海中，没有一处藏身之地。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487738&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f3e6b2f8-0c86-45d7-8adb-a6c6aa636f8d\', \'multiverseId\': 487738}, \'multiverseid\': 487738}, {\'name\': \'弄濤巨鯨\', \'text\': \'由對手操控的生物得-1/-0。\\n{1}{U}，棄掉弄濤巨鯨：檢視你牌庫頂的兩張牌。將其中一張置於你手上，另一張則置入你的墳墓場。\', \'type\': \'生物 ～鯨魚\', \'flavor\': \'在廣闊的大海中，沒有一處藏身之地。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487997&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fbf5628f-4161-4f35-aaf4-bfc9351f95da\', \'multiverseId\': 487997}, \'multiverseid\': 487997}]', '[{\'name\': \'Experimentelle Überlast\', \'text\': \'Erzeuge einen X/X blauen und roten Seltsamkeit-Kreaturenspielstein, wobei X gleich der Anzahl an Spontanzauber- und Hexereikarten in deinem Friedhof ist. Dann kannst du eine Spontanzauber- oder Hexereikarte aus deinem Friedhof auf deine Hand zurückbringen. Schicke die Experimentelle Überlast ins Exil.\', \'type\': \'Hexerei\', \'flavor\': \'Explosionen sind nicht immer Fehler, nur eine andere Art von Erfolg.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485800&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9a21b62c-8050-4d15-b62b-e1e509ce30f0\', \'multiverseId\': 485800}, \'multiverseid\': 485800}, {\'name\': \'Sobrecarga experimental\', \'text\': \'Crea una ficha de criatura Extraño azul y roja X/X, donde X es la cantidad de cartas de instantáneo y de conjuro en tu cementerio. Luego, puedes regresar una carta de instantáneo o de conjuro de tu cementerio a tu mano. Exilia la Sobrecarga experimental.\', \'type\': \'Conjuro\', \'flavor\': \'Las explosiones no tienen por qué significar que algo salió mal; pueden ser un tipo de éxito diferente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486059&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3bb87863-bd23-4332-8030-69589dbf121d\', \'multiverseId\': 486059}, \'multiverseid\': 486059}, {\'name\': \'Surcharge expérimentale\', \'text\': "Créez un jeton de créature X/X bleue et rouge Anomalie, X étant le nombre de cartes d\'éphémère et de rituel dans votre cimetière. Puis vous pouvez renvoyer une carte d\'éphémère ou de rituel depuis votre cimetière dans votre main. Exilez la Surcharge expérimentale.", \'type\': \'Rituel\', \'flavor\': \'Les explosions ne sont pas nécessairement des échecs, juste une autre forme de réussite.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486318&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7b89d1c7-d221-48a8-99d1-3f76e4568165\', \'multiverseId\': 486318}, \'multiverseid\': 486318}, {\'name\': \'Sovraccarico Sperimentale\', \'text\': \'Crea una pedina creatura Bizzarria X/X blu e rossa, dove X è il numero di carte istantaneo e stregoneria nel tuo cimitero. Poi, puoi riprendere in mano una carta istantaneo o stregoneria dal tuo cimitero. Esilia il Sovraccarico Sperimentale.\', \'type\': \'Stregoneria\', \'flavor\': "Un\'esplosione non è per forza un fallimento, ma solo un tipo diverso di successo.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486577&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ec71e6c5-bb66-4ceb-9087-ae318e9b144e\', \'multiverseId\': 486577}, \'multiverseid\': 486577}, {\'name\': \'実験的過負荷\', \'text\': \'青であり赤であるＸ/Ｘの奇魔・クリーチャー・トークンを１体生成する。Ｘはあなたの墓地にありインスタントやソーサリーであるカードの枚数に等しい。その後、あなたはあなたの墓地からインスタントかソーサリーであるカード１枚をあなたの手札に戻してもよい。実験的過負荷を追放する。\', \'type\': \'ソーサリー\', \'flavor\': \'爆発は失敗とは限らない。単に種類が違う成功である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486836&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'34e8124f-55c4-4467-9e7d-d7c7d319aa8a\', \'multiverseId\': 486836}, \'multiverseid\': 486836}, {\'name\': \'실험적 과부하\', \'text\': \'X/X 청색 및 적색 위어드 생물 토큰 한 개를 만든다. X는 당신의 무덤에 있는 순간마법 및 집중마법 카드의 수이다. 그 후 당신은 당신의 무덤에서 순간마법 또는 집중마법 카드 한 장을 당신의 손으로 되돌릴 수 있다. 실험적 과부하를 추방한다.\', \'type\': \'집중마법\', \'flavor\': \'폭발이 꼭 실패인 것은 아니다. 다른 종류의 성공일 뿐이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487095&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'405e51cf-4a8f-4d04-ac20-3a46b3e7a6ca\', \'multiverseId\': 487095}, \'multiverseid\': 487095}, {\'name\': \'Sobrecarga Experimental\', \'text\': \'Crie uma ficha de criatura azul e vermelha X/X do tipo Bizarro, sendo X o número de cards de mágica instantânea e feitiço em seu cemitério. Depois, você pode devolver um card de mágica instantânea ou feitiço de seu cemitério para sua mão. Exile Sobrecarga Experimental.\', \'type\': \'Feitiço\', \'flavor\': \'Explosões não são necessariamente fracassos, mas um tipo diferente de sucesso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487354&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4f1d7278-4147-4d10-910d-151079b9afca\', \'multiverseId\': 487354}, \'multiverseid\': 487354}, {\'name\': \'Экспериментальная Перегрузка\', \'text\': \'Создайте одну фишку существа X/X синяя и красная Диковина, где X — количество карт мгновенных заклинаний и волшебства на вашем кладбище. Затем вы можете вернуть карту мгновенного заклинания или волшебства из вашего кладбища в вашу руку. Изгоните Экспериментальную Перегрузку.\', \'type\': \'Волшебство\', \'flavor\': \'Взрыв вовсе не обязательно означает неудачу. Просто это другой тип успеха.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487613&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f68efb68-6c31-4b4c-a73a-b1cb902f170e\', \'multiverseId\': 487613}, \'multiverseid\': 487613}, {\'name\': \'实验性过载\', \'text\': \'派出一个X/X，蓝红双色的怪奇衍生生物，X为你坟墓场中瞬间与法术牌的数量加总。然后你可以将一张瞬间或法术牌从你的坟墓场移回你手上。放逐实验性过载。\', \'type\': \'法术\', \'flavor\': \'爆炸不一定是失败，或许只是另一种成功。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487872&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0625dc51-f1bc-47f2-8d26-5e38ee2de08f\', \'multiverseId\': 487872}, \'multiverseid\': 487872}, {\'name\': \'實驗性過載\', \'text\': \'派出一個X/X，藍紅雙色的怪奇衍生生物，X為你墳墓場中瞬間與巫術牌的數量加總。然後你可以將一張瞬間或巫術牌從你的墳墓場移回你手上。放逐實驗性過載。\', \'type\': \'巫術\', \'flavor\': \'爆炸不一定是失敗，或許是另一種成功。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488131&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4a69aef5-4564-4f19-9752-b1339c677cba\', \'multiverseId\': 488131}, \'multiverseid\': 488131}]', '[{\'name\': \'Falkner-Adeptin\', \'text\': \'Immer wenn die Falkner-Adeptin angreift, erzeuge einen getappten und angreifenden 1/1 weißen Vogel-Kreaturenspielstein mit Flugfähigkeit.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'„Meine Falken gehören zur Familie, so wie jedes andere Mitglied meines Klans."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485600&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ce7864cc-b16d-4c11-b8c9-6fc56104b466\', \'multiverseId\': 485600}, \'multiverseid\': 485600}, {\'name\': \'Halconera experta\', \'text\': \'Siempre que la Halconera experta ataque, crea una ficha de criatura Ave blanca 1/1 con la habilidad de volar que está girada y atacando.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'"Mis halcones son mi familia, al igual que cualquier otro miembro de mi clan".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485859&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7fe42ccb-153e-4a94-be8e-4fee591cd3dd\', \'multiverseId\': 485859}, \'multiverseid\': 485859}, {\'name\': \'Experte fauconnière\', \'text\': "À chaque fois que l\'Experte fauconnière attaque, créez un jeton de créature 1/1 blanche Oiseau avec le vol, engagé et attaquant.", \'type\': \'Créature : humain et soldat\', \'flavor\': "« Mes faucons font partie de ma famille, au même titre que n\'importe quel autre membre de mon clan. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486118&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c0aeac48-3e0f-4d6d-a26a-930966c40b87\', \'multiverseId\': 486118}, \'multiverseid\': 486118}, {\'name\': \'Falconiera Esperta\', \'text\': \'Ogniqualvolta la Falconiera Esperta attacca, crea una pedina creatura Uccello 1/1 bianca con volare TAPpata e attaccante.\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'"I miei falchi sono la mia famiglia, al pari di qualsiasi altro membro del mio clan."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486377&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f3c792bb-a8e5-4e3b-8ca0-84e7a482aad1\', \'multiverseId\': 486377}, \'multiverseid\': 486377}, {\'name\': \'隼使いの達人\', \'text\': \'隼使いの達人が攻撃するたび、飛行を持つ白の１/１の鳥・クリーチャー・トークンを１体、タップ状態かつ攻撃している状態で生成する。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'「隼たちはみな家族。氏族の他の者たちと同じように。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486636&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b27b77da-e537-45f8-ba97-e5da868ba48f\', \'multiverseId\': 486636}, \'multiverseid\': 486636}, {\'name\': \'능숙한 매사냥꾼\', \'text\': \'능숙한 매사냥꾼이 공격할 때마다, 탭되어 공격 중인 비행을 가진 1/1 백색 조류 생물 토큰 한 개를 만든다.\', \'type\': \'생물 — 인간 병사\', \'flavor\': \'"내 매들은 내 가족이야. 내 부족의 다른 누구와 비교해도 뒤처지지 않지."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486895&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'92859371-c02c-4a92-8f65-8b2ed000894c\', \'multiverseId\': 486895}, \'multiverseid\': 486895}, {\'name\': \'Adepta Falcoeira\', \'text\': \'Toda vez que Adepta Falcoeira atacar, crie uma ficha de criatura branca 1/1 do tipo Ave com voar virada e atacando.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': \'"Meus falcões são da família, tanto quanto qualquer outro membro do meu clã."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487154&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3a58e413-4655-49af-8c0f-afee389400a7\', \'multiverseId\': 487154}, \'multiverseid\': 487154}, {\'name\': \'Опытная Сокольничья\', \'text\': \'Каждый раз, когда Опытная Сокольничья атакует, создайте одну фишку существа 1/1 белая Птица с Полетом повернутой и атакующей.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'«Мои соколы — моя семья, такая же, как остальные в моем клане».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487413&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a01c6cae-2949-4bc5-920e-41c9f17625a1\', \'multiverseId\': 487413}, \'multiverseid\': 487413}, {\'name\': \'训隼专家\', \'text\': \'每当训隼专家攻击时，派出一个1/1白色，具飞行异能的鸟衍生生物，其为横置且正进行攻击。\', \'type\': \'生物 ～人类／士兵\', \'flavor\': \'「我与部落伙伴如家人般亲密，我跟手下鹰隼也是如此。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487672&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a7de706b-9386-414e-9baa-672c775579a6\', \'multiverseId\': 487672}, \'multiverseid\': 487672}, {\'name\': \'訓隼專家\', \'text\': \'每當訓隼專家攻擊時，派出一個1/1白色，具飛行異能的鳥衍生生物，其為橫置且正進行攻擊。\', \'type\': \'生物 ～人類／士兵\', \'flavor\': \'「我與部落伙伴如家人般親密，我跟手下鷹隼也是如此。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487931&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6f8b037f-60f1-407b-ad25-9b6c77d3f4f5\', \'multiverseId\': 487931}, \'multiverseid\': 487931}]', '[{\'name\': \'Fallgitter-Ranken\', \'text\': \'Verteidiger (Diese Kreatur kann nicht angreifen.)\\n{2}, {T}, opfere eine Kreatur mit Verteidiger: Ziehe eine Karte.\', \'type\': \'Kreatur — Pflanze, Mauer\', \'flavor\': \'Die Natur will uns damit sagen: „Nimm lieber einen Umweg."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485777&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b4c8ce9f-c92f-4109-8836-19c0f1e2b09f\', \'multiverseId\': 485777}, \'multiverseid\': 485777}, {\'name\': \'Enredadera del portón\', \'text\': \'Defensor. (Esta criatura no puede atacar.)\\n{2}, {T}, sacrificar una criatura con la habilidad de defensor: Roba una carta.\', \'type\': \'Criatura — Muro planta\', \'flavor\': \'Es la manera que tiene la naturaleza de decir: "Toma el camino largo hacia casa".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486036&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b9aff001-908f-4607-9f1b-8fb4c2ea38a9\', \'multiverseId\': 486036}, \'multiverseid\': 486036}, {\'name\': \'Lierre de herse\', \'text\': \'Défenseur (Cette créature ne peut pas attaquer.)\\n{2}, {T}, sacrifiez une créature avec le défenseur : Piochez une carte.\', \'type\': \'Créature : plante et mur\', \'flavor\': \'Quand la nature vous dit de faire « un détour pour rentrer chez vous ».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486295&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9d56e06b-016f-4d06-9040-9060678da7b8\', \'multiverseId\': 486295}, \'multiverseid\': 486295}, {\'name\': \'Saracinesca di Rampicanti\', \'text\': \'Difensore (Questa creatura non può attaccare.)\\n{2}, {T}, Sacrifica una creatura con difensore: Pesca una carta.\', \'type\': \'Creatura — Muro Pianta\', \'flavor\': \'È la natura che ti dice di tornare a casa per la via più lunga.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486554&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'acf07330-a773-44ec-9b2a-627a9f3869c6\', \'multiverseId\': 486554}, \'multiverseid\': 486554}, {\'name\': \'落とし格子の蔦\', \'text\': \'防衛（このクリーチャーでは攻撃できない。）\\n{2}, {T}, 防衛を持つクリーチャー１体を生け贄に捧げる：カードを１枚引く。\', \'type\': \'クリーチャー — 植物・壁\', \'flavor\': \'「遠回りをして帰りなさい」という自然からの忠告。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486813&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'12050816-d8b4-4d01-a0ea-0438ad8cdf40\', \'multiverseId\': 486813}, \'multiverseid\': 486813}, {\'name\': \'쇠창살 덩굴\', \'text\': \'수비태세 (이 생물은 공격할 수 없다.)\\n{2}, {T}, 수비태세를 가진 생물 한 개를 희생한다: 카드 한 장을 뽑는다.\', \'type\': \'생물 — 식물 벽\', \'flavor\': \'자연이 "빙 돌아서 집에 가라"라고 말하는 방법.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487072&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9be36ce3-7aaf-44b0-a040-5679b19c5006\', \'multiverseId\': 487072}, \'multiverseid\': 487072}, {\'name\': \'Hédera do Pórtico\', \'text\': \'Defensor (Esta criatura não pode atacar.)\\n{2}, {T}, sacrifique uma criatura com defensor: Compre um card.\', \'type\': \'Criatura — Planta Barreira\', \'flavor\': \'É o jeito da natureza dizer "pegue o caminho mais longo para casa".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487331&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a8d10c8c-6394-493f-98fd-59f8e0e744ac\', \'multiverseId\': 487331}, \'multiverseid\': 487331}, {\'name\': \'Решетчатая Лиана\', \'text\': \'Защитник (Это существо не может атаковать.)\\n{2}, {T}, пожертвуйте существо со способностью Защитника: возьмите карту.\', \'type\': \'Существо — Растение Стена\', \'flavor\': \'Так природа говорит: «Иди домой длинной дорогой».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487590&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0caa0b08-2594-457a-a51b-352a8b071c40\', \'multiverseId\': 487590}, \'multiverseid\': 487590}, {\'name\': \'闸门藤蔓\', \'text\': \'守军（此生物不能攻击。）\\n{2}，{T}，牺牲一个具守军异能的生物：抓一张牌。\', \'type\': \'生物 ～植物／墙\', \'flavor\': \'大自然版本的「长路归家」。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487849&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1bc6d2f3-2fb4-4ada-9644-8e3f0bf85908\', \'multiverseId\': 487849}, \'multiverseid\': 487849}, {\'name\': \'閘門藤蔓\', \'text\': \'守軍（此生物不能攻擊。）\\n{2}，{T}，犧牲一個具守軍異能的生物：抽一張牌。\', \'type\': \'生物 ～植物／牆\', \'flavor\': \'大自然版本的「長路歸家」。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488108&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a594d59f-3762-4566-897f-39186e751aea\', \'multiverseId\': 488108}, \'multiverseid\': 488108}]', '[{\'name\': \'Federn lassen\', \'text\': \'Ein Gegner deiner Wahl opfert eine fliegende Kreatur.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Was hast du heute gefangen, mein Kleiner? Ah, sieht aus, als würde da noch etwas Vampir zwischen deinen Zähnen stecken."\\n—Atla Palani, Behüterin der Nester\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485783&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a6fb275f-3a91-43c2-8bc5-85f16bda3af9\', \'multiverseId\': 485783}, \'multiverseid\': 485783}, {\'name\': \'Entrar en conflicto\', \'text\': \'El oponente objetivo sacrifica una criatura con la habilidad de volar.\', \'type\': \'Instantáneo\', \'flavor\': \'"¿Qué tal la caza de hoy, mi mascota? Ah, tienes un trozo de vampiro entre los dientes".\\n—Atla Palani, cuidadora de nidos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486042&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'50c35a5b-536c-43dd-a6a4-a85443f1a9ab\', \'multiverseId\': 486042}, \'multiverseid\': 486042}, {\'name\': \'Se battre bec et ongles\', \'text\': "L\'adversaire ciblé sacrifie une créature avec le vol.", \'type\': \'Éphémère\', \'flavor\': "« Qu\'as-tu attrapé aujourd\'hui, mon joli ? Ah, on dirait que tu as un bout de vampire coincé entre les dents. »\\n—Atla Palani, marraine des nids", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486301&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6d610468-1222-4217-8374-f8c046eed4d1\', \'multiverseId\': 486301}, \'multiverseid\': 486301}, {\'name\': \'Abbassare le Ali\', \'text\': \'Un avversario bersaglio sacrifica una creatura con volare.\', \'type\': \'Istantaneo\', \'flavor\': \'"Cos\\\'hai preso oggi, piccolo? Ah, vedo dei pezzetti di vampiro incastrati tra le tue fauci."\\n—Atla Palani, nutrice dei nidi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486560&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2d1924e5-dc0c-4cd5-b179-398c9aed46ca\', \'multiverseId\': 486560}, \'multiverseid\': 486560}, {\'name\': \'巻き添え\', \'text\': \'対戦相手１人を対象とする。そのプレイヤーは飛行を持つクリーチャー１体を生け贄に捧げる。\', \'type\': \'インスタント\', \'flavor\': \'「いい子ね。今日は何を捕まえたの？おや、歯の間に吸血鬼のかけらが挟まっているみたいね。」\\n――巣を守る者、アトラ・パラーニ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486819&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cb99e54a-ef1b-477a-ab2f-21d7b762f0fa\', \'multiverseId\': 486819}, \'multiverseid\': 486819}, {\'name\': \'공중 충돌\', \'text\': \'상대를 목표로 정한다. 그 상대는 비행을 가진 생물 한 개를 희생한다.\', \'type\': \'순간마법\', \'flavor\': \'"오늘은 뭘 잡았니, 귀염둥이야? 아, 보아하니 이빨 사이에 흡혈귀 조각이 좀 끼어 있는 것 같구나."\\n—둥지를 보살피는 자, 아틀라 팔라니\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487078&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f07b6349-1a29-4f3c-a9a6-df02de9e8504\', \'multiverseId\': 487078}, \'multiverseid\': 487078}, {\'name\': \'Encontrar Dificuldades\', \'text\': \'O oponente alvo sacrifica uma criatura com voar.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"O que você pegou hoje, meu bichinho? Ah, parece um pedacinho de vampiro preso nesse dente."\\n— Atla Palani, cuidadora do ninho\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487337&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'91a287a1-de6c-45a9-9fcd-125910816c1f\', \'multiverseId\': 487337}, \'multiverseid\': 487337}, {\'name\': \'Небесное Столкновение\', \'text\': \'Целевой оппонент жертвует существо с Полетом.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Что ты поймал сегодня, малыш? О, у тебя в зубах застрял кусочек вампира».\\n— Атла Палани, хранительница гнезд\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487596&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1ce610ff-82eb-41ab-9f8a-94ec242c983d\', \'multiverseId\': 487596}, \'multiverseid\': 487596}, {\'name\': \'仇人相见\', \'text\': \'目标对手牺牲一个具飞行异能的生物。\', \'type\': \'瞬间\', \'flavor\': \'「你今天逮到了什么东西，我的宝贝？啊，看起来你的牙缝里塞了点吸血鬼。」\\n～护巢人娥拉帕拉尼\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487855&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fad13e11-872a-46e9-8e83-e043e20268f3\', \'multiverseId\': 487855}, \'multiverseid\': 487855}, {\'name\': \'仇人相見\', \'text\': \'目標對手犧牲一個具飛行異能的生物。\', \'type\': \'瞬間\', \'flavor\': \'「你今天逮到了什麼東西，我的寶貝？啊，看起來你的牙縫裡塞了點吸血鬼。」\\n～護巢人娥拉帕拉尼\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488114&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0fda7e6d-84e8-4627-a75a-2e6cc67b6c7b\', \'multiverseId\': 488114}, \'multiverseid\': 488114}]', "[{'name': 'Fesselgeist', 'text': 'Fliegend\\nDer Fesselgeist kann nur fliegende Kreaturen blocken.\\nTappe zwei ungetappte Geister, die du kontrollierst: Tappe eine Kreatur deiner Wahl, die du nicht kontrollierst.', 'type': 'Kreatur — Geist', 'flavor': 'Der gesegnete Schlaf kommt nicht so leicht zu einem Geist, der in Bedauern gefangen ist.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485652&type=card', 'language': 'German', 'identifiers': {'scryfallId': '49f2fdc9-6274-46a3-b2dc-b965a857d2b3', 'multiverseId': 485652}, 'multiverseid': 485652}, {'name': 'Geist encadenado', 'text': 'Vuela.\\nEl Geist encadenado solo puede bloquear a criaturas con la habilidad de volar.\\nGirar dos Espíritus enderezados que controlas: Gira la criatura objetivo que no controlas.', 'type': 'Criatura — Espíritu', 'flavor': 'El Sueño Bendito no llega fácilmente a una mente encadenada por arrepentimientos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485911&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '2cc8ef64-cbe6-4005-8433-7592de1a70bd', 'multiverseId': 485911}, 'multiverseid': 485911}, {'name': 'Geist ferré', 'text': 'Vol\\nLe Geist ferré ne peut bloquer que les créatures avec le vol.\\nEngagez deux esprits dégagés que vous contrôlez : Engagez une créature ciblée que vous ne contrôlez pas.', 'type': 'Créature : esprit', 'flavor': 'Le Sommeil béni ne vient pas facilement à un esprit prisonnier du regret.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486170&type=card', 'language': 'French', 'identifiers': {'scryfallId': '5515bba2-31e8-48c7-b0d2-1307abff48a9', 'multiverseId': 486170}, 'multiverseid': 486170}, {'name': 'Geist Vincolato', 'text': 'Volare\\nIl Geist Vincolato può bloccare solo le creature con volare.\\nTAPpa due Spiriti STAPpati che controlli: TAPpa una creatura bersaglio che non controlli.', 'type': 'Creatura — Spirito', 'flavor': 'Il Sonno Benedetto non arriva facilmente a una mente incatenata dai rimpianti.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486429&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'd36abed5-2167-4c07-9087-8d061e077afe', 'multiverseId': 486429}, 'multiverseid': 486429}, {'name': '鎖霊', 'text': '飛行\\n鎖霊は、飛行を持つクリーチャーのみをブロックできる。\\nあなたがコントロールしていてアンタップ状態のスピリット２体をタップする：あなたがコントロールしていないクリーチャー１体を対象とし、それをタップする。', 'type': 'クリーチャー — スピリット', 'flavor': '後悔の鎖に捕らわれた心が祝福された眠りを得ることは容易ではない。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486688&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '4f9d499d-8a69-4d56-b9af-2b01cc91a85e', 'multiverseId': 486688}, 'multiverseid': 486688}, {'name': '족쇄심령', 'text': '비행\\n족쇄심령은 비행을 가진 생물만 방어할 수 있다.\\n당신이 조종하는 언탭된 신령 두 개를 탭한다: 당신이 조종하지 않는 생물을 목표로 정한다. 그 생물을 탭한다.', 'type': '생물 — 신령', 'flavor': '후회의 사슬에 얽매여 있는 마음에는 축복받은 영면이 쉽사리 찾아오지 않는다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486947&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '27604730-fba9-4581-978a-524f7fb7e17a', 'multiverseId': 486947}, 'multiverseid': 486947}, {'name': 'Geist Agrilhoado', 'text': 'Voar\\nGeist Agrilhoado só pode bloquear criaturas com voar.\\nVire dois Espíritos desvirados que você controla: Vire a criatura alvo que você não controla.', 'type': 'Criatura — Espírito', 'flavor': 'O Sono Abençoado não vem fácil para almas acorrentadas por arrependimentos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487206&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9da0cf73-bd41-4801-8b65-8e81ff66050d', 'multiverseId': 487206}, 'multiverseid': 487206}, {'name': 'Привидение Кандалов', 'text': 'Полет\\nПривидение Кандалов может блокировать только существа с Полетом.\\nПоверните двух неповернутых Духов под вашим контролем: поверните целевое существо не под вашим контролем.', 'type': 'Существо — Дух', 'flavor': 'Благословенный Сон не приходит к разуму в оковах сожалений.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487465&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '9bb6e78b-bd61-47be-8382-5387add94b97', 'multiverseId': 487465}, 'multiverseid': 487465}, {'name': '桎梏游魂', 'text': '飞行\\n桎梏游魂只能阻挡具飞行异能的生物。\\n横置两个由你操控且未横置的精怪：横置目标不由你操控的生物。', 'type': '生物 ～精怪', 'flavor': '心灵遭悔恨束缚者，难享受福安眠。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487724&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '702f21ac-4517-427e-bbe2-9506b884f184', 'multiverseId': 487724}, 'multiverseid': 487724}, {'name': '桎梏遊魂', 'text': '飛行\\n桎梏遊魂只能阻擋具飛行異能的生物。\\n橫置兩個由你操控且未橫置的精靈：橫置目標不由你操控的生物。', 'type': '生物 ～精靈', 'flavor': '心靈遭悔恨束縛者，難享受福安眠。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487983&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '14e789db-f56a-496a-9eee-3a811ff5ae89', 'multiverseId': 487983}, 'multiverseid': 487983}]", '[{\'name\': \'Fesseln des Glaubens\', \'text\': \'Verzaubert eine bleibende Karte\\nWenn die Fesseln des Glaubens ins Spiel kommen, erhältst du 4 Lebenspunkte dazu.\\nDie verzauberte bleibende Karte kann nicht angreifen oder blocken, und ihre aktivierten Fähigkeiten können nicht aktiviert werden, es sei denn, es sind Manafähigkeiten.\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485599&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a08ae80e-a8b3-4a0b-b6ff-7ea99f1f132c\', \'multiverseId\': 485599}, \'multiverseid\': 485599}, {\'name\': \'Grilletes de fe\', \'text\': \'Encantar permanente.\\nCuando los Grilletes de fe entren al campo de batalla, ganas 4 vidas.\\nEl permanente encantado no puede atacar ni bloquear y no pueden activarse sus habilidades activadas, a menos que sean habilidades de maná.\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485858&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0697f7bf-9067-4f95-9caf-030c364ce40c\', \'multiverseId\': 485858}, \'multiverseid\': 485858}, {\'name\': \'Fers de la foi\', \'text\': "Enchanter : permanent\\nQuand les Fers de la foi arrivent sur le champ de bataille, vous gagnez 4 points de vie.\\nLe permanent enchanté ne peut ni attaquer ni bloquer et ses capacités activées ne peuvent pas être activées à moins qu\'elles ne soient des capacités de mana.", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486117&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ac585b98-f46b-440c-a259-4b2b62fe324d\', \'multiverseId\': 486117}, \'multiverseid\': 486117}, {\'name\': \'Pastoie della Fede\', \'text\': \'Incanta permanente\\nQuando le Pastoie della Fede entrano nel campo di battaglia, guadagni 4 punti vita.\\nIl permanente incantato non può attaccare o bloccare e le sue abilità attivate non possono essere attivate a meno che non siano abilità di mana.\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486376&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d5839e44-869c-499e-86da-d332a1acce4a\', \'multiverseId\': 486376}, \'multiverseid\': 486376}, {\'name\': \'信仰の足枷\', \'text\': \'エンチャント（パーマネント）\\n信仰の足枷が戦場に出たとき、あなたは４点のライフを得る。\\nエンチャントしているパーマネントでは攻撃もブロックもできず、それの起動型能力はマナ能力でないかぎり起動できない。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486635&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4269874e-a121-4bc8-9f28-fd4bbef823e2\', \'multiverseId\': 486635}, \'multiverseid\': 486635}, {\'name\': \'신념의 수갑\', \'text\': \'지속물에 부여\\n신념의 수갑이 전장에 들어올 때, 당신은 생명 4점을 얻는다.\\n부여된 지속물은 공격하거나 방어할 수 없으며, 그 지속물의 활성화능력은 마나 능력이 아닌 한 활성화될 수 없다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486894&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'96c77978-8ee9-4bf7-9a29-c89924eeb5ef\', \'multiverseId\': 486894}, \'multiverseid\': 486894}, {\'name\': \'Correntes da Fé\', \'text\': \'Encantar permanente\\nQuando Correntes da Fé entra no campo de batalha, você ganha 4 pontos de vida.\\nA permanente encantada não pode atacar nem bloquear e suas habilidades ativadas não podem ser ativadas, a menos que sejam habilidades de mana.\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487153&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fe4116c5-3342-4519-9972-4ccb054232bc\', \'multiverseId\': 487153}, \'multiverseid\': 487153}, {\'name\': \'Путы Веры\', \'text\': \'Зачаровать перманент\\nКогда Путы Веры выходят на поле битвы, вы получаете 4 жизни.\\nЗачарованный перманент не может атаковать или блокировать, и его активируемые способности не могут быть активированы, если это не мана-способности.\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487412&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2499a748-67fd-4f39-adbd-fae8f890a6c1\', \'multiverseId\': 487412}, \'multiverseid\': 487412}, {\'name\': \'信念拘锁\', \'text\': \'结附于永久物\\n当信念拘锁进战场时，你获得4点生命。\\n所结附的永久物不能进行攻击或阻挡，且除了法术力异能之外，其起动式异能也不能起动。\', \'type\': \'结界 ～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487671&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'39daeac9-08f5-4416-90d1-993072954b33\', \'multiverseId\': 487671}, \'multiverseid\': 487671}, {\'name\': \'信念拘鎖\', \'text\': \'結附於永久物\\n當信念拘鎖進戰場時，你獲得4點生命。\\n所結附的永久物不能進行攻擊或阻擋，且除了魔法力異能之外，其起動式異能也不能起動。\', \'type\': \'結界 ～靈氣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487930&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ab85cf53-91c8-4a98-83b7-3c25b8cadb88\', \'multiverseId\': 487930}, \'multiverseid\': 487930}]', '[{\'name\': \'Feuertöle\', \'text\': \'{1}{R}: Die Feuertöle erhält +2/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Elementarwesen, Hund\', \'flavor\': \'Einige Hunde eignen sich nicht als Haustiere.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485735&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2b524e80-1231-4e40-b361-9a1a52bb3135\', \'multiverseId\': 485735}, \'multiverseid\': 485735}, {\'name\': \'Perro callejero ígneo\', \'text\': \'{1}{R}: El Perro callejero ígneo obtiene +2/+0 hasta el final del turno.\', \'type\': \'Criatura — Perro elemental\', \'flavor\': \'Hay perros que no están hechos para ser mascotas de interior.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485994&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c7a347b1-e15e-4009-b2fc-147d32d83079\', \'multiverseId\': 485994}, \'multiverseid\': 485994}, {\'name\': \'Cabot ignescent\', \'text\': "{1}{R} : Le Cabot ignescent gagne +2/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : élémental et chien\', \'flavor\': "Certains chiens ne sont pas faits pour rester à l\'intérieur.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486253&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'085c4bd0-212c-42bc-8425-86d5a6c77ffe\', \'multiverseId\': 486253}, \'multiverseid\': 486253}, {\'name\': \'Randagio Igneo\', \'text\': \'{1}{R}: Il Randagio Igneo prende +2/+0 fino alla fine del turno.\', \'type\': \'Creatura — Canide Elementale\', \'flavor\': \'Alcuni cani non sono destinati a vivere come animali domestici.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486512&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d10635c6-df7c-4595-85b9-3a10ab0967a0\', \'multiverseId\': 486512}, \'multiverseid\': 486512}, {\'name\': \'炎血の野犬\', \'text\': \'{1}{R}：ターン終了時まで、炎血の野犬は＋２/＋０の修整を受ける。\', \'type\': \'クリーチャー — エレメンタル・犬\', \'flavor\': \'室内飼いに向かない犬もいる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486771&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'31b91df0-52ab-4f8d-b1dc-e452a5b3f520\', \'multiverseId\': 486771}, \'multiverseid\': 486771}, {\'name\': \'불타오르는 광견\', \'text\': \'{1}{R}: 불타오르는 광견은 턴종료까지 +2/+0을 받는다.\', \'type\': \'생물 — 정령 개\', \'flavor\': \'어떤 개들은 그냥 집 안에서 기를 수가 없게 태어난다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487030&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'da720420-c15b-4396-83dc-a2a174fd0854\', \'multiverseId\': 487030}, \'multiverseid\': 487030}, {\'name\': \'Cão Ígneo\', \'text\': \'{1}{R}: Cão Ígneo recebe +2/+0 até o final do turno.\', \'type\': \'Criatura — Elemental Cão\', \'flavor\': \'Alguns cães não nasceram para ficar dentro de casa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487289&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7058b3f1-f161-49f2-86a9-77ed788fe9f9\', \'multiverseId\': 487289}, \'multiverseid\': 487289}, {\'name\': \'Огневая Псина\', \'text\': \'{1}{R}: Огневая Псина получает +2/+0 до конца хода.\', \'type\': \'Существо — Элементаль Собака\', \'flavor\': \'Некоторым собакам вход в дом заказан.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487548&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bd633953-f84e-4210-91ce-c8dcd5058ee9\', \'multiverseId\': 487548}, \'multiverseid\': 487548}, {\'name\': \'火热杂狗\', \'text\': \'{1}{R}：火热杂狗得+2/+0直到回合结束。\', \'type\': \'生物 ～元素／狗\', \'flavor\': \'有些狗就是不适合养在家里当宠物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487807&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a3f40b6d-7241-479b-b8ff-9a8a773a5617\', \'multiverseId\': 487807}, \'multiverseid\': 487807}, {\'name\': \'火熱雜狗\', \'text\': \'{1}{R}：火熱雜狗得+2/+0直到回合結束。\', \'type\': \'生物 ～元素／狗\', \'flavor\': \'有些狗就是不適合養在家裡當寵物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488066&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'487778a7-d041-4d59-96f2-7686f6b2a9fd\', \'multiverseId\': 488066}, \'multiverseid\': 488066}]', '[{\'name\': \'Flammenkippende Teufel\', \'text\': \'Wenn die Flammenkippenden Teufel sterben, fügen sie einem Ziel deiner Wahl 3 Schadenspunkte zu.\', \'type\': \'Kreatur — Teufel\', \'flavor\': \'So genial wie Goblins, so verdorben wie Dämonen und so klug wie Schafe.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485738&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ef25edd3-027d-4e31-9313-3d70719f6f53\', \'multiverseId\': 485738}, \'multiverseid\': 485738}, {\'name\': \'Diablos arrojafuego\', \'text\': \'Cuando los Diablos arrojafuego mueran, hacen 3 puntos de daño a cualquier objetivo.\', \'type\': \'Criatura — Diablo\', \'flavor\': \'El ingenio de los trasgos, la depravación de los demonios y la inteligencia de las ovejas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485997&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2ada9770-1dd8-4009-af87-cba44588626b\', \'multiverseId\': 485997}, \'multiverseid\': 485997}, {\'name\': \'Diables brûlegoudron\', \'text\': "Quand les Diables brûlegoudron meurent, ils infligent 3 blessures à n\'importe quelle cible.", \'type\': \'Créature : diable\', \'flavor\': "L\'ingéniosité d\'un gobelin, la dépravation d\'un démon et l\'intelligence d\'un mouton.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486256&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2a9d9dbf-48ad-4140-a1ae-9eb2eef3f6a8\', \'multiverseId\': 486256}, \'multiverseid\': 486256}, {\'name\': \'Diavoli Bruciapece\', \'text\': \'Quando i Diavoli Bruciapece muoiono, infliggono 3 danni a un qualsiasi bersaglio.\', \'type\': \'Creatura — Diavolo\', \'flavor\': "L\'inventiva dei goblin, la depravazione dei demoni e l\'acume delle pecore.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486515&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9ddae56a-e64c-4884-a526-7c72c959cb4e\', \'multiverseId\': 486515}, \'multiverseid\': 486515}, {\'name\': \'燃え投げの小悪魔\', \'text\': \'燃え投げの小悪魔が死亡したとき、クリーチャー１体かプレインズウォーカー１体かプレイヤー１人を対象とする。これはそれに３点のダメージを与える。\', \'type\': \'クリーチャー — デビル\', \'flavor\': \'ゴブリンの創意工夫、悪魔の堕落、羊の知性。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486774&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1b8daeb5-c763-46ea-8a6f-518c483cac6a\', \'multiverseId\': 486774}, \'multiverseid\': 486774}, {\'name\': \'역청화염 악령들\', \'text\': \'역청화염 악령들이 죽을 때, 원하는 목표를 정한다. 역청화염 악령들은 그 목표에게 피해 3점을 입힌다.\', \'type\': \'생물 — 악령\', \'flavor\': \'고블린의 기발함, 악마의 사악함, 양의 지능.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487033&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'38c173e4-a103-481b-81b6-dacd9096e610\', \'multiverseId\': 487033}, \'multiverseid\': 487033}, {\'name\': \'Diabos Queimados de Piche\', \'text\': \'Quando morre, Diabos Queimados de Piche causa 3 pontos de dano a qualquer alvo.\', \'type\': \'Criatura — Diabo\', \'flavor\': \'A criatividade dos goblins, a depravação dos demônios e a esperteza das ovelhas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487292&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'90b7b282-d5d2-4a9a-b19d-8af209b106bc\', \'multiverseId\': 487292}, \'multiverseid\': 487292}, {\'name\': \'Дьяволы Горящей Смолы\', \'text\': \'Когда Дьяволы Горящей Смолы умирают, они наносят 3 повреждения любой цели.\', \'type\': \'Существо — Дьявол\', \'flavor\': \'Изобретательность гоблина, извращенность демона, интеллект барана.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487551&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d2754d15-4984-40d0-a102-7f7db8ee0a9c\', \'multiverseId\': 487551}, \'multiverseid\': 487551}, {\'name\': \'燃沥青魔鬼\', \'text\': \'当燃沥青魔鬼死去时，它对任意一个目标造成3点伤害。\', \'type\': \'生物 ～魔鬼\', \'flavor\': \'鬼怪的才智，恶魔的邪恶，以及羔羊的痛苦。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487810&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'90796a6f-0f70-4c2e-88e9-6e6808f17075\', \'multiverseId\': 487810}, \'multiverseid\': 487810}, {\'name\': \'燃瀝青魔鬼\', \'text\': \'當燃瀝青魔鬼死去時，它對任意一個目標造成3點傷害。\', \'type\': \'生物 ～魔鬼\', \'flavor\': \'鬼怪的才智，惡魔的邪惡，以及羔羊的痛苦。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488069&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1394d71a-2e18-4a20-897d-aed4458ef7d5\', \'multiverseId\': 488069}, \'multiverseid\': 488069}]', '[{\'name\': \'Flugdrachen-Freibeuterin\', \'text\': \'Fliegend\\nWenn die Flugdrachen-Freibeuterin ins Spiel kommt, zeigt ein Gegner deiner Wahl die Karten auf seiner Hand offen vor. Du bestimmst davon eine Karte, die weder eine Kreatur noch ein Land ist. Schicke die bestimmte Karte ins Exil, bis die Flugdrachen-Freibeuterin das Spiel verlässt.\', \'type\': \'Kreatur — Mensch, Pirat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485689&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6769ce3b-794a-4b6b-8c4f-86cb5d6a364b\', \'multiverseId\': 485689}, \'multiverseid\': 485689}, {\'name\': \'Bandida velacometa\', \'text\': \'Vuela.\\nCuando la Bandida velacometa entre al campo de batalla, el oponente objetivo muestra su mano. Tú eliges de ahí una carta que no sea tierra ni criatura. Exilia esa carta hasta que la Bandida velacometa deje el campo de batalla.\', \'type\': \'Criatura — Pirata humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485948&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'aae78464-a0fd-4425-aa10-13ca92160e83\', \'multiverseId\': 485948}, \'multiverseid\': 485948}, {\'name\': \'Flibustière à voile volante\', \'text\': "Vol\\nQuand la Flibustière à voile volante arrive sur le champ de bataille, l\'adversaire ciblé révèle sa main. Vous y choisissez une carte non-créature, non-terrain. Exilez cette carte jusqu\'à ce que la Flibustière à voile volante quitte le champ de bataille.", \'type\': \'Créature : humain et pirate\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486207&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ac22715e-e9db-4a45-99a7-4ea8cb779cec\', \'multiverseId\': 486207}, \'multiverseid\': 486207}, {\'name\': \'Filibustiera del Velaliante\', \'text\': \'Volare\\nQuando la Filibustiera del Velaliante entra nel campo di battaglia, un avversario bersaglio rivela la sua mano. Scegli una carta non terra, non creatura da quella mano. Esilia quella carta finché la Filibustiera del Velaliante non lascia il campo di battaglia.\', \'type\': \'Creatura — Pirata Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486466&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cc4c91be-4eaa-4666-8dec-c29b7ac55e27\', \'multiverseId\': 486466}, \'multiverseid\': 486466}, {\'name\': \'帆凧の掠め盗り\', \'text\': \'飛行\\n帆凧の掠め盗りが戦場に出たとき、対戦相手１人を対象とする。そのプレイヤーは自分の手札を公開する。あなたはその中からクリーチャーでも土地でもないカード１枚を選ぶ。帆凧の掠め盗りが戦場を離れるまで、そのカードを追放する。\', \'type\': \'クリーチャー — 人間・海賊\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486725&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cbf0d8a3-b185-4a22-89f9-7e5a215e41f2\', \'multiverseId\': 486725}, \'multiverseid\': 486725}, {\'name\': \'연글라이더 탈취자\', \'text\': \'비행\\n연글라이더 탈취자가 전장에 들어올 때, 상대를 목표로 정한다. 그 상대는 자신의 손을 공개한다. 당신은 그중 생물이 아니고 대지가 아닌 카드 한 장을 선택한다. 연글라이더 탈취자가 전장을 떠날 때까지 그 카드를 추방한다.\', \'type\': \'생물 — 인간 해적\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486984&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'aae6798b-506d-4374-9334-e2ca6f15c8f6\', \'multiverseId\': 486984}, \'multiverseid\': 486984}, {\'name\': \'Pirata de Aeroveleiro\', \'text\': \'Voar\\nQuando Pirata de Aeroveleiro entra no campo de batalha, o oponente alvo revela sua própria mão. Você escolhe um card que não seja um terreno nem uma criatura da mão dele. Exile aquele card até Pirata de Aeroveleiro deixar o campo de batalha.\', \'type\': \'Criatura — Humano Pirata\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487243&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d619b0de-6f94-404f-b0d3-9db14a473e5c\', \'multiverseId\': 487243}, \'multiverseid\': 487243}, {\'name\': \'Воздушный Флибустьер\', \'text\': \'Полет\\nКогда Воздушный Флибустьер выходит на поле битвы, целевой оппонент показывает свою руку. Вы выбираете из нее карту, не являющуюся ни существом, ни землей. Изгоните ту карту до тех пор, пока Воздушный Флибустьер не покинет поле битвы.\', \'type\': \'Существо — Человек Пират\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487502&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8e20f40e-d25a-4c4d-bd1f-51483b7696df\', \'multiverseId\': 487502}, \'multiverseid\': 487502}, {\'name\': \'航筝掠盗\', \'text\': \'飞行\\n当航筝掠盗进战场时，目标对手展示其手牌。你选择其中一张非生物且非地的牌。放逐该牌，直到航筝掠盗离开战场为止。\', \'type\': \'生物 ～人类／海盗\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487761&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ea15290f-f8d2-4363-8b3a-78b8f3fd095d\', \'multiverseId\': 487761}, \'multiverseid\': 487761}, {\'name\': \'航箏掠盜\', \'text\': \'飛行\\n當航箏掠盜進戰場時，目標對手展示其手牌。你選擇其中一張非生物且非地的牌。放逐該牌，直到航箏掠盜離開戰場為止。\', \'type\': \'生物 ～人類／海盜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488020&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'eefabcf7-d27e-4a71-9f4b-061c5589d5be\', \'multiverseId\': 488020}, \'multiverseid\': 488020}]', "[{'name': 'Flutgleiter', 'text': 'Fliegend\\nImmer wenn du mit zwei oder mehr fliegenden Kreaturen angreifst, ziehe eine Karte.', 'type': 'Kreatur — Sceada', 'flavor': 'Fischerboote folgen oft jagenden Sceadas, um die größten Fischschwärme zu finden.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485661&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2a17d758-2370-478a-a831-49632d9d4979', 'multiverseId': 485661}, 'multiverseid': 485661}, {'name': 'Rayaolas', 'text': 'Vuela.\\nSiempre que ataques con dos o más criaturas con la habilidad de volar, roba una carta.', 'type': 'Criatura — Draco', 'flavor': 'Los barcos pesqueros suelen seguir a los dracos que cazan para encontrar los bancos de peces más grandes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485920&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '8cc0b2fe-5f63-4703-81ed-a875ad68fd41', 'multiverseId': 485920}, 'multiverseid': 485920}, {'name': 'Écumeur du ressac', 'text': 'Vol\\nÀ chaque fois que vous attaquez avec au moins deux créatures avec le vol, piochez une carte.', 'type': 'Créature : drakôn', 'flavor': 'Les bateaux de pêche suivent souvent les drakôns en chasse pour trouver les plus gros bancs de poissons.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486179&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a0edd5d8-c80b-4714-8dd4-55d398e21333', 'multiverseId': 486179}, 'multiverseid': 486179}, {'name': 'Sorvolatore delle Maree', 'text': 'Volare\\nOgniqualvolta attacchi con due o più creature con volare, pesca una carta.', 'type': 'Creatura — Draghetto', 'flavor': 'Spesso le barche dei pescatori seguono i draghetti a caccia per trovare i banchi di pesci più grandi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486438&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '504c748a-52c6-496d-b182-6ed93a2877de', 'multiverseId': 486438}, 'multiverseid': 486438}, {'name': '潮掬い', 'text': '飛行\\nあなたが飛行を持つクリーチャー２体以上で攻撃するたび、カードを１枚引く。', 'type': 'クリーチャー — ドレイク', 'flavor': '釣り船はよくドレイクの捕食の後を追う。最大の魚群が見つかるからだ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486697&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '4764606e-c8a8-44cd-96a2-b36273838577', 'multiverseId': 486697}, 'multiverseid': 486697}, {'name': '파도를 스치는 드레이크', 'text': '비행\\n당신이 비행을 가진 생물 두 개 이상으로 공격할 때마다, 카드 한 장을 뽑는다.', 'type': '생물 — 드레이크', 'flavor': '낚싯배들은 종종 사냥 중인 드레이크들을 따라가 더 많은 물고기들을 찾아낸다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486956&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '69177237-163f-4251-bafa-6bb317bf0b1f', 'multiverseId': 486956}, 'multiverseid': 486956}, {'name': 'Corta-água da Maré', 'text': 'Voar\\nToda vez que você atacar com duas ou mais criaturas com voar, compre um card.', 'type': 'Criatura — Dragonete', 'flavor': 'Os barcos pesqueiros muitas vezes seguem os dragonetes à caça para encontrar os maiores cardumes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487215&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'cc7aadbf-4da4-46ff-a33d-8afcc5de0841', 'multiverseId': 487215}, 'multiverseid': 487215}, {'name': 'Летун Приливов', 'text': 'Полет\\nКаждый раз, когда вы атакуете двумя или более существами с Полетом, возьмите карту.', 'type': 'Существо — Дрейк', 'flavor': 'Рыбацкие лодки зачастую следуют за охотящимися дрейками, чтобы найти самые большие рыбные косяки.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487474&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '5069f3aa-119a-4830-8662-aa99f8c6181a', 'multiverseId': 487474}, 'multiverseid': 487474}, {'name': '掠浪飞兽', 'text': '飞行\\n每当你以两个或更多具飞行异能的生物攻击时，抓一张牌。', 'type': '生物 ～龙兽', 'flavor': '渔船常常跟在行猎龙兽后面，这样便能找到渔获量最大的鱼群。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487733&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '217b4319-7ebf-4c00-a023-e5d17206e81b', 'multiverseId': 487733}, 'multiverseid': 487733}, {'name': '掠浪飛獸', 'text': '飛行\\n每當你以兩個或更多具飛行異能的生物攻擊時，抽一張牌。', 'type': '生物 ～龍獸', 'flavor': '漁船常常跟在行獵龍獸後面，這樣便能找到漁獲量最大的魚群。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487992&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '2481f86b-7523-47ae-8c1e-da97e2dde4ca', 'multiverseId': 487992}, 'multiverseid': 487992}]", "[{'name': 'Fouineur flagrant', 'text': 'Jouez avec la carte du dessus de votre bibliothèque révélée.\\nVous pouvez lancer des sorts de gobelin depuis le dessus de votre bibliothèque.\\nTant que la carte du dessus de votre bibliothèque est une carte de gobelin, le Fouineur flagrant a toutes les capacités activées de cette carte.', 'type': 'Créature : gobelin et gredin', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488315&type=card', 'language': 'French', 'identifiers': {'scryfallId': '1a6ae222-b541-4412-b7a0-3da3ec5cc7fc', 'multiverseId': 488315}, 'multiverseid': 488315}, {'name': '人目を引く詮索者', 'text': 'あなたのライブラリーの一番上のカードを公開したままプレイする。\\nあなたはあなたのライブラリーの一番上からゴブリン・呪文を唱えてもよい。\\nあなたのライブラリーの一番上のカードがゴブリン・カードであるかぎり、人目を引く詮索者はそのカードの起動型能力をすべて持つ。', 'type': 'クリーチャー — ゴブリンならず者', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488367&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '42923b55-5562-4ed7-a61c-c08966b938ff', 'multiverseId': 488367}, 'multiverseid': 488367}]", '[{\'name\': \'Frecher Stichler\', \'text\': \'Unzerstörbar\\nImmer wenn dem Frechen Stichler Schaden zugefügt wird, fügt er einem Gegner deiner Wahl entsprechend viele Schadenspunkte zu.\\n{2}{R}, {T}: Der Freche Stichler kämpft gegen eine andere Kreatur deiner Wahl.\', \'type\': \'Kreatur — Goblin\', \'flavor\': \'„Du schlägst zu wie ein Kobold!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485715&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'10325523-5023-4631-82e3-5da1d61efbd3\', \'multiverseId\': 485715}, \'multiverseid\': 485715}, {\'name\': \'Burlón intrépido\', \'text\': \'Indestructible.\\nSiempre que el Burlón intrépido reciba daño, hace esa misma cantidad de daño al oponente objetivo.\\n{2}{R}, {T}: El Burlón intrépido lucha contra otra criatura objetivo.\', \'type\': \'Criatura — Trasgo\', \'flavor\': \'"¡Pegas como un kóbold!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485974&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'de3b6231-4a2f-48d2-bb61-b27b7254f95f\', \'multiverseId\': 485974}, \'multiverseid\': 485974}, {\'name\': \'Taquineur effronté\', \'text\': "Indestructible\\nÀ chaque fois que le Taquineur effronté subit des blessures, il inflige autant de blessures à l\'adversaire ciblé.\\n{2}{R}, {T} : Le Taquineur effronté se bat contre une autre créature ciblée.", \'type\': \'Créature : gobelin\', \'flavor\': \'« Tu tapes comme un kobold ! »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486233&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'63788367-0031-4dbe-b918-f280bfff4cc5\', \'multiverseId\': 486233}, \'multiverseid\': 486233}, {\'name\': \'Istigatore Sfrontato\', \'text\': "Indistruttibile\\nOgniqualvolta viene inflitto danno all\'Istigatore Sfrontato, esso infligge altrettanti danni a un avversario bersaglio.\\n{2}{R}, {T}: L\'Istigatore Sfrontato lotta con un\'altra creatura bersaglio.", \'type\': \'Creatura — Goblin\', \'flavor\': \'"Combatti come un coboldo!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486492&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'86404bad-b4a0-4bf5-ac8c-aa8dd1c76517\', \'multiverseId\': 486492}, \'multiverseid\': 486492}, {\'name\': \'無作法な挑発者\', \'text\': \'破壊不能\\n無作法な挑発者がダメージを受けるたび、対戦相手１人を対象とする。これはそのプレイヤーに、その点数に等しい点数のダメージを与える。\\n{2}{R}, {T}：他のクリーチャー１体を対象とする。無作法な挑発者はそれと格闘を行う。\', \'type\': \'クリーチャー — ゴブリン\', \'flavor\': \'「コボルドみてぇに叩きやがったな！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486751&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'25c89893-37cc-4dd8-b99c-d1f56b8a8bfb\', \'multiverseId\': 486751}, \'multiverseid\': 486751}, {\'name\': \'자신만만한 조롱꾼\', \'text\': \'무적\\n자신만만한 조롱꾼이 피해를 입을 때마다, 상대를 목표로 정한다. 자신만만한 조롱꾼은 그 상대에게 그만큼의 피해를 입힌다.\\n{2}{R}, {T}: 다른 생물을 목표로 정한다. 자신만만한 조롱꾼은 그 생물과 싸운다.\', \'type\': \'생물 — 고블린\', \'flavor\': \'"넌 때리는 폼새가 꼭 코볼드를 닮았구나!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487010&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'88617fd6-440e-4c82-9d73-ffb5491768a1\', \'multiverseId\': 487010}, \'multiverseid\': 487010}, {\'name\': \'Provocador Petulante\', \'text\': \'Indestrutível\\nToda vez que Provocador Petulante sofre dano, ele causa a mesma quantidade de dano ao oponente alvo.\\n{2}{R}, {T}: Provocador Petulante luta contra outra criatura alvo.\', \'type\': \'Criatura — Goblin\', \'flavor\': \'"Você bate como um kobold!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487269&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b71857a8-fccd-401f-b3bf-b4a38e1e092f\', \'multiverseId\': 487269}, \'multiverseid\': 487269}, {\'name\': \'Язвительный Насмешник\', \'text\': \'Неразрушимость\\nКаждый раз, когда Язвительному Насмешнику наносятся повреждения, он наносит столько же повреждений целевому оппоненту.\\n{2}{R}, {T}: Язвительный Насмешник дерется с другим целевым существом.\', \'type\': \'Существо — Гоблин\', \'flavor\': \'«Ты дерешься, как кобольд!»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487528&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8d152684-3503-4ed2-ac7c-ac9b6b026dfc\', \'multiverseId\': 487528}, \'multiverseid\': 487528}, {\'name\': \'鲁莽挑发鬼\', \'text\': \'不灭\\n每当鲁莽挑发鬼受到伤害时，它向目标对手造成等量的伤害。\\n{2}{R}，{T}：鲁莽挑发鬼与另一个目标生物互斗。\', \'type\': \'生物 ～鬼怪\', \'flavor\': \'「你就跟鬼崽没两样！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487787&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e440c3c6-eafe-4f61-8e87-ed6186613c8d\', \'multiverseId\': 487787}, \'multiverseid\': 487787}, {\'name\': \'魯莽挑發鬼\', \'text\': \'不滅\\n每當魯莽挑發鬼受到傷害時，它向目標對手造成等量的傷害。\\n{2}{R}，{T}：魯莽挑發鬼與另一個目標生物互鬥。\', \'type\': \'生物 ～鬼怪\', \'flavor\': \'「你就跟鬼崽沒兩樣！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488046&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'18de40bd-5556-4da5-8f89-3412fa04e889\', \'multiverseId\': 488046}, \'multiverseid\': 488046}]', "[{'name': 'Friedliche Bucht', 'text': 'Die Friedliche Bucht kommt getappt ins Spiel.\\nWenn die Friedliche Bucht ins Spiel kommt, erhältst du 1 Lebenspunkt dazu.\\n{T}: Erzeuge {W} oder {U}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485840&type=card', 'language': 'German', 'identifiers': {'scryfallId': '58c1b826-fd61-4663-83d2-9bf5508fb21b', 'multiverseId': 485840}, 'multiverseid': 485840}, {'name': 'Cala tranquila', 'text': 'La Cala tranquila entra al campo de batalla girada.\\nCuando la Cala tranquila entre al campo de batalla, ganas 1 vida.\\n{T}: Agrega {W} o {U}.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486099&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ce9c199b-03c2-420e-ab29-fde0fd4a2b4b', 'multiverseId': 486099}, 'multiverseid': 486099}, {'name': 'Crique tranquille', 'text': 'La Crique tranquille arrive sur le champ de bataille engagée.\\nQuand la Crique tranquille arrive sur le champ de bataille, vous gagnez 1 point de vie.\\n{T} : Ajoutez {W} ou {U}.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486358&type=card', 'language': 'French', 'identifiers': {'scryfallId': '7389991b-d547-47ae-a74b-477d2cf00272', 'multiverseId': 486358}, 'multiverseid': 486358}, {'name': 'Baia Tranquilla', 'text': 'La Baia Tranquilla entra nel campo di battaglia TAPpata.\\nQuando la Baia Tranquilla entra nel campo di battaglia, guadagni 1 punto vita.\\n{T}: Aggiungi {W} o {U}.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486617&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '6a40079b-0490-4638-b9bf-6e42f8063347', 'multiverseId': 486617}, 'multiverseid': 486617}, {'name': '平穏な入り江', 'text': '平穏な入り江はタップ状態で戦場に出る。\\n平穏な入り江が戦場に出たとき、あなたは１点のライフを得る。\\n{T}：{W}か{U}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486876&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'a4cce45c-bfbb-4c80-93c3-e429a4a534fe', 'multiverseId': 486876}, 'multiverseid': 486876}, {'name': '잔잔한 만', 'text': '잔잔한 만은 탭된 채로 전장에 들어온다.\\n잔잔한 만이 전장에 들어올 때, 당신은 생명 1점을 얻는다.\\n{T}: {W} 또는 {U}를 추가한다.', 'type': '대지', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487135&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'c125c1ef-4a2d-4687-abb2-2326c9b1c217', 'multiverseId': 487135}, 'multiverseid': 487135}, {'name': 'Angra Tranquila', 'text': 'Angra Tranquila entra no campo de batalha virada.\\nQuando Angra Tranquila entra no campo de batalha, você ganha 1 ponto de vida.\\n{T}: Adicione {W} ou {U}.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487394&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fc68a33b-8f7c-4c9e-a9c3-5485b54acad4', 'multiverseId': 487394}, 'multiverseid': 487394}, {'name': 'Тихая Бухта', 'text': 'Тихая Бухта выходит на поле битвы повернутой.\\nКогда Тихая Бухта выходит на поле битвы, вы получаете 1 жизнь.\\n{T}: добавьте {W} или {U}.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487653&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '4870b29c-8a43-4a67-b23b-173947b88cee', 'multiverseId': 487653}, 'multiverseid': 487653}, {'name': '静谧海湾', 'text': '静谧海湾须横置进战场。\\n当静谧海湾进战场时，你获得1点生命。\\n{T}：加{W}或{U}。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487912&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'da65b67f-652f-47fa-b1f1-fbb5b9eb2c1e', 'multiverseId': 487912}, 'multiverseid': 487912}, {'name': '靜謐海灣', 'text': '靜謐海灣須橫置進戰場。\\n當靜謐海灣進戰場時，你獲得1點生命。\\n{T}：加{W}或{U}。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488171&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '07f21b60-8b5f-4419-8980-809253300bfe', 'multiverseId': 488171}, 'multiverseid': 488171}]", '[{\'name\': \'Frosthauch\', \'text\': \'Tappe bis zu zwei Kreaturen deiner Wahl. Sie enttappen nicht während des nächsten Enttappsegments ihrer Beherrscher.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ich bastle mit deinen Knochen ein Windspiel aus Eis."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485633&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4ee11c17-7133-46b1-908f-dae90408ae0e\', \'multiverseId\': 485633}, \'multiverseid\': 485633}, {\'name\': \'Aliento escarchado\', \'text\': \'Gira hasta dos criaturas objetivo. Esas criaturas no se enderezan durante el próximo paso de enderezar de su controlador.\', \'type\': \'Instantáneo\', \'flavor\': \'"Haré campanillas de hielo con tus huesos".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485892&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bf0c2a75-d523-4988-be75-3b95a6994b08\', \'multiverseId\': 485892}, \'multiverseid\': 485892}, {\'name\': \'Souffle de givre\', \'text\': "Engagez jusqu\'à deux créatures ciblées. Ces créatures ne se dégagent pas pendant la prochaine étape de dégagement de leur contrôleur.", \'type\': \'Éphémère\', \'flavor\': \'« Tes os gelés carillonneront dans le vent. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486151&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5bbb0bd7-0cd9-4add-bce1-f9929841fe8f\', \'multiverseId\': 486151}, \'multiverseid\': 486151}, {\'name\': \'Soffio Gelato\', \'text\': \'TAPpa fino a due creature bersaglio. Quelle creature non STAPpano durante il prossimo STAP del loro controllore.\', \'type\': \'Istantaneo\', \'flavor\': \'"Con le tue ossa farò campanelli di ghiaccio."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486410&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'41f9dc14-e60c-488a-bc8c-d1fd5e5934ee\', \'multiverseId\': 486410}, \'multiverseid\': 486410}, {\'name\': \'霜のブレス\', \'text\': \'クリーチャー最大２体を対象とし、それらをタップする。それらのクリーチャーは、それらのコントローラーの次のアンタップ・ステップにアンタップしない。\', \'type\': \'インスタント\', \'flavor\': \'「お前の骨で氷のチャイムを作ってやるよ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486669&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'98dedac5-ccd7-42a6-b843-83c4f502ef2a\', \'multiverseId\': 486669}, \'multiverseid\': 486669}, {\'name\': \'서리입김\', \'text\': \'생물을 최대 두 개까지 목표로 정한다. 그 생물들을 탭한다. 그 생물들은 조종자의 다음 언탭단에 언탭되지 않는다.\', \'type\': \'순간마법\', \'flavor\': \'"네 뼈가 얼어붙는 소리를 들려주마."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486928&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'47ac22b0-dd2f-40a0-ade9-bbe3d04334b4\', \'multiverseId\': 486928}, \'multiverseid\': 486928}, {\'name\': \'Hálito Congelador\', \'text\': \'Vire até duas criaturas alvo. Aquelas criaturas não são desviradas durante a próxima etapa de desvirar de seus controladores.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Vou fazer um carrilhão de gelo com seus ossos."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487187&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0e2a3f67-c666-4b9e-8335-7cdb25e37271\', \'multiverseId\': 487187}, \'multiverseid\': 487187}, {\'name\': \'Морозное Дыхание\', \'text\': \'Поверните не более двух целевых существ. Те существа не разворачиваются во время следующего шага разворота контролирующего их игрока.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Твои обледенелые кости будут издавать мелодичный перезвон на ветру».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487446&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e155f7ca-333b-417d-9b33-ce155bf4e2e1\', \'multiverseId\': 487446}, \'multiverseid\': 487446}, {\'name\': \'霜息\', \'text\': \'横置至多两个目标生物。这些生物于其操控者的下一个重置步骤中不能重置。\', \'type\': \'瞬间\', \'flavor\': \'「我要把你的骨头冻成冰当钟敲。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487705&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ea6bd0e4-105c-4bc3-8cb4-7f6209cdc504\', \'multiverseId\': 487705}, \'multiverseid\': 487705}, {\'name\': \'霜息\', \'text\': \'橫置至多兩個目標生物。這些生物於其操控者的下一個重置步驟中不能重置。\', \'type\': \'瞬間\', \'flavor\': \'「我要把你的骨頭凍成冰當鐘敲。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487964&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'181c0d3d-2a1e-4ca4-a974-ddb87186b322\', \'multiverseId\': 487964}, \'multiverseid\': 487964}]', '[{\'name\': \'Funkenjäger-Mastikor\', \'text\': \'Wirf als zusätzliche Kosten, um diesen Zauberspruch zu wirken, eine Karte ab.\\nSchutz vor Planeswalkern\\n{1}: Der Funkenjäger-Mastikor fügt einem Planeswalker deiner Wahl 1 Schadenspunkt zu.\\n{3}: Der Funkenjäger-Mastikor erhält Unzerstörbarkeit bis zum Ende des Zuges.\', \'type\': \'Artefaktkreatur — Mastikor\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485822&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ae102ede-0915-443d-b3a3-d50e59994ebd\', \'multiverseId\': 485822}, \'multiverseid\': 485822}, {\'name\': \'Masticore cazachispas\', \'text\': \'Como coste adicional para lanzar este hechizo, descarta una carta.\\nProtección contra planeswalkers.\\n{1}: La Masticore cazachispas hace 1 punto de daño al planeswalker objetivo.\\n{3}: La Masticore cazachispas gana la habilidad de indestructible hasta el final del turno.\', \'type\': \'Criatura artefacto — Masticore\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486081&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6302befb-30eb-4aba-b85b-f0989e1c3ac2\', \'multiverseId\': 486081}, \'multiverseid\': 486081}, {\'name\': "Masticore traqueuse d\'étincelle", \'text\': "En tant que coût supplémentaire pour lancer ce sort, défaussez-vous d\'une carte.\\nProtection contre les planeswalkers\\n{1} : La Masticore traqueuse d\'étincelle inflige 1 blessure à un planeswalker ciblé.\\n{3} : La Masticore traqueuse d\'étincelle acquiert l\'indestructible jusqu\'à la fin du tour.", \'type\': \'Créature-artefact : masticore\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486340&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'74adcb88-1535-43d4-b9e6-2797c04fa9b5\', \'multiverseId\': 486340}, \'multiverseid\': 486340}, {\'name\': \'Masticora Cacciascintille\', \'text\': \'Come costo addizionale per lanciare questa magia, scarta una carta.\\nProtezione dai planeswalker\\n{1}: La Masticora Cacciascintille infligge 1 danno a un planeswalker bersaglio.\\n{3}: La Masticora Cacciascintille ha indistruttibile fino alla fine del turno.\', \'type\': \'Creatura Artefatto — Masticora\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486599&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d721882c-603f-4850-87c5-9b022135e0c9\', \'multiverseId\': 486599}, \'multiverseid\': 486599}, {\'name\': \'灯狩人のマスティコア\', \'text\': \'この呪文を唱えるための追加コストとして、カード１枚を捨てる。\\nプロテクション（プレインズウォーカー）\\n{1}：プレインズウォーカー１体を対象とする。灯狩人のマスティコアはそれに１点のダメージを与える。\\n{3}：ターン終了時まで、灯狩人のマスティコアは破壊不能を得る。\', \'type\': \'アーティファクト・クリーチャー — マスティコア\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486858&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e7f1c64f-a067-4e56-b060-530c39c180e8\', \'multiverseId\': 486858}, \'multiverseid\': 486858}, {\'name\': \'불꽃사냥꾼 마스티코어\', \'text\': \'이 주문을 발동하기 위한 추가비용으로, 카드 한 장을 버린다.\\n플레인즈워커로부터 보호\\n{1}: 플레인즈워커를 목표로 정한다. 불꽃사냥꾼 마스티코어는 그 플레인즈워커에게 피해 1점을 입힌다.\\n{3}: 불꽃사냥꾼 마스티코어는 턴종료까지 무적을 얻는다.\', \'type\': \'마법물체 생물 — 마스티코어\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487117&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'47edb9ef-6d68-4e93-8af9-d9eacf1fbeff\', \'multiverseId\': 487117}, \'multiverseid\': 487117}, {\'name\': \'Mastícora Caça-centelhas\', \'text\': \'Como custo adicional para conjurar esta mágica, descarte um card.\\nProteção contra planeswalkers\\n{1}: Mastícora Caça-centelhas causa 1 ponto de dano ao planeswalker alvo.\\n{3}: Mastícora Caça-centelhas ganha indestrutível até o final do turno.\', \'type\': \'Criatura Artefato — Mastícora\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487376&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'940748ae-02cd-4199-aea9-766382f7c4ae\', \'multiverseId\': 487376}, \'multiverseid\': 487376}, {\'name\': \'Мастикора, Охотница на Искры\', \'text\': "В качестве дополнительной стоимости разыгрывания этого заклинания сбросьте карту.\\nЗащита от planeswalker\'ов\\n{1}: Мастикора, Охотница на Искры наносит 1 повреждение целевому planeswalker\'у.\\n{3}: Мастикора, Охотница на Искры получает Неразрушимость до конца хода.", \'type\': \'Артефакт Существо — Мастикора\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487635&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'21aa39ac-4c97-4449-8c98-3641f5c838dd\', \'multiverseId\': 487635}, \'multiverseid\': 487635}, {\'name\': \'猎火花异狮\', \'text\': \'弃一张牌，以作为施放此咒语的额外费用。\\n反鹏洛客保护\\n{1}：猎火花异狮对目标鹏洛客造成1点伤害。\\n{3}：猎火花异狮获得不灭异能直到回合结束。\', \'type\': \'神器生物 ～异狮\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487894&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'04a4d118-6129-4bfa-8850-8bcaea1d6fbb\', \'multiverseId\': 487894}, \'multiverseid\': 487894}, {\'name\': \'獵火花異獅\', \'text\': \'棄一張牌，以作為施放此咒語的額外費用。\\n反鵬洛客保護\\n{1}：獵火花異獅對目標鵬洛客造成1點傷害。\\n{3}：獵火花異獅獲得不滅異能直到回合結束。\', \'type\': \'神器生物 ～異獅\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488153&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1b62a86a-ea15-4b09-8ef6-3bb71bf3b4fb\', \'multiverseId\': 488153}, \'multiverseid\': 488153}]', '[{\'name\': \'Furioser Aufstieg\', \'text\': \'Zu Beginn deines Endsegments und falls du eine Kreatur mit Stärke 4 oder mehr kontrollierst, schicke die oberste Karte deiner Bibliothek ins Exil. Du kannst die Karte spielen, bis du eine andere Karte mit dem Furiosen Aufstieg ins Exil schickst.\', \'type\': \'Verzauberung\', \'flavor\': \'Klothys zog aus, das Schicksal von Theros zu flicken, ihre Nadel von Zorn geführt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485726&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f02a19ca-5f4c-42d0-8ab1-fd12bfb99699\', \'multiverseId\': 485726}, \'multiverseid\': 485726}, {\'name\': \'Alzamiento furioso\', \'text\': \'Al comienzo de tu paso final, si controlas una criatura con fuerza de 4 o más, exilia la primera carta de tu biblioteca. Puedes jugar esa carta hasta que exilies otra carta con el Alzamiento furioso.\', \'type\': \'Encantamiento\', \'flavor\': \'Klothys comenzó a tejer de nuevo el destino de Theros, y la furia dirigía todas y cada una de sus puntadas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485985&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'eb3324f7-ccc7-4d68-a992-d933457dcc29\', \'multiverseId\': 485985}, \'multiverseid\': 485985}, {\'name\': \'Ascension furieuse\', \'text\': "Au début de votre étape de fin, si vous contrôlez une créature de force supérieure ou égale à 4, exilez la carte du dessus de votre bibliothèque. Vous pouvez jouer cette carte jusqu\'à ce que vous exiliez une autre carte avec l\'Ascension furieuse.", \'type\': \'Enchantement\', \'flavor\': \'Klothys entreprit de raccommoder la destinée de Theros, sa furie guidant chaque point de couture.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486244&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fce4bbee-6259-4bd1-8384-df871703da9c\', \'multiverseId\': 486244}, \'multiverseid\': 486244}, {\'name\': \'Ascesa Furiosa\', \'text\': "All\'inizio della tua sottofase finale, se controlli una creatura con forza pari o superiore a 4, esilia la prima carta del tuo grimorio. Puoi giocare quella carta finché non esili un\'altra carta con l\'Ascesa Furiosa.", \'type\': \'Incantesimo\', \'flavor\': \'Klotys decise di ricucire il destino di Theros, lasciandosi guidare dalla furia in ogni punto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486503&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5560dd77-9123-4516-bf6f-18dd741b1ec0\', \'multiverseId\': 486503}, \'multiverseid\': 486503}, {\'name\': \'猛然たる顕現\', \'text\': \'あなたの終了ステップの開始時に、あなたがパワーが４以上のクリーチャーをコントロールしている場合、あなたのライブラリーの一番上のカードを追放する。あなたが猛然たる顕現によって他のカードを追放するまで、あなたはそのカードをプレイしてもよい。\', \'type\': \'エンチャント\', \'flavor\': \'クローティスはテーロスの運命を繕い始めた。その縫い目は怒りに導かれていた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486762&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3a650e11-e028-4749-9432-5dbdb7380818\', \'multiverseId\': 486762}, \'multiverseid\': 486762}, {\'name\': \'분노에 찬 봉기\', \'text\': \'당신의 종료단 시작에, 당신이 공격력이 4 이상인 생물을 조종한다면, 당신의 서고 맨 위 카드를 추방한다. 당신은 당신이 분노에 찬 봉기로 다른 카드를 추방하기 전까지 그 카드를 플레이할 수 있다.\', \'type\': \'부여마법\', \'flavor\': \'클로티스는 테로스의 운명을 수복하기 시작했고, 그녀의 분노가 한 땀 한 땀을 이끌었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487021&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'bf4e9002-9e7a-4511-bef5-6c8f839004da\', \'multiverseId\': 487021}, \'multiverseid\': 487021}, {\'name\': \'Escalada Furiosa\', \'text\': \'No início de sua etapa final, se você controlar uma criatura com poder igual ou superior a 4, exile o card do topo de seu grimório. Você pode jogar aquele card até exilar outro card com Escalada Furiosa.\', \'type\': \'Encantamento\', \'flavor\': \'Clotis partiu para consertar o destino de Theros, com sua fúria como guia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487280&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'efe61013-340f-4a1f-a7d2-b86713ac76a3\', \'multiverseId\': 487280}, \'multiverseid\': 487280}, {\'name\': \'Яростное Вознесение\', \'text\': \'В начале вашего заключительного шага, если вы контролируете существо с силой 4 или больше, изгоните верхнюю карту вашей библиотеки. Вы можете разыграть ту карту, пока не изгоните другую карту с помощью Яростного Вознесения.\', \'type\': \'Чары\', \'flavor\': \'Клотис штопала изорванную судьбу Тероса, и ее ярость направляла каждый стежок.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487539&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b81a1210-66c6-47c4-9711-49aa6a45b0db\', \'multiverseId\': 487539}, \'multiverseid\': 487539}, {\'name\': \'怒火昂扬\', \'text\': \'在你的结束步骤开始时，若你操控力量等于或大于4的生物，则放逐你的牌库顶牌。你可以使用该牌，直到你以怒火昂扬放逐另一张牌为止。\', \'type\': \'结界\', \'flavor\': \'克洛缇丝着手修补塞洛斯的命运，每针都由怒火引线。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487798&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'477beaa3-6a23-47a0-86a7-ecfb235a038e\', \'multiverseId\': 487798}, \'multiverseid\': 487798}, {\'name\': \'怒火昂揚\', \'text\': \'在你的結束步驟開始時，若你操控力量等於或大於4的生物，則放逐你的牌庫頂牌。你可以使用該牌，直到你以怒火昂揚放逐另一張牌為止。\', \'type\': \'結界\', \'flavor\': \'克洛緹絲著手修補塞洛斯的命運，每針都由怒火引線。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488057&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'97fb9762-10f4-4134-a5e1-1adcb217c51e\', \'multiverseId\': 488057}, \'multiverseid\': 488057}]', '[{\'name\': \'Fäulniszahnkobra\', \'text\': \'Todesberührung\\nImmer wenn eine Kreatur mit Todesberührung, die du kontrollierst, angreift, verliert jeder Gegner 1 Lebenspunkt und du erhältst 1 Lebenspunkt dazu.\\nImmer wenn eine Kreatur mit Todesberührung, die du kontrollierst, einem Planeswalker Schaden zufügt, zerstöre den Planeswalker.\', \'type\': \'Kreatur — Ophis\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485686&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'80245689-4d2c-4978-90cc-5529ec315555\', \'multiverseId\': 485686}, \'multiverseid\': 485686}, {\'name\': \'Maldecidora con capucha\', \'text\': \'Toque mortal.\\nSiempre que una criatura que controlas con la habilidad de toque mortal ataque, cada oponente pierde 1 vida y tú ganas 1 vida.\\nSiempre que una criatura que controlas con la habilidad de toque mortal haga daño a un planeswalker, destruye ese planeswalker.\', \'type\': \'Criatura — Víbora\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485945&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0b319740-5a28-48f1-bd1e-c33e8c328a0f\', \'multiverseId\': 485945}, \'multiverseid\': 485945}, {\'name\': \'Pestecroc cagoulard\', \'text\': "Contact mortel\\nÀ chaque fois qu\'une créature avec le contact mortel que vous contrôlez attaque, chaque adversaire perd 1 point de vie et vous gagnez 1 point de vie.\\nÀ chaque fois qu\'une créature avec le contact mortel que vous contrôlez inflige des blessures à un planeswalker, détruisez ce planeswalker.", \'type\': \'Créature : serpent\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486204&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'defeccc7-0bd0-4d40-a74b-e41cd9aa7041\', \'multiverseId\': 486204}, \'multiverseid\': 486204}, {\'name\': \'Zannafunesta dal Cappuccio\', \'text\': \'Tocco letale\\nOgniqualvolta una creatura con tocco letale che controlli attacca, ogni avversario perde 1 punto vita e tu guadagni 1 punto vita.\\nOgniqualvolta una creatura con tocco letale che controlli infligge danno a un planeswalker, distruggi quel planeswalker.\', \'type\': \'Creatura — Serpente\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486463&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d7e0b5d3-e78e-46a6-bcc8-3e6f604716c8\', \'multiverseId\': 486463}, \'multiverseid\': 486463}, {\'name\': \'頭巾様の荒廃牙\', \'text\': \'接死\\nあなたがコントロールしていて接死を持つクリーチャーが１体攻撃するたび、各対戦相手はそれぞれ１点のライフを失い、あなたは１点のライフを得る。\\nあなたがコントロールしていて接死を持つクリーチャー１体がプレインズウォーカー１体にダメージを与えるたび、そのプレインズウォーカーを破壊する。\', \'type\': \'クリーチャー — 蛇\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486722&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7cbb3482-4ea5-4670-8c96-1fd5353f570b\', \'multiverseId\': 486722}, \'multiverseid\': 486722}, {\'name\': \'역병이빨 코브라\', \'text\': \'치명타\\n당신이 조종하는 치명타를 가진 생물이 공격할 때마다, 각 상대는 생명 1점을 잃고 당신은 생명 1점을 얻는다.\\n당신이 조종하는 치명타를 가진 생물이 플레인즈워커에게 피해를 입힐 때마다, 그 플레인즈워커를 파괴한다.\', \'type\': \'생물 — 뱀\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486981&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3b4aa585-20e1-42ab-bcd6-21f666208f74\', \'multiverseId\': 486981}, \'multiverseid\': 486981}, {\'name\': \'Presa-de-praga de Capelo\', \'text\': \'Toque mortífero\\nToda vez que uma criatura que você controla com toque mortífero ataca, cada oponente perde 1 ponto de vida e você ganha 1 ponto de vida.\\nToda vez que uma criatura que você controla com toque mortífero causar dano a um planeswalker, destrua aquele planeswalker.\', \'type\': \'Criatura — Cobra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487240&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f25c4517-83d5-455e-8a4d-e27636ef1f1a\', \'multiverseId\': 487240}, \'multiverseid\': 487240}, {\'name\': \'Плащеносный Смертозуб\', \'text\': "Смертельное касание\\nКаждый раз, когда существо со Смертельным касанием под вашим контролем атакует, каждый оппонент теряет 1 жизнь, а вы получаете 1 жизнь.\\nКаждый раз, когда существо со Смертельным касанием под вашим контролем наносит повреждения planeswalker\'у, уничтожьте того planeswalker\'а.", \'type\': \'Существо — Змея\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487499&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'030a89c5-5771-4e23-b6f6-ccdf2eee00f9\', \'multiverseId\': 487499}, \'multiverseid\': 487499}, {\'name\': \'枯牙眼镜蛇\', \'text\': \'死触\\n每当一个由你操控且具死触异能的生物攻击时，每位对手各失去1点生命，且你获得1点生命。\\n每当一个由你操控且具死触异能的生物对任一鹏洛客造成伤害时，消灭该鹏洛客。\', \'type\': \'生物 ～蛇\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487758&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fadae0f9-3f03-44d2-b81b-0ea0f6d70ff0\', \'multiverseId\': 487758}, \'multiverseid\': 487758}, {\'name\': \'枯牙眼鏡蛇\', \'text\': \'死觸\\n每當一個由你操控且具死觸異能的生物攻擊時，每位對手各失去1點生命，且你獲得1點生命。\\n每當一個由你操控且具死觸異能的生物對任一鵬洛客造成傷害時，消滅該鵬洛客。\', \'type\': \'生物 ～蛇\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488017&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b589421e-49ac-4b54-b1f6-b0205a8ceeea\', \'multiverseId\': 488017}, \'multiverseid\': 488017}]', '[{\'name\': \'Gabe des Alchemisten\', \'text\': \'Eine Kreatur deiner Wahl erhält bis zum Ende des Zuges +1/+1 und entweder Todesberührung oder Lebensverknüpfung (du entscheidest). (Eine beliebige Menge Schadenspunkte, die eine Kreatur mit Todesberührung einer Kreatur zufügt, sind ausreichend, um diese zu zerstören. Schaden, der von einer Kreatur mit Lebensverknüpfung zugefügt wird, lässt ihren Beherrscher entsprechend viele Lebenspunkte dazuerhalten.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485669&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'26ca8d32-cc52-4451-ae7a-06f557083373\', \'multiverseId\': 485669}, \'multiverseid\': 485669}, {\'name\': \'Regalo de la alquimista\', \'text\': \'La criatura objetivo obtiene +1/+1 y gana a tu elección la habilidad de toque mortal o vínculo vital hasta el final del turno. (Cualquier cantidad de daño que una criatura con la habilidad de toque mortal haga a una criatura es suficiente para destruirla. El daño hecho por una criatura con la habilidad de vínculo vital también hace que su controlador gane esa misma cantidad de vidas.)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485928&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'06ef2d45-c200-49a2-8b93-68a837f3f252\', \'multiverseId\': 485928}, \'multiverseid\': 485928}, {\'name\': "Don de l\'alchimiste", \'text\': "La créature ciblée gagne +1/+1 et acquiert, selon votre choix, le contact mortel ou le lien de vie jusqu\'à la fin du tour. (Le nombre de blessures qu\'une créature avec le contact mortel inflige à une créature, quel qu\'il soit, est suffisant pour la détruire. Les blessures infligées par une créature avec le lien de vie font aussi gagner autant de points de vie à son contrôleur.)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486187&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'382814e9-6c36-4aa6-9af1-8df238fb2013\', \'multiverseId\': 486187}, \'multiverseid\': 486187}, {\'name\': "Dono dell\'Alchimista", \'text\': \'Una creatura bersaglio prende +1/+1 e ha tocco letale o legame vitale a tua scelta fino alla fine del turno. (Qualsiasi danno che una creatura con tocco letale infligge a una creatura è sufficiente a distruggerla. Il danno inflitto da una creatura con legame vitale fa anche guadagnare altrettanti punti vita al suo controllore.)\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486446&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'00bf5b19-8584-4577-bfa6-ad02d8d70da8\', \'multiverseId\': 486446}, \'multiverseid\': 486446}, {\'name\': \'錬金術師の贈り物\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋１/＋１の修整を受け、接死か絆魂のうちあなたが選んだ一方を得る。（接死を持つクリーチャーが何らかのダメージをクリーチャーに与えたら、それだけで破壊する。絆魂を持つクリーチャーがダメージを与えると、さらにそれのコントローラーはその点数分のライフを得る。）\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486705&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'58971c3e-cdea-4e8c-9a63-01e4b57996f3\', \'multiverseId\': 486705}, \'multiverseid\': 486705}, {\'name\': \'연금술사의 선물\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 +1/+1을 받고 치명타 또는 생명연결 중 당신이 선택한 능력을 얻는다. (치명타를 가진 생물에게 피해를 입은 생물은 입은 피해의 양에 상관없이 파괴된다. 생명연결을 가진 생물이 피해를 입히면 그 생물의 조종자는 그 피해만큼의 생명점을 얻는다.)\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486964&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1790e91d-dafd-4fcf-b271-c70d50f6d76a\', \'multiverseId\': 486964}, \'multiverseid\': 486964}, {\'name\': \'Dádiva da Alquimista\', \'text\': \'A criatura alvo recebe +1/+1 e ganha toque mortífero ou vínculo com a vida, à sua escolha, até o final do turno. (Qualquer quantidade de dano que uma criatura com toque mortífero cause a uma criatura é suficiente para destruí-la. O dano causado por uma criatura com vínculo com a vida também faz com que seu controlador ganhe uma quantidade equivalente de pontos de vida.)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487223&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b37ae7c6-e488-46e6-98da-8294155aa3ec\', \'multiverseId\': 487223}, \'multiverseid\': 487223}, {\'name\': \'Дар Алхимика\', \'text\': \'Целевое существо получает +1/+1 и по вашему выбору Смертельное касание или Цепь жизни до конца хода. (Любое количество повреждений, которое существо со Смертельным касанием наносит существу, достаточно, чтобы его уничтожить. Повреждения, наносимые существом с Цепью жизни, также заставляют контролирующего его игрока получить такое же количество жизней.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487482&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'48cbf2c0-4db7-4895-b229-d89a9574a2e9\', \'multiverseId\': 487482}, \'multiverseid\': 487482}, {\'name\': \'炼金术士的赠礼\', \'text\': \'选择死触或系命。直到回合结束，目标生物得+1/+1且获得该异能。（具死触异能之生物对生物造成的任何数量伤害都足以消灭后者。具系命异能之生物所造成的伤害会让其操控者获得等量的生命。）\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487741&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'174d7246-d97c-4b82-ad79-6a290abd6363\', \'multiverseId\': 487741}, \'multiverseid\': 487741}, {\'name\': \'鍊金術士的贈禮\', \'text\': \'選擇死觸或繫命。直到回合結束，目標生物得+1/+1且獲得該異能。（具死觸異能之生物對生物造成的任何數量傷害都足以消滅後者。具繫命異能之生物所造成的傷害會讓其操控者獲得等量的生命。）\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488000&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'aaec7795-2a5b-4ae6-a974-de16266dddf4\', \'multiverseId\': 488000}, \'multiverseid\': 488000}]', '[{\'name\': \'Gadrak, Geißel der Gekrönten\', \'text\': \'Fliegend\\nGadrak, Geißel der Gekrönten, kann nicht angreifen, es sei denn, du kontrollierst vier oder mehr Artefakte.\\nZu Beginn deines Endsegments erzeugst du für jede Nichtspielsteinkreatur, die in diesem Zug gestorben ist, einen Schatz-Spielstein. (Er ist ein Artefakt mit „{T}, opfere dieses Artefakt: Erzeuge ein Mana einer beliebigen Farbe.")\', \'type\': \'Legendäre Kreatur — Drache\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485728&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e71017e5-5a0b-40c1-bd72-04cdbbda7fd1\', \'multiverseId\': 485728}, \'multiverseid\': 485728}, {\'name\': \'Gadrak, Azote a las Coronas\', \'text\': \'Vuela.\\nGadrak, Azote a las Coronas no puede atacar a menos que controles cuatro o más artefactos.\\nAl comienzo de tu paso final, crea una ficha de Tesoro por cada criatura que no sea ficha que murió en este turno. (Es un artefacto con "{T}, sacrificar este artefacto: Agrega un maná de cualquier color".)\', \'type\': \'Criatura legendaria — Dragón\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485987&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2f74a24e-9294-4887-8297-a47eab0e3590\', \'multiverseId\': 485987}, \'multiverseid\': 485987}, {\'name\': \'Gadrak, le fléau des couronnes\', \'text\': "Vol\\nGadrak, le fléau des couronnes ne peut pas attaquer à moins que vous ne contrôliez au moins quatre artefacts.\\nAu début de votre étape de fin, créez un jeton Trésor pour chaque créature non-jeton qui est morte ce tour-ci. (C\'est un artefact avec « {T}, sacrifiez cet artefact : Ajoutez un mana de la couleur de votre choix. »)", \'type\': \'Créature légendaire : dragon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486246&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b493099d-cd92-42cb-a54e-00d71a583492\', \'multiverseId\': 486246}, \'multiverseid\': 486246}, {\'name\': \'Gadrak, il Flagello delle Corone\', \'text\': \'Volare\\nGadrak, il Flagello delle Corone non può attaccare a meno che tu non controlli quattro o più artefatti.\\nAll\\\'inizio della tua sottofase finale, crea una pedina Tesoro per ogni creatura non pedina che è morta in questo turno. (È un artefatto con: "{T}, Sacrifica questo artefatto: Aggiungi un mana di un qualsiasi colore".)\', \'type\': \'Creatura Leggendaria — Drago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486505&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9457c919-09a1-4991-81aa-5c352bc368f1\', \'multiverseId\': 486505}, \'multiverseid\': 486505}, {\'name\': \'冠滅ぼしのガドラク\', \'text\': \'飛行\\nあなたがアーティファクトを４つ以上コントロールしていないかぎり、冠滅ぼしのガドラクでは攻撃できない。\\nあなたの終了ステップの開始時に、このターンに死亡した、トークンでないクリーチャー１体につき、宝物・トークンを１つ生成する。（それは、「{T}, このアーティファクトを生け贄に捧げる：好きな色１色のマナ１点を加える。」を持つアーティファクトである。）\', \'type\': \'伝説のクリーチャー — ドラゴン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486764&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7d8e0265-2be1-4d11-af5b-e287e12d73e0\', \'multiverseId\': 486764}, \'multiverseid\': 486764}, {\'name\': \'재앙의 정점, 개드락\', \'text\': \'비행\\n재앙의 정점, 개드락은 당신이 마법물체를 네 개 이상 조종하지 않는 한 공격할 수 없다.\\n당신의 종료단 시작에, 이번 턴에 죽은 토큰이 아닌 각 생물마다 보물 토큰 한 개를 만든다. (보물 토큰은 "{T}, 이 마법물체를 희생한다: 원하는 색의 마나 한 개를 추가한다."를 가진 마법물체이다.)\', \'type\': \'전설적 생물 — 용\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487023&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'71641a39-3a05-4fcb-a1e5-6959b602d33a\', \'multiverseId\': 487023}, \'multiverseid\': 487023}, {\'name\': \'Gadrak, Flagelo da Coroa\', \'text\': \'Voar\\nGadrak, Flagelo da Coroa, não pode atacar, a menos que você controle quatro ou mais artefatos.\\nNo início de sua etapa final, crie uma ficha de Tesouro para cada criatura que não seja ficha e tenha morrido neste turno. (Ela é um artefato com "{T}, sacrifique este artefato: Adicione um mana de qualquer cor".)\', \'type\': \'Criatura Lendária — Dragão\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487282&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e882b6d3-d8ce-427d-91d0-626811aa1489\', \'multiverseId\': 487282}, \'multiverseid\': 487282}, {\'name\': \'Гэдрак, Бич Властителей\', \'text\': \'Полет\\nГэдрак, Бич Властителей не может атаковать, если вы контролируете менее четырех артефактов.\\nВ начале вашего заключительного шага создайте одну фишку Клада за каждое не являющееся фишкой существо, умершее в этом ходу. (Это артефакт со способностью «{T}, пожертвуйте этот артефакт: добавьте одну ману любого цвета».)\', \'type\': \'Легендарное Существо — Дракон\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487541&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'77e6289e-c4bd-4a02-9ba8-7e34c67c70df\', \'multiverseId\': 487541}, \'multiverseid\': 487541}, {\'name\': \'戴冠祸害加札克\', \'text\': \'飞行\\n除非你操控四个或更多神器，否则戴冠祸害加札克不能攻击。\\n在你的结束步骤开始时，本回合中每有一个非衍生物的生物死去，便派出一个珍宝衍生物。（珍宝衍生物是具有「{T}，牺牲此神器：加一点任意颜色的法术力」的神器。）\', \'type\': \'传奇生物 ～龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487800&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a0fa425f-850e-4edc-84b9-06ea0bf3ad49\', \'multiverseId\': 487800}, \'multiverseid\': 487800}, {\'name\': \'戴冠禍害加札克\', \'text\': \'飛行\\n除非你操控四個或更多神器，否則戴冠禍害加札克不能攻擊。\\n在你的結束步驟開始時，本回合中每有一個非衍生物的生物死去，便派出一個珍寶衍生物。（珍寶衍生物是具有「{T}，犧牲此神器：加一點任意顏色的魔法力」的神器。）\', \'type\': \'傳奇生物 ～龍\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488059&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'676664e7-53bf-4ce3-8d84-5a2bd2299ff0\', \'multiverseId\': 488059}, \'multiverseid\': 488059}]', "[{'name': 'Gadrak, le fléau des couronnes', 'text': 'Vol\\nGadrak, le fléau des couronnes ne peut pas attaquer à moins que vous ne contrôliez au moins quatre artefacts.\\nAu début de votre étape de fin, créez un jeton Trésor pour chaque créature non-jeton qui est morte ce tour-ci.', 'type': 'Créature légendaire : dragon', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488318&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'dc5bca5d-b280-46d3-a233-88779adac194', 'multiverseId': 488318}, 'multiverseid': 488318}, {'name': '冠滅ぼしのガドラク', 'text': '飛行\\nあなたがアーティファクトを４つ以上コントロールしていないかぎり、冠滅ぼしのガドラクでは攻撃できない。\\nあなたの終了ステップの開始時に、このターンに死亡した、トークンでないクリーチャー１体につき、宝物・トークンを１つ生成する。', 'type': '伝説のクリーチャー — ドラゴン', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488370&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '653e3166-2349-49a1-b538-9ef750892e10', 'multiverseId': 488370}, 'multiverseid': 488370}]", '[{\'name\': \'Gargaroth-Ältester\', \'text\': \'Wachsamkeit, Reichweite, verursacht Trampelschaden\\nImmer wenn der Gargaroth-Älteste angreift oder blockt, bestimme eines —\\n• Erzeuge einen 3/3 grünen Bestie-Kreaturenspielstein.\\n• Du erhältst 3 Lebenspunkte dazu.\\n• Ziehe eine Karte.\', \'type\': \'Kreatur — Bestie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485761&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1cfb7471-be1f-4896-83dc-ee7a9f76f9cb\', \'multiverseId\': 485761}, \'multiverseid\': 485761}, {\'name\': \'Gárgarot anciano\', \'text\': \'Vigilancia, alcance, arrolla.\\nSiempre que el Gárgarot anciano ataque o bloquee, elige uno:\\n• Crea una ficha de criatura Bestia verde 3/3.\\n• Ganas 3 vidas.\\n• Roba una carta.\', \'type\': \'Criatura — Bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486020&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1caacfc8-ca8d-4844-b9a9-a23524bb4f8c\', \'multiverseId\': 486020}, \'multiverseid\': 486020}, {\'name\': \'Ancêtre gargaroth\', \'text\': "Vigilance, portée, piétinement\\nÀ chaque fois que l\'Ancêtre gargaroth attaque ou bloque, choisissez l\'un —\\n• Créez un jeton de créature 3/3 verte Bête.\\n• Vous gagnez 3 points de vie.\\n• Piochez une carte.", \'type\': \'Créature : bête\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486279&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fdbc9689-8061-41d8-8c69-e4ff01876a35\', \'multiverseId\': 486279}, \'multiverseid\': 486279}, {\'name\': \'Gargaroth Antico\', \'text\': \'Cautela, raggiungere, travolgere\\nOgniqualvolta il Gargaroth Antico attacca o blocca, scegli uno —\\n• Crea una pedina creatura Bestia 3/3 verde.\\n• Guadagni 3 punti vita.\\n• Pesca una carta.\', \'type\': \'Creatura — Bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486538&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1939972f-19eb-4512-8373-c2cb5e8830db\', \'multiverseId\': 486538}, \'multiverseid\': 486538}, {\'name\': \'長老ガーガロス\', \'text\': \'警戒、到達、トランプル\\n長老ガーガロスが攻撃するかブロックするたび、以下から１つを選ぶ。\\n• 緑の３/３のビースト・クリーチャー・トークンを１体生成する。\\n• あなたは３点のライフを得る。\\n• カードを１枚引く。\', \'type\': \'クリーチャー — ビースト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486797&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cb49ed17-8242-42a6-8262-71451bb6f731\', \'multiverseId\': 486797}, \'multiverseid\': 486797}, {\'name\': \'장로 가르가로스\', \'text\': \'경계, 대공, 돌진\\n장로 가르가로스가 공격 또는 방어할 때마다, 한 개를 선택한다 —\\n• 3/3 녹색 야수 생물 토큰 한 개를 만든다.\\n• 당신은 생명 3점을 얻는다.\\n• 카드 한 장을 뽑는다.\', \'type\': \'생물 — 야수\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487056&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'654ecd64-9742-48c4-af1f-6cfc5d3a0cb9\', \'multiverseId\': 487056}, \'multiverseid\': 487056}, {\'name\': \'Gargarote Ancião\', \'text\': \'Vigilância, alcance, atropelar\\nToda vez que Gargarote Ancião atacar ou bloquear, escolha um —\\n• Crie uma ficha de criatura verde 3/3 do tipo Besta.\\n• Você ganha 3 pontos de vida.\\n• Compre um card.\', \'type\': \'Criatura — Besta\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487315&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c860c7eb-08fe-4cfc-95a4-fb7516c029cc\', \'multiverseId\': 487315}, \'multiverseid\': 487315}, {\'name\': \'Гаргарот-Старейшина\', \'text\': \'Бдительность, Захват, Пробивной удар\\nКаждый раз, когда Гаргарот-Старейшина атакует или блокирует, выберите одно —\\n• Создайте одну фишку существа 3/3 зеленый Зверь.\\n• Вы получаете 3 жизни.\\n• Возьмите карту.\', \'type\': \'Существо — Зверь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487574&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b39046a4-870b-448e-a68d-3f52e054adf0\', \'multiverseId\': 487574}, \'multiverseid\': 487574}, {\'name\': \'年长庞巨兽\', \'text\': \'警戒，延势，践踏\\n每当年长庞巨兽攻击或阻挡时，选择一项～\\n•派出一个3/3绿色野兽衍生生物。\\n•你获得3点生命。\\n•抓一张牌。\', \'type\': \'生物 ～野兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487833&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8d0a4599-72cb-481b-9aa8-2434771435de\', \'multiverseId\': 487833}, \'multiverseid\': 487833}, {\'name\': \'年長龐巨獸\', \'text\': \'警戒，延勢，踐踏\\n每當年長龐巨獸攻擊或阻擋時，選擇一項～\\n•派出一個3/3綠色野獸衍生生物。\\n•你獲得3點生命。\\n•抽一張牌。\', \'type\': \'生物 ～野獸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488092&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b722e868-ef6d-4724-b380-eec41987f684\', \'multiverseId\': 488092}, \'multiverseid\': 488092}]', '[{\'name\': \'Garruk der Entfesselte\', \'text\': \'+1: Bis zu eine Kreatur deiner Wahl erhält +3/+3 und verursacht Trampelschaden bis zum Ende des Zuges.\\n−2: Erzeuge einen 3/3 grünen Bestie-Kreaturenspielstein. Falls dann ein Gegner mehr Kreaturen kontrolliert als du, lege eine Loyalitätsmarke auf Garruk den Entfesselten.\\n−7: Du erhältst ein Emblem mit „Zu Beginn deines Endsegments kannst du deine Bibliothek nach einer Kreaturenkarte durchsuchen, sie ins Spiel bringen und dann deine Bibliothek mischen."\', \'type\': \'Legendärer Planeswalker — Garruk\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485765&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'531170f0-df1c-438a-86f1-d14ad5d43975\', \'multiverseId\': 485765}, \'multiverseid\': 485765}, {\'name\': \'Garruk, desatado\', \'text\': \'+1: Hasta una criatura objetivo obtiene +3/+3 y gana la habilidad de arrollar hasta el final del turno.\\n−2: Crea una ficha de criatura Bestia verde 3/3. Luego, si un oponente controla más criaturas que tú, pon un contador de lealtad sobre Garruk, desatado.\\n−7: Obtienes un emblema con "Al comienzo de tu paso final, puedes buscar en tu biblioteca una carta de criatura, ponerla en el campo de batalla y luego barajar tu biblioteca".\', \'type\': \'Planeswalker legendario — Garruk\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486024&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6ab84c06-1ebc-4529-a23f-840451396aec\', \'multiverseId\': 486024}, \'multiverseid\': 486024}, {\'name\': \'Garruk, libéré\', \'text\': "+1: Jusqu\'à une créature ciblée gagne +3/+3 et acquiert le piétinement jusqu\'à la fin du tour.\\n-2: Créez un jeton de créature 3/3 verte Bête. Ensuite, si un adversaire contrôle plus de créatures que vous, mettez un marqueur « loyauté » sur Garruk, libéré.\\n-7: Vous gagnez un emblème avec « Au début de votre étape de fin, vous pouvez chercher dans votre bibliothèque une carte de créature, la mettre sur le champ de bataille, puis mélanger votre bibliothèque. »", \'type\': \'Planeswalker légendaire : Garruk\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486283&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ea51b506-35c8-462e-91b8-0525b5e5c490\', \'multiverseId\': 486283}, \'multiverseid\': 486283}, {\'name\': \'Garruk, Infuriato\', \'text\': \'+1: Fino a una creatura bersaglio prende +3/+3 e ha travolgere fino alla fine del turno.\\n-2: Crea una pedina creatura Bestia 3/3 verde. Poi, se un avversario controlla più creature di te, metti un segnalino fedeltà su Garruk, Infuriato.\\n-7: Ottieni un emblema con "All\\\'inizio della tua sottofase finale, puoi passare in rassegna il tuo grimorio per una carta creatura, metterla sul campo di battaglia, poi rimescolare il tuo grimorio".\', \'type\': \'Planeswalker Leggendario — Garruk\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486542&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'028fcca0-7ac4-4b56-bc48-9c369a10265f\', \'multiverseId\': 486542}, \'multiverseid\': 486542}, {\'name\': \'解き放たれた者、ガラク\', \'text\': \'+1：クリーチャー最大１体を対象とする。ターン終了時まで、それは＋３/＋３の修整を受けトランプルを得る。\\n-2：緑の３/３のビースト・クリーチャー・トークンを１体生成する。その後、対戦相手１人があなたより多くのクリーチャーをコントロールしているなら、解き放たれた者、ガラクの上に忠誠カウンターを１個置く。\\n-7：あなたは「あなたの終了ステップの開始時に、あなたは『あなたのライブラリーからクリーチャー・カード１枚を探し、戦場に出し、その後あなたのライブラリーを切り直す。』を選んでもよい。」を持つ紋章を得る。\', \'type\': \'伝説のプレインズウォーカー — ガラク\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486801&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'aec36de5-e00d-48cb-8235-32fdc47f5b57\', \'multiverseId\': 486801}, \'multiverseid\': 486801}, {\'name\': \'풀려난 자, 개럭\', \'text\': \'+1: 생물을 최대 한 개까지 목표로 정한다. 그 생물은 턴종료까지 +3/+3을 받고 돌진을 얻는다.\\n−2: 3/3 녹색 야수 생물 토큰 한 개를 만든다. 그 후 상대가 당신보다 생물을 많이 조종한다면, 풀려난 자, 개럭에 충성 카운터 한 개를 올려놓는다.\\n−7: 당신은 "당신의 종료단 시작에, 당신은 당신의 서고에서 생물 카드 한 장을 찾아, 전장에 놓을 수 있다. 그렇게 한다면, 당신의 서고를 섞는다."를 가진 휘장을 얻는다.\', \'type\': \'전설적 플레인즈워커 — 개럭\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487060&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d892c7d1-8d56-4db8-bf78-499da6a53501\', \'multiverseId\': 487060}, \'multiverseid\': 487060}, {\'name\': \'Garruk, Liberto\', \'text\': \'+1: Até uma criatura alvo recebe +3/+3 e ganha atropelar até o final do turno.\\n−2: Crie uma ficha de criatura verde 3/3 do tipo Besta. Depois, se um oponente controlar mais criaturas que você, coloque um marcador de lealdade em Garruk, Liberto.\\n−7: Você recebe um emblema com "No início de sua etapa final, você pode procurar um card de criatura em seu grimório, colocá-lo no campo de batalha e depois embaralhar seu grimório".\', \'type\': \'Planeswalker Lendário — Garruk\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487319&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'34bb97f4-078f-445b-a613-2ffbafe08650\', \'multiverseId\': 487319}, \'multiverseid\': 487319}, {\'name\': \'Гаррук, Неудержимый\', \'text\': \'+1: не более одного целевого существа получает +3/+3 и Пробивной удар до конца хода.\\n−2: создайте одну фишку существа 3/3 зеленый Зверь. Затем, если оппонент контролирует больше существ, чем вы, положите один жетон верности на Гаррука, Неудержимого.\\n−7: вы получаете эмблему со способностью «В начале вашего заключительного шага вы можете найти в вашей библиотеке карту существа, положить ее на поле битвы, затем перетасовать вашу библиотеку».\', \'type\': \'Легендарный Planeswalker — Гаррук\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487578&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5669dc53-0c12-4d77-bbee-8e2321eadde5\', \'multiverseId\': 487578}, \'multiverseid\': 487578}, {\'name\': \'无拘贾路\', \'text\': \'+1：直到回合结束，至多一个目标生物得+3/+3且获得践踏异能。\\n-2：派出一个3/3绿色野兽衍生生物。然后如果任一对手操控的生物比你多，则在无拘贾路上放置一个忠诚指示物。\\n-7：你获得具有「在你的结束步骤开始时，你可以从你的牌库中搜寻一张生物牌，将之放进战场，然后将你的牌库洗牌」的徽记。\', \'type\': \'传奇鹏洛客 ～贾路\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487837&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'caba56da-935f-4223-a784-e23e24a90eec\', \'multiverseId\': 487837}, \'multiverseid\': 487837}, {\'name\': \'無拘賈路\', \'text\': \'+1：直到回合結束，至多一個目標生物得+3/+3且獲得踐踏異能。\\n−2：派出一個3/3綠色野獸衍生生物。然後如果任一對手操控的生物比你多，則在無拘賈路上放置一個忠誠指示物。\\n−7：你獲得具有「在你的結束步驟開始時，你可以從你的牌庫中搜尋一張生物牌，將之放進戰場，然後將你的牌庫洗牌」的徽記。\', \'type\': \'傳奇鵬洛客 ～賈路\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488096&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'06c3c9c6-94e1-4229-bb80-bf0d6272f7e6\', \'multiverseId\': 488096}, \'multiverseid\': 488096}]', '[{\'name\': \'Garruk der Entfesselte\', \'text\': \'+1: Bis zu eine Kreatur deiner Wahl erhält +3/+3 und verursacht Trampelschaden bis zum Ende des Zuges.\\n−2: Erzeuge einen 3/3 grünen Bestie-Kreaturenspielstein. Falls dann ein Gegner mehr Kreaturen kontrolliert als du, lege eine Loyalitätsmarke auf Garruk den Entfesselten.\\n−7: Du erhältst ein Emblem mit „Zu Beginn deines Endsegments kannst du deine Bibliothek nach einer Kreaturenkarte durchsuchen, sie ins Spiel bringen und dann deine Bibliothek mischen."\', \'type\': \'Legendärer Planeswalker — Garruk\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488184&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a32e45cc-d8c3-4b4c-89b6-a153b7a912fa\', \'multiverseId\': 488184}, \'multiverseid\': 488184}, {\'name\': \'Garruk, desatado\', \'text\': \'+1: Hasta una criatura objetivo obtiene +3/+3 y gana la habilidad de arrollar hasta el final del turno.\\n−2: Crea una ficha de criatura Bestia verde 3/3. Luego, si un oponente controla más criaturas que tú, pon un contador de lealtad sobre Garruk, desatado.\\n−7: Obtienes un emblema con "Al comienzo de tu paso final, puedes buscar en tu biblioteca una carta de criatura, ponerla en el campo de batalla y luego barajar tu biblioteca".\', \'type\': \'Planeswalker legendario — Garruk\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488190&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1f14469b-2eeb-4917-bcff-c424d8cc3910\', \'multiverseId\': 488190}, \'multiverseid\': 488190}, {\'name\': \'Garruk, libéré\', \'text\': "+1: Jusqu\'à une créature ciblée gagne +3/+3 et acquiert le piétinement jusqu\'à la fin du tour.\\n-2: Créez un jeton de créature 3/3 verte Bête. Ensuite, si un adversaire contrôle plus de créatures que vous, mettez un marqueur « loyauté » sur Garruk, libéré.\\n-7: Vous gagnez un emblème avec « Au début de votre étape de fin, vous pouvez chercher dans votre bibliothèque une carte de créature, la mettre sur le champ de bataille, puis mélanger votre bibliothèque. »", \'type\': \'Planeswalker légendaire : Garruk\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488196&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'adfa5962-37f7-4f87-b3e7-c2b7ff982775\', \'multiverseId\': 488196}, \'multiverseid\': 488196}, {\'name\': \'Garruk, Infuriato\', \'text\': \'+1: Fino a una creatura bersaglio prende +3/+3 e ha travolgere fino alla fine del turno.\\n-2: Crea una pedina creatura Bestia 3/3 verde. Poi, se un avversario controlla più creature di te, metti un segnalino fedeltà su Garruk, Infuriato.\\n-7: Ottieni un emblema con "All\\\'inizio della tua sottofase finale, puoi passare in rassegna il tuo grimorio per una carta creatura, metterla sul campo di battaglia, poi rimescolare il tuo grimorio".\', \'type\': \'Planeswalker Leggendario — Garruk\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488202&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'78881651-ef27-4f7b-a582-320cd3f14d13\', \'multiverseId\': 488202}, \'multiverseid\': 488202}, {\'name\': \'解き放たれた者、ガラク\', \'text\': \'+1：クリーチャー最大１体を対象とする。ターン終了時まで、それは＋３/＋３の修整を受けトランプルを得る。\\n-2：緑の３/３のビースト・クリーチャー・トークンを１体生成する。その後、対戦相手１人があなたより多くのクリーチャーをコントロールしているなら、解き放たれた者、ガラクの上に忠誠カウンターを１個置く。\\n-7：あなたは「あなたの終了ステップの開始時に、あなたは『あなたのライブラリーからクリーチャー・カード１枚を探し、戦場に出し、その後あなたのライブラリーを切り直す。』を選んでもよい。」を持つ紋章を得る。\', \'type\': \'伝説のプレインズウォーカー — ガラク\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488208&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ddf0ee78-0a5a-40e7-8e35-7e57e71b4bed\', \'multiverseId\': 488208}, \'multiverseid\': 488208}, {\'name\': \'풀려난 자, 개럭\', \'text\': \'+1: 생물을 최대 한 개까지 목표로 정한다. 그 생물은 턴종료까지 +3/+3을 받고 돌진을 얻는다.\\n−2: 3/3 녹색 야수 생물 토큰 한 개를 만든다. 그 후 상대가 당신보다 생물을 많이 조종한다면, 풀려난 자, 개럭에 충성 카운터 한 개를 올려놓는다.\\n−7: 당신은 "당신의 종료단 시작에, 당신은 당신의 서고에서 생물 카드 한 장을 찾아, 전장에 놓을 수 있다. 그렇게 한다면, 당신의 서고를 섞는다."를 가진 휘장을 얻는다.\', \'type\': \'전설적 플레인즈워커 — 개럭\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488214&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b6737fc8-8270-416f-af6e-5014599fb17a\', \'multiverseId\': 488214}, \'multiverseid\': 488214}, {\'name\': \'Garruk, Liberto\', \'text\': \'+1: Até uma criatura alvo recebe +3/+3 e ganha atropelar até o final do turno.\\n−2: Crie uma ficha de criatura verde 3/3 do tipo Besta. Depois, se um oponente controlar mais criaturas que você, coloque um marcador de lealdade em Garruk, Liberto.\\n−7: Você recebe um emblema com "No início de sua etapa final, você pode procurar um card de criatura em seu grimório, colocá-lo no campo de batalha e depois embaralhar seu grimório".\', \'type\': \'Planeswalker Lendário — Garruk\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488220&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'20463c56-2b84-4b24-9320-1c4a075bcb8a\', \'multiverseId\': 488220}, \'multiverseid\': 488220}, {\'name\': \'ГАРРУК, НЕУДЕРЖИМЫЙ\', \'text\': \'+1: не более одного целевого существа получает +3/+3 и Пробивной удар до конца хода.\\n−2: создайте одну фишку существа 3/3 зеленый Зверь. Затем, если оппонент контролирует больше существ, чем вы, положите один жетон верности на Гаррука, Неудержимого.\\n−7: вы получаете эмблему со способностью «В начале вашего заключительного шага вы можете найти в вашей библиотеке карту существа, положить ее на поле битвы, затем перетасовать вашу библиотеку».\', \'type\': \'Легендарный Planeswalker — ГАРРУК\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488226&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'35aabb5f-4527-4df7-871a-b54a6d35f255\', \'multiverseId\': 488226}, \'multiverseid\': 488226}, {\'name\': \'无拘贾路\', \'text\': \'+1：直到回合结束，至多一个目标生物得+3/+3且获得践踏异能。\\n-2：派出一个3/3绿色野兽衍生生物。然后如果任一对手操控的生物比你多，则在无拘贾路上放置一个忠诚指示物。\\n-7：你获得具有「在你的结束步骤开始时，你可以从你的牌库中搜寻一张生物牌，将之放进战场，然后将你的牌库洗牌」的徽记。\', \'type\': \'传奇鹏洛客 ～贾路\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488232&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fc4fc4cd-a8c2-4fcc-800e-4a805773188e\', \'multiverseId\': 488232}, \'multiverseid\': 488232}, {\'name\': \'無拘賈路\', \'text\': \'+1：直到回合結束，至多一個目標生物得+3/+3且獲得踐踏異能。\\n−2：派出一個3/3綠色野獸衍生生物。然後如果任一對手操控的生物比你多，則在無拘賈路上放置一個忠誠指示物。\\n−7：你獲得具有「在你的結束步驟開始時，你可以從你的牌庫中搜尋一張生物牌，將之放進戰場，然後將你的牌庫洗牌」的徽記。\', \'type\': \'傳奇鵬洛客 ～賈路\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488238&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fddbf691-9424-4e8c-bd48-d5b6d562466a\', \'multiverseId\': 488238}, \'multiverseid\': 488238}]', '[{\'name\': \'Garruk der Entfesselte\', \'text\': \'+1: Bis zu eine Kreatur deiner Wahl erhält +3/+3 und verursacht Trampelschaden bis zum Ende des Zuges.\\n−2: Erzeuge einen 3/3 grünen Bestie-Kreaturenspielstein. Falls dann ein Gegner mehr Kreaturen kontrolliert als du, lege eine Loyalitätsmarke auf Garruk den Entfesselten.\\n−7: Du erhältst ein Emblem mit „Zu Beginn deines Endsegments kannst du deine Bibliothek nach einer Kreaturenkarte durchsuchen, sie ins Spiel bringen und dann deine Bibliothek mischen."\', \'type\': \'Legendärer Planeswalker — Garruk\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488945&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'071c1f2a-b735-4f74-9915-989fe9f8a15a\', \'multiverseId\': 488945}, \'multiverseid\': 488945}, {\'name\': \'Garruk, desatado\', \'text\': \'+1: Hasta una criatura objetivo obtiene +3/+3 y gana la habilidad de arrollar hasta el final del turno.\\n−2: Crea una ficha de criatura Bestia verde 3/3. Luego, si un oponente controla más criaturas que tú, pon un contador de lealtad sobre Garruk, desatado.\\n−7: Obtienes un emblema con "Al comienzo de tu paso final, puedes buscar en tu biblioteca una carta de criatura, ponerla en el campo de batalla y luego barajar tu biblioteca".\', \'type\': \'Planeswalker legendario — Garruk\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488969&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b3fa36a8-d3e5-46b8-bf1c-008b9ae5c7c3\', \'multiverseId\': 488969}, \'multiverseid\': 488969}, {\'name\': \'Garruk, libéré\', \'text\': "+1: Jusqu\'à une créature ciblée gagne +3/+3 et acquiert le piétinement jusqu\'à la fin du tour.\\n-2: Créez un jeton de créature 3/3 verte Bête. Ensuite, si un adversaire contrôle plus de créatures que vous, mettez un marqueur « loyauté » sur Garruk, libéré.\\n-7: Vous gagnez un emblème avec « Au début de votre étape de fin, vous pouvez chercher dans votre bibliothèque une carte de créature, la mettre sur le champ de bataille, puis mélanger votre bibliothèque. »", \'type\': \'Planeswalker légendaire : Garruk\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488993&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6639d454-9c69-4a5e-96ab-cea53302a218\', \'multiverseId\': 488993}, \'multiverseid\': 488993}, {\'name\': \'Garruk, Infuriato\', \'text\': \'+1: Fino a una creatura bersaglio prende +3/+3 e ha travolgere fino alla fine del turno.\\n-2: Crea una pedina creatura Bestia 3/3 verde. Poi, se un avversario controlla più creature di te, metti un segnalino fedeltà su Garruk, Infuriato.\\n-7: Ottieni un emblema con "All\\\'inizio della tua sottofase finale, puoi passare in rassegna il tuo grimorio per una carta creatura, metterla sul campo di battaglia, poi rimescolare il tuo grimorio".\', \'type\': \'Planeswalker Leggendario — Garruk\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489017&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'23c8a56e-a6a7-4958-a8d4-efb824de7f92\', \'multiverseId\': 489017}, \'multiverseid\': 489017}, {\'name\': \'解き放たれた者、ガラク\', \'text\': \'+1：クリーチャー最大１体を対象とする。ターン終了時まで、それは＋３/＋３の修整を受けトランプルを得る。\\n-2：緑の３/３のビースト・クリーチャー・トークンを１体生成する。その後、対戦相手１人があなたより多くのクリーチャーをコントロールしているなら、解き放たれた者、ガラクの上に忠誠カウンターを１個置く。\\n-7：あなたは「あなたの終了ステップの開始時に、あなたは『あなたのライブラリーからクリーチャー・カード１枚を探し、戦場に出し、その後あなたのライブラリーを切り直す。』を選んでもよい。」を持つ紋章を得る。\', \'type\': \'伝説のプレインズウォーカー — ガラク\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489041&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6f475e90-ab4b-41db-92a1-0f16fc561bf7\', \'multiverseId\': 489041}, \'multiverseid\': 489041}, {\'name\': \'풀려난 자, 개럭\', \'text\': \'+1: 생물을 최대 한 개까지 목표로 정한다. 그 생물은 턴종료까지 +3/+3을 받고 돌진을 얻는다.\\n−2: 3/3 녹색 야수 생물 토큰 한 개를 만든다. 그 후 상대가 당신보다 생물을 많이 조종한다면, 풀려난 자, 개럭에 충성 카운터 한 개를 올려놓는다.\\n−7: 당신은 "당신의 종료단 시작에, 당신은 당신의 서고에서 생물 카드 한 장을 찾아, 전장에 놓을 수 있다. 그렇게 한다면, 당신의 서고를 섞는다."를 가진 휘장을 얻는다.\', \'type\': \'전설적 플레인즈워커 — 개럭\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489065&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e08e64de-a480-4c3c-aa94-b6230e6a0583\', \'multiverseId\': 489065}, \'multiverseid\': 489065}, {\'name\': \'Garruk, Liberto\', \'text\': \'+1: Até uma criatura alvo recebe +3/+3 e ganha atropelar até o final do turno.\\n−2: Crie uma ficha de criatura verde 3/3 do tipo Besta. Depois, se um oponente controlar mais criaturas que você, coloque um marcador de lealdade em Garruk, Liberto.\\n−7: Você recebe um emblema com "No início de sua etapa final, você pode procurar um card de criatura em seu grimório, colocá-lo no campo de batalha e depois embaralhar seu grimório".\', \'type\': \'Planeswalker Lendário — Garruk\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489089&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8b8d58c6-9248-4e64-be37-bc9dcbdf918c\', \'multiverseId\': 489089}, \'multiverseid\': 489089}, {\'name\': \'Гаррук, Неудержимый\', \'text\': \'+1: не более одного целевого существа получает +3/+3 и Пробивной удар до конца хода.\\n−2: создайте одну фишку существа 3/3 зеленый Зверь. Затем, если оппонент контролирует больше существ, чем вы, положите один жетон верности на Гаррука, Неудержимого.\\n−7: вы получаете эмблему со способностью «В начале вашего заключительного шага вы можете найти в вашей библиотеке карту существа, положить ее на поле битвы, затем перетасовать вашу библиотеку».\', \'type\': \'Легендарный Planeswalker — Гаррук\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489113&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'307b5168-3573-4b03-a827-bfa2f43400a5\', \'multiverseId\': 489113}, \'multiverseid\': 489113}, {\'name\': \'无拘贾路\', \'text\': \'+1：直到回合结束，至多一个目标生物得+3/+3且获得践踏异能。\\n-2：派出一个3/3绿色野兽衍生生物。然后如果任一对手操控的生物比你多，则在无拘贾路上放置一个忠诚指示物。\\n-7：你获得具有「在你的结束步骤开始时，你可以从你的牌库中搜寻一张生物牌，将之放进战场，然后将你的牌库洗牌」的徽记。\', \'type\': \'传奇鹏洛客 ～贾路\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489137&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'642995cc-91bc-474c-95d8-89312fc02b2e\', \'multiverseId\': 489137}, \'multiverseid\': 489137}, {\'name\': \'無拘賈路\', \'text\': \'+1：直到回合結束，至多一個目標生物得+3/+3且獲得踐踏異能。\\n−2：派出一個3/3綠色野獸衍生生物。然後如果任一對手操控的生物比你多，則在無拘賈路上放置一個忠誠指示物。\\n−7：你獲得具有「在你的結束步驟開始時，你可以從你的牌庫中搜尋一張生物牌，將之放進戰場，然後將你的牌庫洗牌」的徽記。\', \'type\': \'傳奇鵬洛客 ～賈路\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489161&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ed480b34-33f9-41b6-aa5e-704fa219e7b8\', \'multiverseId\': 489161}, \'multiverseid\': 489161}]', '[{\'name\': \'Garruk, Herold der Wildnis\', \'text\': \'+1: Decke die oberste Karte deiner Bibliothek auf. Falls es eine Kreaturenkarte ist, nimm sie auf deine Hand. Lege sie sonst unter deine Bibliothek.\\n−2: Eine Kreatur deiner Wahl, die du kontrollierst, fügt einer anderen Kreatur deiner Wahl Schadenspunkte in Höhe ihrer Stärke zu.\\n−7: Bis zum Ende des Zuges erhalten Kreaturen, die du kontrollierst, „Du kannst diese Kreatur ihren Kampfschaden zuweisen lassen, als ob sie nicht geblockt worden wäre."\', \'type\': \'Legendärer Planeswalker — Garruk\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488662&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b5dc9fda-a7df-428c-9e4c-67026288f09c\', \'multiverseId\': 488662}, \'multiverseid\': 488662}, {\'name\': \'Garruk, heraldo salvaje\', \'text\': \'+1: Muestra la primera carta de tu biblioteca. Si es una carta de criatura, ponla en tu mano. De lo contrario, pon la carta en el fondo de tu biblioteca.\\n−2: La criatura objetivo que controlas hace una cantidad de daño igual a su fuerza a otra criatura objetivo.\\n−7: Hasta el final del turno, las criaturas que controlas ganan "Puedes hacer que esta criatura haga su daño de combate como si no hubiera sido bloqueada".\', \'type\': \'Planeswalker legendario — Garruk\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488682&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0c84100e-2bf1-4fbe-aff9-36675f45f430\', \'multiverseId\': 488682}, \'multiverseid\': 488682}, {\'name\': \'Garruk, héraut sauvage\', \'text\': "+1: Révélez la carte du dessus de votre bibliothèque. Si c\'est une carte de créature, mettez-la dans votre main. Sinon, mettez-la au-dessous de votre bibliothèque.\\n-2: Une créature ciblée que vous contrôlez inflige un nombre de blessures égal à sa force à une autre créature ciblée.\\n-7: Jusqu\'à la fin du tour, les créatures que vous contrôlez acquièrent « Vous pouvez faire que cette créature attribue ses blessures de combat comme si elle n\'était pas bloquée. »", \'type\': \'Planeswalker légendaire : Garruk\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488702&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'80dbc20b-30b3-44ed-a1d7-9d62a7490d90\', \'multiverseId\': 488702}, \'multiverseid\': 488702}, {\'name\': \'Garruk, Araldo Selvaggio\', \'text\': \'+1: Rivela la prima carta del tuo grimorio. Se è una carta creatura, aggiungila alla tua mano. Altrimenti, mettila in fondo al tuo grimorio.\\n-2: Una creatura bersaglio che controlli infligge danno pari alla sua forza a un\\\'altra creatura bersaglio.\\n-7: Fino alla fine del turno, le creature che controlli hanno "Puoi far assegnare a questa creatura il suo danno da combattimento come se non fosse bloccata".\', \'type\': \'Planeswalker Leggendario — Garruk\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488722&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f6f648a0-9ad6-465e-9b80-34d922e7f85a\', \'multiverseId\': 488722}, \'multiverseid\': 488722}, {\'name\': \'野蛮な伝令、ガラク\', \'text\': \'+1：あなたのライブラリーの一番上のカードを公開する。それがクリーチャー・カードであるなら、それをあなたの手札に加える。そうでないなら、そのカードをあなたのライブラリーの一番下に置く。\\n-2：あなたがコントロールしているクリーチャー１体と、他のクリーチャー１体を対象とする。その前者はその後者に、自身のパワーに等しい点数のダメージを与える。\\n-7：ターン終了時まで、あなたがコントロールしているクリーチャーは「あなたはこのクリーチャーの戦闘ダメージを、これがブロックされなかったかのように割り振ってもよい。」を得る。\', \'type\': \'伝説のプレインズウォーカー — ガラク\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488742&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1575b3ee-407d-440d-ae0d-18afa522308f\', \'multiverseId\': 488742}, \'multiverseid\': 488742}, {\'name\': \'야만적인 전령, 개럭\', \'text\': \'+1: 당신의 서고 맨 위 카드를 공개한다. 그 카드가 생물 카드라면, 그 카드를 당신의 손으로 가져간다. 그렇지 않으면, 그 카드를 당신의 서고 맨 밑에 놓는다.\\n−2: 당신이 조종하는 생물을 목표로 정하고 다른 생물을 목표로 정한다. 첫 번째 목표는 두 번째 목표에게 자신의 공격력만큼 피해를 입힌다.\\n−7: 턴종료까지, 당신이 조종하는 생물들은 "당신은 이 생물의 전투피해를 이 생물이 방어되지 않은 것처럼 입히게 할 수 있다."를 가진다.\', \'type\': \'전설적 플레인즈워커 — 개럭\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488762&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c24f0d64-6d25-4cf1-9c95-23b3887b408a\', \'multiverseId\': 488762}, \'multiverseid\': 488762}, {\'name\': \'Garruk, Arauto Selvagem\', \'text\': \'+1: Revele o card do topo de seu grimório. Se este for um card de criatura, coloque-o em sua mão. Caso contrário, coloque-o no fundo de seu grimório.\\n−2: A criatura alvo que você controla causa dano igual ao seu poder a outra criatura alvo.\\n−7: Até o final do turno, as criaturas que você controla ganham "Você pode atribuir o dano de combate desta criatura como se ela não tivesse sido bloqueada".\', \'type\': \'Planeswalker Lendário — Garruk\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488782&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5ab78319-8e02-4741-a9de-5d21b46a7491\', \'multiverseId\': 488782}, \'multiverseid\': 488782}, {\'name\': \'Гаррук, Первобытный Предвестник\', \'text\': \'+1: покажите верхнюю карту вашей библиотеки. Если это карта существа, положите ее в вашу руку. В противном случае положите ее в низ вашей библиотеки.\\n−2: целевое существо под вашим контролем наносит повреждения, равные своей силе, другому целевому существу.\\n−7: до конца хода существа под вашим контролем получают способность «Вы можете заставить это существо распределить его боевые повреждения, как если бы оно не было заблокировано».\', \'type\': \'Легендарный Planeswalker — Гаррук\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488802&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'57213348-4e8a-416f-a87e-d5727d26701a\', \'multiverseId\': 488802}, \'multiverseid\': 488802}, {\'name\': \'蛮力具现贾路\', \'text\': \'+1：展示你的牌库顶牌。如果该牌是生物牌，则将它置于你手上。若否，则将它置于你的牌库底。\\n−2：目标由你操控的生物对另一个目标生物造成伤害，其数量等同于前者的力量。\\n−7：直到回合结束，由你操控的生物获得「你可以让此生物如同未受阻挡地分配战斗伤害。」\', \'type\': \'传奇鹏洛客 ～贾路\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488822&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'edf6ba5d-3b60-4e27-a8b8-7cc7936f3bff\', \'multiverseId\': 488822}, \'multiverseid\': 488822}, {\'name\': \'蠻力具現賈路\', \'text\': \'+1：展示你的牌庫頂牌。如果該牌是生物牌，則將它置於你手上。若否，則將它置於你的牌庫底。\\n−2：目標由你操控的生物對另一個目標生物造成傷害，其數量等同於前者的力量。\\n−7：直到回合結束，由你操控的生物獲得「你可以讓此生物如同未受阻擋地分配戰鬥傷害。」\', \'type\': \'傳奇鵬洛客 ～賈路\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488842&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'88a68b0e-03fe-4037-aed5-27a071dcf0b5\', \'multiverseId\': 488842}, \'multiverseid\': 488842}]', '[{\'name\': \'Garruks Aufstand\', \'text\': \'Wenn Garruks Aufstand ins Spiel kommt und falls du eine Kreatur mit Stärke 4 oder mehr kontrollierst, ziehe eine Karte.\\nKreaturen, die du kontrollierst, verursachen Trampelschaden. (Sie können überschüssigen Kampfschaden dem verteidigenden Spieler oder Planeswalker zufügen.)\\nImmer wenn eine Kreatur mit Stärke 4 oder mehr unter deiner Kontrolle ins Spiel kommt, ziehe eine Karte.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485768&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'49413046-4b7f-4320-b701-c8c7e039b21d\', \'multiverseId\': 485768}, \'multiverseid\': 485768}, {\'name\': \'Alzamiento de Garruk\', \'text\': \'Cuando el Alzamiento de Garruk entre al campo de batalla, si controlas una criatura con fuerza de 4 o más, roba una carta.\\nLas criaturas que controlas tienen la habilidad de arrollar. (Pueden hacer el daño de combate sobrante al jugador o planeswalker al que atacan.)\\nSiempre que una criatura con fuerza de 4 o más entre al campo de batalla bajo tu control, roba una carta.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486027&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1816769c-8a61-4385-80e0-e2fe2e737a27\', \'multiverseId\': 486027}, \'multiverseid\': 486027}, {\'name\': \'Soulèvement de Garruk\', \'text\': "Quand le Soulèvement de Garruk arrive sur le champ de bataille, si vous contrôlez une créature de force supérieure ou égale à 4, piochez une carte.\\nLes créatures que vous contrôlez ont le piétinement. (Elles peuvent infliger leur surplus de blessures de combat au joueur ou au planeswalker qu\'elles attaquent.)\\nÀ chaque fois qu\'une créature avec une force supérieure ou égale à 4 arrive sur le champ de bataille sous votre contrôle, piochez une carte.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486286&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'509bd259-f966-424a-b1a0-c7e9aed21f30\', \'multiverseId\': 486286}, \'multiverseid\': 486286}, {\'name\': \'Insurrezione di Garruk\', \'text\': "Quando l\'Insurrezione di Garruk entra nel campo di battaglia, se controlli una creatura con forza pari o superiore a 4, pesca una carta.\\nLe creature che controlli hanno travolgere. (Possono infliggere il danno da combattimento in eccesso al giocatore o al planeswalker che stanno attaccando.)\\nOgniqualvolta una creatura con forza pari o superiore a 4 entra nel campo di battaglia sotto il tuo controllo, pesca una carta.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486545&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f5eea84c-fb42-4af4-bace-49d8378405b8\', \'multiverseId\': 486545}, \'multiverseid\': 486545}, {\'name\': \'ガラクの蜂起\', \'text\': \'ガラクの蜂起が戦場に出たとき、あなたがパワーが４以上のクリーチャーをコントロールしている場合、カードを１枚引く。\\nあなたがコントロールしているクリーチャーはトランプルを持つ。（それらは余剰の戦闘ダメージを、それらが攻撃しているプレイヤーやプレインズウォーカーに与えることができる。）\\nパワーが４以上のクリーチャーが１体あなたのコントロール下で戦場に出るたび、カードを１枚引く。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486804&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c117106a-f54f-4b54-8cff-82a3540058eb\', \'multiverseId\': 486804}, \'multiverseid\': 486804}, {\'name\': \'개럭의 폭동\', \'text\': \'개럭의 폭동이 전장에 들어올 때, 당신이 공격력이 4 이상인 생물을 조종한다면, 카드 한 장을 뽑는다.\\n당신이 조종하는 생물들은 돌진을 가진다. (그 생물들은 여분의 전투피해를 자신이 공격 중인 플레이어 또는 플레인즈워커에게 입힐 수 있다.)\\n공격력이 4 이상인 생물이 당신의 조종하에 전장에 들어올 때마다, 카드 한 장을 뽑는다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487063&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'508e4571-259f-4779-b8a0-bb201ca2a9f8\', \'multiverseId\': 487063}, \'multiverseid\': 487063}, {\'name\': \'Levante de Garruk\', \'text\': \'Quando Levante de Garruk entrar no campo de batalha, se você controlar uma criatura com poder igual ou superior a 4, compre um card.\\nAs criaturas que você controla têm atropelar. (Elas podem causar seu dano de combate excedente ao jogador ou planeswalker que elas estiverem atacando.)\\nToda vez que uma criatura com poder igual ou superior a 4 entrar no campo de batalha sob seu controle, compre um card.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487322&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7f5fab4d-6d9c-4ff8-a55d-56327331efe3\', \'multiverseId\': 487322}, \'multiverseid\': 487322}, {\'name\': \'Бунт Гаррука\', \'text\': "Когда Бунт Гаррука выходит на поле битвы, если вы контролируете существо с силой не менее 4, возьмите карту.\\nСущества под вашим контролем имеют Пробивной удар. (Они могут нанести избыточные боевые повреждения игроку или planeswalker\'у, которого атакуют.)\\nКаждый раз, когда существо с силой 4 или больше выходит на поле битвы под вашим контролем, возьмите карту.", \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487581&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'36b84d6b-5372-4f66-a0ac-e39197279a0d\', \'multiverseId\': 487581}, \'multiverseid\': 487581}, {\'name\': \'贾路的反抗\', \'text\': \'当贾路的反抗进战场时，若你操控力量等于或大于4的生物，则抓一张牌。\\n由你操控的生物具有践踏异能。（它们造成之过量战斗伤害能对所攻击的牌手或鹏洛客造成之。）\\n每当一个力量等于或大于4的生物在你的操控下进战场时，抓一张牌。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487840&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'87583cd6-7d9c-4876-aabf-3e0361f23d1b\', \'multiverseId\': 487840}, \'multiverseid\': 487840}, {\'name\': \'賈路的反抗\', \'text\': \'當賈路的反抗進戰場時，若你操控力量等於或大於4的生物，則抽一張牌。\\n由你操控的生物具有踐踏異能。（它們造成之過量戰鬥傷害能對所攻擊的玩家或鵬洛客造成之。）\\n每當一個力量等於或大於4的生物在你的操控下進戰場時，抽一張牌。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488099&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3666a1aa-92f1-4a35-89db-ba66a0a0af01\', \'multiverseId\': 488099}, \'multiverseid\': 488099}]', '[{\'name\': \'Garruks Aufstand\', \'text\': \'Wenn Garruks Aufstand ins Spiel kommt und falls du eine Kreatur mit Stärke 4 oder mehr kontrollierst, ziehe eine Karte.\\nKreaturen, die du kontrollierst, verursachen Trampelschaden.\\nImmer wenn eine Kreatur mit Stärke 4 oder mehr unter deiner Kontrolle ins Spiel kommt, ziehe eine Karte.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488948&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b1a126a7-ab93-4c0c-8648-c2d15364eb23\', \'multiverseId\': 488948}, \'multiverseid\': 488948}, {\'name\': \'Alzamiento de Garruk\', \'text\': \'Cuando el Alzamiento de Garruk entre al campo de batalla, si controlas una criatura con fuerza de 4 o más, roba una carta.\\nLas criaturas que controlas tienen la habilidad de arrollar.\\nSiempre que una criatura con fuerza de 4 o más entre al campo de batalla bajo tu control, roba una carta.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488972&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'af226c3f-f646-42b8-a4df-b3c16748bf36\', \'multiverseId\': 488972}, \'multiverseid\': 488972}, {\'name\': \'Soulèvement de Garruk\', \'text\': "Quand le Soulèvement de Garruk arrive sur le champ de bataille, si vous contrôlez une créature de force supérieure ou égale à 4, piochez une carte.\\nLes créatures que vous contrôlez ont le piétinement.\\nÀ chaque fois qu\'une créature avec une force supérieure ou égale à 4 arrive sur le champ de bataille sous votre contrôle, piochez une carte.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488996&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'97717b9a-85d6-460d-88f8-ce4dd2842131\', \'multiverseId\': 488996}, \'multiverseid\': 488996}, {\'name\': \'Insurrezione di Garruk\', \'text\': "Quando l\'Insurrezione di Garruk entra nel campo di battaglia, se controlli una creatura con forza pari o superiore a 4, pesca una carta.\\nLe creature che controlli hanno travolgere.\\nOgniqualvolta una creatura con forza pari o superiore a 4 entra nel campo di battaglia sotto il tuo controllo, pesca una carta.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489020&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9e353208-e79e-4077-9bad-bb08c4c5de51\', \'multiverseId\': 489020}, \'multiverseid\': 489020}, {\'name\': \'ガラクの蜂起\', \'text\': \'ガラクの蜂起が戦場に出たとき、あなたがパワーが４以上のクリーチャーをコントロールしている場合、カードを１枚引く。\\nあなたがコントロールするクリーチャーはトランプルを持つ。\\nパワーが４以上のクリーチャーが１体あなたのコントロール下で戦場に出るたび、カードを１枚引く。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489044&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'61038cef-61e1-45ce-9241-bc89512f23f3\', \'multiverseId\': 489044}, \'multiverseid\': 489044}, {\'name\': \'개럭의 폭동\', \'text\': \'개럭의 폭동이 전장에 들어올 때, 당신이 공격력이 4 이상인 생물을 조종한다면, 카드 한 장을 뽑는다.\\n당신이 조종하는 생물들은 돌진을 가진다.\\n공격력이 4 이상인 생물이 당신의 조종하에 전장에 들어올 때마다, 카드 한 장을 뽑는다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489068&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'680d8993-bab9-4a54-995a-1e8e9f3027e4\', \'multiverseId\': 489068}, \'multiverseid\': 489068}, {\'name\': \'Levante de Garruk\', \'text\': \'Quando Levante de Garruk entrar no campo de batalha, se você controlar uma criatura com poder igual ou superior a 4, compre um card.\\nAs criaturas que você controla têm atropelar.\\nToda vez que uma criatura com poder igual ou superior a 4 entrar no campo de batalha sob seu controle, compre um card.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489092&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cae2cbcb-b7e5-4727-bced-89cf362beed9\', \'multiverseId\': 489092}, \'multiverseid\': 489092}, {\'name\': \'Бунт Гаррука\', \'text\': \'Когда Бунт Гаррука выходит на поле битвы, если вы контролируете существо с силой не менее 4, возьмите карту.\\nСущества под вашим контролем имеют Пробивной удар.\\nКаждый раз, когда существо с силой 4 или больше выходит на поле битвы под вашим контролем, возьмите карту.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489116&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'303cee6d-739d-4f85-92b0-439923089f0a\', \'multiverseId\': 489116}, \'multiverseid\': 489116}, {\'name\': \'贾路的反抗\', \'text\': \'当贾路的反抗进战场时，若你操控力量等于或大于4的生物，则抓一张牌。\\n由你操控的生物具有践踏异能。\\n每当一个力量等于或大于4的生物在你的操控下进战场时，抓一张牌。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489140&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'da701632-1159-46df-b78d-8c5c46b774d2\', \'multiverseId\': 489140}, \'multiverseid\': 489140}, {\'name\': \'賈路的反抗\', \'text\': \'當賈路的反抗進戰場時，若你操控力量等於或大於4的生物，則抽一張牌。\\n由你操控的生物具有踐踏異能。\\n每當一個力量等於或大於4的生物在你的操控下進戰場時，抽一張牌。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489164&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1886beae-5331-4dc2-973c-9af3ab8fc368\', \'multiverseId\': 489164}, \'multiverseid\': 489164}]', '[{\'name\': \'Garruks Bluthorn\', \'type\': \'Kreatur — Bestie\', \'flavor\': \'„Es gerät nach seinem Meister: groß, brutal und man riecht es bereits auf eine Meile."\\n—Liliana Vess\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485766&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'773138fe-ace5-40ae-ae2d-1346cb8d38cd\', \'multiverseId\': 485766}, \'multiverseid\': 485766}, {\'name\': \'Corneador de Garruk\', \'type\': \'Criatura — Bestia\', \'flavor\': \'"Desde luego se parece a su amo: es grande, bruto y puedes olerlo a más de un kilómetro".\\n—Liliana Vess\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486025&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'49ed0daa-e3e6-4414-95aa-5fa04b0d6dcc\', \'multiverseId\': 486025}, \'multiverseid\': 486025}, {\'name\': \'Corneboyaux de Garruk\', \'type\': \'Créature : bête\', \'flavor\': "« On voit qu\'il tient de son maître : c\'est une grande brute que l\'on peut sentir à des kilomètres. »\\n—Liliana Vess", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486284&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'74eaa696-1aed-444b-8bc2-ce4eb8a020d7\', \'multiverseId\': 486284}, \'multiverseid\': 486284}, {\'name\': \'Sventracorno di Garruk\', \'type\': \'Creatura — Bestia\', \'flavor\': \'"Senza dubbio ha preso molto dal suo padrone: è grosso e rozzo... e l\\\'odore si sente a un chilometro di distanza."\\n—Liliana Vess\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486543&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d3307579-d8e7-4fab-88f4-3a94a51960e0\', \'multiverseId\': 486543}, \'multiverseid\': 486543}, {\'name\': \'ガラクの血まみれ角\', \'type\': \'クリーチャー — ビースト\', \'flavor\': \'「本当にあれはご主人さまにそっくりね。大きくて、無礼で、ずっと遠くにいても臭い。」\\n――リリアナ・ヴェス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486802&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7415dc13-2b8f-435a-a806-c882680a3da3\', \'multiverseId\': 486802}, \'multiverseid\': 486802}, {\'name\': \'개럭의 충돌뿔\', \'type\': \'생물 — 야수\', \'flavor\': \'"확실히 자기 주인을 꼭 닮았군. 크고 난폭한 데다가, 멀리 떨어진 곳에서도 냄새를 맡을 수 있으니 말이야."\\n—릴리아나 베스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487061&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4849a6ad-147f-44d3-a687-17c4a895a8ef\', \'multiverseId\': 487061}, \'multiverseid\': 487061}, {\'name\': \'Escorneador de Garruk\', \'type\': \'Criatura — Besta\', \'flavor\': \'"Com certeza ele tem muito do mestre: é grande, bruto e dá pra sentir o cheiro de longe."\\n— Liliana Vess\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487320&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'aabf4785-8d8b-4b21-b102-dfab190fe353\', \'multiverseId\': 487320}, \'multiverseid\': 487320}, {\'name\': \'Остророг Гаррука\', \'type\': \'Существо — Зверь\', \'flavor\': \'«Он определенно похож на хозяина: здоровенный, злобный, и несет от него так, что за милю чувствуешь».\\n— Лилиана Весс\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487579&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'766ac585-3acd-4027-afa2-4ad6c2031627\', \'multiverseId\': 487579}, \'multiverseid\': 487579}, {\'name\': \'贾路的贯角兽\', \'type\': \'生物 ～野兽\', \'flavor\': \'「它确实跟其主子一样：身躯庞大，脾气暴躁，而且一哩开外就能闻到气味。」\\n～莉莲娜维斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487838&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b5f9011d-2af0-4cf7-9d41-ab02166ab706\', \'multiverseId\': 487838}, \'multiverseid\': 487838}, {\'name\': \'賈路的貫角獸\', \'type\': \'生物 ～野獸\', \'flavor\': \'「牠確實跟其主子一樣：身軀龐大，脾氣暴躁，而且一哩開外就能聞到氣味。」\\n～莉蓮娜維斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488097&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ce3fddbf-0dfb-4e3d-a738-f33269508695\', \'multiverseId\': 488097}, \'multiverseid\': 488097}]', "[{'name': 'Garruks Bluthorn', 'type': 'Kreatur — Bestie', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488946&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c81b9be0-de56-41a9-8767-e0a2abc68c26', 'multiverseId': 488946}, 'multiverseid': 488946}, {'name': 'Corneador de Garruk', 'type': 'Criatura — Bestia', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488970&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '9b6edd2d-aa9a-4521-803e-b2f80ea15ea8', 'multiverseId': 488970}, 'multiverseid': 488970}, {'name': 'Corneboyaux de Garruk', 'type': 'Créature : bête', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488994&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'bfefcda3-824b-40f8-b19f-fa686f61a8bb', 'multiverseId': 488994}, 'multiverseid': 488994}, {'name': 'Sventracorno di Garruk', 'type': 'Creatura — Bestia', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489018&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '2da7c3d6-cc75-4320-94cf-d892bd8f34c3', 'multiverseId': 489018}, 'multiverseid': 489018}, {'name': 'ガラクの血まみれ角', 'type': 'クリーチャー — ビースト', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489042&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '0018e709-7f42-4393-b024-a1ad4c71cd9b', 'multiverseId': 489042}, 'multiverseid': 489042}, {'name': '개럭의 충돌뿔', 'type': '생물 — 야수', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489066&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'b553b184-d980-43b2-8a89-d6091e35711a', 'multiverseId': 489066}, 'multiverseid': 489066}, {'name': 'Escorneador de Garruk', 'type': 'Criatura — Besta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489090&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '6a068186-331f-4857-8d2e-58e80def58ad', 'multiverseId': 489090}, 'multiverseid': 489090}, {'name': 'Остророг Гаррука', 'type': 'Существо — Зверь', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489114&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '7f5df837-44ef-421f-9cbd-a2385c551f1a', 'multiverseId': 489114}, 'multiverseid': 489114}, {'name': '贾路的贯角兽', 'type': '生物 ～野兽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489138&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '85b844cb-dc10-40f1-bc96-eb4bea5c65a2', 'multiverseId': 489138}, 'multiverseid': 489138}, {'name': '賈路的貫角獸', 'type': '生物 ～野獸', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489162&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'fda77769-6e4b-40f0-acd9-cafab763dcc4', 'multiverseId': 489162}, 'multiverseid': 489162}]", "[{'name': 'Garruks Streitross', 'text': 'Wachsamkeit\\nWenn Garruks Streitross ins Spiel kommt, kannst du deine Bibliothek und/oder deinen Friedhof nach einer Karte namens Garruk, Herold der Wildnis, durchsuchen, sie offen vorzeigen und auf deine Hand nehmen. Falls du auf diese Weise deine Bibliothek durchsuchst, mische sie danach.', 'type': 'Kreatur — Nashorn', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488663&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd64ceee9-4192-4d0a-8564-3fb0570fe860', 'multiverseId': 488663}, 'multiverseid': 488663}, {'name': 'Montura de guerra de Garruk', 'text': 'Vigilancia.\\nCuando la Montura de guerra de Garruk entre al campo de batalla, puedes buscar en tu biblioteca y/o cementerio una carta llamada Garruk, heraldo salvaje, mostrarla y ponerla en tu mano. Si buscas en tu biblioteca de esta manera, barájala.', 'type': 'Criatura — Rinoceronte', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488683&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '84d5e3c3-56a3-44e3-8dcb-819fbe6bb7c8', 'multiverseId': 488683}, 'multiverseid': 488683}, {'name': 'Destrier de guerre de Garruk', 'text': 'Vigilance\\nQuand le Destrier de guerre de Garruk arrive sur le champ de bataille, vous pouvez chercher dans votre bibliothèque et/ou votre cimetière une carte appelée Garruk, héraut sauvage, la révéler et la mettre dans votre main. Si vous cherchez dans votre bibliothèque de cette manière, mélangez-la.', 'type': 'Créature : rhinocéros', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488703&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b22c5a05-9d95-400d-ab97-c934e411e160', 'multiverseId': 488703}, 'multiverseid': 488703}, {'name': 'Destriero da Guerra di Garruk', 'text': 'Cautela\\nQuando il Destriero da Guerra di Garruk entra nel campo di battaglia, puoi passare in rassegna il tuo grimorio e/o il tuo cimitero per una carta chiamata Garruk, Araldo Selvaggio, rivelarla e aggiungerla alla tua mano. Se passi in rassegna il tuo grimorio in questo modo, rimescolalo.', 'type': 'Creatura — Rinoceronte', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488723&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '9bdaec0d-1310-48a0-8a65-c089cd79034e', 'multiverseId': 488723}, 'multiverseid': 488723}, {'name': 'ガラクの戦騎', 'text': '警戒\\nガラクの戦騎が戦場に出たとき、あなたは、あなたのライブラリーやあなたの墓地から「野蛮な伝令、ガラク」という名前のカード１枚を探し、公開し、あなたの手札に加えてもよい。これによりあなたがあなたのライブラリーからカードを探したなら、あなたのライブラリーを切り直す。', 'type': 'クリーチャー — サイ', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488743&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'c69b412a-abcf-4abe-b9dd-4df22f72d0a9', 'multiverseId': 488743}, 'multiverseid': 488743}, {'name': '개럭의 전쟁코뿔소', 'text': '경계\\n개럭의 전쟁코뿔소가 전장에 들어올 때, 당신은 당신의 서고 및/또는 무덤에서 야만적인 전령, 개럭인 카드 한 장을 찾아, 공개한 후, 당신의 손으로 가져갈 수 있다. 당신이 이런 식으로 당신의 서고를 찾아보았다면, 당신의 서고를 섞는다.', 'type': '생물 — 코뿔소', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488763&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '21c88fee-7814-40b4-8080-a9d7b65fc907', 'multiverseId': 488763}, 'multiverseid': 488763}, {'name': 'Montaria de Guerra de Garruk', 'text': 'Vigilância\\nQuando Montaria de Guerra de Garruk entra no campo de batalha, você pode procurar em seu grimório e/ou cemitério um card com o nome Garruk, Arauto Selvagem, revelá-lo e colocá-lo em sua mão. Se procurar em seu grimório desta maneira, embaralhe-o.', 'type': 'Criatura — Rinoceronte', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488783&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3ea33ff0-621e-46c0-9a1a-084f03eacaa4', 'multiverseId': 488783}, 'multiverseid': 488783}, {'name': 'Боевой Скакун Гаррука', 'text': 'Бдительность\\nКогда Боевой Скакун Гаррука выходит на поле битвы, вы можете найти в вашей библиотеке и/или на вашем кладбище карту с именем Гаррук, Первобытный Предвестник, показать ее и положить в вашу руку. Если вы ищете таким образом в вашей библиотеке, перетасуйте ее.', 'type': 'Существо — Носорог', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488803&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'c7266cd8-4f43-436c-8966-555f4fa69399', 'multiverseId': 488803}, 'multiverseid': 488803}, {'name': '贾路的战骑', 'text': '警戒\\n当贾路的战骑进战场时，你可以从你的牌库和／或坟墓场中搜寻一张名称为蛮力具现贾路的牌，展示该牌，并将它置于你手上。如果你以此法搜寻你的牌库，则将它洗牌。', 'type': '生物 ～犀牛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488823&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'cd64a3af-27eb-4a41-b596-3de5498b6f04', 'multiverseId': 488823}, 'multiverseid': 488823}, {'name': '賈路的戰騎', 'text': '警戒\\n當賈路的戰騎進戰場時，你可以從你的牌庫和／或墳墓場中搜尋一張名稱為蠻力具現賈路的牌，展示該牌，並將它置於你手上。如果你以此法搜尋你的牌庫，則將它洗牌。', 'type': '生物 ～犀牛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488843&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '081dbd62-90e7-419a-97a2-49e70181f635', 'multiverseId': 488843}, 'multiverseid': 488843}]", '[{\'name\': \'Garruks Vorbote\', \'text\': \'Fluchsicher vor Schwarz\\nImmer wenn Garruks Vorbote einem Spieler oder Planeswalker Kampfschaden zufügt, schaue dir entsprechend viele Karten oben von deiner Bibliothek an. Du kannst davon eine Kreaturen- oder Garruk-Planeswalkerkarte offen vorzeigen und auf deine Hand nehmen. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.\', \'type\': \'Kreatur — Bestie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485767&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b311eac0-e06a-4c04-bbe3-ef54e15c517f\', \'multiverseId\': 485767}, \'multiverseid\': 485767}, {\'name\': \'Heraldo de Garruk\', \'text\': \'Antimaleficio contra negro.\\nSiempre que el Heraldo de Garruk haga daño de combate a un jugador o planeswalker, mira esa misma cantidad de cartas de la parte superior de tu biblioteca. Puedes mostrar una carta de criatura o de planeswalker Garruk que se encuentre entre ellas y ponerla en tu mano. Pon el resto en el fondo de tu biblioteca en un orden aleatorio.\', \'type\': \'Criatura — Bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486026&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c52ed9f9-1382-43bb-a2ae-328935178546\', \'multiverseId\': 486026}, \'multiverseid\': 486026}, {\'name\': \'Annonciateur de Garruk\', \'text\': "Défense talismanique contre le noir\\n\\x81À chaque fois que l\'Annonciateur de Garruk inflige des blessures de combat à un joueur ou à un planeswalker, regardez autant de cartes du dessus de votre bibliothèque. Vous pouvez révéler une carte de créature ou une carte de planeswalker Garruk parmi elles et la mettre dans votre main. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.", \'type\': \'Créature : bête\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486285&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3c2acb67-7fd6-4ff3-b72b-82e52e8b8a13\', \'multiverseId\': 486285}, \'multiverseid\': 486285}, {\'name\': \'Messaggero di Garruk\', \'text\': \'Anti-malocchio dal nero\\nOgniqualvolta il Messaggero di Garruk infligge danno da combattimento a un giocatore o a un planeswalker, guarda altrettante carte dalla cima del tuo grimorio. Puoi rivelare una carta creatura o una carta planeswalker Garruk scelta tra esse e aggiungerla alla tua mano. Metti le altre in fondo al tuo grimorio in ordine casuale.\', \'type\': \'Creatura — Bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486544&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4b277f5c-26ac-4269-86d0-2c874ab6e0de\', \'multiverseId\': 486544}, \'multiverseid\': 486544}, {\'name\': \'ガラクの先触れ\', \'text\': \'黒からの呪禁\\nガラクの先触れがプレイヤー１人かプレインズウォーカー１体に戦闘ダメージを与えるたび、あなたのライブラリーの一番上からカードをその点数に等しい枚数見る。あなたはその中から、クリーチャー・カード１枚かガラク・プレインズウォーカー・カード１枚を公開し、あなたの手札に加えてもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'クリーチャー — ビースト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486803&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8206fff9-d437-4a74-9f9d-2764998cd5c9\', \'multiverseId\': 486803}, \'multiverseid\': 486803}, {\'name\': \'개럭의 전조\', \'text\': \'흑색으로부터 방호\\n개럭의 전조가 플레이어 또는 플레인즈워커에게 전투피해를 입힐 때마다, 당신의 서고 맨 위에서 그 피해만큼의 카드를 본다. 당신은 그중 생물 또는 개럭 플레인즈워커 카드 한 장을 공개하고 당신의 손으로 가져갈 수 있다. 나머지 카드들은 무작위 순서로 당신의 서고 맨 밑에 놓는다.\', \'type\': \'생물 — 야수\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487062&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1710d28e-bbb8-4c94-95f3-1a6aab9598c2\', \'multiverseId\': 487062}, \'multiverseid\': 487062}, {\'name\': \'Anunciador de Garruk\', \'text\': \'Resistência à magia preta\\nToda vez que Anunciador de Garruk causar dano de combate a um jogador ou planeswalker, olhe aquela quantidade de cards do topo de seu grimório. Você pode revelar um card de criatura ou de planeswalker Garruk dentre eles e colocá-lo em sua mão. Coloque o restante no fundo de seu grimório em ordem aleatória.\', \'type\': \'Criatura — Besta\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487321&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'299f08a6-e67e-4fcd-98eb-fe4b18795528\', \'multiverseId\': 487321}, \'multiverseid\': 487321}, {\'name\': \'Предвестник Гаррука\', \'text\': "Порчеустойчивость от черного\\nКаждый раз, когда Предвестник Гаррука наносит боевые повреждения игроку или planeswalker\'у, посмотрите такое же количество карт с верха вашей библиотеки. Вы можете показать находящуюся среди них карту существа или карту planeswalker\'а Гаррука и положить ее в вашу руку. Положите остальные карты в низ вашей библиотеки в случайном порядке.", \'type\': \'Существо — Зверь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487580&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c668f67a-d517-4f29-8dfc-338068f71902\', \'multiverseId\': 487580}, \'multiverseid\': 487580}, {\'name\': \'贾路的开路兽\', \'text\': \'反黑辟邪\\n每当贾路的开路兽对任一牌手或鹏洛客造成战斗伤害时，检视你牌库顶等量的牌。你可以展示其中的一张生物牌或贾路鹏洛客牌，并将它置于你手上。将其余的牌以随机顺序置于你的牌库底。\', \'type\': \'生物 ～野兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487839&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'561c29b8-18a5-45dd-abac-e7c48ba25883\', \'multiverseId\': 487839}, \'multiverseid\': 487839}, {\'name\': \'賈路的開路獸\', \'text\': \'反黑辟邪\\n每當賈路的開路獸對任一玩家或鵬洛客造成戰鬥傷害時，檢視你牌庫頂等量的牌。你可以展示其中的一張生物牌或賈路鵬洛客牌，並將它置於你手上。將其餘的牌以隨機順序置於你的牌庫底。\', \'type\': \'生物 ～野獸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488098&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f0e44a71-4d04-439f-a83d-9dfb5f3096d9\', \'multiverseId\': 488098}, \'multiverseid\': 488098}]', '[{\'name\': \'Garruks Vorbote\', \'text\': \'Fluchsicher vor Schwarz\\nImmer wenn Garruks Vorbote einem Spieler oder Planeswalker Kampfschaden zufügt, schaue dir entsprechend viele Karten oben von deiner Bibliothek an. Du kannst davon eine Kreaturen- oder Garruk-Planeswalkerkarte offen vorzeigen und auf deine Hand nehmen. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.\', \'type\': \'Kreatur — Bestie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488947&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'65f5c572-26d1-4e11-8cf4-c406f62af3b3\', \'multiverseId\': 488947}, \'multiverseid\': 488947}, {\'name\': \'Heraldo de Garruk\', \'text\': \'Antimaleficio contra negro.\\nSiempre que el Heraldo de Garruk haga daño de combate a un jugador o planeswalker, mira esa misma cantidad de cartas de la parte superior de tu biblioteca. Puedes mostrar una carta de criatura o de planeswalker Garruk que se encuentre entre ellas y ponerla en tu mano. Pon el resto en el fondo de tu biblioteca en un orden aleatorio.\', \'type\': \'Criatura — Bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488971&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0f8a42c7-81cc-4b6c-9fe1-e12f25f04f6c\', \'multiverseId\': 488971}, \'multiverseid\': 488971}, {\'name\': \'Annonciateur de Garruk\', \'text\': "Défense talismanique contre le noir\\n\\x81À chaque fois que l\'Annonciateur de Garruk inflige des blessures de combat à un joueur ou à un planeswalker, regardez autant de cartes du dessus de votre bibliothèque. Vous pouvez révéler une carte de créature ou une carte de planeswalker Garruk parmi elles et la mettre dans votre main. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.", \'type\': \'Créature : bête\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488995&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bcb9e6d6-cfb5-426a-bba8-4eb4137fe188\', \'multiverseId\': 488995}, \'multiverseid\': 488995}, {\'name\': \'Messaggero di Garruk\', \'text\': \'Anti-malocchio dal nero\\nOgniqualvolta il Messaggero di Garruk infligge danno da combattimento a un giocatore o a un planeswalker, guarda altrettante carte dalla cima del tuo grimorio. Puoi rivelare una carta creatura o una carta planeswalker Garruk scelta tra esse e aggiungerla alla tua mano. Metti le altre in fondo al tuo grimorio in ordine casuale.\', \'type\': \'Creatura — Bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489019&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7cf4ea1b-dc9a-402f-9e3b-feffb5330d48\', \'multiverseId\': 489019}, \'multiverseid\': 489019}, {\'name\': \'ガラクの先触れ\', \'text\': \'黒からの呪禁\\nガラクの先触れがプレイヤー１人かプレインズウォーカー１体に戦闘ダメージを与えるたび、あなたのライブラリーの一番上からカードをその点数に等しい枚数見る。あなたはその中から、クリーチャー・カード１枚かガラク・プレインズウォーカー・カード１枚を公開し、あなたの手札に加えてもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'クリーチャー — ビースト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489043&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'41bdcfb9-aec9-429b-812d-364ab8e69fef\', \'multiverseId\': 489043}, \'multiverseid\': 489043}, {\'name\': \'개럭의 전조\', \'text\': \'흑색으로부터 방호\\n개럭의 전조가 플레이어 또는 플레인즈워커에게 전투피해를 입힐 때마다, 당신의 서고 맨 위에서 그 피해만큼의 카드를 본다. 당신은 그중 생물 또는 개럭 플레인즈워커 카드 한 장을 공개하고 당신의 손으로 가져갈 수 있다. 나머지 카드들은 무작위 순서로 당신의 서고 맨 놓에 넣는다.\', \'type\': \'생물 — 야수\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489067&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5cc71871-889e-4388-8b53-6d00db57bb5e\', \'multiverseId\': 489067}, \'multiverseid\': 489067}, {\'name\': \'Anunciador de Garruk\', \'text\': \'Resistência à magia preta\\nToda vez que Anunciador de Garruk causar dano de combate a um jogador ou planeswalker, olhe aquela quantidade de cards do topo de seu grimório. Você pode revelar um card de criatura ou de planeswalker Garruk dentre eles e colocá-lo em sua mão. Coloque o restante no fundo de seu grimório em ordem aleatória.\', \'type\': \'Criatura — Besta\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489091&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'aeacb989-eb0a-4508-9327-0feda7142a9c\', \'multiverseId\': 489091}, \'multiverseid\': 489091}, {\'name\': \'Предвестник Гаррука\', \'text\': "Порчеустойчивость от черного\\nКаждый раз, когда Предвестник Гаррука наносит боевые повреждения игроку или planeswalker\'у, посмотрите такое же количество карт с верха вашей библиотеки. Вы можете показать находящуюся среди них карту существа или карту planeswalker\'а Гаррука и положить ее в вашу руку. Положите остальные карты в низ вашей библиотеки в случайном порядке.", \'type\': \'Существо — Зверь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489115&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1780a484-4153-4c82-bb8f-3f00010f3f05\', \'multiverseId\': 489115}, \'multiverseid\': 489115}, {\'name\': \'贾路的开路兽\', \'text\': \'反黑辟邪\\n每当贾路的开路兽对任一牌手或鹏洛客造成战斗伤害时，检视你牌库顶等量的牌。你可以展示其中的一张生物牌或贾路鹏洛客牌，并将它置于你手上。将其余的牌以随机顺序置于你的牌库底。\', \'type\': \'生物 ～野兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489139&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f757aab6-5ca7-47bc-8332-fee12639b741\', \'multiverseId\': 489139}, \'multiverseid\': 489139}, {\'name\': \'賈路的開路獸\', \'text\': \'反黑辟邪\\n每當賈路的開路獸對任一玩家或鵬洛客造成戰鬥傷害時，檢視你牌庫頂等量的牌。你可以展示其中的一張生物牌或賈路鵬洛客牌，並將它置於你手上。將其餘的牌以隨機順序置於你的牌庫底。\', \'type\': \'生物 ～野獸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489163&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'372e02f6-9008-4292-a323-b43e29d38a94\', \'multiverseId\': 489163}, \'multiverseid\': 489163}]', "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488485&type=card', 'language': 'German', 'identifiers': {'scryfallId': '1ca37100-9639-4ce0-8f9e-57080fda1f79', 'multiverseId': 488485}, 'multiverseid': 488485}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488500&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '0481558e-c369-4942-aea4-526fbb7528f7', 'multiverseId': 488500}, 'multiverseid': 488500}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488515&type=card', 'language': 'French', 'identifiers': {'scryfallId': '95d04448-88dc-414a-a8ef-d1e44658eee6', 'multiverseId': 488515}, 'multiverseid': 488515}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488530&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '945143b1-7354-4f71-9fa9-184753727513', 'multiverseId': 488530}, 'multiverseid': 488530}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488545&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '268d9a17-7209-4f04-9863-1f7e30d6c79b', 'multiverseId': 488545}, 'multiverseid': 488545}, {'name': '산', 'type': '기본 대지 — 산', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488560&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '2df6dc03-4f51-451a-a98a-d5406a0cd567', 'multiverseId': 488560}, 'multiverseid': 488560}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488575&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5b3aef81-aff8-4517-a3fc