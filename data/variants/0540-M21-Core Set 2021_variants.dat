山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488547&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'e22c2bd3-94ff-47ec-920c-214e3586aec0', 'multiverseId': 488547}, 'multiverseid': 488547}, {'name': '산', 'type': '기본 대지 — 산', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488562&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '36fc0b78-2169-4862-a6eb-5e8489d1b172', 'multiverseId': 488562}, 'multiverseid': 488562}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488577&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f66f06ed-1207-474c-ba3d-78876bedd85f', 'multiverseId': 488577}, 'multiverseid': 488577}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488592&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'e1d9145e-4f58-4ba6-9d78-2469f05d85e4', 'multiverseId': 488592}, 'multiverseid': 488592}, {'name': '山脉', 'type': '基本地 ～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488607&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '64584fe8-d52e-4385-82de-473ba1f73800', 'multiverseId': 488607}, 'multiverseid': 488607}, {'name': '山脈', 'type': '基本地 ～山脈', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488622&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '094ffff5-ba68-413e-9b36-75b4d4b593ef', 'multiverseId': 488622}, 'multiverseid': 488622}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488854&type=card', 'language': 'German', 'identifiers': {'scryfallId': '36aeda45-eaad-460f-b1d9-6d945bc6175d', 'multiverseId': 488854}, 'multiverseid': 488854}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488859&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '02431300-021a-4aef-a18e-2c2f474ebf76', 'multiverseId': 488859}, 'multiverseid': 488859}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488864&type=card', 'language': 'French', 'identifiers': {'scryfallId': '6c80161c-f08c-45e2-9eaf-9fa8fe78e45b', 'multiverseId': 488864}, 'multiverseid': 488864}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488869&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '2fd8e1d2-53ec-4f99-80c4-6f777ee09931', 'multiverseId': 488869}, 'multiverseid': 488869}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488874&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '4f5ac1b2-4b44-4d65-93d7-99affdbd33dc', 'multiverseId': 488874}, 'multiverseid': 488874}, {'name': '산', 'type': '기본 대지 — 산', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488879&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'e83a2e62-b771-436b-abaa-ae832dd2f8df', 'multiverseId': 488879}, 'multiverseid': 488879}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488884&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0d1a94fb-690f-446c-a9fb-839845b3cde0', 'multiverseId': 488884}, 'multiverseid': 488884}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488889&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '55bddafc-90d6-4184-82a8-40fef8522871', 'multiverseId': 488889}, 'multiverseid': 488889}, {'name': '山脉', 'type': '基本地 ～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488894&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'ecb7c8c8-3b4b-4112-be40-345164c9fdb5', 'multiverseId': 488894}, 'multiverseid': 488894}, {'name': '山脈', 'type': '基本地 ～山脈', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488899&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'a357f54a-8edd-43dc-bdeb-b8c8dac102a1', 'multiverseId': 488899}, 'multiverseid': 488899}]", '[{\'name\': \'Gedankenlabyrinth-Zauberbuch\', \'text\': \'{T}, lege eine Seitenmarke auf das Gedankenlabyrinth-Zauberbuch: Hellsicht 1.\\n{2}, {T}, lege eine Seitenmarke auf das Gedankenlabyrinth-Zauberbuch: Ziehe eine Karte.\\nWenn vier oder mehr Seitenmarken auf dem Gedankenlabyrinth-Zauberbuch liegen, schicke es ins Exil. Falls du dies tust, erhältst du 4 Lebenspunkte dazu.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485814&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8717b15a-1244-40d3-a6e5-2e113886b726\', \'multiverseId\': 485814}, \'multiverseid\': 485814}, {\'name\': \'Tomo pierdementes\', \'text\': \'{T}, poner un contador de página sobre el Tomo pierdementes: Adivina 1.\\n{2}, {T}, poner un contador de página sobre el Tomo pierdementes: Roba una carta.\\nCuando haya cuatro o más contadores de página sobre el Tomo pierdementes, exílialo. Si lo haces, ganas 4 vidas.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486073&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7a7c9cbe-4442-453a-861f-421678950cf4\', \'multiverseId\': 486073}, \'multiverseid\': 486073}, {\'name\': "Grimoire du dédale de l\'esprit", \'text\': "{T}, mettez un marqueur « page » sur le Grimoire du dédale de l\'esprit : Regard 1.\\n{2},{T}, mettez un marqueur « page » sur le Grimoire du dédale de l\'esprit : Piochez une carte.\\nQuand il y a au moins quatre marqueurs « page » sur le Grimoire du dédale de l\'esprit, exilez-le. Si vous faites ainsi, vous gagnez 4 points de vie.", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486332&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bf652f82-bc15-4642-973d-e932df6e5868\', \'multiverseId\': 486332}, \'multiverseid\': 486332}, {\'name\': \'Tomo Cervellotico\', \'text\': \'{T}, Metti un segnalino pagina sul Tomo Cervellotico: Profetizza 1.\\n{2}, {T}, Metti un segnalino pagina sul Tomo Cervellotico: Pesca una carta.\\nQuando ci sono quattro o più segnalini pagina sul Tomo Cervellotico, esilialo. Se lo fai, guadagni 4 punti vita.\', \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486591&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6969135c-eb55-4b32-96ed-69bd069dcf7c\', \'multiverseId\': 486591}, \'multiverseid\': 486591}, {\'name\': \'精神迷わせの秘本\', \'text\': \'{T}, 精神迷わせの秘本の上にページ・カウンターを１個置く：占術１を行う。\\n{2}, {T}, 精神迷わせの秘本の上にページ・カウンターを１個置く：カードを１枚引く。\\n精神迷わせの秘本の上にページ・カウンターが４個以上置かれているとき、これを追放する。そうしたなら、あなたは４点のライフを得る。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486850&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c0a2ca0a-d33c-462b-87b2-1964b59758b9\', \'multiverseId\': 486850}, \'multiverseid\': 486850}, {\'name\': \'정신의 미로 고서\', \'text\': \'{T}, 정신의 미로 고서에 페이지 카운터 한 개를 올려놓는다: 점술 1을 한다.\\n{2}, {T}, 정신의 미로 고서에 페이지 카운터 한 개를 올려놓는다: 카드 한 장을 뽑는다.\\n정신의 미로 고서에 페이지 카운터가 네 개 이상 놓여 있을 때, 정신의 미로 고서를 추방한다. 그렇게 한다면, 당신은 생명 4점을 얻는다.\', \'type\': \'마법물체\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487109&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'226a817f-f235-42e8-81b3-746deec1f896\', \'multiverseId\': 487109}, \'multiverseid\': 487109}, {\'name\': \'Tomo da Mente Labiríntica\', \'text\': \'{T}, coloque um marcador de página em Tomo da Mente Labiríntica: Use vidência 1.\\n{2}, {T}, coloque um marcador de página em Tomo da Mente Labiríntica: Compre um card.\\nQuando houver quatro ou mais marcadores de página em Tomo da Mente Labiríntica, exile-o. Se fizer isso, você ganha 4 pontos de vida.\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487368&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0f9bdc14-1dc5-4ed4-bad8-b71ecae179c6\', \'multiverseId\': 487368}, \'multiverseid\': 487368}, {\'name\': \'Фолиант Лабиринтов Разума\', \'text\': \'{T}, положите один жетон страницы на Фолиант Лабиринтов Разума: предскажите 1.\\n{2}, {T}, положите один жетон страницы на Фолиант Лабиринтов Разума: возьмите карту.\\nКогда на Фолианте Лабиринтов Разума есть четыре или больше жетона страницы, изгоните его. Если вы это делаете, вы получаете 4 жизни.\', \'type\': \'Артефакт\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487627&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'18afb8b4-afa6-47ea-a3c1-b9b5f216cfc0\', \'multiverseId\': 487627}, \'multiverseid\': 487627}, {\'name\': \'晦涩巨著\', \'text\': \'{T}，在晦涩巨著上放置一个书页指示物：占卜1。\\n{2}，{T}，在晦涩巨著上放置一个书页指示物：抓一张牌。\\n当晦涩巨著上有四个或更多书页指示物时，将它放逐。若你如此作，则你获得4点生命。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487886&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'13c29c23-d708-4bb5-a70b-bcdd98477916\', \'multiverseId\': 487886}, \'multiverseid\': 487886}, {\'name\': \'晦澀巨著\', \'text\': \'{T}，在晦澀巨著上放置一個書頁指示物：占卜1。\\n{2}，{T}，在晦澀巨著上放置一個書頁指示物：抽一張牌。\\n當晦澀巨著上有四個或更多書頁指示物時，將它放逐。若你如此作，則你獲得4點生命。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488145&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3d551172-13fa-4e21-b4fe-8018a2ba5fe2\', \'multiverseId\': 488145}, \'multiverseid\': 488145}]', '[{\'name\': \'Gedankenzersetzung\', \'text\': \'Ein Spieler deiner Wahl wirft zwei Karten ab.\', \'type\': \'Hexerei\', \'flavor\': \'So manche Erfinder scheitern an dem Druck, ein makelloses Konstrukt zu entwerfen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485697&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dc469bd2-be15-4bd2-8ccd-aa2cc3680261\', \'multiverseId\': 485697}, \'multiverseid\': 485697}, {\'name\': \'Podredumbre mental\', \'text\': \'El jugador objetivo descarta dos cartas.\', \'type\': \'Conjuro\', \'flavor\': \'Más de un inventor se ha venido abajo por la presión de crear el diseño perfecto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485956&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6f24516f-f5c9-4d72-b04e-c5f99b223ae5\', \'multiverseId\': 485956}, \'multiverseid\': 485956}, {\'name\': \'Pourrissement cérébral\', \'text\': \'Le joueur ciblé se défausse de deux cartes.\', \'type\': \'Rituel\', \'flavor\': "Plus d\'un inventeur s\'est fourvoyé dans la quête de la conception parfaite.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486215&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3846db90-eec4-4b9e-ab6a-850676e5c033\', \'multiverseId\': 486215}, \'multiverseid\': 486215}, {\'name\': \'Cancrena della Mente\', \'text\': \'Un giocatore bersaglio scarta due carte.\', \'type\': \'Stregoneria\', \'flavor\': "Più di un inventore è stato schiacciato dall\'ossessione di creare il progetto perfetto.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486474&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'05919224-a843-4c13-b24d-a054815cff5f\', \'multiverseId\': 486474}, \'multiverseid\': 486474}, {\'name\': \'精神腐敗\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーはカード２枚を捨てる。\', \'type\': \'ソーサリー\', \'flavor\': \'完璧な設計を生み出すという重圧に潰された発明者は数知れない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486733&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'086d732d-4ab6-40f4-a28e-1d1b376f78f2\', \'multiverseId\': 486733}, \'multiverseid\': 486733}, {\'name\': \'정신 부패\', \'text\': \'플레이어를 목표로 정한다. 그 플레이어는 카드 두 장을 버린다.\', \'type\': \'집중마법\', \'flavor\': \'많은 발명가들이 완벽한 디자인을 만들려는 스트레스에 못 이겨 쓰러진다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486992&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0997be8d-4198-4530-9428-f0f07bfae04e\', \'multiverseId\': 486992}, \'multiverseid\': 486992}, {\'name\': \'Estiolar a Mente\', \'text\': \'O jogador alvo descarta dois cards.\', \'type\': \'Feitiço\', \'flavor\': \'Muitos inventores entraram em colapso ante à pressão de criar um projeto impecável.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487251&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a9d6e2e5-75a9-4e30-a409-63ae75d0e210\', \'multiverseId\': 487251}, \'multiverseid\': 487251}, {\'name\': \'Гниение Разума\', \'text\': \'Целевой игрок сбрасывает две карты.\', \'type\': \'Волшебство\', \'flavor\': \'Многих изобретателей подкосило стремление создать безупречное произведение.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487510&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e6e5643a-7eaf-46e0-ad6a-deb5dca4338f\', \'multiverseId\': 487510}, \'multiverseid\': 487510}, {\'name\': \'心之衰\', \'text\': \'目标牌手弃两张牌。\', \'type\': \'法术\', \'flavor\': \'许多发明家因创造无瑕设计的压力而崩溃。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487769&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'17d7c088-2b5e-4a54-a1b5-837405e861e4\', \'multiverseId\': 487769}, \'multiverseid\': 487769}, {\'name\': \'心之衰\', \'text\': \'目標玩家棄兩張牌。\', \'type\': \'巫術\', \'flavor\': \'許多發明家因創造無瑕設計的壓力而崩潰。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488028&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1a90d528-f26b-4463-92e7-75bb4d354dc3\', \'multiverseId\': 488028}, \'multiverseid\': 488028}]', '[{\'name\': \'Gefängnissphäre\', \'text\': \'Aufblitzen (Du kannst diesen Zauberspruch zu jedem Zeitpunkt wirken, zu dem du einen Spontanzauber wirken könntest.)\\nVerzaubert eine Kreatur\\nWenn die Gefängnissphäre ins Spiel kommt, tappe die verzauberte Kreatur.\\nDie verzauberte Kreatur enttappt nicht während des Enttappsegments ihres Beherrschers.\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485629&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4b4e73c7-6855-469f-9e4a-90334eb48989\', \'multiverseId\': 485629}, \'multiverseid\': 485629}, {\'name\': \'Esfera de captura\', \'text\': \'Destello. (Puedes lanzar este hechizo en cualquier momento en que pudieras lanzar un instantáneo.)\\nEncantar criatura.\\nCuando la Esfera de captura entre al campo de batalla, gira la criatura encantada.\\nLa criatura encantada no se endereza durante el paso de enderezar de su controlador.\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485888&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'be9c635f-039b-4e19-8bf0-9c9f75bda23a\', \'multiverseId\': 485888}, \'multiverseid\': 485888}, {\'name\': \'Sphère de capture\', \'text\': "Flash (Vous pouvez lancer ce sort à tout moment où vous pourriez lancer un éphémère.)\\nEnchanter : créature\\nQuand la Sphère de capture arrive sur le champ de bataille, engagez la créature enchantée.\\nLa créature enchantée ne se dégage pas pendant l\'étape de dégagement de son contrôleur.", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486147&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fa8c1c6f-9dea-4b4c-9984-6c9487afe0b7\', \'multiverseId\': 486147}, \'multiverseid\': 486147}, {\'name\': \'Sfera di Cattura\', \'text\': \'Lampo (Puoi lanciare questa magia in ogni momento in cui potresti lanciare un istantaneo.)\\nIncanta creatura\\nQuando la Sfera di Cattura entra nel campo di battaglia, TAPpa la creatura incantata.\\nLa creatura incantata non STAPpa durante lo STAP del suo controllore.\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486406&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9840bda1-0f85-41d1-88be-9d8ebb7b7c86\', \'multiverseId\': 486406}, \'multiverseid\': 486406}, {\'name\': \'捕獲球\', \'text\': \'瞬速（あなたはこの呪文を、あなたがインスタントを唱えられるときならいつでも唱えてよい。）\\nエンチャント（クリーチャー）\\n捕獲球が戦場に出たとき、エンチャントしているクリーチャーをタップする。\\nエンチャントしているクリーチャーは、それのコントローラーのアンタップ・ステップにアンタップしない。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486665&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9cc3b236-9a64-485c-bcff-24614a19a8cb\', \'multiverseId\': 486665}, \'multiverseid\': 486665}, {\'name\': \'포획 구체\', \'text\': \'섬광 (순간마법을 발동할 수 있는 시기라면 당신은 이 주문을 언제든지 발동할 수 있다.)\\n생물에게 부여\\n포획 구체가 전장에 들어올 때, 부여된 생물을 탭한다.\\n부여된 생물은 조종자의 언탭단에 언탭되지 않는다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486924&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8f03a2d8-b251-4436-8c7c-04b2c292f151\', \'multiverseId\': 486924}, \'multiverseid\': 486924}, {\'name\': \'Esfera de Captura\', \'text\': \'Lampejo (Você poderá conjurar esta mágica a qualquer momento em que puder conjurar uma mágica instantânea.)\\nEncantar criatura\\nQuando Esfera de Captura entrar no campo de batalha, vire a criatura encantada.\\nA criatura encantada não é desvirada durante a etapa de desvirar de seu controlador.\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487183&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3287015f-e28f-4dee-8f0d-ee100d51ba9e\', \'multiverseId\': 487183}, \'multiverseid\': 487183}, {\'name\': \'Ловчая Сфера\', \'text\': \'Миг (Вы можете разыграть это заклинание при любой возможности разыгрывать мгновенные заклинания.)\\nЗачаровать существо\\nКогда Ловчая Сфера выходит на поле битвы, поверните зачарованное существо.\\nЗачарованное существо не разворачивается во время шага разворота контролирующего его игрока.\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487442&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3cdb54af-740f-46b2-8c96-a69ccce6b8f6\', \'multiverseId\': 487442}, \'multiverseid\': 487442}, {\'name\': \'拘捕法球\', \'text\': \'闪现（你可以于你能够施放瞬间的时机下施放此咒语。）\\n结附于生物\\n当拘捕法球进战场时，横置所结附的生物。\\n所结附的生物于其操控者的重置步骤中不能重置。\', \'type\': \'结界 ～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487701&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f91c5a46-749c-48a5-99db-bc3865b5a340\', \'multiverseId\': 487701}, \'multiverseid\': 487701}, {\'name\': \'拘捕法球\', \'text\': \'閃現（你可以於你能夠施放瞬間的時機下施放此咒語。）\\n結附於生物\\n當拘捕法球進戰場時，橫置所結附的生物。\\n所結附的生物於其操控者的重置步驟中不能重置。\', \'type\': \'結界 ～靈氣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487960&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6a247013-4ab7-4ff4-8a0a-7705e12bb8d7\', \'multiverseId\': 487960}, \'multiverseid\': 487960}]', '[{\'name\': \'Gegenstandslos machen\', \'text\': \'Bringe einen Zauberspruch oder eine Kreatur deiner Wahl auf die Hand seines bzw. ihres Besitzers zurück.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Gut gemacht, Jace. In Luft auflösen war schon immer deine Stärke."\\n—Liliana Vess\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485664&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ff33247e-a08e-4f52-b814-46ae2586ef3f\', \'multiverseId\': 485664}, \'multiverseid\': 485664}, {\'name\': \'Privar de sustancia\', \'text\': \'Regresa el hechizo o la criatura objetivo a la mano de su propietario.\', \'type\': \'Instantáneo\', \'flavor\': \'"Bien hecho, Jace. Siempre se te dieron bien los actos de desaparición".\\n—Liliana Vess\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485923&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'900fe6a7-7a0d-4e90-9bab-767e42c76517\', \'multiverseId\': 485923}, \'multiverseid\': 485923}, {\'name\': \'Abolir\', \'text\': \'Renvoyez le sort ciblé ou la créature ciblée dans la main de son propriétaire.\', \'type\': \'Éphémère\', \'flavor\': \'« Bravo, Jace. Tu as toujours été doué pour les tours de passe-passe. »\\n—Liliana Vess\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486182&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'84fc6516-8c5c-40af-a8c2-49aeb2b960dd\', \'multiverseId\': 486182}, \'multiverseid\': 486182}, {\'name\': \'Disgregare\', \'text\': \'Fai tornare una magia o una creatura bersaglio in mano al suo proprietario.\', \'type\': \'Istantaneo\', \'flavor\': \'"Ben fatto, Jace. Hai sempre avuto un talento per le sparizioni."\\n—Liliana Vess\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486441&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1cf43cf8-b60b-43a0-b6bc-86cf2e8b2f5b\', \'multiverseId\': 486441}, \'multiverseid\': 486441}, {\'name\': \'非実体化\', \'text\': \'呪文１つかクリーチャー１体を対象とし、それをオーナーの手札に戻す。\', \'type\': \'インスタント\', \'flavor\': \'「上手ね、ジェイス。昔から、消すとか消えるとかが得意だものね。」\\n――リリアナ・ヴェス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486700&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'43a7db2f-1aca-412f-b966-b9abb3608f22\', \'multiverseId\': 486700}, \'multiverseid\': 486700}, {\'name\': \'비실체화\', \'text\': \'주문 또는 생물을 목표로 정한다. 그 목표를 소유자의 손으로 되돌린다.\', \'type\': \'순간마법\', \'flavor\': \'"잘했어, 제이스. 모습을 감추는 건 언제나 네 특기였지."\\n—릴리아나 베스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486959&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c73771ba-a5d4-4173-9d51-f9d923c9d9c1\', \'multiverseId\': 486959}, \'multiverseid\': 486959}, {\'name\': \'Insubstanciar\', \'text\': \'Devolva a mágica ou criatura alvo para a mão de seu dono.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Muito bom, Jace. Você sempre foi ótimo em fazer coisas desaparecerem."\\n— Liliana Vess\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487218&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6d85fad4-b0b1-4346-9d26-6c590cf4aa5c\', \'multiverseId\': 487218}, \'multiverseid\': 487218}, {\'name\': \'Лишить Основания\', \'text\': \'Верните целевое заклинание или существо в руку его владельца.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Очень хорошо, Джейс. Исчезновения тебе всегда отлично удавались».\\n— Лилиана Весс\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487477&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0e3d9297-bd1a-4188-a7f8-1ec33261a439\', \'multiverseId\': 487477}, \'multiverseid\': 487477}, {\'name\': \'消解\', \'text\': \'将目标咒语或生物移回其拥有者手上。\', \'type\': \'瞬间\', \'flavor\': \'「干得漂亮，杰斯。你一直很擅长玩失踪这类把戏。」\\n～莉莲娜维斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487736&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7714c9ac-5b09-4ac4-b701-ba1d063861b0\', \'multiverseId\': 487736}, \'multiverseid\': 487736}, {\'name\': \'消解\', \'text\': \'將目標咒語或生物移回其擁有者手上。\', \'type\': \'瞬間\', \'flavor\': \'「幹得漂亮，傑斯。你一直很擅長玩失蹤這類把戲。」\\n～莉蓮娜維斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487995&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a32f5b40-71ca-418a-b098-0c02c78a4e02\', \'multiverseId\': 487995}, \'multiverseid\': 487995}]', '[{\'name\': \'Gehärtete Veteranin\', \'text\': \'{W}, {T}: Lege eine +1/+1-Marke auf eine Kreatur deiner Wahl, auf der mindestens eine +1/+1-Marke liegt.\\n{4}{W}{W}, {T}: Lege eine +1/+1-Marke auf eine Kreatur deiner Wahl.\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': \'„Ich trage mein Schwert bereits länger als du lebst. Ich würde meinen Eid für keinen Frieden oder Komfort in der Welt aufgeben."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485623&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'020c5acd-150a-4b6f-86bc-9074faddc439\', \'multiverseId\': 485623}, \'multiverseid\': 485623}, {\'name\': \'Veterana templada\', \'text\': \'{W}, {T}: Pon un contador +1/+1 sobre la criatura objetivo con un contador +1/+1 sobre ella.\\n{4}{W}{W}, {T}: Pon un contador +1/+1 sobre la criatura objetivo.\', \'type\': \'Criatura — Caballero humano\', \'flavor\': \'"Llevo blandiendo una espada desde antes de que nacieras. No rompería mi juramento ni por toda la paz y consuelo del mundo".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485882&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2581cd0c-dcc0-45b9-8452-0c6146d4a332\', \'multiverseId\': 485882}, \'multiverseid\': 485882}, {\'name\': \'Vétérane irascible\', \'text\': \'{W}, {T} : Mettez un marqueur +1/+1 sur une créature ciblée avec un marqueur +1/+1 sur elle.\\n{4}{W}{W}, {T} : Mettez un marqueur +1/+1 sur la créature ciblée.\', \'type\': \'Créature : humain et chevalier\', \'flavor\': \'« Je portais déjà une épée avant ta naissance. Je ne romprais mon serment pour rien au monde, pas même pour la paix et le confort. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486141&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9b536fc3-2423-4dfd-b275-9e9deabcaf6e\', \'multiverseId\': 486141}, \'multiverseid\': 486141}, {\'name\': \'Veterana Temprata\', \'text\': \'{W}, {T}: Metti un segnalino +1/+1 su una creatura bersaglio con un segnalino +1/+1.\\n{4}{W}{W}, {T}: Metti un segnalino +1/+1 su una creatura bersaglio.\', \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': \'"Brandisco la spada da ben prima della tua nascita. Non rinuncerei al mio giuramento nemmeno per tutta la serenità e il benessere del mondo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486400&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'34c81ca7-3107-44e2-8347-10cbcba68ce5\', \'multiverseId\': 486400}, \'multiverseid\': 486400}, {\'name\': \'鍛え抜かれた古参兵\', \'text\': \'{W}, {T}：＋１/＋１カウンターが置かれているクリーチャー１体を対象とし、それの上に＋１/＋１カウンターを１個置く。\\n{4}{W}{W}, {T}：クリーチャー１体を対象とし、それの上に＋１/＋１カウンターを１個置く。\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': \'「こっちはね、あんたが生まれる前からずっと剣を持ち歩いてるのよ。世界に平和と安心をもたらすと誓ったからには諦めないわ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486659&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0c2b903d-204f-44d6-8c35-dbfa8d12ccae\', \'multiverseId\': 486659}, \'multiverseid\': 486659}, {\'name\': \'단련된 숙련병\', \'text\': \'{W}, {T}: +1/+1 카운터를 가지고 있는 생물을 목표로 정한다. 그 생물에 +1/+1 카운터 한 개를 올려놓는다.\\n{4}{W}{W}, {T}: 생물을 목표로 정한다. 그 생물에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 인간 기사\', \'flavor\': \'"난 네가 태어나기 전부터 검을 지니고 다녔지. 이 세상의 어떤 평화와 안식에도 내 맹세를 저버리지는 않을 거야."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486918&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'172f7f24-0b87-4975-873e-818a3d67775f\', \'multiverseId\': 486918}, \'multiverseid\': 486918}, {\'name\': \'Veterana Temperada\', \'text\': \'{W}, {T}: Coloque um marcador +1/+1 na criatura alvo com um marcador +1/+1.\\n{4}{W}{W}, {T}: Coloque um marcador +1/+1 na criatura alvo.\', \'type\': \'Criatura — Humano Cavaleiro\', \'flavor\': \'"Eu carrego uma espada desde antes de você nascer. Eu não largaria os meus votos, nem por toda a paz e conforto do mundo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487177&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'433873da-ef6f-4a89-8ee5-74008bd2b7e5\', \'multiverseId\': 487177}, \'multiverseid\': 487177}, {\'name\': \'Закаленный Ветеран\', \'text\': \'{W}, {T}: положите один жетон +1/+1 на целевое существо с жетоном +1/+1 на нем.\\n{4}{W}{W}, {T}: положите один жетон +1/+1 на целевое существо.\', \'type\': \'Существо — Человек Рыцарь\', \'flavor\': \'«Я носила меч еще до того, как ты родился. Никакой покой и уют не заставят меня отказаться от своей клятвы».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487436&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7d5268b9-0376-4189-8c32-541807ba2e14\', \'multiverseId\': 487436}, \'multiverseid\': 487436}, {\'name\': \'蓄势老兵\', \'text\': \'{W}，{T}：在目标其上有+1/+1指示物的生物上放置一个+1/+1指示物。\\n{4}{W}{W}，{T}：在目标生物上放置一个+1/+1指示物。\', \'type\': \'生物 ～人类／骑士\', \'flavor\': \'「在你出世之前，我已佩剑征战四方。就算你拿全世界最安逸的生活来引诱我，我也不会背弃誓言。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487695&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b050be26-581e-4e68-84da-6b610ed0cd2f\', \'multiverseId\': 487695}, \'multiverseid\': 487695}, {\'name\': \'蓄勢老兵\', \'text\': \'{W}，{T}：在目標其上有+1/+1指示物的生物上放置一個+1/+1指示物。\\n{4}{W}{W}，{T}：在目標生物上放置一個+1/+1指示物。\', \'type\': \'生物 ～人類／騎士\', \'flavor\': \'「在你出世之前，我已佩劍征戰四方。就算你拿全世界最安逸的生活來引誘我，我也不會背棄誓言。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487954&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c9e2e44c-5d51-4b66-991a-5867b23b2a4e\', \'multiverseId\': 487954}, \'multiverseid\': 487954}]', '[{\'name\': \'Geist der Boshaftigkeit\', \'text\': \'Wenn der Geist der Boshaftigkeit stirbt, verliert jeder Gegner 1 Lebenspunkt und du erhältst 1 Lebenspunkt dazu.\', \'type\': \'Kreatur — Geist\', \'flavor\': \'Großes Unheil belastet die Seele.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488657&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1dcfd058-33c2-443b-8e22-d497f4af050b\', \'multiverseId\': 488657}, \'multiverseid\': 488657}, {\'name\': \'Espíritu de la malevolencia\', \'text\': \'Cuando el Espíritu de la malevolencia muera, cada oponente pierde 1 vida y tú ganas 1 vida.\', \'type\': \'Criatura — Espíritu\', \'flavor\': \'Una gran maldad pesa en el alma.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488677&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'89a6b547-eed2-4ab4-b4bd-66e545c4b741\', \'multiverseId\': 488677}, \'multiverseid\': 488677}, {\'name\': \'Esprit de malveillance\', \'text\': "Quand l\'Esprit de malveillance meurt, chaque adversaire perd 1 point de vie et vous gagnez 1 point de vie.", \'type\': \'Créature : esprit\', \'flavor\': "Un grand mal pèse lourdement sur l\'âme.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488697&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7bd9ffc1-8f87-490b-98f0-aba14d8aa840\', \'multiverseId\': 488697}, \'multiverseid\': 488697}, {\'name\': \'Spirito della Malevolenza\', \'text\': \'Quando lo Spirito della Malevolenza muore, ogni avversario perde 1 punto vita e tu guadagni 1 punto vita.\', \'type\': \'Creatura — Spirito\', \'flavor\': "Una grande malvagità è un peso sull\'anima.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488717&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'955e74a1-2a28-465d-aee9-4292141b119f\', \'multiverseId\': 488717}, \'multiverseid\': 488717}, {\'name\': \'悪意の霊魂\', \'text\': \'悪意の霊魂が死亡したとき、各対戦相手はそれぞれ１点のライフを失い、あなたは１点のライフを得る。\', \'type\': \'クリーチャー — スピリット\', \'flavor\': \'大いなる邪悪が魂にのしかかる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488737&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5a2f7cbb-5ca6-4125-b1bc-bee4a9b4cc49\', \'multiverseId\': 488737}, \'multiverseid\': 488737}, {\'name\': \'악의의 신령\', \'text\': \'악의의 신령이 죽을 때, 각 상대는 생명 1점을 잃고 당신은 생명 1점을 얻는다.\', \'type\': \'생물 — 신령\', \'flavor\': \'거대한 악이 영혼을 짓누른다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488757&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0b1d56bf-2103-4d8c-a2c7-11983ed9b9d5\', \'multiverseId\': 488757}, \'multiverseid\': 488757}, {\'name\': \'Espírito de Malevolência\', \'text\': \'Quando Espírito de Malevolência morre, cada oponente perde 1 ponto de vida e você ganha 1 ponto de vida.\', \'type\': \'Criatura — Espírito\', \'flavor\': \'Um grande mal pesa na alma.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488777&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'47cd1da7-f78e-43a9-a63a-3aa100da51e9\', \'multiverseId\': 488777}, \'multiverseid\': 488777}, {\'name\': \'Дух Злонамерения\', \'text\': \'Когда Дух Злонамерения умирает, каждый оппонент теряет 1 жизнь, а вы получаете 1 жизнь.\', \'type\': \'Существо — Дух\', \'flavor\': \'Великое зло бременем давит на душу.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488797&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'21d23fb7-f24a-46d1-8877-450deb38913d\', \'multiverseId\': 488797}, \'multiverseid\': 488797}, {\'name\': \'恶灵\', \'text\': \'当恶灵死去时，每位对手各失去1点生命，且你获得1点生命。\', \'type\': \'生物 ～精怪\', \'flavor\': \'巨量邪恶屈沉灵魂。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488817&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dbd8bbe1-655d-4d0d-880a-1fa864bd6ba1\', \'multiverseId\': 488817}, \'multiverseid\': 488817}, {\'name\': \'惡靈\', \'text\': \'當惡靈死去時，每位對手各失去1點生命，且你獲得1點生命。\', \'type\': \'生物 ～精靈\', \'flavor\': \'巨量邪惡屈沉靈魂。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488837&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fd319648-0050-472c-ba1a-09f20c38e30f\', \'multiverseId\': 488837}, \'multiverseid\': 488837}]', "[{'name': 'Geist ferré', 'text': 'Vol\\nLe Geist ferré ne peut bloquer que les créatures avec le vol.\\nEngagez deux esprits dégagés que vous contrôlez : Engagez une créature ciblée que vous ne contrôlez pas.', 'type': 'Créature : esprit', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488304&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c1e2ed86-2951-45f7-abfa-048f9c681658', 'multiverseId': 488304}, 'multiverseid': 488304}, {'name': '鎖霊', 'text': '飛行\\n鎖霊は、飛行を持つクリーチャーのみをブロックできる。\\nあなたがコントロールしていてアンタップ状態のスピリット２体をタップする：あなたがコントロールしていないクリーチャー１体を対象とし、それをタップする。', 'type': 'クリーチャー — スピリット', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488356&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '87912d3e-265d-4952-8c52-c1354a66dfae', 'multiverseId': 488356}, 'multiverseid': 488356}]", '[{\'name\': \'Geisterhafter Dieb\', \'text\': \'Immer wenn der Geisterhafte Dieb enttappt wird, kannst du {2} bezahlen. Falls du dies tust, ziehe eine Karte.\\nImmer wenn ein Gegner einen Zauberspruch von irgendwoher außer von seiner Hand wirkt, ziehe eine Karte.\\nWirf eine Karte ab: Der Geisterhafte Dieb kann in diesem Zug nicht geblockt werden.\', \'type\': \'Kreatur — Geist, Räuber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485634&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'66e61915-64ab-4c01-93f1-f984642f0cf7\', \'multiverseId\': 485634}, \'multiverseid\': 485634}, {\'name\': \'Ladronzuelo fantasmal\', \'text\': \'Siempre que el Ladronzuelo fantasmal se enderece, puedes pagar {2}. Si lo haces, roba una carta.\\nSiempre que un oponente lance un hechizo desde cualquier parte excepto desde su mano, roba una carta.\\nDescartar una carta: El Ladronzuelo fantasmal no puede ser bloqueado este turno.\', \'type\': \'Criatura — Pícaro espíritu\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485893&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7b309016-554b-42ec-b511-846c1185c892\', \'multiverseId\': 485893}, \'multiverseid\': 485893}, {\'name\': \'Chapardeur fantomal\', \'text\': "À chaque fois que le Chapardeur fantomal devient dégagé, vous pouvez payer {2}. Si vous faites ainsi, piochez une carte.\\nÀ chaque fois qu\'un adversaire lance un sort depuis autre part que sa main, piochez une carte.\\nDéfaussez-vous d\'une carte : Le Chapardeur fantomal ne peut pas être bloqué ce tour-ci.", \'type\': \'Créature : esprit et gredin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486152&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'90ee9953-0e64-4e65-b192-d0f0c876e079\', \'multiverseId\': 486152}, \'multiverseid\': 486152}, {\'name\': \'Saccheggiatore Incorporeo\', \'text\': \'Ogniqualvolta il Saccheggiatore Incorporeo viene STAPpato, puoi pagare {2}. Se lo fai, pesca una carta.\\nOgniqualvolta un avversario lancia una magia da una zona diversa dalla sua mano, pesca una carta.\\nScarta una carta: Il Saccheggiatore Incorporeo non può essere bloccato in questo turno.\', \'type\': \'Creatura — Farabutto Spirito\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486411&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3edef4ac-b328-48a1-9291-7907a2ca52be\', \'multiverseId\': 486411}, \'multiverseid\': 486411}, {\'name\': \'幽体のこそ泥\', \'text\': \'幽体のこそ泥がアンタップ状態になるたび、あなたは{2}を支払ってもよい。そうしたなら、カードを１枚引く。\\n対戦相手が自分の手札以外の領域から呪文を唱えるたび、あなたはカードを１枚引く。\\nカード１枚を捨てる：このターン、幽体のこそ泥はブロックされない。\', \'type\': \'クリーチャー — スピリット・ならず者\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486670&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3773c9f2-3173-428a-a30e-125501522fe3\', \'multiverseId\': 486670}, \'multiverseid\': 486670}, {\'name\': \'유령 좀도둑\', \'text\': \'유령 좀도둑이 언탭될 때마다, 당신은 {2}를 지불할 수 있다. 그렇게 한다면, 카드 한 장을 뽑는다.\\n상대가 자신의 손을 제외한 어디에서든 주문을 발동할 때마다, 카드 한 장을 뽑는다.\\n카드 한 장을 버린다: 유령 좀도둑은 이번 턴에 방어당할 수 없다.\', \'type\': \'생물 — 신령 도적\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486929&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'738383a6-11d4-4cfe-9fcf-7ed62878a70c\', \'multiverseId\': 486929}, \'multiverseid\': 486929}, {\'name\': \'Gatuno Fantasmagórico\', \'text\': \'Toda vez que Gatuno Fantasmagórico se torna desvirado, você pode pagar {2}. Se fizer isso, compre um card.\\nToda vez que um oponente conjurar uma mágica de qualquer zona diferente da própria mão, compre um card.\\nDescarte um card: Gatuno Fantasmagórico não pode ser bloqueado neste turno.\', \'type\': \'Criatura — Espírito Ladino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487188&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'170922ff-b623-4773-bf75-32b734ea8ea4\', \'multiverseId\': 487188}, \'multiverseid\': 487188}, {\'name\': \'Призрачный Воришка\', \'text\': \'Каждый раз, когда Призрачный Воришка становится развернутым, вы можете заплатить {2}. Если вы это делаете, возьмите карту.\\nКаждый раз, когда оппонент разыгрывает заклинание откуда угодно, кроме своей руки, возьмите карту.\\nСбросьте карту: Призрачный Воришка не может быть заблокирован в этом ходу.\', \'type\': \'Существо — Дух Бродяга\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487447&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b461f648-d1ed-49a9-b8ab-557a5abaa1d8\', \'multiverseId\': 487447}, \'multiverseid\': 487447}, {\'name\': \'魂魅小偷\', \'text\': \'每当魂魅小偷成为未横置时，你可以支付{2}。若你如此作，则抓一张牌。\\n每当任一对手从其手牌以外的任何区域施放咒语时，你抓一张牌。\\n弃一张牌：魂魅小偷本回合不能被阻挡。\', \'type\': \'生物 ～精怪／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487706&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1ef6c30a-0820-4386-9364-d52daebf9e06\', \'multiverseId\': 487706}, \'multiverseid\': 487706}, {\'name\': \'魂魅小偷\', \'text\': \'每當魂魅小偷成為未橫置時，你可以支付{2}。若你如此作，則抽一張牌。\\n每當任一對手從其手牌以外的任何區域施放咒語時，你抽一張牌。\\n棄一張牌：魂魅小偷本回合不能被阻擋。\', \'type\': \'生物 ～精靈／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487965&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1086dd5d-6c03-4725-bbb8-cd3995b34951\', \'multiverseId\': 487965}, \'multiverseid\': 487965}]', '[{\'name\': \'Gesalbter Chorist\', \'text\': \'Lebensverknüpfung (Schaden, der von dieser Kreatur zugefügt wird, lässt dich entsprechend viele Lebenspunkte dazuerhalten.)\\n{4}{W}: Der Gesalbte Chorist erhält +3/+3 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': \'„Ich singe von Wohltaten und Gnade, von goldenen Schwingen, die den Schwachen und Unterdrückten Trost bringen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485586&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9b3a9adb-ed7e-45e5-983c-e627dae95e82\', \'multiverseId\': 485586}, \'multiverseid\': 485586}, {\'name\': \'Corista ungido\', \'text\': \'Vínculo vital. (El daño hecho por esta criatura también hace que ganes esa misma cantidad de vidas.)\\n{4}{W}: El Corista ungido obtiene +3/+3 hasta el final del turno.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': \'"Canto sobre benevolencia y misericordia, sobre alas doradas que consuelan a los sumisos y a los oprimidos".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485845&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3625b1fb-a19b-443c-b82b-dc12b67822b3\', \'multiverseId\': 485845}, \'multiverseid\': 485845}, {\'name\': \'Choriste consacré\', \'text\': "Lien de vie (Les blessures infligées par cette créature vous font aussi gagner autant de points de vie.)\\n{4}{W} : Le Choriste consacré gagne +3/+3 jusqu\'à la fin du tour.", \'type\': \'Créature : humain et clerc\', \'flavor\': \'« Je chante les louanges de la bienveillance et de la pitié, des ailes dorées qui réconfortent les faibles et les opprimés. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486104&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'877da1e7-2a5c-4243-87fa-028fbad5796f\', \'multiverseId\': 486104}, \'multiverseid\': 486104}, {\'name\': \'Corista Consacrato\', \'text\': \'Legame vitale (Il danno inflitto da questa creatura ti fa anche guadagnare altrettanti punti vita.)\\n{4}{W}: Il Corista Consacrato prende +3/+3 fino alla fine del turno.\', \'type\': \'Creatura — Chierico Umano\', \'flavor\': \'"Il mio canto risuona di pietà e compassione, di ali dorate che recano conforto agli umili e agli oppressi."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486363&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bf7af1ce-259a-41ad-84f4-57f880665aac\', \'multiverseId\': 486363}, \'multiverseid\': 486363}, {\'name\': \'選定された聖歌員\', \'text\': \'絆魂（このクリーチャーがダメージを与えると、さらにあなたはその点数分のライフを得る。）\\n{4}{W}：ターン終了時まで、選定された聖歌員は＋３/＋３の修整を受ける。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': \'「私は善行と慈悲を歌う。弱い者や抑圧される者に安らぎをもたらす金色の羽。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486622&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b07aeae5-7df4-48d8-89c4-6107dd06dd7a\', \'multiverseId\': 486622}, \'multiverseid\': 486622}, {\'name\': \'세례받은 성가대원\', \'text\': \'생명연결 (이 생물이 피해를 입히면, 당신은 그 피해만큼의 생명점을 얻는다.)\\n{4}{W}: 세례받은 성가대원은 턴종료까지 +3/+3을 받는다.\', \'type\': \'생물 — 인간 성직자\', \'flavor\': \'"나는 자애와 자비를 노래하며, 온유하고 억압된 자들에게 위안을 주는 황금 날개를 노래한다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486881&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e00e1061-97d7-4b56-896b-a48f4a76383d\', \'multiverseId\': 486881}, \'multiverseid\': 486881}, {\'name\': \'Corista Ungido\', \'text\': \'Vínculo com a vida (O dano causado por esta criatura também faz com que você ganhe uma quantidade equivalente de pontos de vida.)\\n{4}{W}: Corista Ungido recebe +3/+3 até o final do turno.\', \'type\': \'Criatura — Humano Clérigo\', \'flavor\': \'"Meu canto louva a benevolência e a misericórdia, as asas douradas que confortam os humildes e os oprimidos."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487140&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ed894686-a065-4281-bbac-b5b285c3da04\', \'multiverseId\': 487140}, \'multiverseid\': 487140}, {\'name\': \'Умащенный Хорист\', \'text\': \'Цепь жизни (Повреждения, наносимые этим существом, также заставляют вас получить такое же количество жизней.)\\n{4}{W}: Умащенный Хорист получает +3/+3 до конца хода.\', \'type\': \'Существо — Человек Священник\', \'flavor\': \'«Я пою о доброте и милосердии, о золотых крыльях, несущих утешение кротким и угнетенным».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487399&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a13c6b56-aa52-4be0-aea5-0814b66fd473\', \'multiverseId\': 487399}, \'multiverseid\': 487399}, {\'name\': \'神圣唱诗人\', \'text\': \'系命（此生物所造成的伤害会让你获得等量的生命。）\\n{4}{W}：神圣唱诗人得+3/+3直到回合结束。\', \'type\': \'生物 ～人类／僧侣\', \'flavor\': \'「我颂扬善良慈悲，赞美金羽现世，安顿困苦孤弱。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487658&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f672f7d1-d200-49f9-8644-8b270029e585\', \'multiverseId\': 487658}, \'multiverseid\': 487658}, {\'name\': \'神聖唱詩人\', \'text\': \'繫命（此生物所造成的傷害會讓你獲得等量的生命。）\\n{4}{W}：神聖唱詩人得+3/+3直到回合結束。\', \'type\': \'生物 ～人類／僧侶\', \'flavor\': \'「我頌揚善良慈悲，讚美金羽現世，安頓困苦孤弱。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487917&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'306b11c9-5223-4a1a-be5c-702122880cee\', \'multiverseId\': 487917}, \'multiverseid\': 487917}]', '[{\'name\': \'Geschützte Festungsmauern\', \'text\': \'Verteidiger (Diese Kreatur kann nicht angreifen.)\\nAngreifende Kreaturen, die du kontrollierst, erhalten +1/+0.\', \'type\': \'Kreatur — Mauer\', \'flavor\': \'In düsteren Zeiten kann selbst ein Zufluchtsort zu einer mächtigen Waffe werden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485626&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3227ecfe-6945-4ae0-80f8-e97d3c147adf\', \'multiverseId\': 485626}, \'multiverseid\': 485626}, {\'name\': \'Almenas con guardas\', \'text\': \'Defensor. (Esta criatura no puede atacar.)\\nLas criaturas atacantes que controlas obtienen +1/+0.\', \'type\': \'Criatura — Muro\', \'flavor\': \'En tiempos difíciles, incluso un refugio puede ser un arma de guerra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485885&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8cad6d3c-becf-4c50-a5d0-07c091d84753\', \'multiverseId\': 485885}, \'multiverseid\': 485885}, {\'name\': \'Remparts aux runes de garde\', \'text\': \'Défenseur (Cette créature ne peut pas attaquer.)\\nLes créatures attaquantes que vous contrôlez gagnent +1/+0.\', \'type\': \'Créature : mur\', \'flavor\': \'Quand les temps sont durs, même un refuge peut devenir une arme de guerre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486144&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a8fa13ac-40a1-4352-a12d-3b52b0ed6f88\', \'multiverseId\': 486144}, \'multiverseid\': 486144}, {\'name\': \'Bastioni Incantati\', \'text\': \'Difensore (Questa creatura non può attaccare.)\\nLe creature attaccanti che controlli prendono +1/+0.\', \'type\': \'Creatura — Muro\', \'flavor\': "In tempi di necessità, perfino un rifugio può diventare un\'arma di guerra.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486403&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ecedd254-edfa-401b-b5aa-80b71d4b9bdb\', \'multiverseId\': 486403}, \'multiverseid\': 486403}, {\'name\': \'護法の要塞\', \'text\': \'防衛（このクリーチャーでは攻撃できない。）\\nあなたがコントロールしている攻撃クリーチャーは＋１/＋０の修整を受ける。\', \'type\': \'クリーチャー — 壁\', \'flavor\': \'時節が切迫すると、避難するための場所すらも戦争の武器となる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486662&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'239c7a22-c354-45c3-b696-e0dfd7ab4fce\', \'multiverseId\': 486662}, \'multiverseid\': 486662}, {\'name\': \'보호받는 성가퀴\', \'text\': \'수비태세 (이 생물은 공격할 수 없다.)\\n당신이 조종하는 공격 중인 생물들은 +1/+0을 받는다.\', \'type\': \'생물 — 벽\', \'flavor\': \'궁핍한 시기에는, 피난처라도 전쟁의 무기가 될 수 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486921&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c1c455fb-8eeb-41e8-a090-f03966c4dd56\', \'multiverseId\': 486921}, \'multiverseid\': 486921}, {\'name\': \'Ameias Protegidas\', \'text\': \'Defensor (Esta criatura não pode atacar.)\\nAs criaturas atacantes que você controla recebem +1/+0.\', \'type\': \'Criatura — Barreira\', \'flavor\': \'Em tempos difíceis, mesmo um local de refúgio pode se tornar uma arma de guerra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487180&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'98dac186-b2b6-4706-8def-3ef4dbc80349\', \'multiverseId\': 487180}, \'multiverseid\': 487180}, {\'name\': \'Бастион Оберегов\', \'text\': \'Защитник (Это существо не может атаковать.)\\nАтакующие существа под вашим контролем получают +1/+0.\', \'type\': \'Существо — Стена\', \'flavor\': \'В отчаянные времена даже место спасения может стать оружием войны.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487439&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'29238a8c-08e1-4d0a-ad66-2ceab8ac0563\', \'multiverseId\': 487439}, \'multiverseid\': 487439}, {\'name\': \'符佑城垛\', \'text\': \'守军（此生物不能攻击。）\\n由你操控且进行攻击的生物得+1/+0。\', \'type\': \'生物 ～墙\', \'flavor\': \'在困难时期，就连避难之地也能成为作战利器。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487698&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b5134e1c-adb7-40c5-9322-f44d565b65f6\', \'multiverseId\': 487698}, \'multiverseid\': 487698}, {\'name\': \'符佑城垛\', \'text\': \'守軍（此生物不能攻擊。）\\n由你操控且進行攻擊的生物得+1/+0。\', \'type\': \'生物 ～牆\', \'flavor\': \'在困難時期，就連避難之地也能成為作戰利器。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487957&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ff819d7a-15b7-493f-8781-71f60bf018fe\', \'multiverseId\': 487957}, \'multiverseid\': 487957}]', '[{\'name\': \'Geschützturm-Oger\', \'text\': \'Reichweite (Diese Kreatur kann fliegende Kreaturen blocken.)\\nWenn der Geschützturm-Oger ins Spiel kommt und falls du eine andere Kreatur mit Stärke 4 oder mehr kontrollierst, fügt der Geschützturm-Oger jedem Gegner 2 Schadenspunkte zu.\', \'type\': \'Kreatur — Oger, Krieger\', \'flavor\': \'Häufige Karriereziele der Gruul: Berserker, Schamane, Katapult.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485751&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1856b728-d92b-4097-b426-6ebd645d8558\', \'multiverseId\': 485751}, \'multiverseid\': 485751}, {\'name\': \'Ogro de la torreta\', \'text\': \'Alcance. (Esta criatura puede bloquear criaturas con la habilidad de volar.)\\nCuando el Ogro de la torreta entre al campo de batalla, si controlas otra criatura con fuerza de 4 o más, el Ogro de la torreta hace 2 puntos de daño a cada oponente.\', \'type\': \'Criatura — Guerrero ogro\', \'flavor\': \'Profesiones a las que aspiran los gruul: berserker, chamán, catapulta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486010&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1bb42a44-86af-4198-b908-1767dc5a706e\', \'multiverseId\': 486010}, \'multiverseid\': 486010}, {\'name\': \'Ogre des tourelles\', \'text\': "Portée (Cette créature peut bloquer les créatures avec le vol.)\\nQuand l\'Ogre des tourelles arrive sur le champ de bataille, si vous contrôlez une autre créature de force supérieure ou égale à 4, l\'Ogre des tourelles inflige 2 blessures à chaque adversaire.", \'type\': \'Créature : ogre et guerrier\', \'flavor\': \'Choix de carrière fréquents chez les Gruul : berserker, shamane, catapulte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486269&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4029b577-b337-4cf3-ace6-41cf219f78c6\', \'multiverseId\': 486269}, \'multiverseid\': 486269}, {\'name\': \'Ogre della Torretta\', \'text\': "Raggiungere (Questa creatura può bloccare le creature con volare.)\\nQuando l\'Ogre della Torretta entra nel campo di battaglia, se controlli un\'altra creatura con forza pari o superiore a 4, l\'Ogre della Torretta infligge 2 danni a ogni avversario.", \'type\': \'Creatura — Guerriero Ogre\', \'flavor\': \'Occupazioni più comunemente ambite dai Gruul: berserker, sciamano, catapulta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486528&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f593d993-8d0a-45e0-919b-864fb649cee6\', \'multiverseId\': 486528}, \'multiverseid\': 486528}, {\'name\': \'砲塔のオーガ\', \'text\': \'到達（このクリーチャーは飛行を持つクリーチャーをブロックできる。）\\n砲塔のオーガが戦場に出たとき、あなたが他の、パワーが４以上のクリーチャーをコントロールしている場合、砲塔のオーガは各対戦相手にそれぞれ２点のダメージを与える。\', \'type\': \'クリーチャー — オーガ・戦士\', \'flavor\': \'グルールに人気の仕事は、狂戦士か、シャーマンか、投石係だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486787&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c5d683a8-b548-4e2d-be25-83be467d0bd8\', \'multiverseId\': 486787}, \'multiverseid\': 486787}, {\'name\': \'포탑 오우거\', \'text\': \'대공 (이 생물은 비행을 가진 생물을 방어할 수 있다.)\\n포탑 오우거가 전장에 들어올 때, 당신이 공격력이 4 이상인 다른 생물을 조종한다면, 포탑 오우거는 각 상대에게 피해 2점을 입힌다.\', \'type\': \'생물 — 오우거 전사\', \'flavor\': \'그룰의 일반적인 진로 희망: 광전사, 주술사, 투석기.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487046&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4730c1c5-0b06-4e54-9852-a3b498e8fdc0\', \'multiverseId\': 487046}, \'multiverseid\': 487046}, {\'name\': \'Ogro da Torreta\', \'text\': \'Alcance (Esta criatura pode bloquear criaturas com voar.)\\nQuando Ogro da Torreta entra no campo de batalha, se você controla outra criatura com poder igual ou superior a 4, Ogro da Torreta causa 2 pontos de dano a cada oponente.\', \'type\': \'Criatura — Ogro Guerreiro\', \'flavor\': \'Aspirações profissionais comuns para os Gruul: amoque, xamã, catapulta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487305&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'66789540-2ded-41fe-820f-dbc9029b0419\', \'multiverseId\': 487305}, \'multiverseid\': 487305}, {\'name\': \'Башенный Огр\', \'text\': \'Захват (Это существо может блокировать существа с Полетом.)\\nКогда Башенный Огр выходит на поле битвы, если под вашим контролем есть другое существо с силой 4 или больше, то Башенный Огр наносит 2 повреждения каждому оппоненту.\', \'type\': \'Существо — Огр Воин\', \'flavor\': \'Каждый Груул мечтает когда-нибудь стать берсерком, шаманом или катапультой.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487564&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9db64b90-c1fa-4594-88d1-f78a6eec08f8\', \'multiverseId\': 487564}, \'multiverseid\': 487564}, {\'name\': \'炮台食人魔\', \'text\': \'延势（此生物能阻挡具飞行异能的生物。）\\n当炮台食人魔进战场时，若你操控另一个力量等于或大于4的生物，则炮台食人魔向每位对手各造成2点伤害。\', \'type\': \'生物 ～食人魔／战士\', \'flavor\': \'古鲁常见的职业目标：狂战士、祭师、投石兵。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487823&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c6fc1608-a263-4195-bb74-761a2a0ee382\', \'multiverseId\': 487823}, \'multiverseid\': 487823}, {\'name\': \'炮台食人魔\', \'text\': \'延勢（此生物能阻擋具飛行異能的生物。）\\n當炮台食人魔進戰場時，若你操控另一個力量等於或大於4的生物，則炮台食人魔向每位對手各造成2點傷害。\', \'type\': \'生物 ～食人魔／戰士\', \'flavor\': \'古魯常見的職業目標：狂戰士、祭師、投石兵。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488082&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7fcf38e7-ff03-4f6a-8f04-1f5dfa41a04c\', \'multiverseId\': 488082}, \'multiverseid\': 488082}]', '[{\'name\': \'Gewitterbeschwörer\', \'text\': \'Wenn der Gewitterbeschwörer ins Spiel kommt, fügt er jedem Gegner 2 Schadenspunkte zu.\', \'type\': \'Kreatur — Oger, Schamane\', \'flavor\': \'Seit sein Vorgänger an einem sonnigen Tag auf mysteriöse Weise vom Blitz getroffen wurde, ist er der Älteste der Schamanen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488661&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'44d1a2d5-0422-4291-9de9-929de956efd5\', \'multiverseId\': 488661}, \'multiverseid\': 488661}, {\'name\': \'Llamatormentas\', \'text\': \'Cuando el Llamatormentas entre al campo de batalla, hace 2 puntos de daño a cada oponente.\', \'type\': \'Criatura — Chamán ogro\', \'flavor\': \'Se convirtió en el gran chamán cuando a su predecesor un día despejado le cayó un rayo de forma misteriosa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488681&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'48540905-ad50-4a1e-9c81-e41b712bb3c2\', \'multiverseId\': 488681}, \'multiverseid\': 488681}, {\'name\': "Meneur d\'orage", \'text\': "Quand le Meneur d\'orage arrive sur le champ de bataille, il inflige 2 blessures à chaque adversaire.", \'type\': \'Créature : ogre et shamane\', \'flavor\': \'Il devint le doyen shamane quand son prédécesseur fut mystérieusement frappé par la foudre un jour sans nuages.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488701&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2610ea0f-a3b2-4460-b67c-d84ba9f35305\', \'multiverseId\': 488701}, \'multiverseid\': 488701}, {\'name\': \'Evocatore della Tempesta\', \'text\': "Quando l\'Evocatore della Tempesta entra nel campo di battaglia, infligge 2 danni a ogni avversario.", \'type\': \'Creatura — Sciamano Ogre\', \'flavor\': \'Divenne lo sciamano più anziano quando il suo predecessore fu misteriosamente colpito da un fulmine in una giornata senza nubi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488721&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'223e5d9e-f6a0-4704-97d4-6780c9db2c9f\', \'multiverseId\': 488721}, \'multiverseid\': 488721}, {\'name\': \'嵐呼び\', \'text\': \'嵐呼びが戦場に出たとき、これは各対戦相手にそれぞれ２点のダメージを与える。\', \'type\': \'クリーチャー — オーガ・シャーマン\', \'flavor\': \'前任者が雲一つない日に不思議な稲妻に打たれたので、彼は上座のシャーマンとなった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488741&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'83eea2d0-8523-4acb-acc9-1305e75d770f\', \'multiverseId\': 488741}, \'multiverseid\': 488741}, {\'name\': \'폭풍우 소환사\', \'text\': \'폭풍우 소환사가 전장에 들어올 때, 폭풍우 소환사는 각 상대에게 피해 2점을 입힌다.\', \'type\': \'생물 — 오우거 주술사\', \'flavor\': \'그는 이전의 장로 주술사가 기이하게도 구름 한 점 없는 날에 번개를 맞은 뒤에 그 자리에 올랐다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488761&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'40be2ad0-946e-45a7-a3dd-fd630b1a765b\', \'multiverseId\': 488761}, \'multiverseid\': 488761}, {\'name\': \'Convocador de Relâmpagos\', \'text\': \'Quando Convocador de Relâmpagos entra no campo de batalha, ele causa 2 pontos de dano a cada oponente.\', \'type\': \'Criatura — Ogro Xamã\', \'flavor\': \'Ele se tornou o xamã ancião quando seu antecessor foi misteriosamente atingido por um raio num dia sem nuvens.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488781&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2b22819e-156d-43d3-8aad-03c398967d40\', \'multiverseId\': 488781}, \'multiverseid\': 488781}, {\'name\': \'Призыватель Гроз\', \'text\': \'Когда Призыватель Гроз выходит на поле битвы, он наносит 2 повреждения каждому оппоненту.\', \'type\': \'Существо — Огр Шаман\', \'flavor\': \'Он стал шаманом-старейшиной, когда его предшественник трагически скончался от загадочной молнии, поразившей его в безоблачный день.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488801&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'68d6ea74-bb0e-4af7-aaeb-f417106afda9\', \'multiverseId\': 488801}, \'multiverseid\': 488801}, {\'name\': \'轰雷唤师\', \'text\': \'当轰雷唤师进战场时，它向每位对手各造成2点伤害。\', \'type\': \'生物 ～食人魔／祭师\', \'flavor\': \'前任者在无云的日子神秘地遭遇雷击后，他成为了长老祭师。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488821&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d047928d-5167-41e1-9c8e-758d5da48419\', \'multiverseId\': 488821}, \'multiverseid\': 488821}, {\'name\': \'轟雷喚師\', \'text\': \'當轟雷喚師進戰場時，它向每位對手各造成2點傷害。\', \'type\': \'生物 ～食人魔／祭師\', \'flavor\': \'前任者在無雲的日子神秘地遭遇雷擊後，他成為了長老祭師。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488841&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'34a1ac91-0861-4c04-9a4a-8c02c08c1028\', \'multiverseId\': 488841}, \'multiverseid\': 488841}]', '[{\'name\': \'Gewitterschwingenwesen\', \'text\': \'Dieser Zauberspruch kostet beim Wirken {2}{U} weniger, falls du in diesem Zug einen Spontanzauber oder eine Hexerei gewirkt hast.\\nFliegend\\nBravour (Immer wenn du einen Nichtkreatur-Zauberspruch wirkst, erhält diese Kreatur +1/+1 bis zum Ende des Zuges.)\\nWenn das Gewitterschwingenwesen ins Spiel kommt, wende Hellsicht 2 an.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485655&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d054af84-3518-4ad0-97aa-49bff5a1d1c5\', \'multiverseId\': 485655}, \'multiverseid\': 485655}, {\'name\': \'Entidad alatormenta\', \'text\': \'Te cuesta {2}{U} menos lanzar este hechizo si ya lanzaste un hechizo de instantáneo o de conjuro este turno.\\nVuela.\\nDestreza. (Siempre que lances un hechizo que no sea de criatura, esta criatura obtiene +1/+1 hasta el final del turno.)\\nCuando la Entidad alatormenta entre al campo de batalla, adivina 2.\', \'type\': \'Criatura — Elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485914&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7367ac9a-557e-40e8-9036-81aae4bb62fd\', \'multiverseId\': 485914}, \'multiverseid\': 485914}, {\'name\': \'Entité ailorage\', \'text\': "Ce sort coûte {2}{U} de moins à lancer si vous avez lancé un sort d\'éphémère ou de rituel ce tour-ci.\\nVol\\nProuesse (À chaque fois que vous lancez un sort non-créature, cette créature gagne +1/+1 jusqu\'à la fin du tour.)\\nQuand l\'Entité ailorage arrive sur le champ de bataille, regard 2.", \'type\': \'Créature : élémental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486173&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'49a16c6f-3363-4a37-86d5-d79a7a6c3e2c\', \'multiverseId\': 486173}, \'multiverseid\': 486173}, {\'name\': \'Entità Alafolgorante\', \'text\': "Questa magia costa {2}{U} in meno per essere lanciata se hai lanciato una magia istantaneo o stregoneria in questo turno.\\nVolare\\nProdezza (Ogniqualvolta lanci una magia non creatura, questa creatura prende +1/+1 fino alla fine del turno.)\\nQuando l\'Entità Alafolgorante entra nel campo di battaglia, profetizza 2.", \'type\': \'Creatura — Elementale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486432&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b702560e-11e3-4172-b204-fcb36289f929\', \'multiverseId\': 486432}, \'multiverseid\': 486432}, {\'name\': \'嵐翼の精体\', \'text\': \'このターンにあなたがインスタントかソーサリーである呪文を唱えていたなら、この呪文を唱えるためのコストは{2}{U}少なくなる。\\n飛行\\n果敢（あなたがクリーチャーでない呪文を唱えるたび、ターン終了時まで、このクリーチャーは＋１/＋１の修整を受ける。）\\n嵐翼の精体が戦場に出たとき、占術２を行う。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486691&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0f8e437f-6f7d-4962-95fe-3511a59d9a67\', \'multiverseId\': 486691}, \'multiverseid\': 486691}, {\'name\': \'폭풍날개의 존재\', \'text\': \'이 주문은 당신이 이번 턴에 순간마법 또는 집중마법 주문을 발동했다면 발동하는 데 {2}{U}가 덜 든다.\\n비행\\n기량 (당신이 생물이 아닌 주문을 발동할 때마다, 이 생물은 턴종료까지 +1/+1을 받는다.)\\n폭풍날개의 존재가 전장에 들어올 때, 점술 2를 한다.\', \'type\': \'생물 — 정령\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486950&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e6e12346-417f-4a3c-98f0-d5a7aca05d4d\', \'multiverseId\': 486950}, \'multiverseid\': 486950}, {\'name\': \'Entidade da Asa Tempestuosa\', \'text\': \'Esta mágica custa {2}{U} a menos para ser conjurada se você conjurou uma mágica instantânea ou um feitiço neste turno.\\nVoar\\nDestreza (Toda vez que você conjura uma mágica que não seja de criatura, esta criatura recebe +1/+1 até o final do turno.)\\nQuando Entidade da Asa Tempestuosa entrar no campo de batalha, use vidência 2.\', \'type\': \'Criatura — Elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487209&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0eb0a957-e723-4dd7-9549-e581d4bdde25\', \'multiverseId\': 487209}, \'multiverseid\': 487209}, {\'name\': \'Сущность Штормового Крыла\', \'text\': \'Разыгрывание этого заклинания стоит на {2}{U} меньше, если в этом ходу вы уже разыграли мгновенное заклинание или заклинание волшебства.\\nПолет\\nИскусность (Каждый раз, когда вы разыгрываете не являющееся существом заклинание, это существо получает +1/+1 до конца хода.)\\nКогда Сущность Штормового Крыла выходит на поле битвы, предскажите 2.\', \'type\': \'Существо — Элементаль\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487468&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1bb210a7-799d-42c7-ba76-50fee8d9f3db\', \'multiverseId\': 487468}, \'multiverseid\': 487468}, {\'name\': \'暴风翼灵\', \'text\': \'如果你本回合中施放过瞬间或法术咒语，则此咒语减少{2}{U}来施放。\\n飞行\\n灵技（每当你施放非生物咒语时，此生物得+1/+1直到回合结束。）\\n当暴风翼灵进战场时，占卜2。\', \'type\': \'生物 ～元素\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487727&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d898c902-3997-4d07-aaa5-17dab646bdf3\', \'multiverseId\': 487727}, \'multiverseid\': 487727}, {\'name\': \'暴風翼靈\', \'text\': \'如果你本回合中施放過瞬間或巫術咒語，則此咒語減少{2}{U}來施放。\\n飛行\\n靈技（每當你施放非生物咒語時，此生物得+1/+1直到回合結束。）\\n當暴風翼靈進戰場時，占卜2。\', \'type\': \'生物 ～元素\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487986&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e7ac5f09-e008-4b93-9172-136b56d5e237\', \'multiverseId\': 487986}, \'multiverseid\': 487986}]', '[{\'name\': \'Glorreiche Hymne\', \'text\': \'Kreaturen, die du kontrollierst, erhalten +1/+1.\', \'type\': \'Verzauberung\', \'flavor\': \'Lieder von Engeln werden nicht als Worte in den Ohren wahrgenommen, sondern als Regungen in der Seele.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485603&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bb6de930-310e-4f27-9d2b-8f34d8e6ab73\', \'multiverseId\': 485603}, \'multiverseid\': 485603}, {\'name\': \'Himno glorioso\', \'text\': \'Las criaturas que controlas obtienen +1/+1.\', \'type\': \'Encantamiento\', \'flavor\': \'Los cantos angélicos no se perciben como palabras en los oídos, sino como sensaciones en el alma.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485862&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'00d534a0-7375-4ceb-96c1-dfb9d0c0c2a8\', \'multiverseId\': 485862}, \'multiverseid\': 485862}, {\'name\': \'Antienne glorieuse\', \'text\': \'Les créatures que vous contrôlez gagnent +1/+1.\', \'type\': \'Enchantement\', \'flavor\': "Les chants des anges sont perçus non comme des mots que l\'on entend, mais comme des frissons que l\'on ressent.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486121&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8d179249-c483-42e8-8d7b-7b7e486e8dd0\', \'multiverseId\': 486121}, \'multiverseid\': 486121}, {\'name\': \'Inno Glorioso\', \'text\': \'Le creature che controlli prendono +1/+1.\', \'type\': \'Incantesimo\', \'flavor\': "I canti degli angeli non vengono percepiti come parole dalle orecchie, ma come carezze all\'anima.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486380&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3828faf8-cc03-433b-8881-7cd8a8b340c4\', \'multiverseId\': 486380}, \'multiverseid\': 486380}, {\'name\': \'栄光の頌歌\', \'text\': \'あなたがコントロールしているクリーチャーは＋１/＋１の修整を受ける。\', \'type\': \'エンチャント\', \'flavor\': \'天使の歌声は、耳に聞こえる言葉ではなく、魂の躍動をもって感じられる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486639&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9413d6c9-2bd1-4e65-9494-68110b8597da\', \'multiverseId\': 486639}, \'multiverseid\': 486639}, {\'name\': \'영광스러운 군가\', \'text\': \'당신이 조종하는 생물들은 +1/+1을 받는다.\', \'type\': \'부여마법\', \'flavor\': \'천사들의 노래는 귀에 들리는 말소리가 아니라 영혼을 울리는 흔들림으로 받아들여진다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486898&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ddb1c0e9-4390-4451-9689-713ffbdfe57a\', \'multiverseId\': 486898}, \'multiverseid\': 486898}, {\'name\': \'Antífona Gloriosa\', \'text\': \'As criaturas que você controla recebem +1/+1.\', \'type\': \'Encantamento\', \'flavor\': \'As canções dos anjos são percebidas não como palavras, mas como vibrações na alma.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487157&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'159d724b-2c30-48cd-a1ad-d565466cfa12\', \'multiverseId\': 487157}, \'multiverseid\': 487157}, {\'name\': \'Славный Гимн\', \'text\': \'Существа под вашим контролем получают +1/+1.\', \'type\': \'Чары\', \'flavor\': \'Песни ангелов — это не слова, которые слышат уши, а порывы души.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487416&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e2fa70ed-7d66-43d2-938e-8671624ffa74\', \'multiverseId\': 487416}, \'multiverseid\': 487416}, {\'name\': \'辉煌的赞美诗\', \'text\': \'由你操控的生物得+1/+1。\', \'type\': \'结界\', \'flavor\': \'天使歌声并非只是传入耳中的旋律，而是震撼心灵的回响。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487675&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7195a556-1735-42b7-a567-ed0be2919901\', \'multiverseId\': 487675}, \'multiverseid\': 487675}, {\'name\': \'輝煌的讚美詩\', \'text\': \'由你操控的生物得+1/+1。\', \'type\': \'結界\', \'flavor\': \'天使歌聲並非只是傳入耳中的旋律，而是震撼心靈的迴響。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487934&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'976124db-12e8-4ad2-80f5-634fdfe2c967\', \'multiverseId\': 487934}, \'multiverseid\': 487934}]', '[{\'name\': \'Gnadenstoß\', \'text\': \'Zerstöre eine Kreatur oder einen Planeswalker deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„In dieser Welt gilt: Töten oder getötet werden. Ich möchte lieber nicht, dass mir Letzteres widerfährt."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485681&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'824c3db9-82ae-4302-a6f3-2ff62956247f\', \'multiverseId\': 485681}, \'multiverseid\': 485681}, {\'name\': \'Remate final\', \'text\': \'Destruye la criatura o planeswalker objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"En este mundo, o matas o te matan. No prefiero lo segundo".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485940&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8831cce5-51c0-42d3-acdb-9872f246f1ed\', \'multiverseId\': 485940}, \'multiverseid\': 485940}, {\'name\': \'Coup de grâce\', \'text\': \'Détruisez la créature ciblée ou le planeswalker ciblé.\', \'type\': \'Éphémère\', \'flavor\': \'« Dans ce monde, on tue ou on se fait tuer. Je préfère éviter la seconde option. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486199&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3159088f-416e-45ab-9d82-49be8af59e65\', \'multiverseId\': 486199}, \'multiverseid\': 486199}, {\'name\': \'Colpo di Grazia\', \'text\': \'Distruggi una creatura o un planeswalker bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"In questo mondo, o uccidi o vieni ucciso. Preferirei evitare quest\\\'ultima opzione."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486458&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1b532b0c-709f-431f-b4f9-846b504ea48f\', \'multiverseId\': 486458}, \'multiverseid\': 486458}, {\'name\': \'とどめの一撃\', \'text\': \'クリーチャー１体かプレインズウォーカー１体を対象とし、それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'「この世界は、殺るか殺られるか。できれば後者にはなりたくない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486717&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a2a9dcbd-44ff-4d24-81a2-5ff653e95c7b\', \'multiverseId\': 486717}, \'multiverseid\': 486717}, {\'name\': \'마무리 일격\', \'text\': \'생물 또는 플레인즈워커를 목표로 정한다. 그 목표를 파괴한다.\', \'type\': \'순간마법\', \'flavor\': \'"이 세계에서는, 죽이든지 죽든지야. 난 후자가 되는 건 사양이라고."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486976&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'826fae63-fbea-4780-ad83-43be56bc5dfd\', \'multiverseId\': 486976}, \'multiverseid\': 486976}, {\'name\': \'Golpe Finalizador\', \'text\': \'Destrua a criatura ou o planeswalker alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Nesse mundo, é matar ou morrer. Eu prefiro evitar o segundo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487235&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'13877922-8fb5-42fb-8120-685db272cd5c\', \'multiverseId\': 487235}, \'multiverseid\': 487235}, {\'name\': \'Добивающий Удар\', \'text\': "Уничтожьте целевое существо или planeswalker\'а.", \'type\': \'Мгновенное заклинание\', \'flavor\': \'«В этом мире ты убиваешь — или убивают тебя. И второй вариант мне совсем не нравится».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487494&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7e0dbe5b-8e25-4753-9b1a-8f980ac405bd\', \'multiverseId\': 487494}, \'multiverseid\': 487494}, {\'name\': \'终命一击\', \'text\': \'消灭目标生物或鹏洛客。\', \'type\': \'瞬间\', \'flavor\': \'「在这世上，不是你杀人就是被人杀。我宁愿不要被人杀。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487753&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5147a021-0934-4789-8918-f1e69b0bea9b\', \'multiverseId\': 487753}, \'multiverseid\': 487753}, {\'name\': \'終命一擊\', \'text\': \'消滅目標生物或鵬洛客。\', \'type\': \'瞬間\', \'flavor\': \'「在這世上，不是你殺人就是被人殺。我寧願不要被人殺。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488012&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a2225a39-672e-412c-8f8d-bcb39dbd9682\', \'multiverseId\': 488012}, \'multiverseid\': 488012}]', '[{\'name\': \'Goblin-Brandstifter\', \'text\': \'Wenn der Goblin-Brandstifter stirbt, kannst du ihn einem Ziel deiner Wahl 1 Schadenspunkt zufügen lassen.\', \'type\': \'Kreatur — Goblin, Schamane\', \'flavor\': \'Mit großer Macht kommt auch das große Risiko, getötet zu werden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485729&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'86567d95-2cbc-4d0b-9b91-23bd22205e83\', \'multiverseId\': 485729}, \'multiverseid\': 485729}, {\'name\': \'Calcinador trasgo\', \'text\': \'Cuando el Calcinador trasgo muera, puedes hacer que haga 1 punto de daño a cualquier objetivo.\', \'type\': \'Criatura — Chamán trasgo\', \'flavor\': \'Un gran poder conlleva un gran riesgo de hacer que te maten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485988&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2e61f314-1a8c-44e6-9069-5aaabe76ba80\', \'multiverseId\': 485988}, \'multiverseid\': 485988}, {\'name\': \'Incendiaire gobelin\', \'text\': "Quand l\'Incendiaire gobelin meurt, vous pouvez faire qu\'il inflige 1 blessure à n\'importe quelle cible.", \'type\': \'Créature : gobelin et shamane\', \'flavor\': \'Quiconque a un grand pouvoir court le risque de se faire tuer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486247&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6b880ffb-3362-4831-8c16-2dbe2d794fc5\', \'multiverseId\': 486247}, \'multiverseid\': 486247}, {\'name\': \'Goblin Inceneritore\', \'text\': \'Quando il Goblin Inceneritore muore, puoi fargli infliggere 1 danno a un qualsiasi bersaglio.\', \'type\': \'Creatura — Sciamano Goblin\', \'flavor\': \'Con molto potere ci sono molti rischi di rimanere uccisi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486506&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'aa10df46-c7ba-4281-bfc0-4c7d7baec3a8\', \'multiverseId\': 486506}, \'multiverseid\': 486506}, {\'name\': \'ゴブリンの付け火屋\', \'text\': \'ゴブリンの付け火屋が死亡したとき、クリーチャー１体かプレインズウォーカー１体かプレイヤー１人を対象とする。あなたは「ゴブリンの付け火屋はそれに１点のダメージを与える。」を選んでもよい。\', \'type\': \'クリーチャー — ゴブリン・シャーマン\', \'flavor\': \'大きな力は、自分をも殺してしまうほどの大きな危険を伴う。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486765&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ad064413-67e1-4c4c-8029-e4398dae73cb\', \'multiverseId\': 486765}, \'multiverseid\': 486765}, {\'name\': \'고블린 방화범\', \'text\': \'고블린 방화범이 죽을 때, 원하는 목표를 정한다. 당신은 고블린 방화범이 그 목표에게 피해 1점을 입히게 할 수 있다.\', \'type\': \'생물 — 고블린 주술사\', \'flavor\': \'강력한 힘에는 높은 사망 확률이 따르는 법이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487024&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8db9192c-ca3f-4cd1-99a0-adfb16073960\', \'multiverseId\': 487024}, \'multiverseid\': 487024}, {\'name\': \'Pirômano Goblin\', \'text\': \'Quando Pirômano Goblin morre, você pode fazer com que ele cause 1 ponto de dano a qualquer alvo.\', \'type\': \'Criatura — Goblin Xamã\', \'flavor\': \'Um poder grandioso também traz consigo um grande risco de morte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487283&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'52e9dd3f-39c8-499f-a025-4e0e9d19ca0b\', \'multiverseId\': 487283}, \'multiverseid\': 487283}, {\'name\': \'Гоблин-Воспламенитель\', \'text\': \'Когда Гоблин-Воспламенитель умирает, вы можете заставить его нанести 1 повреждение любой цели.\', \'type\': \'Существо — Гоблин Шаман\', \'flavor\': \'Чем больше могущество, тем больше риск быть убитым.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487542&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7700a487-64fd-4dc6-bd04-3628c7a4540e\', \'multiverseId\': 487542}, \'multiverseid\': 487542}, {\'name\': \'纵火鬼怪\', \'text\': \'当纵火鬼怪死去时，你可以让它对任意一个目标造成1点伤害。\', \'type\': \'生物 ～鬼怪／祭师\', \'flavor\': \'能力越强，丧命的危险越大。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487801&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bdb05f17-c597-47d3-9b5a-d29f6b127297\', \'multiverseId\': 487801}, \'multiverseid\': 487801}, {\'name\': \'縱火鬼怪\', \'text\': \'當縱火鬼怪死去時，你可以讓它對任意一個目標造成1點傷害。\', \'type\': \'生物 ～鬼怪／祭師\', \'flavor\': \'能力越強，喪命的危險越大。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488060&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'771d1959-9a95-449d-8afb-9eaf63989ae5\', \'multiverseId\': 488060}, \'multiverseid\': 488060}]', '[{\'name\': \'Goblin-Zauberei\', \'text\': \'Erzeuge zwei 1/1 rote Goblin-Zauberer-Kreaturenspielsteine mit Bravour. (Immer wenn du einen Nichtkreatur-Zauberspruch wirkst, erhalten sie +1/+1 bis zum Ende des Zuges.)\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ruhe in der Bibliothek" war bald die geringste ihrer Sorgen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485730&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c85db477-77fa-4c35-9034-07cb8a7f3a93\', \'multiverseId\': 485730}, \'multiverseid\': 485730}, {\'name\': \'Magia trasga\', \'text\': \'Crea dos fichas de criatura Hechicero Trasgo rojas 1/1 con la habilidad de destreza. (Siempre que lances un hechizo que no sea de criatura, obtienen +1/+1 hasta el final del turno.)\', \'type\': \'Instantáneo\', \'flavor\': \'En poco tiempo, "silencio en la biblioteca" dio pie a problemas más preocupantes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485989&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c7ed5b65-1736-4345-91dc-7c279f1fe9b4\', \'multiverseId\': 485989}, \'multiverseid\': 485989}, {\'name\': \'Sorcellerie gobeline\', \'text\': "Créez deux jetons de créature 1/1 rouge Gobelin et Sorcier avec la prouesse. (À chaque fois que vous lancez un sort non-créature, ils gagnent +1/+1 jusqu\'à la fin du tour.)", \'type\': \'Éphémère\', \'flavor\': \'Demander le silence dans la bibliothèque causa rapidement de plus gros ennuis.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486248&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b3351247-1b55-4c74-bbf1-617e1cfca417\', \'multiverseId\': 486248}, \'multiverseid\': 486248}, {\'name\': \'Arte Magica dei Goblin\', \'text\': \'Crea due pedine creatura Mago Goblin 1/1 rosse con prodezza. (Ogniqualvolta lanci una magia non creatura, le pedine prendono +1/+1 fino alla fine del turno.)\', \'type\': \'Istantaneo\', \'flavor\': \'"Silenzio in biblioteca" venne presto sostituito da preoccupazioni ben più serie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486507&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3d28b050-a4c4-41fc-b379-da21b16ecb12\', \'multiverseId\': 486507}, \'multiverseid\': 486507}, {\'name\': \'ゴブリンの魔術\', \'text\': \'果敢を持つ赤の１/１のゴブリン・ウィザード・クリーチャー・トークンを２体生成する。（あなたがクリーチャーでない呪文を唱えるたび、ターン終了時まで、それらは＋１/＋１の修整を受ける。）\', \'type\': \'インスタント\', \'flavor\': \'すぐに「図書館ではお静かに」どころではなくなった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486766&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3c20a14d-b820-4087-af92-ddd2ce6b8f6f\', \'multiverseId\': 486766}, \'multiverseid\': 486766}, {\'name\': \'고블린의 묘기\', \'text\': \'기량을 가진 1/1 적색 고블린 마법사 생물 토큰 두 개를 만든다. (당신이 생물이 아닌 주문을 발동할 때마다, 이 토큰들은 턴종료까지 +1/+1을 받는다.)\', \'type\': \'순간마법\', \'flavor\': \'"도서관에서 정숙"은 곧 더 큰 문제거리에 잊혔다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487025&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'99cdcb34-d088-4f24-83eb-fe13929e7278\', \'multiverseId\': 487025}, \'multiverseid\': 487025}, {\'name\': \'Feitiçaria Goblin\', \'text\': \'Crie duas fichas de criatura vermelhas 1/1 do tipo Goblin Mago com destreza. (Toda vez que você conjura uma mágica que não seja de criatura, elas recebem +1/+1 até o final do turno.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Silêncio na biblioteca" logo deu lugar a preocupações maiores.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487284&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dc64cd1a-6f76-47bd-a045-7a60fe2b5f3a\', \'multiverseId\': 487284}, \'multiverseid\': 487284}, {\'name\': \'Гоблинское Колдовство\', \'text\': \'Создайте две фишки существа 1/1 красный Гоблин Чародей с Искусностью. (Каждый раз, когда вы разыгрываете не являющееся существом заклинание, они получают +1/+1 до конца хода.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Соблюдение тишины в библиотеке вскоре уступило место куда более серьезным заботам.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487543&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'06be22f0-0c3c-47c8-91a5-bba635de5228\', \'multiverseId\': 487543}, \'multiverseid\': 487543}, {\'name\': \'鬼怪巫法\', \'text\': \'派出两个1/1红色，具灵技异能的鬼怪／法术师衍生生物。（每当你施放非生物咒语时，它们得+1/+1直到回合结束。）\', \'type\': \'瞬间\', \'flavor\': \'「馆内保持安静」很快就不是最头痛的事情了。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487802&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'76d073fd-7055-4503-a470-8ff6e9bafa03\', \'multiverseId\': 487802}, \'multiverseid\': 487802}, {\'name\': \'鬼怪巫法\', \'text\': \'派出兩個1/1紅色，具靈技異能的鬼怪／魔法師衍生生物。（每當你施放非生物咒語時，它們得+1/+1直到回合結束。）\', \'type\': \'瞬間\', \'flavor\': \'「館內保持安靜」很快就不是最頭痛的事情了。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488061&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'568f8ee3-dfcd-4757-926d-df84cfbc6cb5\', \'multiverseId\': 488061}, \'multiverseid\': 488061}]', '[{\'name\': \'Grabschrift-Golem\', \'text\': \'{2}: Lege eine Karte deiner Wahl aus deinem Friedhof unter deine Bibliothek.\', \'type\': \'Artefaktkreatur — Golem\', \'flavor\': \'Viele Namen und Erinnerungen, vereint für einen grausamen Zweck.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485812&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e6f3f7a6-3cd0-4d8f-a953-05ad23f5aa56\', \'multiverseId\': 485812}, \'multiverseid\': 485812}, {\'name\': \'Gólem epitafio\', \'text\': \'{2}: Pon la carta objetivo de tu cementerio en la parte inferior de tu biblioteca.\', \'type\': \'Criatura artefacto — Gólem\', \'flavor\': \'Muchos nombres y muchos recuerdos reunidos por un sombrío propósito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486071&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e12a1b39-50fe-4c14-bec7-3bcd0d825208\', \'multiverseId\': 486071}, \'multiverseid\': 486071}, {\'name\': "Golem d\'épitaphe", \'text\': \'{2} : Mettez la carte ciblée depuis votre cimetière au-dessous de votre bibliothèque.\', \'type\': \'Créature-artefact : golem\', \'flavor\': \'De nombreux noms et souvenirs réunis dans un but sinistre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486330&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'62d9caa7-9151-410a-8d98-f3e4ad6c828b\', \'multiverseId\': 486330}, \'multiverseid\': 486330}, {\'name\': "Golem dell\'Epitaffio", \'text\': \'{2}: Metti una carta bersaglio dal tuo cimitero in fondo al tuo grimorio.\', \'type\': \'Creatura Artefatto — Golem\', \'flavor\': \'Molti nomi e molti ricordi uniti per uno scopo lugubre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486589&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4f52f52a-92c8-45f7-bf25-867b63873f4e\', \'multiverseId\': 486589}, \'multiverseid\': 486589}, {\'name\': \'墓碑のゴーレム\', \'text\': \'{2}：あなたの墓地からカード１枚を対象とし、それをあなたのライブラリーの一番下に置く。\', \'type\': \'アーティファクト・クリーチャー — ゴーレム\', \'flavor\': \'多数の名前と多数の思い出が、恐ろしい目的で一つになっている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486848&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2e02e67c-8f68-42f4-87f2-0a505ecbaed7\', \'multiverseId\': 486848}, \'multiverseid\': 486848}, {\'name\': \'묘비 골렘\', \'text\': \'{2}: 당신의 무덤에 있는 카드를 목표로 정한다. 그 카드를 당신의 서고 맨 밑에 놓는다.\', \'type\': \'마법물체 생물 — 골렘\', \'flavor\': \'많은 이름과 많은 추억이 무시무시한 목적을 위해 한 데 묶여있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487107&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8515c7b4-7cee-4308-8bf7-c1e714381db7\', \'multiverseId\': 487107}, \'multiverseid\': 487107}, {\'name\': \'Golem do Epitáfio\', \'text\': \'{2}: Coloque o card alvo de seu cemitério no fundo de seu grimório.\', \'type\': \'Criatura Artefato — Golem\', \'flavor\': \'Uma reunião de muitos nomes e lembranças para um sinistro propósito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487366&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bd77f202-eb57-4ad8-b889-eabd893ef877\', \'multiverseId\': 487366}, \'multiverseid\': 487366}, {\'name\': \'Голем Эпитафий\', \'text\': \'{2}: положите целевую карту из вашего кладбища в низ вашей библиотеки.\', \'type\': \'Артефакт Существо — Голем\', \'flavor\': \'Множество имен и воспоминаний сплетено вместе с мрачной целью.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487625&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'75e995ec-7ea5-457f-9552-f9cfa1bc0523\', \'multiverseId\': 487625}, \'multiverseid\': 487625}, {\'name\': \'墓碑魔像\', \'text\': \'{2}：将目标牌从你坟墓场置于你的牌库底。\', \'type\': \'神器生物 ～魔像\', \'flavor\': \'许多人名与回忆因险恶目的有了紧密联系。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487884&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f881c17f-3c0e-49c5-9866-fa0a1aaed8e5\', \'multiverseId\': 487884}, \'multiverseid\': 487884}, {\'name\': \'墓碑魔像\', \'text\': \'{2}：將目標牌從你墳墓場置於你的牌庫底。\', \'type\': \'神器生物 ～魔像\', \'flavor\': \'許多人名與回憶因險惡目的有了緊密聯繫。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488143&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b50bb890-0a7a-4e21-b121-53162f15aa20\', \'multiverseId\': 488143}, \'multiverseid\': 488143}]', '[{\'name\': \'Greifenhorst\', \'text\': \'Zu Beginn deines Endsegments und falls du in diesem Zug 3 oder mehr Lebenspunkte dazuerhalten hast, erzeuge einen 2/2 weißen Greif-Kreaturenspielstein mit Flugfähigkeit.\', \'type\': \'Verzauberung\', \'flavor\': \'Als die Greifen auf dem Nordturm zu nisten begannen, befürchtete der Kastellan, sie könnten zu einer Plage werden. Stattdessen beschützen sie nun das gesamte Schloss.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485604&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0f97d868-bb1a-41bf-b23b-8e27add97f12\', \'multiverseId\': 485604}, \'multiverseid\': 485604}, {\'name\': \'Nido de grifos\', \'text\': \'Al comienzo de tu paso final, si ganaste 3 o más vidas este turno, crea una ficha de criatura Grifo blanca 2/2 con la habilidad de volar.\', \'type\': \'Encantamiento\', \'flavor\': \'Cuando los grifos empezaron a anidar en lo alto de la torre septentrional, el gobernador del castillo creyó que serían un estorbo, mas todo el castillo se benefició del amparo de los grifos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485863&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8b7ef810-4b8c-48e4-a854-ba28f7b62916\', \'multiverseId\': 485863}, \'multiverseid\': 485863}, {\'name\': \'Aérain de griffons\', \'text\': \'Au début de votre étape de fin, si vous avez gagné au moins 3 points de vie ce tour-ci, créez un jeton de créature 2/2 blanche Griffon avec le vol.\', \'type\': \'Enchantement\', \'flavor\': "Quand les griffons commencèrent à nicher au sommet de la tour nord, le châtelain eut peur qu\'ils ne deviennent une nuisance. Au lieu de cela, ils placèrent le château tout entier sous leur protection.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486122&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'da20f282-8f04-4e19-8066-d2755427c39b\', \'multiverseId\': 486122}, \'multiverseid\': 486122}, {\'name\': \'Nido di Grifoni\', \'text\': "All\'inizio della tua sottofase finale, se hai guadagnato 3 o più punti vita in questo turno, crea una pedina creatura Grifone 2/2 bianca con volare.", \'type\': \'Incantesimo\', \'flavor\': "Quando i grifoni iniziarono a nidificare in cima alla torre nord, il castellano temeva che si sarebbero rivelati una seccatura. Invece, presero l\'intero castello sotto la loro ala protettiva.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486381&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'63d4dbd3-464c-4da5-872f-f053707bbbd0\', \'multiverseId\': 486381}, \'multiverseid\': 486381}, {\'name\': \'グリフィンの高楼\', \'text\': \'あなたの終了ステップの開始時に、このターンにあなたがライフを３点以上得ていた場合、飛行を持つ白の２/２のグリフィン・クリーチャー・トークンを１体生成する。\', \'type\': \'エンチャント\', \'flavor\': \'グリフィンが北の塔に巣を掛けたとき、城主はそれが迷惑だと思った。実際には、グリフィンは城全体を保護してくれた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486640&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d3123b2c-1e77-4ed4-b756-bc2c84247016\', \'multiverseId\': 486640}, \'multiverseid\': 486640}, {\'name\': \'그리핀 둥지\', \'text\': \'당신의 종료단 시작에, 당신이 이번 턴에 생명 3점 이상을 얻었다면, 비행을 가진 2/2 백색 그리핀 생물 토큰 한 개를 만든다.\', \'type\': \'부여마법\', \'flavor\': \'북쪽 탑 꼭대기에 그리핀들이 둥지를 틀기 시작했을 때, 성주는 그것들이 골칫거리가 될까 걱정했다. 그와는 반대로, 그것들이 성 전체를 보호해 주었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486899&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'437f251e-e733-4973-9aaa-553f188ad84a\', \'multiverseId\': 486899}, \'multiverseid\': 486899}, {\'name\': \'Ninho dos Grifos\', \'text\': \'No início de sua etapa final, se você ganhou 3 ou mais pontos de vida neste turno, crie uma ficha de criatura branca 2/2 do tipo Grifo com voar.\', \'type\': \'Encantamento\', \'flavor\': \'Quando os grifos começaram a fazer ninho na torre norte, o castelão temeu que seriam um aborrecimento. Em vez disso, eles passaram a proteger todo o castelo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487158&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a8e00bc6-ef2d-4b0a-8ad7-d427f2677fe6\', \'multiverseId\': 487158}, \'multiverseid\': 487158}, {\'name\': \'Гнездо Грифонов\', \'text\': \'В начале вашего заключительного шага, если в этом ходу вы получили 3 или более жизней, создайте одну фишку существа 2/2 белый Грифон с Полетом.\', \'type\': \'Чары\', \'flavor\': \'Когда на северной башне угнездились грифоны, кастелян забеспокоился, как бы от них не было хлопот. Но оказалось, что они весь замок взяли под свою защиту.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487417&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e7afa60e-4530-4586-9849-0abfaddf53b5\', \'multiverseId\': 487417}, \'multiverseid\': 487417}, {\'name\': \'狮鹫栖巢\', \'text\': \'在你的结束步骤开始时，若你本回合中获得了3点或更多生命，则派出一个2/2白色，具飞行异能的狮鹫衍生生物。\', \'type\': \'结界\', \'flavor\': \'起初狮鹫开始在北塔塔顶筑巢的时候，城主还担心它们日后会成为安全隐忧。但没想到它们却成了整座城堡的安全保障。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487676&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4be822c7-ff99-4d62-9df1-dc5ddb52803e\', \'multiverseId\': 487676}, \'multiverseid\': 487676}, {\'name\': \'獅鷲棲巢\', \'text\': \'在你的結束步驟開始時，若你本回合中獲得了3點或更多生命，則派出一個2/2白色，具飛行異能的獅鷲衍生生物。\', \'type\': \'結界\', \'flavor\': \'起初獅鷲開始在北塔塔頂築巢的時候，城主還擔心牠們日後會成為安全隱憂。但沒想到牠們卻成了整座城堡的安全保障。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487935&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'222f848a-bf7a-4f53-ab80-c28fb6c0c594\', \'multiverseId\': 487935}, \'multiverseid\': 487935}]', '[{\'name\': \'Grimmiger Empath\', \'text\': \'Wenn der Grimmige Empath ins Spiel kommt, kannst du deine Bibliothek nach einer Kreaturenkarte mit umgewandelten Manakosten von 6 oder mehr durchsuchen, sie offen vorzeigen, auf deine Hand nehmen und dann deine Bibliothek mischen.\', \'type\': \'Kreatur — Elf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485763&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e5a4b20a-ba25-4f4f-a88f-0415bbeb243b\', \'multiverseId\': 485763}, \'multiverseid\': 485763}, {\'name\': \'Émpata fiero\', \'text\': \'Cuando el Émpata fiero entre al campo de batalla, puedes buscar en tu biblioteca una carta de criatura con coste de maná convertido de 6 o más, mostrarla, ponerla en tu mano y luego barajar tu biblioteca.\', \'type\': \'Criatura — Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486022&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'19d8f3d0-a587-4485-aab8-4642da0ff771\', \'multiverseId\': 486022}, \'multiverseid\': 486022}, {\'name\': \'Empathe farouche\', \'text\': "Quand l\'Empathe farouche arrive sur le champ de bataille, vous pouvez chercher dans votre bibliothèque une carte de créature ayant un coût converti de mana supérieur ou égal à 6, la révéler, la mettre dans votre main et mélanger ensuite votre bibliothèque.", \'type\': \'Créature : elfe\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486281&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1b80b04d-75d8-406a-b0cc-edae4872c1be\', \'multiverseId\': 486281}, \'multiverseid\': 486281}, {\'name\': \'Empatico Spietato\', \'text\': "Quando l\'Empatico Spietato entra nel campo di battaglia, puoi passare in rassegna il tuo grimorio per una carta creatura con costo di mana convertito pari o superiore a 6, rivelarla, aggiungerla alla tua mano, poi rimescolare il tuo grimorio.", \'type\': \'Creatura — Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486540&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'94dda205-0222-42e2-a40b-cbd757165f4b\', \'multiverseId\': 486540}, \'multiverseid\': 486540}, {\'name\': \'激情の共感者\', \'text\': \'激情の共感者が戦場に出たとき、あなたは「あなたのライブラリーから点数で見たマナ・コストが６以上のクリーチャー・カード１枚を探し、公開し、あなたの手札に加え、その後あなたのライブラリーを切り直す。」を選んでもよい。\', \'type\': \'クリーチャー — エルフ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486799&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'620a7e73-c7c3-48b6-98d0-242ee4479171\', \'multiverseId\': 486799}, \'multiverseid\': 486799}, {\'name\': \'사나운 감응술사\', \'text\': \'사나운 감응술사가 전장에 들어올 때, 당신은 당신의 서고에서 전환마나비용이 6 이상인 생물 카드 한 장을 찾아 공개한 후 당신의 손으로 가져갈 수 있다. 그렇게 한다면, 당신의 서고를 섞는다.\', \'type\': \'생물 — 엘프\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487058&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'44b3d183-83fd-4df5-a230-5c43874fb1eb\', \'multiverseId\': 487058}, \'multiverseid\': 487058}, {\'name\': \'Empático Feroz\', \'text\': \'Quando Empático Feroz entra no campo de batalha, você pode procurar em seu grimório um card de criatura com custo de mana convertido igual ou superior a 6, revelá-lo, colocá-lo em sua mão e, depois, embaralhar seu grimório.\', \'type\': \'Criatura — Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487317&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'efc08302-7326-4b50-88ea-68aba32f13a0\', \'multiverseId\': 487317}, \'multiverseid\': 487317}, {\'name\': \'Яростный Эмпат\', \'text\': \'Когда Яростный Эмпат выходит на поле битвы, вы можете найти в вашей библиотеке карту существа с конвертированной мана-стоимостью 6 или больше, показать ее, положить ее в вашу руку, затем перетасовать вашу библиотеку.\', \'type\': \'Существо — Эльф\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487576&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fab6ac3b-763d-45c5-aec3-d7d34bca0c18\', \'multiverseId\': 487576}, \'multiverseid\': 487576}, {\'name\': \'好斗共感者\', \'text\': \'当好斗共感者进战场时，你可以从你的牌库中搜寻一张总法术力费用等于或大于6的生物牌，展示该牌，将它置于你手上，然后将你的牌库洗牌。\', \'type\': \'生物 ～妖精\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487835&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'df555814-2237-404b-a6b9-63bf419d6cd7\', \'multiverseId\': 487835}, \'multiverseid\': 487835}, {\'name\': \'好鬥共感者\', \'text\': \'當好鬥共感者進戰場時，你可以從你的牌庫中搜尋一張總魔法力費用等於或大於6的生物牌，展示該牌，將它置於你手上，然後將你的牌庫洗牌。\', \'type\': \'生物 ～妖精\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488094&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c2fbbc90-0a36-4368-80be-c69f63353f4d\', \'multiverseId\': 488094}, \'multiverseid\': 488094}]', '[{\'name\': \'Grimmiger Lehrmeister\', \'text\': \'Durchsuche deine Bibliothek nach einer Karte, nimm sie auf deine Hand und mische dann deine Bibliothek. Du verlierst 3 Lebenspunkte.\', \'type\': \'Hexerei\', \'flavor\': \'Als Blut auf die leere Seite tropfte, formte es Worte, die sich in den Geist des Zauberers einbrannten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485685&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c4ad87a4-1fc3-489c-a680-9af963471b9c\', \'multiverseId\': 485685}, \'multiverseid\': 485685}, {\'name\': \'Tutor nefasto\', \'text\': \'Busca en tu biblioteca una carta, pon esa carta en tu mano y luego baraja tu biblioteca. Pierdes 3 vidas.\', \'type\': \'Conjuro\', \'flavor\': \'A medida que la sangre tocaba la página en blanco, se fueron formando palabras que quedaron selladas en la mente del hechicero.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485944&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1229be2c-0789-4549-aea3-2af638ca7d06\', \'multiverseId\': 485944}, \'multiverseid\': 485944}, {\'name\': \'Précepteur sinistre\', \'text\': \'Cherchez une carte dans votre bibliothèque, mettez cette carte dans votre main, et mélangez ensuite votre bibliothèque. Vous perdez 3 points de vie.\', \'type\': \'Rituel\', \'flavor\': "Quand le sang toucha la page vierge, il forma des mots qui se gravèrent dans l\'esprit du sorcier.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486203&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'68a11d88-a8a4-4593-8fb6-c2ba8d0cba5a\', \'multiverseId\': 486203}, \'multiverseid\': 486203}, {\'name\': \'Tutore Macabro\', \'text\': \'Passa in rassegna il tuo grimorio per una carta, aggiungila alla tua mano, poi rimescola il tuo grimorio. Perdi 3 punti vita.\', \'type\': \'Stregoneria\', \'flavor\': "Nell\'istante in cui toccò la pagina vuota, il sangue formò delle parole che si incisero nella mente del mago.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486462&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f96ef41d-96eb-41dc-84cf-90780097974f\', \'multiverseId\': 486462}, \'multiverseid\': 486462}, {\'name\': \'不気味な教示者\', \'text\': \'あなたのライブラリーからカード１枚を探し、あなたの手札に加え、その後あなたのライブラリーを切り直す。あなたは３点のライフを失う。\', \'type\': \'ソーサリー\', \'flavor\': \'真っ白なページに触れた血が言葉を記し、魔術師の心に焼き付いていった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486721&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fc122169-ed1e-473e-a3d0-6271a5fab446\', \'multiverseId\': 486721}, \'multiverseid\': 486721}, {\'name\': \'음산한 가정교사\', \'text\': \'당신의 서고에서 카드 한 장을 찾아, 그 카드를 당신의 손으로 가져간 후 당신의 서고를 섞는다. 당신은 생명 3점을 잃는다.\', \'type\': \'집중마법\', \'flavor\': \'피가 빈 페이지에 닿자, 그것은 글귀를 이루어 마법사의 정신에 불타듯이 새겨졌다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486980&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7a567e06-b055-4b90-b4d9-8fc759571945\', \'multiverseId\': 486980}, \'multiverseid\': 486980}, {\'name\': \'Tutor Sinistro\', \'text\': \'Procure um card em seu grimório, coloque aquele card em sua mão e depois embaralhe seu grimório. Você perde 3 pontos de vida.\', \'type\': \'Feitiço\', \'flavor\': \'Conforme tocava a página vazia, o sangue escrevia palavras gravadas a fogo na mente do mago.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487239&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6c8d076f-be8a-4039-bfe9-0af3a079ec77\', \'multiverseId\': 487239}, \'multiverseid\': 487239}, {\'name\': \'Мрачный Наставник\', \'text\': \'Найдите в вашей библиотеке карту, положите ту карту в вашу руку, затем перетасуйте вашу библиотеку. Вы теряете 3 жизни.\', \'type\': \'Волшебство\', \'flavor\': \'Когда кровь пролилась на пустую страницу, она растеклась словами, навсегда въевшимися в разум волшебника.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487498&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'123020cc-43c3-486c-9589-a3d0d84f2e5d\', \'multiverseId\': 487498}, \'multiverseid\': 487498}, {\'name\': \'严酷导师\', \'text\': \'从你的牌库中搜寻一张牌，将该牌置于你手上，然后将你的牌库洗牌。你失去3点生命。\', \'type\': \'法术\', \'flavor\': \'鲜血落在空白书页上后，就转变成为烙印在法师心灵中的字句。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487757&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8872cf93-5e11-4b8d-b19c-5af26821f511\', \'multiverseId\': 487757}, \'multiverseid\': 487757}, {\'name\': \'嚴酷導師\', \'text\': \'從你的牌庫中搜尋一張牌，將該牌置於你手上，然後將你的牌庫洗牌。你失去3點生命。\', \'type\': \'巫術\', \'flavor\': \'鮮血落在空白書頁上後，就轉變成為烙印在法師心靈中的字句。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488016&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ec61b055-4ef2-4626-b179-05f4af395c21\', \'multiverseId\': 488016}, \'multiverseid\': 488016}]', '[{\'name\': \'Grimmiger Lehrmeister\', \'text\': \'Durchsuche deine Bibliothek nach einer Karte, nimm sie auf deine Hand und mische dann deine Bibliothek. Du verlierst 3 Lebenspunkte.\', \'type\': \'Hexerei\', \'flavor\': \'Als Blut auf die leere Seite tropfte, formte es Worte, die sich in den Geist des Zauberers einbrannten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488402&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2fdd03c1-a751-4a73-940b-f89f8d1899e0\', \'multiverseId\': 488402}, \'multiverseid\': 488402}, {\'name\': \'Tutor nefasto\', \'text\': \'Busca en tu biblioteca una carta, pon esa carta en tu mano y luego baraja tu biblioteca. Pierdes 3 vidas.\', \'type\': \'Conjuro\', \'flavor\': \'A medida que la sangre tocaba la página en blanco, se fueron formando palabras que quedaron selladas en la mente del hechicero.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488408&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fd0e623a-4958-483d-bd0b-82e69d9b5dd0\', \'multiverseId\': 488408}, \'multiverseid\': 488408}, {\'name\': \'Précepteur sinistre\', \'text\': \'Cherchez une carte dans votre bibliothèque, mettez cette carte dans votre main, et mélangez ensuite votre bibliothèque. Vous perdez 3 points de vie.\', \'type\': \'Rituel\', \'flavor\': "Quand le sang toucha la page vierge, il forma des mots qui se gravèrent dans l\'esprit du sorcier.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488414&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'de167c32-bae9-4e70-b383-695c27635d8b\', \'multiverseId\': 488414}, \'multiverseid\': 488414}, {\'name\': \'Tutore Macabro\', \'text\': \'Passa in rassegna il tuo grimorio per una carta, aggiungila alla tua mano, poi rimescola il tuo grimorio. Perdi 3 punti vita.\', \'type\': \'Stregoneria\', \'flavor\': "Nell\'istante in cui toccò la pagina vuota, il sangue formò delle parole che si incisero nella mente del mago.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488420&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'09062d24-d445-45b1-8b74-ec7a01d0c11a\', \'multiverseId\': 488420}, \'multiverseid\': 488420}, {\'name\': \'不気味な教示者\', \'text\': \'あなたのライブラリーからカード１枚を探し、あなたの手札に加え、その後あなたのライブラリーを切り直す。あなたは３点のライフを失う。\', \'type\': \'ソーサリー\', \'flavor\': \'真っ白なページに触れた血が言葉を記し、魔術師の心に焼き付いていった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488426&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'153e3c9e-4862-47ef-8a8e-45846add8306\', \'multiverseId\': 488426}, \'multiverseid\': 488426}, {\'name\': \'음울한 가정교사\', \'text\': \'당신의 서고에서 카드 한 장을 찾아, 그 카드를 당신의 손으로 가져간 후 당신의 서고를 섞는다. 당신은 생명 3점을 잃는다.\', \'type\': \'집중마법\', \'flavor\': \'피가 빈 페이지에 닿자, 그것은 글귀를 이루어 마법사의 정신에 불타듯이 새겨졌다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488432&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'fdcbab84-cbb1-40bf-b453-0df5af7318e2\', \'multiverseId\': 488432}, \'multiverseid\': 488432}, {\'name\': \'Tutor Sinistro\', \'text\': \'Procure um card em seu grimório, coloque aquele card em sua mão e depois embaralhe seu grimório. Você perde 3 pontos de vida.\', \'type\': \'Feitiço\', \'flavor\': \'Conforme tocava a página vazia, o sangue escrevia palavras gravadas a fogo na mente do mago.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488438&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2c1ba24b-daa9-4b1b-b541-ae8b2cc0e65f\', \'multiverseId\': 488438}, \'multiverseid\': 488438}, {\'name\': \'Мрачный Наставник\', \'text\': \'Найдите в вашей библиотеке карту, положите ту карту в вашу руку, затем перетасуйте вашу библиотеку. Вы теряете 3 жизни.\', \'type\': \'Волшебство\', \'flavor\': \'Когда кровь пролилась на пустую страницу, она растеклась словами, навсегда въевшимися в разум волшебника.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488444&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d2dc46f7-7fc9-4dac-9e3c-cb138f453c01\', \'multiverseId\': 488444}, \'multiverseid\': 488444}, {\'name\': \'严酷导师\', \'text\': \'从你的牌库中搜寻一张牌，将该牌置于你手上，然后将你的牌库洗牌。你失去3点生命。\', \'type\': \'法术\', \'flavor\': \'鲜血落在空白书页上后，就转变成为烙印在法师心灵中的字句。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488450&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bb170e88-f09f-44e7-9068-9b808fedfe2d\', \'multiverseId\': 488450}, \'multiverseid\': 488450}, {\'name\': \'嚴酷導師\', \'text\': \'從你的牌庫中搜尋一張牌，將該牌置於你手上，然後將你的牌庫洗牌。你失去3點生命。\', \'type\': \'巫術\', \'flavor\': \'鮮血落在空白書頁上後，就轉變成為烙印在法師心靈中的字句。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488456&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fc698206-76c5-4445-9c54-5efeea57e3bb\', \'multiverseId\': 488456}, \'multiverseid\': 488456}]', "[{'name': 'Halo serti de runes', 'text': 'Au moment où le Halo serti de runes arrive sur le champ de bataille, choisissez un nom de carte.\\nVous avez la protection contre le nom de carte choisi.', 'type': 'Enchantement', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488297&type=card', 'language': 'French', 'identifiers': {'scryfallId': '540c2394-569e-4ff1-acc0-79225b2b7e23', 'multiverseId': 488297}, 'multiverseid': 488297}, {'name': 'ルーンの光輪', 'text': 'ルーンの光輪が戦場に出るに際し、カード名１つを選ぶ。\\nあなたはプロテクション（その選ばれたカード名）を持つ。', 'type': 'エンチャント', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488349&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '86385ef9-18f0-407a-a057-f2a315203d45', 'multiverseId': 488349}, 'multiverseid': 488349}]", '[{\'name\': \'Hastige Bestandsaufnahme\', \'text\': \'Ziehe eine Karte und ziehe dann Karten in Höhe der Anzahl an Karten namens Hastige Bestandsaufnahme in deinem Friedhof.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ein anderes Dorf, ein anderer wütender Mob. Warum packe ich überhaupt noch aus?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485632&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5342e345-a30e-401a-8921-4adb4f86fb6d\', \'multiverseId\': 485632}, \'multiverseid\': 485632}, {\'name\': \'Inventario frenético\', \'text\': \'Roba una carta, luego roba una cantidad de cartas igual a la cantidad de cartas llamadas Inventario frenético en tu cementerio.\', \'type\': \'Instantáneo\', \'flavor\': \'"Otro pueblo, otra multitud enfurecida. ¿Para qué me molesto en desempaquetar nada?".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485891&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d76ab225-f9b5-44af-8d26-13101d451a90\', \'multiverseId\': 485891}, \'multiverseid\': 485891}, {\'name\': \'Inventaire effréné\', \'text\': \'Piochez une carte, puis piochez un nombre de cartes égal au nombre de cartes appelées Inventaire effréné dans votre cimetière.\', \'type\': \'Éphémère\', \'flavor\': \'« Un village de plus, avec sa foule en colère. Je me demande pourquoi je déballe mes affaires. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486150&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'04fa18c3-09cc-4c70-82a1-c0c6f0d69884\', \'multiverseId\': 486150}, \'multiverseid\': 486150}, {\'name\': \'Inventario Frenetico\', \'text\': \'Pesca una carta, poi pesca carte pari al numero di carte chiamate Inventario Frenetico nel tuo cimitero.\', \'type\': \'Istantaneo\', \'flavor\': \'"Un altro villaggio, un\\\'altra folla inferocita. Perché mi prendo ancora la briga di disfare le valigie?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486409&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'27f3340e-8a34-4761-87a5-d0f02e087789\', \'multiverseId\': 486409}, \'multiverseid\': 486409}, {\'name\': \'大慌ての棚卸し\', \'text\': \'カードを１枚引き、その後さらにカードを、あなたの墓地にある「大慌ての棚卸し」という名前のカードの枚数に等しい枚数引く。\', \'type\': \'インスタント\', \'flavor\': \'「別の村でも、また暴徒。荷ほどきするのがばかばかしくなるわね。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486668&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8cd83d34-f274-4e80-9023-904bb5f07c94\', \'multiverseId\': 486668}, \'multiverseid\': 486668}, {\'name\': \'정신없는 재고 정리\', \'text\': \'카드 한 장을 뽑은 후, 당신의 무덤에 있는 이름이 정신없는 재고 정리인 카드의 수만큼 카드를 뽑는다.\', \'type\': \'순간마법\', \'flavor\': \'"이 마을도 역시나, 또 성난 군중이로군. 짐은 뭐하러 풀어야 하는 거지?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486927&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b96717eb-61b2-4324-8cd2-9dc93607bba4\', \'multiverseId\': 486927}, \'multiverseid\': 486927}, {\'name\': \'Inventário Frenético\', \'text\': \'Compre um card e, em seguida, compre uma quantidade de cards igual ao número de cards com o nome Inventário Frenético em seu cemitério.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Outra vila, outra turba furiosa. Por que diabos eu me dou o trabalho de desfazer as malas?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487186&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6fabe790-77f9-436e-89be-c6fbd3caae46\', \'multiverseId\': 487186}, \'multiverseid\': 487186}, {\'name\': \'Лихорадочные Сборы\', \'text\': \'Возьмите карту, затем возьмите количество карт, равное числу карт с именем Лихорадочные Сборы на вашем кладбище.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Очередная деревня, очередная разъяренная толпа. И для чего я только распаковывалась?»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487445&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b8684eb7-d276-4cfc-92de-5c7fe53eeb21\', \'multiverseId\': 487445}, \'multiverseid\': 487445}, {\'name\': \'狂搜库存\', \'text\': \'抓一张牌，然后再抓若干牌，其数量等同于你坟墓场中名称为狂搜库存之牌的数量。\', \'type\': \'瞬间\', \'flavor\': \'「又一座村子，又一群暴民。我又何苦把东西拿出来呢？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487704&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'363fc933-722c-40f8-b0c7-b8c5ef86b055\', \'multiverseId\': 487704}, \'multiverseid\': 487704}, {\'name\': \'狂搜庫存\', \'text\': \'抽一張牌，然後再抽若干牌，其數量等同於你墳墓場中名稱為狂搜庫存之牌的數量。\', \'type\': \'瞬間\', \'flavor\': \'「又一座村子，又一群暴民。我又何苦把東西拿出來呢？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487963&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ef5d83af-3da1-41fc-a2d6-b36025094268\', \'multiverseId\': 487963}, \'multiverseid\': 487963}]', '[{\'name\': \'Hehre Offenbarung\', \'text\': \'Bestimme eines oder mehrere —\\n• Neutralisiere einen Zauberspruch deiner Wahl.\\n• Neutralisiere eine aktivierte oder ausgelöste Fähigkeit deiner Wahl.\\n• Bringe eine bleibende Karte deiner Wahl, die kein Land ist, auf die Hand ihres Besitzers zurück.\\n• Erzeuge einen Spielstein, der eine Kopie einer Kreatur deiner Wahl, die du kontrollierst, ist.\\n• Ein Spieler deiner Wahl zieht eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485656&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bc362576-cc12-4cd3-9277-fe12552f464a\', \'multiverseId\': 485656}, \'multiverseid\': 485656}, {\'name\': \'Epifanía sublime\', \'text\': \'Elige uno o más:\\n• Contrarresta el hechizo objetivo.\\n• Contrarresta la habilidad activada o disparada objetivo.\\n• Regresa el permanente objetivo que no sea tierra a la mano de su propietario.\\n• Crea una ficha que es una copia de la criatura objetivo que controlas.\\n• El jugador objetivo roba una carta.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485915&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ff52afc8-52c1-498f-ba82-7cd67061af14\', \'multiverseId\': 485915}, \'multiverseid\': 485915}, {\'name\': \'Révélation sublime\', \'text\': "Choisissez l\'un ou plus —\\n• Contrecarrez le sort ciblé.\\n• Contrecarrez la capacité activée ciblée ou la capacité déclenchée ciblée.\\n• Renvoyez un permanent non-terrain ciblé dans la main de son propriétaire.\\n• Créez un jeton qui est une copie d\'une créature ciblée que vous contrôlez.\\n• Le joueur ciblé pioche une carte.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486174&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'90965c2a-aa80-4928-93a2-d18784d8e3fa\', \'multiverseId\': 486174}, \'multiverseid\': 486174}, {\'name\': \'Rivelazione Sublime\', \'text\': "Scegli uno o più —\\n• Neutralizza una magia bersaglio.\\n• Neutralizza un\'abilità attivata o innescata bersaglio.\\n• Fai tornare un permanente non terra bersaglio in mano al suo proprietario.\\n• Crea una pedina che è una copia di una creatura bersaglio che controlli.\\n• Un giocatore bersaglio pesca una carta.", \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486433&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eaa2c158-4b07-46cd-9bbe-c18d4857787d\', \'multiverseId\': 486433}, \'multiverseid\': 486433}, {\'name\': \'崇高な天啓\', \'text\': \'以下から１つ以上を選ぶ。\\n• 呪文１つを対象とし、それを打ち消す。\\n• 起動型か誘発型である能力１つを対象とし、それを打ち消す。\\n• 土地でないパーマネント１つを対象とし、それをオーナーの手札に戻す。\\n• あなたがコントロールしているクリーチャー１体を対象とし、それのコピーであるトークンを１体生成する。\\n• プレイヤー１人を対象とする。そのプレイヤーはカードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486692&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'79c55b99-9406-4f52-b610-8d106d921ca3\', \'multiverseId\': 486692}, \'multiverseid\': 486692}, {\'name\': \'숭고한 깨달음\', \'text\': \'하나 이상을 선택한다 —\\n• 주문을 목표로 정한다. 그 주문을 무효화한다.\\n• 활성화능력 또는 격발능력을 목표로 정한다. 그 목표를 무효화한다.\\n• 대지가 아닌 지속물을 목표로 정한다. 그 지속물을 소유자의 손으로 되돌린다.\\n• 당신이 조종하는 생물을 목표로 정한다. 그 생물의 복사본인 토큰 한 개를 만든다.\\n• 플레이어를 목표로 정한다. 그 플레이어는 카드 한 장을 뽑는다.\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486951&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'203abdac-ff6b-4566-bdf0-8c22d6437d4d\', \'multiverseId\': 486951}, \'multiverseid\': 486951}, {\'name\': \'Epifania Sublime\', \'text\': \'Escolha um ou mais —\\n• Anule a mágica alvo.\\n• Anule a habilidade ativada ou desencadeada alvo.\\n• Devolva a permanente alvo que não seja um terreno para a mão de seu dono.\\n• Crie uma ficha que seja uma cópia da criatura alvo que você controla.\\n• O jogador alvo compra um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487210&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'42590b92-f9a0-448c-af57-e80724980861\', \'multiverseId\': 487210}, \'multiverseid\': 487210}, {\'name\': \'Высочайшее Прозрение\', \'text\': \'Выберите одно или несколько —\\n• Отмените целевое заклинание.\\n• Отмените целевую активируемую или срабатывающую способность.\\n• Верните целевой не являющийся землей перманент в руку его владельца.\\n• Создайте одну фишку, являющуюся копией целевого существа под вашим контролем.\\n• Целевой игрок берет карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487469&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'700c400f-2b4f-42e1-833f-c046ed3fa3dd\', \'multiverseId\': 487469}, \'multiverseid\': 487469}, {\'name\': \'灵光乍现\', \'text\': \'选择一项或多项～\\n•反击目标咒语。\\n•反击目标起动式或触发式异能。\\n•将目标非地永久物移回其拥有者手上。\\n•派出一个衍生物，此衍生物为目标由你操控的生物之复制品。\\n•目标牌手抓一张牌。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487728&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'083475f7-53df-440c-98c0-7dfd74f57172\', \'multiverseId\': 487728}, \'multiverseid\': 487728}, {\'name\': \'靈光乍現\', \'text\': \'選擇一項或多項～\\n•反擊目標咒語。\\n•反擊目標起動式或觸發式異能。\\n•將目標非地永久物移回其擁有者手上。\\n•派出一個衍生物，此衍生物為目標由你操控的生物之複製品。\\n•目標玩家抽一張牌。\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487987&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'feb44877-256c-475c-9150-1b39cb197001\', \'multiverseId\': 487987}, \'multiverseid\': 487987}]', '[{\'name\': \'Heiligtum der Vollkommenheit\', \'text\': \'Zu Beginn deines Versorgungssegments kannst du deine Bibliothek und/oder deinen Friedhof nach einer Schrein-Karte durchsuchen und sie ins Spiel bringen. Falls du auf diese Weise deine Bibliothek durchsuchst, mische sie danach.\\nFalls eine Fähigkeit eines anderen Schreins, den du kontrollierst, ausgelöst wird, während du sechs oder mehr Schreine kontrollierst, wird die Fähigkeit ein weiteres Mal ausgelöst.\', \'type\': \'Legendäre Verzauberung — Schrein\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485807&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4a112b5c-d0f1-447e-be87-d7a670d6e3d8\', \'multiverseId\': 485807}, \'multiverseid\': 485807}, {\'name\': \'Santuario de todos\', \'text\': \'Al comienzo de tu mantenimiento, puedes buscar en tu biblioteca y/o cementerio una carta de Altar y ponerla en el campo de batalla. Si buscas en tu biblioteca de esta manera, barájala.\\nSi una habilidad de otro Altar que controlas se dispara mientras controlas seis o más Altares, esa habilidad se dispara una vez más.\', \'type\': \'Encantamiento legendario — Altar\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486066&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5d433b80-7d51-469e-b147-2a3896b5d9aa\', \'multiverseId\': 486066}, \'multiverseid\': 486066}, {\'name\': \'Sanctuaire du Grand Tout\', \'text\': "Au début de votre entretien, vous pouvez chercher dans votre bibliothèque et/ou votre cimetière une carte de reliquaire et la mettre sur le champ de bataille. Si vous cherchez dans votre bibliothèque de cette manière, mélangez-la.\\nSi une capacité d\'un autre reliquaire que vous contrôlez se déclenche pendant que vous contrôlez au moins six reliquaires, cette capacité se déclenche une fois de plus.", \'type\': \'Enchantement légendaire : reliquaire\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486325&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a0128bbf-57c3-420c-929d-ff880679b54a\', \'multiverseId\': 486325}, \'multiverseid\': 486325}, {\'name\': \'Santuario del Tutto\', \'text\': "All\'inizio del tuo mantenimento, puoi passare in rassegna il tuo grimorio e/o il tuo cimitero per una carta Santuario e metterla sul campo di battaglia. Se passi in rassegna il tuo grimorio in questo modo, rimescolalo.\\nSe un\'abilità di un altro Santuario che controlli si innesca mentre controlli sei o più Santuari, quell\'abilità si innesca una volta in più.", \'type\': \'Incantesimo Leggendario — Santuario\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486584&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bf9c791f-eb47-4f96-b430-e0876daadf3f\', \'multiverseId\': 486584}, \'multiverseid\': 486584}, {\'name\': \'万物の聖域\', \'text\': \'あなたのアップキープの開始時に、あなたはあなたのライブラリーやあなたの墓地から祭殿・カード１枚を探し、戦場に出してもよい。これによりあなたがあなたのライブラリーからカードを探したなら、あなたのライブラリーを切り直す。\\nあなたが祭殿を６つ以上コントロールしている間に、他の、あなたがコントロールしている祭殿の能力が１つ誘発するなら、その能力は追加でもう１回誘発する。\', \'type\': \'伝説のエンチャント — 祭殿\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486843&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'63017509-c4d5-49eb-a4e4-2dc23d6596b2\', \'multiverseId\': 486843}, \'multiverseid\': 486843}, {\'name\': \'모든 것의 성소\', \'text\': \'당신의 유지단 시작에, 당신은 당신의 서고 및/또는 무덤에서 성지 카드 한 장을 찾아 전장에 놓을 수 있다. 당신이 이런 식으로 당신의 서고를 찾아보았다면, 당신의 서고를 섞는다.\\n당신이 성지를 여섯 개 이상 조종하는 동안 당신이 조종하는 다른 성지의 능력이 격발한다면, 그 능력은 한 번 더 격발한다.\', \'type\': \'전설적 부여마법 — 성지\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487102&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c2790ce3-2ea6-41bb-8d3e-e5f342d70785\', \'multiverseId\': 487102}, \'multiverseid\': 487102}, {\'name\': \'Santuário de Tudo\', \'text\': \'No início de sua manutenção, você pode procurar um card de Sacrário em seu grimório e/ou cemitério e colocá-lo no campo de batalha. Se procurar em seu grimório desta maneira, embaralhe-o.\\nSe uma habilidade de outro Sacrário que você controla for desencadeada enquanto você controlar seis ou mais Sacrários, aquela habilidade é desencadeada uma vez adicional.\', \'type\': \'Encantamento Lendário — Sacrário\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487361&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0ade475b-c746-49a8-aad7-795f0dd0c12a\', \'multiverseId\': 487361}, \'multiverseid\': 487361}, {\'name\': \'Святилище Сущего\', \'text\': \'В начале вашего шага поддержки вы можете найти в вашей библиотеке и/или на вашем кладбище карту Святыни и положить ее на поле битвы. Если вы ищете таким образом в вашей библиотеке, перетасуйте ее.\\nЕсли способность другой Святыни под вашим контролем срабатывает, пока вы контролируете не менее шести Святынь, то та способность срабатывает один дополнительный раз.\', \'type\': \'Легендарные Чары — Святыня\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487620&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'72e508a1-4a3a-4efa-80d1-007001beefb4\', \'multiverseId\': 487620}, \'multiverseid\': 487620}, {\'name\': \'万物圣殿\', \'text\': \'在你的维持开始时，你可以从你的牌库和／或坟墓场中搜寻一张祭祠牌，并将之放进战场。如果你以此法搜寻你的牌库，则将它洗牌。\\n如果另一个由你操控的祭祠之异能触发时你操控六个或更多祭祠，则该异能额外触发一次。\', \'type\': \'传奇结界 ～祭祠\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487879&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'77ba9b6f-ef3a-400b-8c66-f1489b9d04b0\', \'multiverseId\': 487879}, \'multiverseid\': 487879}, {\'name\': \'萬物聖殿\', \'text\': \'在你的維持開始時，你可以從你的牌庫和／或墳墓場中搜尋一張祭祠牌，並將之放進戰場。如果你以此法搜尋你的牌庫，則將它洗牌。\\n如果另一個由你操控的祭祠之異能觸發時你操控六個或更多祭祠，則該異能額外觸發一次。\', \'type\': \'傳奇結界 ～祭祠\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488138&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fafa14fa-b21c-404a-ad23-4b0e405d6c11\', \'multiverseId\': 488138}, \'multiverseid\': 488138}]', '[{\'name\': \'Heiligtum der reichen Ernte\', \'text\': \'Zu Beginn deiner Hauptphase vor dem Kampf erzeugst du X Mana genau einer beliebigen Farbe, wobei X gleich der Anzahl an Schreinen ist, die du kontrollierst.\', \'type\': \'Legendäre Verzauberung — Schrein\', \'flavor\': \'Unter hellen Blüten,\\ninmitten von üppigem Grün,\\nerblüht die Seele.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485785&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'31f989e8-a209-46a1-bc3e-1879d4871b4f\', \'multiverseId\': 485785}, \'multiverseid\': 485785}, {\'name\': \'Santuario de la cosecha provechosa\', \'text\': \'Al comienzo de tu fase principal precombate, agrega X manás de un color cualquiera, donde X es la cantidad de Altares que controlas.\', \'type\': \'Encantamiento legendario — Altar\', \'flavor\': \'Las flores vivas,\\nverdes en primavera,\\nflorecen almas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486044&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'17534c90-f4f4-43f6-950f-d16a200e2fcb\', \'multiverseId\': 486044}, \'multiverseid\': 486044}, {\'name\': \'Sanctuaire des récoltes abondantes\', \'text\': \'Au début de votre première phase principale, ajoutez X manas de la couleur de votre choix, X étant le nombre de reliquaires que vous contrôlez.\', \'type\': \'Enchantement légendaire : reliquaire\', \'flavor\': "Sous de belles fleurs\\nÉtincelantes au printemps,\\nL\'âme s\'épanouit.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486303&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'350c633a-25b1-48f0-9882-b1a30a4cc01b\', \'multiverseId\': 486303}, \'multiverseid\': 486303}, {\'name\': \'Santuario del Raccolto Fruttuoso\', \'text\': "All\'inizio della tua fase principale pre-combattimento, aggiungi X mana di un qualsiasi colore, dove X è il numero di Santuari che controlli.", \'type\': \'Incantesimo Leggendario — Santuario\', \'flavor\': "All\'ombra di vivaci alberi in fiore,\\navvolta dalla generosità della natura,\\nl\'anima sboccia in una soave melodia.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486562&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'03203532-e90f-4a87-8f9c-7cede2f8aca1\', \'multiverseId\': 486562}, \'multiverseid\': 486562}, {\'name\': \'豊かな実りの聖域\', \'text\': \'あなたの戦闘前メイン・フェイズの開始時に、好きな色１色のマナＸ点を加える。Ｘはあなたがコントロールしている祭殿の総数に等しい。\', \'type\': \'伝説のエンチャント — 祭殿\', \'flavor\': \'花の下\\n新緑唄う\\n御魂かな\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486821&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c8eba74c-77d1-4d19-b978-89e96b93dd1a\', \'multiverseId\': 486821}, \'multiverseid\': 486821}, {\'name\': \'풍성한 수확의 성소\', \'text\': \'당신의 전투전 본단계 시작에, 원하는 한 가지 색 마나 X개를 추가한다. X는 당신이 조종하는 성지의 수이다.\', \'type\': \'전설적 부여마법 — 성지\', \'flavor\': \'봄의 풍요로운 보상으로 가득한\\n밝은 꽃 아래에서,\\n영혼은 노래로 꽃을 피운다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487080&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c6bab8ba-90a3-4cd3-b096-0333bce7959f\', \'multiverseId\': 487080}, \'multiverseid\': 487080}, {\'name\': \'Santuário da Colheita Frutífera\', \'text\': \'No início de sua fase principal pré-combate, adicione X manas de uma cor à sua escolha, sendo X o número de Sacrários que você controla.\', \'type\': \'Encantamento Lendário — Sacrário\', \'flavor\': \'À sombra de lindas flores\\nViçosas na rica dádiva da primavera,\\nA alma desabrocha em música.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487339&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'882c4602-1624-4450-b3b2-e46c891d4d63\', \'multiverseId\': 487339}, \'multiverseid\': 487339}, {\'name\': \'Святилище Щедрого Урожая\', \'text\': \'В начале вашей предбоевой главной фазы добавьте X маны любого одного цвета, где X — количество Святынь под вашим контролем.\', \'type\': \'Легендарные Чары — Святыня\', \'flavor\': \'Яркие цветы,\\nЩедрый дар весны, душу\\nЗаставляют петь.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487598&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7dd17237-f315-4862-b82f-77d997b6f45d\', \'multiverseId\': 487598}, \'multiverseid\': 487598}, {\'name\': \'丰收圣殿\', \'text\': \'在你的战斗前的行动阶段开始时，加X点任意颜色的单色法术力，X为由你操控的祭祠数量。\', \'type\': \'传奇结界 ～祭祠\', \'flavor\': \'满园春色中，\\n百花竞艳生机浓，\\n魂灵齐声颂。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487857&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e75c66ea-4806-4e97-803d-973505e82f15\', \'multiverseId\': 487857}, \'multiverseid\': 487857}, {\'name\': \'豐收聖殿\', \'text\': \'在你的戰鬥前的行動階段開始時，加X點任意顏色的單色魔法力，X為由你操控的祭祠數量。\', \'type\': \'傳奇結界 ～祭祠\', \'flavor\': \'滿園春色中，\\n百花競艷生機濃，\\n魂靈齊聲頌。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488116&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8004bf68-8a92-44ac-99ad-540c3fa41a03\', \'multiverseId\': 488116}, \'multiverseid\': 488116}]', '[{\'name\': \'Heiligtum der ruhigen Gewässer\', \'text\': \'Zu Beginn deiner Hauptphase vor dem Kampf kannst du X Karten ziehen, wobei X gleich der Anzahl an Schreinen ist, die du kontrollierst. Falls du dies tust, wirf eine Karte ab.\', \'type\': \'Legendäre Verzauberung — Schrein\', \'flavor\': \'Die Wahrheit lauert in den Tiefen.\\nVom Ufer aus unsichtbar,\\nvon Wissen überflutet.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485650&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9f8753dc-bb43-46cb-a3bf-3974f3f46ba8\', \'multiverseId\': 485650}, \'multiverseid\': 485650}, {\'name\': \'Santuario de las aguas tranquilas\', \'text\': \'Al comienzo de tu fase principal precombate, puedes robar X cartas, donde X es la cantidad de Altares que controlas. Si lo haces, descarta una carta.\', \'type\': \'Encantamiento legendario — Altar\', \'flavor\': \'En el abismo\\nla verdad está oculta\\ny se desborda.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485909&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f44d7d2f-36b0-4853-9448-3825e39e4b8c\', \'multiverseId\': 485909}, \'multiverseid\': 485909}, {\'name\': \'Sanctuaire des eaux calmes\', \'text\': "Au début de votre première phase principale, vous pouvez piocher X cartes, X étant le nombre de reliquaires que vous contrôlez. Si vous faites ainsi, défaussez-vous d\'une carte.", \'type\': \'Enchantement légendaire : reliquaire\', \'flavor\': \'Le vrai est au fond,\\nInvisible de la rive.\\nBaigné de savoir.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486168&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1445194c-acc5-456c-af91-b15a13311c97\', \'multiverseId\': 486168}, \'multiverseid\': 486168}, {\'name\': \'Santuario delle Acque Calme\', \'text\': "All\'inizio della tua fase principale pre-combattimento, puoi pescare X carte, dove X è il numero di Santuari che controlli. Se lo fai, scarta una carta.", \'type\': \'Incantesimo Leggendario — Santuario\', \'flavor\': \'La verità giace in profondità,\\ninvisibile dalla riva.\\nLa conoscenza sommerge tutto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486427&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a4e36647-4887-44f8-ba45-b4b437de6537\', \'multiverseId\': 486427}, \'multiverseid\': 486427}, {\'name\': \'静かな水の聖域\', \'text\': \'あなたの戦闘前メイン・フェイズの開始時に、あなたはカードをＸ枚引いてもよい。Ｘはあなたがコントロールしている祭殿の総数に等しい。そうしたなら、カード１枚を捨てる。\', \'type\': \'伝説のエンチャント — 祭殿\', \'flavor\': \'真実の\\n沈む淵から\\n溢るる知\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486686&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fb14ad4d-083d-40a6-b896-b3749abced18\', \'multiverseId\': 486686}, \'multiverseid\': 486686}, {\'name\': \'잔잔한 물결의 성소\', \'text\': \'당신의 전투전 본단계 시작에, 당신은 카드 X장을 뽑을 수 있다. X는 당신이 조종하는 성지의 수이다. 그렇게 한다면, 카드 한 장을 버린다.\', \'type\': \'전설적 부여마법 — 성지\', \'flavor\': \'진실은 심해 속에 숨어다니며,\\n해안에서는 볼 수 없다.\\n지식은 물 속에 빠지게 한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486945&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c70d19ce-f1df-4acf-ab39-245791d997ef\', \'multiverseId\': 486945}, \'multiverseid\': 486945}, {\'name\': \'Santuário das Águas Calmas\', \'text\': \'No início de sua fase principal pré-combate, você pode comprar X cards, sendo X o número de Sacrários que você controla. Se fizer isso, descarte um card.\', \'type\': \'Encantamento Lendário — Sacrário\', \'flavor\': \'A verdade jaz nas profundezas,\\ninvisível da margem.\\nO conhecimento inunda.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487204&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'01665aa2-4961-4b75-a040-25a9592e03e4\', \'multiverseId\': 487204}, \'multiverseid\': 487204}, {\'name\': \'Святилище Тихой Воды\', \'text\': \'В начале вашей предбоевой главной фазы вы можете взять X карт, где X — количество Святынь под вашим контролем. Если вы это делаете, сбросьте карту.\', \'type\': \'Легендарные Чары — Святыня\', \'flavor\': \'Правду в глубине\\nНе увидеть с берега.\\nОмут познаний.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487463&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e8ec95cb-288a-4670-8417-5e0e93b1937b\', \'multiverseId\': 487463}, \'multiverseid\': 487463}, {\'name\': \'静水圣殿\', \'text\': \'在你战斗前的行动阶段开始时，你可以抓X张牌，X为由你操控的祭祠数量。若你如此作，则弃一张牌。\', \'type\': \'传奇结界 ～祭祠\', \'flavor\': \'真相藏水间，\\n冰寒湖底知识现，\\n岸边不得见。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487722&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'65b60ce0-105f-4bf9-ac05-6083caf1f946\', \'multiverseId\': 487722}, \'multiverseid\': 487722}, {\'name\': \'靜水聖殿\', \'text\': \'在你戰鬥前的行動階段開始時，你可以抽X張牌，X為由你操控的祭祠數量。若你如此作，則棄一張牌。\', \'type\': \'傳奇結界 ～祭祠\', \'flavor\': \'真相藏水間，\\n冰寒湖底知識現，\\n岸邊不得見。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487981&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'014d6cde-45bf-4417-ae57-a0cd8c9c9e77\', \'multiverseId\': 487981}, \'multiverseid\': 487981}]', '[{\'name\': \'Heiligtum der steinernen Zähne\', \'text\': \'Zu Beginn deiner Hauptphase vor dem Kampf verliert jeder Gegner X Lebenspunkte und du erhältst X Lebenspunkte dazu, wobei X gleich der Anzahl an Schreinen ist, die du kontrollierst.\', \'type\': \'Legendäre Verzauberung — Schrein\', \'flavor\': \'Schwöre allem ab,\\nwas dein Potenzial bindet.\\nMacht kennt keine Grenzen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485702&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'907b26e5-bc51-4027-8228-2cb1eee7d652\', \'multiverseId\': 485702}, \'multiverseid\': 485702}, {\'name\': \'Santuario de los colmillos de piedra\', \'text\': \'Al comienzo de tu fase principal precombate, cada oponente pierde X vidas y tú ganas X vidas, donde X es la cantidad de Altares que controlas.\', \'type\': \'Encantamiento legendario — Altar\', \'flavor\': \'Falsas cadenas\\napresan una fuerza\\nilimitada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485961&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0ebaf4e8-faaf-4c6a-af46-b6dc57aa23d9\', \'multiverseId\': 485961}, \'multiverseid\': 485961}, {\'name\': \'Sanctuaire des crocs de pierre\', \'text\': \'Au début de votre première phase principale, chaque adversaire perd X points de vie et vous gagnez X points de vie, X étant le nombre de reliquaires que vous contrôlez.\', \'type\': \'Enchantement légendaire : reliquaire\', \'flavor\': \'Renonce aux limites,\\nÀ ces chaînes illusoires.\\nForce sans limite.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486220&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1afd29cf-8ee6-4473-a906-f75a34f02e9c\', \'multiverseId\': 486220}, \'multiverseid\': 486220}, {\'name\': \'Santuario delle Zanne Rocciose\', \'text\': "All\'inizio della tua fase principale pre-combattimento, ogni avversario perde X punti vita e tu guadagni X punti vita, dove X è il numero di Santuari che controlli.", \'type\': \'Incantesimo Leggendario — Santuario\', \'flavor\': \'Rinuncia a tutti i limiti,\\nfalse catene che soffocano il potenziale.\\nLa forza non conosce vincoli.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486479&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bafba4da-e445-4dcd-acff-84e491e30326\', \'multiverseId\': 486479}, \'multiverseid\': 486479}, {\'name\': \'石の牙の聖域\', \'text\': \'あなたの戦闘前メイン・フェイズの開始時に、各対戦相手はそれぞれＸ点のライフを失い、あなたはＸ点のライフを得る。Ｘはあなたがコントロールしている祭殿の総数に等しい。\', \'type\': \'伝説のエンチャント — 祭殿\', \'flavor\': \'虚鎖\\n果てぬ力で\\n断ち捨てよ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486738&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9d948c7b-8814-4efa-9778-020f8ac0ec00\', \'multiverseId\': 486738}, \'multiverseid\': 486738}, {\'name\': \'돌 송곳니의 성소\', \'text\': \'당신의 전투전 본단계 시작에, 각 상대는 생명 X점을 잃고 당신은 생명 X점을 얻는다. X는 당신이 조종하는 성지의 수이다.\', \'type\': \'전설적 부여마법 — 성지\', \'flavor\': \'모든 한계를 벗어던져라,\\n가능성을 옭죄는 거짓된 사슬들을.\\n힘은 한계를 모른다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486997&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f235b155-7b66-4f73-bc71-7edfb95c54e4\', \'multiverseId\': 486997}, \'multiverseid\': 486997}, {\'name\': \'Santuário das Presas de Pedra\', \'text\': \'No início de sua fase principal pré-combate, cada oponente perde X pontos de vida e você ganha X pontos de vida, sendo X o número de Sacrários que você controla.\', \'type\': \'Encantamento Lendário — Sacrário\', \'flavor\': \'Renuncie a toda restrição.\\nFalsas correntes represam o potencial.\\nO poder desconhece limites.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487256&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'68e610b2-f507-40ff-bd52-b9c0009b69c8\', \'multiverseId\': 487256}, \'multiverseid\': 487256}, {\'name\': \'Святилище Каменных Клыков\', \'text\': \'В начале вашей предбоевой главной фазы каждый оппонент теряет X жизней, а вы получаете X жизней, где X — количество Святынь под вашим контролем.\', \'type\': \'Легендарные Чары — Святыня\', \'flavor\': \'Отринь все пределы,\\nИллюзорные оковы могущества.\\nНет границ силы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487515&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e72e8911-3e15-477b-8226-dce25984841d\', \'multiverseId\': 487515}, \'multiverseid\': 487515}, {\'name\': \'锐石圣殿\', \'text\': \'在你战斗前的行动阶段开始时，每位对手各失去X点生命，且你获得X点生命，X为由你操控的祭祠数量。\', \'type\': \'传奇结界 ～祭祠\', \'flavor\': \'锐锋破局限，\\n挣脱枷锁潜能现，\\n强威力无边。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487774&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b2738e77-4a8a-49ea-b3a1-4cf2deefd474\', \'multiverseId\': 487774}, \'multiverseid\': 487774}, {\'name\': \'銳石聖殿\', \'text\': \'在你戰鬥前的行動階段開始時，每位對手各失去X點生命，且你獲得X點生命，X為由你操控的祭祠數量。\', \'type\': \'傳奇結界 ～祭祠\', \'flavor\': \'銳鋒破局限，\\n掙脫枷鎖潛能現，\\n強威力無邊。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488033&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fa7d3e2a-5bae-4fe6-8695-b6ed8243870a\', \'multiverseId\': 488033}, \'multiverseid\': 488033}]', '[{\'name\': \'Heiligtum der zerschellten Höhen\', \'text\': \'{1}, wirf eine Länder- oder Schrein-Karte ab: Das Heiligtum der zerschellten Höhen fügt einer Kreatur oder einem Planeswalker deiner Wahl X Schadenspunkte zu, wobei X gleich der Anzahl an Schreinen ist, die du kontrollierst.\', \'type\': \'Legendäre Verzauberung — Schrein\', \'flavor\': \'Zorn schwelt im Innern,\\nein allverschlingender Brand,\\naus Furcht wird Asche.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485739&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'71429112-68c7-40c6-bd8d-77973548ad6c\', \'multiverseId\': 485739}, \'multiverseid\': 485739}, {\'name\': \'Santuario de la cima destrozada\', \'text\': \'{1}, descartar una carta de tierra o de Altar: El Santuario de la cima destrozada hace X puntos de daño a la criatura o planeswalker objetivo, donde X es la cantidad de Altares que controlas.\', \'type\': \'Encantamiento legendario — Altar\', \'flavor\': \'Cólera ardiente\\nque todo lo consume:\\nquema temores.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485998&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'73ec59a7-5887-496d-9cb1-f597992752d6\', \'multiverseId\': 485998}, \'multiverseid\': 485998}, {\'name\': \'Sanctuaire des hauteurs fracassées\', \'text\': "{1}, défaussez vous d\'une carte de terrain ou de reliquaire : Le Sanctuaire des hauteurs fracassées inflige X blessures à une cible, créature ou planeswalker, X étant le nombre de reliquaires que vous contrôlez.", \'type\': \'Enchantement légendaire : reliquaire\', \'flavor\': "La rage s\'embrase,\\nComme un incendie sauvage\\nConsumant la peur.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486257&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'eddcd1ad-2d60-4299-9193-95c7b3d67202\', \'multiverseId\': 486257}, \'multiverseid\': 486257}, {\'name\': \'Santuario delle Vette Spezzate\', \'text\': \'{1}, Scarta una carta terra o una carta Santuario: Il Santuario delle Vette Spezzate infligge X danni a una creatura o a un planeswalker bersaglio, dove X è il numero di Santuari che controlli.\', \'type\': \'Incantesimo Leggendario — Santuario\', \'flavor\': \'La furia brucia in profondità,\\nun incendio che divora tutto\\ne riduce la paura in cenere.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486516&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'84e53821-d87e-4380-92e6-878bc428649f\', \'multiverseId\': 486516}, \'multiverseid\': 486516}, {\'name\': \'廃れた高地の聖域\', \'text\': \'{1}, 土地・カード１枚か祭殿・カード１枚を捨てる：クリーチャー１体かプレインズウォーカー１体を対象とする。廃れた高地の聖域はそれにＸ点のダメージを与える。Ｘはあなたがコントロールしている祭殿の総数に等しい。\', \'type\': \'伝説のエンチャント — 祭殿\', \'flavor\': \'内に秘む\\n怒り 恐れを\\n灰と化し\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486775&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'27d3d644-f6f7-462b-aa4c-cb205d0c2b8d\', \'multiverseId\': 486775}, \'multiverseid\': 486775}, {\'name\': \'산산조각난 고도의 성소\', \'text\': \'{1}, 대지 카드 또는 성지 카드 한 장을 버린다: 생물 또는 플레인즈워커를 목표로 정한다. 산산조각난 고도의 성소는 그 목표에게 피해 X점을 입힌다. X는 당신이 조종하는 성지의 수이다.\', \'type\': \'전설적 부여마법 — 성지\', \'flavor\': \'분노는 공포를 잿더미로 만들며\\n모든 것을 삼키는\\n들불 안에서 피어오른다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487034&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'fcfd684c-ecb5-49ab-8db8-4fe0a5df5734\', \'multiverseId\': 487034}, \'multiverseid\': 487034}, {\'name\': \'Santuário dos Picos Despedaçados\', \'text\': \'{1}, descarte um card de terreno ou de Sacrário: Santuário dos Picos Despedaçados causa X pontos de dano à criatura ou ao planeswalker alvo, sendo X o número de Sacrários que você controla.\', \'type\': \'Encantamento Lendário — Sacrário\', \'flavor\': \'A fúria arde por dentro,\\nUm incêndio que a tudo consome\\nTransformando o medo em cinzas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487293&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3a2bec6f-66e4-4e00-8abe-544b230989dd\', \'multiverseId\': 487293}, \'multiverseid\': 487293}, {\'name\': \'Святилище Расколотых Пиков\', \'text\': "{1}, сбросьте карту земли или карту Святыни: Святилище Расколотых Пиков наносит X повреждений целевому существу или planeswalker\'у, где X — количество Святынь под вашим контролем.", \'type\': \'Легендарные Чары — Святыня\', \'flavor\': \'Гнев бурлит внутри,\\nИспепеляющий жар\\nВыжигает страх.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487552&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f20932e8-1e4b-4e9b-bda4-a99ca93fe82b\', \'multiverseId\': 487552}, \'multiverseid\': 487552}, {\'name\': \'嶙峋圣殿\', \'text\': \'{1}，弃一张地牌或祭祠牌：嶙峋圣殿对目标生物或鹏洛客造成X点伤害，X为由你操控的祭祠数量。\', \'type\': \'传奇结界 ～祭祠\', \'flavor\': \'恚怒积心间，\\n聚作野火耀漫天，\\n惧相全化烟。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487811&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4b056de3-7a01-49f0-bff3-4f12d09f2996\', \'multiverseId\': 487811}, \'multiverseid\': 487811}, {\'name\': \'嶙峋聖殿\', \'text\': \'{1}，棄一張地牌或祭祠牌：嶙峋聖殿對目標生物或鵬洛客造成X點傷害，X為由你操控的祭祠數量。\', \'type\': \'傳奇結界 ～祭祠\', \'flavor\': \'恚怒積心間，\\n聚作野火耀漫天，\\n懼相全化煙。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488070&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'73fd57a7-9689-47e6-bcae-cf165be7dcf4\', \'multiverseId\': 488070}, \'multiverseid\': 488070}]', "[{'name': 'Heiligtum des stillen Lichts', 'text': '{5}{W}: Tappe eine Kreatur deiner Wahl. Diese Fähigkeit kostet beim Aktivieren für jeden Schrein, den du kontrollierst, {1} weniger.', 'type': 'Legendäre Verzauberung — Schrein', 'flavor': 'Eine unbekümmerte Seele\\nlebt in perfekter Harmonie\\nmit einem friedvollen Herzen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485615&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a44061c1-39af-4011-a6aa-6d1ae3f3f88c', 'multiverseId': 485615}, 'multiverseid': 485615}, {'name': 'Santuario de la luz tranquila', 'text': '{5}{W}: Gira la criatura objetivo. Te cuesta {1} menos activar esta habilidad por cada Altar que controlas.', 'type': 'Encantamiento legendario — Altar', 'flavor': 'Mente tranquila\\nen perfecta armonía;\\ncorazón calmo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485874&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '83ec6670-ce37-4a18-b2b4-2d6e32927796', 'multiverseId': 485874}, 'multiverseid': 485874}, {'name': 'Sanctuaire de la lumière paisible', 'text': '{5}{W} : Engagez la créature ciblée. Cette capacité coûte {1} de moins à activer pour chaque reliquaire que vous contrôlez.', 'type': 'Enchantement légendaire : reliquaire', 'flavor': 'Un esprit serein\\nVit en parfaite harmonie\\nAvec un cœur pur.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486133&type=card', 'language': 'French', 'identifiers': {'scryfallId': '08e36450-a180-4264-bb4c-5791270a093a', 'multiverseId': 486133}, 'multiverseid': 486133}, {'name': 'Santuario della Luce Tranquilla', 'text': '{5}{W}: TAPpa una creatura bersaglio. Questa abilità costa {1} in meno per essere attivata per ogni Santuario che controlli.', 'type': 'Incantesimo Leggendario — Santuario', 'flavor': 'Una mente imperturbabile\\nvive in perfetta armonia\\ncon un cuore sereno.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486392&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'efb1029c-f11c-4dc5-9f43-3a79f6bcdf44', 'multiverseId': 486392}, 'multiverseid': 486392}, {'name': '穏やかな光の聖域', 'text': '{5}{W}：クリーチャー１体を対象とし、それをタップする。この能力を起動するためのコストは、あなたがコントロールしている祭殿１つにつき{1}少なくなる。', 'type': '伝説のエンチャント — 祭殿', 'flavor': '曇りなき\\n静けき心\\n調和せむ', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486651&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '383ca326-7eb2-48a9-9efe-293228fbf106', 'multiverseId': 486651}, 'multiverseid': 486651}, {'name': '평온한 빛의 성소', 'text': '{5}{W}: 생물을 목표로 정한다. 그 생물을 탭한다. 이 능력은 당신이 조종하는 성지 한 개당 활성화하는 데 {1}이 덜 든다.', 'type': '전설적 부여마법 — 성지', 'flavor': '고요한 정신은\\n완벽한 조화 속에서\\n평화로운 마음과 함께 자리한다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486910&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '3e1afffd-47c4-4b2a-bd93-fb0ba89fc5fe', 'multiverseId': 486910}, 'multiverseid': 486910}, {'name': 'Santuário da Luz Tranquila', 'text': '{5}{W}: Vire a criatura alvo. Esta habilidade custa {1} a menos para ser ativada para cada Sacrário que você controla.', 'type': 'Encantamento Lendário — Sacrário', 'flavor': 'Uma mente plácida\\nVive em perfeita harmonia\\nCom um coração pacífico.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487169&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c6a3bcd8-b733-49d0-80b2-36978b08d3f5', 'multiverseId': 487169}, 'multiverseid': 487169}, {'name': 'Святилище Спокойного Света', 'text': '{5}{W}: поверните целевое существо. Стоимость активации этой способности уменьшается на {1} за каждую Святыню под вашим контролем.', 'type': 'Легендарные Чары — Святыня', 'flavor': 'Безмятежный ум\\nВ соразмерности живет\\nС покоем в сердце.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487428&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'ae647f14-85c4-4c63-9fce-1930d942cf9b', 'multiverseId': 487428}, 'multiverseid': 487428}, {'name': '宁光圣殿', 'text': '{5}{W}：横置目标生物。你每操控一个祭祠，此异能便减少{1}来起动。', 'type': '传奇结界 ～祭祠', 'flavor': '平和无庸扰，\\n柔光温煦清风到，\\n静居宁心躁。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487687&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'bda0bce5-9d84-430f-ba98-937ab9e953d2', 'multiverseId': 487687}, 'multiverseid': 487687}, {'name': '寧光聖殿', 'text': '{5}{W}：橫置目標生物。你每操控一個祭祠，此異能便減少{1}來起動。', 'type': '傳奇結界 ～祭祠', 'flavor': '平和無庸擾，\\n柔光溫煦清風到，\\n靜居寧心躁。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487946&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '6b9c254b-f568-43aa-881f-f4b28ffb6f8d', 'multiverseId': 487946}, 'multiverseid': 487946}]", '[{\'name\': \'Heroische Intervention\', \'text\': \'Bleibende Karten, die du kontrollierst, erhalten Fluchsicherheit und Unzerstörbarkeit bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Wo immer ein Stärkerer einem Schwächeren etwas zuleide tun will — ich werde dort sein."\\n—Ajani Goldmähne\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485770&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dc4169c8-4789-416e-804c-d5646487ad09\', \'multiverseId\': 485770}, \'multiverseid\': 485770}, {\'name\': \'Intervención heroica\', \'text\': \'Los permanentes que controlas ganan las habilidades de antimaleficio e indestructible hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"Siempre que los fuertes intenten dañar a los débiles, se toparán conmigo".\\n—Ajani Melena Dorada\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486029&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'74010236-f95c-4e58-84aa-a0fc1217ecdc\', \'multiverseId\': 486029}, \'multiverseid\': 486029}, {\'name\': \'Intervention héroïque\', \'text\': "Les permanents que vous contrôlez acquièrent la défense talismanique et l\'indestructible jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': \'« Je me rendrai partout où les forts oppriment les faibles. »\\n—Ajani Crinièredor\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486288&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2e71de04-f1c5-4065-989f-cb6837b261f2\', \'multiverseId\': 486288}, \'multiverseid\': 486288}, {\'name\': \'Intervento Eroico\', \'text\': \'I permanenti che controlli hanno anti-malocchio e indistruttibile fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Ovunque i forti opprimano i deboli, io ci sarò."\\n—Ajani Criniera D\\\'Oro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486547&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'47edc34d-4774-4845-a035-bebd97e17fec\', \'multiverseId\': 486547}, \'multiverseid\': 486547}, {\'name\': \'英雄的介入\', \'text\': \'ターン終了時まで、あなたがコントロールしているパーマネントは呪禁と破壊不能を得る。\', \'type\': \'インスタント\', \'flavor\': \'「強者が弱者を蹂躙しようとするとき、そこに私がいるだろう。」\\n――黄金のたてがみのアジャニ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486806&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bd8f6126-8c33-443d-b696-0ffc95286167\', \'multiverseId\': 486806}, \'multiverseid\': 486806}, {\'name\': \'영웅적 개입\', \'text\': \'당신이 조종하는 지속물들은 턴종료까지 방호와 무적을 얻는다.\', \'type\': \'순간마법\', \'flavor\': \'"강자가 약자를 괴롭히는 곳이라면 어디든 달려가겠다."\\n—아자니 골드메인\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487065&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'38b4b450-b41f-4ad2-a143-68eaaca0c8f4\', \'multiverseId\': 487065}, \'multiverseid\': 487065}, {\'name\': \'Intervenção Heroica\', \'text\': \'As permanentes que você controla ganham resistência a magia e indestrutível até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Toda vez que os fortes tentarem ferir os fracos, eu estarei lá."\\n— Ajani Juba D\\\'ouro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487324&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ffcfa8ff-8cf7-4e14-a79a-47032ed65c2f\', \'multiverseId\': 487324}, \'multiverseid\': 487324}, {\'name\': \'Героическое Вмешательство\', \'text\': \'Перманенты под вашим контролем получают Порчеустойчивость и Неразрушимость до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Я всегда буду там, где сильный угнетает слабого».\\n— Златогривый Аджани\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487583&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'446ee6d6-2fdd-4591-a237-ec70e4759112\', \'multiverseId\': 487583}, \'multiverseid\': 487583}, {\'name\': \'英勇干预\', \'text\': \'由你操控的永久物获得辟邪与不灭异能直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'「任何有倚强凌弱的地方，我必现身。」\\n～金鬃阿耶尼\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487842&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'baa1cfc6-1770-4157-a217-6a3a9c44ea69\', \'multiverseId\': 487842}, \'multiverseid\': 487842}, {\'name\': \'英勇干預\', \'text\': \'由你操控的永久物獲得辟邪與不滅異能直到回合結束。\', \'type\': \'瞬間\', \'flavor\': \'「任何有倚強凌弱的地方，我必現身。」\\n～金鬃阿耶尼\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488101&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8c7c949a-a4fb-4beb-ae68-b55ba4789a68\', \'multiverseId\': 488101}, \'multiverseid\': 488101}]', '[{\'name\': \'Herzfeuer-Brandopferer\', \'text\': \'Bravour (Immer wenn du einen Nichtkreatur-Zauberspruch wirkst, erhält diese Kreatur +1/+1 bis zum Ende des Zuges.)\\n{R}, opfere den Herzfeuer-Brandopferer: Er fügt einer Kreatur oder einem Planeswalker deiner Wahl Schadenspunkte in Höhe seiner Stärke zu.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'„Ich ende lieber in einer glorreichen Explosion, als einfach in Vergessenheit zu geraten."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485732&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3ffd6f6c-fc07-4a26-b9f8-912b4cc7645e\', \'multiverseId\': 485732}, \'multiverseid\': 485732}, {\'name\': \'Inmolador de la llama del corazón\', \'text\': \'Destreza. (Siempre que lances un hechizo que no sea de criatura, esta criatura obtiene +1/+1 hasta el final del turno.)\\n{R}, sacrificar el Inmolador de la llama del corazón: Hace una cantidad de daño igual a su fuerza a la criatura o planeswalker objetivo.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'"Prefiero extinguirme junto con las llamas a desaparecer y que me olviden".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485991&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b111aa94-e712-4fb9-a65f-b073a566d435\', \'multiverseId\': 485991}, \'multiverseid\': 485991}, {\'name\': \'Immolateur pyrocœur\', \'text\': "Prouesse (À chaque fois que vous lancez un sort non-créature, cette créature gagne +1/+1 jusqu\'à la fin du tour.)\\n{R}, sacrifiez l\'Immolateur pyrocœur : il inflige un nombre de blessures égal à sa force à une cible, créature ou planeswalker.", \'type\': \'Créature : humain et sorcier\', \'flavor\': "« Je préfère mourir dans la gloire que d\'être oublié. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486250&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7f2508ee-f407-4ee3-b9fc-06c1b64886ff\', \'multiverseId\': 486250}, \'multiverseid\': 486250}, {\'name\': \'Immolatore di Fuoco del Cuore\', \'text\': "Prodezza (Ogniqualvolta lanci una magia non creatura, questa creatura prende +1/+1 fino alla fine del turno.)\\n{R}, Sacrifica l\'Immolatore di Fuoco del Cuore: Infligge danno pari alla sua forza a una creatura o a un planeswalker bersaglio.", \'type\': \'Creatura — Mago Umano\', \'flavor\': \'"Preferirei spegnermi in una vampata di gloria, piuttosto che scomparire poco alla volta e cadere nell\\\'oblio."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486509&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'677685a2-f016-4aa4-a69d-2aa40132234b\', \'multiverseId\': 486509}, \'multiverseid\': 486509}, {\'name\': \'心火の供犠者\', \'text\': \'果敢（あなたがクリーチャーでない呪文を唱えるたび、ターン終了時まで、このクリーチャーは＋１/＋１の修整を受ける。）\\n{R}, 心火の供犠者を生け贄に捧げる：クリーチャー１体かプレインズウォーカー１体を対象とする。これはそれに自身のパワーに等しい点数のダメージを与える。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'「栄光の内に猛火で死ぬ方が、逃げて忘れ去られるよりもずっといい。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486768&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2f10a4ed-7ec4-43bb-962d-ea3834833f4e\', \'multiverseId\': 486768}, \'multiverseid\': 486768}, {\'name\': \'심장불길 번제사\', \'text\': \'기량 (당신이 생물이 아닌 주문을 발동할 때마다, 이 생물은 턴종료까지 +1/+1을 받는다.)\\n{R}, 심장불길 번제사를 희생한다: 생물 또는 플레인즈워커를 목표로 정한다. 심장불길 번제사는 그 목표에게 자신의 공격력만큼 피해를 입힌다.\', \'type\': \'생물 — 인간 마법사\', \'flavor\': \'"스러져 잊히느니 차라리 영광의 불길을 걸어가겠다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487027&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'aa3143b5-225f-4fa3-a8df-90b4ff19ca23\', \'multiverseId\': 487027}, \'multiverseid\': 487027}, {\'name\': \'Imolador do Fogo Interior\', \'text\': \'Destreza (Toda vez que você conjura uma mágica que não seja de criatura, esta criatura recebe +1/+1 até o final do turno.)\\n{R}, sacrifique Imolador do Fogo Interior: Ele causa dano igual ao próprio poder à criatura ou ao planeswalker alvo.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'"Prefiro morrer envolto em chamas gloriosas a desaparecer lentamente e ser esquecido."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487286&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7a49381a-6a66-47ab-9d26-b7c45f8d3764\', \'multiverseId\': 487286}, \'multiverseid\': 487286}, {\'name\': \'Возжигатель Огня Сердца\', \'text\': "Искусность (Каждый раз, когда вы разыгрываете не являющееся существом заклинание, это существо получает +1/+1 до конца хода.)\\n{R}, пожертвуйте Возжигателя Огня Сердца: он наносит повреждения, равные своей силе, целевому существу или planeswalker\'у.", \'type\': \'Существо — Человек Чародей\', \'flavor\': \'«Лучше я уйду в огненной вспышке славы, чем угасну, всеми забытый».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487545&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a388fd14-9e77-42b5-b32a-9f37e4a17e84\', \'multiverseId\': 487545}, \'multiverseid\': 487545}, {\'name\': \'心火煽焰师\', \'text\': \'灵技（每当你施放非生物咒语时，此生物得+1/+1直到回合结束。）\\n{R}，牺牲心火煽焰师：它对目标生物或鹏洛客造成伤害，其数量等同于前者的力量。\', \'type\': \'生物 ～人类／法术师\', \'flavor\': \'「我宁愿化作夺目烈焰，也不甘漫灭遭人淡忘。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487804&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9078c089-1b34-4a61-aa4c-bf04aacb8cc2\', \'multiverseId\': 487804}, \'multiverseid\': 487804}, {\'name\': \'心火煽焰師\', \'text\': \'靈技（每當你施放非生物咒語時，此生物得+1/+1直到回合結束。）\\n{R}，犧牲心火煽焰師：它對目標生物或鵬洛客造成傷害，其數量等同於前者的力量。\', \'type\': \'生物 ～人類／魔法師\', \'flavor\': \'「我寧願化作奪目烈焰，也不甘漫滅遭人淡忘。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488063&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e4be9144-b396-4472-9ada-b9e64d92fb2f\', \'multiverseId\': 488063}, \'multiverseid\': 488063}]', '[{\'name\': \'Hexenkessel\', \'text\': \'{1}{B}, {T}, opfere eine Kreatur: Du erhältst 1 Lebenspunkt dazu und ziehst eine Karte.\', \'type\': \'Artefakt\', \'flavor\': \'Die besten Rezepte erfordern verlässliches Kochgeschirr.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485711&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'371f1c50-baea-45fe-9239-d2c3b401b316\', \'multiverseId\': 485711}, \'multiverseid\': 485711}, {\'name\': \'Caldero de la bruja\', \'text\': \'{1}{B}, {T}, sacrificar una criatura: Ganas 1 vida y robas una carta.\', \'type\': \'Artefacto\', \'flavor\': \'Las mejores recetas se empiezan con buenos utensilios de cocina.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485970&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9dc43c56-1267-42a0-ba3e-afe3c442ce83\', \'multiverseId\': 485970}, \'multiverseid\': 485970}, {\'name\': "Chaudron d\'envoûteuse", \'text\': \'{1}{B}, {T}, sacrifiez une créature : Vous gagnez 1 point de vie et vous piochez une carte.\', \'type\': \'Artefact\', \'flavor\': \'Les meilleures recettes nécessitent des ustensiles fiables.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486229&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9787f15f-31ef-4e3b-a33f-8d424e917397\', \'multiverseId\': 486229}, \'multiverseid\': 486229}, {\'name\': \'Calderone della Strega\', \'text\': \'{1}{B}, {T}, Sacrifica una creatura: Guadagni 1 punto vita e peschi una carta.\', \'type\': \'Artefatto\', \'flavor\': \'Le migliori ricette iniziano con utensili da cucina affidabili.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486488&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'65efc9f8-f26c-4838-b190-7aa23d3e6bf8\', \'multiverseId\': 486488}, \'multiverseid\': 486488}, {\'name\': \'魔女の大釜\', \'text\': \'{1}{B}, {T}, クリーチャー１体を生け贄に捧げる：あなたは１点のライフを得てカードを１枚引く。\', \'type\': \'アーティファクト\', \'flavor\': \'最高の調理法には良質な調理器具が必要だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486747&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ed301aab-df9c-474a-b1ba-30bcd13b0dd6\', \'multiverseId\': 486747}, \'multiverseid\': 486747}, {\'name\': \'마녀의 가마솥\', \'text\': \'{1}{B}, {T}, 생물 한 개를 희생한다: 당신은 생명 1점을 얻고 카드 한 장을 뽑는다.\', \'type\': \'마법물체\', \'flavor\': \'최고의 요리법은 믿을 수 있는 조리도구에서 시작된다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487006&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'699e38ff-3583-41e3-ac9d-94864f345f06\', \'multiverseId\': 487006}, \'multiverseid\': 487006}, {\'name\': \'Caldeirão da Bruxa\', \'text\': \'{1}{B}, {T}: sacrifique uma criatura: Você ganha 1 ponto de vida e compra um card.\', \'type\': \'Artefato\', \'flavor\': \'As melhores receitas começam com uma boa panela.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487265&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d63c0cf5-7ead-49da-9c11-1156753a4054\', \'multiverseId\': 487265}, \'multiverseid\': 487265}, {\'name\': \'Ведьмин Котел\', \'text\': \'{1}{B}, {T}, пожертвуйте существо: вы получаете 1 жизнь и берете карту.\', \'type\': \'Артефакт\', \'flavor\': \'Лучшие блюда начинаются с надежной утвари.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487524&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fd99a132-f904-44b9-9539-47be26771afb\', \'multiverseId\': 487524}, \'multiverseid\': 487524}, {\'name\': \'巫婆鼎镬\', \'text\': \'{1}{B}，{T}，牺牲一个生物：你获得1点生命且抓一张牌。\', \'type\': \'神器\', \'flavor\': \'美味食谱始于可靠炉具。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487783&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'73ea9898-7a74-4082-b1ea-21b00448f906\', \'multiverseId\': 487783}, \'multiverseid\': 487783}, {\'name\': \'巫婆鼎鑊\', \'text\': \'{1}{B}，{T}，犧牲一個生物：你獲得1點生命且抽一張牌。\', \'type\': \'神器\', \'flavor\': \'美味食譜始於可靠爐具。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488042&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d4bff0e9-2957-4c7d-8161-c140c06de906\', \'multiverseId\': 488042}, \'multiverseid\': 488042}]', '[{\'name\': \'Himmlische Vollstreckerin\', \'text\': \'{1}{W}, {T}: Tappe eine Kreatur deiner Wahl. Aktiviere diese Fähigkeit nur, falls du eine fliegende Kreatur kontrollierst.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': \'„Ich suche in den Himmeln nach Hoffnung, aber du wirst niederknien."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485593&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3931ffba-f812-4f52-8d27-8ed59c892d73\', \'multiverseId\': 485593}, \'multiverseid\': 485593}, {\'name\': \'Ejecutora celestial\', \'text\': \'{1}{W}, {T}: Gira la criatura objetivo. Activa esta habilidad solo si controlas una criatura con la habilidad de volar.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': \'"Alzo la mirada a los cielos en busca de esperanza; pero tú te arrodillarás".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485852&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cd075fc1-6815-4dcd-8ff2-a1e44937d64b\', \'multiverseId\': 485852}, \'multiverseid\': 485852}, {\'name\': \'Argousine céleste\', \'text\': "{1}{W}, {T} : Engagez la créature ciblée. N\'activez cette capacité que si vous contrôlez une créature avec le vol.", \'type\': \'Créature : humain et clerc\', \'flavor\': "« Je cherche l\'espoir dans les cieux, mais vous vous prosternerez. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486111&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'70dd1def-78a8-4e7c-97af-82c201cead3f\', \'multiverseId\': 486111}, \'multiverseid\': 486111}, {\'name\': \'Esecutrice Celestiale\', \'text\': \'{1}{W}, {T}: TAPpa una creatura bersaglio. Attiva questa abilità solo se controlli una creatura con volare.\', \'type\': \'Creatura — Chierico Umano\', \'flavor\': \'"Io alzo lo sguardo al cielo in cerca di speranza, ma tu ti inginocchierai."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486370&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'16aaabd5-7b3e-441d-b7da-4b1fbf5999fa\', \'multiverseId\': 486370}, \'multiverseid\': 486370}, {\'name\': \'天界の処罰者\', \'text\': \'{1}{W}, {T}：クリーチャー１体を対象とし、それをタップする。この能力は、あなたが飛行を持つクリーチャーをコントロールしているときにのみ起動できる。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': \'「私は天を仰いで希望を求め、あなたは天に跪く。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486629&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'90ba28fb-e83e-4ab7-8a3c-75e1b6605a33\', \'multiverseId\': 486629}, \'multiverseid\': 486629}, {\'name\': \'천상의 집행자\', \'text\': \'{1}{W}, {T}: 생물을 목표로 정한다. 그 생물을 탭한다. 당신이 비행을 가진 생물을 조종할 때에만 이 능력을 활성화할 수 있다.\', \'type\': \'생물 — 인간 성직자\', \'flavor\': \'"나는 희망을 바라며 하늘을 바라보지만, 너는 무릎을 꿇게 될 것이다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486888&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7b5c8954-3840-4655-8f6e-51474977e985\', \'multiverseId\': 486888}, \'multiverseid\': 486888}, {\'name\': \'Impositora Celestial\', \'text\': \'{1}{W}, {T}: Vire a criatura alvo. Ative esta habilidade somente se você controlar uma criatura com voar.\', \'type\': \'Criatura — Humano Clérigo\', \'flavor\': \'"Eu olho para os céus em busca de esperança, mas você se curvará."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487147&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3012bf61-5544-4183-8451-d305fccc9fc0\', \'multiverseId\': 487147}, \'multiverseid\': 487147}, {\'name\': \'Небесная Принудительница\', \'text\': \'{1}{W}, {T}: поверните целевое существо. Активируйте эту способность, только если вы контролируете существо с Полетом.\', \'type\': \'Существо — Человек Священник\', \'flavor\': \'«Я устремляю взгляд в небеса в поисках надежды, ты же преклонишь пред ними колена».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487406&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cb2517fe-8c8e-47e5-aa21-8772cfeb54f3\', \'multiverseId\': 487406}, \'multiverseid\': 487406}, {\'name\': \'天界执法者\', \'text\': \'{1}{W}，{T}：横置目标生物。只能于你操控具飞行异能的生物时起动此异能。\', \'type\': \'生物 ～人类／僧侣\', \'flavor\': \'「我可仰首祈天助，而你只能屈膝求垂怜。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487665&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4b18f5e5-858e-4829-8bbe-d450d705ba8e\', \'multiverseId\': 487665}, \'multiverseid\': 487665}, {\'name\': \'天界執法者\', \'text\': \'{1}{W}，{T}：橫置目標生物。只能於你操控具飛行異能的生物時起動此異能。\', \'type\': \'生物 ～人類／僧侶\', \'flavor\': \'「我可仰首祈天助，而你只能屈膝求垂憐。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487924&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'387d57f2-335f-4d45-bef1-f5168a5b8615\', \'multiverseId\': 487924}, \'multiverseid\': 487924}]', '[{\'name\': \'Historiker von Zhalfir\', \'text\': \'Immer wenn der Historiker von Zhalfir angreift und falls du einen Teferi-Planeswalker kontrollierst, ziehe eine Karte.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'„Komm her und hör zu. Ich erzähle dir die Geschichte von einer Nation, die im Strudel der Zeit verloren ging, und dem Mann, der dafür verantwortlich war."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488651&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'076bb657-9b00-444d-9b65-727418d9070a\', \'multiverseId\': 488651}, \'multiverseid\': 488651}, {\'name\': \'Historiador de Zhalfir\', \'text\': \'Siempre que el Historiador de Zhalfir ataque, si controlas un planeswalker Teferi, roba una carta.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'"Ven y escucha. Te contaré la historia de una nación perdida en el tiempo y del hombre que lo provocó".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488671&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f7351382-b471-41e4-8538-64a178cb63ba\', \'multiverseId\': 488671}, \'multiverseid\': 488671}, {\'name\': \'Historien de Zhalfir\', \'text\': "À chaque fois que l\'Historien de Zhalfir attaque, si vous contrôlez un planeswalker Téfeiri, piochez une carte.", \'type\': \'Créature : humain et sorcier\', \'flavor\': "« Venez et écoutez. Je vais vous conter l\'histoire d\'une nation disparue dans le temps, et de l\'homme qui en est responsable. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488691&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e0d48db2-183d-4dc2-81cd-cde28a502ca6\', \'multiverseId\': 488691}, \'multiverseid\': 488691}, {\'name\': \'Storico di Zhalfir\', \'text\': \'Ogniqualvolta lo Storico di Zhalfir attacca, se controlli un planeswalker Teferi, pesca una carta.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': \'"Venite e ascoltate. Vi racconterò la storia di una nazione perduta nel tempo e dell\\\'uomo che ne fu la causa."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488711&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'686cb185-8156-451c-9e7b-3f674aa7c8e8\', \'multiverseId\': 488711}, \'multiverseid\': 488711}, {\'name\': \'ザルファーの歴史家\', \'text\': \'ザルファーの歴史家が攻撃するたび、あなたがテフェリー・プレインズウォーカーをコントロールしている場合、カードを１枚引く。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'「ここへ来て聞きなさい。時に敗れた国と、その原因となった男の物語を教えよう。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488731&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'041a094a-601c-4b6f-be8b-0d3725028bad\', \'multiverseId\': 488731}, \'multiverseid\': 488731}, {\'name\': \'잘피르의 역사가\', \'text\': \'잘피르의 역사가가 공격할 때마다, 당신이 테페리 플레인즈워커를 조종한다면, 카드 한 장을 뽑는다.\', \'type\': \'생물 — 인간 마법사\', \'flavor\': \'"모두 잘 들으시오. 시간 속으로 사라진 나라와, 그 일을 일으킨 사람에 대해 이야기할 테니."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488751&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6630a382-99ec-401c-8c56-c018ce3bbee6\', \'multiverseId\': 488751}, \'multiverseid\': 488751}, {\'name\': \'Historiador de Zhalfir\', \'text\': \'Toda vez que Historiador de Zhalfir atacar, se você controla um planeswalker Teferi, compre um card.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'"Venha e ouça. Vou lhe contar a história de uma nação perdida no tempo e do homem responsável por isso."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488771&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9e60e2e2-4021-4ec9-b464-92dcb43f739d\', \'multiverseId\': 488771}, \'multiverseid\': 488771}, {\'name\': \'Историк Жалфира\', \'text\': \'Каждый раз, когда Историк Жалфира атакует, если под вашим контролем есть planeswalker Тефери, возьмите карту.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'«Подойдите и послушайте. Я расскажу вам историю о народе, потерянном во времени, и о человеке, ставшем тому причиной».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488791&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a6b4fca0-a3ea-445b-b726-895fdc9b3c1b\', \'multiverseId\': 488791}, \'multiverseid\': 488791}, {\'name\': \'赛费尔史家\', \'text\': \'每当赛费尔史家攻击时，若你操控泰菲力鹏洛客，则抓一张牌。\', \'type\': \'生物 ～人类／法术师\', \'flavor\': \'「都过来坐下听听。曾经有个国度，整个消逝在时间之中；曾经有位法师，将整个国度抽离时空～我这次就来讲讲这段故事。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488811&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1fa1c156-db55-4bb9-916b-e6facad60f77\', \'multiverseId\': 488811}, \'multiverseid\': 488811}, {\'name\': \'賽費爾史家\', \'text\': \'每當賽費爾史家攻擊時，若你操控泰菲力鵬洛客，則抽一張牌。\', \'type\': \'生物 ～人類／魔法師\', \'flavor\': \'「都過來坐下聽聽。曾經有個國度，整個消逝在時間之中；曾經有位法師，將整個國度抽離時空～我這次就來講這段故事。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488831&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7d99a5af-0c0e-40a3-aeb9-c5e8caf0f7f5\', \'multiverseId\': 488831}, \'multiverseid\': 488831}]', '[{\'name\': \'Humpelteufel\', \'text\': \'Verursacht Trampelschaden (Diese Kreatur kann überschüssigen Kampfschaden dem verteidigenden Spieler oder Planeswalker zufügen.)\\n{1}, opfere eine andere Kreatur: Lege eine +1/+1-Marke auf den Humpelteufel.\', \'type\': \'Kreatur — Teufel\', \'flavor\': \'Bettwanzen sind nicht das Einzige, was dich nachts beißen könnte und worüber du dir Sorgen machen solltest.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485734&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1bd50f0c-3e98-4fba-b07d-131cd9cef1b2\', \'multiverseId\': 485734}, \'multiverseid\': 485734}, {\'name\': \'Diablillo comepiés\', \'text\': \'Arrolla. (Esta criatura puede hacer el daño de combate sobrante al jugador o planeswalker al que ataca.)\\n{1}, sacrificar otra criatura: Pon un contador +1/+1 sobre el Diablillo comepiés.\', \'type\': \'Criatura — Diablo\', \'flavor\': \'Los mordiscos de los chinches no son los únicos que deberían preocuparte por la noche.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485993&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0a5227b1-c81d-4682-b7e0-77ca13e02f90\', \'multiverseId\': 485993}, \'multiverseid\': 485993}, {\'name\': \'Fielleux croque pieds\', \'text\': "Piétinement (Cette créature peut infliger son surplus de blessures de combat au joueur ou au planeswalker qu\'elle attaque.)\\n{1}, sacrifiez une autre créature : Mettez un marqueur +1/+1 sur le Fielleux croque pieds.", \'type\': \'Créature : diable\', \'flavor\': "Il n\'y a pas que les moustiques dont il faut se méfier la nuit.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486252&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'81d71be8-8dc4-4e0b-b5ff-f4e05e4b7e2c\', \'multiverseId\': 486252}, \'multiverseid\': 486252}, {\'name\': \'Azzannapiedi\', \'text\': "Travolgere (Questa creatura può infliggere il danno da combattimento in eccesso al giocatore o al planeswalker che sta attaccando.)\\n{1}, Sacrifica un\'altra creatura: Metti un segnalino +1/+1 sull\'Azzannapiedi.", \'type\': \'Creatura — Diavolo\', \'flavor\': \'Le cimici dei letti non sono gli unici parassiti inquietanti che potrebbero morderti nella notte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486511&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9db3f7b6-d74a-4473-9e2f-f3f97d7d2e48\', \'multiverseId\': 486511}, \'multiverseid\': 486511}, {\'name\': \'引きずり鬼\', \'text\': \'トランプル（このクリーチャーは余剰の戦闘ダメージを、これが攻撃しているプレイヤーかプレインズウォーカーに与えることができる。）\\n{1}, 他のクリーチャー１体を生け贄に捧げる：引きずり鬼の上に＋１/＋１カウンターを１個置く。\', \'type\': \'クリーチャー — デビル\', \'flavor\': \'夜に咬まれる心配は、ダニやシラミだけではない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486770&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c264e6f1-aaa7-4181-9d70-f3e7a831a588\', \'multiverseId\': 486770}, \'multiverseid\': 486770}, {\'name\': \'절뚝악귀\', \'text\': \'돌진 (이 생물은 여분의 전투피해를 공격 중인 플레이어 또는 플레인즈워커에게 입힐 수 있다.)\\n{1}, 다른 생물 한 개를 희생한다: 절뚝악귀에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 악령\', \'flavor\': \'밤에 당신을 물어뜯을까 걱정해야 하는 것이 빈대뿐만은 아니다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487029&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'953760e2-fdd7-4666-abf6-0407b4ddf413\', \'multiverseId\': 487029}, \'multiverseid\': 487029}, {\'name\': \'Diabo Mutilador\', \'text\': \'Atropelar (Esta criatura pode causar seu dano de combate excedente ao jogador ou planeswalker que ela estiver atacando.)\\n{1}, sacrifique outra criatura: Coloque um marcador +1/+1 em Diabo Mutilador.\', \'type\': \'Criatura — Diabo\', \'flavor\': \'As mordidas dos percevejos não são as únicas com que se preocupar à noite.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487288&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7cef6eb4-dd5a-469e-8a12-c9d745df1f0c\', \'multiverseId\': 487288}, \'multiverseid\': 487288}, {\'name\': \'Демон Хромоты\', \'text\': "Пробивной удар (Это существо может нанести избыточные боевые повреждения игроку или planeswalker\'у, которого атакует.)\\n{1}, пожертвуйте другое существо: положите один жетон +1/+1 на Демона Хромоты.", \'type\': \'Существо — Дьявол\', \'flavor\': \'Клопы — не единственные твари, которые могут покусать тебя ночью.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487547&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'292f76ae-5d0b-414e-be4f-fe995fd09d5a\', \'multiverseId\': 487547}, \'multiverseid\': 487547}, {\'name\': \'噬踵邪鬼\', \'text\': \'践踏（此生物造成之过量战斗伤害能对所攻击的牌手或鹏洛客造成之。）\\n{1}，牺牲另一个生物：在噬踵邪鬼上放置一个+1/+1指示物。\', \'type\': \'生物 ～魔鬼\', \'flavor\': \'至于会在晚上钻出来咬你的东西，需要防备的绝非仅有臭虫一种。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487806&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'90558e72-e9c0-4b92-96ad-b136cfacfc48\', \'multiverseId\': 487806}, \'multiverseid\': 487806}, {\'name\': \'噬踵邪鬼\', \'text\': \'踐踏（此生物造成之過量戰鬥傷害能對所攻擊的玩家或鵬洛客造成之。）\\n{1}，犧牲另一個生物：在噬踵邪鬼上放置一個+1/+1指示物。\', \'type\': \'生物 ～魔鬼\', \'flavor\': \'至於會在晚上鑽出來咬你的東西，需要防備的絕非僅有臭蟲一種。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488065&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4dc02e82-d57d-4a36-8194-7b3382e7557f\', \'multiverseId\': 488065}, \'multiverseid\': 488065}]', "[{'name': 'Höhlen des Blutvergießens', 'text': 'Die Höhlen des Blutvergießens kommen getappt ins Spiel.\\nWenn die Höhlen des Blutvergießens ins Spiel kommen, erhältst du 1 Lebenspunkt dazu.\\n{T}: Erzeuge {B} oder {R}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485825&type=card', 'language': 'German', 'identifiers': {'scryfallId': '7088998f-2496-4bb0-983a-6106fd8a8036', 'multiverseId': 485825}, 'multiverseid': 485825}, {'name': 'Cuevas maculasangrientas', 'text': 'Las Cuevas maculasangrientas entran al campo de batalla giradas.\\nCuando las Cuevas maculasangrientas entren al campo de batalla, ganas 1 vida.\\n{T}: Agrega {B} o {R}.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486084&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '68f91aea-978f-42dc-a91f-243b715c6daa', 'multiverseId': 486084}, 'multiverseid': 486084}, {'name': 'Cavernes du Sacrifice', 'text': 'Les Cavernes du Sacrifice arrivent sur le champ de bataille engagées.\\nQuand les Cavernes du Sacrifice arrivent sur le champ de bataille, vous gagnez 1 point de vie.\\n{T} : Ajoutez {B} ou {R}.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486343&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ba0c9d82-9319-49d8-b883-2e65c71d2e35', 'multiverseId': 486343}, 'multiverseid': 486343}, {'name': 'Caverne del Sangue Versato', 'text': 'Le Caverne del Sangue Versato entrano nel campo di battaglia TAPpate.\\nQuando le Caverne del Sangue Versato entrano nel campo di battaglia, guadagni 1 punto vita.\\n{T}: Aggiungi {B} o {R}.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486602&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'd3c25c84-d4d8-4f7f-923d-ff98f6c413d0', 'multiverseId': 486602}, 'multiverseid': 486602}, {'name': '血溜まりの洞窟', 'text': '血溜まりの洞窟はタップ状態で戦場に出る。\\n血溜まりの洞窟が戦場に出たとき、あなたは１点のライフを得る。\\n{T}：{B}か{R}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486861&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f0fbdf18-b0ef-486b-a660-9bce2fcc285f', 'multiverseId': 486861}, 'multiverseid': 486861}, {'name': '핏자국 동굴', 'text': '핏자국 동굴은 탭된 채로 전장에 들어온다.\\n핏자국 동굴이 전장에 들어올 때, 당신은 생명 1점을 얻는다.\\n{T}: {B} 또는 {R}를 추가한다.', 'type': '대지', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487120&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'bd526519-84b9-417b-926c-87af11a88208', 'multiverseId': 487120}, 'multiverseid': 487120}, {'name': 'Cavernas Sanguinárias', 'text': 'Cavernas Sanguinárias entra no campo de batalha virado.\\nQuando Cavernas Sanguinárias entra no campo de batalha, você ganha 1 ponto de vida.\\n{T}: Adicione {B} ou {R}.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487379&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ce89fe41-6298-47bc-bc4c-e70f34582219', 'multiverseId': 487379}, 'multiverseid': 487379}, {'name': 'Пещеры Пролитой Крови', 'text': 'Пещеры Пролитой Крови выходят на поле битвы повернутыми.\\nКогда Пещеры Пролитой Крови выходят на поле битвы, вы получаете 1 жизнь.\\n{T}: добавьте {B} или {R}.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487638&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'f561925b-4ddd-4436-b7c7-feb5c7af067a', 'multiverseId': 487638}, 'multiverseid': 487638}, {'name': '染血洞窟', 'text': '染血洞窟须横置进战场。\\n当染血洞窟进战场时，你获得1点生命。\\n{T}：加{B}或{R}。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487897&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'bf82544d-e1f3-402d-a667-4e1d6c953445', 'multiverseId': 487897}, 'multiverseid': 487897}, {'name': '染血洞窟', 'text': '染血洞窟須橫置進戰場。\\n當染血洞窟進戰場時，你獲得1點生命。\\n{T}：加{B}或{R}。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488156&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '03b12585-8ba1-47e7-9ba4-ef9ba3a1a669', 'multiverseId': 488156}, 'multiverseid': 488156}]", '[{\'name\': \'Höllendrachen-Bestrafer\', \'text\': \'Fliegend\\n{R}: Der Höllendrachen-Bestrafer erhält +1/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Drache\', \'flavor\': \'„Wir werden nie wieder Tribut an diese tyrannische Echse zahlen. Jetzt beginnt ein neues Zeitalter!"\\n—Bürgermeister Kadrim, kürzlich verstorben\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485733&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dd1380ac-5a58-4f00-bc22-84d6129ecd27\', \'multiverseId\': 485733}, \'multiverseid\': 485733}, {\'name\': \'Engendro castigador\', \'text\': \'Vuela.\\n{R}: El Engendro castigador obtiene +1/+0 hasta el final del turno.\', \'type\': \'Criatura — Dragón\', \'flavor\': \'"Ya no rendiremos más homenajes a ese lagarto tiránico. ¡Hoy empieza una nueva era!".\\n—Alcalde Kadrim, ahora fallecido\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485992&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'47e80273-548f-4fe2-b614-7dbf086d8742\', \'multiverseId\': 485992}, \'multiverseid\': 485992}, {\'name\': \'Châtieur escouflenfer\', \'text\': "Vol\\n{R} : Le Châtieur escouflenfer gagne +1/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : dragon\', \'flavor\': "« Nous n\'offrirons plus de sacrifices à ce lézard tyrannique. Une nouvelle ère commence aujourd\'hui ! »\\n—Maire Kadrim, aujourd\'hui décédé", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486251&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e935a3e3-a45d-4b1a-8682-e95889db560c\', \'multiverseId\': 486251}, \'multiverseid\': 486251}, {\'name\': \'Nibbio Infernale Vendicativo\', \'text\': \'Volare\\n{R}: Il Nibbio Infernale Vendicativo prende +1/+0 fino alla fine del turno.\', \'type\': \'Creatura — Drago\', \'flavor\': \'"Non pagheremo più alcun tributo a quella lucertola dispotica. Da oggi ha inizio una nuova era!"\\n—Sindaco Kadrim, ora defunto\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486510&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c2f97ac2-f213-4947-8911-129291fa94a7\', \'multiverseId\': 486510}, \'multiverseid\': 486510}, {\'name\': \'ヘルカイトの懲罰者\', \'text\': \'飛行\\n{R}：ターン終了時まで、ヘルカイトの懲罰者は＋１/＋０の修整を受ける。\', \'type\': \'クリーチャー — ドラゴン\', \'flavor\': \'「今後、あの専制的なトカゲへの献納は止めよう。新たな時代が始まるのだ！」\\n――カドリム市長（死亡）\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486769&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0c3a1eff-9762-47ed-8f19-2b56a70ed509\', \'multiverseId\': 486769}, \'multiverseid\': 486769}, {\'name\': \'지옥룡 처벌자\', \'text\': \'비행\\n{R}: 지옥룡 처벌자는 턴종료까지 +1/+0을 받는다.\', \'type\': \'생물 — 용\', \'flavor\': \'"우리는 그 폭압적인 도마뱀에게 더이상 조공을 바치지 않겠다. 오늘 새로운 시대가 시작된다!"\\n—고 카드림 시장\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487028&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'35b116a7-0d71-436f-9d19-1f8cdf5c7af6\', \'multiverseId\': 487028}, \'multiverseid\': 487028}, {\'name\': \'Dragão Avérneo Castigador\', \'text\': \'Voar\\n{R}: Dragão Avérneo Castigador recebe +1/+0 até o final do turno.\', \'type\': \'Criatura — Dragão\', \'flavor\': \'"Não pagaremos mais tributo àquele lagarto tirânico. Hoje começa uma nova era!"\\n— Prefeito Kadrim, falecido\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487287&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1080ddad-015b-4629-9c5f-af9aada4a0ea\', \'multiverseId\': 487287}, \'multiverseid\': 487287}, {\'name\': \'Карающий Огненный Змей\', \'text\': \'Полет\\n{R}: Карающий Огненный Змей получает +1/+0 до конца хода.\', \'type\': \'Существо — Дракон\', \'flavor\': \'«Больше мы не станем платить дань этому жестокому ящеру. Сегодня начинается новая эпоха!»\\n— мэр Кадрим, ныне покойный\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487546&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fd069a7c-c4d3-4d94-958b-fc6366af4ec5\', \'multiverseId\': 487546}, \'multiverseid\': 487546}, {\'name\': \'惩焰残虐者\', \'text\': \'飞行\\n{R}：惩焰残虐者得+1/+0直到回合结束。\', \'type\': \'生物 ～龙\', \'flavor\': \'「我们绝不再向那只暴躁蜥蜴低头进贡。全新时代就从今天开始！」\\n～已故凯德霖市长\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487805&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9d47b3bc-2084-49fb-a3e4-caa06320cae3\', \'multiverseId\': 487805}, \'multiverseid\': 487805}, {\'name\': \'懲焰殘虐者\', \'text\': \'飛行\\n{R}：懲焰殘虐者得+1/+0直到回合結束。\', \'type\': \'生物 ～龍\', \'flavor\': \'「我們絕不再向那隻暴躁蜥蜴低頭進貢。全新時代就從今天開始！」\\n～已故凱德霖市長\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488064&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c0439945-5097-4edd-afab-f045f30a30b1\', \'multiverseId\': 488064}, \'multiverseid\': 488064}]', '[{\'name\': \'Höllische Narben\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur erhält +2/+0 und hat „Wenn diese Kreatur stirbt, ziehe eine Karte."\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Derjenige, der im Leben von einem Dämon gezeichnet wird, bleibt nach seinem Tode als Dämon in Erinnerung.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485687&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'089bb943-b4bb-4a62-a9ac-a80f4e89ccf8\', \'multiverseId\': 485687}, \'multiverseid\': 485687}, {\'name\': \'Cicatrices infernales\', \'text\': \'Encantar criatura.\\nLa criatura encantada obtiene +2/+0 y tiene "Cuando esta criatura muera, roba una carta".\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'Quien queda marcado por un demonio en vida será recordado como uno de ellos en la muerte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485946&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8468e816-33bf-47aa-97e8-4094d5b03c92\', \'multiverseId\': 485946}, \'multiverseid\': 485946}, {\'name\': \'Scarification infernale\', \'text\': \'Enchanter : créature\\nLa créature enchantée gagne +2/+0 et a « Quand cette créature meurt, piochez une carte ».\', \'type\': \'Enchantement : aura\', \'flavor\': \'Qui est marqué de son vivant par un démon sera considéré comme tel après sa mort.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486205&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ac88624e-bc9b-4bf3-98b5-c357b8d78528\', \'multiverseId\': 486205}, \'multiverseid\': 486205}, {\'name\': \'Sfregio Infernale\', \'text\': \'Incanta creatura\\nLa creatura incantata prende +2/+0 e ha "Quando questa creatura muore, pesca una carta".\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'Chi è marchiato da un demone in vita certamente sarà ricordato come tale nella morte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486464&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f2f7df8b-5b79-4282-873b-44b56f39d756\', \'multiverseId\': 486464}, \'multiverseid\': 486464}, {\'name\': \'冥府の傷跡\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントしているクリーチャーは＋２/＋０の修整を受け、「このクリーチャーが死亡したとき、カードを１枚引く。」を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'悪魔によって印を受けた生ある者は、死んだ者として記憶されるだろう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486723&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4ddea0d0-9221-4c00-be55-b93b2e925d16\', \'multiverseId\': 486723}, \'multiverseid\': 486723}, {\'name\': \'지옥에서 입은 흉터\', \'text\': \'생물에게 부여\\n부여된 생물은 +2/+0을 받고 "이 생물이 죽을 때, 카드 한 장을 뽑는다."를 가진다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'생전에 악마에게 낙인 찍힌 자는 죽어서도 그 오명을 씻을 수 없다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486982&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'93833aad-c4fd-43d6-9cc3-5527462e46e4\', \'multiverseId\': 486982}, \'multiverseid\': 486982}, {\'name\': \'Escarificação Infernal\', \'text\': \'Encantar criatura\\nA criatura encantada recebe +2/+0 e tem "Quando esta criatura morrer, compre um card."\', \'type\': \'Encantamento — Aura\', \'flavor\': \'Aquele que é marcado por um demônio em vida, certamente será lembrado como um na morte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487241&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3a6bcb92-3ca8-461d-9270-a4cb6aea9826\', \'multiverseId\': 487241}, \'multiverseid\': 487241}, {\'name\': \'Шрамы Преисподней\', \'text\': \'Зачаровать существо\\nЗачарованное существо получает +2/+0 и имеет способность «Когда это существо умирает, возьмите карту».\', \'type\': \'Чары — Аура\', \'flavor\': \'Того, кого демон отметил при жизни, запомнят таким и после смерти.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487500&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'31c60ff5-fd42-4a39-ae0c-9a271803f599\', \'multiverseId\': 487500}, \'multiverseid\': 487500}, {\'name\': \'炼狱留痕\', \'text\': \'结附于生物\\n所结附的生物得+2/+0且具有「当此生物死去时，抓一张牌。」\', \'type\': \'结界 ～灵气\', \'flavor\': \'生前得恶魔印记者，死后亦被以恶魔相待。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487759&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d31fc0e0-f517-4f96-a2c0-66742095adc1\', \'multiverseId\': 487759}, \'multiverseid\': 487759}, {\'name\': \'煉獄留痕\', \'text\': \'結附於生物\\n所結附的生物得+2/+0且具有「當此生物死去時，抽一張牌。」\', \'type\': \'結界 ～靈氣\', \'flavor\': \'生前得惡魔印記者，死後亦被以惡魔相待。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488018&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0340fde1-a1c8-4e7c-b61b-c5a9c6e98d34\', \'multiverseId\': 488018}, \'multiverseid\': 488018}]', '[{\'name\': \'Hüter der Wälder\', \'text\': \'Wachsamkeit (Diese Kreatur wird beim Angreifen nicht getappt.)\\nImmer wenn der Hüter der Wälder das Ziel eines Zauberspruchs oder einer Fähigkeit wird, den bzw. die ein Gegner kontrolliert, kannst du zwei Karten ziehen.\', \'type\': \'Kreatur — Baumhirte\', \'flavor\': \'Die Schwachen sowie die Starken suchen unter seinen Ästen Schutz.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485795&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'52906cfc-7efc-4b0d-82e2-cef5ceaaa871\', \'multiverseId\': 485795}, \'multiverseid\': 485795}, {\'name\': \'Guarda de los bosques\', \'text\': \'Vigilancia. (Esta criatura no se gira al atacar.)\\nSiempre que el Guarda de los bosques sea objetivo de un hechizo o habilidad que controla un oponente, puedes robar dos cartas.\', \'type\': \'Criatura — Pueblo-arbóreo\', \'flavor\': \'Tanto los débiles como los fuertes buscan refugio bajo sus ramas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486054&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'79cc24f4-a92f-4893-9818-b2a9ea0198af\', \'multiverseId\': 486054}, \'multiverseid\': 486054}, {\'name\': \'Garde des bois\', \'text\': "Vigilance (Attaquer avec cette créature ne la fait pas s\'engager.)\\nÀ chaque fois que le Garde des bois devient la cible d\'un sort ou d\'une capacité qu\'un adversaire contrôle, vous pouvez piocher deux cartes.", \'type\': \'Créature : sylvin\', \'flavor\': "Les plus faibles comme les plus forts s\'abritent derrière ses branches.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486313&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'02e80011-7662-46f4-a534-67510bf0b521\', \'multiverseId\': 486313}, \'multiverseid\': 486313}, {\'name\': \'Guardiano dei Boschi\', \'text\': \'Cautela (Questa creatura attacca senza TAPpare.)\\nOgniqualvolta il Guardiano dei Boschi diventa bersaglio di una magia o abilità controllata da un avversario, puoi pescare due carte.\', \'type\': \'Creatura — Silvantropo\', \'flavor\': \'Tanto i forti quanto i deboli cercano rifugio sotto i suoi rami.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486572&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8cf1e016-eb45-407a-8e00-d2851befaf54\', \'multiverseId\': 486572}, \'multiverseid\': 486572}, {\'name\': \'森の守部\', \'text\': \'警戒（このクリーチャーは攻撃してもタップしない。）\\n森の守部が、対戦相手がコントロールしている呪文か能力の対象になるたび、あなたはカードを２枚引いてもよい。\', \'type\': \'クリーチャー — ツリーフォーク\', \'flavor\': \'弱いものも強いものも、揃ってその枝の庇護を求める。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486831&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4f4f15d8-bd96-421f-8c9e-70e1aed6ad60\', \'multiverseId\': 486831}, \'multiverseid\': 486831}, {\'name\': \'숲 관리자\', \'text\': \'경계 (이 생물은 공격하면서 탭되지 않는다.)\\n숲 관리자가 상대가 조종하는 주문 또는 능력의 목표가 될 때마다, 당신은 카드 두 장을 뽑을 수 있다.\', \'type\': \'생물 — 인목\', \'flavor\': \'약자든 강자든 하나같이 그것의 가지 아래에서 몸을 숨길 곳을 찾는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487090&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c23a7eeb-e713-4b83-affa-4b80d7264a9e\', \'multiverseId\': 487090}, \'multiverseid\': 487090}, {\'name\': \'Guardião das Matas\', \'text\': \'Vigilância (Atacar não faz com que esta criatura seja virada.)\\nToda vez que Guardião das Matas se torna alvo de uma mágica ou habilidade que um oponente controla, você pode comprar dois cards.\', \'type\': \'Criatura — Ent\', \'flavor\': \'Tanto o forte quanto o fraco buscam refúgio sob seus galhos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487349&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'da449faf-92c3-4a6d-9a2f-8eccf6c453d8\', \'multiverseId\': 487349}, \'multiverseid\': 487349}, {\'name\': \'Хранитель Леса\', \'text\': \'Бдительность (Атакуя, это существо не поворачивается.)\\nКаждый раз, когда Хранитель Леса становится целью заклинания или способности под контролем оппонента, вы можете взять две карты.\', \'type\': \'Существо — Лесовик\', \'flavor\': \'И слабые, и сильные ищут убежище под его ветвями.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487608&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8c7d0cb5-e441-4c77-a10a-bf681af6fcbe\', \'multiverseId\': 487608}, \'multiverseid\': 487608}, {\'name\': \'护林树妖\', \'text\': \'警戒（此生物攻击时不需横置。）\\n每当护林树妖成为由对手操控之咒语或异能的目标时，你可以抓两张牌。\', \'type\': \'生物 ～树妖\', \'flavor\': \'强者和弱者都在其枝杈下寻求庇护。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487867&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0c68cbd5-93cb-4b53-86a3-22d762542ee9\', \'multiverseId\': 487867}, \'multiverseid\': 487867}, {\'name\': \'護林樹妖\', \'text\': \'警戒（此生物攻擊時不需橫置。）\\n每當護林樹妖成為由對手操控之咒語或異能的目標時，你可以抽兩張牌。\', \'type\': \'生物 ～樹妖\', \'flavor\': \'強者和弱者都在其枝杈下尋求庇護。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488126&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d3093084-d65f-42f4-b70c-bf3e5b503e8a\', \'multiverseId\': 488126}, \'multiverseid\': 488126}]', "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488479&type=card', 'language': 'German', 'identifiers': {'scryfallId': '00ce1c13-a2dd-4a63-9873-dc84bfe026e1', 'multiverseId': 488479}, 'multiverseid': 488479}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488494&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4a73747e-cc3a-4817-9aa7-ffbdbb566d83', 'multiverseId': 488494}, 'multiverseid': 488494}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488509&type=card', 'language': 'French', 'identifiers': {'scryfallId': '675c263f-0f60-4a0c-9e39-e5484bd623c1', 'multiverseId': 488509}, 'multiverseid': 488509}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488539&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'c29f3997-84dc-4205-b07b-172c69c67606', 'multiverseId': 488539}, 'multiverseid': 488539}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488584&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'b134c6ec-91bd-489a-910d-3f605f322f36', 'multiverseId': 488584}, 'multiverseid': 488584}, {'name': '海岛', 'type': '基本地 ～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488599&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '8b1dfe73-2613-4004-93e9-ea63d918b1e1', 'multiverseId': 488599}, 'multiverseid': 488599}, {'name': '海島', 'type': '基本地 ～海島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488614&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '8169f300-fd06-4c0b-aa7b-018536b0db67', 'multiverseId': 488614}, 'multiverseid': 488614}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488480&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2ea286be-4f32-4108-899b-32f198fce06f', 'multiverseId': 488480}, 'multiverseid': 488480}, {'name': 'Île', 'typ