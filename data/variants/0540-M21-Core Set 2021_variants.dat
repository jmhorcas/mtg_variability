lers/Image.ashx?multiverseid=488852&type=card', 'language': 'German', 'identifiers': {'scryfallId': '1ae73641-f6cf-4326-9bcb-81049bbaaf7d', 'multiverseId': 488852}, 'multiverseid': 488852}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488862&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b56423f7-4d6b-4695-b78c-a7f45c2234eb', 'multiverseId': 488862}, 'multiverseid': 488862}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488867&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '356d6fa9-5339-4055-b05d-0a4ce8e041e3', 'multiverseId': 488867}, 'multiverseid': 488867}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488872&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9111b661-faa3-4122-ac52-ccbc715eabaa', 'multiverseId': 488872}, 'multiverseid': 488872}, {'name': '섬', 'type': '기본 대지 — 섬', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488877&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '37469dce-e0f2-4bd2-ac02-350ae30fa97a', 'multiverseId': 488877}, 'multiverseid': 488877}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488882&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fc6a4903-c2a2-4cd2-a4ae-9dceae3877be', 'multiverseId': 488882}, 'multiverseid': 488882}, {'name': '海島', 'type': '基本地 ～海島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488897&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'bd3e8d82-ab7a-417c-b3ca-0bd55f6a7a71', 'multiverseId': 488897}, 'multiverseid': 488897}]", '[{\'name\': \'Intervention héroïque\', \'text\': "Les permanents que vous contrôlez acquièrent la défense talismanique et l\'indestructible jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488326&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'325bcf7f-e6d7-4b34-a7e5-1eb5b839d25d\', \'multiverseId\': 488326}, \'multiverseid\': 488326}, {\'name\': \'英雄的介入\', \'text\': \'ターン終了時まで、あなたがコントロールしているパーマネントは呪禁と破壊不能を得る。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488378&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d7492928-d049-4b3b-b4c1-384083a2b705\', \'multiverseId\': 488378}, \'multiverseid\': 488378}]', '[{\'name\': \'Jeskai-Älteste\', \'text\': \'Bravour (Immer wenn du einen Nichtkreatur-Zauberspruch wirkst, erhält diese Kreatur +1/+1 bis zum Ende des Zuges.)\\nImmer wenn die Jeskai-Älteste einem Spieler Kampfschaden zufügt, kannst du eine Karte ziehen. Falls du dies tust, wirf eine Karte ab.\', \'type\': \'Kreatur — Mensch, Mönch\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485635&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0cf1df41-e841-46e6-b09d-661b46b2d60e\', \'multiverseId\': 485635}, \'multiverseid\': 485635}, {\'name\': \'Anciana jeskai\', \'text\': \'Destreza. (Siempre que lances un hechizo que no sea de criatura, esta criatura obtiene +1/+1 hasta el final del turno.)\\nSiempre que la Anciana jeskai haga daño de combate a un jugador, puedes robar una carta. Si lo haces, descarta una carta.\', \'type\': \'Criatura — Monje humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485894&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'159a40d1-12fe-439b-96a4-09b81e098b5c\', \'multiverseId\': 485894}, \'multiverseid\': 485894}, {\'name\': \'Doyenne jeskaï\', \'text\': "Prouesse (À chaque fois que vous lancez un sort non-créature, cette créature gagne +1/+1 jusqu\'à la fin du tour.)\\nÀ chaque fois que la Doyenne jeskaï inflige des blessures de combat à un joueur, vous pouvez piocher une carte. Si vous faites ainsi, défaussez-vous d\'une carte.", \'type\': \'Créature : humain et moine\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486153&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'70694d21-583b-42ab-89a5-3db267a0ca99\', \'multiverseId\': 486153}, \'multiverseid\': 486153}, {\'name\': \'Anziana Jeskai\', \'text\': "Prodezza (Ogniqualvolta lanci una magia non creatura, questa creatura prende +1/+1 fino alla fine del turno.)\\nOgniqualvolta l\'Anziana Jeskai infligge danno da combattimento a un giocatore, puoi pescare una carta. Se lo fai, scarta una carta.", \'type\': \'Creatura — Monaco Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486412&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5c67c8e7-7b98-432c-963e-059d6aaf847d\', \'multiverseId\': 486412}, \'multiverseid\': 486412}, {\'name\': \'ジェスカイの長老\', \'text\': \'果敢（あなたがクリーチャーでない呪文を唱えるたび、ターン終了時まで、このクリーチャーは＋１/＋１の修整を受ける。）\\nジェスカイの長老がプレイヤー１人に戦闘ダメージを与えるたび、あなたはカードを１枚引いてもよい。そうしたなら、カード１枚を捨てる。\', \'type\': \'クリーチャー — 人間・モンク\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486671&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b67c9328-dd50-4f7e-aa20-59dedc6fe5fa\', \'multiverseId\': 486671}, \'multiverseid\': 486671}, {\'name\': \'제스카이 장로\', \'text\': \'기량 (당신이 생물이 아닌 주문을 발동할 때마다, 이 생물은 턴종료까지 +1/+1을 받는다.)\\n제스카이 장로가 플레이어에게 전투피해를 입힐 때마다, 당신은 카드 한 장을 뽑을 수 있다. 그렇게 한다면, 카드 한 장을 버린다.\', \'type\': \'생물 — 인간 승려\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486930&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9c89eaf0-c42a-4404-8b33-1d93ca777327\', \'multiverseId\': 486930}, \'multiverseid\': 486930}, {\'name\': \'Anciã Jeskai\', \'text\': \'Destreza (Toda vez que você conjura uma mágica que não seja de criatura, esta criatura recebe +1/+1 até o final do turno.)\\nToda vez que Ancião Jeskai causa dano de combate a um jogador, você pode comprar um card. Se fizer isso, descarte um card.\', \'type\': \'Criatura — Humano Monge\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487189&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e2e070aa-4be4-4435-8d5d-452d74051785\', \'multiverseId\': 487189}, \'multiverseid\': 487189}, {\'name\': \'Старейшина Джескайцев\', \'text\': \'Искусность (Каждый раз, когда вы разыгрываете не являющееся существом заклинание, это существо получает +1/+1 до конца хода.)\\nКаждый раз, когда Старейшина Джескайцев наносит боевые повреждения игроку, вы можете взять карту. Если вы это делаете, сбросьте карту.\', \'type\': \'Существо — Человек Монах\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487448&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fdf21984-4534-417f-b03a-a5edc3e2ce54\', \'multiverseId\': 487448}, \'multiverseid\': 487448}, {\'name\': \'洁斯凯长老\', \'text\': \'灵技（每当你施放非生物咒语时，此生物得+1/+1直到回合结束。）\\n每当洁斯凯长老对任一牌手造成战斗伤害时，你可以抓一张牌。若你如此作，则弃一张牌。\', \'type\': \'生物 ～人类／修行僧\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487707&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e53916d1-86d1-4843-a8b1-02d7f0c6b444\', \'multiverseId\': 487707}, \'multiverseid\': 487707}, {\'name\': \'潔斯凱長老\', \'text\': \'靈技（每當你施放非生物咒語時，此生物得+1/+1直到回合結束。）\\n每當潔斯凱長老對任一玩家造成戰鬥傷害時，你可以抽一張牌。若你如此作，則棄一張牌。\', \'type\': \'生物 ～人類／修行僧\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487966&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'211e8f54-6e53-4a8b-9431-9c35744e2f53\', \'multiverseId\': 487966}, \'multiverseid\': 487966}]', '[{\'name\': \'Jolrael, Mwonvuli-Einsiedlerin\', \'text\': \'Immer wenn du deine zweite Karte innerhalb desselben Zuges ziehst, erzeuge einen 2/2 grünen Katze-Kreaturenspielstein.\\n{4}{G}{G}: Bis zum Ende des Zuges haben Kreaturen, die du kontrollierst, Basis-Stärke und -Widerstandskraft X/X, wobei X gleich der Anzahl an Karten auf deiner Hand ist.\', \'type\': \'Legendäre Kreatur — Mensch, Druide\', \'flavor\': \'„Menschen bringen nichts als Leid und Täuschung. Sie sind in meinem Wald nicht willkommen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485773&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5a9b32b7-e668-43aa-b7b4-1c1880b8eb83\', \'multiverseId\': 485773}, \'multiverseid\': 485773}, {\'name\': \'Jolrael, ermitaña de Mwonvuli\', \'text\': \'Siempre que robes tu segunda carta cada turno, crea una ficha de criatura Felino verde 2/2.\\n{4}{G}{G}: Hasta el final del turno, las criaturas que controlas tienen una fuerza y resistencia base de X/X, donde X es la cantidad de cartas en tu mano.\', \'type\': \'Criatura legendaria — Druida humano\', \'flavor\': \'"Los humanos solo nos engañan y nos hacen sufrir. No son bienvenidos en mi bosque".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486032&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ad7df3da-d111-49fa-90e6-9446f9e5a2a8\', \'multiverseId\': 486032}, \'multiverseid\': 486032}, {\'name\': \'Jolraël, recluse de la Mwônvouli\', \'text\': "À chaque fois que vous piochez votre deuxième carte à chaque tour, créez un jeton de créature 2/2 verte Chat.\\n{4}{G}{G} : Jusqu\'à la fin du tour, les créatures que vous contrôlez ont une force et une endurance de base de X/X, X étant le nombre de cartes dans votre main.", \'type\': \'Créature légendaire : humain et druide\', \'flavor\': "« Les humains n\'apportent que souffrance et tromperie. Ils ne sont pas les bienvenus dans ma forêt. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486291&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'06687259-abe6-46d4-9307-6649e0ca4735\', \'multiverseId\': 486291}, \'multiverseid\': 486291}, {\'name\': \'Jolrael, Eremita di Mwonvuli\', \'text\': \'Ogniqualvolta peschi la tua seconda carta in ogni turno, crea una pedina creatura Felino 2/2 verde.\\n{4}{G}{G}: Fino alla fine del turno, le creature che controlli hanno forza e costituzione base X/X, dove X è il numero di carte nella tua mano.\', \'type\': \'Creatura Leggendaria — Druido Umano\', \'flavor\': \'"Gli umani sono capaci di causare solo sofferenze e inganni. Non sono i benvenuti nella mia foresta."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486550&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9d5f06ec-f28b-43d0-a04a-2593969b8132\', \'multiverseId\': 486550}, \'multiverseid\': 486550}, {\'name\': \'ムウォンヴーリーの世捨て人、ジョルレイル\', \'text\': \'あなたが各ターンのあなたの２枚目のカードを引くたび、緑の２/２の猫・クリーチャー・トークンを１体生成する。\\n{4}{G}{G}：ターン終了時まで、あなたがコントロールしているクリーチャーの基本のパワーとタフネスはＸ/Ｘになる。Ｘはあなたの手札にあるカードの枚数に等しい。\', \'type\': \'伝説のクリーチャー — 人間・ドルイド\', \'flavor\': \'「人間がもたらすのは苦しみと偽りのみ。私の森には不要。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486809&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ac0f62cf-af92-424b-964a-e007b7ea157d\', \'multiverseId\': 486809}, \'multiverseid\': 486809}, {\'name\': \'몬불리 은둔자, 졸라일\', \'text\': \'당신이 매 턴 당신의 두 번째 카드를 뽑을 때마다, 2/2 녹색 고양이 생물 토큰 한 개를 만든다.\\n{4}{G}{G}: 턴종료까지, 당신이 조종하는 생물들은 기본 공격력과 방어력이 X/X가 된다. X는 당신의 손에 있는 카드의 수이다.\', \'type\': \'전설적 생물 — 인간 드루이드\', \'flavor\': \'"인간들은 고통과 기만만을 불러올 뿐이다. 그것들은 내 숲에서 환영받지 않는다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487068&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'df4289a8-5e02-4191-bcdf-d1ca9234d249\', \'multiverseId\': 487068}, \'multiverseid\': 487068}, {\'name\': \'Jolrael, Reclusa Mwonvuli\', \'text\': \'Toda vez que comprar seu segundo card a cada turno, crie uma ficha de criatura verde 2/2 do tipo Felino.\\n{4}{G}{G}: Até o final do turno, as criaturas que você controla têm poder e resistência básicos X/X, sendo X o número de cards em sua mão.\', \'type\': \'Criatura Lendária — Humano Druida\', \'flavor\': \'"Os humanos só trazem sofrimento e engano. Eles não são bem-vindos na minha floresta."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487327&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'19dc22d6-d96b-4199-81d9-271878f67f72\', \'multiverseId\': 487327}, \'multiverseid\': 487327}, {\'name\': \'Джолраель, Отшельница Мвонвули\', \'text\': \'Каждый раз, когда вы берете вашу вторую карту в каждом ходу, создайте одну фишку существа 2/2 зеленая Кошка.\\n{4}{G}{G}: до конца хода существа под вашим контролем имеют базовую силу и выносливость X/X, где X — количество карт в вашей руке.\', \'type\': \'Легендарное Существо — Человек Друид\', \'flavor\': \'«Люди несут с собой лишь обман и страдания. Им не рады в моем лесу».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487586&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'28697e18-6818-475d-9dba-cbacf800f3cc\', \'multiverseId\': 487586}, \'multiverseid\': 487586}, {\'name\': \'木万弗黎隐士裘蕾尔\', \'text\': \'每当你抓每回合中你的第二张牌时，派出一个2/2绿色的猫衍生生物。\\n{4}{G}{G}：直到回合结束，由你操控的生物之基础力量与防御力为X/X，X为你的手牌数量。\', \'type\': \'传奇生物 ～人类／德鲁伊\', \'flavor\': \'「人类带来的只有苦难与欺瞒，别无他物。我的树林不欢迎他们。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487845&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'18ca3c60-d5fe-4dd8-a0e4-6b35c9f7fea2\', \'multiverseId\': 487845}, \'multiverseid\': 487845}, {\'name\': \'木萬弗黎隱士裘蕾爾\', \'text\': \'每當你抽每回合中你的第二張牌時，派出一個2/2綠色的貓衍生生物。\\n{4}{G}{G}：直到回合結束，由你操控的生物之基礎力量與防禦力為X/X，X為你的手牌數量。\', \'type\': \'傳奇生物 ～人類／德魯伊\', \'flavor\': \'「人類帶來的只有苦難與欺瞞，別無他物。我的樹林不歡迎他們。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488104&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'84ac305b-f811-4a9e-bb3e-8ccb68436e13\', \'multiverseId\': 488104}, \'multiverseid\': 488104}]', '[{\'name\': \'Jolraël, recluse de la Mwônvouli\', \'text\': "À chaque fois que vous piochez votre deuxième carte à chaque tour, créez un jeton de créature 2/2 verte Chat.\\n{4}{G}{G} : Jusqu\'à la fin du tour, les créatures que vous contrôlez ont une force et une endurance de base de X/X, X étant le nombre de cartes dans votre main.", \'type\': \'Créature légendaire : humain et druide\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488327&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'927da98c-ea9e-48a4-a5cf-9580be673b09\', \'multiverseId\': 488327}, \'multiverseid\': 488327}, {\'name\': \'ムウォンヴーリーの世捨て人、ジョルレイル\', \'text\': \'あなたが各ターンのあなたの２枚目のカードを引くたび、緑の２/２の猫・クリーチャー・トークンを１体生成する。\\n{4}{G}{G}：ターン終了時まで、あなたがコントロールしているクリーチャーの基本のパワーとタフネスはＸ/Ｘになる。Ｘはあなたの手札にあるカードの枚数に等しい。\', \'type\': \'伝説のクリーチャー — 人間・ドルイド\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488379&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fc6b6c9b-7034-4c9e-95e2-277d015c10b2\', \'multiverseId\': 488379}, \'multiverseid\': 488379}]', '[{\'name\': \'Kaervek der Boshafte\', \'text\': \'Andere Kreaturen erhalten -1/-1.\', \'type\': \'Legendäre Kreatur — Mensch, Hexenmeister\', \'flavor\': \'„Widersetze dich mir, und ich werde dein Fleisch von deinen Knochen brennen. Verrate mich, und ich werde dir deinen Atem stehlen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485688&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'df5a56b4-867e-4e81-8796-08f5b9330b49\', \'multiverseId\': 485688}, \'multiverseid\': 485688}, {\'name\': \'Kaervek, el rencoroso\', \'text\': \'Las otras criaturas obtienen -1/-1.\', \'type\': \'Criatura legendaria — Brujo humano\', \'flavor\': \'"Desafíame y quemaré la carne de tus huesos. Traicióname y robaré el aliento de tus pulmones".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485947&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'85019a11-15f7-442f-ae87-87f41779aa0b\', \'multiverseId\': 485947}, \'multiverseid\': 485947}, {\'name\': \'Kaervek, le malveillant\', \'text\': \'Les autres créatures gagnent -1/-1.\', \'type\': \'Créature légendaire : humain et psychagogue\', \'flavor\': "« Défie-moi et je brûlerai la chair sur tes os. Trahis-moi et je viderai tes poumons d\'air. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486206&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2c47f534-8b2e-4aa1-996b-1abe305d42cd\', \'multiverseId\': 486206}, \'multiverseid\': 486206}, {\'name\': "Kaervek, l\'Astioso", \'text\': \'Le altre creature prendono -1/-1.\', \'type\': \'Creatura Leggendaria — Warlock Umano\', \'flavor\': \'"Sfidami e brucerò via la carne dalle tue ossa. Tradiscimi e mi prenderò fino all\\\'ultimo filo d\\\'aria dai tuoi polmoni."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486465&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b6a4d2b7-8d99-4e30-814a-8975302aa48f\', \'multiverseId\': 486465}, \'multiverseid\': 486465}, {\'name\': \'悪意に満ちた者、ケアヴェク\', \'text\': \'他のクリーチャーは－１/－１の修整を受ける。\', \'type\': \'伝説のクリーチャー — 人間・邪術師\', \'flavor\': \'「わしの邪魔をすれば貴様の肉を芯から焼いてやろう。わしを裏切れば貴様の息の根を肺から止めてやろう。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486724&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'34b4b2ae-84f7-41d5-8b2e-cc2eb3be08a1\', \'multiverseId\': 486724}, \'multiverseid\': 486724}, {\'name\': \'악의를 품은 자, 케어벡\', \'text\': \'다른 생물들은 -1/-1을 받는다.\', \'type\': \'전설적 생물 — 인간 흑마법사\', \'flavor\': \'"나를 거역하면 네 뼈에 붙은 살을 모두 태워 버릴 것이다. 나를 배신하면 네 허파에서 숨을 빼앗을 것이다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486983&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b249ab32-82c5-4827-88f6-435a012562b9\', \'multiverseId\': 486983}, \'multiverseid\': 486983}, {\'name\': \'Kaervek, o Malévolo\', \'text\': \'As outras criaturas recebem -1/-1.\', \'type\': \'Criatura Lendária — Humano Bruxo\', \'flavor\': \'"Desafie-me, e eu arrancarei a fogo a carne de seus ossos. Traia-me, e eu tomarei o ar de seus pulmões."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487242&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6d14db98-8661-492d-ba18-bea7fc3e7d94\', \'multiverseId\': 487242}, \'multiverseid\': 487242}, {\'name\': \'Кайервек, Исполненный Злобы\', \'text\': \'Другие существа получают -1/-1.\', \'type\': \'Легендарное Существо — Человек Колдун\', \'flavor\': \'«Ослушайся меня, и я сожгу плоть на твоих костях. Предай меня, и я заберу дыхание из твоих легких».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487501&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a3e593aa-dd31-4c26-995e-2ccaec94a7e9\', \'multiverseId\': 487501}, \'multiverseid\': 487501}, {\'name\': \'怨忿者凯雷威克\', \'text\': \'其他生物得-1/-1。\', \'type\': \'传奇生物 ～人类／邪术师\', \'flavor\': \'「胆敢反抗我，我就会把你骨头上的血肉烧尽。胆敢背叛我，我就会把你双肺中的空气偷走。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487760&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f61d37a0-d2a0-46b3-b876-ec92fc61d6ae\', \'multiverseId\': 487760}, \'multiverseid\': 487760}, {\'name\': \'怨忿者凱雷威克\', \'text\': \'其他生物得-1/-1。\', \'type\': \'傳奇生物 ～人類／邪術師\', \'flavor\': \'「膽敢反抗我，我就會把你骨頭上的血肉燒盡。膽敢背叛我，我就會把你雙肺中的空氣偷走。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488019&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'47b15821-7afa-4f4a-b42d-9acbeaad04f5\', \'multiverseId\': 488019}, \'multiverseid\': 488019}]', "[{'name': 'Kaervek, le malveillant', 'text': 'Les autres créatures gagnent -1/-1.', 'type': 'Créature légendaire : humain et psychagogue', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488309&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ffc9af3c-4e02-4545-accd-da604237a0ae', 'multiverseId': 488309}, 'multiverseid': 488309}, {'name': '悪意に満ちた者、ケアヴェク', 'text': '他のクリーチャーは－１/－１の修整を受ける。', 'type': '伝説のクリーチャー — 人間・邪術師', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488361&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '80037650-c2be-4a57-8b85-23842cfdd85b', 'multiverseId': 488361}, 'multiverseid': 488361}]", '[{\'name\': \'Katzenherrscher\', \'text\': \'Andere Katzen, die du kontrollierst, erhalten +1/+1 und haben Schutz vor Hunden.\\nImmer wenn eine oder mehrere Katzen, die du kontrollierst, einem Spieler Kampfschaden zufügen, zerstöre bis zu ein Artefakt oder eine Verzauberung deiner Wahl, das bzw. die der Spieler kontrolliert.\', \'type\': \'Kreatur — Katze\', \'flavor\': \'Hunde betteln. Katzen erheben Anspruch.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485762&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ee026a3c-a343-4a5c-aafc-edde45a261bd\', \'multiverseId\': 485762}, \'multiverseid\': 485762}, {\'name\': \'Monarca felino\', \'text\': \'Los otros Felinos que controlas obtienen +1/+1 y tienen protección contra Perros.\\nSiempre que uno o más Felinos que controlas hagan daño de combate a un jugador, destruye hasta un artefacto o encantamiento objetivo que controla ese jugador.\', \'type\': \'Criatura — Felino\', \'flavor\': \'Los perros suplican. Los gatos reclaman.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486021&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5ada3a9b-ef1a-4f63-a628-1072fdb83a05\', \'multiverseId\': 486021}, \'multiverseid\': 486021}, {\'name\': \'Souverain félin\', \'text\': "Les autres chats que vous contrôlez gagnent +1/+1 et ont la protection contre les chiens.\\nÀ chaque fois qu\'au moins un chat que vous contrôlez inflige des blessures de combat à un joueur, détruisez jusqu\'à une cible, artefact ou enchantement, que ce joueur contrôle.", \'type\': \'Créature : chat\', \'flavor\': \'Les chiens supplient. Les chats revendiquent ce qui leur est dû.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486280&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c4a4fc18-e013-44e2-8947-9992f1b5a0b5\', \'multiverseId\': 486280}, \'multiverseid\': 486280}, {\'name\': \'Sovrano Felino\', \'text\': \'Gli altri Felini che controlli prendono +1/+1 e hanno protezione dai Canidi.\\nOgniqualvolta uno o più Felini che controlli infliggono danno da combattimento a un giocatore, distruggi fino a un artefatto o a un incantesimo bersaglio controllato da quel giocatore.\', \'type\': \'Creatura — Felino\', \'flavor\': \'I cani chiedono. I gatti avanzano pretese.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486539&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9be09f56-449f-4226-965c-cfe151bf5789\', \'multiverseId\': 486539}, \'multiverseid\': 486539}, {\'name\': \'猫の君主\', \'text\': \'他の、あなたがコントロールしている猫は＋１/＋１の修整を受けプロテクション（犬）を持つ。\\nあなたがコントロールしている猫１体以上がプレイヤー１人に戦闘ダメージを与えるたび、そのプレイヤーがコントロールしている、アーティファクトかエンチャント最大１つを対象とし、それを破壊する。\', \'type\': \'クリーチャー — 猫\', \'flavor\': \'犬は媚びる。猫は我が道を行く。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486798&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c6801f40-b0ed-4c51-add4-809ff3503f9a\', \'multiverseId\': 486798}, \'multiverseid\': 486798}, {\'name\': \'고양이 군주\', \'text\': \'당신이 조종하는 다른 고양이들은 +1/+1을 받고 개로부터 보호를 가진다.\\n당신이 조종하는 고양이 한 개 이상이 플레이어에게 전투피해를 입힐 때마다, 그 플레이어가 조종하는 마법물체 또는 부여마법을 최대 한 개까지 목표로 정한다. 그 목표를 파괴한다.\', \'type\': \'생물 — 고양이\', \'flavor\': \'개들은 구걸한다. 고양이들은 소유권을 주장한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487057&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'98b78c5a-de32-4680-8c37-558341506d6a\', \'multiverseId\': 487057}, \'multiverseid\': 487057}, {\'name\': \'Soberana Felina\', \'text\': \'Os outros Felinos que você controla recebem +1/+1 e têm proteção contra Cães.\\nToda vez que um ou mais Felinos que você controla causarem dano de combate a um jogador, destrua até um artefato ou encantamento alvo que aquele jogador controla.\', \'type\': \'Criatura — Felino\', \'flavor\': \'Os cães pedem. Os gatos reivindicam.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487316&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'086e3b4b-beca-4bbd-bde5-29f8f95f5384\', \'multiverseId\': 487316}, \'multiverseid\': 487316}, {\'name\': \'Царственная Кошка\', \'text\': \'Другие Кошки под вашим контролем получают +1/+1 и имеют Защиту от Собак.\\nКаждый раз, когда одна или более Кошек под вашим контролем наносят боевые повреждения игроку, уничтожьте не более одного целевого артефакта или чар под контролем того игрока.\', \'type\': \'Существо — Кошка\', \'flavor\': \'Собаки выпрашивают. Кошки заявляют о претензиях.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487575&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a935a470-f019-4d59-997e-081bbaba7dc5\', \'multiverseId\': 487575}, \'multiverseid\': 487575}, {\'name\': \'灵猫君王\', \'text\': \'由你操控的其他猫得+1/+1且具有反狗保护异能。\\n每当一个或数个由你操控的猫对任一牌手造成战斗伤害时，消灭至多一个目标由该牌手操控的神器或结界。\', \'type\': \'生物 ～猫\', \'flavor\': \'犬类求人施舍。猫类主动占有。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487834&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bd742d7f-e83a-4de0-a203-48f93faede3c\', \'multiverseId\': 487834}, \'multiverseid\': 487834}, {\'name\': \'靈貓君王\', \'text\': \'由你操控的其他貓得+1/+1且具有反狗保護異能。\\n每當一個或數個由你操控的貓對任一玩家造成戰鬥傷害時，消滅至多一個目標由該玩家操控的神器或結界。\', \'type\': \'生物 ～貓\', \'flavor\': \'犬類求人施捨。貓類主動佔有。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488093&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'90264502-3a5e-43bc-9ed6-f3da8368705d\', \'multiverseId\': 488093}, \'multiverseid\': 488093}]', '[{\'name\': \'Keralberg-Klosterschüler\', \'text\': \'Immer wenn du eine Loyalitätsfähigkeit eines Chandra-Planeswalkers aktivierst, fügen die Keralberg-Klosterschüler jedem Gegner 1 Schadenspunkt zu.\', \'type\': \'Kreatur — Mensch, Mönch\', \'flavor\': \'„Du setzt hier keinen Fuß hinein. Nicht, solange wir Wache stehen!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488660&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3d57a5a2-a896-47da-833e-db3d5950835b\', \'multiverseId\': 488660}, \'multiverseid\': 488660}, {\'name\': \'Discípulos de la Fortaleza Keral\', \'text\': \'Siempre que actives una habilidad de lealtad de un planeswalker Chandra, los Discípulos de la Fortaleza Keral hacen 1 punto de daño a cada oponente.\', \'type\': \'Criatura — Monje humano\', \'flavor\': \'"No pondrás un pie aquí. ¡No lo permitiremos!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488680&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0388feda-383e-4991-9a0d-06c506a645a4\', \'multiverseId\': 488680}, \'multiverseid\': 488680}, {\'name\': \'Disciples de la Forteresse de Keral\', \'text\': "À chaque fois que vous activez une capacité de loyauté d\'un planeswalker Chandra, les Disciples de la Forteresse de Keral infligent 1 blessure à chaque adversaire.", \'type\': \'Créature : humain et moine\', \'flavor\': \'« Vous ne poserez pas le pied en ces lieux. Pas tant que nous serons là ! »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488700&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6c3239ea-347e-489d-89de-c23e258537d3\', \'multiverseId\': 488700}, \'multiverseid\': 488700}, {\'name\': \'Discepoli del Torrione Keral\', \'text\': "Ogniqualvolta attivi un\'abilità di fedeltà di un planeswalker Chandra, i Discepoli del Torrione Keral infliggono 1 danno a ogni avversario.", \'type\': \'Creatura — Monaco Umano\', \'flavor\': \'"Qui non metterete piede. Non nel nostro turno di guardia!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488720&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7dbd7f9e-de66-48ac-a497-2e3b18e7c1a6\', \'multiverseId\': 488720}, \'multiverseid\': 488720}, {\'name\': \'ケラル砦の信奉者\', \'text\': \'あなたがチャンドラ・プレインズウォーカーの忠誠度能力を起動するたび、ケラル砦の信奉者は各対戦相手にそれぞれ１点のダメージを与える。\', \'type\': \'クリーチャー — 人間・モンク\', \'flavor\': \'「お前はここに足を踏み入れることはできない。我々が見張っている限りはな！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488740&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'aa61edbd-7d74-435d-95a1-525feaaa19f5\', \'multiverseId\': 488740}, \'multiverseid\': 488740}, {\'name\': \'케랄 요새 사도\', \'text\': \'당신의 찬드라 플레인즈워커의 충성 능력을 활성화할 때마다, 케랄 요새 사도는 각 상대에게 피해 1점을 입힌다.\', \'type\': \'생물 — 인간 승려\', \'flavor\': \'"이곳에 발을 들이게 두지 않겠다. 우리가 있는 한은!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488760&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b402ce19-f209-4e48-b43e-97d8954f1cb5\', \'multiverseId\': 488760}, \'multiverseid\': 488760}, {\'name\': \'Discípulos da Fortaleza Keral\', \'text\': \'Toda vez que você ativa uma habilidade de lealdade de uma planeswalker Chandra, Discípulos da Fortaleza Keral causa 1 ponto de dano a cada oponente.\', \'type\': \'Criatura — Humano Monge\', \'flavor\': \'"Você não porá os pés aqui. Não se depender de nós!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488780&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fd41cda7-c9f1-4629-9297-10e3692d1076\', \'multiverseId\': 488780}, \'multiverseid\': 488780}, {\'name\': \'Ученики из Крепости Керал\', \'text\': "Каждый раз, когда вы активируете способность верности planeswalker\'а Чандры, Ученики из Крепости Керал наносят 1 повреждение каждому оппоненту.", \'type\': \'Существо — Человек Монах\', \'flavor\': \'«Ты не пройдешь сюда, пока мы несем стражу».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488800&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a3e7098c-f508-4463-ac50-9b912f0c25ef\', \'multiverseId\': 488800}, \'multiverseid\': 488800}, {\'name\': \'科瑞尔要塞学徒\', \'text\': \'每当你起动茜卓鹏洛客的忠诚异能时，科瑞尔要塞学徒向每位对手各造成1点伤害。\', \'type\': \'生物 ～人类／修行僧\', \'flavor\': \'「你不得踏足此处。我们会看着！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488820&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b5130556-ad61-4512-b812-de3652c4636e\', \'multiverseId\': 488820}, \'multiverseid\': 488820}, {\'name\': \'科瑞爾要塞學徒\', \'text\': \'每當你起動茜卓鵬洛客的忠誠異能時，科瑞爾要塞學徒向每位對手各造成1點傷害。\', \'type\': \'生物 ～人類／修行僧\', \'flavor\': \'「你不得踏足此處。我們會看著！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488840&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2b023633-c09a-49bf-a430-ce055e958309\', \'multiverseId\': 488840}, \'multiverseid\': 488840}]', '[{\'name\': \'Kinetische Augurin\', \'text\': \'Verursacht Trampelschaden (Diese Kreatur kann überschüssigen Kampfschaden dem verteidigenden Spieler oder Planeswalker zufügen.)\\nDie Stärke der Kinetischen Augurin ist gleich der Anzahl an Spontanzauber- und Hexereikarten in deinem Friedhof.\\nWenn die Kinetische Augurin ins Spiel kommt, wirf bis zu zwei Karten ab und ziehe dann entsprechend viele Karten.\', \'type\': \'Kreatur — Mensch, Schamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485736&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a2dee691-e575-4591-80dc-9b8b5ff249db\', \'multiverseId\': 485736}, \'multiverseid\': 485736}, {\'name\': \'Augur cinética\', \'text\': \'Arrolla. (Esta criatura puede hacer el daño de combate sobrante al jugador o planeswalker al que ataca.)\\nLa fuerza de la Augur cinética es igual a la cantidad de cartas de instantáneo y de conjuro en tu cementerio.\\nCuando la Augur cinética entre al campo de batalla, descarta hasta dos cartas, luego roba esa misma cantidad de cartas.\', \'type\': \'Criatura — Chamán humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485995&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'78499b31-bb1d-41a5-9a7d-dfa4437ed966\', \'multiverseId\': 485995}, \'multiverseid\': 485995}, {\'name\': \'Augure cinétique\', \'text\': "Piétinement (Cette créature peut infliger son surplus de blessures de combat au joueur ou au planeswalker qu\'elle attaque.)\\nLa force de l\'Augure cinétique est égale au nombre de cartes d\'éphémère et de rituel dans votre cimetière.\\nQuand l\'Augure cinétique arrive sur le champ de bataille, défaussez-vous de jusqu\'à deux cartes, puis piochez autant de cartes.", \'type\': \'Créature : humain et shamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486254&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'95b2f7ec-d214-4e7c-a0f7-1e715c8b5999\', \'multiverseId\': 486254}, \'multiverseid\': 486254}, {\'name\': \'Augure Cinetica\', \'text\': "Travolgere (Questa creatura può infliggere il danno da combattimento in eccesso al giocatore o al planeswalker che sta attaccando.)\\nLa forza dell\'Augure Cinetica è pari al numero di carte istantaneo e stregoneria nel tuo cimitero.\\nQuando l\'Augure Cinetica entra nel campo di battaglia, scarta fino a due carte, poi pesca altrettante carte.", \'type\': \'Creatura — Sciamano Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486513&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'da41fc4e-b74d-4778-b0d8-083b86c5616e\', \'multiverseId\': 486513}, \'multiverseid\': 486513}, {\'name\': \'動態の占い師\', \'text\': \'トランプル（このクリーチャーは余剰の戦闘ダメージを、これが攻撃しているプレイヤーかプレインズウォーカーに与えることができる。）\\n動態の占い師のパワーは、あなたの墓地にありインスタントやソーサリーであるカードの枚数に等しい。\\n動態の占い師が戦場に出たとき、カード最大２枚を捨て、その後その枚数に等しい枚数のカードを引く。\', \'type\': \'クリーチャー — 人間・シャーマン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486772&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9d09036b-b65c-42f4-825f-56275325422f\', \'multiverseId\': 486772}, \'multiverseid\': 486772}, {\'name\': \'운동을 읽는 예언가\', \'text\': \'돌진 (이 생물은 여분의 전투피해를 공격 중인 플레이어 또는 플레인즈워커에게 입힐 수 있다.)\\n운동을 읽는 예언가의 공격력은 당신의 무덤에 있는 순간마법과 집중마법 카드의 수의 합과 같다.\\n운동을 읽는 예언가가 전장에 들어올 때, 카드를 최대 두 장까지 버린 후, 그만큼 카드를 뽑는다.\', \'type\': \'생물 — 인간 주술사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487031&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a17a4964-6083-46be-8f91-24d011df7744\', \'multiverseId\': 487031}, \'multiverseid\': 487031}, {\'name\': \'Áugure Cinética\', \'text\': \'Atropelar (Esta criatura pode causar seu dano de combate excedente ao jogador ou planeswalker que ela estiver atacando.)\\nO poder de Áugure Cinética é igual ao número de cards de mágica instantânea e feitiço em seu cemitério.\\nQuando Áugure Cinética entrar no campo de batalha, descarte até dois cards e depois compre aquela quantidade de cards.\', \'type\': \'Criatura — Humano Xamã\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487290&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8822ab5e-f640-4869-91cd-2add8ad1b9b1\', \'multiverseId\': 487290}, \'multiverseid\': 487290}, {\'name\': \'Предсказательница Движения\', \'text\': "Пробивной удар (Это существо может нанести избыточные боевые повреждения игроку или planeswalker\'у, которого атакует.)\\nСила Предсказательницы Движения равна количеству карт мгновенных заклинаний и волшебства на вашем кладбище.\\nКогда Предсказательница Движения выходит на поле битвы, сбросьте не более двух карт, затем возьмите такое же количество карт.", \'type\': \'Существо — Человек Шаман\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487549&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2443b125-2deb-4cfd-9297-fafbcf2e8a25\', \'multiverseId\': 487549}, \'multiverseid\': 487549}, {\'name\': \'跃动卜算师\', \'text\': \'践踏（此生物造成之过量战斗伤害能对所攻击的牌手或鹏洛客造成之。）\\n跃动卜算师的力量等同于你坟墓场中瞬间与法术牌的数量加总。\\n当跃动卜算师进战场时，弃至多两张牌，然后抓等量的牌。\', \'type\': \'生物 ～人类／祭师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487808&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'87e26d70-fa68-4f42-aecc-262a26632c14\', \'multiverseId\': 487808}, \'multiverseid\': 487808}, {\'name\': \'躍動卜算師\', \'text\': \'踐踏（此生物造成之過量戰鬥傷害能對所攻擊的玩家或鵬洛客造成之。）\\n躍動卜算師的力量等同於你墳墓場中瞬間與巫術牌的數量加總。\\n當躍動卜算師進戰場時，棄至多兩張牌，然後抽等量的牌。\', \'type\': \'生物 ～人類／祭師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488067&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e5c6b94c-53dd-458b-aa9f-7ccfdf8e9a62\', \'multiverseId\': 488067}, \'multiverseid\': 488067}]', '[{\'name\': \'Knochengruben-Rohling\', \'text\': \'Bedrohlich (Diese Kreatur kann nicht geblockt werden, außer von zwei oder mehr Kreaturen.)\\nWenn der Knochengruben-Rohling ins Spiel kommt, erhält eine Kreatur deiner Wahl +4/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Zyklop\', \'flavor\': \'Seine Keule macht eine große Beule.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485714&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9af56397-3a68-455d-aa92-8dffd72a3196\', \'multiverseId\': 485714}, \'multiverseid\': 485714}, {\'name\': \'Bruto del pozo de los huesos\', \'text\': \'Amenaza. (Esta criatura no puede ser bloqueada excepto por dos o más criaturas.)\\nCuando el Bruto del pozo de los huesos entre al campo de batalla, la criatura objetivo obtiene +4/+0 hasta el final del turno.\', \'type\': \'Criatura — Cíclope\', \'flavor\': \'No seas tan basto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485973&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'06fd25a7-f60b-41e5-a679-5562da84c555\', \'multiverseId\': 485973}, \'multiverseid\': 485973}, {\'name\': \'Brute de la fosse aux ossements\', \'text\': "Menace (Cette créature ne peut pas être bloquée excepté par deux créatures ou plus.)\\nQuand la Brute de la fosse aux ossements arrive sur le champ de bataille, la créature ciblée gagne +4/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : cyclope\', \'flavor\': \'Bienvenue au club.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486232&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'69225138-7c33-45ce-8dda-220138af9f24\', \'multiverseId\': 486232}, \'multiverseid\': 486232}, {\'name\': "Bruto del Pozzo d\'Ossa", \'text\': "Minacciare (Questa creatura non può essere bloccata tranne che da due o più creature.)\\nQuando il Bruto del Pozzo d\'Ossa entra nel campo di battaglia, una creatura bersaglio prende +4/+0 fino alla fine del turno.", \'type\': \'Creatura — Ciclope\', \'flavor\': \'Benvenuto, con me ti farai le ossa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486491&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6cfe8287-e405-402a-a066-9e3d2d6b7a23\', \'multiverseId\': 486491}, \'multiverseid\': 486491}, {\'name\': \'骨穴の粗暴者\', \'text\': \'威迫（このクリーチャーは２体以上のクリーチャーによってしかブロックされない。）\\n骨穴の粗暴者が戦場に出たとき、クリーチャー１体を対象とする。ターン終了時まで、それは＋４/＋０の修整を受ける。\', \'type\': \'クリーチャー — サイクロプス\', \'flavor\': \'クラブへようこそ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486750&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5476bc75-d6c6-4c0c-85da-44fa4bd6314a\', \'multiverseId\': 486750}, \'multiverseid\': 486750}, {\'name\': \'뼈 구덩이 싸움꾼\', \'text\': \'호전적 (이 생물은 두 개 이상의 생물에만 방어될 수 있다.)\\n뼈 구덩이 싸움꾼이 전장에 들어올 때, 생물을 목표로 정한다. 그 생물은 턴종료까지 +4/+0을 받는다.\', \'type\': \'생물 — 키클롭스\', \'flavor\': \'골 때릴 시간이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487009&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'aa04e21b-8188-407d-a8ee-402108e2ef6b\', \'multiverseId\': 487009}, \'multiverseid\': 487009}, {\'name\': \'Bruto do Poço dos Ossos\', \'text\': \'Ameaçar (Esta criatura só pode ser bloqueada por duas ou mais criaturas.)\\nQuando Bruto do Poço dos Ossos entra no campo de batalha, a criatura alvo recebe +4/+0 até o final do turno.\', \'type\': \'Criatura — Ciclope\', \'flavor\': \'Bem-vindo ao clube.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487268&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5cffdb58-88db-4403-94fa-3b53aaccbe9d\', \'multiverseId\': 487268}, \'multiverseid\': 487268}, {\'name\': \'Громила Костяной Ямы\', \'text\': \'Угроза (Это существо не может быть заблокировано менее чем двумя существами.)\\nКогда Громила Костяной Ямы выходит на поле битвы, целевое существо получает +4/+0 до конца хода.\', \'type\': \'Существо — Циклоп\', \'flavor\': \'Не дубина красит циклопа.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487527&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5b3b3b98-18a1-4185-bbea-4222d295783d\', \'multiverseId\': 487527}, \'multiverseid\': 487527}, {\'name\': \'骨坑蛮汉\', \'text\': \'威慑（此生物只能被两个或更多生物阻挡。）\\n当骨坑蛮汉进战场时，目标生物得+4/+0直到回合结束。\', \'type\': \'生物 ～独眼巨人\', \'flavor\': \'欢迎来到棍子吧。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487786&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'aa795ad2-a0dd-45b7-9b9a-23f962467f75\', \'multiverseId\': 487786}, \'multiverseid\': 487786}, {\'name\': \'骨坑蠻漢\', \'text\': \'威懾（此生物只能被兩個或更多生物阻擋。）\\n當骨坑蠻漢進戰場時，目標生物得+4/+0直到回合結束。\', \'type\': \'生物 ～獨眼巨人\', \'flavor\': \'歡迎來到棍子吧。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488045&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'082b56b4-8173-4f96-adba-d4f41a081b0a\', \'multiverseId\': 488045}, \'multiverseid\': 488045}]', '[{\'name\': \'Knorrenfaust-Eiche\', \'text\': \'Immer wenn du eine Karte ziehst, erhält die Knorrenfaust-Eiche +2/+2 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Baumhirte\', \'flavor\': \'Wenn ein Baum dich im Wald umhaut und niemand in der Nähe ist, der es hört, ist „macht es Geräusche" das Letzte, worüber du dir Sorgen machen musst.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485756&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3d826725-c0eb-482c-acbf-47021329d5e8\', \'multiverseId\': 485756}, \'multiverseid\': 485756}, {\'name\': \'Roble puñolobanillo\', \'text\': \'Siempre que robes una carta, el Roble puñolobanillo obtiene +2/+2 hasta el final del turno.\', \'type\': \'Criatura — Pueblo-arbóreo\', \'flavor\': \'Si un árbol te derriba en el bosque y no hay nadie cerca para oírlo, que esté haciendo ruido es lo último que debería preocuparte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486015&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'317b702a-04f2-4c9d-a038-4a8c0d199b5c\', \'multiverseId\': 486015}, \'multiverseid\': 486015}, {\'name\': \'Chêne aux poings noueux\', \'text\': "À chaque fois que vous piochez une carte, le Chêne aux poings noueux gagne +2/+2 jusqu\'à la fin du tour.", \'type\': \'Créature : sylvin\', \'flavor\': "Si un arbre vous abat dans la forêt et que personne ne peut l\'entendre, savoir si cela fait du bruit sera bien le dernier de vos soucis.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486274&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fa7f485c-3f86-4d3a-aee0-de5a99ecfda0\', \'multiverseId\': 486274}, \'multiverseid\': 486274}, {\'name\': \'Quercia Pugno Nodoso\', \'text\': \'Ogniqualvolta peschi una carta, la Quercia Pugno Nodoso prende +2/+2 fino alla fine del turno.\', \'type\': \'Creatura — Silvantropo\', \'flavor\': \'Se un albero si abbatte su di te nella foresta e non c\\\'è nessuno nei paraggi, sapere "se faccia rumore" sarà l\\\'ultima delle tue preoccupazioni.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486533&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5a22d1b8-0d63-476e-b9e8-902f91239f96\', \'multiverseId\': 486533}, \'multiverseid\': 486533}, {\'name\': \'節くれ拳の樫\', \'text\': \'あなたがカードを１枚引くたび、ターン終了時まで、節くれ拳の樫は＋２/＋２の修整を受ける。\', \'type\': \'クリーチャー — ツリーフォーク\', \'flavor\': \'誰もいない森の中で木に倒されたら、「それは音を立てるのか？」と考える必要はない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486792&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c412be8a-c2fd-4ba4-8760-53cc095becc0\', \'multiverseId\': 486792}, \'multiverseid\': 486792}, {\'name\': \'옹이주먹 떡갈나무\', \'text\': \'당신이 카드를 뽑을 때마다, 옹이주먹 떡갈나무는 턴종료까지 +2/+2를 받는다.\', \'type\': \'생물 — 인목\', \'flavor\': \'숲에서 나무가 당신의 위로 떨어지고 주변에는 아무도 그 소리를 들을 사람이 없다면, "그게 소리가 난 것일까"는 당신이 가장 나중에 걱정해도 될 일이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487051&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7d2d178a-90c8-4515-83eb-ded78fe96b61\', \'multiverseId\': 487051}, \'multiverseid\': 487051}, {\'name\': \'Carvalho Punho Nodoso\', \'text\': \'Toda vez que você compra um card, Carvalho Punho Nodoso recebe +2/+2 até o final do turno.\', \'type\': \'Criatura — Ent\', \'flavor\': \'Se uma árvore derruba você numa floresta e não há ninguém por perto para ouvir, saber se fez barulho ou não é a última das suas preocupações.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487310&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'17fbef18-556a-4650-85c5-ee911630fd0a\', \'multiverseId\': 487310}, \'multiverseid\': 487310}, {\'name\': \'Дуб Кряжистого Кулака\', \'text\': \'Каждый раз, когда вы берете карту, Дуб Кряжистого Кулака получает +2/+2 до конца хода.\', \'type\': \'Существо — Лесовик\', \'flavor\': \'Если дерево валит тебя с ног в лесу, а рядом нет никого, кто это услышал бы, то «издает ли оно звук» — это последнее, о чем стоит волноваться.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487569&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2383f98a-c290-4e4e-9860-a7e6b6a6d8c5\', \'multiverseId\': 487569}, \'multiverseid\': 487569}, {\'name\': \'瘤拳橡树\', \'text\': \'每当你抓一张牌时，瘤拳橡树得+2/+2直到回合结束。\', \'type\': \'生物 ～树妖\', \'flavor\': \'如果你在森林中被树木击倒，而周围又没人听到，你恐怕都没有时间去思考「树这么动到底会不会出声」这件事。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487828&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'51beaa7d-4336-4f44-beb1-2dac6a54bfc1\', \'multiverseId\': 487828}, \'multiverseid\': 487828}, {\'name\': \'瘤拳橡樹\', \'text\': \'每當你抽一張牌時，瘤拳橡樹得+2/+2直到回合結束。\', \'type\': \'生物 ～樹妖\', \'flavor\': \'如果你在森林中被樹木擊倒，而周圍又沒人聽到，你恐怕都沒有時間去思考「樹這麼動到底會不會出聲」這件事。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488087&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'80de2b59-d2fc-4ed7-bd62-623dda4e04eb\', \'multiverseId\': 488087}, \'multiverseid\': 488087}]', '[{\'name\': \'Knorriger Weiser\', \'text\': \'Reichweite (Diese Kreatur kann fliegende Kreaturen blocken.)\\nSolange du in diesem Zug zwei oder mehr Karten gezogen hast, erhält der Knorrige Weise +0/+2 und hat Wachsamkeit. (Er wird beim Angreifen nicht getappt.)\', \'type\': \'Kreatur — Baumhirte, Druide\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485769&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'537ccca7-e377-458d-a303-3c50deece9dd\', \'multiverseId\': 485769}, \'multiverseid\': 485769}, {\'name\': \'Sabio nudoso\', \'text\': \'Alcance. (Esta criatura puede bloquear criaturas con la habilidad de volar.)\\nMientras hayas robado dos o más cartas este turno, el Sabio nudoso obtiene +0/+2 y tiene la habilidad de vigilancia. (Esta criatura no se gira al atacar.)\', \'type\': \'Criatura — Druida pueblo-arbóreo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486028&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'71ea33b9-6406-4df8-b6d0-c940d5a7a64d\', \'multiverseId\': 486028}, \'multiverseid\': 486028}, {\'name\': \'Sage noueux\', \'text\': "Portée (Cette créature peut bloquer les créatures avec le vol.)\\nTant que vous avez pioché au moins deux cartes ce tour-ci, le Sage noueux gagne +0/+2 et a la vigilance. (Attaquer avec cette créature ne la fait pas s\'engager.)", \'type\': \'Créature : sylvin et druide\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486287&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'709fc043-1406-440d-bdf0-87e8e18b879b\', \'multiverseId\': 486287}, \'multiverseid\': 486287}, {\'name\': \'Saggio Ritorto\', \'text\': \'Raggiungere (Questa creatura può bloccare le creature con volare.)\\nSe hai pescato due o più carte in questo turno, il Saggio Ritorto prende +0/+2 e ha cautela. (Attacca senza TAPpare.)\', \'type\': \'Creatura — Druido Silvantropo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486546&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1e86a9c8-594b-4f60-8a5f-ced3c8f199d0\', \'multiverseId\': 486546}, \'multiverseid\': 486546}, {\'name\': \'節くれの賢者\', \'text\': \'到達（このクリーチャーは飛行を持つクリーチャーをブロックできる。）\\nこのターンにあなたがカードを２枚以上引いているかぎり、節くれの賢者は＋０/＋２の修整を受け警戒を持つ。（これは攻撃してもタップしない。）\', \'type\': \'クリーチャー — ツリーフォーク・ドルイド\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486805&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b2e8c191-d7e8-4432-b085-f8d2bf09f948\', \'multiverseId\': 486805}, \'multiverseid\': 486805}, {\'name\': \'뒤틀린 현자\', \'text\': \'대공 (이 생물은 비행을 가진 생물을 방어할 수 있다.)\\n당신이 이번 턴에 카드를 두 장 이상 뽑은 한, 뒤틀린 현자는 +0/+2를 받고 경계를 가진다. (이 생물은 공격하면서 탭되지 않는다.)\', \'type\': \'생물 — 인목 드루이드\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487064&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e202fc8f-0e82-45f0-a973-60876dbe336e\', \'multiverseId\': 487064}, \'multiverseid\': 487064}, {\'name\': \'Sábio Nodoso\', \'text\': \'Alcance (Esta criatura pode bloquear criaturas com voar.)\\nContanto que você tenha comprado dois ou mais cards neste turno, Sábio Nodoso recebe +0/+2 e tem vigilância. (Esta criatura não é virada para atacar.)\', \'type\': \'Criatura — Ent Druida\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487323&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ccb2e19c-e0f4-41a3-8a2a-12f824ed4fc5\', \'multiverseId\': 487323}, \'multiverseid\': 487323}, {\'name\': \'Узловатый Мудрец\', \'text\': \'Захват (Это существо может блокировать существа с Полетом.)\\nУзловатый Мудрец получает +0/+2 и имеет Бдительность при условии, что в этом ходу вы уже взяли не менее двух карт. (Атакуя, он не поворачивается.)\', \'type\': \'Существо — Лесовик Друид\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487582&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'883bdb6a-e6b4-47b4-b68d-df5300b493b1\', \'multiverseId\': 487582}, \'multiverseid\': 487582}, {\'name\': \'糙节智者\', \'text\': \'延势（此生物能阻挡具飞行异能的生物。）\\n只要你本回合中已抓两张或更多牌，糙节智者便得+0/+2且具有警戒异能。（它攻击时不需横置。）\', \'type\': \'生物 ～树妖／德鲁伊\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487841&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e7bcf14e-a1a6-4ec7-b0b3-34bb6f7755d7\', \'multiverseId\': 487841}, \'multiverseid\': 487841}, {\'name\': \'糙節智者\', \'text\': \'延勢（此生物能阻擋具飛行異能的生物。）\\n只要你本回合中已抽兩張或更多牌，糙節智者便得+0/+2且具有警戒異能。（它攻擊時不需橫置。）\', \'type\': \'生物 ～樹妖／德魯伊\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488100&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fc7e113f-f7c4-49a4-973e-c4492c332efb\', \'multiverseId\': 488100}, \'multiverseid\': 488100}]', '[{\'name\': \'Kolossales Schreckensmaul\', \'text\': \'Verursacht Trampelschaden (Diese Kreatur kann überschüssigen Kampfschaden dem verteidigenden Spieler oder Planeswalker zufügen.)\', \'type\': \'Kreatur — Dinosaurier\', \'flavor\': \'Wenn die Erde bebt, lauf. Wenn du sein Gebrüll vernimmst, flieh. Wenn du in sein Maul starrst, zu spät …\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485758&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a27b71fd-0f11-4467-88d9-fdbe289ac54d\', \'multiverseId\': 485758}, \'multiverseid\': 485758}, {\'name\': \'Fauces pavorosas colosal\', \'text\': \'Arrolla. (Esta criatura puede hacer el daño de combate sobrante al jugador o planeswalker al que ataca.)\', \'type\': \'Criatura — Dinosaurio\', \'flavor\': \'Si sientes que la tierra se mueve, corre. Si escuchas su rugido, huye. Si le ves los dientes... ya es demasiado tarde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486017&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1b1d20b5-d3b7-4f00-bf9e-65f9b8905b53\', \'multiverseId\': 486017}, \'multiverseid\': 486017}, {\'name\': \'Gueuleffroi colossal\', \'text\': "Piétinement (Cette créature peut infliger son surplus de blessures de combat au joueur ou au planeswalker qu\'elle attaque.)", \'type\': \'Créature : dinosaure\', \'flavor\': "Si vous sentez la terre trembler, courez. Si vous entendez son cri, fuyez. Si vous voyez ses dents, c\'est qu\'il est déjà trop tard.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486276&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'23ac7397-4c14-4a70-9b37-29dbc118dff8\', \'multiverseId\': 486276}, \'multiverseid\': 486276}, {\'name\': \'Fauce del Terrore Colossale\', \'text\': \'Travolgere (Questa creatura può infliggere il danno da combattimento in eccesso al giocatore o al planeswalker che sta attaccando.)\', \'type\': \'Creatura — Dinosauro\', \'flavor\': \'Se avverti il terreno tremare, corri. Se senti il suo ruggito, scappa. Se ne vedi i denti, è troppo tardi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486535&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'40b03c4d-9f47-4b7e-8fc2-02b371b06541\', \'multiverseId\': 486535}, \'multiverseid\': 486535}, {\'name\': \'巨大な戦慄大口\', \'text\': \'トランプル（このクリーチャーは余剰の戦闘ダメージを、これが攻撃しているプレイヤーかプレインズウォーカーに与えることができる。）\', \'type\': \'クリーチャー — 恐竜\', \'flavor\': \'大地の揺れを感じたら、逃げろ。鳴き声が聞こえたら、とにかく逃げろ。歯が見えたら、手遅れだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486794&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'083e43ad-27bc-4840-9cf7-9cf617155430\', \'multiverseId\': 486794}, \'multiverseid\': 486794}, {\'name\': \'거대한 공포턱\', \'text\': \'돌진 (이 생물은 여분의 전투피해를 공격 중인 플레이어 또는 플레인즈워커에게 입힐 수 있다.)\', \'type\': \'생물 — 공룡\', \'flavor\': \'땅의 흔들림이 느껴지면, 도망쳐라. 녀석이 울부짖는 소리가 들리면, 달아나라. 녀석의 이빨이 보인다면, 이미 늦었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487053&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a1c433d1-fbea-4e51-81d8-90a62aff0d06\', \'multiverseId\': 487053}, \'multiverseid\': 487053}, {\'name\': \'Bocarra Sinistra Colossal\', \'text\': \'Atropelar (Esta criatura pode causar seu dano de combate excedente ao jogador ou planeswalker que ela estiver atacando.)\', \'type\': \'Criatura — Dinossauro\', \'flavor\': \'Se sentir o chão tremer, corra. Se ouvir seu urro, fuja. Se vir seus dentes, é tarde demais.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487312&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2f79627d-c2ee-403f-ae36-1b14bf3d3e69\', \'multiverseId\': 487312}, \'multiverseid\': 487312}, {\'name\': \'Исполинский Смертеглот\', \'text\': "Пробивной удар (Это существо может нанести избыточные боевые повреждения игроку или planeswalker\'у, которого атакует.)", \'type\': \'Существо — Динозавр\', \'flavor\': \'Если чувствуешь, как трясется земля, беги. Если слышишь, как он ревет, спасайся. Если видишь его зубы — уже слишком поздно.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487571&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ee05eac4-f37c-4986-aa5e-c3bbeb98d236\', \'multiverseId\': 487571}, \'multiverseid\': 487571}, {\'name\': \'庞巨血口龙\', \'text\': \'践踏（此生物造成之过量战斗伤害能对所攻击的牌手或鹏洛客造成之。）\', \'type\': \'生物 ～恐龙\', \'flavor\': \'如果你感到大地震颤，快跑。如果你听到吼声咆哮，快逃。如果你看到利齿现形，晚了。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487830&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4ddeee52-d98b-46e5-aff5-a83f0a2db99e\', \'multiverseId\': 487830}, \'multiverseid\': 487830}, {\'name\': \'龐巨血口龍\', \'text\': \'踐踏（此生物造成之過量戰鬥傷害能對所攻擊的玩家或鵬洛客造成之。）\', \'type\': \'生物 ～恐龍\', \'flavor\': \'如果你感到大地震顫，快跑。如果你聽到吼聲咆哮，快逃。如果你看到利齒現形，晚了。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488089&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'cd8f2fd1-2a30-445e-a6af-2546d6fe6283\', \'multiverseId\': 488089}, \'multiverseid\': 488089}]', '[{\'name\': \'Konklave-Mentorin\', \'text\': \'Falls eine oder mehrere +1/+1-Marken auf eine Kreatur gelegt würden, die du kontrollierst, werden stattdessen so viele plus eine +1/+1-Marken auf die Kreatur gelegt.\\nWenn die Konklave-Mentorin stirbt, erhältst du Lebenspunkte in Höhe ihrer Stärke dazu.\', \'type\': \'Kreatur — Zentaur, Kleriker\', \'flavor\': \'„Ich habe vollstes Vertrauen in deine Fähigkeiten."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485798&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1fb36bc5-a6ec-43b7-97d3-3eece95088da\', \'multiverseId\': 485798}, \'multiverseid\': 485798}, {\'name\': \'Mentora del Cónclave\', \'text\': \'Si fueran a ponerse uno o más contadores +1/+1 sobre una criatura que controlas, en vez de eso, se pone esa misma cantidad de contadores +1/+1 más uno sobre esa criatura.\\nCuando la Mentora del Cónclave muera, ganas una cantidad de vidas igual a su fuerza.\', \'type\': \'Criatura — Clérigo centauro\', \'flavor\': \'"Confío en tu potencial".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486057&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a33205df-f7f1-4acf-b0bb-1603aff1d7b4\', \'multiverseId\': 486057}, \'multiverseid\': 486057}, {\'name\': \'Mentor du Conclave\', \'text\': \'Si au moins un marqueur +1/+1 devait être mis sur une créature que vous contrôlez, autant de marqueurs +1/+1 plus un sont mis sur cette créature à la place.\\nQuand la Mentor du Conclave meurt, vous gagnez un nombre de points de vie égal à sa force.\', \'type\': \'Créature : centaure et clerc\', \'flavor\': \'« Je crois en toi. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486316&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3ad581bc-bd9c-4295-9f9e-5a8ba6cd8a12\', \'multiverseId\': 486316}, \'multiverseid\': 486316}, {\'name\': \'Mentore del Conclave\', \'text\': \'Se uno o più segnalini +1/+1 stanno per essere messi su una creatura che controlli, mettine invece uno in più su quella creatura.\\nQuando il Mentore del Conclave muore, guadagni punti vita pari alla sua forza.\', \'type\': \'Creatura — Chierico Centauro\', \'flavor\': \'"Ho fiducia nel tuo potenziale."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486575&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c79397db-59d9-4ee8-b903-abdf60f7bbe4\', \'multiverseId\': 486575}, \'multiverseid\': 486575}, {\'name\': \'議事会の導師\', \'text\': \'あなたがコントロールしているクリーチャー１体の上に＋１/＋１カウンターが１個以上置かれるなら、代わりにそのクリーチャーの上に、その数に１を足した数の＋１/＋１カウンターを置く。\\n議事会の導師が死亡したとき、あなたはそれのパワーに等しい点数のライフを得る。\', \'type\': \'クリーチャー — ケンタウルス・クレリック\', \'flavor\': \'「私はあなたの可能性を信じています。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486834&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'365fbb91-e702-4860-9659-96ed1c5b828e\', \'multiverseId\': 486834}, \'multiverseid\': 486834}, {\'name\': \'교단의 스승\', \'text\': \'당신이 조종하는 생물에 +1/+1 카운터가 한 개 이상 놓이려 한다면, 대신 그 생물에 그 숫자에 한 개를 더한 만큼의 +1/+1 카운터를 놓는다.\\n교단의 스승이 죽을 때, 당신은 교단의 스승의 공격력만큼 생명점을 얻는다.\', \'type\': \'생물 — 켄타우로스 성직자\', \'flavor\': \'"나는 네 가능성을 믿고 있단다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487093&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'17b073d2-73e6-416b-b96f-089fb95addbf\', \'multiverseId\': 487093}, \'multiverseid\': 487093}, {\'name\': \'Mentora do Conclave\', \'text\': \'Se um ou mais marcadores +1/+1 seriam colocados em uma criatura que você controla, em vez disso, serão colocados naquela criatura aquele número mais um de marcadores +1/+1.\\nQuando Mentora do Conclave morre, você ganha uma quantidade de pontos de vida igual ao seu poder.\', \'type\': \'Criatura — Centauro Clérigo\', \'flavor\': \'"Tenho fé no seu potencial."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487352&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'185bcd17-83a2-4f47-9064-a8c2bcd931f1\', \'multiverseId\': 487352}, \'multiverseid\': 487352}, {\'name\': \'Наставница Конклава\', \'text\': \'Если на существо под вашим контролем должны быть положены один или более жетонов +1/+1, вместо этого на то существо кладется столько же плюс один жетон +1/+1.\\nКогда Наставница Конклава умирает, вы получаете количество жизней, равное ее силе.\', \'type\': \'Существо — Кентавр Священник\', \'flavor\': \'«Я верю в твой потенциал».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487611&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c78a5b74-aec7-4bf4-8e2e-753d3e2bc00d\', \'multiverseId\': 487611}, \'multiverseid\': 487611}, {\'name\': \'盟会导师\', \'text\': \'如果将会在一个由你操控的生物上放置一个或数个+1/+1指示物，则改为在该生物上放置该数量加一的+1/+1指示物。\\n当盟会导师死去时，你获得等同于其力量的生命。\', \'type\': \'生物 ～半人马／僧侣\', \'flavor\': \'「我相信你的潜能。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487870&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5d11d3a6-01de-46a2-af46-821a787ad6d3\', \'multiverseId\': 487870}, \'multiverseid\': 487870}, {\'name\': \'盟會導師\', \'text\': \'如果將會在一個由你操控的生物上放置一個或數個+1/+1指示物，則改為在該生物上放置該數量加一的+1/+1指示物。\\n當盟會導師死去時，你獲得等同於其力量的生命。\', \'type\': \'生物 ～半人馬／僧侶\', \'flavor\': \'「我相信你的潛能。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488129&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8d276466-9f2d-4d1b-9aca-c86b6036f0f1\', \'multiverseId\': 488129}, \'multiverseid\': 488129}]', '[{\'name\': \'Kryptenlauerer\', \'text\': \'Wenn der Kryptenlauerer ins Spiel kommt, kannst du eine Kreatur opfern oder eine Kreaturenkarte abwerfen. Falls du dies tust, ziehe eine Karte.\', \'type\': \'Kreatur — Schrecken\', \'flavor\': \'„Selbst die Ratten setzen keinen Fuß hinein. Ich fürchte mich vor dem, was da drinnen lauern könnte."\\n—Tagebuch eines Totengräbers\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485675&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9a90f128-e31c-4965-8d85-fcdb709f9786\', \'multiverseId\': 485675}, \'multiverseid\': 485675}, {\'name\': \'Acechador de la cripta\', \'text\': \'Cuando el Acechador de la cripta entre al campo de batalla, puedes sacrificar una criatura o descartar una carta de criatura. Si lo haces, roba una carta.\', \'type\': \'Criatura — Horror\', \'flavor\': \'"Ni siquiera las ratas osan entran. Me da miedo pensar en lo que hay dentro".\\n—Diario del sepulturero\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485934&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'693924be-a1af-420d-935f-9e77a54f612a\', \'multiverseId\': 485934}, \'multiverseid\': 485934}, {\'name\': \'Guetteur de la crypte\', \'text\': "Quand le Guetteur de la crypte arrive sur le champ de bataille, vous pouvez sacrifier une créature ou vous défausser d\'une carte de créature. Si vous faites ainsi, piochez une carte.", \'type\': \'Créature : horreur\', \'flavor\': "« Même les rats refusent d\'y entrer. Je n\'ose pas imaginer ce qui se trouve là-dedans. »\\n—Journal du fossoyeur", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486193&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'396f1a3b-192f-429d-b3b5-42e4b955cbf7\', \'multiverseId\': 486193}, \'multiverseid\': 486193}, {\'name\': \'Predatore della Cripta\', \'text\': \'Quando il Predatore della Cripta entra nel campo di battaglia, puoi sacrificare una creatura o scartare una carta creatura. Se lo fai, pesca una carta.\', \'type\': \'Creatura — Orrore\', \'flavor\': \'"Perfino i topi si rifiutano di metterci piede. Tremo al solo pensiero di cosa possa nascondersi là dentro."\\n—Diario di uno scavatombe\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486452&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f99df4fb-a69b-4699-91f4-854c06303780\', \'multiverseId\': 486452}, \'multiverseid\': 486452}, {\'name\': \'墓所に潜むもの\', \'text\': \'墓所に潜むものが戦場に出たとき、あなたは、クリーチャー１体を生け贄に捧げるかクリーチャー・カード１枚を捨ててもよい。そうしたなら、カードを１枚引く。\', \'type\': \'クリーチャー — ホラー\', \'flavor\': \'「ネズミですら中に入ることを嫌がる。中に何がいるのか考えるだけでも恐ろしい。」\\n――墓堀り人の日誌\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486711&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d75a7fb9-a234-4717-ac9b-d96d8c49c77a\', \'multiverseId\': 486711}, \'multiverseid\': 486711}, {\'name\': \'묘지 잠복꾼\', \'text\': \'묘지 잠복꾼이 전장에 들어올 때, 당신은 생물 한 개를 희생하거나 생물 카드 한 장을 버릴 수 있다. 그렇게 한다면, 카드 한 장을 뽑는다.\', \'type\': \'생물 — 괴수\', \'flavor\': \'"쥐들조차도 발을 들이려 하지 않아. 저 안에 뭐가 도사리고 있는지 생각하는 것조차 무섭군."\\n—무덤 도둑의 일지\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486970&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'dc27a8f4-5c8c-46fc-8df1-92d0a0f8ac34\', \'multiverseId\': 486970}, \'multiverseid\': 486970}, {\'name\': \'Espreitador da Cripta\', \'text\': \'Quando Espreitador da Cripta entra no campo de batalha, você pode sacrificar uma criatura ou descartar um card de criatura. Se fizer isso, compre um card.\', \'type\': \'Criatura — Horror\', \'flavor\': \'"Até os ratos se recusam a pôr os pés ali dentro. Tenho medo só de pensar no que pode estar esperando ali."\\n— Diário do coveiro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487229&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d3fce041-02ef-48d0-9197-76ed479e3877\', \'multiverseId\': 487229}, \'multiverseid\': 487229}, {\'name\': \'Хищник из Склепа\', \'text\': \'Когда Хищник из Склепа выходит на поле битвы, вы можете пожертвовать существо или сбросить карту существа. Если вы это делаете, возьмите карту.\', \'type\': \'Существо — Ужас\', \'flavor\': \'«Даже крысы туда не суются. Мне страшно подумать, кто мог там притаиться».\\n— дневник могильщика\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487488&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ba5bf4a1-d1e4-4288-b4c4-1f4a14ceb05c\', \'multiverseId\': 487488}, \'multiverseid\': 487488}, {\'name\': \'墓穴伏怪\', \'text\': \'当墓穴伏怪进战场时，你可以牺牲一个生物或弃一张生物牌。若你如此作，则抓一张牌。\', \'type\': \'生物 ～惊惧兽\', \'flavor\': \'「就连老鼠都不敢进去。我甚至都不敢去想里面会有什么在等着我。」\\n～掘墓人日志\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487747&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'211ba371-94f7-467e-b8fe-0f34af8f38e1\', \'multiverseId\': 487747}, \'multiverseid\': 487747}, {\'name\': \'墓穴伏怪\', \'text\': \'當墓穴伏怪進戰場時，你可以犧牲一個生物或棄一張生物牌。若你如此作，則抽一張牌。\', \'type\': \'生物 ～驚懼獸\', \'flavor\': \'「就連老鼠都不敢進去。我甚至都不敢去想裡面會有什麼在等著我。」\\n～掘墓人日誌\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488006&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d502e5ce-ffba-461d-8286-2fbc0ec0a366\', \'multiverseId\': 488006}, \'multiverseid\': 488006}]', '[{\'name\': \'Kultivieren\', \'text\': \'Durchsuche deine Bibliothek nach bis zu zwei Standardland-Karten, zeige sie offen vor, bringe eine davon getappt ins Spiel und nimm die andere auf deine Hand. Mische danach deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': \'Alle Samen haben eine Verbindung zueinander, die durch die Unendlichkeit hindurch reicht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485759&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1ac8e576-4dac-457c-a64a-749f32196822\', \'multiverseId\': 485759}, \'multiverseid\': 485759}, {\'name\': \'Cultivar\', \'text\': \'Busca en tu biblioteca hasta dos cartas de tierra básica, muéstralas, pon una de ellas en el campo de batalla girada y la otra en tu mano. Luego baraja tu biblioteca.\', \'type\': \'Conjuro\', \'flavor\': \'Todas las semillas comparten un lazo, llamándose entre ellas a través del infinito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486018&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9d9ce6a7-b0ac-4b9f-98e4-c8a7377a670d\', \'multiverseId\': 486018}, \'multiverseid\': 486018}, {\'name\': \'Culture\', \'text\': "Cherchez dans votre bibliothèque jusqu\'à deux cartes de terrain de base, révélez ces cartes et mettez-en une sur le champ de bataille engagée, et l\'autre dans votre main. Mélangez ensuite votre bibliothèque.", \'type\': \'Rituel\', \'flavor\': "Toutes les graines partagent un lien les reliant à travers l\'infini.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486277&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'95111e05-fb0d-4aeb-8b2a-d0bd1d01b345\', \'multiverseId\': 486277}, \'multiverseid\': 486277}, {\'name\': \'Coltivare\', \'text\': "Passa in rassegna il tuo grimorio per trovare fino a due carte terra base, rivelale, mettine una sul campo di battaglia TAPpata e aggiungi l\'altra alla tua mano. Poi rimescola il tuo grimorio.", \'type\': \'Stregoneria\', \'flavor\': "Tutti i semi condividono un legame comune, chiamandosi l\'un l\'altro nello spazio infinito.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486536&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a19dd390-7d1f-4f54-9903-c3bddcbbaf90\', \'multiverseId\': 486536}, \'multiverseid\': 486536}, {\'name\': \'耕作\', \'text\': \'あなたのライブラリーから基本土地・カード最大２枚を探し、公開し、そのうち１枚をタップ状態で戦場に、他をあなたの手札に加える。その後、あなたのライブラリーを切り直す。\', \'type\': \'ソーサリー\', \'flavor\': \'全ての種には繋がりがあり、互いを無限の彼方から呼び合う。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486795&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d3b8dd87-feb2-4592-a4c9-cf4593fe9ec3\', \'multiverseId\': 486795}, \'multiverseid\': 486795}, {\'name\': \'경작\', \'text\': \'당신의 서고에서 기본 대지 카드 두 장을 찾아 공개한다. 그중 한 장을 탭된 채로 전장에 놓고 나머지 카드는 당신의 손으로 가져간다. 그 후 당신의 서고를 섞는다.\', \'type\': \'집중마법\', \'flavor\': \'모든 씨앗은 하나로 연결되어 있어서 아무리 멀어도 서로의 부름을 들을 수 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487054&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'62db9048-d69b-449d-8ad9-166c4ccc358f\', \'multiverseId\': 487054}, \'multiverseid\': 487054}, {\'name\': \'Cultivar\', \'text\': \'Procure até dois cards de terreno básico em seu grimório, revele-os e coloque um deles no campo de batalha virado e o outro na sua mão. Depois, embaralhe seu grimório.\', \'type\': \'Feitiço\', \'flavor\': \'Todas as sementes possuem um elo em comum que as une através da eternidade.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487313&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'21f299e2-d9d4-4ace-8782-6428ebc1c4b4\', \'multiverseId\': 487313}, \'multiverseid\': 487313}, {\'name\': \'Культивировать\', \'text\': \'Найдите в вашей библиотеке не более двух карт базовых земель, покажите те карты и положите одну из них на поле битвы повернутой, а другую — в вашу руку. Затем перетасуйте вашу библиотеку.\', \'type\': \'Волшебство\', \'flavor\': \'Все семена связаны прочными узами, взывая друг к другу через бесконечность.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487572&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5a88b10c-ba47-4dd9-8123-d06315f3d124\', \'multiverseId\': 487572}, \'multiverseid\': 487572}, {\'name\': \'栽培\', \'text\': \'从你的牌库中搜寻至多两张基本地牌，展示这些牌，将一张横置放进战场，另一张则置于你手上。然后将你的牌库洗牌。\', \'type\': \'法术\', \'flavor\': \'所有种子都互相连结成一体，永远地彼此呼唤着。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487831&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7729357d-cb7e-409e-aaef-7ac405305736\', \'multiverseId\': 487831}, \'multiverseid\': 487831}, {\'name\': \'栽培\', \'text\': \'從你的牌庫中搜尋至多兩張基本地牌，展示這些牌，將一張橫置放進戰場，另一張則置於你手上。然後將你的牌庫洗牌。\', \'type\': \'巫術\', \'flavor\': \'所有種子都互相連結成一體，永遠地彼此呼喚著。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488090&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8d2265b0-3d6b-49f0-85d7-0627d0b9c670\', \'multiverseId\': 488090}, \'multiverseid\': 488090}]', '[{\'name\': \'Kultivieren\', \'text\': \'Durchsuche deine Bibliothek nach bis zu zwei Standardland-Karten, zeige sie offen vor, bringe eine davon getappt ins Spiel und nimm die andere auf deine Hand. Mische danach deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': \'Alle Samen haben eine Verbindung zueinander, die durch die Unendlichkeit hindurch reicht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488404&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'406529bc-0cde-4ba7-88fa-d8bab77cd6c7\', \'multiverseId\': 488404}, \'multiverseid\': 488404}, {\'name\': \'Cultivar\', \'text\': \'Busca en tu biblioteca hasta dos cartas de tierra básica, muéstralas, pon una de ellas en el campo de batalla girada y la otra en tu mano. Luego baraja tu biblioteca.\', \'type\': \'Conjuro\', \'flavor\': \'Todas las semillas comparten un lazo, llamándose entre ellas a través del infinito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488410&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a2147717-7461-41ab-a725-59ea063998c4\', \'multiverseId\': 488410}, \'multiverseid\': 488410}, {\'name\': \'Culture\', \'text\': "Cherchez dans votre bibliothèque jusqu\'à deux cartes de terrain de base, révélez ces cartes et mettez-en une sur le champ de bataille engagée, et l\'autre dans votre main. Mélangez ensuite votre bibliothèque.", \'type\': \'Rituel\', \'flavor\': "Toutes les graines partagent un lien les reliant à travers l\'infini.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488416&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d62494c5-dc66-437a-b50b-99140fb6c02c\', \'multiverseId\': 488416}, \'multiverseid\': 488416}, {\'name\': \'Coltivare\', \'text\': "Passa in rassegna il tuo grimorio per trovare fino a due carte terra base, rivelale, mettine una sul campo di battaglia TAPpata e aggiungi l\'altra alla tua mano. Poi rimescola il tuo grimorio.", \'type\': \'Stregoneria\', \'flavor\': "Tutti i semi condividono un legame comune, chiamandosi l\'un l\'altro nello spazio infinito.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488422&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'edbe9959-d428-40bc-b5eb-5d200338865d\', \'multiverseId\': 488422}, \'multiverseid\': 488422}, {\'name\': \'耕作\', \'text\': \'あなたのライブラリーから基本土地・カード最大２枚を探し、公開し、そのうち１枚をタップ状態で戦場に、他をあなたの手札に加える。その後、あなたのライブラリーを切り直す。\', \'type\': \'ソーサリー\', \'flavor\': \'全ての種には繋がりがあり、互いを無限の彼方から呼び合う。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488428&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'84d08de0-a013-40a2-813a-f81e93d78796\', \'multiverseId\': 488428}, \'multiverseid\': 488428}, {\'name\': \'경작\', \'text\': \'당신의 서고에서 기본 대지 카드 두 장을 찾아 공개한다. 그 중 한 장을 탭된 채로 전장에 놓고 나머지 카드는 당신의 손으로 가져간다. 그 후 당신의 서고를 섞는다.\', \'type\': \'집중마법\', \'flavor\': \'모든 씨앗은 하나로 연결되어 있어서 아무리 멀어도 서로의 부름을 들을 수 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488434&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7618a177-8d88-4ce4-98d0-8f8a647e42a3\', \'multiverseId\': 488434}, \'multiverseid\': 488434}, {\'name\': \'Cultivar\', \'text\': \'Procure até dois cards de terreno básico em seu grimório, revele-os e coloque um no campo de batalha virado e o outro na sua mão. Depois, embaralhe seu grimório.\', \'type\': \'Feitiço\', \'flavor\': \'Todas as sementes possuem um elo em comum que as une através da eternidade.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488440&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ae8fcb3c-4e39-45f0-8055-d8bf3271977d\', \'multiverseId\': 488440}, \'multiverseid\': 488440}, {\'name\': \'Культивировать\', \'text\': \'Найдите в вашей библиотеке не более двух карт базовых земель, покажите те карты и положите одну из них на поле битвы повернутой, а другую — в вашу руку. Затем перетасуйте вашу библиотеку.\', \'type\': \'Волшебство\', \'flavor\': \'Все семена связаны прочными узами, взывая друг к другу через бесконечность.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488446&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6e80ab4e-1d5c-4dc4-9814-bb7fc4801e57\', \'multiverseId\': 488446}, \'multiverseid\': 488446}, {\'name\': \'栽培\', \'text\': \'从你的牌库中搜寻至多两张基本地牌，展示这些牌，然后将一张横置进战场，另一张则置于你手上。然后将你的牌库洗牌。\', \'type\': \'法术\', \'flavor\': \'所有种子都互相连结成一体，永远地彼此呼唤着。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488452&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9858151e-a4c5-4f86-9300-ddaee2dbe069\', \'multiverseId\': 488452}, \'multiverseid\': 488452}, {\'name\': \'栽培\', \'text\': \'從你的牌庫中搜尋至多兩張基本地牌，展示這些牌，將一張橫置放進戰場，另一張則置於你手上。然後將你的牌庫洗牌。\', \'type\': \'巫術\', \'flavor\': \'所有種子都互相連結成一體，永遠地彼此呼喚著。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488458&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b3f81beb-7a2c-434f-a743-cfa0efe718dd\', \'multiverseId\': 488458}, \'multiverseid\': 488458}]', '[{\'name\': \'Kurzschwert\', \'text\': \'Die ausgerüstete Kreatur erhält +1/+1.\\nAusrüsten {1} ({1}: Lege diese Karte an eine Kreatur deiner Wahl an, die du kontrollierst. Spiele Ausrüsten wie eine Hexerei.)\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': \'„Ein Schwert ist manchmal der einzige Unterschied zwischen einem Märtyrer und einem Helden."\\n—Kapitänin Sisay, aus ihren *Memoiren*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485818&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'44511449-78ac-4b6b-aa53-aaef3ffdaf12\', \'multiverseId\': 485818}, \'multiverseid\': 485818}, {\'name\': \'Espada corta\', \'text\': \'La criatura equipada obtiene +1/+1.\\nEquipar {1}. ({1}: Anexa este Equipo a la criatura objetivo que controlas. Activa la habilidad de equipar como un conjuro.)\', \'type\': \'Artefacto — Equipo\', \'flavor\': \'"A veces, la única diferencia entre un mártir y un héroe es una espada".\\n—Capitana Sisay, *Memorias*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486077&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b702fd51-b7b1-4165-8208-cd35dab4f3fa\', \'multiverseId\': 486077}, \'multiverseid\': 486077}, {\'name\': \'Épée courte\', \'text\': "La créature équipée gagne +1/+1.\\nÉquipement {1} ({1} : Attachez à la créature ciblée que vous contrôlez. N\'attachez l\'équipement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Artefact : équipement\', \'flavor\': \'« Parfois, la seule différence entre un martyre et un héros est une épée. »\\n—Capitaine Sissay, *Mémoires*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486336&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'527297c5-dcd4-4d3a-a436-bbbdf217c10a\', \'multiverseId\': 486336}, \'multiverseid\': 486336}, {\'name\': \'Spada Corta\', \'text\': \'La creatura equipaggiata prende +1/+1.\\nEquipaggiare {1} ({1}: Assegna a una creatura bersaglio che controlli. Equipaggia solo quando potresti lanciare una stregoneria.)\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': \'"A volte, l\\\'unica differenza tra un martire e un eroe è una spada."\\n—Capitana Sisay, *Memorie*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486595&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3a473613-0367-4aaa-bd55-450b962f06e6\', \'multiverseId\': 486595}, \'multiverseid\': 486595}, {\'name\': \'小剣\', \'text\': \'装備しているクリーチャーは＋１/＋１の修整を受ける。\\n装備{1}（{1}：あなたがコントロールしているクリーチャー１体を対象とし、これをそれにつける。装備はソーサリーとしてのみ行う。）\', \'type\': \'アーティファクト — 装備品\', \'flavor\': \'「殉死者になるか英雄になるか。それは単に剣の差だったりするのよ。」\\n――艦長シッセイ、*回顧録*より\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486854&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'59b26d90-25f5-43e1-bafb-bfab102ee18e\', \'multiverseId\': 486854}, \'multiverseid\': 486854}, {\'name\': \'짧은 검\', \'text\': \'장착된 생물은 +1/+1을 받는다.\\n장착 {1} ({1}: 당신이 조종하는 생물을 목표로 정한다. 그 생물에 이 장비를 부착한다. 당신이 집중마법을 발동할 수 있는 시기에만 이 능력을 활성화할 수 있다.)\', \'type\': \'마법물체 — 장비\', \'flavor\': \'"때로는 순교자와 영웅의 차이가 단지 검 한 자루뿐일 때도 있다."\\n—시세이 선장, *회고록*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487113&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'30da9567-2832-419f-bf5e-f3ccf406cb8a\', \'multiverseId\': 487113}, \'multiverseid\': 487113}, {\'name\': \'Espada Curta\', \'text\': \'A criatura equipada recebe +1/+1.\\nEquipar {1} ({1}: Anexe este equipamento à criatura alvo que você controla. Equipe somente como um feitiço.)\', \'type\': \'Artefato — Equipamento\', \'flavor\': \'"Às vezes, a única diferença entre um mártir e um herói é uma espada."\\n— Capitã Sisay, *Memórias*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487372&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d59567a3-bcb2-4061-bd2c-4c50e7379446\', \'multiverseId\': 487372}, \'multiverseid\': 487372}, {\'name\': \'Короткий Меч\', \'text\': \'Снаряженное существо получает +1/+1.\\nСнарядить {1} ({1}: прикрепите к целевому существу под вашим контролем. Снаряжайте только как волшебство.)\', \'type\': \'Артефакт — Снаряжение\', \'flavor\': \'«Иногда мученика от героя отделяет лишь меч в руке».\\n— мемуары капитана Сисэй**\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487631&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d955ec5a-bd3d-4950-b459-1d764b72c585\', \'multiverseId\': 487631}, \'multiverseid\': 487631}, {\'name\': \'短剑\', \'text\': \'佩带此武具的生物得+1/+1。\\n佩带{1}（{1}：装备在目标由你操控的生物上。佩带的时机视同法术。）\', \'type\': \'神器 ～武具\', \'flavor\': \'「有时候，殉道者与英雄的差别就在于一把剑。」\\n～西赛船长，《回忆录》**\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487890&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'157f4af2-15d5-447c-b968-610a99794d2b\', \'multiverseId\': 487890}, \'multiverseid\': 487890}, {\'name\': \'短劍\', \'text\': \'佩帶此武具的生物得+1/+1。\\n佩帶{1}（{1}：裝備在目標由你操控的生物上。佩帶的時機視同巫術。）\', \'type\': \'神器 ～武具\', \'flavor\': \'「有時候，殉道者與英雄的差別就在於一把劍。」\\n～西賽船長，《回憶錄》**\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488149&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bdc74101-2a0e-4928-9d12-c2a597cdefa3\', \'multiverseId\': 488149}, \'multiverseid\': 488149}]', '[{\'name\': \'Kühner Gleitspringer\', \'text\': \'{2}{U}: Eine Kreatur deiner Wahl erhält Flugfähigkeit bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'„Furcht ist eine rationale Reaktion, aber warten macht es nicht einfacher. Spring einfach!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485636&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'128481de-11bf-45f6-8af8-e7747a27fa59\', \'multiverseId\': 485636}, \'multiverseid\': 485636}, {\'name\': \'Planeador entusiasta\', \'text\': \'{2}{U}: La criatura objetivo gana la habilidad de volar hasta el final del turno.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'"El miedo es una respuesta racional, pero la espera no te lo hará más sencillo. ¡Salta y ya está!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485895&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'502156c3-3a17-4fa1-9efa-daf469557a1e\', \'multiverseId\': 485895}, \'multiverseid\': 485895}, {\'name\': \'Planachutiste passionné\', \'text\': "{2}{U} : La créature ciblée acquiert le vol jusqu\'à la fin du tour.", \'type\': \'Créature : humain et soldat\', \'flavor\': \'« La peur est une réaction naturelle, mais attendre ne facilitera pas les choses. Sautez ! »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486154&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2ee4add0-8c66-4037-96ca-f668283b1355\', \'multiverseId\': 486154}, \'multiverseid\': 486154}, {\'name\': \'Maestro di Planata Entusiasta\', \'text\': \'{2}{U}: Una creatura bersaglio ha volare fino alla fine del turno.\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'"La paura è una reazione logica, ma rimandare oltre non migliorerà le cose. Salta e basta!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486413&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'81ecf795-6fd7-4cb9-9e55-f3caa14c01ad\', \'multiverseId\': 486413}, \'multiverseid\': 486413}, {\'name\': \'厳しい滑空指導員\', \'text\': \'{2}{U}：クリーチャー１体を対象とする。ターン終了時まで、それは飛行を得る。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'「怖いのは正常な反応だが、待っていても楽にはならんぞ。とにかく飛ぶんだ！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486672&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'48fd4558-08a9-454f-b248-6f9fac333b22\', \'multiverseId\': 486672}, \'multiverseid\': 486672}, {\'name\': \'명민한 활강지휘관\', \'text\': \'{2}{U}: 생물을 목표로 정한다. 그 생물은 턴종료까지 비행을 얻는다.\', \'type\': \'생물 — 인간 병사\', \'flavor\': \'"공포는 이성적인 반응이지만, 기다린다고 더 나아지는 것도 아니야. 그냥 뛰어!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486931&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'152756c1-f684-46f7-a07f-3b5daa5a7f4f\', \'multiverseId\': 486931}, \'multiverseid\': 486931}, {\'name\': \'Mestre de Planador Arguto\', \'text\': \'{2}{U}: A criatura alvo ganha voar até o final do turno.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': \'"O medo é uma reação racional, mas ficar esperando não vai deixar nada mais fácil. Só pule!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487190&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9c862e30-b7f0-41e5-ba7d-cf9c0132a662\', \'multiverseId\': 487190}, \'multiverseid\': 487190}, {\'name\': \'Увлеченный Планерист\', \'text\': \'{2}{U}: целевое существо получает Полет до конца хода.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'«Страх — это понятная реакция, но оттого, что ты ждешь, легче не станет. Прыгай — и дело с концом!»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487449&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9de23227-d114-4cbc-ae54-80572973e82c\', \'multiverseId\': 487449}, \'multiverseid\': 487449}, {\'name\': \'敏锐滑翔长\', \'text\': \'{2}{U}：目标生物获得飞行异能直到回合结束。\', \'type\': \'生物 ～人类／士兵\', \'flavor\': \'「会害怕是正常反应，但干等着也没办法缓解。跳就对了！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487708&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6ebe5625-dce3-4e6e-8c16-d7eb160ec65c\', \'multiverseId\': 487708}, \'multiverseid\': 487708}, {\'name\': \'敏銳滑翔長\', \'text\': \'{2}{U}：目標生物獲得飛行異能直到回合結束。\', \'type\': \'生物 ～人類／士兵\', \'flavor\': \'「會害怕是正常反應，但乾等著也沒辦法緩解。跳就對了！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487967&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3491222f-10c1-4902-8b8b-9eab80234dc2\', \'multiverseId\': 487967}, \'multiverseid\': 487967}]', '[{\'name\': \'Laubsippen-Rächer\', \'text\': \'{T}: Erzeuge {G} für jede Kreatur mit Stärke 4 oder mehr, die du kontrollierst.\\n{7}{R}: Der Laubsippen-Rächer fügt einem Spieler oder Planeswalker deiner Wahl Schadenspunkte in Höhe seiner Stärke zu.\', \'type\': \'Kreatur — Elementarwesen, Druide\', \'flavor\': \'„Meine Wurzeln sind Asche, mein Herz ist brodelnde Glut. Was ich nicht beschützen kann, werde ich rächen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485802&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'701bfadd-3adb-4efe-b06b-d104687d7672\', \'multiverseId\': 485802}, \'multiverseid\': 485802}, {\'name\': \'Vengador frondoide\', \'text\': \'{T}: Agrega {G} por cada criatura con fuerza de 4 o más que controlas.\\n{7}{R}: El Vengador frondoide hace una cantidad de daño igual a su fuerza al jugador o planeswalker objetivo.\', \'type\': \'Criatura — Druida elemental\', \'flavor\': \'"Mis raíces son cenizas; mi corazón, ascuas ardientes. Vengaré lo que no pude proteger".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486061&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a18fa38d-7937-4258-a8fd-5702f11509e1\', \'multiverseId\': 486061}, \'multiverseid\': 486061}, {\'name\': \'Vengeur sangfeuille\', \'text\': \'{T} : Ajoutez {G} pour chaque créature de force supérieure ou égale à 4 que vous contrôlez.\\n{7}{R} : Le Vengeur sangfeuille inflige un nombre de blessures égal à sa force à une cible, joueur ou planeswalker.\', \'type\': \'Créature : élémental et druide\', \'flavor\': "« Mes racines sont faites de cendres, mon cœur est une braise incandescente. Je vengerai ce que je n\'ai pas pu protéger. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486320&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'60ba7a30-b70f-4ba1-a28e-27d6e3ada664\', \'multiverseId\': 486320}, \'multiverseid\': 486320}, {\'name\': \'Vendicatore Fogliforme\', \'text\': \'{T}: Aggiungi {G} per ogni creatura con forza pari o superiore a 4 che controlli.\\n{7}{R}: Il Vendicatore Fogliforme infligge danno pari alla sua forza a un giocatore o a un planeswalker bersaglio.\', \'type\': \'Creatura — Druido Elementale\', \'flavor\': \'"Le mie radici sono cenere, il mio cuore un tizzone ardente. Quel che non sono riuscito a proteggere, lo vendicherò."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486579&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8e417d9a-b3dc-498d-ae0f-e13b2ae385a7\', \'multiverseId\': 486579}, \'multiverseid\': 486579}, {\'name\': \'枝葉族の報復者\', \'text\': \'{T}：あなたがコントロールしていてパワーが４以上のクリーチャー１体につき{G}を加える。\\n{7}{R}：プレイヤー１人かプレインズウォーカー１体を対象とする。枝葉族の報復者はそれに自身のパワーに等しい点数のダメージを与える。\', \'type\': \'クリーチャー — エレメンタル・ドルイド\', \'flavor\': \'「根は灰になり、心は燃えさしになった。私は守れなかったものの敵を討つのだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486838&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e8724e59-9ad2-4169-9f0f-9e42f0b8b22d\', \'multiverseId\': 486838}, \'multiverseid\': 486838}, {\'name\': \'나뭇잎 일족 복수자\', \'text\': \'{T}: 당신이 조종하는 공격력이 4 이상인 각 생물마다 {G}를 추가한다.\\n{7}{R}: 플레이어 또는 플레인즈워커를 목표로 정한다. 나뭇잎 일족 복수자는 그 목표에게 자신의 공격력만큼 피해를 입힌다.\', \'type\': \'생물 — 정령 드루이드\', \'flavor\': \'"내 뿌리는 잿더미이고, 내 심장은 뜨겁게 타오르는 불씨이다. 내가 보호하지 못했던 것들에 대해, 나는 복수하리라."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487097&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'990738c4-a7a1-4951-a5f2-c2841326bba6\', \'multiverseId\': 487097}, \'multiverseid\': 487097}, {\'name\': \'Vingador Fóleo\', \'text\': \'{T}: Adicione {G} para cada criatura que você controla com poder igual ou superior a 4.\\n{7}{R}: Vingador Fóleo causa dano igual ao próprio poder ao jogador ou planeswalker alvo.\', \'type\': \'Criatura — Elemental Druida\', \'flavor\': \'"Minhas raízes são cinzas. Meu coração, uma brasa ardente. O que não consegui proteger, eu vingarei."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487356&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'829c4fc7-fb5c-4ddc-8142-062b6119bef8\', \'multiverseId\': 487356}, \'multiverseid\': 487356}, {\'name\': \'Листворожденный Мститель\', \'text\': "{T}: добавьте {G} за каждое существо под вашим контролем с силой 4 или больше.\\n{7}{R}: Листворожденный Мститель наносит повреждения, равные своей силе, целевому игроку или planeswalker\'у.", \'type\': \'Существо — Элементаль Друид\', \'flavor\': \'«Мои корни — зола, сердце — тлеющий уголь. За то, что я не смог защитить, я отомщу».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487615&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'aef2497e-3993-429d-aa56-7083bd929982\', \'multiverseId\': 487615}, \'multiverseid\': 487615}, {\'name\': \'复仇叶身\', \'text\': \'{T}：你每操控一个力量等于或大于4的生物，便加{G}。\\n{7}{R}：复仇叶身对目标牌手或鹏洛客造成伤害，其数量等同于前者的力量。\', \'type\': \'生物 ～元素／德鲁伊\', \'flavor\': \'「我树根已化灰，心脏已成烬。我所不能卫护者，定将为其报仇。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487874&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'04110f9b-3d46-487d-a335-5aa20d3b877a\', \'multiverseId\': 487874}, \'multiverseid\': 487874}, {\'name\': \'復仇葉身\', \'text\': \'{T}：你每操控一個力量等於或大於4的生物，便加{G}。\\n{7}{R}：復仇葉身對目標玩家或鵬洛客造成傷害，其數量等同於前者的力量。\', \'type\': \'生物 ～元素／德魯伊\', \'flavor\': \'「我樹根已化灰，心臟已成燼。我所不能衛護者，定將為其報仇。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488133&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a7b50191-bf85-42fe-9d27-9ede27287ed5\', \'multiverseId\': 488133}, \'multiverseid\': 488133}]', '[{\'name\': \'Lautloser Pfeil\', \'text\': \'{4}, {T}, opfere den Lautlosen Pfeil: Er fügt einer Kreatur deiner Wahl 3 Schadenspunkte zu.\', \'type\': \'Artefakt\', \'flavor\': \'„Diese Bedingungen sind für das Haus Dimir akzeptabel. Besiegeln wir sie mit einem Handschlag."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485819&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'500b4d8f-ef60-46c1-8934-a47877b0750e\', \'multiverseId\': 485819}, \'multiverseid\': 485819}, {\'name\': \'Dardo silencioso\', \'text\': \'{4}, {T}, sacrificar el Dardo silencioso: Hace 3 puntos de daño a la criatura objetivo.\', \'type\': \'Artefacto\', \'flavor\': \'"La Casa Dimir acepta estas condiciones. Cerremos el acuerdo con un apretón de manos".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486078&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6a122cff-444e-42f4-85e1-a7863006872c\', \'multiverseId\': 486078}, \'multiverseid\': 486078}, {\'name\': \'Fléchette silencieuse\', \'text\': \'{4}, {T}, sacrifiez la Fléchette silencieuse : Elle inflige 3 blessures à la créature ciblée.\', \'type\': \'Artefact\', \'flavor\': \'« Ces conditions conviennent à la Maison Dimir. Serrons-nous la main. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486337&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'82be2e1b-efbd-4fe5-bdfc-79d8194fd095\', \'multiverseId\': 486337}, \'multiverseid\': 486337}, {\'name\': \'Dardo Silenzioso\', \'text\': \'{4}, {T}, Sacrifica il Dardo Silenzioso: Infligge 3 danni a una creatura bersaglio.\', \'type\': \'Artefatto\', \'flavor\': \'"La Casata Dimir approva i termini dell\\\'accordo. Una stretta di mano per suggellarlo?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486596&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5f654b0f-7133-406f-abf8-4f9603420315\', \'multiverseId\': 486596}, \'multiverseid\': 486596}, {\'name\': \'静かな隠し矢\', \'text\': \'{4}, {T}, 静かな隠し矢を生け贄に捧げる：クリーチャー１体を対象とする。これはそれに３点のダメージを与える。\', \'type\': \'アーティファクト\', \'flavor\': \'「ディミーア家はその条件に同意します。交渉成立の握手をしましょうか。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486855&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b9748626-ec86-47d3-9903-8f7794e20d2c\', \'multiverseId\': 486855}, \'multiverseid\': 486855}, {\'name\': \'소리 없는 화살\', \'text\': \'{4}, {T}, 소리 없는 화살을 희생한다: 생물을 목표로 정한다. 소리 없는 화살은 그 생물에게 피해 3점을 입힌다.\', \'type\': \'마법물체\', \'flavor\': \'"디미르 가문은 이 계약을 받아들일 수 있네. 악수하겠나?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487114&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ab9569ec-62e4-4715-a0ca-09e2d1de354f\', \'multiverseId\': 487114}, \'multiverseid\': 487114}, {\'name\': \'Dardo de Pulso\', \'text\': \'{4}, {T}, sacrifique Dardo de Pulso: Ele causa 3 pontos de dano à criatura alvo.\', \'type\': \'Artefato\', \'flavor\': \'"Esses termos são aceitáveis para a Casa Dimir. Selamos com um aperto de mãos?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487373&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bc5a9824-b456-4b6d-8745-bd8a5de41a04\', \'multiverseId\': 487373}, \'multiverseid\': 487373}, {\'name\': \'Бесшумное Острие\', \'text\': \'{4}, {T}, пожертвуйте Бесшумное Острие: оно наносит 3 повреждения целевому существу.\', \'type\': \'Артефакт\', \'flavor\': \'«Эти условия устраивают Дом Димиров. Скрепим же договор рукопожатием!»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487632&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'696db49a-95fb-4675-ab60-ef351730293c\', \'multiverseId\': 487632}, \'multiverseid\': 487632}, {\'name\': \'无声袖剑\', \'text\': \'{4}，{T}，牺牲无声袖剑：它对目标生物造成3点伤害。\', \'type\': \'神器\', \'flavor\': \'「底密尔会堂接受你们的条件。握个手？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487891&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'60dea7e2-c5f7-4f63-9a28-1d2a9e6049d0\', \'multiverseId\': 487891}, \'multiverseid\': 487891}, {\'name\': \'無聲袖劍\', \'text\': \'{4}，{T}，犧牲無聲袖劍：它對目標生物造成3點傷害。\', \'type\': \'神器\', \'flavor\': \'「底密爾會堂接受你們的條件。握個手？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488150&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2ed9f5b4-3e17-414b-824c-ab1537519db4\', \'multiverseId\': 488150}, \'multiverseid\': 488150}]', '[{\'name\': \'Leuchtender Springbrunnen\', \'text\': \'Wenn der Leuchtende Springbrunnen ins Spiel kommt, erhältst du 2 Lebenspunkte dazu.\\n{T}: Erzeuge {C}.\', \'type\': \'Land\', \'flavor\': \'„Alle Völker schätzen einen Ort, an dem sich ein müder Wanderer erquicken kann."\\n—Ajani Goldmähne\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485830&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5e477ae4-62de-4991-926b-bf14492b60e2\', \'multiverseId\': 485830}, \'multiverseid\': 485830}, {\'name\': \'Fuente radiante\', \'text\': \'Cuando la Fuente radiante entre al campo de batalla, ganas 2 vidas.\\n{T}: Agrega {C}.\', \'type\': \'Tierra\', \'flavor\': \'"Todas las culturas valoran un lugar en el que el viajero exhausto pueda beber en paz".\\n—Ajani Melena Dorada\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486089&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c59d1330-5fa9-4998-9b9c-eb455f771558\', \'multiverseId\': 486089}, \'multiverseid\': 486089}, {\'name\': \'Fontaine radieuse\', \'text\': \'Quand la Fontaine radieuse arrive sur le champ de bataille, vous gagnez 2 points de vie.\\n{T} : Ajoutez {C}.\', \'type\': \'Terrain\', \'flavor\': "« Tous les peuples chérissent un lieu où les voyageurs fatigués peuvent s\'abreuver en paix. »\\n—Ajani Crinièredor", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486348&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c053b220-bad2-438a-af7e-9bd537d0672d\', \'multiverseId\': 486348}, \'multiverseid\': 486348}, {\'name\': \'Fontana Radiosa\', \'text\': \'Quando la Fontana Radiosa entra nel campo di battaglia, guadagni 2 punti vita.\\n{T}: Aggiungi {C}.\', \'type\': \'Terra\', \'flavor\': \'"Tutti i popoli custodiscono un luogo dove il viaggiatore stanco può dissetarsi in pace."\\n—Ajani Criniera D\\\'Oro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486607&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'336c5951-bbc0-4bca-9fdb-8d2e8fc039d0\', \'multiverseId\': 486607}, \'multiverseid\': 486607}, {\'name\': \'光輝の泉\', \'text\': \'光輝の泉が戦場に出たとき、あなたは２点のライフを得る。\\n{T}：{C}を加える。\', \'type\': \'土地\', \'flavor\': \'「疲れ果てた旅人が安心して水を飲める場所は、すべての者にとっての宝である。」\\n――黄金のたてがみのアジャニ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486866&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'db7acc5b-cb67-4ba7-a517-82734ac8a937\', \'multiverseId\': 486866}, \'multiverseid\': 486866}, {\'name\': \'빛나는 분수\', \'text\': \'빛나는 분수가 전장에 들어올 때, 당신은 생명 2점을 얻는다.\\n{T}: {C}를 추가한다.\', \'type\': \'대지\', \'flavor\': \'"어느 종족에게나 지친 여행자가 평화롭게 목을 축일 수 있는 곳은 대단히 귀중하다."\\n—아자니 골드메인\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487125&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'bfeacbd8-81d9-4e2a-997d-d73cd5c84bf7\', \'multiverseId\': 487125}, \'multiverseid\': 487125}, {\'name\': \'Fonte Radiante\', \'text\': \'Quando Fonte Radiante entra no campo de batalha, você ganha 2 pontos de vida.\\n{T}: Adicione {C}.\', \'type\': \'Terreno\', \'flavor\': \'"Todos os povos valorizam um lugar onde um viajante cansado possa beber em paz."\\n— Ajani Juba D\\\'ouro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487384&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d256f631-17f2-4131-bc59-2fd19b20e035\', \'multiverseId\': 487384}, \'multiverseid\': 487384}, {\'name\': \'Лучезарный Фонтан\', \'text\': \'Когда Лучезарный Фонтан выходит на поле битвы, вы получаете 2 жизни.\\n{T}: добавьте {C}.\', \'type\': \'Земля\', \'flavor\': \'«Для усталого путника нет ничего желаннее места, где он может спокойно напиться воды».\\n— Златогривый Аджани\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487643&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9e851708-bb69-486d-b324-5adcda4abdff\', \'multiverseId\': 487643}, \'multiverseid\': 487643}, {\'name\': \'华光喷泉\', \'text\': \'当华光喷泉进战场时，你获得2点生命。\\n{T}：加{C}。\', \'type\': \'地\', \'flavor\': \'「每个人都重视疲惫的旅人能安心喝水的地方。」\\n～金鬃阿耶尼\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487902&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'06854572-10a3-4707-a58a-5d5c24ee7cb0\', \'multiverseId\': 487902}, \'multiverseid\': 487902}, {\'name\': \'華光噴泉\', \'text\': \'當華光噴泉進戰場時，你獲得2點生命。\\n{T}：加{C}。\', \'type\': \'地\', \'flavor\': \'「每個人都重視疲憊的旅人能安心喝水的地方。」\\n～金鬃阿耶尼\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488161&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'46fcb7f9-6ef6-4d74-9c14-15b97f6c72ef\', \'multiverseId\': 488161}, \'multiverseid\': 488161}]', '[{\'name\': \'Licht der Verheißung\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur hat „Immer wenn du Lebenspunkte dazuerhältst, lege entsprechend viele +1/+1-Marken auf diese Kreatur."\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Das Licht strömte über ihn und im Wind hörte er das Brüllen all seiner Ahnen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485607&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2936555e-4ee7-4c91-9e3b-39be058c4efb\', \'multiverseId\': 485607}, \'multiverseid\': 485607}, {\'name\': \'Luz de la promesa\', \'text\': \'Encantar criatura.\\nLa criatura encantada tiene "Siempre que ganes vidas, pon esa misma cantidad de contadores +1/+1 sobre esta criatura".\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'La luz lo envolvió y escuchó en el viento los rugidos de todos sus antiguos compañeros de manada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485866&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'553dc67e-b763-4833-8298-e92dd78bdea8\', \'multiverseId\': 485866}, \'multiverseid\': 485866}, {\'name\': \'Lumière de promesse\', \'text\': \'Enchanter : créature\\nLa créature enchantée a « À chaque fois que vous gagnez des points de vie, mettez autant de marqueurs +1/+1 sur cette créature. »\', \'type\': \'Enchantement : aura\', \'flavor\': "Il fut baigné de lumière, et dans le vent il entendit les rugissements de tous les frères de bande qui l\'avaient précédé.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486125&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e94ca63c-1405-43f5-a5f1-5e5c2f466908\', \'multiverseId\': 486125}, \'multiverseid\': 486125}, {\'name\': \'Luce della Promessa\', \'text\': \'Incanta creatura\\nLa creatura incantata ha "Ogniqualvolta guadagni punti vita, metti su questa creatura altrettanti segnalini +1/+1".\', \'type\': \'Incantesimo — Aura\', \'flavor\': "Fu inondato dalla luce e nel vento udì i ruggiti di tutti i compagni del branco che l\'avevano preceduto.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486384&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2525dd42-8962-47a4-93ca-b05f07efbafc\', \'multiverseId\': 486384}, \'multiverseid\': 486384}, {\'name\': \'約束の光\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントしているクリーチャーは「あなたがライフを得るたび、その点数に等しい数の＋１/＋１カウンターをこのクリーチャーの上に置く。」を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'光が降り注いだ。風の中で、集まっていた群れ仲間たちの咆哮が聞こえた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486643&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d32191c3-97c7-4ed7-8a50-12345b85ee98\', \'multiverseId\': 486643}, \'multiverseid\': 486643}, {\'name\': \'약속의 빛\', \'text\': \'생물에게 부여\\n부여된 생물은 "당신이 생명점을 얻을 때마다, 이 생물에 그 생명점만큼의 +1/+1 카운터를 올려놓는다."라는 능력을 가진다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'빛이 그를 휘감았고, 바람 속에서 그는 선대 무리동료들의 포효를 들었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486902&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a48427a8-7ba2-4473-a78a-51f61683573d\', \'multiverseId\': 486902}, \'multiverseid\': 486902}, {\'name\': \'Luz da Promessa\', \'text\': \'Encantar criatura\\nA criatura encantada tem "Toda vez que você ganhar pontos de vida, coloque uma quantidade equivalente de marcadores +1/+1 nesta criatura."\', \'type\': \'Encantamento — Aura\', \'flavor\': \'A luz o banhou, e no vento ele ouviu os rugidos de todos os companheiros de bando que o precederam.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487161&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b670cebf-9ace-4f9a-9a56-8771cb8ef924\', \'multiverseId\': 487161}, \'multiverseid\': 487161}, {\'name\': \'Свет Обещания\', \'text\': \'Зачаровать существо\\nЗачарованное существо имеет способность «Каждый раз, когда вы получаете жизни, положите столько же жетонов +1/+1 на это существо».\', \'type\': \'Чары — Аура\', \'flavor\': \'Свет пролился на него, и в шуме ветра он услышал рев всех сородичей, что были до него.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487420&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'41dafd81-31ba-4307-afd1-dd157bf65547\', \'multiverseId\': 487420}, \'multiverseid\': 487420}, {\'name\': \'允诺之光\', \'text\': \'结附于生物\\n所结附的生物具有「每当你获得生命时，在此生物上放置等量的+1/+1指示物。」\', \'type\': \'结界 ～灵气\', \'flavor\': \'他沐浴在明光之中，风中传来此前曾历经此处的群伴呼吼。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487679&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'55b7aec0-e112-48ae-8281-c16be0d5ebda\', \'multiverseId\': 487679}, \'multiverseid\': 487679}, {\'name\': \'允諾之光\', \'text\': \'結附於生物\\n所結附的生物具有「每當你獲得生命時，在此生物上放置等量的+1/+1指示物。」\', \'type\': \'結界 ～靈氣\', \'flavor\': \'他沐浴在明光之中，風中傳來此前曾歷經此處的群伴呼吼。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487938&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'61efdd19-4ca4-4e3c-8353-a4e817290746\', \'multiverseId\': 487938}, \'multiverseid\': 487938}]', '[{\'name\': \'Liliana, Erweckerin der Toten\', \'text\': \'+1: Jeder Spieler wirft eine Karte ab. Jeder Gegner, der dies nicht kann, verliert 3 Lebenspunkte.\\n-3: Eine Kreatur deiner Wahl erhält bis zum Ende des Zuges -X/-X, wobei X gleich der Anzahl an Karten in deinem Friedhof ist.\\n−7: Du erhältst ein Emblem mit „Zu Beginn des Kampfes in deinem Zug bringst du eine Kreaturenkarte deiner Wahl aus einem Friedhof unter deiner Kontrolle ins Spiel. Sie erhält Eile."\', \'type\': \'Legendärer Planeswalker — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488182&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b9233e0d-4b4f-42e2-9977-10ff361b0aaf\', \'multiverseId\': 488182}, \'multiverseid\': 488182}, {\'name\': \'Liliana, Despertadora de los Muertos\', \'text\': \'+1: Cada jugador descarta una carta. Cada oponente que no pueda hacerlo pierde 3 vidas.\\n−3: La criatura objetivo obtiene -X/-X hasta el final del turno, donde X es la cantidad de cartas en tu cementerio.\\n−7: Obtienes un emblema con "Al comienzo del combate en tu turno, pon en el campo de batalla bajo tu control la carta de criatura objetivo de un cementerio. Gana la habilidad de prisa".\', \'type\': \'Planeswalker legendario — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488188&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cf3c5785-2a8f-4f4a-b463-67e1b54a5524\', \'multiverseId\': 488188}, \'multiverseid\': 488188}, {\'name\': \'Liliana, éveilleuse des morts\', \'text\': "+1: Chaque joueur se défausse d\'une carte. Chaque adversaire qui ne peut pas le faire perd 3 points de vie.\\n-3: La créature ciblée gagne -X/-X jusqu\'à la fin du tour, X étant le nombre de cartes dans votre cimetière.\\n-7: Vous gagnez un emblème avec « Au début du combat pendant votre tour, mettez sur le champ de bataille, sous votre contrôle, une carte de créature ciblée depuis un cimetière. Elle acquiert la célérité. »", \'type\': \'Planeswalker légendaire : Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488194&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'38470eed-c9e9-40df-9126-6e837347fd64\', \'multiverseId\': 488194}, \'multiverseid\': 488194}, {\'name\': \'Liliana, Risvegliatrice dei Morti\', \'text\': \'+1: Ogni giocatore scarta una carta. Ogni avversario che non può farlo perde 3 punti vita.\\n-3: Una creatura bersaglio prende -X/-X fino alla fine del turno, dove X è il numero di carte nel tuo cimitero.\\n-7: Ottieni un emblema con "All\\\'inizio del combattimento nel tuo turno, metti sul campo di battaglia sotto il tuo controllo una carta creatura bersaglio da un cimitero. Ha rapidità".\', \'type\': \'Planeswalker Leggendario — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488200&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7b26702b-445c-45cd-b4ce-2fd4cac06fd3\', \'multiverseId\': 488200}, \'multiverseid\': 488200}, {\'name\': \'死者を目覚めさせる者、リリアナ\', \'text\': \'+1：各プレイヤーはそれぞれカード１枚を捨てる。そうできなかった各対戦相手はそれぞれ３点のライフを失う。\\n-3：クリーチャー１体を対象とする。ターン終了時まで、それは－Ｘ / －Ｘの修整を受ける。Ｘはあなたの墓地にあるカードの枚数に等しい。\\n-7：あなたは「あなたのターンの戦闘の開始時に、墓地からクリーチャー・カード１枚を対象とし、それをあなたのコントロール下で戦場に出す。それは速攻を得る。」を持つ紋章を得る。\', \'type\': \'伝説のプレインズウォーカー — リリアナ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488206&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c3104f0d-929a-4ba7-9523-9d8f5f99f7f5\', \'multiverseId\': 488206}, \'multiverseid\': 488206}, {\'name\': \'망자를 깨우는 자, 릴리아나\', \'text\': \'+1: 각 플레이어는 카드 한 장을 버린다. 그렇게 할 수 없는 각 상대는 생명 3점을 잃는다.\\n−3: 생물을 목표로 정한다. 그 생물은 턴종료까지 -X/-X를 받는다. X는 당신의 무덤에 있는 카드 수이다.\\n−7: 당신은 "당신의 턴 전투 시작에, 무덤에 있는 생물 카드를 목표로 정한다. 그 카드를 당신의 조종하에 전장에 놓는다. 그 카드는 신속을 얻는다."를 가진 휘장을 얻는다.\', \'type\': \'전설적 플레인즈워커 — 릴리아나\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488212&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d26f2b3f-08d2-4136-a5b0-76e015ddb447\', \'multiverseId\': 488212}, \'multiverseid\': 488212}, {\'name\': \'Liliana, Despertadora dos Mortos\', \'text\': \'+1: Cada jogador descarta um card. Cada oponente que não puder fazê-lo perde 3 pontos de vida.\\n−3: A criatura alvo recebe -X/-X até o final do turno, sendo X o número de cards em seu cemitério.\\n−7: Você recebe um emblema com "No início do combate no seu turno, coloque o card de criatura alvo de um cemitério no campo de batalha sob seu controle. Ele ganha ímpeto."\', \'type\': \'Planeswalker Lendário — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488218&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b2c8ad55-2411-44c4-b57a-b4bd2224430d\', \'multiverseId\': 488218}, \'multiverseid\': 488218}, {\'name\': \'ЛИЛИАНА, ПРОБУЖДАЮЩАЯ МЕРТВЫХ\', \'text\': \'+1: каждый игрок сбрасывает карту. Каждый оппонент, который не может этого сделать, теряет 3 жизни.\\n−3: целевое существо получает -X/-X до конца хода, где Х — количество карт на вашем кладбище.\\n−7: вы получаете эмблему со способностью «В начале боя во время вашего хода положите целевую карту существа из кладбища на поле битвы под вашим контролем. Она получает Ускорение».\', \'type\': \'Легендарный Planeswalker — Лилиана\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488224&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9a796c49-5b13-416a-98c3-307902bf9db0\', \'multiverseId\': 488224}, \'multiverseid\': 488224}, {\'name\': \'醒亡莉莲娜\', \'text\': \'+1：每位牌手各弃一张牌。每位无法如此作的对手各失去3点生命。\\n-3：目标生物得-X/-X 直到回合结束，X 为你坟墓场中牌的数量。\\n-7：你获得具有「在你回合的战斗开始时，将目标生物牌在你的操控下从坟墓场放进战场。它获得敏捷异能」的徽记。\', \'type\': \'传奇鹏洛客 ～莉莲娜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488230&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'06873562-7982-4875-80c0-37ca8508052d\', \'multiverseId\': 488230}, \'multiverseid\': 488230}, {\'name\': \'醒亡莉蓮娜\', \'text\': \'+1：每位玩家各棄一張牌。每位無法如此作的對手各失去3點生命。\\n−3：目標生物得-X/-X 直到回合結束，X 為你墳墓場中牌的數量。\\n−7：你獲得具有「在你回合的戰鬥開始時，將目標生物牌在你的操控下從墳墓場放進戰場。它獲得敏捷異能」的徽記。\', \'type\': \'傳奇鵬洛客 ～莉蓮娜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488236&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'421d8a25-f037-456a-a7fa-62f1d807de7e\', \'multiverseId\': 488236}, \'multiverseid\': 488236}]', '[{\'name\': \'Liliana, Erweckerin der Toten\', \'text\': \'+1: Jeder Spieler wirft eine Karte ab. Jeder Gegner, der dies nicht kann, verliert 3 Lebenspunkte.\\n−3: Eine Kreatur deiner Wahl erhält bis zum Ende des Zuges -X/-X, wobei X gleich der Anzahl an Karten in deinem Friedhof ist.\\n−7: Du erhältst ein Emblem mit „Zu Beginn des Kampfes in deinem Zug bringst du eine Kreaturenkarte deiner Wahl aus einem Friedhof unter deiner Kontrolle ins Spiel. Sie erhält Eile."\', \'type\': \'Legendärer Planeswalker — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485690&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'910ee1d2-36ca-499b-8f86-8bcfd6c9b3ef\', \'multiverseId\': 485690}, \'multiverseid\': 485690}, {\'name\': \'Liliana, Despertadora de los Muertos\', \'text\': \'+1: Cada jugador descarta una carta. Cada oponente que no pueda hacerlo pierde 3 vidas.\\n−3: La criatura objetivo obtiene -X/-X hasta el final del turno, donde X es la cantidad de cartas en tu cementerio.\\n−7: Obtienes un emblema con "Al comienzo del combate en tu turno, pon en el campo de batalla bajo tu control la carta de criatura objetivo de un cementerio. Gana la habilidad de prisa".\', \'type\': \'Planeswalker legendario — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485949&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e469dce7-603e-42da-89da-9ae80134fc0f\', \'multiverseId\': 485949}, \'multiverseid\': 485949}, {\'name\': \'Liliana, éveilleuse des morts\', \'text\': "+1: Chaque joueur se défausse d\'une carte. Chaque adversaire qui ne peut pas le faire perd 3 points de vie.\\n-3: La créature ciblée gagne -X/-X jusqu\'à la fin du tour, X étant le nombre de cartes dans votre cimetière.\\n-7: Vous gagnez un emblème avec « Au début du combat pendant votre tour, mettez sur le champ de bataille, sous votre contrôle, une carte de créature ciblée depuis un cimetière. Elle acquiert la célérité. »", \'type\': \'Planeswalker légendaire : Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486208&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ecd74d62-e63e-4ddf-8e4c-92ffdee07ae0\', \'multiverseId\': 486208}, \'multiverseid\': 486208}, {\'name\': \'Liliana, Risvegliatrice dei Morti\', \'text\': \'+1: Ogni giocatore scarta una carta. Ogni avversario che non può farlo perde 3 punti vita.\\n-3: Una creatura bersaglio prende -X/-X fino alla fine del turno, dove X è il numero di carte nel tuo cimitero.\\n-7: Ottieni un emblema con "All\\\'inizio del combattimento nel tuo turno, metti sul campo di battaglia sotto il tuo controllo una carta creatura bersaglio da un cimitero. Ha rapidità".\', \'type\': \'Planeswalker Leggendario — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486467&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'aee5f949-c548-416f-9309-abff275d85e9\', \'multiverseId\': 486467}, \'multiverseid\': 486467}, {\'name\': \'死者を目覚めさせる者、リリアナ\', \'text\': \'+1：各プレイヤーはそれぞれカード１枚を捨てる。そうできなかった各対戦相手はそれぞれ３点のライフを失う。\\n-3：クリーチャー１体を対象とする。ターン終了時まで、それは－Ｘ/－Ｘの修整を受ける。Ｘはあなたの墓地にあるカードの枚数に等しい。\\n-7：あなたは「あなたのターンの戦闘の開始時に、墓地からクリーチャー・カード１枚を対象とし、それをあなたのコントロール下で戦場に出す。それは速攻を得る。」を持つ紋章を得る。\', \'type\': \'伝説のプレインズウォーカー — リリアナ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486726&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1654d08f-6a20-47c7-8bee-c876b35abf0e\', \'multiverseId\': 486726}, \'multiverseid\': 486726}, {\'name\': \'망자를 깨우는 자, 릴리아나\', \'text\': \'+1: 각 플레이어는 카드 한 장을 버린다. 그렇게 할 수 없는 각 상대는 생명 3점을 잃는다.\\n−3: 생물을 목표로 정한다. 그 생물은 턴종료까지 -X/-X를 받는다. X는 당신의 무덤에 있는 카드 수이다.\\n−7: 당신은 "당신의 턴 전투 시작에, 무덤에 있는 생물 카드를 목표로 정한다. 그 카드를 당신의 조종하에 전장에 놓는다. 그 카드는 신속을 얻는다."를 가진 휘장을 얻는다.\', \'type\': \'전설적 플레인즈워커 — 릴리아나\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486985&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3979a3ae-4a08-4907-b0f2-b2528ac75552\', \'multiverseId\': 486985}, \'multiverseid\': 486985}, {\'name\': \'Liliana, Despertadora dos Mortos\', \'text\': \'+1: Cada jogador descarta um card. Cada oponente que não puder fazê-lo perde 3 pontos de vida.\\n−3: A criatura alvo recebe -X/-X até o final do turno, sendo X o número de cards em seu cemitério.\\n−7: Você recebe um emblema com "No início do combate no seu turno, coloque o card de criatura alvo de um cemitério no campo de batalha sob seu controle. Ele ganha ímpeto."\', \'type\': \'Planeswalker Lendário — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487244&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'72428f50-6798-491f-b435-d59c3969804d\', \'multiverseId\': 487244}, \'multiverseid\': 487244}, {\'name\': \'Лилиана, Пробуждающая Мертвых\', \'text\': \'+1: каждый игрок сбрасывает карту. Каждый оппонент, который не может этого сделать, теряет 3 жизни.\\n−3: целевое существо получает -X/-X до конца хода, где Х — количество карт на вашем кладбище.\\n−7: вы получаете эмблему со способностью «В начале боя во время вашего хода положите целевую карту существа из кладбища на поле битвы под вашим контролем. Она получает Ускорение».\', \'type\': \'Легендарный Planeswalker — Лилиана\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487503&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d951dcfd-ed0d-4e23-aeb8-3331aab80ae3\', \'multiverseId\': 487503}, \'multiverseid\': 487503}, {\'name\': \'醒亡莉莲娜\', \'text\': \'+1：每位牌手各弃一张牌。每位无法如此作的对手各失去3点生命。\\n-3：目标生物得-X/-X直到回合结束，X为你坟墓场中牌的数量。\\n-7：你获得具有「在你回合的战斗开始时，将目标生物牌在你的操控下从坟墓场放进战场。它获得敏捷异能」的徽记。\', \'type\': \'传奇鹏洛客 ～莉莲娜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487762&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1e270439-7d5c-41fc-a244-f3901e88896f\', \'multiverseId\': 487762}, \'multiverseid\': 487762}, {\'name\': \'醒亡莉蓮娜\', \'text\': \'+1：每位玩家各棄一張牌。每位無法如此作的對手各失去3點生命。\\n−3：目標生物得-X/-X直到回合結束，X為你墳墓場中牌的數量。\\n−7：你獲得具有「在你回合的戰鬥開始時，將目標生物牌在你的操控下從墳墓場放進戰場。它獲得敏捷異能」的徽記。\', \'type\': \'傳奇鵬洛客 ～莉蓮娜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488021&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'07a9f350-7515-4465-8469-9d91c0d8b5cb\', \'multiverseId\': 488021}, \'multiverseid\': 488021}]', '[{\'name\': \'Liliana, Erweckerin der Toten\', \'text\': \'+1: Jeder Spieler wirft eine Karte ab. Jeder Gegner, der dies nicht kann, verliert 3 Lebenspunkte.\\n−3: Eine Kreatur deiner Wahl erhält bis zum Ende des Zuges -X/-X, wobei X gleich der Anzahl an Karten in deinem Friedhof ist.\\n−7: Du erhältst ein Emblem mit „Zu Beginn des Kampfes in deinem Zug bringst du eine Kreaturenkarte deiner Wahl aus einem Friedhof unter deiner Kontrolle ins Spiel. Sie erhält Eile."\', \'type\': \'Legendärer Planeswalker — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488937&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fe13135d-ff0c-4419-a527-3319baead4b7\', \'multiverseId\': 488937}, \'multiverseid\': 488937}, {\'name\': \'Liliana, Despertadora de los Muertos\', \'text\': \'+1: Cada jugador descarta una carta. Cada oponente que no pueda hacerlo pierde 3 vidas.\\n−3: La criatura objetivo obtiene -X/-X hasta el final del turno, donde X es la cantidad de cartas en tu cementerio.\\n−7: Obtienes un emblema con "Al comienzo del combate en tu turno, pon en el campo de batalla bajo tu control la carta de criatura objetivo de un cementerio. Gana la habilidad de prisa".\', \'type\': \'Planeswalker legendario — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488961&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a75338ec-eecf-459a-8ec3-81aac6486052\', \'multiverseId\': 488961}, \'multiverseid\': 488961}, {\'name\': \'Liliana, éveilleuse des morts\', \'text\': "+1: Chaque joueur se défausse d\'une carte. Chaque adversaire qui ne peut pas le faire perd 3 points de vie.\\n-3: La créature ciblée gagne -X/-X jusqu\'à la fin du tour, X étant le nombre de cartes dans votre cimetière.\\n-7: Vous gagnez un emblème avec « Au début du combat pendant votre tour, mettez sur le champ de bataille, sous votre contrôle, une carte de créature ciblée depuis un cimetière. Elle acquiert la célérité. »", \'type\': \'Planeswalker légendaire : Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488985&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'24670ef4-f85c-43ce-9902-2513c3628d99\', \'multiverseId\': 488985}, \'multiverseid\': 488985}, {\'name\': \'Liliana, Risvegliatrice dei Morti\', \'text\': \'+1: Ogni giocatore scarta una carta. Ogni avversario che non può farlo perde 3 punti vita.\\n-3: Una creatura bersaglio prende -X/-X fino alla fine del turno, dove X è il numero di carte nel tuo cimitero.\\n-7: Ottieni un emblema con "All\\\'inizio del combattimento nel tuo turno, metti sul campo di battaglia sotto il tuo controllo una carta creatura bersaglio da un cimitero. Ha rapidità".\', \'type\': \'Planeswalker Leggendario — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489009&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c48e0ba7-2b08-4c91-aca0-b2969f5702f3\', \'multiverseId\': 489009}, \'multiverseid\': 489009}, {\'name\': \'死者を目覚めさせる者、リリアナ\', \'text\': \'+1：各プレイヤーはそれぞれカード１枚を捨てる。そうできなかった各対戦相手はそれぞれ３点のライフを失う。\\n-3：クリーチャー１体を対象とする。ターン終了時まで、それは－Ｘ/－Ｘの修整を受ける。Ｘはあなたの墓地にあるカードの枚数に等しい。\\n-7：あなたは「あなたのターンの戦闘の開始時に、墓地からクリーチャー・カード１枚を対象とし、それをあなたのコントロール下で戦場に出す。それは速攻を得る。」を持つ紋章を得る。\', \'type\': \'伝説のプレインズウォーカー — リリアナ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489033&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d8ec253f-8d19-42b8-83ef-44d5a7496447\', \'multiverseId\': 489033}, \'multiverseid\': 489033}, {\'name\': \'망자를 깨우는 자, 릴리아나\', \'text\': \'+1: 각 플레이어는 카드 한 장을 버린다. 그렇게 할 수 없는 각 상대는 생명 3점을 잃는다.\\n−3: 생물을 목표로 정한다. 그 생물은 턴종료까지 -X/-X를 받는다. X는 당신의 무덤에 있는 카드 수이다.\\n−7: 당신은 "당신의 턴 전투 시작에, 무덤에 있는 생물 카드를 목표로 정한다. 그 카드를 당신의 조종하에 전장에 놓는다. 그 카드는 신속을 얻는다."를 가진 휘장을 얻는다.\', \'type\': \'전설적 플레인즈워커 — 릴리아나\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489057&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'aa680939-fc49-4ca5-b9a4-149d0ca43190\', \'multiverseId\': 489057}, \'multiverseid\': 489057}, {\'name\': \'Liliana, Despertadora dos Mortos\', \'text\': \'+1: Cada jogador descarta um card. Cada oponente que não puder fazê-lo perde 3 pontos de vida.\\n−3: A criatura alvo recebe -X/-X até o final do turno, sendo X o número de cards em seu cemitério.\\n−7: Você recebe um emblema com "No início do combate no seu turno, coloque o card de criatura alvo de um cemitério no campo de batalha sob seu controle. Ele ganha ímpeto."\', \'type\': \'Planeswalker Lendário — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489081&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'67115074-5c25-42c9-9994-f74265723f41\', \'multiverseId\': 489081}, \'multiverseid\': 489081}, {\'name\': \'Лилиана, Пробуждающая Мертвых\', \'text\': \'+1: каждый игрок сбрасывает карту. Каждый оппонент, который не может этого сделать, теряет 3 жизни.\\n−3: целевое существо получает -X/-X до конца хода, где Х — количество карт на вашем кладбище.\\n−7: вы получаете эмблему со способностью «В начале боя во время вашего хода положите целевую карту существа из кладбища на поле битвы под вашим контролем. Она получает Ускорение».\', \'type\': \'Легендарный Planeswalker — Лилиана\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489105&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'83277bc6-8351-441b-bd77-f49df6fcfb30\', \'multiverseId\': 489105}, \'multiverseid\': 489105}, {\'name\': \'醒亡莉莲娜\', \'text\': \'+1：每位牌手各弃一张牌。每位无法如此作的对手各失去3点生命。\\n-3：目标生物得-X/-X直到回合结束，X为你坟墓场中牌的数量。\\n-7：你获得具有「在你回合的战斗开始时，将目标生物牌在你的操控下从坟墓场放进战场。它获得敏捷异能」的徽记。\', \'type\': \'传奇鹏洛客 ～莉莲娜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489129&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'90c0e2f8-5275-4432-bf9d-2969b0c83f4a\', \'multiverseId\': 489129}, \'multiverseid\': 489129}, {\'name\': \'醒亡莉蓮娜\', \'text\': \'+1：每位玩家各棄一張牌。每位無法如此作的對手各失去3點生命。\\n−3：目標生物得-X/-X直到回合結束，X為你墳墓場中牌的數量。\\n−7：你獲得具有「在你回合的戰鬥開始時，將目標生物牌在你的操控下從墳墓場放進戰場。它獲得敏捷異能」的徽記。\', \'type\': \'傳奇鵬洛客 ～莉蓮娜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489153&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c9f681e9-2751-4e45-b34c-57ff3f93565f\', \'multiverseId\': 489153}, \'multiverseid\': 489153}]', '[{\'name\': \'Liliana, Magierin des Todes\', \'text\': \'+1: Bringe bis zu eine Kreaturenkarte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\\n−3: Zerstöre eine Kreatur deiner Wahl. Ihr Beherrscher verliert 2 Lebenspunkte.\\n−7: Ein Gegner deiner Wahl verliert für jede Kreaturenkarte in seinem Friedhof 2 Lebenspunkte.\', \'type\': \'Legendärer Planeswalker — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488654&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4a8bac19-5497-4275-ac60-9c03931e81de\', \'multiverseId\': 488654}, \'multiverseid\': 488654}, {\'name\': \'Liliana, maga de la muerte\', \'text\': \'+1: Regresa hasta una carta de criatura objetivo de tu cementerio a tu mano.\\n−3: Destruye la criatura objetivo. Su controlador pierde 2 vidas.\\n−7: El oponente objetivo pierde 2 vidas por cada carta de criatura en su cementerio.\', \'type\': \'Planeswalker legendario — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488674&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3ecdc665-ab77-4737-90c9-7a6bc68f47e2\', \'multiverseId\': 488674}, \'multiverseid\': 488674}, {\'name\': \'Liliana, mage de mort\', \'text\': "+1: Renvoyez jusqu\'à une carte de créature ciblée depuis votre cimetière dans votre main.\\n-3: Détruisez la créature ciblée. Son contrôleur perd 2 points de vie.\\n-7: L\'adversaire ciblé perd 2 points de vie pour chaque carte de créature dans son cimetière.", \'type\': \'Planeswalker légendaire : Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488694&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9bac2815-229b-4b2b-bb01-d73860c276a0\', \'multiverseId\': 488694}, \'multiverseid\': 488694}, {\'name\': \'Liliana, Maga della Morte\', \'text\': \'+1: Riprendi in mano fino a una carta creatura bersaglio dal tuo cimitero.\\n-3: Distruggi una creatura bersaglio. Il suo controllore perde 2 punti vita.\\n-7: Un avversario bersaglio perde 2 punti vita per ogni carta creatura nel suo cimitero.\', \'type\': \'Planeswalker Leggendario — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488714&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'18450ea0-1944-4910-bac5-c35026167d19\', \'multiverseId\': 488714}, \'multiverseid\': 488714}, {\'name\': \'死の魔道士、リリアナ\', \'text\': \'+1：あなたの墓地からクリーチャー・カード最大１枚を対象とし、それをあなたの手札に戻す。\\n-3：クリーチャー１体を対象とし、それを破壊する。それのコントローラーは２点のライフを失う。\\n-7：対戦相手１人を対象とする。そのプレイヤーは自分の墓地にあるクリーチャー・カード１枚につき２点のライフを失う。\', \'type\': \'伝説のプレインズウォーカー — リリアナ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488734&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0ad3b4af-8987-46b1-8bb6-2d18cd336954\', \'multiverseId\': 488734}, \'multiverseid\': 488734}, {\'name\': \'죽음 마도사, 릴리아나\', \'text\': \'+1: 당신의 무덤에 있는 생물 카드를 최대 한 장까지 목표로 정한다. 그 카드를 당신의 손으로 되돌린다.\\n−3: 생물을 목표로 정한다. 그 생물을 파괴한다. 그 생물의 조종자는 생명 2점을 잃는다.\\n−7: 상대를 목표로 정한다. 그 플레이어는 자신의 무덤에 있는 생물 카드 한 장당 생명 2점을 잃는다.\', \'type\': \'전설적 플레인즈워커 — 릴리아나\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488754&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c91fab27-81eb-45ba-b1c5-f28e1c6b94b5\', \'multiverseId\': 488754}, \'multiverseid\': 488754}, {\'name\': \'Liliana, Maga da Morte\', \'text\': \'+1: Devolva até um card de criatura alvo de seu cemitério para sua mão.\\n−3: Destrua a criatura alvo. Seu controlador perde 2 pontos de vida.\\n−7: O oponente alvo perde 2 pontos de vida para cada card de criatura no próprio cemitério.\', \'type\': \'Planeswalker Lendário — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488774&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d4989232-4774-4e50-94c0-c095a03d9b6d\', \'multiverseId\': 488774}, \'multiverseid\': 488774}, {\'name\': \'Лилиана, Маг Смерти\', \'text\': \'+1: верните не более одной целевой карты существа из вашего кладбища в вашу руку.\\n—3: уничтожьте целевое существо. Контролирующий его игрок теряет 2 жизни.\\n−7: целевой оппонент теряет по 2 жизни за каждую карту существа на своем кладбище.\', \'type\': \'Легендарный Planeswalker — Лилиана\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488794&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6158268c-cc6a-4374-8028-7be81652943c\', \'multiverseId\': 488794}, \'multiverseid\': 488794}, {\'name\': \'死亡法师莉莲娜\', \'text\': \'+1：将至多一张目标生物牌从你的坟墓场移回你手上。\\n−3：消灭目标生物。其操控者失去2点生命。\\n−7：目标对手的坟墓场中每有一张生物牌，他便失去2点生命。\', \'type\': \'传奇鹏洛客 ～莉莲娜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488814&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7e2db099-f3cc-44d3-9ac9-c923dc3be1f0\', \'multiverseId\': 488814}, \'multiverseid\': 488814}, {\'name\': \'死亡法師莉蓮娜\', \'text\': \'+1：將至多一張目標生物牌從你的墳墓場移回你手上。\\n-3：消滅目標生物。其操控者失去2點生命。\\n−7：目標對手的墳墓場中每有一張生物牌，他便失去2點生命。\', \'type\': \'傳奇鵬洛客 ～莉蓮娜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488834&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6a9f2f95-632f-43f1-ba98-b79fcb28eb14\', \'multiverseId\': 488834}, \'multiverseid\': 488834}]', '[{\'name\': \'Lilianas Bannerträger\', \'text\': \'Aufblitzen\\nWenn Lilianas Bannerträger ins Spiel kommt, ziehe X Karten, wobei X gleich der Anzahl an Kreaturen ist, die in diesem Zug unter deiner Kontrolle gestorben sind.\', \'type\': \'Kreatur — Zombie, Ritter\', \'flavor\': \'Das violette Banner des Hauses Vess ist ein Symbol des Todes, wo auch immer es weht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485692&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c12abe3b-f279-45d0-8da4-745d303e3a33\', \'multiverseId\': 485692}, \'multiverseid\': 485692}, {\'name\': \'Abanderado de Liliana\', \'text\': \'Destello.\\nCuando el Abanderado de Liliana entre al campo de batalla, roba X cartas, donde X es la cantidad de criaturas que murieron bajo tu control este turno.\', \'type\': \'Criatura — Caballero zombie\', \'flavor\': \'Allá donde se ondee, la bandera morada de la casa Vess es un símbolo de muerte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485951&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e2f5208a-5d04-431e-92da-0fe52f4fb070\', \'multiverseId\': 485951}, \'multiverseid\': 485951}, {\'name\': \'Porte-étendard de Liliana\', \'text\': \'Flash\\nQuand le Porte-étendard de Liliana arrive sur le champ de bataille, piochez X cartes, X étant le nombre de créatures qui sont mortes sous votre contrôle ce tour-ci.\', \'type\': \'Créature : zombie et chevalier\', \'flavor\': "La bannière violette de la maison Vess symbolise la mort où qu\'elle soit hissée.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486210&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f2d656c3-6086-4c7e-8e6c-823d711674d1\', \'multiverseId\': 486210}, \'multiverseid\': 486210}, {\'name\': \'Alfiere di Liliana\', \'text\': "Lampo\\nQuando l\'Alfiere di Liliana entra nel campo di battaglia, pesca X carte, dove X è il numero di creature che sono morte sotto il tuo controllo in questo turno.", \'type\': \'Creatura — Cavaliere Zombie\', \'flavor\': \'Lo stendardo viola della Casa dei Vess è un simbolo di morte ovunque sventoli.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486469&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6c6fe4ec-d435-4cc8-8efe-25cfc5b85ac7\', \'multiverseId\': 486469}, \'multiverseid\': 486469}, {\'name\': \'リリアナの軍旗手\', \'text\': \'瞬速\\nリリアナの軍旗手が戦場に出たとき、カードをＸ枚引く。Ｘはこのターンにあなたのコントロール下で死亡したクリーチャーの総数に等しい。\', \'type\': \'クリーチャー — ゾンビ・騎士\', \'flavor\': \'ヴェス家の紫色の旗は、どこに翻るとしても死の象徴である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486728&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4b10ac84-5842-42b3-9d56-0575e530b984\', \'multiverseId\': 486728}, \'multiverseid\': 486728}, {\'name\': \'릴리아나의 기수\', \'text\': \'섬광\\n릴리아나의 기수가 전장에 들어올 때, 카드 X장을 뽑는다. X는 이번 턴에 당신의 조종하에 죽은 생물의 수이다.\', \'type\': \'생물 — 좀비 기사\', \'flavor\': \'베스 가문의 보라색 깃발은 그것이 휘날려지는 곳이 어디든 죽음을 상징한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486987&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5ce00da2-a5bb-4bf9-b637-f08e3f417161\', \'multiverseId\': 486987}, \'multiverseid\': 486987}, {\'name\': \'Porta-estandarte de Liliana\', \'text\': \'Lampejo\\nQuando Porta-estandarte de Liliana entrar no campo de batalha, compre X cards, sendo X o número de criaturas que morreram sob seu controle neste turno.\', \'type\': \'Criatura — Zumbi Cavaleiro\', \'flavor\': \'O estandarte púrpura da Casa de Vess é símbolo de morte onde quer que se desfralde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487246&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bee20bfa-6e6e-465f-b033-a70ace1d1153\', \'multiverseId\': 487246}, \'multiverseid\': 487246}, {\'name\': \'Знаменосец Лилианы\', \'text\': \'Миг\\nКогда Знаменосец Лилианы выходит на поле битвы, возьмите X карт, где X — количество существ, умерших под вашим контролем в этом ходу.\', \'type\': \'Существо — Зомби Рыцарь\', \'flavor\': \'Фиолетовое знамя дома Весс — символ смерти повсюду, где оно развевается.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487505&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'45a9afb6-ad5b-4b00-a879-25a44fc9ab08\', \'multiverseId\': 487505}, \'multiverseid\': 487505}, {\'name\': \'莉莲娜的旗手\', \'text\': \'闪现\\n当莉莲娜的旗手进战场时，抓X张牌，X为本回合中在你的操控下死去之生物数量。\', \'type\': \'生物 ～灵俑／骑士\', \'flavor\': \'维斯家族紫色旗帜飘扬之处，即象征死亡来到。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487764&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'18cc3709-6b89-4800-916b-2bf47131b806\', \'multiverseId\': 487764}, \'multiverseid\': 487764}, {\'name\': \'莉蓮娜的旗手\', \'text\': \'閃現\\n當莉蓮娜的旗手進戰場時，抽X張牌，X為本回合中在你的操控下死去之生物數量。\', \'type\': \'生物 ～殭屍／騎士\', \'flavor\': \'維斯家族紫色旗幟飄揚之處，即象徵死亡來到。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488023&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'65fa05b3-2d0a-4b5c-80f1-79cd530e01ce\', \'multiverseId\': 488023}, \'multiverseid\': 488023}]', '[{\'name\': \'Lilianas Bannerträger\', \'text\': \'Aufblitzen\\nWenn Lilianas Bannerträger ins Spiel kommt, ziehe X Karten, wobei X gleich der Anzahl an Kreaturen ist, die in diesem Zug unter deiner Kontrolle gestorben sind.\', \'type\': \'Kreatur — Zombie, Ritter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488939&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5469cf8e-1fa4-4607-a491-105d748dfc0b\', \'multiverseId\': 488939}, \'multiverseid\': 488939}, {\'name\': \'Abanderado de Liliana\', \'text\': \'Destello.\\nCuando el Abanderado de Liliana entre al campo de batalla, roba X cartas, donde X es la cantidad de criaturas que murieron bajo tu control este turno.\', \'type\': \'Criatura — Caballero zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488963&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'66bd1018-ab71-48b8-848f-670b3025c459\', \'multiverseId\': 488963}, \'multiverseid\': 488963}, {\'name\': \'Porte-étendard de Liliana\', \'text\': \'Flash\\nQuand le Porte-étendard de Liliana arrive sur le champ de bataille, piochez X cartes, X étant le nombre de créatures qui sont mortes sous votre contrôle ce tour-ci.\', \'type\': \'Créature : zombie et chevalier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488987&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b763b087-b6d5-46e2-94fc-6852cabac1e4\', \'multiverseId\': 488987}, \'multiverseid\': 488987}, {\'name\': \'Alfiere di Liliana\', \'text\': "Lampo\\nQuando l\'Alfiere di Liliana entra nel campo di battaglia, pesca X carte, dove X è il numero di creature che sono morte sotto il tuo controllo in questo turno.", \'type\': \'Creatura — Cavaliere Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489011&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'85e65250-a52d-4cc5-9d37-10bae0f64e20\', \'multiverseId\': 489011}, \'multiverseid\': 489011}, {\'name\': \'リリアナの軍旗手（しゅ\', \'text\': \'瞬速\\nリリアナの軍旗手が戦場に出たとき、カードをＸ枚引く。Ｘはこのターンにあなたのコントロール下で死亡したクリーチャーの総数に等しい。\', \'type\': \'クリーチャー — ゾンビ・騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489035&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1b869d31-1f61-4db1-903f-127cf0ebba62\', \'multiverseId\': 489035}, \'multiverseid\': 489035}, {\'name\': \'릴리아나의 기수\', \'text\': \'섬광\\n릴리아나의 기수가 전장에 들어올 때, 카드 X장을 뽑는다. X는 이번 턴에 당신의 조종하에 죽은 생물의 수이다.\', \'type\': \'생물 — 좀비 기사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489059&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f25f64ac-431e-4fd5-af00-34adb5904dc8\', \'multiverseId\': 489059}, \'multiverseid\': 489059}, {\'name\': \'Porta-estandarte de Liliana\', \'text\': \'Lampejo\\nQuando Porta-estandarte de Liliana entrar no campo de batalha, compre X cards, sendo X o número de criaturas que morreram sob seu controle neste turno.\', \'type\': \'Criatura — Zumbi Cavaleiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489083&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9ed0b064-2073-4fc1-a097-b1ef09b45829\', \'multiverseId\': 489083}, \'multiverseid\': 489083}, {\'name\': \'Знаменосец Лилианы\', \'text\': \'Миг\\nКогда Знаменосец Лилианы выходит на поле битвы, возьмите X карт, где X — количество существ, умерших под вашим контролем в этом ходу.\', \'type\': \'Существо — Зомби Рыцарь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489107&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d31a9d33-d825-41ff-b00f-679e14eb3a2f\', \'multiverseId\': 489107}, \'multiverseid\': 489107}, {\'name\': \'莉莲娜的旗手\', \'text\': \'闪现\\n当莉莲娜的旗手进战场时，抓X张牌，X为本回合中在你的操控下死去之生物数量。\', \'type\': \'生物 ～灵俑／骑士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489131&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a6afb980-bec8-420b-8bd1-6acd89741cbe\', \'multiverseId\': 489131}, \'multiverseid\': 489131}, {\'name\': \'莉蓮娜的旗手\', \'text\': \'閃現\\n當莉蓮娜的旗手進戰場時，抽X張牌，X為本回合中在你的操控下死去之生物數量。\', \'type\': \'生物 ～殭屍／騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489155&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e98220c0-78a2-454c-9d76-f5d913cac619\', \'multiverseId\': 489155}, \'multiverseid\': 489155}]', '[{\'name\': \'Lilianas Leichensammlerin\', \'text\': \'Zu Beginn jedes Endsegments und falls in diesem Zug eine Kreatur gestorben ist, kannst du eine Loyalitätsmarke auf einen Liliana-Planeswalker, den du kontrollierst, legen.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'„Dieser Arm ist noch zu gebrauchen. Wer wirft so etwas nur weg?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488656&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0ff718b4-320f-4b22-8def-4ef5b0aeede1\', \'multiverseId\': 488656}, \'multiverseid\': 488656}, {\'name\': \'Recuperadora de Liliana\', \'text\': \'Al comienzo de cada paso final, si una criatura murió este turno, puedes poner un contador de lealtad sobre un planeswalker Liliana que controles.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'"A este brazo aún se le pueden dar muchos usos. ¿Quién tiraría algo tan bueno?".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488676&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0bc0049e-7f55-48c8-aa32-efe40e670043\', \'multiverseId\': 488676}, \'multiverseid\': 488676}, {\'name\': \'Fouineuse de Liliana\', \'text\': \'Au début de chaque étape de fin, si une créature est morte ce tour-ci, vous pouvez mettre un marqueur « loyauté » sur un planeswalker Liliana que vous contrôlez.\', \'type\': \'Créature : humain et sorcier\', \'flavor\': \'« Ce bras peut encore servir. Qui peut jeter une aussi belle chose ? »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488696&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0102a92a-6dee-4cdb-a846-633862f9d240\', \'multiverseId\': 488696}, \'multiverseid\': 488696}, {\'name\': \'Sciacalla di Liliana\', \'text\': "All\'inizio di ogni sottofase finale, se è morta una creatura in questo turno, puoi mettere un segnalino fedeltà su un planeswalker Liliana che controlli.", \'type\': \'Creatura — Mago Umano\', \'flavor\': \'"Questo braccio è ancora perfettamente utilizzabile. Chi getterebbe via un tesoro del genere?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488716&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a54b7fbc-ceca-46ed-9869-f1280844efdb\', \'multiverseId\': 488716}, \'multiverseid\': 488716}, {\'name\': \'リリアナのたかり屋\', \'text\': \'各終了ステップの開始時に、このターンにクリーチャーが死亡していた場合、あなたはあなたがコントロールしているリリアナ・プレインズウォーカーの上に忠誠カウンターを１個置いてもよい。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'「この腕にはまだ使い道がたくさんある。こんなに良い物を誰が捨てるものか。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488736&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d2152278-f1cb-47b3-85bd-8e20547d900e\', \'multiverseId\': 488736}, \'multiverseid\': 488736}, {\'name\': \'릴리아나의 폐품수집가\', \'text\': \'각 종료단 시작에, 이번 턴에 생물이 죽었다면, 당신은 당신이 조종하는 릴리아나 플레인즈워커 한 개에 충성 카운터 한 개를 올려놓을 수 있다.\', \'type\': \'생물 — 인간 마법사\', \'flavor\': \'"이 팔은 아직 쓸모가 아주 많아. 누가 이렇게 좋은 물건을 버리겠어?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488756&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4cd71805-a558-4448-bc00-9423b183aa8d\', \'multiverseId\': 488756}, \'multiverseid\': 488756}, {\'name\': \'Captadora de Liliana\', \'text\': \'No início de cada etapa final, se uma criatura morreu neste turno, você pode colocar um marcador de lealdade em uma planeswalker Liliana que você controla.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'"Esse braço ainda tem muita utilidade. Quem jogaria um negócio desse fora?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488776&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'504aecdf-6e4e-4bae-9da5-7c03e23488e3\', \'multiverseId\': 488776}, \'multiverseid\': 488776}, {\'name\': \'Расхитительница Лилианы\', \'text\': "В начале каждого заключительного шага, если в этом ходу умерло существо, вы можете положить один жетон верности на planeswalker\'а Лилиану под вашим контролем.", \'type\': \'Существо — Человек Чародей\', \'flavor\': \'«Да этой руке еще работать и работать. Кто же такое выбрасывает?!»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488796&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c191e9aa-f80b-4f09-9385-68a842e00b75\', \'multiverseId\': 488796}, \'multiverseid\': 488796}, {\'name\': \'莉莲娜的搜刮师\', \'text\': \'在每个结束步骤开始时，若本回合有生物死去，则你可以在一个由你操控的莉莲娜鹏洛客上放置一个忠诚指示物。\', \'type\': \'生物 ～人类／法术师\', \'flavor\': \'「这条手臂还有不少用处。把好好的东西扔掉岂不是太浪费？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488816&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fcf95c1f-d74f-4305-ab6d-3fad726a7045\', \'multiverseId\': 488816}, \'multiverseid\': 488816}, {\'name\': \'莉蓮娜的搜刮師\', \'text\': \'在每個結束步驟開始時，若本回合有生物死去，則你可以在一個由你操控的莉蓮娜鵬洛客上放置一個忠誠指示物。\', \'type\': \'生物 ～人類／魔法師\', \'flavor\': \'「這條手臂還有不少用處。把好好的東西扔掉豈不是太浪費？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488836&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'53dadf04-3bad-4849-b4b5-f9d5aebd1b0a\', \'multiverseId\': 488836}, \'multiverseid\': 488836}]', '[{\'name\': \'Lilianas Tadel\', \'text\': \'Zerstöre eine Kreatur deiner Wahl. Du kannst deine Bibliothek und/oder deinen Friedhof nach einer Karte namens Liliana, Magierin des Todes, durchsuchen, sie offen vorzeigen und auf deine Hand nehmen. Falls du auf diese Weise deine Bibliothek durchsuchst, mische sie danach.\', \'type\': \'Hexerei\', \'flavor\': \'„Wir sind hier fertig."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488655&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5ae21b9d-1d9b-4f6f-8599-9db20fb8cd1b\', \'multiverseId\': 488655}, \'multiverseid\': 488655}, {\'name\': \'Desprecio de Liliana\', \'text\': \'Destruye la criatura objetivo. Puedes buscar en tu biblioteca y/o cementerio una carta llamada Liliana, maga de la muerte, mostrarla y ponerla en tu mano. Si buscas en tu biblioteca de esta manera, barájala.\', \'type\': \'Conjuro\', \'flavor\': \'"Ya no queda nada más por hacer".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488675&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'db0b7b7c-67df-474d-9457-71a0f9b84faf\', \'multiverseId\': 488675}, \'multiverseid\': 488675}, {\'name\': \'Mépris selon Liliana\', \'text\': \'Détruisez la créature ciblée. Vous pouvez chercher dans votre bibliothèque et/ou votre cimetière une carte appelée Liliana, mage de mort, la révéler et la mettre dans votre main. Si vous cherchez dans votre bibliothèque de cette manière, mélangez-la.\', \'type\': \'Rituel\', \'flavor\': \'« Nous en avons terminé. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488695&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'29820a63-2f55-44dc-8d59-231387b4f864\', \'multiverseId\': 488695}, \'multiverseid\': 488695}, {\'name\': \'Sdegno di Liliana\', \'text\': \'Distruggi una creatura bersaglio. Puoi passare in rassegna il tuo grimorio e/o il tuo cimitero per una carta chiamata Liliana, Maga della Morte, rivelarla e aggiungerla alla tua mano. Se passi in rassegna il tuo grimorio in questo modo, rimescolalo.\', \'type\': \'Stregoneria\', \'flavor\': \'"Adesso basta!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488715&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'89020867-244e-4273-9c32-78b9e0beb7f9\', \'multiverseId\': 488715}, \'multiverseid\': 488715}, {\'name\': \'リリアナの嘲笑\', \'text\': \'クリーチャー１体を対象とし、それを破壊する。あなたは、あなたのライブラリーやあなたの墓地から「死の魔道士、リリアナ」という名前のカード１枚を探し、公開し、あなたの手札に加えてもよい。これによりあなたがあなたのライブラリーからカードを探したなら、あなたのライブラリーを切り直す。\', \'type\': \'ソーサリー\', \'flavor\': \'「ここは片付いたわね。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488735&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ead44b07-6847-49a3-9a08-dd0de64263d6\', \'multiverseId\': 488735}, \'multiverseid\': 488735}, {\'name\': \'릴리아나의 멸시\', \'text\': \'생물을 목표로 정한다. 그 생물을 파괴한다. 당신은 당신의 서고 및/또는 무덤에서 이름이 죽음 마도사, 릴리아나인 카드 한 장을 찾아, 공개한 후, 당신의 손으로 가져갈 수 있다. 당신이 이런 식으로 당신의 서고를 찾아보았다면, 당신의 서고를 섞는다.\', \'type\': \'집중마법\', \'flavor\': \'"더 이상 볼 일 없어."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488755&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c377081b-6359-492a-a613-c7dd1c2ba111\', \'multiverseId\': 488755}, \'multiverseid\': 488755}, {\'name\': \'Desprezo de Liliana\', \'text\': \'Destrua a criatura alvo. Você pode procurar um card com o nome Liliana, Maga da Morte, em seu grimório e/ou cemitério, revelá-lo e colocá-lo em sua mão. Se procurar em seu grimório desta maneira, embaralhe-o.\', \'type\': \'Feitiço\', \'flavor\': \'"Acabamos por aqui."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488775&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a695dce8-08c2-4b8b-a1b6-6b3409093e4e\', \'multiverseId\': 488775}, \'multiverseid\': 488775}, {\'name\': \'Презрение Лилианы\', \'text\': \'Уничтожьте целевое существо. Вы можете найти в вашей библиотеке и/или на вашем кладбище карту с именем Лилиана, Маг Смерти, показать ее и положить в вашу руку. Если вы ищете таким образом в вашей библиотеке, перетасуйте ее.\', \'type\': \'Волшебство\', \'flavor\': \'«Тут мы закончили».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488795&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1c28becd-6d93-4628-9e89-76e6c303cfe0\', \'multiverseId\': 488795}, \'multiverseid\': 488795}, {\'name\': \'莉莲娜的轻蔑\', \'text\': \'消灭目标生物。你可以从你的牌库和／或坟墓场中搜寻一张名称为死亡法师莉莲娜的牌，展示该牌，并将它置于你手上。如果你以此法搜寻你的牌库，则将它洗牌。\', \'type\': \'法术\', \'flavor\': \'「我们完事了。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488815&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6b9a19b0-dd68-4464-b7cf-b52243cfe506\', \'multiverseId\': 488815}, \'multiverseid\': 488815}, {\'name\': \'莉蓮娜的輕蔑\', \'text\': \'消滅目標生物。你可以從你的牌庫和／或墳墓場中搜尋一張名稱為死亡法師莉蓮娜的牌，展示該牌，並將它置於你手上。如果你以此法搜尋你的牌庫，則將它洗牌。\', \'type\': \'巫術\', \'flavor\': \'「我們完事了。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488835&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'738bfa1a-b046-451d-a82c-3bc45d554785\', \'multiverseId\': 488835}, \'multiverseid\': 488835}]', '[{\'name\': \'Lilianas Truchsess\', \'text\': \'{T}, opfere Lilianas Truchsess: Ein Gegner deiner Wahl wirft eine Karte ab. Aktiviere diese Fähigkeit nur zu einem Zeitpunkt, zu dem du auch eine Hexerei wirken könntest.\', \'type\': \'Kreatur — Zombie\', \'flavor\': \'Diener im Herrenhaus Vess werden aufgrund ihrer starken Arbeitsmoral und ihres respektvollen Verhaltens ausgewählt. Am Leben zu sein, ist nicht notwendig.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485693&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0406860a-3c4f-4782-8f76-c26eb0990ab7\', \'multiverseId\': 485693}, \'multiverseid\': 485693}, {\'name\': \'Mayordomo de Liliana\', \'text\': \'{T}, sacrificar el Mayordomo de Liliana: El oponente objetivo descarta una carta. Activa esta habilidad solo cuando puedas lanzar un conjuro.\', \'type\': \'Criatura — Zombie\', \'flavor\': \'Se elige a los sirvientes de la mansión Vess por su gran ética en el trabajo y su educada conducta. Estar vivo no es uno de los requisitos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485952&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c08a6553-73b0-4a8c-9d41-3e62270ca58b\', \'multiverseId\': 485952}, \'multiverseid\': 485952}, {\'name\': \'Intendant de Liliana\', \'text\': "{T}, sacrifiez l\'Intendant de Liliana : L\'adversaire ciblé se défausse d\'une carte. N\'activez cette capacité que lorsque vous pourriez lancer un rituel.", \'type\': \'Créature : zombie\', \'flavor\': \'Les serviteurs du manoir Vess sont choisis pour leur éthique professionnelle et leur attitude respectueuse. Être en vie est facultatif.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486211&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d9379cf1-9d68-4b47-809c-9bde3dc21811\', \'multiverseId\': 486211}, \'multiverseid\': 486211}, {\'name\': \'Attendente di Liliana\', \'text\': "{T}, Sacrifica l\'Attendente di Liliana: Un avversario bersaglio scarta una carta. Attiva questa abilità solo quando potresti lanciare una stregoneria.", \'type\': \'Creatura — Zombie\', \'flavor\': "La servitù del Maniero Vess viene selezionata per l\'inflessibile etica lavorativa e il contegno rispettoso. Essere vivi non è un requisito fondamentale.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486470&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'197c75fc-b137-4de9-bd90-3f2ef6502a94\', \'multiverseId\': 486470}, \'multiverseid\': 486470}, {\'name\': \'リリアナの使用人\', \'text\': \'{T}, リリアナの使用人を生け贄に捧げる：対戦相手１人を対象とする。そのプレイヤーはカード１枚を捨てる。この能力は、あなたがソーサリーを唱えられるときにのみ起動できる。\', \'type\': \'クリーチャー — ゾンビ\', \'flavor\': \'ヴェスの邸宅では、揺るぎない職務倫理と礼儀正しい振る舞いを重視して使用人を選ぶ。生死は問わない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486729&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a2d5a04e-eb4c-418c-add4-1a27a41f0e5d\', \'multiverseId\': 486729}, \'multiverseid\': 486729}, {\'name\': \'릴리아나의 관리인\', \'text\': \'{T}, 릴리아나의 관리인을 희생한다: 상대를 목표로 정한다. 그 상대는 카드 한 장을 버린다. 당신이 집중마법을 발동할 수 있는 시기에만 이 능력을 활성화할 수 있다.\', \'type\': \'생물 — 좀비\', \'flavor\': \'베스 저택의 하인들은 강한 직업 윤리와 공손한 태도를 고려해 선택된다. 딱히 살아있어야 할 필요는 없다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486988&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'16c7b2ed-5de8-429d-af1d-44eee9ee98c1\', \'multiverseId\': 486988}, \'multiverseid\': 486988}, {\'name\': \'Mordomo de Liliana\', \'text\': \'{T}, sacrifique Mordomo de Liliana: O oponente alvo descarta um card. Ative esta habilidade somente nos momentos em que poderia conjurar um feitiço.\', \'type\': \'Criatura — Zumbi\', \'flavor\': \'Os servos da Mansão Vess são escolhidos por sua firme ética profissional e seu comportamento respeitoso. Estarem vivos não é requisito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487247&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bc3e8319-38ff-4a8f-9d03-fe53939ff74d\', \'multiverseId\': 487247}, \'multiverseid\': 487247}, {\'name\': \'Дворецкий Лилианы\', \'text\': \'{T}, пожертвуйте Дворецкого Лилианы: целевой оппонент сбрасывает карту. Активируйте эту способность только при возможности разыгрывать волшебство.\', \'type\': \'Существо — Зомби\', \'flavor\': \'Слуг в поместье Весс отбирают, глядя на их добросовестное отношение к труду и уважительное поведение. Быть живым для этого совершенно не обязательно.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487506&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'da23d1ac-acfe-48b1-a061-9a0e24d8c063\', \'multiverseId\': 487506}, \'multiverseid\': 487506}, {\'name\': \'莉莲娜的管家\', \'text\': \'{T}，牺牲莉莲娜的管家：目标对手弃一张牌。只可以于你能施放法术的时机下起动此异能。\', \'type\': \'生物 ～灵俑\', \'flavor\': \'维斯宅邸挑选仆从，看重的是敬业态度与得体举止。至于是死是活并不重要。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487765&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c17b05f4-fc43-4b54-9d40-7fed4d1b0a64\', \'multiverseId\': 487765}, \'multiverseid\': 487765}, {\'name\': \'莉蓮娜的管家\', \'text\': \'{T}，犧牲莉蓮娜的管家：目標對手棄一張牌。只可以於你能施放巫術的時機下起動此異能。\', \'type\': \'生物 ～殭屍\', \'flavor\': \'維斯宅邸挑選僕從的重點放在敬業態度與得體舉止。至於是死是活並不重要。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488024&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'cdb4bb15-e74b-49ad-9b9c-fa453f175313\', \'multiverseId\': 488024}, \'multiverseid\': 488024}]', '[{\'name\': \'Lilianas Truchsess\', \'text\': \'{T}, opfere Lilianas Truchsess: Ein Gegner deiner Wahl wirft eine Karte ab. Aktiviere diese Fähigkeit nur zu einem Zeitpunkt, zu dem du auch eine Hexerei wirken könntest.\', \'type\': \'Kreatur — Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488940&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ff3eae24-32e0-474c-8dd0-b2b49bc1ccb9\', \'multiverseId\': 488940}, \'multiverseid\': 488940}, {\'name\': \'Mayordomo de Liliana\', \'text\': \'{T}, sacrificar el Mayordomo de Liliana: El oponente objetivo descarta una carta. Activa esta habilidad solo cuando puedas lanzar un conjuro.\', \'type\': \'Criatura — Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488964&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'30893f64-24b6-48a5-ac92-a928ad291dc0\', \'multiverseId\': 488964}, \'multiverseid\': 488964}, {\'name\': \'Intendant de Liliana\', \'text\': "{T}, sacrifiez l\'Intendant de Liliana : L\'adversaire ciblé se défausse d\'une carte. N\'activez cette capacité que lorsque vous pourriez lancer un rituel.", \'type\': \'Créature : zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488988&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'95c9969e-f163-493b-86fd-7aa7255b06b7\', \'multiverseId\': 488988}, \'multiverseid\': 488988}, {\'name\': \'Attendente di Liliana\', \'text\': "{T}, Sacrifica l\'Attendente di Liliana: Un avversario bersaglio scarta una carta. Attiva questa abilità solo quando potresti lanciare una stregoneria.", \'type\': \'Creatura — Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489012&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6deeec8f-f472-4ab3-89b2-ceaba9cdff6c\', \'multiverseId\': 489012}, \'multiverseid\': 489012}, {\'name\': \'リリアナの使用人\', \'text\': \'{T}, リリアナの使用人を生け贄に捧げる：対戦相手１人を対象とする。そのプレイヤーはカード１枚を捨てる。この能力は、あなたがソーサリーを唱えられるときにのみ起動できる。\', \'type\': \'クリーチャー — ゾンビ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489036&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ed63511f-7d7d-438b-9e05-32d2314b8b93\', \'multiverseId\': 489036}, \'multiverseid\': 489036}, {\'name\': \'릴리아나의 관리인\', \'text\': \'{T}, 릴리아나의 관리인을 희생한다: 상대를 목표로 정한다. 그 상대는 카드 한 장을 버린다. 당신이 집중마법을 발동할 수 있는 시기에만 이 능력을 활성화할 수 있다.\', \'type\': \'생물 — 좀비\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489060&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f77724e6-2992-454a-9ce9-ebc0df19bc3b\', \'multiverseId\': 489060}, \'multiverseid\': 489060}, {\'name\': \'Mordomo de Liliana\', \'text\': \'{T}, sacrifique Mordomo de Liliana: O oponente alvo descarta um card. Ative esta habilidade somente nos momentos em que poderia conjurar um feitiço.\', \'type\': \'Criatura — Zumbi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489084&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8a17b994-31eb-49ab-804b-3a4ee1598a22\', \'multiverseId\': 489084}, \'multiverseid\': 489084}, {\'name\': \'Дворецкий Лилианы\', \'text\': \'{T}, пожертвуйте Дворецкого Лилианы: целевой оппонент сбрасывает карту. Активируйте эту способность только при возможности разыгрывать волшебство.\', \'type\': \'Существо — Зомби\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489108&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d28ac641-08e9-4cc2-a57e-6fd02ff37673\', \'multiverseId\': 489108}, \'multiverseid\': 489108}, {\'name\': \'莉莲娜的管家\', \'text\': \'{T}，牺牲莉莲娜的管家：目标对手弃一张牌。只可以于你能施放法术的时机下起动此异能。\', \'type\': \'生物 ～灵俑\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489132&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'05ab974f-a48c-4b8e-8a27-e33dab386339\', \'multiverseId\': 489132}, \'multiverseid\': 489132}, {\'name\': \'莉蓮娜的管家\', \'text\': \'{T}，犧牲莉蓮娜的管家：目標對手棄一張牌。只可以於你能施放巫術的時機下起動此異能。\', \'type\': \'生物 ～殭屍\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489156&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c97a5504-9027-4efe-988e-aaef19a49289\', \'multiverseId\': 489156}, \'multiverseid\': 489156}]', '[{\'name\': \'Lilianas Verehrer\', \'text\': \'Zombies, die du kontrollierst, erhalten +1/+0.\\nZu Beginn deines Endsegments und falls in diesem Zug eine Kreatur gestorben ist, kannst du {1}{B} bezahlen. Falls du dies tust, erzeuge einen 2/2 schwarzen Zombie-Kreaturenspielstein.\', \'type\': \'Kreatur — Mensch, Hexenmeister\', \'flavor\': \'Liliana weckt den Schrecken in vielen und fanatische Bewunderung in wenigen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485691&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dc4e988b-1bf9-4132-82eb-b651be8e5015\', \'multiverseId\': 485691}, \'multiverseid\': 485691}, {\'name\': \'Devoto de Liliana\', \'text\': \'Los Zombies que controlas obtienen +1/+0.\\nAl comienzo de tu paso final, si una criatura murió este turno, puedes pagar {1}{B}. Si lo haces, crea una ficha de criatura Zombie negra 2/2.\', \'type\': \'Criatura — Brujo humano\', \'flavor\': \'Liliana inspira terror en muchos y una admiración fanática en unos pocos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485950&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ac721ea1-01ee-4426-bb8b-6bdb69f9ef1a\', \'multiverseId\': 485950}, \'multiverseid\': 485950}, {\'name\': \'Dévot de Liliana\', \'text\': \'Les zombies que vous contrôlez gagnent +1/+0.\\nAu début de votre étape de fin, si une créature est morte ce tour-ci, vous pouvez payer {1}{B}. Si vous faites ainsi, créez un jeton de créature 2/2 noire Zombie.\', \'type\': \'Créature : humain et psychagogue\', \'flavor\': "Liliana inspire la terreur chez beaucoup de monde et l\'admiration fanatique chez certains.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486209&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b8fa70ce-785f-4928-bc60-87f88cb71375\', \'multiverseId\': 486209}, \'multiverseid\': 486209}, {\'name\': \'Devoto di Liliana\', \'text\': "Gli Zombie che controlli prendono +1/+0.\\nAll\'inizio della tua sottofase finale, se è morta una creatura in questo turno, puoi pagare {1}{B}. Se lo fai, crea una pedina creatura Zombie 2/2 nera.", \'type\': \'Creatura — Warlock Umano\', \'flavor\': \'Liliana infonde terrore in molti e fanatica ammirazione in pochi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486468&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ce607081-8ce9-462c-87ea-7e9526badb5c\', \'multiverseId\': 486468}, \'multiverseid\': 486468}, {\'name\': \'リリアナの信奉者\', \'text\': \'あなたがコントロールしているゾンビは＋１/＋０の修整を受ける。\\nあなたの終了ステップの開始時に、このターンにクリーチャーが死亡していた場合、あなたは{1}{B}を支払ってもよい。そうしたなら、黒の２/２のゾンビ・クリーチャー・トークンを１体生成する。\', \'type\': \'クリーチャー — 人間・邪術師\', \'flavor\': \'リリアナは、多くの者を恐怖に陥れ、僅かな者から熱狂的な賞賛を引き出す。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486727&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bfa4275b-2db4-499a-9aa2-0353b217af30\', \'multiverseId\': 486727}, \'multiverseid\': 486727}, {\'name\': \'릴리아나의 추종자\', \'text\': \'당신이 조종하는 좀비들은 +1/+0을 받는다.\\n당신의 종료단 시작에, 이번 턴에 생물이 죽었다면, 당신은 {1}{B}를 지불할 수 있다. 그렇게 한다면, 2/2 흑색 좀비 생물 토큰 한 개를 만든다.\', \'type\': \'생물 — 인간 흑마법사\', \'flavor\': \'릴리아나는 많은 이들에게는 공포심을 불러일으키며 몇몇에게는 광적인 감탄사를 자아내게 한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486986&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'73e4a3e1-32b0-43f5-9e69-c57b92e91771\', \'multiverseId\': 486986}, \'multiverseid\': 486986}, {\'name\': \'Devoto de Liliana\', \'text\': \'Os Zumbis que você controla recebem +1/+0.\\nNo início de sua etapa final, se uma criatura morreu neste turno, você pode pagar {1}{B}. Se fizer isso, crie uma ficha de criatura preta 2/2 do tipo Zumbi.\', \'type\': \'Criatura — Humano Bruxo\', \'flavor\': \'Liliana inspira terror em muitos... e uma admiração fanática em alguns poucos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487245&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e8718d32-bc0a-4775-be20-401f4887d244\', \'multiverseId\': 487245}, \'multiverseid\': 487245}, {\'name\': \'Преданный Лилианы\', \'text\': \'Зомби под вашим контролем получают +1/+0.\\nВ начале вашего заключительного шага, если в этом ходу умерло существо, вы можете заплатить {1}{B}. Если вы это делаете, создайте одну фишку существа 2/2 черный Зомби.\', \'type\': \'Существо — Человек Колдун\', \'flavor\': \'Лилиана вызывает ужас у многих и безграничное обожание у единиц.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487504&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'479f0303-153c-4197-a012-651c07f7640d\', \'multiverseId\': 487504}, \'multiverseid\': 487504}, {\'name\': \'莉莲娜的信徒\', \'text\': \'由你操控的灵俑得+1/+0。\\n在你的结束步骤开始时，若本回合中有生物死去，你可以支付{1}{B}。若你如此作，则派出一个2/2黑色灵俑衍生生物。\', \'type\': \'生物 ～人类／邪术师\', \'flavor\': \'莉莲娜让许多人恐惧不已，也引来了少数人的狂热崇拜。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487763&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7b5d768d-50ca-4249-acfb-a960650b1371\', \'multiverseId\': 487763}, \'multiverseid\': 487763}, {\'name\': \'莉蓮娜的信徒\', \'text\': \'由你操控的殭屍得+1/+0。\\n在你的結束步驟開始時，若本回合中有生物死去，你可以支付{1}{B}。若你如此作，則派出一個2/2黑色殭屍衍生生物。\', \'type\': \'生物 ～人類／邪術師\', \'flavor\': \'莉蓮娜讓許多人恐懼不已，也引來了少數人的狂熱崇拜。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488022&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5073fef1-ba69-4420-9d17-fb886397eeb1\', \'multiverseId\': 488022}, \'multiverseid\': 488022}]', '[{\'name\': \'Lilianas Verehrer\', \'text\': \'Zombies, die du kontrollierst, erhalten +1/+0.\\nZu Beginn deines Endsegments und falls in diesem Zug eine Kreatur gestorben ist, kannst du {1}{B} bezahlen. Falls du dies tust, erzeuge einen 2/2 schwarzen Zombie-Kreaturenspielstein.\', \'type\': \'Kreatur — Mensch, Hexenmeister\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488938&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9aa4459c-b4d8-4c7e-8826-91a5dad5e68c\', \'multiverseId\': 488938}, \'multiverseid\': 488938}, {\'name\': \'Devoto de Liliana\', \'text\': \'Los Zombies que controlas obtienen +1/+0.\\nAl comienzo de tu paso final, si una criatura murió este turno, puedes pagar {1}{B}. Si lo haces, crea una ficha de criatura Zombie negra 2/2.\', \'type\': \'Criatura — Brujo humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488962&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'81445aaf-0ff2-4650-9410-6ed58f4c54e3\', \'multiverseId\': 488962}, \'multiverseid\': 488962}, {\'name\': \'Dévot de Liliana\', \'text\': \'Les zombies que vous contrôlez gagnent +1/+0.\\nAu début de votre étape de fin, si une créature est morte ce tour-ci, vous pouvez payer {1}{B}. Si vous faites ainsi, créez un jeton de créature 2/2 noire Zombie.\', \'type\': \'Créature : humain et psychagogue\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488986&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c4088ecd-3da8-462a-a871-99ae2acd4404\', \'multiverseId\': 488986}, \'multiverseid\': 488986}, {\'name\': \'Devoto di Liliana\', \'text\': "Gli Zombie che controlli prendono +1/+0.\\nAll\'inizio della tua sottofase finale, se è morta una creatura in questo turno, puoi pagare {1}{B}. Se lo fai, crea una pedina creatura Zombie 2/2 nera.", \'type\': \'Creatura — Warlock Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489010&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'02ea5185-5666-4783-b284-e379ee8b4a57\', \'multiverseId\': 489010}, \'multiverseid\': 489010}, {\'name\': \'リリアナの信奉者\', \'text\': \'あなたがコントロールしているゾンビは＋１/＋０の修整を受ける。\\nあなたの終了ステップの開始時に、このターンにクリーチャーが死亡していた場合、あなたは{1}{B}を支払ってもよい。そうしたなら、黒の２/２のゾンビ・クリーチャー・トークンを１体生成する。\', \'type\': \'クリーチャー — 人間・邪術師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489034&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f7e91cfa-7492-4b10-aaca-ea4760e2b16e\', \'multiverseId\': 489034}, \'multiverseid\': 489034}, {\'name\': \'릴리아나의 추종자\', \'text\': \'당신이 조종하는 좀비들은 +1/+0을 받는다.\\n당신의 종료단 시작에, 이번 턴에 생물이 죽었다면, 당신은 {1}{B}를 지불할 수 있다. 그렇게 한다면, 2/2 흑색 좀비 생물 토큰 한 개를 만든다.\', \'type\': \'생물 — 인간 흑마법사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489058&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d42a0b17-f117-4cbf-bf9e-d6c782c46a0e\', \'multiverseId\': 489058}, \'multiverseid\': 489058}, {\'name\': \'Devoto de Liliana\', \'text\': \'Os Zumbis que você controla recebem +1/+0.\\nNo início de sua etapa final, se uma criatura morreu neste turno, você pode pagar {1}{B}. Se fizer isso, crie uma ficha de criatura preta 2/2 do tipo Zumbi.\', \'type\': \'Criatura — Humano Bruxo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489082&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bdbb960d-07a2-487e-b48e-43c005b570b0\', \'multiverseId\': 489082}, \'multiverseid\': 489082}, {\'name\': \'Преданный Лилианы\', \'text\': \'Зомби под вашим контролем получают +1/+0.\\nВ начале вашего заключительного шага, если в этом ходу умерло существо, вы можете заплатить {1}{B}. Если вы это делаете, создайте одну фишку существа 2/2 черный Зомби.\', \'type\': \'Существо — Человек Колдун\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489106&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e7dd131a-3382-41b2-9510-31b4d6557949\', \'multiverseId\': 489106}, \'multiverseid\': 489106}, {\'name\': \'莉莲娜的信徒\', \'text\': \'由你操控的灵俑得+1/+0。\\n在你的结束步骤开始时，若本回合中有生物死去，你可以支付{1}{B}。若你如此作，则派出一个2/2黑色灵俑衍生生物。\', \'type\': \'生物 ～人类／邪术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489130&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3d5a93e6-e25b-42d9-8486-0c542d5ba236\', \'multiverseId\': 489130}, \'multiverseid\': 489130}, {\'name\': \'莉蓮娜的信徒\', \'text\': \'由你操控的殭屍得+1/+0。\\n在你的結束步驟開始時，若本回合中有生物死去，你可以支付{1}{B}。若你如此作，則派出一個2/2黑色殭屍衍生生物。\', \'type\': \'生物 ～人類／邪術師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489154&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'cf23817d-21d6-420a-8c86-ee080c8fa27f\', \'multiverseId\': 489154}, \'multiverseid\': 489154}]', "[{'name': 'Llanowar-Visionär', 'text': 'Wenn der Llanowar-Visionär ins Spiel kommt, ziehe eine Karte.\\n{T}: Erzeuge {G}.', 'type': 'Kreatur — Elf, Druide', 'flavor': 'Die Elfen von Llanowar schauen in ihre Vergangenheit, um etwas über ihre Zukunft zu erfahren.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485775&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd61a51b5-6583-4083-84d3-066bab8aa1d9', 'multiverseId': 485775}, 'multiverseid': 485775}, {'name': 'Visionario de Llanowar', 'text': 'Cuando el Visionario de Llanowar entre al campo de batalla, roba una carta.\\n{T}: Agrega {G}.', 'type': 'Criatura — Druida elfo', 'flavor': 'Los elfos de Llanowar miran su pasado para determinar su futuro.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486034&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'f87cc6de-d402-449e-ba68-e82464ee6349', 'multiverseId': 486034}, 'multiverseid': 486034}, {'name': 'Visionnaire de Llanowar', 'text': 'Quand le Visionnaire de Llanowar arrive sur le champ de bataille, piochez une carte.\\n{T} : Ajoutez {G}.', 'type': 'Créature : elfe et druide', 'flavor': 'Les elfes de Llanowar regardent leur passé pour savoir comment se profile leur avenir.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486293&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'dd6902ad-b158-46aa-9824-161ac6d63868', 'multiverseId': 486293}, 'multiverseid': 486293}, {'name': 'Visionario di Llanowar', 'text': 'Quando il Visionario di Llanowar entra nel campo di battaglia, pesca una carta.\\n{T}: Aggiungi {G}.', 'type': 'Creatura — Druido Elfo', 'flavor': 'Gli elfi di Llanowar guardano al passato per tracciare il loro futuro.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486552&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '73afaf2c-54e8-4410-bf9e-bd938221b1b5', 'multiverseId': 486552}, 'multiverseid': 486552}, {'name': 'ラノワールの幻想家', 'text': 'ラノワールの幻想家が戦場に出たとき、カードを１枚引く。\\n{T}：{G}を加える。', 'type': 'クリーチャー — エルフ・ドルイド', 'flavor': 'ラノワールのエルフたちは、過去を見て未来の形を判断する。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486811&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f7a9d247-8f89-4f48-b800-2e4f531f43f1', 'multiverseId': 486811}, 'multiverseid': 486811}, {'name': '라노워 선지자', 'text': '라노워 선지자가 전장에 들어올 때, 카드 한 장을 뽑는다.\\n{T}: {G}를 추가한다.', 'type': '생물 — 엘프 드루이드', 'flavor': '라노워의 엘프들은 자신들의 미래의 모습을 결정하기 위해 자신들의 과거를 되돌아본다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487070&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'c9e654b5-1615-4433-8fb2-7ef9c5be8b17', 'multiverseId': 487070}, 'multiverseid': 487070}, {'name': 'Visionário de Llanowar', 'text': 'Quando Visionário de Llanowar entrar no campo de batalha, compre um card.\\n{T}: Adicione {G}.', 'type': 'Criatura — Elfo Druida', 'flavor': 'Os elfos de Llanowar olham para o passado para determinar o próprio futuro.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487329&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e83e3f26-1eb2-4ead-84f6-8c81f98e2059', 'multiverseId': 487329}, 'multiverseid': 487329}, {'name': 'Лановарский Провидец', 'text': 'Когда Лановарский Провидец выходит на поле битвы, возьмите карту.\\n{T}: добавьте {G}.', 'type': 'Существо — Эльф Друид', 'flavor': 'Эльфы Лановара обращаются к прошлому, чтобы определить облик будущего.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487588&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '6daf7c1a-42b2-45fa-89ed-7e5d992a99bb', 'multiverseId': 487588}, 'multiverseid': 487588}, {'name': '罗堰幻视师', 'text': '当罗堰幻视师进战场时，抓一张牌。\\n{T}：加{G}。', 'type': '生物 ～妖精／德鲁伊', 'flavor': '罗堰妖精追忆过往，形塑未来。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487847&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '0f9f2050-4481-497d-bf57-2f8a69252a72', 'multiverseId': 487847}, 'multiverseid': 487847}, {'name': '羅堰幻視師', 'text': '當羅堰幻視師進戰場時，抽一張牌。\\n{T}：加{G}。', 'type': '生物 ～妖精／德魯伊', 'flavor': '羅堰妖精追憶過往，形塑未來。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488106&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'c6b82f08-c2ac-43cf-a6ad-61dde3e1c944', 'multiverseId': 488106}, 'multiverseid': 488106}]", '[{\'name\': \'Luftige Verweigerung\', \'text\': \'Neutralisiere einen Zauberspruch deiner Wahl, es sei denn, sein Beherrscher bezahlt {1}. Falls du eine fliegende Kreatur kontrollierst, neutralisiere stattdessen den Zauberspruch, es sei denn, sein Beherrscher bezahlt {4}.\', \'type\': \'Spontanzauber\', \'flavor\': \'Der Magier blickte finster, als ein weiterer Blitz harmlos gegen scheinbar leere Luft prallte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485638&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c23d2d37-1f02-4b6b-a926-d993c05dfc3b\', \'multiverseId\': 485638}, \'multiverseid\': 485638}, {\'name\': \'Negación elevada\', \'text\': \'Contrarresta el hechizo objetivo a menos que su controlador pague {1}. Si controlas una criatura con la habilidad de volar, en vez de eso, contrarresta ese hechizo a menos que su controlador pague {4}.\', \'type\': \'Instantáneo\', \'flavor\': \'El mago frunció el ceño cuando otro rayo salpicó sin hacer daño a lo que no parecía nada más que aire.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485897&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ea491375-500d-4f87-92e6-8448fa95ad1b\', \'multiverseId\': 485897}, \'multiverseid\': 485897}, {\'name\': \'Déni noble\', \'text\': \'Contrecarrez le sort ciblé à moins que son contrôleur ne paie {1}. Si vous contrôlez une créature avec le vol, contrecarrez ce sort à moins que son contrôleur ne paie {4} à la place.\', \'type\': \'Éphémère\', \'flavor\': "Le mage se renfrogna lorsqu\'un autre éclair se dissipa sans effet sur ce qui semblait n\'être que le vide.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486156&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2a57a8bc-6dcf-4fbb-8e5a-5f62c5a2374c\', \'multiverseId\': 486156}, \'multiverseid\': 486156}, {\'name\': \'Negazione Eccelsa\', \'text\': \'Neutralizza una magia bersaglio a meno che il suo controllore non paghi {1}. Se controlli una creatura con volare, neutralizza quella magia a meno che il suo controllore non paghi invece {4}.\', \'type\': \'Istantaneo\', \'flavor\': "Il mago aggrottò le ciglia mentre l\'ennesima saetta si infrangeva innocua contro quella che non sembrava altro che aria.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486415&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'90e2bc75-59ce-4ce0-a4ad-6eee60616ffa\', \'multiverseId\': 486415}, \'multiverseid\': 486415}, {\'name\': \'高尚な否定\', \'text\': \'呪文１つを対象とする。それのコントローラーが{1}を支払わないかぎり、それを打ち消す。あなたが飛行を持つクリーチャーをコントロールしているなら、代わりに、それのコントローラーが{4}を支払わないかぎり、それを打ち消す。\', \'type\': \'インスタント\', \'flavor\': \'その魔道士は顔をしかめた。またしても雷光が、一見して何もない空中で無意味に弾けてしまったからだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486674&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'61a6a818-e49c-439d-b529-1acd7c074bae\', \'multiverseId\': 486674}, \'multiverseid\': 486674}, {\'name\': \'도도한 부정\', \'text\': \'주문을 목표로 정한다. 그 주문의 조종자가 {1}을 지불하지 않으면 그 주문을 무효화한다. 당신이 비행을 가진 생물을 조종한다면, 대신 그 주문의 조종자가 {4}를 지불하지 않으면 그 주문을 무효화한다.\', \'type\': \'순간마법\', \'flavor\': \'마도사는 또 다른 번개 한 줄기가 허공에서 무해하게 흩어지는 것을 보며 얼굴을 찌푸렸다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486933&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4e5440aa-0f94-4844-a526-df9f1c090bed\', \'multiverseId\': 486933}, \'multiverseid\': 486933}, {\'name\': \'Negação Altiva\', \'text\': \'Anule a mágica alvo, a menos que seu controlador pague {1}. Se você controla uma criatura com voar, em vez disso, anule aquela mágica, a menos que o controlador dela pague {4}.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'O mago franziu a testa quando outra rajada rebentou inofensiva, aparentemente contra o vazio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487192&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b527259c-9c5c-4470-b947-1d22cf848c32\', \'multiverseId\': 487192}, \'multiverseid\': 487192}, {\'name\': \'Высотный Отказ\', \'text\': \'Отмените целевое заклинание, если только контролирующий его игрок не заплатит {1}. Если вы контролируете существо с Полетом, то вместо этого отмените то заклинание, если только контролирующий его игрок не заплатит {4}.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Маг скривился, когда очередной разряд рассыпался искрами, ударив в казалось бы пустое небо.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487451&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d389d253-9ef0-4699-a682-3b6f4b3a1a9f\', \'multiverseId\': 487451}, \'multiverseid\': 487451}, {\'name\': \'清高拒斥\', \'text\': \'除非目标咒语的操控者支付{1}，否则反击之。如果你操控具飞行异能的生物，则改为除非该咒语的操控者支付{4}，否则反击之。\', \'type\': \'瞬间\', \'flavor\': \'看着又一道电光在似乎浑然无物的空中悄然四散，法师不禁皱起了眉头。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487710&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'455beac2-f781-4fcd-acd6-60f6e5313952\', \'multiverseId\': 487710}, \'multiverseid\': 487710}, {\'name\': \'清高拒斥\', \'text\': \'除非目標咒語的操控者支付{1}，否則反擊之。如果你操控具飛行異能的生物，則改為除非該咒語的操控者支付{4}，否則反擊之。\', \'type\': \'瞬間\', \'flavor\': \'看著又一道電光在似乎渾然無物的空中悄然四散，法師不禁皺起了眉頭。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487969&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d9b3819c-7104-43fa-949e-b56f075f31dc\', \'multiverseId\': 487969}, \'multiverseid\': 487969}]', '[{\'name\': \'Luftraumüberwacher\', \'text\': \'Fliegend\\nWenn der Luftraumüberwacher ins Spiel kommt, ziehe eine Karte.\', \'type\': \'Artefaktkreatur — Thopter\', \'flavor\': \'Der Senat nutzt viele dieser Thopter, vor allem, um Schmutz über andere Senatoren zu sammeln.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485820&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'359641e8-edfb-448e-a7e3-7bc74047624a\', \'multiverseId\': 485820}, \'multiverseid\': 485820}, {\'name\': \'Escrutacielos\', \'text\': \'Vuela.\\nCuando el Escrutacielos entre al campo de batalla, roba una carta.\', \'type\': \'Criatura artefacto — Tóptero\', \'flavor\': \'El senado municipal usa a discreción los tópteros, sobre todo para sacar los trapos sucios a los senadores rivales.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486079&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ef79fa1c-58c8-44bb-8f66-8bc121365d4a\', \'multiverseId\': 486079}, \'multiverseid\': 486079}, {\'name\': \'Scruteciel\', \'text\': \'Vol\\nQuand le Scruteciel arrive sur le champ de bataille, piochez une carte.\', \'type\': \'Créature-artefact : mécanoptère\', \'flavor\': \'Le sénat municipal utilise beaucoup les mécanoptères, essentiellement pour trouver des informations compromettantes sur les sénateurs rivaux.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486338&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'72601c43-43da-42b3-a6bc-3d60a69c7173\', \'multiverseId\': 486338}, \'multiverseid\': 486338}, {\'name\': \'Aerosorvegliante\', \'text\': "Volare\\nQuando l\'Aerosorvegliante entra nel campo di battaglia, pesca una carta.", \'type\': \'Creatura Artefatto — Tottero\', \'flavor\': \'Il senato municipale fa ampio uso dei totteri, principalmente per raccogliere informazioni compromettenti sui senatori rivali.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486597&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8b9bee06-16da-4b03-98dc-7e0fa3f02304\', \'multiverseId\': 486597}, \'multiverseid\': 486597}, {\'name\': \'空中走査器\', \'text\': \'飛行\\n空中走査器が戦場に出たとき、カードを１枚引く。\', \'type\': \'アーティファクト・クリーチャー — 飛行機械\', \'flavor\': \'その地方議員は飛行機械を活用している。主に対立候補の汚行を収集するためだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486856&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5623d4eb-22c2-47f9-8150-3994e3d56eca\', \'multiverseId\': 486856}, \'multiverseid\': 486856}, {\'name\': \'하늘 탐색기\', \'text\': \'비행\\n하늘 탐색기가 전장에 들어올 때, 카드 한 장을 뽑는다.\', \'type\': \'마법물체 생물 — 날틀\', \'flavor\': \'지방의 원로가 날틀의 폭넓은 사용법을 만들어냈는데, 대부분은 적대적인 의원의 뒤를 캐는 것이었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487115&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'55629343-473c-4dad-a274-033b7c081bcc\', \'multiverseId\': 487115}, \'multiverseid\': 487115}, {\'name\': \'Sonda Aérea\', \'text\': \'Voar\\nQuando Sonda Aérea entrar no campo de batalha, compre um card.\', \'type\': \'Criatura Artefato — Tóptero\', \'flavor\': \'O senado municipal faz largo uso dos tópteros, em sua maior parte para descobrir os podres de senadores rivais.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487374&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'518bd3c6-c312-4194-a269-5fcdf151aa58\', \'multiverseId\': 487374}, \'multiverseid\': 487374}, {\'name\': \'Небесный Соглядатай\', \'text\': \'Полет\\nКогда Небесный Соглядатай выходит на поле битвы, возьмите карту.\', \'type\': \'Артефакт Существо — Топтер\', \'flavor\': \'Городской сенат широко использует топтеров — в основном для сбора компромата на сенаторов-конкурентов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487633&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'145a3347-14bc-4e63-9e07-f13137c00798\', \'multiverseId\': 487633}, \'multiverseid\': 487633}, {\'name\': \'巡天扑翼机\', \'text\': \'飞行\\n当巡天扑翼机进战场时，抓一张牌。\', \'type\': \'神器生物 ～振翼机\', \'flavor\': \'市议会广泛使用扑翼机，多数是为了搜集敌对议员的污点。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487892&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d4eeacdf-7049-4169-a0e2-50971e321ebd\', \'multiverseId\': 487892}, \'multiverseid\': 487892}, {\'name\': \'巡天撲翼機\', \'text\': \'飛行\\n當巡天撲翼機進戰場時，抽一張牌。\', \'type\': \'神器生物 ～振翼機\', \'flavor\': \'市議會廣泛使用撲翼機，多數是為了搜集敵對議員的污點。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488151&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'27f600ee-4ed5-4a99-bf99-db54de203163\', \'multiverseId\': 488151}, \'multiverseid\': 488151}]', '[{\'name\': \'Luftstraßen-Scharfschützin\', \'text\': \'Reichweite (Diese Kreatur kann fliegende Kreaturen blocken.)\\n{2}{G}: Die Luftstraßen-Scharfschützin fügt einer fliegenden Kreatur deiner Wahl 1 Schadenspunkt zu.\', \'type\': \'Kreatur — Elf, Bogenschütze\', \'flavor\': \'„Kein Anblick ist schöner als ein klarer Himmel."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485788&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'97eab0db-f96b-44b4-b0eb-8f425431015a\', \'multiverseId\': 485788}, \'multiverseid\': 485788}, {\'name\': \'Tiradora de Vastocielo\', \'text\': \'Alcance. (Esta criatura puede bloquear criaturas con la habilidad de volar.)\\n{2}{G}: La Tiradora de Vastocielo hace 1 punto de daño a la criatura objetivo con la habilidad de volar.\', \'type\': \'Criatura — Arquero elfo\', \'flavor\': \'"No hay vista más bonita que un bello cielo despejado".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486047&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cb7ede35-c330-4f5d-8b9c-016271358d2a\', \'multiverseId\': 486047}, \'multiverseid\': 486047}, {\'name\': \'Franc-tireuse de Cielouvert\', \'text\': \'Portée (Cette créature peut bloquer les créatures avec le vol.)\\n{2}{G} : La Franc-tireuse de Cielouvert inflige 1 blessure à une créature avec le vol ciblée.\', \'type\': \'Créature : elfe et archer\', \'flavor\': "« Rien n\'est plus beau qu\'un ciel dégagé. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486306&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8cd465d0-b9c3-4c31-8edc-148764e5f914\', \'multiverseId\': 486306}, \'multiverseid\': 486306}, {\'name\': \'Cecchina del Cieloaperto\', \'text\': \'Raggiungere (Questa creatura può bloccare le creature con volare.)\\n{2}{G}: La Cecchina del Cieloaperto infligge 1 danno a una creatura bersaglio con volare.\', \'type\': \'Creatura — Arciere Elfo\', \'flavor\': \'"Non esiste visione più bella di un cielo terso."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486565&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'578149c0-0568-4a14-a4b0-74a38c98c8e4\', \'multiverseId\': 486565}, \'multiverseid\': 486565}, {\'name\': \'スカイウェイの狙撃者\', \'text\': \'到達（このクリーチャーは飛行を持つクリーチャーをブロックできる。）\\n{2}{G}：飛行を持つクリーチャー１体を対象とする。スカイウェイの狙撃者はそれに１点のダメージを与える。\', \'type\': \'クリーチャー — エルフ・射手\', \'flavor\': \'「晴れ渡る空ほどすばらしいものはないわ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486824&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9cc9803c-0e7c-470d-b694-a875b242c162\', \'multiverseId\': 486824}, \'multiverseid\': 486824}, {\'name\': \'하늘길 저격수\', \'text\': \'대공 (이 생물은 비행을 가진 생물을 방어할 수 있다.)\\n{2}{G}: 비행을 가진 생물을 목표로 정한다. 하늘길 저격수는 그 생물에게 피해 1점을 입힌다.\', \'type\': \'생물 — 엘프 궁수\', \'flavor\': \'"맑은 하늘만큼 아름다운 광경은 없지."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487083&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8f0e5597-a207-46cb-85b1-cc570cd7f5e5\', \'multiverseId\': 487083}, \'multiverseid\': 487083}, {\'name\': \'Atiradora do Céu Aberto\', \'text\': \'Alcance (Esta criatura pode bloquear criaturas com voar.)\\n{2}{G}: Atiradora do Céu Aberto causa 1 ponto de dano à criatura alvo com voar.\', \'type\': \'Criatura — Elfo Arqueiro\', \'flavor\': \'"Nada é mais lindo que um céu limpo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487342&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'277015df-b0b4-47c4-aac4-e4c281f40cd3\', \'multiverseId\': 487342}, \'multiverseid\': 487342}, {\'name\': \'Снайпер Небесного Пути\', \'text\': \'Захват (Это существо может блокировать существа с Полетом.)\\n{2}{G}: Снайпер Небесного Пути наносит 1 повреждение целевому существу с Полетом.\', \'type\': \'Существо — Эльф Лучник\', \'flavor\': \'«Нет более прекрасной картины, чем чистое небо».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487601&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2388d7e3-a78b-4e30-a3f1-c46928771401\', \'multiverseId\': 487601}, \'multiverseid\': 487601}, {\'name\': \'天路神射手\', \'text\': \'延势（此生物能阻挡具飞行异能的生物。）\\n{2}{G}：天路神射手对目标具飞行异能的生物造成1点伤害。\', \'type\': \'生物 ～妖精／弓箭手\', \'flavor\': \'「没什么比晴空万里无一物的景色更美。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487860&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0a84f1b5-6799-49ca-a710-cec4ec3ba4e6\', \'multiverseId\': 487860}, \'multiverseid\': 487860}, {\'name\': \'天路神射手\', \'text\': \'延勢（此生物能阻擋具飛行異能的生物。）\\n{2}{G}：天路神射手對目標具飛行異能的生物造成1點傷害。\', \'type\': \'生物 ～妖精／弓箭手\', \'flavor\': \'「沒什麼比晴空萬里無一物的景色更美。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488119&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e53479f3-0596-4e87-8402-b0a3714b6f2d\', \'multiverseId\': 488119}, \'multiverseid\': 488119}]', '[{\'name\': \'Mangara der Diplomat\', \'text\': \'Lebensverknüpfung\\nImmer wenn ein Gegner Kreaturen als Angreifer deklariert und falls zwei oder mehr jener Kreaturen dich und/oder Planeswalker, die du kontrollierst, angreifen, ziehe eine Karte.\\nImmer wenn ein Gegner seinen zweiten Zauberspruch innerhalb desselben Zuges wirkt, ziehe eine Karte.\', \'type\': \'Legendäre Kreatur — Mensch, Kleriker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485609&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9f5dcf5a-a19e-4628-b172-c29baa26b2f8\', \'multiverseId\': 485609}, \'multiverseid\': 485609}, {\'name\': \'Mangara, el Diplomático\', \'text\': \'Vínculo vital.\\nSiempre que un oponente ataque con criaturas, si dos o más de esas criaturas te atacan y/o atacan a planeswalkers que controlas, roba una carta.\\nSiempre que un oponente lance su segundo hechizo cada turno, roba una carta.\', \'type\': \'Criatura legendaria — Clérigo humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485868&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'07591dba-a344-4e92-b722-9edf50ad57e8\', \'multiverseId\': 485868}, \'multiverseid\': 485868}, {\'name\': \'Mangara, le diplomate\', \'text\': "Lien de vie\\nÀ chaque fois qu\'un adversaire attaque avec des créatures, si au moins deux de ces créatures vous attaquent et/ou attaquent un planeswalker que vous contrôlez, piochez une carte.\\nÀ chaque fois qu\'un adversaire lance son deuxième sort à chaque tour, piochez une carte.", \'type\': \'Créature légendaire : humain et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486127&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0dda80b2-ac7f-4218-b519-50b84fd5ca08\', \'multiverseId\': 486127}, \'multiverseid\': 486127}, {\'name\': \'Mangara, il Diplomatico\', \'text\': \'Legame vitale\\nOgniqualvolta un avversario attacca con creature, se due o più di quelle creature stanno attaccando te e/o i planeswalker che controlli, pesca una carta.\\nOgniqualvolta un avversario lancia la sua seconda magia in ogni turno, pesca una carta.\', \'type\': \'Creatura Leggendaria — Chierico Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486386&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ec701717-a035-4946-8977-b85a2f8666c8\', \'multiverseId\': 486386}, \'multiverseid\': 486386}, {\'name\': \'外交官、マンガラ\', \'text\': \'絆魂\\n対戦相手１人がクリーチャーで攻撃するたび、それらのクリーチャーのうち２体以上があなたやあなたがコントロールしているプレインズウォーカーを攻撃している場合、カードを１枚引く。\\n対戦相手１人が各ターンの自分の２つ目の呪文を唱えるたび、カードを１枚引く。\', \'type\': \'伝説のクリーチャー — 人間・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486645&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6f235868-5589-4068-8208-ce53cea97054\', \'multiverseId\': 486645}, \'multiverseid\': 486645}, {\'name\': \'외교술사, 망가라\', \'text\': \'생명연결\\n상대가 생물들로 공격할 때마다, 그 생물들 중 두 개 이상이 당신 및/또는 당신이 조종하는 플레인즈워커를 공격하고 있다면, 카드 한 장을 뽑는다.\\n상대가 매 턴 자신의 두 번째 주문을 발동할 때마다, 카드 한 장을 뽑는다.\', \'type\': \'전설적 생물 — 인간 성직자\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486904&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'fe4cc7ba-ece2-4d7d-8dad-b5a268eb440a\', \'multiverseId\': 486904}, \'multiverseid\': 486904}, {\'name\': \'Mangara, o Diplomata\', \'text\': \'Vínculo com a vida\\nToda vez que um oponente atacar com criaturas, se duas ou mais daquelas criaturas estiverem atacando você e/ou planeswalkers que você controla, compre um card.\\nToda vez que um oponente conjurar sua segunda mágica em cada turno, compre um card.\', \'type\': \'Criatura Lendária — Humano Clérigo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487163&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5dc7ee06-cc87-4086-a086-e552acf6afb0\', \'multiverseId\': 487163}, \'multiverseid\': 487163}, {\'name\': \'Мангара, Дипломат\', \'text\': "Цепь жизни\\nКаждый раз, когда оппонент атакует существами, если два или более из тех существ атакуют вас и/или planeswalker\'ов под вашим контролем, возьмите карту.\\nКаждый раз, когда оппонент разыгрывает свое второе заклинание в каждом ходу, возьмите карту.", \'type\': \'Легендарное Существо — Человек Священник\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487422&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'50d9d3ea-15cf-43dd-90d3-dcdfea0bafbc\', \'multiverseId\': 487422}, \'multiverseid\': 487422}, {\'name\': \'使节曼格拉\', \'text\': \'系命\\n每当任一对手以生物攻击时，若其中有两个或更多生物攻击你和／或由你操控的鹏洛客，则你抓一张牌。\\n每当任一对手施放每回合中其第二个咒语时，你抓一张牌。\', \'type\': \'传奇生物 ～人类／僧侣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487681&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'de30663d-a8a1-4091-8268-b2db69299d9d\', \'multiverseId\': 487681}, \'multiverseid\': 487681}, {\'name\': \'使節曼格拉\', \'text\': \'繫命\\n每當任一對手以生物攻擊時，若其中有兩個或更多生物攻擊你和／或由你操控的鵬洛客，則你抽一張牌。\\n每當任一對手施放每回合中其第二個咒語時，你抽一張牌。\', \'type\': \'傳奇生物 ～人類／僧侶\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487940&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7e106b48-ff47-4592-877a-d6ad7dfac633\', \'multiverseId\': 487940}, \'multiverseid\': 487940}]', '[{\'name\': \'Mangara, le diplomate\', \'text\': "Lien de vie\\nÀ chaque fois qu\'un adversaire attaque avec des créatures, si au moins deux de ces créatures vous attaquent et/ou attaquent un planeswalker que vous contrôlez, piochez une carte.\\nÀ chaque fois qu\'un adversaire lance son deuxième sort à chaque tour, piochez une carte.", \'type\': \'Créature légendaire : humain et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488294&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ca0c363e-17b5-461c-be91-3a6d4ed61294\', \'multiverseId\': 488294}, \'multiverseid\': 488294}, {\'name\': \'外交官、マンガラ\', \'text\': \'絆魂\\n対戦相手１人がクリーチャーで攻撃するたび、それらのクリーチャーのうち２体以上があなたやあなたがコントロールしているプレインズウォーカーを攻撃している場合、カードを１枚引く。\\n対戦相手１人が各ターンの自分の２つ目の呪文を唱えるたび、カードを１枚引く。\', \'type\': \'伝説のクリーチャー — 人間・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488346&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b89ddad9-b67d-4628-9a36-d074eae25c88\', \'multiverseId\': 488346}, \'multiverseid\': 488346}]', '[{\'name\': \'Maskierte Schwarzgardistin\', \'text\': \'Aufblitzen (Du kannst diesen Zauberspruch zu jedem Zeitpunkt wirken, zu dem du einen Spontanzauber wirken könntest.)\\n{2}{B}: Die Maskierte Schwarzgardistin erhält +1/+1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Räuber\', \'flavor\': \'Ihre Schritte sind Geflüster, ihr Vorbeigehen ein letzter Atemzug.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485695&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6a265f2f-43d8-40dd-bd1e-deed33ea8a46\', \'multiverseId\': 485695}, \'multiverseid\': 485695}, {\'name\': \'Canalla enmascarada\', \'text\': \'Destello. (Puedes lanzar este hechizo en cualquier momento en que pudieras lanzar un instantáneo.)\\n{2}{B}: La Canalla enmascarada obtiene +1/+1 hasta el final del turno.\', \'type\': \'Criatura — Bribón humano\', \'flavor\': \'Sus pasos son susurros; su avance, un último aliento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485954&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fa7165a5-65ce-4737-9256-d670ebc6ceb4\', \'multiverseId\': 485954}, \'multiverseid\': 485954}, {\'name\': \'Garde noire masquée\', \'text\': "Flash (Vous pouvez lancer ce sort à tout moment où vous pourriez lancer un éphémère.)\\n{2}{B} : La Garde noire masquée gagne +1/+1 jusqu\'à la fin du tour.", \'type\': \'Créature : humain et gredin\', \'flavor\': \'Ses pas sont des murmures, son passage un dernier souffle.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486213&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6211038b-bf49-43bf-a3e3-31ef006b79cc\', \'multiverseId\': 486213}, \'multiverseid\': 486213}, {\'name\': \'Canaglia Mascherata\', \'text\': \'Lampo (Puoi lanciare questa magia in ogni momento in cui potresti lanciare un istantaneo.)\\n{2}{B}: La Canaglia Mascherata prende +1/+1 fino alla fine del turno.\', \'type\': \'Creatura — Farabutto Umano\', \'flavor\': \'I suoi passi sono sussurri, i suoi movimenti un ultimo respiro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486472&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'77700e3f-7779-4a9f-9170-9d038f7b293d\', \'multiverseId\': 486472}, \'multiverseid\': 486472}, {\'name\': \'仮面の悪党\', \'text\': \'瞬速（あなたはこの呪文を、あなたがインスタントを唱えられるときならいつでも唱えてよい。）\\n{2}{B}：ターン終了時まで、仮面の悪党は＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — 人間・ならず者\', \'flavor\': \'歩みは囁き、通過は絶息。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486731&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'64cd2b80-749b-40b4-ba77-f2f9b18c8b36\', \'multiverseId\': 486731}, \'multiverseid\': 486731}, {\'name\': \'가면을 쓴 불한당\', \'text\': \'섬광 (순간마법을 발동할 수 있는 시기라면 당신은 이 주문을 언제든지 발동할 수 있다.)\\n{2}{B}: 가면을 쓴 불한당은 턴종료까지 +1/+1을 받는다.\', \'type\': \'생물 — 인간 도적\', \'flavor\': \'속삭임이 그녀의 발걸음이고, 마지막 숨결이 그녀의 지나침이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486990&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'febbfa85-1d92-4566-ae76-2a9538bc8f9c\', \'multiverseId\': 486990}, \'multiverseid\': 486990}, {\'name\': \'Canalha Mascarada\', \'text\': \'Lampejo (Você poderá conjurar esta mágica a qualquer momento em que puder conjurar uma mágica instantânea.)\\n{2}{B}: Canalha Mascarada recebe +1/+1 até o final do turno.\', \'type\': \'Criatura — Humano Ladino\', \'flavor\': \'Seus passos são sussurros. Sua passagem, um último suspiro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487249&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'47009579-31b5-46ab-9b59-2f8a1309f2fd\', \'multiverseId\': 487249}, \'multiverseid\': 487249}, {\'name\': \'Злодейка в Маске\', \'text\': \'Миг (Вы можете разыграть это заклинание при любой возможности разыгрывать мгновенные заклинания.)\\n{2}{B}: Злодейка в Маске получает +1/+1 до конца хода.\', \'type\': \'Существо — Человек Бродяга\', \'flavor\': \'Ее шаги — словно шепот, ее приход — последний вздох.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487508&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'888efee9-d804-4cef-b6ee-403585db7679\', \'multiverseId\': 487508}, \'multiverseid\': 487508}, {\'name\': \'覆面凶徒\', \'text\': \'闪现（你可以于你能够施放瞬间的时机下施放此咒语。）\\n{2}{B}：覆面凶徒得+1/+1直到回合结束。\', \'type\': \'生物 ～人类／浪客\', \'flavor\': \'她的脚步如细语轻声，悄然之间便令人咽气。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487767&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5038f8da-f55f-4415-ba3a-68caac77cf64\', \'multiverseId\': 487767}, \'multiverseid\': 487767}, {\'name\': \'覆面兇徒\', \'text\': \'閃現（你可以於你能夠施放瞬間的時機下施放此咒語。）\\n{2}{B}：覆面兇徒得+1/+1直到回合結束。\', \'type\': \'生物 ～人類／浪客\', \'flavor\': \'她的腳步如細語輕聲，悄然之間便令人嚥氣。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488026&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'134eb97c-4e23-4b60-92cc-6aa91f2199b3\', \'multiverseId\': 488026}, \'multiverseid\': 488026}]', '[{\'name\': \'Massakerwurm\', \'text\': \'Wenn der Massakerwurm ins Spiel kommt, erhalten Kreaturen, die deine Gegner kontrollieren, -2/-2 bis zum Ende des Zuges.\\nImmer wenn eine Kreatur stirbt, die ein Gegner kontrolliert, verliert jener Spieler 2 Lebenspunkte.\', \'type\': \'Kreatur — Wurm\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485696&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'17f53596-0672-49e2-be9f-980b0dbbfdbf\', \'multiverseId\': 485696}, \'multiverseid\': 485696}, {\'name\': \'Sierpe de la masacre\', \'text\': \'Cuando la Sierpe de la masacre entre al campo de batalla, las criaturas que controlan tus oponentes obtienen -2/-2 hasta el final del turno.\\nSiempre que una criatura que controla un oponente muera, ese jugador pierde 2 vidas.\', \'type\': \'Criatura — Sierpe\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485955&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4a3a6974-7d8d-4350-8a19-87a5a1b7aff9\', \'multiverseId\': 485955}, \'multiverseid\': 485955}, {\'name\': \'Guivre du massacre\', \'text\': "Quand la Guivre du massacre arrive sur le champ de bataille, les créatures que vos adversaires contrôlent gagnent -2/-2 jusqu\'à la fin du tour.\\nÀ chaque fois qu\'une créature qu\'un adversaire contrôle meurt, ce joueur perd 2 points de vie.", \'type\': \'Créature : guivre\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486214&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8e564304-0857-4d7f-abfe-c8b5f8679e2a\', \'multiverseId\': 486214}, \'multiverseid\': 486214}, {\'name\': \'Wurm della Strage\', \'text\': \'Quando il Wurm della Strage entra nel campo di battaglia, le creature controllate dai tuoi avversari prendono -2/-2 fino alla fine del turno.\\nOgniqualvolta una creatura controllata da un avversario muore, quel giocatore perde 2 punti vita.\', \'type\': \'Creatura — Wurm\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486473&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ef3e3e8e-9fb3-4631-96ef-5ecc55abeb89\', \'multiverseId\': 486473}, \'multiverseid\': 486473}, {\'name\': \'虐殺のワーム\', \'text\': \'虐殺のワームが戦場に出たとき、ターン終了時まで、対戦相手がコントロールしているクリーチャーは－２/－２の修整を受ける。\\n対戦相手がコントロールしているクリーチャーが死亡するたび、そのプレイヤーは２点のライフを失う。\', \'type\': \'クリーチャー — ワーム\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486732&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'924ddc4a-f988-4cda-be1b-aa7f2b476cfc\', \'multiverseId\': 486732}, \'multiverseid\': 486732}, {\'name\': \'대학살의 웜\', \'text\': \'대학살의 웜이 전장에 들어올 때, 상대가 조종하는 생물들은 턴종료까지 -2/-2를 받는다.\\n상대가 조종하는 생물이 죽을 때마다, 그 플레이어는 생명 2점을 잃는다.\', \'type\': \'생물 — 웜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486991&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1bebf4f0-b09d-4a15-9c4e-75b5bf3e7f99\', \'multiverseId\': 486991}, \'multiverseid\': 486991}, {\'name\': \'Vorme do Massacre\', \'text\': \'Quando Vorme do Massacre entra no campo de batalha, as criaturas que seus oponentes controlam recebem -2/-2 até o final do turno.\\nToda vez que uma criatura que um oponente controla morre, aquele jogador perde 2 pontos de vida.\', \'type\': \'Criatura — Vorme\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487250&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'54e0848d-c12a-4de5-a0c1-a4560221dca3\', \'multiverseId\': 487250}, \'multiverseid\': 487250}, {\'name\': \'Вурм Побоища\', \'text\': \'Когда Вурм Побоища выходит на поле битвы, существа под контролем ваших оппонентов получают -2/-2 до конца хода.\\nКаждый раз, когда существо под контролем оппонента умирает, тот игрок теряет 2 жизни.\', \'type\': \'Существо — Вурм\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487509&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'835dbb40-0567-41c4-94de-bc5d81641cca\', \'multiverseId\': 487509}, \'multiverseid\': 487509}, {\'name\': \'屠戮亚龙\', \'text\': \'当屠戮亚龙进战场时，由对手操控的生物得-2/-2直到回合结束。\\n每当一个由对手操控的生物死去时，该牌手失去2点生命。\', \'type\': \'生物 ～亚龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487768&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b16f1c4e-8f5b-4e35-9fb3-53d8f64543e9\', \'multiverseId\': 487768}, \'multiverseid\': 487768}, {\'name\': \'屠戮亞龍\', \'text\': \'當屠戮亞龍進戰場時，由對手操控的生物得-2/-2直到回合結束。\\n每當一個由對手操控的生物死去時，該玩家失去2點生命。\', \'type\': \'生物 ～亞龍\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488027&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'074130a7-5d85-4e58-be91-4ad6b75e3e6c\', \'multiverseId\': 488027}, \'multiverseid\': 488027}]', '[{\'name\': \'Massakerwurm\', \'text\': \'Wenn der Massakerwurm ins Spiel kommt, erhalten alle Kreaturen, die deine Gegner kontrollieren, -2/-2 bis zum Ende des Zuges.\\nImmer wenn eine Kreatur stirbt, die ein Gegner kontrolliert, verliert dieser Spieler 2 Lebenspunkte.\', \'type\': \'Kreatur — Wurm\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488403&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8e81e588-e2c7-4f14-9d51-35952ef8f6d3\', \'multiverseId\': 488403}, \'multiverseid\': 488403}, {\'name\': \'Sierpe de la masacre\', \'text\': \'Cuando la Sierpe de la masacre entre al campo de batalla, las criaturas que controlan tus oponentes obtienen -2/-2 hasta el final del turno.\\nSiempre que una criatura que controla un oponente muera, ese jugador pierde 2 vidas.\', \'type\': \'Criatura — Sierpe\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488409&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'22234a13-e32f-4d9e-a592-69b08eb9d88a\', \'multiverseId\': 488409}, \'multiverseid\': 488409}, {\'name\': \'Guivre du massacre\', \'text\': "Quand la Guivre du massacre arrive sur le champ de bataille, les créatures que vos adversaires contrôlent gagnent -2/-2 jusqu\'à la fin du tour.\\nÀ chaque fois qu\'une créature qu\'un adversaire contrôle meurt, ce joueur perd 2 points de vie.", \'type\': \'Créature : guivre\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488415&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e00ce863-bd8f-4b01-b361-3a19c5366ae5\', \'multiverseId\': 488415}, \'multiverseid\': 488415}, {\'name\': \'Wurm della Strage\', \'text\': \'Quando il Wurm della Strage entra nel campo di battaglia, le creature controllate dai tuoi avversari prendono -2/-2 fino alla fine del turno.\\nOgniqualvolta una creatura controllata da un avversario muore, quel giocatore perde 2 punti vita.\', \'type\': \'Creatura — Wurm\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488421&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6981f5a4-5f80-4616-a0ec-eae05dfaba94\', \'multiverseId\': 488421}, \'multiverseid\': 488421}, {\'name\': \'虐殺のワーム\', \'text\': \'虐殺のワームが戦場に出たとき、ターン終了時まで、対戦相手がコントロールしているクリーチャーは－２/－２の修整を受ける。\\n対戦相手がコントロールしているクリーチャーが死亡するたび、そのプレイヤーは２点のライフを失う。\', \'type\': \'クリーチャー — ワーム\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488427&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6898d892-0b4d-40cb-86fe-e5b056c49683\', \'multiverseId\': 488427}, \'multiverseid\': 488427}, {\'name\': \'학살자 웜\', \'text\': \'대학살의 웜이 전장에 들어올 때, 상대가 조종하는 생물들은 턴종료까지 -2/-2를 받는다.\\n상대가 조종하는 생물이 죽을 때마다, 그 플레이어는 생명 2점을 잃는다.\', \'type\': \'생물 — 웜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488433&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'49003d3b-02a5-4e7c-9c8e-09b2c169cb65\', \'multiverseId\': 488433}, \'multiverseid\': 488433}, {\'name\': \'Vorme do Massacre\', \'text\': \'Quando Vorme do Massacre entra no campo de batalha, as criaturas que seus oponentes controlam recebem -2/-2 até o final do turno.\\nToda vez que uma criatura que um oponente controla morre, aquele jogador perde 2 pontos de vida.\', \'type\': \'Criatura — Vorme\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488439&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0bc8c766-8944-4a24-9397-71e6d9623688\', \'multiverseId\': 488439}, \'multiverseid\': 488439}, {\'name\': \'Вурм Побоища\', \'text\': \'Когда Вурм Побоища выходит на поле битвы, существа под контролем ваших оппонентов получают -2/-2 до конца хода.\\nКаждый раз, когда существо под контролем оппонента умирает, тот игрок теряет 2 жизни.\', \'type\': \'Существо — Вурм\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488445&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a4e1dccd-265d-4be2-b851-4a78fcaf42d0\', \'multiverseId\': 488445}, \'multiverseid\': 488445}, {\'name\': \'屠戮亚龙\', \'text\': \'当屠戮亚龙进战场时，由对手操控的生物得-2/-2直到回合结束。\\n每当一个由对手操控的生物死去时，该牌手失去2点生命。\', \'type\': \'生物 ～亚龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488451&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f9ea708b-be8b-4156-9509-c7977a3babfd\', \'multiverseId\': 488451}, \'multiverseid\': 488451}, {\'name\': \'屠戮亞龍\', \'text\': \'當屠戮亞龍進戰場時，由對手操控的生物得-2/-2直到回合結束。\\n每當一個由對手操控的生物死去時，該玩家失去2點生命。\', \'type\': \'生物 ～亞龍\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488457&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8ef37dda-ecd4-4d4a-9464-c4e774c4b11f\', \'multiverseId\': 488457}, \'multiverseid\': 488457}]', '[{\'name\': \'Meteorit\', \'text\': \'Wenn der Meteorit ins Spiel kommt, fügt er einem Ziel deiner Wahl 2 Schadenspunkte zu.\\n{T}: Erzeuge ein Mana einer beliebigen Farbe.\', \'type\': \'Artefakt\', \'flavor\': \'„Sollte ich lügen", hob er an …\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485815&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3abb7306-0aab-49dd-bcb7-2f5410d40a90\', \'multiverseId\': 485815}, \'multiverseid\': 485815}, {\'name\': \'Meteorito\', \'text\': \'Cuando el Meteorito entre al campo de batalla, hace 2 puntos de daño a cualquier objetivo.\\n{T}: Agrega un maná de cualquier color.\', \'type\': \'Artefacto\', \'flavor\': \'"Y si miento...", comenzó a decir.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486074&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'510fa7ff-24bf-4f74-9711-bc2d65cfda56\', \'multiverseId\': 486074}, \'multiverseid\': 486074}, {\'name\': \'Météorite\', \'text\': "Quand la Météorite arrive sur le champ de bataille, elle inflige 2 blessures à n\'importe quelle cible.\\n{T} : Ajoutez un mana de la couleur de votre choix.", \'type\': \'Artefact\', \'flavor\': \'« Et si je mens, que je sois... » commença-t-il...\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486333&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'620ab162-ca19-4285-ab9e-a0726fa3d07c\', \'multiverseId\': 486333}, \'multiverseid\': 486333}, {\'name\': \'Meteorite\', \'text\': \'Quando il Meteorite entra nel campo di battaglia, infligge 2 danni a un qualsiasi bersaglio.\\n{T}: Aggiungi un mana di un qualsiasi colore.\', \'type\': \'Artefatto\', \'flavor\': \'"Se dico una bugia", iniziò...\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486592&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'451cbd00-c52d-471e-823a-6329a1829e35\', \'multiverseId\': 486592}, \'multiverseid\': 486592}, {\'name\': \'隕石\', \'text\': \'隕石が戦場に出たとき、クリーチャー１体かプレインズウォーカー１体かプレイヤー１人を対象とする。これはそれに２点のダメージを与える。\\n{T}：好きな色１色のマナ１点を加える。\', \'type\': \'アーティファクト\', \'flavor\': \'「俺が嘘をついているなら……」と彼は切り出した。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486851&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'087064d1-ecf4-4979-a83b-9bbf91a2c4cf\', \'multiverseId\': 486851}, \'multiverseid\': 486851}, {\'name\': \'유성\', \'text\': \'유성이 전장에 들어올 때, 원하는 목표를 정한다. 유성은 그 목표에게 피해 2점을 입힌다.\\n{T}: 원하는 색의 마나 한 개를 추가한다.\', \'type\': \'마법물체\', \'flavor\': \'그는 "내가 거짓말하는 거라면,"이라는 말로 시작했다 . . .\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487110&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'86de6c5b-b291-41f0-9083-0ddf50da57c7\', \'multiverseId\': 487110}, \'multiverseid\': 487110}, {\'name\': \'Meteorito\', \'text\': \'Quando Meteorito entra no campo de batalha, ele causa 2 pontos de dano a qualquer alvo.\\n{T}: Adicione um mana de qualquer cor.\', \'type\': \'Artefato\', \'flavor\': \'"E se eu estiver mentindo", começou ele...\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487369&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0b8fec57-6686-4ae5-a9af-e86919ec4f23\', \'multiverseId\': 487369}, \'multiverseid\': 487369}, {\'name\': \'Метеорит\', \'text\': \'Когда Метеорит выходит на поле битвы, он наносит 2 повреждения любой цели.\\n{T}: добавьте одну ману любого цвета.\', \'type\': \'Артефакт\', \'flavor\': \'«А если я вру, то пусть...» — начал он.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487628&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b7f50df6-6f59-4fa5-b5f1-2cd882a73fe4\', \'multiverseId\': 487628}, \'multiverseid\': 487628}, {\'name\': \'陨星\', \'text\': \'当陨星进战场时，它对任意一个目标造成2点伤害。\\n{T}：加一点任意颜色的法术力。\', \'type\': \'神器\', \'flavor\': \'「如果我说谎，」他抬起. . .\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487887&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8e7f59f7-5ff8-4842-9359-9ca413e89ae1\', \'multiverseId\': 487887}, \'multiverseid\': 487887}, {\'name\': \'隕星\', \'text\': \'當隕星進戰場時，它對任意一個目標造成2點傷害。\\n{T}：加一點任意顏色的魔法力。\', \'type\': \'神器\', \'flavor\': \'「如果我說謊，」他抬起. . .\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488146&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'47884477-8951-4a37-80e4-bc0e70bca676\', \'multiverseId\': 488146}, \'multiverseid\': 488146}]', '[{\'name\': \'Mistralsängerin\', \'text\': \'Fliegend\\nBravour (Immer wenn du einen Nichtkreatur-Zauberspruch wirkst, erhält diese Kreatur +1/+1 bis zum Ende des Zuges.)\', \'type\': \'Kreatur — Sirene\', \'flavor\': \'„Singe ich von Sturm, der Himmel erbebt, singe ich von Wellen, die See sich erhebt, doch sing\\\' ich von Liebe, keine Stimme sich regt."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485640&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'79743cdc-7e7b-4af1-93a4-9b1765393b31\', \'multiverseId\': 485640}, \'multiverseid\': 485640}, {\'name\': \'Cantante mistral\', \'text\': \'Vuela.\\nDestreza. (Siempre que lances un hechizo que no sea de criatura, esta criatura obtiene +1/+1 hasta el final del turno.)\', \'type\': \'Criatura — Sirena\', \'flavor\': \'"Canté sobre tormentas y se alzó una borrasca. Canté sobre olas y las mareas subieron. Canté sobre amor, pero no escuché ninguna voz".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485899&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4e44eed1-6d80-4416-b095-7fdaabeb5029\', \'multiverseId\': 485899}, \'multiverseid\': 485899}, {\'name\': \'Chanteuse de mistral\', \'text\': "Vol\\nProuesse (À chaque fois que vous lancez un sort non-créature, cette créature gagne +1/+1 jusqu\'à la fin du tour.)", \'type\': \'Créature : sirène\', \'flavor\': "« J\'ai chanté la tempête, et le vent s\'est levé. J\'ai chanté les vagues, et la mer est montée. J\'ai chanté l\'amour, mais personne n\'a appelé. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486158&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'31df6501-6c96-42cd-ba4d-24a53922affb\', \'multiverseId\': 486158}, \'multiverseid\': 486158}, {\'name\': \'Cantrice del Mistral\', \'text\': \'Volare\\nProdezza (Ogniqualvolta lanci una magia non creatura, questa creatura prende +1/+1 fino alla fine del turno.)\', \'type\': \'Creatura — Sirena\', \'flavor\': \'"Intonai un canto di tempeste e l\\\'aria si fece minacciosa. Intonai un canto di onde e l\\\'acqua si fece burrascosa. Intonai un canto d\\\'amore, ma nessuna voce rispose speranzosa."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486417&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9cce1f59-ebd0-4497-b65e-a7c16540258d\', \'multiverseId\': 486417}, \'multiverseid\': 486417}, {\'name\': \'北風の歌姫\', \'text\': \'飛行\\n果敢（あなたがクリーチャーでない呪文を唱えるたび、ターン終了時まで、このクリーチャーは＋１/＋１の修整を受ける。）\', \'type\': \'クリーチャー — セイレーン\', \'flavor\': \'「私が嵐を歌うと、雨が降った。私が波を歌うと、潮が満ちた。私は愛を歌ったが、誰も応えなかった。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486676&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'538d16ae-a14d-4298-b3d2-f33f0047f19e\', \'multiverseId\': 486676}, \'multiverseid\': 486676}, {\'name\': \'미스트랄 노래꾼\', \'text\': \'비행\\n기량 (당신이 생물이 아닌 주문을 발동할 때마다, 이 생물은 턴종료까지 +1/+1을 받는다.)\', \'type\': \'생물 — 세이렌\', \'flavor\': \'"내가 폭풍을 노래하면, 돌풍이 찾아온다. 내가 파도를 노래하면, 바다가 높아진다. 내가 사랑을 노래하면, 아무런 대답이 없다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486935&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8a3510f7-9495-4f0c-addb-6dc093024e04\', \'multiverseId\': 486935}, \'multiverseid\': 486935}, {\'name\': \'Cantora Mistral\', \'text\': \'Voar\\nDestreza (Toda vez que você conjura uma mágica que não seja de criatura, esta criatura recebe +1/+1 até o final do turno.)\', \'type\': \'Criatura — Sirena\', \'flavor\': \'"Cantei as tormentas e veio um tufão. Cantei as ondas, e o mar subiu. Cantei o amor... sem resposta... em vão."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487194&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d3eca416-4baf-4cb6-8aa2-9fb826714800\', \'multiverseId\': 487194}, \'multiverseid\': 487194}, {\'name\': \'Певица Мистраля\', \'text\': \'Полет\\nИскусность (Каждый раз, когда вы разыгрываете не являющееся существом заклинание, это существо получает +1/+1 до конца хода.)\', \'type\': \'Существо — Сирена\', \'flavor\': \'«Я пела о шторме, и шквал отозвался. Я пела о волнах, и буря поднялась. Спою о любви — и никто не ответит».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487453&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'51b8b620-06d4-4c43-b300-260aa74a124a\', \'multiverseId\': 487453}, \'multiverseid\': 487453}, {\'name\': \'寒风歌者\', \'text\': \'飞行\\n灵技（每当你施放非生物咒语时，此生物得+1/+1直到回合结束。）\', \'type\': \'生物 ～塞连\', \'flavor\': \'「唱起风暴之歌，天降疾风应和；唱起浪潮之歌，海洋积势添色；唱起爱情之歌，四下无声合辙。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487712&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d65b9b0d-c8c8-45ab-97f0-0ceccb60396b\', \'multiverseId\': 487712}, \'multiverseid\': 487712}, {\'name\': \'寒風歌者\', \'text\': \'飛行\\n靈技（每當你施放非生物咒語時，此生物得+1/+1直到回合結束。）\', \'type\': \'生物 ～塞連\', \'flavor\': \'「唱起風暴之歌，天降疾風應和；唱起浪潮之歌，海洋積勢添色；唱起愛情之歌，四下無聲合轍。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487971&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bf13abe4-f0e3-4f45-beac-c4da8fd6de81\', \'multiverseId\': 487971}, \'multiverseid\': 487971}]', '[{\'name\': \'Mitreißender Griff\', \'text\': \'Verzaubert eine Kreatur\\nDu kannst keine ungetappte Kreatur als Ziel dieses Zauberspruchs bestimmen, sowie du ihn wirkst.\\nDu kontrollierst die verzauberte Kreatur.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Ich bot ihm an, ihn für den Job zu bezahlen, aber er lehnte ab. Also hab ich die Dinge selbst in die Hand genommen."\\n—Tahim, Meister der Marionetten\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485631&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dfab4f79-4de9-4a1c-8a40-f0b6f64552b4\', \'multiverseId\': 485631}, \'multiverseid\': 485631}, {\'name\': \'Control fascinante\', \'text\': \'Encantar criatura.\\nNo puedes elegir una criatura enderezada como el objetivo de este hechizo en cuanto lo lanzas.\\nTú controlas la criatura encantada.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"Le ofrecí pagarle por hacer el trabajo, pero se negó, así que le eché una mano".\\n—Táhim, el Titiritero\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485890&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fd957ed3-32e0-4efb-88ce-a89b55307579\', \'multiverseId\': 485890}, \'multiverseid\': 485890}, {\'name\': \'Mainmise charismatique\', \'text\': \'Enchanter : créature\\nVous ne pouvez pas choisir une créature dégagée comme cible de ce sort au moment où vous le lancez.\\nVous contrôlez la créature enchantée.\', \'type\': \'Enchantement : aura\', \'flavor\': "« J\'ai proposé de le payer, mais il a refusé. Alors j\'ai décidé de prendre les choses en main. »\\n—Tahim, le marionnettiste", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486149&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9063bc46-1db3-4177-b7d2-522d050f8aaf\', \'multiverseId\': 486149}, \'multiverseid\': 486149}, {\'name\': \'Stretta Ammaliante\', \'text\': \'Incanta creatura\\nMentre lanci la Stretta Ammaliante, non puoi scegliere una creatura STAPpata come suo bersaglio.\\nControlli la creatura incantata.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Mi sono offerto di pagarlo per portare a termine l\\\'incarico, ma lui ha rifiutato. Così ho deciso di prendere in mano la situazione."\\n—Tahim, il Burattinaio\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486408&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a26df448-33b1-4ca8-b039-a5cbc18b44e6\', \'multiverseId\': 486408}, \'multiverseid\': 486408}, {\'name\': \'心酔させる掌握\', \'text\': \'エンチャント（クリーチャー）\\nあなたは、この呪文を唱える時点の対象としてアンタップ状態のクリーチャーを選ぶことはできない。\\nあなたはエンチャントしているクリーチャーをコントロールする。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「仕事をすれば報酬を支払うと言ったのだが、彼は拒んだ。そこで、自分の手で解決することにしたのさ。」\\n――人形遣いのタヒム\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486667&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'26b3a002-4ed1-4dab-91ea-bffd013cd361\', \'multiverseId\': 486667}, \'multiverseid\': 486667}, {\'name\': \'마음을 사로잡는 움켜쥠\', \'text\': \'생물에게 부여\\n당신은 이 주문을 발동하면서 이 주문의 목표를 언탭된 생물로 선택할 수 없다.\\n당신이 부여된 생물을 조종한다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'"일을 해 주면 대가를 지불하겠다고 했는데, 그가 거절했지. 그래서 내가 직접 손을 대고 있다네."\\n—꼭두각시술사, 타힘\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486926&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c27a3c23-da34-4653-9f50-41f8eacdc438\', \'multiverseId\': 486926}, \'multiverseid\': 486926}, {\'name\': \'Domínio Hipnotizante\', \'text\': \'Encantar criatura\\nVocê não pode escolher uma criatura desvirada como alvo desta mágica conforme a conjura.\\nVocê controla a criatura encantada.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Eu ofereci pagamento pelo serviço, mas ele recusou. Daí resolvi com minhas próprias mãos."\\n— Tahim, o Mestre dos Fantoches\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487185&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3824b811-9421-4803-b2f1-45989c58ac3d\', \'multiverseId\': 487185}, \'multiverseid\': 487185}, {\'name\': \'Порабощающая Хватка\', \'text\': \'Зачаровать существо\\nПри разыгрывании этого заклинания вы не можете выбрать его целью развернутое существо.\\nВы контролируете зачарованное существо.\', \'type\': \'Чары — Аура\', \'flavor\': \'«Я предложил заплатить ему за работу, но он отказался. Так что я взял дело в свои руки».\\n— Тахим, кукловод\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487444&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a112609f-9890-4a56-bf43-c32fba1c8530\', \'multiverseId\': 487444}, \'multiverseid\': 487444}, {\'name\': \'迷魅掌控\', \'text\': \'结附于生物\\n于你施放此咒语时，你不能选择未横置的生物作为其目标。\\n你操控所结附的生物。\', \'type\': \'结界 ～灵气\', \'flavor\': \'「我原本提议付钱来雇他做事，但他拒绝了。所以我只好亲自出马。」\\n～操偶大师塔西姆\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487703&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'90328845-dea9-42e5-ad4b-40dc8c7f8022\', \'multiverseId\': 487703}, \'multiverseid\': 487703}, {\'name\': \'迷魅掌控\', \'text\': \'結附於生物\\n於你施放此咒語時，你不能選擇未橫置的生物作為其目標。\\n你操控所結附的生物。\', \'type\': \'結界 ～靈氣\', \'flavor\': \'「我原本提議付錢來雇他做事，但他拒絕了。所以我只好親自出馬。」\\n～操偶大師塔西姆\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487962&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d80552f1-60f3-4004-9d62-7dccd922dd47\', \'multiverseId\': 487962}, \'multiverseid\': 487962}]', '[{\'name\': \'Mystischer Flugfisch\', \'text\': \'Immer wenn du deine zweite Karte innerhalb desselben Zuges ziehst, erhält der Mystische Flugfisch Flugfähigkeit bis zum Ende des Zuges.\', \'type\': \'Kreatur — Fisch\', \'flavor\': \'Das Problem war nicht, dass Fische Fliegen gelernt hatten. Das Problem war, dass Haie gelernt hatten, ihnen zu folgen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488652&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'db142ee1-6b37-4ba1-82e0-fb423e76e52f\', \'multiverseId\': 488652}, \'multiverseid\': 488652}, {\'name\': \'Pez volador místico\', \'text\': \'Siempre que robes tu segunda carta cada turno, el Pez volador místico gana la habilidad de volar hasta el final del turno.\', \'type\': \'Criatura — Pez\', \'flavor\': \'El problema no fue que los peces aprendiesen a volar, sino que los tiburones se adaptaron para seguirlos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488672&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ddd1ab2f-a9d3-42d5-baab-bdd2235e7e4b\', \'multiverseId\': 488672}, \'multiverseid\': 488672}, {\'name\': \'Exocet volant mystique\', \'text\': "À chaque fois que vous piochez votre deuxième carte à chaque tour, l\'Exocet volant mystique acquiert le vol jusqu\'à la fin du tour.", \'type\': \'Créature : poisson\', \'flavor\': "Le problème n\'était pas que les poissons aient appris à voler, mais que les requins aient évolué pour les suivre.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488692&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9a0c3698-3944-4fcc-b5b5-1089e6328232\', \'multiverseId\': 488692}, \'multiverseid\': 488692}, {\'name\': \'Pesce Celeste Mistico\', \'text\': \'Ogniqualvolta peschi la tua seconda carta in ogni turno, il Pesce Celeste Mistico ha volare fino alla fine del turno.\', \'type\': \'Creatura — Pesce\', \'flavor\': \'Il problema non era che i pesci avessero imparato a volare, ma che gli squali si fossero adattati per seguirli.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488712&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6de21311-190b-4f3a-8e05-c6c8b225560c\', \'multiverseId\': 488712}, \'multiverseid\': 488712}, {\'name\': \'神秘の空魚\', \'text\': \'あなたが各ターンのあなたの２枚目のカードを引くたび、ターン終了時まで、神秘の空魚は飛行を得る。\', \'type\': \'クリーチャー — 魚\', \'flavor\': \'問題はその魚が空を飛ぶ方法を覚えたことではない。サメがそれについていく方法を覚えたことだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488732&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'839a60a9-a394-43ef-8ed5-32e6bea5de89\', \'multiverseId\': 488732}, \'multiverseid\': 488732}, {\'name\': \'신비한 하늘물고기\', \'text\': \'당신이 각 턴에 당신의 두 번째 카드를 뽑을 때마다, 신비한 하늘물고기는 턴종료까지 비행을 얻는다.\', \'type\': \'생물 — 어류\', \'flavor\': \'문제는 물고기가 나는 방법을 배웠다는 사실이 아니라 상어가 그것을 뒤쫓기 위해 적응했다는 것이었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488752&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f2601170-197b-4d8b-acdb-ffd52b9a0f94\', \'multiverseId\': 488752}, \'multiverseid\': 488752}, {\'name\': \'Aeropeixe Místico\', \'text\': \'Toda vez que você compra seu segundo card a cada turno, Aeropeixe Místico ganha voar até o final do turno.\', \'type\': \'Criatura — Peixe\', \'flavor\': \'O problema não era o fato dos peixes terem aprendido a voar, mas os tubarões terem se adaptado para segui-los.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488772&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f8bbf3b3-8c7a-423b-b1e8-0a69e2de13b7\', \'multiverseId\': 488772}, \'multiverseid\': 488772}, {\'name\': \'Таинственная Небесная Рыба\', \'text\': \'Каждый раз, когда вы берете вашу вторую карту в каждом ходу, Таинственная Небесная Рыба получает Полет до конца хода.\', \'type\': \'Существо — Рыба\', \'flavor\': \'Проблема заключалась не в том, что некоторые рыбы научились летать. Она заключалась в том, что за ними последовали акулы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488792&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f4293402-0bde-4cf8-a806-3bfd35631266\', \'multiverseId\': 488792}, \'multiverseid\': 488792}, {\'name\': \'神秘飞鱼\', \'text\': \'每当你抓每回合中你的第二张牌时，神秘飞鱼获得飞行异能直到回合结束。\', \'type\': \'生物 ～鱼\', \'flavor\': \'问题不是鱼学会了飞，而是鲨鱼为了追赶上也随之进化。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488812&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'482bd399-335e-4b35-a863-d77844176d7f\', \'multiverseId\': 488812}, \'multiverseid\': 488812}, {\'name\': \'神秘飛魚\', \'text\': \'每當你抽每回合中你的第二張牌時，神秘飛魚獲得飛行異能直到回合結束。\', \'type\': \'生物 ～魚\', \'flavor\': \'問題不是魚學會了飛，而是鯊魚為了追趕上也隨之進化。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488832&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'46722e9c-a449-404b-a674-574f31cba790\', \'multiverseId\': 488832}, \'multiverseid\': 488832}]', '[{\'name\': \'Nekromenz\', \'text\': \'Bestimme einen Kartennamen außer einem Standardland-Kartennamen. Durchsuche den Friedhof, die Hand und die Bibliothek eines Gegners deiner Wahl nach einer beliebigen Anzahl an Karten mit diesem Namen und schicke sie ins Exil. Der Spieler mischt seine Bibliothek und erzeugt dann für jede auf diese Weise aus seiner Hand ins Exil geschickte Karte einen 2/2 schwarzen Zombie-Kreaturenspielstein.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485698&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'08331a41-1e6c-48f9-bb72-05e179432e2b\', \'multiverseId\': 485698}, \'multiverseid\': 485698}, {\'name\': \'Nigromencia\', \'text\': \'Elige un nombre de carta que no sea el nombre de una carta de tierra básica. Busca en el cementerio, mano y biblioteca del oponente objetivo cualquier cantidad de cartas con ese nombre y exílialas. Ese jugador baraja su biblioteca y luego crea una ficha de criatura Zombie negra 2/2 por cada carta exiliada de su mano de esta manera.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485957&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'28e4437c-6744-4b47-a8d7-651d51b77a45\', \'multiverseId\': 485957}, \'multiverseid\': 485957}, {\'name\': \'Nécrodémence\', \'text\': "Choisissez un nom de carte autre que celui d\'un terrain de base. Cherchez dans le cimetière, la main et la bibliothèque de l\'adversaire ciblé n\'importe quel nombre de cartes avec ce nom et exilez-les. Ce joueur mélange sa bibliothèque, puis crée un jeton de créature 2/2 noire Zombie pour chaque carte exilée depuis sa main de cette manière.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486216&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6f333237-206a-43af-a87f-f1cb1698a10e\', \'multiverseId\': 486216}, \'multiverseid\': 486216}, {\'name\': \'Necrodemenza\', \'text\': \'Scegli il nome di una carta diverso dal nome di una carta terra base. Passa in rassegna il cimitero, la mano e il grimorio di un avversario bersaglio per un qualsiasi numero di carte con quel nome ed esiliale. Quel giocatore rimescola il suo grimorio, poi crea una pedina creatura Zombie 2/2 nera per ogni carta esiliata dalla sua mano in questo modo.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486475&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f7a0dc43-fb64-4cf6-8aea-9df4fc9c4d0d\', \'multiverseId\': 486475}, \'multiverseid\': 486475}, {\'name\': \'屍呆症\', \'text\': \'対戦相手１人を対象とする。基本土地・カードの名前でないカード名１つを選ぶ。そのプレイヤーの墓地と手札とライブラリーから、その名前を持つ望む枚数のカードを探し、追放する。そのプレイヤーは自分のライブラリーを切り直し、その後そのプレイヤーは、これにより自分の手札から追放されたカード１枚につき黒の２/２のゾンビ・クリーチャー・トークンを１体生成する。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486734&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1a960e5f-7409-4e46-af5b-9f894acbcfc2\', \'multiverseId\': 486734}, \'multiverseid\': 486734}, {\'name\': \'사령증\', \'text\': \'기본 대지 카드 이름이 아닌 카드 이름을 선택한다. 상대를 목표로 정한다. 그 상대의 무덤, 손, 서고에서 그 이름의 카드를 원하는 만큼 찾아서 추방한다. 그 플레이어는 자신의 서고를 섞은 후, 이런 식으로 자신의 손에서 추방된 카드 한 장당 2/2 흑색 좀비 생물 토큰 한 개를 만든다.\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486993&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'79184014-6994-4285-b7cc-fc1f997de524\', \'multiverseId\': 486993}, \'multiverseid\': 486993}, {\'name\': \'Necromência\', \'text\': \'Escolha um nome de card que não seja de um terreno básico. Procure um número qualquer de cards com aquele nome no cemitério, na mão e no grimório do oponente alvo e exile-os. Aquele jogador embaralha o próprio grimório e, em seguida, cria uma ficha de criatura preta 2/2 do tipo Zumbi para cada card exilado da própria mão dessa forma.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487252&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d677f743-d599-47ae-8ed2-bc4d50db55f3\', \'multiverseId\': 487252}, \'multiverseid\': 487252}, {\'name\': \'Некроменция\', \'text\': \'Выберите имя карты за исключением имени карты базовой земли. Найдите на кладбище, в руке и в библиотеке целевого оппонента любое количество карт с тем именем и изгоните их. Тот игрок тасует свою библиотеку, затем создает одну фишку существа 2/2 черный Зомби за каждую карту, изгнанную из его руки таким образом.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487511&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b0e8c048-a028-471e-8575-f0ee8a67e9f7\', \'multiverseId\': 487511}, \'multiverseid\': 487511}, {\'name\': \'死灵惧相\', \'text\': \'选择一个基本地牌名称以外的牌名。从目标对手的坟墓场，手牌及牌库中搜寻任意数量具该名称的牌，并将它们放逐。该牌手将其牌库洗牌，然后每有一张以此法放逐的手牌，他便派出一个2/2黑色灵俑衍生生物。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487770&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'32223393-0c0e-4a9b-b324-b90014e2ad14\', \'multiverseId\': 487770}, \'multiverseid\': 487770}, {\'name\': \'死靈懼相\', \'text\': \'選擇一個基本地牌名稱以外的牌名。從目標對手的墳墓場，手牌及牌庫中搜尋任意數量具該名稱的牌，並將它們放逐。該玩家將其牌庫洗牌，然後每有一張以此法放逐的手牌，他便派出一個2/2黑色殭屍衍生生物。\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488029&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'355055bb-7ebd-45b2-8599-d7b0a8d47364\', \'multiverseId\': 488029}, \'multiverseid\': 488029}]', "[{'name': 'Neuf vies', 'text': 'Défense talismanique\\nSi une source devait vous infliger des blessures, prévenez ces blessures et mettez un marqueur « incarnation » sur les Neuf vies.\\nQuand il y a au moins neuf marqueurs « incarnation » sur les Neuf vies, exilez-les.\\nQuand les Neuf vies quittent le champ de bataille, vous perdez la partie.', 'type': 'Enchantement', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488295&type=card', 'language': 'French', 'identifiers': {'scryfallId': '6e33f69d-cbbd-4477-8ed2-4bae28991f0c', 'multiverseId': 488295}, 'multiverseid': 488295}, {'name': '九つの命', 'text': '呪禁\\n発生源１つがあなたにダメージを与えるなら、そのダメージを軽減し、九つの命の上に具現カウンターを１個置く。\\n九つの命の上に具現カウンターが９個以上あるとき、これを追放する。\\n九つの命が戦場を離れたとき、あなたはこのゲームに敗北する。', 'type': 'エンチャント', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488347&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '671e31d3-1953-4584-90bc-a64995eef3f2', 'multiverseId': 488347}, 'multiverseid': 488347}]", "[{'name': 'Neun Leben', 'text': 'Fluchsicher\\nFalls eine Quelle dir Schadenspunkte zufügen würde, verhindere diesen Schaden und lege eine Inkarnationsmarke auf Neun Leben.\\nWenn neun oder mehr Inkarnationsmarken auf Neun Leben liegen, schicke sie ins Exil.\\nWenn Neun Leben das Spiel verlässt, verlierst du die Partie.', 'type': 'Verzauberung', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485610&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'cf798b8d-f275-481c-83fb-26c76af80a40', 'multiverseId': 485610}, 'multiverseid': 485610}, {'name': 'Nueve vidas', 'text': 'Antimaleficio.\\nSi una fuente fuera a hacerte daño, prevén ese daño y pon un contador de encarnación sobre las Nueve vidas.\\nCuando haya nueve o más contadores de encarnación sobre las Nueve vidas, exílialas.\\nCuando las Nueve vidas dejen el campo de batalla, pierdes el juego.', 'type': 'Encantamiento', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485869&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ea4fb6a8-4e8d-41cd-bff5-8f6ea9151e2f', 'multiverseId': 485869}, 'multiverseid': 485869}, {'name': 'Neuf vies', 'text': 'Défense talismanique\\nSi une source devait vous infliger des blessures, prévenez ces blessures et mettez un marqueur « incarnation » sur les Neuf vies.\\nQuand il y a au moins neuf marqueurs « incarnation » sur les Neuf vies, exilez-les.\\nQuand les Neuf vies quittent le champ de bataille, vous perdez la partie.', 'type': 'Enchantement', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486128&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e6f437cc-4883-4719-9fac-90c5a2971632', 'multiverseId': 486128}, 'multiverseid': 486128}, {'name': 'Nove Vite', 'text': 'Anti-malocchio\\nSe una fonte sta per infliggerti danno, previeni quel danno e metti un segnalino incarnazione sulle Nove Vite.\\nQuando ci sono nove o più segnalini incarnazione sulle Nove Vite, esiliale.\\nQuando le Nove Vite lasciano il campo di battaglia, perdi la partita.', 'type': 'Incantesimo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486387&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '1c89a208-fb4b-4c1e-8598-6f99eee5222e', 'multiverseId': 486387}, 'multiverseid': 486387}, {'name': '九つの命', 'text': '呪禁\\n発生源１つがあなたにダメージを与えるなら、そのダメージを軽減し、九つの命の上に具現カウンターを１個置く。\\n九つの命の上に具現カウンターが９個以上あるとき、これを追放する。\\n九つの命が戦場を離れたとき、あなたはこのゲームに敗北する。', 'type': 'エンチャント', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486646&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '7346fed1-8bf6-46cb-8db1-19ce427fe07c', 'multiverseId': 486646}, 'multiverseid': 486646}, {'name': '아홉 개의 목숨', 'text': '방호\\n어떤 원천이 당신에게 피해를 입히려 한다면, 그 피해를 방지하고 아홉 개의 목숨에 현신 카운터 한 개를 올려놓는다.\\n아홉 개의 목숨에 현신 카운터가 아홉 개 이상 놓여 있을 때, 아홉 개의 목숨을 추방한다.\\n아홉 개의 목숨이 전장을 떠날 때, 당신은 게임에서 패배한다.', 'type': '부여마법', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486905&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '258aa404-10b4-4edb-af70-1b8c096ce465', 'multiverseId': 486905}, 'multiverseid': 486905}, {'name': 'Nove Vidas', 'text': 'Resistência a magia\\nSe uma fonte causaria dano a você, previna aquele dano e coloque um marcador de encarnação em Nove Vidas.\\nQuando houver nove ou mais marcadores de encarnação em Nove Vidas, exile-a.\\nQuando Nove Vidas deixa o campo de batalha, você perde o jogo.', 'type': 'Encantamento', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487164&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f07bec3c-9c5a-4e77-b644-4986aa4aa38d', 'multiverseId': 487164}, 'multiverseid': 487164}, {'name': 'Девять Жизней', 'text': 'Порчеустойчивость\\nЕсли источник должен нанести вам повреждения, предотвратите те повреждения и положите один жетон инкарнации на Девять Жизней.\\nКогда на Девяти Жизнях есть девять или более жетонов инкарнации, изгоните их.\\nКогда Девять Жизней покидают поле битвы, вы проигрываете партию.', 'type': 'Чары', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487423&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '3f606854-3493-45da-9521-550404b3b804', 'multiverseId': 487423}, 'multiverseid': 487423}, {'name': '九命护身', 'text': '辟邪\\n如果某来源将对你造成伤害，则防止该伤害且在九命护身上放置一个转生指示物。\\n当九命护身上有九个或更多转生指示物时，将它放逐。\\n当九命护身离开战场时，你输掉这盘游戏。', 'type': '结界', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487682&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '77a0c492-d38a-441b-9700-4a3fd3a3ee53', 'multiverseId': 487682}, 'multiverseid': 487682}, {'name': '九命護身', 'text': '辟邪\\n如果某來源將對你造成傷害，則防止該傷害且在九命護身上放置一個轉生指示物。\\n當九命護身上有九個或更多轉生指示物時，將它放逐。\\n當九命護身離開戰場時，你輸掉這盤遊戲。', 'type': '結界', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487941&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'f96e7e77-8c4f-4d76-af26-bfb2f6af8409', 'multiverseId': 487941}, 'multiverseid': 487941}]", '[{\'name\': \'Niambi, angesehene Rednerin\', \'text\': \'Aufblitzen\\nWenn Niambi, angesehene Rednerin, ins Spiel kommt, kannst du eine andere Kreatur deiner Wahl, die du kontrollierst, auf die Hand ihres Besitzers zurückbringen. Falls du dies tust, erhältst du Lebenspunkte in Höhe der umgewandelten Manakosten jener Kreatur dazu.\\n{1}{W}{U}, {T}, wirf eine legendäre Karte ab: Ziehe zwei Karten.\', \'type\': \'Legendäre Kreatur — Mensch, Kleriker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485804&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d3d2b581-cc68-4017-b168-975f8e2885d1\', \'multiverseId\': 485804}, \'multiverseid\': 485804}, {\'name\': \'Niambi, oradora reconocida\', \'text\': \'Destello.\\nCuando Niambi, oradora reconocida entre al campo de batalla, puedes regresar otra criatura objetivo que controlas a la mano de su propietario. Si lo haces, ganas una cantidad de vidas igual al coste de maná convertido de esa criatura.\\n{1}{W}{U}, {T}, descartar una carta legendaria: Roba dos cartas.\', \'type\': \'Criatura legendaria — Clérigo humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486063&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ed51b9e5-e76a-4836-9eb5-19158711d8b5\', \'multiverseId\': 486063}, \'multiverseid\': 486063}, {\'name\': \'Niambi, oratrice respectée\', \'text\': "Flash\\nQuand Niambi, oratrice respectée arrive sur le champ de bataille, vous pouvez renvoyer une autre créature ciblée que vous contrôlez dans la main de son propriétaire. Si vous faites ainsi, vous gagnez un nombre de points de vie égal au coût converti de mana de cette créature.\\n{1}{W}{U}, {T}, défaussez-vous d\'une carte légendaire : Piochez deux cartes.", \'type\': \'Créature légendaire : humain et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486322&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'299f2129-42c8-46ca-ab51-e43644f58496\', \'multiverseId\': 486322}, \'multiverseid\': 486322}, {\'name\': \'Niambi, Oratrice Rinomata\', \'text\': "Lampo\\nQuando Niambi, Oratrice Rinomata entra nel campo di battaglia, puoi far tornare un\'altra creatura bersaglio che controlli in mano al suo proprietario. Se lo fai, guadagni punti vita pari al costo di mana convertito di quella creatura.\\n{1}{W}{U}, {T}, Scarta una carta leggendaria: Pesca due carte.", \'type\': \'Creatura Leggendaria — Chierico Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486581&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'56b6d887-4e7d-490c-be6f-ea212e0dc55e\', \'multiverseId\': 486581}, \'multiverseid\': 486581}, {\'name\': \'尊敬される語り手、ニアンビ\', \'text\': \'瞬速\\n尊敬される語り手、ニアンビが戦場に出たとき、他の、あなたがコントロールしているクリーチャー１体を対象とする。あなたはそれをオーナーの手札に戻してもよい。そうしたなら、あなたはそのクリーチャーの点数で見たマナ・コストに等しい点数のライフを得る。\\n{1}{W}{U}, {T}, 伝説のカード１枚を捨てる：カードを２枚引く。\', \'type\': \'伝説のクリーチャー — 人間・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486840&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7f2a5c13-5adc-4570-a0bf-5d0ec62a6f1e\', \'multiverseId\': 486840}, \'multiverseid\': 486840}, {\'name\': \'존경받는 연설가, 니암비\', \'text\': \'섬광\\n존경받는 연설가, 니암비가 전장에 들어올 때, 당신이 조종하는 다른 생물을 목표로 정한다. 당신은 그 생물을 소유자의 손으로 되돌릴 수 있다. 그렇게 한다면, 당신은 그 생물의 전환마나비용만큼 생명점을 얻는다.\\n{1}{W}{U}, {T}, 전설적 카드 한 장을 버린다: 카드 두 장을 뽑는다.\', \'type\': \'전설적 생물 — 인간 성직자\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487099&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'425c57ac-f0f6-4257-8e31-bbe67c14da4d\', \'multiverseId\': 487099}, \'multiverseid\': 487099}, {\'name\': \'Niambi, Estimada Oradora\', \'text\': \'Lampejo\\nQuando Niambi, Estimada Oradora, entra no campo de batalha, você pode devolver outra criatura alvo que você controla para a mão de seu dono. Se fizer isso, você ganha uma quantidade de pontos de vida igual ao custo de mana convertido daquela criatura.\\n{1}{W}{U}, {T}, descarte um card lendário: Compre dois cards.\', \'type\': \'Criatura Lendária — Humano Clérigo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487358&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f85d4310-237c-454b-9992-9ad0609bd724\', \'multiverseId\': 487358}, \'multiverseid\': 487358}, {\'name\': \'Ньямби, Почтенный Оратор\', \'text\': \'Миг\\nКогда Ньямби, Почтенный Оратор выходит на поле битвы, вы можете вернуть другое целевое существо под вашим контролем в руку его владельца. Если вы это делаете, вы получаете количество жизней, равное конвертированной мана-стоимости того существа.\\n{1}{W}{U}, {T}, сбросьте легендарную карту: возьмите две карты.\', \'type\': \'Легендарное Существо — Человек Священник\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487617&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5583e986-1906-4f87-8e0a-60855808765e\', \'multiverseId\': 487617}, \'multiverseid\': 487617}, {\'name\': \'尊贵议长妮安碧\', \'text\': \'闪现\\n当尊贵议长妮安碧进战场时，你可以将另一个目标由你操控的生物移回其拥有者手上。若你如此作，则你获得等同于该生物总法术力费用的生命。\\n{1}{W}{U}，{T}，弃一张传奇牌：抓两张牌。\', \'type\': \'传奇生物 ～人类／僧侣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487876&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ebfe191d-a1f5-4630-b935-4a2878466499\', \'multiverseId\': 487876}, \'multiverseid\': 487876}, {\'name\': \'尊貴議長妮安碧\', \'text\': \'閃現\\n當尊貴議長妮安碧進戰場時，你可以將另一個目標由你操控的生物移回其擁有者手上。若你如此作，則你獲得等同於該生物總魔法力費用的生命。\\n{1}{W}{U}，{T}，棄一張傳奇牌：抽兩張牌。\', \'type\': \'傳奇生物 ～人類／僧侶\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488135&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'22452563-75d8-44b7-8e63-507bd7842b5f\', \'multiverseId\': 488135}, \'multiverseid\': 488135}]', '[{\'name\': \'Niambi, oratrice respectée\', \'text\': "Flash\\nQuand Niambi, oratrice respectée arrive sur le champ de bataille, vous pouvez renvoyer une autre créature ciblée que vous contrôlez dans la main de son propriétaire. Si vous faites ainsi, vous gagnez un nombre de points de vie égal au coût converti de mana de cette créature.\\n{1}{W}{U}, {T}, défaussez-vous d\'une carte légendaire : Piochez deux cartes.", \'type\': \'Créature légendaire : humain et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488330&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ef52263c-7d9f-4537-b2dd-a97e7686f559\', \'multiverseId\': 488330}, \'multiverseid\': 488330}, {\'name\': \'尊敬される語り手、ニアンビ\', \'text\': \'瞬速\\n尊敬される語り手、ニアンビが戦場に出たとき、他の、あなたがコントロールしているクリーチャー１体を対象とする。あなたはそれをオーナーの手札に戻してもよい。そうしたなら、あなたはそのクリーチャーの点数で見たマナ・コストに等しい点数のライフを得る。\\n{1}{W}{U}, {T}, 伝説のカード１枚を捨てる：カードを２枚引く。\', \'type\': \'伝説のクリーチャー — 人間・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488382&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'daccfb7d-dc62-460f-85b1-67c2ce9b6e21\', \'multiverseId\': 488382}, \'multiverseid\': 488382}]', '[{\'name\': \'Nécrodémence\', \'text\': "Choisissez un nom de carte autre que celui d\'un terrain de base. Cherchez dans le cimetière, la main et la bibliothèque de l\'adversaire ciblé n\'importe quel nombre de cartes avec ce nom et exilez-les. Ce joueur mélange sa bibliothèque, puis crée un jeton de créature 2/2 noire Zombie pour chaque carte exilée depuis sa main de cette manière.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488310&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'34c70f65-af06-4a48-9d1e-c98f808592b9\', \'multiverseId\': 488310}, \'multiverseid\': 488310}, {\'name\': \'屍呆症\', \'text\': \'対戦相手１人を対象とする。基本土地・カードの名前でないカード名１つを選ぶ。そのプレイヤーの墓地と手札とライブラリーから、その名前を持つ望む枚数のカードを探し、追放する。そのプレイヤーは自分のライブラリーを切り直し、その後そのプレイヤーは、これにより自分の手札から追放されたカード１枚につき黒の２/２のゾンビ・クリーチャー・トークンを１体生成する。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488362&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1fc0c5ae-8cb9-41d0-80fe-2bd19a80d5a5\', \'multiverseId\': 488362}, \'multiverseid\': 488362}]', '[{\'name\': \'Onakke-Oger\', \'type\': \'Kreatur — Oger, Krieger\', \'flavor\': \'Die Onakke haben mit anderen Ogern nichts gemein. Sie sind sowohl intelligent als auch geschäftig und setzen ihre rohe Kraft ohne Brutalität ein.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485737&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7e0bdf19-3916-4d92-bd4b-ba98d6f6bd9d\', \'multiverseId\': 485737}, \'multiverseid\': 485737}, {\'name\': \'Ogro onakke\', \'type\': \'Criatura — Guerrero ogro\', \'flavor\': \'Los ogros que conoces no se parecen en nada a los Onakke. Estos tenían inteligencia y capacidad de elaboración; poseían fuerza bruta, pero no eran brutos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485996&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'68d8340f-57c6-4c99-bfe8-fb98d4ba5858\', \'multiverseId\': 485996}, \'multiverseid\': 485996}, {\'name\': \'Ogre onakke\', \'type\': \'Créature : ogre et guerrier\', \'flavor\': "Les ogres communs n\'ont rien à voir avec les Onakke. Intelligents et travailleurs, ces derniers possèdent une force brute sans être des brutes eux-mêmes.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486255&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7d58839e-ed3a-46f8-bdf8-47930a3c2b12\', \'multiverseId\': 486255}, \'multiverseid\': 486255}, {\'name\': \'Ogre degli Onakke\', \'type\': \'Creatura — Guerriero Ogre\', \'flavor\': \'Gli ogre che conosciamo non hanno niente a che vedere con gli Onakke. Intelligenti e operosi, erano dotati di forza bruta, ma non per questo brutali.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486514&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4dc8203d-3271-4054-b4a5-bec718e865ba\', \'multiverseId\': 486514}, \'multiverseid\': 486514}, {\'name\': \'オナッケのオーガ\', \'type\': \'クリーチャー — オーガ・戦士\', \'flavor\': \'君の知るオーガはオナッケとは別物だ。知性と技術の両方を持ち、暴れずとも甚大な力を持っていた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486773&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1601ca41-5817-47a3-9035-a636a2fc32ac\', \'multiverseId\': 486773}, \'multiverseid\': 486773}, {\'name\': \'오낙케 오우거\', \'type\': \'생물 — 오우거 전사\', \'flavor\': \'오낙케는 당신이 아는 오우거와 전혀 다르다. 지성과 근면성을 겸비한 그들은, 짐승같은 힘을 가졌지만 야만적이지 않았다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487032&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'663b815e-e003-4271-88db-446f3f8811bf\', \'multiverseId\': 487032}, \'multiverseid\': 487032}, {\'name\': \'Ogro Onakke\', \'type\': \'Criatura — Ogro Guerreiro\', \'flavor\': \'Os ogros que você conhece não são como os Onakke. Inteligentes e engenhosos, eles tinham força bruta sem serem brutos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487291&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'134bf65f-cf25-4a3c-9c6b-870c7161814b\', \'multiverseId\': 487291}, \'multiverseid\': 487291}, {\'name\': \'Огр Онакке\', \'type\': \'Существо — Огр Воин\', \'flavor\': \'Онакке не похожи на обычных огров. Они обладают и острым умом, и упрямой мощью; в них есть грубая сила, но нет тупой грубости.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487550&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f80d19fe-cc46-409e-8099-515c3210100e\', \'multiverseId\': 487550}, \'multiverseid\': 487550}, {\'name\': \'欧纳克食人魔\', \'type\': \'生物 ～食人魔／战士\', \'flavor\': \'欧纳克一族和你所知的食人魔完全不同。他们聪明又勤奋，身怀蛮力却不粗蛮。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487809&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1acad4d6-907b-40e2-8762-cf4a099ee11d\', \'multiverseId\': 487809}, \'multiverseid\': 487809}, {\'name\': \'歐納克食人魔\', \'type\': \'生物 ～食人魔／戰士\', \'flavor\': \'歐納克一族和你所知的食人魔完全不同。他們聰明又勤奮，身懷蠻力卻不粗蠻。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488068&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3bbfb195-0740-437b-90a4-b1ca0fd459ec\', \'multiverseId\': 488068}, \'multiverseid\': 488068}]', '[{\'name\': \'Optionen\', \'text\': \'Hellsicht 1. (Schaue dir die oberste Karte deiner Bibliothek an. Du kannst sie unter deine Bibliothek legen.)\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'Der Kristall pulsierte mit der Macht von Teferis Planeswalker-Funken. War Jhoiras Geschenk ein Segen oder ein Fluch?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485641&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c1648f2a-5fd3-47c8-94fc-f948a427dc7b\', \'multiverseId\': 485641}, \'multiverseid\': 485641}, {\'name\': \'Optar\', \'text\': \'Adivina 1. (Mira la primera carta de tu biblioteca. Puedes poner esa carta en el fondo de tu biblioteca.)\\nRoba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'El cristal latía con el poder de la chispa de planeswalker de Teferi. ¿Lo que le había dado Jhoira era una bendición o una maldición?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485900&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0fcfb2fe-47aa-453a-8ea2-8d0e16c90aae\', \'multiverseId\': 485900}, \'multiverseid\': 485900}, {\'name\': \'Option\', \'text\': \'Regard 1. (Regardez la carte du dessus de votre bibliothèque. Vous pouvez la mettre au-dessous de votre bibliothèque.)\\nPiochez une carte.\', \'type\': \'Éphémère\', \'flavor\': "Le cristal brillait sous l\'effet de la puissance de l\'étincelle de planeswalker de Téfeiri. Djoïra lui avait-elle donné une bénédiction ou une calamité ?", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486159&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'defa36e1-5a7b-4122-91b8-9aa43fe9fec3\', \'multiverseId\': 486159}, \'multiverseid\': 486159}, {\'name\': \'Opzione\', \'text\': \'Profetizza 1. (Guarda la prima carta del tuo grimorio. Puoi mettere quella carta in fondo al tuo grimorio.)\\nPesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': "Nel cristallo pulsava il potere della scintilla di Planeswalker di Teferi. Jhoira l\'aveva benedetto o maledetto?", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486418&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a91053cc-2268-4ca0-a842-ce1d08b0453e\', \'multiverseId\': 486418}, \'multiverseid\': 486418}, {\'name\': \'選択\', \'text\': \'占術１を行う。（あなたのライブラリーの一番上のカードを見る。あなたはそのカードをあなたのライブラリーの一番下に置いてもよい。）\\nカードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': \'テフェリーのプレインズウォーカーの灯を受けて水晶が明滅していた。ジョイラが与えたのは祝福なのか、それとも呪いなのだろうか？\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486677&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'689577ec-8427-4b77-a727-b8a98e3b4d25\', \'multiverseId\': 486677}, \'multiverseid\': 486677}, {\'name\': \'선택\', \'text\': \'점술 1을 한다. (당신의 서고 맨 위 카드 한 장을 본다. 당신은 그 카드를 당신의 서고 맨 밑에 놓을 수 있다.)\\n카드 한 장을 뽑는다.\', \'type\': \'순간마법\', \'flavor\': \'수정은 테페리의 플레인즈워커 불꽃으로 고동치고 있다. 조이라는 그를 축복한 것인가, 저주한 것인가?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486936&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6cc1e143-9f85-43f5-b396-0e1237080dc7\', \'multiverseId\': 486936}, \'multiverseid\': 486936}, {\'name\': \'Optar\', \'text\': \'Vidência 1. (Olhe o card do topo de seu grimório. Você pode colocar aquele card no fundo de seu grimório.)\\nCompre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'O cristal pulsou com o poder da centelha de planeswalker de Teferi. O que Jhoira lhe dera era uma bênção ou uma maldição?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487195&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2ca98869-5ced-44db-8104-331a4238a060\', \'multiverseId\': 487195}, \'multiverseid\': 487195}, {\'name\': \'Выбор\', \'text\': \'Предскажите 1. (Посмотрите верхнюю карту вашей библиотеки. Вы можете положить ту карту в низ вашей библиотеки.)\\nВозьмите карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Кристалл пульсировал, до краев переполненный силой искры Тефери. Что дала ему Джойра — благословение или проклятье?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487454&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'30dbd299-c2f2-4a3e-84e8-fd5382c7baae\', \'multiverseId\': 487454}, \'multiverseid\': 487454}, {\'name\': \'抉择\', \'text\': \'占卜1。（检视你牌库顶的牌。你可以将该牌置于你的牌库底。）\\n抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'水晶球涌动着泰菲力鹏洛客火花的力量。尤依拉带给他的是祝福，还是诅咒？\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487713&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1ec9dac8-f327-49e6-afd9-9c62c45557d7\', \'multiverseId\': 487713}, \'multiverseid\': 487713}, {\'name\': \'抉擇\', \'text\': \'占卜1。（檢視你牌庫頂的牌。你可以將該牌置於你的牌庫底。）\\n抽一張牌。\', \'type\': \'瞬間\', \'flavor\': \'水晶球湧動著泰菲力鵬洛客火花的力量。尤依菈帶給他的是祝福，還是詛咒？\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487972&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5c6947fc-c793-4534-9973-c8628d186aec\', \'multiverseId\': 487972}, \'multiverseid\': 487972}]', '[{\'name\': \'Orateur des Cieux\', \'text\': "Vigilance, lien de vie\\n{T} : Créez un jeton de créature 4/4 blanche Ange avec le vol. N\'activez cette capacité que si vous avez au moins 7 points de vie de plus que votre total de points de vie de départ et uniquement lorsque vous pourriez lancer un rituel.", \'type\': \'Créature : humain et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488298&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ceb1fa89-d112-4f38-9880-1cb151dcccbb\', \'multiverseId\': 488298}, \'multiverseid\': 488298}, {\'name\': \'天界の語り部\', \'text\': \'警戒、絆魂\\n{T}：飛行を持つ白の４/４の天使・クリーチャー・トークンを１体生成する。この能力は、あなたのライフが、あなたの初期ライフ総量よりも７点以上多く、かつ、あなたがソーサリーを唱えられるときにのみ起動できる。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488350&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fd48acd0-3dba-4133-bc40-7a8c5e16ef33\', \'multiverseId\': 488350}, \'multiverseid\': 488350}]', "[{'name': 'Palladiummyr', 'text': '{T}: Erzeuge {C}{C}.', 'type': 'Artefaktkreatur — Myr', 'flavor': 'Die Myr sind wie die Glimmerleere: leere Leinwände, auf denen man große Kunstwerke schaffen könnte.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485816&type=card', 'language': 'German', 'identifiers': {'scryfallId': '40785b0e-7b1b-45a0-bcde-d6674aeb232c', 'multiverseId': 485816}, 'multiverseid': 485816}, {'name': 'Myr de paladio', 'text': '{T}: Agrega {C}{C}.', 'type': 'Criatura artefacto — Myr', 'flavor': 'Los myr son como el Campo Resplandeciente: lienzos en blanco sobre los que dibujar grandes creaciones.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486075&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '3d9f6a35-a74c-4bc7-b00f-22b5cf8f1708', 'multiverseId': 486075}, 'multiverseid': 486075}, {'name': 'Myr de palladium', 'text': '{T} : Ajoutez {C}{C}.', 'type': 'Créature-artefact : myr', 'flavor': 'Les myrs sont comme le Vide Rayonnant : une toile vierge sur laquelle on peut peindre de grandes créations.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486334&type=card', 'language': 'French', 'identifiers': {'scryfallId': '6af8e255-c1ab-42e4-ad98-ce3808675661', 'multiverseId': 486334}, 'multiverseid': 486334}, {'name': 'Myr di Palladio', 'text': '{T}: Aggiungi {C}{C}.', 'type': 'Creatura Artefatto — Myr', 'flavor': 'I myr sono come il Nulla Scintillante: tele bianche su cui dare vita a grandi creazioni.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486593&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'd5f35281-ef5b-4dfd-9085-4c5004feb4af', 'multiverseId': 486593}, 'multiverseid': 486593}, {'name': 'パラジウムのマイア', 'text': '{T}：{C}{C}を加える。', 'type': 'アーティファクト・クリーチャー — マイア', 'flavor': 'マイアは空僻地のようなものだ。それは素晴らしい創造を成すための真っ白なキャンバスなのだ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486852&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'bbed173d-02f9-4dfd-a821-91f69664fec9', 'multiverseId': 486852}, 'multiverseid': 486852}, {'name': '팔라듐 미르', 'text': '{T}: {C}{C}를 추가한다.', 'type': '마법물체 생물 — 미르', 'flavor': '미르는 위대한 창조물을 만들어낼 수 있는 빈 캔버스라는 점에서 빛나는 공허와 같다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487111&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'd3ca125c-0ecc-4f52-a8a0-cc08db51c3a9', 'multiverseId': 487111}, 'multiverseid': 487111}, {'name': 'Myr de Paládio', 'text': '{T}: Adicione {C}{C}.', 'type': 'Criatura Artefato — Myr', 'flavor': 'Os myres são como o Vácuo Tremeluzente: telas negras sobre as quais construir grandiosas criações.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487370&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a9080dab-b2f2-4c9d-be58-250a9d21bd16', 'multiverseId': 487370}, 'multiverseid': 487370}, {'name': 'Палладиевый Миэр', 'text': '{T}: добавьте {C}{C}.', 'type': 'Артефакт Существо — Миэр', 'flavor': 'Миэры напоминают Мерцающую Пустоту: чистый холст, на котором можно создать великое творение.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487629&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '9847492f-53a3-462a-8ae7-22b5ec173976', 'multiverseId': 487629}, 'multiverseid': 487629}, {'name': '钯秘耳', 'text': '{T}：加{C}{C}。', 'type': '神器生物 ～秘耳', 'flavor': '此秘耳一如烁光荒野：一片空白的画布，却将用来建构伟大的造物。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487888&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f8efe3c4-f5e4-4ad0-9e05-8c7b3d229149', 'multiverseId': 487888}, 'multiverseid': 487888}, {'name': '鈀秘耳', 'text': '{T}：加{C}{C}。', 'type': '神器生物 ～秘耳', 'flavor': '此秘耳一如爍光荒野：一片空白的畫布，卻將用來建構偉大的造物。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488147&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'a7db96e1-b289-4216-b099-10067fad5c58', 'multiverseId': 488147}, 'multiverseid': 488147}]", "[{'name': 'Passage merveilleux', 'text': '{T}, sacrifiez le Passage merveilleux : Cherchez dans votre bibliothèque une carte de terrain de base, mettez-la sur le champ de bataille engagée et mélangez ensuite votre bibliothèque. Puis, si vous contrôlez au moins quatre terrains, dégagez ce terrain.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488337&type=card', 'language': 'French', 'identifiers': {'scryfallId': '87ee8b75-6631-4796-9f1f-2a30f221daa3', 'multiverseId': 488337}, 'multiverseid': 488337}, {'name': '寓話の小道', 'text': '{T}, 寓話の小道を生け贄に捧げる：あなたのライブラリーから基本土地・カード１枚を探し、タップ状態で戦場に出し、その後あなたのライブラリーを切り直す。その後、あなたが土地を４つ以上コントロールしているなら、その土地をアンタップする。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488389&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'e5dd4219-a0ca-4542-97e2-84f2f134bddc', 'multiverseId': 488389}, 'multiverseid': 488389}]", '[{\'name\': \'Pestecroc cagoulard\', \'text\': "Contact mortel\\nÀ chaque fois qu\'une créature avec le contact mortel que vous contrôlez attaque, chaque adversaire perd 1 point de vie et vous gagnez 1 point de vie.\\nÀ chaque fois qu\'une créature avec le contact mortel que vous contrôlez inflige des blessures à un planeswalker, détruisez ce planeswalker.", \'type\': \'Créature : serpent\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488308&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e255ea28-9ebb-49dc-bafc-8765343ff506\', \'multiverseId\': 488308}, \'multiverseid\': 488308}, {\'name\': \'頭巾様の荒廃牙\', \'text\': \'接死\\nあなたがコントロールしていて接死を持つクリーチャーが１体攻撃するたび、各対戦相手はそれぞれ１点のライフを失い、あなたは１点のライフを得る。\\nあなたがコントロールしていて接死を持つクリーチャー１体がプレインズウォーカー１体にダメージを与えるたび、そのプレインズウォーカーを破壊する。\', \'type\': \'クリーチャー — 蛇\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488360&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'692841a9-642c-4e49-b3ec-80dc6d61c10f\', \'multiverseId\': 488360}, \'multiverseid\': 488360}]', '[{\'name\': \'Pilzige Wiedergeburt\', \'text\': \'Bringe eine bleibende Karte deiner Wahl aus deinem Friedhof auf deine Hand zurück. Falls in diesem Zug eine Kreatur gestorben ist, erzeuge zwei 1/1 grüne Saproling-Kreaturenspielsteine.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Letztendlich sind wir alle nur Nahrung für etwas anderes."\\n—Cevraya, Golgari-Schamane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485764&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6472ab96-7e1a-43a8-bc6b-4001e60a9db1\', \'multiverseId\': 485764}, \'multiverseid\': 485764}, {\'name\': \'Renacimiento fúngico\', \'text\': \'Regresa la carta de permanente objetivo de tu cementerio a tu mano. Si una criatura murió este turno, crea dos fichas de criatura Saprolín verdes 1/1.\', \'type\': \'Instantáneo\', \'flavor\': \'"Al final todos somos comida de algo".\\n—Cevraya, chamán golgari\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486023&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f0e26ccf-65ae-462e-9ee4-e05c1274bfd5\', \'multiverseId\': 486023}, \'multiverseid\': 486023}, {\'name\': \'Renaissance fongoïde\', \'text\': \'Renvoyez une carte de permanent ciblée depuis votre cimetière dans votre main. Si une créature est morte ce tour-ci, créez deux jetons de créature 1/1 verte Saprobionte.\', \'type\': \'Éphémère\', \'flavor\': \'« Tôt ou tard, nous servons tous de repas à quelque chose. »\\n—Cevraya, shamane de Golgari\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486282&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4d8605da-d353-40bf-9a94-3bff2bd43d25\', \'multiverseId\': 486282}, \'multiverseid\': 486282}, {\'name\': \'Rinascita Fungina\', \'text\': \'Riprendi in mano una carta permanente bersaglio dal tuo cimitero. Se è morta una creatura in questo turno, crea due pedine creatura Saprolingio 1/1 verdi.\', \'type\': \'Istantaneo\', \'flavor\': \'"Siamo tutti il cibo di qualcosa, in fin dei conti."\\n—Cevraya, sciamana Golgari\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486541&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'00b976e2-98de-47b5-8219-08644fbe27e4\', \'multiverseId\': 486541}, \'multiverseid\': 486541}, {\'name\': \'菌類の再誕\', \'text\': \'あなたの墓地からパーマネント・カード１枚を対象とし、それをあなたの手札に戻す。このターンにクリーチャーが死亡していたなら、緑の１/１の苗木・クリーチャー・トークンを２体生成する。\', \'type\': \'インスタント\', \'flavor\': \'「結局あたしたちはみな何かの餌なのさ。」\\n――ゴルガリのシャーマン、セヴリヤ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486800&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8f3b23d2-5479-45b2-a791-bb8bbbcd7b15\', \'multiverseId\': 486800}, \'multiverseid\': 486800}, {\'name\': \'진균 부활\', \'text\': \'당신의 무덤에 있는 지속물 카드를 목표로 정한다. 그 카드를 당신의 손으로 되돌린다. 이번 턴에 생물이 죽었다면, 1/1 녹색 묘목 생물 토큰 두 개를 만든다.\', \'type\': \'순간마법\', \'flavor\': \'"마지막엔 우리 모두 무언가를 위한 먹잇감일 뿐이야."\\n—골가리 주술사, 세브라야\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487059&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d65c9204-3fb3-4c12-83f9-caac33be6208\', \'multiverseId\': 487059}, \'multiverseid\': 487059}, {\'name\': \'Renascimento Fúngico\', \'text\': \'Devolva o card de permanente alvo de seu cemitério para sua mão. Se uma criatura morreu neste turno, crie duas fichas de criatura verde 1/1 do tipo Saprófita.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"No fim, todos viramos comida de alguma coisa."\\n— Cevraya, xamã Golgari\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487318&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1b8bc360-e434-4c72-8fd8-22784a2c9407\', \'multiverseId\': 487318}, \'multiverseid\': 487318}, {\'name\': \'Грибное Перерождение\', \'text\': \'Верните целевую карту перманента из вашего кладбища в вашу руку. Если в этом ходу умерло существо, создайте две фишки существа 1/1 зеленый Сапролинг.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«В конце концов каждый из нас становится для кого-то едой».\\n— Севрайя, шаманка Голгари\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487577&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'01fcb38f-d001-4129-8fd2-3219d95e7393\', \'multiverseId\': 487577}, \'multiverseid\': 487577}, {\'name\': \'真菌再生\', \'text\': \'将目标永久物牌从你的坟墓场移回你手上。如果本回合中有生物死去，则派出两个1/1绿色腐生物衍生生物。\', \'type\': \'瞬间\', \'flavor\': \'「我们终究会成为某些东西的养料。」\\n～葛加理祭师习拉雅\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487836&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'105f2001-b072-4a10-b3f5-f18695ff5d5f\', \'multiverseId\': 487836}, \'multiverseid\': 487836}, {\'name\': \'真菌再生\', \'text\': \'將目標永久物牌從你的墳墓場移回你手上。如果本回合中有生物死去，則派出兩個1/1綠色腐生物衍生生物。\', \'type\': \'瞬間\', \'flavor\': \'「我們終究會成為某些東西的養料。」\\n～葛加理祭師習拉雅\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488095&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fb608a63-0103-42e8-a9de-82c6ee4703bd\', \'multiverseId\': 488095}, \'multiverseid\': 488095}]', '[{\'name\': \'Planétaire mécanique chromatique\', \'text\': "Vous pouvez dépenser du mana comme si c\'était du mana de n\'importe quelle couleur.\\n{T} : Ajoutez {C}{C}{C}{C}{C}.\\n{5}, {T} : Piochez une carte pour chaque couleur parmi les permanents que vous contrôlez.", \'type\': \'Artefact légendaire\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488333&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f70363a2-b3a1-4783-a04b-bad3c59a4eef\', \'multiverseId\': 488333}, \'multiverseid\': 488333}, {\'name\': \'彩色の宇宙儀\', \'text\': \'あなたはマナを望む色のマナであるかのように支払ってもよい。\\n{T}：{C}{C}{C}{C}{C}を加える。\\n{5}, {T}：あなたがコントロールしているパーマネントの中の色１色につきカードを１枚引く。\', \'type\': \'伝説のアーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488385&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7bfe9a28-962e-4363-a7e1-3cf2c28e4143\', \'multiverseId\': 488385}, \'multiverseid\': 488385}]', '[{\'name\': \'Prediger der Himmel\', \'text\': \'Wachsamkeit, Lebensverknüpfung\\n{T}: Erzeuge einen 4/4 weißen Engel-Kreaturenspielstein mit Flugfähigkeit. Aktiviere diese Fähigkeit nur, falls du mindestens 7 Lebenspunkte mehr als deine Startlebenspunktezahl hast, und nur zu einem Zeitpunkt, zu dem du auch eine Hexerei wirken könntest.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': \'„Alle sind im Licht der Engel willkommen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485620&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f8b389fb-a6d1-49eb-991f-e96f0fe4830b\', \'multiverseId\': 485620}, \'multiverseid\': 485620}, {\'name\': \'Orador de los cielos\', \'text\': \'Vigilancia, vínculo vital.\\n{T}: Crea una ficha de criatura Ángel blanca 4/4 con la habilidad de volar. Activa esta habilidad solo si tienes al menos 7 vidas más que tu total de vidas inicial y solo cuando puedas lanzar un conjuro.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': \'"Todos son bienvenidos a la luz de los ángeles".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485879&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'90f6ba47-a2ec-4461-885e-b27e8847c32d\', \'multiverseId\': 485879}, \'multiverseid\': 485879}, {\'name\': \'Orateur des Cieux\', \'text\': "Vigilance, lien de vie\\n{T} : Créez un jeton de créature 4/4 blanche Ange avec le vol. N\'activez cette capacité que si vous avez au moins 7 points de vie de plus que votre total de points de vie de départ et uniquement lorsque vous pourriez lancer un rituel.", \'type\': \'Créature : humain et clerc\', \'flavor\': "« La lumière de l\'ange accueille tout le monde à bras ouverts. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486138&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7634f5e7-1a58-4cd2-b4d7-1780e2f0907c\', \'multiverseId\': 486138}, \'multiverseid\': 486138}, {\'name\': \'Oratore dei Cieli\', \'text\': \'Cautela, legame vitale\\n{T}: Crea una pedina creatura Angelo 4/4 bianca con volare. Attiva questa abilità solo se hai almeno 7 punti vita in più rispetto ai tuoi punti vita iniziali e solo quando potresti lanciare una stregoneria.\', \'type\': \'Creatura — Chierico Umano\', \'flavor\': \'"La luce degli angeli accoglie chiunque."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486397&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'542a6410-83fd-46b0-a67e-f5570f85d3ec\', \'multiverseId\': 486397}, \'multiverseid\': 486397}, {\'name\': \'天界の語り部\', \'text\': \'警戒、絆魂\\n{T}：飛行を持つ白の４/４の天使・クリーチャー・トークンを１体生成する。この能力は、あなたのライフが、あなたの初期ライフ総量よりも７点以上多く、かつ、あなたがソーサリーを唱えられるときにのみ起動できる。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': \'「天使の光の御許では、誰もが歓迎される。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486656&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'95a6fd7c-e288-498f-b563-0b2ce5debfd9\', \'multiverseId\': 486656}, \'multiverseid\': 486656}, {\'name\': \'천국의 대변인\', \'text\': \'경계, 생명연결\\n{T}: 비행을 가진 4/4 백색 천사 생물 토큰 한 개를 만든다. 당신의 생명점이 게임을 시작할 때의 생명점보다 최소 7점 이상 높고 당신이 집중마법을 발동할 수 있는 시기에만 이 능력을 활성화할 수 있다.\', \'type\': \'생물 — 인간 성직자\', \'flavor\': \'"천사들의 빛은 모두를 환영합니다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486915&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5a557da5-f07d-45b2-a2dd-91834e62429d\', \'multiverseId\': 486915}, \'multiverseid\': 486915}, {\'name\': \'Porta-voz dos Céus\', \'text\': \'Vigilância, vínculo com a vida\\n{T}: Crie uma ficha de criatura branca 4/4 do tipo Anjo com voar. Ative esta habilidade somente se você tiver ao menos 7 pontos de vida a mais que seu total inicial e somente quando puder conjurar um feitiço.\', \'type\': \'Criatura — Humano Clérigo\', \'flavor\': \'"Todos são bem-vindos na luz dos anjos."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487174&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'564de865-08e4-411e-978d-49bb7b4e8381\', \'multiverseId\': 487174}, \'multiverseid\': 487174}, {\'name\': \'Вестник Небес\', \'text\': \'Бдительность, Цепь жизни\\n{T}: создайте одну фишку существа 4/4 белый Ангел с Полетом. Активируйте эту способность, только если количество ваших жизней превышает ваше начальное количество жизней как минимум на 7, и только при возможности разыгрывать волшебство.\', \'type\': \'Существо — Человек Священник\', \'flavor\': \'«Свет ангелов примет каждого».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487433&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fc96ba1f-218c-41ce-87ca-b53e76d9a4fb\', \'multiverseId\': 487433}, \'multiverseid\': 487433}, {\'name\': \'天界传谕\', \'text\': \'警戒，系命\\n{T}：派出一个4/4白色，具飞行异能的天使衍生生物。只能于你的总生命比你的起始总生命至少多7点时起动此异能，且只有于你能施放法术的时机下才能起动。\', \'type\': \'生物 ～人类／僧侣\', \'flavor\': \'「天使之光普渡众生。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487692&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e739fb8c-c0be-4ae1-a6f4-e2ea4c2c7510\', \'multiverseId\': 487692}, \'multiverseid\': 487692}, {\'name\': \'天界傳諭\', \'text\': \'警戒，繫命\\n{T}：派出一個4/4白色，具飛行異能的天使衍生生物。只能於你的總生命比你的起始總生命至少多7點時起動此異能，且只有於你能施放巫術的時機下才能起動。\', \'type\': \'生物 ～人類／僧侶\', \'flavor\': \'「天使之光普渡眾生。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487951&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bde53b35-b9e3-47c7-aa69-718886cf2bd6\', \'multiverseId\': 487951}, \'multiverseid\': 487951}]', "[{'name': 'Prismit', 'text': '{2}: Erzeuge ein Mana einer beliebigen Farbe.', 'type': 'Artefaktkreatur — Golem', 'flavor': 'Selbst sein Schatten schillert wie ein Regenbogen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485817&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c955ce8f-85c2-421a-9ee8-a6e054f4e73f', 'multiverseId': 485817}, 'multiverseid': 485817}, {'name': 'Prísmico', 'text': '{2}: Agrega un maná de cualquier color.', 'type': 'Criatura artefacto — Gólem', 'flavor': 'Incluso su sombra es un arcoíris resplandeciente.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486076&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '947b4189-e973-4b8c-82ca-117e4702ba29', 'multiverseId': 486076}, 'multiverseid': 486076}, {'name': 'Prismite', 'text': '{2} : Ajoutez un mana de la couleur de votre choix.', 'type': 'Créature-artefact : golem', 'flavor': 'Même son ombre est un arc-en-ciel éblouissant.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486335&type=card', 'language': 'French', 'identifiers': {'scryfallId': '4ee4ab6e-3953-40a9-890b-7afe2ef68aec', 'multiverseId': 486335}, 'multiverseid': 486335}, {'name': 'Prismobita', 'text': '{2}: Aggiungi un mana di un qualsiasi colore.', 'type': 'Creatura Artefatto — Golem', 'flavor': 'Perfino la sua ombra è un arcobaleno sfolgorante.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486594&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c096ece8-6f3f-4c6f-98e3-40ce06911097', 'multiverseId': 486594}, 'multiverseid': 486594}, {'name': 'プリズマイト', 'text': '{2}：好きな色１色のマナ１点を加える。', 'type': 'アーティファクト・クリーチャー — ゴーレム', 'flavor': '影ですらまばゆい虹色である。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486853&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '550d9ee2-ce29-444b-88d9-95ee1aa1d3d5', 'multiverseId': 486853}, 'multiverseid': 486853}, {'name': '프리즈마이트', 'text': '{2}: 원하는 색의 마나 한 개를 추가한다.', 'type': '마법물체 생물 — 골렘', 'flavor': '그림자마저도 눈부신 무지개이다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487112&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '71a9e67b-6d14-44fe-886c-fb0a2a9092d7', 'multiverseId': 487112}, 'multiverseid': 487112}, {'name': 'Prismita', 'text': '{2}: Adicione um mana de qualquer cor.', 'type': 'Criatura Artefato — Golem', 'flavor': 'Até a sombra dele é um arco-íris estonteante.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487371&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd300ac75-2f70-4af1-94ec-d027df0a111e', 'multiverseId': 487371}, 'multiverseid': 487371}, {'name': 'Призмит', 'text': '{2}: добавьте одну ману любого цвета.', 'type': 'Артефакт Существо — Голем', 'flavor': 'Даже его тень — ослепительно-яркая радуга.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487630&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '8db0462a-8585-4098-87a3-9d3c835a750c', 'multiverseId': 487630}, 'multiverseid': 487630}, {'name': '虹彩魔像', 'text': '{2}：加一点任意颜色的法术力。', 'type': '神器生物 ～魔像', 'flavor': '它连影子都是绚丽霓虹。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487889&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '5880315d-d530-46a7-a329-3bc4296facec', 'multiverseId': 487889}, 'multiverseid': 487889}, {'name': '虹彩魔像', 'text': '{2}：加一點任意顏色的魔法力。', 'type': '神器生物 ～魔像', 'flavor': '它連影子都是絢麗霓虹。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488148&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '7dcf35f0-067b-4764-b2a4-f8d35997f416', 'multiverseId': 488148}, 'multiverseid': 488148}]", '[{\'name\': \'Prompte Antwort\', \'text\': \'Zerstöre eine getappte Kreatur deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Es gibt nichts Befriedigenderes, als einen guten Tritt ins Gesicht zu landen."\\n—Adrasteia, akroischer Hauptmann\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485622&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8faa3c71-b333-45a8-b466-9c0f4a2da397\', \'multiverseId\': 485622}, \'multiverseid\': 485622}, {\'name\': \'Respuesta rauda\', \'text\': \'Destruye la criatura objetivo girada.\', \'type\': \'Instantáneo\', \'flavor\': \'"No hay nada que satisfaga más que una buena patada en la cara".\\n—Adrasteia, capitana akroniense\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485881&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'203f9166-ebea-41fe-aa8b-c639ebc94fd6\', \'multiverseId\': 485881}, \'multiverseid\': 485881}, {\'name\': \'Réponse expéditive\', \'text\': \'Détruisez la créature engagée ciblée.\', \'type\': \'Éphémère\', \'flavor\': "« Rien ne me satisfait autant que de mettre un bon coup de pied dans la tête de quelqu\'un. »\\n—Adrastéïa, capitaine akroen", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486140&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dc421e68-f376-4e29-a2d9-5058ad36a9db\', \'multiverseId\': 486140}, \'multiverseid\': 486140}, {\'name\': \'Reazione Repentina\', \'text\': \'Distruggi una creatura TAPpata bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Non c\\\'è niente di più appagante che stampare un bel calcio in faccia a qualcuno."\\n—Adrasteia, capitana di Akros\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486399&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'14e9ad4c-1f5d-4e15-85ed-1dc515404456\', \'multiverseId\': 486399}, \'multiverseid\': 486399}, {\'name\': \'素早い反応\', \'text\': \'タップ状態のクリーチャー１体を対象とし、それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'「顔に渾身の蹴りを入れるほど痛快なことはないな。」\\n――アクロスの隊長、アドラステア\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486658&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4623f291-d26c-473b-9a5c-4b2957079ad4\', \'multiverseId\': 486658}, \'multiverseid\': 486658}, {\'name\': \'재빠른 반응\', \'text\': \'탭된 생물을 목표로 정한다. 그 생물을 파괴한다.\', \'type\': \'순간마법\', \'flavor\': \'"얼굴에 정확하게 발길질을 하는 것만큼 만족스러운 일은 거의 없다고."\\n—아크로스 대장, 아드라스티아\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486917&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d4d9cf32-a2b6-4e8c-b97a-337956561d77\', \'multiverseId\': 486917}, \'multiverseid\': 486917}, {\'name\': \'Resposta Rápida\', \'text\': \'Destrua a criatura alvo virada.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Não há nada que dê a mesma satisfação que acertar um bom chute na cara."\\n— Adrasteia, capitã acrosana\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487176&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c6e65a9f-1c07-41bf-8972-c96a6a5e4fb3\', \'multiverseId\': 487176}, \'multiverseid\': 487176}, {\'name\': \'Стремительный Ответ\', \'text\': \'Уничтожьте целевое повернутое существо.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Нет ничего приятнее, чем хорошенько врезать ногой кому-нибудь по роже».\\n— Адрастея, акросский капитан\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487435&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'abeae264-3750-4b7d-8617-7746bd8ac99d\', \'multiverseId\': 487435}, \'multiverseid\': 487435}, {\'name\': \'快速反应\', \'text\': \'消灭目标已横置的生物。\', \'type\': \'瞬间\', \'flavor\': \'「没有什么事情比往敌人脸上狠狠踹一脚更解气的了。」\\n～阿喀洛斯队长阿卓斯蒂娅\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487694&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5d455ca1-d021-4928-abfb-2c01bed4a1ef\', \'multiverseId\': 487694}, \'multiverseid\': 487694}, {\'name\': \'快速反應\', \'text\': \'消滅目標已橫置的生物。\', \'type\': \'瞬間\', \'flavor\': \'「沒有什麼事情比往敵人臉上狠狠踹一腳更解氣的了。」\\n～阿喀洛斯隊長阿卓斯蒂婭\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487953&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'813ae951-989d-4a26-8f66-6ea3e4504b20\', \'multiverseId\': 487953}, \'multiverseid\': 487953}]', '[{\'name\': \'Puissance primordiale\', \'text\': "Une créature ciblée que vous contrôlez gagne +X/+X jusqu\'à la fin du tour. Ensuite, elle se bat contre jusqu\'à une créature ciblée que vous ne contrôlez pas.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488328&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'09b30eb6-35eb-4c74-bc06-8e6601474d55\', \'multiverseId\': 488328}, \'multiverseid\': 488328}, {\'name\': \'原初の力\', \'text\': \'あなたがコントロールしているクリーチャー１体とあなたがコントロールしていないクリーチャー最大１体を対象とする。ターン終了時まで、その前者は＋Ｘ/＋Ｘの修整を受ける。その後、その前者はその後者と格闘を行う。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488380&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9a244707-f065-4cd6-9da1-1c69766df993\', \'multiverseId\': 488380}, \'multiverseid\': 488380}]', '[{\'name\': \'Quiriondryade\', \'text\': \'Immer wenn du einen Zauberspruch wirkst, der weiß, blau, schwarz oder rot ist, lege eine +1/+1-Marke auf die Quiriondryade.\', \'type\': \'Kreatur — Dryade\', \'flavor\': \'„Unterschätze nie die Fähigkeit von Naturmächten, sich unnatürlichen Einflüssen anzupassen."\\n—Molimo, Maro-Hexer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485780&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'55f61c5e-a23c-4656-bcf9-f77958fd684d\', \'multiverseId\': 485780}, \'multiverseid\': 485780}, {\'name\': \'Dríada Quirion\', \'text\': \'Siempre que lances un hechizo blanco, azul, negro o rojo, pon un contador +1/+1 sobre la Dríada Quirion.\', \'type\': \'Criatura — Dríada\', \'flavor\': \'"Nunca subestimes la habilidad de las fuerzas naturales para adaptarse a influencias antinaturales".\\n—Molimo, hechicero maro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486039&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7142df39-9c9c-4821-8f73-06b5dc3f8fc3\', \'multiverseId\': 486039}, \'multiverseid\': 486039}, {\'name\': \'Dryade quirionaise\', \'text\': \'À chaque fois que vous lancez un sort qui est blanc, bleu, noir ou rouge, mettez un marqueur +1/+1 sur la Dryade quirionaise.\', \'type\': \'Créature : dryade\', \'flavor\': "« Ne sous-estimez jamais la nature. Elle sait s\'adapter au surnaturel. »\\n—Molimo, maro-sorcier", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486298&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ed866359-dcc6-4faa-b179-b3a42f28c795\', \'multiverseId\': 486298}, \'multiverseid\': 486298}, {\'name\': \'Driade Quirion\', \'text\': \'Ogniqualvolta lanci una magia bianca, blu, nera o rossa, metti un segnalino +1/+1 sulla Driade Quirion.\', \'type\': \'Creatura — Driade\', \'flavor\': \'"Mai sottovalutare la capacità delle forze naturali di adattarsi alle influenze artificiali."\\n—Molimo, stregone maro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486557&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e5ec651a-9367-4bdd-8e60-e8b1c5034dea\', \'multiverseId\': 486557}, \'multiverseid\': 486557}, {\'name\': \'クウィリーオンのドライアド\', \'text\': \'あなたが白や青や黒や赤である呪文を唱えるたび、クウィリーオンのドライアドの上に＋１/＋１カウンターを１個置く。\', \'type\': \'クリーチャー — ドライアド\', \'flavor\': \'「自然外の影響に順応した自然の力を侮るべからず。」\\n――マローの魔術師モリモ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486816&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'43cdfd90-88a2-488a-b359-99cb68d7a840\', \'multiverseId\': 486816}, \'multiverseid\': 486816}, {\'name\': \'퀴리온 드라이어드\', \'text\': \'당신이 백색, 청색, 흑색 또는 적색인 주문을 발동할 때마다, 퀴리온 드라이어드에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 드라이어드\', \'flavor\': \'"섭리에 맞지 않는 변화에도 적응하는 자연의 힘을 과소평가하지 말도록."\\n—마로 마법사, 몰리모\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487075&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7e8ec253-7c06-4c14-867d-d388bbc8e410\', \'multiverseId\': 487075}, \'multiverseid\': 487075}, {\'name\': \'Dríade Quirion\', \'text\': \'Toda vez que você conjurar uma mágica branca, azul, preta ou vermelha, coloque um marcador +1/+1 em Dríade Quirion.\', \'type\': \'Criatura — Dríade\', \'flavor\': \'"Nunca subestime a habilidade das forças naturais de se adaptarem a influências sobrenaturais."\\n— Molimo, feiticeiro maro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487334&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e9479a68-d2da-446e-9032-e18b37d9dfec\', \'multiverseId\': 487334}, \'multiverseid\': 487334}, {\'name\': \'Квирионская Дриада\', \'text\': \'Каждый раз, когда вы разыгрываете белое, синее, черное или красное заклинание, положите один жетон +1/+1 на Квирионскую Дриаду.\', \'type\': \'Существо — Дриада\', \'flavor\': \'«Не стоит недооценивать способность естественных сил приспосабливаться к неестественным воздействиям».\\n— Молимо, маро-волшебник\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487593&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cd208616-5d1b-49da-899f-4f351f4dcab9\', \'multiverseId\': 487593}, \'multiverseid\': 487593}, {\'name\': \'奎利恩树灵\', \'text\': \'每当你施放含白色、蓝色、黑色或红色的咒语时，在奎利恩树灵上放置一个+1/+1指示物。\', \'type\': \'生物 ～树灵\', \'flavor\': \'「别低估大自然对人为影响的适应能力。」\\n～玛洛术士莫黎墨\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487852&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'12e1a30a-d4ef-4a4b-950d-5b4aa0dbca53\', \'multiverseId\': 487852}, \'multiverseid\': 487852}, {\'name\': \'奎利恩樹靈\', \'text\': \'每當你施放含白色、藍色、黑色或紅色的咒語時，在奎利恩樹靈上放置一個+1/+1指示物。\', \'type\': \'生物 ～樹靈\', \'flavor\': \'「別低估大自然對人為影響的適應能力。」\\n～瑪洛術士莫黎墨\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488111&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d6184df1-d761-4fd6-ba48-3ca93c1b5c6a\', \'multiverseId\': 488111}, \'multiverseid\': 488111}]', '[{\'name\': \'Radha, Herz von Keld\', \'text\': \'Solange es dein Zug ist, hat Radha, Herz von Keld, Erstschlag.\\nDu kannst dir zu jedem Zeitpunkt die oberste Karte deiner Bibliothek anschauen und du kannst Länderkarten oben von deiner Bibliothek spielen.\\n{4}{R}{G}: Radha erhält bis zum Ende des Zuges +X/+X, wobei X gleich der Anzahl an Ländern ist, die du kontrollierst.\', \'type\': \'Legendäre Kreatur — Elf, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485806&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f4d1a414-bbe7-459d-af05-4b2496afd9b1\', \'multiverseId\': 485806}, \'multiverseid\': 485806}, {\'name\': \'Radha, Corazón de Keld\', \'text\': \'Mientras sea tu turno, Radha, Corazón de Keld tiene la habilidad de dañar primero.\\nPuedes mirar la primera carta de tu biblioteca en cualquier momento y puedes jugar tierras desde la parte superior de tu biblioteca.\\n{4}{R}{G}: Radha obtiene +X/+X hasta el final del turno, donde X es la cantidad de tierras que controlas.\', \'type\': \'Criatura legendaria — Guerrero elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486065&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e8d3e9c3-6287-4631-afab-edb552d9b463\', \'multiverseId\': 486065}, \'multiverseid\': 486065}, {\'name\': \'Radha, cœur de Keld\', \'text\': "Tant que c\'est votre tour, Radha, cœur de Keld a l\'initiative.\\nVous pouvez regarder la carte du dessus de votre bibliothèque à tout moment, et vous pouvez jouer des terrains depuis le dessus de votre bibliothèque.\\n{4}{R}{G} : Radha gagne +X/+X jusqu\'à la fin du tour, X étant le nombre de terrains que vous contrôlez.", \'type\': \'Créature légendaire : elfe et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486324&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'87fec2e1-bedc-449b-b8ff-c26e1b8b57d0\', \'multiverseId\': 486324}, \'multiverseid\': 486324}, {\'name\': \'Radha, Cuore di Keld\', \'text\': \'Fintanto che è il tuo turno, Radha, Cuore di Keld ha attacco improvviso.\\nPuoi guardare la prima carta del tuo grimorio in qualsiasi momento e puoi giocare terre dalla cima del tuo grimorio.\\n{4}{R}{G}: Radha prende +X/+X fino alla fine del turno, dove X è il numero di terre che controlli.\', \'type\': \'Creatura Leggendaria — Guerriero Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486583&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2c48ca12-a4b8-45bf-bd46-4eccbf75c098\', \'multiverseId\': 486583}, \'multiverseid\': 486583}, {\'name\': \'ケルドの心胆、ラーダ\', \'text\': \'あなたのターンであるかぎり、ケルドの心胆、ラーダは先制攻撃を持つ。\\nあなたはいつでもあなたのライブラリーの一番上のカードを見てもよく、あなたはあなたのライブラリーの一番上から土地をプレイしてもよい。\\n{4}{R}{G}：ターン終了時まで、ケルドの心胆、ラーダは＋Ｘ/＋Ｘの修整を受ける。Ｘはあなたがコントロールしている土地の総数に等しい。\', \'type\': \'伝説のクリーチャー — エルフ・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486842&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'61d3f12b-5308-4841-a5d2-dbad8fdf6883\', \'multiverseId\': 486842}, \'multiverseid\': 486842}, {\'name\': \'켈드의 심장, 라다\', \'text\': \'당신의 턴인 한, 켈드의 심장, 라다는 선제공격을 가진다.\\n당신은 언제든지 당신의 서고 맨 위 카드를 볼 수 있으며, 당신의 서고 맨 위에서 대지를 플레이할 수 있다.\\n{4}{R}{G}: 라다는 턴종료까지 +X/+X를 얻는다. X는 당신이 조종하는 대지의 수이다.\', \'type\': \'전설적 생물 — 엘프 전사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487101&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'347d42d3-0d83-488d-9834-f6bfaa9a07f5\', \'multiverseId\': 487101}, \'multiverseid\': 487101}, {\'name\': \'Radha, Coração de Keld\', \'text\': \'Enquanto for seu turno, Radha, Coração de Keld, terá iniciativa.\\nVocê pode olhar o card do topo de seu grimório a qualquer momento, e pode jogar terrenos do topo de seu grimório.\\n{4}{R}{G}: Radha recebe +X/+X até o final do turno, sendo X o número de terrenos que você controla.\', \'type\': \'Criatura Lendária — Elfo Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487360&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8209adea-8fb7-454e-acd7-16a24d897a12\', \'multiverseId\': 487360}, \'multiverseid\': 487360}, {\'name\': \'Радха, Сердце Келда\', \'text\': \'Пока длится ваш ход, Радха, Сердце Келда имеет Первый удар.\\nВы в любой момент можете посмотреть верхнюю карту вашей библиотеки и вы можете разыгрывать земли с верха вашей библиотеки.\\n{4}{R}{G}: Радха получает +X/+X до конца хода, где X — количество земель под вашим контролем.\', \'type\': \'Легендарное Существо — Эльф Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487619&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2553901a-e164-4572-b8cc-f9958689b749\', \'multiverseId\': 487619}, \'multiverseid\': 487619}, {\'name\': \'凯尔顿之心拉妲\', \'text\': \'只要是在你的回合中，凯尔顿之心拉妲便具有先攻异能。\\n你可以随时检视你的牌库顶牌，且你可以从你的牌库顶使用地。\\n{4}{R}{G}：拉妲得+X/+X直到回合结束，X为由你操控的地数量。\', \'type\': \'传奇生物 ～妖精／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487878&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'54621bf0-c9c5-4256-9be1-f4899c710a2a\', \'multiverseId\': 487878}, \'multiverseid\': 487878}, {\'name\': \'凱爾頓之心拉妲\', \'text\': \'只要是在你的回合中，凱爾頓之心拉妲便具有先攻異能。\\n你可以隨時檢視你的牌庫頂牌，且你可以從你的牌庫頂使用地。\\n{4}{R}{G}：拉妲得+X/+X直到回合結束，X為由你操控的地數量。\', \'type\': \'傳奇生物 ～妖精／戰士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488137&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f49b821a-e056-4aaa-9519-35f2e9f0190d\', \'multiverseId\': 488137}, \'multiverseid\': 488137}]', '[{\'name\': \'Radha, cœur de Keld\', \'text\': "Tant que c\'est votre tour, Radha, cœur de Keld a l\'initiative.\\nVous pouvez regarder la carte du dessus de votre bibliothèque à tout moment, et vous pouvez jouer des terrains depuis le dessus de votre bibliothèque.\\n{4}{R}{G} : Radha gagne +X/+X jusqu\'à la fin du tour, X étant le nombre de terrains que vous contrôlez.", \'type\': \'Créature légendaire : elfe et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488331&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'08e28885-b2db-4f77-9049-519e6999b8e5\', \'multiverseId\': 488331}, \'multiverseid\': 488331}, {\'name\': \'ケルドの心胆、ラーダ\', \'text\': \'あなたのターンであるかぎり、ケルドの心胆、ラーダは先制攻撃を持つ。\\nあなたはいつでもあなたのライブラリーの一番上のカードを見てもよく、あなたはあなたのライブラリーの一番上から土地をプレイしてもよい。\\n{4}{R}{G}：ターン終了時まで、ケルドの心胆、ラーダは＋Ｘ/＋Ｘの修整を受ける。Ｘはあなたがコントロールしている土地の総数に等しい。\', \'type\': \'伝説のクリーチャー — エルフ・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488383&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b2e32392-201d-4d3a-8fd4-45fed46f53ff\', \'multiverseId\': 488383}, \'multiverseid\': 488383}]', "[{'name': 'Raserei der Gebissenen', 'text': 'Verzaubert eine Kreatur\\nDie verzauberte Kreatur erhält +2/+2 und greift in jedem Kampf an, falls möglich.', 'type': 'Verzauberung — Aura', 'flavor': 'Diejenigen, die glauben, von Lykanthropie befallen zu sein, können genauso gefährlich sein wie die, die es sind.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485727&type=card', 'language': 'German', 'identifiers': {'scryfallId': '85ad2f59-5fc1-478a-bc74-9bcdf30c5d60', 'multiverseId': 485727}, 'multiverseid': 485727}, {'name': 'Furor de los mordidos', 'text': 'Encantar criatura.\\nLa criatura encantada obtiene +2/+2 y ataca cada combate si puede.', 'type': 'Encantamiento — Aura', 'flavor': 'Aquellos que se creen infectados con licantropía pueden ser tan peligrosos como los que realmente lo están.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485986&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '6c188df9-12ef-47aa-9986-c58949183261', 'multiverseId': 485986}, 'multiverseid': 485986}, {'name': 'Emportement des mordus', 'text': 'Enchanter : créature\\nLa créature enchantée gagne +2/+2 et attaque à chaque combat si possible.', 'type': 'Enchantement : aura', 'flavor': 'Ceux qui se croient infectés par la lycanthropie peuvent être aussi dangereux que ceux qui le sont vraiment.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486245&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'aadf7723-f8f5-4752-87db-62cd3e6887b0', 'multiverseId': 486245}, 'multiverseid': 486245}, {'name': 'Ira di Chi È Morso', 'text': 'Incanta creatura\\nLa creatura incantata prende +2/+2 e attacca in ogni combattimento, se può farlo.', 'type': 'Incantesimo — Aura', 'flavor': 'Quelli che credono solo di essere infettati dalla licantropia possono essere pericolosi quanto quelli che lo sono veramente.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486504&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'bc86d744-dbc1-4a85-b831-16b5e4f28a4c', 'multiverseId': 486504}, 'multiverseid': 486504}, {'name': '噛み傷への興奮', 'text': 'エンチャント（クリーチャー）\\nエンチャントしているクリーチャーは＋２/＋２の修整を受け、各戦闘で、可能なら攻撃する。', 'type': 'エンチャント — オーラ', 'flavor': '獣人の病に侵されたと信じているだけの輩は、本当に侵されている者と同じぐらいに危険だ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486763&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'db442440-ecc5-4cd5-85f0-765a1650c0cc', 'multiverseId': 486763}, 'multiverseid': 486763}, {'name': '물린 자의 격분', 'text': '생물에게 부여\\n부여된 생물은 +2/+2를 받고 가능하면 매 전투마다 공격한다.', 'type': '부여마법 — 마법진', 'flavor': '스스로 늑대인간에게 물렸다고 믿는 자들은 진짜 늑대인간만큼 위험할 수 있다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487022&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '23c7d9ef-e96c-470e-b76d-d0a216ecbb77', 'multiverseId': 487022}, 'multiverseid': 487022}, {'name': 'Furor dos Mordidos', 'text': 'Encantar criatura\\nA criatura encantada recebe +2/+2 e ataca a cada combate se estiver apta.', 'type': 'Encantamento — Aura', 'flavor': 'Aqueles que creem estar infectados por licantropia podem ser tão perigosos quanto aqueles realmente infectados.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487281&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b5a7d373-5188-469c-ad7f-4d7187589839', 'multiverseId': 487281}, 'multiverseid': 487281}, {'name': 'Исступление Укушенного', 'text': 'Зачаровать существо\\nЗачарованное существо получает +2/+2 и атакует в каждом бою, если может.', 'type': 'Чары — Аура', 'flavor': 'Тот, кто лишь считает себя зараженным ликантропией, может быть не менее опасен, чем тот, кто действительно получил эту болезнь.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487540&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '54335326-b107-493f-90f4-a5da488ce570', 'multiverseId': 487540}, 'multiverseid': 487540}, {'name': '遭咬者狂热', 'text': '结附于生物\\n所结附的生物得+2/+2，且每次战斗若能攻击，则必须攻击。', 'type': '结界 ～灵气', 'flavor': '那些一厢情愿认为自己染上化狼症的人，可能会与真正的患者一样危险。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487799&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'aa4e8e1c-005c-4fc4-b01a-a74bcf848ca5', 'multiverseId': 487799}, 'multiverseid': 487799}, {'name': '遭咬者狂熱', 'text': '結附於生物\\n所結附的生物得+2/+2，且每次戰鬥若能攻擊，則必須攻擊。', 'type': '結界 ～靈氣', 'flavor': '那些一廂情願認為自己染上化狼症的人，可能會與真正的患者一樣危險。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488058&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'ccd3bdc9-98cf-4de6-be89-3a85b6453222', 'multiverseId': 488058}, 'multiverseid': 488058}]", '[{\'name\': \'Raubtierhafter Wurm\', \'text\': \'Wachsamkeit (Diese Kreatur wird beim Angreifen nicht getappt.)\\nDer Raubtierhafte Wurm erhält +2/+2, solange du einen Garruk-Planeswalker kontrollierst.\', \'type\': \'Kreatur — Wurm\', \'flavor\': \'„Die Starken fressen. Die Schwachen werden gefressen. Das ist der Lauf der Dinge."\\n—Garruk Wildsprecher\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488664&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7b4cd7a2-f837-4028-8377-c541304c80f6\', \'multiverseId\': 488664}, \'multiverseid\': 488664}, {\'name\': \'Sierpe depredadora\', \'text\': \'Vigilancia. (Esta criatura no se gira al atacar.)\\nLa Sierpe depredadora obtiene +2/+2 mientras controles un planeswalker Garruk.\', \'type\': \'Criatura — Sierpe\', \'flavor\': \'"Los fuertes comen. A los débiles se los comen. Así es como funciona".\\n—Garruk Portavoz Salvaje\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488684&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'42511dd5-3b69-404f-a80f-f7164926172e\', \'multiverseId\': 488684}, \'multiverseid\': 488684}, {\'name\': \'Guivre prédatrice\', \'text\': "Vigilance (Attaquer avec cette créature ne la fait pas s\'engager.)\\nLa Guivre prédatrice gagne +2/+2 tant que vous contrôlez un planeswalker Garruk.", \'type\': \'Créature : guivre\', \'flavor\': \'« Les forts mangent. Les faibles sont mangés. Ainsi vont les choses. »\\n—Garruk Languebestion\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488704&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'260c5608-cb81-4ed7-b97c-8125adedbe72\', \'multiverseId\': 488704}, \'multiverseid\': 488704}, {\'name\': \'Wurm Predatore\', \'text\': \'Cautela (Questa creatura attacca senza TAPpare.)\\nIl Wurm Predatore prende +2/+2 fintanto che controlli un planeswalker Garruk.\', \'type\': \'Creatura — Wurm\', \'flavor\': \'"I forti divorano. I deboli sono divorati. È così che funziona."\\n—Garruk Lingua Selvaggia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488724&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4d793df3-6bc0-4597-8f15-38fef150fb34\', \'multiverseId\': 488724}, \'multiverseid\': 488724}, {\'name\': \'捕食のワーム\', \'text\': \'警戒（このクリーチャーは攻撃してもタップしない。）\\nあなたがガラク・プレインズウォーカーをコントロールしているかぎり、捕食のワームは＋２/＋２の修整を受ける。\', \'type\': \'クリーチャー — ワーム\', \'flavor\': \'「強者が食う。弱者は食われる。そういうものだ。」\\n――野生語りのガラク\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488744&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3b37a706-a8e8-48c9-bbeb-9a004bfafeea\', \'multiverseId\': 488744}, \'multiverseid\': 488744}, {\'name\': \'포식성 웜\', \'text\': \'경계 (이 생물은 공격하면서 탭되지 않는다.)\\n포식성 웜은 당신이 개럭 플레인즈워커를 조종하는 한 +2/+2를 받는다.\', \'type\': \'생물 — 웜\', \'flavor\': \'"강자는 먹는다. 약자는 먹힌다. 그게 자연의 도리다."\\n—개럭 와일드스피커\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488764&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'46bac755-63dc-4e8c-95f6-ee60d8ac834d\', \'multiverseId\': 488764}, \'multiverseid\': 488764}, {\'name\': \'Vorme Predador\', \'text\': \'Vigilância (Atacar não faz com que esta criatura seja virada.)\\nVorme Predador receberá +2/+2 enquanto você controlar um planeswalker Garruk.\', \'type\': \'Criatura — Vorme\', \'flavor\': \'"Os fortes comem. Os fracos são comidos. É assim que as coisas são."\\n— Garruk Falabravo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488784&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cdda25f0-ac7e-421f-8e33-ae5e3d6027c1\', \'multiverseId\': 488784}, \'multiverseid\': 488784}, {\'name\': \'Хищный Вурм\', \'text\': "Бдительность (Атакуя, это существо не поворачивается.)\\nХищный Вурм получает +2/+2, пока вы контролируете planeswalker\'а Гаррука.", \'type\': \'Существо — Вурм\', \'flavor\': \'«Сильные едят. Слабых съедают. Таков порядок вещей».\\n— Гаррук Дикоречивый\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488804&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a7a6fce8-fd76-4cec-aabb-9ce89acf73e0\', \'multiverseId\': 488804}, \'multiverseid\': 488804}, {\'name\': \'掠食亚龙\', \'text\': \'警戒（此生物攻击时不需横置。）\\n只要你操控贾路鹏洛客，掠食亚龙便得+2/+2。\', \'type\': \'生物 ～亚龙\', \'flavor\': \'「物竞天择、弱肉强食。这是永恒的定律。」\\n～召兽使贾路\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488824&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'77a660bf-7bcb-4009-873d-eff480a41370\', \'multiverseId\': 488824}, \'multiverseid\': 488824}, {\'name\': \'掠食亞龍\', \'text\': \'警戒（此生物攻擊時不需橫置。）\\n只要你操控賈路鵬洛客，掠食亞龍便得+2/+2。\', \'type\': \'生物 ～亞龍\', \'flavor\': \'「物競天擇、弱肉強食。這是永恆的定律。」\\n～召獸使賈路\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488844&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d1f061ea-a3d7-4dee-8b4f-4b11e421afa1\', \'multiverseId\': 488844}, \'multiverseid\': 488844}]', '[{\'name\': \'Regen der Offenbarung\', \'text\': \'Ziehe drei Karten und wirf dann eine Karte ab.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Als der Himmel sich auftat, rannten wir in Richtung Unterschlupf. Auf halber Strecke und schon klitschnass wurde mir klar, dass wir mehr davon haben, wenn wir ihn mit offenen Armen willkommen heißen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485643&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e0986e92-e278-4bb2-9739-c0f696e388ee\', \'multiverseId\': 485643}, \'multiverseid\': 485643}, {\'name\': \'Lluvia de la revelación\', \'text\': \'Roba tres cartas, luego descarta una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'"En cuanto el cielo se abrió, corrimos a buscar refugio. A medio camino me di cuenta de que, como ya estaba empapada, tenía más que ganar si dejaba que la lluvia cayera sobre mí que si huía de ella".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485902&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4df348c5-6325-404d-8bdd-c8f1e2a45eec\', \'multiverseId\': 485902}, \'multiverseid\': 485902}, {\'name\': \'Pluie de révélation\', \'text\': "Piochez trois cartes, puis défaussez-vous d\'une carte.", \'type\': \'Éphémère\', \'flavor\': "« Lorsque la pluie a commencé à tomber, nous avons couru nous mettre à l\'abri. À mi-chemin, j\'ai soudain pris conscience qu\'étant déjà trempée, j\'avais peut-être plus à gagner à connaître la pluie qu\'à la fuir. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486161&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e65dc840-fcc9-40a9-9654-e6090e053d4e\', \'multiverseId\': 486161}, \'multiverseid\': 486161}, {\'name\': \'Pioggia di Rivelazione\', \'text\': \'Pesca tre carte, poi scarta una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'"Quando il cielo si aprì, corremmo a cercare riparo. A metà strada, d\\\'improvviso mi resi conto che, essendo già inzuppata d\\\'acqua, potevo forse trarre maggior frutto accogliendo la pioggia invece di rifuggirla."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486420&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'47a28262-4211-4e8a-b540-2be2d11dc69b\', \'multiverseId\': 486420}, \'multiverseid\': 486420}, {\'name\': \'啓示の雨\', \'text\': \'カードを３枚引き、その後カード１枚を捨てる。\', \'type\': \'インスタント\', \'flavor\': \'「急な土砂降りに、屋根の下へと走りました。その途中、もうずぶ濡れでしたが、突然気付いたのです。雨から逃れるよりも、雨を体験した方が、多くを得られるのではないかと。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486679&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'794d5b5a-b3af-44c3-8d08-8c3c95dab2c1\', \'multiverseId\': 486679}, \'multiverseid\': 486679}, {\'name\': \'계시의 비\', \'text\': \'카드 세 장을 뽑은 후, 카드 한 장을 버린다.\', \'type\': \'순간마법\', \'flavor\': \'"하늘에서 비가 쏟아지자, 우리는 비를 피할 곳으로 달려갔다. 반쯤 도착했을 때쯤, 나는 이미 푹 젖은 채로 갑자기, 비에서 도망치는 것보다 비를 경험해 보는 것에서 얻는 것이 더 많을지도 모른다는 것을 깨달았다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486938&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a25c9e23-9b25-46d6-8fc8-01f56fbc3637\', \'multiverseId\': 486938}, \'multiverseid\': 486938}, {\'name\': \'Chuva de Revelação\', \'text\': \'Compre três cards e depois descarte um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Quando o céu se derramou, corremos em busca de abrigo. Na metade do caminho percebi que, já encharcado, poderia valer mais a pena aproveitar a chuva do que correr dela."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487197&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'db22f61d-2ba1-4054-a453-bb52b68ed15e\', \'multiverseId\': 487197}, \'multiverseid\': 487197}, {\'name\': \'Дождь Откровения\', \'text\': \'Возьмите три карты, затем сбросьте карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Когда разверзлось небо, мы побежали в укрытие. Но на полпути я внезапно поняла, что мы уже промокли — так что для нас будет полезнее остаться под дождем, а не убегать от него».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487456&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f5b9c9d4-9a78-488d-9102-43c3d018e983\', \'multiverseId\': 487456}, \'multiverseid\': 487456}, {\'name\': \'揭示之雨\', \'text\': \'抓三张牌，然后弃一张牌。\', \'type\': \'瞬间\', \'flavor\': \'「天空突然暴雨倾盆，我们匆忙寻地躲避。但在找到半路时，我一时兴起：既然已全身湿透，为何不索性漫步雨中？这样或许能有更多收获。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487715&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f1618216-c364-451c-bbc1-dedfd6462409\', \'multiverseId\': 487715}, \'multiverseid\': 487715}, {\'name\': \'揭示之雨\', \'text\': \'抽三張牌，然後棄一張牌。\', \'type\': \'瞬間\', \'flavor\': \'「天空突然暴雨傾盆，我們匆忙尋地躲避。但在找到半路時，我一時興起：既然已全身濕透，為何不索性漫步雨中？這樣或許能有更多收穫。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487974&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1b2f6d29-23dd-440f-ae62-908297dd31e1\', \'multiverseId\': 487974}, \'multiverseid\': 487974}]', '[{\'name\': \'Revitalisieren\', \'text\': \'Du erhältst 3 Lebenspunkte dazu.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ein Heiltrank ist kein Ersatz für einen Medikus, aber fürs Erste hält er deine Innereien an Ort und Stelle."\\n—Torricks, Frontmedikus\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485613&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c8365914-f6d5-4774-8661-b4c42ba8cfac\', \'multiverseId\': 485613}, \'multiverseid\': 485613}, {\'name\': \'Revivificar\', \'text\': \'Ganas 3 vidas.\\nRoba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'"La poción no sustituye la labor de un buen cirujano, pero evitará que se te salgan las tripas".\\n—Torricks, médico de guerra\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485872&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a7bdad9e-fa5f-467e-a991-56411cb9669c\', \'multiverseId\': 485872}, \'multiverseid\': 485872}, {\'name\': \'Revitaliser\', \'text\': \'Vous gagnez 3 points de vie.\\nPiochez une carte.\', \'type\': \'Éphémère\', \'flavor\': \'« Une potion ne vaut pas un bon chirurgien, mais ça retient les morceaux. »\\n—Torricks, carabin de campagne\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486131&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8a313595-abd5-4f23-8f7c-c12c55351358\', \'multiverseId\': 486131}, \'multiverseid\': 486131}, {\'name\': \'Rivitalizzare\', \'text\': \'Guadagni 3 punti vita.\\nPesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'"Una pozione non può sostituire un abile chirurgo, ma tiene insieme i pezzi."\\n—Torricks, medico da campo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486390&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6d20d81f-d63f-4fb9-a137-5ccad89695e6\', \'multiverseId\': 486390}, \'multiverseid\': 486390}, {\'name\': \'活力回復\', \'text\': \'あなたは３点のライフを得る。\\nカードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': \'「薬は腕利きの医師の代わりにはならないが、しばらく保たせることはできる。」\\n――戦場の衛生兵、トリックス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486649&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a882b2ec-5b65-4df5-8903-3933b96beaa5\', \'multiverseId\': 486649}, \'multiverseid\': 486649}, {\'name\': \'재활\', \'text\': \'당신은 생명 3점을 얻는다.\\n카드 한 장을 뽑는다.\', \'type\': \'순간마법\', \'flavor\': \'"물약이 솜씨 좋은 의사만은 못하겠지만, 견디게는 해 줄 걸세."\\n—전투 치유사, 토릭스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486908&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c048a19f-b3bf-4ccd-9750-9c27d1236e31\', \'multiverseId\': 486908}, \'multiverseid\': 486908}, {\'name\': \'Revitalizar\', \'text\': \'Você ganha 3 pontos de vida.\\nCompre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Uma poção não substitui um bom cirurgião, mas mantém os pedaços no lugar."\\n— Torricks, socorrista do campo de batalha\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487167&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3dc79ad2-ba13-4fcf-9151-af3bdfa80219\', \'multiverseId\': 487167}, \'multiverseid\': 487167}, {\'name\': \'Восстановление Сил\', \'text\': \'Вы получаете 3 жизни.\\nВозьмите карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Зелье не заменит умелого хирурга, но у тебя хотя бы кишки не вывалятся».\\n— Торрикс, полевой медик\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487426&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'18b896a4-4a55-4db0-ad2a-32187426da05\', \'multiverseId\': 487426}, \'multiverseid\': 487426}, {\'name\': \'再现活力\', \'text\': \'你获得3点生命。\\n抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'「药水虽代替不了妙手回春的医士，但好歹能堵上你的伤口。」\\n～战场医护员托瑞克\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487685&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'56faca37-718a-4522-9475-ed35b2fdaeca\', \'multiverseId\': 487685}, \'multiverseid\': 487685}, {\'name\': \'再現活力\', \'text\': \'你獲得3點生命。\\n抽一張牌。\', \'type\': \'瞬間\', \'flavor\': \'「藥水雖代替不了妙手回春的醫士，但好歹能堵上你的傷口。」\\n～戰場醫護員托瑞克\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487944&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7989c122-9ae9-4941-a4dd-17cf162998d8\', \'multiverseId\': 487944}, \'multiverseid\': 487944}]', '[{\'name\': \'Richtspruch der Legion\', \'text\': \'Zerstöre eine Kreatur deiner Wahl mit Stärke 4 oder mehr.\', \'type\': \'Hexerei\', \'flavor\': \'„Einst führte der Altehrwürdige Tarrian meine Lanze. Mit seiner Stärke und in seinem Namen strecke ich dich nieder!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485606&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8b68798a-1b4f-49b4-82dd-8f01738ea77f\', \'multiverseId\': 485606}, \'multiverseid\': 485606}, {\'name\': \'Juicio de la Legión\', \'text\': \'Destruye la criatura objetivo con fuerza de 4 o más.\', \'type\': \'Conjuro\', \'flavor\': \'"El venerable Tarrian blandió mi lanza hace tiempo. En su nombre y por su poder, ¡yo te expulso!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485865&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9cb7b2a0-c911-4244-9ddd-ff6e3424273b\', \'multiverseId\': 485865}, \'multiverseid\': 485865}, {\'name\': \'Jugement selon la Légion\', \'text\': \'Détruisez une créature de force supérieure ou égale à 4 ciblée.\', \'type\': \'Rituel\', \'flavor\': \'« Ma lance appartenait autrefois au Vénérable Tarrian. En son nom et par sa puissance, je te condamne ! »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486124&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8c2589af-9353-49bf-8615-d6ea0ddf8344\', \'multiverseId\': 486124}, \'multiverseid\': 486124}, {\'name\': \'Giudizio della Legione\', \'text\': \'Distruggi una creatura bersaglio con forza pari o superiore a 4.\', \'type\': \'Stregoneria\', \'flavor\': \'"Un tempo, la mia lancia fu impugnata dal Venerabile Tarrian. È nel suo nome e in virtù della sua potenza che ti anniento!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486383&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'371e7c05-a57a-433d-a626-4ae8113a8c36\', \'multiverseId\': 486383}, \'multiverseid\': 486383}, {\'name\': \'軍団の裁き\', \'text\': \'パワーが４以上のクリーチャー１体を対象とし、それを破壊する。\', \'type\': \'ソーサリー\', \'flavor\': \'「この槍はかつて尊者タリアンが使っていたものだ。その名と力に懸けて、貴様を倒す！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486642&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8ec74349-422b-450f-8419-294330752d4c\', \'multiverseId\': 486642}, \'multiverseid\': 486642}, {\'name\': \'군단의 심판\', \'text\': \'공격력이 4 이상인 생물을 목표로 정한다. 그 생물을 파괴한다.\', \'type\': \'집중마법\', \'flavor\': \'"내 창은 한때 가경자 타리안 님이 휘두르셨던 창이다. 그분의 이름과 힘으로, 네놈을 찍어누르겠다!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486901&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1bd15ed4-fc4b-4e16-a5c3-2fb46c7d7b02\', \'multiverseId\': 486901}, \'multiverseid\': 486901}, {\'name\': \'Julgamento da Legião\', \'text\': \'Destrua a criatura alvo com poder igual ou superior a 4.\', \'type\': \'Feitiço\', \'flavor\': \'"Minha lança já foi empunhada pelo Venerável Tarrian. Em nome dele, pelo poder dele, eu o esconjuro!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487160&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f6d30006-89a8-45fb-bee8-6cacd6f1e815\', \'multiverseId\': 487160}, \'multiverseid\': 487160}, {\'name\': \'Правосудие Легиона\', \'text\': \'Уничтожьте целевое существо с силой 4 или больше.\', \'type\': \'Волшебство\', \'flavor\': \'«Когда-то мое копье принадлежало преподобному Тарриану. Его именем и его могуществом я поражу тебя!»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487419&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ee9fa211-a980-4ec2-8362-50c51e86c4dd\', \'multiverseId\': 487419}, \'multiverseid\': 487419}, {\'name\': \'军团裁决\', \'text\': \'消灭目标力量等于或大于4的生物。\', \'type\': \'法术\', \'flavor\': \'「这柄长枪曾是圣塔理安手中兵器。以彼之名，借彼之力，夺你性命！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487678&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d71b4517-1459-4bc9-8314-ddd6b6fc7324\', \'multiverseId\': 487678}, \'multiverseid\': 487678}, {\'name\': \'軍團裁決\', \'text\': \'消滅目標力量等於或大於4的生物。\', \'type\': \'巫術\', \'flavor\': \'「這柄長槍曾是聖塔理安手中兵器。以彼之名，借彼之力，奪你性命！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487937&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ea661530-7fb8-44b0-9bd3-f7289fc144e3\', \'multiverseId\': 487937}, \'multiverseid\': 487937}]', '[{\'name\': \'Rin und Seri, die Unzertrennlichen\', \'text\': \'Immer wenn du einen Hund-Zauberspruch wirkst, erzeuge einen 1/1 grünen Katze-Kreaturenspielstein.\\nImmer wenn du einen Katze-Zauberspruch wirkst, erzeuge einen 1/1 weißen Hund-Kreaturenspielstein.\\n{R}{G}{W}, {T}: Rin und Seri, die Unzertrennlichen, fügen einem Ziel deiner Wahl so viele Schadenspunkte zu, wie du Hunde kontrollierst. Du erhältst so viele Lebenspunkte dazu, wie du Katzen kontrollierst.\', \'type\': \'Legendäre Kreatur — Hund, Katze\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489664&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'aa49629d-7a94-4ca3-bd17-f14b0450e9e1\', \'multiverseId\': 489664}, \'multiverseid\': 489664}, {\'name\': \'Rin y Seri, inseparables\', \'text\': \'Siempre que lances un hechizo de Perro, crea una ficha de criatura Felino verde 1/1.\\nSiempre que lances un hechizo de Felino, crea una ficha de criatura Perro blanca 1/1.\\n{R}{G}{W}, {T}: Rin y Seri, inseparables hacen una cantidad de daño a cualquier objetivo igual a la cantidad de Perros que controlas. Ganas una cantidad de vidas igual a la cantidad de Felinos que controlas.\', \'type\': \'Criatura legendaria — Felino perro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489665&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'044b2b59-e6e6-4cda-968b-27fcf1020998\', \'multiverseId\': 489665}, \'multiverseid\': 489665}, {\'name\': \'Rin et Seri, inséparables\', \'text\': "À chaque fois que vous lancez un sort de chien, créez un jeton de créature 1/1 verte Chat.\\nÀ chaque fois que vous lancez un sort de chat, créez un jeton de créature 1/1 blanche Chien.\\n{R}{G}{W}, {T} : Rin et Seri, inséparables infligent à n\'importe quelle cible un nombre de blessures égal au nombre de chiens que vous contrôlez. Vous gagnez un nombre de points de vie égal au nombre de chats que vous contrôlez.", \'type\': \'Créature légendaire : chien et chat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489666&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5ccee5b7-11f9-40f5-b1fb-300791b1669a\', \'multiverseId\': 489666}, \'multiverseid\': 489666}, {\'name\': \'Rin e Seri, Inseparabili\', \'text\': \'Ogniqualvolta lanci una magia Canide, crea una pedina creatura Felino 1/1 verde.\\nOgniqualvolta lanci una magia Felino, crea una pedina creatura Canide 1/1 bianca.\\n{R}{G}{W}, {T}: Rin e Seri, Inseparabili infliggono a un qualsiasi bersaglio danno pari al numero di Canidi che controlli.\\nGuadagni punti vita pari al numero di Felini che controlli.\', \'type\': \'Creatura Leggendaria — Canide Felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489667&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5bbfbeab-57c6-4ee2-9576-f669aa1c04a4\', \'multiverseId\': 489667}, \'multiverseid\': 489667}, {\'name\': \'離れられない二匹、リンとセリ\', \'text\': \'あなたが犬・呪文を唱えるたび、緑の１/１の猫・クリーチャー・トークンを１体生成する。\\nあなたが猫・呪文を唱えるたび、白の１/１の犬・クリーチャー・トークンを１体生成する。\\n{R}{G}{W}, {T}：クリーチャー１体かプレインズウォーカー１体かプレイヤー１人を対象とする。離れられない二匹、リンとセリはそれに、あなたがコントロールしている犬の総数に等しい点数のダメージを与える。あなたは、あなたがコントロールしている猫の総数に等しい点数のライフを得る。\', \'type\': \'伝説のクリーチャー — 犬・猫\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489668&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c3071523-d4a9-4892-ad7a-5240c13fbed2\', \'multiverseId\': 489668}, \'multiverseid\': 489668}, {\'name\': \'Rin e Seri, Inseparáveis\', \'text\': \'Toda vez que você conjurar uma mágica de Cão, crie uma ficha de criatura verde 1/1 do tipo Felino.\\nToda vez que você conjurar uma mágica de Felino, crie uma ficha de criatura branca 1/1 do tipo Cão.\\n{R}{G}{W}, {T}: Rin e Seri, Inseparáveis, causa a qualquer alvo uma quantidade de dano igual ao número de Cães que você controla. Você ganha uma quantidade de pontos de vida igual ao número de Felinos que você controla.\', \'type\': \'Criatura Lendária — Cão Felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489670&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'48a000ce-0760-446c-8737-fdf9806e0eb3\', \'multiverseId\': 489670}, \'multiverseid\': 489670}, {\'name\': \'林恩与瑟黎永不离\', \'text\': \'每当你施放狗咒语时，派出一个1/1绿色的猫衍生生物。\\n每当你施放猫咒语时，派出一个1/1白色的狗衍生生物。\\n{R}{G}{W}，{T}：林恩与瑟黎永不离对任意一个目标造成等同于由你操控之狗数量的伤害。你获得等同于由你操控之猫数量的生命。\', \'type\': \'传奇生物 ～狗／猫\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489672&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ab5f5e46-3640-47e2-b332-a20f4db39450\', \'multiverseId\': 489672}, \'multiverseid\': 489672}]', '[{\'name\': \'Ritterschlag\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur erhält +2/+2, hat Erstschlag und ist zusätzlich zu ihren anderen Typen ein Ritter. (Sie fügt Kampfschaden vor Kreaturen ohne Erstschlag zu.)\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Erhebe dich, Ritter von Neu-Benalia."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485598&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bf5c8ead-244c-42eb-8e84-4a1965e18e65\', \'multiverseId\': 485598}, \'multiverseid\': 485598}, {\'name\': \'Nombrar\', \'text\': \'Encantar criatura.\\nLa criatura encantada obtiene +2/+2, tiene la habilidad de dañar primero y es un Caballero además de sus otros tipos. (Hace daño de combate antes que las criaturas sin la habilidad de dañar primero.)\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"Levántate, caballero de Nueva Benalia".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485857&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c73da8fd-de8f-41bd-9f11-12f4439ad83d\', \'multiverseId\': 485857}, \'multiverseid\': 485857}, {\'name\': \'Adoubement\', \'text\': "Enchanter : créature\\nLa créature enchantée gagne +2/+2, a l\'initiative, et est un chevalier en plus de ses autres types. (Elle inflige des blessures de combat avant les créatures sans l\'initiative.)", \'type\': \'Enchantement : aura\', \'flavor\': \'« Relève-toi, chevalier de la Nouvelle Bénalia. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486116&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'56333338-298c-41e5-bcf0-29d087a05975\', \'multiverseId\': 486116}, \'multiverseid\': 486116}, {\'name\': \'Investitura\', \'text\': \'Incanta creatura\\nLa creatura incantata prende +2/+2, ha attacco improvviso ed è un Cavaliere in aggiunta ai suoi altri tipi. (Infligge danno da combattimento prima delle creature senza attacco improvviso.)\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Alzati, cavaliere di Nuova Benalia."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486375&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4b54d562-5cb2-4f79-a7a4-2be6ec4e4798\', \'multiverseId\': 486375}, \'multiverseid\': 486375}, {\'name\': \'叙爵\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントしているクリーチャーは、＋２/＋２の修整を受け、先制攻撃を持ち、それの他のタイプに加えて騎士でもある。（それは先制攻撃を持たないクリーチャーよりも先に戦闘ダメージを与える。）\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「立ちなさい、新ベナリアの騎士よ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486634&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fa2ff7ae-a546-4350-aa1e-6d6860c7a1f2\', \'multiverseId\': 486634}, \'multiverseid\': 486634}, {\'name\': \'작위 수여\', \'text\': \'생물에게 부여\\n부여된 생물은 +2/+2를 받고, 선제공격을 가지며, 자신의 다른 유형에 더불어 기사다. (이 생물은 선제공격이 없는 생물보다 먼저 전투피해를 입힌다.)\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'"일어나라, 신 베날리아의 기사여."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486893&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d3b85312-a084-4a70-bc55-2a58954f5a0f\', \'multiverseId\': 486893}, \'multiverseid\': 486893}, {\'name\': \'Sagrar\', \'text\': \'Encantar criatura\\nA criatura encantada recebe +2/+2, tem iniciativa e é um Cavaleiro além de seus outros tipos. (Ela causa dano de combate antes das criaturas sem iniciativa.)\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Levante-se, cavaleiro de Nova Benália."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487152&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dacddb4e-1cf7-4f6f-81c2-19402e0e568e\', \'multiverseId\': 487152}, \'multiverseid\': 487152}, {\'name\': \'Посвящение\', \'text\': \'Зачаровать существо\\nЗачарованное существо получает +2/+2, имеет Первый удар и является Рыцарем в дополнение к своим другим типам. (Оно наносит боевые повреждения раньше существ без Первого удара.)\', \'type\': \'Чары — Аура\', \'flavor\': \'«Встань, рыцарь Новой Беналии».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487411&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9510c47a-11e1-468a-80d1-9d743a9d9d2b\', \'multiverseId\': 487411}, \'multiverseid\': 487411}, {\'name\': \'册封\', \'text\': \'结附于生物\\n所结附的生物得+2/+2，具有先攻异能，且额外具有骑士此类别。（它会比不具先攻异能的生物提前造成战斗伤害。）\', \'type\': \'结界 ～灵气\', \'flavor\': \'「平身，新宾纳里亚的骑士。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487670&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fed5afe5-d7f4-44b8-aa2f-5c9e26f93322\', \'multiverseId\': 487670}, \'multiverseid\': 487670}, {\'name\': \'冊封\', \'text\': \'結附於生物\\n所結附的生物得+2/+2，具有先攻異能，且額外具有騎士此類別。（它會比不具先攻異能的生物提前造成戰鬥傷害。）\', \'type\': \'結界 ～靈氣\', \'flavor\': \'「平身，新賓納里亞的騎士。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487929&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f397b4b4-7f39-4eaf-80a7-279d201d64c9\', \'multiverseId\': 487929}, \'multiverseid\': 487929}]', '[{\'name\': \'Rudelführer\', \'text\': \'Andere Hunde, die du kontrollierst, erhalten +1/+1.\\nImmer wenn der Rudelführer angreift, verhindere allen Kampfschaden, der in diesem Zug Hunden, die du kontrollierst, zugefügt würde.\', \'type\': \'Kreatur — Hund\', \'flavor\': \'Er ist dein loyaler Champion und sein Rudel wird dich beschützen. Alles, was er fordert, ist ein voller Bauch, ein Platz am Feuer und all die Liebe in deinem Herzen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485611&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ef1e14f1-a8d4-4e6b-9825-6917e3755cb8\', \'multiverseId\': 485611}, \'multiverseid\': 485611}, {\'name\': \'Líder de la jauría\', \'text\': \'Los otros Perros que controlas obtienen +1/+1.\\nSiempre que el Líder de la jauría ataque, prevén todo el daño de combate que se fuera a hacer este turno a Perros que controlas.\', \'type\': \'Criatura — Perro\', \'flavor\': \'Será tu fiel campeón; y su jauría, tus protectores. Solo te pide a cambio tener la barriga llena, un sitio al lado del fuego y todo el amor en tu corazón.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485870&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4545d414-4a4b-47aa-ba2b-9bf465d0a80e\', \'multiverseId\': 485870}, \'multiverseid\': 485870}, {\'name\': \'Chef de la meute\', \'text\': \'Les autres chiens que vous contrôlez gagnent +1/+1.\\nÀ chaque fois que le Chef de la meute attaque, prévenez toutes les blessures de combat qui devraient être infligées ce tour-ci aux chiens que vous contrôlez.\', \'type\': \'Créature : chien\', \'flavor\': "Il sera votre fidèle champion, et sa meute vous protègera. Tout ce qu\'il demande en échange, c\'est un estomac rempli, une place près du feu, et tout l\'amour que vous pourrez lui offrir.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486129&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5a339ed2-1444-4f10-b3cb-500a7c9c4b6a\', \'multiverseId\': 486129}, \'multiverseid\': 486129}, {\'name\': \'Capo del Branco\', \'text\': \'Gli altri Canidi che controlli prendono +1/+1.\\nOgniqualvolta il Capo del Branco attacca, previeni tutto il danno da combattimento che verrebbe inflitto in questo turno ai Canidi che controlli.\', \'type\': \'Creatura — Canide\', \'flavor\': "Sarà il tuo campione fedele e il suo branco ti proteggerà. In cambio, non chiede altro che lo stomaco pieno, un posto accanto al fuoco e tutto l\'amore di cui sei capace.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486388&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'985077c9-c530-4dbf-8d5f-d8101eee1029\', \'multiverseId\': 486388}, \'multiverseid\': 486388}, {\'name\': \'群れを導くもの\', \'text\': \'他の、あなたがコントロールしている犬は＋１/＋１の修整を受ける。\\n群れを導くものが攻撃するたび、このターン、あなたがコントロールしている犬が受ける戦闘ダメージをすべて軽減する。\', \'type\': \'クリーチャー — 犬\', \'flavor\': \'彼は忠実な勇者となり、その群れは君を守るだろう。彼が望むのは満腹と火の傍の居場所、そして君の心からの愛情だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486647&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fdc3c4f6-486b-43cc-8074-72474cd6d3f2\', \'multiverseId\': 486647}, \'multiverseid\': 486647}, {\'name\': \'무리 대장\', \'text\': \'당신이 조종하는 다른 개들은 +1/+1을 받는다.\\n무리 대장이 공격할 때마다, 이번 턴에 당신이 조종하는 개들에게 입혀질 모든 피해를 방지한다.\', \'type\': \'생물 — 개\', \'flavor\': \'그는 당신의 충직한 용사가 될 것이며, 그의 무리는 당신의 수호자가 될 것이다. 그가 요구하는 것은 배를 곯지 않고, 불가에 한 자리를 얻으며, 당신의 사랑을 독차지하는 것뿐이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486906&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6ffa88f2-57ad-4526-aaa5-f2207cbf92c1\', \'multiverseId\': 486906}, \'multiverseid\': 486906}, {\'name\': \'Líder da Matilha\', \'text\': \'Os outros Cães que você controla recebem +1/+1.\\nToda vez que Líder da Matilha atacar, previna todo dano de combate que seria causado neste turno a Cães que você controla.\', \'type\': \'Criatura — Cão\', \'flavor\': \'Ele será seu leal companheiro e sua matilha te protegerá. Em troca, ele pede apenas que mantenha sua barriga cheia, seu lugar junto ao fogo e todo o amor no seu coração.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487165&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7c660999-a3d6-4317-aab5-4c32b8cbb125\', \'multiverseId\': 487165}, \'multiverseid\': 487165}, {\'name\': \'Вожак Стаи\', \'text\': \'Другие Собаки под вашим контролем получают +1/+1.\\nКаждый раз, когда Вожак Стаи атакует, предотвратите все боевые повреждения, которые должны быть нанесены в этом ходу Собакам под вашим контролем.\', \'type\': \'Существо — Собака\', \'flavor\': \'Он станет твоим верным поборником, а его стая будет защищать тебя. Все, что он просит взамен, — это полный живот, место у огня и всю любовь, что есть в твоем сердце.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487424&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2d12ec7a-1b49-4e22-9be8-8389b86b5c69\', \'multiverseId\': 487424}, \'multiverseid\': 487424}, {\'name\': \'犬群领袖\', \'text\': \'由你操控的其他狗得+1/+1。\\n每当犬群领袖攻击时，防止本回合中将对由你操控的狗造成之所有战斗伤害。\', \'type\': \'生物 ～狗\', \'flavor\': \'它会成为你的忠诚勇士，它身边犬群会成为你的贴身护卫。而它要求的，不过是果腹伙食、炉边歇息和满心关爱。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487683&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a71cbf1a-d6b3-4d74-a49e-bfd6d5fe1224\', \'multiverseId\': 487683}, \'multiverseid\': 487683}, {\'name\': \'犬群領袖\', \'text\': \'由你操控的其他狗得+1/+1。\\n每當犬群領袖攻擊時，防止本回合中將對由你操控的狗造成之所有戰鬥傷害。\', \'type\': \'生物 ～狗\', \'flavor\': \'牠會成為你的忠誠勇士，牠身邊犬群會成為你的貼身護衛。而牠要求的，不過是果腹伙食、爐邊歇息和滿心關愛。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487942&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f565b374-d333-4b5a-928c-0b022bae9743\', \'multiverseId\': 487942}, \'multiverseid\': 487942}]', '[{\'name\': \'Runenverzierter Schein\', \'text\': \'Sowie der Runenverzierte Schein ins Spiel kommt, bestimme einen Kartennamen.\\nDu hast Schutz vor dem bestimmten Kartennamen. (Nichts mit diesem Namen kann dich als Ziel haben, dir Schaden zufügen oder dich verzaubern.)\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485614&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d420ce00-e6c0-40a1-ba05-e51b790e46e8\', \'multiverseId\': 485614}, \'multiverseid\': 485614}, {\'name\': \'Halo rúnico\', \'text\': \'En cuanto el Halo rúnico entre al campo de batalla, elige un nombre de carta.\\nTienes protección contra el nombre de carta elegido. (No puedes ser objetivo, recibir daño o estar encantado por nada con ese nombre.)\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485873&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'473f757c-f319-4150-ba2f-78635f8ede8f\', \'multiverseId\': 485873}, \'multiverseid\': 485873}, {\'name\': \'Halo serti de runes\', \'text\': \'Au moment où le Halo serti de runes arrive sur le champ de bataille, choisissez un nom de carte.\\nVous avez la protection contre le nom de carte choisi. (Vous ne pouvez pas être ciblé, blessé ou enchanté par une source avec ce nom.)\', \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486132&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c89ed61c-9fc8-4b85-993a-f562cee2547b\', \'multiverseId\': 486132}, \'multiverseid\': 486132}, {\'name\': \'Aureola Runica\', \'text\': "Mentre l\'Aureola Runica entra nel campo di battaglia, scegli il nome di una carta.\\nHai protezione dal nome di carta scelto. (Non puoi essere bersagliato, non ti può essere inflitto danno, né puoi essere incantato da qualcosa con il nome scelto.)", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486391&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f73a5a21-f7d5-4320-bca0-539c5fabe5c9\', \'multiverseId\': 486391}, \'multiverseid\': 486391}, {\'name\': \'ルーンの光輪\', \'text\': \'ルーンの光輪が戦場に出るに際し、カード名１つを選ぶ。\\nあなたはプロテクション（その選ばれたカード名）を持つ。（あなたはその名前を持つものによっては、対象にならず、ダメージを受けず、エンチャントされない。）\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486650&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f53782a5-e913-482c-8be8-2439fc393e93\', \'multiverseId\': 486650}, \'multiverseid\': 486650}, {\'name\': \'룬이 새겨진 광륜\', \'text\': \'룬이 새겨진 광륜이 전장에 들어오면서, 카드 이름 하나를 선택한다.\\n당신은 선택된 카드 이름으로부터 보호를 가진다. (당신은 그 이름을 가진 주문의 목표로 정해질 수 없고, 그 이름을 가진 원천으로부터 피해를 입지 않으며, 그 이름을 가진 부여마법에 부여될 수 없다.)\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486909&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ab576321-59c7-475e-a0b2-557b4cff840b\', \'multiverseId\': 486909}, \'multiverseid\': 486909}, {\'name\': \'Auréola Rúnica\', \'text\': \'Conforme Auréola Rúnica entrar no campo de batalha, escolha um nome de card.\\nVocê tem proteção contra o nome de card escolhido. (Você não pode ser alvo, causar dano nem ser encantado por nada com aquele nome.)\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487168&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e4bda8c8-2b3b-4f87-abd9-a80b21e6f698\', \'multiverseId\': 487168}, \'multiverseid\': 487168}, {\'name\': \'Рунный Нимб\', \'text\': \'При выходе Рунного Нимба на поле битвы выберите имя карты.\\nВы имеете Защиту от выбранного имени карты. (Объекты с тем именем не могут делать вас своей целью, наносить вам повреждения или зачаровывать вас.)\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487427&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d8ab6e15-7bc8-486f-91a9-96a5d866e812\', \'multiverseId\': 487427}, \'multiverseid\': 487427}, {\'name\': \'符文光晕\', \'text\': \'于符文光晕进战场时，选择一个牌名。\\n你具有反该牌名保护异能。（你不能被该名称的东西指定为目标、造成伤害或是结附。）\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487686&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fd8ee3b1-b946-434e-91cf-e89050e5ff72\', \'multiverseId\': 487686}, \'multiverseid\': 487686}, {\'name\': \'符文光暈\', \'text\': \'於符文光暈進戰場時，選擇一個牌名。\\n你具有反該牌名保護異能。（你不能被該名稱的東西指定為目標、造成傷害或是結附。）\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487945&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'03eb9a27-25d0-491e-98af-0a651560fe01\', \'multiverseId\': 487945}, \'multiverseid\': 487945}]', '[{\'name\': \'Runenverzierter Wettstreiter\', \'text\': \'Der Runenverzierte Wettstreiter hat Lebensverknüpfung, solange mindestens eine +1/+1-Marke auf ihm liegt. (Schaden, der von dieser Kreatur zugefügt wird, lässt dich entsprechend viele Lebenspunkte dazuerhalten.)\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': \'„Nun gut. Die Aufwärmübungen sind vorüber."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488649&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'43c3b769-a990-423e-93e1-e1e6a33c6f40\', \'multiverseId\': 488649}, \'multiverseid\': 488649}, {\'name\': \'Contendiente con sellos\', \'text\': \'El Contendiente con sellos tiene la habilidad de vínculo vital mientras tenga un contador +1/+1 sobre él. (El daño hecho por esta criatura también hace que ganes esa misma cantidad de vidas.)\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': \'"Muy bien. Se acabó el calentamiento".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488669&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f81698ce-5997-41dc-adec-c3d06bbe8077\', \'multiverseId\': 488669}, \'multiverseid\': 488669}, {\'name\': \'Concurrent sigillé\', \'text\': "Le Concurrent sigillé a le lien de vie tant qu\'il a au moins un marqueur +1/+1 sur lui. (Les blessures infligées par cette créature vous font aussi gagner autant de points de vie.)", \'type\': \'Créature : humain et guerrier\', \'flavor\': "« Très bien. L\'échauffement est terminé. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488689&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bd4462b1-0885-4ba7-afc6-83de7837f1e8\', \'multiverseId\': 488689}, \'multiverseid\': 488689}, {\'name\': \'Contendente dei Sigilli\', \'text\': \'Il Contendente dei Sigilli ha legame vitale fintanto che ha un segnalino +1/+1. (Il danno inflitto da questa creatura ti fa anche guadagnare altrettanti punti vita.)\', \'type\': \'Creatura — Guerriero Umano\', \'flavor\': \'"Bene. Il riscaldamento è finito."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488709&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'054c077c-42d4-4fde-939c-ccd35d953377\', \'multiverseId\': 488709}, \'multiverseid\': 488709}, {\'name\': \'印章持ちの挑戦者\', \'text\': \'印章持ちの挑戦者の上に＋１/＋１カウンターが置かれているかぎり、これは絆魂を持つ。（このクリーチャーがダメージを与えると、さらにあなたはその点数分のライフを得る。）\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': \'「よし。ウォーミングアップは終わりだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488729&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e7cadd1c-7f56-4f31-98dd-e94c498a51aa\', \'multiverseId\': 488729}, \'multiverseid\': 488729}, {\'name\': \'인장을 가진 도전자\', \'text\': \'인장을 가진 도전자는 +1/+1 카운터를 가지고 있는 한 생명연결을 가진다. (이 생물이 피해를 입히면, 당신은 그 피해만큼의 생명점을 얻는다.)\', \'type\': \'생물 — 인간 전사\', \'flavor\': \'"좋아. 몸 풀기는 끝났어."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488749&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c3c5d0af-45c9-428d-8ca6-7d92c54e9b1e\', \'multiverseId\': 488749}, \'multiverseid\': 488749}, {\'name\': \'Competidor Rúnico\', \'text\': \'Competidor Rúnico terá vínculo com a vida enquanto tiver um marcador +1/+1. (O dano causado por esta criatura também faz com que você ganhe uma quantidade equivalente de pontos de vida.)\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': \'"Beleza. Acabou o aquecimento."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488769&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d3f8ac2a-3f27-468c-a4d3-908b4b958da5\', \'multiverseId\': 488769}, \'multiverseid\': 488769}, {\'name\': \'Медаленосный Претендент\', \'text\': \'Медаленосный Претендент имеет Цепь жизни, пока на нем есть жетон +1/+1. (Повреждения, наносимые этим существом, также заставляют вас получить такое же количество жизней.)\', \'type\': \'Существо — Человек Воин\', \'flavor\': \'«Хорошо. Разминка закончена».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488789&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a9030f8c-3033-4054-820e-a59a7d543c64\', \'multiverseId\': 488789}, \'multiverseid\': 488789}, {\'name\': \'受印竞争者\', \'text\': \'只要受印竞争者上面有+1/+1指示物，它便具有系命异能。（此生物所造成的伤害会让你获得等量的生命。）\', \'type\': \'生物 ～人类／战士\', \'flavor\': \'「好。热身结束了。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488809&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'013103f8-b815-4161-b97c-a4703bbae69d\', \'multiverseId\': 488809}, \'multiverseid\': 488809}, {\'name\': \'受印競爭者\', \'text\': \'只要受印競爭者上面有+1/+1指示物，它便具有繫命異能。（此生物所造成的傷害會讓你獲得等量的生命。）\', \'type\': \'生物 ～人類／戰士\', \'flavor\': \'「好。熱身結束了。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488829&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ae329a30-c95b-4aad-95bf-271dbb094664\', \'multiverseId\': 488829}, \'multiverseid\': 488829}]', "[{'name': 'Runenwand', 'text': 'Verteidiger (Diese Kreatur kann nicht angreifen.)\\nWenn die Runenwand ins Spiel kommt, wende Hellsicht 1 an. (Schaue dir die oberste Karte deiner Bibliothek an. Du kannst sie unter deine Bibliothek legen.)', 'type': 'Kreatur — Mauer', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485667&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b3353edb-8de9-4b47-b5df-f3912f682a48', 'multiverseId': 485667}, 'multiverseid': 485667}, {'name': 'Muro de runas', 'text': 'Defensor. (Esta criatura no puede atacar.)\\nCuando el Muro de runas entre al campo de batalla, adivina 1. (Mira la primera carta de tu biblioteca. Puedes poner esa carta en el fondo de tu biblioteca.)', 'type': 'Criatura — Muro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485926&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4dd50846-9543-4253-9704-6b851b8f155f', 'multiverseId': 485926}, 'multiverseid': 485926}, {'name': 'Mur de runes', 'text': 'Défenseur (Cette créature ne peut pas attaquer.)\\nQuand le Mur de runes arrive sur le champ de bataille, regard 1. (Regardez la carte du dessus de votre bibliothèque. Vous pouvez la mettre au-dessous de votre bibliothèque.)', 'type': 'Créature : mur', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486185&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'fc72a5ec-cdc9-458b-bedb-66d895361da7', 'multiverseId': 486185}, 'multiverseid': 486185}, {'name': 'Muro di Rune', 'text': 'Difensore (Questa creatura non può attaccare.)\\nQuando il Muro di Rune entra nel campo di battaglia, profetizza 1. (Guarda la prima carta del tuo grimorio. Puoi mettere quella carta in fondo al tuo grimorio.)', 'type': 'Creatura — Muro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486444&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ed26dd97-626b-48d9-b59f-6ea185e50ee5', 'multiverseId': 486444}, 'multiverseid': 486444}, {'name': 'ルーンの壁', 'text': '防衛（このクリーチャーでは攻撃できない。）\\nルーンの壁が戦場に出たとき、占術１を行う。（あなたのライブラリーの一番上のカードを見る。あなたはそのカードをあなたのライブラリーの一番下に置いてもよい。）', 'type': 'クリーチャー — 壁', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486703&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'aa21c0dd-401e-418c-82f6-9b8a028ae3d3', 'multiverseId': 486703}, 'multiverseid': 486703}, {'name': '룬의 벽', 'text': '수비태세 (이 생물은 공격할 수 없다.)\\n룬의 벽이 전장에 들어올 때, 점술 1을 한다. (당신의 서고 맨 위 카드 한 장을 본다. 당신은 그 카드를 당신의 서고 맨 밑에 놓을 수 있다.)', 'type': '생물 — 벽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486962&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '37257a12-8615-4571-85ba-fde06e7ba69c', 'multiverseId': 486962}, 'multiverseid': 486962}, {'name': 'Barreira de Runas', 'text': 'Defensor (Esta criatura não pode atacar.)\\nQuando Barreira de Runas entrar no campo de batalha, use vidência 1. (Olhe o card do topo de seu grimório. Você pode colocar aquele card no fundo de seu grimório.)', 'type': 'Criatura — Barreira', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487221&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '28beb30f-1dab-44f9-90a6-88c1200160a5', 'multiverseId': 487221}, 'multiverseid': 487221}, {'name': 'Стена Рун', 'text': 'Защитник (Это существо не может атаковать.)\\nКогда Стена Рун выходит на поле битвы, предскажите 1. (Посмотрите верхнюю карту вашей библиотеки. Вы можете положить ту карту в низ вашей библиотеки.)', 'type': 'Существо — Стена', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487480&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '8982fd5f-e65e-4993-9633-d9cec0a49b98', 'multiverseId': 487480}, 'multiverseid': 487480}, {'name': '符文墙', 'text': '守军（此生物不能攻击。）\\n当符文墙进战场时，占卜1。（检视你牌库顶的牌。你可以将该牌置于你的牌库底。）', 'type': '生物 ～墙', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487739&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'ea7d5188-abb5-4583-b9a1-30c030a91e9f', 'multiverseId': 487739}, 'multiverseid': 487739}, {'name': '符文牆', 'text': '守軍（此生物不能攻擊。）\\n當符文牆進戰場時，占卜1。（檢視你牌庫頂的牌。你可以將該牌置於你的牌庫底。）', 'type': '生物 ～牆', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487998&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '807e8ae8-73f4-4574-9571-84f875f6cc86', 'multiverseId': 487998}, 'multiverseid': 487998}]", '[{\'name\': \'Rätselgestalt\', \'text\': \'Immer wenn du einen Nichtkreatur-Zauberspruch wirkst, kannst du die Rätselgestalt zusätzlich zu ihren anderen Typen bis zum Ende des Zuges zu einer 3/3 Sphinx-Kreatur mit Flugfähigkeit werden lassen.\\n{2}{U}: Hellsicht 1. (Schaue dir die oberste Karte deiner Bibliothek an. Du kannst sie unter deine Bibliothek legen.)\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485646&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cbd7c021-dcce-499b-83af-4d5b9927bdab\', \'multiverseId\': 485646}, \'multiverseid\': 485646}, {\'name\': \'Forma enigmática\', \'text\': \'Siempre que lances un hechizo que no sea de criatura, puedes hacer que la Forma enigmática se convierta en una criatura Esfinge 3/3 con la habilidad de volar además de sus otros tipos hasta el final del turno.\\n{2}{U}: Adivina 1. (Mira la primera carta de tu biblioteca. Puedes poner esa carta en el fondo de tu biblioteca.)\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485905&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'634f269b-71eb-4d8d-b9f1-57ceb7491e60\', \'multiverseId\': 485905}, \'multiverseid\': 485905}, {\'name\': \'Énigmomorphe\', \'text\': "À chaque fois que vous lancez un sort non-créature, vous pouvez faire que l\'Énigmomorphe devienne une créature 3/3 Sphinx avec le vol en plus de ses autres types jusqu\'à la fin du tour.\\n{2}{U} : Regard 1. (Regardez la carte du dessus de votre bibliothèque. Vous pouvez la mettre au-dessous de votre bibliothèque.)", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486164&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dbfd267d-d495-460a-b01d-13a0731db5f7\', \'multiverseId\': 486164}, \'multiverseid\': 486164}, {\'name\': \'Enigmorfo\', \'text\': "Ogniqualvolta lanci una magia non creatura, puoi far diventare l\'Enigmorfo una creatura Sfinge 3/3 con volare in aggiunta ai suoi altri tipi fino alla fine del turno.\\n{2}{U}: Profetizza 1. (Guarda la prima carta del tuo grimorio. Puoi mettere quella carta in fondo al tuo grimorio.)", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486423&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'da890b58-062a-4abd-a209-5025b81d9de2\', \'multiverseId\': 486423}, \'multiverseid\': 486423}, {\'name\': \'謎変化\', \'text\': \'あなたがクリーチャーでない呪文を唱えるたび、あなたは「ターン終了時まで、謎変化はこれの他のタイプに加えて飛行を持つ３/３のスフィンクス・クリーチャーになる。」を選んでもよい。\\n{2}{U}：占術１を行う。（あなたのライブラリーの一番上のカードを見る。あなたはそのカードをあなたのライブラリーの一番下に置いてもよい。）\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486682&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a644d008-6b73-4b84-a3f0-604ccdaa782c\', \'multiverseId\': 486682}, \'multiverseid\': 486682}, {\'name\': \'수수께끼형상\', \'text\': \'당신이 생물이 아닌 주문을 발동할 때마다, 당신은 수수께끼형상이 턴종료까지 자신의 원래 유형에 더불어 비행을 가진 3/3 스핑크스 생물이 되도록 할 수 있다.\\n{2}{U}: 점술 1을 한다. (당신의 서고 맨 위 카드 한 장을 본다. 당신은 그 카드를 당신의 서고 맨 밑에 놓을 수 있다.)\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486941&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f0a3f231-c1c7-41cf-9595-343c729bffe5\', \'multiverseId\': 486941}, \'multiverseid\': 486941}, {\'name\': \'Enigmorfo\', \'text\': \'Toda vez que conjura uma mágica que não seja de criatura, você pode fazer com que Enigmorfo se torne uma criatura 3/3 do tipo Esfinge com voar além de seus outros tipos até o final do turno.\\n{2}{U}: Vidência 1. (Olhe o card do topo de seu grimório. Você pode colocar aquele card no fundo de seu grimório.)\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487200&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2210e391-e85c-4fc5-b7b5-390c398734e6\', \'multiverseId\': 487200}, \'multiverseid\': 487200}, {\'name\': \'Личина Загадок\', \'text\': \'Каждый раз, когда вы разыгрываете не являющееся существом заклинание, вы можете заставить Личину Загадок стать существом 3/3 Сфинкс с Полетом в дополнение к ее другим типам до конца хода.\\n{2}{U}: предскажите 1. (Посмотрите верхнюю карту вашей библиотеки. Вы можете положить ту карту в низ вашей библиотеки.)\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487459&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6f3597cb-8d95-4ae5-91be-2e23b92bb706\', \'multiverseId\': 487459}, \'multiverseid\': 487459}, {\'name\': \'迷幻形体\', \'text\': \'每当你施放非生物咒语时，你可以令迷幻形体成为3/3，具飞行异能的史芬斯生物直到回合结束，且仍具有原本类别。\\n{2}{U}：占卜1。（检视你牌库顶的牌。你可以将该牌置于你的牌库底。）\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487718&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0d8345fc-99b7-4e73-8c34-a4aee8f26daf\', \'multiverseId\': 487718}, \'multiverseid\': 487718}, {\'name\': \'迷幻形體\', \'text\': \'每當你施放非生物咒語時，你可以令迷幻形體成為3/3，具飛行異能的史芬斯生物直到回合結束，且仍具有原本類別。\\n{2}{U}：占卜1。（檢視你牌庫頂的牌。你可以將該牌置於你的牌庫底。）\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487977&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7670c627-661b-4a61-aa72-6069707fc282\', \'multiverseId\': 487977}, \'multiverseid\': 487977}]', '[{\'name\': \'Révélation sublime\', \'text\': "Choisissez l\'un ou plus —\\n• Contrecarrez le sort ciblé.\\n• Contrecarrez la capacité activée ciblée ou la capacité déclenchée ciblée.\\n• Renvoyez un permanent non-terrain ciblé dans la main de son propriétaire.\\n• Créez un jeton qui est une copie d\'une créature ciblée que vous contrôlez.\\n• Le joueur ciblé pioche une carte.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488306&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'30fe3442-f6ad-459a-8c09-c53100206042\', \'multiverseId\': 488306}, \'multiverseid\': 488306}, {\'name\': \'崇高な天啓\', \'text\': \'以下から１つ以上を選ぶ。\\n• 呪文１つを対象とし、それを打ち消す。\\n• 起動型か誘発型である能力１つを対象とし、それを打ち消す。\\n• 土地でないパーマネント１つを対象とし、それをオーナーの手札に戻す。\\n• あなたがコントロールしているクリーチャー１体を対象とし、それのコピーであるトークンを１体生成する。\\n• プレイヤー１人を対象とする。そのプレイヤーはカードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488358&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d2a4071d-79f6-442a-a38e-5f4d33b163a7\', \'multiverseId\': 488358}, \'multiverseid\': 488358}]', '[{\'name\': \'Rückkehr zur Natur\', \'text\': \'Bestimme eines —\\n• Zerstöre ein Artefakt deiner Wahl.\\n• Zerstöre eine Verzauberung deiner Wahl.\\n• Schicke eine Karte deiner Wahl aus einem Friedhof ins Exil.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Natürlich ist die Natur stärker als alles andere. Du siehst ja auch keine kleinen Häuschen auf Bäumen sprießen."\\n—Emmara\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485782&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0117a7a7-1fc9-4604-9531-6922d6a8b750\', \'multiverseId\': 485782}, \'multiverseid\': 485782}, {\'name\': \'Regreso a la naturaleza\', \'text\': \'Elige uno:\\n• Destruye el artefacto objetivo.\\n• Destruye el encantamiento objetivo.\\n• Exilia la carta objetivo de un cementerio.\', \'type\': \'Instantáneo\', \'flavor\': \'"Sí, la naturaleza es más fuerte. De los árboles no brotan pequeños edificios".\\n—Emmara\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486041&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a0ca1684-514b-48a6-98d6-0ff93604529a\', \'multiverseId\': 486041}, \'multiverseid\': 486041}, {\'name\': \'Regain de la nature\', \'text\': "Choisissez l\'un —\\n• Détruisez l\'artefact ciblé.\\n• Détruisez l\'enchantement ciblé.\\n• Exilez une carte ciblée depuis un cimetière.", \'type\': \'Éphémère\', \'flavor\': \'« Oui, la nature est la plus forte. On ne voit jamais de petits édifices pousser sur des arbres. »\\n—Emmara\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486300&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d63f81cf-5615-4e32-b64b-4727d4a46b8e\', \'multiverseId\': 486300}, \'multiverseid\': 486300}, {\'name\': \'Restituire alla Natura\', \'text\': \'Scegli uno —\\n• Distruggi un artefatto bersaglio.\\n• Distruggi un incantesimo bersaglio.\\n• Esilia una carta bersaglio da un cimitero.\', \'type\': \'Istantaneo\', \'flavor\': \'"Sì, la natura è più forte. Hai mai visto piccoli edifici germogliare sugli alberi?"\\n—Emmara\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486559&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'98ec4165-533c-485d-a8bc-823615f659fd\', \'multiverseId\': 486559}, \'multiverseid\': 486559}, {\'name\': \'自然への回帰\', \'text\': \'以下から１つを選ぶ。\\n• アーティファクト１つを対象とし、それを破壊する。\\n• エンチャント１つを対象とし、それを破壊する。\\n• 墓地からカード１枚を対象とし、それを追放する。\', \'type\': \'インスタント\', \'flavor\': \'「そう、自然は強い。木から建物が生えるのは見たことがないでしょう。」\\n――イマーラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486818&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'779a5f53-a3b5-4953-b57a-d21c57f3871f\', \'multiverseId\': 486818}, \'multiverseid\': 486818}, {\'name\': \'자연으로의 회귀\', \'text\': \'하나를 선택한다 —\\n• 마법물체를 목표로 정한다. 그 마법물체를 파괴한다.\\n• 부여마법을 목표로 정한다. 그 부여마법을 파괴한다.\\n• 무덤에 있는 카드를 목표로 정한다. 그 카드를 추방한다.\', \'type\': \'순간마법\', \'flavor\': \'"그래, 자연이 더 강하지. 나무 위에서 피어나는 건물은 본 적 없을 테니까."\\n—에마라\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487077&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'96b51dc6-14c2-4110-b8f5-1b6380cd4ae5\', \'multiverseId\': 487077}, \'multiverseid\': 487077}, {\'name\': \'Retorno à Natureza\', \'text\': \'Escolha um —\\n• Destrua o artefato alvo.\\n• Destrua o encantamento alvo.\\n• Exile o card alvo de um cemitério.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Sim, a natureza é mais forte. Você não vê prediozinhos brotando em árvores."\\n— Emmara\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487336&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2259a4f8-1844-4af3-8b70-4cd463948450\', \'multiverseId\': 487336}, \'multiverseid\': 487336}, {\'name\': \'Возвращение к Природе\', \'text\': \'Выберите одно —\\n• Уничтожьте целевой артефакт.\\n• Уничтожьте целевые чары.\\n• Изгоните целевую карту из кладбища.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Да, природа сильнее. Ты не найдешь дерева, поросшего маленькими домиками».\\n— Эммара\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487595&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dbe468f0-5c9b-4674-9c1b-bc09991233f7\', \'multiverseId\': 487595}, \'multiverseid\': 487595}, {\'name\': \'回返自然\', \'text\': \'选择一项～\\n•消灭目标神器。\\n•消灭目标结界。\\n•将目标牌从坟墓场放逐。\', \'type\': \'瞬间\', \'flavor\': \'「没错，自然更强大。你可看不到树上探出建物。」\\n～艾玛拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487854&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5ca3bcf9-68ad-473f-8046-ae94bb6a1acd\', \'multiverseId\': 487854}, \'multiverseid\': 487854}, {\'name\': \'回返自然\', \'text\': \'選擇一項～\\n•消滅目標神器。\\n•消滅目標結界。\\n•將目標牌從墳墓場放逐。\', \'type\': \'瞬間\', \'flavor\': \'「沒錯，自然更強大。你可看不到樹上探出建物。」\\n～艾瑪拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488113&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5cb2a78c-0015-45d8-b512-d5136adb8ea9\', \'multiverseId\': 488113}, \'multiverseid\': 488113}]', '[{\'name\': \'Sagenschuppen-Coatl\', \'text\': \'Immer wenn du eine Karte ziehst, lege eine +1/+1-Marke auf den Sagenschuppen-Coatl.\', \'type\': \'Kreatur — Ophis\', \'flavor\': \'„Die Erleuchtung, die ich im Ätherium nie fand, zeigte sich mir in den Schuppen des Coatls."\\n—Ranalus, Vedalken-Ketzer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485803&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d6455b69-a4fd-46a2-bd1a-f01a5f649bdb\', \'multiverseId\': 485803}, \'multiverseid\': 485803}, {\'name\': \'Coatl escamas de sabiduría\', \'text\': \'Siempre que robes una carta, pon un contador +1/+1 sobre el Coatl escamas de sabiduría.\', \'type\': \'Criatura — Víbora\', \'flavor\': \'"La iluminación que nunca encontré en el eterium la encontré escrita en las escamas del coatl".\\n—Ranalus, hereje vedalken\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486062&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f1fd528e-6da1-4b39-8229-ac1ce228e591\', \'multiverseId\': 486062}, \'multiverseid\': 486062}, {\'name\': \'Coatl aux écailles de sapience\', \'text\': \'À chaque fois que vous piochez une carte, mettez un marqueur +1/+1 sur le Coatl aux écailles de sapience.\', \'type\': \'Créature : serpent\', \'flavor\': "« L\'illumination que je n\'ai jamais pu saisir dans l\'étherium, je l\'ai trouvée tracée dans les écailles du coatl. »\\n—Ranalus, hérétique vedalken", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486321&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6a266685-bd23-4360-949d-1c899a0427ae\', \'multiverseId\': 486321}, \'multiverseid\': 486321}, {\'name\': \'Coatl dalle Scaglie Sapienti\', \'text\': \'Ogniqualvolta peschi una carta, metti un segnalino +1/+1 sul Coatl dalle Scaglie Sapienti.\', \'type\': \'Creatura — Serpente\', \'flavor\': \'"L\\\'illuminazione che non ho mai trovato nell\\\'eterium l\\\'ho rintracciata nelle scaglie dei coatl."\\n—Ranalus, eretico vedalken\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486580&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cb764787-eff0-4e7b-869d-77b573a20670\', \'multiverseId\': 486580}, \'multiverseid\': 486580}, {\'name\': \'知識鱗のコアトル\', \'text\': \'あなたがカードを１枚引くたび、知識鱗のコアトルの上に＋１/＋１カウンターを１個置く。\', \'type\': \'クリーチャー — 蛇\', \'flavor\': \'「エーテリウムの中に見つけられなかった啓示を、コアトルの鱗を追うことで見つけることができたのだ。」\\n――ヴィダルケンの異端者、ラナラス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486839&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8b6346c5-b199-4a9b-8a4f-5dc4413fc63b\', \'multiverseId\': 486839}, \'multiverseid\': 486839}, {\'name\': \'명석비늘 코아틀\', \'text\': \'당신이 카드를 뽑을 때마다, 명석비늘 코아틀에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 뱀\', \'flavor\': \'"나는 에테리움에서 찾을 수 없었던 깨우침을 코아틀의 비늘에서 찾아냈다."\\n—베달켄 이단자, 라날루스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487098&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3955f9f8-5cf7-40e0-8e39-d781d84ebc7b\', \'multiverseId\': 487098}, \'multiverseid\': 487098}, {\'name\': \'Coatl das Escamas Sábias\', \'text\': \'Toda vez que comprar um card, coloque um marcador +1/+1 em Coatl das Escamas Sábias.\', \'type\': \'Criatura — Cobra\', \'flavor\': \'"A iluminação que nunca encontrei no etherium consegui encontrar traçada nas escamas do coatl."\\n— Ranalus, herege vedalkeano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487357&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'38e027b6-4bea-4dbe-9b7a-1300e282cda6\', \'multiverseId\': 487357}, \'multiverseid\': 487357}, {\'name\': \'Чешуемудрый Змей\', \'text\': \'Каждый раз, когда вы берете карту, положите один жетон +1/+1 на Чешуемудрого Змея.\', \'type\': \'Существо — Змея\', \'flavor\': \'«Я обнаружил, что знание, которое я так и не нашел в эфирии, оставило свой след в чешуе змеи».\\n— Реналус, ведалкен-отступник\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487616&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9945410e-ddad-4033-82bd-fc6cf19b0929\', \'multiverseId\': 487616}, \'multiverseid\': 487616}, {\'name\': \'鳞文寇特蛇\', \'text\': \'每当你抓一张牌时，在鳞文寇特蛇上放置一个+1/+1指示物。\', \'type\': \'生物 ～蛇\', \'flavor\': \'「我在乙金中从未找到的启示，却埋藏在寇特蛇的鳞片中。」\\n～维多肯异教徒拉那洛\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487875&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e93c7834-9597-4027-b4c7-301a7db74792\', \'multiverseId\': 487875}, \'multiverseid\': 487875}, {\'name\': \'鱗文寇特蛇\', \'text\': \'每當你抽一張牌時，在鱗文寇特蛇上放置一個+1/+1指示物。\', \'type\': \'生物 ～蛇\', \'flavor\': \'「我在乙金中從未找到的啟示，卻埋藏在寇特蛇的鱗片中。」\\n～維多肯異教徒拉那洛\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488134&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2e3b2637-0928-4b22-b681-3385e05ae5e5\', \'multiverseId\': 488134}, \'multiverseid\': 488134}]', '[{\'name\': \'Sagenumwobener Durchgang\', \'text\': \'{T}, opfere den Sagenumwobenen Durchgang: Durchsuche deine Bibliothek nach einer Standardland-Karte, bringe sie getappt ins Spiel und mische dann deine Bibliothek. Falls du dann vier oder mehr Länder kontrollierst, enttappe das Land.\', \'type\': \'Land\', \'flavor\': \'Von hier aus kann man den Pfad nach überall finden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485828&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bfeba7a5-e3ed-41c0-9c19-75ed9e8866fe\', \'multiverseId\': 485828}, \'multiverseid\': 485828}, {\'name\': \'Pasaje de leyenda\', \'text\': \'{T}, sacrificar el Pasaje de leyenda: Busca en tu biblioteca una carta de tierra básica, ponla en el campo de batalla girada y luego baraja tu biblioteca. Luego, si controlas cuatro o más tierras, endereza esa tierra.\', \'type\': \'Tierra\', \'flavor\': \'Desde aquí se puede encontrar el camino a cualquier lugar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486087&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fe1c99a9-9395-4013-a849-9a4d10a1b6a9\', \'multiverseId\': 486087}, \'multiverseid\': 486087}, {\'name\': \'Passage merveilleux\', \'text\': \'{T}, sacrifiez le Passage merveilleux : Cherchez dans votre bibliothèque une carte de terrain de base, mettez-la sur le champ de bataille engagée et mélangez ensuite votre bibliothèque. Puis, si vous contrôlez au moins quatre terrains, dégagez ce terrain.\', \'type\': \'Terrain\', \'flavor\': "D\'ici, vous pouvez trouver un chemin menant partout.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486346&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f81e7535-33b9-4cd1-8b60-b17b055535f7\', \'multiverseId\': 486346}, \'multiverseid\': 486346}, {\'name\': \'Passaggio Leggendario\', \'text\': \'{T}, Sacrifica il Passaggio Leggendario: Passa in rassegna il tuo grimorio per una carta terra base, mettila sul campo di battaglia TAPpata, poi rimescola il tuo grimorio. Poi, se controlli quattro o più terre, STAPpa quella terra.\', \'type\': \'Terra\', \'flavor\': \'Da qui si può trovare il sentiero per qualsiasi luogo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486605&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f19eac14-1f33-4bf6-8a0b-06d959f4a3e1\', \'multiverseId\': 486605}, \'multiverseid\': 486605}, {\'name\': \'寓話の小道\', \'text\': \'{T}, 寓話の小道を生け贄に捧げる：あなたのライブラリーから基本土地・カード１枚を探し、タップ状態で戦場に出し、その後あなたのライブラリーを切り直す。その後、あなたが土地を４つ以上コントロールしているなら、その土地をアンタップする。\', \'type\': \'土地\', \'flavor\': \'ここからなら、どこへ行く道でも見つかるかもしれない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486864&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'efa466a0-00ed-4822-84b5-24f6d191cbbc\', \'multiverseId\': 486864}, \'multiverseid\': 486864}, {\'name\': \'전설적인 통로\', \'text\': \'{T}, 전설적인 통로를 희생한다: 당신의 서고에서 기본 대지 카드 한 장을 찾아, 탭된 상태로 전장에 놓은 후, 당신의 서고를 섞는다. 그 후, 당신이 대지를 네 개 이상 조종한다면, 그 대지를 언탭한다.\', \'type\': \'대지\', \'flavor\': \'그곳에서부터는, 어디로 가는 길이든 찾을 수 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487123&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f5f379e4-7dca-453f-a0f9-74ec7f61d015\', \'multiverseId\': 487123}, \'multiverseid\': 487123}, {\'name\': \'Passagem Fabulosa\', \'text\': \'{T}, sacrifique Passagem Fabulosa: Procure um card de terreno básico em seu grimório, coloque-o no campo de batalha virado e depois embaralhe seu grimório. Se você controla quatro ou mais terrenos, desvire aquele terreno.\', \'type\': \'Terreno\', \'flavor\': \'Daqui é possível achar o caminho para qualquer lugar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487382&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b5a1f0e0-9d5d-4d32-b095-90d89bfc100b\', \'multiverseId\': 487382}, \'multiverseid\': 487382}, {\'name\': \'Сказочный Проход\', \'text\': \'{T}, пожертвуйте Сказочный Проход: найдите в вашей библиотеке карту базовой земли, положите ее на поле битвы повернутой, затем перетасуйте вашу библиотеку. Затем, если вы контролируете не менее четырех земель, разверните ту землю.\', \'type\': \'Земля\', \'flavor\': \'Отсюда можно найти дорогу куда угодно.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487641&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ce7f015a-0bc2-4e7b-9e60-9be9bb09b702\', \'multiverseId\': 487641}, \'multiverseid\': 487641}, {\'name\': \'神奇小径\', \'text\': \'{T}，牺牲神奇小径：从你的牌库中搜寻一张基本地牌，将之横置放进战场，然后将你的牌库洗牌。然后如果你操控四个或更多地，则重置该地。\', \'type\': \'地\', \'flavor\': \'此处密径错杂，寻对道路便可通达八方。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487900&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b4359ec7-4aef-45f9-a742-bb1ff0678135\', \'multiverseId\': 487900}, \'multiverseid\': 487900}, {\'name\': \'神奇小徑\', \'text\': \'{T}，犧牲神奇小徑：從你的牌庫中搜尋一張基本地牌，將之橫置放進戰場，然後將你的牌庫洗牌。然後如果你操控四個或更多地，則重置該地。\', \'type\': \'地\', \'flavor\': \'此處密徑錯雜，尋對道路便可通達八方。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488159&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f3888b79-8c52-4b78-a13c-a72717e435fa\', \'multiverseId\': 488159}, \'multiverseid\': 488159}]', '[{\'name\': \'Salve volcanique\', \'text\': "Ce sort coûte {X} de moins à lancer, X étant la force totale des créatures que vous contrôlez.\\nCiblez jusqu\'à deux cibles, créatures et/ou planeswalkers. La Salve volcanique leur inflige 6 blessures à chacune.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488322&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c09e4f2a-1495-44c2-9837-6b2d2d26f3a7\', \'multiverseId\': 488322}, \'multiverseid\': 488322}, {\'name\': \'一斉噴火\', \'text\': \'この呪文を唱えるためのコストは{X}少なくなる。Ｘはあなたがコントロールしているクリーチャーのパワーの合計に等しい。\\nクリーチャーやプレインズウォーカー合わせて最大２体を対象とする。一斉噴火はそれらにそれぞれ６点のダメージを与える。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488374&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2284f2d4-eb6d-4f64-8d5a-191d733306cf\', \'multiverseId\': 488374}, \'multiverseid\': 488374}]', "[{'name': 'Sanctuaire animalier', 'text': '{T} : Ajoutez {C}.\\n{2}, {T} : Mettez un marqueur +1/+1 sur une cible, oiseau, chat, chien, chèvre, bovidé ou serpent.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488336&type=card', 'language': 'French', 'identifiers': {'scryfallId': '04922921-8401-4308-a26e-571ebfa1db61', 'multiverseId': 488336}, 'multiverseid': 488336}, {'name': '鳥獣保護区', 'text': '{T}：{C}を加える。\\n{2}, {T}：鳥１体か猫１体か犬１体かヤギ１体か雄牛１体か蛇１体を対象とし、それの上に＋１/＋１カウンターを１個置く。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488388&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'abb91bd5-ed8b-470f-9976-fcd15d71d4cd', 'multiverseId': 488388}, 'multiverseid': 488388}]", '[{\'name\': \'Sanctuaire du Grand Tout\', \'text\': "Au début de votre entretien, vous pouvez chercher dans votre bibliothèque et/ou votre cimetière une carte de reliquaire et la mettre sur le champ de bataille. Si vous cherchez dans votre bibliothèque de cette manière, mélangez-la.\\nSi une capacité d\'un autre reliquaire que vous contrôlez se déclenche pendant que vous contrôlez au moins six reliquaires, cette capacité se déclenche une fois de plus.", \'type\': \'Enchantement légendaire : reliquaire\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488332&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c5fe86b8-d5f2-4979-9285-7cc7ef76bc8b\', \'multiverseId\': 488332}, \'multiverseid\': 488332}, {\'name\': \'万物の聖域\', \'text\': \'あなたのアップキープの開始時に、あなたはあなたのライブラリーやあなたの墓地から祭殿・カード１枚を探し、戦場に出してもよい。これによりあなたがあなたのライブラリーからカードを探したなら、あなたのライブラリーを切り直す。\\nあなたが祭殿を６つ以上コントロールしている間に、他の、あなたがコントロールしている祭殿の能力が１つ誘発するなら、その能力は追加でもう１回誘発する。\', \'type\': \'伝説のエンチャント — 祭殿\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488384&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7ea1b7d8-6e77-43e8-a7c0-fb1eeeaac12c\', \'multiverseId\': 488384}, \'multiverseid\': 488384}]', '[{\'name\': \'Schiffswrackdurchsucher\', \'text\': \'Bravour (Immer wenn du einen Nichtkreatur-Zauberspruch wirkst, erhält diese Kreatur +1/+1 bis zum Ende des Zuges.)\\nWenn der Schiffswrackdurchsucher ins Spiel kommt, bringe eine Spontanzauber- oder Hexereikarte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Kreatur — Meervolk, Zauberer\', \'flavor\': \'Was auf See verloren ging, muss nicht für immer verloren bleiben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485653&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a02a7f6d-f92e-4b65-ba7d-9926acc2da35\', \'multiverseId\': 485653}, \'multiverseid\': 485653}, {\'name\': \'Zahorí de naufragios\', \'text\': \'Destreza. (Siempre que lances un hechizo que no sea de criatura, esta criatura obtiene +1/+1 hasta el final del turno.)\\nCuando el Zahorí de naufragios entre al campo de batalla, regresa la carta de instantáneo o de conjuro objetivo de tu cementerio a tu mano.\', \'type\': \'Criatura — Hechicero tritón\', \'flavor\': \'Perdido en el mar no quiere decir perdido para siempre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485912&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d7904bcf-fd25-48cb-bb64-811ecabb405e\', \'multiverseId\': 485912}, \'multiverseid\': 485912}, {\'name\': \'Sourcier des épaves\', \'text\': "Prouesse (À chaque fois que vous lancez un sort non-créature, cette créature gagne +1/+1 jusqu\'à la fin du tour.)\\nQuand le Sourcier des épaves arrive sur le champ de bataille, renvoyez une carte d\'éphémère ou de rituel ciblée depuis votre cimetière dans votre main.", \'type\': \'Créature : ondin et sorcier\', \'flavor\': \'Perdu en mer ne signifie pas perdu à jamais.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486171&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c563482c-090f-48a8-aeca-79f7e28267be\', \'multiverseId\': 486171}, \'multiverseid\': 486171}, {\'name\': \'Rabdomante dei Relitti\', \'text\': \'Prodezza (Ogniqualvolta lanci una magia non creatura, questa creatura prende +1/+1 fino alla fine del turno.)\\nQuando il Rabdomante dei Relitti entra nel campo di battaglia, riprendi in mano dal tuo cimitero una carta istantaneo o stregoneria bersaglio.\', \'type\': \'Creatura — Mago Tritone\', \'flavor\': \'Scomparire in mare non significa scomparire per sempre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486430&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e48bb628-6ac3-4872-94af-b0e9f0023a93\', \'multiverseId\': 486430}, \'multiverseid\': 486430}, {\'name\': \'難破船の探知者\', \'text\': \'果敢（あなたがクリーチャーでない呪文を唱えるたび、ターン終了時まで、このクリーチャーは＋１/＋１の修整を受ける。）\\n難破船の探知者が戦場に出たとき、あなたの墓地からインスタントかソーサリーであるカード１枚を対象とし、それをあなたの手札に戻す。\', \'type\': \'クリーチャー — マーフォーク・ウィザード\', \'flavor\': \'海で失った物が、永遠に失われるとは限らない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486689&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ef18b1e2-74d5-4319-84f1-4d93c0177b3c\', \'multiverseId\': 486689}, \'multiverseid\': 486689}, {\'name\': \'난파선 탐색꾼\', \'text\': \'기량 (당신이 생물이 아닌 주문을 발동할 때마다, 이 생물은 턴종료까지 +1/+1을 받는다.)\\n난파선 탐색꾼이 전장에 들어올 때, 당신의 무덤에 있는 순간마법 또는 집중마법 카드를 목표로 정한다. 그 카드를 당신의 손으로 되돌린다.\', \'type\': \'생물 — 인어 마법사\', \'flavor\': \'바다에서 잃어버리는 것이 영원히 잃어버리는 것을 의미하지는 않는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486948&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e1094d4b-a528-493f-8bd5-e5132ad98a46\', \'multiverseId\': 486948}, \'multiverseid\': 486948}, {\'name\': \'Vasculhador de Naufrágios\', \'text\': \'Destreza (Toda vez que você conjura uma mágica que não seja de criatura, esta criatura recebe +1/+1 até o final do turno.)\\nQuando Vasculhador de Naufrágios entrar no campo de batalha, devolva o card de mágica instantânea ou de feitiço alvo de seu cemitério para sua mão.\', \'type\': \'Criatura — Tritão Mago\', \'flavor\': \'Perdido no mar não significa perdido para sempre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487207&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ec53ee65-8577-4c69-8ccf-4eef5d2fdf0e\', \'multiverseId\': 487207}, \'multiverseid\': 487207}, {\'name\': \'Искатель Кораблекрушений\', \'text\': \'Искусность (Каждый раз, когда вы разыгрываете не являющееся существом заклинание, это существо получает +1/+1 до конца хода.)\\nКогда Искатель Кораблекрушений выходит на поле битвы, верните целевую карту мгновенного заклинания или волшебства из вашего кладбища в вашу руку.\', \'type\': \'Существо — Мерфолк Чародей\', \'flavor\': \'Пропасть в море — не значит пропасть навсегда.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487466&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c855c543-d270-476d-b2de-3f7a1daeedba\', \'multiverseId\': 487466}, \'multiverseid\': 487466}, {\'name\': \'船难探寻客\', \'text\': \'灵技（每当你施放非生物咒语时，此生物得+1/+1直到回合结束。）\\n当船难探寻客进战场时，将目标瞬间或法术牌从你的坟墓场移回你手上。\', \'type\': \'生物 ～人鱼／法术师\', \'flavor\': \'失落于海中不一定意味着无法再度寻得。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487725&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b2d95e4d-7e18-4507-a72b-e072d5a0dadc\', \'multiverseId\': 487725}, \'multiverseid\': 487725}, {\'name\': \'船難探尋客\', \'text\': \'靈技（每當你施放非生物咒語時，此生物得+1/+1直到回合結束。）\\n當船難探尋客進戰場時，將目標瞬間或巫術牌從你的墳墓場移回你手上。\', \'type\': \'生物 ～人魚／魔法師\', \'flavor\': \'失落於海中不一定意味著無法再度尋得。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487984&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3b0fe863-cf68-48cf-b50c-888479d77d5e\', \'multiverseId\': 487984}, \'multiverseid\': 487984}]', '[{\'name\': \'Schlachtrassel-Schamane\', \'text\': \'Zu Beginn des Kampfes in deinem Zug kannst du eine Kreatur deiner Wahl bis zum Ende des Zuges +2/+0 erhalten lassen.\', \'type\': \'Kreatur — Goblin, Schamane\', \'flavor\': \'Der Schamane rasselt nicht, um den Kampfgeist zu verstärken, sondern um die Schreie derjenigen zu übertönen, die vor den Eldrazi fliehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485712&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2545d11a-a9b5-41a7-84e4-72aa7911d9a0\', \'multiverseId\': 485712}, \'multiverseid\': 485712}, {\'name\': \'Chamán estertor de batalla\', \'text\': \'Al comienzo del combate en tu turno, puedes hacer que la criatura objetivo obtenga +2/+0 hasta el final del turno.\', \'type\': \'Criatura — Chamán trasgo\', \'flavor\': \'La chamán no grita para inspirar furia en la batalla, sino para ahogar los gritos de aquellos que huyen de los Eldrazi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485971&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'beedee14-0f3f-4824-b18b-704b320a7c1e\', \'multiverseId\': 485971}, \'multiverseid\': 485971}, {\'name\': \'Shamane à crécelle de guerre\', \'text\': "Au début du combat pendant votre tour, vous pouvez faire qu\'une créature ciblée gagne +2/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : gobelin et shamane\', \'flavor\': \'Le shamane agite sa crécelle non pas pour inspirer la furie au combat, mais pour couvrir les cris de ceux qui fuient les Eldrazi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486230&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'eac4e8e0-eb83-48c8-934c-194fc9db265a\', \'multiverseId\': 486230}, \'multiverseid\': 486230}, {\'name\': \'Sciamano del Sonaglio\', \'text\': "All\'inizio del combattimento nel tuo turno, puoi far prendere +2/+0 a una creatura bersaglio fino alla fine del turno.", \'type\': \'Creatura — Sciamano Goblin\', \'flavor\': \'Lo sciamano scuoteva il sonaglio non per infondere una furia guerriera ma per coprire le urla di quanti scappavano dagli Eldrazi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486489&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'187ba76e-b150-4032-856b-3cb20bab471b\', \'multiverseId\': 486489}, \'multiverseid\': 486489}, {\'name\': \'戦装飾のシャーマン\', \'text\': \'あなたのターンの戦闘の開始時に、クリーチャー１体を対象とする。あなたは「ターン終了時まで、それは＋２/＋０の修整を受ける。」を選んでもよい。\', \'type\': \'クリーチャー — ゴブリン・シャーマン\', \'flavor\': \'シャーマンが飾りを鳴らすのは、戦いの怒りを呼び起こすためではなく、エルドラージから逃げる者の悲鳴をかき消すためだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486748&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b1a284e6-1a85-4a99-9948-fc894d057f98\', \'multiverseId\': 486748}, \'multiverseid\': 486748}, {\'name\': \'전투딸깍이 주술사\', \'text\': \'당신 턴의 전투 시작에, 생물을 목표로 정한다. 당신은 그 생물이 턴종료까지 +2/+0을 받도록 할 수 있다.\', \'type\': \'생물 — 고블린 주술사\', \'flavor\': \'주술사는 다른 고블린들의 전의를 북돋으려는 게 아니라, 엘드라지에게서 도망치는 고블린들이 지르는 비명이 들리지 않도록 시끄러운 소리를 낸다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487007&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e360ca96-4e84-4f0c-9b31-3fbcd646ca18\', \'multiverseId\': 487007}, \'multiverseid\': 487007}, {\'name\': \'Xamã do Chocalho-de-guerra\', \'text\': \'No início do combate no seu turno, você pode fazer com que a criatura alvo receba +2/+0 até o final do turno.\', \'type\': \'Criatura — Goblin Xamã\', \'flavor\': \'O xamã usa seu chocalho não para inspirar uma fúria de batalha, mas para abafar os gritos daqueles que fogem dos Eldrazi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487266&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cb764f69-4e86-41af-85ef-de93cef8c95a\', \'multiverseId\': 487266}, \'multiverseid\': 487266}, {\'name\': \'Шаман с Боевой Трещоткой\', \'text\': \'В начале боя во время вашего хода вы можете дать целевому существу +2/+0 до конца хода.\', \'type\': \'Существо — Гоблин Шаман\', \'flavor\': \'Шаман бренчит не для того, чтобы вдохновить соплеменников на бой, а чтобы заглушить вопли тех, кто удирает от Эльдрази.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487525&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9bdde7de-b6f6-440d-a58b-c1738bc733b4\', \'multiverseId\': 487525}, \'multiverseid\': 487525}, {\'name\': \'战响祭师\', \'text\': \'在你回合的战斗开始时，你可以使目标生物得+2/+0直到回合结束。\', \'type\': \'生物 ～鬼怪／祭师\', \'flavor\': \'祭师发出的吵杂声音并不是用来激起战意，而是要盖掉那些被奥札奇吓跑者的尖叫。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487784&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5b2df9f4-dd03-43b6-967c-70bb1efa2839\', \'multiverseId\': 487784}, \'multiverseid\': 487784}, {\'name\': \'戰響祭師\', \'text\': \'在你回合的戰鬥開始時，你可以使目標生物得+2/+0直到回合結束。\', \'type\': \'生物 ～鬼怪／祭師\', \'flavor\': \'祭師發出的吵雜聲音並不是用來激起戰意，而是要蓋掉那些被奧札奇嚇跑者的尖叫。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488043&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b9933d3d-1365-408b-925e-3ad10abf3844\', \'multiverseId\': 488043}, \'multiverseid\': 488043}]', "[{'name': 'Schlechtes Geschäft', 'text': 'Du ziehst zwei Karten, und jeder Gegner wirft zwei Karten ab. Jeder Spieler verliert 2 Lebenspunkte.', 'type': 'Hexerei', 'flavor': 'Es gibt immer noch Orte, an denen ein Lächeln und ein Handschlag ausreichen, ein Geschäft abzuschließen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485671&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b66b43b8-0b3e-4ffb-9400-607881c178d3', 'multiverseId': 485671}, 'multiverseid': 485671}, {'name': 'Trato infame', 'text': 'Robas dos cartas y cada oponente descarta dos cartas. Cada jugador pierde 2 vidas.', 'type': 'Conjuro', 'flavor': 'Aún hay lugares donde una sonrisa y un apretón de manos son todo lo necesario para hacer un trato.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485930&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '33b3591e-0098-42fe-ad26-f64f35565161', 'multiverseId': 485930}, 'multiverseid': 485930}, {'name': 'Mauvais plan', 'text': 'Vous piochez deux cartes et chaque adversaire se défausse de deux cartes. Chaque joueur perd 2 points de vie.', 'type': 'Rituel', 'flavor': 'Il existe encore des endroits où un sourire et une poignée de main suffisent pour conclure un marché.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486189&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'efe4929b-5e5a-4134-8b43-90799082c8f2', 'multiverseId': 486189}, 'multiverseid': 486189}, {'name': 'Patto Scellerato', 'text': 'Peschi due carte e ogni avversario scarta due carte. Ogni giocatore perde 2 punti vita.', 'type': 'Stregoneria', 'flavor': 'Esistono ancora luoghi dove un sorriso e una stretta di mano sono tutto quel che serve per stringere un accordo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486448&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '2426164a-edeb-4730-89e1-3046dc4eac75', 'multiverseId': 486448}, 'multiverseid': 486448}, {'name': '悪い取引', 'text': 'あなたはカードを２枚引き、各対戦相手はそれぞれカード２枚を捨てる。各プレイヤーはそれぞれ２点のライフを失う。', 'type': 'ソーサリー', 'flavor': '今でも、笑顔と握手だけで取引が成立することがある。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486707&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f628c057-e62d-4193-80f0-94e7639102d1', 'multiverseId': 486707}, 'multiverseid': 486707}, {'name': '나쁜 거래', 'text': '당신은 카드 두 장을 뽑고 각 상대는 카드 두 장을 버린다. 각 플레이어는 생명 2점을 잃는다.', 'type': '집중마법', 'flavor': '미소와 악수가 거래를 하는 데에 필요한 전부인 곳이 아직도 존재하긴 한다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486966&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '97d5ed14-c472-4fba-bdcf-c0507b634ca7', 'multiverseId': 486966}, 'multiverseid': 486966}, {'name': 'Mau Negócio', 'text': 'Você compra dois cards e cada oponente descarta dois cards. Cada jogador perde 2 pontos de vida.', 'type': 'Feitiço', 'flavor': 'Ainda há lugares em que um sorriso e um aperto de mão são tudo de que você precisa para fechar um acordo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487225&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '4a5899c8-90be-4bb4-8e87-6b69c618ac14', 'multiverseId': 487225}, 'multiverseid': 487225}, {'name': 'Скверная Сделка', 'text': 'Вы берете две карты, а каждый оппонент сбрасывает по две карты. Каждый игрок теряет 2 жизни.', 'type': 'Волшебство', 'flavor': 'Еще остались места, где сделку можно скрепить улыбкой и рукопожатием.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487484&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '99953d76-78ed-4c9a-9167-64f3a1dda9d9', 'multiverseId': 487484}, 'multiverseid': 487484}, {'name': '恶质交易', 'text': '你抓两张牌且每位对手各弃两张牌。每位牌手各失去2点生命。', 'type': '法术', 'flavor': '幸好还有些地方只要露个脸、握个手就能够谈成交易。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487743&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c15c1a5d-31c7-4aea-916c-dee0c1c63944', 'multiverseId': 487743}, 'multiverseid': 487743}, {'name': '惡質交易', 'text': '你抽兩張牌且每位對手各棄兩張牌。每位玩家各失去2點生命。', 'type': '巫術', 'flavor': '幸好還有些地方只要露個臉、握個手就能夠談成交易。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488002&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'd4d0238e-bdf3-4782-88e5-edadb5a3f5c6', 'multiverseId': 488002}, 'multiverseid': 488002}]", '[{\'name\': \'Schlingenspinne\', \'text\': \'Reichweite (Diese Kreatur kann fliegende Kreaturen blocken.)\\nImmer wenn die Schlingenspinne eine fliegende Kreatur blockt, erhält die Schlingenspinne +2/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Spinne\', \'flavor\': \'„Wir sollten die Sceadas in die Netze über\\\'m Samokwäldchen locken. Nicht, dass die Spinnen hungrig werden."\\n—Aurelia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485789&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7b513dba-d105-4c87-9d25-f105fd6caf7d\', \'multiverseId\': 485789}, \'multiverseid\': 485789}, {\'name\': \'Tejetrampas\', \'text\': \'Alcance. (Esta criatura puede bloquear criaturas con la habilidad de volar.)\\nSiempre que la Tejetrampas bloquee a una criatura con la habilidad de volar, la Tejetrampas obtiene +2/+0 hasta el final del turno.\', \'type\': \'Criatura — Araña\', \'flavor\': \'"Atraigamos a los dracos a las redes de la Espesura de Samok. Las arañas se pondrán muy contentas".\\n—Aurelia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486048&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f682838e-834c-47f6-ac19-53663f460768\', \'multiverseId\': 486048}, \'multiverseid\': 486048}, {\'name\': \'Fileuse de collet\', \'text\': "Portée (Cette créature peut bloquer les créatures avec le vol.)\\nÀ chaque fois que la Fileuse de collet bloque une créature avec le vol, la Fileuse de collet gagne +2/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : araignée\', \'flavor\': \'« Attirons les drakôns vers les toiles qui surplombent la Position de Samok. Il faut maintenir les araignées de bonne humeur. »\\n—Aurélia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486307&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7ed391df-49f4-41ba-93e5-1be3fcccd55a\', \'multiverseId\': 486307}, \'multiverseid\': 486307}, {\'name\': \'Tessitrappole\', \'text\': \'Raggiungere (Questa creatura può bloccare le creature con volare.)\\nOgniqualvolta il Tessitrappole blocca una creatura con volare, il Tessitrappole prende +2/+0 fino alla fine del turno.\', \'type\': \'Creatura — Ragno\', \'flavor\': \'"Attiriamo i draghetti nelle ragnatele sul Bosco Samok. I ragni ne saranno contenti."\\n—Aurelia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486566&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8a20df70-f5b7-496b-9a42-b8cd25b03520\', \'multiverseId\': 486566}, \'multiverseid\': 486566}, {\'name\': \'罠紡ぎ\', \'text\': \'到達（このクリーチャーは飛行を持つクリーチャーをブロックできる。）\\n罠紡ぎが飛行を持つクリーチャーを１体ブロックするたび、ターン終了時まで、罠紡ぎは＋２/＋０の修整を受ける。\', \'type\': \'クリーチャー — 蜘蛛\', \'flavor\': \'「ドレイクをサーモク木立の巣網に誘い込みましょう。蜘蛛たちを満足させてやらなくては。」\\n――オレリア\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486825&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'80cf2812-e0da-4822-b3e8-6d7debab8391\', \'multiverseId\': 486825}, \'multiverseid\': 486825}, {\'name\': \'올가미 방직거미\', \'text\': \'대공 (이 생물은 비행을 가진 생물을 방어할 수 있다.)\\n올가미 방직거미가 비행을 가진 생물을 방어할 때마다, 올가미 방직거미는 턴종료까지 +2/+0을 받는다.\', \'type\': \'생물 — 거미\', \'flavor\': \'"사목 스탠드 숲의 거미줄로 드레이크들을 유인해라. 거미들을 만족시켜 주도록."\\n—아우렐리아\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487084&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a8421cb9-8112-4913-b9bd-04cbb9b7be70\', \'multiverseId\': 487084}, \'multiverseid\': 487084}, {\'name\': \'Tecedora de Ardis\', \'text\': \'Alcance (Esta criatura pode bloquear criaturas com voar.)\\nToda vez que Tecedora de Ardis bloqueia uma criatura com voar, Tecedora de Ardis recebe +2/+0 até o final do turno.\', \'type\': \'Criatura — Aranha\', \'flavor\': \'"Vamos atrair os dragonetes para as teias no Arvoredo de Samok. Vamos manter as aranhas satisfeitas."\\n— Aurélia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487343&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1a827e98-5005-47b7-b94a-2c6cf05e951e\', \'multiverseId\': 487343}, \'multiverseid\': 487343}, {\'name\': \'Плетельщик Силков\', \'text\': \'Захват (Это существо может блокировать существа с Полетом.)\\nКаждый раз, когда Плетельщик Силков блокирует существо с Полетом, Плетельщик Силков получает +2/+0 до конца хода.\', \'type\': \'Существо — Паук\', \'flavor\': \'«Заманим дрейков в паутину над Самокским лесом. Пусть пауки порадуются».\\n— Аурелия\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487602&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6f6f9b66-f5a7-4443-a9a5-2c524080b283\', \'multiverseId\': 487602}, \'multiverseid\': 487602}, {\'name\': \'织陷蛛\', \'text\': \'延势（此生物能阻挡具飞行异能的生物。）\\n每当织陷蛛阻挡一个具飞行异能的生物时，织陷蛛得+2/+0直到回合结束。\', \'type\': \'生物 ～蜘蛛\', \'flavor\': \'「我们去把龙兽都引到撒莫林的蛛网那里。让蜘蛛们饱餐一顿。」\\n～欧瑞梨\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487861&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'14fe8057-b8ce-4dd8-b00c-f71c2f64b139\', \'multiverseId\': 487861}, \'multiverseid\': 487861}, {\'name\': \'織陷蛛\', \'text\': \'延勢（此生物能阻擋具飛行異能的生物。）\\n每當織陷蛛阻擋一個具飛行異能的生物時，織陷蛛得+2/+0直到回合結束。\', \'type\': \'生物 ～蜘蛛\', \'flavor\': \'「我們去把龍獸都引到撒莫林的蛛網那裡。讓蜘蛛們飽餐一頓。」\\n～歐瑞梨\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488120&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'97f7ce79-4ef0-457f-8cc7-46c3db665fc0\', \'multiverseId\': 488120}, \'multiverseid\': 488120}]', '[{\'name\': \'Schlummerndes Tyrannodon\', \'text\': \'Verteidiger (Diese Kreatur kann nicht angreifen.)\\nSolange du eine Kreatur mit Stärke 4 oder mehr kontrollierst, kann das Schlummernde Tyrannodon angreifen, als ob es nicht Verteidiger hätte.\', \'type\': \'Kreatur — Dinosaurier\', \'flavor\': \'Was die Jäger für ein warnendes Knurren hielten, entpuppte sich als nichts weiter als ein monströses Schnarchen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485760&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'68d2c394-1b56-44d4-9353-31142ad9b3c4\', \'multiverseId\': 485760}, \'multiverseid\': 485760}, {\'name\': \'Tiranodón soñoliento\', \'text\': \'Defensor. (Esta criatura no puede atacar.)\\nMientras controles una criatura con fuerza de 4 o más, el Tiranodón soñoliento puede atacar como si no tuviera la habilidad de defensor.\', \'type\': \'Criatura — Dinosaurio\', \'flavor\': \'Los guardabosques creían que eran gruñidos de advertencia, pero al final resultaron ser solo unos ronquidos monstruosos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486019&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a2eeb66c-cdbe-4ec6-aecf-2062c5e752c8\', \'multiverseId\': 486019}, \'multiverseid\': 486019}, {\'name\': \'Tyrannodon somnolant\', \'text\': "Défenseur (Cette créature ne peut pas attaquer.)\\nTant que vous contrôlez une créature de force supérieure ou égale à 4, le Tyrannodon somnolant peut attaquer comme s\'il n\'avait pas le défenseur.", \'type\': \'Créature : dinosaure\', \'flavor\': "Les rangers croyaient qu\'il s\'agissait de grognements d\'avertissement, mais ce n\'était en fait que des ronflements monstrueux.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486278&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'561f2ad2-b2b0-4127-8936-f4ef645b0f9d\', \'multiverseId\': 486278}, \'multiverseid\': 486278}, {\'name\': \'Tirannodonte Addormentato\', \'text\': \'Difensore (Questa creatura non può attaccare.)\\nFintanto che controlli una creatura con forza pari o superiore a 4, il Tirannodonte Addormentato può attaccare come se non avesse difensore.\', \'type\': \'Creatura — Dinosauro\', \'flavor\': \'Quelli che i ranger scambiarono per ruggiti di avvertimento si rivelarono essere un mostruoso russare.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486537&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fbb9b3aa-c259-494c-9a9e-27488dde8c87\', \'multiverseId\': 486537}, \'multiverseid\': 486537}, {\'name\': \'うたた寝するティラノドン\', \'text\': \'防衛（このクリーチャーでは攻撃できない。）\\nあなたがパワーが４以上のクリーチャーをコントロールしているかぎり、うたた寝するティラノドンは、これが防衛を持たないかのように攻撃できる。\', \'type\': \'クリーチャー — 恐竜\', \'flavor\': \'レインジャーたちが威嚇の唸り声だと考えたものは、単なる大いびきに過ぎなかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486796&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'906eca1b-d7a3-431f-9153-1f5f8dcb11fb\', \'multiverseId\': 486796}, \'multiverseid\': 486796}, {\'name\': \'졸고 있는 티라노돈\', \'text\': \'수비태세 (이 생물은 공격할 수 없다.)\\n당신이 공격력이 4 이상인 생물을 조종하는 한, 졸고 있는 티라노돈은 수비태세를 가지지 않은 것처럼 공격할 수 있다.\', \'type\': \'생물 — 공룡\', \'flavor\': \'수색대원들이 경고를 하며 으르렁거리는 것이라고 생각했던 소리는 엄청나게 큰 코골이에 불과한 것으로 드러났다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487055&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'92a290a0-9f92-41b8-b99c-23551d4eee1b\', \'multiverseId\': 487055}, \'multiverseid\': 487055}, {\'name\': \'Tiranodonte Adormentado\', \'text\': \'Defensor (Esta criatura não pode atacar.)\\nEnquanto você controlar uma criatura com poder igual ou superior a 4, Tiranodonte Adormentado pode atacar como se não tivesse defensor.\', \'type\': \'Criatura — Dinossauro\', \'flavor\': \'O que os patrulheiros acharam que fossem rosnados de advertência se revelaram nada mais que uma roncadeira monstruosa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487314&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'deb742b3-116d-4d83-b3f7-2c797217bfae\', \'multiverseId\': 487314}, \'multiverseid\': 487314}, {\'name\': \'Дремлющий Тираннодон\', \'text\': \'Защитник (Это существо не может атаковать.)\\nПока вы контролируете существо с силой 4 или больше, Дремлющий Тираннодон может атаковать, как если бы у него не было способности Защитника.\', \'type\': \'Существо — Динозавр\', \'flavor\': \'То, что следопыты принимали за предупреждающий рык, оказалось просто оглушительным храпом.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487573&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cfd5e47f-c275-4644-97c3-9564edc9280b\', \'multiverseId\': 487573}, \'multiverseid\': 487573}, {\'name\': \'昏睡暴伟龙\', \'text\': \'守军（此生物不能攻击。）\\n只要你操控力量等于或大于4的生物，昏睡暴伟龙便能视同不具守军异能地进行攻击。\', \'type\': \'生物 ～恐龙\', \'flavor\': \'原本护林人当作是警告的低沉吼声，后来发现不过是怪兽的熟睡鼾音。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487832&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bf81ae37-ba9b-4c14-aa12-0dfd8d3f6a0b\', \'multiverseId\': 487832}, \'multiverseid\': 487832}, {\'name\': \'昏睡暴偉龍\', \'text\': \'守軍（此生物不能攻擊。）\\n只要你操控力量等於或大於4的生物，昏睡暴偉龍便能視同不具守軍異能地進行攻擊。\', \'type\': \'生物 ～恐龍\', \'flavor\': \'原本護林人當作是警告的低沉吼聲，後來發現不過是怪獸的熟睡鼾音。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488091&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7b697033-336d-4a5f-a0ec-873971ecd470\', \'multiverseId\': 488091}, \'multiverseid\': 488091}]', '[{\'name\': \'Schock\', \'text\': \'Der Schock fügt einem Ziel deiner Wahl 2 Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Das Schöne daran ist, dass sie ihn nie kommen sehen. Niemals."\\n—Razzix, Funkenmagier\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485741&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'75b268d8-a93a-42d1-a3b3-2724edd3553a\', \'multiverseId\': 485741}, \'multiverseid\': 485741}, {\'name\': \'Choque\', \'text\': \'El Choque hace 2 puntos de daño a cualquier objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Lo hermoso que tiene es que nunca lo ven venir. Nunca".\\n—Rázzix, magochispa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486000&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'40511d8d-5cb8-4785-97eb-6b4d797b6c9d\', \'multiverseId\': 486000}, \'multiverseid\': 486000}, {\'name\': \'Choc\', \'text\': "Le Choc inflige 2 blessures à n\'importe quelle cible.", \'type\': \'Éphémère\', \'flavor\': "« Le plus beau, c\'est qu\'ils ne le voient jamais venir. Jamais. »\\n—Razzix, étincemage", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486259&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'76ba47a3-6e39-4640-9133-56d4ead0ea8d\', \'multiverseId\': 486259}, \'multiverseid\': 486259}, {\'name\': \'Shock\', \'text\': \'Lo Shock infligge 2 danni a un qualsiasi bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"La cosa bella è che non se lo aspettano. Mai."\\n—Razzix, magoscintilla\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486518&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'34e96176-08c2-4eac-94c8-beefd55f8e21\', \'multiverseId\': 486518}, \'multiverseid\': 486518}, {\'name\': \'ショック\', \'text\': \'クリーチャー１体かプレインズウォーカー１体かプレイヤー１人を対象とする。ショックはそれに２点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'「その美しさは、それが飛んでくるのが見えないってことだな。絶対に。」\\n――火花魔道士、ラジックス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486777&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d65af119-48ad-43de-9918-0882a2119421\', \'multiverseId\': 486777}, \'multiverseid\': 486777}, {\'name\': \'충격\', \'text\': \'원하는 목표를 정한다. 충격은 그 목표에게 피해 2점을 입힌다.\', \'type\': \'순간마법\', \'flavor\': \'"이 주문의 장점은 아무도 이걸 예상하지 못한다는 거야. 절대로."\\n—번개마도사, 라직스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487036&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8a2f2dc8-60b5-4bd3-b07b-2bc9b745493c\', \'multiverseId\': 487036}, \'multiverseid\': 487036}, {\'name\': \'Choque\', \'text\': \'Choque causa 2 pontos de dano a qualquer alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"O melhor de tudo é que eles são sempre pegos desprevenidos. Sempre."\\n— Razzix, mago de centelhas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487295&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b253a43f-22fe-4c7e-a1d1-bee388539d16\', \'multiverseId\': 487295}, \'multiverseid\': 487295}, {\'name\': \'Шок\', \'text\': \'Шок наносит 2 повреждения любой цели.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Вся прелесть в том, что его не ждут. Никогда».\\n— Раззикс, электромаг\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487554&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f06548e2-55cb-4f9e-859c-75bc4e22b5c0\', \'multiverseId\': 487554}, \'multiverseid\': 487554}, {\'name\': \'电震\', \'text\': \'电震对任意一个目标造成2点伤害。\', \'type\': \'瞬间\', \'flavor\': \'「最令人激赏的一点，是他们完全浑然不知。完完全全。」\\n～火花法师剌极\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487813&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'483da521-8201-469d-a696-978b3e216e7e\', \'multiverseId\': 487813}, \'multiverseid\': 487813}, {\'name\': \'電震\', \'text\': \'電震對任意一個目標造成2點傷害。\', \'type\': \'瞬間\', \'flavor\': \'「最令人激賞的一點，是他們完全渾然不知。完完全全。」\\n～火花法師剌極\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488072&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9ceb4dfc-48b0-4fac-81f5-2322ea4aef81\', \'multiverseId\': 488072}, \'multiverseid\': 488072}]', '[{\'name\': \'Schrecken der Gipfel\', \'text\': \'Fliegend\\nZaubersprüche, die deine Gegner wirken und die den Schrecken der Gipfel als Ziel haben, kosten beim Wirken zusätzlich 3 Lebenspunkte.\\nImmer wenn eine andere Kreatur unter deiner Kontrolle ins Spiel kommt, fügt der Schrecken der Gipfel einem Ziel deiner Wahl Schadenspunkte in Höhe der Stärke der Kreatur zu.\', \'type\': \'Kreatur — Drache\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485746&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b02af1c8-7313-4395-bf7c-e7a54345d204\', \'multiverseId\': 485746}, \'multiverseid\': 485746}, {\'name\': \'Terror de las cimas\', \'text\': \'Vuela.\\nA tus oponentes les cuesta 3 vidas adicionales lanzar hechizos que hagan objetivo al Terror de las cimas.\\nSiempre que otra criatura entre al campo de batalla bajo tu control, el Terror de las cimas hace una cantidad de daño igual a la fuerza de esa criatura a cualquier objetivo.\', \'type\': \'Criatura — Dragón\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486005&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'777776e5-b9f2-4eb3-b7de-287ddde0d821\', \'multiverseId\': 486005}, \'multiverseid\': 486005}, {\'name\': \'Terreur des pics\', \'text\': "Vol\\nLes sorts que vos adversaires lancent qui ciblent la Terreur des pics coûtent 3 points de vie supplémentaires à lancer.\\nÀ chaque fois qu\'une autre créature arrive sur le champ de bataille sous votre contrôle, la Terreur des pics inflige à n\'importe quelle cible un nombre de blessures égal à la force de cette créature.", \'type\': \'Créature : dragon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486264&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d25ceffb-70f2-4084-9c3d-b9562f659b2b\', \'multiverseId\': 486264}, \'multiverseid\': 486264}, {\'name\': \'Terrore delle Vette\', \'text\': "Volare\\nLe magie che i tuoi avversari lanciano e che bersagliano il Terrore delle Vette costano 3 punti vita addizionali per essere lanciate.\\nOgniqualvolta un\'altra creatura entra nel campo di battaglia sotto il tuo controllo, il Terrore delle Vette infligge danno pari alla forza di quella creatura a un qualsiasi bersaglio.", \'type\': \'Creatura — Drago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486523&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e89b148e-def6-4fdb-8045-3f6856bab530\', \'multiverseId\': 486523}, \'multiverseid\': 486523}, {\'name\': \'峰の恐怖\', \'text\': \'飛行\\n対戦相手が峰の恐怖を対象として呪文を唱えるためのコストはライフ３点だけ多くなる。\\n他のクリーチャーが１体あなたのコントロール下で戦場に出るたび、クリーチャー１体かプレインズウォーカー１体かプレイヤー１人を対象とする。峰の恐怖はそれに、その戦場に出たクリーチャーのパワーに等しい点数のダメージを与える。\', \'type\': \'クリーチャー — ドラゴン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486782&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'41f09f8b-96c7-45cb-8230-1a7f8eb3aa01\', \'multiverseId\': 486782}, \'multiverseid\': 486782}, {\'name\': \'산봉우리의 공포\', \'text\': \'비행\\n당신의 상대들이 산봉우리의 공포를 목표로 발동하는 주문들은 발동하는 데 추가로 생명 3점이 든다.\\n다른 생물이 당신의 조종하에 전장에 들어올 때마다, 원하는 목표를 정한다. 산봉우리의 공포는 그 목표에게 그 생물의 공격력만큼 피해를 입힌다.\', \'type\': \'생물 — 용\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487041&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'66cac3f6-27a0-4fb5-be07-4f1a1c13653d\', \'multiverseId\': 487041}, \'multiverseid\': 487041}, {\'name\': \'Terror dos Picos\', \'text\': \'Voar\\nAs mágicas que seus oponentes conjuram com Terror dos Picos como alvo custam 3 pontos de vida adicionais para serem conjuradas.\\nToda vez que outra criatura entra no campo de batalha sob seu controle, Terror dos Picos causa a qualquer alvo dano igual ao poder daquela criatura.\', \'type\': \'Criatura — Dragão\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487300&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'30325bae-1827-4ec1-8788-76f87a7405fc\', \'multiverseId\': 487300}, \'multiverseid\': 487300}, {\'name\': \'Ужас Вершин\', \'text\': \'Полет\\nРазыгрывание вашими оппонентами заклинаний, целью которых является Ужас Вершин, стоит дополнительные 3 жизни.\\nКаждый раз, когда другое существо выходит на поле битвы под вашим контролем, Ужас Вершин наносит повреждения, равные силе того существа, любой цели.\', \'type\': \'Существо — Дракон\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487559&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'057a63b2-27aa-4296-8d6c-a50839a256c5\', \'multiverseId\': 487559}, \'multiverseid\': 487559}, {\'name\': \'峰顶惧龙\', \'text\': \'飞行\\n对手施放之以峰顶惧龙为目标的咒语须额外支付3点生命来施放。\\n每当另一个生物在你的操控下进战场时，峰顶惧龙对任意一个目标造成伤害，其数量等同于进战场生物之力量。\', \'type\': \'生物 ～龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487818&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3de08fb9-1258-409c-abcb-b6ed3ebf2844\', \'multiverseId\': 487818}, \'multiverseid\': 487818}, {\'name\': \'峰頂懼龍\', \'text\': \'飛行\\n對手施放之以峰頂懼龍為目標的咒語須額外支付3點生命來施放。\\n每當另一個生物在你的操控下進戰場時，峰頂懼龍對任意一個目標造成傷害，其數量等同於進戰場生物之力量。\', \'type\': \'生物 ～龍\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488077&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5c70f8c5-33b9-4332-b829-54164ee9edfb\', \'multiverseId\': 488077}, \'multiverseid\': 488077}]', '[{\'name\': \'Schreckensflotten-Kriegstreiber\', \'text\': \'Zu Beginn des Kampfes in deinem Zug kannst du eine andere Kreatur opfern. Falls du dies tust, erhält der Schreckensflotten-Kriegstreiber +2/+2 und verursacht Trampelschaden bis zum Ende des Zuges. (Er kann überschüssigen Kampfschaden dem verteidigenden Spieler oder Planeswalker zufügen.)\', \'type\': \'Kreatur — Ork, Pirat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485799&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e938b775-a6aa-4d3d-af68-d71996d4f988\', \'multiverseId\': 485799}, \'multiverseid\': 485799}, {\'name\': \'Belicista de la Flota Arrasadora\', \'text\': \'Al comienzo del combate en tu turno, puedes sacrificar otra criatura. Si lo haces, el Belicista de la Flota Arrasadora obtiene +2/+2 y gana la habilidad de arrollar hasta el final del turno. (Puede hacer el daño de combate sobrante al jugador o planeswalker al que ataca.)\', \'type\': \'Criatura — Pirata orco\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486058&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'be3798ba-cf2a-4071-93da-a3977eb9c87f\', \'multiverseId\': 486058}, \'multiverseid\': 486058}, {\'name\': \'Belliciste de la Flotte implacable\', \'text\': "Au début du combat pendant votre tour, vous pouvez sacrifier une autre créature. Si vous faites ainsi, le Belliciste de la Flotte implacable gagne +2/+2 et acquiert le piétinement jusqu\'à la fin du tour. (Il peut infliger son surplus de blessures de combat au joueur ou au planeswalker qu\'il attaque.)", \'type\': \'Créature : orque et pirate\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486317&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3a99ca1d-7e8e-4e31-9b33-5964dd36d91a\', \'multiverseId\': 486317}, \'multiverseid\': 486317}, {\'name\': \'Attaccabrighe della Flotta Funesta\', \'text\': "All\'inizio del combattimento nel tuo turno, puoi sacrificare un\'altra creatura. Se lo fai, l\'Attaccabrighe della Flotta Funesta prende +2/+2 e ha travolgere fino alla fine del turno. (Può infliggere il danno da combattimento in eccesso al giocatore o al planeswalker che sta attaccando.)", \'type\': \'Creatura — Pirata Orco\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486576&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7edd199e-df55-4009-b113-bfb10bab5867\', \'multiverseId\': 486576}, \'multiverseid\': 486576}, {\'name\': \'凶兆艦隊の戦争屋\', \'text\': \'あなたのターンの戦闘の開始時に、あなたは他のクリーチャー１体を生け贄に捧げてもよい。そうしたなら、ターン終了時まで、凶兆艦隊の戦争屋は＋２/＋２の修整を受けトランプルを得る。（これは余剰の戦闘ダメージを、これが攻撃しているプレイヤーかプレインズウォーカーに与えることができる。）\', \'type\': \'クリーチャー — オーク・海賊\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486835&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d4294a77-5e0e-4da6-b0ac-7f318e1d5e7a\', \'multiverseId\': 486835}, \'multiverseid\': 486835}, {\'name\': \'다이어 선단 전쟁광\', \'text\': \'당신의 턴 전투시작에, 당신은 다른 생물 한 개를 희생할 수 있다. 그렇게 한다면, 다이어 선단 전쟁광은 턴종료까지 +2/+2를 받고 돌진을 얻는다. (이 생물은 여분의 전투피해를 공격 중인 플레이어 또는 플레인즈워커에게 입힐 수 있다.)\', \'type\': \'생물 — 오크 해적\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487094&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b99b8db9-d426-4acb-bed6-c00c9b8b15af\', \'multiverseId\': 487094}, \'multiverseid\': 487094}, {\'name\': \'Belicista da Frota Macabra\', \'text\': \'No início do combate no seu turno, você pode sacrificar outra criatura. Se fizer isso, Belicista da Frota Macabra recebe +2/+2 e ganha atropelar até o final do turno. (Ele pode causar seu dano de combate excedente ao jogador ou planeswalker que ele estiver atacando.)\', \'type\': \'Criatura — Orc Pirata\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487353&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e97c3030-d3a5-40bb-a47d-b714b2099d5d\', \'multiverseId\': 487353}, \'multiverseid\': 487353}, {\'name\': \'Вояка Лютой Флотилии\', \'text\': "В начале боя во время вашего хода вы можете пожертвовать другое существо. Если вы это делаете, то Вояка Лютой Флотилии получает +2/+2 и Пробивной удар до конца хода. (Он может нанести избыточные боевые повреждения игроку или planeswalker\'у, которого атакует.)", \'type\': \'Существо — Орк Пират\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487612&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d6bce2ef-9ad1-45ef-b854-382aac45470b\', \'multiverseId\': 487612}, \'multiverseid\': 487612}, {\'name\': \'焦炬舰队好战者\', \'text\': \'在你回合的战斗开始时，你可以牺牲另一个生物。若你如此作，则直到回合结束，焦炬舰队好战者得+2/+2且获得践踏异能。（它造成之过量战斗伤害能对所攻击的牌手或鹏洛客造成之。）\', \'type\': \'生物 ～半兽人／海盗\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487871&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5b13c30a-27cc-4722-b49a-0b87dd690294\', \'multiverseId\': 487871}, \'multiverseid\': 487871}, {\'name\': \'焦炬艦隊好戰者\', \'text\': \'在你回合的戰鬥開始時，你可以犧牲另一個生物。若你如此作，則直到回合結束，焦炬艦隊好戰者得+2/+2且獲得踐踏異能。（它造成之過量戰鬥傷害能對所攻擊的玩家或鵬洛客造成之。）\', \'type\': \'生物 ～半獸人／海盜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488130&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f0ccde67-8922-406e-a9f2-4cfcf64b6b91\', \'multiverseId\': 488130}, \'multiverseid\': 488130}]', '[{\'name\': \'Schwelgende Patrizierin\', \'text\': \'Fliegend\\nLebensverknüpfung (Schaden, der von dieser Kreatur zugefügt wird, lässt dich entsprechend viele Lebenspunkte dazuerhalten.)\\nZu Beginn deines Endsegments und falls du in diesem Zug 3 oder mehr Lebenspunkte dazuerhalten hast, verliert jeder Gegner 3 Lebenspunkte.\', \'type\': \'Kreatur — Vampir, Adliger\', \'flavor\': \'„Erst mal nur ein wenig knabbern. Ich möchte mir doch nicht den Appetit verderben."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485801&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'39f77d2f-c2ac-49c0-bf76-262226dbcfb9\', \'multiverseId\': 485801}, \'multiverseid\': 485801}, {\'name\': \'Aristócrata saciada\', \'text\': \'Vuela.\\nVínculo vital. (El daño hecho por esta criatura también hace que ganes esa misma cantidad de vidas.)\\nAl comienzo de tu paso final, si ganaste 3 o más vidas este turno, cada oponente pierde 3 vidas.\', \'type\': \'Criatura — Noble vampiro\', \'flavor\': \'"De momento es solo un tentempié. No quiero perder el apetito".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486060&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7158e2a1-3e88-4e53-994c-c1a68e5bcf74\', \'multiverseId\': 486060}, \'multiverseid\': 486060}, {\'name\': \'Patricienne indulgente\', \'text\': \'Vol\\nLien de vie (Les blessures infligées par cette créature vous font aussi gagner autant de points de vie.)\\nAu début de votre étape de fin, si vous avez gagné au moins 3 points de vie ce tour-ci, chaque adversaire perd 3 points de vie.\', \'type\': \'Créature : vampire et noble\', \'flavor\': "« Juste une gorgée pour le moment. Je ne voudrais pas me couper l\'appétit. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486319&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'58c90052-474b-4fa0-976b-d7e7bc8385a5\', \'multiverseId\': 486319}, \'multiverseid\': 486319}, {\'name\': \'Nobile Edonista\', \'text\': "Volare\\nLegame vitale (Il danno inflitto da questa creatura ti fa anche guadagnare altrettanti punti vita.)\\nAll\'inizio della tua sottofase finale, se hai guadagnato 3 o più punti vita in questo turno, ogni avversario perde 3 punti vita.", \'type\': \'Creatura — Nobile Vampiro\', \'flavor\': \'"Solo un assaggio, per ora. Non vorrei rovinarmi l\\\'appetito."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486578&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a3897491-e6cf-41dd-a191-b05f7f984154\', \'multiverseId\': 486578}, \'multiverseid\': 486578}, {\'name\': \'耽溺する貴族階級\', \'text\': \'飛行\\n絆魂（このクリーチャーがダメージを与えると、さらにあなたはその点数分のライフを得る。）\\nあなたの終了ステップの開始時に、このターンにあなたがライフを３点以上得ていた場合、各対戦相手はそれぞれ３点のライフを失う。\', \'type\': \'クリーチャー — 吸血鬼・貴族\', \'flavor\': \'「今は一口にしておきましょう。食欲が無くなるといけないから。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486837&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bd9b5e22-431b-4aa1-85f5-dc401af778bb\', \'multiverseId\': 486837}, \'multiverseid\': 486837}, {\'name\': \'제멋대로인 귀부인\', \'text\': \'비행\\n생명연결 (이 생물이 피해를 입히면, 당신은 그 피해만큼의 생명점을 얻는다.)\\n당신의 종료단 시작에, 당신이 이번 턴에 생명 3점 이상을 얻었다면, 각 상대는 생명 3점을 잃는다.\', \'type\': \'생물 — 흡혈귀 귀족\', \'flavor\': \'"지금은 맛만 보는 거야. 식욕을 잃고 싶진 않거든."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487096&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ec3d7a47-2c6f-40ab-9e49-7fdf8dd59eea\', \'multiverseId\': 487096}, \'multiverseid\': 487096}, {\'name\': \'Aristocrata Indulgente\', \'text\': \'Voar\\nVínculo com a vida (O dano causado por esta criatura também faz com que você ganhe uma quantidade equivalente de pontos de vida.)\\nNo início de sua etapa final, se você ganhou 3 ou mais pontos de vida neste turno, cada oponente perde 3 pontos de vida.\', \'type\': \'Criatura — Vampiro Nobre\', \'flavor\': \'"Só um petisquinho por enquanto. Não quero ficar sem apetite."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487355&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'be1f001f-defb-4f6b-810c-244140ede8e9\', \'multiverseId\': 487355}, \'multiverseid\': 487355}, {\'name\': \'Избалованная Аристократка\', \'text\': \'Полет\\nЦепь жизни (Повреждения, наносимые этим существом, также заставляют вас получить такое же количество жизней.)\\nВ начале вашего заключительного шага, если в этом ходу вы получили 3 или более жизней, каждый оппонент теряет 3 жизни.\', \'type\': \'Существо — Вампир Аристократ\', \'flavor\': \'«Разве что совсем чуть-чуть. Не хочу испортить аппетит».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487614&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bba56362-3800-4d5e-9d1d-f88130abadb6\', \'multiverseId\': 487614}, \'multiverseid\': 487614}, {\'name\': \'恣纵显贵\', \'text\': \'飞行\\n系命（此生物所造成的伤害会让你获得等量的生命。）\\n在你的结束步骤开始时，若你本回合中获得了3点或更多生命，则每位对手各失去3点生命。\', \'type\': \'生物 ～吸血鬼／贵族\', \'flavor\': \'「现在啜饮一口就好。我可不想坏了胃口。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487873&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'211262d5-373e-4087-af74-b7b1de03c2e2\', \'multiverseId\': 487873}, \'multiverseid\': 487873}, {\'name\': \'恣縱顯貴\', \'text\': \'飛行\\n繫命（此生物所造成的傷害會讓你獲得等量的生命。）\\n在你的結束步驟開始時，若你本回合中獲得了3點或更多生命，則每位對手各失去3點生命。\', \'type\': \'生物 ～吸血鬼／貴族\', \'flavor\': \'「現在啜飲一口就好。我可不想壞了胃口。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488132&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f348f445-6a25-43a7-b54e-85c71d21512c\', \'multiverseId\': 488132}, \'multiverseid\': 488132}]', '[{\'name\': \'Seele versengen\', \'text\': \'Seele versengen fügt einer Kreatur oder einem Planeswalker deiner Wahl 5 Schadenspunkte zu. Jene bleibende Karte verliert Unzerstörbarkeit bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'Es gab keinen geistreichen Kommentar, keine selbstbewusste Prahlerei … Es gab nur Schmerz.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485742&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f638edb6-d79e-4402-8262-b3baff7d6fe7\', \'multiverseId\': 485742}, \'multiverseid\': 485742}, {\'name\': \'Calcinar el alma\', \'text\': \'Calcinar el alma hace 5 puntos de daño a la criatura o planeswalker objetivo. Ese permanente pierde la habilidad de indestructible hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'No hubo una réplica ingeniosa ni un fanfarroneo altanero que acompañase el ataque. Solo dolor.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486001&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d5e76028-66df-4ec3-9354-ceef5cf953af\', \'multiverseId\': 486001}, \'multiverseid\': 486001}, {\'name\': "Calcination de l\'âme", \'text\': "La Calcination de l\'âme inflige 5 blessures à une cible, créature ou planeswalker. Ce permanent perd l\'indestructible jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': "Il n\'y avait ni remarque cinglante ni fanfaronnade pour accompagner l\'attaque. Seulement la douleur.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486260&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'25515dea-0402-41d1-93fa-f3150fdaa58d\', \'multiverseId\': 486260}, \'multiverseid\': 486260}, {\'name\': "Ustione dell\'Anima", \'text\': "L\'Ustione dell\'Anima infligge 5 danni a una creatura o a un planeswalker bersaglio. Quel permanente perde indistruttibile fino alla fine del turno.", \'type\': \'Istantaneo\', \'flavor\': "Nessuna osservazione spiritosa, né spavalde vanterie accompagnarono l\'attacco. Ci fu soltanto dolore.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486519&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'45a591dd-3a07-44b9-b710-557cb8e6f4d6\', \'multiverseId\': 486519}, \'multiverseid\': 486519}, {\'name\': \'魂焦がし\', \'text\': \'クリーチャー１体かプレインズウォーカー１体を対象とする。魂焦がしはそれに５点のダメージを与える。ターン終了時まで、そのパーマネントは破壊不能を失う。\', \'type\': \'インスタント\', \'flavor\': \'その攻撃には、気の利いた反論も威勢のいい言葉も伴わなかった。ただ苦痛のみがあった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486778&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'92f7a198-cf68-49e7-9d48-732bb1a9aa85\', \'multiverseId\': 486778}, \'multiverseid\': 486778}, {\'name\': \'영혼 태우기\', \'text\': \'생물 또는 플레인즈워커를 목표로 정한다. 영혼 태우기는 그 목표에게 피해 5점을 입힌다. 그 지속물은 턴종료까지 무적을 잃는다.\', \'type\': \'순간마법\', \'flavor\': \'공격과 함께 날려보낼 재치 있는 대꾸도, 자신 있는 자랑도 없었다. 오직 고통만이 있었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487037&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'36ef0e91-5c57-4c60-a3e6-b32ba457c055\', \'multiverseId\': 487037}, \'multiverseid\': 487037}, {\'name\': \'Abrasamento da Alma\', \'text\': \'Abrasamento da Alma causa 5 pontos de dano à criatura ou ao planeswalker alvo. Aquela permanente perde indestrutível até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Não houve resposta sagaz nem vanglória para acompanhar o ataque. Só houve dor.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487296&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e809f7f5-ba9a-46fc-a83c-3551806f20fb\', \'multiverseId\': 487296}, \'multiverseid\': 487296}, {\'name\': \'Сжигание Души\', \'text\': "Сжигание Души наносит 5 повреждений целевому существу или planeswalker\'у. Тот перманент теряет Неразрушимость до конца хода.", \'type\': \'Мгновенное заклинание\', \'flavor\': \'Атаку не сопровождали ни язвительные насмешки, ни самоуверенное хвастовство. Только боль.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487555&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2a521128-58b8-4ee9-9e4b-00a41df298d4\', \'multiverseId\': 487555}, \'multiverseid\': 487555}, {\'name\': \'炙烤灵魂\', \'text\': \'炙烤灵魂对目标生物或鹏洛客造成5点伤害。该永久物失去不灭异能直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'这次攻击带来的，没有机智回击，也没有自满吹嘘。只有无尽痛楚。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487814&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e32395f3-89ae-4096-a43a-5c6fbd5003a6\', \'multiverseId\': 487814}, \'multiverseid\': 487814}, {\'name\': \'炙烤靈魂\', \'text\': \'炙烤靈魂對目標生物或鵬洛客造成5點傷害。該永久物失去不滅異能直到回合結束。\', \'type\': \'瞬間\', \'flavor\': \'這次攻擊帶來的，沒有機智回擊，也沒有自滿吹噓。只有無盡痛楚。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488073&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c9c0e82d-f087-4503-b2cb-7b990841cf21\', \'multiverseId\': 488073}, \'multiverseid\': 488073}]', '[{\'name\': \'Selbstloser Retter\', \'text\': \'Opfere den Selbstlosen Retter: Eine andere Kreatur deiner Wahl, die du kontrollierst, erhält Unzerstörbarkeit bis zum Ende des Zuges. (Schaden und Effekte, die „zerstören", zerstören sie nicht.)\', \'type\': \'Kreatur — Hund\', \'flavor\': \'Sie hat ihn als Welpenwaise aufgezogen und ihm ein Leben voller Liebe geschenkt. In einem letzten Akt dankte er ihr dafür.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485618&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'04172ab3-bc8c-4a55-a65e-8e533f34f5ca\', \'multiverseId\': 485618}, \'multiverseid\': 485618}, {\'name\': \'Salvador altruista\', \'text\': \'Sacrificar el Salvador altruista: Otra criatura objetivo que controlas gana la habilidad de indestructible hasta el final del turno. (El daño y los efectos que dicen "destruir" no la destruyen.)\', \'type\': \'Criatura — Perro\', \'flavor\': \'Era un cachorro huérfano hasta que ella lo crió y le dio una vida llena de amor. La última obra de él fue agradecérselo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485877&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a0b5d4ae-f543-4ddd-b812-e2eb6f65b900\', \'multiverseId\': 485877}, \'multiverseid\': 485877}, {\'name\': \'Sauveur dévoué\', \'text\': "Sacrifiez le Sauveur dévoué : Une autre créature ciblée que vous contrôlez acquiert l\'indestructible jusqu\'à la fin du tour. (Les blessures et les effets qui disent « détruisez » ne la détruisent pas.)", \'type\': \'Créature : chien\', \'flavor\': "Elle l\'a recueilli quand il n\'était encore qu\'un chiot orphelin, et lui a offert une vie pleine d\'amour. Il l\'a remerciée par son dernier geste.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486136&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c44f5c4d-8779-4985-8f21-f81a52c91eb9\', \'multiverseId\': 486136}, \'multiverseid\': 486136}, {\'name\': \'Salvatore Altruista\', \'text\': \'Sacrifica il Salvatore Altruista: Un\\\'altra creatura bersaglio che controlli ha indistruttibile fino alla fine del turno. (Il danno e gli effetti che dicono "distruggi" non la distruggono.)\', \'type\': \'Creatura — Canide\', \'flavor\': \'Lo raccolse quando era un cucciolo abbandonato e gli regalò una vita piena di affetto. Lui decise di ringraziarla con il suo ultimo gesto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486395&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f1d3dcd8-fe92-4a72-9ab2-6d48d977fd92\', \'multiverseId\': 486395}, \'multiverseid\': 486395}, {\'name\': \'無私の救助犬\', \'text\': \'無私の救助犬を生け贄に捧げる：他の、あなたがコントロールしているクリーチャー１体を対象とする。ターン終了時まで、それは破壊不能を得る。（ダメージや「破壊」と書かれた効果では、それは破壊されない。）\', \'type\': \'クリーチャー — 犬\', \'flavor\': \'捨てられていた子犬は彼女に育てられ愛情に満ちた生活を得た。最後の行動は、彼女への感謝だった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486654&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'63976b3c-769a-4b23-8270-d3c448861572\', \'multiverseId\': 486654}, \'multiverseid\': 486654}, {\'name\': \'헌신적인 구조견\', \'text\': \'헌신적인 구조견을 희생한다: 당신이 조종하는 다른 생물을 목표로 정한다. 그 생물은 턴종료까지 무적을 얻는다. (피해와 "파괴"라고 명시된 효과로 파괴되지 않는다.)\', \'type\': \'생물 — 개\', \'flavor\': \'그녀는 어미를 잃은 강아지 때부터 그 개를 기르며 평생의 사랑을 쏟아부었다. 그 개는 자신의 마지막 행동을 통해 그녀에게 보답했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486913&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'edde6533-236e-4553-b3b9-98a7feab76d4\', \'multiverseId\': 486913}, \'multiverseid\': 486913}, {\'name\': \'Salvador Altruísta\', \'text\': \'Sacrifique Salvador Altruísta: Outra criatura alvo que você controla ganha indestrutível até o final do turno. (O dano e os efeitos que dizem "destrua" não a destroem.)\', \'type\': \'Criatura — Cão\', \'flavor\': \'Ela o adotou quando era um filhote órfão e lhe deu uma vida de amor. Em seu último ato, ele a agradeceu.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487172&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9a43d66d-56ee-415f-928d-7bb03dc48e56\', \'multiverseId\': 487172}, \'multiverseid\': 487172}, {\'name\': \'Самоотверженный Спаситель\', \'text\': \'Пожертвуйте Самоотверженного Спасителя: другое целевое существо под вашим контролем получает Неразрушимость до конца хода. (Повреждения и эффекты с указанием «уничтожьте» не уничтожают его.)\', \'type\': \'Существо — Собака\', \'flavor\': \'Подобрав брошенного щенка, она вырастила его, наполнив его жизнь любовью. Своим последним поступком в жизни он отблагодарил ее.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487431&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7ef3ef88-93c5-4f71-ae46-b4a9bb805e3b\', \'multiverseId\': 487431}, \'multiverseid\': 487431}, {\'name\': \'无私救助犬\', \'text\': \'牺牲无私救助犬：另一个目标由你操控的生物获得不灭异能直到回合结束。（伤害与注明「消灭」的效应不会将它消灭。）\', \'type\': \'生物 ～狗\', \'flavor\': \'它幼时曾是流浪孤犬，幸好遇她悉心照料，得以一生幸福成长。而这养育之恩，它靠这最后的舍命相助为报。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487690&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'39ca19bd-8417-423b-bf35-fce909214b54\', \'multiverseId\': 487690}, \'multiverseid\': 487690}, {\'name\': \'無私救助犬\', \'text\': \'犧牲無私救助犬：另一個目標由你操控的生物獲得不滅異能直到回合結束。（傷害與註明「消滅」的效應不會將它消滅。）\', \'type\': \'生物 ～狗\', \'flavor\': \'牠幼時曾是流浪孤犬，幸好遇她悉心照料，得以一生幸福成長。而這養育之恩，牠靠這最後的捨命相助為報。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487949&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'07cfd10b-3e49-4e91-821d-7ecd40e2caf8\', \'multiverseId\': 487949}, \'multiverseid\': 487949}]', '[{\'name\': \'Setesser-Training\', \'text\': \'Verzaubert eine Kreatur, die du kontrollierst\\nWenn das Setesser-Training ins Spiel kommt, ziehe eine Karte.\\nDie verzauberte Kreatur erhält +1/+0 und verursacht Trampelschaden. (Sie kann überschüssigen Kampfschaden dem verteidigenden Spieler oder Planeswalker zufügen.)\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485787&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'10189530-19fe-45d4-851e-5cc514fe7754\', \'multiverseId\': 485787}, \'multiverseid\': 485787}, {\'name\': \'Entrenamiento setessano\', \'text\': \'Encantar criatura que controlas.\\nCuando el Entrenamiento setessano entre al campo de batalla, roba una carta.\\nLa criatura encantada obtiene +1/+0 y tiene la habilidad de arrollar. (Puede hacer el daño de combate sobrante al jugador o planeswalker al que ataca.)\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486046&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1b16bed0-7db8-4d0c-b921-4478c769a13c\', \'multiverseId\': 486046}, \'multiverseid\': 486046}, {\'name\': \'Entraînement setessien\', \'text\': "Enchanter : une créature que vous contrôlez\\nQuand l\'Entraînement setessien arrive sur le champ de bataille, piochez une carte.\\nLa créature enchantée gagne +1/+0 et a le piétinement. (Elle peut infliger son surplus de blessures de combat au joueur ou au planeswalker qu\'elle attaque.)", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486305&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'59cd9037-3a31-4c23-9871-4af8b24695bb\', \'multiverseId\': 486305}, \'multiverseid\': 486305}, {\'name\': \'Addestramento di Setessa\', \'text\': "Incanta creatura che controlli\\nQuando l\'Addestramento di Setessa entra nel campo di battaglia, pesca una carta.\\nLa creatura incantata prende +1/+0 e ha travolgere. (Può infliggere il danno da combattimento in eccesso al giocatore o al planeswalker che sta attaccando.)", \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486564&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fb4005e0-947a-4582-aa44-f3c1d8a5262b\', \'multiverseId\': 486564}, \'multiverseid\': 486564}, {\'name\': \'セテッサ式訓練\', \'text\': \'エンチャント（あなたがコントロールしているクリーチャー）\\nセテッサ式訓練が戦場に出たとき、カードを１枚引く。\\nエンチャントしているクリーチャーは＋１/＋０の修整を受けトランプルを持つ。（それは余剰の戦闘ダメージを、それが攻撃しているプレイヤーかプレインズウォーカーに与えることができる。）\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486823&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'84c2daac-d41a-40a3-9609-5b42ab7b1e7a\', \'multiverseId\': 486823}, \'multiverseid\': 486823}, {\'name\': \'세테사 훈련\', \'text\': \'당신이 조종하는 생물에게 부여\\n세테사 훈련이 전장에 들어올 때, 카드 한 장을 뽑는다.\\n부여된 생물은 +1/+0을 받고 돌진을 가진다. (이 생물은 여분의 전투피해를 공격 중인 플레이어 또는 플레인즈워커에게 입힐 수 있다.)\', \'type\': \'부여마법 — 마법진\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487082&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'85739b32-2859-4ca1-84d0-e3a23bbcfe1b\', \'multiverseId\': 487082}, \'multiverseid\': 487082}, {\'name\': \'Treinamento Setessano\', \'text\': \'Encantar criatura que você controla\\nQuando Treinamento Setessano entrar no campo de batalha, compre um card.\\nA criatura encantada recebe +1/+0 e tem atropelar. (Ela pode causar seu dano de combate excedente ao jogador ou planeswalker que ela estiver atacando.)\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487341&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'551aadba-e99c-4822-b35d-a34b9f24584f\', \'multiverseId\': 487341}, \'multiverseid\': 487341}, {\'name\': \'Сетесская Подготовка\', \'text\': "Зачаровать существо под вашим контролем\\nКогда Сетесская Подготовка выходит на поле битвы, возьмите карту.\\nЗачарованное существо получает +1/+0 и имеет Пробивной удар. (Оно может нанести избыточные боевые повреждения игроку или planeswalker\'у, которого атакует.)", \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487600&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'51ae0b95-c124-4ef5-8086-0a91be260ac9\', \'multiverseId\': 487600}, \'multiverseid\': 487600}, {\'name\': \'瑟特萨式训练\', \'text\': \'结附于由你操控的生物\\n当瑟特萨式训练进战场时，抓一张牌。\\n所结附的生物得+1/+0且具有践踏异能。（它造成之过量战斗伤害能对所攻击的牌手或鹏洛客造成之。）\', \'type\': \'结界 ～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487859&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3703a3d3-e20d-4dc2-80f8-07279155f35a\', \'multiverseId\': 487859}, \'multiverseid\': 487859}, {\'name\': \'瑟特薩式訓練\', \'text\': \'結附於由你操控的生物\\n當瑟特薩式訓練進戰場時，抽一張牌。\\n所結附的生物得+1/+0且具有踐踏異能。（它造成之過量戰鬥傷害能對所攻擊的玩家或鵬洛客造成之。）\', \'type\': \'結界 ～靈氣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488118&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c2da3df5-f950-4ccd-8a5c-02588bf23ee6\', \'multiverseId\': 488118}, \'multiverseid\': 488118}]', '[{\'name\': \'Sicherer Stoß\', \'text\': \'Eine Kreatur deiner Wahl erhält +3/+0 und Erstschlag bis zum Ende des Zuges. (Sie fügt Kampfschaden vor Kreaturen ohne Erstschlag zu.)\', \'type\': \'Spontanzauber\', \'flavor\': \'So manche tollkühne Seele sprang dem Tod von der Schippe, weil sie erst handelte und sich später fürchtete.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485745&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'252c95c9-1af1-44cb-a456-289663e823e0\', \'multiverseId\': 485745}, \'multiverseid\': 485745}, {\'name\': \'Arremetida segura\', \'text\': \'La criatura objetivo obtiene +3/+0 y gana la habilidad de dañar primero hasta el final del turno. (Hace daño de combate antes que las criaturas sin la habilidad de dañar primero.)\', \'type\': \'Instantáneo\', \'flavor\': \'A veces, para sobrevivir al fracaso inminente, se necesita un alma inocente que actúe primero y se asuste después.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486004&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'22a47afe-2f9e-41f5-be82-9c84c96cbe3d\', \'multiverseId\': 486004}, \'multiverseid\': 486004}, {\'name\': \'Frappe assurée\', \'text\': "La créature ciblée gagne +3/+0 et acquiert l\'initiative jusqu\'à la fin du tour. (Elle inflige des blessures de combat avant les créatures sans l\'initiative.)", \'type\': \'Éphémère\', \'flavor\': "Pour survivre à une mort imminente, il faut parfois qu\'une âme téméraire agisse avant de succomber à ses peurs.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486263&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ba1eaf50-6a5c-4c73-be73-6fc201230431\', \'multiverseId\': 486263}, \'multiverseid\': 486263}, {\'name\': \'Colpo Sicuro\', \'text\': \'Una creatura bersaglio prende +3/+0 e ha attacco improvviso fino alla fine del turno. (Infligge danno da combattimento prima delle creature senza attacco improvviso.)\', \'type\': \'Istantaneo\', \'flavor\': "Per sopravvivere alla tragedia imminente, a volte serve un\'anima avventata, che prima agisca e poi si spaventi.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486522&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8ac6ab78-9a2c-4156-9303-d06d18f7b59f\', \'multiverseId\': 486522}, \'multiverseid\': 486522}, {\'name\': \'確実な一撃\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋３/＋０の修整を受け、先制攻撃を得る。（それは先制攻撃を持たないクリーチャーよりも先に戦闘ダメージを与える。）\', \'type\': \'インスタント\', \'flavor\': \'死を目前にすると、恐れるより先に無謀な行動をする者がいる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486781&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'51b31e72-b91b-4b8d-ace1-ab1b78b71ad6\', \'multiverseId\': 486781}, \'multiverseid\': 486781}, {\'name\': \'확실한 일격\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 +3/+0을 받고 선제공격을 얻는다. (이 생물은 선제공격이 없는 생물보다 먼저 전투피해를 입힌다.)\', \'type\': \'순간마법\', \'flavor\': \'임박한 파멸에서 살아남으려면 때로는 가장 먼저 행동하고 나중에 두려워하는 무모한 자가 필요하다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487040&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f4bbbbfd-83fb-4470-9c3b-e9867d85c0d1\', \'multiverseId\': 487040}, \'multiverseid\': 487040}, {\'name\': \'Golpe Certeiro\', \'text\': \'A criatura alvo recebe +3/+0 e ganha iniciativa até o final do turno. (Ela causa dano de combate antes das criaturas sem iniciativa.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Às vezes, para sobreviver a um fim iminente, é necessário ter uma alma temerária que aja primeiro e tema depois.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487299&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'851bf958-dd60-4c1f-a38a-50193cfd2ca2\', \'multiverseId\': 487299}, \'multiverseid\': 487299}, {\'name\': \'Верный Удар\', \'text\': \'Целевое существо получает +3/+0 и Первый удар до конца хода. (Оно наносит боевые повреждения раньше существ без Первого удара.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Чтобы спастись от верной гибели, иногда нужен безрассудный боец, который сначала будет действовать, а уже потом — бояться.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487558&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'65016de1-7bb1-4d17-8004-c995490a2cc7\', \'multiverseId\': 487558}, \'multiverseid\': 487558}, {\'name\': \'必中一击\', \'text\': \'直到回合结束，目标生物得+3/+0且获得先攻异能。（它会比不具先攻异能的生物提前造成战斗伤害。）\', \'type\': \'瞬间\', \'flavor\': \'在末日来临之时，想要生存，有时需要鲁莽之士的义无反顾。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487817&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d76b6be0-3fe9-4bf2-990a-c987358ccd59\', \'multiverseId\': 487817}, \'multiverseid\': 487817}, {\'name\': \'必中一擊\', \'text\': \'直到回合結束，目標生物得+3/+0且獲得先攻異能。（它會比不具先攻異能的生物提前造成戰鬥傷害。）\', \'type\': \'瞬間\', \'flavor\': \'在末日來臨之時，想要生存，有時需要魯莽之士的義無反顧。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488076&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6928a44b-4e84-44fb-98ff-5b5575cb2510\', \'multiverseId\': 488076}, \'multiverseid\': 488076}]', '[{\'name\': \'Silberpein-Ghul\', \'text\': \'Zu Beginn deines Endsegments und falls du in diesem Zug 3 oder mehr Lebenspunkte dazuerhalten hast, bringe den Silberpein-Ghul aus deinem Friedhof getappt ins Spiel zurück.\\n{1}{B}, opfere den Silberpein-Ghul: Ziehe eine Karte.\', \'type\': \'Kreatur — Zombie, Vampir\', \'flavor\': \'Von zwei Formen des Unlebens betroffen zu sein, ist ein schlimmeres Schicksal als der bloße Tod.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485704&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'14edf77a-11e8-4c50-adf0-f20b281007b2\', \'multiverseId\': 485704}, \'multiverseid\': 485704}, {\'name\': \'Necrófago herida plateada\', \'text\': \'Al comienzo de tu paso final, si ganaste 3 o más vidas este turno, regresa el Necrófago herida plateada de tu cementerio al campo de batalla girado.\\n{1}{B}, sacrificar el Necrófago herida plateada: Roba una carta.\', \'type\': \'Criatura — Vampiro zombie\', \'flavor\': \'Estar atrapado entre dos formas sin vida es un destino mucho peor que la muerte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485963&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5ca6b4c4-6a48-4144-8523-c883f6010e93\', \'multiverseId\': 485963}, \'multiverseid\': 485963}, {\'name\': "Goule piquée à l\'argent", \'text\': "Au début de votre étape de fin, si vous avez gagné au moins 3 points de vie ce tour-ci, renvoyez sur le champ de bataille, engagée, la Goule piquée à l\'argent depuis votre cimetière.\\n{1}{B}, sacrifiez la Goule piquée à l\'argent : Piochez une carte.", \'type\': \'Créature : zombie et vampire\', \'flavor\': \'Se retrouver piégé entre deux formes de non-vie est un sort bien plus cruel que la mort.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486222&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f1b21d27-df91-48ca-ac04-668aa171fa62\', \'multiverseId\': 486222}, \'multiverseid\': 486222}, {\'name\': \'Ghoul Argentificato\', \'text\': "All\'inizio della tua sottofase finale, se hai guadagnato 3 o più punti vita in questo turno, rimetti sul campo di battaglia TAPpato il Ghoul Argentificato dal tuo cimitero.\\n{1}{B}, Sacrifica il Ghoul Argentificato: Pesca una carta.", \'type\': \'Creatura — Vampiro Zombie\', \'flavor\': \'Essere intrappolati tra due forme di non vita è una sorte peggiore della semplice morte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486481&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4fabf2d6-6bcb-4fb3-b922-5b272b215b3d\', \'multiverseId\': 486481}, \'multiverseid\': 486481}, {\'name\': \'銀打ちのグール\', \'text\': \'あなたの終了ステップの開始時に、このターンにあなたがライフを３点以上得ていた場合、あなたの墓地から銀打ちのグールをタップ状態で戦場に戻す。\\n{1}{B}, 銀打ちのグールを生け贄に捧げる：カードを１枚引く。\', \'type\': \'クリーチャー — ゾンビ・吸血鬼\', \'flavor\': \'命を持たない二種の存在の間に捕らわれるというのは、単なる死よりも遥かに悪い運命である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486740&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bfcbeaae-e4b3-4a60-9cb8-d948e715c05d\', \'multiverseId\': 486740}, \'multiverseid\': 486740}, {\'name\': \'은단련 악귀\', \'text\': \'당신의 종료단 시작에, 당신이 이번 턴에 생명점을 3점 이상 얻었다면, 은단련 악귀를 당신의 무덤에서 탭된 채로 전장으로 되돌린다.\\n{1}{B}, 은단련 악귀를 희생한다: 카드 한 장을 뽑는다.\', \'type\': \'생물 — 좀비 흡혈귀\', \'flavor\': \'죽어도 죽지 못하는 두 형태 속에 갇혀 있는 것은 단순히 죽는 것보다 훨씬 나쁜 운명이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486999&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'baca77e9-22c8-4ab7-b825-314b3beda761\', \'multiverseId\': 486999}, \'multiverseid\': 486999}, {\'name\': \'Carniçal Argentificado\', \'text\': \'No início de sua etapa final, se você ganhou 3 pontos de vida ou mais neste turno, devolva Carniçal Argentificado de seu cemitério para o campo de batalha virado.\\n{1}{B}, sacrifique Carniçal Argentificado: Compre um card.\', \'type\': \'Criatura — Zumbi Vampiro\', \'flavor\': \'Estar preso entre duas formas de não vida é um destino pior que uma mera morte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487258&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4941a770-2ea8-4c42-9341-02f8b2664996\', \'multiverseId\': 487258}, \'multiverseid\': 487258}, {\'name\': \'Среброкованый Упырь\', \'text\': \'В начале вашего заключительного шага, если в этом ходу вы получили 3 или более жизней, верните Среброкованого Упыря из вашего кладбища на поле битвы повернутым.\\n{1}{B}, пожертвуйте Среброкованого Упыря: возьмите карту.\', \'type\': \'Существо — Зомби Вампир\', \'flavor\': \'Попасть в ловушку между двумя формами не-жизни — участь куда хуже, чем простая смерть.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487517&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'264a44a9-70e4-4e3e-9e3f-bdf74d4e7a54\', \'multiverseId\': 487517}, \'multiverseid\': 487517}, {\'name\': \'嵌银食尸鬼\', \'text\': \'在你的结束步骤开始时，若你本回合中获得了3点或更多生命，则将嵌银食尸鬼从你的坟墓场横置移回战场。\\n{1}{B}，牺牲嵌银食尸鬼：抓一张牌。\', \'type\': \'生物 ～灵俑／吸血鬼\', \'flavor\': \'夹在两种不死形体之间，这结局比死去更悲惨。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487776&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fcf60273-cdb9-417c-a5cc-04ae6eff6cff\', \'multiverseId\': 487776}, \'multiverseid\': 487776}, {\'name\': \'嵌銀食屍鬼\', \'text\': \'在你的結束步驟開始時，若你本回合中獲得了3點或更多生命，則將嵌銀食屍鬼從你的墳墓場橫置移回戰場。\\n{1}{B}，犧牲嵌銀食屍鬼：抽一張牌。\', \'type\': \'生物 ～殭屍／吸血鬼\', \'flavor\': \'夾在兩種不死形體之間，這結局比死去更悲慘。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488035&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7b748713-e77d-495e-a7a5-abd29e6fbfe3\', \'multiverseId\': 488035}, \'multiverseid\': 488035}]', '[{\'name\': \'Skelettierter Bogenschütze\', \'text\': \'Wenn der Skelettierte Bogenschütze ins Spiel kommt, fügt er einem Ziel deiner Wahl 1 Schadenspunkt zu.\', \'type\': \'Kreatur — Skelett, Bogenschütze\', \'flavor\': \'„Seele, Muskeln, Augen … nichts davon ist zwingend nötig, um tödliche Präzision zu erreichen."\\n—Modriss aus Zargoth Fen\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485705&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'21a011e5-0af0-4881-b73d-f5d30a0db290\', \'multiverseId\': 485705}, \'multiverseid\': 485705}, {\'name\': \'Esqueleto arquero\', \'text\': \'Cuando el Esqueleto arquero entre al campo de batalla, hace 1 punto de daño a cualquier objetivo.\', \'type\': \'Criatura — Esqueleto arquero\', \'flavor\': \'"Alma, carne, ojos incluso... Nada de eso es estrictamente necesario para una precisión letal".\\n—Modriss del pantano Zargoth\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485964&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'83ae2b7d-88db-466a-8eff-480f9e694d23\', \'multiverseId\': 485964}, \'multiverseid\': 485964}, {\'name\': \'Archer squelette\', \'text\': "Quand l\'Archer squelette arrive sur le champ de bataille, il inflige 1 blessure à n\'importe quelle cible.", \'type\': \'Créature : squelette et archer\', \'flavor\': "« L\'âme, la chair et même les yeux, rien de tout ceci n\'est véritablement nécessaire à une précision meurtrière. »\\n—Modriss de la maremme de Zargoth", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486223&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a00f4a8e-8a72-486b-8c12-d282bc66656b\', \'multiverseId\': 486223}, \'multiverseid\': 486223}, {\'name\': \'Arciere Scheletrico\', \'text\': "Quando l\'Arciere Scheletrico entra nel campo di battaglia, infligge 1 danno a un qualsiasi bersaglio.", \'type\': \'Creatura — Arciere Scheletro\', \'flavor\': \'"Né l\\\'anima, né la carne, neppure gli occhi sono strettamente necessari per una precisione letale."\\n—Modriss della palude di Zargoth\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486482&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2bf74362-d6ee-4a14-a54c-97f72421ee9e\', \'multiverseId\': 486482}, \'multiverseid\': 486482}, {\'name\': \'骸骨射手\', \'text\': \'骸骨射手が戦場に出たとき、クリーチャー１体かプレインズウォーカー１体かプレイヤー１人を対象とする。これはそれに１点のダメージを与える。\', \'type\': \'クリーチャー — スケルトン・射手\', \'flavor\': \'「魂や肉体、眼球ですら、たとえ無くとも精密な射撃は可能なのだ。」\\n――ザルゴス湿原のモドリス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486741&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e9844437-d51a-4cb0-a0a8-b860204ccd89\', \'multiverseId\': 486741}, \'multiverseid\': 486741}, {\'name\': \'해골 궁수\', \'text\': \'해골 궁수가 전장에 들어올 때, 원하는 목표를 정한다. 해골 궁수는 그 목표에게 피해 1점을 입힌다.\', \'type\': \'생물 — 해골 궁수\', \'flavor\': \'"영혼, 살점, 심지어 눈도 필요없어—이런 것들은 명중하는 데 꼭 필요한 것들이 아니야."\\n—자르고스 늪지의 모드리스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487000&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'defc2d4a-b47f-4df0-be0f-82a9bd72a592\', \'multiverseId\': 487000}, \'multiverseid\': 487000}, {\'name\': \'Arqueiro Esquelético\', \'text\': \'Quando Arqueiro Esquelético entra no campo de batalha, ele causa 1 ponto de dano a qualquer alvo.\', \'type\': \'Criatura — Esqueleto Arqueiro\', \'flavor\': \'"Alma, carne, nem mesmo os olhos. Nada disso é estritamente necessário para uma precisão mortífera."\\n— Modriss do Charco de Zargoth\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487259&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'58272198-b4c5-46b2-910a-a4630accd164\', \'multiverseId\': 487259}, \'multiverseid\': 487259}, {\'name\': \'Скелет-Лучник\', \'text\': \'Когда Скелет-Лучник выходит на поле битвы, он наносит 1 повреждение любой цели.\', \'type\': \'Существо — Скелет Лучник\', \'flavor\': \'«Душа, плоть, даже глаза — ничего из этого не обязательно иметь для смертоносной точности».\\n— Модрисс с болота Заргот\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487518&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'110e133e-42cd-4064-a6de-cfa35d694bac\', \'multiverseId\': 487518}, \'multiverseid\': 487518}, {\'name\': \'骷髅妖箭手\', \'text\': \'当骷髅妖箭手进战场时，它对任意一个目标造成1点伤害。\', \'type\': \'生物 ～骷髅妖／弓箭手\', \'flavor\': \'「灵魂、肉身，甚至双眼～这些都不是精准夺命的箭术所必需之物。」\\n～札戈斯沼的墨垂兹\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487777&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1fdd0ff4-9ac9-47d1-af4b-fe3c68a6a91e\', \'multiverseId\': 487777}, \'multiverseid\': 487777}, {\'name\': \'骷髏妖箭手\', \'text\': \'當骷髏妖箭手進戰場時，它對任意一個目標造成1點傷害。\', \'type\': \'生物 ～骷髏妖／弓箭手\', \'flavor\': \'「靈魂、肉身，甚至雙眼～這些都不是精準奪命的箭術所必需之物。」\\n～札戈斯沼的墨垂茲\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488036&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'86eb62fe-5b21-4ad4-9b0a-6762ba8dace1\', \'multiverseId\': 488036}, \'multiverseid\': 488036}]', '[{\'name\': \'Soubira, caravanière des Tulzidi\', \'text\': "Célérité\\n{1} : Une autre créature ciblée de force inférieure ou égale à 2 ne peut pas être bloquée ce tour-ci.\\n{1}{R}, {T}, défaussez-vous de votre main : Jusqu\'à la fin du tour, à chaque fois qu\'une créature de force inférieure ou égale à 2 que vous contrôlez inflige des blessures de combat à un joueur, piochez une carte.", \'type\': \'Créature légendaire : humain et shamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488319&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f39d0154-82bb-49ea-af7b-0a8e8ed20f35\', \'multiverseId\': 488319}, \'multiverseid\': 488319}, {\'name\': \'タルジーディの隊商、スビラ\', \'text\': \'速攻\\n{1}：他の、パワーが２以下のクリーチャー１体を対象とする。このターン、それはブロックされない。\\n{1}{R}, {T}, あなたの手札を捨てる：ターン終了時まで、あなたがコントロールしていてパワーが２以下のクリーチャー１体がプレイヤー１人に戦闘ダメージを与えるたび、カードを１枚引く。\', \'type\': \'伝説のクリーチャー — 人間・シャーマン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488371&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bf809bfe-8e32-4bec-9a31-22e2b0cf2399\', \'multiverseId\': 488371}, \'multiverseid\': 488371}]', '[{\'name\': \'Souverain félin\', \'text\': "Les autres chats que vous contrôlez gagnent +1/+1 et ont la protection contre les chiens.\\nÀ chaque fois qu\'au moins un chat que vous contrôlez inflige des blessures de combat à un joueur, détruisez jusqu\'à une cible, artefact ou enchantement, que ce joueur contrôle.", \'type\': \'Créature : chat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488325&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6a0a57af-71cd-4621-a373-e69aa9e233ca\', \'multiverseId\': 488325}, \'multiverseid\': 488325}, {\'name\': \'猫の君主\', \'text\': \'他の、あなたがコントロールしている猫は＋１/＋１の修整を受けプロテクション（犬）を持つ。\\nあなたがコントロールしている猫１体以上がプレイヤー１人に戦闘ダメージを与えるたび、そのプレイヤーがコントロールしている、アーティファクトかエンチャント最大１つを対象とし、それを破壊する。\', \'type\': \'クリーチャー — 猫\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488377&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f623961e-5ec9-468f-ab81-578d4b81a366\', \'multiverseId\': 488377}, \'multiverseid\': 488377}]', '[{\'name\': \'Sporennetzweber\', \'text\': \'Reichweite, Fluchsicher vor Blau\\nImmer wenn dem Sporennetzweber Schaden zugefügt wird, erhältst du 1 Lebenspunkt dazu und erzeugst einen 1/1 grünen Saproling-Kreaturenspielstein.\', \'type\': \'Kreatur — Spinne\', \'flavor\': \'Es spinnt sein Netz durch die Unterstadt und seltsame Wucherungen sprießen auf seinem Pfad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485790&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b49db603-63e0-4f76-8012-a282af9382eb\', \'multiverseId\': 485790}, \'multiverseid\': 485790}, {\'name\': \'Tejedora de telas de esporas\', \'text\': \'Alcance, antimaleficio contra azul.\\nSiempre que la Tejedora de telas de esporas reciba daño, ganas 1 vida y creas una ficha de criatura Saprolín verde 1/1.\', \'type\': \'Criatura — Araña\', \'flavor\': \'Teje su telaraña en la subciudad, y de ella surgen brotes extraños.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486049&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'edd0ebe0-df5e-47de-9494-85fd26bbce03\', \'multiverseId\': 486049}, \'multiverseid\': 486049}, {\'name\': \'Tisseuse de sporetoile\', \'text\': \'Portée, défense talismanique contre le bleu\\nÀ chaque fois que la Tisseuse de sporetoile subit des blessures, vous gagnez 1 point de vie et vous créez un jeton de créature 1/1 verte Saprobionte.\', \'type\': \'Créature : araignée\', \'flavor\': "Elle tisse sa toile à travers la Citerraine. D\'étranges excroissances poussent derrière elle.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486308&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ce117b6b-9fc9-43a9-a3cb-d9d7500735df\', \'multiverseId\': 486308}, \'multiverseid\': 486308}, {\'name\': \'Tessitore di Telaspora\', \'text\': \'Raggiungere, anti-malocchio dal blu\\nOgniqualvolta viene inflitto danno al Tessitore di Telaspora, guadagni 1 punto vita e crei una pedina creatura Saprolingio 1/1 verde.\', \'type\': \'Creatura — Ragno\', \'flavor\': \'Tesse la sua tela in giro per la città sepolta, lasciandosi dietro una scia di strane escrescenze.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486567&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'44ce35a2-09f0-4233-889d-4bed471b9419\', \'multiverseId\': 486567}, \'multiverseid\': 486567}, {\'name\': \'胞子網の織り手\', \'text\': \'到達、青からの呪禁\\n胞子網の織り手がダメージを受けるたび、あなたは１点のライフを得て、緑の１/１の苗木・クリーチャー・トークンを１体生成する。\', \'type\': \'クリーチャー — 蜘蛛\', \'flavor\': \'地底街の至る所に網を張り、通った後には奇妙なものが芽吹く。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486826&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'826470c9-84a8-4ac8-931b-59e86d5f63d5\', \'multiverseId\': 486826}, \'multiverseid\': 486826}, {\'name\': \'포자그물 방직거미\', \'text\': \'대공, 청색으로부터 방호\\n포자그물 방직거미가 피해를 입을 때마다, 당신은 생명 1점을 얻고 1/1 녹색 묘목 생물 토큰 한 개를 만든다.\', \'type\': \'생물 — 거미\', \'flavor\': \'그것은 저승을 가로지르는 거미줄을 자아내며, 그 자취에는 기이한 식물들이 싹을 틔운다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487085&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ac8f9fcd-dd7c-4f26-9584-a4acb5faed99\', \'multiverseId\': 487085}, \'multiverseid\': 487085}, {\'name\': \'Tecelã da Teia Fúngica\', \'text\': \'Alcance, resistência à magia azul\\nToda vez que Tecelã da Teia Fúngica sofre dano, você ganha 1 ponto de vida e cria uma ficha de criatura verde 1/1 do tipo Saprófita.\', \'type\': \'Criatura — Aranha\', \'flavor\': \'Ela tece sua teia pelo submundo, e estranhos brotamentos surgem em seu rastro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487344&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e22910b6-509a-4269-aa3b-32162ef49176\', \'multiverseId\': 487344}, \'multiverseid\': 487344}, {\'name\': \'Плетельщик Споровой Паутины\', \'text\': \'Захват, Порчеустойчивость от синего\\nКаждый раз, когда Плетельщику Споровой Паутины наносятся повреждения, вы получаете 1 жизнь и создаете одну фишку существа 1/1 зеленый Сапролинг.\', \'type\': \'Существо — Паук\', \'flavor\': \'Он плетет свою сеть в подземном городе, и странная поросль появляется у него за спиной.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487603&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'44435912-c983-48b8-8f90-d1cbfb1c8c74\', \'multiverseId\': 487603}, \'multiverseid\': 487603}, {\'name\': \'孢网编蛛\', \'text\': \'延势，反蓝辟邪\\n每当孢网编蛛受到伤害时，你获得1点生命并派出一个1/1绿色腐生物衍生生物。\', \'type\': \'生物 ～蜘蛛\', \'flavor\': \'其蛛网遍布地底城，所经之处滋生异物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487862&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'81113468-6060-4fc0-9d37-fdb678a6fda7\', \'multiverseId\': 487862}, \'multiverseid\': 487862}, {\'name\': \'孢網編蛛\', \'text\': \'延勢，反藍辟邪\\n每當孢網編蛛受到傷害時，你獲得1點生命並派出一個1/1綠色腐生物衍生生物。\', \'type\': \'生物 ～蜘蛛\', \'flavor\': \'其蛛網遍佈地底城，所經之處滋生異物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488121&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0ac56efd-9978-4c90-b193-71fdf5b984f6\', \'multiverseId\': 488121}, \'multiverseid\': 488121}]', "[{'name': 'Stachel-Megalodon', 'text': 'Fluchsicher (Diese Kreatur kann nicht das Ziel von Zaubersprüchen oder Fähigkeiten sein, die deine Gegner kontrollieren.)\\nImmer wenn der Stachel-Megalodon angreift, wende Hellsicht 1 an. (Schaue dir die oberste Karte deiner Bibliothek an. Du kannst sie unter deine Bibliothek legen.)', 'type': 'Kreatur — Hai', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485654&type=card', 'language': 'German', 'identifiers': {'scryfallId': '63ff67a2-a252-4c5f-be12-f8fe98ed05fa', 'multiverseId': 485654}, 'multiverseid': 485654}, {'name': 'Megalodón con púas', 'text': 'Antimaleficio. (Esta criatura no puede ser objetivo de hechizos o habilidades que controlen tus oponentes.)\\nSiempre que el Megalodón con púas ataque, adivina 1. (Mira la primera carta de tu biblioteca. Puedes poner esa carta en el fondo de tu biblioteca.)', 'type': 'Criatura — Tiburón', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485913&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5c10b176-ecf4-41f1-a7f4-f1030a3767c0', 'multiverseId': 485913}, 'multiverseid': 485913}, {'name': 'Mégalodon à piquants', 'text': 'Défense talismanique (Cette créature ne peut pas être la cible de sorts ou de capacités que vos adversaires contrôlent.)\\nÀ chaque fois que le Mégalodon à piquants attaque, regard 1. (Regardez la carte du dessus de votre bibliothèque. Vous pouvez la mettre au-dessous de votre bibliothèque.)', 'type': 'Créature : requin', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486172&type=card', 'language': 'French', 'identifiers': {'scryfallId': '15345f41-9a0a-41c0-99d2-03f04aa9b23b', 'multiverseId': 486172}, 'multiverseid': 486172}, {'name': 'Megalodonte Spinato', 'text': 'Anti-malocchio (Questa creatura non può essere bersaglio di magie o abilità controllate dai tuoi avversari.)\\nOgniqualvolta il Megalodonte Spinato attacca, profetizza 1. (Guarda la prima carta del tuo grimorio. Puoi mettere quella carta in fondo al tuo grimorio.)', 'type': 'Creatura — Squalo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486431&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '7c70a322-037a-487f-810a-aa0334597776', 'multiverseId': 486431}, 'multiverseid': 486431}, {'name': '有刺メガロドン', 'text': '呪禁（このクリーチャーは、対戦相手がコントロールしている呪文や能力の対象にならない。）\\n有刺メガロドンが攻撃するたび、占術１を行う。（あなたのライブラリーの一番上のカードを見る。あなたはそのカードをあなたのライブラリーの一番下に置いてもよい。）', 'type': 'クリーチャー — サメ', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486690&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '574b187d-d8a2-4a55-98de-a5a0a80b6f78', 'multiverseId': 486690}, 'multiverseid': 486690}, {'name': '큰가시 메갈로돈', 'text': '방호 (이 생물은 당신의 상대들이 조종하는 주문이나 능력의 목표로 정해질 수 없다.)\\n큰가시 메갈로돈이 공격할 때마다, 점술 1을 한다. (당신의 서고 맨 위 카드 한 장을 본다. 당신은 그 카드를 당신의 서고 맨 밑에 놓을 수 있다.)', 'type': '생물 — 상어', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486949&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'b649c359-b033-469e-b05c-4b995102daab', 'multiverseId': 486949}, 'multiverseid': 486949}, {'name': 'Megalodonte Espinhoso', 'text': 'Resistência a magia (Esta criatura não pode ser alvo de mágicas nem de habilidades que seus oponentes controlam.)\\nToda vez que Megalodonte Espinhoso atacar, use vidência 1. (Olhe o card do topo de seu grimório. Você pode colocar aquele card no fundo de seu grimório.)', 'type': 'Criatura — Tubarão', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487208&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b17b0adf-4d24-4d72-9e7b-8fa6be2e6dfd', 'multiverseId': 487208}, 'multiverseid': 487208}, {'name': 'Шипастый Мегалодон', 'text': 'Порчеустойчивость (Это существо не может быть целью заклинаний или способностей под контролем ваших оппонентов.)\\nКаждый раз, когда Шипастый Мегалодон атакует, предскажите 1. (Посмотрите верхнюю карту вашей библиотеки. Вы можете положить ту карту в низ вашей библиотеки.)', 'type': 'Существо — Акула', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487467&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '414acbd4-2b7c-4355-b56e-8eb96d6d0f5f', 'multiverseId': 487467}, 'multiverseid': 487467}, {'name': '硬背巨牙鲨', 'text': '辟邪（此生物不能成为由对手操控之咒语或异能的目标。）\\n每当硬背巨牙鲨攻击时，占卜1。（检视你牌库顶的牌。你可以将该牌置于你的牌库底。）', 'type': '生物 ～鲨鱼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487726&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9ac9e8b7-3643-4ce9-8eca-d6a1290bbb21', 'multiverseId': 487726}, 'multiverseid': 487726}, {'name': '硬背巨牙鯊', 'text': '辟邪（此生物不能成為由對手操控之咒語或異能的目標。）\\n每當硬背巨牙鯊攻擊時，占卜1。（檢視你牌庫頂的牌。你可以將該牌置於你的牌庫底。）', 'type': '生物 ～鯊魚', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487985&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '2486b576-5b16-4173-84ed-8b6b6fe6c92d', 'multiverseId': 487985}, 'multiverseid': 487985}]", '[{\'name\': \'Standhafter Schildbruder\', \'type\': \'Kreatur — Zwerg, Soldat\', \'flavor\': \'„Es ist mit dem Gold aus einem Drachenhort vergoldet, und mit dem Bild des Drachens verziert, den ich erschlagen musste, um es mir zu holen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485621&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c39b6b06-b0e3-48ea-9dca-8a0b63fab88f\', \'multiverseId\': 485621}, \'multiverseid\': 485621}, {\'name\': \'Escudante devoto\', \'type\': \'Criatura — Soldado enano\', \'flavor\': \'"¡Está bañado en el oro del tesoro de un dragón, sí! Y tiene grabada la imagen del dragón que maté para hacerme con él".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485880&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f88c7635-f922-4437-95f5-8e811b1ca91f\', \'multiverseId\': 485880}, \'multiverseid\': 485880}, {\'name\': \'Compagnon bouclier inébranlable\', \'type\': \'Créature : nain et soldat\', \'flavor\': "« Il est recouvert de l\'or d\'un trésor de dragon ! Et j\'y ai fait graver l\'effigie du dragon que j\'ai abattu pour le prendre. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486139&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b3ad8b64-dd7a-4c82-9dc4-99c51348ed49\', \'multiverseId\': 486139}, \'multiverseid\': 486139}, {\'name\': \'Scutifero Leale\', \'type\': \'Creatura — Soldato Nano\', \'flavor\': \'"È laminato con l\\\'oro proveniente dal tesoro di un drago, proprio così! E vi è incisa l\\\'immagine del drago che ho dovuto ammazzare per prenderlo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486398&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'aa44a207-f4cc-48af-b505-f033455401a2\', \'multiverseId\': 486398}, \'multiverseid\': 486398}, {\'name\': \'堅牢な盾仲間\', \'type\': \'クリーチャー — ドワーフ・兵士\', \'flavor\': \'「ドラゴンが貯め込んでいた黄金を使ってんのさ、こいつは！そんで、この浮き彫りはその時に退治したドラゴンの姿だ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486657&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0e5695dd-954e-47a3-9fc4-9e27110396e7\', \'multiverseId\': 486657}, \'multiverseid\': 486657}, {\'name\': \'충실한 방패병\', \'type\': \'생물 — 드워프 병사\', \'flavor\': \'"용의 보물더미에서 가져온 금으로 도금을 했지! 그 위에 새겨져 있는 건 그 금을 챙겨오기 위해 내가 쓰러뜨린 용의 그림이고."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486916&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2744bb62-274d-4a0e-94c6-eb198d894147\', \'multiverseId\': 486916}, \'multiverseid\': 486916}, {\'name\': \'Escudeiro Inabalável\', \'type\': \'Criatura — Anão Soldado\', \'flavor\': \'"Banhado com ouro do tesouro de um dragão, sim, senhor! Com a imagem do dragão que eu matei pra isso gravada."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487175&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c55bd418-5764-40e4-a799-b2a7ffa95fa6\', \'multiverseId\': 487175}, \'multiverseid\': 487175}, {\'name\': \'Непоколебимый Щитоносец\', \'type\': \'Существо — Гном Солдат\', \'flavor\': \'«Да, он покрыт золотом из сокровищницы дракона. И на нем вытравлена морда того самого чудища, что я убил, чтобы разжиться золотишком».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487434&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'62beefdd-ceb9-46bb-a8e1-0688ebc13d02\', \'multiverseId\': 487434}, \'multiverseid\': 487434}, {\'name\': \'可靠护盾手\', \'type\': \'生物 ～矮人／士兵\', \'flavor\': \'「这盾上镀的可都是我从龙穴里面发现的金子！我还特地把杀掉的那条龙样子刻在上面当作纪念。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487693&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'05708708-f709-4618-8c4b-59d9ced518e0\', \'multiverseId\': 487693}, \'multiverseid\': 487693}, {\'name\': \'可靠護盾手\', \'type\': \'生物 ～矮人／士兵\', \'flavor\': \'「這盾上鍍的可都是我從龍穴裡面發現的金子！我還特地把殺掉的那條龍樣子刻在上面當作紀念。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487952&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fde69c8b-9c58-4ddf-a927-48b60dc89fd6\', \'multiverseId\': 487952}, \'multiverseid\': 487952}]', '[{\'name\': \'Stinkbold\', \'text\': \'Fliegend\\n{B}: Der Stinkbold erhält Todesberührung bis zum Ende des Zuges. (Eine beliebige Menge Schadenspunkte, die er einer Kreatur zufügt, sind ausreichend, um diese zu zerstören.)\', \'type\': \'Kreatur — Bold\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485680&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fbee751a-aae4-409c-8f18-7cda25a09f05\', \'multiverseId\': 485680}, \'multiverseid\': 485680}, {\'name\': \'Diablillo fétido\', \'text\': \'Vuela.\\n{B}: El Diablillo fétido gana la habilidad de toque mortal hasta el final del turno. (Cualquier cantidad de daño que haga a una criatura es suficiente para destruirla.)\', \'type\': \'Criatura — Diablillo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485939&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d9e8252b-aaec-477d-8f78-c507bdfa2641\', \'multiverseId\': 485939}, \'multiverseid\': 485939}, {\'name\': \'Diablotin fétide\', \'text\': "Vol\\n{B} : Le Diablotin fétide acquiert le contact mortel jusqu\'à la fin du tour. (Le nombre de blessures qu\'il inflige à une créature, quel qu\'il soit, est suffisant pour la détruire.)", \'type\': \'Créature : diablotin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486198&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f5bf532e-2313-4fa2-a18e-e76772438cff\', \'multiverseId\': 486198}, \'multiverseid\': 486198}, {\'name\': \'Demonietto Mefitico\', \'text\': \'Volare\\n{B}: Il Demonietto Mefitico ha tocco letale fino alla fine del turno. (Qualsiasi danno che infligge a una creatura è sufficiente a distruggerla.)\', \'type\': \'Creatura — Imp\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486457&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ceb31259-e974-4863-bf10-d1c1c7650046\', \'multiverseId\': 486457}, \'multiverseid\': 486457}, {\'name\': \'異臭のインプ\', \'text\': \'飛行\\n{B}：ターン終了時まで、異臭のインプは接死を得る。（それが何らかのダメージをクリーチャーに与えたら、それだけで破壊する。）\', \'type\': \'クリーチャー — インプ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486716&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5738d1da-beae-4929-a9ea-c168752adb0b\', \'multiverseId\': 486716}, \'multiverseid\': 486716}, {\'name\': \'악취 임프\', \'text\': \'비행\\n{B}: 악취 임프는 턴종료까지 치명타를 얻는다. (이 생물에게 피해를 입은 생물은 입은 피해의 양에 상관없이 파괴된다.)\', \'type\': \'생물 — 임프\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486975&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'bbed83a4-bde5-44fa-a666-80044befe37a\', \'multiverseId\': 486975}, \'multiverseid\': 486975}, {\'name\': \'Diabrete Fedido\', \'text\': \'Voar\\n{B}: Diabrete Fedido ganha toque mortífero até o final do turno. (Qualquer quantidade de dano que ele cause a uma criatura é suficiente para destruí-la.)\', \'type\': \'Criatura — Diabrete\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487234&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'80d5c898-2159-43be-bfe2-daf4d7a713b5\', \'multiverseId\': 487234}, \'multiverseid\': 487234}, {\'name\': \'Смрадный Бес\', \'text\': \'Полет\\n{B}: Смрадный Бес получает Смертельное касание до конца хода. (Любое количество повреждений, которое он наносит существу, достаточно, чтобы его уничтожить.)\', \'type\': \'Существо — Бес\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487493&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5da3cae3-6998-40e7-9adc-8d047e0f2c3e\', \'multiverseId\': 487493}, \'multiverseid\': 487493}, {\'name\': \'腥臭小恶魔\', \'text\': \'飞行\\n{B}：腥臭小恶魔获得死触异能直到回合结束。（它对生物造成的任何数量伤害都足以消灭后者。）\', \'type\': \'生物 ～小恶魔\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487752&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'adc1ff36-1f29-4c08-98b6-968502adaee3\', \'multiverseId\': 487752}, \'multiverseid\': 487752}, {\'name\': \'腥臭小惡魔\', \'text\': \'飛行\\n{B}：腥臭小惡魔獲得死觸異能直到回合結束。（它對生物造成的任何數量傷害都足以消滅後者。）\', \'type\': \'生物 ～小惡魔\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488011&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'89f583a6-2cf7-49ab-a8b5-f2ba15a68b44\', \'multiverseId\': 488011}, \'multiverseid\': 488011}]', '[{\'name\': \'Stolze Mieze\', \'text\': \'Wenn die Stolze Mieze ins Spiel kommt, lege eine +1/+1-Marke auf eine Kreatur deiner Wahl, die du kontrollierst.\\nJede Kreatur, die du kontrollierst und auf der mindestens eine +1/+1-Marke liegt, verursacht Trampelschaden. (Sie können überschüssigen Kampfschaden dem verteidigenden Spieler oder Planeswalker zufügen.)\', \'type\': \'Kreatur — Katze\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485778&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6ae999aa-794c-4004-8eb3-bcce6ca05ea5\', \'multiverseId\': 485778}, \'multiverseid\': 485778}, {\'name\': \'Felino engreído\', \'text\': \'Cuando el Felino engreído entre al campo de batalla, pon un contador +1/+1 sobre la criatura objetivo que controlas.\\nCada criatura que controlas con un contador +1/+1 sobre ella tiene la habilidad de arrollar. (Puede hacer el daño de combate sobrante al jugador o planeswalker al que ataca.)\', \'type\': \'Criatura — Felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486037&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9ff7df06-6674-4cdc-aad5-23103fc93d28\', \'multiverseId\': 486037}, \'multiverseid\': 486037}, {\'name\': \'Mitouard de la fierté\', \'text\': "Quand le Mitouard de la fierté arrive sur le champ de bataille, mettez un marqueur +1/+1 sur une créature ciblée que vous contrôlez.\\nChaque créature que vous contrôlez avec un marqueur +1/+1 sur elle a le piétinement. (Elle peut infliger son surplus de blessures de combat au joueur ou au planeswalker qu\'elle attaque.)", \'type\': \'Créature : chat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486296&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a8a4a5c2-446d-4e5e-9b22-62c3d4b2cc38\', \'multiverseId\': 486296}, \'multiverseid\': 486296}, {\'name\': \'Felino Fiero\', \'text\': \'Quando il Felino Fiero entra nel campo di battaglia, metti un segnalino +1/+1 su una creatura bersaglio che controlli.\\nOgni creatura con un segnalino +1/+1 che controlli ha travolgere. (Può infliggere il danno da combattimento in eccesso al giocatore o al planeswalker che sta attaccando.)\', \'type\': \'Creatura — Felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486555&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'264ea5b5-c89f-48c4-89fb-1cfa8ca35184\', \'multiverseId\': 486555}, \'multiverseid\': 486555}, {\'name\': \'誇り猫\', \'text\': \'誇り猫が戦場に出たとき、あなたがコントロールしているクリーチャー１体を対象とし、それの上に＋１/＋１カウンターを１個置く。\\nあなたがコントロールしていて＋１/＋１カウンターが置かれている各クリーチャーはそれぞれトランプルを持つ。（それらは余剰の戦闘ダメージを、それらが攻撃しているプレイヤーやプレインズウォーカーに与えることができる。）\', \'type\': \'クリーチャー — 猫\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486814&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9a60cf9e-3210-4eba-8402-ecb3176e683e\', \'multiverseId\': 486814}, \'multiverseid\': 486814}, {\'name\': \'긍지고양이\', \'text\': \'긍지고양이가 전장에 들어올 때, 당신이 조종하는 생물을 목표로 정한다. 그 생물에 +1/+1 카운터 한 개를 올려놓는다.\\n당신이 조종하는 생물 중 +1/+1 카운터를 가진 각 생물은 돌진을 가진다. (그 생물들은 여분의 전투피해를 자신이 공격 중인 플레이어 또는 플레인즈워커에게 입힐 수 있다.)\', \'type\': \'생물 — 고양이\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487073&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'489145f9-ef77-4440-9b46-39959f9ed6b2\', \'multiverseId\': 487073}, \'multiverseid\': 487073}, {\'name\': \'Bichano Brioso\', \'text\': \'Quando Bichano Brioso entrar no campo de batalha, coloque um marcador +1/+1 na criatura alvo que você controla.\\nCada criatura que você controla com um marcador +1/+1 tem atropelar. (Elas podem causar seu dano de combate excedente ao jogador ou planeswalker que elas estiverem atacando.)\', \'type\': \'Criatura — Felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487332&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dc88a1d5-2e13-4022-af08-03be0f2a407a\', \'multiverseId\': 487332}, \'multiverseid\': 487332}, {\'name\': \'Горделивый Кот\', \'text\': "Когда Горделивый Кот выходит на поле битвы, положите один жетон +1/+1 на целевое существо под вашим контролем.\\nКаждое существо под вашим контролем, на котором есть жетон +1/+1, имеет Пробивной удар. (Оно может нанести избыточные боевые повреждения игроку или planeswalker\'у, которого атакует.)", \'type\': \'Существо — Кошка\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487591&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'241329f6-0020-406e-96cc-848a1d7c295e\', \'multiverseId\': 487591}, \'multiverseid\': 487591}, {\'name\': \'高傲斑猫\', \'text\': \'当高傲斑猫进战场时，在目标由你操控的生物上放置一个+1/+1指示物。\\n每个由你操控且其上有+1/+1指示物的生物均具有践踏异能。（它们造成之过量战斗伤害能对所攻击的牌手或鹏洛客造成之。）\', \'type\': \'生物 ～猫\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487850&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'95e881f3-ad4a-49a9-bf43-9982468784e9\', \'multiverseId\': 487850}, \'multiverseid\': 487850}, {\'name\': \'高傲斑貓\', \'text\': \'當高傲斑貓進戰場時，在目標由你操控的生物上放置一個+1/+1指示物。\\n每個由你操控且其上有+1/+1指示物的生物均具有踐踏異能。（它們造成之過量戰鬥傷害能對所攻擊的玩家或鵬洛客造成之。）\', \'type\': \'生物 ～貓\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488109&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'67a5f0df-e2b4-45e7-a1e0-66f7e2aedfd8\', \'multiverseId\': 488109}, \'multiverseid\': 488109}]', '[{\'name\': \'Streitross der Morgendämmerung\', \'text\': \'Wenn das Streitross der Morgendämmerung ins Spiel kommt, erhält eine Kreatur deiner Wahl +2/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Einhorn\', \'flavor\': \'Wenn es über den Horizont galoppiert, wird es oft mit der Morgenröte verwechselt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485596&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dd9e366d-2f3f-466d-bc0c-d75e16afb443\', \'multiverseId\': 485596}, \'multiverseid\': 485596}, {\'name\': \'Corcel del alba\', \'text\': \'Cuando el Corcel del alba entre al campo de batalla, la criatura objetivo obtiene +2/+0 hasta el final del turno.\', \'type\': \'Criatura — Unicornio\', \'flavor\': \'Se le suele confundir con el albor del amanecer cuando galopa por el horizonte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485855&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1f28e744-ee87-45ed-8af4-55fb634c0eba\', \'multiverseId\': 485855}, \'multiverseid\': 485855}, {\'name\': "Batailleur de l\'aube", \'text\': "Quand le Batailleur de l\'aube arrive sur le champ de bataille, la créature ciblée gagne +2/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : licorne\', \'flavor\': "On le confond souvent avec le soleil levant lorsqu\'il galope à l\'horizon.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486114&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0c34277b-e87a-43c6-b675-c313e1a0ebe2\', \'multiverseId\': 486114}, \'multiverseid\': 486114}, {\'name\': "Destriero dell\'Aurora", \'text\': "Quando il Destriero dell\'Aurora entra nel campo di battaglia, una creatura bersaglio prende +2/+0 fino alla fine del turno.", \'type\': \'Creatura — Unicorno\', \'flavor\': "Quando galoppa all\'orizzonte, viene spesso scambiato per le prime luci dell\'alba.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486373&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6bb4b102-6d6f-4c5f-87ff-8e68478ed508\', \'multiverseId\': 486373}, \'multiverseid\': 486373}, {\'name\': \'夜明けの突撃獣\', \'text\': \'夜明けの突撃獣が戦場に出たとき、クリーチャー１体を対象とする。ターン終了時まで、それは＋２/＋０の修整を受ける。\', \'type\': \'クリーチャー — ユニコーン\', \'flavor\': \'地平線から駆けてくる様子は、しばしば早すぎる夜明けと間違われる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486632&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'97b0fd64-4f15-4538-8aee-0cb58102d650\', \'multiverseId\': 486632}, \'multiverseid\': 486632}, {\'name\': \'여명의 돌격자\', \'text\': \'여명의 돌격자가 전장에 들어올 때, 생물을 목표로 정한다. 그 생물은 턴종료까지 +2/+0을 받는다.\', \'type\': \'생물 — 유니콘\', \'flavor\': \'그것이 수평선을 전속력으로 질주해 가로지르면 종종 여명이 밝아 오는 것으로 오인받는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486891&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2dfc71b5-bc90-41fe-a04a-c1b8fd804828\', \'multiverseId\': 486891}, \'multiverseid\': 486891}, {\'name\': \'Corcel da Alvorada\', \'text\': \'Quando Corcel da Alvorada entra no campo de batalha, a criatura alvo recebe +2/+0 até o final do turno.\', \'type\': \'Criatura — Unicórnio\', \'flavor\': \'Ele é frequentemente confundido com o raiar do dia ao galopar pelo horizonte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487150&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d7710210-a912-4eba-94be-ef5781a53824\', \'multiverseId\': 487150}, \'multiverseid\': 487150}, {\'name\': \'Рысак Рассвета\', \'text\': \'Когда Рысак Рассвета выходит на поле битвы, целевое существо получает +2/+0 до конца хода.\', \'type\': \'Существо — Единорог\', \'flavor\': \'Когда он скачет где-то на горизонте, его нередко принимают за занимающуюся зарю.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487409&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b433b3ab-364f-4fb8-bd42-b893680c6e57\', \'multiverseId\': 487409}, \'multiverseid\': 487409}, {\'name\': \'破晓角驹\', \'text\': \'当破晓角驹进战场时，目标生物得+2/+0直到回合结束。\', \'type\': \'生物 ～独角兽\', \'flavor\': \'它在地平线远端的驰骋身影，常常让人误以为曙光将至。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487668&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'23f4f098-0769-4206-a152-a5f63ff57d7a\', \'multiverseId\': 487668}, \'multiverseid\': 487668}, {\'name\': \'破曉角駒\', \'text\': \'當破曉角駒進戰場時，目標生物得+2/+0直到回合結束。\', \'type\': \'生物 ～獨角獸\', \'flavor\': \'牠在地平線遠端的馳騁身影，常常讓人誤以為曙光將至。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487927&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ac9345e7-8301-43fb-a660-0e16587e47fe\', \'multiverseId\': 487927}, \'multiverseid\': 487927}]', "[{'name': 'Sturzbachklippen', 'text': 'Die Sturzbachklippen kommen getappt ins Spiel.\\nWenn die Sturzbachklippen ins Spiel kommen, erhältst du 1 Lebenspunkt dazu.\\n{T}: Erzeuge {U} oder {R}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485833&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'ecb004e6-6fa1-4988-b49c-4d4ff555400b', 'multiverseId': 485833}, 'multiverseid': 485833}, {'name': 'Acantilados aguasraudas', 'text': 'Los Acantilados aguasraudas entran al campo de batalla girados.\\nCuando los Acantilados aguasraudas entren al campo de batalla, ganas 1 vida.\\n{T}: Agrega {U} o {R}.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486092&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'b2f62d14-6a9b-4af3-8e75-9722e2ee7215', 'multiverseId': 486092}, 'multiverseid': 486092}, {'name': 'Falaises des eaux vives', 'text': 'Les Falaises des eaux vives arrivent sur le champ de bataille engagées.\\nQuand les Falaises des eaux vives arrivent sur le champ de bataille, vous gagnez 1 point de vie.\\n{T} : Ajoutez {U} ou {R}.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486351&type=card', 'language': 'French', 'identifiers': {'scryfallId': '00462f77-1bdf-47a9-ae23-f86ee8b3d8d5', 'multiverseId': 486351}, 'multiverseid': 486351}, {'name': 'Rupi di Rapidacque', 'text': 'Le Rupi di Rapidacque entrano nel campo di battaglia TAPpate.\\nQuando le Rupi di Rapidacque entrano nel campo di battaglia, guadagni 1 punto vita.\\n{T}: Aggiungi {U} o {R}.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486610&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '7dc4119d-cc3c-4f76-9e47-e9c7ef181e31', 'multiverseId': 486610}, 'multiverseid': 486610}, {'name': '急流の崖', 'text': '急流の崖はタップ状態で戦場に出る。\\n急流の崖が戦場に出たとき、あなたは１点のライフを得る。\\n{T}：{U}か{R}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486869&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '539694c3-59fd-402e-875b-c77e23c02016', 'multiverseId': 486869}, 'multiverseid': 486869}, {'name': '빠른물 벼랑', 'text': '빠른물 벼랑은 탭된 채로 전장에 들어온다.\\n빠른물 벼랑이 전장에 들어올 때, 당신은 생명 1점을 얻는다.\\n{T}: {U} 또는 {R}를 추가한다.', 'type': '대지', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487128&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '204fa63a-efb0-499d-8074-4ca565fb2549', 'multiverseId': 487128}, 'multiverseid': 487128}, {'name': 'Cordilheiras das Cascatas', 'text': 'Cordilheiras das Cascatas entra no campo de batalha virado.\\nQuando Cordilheiras das Cascatas entra no campo de batalha, você ganha 1 ponto de vida.\\n{T}: Adicione {U} ou {R}.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487387&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '749d29fd-740d-4f06-8590-8f64ce88cc64', 'multiverseId': 487387}, 'multiverseid': 487387}, {'name': 'Скальные Стремнины', 'text': 'Скальные Стремнины выходят на поле битвы повернутыми.\\nКогда Скальные Стремнины выходят на поле битвы, вы получаете 1 жизнь.\\n{T}: добавьте {U} или {R}.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487646&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '0d2dd0b6-a8e6-4692-8b21-edddf3887c5e', 'multiverseId': 487646}, 'multiverseid': 487646}, {'name': '急流山崖', 'text': '急流山崖须横置进战场。\\n当急流山崖进战场时，你获得1点生命。\\n{T}：加{U}或{R}。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487905&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '2db416a9-941f-491b-b810-05fec84476f9', 'multiverseId': 487905}, 'multiverseid': 487905}, {'name': '急流山崖', 'text': '急流山崖須橫置進戰場。\\n當急流山崖進戰場時，你獲得1點生命。\\n{T}：加{U}或{R}。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488164&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'a68d0c9c-541e-47b7-8e74-9436810be53d', 'multiverseId': 488164}, 'multiverseid': 488164}]", '[{\'name\': \'Stärkender Schub\', \'text\': \'Lege eine +1/+1-Marke auf eine Kreatur deiner Wahl, die du kontrollierst, dann verdopple die Anzahl der +1/+1-Marken auf der Kreatur.\', \'type\': \'Spontanzauber\', \'flavor\': \'Für Hydras gilt: Die meisten Probleme lassen sich durch ein paar zusätzliche Köpfe lösen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485772&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a1690756-e94b-412c-8f39-ccef9848ebf4\', \'multiverseId\': 485772}, \'multiverseid\': 485772}, {\'name\': \'Ímpetu tonificante\', \'text\': \'Pon un contador +1/+1 sobre la criatura objetivo que controlas, luego duplica la cantidad de contadores +1/+1 sobre esa criatura.\', \'type\': \'Instantáneo\', \'flavor\': \'Para las hidras, la mayoría de problemas se pueden solucionar con un par de cabezas más.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486031&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cacf6ab3-2acb-4424-9088-14af5f0238b3\', \'multiverseId\': 486031}, \'multiverseid\': 486031}, {\'name\': \'Déferlement revigorant\', \'text\': \'Mettez un marqueur +1/+1 sur une créature ciblée que vous contrôlez, puis doublez le nombre de marqueurs +1/+1 sur cette créature.\', \'type\': \'Éphémère\', \'flavor\': "Chez les hydres, la plupart des problèmes peuvent se résoudre avec l\'ajout de quelques têtes supplémentaires.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486290&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3742c964-5d0c-4000-b9b0-8b246c006814\', \'multiverseId\': 486290}, \'multiverseid\': 486290}, {\'name\': \'Impulso Rinvigorente\', \'text\': \'Metti un segnalino +1/+1 su una creatura bersaglio che controlli, poi raddoppia il numero di segnalini +1/+1 su quella creatura.\', \'type\': \'Istantaneo\', \'flavor\': \'Per le idre, la maggior parte dei problemi sono risolvibili aggiungendo qualche testa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486549&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c053ce78-49f3-4d7d-bde2-263be485b7a7\', \'multiverseId\': 486549}, \'multiverseid\': 486549}, {\'name\': \'活性化のうねり\', \'text\': \'あなたがコントロールしているクリーチャー１体を対象とする。それの上に＋１/＋１カウンターを１個置き、その後、そのクリーチャーの上に置かれている＋１/＋１カウンターの個数を２倍にする。\', \'type\': \'インスタント\', \'flavor\': \'ハイドラの場合、大抵の問題は頭を増やせば解決する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486808&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d4025cea-0225-4da0-b88b-bf60167906cd\', \'multiverseId\': 486808}, \'multiverseid\': 486808}, {\'name\': \'활력 급등\', \'text\': \'당신이 조종하는 생물을 목표로 정한다. 그 생물에 +1/+1 카운터 한 개를 올려놓는 후, 그 생물에 놓여 있는 +1/+1 카운터의 수를 두 배로 한다.\', \'type\': \'순간마법\', \'flavor\': \'히드라에게는, 대부분의 문제가 머리를 몇 개 추가하면 해결할 수 있는 일이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487067&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3b24654c-05c9-4d3c-bf72-984ecde9de6a\', \'multiverseId\': 487067}, \'multiverseid\': 487067}, {\'name\': \'Surto Revigorante\', \'text\': \'Coloque um marcador +1/+1 na criatura alvo que você controla. Em seguida, dobre o número de marcadores +1/+1 naquela criatura.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Para as hidras, a maioria dos problemas se resolve com umas cabeças a mais.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487326&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'56129358-3b4b-452e-8f05-5d94231dfd3f\', \'multiverseId\': 487326}, \'multiverseid\': 487326}, {\'name\': \'Прилив Жизни\', \'text\': \'Положите один жетон +1/+1 на целевое существо под вашим контролем, затем удвойте количество жетонов +1/+1 на том существе.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Большинство своих затруднений гидры могут разрешить, отрастив пару дополнительных голов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487585&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2695902b-1172-4dc9-bc5d-8b208e3c326c\', \'multiverseId\': 487585}, \'multiverseid\': 487585}, {\'name\': \'鼓舞翻腾\', \'text\': \'在目标由你操控的生物上放置一个+1/+1指示物，然后将该生物上的+1/+1指示物数量加倍。\', \'type\': \'瞬间\', \'flavor\': \'对多头龙来说，大多数问题只要多加几个头就能解决。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487844&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b521fcad-41e9-40b1-abe0-b8548980c7b6\', \'multiverseId\': 487844}, \'multiverseid\': 487844}, {\'name\': \'鼓舞翻騰\', \'text\': \'在目標由你操控的生物上放置一個+1/+1指示物，然後將該生物上的+1/+1指示物數量加倍。\', \'type\': \'瞬間\', \'flavor\': \'對多頭龍來說，大多數問題只要多加幾個頭就能解決。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488103&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3fa2e7d3-ef33-43cf-8e2f-0575aa44e127\', \'multiverseId\': 488103}, \'multiverseid\': 488103}]', '[{\'name\': \'Störrischer Dilophosaurus\', \'text\': \'Todesberührung (Eine beliebige Menge Schadenspunkte, die er einer Kreatur zufügt, sind ausreichend, um diese zu zerstören.)\\nImmer wenn der Störrische Dilophosaurus angreift und falls du eine Kreatur mit Stärke 4 oder mehr kontrollierst, erhält der Störrische Dilophosaurus +2/+2 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Dinosaurier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485776&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6e35ee5f-2c0d-44ad-afbe-82aa768f6686\', \'multiverseId\': 485776}, \'multiverseid\': 485776}, {\'name\': \'Dilofosaurio iracundo\', \'text\': \'Toque mortal. (Cualquier cantidad de daño que esto haga a una criatura es suficiente para destruirla.)\\nSiempre que el Dilofosaurio iracundo ataque, si controlas una criatura con fuerza de 4 o más, el Dilofosaurio iracundo obtiene +2/+2 hasta el final del turno.\', \'type\': \'Criatura — Dinosaurio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486035&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b848e237-d2b8-4402-b335-3ed8aafb7b27\', \'multiverseId\': 486035}, \'multiverseid\': 486035}, {\'name\': \'Dilophosaure hargneux\', \'text\': "Contact mortel (Le nombre de blessures que cette créature inflige à une créature, quel qu\'il soit, est suffisant pour la détruire.)\\nÀ chaque fois que le Dilophosaure hargneux attaque, si vous contrôlez une créature de force supérieure ou égale à 4, le Dilophosaure hargneux gagne +2/+2 jusqu\'à la fin du tour.", \'type\': \'Créature : dinosaure\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486294&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'080c9fbb-6d6c-4c1e-b7a3-e40a48af0292\', \'multiverseId\': 486294}, \'multiverseid\': 486294}, {\'name\': \'Dilofosauro Irascibile\', \'text\': \'Tocco letale (Qualsiasi danno che questa creatura infligge a una creatura è sufficiente a distruggerla.)\\nOgniqualvolta il Dilofosauro Irascibile attacca, se controlli una creatura con forza pari o superiore a 4, il Dilofosauro Irascibile prende +2/+2 fino alla fine del turno.\', \'type\': \'Creatura — Dinosauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486553&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4c395eb1-e768-49f5-919d-39aac37c152d\', \'multiverseId\': 486553}, \'multiverseid\': 486553}, {\'name\': \'気難しいディロフォサウルス\', \'text\': \'接死（これが何らかのダメージをクリーチャーに与えたら、それだけで破壊する。）\\n気難しいディロフォサウルスが攻撃するたび、あなたがパワーが４以上のクリーチャーをコントロールしている場合、ターン終了時まで、気難しいディロフォサウルスは＋２/＋２の修整を受ける。\', \'type\': \'クリーチャー — 恐竜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486812&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9ec62f66-92f7-4fd2-9da2-3c1d5a190912\', \'multiverseId\': 486812}, \'multiverseid\': 486812}, {\'name\': \'성질 더러운 딜로포사우루스\', \'text\': \'치명타 (이 생물에게 피해를 입은 생물은 피해의 양에 상관없이 파괴된다.)\\n성질 더러운 딜로포사우루스가 공격할 때마다, 당신이 공격력이 4 이상인 생물을 조종한다면, 성질 더러운 딜로포사우루스는 턴종료까지 +2/+2를 받는다.\', \'type\': \'생물 — 공룡\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487071&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3c341c01-b95e-40db-9221-fc7950de3b52\', \'multiverseId\': 487071}, \'multiverseid\': 487071}, {\'name\': \'Dilofossauro Turrão\', \'text\': \'Toque mortífero (Qualquer quantidade de dano que esta criatura cause a uma criatura é suficiente para destruí-la.)\\nToda vez que Dilofossauro Turrão ataca, se você controla uma criatura com poder igual ou superior a 4, Dilofossauro Turrão recebe +2/+2 até o final do turno.\', \'type\': \'Criatura — Dinossauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487330&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fb6d8788-1c16-4f1c-9529-189f21ec40f7\', \'multiverseId\': 487330}, \'multiverseid\': 487330}, {\'name\': \'Норовистый Дилофозавр\', \'text\': \'Смертельное касание (Любое количество повреждений, которое этот объект наносит существу, достаточно, чтобы его уничтожить.)\\nКаждый раз, когда Норовистый Дилофозавр атакует, если вы контролируете существо с силой 4 или больше, то Норовистый Дилофозавр получает +2/+2 до конца хода.\', \'type\': \'Существо — Динозавр\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487589&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6ae75e8b-af25-4002-9824-46435097aff4\', \'multiverseId\': 487589}, \'multiverseid\': 487589}, {\'name\': \'暴躁双冠龙\', \'text\': \'死触（它对生物造成的任何数量伤害都足以消灭后者。）\\n每当暴躁双冠龙攻击时，若你操控力量等于或大于4的生物，则暴躁双冠龙得+2/+2直到回合结束。\', \'type\': \'生物 ～恐龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487848&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f08f5ac2-027b-48fd-b646-9d684490a858\', \'multiverseId\': 487848}, \'multiverseid\': 487848}, {\'name\': \'暴躁雙冠龍\', \'text\': \'死觸（它對生物造成的任何數量傷害都足以消滅後者。）\\n每當暴躁雙冠龍攻擊時，若你操控力量等於或大於4的生物，則暴躁雙冠龍得+2/+2直到回合結束。\', \'type\': \'生物 ～恐龍\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488107&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1418ad64-4f8b-4f97-95a7-97e88f45a674\', \'multiverseId\': 488107}, \'multiverseid\': 488107}]', '[{\'name\': \'Subira, Tulzidi-Karawanenführerin\', \'text\': \'Eile\\n{1}: Eine andere Kreatur deiner Wahl mit Stärke 2 oder weniger kann in diesem Zug nicht geblockt werden.\\n{1}{R}, {T}, wirf alle Karten aus deiner Hand ab: Immer wenn bis zum Ende des Zuges eine Kreatur mit Stärke 2 oder weniger, die du kontrollierst, einem Spieler Kampfschaden zufügt, ziehe eine Karte.\', \'type\': \'Legendäre Kreatur — Mensch, Schamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485744&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2b3ef537-b4fc-4a79-b24e-5d13e7b53fbc\', \'multiverseId\': 485744}, \'multiverseid\': 485744}, {\'name\': \'Subira, caravanista tulzidi\', \'text\': \'Prisa.\\n{1}: Otra criatura objetivo con fuerza de 2 o menos no puede ser bloqueada este turno.\\n{1}{R}, {T}, descartar tu mano: Hasta el final del turno, siempre que una criatura que controlas con fuerza de 2 o menos haga daño de combate a un jugador, roba una carta.\', \'type\': \'Criatura legendaria — Chamán humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486003&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'75798e3b-1f6b-4591-bbb2-bac03e22fd2f\', \'multiverseId\': 486003}, \'multiverseid\': 486003}, {\'name\': \'Soubira, caravanière des Tulzidi\', \'text\': "Célérité\\n{1} : Une autre créature ciblée de force inférieure ou égale à 2 ne peut pas être bloquée ce tour-ci.\\n{1}{R}, {T}, défaussez-vous de votre main : Jusqu\'à la fin du tour, à chaque fois qu\'une créature de force inférieure ou égale à 2 que vous contrôlez inflige des blessures de combat à un joueur, piochez une carte.", \'type\': \'Créature légendaire : humain et shamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486262&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b96a8def-e310-4292-9d09-65f44073bc26\', \'multiverseId\': 486262}, \'multiverseid\': 486262}, {\'name\': \'Subira, Carovaniera Tulzidi\', \'text\': "Rapidità\\n{1}: Un\'altra creatura bersaglio con forza pari o inferiore a 2 non può essere bloccata in questo turno.\\n{1}{R}, {T}, Scarta la tua mano: Fino alla fine del turno, ogniqualvolta una creatura che controlli con forza pari o inferiore a 2 infligge danno da combattimento a un giocatore, pesca una carta.", \'type\': \'Creatura Leggendaria — Sciamano Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486521&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ecbf9d22-e372-4f36-bd0b-7551e30accd9\', \'multiverseId\': 486521}, \'multiverseid\': 486521}, {\'name\': \'タルジーディの隊商、スビラ\', \'text\': \'速攻\\n{1}：他の、パワーが２以下のクリーチャー１体を対象とする。このターン、それはブロックされない。\\n{1}{R}, {T}, あなたの手札を捨てる：ターン終了時まで、あなたがコントロールしていてパワーが２以下のクリーチャー１体がプレイヤー１人に戦闘ダメージを与えるたび、カードを１枚引く。\', \'type\': \'伝説のクリーチャー — 人間・シャーマン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486780&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bd94c03b-27a7-42a6-8bff-29ecd9adb393\', \'multiverseId\': 486780}, \'multiverseid\': 486780}, {\'name\': \'툴지디 상단 대장, 수비라\', \'text\': \'신속\\n{1}: 공격력이 2 이하인 다른 생물을 목표로 정한다. 이번 턴에 그 생물은 방어될 수 없다.\\n{1}{R}, {T}, 당신의 손을 버린다: 턴종료까지, 당신이 조종하는 공격력이 2 이하인 생물이 플레이어에게 전투피해를 입힐 때마다, 카드 한 장을 뽑는다.\', \'type\': \'전설적 생물 — 인간 주술사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487039&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c38a2139-aac1-425f-a045-c8c2ddb6ed04\', \'multiverseId\': 487039}, \'multiverseid\': 487039}, {\'name\': \'Subira, Caravaneira Tulzidi\', \'text\': \'Ímpeto\\n{1}: Outra criatura alvo com poder igual ou inferior a 2 não pode ser bloqueada neste turno.\\n{1}{R}, {T}, descarte sua mão: Até o final do turno, toda vez que uma criatura que você controla com poder igual ou inferior a 2 causar dano de combate a um jogador, compre um card.\', \'type\': \'Criatura Lendária — Humano Xamã\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487298&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6f20ee36-e325-49e4-9f9b-23befc7553fa\', \'multiverseId\': 487298}, \'multiverseid\': 487298}, {\'name\': \'Субира, Караванщица Тулзиди\', \'text\': \'Ускорение\\n{1}: другое целевое существо с силой не более 2 не может быть заблокировано в этом ходу.\\n{1}{R}, {T}, сбросьте вашу руку: до конца хода каждый раз, когда существо под вашим контролем с силой не более 2 наносит боевые повреждения игроку, возьмите карту.\', \'type\': \'Легендарное Существо — Человек Шаман\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487557&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ac8f077c-1918-4b97-9588-239978f8d61f\', \'multiverseId\': 487557}, \'multiverseid\': 487557}, {\'name\': \'图兹迪商队长苏碧拉\', \'text\': \'敏捷\\n{1}：另一个目标力量等于或小于2的生物本回合不能被阻挡。\\n{1}{R}，{T}，弃掉你的手牌：直到回合结束，每当一个由你操控且力量等于或小于2的生物对任一牌手造成战斗伤害时，抓一张牌。\', \'type\': \'传奇生物 ～人类／祭师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487816&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3ad9e30e-f518-4a6d-9f7f-ef1b15952dcf\', \'multiverseId\': 487816}, \'multiverseid\': 487816}, {\'name\': \'圖茲迪商隊長蘇碧拉\', \'text\': \'敏捷\\n{1}：另一個目標力量等於或小於2的生物本回合不能被阻擋。\\n{1}{R}，{T}，棄掉你的手牌：直到回合結束，每當一個由你操控且力量等於或小於2的生物對任一玩家造成戰鬥傷害時，抽一張牌。\', \'type\': \'傳奇生物 ～人類／祭師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488075&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'02ce6c0d-1710-407b-a3bb-36b0c91a8bad\', \'multiverseId\': 488075}, \'multiverseid\': 488075}]', "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488482&type=card', 'language': 'German', 'identifiers': {'scryfallId': '50911a90-5f22-417f-b2f8-515e305d0976', 'multiverseId': 488482}, 'multiverseid': 488482}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488497&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4f855802-be04-4af0-a2ee-317bee0f5d25', 'multiverseId': 488497}, 'multiverseid': 488497}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488512&type=card', 'language': 'French', 'identifiers': {'scryfallId': '24acaa4d-fe12-4bfa-b52c-e65e92cab569', 'multiverseId': 488512}, 'multiverseid': 488512}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488527&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3eac89d2-71fa-447c-96af-5f3a17e5d531', 'multiverseId': 488527}, 'multiverseid': 488527}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488542&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'e7a93d77-ef1d-4c2c-afa2-2da1d3218a42', 'multiverseId': 488542}, 'multiverseid': 488542}, {'name': '늪', 'type': '기본 대지 — 늪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488557&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '1041ac61-c830-4689-985d-28e9a9a91daf', 'multiverseId': 488557}, 'multiverseid': 488557}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488572&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b06726c8-726f-4058-a06b-46cde19c8378', 'multiverseId': 488572}, 'multiverseid': 488572}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488587&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'c3621082-badc-4d87-91f7-6e8fc1219ba8', 'multiverseId': 488587}, 'multiverseid': 488587}, {'name': '沼泽', 'type': '基本地 ～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488602&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '64d6607f-8ef6-4d19-b752-555bd5662a44', 'multiverseId': 488602}, 'multiverseid': 488602}, {'name': '沼澤', 'type': '基本地 ～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488617&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '792ed1fd-d80b-48b0-8fec-38079be95520', 'multiverseId': 488617}, 'multiverseid': 488617}]", "[{'name': 'Sumpf', 'type': 'Standar