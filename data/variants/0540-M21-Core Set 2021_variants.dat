Handlers/Image.ashx?multiverseid=488529&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '72c60b2e-17d3-4c68-b93d-aa20532a2625', 'multiverseId': 488529}, 'multiverseid': 488529}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488544&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '83983f30-dff8-46e6-bed8-dd08b851e466', 'multiverseId': 488544}, 'multiverseid': 488544}, {'name': '늪', 'type': '기본 대지 — 늪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488559&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '334a1c3f-d03c-4301-abde-cc1c06ad371e', 'multiverseId': 488559}, 'multiverseid': 488559}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488574&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'be41aea2-fd1c-4d98-9c92-121d5fcb1fda', 'multiverseId': 488574}, 'multiverseid': 488574}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488589&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '75a2f43d-c218-4c85-839a-8b663d4bdbbb', 'multiverseId': 488589}, 'multiverseid': 488589}, {'name': '沼泽', 'type': '基本地 ～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488604&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'ace62dff-1fef-4622-8c10-1da9f62e20ea', 'multiverseId': 488604}, 'multiverseid': 488604}, {'name': '沼澤', 'type': '基本地 ～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488619&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '8e568efc-3b39-42a8-b755-7b630d642f02', 'multiverseId': 488619}, 'multiverseid': 488619}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488853&type=card', 'language': 'German', 'identifiers': {'scryfallId': '02a13fa6-ff4e-4794-be31-167af8806771', 'multiverseId': 488853}, 'multiverseid': 488853}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488858&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '56b2217c-9ca7-48b7-8340-724b2d6a9d4a', 'multiverseId': 488858}, 'multiverseid': 488858}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488863&type=card', 'language': 'French', 'identifiers': {'scryfallId': '594e2fd7-65be-404a-aef2-3aa362350e0c', 'multiverseId': 488863}, 'multiverseid': 488863}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488868&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '2e6b5b42-1d24-4796-9393-6f4a2ee77148', 'multiverseId': 488868}, 'multiverseid': 488868}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488873&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '97ef5bb6-9a0c-4cb4-96fc-b4836275ccf9', 'multiverseId': 488873}, 'multiverseid': 488873}, {'name': '늪', 'type': '기본 대지 — 늪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488878&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '7cf49833-24e1-4288-a747-6c10ee44176f', 'multiverseId': 488878}, 'multiverseid': 488878}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488883&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'def107a6-1a2e-4cdc-85c8-37f3a0283401', 'multiverseId': 488883}, 'multiverseid': 488883}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488888&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'b3374691-2183-4331-9b48-233b07e64a7a', 'multiverseId': 488888}, 'multiverseid': 488888}, {'name': '沼泽', 'type': '基本地 ～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488893&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '5f287e0a-a7c4-4057-8d0a-56360db8c66a', 'multiverseId': 488893}, 'multiverseid': 488893}, {'name': '沼澤', 'type': '基本地 ～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488898&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '75066fc5-51d9-4675-8d1a-30035e64d4b1', 'multiverseId': 488898}, 'multiverseid': 488898}]", '[{\'name\': \'Säbelzahnreißer\', \'text\': \'Zu Beginn deines Endsegments und falls in diesem Zug eine Kreatur gestorben ist, lege eine +1/+1-Marke auf den Säbelzahnreißer und enttappe ihn.\', \'type\': \'Kreatur — Katze\', \'flavor\': \'„Ich hoffe, dass der Dummkopf, der diese Kreaturen im Dschungel ausgesetzt hat, als Erster gefressen wurde."\\n—Opar, Führer-Veteran\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485784&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1bbaa997-76bd-453f-9a31-9cbe64f7e409\', \'multiverseId\': 485784}, \'multiverseid\': 485784}, {\'name\': \'Dientes de sable agresivo\', \'text\': \'Al comienzo de tu paso final, si una criatura murió este turno, pon un contador +1/+1 sobre el Dientes de sable agresivo y enderézalo.\', \'type\': \'Criatura — Felino\', \'flavor\': \'"Ojalá el idiota que trajo a estas criaturas a la jungla fuese su primera comida".\\n—Ópar, guía experto\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486043&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'99f8c5c2-c33d-46d0-8b2a-8fd4b71de53e\', \'multiverseId\': 486043}, \'multiverseid\': 486043}, {\'name\': \'Meurtrisseur à dents de sabre\', \'text\': \'Au début de votre étape de fin, si une créature est morte ce tour-ci, mettez un marqueur +1/+1 sur le Meurtrisseur à dents de sabre et dégagez-le.\', \'type\': \'Créature : chat\', \'flavor\': "« J\'espère que l\'imbécile qui a introduit ces créatures dans la jungle leur a servi de premier repas. »\\n—Opar, guide chevronné", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486302&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'990a8feb-f9cf-4681-8be1-90836f54d849\', \'multiverseId\': 486302}, \'multiverseid\': 486302}, {\'name\': \'Sbranatore dai Denti a Sciabola\', \'text\': "All\'inizio della tua sottofase finale, se è morta una creatura in questo turno, metti un segnalino +1/+1 sullo Sbranatore dai Denti a Sciabola e STAPpalo.", \'type\': \'Creatura — Felino\', \'flavor\': \'"Spero che l\\\'idiota che ha portato queste creature nella giungla sia stato il loro primo pasto."\\n—Opar, guida veterana\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486561&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b0eea652-b410-47c6-b6f5-1ede67273086\', \'multiverseId\': 486561}, \'multiverseid\': 486561}, {\'name\': \'剣歯虎のやっかいもの\', \'text\': \'あなたの終了ステップの開始時に、このターンにクリーチャーが死亡していた場合、剣歯虎のやっかいものの上に＋１/＋１カウンターを１個置き、これをアンタップする。\', \'type\': \'クリーチャー — 猫\', \'flavor\': \'「こいつらをジャングルに放った愚か者が、こいつらの最初の餌であったことを願う。」\\n――老練の案内人、オパル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486820&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'24af899c-0b22-4ba1-8103-167779915bae\', \'multiverseId\': 486820}, \'multiverseid\': 486820}, {\'name\': \'내리치는 검치호\', \'text\': \'당신의 종료단 시작에, 이번 턴에 생물이 죽었다면, 내리치는 검치호에 +1/+1 카운터 한 개를 올려놓고 내리치는 검치호를 언탭한다.\', \'type\': \'생물 — 고양이\', \'flavor\': \'"저 생물들을 이 정글에 처음 데리고 온 바보들이 저것들의 첫 번째 식사거리였다면 좋겠는걸."\\n—전문 안내인, 오파르\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487079&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ed89bb41-0157-4a62-93f7-484d2049832a\', \'multiverseId\': 487079}, \'multiverseid\': 487079}, {\'name\': \'Esmagador Dente-de-sabre\', \'text\': \'No início de sua etapa final, se uma criatura morreu neste turno, coloque um marcador +1/+1 em Esmagador Dente-de-sabre e desvire-o.\', \'type\': \'Criatura — Felino\', \'flavor\': \'"Eu espero que o idiota que trouxe essas criaturas pra essa selva tenha sido a primeira refeição delas."\\n— Opar, guia experiente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487338&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'73d60f89-c9c1-4ac0-b5ef-a7e14f3db719\', \'multiverseId\': 487338}, \'multiverseid\': 487338}, {\'name\': \'Саблезубый Истязатель\', \'text\': \'В начале вашего заключительного шага, если в этом ходу умерло существо, положите один жетон +1/+1 на Саблезубого Истязателя и разверните его.\', \'type\': \'Существо — Кошка\', \'flavor\': \'«Надеюсь, что того кретина, который выпустил этих тварей в джунгли, они первым делом и сожрали».\\n— Опар, опытный проводник\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487597&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c49a763c-4757-4524-9469-7b058f1b6b34\', \'multiverseId\': 487597}, \'multiverseid\': 487597}, {\'name\': \'撕咬剑齿虎\', \'text\': \'在你的结束步骤开始时，若本回合中有生物死去，则在撕咬剑齿虎上放置一个+1/+1指示物并重置它。\', \'type\': \'生物 ～猫\', \'flavor\': \'「不管这些生物是被谁引到丛林里来的，我希望它们在这里的第一餐就把那些傻瓜都吃掉。」\\n～资深向导欧帕尔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487856&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'737b3f06-603b-4f0f-96a3-0e6a1befc3db\', \'multiverseId\': 487856}, \'multiverseid\': 487856}, {\'name\': \'撕咬劍齒虎\', \'text\': \'在你的結束步驟開始時，若本回合中有生物死去，則在撕咬劍齒虎上放置一個+1/+1指示物並重置它。\', \'type\': \'生物 ～貓\', \'flavor\': \'「不管這些生物是被誰引到叢林裡來的，我希望牠們在這裡的第一餐就把那些傻瓜都吃掉。」\\n～資深嚮導歐帕爾\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488115&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f23528b3-883e-48f0-a79c-23840519d21c\', \'multiverseId\': 488115}, \'multiverseid\': 488115}]', '[{\'name\': \'Säer der Düsternis\', \'text\': \'Immer wenn der Säer der Düsternis von einer Kreatur geblockt wird, verliert ihr Beherrscher 2 Lebenspunkte und du erhältst 2 Lebenspunkte dazu.\', \'type\': \'Kreatur — Schrecken\', \'flavor\': \'„Zuerst kam die Dunkelheit. Dann kam das Grauen. Danach blieb nur noch Verzweiflung."\\n—*Die Tragödie von Morein*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485682&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cee538f4-e288-4887-a8f6-6add724cdae5\', \'multiverseId\': 485682}, \'multiverseid\': 485682}, {\'name\': \'Siembraoscuridad\', \'text\': \'Siempre que el Siembraoscuridad sea bloqueado por una criatura, el controlador de esa criatura pierde 2 vidas y tú ganas 2 vidas.\', \'type\': \'Criatura — Horror\', \'flavor\': \'"Primero se cernió la oscuridad. Después vino el terror. Y luego solo quedó la desesperación".\\n—*La tragedia de Moreín*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485941&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'82bb686e-956f-464d-b021-4a64a629e6b1\', \'multiverseId\': 485941}, \'multiverseid\': 485941}, {\'name\': \'Semeur de ténèbres\', \'text\': \'À chaque fois que le Semeur de ténèbres devient bloqué par une créature, le contrôleur de cette créature perd 2 points de vie et vous gagnez 2 points de vie.\', \'type\': \'Créature : horreur\', \'flavor\': "« D\'abord, les ténèbres se sont abattues. Puis la terreur est arrivée. À la fin, seul le désespoir subsistait. »\\n—*La tragédie de Morein*", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486200&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'49a3faad-f9f5-4162-b043-28ae77b65b46\', \'multiverseId\': 486200}, \'multiverseid\': 486200}, {\'name\': \'Seminatore di Tenebre\', \'text\': \'Ogniqualvolta il Seminatore di Tenebre viene bloccato da una creatura, il controllore di quella creatura perde 2 punti vita e tu guadagni 2 punti vita.\', \'type\': \'Creatura — Orrore\', \'flavor\': \'"Dapprima, scese l\\\'oscurità. Poi, seguì il terrore. Infine, non restò altro che disperazione."\\n—*La Tragedia di Morein*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486459&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c7d5ae68-6a20-48a6-9477-ccd5f4409664\', \'multiverseId\': 486459}, \'multiverseid\': 486459}, {\'name\': \'憂鬱蒔き\', \'text\': \'憂鬱蒔きがクリーチャー１体にブロックされた状態になるたび、そのクリーチャーのコントローラーは２点のライフを失い、あなたは２点のライフを得る。\', \'type\': \'クリーチャー — ホラー\', \'flavor\': \'「初めに闇が覆った。続いて恐怖が訪れた。最後には絶望のみが残った。」\\n――*モレインの悲劇*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486718&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f452ebbd-2bee-448b-aae1-b087aa374d94\', \'multiverseId\': 486718}, \'multiverseid\': 486718}, {\'name\': \'음울함을 뿌리는 자\', \'text\': \'음울함을 뿌리는 자가 생물에게 방어당할 때마다, 그 생물의 조종자는 생명 2점을 잃고 당신은 생명 2점을 얻는다.\', \'type\': \'생물 — 괴수\', \'flavor\': \'"우선, 어둠이 드리워진다. 공포가 그 뒤를 따른다. 그 후에는, 절망만이 남는다."\\n—*모레인의 비극*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486977&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'465bdcb2-b93f-4e02-9b7b-c9ac39c9c8ab\', \'multiverseId\': 486977}, \'multiverseid\': 486977}, {\'name\': \'Semeador Sombrio\', \'text\': \'Toda vez que Semeador Sombrio se torna bloqueado por uma criatura, o controlador daquela criatura perde 2 pontos de vida e você ganha 2 pontos de vida.\', \'type\': \'Criatura — Horror\', \'flavor\': \'"Primeiro, veio a escuridão. Em seguida, o terror. E depois, ficou só o desespero."\\n— *A Tragédia de Morein*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487236&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0f55fd03-a0c1-42d5-8acc-fe2cccd030e9\', \'multiverseId\': 487236}, \'multiverseid\': 487236}, {\'name\': \'Сеятель Мрака\', \'text\': \'Каждый раз, когда Сеятель Мрака становится заблокирован существом, контролирующий то существо игрок теряет 2 жизни, а вы получаете 2 жизни.\', \'type\': \'Существо — Ужас\', \'flavor\': \'«Сначала опустилась тьма. За ней пришел ужас. И после этого осталось лишь отчаяние».\\n— *«Трагедия Морейна»*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487495&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6582cbfc-094f-4136-9d5f-c263918cbf64\', \'multiverseId\': 487495}, \'multiverseid\': 487495}, {\'name\': \'散霾惧兽\', \'text\': \'每当散霾惧兽被一个生物阻挡时，该生物的操控者失去2点生命，且你获得2点生命。\', \'type\': \'生物 ～惊惧兽\', \'flavor\': \'「首先，黑暗降临。随后，恐惧到来。最后，只剩绝望。」\\n～*《莫雷因之殇》*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487754&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0b9af1f0-59a0-455f-b9b4-0bbf8b4b047e\', \'multiverseId\': 487754}, \'multiverseid\': 487754}, {\'name\': \'散霾懼獸\', \'text\': \'每當散霾懼獸被一個生物阻擋時，該生物的操控者失去2點生命，且你獲得2點生命。\', \'type\': \'生物 ～驚懼獸\', \'flavor\': \'「首先，黑暗降臨。隨後，恐懼到來。最後，只剩絕望。」\\n～*《莫雷因之殤》*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488013&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c256f964-7341-4118-bfea-c699cd8a8fde\', \'multiverseId\': 488013}, \'multiverseid\': 488013}]', '[{\'name\': \'Tapferer Widerstand\', \'text\': \'Lege eine +1/+1-Marke auf eine Kreatur deiner Wahl, die du kontrollierst. Sie erhält bis zum Ende des Zuges Schutz vor einer Farbe, die du bestimmst. (Sie kann von nichts dieser Farbe geblockt oder als Ziel bestimmt werden, Schaden zugefügt bekommen oder verzaubert oder ausgerüstet werden.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485601&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e4c4ff80-4cb3-463e-b099-167383e9a27c\', \'multiverseId\': 485601}, \'multiverseid\': 485601}, {\'name\': \'Hito de resistencia\', \'text\': \'Pon un contador +1/+1 sobre la criatura objetivo que controlas. Gana protección contra el color de tu elección hasta el final del turno. (No puede ser bloqueada, hecha objetivo, recibir daño, estar encantada o ser equipada por nada de ese color.)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485860&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'952423f3-935a-4320-b653-9d58d55958e0\', \'multiverseId\': 485860}, \'multiverseid\': 485860}, {\'name\': \'Haut fait de résistance\', \'text\': "Mettez un marqueur +1/+1 sur une créature ciblée que vous contrôlez. Elle acquiert la protection contre la couleur de votre choix jusqu\'à la fin du tour. (Elle ne peut pas être bloquée, ciblée, blessée, enchantée ou équipée par une source de la couleur choisie.)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486119&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e95c20a7-51bd-45a9-89fd-ad4ab4ed4a41\', \'multiverseId\': 486119}, \'multiverseid\': 486119}, {\'name\': \'Atto di Resistenza\', \'text\': \'Metti un segnalino +1/+1 su una creatura bersaglio che controlli. Ha protezione da un colore a tua scelta fino alla fine del turno. (Non può essere bloccata, bersagliata, non le può essere inflitto danno, né può essere incantata o equipaggiata da nulla di quel colore.)\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486378&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cc4ce552-db72-447b-bb25-9bd4479a0c0d\', \'multiverseId\': 486378}, \'multiverseid\': 486378}, {\'name\': \'抵抗の妙技\', \'text\': \'あなたがコントロールしているクリーチャー１体を対象とし、それの上に＋１/＋１カウンターを１個置く。色１色を選ぶ。ターン終了時まで、それはプロテクション（その選んだ色）を得る。（それは選ばれた色のものによっては、ブロックされず、対象にならず、ダメージを受けず、エンチャントされず、装備されない。）\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486637&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'aee11214-af85-49f8-9771-259dea7ae184\', \'multiverseId\': 486637}, \'multiverseid\': 486637}, {\'name\': \'저항의 묘기\', \'text\': \'당신이 조종하는 생물을 목표로 정한다. 그 생물에 +1/+1 카운터 한 개를 올려놓는다. 그 생물은 턴종료까지 당신이 선택한 색으로부터 보호를 얻는다. (이 생물은 그 색 원천에게 방어될 수 없고, 그 색 원천의 목표로 정해질 수 없고, 그 색 원천으로부터 피해를 입지 않고, 그 색 원천이 부여되거나 장착될 수 없다.)\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486896&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'90cd5745-e8c1-418e-93d6-f73694764c00\', \'multiverseId\': 486896}, \'multiverseid\': 486896}, {\'name\': \'Demonstração de Resistência\', \'text\': \'Coloque um marcador +1/+1 na criatura alvo que você controla. Ela ganha proteção contra a cor de sua escolha até o final do turno. (Ela não pode ser bloqueada, ser alvo, sofrer dano, ser encantada nem equipada por nada daquela cor.)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487155&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'da688108-59a1-4016-8b8f-bee6673155cb\', \'multiverseId\': 487155}, \'multiverseid\': 487155}, {\'name\': \'Подвиг Выносливости\', \'text\': \'Положите один жетон +1/+1 на целевое существо под вашим контролем. Оно получает Защиту от выбранного вами цвета до конца хода. (Объекты того цвета не могут блокировать его, делать его своей целью, наносить ему повреждения, зачаровывать или снаряжать.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487414&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'53f89f42-2aff-4466-abb8-de9d888494e0\', \'multiverseId\': 487414}, \'multiverseid\': 487414}, {\'name\': \'反抗技艺\', \'text\': \'在目标由你操控的生物上放置一个+1/+1指示物。选择一种颜色。该生物获得反该色保护异能直到回合结束。（它不能被该色的东西阻挡、指定为目标、造成伤害、结附或是装备。）\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487673&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ced66745-3428-4697-a102-a936608c81ae\', \'multiverseId\': 487673}, \'multiverseid\': 487673}, {\'name\': \'反抗技藝\', \'text\': \'在目標由你操控的生物上放置一個+1/+1指示物。選擇一種顏色。該生物獲得反該色保護異能直到回合結束。（它不能被該色的東西阻擋、指定為目標、造成傷害、結附或是裝備。）\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487932&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'dd28976e-14b3-4349-b0ce-1fbeb7b69eaa\', \'multiverseId\': 487932}, \'multiverseid\': 487932}]', '[{\'name\': \'Tapferes Ross\', \'text\': \'Wachsamkeit (Diese Kreatur wird beim Angreifen nicht getappt.)\\nWenn das Tapfere Ross ins Spiel kommt, erzeuge einen 2/2 weißen Ritter-Kreaturenspielstein mit Wachsamkeit.\', \'type\': \'Kreatur — Einhorn\', \'flavor\': \'Nur die tugendhaftesten und edelsten Ritter werden von einem Einhorn als Gefährten auserwählt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485624&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b4599e59-5e6f-49bb-b2fd-0785a97a5178\', \'multiverseId\': 485624}, \'multiverseid\': 485624}, {\'name\': \'Corcel audaz\', \'text\': \'Vigilancia. (Esta criatura no se gira al atacar.)\\nCuando el Corcel audaz entre al campo de batalla, crea una ficha de criatura Caballero blanca 2/2 con la habilidad de vigilancia.\', \'type\': \'Criatura — Unicornio\', \'flavor\': \'Un unicornio solo elige como compañero al caballero más virtuoso y noble.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485883&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b911265d-fe91-40dd-80d9-2938c0b6763f\', \'multiverseId\': 485883}, \'multiverseid\': 485883}, {\'name\': \'Destrier valeureux\', \'text\': "Vigilance (Attaquer avec cette créature ne la fait pas s\'engager.)\\nQuand le Destrier valeureux arrive sur le champ de bataille, créez un jeton de créature 2/2 blanche Chevalier avec la vigilance.", \'type\': \'Créature : licorne\', \'flavor\': \'Une licorne ne choisit comme compagnon que les chevaliers les plus nobles et les plus vertueux.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486142&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'af7d1f46-7a0f-47b7-9c9b-751700c36a56\', \'multiverseId\': 486142}, \'multiverseid\': 486142}, {\'name\': \'Destriero Valoroso\', \'text\': \'Cautela (Questa creatura attacca senza TAPpare.)\\nQuando il Destriero Valoroso entra nel campo di battaglia, crea una pedina creatura Cavaliere 2/2 bianca con cautela.\', \'type\': \'Creatura — Unicorno\', \'flavor\': \'Un unicorno sceglie come compagno solo il più nobile e onesto dei cavalieri.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486401&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'695e46b4-c0dd-4e82-9f1f-b61dceae1e4a\', \'multiverseId\': 486401}, \'multiverseid\': 486401}, {\'name\': \'勇敢な駿馬\', \'text\': \'警戒（このクリーチャーは攻撃してもタップしない。）\\n勇敢な駿馬が戦場に出たとき、警戒を持つ白の２/２の騎士・クリーチャー・トークンを１体生成する。\', \'type\': \'クリーチャー — ユニコーン\', \'flavor\': \'ユニコーンが仲間として選ぶのは、最も高潔にして高貴な騎士のみである。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486660&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8a3669c6-7507-4546-8135-476452f23423\', \'multiverseId\': 486660}, \'multiverseid\': 486660}, {\'name\': \'대담한 전투마\', \'text\': \'경계 (이 생물은 공격하면서 탭되지 않는다.)\\n대담한 전투마가 전장에 들어올 때, 경계를 가진 2/2 백색 기사 생물 토큰 한 개를 만든다.\', \'type\': \'생물 — 유니콘\', \'flavor\': \'유니콘은 가장 도덕적이고 고귀한 기사만을 자신의 동료로 삼는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486919&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6dff6d49-7e81-4b23-912e-2af084fd60ad\', \'multiverseId\': 486919}, \'multiverseid\': 486919}, {\'name\': \'Corcel Valoroso\', \'text\': \'Vigilância (Atacar não faz com que esta criatura seja virada.)\\nQuando Corcel Valoroso entrar no campo de batalha, crie uma ficha de criatura branca 2/2 do tipo Cavaleiro com vigilância.\', \'type\': \'Criatura — Unicórnio\', \'flavor\': \'Um unicórnio escolhe apenas os cavaleiros mais virtuosos e nobres como companheiros.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487178&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'01300f3a-8910-4a79-9cb2-9fdf4324814e\', \'multiverseId\': 487178}, \'multiverseid\': 487178}, {\'name\': \'Доблестный Скакун\', \'text\': \'Бдительность (Атакуя, это существо не поворачивается.)\\nКогда Доблестный Скакун выходит на поле битвы, создайте одну фишку существа 2/2 белый Рыцарь с Бдительностью.\', \'type\': \'Существо — Единорог\', \'flavor\': \'Единорог выбирает своим товарищем лишь самого добродетельного и храброго из рыцарей.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487437&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8983d5d2-03b6-4fd0-950b-9029d2b6bf7c\', \'multiverseId\': 487437}, \'multiverseid\': 487437}, {\'name\': \'英勇角驹\', \'text\': \'警戒（此生物攻击时不需横置。）\\n当英勇角驹进战场时，派出一个2/2白色，具警戒异能的骑士衍生生物。\', \'type\': \'生物 ～独角兽\', \'flavor\': \'骑士中唯有至德至尚者，才能被独角兽选作伙伴。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487696&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ce9ec701-80e8-4a2f-a991-310474e53774\', \'multiverseId\': 487696}, \'multiverseid\': 487696}, {\'name\': \'英勇角駒\', \'text\': \'警戒（此生物攻擊時不需橫置。）\\n當英勇角駒進戰場時，派出一個2/2白色，具警戒異能的騎士衍生生物。\', \'type\': \'生物 ～獨角獸\', \'flavor\': \'騎士中唯有至德至尚者，才能被獨角獸選作伙伴。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487955&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0c99fb21-7f51-4c7a-af3c-44ef21a2e079\', \'multiverseId\': 487955}, \'multiverseid\': 487955}]', '[{\'name\': \'Taquineur effronté\', \'text\': "Indestructible\\nÀ chaque fois que le Taquineur effronté subit des blessures, il inflige autant de blessures à l\'adversaire ciblé.\\n{2}{R}, {T} : Le Taquineur effronté se bat contre une autre créature ciblée.", \'type\': \'Créature : gobelin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488314&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b8461859-cb84-4175-b4bd-ac00d458afbf\', \'multiverseId\': 488314}, \'multiverseid\': 488314}, {\'name\': \'無作法な挑発者\', \'text\': \'破壊不能\\n無作法な挑発者がダメージを受けるたび、対戦相手１人を対象とする。これはそのプレイヤーに、その点数に等しい点数のダメージを与える。\\n{2}{R}, {T}：他のクリーチャー１体を対象とする。無作法な挑発者はそれと格闘を行う。\', \'type\': \'クリーチャー — ゴブリン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488366&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'25b42ef7-c809-4637-9e3d-f3273d45c8a7\', \'multiverseId\': 488366}, \'multiverseid\': 488366}]', '[{\'name\': \'Tavernen-Hasardeurin\', \'text\': \'{T}, bezahle 3 Lebenspunkte: Wirf eine Münze. Falls du den Münzwurf gewinnst, erhältst du 6 Lebenspunkte dazu.\', \'type\': \'Kreatur — Mensch, Räuber\', \'flavor\': \'Anhänger des Rakdos-Kultes zählen zu ihren besten Kunden. Sie zucken nie bei Schmerzen und sind selten gut im Rechnen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485706&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ed77c373-b40c-4b49-a4c4-da81c86ffca1\', \'multiverseId\': 485706}, \'multiverseid\': 485706}, {\'name\': \'Estafadora de taberna\', \'text\': \'{T}, pagar 3 vidas: Lanza una moneda a cara o cruz. Si ganas el lanzamiento, ganas 6 vidas.\', \'type\': \'Criatura — Bribón humano\', \'flavor\': \'Los cultistas rakdos son sus mejores clientes. No les afecta el dolor y no suelen destacar en matemáticas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485965&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8f0e983c-d9a2-422e-a44d-3df1766ac68e\', \'multiverseId\': 485965}, \'multiverseid\': 485965}, {\'name\': \'Filouteuse de taverne\', \'text\': \'{T}, payez 3 points de vie : Jouez à pile ou face. Si vous gagnez, vous gagnez 6 points de vie.\', \'type\': \'Créature : humain et gredin\', \'flavor\': "Les cultistes de Rakdos sont ses meilleurs clients. La douleur ne les fait jamais broncher et le calcul mental n\'est pas leur fort.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486224&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c982b1a3-e526-438b-9be1-152bd2a10301\', \'multiverseId\': 486224}, \'multiverseid\': 486224}, {\'name\': \'Truffatrice da Taverna\', \'text\': \'{T}, Paga 3 punti vita: Lancia una moneta. Se vinci il lancio, guadagni 6 punti vita.\', \'type\': \'Creatura — Farabutto Umano\', \'flavor\': \'I cultisti Rakdos sono i suoi migliori clienti. Non esitano mai davanti al dolore e non eccellono nel far di conto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486483&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'624ba250-3a59-4769-a994-f664d51f6b8b\', \'multiverseId\': 486483}, \'multiverseid\': 486483}, {\'name\': \'酒場の詐取師\', \'text\': \'{T}, ３点のライフを支払う：コイン投げをする。あなたがそのコイン投げに勝ったなら、あなたは６点のライフを得る。\', \'type\': \'クリーチャー — 人間・ならず者\', \'flavor\': \'ラクドスの狂信者は彼女の一番の上客だ。彼らは痛みに臆することがなく、ほとんどの場合まともに計算ができない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486742&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'79f2cd84-8f56-4d53-bbb1-3730ada70ebe\', \'multiverseId\': 486742}, \'multiverseid\': 486742}, {\'name\': \'술집 사기꾼\', \'text\': \'{T}, 생명 3점을 지불한다: 동전을 던진다. 동전 던지기에서 이기면 당신은 생명 6점을 얻는다.\', \'type\': \'생물 — 인간 도적\', \'flavor\': \'락도스 광신도들은 그녀의 가장 좋은 고객이다. 그들은 결코 고통을 겁내지 않으며 셈에 능하지도 않다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487001&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2f4a95f7-d292-4d82-b5f1-670c6279840e\', \'multiverseId\': 487001}, \'multiverseid\': 487001}, {\'name\': \'Vigarista da Taverna\', \'text\': \'{T}, pague 3 pontos de vida: Lance uma moeda. Se vencer, você ganha 6 pontos de vida.\', \'type\': \'Criatura — Humano Ladino\', \'flavor\': \'Os cultistas Rakdos são os melhores clientes dela. Eles nunca se retraem de dor e raramente são bons em matemática.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487260&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4405c97f-81b1-4607-b939-c7fd2c1fabc8\', \'multiverseId\': 487260}, \'multiverseid\': 487260}, {\'name\': \'Кабацкая Мошенница\', \'text\': \'{T}, заплатите 3 жизни: подбросьте монету. Если вы выигрываете бросок, вы получаете 6 жизней.\', \'type\': \'Существо — Человек Бродяга\', \'flavor\': \'Последователи культа Ракдоса — ее лучшие клиенты. Они не боятся боли и редко умеют считать.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487519&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'96a342e5-5f41-425f-a5fc-23a7ee26e281\', \'multiverseId\': 487519}, \'multiverseid\': 487519}, {\'name\': \'酒馆骗子\', \'text\': \'{T}，支付3点生命：掷一枚硬币。如果你赢得此掷，则你获得6点生命。\', \'type\': \'生物 ～人类／浪客\', \'flavor\': \'拉铎司教徒是她最好的顾客。他们不会因痛苦而退却，也很少擅于算术。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487778&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3104dc0e-0de6-4a3f-88cc-03ed801b6b85\', \'multiverseId\': 487778}, \'multiverseid\': 487778}, {\'name\': \'酒館騙子\', \'text\': \'{T}，支付3點生命：擲一枚硬幣。如果你贏得此擲，則你獲得6點生命。\', \'type\': \'生物 ～人類／浪客\', \'flavor\': \'拉鐸司教徒是她最好的顧客。他們不會因痛苦而退卻，也很少擅於算術。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488037&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3c48d50f-ab37-421f-8922-42f2029fcd53\', \'multiverseId\': 488037}, \'multiverseid\': 488037}]', '[{\'name\': \'Teferi, Herr über die Zeit\', \'text\': \'Du kannst Loyalitätsfähigkeiten von Teferi, Herr über die Zeit, im Zug jedes Spielers und zu jedem Zeitpunkt, zu dem du einen Spontanzauber wirken könntest, aktivieren.\\n+1: Ziehe eine Karte und wirf dann eine Karte ab.\\n-3: Eine Kreatur deiner Wahl, die du nicht kontrollierst, destabilisiert sich.\\n−10: Du erhältst nach diesem Zug zwei zusätzliche Züge.\', \'type\': \'Legendärer Planeswalker — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488930&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2db0281f-07df-44d4-962b-f446381eba51\', \'multiverseId\': 488930}, \'multiverseid\': 488930}, {\'name\': \'Teferi, Maestro del Tiempo\', \'text\': \'Puedes activar las habilidades de lealtad de Teferi, Maestro del Tiempo durante el turno de cualquier jugador en cualquier momento en que pudieras lanzar un instantáneo.\\n+1: Roba una carta, luego descarta una carta.\\n−3: La criatura objetivo que no controlas sale de fase.\\n−10: Juega dos turnos adicionales después de este.\', \'type\': \'Planeswalker legendario — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488954&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'58fe57b4-0dc7-4ac2-bdf5-35ff4ac4069b\', \'multiverseId\': 488954}, \'multiverseid\': 488954}, {\'name\': \'Téfeiri, maître du temps\', \'text\': "Vous pouvez activer les capacités de loyauté de Téfeiri, maître du temps pendant le tour de n\'importe quel joueur à tout moment où vous pourriez lancer un éphémère.\\n+1: Piochez une carte, puis défaussez-vous d\'une carte.\\n-3: Une créature ciblée que vous ne contrôlez pas passe hors phase.\\n-10: Jouez deux tours supplémentaires après celui-ci.", \'type\': \'Planeswalker légendaire : Téfeiri\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488978&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f06c32e1-5266-4ccc-8925-a1e7272f04e8\', \'multiverseId\': 488978}, \'multiverseid\': 488978}, {\'name\': \'Teferi, Maestro del Tempo\', \'text\': \'Puoi attivare le abilità di fedeltà di Teferi, Maestro del Tempo durante il turno di qualsiasi giocatore in ogni momento in cui potresti lanciare un istantaneo.\\n+1: Pesca una carta, poi scarta una carta.\\n-3: Una creatura bersaglio che non controlli scompare.\\n-10: Gioca due turni extra dopo questo.\', \'type\': \'Planeswalker Leggendario — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489002&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'313452b2-eb65-4f29-91e9-5f659b9db3c0\', \'multiverseId\': 489002}, \'multiverseid\': 489002}, {\'name\': \'時の支配者、テフェリー\', \'text\': \'あなたは、時の支配者、テフェリーの忠誠度能力を、どのプレイヤーのターンでも、あなたがインスタントを唱えられるときならいつでも起動してよい。\\n+1：カードを１枚引き、その後カード１枚を捨てる。\\n-3：あなたがコントロールしていないクリーチャー１体を対象とする。それはフェイズ・アウトする。\\n-10：このターンに続いて追加の２ターンを行う。\', \'type\': \'伝説のプレインズウォーカー — テフェリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489026&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3e242b71-ed8b-4f20-b50d-95ad9087017a\', \'multiverseId\': 489026}, \'multiverseid\': 489026}, {\'name\': \'시간의 대가, 테페리\', \'text\': \'당신은 순간마법을 발동할 수 있는 시기라면 어느 플레이어의 턴이든 시간의 대가, 테페리의 충성 능력을 활성화할 수 있다.\\n+1: 카드 한 장을 뽑은 후, 카드 한 장을 버린다.\\n−3: 당신이 조종하지 않는 생물을 목표로 정한다. 그 생물은 페이즈 아웃한다.\\n-10: 이번 턴 후에 추가로 두 턴을 얻는다.\', \'type\': \'전설적 플레인즈워커 — 테페리\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489050&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c214ebef-3a4a-46f4-877e-0009429bf624\', \'multiverseId\': 489050}, \'multiverseid\': 489050}, {\'name\': \'Teferi, Mestre do Tempo\', \'text\': \'Você pode ativar habilidades de lealdade de Teferi, Mestre do Tempo, no turno de qualquer jogador a qualquer momento em que poderia conjurar uma mágica instantânea.\\n+1: Compre um card e depois descarte um card.\\n−3: A criatura alvo que você não controla sai de fase.\\n−10: Jogue dois turnos extras depois deste.\', \'type\': \'Planeswalker Lendário — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489074&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1c014270-60e8-4bb8-ac10-dd8a0f36a005\', \'multiverseId\': 489074}, \'multiverseid\': 489074}, {\'name\': \'Тефери, Властелин Времени\', \'text\': \'Вы можете активировать способности верности Тефери, Властелина Времени во время хода любого игрока при любой возможности разыгрывать мгновенные заклинания.\\n+1: возьмите карту, затем сбросьте карту.\\n−3: целевое существо не под вашим контролем уходит в противофазу.\\n−10: сделайте два дополнительных хода вслед за этим.\', \'type\': \'Легендарный Planeswalker — Тефери\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489098&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3619199e-db24-4040-9c07-dc70c22b5f34\', \'multiverseId\': 489098}, \'multiverseid\': 489098}, {\'name\': \'弄时宗师泰菲力\', \'text\': \'你可以在任意牌手的回合中，于你能够施放瞬间的时机下，起动弄时宗师泰菲力的忠诚异能。\\n+1：抓一张牌，然后弃一张牌。\\n-3：目标不由你操控的生物跃离。\\n-10：于本回合后进行额外的两个回合。\', \'type\': \'传奇鹏洛客 ～泰菲力\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489122&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a6e124e8-5cca-49c0-8f8f-46a43a8e4da4\', \'multiverseId\': 489122}, \'multiverseid\': 489122}, {\'name\': \'弄時宗師泰菲力\', \'text\': \'你可以在任意玩家的回合中，於你能夠施放瞬間的時機下，起動弄時宗師泰菲力的忠誠異能。\\n+1：抽一張牌，然後棄一張牌。\\n−3：目標不由你操控的生物躍離。\\n−10：於本回合後進行額外的兩個回合。\', \'type\': \'傳奇鵬洛客 ～泰菲力\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489146&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b7d0b0e3-00e6-4bdf-b488-5b4382e6e472\', \'multiverseId\': 489146}, \'multiverseid\': 489146}]', '[{\'name\': \'Teferi, Herr über die Zeit\', \'text\': \'Du kannst Loyalitätsfähigkeiten von Teferi, Herr über die Zeit, im Zug jedes Spielers und zu jedem Zeitpunkt, zu dem du einen Spontanzauber wirken könntest, aktivieren.\\n+1: Ziehe eine Karte und wirf dann eine Karte ab.\\n−3: Eine Kreatur deiner Wahl, die du nicht kontrollierst, destabilisiert sich. (Behandle sie und alles, das an sie angelegt ist, bis zum Beginn des nächsten Zuges ihres Beherrschers, als würden sie nicht existieren.)\\n−10: Du erhältst nach diesem Zug zwei zusätzliche Züge.\', \'type\': \'Legendärer Planeswalker — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485657&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1bf05c32-cb9b-4ede-8aed-d70c66611b97\', \'multiverseId\': 485657}, \'multiverseid\': 485657}, {\'name\': \'Teferi, Maestro del Tiempo\', \'text\': \'Puedes activar las habilidades de lealtad de Teferi, Maestro del Tiempo durante el turno de cualquier jugador en cualquier momento en que pudieras lanzar un instantáneo.\\n+1: Roba una carta, luego descarta una carta.\\n−3: La criatura objetivo que no controlas sale de fase. (Trátala a ella y a cualquier permanente anexado a ella como si no existiese hasta el próximo turno de su controlador.)\\n−10: Juega dos turnos adicionales después de este.\', \'type\': \'Planeswalker legendario — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485916&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d2edf47e-a2c7-4263-a108-18b62cabae2b\', \'multiverseId\': 485916}, \'multiverseid\': 485916}, {\'name\': \'Téfeiri, maître du temps\', \'text\': "Vous pouvez activer les capacités de loyauté de Téfeiri, maître du temps pendant le tour de n\'importe quel joueur à tout moment où vous pourriez lancer un éphémère.\\n+1: Piochez une carte, puis défaussez-vous d\'une carte.\\n-3: Une créature ciblée que vous ne contrôlez pas passe hors phase. (Traitez-la et tout ce qui lui est attaché comme s\'ils n\'existaient pas jusqu\'au prochain tour de son contrôleur.)\\n-10: Jouez deux tours supplémentaires après celui-ci.", \'type\': \'Planeswalker légendaire : Téfeiri\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486175&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d43259ef-c82f-4a89-8b05-91712349220c\', \'multiverseId\': 486175}, \'multiverseid\': 486175}, {\'name\': \'Teferi, Maestro del Tempo\', \'text\': \'Puoi attivare le abilità di fedeltà di Teferi, Maestro del Tempo durante il turno di qualsiasi giocatore in ogni momento in cui potresti lanciare un istantaneo.\\n+1: Pesca una carta, poi scarta una carta.\\n-3: Una creatura bersaglio che non controlli scompare. (Tratta quella creatura e qualsiasi permanente ad essa assegnato come se non esistessero fino al prossimo turno del controllore della creatura.)\\n-10: Gioca due turni extra dopo questo.\', \'type\': \'Planeswalker Leggendario — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486434&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'14bb729a-4c6b-4b3a-bc28-1486f2da16e5\', \'multiverseId\': 486434}, \'multiverseid\': 486434}, {\'name\': \'時の支配者、テフェリー\', \'text\': \'あなたは、時の支配者、テフェリーの忠誠度能力を、どのプレイヤーのターンでも、あなたがインスタントを唱えられるときならいつでも起動してよい。\\n+1：カードを１枚引き、その後カード１枚を捨てる。\\n-3：あなたがコントロールしていないクリーチャー１体を対象とする。それはフェイズ・アウトする。（それのコントローラーの次のターンまで、それやそれにつけられているものはすべて存在しないかのように扱う。）\\n-10：このターンに続いて追加の２ターンを行う。\', \'type\': \'伝説のプレインズウォーカー — テフェリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486693&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9c47457b-e1a8-483e-9f43-b9cf0f15204b\', \'multiverseId\': 486693}, \'multiverseid\': 486693}, {\'name\': \'시간의 대가, 테페리\', \'text\': \'당신은 순간마법을 발동할 수 있는 시기라면 어느 플레이어의 턴이든 시간의 대가, 테페리의 충성 능력을 활성화할 수 있다.\\n+1: 카드 한 장을 뽑은 후, 카드 한 장을 버린다.\\n−3: 당신이 조종하지 않는 생물을 목표로 정한다. 그 생물은 페이즈 아웃한다. (그 생물의 조종자의 다음 턴까지 그 생물 및 그 생물에 부착되어 있는 것들이 존재하지 않는 것처럼 취급한다.)\\n-10: 이번 턴 후에 추가로 두 턴을 얻는다.\', \'type\': \'전설적 플레인즈워커 — 테페리\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486952&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'02bdb81e-e02f-4f2e-af2b-9aba8731d534\', \'multiverseId\': 486952}, \'multiverseid\': 486952}, {\'name\': \'Teferi, Mestre do Tempo\', \'text\': \'Você pode ativar habilidades de lealdade de Teferi, Mestre do Tempo, no turno de qualquer jogador a qualquer momento em que poderia conjurar uma mágica instantânea.\\n+1: Compre um card e depois descarte um card.\\n−3: A criatura alvo que você não controla sai de fase. (Trate-a, assim como qualquer coisa anexada a ela, como se não existisse até o próximo turno de seu controlador.)\\n−10: Jogue dois turnos extras depois deste.\', \'type\': \'Planeswalker Lendário — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487211&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'de1f51b7-cf05-4afd-a324-17abcfe8c3c8\', \'multiverseId\': 487211}, \'multiverseid\': 487211}, {\'name\': \'Тефери, Властелин Времени\', \'text\': \'Вы можете активировать способности верности Тефери, Властелина Времени во время хода любого игрока при любой возможности разыгрывать мгновенные заклинания.\\n+1: возьмите карту, затем сбросьте карту.\\n−3: целевое существо не под вашим контролем уходит в противофазу. (До следующего хода контролирующего его игрока обращайтесь с ним и всеми прикрепленными к нему объектами, как будто они не существуют.)\\n−10: сделайте два дополнительных хода вслед за этим.\', \'type\': \'Легендарный Planeswalker — Тефери\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487470&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3e7faf18-43e1-4abb-9402-1f5b5dce2a8f\', \'multiverseId\': 487470}, \'multiverseid\': 487470}, {\'name\': \'弄时宗师泰菲力\', \'text\': \'你可以在任意牌手的回合中，于你能够施放瞬间的时机下，起动弄时宗师泰菲力的忠诚异能。\\n+1：抓一张牌，然后弃一张牌。\\n-3：目标不由你操控的生物跃离。（直到其操控者的下一个回合，该生物及贴附于其上的所有东西都视作不存在。）\\n-10：于本回合后进行额外的两个回合。\', \'type\': \'传奇鹏洛客 ～泰菲力\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487729&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'18e4f3d3-d6b1-481e-9617-5adb09f782ab\', \'multiverseId\': 487729}, \'multiverseid\': 487729}, {\'name\': \'弄時宗師泰菲力\', \'text\': \'你可以在任意玩家的回合中，於你能夠施放瞬間的時機下，起動弄時宗師泰菲力的忠誠異能。\\n+1：抽一張牌，然後棄一張牌。\\n−3：目標不由你操控的生物躍離。（直到其操控者的下一個回合，該生物及貼附於其上的所有東西都視作不存在。）\\n−10：於本回合後進行額外的兩個回合。\', \'type\': \'傳奇鵬洛客 ～泰菲力\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487988&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f8bb4d7c-ad9a-4371-9781-fe1613d35d08\', \'multiverseId\': 487988}, \'multiverseid\': 487988}]', '[{\'name\': \'Teferi, Herr über die Zeit\', \'text\': \'Du kannst Loyalitätsfähigkeiten von Teferi, Herr über die Zeit, im Zug jedes Zeitpunkt, zu dem du einen Spontanzauber wirken könntest, aktivieren.\\n+1: Ziehe eine Karte und wirf dann eine Karte ab.\\n-3: Eine Kreatur deiner Wahl, die du nicht kontrollierst, destabilisiert sich.\\n−10: Du erhältst nach diesem Zug zwei zusätzliche Züge.\', \'type\': \'Legendärer Planeswalker — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488181&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4c549b2c-5bbc-490d-ac9d-86c5cba1b04d\', \'multiverseId\': 488181}, \'multiverseid\': 488181}, {\'name\': \'Teferi, Maestro del Tiempo\', \'text\': \'Puedes activar las habilidades de lealtad de Teferi, Maestro del Tiempo durante el turno de cualquier jugador en cualquier momento en que pudieras lanzar un instantáneo.\\n+1: Roba una carta, luego descarta una carta.\\n−3: La criatura objetivo que no controlas sale de fase.\\n−10: Juega dos turnos adicionales después de este.\', \'type\': \'Planeswalker legendario — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488187&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d050c851-9f56-4a88-a26b-2b1b7a3e4541\', \'multiverseId\': 488187}, \'multiverseid\': 488187}, {\'name\': \'Téfeiri, maître du temps\', \'text\': "Vous pouvez activer les capacités de loyauté de Téfeiri, maître du temps pendant le tour de n\'importe quel joueur à tout moment où vous pourriez lancer un éphémère.\\n+1: Piochez une carte, puis défaussez-vous d\'une carte.\\n-3: Une créature ciblée que vous ne contrôlez pas passe hors phase.\\n-10: Jouez deux tours supplémentaires après celui-ci.", \'type\': \'Planeswalker légendaire : Téfeiri\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488193&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8371e8dc-9805-4905-8be9-1d305ab8b455\', \'multiverseId\': 488193}, \'multiverseid\': 488193}, {\'name\': \'Teferi, Maestro del Tempo\', \'text\': \'Puoi attivare le abilità di fedeltà di Teferi, Maestro del Tempo durante il turno di qualsiasi giocatore in ogni momento in cui potresti lanciare un istantaneo.\\n+1: Pesca una carta, poi scarta una carta.\\n-3: Una creatura bersaglio che non controlli scompare.\\n-10: Gioca due turni extra dopo questo.\', \'type\': \'Planeswalker Leggendario — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488199&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0d8a79a1-1248-4109-a56c-f759de1847d0\', \'multiverseId\': 488199}, \'multiverseid\': 488199}, {\'name\': \'時の支配者、テフェリー\', \'text\': \'あなたは、時の支配者、テフェリーの忠誠度能力を、どのプレイヤーのターンでも、あなたがインスタントを唱えられるときならいつでも起動してよい。\\n+1：カードを１枚引き、その後カード１枚を捨てる。\\n-3：あなたがコントロールしていないクリーチャー１体を対象とする。それはフェイズ・アウトする。\\n-10：このターンに続いて追加の２ターンを行う。\', \'type\': \'伝説のプレインズウォーカー — テフェリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488205&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bdf84ff8-a2b2-4219-9ce2-6221f257f2cc\', \'multiverseId\': 488205}, \'multiverseid\': 488205}, {\'name\': \'시간의 대가, 테페리\', \'text\': \'당신은 순간마법을 발동할 수 있는 시기라면 어느 플레이어의 턴이든 시간의 대가, 테페리의 충성 능력을 활성화할 수 있다.\\n+1: 카드 한 장을 뽑은 후, 카드 한 장을 버린다.\\n−3: 당신이 조종하지 않는 생물을 목표로 정한다. 그 생물은 페이즈 아웃한다.\\n-10: 이번 턴 후에 추가로 두 턴을 얻는다.\', \'type\': \'전설적 플레인즈워커 — 테페리\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488211&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'58b1c7f9-791d-412b-ac3f-b15a4fa4f5eb\', \'multiverseId\': 488211}, \'multiverseid\': 488211}, {\'name\': \'Teferi, Mestre do Tempo\', \'text\': \'Você pode ativar habilidades de lealdade de Teferi, Mestre do Tempo, no turno de qualquer jogador a qualquer momento em que poderia conjurar uma mágica instantânea.\\n+1: Compre um card e depois descarte um card.\\n−3: A criatura alvo que você não controla sai de fase.\\n−10: Jogue dois turnos extras depois deste.\', \'type\': \'Planeswalker Lendário — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488217&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3aa15ce9-e1d9-420a-90f9-81a1eec869e1\', \'multiverseId\': 488217}, \'multiverseid\': 488217}, {\'name\': \'Тефери, Властелин Времени\', \'text\': \'Вы можете активировать способности верности Тефери, Властелина Времени во время хода любого игрока при любой возможности разыгрывать мгновенные заклинания.\\n+1: возьмите карту, затем сбросьте карту.\\n−3: целевое существо не под вашим контролем уходит в противофазу.\\n−10: сделайте два дополнительных хода вслед за этим.\', \'type\': \'Легендарный Planeswalker — Тефери\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488223&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b84bde0e-8019-4e65-85f0-beff4d2fcc60\', \'multiverseId\': 488223}, \'multiverseid\': 488223}, {\'name\': \'弄时宗师泰菲力\', \'text\': \'你可以在任意牌手的回合中，于你能够施放瞬间的时机下，起动弄时宗师泰菲力的忠诚异能。\\n+1：抓一张牌，然后弃一张牌。\\n-3：目标不由你操控的生物跃离。\\n-10：于本回合后进行额外的两个回合。\', \'type\': \'传奇鹏洛客 ～泰菲力\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488229&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e76a62e2-b8cd-4e1f-9719-0edb9d025e85\', \'multiverseId\': 488229}, \'multiverseid\': 488229}, {\'name\': \'弄時宗師泰菲力\', \'text\': \'你可以在任意玩家的回合中，於你能夠施放瞬間的時機下，起動弄時宗師泰菲力的忠誠異能。\\n+1：抽一張牌，然後棄一張牌。\\n−3：目標不由你操控的生物躍離。\\n−10：於本回合後進行額外的兩個回合。\', \'type\': \'傳奇鵬洛客 ～泰菲力\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488235&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b30dd651-7fba-4ff0-ac24-bbf86f02618d\', \'multiverseId\': 488235}, \'multiverseid\': 488235}]', '[{\'name\': \'Teferi, zeitloser Reisender\', \'text\': \'+1: Ziehe eine Karte.\\n−3: Lege eine Kreatur deiner Wahl oben auf die Bibliothek ihres Besitzers.\\n−8: Kreaturen, die ein Gegner deiner Wahl kontrolliert, destabilisieren sich. Bis zum Ende deines nächsten Zuges können sie sich nicht stabilisieren. (Behandle sie und alle bleibenden Karten, die an sie angelegt sind, als würden sie nicht existieren.)\', \'type\': \'Legendärer Planeswalker — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488650&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'71a5e557-e8eb-4c15-b9c3-4646e9f0de2b\', \'multiverseId\': 488650}, \'multiverseid\': 488650}, {\'name\': \'Teferi, viajero atemporal\', \'text\': \'+1: Roba una carta.\\n−3: Pon la criatura objetivo en la parte superior de la biblioteca de su propietario.\\n−8: Cada criatura que controla el oponente objetivo sale de fase. Hasta el final de tu próximo turno, no pueden entrar en fase. (Trátalas a ellas y a cualquier carta anexada a ellas como si no existiesen.)\', \'type\': \'Planeswalker legendario — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488670&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f8a10ae8-4c07-4cae-900e-2e2987db68d0\', \'multiverseId\': 488670}, \'multiverseid\': 488670}, {\'name\': \'Téfeiri, voyageur intemporel\', \'text\': "+1: Piochez une carte.\\n-3: Mettez une créature ciblée au-dessus de la bibliothèque de son propriétaire.\\n-8: Chaque créature contrôlée par l\'adversaire ciblé passe hors phase. Jusqu\'à la fin de votre prochain tour, elle ne peut pas passer en phase. (Traitez-la et tout ce qui lui est attaché comme si elle n\'existait pas.)", \'type\': \'Planeswalker légendaire : Téfeiri\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488690&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9f323303-2758-465a-bec4-f7e4024e8dfc\', \'multiverseId\': 488690}, \'multiverseid\': 488690}, {\'name\': \'Teferi, Viaggiatore Senza Tempo\', \'text\': \'+1: Pesca una carta.\\n-3: Metti una creatura bersaglio in cima al grimorio del suo proprietario.\\n-8: Ogni creatura controllata da un avversario bersaglio scompare. Fino alla fine del tuo prossimo turno, non può apparire. (Tratta quelle creature e qualsiasi permanente ad esse assegnato come se non esistessero.)\', \'type\': \'Planeswalker Leggendario — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488710&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'48ace697-456e-4ca9-9e89-75493a4da206\', \'multiverseId\': 488710}, \'multiverseid\': 488710}, {\'name\': \'時を超える旅行者、テフェリー\', \'text\': \'+1：カードを１枚引く。\\n-3：クリーチャー１体を対象とし、それをオーナーのライブラリーの一番上に置く。\\n-8：対戦相手１人を対象とする。そのプレイヤーがコントロールしている各クリーチャーはそれぞれフェイズ・アウトする。次のあなたのターンの終了時まで、それらはフェイズ・インできない。（それらやそれらにつけられているものはすべて存在しないかのように扱う。）\', \'type\': \'伝説のプレインズウォーカー — テフェリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488730&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'08566be8-3b21-406e-a295-08cff8bc2121\', \'multiverseId\': 488730}, \'multiverseid\': 488730}, {\'name\': \'영원의 여행자, 테페리\', \'text\': \'+1: 카드 한 장을 뽑는다.\\n−3: 생물을 목표로 정한다. 그 생물을 소유자의 서고 맨 위에 놓는다.\\n−8: 상대를 목표로 정한다. 그 상대가 조종하는 각 생물은 페이즈 아웃한다. 당신의 다음 턴 턴종료까지, 그 생물들은 페이즈 인 할 수 없다. (그 생물들 및 그 생물들에 부착된 것들을 존재하지 않는 것처럼 취급한다.)\', \'type\': \'전설적 플레인즈워커 — 테페리\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488750&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'fc1cfcd1-11b0-45d1-aedb-408cba4c262d\', \'multiverseId\': 488750}, \'multiverseid\': 488750}, {\'name\': \'Teferi, Viajante Atemporal\', \'text\': \'+1: Compre um card.\\n−3: Coloque a criatura alvo no topo do grimório de seu dono.\\n−8: Cada criatura que o oponente alvo controla sai de fase. Até o final de seu próximo turno, elas não podem entrar em fase. (Trate-as, assim como qualquer coisa anexada a elas, como se não existissem.)\', \'type\': \'Planeswalker Lendário — Teferi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488770&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f08a6bdd-b134-4ba2-b41f-0bd33dbf2cc5\', \'multiverseId\': 488770}, \'multiverseid\': 488770}, {\'name\': \'Тефери, Странник вне Времени\', \'text\': \'+1: возьмите карту.\\n−3: положите целевое существо на верх библиотеки его владельца.\\n−8: каждое существо под контролем целевого оппонента уходит в противофазу. До конца вашего следующего хода они не могут войти в фазу. (Обращайтесь с ними и всеми прикрепленными к ним объектами, как будто они не существуют.)\', \'type\': \'Легендарный Planeswalker — Тефери\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488790&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b7245002-b5d8-4387-9d21-d9f9892cc037\', \'multiverseId\': 488790}, \'multiverseid\': 488790}, {\'name\': \'历时旅客泰菲力\', \'text\': \'+1：抓一张牌。\\n−3：将目标生物置于其拥有者的牌库顶。\\n−8：由目标对手操控的所有生物跃离。直到你下一个回合的回合结束，它们不能跃回。（它们及贴附其上的所有东西都视作不存在。）\', \'type\': \'传奇鹏洛客 ～泰菲力\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488810&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e6f0e13c-186f-489d-8309-a3f06f357d0b\', \'multiverseId\': 488810}, \'multiverseid\': 488810}, {\'name\': \'歷時旅客泰菲力\', \'text\': \'+1：抽一張牌。\\n−3：將目標生物置於其擁有者的牌庫頂。\\n−8：由目標對手操控的所有生物躍離。直到你下一個回合的回合結束，它們不能躍回。（它們及貼附其上的所有東西都視作不存在。）\', \'type\': \'傳奇鵬洛客 ～泰菲力\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488830&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2491bc80-a206-468b-b59c-f674a8b384fd\', \'multiverseId\': 488830}, \'multiverseid\': 488830}]', '[{\'name\': \'Teferis Belehrung\', \'text\': \'Wenn Teferis Belehrung ins Spiel kommt, ziehe eine Karte und wirf dann eine Karte ab.\\nImmer wenn du eine Karte ziehst, millt ein Gegner deiner Wahl zwei Karten. (Er legt die obersten zwei Karten seiner Bibliothek auf seinen Friedhof.)\', \'type\': \'Verzauberung\', \'flavor\': \'„Tarassels sechstes Gesetz über den temporalen Kreislauf ist leicht zu verstehen, wenn man die ersten sieben kennt."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485660&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bfe7e95d-56db-424c-a5d7-06ba1e73730f\', \'multiverseId\': 485660}, \'multiverseid\': 485660}, {\'name\': \'Tutelaje de Teferi\', \'text\': \'Cuando el Tutelaje de Teferi entre al campo de batalla, roba una carta, luego descarta una carta.\\nSiempre que robes una carta, el oponente objetivo muele dos cartas. (Pone las dos primeras cartas de su biblioteca en su cementerio.)\', \'type\': \'Encantamiento\', \'flavor\': \'"La sexta ley de la recurrencia temporal de Tárassel es fácil de entender si comprendes las primeras siete".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485919&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2e77fc76-ddc4-41ed-9a33-aa8085e9738e\', \'multiverseId\': 485919}, \'multiverseid\': 485919}, {\'name\': \'Tutelle de Téfeiri\', \'text\': "Quand la Tutelle de Téfeiri arrive sur le champ de bataille, piochez une carte, puis défaussez-vous d\'une carte.\\nÀ chaque fois que vous piochez une carte, l\'adversaire ciblé meule deux cartes. (Il met les deux cartes du dessus de sa bibliothèque dans son cimetière.)", \'type\': \'Enchantement\', \'flavor\': \'« La sixième loi de la récursion temporelle de Tarassel est simple à comprendre quand on connait les sept premières. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486178&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'446e3218-8095-4559-9594-12ec624ab158\', \'multiverseId\': 486178}, \'multiverseid\': 486178}, {\'name\': \'Tutela di Teferi\', \'text\': \'Quando la Tutela di Teferi entra nel campo di battaglia, pesca una carta, poi scarta una carta.\\nOgniqualvolta peschi una carta, un avversario bersaglio macina due carte. (Mette nel suo cimitero le prime due carte del suo grimorio.)\', \'type\': \'Incantesimo\', \'flavor\': \'"La sesta legge della ricorsività temporale di Tarassel è di facile comprensione, purché si conoscano le prime sette."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486437&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'aecd0194-3da7-438e-9b3d-b7b00a96d035\', \'multiverseId\': 486437}, \'multiverseid\': 486437}, {\'name\': \'テフェリーの後見\', \'text\': \'テフェリーの後見が戦場に出たとき、カードを１枚引き、その後カード１枚を捨てる。\\nあなたがカードを１枚引くたび、対戦相手１人を対象とする。そのプレイヤーはカードを２枚切削する。（そのプレイヤーは、自分のライブラリーの一番上からカードを２枚自分の墓地に置く。）\', \'type\': \'エンチャント\', \'flavor\': \'「時間再帰に関するタラッセルの第六法則を理解するのは、最初の七つの法則が分かっていれば簡単さ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486696&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ed7df78b-1df0-4dd3-8728-05ce26f01e31\', \'multiverseId\': 486696}, \'multiverseid\': 486696}, {\'name\': \'테페리의 지도\', \'text\': \'테페리의 지도가 전장에 들어올 때, 카드 한 장을 뽑은 후, 카드 한 장을 버린다.\\n당신이 카드를 뽑을 때마다, 상대를 목표로 정한다. 그 상대는 카드 두 장을 민다. (그 플레이어는 자신의 서고 맨 위 카드 두 장을 자신의 무덤에 넣는다.)\', \'type\': \'부여마법\', \'flavor\': \'"시간적 재귀에 대한 타라셀의 여섯 번째 법칙은 자네가 첫 일곱 개 법칙을 알고 있으면 이해하기 쉽다네."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486955&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4a23bf99-69c4-471c-8dcb-3e91d2193cd5\', \'multiverseId\': 486955}, \'multiverseid\': 486955}, {\'name\': \'Tutela de Teferi\', \'text\': \'Quando Tutela de Teferi entrar no campo de batalha, compre um card e depois descarte um card.\\nToda vez que você compra um card, o oponente alvo tritura dois cards. (Ele coloca os dois cards do topo do próprio grimório no próprio cemitério.)\', \'type\': \'Encantamento\', \'flavor\': \'"A sexta lei da recursividade temporal de Tarassel é de fácil compreensão, contanto que você conheça as primeiras sete."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487214&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7fbf8f5c-c56a-4563-bd79-4fc38b45406e\', \'multiverseId\': 487214}, \'multiverseid\': 487214}, {\'name\': \'Наставничество Тефери\', \'text\': \'Когда Наставничество Тефери выходит на поле битвы, возьмите карту, затем сбросьте карту.\\nКаждый раз, когда вы берете карту, целевой оппонент скручивает две карты. (Он кладет две верхние карты своей библиотеки на свое кладбище.)\', \'type\': \'Чары\', \'flavor\': \'«Шестой закон темпоральной рекурсии Тарассель легко понять, если знаешь первые семь».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487473&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f960fd9a-76ce-405c-89b2-63edd30316cc\', \'multiverseId\': 487473}, \'multiverseid\': 487473}, {\'name\': \'泰菲力的指导\', \'text\': \'当泰菲力的指导进战场时，抓一张牌，然后弃一张牌。\\n每当你抓一张牌时，目标对手磨两张牌。（他将其牌库顶的两张牌置入其坟墓场。）\', \'type\': \'结界\', \'flavor\': \'「只要你晓得了塔拉希尔时间递归律的前七条，第六条就很容易理解。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487732&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fc2c522f-d3d3-4197-af57-f12ff856275a\', \'multiverseId\': 487732}, \'multiverseid\': 487732}, {\'name\': \'泰菲力的指導\', \'text\': \'當泰菲力的指導進戰場時，抽一張牌，然後棄一張牌。\\n每當你抽一張牌時，目標對手磨兩張牌。（他將其牌庫頂的兩張牌置入其墳墓場。）\', \'type\': \'結界\', \'flavor\': \'「只要你曉得了塔拉希爾時間遞歸律的前七條，第六條就很容易理解。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487991&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a19e70b4-6a33-4bb5-a4ac-b6620509c5a0\', \'multiverseId\': 487991}, \'multiverseid\': 487991}]', '[{\'name\': \'Teferis Belehrung\', \'text\': \'Wenn Teferis Belehrung ins Spiel kommt, ziehe eine Karte und wirf dann eine Karte ab.\\nImmer wenn du eine Karte ziehst, millt ein Gegner deiner Wahl zwei Karten.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488936&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'34c98dc3-a664-4fde-98b1-097ae5c1d10e\', \'multiverseId\': 488936}, \'multiverseid\': 488936}, {\'name\': \'Tutelaje de Teferi\', \'text\': \'Cuando el Tutelaje de Teferi entre al campo de batalla, roba una carta, luego descarta una carta.\\nSiempre que robes una carta, el oponente objetivo muele dos cartas.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488960&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f64fa2e8-ffa6-4f50-815d-ee98c4008ee9\', \'multiverseId\': 488960}, \'multiverseid\': 488960}, {\'name\': \'Tutelle de Téfeiri\', \'text\': "Quand la Tutelle de Téfeiri arrive sur le champ de bataille, piochez une carte, puis défaussez-vous d\'une carte.\\nÀ chaque fois que vous piochez une carte, l\'adversaire ciblé meule deux cartes.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488984&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8bfca758-1f40-4d51-934b-bcb52167a3fd\', \'multiverseId\': 488984}, \'multiverseid\': 488984}, {\'name\': \'Tutela di Teferi\', \'text\': \'Quando la Tutela di Teferi entra nel campo di battaglia, pesca una carta, poi scarta una carta.\\nOgniqualvolta peschi una carta, un avversario bersaglio macina due carte.\', \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489008&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a9f3d22c-8fac-4942-a3f3-afc89c04b8b8\', \'multiverseId\': 489008}, \'multiverseid\': 489008}, {\'name\': \'テフェリーの後見\', \'text\': \'テフェリーの後見が戦場に出たとき、カードを１枚引き、その後カード１枚を捨てる。\\nあなたがカードを１枚引くたび、対戦相手１人を対象とする。そのプレイヤーはカードを２枚切削する。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489032&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a2731aec-b1f9-4833-9f6f-b9e1df91e97b\', \'multiverseId\': 489032}, \'multiverseid\': 489032}, {\'name\': \'테페리의 지도\', \'text\': \'테페리의 지도가 전장에 들어올 때, 카드 한 장을 뽑은 후, 카드 한 장을 버린다.\\n당신이 카드를 뽑을 때마다, 상대를 목표로 정한다. 그 상대는 카드 두 장을 민다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489056&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0b34653a-f064-4b65-b327-6bb3577023a1\', \'multiverseId\': 489056}, \'multiverseid\': 489056}, {\'name\': \'Tutela de Teferi\', \'text\': \'Quando Tutela de Teferi entrar no campo de batalha, compre um card e depois descarte um card.\\nToda vez que você compra um card, o oponente alvo tritura dois cards.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489080&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'afbef127-3e37-45f2-8243-2ecdc00dc13f\', \'multiverseId\': 489080}, \'multiverseid\': 489080}, {\'name\': \'Наставничество Тефери\', \'text\': \'Когда Наставничество Тефери выходит на поле битвы, возьмите карту, затем сбросьте карту.\\nКаждый раз, когда вы берете карту, целевой оппонент скручивает две карты.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489104&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'652aa5a8-2408-4125-83a9-78089186aa83\', \'multiverseId\': 489104}, \'multiverseid\': 489104}, {\'name\': \'泰菲力的指导\', \'text\': \'当泰菲力的指导进战场时，抓一张牌，然后弃一张牌。\\n每当你抓一张牌时，目标对手磨两张牌。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489128&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bb8a5712-c3c2-426e-909f-9ec41b8265ee\', \'multiverseId\': 489128}, \'multiverseid\': 489128}, {\'name\': \'泰菲力的指導\', \'text\': \'當泰菲力的指導進戰場時，抽一張牌，然後棄一張牌。\\n每當你抽一張牌時，目標對手磨兩張牌。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489152&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'939dfa44-1c75-465e-a687-82d2a1471864\', \'multiverseId\': 489152}, \'multiverseid\': 489152}]', '[{\'name\': \'Teferis Schützling\', \'text\': \'{1}{U}, {T}: Ziehe eine Karte und wirf dann eine Karte ab.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'Teferis Vermächtnis lebt in Tolaria fort durch das Studium der Zeitmagie und einer Tradition von Schalk, Streichen und Unheilstiften.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485659&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bca4ac4b-6409-43ec-b139-2364e8b11a74\', \'multiverseId\': 485659}, \'multiverseid\': 485659}, {\'name\': \'Apadrinada de Teferi\', \'text\': \'{1}{U}, {T}: Roba una carta, luego descarta una carta.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'El legado de Teferi perdura en Tolaria gracias al estudio de la magia del tiempo y a una tradición de travesuras irreprimibles.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485918&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8c1c4333-f19f-4e49-8239-14162f0210a0\', \'multiverseId\': 485918}, \'multiverseid\': 485918}, {\'name\': \'Protégée de Téfeiri\', \'text\': "{1}{U}, {T} : Piochez une carte, puis défaussez-vous d\'une carte.", \'type\': \'Créature : humain et sorcier\', \'flavor\': "Sur Tolaria, l\'héritage de Téfeiri perdure à travers l\'étude de la magie temporelle et une tradition de malice irrépressible.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486177&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'928c60bd-b59f-4682-af76-77f14e10d389\', \'multiverseId\': 486177}, \'multiverseid\': 486177}, {\'name\': \'Protetta di Teferi\', \'text\': \'{1}{U}, {T}: Pesca una carta, poi scarta una carta.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': "A Tolaria, l\'eredità di Teferi sopravvive attraverso lo studio della magia temporale e grazie a una tradizione di spiritosi ribelli.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486436&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e51c4319-281c-40f0-94d1-f5b4ca8a9ea3\', \'multiverseId\': 486436}, \'multiverseid\': 486436}, {\'name\': \'テフェリーの徒弟\', \'text\': \'{1}{U}, {T}：カードを１枚引き、その後カード１枚を捨てる。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'トレイリアでは今もテフェリーの伝統が受け継がれている。時間魔法の研究と、取り留めのない悪戯だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486695&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bf7eca08-5210-43d7-bddb-b0e6f7b66a86\', \'multiverseId\': 486695}, \'multiverseid\': 486695}, {\'name\': \'테페리의 제자\', \'text\': \'{1}{U}, {T}: 카드 한 장을 뽑은 후, 카드 한 장을 버린다.\', \'type\': \'생물 — 인간 마법사\', \'flavor\': \'톨라리아에서 테페리의 유산은 시간 마법에 대한 연구와 억제 불가능한 장난기에 대한 전통을 통해 대대로 전해져 간다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486954&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d1fb347f-b24c-4135-86c1-0c75cacf59f2\', \'multiverseId\': 486954}, \'multiverseid\': 486954}, {\'name\': \'Protegida de Teferi\', \'text\': \'{1}{U}, {T}: Compre um card e depois descarte um card.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'O legado de Teferi sobrevive em Tolária através do estudo da magia do tempo e de uma tradição de rebeldia irrefreável.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487213&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9d2b1a1a-f9a0-41a6-af55-09e1c56dad3d\', \'multiverseId\': 487213}, \'multiverseid\': 487213}, {\'name\': \'Протеже Тефери\', \'text\': \'{1}{U}, {T}: возьмите карту, затем сбросьте карту.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'Наследие Тефери сохраняется в Толарии в виде исследований магии времени и традиции необузданных розыгрышей.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487472&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'957fd32d-59e9-45b8-b7a3-8069c6db513c\', \'multiverseId\': 487472}, \'multiverseid\': 487472}, {\'name\': \'泰菲力的门徒\', \'text\': \'{1}{U}，{T}：抓一张牌，然后弃一张牌。\', \'type\': \'生物 ～人类／法术师\', \'flavor\': \'对于时间魔法的持续研习和学生间难以克制的作弄传统，让泰菲力的精神得以在陶拉里亚流传。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487731&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4e3de997-0412-4993-842b-a08a715cac97\', \'multiverseId\': 487731}, \'multiverseid\': 487731}, {\'name\': \'泰菲力的門徒\', \'text\': \'{1}{U}，{T}：抽一張牌，然後棄一張牌。\', \'type\': \'生物 ～人類／魔法師\', \'flavor\': \'對於時間魔法的持續研習和學生間難以克制的作弄傳統，讓泰菲力的精神得以在陶拉里亞流傳。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487990&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'638eec93-9222-4808-9209-ec35ff1b7d8b\', \'multiverseId\': 487990}, \'multiverseid\': 487990}]', '[{\'name\': \'Teferis Schützling\', \'text\': \'{1}{U}, {T}: Ziehe eine Karte und wirf dann eine Karte ab.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488935&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'33511b86-f70f-4a8f-9c7d-e1a823d49af2\', \'multiverseId\': 488935}, \'multiverseid\': 488935}, {\'name\': \'Apadrinada de Teferi\', \'text\': \'{1}{U}, {T}: Roba una carta, luego descarta una carta.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488959&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dcfb8f3d-562f-4b13-b490-228aed12bcc3\', \'multiverseId\': 488959}, \'multiverseid\': 488959}, {\'name\': \'Protégée de Téfeiri\', \'text\': "{1}{U}, {T} : Piochez une carte, puis défaussez-vous d\'une carte.", \'type\': \'Créature : humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488983&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'78594902-c457-4ecd-b198-3cfce98a2e68\', \'multiverseId\': 488983}, \'multiverseid\': 488983}, {\'name\': \'Protetta di Teferi\', \'text\': \'{1}{U}, {T}: Pesca una carta, poi scarta una carta.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489007&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a21db9c8-acd2-4f08-ac0a-a424c507315e\', \'multiverseId\': 489007}, \'multiverseid\': 489007}, {\'name\': \'テフェリーの徒弟\', \'text\': \'{1}{U}, {T}：カードを１枚引き、その後カード１枚を捨てる。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489031&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'24500d28-7912-4683-b324-2bbdbbae631c\', \'multiverseId\': 489031}, \'multiverseid\': 489031}, {\'name\': \'테페리의 제자\', \'text\': \'{1}{U}, {T}: 카드 한 장을 뽑은 후, 카드 한 장을 버린다.\', \'type\': \'생물 — 인간 마법사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489055&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'517e52a3-950d-4195-bd72-e11d305bd25b\', \'multiverseId\': 489055}, \'multiverseid\': 489055}, {\'name\': \'Protegida de Teferi\', \'text\': \'{1}{U}, {T}: Compre um card e depois descarte um card.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489079&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'07533a04-4a24-45e1-8957-4d2c97f1fedd\', \'multiverseId\': 489079}, \'multiverseid\': 489079}, {\'name\': \'Протеже Тефери\', \'text\': \'{1}{U}, {T}: возьмите карту, затем сбросьте карту.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489103&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'79ca7156-e856-41fa-9b3d-f13adc728b61\', \'multiverseId\': 489103}, \'multiverseid\': 489103}, {\'name\': \'泰菲力的门徒\', \'text\': \'{1}{U}，{T}：抓一张牌，然后弃一张牌。\', \'type\': \'生物 ～人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489127&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'292900e9-1fec-46cc-8062-17920471ae2f\', \'multiverseId\': 489127}, \'multiverseid\': 489127}, {\'name\': \'泰菲力的門徒\', \'text\': \'{1}{U}，{T}：抽一張牌，然後棄一張牌。\', \'type\': \'生物 ～人類／魔法師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489151&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7efb5dee-5d6a-40e2-915e-64bf7fecc2c4\', \'multiverseId\': 489151}, \'multiverseid\': 489151}]', '[{\'name\': \'Teferis Wellenzauberin\', \'text\': \'Aufblitzen\\nWenn Teferis Wellenzauberin ins Spiel kommt, kannst du deine Bibliothek und/oder deinen Friedhof nach einer Karte namens Teferi, zeitloser Reisender, durchsuchen, sie offen vorzeigen und auf deine Hand nehmen. Falls du auf diese Weise deine Bibliothek durchsuchst, mische sie danach.\', \'type\': \'Kreatur — Meervolk, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488653&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9520fb34-b16e-46b1-a7a9-f245221cb115\', \'multiverseId\': 488653}, \'multiverseid\': 488653}, {\'name\': \'Invocaolas de Teferi\', \'text\': \'Destello.\\nCuando la Invocaolas de Teferi entre al campo de batalla, puedes buscar en tu biblioteca y/o cementerio una carta llamada Teferi, viajero atemporal, mostrarla y ponerla en tu mano. Si buscas en tu biblioteca de esta manera, barájala.\', \'type\': \'Criatura — Hechicero tritón\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488673&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b7ac97fc-fcb5-4b37-b1c3-150b9af6c084\', \'multiverseId\': 488673}, \'multiverseid\': 488673}, {\'name\': \'Lanceuse de vague de Téfeiri\', \'text\': \'Flash\\nQuand la Lanceuse de vague de Téfeiri arrive sur le champ de bataille, vous pouvez chercher dans votre bibliothèque et/ou votre cimetière une carte appelée Téfeiri, voyageur intemporel, la révéler et la mettre dans votre main. Si vous cherchez dans votre bibliothèque de cette manière, mélangez-la.\', \'type\': \'Créature : ondin et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488693&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4ac63f38-60a9-4117-af05-d1075fe129c9\', \'multiverseId\': 488693}, \'multiverseid\': 488693}, {\'name\': \'Incantaflutti di Teferi\', \'text\': "Lampo\\nQuando l\'Incantaflutti di Teferi entra nel campo di battaglia, puoi passare in rassegna il tuo grimorio e/o il tuo cimitero per una carta chiamata Teferi, Viaggiatore Senza Tempo, rivelarla e aggiungerla alla tua mano. Se passi in rassegna il tuo grimorio in questo modo, rimescolalo.", \'type\': \'Creatura — Mago Tritone\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488713&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'609f398c-4d06-46cf-a25a-fd9b572c8da7\', \'multiverseId\': 488713}, \'multiverseid\': 488713}, {\'name\': \'テフェリーの波術師\', \'text\': \'瞬速\\nテフェリーの波術師が戦場に出たとき、あなたは、あなたのライブラリーやあなたの墓地から「時を超える旅行者、テフェリー」という名前のカード１枚を探し、公開し、あなたの手札に加えてもよい。これによりあなたがあなたのライブラリーからカードを探したなら、あなたのライブラリーを切り直す。\', \'type\': \'クリーチャー — マーフォーク・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488733&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'327bbd7e-5804-41db-87b0-a7cd8607eeba\', \'multiverseId\': 488733}, \'multiverseid\': 488733}, {\'name\': \'테페리의 파도소환사\', \'text\': \'섬광\\n테페리의 파도소환사가 전장에 들어올 때, 당신은 당신의 서고 및/또는 무덤에서 영원의 여행자, 테페리인 카드 한 장을 찾아, 공개한 후, 당신의 손으로 가져갈 수 있다. 당신이 이런 식으로 당신의 서고를 찾아보았다면, 당신의 서고를 섞는다.\', \'type\': \'생물 — 인어 마법사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488753&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'add3b462-2844-478a-aec8-7968af488683\', \'multiverseId\': 488753}, \'multiverseid\': 488753}, {\'name\': \'Conjuradora de Ondas de Teferi\', \'text\': \'Lampejo\\nQuando Conjuradora de Ondas de Teferi entra no campo de batalha, você pode procurar em seu grimório e/ou cemitério um card com o nome Teferi, Viajante Atemporal, revelá-lo e colocá-lo em sua mão. Se procurar em seu grimório desta maneira, embaralhe-o.\', \'type\': \'Criatura — Tritão Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488773&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0b72d8ee-b89f-4662-81ad-f0c48535137e\', \'multiverseId\': 488773}, \'multiverseid\': 488773}, {\'name\': \'Заклинательница Волн Тефери\', \'text\': \'Миг\\nКогда Заклинательница Волн Тефери выходит на поле битвы, вы можете найти в вашей библиотеке и/или на вашем кладбище карту с именем Тефери, Странник вне Времени, показать ее и положить в вашу руку. Если вы ищете таким образом в вашей библиотеке, перетасуйте ее.\', \'type\': \'Существо — Мерфолк Чародей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488793&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b2f6b633-fcfb-4e09-8a49-30069265cdd2\', \'multiverseId\': 488793}, \'multiverseid\': 488793}, {\'name\': \'泰菲力的唤浪师\', \'text\': \'闪现\\n当泰菲力的唤浪师进战场时，你可以从你的牌库和／或坟墓场中搜寻一张名称为历时旅客泰菲力的牌，展示该牌，并将它置于你手上。如果你以此法搜寻你的牌库，则将它洗牌。\', \'type\': \'生物 ～人鱼／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488813&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f5c21970-3cb0-421b-a07a-23dad3489ddf\', \'multiverseId\': 488813}, \'multiverseid\': 488813}, {\'name\': \'泰菲力的喚浪師\', \'text\': \'閃現\\n當泰菲力的喚浪師進戰場時，你可以從你的牌庫和／或墳墓場中搜尋一張名稱為歷時旅客泰菲力的牌，展示該牌，並將它置於你手上。如果你以此法搜尋你的牌庫，則將它洗牌。\', \'type\': \'生物 ～人魚／魔法師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488833&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5bb01ce3-5f54-4186-89e8-647843d612ca\', \'multiverseId\': 488833}, \'multiverseid\': 488833}]', '[{\'name\': \'Teferis zeitlose Einsicht\', \'text\': \'Falls du eine Karte ziehen würdest, abgesehen von der ersten, die du in jedem deiner Ziehsegmente ziehst, ziehe stattdessen zwei Karten.\', \'type\': \'Legendäre Verzauberung\', \'flavor\': \'„Schön, du weißt also mehr als ich. Aber musst du das so heraushängen lassen?"\\n—Chandra Nalaar, zu Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485658&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0416bd77-5a8b-4f17-9c9f-e87fde39b998\', \'multiverseId\': 485658}, \'multiverseid\': 485658}, {\'name\': \'Conocimiento atemporal de Teferi\', \'text\': \'Si fueras a robar una carta, excepto la primera que robas en tus pasos de robar, en vez de eso, roba dos cartas.\', \'type\': \'Encantamiento legendario\', \'flavor\': \'"Vale, sabes más que yo. Pero ¿tienes que ir presumiendo de ello?".\\n—Chandra Nalaar, a Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485917&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7b721634-fccb-4bf1-9fa5-c92ed1cbb114\', \'multiverseId\': 485917}, \'multiverseid\': 485917}, {\'name\': \'Perspicacité sans âge de Téfeiri\', \'text\': \'Si vous deviez piocher une carte, excepté la première que vous piochez pendant chacune de vos étapes de pioche, piochez deux cartes à la place.\', \'type\': \'Enchantement légendaire\', \'flavor\': "« D\'accord, tu en sais plus que moi. Mais est-ce une raison de jouer les prétentieux ? »\\n—Chandra Nalaàr, à Téfeiri", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486176&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'aae97dde-15ea-441f-a061-0d41bcecdbd4\', \'multiverseId\': 486176}, \'multiverseid\': 486176}, {\'name\': \'Intuizione Eterna di Teferi\', \'text\': \'Se stai per pescare una carta, tranne la prima che peschi in ognuna delle tue sottofasi di acquisizione, pesca invece due carte.\', \'type\': \'Incantesimo Leggendario\', \'flavor\': \'"E va bene, ne sai più di me... Ma devi per forza ostentarlo?"\\n—Chandra Nalaar a Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486435&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c35dea97-e734-44af-b15f-3b0c9e81fd3d\', \'multiverseId\': 486435}, \'multiverseid\': 486435}, {\'name\': \'テフェリーの永遠の洞察\', \'text\': \'あなたがあなたの各ドロー・ステップで引く１枚目のカードでないカードを１枚引くなら、代わりにカードを２枚引く。\', \'type\': \'伝説のエンチャント\', \'flavor\': \'「いいわ。あなたは私より良く知っている。でも、それを見せつけるようなやり方をする必要はあるの？」\\n――チャンドラ・ナラーからテフェリーへ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486694&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c3c64da0-9a99-4251-8fa5-5b7b5f678bd2\', \'multiverseId\': 486694}, \'multiverseid\': 486694}, {\'name\': \'테페리의 영원한 통찰\', \'text\': \'당신이 당신의 각 뽑기단에 뽑는 첫 카드 이외에 카드를 한 장 뽑으려 한다면, 대신에 카드 두 장을 뽑는다.\', \'type\': \'전설적 부여마법\', \'flavor\': \'"알겠어, 당신이 나보다 많이 알아. 하지만 그렇게 잘난 척을 해야만 되는 거야?"\\n—찬드라 날라르, 테페리에게\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486953&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'cb830d09-c3ed-45eb-a453-b93bfb268474\', \'multiverseId\': 486953}, \'multiverseid\': 486953}, {\'name\': \'Percepção Atemporal de Teferi\', \'text\': \'Se você for comprar um card além do primeiro que você compra em cada uma das suas etapas de compra, em vez disso, compre dois cards.\', \'type\': \'Encantamento Lendário\', \'flavor\': \'"Tudo bem, você sabe mais que eu. Mas precisa mesmo ficar se exibindo?"\\n— Chandra Nalaar, para Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487212&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cc177849-f95d-4291-bfbd-d2d86912daef\', \'multiverseId\': 487212}, \'multiverseid\': 487212}, {\'name\': \'Вневременное Провидение Тефери\', \'text\': \'Если вы должны взять карту помимо первой карты, которую вы берете в каждом вашем шаге взятия карты, вместо этого возьмите две карты.\', \'type\': \'Легендарные Чары\', \'flavor\': \'«Ладно, ты знаешь больше меня. Но зачем обязательно так этим кичиться?»\\n— Чандра Налаар, обращаясь к Тефери\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487471&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'de1b39e3-a278-4221-96e8-a0a14e3b4d75\', \'multiverseId\': 487471}, \'multiverseid\': 487471}, {\'name\': \'泰菲力的永恒洞察\', \'text\': \'如果你将抓一张牌，且这不是你于自己的每个抓牌步骤中所抓的第一张牌，则改为抓两张牌。\', \'type\': \'传奇结界\', \'flavor\': \'「好啦，你是懂得比我多。但你真的要炫耀这点吗？」\\n～茜卓纳拉，致泰菲力\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487730&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'995a1823-4a9b-47c7-a150-5d5618aaaaf6\', \'multiverseId\': 487730}, \'multiverseid\': 487730}, {\'name\': \'泰菲力的永恆洞察\', \'text\': \'如果你將抽一張牌，且這不是你於自己的每個抽牌步驟中所抽的第一張牌，則改為抽兩張牌。\', \'type\': \'傳奇結界\', \'flavor\': \'「好啦，你是懂得比我多。但你真的要炫耀這點嗎？」\\n～茜卓納拉，致泰菲力\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=487989&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6ded122a-bfb8-4bbc-88a9-aad98e035fb7\', \'multiverseId\': 487989}, \'multiverseid\': 487989}]', "[{'name': 'Teferis zeitlose Einsicht', 'text': 'Falls du eine Karte ziehen würdest, abgesehen von der ersten, die du in jedem deiner Ziehsegmente ziehst, ziehe stattdessen zwei Karten.', 'type': 'Legendäre Verzauberung', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488934&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd68e8c2a-6c28-4dbb-88f5-01660556513f', 'multiverseId': 488934}, 'multiverseid': 488934}, {'name': 'Conocimiento atemporal de Teferi', 'text': 'Si fueras a robar una carta, excepto la primera que robas en tus pasos de robar, en vez de eso, roba dos cartas.', 'type': 'Encantamiento legendario', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488958&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '33f1fc28-70d1-4cc0-9e84-15a741c20c1e', 'multiverseId': 488958}, 'multiverseid': 488958}, {'name': 'Perspicacité sans âge de Téfeiri', 'text': 'Si vous deviez piocher une carte, excepté la première que vous piochez pendant chacune de vos étapes de pioche, piochez deux cartes à la place.', 'type': 'Enchantement légendaire', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=488982&type=card', 'language': 'French', 'identifiers': {'scryfallId': '28b1de92-b454-4e5d-b759-5e50d5fdfca4', 'multiverseId': 488982}, 'multiverseid': 488982}, {'name': 'Intuizione Eterna di Teferi', 'text': 'Se stai per pescare una carta, tranne la prima che peschi in ognuna delle tue sottofasi di acquisizione, pesca invece due carte.', 'type': 'Incantesimo Leggendario', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489006&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'bffe020f-09d2-4aa2-8e1e-991ec3cd063b', 'multiverseId': 489006}, 'multiverseid': 489006}, {'name': 'テフェリーの永遠の洞察', 'text': 'あなたがあなたの各ドロー・ステップで引く１枚目のカードでないカードを１枚引くなら、代わりにカードを２枚引く。', 'type': '伝説のエンチャント', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489030&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'd894c44e-7eeb-4579-8e9b-bf3c323252ce', 'multiverseId': 489030}, 'multiverseid': 489030}, {'name': '테페리의 영원한 통찰', 'text': '당신이 당신의 각 뽑기단에 뽑는 첫 카드 이외에 카드를 한 장 뽑으려 한다면, 대신에 카드 두 장을 뽑는다.', 'type': '전설적 부여마법', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489054&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'c2f8c5f0-1ab7-4dce-84f0-511e8af7fc8c', 'multiverseId': 489054}, 'multiverseid': 489054}, {'name': 'Percepção Atemporal de Teferi', 'text': 'Se você for comprar um card além do primeiro que você compra em cada uma das suas etapas de compra, em vez disso, compre dois cards.', 'type': 'Encantamento Lendário', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489078&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8515885c-0a4f-4b69-a579-8f913bfc2438', 'multiverseId': 489078}, 'multiverseid': 489078}, {'name': 'Вневременное Провидение Тефери', 'text': 'Если вы должны взять карту помимо первой карты, которую вы берете в каждом вашем шаге взятия карты, вместо этого возьмите две карты.', 'type': 'Легендарные Чары', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489102&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'ff5ae1ad-2831-4476-826a-5f99617ec6b0', 'multiverseId': 489102}, 'multiverseid': 489102}, {'name': '泰菲力的永恒洞察', 'text': '如果你将抓一张牌，且这不是你于自己的每个抓牌步骤中所抓的第一张牌，则改为抓两张牌。', 'type': '传奇结界', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489126&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '51fe0f78-2986-48e2-a4d2-2854687761e2', 'multiverseId': 489126}, 'multiverseid': 489126}, {'name': '泰菲力的永恆洞察', 'text': '如果你將抽一張牌，且這不是你於自己的每個抽牌步驟中所抽的第一張牌，則改為抽兩張牌。', 'type': '傳奇結界', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=489150&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '3600a246-6969-4984-8e33-e8a641f58114', 'multiverseId': 489150}, 'multiverseid': 489150}]", "[{'name': 'Tempel der Eingebung', 'text': 'Der Tempel der Eingebung kommt getappt ins Spiel.\\nWenn der Tempel der Eingebung ins Spiel kommt, wende Hellsicht 1 an.\\n{T}: Erzeuge {U} oder {R}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=485834&type=card', 'language': 'German', 'identifiers': {'scryfallId': '901773d3-e94b-4f58-a22d-be813b02db41', 'multiverseId': 485834}, 'multiverseid': 485834}, {'name': 'Templo de la epifanía', 'text': 'El Templo de la epifanía entra al campo de batalla girado.\\nCuando el Templo de la epifanía entre al campo de batalla, adivina 1.\\n{T}: Agrega {U} o {R}.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486093&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd6ccbf8f-65f0-4ac9-8f60-db12e16edf98', 'multiverseId': 486093}, 'multiverseid': 486093}, {'name': 'Temple de la révélation', 'text': 'Le Temple de la révélation arrive sur le champ de bataille engagé.\\nQuand le Temple de la révélation arrive sur le champ de bataille, regard 1.\\n{T} : Ajoutez {U} ou {R}.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=486352&type=card', 'language': 'French', 'identifiers': {'scryfallId': '13cb56ce-76cc-4fec-bc02-803f4833409d', 'multiverseId': 486352}, 'multiverseid': 486352}, {'name': 'Tempio della Rivelazione', 'text': 'Il Tempio della Rivelazione entra nel campo di battaglia TAPpato.\\nQuando il Tempio della Rivelazione entra nel campo di battaglia, profetizza 1.\\n{T}: Aggiungi {U} o {R}.', 'type': 'Terra', 'flavor': Non