izards.com/Handlers/Image.ashx?multiverseid=356000&type=card', 'language': 'German', 'identifiers': {'scryfallId': '72a9b2d9-70fe-4279-8b60-880e70a28424', 'multiverseId': 356000}, 'multiverseid': 356000}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365722&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '0d5fbd3d-9fd7-4cd8-9638-ee2522482300', 'multiverseId': 365722}, 'multiverseid': 365722}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356274&type=card', 'language': 'French', 'identifiers': {'scryfallId': '5612c215-211c-4f6b-9c89-688291823fc6', 'multiverseId': 356274}, 'multiverseid': 356274}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356548&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '96fe4a98-1e86-4c5f-af54-d79f9cf773f6', 'multiverseId': 356548}, 'multiverseid': 356548}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356822&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ae0cc7d0-317c-410a-86d5-dd4c6e418c77', 'multiverseId': 356822}, 'multiverseid': 356822}, {'name': '늪', 'type': '기본 대지 — 늪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357644&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'a0c6ed9e-f5a5-44a7-a7e9-8535ba739805', 'multiverseId': 357644}, 'multiverseid': 357644}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357096&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e739585d-13b9-4c44-82ce-2ecdfbce4e65', 'multiverseId': 357096}, 'multiverseid': 357096}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355452&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '06ea59e9-b992-4836-bdf8-2e7341a3e5d5', 'multiverseId': 355452}, 'multiverseid': 355452}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357370&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9d25f19e-566a-4e65-8b35-57d04e4d56de', 'multiverseId': 357370}, 'multiverseid': 357370}, {'name': '沼澤', 'type': '基本地～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355726&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'c4872ff4-6cd7-41b5-8593-39dd8e8eecfd', 'multiverseId': 355726}, 'multiverseid': 355726}]", '[{\'name\': \'Säbel der Bürger\', \'text\': \'Die ausgerüstete Kreatur erhält +1/+0 für jede ihrer Farben.\\nAusrüsten {1}\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': \'Jene ohne Gilden-Petschaft stellen oft eine andere Form des Schutzes zur Schau.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355963&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'990262be-acec-448d-9c59-ec02fda15c09\', \'multiverseId\': 355963}, \'multiverseid\': 355963}, {\'name\': \'Sable cívico\', \'text\': \'La criatura equipada obtiene +1/+0 por cada uno de sus colores.\\nEquipar {1}.\', \'type\': \'Artefacto — Equipo\', \'flavor\': \'Aquellos que no tienen sello de gremio suelen mostrar otras formas de protección.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365685&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'60d5d073-f693-4839-a62b-3ddb6d527b8c\', \'multiverseId\': 365685}, \'multiverseid\': 365685}, {\'name\': \'Sabre civique\', \'text\': \'La créature équipée gagne +1/+0 pour chacune de ses couleurs.\\nÉquipement {1}\', \'type\': \'Artefact : équipement\', \'flavor\': "Les gens dépourvus du cachet d\'une guilde arborent souvent une protection d\'une nature différente.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356237&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0c184809-6dae-4953-9f7c-1fbaf9dfb0ad\', \'multiverseId\': 356237}, \'multiverseid\': 356237}, {\'name\': \'Sciabola della Città\', \'text\': \'La creatura equipaggiata prende +1/+0 per ciascuno dei suoi colori.\\nEquipaggiare {1}\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': \'Coloro che non portano il sigillo di una gilda spesso ostentano forme diverse di protezione.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356511&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7d758b94-ef41-405a-a683-4aeb416bd800\', \'multiverseId\': 356511}, \'multiverseid\': 356511}, {\'name\': \'護民官のサーベル\', \'text\': \'装備しているクリーチャーは、それの色１色につき＋１/＋０の修整を受ける。\\n装備 {1}\', \'type\': \'アーティファクト — 装備品\', \'flavor\': \'ギルドの印鑑を持たない者は、たいてい何か別のもので身を守っている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356785&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'90340e3f-1a6e-4d74-ab86-41d2d91226d7\', \'multiverseId\': 356785}, \'multiverseid\': 356785}, {\'name\': \'시민의 기병도\', \'text\': \'장착된 생물은 자신의 색 한 개당 +1/+0을 받는다.\\n장착 {1}\', \'type\': \'마법물체 — 장비\', \'flavor\': \'길드 인장이 없는 자들은 다른 수단으로 스스로를 보호한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357607&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'54d64977-5b46-428f-a38c-edbe61bc8c33\', \'multiverseId\': 357607}, \'multiverseid\': 357607}, {\'name\': \'Sabre Cívico\', \'text\': \'A criatura equipada recebe +1/+0 para cada uma de suas cores.\\nEquipar {1}\', \'type\': \'Artefato — Equipamento\', \'flavor\': \'Os que não possuem um sinete de guilda frequentemente exibem outra forma de proteção.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357059&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'27b4932e-ce48-4464-9a1c-7131303eb93c\', \'multiverseId\': 357059}, \'multiverseid\': 357059}, {\'name\': \'Городская Сабля\', \'text\': \'Снаряженное существо получает +1/+0 за каждый из своих цветов.\\nСнарядить {1}\', \'type\': \'Артефакт — Снаряжение\', \'flavor\': \'Те, кто не носят знаки гильдий, обычно используют другие формы защиты.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355415&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0d87dd6f-6dff-4a36-a898-cb4f48e1d2dc\', \'multiverseId\': 355415}, \'multiverseid\': 355415}, {\'name\': \'市民配刀\', \'text\': \'佩带此武具的生物每具有一种颜色，便得+1/+0。\\n佩带{1}\', \'type\': \'神器～武具\', \'flavor\': \'不佩戴公会印记的人，通常受不同形式的保护。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357333&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9357d05b-3a6f-4046-b5e0-8faac9b53860\', \'multiverseId\': 357333}, \'multiverseid\': 357333}, {\'name\': \'市民配刀\', \'text\': \'佩帶此武具的生物每具有一種顏色，便得+1/+0。\\n佩帶{1}\', \'type\': \'神器～武具\', \'flavor\': \'不佩戴公會印記的人，通常受不同形式的保護。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355689&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'331eb115-6e44-4875-8963-9897518c305b\', \'multiverseId\': 355689}, \'multiverseid\': 355689}]', '[{\'name\': \'Tafel der Gilden\', \'text\': \'Sowie die Tafel der Gilden ins Spiel kommt, bestimme zwei Farben.\\nImmer wenn du einen Zauber wirkst, falls dieser mindestens eine der bestimmten Farben hat, erhältst du für jede der bestimmten Farben, die er hat, 1 Lebenspunkt dazu.\', \'type\': \'Artefakt\', \'flavor\': \'Man munkelt, die Azorius hätten horrende Summen gezahlt, um sicherzustellen, dass ihr Zeichen ganz oben erscheint.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355971&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'04e3b6e3-d54d-4ef4-b516-2dbaecd34755\', \'multiverseId\': 355971}, \'multiverseid\': 355971}, {\'name\': \'Tableta de los gremios\', \'text\': \'En cuanto la Tableta de los gremios entre al campo de batalla, elige dos colores.\\nSiempre que lances un hechizo, si es de al menos uno de los colores elegidos, ganas 1 vida por cada uno de los colores elegidos de los que sea el hechizo.\', \'type\': \'Artefacto\', \'flavor\': \'Se rumorea que los azorios pagaron una suma desorbitada para asegurar que su símbolo apareciera en lo más alto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365693&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'69677736-d066-4f31-b4f9-38b06e34c96b\', \'multiverseId\': 365693}, \'multiverseid\': 365693}, {\'name\': \'Tablette des Guildes\', \'text\': "Au moment où la Tablette des Guildes arrive sur le champ de bataille, choisissez deux couleurs.\\nÀ chaque fois que vous lancez un sort, s\'il a au moins une des couleurs choisies, vous gagnez 1 point de vie pour chacune des couleurs choisies qu\'il a.", \'type\': \'Artefact\', \'flavor\': "Selon la rumeur, les Azorius auraient déboursé une somme faramineuse pour s\'assurer que son symbole apparaisse au sommet.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356245&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'56b664ab-f79c-405d-a807-b9e0e83b4a33\', \'multiverseId\': 356245}, \'multiverseid\': 356245}, {\'name\': \'Tavola delle Gilde\', \'text\': \'Mentre la Tavola delle Gilde entra nel campo di battaglia, scegli due colori.\\nOgniqualvolta lanci una magia, se ha almeno uno dei colori scelti, guadagni 1 punto vita per ognuno dei colori scelti della magia.\', \'type\': \'Artefatto\', \'flavor\': \'Si dice che gli Azorius abbiano pagato una somma esorbitante per assicurarsi che il loro simbolo appaia più in alto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356519&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4dadb98e-cb56-4298-a287-30eb8c88f45d\', \'multiverseId\': 356519}, \'multiverseid\': 356519}, {\'name\': \'ギルドのタブレット\', \'text\': \'ギルドのタブレットが戦場に出るに際し、色を２色選ぶ。\\nあなたが呪文を唱えるたび、それが選ばれた２色のうちの１色以上である場合、あなたは該当する選ばれた色１色につき１点のライフを得る。\', \'type\': \'アーティファクト\', \'flavor\': \'アゾリウスは自分達のシンボルを一番上にするために途方もない出資をしたと噂されている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356793&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f69ac91d-8811-4429-9a5c-6ccc4cb6f91b\', \'multiverseId\': 356793}, \'multiverseid\': 356793}, {\'name\': \'길드들의 명판\', \'text\': \'길드들의 명판이 전장에 들어오면서, 색 두 개를 선택한다.\\n당신이 주문을 발동할 때마다, 그 주문이 선택된 색 중 하나라도 해당된다면, 당신은 그 주문이 해당되는 색 한 개당 생명 1점을 얻는다.\', \'type\': \'마법물체\', \'flavor\': \'아조리우스 길드가 그들의 상징이 맨 위에 표시되도록 엄청난 액수를 지불했다는 소문이 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357615&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'60dbad8f-1bc6-48c8-b3c8-5e2c378dde7d\', \'multiverseId\': 357615}, \'multiverseid\': 357615}, {\'name\': \'Tabuleta das Guildas\', \'text\': \'Conforme Tabuleta das Guildas entrar no campo de batalha, escolha duas cores.\\nToda vez que você conjurar uma mágica, se ela for de pelo menos uma das cores escolhidas, você ganhará 1 ponto de vida para cada cor escolhida da qual ela for.\', \'type\': \'Artefato\', \'flavor\': \'Dizem os rumores que os Azorius pagaram uma quantia exorbitante para garantir que seu símbolo aparecesse no topo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357067&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2bcb4fcf-2ea3-4a44-8147-ef443919f820\', \'multiverseId\': 357067}, \'multiverseid\': 357067}, {\'name\': \'Скрижаль Гильдий\', \'text\': \'При выходе Скрижали Гильдий на поле битвы выберите два цвета.\\nКаждый раз, когда вы разыгрываете заклинание, если оно хотя бы одного из выбранных цветов, вы получаете 1 жизнь за каждый из выбранных цветов, который у него есть.\', \'type\': \'Артефакт\', \'flavor\': \'Поговаривают, что Азориусы заплатили огромную сумму за то, чтобы их символ появился на самом верху.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355423&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0c80e807-53c5-4dae-afd2-aebd3db473fb\', \'multiverseId\': 355423}, \'multiverseid\': 355423}, {\'name\': \'十会盟碑\', \'text\': \'于十会盟碑进战场时，选择两种颜色。\\n每当你施放咒语时，若该咒语的颜色与所选颜色至少有一种相符，则其每符合一种所选颜色，你便获得1点生命。\', \'type\': \'神器\', \'flavor\': \'据说俄佐立支付了极高的金额以确保其标志会出现在最上方。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357341&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b7ca9529-6a9b-4b14-9096-3d4c94c4b1a1\', \'multiverseId\': 357341}, \'multiverseid\': 357341}, {\'name\': \'十會盟碑\', \'text\': \'於十會盟碑進戰場時，選擇兩種顏色。\\n每當你施放咒語時，若該咒語至少包括所選顏色的其中一種，則每符合一種顏色，你便獲得1點生命。\', \'type\': \'神器\', \'flavor\': \'據說俄佐立支付了極高的金額以確保其標誌會出現在最上方。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355697&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6c0d7478-3019-4a90-b936-d4f06005bd1d\', \'multiverseId\': 355697}, \'multiverseid\': 355697}]', '[{\'name\': \'Tavernen-Hasardeurin\', \'text\': \'{T}, bezahle 3 Lebenspunkte: Wirf eine Münze. Falls du den Münzwurf gewinnst, erhältst du 6 Lebenspunkte dazu.\', \'type\': \'Kreatur — Mensch, Räuber\', \'flavor\': \'Anhänger des Rakdos-Kultes sind ihre besten Kunden. Sie zucken nie bei Schmerzen und sind selten gut im Rechnen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355815&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8dbba717-b35d-409a-8321-e2edc94fe123\', \'multiverseId\': 355815}, \'multiverseid\': 355815}, {\'name\': \'Estafadora de taberna\', \'text\': \'{T}, pagar 3 vidas: Lanza una moneda a cara o cruz. Si ganas el lanzamiento, ganas 6 vidas.\', \'type\': \'Criatura — Bribón humano\', \'flavor\': \'Los cultistas rakdos son sus mejores clientes. No les afecta el dolor y no suelen destacar en matemáticas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365537&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2bd50dab-5ae1-4be7-83f8-1470fe88a989\', \'multiverseId\': 365537}, \'multiverseid\': 365537}, {\'name\': \'Filouteuse de taverne\', \'text\': \'{T}, payez 3 points de vie : Jouez à pile ou face. Si vous gagnez, vous gagnez 6 points de vie.\', \'type\': \'Créature : humain et gredin\', \'flavor\': "Les cultistes de Rakdos sont ses meilleurs clients. La douleur ne les fait jamais broncher et le calcul mental n\'est pas leur fort.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356089&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5474e01c-9205-4c6f-9efe-d6481c1aff17\', \'multiverseId\': 356089}, \'multiverseid\': 356089}, {\'name\': \'Truffatrice da Taverna\', \'text\': \'{T}, Paga 3 punti vita: Lancia una moneta. Se vinci il lancio, guadagni 6 punti vita.\', \'type\': \'Creatura — Farabutto Umano\', \'flavor\': \'I cultisti Rakdos sono i suoi migliori clienti. Non esitano mai davanti al dolore e non sono molto bravi in matematica.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356363&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ea7ecead-1a8a-4f7c-bbc0-4346851ecb29\', \'multiverseId\': 356363}, \'multiverseid\': 356363}, {\'name\': \'酒場の詐取師\', \'text\': \'{T}, ライフを３点支払う：コイン投げをする。あなたがそのコイン投げに勝った場合、あなたは６点のライフを得る。\', \'type\': \'クリーチャー — 人間・ならず者\', \'flavor\': \'ラクドスの狂信者は彼女の一番の上客だ。彼らは痛みに臆することがなく、ほとんどの場合まともに計算ができない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356637&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5799625b-2c0b-4e5f-a82c-4ea1c36bd08c\', \'multiverseId\': 356637}, \'multiverseid\': 356637}, {\'name\': \'술집 사기꾼\', \'text\': \'{T}, 생명 3점을 지불한다: 동전을 던진다. 동전 던지기에서 이기면 당신은 생명 6점을 얻는다.\', \'type\': \'생물 — 인간 도적\', \'flavor\': \'락도스 광신도들은 그녀의 가장 좋은 고객이다. 그들은 결코 고통을 겁내지 않으며 별로 셈에 능하지도 않다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357459&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d2d67be8-f786-46f2-b1c7-d788071bd6e3\', \'multiverseId\': 357459}, \'multiverseid\': 357459}, {\'name\': \'Vigarista da Taverna\', \'text\': \'{T}, Pague 3 pontos de vida: Lance uma moeda. Se vencer, você ganha 6 pontos de vida.\', \'type\': \'Criatura — Humano Ladino\', \'flavor\': \'Os cultistas Rakdos são os melhores clientes dela. Eles nunca se retraem de dor e raramente são bons em matemática.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356911&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dee23338-c271-4d29-8468-146534498740\', \'multiverseId\': 356911}, \'multiverseid\': 356911}, {\'name\': \'Кабацкая Мошенница\', \'text\': \'{T}, заплатите 3 жизни: подбросьте монету. Если вы выигрываете бросок, вы получаете 6 жизней.\', \'type\': \'Существо — Человек Бродяга\', \'flavor\': \'Последователи культа Ракдоса — ее лучшие клиенты. Они не боятся боли и редко умеют считать.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355267&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6cb31577-76c2-40a6-b1ee-9585b5924cfd\', \'multiverseId\': 355267}, \'multiverseid\': 355267}, {\'name\': \'酒馆骗子\', \'text\': \'{T}，支付3点生命：掷一枚硬币。如果你赢得此掷，你获得6点生命。\', \'type\': \'生物～人类／浪客\', \'flavor\': \'拉铎司教徒是她最好的顾客。他们不会因痛苦而退却，也很少擅于算术。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357185&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'41345246-09eb-4c58-8925-72c7957da505\', \'multiverseId\': 357185}, \'multiverseid\': 357185}, {\'name\': \'酒館騙子\', \'text\': \'{T}，支付3點生命：擲一枚硬幣。如果你贏得此擲，你獲得6點生命。\', \'type\': \'生物～人類／浪客\', \'flavor\': \'拉鐸司教徒是她最好的顧客。他們不會因痛苦而退卻，也很少擅於算術。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355541&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8d3a5614-dd5b-4271-8d7f-c9f22c71f457\', \'multiverseId\': 355541}, \'multiverseid\': 355541}]', '[{\'name\': \'Teleportal\', \'text\': \'Eine Kreatur deiner Wahl, die du kontrollierst, erhält +1/+0 bis zum Ende des Zuges und ist in diesem Zug unblockbar.\\nÜberlast {3}{U}{R} (Du kannst diesen Zauber zu seinen Überlast-Kosten wirken. Falls du dies tust, verändere seinen Text, indem du im Text alle Vorkommen von „deiner Wahl" durch „jeder" ersetzt.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355938&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5cbd755c-4aa8-4e0f-a418-c74509babff5\', \'multiverseId\': 355938}, \'multiverseid\': 355938}, {\'name\': \'Teleportal\', \'text\': \'La criatura objetivo que controlas obtiene +1/+0 hasta el final del turno y es imbloqueable este turno.\\nSobrecarga {3}{U}{R}. (Puedes lanzar este hechizo por su coste de sobrecarga. Si lo haces, cambia su texto reemplazando "la criatura objetivo" por "cada criatura".)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365660&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c96f1ab1-48ea-46c7-ac25-67f8c7ad6740\', \'multiverseId\': 365660}, \'multiverseid\': 365660}, {\'name\': \'Téléportail\', \'text\': "La créature ciblée que vous contrôlez gagne +1/+0 jusqu\'à la fin du tour et est imblocable ce tour-ci.\\nSurcharge {3}{U}{R} (Vous pouvez lancer ce sort pour son coût de surcharge. Si vous faites ainsi, modifiez son texte en remplaçant toutes les occurrences de « ciblé(e) » par « chaque ».)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356212&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bc620c44-4645-47ff-9c5b-cc248b860db7\', \'multiverseId\': 356212}, \'multiverseid\': 356212}, {\'name\': \'Teleportale\', \'text\': \'Una creatura bersaglio che controlli prende +1/+0 fino alla fine del turno e non può essere bloccata in questo turno.\\nSovraccarico {3}{U}{R} (Puoi lanciare questa magia per il suo costo di sovraccarico. Se lo fai, cambiane il testo sostituendo "una creatura bersaglio" con "ogni creatura".)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356486&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'13a84196-b6d8-45b6-b59f-018c6d59ac80\', \'multiverseId\': 356486}, \'multiverseid\': 356486}, {\'name\': \'瞬間移動門\', \'text\': \'あなたがコントロールするクリーチャー１体を対象とする。それはターン終了時まで＋１/＋０の修整を受けるとともに、このターン、ブロックされない。\\n超過 {3}{U}{R} （あなたはこの呪文をその超過コストで唱えてもよい。そうした場合、あなたがコントロールする各クリーチャーはそれぞれ、ターン終了時まで＋１/＋０の修整を受けるとともに、このターン、ブロックされない。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356760&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'96fc0978-4928-490c-97ea-8c6433d7294c\', \'multiverseId\': 356760}, \'multiverseid\': 356760}, {\'name\': \'텔레포탈\', \'text\': \'당신이 조종하는 생물 한 개를 목표로 정한다. 그 생물은 턴종료까지 +1/+0을 받고 이 턴에 방어될 수 없다.\\n과부하 {3}{U}{R} (당신은 과부하 비용을 지불하여 이 주문을 발동할 수 있다. 그럴 경우, 이 주문은 "당신이 조종하는 각 생물은 턴종료까지 +1/+0을 받고 이 턴에 방어될 수 없다"로 내용이 변한다. )\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357582&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4fab6a05-58de-495d-b15b-842395a03a9c\', \'multiverseId\': 357582}, \'multiverseid\': 357582}, {\'name\': \'Teleportal\', \'text\': \'A criatura alvo que você controla recebe +1/+0 até o final do turno e não pode ser bloqueada neste turno.\\nSobrecarga {3}{U}{R} (Você pode conjurar esta mágica pagando seu custo de sobrecarga. Se fizer isso, altere seu texto substituindo todas as ocorrências de "a criatura alvo" por "cada criatura".)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357034&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1910658e-278f-4531-8941-c7e2a6f82fb5\', \'multiverseId\': 357034}, \'multiverseid\': 357034}, {\'name\': \'Телепортал\', \'text\': \'Целевое существо под вашим контролем получает +1/+0 до конца хода и не может быть заблокировано в этом ходу.\\nПерегрузка {3}{U}{R} (Вы можете разыграть это заклинание за его стоимость Перегрузки. Если вы это делаете, измените в его тексте все слова «целевой» на «каждый».)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355390&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'91f0aff0-4779-4c1e-8864-b39fbe06a923\', \'multiverseId\': 355390}, \'multiverseid\': 355390}, {\'name\': \'远距传送\', \'text\': \'目标由你操控的生物得+1/+0直到回合结束，且本回合中不能被阻挡。\\n超载{3}{U}{R}（你可以支付此咒语的超载费用来施放它。如果你如此作，将其中的「目标」字样全部更改为「每个」。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357308&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b6d791d2-ef2f-48c7-94fc-0005292ae92f\', \'multiverseId\': 357308}, \'multiverseid\': 357308}, {\'name\': \'遠距傳送\', \'text\': \'目標由你操控的生物得+1/+0直到回合結束，且本回合中不能被阻擋。\\n超載{3}{U}{R}（你可以支付此咒語的超載費用來施放它。如果你如此作，將其中的「目標」字樣全部更改為「每個」。）\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355664&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2a77e719-8f9d-43b3-a7c9-4814ee315ada\', \'multiverseId\': 355664}, \'multiverseid\': 355664}]', "[{'name': 'Tempelgarten', 'text': '({T}: Erhöhe deinen Manavorrat um {G} oder {W}.)\\nSowie der Tempelgarten ins Spiel kommt, kannst du 2 Lebenspunkte bezahlen. Falls du dies nicht tust, kommt der Tempelgarten getappt ins Spiel.', 'type': 'Land — Wald, Ebene', 'flavor': 'In den Gärten des Konklaves sind Ordnung und Schönheit die Wurzeln der Macht.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355984&type=card', 'language': 'German', 'identifiers': {'scryfallId': '3afe82fe-3a8c-4bf8-bc81-749c69c29207', 'multiverseId': 355984}, 'multiverseid': 355984}, {'name': 'Jardín del templo', 'text': '({T}: Agrega {G} o {W} a tu reserva de maná.)\\nEn cuanto el Jardín del templo entre al campo de batalla, puedes pagar 2 vidas. Si no lo haces, el Jardín del templo entra al campo de batalla girado.', 'type': 'Tierra — Bosque llanura', 'flavor': 'En los jardines del Cónclave, el orden y la belleza son las raíces del poder.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365706&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '3d606661-0281-474e-bf13-d7004b102d0a', 'multiverseId': 365706}, 'multiverseid': 365706}, {'name': 'Jardin du temple', 'text': '({T} : Ajoutez {G} ou {W} à votre réserve.)\\nAu moment où le Jardin du temple arrive sur le champ de bataille, vous pouvez payer 2 points de vie. Si vous ne le faites pas, le Jardin du temple arrive sur le champ de bataille engagé.', 'type': 'Terrain : forêt et plaine', 'flavor': 'Dans les jardins du Conclave, ordre et beauté sont les racines du pouvoir.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356258&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e9137f0f-7fd3-4a36-b5fc-6915e5875470', 'multiverseId': 356258}, 'multiverseid': 356258}, {'name': 'Giardino del Tempio', 'text': '({T}: Aggiungi {G} o {W} alla tua riserva di mana.)\\nMentre il Giardino del Tempio entra nel campo di battaglia, puoi pagare 2 punti vita. Se non lo fai, il Giardino del Tempio entra nel campo di battaglia TAPpato.', 'type': 'Terra — Foresta Pianura', 'flavor': 'Nei giardini del Conclave, ordine e bellezza sono le radici del potere.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356532&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '7dbe856e-c850-4ff3-8b99-d252d95e148d', 'multiverseId': 356532}, 'multiverseid': 356532}, {'name': '寺院の庭', 'text': '（{T}：あなたのマナ・プールに{G}か{W}を加える。）\\n寺院の庭が戦場に出るに際し、あなたはライフを２点支払ってもよい。そうしない場合、寺院の庭はタップ状態で戦場に出る。', 'type': '土地 — 森・平地', 'flavor': '議事会の庭では、秩序と美が力の源となっている。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356806&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '69f60673-e781-4b2d-8ca2-c1a68157baab', 'multiverseId': 356806}, 'multiverseid': 356806}, {'name': '정원 신전', 'text': '({T}: {G} 또는 {W}를 당신의 마나풀에 담는다.)\\n정원 신전이 전장에 들어오면서, 당신은 생명 2점을 지불할 수 있다. 그러지 않으면, 정원 신전은 탭된 채로 전장에 들어온다.', 'type': '대지 — 숲 들', 'flavor': '교단의 정원에서는 질서와 아름다움이 힘의 근원이다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357628&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'b4fbc497-9482-442a-9fa9-8efe20a14131', 'multiverseId': 357628}, 'multiverseid': 357628}, {'name': 'Jardim do Templo', 'text': '({T}: Adicione {G} ou {W} à sua reserva de mana.)Conforme Jardim do Templo entra no campo de batalha, você pode pagar 2 pontos de vida. Se não fizer isso, Jardim do Templo entrará no campo de batalha virado.', 'type': 'Terreno — Floresta Planície', 'flavor': 'Nos jardins do Conclave, a ordem e a beleza são as raízes do poder.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357080&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e4f8d130-7ede-4c67-b794-dd2f2c9ea6e5', 'multiverseId': 357080}, 'multiverseid': 357080}, {'name': 'Церковный Сад', 'text': '({T}: добавьте {G} или {W} в ваше хранилище маны.)\\nПри выходе Церковного Сада на поле битвы вы можете заплатить 2 жизни. Если вы этого не делаете, Церковный Сад выходит на поле битвы повернутым.', 'type': 'Земля — Лес Равнина', 'flavor': 'В садах Конклава порядок и красота лежат в основе могущества.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355436&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '566fb6e9-15f5-4262-a581-fed8743f76ad', 'multiverseId': 355436}, 'multiverseid': 355436}, {'name': '殿堂花园', 'text': '（{T}：加{G}或{W}到你的法术力池中。）\\n于殿堂花园进战场时，你可以支付2点生命。如果你未如此作，殿堂花园须横置进战场。', 'type': '地～树林／平原', 'flavor': '在盟会的花园中，秩序和美景是力量的根源。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357354&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'dc61cd67-a8c9-4bfc-be06-b49d90cfdbda', 'multiverseId': 357354}, 'multiverseid': 357354}, {'name': '殿堂花園', 'text': '（{T}：加{G}或{W}到你的魔法力池中。）\\n於殿堂花園進戰場時，你可以支付2點生命。如果你未如此作，殿堂花園須橫置進戰場。', 'type': '地～樹林／平原', 'flavor': '在盟會的花園中，秩序和美景是力量的根源。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355710&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '944868a1-298c-43a1-b068-4913453e0bf8', 'multiverseId': 355710}, 'multiverseid': 355710}]", '[{\'name\': \'Terruswurm\', \'text\': \'Ausplündern {6}{B} ({6}{B}, schicke diese Karte aus deinem Friedhof ins Exil: Lege so viele +1/+1-Marken, wie die Stärke dieser Karte beträgt, auf eine Kreatur deiner Wahl. Spiele Ausplündern wie eine Hexerei.)\', \'type\': \'Kreatur — Zombie, Wurm\', \'flavor\': \'„Wir folgen ihm durch seine Stollen, und wo es stirbt, beginnen wir mit dem Pflanzen." —Mihas, Sporendruide\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355816&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3d3f2bad-2eff-4946-8b5f-89d8963cbff9\', \'multiverseId\': 355816}, \'multiverseid\': 355816}, {\'name\': \'Sierpe terrus\', \'text\': \'Carroñar {6}{B}. ({6}{B}, exiliar esta carta de tu cementerio: Pon sobre la criatura objetivo una cantidad de contadores +1/+1 igual a la fuerza de esta carta. Activa la habilidad de carroñar como un conjuro.)\', \'type\': \'Criatura — Sierpe zombie\', \'flavor\': \'"La seguimos a través de sus túneles y, donde muere, cultivamos." —Mihas, druida de esporas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365538&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'adde183d-34d4-4cb8-81e4-dc1dd79f10a8\', \'multiverseId\': 365538}, \'multiverseid\': 365538}, {\'name\': \'Guivre du terrus\', \'text\': \'Récupération {6}{B} ({6}{B}, exilez cette carte de votre cimetière : Mettez un nombre de marqueurs +1/+1 égal à la force de cette carte sur une créature ciblée. Ne récupérez que lorsque vous pourriez lancer un rituel.)\', \'type\': \'Créature : zombie et guivre\', \'flavor\': \'« Nous la suivons dans les tunnels et quand elle meurt, nous récoltons sur place. » —Mihas, druide des spores\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356090&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7e88e654-7941-4572-baa9-b1e7cfbca969\', \'multiverseId\': 356090}, \'multiverseid\': 356090}, {\'name\': \'Wurm di Terrus\', \'text\': \'Mangiacarogne {6}{B} ({6}{B}, Esilia questa carta dal tuo cimitero: Metti un numero di segnalini +1/+1 pari alla forza di questa carta su una creatura bersaglio. Attiva mangiacarogne solo quando potresti lanciare una stregoneria.)\', \'type\': \'Creatura — Zombie Wurm\', \'flavor\': \'"Lo seguiamo nei suoi tunnel e dove muore coltiviamo." —Mihas, druido delle spore\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356364&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5739dae8-109d-4a7b-92d3-66a79c945f26\', \'multiverseId\': 356364}, \'multiverseid\': 356364}, {\'name\': \'テーラスのワーム\', \'text\': \'活用 {6}{B} （{6}{B}, このカードをあなたの墓地から追放する：クリーチャー１体を対象とし、それの上にこのカードのパワーに等しい数の＋１/＋１カウンターを置く。活用はソーサリーとしてのみ行う。）\', \'type\': \'クリーチャー — ゾンビ・ワーム\', \'flavor\': \'「わしらはそいつを追いかけて穴を進み、そいつが死んだところで栽培を始めるんじゃ。」 ――胞子のドルイド、ミーハス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356638&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cd9724f4-d237-42fb-b0a2-4712228f088d\', \'multiverseId\': 356638}, \'multiverseid\': 356638}, {\'name\': \'테루스 웜\', \'text\': \'섭취 {6}{B} ({6}{B}, 당신의 무덤에서 이 카드를 추방한다: 생물 한 개를 목표로 정한다. 이 카드의 공격력만큼의 +1/+1 카운터를 그 생물에 올려놓는다. 당신이 집중마법을 발동할 수 있는 시기에만 섭취 능력을 활성화할 수 있다.)\', \'type\': \'생물 — 좀비 웜\', \'flavor\': \'"우린 터널을 통과해 그것을 쫓아간 후, 녀석이 죽는 곳에서 경작을 하지." —포자 드루이드 미하스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357460&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'669da1b0-090d-48f0-99cc-51abb1b6e517\', \'multiverseId\': 357460}, \'multiverseid\': 357460}, {\'name\': \'Vorme de Terrus\', \'text\': \'Necrofagia {6}{B} ({6}{B}, Exile este card de seu cemitério: Coloque uma quantidade de marcadores +1/+1 igual ao poder deste card na criatura alvo. Use necrofagia somente quando puder conjurar um feitiço.)\', \'type\': \'Criatura — Zumbi Vorme\', \'flavor\': \'"Nós o seguimos pelos túneis e, onde ele morre, nós cultivamos." — Mihas, druida dos esporos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356912&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b9dd1370-7ed1-4b37-a47d-f64d31111b41\', \'multiverseId\': 356912}, \'multiverseid\': 356912}, {\'name\': \'Террусный Вурм\', \'text\': \'Утилизация {6}{B} ({6}{B}, изгоните эту карту из вашего кладбища: положите на целевое существо жетоны +1/+1, количество которых равно силе этой карты. Утилизируйте только как волшебство.)\', \'type\': \'Существо — Зомби Вурм\', \'flavor\': \'«Мы следуем за ним по прорытым им туннелям. И там, где он умирает, мы собираем свой урожай». — Михас, споровый друид\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355268&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cfeea77b-cf0c-4a2e-8589-e173ccb42b70\', \'multiverseId\': 355268}, \'multiverseid\': 355268}, {\'name\': \'培土亚龙\', \'text\': \'食腐{6}{B}（{6}{B}，从你的坟墓场放逐此牌：在目标生物上放置若干+1/+1指示物，其数量等同于此牌的力量。食腐的时机视同法术。）\', \'type\': \'生物～灵俑／亚龙\', \'flavor\': \'「我们跟着他挖出的隧道走，他死在何处，我们就地播种。」 ～芽孢德鲁伊米哈思\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357186&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6072467b-b96e-41f0-aa43-625971432227\', \'multiverseId\': 357186}, \'multiverseid\': 357186}, {\'name\': \'培土亞龍\', \'text\': \'食腐{6}{B}（{6}{B}，從你的墳墓場放逐此牌：在目標生物上放置若干+1/+1指示物，其數量等同於此牌的力量。食腐的時機視同巫術。）\', \'type\': \'生物～殭屍／亞龍\', \'flavor\': \'「我們跟著牠挖出的隧道走，牠死在何處，我們就地播種。」 ～芽孢德魯伊米哈思\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355542&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6bd28573-8067-41ba-a38e-3c82a5caebf7\', \'multiverseId\': 355542}, \'multiverseid\': 355542}]', "[{'name': 'Todesbrücken-Goliathkäfer', 'text': 'Ausplündern {4}{G}{G} ({4}{G}{G}, schicke diese Karte aus deinem Friedhof ins Exil: Lege so viele +1/+1-Marken, wie die Stärke dieser Karte beträgt, auf eine Kreatur deiner Wahl. Spiele Ausplündern wie eine Hexerei.)', 'type': 'Kreatur — Insekt', 'flavor': 'Einige Golgari-Insekten leben jahrhundertelang — und sie hören nie auf zu wachsen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355856&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5249fe27-9b7f-4622-be45-228789ebade7', 'multiverseId': 355856}, 'multiverseid': 355856}, {'name': 'Goliat de Puente Muerto', 'text': 'Carroñar {4}{G}{G}. ({4}{G}{G}, exiliar esta carta de tu cementerio: Pon una cantidad de contadores +1/+1 sobre la criatura objetivo igual a la fuerza de esta carta. Activa la habilidad de carroñar como un conjuro.)', 'type': 'Criatura — Insecto', 'flavor': 'Algunos insectos golgari viven varios siglos y nunca dejan de crecer.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365578&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '54696042-1370-4974-b75a-a66390bf008b', 'multiverseId': 365578}, 'multiverseid': 365578}, {'name': 'Goliath de Mortepont', 'text': 'Récupération {4}{G}{G} ({4}{G}{G}, exilez cette carte de votre cimetière : Mettez un nombre de marqueurs +1/+1 égal à la force de cette carte sur une créature ciblée. Ne récupérez que lorsque vous pourriez lancer un rituel.)', 'type': 'Créature : insecte', 'flavor': 'Certains insectes Golgari vivent plusieurs siècles sans jamais cesser de grandir.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356130&type=card', 'language': 'French', 'identifiers': {'scryfallId': '5c5fad3e-f383-4ea9-a501-cd59084cd27e', 'multiverseId': 356130}, 'multiverseid': 356130}, {'name': 'Golia di Pontemorto', 'text': 'Mangiacarogne {4}{G}{G} ({4}{G}{G}, Esilia questa carta dal tuo cimitero: Metti un numero di segnalini +1/+1 pari alla forza di questa carta su una creatura bersaglio. Attiva mangiacarogne solo quando potresti lanciare una stregoneria.)', 'type': 'Creatura — Insetto', 'flavor': 'Alcuni insetti Golgari vivono secoli e non smettono mai di crescere.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356404&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '1ba33842-79de-4680-bbdd-5ec2da8001fc', 'multiverseId': 356404}, 'multiverseid': 356404}, {'name': '死橋の大巨虫', 'text': '活用 {4}{G}{G} ({4}{G}{G}, このカードをあなたの墓地から追放する：クリーチャー１体を対象とし、それの上にこのカードのパワーに等しい数の＋１/＋１カウンターを置く。活用はソーサリーとしてのみ行う。）', 'type': 'クリーチャー — 昆虫', 'flavor': 'ゴルガリの昆虫のなかには何百年も生き、しかもその間ずっと成長を続けるものがいる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356678&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '941b9768-4015-4a27-9309-411b1736ee1b', 'multiverseId': 356678}, 'multiverseid': 356678}, {'name': '죽은다리 거대곤충', 'text': '섭취 {4}{G}{G} ({4}{G}{G}, 당신의 무덤에서 이 카드를 추방한다: 생물 한 개를 목표로 정한다. 이 카드의 공격력만큼의 +1/+1 카운터를 그 생물에 올려놓는다. 당신이 집중마법을 발동할 수 있는 시기에만 섭취 능력을 활성화할 수 있다.)', 'type': '생물 — 곤충', 'flavor': '골가리 곤충 중에는 수백 년을 살면서 끝없이 자라는 것들도 있다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357500&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'ba1e463f-c413-4847-806b-1a634129a01a', 'multiverseId': 357500}, 'multiverseid': 357500}, {'name': 'Golias de Ponte Mortífera', 'text': 'Necrofagia {4}{G}{G} ({4}{G}{G}, Exile este card de seu cemitério: Coloque uma quantidade de marcadores +1/+1 igual ao poder deste card na criatura alvo. Use necrofagia somente quando puder conjurar um feitiço.)', 'type': 'Criatura — Inseto', 'flavor': 'Alguns insetos dos Golgari vivem séculos... e eles nunca param de crescer.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356952&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5b6268a1-3d76-4531-96a0-dd4b9a938e30', 'multiverseId': 356952}, 'multiverseid': 356952}, {'name': 'Голиаф Мертвого Моста', 'text': 'Утилизация {4}{G}{G} ({4}{G}{G}, изгоните эту карту из вашего кладбища: положите на целевое существо жетоны +1/+1, количество которых равно силе этой карты. Утилизируйте только как волшебство.)', 'type': 'Существо — Насекомое', 'flavor': 'Некоторые из насекомых Голгари живут столетиями... и никогда не перестают расти.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355308&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '97abc10a-4623-4729-a261-7c0b7bfec57a', 'multiverseId': 355308}, 'multiverseid': 355308}, {'name': '亡桥巨甲虫', 'text': '食腐{4}{G}{G}（{4}{G}{G}，从你的坟墓场放逐此牌：在目标生物上放置若干+1/+1指示物，其数量等同于此牌的力量。食腐的时机视同法术。）', 'type': '生物～昆虫', 'flavor': '有些葛加理昆虫可以活数百年，而且它们不会停止成长。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357226&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9682508a-9d96-4a87-b909-b385d143b6eb', 'multiverseId': 357226}, 'multiverseid': 357226}, {'name': '亡橋巨甲蟲', 'text': '食腐{4}{G}{G}（{4}{G}{G}，從你的墳墓場放逐此牌：在目標生物上放置若干+1/+1指示物，其數量等同於此牌的力量。食腐的時機視同巫術。）', 'type': '生物～昆蟲', 'flavor': '有些葛加理昆蟲可以活數百年，而且牠們不會停止成長。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355582&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'cf575582-0792-4def-86cb-efbc6da12922', 'multiverseId': 355582}, 'multiverseid': 355582}]", '[{\'name\': \'Todesgenießer\', \'text\': \'Entfesselt (Du kannst diese Kreatur mit einer +1/+1-Marke ins Spiel kommen lassen. Sie kann nicht blocken, solange eine +1/+1-Marke auf ihr liegt.)\', \'type\': \'Kreatur — Zombie\', \'flavor\': \'Er ist eine Verstimmungskanone.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355798&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1b8e1955-6a20-4c9e-b3a1-cb5c71bd36b2\', \'multiverseId\': 355798}, \'multiverseid\': 355798}, {\'name\': \'Jaranero muerto\', \'text\': \'Desatar. (Puedes hacer que esta criatura entre al campo de batalla con un contador +1/+1 sobre ella. No puede bloquear mientras tenga un contador +1/+1 sobre ella.)\', \'type\': \'Criatura — Zombie\', \'flavor\': \'Es el alma muerta de la fiesta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365520&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'24277070-438d-4569-8b0b-633f96453987\', \'multiverseId\': 365520}, \'multiverseid\': 365520}, {\'name\': \'Fêtard décédé\', \'text\': "Emportement (Vous pouvez faire arriver cette créature sur le champ de bataille avec un marqueur +1/+1 sur elle. Elle ne peut pas bloquer tant qu\'elle a un marqueur +1/+1 sur elle.)", \'type\': \'Créature : zombie\', \'flavor\': "C\'est un vrai boute-en-train.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356072&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3ac976c0-0a70-4003-8c24-25d2db5052c0\', \'multiverseId\': 356072}, \'multiverseid\': 356072}, {\'name\': \'Festaiolo Morto\', \'text\': \'Scatenare (Puoi far entrare questa creatura nel campo di battaglia con un segnalino +1/+1. Non può bloccare fintanto che ha un segnalino +1/+1.)\', \'type\': \'Creatura — Zombie\', \'flavor\': "È l\'anima dannata della festa.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356346&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e6ed52b1-7122-43dc-8906-20563c2b0f22\', \'multiverseId\': 356346}, \'multiverseid\': 356346}, {\'name\': \'死の歓楽者\', \'text\': \'解鎖（あなたはこのクリーチャーを、＋１/＋１カウンターが１個置かれた状態で戦場に出してよい。これの上に＋１/＋１カウンターが置かれているかぎり、これではブロックできない。）\', \'type\': \'クリーチャー — ゾンビ\', \'flavor\': \'パーティーの盛り下げ役。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356620&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'11ec5b4b-1f6f-44b1-bbe6-b137c263df20\', \'multiverseId\': 356620}, \'multiverseid\': 356620}, {\'name\': \'죽은 난봉꾼\', \'text\': \'속박해제 (당신은 이 생물로 하여금 +1/+1 카운터 한 개를 가지고 전장에 들어오도록 할 수 있다. 이 생물은 +1/+1 카운터를 가지고 있는 한 방어할 수 없다.)\', \'type\': \'생물 — 좀비\', \'flavor\': \'그가 있는 곳은 분위기가 영 좋지 않다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357442&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'00ed6f37-0b7b-47c6-b241-748a87d58a09\', \'multiverseId\': 357442}, \'multiverseid\': 357442}, {\'name\': \'Farrista Morto\', \'text\': \'Liberar (Você pode fazer com que esta criatura entre no campo de batalha com um marcador +1/+1. Ela não poderá bloquear enquanto tiver um marcador +1/+1.)\', \'type\': \'Criatura — Zumbi\', \'flavor\': \'Ele garante a reanimação da festa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356894&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7f67c9dd-53f6-4f2d-9a42-f2163865cb43\', \'multiverseId\': 356894}, \'multiverseid\': 356894}, {\'name\': \'Мертвый Гуляка\', \'text\': \'Безудержность (Вы можете заставить это существо выйти на поле битвы с жетоном +1/+1 на нем. Оно не может блокировать, пока на нем есть жетон +1/+1.)\', \'type\': \'Существо — Зомби\', \'flavor\': \'Он — мертвая душа любой компании.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355250&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'10189f0b-b344-4d8d-a61e-bc4a11336216\', \'multiverseId\': 355250}, \'multiverseid\': 355250}, {\'name\': \'死亡狂欢人\', \'text\': \'脱缰（你可以让此生物进战场时上面有一个+1/+1指示物。只要其上有+1/+1指示物，它就不能进行阻挡。）\', \'type\': \'生物～灵俑\', \'flavor\': \'他的活力死射。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357168&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2745db10-37e6-49af-b73d-c96da5f34de1\', \'multiverseId\': 357168}, \'multiverseid\': 357168}, {\'name\': \'死亡狂歡人\', \'text\': \'脫韁（你可以讓此生物進戰場時上面有一個+1/+1指示物。只要其上有+1/+1指示物，它就不能進行阻擋。）\', \'type\': \'生物～殭屍\', \'flavor\': \'他的活力死射。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355524&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b3214b9e-4145-4080-850b-37fe33769ab3\', \'multiverseId\': 355524}, \'multiverseid\': 355524}]', '[{\'name\': \'Todesritenschamane\', \'text\': \'{T}: Schicke eine Land-Karte deiner Wahl aus einem Friedhof ins Exil. Erhöhe deinen Manavorrat um ein Mana einer beliebigen Farbe.\\n{B}, {T}: Schicke eine Sofortzauber- oder Hexereikarte deiner Wahl aus einem Friedhof ins Exil. Jeder Gegner verliert 2 Lebenspunkte.\\n{G}, {T}: Schicke eine Kreaturenkarte deiner Wahl aus einem Friedhof ins Exil. Du erhältst 2 Lebenspunkte dazu.\', \'type\': \'Kreatur — Elf, Schamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355949&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b6bb6e8c-d47b-4090-93cf-94e7685578a9\', \'multiverseId\': 355949}, \'multiverseid\': 355949}, {\'name\': \'Chamán rito mortal\', \'text\': \'{T}: Exilia la carta de tierra objetivo de un cementerio. Agrega un maná de cualquier color a tu reserva de maná.\\n{B}, {T}: Exilia la carta de instantáneo o de conjuro objetivo de un cementerio. Cada oponente pierde 2 vidas.\\n{G}, {T}: Exilia la carta de criatura objetivo de un cementerio. Ganas 2 vidas.\', \'type\': \'Criatura — Chamán elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365671&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7be0c91d-e8d4-4b94-b93c-7d41f93e463a\', \'multiverseId\': 365671}, \'multiverseid\': 365671}, {\'name\': \'Shamane ritemort\', \'text\': "{T} : Exilez une carte de terrain ciblée d\'un cimetière. Ajoutez un mana de la couleur de votre choix à votre réserve.\\n{B}, {T} : Exilez une carte d\'éphémère ou de rituel ciblée d\'un cimetière. Chaque adversaire perd 2 points de vie.\\n{G}, {T} : Exilez une carte de créature ciblée d\'un cimetière. Vous gagnez 2 points de vie.", \'type\': \'Créature : elfe et shamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356223&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e49e3ce8-5702-4bf6-8215-cd2b59b0cf4c\', \'multiverseId\': 356223}, \'multiverseid\': 356223}, {\'name\': \'Sciamano Letalmago\', \'text\': \'{T}: Esilia una carta terra bersaglio da un cimitero. Aggiungi un mana di un qualsiasi colore alla tua riserva di mana.\\n{B}, {T}: Esilia una carta istantaneo o stregoneria bersaglio da un cimitero. Ogni avversario perde 2 punti vita.\\n{G}, {T}: Esilia una carta creatura bersaglio da un cimitero. Guadagni 2 punti vita.\', \'type\': \'Creatura — Sciamano Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356497&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e260c7c1-1d92-4ed2-91ff-fd92390916c7\', \'multiverseId\': 356497}, \'multiverseid\': 356497}, {\'name\': \'死儀礼のシャーマン\', \'text\': \'{T}：いずれかの墓地にある土地カード１枚を対象とし、それを追放する。あなたのマナ・プールに、好きな色１色のマナ１点を加える。\\n{B}, {T}：いずれかの墓地にあるインスタント・カード１枚かソーサリー・カード１枚を対象とし、それを追放する。各対戦相手はそれぞれ2点のライフを失う。\\n{G}, {T}：いずれかの墓地にあるクリーチャー・カード１枚を対象とし、それを追放する。あなたは２点のライフを得る。\', \'type\': \'クリーチャー — エルフ・シャーマン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356771&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'190c1f11-35e8-40d9-8784-f95078c19cd6\', \'multiverseId\': 356771}, \'multiverseid\': 356771}, {\'name\': \'사망의식 주술사\', \'text\': \'{T}: 무덤에 있는 대지 카드 한 장을 목표로 정한다. 그 카드를 추방한다. 당신의 마나풀에 원하는 색의 마나 한 개를 담는다.\\n{B}, {T}: 무덤에 있는 순간마법 또는 집중마법 카드 한 장을 목표로 정한다. 그 카드를 추방한다. 각 상대는 생명 2점을 잃는다.\\n{G}, {T}: 무덤에 있는 생물 카드 한 장을 목표로 정한다. 그 카드를 추방한다. 당신은 생명 2점을 얻는다.\', \'type\': \'생물 — 엘프 주술사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357593&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6564399b-3459-4e31-940f-186a8567ec80\', \'multiverseId\': 357593}, \'multiverseid\': 357593}, {\'name\': \'Xamã do Ritual Mortfífero\', \'text\': \'{T}: Exile o card de terreno alvo de um cemitério. Adicione um mana de qualquer cor à sua reserva de mana.\\n{B}, {T}: Exile o card de mágica instantânea ou feitiço alvo de um cemitério. Cada oponente perde 2 pontos de vida.\\n{G}, {T}: Exile o card de criatura alvo de um cemitério. Você ganha 2 pontos de vida.\', \'type\': \'Criatura — Elfo Xamã\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357045&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'feab4407-7b70-439a-a11f-aee6a14c02e6\', \'multiverseId\': 357045}, \'multiverseid\': 357045}, {\'name\': \'Шаман Обряда Смерти\', \'text\': \'{T}: изгоните целевую карту земли из кладбища. Добавьте одну ману любого цвета в ваше хранилище маны.\\n{B}, {T}: изгоните целевую карту мгновенного заклинания или волшебства из кладбища. Каждый оппонент теряет 2 жизни.\\n{G}, {T}: изгоните целевую карту существа из кладбища. Вы получаете 2 жизни.\', \'type\': \'Существо — Эльф Шаман\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355401&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ed3d110a-cbc4-4855-b8c5-258d0c888cc0\', \'multiverseId\': 355401}, \'multiverseid\': 355401}, {\'name\': \'丧仪祭师\', \'text\': \'{T}：将目标地牌从坟墓场放逐。加一点任意颜色的法术力到你的法术力池中。\\n{B}，{T}：将目标瞬间或法术牌从坟墓场放逐。每位对手各失去2点生命。\\n{G}，{T}：将目标生物牌从坟墓场放逐。你获得2点生命。\', \'type\': \'生物～妖精／祭师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357319&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'79ab2ebd-8130-4743-8196-165352beb7f0\', \'multiverseId\': 357319}, \'multiverseid\': 357319}, {\'name\': \'喪儀祭師\', \'text\': \'{T}：將目標地牌從墳墓場放逐。加一點任意顏色的魔法力到你的魔法力池中。\\n{B}，{T}：將目標瞬間或巫術牌從墳墓場放逐。每位對手各失去2點生命。\\n{G}，{T}：將目標生物牌從墳墓場放逐。你獲得2點生命。\', \'type\': \'生物～妖精／祭師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355675&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1a9bcb97-45e2-4138-b0f4-2265afac9067\', \'multiverseId\': 355675}, \'multiverseid\': 355675}]', '[{\'name\': \'Torumschlingende Ranke\', \'text\': \'Verteidiger\\nWenn die Torumschlingende Ranke ins Spiel kommt, kannst du deine Bibliothek nach einer Standardland-Karte oder einer Tor-Karte durchsuchen, sie offen vorzeigen, auf deine Hand nehmen und dann deine Bibliothek mischen.\', \'type\': \'Kreatur — Pflanze\', \'flavor\': \'Jeder Winkel von Ravnica wird von irgendetwas bewohnt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355860&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'69c10b79-0e46-4e2d-bc78-34565692c506\', \'multiverseId\': 355860}, \'multiverseid\': 355860}, {\'name\': \'Enredadera del portal\', \'text\': \'Defensor.\\nCuando la Enredadera del portal entre al campo de batalla, puedes buscar en tu biblioteca una carta de tierra básica o de Portal, mostrarla, ponerla en tu mano y luego barajar tu biblioteca.\', \'type\': \'Criatura — Planta\', \'flavor\': \'Cada centímetro de Rávnica es el hogar de algo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365582&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d6dc3d3c-891d-4441-95de-506b9bc163e5\', \'multiverseId\': 365582}, \'multiverseid\': 365582}, {\'name\': \'Lierre grimpe-porte\', \'text\': \'Défenseur\\nQuand le Lierre grimpe-porte arrive sur le champ de bataille, vous pouvez chercher dans votre bibliothèque une carte de terrain de base ou une carte de porte, la révéler, la mettre dans votre main et mélanger ensuite votre bibliothèque.\', \'type\': \'Créature : plante\', \'flavor\': "Il n\'est pas un centimètre de Ravnica qui soit inhabité.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356134&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5d4281d9-bc28-4723-9910-561d947300d1\', \'multiverseId\': 356134}, \'multiverseid\': 356134}, {\'name\': \'Rampicante del Cancello\', \'text\': \'Difensore\\nQuando il Rampicante del Cancello entra nel campo di battaglia, puoi passare in rassegna il tuo grimorio per una carta terra base o una carta Cancello, rivelarla e aggiungerla alla tua mano. Poi rimescola il tuo grimorio.\', \'type\': \'Creatura — Pianta\', \'flavor\': \'Ogni centimetro di Ravnica è la casa di qualcuno... o qualcosa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356408&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2ee82e7d-9954-4ea1-834e-bf574657a836\', \'multiverseId\': 356408}, \'multiverseid\': 356408}, {\'name\': \'門を這う蔦\', \'text\': \'防衛\\n門を這う蔦が戦場に出たとき、あなたはあなたのライブラリーから基本土地カードか門カードを１枚探してもよい。そうしたなら、それを公開してあなたの手札に加え、その後あなたのライブラリーを切り直す。\', \'type\': \'クリーチャー — 植物\', \'flavor\': \'ラヴニカは隅から隅まで何かの住処だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356682&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'447a0b0e-5242-4810-9b18-434fc06944c8\', \'multiverseId\': 356682}, \'multiverseid\': 356682}, {\'name\': \'관문을 덮는 넝쿨\', \'text\': \'수비태세\\n관문을 덮는 넝쿨이 전장에 들어올 때, 당신은 당신의 서고에서 기본 대지 카드 한 장 또는 관문 카드 한 장을 찾을 수 있다. 그렇게 한다면 그것을 공개하고 당신의 손으로 가져간 후, 당신의 서고를 섞는다.\', \'type\': \'생물 — 식물\', \'flavor\': \'라브니카에 아무 것도 살지 않는 곳은 없다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357504&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e0fe667f-bfaf-4849-810e-56ee3e387fb4\', \'multiverseId\': 357504}, \'multiverseid\': 357504}, {\'name\': \'Trepadeira de Portão\', \'text\': \'Defensor\\nQuando Trepadeira de Portão entra no campo de batalha, você pode procurar um card de terreno básico ou do tipo Portão em seu grimório, revelá-lo, colocá-lo na sua mão e depois embaralhar seu grimório.\', \'type\': \'Criatura — Planta\', \'flavor\': \'Cada centímetro de Ravnica é o lar de alguma coisa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356956&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'10c8132b-8787-4a2f-a1ba-4d1e40cf6903\', \'multiverseId\': 356956}, \'multiverseid\': 356956}, {\'name\': \'Лоза на Вратах\', \'text\': \'Защитник\\nКогда Лоза на Вратах выходит на поле битвы, вы можете найти в вашей библиотеке карту базовой земли или карту Врат, показать ее, положить ее в вашу руку, затем перетасовать вашу библиотеку.\', \'type\': \'Существо — Растение\', \'flavor\': \'Каждая пядь земли Равники кем-нибудь да населена.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355312&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b69a0930-9a5a-4fe2-b927-67f3a3d65f18\', \'multiverseId\': 355312}, \'multiverseid\': 355312}, {\'name\': \'蔓门野葛\', \'text\': \'守军\\n当蔓门野葛进战场时，你可以从你牌库中搜寻一张基本地牌或门牌，展示该牌，将它置入你手上，然后将你的牌库洗牌。\', \'type\': \'生物～植物\', \'flavor\': \'拉尼卡的每一吋土地都是某种生物的家。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357230&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9019c56c-9cc0-453e-b03b-e670e902ebd2\', \'multiverseId\': 357230}, \'multiverseid\': 357230}, {\'name\': \'蔓門野葛\', \'text\': \'守軍\\n當蔓門野葛進戰場時，你可以從你牌庫中搜尋一張基本地牌或門牌，展示該牌，將它置入你手上，然後將你的牌庫洗牌。\', \'type\': \'生物～植物\', \'flavor\': \'拉尼卡的每一吋土地都是某種生物的家。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355586&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'aff64ed0-168a-4ec8-b975-e9f58ce5f519\', \'multiverseId\': 355586}, \'multiverseid\': 355586}]', '[{\'name\': \'Trennendes Wachstum\', \'text\': \'Zerstöre ein Artefakt oder eine Verzauberung deiner Wahl und führe dann Bevölkern durch. (Bringe einen Spielstein ins Spiel, der eine Kopie eines Kreaturenspielsteins ist, den du kontrollierst.)\', \'type\': \'Spontanzauber\', \'flavor\': \'„Eines Tages wird jede Säule ein Baum und jede Halle eine Lichtung sein." —Trostani\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355959&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'59fd48c8-f478-4073-a5f1-4f27cc2068b3\', \'multiverseId\': 355959}, \'multiverseid\': 355959}, {\'name\': \'Crecimiento quebrador\', \'text\': \'Destruye el artefacto o encantamiento objetivo, luego repuebla. (Pon en el campo de batalla una ficha que es una copia de una ficha de criatura que controlas.)\', \'type\': \'Instantáneo\', \'flavor\': \'"Algún día toda columna será un árbol y todo salón será un claro." —Trostani\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365681&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b86f855c-ae5e-441f-9b0a-04c00506b0d5\', \'multiverseId\': 365681}, \'multiverseid\': 365681}, {\'name\': \'Croissance morceleuse\', \'text\': "Détruisez l\'artefact ciblé ou l\'enchantement ciblé, puis peuplez. (Mettez sur le champ de bataille un jeton qui est une copie d\'un jeton de créature que vous contrôlez.)", \'type\': \'Éphémère\', \'flavor\': \'« Un jour, il y aura un arbre à la place de chaque colonne, et une clairière à la place de chaque hall. » —Trostani\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356233&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'32b3f450-03c8-4807-8fb8-f266eeb5fb5e\', \'multiverseId\': 356233}, \'multiverseid\': 356233}, {\'name\': \'Crescita Dilaniante\', \'text\': \'Distruggi un artefatto o un incantesimo bersaglio, poi popola. (Metti sul campo di battaglia una pedina che è una copia di una pedina creatura che controlli.)\', \'type\': \'Istantaneo\', \'flavor\': \'"Un giorno ogni colonna sarà un albero e ogni sala una radura." —Trostani\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356507&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7e7f88d9-b49e-426b-a2a5-244a0f1f1508\', \'multiverseId\': 356507}, \'multiverseid\': 356507}, {\'name\': \'隔離する成長\', \'text\': \'アーティファクト１つかエンチャント１つを対象とし、それを破壊する。その後居住を行う。（あなたがコントロールするクリーチャー・トークン１体のコピーであるトークンを１体戦場に出す。）\', \'type\': \'インスタント\', \'flavor\': \'「いつの日か、すべての柱は木立となり、すべての集会所は空き地となるでしょう。」 ――トロスターニ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356781&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0e25291b-18bd-437c-bacb-947bb17652e4\', \'multiverseId\': 356781}, \'multiverseid\': 356781}, {\'name\': \'분쇄하는 성장\', \'text\': \'마법물체 또는 부여마법 한 개를 목표로 정한다. 그 목표를 파괴한 후 소집한다. (당신이 조종하는 어느 생물 토큰의 복사본인 토큰 한 개를 전장에 놓는다.)\', \'type\': \'순간마법\', \'flavor\': \'"언젠가 모든 기둥은 나무가 되고 모든 방은 숲이 될 것이다." —트로스타니\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357603&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c5f7852f-3356-4da1-857a-d4ea9c3cfd94\', \'multiverseId\': 357603}, \'multiverseid\': 357603}, {\'name\': \'Crescimento Despedaçador\', \'text\': \'Destrua o artefato ou encantamento alvo e depois povoe. (Coloque no campo de batalha uma ficha que seja uma cópia de uma ficha de criatura que você controla.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Um dia, todo pilar será uma árvore, e todo salão, uma clareira." — Trostani\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357055&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'21ddcc66-1eac-4f1d-b960-ce48b501b22f\', \'multiverseId\': 357055}, \'multiverseid\': 357055}, {\'name\': \'Разрушающий Рост\', \'text\': \'Уничтожьте целевой артефакт или чары, затем используйте Заселение. (Положите на поле битвы одну фишку, являющуюся копией фишки существа под вашим контролем.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Когда-нибудь каждая колонна станет деревом, а каждая зала — поляной». — Тростани\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355411&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4e8e5d98-dd20-4611-a269-656bedc8f93d\', \'multiverseId\': 355411}, \'multiverseid\': 355411}, {\'name\': \'破散生长\', \'text\': \'消灭目标神器或结界，然后殖民。（将一个衍生物放进战场，此衍生物为由你操控的某衍生生物之复制品。）\', \'type\': \'瞬间\', \'flavor\': \'「总有一天，每根柱子都将成为树木，而每座厅堂都将会是林地。」 ～卓塔妮\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357329&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'12fe54ea-88d5-4d8f-8479-b8f3f6779f18\', \'multiverseId\': 357329}, \'multiverseid\': 357329}, {\'name\': \'破散生長\', \'text\': \'消滅目標神器或結界，然後殖民。（將一個衍生物放進戰場，此衍生物為由你操控的某衍生生物之複製品。）\', \'type\': \'瞬間\', \'flavor\': \'「總有一天，每根柱子都將成為樹木，而每座廳堂都將會是林地。」 ～卓塔妮\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355685&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'66543462-7ad0-4da0-8b90-a51486105507\', \'multiverseId\': 355685}, \'multiverseid\': 355685}]', '[{\'name\': \'Treue Seele\', \'text\': \'Fliegend\', \'type\': \'Kreatur — Geist\', \'flavor\': \'Für die Azorius ist die Chance, dem Gesetz zu dienen, eine zu große Ehre, als dass der Tod dabei stören dürfte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355960&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'24d3cef6-ad02-42d7-9e84-05130b044e44\', \'multiverseId\': 355960}, \'multiverseid\': 355960}, {\'name\': \'Alma de vasallo\', \'text\': \'Vuela.\', \'type\': \'Criatura — Espíritu\', \'flavor\': \'Para los azorios, la oportunidad de servir a la ley es un honor demasiado grande como para permitir que la muerte lo interrumpa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365682&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1288eec8-a876-4b67-b599-2fa4a32aba1f\', \'multiverseId\': 365682}, \'multiverseid\': 365682}, {\'name\': \'Âme vassale\', \'text\': \'Vol\', \'type\': \'Créature : esprit\', \'flavor\': "Chez les Azorius, servir la loi est un trop grand honneur pour laisser la mort s\'y opposer.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356234&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'06c66fc5-8f9d-4998-8745-2e2cdb4476a9\', \'multiverseId\': 356234}, \'multiverseid\': 356234}, {\'name\': \'Vassallo Cuorfedele\', \'text\': \'Volare\', \'type\': \'Creatura — Spirito\', \'flavor\': "Agli occhi degli Azorius, l\'opportunità di servire la legge è un onore troppo grande per lasciare che la morte interferisca.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356508&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'463d2cbb-216c-4cae-8237-7de0b1c6c218\', \'multiverseId\': 356508}, \'multiverseid\': 356508}, {\'name\': \'臣下の魂\', \'text\': \'飛行\', \'type\': \'クリーチャー — スピリット\', \'flavor\': \'アゾリウスにとって法に仕える機会は大変な名誉であり、死ですらそれを妨げられない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356782&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1bce8dd5-2cec-4850-aa30-744976d9c983\', \'multiverseId\': 356782}, \'multiverseid\': 356782}, {\'name\': \'종속된 영혼\', \'text\': \'비행\', \'type\': \'생물 — 신령\', \'flavor\': \'아조리우스 길드원들에게 법을 수호하는 것은 죽음 따위가 방해할 수 없는 최고의 영예다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357604&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f6de2592-a203-4619-98ac-a0a996c0a058\', \'multiverseId\': 357604}, \'multiverseid\': 357604}, {\'name\': \'Alma Vassala\', \'text\': \'Voar\', \'type\': \'Criatura — Espírito\', \'flavor\': \'Para os Azorius, a oportunidade de servir à lei é uma honra grande demais para que a morte a interrompa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357056&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'93d6b844-86d8-452f-8247-9164da2108ef\', \'multiverseId\': 357056}, \'multiverseid\': 357056}, {\'name\': \'Душа Вассала\', \'text\': \'Полет\', \'type\': \'Существо — Дух\', \'flavor\': \'Для Азориусов возможность служить закону является слишком большой честью для того, чтобы этому смогла помешать смерть.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355412&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'126ad632-1dd4-4a8f-8c09-5c6d294d3241\', \'multiverseId\': 355412}, \'multiverseid\': 355412}, {\'name\': \'家臣灵魂\', \'text\': \'飞行\', \'type\': \'生物～精怪\', \'flavor\': \'对俄佐立来说，效忠律法的机会是极大荣耀，连死亡都不可将之干预。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357330&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dd1d6394-4660-42bd-b40a-a70571c46b05\', \'multiverseId\': 357330}, \'multiverseid\': 357330}, {\'name\': \'家臣靈魂\', \'text\': \'飛行\', \'type\': \'生物～精靈\', \'flavor\': \'對俄佐立來說，效忠律法的機會是極大榮耀，連死亡都不可將之干預。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355686&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'dc488f09-147c-4adb-9c97-c65663fc5884\', \'multiverseId\': 355686}, \'multiverseid\': 355686}]', '[{\'name\': \'Trick des Chemisters\', \'text\': \'Eine Kreatur deiner Wahl, die du nicht kontrollierst, erhält -2/-0 bis zum Ende des Zuges und greift in diesem Zug an, falls möglich.\\nÜberlast {3}{U}{R} (Du kannst diesen Zauber zu seinen Überlast-Kosten wirken. Falls du dies tust, verändere seinen Text, indem du im Text alle Vorkommen von „deiner Wahl" durch „jeder" ersetzt.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355885&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d429ea16-8dea-425c-b419-3a27a008d6ac\', \'multiverseId\': 355885}, \'multiverseid\': 355885}, {\'name\': \'Truco del quimista\', \'text\': \'La criatura objetivo que no controlas obtiene -2/-0 hasta el final del turno y ataca este turno si puede.\\nSobrecarga {3}{U}{R}. (Puedes lanzar este hechizo por su coste de sobrecarga. Si lo haces, cambia su texto reemplazando "la criatura objetivo" por "cada criatura".)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365607&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'809b137a-1ede-4de6-8b4c-759f22b6a5ed\', \'multiverseId\': 365607}, \'multiverseid\': 365607}, {\'name\': \'Ruse du chimiste\', \'text\': "Une créature ciblée que vous ne contrôlez pas gagne -2/-0 jusqu\'à la fin du tour et attaque ce tour-ci si possible.\\nSurcharge {3}{U}{R} (Vous pouvez lancer ce sort pour son coût de surcharge. Si vous faites ainsi, modifiez son texte en remplaçant toutes les occurrences de « ciblé(e) » par « chaque ».)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356159&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'44cd2e7e-e8cf-494c-9f1b-7a65e2f036ed\', \'multiverseId\': 356159}, \'multiverseid\': 356159}, {\'name\': \'Trucco del Chimimago\', \'text\': \'Una creatura bersaglio che non controlli prende -2/-0 fino alla fine del turno e attacca in questo turno, se può farlo.\\nSovraccarico {3}{U}{R} (Puoi lanciare questa magia per il suo costo di sovraccarico. Se lo fai, cambiane il testo sostituendo "una creatura bersaglio" con "ogni creatura".)\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356433&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c930a87b-b8dc-45bd-b673-db782fc32a99\', \'multiverseId\': 356433}, \'multiverseid\': 356433}, {\'name\': \'薬術師の計略\', \'text\': \'あなたがコントロールしていないクリーチャー１体を対象とする。それはターン終了時まで－２/－０の修整を受けるとともに、このターン可能なら攻撃する。\\n超過 {3}{U}{R} （あなたはこの呪文をその超過コストで唱えてもよい。そうした場合、あなたがコントロールしていない各クリーチャーは、ターン終了時までそれぞれ－２/－０の修整を受けるとともに、このターン可能なら攻撃する。）\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356707&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'68c5edb5-2bfc-4cb3-9247-e499cdfcc389\', \'multiverseId\': 356707}, \'multiverseid\': 356707}, {\'name\': \'화학술사의 속임수\', \'text\': \'당신이 조종하지 않는 생물 한 개를 목표로 정한다. 그 생물은 턴종료까지 -2/-0을 받고 가능하면 이 턴에 공격한다.\\n과부하 {3}{U}{R} (당신은 과부하 비용을 지불하여 이 주문을 발동할 수 있다. 그럴 경우, 이 주문은 "당신이 조종하지 않는 각 생물은 턴종료까지 -2/-0을 받고 가능하면 이 턴에 공격한다"로 내용이 변한다.)\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357529&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'07e6ec2c-dfdf-4e4e-9fdd-37344b980edd\', \'multiverseId\': 357529}, \'multiverseid\': 357529}, {\'name\': \'Truque do Quimiomante\', \'text\': \'A criatura alvo que você não controla recebe -2/-0 até o final do turno e ataca neste turno se estiver apta.\\nSobrecarga {3}{U}{R} (Você pode conjurar esta mágica pagando seu custo de sobrecarga. Se fizer isso, altere seu texto substituindo todas as ocorrências de "a criatura alvo" por "cada criatura".)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356981&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9c5ce28c-a25c-4004-bc44-61a977b206e2\', \'multiverseId\': 356981}, \'multiverseid\': 356981}, {\'name\': \'Хитрость Химика\', \'text\': \'Целевое существо не под вашим контролем получает -2/-0 до конца хода и атакует в этом ходу, если может.\\nПерегрузка {3}{U}{R} (Вы можете разыграть это заклинание за его стоимость Перегрузки. Если вы это делаете, измените в его тексте все слова «целевой» на «каждый».)\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355337&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'725cc4f6-4bcc-4769-be8e-1421f2a5460b\', \'multiverseId\': 355337}, \'multiverseid\': 355337}, {\'name\': \'化学师的诡计\', \'text\': \'直到回合结束，目标不由你操控的生物得-2/-0且本回合若能攻击，则必须进行攻击。\\n超载{3}{U}{R}（你可以支付此咒语的超载费用来施放它。如果你如此作，将其中的「目标」字样全部更改为「每个」。）\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357255&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'272f5f84-6313-4a5c-adda-a8b669f80e3c\', \'multiverseId\': 357255}, \'multiverseid\': 357255}, {\'name\': \'化學師的詭計\', \'text\': \'直到回合結束，目標不由你操控的生物得-2/-0且本回合若能攻擊，則必須進行攻擊。\\n超載{3}{U}{R}（你可以支付此咒語的超載費用來施放它。如果你如此作，將其中的「目標」字樣全部更改為「每個」。）\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355611&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0181c56d-d12d-4297-96dd-1e8fafb57f60\', \'multiverseId\': 355611}, \'multiverseid\': 355611}]', '[{\'name\': \'Trostani, die Stimme Selesnijas\', \'text\': \'Immer wenn eine andere Kreatur unter deiner Kontrolle ins Spiel kommt, erhältst du so viele Lebenspunkte dazu, wie die Widerstandskraft dieser Kreatur beträgt.\\n{1}{G}{W}, {T}: Führe Bevölkern durch. (Bringe einen Spielstein ins Spiel, der eine Kopie eines Kreaturenspielsteins ist, den du kontrollierst.)\', \'type\': \'Legendäre Kreatur — Dryade\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355942&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ad473ef1-7177-4c6a-a94f-1ac7c69794a0\', \'multiverseId\': 355942}, \'multiverseid\': 355942}, {\'name\': \'Trostani, la voz de Selesnya\', \'text\': \'Siempre que otra criatura entre al campo de batalla bajo tu control, ganas una cantidad de vidas igual a la resistencia de esa criatura.\\n{1}{G}{W}, {T}: Repuebla. (Pon en el campo de batalla una ficha que es una copia de una ficha de criatura que controlas.)\', \'type\': \'Criatura legendaria — Dríada\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365664&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f74626b5-0e21-44e0-8376-223c33b48ea9\', \'multiverseId\': 365664}, \'multiverseid\': 365664}, {\'name\': \'Trostani, Voix de Selesnya\', \'text\': "À chaque fois qu\'une autre créature arrive sur le champ de bataille sous votre contrôle, vous gagnez un nombre de points de vie égal à l\'endurance de cette créature.\\n{1}{G}{W}, {T} : Peuplez. (Mettez sur le champ de bataille un jeton qui est une copie d\'un jeton de créature que vous contrôlez.)", \'type\': \'Créature légendaire : dryade\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356216&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'91ba9b3d-d8e4-4c8c-a6ff-102cb7774a2e\', \'multiverseId\': 356216}, \'multiverseid\': 356216}, {\'name\': \'Trostani, Voce di Selesnya\', \'text\': "Ogniqualvolta un\'altra creatura entra nel campo di battaglia sotto il tuo controllo, guadagni punti vita pari alla costituzione di quella creatura.\\n{1}{G}{W}, {T}: Popola. (Metti sul campo di battaglia una pedina che è una copia di una pedina creatura che controlli.)", \'type\': \'Creatura Leggendaria — Driade\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356490&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9271d523-2f4d-43a5-871f-bb640a636e86\', \'multiverseId\': 356490}, \'multiverseid\': 356490}, {\'name\': \'セレズニアの声、トロスターニ\', \'text\': \'他のクリーチャーが１体あなたのコントロール下で戦場に出るたび、あなたはそのクリーチャーのタフネスに等しい点数のライフを得る。\\n{1}{G}{W}, {T}：居住を行う。（あなたがコントロールするクリーチャー・トークン１体のコピーであるトークンを１体戦場に出す。）\', \'type\': \'伝説のクリーチャー — ドライアド\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356764&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1fb05c3b-9e29-4832-ae4f-c7c4c538e379\', \'multiverseId\': 356764}, \'multiverseid\': 356764}, {\'name\': \'셀레스냐의 목소리 트로스타니\', \'text\': \'다른 생물이 당신의 조종하에 전장에 들어올 때마다, 당신은 그 생물의 방어력만큼 생명점을 얻는다.\\n{1}{G}{W}, {T}: 소집한다. (당신이 조종하는 어느 생물 토큰의 복사본인 토큰 한 개를 전장에 놓는다.)\', \'type\': \'전설적 생물 — 드라이어드\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357586&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'eadc40d6-41bb-41fb-9d7c-a1b0a7c5f845\', \'multiverseId\': 357586}, \'multiverseid\': 357586}, {\'name\': \'Trostani, Voz dos Selesnya\', \'text\': \'Toda vez que outra criatura entra no campo de batalha sob o seu controle, você ganha uma quantidade de pontos de vida igual à resistência daquela criatura.\\n{1}{G}{W}, {T}: Povoe. (Coloque no campo de batalha uma ficha que seja uma cópia de uma ficha de criatura que você controla.)\', \'type\': \'Criatura Lendária — Dríade\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357038&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'81b03155-c73a-4d81-8896-cb895f2596e6\', \'multiverseId\': 357038}, \'multiverseid\': 357038}, {\'name\': \'Тростани, Голос Селезнии\', \'text\': \'Каждый раз, когда другое существо выходит на поле битвы под вашим контролем, вы получаете количество жизней, равное выносливости того существа.\\n{1}{G}{W}, {T}: используйте Заселение. (Положите на поле битвы одну фишку, являющуюся копией фишки существа под вашим контролем.)\', \'type\': \'Легендарное Существо — Дриада\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355394&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'00b6d97d-7919-4486-801f-61c4075714f1\', \'multiverseId\': 355394}, \'multiverseid\': 355394}, {\'name\': \'瑟雷尼亚之声卓塔妮\', \'text\': \'每当另一个生物在你的操控下进战场时，你获得等同于该生物防御力的生命。\\n{1}{G}{W}，{T}：殖民。（将一个衍生物放进战场，此衍生物为由你操控的某衍生生物之复制品。）\', \'type\': \'传奇生物～树灵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357312&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d126f0e4-0930-48a1-9cc2-ed33ab17b3c6\', \'multiverseId\': 357312}, \'multiverseid\': 357312}, {\'name\': \'瑟雷尼亞之聲卓塔妮\', \'text\': \'每當另一個生物在你的操控下進戰場時，你獲得等同於該生物防禦力的生命。\\n{1}{G}{W}，{T}：殖民。（將一個衍生物放進戰場，此衍生物為由你操控的某衍生生物之複製品。）\', \'type\': \'傳奇生物～樹靈\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355668&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'901c9b34-0592-4618-9670-e28105f37e6d\', \'multiverseId\': 355668}, \'multiverseid\': 355668}]', '[{\'name\': \'Trostanis Abrechnung\', \'text\': \'Schicke eine Kreatur deiner Wahl ins Exil und führe dann Bevölkern durch. (Bringe einen Spielstein ins Spiel, der eine Kopie eines Kreaturenspielsteins ist, den du kontrollierst.)\', \'type\': \'Spontanzauber\', \'flavor\': \'„Nicht alle können in ihrer derzeitigen Gestalt gerettet werden, aber alle können der Weltenseele dienen." —Trostani\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355764&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'48a96681-e099-4874-af93-2299d3f1ab6f\', \'multiverseId\': 355764}, \'multiverseid\': 355764}, {\'name\': \'Juicio de Trostani\', \'text\': \'Exilia a la criatura objetivo, luego repuebla. (Pon en el campo de batalla una ficha que es una copia de una ficha de criatura que controlas.)\', \'type\': \'Instantáneo\', \'flavor\': \'"A algunos ya no se les puede salvar, pero todos pueden servir al Alma del mundo." —Trostani\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365486&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'20d43f1c-5623-4788-bdd0-dd517c1c9e46\', \'multiverseId\': 365486}, \'multiverseid\': 365486}, {\'name\': \'Jugement selon Trostani\', \'text\': "Exilez la créature ciblée, puis peuplez. (Mettez sur le champ de bataille un jeton qui est une copie d\'un jeton de créature que vous contrôlez.)", \'type\': \'Éphémère\', \'flavor\': "« À défaut d\'être sauvés tels qu\'ils sont, certains peuvent servir l\'Âme du monde. » —Trostani", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356038&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'04a903e1-6b9e-4e31-9759-0796d21766d3\', \'multiverseId\': 356038}, \'multiverseid\': 356038}, {\'name\': \'Sentenza di Trostani\', \'text\': \'Esilia una creatura bersaglio, poi popola. (Metti sul campo di battaglia una pedina che è una copia di una pedina creatura che controlli.)\', \'type\': \'Istantaneo\', \'flavor\': \'"Alcuni non possono essere salvati nello stato in cui si trovano, ma tutti possono servire l\\\'Anima del Mondo." —Trostani\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356312&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0fd190a9-2e27-4465-a09e-281e79ccef9a\', \'multiverseId\': 356312}, \'multiverseid\': 356312}, {\'name\': \'トロスターニの裁き\', \'text\': \'クリーチャー１体を対象とし、それを追放する。その後居住を行う。（あなたがコントロールするクリーチャー・トークン１体のコピーであるトークンを１体戦場に出す。）\', \'type\': \'インスタント\', \'flavor\': \'「そのままでは救いを与えられない者もいます。しかし世界魂には誰しもが奉仕できるのです。」 ――トロスターニ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356586&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ce057eb7-1665-4798-8231-40b0df32a65b\', \'multiverseId\': 356586}, \'multiverseid\': 356586}, {\'name\': \'트로스타니의 심판\', \'text\': \'생물 한 개를 목표로 정한다. 그 생물을 추방한 후, 소집한다. (당신이 조종하는 어느 생물 토큰의 복사본인 토큰 한 개를 전장에 놓는다.)\', \'type\': \'순간마법\', \'flavor\': \'"현재 상태로는 구원을 받을 수 없는 자도 세계의 영혼을 섬길 수 있다." —트로스타니\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357408&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4c13bc71-19db-425b-bb08-fd72a5103c8d\', \'multiverseId\': 357408}, \'multiverseid\': 357408}, {\'name\': \'Julgamento de Trostani\', \'text\': \'Exile a criatura alvo e depois povoe. (Coloque no campo de batalha uma ficha que seja uma cópia de uma ficha de criatura que você controla.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Alguns não podem ser salvos em seu estado atual, mas todos podem servir à Grande Anima." — Trostani\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356860&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ce35a7ac-570a-4368-8a39-f73f4dd152c6\', \'multiverseId\': 356860}, \'multiverseid\': 356860}, {\'name\': \'Суд Тростани\', \'text\': \'Изгоните целевое существо, затем используйте Заселение. (Положите на поле битвы одну фишку, являющуюся копией фишки существа под вашим контролем.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Не все останутся собой, но все смогут послужить Всесознанию». — Тростани\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355216&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9f1622be-e494-4f07-a439-e855c092c9d9\', \'multiverseId\': 355216}, \'multiverseid\': 355216}, {\'name\': \'卓塔妮的判决\', \'text\': \'放逐目标生物，然后殖民。（将一个衍生物放进战场，此衍生物为由你操控的某衍生生物之复制品。）\', \'type\': \'瞬间\', \'flavor\': \'「有些人已无可救药，但人人都能服侍世界之魂。」 ～卓塔妮\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357134&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6a0225f3-ebb2-452e-9ac7-3fb5d9cc091c\', \'multiverseId\': 357134}, \'multiverseid\': 357134}, {\'name\': \'卓塔妮的判決\', \'text\': \'放逐目標生物，然後殖民。（將一個衍生物放進戰場，此衍生物為由你操控的某衍生生物之複製品。）\', \'type\': \'瞬間\', \'flavor\': \'「有些人已無可救藥，但人人都能服侍世界之魂。」 ～卓塔妮\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355490&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a920b05e-7ca9-42f8-b18f-72e46302a6b3\', \'multiverseId\': 355490}, \'multiverseid\': 355490}]', "[{'name': 'Trotzpflaster', 'type': 'Kreatur — Elementarwesen', 'flavor': 'Die ältesten Straßen entwickeln ein Eigenleben. Ein paar haben beschlossen, in schönere Gegenden umzuziehen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355827&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2d4fe0c0-a0b4-4fce-9dfd-67a6fbdf215f', 'multiverseId': 355827}, 'multiverseid': 355827}, {'name': 'Bruto adoquinado', 'type': 'Criatura — Elemental', 'flavor': 'Las calles más antiguas adquieren vida propia. Algunas han decidido trasladarse a barrios más agradables.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365549&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '6eefec81-7698-4ed1-8340-4546a5c9fd3d', 'multiverseId': 365549}, 'multiverseid': 365549}, {'name': 'Brute de pavés', 'type': 'Créature : élémental', 'flavor': 'Les rues les plus anciennes ont une vie qui leur est propre. Quelques-unes ont décidé de déménager dans des quartiers plus cossus.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356101&type=card', 'language': 'French', 'identifiers': {'scryfallId': '53baa7c9-8375-4670-a933-0bc3929e6f69', 'multiverseId': 356101}, 'multiverseid': 356101}, {'name': 'Bruto di Ciottoli', 'type': 'Creatura — Elementale', 'flavor': 'Le strade più antiche hanno una vita propria. Molti hanno deciso di trasferirsi in quartieri più tranquilli.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356375&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b76146a6-49c9-4b5d-a79a-30355b5f935e', 'multiverseId': 356375}, 'multiverseid': 356375}, {'name': '暴れ玉石', 'type': 'クリーチャー — エレメンタル', 'flavor': 'どこよりも古い街路はそれ自体が生命を持つようになる。よりよい場所へと引っ越そうと決めた者は僅かであった。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356649&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ad9287e2-8838-4183-b91a-f31ed0c27a0a', 'multiverseId': 356649}, 'multiverseid': 356649}, {'name': '벽돌 괴수', 'type': '생물 — 정령', 'flavor': '아주 오래된 거리들은 그 나름의 생명력을 가지며, 그 중 소수는 더 나은 동네로 이사가기로 결심하기도 한다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357471&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'dbeff33f-8ce4-4b9d-83ef-40c6b157095c', 'multiverseId': 357471}, 'multiverseid': 357471}, {'name': 'Brutamontes Pedregoso', 'type': 'Criatura — Elemental', 'flavor': 'As ruas mais antigas têm vida própria. Algumas resolveram se mudar para vizinhanças melhores.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356923&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '476ee9c7-848d-41e4-9cef-202df86f7d2b', 'multiverseId': 356923}, 'multiverseid': 356923}, {'name': 'Булыжный Зверюга', 'type': 'Существо — Элементаль', 'flavor': 'Самые старые улицы уже давно живут своей жизнью. Некоторые из них решили перебраться в более приятные места.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355279&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'd0351117-3c9f-4445-bab5-56d7f2e0ee9c', 'multiverseId': 355279}, 'multiverseid': 355279}, {'name': '鹅卵石蛮汉', 'type': '生物～元素', 'flavor': '最古老的街道开始有了自己的生命。其中一些决定搬到比较好的街坊。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357197&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '7fd16e41-c53b-4ea3-bc6e-6a94e5ca1b98', 'multiverseId': 357197}, 'multiverseid': 357197}, {'name': '鵝卵石蠻漢', 'type': '生物～元素', 'flavor': '最古老的街道開始有了自己的生命。其中一些決定搬到比較好的街坊。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355553&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '68a4a6ba-770b-4523-997e-4670b4966bf6', 'multiverseId': 355553}, 'multiverseid': 355553}]", '[{\'name\': \'Trümmerrücken-Nashorn\', \'text\': \'Fluchsicher (Diese Kreatur kann nicht das Ziel von Zaubersprüchen oder Fähigkeiten sein, die deine Gegner kontrollieren.)\', \'type\': \'Kreatur — Nashorn\', \'flavor\': \'Alles fing damit an, dass ein Gassenjunge mit einem Goblin wettete, er könne eines reiten, bis die Uhr an Shilbos Turm dreizehn schlüge.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355868&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0b6a7f64-0bcb-45e1-a324-00d29e3454cf\', \'multiverseId\': 355868}, \'multiverseid\': 355868}, {\'name\': \'Rinoceronte lomo escombroso\', \'text\': \'Antimaleficio. (Esta criatura no puede ser objetivo de hechizos o habilidades que controlen tus oponentes.)\', \'type\': \'Criatura — Rinoceronte\', \'flavor\': \'Los problemas empezaron cuando un golfillo apostó contra un trasgo a que podía montar uno hasta que el reloj de la torre de Shilbo diera las trece.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365590&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4b4ea7a6-de41-4ba9-9081-317dda70dc7f\', \'multiverseId\': 365590}, \'multiverseid\': 365590}, {\'name\': \'Rhinocéros dosderoc\', \'text\': \'Défense talismanique (Cette créature ne peut pas être la cible de sorts ou de capacités que vos adversaires contrôlent.)\', \'type\': \'Créature : rhinocéros\', \'flavor\': "Les ennuis commencèrent quand un galopin mit un gobelin au défi d\'en chevaucher un jusqu\'à ce que l\'horloge de la tour de Shilbo sonne la treizième heure.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356142&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e9ef8ed6-5136-4c9a-aa78-f86e69cffd73\', \'multiverseId\': 356142}, \'multiverseid\': 356142}, {\'name\': \'Rinoceronte Dorsopietroso\', \'text\': \'Anti-malocchio (Questa creatura non può essere bersaglio di magie o abilità controllate dai tuoi avversari.)\', \'type\': \'Creatura — Rinoceronte\', \'flavor\': "I problemi sono iniziati quando un teppistello ha scommesso con un goblin che sarebbe riuscito a cavalcarne uno fino a quando l\'orologio della Torre di Shilbo non avesse battuto tredici rintocchi.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356416&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'87bc9957-b7e9-441d-998b-077fcbfbab8d\', \'multiverseId\': 356416}, \'multiverseid\': 356416}, {\'name\': \'野面背のサイ\', \'text\': \'呪禁（このクリーチャーは、あなたの対戦相手がコントロールする呪文や能力の対象にならない。）\', \'type\': \'クリーチャー — サイ\', \'flavor\': \'シルボの塔の時計が13時を告げるまでこれに乗り続けられるかどうか、ある浮浪児がゴブリンと賭けをした。それが災難の始まりであった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356690&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4a2f4e33-af95-416b-bc30-7e5e53c8704f\', \'multiverseId\': 356690}, \'multiverseid\': 356690}, {\'name\': \'폐허등 코뿔소\', \'text\': \'방호 (이 생물은 상대가 조종하는 주문이나 능력의 목표로 정해질 수 없다.)\', \'type\': \'생물 — 코뿔소\', \'flavor\': \'어느 부랑자가 한 고블린에게 실보의 탑 시계가 13시를 가리킬 때까지 코뿔소의 등에 올라타있을 수 있다고 장담한 게 문제의 근원이었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357512&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'230d47ee-4e05-499a-ac21-fd4a392962bb\', \'multiverseId\': 357512}, \'multiverseid\': 357512}, {\'name\': \'Rinoceronte Calicodorso\', \'text\': \'Resistência à magia (Esta criatura não pode ser alvo de mágicas nem de habilidades que seus oponentes controlam.)\', \'type\': \'Criatura — Rinoceronte\', \'flavor\': \'O problema começou quando um moleque de rua apostou com um goblin que conseguia montar um até que o relógio da Torre de Shilbo chegasse ao treze.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356964&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e35e97de-cc5b-4113-a83b-9b9b359b4bb1\', \'multiverseId\': 356964}, \'multiverseid\': 356964}, {\'name\': \'Глыбовый Носорог\', \'text\': \'Порчеустойчивость (Это существо не может быть целью заклинаний или способностей под контролем ваших оппонентов.)\', \'type\': \'Существо — Носорог\', \'flavor\': \'Проблемы начались, когда уличный мальчишка поспорил с гоблином, что сможет кататься верхом на этой зверюге, пока стрелки часов на Башне Шильбо не покажут «тринадцать».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355320&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'46052093-7529-492d-8cad-b83127b95bef\', \'multiverseId\': 355320}, \'multiverseid\': 355320}, {\'name\': \'砾脊犀牛\', \'text\': \'辟邪（此生物不能成为由你对手所操控之咒语或异能的目标。）\', \'type\': \'生物～犀牛\', \'flavor\': \'这场麻烦的起因是：某个流浪儿和鬼怪赌咒，如果骑得上它，薛宝之塔的钟就会敲响十三声。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357238&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5ab79f84-fb89-42e9-93bf-6643e7b17b1c\', \'multiverseId\': 357238}, \'multiverseid\': 357238}, {\'name\': \'礫脊犀牛\', \'text\': \'辟邪（此生物不能成為由你對手所操控之咒語或異能的目標。）\', \'type\': \'生物～犀牛\', \'flavor\': \'這場麻煩的起因是：某個流浪兒和鬼怪賭咒，如果騎得上牠，薛寶之塔的鐘就會敲響十三聲。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355594&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'229fe406-c5c1-4314-ada1-874ef44cd6c8\', \'multiverseId\': 355594}, \'multiverseid\': 355594}]', '[{\'name\': \'Turmsceada\', \'text\': \'Fliegend\\n{W}: Der Turmsceada erhält +0/+1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Sceada\', \'flavor\': \'Der erste Antrag, der in der makellos reinen Jelen-Kolonne vorgebracht wurde, betraf strenge Regelungen für den Luftraum rund um Neu-Pravh.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355791&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'660d80c9-25ce-4c7a-95b3-a78499125959\', \'multiverseId\': 355791}, \'multiverseid\': 355791}, {\'name\': \'Draco de la torre\', \'text\': \'Vuela.\\n{W}: El Draco de la torre obtiene +0/+1 hasta el final del turno.\', \'type\': \'Criatura — Draco\', \'flavor\': \'La primera moción que se presentó en la prístina Columna Jelenn proponía severas restricciones en el espacio aéreo de la zona de Nueva Prahv.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365513&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ec248c2e-36d4-449c-bca8-136ff09e4299\', \'multiverseId\': 365513}, \'multiverseid\': 365513}, {\'name\': \'Drakôn des tours\', \'text\': "Vol\\n{W} : Le Drakôn des tours gagne +0/+1 jusqu\'à la fin du tour.", \'type\': \'Créature : drakôn\', \'flavor\': "La première motion adoptée dans la Colonne de Jelenn immaculée imposa des restrictions drastiques dans l\'espace aérien autour du Nouveau Prahv.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356065&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a4bf0048-8a78-4882-81fe-f5763cca106e\', \'multiverseId\': 356065}, \'multiverseid\': 356065}, {\'name\': \'Draghetto della Torre\', \'text\': \'Volare\\n{W}: Il Draghetto della Torre prende +0/+1 fino alla fine del turno.\', \'type\': \'Creatura — Draghetto\', \'flavor\': \'La prima mozione avanzata dalla neonata Colonna Jelenn proponeva severe restrizioni sullo spazio aereo del Nuovo Prahv.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356339&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c21bbbcd-0dbf-47df-9d06-fb011cc218ce\', \'multiverseId\': 356339}, \'multiverseid\': 356339}, {\'name\': \'塔のドレイク\', \'text\': \'飛行\\n{W}：塔のドレイクはターン終了時まで＋０/＋１の修整を受ける。\', \'type\': \'クリーチャー — ドレイク\', \'flavor\': \'ジェーレン隊で初めて提出された動議は、新プラーフ周辺の空域に対する厳しい制限についてのものであった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356613&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ad338e3b-6560-4746-964f-c09c70d34b4c\', \'multiverseId\': 356613}, \'multiverseid\': 356613}, {\'name\': \'탑 드레이크\', \'text\': \'비행\\n{W}: 탑 드레이크는 턴종료까지 +0/+1을 받는다.\', \'type\': \'생물 — 드레이크\', \'flavor\': \'초기 젤렌 입법부에 제출된 첫 번째 발의안은 뉴 프라브 주변 영공의 엄격한 제한에 관한 것이었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357435&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'492c98ea-83e3-4929-baa1-7054546a373b\', \'multiverseId\': 357435}, \'multiverseid\': 357435}, {\'name\': \'Dragonete da Torre\', \'text\': \'Voar\\n{W}: Dragonete da Torre recebe +0/+1 até o final do turno.\', \'type\': \'Criatura — Dragonete\', \'flavor\': \'A primeira moção apresentada pela Coluna de Jelenn foi a favor de severas restrições no espaço aéreo em torno de Nova Prahv.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356887&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d8e8d591-0564-4e70-9489-057db0cf6642\', \'multiverseId\': 356887}, \'multiverseid\': 356887}, {\'name\': \'Башенный Дрейк\', \'text\': \'Полет\\n{W}: Башенный Дрейк получает +0/+1 до конца хода.\', \'type\': \'Существо — Дрейк\', \'flavor\': \'Первым ходатайством в Джеленской колонне стало ужесточение запретов на полеты в окрестностях Нового Права.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355243&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8ed3ca60-06b0-4ce5-a3b0-f13ecf8a6b84\', \'multiverseId\': 355243}, \'multiverseid\': 355243}, {\'name\': \'楼塔龙兽\', \'text\': \'飞行\\n{W}：楼塔龙兽得+0/+1直到回合结束。\', \'type\': \'生物～龙兽\', \'flavor\': \'纯净杰连议会中所提出的第一项动议，就是要严格管制新布拉夫附近的领空。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357161&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'57cee50b-f1aa-4d69-91ef-acd36bc0ec74\', \'multiverseId\': 357161}, \'multiverseid\': 357161}, {\'name\': \'樓塔龍獸\', \'text\': \'飛行\\n{W}：樓塔龍獸得+0/+1直到回合結束。\', \'type\': \'生物～龍獸\', \'flavor\': \'純淨傑連議會中所提出的第一項動議，就是要嚴格管制新布拉夫附近的領空。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355517&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'df0dd2fb-606a-4d1d-9b15-bb73fd05c296\', \'multiverseId\': 355517}, \'multiverseid\': 355517}]', '[{\'name\': \'Türwächter\', \'text\': \'Verteidiger\\n{2}{U}, {T}: Ein Spieler deiner Wahl legt die obersten X Karten seiner Bibliothek auf seinen Friedhof, wobei X gleich der Anzahl der Kreaturen mit Verteidiger ist, die du kontrollierst.\', \'type\': \'Kreatur — Homunkulus\', \'flavor\': \'Meist reicht ein scharfer Blick, um Diebe davon zu überzeugen, sich ein anderes Opfer zu suchen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355773&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'71598356-f83a-4b79-953b-1527fd410ebf\', \'multiverseId\': 355773}, \'multiverseid\': 355773}, {\'name\': \'Portero\', \'text\': \'Defensor.\\n{2}{U}, {T}: El jugador objetivo pone las primeras X cartas de su biblioteca en su cementerio, donde X es el número de criaturas con la habilidad de defensor que controlas.\', \'type\': \'Criatura — Homúnculo\', \'flavor\': \'Una mirada penetrante suele bastar para convencer a los ladrones de que se vayan a otro sitio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365495&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c827d405-42eb-413a-977c-bb80de5e036d\', \'multiverseId\': 365495}, \'multiverseid\': 365495}, {\'name\': \'Portier\', \'text\': \'Défenseur\\n{2}{U}, {T} : Le joueur ciblé met les X cartes du dessus de sa bibliothèque dans son cimetière, X étant le nombre de créatures avec le défenseur que vous contrôlez.\', \'type\': \'Créature : homoncule\', \'flavor\': "Un regard transperçant suffit généralement à convaincre les voleurs d\'aller voir ailleurs.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356047&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'aeba4116-10da-459a-aebb-36654b25a22d\', \'multiverseId\': 356047}, \'multiverseid\': 356047}, {\'name\': \'Guardaporte\', \'text\': \'Difensore\\n{2}{U}, {T}: Un giocatore bersaglio mette nel suo cimitero le prime X carte del suo grimorio, dove X è il numero di creature con difensore che controlli.\', \'type\': \'Creatura — Omuncolo\', \'flavor\': "Un\'occhiata penetrante di solito basta per convincere i ladri ad andarsene altrove.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356321&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'214f4b9f-66d4-4888-b1e6-8a4cdf3a9caf\', \'multiverseId\': 356321}, \'multiverseid\': 356321}, {\'name\': \'門衛\', \'text\': \'防衛\\n{2}{U}, {T}：プレイヤー１人を対象とする。そのプレイヤーは自分のライブラリーの一番上からＸ枚のカードを自分の墓地に置く。Ｘはあなたがコントロールする防衛を持つクリーチャーの総数に等しい。\', \'type\': \'クリーチャー — ホムンクルス\', \'flavor\': \'鋭く一瞥するだけで、盗っ人はたいていよそへ行ってしまう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356595&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'db77d442-31d4-47f5-b1a1-d759bc6cfb31\', \'multiverseId\': 356595}, \'multiverseid\': 356595}, {\'name\': \'문지기\', \'text\': \'수비태세\\n{2}{U}, {T}: 플레이어 한 명을 목표로 정한다. 그 플레이어는 자신의 서고 맨 위의 카드 X장을 자신의 무덤에 넣는다. X는 당신이 조종하는 생물 중 수비태세 능력을 가진 생물의 수다.\', \'type\': \'생물 — 호문쿨루스\', \'flavor\': \'문지기의 꿰뚫는 듯한 시선은 대부분의 도둑들로 하여금 발걸음을 돌리게 한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357417&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'301663e6-f940-40b6-aa68-8b85d1da0227\', \'multiverseId\': 357417}, \'multiverseid\': 357417}, {\'name\': \'Porteiro\', \'text\': \'Defensor\\n{2}{U}, {T}: O jogador alvo coloca os X cards do topo do grimório dele no próprio cemitério, sendo X igual ao número de criaturas com defensor que você controla.\', \'type\': \'Criatura — Homúnculo\', \'flavor\': \'Um olhar penetrante geralmente convence os ladrões a ir para outro lugar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356869&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'15c88335-abc1-4eee-8824-01ea4861f272\', \'multiverseId\': 356869}, \'multiverseid\': 356869}, {\'name\': \'Дверник\', \'text\': \'Защитник\\n{2}{U}, {T}: целевой игрок кладет X верхних карт своей библиотеки на свое кладбище, где X — количество существ со способностью Защитника под вашим контролем.\', \'type\': \'Существо — Гомункул\', \'flavor\': \'Один пронзительный взгляд обычно убеждает грабителей поискать добычу полегче.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355225&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bfd43aba-0e54-4ac1-a43f-ac82dbe2f911\', \'multiverseId\': 355225}, \'multiverseid\': 355225}, {\'name\': \'守门妖\', \'text\': \'守军\\n{2}{U}，{T}：目标牌手将其牌库顶的X张牌置入其坟墓场，X为由你操控、且具守军异能的生物数量。\', \'type\': \'生物～造妖\', \'flavor\': \'狠狠一瞪通常就足以让盗贼知难而退。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357143&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a7592af7-cef9-441d-ab73-9dd27ba7796e\', \'multiverseId\': 357143}, \'multiverseid\': 357143}, {\'name\': \'守門妖\', \'text\': \'守軍\\n{2}{U}，{T}：目標玩家將其牌庫頂的X張牌置入其墳墓場，X為由你操控、且具守軍異能的生物數量。\', \'type\': \'生物～造妖\', \'flavor\': \'狠狠一瞪通常就足以讓盜賊知難而退。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355499&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e0ecd4af-6591-4ebb-98a5-70d7fa837710\', \'multiverseId\': 355499}, \'multiverseid\': 355499}]', '[{\'name\': \'Unterbinden\', \'text\': \'Neutralisiere einen Zauberspruch deiner Wahl, falls sein Beherrscher nicht {X} bezahlt. Wird der Zauberspruch auf diese Weise neutralisiert, schicke ihn ins Exil, anstatt ihn auf den Friedhof seines Besitzers zu legen.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Nur Geduld, Magier. Dich jetzt zu töten wäre zu leicht."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355790&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8a246fde-2a2d-43cc-9667-d67e99e05969\', \'multiverseId\': 355790}, \'multiverseid\': 355790}, {\'name\': \'Sincopar\', \'text\': \'Contrarresta el hechizo objetivo a menos que su controlador pague {X}. Si ese hechizo es contrarrestado de esta manera, exílialo en vez de ponerlo en el cementerio de su propietario.\', \'type\': \'Instantáneo\', \'flavor\': \'"Paciencia, mago. Matarte ahora sería demasiado fácil."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365512&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c542a47c-ec41-4dd4-8065-c34963cedf7d\', \'multiverseId\': 365512}, \'multiverseid\': 365512}, {\'name\': \'Syncope\', \'text\': \'Contrecarrez le sort ciblé à moins que son contrôleur ne paie {X}. Si ce sort est contrecarré de cette manière, exilez-le à la place de le mettre dans le cimetière de son propriétaire.\', \'type\': \'Éphémère\', \'flavor\': \'« Patience, mage. Te tuer tout de suite serait trop facile. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356064&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6a9990fa-db19-44dc-a830-80569031fba2\', \'multiverseId\': 356064}, \'multiverseid\': 356064}, {\'name\': \'Sincopare\', \'text\': \'Neutralizza una magia bersaglio a meno che il suo controllore non paghi {X}. Se quella magia è neutralizzata in questo modo, esiliala invece di metterla nel cimitero del suo proprietario.\', \'type\': \'Istantaneo\', \'flavor\': \'"Pazienta, mago. Ucciderti ora sarebbe troppo facile."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356338&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'31c382d7-e3d9-4b6c-9705-d65ed87eb918\', \'multiverseId\': 356338}, \'multiverseid\': 356338}, {\'name\': \'中略\', \'text\': \'呪文１つを対象とする。それのコントローラーが{X}を支払わないかぎり、それを打ち消す。その呪文がこれにより打ち消された場合、それをオーナーの墓地に置く代わりに追放する。\', \'type\': \'インスタント\', \'flavor\': \'「落ち着きなさい、魔道士さん。今あなたを殺すのは簡単すぎるの。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356612&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9efa53fd-84e3-462c-9233-2b2a4abb094c\', \'multiverseId\': 356612}, \'multiverseid\': 356612}, {\'name\': \'중략\', \'text\': \'주문 한 개를 목표로 정한다. 그 주문의 조종자가 {X}를 지불하지 않으면 그 주문을 무효화한다. 이렇게 그 주문이 무효화되면 그 카드를 소유자의 무덤에 넣는 대신 추방한다.\', \'type\': \'순간마법\', \'flavor\': \'"기다려, 마법사. 지금 당신을 죽이는 건 너무 간단하잖아?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357434&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'675d585b-cbc2-4946-bbc9-08212d73a537\', \'multiverseId\': 357434}, \'multiverseid\': 357434}, {\'name\': \'Sincopar\', \'text\': \'Anule a mágica alvo, a menos que seu controlador pague {X}. Se aquela mágica for anulada dessa maneira, exile-a em vez de colocá-la no cemitério de seu dono.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Paciência, mago. Matar você agora seria fácil demais."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356886&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7f640875-b24a-44ba-b9d7-51b27757eb36\', \'multiverseId\': 356886}, \'multiverseid\': 356886}, {\'name\': \'Синкопа\', \'text\': \'Отмените целевое заклинание, если только контролирующий его игрок не заплатит {X}. Если то заклинание отменяется таким способом, изгоните его вместо того, чтобы положить его на кладбище его владельца.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Терпение, маг. Убить тебя сейчас будет слишком просто».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355242&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5a95a808-806f-4a19-9697-fe1d7729c310\', \'multiverseId\': 355242}, \'multiverseid\': 355242}, {\'name\': \'切分\', \'text\': \'除非目标咒语的操控者支付{X}，否则反击之。如果以此法反击该咒语，则改为将它放逐，而非置入其拥有者的坟墓场。\', \'type\': \'瞬间\', \'flavor\': \'「要有耐心，法师。现在就杀你也太便宜了。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357160&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'44a06994-ce10-4a9a-bd49-c15520c656eb\', \'multiverseId\': 357160}, \'multiverseid\': 357160}, {\'name\': \'切分\', \'text\': \'除非目標咒語的操控者支付{X}，否則反擊之。如果以此法反擊該咒語，則改為將它放逐，而非置入其擁有者的墳墓場。\', \'type\': \'瞬間\', \'flavor\': \'「要有耐心，法師。現在就殺你也太便宜了。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355516&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7cd7e604-64e9-4e2e-a453-9a0244f59410\', \'multiverseId\': 355516}, \'multiverseid\': 355516}]', '[{\'name\': \'Untätigkeitsverfügung\', \'text\': \'Inhaftiere eine Kreatur deiner Wahl, die ein Gegner kontrolliert. (Bis zu deinem nächsten Zug kann diese Kreatur nicht angreifen oder blocken, und ihre aktivierten Fähigkeiten können nicht aktiviert werden.)\\nZiehe eine Karte.\', \'type\': \'Hexerei\', \'flavor\': \'„Handlungen verhindern heißt Übertritte verhindern." —Motto der Azorius-Eintreiber\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355777&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6dfa3e4a-86a9-4833-bfc4-10098f246399\', \'multiverseId\': 355777}, \'multiverseid\': 355777}, {\'name\': \'Mandato de inacción\', \'text\': \'Detén la criatura objetivo que controla un oponente. (Hasta tu próximo turno, esa criatura no puede atacar ni bloquear y sus habilidades activadas no pueden activarse.)\\nRoba una carta.\', \'type\': \'Conjuro\', \'flavor\': \'"Impedir la acción es impedir la transgresión." —Lema de los encarceladores azorios\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365499&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'529e24ee-a486-4ece-9010-d5546af98ae1\', \'multiverseId\': 365499}, \'multiverseid\': 365499}, {\'name\': "Injonction d\'inaction", \'text\': "Détenez une créature ciblée qu\'un adversaire contrôle. (Jusqu\'à votre prochain tour, cette créature ne peut ni attaquer ni bloquer et ses capacités activées ne peuvent pas être activées.)\\nPiochez une carte.", \'type\': \'Rituel\', \'flavor\': "« Empêcher l\'action, c\'est empêcher la transgression. » —Devise des courtiers d\'Azorius", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356051&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b8582d27-663e-4a65-ac56-3f682ebf9c74\', \'multiverseId\': 356051}, \'multiverseid\': 356051}, {\'name\': \'Ingiunzione di Cessata Attività\', \'text\': \'Trattieni una creatura bersaglio controllata da un avversario. (Fino al tuo prossimo turno, quella creatura non può attaccare o bloccare e le sue abilità attivate non possono essere attivate.)\\nPesca una carta.\', \'type\': \'Stregoneria\', \'flavor\': \'"Prevenire l\\\'azione è prevenire la trasgressione." —Motto della polizia Azorius\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356325&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2c3dcc8b-9654-4cf1-b0f8-1092f2140abf\', \'multiverseId\': 356325}, \'multiverseid\': 356325}, {\'name\': \'謹慎命令\', \'text\': \'対戦相手１人がコントロールするクリーチャー１体を対象とし、それを留置する。（あなたの次のターンまで、そのクリーチャーでは攻撃もブロックもできず、それの起動型能力は起動できない。）\\nカードを１枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'「行動を防げば罪も防げる。」 ――アゾリウスの拘引者のモットー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356599&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'14ca81b2-6010-4a0f-a08f-503bab3928f8\', \'multiverseId\': 356599}, \'multiverseid\': 356599}, {\'name\': \'활동 금지령\', \'text\': \'상대가 조종하는 생물 한 개를 목표로 정한다. 그 생물을 억류한다. (당신의 다음 턴이 될 때까지 그 생물은 공격하거나 방어할 수 없으며, 그 생물의 활성화능력은 활성화될 수 없다.)\\n카드 한 장을 뽑는다.\', \'type\': \'집중마법\', \'flavor\': \'"행동을 막는 것은 범죄를 막는 것이다." —아조리우스 체포원의 좌우명\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357421&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'919223c4-e0b0-4b58-aa53-c31fab85bb4c\', \'multiverseId\': 357421}, \'multiverseid\': 357421}, {\'name\': \'Mandado de Inação\', \'text\': \'Detenha a criatura alvo que um oponente controla. (Até seu próximo turno, aquela criatura não pode atacar nem bloquear e as habilidades ativadas dela não podem ser ativadas.)\\nCompre um card.\', \'type\': \'Feitiço\', \'flavor\': \'"Prevenir a ação é prevenir a transgressão." — Lema dos Encarceiradores Azorius\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356873&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5c0c1d8c-5da5-4fc5-ad7f-13df5a8e10e9\', \'multiverseId\': 356873}, \'multiverseid\': 356873}, {\'name\': \'Приказ о Бездействии\', \'text\': \'Задержите целевое существо под контролем оппонента. (До вашего следующего хода то существо не может атаковать или блокировать, и его активируемые способности не могут быть активированы.)\\nВозьмите карту.\', \'type\': \'Волшебство\', \'flavor\': \'«Упредишь действие — предотвратишь преступление». — девиз Задержателя Азориусов\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355229&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c5427a35-ba1d-4337-a93d-ede6759d8c60\', \'multiverseId\': 355229}, \'multiverseid\': 355229}, {\'name\': \'强制静息\', \'text\': \'拘留目标由对手操控的生物。（直到你的下一个回合，该生物不能进行攻击或阻挡，其起动式异能也不能起动。）\\n抓一张牌。\', \'type\': \'法术\', \'flavor\': \'「防止行动就可以防止罪行。」 ～俄佐立逮捕人座右铭\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357147&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bb9c43d7-3885-4e93-a2f6-62218c92e2fb\', \'multiverseId\': 357147}, \'multiverseid\': 357147}, {\'name\': \'強制靜息\', \'text\': \'拘留目標由對手操控的生物。（直到你的下一個回合，該生物不能進行攻擊或阻擋，其起動式異能也不能起動。）\\n抽一張牌。\', \'type\': \'巫術\', \'flavor\': \'「防止行動就可以防止罪行。」 ～俄佐立逮捕人座右銘\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355503&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1de7c662-9b7b-428a-819e-e22c68559470\', \'multiverseId\': 355503}, \'multiverseid\': 355503}]', '[{\'name\': \'Utvara-Höllendrache\', \'text\': \'Fliegend\\nImmer wenn ein Drache angreift, den du kontrollierst, bringe einen 6/6 roten Drache-Kreaturenspielstein mit Flugfähigkeit ins Spiel.\', \'type\': \'Kreatur — Drache\', \'flavor\': \'Die Angst vor Drachen ist so alt und so mächtig wie die Angst vor dem Tod selbst.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355846&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'572abe17-f7e2-45ea-909a-6a99ea100e88\', \'multiverseId\': 355846}, \'multiverseid\': 355846}, {\'name\': \'Engendro de Utvara\', \'text\': \'Vuela.\\nSiempre que un Dragón que controles ataque, pon en el campo de batalla una ficha de criatura Dragón roja 6/6 con la habilidad de volar.\', \'type\': \'Criatura — Dragón\', \'flavor\': \'El temor a los dragones es tan antiguo y poderoso como el miedo a la misma muerte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365568&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c91d1554-8730-4070-93e9-d831ca15b8a9\', \'multiverseId\': 365568}, \'multiverseid\': 365568}, {\'name\': "Escouflenfer d\'Utvara", \'text\': "Vol\\nÀ chaque fois qu\'un dragon que vous contrôlez attaque, mettez sur le champ de bataille un jeton de créature 6/6 rouge Dragon avec le vol.", \'type\': \'Créature : dragon\', \'flavor\': \'La peur des dragons est aussi ancienne et puissante que la peur de la mort.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356120&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'872c157d-97d8-4c65-b236-d91433e09d7a\', \'multiverseId\': 356120}, \'multiverseid\': 356120}, {\'name\': \'Nibbio Infernale di Utvara\', \'text\': \'Volare\\nOgniqualvolta un Drago che controlli attacca, metti sul campo di battaglia una pedina creatura Drago 6/6 rossa con volare.\', \'type\': \'Creatura — Drago\', \'flavor\': \'La paura dei draghi è antica e potente, come la paura della morte stessa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356394&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'148b29e0-5360-4ab8-9080-a480aa69593e\', \'multiverseId\': 356394}, \'multiverseid\': 356394}, {\'name\': \'ウトヴァラのヘルカイト\', \'text\': \'飛行\\nあなたがコントロールするドラゴンが攻撃するたび、飛行を持つ赤の６/６のドラゴン・クリーチャー・トークンを１体戦場に出す。\', \'type\': \'クリーチャー — ドラゴン\', \'flavor\': \'ドラゴンへの畏怖は死への畏怖と同じぐらい強く、古いものである。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356668&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f96bcec1-52d0-4442-806a-a31ba1776110\', \'multiverseId\': 356668}, \'multiverseid\': 356668}, {\'name\': \'우트바라 지옥룡\', \'text\': \'비행\\n당신이 조종하는 용이 공격할 때마다, 비행 능력을 가진 6/6 적색 용 생물 토큰 한 개를 전장에 놓는다.\', \'type\': \'생물 — 용\', \'flavor\': \'용에 대한 공포는 죽음에 대한 공포만큼이나 오래되었고 강력하다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357490&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9cc1dba3-8f75-4639-8dc0-95c5198193fe\', \'multiverseId\': 357490}, \'multiverseid\': 357490}, {\'name\': \'Dragão Avérneo de Utvara\', \'text\': \'Voar\\nToda vez que um Dragão que você controla atacar, coloque no campo de batalha uma ficha de criatura vermelha 6/6 do tipo Dragão com voar.\', \'type\': \'Criatura — Dragão\', \'flavor\': \'O medo de dragões é tão antigo e poderoso quanto o medo da própria morte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356942&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'27fb9142-b8df-4b61-885e-e95b65b76f74\', \'multiverseId\': 356942}, \'multiverseid\': 356942}, {\'name\': \'Утварский Змей\', \'text\': \'Полет\\nКаждый раз, когда Дракон под вашим контролем атакует, положите на поле битвы одну фишку существа 6/6 красный Дракон с Полетом.\', \'type\': \'Существо — Дракон\', \'flavor\': \'Страх перед драконами столь же древен и силен, как и страх перед смертью.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355298&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c882c505-420c-409c-968d-c350a7c02964\', \'multiverseId\': 355298}, \'multiverseid\': 355298}, {\'name\': \'坞瓦拉残虐者\', \'text\': \'飞行\\n每当一个由你操控的龙攻击时，将一个6/6红色，具飞行异能的龙衍生生物放进战场。\', \'type\': \'生物～龙\', \'flavor\': \'畏惧龙和畏惧死亡同样地历史长久、影响深远。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357216&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ba8af810-b246-413c-a868-671beb1cc57e\', \'multiverseId\': 357216}, \'multiverseid\': 357216}, {\'name\': \'塢瓦拉殘虐者\', \'text\': \'飛行\\n每當一個由你操控的龍攻擊時，將一個6/6紅色，具飛行異能的龍衍生生物放進戰場。\', \'type\': \'生物～龍\', \'flavor\': \'畏懼龍和畏懼死亡同樣地歷史長久、影響深遠。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355572&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0bfc4fa4-67c0-489f-a281-cda1e3c41b34\', \'multiverseId\': 355572}, \'multiverseid\': 355572}]', '[{\'name\': \'Vandalenrandale\', \'text\': \'Zerstöre ein Artefakt deiner Wahl, das du nicht kontrollierst.\\nÜberlast {4}{R} (Du kannst diesen Zauber zu seinen Überlast-Kosten wirken. Falls du dies tust, verändere seinen Text, indem du im Text alle Vorkommen von „deiner Wahl" durch „jeder" ersetzt.)\', \'type\': \'Hexerei\', \'flavor\': \'Was schön ist, entscheidet der Sprengmeister.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355847&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f73daedc-3093-4e39-8d96-81580a3a3855\', \'multiverseId\': 355847}, \'multiverseid\': 355847}, {\'name\': \'Ráfaga vandálica\', \'text\': \'Destruye el artefacto objetivo que no controlas.\\nSobrecarga {4}{R}. (Puedes lanzar este hechizo por su coste de sobrecarga. Si lo haces, cambia su texto reemplazando "el artefacto objetivo" por "cada artefacto".)\', \'type\': \'Conjuro\', \'flavor\': \'La belleza está en los ojos del que mina.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365569&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e7dd39b4-fc9a-4bcf-9244-b9387f7354f8\', \'multiverseId\': 365569}, \'multiverseid\': 365569}, {\'name\': \'Salve vandale\', \'text\': \'Détruisez un artefact ciblé que vous ne contrôlez pas.\\nSurcharge {4}{R} (Vous pouvez lancer ce sort pour son coût de surcharge. Si vous faites ainsi, modifiez son texte en remplaçant toutes les occurrences de « ciblé(e) » par « chaque ».)\', \'type\': \'Rituel\', \'flavor\': "La beauté est dans l\'œil du saboteur.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356121&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'af3ab5bf-dc17-4022-9747-69ea69531405\', \'multiverseId\': 356121}, \'multiverseid\': 356121}, {\'name\': \'Esplosione Vandalica\', \'text\': \'Distruggi un artefatto bersaglio che non controlli.\\nSovraccarico {4}{R} (Puoi lanciare questa magia per il suo costo di sovraccarico. Se lo fai, cambiane il testo sostituendo "un artefatto bersaglio" con "ogni artefatto".)\', \'type\': \'Stregoneria\', \'flavor\': "La bellezza è nell\'occhio di chi piazza la bomba.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356395&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2d8ba555-c51b-41b6-b8e5-2e72efc68d89\', \'multiverseId\': 356395}, \'multiverseid\': 356395}, {\'name\': \'汚損破\', \'text\': \'あなたがコントロールしていないアーティファクト１つを対象とし、それを破壊する。\\n超過 {4}{R} （あなたはこの呪文をその超過コストで唱えてもよい。そうした場合、あなたがコントロールしていない各アーティファクトをそれぞれ破壊する。）\', \'type\': \'ソーサリー\', \'flavor\': \'美は爆破者の目に宿る。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356669&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'41e7c0c3-6eac-4857-9406-567dff3cceeb\', \'multiverseId\': 356669}, \'multiverseid\': 356669}, {\'name\': \'파손폭발\', \'text\': \'당신이 조종하지 않는 마법물체 한 개를 목표로 정한다. 그 마법물체를 파괴한다.\\n과부하 {4}{R} (당신은 과부하 비용을 지불하여 이 주문을 발동할 수 있다. 그럴 경우, 이 주문은 "당신이 조종하지 않는 각 마법물체를 파괴한다"로 내용이 변한다.)\', \'type\': \'집중마법\', \'flavor\': \'아름다움이란 폭파하기 나름이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357491&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6883d1f5-f4e3-47e8-a80d-ef908b8c4c14\', \'multiverseId\': 357491}, \'multiverseid\': 357491}, {\'name\': \'Explosão Vandálica\', \'text\': \'Destrua o artefato alvo que você não controla.\\nSobrecarga {4}{R} (Você pode conjurar esta mágica pagando seu custo de sobrecarga. Se fizer isso, altere seu texto substituindo todas as ocorrências de "o artefato alvo" por "cada artefato".)\', \'type\': \'Feitiço\', \'flavor\': \'A beleza está nos olhos de quem detona a explosão.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356943&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b53d1734-3c65-4d75-aa58-4ffff9a5fe0f\', \'multiverseId\': 356943}, \'multiverseid\': 356943}, {\'name\': \'Вандальский Взрыв\', \'text\': \'Уничтожьте целевой артефакт не под вашим контролем.\\nПерегрузка {4}{R} (Вы можете разыграть это заклинание за его стоимость Перегрузки. Если вы это делаете, измените в его тексте все слова «целевой» на «каждый».)\', \'type\': \'Волшебство\', \'flavor\': \'С подрывниками не спорят.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355299&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c84bd89a-c5cd-435e-8c5d-5d7f4c49497a\', \'multiverseId\': 355299}, \'multiverseid\': 355299}, {\'name\': \'蛮野冲击\', \'text\': \'消灭目标不由你操控的神器。\\n超载{4}{R}（你可以支付此咒语的超载费用来施放它。如果你如此作，将其中的「目标」字样全部更改为「每个」。）\', \'type\': \'法术\', \'flavor\': \'爆破者的眼中尽是美景。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357217&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e0ecbab3-1392-4b2f-a670-47e20a10bcf4\', \'multiverseId\': 357217}, \'multiverseid\': 357217}, {\'name\': \'蠻野衝擊\', \'text\': \'消滅目標不由你操控的神器。\\n超載{4}{R}（你可以支付此咒語的超載費用來施放它。如果你如此作，將其中的「目標」字樣全部更改為「每個」。）\', \'type\': \'巫術\', \'flavor\': \'爆破者的眼中盡是美景。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355573&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'aa6e381c-31d0-4bbe-b0f9-fb3d2168b9ae\', \'multiverseId\': 355573}, \'multiverseid\': 355573}]', '[{\'name\': \'Verbindungen zur Unterwelt\', \'text\': \'Landverzauberung\\nDas verzauberte Land hat „{T}, bezahle 1 Lebenspunkt: Ziehe eine Karte."\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Wenn du es suchst, ist es auch zu haben. Die Frage ist, wie viel du zu zahlen bereit bist.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355819&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4cdae67d-5c1c-4381-813b-c8c6395675d0\', \'multiverseId\': 355819}, \'multiverseid\': 355819}, {\'name\': \'Contactos en los bajos fondos\', \'text\': \'Encantar tierra.\\nLa tierra encantada tiene "{T}, pagar 1 vida: Roba una carta".\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'Si lo buscas, está disponible. La pregunta es cuánto estás dispuesto a pagar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365541&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'298e3b15-99e8-4197-b5d6-d3c00dfb4339\', \'multiverseId\': 365541}, \'multiverseid\': 365541}, {\'name\': \'Connexions avec la pègre\', \'text\': \'Enchanter : terrain\\nLe terrain enchanté a « {T}, payez 1 point de vie : Piochez une carte. »\', \'type\': \'Enchantement : aura\', \'flavor\': "Si vous en cherchez, il y en a. La vraie question, c\'est de savoir si vous êtes prêt à y mettre le prix.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356093&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d3614257-137d-4614-a89e-319b07bc0683\', \'multiverseId\': 356093}, \'multiverseid\': 356093}, {\'name\': \'Contatti nel Mondo Sotterraneo\', \'text\': \'Incanta terra\\nLa terra incantata ha "{T}, Paga 1 punto vita: Pesca una carta".\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'Se ne hai bisogno, è disponibile. La domanda è: quanto sei disposto a pagare?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356367&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'84a0a3df-4cc6-4770-a7be-e22c3e6a34ab\', \'multiverseId\': 356367}, \'multiverseid\': 356367}, {\'name\': \'地下世界の人脈\', \'text\': \'エンチャント（土地）\\nエンチャントされている土地は「{T}, ライフを１点支払う：カードを１枚引く。」を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'それを探しているのなら、手には入るだろう。問題はどれだけ支払うつもりがあるかだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356641&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c4a89144-4db9-4e5d-aa62-62f400451b46\', \'multiverseId\': 356641}, \'multiverseid\': 356641}, {\'name\': \'지하 세계와의 연결\', \'text\': \'대지에게 부여\\n부여된 대지는 "{T}, 생명 1점을 지불한다: 카드 한 장을 뽑는다."라는 능력을 가진다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'원하는 건 뭐든지 찾을 수 있다. 문제는 얼마나 지불할 의사가 있느냐이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357463&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8d685712-91ab-4713-bdce-c3c826ee4ccc\', \'multiverseId\': 357463}, \'multiverseid\': 357463}, {\'name\': \'Contatos no Submundo\', \'text\': \'Encantar terreno\\nO terreno encantado tem "{T}, Pague 1 ponto de vida: Compre um card."\', \'type\': \'Encantamento — Aura\', \'flavor\': \'Se você está procurando, está disponível. A questão é quanto você se dispõe a pagar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356915&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4b85bd00-cbc5-410e-8cfb-127e50fe793e\', \'multiverseId\': 356915}, \'multiverseid\': 356915}, {\'name\': \'Связи Подземелья\', \'text\': \'Зачаровать землю\\nЗачарованная земля имеет способность «{T}, заплатите 1 жизнь: возьмите карту».\', \'type\': \'Чары — Аура\', \'flavor\': \'Если вы это ищете, то да, оно есть. Вопрос в том, сколько вы готовы заплатить.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355271&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f158bbb8-62c5-496c-8c6f-50f6ac90f7c1\', \'multiverseId\': 355271}, \'multiverseid\': 355271}, {\'name\': \'地底城系绊\', \'text\': \'结附于地\\n所结附的地具有「{T}，支付1点生命：抓一张牌。」\', \'type\': \'结界～灵气\', \'flavor\': \'只要你要，我就有。问题是，你愿意付出多少代价。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357189&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'33eaf367-25ce-4ed7-b8d8-a676629d1f62\', \'multiverseId\': 357189}, \'multiverseid\': 357189}, {\'name\': \'地底城繫絆\', \'text\': \'結附於地\\n所結附的地具有「{T}，支付1點生命：抽一張牌。」\', \'type\': \'結界～靈氣\', \'flavor\': \'只要你要，我就有。問題是，你願意付出多少代價。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355545&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d15cd515-a02c-4a51-bc91-a2a6d60afcc5\', \'multiverseId\': 355545}, \'multiverseid\': 355545}]', '[{\'name\': \'Vereinigung der Helden\', \'text\': \'Ein Spieler deiner Wahl erhält 7 Lebenspunkte dazu.\', \'type\': \'Spontanzauber\', \'flavor\': \'Verbunden sind sie nicht durch Blut, sondern durch ein Band, das stärker ist als Familienbande. Das sind die Gaben der Weltenseele.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355904&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'201c9fbc-e190-4a64-a353-72f3a45a4341\', \'multiverseId\': 355904}, \'multiverseid\': 355904}, {\'name\': \'Reunión de héroes\', \'text\': \'El jugador objetivo gana 7 vidas.\', \'type\': \'Instantáneo\', \'flavor\': \'No comparten lazos de sangre, pero los une un vínculo mayor que el de la familia. Así son los regalos del Alma del mundo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365626&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7e08e790-42bb-42ee-9d25-137069d1d463\', \'multiverseId\': 365626}, \'multiverseid\': 365626}, {\'name\': \'Réunion des héros\', \'text\': \'Le joueur ciblé gagne 7 points de vie.\', \'type\': \'Éphémère\', \'flavor\': "Ils n\'appartiennent pas à la même lignée, mais sont unis par un lien plus puissant que la famille. Tels sont les dons de l\'Âme du monde.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356178&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f6874a0b-6f40-48b2-9a36-652992c11e29\', \'multiverseId\': 356178}, \'multiverseid\': 356178}, {\'name\': \'Raduno degli Eroi\', \'text\': \'Un giocatore bersaglio guadagna 7 punti vita.\', \'type\': \'Istantaneo\', \'flavor\': "Non sono consanguinei, ma li unisce un legame più forte della famiglia. Tali sono i doni dell\'Anima del Mondo.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356452&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f7baca85-3b41-4940-bd36-9735248448d1\', \'multiverseId\': 356452}, \'multiverseid\': 356452}, {\'name\': \'勇士の再会\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーは７点のライフを得る。\', \'type\': \'インスタント\', \'flavor\': \'血が繋がっているわけではない。だが家族より強い絆で結ばれている。それが世界魂の恵みなのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356726&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e3a6c9e9-041a-4d70-8294-dd322eb1b7cd\', \'multiverseId\': 356726}, \'multiverseid\': 356726}, {\'name\': \'영웅들의 재회\', \'text\': \'플레이어 한 명을 목표로 정한다. 그 플레이어는 생명 7점을 얻는다.\', \'type\': \'순간마법\', \'flavor\': \'그들은 피가 섞이지 않았음에도 불구하고 가족보다 더 강하게 연결되어있다. 세계의 영혼이 존재하기에 가능한 것이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357548&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ee18d3af-b517-4468-b1d7-0c3be6981447\', \'multiverseId\': 357548}, \'multiverseid\': 357548}, {\'name\': \'Reunião de Heróis\', \'text\': \'O jogador alvo ganha 7 pontos de vida.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Eles não têm qualquer parentesco, mas são unidos por um elo mais forte que a família. Tais são as dádivas da Grande Anima.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357000&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'aa41ff48-e9a6-4120-a84f-7c7e74fc54b3\', \'multiverseId\': 357000}, \'multiverseid\': 357000}, {\'name\': \'Встреча Героев\', \'text\': \'Целевой игрок получает 7 жизней.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Они не принадлежат к одному роду, но их связывают узы более крепкие, чем узы семьи. Таковы дары Всесознания.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355356&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b91ff554-e1fe-49ab-8d79-afea01e810f3\', \'multiverseId\': 355356}, \'multiverseid\': 355356}, {\'name\': \'英雄重聚首\', \'text\': \'目标牌手获得7点生命。\', \'type\': \'瞬间\', \'flavor\': \'他们之间没有血缘，但系绊比家人更紧密。这就是世界之魂的献礼。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357274&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1699ef93-0e81-425c-9b3e-89e25ee4dc45\', \'multiverseId\': 357274}, \'multiverseid\': 357274}, {\'name\': \'英雄重聚首\', \'text\': \'目標玩家獲得7點生命。\', \'type\': \'瞬間\', \'flavor\': \'他們之間沒有血緣，但繫絆比家人更緊密。這就是世界之魂的獻禮。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355630&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'70795ce0-022e-406b-a7e3-76c8d846aa06\', \'multiverseId\': 355630}, \'multiverseid\': 355630}]', '[{\'name\': \'Vereinter Segen\', \'text\': \'Kreaturen, die du kontrollierst, erhalten +3/+3.\', \'type\': \'Verzauberung\', \'flavor\': \'Die Senatoren der Azorius heuerten oft Agenten an, um die Selesnija auszuspionieren. Sie wurden angewiesen, jede Spore und jede Wurzel zu melden, die sie sahen, denn jede davon konnte zu einem tödlichen Widersacher werden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355886&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ba90d592-efaf-468d-913f-f46d5b858c5c\', \'multiverseId\': 355886}, \'multiverseid\': 355886}, {\'name\': \'Bendición colectiva\', \'text\': \'Las criaturas que controlas obtienen +3/+3.\', \'type\': \'Encantamiento\', \'flavor\': \'Los senadores azorios a menudo contrataban a agentes para espiar a los selesnya. Se les ordenaba que anotaran cada espora y raíz que encontrasen, ya que cada una podía convertirse en un enemigo letal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365608&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'733def2b-50b6-4389-ae1c-1618adf46d61\', \'multiverseId\': 365608}, \'multiverseid\': 365608}, {\'name\': \'Bénédiction collective\', \'text\': \'Les créatures que vous contrôlez gagnent +3/+3.\', \'type\': \'Enchantement\', \'flavor\': "Les sénateurs d\'Azorius engageaient souvent des agents pour espionner les Selesnya. Ils avaient pour mission de signaler la moindre spore, la plus petite racine, chacune pouvant devenir un ennemi mortel.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356160&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bcdca5b1-36d8-4a26-afc2-3a6251a72d37\', \'multiverseId\': 356160}, \'multiverseid\': 356160}, {\'name\': \'Benedizione Collettiva\', \'text\': \'Le creature che controlli prendono +3/+3.\', \'type\': \'Incantesimo\', \'flavor\': "Per spiare i Selesnya spesso i senatori Azorius assoldavano degli agenti. Questi ultimi ricevevano l\'ordine di osservare bene ogni spora e ogni radice, perché ognuna avrebbe potuto diventare un nemico mortale.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356434&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ff00bb38-94c6-48a8-82d5-cc2bfccbd037\', \'multiverseId\': 356434}, \'multiverseid\': 356434}, {\'name\': \'集団的祝福\', \'text\': \'あなたがコントロールするクリーチャーは＋３/＋３の修整を受ける。\', \'type\': \'エンチャント\', \'flavor\': \'アゾリウスの議員はしばしば工作員を雇ってセレズニアを探っていた。工作員は目にした胞子や根をすべて報告するよう命じられた。どれもが恐ろしい敵になり得るからだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356708&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1ca0fcbe-58f1-4d5d-b27d-165b8bb25e7c\', \'multiverseId\': 356708}, \'multiverseid\': 356708}, {\'name\': \'집단 축복\', \'text\': \'당신이 조종하는 생물들은 +3/+3을 받는다.\', \'type\': \'부여마법\', \'flavor\': \'아조리우스 길드의 상원의원들은 셀레스냐 길드를 염탐하기 위해 종종 첩자를 보낸다. 그들은 포자 하나, 뿌리 하나까지도 모두 치명적인 적이 될 수 있으므로 눈에 띄는 대로 모조리 기록하라는 지시를 받는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357530&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'96eb3a98-8bed-4a0f-8f80-f80b02f7612c\', \'multiverseId\': 357530}, \'multiverseid\': 357530}, {\'name\': \'Bênção Coletiva\', \'text\': \'As criaturas que você controla recebem +3/+3.\', \'type\': \'Encantamento\', \'flavor\': \'Os senadores dos Azorius contratavam com frequência agentes para espionar os Selesnya. Eles eram orientados a registrar todo esporo e raiz que vissem, pois cada um deles poderia se tornar um inimigo mortífero.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356982&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f748ec66-604c-42f6-9528-6eda5a5c1f4b\', \'multiverseId\': 356982}, \'multiverseid\': 356982}, {\'name\': \'Массовое Благословение\', \'text\': \'Существа под вашим контролем получают +3/+3.\', \'type\': \'Чары\', \'flavor\': \'Сенаторы Азориусов часто нанимали агентов для слежения за действиями селезнийцев. Агенты должны были записывать все виды найденных спор и кореньев — все что угодно могло быть смертельно опасным.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355338&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'15dafd72-b685-48a8-9cba-40c609a787f9\', \'multiverseId\': 355338}, \'multiverseid\': 355338}, {\'name\': \'集体祝福\', \'text\': \'由你操控的生物得+3/+3。\', \'type\': \'结界\', \'flavor\': \'俄佐立的参议员往往会雇用密探暗中监视瑟雷尼亚。他们必须报告所见到的一草一木，因为全都可能成为致命的敌人。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357256&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5b81da86-8ec3-4daf-8938-2a7899ac0c85\', \'multiverseId\': 357256}, \'multiverseid\': 357256}, {\'name\': \'集體祝福\', \'text\': \'由你操控的生物得+3/+3。\', \'type\': \'結界\', \'flavor\': \'俄佐立的參議員往往會僱用密探暗中監視瑟雷尼亞。他們必須報告所見到的一草一木，因為全都可能成為致命的敵人。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355612&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d8011e30-33df-4770-a522-22fad90e674b\', \'multiverseId\': 355612}, \'multiverseid\': 355612}]', '[{\'name\': \'Vernichtendes Feuer\', \'text\': \'Vernichtendes Feuer fügt einer Kreatur oder einem Spieler deiner Wahl 3 Schadenspunkte zu. Falls eine Kreatur, der auf diese Weise Schaden zugefügt wurde, in diesem Zug sterben würde, schicke sie stattdessen ins Exil.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Die eindrucksvollsten Auftritte kann man nur einmal hinlegen." —Mote, Rakdos-Heißsporn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355821&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c468406d-eae7-4dc0-95b3-4e45500edbed\', \'multiverseId\': 355821}, \'multiverseid\': 355821}, {\'name\': \'Fuego aniquilador\', \'text\': \'El Fuego aniquilador hace 3 puntos de daño a la criatura o jugador objetivo. Si una criatura que recibió daño de esta manera fuera a morir este turno, en vez de eso, exíliala.\', \'type\': \'Instantáneo\', \'flavor\': \'"Las actuaciones más impresionantes sólo pueden hacerse una vez." —Mote, excéntrico rakdos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365543&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'adf91043-9670-4e58-8c63-dc3acbe94b4b\', \'multiverseId\': 365543}, \'multiverseid\': 365543}, {\'name\': \'Feu annihilateur\', \'text\': \'Le Feu annihilateur inflige 3 blessures à une cible, créature ou joueur. Si une créature ayant subi des blessures de cette manière devait mourir ce tour-ci, exilez-la à la place.\', \'type\': \'Éphémère\', \'flavor\': \'« Les performances les plus impressionnantes sont le plus souvent uniques. » —Mote, hurluberlu rakdos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356095&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'69d6e91f-198d-4ea2-b355-43fbd2832033\', \'multiverseId\': 356095}, \'multiverseid\': 356095}, {\'name\': \'Fuoco Annientatore\', \'text\': \'Il Fuoco Annientatore infligge 3 danni a una creatura o a un giocatore bersaglio. Se una creatura a cui è stato inflitto danno in questo modo sta per morire in questo turno, invece esiliala.\', \'type\': \'Istantaneo\', \'flavor\': \'"Le performance più impressionanti non possono essere ripetute." —Mote, pazzoide Rakdos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356369&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d0d94a2a-db28-4e96-8f85-628814e82df5\', \'multiverseId\': 356369}, \'multiverseid\': 356369}, {\'name\': \'滅殺の火\', \'text\': \'クリーチャー１体かプレイヤー１人を対象とする。滅殺の火はそれに３点のダメージを与える。このターン、これによりダメージを与えられたクリーチャーが死亡する場合、代わりにそれを追放する。\', \'type\': \'インスタント\', \'flavor\': \'「最高の離れ業ってのは一度しかできないもんだ。」 ――ラクドスの鉄砲玉、モート\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356643&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'998ef7b9-ace8-4654-865d-16b093a463a0\', \'multiverseId\': 356643}, \'multiverseid\': 356643}, {\'name\': \'섬멸의 화염\', \'text\': \'생물 한 개 또는 플레이어 한 명을 목표로 정한다. 섬멸의 화염은 그 목표에게 피해 3점을 입힌다. 이렇게 피해를 입은 생물이 이 턴에 죽으려고 하면, 대신에 그 생물을 추방한다.\', \'type\': \'순간마법\', \'flavor\': \'"가장 멋진 공연은 되풀이할 수 없는 법이다." —락도스 광대 모트\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357465&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f5816d48-c9e5-4629-a0e5-86bcca90c074\', \'multiverseId\': 357465}, \'multiverseid\': 357465}, {\'name\': \'Fogo Aniquilador\', \'text\': \'Fogo Aniquilador causa 3 pontos de dano à criatura ou jogador alvo. Se uma criatura que sofreu dano dessa maneira morreria neste turno, em vez disso, exile-a.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"As performances mais impressionantes só podem ser feitas uma vez." — Mote, inconsequente Rakdos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356917&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ab4b8e6b-7e68-400e-9569-f0ebf7c8c5fa\', \'multiverseId\': 356917}, \'multiverseid\': 356917}, {\'name\': \'Всепожирающее Пламя\', \'text\': \'Всепожирающее Пламя наносит 3 повреждения целевому существу или игроку. Если существо, которому таким образом были нанесены повреждения, должно умереть в этом ходу, изгоните его вместо этого.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Самые лучшие представления можно провести только один раз». — Моут, безумец Ракдосов\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355273&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4c43629f-03ed-4c9c-a706-af00a0aeae43\', \'multiverseId\': 355273}, \'multiverseid\': 355273}, {\'name\': \'歼灭之火\', \'text\': \'歼灭之火对目标生物或牌手造成3点伤害。如果本回合中曾以此法受到伤害的生物将死去，则改为将它放逐。\', \'type\': \'瞬间\', \'flavor\': \'「最精彩的表演没有第二次。」 ～拉铎司狂人末特\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357191&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ce78d3fc-52d3-4ede-a61e-e12fa98a051f\', \'multiverseId\': 357191}, \'multiverseid\': 357191}, {\'name\': \'殲滅之火\', \'text\': \'殲滅之火對目標生物或玩家造成3點傷害。如果本回合中曾以此法受到傷害的生物將死去，則改為將它放逐。\', \'type\': \'瞬間\', \'flavor\': \'「最精彩的表演沒有第二次。」 ～拉鐸司狂人末特\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355547&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9ff6c5da-9e83-4883-8c31-b88d91f50d48\', \'multiverseId\': 355547}, \'multiverseid\': 355547}]', '[{\'name\': \'Verrat aus dem Jenseits\', \'text\': \'Immer wenn eine Kreatur stirbt, die du nicht kontrollierst, bringe sie zu Beginn des nächsten Endsegments mit einer zusätzlichen +1/+1-Marke unter deiner Kontrolle ins Spiel zurück. Diese Kreatur ist zusätzlich zu ihren anderen Farben und Typen ein schwarzer Zombie.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355803&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8f5d56da-f6a4-48ca-8271-a02fbadc070b\', \'multiverseId\': 355803}, \'multiverseid\': 355803}, {\'name\': \'Traición sepulcral\', \'text\': \'Siempre que una criatura que no controles muera, regrésala al campo de batalla bajo tu control con un contador +1/+1 adicional al comienzo del próximo paso final. Esa criatura es un Zombie negro además de sus otros colores y tipos.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365525&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7f7c3733-02d6-4d71-8861-ed03b13423d8\', \'multiverseId\': 365525}, \'multiverseid\': 365525}, {\'name\': \'Trahison de la tombe\', \'text\': "À chaque fois qu\'une créature que vous ne contrôlez pas meurt, renvoyez-la sur le champ de bataille sous votre contrôle, avec un marqueur +1/+1 supplémentaire sur elle, au début de la prochaine étape de fin. Cette créature est un zombie noir en plus de ses autres couleurs et de ses autres types.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356077&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b98a8985-ef0c-4505-a375-be6ab96d6de4\', \'multiverseId\': 356077}, \'multiverseid\': 356077}, {\'name\': \'Tradimento del Sepolcro\', \'text\': "Ogniqualvolta una creatura che non controlli muore, rimettila sul campo di battaglia sotto il tuo controllo con un segnalino +1/+1 addizionale all\'inizio della prossima sottofase finale. Quella creatura è uno Zombie nero in aggiunta ai suoi altri tipi e colori.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356351&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'53e388d7-fcb7-4571-8caf-6c4ce6579438\', \'multiverseId\': 356351}, \'multiverseid\': 356351}, {\'name\': \'墓所の裏切り\', \'text\': \'あなたがコントロールしていないクリーチャーが１体死亡するたび、次の終了ステップの開始時に、それを＋１/＋１カウンターが追加で１個置かれた状態であなたのコントロール下で戦場に戻す。そのクリーチャーは、他の色やタイプに加えて黒のゾンビでもある。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356625&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fbb25c57-73d7-41ad-a043-6587c2ae2551\', \'multiverseId\': 356625}, \'multiverseid\': 356625}, {\'name\': \'죽은 자의 배신\', \'text\': \'당신이 조종하지 않는 생물이 죽을 때마다, 다음 종료단 시작에 그 생물을 +1/+1 카운터 한 개를 추가로 가진 채로 당신의 조종 하에 전장으로 되돌린다. 그 생물은 자신의 다른 색과 유형에 더불어 흑색 좀비다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357447&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'03f61157-9dfa-4b07-a964-5550c7293c0e\', \'multiverseId\': 357447}, \'multiverseid\': 357447}, {\'name\': \'Traição Tumular\', \'text\': \'Toda vez que uma criatura que você não controla morrer, devolva-a ao campo de batalha sob seu controle com um marcador +1/+1 adicional no início da próxima etapa final. Aquela criatura é um Zumbi preto além de suas outras cores e tipos.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356899&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'67c45c2e-29bf-472b-873c-e6bae865c032\', \'multiverseId\': 356899}, \'multiverseid\': 356899}, {\'name\': \'Могильное Предательство\', \'text\': \'Каждый раз, когда существо не под вашим контролем умирает, верните его на поле битвы под вашим контролем с дополнительным жетоном +1/+1 на нем в начале следующего заключительного шага. То существо является черным Зомби в дополнение к своим другим цветам и типам.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355255&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3cb372a2-0987-4364-a01a-0b3a3cee7c71\', \'multiverseId\': 355255}, \'multiverseid\': 355255}, {\'name\': \'坟场叛行\', \'text\': \'每当一个不由你操控的生物死去，在下一个结束步骤开始时，将它在你的操控下返回战场，且其上额外有一个+1/+1指示物。该生物额外具有黑色此颜色与「灵俑」此类别。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357173&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fb82da75-268e-406a-8528-ed8ff498d6e1\', \'multiverseId\': 357173}, \'multiverseid\': 357173}, {\'name\': \'墳場叛行\', \'text\': \'每當一個不由你操控的生物死去，在下一個結束步驟開始時，將它在你的操控下返回戰場，且其上額外有一個+1/+1指示物。該生物額外具有黑色此顏色與「殭屍」此類別。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355529&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'37dea210-a3fd-443e-a50c-611b97ca35ab\', \'multiverseId\': 355529}, \'multiverseid\': 355529}]', '[{\'name\': \'Verräterischer Instinkt\', \'text\': \'Übernimm bis zum Ende des Zuges die Kontrolle über eine Kreatur deiner Wahl. Enttappe diese Kreatur. Bis zum Ende des Zuges erhält sie +2/+0 und hat Eile.\', \'type\': \'Hexerei\', \'flavor\': \'Sich der Weltenseele anzuschließen erforderte Jahre des Studiums und der Meditation. Ein einziges Fingerschnippen von Rakdos durchtrennte die Verbindung.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355845&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'691da827-7020-4428-beab-48bac546d4c0\', \'multiverseId\': 355845}, \'multiverseid\': 355845}, {\'name\': \'Instinto traicionero\', \'text\': \'Gana el control de la criatura objetivo hasta el final del turno. Endereza esa criatura. Hasta el final del turno, obtiene +2/+0 y gana la habilidad de prisa.\', \'type\': \'Conjuro\', \'flavor\': \'Unirse al Alma del mundo llevó años de estudio y meditación. Cortar esa conexión sólo requirió un chasquido de los dedos de Rakdos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365567&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2f252f6e-7b88-4ae9-b8aa-7188315ca6ee\', \'multiverseId\': 365567}, \'multiverseid\': 365567}, {\'name\': \'Instinct perfide\', \'text\': "Acquérez le contrôle de la créature ciblée jusqu\'à la fin du tour. Dégagez cette créature. Jusqu\'à la fin du tour, elle gagne +2/+0 et elle acquiert la célérité.", \'type\': \'Rituel\', \'flavor\': "Fusionner avec l\'Âme du monde avait pris des années d\'études et de méditation. Il suffit d\'un claquement de doigts de Rakdos pour rompre ce lien.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356119&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'22d8e220-ca5c-4831-b2b5-d116fcfd8875\', \'multiverseId\': 356119}, \'multiverseid\': 356119}, {\'name\': \'Istinto Traditore\', \'text\': \'Prendi il controllo di una creatura bersaglio fino alla fine del turno. STAPpa quella creatura. Fino alla fine del turno, prende +2/+0 e ha rapidità.\', \'type\': \'Stregoneria\', \'flavor\': "Ci vollero anni di studi e meditazione per unirsi all\'Anima del Mondo. Bastò uno schiocco delle dita di Rakdos per recidere il legame.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356393&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fb4ea365-8096-4647-9c8f-4946ed685077\', \'multiverseId\': 356393}, \'multiverseid\': 356393}, {\'name\': \'裏切りの本能\', \'text\': \'クリーチャー１体を対象とし、ターン終了時までそれのコントロールを得る。そのクリーチャーをアンタップする。ターン終了時まで、それは＋２/＋０の修整を受けるとともに速攻を得る。\', \'type\': \'ソーサリー\', \'flavor\': \'世界魂と一体になるまでには何年にも及ぶ研究と瞑想が必要であった。その繋がりを断ち切るには、ラクドスが指を鳴らすだけでよかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356667&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5856f88e-13c1-4cba-b894-60ca10ab7d5d\', \'multiverseId\': 356667}, \'multiverseid\': 356667}, {\'name\': \'배신의 본능\', \'text\': \'생물 한 개를 목표로 정한다. 턴종료까지 당신이 그 생물의 조종권을 얻는다. 그 생물은 언탭되며 턴종료까지 +2/+0을 받고 신속 능력을 얻는다.\', \'type\': \'집중마법\', \'flavor\': \'세계의 영혼과 하나가 되는 데는 몇 년의 연구와 명상이 필요했지만, 락도스는 손가락 하나 까딱해서 그 연결을 끊어버렸다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357489&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d33ef760-fac3-4c6b-b133-ab4d9717107d\', \'multiverseId\': 357489}, \'multiverseid\': 357489}, {\'name\': \'Instinto Traidor\', \'text\': \'Ganhe o controle da criatura alvo até o final do turno. Desvire aquela criatura. Até o final do turno, ela recebe +2/+0 e ganha ímpeto.\', \'type\': \'Feitiço\', \'flavor\': \'A união à Grande Anima exigiu anos de estudo e meditação. Para romper a conexão, bastou um estalar de dedos dos Rakdos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356941&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b1289d17-672b-47a8-b731-2ee8b4644aa4\', \'multiverseId\': 356941}, \'multiverseid\': 356941}, {\'name\': \'Предательский Инстинкт\', \'text\': \'Получите контроль над целевым существом до конца хода. Разверните то существо. До конца хода оно получает +2/+0 и Ускорение.\', \'type\': \'Волшебство\', \'flavor\': \'Для присоединения к Всесознанию потребовались годы штудий и медитаций. Для разрыва этой связи хватило щелчка пальцев Ракдоса.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355297&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3ec09a9a-077d-4319-9dd1-8563b61a8a82\', \'multiverseId\': 355297}, \'multiverseid\': 355297}, {\'name\': \'背叛本能\', \'text\': \'获得目标生物的操控权直到回合结束。重置该生物。直到回合结束，它得+2/+0且获得敏捷异能。\', \'type\': \'法术\', \'flavor\': \'要加入世界之魂得花费数年的研读与冥想。要切除这段联系，只需拉铎司打一个响指。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357215&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'17a2db21-56e7-4fbb-a71b-a5042cb75e2e\', \'multiverseId\': 357215}, \'multiverseid\': 357215}, {\'name\': \'背叛本能\', \'text\': \'獲得目標生物的操控權直到回合結束。重置該生物。直到回合結束，它得+2/+0且獲得敏捷異能。\', \'type\': \'巫術\', \'flavor\': \'要加入世界之魂得花費數年的研讀與冥想。要切除這段聯繫，只需拉鐸司打一個響指。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355571&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'64e39082-c2fe-448a-8797-dc6d622e65f3\', \'multiverseId\': 355571}, \'multiverseid\': 355571}]', '[{\'name\': \'Vertrauter des Richters\', \'text\': \'Fliegend\\nOpfere den Vertrauten des Richters: Neutralisiere einen Spontanzauber oder eine Hexerei deiner Wahl, falls sein bzw. ihr Beherrscher nicht {1} bezahlt.\', \'type\': \'Kreatur — Vogel\', \'flavor\': \'„Ihm entgeht nichts — und er hat keinen Sinn für Humor." —Barvisa, Gerichtsschreiber\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355954&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b22800b2-39d6-4c43-b403-6ff0cb766cb1\', \'multiverseId\': 355954}, \'multiverseid\': 355954}, {\'name\': \'Familiar del juez\', \'text\': \'Vuela.\\nSacrificar el Familiar del juez: Contrarresta el hechizo de instantáneo o de conjuro objetivo a menos que su controlador pague {1}.\', \'type\': \'Criatura — Ave\', \'flavor\': \'"No se pierde nada y no tiene sentido del humor." —Barvisa, escriba del tribunal\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365676&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c4b82da1-5cf5-4e98-ba38-f399ffebe78e\', \'multiverseId\': 365676}, \'multiverseid\': 365676}, {\'name\': \'Familier du juge\', \'text\': "Vol\\nSacrifiez le Familier du juge : Contrecarrez le sort d\'éphémère ou de rituel ciblé à moins que son contrôleur ne paie {1}.", \'type\': \'Créature : oiseau\', \'flavor\': "« Il a le cœur dur et n\'a pas une once d\'humour. » —Barvisa, scribe de la cour", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356228&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5bcb7cae-93e5-44d4-a388-a5b2499584fd\', \'multiverseId\': 356228}, \'multiverseid\': 356228}, {\'name\': \'Famiglio del Giudice\', \'text\': \'Volare\\nSacrifica il Famiglio del Giudice: Neutralizza una magia istantaneo o stregoneria bersaglio a meno che il suo controllore non paghi {1}.\', \'type\': \'Creatura — Uccello\', \'flavor\': \'"Non gli sfugge nulla e non ha alcun senso dell\\\'umorismo." —Barvisa, scriba di tribunale\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356502&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6d7f863b-23a4-4887-9d5a-de5d9faae039\', \'multiverseId\': 356502}, \'multiverseid\': 356502}, {\'name\': \'審判官の使い魔\', \'text\': \'飛行\\n審判官の使い魔を生け贄に捧げる：インスタント呪文１つかソーサリー呪文１つを対象とする。それのコントローラーが{1}を支払わないかぎり、それを打ち消す。\', \'type\': \'クリーチャー — 鳥\', \'flavor\': \'「あれは狙いを外しませんし、冗談も通じませんよ。」 ――法廷速記官バービサー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356776&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0ebb706e-96d1-45b6-9e54-a7281b16e89e\', \'multiverseId\': 356776}, \'multiverseid\': 356776}, {\'name\': \'재판관의 소환수\', \'text\': \'비행\\n재판관의 소환수를 희생한다: 순간마법 주문 또는 집중마법 주문 한 개를 목표로 정한다. 그 주문의 조종자가 {1}를 지불하지 않으면 그 주문을 무효화한다.\', \'type\': \'생물 — 조류\', \'flavor\': \'"무엇 하나 놓치는 것이 없지만 동시에 유머 감각도 없지." —법정 서기 바르비사\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357598&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'dd646339-29e1-4c52-a1b7-dd1b80001475\', \'multiverseId\': 357598}, \'multiverseid\': 357598}, {\'name\': \'Familiar do Juiz\', \'text\': \'Voar\\nSacrifique Familiar do Juiz: Anule a mágica instantânea ou feitiço alvo a menos que seu controlador pague {1}.\', \'type\': \'Criatura — Ave\', \'flavor\': \'"Ele não deixa nada escapar e não tem qualquer senso de humor." — Barvisa, escriba do tribunal\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357050&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'50787900-af86-4a9f-992a-a9e86712f77d\', \'multiverseId\': 357050}, \'multiverseid\': 357050}, {\'name\': \'Питомец Судьи\', \'text\': \'Полет\\nПожертвуйте Питомца Судьи: отмените целевое мгновенное заклинание или заклинание волшебства, если только контролирующий его игрок не заплатит {1}.\', \'type\': \'Существо — Птица\', \'flavor\': \'«Она замечает абсолютно все, и у нее напрочь отсутствует чувство юмора». — Барвиса, судебный писарь\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355406&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'67aa2f16-3351-4a59-9ad8-e6c6632d4450\', \'multiverseId\': 355406}, \'multiverseid\': 355406}, {\'name\': \'法官佣兽\', \'text\': \'飞行\\n牺牲法官佣兽：除非目标瞬间或法术咒语的操控者支付{1}，否则反击之。\', \'type\': \'生物～鸟\', \'flavor\': \'「他从不错漏你的一举一动，而且毫无幽默感。」 ～法庭抄书吏巴维莎\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357324&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2284c0d3-a246-4c23-938b-55976244b545\', \'multiverseId\': 357324}, \'multiverseid\': 357324}, {\'name\': \'法官傭獸\', \'text\': \'飛行\\n犧牲法官傭獸：除非目標瞬間或巫術咒語的操控者支付{1}，否則反擊之。\', \'type\': \'生物～鳥\', \'flavor\': \'「牠從不錯漏你的一舉一動，而且毫無幽默感。」 ～法庭抄書吏巴維莎\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355680&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'95c60e14-bcb2-4ecb-bf35-5da5bec718c5\', \'multiverseId\': 355680}, \'multiverseid\': 355680}]', '[{\'name\': \'Verwurzelter Verteidiger\', \'text\': \'Führe Bevölkern durch. Kreaturen, die du kontrollierst, sind in diesem Zug unzerstörbar. (Bringe zum Bevölkern einen Spielstein ins Spiel, der eine Kopie eines Kreaturenspielsteins ist, den du kontrollierst. Schaden und Effekte, die „zerstören", zerstören unzerstörbare Kreaturen nicht.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355755&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8c92c875-9c97-4da5-ba68-1a29354bbd75\', \'multiverseId\': 355755}, \'multiverseid\': 355755}, {\'name\': \'Defensas raiznatas\', \'text\': \'Repuebla. Las criaturas que controlas son indestructibles este turno. (Para repoblar, pon en el campo de batalla una ficha que es una copia de una ficha de criatura que controlas. El daño y los efectos que dicen "destruir" no destruyen a las criaturas indestructibles.)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365477&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'205f50d0-2f71-47af-8222-8103333d1e1e\', \'multiverseId\': 365477}, \'multiverseid\': 365477}, {\'name\': \'Défenses nées des racines\', \'text\': "Peuplez. Les créatures que vous contrôlez sont indestructibles ce tour-ci. (Pour peupler, mettez sur le champ de bataille un jeton qui est une copie d\'un jeton de créature que vous contrôlez. Les blessures et les effets qui disent « détruisez » ne détruisent pas les créatures indestructibles.)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356029&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fba444d4-7529-434a-9905-b62958556308\', \'multiverseId\': 356029}, \'multiverseid\': 356029}, {\'name\': \'Difese delle Radici\', \'text\': \'Popola. Le creature che controlli sono indistruttibili in questo turno. (Per popolare, metti sul campo di battaglia una pedina che è una copia di una pedina creatura che controlli. Il danno e gli effetti che dicono "distruggi" non distruggono le creature indistruttibili.)\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356303&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'46b20441-394e-4837-bfa1-fb45dde9e377\', \'multiverseId\': 356303}, \'multiverseid\': 356303}, {\'name\': \'根生まれの防衛\', \'text\': \'居住を行う。このターン、あなたがコントロールするクリーチャーは破壊されない。（居住を行うには、あなたがコントロールするクリーチャー・トークン１体のコピーであるトークンを１体戦場に出す。破壊されないクリーチャーは、ダメージや"破壊する"効果では破壊されない。）\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356577&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ba01d92c-5c4f-41d8-9ae5-74ff455f8519\', \'multiverseId\': 356577}, \'multiverseid\': 356577}, {\'name\': \'뿌리 깊은 방어\', \'text\': \'소집한다. 당신이 조종하는 생물들은 이 턴에 파괴될 수 없다. (소집하려면 당신이 조종하는 어느 생물 토큰의 복사본인 토큰 한 개를 전장에 놓는다. 파괴될 수 없는 생물은 피해나 "파괴"라고 명시된 효과에 의해 파괴되지 않는다.)\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357399&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'820eadc0-75bc-4f82-9ce6-41a7839868ef\', \'multiverseId\': 357399}, \'multiverseid\': 357399}, {\'name\': \'Defensores Radiconatos\', \'text\': \'Povoe. As criaturas que você controla são indestrutíveis neste turno. (Para povoar, coloque no campo de batalha uma ficha que seja uma cópia de uma ficha de criatura que você controle. Os dano e efeitos que dizem "destrua" não destroem criaturas indestrutíveis.)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356851&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'751d30ed-26b9-425d-8977-93e9bf444b05\', \'multiverseId\': 356851}, \'multiverseid\': 356851}, {\'name\': \'Защитная Магия Корней\', \'text\': \'Используйте Заселение. Существа под вашим контролем не могут быть уничтожены в этом ходу. (Для Заселения положите на поле битвы одну фишку, являющуюся копией фишки существа под вашим контролем. Повреждения и эффекты с указанием «уничтожьте» не уничтожают неуничтожаемые существа.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355207&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'de30b700-cf65-4421-a18b-83f77d713f21\', \'multiverseId\': 355207}, \'multiverseid\': 355207}, {\'name\': \'根生卫护\', \'text\': \'殖民。由你操控的生物本回合不会毁坏。（殖民的方法，是将一个衍生物放进战场，此衍生物为由你操控的某衍生生物之复制品。伤害与注明「消灭」的效应无法消灭不会毁坏的生物。）\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357125&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5c00eb94-946c-4d93-b3bf-b17859e670ea\', \'multiverseId\': 357125}, \'multiverseid\': 357125}, {\'name\': \'根生衛護\', \'text\': \'殖民。由你操控的生物本回合不會毀壞。（殖民的方法，是將一個衍生物放進戰場，此衍生物為由你操控的某衍生生物之複製品。傷害與註明「消滅」的效應無法消滅不會毀壞的生物。）\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355481&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'01443de0-46c0-4cce-b3d9-8c0ffe440ef2\', \'multiverseId\': 355481}, \'multiverseid\': 355481}]', '[{\'name\': \'Viashino-Schieber\', \'text\': \'Wenn der Viashino-Schieber ins Spiel kommt, kannst du eine Karte aus der Hand abwerfen. Falls du dies tust, ziehe eine Karte.\', \'type\': \'Kreatur — Viashino, Räuber\', \'flavor\': \'„Du magst es töricht finden, dass ich diese Sachen auf dem Territorium der Orzhov verkaufe. Aber manchmal muss man eben ein wenig lebensmüde sein, um zu überleben."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355848&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'127a6322-fe2c-4fd6-bb4e-8e51e95a93c8\', \'multiverseId\': 355848}, \'multiverseid\': 355848}, {\'name\': \'Chantajista viashino\', \'text\': \'Cuando el Chantajista viashino entre al campo de batalla, puedes descartar una carta. Si lo haces, roba una carta.\', \'type\': \'Criatura — Bribón Viashino\', \'flavor\': \'"Me creerás un necio por vender estas cosas en territorio orzhov. En fin, hay que ser un poco temerario para sobrevivir."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365570&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'31b42fa7-a540-4d36-9d8c-a1ab2f44dba2\', \'multiverseId\': 365570}, \'multiverseid\': 365570}, {\'name\': \'Racketteur viashino\', \'text\': "Quand le Racketteur viashino arrive sur le champ de bataille, vous pouvez vous défausser d\'une carte. Si vous faites ainsi, piochez une carte.", \'type\': \'Créature : viashino et gredin\', \'flavor\': "« Traitez-moi de cinglé, pour oser vendre ça en plein territoire Orzhov. Mais il faut savoir prendre des risques si l\'on veut survivre. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356122&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5c097cf1-ff65-44e9-8de1-2b9fd796b7dc\', \'multiverseId\': 356122}, \'multiverseid\': 356122}, {\'name\': \'Delinquente Viashino\', \'text\': \'Quando il Delinquente Viashino entra nel campo di battaglia, puoi scartare una carta. Se lo fai, pesca una carta.\', \'type\': \'Creatura — Farabutto Viashino\', \'flavor\': \'"Potresti pensare che sia uno stupido, perché vendo questa roba in territorio Orzhov. Ma qualche volta devi essere temerario per sopravvivere."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356396&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'39a6aa51-4291-486f-bdae-706af5ef12b3\', \'multiverseId\': 356396}, \'multiverseid\': 356396}, {\'name\': \'ヴィーアシーノのゆすり屋\', \'text\': \'ヴィーアシーノのゆすり屋が戦場に出たとき、あなたはカードを１枚捨ててもよい。そうした場合、カードを１枚引く。\', \'type\': \'クリーチャー — ヴィーアシーノ・ならず者\', \'flavor\': \'「こいつをオルゾフのシマで売るなんて、馬鹿だと言われるだろうな。でもよ、生き抜くためにはちょっとした無茶も必要なのさ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356670&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a88eefc0-4002-4fc0-9728-be626fea0758\', \'multiverseId\': 356670}, \'multiverseid\': 356670}, {\'name\': \'비아시노 협잡꾼\', \'text\': \'비아시노 협잡꾼이 전장에 들어올 때, 당신은 카드 한 장을 버릴 수 있다. 그렇게 한다면, 카드 한 장을 뽑는다.\', \'type\': \'생물 — 비아시노 도적\', \'flavor\': \'"이런 물건을 오르조브 지역에서 파는 나를 바보 같다고 할지 몰라도, 살아남으려면 약간의 모험이 필요한 법이지."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357492&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'893b60e7-8981-4455-b281-7ad5e9eb0f56\', \'multiverseId\': 357492}, \'multiverseid\': 357492}, {\'name\': \'Extorsionário Viashino\', \'text\': \'Quando Extorsionário Viashino entra no campo de batalha, você pode descartar um card. Se fizer isso, compre um card.\', \'type\': \'Criatura — Viashino Ladino\', \'flavor\': \'"Você pode me chamar de louco por vender essas coisas na área dos Orzhov. Bem... é preciso ser um tanto temerário para sobreviver."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356944&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c27225a8-50ca-411f-bf95-fb621102657b\', \'multiverseId\': 356944}, \'multiverseid\': 356944}, {\'name\': \'Виашино-Грабитель\', \'text\': \'Когда Виашино-Грабитель выходит на поле битвы, вы можете сбросить карту. Если вы это делаете, возьмите карту.\', \'type\': \'Существо — Виашино Бродяга\', \'flavor\': \'«Считаете, что я дурак, раз продаю эти товары на землях Орзовов? Но чтобы выжить, иногда приходится быть безрассудным».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355300&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1a2b22cd-bd2c-4366-8a2f-d3018fa68c31\', \'multiverseId\': 355300}, \'multiverseid\': 355300}, {\'name\': \'诈骗凡尔西诺\', \'text\': \'当诈骗凡尔西诺进战场时，你可以弃一张牌。若你如此作，则抓一张牌。\', \'type\': \'生物～凡尔西诺／浪客\', \'flavor\': \'「在欧佐夫的地盘上卖这种东西也许真的不太明智。但做人总要有点冒险精神。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357218&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4d674456-76c2-4867-a139-4637ef0e59df\', \'multiverseId\': 357218}, \'multiverseid\': 357218}, {\'name\': \'詐騙凡爾西諾\', \'text\': \'當詐騙凡爾西諾進戰場時，你可以棄一張牌。若你如此作，則抽一張牌。\', \'type\': \'生物～凡爾西諾／浪客\', \'flavor\': \'「在歐佐夫的地盤上賣這種東西也許真的不太明智。但做人總要有點冒險精神。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355574&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fce2d426-7397-4c8d-83c9-b0d4ffe406eb\', \'multiverseId\': 355574}, \'multiverseid\': 355574}]', '[{\'name\': \'Vraska die Unbetrachtete\', \'text\': \'+1: Immer wenn bis zu deinem nächsten Zug eine Kreatur Vraska der Unbetrachteten Kampfschaden zufügt, zerstöre diese Kreatur.\\n-3: Zerstöre eine bleibende Karte deiner Wahl, die kein Land ist.\\n-7: Bringe drei 1/1 schwarze Assassinen-Kreaturenspielsteine mit „Immer wenn diese Kreatur einem Spieler Kampfschaden zufügt, verliert dieser Spieler das Spiel" ins Spiel.\', \'type\': \'Planeswalker — Vraska\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355944&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'79a25e72-d249-4b81-9eed-b73f4bcf57e2\', \'multiverseId\': 355944}, \'multiverseid\': 355944}, {\'name\': \'Vraska la invisible\', \'text\': \'+1: Hasta tu próximo turno, siempre que una criatura haga daño de combate a Vraska la invisible, destruye esa criatura.\\n-3: Destruye el permanente objetivo que no sea tierra.\\n-7: Pon en el campo de batalla tres fichas de criatura Asesino negras 1/1 con "Siempre que esta criatura haga daño de combate a un jugador, ese jugador pierde el juego".\', \'type\': \'Planeswalker — Vraska\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365666&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'55372e57-9b27-4d05-9eed-085b643baa24\', \'multiverseId\': 365666}, \'multiverseid\': 365666}, {\'name\': "Vraska l\'Inapparente", \'text\': "+1 : Jusqu\'à votre prochain tour, à chaque fois qu\'une créature inflige des blessures de combat à Vraska l\'Inapparente, détruisez cette créature.\\n-3 : Détruisez le permanent non-terrain ciblé.\\n-7 : Mettez sur le champ de bataille trois jetons de créature 1/1 noire Assassin avec « À chaque fois que cette créature inflige des blessures de combat à un joueur, ce joueur perd la partie. »", \'type\': \'Planeswalker : Vraska\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356218&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'59c961d0-1fa2-4c66-8d88-d45cf5b9adbf\', \'multiverseId\': 356218}, \'multiverseid\': 356218}, {\'name\': "Vraska l\'Invisibile", \'text\': \'+1: Fino al tuo prossimo turno, ogniqualvolta una creatura infligge danno da combattimento a Vraska l\\\'Invisibile, distruggi quella creatura.\\n-3: Distruggi un permanente non terra bersaglio.\\n-7: Metti sul campo di battaglia tre pedine creatura Assassino 1/1 nere con "Ogniqualvolta questa creatura infligge danno da combattimento a un giocatore, quel giocatore perde la partita".\', \'type\': \'Planeswalker — Vraska\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356492&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b1f10967-355d-4856-9045-3ba2f9d729c4\', \'multiverseId\': 356492}, \'multiverseid\': 356492}, {\'name\': \'見えざる者、ヴラスカ\', \'text\': \'＋１：あなたの次のターンまで、クリーチャー１体が見えざる者、ヴラスカに戦闘ダメージを与えるたび、そのクリーチャーを破壊する。\\n－３：土地でないパーマネント１つを対象とし、それを破壊する。\\n－７：「このクリーチャーがプレイヤー１人に戦闘ダメージを与えるたび、そのプレイヤーはこのゲームに敗北する。」を持つ黒の１/１の暗殺者・クリーチャー・トークンを３体戦場に出す。\', \'type\': \'プレインズウォーカー — ヴラスカ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356766&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'16c50a43-36ba-4c84-9634-a1e85fed43df\', \'multiverseId\': 356766}, \'multiverseid\': 356766}, {\'name\': \'보이지 않는 자 브라스카\', \'text\': \'+1: 당신의 다음 턴이 될 때까지, 어느 생물이 보이지 않는 자 브라스카에게 전투피해를 입힐 때마다, 그 생물을 파괴한다.\\n-3: 대지가 아닌 지속물 한 개를 목표로 정한다. 그 지속물을 파괴한다.\\n-7: "이 생물이 플레이어에게 전투피해를 입힐 때마다, 그 플레이어는 게임에서 패배한다."라는 능력을 가진 1/1 흑색 암살자 생물 토큰 세 개를 전장에 놓는다.\', \'type\': \'플레인즈워커 — - 브라스카\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357588&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d0007e19-1286-409a-aeef-49ee4bf79623\', \'multiverseId\': 357588}, \'multiverseid\': 357588}, {\'name\': \'Vraska, a Oculta\', \'text\': \'+1: Até seu próximo turno, toda vez que uma criatura causar dano de combate a Vraska, a Oculta, destrua aquela criatura.\\n-3: Destrua a permanente alvo que não seja um terreno.\\n-7: Coloque no campo de batalha três fichas de criatura preta 1/1 do tipo Assassino com "Toda vez que esta criatura causa dano de combate a um jogador, aquele jogador perde o jogo."\', \'type\': \'Planeswalker — Vraska\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357040&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ac5e167a-4833-4d19-a339-c65a0530a693\', \'multiverseId\': 357040}, \'multiverseid\': 357040}, {\'name\': \'Враска Невидимая\', \'text\': \'+1: до вашего следующего хода каждый раз, когда существо наносит боевые повреждения Враске Невидимой, уничтожьте то существо.\\n-3: уничтожьте целевой не являющийся землей перманент.\\n-7: положите на поле битвы три фишки существа 1/1 черный Убийца со способностью «Каждый раз, когда это существо наносит боевые повреждения игроку, тот игрок проигрывает партию».\', \'type\': \'Planeswalker — Враска\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355396&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5e9f2085-a4d3-4e33-9857-9bf4704f0129\', \'multiverseId\': 355396}, \'multiverseid\': 355396}, {\'name\': \'隐密客瓦丝卡\', \'text\': \'+1：直到你的下一个回合，每当一个生物对隐密客瓦丝卡造成战斗伤害时，消灭该生物。\\n-3：消灭目标非地永久物。\\n-7：将三个1/1黑色的杀手衍生生物放进战场，且它们具有「每当此生物对牌手造成战斗伤害时，该牌手输掉这盘游戏」。\', \'type\': \'鹏洛客～瓦丝卡\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357314&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0dcce3fb-8d0a-48b3-a2c6-c336e48da00a\', \'multiverseId\': 357314}, \'multiverseid\': 357314}, {\'name\': \'隱密客瓦絲卡\', \'text\': \'+1：直到你的下一個回合，每當一個生物對隱密客瓦絲卡造成戰鬥傷害時，消滅該生物。\\n-3：消滅目標非地永久物。\\n-7：將三個1/1黑色的殺手衍生生物放進戰場，且它們具有「每當此生物對玩家造成戰鬥傷害時，該玩家輸掉這盤遊戲」。\', \'type\': \'鵬洛客～瓦絲卡\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355670&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7957cec0-9a24-4e25-bb6c-b32fc6456589\', \'multiverseId\': 355670}, \'multiverseid\': 355670}]', '[{\'name\': \'Wachsende Reihen\', \'text\': \'Führe zu Beginn deines Versorgungssegments Bevölkern durch. (Bringe einen Spielstein ins Spiel, der eine Kopie eines Kreaturenspielsteins ist, den du kontrollierst.)\', \'type\': \'Verzauberung\', \'flavor\': \'„Wir werden eine Armee aufstellen, die groß genug ist, um dem Wahnsinn der Izzet zu widerstehen." —Trostani\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355953&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e37fc80d-4592-41d4-b298-57bf9a3c1971\', \'multiverseId\': 355953}, \'multiverseid\': 355953}, {\'name\': \'Engrosar las filas\', \'text\': \'Al comienzo de tu mantenimiento, repuebla. (Pon en el campo de batalla una ficha que es una copia de una ficha de criatura que controlas.)\', \'type\': \'Encantamiento\', \'flavor\': \'"Formaremos un ejército lo bastante grande como para resistir a la locura Ízzet." —Trostani\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365675&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fa81bf15-430b-4268-8ec3-671cfbdb5dc6\', \'multiverseId\': 365675}, \'multiverseid\': 365675}, {\'name\': \'Rangs en augmentation\', \'text\': "Au début de votre entretien, peuplez. (Mettez sur le champ de bataille un jeton qui est une copie d\'un jeton de créature que vous contrôlez.)", \'type\': \'Enchantement\', \'flavor\': \'« Nous cultiverons une armée assez nombreuse pour contrecarrer la démence des Izzet. » —Trostani\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356227&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'544e8bc7-cb1c-4d79-bc51-c71c3155ba0f\', \'multiverseId\': 356227}, \'multiverseid\': 356227}, {\'name\': \'Ranghi in Crescita\', \'text\': "All\'inizio del tuo mantenimento, popola. (Metti sul campo di battaglia una pedina che è una copia di una pedina creatura che controlli.)", \'type\': \'Incantesimo\', \'flavor\': \'"Raduneremo un esercito abbastanza grande da contrastare la follia degli Izzet." —Trostani\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356501&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7a763287-5bec-45b6-b4f4-dfc9dd555aea\', \'multiverseId\': 356501}, \'multiverseid\': 356501}, {\'name\': \'兵士の育成\', \'text\': \'あなたのアップキープの開始時に、居住を行う。（あなたがコントロールするクリーチャー・トークン１体のコピーであるトークンを１体戦場に出す。）\', \'type\': \'エンチャント\', \'flavor\': \'「イゼットの狂気に抵抗し得る規模の軍隊を育成しましょう。」 ――トロスターニ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356775&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d83f5afd-5481-4997-a805-c20d01199264\', \'multiverseId\': 356775}, \'multiverseid\': 356775}, {\'name\': \'병력 증대\', \'text\': \'당신의 유지단 시작에, 소집한다. (당신이 조종하는 어느 생물 토큰의 복사본인 토큰 한 개를 전장에 놓는다.)\', \'type\': \'부여마법\', \'flavor\': \'"이젯 놈들의 광기에 충분히 맞설 수 있는 규모의 군대를 육성할 것이다." —트로스타니\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357597&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'22206841-49e0-4f13-baee-4240fa5c4c50\', \'multiverseId\': 357597}, \'multiverseid\': 357597}, {\'name\': \'Tropas Crescentes\', \'text\': \'No início de sua manutenção, povoe. (Coloque no campo de batalha uma ficha que seja uma cópia de uma ficha de criatura que você controla.)\', \'type\': \'Encantamento\', \'flavor\': \'"Formaremos um exército grande o suficiente para resistir à loucura dos Izzet." — Trostani\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357049&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'68beba18-4df2-46f0-a9e2-499cc6f362f9\', \'multiverseId\': 357049}, \'multiverseid\': 357049}, {\'name\': \'Растущие Ряды\', \'text\': \'В начале вашего шага поддержки используйте Заселение. (Положите на поле битвы одну фишку, являющуюся копией фишки существа под вашим контролем.)\', \'type\': \'Чары\', \'flavor\': \'«Мы вырастим армию, достаточную для противостояния безумству Иззетов». — Тростани\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355405&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dfe41aea-29cf-4e56-9d3b-a1b563dd104f\', \'multiverseId\': 355405}, \'multiverseid\': 355405}, {\'name\': \'扩编军伍\', \'text\': \'在你的维持开始时，殖民。（将一个衍生物放进战场，此衍生物为由你操控的某衍生生物之复制品。）\', \'type\': \'结界\', \'flavor\': \'「我们集结的军队数量将足以抵抗丧心病狂的伊捷。」 ～卓塔妮\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357323&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8706f2f6-2b63-4ca8-8e34-156e202eb02a\', \'multiverseId\': 357323}, \'multiverseid\': 357323}, {\'name\': \'擴編軍伍\', \'text\': \'在你的維持開始時，殖民。（將一個衍生物放進戰場，此衍生物為由你操控的某衍生生物之複製品。）\', \'type\': \'結界\', \'flavor\': \'「我們集結的軍隊數量將足以抵抗喪心病狂的伊捷。」 ～卓塔妮\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355679&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'41a998c8-d541-4819-a673-6d7e71922148\', \'multiverseId\': 355679}, \'multiverseid\': 355679}]', "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356006&type=card', 'language': 'German', 'identifiers': {'scryfallId': '324045f9-9bb8-4810-b356-0b7e7343ad29', 'multiverseId': 356006}, 'multiverseid': 356006}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365728&type=card', 'language': 'Spanish', 'identifiers': {'scr