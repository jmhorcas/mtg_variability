ndlers/Image.ashx?multiverseid=357378&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'aaa93acd-daaf-4ecd-bfce-b014a7c3e9b3', 'multiverseId': 357378}, 'multiverseid': 357378}, {'name': '樹林', 'type': '基本地～樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355734&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '74190298-8a03-47d0-858f-1693fddd9107', 'multiverseId': 355734}, 'multiverseid': 355734}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356009&type=card', 'language': 'German', 'identifiers': {'scryfallId': '27c80cfa-0f8a-4878-9f9a-9b9943da2598', 'multiverseId': 356009}, 'multiverseid': 356009}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365731&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4cf7bd51-e244-4b56-be8b-c4d34d0ef582', 'multiverseId': 365731}, 'multiverseid': 365731}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356283&type=card', 'language': 'French', 'identifiers': {'scryfallId': '145581d5-4e03-4319-b6fe-4e9cad5bb80f', 'multiverseId': 356283}, 'multiverseid': 356283}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356557&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3634e09f-f39b-4c4d-9c97-4e8a95fcf0a8', 'multiverseId': 356557}, 'multiverseid': 356557}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356831&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9c3feb26-0071-420e-9a04-63c4947df333', 'multiverseId': 356831}, 'multiverseid': 356831}, {'name': '숲', 'type': '기본 대지 — 숲', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357653&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'c3845192-9fc9-4a41-bc54-bb52b4f645e7', 'multiverseId': 357653}, 'multiverseid': 357653}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357105&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '553e82e3-3348-4f9e-804c-9b8a64a6edfa', 'multiverseId': 357105}, 'multiverseid': 357105}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355461&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'c1ac36fe-7586-4cf6-b79e-60434b4a8ff8', 'multiverseId': 355461}, 'multiverseid': 355461}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357379&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a9406d87-bba7-4ccc-b1b4-8ce02532a00b', 'multiverseId': 357379}, 'multiverseid': 357379}, {'name': '樹林', 'type': '基本地～樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355735&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '7f3e3982-8b25-4349-9896-b98f6da4c46b', 'multiverseId': 355735}, 'multiverseid': 355735}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356010&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c85dac0d-d3d7-4ab3-9e8d-bbd16f897fda', 'multiverseId': 356010}, 'multiverseid': 356010}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365732&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '3c6b7f1f-25ee-4f48-8ff1-3108c49442ad', 'multiverseId': 365732}, 'multiverseid': 365732}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356284&type=card', 'language': 'French', 'identifiers': {'scryfallId': '673cffca-6e9d-42e2-9a40-7a6b8b0da954', 'multiverseId': 356284}, 'multiverseid': 356284}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356558&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '06c762f2-3caf-46a5-84b1-5301c9ec49d9', 'multiverseId': 356558}, 'multiverseid': 356558}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356832&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '0159bb75-0120-4b81-8826-d6d1c52afb62', 'multiverseId': 356832}, 'multiverseid': 356832}, {'name': '숲', 'type': '기본 대지 — 숲', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357654&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'd169e8cd-35a2-421a-aadb-03dc22812457', 'multiverseId': 357654}, 'multiverseid': 357654}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357106&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7f370786-6c24-4340-bc21-dce99480e5fc', 'multiverseId': 357106}, 'multiverseid': 357106}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355462&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '133dd153-8a3b-4985-b5b5-04b1699421ad', 'multiverseId': 355462}, 'multiverseid': 355462}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357380&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '5aaf1fb2-37e6-4889-ae67-20f82149047a', 'multiverseId': 357380}, 'multiverseid': 357380}, {'name': '樹林', 'type': '基本地～樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355736&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '9a4e2211-1a46-4056-a690-04c62310439f', 'multiverseId': 355736}, 'multiverseid': 355736}]", '[{\'name\': \'Wandernder Tempel\', \'text\': \'Stärke und Widerstandskraft des Wandernden Tempels sind gleich der Anzahl der Kreaturen, die du kontrollierst.\\nImmer wenn der Wandernde Tempel einem Spieler Kampfschaden zufügt, führe Bevölkern durch. (Bringe einen Spielstein ins Spiel, der eine Kopie eines Kreaturenspielsteins ist, den du kontrollierst.)\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355945&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'811cd0e7-5feb-4732-91cc-5ac9dd7cf797\', \'multiverseId\': 355945}, \'multiverseid\': 355945}, {\'name\': \'Templo caminante\', \'text\': \'Tanto la fuerza como la resistencia del Templo caminante son iguales al número de criaturas que controlas.\\nSiempre que el Templo caminante haga daño de combate a un jugador, repuebla. (Pon en el campo de batalla una ficha que es una copia de una ficha de criatura que controlas.)\', \'type\': \'Criatura — Elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365667&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f53834c9-4848-4a00-a6eb-29ebe803b948\', \'multiverseId\': 365667}, \'multiverseid\': 365667}, {\'name\': \'Temple des voyageurs\', \'text\': "La force et l\'endurance du Temple des voyageurs sont chacune égales au nombre de créatures que vous contrôlez.\\nÀ chaque fois que le Temple des voyageurs inflige des blessures de combat à un joueur, peuplez. (Mettez sur le champ de bataille un jeton qui est une copie d\'un jeton de créature que vous contrôlez.)", \'type\': \'Créature : élémental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356219&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bc0f5786-4f56-4a4c-8c05-1d64166b2a41\', \'multiverseId\': 356219}, \'multiverseid\': 356219}, {\'name\': \'Tempio Viaggiatore\', \'text\': \'La forza e la costituzione del Tempio Viaggiatore sono pari al numero di creature che controlli.\\nOgniqualvolta il Tempio Viaggiatore infligge danno da combattimento a un giocatore, popola. (Metti sul campo di battaglia una pedina che è una copia di una pedina creatura che controlli.)\', \'type\': \'Creatura — Elementale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356493&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0680dabd-319e-4253-aaa4-79be426f369c\', \'multiverseId\': 356493}, \'multiverseid\': 356493}, {\'name\': \'旅する寺院\', \'text\': \'旅する寺院のパワーとタフネスは、それぞれあなたがコントロールするクリーチャーの総数に等しい。\\n旅する寺院がプレイヤー１人に戦闘ダメージを与えるたび、居住を行う。（あなたがコントロールするクリーチャー・トークン１体のコピーであるトークンを１体戦場に出す。）\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356767&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7039d302-9736-4c78-bb7a-1d6943a51f00\', \'multiverseId\': 356767}, \'multiverseid\': 356767}, {\'name\': \'방랑하는 신전\', \'text\': \'방랑하는 신전의 공격력과 방어력은 각각 당신이 조종하는 생물의 수와 같다.\\n방랑하는 신전이 플레이어에게 전투피해를 입힐 때마다, 소집한다. (당신이 조종하는 어느 생물 토큰의 복사본인 토큰 한 개를 전장에 놓는다.)\', \'type\': \'생물 — 정령\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357589&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f89e5295-e1d1-404e-9cf9-58658278109e\', \'multiverseId\': 357589}, \'multiverseid\': 357589}, {\'name\': \'Templo Viajante\', \'text\': \'O poder e a resistência de Templo Viajante são ambos iguais ao número de criaturas que você controla.\\nToda vez que Templo Viajante causar dano de combate a um jogador, povoe. (Coloque no campo de batalha uma ficha que seja uma cópia de uma ficha de criatura que você controla.)\', \'type\': \'Criatura — Elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357041&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'483f7b32-3eb3-486b-943d-cc5baf55b248\', \'multiverseId\': 357041}, \'multiverseid\': 357041}, {\'name\': \'Странствующий Храм\', \'text\': \'Сила и выносливость Странствующего Храма равны количеству существ под вашим контролем.\\nКаждый раз, когда Странствующий Храм наносит боевые повреждения игроку, используйте Заселение. (Положите на поле битвы одну фишку, являющуюся копией фишки существа под вашим контролем.)\', \'type\': \'Существо — Элементаль\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355397&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b5132eca-e45b-4856-aa0c-451f4f49d4e2\', \'multiverseId\': 355397}, \'multiverseid\': 355397}, {\'name\': \'行路殿堂\', \'text\': \'行路殿堂的力量及防御力各等同于由你操控的生物之数量。\\n每当行路殿堂对牌手造成战斗伤害时，殖民。（将一个衍生物放进战场，此衍生物为由你操控的某衍生生物之复制品。）\', \'type\': \'生物～元素\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357315&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'50dc461a-8217-419f-89c9-883c365bd62a\', \'multiverseId\': 357315}, \'multiverseid\': 357315}, {\'name\': \'行路殿堂\', \'text\': \'行路殿堂的力量及防禦力各等同於由你操控的生物之數量。\\n每當行路殿堂對玩家造成戰鬥傷害時，殖民。（將一個衍生物放進戰場，此衍生物為由你操控的某衍生生物之複製品。）\', \'type\': \'生物～元素\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355671&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4a243818-2381-458b-b3da-cd972b2f8501\', \'multiverseId\': 355671}, \'multiverseid\': 355671}]', "[{'name': 'Weg zwischen den Gilden', 'text': 'Der Weg zwischen den Gilden kommt getappt ins Spiel.\\nWenn der Weg zwischen den Gilden ins Spiel kommt, opfere ihn, falls du nicht {1} bezahlst.\\n{T}: Erhöhe deinen Manavorrat um ein Mana einer beliebigen Farbe.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355985&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'df36e838-eb7e-4cad-85c5-62496e075710', 'multiverseId': 355985}, 'multiverseid': 355985}, {'name': 'Paseo transgremial', 'text': 'El Paseo transgremial entra al campo de batalla girado.\\nCuando el Paseo transgremial entre al campo de batalla, sacrifícalo a menos que pagues {1}.\\n{T}: Agrega un maná de cualquier color a tu reserva de maná.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365707&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '7c491578-0fbc-4bfc-ae19-81735536b78c', 'multiverseId': 365707}, 'multiverseid': 365707}, {'name': 'Promenade transguilde', 'text': 'La Promenade transguilde arrive sur le champ de bataille engagée.\\nQuand la Promenade transguilde arrive sur le champ de bataille, sacrifiez-la à moins que vous ne payiez {1}.\\n{T} : Ajoutez un mana de la couleur de votre choix à votre réserve.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356259&type=card', 'language': 'French', 'identifiers': {'scryfallId': '5bfa8bb1-07e2-4c05-a0a6-9946eb22b44c', 'multiverseId': 356259}, 'multiverseid': 356259}, {'name': 'Passeggiata Transgilda', 'text': 'La Passeggiata Transgilda entra nel campo di battaglia TAPpata.\\nQuando la Passeggiata Transgilda entra nel campo di battaglia, sacrificala a meno che tu non paghi {1}.\\n{T}: Aggiungi un mana di un qualsiasi colore alla tua riserva di mana.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356533&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'fbcd1593-355b-43fb-aa8a-472a5ef85055', 'multiverseId': 356533}, 'multiverseid': 356533}, {'name': 'ギルド渡りの遊歩道', 'text': 'ギルド渡りの行列はタップ状態で戦場に出る。\\nギルド渡りの行列が戦場に出たとき、あなたが{1}を支払わないかぎり、これを生け贄に捧げる。\\n{T}：あなたのマナ・プールに、好きな色１色のマナ１点を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356807&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '8978b9b8-143b-4f8d-8b4b-1d4974e09512', 'multiverseId': 356807}, 'multiverseid': 356807}, {'name': '공동소유 산책로', 'text': '공동소유 산책로는 탭된 채로 전장에 들어온다.\\n공동소유 산책로가 전장에 들어올 때, 당신이 {1}를 지불하지 않으면 그것을 희생한다.\\n{T}: 당신의 마나풀에 원하는 색의 마나 한 개를 담는다.', 'type': '대지', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357629&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '4af78a18-f510-4e9e-b9bf-57fd7c433093', 'multiverseId': 357629}, 'multiverseid': 357629}, {'name': 'Passeio Transguildas', 'text': 'Passeio Transguildas entra no campo de batalha virado.\\nQuando Passeio Transguildas entrar no campo de batalha, sacrifique-o a menos que você pague {1}.\\n{T}: Adicione um mana de qualquer cor à sua reserva de mana.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357081&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd24a273b-e27b-4c94-a255-f19073b96c84', 'multiverseId': 357081}, 'multiverseid': 357081}, {'name': 'Дорога Между Гильдиями', 'text': 'Дорога Между Гильдиями выходит на поле битвы повернутой.\\nКогда Дорога Между Гильдиями выходит на поле битвы, пожертвуйте ее, если только вы не заплатите {1}.\\n{T}: добавьте одну ману любого цвета в ваше хранилище маны.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355437&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '14b40c84-9c05-4d63-9025-332b1b73a522', 'multiverseId': 355437}, 'multiverseid': 355437}, {'name': '跨公会步道', 'text': '跨公会步道须横置进战场。\\n当跨公会步道进战场时，除非你支付{1}，否则牺牲之。\\n{T}：加一点任意颜色的法术力到你的法术力池中。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357355&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a820fdd3-4ed3-4ea2-80a5-cd5a2067f7c4', 'multiverseId': 357355}, 'multiverseid': 357355}, {'name': '跨公會步道', 'text': '跨公會步道須橫置進戰場。\\n當跨公會步道進戰場時，除非你支付{1}，否則犧牲之。\\n{T}：加一點任意顏色的魔法力到你的魔法力池中。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355711&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '5ca62cbe-a312-4d66-bc3b-f8e8584d55f1', 'multiverseId': 355711}, 'multiverseid': 355711}]", '[{\'name\': \'Weitsicht des Feuerhirns\', \'text\': \'Durchsuche deine Bibliothek nach einer Spontanzauberkarte mit umgewandelten Manakosten von 3, zeige sie offen vor und nimm sie auf deine Hand. Dann wiederhole diesen Vorgang für Spontanzauberkarten mit umgewandelten Manakosten von 2 und 1. Mische danach deine Bibliothek.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355898&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'baa58456-19da-4c68-8fba-afecfc6cdecb\', \'multiverseId\': 355898}, \'multiverseid\': 355898}, {\'name\': \'Previsión de la Mente Ardiente\', \'text\': \'Busca en tu biblioteca una carta de instantáneo con un coste de maná convertido de 3, muéstrala y ponla en tu mano. Luego repite este proceso para cartas de instantáneo con coste de maná convertido de 2 y de 1. Luego baraja tu biblioteca.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365620&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bd1395e0-c4ff-420f-b964-fa9f3b4c4112\', \'multiverseId\': 365620}, \'multiverseid\': 365620}, {\'name\': \'Prévision du Cérébropyre\', \'text\': "Cherchez dans votre bibliothèque une carte d\'éphémère ayant un coût converti de mana de 3, révélez-la et mettez-la dans votre main. Puis répétez ce processus pour les cartes d\'éphémère ayant des coûts convertis de mana de 2 et 1. Mélangez ensuite votre bibliothèque.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356172&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ca4f0403-f138-4cd3-96ea-510f40e5d78a\', \'multiverseId\': 356172}, \'multiverseid\': 356172}, {\'name\': \'Lungimiranza del Mentefiamma\', \'text\': \'Passa in rassegna il tuo grimorio per una carta istantaneo con costo di mana convertito pari a 3, rivelala e aggiungila alla tua mano. Poi ripeti questo procedimento per carte istantaneo con costo di mana convertito pari a 2 e 1. Poi rimescola il tuo grimorio.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356446&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d1741f66-578b-4939-92cb-bd78251a99b8\', \'multiverseId\': 356446}, \'multiverseid\': 356446}, {\'name\': \'火想者の予見\', \'text\': \'あなたのライブラリーから、点数で見たマナ・コストが３のインスタント・カード１枚を探し、それを公開してあなたの手札に加える。その後、点数で見たマナ・コストが２のインスタント・カードと１のインスタント・カードについても同様にする。その後あなたのライブラリーを切り直す。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356720&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eef15311-0176-47b9-9a14-2ac9941edbe3\', \'multiverseId\': 356720}, \'multiverseid\': 356720}, {\'name\': \'불꽃천재의 예지력\', \'text\': \'당신의 서고에서 전환마나비용이 3인 순간마법 카드 한 장을 찾아 공개하고 당신의 손으로 가져간다. 그러고 나서 전환마나비용이 2 및 1인 순간마법 카드에 대해 이 과정을 반복한다. 그러고 나서 당신의 서고를 섞는다.\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357542&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'69714a86-5599-40cf-a68f-80ca86a3f391\', \'multiverseId\': 357542}, \'multiverseid\': 357542}, {\'name\': \'Previsão do Mente de Fogo\', \'text\': \'Procure em seu grimório um card de mágica instantânea com custo de mana convertido igual a 3, revele-o e coloque-o em sua mão. Depois, repita o processo para cards de mágica instantânea com custos de mana convertido iguais a 2 e 1. Depois, embaralhe seu grimório.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356994&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7c8a52db-983c-4f38-b68b-ea54b3e34cc6\', \'multiverseId\': 356994}, \'multiverseid\': 356994}, {\'name\': \'Прозорливость Огненного Разума\', \'text\': \'Найдите в вашей библиотеке карту мгновенного заклинания с конвертированной мана-стоимостью 3, покажите ее и положите в вашу руку. Затем повторите этот процесс для карт мгновенных заклинаний с конвертированными мана-стоимостями 2 и 1. Затем перетасуйте вашу библиотеку.\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355350&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8dd3985b-b932-4456-8575-9d15f872313d\', \'multiverseId\': 355350}, \'multiverseid\': 355350}, {\'name\': \'炎灵远虑\', \'text\': \'从你的牌库中搜寻一张总法术力费用为3的瞬间牌，展示该牌，并将它置入你手上。然后对总法术力费用为2和1的瞬间牌重复此流程。然后将你的牌库洗牌。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357268&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'67095f39-3a45-498d-bc85-d278e0cd1e06\', \'multiverseId\': 357268}, \'multiverseid\': 357268}, {\'name\': \'炎靈遠慮\', \'text\': \'從你的牌庫中搜尋一張總魔法力費用為3的瞬間牌，展示該牌，並將它置入你手上。然後對總魔法力費用為2和1的瞬間牌重複此流程。然後將你的牌庫洗牌。\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355624&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0d9efc24-9405-41bb-ac77-20a37f9307ac\', \'multiverseId\': 355624}, \'multiverseid\': 355624}]', '[{\'name\': \'Weltenwirbelwurm\', \'text\': \'Verursacht Trampelschaden\\nWenn der Weltenwirbelwurm stirbt, bringe drei 5/5 grüne Wurm-Kreaturenspielsteine ins Spiel, die Trampelschaden verursachen.\\nWenn der Weltenwirbelwurm von egal woher auf einen Friedhof gelegt würde, mische ihn in die Bibliothek seines Besitzers.\', \'type\': \'Kreatur — Wurm\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355876&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8fd4b798-d468-4a54-9aee-091fdfe2fd86\', \'multiverseId\': 355876}, \'multiverseid\': 355876}, {\'name\': \'Sierpe lomo del mundo\', \'text\': \'Arrolla.\\nCuando la Sierpe lomo del mundo muera, pon en el campo de batalla tres fichas de criatura Sierpe verdes 5/5 con la habilidad de arrollar.\\nCuando la Sierpe lomo del mundo vaya a un cementerio desde cualquier parte, barájala en la biblioteca de su propietario.\', \'type\': \'Criatura — Sierpe\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365598&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'76127c70-0747-4d16-b719-118d2d538121\', \'multiverseId\': 365598}, \'multiverseid\': 365598}, {\'name\': \'Guivre mondéchine\', \'text\': "Piétinement\\nQuand la Guivre mondéchine meurt, mettez sur le champ de bataille trois jetons de créature 5/5 verte Guivre avec le piétinement.\\nQuand la Guivre mondéchine est mise dans un cimetière d\'où qu\'elle vienne, mélangez-la dans la bibliothèque de son propriétaire.", \'type\': \'Créature : guivre\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356150&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3e37aca6-890d-4cc0-8dc4-a8a697a00776\', \'multiverseId\': 356150}, \'multiverseid\': 356150}, {\'name\': \'Wurm Spina del Mondo\', \'text\': \'Travolgere\\nQuando il Wurm Spina del Mondo muore, metti sul campo di battaglia tre pedine creatura Wurm 5/5 verdi con travolgere.\\nQuando il Wurm Spina del Mondo viene messo in un cimitero da qualsiasi zona, rimescolalo nel grimorio del suo proprietario.\', \'type\': \'Creatura — Wurm\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356424&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d2285e2b-9879-4abe-910c-4687bde1fe8f\', \'multiverseId\': 356424}, \'multiverseid\': 356424}, {\'name\': \'世界棘のワーム\', \'text\': \'トランプル\\n世界棘のワームが死亡したとき、トランプルを持つ緑の５/５のワーム・クリーチャー・トークンを３体戦場に出す。\\n世界棘のワームがいずれかの領域からいずれかの墓地に置かれたとき、これをオーナーのライブラリーに加えて切り直す。\', \'type\': \'クリーチャー — ワーム\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356698&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'292eebe9-2fb9-4a82-bda1-97a782a1e8c9\', \'multiverseId\': 356698}, \'multiverseid\': 356698}, {\'name\': \'세계척추 웜\', \'text\': \'돌진\\n세계척추 웜이 죽을 때, 돌진 능력을 가진 5/5 녹색 웜 생물 토큰 세 개를 전장에 놓는다.\\n세계척추 웜이 어디로부터든 무덤에 들어갈 때, 그 카드를 소유자의 서고에 섞어 넣는다.\', \'type\': \'생물 — 웜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357520&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a3c1db4e-75de-4d08-bf2d-5a081dbe4ca3\', \'multiverseId\': 357520}, \'multiverseid\': 357520}, {\'name\': \'Vorme Espinha do Mundo\', \'text\': \'Atropelar\\nQuando Vorme Espinha do Mundo morrer, coloque no campo de batalha três fichas de criatura verdes 5/5 do tipo Vorme com atropelar.\\nQuando Vorme Espinha do Mundo for colocado num cemitério vindo de qualquer lugar, embaralhe-o no grimório de seu dono.\', \'type\': \'Criatura — Vorme\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356972&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2a257ace-06e4-460c-aad3-1e057f17d9bf\', \'multiverseId\': 356972}, \'multiverseid\': 356972}, {\'name\': \'Вурм, Хребет Мира\', \'text\': \'Пробивной удар\\nКогда Вурм, Хребет Мира умирает, положите на поле битвы три фишки существа 5/5 зеленый Вурм с Пробивным ударом.\\nКогда Вурм, Хребет Мира попадает откуда-либо на кладбище, втасуйте его в библиотеку его владельца.\', \'type\': \'Существо — Вурм\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355328&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'554e06d5-0485-436c-9346-fddd9e223793\', \'multiverseId\': 355328}, \'multiverseid\': 355328}, {\'name\': \'世脊亚龙\', \'text\': \'践踏\\n当世脊亚龙死去时，将三个5/5绿色，具践踏异能的亚龙衍生生物放进战场。\\n当世脊亚龙从任何地方置入坟墓场时，将它洗入其拥有者的牌库。\', \'type\': \'生物～亚龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357246&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8b99fd0d-1d0e-4b86-a763-a8a6c180a616\', \'multiverseId\': 357246}, \'multiverseid\': 357246}, {\'name\': \'世脊亞龍\', \'text\': \'踐踏\\n當世脊亞龍死去時，將三個5/5綠色，具踐踏異能的亞龍衍生生物放進戰場。\\n當世脊亞龍從任何地方置入墳墓場時，將它洗入其擁有者的牌庫。\', \'type\': \'生物～亞龍\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355602&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'61416332-ac30-4081-8aa0-e601c9ee6c58\', \'multiverseId\': 355602}, \'multiverseid\': 355602}]', '[{\'name\': \'Wilde Bändigerin\', \'text\': \'Immer wenn die Wilde Bändigerin angreift, erhält jede andere Kreatur, die du kontrollierst, +X/+X bis zum Ende des Zuges, wobei X gleich der Stärke der Wilden Bändigerin ist.\', \'type\': \'Kreatur — Mensch, Schamane\', \'flavor\': \'„Indem sie die ganze Welt mit der Stadt überbauten, nahmen sie sich selbst jegliche Fluchtmöglichkeit."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355875&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a37fb4cd-5d5c-4a8f-8c4f-f23dc151635f\', \'multiverseId\': 355875}, \'multiverseid\': 355875}, {\'name\': \'Domadora salvaje\', \'text\': \'Siempre que la Domadora salvaje ataque, cada otra criatura que controlas obtiene +X/+X hasta el final del turno, donde X es la fuerza de la Domadora salvaje.\', \'type\': \'Criatura — Chamán humano\', \'flavor\': \'"Cuando cubrieron el mundo con la ciudad, lo único que hicieron fue negarse un lugar adonde huir."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365597&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ad8be293-c972-44da-9b93-c96fad033c82\', \'multiverseId\': 365597}, \'multiverseid\': 365597}, {\'name\': \'Sauvage maîtresse des bêtes\', \'text\': "À chaque fois que la Sauvage maîtresse des bêtes attaque, chaque autre créature que vous contrôlez gagne +X/+X jusqu\'à la fin du tour, X étant la force de la Sauvage maîtresse des bêtes.", \'type\': \'Créature : humain et shamane\', \'flavor\': "« En tapissant le monde entier de tissu urbain, ils ne s\'étaient laissés nulle part où fuir. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356149&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e9f4da5e-0cd1-409d-8390-296f97a9affc\', \'multiverseId\': 356149}, \'multiverseid\': 356149}, {\'name\': \'Domatrice Selvaggia\', \'text\': \'Ogniqualvolta la Domatrice Selvaggia attacca, ogni altra creatura che controlli prende +X/+X fino alla fine del turno, dove X è la forza della Domatrice Selvaggia.\', \'type\': \'Creatura — Sciamano Umano\', \'flavor\': \'"Quando hanno ricoperto il mondo di città, si sono tolti ogni via di fuga."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356423&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'99131f1e-8180-46e9-825a-e2213a9bce6e\', \'multiverseId\': 356423}, \'multiverseid\': 356423}, {\'name\': \'野生の獣使い\', \'text\': \'野生の獣使いが攻撃するたび、あなたがコントロールしている他の各クリーチャーはターン終了時までそれぞれ＋Ｘ/＋Ｘの修整を受ける。Ｘは野生の獣使いのパワーに等しい。\', \'type\': \'クリーチャー — 人間・シャーマン\', \'flavor\': \'「彼らは都市で世界を覆ったが、結局自分たちの逃げ場所をなくしただけであった。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356697&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'97d0e72f-7b8b-49a9-a252-f442ac5b3f17\', \'multiverseId\': 356697}, \'multiverseid\': 356697}, {\'name\': \'야성의 야수조련사\', \'text\': \'야성의 야수조련사가 공격할 때마다, 당신이 조종하는 다른 생물들은 각자 턴종료까지 +X/+X를 받는다. X는 야성의 야수조련사의 공격력이다.\', \'type\': \'생물 — 인간 주술사\', \'flavor\': \'"놈들이 온 세상을 도시로 만들었으니 이제 그들이 숨을 곳도 없군."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357519&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c74c84a5-a9da-4ba2-97de-fc3588517063\', \'multiverseId\': 357519}, \'multiverseid\': 357519}, {\'name\': \'Mestra de Feras Selvagem\', \'text\': \'Quando Mestra de Feras Selvagem ataca, cada outra criatura que você controla recebe +X/+X até o final do turno, sendo X igual ao poder de Mestra de Feras Selvagem.\', \'type\': \'Criatura — Humano Xamã\', \'flavor\': \'"Quando eles cobriram o mundo com sua cidade, tudo que fizeram foi não deixar que tivessem para onde correr."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356971&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dd34ec41-8b53-4bf5-aa1e-7cca34d72c5c\', \'multiverseId\': 356971}, \'multiverseid\': 356971}, {\'name\': \'Дикая Повелительница Зверей\', \'text\': \'Каждый раз, когда Дикая Повелительница Зверей атакует, каждое другое существо под вашим контролем получает +X/+X до конца хода, где Х — сила Дикой Повелительницы Зверей.\', \'type\': \'Существо — Человек Шаман\', \'flavor\': \'«Когда они застроили весь мир городом, им стало попросту некуда бежать».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355327&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'de49fa12-23bb-4ce0-ad38-2c3d7035b7db\', \'multiverseId\': 355327}, \'multiverseid\': 355327}, {\'name\': \'狂野驯兽师\', \'text\': \'每当狂野驯兽师攻击时，由你操控的每个其他生物得+X/+X直到回合结束，X为狂野驯兽师的力量。\', \'type\': \'生物～人类／祭师\', \'flavor\': \'「他们用城市覆盖世界，却让自己少了逃跑的空间。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357245&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d01a2489-9ea3-412e-a78e-594f186dff3b\', \'multiverseId\': 357245}, \'multiverseid\': 357245}, {\'name\': \'狂野馴獸師\', \'text\': \'每當狂野馴獸師攻擊時，由你操控的每個其他生物得+X/+X直到回合結束，X為狂野馴獸師的力量。\', \'type\': \'生物～人類／祭師\', \'flavor\': \'「他們用城市覆蓋世界，卻讓自己少了逃跑的空間。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355601&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'82bdfbdc-0776-4011-b47f-ae67355923c4\', \'multiverseId\': 355601}, \'multiverseid\': 355601}]', '[{\'name\': \'Wildheit der Rennbahn\', \'text\': \'Landverzauberung\\nDas verzauberte Land hat „{T}: Eine Kreatur deiner Wahl erhält Eile bis zum Ende des Zuges."\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Kopf-an-Kopf-Rennen werden von dem gewonnen, der zuerst absteigen und sich eine Waffe schnappen kann.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355840&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'82f40ed8-52df-44ed-84e1-df98e083aba3\', \'multiverseId\': 355840}, \'multiverseid\': 355840}, {\'name\': \'Furia del circuito\', \'text\': \'Encantar tierra.\\nLa tierra encantada tiene "{T}: La criatura objetivo gana la habilidad de prisa hasta el final del turno".\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'Los empates los resuelve el que desmonta y llega a las armas primero.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365562&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'98db2974-7ef3-4497-a937-b8e39844b2b1\', \'multiverseId\': 365562}, \'multiverseid\': 365562}, {\'name\': \'Furie de la course\', \'text\': "Enchanter : terrain\\nLe terrain enchanté a « {T} : La créature ciblée acquiert la célérité jusqu\'à la fin du tour. »", \'type\': \'Enchantement : aura\', \'flavor\': \'Un résultat de course incertain est départagé par celui qui met pied à terre et dégaine le premier.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356114&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'09eda7e1-34eb-4c85-8825-53af5d683161\', \'multiverseId\': 356114}, \'multiverseid\': 356114}, {\'name\': \'Furia della Pista\', \'text\': \'Incanta terra\\nLa terra incantata ha "{T}: Una creatura bersaglio ha rapidità fino alla fine del turno".\', \'type\': \'Incantesimo — Aura\', \'flavor\': "In caso di disputa, vince chi smonta e raggiunge l\'arma per primo.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356388&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'83b208dd-29a2-42fe-b3a0-40d170868e90\', \'multiverseId\': 356388}, \'multiverseid\': 356388}, {\'name\': \'競走路の憤怒\', \'text\': \'エンチャント（土地）\\nエンチャントされている土地は「{T}：クリーチャー１体を対象とする。それはターン終了時まで速攻を得る。」を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'僅差でゴールした場合は、どちらが早く鞍から降りて武器を手にできるかで決着がつく。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356662&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e6901727-3bcc-4e5b-a9b3-15122fb4df2e\', \'multiverseId\': 356662}, \'multiverseid\': 356662}, {\'name\': \'경주장의 분노\', \'text\': \'대지에게 부여\\n부여된 대지는 "{T}: 생물 한 개를 목표로 정한다. 그 생물은 턴종료까지 신속 능력을 얻는다."라는 능력을 가진다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'거의 동시에 결승점에 도착했을 경우, 누가 먼저 내려 무기를 손에 넣느냐가 승패를 좌우한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357484&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'679200ff-33dd-4f15-aaa2-ffaf2eb8ed5a\', \'multiverseId\': 357484}, \'multiverseid\': 357484}, {\'name\': \'Fúria das Pistas\', \'text\': \'Encantar terreno\\nO terreno encantado tem "{T}: A criatura alvo ganha ímpeto até o final do turno."\', \'type\': \'Encantamento — Aura\', \'flavor\': \'Os resultados apertados são resolvidos por quem consegue desmontar e chegar às armas primeiro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356936&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ee2269e1-36b4-4f25-b466-8c9c49f18139\', \'multiverseId\': 356936}, \'multiverseid\': 356936}, {\'name\': \'Яростные Гонки\', \'text\': \'Зачаровать землю\\nЗачарованная земля имеет способность «{T}: целевое существо получает Ускорение до конца хода».\', \'type\': \'Чары — Аура\', \'flavor\': \'Спорные вопросы на финише решаются теми, кто первым успеет достать оружие.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355292&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'559d6416-3ded-4a8e-8983-df94a46a29c4\', \'multiverseId\': 355292}, \'multiverseid\': 355292}, {\'name\': \'赛道之怒\', \'text\': \'结附于地\\n所结附的地具有「{T}：目标生物获得敏捷异能直到回合结束。」\', \'type\': \'结界～灵气\', \'flavor\': \'如果胜负难分，就由先跳下座骑取得武器者获胜。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357210&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'706578cf-e141-418f-9ba7-0a4f1ba2e3b0\', \'multiverseId\': 357210}, \'multiverseid\': 357210}, {\'name\': \'賽道之怒\', \'text\': \'結附於地\\n所結附的地具有「{T}：目標生物獲得敏捷異能直到回合結束。」\', \'type\': \'結界～靈氣\', \'flavor\': \'如果勝負難分，就由先跳下座騎取得武器者獲勝。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355566&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a26f50b7-b900-4a39-ac2d-ab34d5d6b466\', \'multiverseId\': 355566}, \'multiverseid\': 355566}]', '[{\'name\': \'Wirtin aus der Eichenstraße\', \'text\': \'So lange es nicht dein Zug ist, sind getappte Kreaturen, die du kontrollierst, fluchsicher.\', \'type\': \'Kreatur — Elf\', \'flavor\': \'Die Stadt ist weitläufig und voller Gefahren, doch es gibt gastfreundliche Orte, an denen sich müde Reisende wie zu Hause fühlen können.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355867&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1a5b7b7d-8d59-48ab-a0d0-142580134a00\', \'multiverseId\': 355867}, \'multiverseid\': 355867}, {\'name\': \'Tabernera de la Calle Roble\', \'text\': \'Mientras no sea tu turno, las criaturas giradas que controlas tienen la habilidad de antimaleficio.\', \'type\': \'Criatura — Elfo\', \'flavor\': \'La ciudad es vasta y peligrosa, pero hay lugares en los que un viajero agotado puede sentirse casi como en casa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365589&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7783e4c7-4a0c-4dbe-8f23-83565bdb87f7\', \'multiverseId\': 365589}, \'multiverseid\': 365589}, {\'name\': \'Tavernière de la rue du chêne\', \'text\': "Tant que ce n\'est pas votre tour, les créatures engagées que vous contrôlez ont la défense talismanique.", \'type\': \'Créature : elfe\', \'flavor\': "La cité est vaste et dangereuse, mais il est des endroits où le voyageur fatigué peut s\'y sentir comme chez lui.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356141&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d5a90028-104f-4cc0-9c78-e4ac3e33d440\', \'multiverseId\': 356141}, \'multiverseid\': 356141}, {\'name\': \'Locandiera di Strada delle Querce\', \'text\': \'Fintanto che non è il tuo turno, le creature TAPpate che controlli hanno anti-malocchio.\', \'type\': \'Creatura — Elfo\', \'flavor\': \'La città è vasta e pericolosa, ma ci sono posti in cui un viaggiatore stanco può sentirsi a casa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356415&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'83133c90-f86d-4ee8-9161-4ddf0a020f5e\', \'multiverseId\': 356415}, \'multiverseid\': 356415}, {\'name\': \'樫の木通りの亭主\', \'text\': \'あなたのターンでないかぎり、あなたがコントロールするタップ状態のクリーチャーは呪禁を持つ。\', \'type\': \'クリーチャー — エルフ\', \'flavor\': \'この都市は広大で危険に満ちているが、疲れ果てた旅人がゆったりくつろげる場所もあるにはある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356689&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'da426e10-58a4-4980-bb10-c6a4e3ff96e7\', \'multiverseId\': 356689}, \'multiverseid\': 356689}, {\'name\': \'떡갈나무 거리 여관주인\', \'text\': \'당신의 턴이 아닌 한, 당신이 조종하는 탭된 생물들은 방호 능력을 가진다.\', \'type\': \'생물 — 엘프\', \'flavor\': \'크고 위험한 이 도시에도 지친 여행자가 고향에 온 것처럼 편히 쉴 수 있는 장소가 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357511&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'869f8381-b41f-449c-bb95-09de1c42827c\', \'multiverseId\': 357511}, \'multiverseid\': 357511}, {\'name\': \'Albergueiro da Rua do Carvalho\', \'text\': \'Contanto que não seja o seu turno, as criaturas viradas que você controla têm resistência à magia.\', \'type\': \'Criatura — Elfo\', \'flavor\': \'A cidade é vasta e perigosa, mas há lugares em que um viajante cansado pode se sentir em casa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356963&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'aa64b56e-4378-4ce4-bcb6-fca3d593d9ca\', \'multiverseId\': 356963}, \'multiverseid\': 356963}, {\'name\': \'Трактирщица с Дубовой Улицы\', \'text\': \'Пока длится не ваш ход, повернутые существа под вашим контролем имеют Порчеустойчивость.\', \'type\': \'Существо — Эльф\', \'flavor\': \'Этот город огромен и полон опасностей. Но даже здесь есть места, где путник может почувствовать себя как дома.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355319&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c13f7143-75ea-48e3-86c3-1674507f2e45\', \'multiverseId\': 355319}, \'multiverseid\': 355319}, {\'name\': \'橡树街旅店主\', \'text\': \'只要不是在你的回合中，由你操控且已横置的生物便具有辟邪异能。\', \'type\': \'生物～妖精\', \'flavor\': \'整座城辽阔而又危险，但城中有几处能让疲惫的旅人很有家的感觉。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357237&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5c0ef6ae-2c57-4786-9cec-b9f3e855b610\', \'multiverseId\': 357237}, \'multiverseid\': 357237}, {\'name\': \'橡樹街旅店主\', \'text\': \'只要不是在你的回合中，由你操控且已橫置的生物便具有辟邪異能。\', \'type\': \'生物～妖精\', \'flavor\': \'整座城遼闊而又危險，但城中有幾處能讓疲憊的旅人很有家的感覺。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355593&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bbc3481f-8009-4ff0-8a2d-f7f7178c0025\', \'multiverseId\': 355593}, \'multiverseid\': 355593}]', '[{\'name\': \'Wächter des Arsenals\', \'text\': \'Der Wächter des Arsenals hat Wachsamkeit, solange du ein Tor kontrollierst.\', \'type\': \'Kreatur — Riese, Soldat\', \'flavor\': \'Die Dimir-Agenten sahen aus den Schatten heraus zu. „Acht Stunden, und ich habe ihn noch nicht blinzeln gesehen", zischte Nefara. „Ich schlage vor, wir suchen uns einen anderen Weg hinein."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355738&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b37a407a-654c-4005-a726-1e71909d5cd0\', \'multiverseId\': 355738}, \'multiverseid\': 355738}, {\'name\': \'Guardia de la armería\', \'text\': \'El Guardia de la armería tiene la habilidad de vigilancia mientras controles un Portal.\', \'type\': \'Criatura — Soldado gigante\', \'flavor\': \'Los agentes dimir observaban desde las sombras. "En ocho horas no ha parpadeado una sola vez", susurró Nefara. "Sugiero que busquemos otra forma de entrar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365460&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4898779c-ca70-49da-bf49-5058d247000d\', \'multiverseId\': 365460}, \'multiverseid\': 365460}, {\'name\': "Garde de l\'armurerie", \'text\': "Le Garde de l\'armurerie a la vigilance tant que vous contrôlez une porte.", \'type\': \'Créature : géant et soldat\', \'flavor\': "Les agents dimirs observaient depuis les ombres. « En huit heures, je ne l\'ai pas vu broncher une seule fois », siffla Nefara. « Je suggère que nous trouvions un autre moyen d\'entrer. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356012&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bfc4d11b-b4fc-449d-885a-f1ac1708dd13\', \'multiverseId\': 356012}, \'multiverseid\': 356012}, {\'name\': "Guardia dell\'Armeria", \'text\': "La Guardia dell\'Armeria ha cautela fintanto che controlli un Cancello.", \'type\': \'Creatura — Soldato Gigante\', \'flavor\': \'Nascosti nelle ombre, gli agenti Dimir osservavano. "Otto ore e non ha mosso una palpebra," sibilò Nefara. "Dovremo trovare un\\\'altra via per entrare."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356286&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'167b93d7-2ce0-4d7b-bbdd-ea1c5e688ad7\', \'multiverseId\': 356286}, \'multiverseid\': 356286}, {\'name\': \'武器庫の護衛\', \'text\': \'武器庫の護衛は、あなたが門をコントロールしているかぎり警戒を持つ。\', \'type\': \'クリーチャー — 巨人・兵士\', \'flavor\': \'ディミーアの工作員は物陰から様子を窺っていた。「８時間も経つのに、まばたきすらしない」とネファーラが囁いた。「別の入り口を探したほうがよさそうね。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356560&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c6aee4a5-7c10-435e-b007-e92ac05445a2\', \'multiverseId\': 356560}, \'multiverseid\': 356560}, {\'name\': \'무기고 경비\', \'text\': \'당신이 관문을 조종하는 한, 무기고 경비는 경계 능력을 가진다.\', \'type\': \'생물 — 거인 병사\', \'flavor\': \'디미르 길드의 하수인들이 그림자 속에서 상황을 지켜봤다. 네파라가 "여덟 시간 동안 녀석은 눈도 한 번 깜빡하지 않았다. 다른 방법을 찾아봐야겠어."라고 내뱉었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357382&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ebd60b45-a179-4991-8fd9-1026ce3776cb\', \'multiverseId\': 357382}, \'multiverseid\': 357382}, {\'name\': \'Guarda do Arsenal\', \'text\': \'Guarda do Arsenal terá vigilância enquanto você controlar um terreno do tipo Portão.\', \'type\': \'Criatura — Gigante Soldado\', \'flavor\': \'Os agentes Dimir observavam das sombras. "Oito horas e eu ainda não o vi piscar", sussurrou Nefara. Sugiro encontrarmos outra forma de entrar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356834&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5767e0a1-fbba-4a92-b9b4-b6eca9dc64bc\', \'multiverseId\': 356834}, \'multiverseid\': 356834}, {\'name\': \'Страж Оружейного Склада\', \'text\': \'Страж Оружейного Склада имеет Бдительность, пока вы контролируете Врата.\', \'type\': \'Существо — Гигант Солдат\', \'flavor\': \'Агенты Димиров следят из темноты. «За восемь часов я ни разу не видела, чтобы он моргнул», — прошипела Нефара. «Я предлагаю искать другой вход».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355190&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f5e5b232-36d8-4a19-98a7-d388ea8346d3\', \'multiverseId\': 355190}, \'multiverseid\': 355190}, {\'name\': \'军械库守卫\', \'text\': \'只要你操控门，军械库守卫便具有警戒异能。\', \'type\': \'生物～巨人／士兵\', \'flavor\': \'底密尔密探在阴影中监视着。「八小时了，我还没看到他眨眼。」涅法拉低声咒骂。「我们还是另寻入口吧。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357108&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a9b117d6-9f71-40a6-b135-d987fa51aae8\', \'multiverseId\': 357108}, \'multiverseid\': 357108}, {\'name\': \'軍械庫守衛\', \'text\': \'只要你操控門，軍械庫守衛便具有警戒異能。\', \'type\': \'生物～巨人／士兵\', \'flavor\': \'底密爾密探在陰影中監視著。「八小時了，我還沒看到他眨眼。」涅法拉低聲咒罵。「我們還是另尋入口吧。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355464&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1d593b43-583d-4d99-9af1-9f85acec4068\', \'multiverseId\': 355464}, \'multiverseid\': 355464}]', '[{\'name\': \'Wächter des Beilbrecherwalds\', \'text\': \'Verteidiger\\n{T}: Erhöhe deinen Manavorrat um X Mana in einer beliebigen Kombination von Farben, wobei X gleich der Anzahl an Kreaturen mit Verteidiger ist, die du kontrollierst.\', \'type\': \'Kreatur — Mensch, Druide\', \'flavor\': \'Nur wenige Würdige erhalten Einlass in den denkenden Forst, der als Beilbrecherwald bekannt ist.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355851&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'57590ce4-8814-4180-abfd-6a1e8eacc7a4\', \'multiverseId\': 355851}, \'multiverseid\': 355851}, {\'name\': \'Guardián de Rompehachas\', \'text\': \'Defensor.\\n{T}: Agrega X manás de cualquier combinación de color a tu reserva de maná, donde X es el número de criaturas con la habilidad de defensor que controlas.\', \'type\': \'Criatura — Druida humano\', \'flavor\': \'Sólo a unos pocos elegidos se les permite adentrarse en el bosque viviente conocido como Rompehachas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365573&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3edfd29e-07e2-4ffc-aa27-6e552272cbf9\', \'multiverseId\': 365573}, \'multiverseid\': 365573}, {\'name\': \'Vigile de Fléaudhache\', \'text\': \'Défenseur\\n{T} : Ajoutez X manas de la combinaison de mana coloré de votre choix à votre réserve, X étant le nombre de créatures avec le défenseur que vous contrôlez.\', \'type\': \'Créature : humain et druide\', \'flavor\': "Seuls quelques rares élus ont accès à la forêt pensante qu\'on appelle Fléaudhache.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356125&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2c58602c-f4ab-4b08-8b5f-0a37b9a81a70\', \'multiverseId\': 356125}, \'multiverseid\': 356125}, {\'name\': \'Guardiano di Rovina-Asce\', \'text\': \'Difensore\\n{T}: Aggiungi X mana in qualsiasi combinazione di colori alla tua riserva di mana, dove X è il numero di creature con difensore che controlli.\', \'type\': \'Creatura — Druido Umano\', \'flavor\': \'Solo chi è degno viene ammesso nella foresta senziente nota come Rovina-Asce.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356399&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a7930a97-c70b-4313-bc39-1ec46b17f2e5\', \'multiverseId\': 356399}, \'multiverseid\': 356399}, {\'name\': \'斧折りの守護者\', \'text\': \'防衛\\n{T}：あなたのマナ・プールに、好きな色の組み合わせのマナＸ点を加える。Ｘはあなたがコントロールする防衛を持つクリーチャーの総数に等しい。\', \'type\': \'クリーチャー — 人間・ドルイド\', \'flavor\': \'斧折りとして知られる生ける森に足を踏み入れられるのは、一握りの価値ある者だけである。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356673&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fe508dd9-656f-4c35-926b-d53af969b4f5\', \'multiverseId\': 356673}, \'multiverseid\': 356673}, {\'name\': \'액스베인 수호자\', \'text\': \'수비태세\\n{T}: 원하는 색의 조합으로 마나 X개를 당신의 마나풀에 담는다. X는 당신이 조종하는 생물 중 수비태세 능력을 가진 생물의 수다.\', \'type\': \'생물 — 인간 드루이드\', \'flavor\': \'극소수의 자격 있는 자만이 살아있는 숲 액스베인에 들어갈 수 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357495&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'632439f4-157a-4cc2-97ff-20c489992f73\', \'multiverseId\': 357495}, \'multiverseid\': 357495}, {\'name\': \'Guardião de Danação dos Machados\', \'text\': \'Defensor\\n{T}: Adicione X manas em qualquer combinação de cores a sua reserva de mana, sendo X igual ao número de criaturas com defensor que você controla.\', \'type\': \'Criatura — Humano Druida\', \'flavor\': \'A apenas uns poucos dignos é permitida a entrada na floresta senciente conhecida como Danação dos Machados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356947&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'72b31276-6990-4a68-90e7-66ad75549073\', \'multiverseId\': 356947}, \'multiverseid\': 356947}, {\'name\': \'Хранитель Глухолесья\', \'text\': \'Защитник\\n{T}: добавьте Х маны в любой комбинации цветов в ваше хранилище маны, где Х — количество существ с Защитником под вашим контролем.\', \'type\': \'Существо — Человек Друид\', \'flavor\': \'Лишь избранным дозволено входить в запретную чащу, прозванную Глухолесьем.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355303&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d97926c9-728d-41a0-901c-dcb4f79481e6\', \'multiverseId\': 355303}, \'multiverseid\': 355303}, {\'name\': \'禁伐林守护者\', \'text\': \'守军\\n{T}：加X点法术力到你的法术力池中，其颜色组合可任意选择，X为由你操控的具守军异能的生物数量。\', \'type\': \'生物～人类／德鲁伊\', \'flavor\': \'只有少数精英才获准进入禁伐林这片具有感知能力的树林。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357221&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'33c6221c-44dd-4cc8-a592-b63c5dc85538\', \'multiverseId\': 357221}, \'multiverseid\': 357221}, {\'name\': \'禁伐林守護者\', \'text\': \'守軍\\n{T}：加X點魔法力到你的魔法力池中，其顏色組合可任意選擇，X為由你操控的具守軍異能的生物數量。\', \'type\': \'生物～人類／德魯伊\', \'flavor\': \'只有少數精英才獲准進入禁伐林這片具有感知能力的樹林。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355577&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b4083b08-4509-49e2-a32c-bfa535d1797d\', \'multiverseId\': 355577}, \'multiverseid\': 355577}]', "[{'name': 'Zanikev-Heuschrecke', 'text': 'Fliegend\\nAusplündern {2}{B}{B} ({2}{B}{B}, schicke diese Karte aus deinem Friedhof ins Exil: Lege so viele +1/+1-Marken, wie die Stärke dieser Karte beträgt, auf eine Kreatur deiner Wahl. Spiele Ausplündern wie eine Hexerei.)', 'type': 'Kreatur — Insekt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355820&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b04c172d-e53c-44c9-9fda-7dc79c48cf61', 'multiverseId': 355820}, 'multiverseid': 355820}, {'name': 'Langosta de Zánikev', 'text': 'Vuela.\\nCarroñar {2}{B}{B}. ({2}{B}{B}, exiliar esta carta de tu cementerio: Pon sobre la criatura objetivo una cantidad de contadores +1/+1 igual a la fuerza de esta carta. Activa la habilidad de carroñar como un conjuro.)', 'type': 'Criatura — Insecto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365542&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'df0acb9c-7287-4906-915f-c4cb3c1873fd', 'multiverseId': 365542}, 'multiverseid': 365542}, {'name': 'Sauterelle de Zanikev', 'text': 'Vol\\nRécupération {2}{B}{B} ({2}{B}{B}, exilez cette carte de votre cimetière : Mettez un nombre de marqueurs +1/+1 égal à la force de cette carte sur une créature ciblée. Ne récupérez que lorsque vous pourriez lancer un rituel.)', 'type': 'Créature : insecte', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356094&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'dfadccde-be87-425d-80eb-7e79681822e9', 'multiverseId': 356094}, 'multiverseid': 356094}, {'name': 'Locusta di Zanikev', 'text': 'Volare\\nMangiacarogne {2}{B}{B} ({2}{B}{B}, Esilia questa carta dal tuo cimitero: Metti un numero di segnalini +1/+1 pari alla forza di questa carta su una creatura bersaglio. Attiva mangiacarogne solo quando potresti lanciare una stregoneria.)', 'type': 'Creatura — Insetto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356368&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'e474b6fd-eb79-4453-9a21-ad172523dec9', 'multiverseId': 356368}, 'multiverseid': 356368}, {'name': 'ザーニケヴの蝗', 'text': '飛行\\n活用 {2}{B}{B} （{2}{B}{B}, このカードをあなたの墓地から追放する：クリーチャー１体を対象とし、それの上にこのカードのパワーに等しい数の＋１/＋１カウンターを置く。活用はソーサリーとしてのみ行う。）', 'type': 'クリーチャー — 昆虫', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356642&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ee72f670-d633-476b-b0cc-fb7079a224ea', 'multiverseId': 356642}, 'multiverseid': 356642}, {'name': '자니케브 메뚜기', 'text': '비행\\n섭취 {2}{B}{B} ({2}{B}{B}, 당신의 무덤에서 이 카드를 추방한다: 생물 한 개를 목표로 정한다. 이 카드의 공격력만큼의 +1/+1 카운터를 그 생물에 올려놓는다. 당신이 집중마법을 발동할 수 있는 시기에만 섭취 능력을 활성화할 수 있다.)', 'type': '생물 — 곤충', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357464&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'f33b4dc5-8003-42ea-8c7a-2a8927c5f6ed', 'multiverseId': 357464}, 'multiverseid': 357464}, {'name': 'Gafanhoto de Zanikev', 'text': 'Voar\\nNecrofagia {2}{B}{B} ({2}{B}{B}, Exile este card de seu cemitério: Coloque uma quantidade de marcadores +1/+1 igual ao poder deste card na criatura alvo. Use necrofagia somente quando puder conjurar um feitiço.)', 'type': 'Criatura — Inseto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356916&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a05c0526-2be8-4b9e-9d61-1714e4cf713a', 'multiverseId': 356916}, 'multiverseid': 356916}, {'name': 'Заникевская Саранча', 'text': 'Полет\\nУтилизация {2}{B}{B} ({2}{B}{B}, изгоните эту карту из вашего кладбища: положите на целевое существо жетоны +1/+1, количество которых равно силе этой карты. Утилизируйте только как волшебство.)', 'type': 'Существо — Насекомое', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355272&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '7420f5ff-be11-46fd-a627-f9d316390193', 'multiverseId': 355272}, 'multiverseid': 355272}, {'name': '札尼凯蝗虫', 'text': '飞行\\n食腐{2}{B}{B}（{2}{B}{B}，从你的坟墓场放逐此牌：在目标生物上放置若干+1/+1指示物，其数量等同于此牌的力量。食腐的时机视同法术。）', 'type': '生物～昆虫', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357190&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '7daec78d-09a0-4d8a-86bc-df80be23b200', 'multiverseId': 357190}, 'multiverseid': 357190}, {'name': '札尼凱蝗蟲', 'text': '飛行\\n食腐{2}{B}{B}（{2}{B}{B}，從你的墳墓場放逐此牌：在目標生物上放置若干+1/+1指示物，其數量等同於此牌的力量。食腐的時機視同巫術。）', 'type': '生物～昆蟲', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355546&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '69f1bc1b-aa08-41c0-98c6-799c317a4ab1', 'multiverseId': 355546}, 'multiverseid': 355546}]", '[{\'name\': \'Zusammengehörigkeit\', \'text\': \'Lege eine +1/+1-Marke auf eine Kreatur deiner Wahl.\\nLege eine +1/+1-Marke auf eine Kreatur deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'Wolfsreiter trainieren ihre Fähigkeiten, indem sie den gefährlichen Weg über die Dächer nehmen, wobei jeder schwindelerregende Schritt Elf und Wolf näher zusammenbringt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355887&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e9ae8cc8-ed3a-4c5d-919d-2cf3039ac059\', \'multiverseId\': 355887}, \'multiverseid\': 355887}, {\'name\': \'Lazo común\', \'text\': \'Pon un contador +1/+1 sobre la criatura objetivo.\\nPon un contador +1/+1 sobre la criatura objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'Los jinetes de lobos afinan su habilidad atravesando los peligrosos tejados; cada paso vertiginoso refuerza la unión entre el elfo y el lobo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365609&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7282d968-3e3e-45a8-89f6-ea5aed62a138\', \'multiverseId\': 365609}, \'multiverseid\': 365609}, {\'name\': \'Lien commun\', \'text\': \'Mettez un marqueur +1/+1 sur la créature ciblée.\\nMettez un marqueur +1/+1 sur la créature ciblée.\', \'type\': \'Éphémère\', \'flavor\': "Les chevaucheurs de loup s\'entraînent sur les toits, resserrant du même coup les liens unissant l\'elfe et sa monture.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356161&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f63b5607-ec33-4f95-849e-e26796dff886\', \'multiverseId\': 356161}, \'multiverseid\': 356161}, {\'name\': \'Legame Comune\', \'text\': \'Metti un segnalino +1/+1 su una creatura bersaglio.\\nMetti un segnalino +1/+1 su una creatura bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'I cavalcatori di lupi affinano le loro abilità sfrecciando sugli insidiosi tetti della città. Ogni vertiginoso passo avvicina sempre di più elfo e lupo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356435&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'43f26d09-a520-4016-b57d-101a091e958f\', \'multiverseId\': 356435}, \'multiverseid\': 356435}, {\'name\': \'共有の絆\', \'text\': \'クリーチャー１体を対象とし、クリーチャー１体を対象とする。その前者の上に＋１/ ＋１カウンターを１個置き、その後者の上に＋１/ ＋１カウンターを１個置く。\', \'type\': \'インスタント\', \'flavor\': \'狼乗りは危険な屋根を渡ることで技術を磨く。眼が眩むような一歩を踏み出すたびに、エルフと狼との距離は縮まるのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356709&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5fbaa551-8edc-453b-9602-3f9dc05b643e\', \'multiverseId\': 356709}, \'multiverseid\': 356709}, {\'name\': \'굳건한 유대감\', \'text\': \'생물 한 개를 목표로 정한다. 그 생물에 +1/+1 카운터 한 개를 올려놓는다.\\n생물 한 개를 목표로 정한다. 그 생물에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'순간마법\', \'flavor\': \'늑대 기수들은 위험한 지붕 위를 가로지르며 기술을 연마한다. 죽을 고비를 수없이 넘기면서 기수와 늑대는 더욱 친밀해진다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357531&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'dcda575a-e6c4-422a-92d4-135f97f9281d\', \'multiverseId\': 357531}, \'multiverseid\': 357531}, {\'name\': \'Elo Comum\', \'text\': \'Coloque um marcador +1/+1 na criatura alvo.\\nColoque um marcador +1/+1 na criatura alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os ginetes de lobos aprimoram suas habilidades cruzando os perigosos telhados da cidade, estreitando o elo entre elfo e lobo a cada passo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356983&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a15079d4-e0a2-494f-9792-5f5836d9988f\', \'multiverseId\': 356983}, \'multiverseid\': 356983}, {\'name\': \'Общее Дело\', \'text\': \'Положите один жетон +1/+1 на целевое существо.\\nПоложите один жетон +1/+1 на целевое существо.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Волчьи наездники тренируют навыки, перемещаясь по городским крышам, где каждый шаг сближает эльфа-наездника со своим волком.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355339&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'533d49c1-45ea-4373-a420-3eed457e8fa8\', \'multiverseId\': 355339}, \'multiverseid\': 355339}, {\'name\': \'共同联系\', \'text\': \'在目标生物上放置一个+1/+1指示物。\\n在目标生物上放置一个+1/+1指示物。\', \'type\': \'瞬间\', \'flavor\': \'狼骑兵靠横渡陡险的屋顶来磨炼技巧，每踏出惊险的一步，都让妖精和狼配合得更加紧密。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357257&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b7a7aa3e-147d-4135-acd2-acf3ba759e19\', \'multiverseId\': 357257}, \'multiverseid\': 357257}, {\'name\': \'共同聯繫\', \'text\': \'在目標生物上放置一個+1/+1指示物。\\n在目標生物上放置一個+1/+1指示物。\', \'type\': \'瞬間\', \'flavor\': \'狼騎兵靠橫渡陡險的屋頂來磨鍊技巧，每踏出驚險的一步，都讓妖精和狼配合得更加緊密。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355613&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bf68b217-00a2-4860-9fcb-d5d710662d06\', \'multiverseId\': 355613}, \'multiverseid\': 355613}]', '[{\'name\': \'Zusammenschrumpfen\', \'text\': \'Eine Kreatur deiner Wahl, die du nicht kontrollierst, erhält -4/-0 bis zum Ende des Zuges.\\nÜberlast {2}{U} (Du kannst diesen Zauber zu seinen Überlast-Kosten wirken. Falls du dies tust, verändere seinen Text, indem du im Text alle Vorkommen von „deiner Wahl" durch „jeder" ersetzt.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355774&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'22a431ab-4b37-4470-8d6f-5ce03dc04e6c\', \'multiverseId\': 355774}, \'multiverseid\': 355774}, {\'name\': \'Mermar\', \'text\': \'La criatura objetivo que no controlas obtiene -4/-0 hasta el final del turno.\\nSobrecarga {2}{U}. (Puedes lanzar este hechizo por su coste de sobrecarga. Si lo haces, cambia su texto reemplazando "la criatura objetivo" por "cada criatura".)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365496&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c313fded-21e6-4101-b00c-ba132f9ea6cc\', \'multiverseId\': 365496}, \'multiverseid\': 365496}, {\'name\': \'Rapetissement\', \'text\': "Une créature ciblée que vous ne contrôlez pas gagne -4/-0 jusqu\'à la fin du tour.\\nSurcharge {2}{U} (Vous pouvez lancer ce sort pour son coût de surcharge. Si vous faites ainsi, modifiez son texte en remplaçant toutes les occurrences de « ciblé(e) » par « chaque ».)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356048&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5712f69b-d25a-4f49-b778-087dce48f8dd\', \'multiverseId\': 356048}, \'multiverseid\': 356048}, {\'name\': \'Restringere\', \'text\': \'Una creatura bersaglio che non controlli prende -4/-0 fino alla fine del turno.\\nSovraccarico {2}{U} (Puoi lanciare questa magia per il suo costo di sovraccarico. Se lo fai, cambiane il testo sostituendo "una creatura bersaglio" con "ogni creatura".)\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356322&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dded466b-9e68-43a0-9635-7693dc82a943\', \'multiverseId\': 356322}, \'multiverseid\': 356322}, {\'name\': \'圧縮\', \'text\': \'あなたがコントロールしていないクリーチャー１体を対象とする。それはターン終了時まで－４/－０の修整を受ける。\\n超過 {2}{U} （あなたはこの呪文をその超過コストで唱えてもよい。そうした場合、あなたがコントロールしていない各クリーチャーはそれぞれターン終了時まで－４/－０の修整を受ける。）\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356596&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2e34d1f6-0ff8-42dd-9106-feab91d0a270\', \'multiverseId\': 356596}, \'multiverseid\': 356596}, {\'name\': \'감축\', \'text\': \'당신이 조종하지 않는 생물 한 개를 목표로 정한다. 그 생물은 턴종료까지 -4/-0을 받는다.\\n과부하 {2}{U} (당신은 과부하 비용을 지불하여 이 주문을 발동할 수 있다. 그럴 경우, 이 주문은 "당신이 조종하지 않는 각 생물은 턴종료까지 -4/-0을 받는다"로 내용이 변한다.)\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357418&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b6917cf1-0ee8-4e6d-9225-cfeb2edc04be\', \'multiverseId\': 357418}, \'multiverseid\': 357418}, {\'name\': \'Diminuição\', \'text\': \'A criatura alvo que você não controla recebe -4/-0 até o final do turno.\\nSobrecarga {2}{U} (Você pode conjurar esta mágica pagando seu custo de sobrecarga. Se fizer isso, altere seu texto substituindo todas as ocorrências de "a criatura alvo" por "cada criatura".)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356870&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'594e8c06-a16e-4ca4-b437-fbf8786771d8\', \'multiverseId\': 356870}, \'multiverseid\': 356870}, {\'name\': \'Ужимание\', \'text\': \'Целевое существо не под вашим контролем получает -4/-0 до конца хода.\\nПерегрузка {2}{U} (Вы можете разыграть это заклинание за его стоимость Перегрузки. Если вы это делаете, измените в его тексте все слова «целевой» на «каждый».)\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355226&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b39f9f31-be82-4c6c-b641-de9f0f74af34\', \'multiverseId\': 355226}, \'multiverseid\': 355226}, {\'name\': \'压缩尺寸\', \'text\': \'目标不由你操控的生物得-4/-0直到回合结束。\\n超载{2}{U}（你可以支付此咒语的超载费用来施放它。如果你如此作，将其中的「目标」字样全部更改为「每个」。）\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357144&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1db07c82-f3bc-4d92-8c77-838ca27e90ba\', \'multiverseId\': 357144}, \'multiverseid\': 357144}, {\'name\': \'壓縮尺寸\', \'text\': \'目標不由你操控的生物得-4/-0直到回合結束。\\n超載{2}{U}（你可以支付此咒語的超載費用來施放它。如果你如此作，將其中的「目標」字樣全部更改為「每個」。）\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355500&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bfa70e12-494c-40df-b854-026a010096bd\', \'multiverseId\': 355500}, \'multiverseid\': 355500}]', '[{\'name\': \'Ätherrüstung\', \'text\': \'Kreaturenverzauberung\\nDie verzauberte Kreatur hat Erstschlag und erhält +1/+1 für jede Verzauberung, die du kontrollierst.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Metall ist rar, Schmiede sind teuer und ein Plattenpanzer ist schwer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355745&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cfc5aa49-132a-489a-8314-42377b889714\', \'multiverseId\': 355745}, \'multiverseid\': 355745}, {\'name\': \'Armadura etérea\', \'text\': \'Encantar criatura.\\nLa criatura encantada obtiene +1/+1 por cada encantamiento que controles y tiene la habilidad de dañar primero.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'El metal es escaso; los herreros caros y la malla de placas, pesada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365467&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c42806dd-795f-4c99-8d3c-94c9284eb096\', \'multiverseId\': 365467}, \'multiverseid\': 365467}, {\'name\': \'Armure éthérée\', \'text\': "Enchanter : créature\\nLa créature enchantée gagne +1/+1 pour chaque enchantement que vous contrôlez et elle a l\'initiative.", \'type\': \'Enchantement : aura\', \'flavor\': "Le métal se fait rare, les forgerons prennent cher et l\'armure de plaques, ça pèse lourd.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356019&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d7c80881-89dc-486e-ad06-4a2735190ab3\', \'multiverseId\': 356019}, \'multiverseid\': 356019}, {\'name\': \'Armatura Eterea\', \'text\': \'Incanta creatura\\nLa creatura incantata prende +1/+1 per ogni incantesimo che controlli e ha attacco improvviso.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'Il metallo scarseggia, i fabbri costano e le corazze pesano.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356293&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0c55fded-2295-404c-94a5-a561a90daa86\', \'multiverseId\': 356293}, \'multiverseid\': 356293}, {\'name\': \'天上の鎧\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは、あなたがコントロールするエンチャント１つにつき＋１/＋１の修整を受けるとともに先制攻撃を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'金属は希少だし鍛冶屋は高いし、それに板金鎧は重いし。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356567&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f2699a69-c584-4509-abc0-5a44920fa748\', \'multiverseId\': 356567}, \'multiverseid\': 356567}, {\'name\': \'실체가 없는 갑옷\', \'text\': \'생물에게 부여\\n부여된 생물은 선제공격 능력을 가지며 당신이 조종하는 부여마법 한 개당 +1/+1을 받는다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'금속은 부족하고 대장장이들은 비싸며 판금 갑옷은 너무 무겁다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357389&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e64adf83-40a8-4748-9daf-4af6a2d3b1b9\', \'multiverseId\': 357389}, \'multiverseid\': 357389}, {\'name\': \'Armadura Etérea\', \'text\': \'Encantar criatura\\nA criatura encantada recebe +1/+1 para cada encantamento que você controla e tem iniciativa.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'O metal é escasso, os ferreiros são caros e armaduras de placas são pesadas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356841&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'053c867a-e86c-4ed2-9da7-f4550b0a8cb9\', \'multiverseId\': 356841}, \'multiverseid\': 356841}, {\'name\': \'Невесомая Броня\', \'text\': \'Зачаровать существо\\nЗачарованное существо получает +1/+1 за каждые чары под вашим контролем и имеет Первый удар.\', \'type\': \'Чары — Аура\', \'flavor\': \'Хороший металл — редкость, кузнецы дороги, а броня получается тяжелой.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355197&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'22194214-e756-4430-908d-906a238cdd6a\', \'multiverseId\': 355197}, \'multiverseid\': 355197}, {\'name\': \'空灵铠\', \'text\': \'结附于生物\\n你每操控一个结界，所结附的生物便得+1/+1且具有先攻异能。\', \'type\': \'结界～灵气\', \'flavor\': \'金属难寻，工匠昂贵，而铠甲又笨重。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357115&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4cb937cd-2c13-4358-88c1-fb49cec756bb\', \'multiverseId\': 357115}, \'multiverseid\': 357115}, {\'name\': \'空靈鎧\', \'text\': \'結附於生物\\n你每操控一個結界，所結附的生物便得+1/+1且具有先攻異能。\', \'type\': \'結界～靈氣\', \'flavor\': \'金屬難尋，工匠昂貴，而鎧甲又笨重。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355471&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fd52df49-fff3-4f03-8aa8-447104936bb1\', \'multiverseId\': 355471}, \'multiverseid\': 355471}]', '[{\'name\': \'Äußerster Preis\', \'text\': \'Zerstöre eine einfarbige Kreatur deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Soll er denen als Beispiel dienen, die überlegen, mit ihren Schulden bei uns in Verzug zu geraten." —„Der Irreführer", Orzhov-Assassine\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355818&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6d4e9603-24b1-4108-8f40-a34890ce672c\', \'multiverseId\': 355818}, \'multiverseid\': 355818}, {\'name\': \'Precio final\', \'text\': \'Destruye la criatura monocolor objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Que él sirva de ejemplo a quienes pudieran retrasarse en pagarnos sus deudas." —"El Engaño", asesino orzhov\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365540&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dd4062dd-0180-4836-9f86-1e75b5a7e45e\', \'multiverseId\': 365540}, \'multiverseid\': 365540}, {\'name\': \'Prix ultime\', \'text\': \'Détruisez la créature monochrome ciblée.\', \'type\': \'Éphémère\', \'flavor\': "« Qu\'il serve d\'exemple à tous ceux qui s\'aviseraient de ne pas régler leurs dettes. » —« Le Mystificateur », assassin d\'Orzhov", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356092&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9a5c78d3-959d-4aeb-9ce4-f8560788a25a\', \'multiverseId\': 356092}, \'multiverseid\': 356092}, {\'name\': \'Prezzo Definitivo\', \'text\': \'Distruggi una creatura monocolore bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Che sia di esempio per gli altri che pensano di ritardare i pagamenti." —"L\\\'Inganno", assassino Orzhov\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356366&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5a6b755a-262a-473a-9014-7d54f95aa53a\', \'multiverseId\': 356366}, \'multiverseid\': 356366}, {\'name\': \'究極の価格\', \'text\': \'単色のクリーチャー１体を対象とし、それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'「俺達への支払いを怠ったらどうなるか、こいつを戒めとしようじゃないか。」 ――オルゾフの暗殺者、「欺し屋」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356640&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e6d9f892-6aad-440e-ab65-80732082a16d\', \'multiverseId\': 356640}, \'multiverseid\': 356640}, {\'name\': \'궁극의 대가\', \'text\': \'단색 생물 한 개를 목표로 정한다. 그 생물을 파괴한다.\', \'type\': \'순간마법\', \'flavor\': \'"우리에게 진 빚을 갚지 못하면 어떻게 되는지 녀석을 본보기로 삼을 것이다." — 오르조브 암살자 "코젠"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357462&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'39a643de-22ef-42f0-88ad-ccef6644ef59\', \'multiverseId\': 357462}, \'multiverseid\': 357462}, {\'name\': \'Preço Final\', \'text\': \'Destrua a criatura alvo monocolorida.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Deixe que ele seja um exemplo para outros que não honrariam suas dívidas conosco." — "O Trapaceiro", assassino Orzhov\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356914&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d6cbfc7e-a803-40ff-9b6b-3ab318c844be\', \'multiverseId\': 356914}, \'multiverseid\': 356914}, {\'name\': \'Последняя Цена\', \'text\': \'Уничтожьте целевое одноцветное существо.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Пусть его судьба станет примером для тех, кто отказывается возвращать нам долги». — «Плут», убийца из дома Орзовов\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355270&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1dc01aa0-69f5-4bd3-8955-97006245a965\', \'multiverseId\': 355270}, \'multiverseid\': 355270}, {\'name\': \'终极代价\', \'text\': \'消灭目标单色生物。\', \'type\': \'瞬间\', \'flavor\': \'「他的下场就是拖欠我们债务者的榜样。」 ～欧佐夫杀手「大骗徒」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357188&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b956f6c5-40f3-4cb2-87e4-97fda8b4bb2c\', \'multiverseId\': 357188}, \'multiverseid\': 357188}, {\'name\': \'終極代價\', \'text\': \'消滅目標單色生物。\', \'type\': \'瞬間\', \'flavor\': \'「他的下場就是拖欠我們債務者的榜樣。」 ～歐佐夫殺手「大騙徒」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355544&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a9ddfd91-652c-4d89-a93d-c1ac67ed376d\', \'multiverseId\': 355544}, \'multiverseid\': 355544}]', '[{\'name\': \'Überwachsene Grabstätte\', \'text\': \'({T}: Erhöhe deinen Manavorrat um {B} oder {G}.)\\nSowie die Überwachsene Grabstätte ins Spiel kommt, kannst du 2 Lebenspunkte bezahlen. Falls du dies nicht tust, kommt die Überwachsene Grabstätte getappt ins Spiel.\', \'type\': \'Land — Sumpf, Wald\', \'flavor\': \'Das beste Leichentuch ist der Stoff, aus dem neues Leben entsteht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355979&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'60f1f90e-eb12-4387-b0c8-d1e787edd0f4\', \'multiverseId\': 355979}, \'multiverseid\': 355979}, {\'name\': \'Tumba cubierta de hierbas\', \'text\': \'({T}: Agrega {B} o {G} a tu reserva de maná.)\\nEn cuanto la Tumba cubierta de hierbas entre al campo de batalla, puedes pagar 2 vidas. Si no lo haces, la Tumba cubierta de hierbas entra al campo de batalla girada.\', \'type\': \'Tierra — Pantano bosque\', \'flavor\': \'La mejor mortaja funeraria es el tejido de la nueva vida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365701&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'49808011-3393-4c54-8af5-de9bc3124c46\', \'multiverseId\': 365701}, \'multiverseid\': 365701}, {\'name\': \'Tombeau luxuriant\', \'text\': \'({T} : Ajoutez {B} ou {G} à votre réserve.)\\nAu moment où le Tombeau luxuriant arrive sur le champ de bataille, vous pouvez payer 2 points de vie. Si vous ne le faites pas, le Tombeau luxuriant arrive sur le champ de bataille engagé.\', \'type\': \'Terrain : marais et forêt\', \'flavor\': "Le meilleur linceul funéraire est le tissu d\'une nouvelle vie.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356253&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b12c8911-02cf-43ca-bbd6-c9c1de7febc3\', \'multiverseId\': 356253}, \'multiverseid\': 356253}, {\'name\': \'Tomba Infestata da Erbacce\', \'text\': \'({T}: Aggiungi {B} o {G} alla tua riserva di mana.)\\nMentre la Tomba Infestata da Erbacce entra nel campo di battaglia, puoi pagare 2 punti vita. Se non lo fai, la Tomba Infestata da Erbacce entra nel campo di battaglia TAPpata.\', \'type\': \'Terra — Palude Foresta\', \'flavor\': \'Il miglior sudario da funerale è il tessuto di una nuova vita.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356527&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4fcdf5bf-3011-465c-a2d8-5e549aa9ab83\', \'multiverseId\': 356527}, \'multiverseid\': 356527}, {\'name\': \'草むした墓\', \'text\': \'（{T}：あなたのマナ・プールに{B}か{G}を加える。）\\n草むした墓が戦場に出るに際し、あなたはライフを２点支払ってもよい。そうしない場合、草むした墓はタップ状態で戦場に出る。\', \'type\': \'土地 — 沼・森\', \'flavor\': \'最高の埋葬布は新たな命の生地である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356801&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'88c88715-49ed-4760-a539-ee477eb884f8\', \'multiverseId\': 356801}, \'multiverseid\': 356801}, {\'name\': \'뒤덮인 무덤\', \'text\': \'({T}: {B} 또는 {G}를 당신의 마나풀에 담는다.)\\n뒤덮인 무덤이 전장에 들어오면서, 당신은 생명 2점을 지불할 수 있다. 그러지 않으면, 뒤덮인 무덤은 탭된 채로 전장에 들어온다.\', \'type\': \'대지 — 늪 숲\', \'flavor\': \'좋은 장례식 수의는 새로운 삶의 재료가 된다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357623&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'31a0c700-86be-45ca-a69b-8950a40921d6\', \'multiverseId\': 357623}, \'multiverseid\': 357623}, {\'name\': \'Tumba Abandonada\', \'text\': \'({T}: Adicione {B} ou {G} à sua reserva de mana.)Conforme Tumba Abandonada entra no campo de batalha, você pode pagar 2 pontos de vida. Se não fizer isso, Tumba Abandonada entrará no campo de batalha virada.\', \'type\': \'Terreno — Pântano Floresta\', \'flavor\': \'A melhor mortalha é o tecido de uma nova vida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357075&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0de90a60-a3e3-4717-a759-563ebc74fe23\', \'multiverseId\': 357075}, \'multiverseid\': 357075}, {\'name\': \'Заросшая Гробница\', \'text\': \'({T}: добавьте {B} или {G} в ваше хранилище маны.)\\nПри выходе Заросшей Гробницы на поле битвы вы можете заплатить 2 жизни. Если вы этого не делаете, Заросшая Гробница выходит на поле битвы повернутой.\', \'type\': \'Земля — Болото Лес\', \'flavor\': \'Лучший саван — это ткань новой жизни.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355431&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'820904d5-51f6-47b6-ad9a-733c4e31e770\', \'multiverseId\': 355431}, \'multiverseid\': 355431}, {\'name\': \'蔓生墓园\', \'text\': \'（{T}：加{B}或{G}到你的法术力池中。）\\n于蔓生墓园进战场时，你可以支付2点生命。如果你未如此作，蔓生墓园须横置进战场。\', \'type\': \'地～沼泽／树林\', \'flavor\': \'新生命是最棒的裹尸布。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357349&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'337bca00-65f9-4d91-b19d-aa48a1d97ed8\', \'multiverseId\': 357349}, \'multiverseid\': 357349}, {\'name\': \'蔓生墓園\', \'text\': \'（{T}：加{B}或{G}到你的魔法力池中。）\\n於蔓生墓園進戰場時，你可以支付2點生命。如果你未如此作，蔓生墓園須橫置進戰場。\', \'type\': \'地～沼澤／樹林\', \'flavor\': \'新生命是最棒的裹尸布。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355705&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a5655442-0ef3-43a5-86f2-0366cc429795\', \'multiverseId\': 355705}, \'multiverseid\': 355705}]']
