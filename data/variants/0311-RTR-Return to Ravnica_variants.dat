d', 'language': 'Russian', 'identifiers': {'scryfallId': 'a19269b2-ebd0-4928-b9a9-f63c3539224d', 'multiverseId': 355446}, 'multiverseid': 355446}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357364&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9b88a31b-61c8-4a8d-875e-725d059a3a12', 'multiverseId': 357364}, 'multiverseid': 357364}, {'name': '海島', 'type': '基本地～海島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355720&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '0be8b19f-acf2-4e4c-840d-87fe045d4cd8', 'multiverseId': 355720}, 'multiverseid': 355720}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355995&type=card', 'language': 'German', 'identifiers': {'scryfallId': '3efb7999-a582-4d0d-a271-b8cd3c9a82b8', 'multiverseId': 355995}, 'multiverseid': 355995}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365717&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'b92708f3-2c25-4199-9784-99f61c165183', 'multiverseId': 365717}, 'multiverseid': 365717}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356269&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2810e023-7c05-490e-b71d-82299f94e41e', 'multiverseId': 356269}, 'multiverseid': 356269}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356543&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '72e62d78-7d05-4bf6-907c-f252abec20ad', 'multiverseId': 356543}, 'multiverseid': 356543}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356817&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '40778aed-4a93-4a9f-ba88-e61747341776', 'multiverseId': 356817}, 'multiverseid': 356817}, {'name': '섬', 'type': '기본 대지 — 섬', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357639&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '4fd41462-ef7d-442e-95bd-f043ae5dab92', 'multiverseId': 357639}, 'multiverseid': 357639}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357091&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ad8fa43f-38b0-48d9-892e-334a1a2653f8', 'multiverseId': 357091}, 'multiverseid': 357091}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355447&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '54257755-007d-44ce-a7c6-35d97e32993b', 'multiverseId': 355447}, 'multiverseid': 355447}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357365&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b912d337-f8f5-49e8-b915-c09c91e40fc1', 'multiverseId': 357365}, 'multiverseid': 357365}, {'name': '海島', 'type': '基本地～海島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355721&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '6be63979-825f-479f-ac6e-8e6fd74ca0cd', 'multiverseId': 355721}, 'multiverseid': 355721}]", '[{\'name\': \'Inspiration\', \'text\': \'Ein Spieler deiner Wahl zieht zwei Karten.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Tag 31: Endlich ist mir bei meinem Experiment der Zeitumkehr der Durchbruch gelungen!" „Tag 30: Es gibt da möglicherweise ein Problem." —Tagebuch des Höchsten Izmagnus\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355778&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d439bcdd-5a76-4a7c-963e-c4d875a9dfce\', \'multiverseId\': 355778}, \'multiverseid\': 355778}, {\'name\': \'Inspiración\', \'text\': \'El jugador objetivo roba dos cartas.\', \'type\': \'Instantáneo\', \'flavor\': \'"Día 31: ¡Por fin ha resultado mi experimento de inversión del tiempo! "Día 30: Creo que tengo un problema." —Diario del Izmagnus Primo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365500&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'92b0d563-26ef-4557-ab9c-a6a97f7be8bf\', \'multiverseId\': 365500}, \'multiverseid\': 365500}, {\'name\': \'Inspiration\', \'text\': \'Le joueur ciblé pioche deux cartes.\', \'type\': \'Éphémère\', \'flavor\': "« 31e jour : J\'ai enfin réussi à inverser le cours du temps ! » « 30e jour : J\'ai comme qui dirait un problème. » —Journal du Premier Izmagnus", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356052&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'967c0875-cc8c-47ed-b138-c87e7b1ab790\', \'multiverseId\': 356052}, \'multiverseid\': 356052}, {\'name\': \'Ispirazione\', \'text\': \'Un giocatore bersaglio pesca due carte.\', \'type\': \'Istantaneo\', \'flavor\': \'"Giorno 31: Finalmente il mio esperimento di inversione temporale ha avuto successo!" "Giorno 30: Forse c\\\'è un problema." —Diario dell\\\'Izmagnus Primario\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356326&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'562303b8-bad4-43b4-a0f5-4f4b256fe189\', \'multiverseId\': 356326}, \'multiverseid\': 356326}, {\'name\': \'霊感\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーはカードを２枚引く。\', \'type\': \'インスタント\', \'flavor\': \'「31日目：ついに時間の逆行実験に成功した！」 「30日目：これはちとマズイかもしれん。」 ――首席イズマグナスの日誌\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356600&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6f360b3d-2da3-4533-810e-48076365d768\', \'multiverseId\': 356600}, \'multiverseid\': 356600}, {\'name\': \'영감\', \'text\': \'플레이어 한 명을 목표로 정한다. 그 플레이어는 카드 두 장을 뽑는다.\', \'type\': \'순간마법\', \'flavor\': \'"제 31일: 드디어 시간 반전 실험에 성공했다!" "제 30일: 문제가 생긴 것 같다." —이젯 길드 수석마도사의 일지\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357422&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'05d93a66-af53-4341-b73c-cae967bea73b\', \'multiverseId\': 357422}, \'multiverseid\': 357422}, {\'name\': \'Inspiração\', \'text\': \'O jogador alvo compra dois cards.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"31º dia: Finalmente tive sucesso em meu experimento de reversão temporal! "30º dia: Acho que tenho um problema..." — Diário do Primeiro-Izmagnus\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356874&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a979a073-5ba6-4d0a-b147-d8b00fa973d6\', \'multiverseId\': 356874}, \'multiverseid\': 356874}, {\'name\': \'Вдохновение\', \'text\': \'Целевой игрок берет две карты.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«День 31: я наконец-то преуспел в опытах с поворотом времени вспять! День 30: кажется, у меня возникла проблема». — дневник Главного Измагнуса\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355230&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2cf6f508-0596-4341-b742-31110a7d76e4\', \'multiverseId\': 355230}, \'multiverseid\': 355230}, {\'name\': \'突发奇想\', \'text\': \'目标牌手抓两张牌。\', \'type\': \'瞬间\', \'flavor\': \'「第31日：我的逆转时间实验终于成功了！ 「第30日：这下麻烦了。」 ～伊捷首法师的日记\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357148&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'703e90d3-9fd7-48e9-8799-67adc3b05598\', \'multiverseId\': 357148}, \'multiverseid\': 357148}, {\'name\': \'突發奇想\', \'text\': \'目標玩家抽兩張牌。\', \'type\': \'瞬間\', \'flavor\': \'「第31日：我的逆轉時間實驗終於成功了！ 「第30日：這下麻煩了。」 ～伊捷首法師的日記\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355504&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e609e090-b90b-4bb2-93c4-f2d58e3cf2c1\', \'multiverseId\': 355504}, \'multiverseid\': 355504}]', '[{\'name\': \'Instabile Bastelei\', \'text\': \'Verursacht Trampelschaden\\nDie Instabile Bastelei greift in jedem Zug an, falls möglich.\\nImmer wenn der Instabilen Bastelei Schaden zugefügt wird, wirf eine Münze. Falls du den Münzwurf verlierst, opfere die Instabile Bastelei.\\nWenn die Instabile Bastelei stirbt, wirf eine Münze. Falls du den Münzwurf verlierst, fügt sie jeder Kreatur und jedem Spieler 4 Schadenspunkte zu.\', \'type\': \'Artefaktkreatur — Konstrukt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355972&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dc619890-ca21-44ce-a1e9-a139dc999da8\', \'multiverseId\': 355972}, \'multiverseid\': 355972}, {\'name\': \'Aparejo volátil\', \'text\': \'Arrolla.\\nEl Aparejo volátil ataca cada turno si puede.\\nSiempre que el Aparejo volátil reciba daño, lanza una moneda a cara o cruz. Si pierdes el lanzamiento, sacrifica el Aparejo volátil.\\nCuando el Aparejo volátil muera, lanza una moneda a cara o cruz. Si pierdes el lanzamiento, le hace 4 puntos de daño a cada criatura y a cada jugador.\', \'type\': \'Criatura artefacto — Constructo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365694&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'051818ad-92d1-497a-9033-1dd5f61b8c6c\', \'multiverseId\': 365694}, \'multiverseid\': 365694}, {\'name\': \'Moissonneuse volatile\', \'text\': \'Piétinement\\nLa Moissonneuse volatile attaque chaque tour si possible.\\nÀ chaque fois que la Moissonneuse volatile subit des blessures, jouez à pile ou face. Si vous perdez, sacrifiez la Moissonneuse volatile.\\nQuand la Moissonneuse volatile meurt, jouez à pile ou face. Si vous perdez, elle inflige 4 blessures à chaque créature et à chaque joueur.\', \'type\': \'Créature-artefact : construction\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356246&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'201d2a6b-bdca-4d5b-aefc-d690049d634d\', \'multiverseId\': 356246}, \'multiverseid\': 356246}, {\'name\': \'Attrezzatura Mutevole\', \'text\': "Travolgere\\nL\'Attrezzatura Mutevole attacca ogni turno, se può farlo.\\nOgniqualvolta all\'Attrezzatura Mutevole viene inflitto danno, lancia una moneta. Se perdi il lancio, sacrifica l\'Attrezzatura Mutevole.\\nQuando l\'Attrezzatura Mutevole muore, lancia una moneta. Se perdi il lancio, infligge 4 danni a ogni creatura e a ogni giocatore.", \'type\': \'Creatura Artefatto — Costrutto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356520&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a88c1490-7f51-416e-9be6-fb6514fc3c7b\', \'multiverseId\': 356520}, \'multiverseid\': 356520}, {\'name\': \'不安定な装置\', \'text\': \'トランプル\\n不安定な装置は、可能なら毎ターン攻撃する。\\n不安定な装置にダメージが与えられるたび、コイン投げをする。あなたがコイン投げに負けた場合、不安定な装置を生け贄に捧げる。\\n不安定な装置が死亡したとき、コイン投げをする。あなたがコイン投げに負けた場合、これは各クリーチャーと各プレイヤーにそれぞれ４点のダメージを与える。\', \'type\': \'アーティファクト・クリーチャー — 構築物\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356794&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a7ea4011-a1f6-415a-bc22-422a625a89ce\', \'multiverseId\': 356794}, \'multiverseid\': 356794}, {\'name\': \'불안정한 장치\', \'text\': \'돌진\\n불안정한 장치는 가능하면 매 턴마다 공격한다.\\n불안정한 장치가 피해를 입을 때마다, 동전을 던진다. 당신이 동전 던지기에서 지면 불안정한 장치를 희생한다.\\n불안정한 장치가 죽을 때, 동전을 던진다. 당신이 동전 던지기에서 지면 불안정한 장치는 각 생물과 각 플레이어에게 피해 4점을 입힌다.\', \'type\': \'마법물체 생물 — 자동기계\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357616&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4bf9b4d5-e443-4c0c-bad5-becfce57c4f7\', \'multiverseId\': 357616}, \'multiverseid\': 357616}, {\'name\': \'Carroça Volátil\', \'text\': \'Atropelar\\nCarroça Volátil ataca a cada turno se estiver apta.\\nToda vez que Carroça Volátil sofrer dano, lance uma moeda. Se você perder, sacrifique Carroça Volátil.\\nQuando Carroça Volátil morrer, lance uma moeda. Se você perder, ela causará 4 pontos de dano a cada criatura e a cada jogador.\', \'type\': \'Criatura Artefato — Constructo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357068&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1df7589a-804c-4117-894a-157788daf1ce\', \'multiverseId\': 357068}, \'multiverseid\': 357068}, {\'name\': \'Неустойчивая Вышка\', \'text\': \'Пробивной удар\\nНеустойчивая Вышка атакует в каждом ходу, если может.\\nКаждый раз, когда Неустойчивой Вышке наносятся повреждения, подбросьте монету. Если вы проигрываете бросок, пожертвуйте Неустойчивую Вышку.\\nКогда Неустойчивая Вышка умирает, подбросьте монету. Если вы проигрываете бросок, она наносит 4 повреждения каждому существу и каждому игроку.\', \'type\': \'Артефактное Существо — Конструкция\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355424&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e646057e-67fd-4d24-b2c2-1788433019c2\', \'multiverseId\': 355424}, \'multiverseid\': 355424}, {\'name\': \'易爆设备\', \'text\': \'践踏\\n易爆设备每回合若能攻击，则必须攻击。\\n每当易爆设备受到伤害时，掷一枚硬币。如果你输掉此掷，牺牲易爆设备。\\n当易爆设备死去时，掷一枚硬币。如果你输掉此掷，则它对每个生物和每个牌手造成4点伤害。\', \'type\': \'神器生物～组构体\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357342&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'da76e625-bf56-4881-b8e7-46da111bd642\', \'multiverseId\': 357342}, \'multiverseid\': 357342}, {\'name\': \'易爆設備\', \'text\': \'踐踏\\n易爆設備每回合若能攻擊，則必須攻擊。\\n每當易爆設備受到傷害時，擲一枚硬幣。如果你輸掉此擲，犧牲易爆設備。\\n當易爆設備死去時，擲一枚硬幣。如果你輸掉此擲，它對每個生物和每位玩家各造成4點傷害。\', \'type\': \'神器生物～組構體\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355698&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b26308e6-709a-41a6-851e-7e9dccccd2e6\', \'multiverseId\': 355698}, \'multiverseid\': 355698}]', '[{\'name\': \'Isperia, Oberste Richterin\', \'text\': \'Fliegend\\nImmer wenn eine Kreatur dich oder einen Planeswalker angreift, den du kontrollierst, kannst du eine Karte ziehen\', \'type\': \'Legendäre Kreatur — Sphinx\', \'flavor\': \'„Ich diene nur der Gerechtigkeit. Aber in der Erfüllung meiner Pflichten diene ich Ravnica als Ganzem."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355907&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c1660695-67a6-4952-8b7d-33cc5d0ea59c\', \'multiverseId\': 355907}, \'multiverseid\': 355907}, {\'name\': \'Isperia, jueza suprema\', \'text\': \'Vuela.\\nSiempre que una criatura te ataque a ti o a un planeswalker que controlas, puedes robar una carta.\', \'type\': \'Criatura legendaria — Esfinge\', \'flavor\': \'"Sólo sirvo a la justicia. Pero mediante ese deber, sirvo a toda Rávnica."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365629&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'85cbd53e-7bd7-441f-b766-a2860846d548\', \'multiverseId\': 365629}, \'multiverseid\': 365629}, {\'name\': \'Isperia, juge suprême\', \'text\': "Vol\\nÀ chaque fois qu\'une créature vous attaque ou attaque un planeswalker que vous contrôlez, vous pouvez piocher une carte.", \'type\': \'Créature légendaire : sphinx\', \'flavor\': "« Je sers uniquement la justice. Mais ce devoir m\'entraîne à servir tout Ravnica. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356181&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e4679b74-ea7f-4f67-bfbf-e9f34a448d0f\', \'multiverseId\': 356181}, \'multiverseid\': 356181}, {\'name\': \'Isperia, Giudice Supremo\', \'text\': \'Volare\\nOgniqualvolta una creatura attacca te o un planeswalker che controlli, puoi pescare una carta.\', \'type\': \'Creatura Leggendaria — Sfinge\', \'flavor\': \'"Servo solo la giustizia. Ma così facendo, servo tutta Ravnica."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356455&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'40c4fafc-6786-4b15-8f9b-ebe4b61f9be1\', \'multiverseId\': 356455}, \'multiverseid\': 356455}, {\'name\': \'至高の審判者、イスペリア\', \'text\': \'飛行\\nクリーチャー１体があなたかあなたがコントロールするプレインズウォーカーを攻撃するたび、あなたはカードを１枚引いてもよい。\', \'type\': \'伝説のクリーチャー — スフィンクス\', \'flavor\': \'「私は正義のために尽くすだけです。しかしそれを通じて、私はラヴニカ全てに尽くしているのです。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356729&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'48361488-db41-4a8f-a5bd-503c30921457\', \'multiverseId\': 356729}, \'multiverseid\': 356729}, {\'name\': \'최고 재판관 이스페리아\', \'text\': \'비행\\n생물이 당신이나 당신이 조종하는 플레인즈워커를 공격할 때마다, 당신은 카드 한 장을 뽑을 수 있다.\', \'type\': \'전설적 생물 — 스핑크스\', \'flavor\': \'"나의 임무는 오로지 정의만을 섬기는 것이다. 하지만 그 임무를 통하여 라브니카 전체를 섬기기도 한다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357551&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9937cb55-7b3b-416f-9728-30f61d607a7a\', \'multiverseId\': 357551}, \'multiverseid\': 357551}, {\'name\': \'Isperia, Juíza Suprema\', \'text\': \'Voar\\nToda vez que uma criatura ataca você ou um planeswalker que você controla, você pode comprar um card.\', \'type\': \'Criatura Lendária — Esfinge\', \'flavor\': \'"Eu sirvo apenas à justiça. Porém, por meio desse dever, sirvo a toda Ravnica."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357003&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'35096b97-7dfe-4270-acf1-8f2631ff7cf9\', \'multiverseId\': 357003}, \'multiverseid\': 357003}, {\'name\': \'Исперия, Верховная Судья\', \'text\': \'Полет\\nКаждый раз, когда существо атакует вас или planeswalker-а под вашим контролем, вы можете взять карту.\', \'type\': \'Легендарное Существо — Сфинкс\', \'flavor\': \'«Я служу лишь правосудию. Но этим я служу всей Равнике».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355359&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6fbf3915-5c75-4db3-a44d-e5887e45dabf\', \'multiverseId\': 355359}, \'multiverseid\': 355359}, {\'name\': \'大审决者伊佩利\', \'text\': \'飞行\\n每当一个生物攻击你或由你操控的鹏洛客时，你可以抓一张牌。\', \'type\': \'传奇生物～史芬斯\', \'flavor\': \'「我只替正义效命。但透过这项职责，我效忠整个拉尼卡。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357277&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6b3d133d-f516-41e3-99ec-4150d34b155a\', \'multiverseId\': 357277}, \'multiverseid\': 357277}, {\'name\': \'大審決者伊佩利\', \'text\': \'飛行\\n每當一個生物攻擊你或由你操控的鵬洛客時，你可以抽一張牌。\', \'type\': \'傳奇生物～史芬斯\', \'flavor\': \'「我只替正義效命。但透過這項職責，我效忠整個拉尼卡。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355633&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'63902944-e6ee-4941-9f4f-aa7ab36c97ec\', \'multiverseId\': 355633}, \'multiverseid\': 355633}]', '[{\'name\': \'Isperias Himmelswache\', \'text\': \'Fliegend\\nWenn Isperias Himmelswache ins Spiel kommt, inhaftiere eine Kreatur deiner Wahl, die ein Gegner kontrolliert. (Bis zu deinem nächsten Zug kann diese Kreatur nicht angreifen oder blocken, und ihre aktivierten Fähigkeiten können nicht aktiviert werden.)\', \'type\': \'Kreatur — Vedalken, Ritter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355779&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'43731bb9-6a4e-4bc6-8239-7473dd25e3b4\', \'multiverseId\': 355779}, \'multiverseid\': 355779}, {\'name\': \'Patrulla celeste de Isperia\', \'text\': \'Vuela.\\nCuando la Patrulla celeste de Isperia entre al campo de batalla, detén la criatura objetivo que controla un oponente. (Hasta tu próximo turno, esa criatura no puede atacar ni bloquear y sus habilidades activadas no pueden activarse.)\', \'type\': \'Criatura — Caballero vedalken\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365501&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4a1818f5-17ea-4318-9795-3b602a7823b6\', \'multiverseId\': 365501}, \'multiverseid\': 365501}, {\'name\': "Garde céleste d\'Isperia", \'text\': "Vol\\nQuand la Garde céleste d\'Isperia arrive sur le champ de bataille, détenez une créature ciblée qu\'un adversaire contrôle. (Jusqu\'à votre prochain tour, cette créature ne peut ni attaquer ni bloquer et ses capacités activées ne peuvent pas être activées.)", \'type\': \'Créature : vedalken et chevalier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356053&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d1209533-7c24-455b-80e5-712d47f26a23\', \'multiverseId\': 356053}, \'multiverseid\': 356053}, {\'name\': \'Guardia dei Cieli di Isperia\', \'text\': \'Volare\\nQuando la Guardia dei Cieli di Isperia entra nel campo di battaglia, trattieni una creatura bersaglio controllata da un avversario. (Fino al tuo prossimo turno, quella creatura non può attaccare o bloccare e le sue abilità attivate non possono essere attivate.)\', \'type\': \'Creatura — Cavaliere Vedalken\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356327&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f4d563f1-157a-45a9-9764-dc46fe2bd0cb\', \'multiverseId\': 356327}, \'multiverseid\': 356327}, {\'name\': \'イスペリアの空見張り\', \'text\': \'飛行\\nイスペリアの空見張りが戦場に出たとき、対戦相手１人がコントロールするクリーチャー１体を対象とし、それを留置する。（あなたの次のターンまで、そのクリーチャーでは攻撃もブロックもできず、それの起動型能力は起動できない。）\', \'type\': \'クリーチャー — ヴィダルケン・騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356601&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2cb64922-c2ce-4caa-aa1c-0e63c22b970c\', \'multiverseId\': 356601}, \'multiverseid\': 356601}, {\'name\': \'이스페리아의 창공경비대\', \'text\': \'비행\\n이스페리아의 창공경비대가 전장에 들어올 때, 상대가 조종하는 생물 한 개를 목표로 정한다. 그 생물을 억류한다. (당신의 다음 턴이 될 때까지 그 생물은 공격하거나 방어할 수 없으며, 그 생물의 활성화능력은 활성화될 수 없다.)\', \'type\': \'생물 — 베달켄 기사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357423&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'944e4c17-257d-4455-971f-68bc8ce78d11\', \'multiverseId\': 357423}, \'multiverseid\': 357423}, {\'name\': \'Vigia Celeste de Isperia\', \'text\': \'Voar\\nQuando Vigia Celeste de Isperia entrar no campo de batalha, detenha a criatura alvo que um oponente controla. (Até o seu próximo turno, aquela criatura não pode atacar nem bloquear e as habilidades ativadas dela não podem ser ativadas.)\', \'type\': \'Criatura — Cavaleiro Vedalkeano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356875&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8b4afc4a-b7a7-4e88-84e3-dcbcae4d6c2b\', \'multiverseId\': 356875}, \'multiverseid\': 356875}, {\'name\': \'Небесный Дозор Исперии\', \'text\': \'Полет\\nКогда Небесный Дозор Исперии выходит на поле битвы, задержите целевое существо под контролем оппонента. (До вашего следующего хода то существо не может атаковать или блокировать, и его активируемые способности не могут быть активированы.)\', \'type\': \'Существо — Ведалкен Рыцарь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355231&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f7529a80-4ac2-4c31-850e-ff8f59a2833f\', \'multiverseId\': 355231}, \'multiverseid\': 355231}, {\'name\': \'伊佩利空巡卫\', \'text\': \'飞行\\n当伊佩利空巡卫进战场时，拘留目标由对手操控的生物。（直到你的下个回合，该生物不能进行攻击或阻挡，其起动式异能也不能起动。）\', \'type\': \'生物～维多肯／骑士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357149&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b1373053-a25b-4c64-a5e6-582e0998e56f\', \'multiverseId\': 357149}, \'multiverseid\': 357149}, {\'name\': \'伊佩利空巡衛\', \'text\': \'飛行\\n當伊佩利空巡衛進戰場時，拘留目標由對手操控的生物。（直到你的下個回合，該生物不能進行攻擊或阻擋，其起動式異能也不能起動。）\', \'type\': \'生物～維多肯／騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355505&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7e67e667-c65e-4703-953a-55243f8c16ac\', \'multiverseId\': 355505}, \'multiverseid\': 355505}]', '[{\'name\': \'Izzet-Amulett\', \'text\': \'Bestimme eines — Neutralisiere einen Nicht-Kreaturenzauberspruch deiner Wahl, falls sein Beherrscher nicht {2} bezahlt; oder das Izzet-Amulett fügt einer Kreatur deiner Wahl 2 Schadenspunkte zu; oder ziehe zwei Karten und wirf dann zwei Karten aus deiner Hand ab.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355908&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'38a2be23-7df8-43c9-a89e-85e9afb717b2\', \'multiverseId\': 355908}, \'multiverseid\': 355908}, {\'name\': \'Amuleto ízzet\', \'text\': \'Elige uno: Contrarresta el hechizo objetivo que no sea de criatura a menos que su controlador pague {2}; o el Amuleto ízzet hace 2 puntos de daño a la criatura objetivo; o roba dos cartas y luego descarta dos cartas.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365630&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c5ac1eab-6e3a-4fa3-8bc9-190ada434ba1\', \'multiverseId\': 365630}, \'multiverseid\': 365630}, {\'name\': "Charme d\'Izzet", \'text\': "Choisissez l\'un — Contrecarrez un sort non-créature ciblé à moins que son contrôleur ne paie {2} ; ou le Charme d\'Izzet inflige 2 blessures à une créature ciblée ; ou piochez deux cartes, puis défaussez-vous de deux cartes.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356182&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'66ac4c6c-69f0-4d91-b568-452c67f0cb6f\', \'multiverseId\': 356182}, \'multiverseid\': 356182}, {\'name\': \'Talismano Izzet\', \'text\': \'Scegli uno — Neutralizza una magia non creatura bersaglio a meno che il suo controllore non paghi {2}; oppure il Talismano Izzet infligge 2 danni a una creatura bersaglio; oppure pesca due carte, poi scarta due carte.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356456&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'70d10c53-4a1e-43b1-98fa-fd94d02997cc\', \'multiverseId\': 356456}, \'multiverseid\': 356456}, {\'name\': \'イゼットの魔除け\', \'text\': \'以下の３つから１つを選ぶ。「クリーチャーでない呪文１つを対象とする。そのコントローラーが{2}を支払わないかぎり、それを打ち消す。」「クリーチャー１体を対象とする。イゼットの魔除けはそれに２点のダメージを与える。」「カードを２枚引き、その後カードを２枚捨てる。」\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356730&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cc001f5e-c83c-4264-9790-13b1516e83c0\', \'multiverseId\': 356730}, \'multiverseid\': 356730}, {\'name\': \'이젯 부적\', \'text\': \'하나를 선택한다 — 생물이 아닌 주문 한 개를 목표로 정한다. 그 조종자가 {2}를 지불하지 않으면 그 주문을 무효화한다; 또는 생물 한 개를 목표로 정한다. 이젯 부적은 그 생물에게 피해 2점을 입힌다; 또는 카드 두 장을 뽑은 후 카드 두 장을 버린다.\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357552&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c2633488-6df5-44c1-9684-9b85adad54b0\', \'multiverseId\': 357552}, \'multiverseid\': 357552}, {\'name\': \'Amuleto Izzet\', \'text\': \'Escolha um — Anule a mágica alvo que não seja de criatura a menos que seu controlador pague {2}; ou Amuleto Izzet causa 2 pontos de dano à criatura alvo; ou compre dois cards e depois descarte dois cards.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357004&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e272bbf5-d6a2-4ef1-8155-bcccb0114f1d\', \'multiverseId\': 357004}, \'multiverseid\': 357004}, {\'name\': \'Талисман Иззетов\', \'text\': \'Выберите одно — отмените целевое заклинание, не являющееся существом, если только контролирующий его игрок не заплатит {2}; или Талисман Иззетов наносит 2 повреждения целевому существу; или возьмите две карты, затем сбросьте две карты.\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355360&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d7a04dcd-d0b9-4558-8168-b606fdaf2244\', \'multiverseId\': 355360}, \'multiverseid\': 355360}, {\'name\': \'伊捷护符\', \'text\': \'选择一项～除非目标非生物咒语的操控者支付{2}，否则反击之；或伊捷护符对目标生物造成2点伤害；或抓两张牌，然后弃两张牌。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357278&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7e9677b8-b0a8-44a2-8363-7fe8547b1398\', \'multiverseId\': 357278}, \'multiverseid\': 357278}, {\'name\': \'伊捷護符\', \'text\': \'選擇一項～除非目標非生物咒語的操控者支付{2}，否則反擊之；或伊捷護符對目標生物造成2點傷害；或抽兩張牌，然後棄兩張牌。\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355634&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'109c7b4d-7782-4938-8347-31cb5e4f3c03\', \'multiverseId\': 355634}, \'multiverseid\': 355634}]', '[{\'name\': \'Izzet-Gildeneingang\', \'text\': \'Der Izzet-Gildeneingang kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {U} oder {R}.\', \'type\': \'Land — Tor\', \'flavor\': \'Ein Eingang für die mit einer Vision und dem Mut, diese zu erschaffen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355978&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3acf6c26-f0b0-40f2-8463-4825f1da87fe\', \'multiverseId\': 355978}, \'multiverseid\': 355978}, {\'name\': \'Portal del Gremio Ízzet\', \'text\': \'El Portal del Gremio Ízzet entra al campo de batalla girado.\\n{T}: Agrega {U} o {R} a tu reserva de maná.\', \'type\': \'Tierra — Portal\', \'flavor\': \'Únete a aquellos con mente abierta para crear y audacia para liberar a sus creaciones.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365700&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e57a8561-783d-4f5b-843d-c3b1bab8e181\', \'multiverseId\': 365700}, \'multiverseid\': 365700}, {\'name\': "Porte de la guilde d\'Izzet", \'text\': "La Porte de la guilde d\'Izzet arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {U} ou {R} à votre réserve.", \'type\': \'Terrain : porte\', \'flavor\': \'Entrez, vous qui possédez la vision créatrice et la témérité pour lâcher vos créations dans la nature.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356252&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'74a7fb5e-428d-4d52-be43-f6bfdc436eac\', \'multiverseId\': 356252}, \'multiverseid\': 356252}, {\'name\': \'Cancello della Gilda Izzet\', \'text\': \'Il Cancello della Gilda Izzet entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {U} o {R} alla tua riserva di mana.\', \'type\': \'Terra — Cancello\', \'flavor\': \'Entrino coloro che hanno la fantasia per creare e il coraggio di dare vita alle loro creazioni.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356526&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'144af71a-572a-41f5-bfe7-4b959647a8e6\', \'multiverseId\': 356526}, \'multiverseid\': 356526}, {\'name\': \'イゼットのギルド門\', \'text\': \'イゼットのギルド門はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{U}か{R}を加える。\', \'type\': \'土地 — 門\', \'flavor\': \'創造す_る_意志と己の創造物を解き放つ無謀さを持つ者は、_こ__の_中へ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356800&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5119b97e-09db-48d4-b9e5-e31f0418ff1e\', \'multiverseId\': 356800}, \'multiverseid\': 356800}, {\'name\': \'이젯 길드관문\', \'text\': \'이젯 길드관문은 탭된 채로 전장에 들어온다.\\n{T}: {U} 또는 {R}를 당신의 마나풀에 담는다.\', \'type\': \'대지 — 관문\', \'flavor\': \'창조의 비전을 가진 라브니카인들이여, 그리고 그 작품들을 풀어놓을 무모함을 가진 자들이여, 이젯 길드를 찾은 것을 환영한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357622&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'870de97c-39b7-4796-a4d8-1c96484b0b98\', \'multiverseId\': 357622}, \'multiverseid\': 357622}, {\'name\': \'Portão da Guilda Izzet\', \'text\': \'Portão da Guilda Izzet entra no campo de batalha virado.\\n{T}: Adicione {U} ou {R} à sua reserva de mana.\', \'type\': \'Terreno — Portão\', \'flavor\': \'Entrem aqueleS com a visão para criar e a temeriDade para libeRtar suas Criações.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357074&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8ded2c9e-e843-43f2-b93a-920c63287b32\', \'multiverseId\': 357074}, \'multiverseid\': 357074}, {\'name\': \'Врата Гильдии Иззетов\', \'text\': \'Врата Гильдии Иззетов выходят на поле битвы повернутыми.\\n{T}: добавьте {U} или {R} в ваше хранилище маны.\', \'type\': \'Земля — Врата\', \'flavor\': \'Здесь об_и_тают те, кто умеет творить и не страш_и_тся выпускать свои творен_и_я на волю.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355430&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6fa59576-f282-4ab1-b033-6dfdc599c6ce\', \'multiverseId\': 355430}, \'multiverseid\': 355430}, {\'name\': \'伊捷公会门\', \'text\': \'伊捷公会门须横置进战场。\\n{T}：加{U}或{R}到你的法术力池中。\', \'type\': \'地～门\', \'flavor\': \'此门接纳拥有拉尼卡一流创意，又富实现创意的胆识者。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357348&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8b2d3f62-3fe9-4486-8a53-60d2c382200e\', \'multiverseId\': 357348}, \'multiverseid\': 357348}, {\'name\': \'伊捷公會門\', \'text\': \'伊捷公會門須橫置進戰場。\\n{T}：加{U}或{R}到你的魔法力池中。\', \'type\': \'地～門\', \'flavor\': \'此門接納擁有拉尼卡一流創意，又富實現創意的膽識者。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355704&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'395616d3-6db8-4f4e-9df7-9a7300cb4a5d\', \'multiverseId\': 355704}, \'multiverseid\': 355704}]', '[{\'name\': \'Izzet-Ladungsmagierin\', \'text\': \'Aufblitzen (Du kannst diesen Zauberspruch zu jedem Zeitpunkt wirken, zu dem du einen Spontanzauber wirken könntest.)\\nEile\\n{T}: Die Izzet-Ladungsmagierin fügt einer Kreatur deiner Wahl und jeder anderen Kreatur mit dem gleichen Namen wie diese Kreatur 1 Schadenspunkt zu.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355909&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'00f8ec3d-feb1-499c-bd36-9a470c6bb619\', \'multiverseId\': 355909}, \'multiverseid\': 355909}, {\'name\': \'Lanzaestática ízzet\', \'text\': \'Destello. (Puedes lanzar este hechizo en cualquier momento en que pudieras lanzar un instantáneo.)\\nPrisa.\\n{T}: La Lanzaestática ízzet hace 1 punto de daño a la criatura objetivo y a cada otra criatura con el mismo nombre que esa criatura.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365631&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2c578c6f-9fa3-48b5-afb2-1fa397a5cf9a\', \'multiverseId\': 365631}, \'multiverseid\': 365631}, {\'name\': "Incantatrice statique d\'Izzet", \'text\': "Flash (Vous pouvez lancer ce sort à tout moment où vous pourriez lancer un éphémère.)\\nCélérité\\n{T} : L\'Incantatrice statique d\'Izzet inflige 1 blessure à une créature ciblée et à chaque autre créature ayant le même nom que cette créature.", \'type\': \'Créature : humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356183&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7f9135da-08c7-412d-aa9d-a6891184a1e8\', \'multiverseId\': 356183}, \'multiverseid\': 356183}, {\'name\': \'Statincantatrice Izzet\', \'text\': \'Lampo (Puoi lanciare questa magia in ogni momento in cui potresti lanciare un istantaneo.)\\nRapidità\\n{T}: La Statincantatrice Izzet infligge 1 danno a una creatura bersaglio e a ogni altra creatura con lo stesso nome di quella creatura.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356457&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6362086c-559f-408c-a78c-4e17f57994b1\', \'multiverseId\': 356457}, \'multiverseid\': 356457}, {\'name\': \'イゼットの静電術師\', \'text\': \'瞬速（あなたはこの呪文を、あなたがインスタントを唱えられるときならいつでも唱えてよい。）\\n速攻\\n{T}：クリーチャー１体を対象とする。イゼットの静電術師は、それ、およびそれと同じ名前を持つ他の各クリーチャーにそれぞれ１点のダメージを与える。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356731&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6c99489f-cf1b-4204-b48d-06b1315e3a48\', \'multiverseId\': 356731}, \'multiverseid\': 356731}, {\'name\': \'이젯 정전기술사\', \'text\': \'섬광 (순간마법을 발동할 수 있는 시기라면 당신은 이 주문을 언제든지 발동할 수 있다.)\\n신속\\n{T}: 생물 한 개를 목표로 정한다. 이젯 정전기술사는 그 생물 및 그 생물과 같은 이름을 가진 다른 생물 각각에게 피해 1점을 입힌다.\', \'type\': \'생물 — 인간 마법사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357553&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'322aa331-794a-4702-a209-8c39f2ea06c8\', \'multiverseId\': 357553}, \'multiverseid\': 357553}, {\'name\': \'Estatimago Izzet\', \'text\': \'Lampejo (Você poderá conjurar esta mágica a qualquer momento em que puder conjurar uma mágica instantânea.)\\nÍmpeto\\n{T}: Estatimago Izzet causa 1 ponto de dano à criatura alvo e a cada outra criatura com o mesmo nome que aquela criatura.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357005&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c116d02c-54a3-4d71-9534-33840bab9a93\', \'multiverseId\': 357005}, \'multiverseid\': 357005}, {\'name\': \'Электростатик Иззетов\', \'text\': \'Миг (Вы можете разыграть это заклинание при любой возможности разыгрывать мгновенные заклинания.)\\nУскорение\\n{T}: Электростатик Иззетов наносит 1 повреждение целевому существу и каждому другому существу с таким же именем, что и у того существа.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355361&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'33506f78-08af-4bbf-8677-8506d56fb8d1\', \'multiverseId\': 355361}, \'multiverseid\': 355361}, {\'name\': \'伊捷静电法师\', \'text\': \'闪现（你可以于你能够施放瞬间的时机下施放此咒语。）\\n敏捷\\n{T}：伊捷静电法师对目标生物和与该生物同名的其它生物各造成1点伤害。\', \'type\': \'生物～人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357279&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0f22b508-8489-403d-a1a6-8aab4aad5e1e\', \'multiverseId\': 357279}, \'multiverseid\': 357279}, {\'name\': \'伊捷靜電法師\', \'text\': \'閃現（你可以於你能夠施放瞬間的時機下施放此咒語。）\\n敏捷\\n{T}：伊捷靜電法師對目標生物和與該生物同名的其它生物各造成1點傷害。\', \'type\': \'生物～人類／魔法師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355635&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2045f896-4746-4e09-9234-f677fca35776\', \'multiverseId\': 355635}, \'multiverseid\': 355635}]', '[{\'name\': \'Izzet-Runenschlüssel\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {U} oder {R}.\\n{U}{R}: Der Izzet-Runenschlüssel wird bis zum Ende des Zuges zu einer 2/1 blauen und roten Elementarwesen-Artefaktkreatur.\\nImmer wenn der Izzet-Runenschlüssel einem Spieler Kampfschaden zufügt, kannst du eine Karte ziehen. Falls du dies tust, wirf eine Karte aus deiner Hand ab.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355966&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b5b7f427-3376-4510-871a-df995cb18c0a\', \'multiverseId\': 355966}, \'multiverseid\': 355966}, {\'name\': \'Llave rúnica ízzet\', \'text\': \'{T}: Agrega {U} o {R} a tu reserva de maná.\\n{U}{R}: Hasta el final del turno, la Llave rúnica ízzet se convierte en una criatura artefacto Elemental azul y roja 2/1.\\nSiempre que la Llave rúnica ízzet haga daño de combate a un jugador, puedes robar una carta. Si lo haces, descarta una carta.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365688&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'36123606-d948-4213-afc1-d302afd7497a\', \'multiverseId\': 365688}, \'multiverseid\': 365688}, {\'name\': "Runeclé d\'Izzet", \'text\': "{T} : Ajoutez {U} ou {R} à votre réserve.\\n{U}{R}: Jusqu\'à la fin du tour, la Runeclé d\'Izzet devient une créature-artefact 2/1 bleue et rouge Élémental.\\nÀ chaque fois que la Runeclé d\'Izzet inflige des blessures de combat à un joueur, vous pouvez piocher une carte. Si vous faites ainsi, défaussez-vous d\'une carte.", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356240&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ceeb9f5f-173a-41bf-91e8-f68390dfaa58\', \'multiverseId\': 356240}, \'multiverseid\': 356240}, {\'name\': \'Runachiave Izzet\', \'text\': \'{T}: Aggiungi {U} o {R} alla tua riserva di mana.\\n{U}{R}: Fino alla fine del turno, la Runachiave Izzet diventa una creatura artefatto Elementale 2/1 blu e rossa.\\nOgniqualvolta la Runachiave Izzet infligge danno da combattimento a un giocatore, puoi pescare una carta. Se lo fai, scarta una carta.\', \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356514&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4b683e75-88e2-4c8c-87f8-092dfc3cc0d6\', \'multiverseId\': 356514}, \'multiverseid\': 356514}, {\'name\': \'イゼットの魔鍵\', \'text\': \'{T}：あなたのマナ・プールに{U}か{R}を加える。\\n{U}{R}：イゼットの魔鍵はターン終了時まで、青であり赤である２/１のエレメンタル・アーティファクト・クリーチャーになる。\\nイゼットの魔鍵がいずれかのプレイヤーに戦闘ダメージを与えるたび、あなたはカードを１枚引いてもよい。そうした場合、カードを１枚捨てる。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356788&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1ed385ed-915b-4eeb-b97e-0e8d9af186d8\', \'multiverseId\': 356788}, \'multiverseid\': 356788}, {\'name\': \'이젯 열쇠룬\', \'text\': \'{T}: {U} 또는 {R}를 당신의 마나풀에 담는다.\\n{U}{R}: 턴종료까지, 이젯 열쇠룬은 2/1 청색 및 적색 정령 마법물체 생물이 된다.\\n이젯 열쇠룬이 플레이어에게 전투피해를 입힐 때마다, 당신은 카드 한 장을 뽑을 수 있다. 그렇게 한다면, 카드 한 장을 버린다.\', \'type\': \'마법물체\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357610&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2bc8c488-4f02-4583-815b-02eea9de5722\', \'multiverseId\': 357610}, \'multiverseid\': 357610}, {\'name\': \'Chave Rúnica Izzet\', \'text\': \'{T}: Adicione {U} ou {R} à sua reserva de mana.\\n{U}{R}: Até o final do turno, Chave Rúnica Izzet torna-se uma criatura artefato azul e vermelha 2/1 do tipo Elemental.\\nToda vez que Chave Rúnica Izzet causa dano de combate a um jogador, você pode comprar um card. Se fizer isso, descarte um card.\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357062&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2c0289d7-d129-490f-9106-a2e19ce853b1\', \'multiverseId\': 357062}, \'multiverseid\': 357062}, {\'name\': \'Рунный Ключ Иззетов\', \'text\': \'{T}: добавьте {U} или {R} в ваше хранилище маны.\\n{U}{R}: до конца хода Рунный Ключ Иззетов становится артефактным существом 2/1 синий и красный Элементаль.\\nКаждый раз, когда Рунный Ключ Иззетов наносит боевые повреждения игроку, вы можете взять карту. Если вы это делаете, сбросьте карту.\', \'type\': \'Артефакт\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355418&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cfd86e7e-7026-4aae-801a-c02d9912bf3c\', \'multiverseId\': 355418}, \'multiverseid\': 355418}, {\'name\': \'伊捷符镇兵\', \'text\': \'{T}：加{U}或{R}到你的法术力池中。\\n{U}{R}：直到回合结束，伊捷符镇兵成为2/1蓝红双色的元素神器生物。\\n每当伊捷符镇兵对一位牌手造成战斗伤害时，你可以抓一张牌。若你如此作，则弃一张牌。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357336&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0af5c772-9f1b-4346-b94f-77551095a0b7\', \'multiverseId\': 357336}, \'multiverseid\': 357336}, {\'name\': \'伊捷符鎮兵\', \'text\': \'{T}：加{U}或{R}到你的魔法力池中。\\n{U}{R}：直到回合結束，伊捷符鎮兵成為2/1藍紅雙色的元素神器生物。\\n每當伊捷符鎮兵對一位玩家造成戰鬥傷害時，你可以抽一張牌。若你如此作，則棄一張牌。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355692&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'65753ced-d6e2-47c9-9745-c1a07d061a08\', \'multiverseId\': 355692}, \'multiverseid\': 355692}]', '[{\'name\': \'Jace der Gedankenarchitekt\', \'text\': \'+1: Immer wenn bis zu deinem nächsten Zug eine Kreatur angreift, die ein Gegner kontrolliert, erhält sie -1/-0 bis zum Ende des Zuges.\\n-2: Decke die obersten drei Karten deiner Bibliothek auf. Ein Gegner teilt diese Karten auf zwei Haufen auf. Nimm die Karten des einen Haufens auf deine Hand und lege die anderen in beliebiger Reihenfolge unter deine Bibliothek.\\n-8: Durchsuche für jeden Spieler dessen Bibliothek nach einer Karte, die kein Land ist, und schicke sie ins Exil; dieser Spieler mischt dann seine Bibliothek. Du kannst diese Karten wirken, ohne ihre Manakosten zu bezahlen.\', \'type\': \'Planeswalker — Jace\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355780&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'360898f7-95f3-4897-9a59-71daa8ff438a\', \'multiverseId\': 355780}, \'multiverseid\': 355780}, {\'name\': \'Jace, arquitecto del pensamiento\', \'text\': \'+1: Hasta tu próximo turno, siempre que una criatura que controle un oponente ataque, obtiene -1/-0 hasta el final del turno.\\n-2: Muestra las primeras tres cartas de tu biblioteca. Un oponente separa esas cartas en dos montones. Pon uno de los montones en tu mano y el otro en el fondo de tu biblioteca en cualquier orden.\\n-8: Por cada jugador, busca en la biblioteca de ese jugador una carta que no sea tierra y exíliala, luego ese jugador baraja su biblioteca. Puedes lanzar esas cartas sin pagar sus costes de maná.\', \'type\': \'Planeswalker — Jace\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365502&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f5c00628-e14e-434b-b1f5-1d2f5d161c68\', \'multiverseId\': 365502}, \'multiverseid\': 365502}, {\'name\': \'Jace, architecte des pensées\', \'text\': "+1 : Jusqu\'à votre prochain tour, à chaque fois qu\'une créature qu\'un adversaire contrôle attaque, elle gagne -1/-0 jusqu\'à la fin du tour.\\n-2 : Révélez les trois cartes du dessus de votre bibliothèque. Un adversaire sépare ces cartes en deux tas. Mettez l\'un d\'eux dans votre main et l\'autre au-dessous de votre bibliothèque, dans l\'ordre de votre choix.\\n-8 : Pour chaque joueur, cherchez dans la bibliothèque de ce joueur une carte non-terrain et exilez-la, puis ce joueur mélange sa bibliothèque. Vous pouvez lancer ces cartes sans payer leur coût de mana.", \'type\': \'Planeswalker : Jace\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356054&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0b70d0fb-6670-4130-9c8c-5d2212dd83b1\', \'multiverseId\': 356054}, \'multiverseid\': 356054}, {\'name\': \'Jace, Architetto del Pensiero\', \'text\': "+1: Fino al tuo prossimo turno, ogniqualvolta una creatura controllata da un avversario attacca, prende -1/-0 fino alla fine del turno.\\n-2: Rivela le prime tre carte del tuo grimorio. Un avversario separa quelle carte in due pile. Aggiungi una pila alla tua mano e metti l\'altra in fondo al tuo grimorio in qualsiasi ordine.\\n-8: Per ogni giocatore, passa in rassegna il suo grimorio per una carta non terra ed esiliala, poi quel giocatore rimescola il suo grimorio. Puoi lanciare le carte esiliate in questo modo senza pagare il loro costo di mana.", \'type\': \'Planeswalker — Jace\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356328&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0daf033c-c2e1-438c-98be-fea6bae1c510\', \'multiverseId\': 356328}, \'multiverseid\': 356328}, {\'name\': \'思考を築く者、ジェイス\', \'text\': \'＋１：あなたの次のターンまで、対戦相手１人がコントロールするクリーチャー１体が攻撃するたび、それはターン終了時まで－１/－０の修整を受ける。\\n－２：あなたのライブラリーの一番上から３枚のカードを公開する。対戦相手１人は、それらのカードを２つの束に分ける。一方の束をあなたの手札に加え、もう一方をあなたのライブラリーの一番下に望む順番で置く。\\n－８：プレイヤー１人につき、そのプレイヤーのライブラリーから土地でないカードを１枚探してそれを追放する。その後そのプレイヤーは自分のライブラリーを切り直す。あなたはそれらのカードを、マナ・コストを支払うことなく唱えてもよい。\', \'type\': \'プレインズウォーカー — ジェイス\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356602&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0b995c2f-aa99-4013-b684-9373cdbe7fbd\', \'multiverseId\': 356602}, \'multiverseid\': 356602}, {\'name\': \'생각의 설계자 제이스\', \'text\': \'+1: 당신의 다음 턴이 될 때까지, 상대가 조종하는 생물이 공격할 때마다, 그 생물은 턴종료까지 -1/-0을 받는다.\\n-2: 당신의 서고 맨 위의 카드 세 장을 공개한다. 한 상대가 이렇게 공개된 카드를 두 더미로 나눈다. 한 더미는 당신의 손으로 가져가고, 다른 더미는 당신의 서고 맨 밑에 원하는 순서로 놓는다.\\n-8: 각 플레이어의 서고에서 대지가 아닌 카드 한 장을 찾아 추방한다. 그러고 나서 그 플레이어들은 자신의 서고를 섞는다. 당신은 그 카드들을 마나비용의 지불 없이 발동할 수 있다.\', \'type\': \'플레인즈워커 — - 제이스\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357424&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7a3b282e-33cd-44e2-864a-c09c88988992\', \'multiverseId\': 357424}, \'multiverseid\': 357424}, {\'name\': \'Jace, Arquiteto do Pensamento\', \'text\': \'+1: Até seu próximo turno, toda vez que uma criatura que um oponente controla ataca, ela recebe -1/-0 até o final do turno.\\n-2: Revele os três cards do topo de seu grimório. Um oponente separa aqueles cards em dois montes. Coloque um deles na sua mão e o outro no fundo do seu grimório em qualquer ordem.\\n-8: Para cada jogador, procure um card que não seja um terreno no grimório dele e exile-o. Depois, aquele jogador embaralha o próprio grimório. Você pode conjurar esses cards sem pagar seus custos de mana.\', \'type\': \'Planeswalker — Jace\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356876&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8e1c0a91-0b31-488f-8ce4-56cba35c4a74\', \'multiverseId\': 356876}, \'multiverseid\': 356876}, {\'name\': \'Джейс, Архитектор Мысли\', \'text\': \'+1: до вашего следующего хода каждый раз, когда находящееся под контролем оппонента существо атакует, оно получает -1/-0 до конца хода.\\n-2: покажите три верхние карты вашей библиотеки. Оппонент делит те карты на две стопки. Положите одну стопку в вашу руку, а другую — в низ вашей библиотеки в любом порядке.\\n-8: для каждого игрока, найдите в библиотеке того игрока не являющуюся землей карту и изгоните ее, затем тот игрок тасует свою библиотеку. Вы можете разыграть те карты без уплаты их мана-стоимости.\', \'type\': \'Planeswalker — Джейс\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355232&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'eaa8eeb6-f32e-4384-9497-af1ed2abf7f8\', \'multiverseId\': 355232}, \'multiverseid\': 355232}, {\'name\': \'筑念师杰斯\', \'text\': \'+1：直到你的下一个回合，每当任一个由对手操控的生物攻击时，它得-1/-0直到回合结束。\\n-2：展示你牌库顶的三张牌。由任一对手将它们分成两堆。将其中一堆置于你手上，另一堆则以任意顺序置于你的牌库底。\\n-8：对每位牌手而言，你从该牌手的牌库中搜寻一张非地牌并将它放逐，然后该牌手将其牌库洗牌。你可以施放这些牌，且不需支付其法术力费用。\', \'type\': \'鹏洛客～杰斯\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357150&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2c7d4b08-ca13-4f7d-8bc3-781b21672db0\', \'multiverseId\': 357150}, \'multiverseid\': 357150}, {\'name\': \'築念師傑斯\', \'text\': \'+1：直到你的下一個回合，每當任一個由對手操控的生物攻擊時，它得-1/-0直到回合結束。\\n-2：展示你牌庫頂的三張牌。由任一對手將它們分成兩堆。將其中一堆置於你手上，另一堆則以任意順序置於你的牌庫底。\\n-8：對每位玩家而言，你從該玩家的牌庫中搜尋一張非地牌並將它放逐，然後該玩家將其牌庫洗牌。你可以施放這些牌，且不需支付其魔法力費用。\', \'type\': \'鵬洛客～傑斯\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355506&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b34a8bfb-76a4-43f0-8af9-11d58aebd82e\', \'multiverseId\': 355506}, \'multiverseid\': 355506}]', '[{\'name\': \'Jarad, Lichfürst der Golgari\', \'text\': \'Jarad, Lichfürst der Golgari, erhält +1/+1 für jede Kreaturenkarte in deinem Friedhof.\\n{1}{B}{G}, opfere eine andere Kreatur: Jeder Gegner verliert so viele Lebenspunkte, wie die Stärke der geopferten Kreatur beträgt.\\nOpfere einen Sumpf und einen Wald: Bringe Jarad aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Legendäre Kreatur — Zombie, Elf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355910&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cda2e459-b779-4dc1-8157-58c0d9953ccd\', \'multiverseId\': 355910}, \'multiverseid\': 355910}, {\'name\': \'Jarad, señor liche golgari\', \'text\': \'Jarad, señor liche golgari obtiene +1/+1 por cada carta de criatura en tu cementerio.\\n{1}{B}{G}, sacrificar otra criatura: Cada oponente pierde una cantidad de vidas igual a la fuerza de la criatura sacrificada.\\nSacrificar un pantano y un bosque: Regresa a Jarad de tu cementerio a tu mano.\', \'type\': \'Criatura legendaria — Elfo zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365632&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5d335bd6-a0b5-43a1-8f20-ca44b97c186c\', \'multiverseId\': 365632}, \'multiverseid\': 365632}, {\'name\': \'Jarad, seigneur liche des Golgari\', \'text\': \'Jarad, seigneur liche des Golgari gagne +1/+1 pour chaque carte de créature dans votre cimetière.\\n{1}{B}{G}, sacrifiez une autre créature : Chaque adversaire perd un nombre de points de vie égal à la force de la créature sacrifiée.\\nSacrifiez un marais et une forêt : Renvoyez Jarad depuis votre cimetière dans votre main.\', \'type\': \'Créature légendaire : zombie et elfe\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356184&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6a907ac6-6ca5-42d6-a59b-2c6296e795dc\', \'multiverseId\': 356184}, \'multiverseid\': 356184}, {\'name\': \'Jarad, Signore dei Lich Golgari\', \'text\': "Jarad, Signore dei Lich Golgari prende +1/+1 per ogni carta creatura nel tuo cimitero.\\n{1}{B}{G}, Sacrifica un\'altra creatura: Ogni avversario perde punti vita pari alla forza della creatura sacrificata.\\nSacrifica una Palude e una Foresta: Riprendi in mano Jarad dal tuo cimitero.", \'type\': \'Creatura Leggendaria — Elfo Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356458&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0dfde116-e2ef-49d6-b925-0bd91beef370\', \'multiverseId\': 356458}, \'multiverseid\': 356458}, {\'name\': \'ゴルガリの死者の王、ジャラド\', \'text\': \'ゴルガリの死者の王、ジャラドは、あなたの墓地にあるクリーチャー・カード１枚につき＋１/＋１の修整を受ける。\\n{1}{B}{G}, 他のクリーチャー１体を生け贄に捧げる：各対戦相手はそれぞれ生け贄に捧げられたクリーチャーのパワーに等しい点数のライフを失う。\\n沼１つと森１つを生け贄に捧げる：ゴルガリの死者の王、ジャラドをあなたの墓地からあなたの手札に戻す。\', \'type\': \'伝説のクリーチャー — ゾンビ・エルフ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356732&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'03dc357b-3add-4fa4-967b-0d1a082decb6\', \'multiverseId\': 356732}, \'multiverseid\': 356732}, {\'name\': \'골가리의 리치 군주 자라드\', \'text\': \'골가리의 리치 군주 자라드는 당신의 무덤에 있는 생물 카드 한 장당 +1/+1을 받는다.\\n{1}{B}{G}, 다른 생물 한 개를 희생한다: 각 상대는 희생된 생물의 공격력만큼 생명점을 잃는다.\\n늪 한 개와 숲 한 개를 희생한다: 자라드를 당신의 무덤에서 당신의 손으로 되돌린다.\', \'type\': \'전설적 생물 — 좀비 엘프\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357554&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'47cddc43-3ebd-483c-a3df-8b2a37727637\', \'multiverseId\': 357554}, \'multiverseid\': 357554}, {\'name\': \'Jarad, Senhor Lich dos Golgari\', \'text\': \'Jarad, Senhor Lich dos Golgari, recebe +1/+1 para cada card de criatura em seu cemitério.\\n{1}{B}{G}, Sacrifique outra criatura: Cada oponente perde uma quantidade de pontos de vida igual ao poder da criatura sacrificada.\\nSacrifique um Pântano e uma Floresta: Devolva Jarad do seu cemitério para a sua mão.\', \'type\': \'Criatura Lendária — Zumbi Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357006&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'52951733-fe71-4f01-86c7-7d6002365a39\', \'multiverseId\': 357006}, \'multiverseid\': 357006}, {\'name\': \'Джарад, Лорд-Лич Голгари\', \'text\': \'Джарад, Лорд-Лич Голгари получает +1/+1 за каждую карту существа на вашем кладбище.\\n{1}{B}{G}, пожертвуйте другое существо: каждый оппонент теряет количество жизней, равное силе пожертвованного существа.\\nПожертвуйте Болото и Лес: верните Джарада из вашего кладбища в вашу руку.\', \'type\': \'Легендарное Существо — Зомби Эльф\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355362&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c5efd55d-eade-410f-91d8-02cd1a394f36\', \'multiverseId\': 355362}, \'multiverseid\': 355362}, {\'name\': \'葛加理巫妖领主贾雷\', \'text\': \'你坟墓场中每有一张生物牌，葛加理巫妖领主贾雷便得+1/+1。\\n{1}{B}{G}，牺牲另一个生物：每位对手失去若干生命，其数量等同于所牺牲之生物的力量。\\n牺牲一个沼泽和一个树林：将贾雷从你的坟墓场移回你手上。\', \'type\': \'传奇生物～灵俑／妖精\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357280&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'10701318-3008-46a6-a689-5277348d47df\', \'multiverseId\': 357280}, \'multiverseid\': 357280}, {\'name\': \'葛加理巫妖領主賈雷\', \'text\': \'你墳墓場中每有一張生物牌，葛加理巫妖領主賈雷便得+1/+1。\\n{1}{B}{G}，犧牲另一個生物：每位對手失去若干生命，其數量等同於所犧牲之生物的力量。\\n犧牲一個沼澤和一個樹林：將賈雷從你的墳墓場移回你手上。\', \'type\': \'傳奇生物～殭屍／妖精\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355636&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3aba90d5-c35e-420c-9334-a21a450054ed\', \'multiverseId\': 355636}, \'multiverseid\': 355636}]', '[{\'name\': \'Jarads Befehle\', \'text\': \'Durchsuche deine Bibliothek nach bis zu zwei Kreaturenkarten und zeige diese offen vor. Nimm eine davon auf deine Hand und lege die andere auf deinen Friedhof. Mische danach deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': \'„Die Izzet suchen etwas. Finde heraus, was es ist, und wenn es dich das Leben kostet."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355911&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f3be8ab5-faec-42a9-8873-5df6fdd4e25b\', \'multiverseId\': 355911}, \'multiverseid\': 355911}, {\'name\': \'Órdenes de Jarad\', \'text\': \'Busca en tu biblioteca hasta dos cartas de criatura y muéstralas. Pon una en tu mano y la otra en tu cementerio. Luego baraja tu biblioteca.\', \'type\': \'Conjuro\', \'flavor\': \'"Los ízzet están buscando algo. Averigüen qué es o mueran en el intento."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365633&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0f84553c-66f3-476a-aae2-4e149230f20d\', \'multiverseId\': 365633}, \'multiverseid\': 365633}, {\'name\': \'Ordres de Jarad\', \'text\': "Cherchez jusqu\'à deux cartes de créature dans votre bibliothèque et révélez-les. Mettez l\'une d\'elles dans votre main et l\'autre dans votre cimetière. Mélangez ensuite votre bibliothèque.", \'type\': \'Rituel\', \'flavor\': \'« Les Izzet cherchent quelque chose. Trouvez quoi, quitte à en mourir. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356185&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e5d368d1-cb65-4530-9353-6ba6111514dc\', \'multiverseId\': 356185}, \'multiverseid\': 356185}, {\'name\': \'Ordini di Jarad\', \'text\': "Passa in rassegna il tuo grimorio per trovare fino a due carte creatura e rivelale. Aggiungine una alla tua mano e metti l\'altra nel tuo cimitero. Poi rimescola il tuo grimorio.", \'type\': \'Stregoneria\', \'flavor\': \'"Gli Izzet stanno cercando qualcosa. Scopri cosa, anche a costo della vita."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356459&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0e5e1161-52c6-46fc-8a06-e368101ac57d\', \'multiverseId\': 356459}, \'multiverseid\': 356459}, {\'name\': \'ジャラドの命令\', \'text\': \'あなたのライブラリーからクリーチャー・カードを最大２枚まで探し、それらを公開する。そのうち１枚をあなたの手札に加え、もう一方をあなたの墓地に置く。その後あなたのライブラリーを切り直す。\', \'type\': \'ソーサリー\', \'flavor\': \'「イゼット団は何かを探している。突き止めろ。何があってもだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356733&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7ce1f470-52f3-4953-a1e2-41de56080aa6\', \'multiverseId\': 356733}, \'multiverseid\': 356733}, {\'name\': \'자라드의 명령\', \'text\': \'당신의 서고에서 최대 두 장까지의 생물 카드를 찾은 후 공개한다. 그 중 한 장은 당신의 손으로 가져가고 다른 한 장은 당신의 무덤에 넣는다. 그러고 나서 당신의 서고를 섞는다.\', \'type\': \'집중마법\', \'flavor\': \'"이젯 녀석들이 뭔가를 찾고 있다. 목숨을 걸고 그것이 뭔지 알아내라."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357555&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'11469fcf-b057-4fb8-925e-6bcd6c2cdb6d\', \'multiverseId\': 357555}, \'multiverseid\': 357555}, {\'name\': \'Ordens de Jarad\', \'text\': \'Procure em seu grimório até dois cards de criatura e revele-os. Coloque um em sua mão e o outro em seu cemitério. Depois, embaralhe seu grimório.\', \'type\': \'Feitiço\', \'flavor\': \'"Os Izzet estão procurando alguma coisa. Descubram o que é ou morram tentando."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357007&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5773a408-8627-405d-891f-a9a0957bdb08\', \'multiverseId\': 357007}, \'multiverseid\': 357007}, {\'name\': \'Приказы Джарада\', \'text\': \'Найдите в вашей библиотеке не более двух карт существ и покажите их. Положите одну из них в вашу руку, а другую — на ваше кладбище. Затем перетасуйте вашу библиотеку.\', \'type\': \'Волшебство\', \'flavor\': \'«Иззеты явно что-то ищут. Узнайте, что именно... или умрите, пытаясь узнать».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355363&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6e48b9f0-5541-4cc9-a4b9-318ef97d9e20\', \'multiverseId\': 355363}, \'multiverseid\': 355363}, {\'name\': \'贾雷的号令\', \'text\': \'从你的牌库中搜寻至多两张生物牌并展示之。将其中一张置于你手上，另一张置于你的坟墓场。然后将你的牌库洗牌。\', \'type\': \'法术\', \'flavor\': \'「伊捷联盟正在搜寻某样东西。死都要给我搞清楚。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357281&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bd8fab57-ca33-434a-b7db-39f69a29880d\', \'multiverseId\': 357281}, \'multiverseid\': 357281}, {\'name\': \'賈雷的號令\', \'text\': \'從你的牌庫中搜尋至多兩張生物牌並展示之。將其中一張置於你手上，另一張置於你的墳墓場。然後將你的牌庫洗牌。\', \'type\': \'巫術\', \'flavor\': \'「伊捷聯盟正在搜尋某樣東西。死都要給我搞清楚。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355637&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7e86f38e-12bc-47c7-8a3c-1e510c193610\', \'multiverseId\': 355637}, \'multiverseid\': 355637}]', "[{'name': 'Kanalisationsschlurfer', 'text': 'Sumpftarnung (Diese Kreatur ist unblockbar, solange der verteidigende Spieler einen Sumpf kontrolliert.)\\nAusplündern {2}{B} ({2}{B}, schicke diese Karte aus deinem Friedhof ins Exil: Lege so viele +1/+1-Marken, wie die Stärke dieser Karte beträgt, auf eine Kreatur deiner Wahl. Spiele Ausplündern wie eine Hexerei.)', 'type': 'Kreatur — Zombie', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355811&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd09bca3b-6d24-4d5d-9776-66bbc7b9785c', 'multiverseId': 355811}, 'multiverseid': 355811}, {'name': 'Desollador de alcantarilla', 'text': 'Cruza pantanos. (Esta criatura es imbloqueable mientras el jugador defensor controle un pantano.)\\nCarroñar {2}{B}. ({2}{B}, exiliar esta carta de tu cementerio: Pon sobre la criatura objetivo una cantidad de contadores +1/+1 igual a la fuerza de esta carta. Activa la habilidad de carroñar como un conjuro.)', 'type': 'Criatura — Zombie', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365533&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '398f8bb8-bd25-4cad-855c-8208410366b9', 'multiverseId': 365533}, 'multiverseid': 365533}, {'name': 'Escogriffe des égouts', 'text': 'Traversée des marais (Cette créature est imblocable tant que le joueur défenseur contrôle au moins un marais.)\\nRécupération {2}{B} ({2}{B}, exilez cette carte de votre cimetière : Mettez un nombre de marqueurs +1/+1 égal à la force de cette carte sur une créature ciblée. Ne récupérez que lorsque vous pourriez lancer un rituel.)', 'type': 'Créature : zombie', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356085&type=card', 'language': 'French', 'identifiers': {'scryfallId': '4745a880-0d5d-46c6-b0f1-b76923aab45c', 'multiverseId': 356085}, 'multiverseid': 356085}, {'name': 'Errante delle Fogne', 'text': 'Passa-Paludi (Questa creatura non può essere bloccata fintanto che il giocatore in difesa controlla una Palude.)\\nMangiacarogne {2}{B} ({2}{B}, Esilia questa carta dal tuo cimitero: Metti un numero di segnalini +1/+1 pari alla forza di questa carta su una creatura bersaglio. Attiva mangiacarogne solo quando potresti lanciare una stregoneria.)', 'type': 'Creatura — Zombie', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356359&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a5abfdc6-66d0-4b6d-ac5f-40a9166992a8', 'multiverseId': 356359}, 'multiverseid': 356359}, {'name': '下水のシャンブラー', 'text': '沼渡り（このクリーチャーは防御プレイヤーが沼をコントロールしているかぎりブロックされない。）\\n活用 {2}{B} （{2}{B}, このカードをあなたの墓地から追放する：クリーチャー１体を対象とし、それの上にこのカードのパワーに等しい数の＋１/＋１カウンターを置く。活用はソーサリーとしてのみ行う。）', 'type': 'クリーチャー — ゾンビ', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356633&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'dadf05ec-d414-4874-b6b3-b40a809b1751', 'multiverseId': 356633}, 'multiverseid': 356633}, {'name': '어기적거리는 하수구 좀비', 'text': '늪잠입 (수비플레이어가 늪을 조종하는 한, 이 생물은 방어될 수 없다.)\\n섭취 {2}{B} ({2}{B}, 당신의 무덤에서 이 카드를 추방한다: 생물 한 개를 목표로 정한다. 이 카드의 공격력만큼의 +1/+1 카운터를 그 생물에 올려놓는다. 당신이 집중마법을 발동할 수 있는 시기에만 섭취 능력을 활성화할 수 있다.)', 'type': '생물 — 좀비', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357455&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '5d7d06fe-0f53-40df-a9c9-d20f8cfd7806', 'multiverseId': 357455}, 'multiverseid': 357455}, {'name': 'Trôpego do Esgoto', 'text': 'Travessia de pântano (Esta criatura não poderá ser bloqueada enquanto o jogador defensor controlar um Pântano.)\\nNecrofagia {2}{B} ({2}{B}, Exile este card de seu cemitério: Coloque uma quantidade de marcadores +1/+1 igual ao poder deste card na criatura alvo. Use necrofagia somente quando puder conjurar um feitiço.)', 'type': 'Criatura — Zumbi', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356907&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '900bee2c-b3cb-44cc-9401-644a0a913778', 'multiverseId': 356907}, 'multiverseid': 356907}, {'name': 'Канализационный Шатун', 'text': 'Знание Болот (Это существо не может быть заблокировано, пока защищающийся игрок контролирует Болото.)\\nУтилизация {2}{B} ({2}{B}, изгоните эту карту из вашего кладбища: положите на целевое существо жетоны +1/+1, количество которых равно силе этой карты. Утилизируйте только как волшебство.)', 'type': 'Существо — Зомби', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355263&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '3b1f5651-f243-48ee-9486-25e7338df0e8', 'multiverseId': 355263}, 'multiverseid': 355263}, {'name': '暗渠跛行兽', 'text': '沼泽行者（只要防御牌手操控沼泽，此生物便不能被阻挡。）\\n食腐{2}{B}（{2}{B}，从你的坟墓场放逐此牌：在目标生物上放置若干+1/+1指示物，其数量等同于此牌的力量。食腐的时机视同法术。）', 'type': '生物～灵俑', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357181&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '7b113b7c-655f-403a-a9ef-62ecfbc8384b', 'multiverseId': 357181}, 'multiverseid': 357181}, {'name': '暗渠跛行獸', 'text': '沼澤行者（只要防禦玩家操控沼澤，此生物便不能被阻擋。）\\n食腐{2}{B}（{2}{B}，從你的墳墓場放逐此牌：在目標生物上放置若干+1/+1指示物，其數量等同於此牌的力量。食腐的時機視同巫術。）', 'type': '生物～殭屍', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355537&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'd0811c00-8f82-44ea-854c-befba718ae1b', 'multiverseId': 355537}, 'multiverseid': 355537}]", '[{\'name\': \'Katakombenschnecke\', \'type\': \'Kreatur — Schnecke\', \'flavor\': \'„Der gesamte Schauplatz des Mordes war von tropfendem, triefendem Schleim bedeckt. Man braucht keinen Wahrsager, um diesen Fall zu lösen." —Pel Javya, Wojek-Ermittler\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355794&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'23fd57bb-ecce-4565-90f8-686792007959\', \'multiverseId\': 355794}, \'multiverseid\': 355794}, {\'name\': \'Babosa de la catacumba\', \'type\': \'Criatura — Babosa\', \'flavor\': \'"Todo el escenario del asesinato rezumaba un fango viscoso. No hace falta un adivino para resolver el caso." —Pel-Javya, investigador wojek\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365516&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9f0a0f84-a4b3-415e-a34d-71450121678b\', \'multiverseId\': 365516}, \'multiverseid\': 365516}, {\'name\': \'Limace des catacombes\', \'type\': \'Créature : limace\', \'flavor\': "« La scène du crime était entièrement recouverte de bave dégoulinante. Pas besoin d\'un augure pour mettre un nom sur l\'assassin. » —Pel Javya, enquêteur wojek", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356068&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'07e14092-2a66-4aa7-ac62-5e7fb3a90e76\', \'multiverseId\': 356068}, \'multiverseid\': 356068}, {\'name\': \'Lumaca delle Catacombe\', \'type\': \'Creatura — Lumaca\', \'flavor\': \'"L\\\'intera scena del delitto era coperta di viscida melma gocciolante. Non c\\\'era certo bisogno di un divinatore per risolvere il caso." —Pel Javya, investigatore Wojek\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356342&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'78bcc66e-7b9d-4a63-b462-fa10f8e9c801\', \'multiverseId\': 356342}, \'multiverseid\': 356342}, {\'name\': \'地下墓地のナメクジ\', \'type\': \'クリーチャー — ナメクジ\', \'flavor\': \'「殺害現場は糸を引く粘液で覆われていた。予言者でなくてもこの謎は解けるだろう。」 ――ウォジェクの調査官、ペール・ジャヴァ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356616&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3f837833-d93f-4435-a5bf-86713c3d008a\', \'multiverseId\': 356616}, \'multiverseid\': 356616}, {\'name\': \'지하무덤 민달팽이\', \'type\': \'생물 — 민달팽이\', \'flavor\': \'"살인 현장 전체가 끈적끈적한 점액으로 뒤덮여 있었다. 점쟁이가 아니어도 여기서 무슨 일이 일어났는지는 짐작이 가겠지." —워젝 수사관 펠 자브야\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357438&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'66681ce0-1602-4363-9d87-acb592003f64\', \'multiverseId\': 357438}, \'multiverseid\': 357438}, {\'name\': \'Lesma de Catacumba\', \'type\': \'Criatura — Lesma\', \'flavor\': \'"A cena do crime inteira estava coberta por uma gosma pegajosa e gotejante. Não havia necessidade de um adivinho para resolver aquele crime." — Pel Javya, investigador Wojek\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356890&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fcaf521a-8bc3-4c5d-8671-a3aa9b305722\', \'multiverseId\': 356890}, \'multiverseid\': 356890}, {\'name\': \'Слизень из Катакомбы\', \'type\': \'Существо — Слизень\', \'flavor\': \'«Место совершения убийства было покрыто мерзкой тягучей слизью. Не нужно было быть пророком, чтобы догадаться». — Пел Джавия, дознаватель Войеков\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355246&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cb5000b0-ecfe-4264-9293-6c5d82e3cb89\', \'multiverseId\': 355246}, \'multiverseid\': 355246}, {\'name\': \'陵墓蛞蝓\', \'type\': \'生物～蛞蝓\', \'flavor\': \'「整个谋杀现场覆盖着一层四处流淌的粘液。谜底显而易见。」 ～沃耶克调查员佩贾亚\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357164&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fcda7384-704c-41f8-972c-d5babb824912\', \'multiverseId\': 357164}, \'multiverseid\': 357164}, {\'name\': \'陵墓蛞蝓\', \'type\': \'生物～蛞蝓\', \'flavor\': \'「整個謀殺現場覆蓋著一層四處流淌的粘液。謎底顯而易見。」 ～沃耶克偵查員佩賈亞\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355520&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'eb823b47-c66c-4cab-8002-829fba465f6e\', \'multiverseId\': 355520}, \'multiverseid\': 355520}]', '[{\'name\': \'Keifende Heimsuchung\', \'text\': \'Falls zu Beginn des Versorgungssegments eines Gegners dieser Spieler eine oder weniger Karten auf der Hand hat, verliert er 3 Lebenspunkte.\', \'type\': \'Verzauberung\', \'flavor\': \'Die Stimme von Gargoylen erreicht Höhen, bei denen Glas zersplittert und Knochen sich krümmen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355812&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5d83b239-9437-4256-9f42-7cc1f564f4df\', \'multiverseId\': 355812}, \'multiverseid\': 355812}, {\'name\': \'Aflicción estridente\', \'text\': \'Al comienzo del mantenimiento de cada oponente, si ese jugador tiene una o menos cartas en su mano, él pierde 3 vidas.\', \'type\': \'Encantamiento\', \'flavor\': \'La voz de una gárgola alcanza tonos que rompen el cristal y deforman los huesos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365534&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8c76bca8-6c35-49e9-b454-45411d27b9fe\', \'multiverseId\': 365534}, \'multiverseid\': 365534}, {\'name\': \'Affliction hurlante\', \'text\': "Au début de l\'entretien de chaque adversaire, si ce joueur a une carte ou moins dans sa main, il perd 3 points de vie.", \'type\': \'Enchantement\', \'flavor\': "La voix d\'une gargouille atteint des fréquences pouvant briser le verre et gauchir l\'os.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356086&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2e33e2c1-d500-45dd-9767-c879df68be35\', \'multiverseId\': 356086}, \'multiverseid\': 356086}, {\'name\': \'Sofferenza Urlante\', \'text\': "All\'inizio del mantenimento di ogni avversario, se quel giocatore ha una o meno carte in mano, perde 3 punti vita.", \'type\': \'Incantesimo\', \'flavor\': \'La voce di un gargoyle raggiunge toni che infrangono il vetro e deformano le ossa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356360&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7b8d00e6-f565-431c-8f5d-599c14e89577\', \'multiverseId\': 356360}, \'multiverseid\': 356360}, {\'name\': \'金切り声の苦悶\', \'text\': \'各対戦相手のアップキープの開始時に、そのプレイヤーの手札にあるカードが１枚以下の場合、そのプレイヤーは３点のライフを失う。\', \'type\': \'エンチャント\', \'flavor\': \'ガーゴイルの声はガラスを砕き骨を歪ませるほどの高音に達する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356634&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b0262d59-7b4e-4e80-a8f3-66d0723f6127\', \'multiverseId\': 356634}, \'multiverseid\': 356634}, {\'name\': \'고통을 부르는 비명\', \'text\': \'각 상대의 유지단 시작에, 그 플레이어의 손에 있는 카드가 한 장 이하면 그 플레이어는 생명 3점을 잃는다.\', \'type\': \'부여마법\', \'flavor\': \'최고조에 도달한 가고일의 목소리는 유리를 부수고 뼈를 뒤틀리게 만든다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357456&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'28aedbfa-1926-47ac-96c7-54ad2bfc6371\', \'multiverseId\': 357456}, \'multiverseid\': 357456}, {\'name\': \'Aflição Berrante\', \'text\': \'No início da manutenção de cada oponente, se aquele jogador tem um card ou menos na mão, ele perde 3 pontos de vida.\', \'type\': \'Encantamento\', \'flavor\': \'A voz de uma gárgula é tão aguda que é capaz de estilhaçar vidros e deformar ossos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356908&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4b660199-81e8-4dd5-97a6-7fff94c81be5\', \'multiverseId\': 356908}, \'multiverseid\': 356908}, {\'name\': \'Вопиющая Несправедливость\', \'text\': \'В начале шага поддержки каждого оппонента, если у того игрока в руке одна или меньше карт, он теряет 3 жизни.\', \'type\': \'Чары\', \'flavor\': \'Голос горгульи берет такие высокие ноты, что с легкостью разбивает стекло и гнет кости.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355264&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7461893e-2a91-46aa-a1ff-c0d7a2ae75ee\', \'multiverseId\': 355264}, \'multiverseid\': 355264}, {\'name\': \'尖鸣折磨\', \'text\': \'在每位对手的维持开始时，若该牌手的手牌为一张或更少，则他失去3点生命。\', \'type\': \'结界\', \'flavor\': \'石像鬼的声音尖锐得足以粉碎玻璃、扭曲骨头。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357182&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'57772ec8-acf9-4854-bf8c-8447c5f47bca\', \'multiverseId\': 357182}, \'multiverseid\': 357182}, {\'name\': \'尖鳴折磨\', \'text\': \'在每位對手的維持開始時，若該玩家的手牌為一張或更少，則他失去3點生命。\', \'type\': \'結界\', \'flavor\': \'石像鬼的聲音尖銳得足以粉碎玻璃、扭曲骨頭。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355538&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0df19ed4-c456-4d0a-b5d0-bbae0f5db5dc\', \'multiverseId\': 355538}, \'multiverseid\': 355538}]', '[{\'name\': \'Kettentänzer vom Bluthaus\', \'text\': \'Entfesselt (Du kannst diese Kreatur mit einer +1/+1-Marke ins Spiel kommen lassen. Sie kann nicht blocken, solange eine +1/+1-Marke auf ihr liegt.)\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': \'Wenn das Schweineblut auf dich tropft, bist du der Nächste an der Kette.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355832&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1324b415-f93d-4b63-8e0f-ecb4f4f171b4\', \'multiverseId\': 355832}, \'multiverseid\': 355832}, {\'name\': \'Caminacadenas de Casa Sangrienta\', \'text\': \'Desatar. (Puedes hacer que esta criatura entre al campo de batalla con un contador +1/+1 sobre ella. No puede bloquear mientras tenga un contador +1/+1 sobre ella.)\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': \'Si la sangre del cerdo te gotea encima, eres el siguiente en la cadena\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365554&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d7ceee2e-a62b-4cdf-8ec1-fd0bf3248cfe\', \'multiverseId\': 365554}, \'multiverseid\': 365554}, {\'name\': \'Marcheur de chaînes de la Halle aux viscères\', \'text\': "Emportement (Vous pouvez faire arriver cette créature sur le champ de bataille avec un marqueur +1/+1 sur elle. Elle ne peut pas bloquer tant qu\'elle a un marqueur +1/+1 sur elle.)", \'type\': \'Créature : humain et guerrier\', \'flavor\': \'Si le sang du goret vous coule dessus, vous serez le prochain à jouer les équilibristes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356106&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c0931c31-2649-4dc6-9be5-bf04ef6a40a8\', \'multiverseId\': 356106}, \'multiverseid\': 356106}, {\'name\': \'Solcacatene della Casa del Sangue\', \'text\': \'Scatenare (Puoi far entrare questa creatura nel campo di battaglia con un segnalino +1/+1. Non può bloccare fintanto che ha un segnalino +1/+1.)\', \'type\': \'Creatura — Guerriero Umano\', \'flavor\': \'Se il sangue del maiale gocciola su di te, sei il prossimo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356380&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bc04ec2c-8b26-4840-b16c-5d11c031616f\', \'multiverseId\': 356380}, \'multiverseid\': 356380}, {\'name\': \'流血の家の鎖歩き\', \'text\': \'解鎖（あなたはこのクリーチャーを、＋１/＋１カウンターが１個置かれた状態で戦場に出してよい。これの上に＋１/＋１カウンターが置かれているかぎり、これではブロックできない。）\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': \'豚の血がお前にかかったのなら、次はお前ということだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356654&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eceeabfc-634d-40a6-b359-cd1bd80fc4cf\', \'multiverseId\': 356654}, \'multiverseid\': 356654}, {\'name\': \'핏덩이 회관의 사슬곡예사\', \'text\': \'속박해제 (당신은 이 생물로 하여금 +1/+1 카운터 한 개를 가지고 전장에 들어오도록 할 수 있다. 이 생물은 +1/+1 카운터를 가지고 있는 한 방어할 수 없다.)\', \'type\': \'생물 — 인간 전사\', \'flavor\': \'흘러내리는 돼지의 피가 묻은 자가 다음으로 사슬을 타야 한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357476&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0fd8e5ec-7fdd-4aa2-a284-7ac949c4b0e2\', \'multiverseId\': 357476}, \'multiverseid\': 357476}, {\'name\': \'Equilibrista de Corrente do Clube da Sangria\', \'text\': \'Liberar (Você pode fazer com que esta criatura entre no campo de batalha com um marcador +1/+1. Ela não poderá bloquear enquanto tiver um marcador +1/+1.)\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': \'Se o sangue do porco respingar em você, você será o próximo na corrente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356928&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dd0ff24a-2b90-429f-8ad3-1e40ea238f12\', \'multiverseId\': 356928}, \'multiverseid\': 356928}, {\'name\': \'Цепеход из Дома Крови\', \'text\': \'Безудержность (Вы можете заставить это существо выйти на поле битвы с жетоном +1/+1 на нем. Оно не может блокировать, пока на нем есть жетон +1/+1.)\', \'type\': \'Существо — Человек Воин\', \'flavor\': \'Если на вас капнет кровь свиньи, значит вы следующий.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355284&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'17baa74e-331d-445b-8c1c-212721b8ab2b\', \'multiverseId\': 355284}, \'multiverseid\': 355284}, {\'name\': \'嗜血屋链行人\', \'text\': \'脱缰（你可以让此生物进战场时上面有一个+1/+1指示物。只要其上有+1/+1指示物，它就不能进行阻挡。）\', \'type\': \'生物～人类／战士\', \'flavor\': \'若猪血滴到你身上，你就是下一个。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357202&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7f27790c-72a4-4a1d-8d8e-9200b68e47ad\', \'multiverseId\': 357202}, \'multiverseid\': 357202}, {\'name\': \'嗜血屋鍊行人\', \'text\': \'脫韁（你可以讓此生物進戰場時上面有一個+1/+1指示物。只要其上有+1/+1指示物，它就不能進行阻擋。）\', \'type\': \'生物～人類／戰士\', \'flavor\': \'若豬血滴到你身上，你就是下一個。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355558&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b1d5ed4c-1d87-4437-8f04-3b9053a040b6\', \'multiverseId\': 355558}, \'multiverseid\': 355558}]', '[{\'name\': \'Klagende Erscheinung\', \'text\': \'Opfere die Klagende Erscheinung: Zerstöre eine Verzauberung deiner Wahl.\', \'type\': \'Kreatur — Geist\', \'flavor\': \'Einige Seelen haben zu großen Schaden davongetragen, um den Orzhov von Nutzen zu sein.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355748&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'69920dce-6a19-4c17-901d-d202c86b3980\', \'multiverseId\': 355748}, \'multiverseid\': 355748}, {\'name\': \'Aparición atormentada\', \'text\': \'Sacrificar la Aparición atormentada: Destruye el encantamiento objetivo.\', \'type\': \'Criatura — Espíritu\', \'flavor\': \'Algunas almas están demasiado dañadas para resultar útiles a los orzhov.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365470&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3ac3c2a2-8a44-4e59-8467-31c667f911ab\', \'multiverseId\': 365470}, \'multiverseid\': 365470}, {\'name\': \'Apparition psalmodiante\', \'text\': "Sacrifiez l\'Apparition psalmodiante : Détruisez l\'enchantement ciblé.", \'type\': \'Créature : esprit\', \'flavor\': "Certaines âmes sont trop abîmées pour être d\'un quelconque usage aux Orzhov.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356022&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d2455b74-e153-43c0-8bb5-508f232142f6\', \'multiverseId\': 356022}, \'multiverseid\': 356022}, {\'name\': \'Apparizione Gemente\', \'text\': "Sacrifica l\'Apparizione Gemente: Distruggi un incantesimo bersaglio.", \'type\': \'Creatura — Spirito\', \'flavor\': \'Alcune anime sono troppo danneggiate per essere di qualche utilità agli Orzhov.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356296&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6dd3742f-44fd-4fb0-94f8-fb8606c995bd\', \'multiverseId\': 356296}, \'multiverseid\': 356296}, {\'name\': \'叫び回る亡霊\', \'text\': \'叫び回る亡霊を生け贄に捧げる：エンチャント１つを対象とし、それを破壊する。\', \'type\': \'クリーチャー — スピリット\', \'flavor\': \'劣化がひどすぎてオルゾフが利用できない魂もある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356570&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'803f314f-68e0-450d-8ff8-3f8141c1e3aa\', \'multiverseId\': 356570}, \'multiverseid\': 356570}, {\'name\': \'비통해하는 유령\', \'text\': \'비통해하는 유령을 희생한다: 부여마법 한 개를 목표로 정한다. 그 부여마법을 파괴한다.\', \'type\': \'생물 — 신령\', \'flavor\': \'오르조브 길드조차도 써먹지 못할만큼 심하게 훼손된 영혼들도 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357392&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0f7736ab-a320-4ae4-bec1-9b8bea645f3d\', \'multiverseId\': 357392}, \'multiverseid\': 357392}, {\'name\': \'Aparição Lamuriante\', \'text\': \'Sacrifique Aparição Lamuriante: Destrua o encantamento alvo.\', \'type\': \'Criatura — Espírito\', \'flavor\': \'Algumas almas estão danificadas demais para serem úteis aos Orzhov.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356844&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0ccee3c7-f505-4fdd-a3f3-b1b2a6c3ebd9\', \'multiverseId\': 356844}, \'multiverseid\': 356844}, {\'name\': \'Голосящее Видение\', \'text\': \'Пожертвуйте Голосящее Видение: уничтожьте целевые чары.\', \'type\': \'Существо — Дух\', \'flavor\': \'Некоторые души настолько испорчены, что не могут послужить Орзовам.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355200&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d560f6a6-05b7-4c6f-a8c4-3c0dbf8de3a0\', \'multiverseId\': 355200}, \'multiverseid\': 355200}, {\'name\': \'哭号幻影\', \'text\': \'牺牲哭号幻影：消灭目标结界。\', \'type\': \'生物～精怪\', \'flavor\': \'有的灵魂伤得太重，连欧佐夫都无法利用。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357118&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d3d7a9d7-3aa6-4e6e-bd58-aa3f629a5a88\', \'multiverseId\': 357118}, \'multiverseid\': 357118}, {\'name\': \'哭號幻影\', \'text\': \'犧牲哭號幻影：消滅目標結界。\', \'type\': \'生物～精靈\', \'flavor\': \'有的靈魂傷得太重，連歐佐夫都無法利用。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355474&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3e325776-a9f0-4cd0-ba53-4dc5c3405805\', \'multiverseId\': 355474}, \'multiverseid\': 355474}]', '[{\'name\': \'Konzentriertes Feuer\', \'text\': \'Immer wenn du einen mehrfarbigen Zauber wirkst, fügt das Konzentrierte Feuer einer Kreatur oder einem Spieler deiner Wahl 2 Schadenspunkte zu.\', \'type\': \'Verzauberung\', \'flavor\': \'„Die Izzet sind wie eine Gleichung, die Irrsinn in Explosionen umwandelt." —Leonos, Schlichter der Azorius\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355839&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a8355b26-08ce-4aa1-8aa1-8ff75adda88f\', \'multiverseId\': 355839}, \'multiverseid\': 355839}, {\'name\': \'Piroconvergencia\', \'text\': \'Siempre que lances un hechizo multicolor, la Piroconvergencia le hace 2 puntos de daño a la criatura o jugador objetivo.\', \'type\': \'Encantamiento\', \'flavor\': \'"Los ízzet son una ecuación que transforma la locura en explosiones." —Leonos, árbitro azorio\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365561&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'acc9b6f4-e493-47bb-ae35-dca72f00828d\', \'multiverseId\': 365561}, \'multiverseid\': 365561}, {\'name\': \'Pyroconvergence\', \'text\': \'À chaque fois que vous lancez un sort multicolore, la Pyroconvergence inflige 2 blessures à une cible, créature ou joueur.\', \'type\': \'Enchantement\', \'flavor\': "« Les Izzet sont une équation qui transforme la démence en explosions. » —Leonos, arbitre d\'Azorius", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356113&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cadfe9bf-4298-4b25-a408-72e8bd503639\', \'multiverseId\': 356113}, \'multiverseid\': 356113}, {\'name\': \'Piroconvergenza\', \'text\': \'Ogniqualvolta lanci una magia multicolore, la Piroconvergenza infligge 2 danni a una creatura o a un giocatore bersaglio.\', \'type\': \'Incantesimo\', \'flavor\': \'"Gli Izzet sono l\\\'equazione che trasforma la pazzia in esplosioni." —Leonos, giudice Azorius\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356387&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e510794f-3d4f-4413-a4ca-8c7ef7f8ce91\', \'multiverseId\': 356387}, \'multiverseid\': 356387}, {\'name\': \'火炎収斂\', \'text\': \'あなたが多色の呪文を１つ唱えるたび、クリーチャー１体かプレイヤー１人を対象とする。火炎収斂はそれに２点のダメージを与える。\', \'type\': \'エンチャント\', \'flavor\': \'「イゼットとは狂気を爆発に変える方程式のことだ。」 ――アゾリウスの調停者、レオノス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356661&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'793e3d7b-f7f0-467b-9954-259a4af9aa88\', \'multiverseId\': 356661}, \'multiverseid\': 356661}, {\'name\': \'화염집결\', \'text\': \'당신이 다색 주문을 발동할 때마다, 생물 한 개 또는 플레이어 한 명을 목표로 정한다. 화염집결은 그 목표에게 피해 2점을 입힌다.\', \'type\': \'부여마법\', \'flavor\': \'"이젯은 광기를 폭발로 전환하는 방정식이다." —아조리우스 재판관 레오노스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357483&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'947198b7-f3e7-4d5f-8261-eda410c0011a\', \'multiverseId\': 357483}, \'multiverseid\': 357483}, {\'name\': \'Piroconvergência\', \'text\': \'Toda vez que você conjura uma mágica multicolorida, Piroconvergência causa 2 pontos de dano à criatura ou jogador alvo.\', \'type\': \'Encantamento\', \'flavor\': \'"Os Izzet são uma equação que transforma a demência em explosões." — Leonos, árbitro Azorius\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356935&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9bbaf2c8-e755-4a6d-9309-25a5abeb74b5\', \'multiverseId\': 356935}, \'multiverseid\': 356935}, {\'name\': \'Пирослияние\', \'text\': \'Каждый раз, когда вы разыгрываете многоцветное заклинание, Пирослияние наносит 2 повреждения целевому существу или игроку.\', \'type\': \'Чары\', \'flavor\': \'«Иззеты — это формула, превращающая безумие во взрывы». — Леонос, судья Азориусов\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355291&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'928fadba-2466-42b6-bec2-11c284aade03\', \'multiverseId\': 355291}, \'multiverseid\': 355291}, {\'name\': \'魔力聚焰\', \'text\': \'每当你施放多色咒语时，魔力聚焰对目标生物或牌手造成2点伤害。\', \'type\': \'结界\', \'flavor\': \'「伊捷联盟是个能将错乱变为爆炸的方程式。」 ～俄佐立仲裁者雷诺兹\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357209&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9352e743-eca7-4313-b812-1c07d24ad28b\', \'multiverseId\': 357209}, \'multiverseid\': 357209}, {\'name\': \'魔力聚焰\', \'text\': \'每當你施放多色咒語時，魔力聚焰對目標生物或玩家造成2點傷害。\', \'type\': \'結界\', \'flavor\': \'「伊捷聯盟是個能將錯亂變為爆炸的方程式。」 ～俄佐立仲裁者雷諾茲\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355565&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e1563edc-27aa-48d3-a493-1e5cae54f7a4\', \'multiverseId\': 355565}, \'multiverseid\': 355565}]', "[{'name': 'Korozda-Bewacher', 'text': 'Verursacht Trampelschaden\\nAusplündern {5}{G}{G} ({5}{G}{G}, schicke diese Karte aus deinem Friedhof ins Exil: Lege so viele +1/+1-Marken, wie die Stärke dieser Karte beträgt, auf eine Kreatur deiner Wahl. Spiele Ausplündern wie eine Hexerei.)', 'type': 'Kreatur — Eidechse', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355865&type=card', 'language': 'German', 'identifiers': {'scryfallId': '08c4cb92-8ff4-4048-b01a-180a053810f4', 'multiverseId': 355865}, 'multiverseid': 355865}, {'name': 'Monitor de Korozda', 'text': 'Arrolla.\\nCarroñar {5}{G}{G}. ({5}{G}{G}, exiliar esta carta de tu cementerio: Pon sobre la criatura objetivo una cantidad de contadores +1/+1 igual a la fuerza de esta carta. Activa la habilidad de carroñar como un conjuro.)', 'type': 'Criatura — Lagarto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365587&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'cdbf369e-538d-47e1-bdc9-47f5942f2de9', 'multiverseId': 365587}, 'multiverseid': 365587}, {'name': 'Surveillant de Korozda', 'text': 'Piétinement\\nRécupération {5}{G}{G} ({5}{G}{G}, exilez cette carte de votre cimetière : Mettez un nombre de marqueurs +1/+1 égal à la force de cette carte sur une créature ciblée. Ne récupérez que lorsque vous pourriez lancer un rituel.)', 'type': 'Créature : lézard', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356139&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'bf6e8c21-7117-4979-b18e-8b4c4f41196d', 'multiverseId': 356139}, 'multiverseid': 356139}, {'name': 'Sorvegliante di Korozda', 'text': 'Travolgere\\nMangiacarogne {5}{G}{G} ({5}{G}{G}, Esilia questa carta dal tuo cimitero: Metti un numero di segnalini +1/+1 pari alla forza di questa carta su una creatura bersaglio. Attiva mangiacarogne solo quando potresti lanciare una stregoneria.)', 'type': 'Creatura — Lucertola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356413&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '8cfc08dc-7221-4f7a-afc6-45a863f7e227', 'multiverseId': 356413}, 'multiverseid': 356413}, {'name': 'コロズダの監視者', 'text': 'トランプル\\n活用 {5}{G}{G} （{5}{G}{G}, このカードをあなたの墓地から追放する：クリーチャー１体を対象とし、それの上にこのカードのパワーに等しい数の＋１/＋１カウンターを置く。活用はソーサリーとしてのみ行う。）', 'type': 'クリーチャー — トカゲ', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356687&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'b46ba80e-ef77-4e59-b926-65d0c336245a', 'multiverseId': 356687}, 'multiverseid': 356687}, {'name': '코로즈다 회관의 감시관', 'text': '돌진\\n섭취 {5}{G}{G} ({5}{G}{G}, 당신의 무덤에서 이 카드를 추방한다: 생물 한 개를 목표로 정한다. 이 카드의 공격력만큼의 +1/+1 카운터를 그 생물에 올려놓는다. 당신이 집중마법을 발동할 수 있는 시기에만 섭취 능력을 활성화할 수 있다.)', 'type': '생물 — 도마뱀', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357509&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '4f6c1ac5-b4b6-452b-8ebc-980fed0cf4d0', 'multiverseId': 357509}, 'multiverseid': 357509}, {'name': 'Monitor Korozda', 'text': 'Atropelar\\nNecrofagia {5}{G}{G} ({5}{G}{G}, Exile este card de seu cemitério: Coloque uma quantidade de marcadores +1/+1 igual ao poder deste card na criatura alvo. Use necrofagia somente quando puder conjurar um feitiço.)', 'type': 'Criatura — Lagarto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356961&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fca2ff9b-1015-44c1-b5e5-5172fd22bb27', 'multiverseId': 356961}, 'multiverseid': 356961}, {'name': 'Варан из Корозды', 'text': 'Пробивной удар\\nУтилизация {5}{G}{G} ({5}{G}{G}, изгоните эту карту из вашего кладбища: положите на целевое существо жетоны +1/+1, количество которых равно силе этой карты. Утилизируйте только как волшебство.)', 'type': 'Существо — Ящер', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355317&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '9ec39ce2-4bba-4af2-81b7-185d9495b20e', 'multiverseId': 355317}, 'multiverseid': 355317}, {'name': '柯罗札监卫', 'text': '践踏\\n食腐{5}{G}{G}（{5}{G}{G}，从你的坟墓场放逐此牌：在目标生物上放置若干+1/+1指示物，其数量等同于此牌的力量。食腐的时机视同法术。）', 'type': '生物～蜥蜴', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357235&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '3d606fa0-9787-4843-a723-1ed479c4f830', 'multiverseId': 357235}, 'multiverseid': 357235}, {'name': '柯羅札監衛', 'text': '踐踏\\n食腐{5}{G}{G}（{5}{G}{G}，從你的墳墓場放逐此牌：在目標生物上放置若干+1/+1指示物，其數量等同於此牌的力量。食腐的時機視同巫術。）', 'type': '生物～蜥蜴', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355591&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'e28a6fa0-5fa1-4a42-b632-0f44f95098d2', 'multiverseId': 355591}, 'multiverseid': 355591}]", '[{\'name\': \'Korozda-Gildenmagier\', \'text\': \'{1}{B}{G}: Eine Kreatur deiner Wahl erhält +1/+1 und Einschüchtern bis zum Ende des Zuges.\\n{2}{B}{G}, opfere eine Kreatur, die kein Spielstein ist: Bringe X 1/1 grüne Saproling-Kreaturenspielsteine ins Spiel, wobei X die Widerstandskraft der geopferten Kreatur ist.\', \'type\': \'Kreatur — Elf, Schamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355912&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'695b0c47-a1a4-4e25-88e6-8a5ccd19774b\', \'multiverseId\': 355912}, \'multiverseid\': 355912}, {\'name\': \'Mago del gremio de Korozda\', \'text\': \'{1}{B}{G}: La criatura objetivo obtiene +1/+1 y gana la habilidad de intimidar hasta el final del turno.\\n{2}{B}{G}, sacrificar una criatura que no sea ficha: Pon en el campo de batalla X fichas de criatura Saprolín verdes 1/1, donde X es la resistencia de la criatura sacrificada.\', \'type\': \'Criatura — Chamán elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365634&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1780badc-3abb-4fd3-8b05-6de5125bfb69\', \'multiverseId\': 365634}, \'multiverseid\': 365634}, {\'name\': \'Ghildmage de Korozda\', \'text\': "{1}{B}{G} : La créature ciblée gagne +1/+1 et acquiert l\'intimidation jusqu\'à la fin du tour.\\n{2}{B}{G}, sacrifiez une créature non-jeton : Mettez sur le champ de bataille X jetons de créature 1/1 verte Saprobionte, X étant l\'endurance de la créature sacrifiée.", \'type\': \'Créature : elfe et shamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356186&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5e877a1a-45a1-4920-b829-c86ed8553fd9\', \'multiverseId\': 356186}, \'multiverseid\': 356186}, {\'name\': \'Mago della Gilda di Korozda\', \'text\': \'{1}{B}{G}: Una creatura bersaglio prende +1/+1 e ha intimidire fino alla fine del turno.\\n{2}{B}{G}, Sacrifica una creatura non pedina: Metti sul campo di battaglia X pedine creatura Saprolingio 1/1 verdi, dove X è la costituzione della creatura sacrificata.\', \'type\': \'Creatura — Sciamano Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356460&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'63cb8d4e-0de2-45f9-bb52-302cc445c8d1\', \'multiverseId\': 356460}, \'multiverseid\': 356460}, {\'name\': \'コロズダのギルド魔道士\', \'text\': \'{1}{B}{G}：クリーチャー１体を対象とする。それはターン終了時まで、＋１/＋１の修整を受けるとともに威嚇を得る。\\n{2}{B}{G}, トークンでないクリーチャー１体を生け贄に捧げる：緑の１/１の苗木・クリーチャー・トークンをＸ体戦場に出す。Ｘは、その生け贄に捧げられたクリーチャーのタフネスに等しい。\', \'type\': \'クリーチャー — エルフ・シャーマン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356734&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'03a5c374-8fc1-4986-8110-641615991529\', \'multiverseId\': 356734}, \'multiverseid\': 356734}, {\'name\': \'코로즈다 회관의 길드 마도사\', \'text\': \'{1}{B}{G}: 생물 한 개를 목표로 정한다. 그 생물은 턴종료까지 +1/+1을 받고 위협 능력을 얻는다.\\n{2}{B}{G}, 토큰이 아닌 생물 한 개를 희생한다: 1/1 녹색 묘목 생물 토큰 X개를 전장에 놓는다. X는 희생된 생물의 방어력이다.\', \'type\': \'생물 — 엘프 주술사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357556&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ba173ec2-355a-4355-8d59-0af70d229697\', \'multiverseId\': 357556}, \'multiverseid\': 357556}, {\'name\': \'Mago de Guilda de Korozda\', \'text\': \'{1}{B}{G}: A criatura alvo recebe +1/+1 e ganha intimidar até o final do turno.\\n{2}{B}{G}, Sacrifique uma criatura que não seja uma ficha: Coloque no campo de batalha X fichas de criatura verdes 1/1 do tipo Saprófita, sendo X igual à resistência da criatura sacrificada.\', \'type\': \'Criatura — Elfo Xamã\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357008&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f36b61b9-f8a0-4731-b05d-352fb52ec1d5\', \'multiverseId\': 357008}, \'multiverseid\': 357008}, {\'name\': \'Маг Гильдии из Корозды\', \'text\': \'{1}{B}{G}: целевое существо получает +1/+1 и Устрашение до конца хода.\\n{2}{B}{G}, пожертвуйте не являющееся фишкой существо: положите на поле битвы X фишек существа 1/1 зеленый Сапролинг, где X — выносливость пожертвованного существа.\', \'type\': \'Существо — Эльф Шаман\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355364&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b6158592-095f-4f12-ac49-c036d65c7b1f\', \'multiverseId\': 355364}, \'multiverseid\': 355364}, {\'name\': \'柯罗札公会法师\', \'text\': \'{1}{B}{G}：目标生物得+1/+1并获得威吓异能直到回合结束。\\n{2}{B}{G}，牺牲一个非衍生物的生物：将X个1/1绿色腐生物衍生生物放进战场，X为所牺牲之生物的防御力。\', \'type\': \'生物～妖精／祭师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357282&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cde87e07-61fb-469c-b16e-ecbd47d0c0ed\', \'multiverseId\': 357282}, \'multiverseid\': 357282}, {\'name\': \'柯羅札公會法師\', \'text\': \'{1}{B}{G}：目標生物得+1/+1並獲得威嚇異能直到回合結束。\\n{2}{B}{G}，犧牲一個非衍生物的生物：將X個1/1綠色腐生物衍生生物放進戰場，X為所犧牲之生物的防禦力。\', \'type\': \'生物～妖精／祭師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355638&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'85dc20c2-1c0b-49e8-8db7-3a9f07f25295\', \'multiverseId\': 355638}, \'multiverseid\': 355638}]', '[{\'name\': \'Kremation\', \'text\': \'Schicke eine Karte deiner Wahl aus einem Friedhof ins Exil.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ohne einen Körper kann die Seele nicht die Klauseln in unseren Verträgen anfechten." —Somhaur, Orzhov-Hohepriester\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355795&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a7f06abb-d581-4602-b719-a46c06834ebf\', \'multiverseId\': 355795}, \'multiverseid\': 355795}, {\'name\': \'Cremar\', \'text\': \'Exilia la carta objetivo de un cementerio.\\nRoba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'"Sin cuerpo, el alma no puede luchar contra los términos de nuestros contratos." —Somhaur, pontífice orzhov\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365517&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c1ba6ff0-71e2-4f82-87a1-582046930459\', \'multiverseId\': 365517}, \'multiverseid\': 365517}, {\'name\': \'Crémation\', \'text\': "Exilez une carte ciblée d\'un cimetière.\\nPiochez une carte.", \'type\': \'Éphémère\', \'flavor\': "« Sans enveloppe corporelle, l\'âme est impuissante pour s\'opposer aux termes de nos contrats. » —Somhaur, pontife d\'Orzhov", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356069&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fbc99b3a-362a-4af6-878a-1060dbc52b77\', \'multiverseId\': 356069}, \'multiverseid\': 356069}, {\'name\': \'Cremare\', \'text\': \'Esilia una carta bersaglio da un cimitero.\\nPesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'"Senza un corpo, l\\\'anima non ha i mezzi per protestare davanti ai termini del nostro contratto." —Somhaur, pontefice Orzhov\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356343&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'17c402f5-89fd-4a96-a037-89895687304d\', \'multiverseId\': 356343}, \'multiverseid\': 356343}, {\'name\': \'死体焼却\', \'text\': \'いずれかの墓地にあるカード１枚を対象とし、それを追放する。\\nカードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': \'「肉体がなければ、魂は我らの契約の縛りに抗うことなどできぬ。」 ――オルゾフの司教、ソマール\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356617&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f17f4ca7-3b3c-4cde-8c82-ec5ccc2d5e7b\', \'multiverseId\': 356617}, \'multiverseid\': 356617}, {\'name\': \'화장\', \'text\': \'무덤에 있는 카드 한 장을 목표로 정한다. 그 카드를 추방한다.\\n카드 한 장을 뽑는다.\', \'type\': \'순간마법\', \'flavor\': \'"육체가 없는 영혼은 우리 계약의 내용을 거부할 수 없다." —오르조브 제사장 솜하우르\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357439&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'068ed001-e2b3-41df-abf6-07d02208953a\', \'multiverseId\': 357439}, \'multiverseid\': 357439}, {\'name\': \'Cremar\', \'text\': \'Exile o card alvo de um cemitério.\\nCompre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Sem um corpo, a alma é incapaz de resistir aos termos de nossos contratos." — Somhaur, pontífice Orzhov\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356891&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ea8d3d89-6025-4aa3-8347-8152a4459e01\', \'multiverseId\': 356891}, \'multiverseid\': 356891}, {\'name\': \'Кремация\', \'text\': \'Изгоните целевую карту из кладбища.\\nВозьмите карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Душа, лишенная тела, не сможет противостоять условиям наших контрактов». — Сомхаур, понтифик Орзовов\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355247&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0aa4d73c-3ab8-4e7a-99d5-05b6fcfd45a1\', \'multiverseId\': 355247}, \'multiverseid\': 355247}, {\'name\': \'火葬\', \'text\': \'将目标牌从坟墓场放逐。\\n抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'「少了肉体，灵魂将无法抵抗我们的契约条文。」 ～欧佐夫主教桑霍\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357165&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'23c2d336-be7b-41d0-817b-1661b41bbcd6\', \'multiverseId\': 357165}, \'multiverseid\': 357165}, {\'name\': \'火葬\', \'text\': \'將目標牌從墳墓場放逐。\\n抽一張牌。\', \'type\': \'瞬間\', \'flavor\': \'「少了肉體，靈魂將無法抵抗我們的契約條文。」 ～歐佐夫主教桑霍\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355521&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4c4dccc5-4d79-4e6a-a258-87162b2f7652\', \'multiverseId\': 355521}, \'multiverseid\': 355521}]', '[{\'name\': \'Kriegsrecht\', \'text\': \'Inhaftiere zu Beginn deines Versorgungssegments eine Kreatur deiner Wahl, die ein Gegner kontrolliert. (Bis zu deinem nächsten Zug kann diese Kreatur nicht angreifen oder blocken, und ihre aktivierten Fähigkeiten können nicht aktiviert werden.)\', \'type\': \'Verzauberung\', \'flavor\': \'„Das Wohl der Gesellschaft ist viel wichtiger als die Unbill einiger weniger." —Agmand Sarv, Azorius-Husar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355750&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c3750717-7424-488a-aa82-b21ece626040\', \'multiverseId\': 355750}, \'multiverseid\': 355750}, {\'name\': \'Ley marcial\', \'text\': \'Al comienzo de tu mantenimiento, detén la criatura objetivo que controla un oponente. (Hasta tu próximo turno, esa criatura no puede atacar ni bloquear y sus habilidades activadas no pueden activarse.)\', \'type\': \'Encantamiento\', \'flavor\': \'"El bien de la sociedad importa mucho más que las molestias de unos pocos." —Agmand Sarv, húsar azorio\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365472&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ff92f9d2-6d2b-40f2-84fc-606cd45a393d\', \'multiverseId\': 365472}, \'multiverseid\': 365472}, {\'name\': \'Loi martiale\', \'text\': "Au début de votre entretien, détenez une créature ciblée qu\'un adversaire contrôle. (Jusqu\'à votre prochain tour, cette créature ne peut ni attaquer ni bloquer et ses capacités activées ne peuvent pas être activées.)", \'type\': \'Enchantement\', \'flavor\': "« Le bien commun importe bien plus que l\'inconfort de quelques-uns. » —Agmand Sarv, hussard d\'Azorius", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356024&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'87d1f734-6c98-4be0-8b4b-9cdbc0f7551a\', \'multiverseId\': 356024}, \'multiverseid\': 356024}, {\'name\': \'Legge Marziale\', \'text\': "All\'inizio del tuo mantenimento, trattieni una creatura bersaglio controllata da un avversario. (Fino al tuo prossimo turno, quella creatura non può attaccare o bloccare e le sue abilità attivate non possono essere attivate.)", \'type\': \'Incantesimo\', \'flavor\': \'"Il disagio di pochi è un piccolo prezzo da pagare per il bene della società intera." —Agmand Sarv, ussaro Azorius\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356298&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'afb75f7b-9b7e-4613-9313-95104102e372\', \'multiverseId\': 356298}, \'multiverseid\': 356298}, {\'name\': \'戒厳令\', \'text\': \'あなたのアップキープの開始時に、対戦相手１人がコントロールするクリーチャー１体を対象とし、それを留置する。（あなたの次のターンまで、そのクリーチャーでは攻撃もブロックもできず、それの起動型能力は起動できない。）\', \'type\': \'エンチャント\', \'flavor\': \'「一握りの個人の不都合などより、社会の安定のほうがはるかに重要だ。」 ――アゾリウスの騎兵、アグマンド・サーヴ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356572&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'55372746-5a21-4a5b-80f4-4f9a8ce8c56a\', \'multiverseId\': 356572}, \'multiverseid\': 356572}, {\'name\': \'계엄령\', \'text\': \'당신의 유지단 시작에, 상대가 조종하는 생물 한 개를 목표로 정한다. 그 생물을 억류한다. (당신의 다음 턴이 될 때까지 그 생물은 공격하거나 방어할 수 없으며, 그 생물의 활성화능력은 활성화될 수 없다.)\', \'type\': \'부여마법\', \'flavor\': \'"사회 전체의 이익을 위해서라면 소수의 불편은 감수하는 것이 마땅하다." —아조리우스 경기병 아그만드 사르브\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357394&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'653ce403-bb5d-4dda-a5fe-deb26b835d9c\', \'multiverseId\': 357394}, \'multiverseid\': 357394}, {\'name\': \'Lei Marcial\', \'text\': \'No início de sua manutenção, detenha a criatura alvo que um oponente controla. (Até o seu próximo turno, aquela criatura não pode atacar nem bloquear e as habilidades ativadas dela não podem ser ativadas.)\', \'type\': \'Encantamento\', \'flavor\': \'"O bem da sociedade é muito mais importante do que a inconveniência de uns poucos." — Agmand Sarv, hussardo azorius\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356846&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5164d78e-8bdd-46f3-a078-33fd65f837c3\', \'multiverseId\': 356846}, \'multiverseid\': 356846}, {\'name\': \'Военное Положение\', \'text\': \'В начале вашего шага поддержки задержите целевое существо под контролем оппонента. (До вашего следующего хода то существо не может атаковать или блокировать, и его активируемые способности не могут быть активированы.)\', \'type\': \'Чары\', \'flavor\': \'«Во благо общества можно причинить неудобства меньшинству». — Агманд Сарв, гусар Азориусов\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355202&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'84949ca5-68d9-4dba-9bc5-35ac3cd54693\', \'multiverseId\': 355202}, \'multiverseid\': 355202}, {\'name\': \'戒严令\', \'text\': \'在你的维持开始时，拘留目标由对手操控的生物。（直到你的下个回合，该生物不能进行攻击或阻挡，其起动式异能也不能起动。）\', \'type\': \'结界\', \'flavor\': \'「社会的利益比少数人的不便更加重要。」 ～俄佐立轻骑兵艾门塞夫\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357120&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'21f141ad-1288-4245-994e-25406545a2ef\', \'multiverseId\': 357120}, \'multiverseid\': 357120}, {\'name\': \'戒嚴令\', \'text\': \'在你的維持開始時，拘留目標由對手操控的生物。（直到你的下個回合，該生物不能進行攻擊或阻擋，其起動式異能也不能起動。）\', \'type\': \'結界\', \'flavor\': \'「社會的利益比起少數人的不便更加重要。」 ～俄佐立輕騎兵艾門塞夫\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355476&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d6926f75-588b-4ebc-95d8-df0f4b7fd789\', \'multiverseId\': 355476}, \'multiverseid\': 355476}]', '[{\'name\': \'Launenhafter Chemister\', \'text\': \'{U}, {T}: Ziehe zwei Karten.\\n{R}, {T}, wirf eine Karte aus deiner Hand ab: Der Launenhafte Chemister fügt einer Kreatur deiner Wahl so viele Schadenspunkte zu, wie die umgewandelten Manakosten der abgeworfenen Karte betragen.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'Was manche für Unaufmerksamkeit halten, ist in Wirklichkeit das Ergründen des Unergründlichen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355916&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6f7012ad-89cf-48d8-824b-b3a42dfc1f6f\', \'multiverseId\': 355916}, \'multiverseid\': 355916}, {\'name\': \'Quimista mercurial\', \'text\': \'{U}, {T}: Roba dos cartas.\\n{R}, {T}, descartar una carta: El Quimista mercurial hace una cantidad de daño a la criatura objetivo igual al coste de maná convertido de la carta descartada.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'Lo que algunos ven como "distracción" es en realidad "comprensión de lo incomprensible".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365638&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'98d88c0b-f6a6-4823-bc2a-b1e581c61559\', \'multiverseId\': 365638}, \'multiverseid\': 365638}, {\'name\': \'Chimiste lunatique\', \'text\': "{U}, {T} : Piochez deux cartes.\\n{R}, {T}, défaussez-vous d\'une carte : Le Chimiste lunatique inflige à une créature ciblée un nombre de blessures égal au coût converti de mana de la carte défaussée.", \'type\': \'Créature : humain et sorcier\', \'flavor\': "Certains le jugent distrait, alors qu\'en réalité il est en train de concevoir l\'inconcevable.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356190&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'82897f53-a08b-41ff-8e51-b4963a906e14\', \'multiverseId\': 356190}, \'multiverseid\': 356190}, {\'name\': \'Chimimago Incostante\', \'text\': \'{U}, {T}: Pesca due carte.\\n{R}, {T}, Scarta una carta: Il Chimimago Incostante infligge danno pari al costo di mana convertito della carta scartata a una creatura bersaglio.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': "Sembra distratto, ma in realtà sta decifrando l\'indecifrabile tra sé e sé.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356464&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f1544212-6b25-4639-a5ca-78dbe9f0a0ab\', \'multiverseId\': 356464}, \'multiverseid\': 356464}, {\'name\': \'気紛れな薬術師\', \'text\': \'{U}, {T}：カードを２枚引く。\\n{R}, {T}, カードを１枚捨てる：クリーチャー１体を対象とする。気紛れな薬術師はそれに、捨てたカードの点数で見たマナ・コストに等しい点数のダメージを与える。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'ある者には「ぼんやりしている」と見えるだろうが、実は「はかり知れぬ深淵をさぐっている」のだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356738&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'abb2b185-2875-4725-af2b-a9110510f70d\', \'multiverseId\': 356738}, \'multiverseid\': 356738}, {\'name\': \'변덕스러운 화학술사\', \'text\': \'{U}, {T}: 카드 두 장을 뽑는다.\\n{R}, {T}, 카드 한 장을 버린다: 생물 한 개를 목표로 정한다. 변덕스러운 화학술사는 버린 카드의 전환마나비용만큼의 피해를 그 생물에게 입힌다.\', \'type\': \'생물 — 인간 마법사\', \'flavor\': \'얼핏 보면 그저 정신이 산만한 자라고 생각할 수 있지만, 사실 그는 남들이 상상조차 할 수 없는 발상을 하고 있는 것이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357560&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7a85f315-f600-4e20-9429-312c0cbbca7a\', \'multiverseId\': 357560}, \'multiverseid\': 357560}, {\'name\': \'Quimiomante Volátil\', \'text\': \'{U}, {T}: Compre dois cards.\\n{R}, {T}, Descarte um card: Quimiomante Volátil causa dano à criatura alvo igual ao custo de mana convertido do card descartado.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'O que alguns veem como "distração" é realmente "sondar o insondável".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357012&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'71b7ceac-bf8a-4520-811f-994ac0d20329\', \'multiverseId\': 357012}, \'multiverseid\': 357012}, {\'name\': \'Эксцентричный Химик\', \'text\': \'{U}, {T}: возьмите две карты.\\n{R}, {T}, сбросьте карту: Эксцентричный Химик наносит целевому существу повреждения, равные конвертированной мана-стоимости сброшенной карты.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'То, что некоторые считают сумасшествием, на самом деле есть попытка объять необъятное.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355368&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8953856b-7c39-4af4-83ac-c364c3cb4910\', \'multiverseId\': 355368}, \'multiverseid\': 355368}, {\'name\': \'精明化学师\', \'text\': \'{U}，{T}：抓两张牌。\\n{R}，{T}，弃一张牌：精明化学师对目标生物造成若干伤害，其数量等同于所弃之牌的总法术力费用。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'貌似「心不在焉」，实则「洞悉玄机」。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357286&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d2adc8ff-9548-4698-99cb-43f5aa699d30\', \'multiverseId\': 357286}, \'multiverseid\': 357286}, {\'name\': \'精明化學師\', \'text\': \'{U}，{T}：抽兩張牌。\\n{R}，{T}，棄一張牌：精明化學師對目標生物造成若干傷害，其數量等同於所棄之牌的總魔法力費用。\', \'type\': \'生物～人類／魔法師\', \'flavor\': \'狀似「心不在焉」，實則「洞悉玄機」。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355642&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'944d58d2-7c5b-491c-8766-85a8bd3d87df\', \'multiverseId\': 355642}, \'multiverseid\': 355642}]', '[{\'name\': \'Lotleth-Troll\', \'text\': \'Verursacht Trampelschaden\\nWirf eine Kreaturenkarte aus deiner Hand ab: Lege eine +1/+1-Marke auf den Lotleth-Troll.\\n{B}: Regeneriere den Lotleth-Troll.\', \'type\': \'Kreatur — Zombie, Troll\', \'flavor\': \'Er lungert in der Unterstadt herum und lauert begierig darauf, dass die Leichenträger ihre verwesende Fracht abladen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355913&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cf85d555-3f10-4c31-beb2-301df62f0bdf\', \'multiverseId\': 355913}, \'multiverseid\': 355913}, {\'name\': \'Trol lotleth\', \'text\': \'Arrolla.\\nDescartar una carta de criatura: Pon un contador +1/+1 sobre el Trol lotleth.\\n{B}: Regenera el Trol lotleth.\', \'type\': \'Criatura — Trol zombie\', \'flavor\': \'Merodea por la subciudad, ansioso por que los porteadores de cadáveres descarguen su podrida mercancía.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365635&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d523b59f-39f1-429f-875a-559de852d8b3\', \'multiverseId\': 365635}, \'multiverseid\': 365635}, {\'name\': \'Troll de Lotleth\', \'text\': "Piétinement\\nDéfaussez-vous d\'une carte de créature : Mettez un marqueur +1/+1 sur le Troll de Lotleth.\\n{B} : Régénérez le Troll de Lotleth.", \'type\': \'Créature : zombie et troll\', \'flavor\': \'Il rôde dans la Citerraine, attendant que les ramasseurs de cadavres déversent leur cargaison pourrissante.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356187&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'eb286772-0e3f-46bc-8a19-088d617a219f\', \'multiverseId\': 356187}, \'multiverseid\': 356187}, {\'name\': \'Troll Lotleth\', \'text\': \'Travolgere\\nScarta una carta creatura: Metti un segnalino +1/+1 sul Troll Lotleth.\\n{B}: Rigenera il Troll Lotleth.\', \'type\': \'Creatura — Troll Zombie\', \'flavor\': \'In agguato nella città sepolta, attende che gli scaricatori di corpi depositino il loro carico putrefatto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356461&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4615b893-aab2-4376-90fa-7a5b30fd2467\', \'multiverseId\': 356461}, \'multiverseid\': 356461}, {\'name\': \'ロッテスのトロール\', \'text\': \'トランプル\\nクリーチャー・カードを１枚捨てる：ロッテスのトロールの上に＋１/＋１カウンターを１個置く。\\n{B}：ロッテスのトロールを再生する。\', \'type\': \'クリーチャー — ゾンビ・トロール\', \'flavor\': \'奴は地底街に潜み、死体運搬業者が腐敗した積み荷を降ろすのを待ちわびている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356735&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'710c03eb-0090-4062-9c31-cc73f3fb80d6\', \'multiverseId\': 356735}, \'multiverseid\': 356735}, {\'name\': \'로틀레스 트롤\', \'text\': \'돌진\\n생물 카드 한 장을 버린다: 로틀레스 트롤에 +1/+1 카운터 한 개를 올려놓는다.\\n{B}: 로틀레스 트롤을 재생한다.\', \'type\': \'생물 — 좀비 트롤\', \'flavor\': \'그는 지하 도시에 숨어서 시체 운반자들이 썩어가는 짐을 내리기만을 기다린다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357557&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'cee42b7d-91a0-4eab-a060-70f04b49d8ec\', \'multiverseId\': 357557}, \'multiverseid\': 357557}, {\'name\': \'Trol Lotleth\', \'text\': \'Atropelar\\nDescarte um card de criatura: Coloque um marcador +1/+1 em Trol Lotleth.\\n{B}: Regenere Trol Lotleth\', \'type\': \'Criatura — Zumbi Trol\', \'flavor\': \'Ele espreita no submundo, ávido para que os catadores de corpos descarreguem sua carga em putrefação.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357009&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'db45f774-4ca6-4b40-88c0-5ef221fd8fbe\', \'multiverseId\': 357009}, \'multiverseid\': 357009}, {\'name\': \'Лотлетский Тролль\', \'text\': \'Пробивной удар\\nСбросьте карту существа: положите один жетон +1/+1 на Лотлетского Тролля.\\n{B}: регенерируйте Лотлетского Тролля.\', \'type\': \'Существо — Зомби Тролль\', \'flavor\': \'Он рыскает по подземному городу, ожидая, когда сборщики трупов скинут вниз очередную порцию тел.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355365&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'12cbea3e-05b5-4ce4-a611-10bd77c3b7f3\', \'multiverseId\': 355365}, \'multiverseid\': 355365}, {\'name\': \'洛特离巨魔\', \'text\': \'践踏\\n弃一张生物牌：在洛特离巨魔上放置一个+1/+1指示物。\\n{B}：重生洛特离巨魔。\', \'type\': \'生物～灵俑／巨魔\', \'flavor\': \'他在地底城中潜伏，等待负尸工卸货。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357283&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ff31cf1b-f736-461c-9514-a323f0e37dac\', \'multiverseId\': 357283}, \'multiverseid\': 357283}, {\'name\': \'洛特離巨魔\', \'text\': \'踐踏\\n棄一張生物牌：在洛特離巨魔上放置一個+1/+1指示物。\\n{B}：重生洛特離巨魔。\', \'type\': \'生物～殭屍／巨魔\', \'flavor\': \'他在地底城中潛伏，等待負屍工卸貨。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355639&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2a56dba1-1086-489d-83f1-ea3c24cc78e4\', \'multiverseId\': 355639}, \'multiverseid\': 355639}]', '[{\'name\': \'Loxodon-Trümmermacher\', \'text\': \'Der Loxodon-Trümmermacher kann nicht neutralisiert werden.\\nFalls ein Zauberspruch oder eine Fähigkeit, den bzw. die ein Gegner kontrolliert, dazu führt, dass du den Loxodon-Trümmermacher aus deiner Hand abwirfst, bringe ihn ins Spiel, anstatt ihn auf deinen Friedhof zu legen.\', \'type\': \'Kreatur — Elefant, Soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355914&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'db161914-60fa-4d98-b323-fbf37086ab96\', \'multiverseId\': 355914}, \'multiverseid\': 355914}, {\'name\': \'Abatidor loxodón\', \'text\': \'El Abatidor loxodón no puede ser contrarrestado.\\nSi un hechizo o habilidad que controle un oponente te hace descartar el Abatidor loxodón, ponlo en el campo de batalla en vez de ponerlo en tu cementerio.\', \'type\': \'Criatura — Soldado elefante\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365636&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b27dc104-ce8e-4d9c-8ed4-ffc7542048e9\', \'multiverseId\': 365636}, \'multiverseid\': 365636}, {\'name\': \'Frappeur loxodon\', \'text\': "Le Frappeur loxodon ne peut pas être contrecarré.\\nSi un sort ou une capacité qu\'un adversaire contrôle vous contraint à vous défausser du Frappeur loxodon, mettez-le sur le champ de bataille à la place de le mettre dans votre cimetière.", \'type\': \'Créature : éléphant et soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356188&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'55b9778e-7056-4c54-a5e2-46bfda651e59\', \'multiverseId\': 356188}, \'multiverseid\': 356188}, {\'name\': \'Lossodonte Castigatore\', \'text\': \'Il Lossodonte Castigatore non può essere neutralizzato.\\nSe una magia o abilità controllata da un avversario ti fa scartare il Lossodonte Castigatore, mettilo sul campo di battaglia invece di metterlo nel tuo cimitero.\', \'type\': \'Creatura — Soldato Elefante\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356462&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6e08a377-26de-411b-98e1-74b18e5f55b3\', \'multiverseId\': 356462}, \'multiverseid\': 356462}, {\'name\': \'ロクソドンの強打者\', \'text\': \'ロクソドンの強打者は打ち消されない。\\n対戦相手１人がコントロールする呪文や能力によって、あなたがロクソドンの強打者を捨てる場合、これをあなたの墓地に置く代わりに戦場に出す。\', \'type\': \'クリーチャー — 象・兵士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356736&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'08786951-79e0-4eb6-b843-174e976b635f\', \'multiverseId\': 356736}, \'multiverseid\': 356736}, {\'name\': \'록소돈 강타병\', \'text\': \'록소돈 강타병은 무효화될 수 없다.\\n상대가 조종하는 주문이나 능력으로 인해 당신이 록소돈 강타병을 손에서 버리게 될 경우, 그것을 무덤에 넣는 대신에 전장에 놓는다.\', \'type\': \'생물 — 코끼리 병사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357558&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3f11e610-8966-4c5c-a8c4-8f7cd151b62d\', \'multiverseId\': 357558}, \'multiverseid\': 357558}, {\'name\': \'Golpeador Loxodonte\', \'text\': \'Golpeador Loxodonte não pode ser anulado.\\nSe uma mágica ou habilidade que um oponente controla fizer com que você descarte Golpeador Loxodonte, em vez de colocá-lo no seu cemitério, coloque-o no campo de batalha.\', \'type\': \'Criatura — Elefante Soldado\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357010&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9f1cc8bc-9a91-4b42-8df7-421e87701742\', \'multiverseId\': 357010}, \'multiverseid\': 357010}, {\'name\': \'Локсодон-Сокрушитель\', \'text\': \'Локсодон-Сокрушитель не может быть отменен.\\nЕсли заклинание или способность под контролем оппонента заставляет вас сбросить Локсодона-Сокрушителя, положите его на поле битвы вместо того, чтобы положить его на ваше кладбище.\', \'type\': \'Существо — Слон Солдат\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355366&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0eddf92b-32ae-4aab-84fb-4dad794bc16d\', \'multiverseId\': 355366}, \'multiverseid\': 355366}, {\'name\': \'象族重击兵\', \'text\': \'象族重击兵不能被反击。\\n如果由对手所操控的咒语或异能使得你弃掉象族重击兵，则改为将它放进战场，而非置入你的坟墓场。\', \'type\': \'生物～象／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357284&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1647c619-8435-4fd2-9913-203bb9e89ef6\', \'multiverseId\': 357284}, \'multiverseid\': 357284}, {\'name\': \'象族重擊兵\', \'text\': \'象族重擊兵不能被反擊。\\n如果由對手所操控的咒語或異能使得你棄掉象族重擊兵，則改為將它放進戰場，而非置入你的墳墓場。\', \'type\': \'生物～象／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355640&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'263d57fe-4bf5-4d9a-83dc-6fb80e8f8368\', \'multiverseId\': 355640}, \'multiverseid\': 355640}]', "[{'name': 'Luftige Jagd', 'text': 'Zerstöre eine fliegende Kreatur deiner Wahl. Du erhältst 2 Lebenspunkte dazu.', 'type': 'Spontanzauber', 'flavor': 'Die zurückgekehrte Macht der Wildnis von Ravnica zeigt sich in den hoch emporragenden Bäume des Samokwäldchens und den Raubtieren, die sie bewachen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355849&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'cd786c78-3a91-4329-9ffb-213ecb27d37d', 'multiverseId': 355849}, 'multiverseid': 355849}, {'name': 'Depredación aérea', 'text': 'Destruye la criatura objetivo con la habilidad de volar. Ganas 2 vidas.', 'type': 'Instantáneo', 'flavor': 'Con los altísimos árboles de la Espesura de Samok y los depredadores que los custodian ha regresado la fuerza de la naturaleza de Rávnica.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365571&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '26ab053a-9f2c-4922-b6fb-300a4a924a3c', 'multiverseId': 365571}, 'multiverseid': 365571}, {'name': 'Cycle alimentaire aérien', 'text': 'Détruisez une créature avec le vol ciblée. Vous gagnez 2 points de vie.', 'type': 'Éphémère', 'flavor': 'Entre les arbres monumentaux de la Position de Samok et les prédateurs qui les protègent, la puissance de la nature de Ravnica est de retour.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356123&type=card', 'language': 'French', 'identifiers': {'scryfallId': '353ccb1e-69ff-4037-837a-fc935c9477ce', 'multiverseId': 356123}, 'multiverseid': 356123}, {'name': 'Assalto Aereo', 'text': 'Distruggi una creatura bersaglio con volare. Guadagni 2 punti vita.', 'type': 'Istantaneo', 'flavor': 'Negli alberi torreggianti del Bosco Samok e nei predatori che li sorvegliano, si manifesta il potere redivivo della natura di Ravnica.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356397&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '047284c1-de49-49ac-88be-9c7cf125a456', 'multiverseId': 356397}, 'multiverseid': 356397}, {'name': '空中捕食', 'text': '飛行を持つクリーチャー１体を対象とし、それを破壊する。あなたは２点のライフを得る。', 'type': 'インスタント', 'flavor': 'サーモク木立の背の高い木々とそれを守る捕食者の中で、ラヴニカの自然は力を取り戻した。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356671&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '4aeb4316-bc1a-4fab-8453-63cb942dbb75', 'multiverseId': 356671}, 'multiverseid': 356671}, {'name': '공중 포식', 'text': '비행 능력을 가진 생물 한 개를 목표로 정한다. 그 생물을 파괴한다. 당신은 생명 2점을 얻는다.', 'type': '순간마법', 'flavor': '사목 스탠드 숲의 높이 솟은 나무들과 그것을 지키는 포식자들에게 라브니카의 야생의 힘이 돌아왔다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357493&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '0bba91d4-6942-4486-8e73-af0d2f75928e', 'multiverseId': 357493}, 'multiverseid': 357493}, {'name': 'Predação Aérea', 'text': 'Destrua a criatura alvo com voar. Você ganha 2 pontos de vida.', 'type': 'Mágica Instantânea', 'flavor': 'Nas imponentes árvores do Arvoredo de Samok, e nos predadores que as protegem, a força selvagem de Ravnica retornou.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356945&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5b9506b4-d695-47ba-bd82-fcd103dbf0a6', 'multiverseId': 356945}, 'multiverseid': 356945}, {'name': 'Охота в Воздухе', 'text': 'Уничтожьте целевое существо с Полетом. Вы получаете 2 жизни.', 'type': 'Мгновенное заклинание', 'flavor': 'Мощь дикой природы Равники живет в вековых деревьях Самокского леса и хищниках, его охраняющих.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355301&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'c89fe040-7224-4477-9939-71d4a5ece6c6', 'multiverseId': 355301}, 'multiverseid': 355301}, {'name': '空中猎捕', 'text': '消灭目标具飞行异能的生物。你获得2点生命。', 'type': '瞬间', 'flavor': '在耸立的撒莫林树木以及守护这些树木的掠食者之间，拉尼卡的瀚力已复归。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357219&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b981292c-0e1e-4272-b8ef-fbc753a6d6e2', 'multiverseId': 357219}, 'multiverseid': 357219}, {'name': '空中獵捕', 'text': '消滅目標具飛行異能的生物。你獲得2點生命。', 'type': '瞬間', 'flavor': '在聳立的撒莫林樹木以及守護這些樹木的掠食者之間，拉尼卡的瀚力已復歸。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355575&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'a013ccd2-79fa-44b7-99a5-1e25308d5810', 'multiverseId': 355575}, 'multiverseid': 355575}]", '[{\'name\': \'Lyev-Himmelsritter\', \'text\': \'Fliegend\\nWenn der Lyev-Himmelsritter ins Spiel kommt, inhaftiere eine bleibende Karte deiner Wahl, die kein Land ist und die ein Gegner kontrolliert. (Bis zu deinem nächsten Zug kann diese bleibende Karte nicht angreifen oder blocken und ihre aktivierten Fähigkeiten können nicht aktiviert werden.)\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355915&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7bb39622-fb5d-4dcd-a55f-62fe03f28f52\', \'multiverseId\': 355915}, \'multiverseid\': 355915}, {\'name\': \'Caballero celeste lyev\', \'text\': \'Vuela.\\nCuando el Caballero celeste lyev entre al campo de batalla, detén el permanente objetivo que no sea tierra que controla un oponente. (Hasta tu próximo turno, ese permanente no puede atacar ni bloquear y sus habilidades activadas no pueden activarse.)\', \'type\': \'Criatura — Caballero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365637&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f780341c-3623-4e09-80d2-c37041a990c2\', \'multiverseId\': 365637}, \'multiverseid\': 365637}, {\'name\': \'Chevalière céleste de Lyev\', \'text\': "Vol\\nQuand la Chevalière céleste de Lyev arrive sur le champ de bataille, détenez un permanent non-terrain ciblé qu\'un adversaire contrôle. (Jusqu\'à votre prochain tour, ce permanent ne peut ni attaquer ni bloquer et ses capacités activées ne peuvent pas être activées.)", \'type\': \'Créature : humain et chevalier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356189&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'33807731-da2c-4920-af15-fb3a11ad9457\', \'multiverseId\': 356189}, \'multiverseid\': 356189}, {\'name\': \'Cavaliera dei Cieli Lyev\', \'text\': \'Volare\\nQuando la Cavaliera dei Cieli Lyev entra nel campo di battaglia, trattieni un permanente non terra bersaglio controllato da un avversario. (Fino al tuo prossimo turno, quel permanente non può attaccare o bloccare e le sue abilità attivate non possono essere attivate.)\', \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356463&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7d747609-fbdc-47dd-ba66-57a7edf14ce5\', \'multiverseId\': 356463}, \'multiverseid\': 356463}, {\'name\': \'リーヴの空騎士\', \'text\': \'飛行\\nリーヴの空騎士が戦場に出たとき、対戦相手１人がコントロールする土地でないパーマネント１つを対象とし、それを留置する。（あなたの次のターンまで、そのパーマネントでは攻撃もブロックもできず、それの起動型能力は起動できない。）\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356737&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'39be933f-7ae7-49a1-8321-73c54cf67dde\', \'multiverseId\': 356737}, \'multiverseid\': 356737}, {\'name\': \'리예브의 창공기사\', \'text\': \'비행\\n리예브의 창공기사가 전장에 들어올 때, 상대가 조종하는 지속물 중 대지가 아닌 지속물 한 개를 목표로 정한다. 그 지속물을 억류한다. (당신의 다음 턴이 될 때까지 그 지속물은 공격하거나 방어할 수 없으며, 그 지속물의 활성화능력은 활성화될 수 없다.)\', \'type\': \'생물 — 인간 기사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357559&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'184972b6-35ba-47f3-bc3b-7a685460ff76\', \'multiverseId\': 357559}, \'multiverseid\': 357559}, {\'name\': \'Cavaleiro Celeste Lyev\', \'text\': \'Voar\\nQuando Cavaleiro Celeste Lyev entrar no campo de batalha, detenha a permanente alvo que não seja um terreno que seu oponente controle. (Até seu próximo turno, aquela criatura não pode atacar nem bloquear e as habilidades ativadas dela não podem ser ativadas.)\', \'type\': \'Criatura — Humano Cavaleiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357011&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d9f35713-5745-4ede-8826-7f2935931de9\', \'multiverseId\': 357011}, \'multiverseid\': 357011}, {\'name\': \'Небесный Рыцарь Лиевов\', \'text\': \'Полет\\nКогда Небесный Рыцарь Лиевов выходит на поле битвы, задержите целевой не являющийся землей перманент под контролем оппонента. (До вашего следующего хода тот перманент не может атаковать или блокировать, и его активируемые способности не могут быть активированы.)\', \'type\': \'Существо — Человек Рыцарь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355367&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f0890789-07d3-499a-8b53-56fc5269d214\', \'multiverseId\': 355367}, \'multiverseid\': 355367}, {\'name\': \'徕夫空骑士\', \'text\': \'飞行\\n当徕夫空骑士进战场时，拘留目标由对手操控的非地永久物。（直到你的下一个回合，该永久物不能进行攻击或阻挡，其起动式异能也不能起动。）\', \'type\': \'生物～人类／骑士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357285&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'86cec70c-6e87-4a55-9a23-929a3d8b9588\', \'multiverseId\': 357285}, \'multiverseid\': 357285}, {\'name\': \'徠夫空騎士\', \'text\': \'飛行\\n當徠夫空騎士進戰場時，拘留目標由對手操控的非地永久物。（直到你的下一個回合，該永久物不能進行攻擊或阻擋，其起動式異能也不能起動。）\', \'type\': \'生物～人類／騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355641&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6a4703b5-a825-4801-9fe3-59cecd70eece\', \'multiverseId\': 355641}, \'multiverseid\': 355641}]', '[{\'name\': \'Lähmender Griff\', \'text\': \'Kreaturenverzauberung\\nDie verzauberte Kreatur enttappt nicht während des Enttappsegments ihres Beherrschers.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Die Mission des Feuerhirns ist selbstverständlich wichtiger als ein paar Goblins." —Pelener, Kämmerer von Niv-Mizzet\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355782&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cb461e53-7ccd-4fd6-b068-5bcae10fc15d\', \'multiverseId\': 355782}, \'multiverseid\': 355782}, {\'name\': \'Abrazo paralizante\', \'text\': \'Encantar criatura.\\nLa criatura encantada no se endereza durante el paso de enderezar de su controlador.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"Es evidente que la misión de la Mente Ardiente vale más que un puñado de trasgos." —Pelener, chambelán de Niv-Mízzet\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365504&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'866b3d5e-dbd5-4eb2-95f7-cb1ca87a3b6d\', \'multiverseId\': 365504}, \'multiverseid\': 365504}, {\'name\': \'Emprise paralysante\', \'text\': "Enchanter : créature\\nLa créature enchantée ne se dégage pas pendant l\'étape de dégagement de son contrôleur.", \'type\': \'Enchantement : aura\', \'flavor\': "« Manifestement, la mission du Cérébropyre vaut plus qu\'une poignée de gobelins. » —Pelener, chambellan de Niv-Mizzet", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356056&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'37c0d740-4492-4ef5-a5a7-ee3df624b45d\', \'multiverseId\': 356056}, \'multiverseid\': 356056}, {\'name\': \'Stretta Paralizzante\', \'text\': \'Incanta creatura\\nLa creatura incantata non STAPpa durante lo STAP del suo controllore.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Ovviamente la missione per conto del Mentefiamma è più importante di una manciata di goblin." —Pelener, ciambellano di Niv-Mizzet\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356330&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dc446102-b494-43c3-8d5a-252bb1a94bc2\', \'multiverseId\': 356330}, \'multiverseid\': 356330}, {\'name\': \'麻痺の掌握\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは、それのコントローラーのアンタップ・ステップにアンタップしない。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「数体のゴブリンよりも火想者の使命のほうが重要なのは明らかです。」 ――ニヴ＝ミゼットの執事、ペリナー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356604&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e349f64b-2a0c-4a1f-b39a-56cf69fa839f\', \'multiverseId\': 356604}, \'multiverseid\': 356604}, {\'name\': \'마비의 움켜쥠\', \'text\': \'생물에게 부여\\n부여된 생물은 조종자의 언탭단에 언탭되지 않는다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'"불꽃천재님의 임무가 고블린 몇 마리의 목숨보다 중요한 건 당연한 거 아닌가?" —니브-미젯의 시종 펠레네르\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357426&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7cfcf1e7-a752-497a-baca-23e95c9d6f2e\', \'multiverseId\': 357426}, \'multiverseid\': 357426}, {\'name\': \'Abraço Paralisante\', \'text\': \'Encantar criatura\\nA criatura encantada não é desvirada durante a etapa de desvirar de seu controlador.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Obviamente, a missão do Mente de Fogo vale mais do que alguns goblins." — Pelener, mordomo de Niv-Mizzet\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356878&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bba1f867-92f9-4e6e-a2eb-52f918d5aa9e\', \'multiverseId\': 356878}, \'multiverseid\': 356878}, {\'name\': \'Парализующая Хватка\', \'text\': \'Зачаровать существо\\nЗачарованное существо не разворачивается во время шага разворота контролирующего его игрока.\', \'type\': \'Чары — Аура\', \'flavor\': \'«Очевидно, что ради достижения целей Огненного Разума можно пренебречь парочкой гоблинов». — Пеленер, мажордом Нив-Миззета\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355234&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b7a15752-7520-489d-834b-ea735f3e76e5\', \'multiverseId\': 355234}, \'multiverseid\': 355234}, {\'name\': \'麻痹攫\', \'text\': \'结附于生物\\n所结附的生物于其操控者的重置步骤中不能重置。\', \'type\': \'结界～灵气\', \'flavor\': \'「显然，和炎灵的任务一比，几只鬼怪算不了什么。」 ～尼米捷侍从佩连纳\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357152&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e2c5a37c-6d60-41f5-b814-cb04eb9ec18f\', \'multiverseId\': 357152}, \'multiverseid\': 357152}, {\'name\': \'麻痺攫\', \'text\': \'結附於生物\\n所結附的生物於其操控者的重置步驟中不能重置。\', \'type\': \'結界～靈氣\', \'flavor\': \'「顯然，和炎靈的任務一比，幾個鬼怪算不了什麼。」 ～尼米捷侍從佩連納\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355508&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'039b2482-9ac3-42e8-88ed-d768581f3c66\', \'multiverseId\': 355508}, \'multiverseid\': 355508}]', '[{\'name\': \'Lähmungsnadel\', \'text\': \'Sowie die Lähmungsnadel ins Spiel kommt, benenne eine Karte.\\nAktivierte Fähigkeiten von Quellen mit dem bestimmten Namen können nicht aktiviert werden, außer es sind Manafähigkeiten.\', \'type\': \'Artefakt\', \'flavor\': \'Die Furchtsamen hätten die Operation gerne vor dem Blutfest. Wer sich schuldig gemacht hat, will sie danach.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355967&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d68dc346-35da-4f7f-8eb2-8b300ad805cd\', \'multiverseId\': 355967}, \'multiverseid\': 355967}, {\'name\': \'Aguja medular\', \'text\': \'En cuanto la Aguja medular entre al campo de batalla, nombra una carta.\\nLas habilidades activadas de las fuentes con el nombre elegido no pueden activarse a menos que sean habilidades de maná.\', \'type\': \'Artefacto\', \'flavor\': \'Los temerosos quieren ser operados antes de un festival de la sangre. Los culpables desean ser operados después.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365689&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'49a1e562-9f58-4f13-bfba-76fb0acdf074\', \'multiverseId\': 365689}, \'multiverseid\': 365689}, {\'name\': \'Aiguille à sectionner\', \'text\': "Au moment où l\'Aiguille à sectionner arrive sur le champ de bataille, nommez une carte.\\nLes capacités activées des sources du nom choisi ne peuvent pas être activées à moins qu\'elles ne soient des capacités de mana.", \'type\': \'Artefact\', \'flavor\': "Les craintifs veulent subir l\'opération avant un festival de sang. Les coupables, après.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356241&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cbaa734c-7e94-4703-9cd0-a128477db13e\', \'multiverseId\': 356241}, \'multiverseid\': 356241}, {\'name\': \'Ago Spinale\', \'text\': "Mentre l\'Ago Spinale entra nel campo di battaglia, nomina una carta.\\nLe abilità attivate delle fonti col nome scelto non possono essere attivate a meno che non siano abilità di mana.", \'type\': \'Artefatto\', \'flavor\': \'I timorosi invocano la procedura prima di un festival del sangue. I colpevoli la cercano dopo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356515&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'305e6374-c8de-4dd6-80db-97adfcfde4eb\', \'multiverseId\': 356515}, \'multiverseid\': 356515}, {\'name\': \'真髄の針\', \'text\': \'真髄の針が戦場に出るに際し、カード名を１つ指定する。\\n選ばれた名前を持つ発生源の起動型能力は、それがマナ能力でないかぎり起動できない。\', \'type\': \'アーティファクト\', \'flavor\': \'恐れる者は血の祭りの前に処置を求める。罪人は祭りの後で処置を求める。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356789&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'15deaaa9-5619-4557-b8ba-b3b387f9def0\', \'multiverseId\': 356789}, \'multiverseid\': 356789}, {\'name\': \'연수에 꽂는 바늘\', \'text\': \'연수에 꽂는 바늘이 전장에 들어오면서, 카드 한 장을 호명한다.\\n호명된 이름을 가진 원천의 활성화능력은 마나 능력이 아닌 한 활성화될 수 없다.\', \'type\': \'마법물체\', \'flavor\': \'두려움에 떠는 자들은 피의 축제 전에 시술을 받기를 원하고, 죄책감을 느끼는 자들은 축제 이후에 시술을 받기를 원한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357611&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8c1a2977-a5f9-4e99-a8b9-8a3ec364ccc5\', \'multiverseId\': 357611}, \'multiverseid\': 357611}, {\'name\': \'Agulha Medular\', \'text\': \'Conforme Agulha Medular entra no campo de batalha, nomeie um card.\\nAs habilidades ativadas de fontes com o nome escolhido não podem ser ativadas a menos que sejam habilidades de mana.\', \'type\': \'Artefato\', \'flavor\': \'Os temerosos desejam o procedimento antes do festival do sangue. Os culpados o procuram depois.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357063&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'45f3055b-af0a-4067-bb34-40ef34e7a3ab\', \'multiverseId\': 357063}, \'multiverseid\': 357063}, {\'name\': \'Смертельная Игла\', \'text\': \'При выходе Смертельной Иглы на поле битвы назовите карту.\\nАктивируемые способности источников с выбранным именем не могут быть активированы, если только они не являются мана-способностями.\', \'type\': \'Артефакт\', \'flavor\': \'Страшащиеся хотят, чтобы процедуру провели до начала Праздника крови. Виновные желают ее после.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355419&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f92b3d91-5528-4f4e-be6d-dce1e4f92195\', \'multiverseId\': 355419}, \'multiverseid\': 355419}, {\'name\': \'穿髓金针\', \'text\': \'于穿髓金针进战场时，说出一张牌的名称。\\n除了法术力异能之外，具有该名称之来源的起动式异能都不能起动。\', \'type\': \'神器\', \'flavor\': \'怯懦者想在血腥节庆开始之前刺上一针。罪人则是在之后。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357337&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e3fa35e6-d805-4cd4-b614-702b8000bc2a\', \'multiverseId\': 357337}, \'multiverseid\': 357337}, {\'name\': \'穿髓金針\', \'text\': \'於穿髓金針進戰場時，說出一張牌的名稱。\\n除了魔法力異能之外，具有該名稱之來源的起動式異能都不能起動。\', \'type\': \'神器\', \'flavor\': \'怯懦者想在血腥節慶開始之前刺上一針。罪人則是在之後。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355693&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'948a796b-1fd5-4636-bee2-a835defadfef\', \'multiverseId\': 355693}, \'multiverseid\': 355693}]', '[{\'name\': \'Machtladung\', \'text\': \'Eine Kreatur deiner Wahl, die du kontrollierst, erhält bis zum Ende des Zuges +2/+0.\\nÜberlast {2}{R} (Du kannst diesen Zauber zu seinen Überlast-Kosten wirken. Falls du dies tust, verändere seinen Text, indem du im Text alle Vorkommen von „deiner Wahl" durch „jeder" ersetzt.)\', \'type\': \'Spontanzauber\', \'flavor\': \'Es geht nichts über ein paar Blitze, um für Chancengleichheit zu sorgen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355828&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8bb12179-e4ab-4f61-a6b5-37dd22f2a5b0\', \'multiverseId\': 355828}, \'multiverseid\': 355828}, {\'name\': \'Dinacargar\', \'text\': \'La criatura objetivo que controlas obtiene +2/+0 hasta el final del turno.\\nSobrecarga {2}{R}. (Puedes lanzar este hechizo por su coste de sobrecarga. Si lo haces, cambia su texto reemplazando "la criatura objetivo" por "cada criatura".)\', \'type\': \'Instantáneo\', \'flavor\': \'Nada equilibra tanto la balanza como unos cuantos relámpagos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365550&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'aa77f4e2-92b0-4169-9746-089e8e039e4e\', \'multiverseId\': 365550}, \'multiverseid\': 365550}, {\'name\': \'Dynacharge\', \'text\': "La créature ciblée que vous contrôlez gagne +2/+0 jusqu\'à la fin du tour.\\nSurcharge {2}{R} (Vous pouvez lancer ce sort pour son coût de surcharge. Si vous faites ainsi, modifiez son texte en remplaçant toutes les occurrences de « ciblé(e) » par « chaque ».)", \'type\': \'Éphémère\', \'flavor\': "Rien ne rétablit mieux l\'équilibre des choses qu\'une petite décharge électrique.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356102&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'584f6d11-a6af-4b9a-bc88-982f073c8653\', \'multiverseId\': 356102}, \'multiverseid\': 356102}, {\'name\': \'Dinamocarica\', \'text\': \'Una creatura bersaglio che controlli prende +2/+0 fino alla fine del turno.\\nSovraccarico {2}{R} (Puoi lanciare questa magia per il suo costo di sovraccarico. Se lo fai, cambiane il testo sostituendo "una creatura bersaglio" con "ogni creatura".)\', \'type\': \'Istantaneo\', \'flavor\': "Non c\'è niente come un po\' di fulmini per riequilibrare le sorti di uno scontro.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356376&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0e191803-57e2-41ef-865a-da44e99c631c\', \'multiverseId\': 356376}, \'multiverseid\': 356376}, {\'name\': \'馬力充電\', \'text\': \'あなたがコントロールするクリーチャー１体を対象とする。それはターン終了時まで＋２/＋０の修整を受ける。\\n超過 {2}{R} （あなたはこの呪文をその超過コストで唱えてもよい。そうした場合、あなたがコントロールしている各クリーチャーは、ターン終了時までそれぞれ＋２/＋０の修整を受ける。）\', \'type\': \'インスタント\', \'flavor\': \'勝率を五分五分にしたければ、ちょっとした稲妻が一番だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356650&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f34c9ce3-0089-4caa-8fa3-89e6a179c2c6\', \'multiverseId\': 356650}, \'multiverseid\': 356650}, {\'name\': \'활력충전\', \'text\': \'당신이 조종하는 생물 한 개를 목표로 정한다. 그 생물은 턴종료까지 +2/+0을 받는다.\\n과부하 {2}{R} (당신은 과부하 비용을 지불하여 이 주문을 발동할 수 있다. 그럴 경우, 이 주문은 "당신이 조종하는 각 생물은 턴종료까지 +2/+0을 받는다"로 내용이 변한다.)\', \'type\': \'순간마법\', \'flavor\': \'열세를 극복하는 데에는 번개만큼 좋은 것이 없다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357472&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a4fe4367-0cce-4408-b8f3-ee76370ad158\', \'multiverseId\': 357472}, \'multiverseid\': 357472}, {\'name\': \'Dinamocarga\', \'text\': \'A criatura alvo que você controla recebe +2/+0 até o final do turno.\\nSobrecarga {2}{R} (Você pode conjurar esta mágica pagando seu custo de sobrecarga. Se fizer isso, altere seu texto substituindo todas as ocorrências de "a criatura alvo" por "cada criatura".)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Nada equilibra as coisas tão bem quanto uns raiozinhos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356924&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ff75178f-599e-4e5f-bcba-1b8d748db3d5\', \'multiverseId\': 356924}, \'multiverseid\': 356924}, {\'name\': \'Динамозаряд\', \'text\': \'Целевое существо под вашим контролем получает +2/+0 до конца хода.\\nПерегрузка {2}{R} (Вы можете разыграть это заклинание за его стоимость Перегрузки. Если вы это делаете, измените в его тексте все слова «целевой» на «каждый».)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Ничто не уравнивает шансы так, как молния.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355280&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9773a815-5bfc-4709-92a1-5b21e621f692\', \'multiverseId\': 355280}, \'multiverseid\': 355280}, {\'name\': \'动力灌注\', \'text\': \'目标由你操控的生物得+2/+0直到回合结束。\\n超载{2}{R}（你可以支付此咒语的超载费用来施放它。如果你如此作，将其中的「目标」字样全部更改为「每个」。）\', \'type\': \'瞬间\', \'flavor\': \'一点小小的雷电就能完美抵销劣势。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357198&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bdefdd65-cd59-46ca-b79f-8f13564e63b7\', \'multiverseId\': 357198}, \'multiverseid\': 357198}, {\'name\': \'動力灌注\', \'text\': \'目標由你操控的生物得+2/+0直到回合結束。\\n超載{2}{R}（你可以支付此咒語的超載費用來施放它。如果你如此作，將其中的「目標」字樣全部更改為「每個」。）\', \'type\': \'瞬間\', \'flavor\': \'一點小小的雷電就能完美抵銷劣勢。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355554&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'be4489cb-2f22-4e07-8212-18a84b098d9a\', \'multiverseId\': 355554}, \'multiverseid\': 355554}]', '[{\'name\': \'Manablüte\', \'text\': \'Die Manablüte kommt mit X Ladungsmarken ins Spiel.\\nEntferne eine Ladungsmarke von der Manablüte: Erhöhe deinen Manavorrat um ein Mana einer beliebigen Farbe. Aktiviere diese Fähigkeit nur einmal pro Zug.\\nFalls zu Beginn deines Versorgungssegments keine Ladungsmarken auf der Manablüte liegen, bringe sie auf die Hand ihres Besitzers zurück.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355866&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'54c0a7f1-a545-40ff-854c-fd4780006fb5\', \'multiverseId\': 355866}, \'multiverseid\': 355866}, {\'name\': \'Florecimiento de maná\', \'text\': \'El Florecimiento de maná entra al campo de batalla con X contadores de carga sobre él.\\nRemover un contador de carga del Florecimiento de maná: Agrega un maná de cualquier color a tu reserva de maná. Activa esta habilidad sólo una vez cada turno.\\nAl comienzo de tu mantenimiento, si el Florecimiento de maná no tiene contadores de carga sobre él, regrésalo a la mano de su propietario.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365588&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'73fed6d8-20ad-4221-b21f-55ca0368c6b8\', \'multiverseId\': 365588}, \'multiverseid\': 365588}, {\'name\': \'Floraison de mana\', \'text\': "La Floraison de mana arrive sur le champ de bataille avec X marqueurs « charge » sur elle.\\nRetirez un marqueur « charge » de la Floraison de mana : Ajoutez un mana de la couleur de votre choix à votre réserve. N\'activez cette capacité qu\'une seule fois par tour.\\nAu début de votre entretien, si la Floraison de mana n\'a aucun marqueur « charge » sur elle, renvoyez-la dans la main de son propriétaire.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356140&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'74022a89-83c4-4933-b03f-066c2bbd4acb\', \'multiverseId\': 356140}, \'multiverseid\': 356140}, {\'name\': \'Fioritura di Mana\', \'text\': "La Fioritura di Mana entra nel campo di battaglia con X segnalini carica.\\nRimuovi un segnalino carica dalla Fioritura di Mana: Aggiungi un mana di un qualsiasi colore alla tua riserva di mana. Attiva questa abilità solo una volta per turno.\\nAll\'inizio del tuo mantenimento, se la Fioritura di Mana non ha segnalini carica, falla tornare in mano al suo proprietario.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356414&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'61c1c5e9-c678-44a9-9bb8-df681d33426b\', \'multiverseId\': 356414}, \'multiverseid\': 356414}, {\'name\': \'マナの花\', \'text\': \'マナの花は、蓄積カウンターがＸ個置かれた状態で戦場に出る。\\nマナの花の上から蓄積カウンターを１個取り除く：あなたのマナ・プールに、好きな色１色のマナ１点を加える。この能力は、毎ターン１回のみ起動できる。\\nあなたのアップキープの開始時に、マナの花の上に蓄積カウンターが置かれていなかった場合、これをオーナーの手札に戻す。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356688&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'768a7ba4-840f-4f47-b185-b181238ff948\', \'multiverseId\': 356688}, \'multiverseid\': 356688}, {\'name\': \'마나 만발\', \'text\': \'마나 만발은 충전 카운터 X개를 가진 채로 전장에 들어온다.\\n마나 만발에서 충전 카운터 한 개를 제거한다: 당신의 마나풀에 원하는 색의 마나 한 개를 담는다. 이 능력은 한 턴에 한 번씩만 활성화할 수 있다.\\n당신의 유지단 시작에, 마나 만발에 충전 카운터가 없다면 마나 만발을 소유자의 손으로 되돌린다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357510&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4abb8615-0436-4f48-ab19-8ee5114275ee\', \'multiverseId\': 357510}, \'multiverseid\': 357510}, {\'name\': \'Florescência de Mana\', \'text\': \'Florescência de Mana entra no campo de batalha com X marcadores de carga.\\nRemova um marcador de carga de Florescência de Mana: Adicione um mana de qualquer cor à sua reserva de mana. Ative esta habilidade apenas uma vez a cada turno.\\nNo início de sua manutenção, se Florescência de Mana não tiver um marcador, devolva-a para a mão de seu dono.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356962&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e971810a-f083-4d9a-9ce0-9015eb04bb26\', \'multiverseId\': 356962}, \'multiverseid\': 356962}, {\'name\': \'Расцвет Маны\', \'text\': \'Расцвет Маны выходит на поле битвы с X жетонами заряда на нем.\\nУдалите один жетон заряда с Расцвета Маны: добавьте одну ману любого цвета в ваше хранилище маны. Активируйте эту способность только один раз за ход.\\nВ начале вашего шага поддержки, если на Расцвете Маны нет жетонов заряда, верните его в руку его владельца.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355318&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d9d8473f-fcda-4e52-b81d-6266a23f8bd5\', \'multiverseId\': 355318}, \'multiverseid\': 355318}, {\'name\': \'魔力绽华\', \'text\': \'魔力绽华进战场时上面有X个充电指示物。\\n从魔力绽华上移去一个充电指示物：加一点任意颜色的法术力到你的法术力池中。此异能每回合只能起动一次。\\n在你的维持开始时，若魔力绽华上面没有充电指示物，将它移回其拥有者手上。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357236&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'52e98753-c084-43ad-a83a-1e0a1ce67d67\', \'multiverseId\': 357236}, \'multiverseid\': 357236}, {\'name\': \'魔力綻華\', \'text\': \'魔力綻華進戰場時上面有X個充電指示物。\\n從魔力綻華上移去一個充電指示物：加一點任意顏色的魔法力到你的魔法力池中。此異能每回合只能起動一次。\\n在你的維持開始時，若魔力綻華上面沒有充電指示物，將它移回其擁有者手上。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355592&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'46fa66e9-9690-4e56-b522-b91aaf8e8bc5\', \'multiverseId\': 355592}, \'multiverseid\': 355592}]', '[{\'name\': \'Meuchelnde Thrill-Killerin\', \'text\': \'Todesberührung\\nEntfesselt (Du kannst diese Kreatur mit einer +1/+1-Marke ins Spiel kommen lassen. Sie kann nicht blocken, solange eine +1/+1-Marke auf ihr liegt.)\', \'type\': \'Kreatur — Mensch, Assassine\', \'flavor\': \'Im gleichen Maß wie das Kopfgeld für das Massakermädel stieg auch die Anzahl der Nachahmer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355817&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5eb99c52-3129-4a87-a622-1b93bf98292f\', \'multiverseId\': 355817}, \'multiverseid\': 355817}, {\'name\': \'Asesina emoción mortal\', \'text\': \'Toque mortal.\\nDesatar. (Puedes hacer que esta criatura entre al campo de batalla con un contador +1/+1 sobre ella. No puede bloquear mientras tenga un contador +1/+1 sobre ella.)\', \'type\': \'Criatura — Asesino humano\', \'flavor\': \'Conforme aumentó el precio por la cabeza de la Niña Masacre, también lo hizo el número de imitadores.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365539&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6c24e0eb-8752-492a-b3c0-a9f1829f42cf\', \'multiverseId\': 365539}, \'multiverseid\': 365539}, {\'name\': \'Assassin enivré par la tuerie\', \'text\': "Contact mortel\\nEmportement (Vous pouvez faire arriver cette créature sur le champ de bataille avec un marqueur +1/+1 sur elle. Elle ne peut pas bloquer tant qu\'elle a un marqueur +1/+1 sur elle.)", \'type\': \'Créature : humain et assassin\', \'flavor\': "Plus la récompense promise pour la tête de la Massacreuse augmentait, plus elle avait d\'imitateurs.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356091&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'23ede1e1-7cac-471b-bca5-9008b9f5dc05\', \'multiverseId\': 356091}, \'multiverseid\': 356091}, {\'name\': \'Assassina di Brivido Omicida\', \'text\': \'Tocco letale\\nScatenare (Puoi far entrare questa creatura nel campo di battaglia con un segnalino +1/+1. Non può bloccare fintanto che ha un segnalino +1/+1.)\', \'type\': \'Creatura — Assassino Umano\', \'flavor\': \'Il numero di imitatori della Fanciulla del Massacro cresceva di pari passo con la taglia sulla sua testa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356365&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0a0b3570-435c-46bc-b6a8-60d17b6b777e\', \'multiverseId\': 356365}, \'multiverseid\': 356365}, {\'name\': \'快楽殺人の暗殺者\', \'text\': \'接死\\n解鎖（あなたはこのクリーチャーを、＋１/＋１カウンターが１個置かれた状態で戦場に出してよい。これの上に＋１/＋１カウンターが置かれているかぎり、これではブロックできない。）\', \'type\': \'クリーチャー — 人間・暗殺者\', \'flavor\': \'虐殺少女の懸賞金が上がるにつれて、模倣犯の数も増えていった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356639&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b7187ce3-ee42-4fc3-9127-90392fdd22fa\', \'multiverseId\': 356639}, \'multiverseid\': 356639}, {\'name\': \'살육을 즐기는 암살자\', \'text\': \'치명타\\n속박해제 (당신은 이 생물로 하여금 +1/+1 카운터 한 개를 가지고 전장에 들어오도록 할 수 있다. 이 생물은 +1/+1 카운터를 가지고 있는 한 방어할 수 없다.)\', \'type\': \'생물 — 인간 암살자\', \'flavor\': \'대학살의 소녀에 대한 현상금이 올라갈수록 모방범죄의 수도 늘어났다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357461&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8443d209-fa75-4d5f-973d-d135e16f152f\', \'multiverseId\': 357461}, \'multiverseid\': 357461}, {\'name\': \'Assassino Hedonista\', \'text\': \'Toque mortífero\\nLiberar (Você pode fazer com que esta criatura entre no campo de batalha com um marcador +1/+1. Ela não poderá bloquear enquanto tiver um marcador +1/+1.)\', \'type\': \'Criatura — Humano Assassino\', \'flavor\': \'À medida que a recompensa pela Garota-Massacre aumentava, aumentava também o número de imitadores.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356913&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'85a19151-9633-4863-b1ba-5b999e0e550c\', \'multiverseId\': 356913}, \'multiverseid\': 356913}, {\'name\': \'Убийца из Удовольствия\', \'text\': \'Смертельное касание\\nБезудержность (Вы можете заставить это существо выйти на поле битвы с жетоном +1/+1 на нем. Оно не может блокировать, пока на нем есть жетон +1/+1.)\', \'type\': \'Существо — Человек Убийца\', \'flavor\': \'Чем больше предлагали награду за голову Вырезательницы, тем больше становилось у нее подражателей.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355269&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'46a82f71-d189-46ff-8534-15175c4756d2\', \'multiverseId\': 355269}, \'multiverseid\': 355269}, {\'name\': \'虐杀手\', \'text\': \'死触\\n脱缰（你可以让此生物进战场时上面有一个+1/+1指示物。只要其上有+1/+1指示物，它就不能进行阻挡。）\', \'type\': \'生物～人类／杀手\', \'flavor\': \'随着杀戮女郎的悬赏奖金变多，模仿她的人也变多了。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357187&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6ed4a420-db47-40e9-81d3-7529235f3716\', \'multiverseId\': 357187}, \'multiverseid\': 357187}, {\'name\': \'虐殺手\', \'text\': \'死觸\\n脫韁（你可以讓此生物進戰場時上面有一個+1/+1指示物。只要其上有+1/+1指示物，它就不能進行阻擋。）\', \'type\': \'生物～人類／殺手\', \'flavor\': \'隨著殺戮女郎的懸賞獎金變多，模仿她的人也變多了。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355543&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'08ff1580-80b0-4538-9cd3-c38bf8f4cef9\', \'multiverseId\': 355543}, \'multiverseid\': 355543}]', '[{\'name\': \'Mietskasernen-Zertrampler\', \'text\': \'Eile\', \'type\': \'Kreatur — Bestie\', \'flavor\': \'Nichts würde ihn aufhalten — nicht die engen Gassen, nicht die Boros-Garnison und erst recht nicht die vierstöckige Kathedrale der Orzhov.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355844&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'10ca67ec-cd8e-4571-a35c-da7b5f1c4369\', \'multiverseId\': 355844}, \'multiverseid\': 355844}, {\'name\': \'Rompeviviendas\', \'text\': \'Prisa.\', \'type\': \'Criatura — Bestia\', \'flavor\': \'Nada iba a detenerlo; ni los callejones estrechos, ni la guarnición boros, ni desde luego la catedral orzhov de cuatro pisos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365566&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'81499263-45fb-45c9-a715-8295efe71a23\', \'multiverseId\': 365566}, \'multiverseid\': 365566}, {\'name\': "Fracasseur d\'appartements", \'text\': \'Célérité\', \'type\': \'Créature : bête\', \'flavor\': "Rien ne pourrait l\'arrêter, ni l\'étroitesse des ruelles, ni la garnison de Boros, et certainement pas les quatre étages de la cathédrale d\'Orzhov.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356118&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'32596ba3-cc50-4e2a-ab6f-a2fafbb3d5d4\', \'multiverseId\': 356118}, \'multiverseid\': 356118}, {\'name\': \'Intruso nella Proprietà\', \'text\': \'Rapidità\', \'type\': \'Creatura — Bestia\', \'flavor\': \'Nulla poteva fermarlo. Non gli stretti vicoli, né la guarnigione Boros, né tantomeno i quattro piani della cattedrale Orzhov.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356392&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5d9f0282-762d-4465-ab1e-a0a149ef9385\', \'multiverseId\': 356392}, \'multiverseid\': 356392}, {\'name\': \'長屋壊し\', \'text\': \'速攻\', \'type\': \'クリーチャー — ビースト\', \'flavor\': \'何をもってしてもそれは止められなかった――狭い路地でも、ボロスの駐屯地でも、そして四階建てのオルゾフの大聖堂であっても。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356666&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ed820f49-e374-4a32-bec7-eb7b4f0c8777\', \'multiverseId\': 356666}, \'multiverseid\': 356666}, {\'name\': \'날뛰는 주택가 야수\', \'text\': \'신속\', \'type\': \'생물 — 야수\', \'flavor\': \'좁은 골목도, 보로스 주둔지도, 심지어 4층짜리 오르조브 대성당조차도 그것을 막을 수는 없었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357488&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7bf95c0d-76bc-44a9-b7e8-b49e58dbc5a1\', \'multiverseId\': 357488}, \'multiverseid\': 357488}, {\'name\': \'Invasor de Habitação\', \'text\': \'Ímpeto\', \'type\': \'Criatura — Besta\', \'flavor\': \'Nada o deteria. Nem os becos, nem a guarnição Boros, nem, com certeza, a catedral de quatro andares dos Orzhov.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356940&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'72e92b14-e176-4399-ab19-9b8d9d5669b9\', \'multiverseId\': 356940}, \'multiverseid\': 356940}, {\'name\': \'Крушитель Жилищ\', \'text\': \'Ускорение\', \'type\': \'Существо — Зверь\', \'flavor\': \'Ничто не могло его остановить: ни узкие улочки, ни гарнизон Боросов, и уж конечно ни четырехэтажная церковь Орзовов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355296&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d066f3c9-fc11-4dfa-90a9-cb30f6b67561\', \'multiverseId\': 355296}, \'multiverseid\': 355296}, {\'name\': \'居所粉碎兽\', \'text\': \'敏捷\', \'type\': \'生物～野兽\', \'flavor\': \'没有东西可以阻止它～不论狭窄的巷弄、波洛斯驻防地，更不用说四层楼高的欧佐夫圣堂。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357214&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'09efed94-73f9-41e8-9912-aca2463a559b\', \'multiverseId\': 357214}, \'multiverseid\': 357214}, {\'name\': \'居所粉碎獸\', \'text\': \'敏捷\', \'type\': \'生物～野獸\', \'flavor\': \'沒有東西可以阻止牠～不論狹窄的巷弄、波洛斯駐防地，更不用說四層樓高的歐佐夫聖堂。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355570&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'22906856-488c-483d-8951-524ef177c9e9\', \'multiverseId\': 355570}, \'multiverseid\': 355570}]', '[{\'name\': \'Militante Dryade\', \'text\': \'Falls eine Spontanzauber- oder Hexereikarte von irgendwoher auf einen Friedhof gelegt würde, schicke sie stattdessen ins Exil.\', \'type\': \'Kreatur — Dryade, Soldat\', \'flavor\': \'„Wir werden die Weltenseele um jeden Preis gegen den ‚Fortschritt\\\' der Izzet verteidigen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355950&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'79566fcd-cbb9-47a0-84df-c61c5b41a632\', \'multiverseId\': 355950}, \'multiverseid\': 355950}, {\'name\': \'Dríada militante\', \'text\': \'Si una carta de instantáneo o de conjuro fuera a ser puesta en un cementerio desde cualquier parte, en vez de eso, exíliala.\', \'type\': \'Criatura — Soldado dríada\', \'flavor\': \'"Defenderemos el Alma del mundo del \\\'progreso\\\' Ízzet a cualquier precio."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365672&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'463e9772-3045-4a2d-8237-8be960db6692\', \'multiverseId\': 365672}, \'multiverseid\': 365672}, {\'name\': \'Militante dryade\', \'text\': "Si une carte d\'éphémère ou de rituel devait être mise dans un cimetière d\'où qu\'elle vienne, exilez-la à la place.", \'type\': \'Créature : dryade et soldat\', \'flavor\': "« Nous défendrons à tout prix l\'Âme du monde contre les prétendus progrès des Izzet. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356224&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'79b34590-bbc0-4822-b10e-46d87983f67a\', \'multiverseId\': 356224}, \'multiverseid\': 356224}, {\'name\': \'Driade Militante\', \'text\': \'Se una carta istantaneo o stregoneria sta per essere messa in un cimitero da qualsiasi zona, invece esiliala.\', \'type\': \'Creatura — Soldato Driade\', \'flavor\': \'"Difenderemo l\\\'Anima del Mondo dal \\\'progresso\\\' degli Izzet a ogni costo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356498&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7198a378-8b17-4737-870f-fc0159b70db7\', \'multiverseId\': 356498}, \'multiverseid\': 356498}, {\'name\': \'ドライアドの闘士\', \'text\': \'インスタント・カードかソーサリー・カードがいずれかの領域からいずれかの墓地に置かれる場合、代わりにそれを追放する。\', \'type\': \'クリーチャー — ドライアド・兵士\', \'flavor\': \'「私達はどんな犠牲を払おうともイゼットの"進歩"から世界魂を守り抜く。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356772&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'392bef1d-520f-4066-a1f6-748c9c046c05\', \'multiverseId\': 356772}, \'multiverseid\': 356772}, {\'name\': \'호전적 드라이어드\', \'text\': \'순간마법 또는 집중마법 카드가 어디에서부터든 무덤에 들어가려고 하면, 대신에 그 카드를 추방한다.\', \'type\': \'생물 — 드라이어드 병사\', \'flavor\': \'"어떤 대가를 치르더라도 이젯의 \\\'진보\\\'로부터 세계의 영혼을 지킬 것이다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357594&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'742f7d99-f664-4196-a589-c56499c31d00\', \'multiverseId\': 357594}, \'multiverseid\': 357594}, {\'name\': \'Militante Dríade\', \'text\': \'Se um card de mágica instantânea ou feitiço seria colocado em um cemitério vindo de qualquer lugar, em vez disso, exile-o.\', \'type\': \'Criatura — Dríade Soldado\', \'flavor\': \'"Vamos defender a Grande Anima do \\\'progresso\\\' dos Izzet a qualquer custo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357046&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ba766559-1ad2-4d75-88f8-691ece0bc831\', \'multiverseId\': 357046}, \'multiverseid\': 357046}, {\'name\': \'Воинственная Дриада\', \'text\': \'Если карта мгновенного заклинания или волшебства должна быть положена откуда-либо на кладбище, изгоните ее вместо этого.\', \'type\': \'Существо — Дриада Солдат\', \'flavor\': \'«Мы защитим Всесознание от иззетского "прогресса" — любой ценой».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355402&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'73e8f0f1-81b2-4122-8928-769353666ac3\', \'multiverseId\': 355402}, \'multiverseid\': 355402}, {\'name\': \'好斗树灵\', \'text\': \'如果任一瞬间或法术牌将从任何地方置入坟墓场，改为将它放逐。\', \'type\': \'生物～树灵／士兵\', \'flavor\': \'「我们将不惜一切代价，保卫世界之魂免遭伊捷侵蚀。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357320&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fec2d39f-0930-46c0-949c-88d42d8734cd\', \'multiverseId\': 357320}, \'multiverseid\': 357320}, {\'name\': \'好鬥樹靈\', \'text\': \'如果任一瞬間或巫術牌將從任何地方置入墳墓場，改為將它放逐。\', \'type\': \'生物～樹靈／士兵\', \'flavor\': \'「我們將不計代價捍衛世界之魂，對抗來自伊捷的『進步』。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355676&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bc9b6767-f1b0-4a5d-9e17-1747ad5f6dc6\', \'multiverseId\': 355676}, \'multiverseid\': 355676}]', '[{\'name\': \'Mizziumhaut\', \'text\': \'Bis zum Ende des Zuges erhält eine Kreatur deiner Wahl, die du kontrollierst, +0/+1 und ist fluchsicher.\\nÜberlast {1}{U} (Du kannst diesen Zauber zu seinen Überlast-Kosten wirken. Falls du dies tust, verändere seinen Text, indem du im Text alle Vorkommen von „deiner Wahl" durch „jeder" ersetzt.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355781&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'30c636a3-5daa-4835-9ffd-e0e219838d5b\', \'multiverseId\': 355781}, \'multiverseid\': 355781}, {\'name\': \'Piel de mízzium\', \'text\': \'La criatura objetivo que controlas obtiene +0/+1 y gana la habilidad de antimaleficio hasta el final del turno.\\nSobrecarga {1}{U}. (Puedes lanzar este hechizo por su coste de sobrecarga. Si lo haces, cambia su texto reemplazando "la criatura objetivo" por "cada criatura".)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365503&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dece1f6e-67e1-4474-acb0-81f432956e2d\', \'multiverseId\': 365503}, \'multiverseid\': 365503}, {\'name\': \'Peau de mizzium\', \'text\': "La créature ciblée que vous contrôlez gagne +0/+1 et acquiert la défense talismanique jusqu\'à la fin du tour.\\nSurcharge {1}{U} (Vous pouvez lancer ce sort pour son coût de surcharge. Si vous faites ainsi, modifiez son texte en remplaçant toutes les occurrences de « ciblé(e) » par « chaque ».)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356055&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'707e9b00-a19f-4829-9475-555cb90f76f6\', \'multiverseId\': 356055}, \'multiverseid\': 356055}, {\'name\': \'Pelle di Mizzium\', \'text\': \'Una creatura bersaglio che controlli prende +0/+1 e ha anti-malocchio fino alla fine del turno.\\nSovraccarico {1}{U} (Puoi lanciare questa magia per il suo costo di sovraccarico. Se lo fai, cambiane il testo sostituendo "una creatura bersaglio" con "ogni creatura".)\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356329&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e689b7ec-8f94-4e5e-9da2-1189760ac2cd\', \'multiverseId\': 356329}, \'multiverseid\': 356329}, {\'name\': \'ミジウムの外皮\', \'text\': \'あなたがコントロールするクリーチャー１体を対象とする。それはターン終了時まで＋０/＋１の修整を受けるとともに呪禁を得る。\\n超過 {1}{U} （あなたはこの呪文をその超過コストで唱えてもよい。そうした場合、あなたがコントロールする各クリーチャーは、ターン終了時までそれぞれ＋０/＋１の修整を受けるとともに呪禁を得る。）\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356603&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1a4166f2-572f-45bb-86aa-bb100e147a4a\', \'multiverseId\': 356603}, \'multiverseid\': 356603}, {\'name\': \'미지움 피부\', \'text\': \'당신이 조종하는 생물 한 개를 목표로 정한다. 그 생물은 턴종료까지 +0/+1을 받고 방호 능력을 얻는다.\\n과부하 {1}{U} (당신은 과부하 비용을 지불하여 이 주문을 발동할 수 있다. 그럴 경우, 이 주문은 "당신이 조종하는 각 생물은 턴종료까지 +0/+1을 받고 방호 능력을 얻는다"로 내용이 변한다.)\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357425&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b0fad55e-fd4b-4b0d-bd00-71615ab077bc\', \'multiverseId\': 357425}, \'multiverseid\': 357425}, {\'name\': \'Pele de Mizzium\', \'text\': \'A criatura alvo que você controla recebe +0/+1 e ganha resistência à magia até o final do turno.\\nSobrecarga {1}{U} (Você pode conjurar esta mágica pagando seu custo de sobrecarga. Se fizer isso, altere seu texto substituindo todas as ocorrências de "a criatura alvo" por "cada criatura".)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356877&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1394c528-bae6-427e-a4b4-4f038154df42\', \'multiverseId\': 356877}, \'multiverseid\': 356877}, {\'name\': \'Миззиевая Кожа\', \'text\': \'Целевое существо под вашим контролем получает +0/+1 и Порчеустойчивость до конца хода.\\nПерегрузка {1}{U} (Вы можете разыграть это заклинание за его стоимость Перегрузки. Если вы это делаете, измените в его тексте все слова «целевой» на «каждый».)\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355233&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'24de605c-51c6-4eeb-8e38-9320bfb8d6a3\', \'multiverseId\': 355233}, \'multiverseid\': 355233}, {\'name\': \'米捷外皮\', \'text\': \'目标由你操控的生物得+0/+1并获得辟邪异能直到回合结束。\\n超载{1}{U}（你可以支付此咒语的超载费用来施放它。如果你如此作，将其中的「目标」字样全部更改为「每个」。）\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357151&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b5ab9e70-fae2-4782-9b8b-e186c060a98c\', \'multiverseId\': 357151}, \'multiverseid\': 357151}, {\'name\': \'米捷外皮\', \'text\': \'目標由你操控的生物得+0/+1並獲得辟邪異能直到回合結束。\\n超載{1}{U}（你可以支付此咒語的超載費用來施放它。如果你如此作，將其中的「目標」字樣全部更改為「每個」。）\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355507&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c80eb3d9-5310-43d5-be5e-7b3e09b6d86a\', \'multiverseId\': 355507}, \'multiverseid\': 355507}]', '[{\'name\': \'Mizziummörser\', \'text\': \'Der Mizziummörser fügt einer Kreatur deiner Wahl, die du nicht kontrollierst, 4 Schadenspunkte zu.\\nÜberlast {3}{R}{R}{R} (Du kannst diesen Zauber zu seinen Überlast-Kosten wirken. Falls du dies tust, verändere seinen Text, indem du im Text alle Vorkommen von „deiner Wahl" durch „jeder" ersetzt.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355837&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d92318dd-0b7b-47c7-8d6f-64bff033ba49\', \'multiverseId\': 355837}, \'multiverseid\': 355837}, {\'name\': \'Morteros de mízzium\', \'text\': \'Los Morteros de mízzium hacen 4 puntos de daño a la criatura objetivo que no controlas.\\nSobrecarga {3}{R}{R}{R}. (Puedes lanzar este hechizo por su coste de sobrecarga. Si lo haces, cambia su texto reemplazando "la criatura objetivo" por "cada criatura".)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365559&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0a49ecdb-6d78-4323-9332-500918066df2\', \'multiverseId\': 365559}, \'multiverseid\': 365559}, {\'name\': \'Mortiers de mizzium\', \'text\': \'Les Mortiers de mizzium infligent 4 blessures à une créature ciblée que vous ne contrôlez pas.\\nSurcharge {3}{R}{R}{R} (Vous pouvez lancer ce sort pour son coût de surcharge. Si vous faites ainsi, modifiez son texte en remplaçant toutes les occurrences de « ciblé(e) » par « chaque ».)\', \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356111&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'55a6eaa1-23c2-4800-b881-5fc4cb4ec434\', \'multiverseId\': 356111}, \'multiverseid\': 356111}, {\'name\': \'Mortai di Mizzium\', \'text\': \'I Mortai di Mizzium infliggono 4 danni a una creatura bersaglio che non controlli.\\nSovraccarico {3}{R}{R}{R} (Puoi lanciare questa magia per il suo costo di sovraccarico. Se lo fai, cambiane il testo sostituendo "una creatura bersaglio" con "ogni creatura".)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356385&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'04992f1f-a86d-4032-b8bb-b04f6fb61f46\', \'multiverseId\': 356385}, \'multiverseid\': 356385}, {\'name\': \'ミジウムの迫撃砲\', \'text\': \'あなたがコントロールしていないクリーチャー１体を対象とする。ミジウムの迫撃砲はそれに４点のダメージを与える。\\n超過 {3}{R}{R}{R} （あなたはこの呪文をその超過コストで唱えてもよい。そうした場合、ミジウムの迫撃砲はあなたがコントロールしていない各クリーチャーにそれぞれ４点のダメージを与える。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356659&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fe76cd15-6316-4820-a5c4-ed0446ed2748\', \'multiverseId\': 356659}, \'multiverseid\': 356659}, {\'name\': \'미지움 박격포\', \'text\': \'당신이 조종하지 않는 생물 한 개를 목표로 정한다. 미지움 박격포는 그 생물에게 피해 4점을 입힌다.\\n과부하 {3}{R}{R}{R} (당신은 과부하 비용을 지불하여 이 주문을 발동할 수 있다. 그럴 경우, 이 주문은 "미지움 박격포는 당신이 조종하지 않는 각 생물에게 피해 4점을 입힌다"로 내용이 변한다.)\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357481&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9bc53bb1-0c01-4441-a06b-a7b89d6d5f53\', \'multiverseId\': 357481}, \'multiverseid\': 357481}, {\'name\': \'Morteiros de Mizzium\', \'text\': \'Morteiros de Mizzium causa 4 pontos de dano à criatura alvo que você não controla.\\nSobrecarga {3}{R}{R}{R} (Você pode conjurar esta mágica pagando seu custo de sobrecarga. Se fizer isso, altere seu texto substituindo todas as ocorrências de "a criatura alvo" por "cada criatura".)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356933&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0b407d92-c8d6-44ab-a102-8fbeb329218c\', \'multiverseId\': 356933}, \'multiverseid\': 356933}, {\'name\': \'Миззиевые Мортиры\', \'text\': \'Миззиевые Мортиры наносят 4 повреждения целевому существу не под вашим контролем.\\nПерегрузка {3}{R}{R}{R} (Вы можете разыграть это заклинание за его стоимость Перегрузки. Если вы это делаете, измените в его тексте все слова «целевой» на «каждый».)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355289&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dfbd8f1a-cf1c-4b97-9392-57d2f78953bc\', \'multiverseId\': 355289}, \'multiverseid\': 355289}, {\'name\': \'米捷轰击\', \'text\': \'米捷轰击对目标不由你操控的生物造成4点伤害。\\n超载{3}{R}{R}{R}（你可以支付此咒语的超载费用来施放它。如果你如此作，将其中的「目标」字样全部更改为「每个」。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357207&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ab37fe38-8d92-4e61-8097-f949f61172d8\', \'multiverseId\': 357207}, \'multiverseid\': 357207}, {\'name\': \'米捷轟擊\', \'text\': \'米捷轟擊對目標不由你操控的生物造成4點傷害。\\n超載{3}{R}{R}{R}（你可以支付此咒語的超載費用來施放它。如果你如此作，將其中的「目標」字樣全部更改為「每個」。）\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355563&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'666ca067-840e-492c-8db7-960f38ca7612\', \'multiverseId\': 355563}, \'multiverseid\': 355563}]', '[{\'name\': \'Niv-Mizzet, der geniale Drache\', \'text\': \'Fliegend\\nImmer wenn Niv-Mizzet, der geniale Drache einem Spieler Schaden zufügt, kannst du eine Karte ziehen.\\n{U}{R}: Niv-Mizzet, der geniale Drache fügt einer Kreatur oder einem Spieler deiner Wahl 1 Schadenspunkt zu.\', \'type\': \'Legendäre Kreatur — Drache, Zauberer\', \'flavor\': \'Ihm fehlt die Geduld für Gemüter, die ihn nicht inspirieren oder beim Versuch explodieren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355919&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'03073fa1-1bf3-439c-9a5f-0b1922bea546\', \'multiverseId\': 355919}, \'multiverseid\': 355919}, {\'name\': \'Niv-Mízzet, dracogenio\', \'text\': \'Vuela.\\nSiempre que Niv-Mízzet, dracogenio haga daño de combate a un jugador, puedes robar una carta.\\n{U}{R}: Niv-Mízzet, dracogenio hace 1 punto de daño a la criatura o jugador objetivo.\', \'type\': \'Criatura legendaria — Hechicero dragón\', \'flavor\': \'No tiene paciencia con las mentes que no le inspiran o que estallan al intentarlo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365641&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'077d6c3e-4550-43ff-84aa-2bcec285a7fd\', \'multiverseId\': 365641}, \'multiverseid\': 365641}, {\'name\': \'Niv-Mizzet, dracogénie\', \'text\': \'Vol\\nÀ chaque fois que Niv-Mizzet, dracogénie inflige des blessures à un joueur, vous pouvez piocher une carte.\\n{U}{R} : Niv-Mizzet, dracogénie inflige 1 blessure à une cible, créature ou joueur.\', \'type\': \'Créature légendaire : dragon et sorcier\', \'flavor\': "Il n\'a aucune patience envers les esprits qui ne l\'inspirent pas, ou qui n\'explosent pas en essayant.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356193&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c501b53e-aa19-4f62-827e-ce3a13214f88\', \'multiverseId\': 356193}, \'multiverseid\': 356193}, {\'name\': \'Niv-Mizzet, Dracogenio\', \'text\': \'Volare\\nOgniqualvolta Niv-Mizzet, Dracogenio infligge danno a un giocatore, puoi pescare una carta.\\n{U}{R}: Niv-Mizzet, Dracogenio infligge 1 danno a una creatura o a un giocatore bersaglio.\', \'type\': \'Creatura Leggendaria — Mago Drago\', \'flavor\': \'Non ha pazienza con le menti che non lo stimolano o che esplodono nel tentativo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356467&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a9ab1175-922e-4000-9e0e-adfef0d4265e\', \'multiverseId\': 356467}, \'multiverseid\': 356467}, {\'name\': \'竜英傑、ニヴ＝ミゼット\', \'text\': \'飛行\\n竜英傑、ニヴ＝ミゼットがプレイヤー１人にダメージを与えるたび、あなたはカードを１枚引いてもよい。\\n{U}{R}：クリーチャー１体かプレイヤー１人を対象とする。竜英傑、ニヴ＝ミゼットはそれに１点のダメージを与える。\', \'type\': \'伝説のクリーチャー — ドラゴン・ウィザード\', \'flavor\': \'彼は自分を刺激することのない精神や、そうしようとして爆発することのない精神には容赦がない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356741&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5d90efe9-91aa-4ce6-93a6-d3f9546de097\', \'multiverseId\': 356741}, \'multiverseid\': 356741}, {\'name\': \'천재적인 용 니브-미젯\', \'text\': \'비행\\n천재적인 용 니브-미젯이 플레이어에게 피해를 입힐 때마다, 당신은 카드를 한 장 뽑을 수 있다.\\n{U}{R}: 생물 한 개 또는 플레이어 한 명을 목표로 정한다. 천재적인 용 니브-미젯은 그 목표에게 피해 1점을 입힌다.\', \'type\': \'전설적 생물 — 용 마법사\', \'flavor\': \'그에게 영감을 주거나 적어도 영감을 주려다 정신이 붕괴된 자들만이 니브-미젯의 관심을 받을 수 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357563&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e10481b7-201b-4952-978b-8f16ea5cb5f1\', \'multiverseId\': 357563}, \'multiverseid\': 357563}, {\'name\': \'Niv-Mizzet, Dracogênio\', \'text\': \'Voar\\nToda vez que Niv-Mizzet, Dracogênio, causa dano a um jogador, você pode comprar um card.\\n{U}{R}: Niv-Mizzet, Dracogênio, causa 1 ponto de dano à criatura ou jogador alvo.\', \'type\': \'Criatura Lendária — Dragão Mago\', \'flavor\': \'Ele não tem paciência para mentes que não o inspiram ou que explodem ao tentar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357015&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'43468e51-6c82-4275-8d70-6020cb94184b\', \'multiverseId\': 357015}, \'multiverseid\': 357015}, {\'name\': \'Нив-Миззет, Гений Драконов\', \'text\': \'Полет\\nКаждый раз, когда Нив-Миззет, Гений Драконов наносит повреждения игроку, вы можете взять карту.\\n{U}{R}: Нив-Миззет, Гений Драконов наносит 1 повреждение целевому существу или игроку.\', \'type\': \'Легендарное Существо — Дракон Чародей\', \'flavor\': \'Он терпеть не может умы, неспособные вдохновить его... или взрывающиеся в попытках это сделать.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355371&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ac7b1649-5fab-4549-ba52-978ab0b01229\', \'multiverseId\': 355371}, \'multiverseid\': 355371}, {\'name\': \'龙智者尼米捷\', \'text\': \'飞行\\n每当龙智者尼米捷对一位牌手造成伤害时，你可以抓一张牌。\\n{U}{R}：龙智者尼米捷对目标生物或牌手造成1点伤害。\', \'type\': \'传奇生物～龙／法术师\', \'flavor\': \'对那些无法激起他智识火花、或是因努力尝试而报废的脑袋，他可毫无耐性。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357289&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cd912b03-335a-45fe-b5f5-132d8fcc2115\', \'multiverseId\': 357289}, \'multiverseid\': 357289}, {\'name\': \'龍智者尼米捷\', \'text\': \'飛行\\n每當龍智者尼米捷對一位玩家造成傷害時，你可以抽一張牌。\\n{U}{R}：龍智者尼米捷對目標生物或玩家造成1點傷害。\', \'type\': \'傳奇生物～龍／魔法師\', \'flavor\': \'對那些無法激起他智識火花、或是因努力嘗試而報廢的腦袋，他可毫無耐性。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355645&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ce34ef7e-1d1d-4ac4-a770-b13572400e29\', \'multiverseId\': 355645}, \'multiverseid\': 355645}]', '[{\'name\': \'Nivix-Gildenmagier\', \'text\': \'{1}{U}{R}: Ziehe eine Karte und wirf dann eine Karte aus deiner Hand ab.\\n{2}{U}{R}: Kopiere einen Spontanzauber oder eine Hexerei deiner Wahl, den bzw. die du kontrollierst. Du kannst neue Ziele für die Kopie bestimmen.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'„Die einzige Maßnahme, die zu ergreifen sich lohnt, ist eine mit einem unbekannten Ergebnis."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355918&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e6393f9e-4894-468d-b126-277e7ac938a2\', \'multiverseId\': 355918}, \'multiverseid\': 355918}, {\'name\': \'Mago del gremio de Nívix\', \'text\': \'{1}{U}{R}: Roba una carta, luego descarta una carta.\\n{2}{U}{R}: Copia el hechizo objetivo de instantáneo o de conjuro que controlas. Puedes elegir nuevos objetivos para la copia.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'"La única acción que vale la pena emprender es una cuyo resultado se desconoce."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365640&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'343b5507-d658-4ea0-b05e-0d285175041c\', \'multiverseId\': 365640}, \'multiverseid\': 365640}, {\'name\': \'Ghildmage de Nivix\', \'text\': "{1}{U}{R} : Piochez une carte, puis défaussez-vous d\'une carte.\\n{2}{U}{R} : Copiez un sort d\'éphémère ou de rituel ciblé que vous contrôlez. Vous pouvez choisir de nouvelles cibles pour cette copie.", \'type\': \'Créature : humain et sorcier\', \'flavor\': "« La seule action qui vaille est celle dont l\'issue est inconnue. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356192&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e74e2106-1538-4ff6-b15f-e9177534d226\', \'multiverseId\': 356192}, \'multiverseid\': 356192}, {\'name\': \'Mago della Gilda di Nivix\', \'text\': \'{1}{U}{R}: Pesca una carta, poi scarta una carta.\\n{2}{U}{R}: Copia una magia istantaneo o stregoneria bersaglio che controlli. Puoi scegliere nuovi bersagli per la copia.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': \'"La sola azione degna di essere intrapresa è quella di cui non si conosce l\\\'esito."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356466&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3de6bb21-d07b-41ec-8a55-2a7bd119129d\', \'multiverseId\': 356466}, \'multiverseid\': 356466}, {\'name\': \'ニヴィックスのギルド魔道士\', \'text\': \'{1}{U}{R}：カードを１枚引き、その後カードを１枚捨てる。\\n{2}{U}{R}：あなたがコントロールする、インスタント呪文１つかソーサリー呪文１つを対象とし、それをコピーする。あなたはそのコピーの新しい対象を選んでもよい。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'「実際に起こす価値があるのは、結果が見えない行動のみだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356740&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'93dad02c-bdab-404d-91cd-54352743a23a\', \'multiverseId\': 356740}, \'multiverseid\': 356740}, {\'name\': \'니빅스의 길드 마도사\', \'text\': \'{1}{U}{R}: 카드 한 장을 뽑은 후 카드 한 장을 버린다.\\n{2}{U}{R}: 당신이 조종하는 순간마법 주문 또는 집중마법 주문 한 개를 목표로 정한다. 그 주문을 복사한다. 당신은 그 복사본의 목표를 새로 정할 수 있다.\', \'type\': \'생물 — 인간 마법사\', \'flavor\': \'"결과를 예측할 수 없는 행동만이 할 가치가 있는 행동이다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357562&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9c489372-c839-401a-887f-5edd40ba7b85\', \'multiverseId\': 357562}, \'multiverseid\': 357562}, {\'name\': \'Mago de Guilda de Nivix\', \'text\': \'{1}{U}{R}: Compre um card e depois descarte um card.\\n{2}{U}{R}: Copie a mágica instantânea ou o feitiço alvo que você controla. Você pode escolher novos alvos para a cópia.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'"A única atitude que vale a pena tomar é aquela cujo resultado é desconhecido."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357014&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f9ec84ce-22bc-4df8-b07b-bdbd592e147b\', \'multiverseId\': 357014}, \'multiverseid\': 357014}, {\'name\': \'Маг Гильдии из Нивикса\', \'text\': \'{1}{U}{R}: возьмите карту, затем сбросьте карту.\\n{2}{U}{R}: скопируйте целевое мгновенное заклинание или заклинание волшебства под вашим контролем. Вы можете выбрать новые цели для этой копии.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'«Единственные дела, которыми следует заниматься, это те, результат которых нельзя предсказать».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355370&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9320266e-c727-4dee-bba1-b93ffc5958b9\', \'multiverseId\': 355370}, \'multiverseid\': 355370}, {\'name\': \'尼米斯公会法师\', \'text\': \'{1}{U}{R}：抓一张牌，然后弃一张牌。\\n{2}{U}{R}：复制目标由你操控的瞬间或法术咒语。你可以为该复制品选择新的目标。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'「只有结果未知的事情才值得去做。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357288&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bbc3fc13-78da-4851-9b4e-912ef2d3c0c8\', \'multiverseId\': 357288}, \'multiverseid\': 357288}, {\'name\': \'尼米斯公會法師\', \'text\': \'{1}{U}{R}：抽一張牌，然後棄一張牌。\\n{2}{U}{R}：複製目標由你操控的瞬間或巫術咒語。你可以為該複製品選擇新的目標。\', \'type\': \'生物～人類／魔法師\', \'flavor\': \'「只有結果未知的事情才值得去做。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355644&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'23d93973-1fbd-4a42-a839-c6d8fad701ae\', \'multiverseId\': 355644}, \'multiverseid\': 355644}]', '[{\'name\': \'Nivmaguselementar\', \'text\': \'Schicke einen Sofortzauber oder eine Hexerei, den bzw. die du kontrollierst, ins Exil: Lege zwei +1/+1-Marken auf das Nivmaguselementar. (Jener Zauber wird nicht verrechnet.)\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'Als es entkam, zögerten die Experimentatoren. Es würde unermessliche Verwüstungen anrichten, und doch wollten sie es gerne in Aktion sehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355955&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7cf899a4-2ee1-43be-9c13-91881f5a5634\', \'multiverseId\': 355955}, \'multiverseid\': 355955}, {\'name\': \'Elemental Nivmagus\', \'text\': \'Exiliar un hechizo de instantáneo o de conjuro que controlas: Pon dos contadores +1/+1 sobre el Elemental Nivmagus. (Ese hechizo no se resolverá.)\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Cuando escapó, los experimentadores dudaron. Causaría una devastación inaudita, pero deseaban verlo en acción.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365677&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'081339a4-2ad4-4025-a207-7e148027db36\', \'multiverseId\': 365677}, \'multiverseid\': 365677}, {\'name\': \'Élémental nivmagus\', \'text\': "Exilez un sort d\'éphémère ou de rituel que vous contrôlez : Mettez deux marqueurs +1/+1 sur l\'Élémental nivmagus. (Ce sort ne se résoudra pas.)", \'type\': \'Créature : élémental\', \'flavor\': "En le voyant s\'échapper, les chercheurs hésitèrent. Il allait certainement semer le chaos, mais ils mouraient d\'envie de le voir à l\'œuvre.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356229&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b8cfb157-ae60-46fc-a780-ff4008dbd511\', \'multiverseId\': 356229}, \'multiverseid\': 356229}, {\'name\': \'Elementale Nivmagus\', \'text\': "Esilia una magia istantaneo o stregoneria che controlli: Metti due segnalini +1/+1 sull\'Elementale Nivmagus. (La magia non si risolve.)", \'type\': \'Creatura — Elementale\', \'flavor\': \'Quando scappò, gli sperimentatori esitarono. Avrebbe causato devastazioni inimmaginabili; eppure desideravano vederlo in azione.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356503&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4be73853-24d8-4335-b2f0-8ca8092f5c5f\', \'multiverseId\': 356503}, \'multiverseid\': 356503}, {\'name\': \'ニヴメイガスの精霊\', \'text\': \'あなたがコントロールするインスタント呪文かソーサリー呪文を１つ追放する：ニヴメイガスの精霊の上に＋１/＋１カウンターを２個置く。（その呪文が解決されることはない。）\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'それが逃げ出したとき、実験者はためらいを覚えた。きっと甚大な損害を及ぼすだろうが、その暴れっぷりを見てみたかったのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356777&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6e027e0a-c4ab-4821-9473-cbe61a8de36c\', \'multiverseId\': 356777}, \'multiverseid\': 356777}, {\'name\': \'니브마도사 정령\', \'text\': \'당신이 조종하는 순간마법 또는 집중마법 주문 한 개를 추방한다: 니브마도사 정령에 +1/+1 카운터 두 개를 올려놓는다. (그 주문은 해결되지 않는다.)\', \'type\': \'생물 — 정령\', \'flavor\': \'그것이 탈출하자 실험자들은 망설였다. 그것이 대혼란을 일으킬 것은 자명했지만, 그 대혼란을 직접 두 눈으로 보고 싶은 것도 사실이었으니까.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357599&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6c1e477c-605b-4a6c-9c5f-5a45294b4f7f\', \'multiverseId\': 357599}, \'multiverseid\': 357599}, {\'name\': \'Elemental Nivmagus\', \'text\': \'Exile uma mágica instantânea ou feitiço que você controle: Coloque dois marcadores +1/+1 em Elemental Nivmagus. (Aquela mágica não será resolvida.)\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Quando ele escapou, os condutores do experimento hesitaram. Ele causaria um caos indizível, mas queriam vê-lo em ação.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357051&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9311c69b-3380-4152-b962-a7cc8388f4d8\', \'multiverseId\': 357051}, \'multiverseid\': 357051}, {\'name\': \'Элементаль-Нивмагус\', \'text\': \'Изгоните мгновенное заклинание или заклинание волшебства под вашим контролем: положите два жетона +1/+1 на Элементаля-Нивмагуса. (То заклинание не разрешится.)\', \'type\': \'Существо — Элементаль\', \'flavor\': \'Когда он сбежал, экспериментаторы начали сомневаться. С одной стороны, он вызовет огромные разрушения; с другой стороны, им хотелось увидеть его в действии.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355407&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e60aab30-c692-4005-880a-742383b92a96\', \'multiverseId\': 355407}, \'multiverseid\': 355407}, {\'name\': \'尼法元素\', \'text\': \'放逐一个由你操控的瞬间或法术咒语：在尼法元素上面放置两个+1/+1指示物。（该咒语不会结算。）\', \'type\': \'生物～元素\', \'flavor\': \'实验人员在它逃走时犹豫了。它会造成前所未有的大混乱，但他们也希望能亲眼看到这场混乱。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357325&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'02277a08-c75f-4fad-a8b7-4d8e2ff05fa3\', \'multiverseId\': 357325}, \'multiverseid\': 357325}, {\'name\': \'尼法元素\', \'text\': \'放逐一個由你操控的瞬間或巫術咒語：在尼法元素上面放置兩個+1/+1指示物。（該咒語不會結算。）\', \'type\': \'生物～元素\', \'flavor\': \'實驗人員在牠逃走時猶豫了。牠會造成前所未有的大混亂，但他們也希望能親眼看到這場混亂。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355681&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8caad71e-2e20-4bce-ac8c-143b8033398f\', \'multiverseId\': 355681}, \'multiverseid\': 355681}]', '[{\'name\': \'Oberster Richtspruch\', \'text\': \'Der Oberste Richtspruch kann nicht neutralisiert werden.\\nZerstöre alle Kreaturen.\', \'type\': \'Hexerei\', \'flavor\': \'Leonos dachte nicht weiter über den Beseitigungsedikt nach. Er hatte ja Himmelsrunen hinterlassen, die vor der Räumung warnten — auch wenn der Himmel bewölkt war.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355937&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'72cb94ff-dd13-4f34-88c1-107439de6e91\', \'multiverseId\': 355937}, \'multiverseid\': 355937}, {\'name\': \'Veredicto supremo\', \'text\': \'El Veredicto supremo no puede ser contrarrestado.\\nDestruye todas las criaturas.\', \'type\': \'Conjuro\', \'flavor\': \'Leonos no tenía dudas acerca del edicto de abolición. Había dejado runas celestes para advertir del desahucio, pese a que estaba nublado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365659&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'01b9455a-398b-46c7-8d35-6f6612639c14\', \'multiverseId\': 365659}, \'multiverseid\': 365659}, {\'name\': \'Verdict suprême\', \'text\': \'Le Verdict suprême ne peut pas être contrecarré.\\nDétruisez toutes les créatures.\', \'type\': \'Rituel\', \'flavor\': "Leonos ne pensait déjà plus à l\'édit d\'abolition. Il avait signalé l\'éviction par des runes célestes, bien que le temps était nuageux.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356211&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cac66c5d-b3c9-4585-96b4-18d73e92b92b\', \'multiverseId\': 356211}, \'multiverseid\': 356211}, {\'name\': \'Verdetto Supremo\', \'text\': \'Il Verdetto Supremo non può essere neutralizzato.\\nDistruggi tutte le creature.\', \'type\': \'Stregoneria\', \'flavor\': "Leonos non ebbe ripensamenti sull\'editto di abolizione. Aveva lasciato delle rune celesti per avvertire dell\'ordinanza, nonostante il cielo fosse nuvoloso.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356485&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a97b12db-55ec-460e-b2da-82ab86fa9467\', \'multiverseId\': 356485}, \'multiverseid\': 356485}, {\'name\': \'至高の評決\', \'text\': \'至高の評決は打ち消されない。\\nすべてのクリーチャーを破壊する。\', \'type\': \'ソーサリー\', \'flavor\': \'レオノスは何のためらいもなく廃絶布告を発した。彼は雲行きが怪しくなるなか、立ち退くよう警告を発しつつスカイルーンを去った。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356759&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8b5b3414-3495-4fc1-beb4-0ebf2ecef7e9\', \'multiverseId\': 356759}, \'multiverseid\': 356759}, {\'name\': \'최고 판결\', \'text\': \'최고 판결은 무효화될 수 없다.\\n모든 생물을 파괴한다.\', \'type\': \'집중마법\', \'flavor\': \'레오노스는 폐지 칙령을 대수롭게 여기지 않았다. 날씨가 약간 흐릿하긴 했지만 그래도 분명히 창공룬을 통해 경고를 해 두었기 때문이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357581&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'277c3578-3278-4f1f-a333-04ea0c4d0649\', \'multiverseId\': 357581}, \'multiverseid\': 357581}, {\'name\': \'Veredito Supremo\', \'text\': \'Veredito Supremo não pode ser anulado.\\nDestrua todas as criaturas.\', \'type\': \'Feitiço\', \'flavor\': \'Leonos não teve dúvidas com relação ao édito de abolição. Ele havia deixado runas celestes avisando da evicção, mesmo com o tempo nublado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357033&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ba6cd9d5-6d45-4efa-9cfd-c2fb4617f42c\', \'multiverseId\': 357033}, \'multiverseid\': 357033}, {\'name\': \'Высочайший Вердикт\', \'text\': \'Высочайший Вердикт не может быть отменен.\\nУничтожьте все существа.\', \'type\': \'Волшебство\', \'flavor\': \'Леонос не сомневался в правильности решения. Несмотря на облака, он рунами начертал на небе предупреждение о выселении.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355389&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'51f4a400-5856-43fe-938a-e9db724794f4\', \'multiverseId\': 355389}, \'multiverseid\': 355389}, {\'name\': \'最高裁决\', \'text\': \'最高裁决不能被反击。\\n消灭所有生物。\', \'type\': \'法术\', \'flavor\': \'雷诺兹毫不犹豫地下令彻底破坏。他已放出天符文作为驱逐令，尽管当时是阴天。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357307&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dcdebbb5-47bf-4acc-a7eb-4598c49fb2f2\', \'multiverseId\': 357307}, \'multiverseid\': 357307}, {\'name\': \'最高裁決\', \'text\': \'最高裁決不能被反擊。\\n消滅所有生物。\', \'type\': \'巫術\', \'flavor\': \'雷諾茲毫不猶豫地下令徹底破壞。他已放出天符文作為驅逐令，儘管當時是陰天。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355663&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fcfa22e4-db90-47c4-a3fb-9f7dccb1180f\', \'multiverseId\': 355663}, \'multiverseid\': 355663}]', '[{\'name\': \'Offenbarung der Sphinx\', \'text\': \'Du erhältst X Lebenspunkte dazu und ziehst X Karten.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Möge das Wissen um das absolute Gesetz dich zu einem Leben der absoluten Ordnung inspirieren."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355936&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1ce31b45-a597-40d2-8894-f23abdb50c0a\', \'multiverseId\': 355936}, \'multiverseid\': 355936}, {\'name\': \'Revelación de la esfinge\', \'text\': \'Ganas X vidas y robas X cartas.\', \'type\': \'Instantáneo\', \'flavor\': \'"Que el conocimiento de la ley absoluta te inspire para vivir una vida de orden absoluto."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365658&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8bc69f16-f9d2-4d2c-bac0-342979f62059\', \'multiverseId\': 365658}, \'multiverseid\': 365658}, {\'name\': \'Révélation du sphinx\', \'text\': \'Vous gagnez X points de vie et vous piochez X cartes.\', \'type\': \'Éphémère\', \'flavor\': "« Puisse la connaissance de la loi absolue t\'inciter à mener une existence d\'ordre absolu. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356210&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3ea868af-df9c-4119-979f-3815f4c225cf\', \'multiverseId\': 356210}, \'multiverseid\': 356210}, {\'name\': \'Rivelazione della Sfinge\', \'text\': \'Guadagni X punti vita e peschi X carte.\', \'type\': \'Istantaneo\', \'flavor\': \'"Che la conoscenza della legge assoluta vi ispiri a vivere una vita di ordine assoluto."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356484&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b4f0e38f-69b7-416e-84dd-c2fc14e4f8d0\', \'multiverseId\': 356484}, \'multiverseid\': 356484}, {\'name\': \'スフィンクスの啓示\', \'text\': \'あなたはＸ点のライフを得て、カードをＸ枚引く。\', \'type\': \'インスタント\', \'flavor\': \'「汝、絶対の法を知り、絶対の秩序に従い生涯を歩め。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356758&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'117335bc-33e3-4a6f-a962-7dcbc6a48a19\', \'multiverseId\': 356758}, \'multiverseid\': 356758}, {\'name\': \'스핑크스의 계시\', \'text\': \'당신은 생명 X점을 얻고 카드 X장을 뽑는다.\', \'type\': \'순간마법\', \'flavor\': \'"절대적인 법에 대한 지식을 통해 절대적인 질서의 삶을 살아라."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357580&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0bb2f852-3d19-45a9-9af2-3e573b0cb789\', \'multiverseId\': 357580}, \'multiverseid\': 357580}, {\'name\': \'Revelação da Esfinge\', \'text\': \'Você ganha X pontos de vida e compra X cards.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Deixe que o conhecimento da lei absoluta inspire você a viver uma vida de ordem absoluta."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357032&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6f4470c2-6bbb-4e01-be4c-f6d0743440d0\', \'multiverseId\': 357032}, \'multiverseid\': 357032}, {\'name\': \'Откровения Сфинкса\', \'text\': \'Вы получаете Х жизней и берете Х карт.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Пусть знания об абсолютном законе вдохновят тебя жить согласно абсолютному порядку».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355388&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fd36b281-f45e-4397-906a-0b623cabcb3d\', \'multiverseId\': 355388}, \'multiverseid\': 355388}, {\'name\': \'史芬斯的启示\', \'text\': \'你获得X点生命且抓X张牌。\', \'type\': \'瞬间\', \'flavor\': \'「让绝对律法的知识启迪你绝对守序地过活。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357306&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'caac94d6-00ef-4519-a41a-2efab1c32eb3\', \'multiverseId\': 357306}, \'multiverseid\': 357306}, {\'name\': \'史芬斯的啟示\', \'text\': \'你獲得X點生命且抽X張牌。\', \'type\': \'瞬間\', \'flavor\': \'「讓絕對律法的知識啟迪你絕對守序地過活。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355662&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b28a5a99-8ea4-4d6e-9094-401ce4b81237\', \'multiverseId\': 355662}, \'multiverseid\': 355662}]', '[{\'name\': \'Patrouilliernde Husaren\', \'text\': \'Aufblitzen (Du kannst diesen Zauberspruch zu jedem Zeitpunkt wirken, zu dem du einen Spontanzauber wirken könntest.)\\nWachsamkeit\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': \'„Du glaubst, dass niemand zusieht, dass du schlau genug bist, um zu entkommen. Und was noch dümmer ist: Du glaubst, es ist allen egal." —Eintreiberin Lavinia, Zehntes Revier\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355905&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'70f06d1d-325b-4ec4-ba20-bd93719479ba\', \'multiverseId\': 355905}, \'multiverseid\': 355905}, {\'name\': \'Patrulla de húsares\', \'text\': \'Destello. (Puedes lanzar este hechizo en cualquier momento en que pudieras lanzar un instantáneo.)\\nVigilancia.\', \'type\': \'Criatura — Caballero humano\', \'flavor\': \'"Crees que nadie vigila, te crees lo bastante listo como para escapar y, lo más estúpido de todo, crees que a nadie le importa." —Encarceladora Lavinia, distrito décimo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=365627&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'42e356ea-905c-4e4a-bbff-73063f272965\', \'multiverseId\': 365627}, \'multiverseid\': 365627}, {\'name\': \'Patrouille de hussards\', \'text\': \'Flash (Vous pouvez lancer ce sort à tout moment où vous pourriez lancer un éphémère.)\\nVigilance\', \'type\': \'Créature : humain et chevalier\', \'flavor\': "« Vous pensez que personne ne regarde, que vous êtes assez malin pour vous échapper, et pire que tout, que tout le monde s\'en moque. » —Courtière Lavinia, Dixième circonscription", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356179&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7ec16362-e2d7-4068-a95f-3ec9aa8e7580\', \'multiverseId\': 356179}, \'multiverseid\': 356179}, {\'name\': \'Pattuglia Ussara\', \'text\': \'Lampo (Puoi lanciare questa magia in ogni momento in cui potresti lanciare un istantaneo.)\\nCautela\', \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': \'"Credi che nessuno ti stia osservando, credi di essere abbastanza furbo da scappare e, più stupido ancora, credi che a nessuno interessi." —Lavinia, polizia del Decimo Distretto\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356453&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'901e6c24-61e3-42be-94bd-3490d72264df\', \'multiverseId\': 356453}, \'multiverseid\': 356453}, {\'name\': \'軽騎兵の巡視部隊\', \'text\': \'瞬速（あなたはこの呪文を、あなたがインスタントを唱えられるときならいつでも唱えてよい。）\\n警戒\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': \'「あんたは誰も見ていないと思ったり、自分なら逃げられると思ったり、そればかりか間抜けなことに、誰も気にしないと思ったんでしょう。」 ――第10管区の拘引者、ラヴィニア\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=356727&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'84236750-5ea7-4023-a9f1-e582ce1476c7\', \'multiverseId\': 356727}, \'multiverseid\': 356727}, {\'name\': \'경기병 순찰대\', \'text\': \'섬광 (순간마법을 발동할 수 있는 시기라면 당신은 이 주문을 언제든지 발동할 수 있다.)\\n경계\', \'type\': \'생물 — 인간 기사\', \'flavor\': \'"다들 아무도 보고 있지 않다고, 자신이 탈출할 수 있을 만큼 영리하다고, 그리고 가장 어리석게도 아무도 신경을 쓰지 않는다고 생각하지." —10번 관할지역 체포원 라비니아\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357549&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'af122a2f-e39d-4eba-b8db-820c87ea870f\', \'multiverseId\': 357549}, \'multiverseid\': 357549}, {\'name\': \'Patrulha Hussarda\', \'text\': \'Lampejo (Você poderá conjurar esta mágica a qualquer momento em que puder conjurar uma mágica instantânea.)\\nVigilância\', \'type\': \'Criatura — Humano Cavaleiro\', \'flavor\': \'"Você acha que ninguém está vendo, acha que é esperto o suficiente para escapar e, a maior das tolices, acha que ninguém se importa." — Encarceradora Lavinia, Décima Jurisdição\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357001&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6625c606-3825-46a3-b578-6b92aa2c2d25\', \'multiverseId\': 357001}, \'multiverseid\': 357001}, {\'name\': \'Патрульный Гусар\', \'text\': \'Миг (Вы можете разыграть это заклинание при любой возможности разыгрывать мгновенные заклинания.)\\nБдительность\', \'type\': \'Существо — Человек Рыцарь\', \'flavor\': \'«Думаешь, никто не смотрит? Думаешь, ты достаточно хитер, чтобы скрыться? Но самое глупое — ты до сих пор считаешь, что всем все равно». — Задержатель Лавиния, Десятый Округ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355357&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f97eefd4-ccf3-49bf-ba91-eeed519b4125\', \'multiverseId\': 355357}, \'multiverseid\': 355357}, {\'name\': \'轻骑兵巡守\', \'text\': \'闪现（你可以于你能够施放瞬间的时机下施放此咒语。）\\n警戒\', \'type\': \'生物～人类／骑士\', \'flavor\': \'「你以为没人在看，你以为你聪明地逃过了；最愚蠢的是，你以为没有人会在乎。」 ～第十城郊逮捕人拉温妮\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=357275&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'df895093-d70d-47de-ac7a-8476a1604258\', \'multiverseId\': 357275}, \'multiverseid\': 357275}, {\'name\': \'輕騎兵巡守\', \'text\': \'閃現（你可以於你能夠施放瞬間的時機下施放此咒語。）\\n警戒\', \'type\': \'生物～人類／騎士\', \'flavor\': \'「你以為沒人在看，你以為你聰明地逃過了；最愚蠢的是，你以為沒有人會在乎。」 ～第十城郊逮捕人拉溫妮\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=355631&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6190922c-e89c-422b-adf8-89bc43a434bb\', \'multiverse