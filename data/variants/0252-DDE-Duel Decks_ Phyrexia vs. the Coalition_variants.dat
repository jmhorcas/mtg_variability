type: ['Artifact', 'Artifact Creature — Phyrexian Golem', 'Artifact — Equipment', 'Basic Land — Forest', 'Basic Land — Island', 'Basic Land — Mountain', 'Basic Land — Plains', 'Basic Land — Swamp', 'Creature — Elf Druid', 'Creature — Elf Nomad', 'Creature — Elf Wizard', 'Creature — Human Druid', 'Creature — Human Wizard', 'Creature — Phyrexian Carrier', 'Creature — Phyrexian Horror', 'Creature — Phyrexian Human Cleric Minion', 'Creature — Phyrexian Insect', 'Creature — Phyrexian Minion', 'Creature — Phyrexian Zombie', 'Creature — Phyrexian Zombie Knight', 'Creature — Troll', 'Creature — Zombie', 'Enchantment', 'Enchantment — Aura', 'Instant', 'Land', 'Legendary Creature — Dragon', 'Legendary Creature — Human Soldier', 'Sorcery']
