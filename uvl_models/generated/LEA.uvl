constraints
	(Power >= 0) & (Power <= 8)
	(Toughness >= 0) & (Toughness <= 8)
	(black >= 0) & (black <= 4)
	(blue >= 0) & (blue <= 3)
	(generic >= 0) & (generic <= 6)
	(green >= 0) & (green <= 4)
	(red >= 0) & (red <= 2)
	(variable >= 0) & (variable <= 1)
	("variable_symbol:X" >= 0) & ("variable_symbol:X" <= 1)
	(white >= 0) & (white <= 3)