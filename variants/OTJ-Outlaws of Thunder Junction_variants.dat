subtypes: ['Advisor', 'Angel', 'Armadillo', 'Artificer', 'Assassin', 'Aura', 'Badger', 'Bard', 'Bear', 'Beast', 'Beaver', 'Berserker', 'Bird', 'Brushwagg', 'Cat', 'Centaur', 'Citizen', 'Coyote', 'Crab', 'Demon', 'Desert', 'Djinn', 'Dog', 'Dragon', 'Drake', 'Druid', 'Dwarf', 'Elf', 'Equipment', 'Faerie', 'Forest', 'Frog', 'Giant', 'Goblin', 'Golem', 'Gorgon', 'Griffin', 'Hippogriff', 'Homarid', 'Homunculus', 'Horror', 'Horse', 'Human', 'Hydra', 'Insect', 'Island', 'Jace', 'Knight', 'Kor', 'Lizard', 'Mercenary', 'Minotaur', 'Mount', 'Mountain', 'Ninja', 'Noble', 'Ogre', 'Oko', 'Ox', 'Pegasus', 'Pirate', 'Plains', 'Plant', 'Porcupine', 'Possum', 'Rabbit', 'Ranger', 'Rat', 'Rhino', 'Rogue', 'Salamander', 'Scarecrow', 'Scorpion', 'Scout', 'Shaman', 'Shapeshifter', 'Shark', 'Sheep', 'Siren', 'Skeleton', 'Snake', 'Soldier', 'Specter', 'Sphinx', 'Spider', 'Spirit', 'Squirrel', 'Swamp', 'Turtle', 'Unicorn', 'Vampire', 'Varmint', 'Vehicle', 'Warlock', 'Warrior', 'Wizard', 'Wolf', 'Wolverine', 'Wurm', 'Zombie']
