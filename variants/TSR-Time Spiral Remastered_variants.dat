subtypes: ['Advisor', 'Ally', 'Angel', 'Ape', 'Arcane', 'Archer', 'Artificer', 'Assassin', 'Aura', 'Avatar', 'Beast', 'Berserker', 'Bird', 'Cat', 'Centaur', 'Cleric', 'Construct', 'Demon', 'Desert', 'Devil', 'Dinosaur', 'Djinn', 'Dragon', 'Drake', 'Druid', 'Dryad', 'Dwarf', 'Elder', 'Elemental', 'Elf', 'Equipment', 'Faerie', 'Fish', 'Forest', 'Fungus', 'Gargoyle', 'Giant', 'Goblin', 'Golem', 'Gorgon', 'Homunculus', 'Horror', 'Human', 'Hydra', 'Illusion', 'Imp', 'Insect', 'Island', 'Juggernaut', 'Kavu', 'Kithkin', 'Knight', 'Kor', 'Lhurgoyf', 'Merfolk', 'Monk', 'Myr', 'Nightmare', 'Ninja', 'Noble', 'Ogre', 'Phyrexian', 'Ranger', 'Rat', 'Rebel', 'Rhino', 'Rogue', 'Scout', 'Serpent', 'Shade', 'Shaman', 'Shapeshifter', 'Sliver', 'Snake', 'Soldier', 'Spellshaper', 'Spider', 'Spirit', 'Treefolk', "Urza's", 'Vampire', 'Viashino', 'Warrior', 'Wizard', 'Worm', 'Wraith', 'Wurm', 'Zombie']
