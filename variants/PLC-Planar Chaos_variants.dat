subtypes: ['Angel', 'Ape', 'Assassin', 'Aura', 'Avatar', 'Beast', 'Bird', 'Cat', 'Centaur', 'Cleric', 'Dragon', 'Drake', 'Druid', 'Elemental', 'Elf', 'Fungus', 'Gargoyle', 'Giant', 'Goblin', 'Hellion', 'Horror', 'Horse', 'Human', 'Illusion', 'Insect', 'Kavu', 'Knight', 'Lhurgoyf', 'Merfolk', 'Noble', 'Phoenix', 'Rebel', 'Rogue', 'Serpent', 'Shade', 'Shaman', 'Shapeshifter', 'Sliver', 'Snake', 'Soldier', 'Spellshaper', 'Sphinx', 'Spider', 'Spirit', 'Treefolk', 'Troll', 'Vampire', 'Wall', 'Warrior', 'Wizard', 'Wurm', 'Zombie']
