subtypes: ['Advisor', 'Angel', 'Ape', 'Archer', 'Archon', 'Artificer', 'Assembly-Worker', 'Aura', 'Beast', 'Berserker', 'Bird', 'Camel', 'Cat', 'Cleric', 'Clue', 'Construct', 'Cyclops', 'Dakkon', 'Dauthi', 'Demon', 'Devil', 'Dihada', 'Dinosaur', 'Dog', 'Dragon', 'Drake', 'Druid', 'Dryad', 'Efreet', 'Elder', 'Elemental', 'Elf', 'Equipment', 'Forest', 'Frog', 'Gargoyle', 'Giant', 'Gnome', 'Goat', 'Goblin', 'God', 'Golem', 'Gorgon', 'Grist', 'Homunculus', 'Human', 'Hydra', 'Illusion', 'Imp', 'Incarnation', 'Insect', 'Island', 'Juggernaut', 'Kavu', 'Kirin', 'Knight', 'Lhurgoyf', 'Lizard', 'Manticore', 'Merfolk', 'Minion', 'Minotaur', 'Monkey', 'Mountain', 'Myr', 'Nightmare', 'Noble', 'Nymph', 'Ooze', 'Ouphe', 'Peasant', 'Pegasus', 'Phyrexian', 'Pirate', 'Plains', 'Plant', 'Ranger', 'Rogue', 'Saga', 'Salamander', 'Samurai', 'Scout', 'Serpent', 'Shaman', 'Skeleton', 'Snake', 'Soldier', 'Sphinx', 'Spider', 'Spirit', 'Squirrel', 'Starfish', 'Swamp', 'Thopter', 'Treefolk', "Urza's", 'Vampire', 'Vedalken', 'Vehicle', 'Viashino', 'Warlock', 'Warrior', 'Whale', 'Wizard', 'Zombie']
