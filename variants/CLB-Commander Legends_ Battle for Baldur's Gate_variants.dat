subtypes: ['Aetherborn', 'Ally', 'Angel', 'Arcane', 'Artificer', 'Assassin', 'Aura', 'Avatar', 'Azra', 'Background', 'Badger', 'Barbarian', 'Bard', 'Bat', 'Bear', 'Beast', 'Beholder', 'Berserker', 'Bird', 'Boar', 'Cat', 'Citizen', 'Class', 'Cleric', 'Construct', 'Crab', 'Curse', 'Dauthi', 'Demon', 'Devil', 'Dinosaur', 'Dog', 'Dragon', 'Druid', 'Dryad', 'Dwarf', 'Elder', 'Elemental', 'Elephant', 'Elf', 'Elk', 'Elminster', 'Equipment', 'Faerie', 'Fish', 'Forest', 'Fox', 'Frog', 'Fungus', 'Gate', 'Giant', 'Gith', 'Gnoll', 'Gnome', 'Goblin', 'God', 'Golem', 'Hag', 'Halfling', 'Hippogriff', 'Horror', 'Human', 'Hydra', 'Imp', 'Insect', 'Island', 'Jellyfish', 'Kithkin', 'Knight', 'Kobold', 'Kor', 'Kraken', 'Leviathan', 'Lizard', 'Merfolk', 'Minsc', 'Mole', 'Monk', 'Mountain', 'Naga', 'Noble', 'Ogre', 'Ooze', 'Orc', 'Peasant', 'Pegasus', 'Phoenix', 'Phyrexian', 'Pirate', 'Plains', 'Praetor', 'Ranger', 'Rogue', 'Rowan', 'Saga', 'Scorpion', 'Scout', 'Serpent', 'Shaman', 'Shapeshifter', 'Skeleton', 'Snake', 'Soldier', 'Spider', 'Spirit', 'Squid', 'Swamp', 'Tasha', 'Thopter', 'Tiefling', 'Treasure', 'Turtle', 'Unicorn', 'Vampire', 'Vehicle', 'Vivien', 'Walrus', 'Warlock', 'Warrior', 'Whale', 'Will', 'Wizard', 'Xenagos', 'Zombie']
