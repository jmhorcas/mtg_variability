type: ['Artifact', 'Artifact Creature — Golem', 'Artifact Creature — Ship', 'Basic Land — Forest', 'Basic Land — Island', 'Basic Land — Mountain', 'Basic Land — Plains', 'Basic Land — Swamp', 'Creature — Ape', 'Creature — Avatar', 'Creature — Basilisk', 'Creature — Beast', 'Creature — Beeble', 'Creature — Bird', 'Creature — Demon Child', 'Creature — Dog', 'Creature — Donkey', 'Creature — Donkey Barbarian', 'Creature — Donkey Shaman', 'Creature — Donkey Townsfolk', 'Creature — Donkey Wizard', 'Creature — Donkey Zombie', 'Creature — Drake', 'Creature — Efreet', 'Creature — Elemental', 'Creature — Elemental?', 'Creature — Elephant Townsfolk', 'Creature — Elf Rogue', 'Creature — Giant', 'Creature — Goblin Mime', 'Creature — Goblin Rogue', 'Creature — Goblin Waiter', 'Creature — Goblin Warrior', 'Creature — Human Bureaucrat', 'Creature — Human Child', 'Creature — Human Cleric', 'Creature — Human Druid', 'Creature — Human Gamer', 'Creature — Human Hero', 'Creature — Human Horror', 'Creature — Human Knight', 'Creature — Human Rogue', 'Creature — Human Soldier', 'Creature — Human Wizard', 'Creature — Hyena', 'Creature — Monkey', 'Creature — Mummy', 'Creature — Ooze', 'Creature — Orc Paratrooper', 'Creature — Phyrexian Horror', 'Creature — Shapeshifter', 'Creature — Slug', 'Creature — Treefolk', 'Creature — Zombie', 'Creature — Zombie Gamer', 'Eaturecray — Igpay', 'Enchantment', 'Enchantment — Aura', 'Instant', 'Land', 'Legendary Artifact', 'Legendary Creature — Elephant Rogue', 'Legendary Creature — Human Designer', 'Legendary Creature — Human Gamer', 'Legendary Land', 'Sorcery', 'Summon — Dinosaur']
