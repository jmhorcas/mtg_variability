subtypes: ['Ape', 'Aura', 'Avatar', 'Barbarian', 'Basilisk', 'Beast', 'Beeble', 'Bird', 'Bureaucrat', 'Child', 'Cleric', 'Demon', 'Designer', 'Dinosaur', 'Dog', 'Donkey', 'Drake', 'Druid', 'Efreet', 'Elemental', 'Elemental?', 'Elephant', 'Elf', 'Forest', 'Gamer', 'Giant', 'Goblin', 'Golem', 'Hero', 'Horror', 'Human', 'Hyena', 'Igpay', 'Island', 'Knight', 'Mime', 'Monkey', 'Mountain', 'Mummy', 'Ooze', 'Orc', 'Paratrooper', 'Phyrexian', 'Plains', 'Rogue', 'Shaman', 'Shapeshifter', 'Ship', 'Slug', 'Soldier', 'Swamp', 'Townsfolk', 'Treefolk', 'Waiter', 'Warrior', 'Wizard', 'Zombie']
