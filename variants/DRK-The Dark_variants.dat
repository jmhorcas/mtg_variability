subtypes: ['Assassin', 'Aura', 'Beast', 'Bird', 'Cleric', 'Construct', 'Drake', 'Druid', 'Elemental', 'Elf', 'Fish', 'Goblin', 'Golem', 'Hag', 'Horror', 'Human', 'Imp', 'Knight', 'Leech', 'Leviathan', 'Merfolk', 'Minion', 'Orc', 'Ouphe', 'Plant', 'Rat', 'Rogue', 'Scarecrow', 'Shaman', 'Shark', 'Slug', 'Snake', 'Soldier', 'Spirit', 'Treefolk', 'Wall', 'Warrior', 'Wizard', 'Wurm', 'Zombie']
