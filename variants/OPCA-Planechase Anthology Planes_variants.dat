subtypes: ['Alara', 'Arkhos', 'Azgol', 'Belenon', "Bolas's Meditation Realm", 'Dominaria', 'Equilor', 'Ergamon', 'Fabacin', 'Innistrad', 'Iquatana', 'Ir', 'Kaldheim', 'Kamigawa', 'Karsus', 'Kephalai', 'Kinshala', 'Kolbahan', 'Kyneth', 'Lorwyn', 'Luvion', 'Mercadia', 'Mirrodin', 'Moag', 'Mongseng', 'Muraganda', 'New Phyrexia', 'Phyrexia', 'Pyrulea', 'Rabiah', 'Rath', 'Ravnica', 'Regatha', 'Segovia', 'Serra’s Realm', 'Shadowmoor', 'Shandalar', 'Ulgrotha', 'Valla', 'Vryn', 'Wildfire', 'Xerex', 'Zendikar']
