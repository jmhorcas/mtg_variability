subtypes: ['Angel', 'Ape', 'Archer', 'Artificer', 'Aura', 'Aurochs', 'Barbarian', 'Bear', 'Beast', 'Bird', 'Cat', 'Centaur', 'Cleric', 'Demon', 'Dinosaur', 'Dog', 'Druid', 'Dryad', 'Elemental', 'Elephant', 'Elf', 'Forest', 'Fox', 'Frog', 'Giant', 'Goat', 'Goblin', 'Golem', 'Horror', 'Horse', 'Human', 'Hydra', 'Illusion', 'Imp', 'Insect', 'Island', 'Knight', 'Kraken', 'Lhurgoyf', 'Mercenary', 'Minion', 'Mountain', 'Mutant', 'Orc', 'Ouphe', 'Plains', 'Plant', 'Ranger', 'Rat', 'Shade', 'Shaman', 'Shapeshifter', 'Skeleton', 'Soldier', 'Specter', 'Spider', 'Spirit', 'Swamp', 'Unicorn', 'Vampire', 'Wall', 'Warrior', 'Wizard', 'Wolf', 'Wolverine', 'Worm', 'Wurm', 'Yeti', 'Zombie']
