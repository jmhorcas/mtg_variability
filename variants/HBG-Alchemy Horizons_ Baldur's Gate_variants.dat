subtypes: ['Angel', 'Archer', 'Artificer', 'Assassin', 'Aura', 'Barbarian', 'Bard', 'Basilisk', 'Bear', 'Beast', 'Beholder', 'Bird', 'Boar', 'Cat', 'Citizen', 'Cleric', 'Demon', 'Devil', 'Djinn', 'Dragon', 'Druid', 'Dwarf', 'Elder', 'Elemental', 'Elf', 'Equipment', 'Forest', 'Frog', 'Fungus', 'Gate', 'Giant', 'Gith', 'Gnoll', 'Gnome', 'Goblin', 'Golem', 'Hag', 'Halfling', 'Hippogriff', 'Horror', 'Human', 'Imp', 'Insect', 'Island', 'Knight', 'Kobold', 'Lizard', 'Manticore', 'Minsc', 'Monk', 'Mountain', 'Naga', 'Noble', 'Orc', 'Peasant', 'Pegasus', 'Plains', 'Ranger', 'Rogue', 'Serpent', 'Shaman', 'Snake', 'Soldier', 'Spider', 'Spirit', 'Swamp', 'Tasha', 'Thopter', 'Tiefling', 'Unicorn', 'Vampire', 'Walrus', 'Warlock', 'Warrior', 'Weird', 'Wizard', 'Zombie']
