subtypes: ['Ajani', 'Ally', 'Angel', 'Arcane', 'Archon', 'Assassin', 'Aura', 'Avatar', 'Badger', 'Beast', 'Bird', 'Cat', 'Chandra', 'Chimera', 'Cleric', 'Construct', 'Demon', 'Desert', 'Devil', 'Dinosaur', 'Djinn', 'Dog', 'Dragon', 'Drake', 'Druid', 'Dryad', 'Dwarf', 'Elder', 'Elemental', 'Elf', 'Equipment', 'Faerie', 'Fish', 'Forest', 'Fungus', 'Giant', 'Goat', 'Goblin', 'God', 'Golem', 'Horror', 'Human', 'Hydra', 'Hyena', 'Illusion', 'Insect', 'Island', 'Jace', 'Knight', 'Leviathan', 'Merfolk', 'Mountain', 'Nahiri', 'Nightmare', 'Nissa', 'Ooze', 'Otter', 'Pegasus', 'Phoenix', 'Phyrexian', 'Pirate', 'Plains', 'Plant', 'Ranger', 'Rogue', 'Samurai', 'Satyr', 'Scout', 'Shaman', 'Shapeshifter', 'Shark', 'Snake', 'Soldier', 'Sphinx', 'Spider', 'Spirit', 'Swamp', 'Trap', 'Trilobite', 'Vampire', 'Warlock', 'Warrior', 'Weird', 'Whale', 'Wizard', 'Wolf']
