subtypes: ['Advisor', 'Aetherborn', 'Ajani', 'Ally', 'Angel', 'Arcane', 'Archon', 'Artificer', 'Assassin', 'Aura', 'Avatar', 'Barbarian', 'Bard', 'Bear', 'Beast', 'Berserker', 'Bird', 'Boar', 'Calix', 'Cat', 'Centaur', 'Chandra', 'Cleric', 'Clue', 'Construct', 'Cyclops', 'Daretti', 'Demigod', 'Demon', 'Desert', 'Devil', 'Dinosaur', 'Djinn', 'Dog', 'Dragon', 'Drake', 'Drone', 'Druid', 'Dryad', 'Dwarf', 'Elder', 'Eldrazi', 'Elemental', 'Elephant', 'Elf', 'Elk', 'Elspeth', 'Equipment', 'Faerie', 'Fish', 'Forest', 'Freyalise', 'Frog', 'Fungus', 'Giant', 'Gideon', 'Goblin', 'God', 'Golem', 'Guff', 'Harpy', 'Homunculus', 'Horror', 'Horse', 'Human', 'Hydra', 'Illusion', 'Imp', 'Insect', 'Island', 'Jace', 'Knight', 'Kor', 'Kraken', 'Lizard', 'Merfolk', 'Mine', 'Minion', 'Minotaur', 'Monk', 'Mountain', 'Mutant', 'Myr', 'Naga', 'Nahiri', 'Narset', 'Ninja', 'Nixilis', 'Nomad', 'Nymph', 'Octopus', 'Ogre', 'Ooze', 'Orc', 'Phoenix', 'Phyrexian', 'Pirate', 'Plains', 'Plant', 'Power-Plant', 'Rhino', 'Rogue', 'Saga', 'Saheeli', 'Sarkhan', 'Satyr', 'Scarecrow', 'Scorpion', 'Scout', 'Serpent', 'Shaman', 'Shapeshifter', 'Skeleton', 'Sliver', 'Snake', 'Soldier', 'Sphinx', 'Spider', 'Spirit', 'Swamp', 'Teferi', 'Teyo', 'Thopter', 'Tower', 'Treefolk', 'Turtle', 'Ugin', 'Unicorn', "Urza's", 'Vampire', 'Vedalken', 'Vronos', 'Wall', 'Warrior', 'Weird', 'Wizard', 'Zombie']
