type: ['Artifact', 'Artifact Creature — Beast', 'Artifact Creature — Bird Construct', 'Artifact Creature — Juggernaut', 'Artifact Creature — Phyrexian Beast', 'Artifact Creature — Phyrexian Construct', 'Artifact Creature — Soldier', 'Artifact Creature — Wall', 'Creature — Angel Spirit', 'Creature — Ape', 'Creature — Ape Berserker', 'Creature — Ape Shaman', 'Creature — Avatar', 'Creature — Bird', 'Creature — Elemental', 'Creature — Elf Druid', 'Creature — Elf Ranger', 'Creature — Elf Shaman Bard', 'Creature — Elf Spirit', 'Creature — Gargoyle', 'Creature — Goblin Scout', 'Creature — Homarid Drone', 'Creature — Horror Spirit', 'Creature — Human', 'Creature — Human Advisor', 'Creature — Human Barbarian', 'Creature — Human Cleric', 'Creature — Human Cleric Shaman', 'Creature — Human Cleric Wizard', 'Creature — Human Knight', 'Creature — Human Mercenary', 'Creature — Human Rogue', 'Creature — Human Rogue Mercenary', 'Creature — Human Soldier', 'Creature — Human Warrior', 'Creature — Human Wizard', 'Creature — Illusion', 'Creature — Insect', 'Creature — Merfolk Scout', 'Creature — Plant Wall', 'Creature — Rat', 'Creature — Skeleton', 'Creature — Starfish', 'Creature — Treefolk', 'Creature — Worm', 'Creature — Zombie', 'Enchantment', 'Enchantment — Aura', 'Instant', 'Land', 'Legendary Creature — Elf Druid', 'Legendary Creature — Phelddagrif', 'Legendary Creature — Zombie', 'Sorcery', 'World Enchantment']
