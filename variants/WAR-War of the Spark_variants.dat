subtypes: ['Advisor', 'Ajani', 'Angel', 'Angrath', 'Arlinn', 'Ashiok', 'Assassin', 'Aura', 'Avatar', 'Bear', 'Beast', 'Berserker', 'Bird', 'Boar', 'Bolas', 'Cat', 'Centaur', 'Chandra', 'Crocodile', 'Cyclops', 'Davriel', 'Devil', 'Dinosaur', 'Dog', 'Domri', 'Dovin', 'Dragon', 'Drake', 'Druid', 'Elemental', 'Elephant', 'Elf', 'Faerie', 'Forest', 'Gate', 'Giant', 'Gideon', 'Goblin', 'God', 'Golem', 'Gorgon', 'Griffin', 'Hellion', 'Hippo', 'Homunculus', 'Huatli', 'Human', 'Hydra', 'Illusion', 'Insect', 'Island', 'Jace', 'Jackal', 'Jaya', 'Karn', 'Kasmina', 'Kaya', 'Kiora', 'Knight', 'Leviathan', 'Liliana', 'Manticore', 'Merfolk', 'Minotaur', 'Monk', 'Mountain', 'Mutant', 'Naga', 'Nahiri', 'Narset', 'Nightmare', 'Nissa', 'Nixilis', 'Ogre', 'Pegasus', 'Plains', 'Plant', 'Ral', 'Rhino', 'Rogue', 'Saheeli', 'Samut', 'Sarkhan', 'Scout', 'Sloth', 'Soldier', 'Sorin', 'Sphinx', 'Spider', 'Spirit', 'Swamp', 'Tamiyo', 'Teferi', 'Teyo', 'Tezzeret', 'Tibalt', 'Troll', 'Ugin', 'Vampire', 'Vehicle', 'Vivien', 'Vraska', 'Wall', 'Warrior', 'Weird', 'Wizard', 'Wolf', 'Wurm', 'Yanggu', 'Zombie']
