type: ['Artifact', 'Artifact Creature — Beast', 'Artifact Creature — Bird', 'Artifact Creature — Construct', 'Artifact Creature — Golem', 'Artifact — Equipment', 'Basic Land — Forest', 'Basic Land — Island', 'Basic Land — Mountain', 'Basic Land — Plains', 'Basic Land — Swamp', 'Basic Snow Land — Forest', 'Basic Snow Land — Island', 'Basic Snow Land — Mountain', 'Basic Snow Land — Plains', 'Basic Snow Land — Swamp', 'Creature — Bird', 'Creature — Cat', 'Creature — Cat Soldier', 'Creature — Cat Warrior', 'Creature — Faerie Wizard', 'Creature — Giant', 'Creature — Goblin', 'Creature — Goblin Warrior', 'Creature — Human Monk', 'Creature — Human Shaman', 'Creature — Human Warrior', 'Creature — Ooze', 'Creature — Rat', 'Creature — Sphinx', 'Creature — Vampire', 'Creature — Vampire Spirit', 'Enchantment', 'Instant', 'Land', 'Legendary Artifact Creature — Scarecrow', 'Legendary Artifact — Equipment', 'Legendary Creature — Angel', 'Legendary Creature — Cat Avatar', 'Legendary Creature — Cat Warrior', 'Legendary Creature — Dragon Avatar', 'Legendary Creature — Elder Giant', 'Legendary Creature — Faerie Wizard', 'Legendary Creature — Human Advisor', 'Legendary Creature — Human Archer', 'Legendary Creature — Human Monk', 'Legendary Creature — Human Rogue', 'Legendary Creature — Human Shaman', 'Legendary Creature — Human Soldier', 'Legendary Creature — Human Warrior', 'Legendary Creature — Ooze', 'Legendary Creature — Rat Ninja', 'Legendary Creature — Rat Rogue', 'Legendary Creature — Sliver Mutant', 'Legendary Enchantment Creature — God', 'Legendary Planeswalker — Ajani', 'Legendary Planeswalker — Domri', 'Legendary Planeswalker — Kaya', 'Legendary Planeswalker — Tamiyo', 'Legendary Planeswalker — Teferi', 'Legendary Planeswalker — Vraska', 'Sorcery', 'Tribal Enchantment — Faerie']
