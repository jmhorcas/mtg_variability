subtypes: ['Advisor', 'Angel', 'Ape', 'Artificer', 'Atog', 'Aura', 'Barbarian', 'Beast', 'Bird', 'Boar', 'Carrier', 'Cat', 'Cleric', 'Construct', 'Dack', 'Dauthi', 'Djinn', 'Dog', 'Dragon', 'Drake', 'Druid', 'Efreet', 'Elemental', 'Elf', 'Equipment', 'Faerie', 'Forest', 'Giant', 'Goblin', 'Golem', 'Gorgon', 'Griffin', 'Hellion', 'Horror', 'Human', 'Illusion', 'Imp', 'Incarnation', 'Insect', 'Island', 'Jace', 'Jellyfish', 'Kavu', 'Knight', 'Lizard', 'Masticore', 'Mercenary', 'Merfolk', 'Mountain', 'Mutant', 'Mystic', 'Nightmare', 'Nightstalker', 'Noble', 'Nomad', 'Orc', 'Phyrexian', 'Plains', 'Rabbit', 'Rogue', 'Scout', 'Shapeshifter', 'Snake', 'Soldier', 'Soltari', 'Specter', 'Spellshaper', 'Spirit', 'Swamp', 'Thalakos', 'Thopter', 'Vampire', 'Wall', 'Warrior', 'Whale', 'Wizard', 'Wurm', 'Zombie']
