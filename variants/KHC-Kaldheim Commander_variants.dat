type: ['Artifact', 'Artifact Creature — Elk', 'Artifact Creature — Golem', 'Artifact — Equipment', 'Creature — Angel', 'Creature — Bird', 'Creature — Bird Spirit', 'Creature — Boar', 'Creature — Drake', 'Creature — Dwarf Peasant', 'Creature — Elemental', 'Creature — Elf', 'Creature — Elf Archer', 'Creature — Elf Artificer', 'Creature — Elf Assassin', 'Creature — Elf Druid', 'Creature — Elf Rogue', 'Creature — Elf Scout', 'Creature — Elf Shaman', 'Creature — Elf Warrior', 'Creature — Giant', 'Creature — Giant Warrior Ranger', 'Creature — Human Cleric', 'Creature — Human Cleric Soldier', 'Creature — Human Monk', 'Creature — Human Rogue Artificer', 'Creature — Human Scout', 'Creature — Human Warrior', 'Creature — Human Wizard', 'Creature — Kithkin Wizard', 'Creature — Kor Scout', 'Creature — Sphinx', 'Creature — Spirit', 'Creature — Spirit Angel', 'Creature — Spirit Giant', 'Creature — Wall', 'Enchantment', 'Enchantment — Aura', 'Instant', 'Land', 'Land — Gate', 'Legendary Creature — Elf Druid', 'Legendary Creature — Elf Horror', 'Legendary Creature — Elf Noble', 'Legendary Creature — Elf Scout', 'Legendary Creature — Elf Warrior', 'Legendary Creature — Spirit Noble', 'Legendary Creature — Spirit Warrior', 'Sorcery', 'Tribal Enchantment — Elf', 'Tribal Sorcery — Elf']
